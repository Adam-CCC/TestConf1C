
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначениеОтбора = Параметры.Отбор.ЗначениеОтбора;
	Список.Параметры.УстановитьЗначениеПараметра("Значение", ЗначениеОтбора);
	
	Элементы.ТипДокументаОтбор.СписокВыбора.ЗагрузитьЗначения(ПолучитьСписокДоступныхТиповОтбора(ЗначениеОтбора));
	
КонецПроцедуры

&НаКлиенте
Процедура ВременнойИнтервалПриИзменении(Элемент)
	ВременнойИнтервалПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВременнойИнтервалПриИзмененииНаСервере()

	Отбор = ОтчетыСервер.КомпоновщикНайтиОтбор( "Ссылка.Дата", Список.Отбор, Истина);
	Если Отбор = Неопределено Тогда
	
		ГруппаОтбора = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаОтбора.Использование = Истина;	
		
		Отбор = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));   
		Отбор.Использование = Истина;	
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка.Дата");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		Отбор.ПравоеЗначение = ВременнойИнтервал.ДатаНачала;
		
		Отбор = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	  	Отбор.Использование = Истина;	
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка.Дата");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
		Отбор.ПравоеЗначение = ВременнойИнтервал.ДатаОкончания;

	Иначе 
		Элементы_ = Отбор.Родитель.Элементы;
		Для каждого эл Из Элементы_ Цикл
		    Если эл.ВидСравнения =  ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
			    Если не ЗначениеЗаполнено(ВременнойИнтервал.ДатаНачала) Тогда
				    эл.Использование = Ложь;				
				Иначе
				    эл.ПравоеЗначение = ВременнойИнтервал.ДатаНачала;				
				КонецЕсли; 
			Иначе
			    Если не ЗначениеЗаполнено(ВременнойИнтервал.ДатаОкончания) Тогда
				    эл.Использование = Ложь;				
				Иначе
				    эл.ПравоеЗначение = ВременнойИнтервал.ДатаОкончания;				
				КонецЕсли;
			КонецЕсли;		
		КонецЦикла;	
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокДоступныхТиповОтбора(Значение)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТИПЗНАЧЕНИЯ(Renault_Автомобили.Ссылка) КАК ДоступныеТипы
		|ИЗ
		|	КритерийОтбора.Renault_Автомобили(&Значение) КАК Renault_Автомобили";
	
	Запрос.УстановитьПараметр("Значение", Значение);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДоступныеТипы");
	
КонецФункции // ()

&НаКлиенте
Процедура ТипДокументаОтборОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТипДокументаОтбор = ВыбранноеЗначение; 
КонецПроцедуры

&НаКлиенте
Процедура ТипДокументаОтборПриИзменении(Элемент)
	ТипДокументаОтборПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ТипДокументаОтборПриИзмененииНаСервере()
	
	Если ТипДокументаОтбор = Неопределено Тогда
		ОтборТипДокумента = ОтчетыСервер.КомпоновщикНайтиОтбор( "ТипДокумента", Список.КомпоновщикНастроек.Настройки.Отбор);
		Если Не ОтборТипДокумента = Неопределено Тогда
		    ОтборТипДокумента.Использование = Ложь;		
		КонецЕсли;
	Иначе
	    ОтчетыСервер.КомпоновщикУстановитьОтбор(Список.КомпоновщикНастроек.Настройки, "ТипДокумента", ТипДокументаОтбор);	
	КонецЕсли;
	
КонецПроцедуры
