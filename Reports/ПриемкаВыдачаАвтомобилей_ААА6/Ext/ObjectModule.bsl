// устанавливаем параметры
Процедура ПолучитьВыборкуДанныхПриемка() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаОтчета - ДатаНачала * 60); // все начиная с тек время - ДатаНачала
	Запрос.УстановитьПараметр("ДатаКонца", ДатаОтчета + ДатаКонца * 60); // до тек время + ДатаКонца
	Запрос.УстановитьПараметр("ХозОперация", Справочники.ХозОперации.ПланРемонта);
	
	Для Каждого ЭлементОтбора Из ФильтрыОтчета Цикл
		// не используем элемент отбора
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		Запрос.УстановитьПараметр(ЭлементОтбора.Имя,ЭлементОтбора.Значение);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
КонецПроцедуры

