	<calculatedField>
		<dataPath>ПремияРаб</dataPath>
		<expression>ЕстьNull(СуммаРабот, 0)* ЕстьNull(РаботыПроцентОтчислений, 0) / 100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Премия по работам</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<group>true</group>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>ПремияЗапч</dataPath>
		<expression>(ЕстьNull(СуммаТоваров, 0)-ЕстьNull(Себестоимость, 0)) * ЕстьNull(ЗапчастиПроцентОтчислений, 0) / 100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Премия ЗЧ </v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<group>true</group>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>ОбщаяСуммаЗарплаты</dataPath>
		<expression>(ЕстьNull(СуммаРабот, 0) * ЕстьNull(РаботыПроцентОтчислений, 0) / 100)+(ЕстьNull(СуммаТоваров, 0)-ЕстьNull(Себестоимость, 0)) * ЕстьNull(ЗапчастиПроцентОтчислений, 0) / 100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Общая сумма зарплаты </v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<group>true</group>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>ВаловаяПрибыль</dataPath>
		<expression>ЕстьNull(СуммаРабот, 0) + ЕстьNull(СуммаТоваров, 0) - ЕстьNull(Себестоимость, 0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Валовая прибыль</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<group>true</group>
		</useRestriction>
	</calculatedField>
	<calculatedField>
		<dataPath>ВаловаяПрибыльЗЧ</dataPath>
		<expression>ЕстьNull(СуммаТоваров, 0) - ЕстьNull(Себестоимость, 0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Прибыль по запчастям</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<group>true</group>
		</useRestriction>
	</calculatedField>
