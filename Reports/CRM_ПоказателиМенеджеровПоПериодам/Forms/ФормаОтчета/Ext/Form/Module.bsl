&НаКлиенте
Процедура ГруппаРезультатСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.ГруппаРезультатСтраницы.ТекущаяСтраница.Имя = "СтраницаРезультат" Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ДоступныеПоля;
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДиаграммы;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ДоступныеПоля" Тогда
		Элементы.ГруппаРезультатСтраницы.ТекущаяСтраница = Элементы.СтраницаРезультат;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ГруппаДиаграммы" Тогда
		Элементы.ГруппаРезультатСтраницы.ТекущаяСтраница = Элементы.СтраницаДиаграмма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеРесурсыОтчетаПослеУдаления(Элемент)
	ОбновитьНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеРесурсыОтчетаПередУдалением(Элемент, Отказ)
	
	Если Элемент.ТекущиеДанные.Предопределенное Тогда
		Отказ = Истина;
	Иначе
		// удалим поле из списков выбора
		имяПоля = Элемент.ТекущиеДанные.ИмяПоля;
		нЗначение = ЭтаФорма.Элементы.ГруппировкаДиаграммы.СписокВыбора.НайтиПоЗначению(имяПоля);
		Если нЗначение<>Неопределено Тогда
			ЭтаФорма.Элементы.ГруппировкаДиаграммы.СписокВыбора.Удалить(нЗначение);
		КонецЕсли;
		нЗначение = ЭтаФорма.Элементы.Группировки1Поле.СписокВыбора.НайтиПоЗначению(имяПоля);
		Если нЗначение<>Неопределено Тогда
			ЭтаФорма.Элементы.Группировки1Поле.СписокВыбора.Удалить(нЗначение);
		КонецЕсли;
		
		// удалим группировки
		нОтбор = Новый Структура;
		нОтбор.Вставить("Поле",имяПоля); 
		найденныеСтроки = Отчет.Группировки.НайтиСтроки(нОтбор);
		Для Каждого текСтрока Из найденныеСтроки Цикл
			Отчет.Группировки.Удалить(текСтрока);
		КонецЦикла;	
		
		// группировка диаграммы
		Если Отчет.ГруппировкаДиаграммы=имяПоля Тогда
			// заменим на первую группировку из списка группировок строк
			Если Отчет.Группировки.Количество()>0 Тогда
				Отчет.ГруппировкаДиаграммы = Отчет.Группировки[0].Поле;
			Иначе
				Отчет.ГруппировкаДиаграммы = "";
			КонецЕсли;
		КонецЕсли;
		
		// удалим поля из отбора
		массивДляУдаления = Новый Массив;
		Для Каждого текЭлемент Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
			Если СокрЛП(текЭлемент.ЛевоеЗначение)=имяПоля ИЛИ СокрЛП(текЭлемент.ПравоеЗначение)=имяПоля Тогда
				массивДляУдаления.Добавить(текЭлемент);				
			КонецЕсли;
		КонецЦикла;
		Если массивДляУдаления.Количество()>0 тогда
			Для Каждого текЭлемент Из массивДляУдаления Цикл
				Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Удалить(текЭлемент);
			КонецЦикла;			
		КонецЕсли;
		
		// удалим значения упорядочивания
		массивДляУдаления = Новый Массив;
		Для Каждого текЭлемент Из Отчет.КомпоновщикНастроек.Настройки.Порядок.Элементы Цикл
			Если СокрЛП(текЭлемент.Поле)=имяПоля Тогда
				массивДляУдаления.Добавить(текЭлемент);				
			КонецЕсли;
		КонецЦикла;
		Если массивДляУдаления.Количество()>0 тогда
			Для Каждого текЭлемент Из массивДляУдаления Цикл
				Отчет.КомпоновщикНастроек.Настройки.Порядок.Элементы.Удалить(текЭлемент);
			КонецЦикла;			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	ВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ВыборФайла.МножественныйВыбор = Ложь;
	ВыборФайла.Заголовок = "Выбор файла";
		
	РезультатФайл = ВыборФайла.Выбрать();
	ПолноеИмяФайла = ВыборФайла.ПолноеИмяФайла;
	Если ПолноеИмяФайла = "" Тогда
	Иначе
		ПечатьНаСервере(ПолноеИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
