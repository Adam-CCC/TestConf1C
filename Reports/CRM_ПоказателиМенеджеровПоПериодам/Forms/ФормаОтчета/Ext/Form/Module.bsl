	Если Элементы.ГруппаРезультатСтраницы.ТекущаяСтраница = Элементы.СтраницаРезультат Тогда
		ТабличныйДокументЭкспорта = Результат;
	ИначеЕсли Элементы.ГруппаРезультатСтраницы.ТекущаяСтраница = Элементы.СтраницаДиаграмма Тогда
		ТабличныйДокументЭкспорта = Отчет.РезультатДиаграмма;
	КонецЕсли;
	
	ТабличныйДокументЭкспорта.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		Сообщить("ОШИБКА! Приложение MS Excel отсутствует или недостаточно прав доступа!
		|	- " + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		
		Возврат;
	КонецПопытки;
	
	Excel.Workbooks.Open(ПолноеИмяФайла);
	tmpBook = Excel.Workbooks.Item(Excel.Workbooks.Count); 
	//КнигаExcel = Excel.Workbooks.Add(); 
	//
	//ЛистТаблицы = КнигаExcel.WorkSheets.Item(1); 
	//ЛистТаблицы.Name = "Сводная таблица";
	//
	//КнигаExcel.Activate();
		
	Excel.Visible = 1;
	
КонецПроцедуры

&НаКлиенте
Процедура Настройки(Команда)
	
	Элементы.ГруппаСтраницы.Видимость = НЕ Элементы.КнопкаНастройки.Пометка;
	Элементы.КнопкаНастройки.Пометка = НЕ Элементы.КнопкаНастройки.Пометка;
	
