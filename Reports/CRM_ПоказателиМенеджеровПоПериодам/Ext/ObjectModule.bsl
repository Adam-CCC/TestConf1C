	//ЗаполнитьНастройкиОтчета(НастройкиОтчета, Истина);
	//
	//НастройкиОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("Период",Период);
	//КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	//
	//КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	//МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки);

	//ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	//ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	//
	//ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	//ПроцессорВывода.УстановитьДокумент(РезультатДиаграмма);
	//ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	РезультатДиаграмма.Очистить();
	Макет  = ПолучитьМакет("Макет");    
    График  = Макет.ПолучитьОбласть("График");
    Диаграмма=График.Рисунки.D1.Объект;
	Диаграмма.ТипДиаграммы = ТипДиаграммы;
	Запрос = Новый Запрос;
	Запрос.Текст = СхемаКомпоновкиДанных.НаборыДанных[0].Запрос;
	Если ГруппировкаДиаграммы = "Менеджер" Тогда
		СтрокаИтоги = "ИТОГИ ПО Менеджер";
	ИначеЕсли ГруппировкаДиаграммы = "Причина" Тогда
		СтрокаИтоги = "ИТОГИ ПО Причина";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + СтрокаИтоги;
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Диаграмма.СерииВСтроках = Ложь;
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		Для Каждого Показатель Из ПоказателиДиаграммы Цикл
			Если Показатель.Пометка Тогда
				
				ТекущаяСерия = Диаграмма.УстановитьСерию(Показатель.ИмяПоля);
				ТекущаяСерия.Текст = Показатель.Представление;
		        ТекущаяТочка = Диаграмма.УстановитьТочку(Выборка[ГруппировкаДиаграммы]);
				ТекущаяТочка.Текст = ?(Выборка[ГруппировкаДиаграммы] = Null, "", Выборка[ГруппировкаДиаграммы].Наименование);
				Если Найти(Показатель.ИмяПоля, "Процент") Тогда
					ИмяПоказателяБезПроцентов = Лев(Показатель.ИмяПоля, СтрДлина(Показатель.ИмяПоля)-7);
					Значение = (Выборка[ИмяПоказателяБезПроцентов]/Выборка.ПервичныйТрафик)*100;
					Диаграмма.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, Значение, ,) ;
				Иначе
					Диаграмма.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, Выборка[Показатель.ИмяПоля], ,) ;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	РезультатДиаграмма.Вывести(График);
    РезультатДиаграмма.Защита = Ложь;
    РезультатДиаграмма.ТолькоПросмотр = Истина;

КонецПроцедуры

Функция НайтиПолеКомпоновки(Имя, Коллекция) Экспорт
	Для Каждого ПолеКомпоновкиДанных Из Коллекция Цикл
		Если ПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных(Имя) Тогда
			Возврат Истина;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Ложь;
КонецФункции

Функция ВложитьГруппировку(ЭлементСтруктуры, Группировка)
	
	ЭлементСтруктуры = ЭлементСтруктуры.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ЭлементГруппировки = ЭлементСтруктуры.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ЭлементГруппировки.Использование = Истина;
	ЭлементГруппировки.Поле =  Новый ПолеКомпоновкиДанных(Группировка.Поле);                                                  
	ЭлементГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных[Группировка.ТипГруппировки];
	
	ПолеСортировки = ЭлементСтруктуры.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	ПолеСортировки.Использование = Истина;

	
	ЭлементВыбора = ЭлементСтруктуры.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));//.Поле = Новый ПолеКомпоновкиДанных(Элемент.ИмяПоля);
	ЭлементВыбора.Использование = Истина;
	Возврат ЭлементСтруктуры;
	
КонецФункции