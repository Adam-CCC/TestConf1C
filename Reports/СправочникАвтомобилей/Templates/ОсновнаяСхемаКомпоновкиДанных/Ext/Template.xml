		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Автомобили.Ссылка КАК Автомобиль,
	Автомобили.VIN,
	Автомобили.Модель,
	Автомобили.Цвет,
	ВЫБОР
		КОГДА НЕ ВариантыКомплектации.Ссылка ЕСТЬ NULL
			ТОГДА ВариантыКомплектации.ТипКПП.Наименование
		КОГДА НЕ Автомобили.Трансмиссия ЕСТЬ NULL
			ТОГДА Автомобили.Трансмиссия
		ИНАЧЕ ""
	КОНЕЦ КАК ТипКПП,
	ВЫБОР
		КОГДА НЕ ВариантыКомплектации.Ссылка ЕСТЬ NULL
			ТОГДА ВариантыКомплектации.ТипДвигателя.ОбъемДвигателя
		КОГДА НЕ Автомобили.ОбъемДвигателя ЕСТЬ NULL
			ТОГДА Автомобили.ОбъемДвигателя
		ИНАЧЕ 0
	КОНЕЦ КАК ОбъемДвигателя,
	ВЫБОР
		КОГДА НЕ ОстаткиАвтомобилейОстатки.СкладКомпании ЕСТЬ NULL
			ТОГДА ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение.ДилерскийЦентр
		ИНАЧЕ Автомобили.Автор.Подразделение.ДилерскийЦентр
	КОНЕЦ КАК ДилерскийЦентр,
	ВЫБОР
		КОГДА НЕ ОстаткиАвтомобилейОстатки.СкладКомпании ЕСТЬ NULL
			ТОГДА "В продаже"
		ИНАЧЕ "На сервисе"
	КОНЕЦ КАК ПродажаСервис,
	ВариантыКомплектации.Ссылка КАК ВариантКомплектации
ИЗ
	Справочник.Автомобили КАК Автомобили
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектации КАК ВариантыКомплектации
		ПО Автомобили.ВариантКомплектации = ВариантыКомплектации.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиАвтомобилей.Остатки(&amp;ДатаОкончания, ) КАК ОстаткиАвтомобилейОстатки
		ПО Автомобили.Ссылка = ОстаткиАвтомобилейОстатки.Автомобиль
ГДЕ
	Автомобили.ДатаРегистрации МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И НЕ Автомобили.VIN ЕСТЬ NULL
	И Автомобили.VIN &lt;&gt; ""</query>
