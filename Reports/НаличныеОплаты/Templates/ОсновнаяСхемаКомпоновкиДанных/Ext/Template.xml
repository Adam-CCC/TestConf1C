	ПриходныйКассовыйОрдер.Сделка КАК СделкаДокумент,
	ПриходныйКассовыйОрдер.ХозОперация,
	ПриходныйКассовыйОрдер.СуммаДокумента КАК СуммаПриходаДС,
	0 КАК СуммаРасходаДС,
	ПриходныйКассовыйОрдер.СуммаНДС
ИЗ
	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
ГДЕ
	ПриходныйКассовыйОрдер.Проведен
	И ПриходныйКассовыйОрдер.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	РасходныйКассовыйОрдер.Организация,
	РасходныйКассовыйОрдер.КассаКомпании,
	РасходныйКассовыйОрдер.Номер,
	РасходныйКассовыйОрдер.Дата,
	РасходныйКассовыйОрдер.Контрагент,
	РасходныйКассовыйОрдер.ПодразделениеКомпании.ДилерскийЦентр,
	РасходныйКассовыйОрдер.СтатьяДДС,
	РасходныйКассовыйОрдер.Сделка.Номер,
	РасходныйКассовыйОрдер.Сделка.Дата,
	РасходныйКассовыйОрдер.Сделка,
	РасходныйКассовыйОрдер.ХозОперация,
	0,
	РасходныйКассовыйОрдер.СуммаДокумента,
	РасходныйКассовыйОрдер.СуммаНДС
ИЗ
	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
ГДЕ
	РасходныйКассовыйОрдер.Проведен
	И РасходныйКассовыйОрдер.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

