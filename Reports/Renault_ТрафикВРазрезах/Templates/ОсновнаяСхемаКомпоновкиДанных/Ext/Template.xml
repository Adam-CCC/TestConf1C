		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_Трафик.Период КАК Период,
	Renault_Трафик.Идентификатор КАК Идентификатор,
	Renault_Трафик.ТипТрафика КАК ТипТрафика,
	Renault_Трафик.Обработан КАК Обработан,
	Renault_Трафик.Отдел КАК Отдел,
	Renault_Трафик.Менеджер КАК Менеджер,
	Renault_Трафик.Администратор КАК Администратор,
	Renault_Трафик.Клиент КАК Клиент,
	Renault_Трафик.ПервичныйПовторный КАК ПервичныйПовторный,
	Renault_Трафик.Представление КАК Представление,
	Renault_Трафик.Комментарий КАК Комментарий,
	Renault_Трафик.ПервичныйИнтерес КАК ПервичныйИнтерес,
	Renault_Трафик.ИсточникИнформации КАК ИсточникИнформации,
	Renault_РабочиеЛисты.ДатаID КАК ДатаРабочегоЛиста,
	Renault_РабочиеЛисты.IDK КАК РабочийЛист,
	Renault_Трафик.ДилерскийЦентр КАК ДилерскийЦентр,
	Renault_РабочиеЛисты.ДатаЗапросаНаЗакрытие КАК ДатаЗапросаНаЗакрытие,
	ВЫРАЗИТЬ(ОсновнойТелефон.Поле1 + " " + ОсновнойТелефон.Поле2 + " " + ОсновнойТелефон.Поле3 + " " + ОсновнойТелефон.Поле4 КАК СТРОКА) КАК КонтактнаяИнформация,
	ВЫРАЗИТЬ(ДопКонтакт.Поле1 + " " + ДопКонтакт.Поле2 + " " + ДопКонтакт.Поле3 + " " + ДопКонтакт.Поле4 КАК СТРОКА) КАК ДопКонтакт
ПОМЕСТИТЬ Трафик
ИЗ
	РегистрСведений.Renault_Трафик КАК Renault_Трафик
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
		ПО Renault_Трафик.Идентификатор = Renault_РабочиеЛисты.IDТрафика
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			МАКСИМУМ(КонтактнаяИнформация.Поле1) КАК Поле1,
			МАКСИМУМ(КонтактнаяИнформация.Поле2) КАК Поле2,
			МАКСИМУМ(КонтактнаяИнформация.Поле3) КАК Поле3,
			МАКСИМУМ(КонтактнаяИнформация.Поле4) КАК Поле4,
			КонтактнаяИнформация.Объект КАК Объект
		ИЗ
			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		ГДЕ
			КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
			И КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА
		
		СГРУППИРОВАТЬ ПО
			КонтактнаяИнформация.Объект) КАК ОсновнойТелефон
		ПО Renault_Трафик.Клиент = ОсновнойТелефон.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			МАКСИМУМ(КонтактнаяИнформация.Поле1) КАК Поле1,
			МАКСИМУМ(КонтактнаяИнформация.Поле2) КАК Поле2,
			МАКСИМУМ(КонтактнаяИнформация.Поле3) КАК Поле3,
			МАКСИМУМ(КонтактнаяИнформация.Поле4) КАК Поле4,
			КонтактнаяИнформация.Объект КАК Объект
		ИЗ
			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		ГДЕ
			КонтактнаяИнформация.ЗначениеПоУмолчанию = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			КонтактнаяИнформация.Объект) КАК ДопКонтакт
		ПО Renault_Трафик.Клиент = ДопКонтакт.Объект
{ГДЕ
	(Renault_Трафик.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания)}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МИНИМУМ(CRM_СобытияПоРабочимЛистам.Дата) КАК Дата,
	CRM_СобытияПоРабочимЛистам.IDK КАК IDK
ПОМЕСТИТЬ СобытияРЛ
ИЗ
	Трафик КАК Трафик
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		ПО Трафик.РабочийЛист = CRM_СобытияПоРабочимЛистам.IDK

СГРУППИРОВАТЬ ПО
	CRM_СобытияПоРабочимЛистам.IDK
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Трафик.ДилерскийЦентр КАК ДилерскийЦентр,
	Трафик.Период КАК Период,
	Трафик.Идентификатор КАК Идентификатор,
	Трафик.ТипТрафика КАК ТипТрафика,
	Трафик.Обработан КАК Обработан,
	Трафик.Отдел КАК Отдел,
	Трафик.Менеджер КАК Менеджер,
	Трафик.Администратор КАК Администратор,
	Трафик.Клиент КАК Клиент,
	Трафик.ПервичныйПовторный КАК ПервичныйПовторный,
	Трафик.Представление КАК Представление,
	Трафик.Комментарий КАК Комментарий,
	Трафик.ПервичныйИнтерес КАК ПервичныйИнтерес,
	Трафик.ИсточникИнформации КАК ИсточникИнформации,
	Трафик.ДатаРабочегоЛиста КАК ДатаРабочегоЛиста,
	Трафик.РабочийЛист КАК РабочийЛист,
	CRM_СобытияПоРабочимЛистам.Дата КАК ДатаСобытия,
	CRM_СобытияПоРабочимЛистам.ВидСобытия КАК ВидСобытия,
	Трафик.ДатаЗапросаНаЗакрытие КАК ДатаЗапросаНаЗакрытие,
	РАЗНОСТЬДАТ(Трафик.Период, ЕСТЬNULL(Трафик.ДатаРабочегоЛиста, Трафик.Период), СЕКУНДА) КАК ВремяДоРабочегоЛиста,
	РАЗНОСТЬДАТ(Трафик.Период, ЕСТЬNULL(CRM_СобытияПоРабочимЛистам.Дата, Трафик.Период), СЕКУНДА) КАК ВремяДоСобытия,
	ВЫБОР
		КОГДА Трафик.ДатаЗапросаНаЗакрытие = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА РАЗНОСТЬДАТ(Трафик.Период, Трафик.Период, СЕКУНДА)
		ИНАЧЕ РАЗНОСТЬДАТ(Трафик.Период, Трафик.ДатаЗапросаНаЗакрытие, СЕКУНДА)
	КОНЕЦ КАК ВремяДоЗапросаНаЗакрытие,
	Трафик.Период КАК ДатаТрафика,
	Трафик.Период КАК ВремяТрафика,
	Трафик.КонтактнаяИнформация КАК КонтактнаяИнформация,
	Трафик.ДопКонтакт КАК ДопКонтакт
ИЗ
	Трафик КАК Трафик
		ЛЕВОЕ СОЕДИНЕНИЕ СобытияРЛ КАК СобытияРЛ
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
			ПО СобытияРЛ.IDK = CRM_СобытияПоРабочимЛистам.IDK
				И СобытияРЛ.Дата = CRM_СобытияПоРабочимЛистам.Дата
		ПО Трафик.РабочийЛист = СобытияРЛ.IDK</query>
	</dataSet>
