Процедура СформироватьСхемуКомпоновкиДанных() Экспорт
	// изменим текст запроса
	Для Каждого нДанных Из СхемаКомпоновкиДанных.НаборыДанных Цикл
		Если типЗнч(нДанных) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
			// меняем только первый набор-запрос
			нДанных.АвтоЗаполнениеДоступныхПолей = Истина;
			
			ТекстЗапроса = "
			|ИЗ
			|	РегистрСведений.Renault_Трафик КАК Renault_Трафик
			|";
			
			ТекстВыбрать = "ВЫБРАТЬ Renault_Трафик.*";
			
			Для Каждого текСтрока Из ДоступныеПоляОтчета Цикл
				Если ТекСтрока.Пометка=Ложь ИЛИ ТекСтрока.ДополнительноеПоле.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				
				ИмяРеквизита = УбратьЗапрещенныеСимволы(ТекСтрока.ДополнительноеПоле.Наименование);
				
				ТекстЗапроса = ТекстЗапроса + "ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика,
				|	CRM_ЗначенияРеквизитовТрафика.ЗначениеРеквизита
				|ИЗ
				|	РегистрСведений.CRM_ЗначенияРеквизитовТрафика КАК CRM_ЗначенияРеквизитовТрафика
				|ГДЕ
				|	CRM_ЗначенияРеквизитовТрафика.РеквизитТрафика.Код = "+Символ(34)+ТекСтрока.ДополнительноеПоле.Код+Символ(34)+") КАК "+ИмяРеквизита+"_Выборка
				|ПО "+ИмяРеквизита+"_Выборка.ИдентификаторТрафика=Renault_Трафик.Идентификатор
				|";
				
				ТекстВыбрать = ТекстВыбрать+","+ИмяРеквизита+"_Выборка.ЗначениеРеквизита КАК "+ИмяРеквизита;
				
			КонецЦикла;
			
			нДанных.Запрос = ТекстВыбрать+ТекстЗапроса+"
			|{ГДЕ
			|	(Renault_Трафик.Период МЕЖДУ &НачалоПериода И &КонецПериода)}
			|";
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// итоги
	СхемаКомпоновкиДанных.ПоляИтога.Очистить();
	ПолеРесурса = СхемаКомпоновкиДанных.ПоляИтога.Добавить();
	ПолеРесурса.ПутьКДанным = "Количество";
	ПолеРесурса.Выражение = "Сумма(Количество)";
КонецПроцедуры

