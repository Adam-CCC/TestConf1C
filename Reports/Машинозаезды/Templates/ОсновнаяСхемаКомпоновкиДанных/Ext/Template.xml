		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(ЗаказНаряд.ДатаНачала, ДЕНЬ) КАК ДатаНачала,
	ЗаказНаряд.ДатаНачала КАК ВремяНачала,
	ЗаказНаряд.Автомобиль КАК Автомобиль,
	ЗаказНаряд.ВидРемонта,
	Автомобили.Цвет КАК Цвет,
	Автомобили.ГодВыпуска КАК ГодВыпуска,
	ЕСТЬNULL(ЗаказНаряд.Пробег, АвтомобилиСрезПоследних.Значение) КАК Пробег,
	ЗаказНаряд.Заказчик КАК Заказчик,
	ЗаказНаряд.Менеджер КАК Менеджер,
	ЗаказНаряд.Цех,
	ЗаказНаряд.ПодразделениеКомпании КАК Подразделение,
	РАЗНОСТЬДАТ(ЗаказНаряд.ДатаНачала, ЗаказНаряд.ДатаОкончания, СЕКУНДА) / 3600 КАК ЧасовНаСервисе,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ЗаказНаряд.ДокументОснование) = ТИП(Документ.ЗаявкаНаРемонт)
			ТОГДА ВЫБОР
					КОГДА РАЗНОСТЬДАТ(ЗаказНаряд.ДокументОснование.Дата, ЗаказНаряд.ДатаНачала, ЧАС) &gt; 12
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 2
	КОНЕЦ КАК ПоЗаписи,
	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ЗаказНаряд.ДокументОснование) = ТИП(Документ.ЗаявкаНаРемонт)
			ТОГДА ЗаказНаряд.ДокументОснование.Дата
		ИНАЧЕ NULL
	КОНЕЦ КАК ДатаЗаявки,
	ЗаказНаряд.ДатаОкончания КАК ДатаВыдачиФакт,
	ЗаказНаряд.ПлановаяДатаВыдачи КАК ДатаВыдачиПлан
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&amp;Дата, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Пробег)) КАК АвтомобилиСрезПоследних
		ПО ЗаказНаряд.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Автомобили КАК Автомобили
		ПО ЗаказНаряд.Автомобиль = Автомобили.Ссылка
ГДЕ
	ЗаказНаряд.ДатаНачала МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И НЕ ЗаказНаряд.ПометкаУдаления
	И (ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Выполнен)
			ИЛИ ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт))
	И ЗаказНаряд.ДатаОкончания &lt; КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)</query>
