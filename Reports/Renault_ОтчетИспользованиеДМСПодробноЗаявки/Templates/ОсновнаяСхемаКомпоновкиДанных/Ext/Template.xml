		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_CRM_ЗаявкаНаСервис.ДилерскийЦентр,
	Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд КАК ЗаказНаряд,
	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК ЗаявкаСсылка,
	1 КАК КоличествоЗаявок,
	0 КАК КоличествоПредзаполненных
ПОМЕСТИТЬ Документы
ИЗ
	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		ПО (Renault_CRM_ПриемкаАвтомобиля.Обращение = Renault_CRM_ЗаявкаНаСервис.Обращение)
ГДЕ
	Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд.Состояние = Значение(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	И ВЫБОР
			КОГДА ГОД(&amp;ДатаНач) &gt; 1
				ТОГДА Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд.Дата &gt;= &amp;ДатаНач
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА ГОД(&amp;ДатаКон) &gt; 1
				ТОГДА Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд.Дата &lt;= &amp;ДатаКон
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;МастерПриемщик = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
				ТОГДА ИСТИНА
			ИНАЧЕ Renault_CRM_ПриемкаАвтомобиля.Машиноместо = &amp;МастерПриемщик
		КОНЕЦ
	//И Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд.ВидРемонта В (&amp;ВидыРемонта)

СГРУППИРОВАТЬ ПО
	Renault_CRM_ЗаявкаНаСервис.ДилерскийЦентр
	,Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд
	,Renault_CRM_ЗаявкаНаСервис.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Влож.ДилерскийЦентр,
	Влож.ЗаказНаряд,
	Влож.Ссылка КАК ЗаявкаСсылка,
	0 КАК КоличествоЗаявок,
	КОЛИЧЕСТВО(Влож.Ссылка) КАК КоличествоПредзаполненных
ПОМЕСТИТЬ ВремТЗ
ИЗ
	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		ЗаявкаРаботы.Ссылка.ДилерскийЦентр КАК ДилерскийЦентр,
		ЗаказНарядРаботы.Ссылка КАК ЗаказНаряд,
		ЗаявкаРаботы.Ссылка КАК Ссылка
	ИЗ
		Документ.Renault_CRM_ЗаявкаНаСервис.Работы КАК ЗаявкаРаботы
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
			ПО ((ЗаказНарядРаботы.Работа = ЗаявкаРаботы.Работа) ИЛИ (ЗаказНарядРаботы.Работа.Артикул = ЗаявкаРаботы.Работа.Артикул))
				И (ЗаказНарядРаботы.Ссылка = ЗаявкаРаботы.Ссылка.ЗаказНаряд)
				И (ЗаказНарядРаботы.Ссылка.Состояние = Значение(Справочник.ВидыСостоянийЗаказНарядов.Закрыт))
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
			ПО (Renault_CRM_ПриемкаАвтомобиля.Обращение = ЗаявкаРаботы.Ссылка.Обращение)
	ГДЕ
		ВЫБОР
				КОГДА ГОД(&amp;ДатаНач) &gt; 1
					ТОГДА ЗаявкаРаботы.Ссылка.ЗаказНаряд.Дата &gt;= &amp;ДатаНач
				ИНАЧЕ ИСТИНА
			КОНЕЦ
		И ВЫБОР
				КОГДА ГОД(&amp;ДатаКон) &gt; 1
					ТОГДА ЗаявкаРаботы.Ссылка.ЗаказНаряд.Дата &lt;= &amp;ДатаКон
				ИНАЧЕ ИСТИНА
			КОНЕЦ
		И ВЫБОР
				КОГДА &amp;МастерПриемщик = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
					ТОГДА ИСТИНА
				ИНАЧЕ Renault_CRM_ПриемкаАвтомобиля.Машиноместо = &amp;МастерПриемщик
			КОНЕЦ
		//И ЗаказНарядРаботы.Ссылка.ВидРемонта В (&amp;ВидыРемонта)
	
	СГРУППИРОВАТЬ ПО
		ЗаявкаРаботы.Ссылка.ДилерскийЦентр,
		ЗаказНарядРаботы.Ссылка,
		ЗаявкаРаботы.Ссылка) КАК Влож

СГРУППИРОВАТЬ ПО
	Влож.ДилерскийЦентр
	,Влож.ЗаказНаряд
	,Влож.Ссылка
;

////////////////////////////////////////////////////////////////////////////////



ВЫБРАТЬ 

	ДилерскийЦентр,
	ЗаказНаряд.ВидРемонта КАК ВидРемонта,
	ЗаказНаряд,
	 ЗаказНаряд.Номер КАК ДокументНомер,
	ЗаказНаряд.Дата КАК ДокументДата,
	ЗаказНаряд.Автор КАК Автор,
	ЗаказНаряд.Менеджер КАК Менеджер,
	ЗаказНаряд.Организация КАК Организация,
	ЗаказНаряд.ПодразделениеКомпании КАК ПодразделениеКомпании,
	
	ЗаказНаряд.Состояние КАК Состояние,
	ЗаказНаряд.Заказчик КАК Заказчик,
	ЗаказНаряд.Автомобиль КАК Автомобиль,
	ЗаказНаряд.Контрагент КАК Контрагент,
	


	
	ЗаказНаряд.Цех КАК Цех,
	ЗаказНаряд.Мастер КАК Мастер,
	
	
	ЗаказНаряд.СуммаДокумента КАК СуммаДокумента,


	ЗаявкаСсылка,
	СУММА(КоличествоЗаявок) КАК КоличествоЗаявок,
  СУММА(КоличествоПредзаполненных) КАК КоличествоПредзаполненных

ИЗ (
ВЫБРАТЬ 

	ДилерскийЦентр,
	ЗаказНаряд,
	
	ЗаявкаСсылка,
	КоличествоЗаявок,
  КоличествоПредзаполненных
  из   Документы
  ОБЪЕДИНИТЬ ВСЕ 
  ВЫБРАТЬ 

	ДилерскийЦентр,
	ЗаказНаряд,
	ЗаявкаСсылка,
	КоличествоЗаявок,
  КоличествоПредзаполненных
  из   ВремТЗ ) т1
 где т1.ДилерскийЦентр = &amp;ДилерскийЦентр
  сгруппировать по 
   ДилерскийЦентр,
	ЗаказНаряд,
	ЗаявкаСсылка;

</query>
