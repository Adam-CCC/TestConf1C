		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	КонтактнаяИнформация.Поле1,
	КонтактнаяИнформация.Поле4,
	КонтактнаяИнформация.Представление,
	КонтактнаяИнформация.Объект
ПОМЕСТИТЬ Адреса
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КонтактнаяИнформация.Представление,
	КонтактнаяИнформация.Объект
ПОМЕСТИТЬ ЭлПочта
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(КонтактнаяИнформация.Поле1 + ", " + КонтактнаяИнформация.Поле2 + КонтактнаяИнформация.Поле3) КАК Представление,
	КонтактнаяИнформация.Объект
ПОМЕСТИТЬ ОсновнойТелефон
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)

СГРУППИРОВАТЬ ПО
	КонтактнаяИнформация.Объект
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(КонтактнаяИнформация.Поле1 + ", " + КонтактнаяИнформация.Поле2 + КонтактнаяИнформация.Поле3) КАК Представление,
	КонтактнаяИнформация.Объект
ПОМЕСТИТЬ Телефон
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	НЕ КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)

СГРУППИРОВАТЬ ПО
	КонтактнаяИнформация.Объект
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказНаряд.ДатаЗакрытия,
	Автомобили.VIN,
	Автомобили.Модель.Наименование КАК Модель,
	АвтомобилиГосНомер.Значение КАК ГосНомер,
	АвтомобилиПробег.Значение КАК Пробег,
	Контрагенты.Фамилия,
	Контрагенты.Имя,
	Контрагенты.Отчество,
	ВЫБОР
		КОГДА Контрагенты.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическихЛиц.Мужской)
			ТОГДА "М"
		ИНАЧЕ "Ж"
	КОНЕЦ КАК Пол,
	Контрагенты.ДатаРождения,
	ОснТелефон.Представление КАК Телефон,
	Адреса.Поле1 КАК Индекс,
	Адреса.Поле4 КАК Город,
	Адреса.Представление КАК Адрес,
	ЗаказНаряд.ВидРемонта.Наименование КАК ВидРемонта,
	ЗаказНаряд.Номер КАК Номер,
	ЗаказНаряд.Время КАК ВремяЗвонка,
	ЗаказНаряд.ПодразделениеКомпании КАК Подразделение,
	ЭлПочта.Представление КАК АдресЭлектроннойПочты,
	"да" КАК ФизическоеЛицо,
	ЗаказНаряд.СуммаДокумента КАК СуммаПоЗаказНаряду,
	Контрагенты.СогласиеНаОбработкуПерсональныхДанных КАК СогласиеНаОПД,
	Телефон.Представление КАК Телефон2
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Автомобили КАК Автомобили
		ПО ЗаказНаряд.Автомобиль = Автомобили.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		ПО ЗаказНаряд.Владелец = Контрагенты.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(КОНЕЦПЕРИОДА(&amp;ДатаОтчета, ДЕНЬ), ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК АвтомобилиГосНомер
		ПО ЗаказНаряд.Автомобиль = АвтомобилиГосНомер.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(КОНЕЦПЕРИОДА(&amp;ДатаОтчета, ДЕНЬ), ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Пробег)) КАК АвтомобилиПробег
		ПО ЗаказНаряд.Автомобиль = АвтомобилиПробег.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ Адреса КАК Адреса
		ПО ЗаказНаряд.Владелец = Адреса.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ ЭлПочта КАК ЭлПочта
		ПО ЗаказНаряд.Владелец = ЭлПочта.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ Телефон КАК Телефон
		ПО ЗаказНаряд.Владелец = Телефон.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ ОсновнойТелефон КАК ОснТелефон
		ПО ЗаказНаряд.Владелец = ОснТелефон.Объект
ГДЕ
	ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	И ЗаказНаряд.ДатаЗакрытия МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ДатаОтчета, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;ДатаОтчета, ДЕНЬ)
	И Контрагенты.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)</query>
	</dataSet>
