		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РегистрацияЗвонковИКонтактов.Сотрудник КАК Администратор,
	РегистрацияЗвонковИКонтактов.Организация,
	РегистрацияЗвонковИКонтактов.Подразделение,
	РегистрацияЗвонковИКонтактов.РабочийЛист КАК РабочийЛист,
	РегистрацияЗвонковИКонтактов.Участник,
	1 КАК КоличествоЗвонков,
	ВЫБОР
		КОГДА РегистрацияЗвонковИКонтактов.РабочийЛист ССЫЛКА Документ.РабочийЛист
				ИЛИ РегистрацияЗвонковИКонтактов.РабочийЛист ССЫЛКА Документ.РабочийЛистСервиса
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоНазначено,
	РегистрацияЗвонковИКонтактов.Клиент КАК Клиент
ИЗ
	РегистрСведений.РегистрацияЗвонковИКонтактов КАК РегистрацияЗвонковИКонтактов
{ГДЕ
	(ВЫБОР
			КОГДА &amp;НачПериода = ДАТАВРЕМЯ(1, 1, 1, 1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ РегистрацияЗвонковИКонтактов.ДатаДень &gt;= &amp;НачПериода
		КОНЕЦ),
	(ВЫБОР
			КОГДА &amp;КонПериода = ДАТАВРЕМЯ(1, 1, 1, 1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ РегистрацияЗвонковИКонтактов.ДатаДень &lt;= &amp;КонПериода
		КОНЕЦ)}</query>
	</dataSet>
