		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВложенныйЗапрос.СтраховаяКомпания КАК СтраховаяКомпания,
	ВложенныйЗапрос.Акт КАК Акт,
	СУММА(ВложенныйЗапрос.Взнос) КАК Взнос,
	СУММА(ВложенныйЗапрос.Бордеро) КАК Бордеро,
	СУММА(ВложенныйЗапрос.ДВОУ) КАК ДВОУ,
	СУММА(ВложенныйЗапрос.ВстречноеБордеро) КАК ВстречноеБордеро,
	ВложенныйЗапрос.ВидСтрахования,
	ЕСТЬNULL(ВложенныйЗапрос.СтраховойПолисТочкаПродаж, "Нет данных") КАК ТочкаПродаж,
//	ЕСТЬNULL(ВложенныйЗапрос.СтраховойПолисПодразделение, "Нет данных") КАК Подразделение,
	СУММА(ВложенныйЗапрос.СуммаИТОГО) КАК СуммаИТОГО
//	ЕСТЬNULL(ВложенныйЗапрос.СтраховойПолисОтдел, "нет данных") КАК Отдел
ИЗ
	(ВЫБРАТЬ
		Renault_АктСдачиПриемкиБСОБСО.Ссылка КАК Акт,
		Renault_АктСдачиПриемкиБСОБСО.Ссылка.СтраховаяКомпания КАК СтраховаяКомпания,
		СУММА(ЕСТЬNULL(Renault_АктСдачиПриемкиБСОБСО.СтраховаяПремияОтКлиента, 0)) КАК Взнос,
		СУММА(ВЫБОР
				КОГДА Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.Бордеро)
					ТОГДА Renault_АктСдачиПриемкиБСОБСО.ВознаграждениеАгентаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК Бордеро,
		СУММА(ВЫБОР
				КОГДА Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.ДВОУ)
					ТОГДА Renault_АктСдачиПриемкиБСОБСО.ВознаграждениеАгентаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК ДВОУ,
		СУММА(ВЫБОР
				КОГДА Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.ВстречноеБордеро)
					ТОГДА Renault_АктСдачиПриемкиБСОБСО.ВознаграждениеАгентаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК ВстречноеБордеро,
		Renault_АктСдачиПриемкиБСОБСО.ВидСтрахования КАК ВидСтрахования,
		Renault_АктСдачиПриемкиБСОБСО.СтраховойПолис.ТочкаПродаж КАК СтраховойПолисТочкаПродаж,
		//Renault_АктСдачиПриемкиБСОБСО.СтраховойПолис.Подразделение КАК СтраховойПолисПодразделение,
		СУММА(ВЫБОР
				КОГДА Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.Бордеро)
					ТОГДА Renault_АктСдачиПриемкиБСОБСО.ВознаграждениеАгентаСумма
				ИНАЧЕ 0
			КОНЕЦ + ВЫБОР
				КОГДА Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.ДВОУ)
					ТОГДА Renault_АктСдачиПриемкиБСОБСО.ВознаграждениеАгентаСумма
				ИНАЧЕ 0
			КОНЕЦ + ВЫБОР
				КОГДА Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.ВстречноеБордеро)
					ТОГДА Renault_АктСдачиПриемкиБСОБСО.ВознаграждениеАгентаСумма
				ИНАЧЕ 0
			КОНЕЦ) КАК СуммаИТОГО
//		Renault_АктСдачиПриемкиБСОБСО.СтраховойПолис.Отдел КАК СтраховойПолисОтдел
	ИЗ
		Документ.Renault_АктСдачиПриемкиБСО.БСО КАК Renault_АктСдачиПриемкиБСОБСО
	ГДЕ
		(Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.ВстречноеБордеро)
				ИЛИ Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.Бордеро)
				ИЛИ Renault_АктСдачиПриемкиБСОБСО.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыОперацийАктСдачиПриемкиБСО.ДВОУ))
		И Renault_АктСдачиПриемкиБСОБСО.Ссылка.Проведен
		И НЕ Renault_АктСдачиПриемкиБСОБСО.Ссылка.ПометкаУдаления
		И Renault_АктСдачиПриемкиБСОБСО.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	
	СГРУППИРОВАТЬ ПО
		Renault_АктСдачиПриемкиБСОБСО.Ссылка,
		Renault_АктСдачиПриемкиБСОБСО.Ссылка.СтраховаяКомпания,
		Renault_АктСдачиПриемкиБСОБСО.ВидСтрахования,
//		Renault_АктСдачиПриемкиБСОБСО.СтраховойПолис.Подразделение,
		Renault_АктСдачиПриемкиБСОБСО.СтраховойПолис.ТочкаПродаж
//		Renault_АктСдачиПриемкиБСОБСО.СтраховойПолис.Отдел
		) КАК ВложенныйЗапрос

СГРУППИРОВАТЬ ПО
	ВложенныйЗапрос.СтраховаяКомпания,
	ВложенныйЗапрос.Акт,
	ВложенныйЗапрос.ВидСтрахования,
//	ЕСТЬNULL(ВложенныйЗапрос.СтраховойПолисПодразделение, "Нет данных"),
	ЕСТЬNULL(ВложенныйЗапрос.СтраховойПолисТочкаПродаж, "Нет данных")
//	ЕСТЬNULL(ВложенныйЗапрос.СтраховойПолисОтдел, "нет данных")</query>
	</dataSet>
