		<useRestriction>false</useRestriction>
		<expression>ВЫБОР КОГДА &amp;КонецПериода = ДАТАВРЕМЯ(1,1,1,0,0,0) ТОГДА ТЕКУЩАЯДАТА() ИНАЧЕ &amp;КонецПериода КОНЕЦ</expression>
