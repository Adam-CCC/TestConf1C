		<query>ВЫБРАТЬ
	РегистрацияВремениСотрудника.Сотрудник КАК Сотрудник,
	НАЧАЛОПЕРИОДА(РегистрацияВремениСотрудника.Период, ДЕНЬ) КАК Дата,
	РегистрацияВремениСотрудника.Продолжительность КАК ЧасовФакт,
	РегистрацияВремениСотрудника.Период КАК НачалоФакт,
	РегистрацияВремениСотрудника.КонецРаботы КАК КонецФакт,
	NULL КАК ЧасовПлан,
	NULL КАК НачалоПлан,
	NULL КАК КонецПлан,
	РегистрацияВремениСотрудника.Сотрудник.Подразделение.ДилерскийЦентр КАК ДилерскийЦентр,
	1 КАК ДнейФакт,
	NULL КАК ДнейПлан,
	NULL КАК ВыработкаВруб,
	Сотрудники.Должность КАК Должность,
	НАЧАЛОПЕРИОДА(РегистрацияВремениСотрудника.Период, МЕСЯЦ) КАК МесяцДаты
ИЗ
	РегистрСведений.РегистрацияВремениСотрудника КАК РегистрацияВремениСотрудника
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		ПО РегистрацияВремениСотрудника.Сотрудник = Сотрудники.Ссылка
ГДЕ
	РегистрацияВремениСотрудника.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И РегистрацияВремениСотрудника.ВидОтметки = ЗНАЧЕНИЕ(Справочник.ВидыОтметокВремени.Работа)

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	Сотрудники.Ссылка,
	ГрафикРаботКалендарный.Дата,
	NULL,
	NULL,
	NULL,
	РАЗНОСТЬДАТ(ГрафикРаботКалендарный.НачалоРабочегоВремени, ГрафикРаботКалендарный.КонецРабочегоВремени, СЕКУНДА) / 3600,
	ДОБАВИТЬКДАТЕ(ГрафикРаботКалендарный.НачалоРабочегоВремени, ДЕНЬ, РАЗНОСТЬДАТ(ГрафикРаботКалендарный.НачалоРабочегоВремени, ГрафикРаботКалендарный.Дата, ДЕНЬ)),
	ДОБАВИТЬКДАТЕ(ГрафикРаботКалендарный.КонецРабочегоВремени, ДЕНЬ, РАЗНОСТЬДАТ(ГрафикРаботКалендарный.КонецРабочегоВремени, ГрафикРаботКалендарный.Дата, ДЕНЬ)),
	Сотрудники.Ссылка.Подразделение.ДилерскийЦентр,
	NULL,
	1,
	NULL,
	Сотрудники.Должность,
	НАЧАЛОПЕРИОДА(ГрафикРаботКалендарный.Дата, МЕСЯЦ)
ИЗ
	Справочник.Сотрудники КАК Сотрудники,
	РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
ГДЕ
	Сотрудники.ГрафикРаботы = ГрафикРаботКалендарный.График
	И ГрафикРаботКалендарный.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ГрафикРаботКалендарный.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидДня.Рабочий)

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ВыработкаСотрудниковОбороты.Сотрудник,
	НАЧАЛОПЕРИОДА(ВыработкаСотрудниковОбороты.Период, ДЕНЬ),
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	Сотрудники.Ссылка.Подразделение.ДилерскийЦентр,
	NULL,
	NULL,
	ВыработкаСотрудниковОбороты.СуммаУпрСоСкидкойОборот,
	Сотрудники.Ссылка.Должность,
	НАЧАЛОПЕРИОДА(ВыработкаСотрудниковОбороты.Период, МЕСЯЦ)
ИЗ
	РегистрНакопления.ВыработкаСотрудников.Обороты(, , День, ) КАК ВыработкаСотрудниковОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Сотрудники.Ссылка КАК Ссылка
		ИЗ
			Справочник.Сотрудники КАК Сотрудники) КАК Сотрудники
		ПО ВыработкаСотрудниковОбороты.Сотрудник = Сотрудники.Ссылка.Ссылка
ГДЕ
	ВыработкаСотрудниковОбороты.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

УПОРЯДОЧИТЬ ПО
	Сотрудник,
	Дата</query>
