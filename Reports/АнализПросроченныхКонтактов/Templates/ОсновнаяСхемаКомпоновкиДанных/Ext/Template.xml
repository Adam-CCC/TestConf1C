				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РабочийЛист.Ссылка КАК РабочийЛист,
	РабочийЛист.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр
ПОМЕСТИТЬ ТаблицаРабочихЛистов
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
ГДЕ
	РабочийЛист.Статус &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Отказ)
	И РабочийЛист.Статус &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.ОшибочныйНомер)
	И РабочийЛист.Статус &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.СделкаОтказ)
	И РабочийЛист.Проведен
	И РабочийЛист.Статус &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста._г_База)
	И РабочийЛист.Статус &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Архив)
	И РабочийЛист.ДатаСоздания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Событие.ДокументОснование КАК РабочийЛист,
	Событие.Ссылка КАК Событие,
	Событие.ДатаНачала КАК ДатаНачала
ПОМЕСТИТЬ Просроченные
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)
	И Событие.ДатаНачала &lt; &amp;ТекущаяДата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Событие.ДокументОснование КАК РабочийЛист
ПОМЕСТИТЬ Запланированные
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)
	И Событие.ДатаНачала &gt;= &amp;ТекущаяДата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Событие.ДокументОснование КАК РабочийЛист,
	Событие.Ссылка КАК Событие,
	Событие.ДатаНачала
ПОМЕСТИТЬ Отработанные
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
	И Событие.ДатаНачала &lt; &amp;ТекущаяДата
	И Событие.Ссылка В
			(ВЫБРАТЬ
				ЖурналСостояний.Объект
			ИЗ
				РегистрСведений.ЖурналСостояний КАК ЖурналСостояний
			ГДЕ
				ЖурналСостояний.Объект ССЫЛКА Документ.Событие
				И (ВЫРАЗИТЬ(ЖурналСостояний.Состояние КАК Перечисление.СостоянияСобытий)) = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
				И ЖурналСостояний.Период МЕЖДУ &amp;НачПериодаОтработано И &amp;КонПериодаОтработано)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Запланированные.РабочийЛист
ПОМЕСТИТЬ ОтработанныеРезультат
ИЗ
	Запланированные КАК Запланированные
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Отработанные КАК Отработанные
		ПО Запланированные.РабочийЛист = Отработанные.РабочийЛист
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Просроченные.РабочийЛист,
	Просроченные.Событие,
	Просроченные.ДатаНачала
ПОМЕСТИТЬ ПросроченныеРезультат
ИЗ
	Просроченные КАК Просроченные

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	ТаблицаРабочихЛистов.РабочийЛист,
	ЗНАЧЕНИЕ(Документ.Событие.ПустаяСсылка),
	ДАТАВРЕМЯ(1, 1, 1)
ИЗ
	ТаблицаРабочихЛистов КАК ТаблицаРабочихЛистов
		ЛЕВОЕ СОЕДИНЕНИЕ Запланированные КАК Запланированные
		ПО ТаблицаРабочихЛистов.РабочийЛист = Запланированные.РабочийЛист
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
		ПО ТаблицаРабочихЛистов.РабочийЛист = Событие.ДокументОснование
ГДЕ
	Запланированные.РабочийЛист ЕСТЬ NULL
	И НЕ Событие.Ссылка ЕСТЬ NULL
	И НЕ ТаблицаРабочихЛистов.РабочийЛист В
				(ВЫБРАТЬ
					Просроченные.РабочийЛист
				ИЗ
					Просроченные КАК Просроченные)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТаблицаРабочихЛистов.РабочийЛист,
	ЗНАЧЕНИЕ(Документ.Событие.ПустаяСсылка),
	ДАТАВРЕМЯ(1, 1, 1)
ИЗ
	ТаблицаРабочихЛистов КАК ТаблицаРабочихЛистов
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
		ПО ТаблицаРабочихЛистов.РабочийЛист = Событие.ДокументОснование
ГДЕ
	Событие.Ссылка ЕСТЬ NULL
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТаблицаРабочихЛистов.РабочийЛист,
	ТаблицаРабочихЛистов.РабочийЛист.Статус КАК Статус,
	ТаблицаРабочихЛистов.РабочийЛист.Менеджер КАК Менеджер,
	ТаблицаРабочихЛистов.РабочийЛист.Контрагент КАК Контрагент,
	ТаблицаРабочихЛистов.ДилерскийЦентр,
	ПросроченныеРезультат.Событие КАК ПросроченноеСобытие,
	0 КАК ОтработанноеПросроченноеСобытие,
	1 КАК Просроченных,
	0 КАК Всего
ИЗ
	ТаблицаРабочихЛистов КАК ТаблицаРабочихЛистов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПросроченныеРезультат КАК ПросроченныеРезультат
		ПО ТаблицаРабочихЛистов.РабочийЛист = ПросроченныеРезультат.РабочийЛист

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТаблицаРабочихЛистов.РабочийЛист.Ссылка,
	ТаблицаРабочихЛистов.РабочийЛист.Статус,
	ТаблицаРабочихЛистов.РабочийЛист.Менеджер,
	ТаблицаРабочихЛистов.РабочийЛист.Контрагент,
	ТаблицаРабочихЛистов.ДилерскийЦентр,
	ЗНАЧЕНИЕ(Документ.Событие.ПустаяСсылка),
	1,
	0,
	0
ИЗ
	ТаблицаРабочихЛистов КАК ТаблицаРабочихЛистов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтработанныеРезультат КАК ОтработанныеРезультат
		ПО ТаблицаРабочихЛистов.РабочийЛист = ОтработанныеРезультат.РабочийЛист

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Запланированные.РабочийЛист,
	Запланированные.РабочийЛист.Статус,
	Запланированные.РабочийЛист.Менеджер,
	Запланированные.РабочийЛист.Контрагент,
	Запланированные.РабочийЛист.ПодразделениеКомпании.ДилерскийЦентр,
	ЗНАЧЕНИЕ(Документ.Событие.ПустаяСсылка),
	0,
	0,
	1
ИЗ
	Запланированные КАК Запланированные</query>
