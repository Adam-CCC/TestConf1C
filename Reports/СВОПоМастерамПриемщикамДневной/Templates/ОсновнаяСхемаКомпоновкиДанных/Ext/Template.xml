		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	ЗаказНаряд.Диспетчер,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
	ЗаказНаряд.Автомобиль,
	СУММА(ЗаказНаряд.СуммаДокумента) КАК СуммаЗаказНаряда,
	СУММА(ЗаказНаряд.СуммаНоменклатурыДокумента) КАК СуммаЗапчастей,
	СУММА(ЗаказНаряд.СуммаРаботДокумента) КАК СуммаРабот,
	ЗаказНаряд.ВремяВыполненияРабот,
	ЗаказНаряд.Цех,
	&amp;ВалютаОтчета,
	&amp;КурсВалютыОтчета,
	МАКСИМУМ(ЗапросПланДни.ПланДниРабочие) КАК ПланДниРабочие,
	МАКСИМУМ(ЗапросДниФакт.ФактДней) КАК ФактДней
ПОМЕСТИТЬ ВТВыборЗаказНаряда
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ПланПоРабочимДнямСрезПоследних.Сотрудник КАК Сотрудник,
			МАКСИМУМ(ПланПоРабочимДнямСрезПоследних.Значение) КАК ПланДниРабочие
		ИЗ
			РегистрСведений.ПланПоРабочимДням.СрезПоследних(&amp;ДатаОкончания, ) КАК ПланПоРабочимДнямСрезПоследних
		
		СГРУППИРОВАТЬ ПО
			ПланПоРабочимДнямСрезПоследних.Сотрудник) КАК ЗапросПланДни
		ПО ЗаказНаряд.Диспетчер = ЗапросПланДни.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			РегистрацияВремениСотрудника.Сотрудник КАК Сотрудник,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(КОНЕЦПЕРИОДА(РегистрацияВремениСотрудника.Период, ДЕНЬ), 0)) КАК ФактДней
		ИЗ
			РегистрСведений.РегистрацияВремениСотрудника КАК РегистрацияВремениСотрудника
		ГДЕ
			РегистрацияВремениСотрудника.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
			И РегистрацияВремениСотрудника.ВидОтметки = ЗНАЧЕНИЕ(Справочник.ВидыОтметокВремени.Работа)
			И РегистрацияВремениСотрудника.Продолжительность &lt;&gt; 0
		
		СГРУППИРОВАТЬ ПО
			РегистрацияВремениСотрудника.Сотрудник) КАК ЗапросДниФакт
		ПО ЗаказНаряд.Диспетчер = ЗапросДниФакт.Сотрудник
ГДЕ
	ЗаказНаряд.Проведен
	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	И ЗаказНаряд.Дата МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.Диспетчер,
	ЗаказНаряд.ВремяВыполненияРабот,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.Ссылка,
	ЗаказНаряд.Автомобиль,
	ЗаказНаряд.Цех
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыВПроизводстве.Регистратор КАК ЗаказНаряд,
	СУММА(ТоварыВПроизводстве.СуммаУпр) КАК Себестоимость
ПОМЕСТИТЬ ВТСебестоимостьДеталей
ИЗ
	РегистрНакопления.ТоварыВПроизводстве КАК ТоварыВПроизводстве
ГДЕ
	ТоварыВПроизводстве.Период МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И ТоварыВПроизводстве.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	И ТоварыВПроизводстве.Регистратор ССЫЛКА Документ.ЗаказНаряд

СГРУППИРОВАТЬ ПО
	ТоварыВПроизводстве.Регистратор

ИМЕЮЩИЕ
	НЕ СУММА(ТоварыВПроизводстве.СуммаУпр) = 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТВыборЗаказНаряда.Диспетчер КАК Диспетчер,
	ВТВыборЗаказНаряда.ВидРемонта КАК ВидРемонта,
	ВТВыборЗаказНаряда.Автомобиль КАК Автомобиль,
	ВТВыборЗаказНаряда.ЗаказНаряд КАК ЗаказНаряд,
	ВЫБОР
		КОГДА ВТВыборЗаказНаряда.ЗаказНаряд.ВидРемонта.Коммерческий
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КолВоКоммерческих,
	ВЫБОР
		КОГДА ВТВыборЗаказНаряда.ЗаказНаряд.ВидРемонта.Коммерческий
			ТОГДА ВТВыборЗаказНаряда.СуммаЗаказНаряда
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаЗаказНаряда,
	ВЫБОР
		КОГДА ВТВыборЗаказНаряда.ЗаказНаряд.ВидРемонта.Коммерческий
			ТОГДА ВТВыборЗаказНаряда.СуммаЗапчастей
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаЗапчастей,
	ВЫБОР
		КОГДА ВТВыборЗаказНаряда.ЗаказНаряд.ВидРемонта.Коммерческий
			ТОГДА ВТВыборЗаказНаряда.СуммаРабот
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаРабот,
	ВТВыборЗаказНаряда.ВремяВыполненияРабот КАК ВремяВыполненияРабот,
	ВЫБОР
		КОГДА ВТВыборЗаказНаряда.ЗаказНаряд.ВидРемонта.Коммерческий
			ТОГДА ВТТоварыВПроизводствеОбороты.Себестоимость
		ИНАЧЕ 0
	КОНЕЦ КАК Себестоимость,
	0 КАК ПроцентКоммерческих,
	МП_ВП_Факт.ПланВыручка КАК ПланВыручка,
	ЕСТЬNULL(ВТВыборЗаказНаряда.СуммаЗаказНаряда, 0) - ЕСТЬNULL(ВТТоварыВПроизводствеОбороты.Себестоимость, 0) КАК ФактВыручка,
	ВЫБОР
		КОГДА ЕСТЬNULL(МП_ВП_Факт.ПланВыручка, 0) * ЕСТЬNULL(ВТВыборЗаказНаряда.ФактДней, 0) = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ((ЕСТЬNULL(ВТВыборЗаказНаряда.СуммаЗаказНаряда, 0) - ЕСТЬNULL(ВТТоварыВПроизводствеОбороты.Себестоимость, 0)) / (ЕСТЬNULL(МП_ВП_Факт.ПланВыручка, 0) * ЕСТЬNULL(ВТВыборЗаказНаряда.ФактДней, 0)) * 100 КАК ЧИСЛО(15, 2))
	КОНЕЦ КАК МП_ВП_ДневнойПроцент,
	ЕСТЬNULL(ВТВыборЗаказНаряда.ПланДниРабочие, 0) * ЕСТЬNULL(МП_ВП_Факт.ПланВыручка, 0) КАК ПланМесячный,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТВыборЗаказНаряда.ПланДниРабочие, 0) * ЕСТЬNULL(МП_ВП_Факт.ПланВыручка, 0) = 0
			ТОГДА 0
		ИНАЧЕ ВЫРАЗИТЬ((ЕСТЬNULL(ВТВыборЗаказНаряда.СуммаЗаказНаряда, 0) - ЕСТЬNULL(ВТТоварыВПроизводствеОбороты.Себестоимость, 0)) / (ЕСТЬNULL(ВТВыборЗаказНаряда.ПланДниРабочие, 0) * ЕСТЬNULL(МП_ВП_Факт.ПланВыручка, 0)) * 100 КАК ЧИСЛО(15, 2))
	КОНЕЦ КАК ПроцентМесячный,
	ВЫБОР
		КОГДА ВТВыборЗаказНаряда.ЗаказНаряд.ВидРемонта.Коммерческий
			ТОГДА ЕСТЬNULL(ВТВыборЗаказНаряда.ПланДниРабочие, 0) * ЕСТЬNULL(МП_ВП_Факт.ПланВыручка, 0) - (ЕСТЬNULL(ВТВыборЗаказНаряда.СуммаЗаказНаряда, 0) - ЕСТЬNULL(ВТТоварыВПроизводствеОбороты.Себестоимость, 0))
		ИНАЧЕ 0
	КОНЕЦ КАК МесячныйОсталось,
	ВЫБОР
		КОГДА ВТВыборЗаказНаряда.ЗаказНаряд.ВидРемонта.Коммерческий
			ТОГДА ВЫБОР
					КОГДА ЕСТЬNULL(ВТВыборЗаказНаряда.СуммаЗаказНаряда, 0) - ЕСТЬNULL(ВТТоварыВПроизводствеОбороты.Себестоимость, 0) = 0
						ТОГДА 0
					ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(ВТВыборЗаказНаряда.СуммаЗаказНаряда, 0) / (ЕСТЬNULL(ВТВыборЗаказНаряда.СуммаЗаказНаряда, 0) - ЕСТЬNULL(ВТТоварыВПроизводствеОбороты.Себестоимость, 0)) * 100 КАК ЧИСЛО(15, 2))
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК Рентабельность,
	ВТВыборЗаказНаряда.ФактДней КАК ФактДней,
	ВТВыборЗаказНаряда.ПланДниРабочие КАК ПланДниРабочие
ИЗ
	ВТВыборЗаказНаряда КАК ВТВыборЗаказНаряда
		ЛЕВОЕ СОЕДИНЕНИЕ ВТСебестоимостьДеталей КАК ВТТоварыВПроизводствеОбороты
		ПО ВТВыборЗаказНаряда.ЗаказНаряд = ВТТоварыВПроизводствеОбороты.ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ДнейвнойПланПоВыручкеСрезПоследних.Сотрудник КАК Сотрудник,
			СУММА(ДнейвнойПланПоВыручкеСрезПоследних.Значение) КАК ПланВыручка
		ИЗ
			РегистрСведений.ДнейвнойПланПоВыручке.СрезПоследних(&amp;ДатаОкончания, ) КАК ДнейвнойПланПоВыручкеСрезПоследних
		ГДЕ
			ДнейвнойПланПоВыручкеСрезПоследних.ВидРемонта.Коммерческий
		
		СГРУППИРОВАТЬ ПО
			ДнейвнойПланПоВыручкеСрезПоследних.Сотрудник) КАК МП_ВП_Факт
		ПО ВТВыборЗаказНаряда.Диспетчер = МП_ВП_Факт.Сотрудник</query>
	</dataSet>
	<totalField>
		<dataPath>Автомобиль</dataPath>
		<expression>КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Автомобиль)</expression>
	</totalField>
	<totalField>
		<dataPath>ВремяВыполненияРабот</dataPath>
		<expression>СУММА(ВремяВыполненияРабот)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗаказНаряд</dataPath>
		<expression>КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказНаряд)</expression>
	</totalField>
	<totalField>
		<dataPath>КолВоКоммерческих</dataPath>
		<expression>СУММА(КолВоКоммерческих)</expression>
	</totalField>
	<totalField>
		<dataPath>МесячныйОсталось</dataPath>
		<expression>МАКСИМУМ(ПланДниРабочие) * МАКСИМУМ(ПланВыручка) - (СУММА(СуммаЗаказНаряда) - СУММА(Себестоимость))</expression>
	</totalField>
	<totalField>
		<dataPath>МП_ВП_ДневнойПроцент</dataPath>
		<expression>(СУММА(СуммаЗаказНаряда) - СУММА(Себестоимость)) / (МАКСИМУМ(ФактДней) * МАКСИМУМ(ПланВыручка)) * 100</expression>
	</totalField>
	<totalField>
		<dataPath>ПланВыручка</dataPath>
		<expression>Максимум(ПланВыручка)</expression>
	</totalField>
	<totalField>
		<dataPath>ПланМесячный</dataPath>
		<expression>Максимум(ПланМесячный)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентКоммерческих</dataPath>
		<expression>СУММА(КолВоКоммерческих) / КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Автомобиль) * 100</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентМесячный</dataPath>
		<expression>(СУММА(СуммаЗаказНаряда) - СУММА(Себестоимость)) / (МАКСИМУМ(ПланДниРабочие) * МАКСИМУМ(ПланВыручка)) * 100</expression>
	</totalField>
	<totalField>
		<dataPath>Рентабельность</dataPath>
		<expression>ВЫБОР
	КОГДА СУММА(СуммаЗаказНаряда) = 0
		ТОГДА 0
	ИНАЧЕ (СУММА(СуммаЗаказНаряда) - СУММА(Себестоимость)) / СУММА(СуммаЗаказНаряда) * 100
КОНЕЦ</expression>
	</totalField>
	<totalField>
		<dataPath>Себестоимость</dataPath>
		<expression>Сумма(Себестоимость)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаЗаказНаряда</dataPath>
		<expression>Сумма(СуммаЗаказНаряда)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаЗапчастей</dataPath>
		<expression>Сумма(СуммаЗапчастей)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаРабот</dataPath>
		<expression>Сумма(СуммаРабот)</expression>
	</totalField>
	<totalField>
		<dataPath>ФактВыручка</dataPath>
		<expression>Сумма(СуммаЗаказНаряда)-Сумма(Себестоимость)</expression>
	</totalField>
	<totalField>
		<dataPath>ФактДней</dataPath>
		<expression>Максимум(ФактДней)</expression>
	</totalField>
	<totalField>
		<dataPath>ПланДниРабочие</dataPath>
		<expression>Максимум(ПланДниРабочие)</expression>
	</totalField>
