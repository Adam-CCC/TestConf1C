
Процедура СформироватьТабличныйДокумент(ТабличныйДокумент,ВыборкаОбщая) Экспорт
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьДанные = Макет.ПолучитьОбласть("ОбластьДанные");
	
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Если ВыборкаОбщая.Следующий() Тогда
		
		ВыборкаДанных = ВыборкаОбщая.Выбрать();
		
		Пока ВыборкаДанных.Следующий() Цикл
			
			ОбластьДанные.Параметры.Заполнить(ВыборкаДанных);
			ТабличныйДокумент.Вывести(ОбластьДанные);
			
		КонецЦикла; 
		
		ОбластьПодвал.Параметры.Заполнить(ВыборкаОбщая);
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
	КонецЕсли;  
	
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.АвтоМасштаб    = Истина;
	
КонецПроцедуры // СформироватьТабличныйДокумент()
