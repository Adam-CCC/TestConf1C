		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.ПодразделениеКомпании.ДилерскийЦентр,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.Организация,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.VIN,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.Модель.Марка,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.Модель,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.Контрагент,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.Дата,
	СУММА(ОстаткиАвтомобилейОстаткиИОбороты.СуммаРасход) КАК СуммаРасход,
	АвтомобилиСрезПоследних.Значение,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.ДатаОтчитки,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.Программа,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.РазмерСкидки,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.РазмерКомпенсации,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.ДатаОтправкиПакетаДокументов,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.ОжидаемаяДатаПолученияКомпенсации,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.СуммаПолученнойКомпенсации,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.АкцептованПакетДокументов,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.НомерДатаПП,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.НомерДатаПерезачета,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.КомментарийЛогиста
ИЗ
	РегистрНакопления.ОстаткиАвтомобилей.ОстаткиИОбороты(, , Авто, Движения, ) КАК ОстаткиАвтомобилейОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&amp;КонецПериода, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля)) КАК АвтомобилиСрезПоследних
		ПО ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
ГДЕ
	ТИПЗНАЧЕНИЯ(ОстаткиАвтомобилейОстаткиИОбороты.Регистратор) = ТИП(Документ.РеализацияАвтомобилей)
	И АвтомобилиСрезПоследних.Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.Новый)

СГРУППИРОВАТЬ ПО
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.ПодразделениеКомпании.ДилерскийЦентр,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.Организация,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.VIN,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.Модель.Марка,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.Модель,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.Контрагент,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор.Дата,
	ОстаткиАвтомобилейОстаткиИОбороты.Регистратор,
	АвтомобилиСрезПоследних.Значение,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.ДатаОтчитки,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.Программа,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.РазмерСкидки,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.РазмерКомпенсации,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.ДатаОтправкиПакетаДокументов,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.ОжидаемаяДатаПолученияКомпенсации,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.СуммаПолученнойКомпенсации,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.АкцептованПакетДокументов,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.НомерДатаПП,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.НомерДатаПерезачета,
	ОстаткиАвтомобилейОстаткиИОбороты.Автомобиль.КомментарийЛогиста</query>
	</dataSet>
