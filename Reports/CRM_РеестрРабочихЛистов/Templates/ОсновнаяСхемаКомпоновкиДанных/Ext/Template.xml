		<query>ВЫБРАТЬ
	Renault_РабочиеЛисты.ДатаID КАК Период,
	Renault_РабочиеЛисты.IDK,
	Renault_РабочиеЛисты.Отдел,
	Renault_РабочиеЛисты.Важность,
	Renault_РабочиеЛисты.ДатаID,
	Renault_РабочиеЛисты.ЗапросНаЗакрытие,
	Renault_РабочиеЛисты.Клиент,
	Renault_РабочиеЛисты.ЛистЗакрыт,
	Renault_РабочиеЛисты.МодельАвтомобиля,
	Renault_РабочиеЛисты.Сотрудник,
	Renault_РабочиеЛисты.ПричинаЗакрытия,
	Renault_РабочиеЛисты.Цвет,
	Renault_РабочиеЛисты.ПервичныйИнтересМодель,
	ЕСТЬNULL(КонтактнаяИнформация.Представление, "Не указан") КАК Телефон
	//ВазСистем Тарасов 08.02.2021 10:01:19 Инцидент #DMSREN-1087
	//{
	//Старый код:
	//Новый код:
	, ЕСТЬNULL(КонтактнаяИнформацияEMail.Представление, "Не указан") КАК EMail
	//}
ИЗ
	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		ПО Renault_РабочиеЛисты.Клиент = КонтактнаяИнформация.Объект
			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА)
	//ВазСистем Тарасов 08.02.2021 10:01:19 Инцидент #DMSREN-1087
	//{
	//Старый код:
	//Новый код:
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияEMail
		ПО Renault_РабочиеЛисты.Клиент = КонтактнаяИнформацияEMail.Объект
			И (КонтактнаяИнформацияEMail.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	//}
</query>
