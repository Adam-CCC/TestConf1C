	</totalField>
	<totalField>
		<dataPath>ПроцентНеликвида</dataPath>
		<expression>ВЫБОР
 КОГДА ЕстьNULL(Сумма(СуммаДокумента),0)=0 ТОГДА 0

  ИНАЧЕ ЕстьNULL(Сумма(СуммаНеликвидаЗН),0)/ЕстьNULL(Сумма(СуммаДокумента),0)*100

КОНЕЦ</expression>
		<group>ОбщийИтог</group>
	</totalField>
