//Козлов Е.А. Начало 21.10.2016
Функция СформироватьОтчет() Экспорт
	ТабДок = Новый ТабличныйДокумент;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Renault_Трафик.Идентификатор КАК Идентификатор,
	               |	Renault_Трафик.Менеджер КАК Менеджер
	               |ПОМЕСТИТЬ ОсновнойТрафикЗвонок
	               |ИЗ
	               |	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ДилерскийЦентр = ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.ПустаяСсылка)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ Renault_Трафик.ДилерскийЦентр = &ДилерскийЦентр
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &Отдел = ЗНАЧЕНИЕ(Справочник.CRM_Отделы.ПустаяСсылка)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ Renault_Трафик.Отдел = &Отдел
	               |		КОНЕЦ
	               |	И Renault_Трафик.ТипТрафика = ЗНАЧЕНИЕ(Справочник.CRM_ТипТрафика.Звонок)
	               |	И ВЫБОР
	               |			КОГДА &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ Renault_Трафик.Период >= &ДатаНачала
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ДатаКонец = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ Renault_Трафик.Период <= &ДатаКонец
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &Менеджер = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ Renault_Трафик.Менеджер = &Менеджер
	               |		КОНЕЦ
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Идентификатор,
	               |	Менеджер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CRM_УпущенныйТрафик.Менеджер КАК Менеджер,
	               |	CRM_УпущенныйТрафик.ИдентификаторТрафика КАК ИдентификаторТрафика
	               |ПОМЕСТИТЬ УпущенныйТрафикЗвонкиСтруктура
	               |ИЗ
	               |	РегистрСведений.CRM_УпущенныйТрафик КАК CRM_УпущенныйТрафик
	               |ГДЕ
	               |	(CRM_УпущенныйТрафик.Менеджер, CRM_УпущенныйТрафик.ИдентификаторТрафика) В
	               |			(ВЫБРАТЬ
	               |				ОсновнойТрафикЗвонок.Менеджер,
	               |				ОсновнойТрафикЗвонок.Идентификатор
	               |			ИЗ
	               |				ОсновнойТрафикЗвонок КАК ОсновнойТрафикЗвонок)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Renault_CRM_ОбращениеВАвтоСервис.ИдентификаторТрафика КАК ИдентификаторТрафика
	               |ПОМЕСТИТЬ ЗаписиНаСервисПоТрафикуОбщее
	               |ИЗ
	               |	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
	               |ГДЕ
	               |	Renault_CRM_ОбращениеВАвтоСервис.ИдентификаторТрафика В
	               |			(ВЫБРАТЬ
	               |				ОсновнойТрафикЗвонок.Идентификатор
	               |			ИЗ
	               |				ОсновнойТрафикЗвонок КАК ОсновнойТрафикЗвонок)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CRM_ЗадачиПоТрафику.Менеджер КАК Менеджер,
	               |	CRM_ЗадачиПоТрафику.ИдентификаторТрафика КАК ИдентификаторТрафика
	               |ПОМЕСТИТЬ ПерезвонитьПоТрафикуСтруктура
	               |ИЗ
	               |	РегистрСведений.CRM_ЗадачиПоТрафику КАК CRM_ЗадачиПоТрафику
	               |ГДЕ
	               |	CRM_ЗадачиПоТрафику.ТипЗадачи = ЗНАЧЕНИЕ(Перечисление.CRM_ТипыЗадачПоТрафику.ПерезвонПоПросьбеКлиента)
	               |	И (CRM_ЗадачиПоТрафику.Менеджер, CRM_ЗадачиПоТрафику.ИдентификаторТрафика) В
	               |			(ВЫБРАТЬ
	               |				ОсновнойТрафикЗвонок.Менеджер,
	               |				ОсновнойТрафикЗвонок.Идентификатор
	               |			ИЗ
	               |				ОсновнойТрафикЗвонок КАК ОсновнойТрафикЗвонок)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОсновнойТрафикЗвонок.Менеджер,
	               |	ОсновнойТрафикЗвонок.Идентификатор КАК ИдентификаторТрафика
	               |ПОМЕСТИТЬ ЗаписиНаСервисПоТрафикуСтруктура
	               |ИЗ
	               |	ОсновнойТрафикЗвонок КАК ОсновнойТрафикЗвонок
	               |ГДЕ
	               |	ОсновнойТрафикЗвонок.Идентификатор В
	               |			(ВЫБРАТЬ
	               |				ЗаписиНаСервисПоТрафикуОбщее.ИдентификаторТрафика
	               |			ИЗ
	               |				ЗаписиНаСервисПоТрафикуОбщее КАК ЗаписиНаСервисПоТрафикуОбщее)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОсновнойТрафикЗвонок.Менеджер,
	               |	ОсновнойТрафикЗвонок.Идентификатор
	               |ПОМЕСТИТЬ КонсультацииТрафикаСтруктура
	               |ИЗ
	               |	ОсновнойТрафикЗвонок КАК ОсновнойТрафикЗвонок
	               |ГДЕ
	               |	НЕ (ОсновнойТрафикЗвонок.Менеджер, ОсновнойТрафикЗвонок.Идентификатор) В
	               |				(ВЫБРАТЬ
	               |					УпущенныйТрафикЗвонкиСтруктура.Менеджер,
	               |					УпущенныйТрафикЗвонкиСтруктура.ИдентификаторТрафика
	               |				ИЗ
	               |					УпущенныйТрафикЗвонкиСтруктура КАК УпущенныйТрафикЗвонкиСтруктура
	               |		
	               |				ОБЪЕДИНИТЬ
	               |		
	               |				ВЫБРАТЬ
	               |					ЗаписиНаСервисПоТрафикуСтруктура.Менеджер,
	               |					ЗаписиНаСервисПоТрафикуСтруктура.ИдентификаторТрафика
	               |				ИЗ
	               |					ЗаписиНаСервисПоТрафикуСтруктура КАК ЗаписиНаСервисПоТрафикуСтруктура)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КонсультацииТрафикаСтруктура.Менеджер,
	               |	КонсультацииТрафикаСтруктура.Идентификатор
	               |ПОМЕСТИТЬ КонсультацииПерезвонитьСтруктура
	               |ИЗ
	               |	КонсультацииТрафикаСтруктура КАК КонсультацииТрафикаСтруктура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПерезвонитьПоТрафикуСтруктура КАК ПерезвонитьПоТрафикуСтруктура
	               |		ПО КонсультацииТрафикаСтруктура.Менеджер = ПерезвонитьПоТрафикуСтруктура.Менеджер
	               |			И КонсультацииТрафикаСтруктура.Идентификатор = ПерезвонитьПоТрафикуСтруктура.ИдентификаторТрафика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОсновнойТрафикЗвонок.Идентификатор) КАК КоличествоВсего,
	               |	ОсновнойТрафикЗвонок.Менеджер КАК Менеджер
	               |ПОМЕСТИТЬ ВсегоЗвонков
	               |ИЗ
	               |	ОсновнойТрафикЗвонок КАК ОсновнойТрафикЗвонок
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОсновнойТрафикЗвонок.Менеджер
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Менеджер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	УпущенныйТрафикЗвонкиСтруктура.Менеджер КАК Менеджер,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ УпущенныйТрафикЗвонкиСтруктура.ИдентификаторТрафика) КАК КоличествоУпущенных
	               |ПОМЕСТИТЬ УпущенныйТрафикЗвонки
	               |ИЗ
	               |	УпущенныйТрафикЗвонкиСтруктура КАК УпущенныйТрафикЗвонкиСтруктура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	УпущенныйТрафикЗвонкиСтруктура.Менеджер
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Менеджер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаписиНаСервисПоТрафикуСтруктура.Менеджер КАК Менеджер,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаписиНаСервисПоТрафикуСтруктура.ИдентификаторТрафика) КАК КоличествоЗаписей
	               |ПОМЕСТИТЬ ЗаписиНаСервисПоТрафику
	               |ИЗ
	               |	ЗаписиНаСервисПоТрафикуСтруктура КАК ЗаписиНаСервисПоТрафикуСтруктура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаписиНаСервисПоТрафикуСтруктура.Менеджер
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Менеджер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонсультацииТрафикаСтруктура.Менеджер КАК Менеджер,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонсультацииТрафикаСтруктура.Идентификатор) КАК КоличествоКонсультаций
	               |ПОМЕСТИТЬ КонсультацииТрафика
	               |ИЗ
	               |	КонсультацииТрафикаСтруктура КАК КонсультацииТрафикаСтруктура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КонсультацииТрафикаСтруктура.Менеджер
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Менеджер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонсультацииПерезвонитьСтруктура.Менеджер КАК Менеджер,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КонсультацииПерезвонитьСтруктура.Идентификатор) КАК КоличествоКонсультацийСПерезвоном
	               |ПОМЕСТИТЬ КонсультацииСПерезвонитьТрафика
	               |ИЗ
	               |	КонсультацииПерезвонитьСтруктура КАК КонсультацииПерезвонитьСтруктура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КонсультацииПерезвонитьСтруктура.Менеджер
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Менеджер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсегоЗвонков.Менеджер КАК Менеджер,
	               |	ВсегоЗвонков.КоличествоВсего КАК КоличествоВсегоЗвонков,
	               |	ЕСТЬNULL(УпущенныйТрафикЗвонки.КоличествоУпущенных, 0) КАК КоличествоУпущенныеЗвонки,
	               |	ЕСТЬNULL(ЗаписиНаСервисПоТрафику.КоличествоЗаписей, 0) КАК КоличествоЗаписейПоЗвонкам,
	               |	ЕСТЬNULL(КонсультацииТрафика.КоличествоКонсультаций, 0) КАК КоличествоКонсультаций,
	               |	ЕСТЬNULL(КонсультацииСПерезвонитьТрафика.КоличествоКонсультацийСПерезвоном, 0) КАК КоличествоКонсультацийСПерезвоном
	               |ИЗ
	               |	ВсегоЗвонков КАК ВсегоЗвонков
	               |		ЛЕВОЕ СОЕДИНЕНИЕ УпущенныйТрафикЗвонки КАК УпущенныйТрафикЗвонки
	               |		ПО ВсегоЗвонков.Менеджер = УпущенныйТрафикЗвонки.Менеджер
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЗаписиНаСервисПоТрафику КАК ЗаписиНаСервисПоТрафику
	               |		ПО ВсегоЗвонков.Менеджер = ЗаписиНаСервисПоТрафику.Менеджер
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КонсультацииТрафика КАК КонсультацииТрафика
	               |		ПО ВсегоЗвонков.Менеджер = КонсультацииТрафика.Менеджер
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КонсультацииСПерезвонитьТрафика КАК КонсультацииСПерезвонитьТрафика
	               |		ПО ВсегоЗвонков.Менеджер = КонсультацииСПерезвонитьТрафика.Менеджер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВсегоЗвонков.Менеджер.Наименование
	               |ИТОГИ
	               |	СУММА(КоличествоВсегоЗвонков),
	               |	СУММА(КоличествоУпущенныеЗвонки),
	               |	СУММА(КоличествоЗаписейПоЗвонкам),
	               |	СУММА(КоличествоКонсультаций),
	               |	СУММА(КоличествоКонсультацийСПерезвоном)
	               |ПО
	               |	ОБЩИЕ";  			   
	Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	Запрос.УстановитьПараметр("Отдел", Отдел);
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКонец", ?(ЗначениеЗаполнено(ДатаКонец), КонецДня(ДатаКонец), ДатаКонец)); 	
	Результат = Запрос.Выполнить(); 	
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьТаблицаИтоги = Макет.ПолучитьОбласть("ТаблицаИтоги");
	ОбластьТаблицаМенеджерыШапка = Макет.ПолучитьОбласть("ТаблицаМенеджерыШапка");

	Если ВыводитьОтбор Тогда
		ТекстОтбора = "";
		Если ЗначениеЗаполнено(ДилерскийЦентр) Тогда
			ТекстОтбора = "Дилерский центр - " + ДилерскийЦентр.Наименование;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Отдел) Тогда
			ТекстОтбора = ТекстОтбора + ?(ЗначениеЗаполнено(ТекстОтбора), ", ", "");
			ТекстОтбора = ТекстОтбора + "Отдел - " + Отдел.Наименование;
		КонецЕсли;

		Если ЗначениеЗаполнено(Менеджер) Тогда
			ТекстОтбора = ТекстОтбора + ?(ЗначениеЗаполнено(ТекстОтбора), ", ", "");
			ТекстОтбора = ТекстОтбора + "Менеджер - " + Менеджер.Наименование;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстОтбора) Тогда
			//Отборы
			ОбластьОтбор = Макет.ПолучитьОбласть("Отбор");
			ОбластьОтбор.Параметры.Отборы = ТекстОтбора;
			
			ТабДок.Вывести(ОбластьОтбор); 		
		КонецЕсли;
	КонецЕсли;
		
	КоличествоВсегоЗвонков = 0;
	КоличествоУпущенныеЗвонки = 0;
	КоличествоЗаписейПоЗвонкам = 0;
	КоличествоКонсультаций = 0;
	КоличествоКонсультацийСПерезвоном = 0;
	
	ПроцентУпущенные = 0;
	ПроцентЗаписей = 0;
	ПроцентКонсультаций = 0;
	
	Если НЕ Результат.Пустой() Тогда
		ВыборкаИтоги = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаИтоги.Следующий();
		
		КоличествоВсегоЗвонков = ВыборкаИтоги.КоличествоВсегоЗвонков;
		КоличествоУпущенныеЗвонки = ВыборкаИтоги.КоличествоУпущенныеЗвонки;
		КоличествоЗаписейПоЗвонкам = ВыборкаИтоги.КоличествоЗаписейПоЗвонкам;
		КоличествоКонсультаций = ВыборкаИтоги.КоличествоКонсультаций;
		КоличествоКонсультацийСПерезвоном = ВыборкаИтоги.КоличествоКонсультацийСПерезвоном;
		
		Если КоличествоВсегоЗвонков <> 0 Тогда 
			ПроцентУпущенные = Окр(100 * КоличествоУпущенныеЗвонки / КоличествоВсегоЗвонков, 1);
			ПроцентЗаписей = Окр(100 * КоличествоЗаписейПоЗвонкам / КоличествоВсегоЗвонков, 1);
			ПроцентКонсультаций = 100 - ПроцентУпущенные - ПроцентЗаписей;
		КонецЕсли; 
	КонецЕсли;
		
	ДатаНачалаТекст = ?(ЗначениеЗаполнено(ДатаНачала), Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + "г.", "-");
	ДатаКонецТекст = ?(ЗначениеЗаполнено(ДатаКонец), Формат(ДатаКонец, "ДФ=dd.MM.yyyy") + "г.", "-");
	
	//Шапка
	ОбластьШапка.Параметры.ДатаНачала = ДатаНачалаТекст; 
	ОбластьШапка.Параметры.ДатаКонец = ДатаКонецТекст;
	
	ОбластьШапка.Параметры.КоличествоЗвонков = КоличествоВсегоЗвонков;
	ОбластьШапка.Параметры.ЗвонокОбщее = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоВсегоЗвонков);
	
	ОбластьШапка.Параметры.КоличествоЗаписей = КоличествоЗаписейПоЗвонкам;
	ОбластьШапка.Параметры.ПроцентЗаписей = ПроцентЗаписей;
	ОбластьШапка.Параметры.ЗвонокЗаписей = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоЗаписейПоЗвонкам);
	
	ОбластьШапка.Параметры.КоличествоКонсультаций = КоличествоКонсультаций;
	ОбластьШапка.Параметры.ПроцентКонсультаций = ПроцентКонсультаций;
	ОбластьШапка.Параметры.ЗвонокКонсультаций = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоКонсультаций);

	ОбластьШапка.Параметры.КоличествоУпущенных = КоличествоУпущенныеЗвонки;
	ОбластьШапка.Параметры.ПроцентУпущенных = ПроцентУпущенные;
	ОбластьШапка.Параметры.ЗвонокУпущенных = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоУпущенныеЗвонки);

	ТабДок.Вывести(ОбластьШапка);

	//Таблица итогов
	ОбластьТаблицаИтоги.Параметры.КоличествоЗвонков = КоличествоВсегоЗвонков;
	ОбластьТаблицаИтоги.Параметры.ЗвонокОбщее = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоВсегоЗвонков);
	
	ОбластьТаблицаИтоги.Параметры.КоличествоЗаписей = КоличествоЗаписейПоЗвонкам;
	ОбластьТаблицаИтоги.Параметры.ЗвонокЗаписей = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоЗаписейПоЗвонкам);
	
	ОбластьТаблицаИтоги.Параметры.КоличествоЗвонковПерезвонить = КоличествоКонсультацийСПерезвоном;
	ОбластьТаблицаИтоги.Параметры.ЗвонокПерезвонить = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоКонсультацийСПерезвоном);
	
	КоличествоОставшихсяКонсультаций = КоличествоКонсультаций - КоличествоКонсультацийСПерезвоном;
	ОбластьТаблицаИтоги.Параметры.КоличествоКонсультаций = КоличествоОставшихсяКонсультаций;
	ОбластьТаблицаИтоги.Параметры.ЗвонокКонсультаций = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоОставшихсяКонсультаций);

	ОбластьТаблицаИтоги.Параметры.КоличествоУпущенных = КоличествоУпущенныеЗвонки;
	ОбластьТаблицаИтоги.Параметры.ЗвонокУпущенных = ПолучитьОкончаниеЗвонокПоЧислу(КоличествоУпущенныеЗвонки);

	ТабДок.Вывести(ОбластьТаблицаИтоги);
	
	//Таблица по менеджерам шапка
	ТабДок.Вывести(ОбластьТаблицаМенеджерыШапка); 
	
	Если НЕ Результат.Пустой() Тогда
		//Таблица по менеджерам Строки
		ОбластьТаблицаМенеджерыСтрока = Макет.ПолучитьОбласть("ТаблицаМенеджерыСтрока");
		
		Выборка = ВыборкаИтоги.Выбрать();
		
		Счетчик = 1;
		Пока Выборка.Следующий() Цикл
			ОбластьТаблицаМенеджерыСтрока.Параметры.НомерСтроки = Счетчик;
			ОбластьТаблицаМенеджерыСтрока.Параметры.Сотрудник = Выборка.Менеджер;
			ОбластьТаблицаМенеджерыСтрока.Параметры.КоличествоЗвонков = ?(Выборка.КоличествоВсегоЗвонков = 0, "0", Выборка.КоличествоВсегоЗвонков);
			ОбластьТаблицаМенеджерыСтрока.Параметры.КоличествоЗаписей = ?(Выборка.КоличествоЗаписейПоЗвонкам = 0, "0", Выборка.КоличествоЗаписейПоЗвонкам);
			ОбластьТаблицаМенеджерыСтрока.Параметры.КоличествоКонсультаций = ?(Выборка.КоличествоКонсультаций = 0, "0", Выборка.КоличествоКонсультаций);
			ОбластьТаблицаМенеджерыСтрока.Параметры.КоличествоУпущенных = ?(Выборка.КоличествоУпущенныеЗвонки = 0, "0", Выборка.КоличествоУпущенныеЗвонки);
			
			ТабДок.Вывести(ОбластьТаблицаМенеджерыСтрока);
			
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли; 	
	
	Возврат ТабДок;
КонецФункции

Функция ПолучитьОкончаниеЗвонокПоЧислу(Знач Число)
	Результат = "звонков";
	
	Если Число >= 20 Тогда
		Число = Число % 10;
	КонецЕсли;
	
	Если Число = 1 Тогда
		Результат = "звонок";
	ИначеЕсли Число = 2 ИЛИ Число = 3 ИЛИ Число = 4 Тогда
		Результат = "звонка";
	КонецЕсли;
	
	Возврат Результат;		
КонецФункции
