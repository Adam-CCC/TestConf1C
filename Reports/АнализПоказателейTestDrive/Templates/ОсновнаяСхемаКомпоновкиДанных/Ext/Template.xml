<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Подразделение</dataPath>
			<field>Подразделение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТестДрайвы</dataPath>
			<field>ТестДрайвы</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контакты</dataPath>
			<field>Контакты</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Отношение</dataPath>
			<field>Отношение</field>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧДЦ=2</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">0</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	Событие.Продавец,
	СУММА(1) КАК ТестДрайвы
ПОМЕСТИТЬ ВТСобытие
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТестДрайв)
	И Событие.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	Событие.Продавец
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	РабочийЛист.Менеджер,
	СУММА(1) КАК Контакты
ПОМЕСТИТЬ ВТРабочийЛист
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
ГДЕ
	РабочийЛист.Проведен
	И РабочийЛист.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И РабочийЛист.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)

СГРУППИРОВАТЬ ПО
	РабочийЛист.Менеджер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТСобытие.Продавец КАК Менеджер,
	ВТСобытие.Продавец.Подразделение КАК Подразделение,
	ВТСобытие.ТестДрайвы,
	ВТРабочийЛист.Контакты,
	ВТСобытие.ТестДрайвы / ВТРабочийЛист.Контакты * 100 КАК Отношение
ИЗ
	ВТРабочийЛист КАК ВТРабочийЛист
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСобытие КАК ВТСобытие
		ПО ВТРабочийЛист.Менеджер = ВТСобытие.Продавец

УПОРЯДОЧИТЬ ПО
	Подразделение,
	Менеджер</query>
	</dataSet>
	<totalField>
		<dataPath>ТестДрайвы</dataPath>
		<expression>Сумма(ТестДрайвы)</expression>
	</totalField>
	<totalField>
		<dataPath>Контакты</dataPath>
		<expression>Сумма(Контакты)</expression>
	</totalField>
	<totalField>
		<dataPath>Отношение</dataPath>
		<expression>Среднее(Отношение)</expression>
	</totalField>
	<parameter>
