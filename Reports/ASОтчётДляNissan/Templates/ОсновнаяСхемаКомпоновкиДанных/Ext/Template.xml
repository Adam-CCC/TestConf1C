		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Продажи.Регистратор.Номер,
	Продажи.Регистратор.Дата,
	Продажи.Номенклатура.Артикул,
	СУММА(Продажи.Количество) КАК Количество,
	СРЕДНЕЕ((Продажи.Себестоимость - Продажи.СуммаНДСВходящий) / Продажи.Количество) КАК СтоимостьЕдиницы,
	Продажи.ПодразделениеКомпании,
	Продажи.Номенклатура,
	Продажи.Поставщик,
	Продажи.Покупатель,
	Продажи.ДоговорВзаиморасчетов,
	Продажи.СкладКомпании,
	ВЫБОР
		КОГДА Продажи.Регистратор ССЫЛКА Документ.ЗаказНаряд
			ТОГДА ВЫБОР
					КОГДА Продажи.СкладКомпании В (&amp;СписокКузовныхЦехов)
						ТОГДА "кузовной цех"
					ИНАЧЕ "слесарный цех"
				КОНЕЦ
		КОГДА Продажи.Регистратор ССЫЛКА Документ.КомплектацияАвтомобиля
			ТОГДА "доп"
		ИНАЧЕ ВЫБОР
				КОГДА Продажи.Покупатель В (&amp;СписокОптовыхПокупателей)
					ТОГДА "опт"
				ИНАЧЕ "розница"
			КОНЕЦ
	КОНЕЦ КАК КаналРеализации
ИЗ
	РегистрНакопления.Продажи КАК Продажи
ГДЕ
	Продажи.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Продажи.ХозОперация В (ЗНАЧЕНИЕ(Справочник.ХозОперации.ЗаказНаряд), ЗНАЧЕНИЕ(Справочник.ХозОперации.КомплектацияАвтомобиля), ЗНАЧЕНИЕ(Справочник.ХозОперации.РеализацияТоваров))
	И Продажи.Номенклатура &lt;&gt; ЗНАЧЕНИЕ(Справочник.Номенклатура.Авторабота)
	И НЕ Продажи.Покупатель.НашаФирма

СГРУППИРОВАТЬ ПО
	Продажи.Регистратор.Номер,
	Продажи.Регистратор.Дата,
	Продажи.Номенклатура.Артикул,
	Продажи.Номенклатура,
	Продажи.Поставщик,
	Продажи.Покупатель,
	Продажи.ДоговорВзаиморасчетов,
	Продажи.СкладКомпании,
	Продажи.ПодразделениеКомпании,
	ВЫБОР
		КОГДА Продажи.Регистратор ССЫЛКА Документ.ЗаказНаряд
			ТОГДА ВЫБОР
					КОГДА Продажи.СкладКомпании В (&amp;СписокКузовныхЦехов)
						ТОГДА "кузовной цех"
					ИНАЧЕ "слесарный цех"
				КОНЕЦ
		КОГДА Продажи.Регистратор ССЫЛКА Документ.КомплектацияАвтомобиля
			ТОГДА "доп"
		ИНАЧЕ ВЫБОР
				КОГДА Продажи.Покупатель В (&amp;СписокОптовыхПокупателей)
					ТОГДА "опт"
				ИНАЧЕ "розница"
			КОНЕЦ
	КОНЕЦ</query>
