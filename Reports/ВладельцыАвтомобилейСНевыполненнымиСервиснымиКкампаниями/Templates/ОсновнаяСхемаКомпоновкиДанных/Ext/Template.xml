		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВыполнениеСервисныхКампаний.VIN,
	ВыполнениеСервисныхКампаний.СервиснаяКампания,
	ВыполнениеСервисныхКампаний.ДатаВыполнения,
	ВыполнениеСервисныхКампаний.ДокументВыполнения,
	ВыполнениеСервисныхКампаний.СервиснаяКампания.ДатаОкончания КАК ДатаОкончанияСервиснойКампании,
	АвтомобилиСрезПоследних.Автомобиль,
	АвтомобилиСрезПоследних.ВидЗначения,
	АвтомобилиСрезПоследних.Значение КАК Владелец,
	КонтактнаяИнформация.Представление КАК НомерТелефона,
	КонтактнаяИнформация.Объект КАК ВладелецТелефона,
	КонтактнаяИнформация.Тип КАК ТипТелефон,
	КонтактнаяИнформация.Вид КАК ВидТелефон,
	КонтактнаяИнформацияАдрес.Представление КАК Адрес,
	КонтактнаяИнформацияАдрес.Объект КАК ВладелецАдреса,
	КонтактнаяИнформацияАдрес.Тип КАК ТипАдрес,
	КонтактнаяИнформацияАдрес.Вид КАК ВидАдрес,
	АвтомобилиСрезПоследних.Автомобиль.Модель КАК МодельАвтомобиля,
	ВыполнениеСервисныхКампаний.СервиснаяКампания.Обязательная КАК ОбязательнаяСервиснаяКампания
ИЗ
	РегистрСведений.ВыполнениеСервисныхКампаний КАК ВыполнениеСервисныхКампаний
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			ПО АвтомобилиСрезПоследних.Значение = КонтактнаяИнформация.Объект
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияАдрес
			ПО АвтомобилиСрезПоследних.Значение = КонтактнаяИнформацияАдрес.Объект
		ПО ВыполнениеСервисныхКампаний.VIN = АвтомобилиСрезПоследних.Автомобиль.VIN
ГДЕ
	ВыполнениеСервисныхКампаний.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
	И ВыполнениеСервисныхКампаний.ДокументВыполнения = ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	И (ВыполнениеСервисныхКампаний.СервиснаяКампания.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ ВыполнениеСервисныхКампаний.СервиснаяКампания.ДатаОкончания &gt; &amp;ТекущаяДата)
	И АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)
	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтактный)
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	И КонтактнаяИнформацияАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический)
	И КонтактнаяИнформацияАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)</query>
