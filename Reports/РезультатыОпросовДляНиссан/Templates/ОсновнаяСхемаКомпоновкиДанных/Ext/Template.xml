		<field xsi:type="DataSetFieldField">
			<dataPath>СреднийБалл</dataPath>
			<field>СреднийБалл</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Средний балл</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧДЦ=2</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Опрос.ОпрашиваемоеЛицо КАК ОпрашиваемоеЛицо,
	СУММА(ЕСТЬNULL(ВариантыОтветовОпросов.ОценкаОтвета, 0)) КАК КоличествоБаллов,
	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(ВариантыОтветовОпросов.ОценкаОтвета, 0) = 0
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоОтветов,
	Опрос.Менеджер,
	Опрос.Ссылка КАК ОпросСсылка
ПОМЕСТИТЬ ОтветыВБаллах
ИЗ
	Документ.Опрос КАК Опрос
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Опрос.Вопросы КАК ОпросВопросы
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыОтветовОпросов КАК ВариантыОтветовОпросов
			ПО ОпросВопросы.ТиповойОтвет = ВариантыОтветовОпросов.Ссылка
		ПО (ОпросВопросы.Ссылка = Опрос.Ссылка)
ГДЕ
	НЕ Опрос.ПометкаУдаления
	И Опрос.ОпросЗавершен
	И Опрос.ТиповаяАнкета = &amp;Анкета
	И ВЫБОР
			КОГДА &amp;ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Опрос.Дата &gt;= &amp;ДатаНачала
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Опрос.Дата &lt;= &amp;ДатаОкончания
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	Опрос.ОпрашиваемоеЛицо,
	Опрос.Менеджер,
	Опрос.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОтветыВБаллах.ОпрашиваемоеЛицо,
	ВЫБОР
		КОГДА ОтветыВБаллах.КоличествоОтветов = 0
			ТОГДА 0
		ИНАЧЕ ОтветыВБаллах.КоличествоБаллов / ОтветыВБаллах.КоличествоОтветов
	КОНЕЦ КАК СреднийБалл,
	1 КАК Количество,
	ОтветыВБаллах.ОпросСсылка КАК ОпросСсылка
ПОМЕСТИТЬ СредниеБаллы
ИЗ
	ОтветыВБаллах КАК ОтветыВБаллах
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Опрос.ОпрашиваемоеЛицо КАК ОпрашиваемоеЛицо,
	ОпросВопросы.Вопрос КАК Вопрос,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВариантыОтветовОпросов.ОценкаОтвета, 0) = 0
			ТОГДА ВЫБОР
					КОГДА ОпросВопросы.ТиповойОтвет = ИСТИНА
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ ВариантыОтветовОпросов.ОценкаОтвета
	КОНЕЦ КАК Ответ,
	Опрос.Автор,
	Опрос.Комментарий,
	Опрос.Менеджер КАК МенеджерКС,
	Опрос.Мастер,
	СредниеБаллы.СреднийБалл
ИЗ
	Документ.Опрос КАК Опрос
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Опрос.Вопросы КАК ОпросВопросы
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыОтветовОпросов КАК ВариантыОтветовОпросов
			ПО ОпросВопросы.ТиповойОтвет = ВариантыОтветовОпросов.Ссылка
		ПО Опрос.Ссылка = ОпросВопросы.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ СредниеБаллы КАК СредниеБаллы
		ПО Опрос.Ссылка = СредниеБаллы.ОпросСсылка
ГДЕ
	НЕ Опрос.ПометкаУдаления
	И Опрос.ОпросЗавершен
	И Опрос.ТиповаяАнкета = &amp;Анкета
	И ВЫБОР
			КОГДА &amp;ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Опрос.Дата &gt;= &amp;ДатаНачала
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Опрос.Дата &lt;= &amp;ДатаОкончания
		КОНЕЦ
	И НЕ Опрос.ПометкаУдаления
	И Опрос.ОпросЗавершен</query>
