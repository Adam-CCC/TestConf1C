			<field>ОплатаКлиентом</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_ВызовыТаксиОбороты.ДилерскийЦентр,
	Renault_ВызовыТаксиОбороты.Клиент,
	Renault_ВызовыТаксиОбороты.Менеджер,
	Renault_ВызовыТаксиОбороты.СтоимостьОборот КАК СуммаВызовов,
	Renault_ВызовыТаксиОбороты.КоличествоОборот КАК КоличествоВызовов,
	ВЫБОР
		КОГДА Renault_ВызовыТаксиОбороты.ОплатаДилерскимЦентром
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОплатаКлиентом,
	Renault_ВызовыТаксиОбороты.ОплатаДилерскимЦентром
ИЗ
	РегистрНакопления.Renault_ВызовыТакси.Обороты(
			&amp;ДатаНачала {(&amp;ДатаНачала)},
			&amp;ДатаОкончания {(&amp;ДатаОкончания)},
			,
			(ДилерскийЦентр = &amp;ДилерскийЦентр
				ИЛИ &amp;ДилерскийЦентр = ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.ПустаяСсылка))
				И (Клиент = &amp;Клиент
					ИЛИ &amp;Клиент = НЕОПРЕДЕЛЕНО
					ИЛИ &amp;Клиент = ""
					ИЛИ &amp;Клиент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
					ИЛИ &amp;Клиент = ЗНАЧЕНИЕ(Справочник.CRM_ПотенциальныеКонтрагенты.ПустаяСсылка))
				И (Менеджер = &amp;Менеджер
					ИЛИ &amp;Менеджер = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))) КАК Renault_ВызовыТаксиОбороты
ГДЕ
	ВЫБОР
			КОГДА &amp;ОплатаТолькоДилерскимЦентром
					ИЛИ &amp;ОплатаТолькоКлиентом
				ТОГДА Renault_ВызовыТаксиОбороты.ОплатаДилерскимЦентром = &amp;ОплатаТолькоДилерскимЦентром
						И ВЫБОР
							КОГДА Renault_ВызовыТаксиОбороты.ОплатаДилерскимЦентром
								ТОГДА ЛОЖЬ
							ИНАЧЕ ИСТИНА
						КОНЕЦ = &amp;ОплатаТолькоКлиентом
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
	</dataSet>
