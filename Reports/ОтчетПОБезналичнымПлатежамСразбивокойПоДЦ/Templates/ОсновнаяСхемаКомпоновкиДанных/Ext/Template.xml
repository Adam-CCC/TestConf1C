		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВыпискаСостав.Ссылка.Организация,
	ВыпискаСостав.Контрагент,
	ВыпискаСостав.Ссылка.Дата КАК Дата,
	ВыпискаСостав.СтатьяДДС,
	ВыпискаСостав.Сделка,
	ВыпискаСостав.Ссылка.БанковскийСчет,
	ВыпискаСостав.НазначениеПлатежа КАК НазначениеПлатежа,
	ВыпискаСостав.СуммаРасход КАК СуммаРасхода,
	ВыпискаСостав.СтавкаНДС,
	ВыпискаСостав.ПлатежноеПоручениеОснование КАК ДанныеОПлатеже,
	ВыпискаСостав.ДоговорВзаиморасчетов,
	СОКРЛП(СТРЗАМЕНИТЬ(ПлатежноеПоручениеСостав.АдресДоставкиГруппыПодразделений, "Ростовская обл,", "")) КАК АдресДоставкиГруза,
	ПлатежноеПоручениеСостав.ГруппаПодразделений КАК ДилерскийЦентр,
	ПлатежноеПоручениеСостав.Ссылка.ПодписантСчета,
	ПлатежноеПоручениеСостав.ЗаказчикФИОГруппыПодразделений КАК ФИОЗаказчика,
	ПлатежноеПоручениеСостав.СуммаГруппыПодразделений КАК СуммаДЦ,
	ПлатежноеПоручениеСостав.Ссылка КАК ПлатежноеПоручение,
	ВыпискаСостав.Ссылка КАК Выписка,
	ПлатежноеПоручениеСостав.Ссылка.ПометкаУдаления
ИЗ
	Документ.Выписка.Состав КАК ВыпискаСостав
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежноеПоручение.Состав КАК ПлатежноеПоручениеСостав
		ПО ВыпискаСостав.Сделка = ПлатежноеПоручениеСостав.Ссылка.ДокументОснование
ГДЕ
	ВыпискаСостав.Ссылка.Проведен
	И ВыпискаСостав.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ТИПЗНАЧЕНИЯ(ВыпискаСостав.Сделка) = ТИП(Документ.СчетОтПоставщика)
	И НЕ ПлатежноеПоручениеСостав.Ссылка.ПометкаУдаления

УПОРЯДОЧИТЬ ПО
	Дата</query>
