		<query>ВЫБРАТЬ
	ЗаказыПокупателей.Контрагент,
	ЗаказыПокупателей.Заказ,
	ЗаказыПокупателей.Номенклатура,
	ЗаказыПокупателей.Заказано КАК Заказано,
	ЗаказыПокупателей.Период КАК Период
ПОМЕСТИТЬ Заказы
ИЗ
	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
ГДЕ
	ЗаказыПокупателей.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЗаказыПокупателей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	И ЗаказыПокупателей.Заказано &gt; 0
	И ТИПЗНАЧЕНИЯ(ЗаказыПокупателей.Заказ) &lt;&gt; ТИП(Документ.ЗаказВнутренний)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказыПокупателей.Контрагент,
	ЗаказыПокупателей.Заказ,
	ЗаказыПокупателей.Номенклатура,
	СУММА(ЗаказыПокупателей.Резерв) КАК Резерв,
	МАКСИМУМ(ЗаказыПокупателей.Период) КАК Период
ПОМЕСТИТЬ Резервы
ИЗ
	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
ГДЕ
	ЗаказыПокупателей.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЗаказыПокупателей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	И ЗаказыПокупателей.Резерв &gt; 0
	И ТИПЗНАЧЕНИЯ(ЗаказыПокупателей.Заказ) &lt;&gt; ТИП(Документ.ЗаказВнутренний)

СГРУППИРОВАТЬ ПО
	ЗаказыПокупателей.Контрагент,
	ЗаказыПокупателей.Заказ,
	ЗаказыПокупателей.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Резервы.Контрагент,
	Резервы.Заказ,
	Резервы.Номенклатура,
	ВЫБОР
		КОГДА РАЗНОСТЬДАТ(Заказы.Период, Резервы.Период, ДЕНЬ) = 0
			ТОГДА 1
		ИНАЧЕ РАЗНОСТЬДАТ(Заказы.Период, Резервы.Период, ДЕНЬ)
	КОНЕЦ КАК ДнейВыполнения,
	Резервы.Резерв,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(Резервы.Заказ) = ТИП(Документ.ЗаказПокупателя)
			ТОГДА ВЫБОР
					КОГДА Резервы.Заказ.ТипЗаказа ЕСТЬ NULL 
						ТОГДА ЛОЖЬ
					ИНАЧЕ ВЫБОР
							КОГДА Заказы.Заказ.ТипЗаказа = ЗНАЧЕНИЕ(Справочник.ТипыЗаказов.ГарантияЗавода)
								ТОГДА ИСТИНА
							ИНАЧЕ ЛОЖЬ
						КОНЕЦ
				КОНЕЦ
		КОГДА ТИПЗНАЧЕНИЯ(Резервы.Заказ) = ТИП(Документ.ЗаявкаНаРемонт)
			ТОГДА Резервы.Заказ.ВидРемонта.ГарантияЗавода
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ГарантияЗавода
ПОМЕСТИТЬ ВыполненныеЗаказы
ИЗ
	Резервы КАК Резервы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заказы КАК Заказы
		ПО Резервы.Контрагент = Заказы.Контрагент
			И Резервы.Заказ = Заказы.Заказ
			И Резервы.Номенклатура = Заказы.Номенклатура
ГДЕ
	Заказы.Заказано = Резервы.Резерв
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВыполненныеЗаказы.Контрагент,
	ВыполненныеЗаказы.Заказ,
	ВыполненныеЗаказы.Номенклатура,
	ВЫБОР
		КОГДА ВыполненныеЗаказы.ГарантияЗавода
			ТОГДА "Гарантийный"
		ИНАЧЕ "Коммерческий"
	КОНЕЦ КАК ТипЗаказа,
	ВыполненныеЗаказы.ГарантияЗавода,
	ВыполненныеЗаказы.Резерв КАК Количество,
	ВЫБОР
		КОГДА ВыполненныеЗаказы.ДнейВыполнения &gt;= 10
				И ВыполненныеЗаказы.ДнейВыполнения &lt;= 14
			ТОГДА ВыполненныеЗаказы.ДнейВыполнения
		ИНАЧЕ 0
	КОНЕЦ КАК От10До14,
	ВЫБОР
		КОГДА ВыполненныеЗаказы.ДнейВыполнения &lt;= 9
			ТОГДА ВыполненныеЗаказы.ДнейВыполнения
		ИНАЧЕ 0
	КОНЕЦ КАК До9,
	ВЫБОР
		КОГДА ВыполненныеЗаказы.ДнейВыполнения &gt;= 15
				И ВыполненныеЗаказы.ДнейВыполнения &lt;= 20
			ТОГДА ВыполненныеЗаказы.ДнейВыполнения
		ИНАЧЕ 0
	КОНЕЦ КАК От15До20,
	ВЫБОР
		КОГДА ВыполненныеЗаказы.ДнейВыполнения &gt;= 21
				И ВыполненныеЗаказы.ДнейВыполнения &lt;= 30
			ТОГДА ВыполненныеЗаказы.ДнейВыполнения
		ИНАЧЕ 0
	КОНЕЦ КАК От21До30,
	ВЫБОР
		КОГДА ВыполненныеЗаказы.ДнейВыполнения &gt;= 31
				И ВыполненныеЗаказы.ДнейВыполнения &lt;= 45
			ТОГДА ВыполненныеЗаказы.ДнейВыполнения
		ИНАЧЕ 0
	КОНЕЦ КАК От31До45,
	ВЫБОР
		КОГДА ВыполненныеЗаказы.ДнейВыполнения &gt; 45
			ТОГДА ВыполненныеЗаказы.ДнейВыполнения
		ИНАЧЕ 0
	КОНЕЦ КАК От46
ИЗ
	ВыполненныеЗаказы КАК ВыполненныеЗаказы</query>
