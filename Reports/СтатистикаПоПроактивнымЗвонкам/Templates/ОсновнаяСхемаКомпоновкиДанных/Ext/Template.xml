		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(Событие.Дата, МЕСЯЦ) КАК Дата,
	РезультатКонтактаСпр.Ссылка КАК Результат,
	СУММА(1) КАК Количество,
	РабочийЛистСервиса.ДатаКонтакта,
	РабочийЛистСервиса.Контрагент КАК Клиент,
	РабочийЛистСервиса.Автор,
	РабочийЛистСервиса.Автомобиль,
	РабочийЛистСервиса.Менеджер,
	ВЫБОР
		КОГДА РезультатКонтактаСпр.Ссылка = ЗНАЧЕНИЕ(Справочник.РезультатКонтакта.ПустаяСсылка)
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ТолькоСРезультатом,
	1 КАК Приоритет
ПОМЕСТИТЬ РабочиеЛисты
ИЗ
	Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РезультатКонтакта КАК РезультатКонтактаСпр
			ПО ((ВЫРАЗИТЬ(Событие.Результат КАК СТРОКА(100))) = (ВЫРАЗИТЬ(РезультатКонтактаСпр.Наименование КАК СТРОКА(100))))
		ПО (НЕ Событие.ПометкаУдаления)
			И РабочийЛистСервиса.Ссылка = Событие.ДокументОснование
ГДЕ
	РабочийЛистСервиса.Проведен
	И РабочийЛистСервиса.УчастникПрограммыПроактивныйКонтакт
	И НЕ Событие.Ссылка ЕСТЬ NULL 

СГРУППИРОВАТЬ ПО
	РабочийЛистСервиса.ДатаКонтакта,
	РабочийЛистСервиса.Контрагент,
	РабочийЛистСервиса.Автор,
	РабочийЛистСервиса.Автомобиль,
	РабочийЛистСервиса.Менеджер,
	НАЧАЛОПЕРИОДА(Событие.Дата, МЕСЯЦ),
	РезультатКонтактаСпр.Ссылка,
	ВЫБОР
		КОГДА РезультатКонтактаСпр.Ссылка = ЗНАЧЕНИЕ(Справочник.РезультатКонтакта.ПустаяСсылка)
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МИНИМУМ(РабочиеЛисты.Дата) КАК ДатаНачала,
	МАКСИМУМ(РабочиеЛисты.Дата) КАК ДатаОкончания
ПОМЕСТИТЬ ИнтервалРабочихЛистов
ИЗ
	РабочиеЛисты КАК РабочиеЛисты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(ПродажиАвтомобилейОбороты.Период, МЕСЯЦ) КАК Дата,
	ПродажиАвтомобилейОбороты.КоличествоОборот КАК Количество,
	2 КАК Приоритет
ПОМЕСТИТЬ Продажи
ИЗ
	РегистрНакопления.ПродажиАвтомобилей.Обороты(, , Месяц, ) КАК ПродажиАвтомобилейОбороты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИнтервалРабочихЛистов КАК ИнтервалРабочихЛистов
		ПО (ПродажиАвтомобилейОбороты.Период &lt;= КОНЕЦПЕРИОДА(ИнтервалРабочихЛистов.ДатаОкончания, МЕСЯЦ))
			И (ПродажиАвтомобилейОбороты.Период &gt;= НАЧАЛОПЕРИОДА(ИнтервалРабочихЛистов.ДатаНачала, МЕСЯЦ))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ПродажиАвтомобилейОбороты.Период, МЕСЯЦ), МЕСЯЦ, 12) КАК Дата,
	ПродажиАвтомобилейОбороты.КоличествоОборот КАК Количество,
	3 КАК Приоритет
ПОМЕСТИТЬ ПродажиПрошлыйГод
ИЗ
	РегистрНакопления.ПродажиАвтомобилей.Обороты(, , Месяц, ) КАК ПродажиАвтомобилейОбороты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИнтервалРабочихЛистов КАК ИнтервалРабочихЛистов
		ПО (ПродажиАвтомобилейОбороты.Период &lt;= ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(ИнтервалРабочихЛистов.ДатаОкончания, МЕСЯЦ), МЕСЯЦ, -12))
			И (ПродажиАвтомобилейОбороты.Период &gt;= ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ИнтервалРабочихЛистов.ДатаНачала, МЕСЯЦ), МЕСЯЦ, -12))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(ЗаказНаряд.Дата, МЕСЯЦ) КАК Дата,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказНаряд.Автомобиль) КАК Количество,
	РезультатМашинозаезд.Результат,
	4 КАК Приоритет
ПОМЕСТИТЬ Машинозаезды
ИЗ
	(ВЫБРАТЬ
		"Машинозаезды" КАК Результат) КАК РезультатМашинозаезд
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряд
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИнтервалРабочихЛистов КАК ИнтервалРабочихЛистов
			ПО (ЗаказНаряд.Дата &gt;= НАЧАЛОПЕРИОДА(ИнтервалРабочихЛистов.ДатаНачала, МЕСЯЦ))
				И (ЗаказНаряд.Дата &lt;= КОНЕЦПЕРИОДА(ИнтервалРабочихЛистов.ДатаОкончания, МЕСЯЦ))
		ПО (ИСТИНА)
ГДЕ
	ЗаказНаряд.Проведен

СГРУППИРОВАТЬ ПО
	НАЧАЛОПЕРИОДА(ЗаказНаряд.Дата, МЕСЯЦ),
	РезультатМашинозаезд.Результат
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РабочиеЛисты.Дата,
	РабочиеЛисты.Результат,
	РабочиеЛисты.Количество,
	РабочиеЛисты.ДатаКонтакта,
	РабочиеЛисты.Клиент,
	РабочиеЛисты.Автор,
	РабочиеЛисты.Автомобиль,
	РабочиеЛисты.Менеджер,
	РабочиеЛисты.ТолькоСРезультатом,
	РабочиеЛисты.Приоритет КАК Категория
ИЗ
	РабочиеЛисты КАК РабочиеЛисты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Продажи.Дата,
	РезультатПродажа.Результат,
	ВЫБОР
		КОГДА ЕСТЬNULL(НастройкаОтчетаПоСтатистикеПК.КоличествоПродаж, 0) = 0
			ТОГДА Продажи.Количество
		ИНАЧЕ НастройкаОтчетаПоСтатистикеПК.КоличествоПродаж
	КОНЕЦ,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	Продажи.Приоритет
ИЗ
	(ВЫБРАТЬ
		"Продажи автомобилей" КАК Результат) КАК РезультатПродажа
		ЛЕВОЕ СОЕДИНЕНИЕ Продажи КАК Продажи
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОтчетаПоСтатистикеПК КАК НастройкаОтчетаПоСтатистикеПК
			ПО Продажи.Дата = НастройкаОтчетаПоСтатистикеПК.Дата
		ПО (ИСТИНА)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Машинозаезды.Дата,
	Машинозаезды.Результат,
	ВЫБОР
		КОГДА ЕСТЬNULL(НастройкаОтчетаПоСтатистикеПК.КоличествоМашин, 0) = 0
			ТОГДА Машинозаезды.Количество
		ИНАЧЕ НастройкаОтчетаПоСтатистикеПК.КоличествоМашин
	КОНЕЦ,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	Машинозаезды.Приоритет
ИЗ
	Машинозаезды КАК Машинозаезды
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОтчетаПоСтатистикеПК КАК НастройкаОтчетаПоСтатистикеПК
		ПО Машинозаезды.Дата = НастройкаОтчетаПоСтатистикеПК.Дата

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПродажиПрошлыйГод.Дата,
	РезультатПродажаПрошлыйГод.Результат,
	ПродажиПрошлыйГод.Количество,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	ПродажиПрошлыйГод.Приоритет
ИЗ
	(ВЫБРАТЬ
		"Продажи автомобилей (прошлый год)" КАК Результат) КАК РезультатПродажаПрошлыйГод
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПродажиПрошлыйГод КАК ПродажиПрошлыйГод
		ПО (ИСТИНА)

УПОРЯДОЧИТЬ ПО
	Категория</query>
