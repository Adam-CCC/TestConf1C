		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиТоваровКомпанииОстатки.Номенклатура,
	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул,
	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Остаток,
	ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение.ДилерскийЦентр КАК ДилерскийЦентр,
	КартинкиИфайлы.Объект КАК НоменклатураКартинки,
	КартинкиИфайлы.РазмерФайла,
	КартинкиИфайлы.Картинка,
	КартинкиИфайлы.ДатаСохранения,
	ОстаткиТоваровКомпанииОстатки.Номенклатура.ЯчейкиХранения.(
		ЯчейкаХранения КАК Ячейка,
		СкладКомпании КАК Склад
	) КАК НоменклатураЯчеек
ИЗ
	РегистрНакопления.ОстаткиТоваровКомпании.Остатки КАК ОстаткиТоваровКомпанииОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КартинкиИФайлы.Объект КАК Объект,
			КартинкиИФайлы.Идентификатор КАК Идентификатор,
			КартинкиИФайлы.ИмяФайла КАК ИмяФайла,
			КартинкиИФайлы.ДатаСохранения КАК ДатаСохранения,
			КартинкиИФайлы.РазмерФайла КАК РазмерФайла,
			КартинкиИФайлы.Комментарий КАК Комментарий,
			КартинкиИФайлы.Данные КАК Данные,
			КартинкиИФайлы.ДанныеВоВнешнемФайле КАК ДанныеВоВнешнемФайле,
			КартинкиИФайлы.Картинка КАК Картинка,
			КартинкиИФайлы.НазваниеФайла КАК НазваниеФайла,
			КартинкиИФайлы.ОтносительныйПуть КАК ОтносительныйПуть,
			КартинкиИФайлы.Расширение КАК Расширение,
			КартинкиИФайлы.Основной КАК Основной,
			КартинкиИФайлы.ВидыДокументовАвто КАК ВидыДокументовАвто
		ИЗ
			РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы) КАК КартинкиИфайлы
		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = КартинкиИфайлы.Объект
ГДЕ
	ОстаткиТоваровКомпанииОстатки.Номенклатура.ЯчейкиХранения.СкладКомпании = &amp;СкладКомпании</query>
