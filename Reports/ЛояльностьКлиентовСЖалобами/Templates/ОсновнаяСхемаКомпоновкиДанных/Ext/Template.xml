					<v8:lang>ru</v8:lang>
					<v8:content>Дата жалобы</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДЛФ=D</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОбращения</dataPath>
			<field>ДатаОбращения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата обращения</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДЛФ=D</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерЗН</dataPath>
			<field>НомерЗН</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер ЗН</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВсегоЖалоб</dataPath>
			<field>ВсегоЖалоб</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Всего жалоб</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВсегоОбращений</dataPath>
			<field>ВсегоОбращений</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Всего обращений</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЖалобаКлиента.Контрагент КАК Клиент,
	1 КАК ВсегоЖалоб,
	ЖалобаКлиента.Дата КАК ДатаЖалобы
ПОМЕСТИТЬ Жалобы
ИЗ
	Документ.ЖалобаКлиента КАК ЖалобаКлиента
ГДЕ
	ЖалобаКлиента.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказНаряд.Контрагент КАК Клиент,
	1 КАК ВсегоОбращений,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.ДатаНачала КАК ДатаОбращения,
	ЗаказНаряд.Номер
ПОМЕСТИТЬ ЗН
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.Дата &gt; &amp;ДатаНачала
	И ЗаказНаряд.Состояние &lt;&gt; ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Заявка)

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.Контрагент,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.ДатаНачала,
	ЗаказНаряд.Номер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Жалобы.Клиент КАК Клиент,
	Жалобы.ДатаЖалобы,
	ЗН.Номер КАК НомерЗН,
	ЗН.ВидРемонта,
	ЗН.ДатаОбращения,
	Жалобы.ВсегоЖалоб,
	ЗН.ВсегоОбращений
ИЗ
	Жалобы КАК Жалобы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗН КАК ЗН
		ПО Жалобы.Клиент = ЗН.Клиент
			И Жалобы.ДатаЖалобы &lt; ЗН.ДатаОбращения

УПОРЯДОЧИТЬ ПО
	Клиент</query>
	</dataSet>
	<totalField>
		<dataPath>ВсегоОбращений</dataPath>
		<expression>Сумма(ВсегоОбращений)</expression>
	</totalField>
