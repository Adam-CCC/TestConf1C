    Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ПродажиОбороты.Номенклатура КАК Номенклатура,
    ПродажиОбороты.ХарактеристикаНоменклатуры,
    ВЫБОР
        КОГДА ПродажиОбороты.СкладКомпании ССЫЛКА Справочник.СкладыКомпании
            ТОГДА ПродажиОбороты.СкладКомпании
        ИНАЧЕ ВЫРАЗИТЬ(ПродажиОбороты.СкладКомпании КАК Справочник.Цеха).СкладКомпании
    КОНЕЦ КАК СкладКомпании,
    ПродажиОбороты.КоличествоОборот КАК Количество
ПОМЕСТИТЬ ВТ_Продажи
ИЗ
    РегистрНакопления.Продажи.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , ) КАК ПродажиОбороты

ИНДЕКСИРОВАТЬ ПО
    Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ЕСТЬNULL(ВТ_Остатки.СкладКомпании, ВТ_Продажи.СкладКомпании) КАК СкладКомпании,
    ЕСТЬNULL(ВТ_Остатки.Номенклатура, ВТ_Продажи.Номенклатура) КАК Номенклатура,
    ЕСТЬNULL(ВТ_Остатки.ХарактеристикаНоменклатуры, ВТ_Продажи.ХарактеристикаНоменклатуры) КАК ХарактеристикаНоменклатуры,
    ЕСТЬNULL(ВТ_Продажи.Количество, 0) КАК Продажи,
    ЕСТЬNULL(ВТ_Остатки.Остаток, 0) КАК Остаток
ПОМЕСТИТЬ ВТ_Маппинг
ИЗ
    ВТ_Остатки КАК ВТ_Остатки
        ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Продажи КАК ВТ_Продажи
        ПО ВТ_Остатки.СкладКомпании = ВТ_Продажи.СкладКомпании
            И ВТ_Остатки.Номенклатура = ВТ_Продажи.Номенклатура
            И ВТ_Остатки.ХарактеристикаНоменклатуры = ВТ_Продажи.ХарактеристикаНоменклатуры
;

