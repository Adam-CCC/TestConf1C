		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(ЗаявкаНаРемонт.ДатаНачала, ДЕНЬ) КАК ДатаНачала,
	ЗаявкаНаРемонт.ДатаНачала КАК ВремяНачала,
	ЗаявкаНаРемонт.Автомобиль КАК Автомобиль,
	Автомобили.Цвет КАК Цвет,
	Автомобили.ГодВыпуска КАК ГодВыпуска,
	ЗаявкаНаРемонт.Заказчик КАК Заказчик,
	ЗаявкаНаРемонт.Менеджер КАК Менеджер,
	ЕСТЬNULL(ЗаказНаряд.Пробег, АвтомобилиСрезПоследних.Значение) КАК Пробег,
	ЗаявкаНаРемонт.ПредставлениеТелефона КАК Телефона,
	ЗаявкаНаРемонт.Цех,
	ЗаявкаНаРемонт.Цех.Подразделение,
	ЗаявкаНаРемонт.ПодразделениеКомпании
ИЗ
	Документ.ЗаявкаНаРемонт КАК ЗаявкаНаРемонт
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряд
		ПО ЗаявкаНаРемонт.Ссылка = ЗаказНаряд.ДокументОснование
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&amp;ДатаОкончания, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Пробег)) КАК АвтомобилиСрезПоследних
		ПО ЗаявкаНаРемонт.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Автомобили КАК Автомобили
		ПО ЗаявкаНаРемонт.Автомобиль = Автомобили.Ссылка
ГДЕ
	ЗаявкаНаРемонт.ДатаНачала МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И ЗаявкаНаРемонт.Проведен</query>
