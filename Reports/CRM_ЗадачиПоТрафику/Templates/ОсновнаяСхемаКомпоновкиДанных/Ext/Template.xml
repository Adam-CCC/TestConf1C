			<dataPath>ФИО</dataPath>
			<field>ФИО</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	CRM_ЗадачиПоТрафику.Период КАК ДатаСоздания,
	CRM_ЗадачиПоТрафику.Автор,
	CRM_ЗадачиПоТрафику.Менеджер,
	CRM_ЗадачиПоТрафику.Телефон,
	CRM_ЗадачиПоТрафику.Представление КАК ФИО,
	CRM_ЗадачиПоТрафику.Комментарий,
	CRM_ЗадачиПоТрафику.Обработано,
	CRM_ЗадачиПоТрафику.ДатаВремяЗавершения КАК ДатаЗавершения,
	ВЫБОР
		КОГДА CRM_ЗадачиПоТрафику.Обработано
				И ГОД(CRM_ЗадачиПоТрафику.ДатаВремяЗавершения) &gt; 1
			ТОГДА РАЗНОСТЬДАТ(CRM_ЗадачиПоТрафику.Период, CRM_ЗадачиПоТрафику.ДатаВремяЗавершения, ЧАС)
		ИНАЧЕ 0
	КОНЕЦ КАК ВремяВыполненияЧасов,
	CRM_ЗадачиПоТрафику.КомментарийПриЗакрытии,
	Renault_Трафик.ТипТрафика,
	Renault_Трафик.Отдел,
	Renault_Трафик.ПервичныйПовторный
ИЗ
	РегистрСведений.CRM_ЗадачиПоТрафику КАК CRM_ЗадачиПоТрафику
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Трафик КАК Renault_Трафик
		ПО CRM_ЗадачиПоТрафику.ИдентификаторТрафика = Renault_Трафик.Идентификатор
ГДЕ
	ВЫБОР
			КОГДА ГОД(&amp;Начало) &gt; 1
				ТОГДА CRM_ЗадачиПоТрафику.Период &gt;= &amp;Начало
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА ГОД(&amp;Конец) &gt; 1
				ТОГДА CRM_ЗадачиПоТрафику.Период &lt;= &amp;Конец
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
