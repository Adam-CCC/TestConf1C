		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона КАК СхемаОбзвона,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусСМС = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыСМС.ОтправленоНаГейт)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ОтправленоНаГейт,
	СУММА(1) КАК КоличествоКлиентов,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусСМС = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыСМС.Отправлено)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Отправлено,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусСМС = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыСМС.Доставлено)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Доставлено,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусСМС = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыСМС.НеДоставлено)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК НеДоставлено,
	Renault_CommunicationCenter_Обзвон.Клиент КАК Клиент,
	ЕСТЬNULL(КонтактнаяИнформация.Представление, "") КАК Телефон
ИЗ
	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		ПО Renault_CommunicationCenter_Обзвон.Клиент = КонтактнаяИнформация.Объект
			И (КонтактнаяИнформация.Тип = &amp;ТипСМС)
			И (КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА)
ГДЕ
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона = &amp;СхемаОбзвона

СГРУППИРОВАТЬ ПО
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона,
	Renault_CommunicationCenter_Обзвон.Клиент,
	ЕСТЬNULL(КонтактнаяИнформация.Представление, "")

УПОРЯДОЧИТЬ ПО
	СхемаОбзвона,
	Клиент</query>
