		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	РеализацияАвтомобилейАвтомобили.Автомобиль КАК Автомобиль
ПОМЕСТИТЬ РА
ИЗ
	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(
				&amp;ДатаОкончания,
				ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля)
					И Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.Новый)) КАК АвтомобилиСрезПоследних
		ПО РеализацияАвтомобилейАвтомобили.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
ГДЕ
	НЕ РеализацияАвтомобилейАвтомобили.Ссылка.ПродажаБУАвто
	И НЕ РеализацияАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма

СГРУППИРОВАТЬ ПО
	РеализацияАвтомобилейАвтомобили.Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказНаряд.Ссылка,
	ЗаказНаряд.Автомобиль,
	1 КАК Заезд,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 0
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТОНоль,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 1
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТООдин,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 2
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТОДва,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 3
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТОТри,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 4
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТОЧетыре,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 5
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТОПять,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 6
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТОШесть,
	ВЫБОР
		КОГДА ЗаказНаряд.НомерТО = 7
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ТОСемь,
	ЗаказНаряд.ПодразделениеКомпании КАК Подразделение
ПОМЕСТИТЬ ЗН
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказНаряд.ВидРемонта.ТехОбслуживание
	И ЗаказНаряд.ПодразделениеКомпании В ИЕРАРХИИ(&amp;ПодразделениеКомпании)
	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗН.Ссылка,
	ЗН.Автомобиль,
	ЗН.Заезд,
	ЗН.ТОНоль,
	ЗН.ТООдин,
	ЗН.ТОДва,
	ЗН.ТОТри,
	ЗН.ТОЧетыре,
	ЗН.ТОПять,
	ЗН.ТОШесть,
	ЗН.ТОСемь
ПОМЕСТИТЬ ЗНСвои
ИЗ
	ЗН КАК ЗН
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РА КАК РА
		ПО ЗН.Автомобиль = РА.Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗН.Автомобиль,
	ЗН.Ссылка КАК ЗаказНаряд,
	ЗН.ТОНоль КАК ТОНоль,
	ЗН.ТООдин КАК ТООдин,
	ЗН.ТОДва КАК ТОДва,
	ЗН.ТОТри КАК ТОТри,
	ЗН.ТОЧетыре КАК ТОЧетыре,
	ЗН.ТОПять КАК ТОПять,
	ЗН.ТОШесть КАК ТОШесть,
	ЗН.ТОСемь КАК ТОСемь,
	ЗН.Заезд КАК ВсегоЗаездов,
	ВЫБОР
		КОГДА ЗНСвои.Ссылка ССЫЛКА Документ.ЗаказНаряд
			ТОГДА "Свой"
		ИНАЧЕ "Чужой"
	КОНЕЦ КАК ТипКлиента,
	ЗН.Подразделение
ИЗ
	ЗН КАК ЗН
		ЛЕВОЕ СОЕДИНЕНИЕ ЗНСвои КАК ЗНСвои
		ПО ЗН.Ссылка = ЗНСвои.Ссылка</query>
