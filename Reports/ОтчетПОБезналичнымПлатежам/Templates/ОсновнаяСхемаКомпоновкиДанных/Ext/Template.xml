		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВыпискаСостав.Ссылка.Организация,
	ВыпискаСостав.Контрагент,
	ВыпискаСостав.Ссылка.Дата,
	ВыпискаСостав.СтатьяДДС,
	ВыпискаСостав.Сделка,
	ВыпискаСостав.Ссылка.БанковскийСчет,
	ВыпискаСостав.НазначениеПлатежа,
	ВыпискаСостав.СуммаРасход КАК СуммаРасхода,
	ВыпискаСостав.СтавкаНДС,
	ВыпискаСостав.СуммаНДС,
	"" КАК ФИОЗаказчика,
	"" КАК ПодписантСчета,
	"" КАК АдресДоставкиГруза,
	"" КАК ОтвественноеЛицоПоМесту,
	ВыпискаСостав.ДилерскийЦентр,
	ВыпискаСостав.ПлатежноеПоручениеОснование КАК ДанныеОПлатеже,
	ВыпискаСостав.СуммаПриход КАК СуммаПрихода,
	ВыпискаСостав.ДоговорВзаиморасчетов
ИЗ
	Документ.Выписка.Состав КАК ВыпискаСостав
ГДЕ
	ВыпискаСостав.Ссылка.Проведен
	И ВыпискаСостав.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
