Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Настройки =  КомпоновщикНастроек.ПолучитьНастройки();
	
	Параметры = Настройки.ПараметрыДанных.Элементы;
	
	ПараметрДатаНачала 	   = Параметры.Найти("ДатаНачала");
	ПараметрДатаОкончания  = Параметры.Найти("ДатаКонец");
	
	ПараметрДатаНачала.Значение     = Период;
	ПараметрДатаНачала.Использование = Истина;
	
	ПараметрДатаОкончания.Значение  = ДатаОкончанияПериода();
	ПараметрДатаОкончания.Использование = Истина;

	КомпоновщикМакет = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Макет = КомпоновщикМакет.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет, , ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ДокументРезультат.ФиксацияСлева = 1;
	ДокументРезультат.ПоказатьУровеньГруппировокСтрок(3);
КонецПроцедуры

Функция ДатаОкончанияПериода()
	ДатаВозврат = '0001-01-01';
	
	Если ВидПериода = Перечисления.Renault_ТипыПериода.Неделя Тогда
		ДатаВозврат = КонецНедели(Период);
	ИначеЕсли ВидПериода = Перечисления.Renault_ТипыПериода.Месяц Тогда
		ДатаВозврат = КонецМесяца(Период);
	ИначеЕсли ВидПериода = Перечисления.Renault_ТипыПериода.Квартал Тогда
		ДатаВозврат = КонецКвартала(Период);
	ИначеЕсли ВидПериода = Перечисления.Renault_ТипыПериода.Год Тогда
		ДатаВозврат = КонецГода(Период);
	КонецЕсли;
	
	Возврат ДатаВозврат;
КонецФункции
