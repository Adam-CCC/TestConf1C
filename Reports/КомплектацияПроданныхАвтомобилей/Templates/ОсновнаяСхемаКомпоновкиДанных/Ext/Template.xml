		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПродажиАвтомобилей.Автомобиль
ПОМЕСТИТЬ ПроданныеАвтомобили
ИЗ
	РегистрНакопления.ПродажиАвтомобилей КАК ПродажиАвтомобилей
ГДЕ
	ПродажиАвтомобилей.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ПродажиАвтомобилей.Регистратор ССЫЛКА Документ.РеализацияАвтомобилей
	И НЕ ПродажиАвтомобилей.Регистратор.ПродажаБУАвто
	И НЕ ПродажиАвтомобилей.Покупатель.НашаФирма
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	КомплектацияАвтомобилей.Автомобиль,
	КомплектацияАвтомобилей.Регистратор
ПОМЕСТИТЬ КомплектацииПроданныхАвтомобилей
ИЗ
	РегистрНакопления.КомплектацияАвтомобилей КАК КомплектацияАвтомобилей
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПроданныеАвтомобили КАК ПроданныеАвтомобили
		ПО КомплектацияАвтомобилей.Автомобиль = ПроданныеАвтомобили.Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
