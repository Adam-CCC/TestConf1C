			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	КонтактнаяИнформация.Представление,
	КонтактнаяИнформация.Объект,
	КонтактнаяИнформация.Тип
ПОМЕСТИТЬ Телефоны
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	И КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КонтактнаяИнформация.Представление,
	КонтактнаяИнформация.Объект,
	КонтактнаяИнформация.Тип
ПОМЕСТИТЬ Емаилы
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	И КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Renault_CRM_ЗаявкаНаТрейдИн.Статус,
	Renault_CRM_ЗаявкаНаТрейдИн.РабочийЛист,
	Renault_CRM_ЗаявкаНаТрейдИн.Клиент КАК Клиент,
	Renault_CRM_ЗаявкаНаТрейдИн.Дата,
	Renault_CRM_ЗаявкаНаТрейдИн.Модель,
	Renault_CRM_ЗаявкаНаТрейдИн.ДилерскийЦентр,
	Renault_CRM_ЗаявкаНаТрейдИн.СрокДействия,
	Renault_CRM_ЗаявкаНаТрейдИн.Ссылка
ПОМЕСТИТЬ ДанныеПоДоговору
ИЗ
	Документ.Renault_CRM_ЗаявкаНаТрейдИн КАК Renault_CRM_ЗаявкаНаТрейдИн
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Емаилы.Представление КАК Email,
	Телефоны.Представление КАК Телефон,
	ДанныеПоДоговору.Статус,
	ДанныеПоДоговору.РабочийЛист,
	ДанныеПоДоговору.Клиент,
	ДанныеПоДоговору.Дата,
	ДанныеПоДоговору.Модель,
	ДанныеПоДоговору.ДилерскийЦентр,
	ДанныеПоДоговору.СрокДействия,
	ДанныеПоДоговору.Ссылка
ИЗ
	ДанныеПоДоговору КАК ДанныеПоДоговору
		ЛЕВОЕ СОЕДИНЕНИЕ Телефоны КАК Телефоны
		ПО ДанныеПоДоговору.Клиент = Телефоны.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ Емаилы КАК Емаилы
		ПО ДанныеПоДоговору.Клиент = Емаилы.Объект
ГДЕ
	ВЫБОР
			КОГДА ГОД(&amp;ДатаНачала) &gt; 1
				ТОГДА ДанныеПоДоговору.Дата &gt;= &amp;ДатаНачала
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА ГОД(&amp;ДатаОкончания) &gt; 1
				ТОГДА ДанныеПоДоговору.Дата &lt;= &amp;ДатаОкончания
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
	</dataSet>
