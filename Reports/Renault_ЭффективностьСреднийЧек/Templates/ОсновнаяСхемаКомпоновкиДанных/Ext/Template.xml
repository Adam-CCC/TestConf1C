		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказНаряд.Ссылка КАК ЗаказНаряд1,
	ЗаказНаряд.Дата КАК Дата1,
	ЗаказНаряд.ДатаЗакрытия КАК ДатаЗакрытия,
	ЗаказНарядРаботы.СуммаВсегоРабот КАК СуммаВсегоРабот1,
	ЗаказНарядРаботы.НормаВремениВсегоРабот КАК НормаВремениВсегоРабот1,
	ВЫБОР
		КОГДА СУММА(ЗаказНарядРаботы.СуммаВсегоРабот) &gt;= 499
				И СУММА(ЗаказНарядРаботы.НормаВремениВсегоРабот) &gt;= 0.2
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Учитывать,
	ВЫБОР
		КОГДА СУММА(ЗаказНарядРаботы.СуммаВсегоРабот) &gt;= 499
				И СУММА(ЗаказНарядРаботы.НормаВремениВсегоРабот) &gt;= 0.2
			ТОГДА ЗаказНарядРаботы.Ссылка
		ИНАЧЕ "---Этот заказ-наряд не учитывается---"
	КОНЕЦ КАК ЗНРаботы1,
	ЗаказНаряд.Автомобиль.Модель.Производитель КАК АвтомобильМодельПроизводитель,
	Renault_СоответствияВидовРемонта.КлассификацияRenault КАК КлассификацияRenault
ИЗ
	(ВЫБРАТЬ
		СУММА(ЗаказНарядРаботы.СуммаВсего) КАК СуммаВсегоРабот,
		ЗаказНарядРаботы.Ссылка КАК Ссылка,
		СУММА(ЗаказНарядРаботы.Коэффициент) КАК НормаВремениВсегоРабот
	ИЗ
		Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
	
	СГРУППИРОВАТЬ ПО
		ЗаказНарядРаботы.Ссылка) КАК ЗаказНарядРаботы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряд
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_СоответствияВидовРемонта КАК Renault_СоответствияВидовРемонта
			ПО ЗаказНаряд.ВидРемонта = Renault_СоответствияВидовРемонта.ВидРемонта
		ПО ЗаказНарядРаботы.Ссылка = ЗаказНаряд.Ссылка
ГДЕ
	ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	И ЗаказНаряд.ПометкаУдаления = ЛОЖЬ

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.Ссылка,
	ЗаказНаряд.Дата,
	ЗаказНаряд.ДатаЗакрытия,
	ЗаказНарядРаботы.СуммаВсегоРабот,
	ЗаказНарядРаботы.НормаВремениВсегоРабот,
	ЗаказНарядРаботы.Ссылка,
	ЗаказНаряд.Автомобиль.Модель.Производитель,
	Renault_СоответствияВидовРемонта.КлассификацияRenault</query>
	</dataSet>
