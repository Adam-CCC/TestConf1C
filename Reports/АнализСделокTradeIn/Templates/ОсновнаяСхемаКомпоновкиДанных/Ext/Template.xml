		<field xsi:type="DataSetFieldField">
			<dataPath>РабочийЛист</dataPath>
			<field>РабочийЛист</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РабочийЛист.Менеджер,
	РабочийЛист.Контрагент,
	РабочийЛист.ПредставлениеТелефона,
	РабочийЛист.МодельТрейдИн,
	РабочийЛист.ГодВыпускаТрейдИн,
	РабочийЛист.ПробегТрейдИн,
	РабочийЛист.ОфертаТрейдИн,
	РабочийЛист.КомментарийTradeIn,
	МАКСИМУМ(ВЫБОР
			КОГДА Событие.ЕстьПриемПоТрэйдИн
					И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ) КАК Сделка,
	РабочийЛист.Организация,
	РабочийЛист.ПодразделениеКомпании,
	РабочийЛист.Ссылка КАК РабочийЛист,
	РабочийЛист.ДефектыТрейдИн КАК ДефектыАвтомобиля
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
		ПО РабочийЛист.Ссылка = Событие.ДокументОснование
ГДЕ
	РабочийЛист.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И НЕ РабочийЛист.ПометкаУдаления
	И РабочийЛист.ТрейдИн = ИСТИНА
	И Событие.Состояние &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Отменено)

СГРУППИРОВАТЬ ПО
	РабочийЛист.Менеджер,
	РабочийЛист.Контрагент,
	РабочийЛист.ПредставлениеТелефона,
	РабочийЛист.МодельТрейдИн,
	РабочийЛист.ГодВыпускаТрейдИн,
	РабочийЛист.ПробегТрейдИн,
	РабочийЛист.ОфертаТрейдИн,
	РабочийЛист.КомментарийTradeIn,
	РабочийЛист.Организация,
	РабочийЛист.ПодразделениеКомпании,
	РабочийЛист.Ссылка,
	РабочийЛист.ДефектыТрейдИн</query>
	</dataSet>
