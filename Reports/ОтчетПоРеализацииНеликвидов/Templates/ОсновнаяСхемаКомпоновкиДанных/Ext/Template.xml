		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Продажи.Регистратор,
	Продажи.СкладКомпании,
	Продажи.Количество,
	Продажи.Сумма,
	Продажи.Себестоимость / Продажи.Количество КАК Себестоимость,
	Продажи.Себестоимость КАК СуммаСебестоимость,
	Продажи.Номенклатура,
	Продажи.Номенклатура.Артикул,
	ВЫБОР
		КОГДА Продажи.Количество &lt;&gt; 0
			ТОГДА Продажи.Сумма / Продажи.Количество
		ИНАЧЕ 0
	КОНЕЦ КАК ЦенаПродажи,
	ВЫБОР
		КОГДА Продажи.Количество &lt;&gt; 0
			ТОГДА Продажи.Сумма / Продажи.Количество
		ИНАЧЕ 0
	КОНЕЦ - Продажи.Себестоимость КАК Наценка,
	Продажи.Сумма - Продажи.Себестоимость КАК Прибыль,
	ВЫБОР
		КОГДА Продажи.Регистратор ССЫЛКА Документ.ЗаказНаряд
			ТОГДА Продажи.Регистратор.Диспетчер
		ИНАЧЕ Продажи.Регистратор.Менеджер
	КОНЕЦ КАК Менеджер,
	Продажи.Покупатель,
	Продажи.Покупатель.Родитель
ИЗ
	РегистрНакопления.Продажи КАК Продажи
ГДЕ
	Продажи.Номенклатура В(&amp;СписокНоменклатуры)
	И Продажи.ПодразделениеКомпании В ИЕРАРХИИ(&amp;СписокСкладов)
	И ТИПЗНАЧЕНИЯ(Продажи.Регистратор) &lt;&gt; ТИП(Документ.СписаниеТоваров)
	И ТИПЗНАЧЕНИЯ(Продажи.Регистратор) &lt;&gt; ТИП(Документ.КомплектацияАвтомобиля)
	И НЕ Продажи.Покупатель В ИЕРАРХИИ (&amp;СписокНашиФирмы)
{ГДЕ
	(Продажи.Период &gt;= &amp;ДатаНачала),
	(Продажи.Период &lt;= &amp;ДатаОкончания)}</query>
