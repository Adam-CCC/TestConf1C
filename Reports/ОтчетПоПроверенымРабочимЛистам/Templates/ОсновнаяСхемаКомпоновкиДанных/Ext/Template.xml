		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РабочийЛистСервиса.Ссылка КАК РабочийЛист,
	РабочийЛистСервиса.Подтвержден КАК Подтвержден,
	РабочийЛистСервиса.Менеджер КАК Менеджер,
	Событие.Ссылка КАК Событие,
	Событие.Результат КАК Результат,
	РабочийЛистСервиса.Ссылка КАК КоличествоРабочихЛистов,
	Событие.Ссылка КАК КоличествоСобытий,
	РабочийЛистСервиса.МодельТрейдИн КАК ПредыдущийАвтомобиль,
	РабочийЛистСервиса.ВариантКомплектации КАК ВариантКомплектации,
	РабочийЛистСервиса.Модель КАК Модель,
	РабочийЛистСервиса.Реклама КАК Реклама
{ВЫБРАТЬ
	РабочийЛист.*,
	Подтвержден,
	Менеджер.*,
	Событие,
	Результат,
	КоличествоСобытий,
	КоличествоРабочихЛистов,
	Модель,
	ВариантКомплектации,
	Реклама,
	ПредыдущийАвтомобиль.*}
ИЗ
	Документ.РабочийЛист КАК РабочийЛистСервиса
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
		ПО РабочийЛистСервиса.Ссылка = Событие.ДокументОснование
			И (НЕ Событие.ПометкаУдаления)
ГДЕ
	РабочийЛистСервиса.ПометкаУдаления = ЛОЖЬ
{ГДЕ
	РабочийЛистСервиса.Ссылка.*,
	РабочийЛистСервиса.Подтвержден,
	РабочийЛистСервиса.Менеджер.*,
	Событие.Ссылка.*,
	РабочийЛистСервиса.Дата КАК ДатаРабочегоЛиста,
	Событие.Результат КАК РезультатСобытия,
	РабочийЛистСервиса.Контрагент.* КАК Клиент,
	РабочийЛистСервиса.Автомобиль.*,
	(РабочийЛистСервиса.Дата &gt;= &amp;ДатаНачалаРабочегоЛиста),
	(РабочийЛистСервиса.Дата &lt;= &amp;ДатаОкончанияРабочегоЛиста)}</query>
		<autoFillFields>false</autoFillFields>
