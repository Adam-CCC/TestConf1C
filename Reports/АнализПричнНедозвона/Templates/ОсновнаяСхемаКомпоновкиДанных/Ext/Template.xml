		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА Опрос._г_НеДозвон
			ТОГДА "Не дозвонились"
		КОГДА Опрос.Отказ
			ТОГДА "Отказ от интервью"
		ИНАЧЕ "Результативные интервью"
	КОНЕЦ КАК Результат,
	ВЫБОР
		КОГДА Опрос._г_НеДозвон
			ТОГДА Опрос.ПричинаНедозвона
	КОНЕЦ КАК ПричинаНедозвона,
	Опрос.ОпрашиваемоеЛицо КАК ОпрашиваемоеЛицо,
	1 КАК Количество,
	Опрос.Комментарий,
	Опрос.ПодразделениеКомпании КАК Подразделение,
	Опрос.ТиповаяАнкета,
	Опрос.Автор
ИЗ
	Документ.Опрос КАК Опрос
ГДЕ
	Опрос.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Опрос.Принадлежность = &amp;Принадлежность
	И Опрос.СпособКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)

УПОРЯДОЧИТЬ ПО
	ОпрашиваемоеЛицо</query>
