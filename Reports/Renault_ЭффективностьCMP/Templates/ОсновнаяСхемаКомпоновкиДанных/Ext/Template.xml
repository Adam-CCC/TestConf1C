	</totalField>
	<totalField>
		<dataPath>Парк1</dataPath>
		<expression>Сумма(Парк1)</expression>
	</totalField>
	<totalField>
		<dataPath>НормаВремениВсегоРабот</dataPath>
		<expression>(НормаВремениВсегоРабот)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаВсегоРабот</dataPath>
		<expression>(СуммаВсегоРабот)</expression>
	</totalField>
	<totalField>
		<dataPath>CMP</dataPath>
		<expression>ВЫРАЗИТЬ(Сумма(СуммаPNCСкладская)/&amp;Парк, "Число(15,2)")</expression>
	</totalField>
