		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Продажи.ДокументПродажи,
	СУММА(Продажи.Себестоимость) КАК Себестоимость
ПОМЕСТИТЬ СебестоимостьЗапчастей
ИЗ
	РегистрНакопления.Продажи КАК Продажи
ГДЕ
	Продажи.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Продажи.ДокументПродажи ССЫЛКА Документ.ЗаказНаряд

СГРУППИРОВАТЬ ПО
	Продажи.ДокументПродажи
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	1 КАК КоличествоЗаказНарядов,
	ЗаказНаряд.ВремяВыполненияРабот,
	ЗаказНаряд.СуммаРаботДокумента КАК СуммаРабот,
	ЗаказНаряд.СуммаНоменклатурыДокумента КАК СуммаЗапчастей,
	ЗаказНаряд.СуммаДокумента КАК Всего,
	СебестоимостьЗапчастей.Себестоимость КАК СебестоимостьЗапчастей,
	ВЫБОР
		КОГДА ЗаказНаряд.Автомобиль.Модель В ИЕРАРХИИ (&amp;МаркаПрофильная)
			ТОГДА "1 профильные автомобили"
		ИНАЧЕ "2 не профильные автомобили"
	КОНЕЦ КАК Профильный,
	ВЫБОР
		КОГДА ЗаказНаряд.ДатаЗакрытия &lt; ДОБАВИТЬКДАТЕ(ЗаказНаряд.Автомобиль.ДатаНачалаГарантии, ГОД, 3)
			ТОГДА "1 гарантийные автомобили"
		ИНАЧЕ "2 автомобили с истекшим гарантийным сроком"
	КОНЕЦ КАК Гарантийный,
	ВЫБОР
		КОГДА ЗаказНаряд.Владелец.ФормаСобственности &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)
			ТОГДА "1 юридические лица"
		ИНАЧЕ "2 физические лица"
	КОНЕЦ КАК ТипСобственника,
	ЗаказНаряд.ПодразделениеКомпании КАК Подразделение,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
	ЗаказНаряд.СуммаДокумента - СебестоимостьЗапчастей.Себестоимость КАК ВаловаяПрибыль,
	ЗаказНаряд.СуммаДокумента КАК СреднийЧек
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СебестоимостьЗапчастей КАК СебестоимостьЗапчастей
		ПО ЗаказНаряд.Ссылка = СебестоимостьЗапчастей.ДокументПродажи</query>
	</dataSet>
