		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_КаталогРеферансов.Номенклатура,
	Renault_КаталогРеферансов.Артикул,
	Renault_КаталогРеферансов.Сегмент,
	Renault_КаталогРеферансов.ТехСемья,
	Renault_КаталогРеферансов.ЗапретЗакупки
ПОМЕСТИТЬ ВТ_Реферансов
ИЗ
	РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(Renault_ТарифЦенИсторияСрезПоследних.Цена, 0) КАК ЦенаСтарая,
	ВложенныйЗапрос.Цена КАК ЦенаНовая,
	ВТ_Реферансов.Номенклатура,
	ВТ_Реферансов.Сегмент,
	ВТ_Реферансов.ТехСемья,
	ВложенныйЗапрос.ТипЦены,
	ВТ_Реферансов.ЗапретЗакупки
ИЗ
	(ВЫБРАТЬ
		Renault_ТарифЦен.ТипЦены КАК ТипЦены,
		Renault_ТарифЦен.Артикул КАК Артикул,
		Renault_ТарифЦен.Цена КАК Цена
	ИЗ
		РегистрСведений.Renault_ТарифЦен КАК Renault_ТарифЦен
	ГДЕ
		Renault_ТарифЦен.Артикул В
				(ВЫБРАТЬ РАЗЛИЧНЫЕ
					ВТ_Реферансов.Артикул
				ИЗ
					ВТ_Реферансов КАК ВТ_Реферансов)) КАК ВложенныйЗапрос
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ТарифЦенИстория.СрезПоследних(
				&amp;КонецПриода,
				Артикул В
					(ВЫБРАТЬ РАЗЛИЧНЫЕ
						ВТ_Реферансов.Артикул
					ИЗ
						ВТ_Реферансов КАК ВТ_Реферансов)) КАК Renault_ТарифЦенИсторияСрезПоследних
		ПО (Renault_ТарифЦенИсторияСрезПоследних.ТипЦены = ВложенныйЗапрос.ТипЦены)
			И (Renault_ТарифЦенИсторияСрезПоследних.Артикул = ВложенныйЗапрос.Артикул)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Реферансов КАК ВТ_Реферансов
		ПО ВложенныйЗапрос.Артикул = ВТ_Реферансов.Артикул</query>
