
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОТЧЕТА

// Процедура - обработчик события отчета "ПриКомпоновкеРезультата"
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	СтандартнаяОбработка	= Ложь;
	ДокументРезультат.Очистить();
	// Получаем длину внутренних номеров
	ДлинаВнутреннихНомеров	= Константы.CRM_МаксимальнаяДлинаВнутреннегоНомера.Получить();
	// Получаем таблицу соответствия номеров абонентам
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",		ЭтотОбъект.ПериодОтчета.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.ПериодОтчета.ДатаОкончания);
	ТаблицаСоответствия = Новый ТаблицаЗначений;
	ТаблицаСоответствия.Колонки.Добавить("Номер");
	ТаблицаСоответствия.Колонки.Добавить("Абонент");
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВложенныйЗапрос.НомерТелефона
	               |ИЗ
	               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		dbo_Calls.CallerId КАК НомерТелефона
	               |	ИЗ
	               |		ВнешнийИсточникДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.Таблица.dbo_Calls КАК dbo_Calls
	               |	ГДЕ
	               |		dbo_Calls.StartTime МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |		И НЕ dbo_Calls.DropTime ЕСТЬ NULL 
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |		dbo_Calls.CalledId
	               |	ИЗ
	               |		ВнешнийИсточникДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.Таблица.dbo_Calls КАК dbo_Calls
	               |	ГДЕ
	               |		dbo_Calls.StartTime МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |		И НЕ dbo_Calls.DropTime ЕСТЬ NULL ) КАК ВложенныйЗапрос";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОчищенныйНомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(Выборка.НомерТелефона);
		Если НЕ ПустаяСтрока(ОчищенныйНомерТелефона) Тогда
			МассивАбонентов = сфпСофтФонПроСервер.сфпНайтиОбъектВРегистреПоТелефону(ОчищенныйНомерТелефона);
			НоваяСтрока = ТаблицаСоответствия.Добавить();
			НоваяСтрока.Номер	= Выборка.НомерТелефона;
			Если МассивАбонентов.Количество() = 0 Тогда
				НоваяСтрока.Абонент	= Неопределено;
			ИначеЕсли ЗначениеЗаполнено(МассивАбонентов[0]) Тогда	
				Если СтрДлина(ОчищенныйНомерТелефона) > ДлинаВнутреннихНомеров Тогда
					НоваяСтрока.Абонент	= МассивАбонентов[0];
				ИначеЕсли ТипЗнч(МассивАбонентов[0]) = Тип("СправочникСсылка.Пользователи") Тогда
					НоваяСтрока.Абонент	= МассивАбонентов[0];
				Иначе
					НоваяСтрока.Абонент	= Неопределено;
				КонецЕсли;	
			Иначе
				НоваяСтрока.Абонент	= Неопределено;
		    КонецЕсли;
	    КонецЕсли;
	КонецЦикла;
	// Получаем таблицу истории звонков
	Запрос.Текст = "ВЫБРАТЬ
	               |	dbo_Calls.CallID,
	               |	dbo_Calls.StartTime,
	               |	dbo_Calls.AnswerTime,
	               |	dbo_Calls.DropTime,
	               |	dbo_Calls.LineName,
	               |	dbo_Calls.CallerId,
	               |	dbo_Calls.CalledId,
	               |	dbo_Calls.Origin
	               |ИЗ
	               |	ВнешнийИсточникДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.Таблица.dbo_Calls КАК dbo_Calls
	               |ГДЕ
	               |	dbo_Calls.StartTime МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	StartTime";
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	// Формируем структуру всех таблиц
	ТаблицаЕженедельныйОтчет = Новый ТаблицаЗначений;
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ДатаЗвонкаДень",					Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ВсегоЗвонковДень",				Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ВсегоОрганизацийДень",			Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ВсегоНеИзБазыДень",				Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ЗвонковБольше60ВДень",			Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ПервыйЗвонокДень",				Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ПоследнийЗвонокДень",			Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ПродолжительностьРабочегоДня",	Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ЗвонковБольше45ВЧас",			Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("ВремяПереговоровДень",			Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЕженедельныйОтчет.Колонки.Добавить("Сотрудник",						Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	
	ТаблицаОтчетПоСовершеннымЗвонкам = Новый ТаблицаЗначений;
	ТаблицаОтчетПоСовершеннымЗвонкам.Колонки.Добавить("ДатаЗвонка",			Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаОтчетПоСовершеннымЗвонкам.Колонки.Добавить("ДлительностьЗвонка",	Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаОтчетПоСовершеннымЗвонкам.Колонки.Добавить("НомерТелефона",		Новый ОписаниеТипов("Строка"));
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Организации"));
	МассивТипов.Добавить(Тип("СправочникСсылка.Контрагенты"));
	МассивТипов.Добавить(Тип("СправочникСсылка.ПодразделенияКомпании"));
	ТаблицаОтчетПоСовершеннымЗвонкам.Колонки.Добавить("Организация",		Новый ОписаниеТипов(МассивТипов));
	ТаблицаОтчетПоСовершеннымЗвонкам.Колонки.Добавить("КонтактноеЛицо",		Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаОтчетПоСовершеннымЗвонкам.Колонки.Добавить("СотрудникПоЗвонкам",	Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	
	ТаблицаОтчетПоВсемЗвонкам = Новый ТаблицаЗначений;
	ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("КоличествоСобытийДень",	Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("Дата",							Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("КоличествоЗвонковДень",			Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("ПропущенныхЗвонковДень",		Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("ПроцентПропущенныхЗвонковДень",	Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("СреднееВремяОжиданияДень",		Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
	
	// Обрабатываем таблицу истории звонков	
	Если ЭтотОбъект.ВариантОтчета = "ЕженедельныйОтчет" Тогда
		ТаблицаЕженедельныйОтчет.Колонки.Удалить("ЗвонковБольше45ВЧас");
		ТаблицаЕженедельныйОтчет.Колонки.Удалить("ПервыйЗвонокДень");
		ТаблицаЕженедельныйОтчет.Колонки.Удалить("ПоследнийЗвонокДень");
		ТаблицаЕженедельныйОтчет.Колонки.Удалить("ПродолжительностьРабочегоДня");
		ТаблицаЕженедельныйОтчет.Колонки.Добавить("ЗвонковБольше45ВДень",	Новый ОписаниеТипов("Число", 	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
		ТаблицаРабочегоДня = Новый ТаблицаЗначений;
		ТаблицаРабочегоДня.Колонки.Добавить("Сотрудник",				Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
		ТаблицаРабочегоДня.Колонки.Добавить("ДатаЗвонкаДень",			Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
		ТаблицаРабочегоДня.Колонки.Добавить("ПервыйЗвонокДень",			Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
		ТаблицаРабочегоДня.Колонки.Добавить("ПоследнийЗвонокДень",		Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
		Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			// Пропускаем неотвеченный звонок
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.AnswerTime) Тогда
				Продолжить;
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТаблицы.DropTime) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаТаблицы.Origin = 1 Тогда
				// Внешний/внутренний исходящий
				ОчищенныйНомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(СтрокаТаблицы.CallerId);
				Если ПустаяСтрока(ОчищенныйНомерТелефона) Тогда
					Продолжить;
				ИначеЕсли СтрДлина(ОчищенныйНомерТелефона) > ДлинаВнутреннихНомеров Тогда
					Продолжить;
				КонецЕсли;
				СтрокаСоответствия = ТаблицаСоответствия.Найти(ОчищенныйНомерТелефона, "Номер");
				Если СтрокаСоответствия = Неопределено Тогда
					Продолжить;
				ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаСоответствия.Абонент) Тогда
					Продолжить;
				ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.СотрудникОтчета) И НЕ (ЭтотОбъект.СотрудникОтчета = СтрокаСоответствия.Абонент) Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока 					= ТаблицаЕженедельныйОтчет.Добавить();
				НоваяСтрока.Сотрудник			= СтрокаСоответствия.Абонент;
				НоваяСтрока.ДатаЗвонкаДень		= НачалоДня(СтрокаТаблицы.StartTime);
				НоваяСтрока.ВсегоЗвонковДень	= 1;
				ОчищенныйНомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(СтрокаТаблицы.CalledId);
				Если ПустаяСтрока(ОчищенныйНомерТелефона) Тогда
					НоваяСтрока.ВсегоОрганизацийДень			= 0;
					НоваяСтрока.ВсегоНеИзБазыДень				= 0;
				ИначеЕсли СтрДлина(ОчищенныйНомерТелефона) > ДлинаВнутреннихНомеров Тогда
					// Внешний исходящий
					СтрокаСоответствия = ТаблицаСоответствия.Найти(ОчищенныйНомерТелефона, "Номер");
					Если СтрокаСоответствия = Неопределено Тогда
						НоваяСтрока.ВсегоОрганизацийДень	= 0;
						НоваяСтрока.ВсегоНеИзБазыДень		= 1;
					ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаСоответствия.Абонент) Тогда
						НоваяСтрока.ВсегоОрганизацийДень	= 0;
						НоваяСтрока.ВсегоНеИзБазыДень		= 1;
					Иначе
						НоваяСтрока.ВсегоОрганизацийДень	= 1;
						НоваяСтрока.ВсегоНеИзБазыДень		= 0;
					КонецЕсли;
				Иначе
					// Внутренний исходящий
					НоваяСтрока.ВсегоОрганизацийДень		= 0;
					НоваяСтрока.ВсегоНеИзБазыДень			= 0;
				КонецЕсли;
			ИначеЕсли СтрокаТаблицы.Origin = 2 Тогда
				// Внешний/внутренний входящий
				ОчищенныйНомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(СтрокаТаблицы.CalledId);
				Если ПустаяСтрока(ОчищенныйНомерТелефона) Тогда
					Продолжить;
				ИначеЕсли СтрДлина(ОчищенныйНомерТелефона) > ДлинаВнутреннихНомеров Тогда
					Продолжить;
				КонецЕсли;
				СтрокаСоответствия = ТаблицаСоответствия.Найти(ОчищенныйНомерТелефона, "Номер");
				Если СтрокаСоответствия = Неопределено Тогда
					Продолжить;
				ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаСоответствия.Абонент) Тогда
					Продолжить;
				ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.СотрудникОтчета) И НЕ (ЭтотОбъект.СотрудникОтчета = СтрокаСоответствия.Абонент) Тогда
					Продолжить;
				КонецЕсли;
				НоваяСтрока 					= ТаблицаЕженедельныйОтчет.Добавить();
				НоваяСтрока.Сотрудник			= СтрокаСоответствия.Абонент;
				НоваяСтрока.ДатаЗвонкаДень		= НачалоДня(СтрокаТаблицы.StartTime);
				НоваяСтрока.ВсегоЗвонковДень	= 1;
				ОчищенныйНомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(СтрокаТаблицы.CallerId);
				Если ПустаяСтрока(ОчищенныйНомерТелефона) Тогда
					НоваяСтрока.ВсегоОрганизацийДень			= 0;
					НоваяСтрока.ВсегоНеИзБазыДень				= 0;
				ИначеЕсли СтрДлина(ОчищенныйНомерТелефона) > ДлинаВнутреннихНомеров Тогда
					// Внешний входящий
					СтрокаСоответствия = ТаблицаСоответствия.Найти(ОчищенныйНомерТелефона, "Номер");
					Если СтрокаСоответствия = Неопределено Тогда
						НоваяСтрока.ВсегоОрганизацийДень	= 0;
						НоваяСтрока.ВсегоНеИзБазыДень		= 1;
					ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаСоответствия.Абонент) Тогда
						НоваяСтрока.ВсегоОрганизацийДень	= 0;
						НоваяСтрока.ВсегоНеИзБазыДень		= 1;
					Иначе
						НоваяСтрока.ВсегоОрганизацийДень	= 1;
						НоваяСтрока.ВсегоНеИзБазыДень		= 0;
					КонецЕсли;
				Иначе
					// Внутренний входящий
					НоваяСтрока.ВсегоОрганизацийДень		= 0;
					НоваяСтрока.ВсегоНеИзБазыДень			= 0;
				КонецЕсли;
			ИначеЕсли СтрокаТаблицы.Origin = 3 Тогда
				// Внешний входящий
				ОчищенныйНомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(СтрокаТаблицы.CalledId);
				Если ПустаяСтрока(ОчищенныйНомерТелефона) Тогда
					Продолжить;
				ИначеЕсли СтрДлина(ОчищенныйНомерТелефона) > ДлинаВнутреннихНомеров Тогда
					Продолжить;
				КонецЕсли;
