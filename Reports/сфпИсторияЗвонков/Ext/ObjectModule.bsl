	ИначеЕсли ЭтотОбъект.ВариантОтчета = "ОтчетПоВсемЗвонкам" Тогда
		ТаблицаОтчетПоВсемЗвонкам.Колонки.Удалить("СреднееВремяОжиданияДень");
		ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("ВремяОжиданияДень",		Новый ОписаниеТипов("Число",	Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));
		Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			// Пропускаем незавершенный звонок
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.DropTime) Тогда Продолжить; КонецЕсли;
			НоваяСтрока = ТаблицаОтчетПоВсемЗвонкам.Добавить();
			НоваяСтрока.Дата							= НачалоДня(СтрокаТаблицы.StartTime);
			НоваяСтрока.КоличествоЗвонковДень			= 1;
			НоваяСтрока.ПроцентПропущенныхЗвонковДень	= 0;
			НоваяСтрока.КоличествоСобытийДень			= 0;
			Если ЗначениеЗаполнено(СтрокаТаблицы.AnswerTime) Тогда
				НоваяСтрока.ПропущенныхЗвонковДень	= 0;
				НоваяСтрока.ВремяОжиданияДень		= (СтрокаТаблицы.AnswerTime - СтрокаТаблицы.StartTime);
			Иначе
				НоваяСтрока.ПропущенныхЗвонковДень	= 1;
				НоваяСтрока.ВремяОжиданияДень		= (СтрокаТаблицы.DropTime - СтрокаТаблицы.StartTime);
			КонецЕсли;	
		КонецЦикла;	
		ТаблицаОтчетПоВсемЗвонкам.Свернуть("Дата", "КоличествоСобытийДень, КоличествоЗвонковДень, ПропущенныхЗвонковДень, ПроцентПропущенныхЗвонковДень, ВремяОжиданияДень");
		ТаблицаОтчетПоВсемЗвонкам.Колонки.Добавить("СреднееВремяОжиданияДень",	Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Время)));
		Запрос.Текст = "ВЫБРАТЬ
		               |	События.Дата,
		               |	СУММА(События.Количество) КАК КоличествоСобытийДень
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		CRM_Событие.Ссылка КАК Ссылка,
		               |		НАЧАЛОПЕРИОДА(CRM_Событие.Дата, ДЕНЬ) КАК Дата,
		               |		1 КАК Количество
		               |	ИЗ
		               |		Документ.Событие КАК CRM_Событие
		               |	ГДЕ
		               |		CRM_Событие.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		               |		И CRM_Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)) КАК События
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	События.Дата";
		ВыборкаСобытий = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаИстории Из ТаблицаОтчетПоВсемЗвонкам Цикл
			Если СтрокаИстории.КоличествоЗвонковДень = 0 Тогда
				СтрокаИстории.ПроцентПропущенныхЗвонковДень = 0;
				СтрокаИстории.СреднееВремяОжиданияДень		= Дата('00010101');
			Иначе	
				СтрокаИстории.ПроцентПропущенныхЗвонковДень = (СтрокаИстории.ПропущенныхЗвонковДень / СтрокаИстории.КоличествоЗвонковДень) * 100;
				СтрокаИстории.СреднееВремяОжиданияДень		= Дата('00010101') + (СтрокаИстории.ВремяОжиданияДень / СтрокаИстории.КоличествоЗвонковДень);
			КонецЕсли;
			СтрокаСобытия = ВыборкаСобытий.Найти(СтрокаИстории.Дата, "Дата");
			Если СтрокаСобытия = Неопределено Тогда
				СтрокаИстории.КоличествоСобытийДень	= 0;
			Иначе	
				СтрокаИстории.КоличествоСобытийДень	= СтрокаСобытия.КоличествоСобытийДень;
			КонецЕсли;	
		КонецЦикла;
		ТаблицаОтчетПоВсемЗвонкам.Колонки.Удалить("ВремяОжиданияДень");
	КонецЕсли;	
	ВнешниеНаборыДанных	= Новый Структура;
	ВнешниеНаборыДанных.Вставить("ТаблицаЕженедельныйОтчет",			ТаблицаЕженедельныйОтчет);
	ВнешниеНаборыДанных.Вставить("ТаблицаОтчетПоСовершеннымЗвонкам",	ТаблицаОтчетПоСовершеннымЗвонкам);
	ВнешниеНаборыДанных.Вставить("ТаблицаОтчетПоВсемЗвонкам",			ТаблицаОтчетПоВсемЗвонкам);
	СхемаКомпоновкиДанных = ЭтотОбъект.СхемаКомпоновкиДанных;
	ВариантНастроек = СхемаКомпоновкиДанных.ВариантыНастроек.Найти(ЭтотОбъект.ВариантОтчета);
	Если ВариантНастроек = Неопределено Тогда
		Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	Иначе
		Настройки = ВариантНастроек.Настройки;
	КонецЕсли;	
	Если ЭтотОбъект.ВариантОтчета = "ОтчетПоСовершеннымЗвонкам" Тогда
		Если ЗначениеЗаполнено(ЭтотОбъект.Событие) Тогда
			ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Использование	= Ложь;
			Если ЗначениеЗаполнено(ЭтотОбъект.Событие.Контрагент) Тогда
				ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
				ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].ПравоеЗначение	= ЭтотОбъект.Событие.Контрагент;
				ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Использование	= Истина;
				Если ЗначениеЗаполнено(ЭтотОбъект.Событие.КонтактноеЛицо) Тогда
					ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
					ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].ПравоеЗначение	= ЭтотОбъект.Событие.КонтактноеЛицо;
					ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Использование	= Истина;
				Иначе	
					ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Использование	= Ложь;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(ЭтотОбъект.Событие.КонтактноеЛицоБезКонтрагента) Тогда
				ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
				ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].ПравоеЗначение	= ЭтотОбъект.Событие.КонтактноеЛицоБезКонтрагента;
				ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[1].Использование	= Истина;
				ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[2].Использование	= Ложь;
			КонецЕсли;	
			ЭтотОбъект.Событие = Неопределено;
		КонецЕсли;	
		Для Каждого ЭлементПользовательскогоОтбора Из ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл		
			Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
				Если ЭлементОтбора.ИдентификаторПользовательскойНастройки = ЭлементПользовательскогоОтбора.ИдентификаторПользовательскойНастройки Тогда
					ЭлементОтбора.Использование		= ЭлементПользовательскогоОтбора.Использование;
					ЭлементОтбора.ВидСравнения		= ЭлементПользовательскогоОтбора.ВидСравнения;
					ЭлементОтбора.ПравоеЗначение	= ЭлементПользовательскогоОтбора.ПравоеЗначение;
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;	
	КомпоновщикМакета			= Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки				= КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	ПроцессорКомпоновкиДанных	= Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);
	ПроцессорВывода				= Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
КонецПроцедуры // ПриКомпоновкеРезультата()
