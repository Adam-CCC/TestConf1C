// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМЫ

&НаСервере
// Процедура - обработчик события формы "ПриСозданииНаСервере"
//
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ РольДоступна("ПолныеПрава") И НЕ РольДоступна("сфпУправлениеМаршрутизацией") Тогда
		Сообщить(НСтр("ru='Недостаточно прав для просмотра отчета!'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	СтрокаПодключения = Константы.сфпСтрокаПодключенияИстории.Получить();
	Если ПустаяСтрока(СтрокаПодключения) Тогда
		Сообщить(НСтр("ru='Ошибка отсутствуют параметры подключения к истории звонков'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	СтруктураПодключения	= ПолучитьСтруктуруПодключения(СтрокаПодключения);
	ВнешниеИсточникиДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.РазорватьСоединение();
	ПараметрыСоединения = ВнешниеИсточникиДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.ПолучитьОбщиеПараметрыСоединения();
	ПараметрыСоединения.АутентификацияСтандартная	= Истина;
	ПараметрыСоединения.ИмяПользователя				= СтруктураПодключения.Пользователь;
	ПараметрыСоединения.Пароль						= СтруктураПодключения.Пароль;
	ПараметрыСоединения.СтрокаСоединения			= "DRIVER={SQL Server};SERVER=" + СтруктураПодключения.Сервер + ";UID=" 
		+ СтруктураПодключения.Пользователь + ";PWD=" + СтруктураПодключения.Пароль + ";DATABASE="
		+ СтруктураПодключения.БазаДанных + ";LANGUAGE=русский";
	ПараметрыСоединения.СУБД						= "MSSQLServer";
	ВнешниеИсточникиДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.УстановитьОбщиеПараметрыСоединения(ПараметрыСоединения);
	ВнешниеИсточникиДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.УстановитьСоединение();
	СостояниеПодключения = ВнешниеИсточникиДанных.сфпВнешнийИсточникДанныхИсторииЗвонков.ПолучитьСостояние();
	Если СостояниеПодключения = СостояниеВнешнегоИсточникаДанных.Отключен Тогда
		Сообщить(НСтр("ru='Ошибка подключения к истории звонков'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Если Параметры.Свойство("ВариантОтчета") Тогда
		ОтчетОбъект.ВариантОтчета = Параметры.ВариантОтчета;
		ПриЗагрузкеВариантаНаСервере(Неопределено);
	КонецЕсли;	
	Если Параметры.Свойство("СотрудникОтчета") Тогда
		ОтчетОбъект.СотрудникОтчета = Параметры.СотрудникОтчета;
	КонецЕсли;	
	Если Параметры.Свойство("Событие") Тогда
		ОтчетОбъект.Событие = Параметры.Событие;
	КонецЕсли;	
	ЗначениеВРеквизитФормы(ОтчетОбъект, "Отчет");
КонецПроцедуры // ПриСозданииНаСервере()

&НаСервере
// Процедура - обработчик события формы "ПриЗагрузкеВариантаНаСервере"
//
Процедура ПриЗагрузкеВариантаНаСервере(Настройки)
	Отчет.ВариантОтчета = КлючТекущегоВарианта;
	Если Отчет.ВариантОтчета = "ЕженедельныйОтчет" Тогда
		Отчет.ПериодОтчета.Вариант		= ВариантСтандартногоПериода.ЭтаНеделя;
		Элементы.Сотрудник.Доступность	= Истина;
	ИначеЕсли Отчет.ВариантОтчета = "ОтчетПоСовершеннымЗвонкам" Тогда
		Элементы.Сотрудник.Доступность	= Истина;
	ИначеЕсли Отчет.ВариантОтчета = "ОтчетПоВсемЗвонкам" Тогда
		Элементы.Сотрудник.Доступность	= Ложь;
	Иначе	
		Отчет.ПериодОтчета.Вариант 		= ВариантСтандартногоПериода.Сегодня;
		Элементы.Сотрудник.Доступность	= Ложь;
	КонецЕсли;	
КонецПроцедуры // ПриЗагрузкеВариантаНаСервере()
