		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона КАК СхемаОбзвона,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.ПисьмоПрочитано
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Прочитано,
	СУММА(1) КАК КоличествоКлиентов,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусЭлПисьма = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыОтправкиПисем.ОжидаетОтправки)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ОжидаетОтправки,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусЭлПисьма = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыОтправкиПисем.ДобавленоВОчередь)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ДобавленоВОчередь,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусЭлПисьма = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыОтправкиПисем.Отправлено)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Отправлено,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.СтатусЭлПисьма = ЗНАЧЕНИЕ(Перечисление.Renault_СтатусыОтправкиПисем.ОшибкаОтправки)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ОшибкаОтправки,
	Renault_CommunicationCenter_Обзвон.Клиент КАК Клиент,
	ЕСТЬNULL(КонтактнаяИнформация.Представление, "") КАК Email
ИЗ
	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		ПО Renault_CommunicationCenter_Обзвон.Клиент = КонтактнаяИнформация.Объект
			И (КонтактнаяИнформация.Тип = &amp;ТипЭлПисьмо)
			И (КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА)
ГДЕ
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона = &amp;СхемаОбзвона

СГРУППИРОВАТЬ ПО
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона,
	Renault_CommunicationCenter_Обзвон.Клиент,
	ЕСТЬNULL(КонтактнаяИнформация.Представление, "")

УПОРЯДОЧИТЬ ПО
	СхемаОбзвона,
	Клиент</query>
