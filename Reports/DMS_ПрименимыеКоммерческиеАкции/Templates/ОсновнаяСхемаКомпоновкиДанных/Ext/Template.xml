		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаСкидки</dataPath>
			<field>СуммаСкидки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма скидки</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Автовыбор</dataPath>
			<field>Автовыбор</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипАкции</dataPath>
			<field>ТипАкции</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВладелецАкции</dataPath>
			<field>ВладелецАкции</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаНачала</dataPath>
			<field>ДатаНачала</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата начала</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Описание</dataPath>
			<field>Описание</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОкончания</dataPath>
			<field>ДатаОкончания</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата окончания</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	Спр.Ссылка КАК Акция,
	ВЫБОР
		КОГДА НЕ(ТЧ.НачалоДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
					И ТЧ.ОкончаниеДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
			ТОГДА ТЧ.НачалоДействия
		ИНАЧЕ Спр.НачалоДействия
	КОНЕЦ КАК ДатаНачала,
	ВЫБОР
		КОГДА НЕ(ТЧ.НачалоДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
					И ТЧ.ОкончаниеДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
			ТОГДА ТЧ.ОкончаниеДействия
		ИНАЧЕ Спр.ОкончаниеДействия
	КОНЕЦ КАК ДатаОкончания,
	ВЫРАЗИТЬ(Спр.Описание КАК СТРОКА(300)) КАК Описание,
	ВЫБОР
		КОГДА ТЧ.Ссылка ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ ВЫБОР
				КОГДА ТЧ.ВариантСкидки = ЗНАЧЕНИЕ(Перечисление.DMS_ВариантыСкидки.Процент)
					ТОГДА &amp;СуммаБазы * ТЧ.ЗначениеСкидки / 100
				ИНАЧЕ ТЧ.ЗначениеСкидки
			КОНЕЦ
	КОНЕЦ КАК СуммаСкидки,
	Спр.ВладелецАкции,
	Спр.Автовыбор,
	ВЫБОР
		КОГДА Спр.ТипАкции = 0
			ТОГДА "Все"
		КОГДА Спр.ТипАкции = 1
			ТОГДА "Кредит"
		КОГДА Спр.ТипАкции = 2
			ТОГДА "TradeIn"
		КОГДА Спр.ТипАкции = 3
			ТОГДА "Утилизация"
	КОНЕЦ КАК ТипАкции
ИЗ
	Справочник.DMS_КоммерческиеАкции КАК Спр
		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.DMS_КоммерческиеАкции.Условия КАК ТЧ
		ПО Спр.Ссылка = ТЧ.Ссылка
ГДЕ
	Спр.Активность
	И НАЧАЛОПЕРИОДА(&amp;ТекДата, ДЕНЬ) МЕЖДУ Спр.НачалоДействия И Спр.ОкончаниеДействия
	И ВЫБОР
			КОГДА ТЧ.Ссылка ЕСТЬ NULL
				ТОГДА ИСТИНА
			ИНАЧЕ ТЧ.НачалоДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
					ИЛИ НАЧАЛОПЕРИОДА(&amp;ТекДата, ДЕНЬ) МЕЖДУ ТЧ.НачалоДействия И ТЧ.ОкончаниеДействия
		КОНЕЦ
	И Спр.Ссылка В
			(ВЫБРАТЬ
				Справочник.DMS_КоммерческиеАкции.Ссылка
			ИЗ
				Справочник.DMS_КоммерческиеАкции
			ГДЕ
				НЕ Справочник.DMS_КоммерческиеАкции.Ссылка В
						(ВЫБРАТЬ
							Справочник.DMS_КоммерческиеАкции.ГодыВыпуска.Ссылка
						ИЗ
							Справочник.DMS_КоммерческиеАкции.ГодыВыпуска)
		
			ОБЪЕДИНИТЬ
		
			ВЫБРАТЬ
				Справочник.DMS_КоммерческиеАкции.ГодыВыпуска.Ссылка
			ИЗ
				Справочник.DMS_КоммерческиеАкции.ГодыВыпуска
			ГДЕ
				Справочник.DMS_КоммерческиеАкции.ГодыВыпуска.Год = &amp;Год)
	И Спр.Ссылка В
			(ВЫБРАТЬ
				Справочник.DMS_КоммерческиеАкции.Ссылка
			ИЗ
				Справочник.DMS_КоммерческиеАкции
			ГДЕ
				НЕ Справочник.DMS_КоммерческиеАкции.Ссылка В
						(ВЫБРАТЬ
							Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры.Ссылка
						ИЗ
							Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры)
		
			ОБЪЕДИНИТЬ
		
			ВЫБРАТЬ
				Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры.Ссылка
			ИЗ
				Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры
			ГДЕ
				Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры.ДилерскийЦентр = &amp;ДилерскийЦентр)
	И ВЫБОР
			КОГДА Спр.ВладелецАкции = ЗНАЧЕНИЕ(Перечисление.DMS_ВладельцыСервисов.Контрагент)
				ТОГДА ИСТИНА
			ИНАЧЕ ТЧ.Объект = &amp;ВариантКомплектации
					ИЛИ ТЧ.Объект = &amp;Модель
					ИЛИ ТЧ.Объект = &amp;VIN
		КОНЕЦ</query>
	</dataSet>
