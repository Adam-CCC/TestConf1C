		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Событие.Ссылка КАК СамДокумент,
	Событие.ВидСобытия КАК ВидСобытия,
	Событие.ДатаНачала КАК ДатаНачала,
	Событие.ДатаОкончания КАК ДатаОкончания,
	Событие.ДокументОснование КАК ДокументОснование,
	Событие.Организация КАК Организация,
	Событие.ПодразделениеКомпании КАК ПодразделениеКомпании,
	Событие.Состояние КАК Состояние,
	Событие.ТипСообщения КАК ТипСообщения,
	Событие.ЕстьПриемПоТрэйдИн КАК ЕстьПриемПоТрэйдИн,
	Событие.Результат КАК Результат,
	Событие.Решение КАК Решение,
	Событие.Продавец КАК Менеджер,
	Событие.ДатаОкончания КАК Дата,
	ДатыПервыхСобытийРЛ.ДатаПервогоДокумента КАК ДатаПервогоДокумента,
	Событие.Дата КАК ДатаДока,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ВсегоЗвонков,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
			ТОГДА ВЫБОР
					КОГДА ДатыПервыхСобытийРЛ.ДатаПервогоДокумента = Событие.Дата
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ПервичноеВЗ,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
			ТОГДА ВЫБОР
					КОГДА ДатыПервыхСобытийРЛ.ДатаПервогоДокумента = Событие.Дата
						ТОГДА 0
					ИНАЧЕ 1
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ПовторноеВЗ,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
			ТОГДА ВЫБОР
					КОГДА Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ОбработанноеВЗ,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.БачатаАвто)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ВсегоЧатов,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.БачатаАвто)
			ТОГДА ВЫБОР
					КОГДА ДатыПервыхСобытийРЛ.ДатаПервогоДокумента = Событие.Дата
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ПервичноеЧатов,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.БачатаАвто)
			ТОГДА ВЫБОР
					КОГДА ДатыПервыхСобытийРЛ.ДатаПервогоДокумента = Событие.Дата
						ТОГДА 0
					ИНАЧЕ 1
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ПовторноеЧатов,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.БачатаАвто)
			ТОГДА ВЫБОР
					КОГДА Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ОбработанноеЧатов,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЗаявкаССайта)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ВсегоЗаявокССайта,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЗаявкаССайта)
			ТОГДА ВЫБОР
					КОГДА ДатыПервыхСобытийРЛ.ДатаПервогоДокумента = Событие.Дата
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ПервичноеЗаявокССайта,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЗаявкаССайта)
			ТОГДА ВЫБОР
					КОГДА ДатыПервыхСобытийРЛ.ДатаПервогоДокумента = Событие.Дата
						ТОГДА 0
					ИНАЧЕ 1
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ПовторноеЗаявокССайта,
	ВЫБОР
		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЗаявкаССайта)
			ТОГДА ВЫБОР
					КОГДА Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ КАК ОбработанноеЗаявокССайта
ИЗ
	Документ.Событие КАК Событие
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			МИНИМУМ(Доки.Дата) КАК ДатаПервогоДокумента,
			Доки.ПредставлениеТелефона КАК ПредставлениеТелефона,
			Доки.ПодразделениеКомпании КАК ПодразделениеКомпании,
			Доки.ДокументОснование КАК ДокументОснованиеСобытия
		ИЗ
			Документ.Событие КАК Доки
		
		СГРУППИРОВАТЬ ПО
			Доки.ПредставлениеТелефона,
			Доки.ПодразделениеКомпании,
			Доки.ДокументОснование) КАК ДатыПервыхСобытийРЛ
		ПО Событие.ПредставлениеТелефона = ДатыПервыхСобытийРЛ.ПредставлениеТелефона
			И Событие.ПодразделениеКомпании = ДатыПервыхСобытийРЛ.ПодразделениеКомпании
			И Событие.ДокументОснование = ДатыПервыхСобытийРЛ.ДокументОснованиеСобытия
ГДЕ
	Событие.ДатаОкончания МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И Событие.Проведен
	И НЕ Событие.ПометкаУдаления
	И Событие.ДокументОснование &lt;&gt; ЗНАЧЕНИЕ(Документ.РабочийЛист.ПустаяСсылка)
	И ТИПЗНАЧЕНИЯ(Событие.ДокументОснование) = ТИП(Документ.РабочийЛист)
	И Событие.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщений.Входящее)
	И Событие.ВидСобытия В(&amp;ВидыСобытий)</query>
	</dataSet>
