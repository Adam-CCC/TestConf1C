		<query>ВЫБРАТЬ
	Событие.Ссылка,
	Событие.Дата,
	Событие.Номер,
	Событие.Автомобиль,
	Событие.Контрагент,
	Событие.КонтактныйТелефон,
	Событие.Продавец КАК Менеджер,
	Событие.Автомобиль.Модель КАК Модель,
	Событие.ИсточникИнформации КАК Реклама
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И Событие.Проведен
	И Событие.ВидСобытия &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.Прочее)</query>
