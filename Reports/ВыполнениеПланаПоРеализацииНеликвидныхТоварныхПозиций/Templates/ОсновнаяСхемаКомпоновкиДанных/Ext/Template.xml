		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
	ЗаказНаряд.Дата,
	ЗаказНаряд.Проведен,
	ЗаказНаряд.Автор,
	ЗаказНаряд.Менеджер,
	ЗаказНаряд.Организация,
	ЗаказНаряд.ПодразделениеКомпании,
	ЗаказНаряд.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	ЗаказНаряд.ФлагНеликвидаЗН,
	ЗаказНаряд.Состояние,
	ЗаказНаряд.Контрагент,
	СУММА(ЗаказНаряд.СуммаНеликвидаЗН) КАК СуммаНеликвида,
	СУММА(ЗаказНаряд.СуммаДокумента) КАК Сумма,
	СУММА(ЗаказНаряд.СуммаНоменклатурыДокумента) КАК СуммаНоменклатуры
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.ФлагНеликвидаЗН = ИСТИНА
	И ЗаказНаряд.Проведен = ИСТИНА
	И ЗаказНаряд.СуммаНеликвидаЗН &gt; 0
	И ЗаказНаряд.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.Ссылка,
	ЗаказНаряд.Дата,
	ЗаказНаряд.Проведен,
	ЗаказНаряд.Автор,
	ЗаказНаряд.Менеджер,
	ЗаказНаряд.Организация,
	ЗаказНаряд.ПодразделениеКомпании,
	ЗаказНаряд.ПодразделениеКомпании.ДилерскийЦентр,
	ЗаказНаряд.Состояние,
	ЗаказНаряд.ФлагНеликвидаЗН,
	ЗаказНаряд.Контрагент</query>
