		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодразделениеКомпании</dataPath>
			<field>ПодразделениеКомпании</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаявкаНаРемонт.Ссылка КАК ПланРемонта,
	ЗаявкаНаРемонт.ДатаНачала КАК ДатаНачалаПланаРемонта,
	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
	ЗаказНаряд.ДатаНачала КАК ДатаНачалаЗаказНаряда,
	РАЗНОСТЬДАТ(ЗаявкаНаРемонт.ДатаНачала, ЗаказНаряд.ДатаНачала, МИНУТА) КАК ЗадержкаНачалаЗНотЗР,
	ЗаявкаНаРемонт.Ссылка.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	ЗаявкаНаРемонт.ПодразделениеКомпании КАК ПодразделениеКомпании
ИЗ
	Документ.ЗаявкаНаРемонт КАК ЗаявкаНаРемонт
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаказНаряд.Ссылка КАК Ссылка,
			ЗаказНаряд.ДокументОснование КАК ДокументОснование,
			ЗаказНаряд.ДатаНачала КАК ДатаНачала
		ИЗ
			Документ.ЗаказНаряд КАК ЗаказНаряд) КАК ЗаказНаряд
		ПО ЗаявкаНаРемонт.Ссылка = ЗаказНаряд.ДокументОснование
ГДЕ
	ЗаявкаНаРемонт.ДатаНачала МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаявкаНаРемонт.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПланРемонта)</query>
	</dataSet>
