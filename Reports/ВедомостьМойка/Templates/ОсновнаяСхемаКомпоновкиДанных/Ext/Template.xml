		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПродажиОбороты.ДокументПродажи.Диспетчер КАК Диспетчер,
	ПродажиОбороты.Авторабота КАК Авторабота,
	ПродажиОбороты.КоличествоОборот КАК КоличествоРабот,
	0 КАК КоличествоРаботЗаДень,
	ПродажиОбороты.СуммаОборот КАК Сумма,
	0 КАК СуммаЗаДень
ПОМЕСТИТЬ Автоработы
ИЗ
	РегистрНакопления.Продажи.Обороты(&amp;ДатаНачала, &amp;ДатаОкончания, Авто, ) КАК ПродажиОбороты
ГДЕ
	ПродажиОбороты.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ЗаказНаряд)
	И ПродажиОбороты.ДокументПродажи.ПодразделениеКомпании В ИЕРАРХИИ(&amp;Подразделение)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПродажиОбороты.ДокументПродажи.Диспетчер,
	ПродажиОбороты.Авторабота,
	0,
	ПродажиОбороты.КоличествоОборот,
	0,
	ПродажиОбороты.СуммаОборот
ИЗ
	РегистрНакопления.Продажи.Обороты(НАЧАЛОПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ), КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ), Авто, ) КАК ПродажиОбороты
ГДЕ
	ПродажиОбороты.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ЗаказНаряд)
	И ПродажиОбороты.ДокументПродажи.ПодразделениеКомпании В ИЕРАРХИИ(&amp;Подразделение)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказНаряд.Диспетчер,
	КОЛИЧЕСТВО(*) КАК КоличествоЗН
ПОМЕСТИТЬ Диспетчеры
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ВЫБОР
			КОГДА &amp;СостояниеЗН = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
				ТОГДА ЗаказНаряд.Состояние = &amp;СостояниеЗН
						И (ЗаказНаряд.ДатаЗакрытия МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания)
			КОГДА &amp;СостояниеЗН = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Выполнен)
				ТОГДА ЗаказНаряд.Состояние = &amp;СостояниеЗН
						И (ЗаказНаряд.ДатаОкончания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания)
			ИНАЧЕ ЗаказНаряд.Состояние = &amp;СостояниеЗН
					И (ЗаказНаряд.ДатаСоздания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания)
		КОНЕЦ
	И ЗаказНаряд.ПодразделениеКомпании В ИЕРАРХИИ(&amp;Подразделение)
	И ЗаказНаряд.ВалютаДокумента = &amp;Валюта

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.Диспетчер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Диспетчеры.Диспетчер.Наименование КАК МастерПриемщик,
	Диспетчеры.КоличествоЗН КАК КоличествоАвтомобилей,
	СУММА(Автоработы.КоличествоРабот) КАК КоличествоРабот,
	0 КАК ПроцентРабот,
	СУММА(Автоработы.КоличествоРаботЗаДень) КАК КоличествоРаботЗаДень,
	СУММА(Автоработы.Сумма) КАК Сумма,
	СУММА(Автоработы.СуммаЗаДень) КАК СуммаЗаДень,
	Автоработы.Авторабота,
	Диспетчеры.Диспетчер,
	Автоработы.Авторабота.Наименование КАК НаименованиеРаботы
ИЗ
	Диспетчеры КАК Диспетчеры
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Автоработы КАК Автоработы
		ПО Диспетчеры.Диспетчер = Автоработы.Диспетчер

СГРУППИРОВАТЬ ПО
	Диспетчеры.Диспетчер,
	Автоработы.Авторабота,
	Диспетчеры.КоличествоЗН,
	Диспетчеры.Диспетчер.Наименование,
	Автоработы.Авторабота.Наименование</query>
