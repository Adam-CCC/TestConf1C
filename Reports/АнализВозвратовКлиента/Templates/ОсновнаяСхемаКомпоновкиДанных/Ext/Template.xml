		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	РеализацияАвтомобилейАвтомобили.Автомобиль КАК Автомобиль
ПОМЕСТИТЬ РА
ИЗ
	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили

СГРУППИРОВАТЬ ПО
	РеализацияАвтомобилейАвтомобили.Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказНаряд.Ссылка,
	ЗаказНаряд.Автомобиль
ПОМЕСТИТЬ ЗН
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказНаряд.ВидРемонта В(&amp;ВидРемонта)
	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЗН.Ссылка.Автомобиль.VIN КАК VIN,
	ЗН.Ссылка.Заказчик КАК Заказчик,
	ЗН.Ссылка.Автомобиль.ГодВыпуска КАК ГодВыпуска,
	ЗН.Ссылка.Автомобиль КАК Автомобиль,
	ВЫБОР
		КОГДА РА.Автомобиль ССЫЛКА Справочник.Автомобили
			ТОГДА "Наш"
		ИНАЧЕ "Не Наш"
	КОНЕЦ КАК ЧейКлиент,
	ЗН.Автомобиль.Модель КАК Модель,
	ЗН.Ссылка.ПодразделениеКомпании.Родитель КАК ДЦ,
	СУММА(ВЫБОР
			КОГДА ГОД(ЗН.Ссылка.Дата) = 2013
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Поле_2013,
	СУММА(ВЫБОР
			КОГДА ГОД(ЗН.Ссылка.Дата) = 2014
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Поле_2014,
	СУММА(ВЫБОР
			КОГДА ГОД(ЗН.Ссылка.Дата) = 2015
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Поле_2015,
	СУММА(ВЫБОР
			КОГДА ГОД(ЗН.Ссылка.Дата) = 2016
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Поле_2016,
	СУММА(1) КАК ОбщееКоличество
ИЗ
	ЗН КАК ЗН
		ЛЕВОЕ СОЕДИНЕНИЕ РА КАК РА
		ПО ЗН.Автомобиль = РА.Автомобиль

СГРУППИРОВАТЬ ПО
	ЗН.Ссылка.Автомобиль.VIN,
	ЗН.Ссылка.Заказчик,
	ЗН.Ссылка.Автомобиль.ГодВыпуска,
	ЗН.Ссылка.Автомобиль,
	ВЫБОР
		КОГДА РА.Автомобиль ССЫЛКА Справочник.Автомобили
			ТОГДА "Наш"
		ИНАЧЕ "Не Наш"
	КОНЕЦ,
	ЗН.Автомобиль.Модель,
	ЗН.Ссылка.ПодразделениеКомпании.Родитель</query>
	</dataSet>
