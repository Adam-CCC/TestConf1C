		<query>ВЫБРАТЬ
	ЗаказНаряд.Ссылка,
	ЗаказНаряд.Автомобиль.Модель КАК Модель,
	ЗаказНаряд.Автомобиль.VIN КАК VIN,
	ЗаказНаряд.Автомобиль.ГодВыпуска КАК ГодВыпуска,
	ЗаказНаряд.Владелец,
	ЗаказНаряд.Состояние,
	ЗаказНаряд.Дата,
	ЗаказНаряд.СуммаДокумента,
	РАЗНОСТЬДАТ(ЗаказНаряд.ДатаСоздания, &amp;НаДату, ДЕНЬ) КАК ДнейВРемонте,
	ЗаказНаряд.Организация,
	ЗаказНаряд.ПодразделениеКомпании,
	ЗаказНаряд.ВидРемонта,
	АвтомобилиСрезПоследних.Значение КАК ГосНомер
ПОМЕСТИТЬ ЗаказНаряды
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&amp;НаДату, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК АвтомобилиСрезПоследних
		ПО ЗаказНаряд.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
ГДЕ
	ЗаказНаряд.ВидРемонта.ГарантияЗавода
	И ЗаказНаряд.Состояние &lt;&gt; ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Заявка)
	И ЗаказНаряд.Состояние &lt;&gt; ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказПокупателя.Ссылка,
	ЗаказПокупателя.ДокументОснование,
	ЗаказПокупателя.ДатаСоздания
ПОМЕСТИТЬ ЗаказыПокупателей
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	ЗаказПокупателя.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиЗаказов.Заказ,
	ОстаткиЗаказов.Период КАК ДатаВыполнения
ПОМЕСТИТЬ ПоставкиЗапчастей
ИЗ
	(ВЫБРАТЬ
		ЗаказыПокупателей.Заказ КАК Заказ,
		МАКСИМУМ(ЗаказыПокупателей.Период) КАК Период,
		СУММА(ВЫБОР
				КОГДА ЗаказыПокупателей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
					ТОГДА ЗаказыПокупателей.Заказано
				КОГДА ЗаказыПокупателей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
					ТОГДА -ЗаказыПокупателей.Заказано
			КОНЕЦ) КАК ОстатокЗаказа
	ИЗ
		РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	ГДЕ
		ЗаказыПокупателей.Заказ ССЫЛКА Документ.ЗаказПокупателя
		И ЗаказыПокупателей.Заказано &lt;&gt; 0
	
	СГРУППИРОВАТЬ ПО
		ЗаказыПокупателей.Заказ) КАК ОстаткиЗаказов
ГДЕ
	ОстаткиЗаказов.ОстатокЗаказа = 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Событие.ДокументОснование,
	Событие.ДатаВремяЗвонка КАК ДатаИнформирования,
	Событие.Комментарий
ПОМЕСТИТЬ События
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ДокументОснование ССЫЛКА Документ.ЗаказПокупателя
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказыПокупателей.ДокументОснование,
	ЗаказыПокупателей.ДатаСоздания КАК ДатаЗаказа,
	ПоставкиЗапчастей.ДатаВыполнения,
	События.ДатаИнформирования,
	События.Комментарий
ПОМЕСТИТЬ ДанныеПоЗаказам
ИЗ
	ЗаказыПокупателей КАК ЗаказыПокупателей
		ЛЕВОЕ СОЕДИНЕНИЕ ПоставкиЗапчастей КАК ПоставкиЗапчастей
		ПО ЗаказыПокупателей.Ссылка = ПоставкиЗапчастей.Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ События КАК События
		ПО ЗаказыПокупателей.Ссылка = События.ДокументОснование
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказНаряды.Модель,
	ЗаказНаряды.VIN,
	ЗаказНаряды.ГосНомер,
	ЗаказНаряды.ГодВыпуска,
	ЗаказНаряды.Владелец,
	ЗаказНаряды.Состояние,
	ЗаказНаряды.Дата,
	ЗаказНаряды.СуммаДокумента,
	ЗаказНаряды.ДнейВРемонте,
	ЗаказНаряды.Организация,
	ЗаказНаряды.ПодразделениеКомпании,
	ЗаказНаряды.ВидРемонта,
	ДанныеПоЗаказам.ДатаЗаказа,
	ДанныеПоЗаказам.ДатаВыполнения КАК ДатаПоставкиЗЧ,
	ДанныеПоЗаказам.ДатаИнформирования,
	ДанныеПоЗаказам.Комментарий
ИЗ
	ЗаказНаряды КАК ЗаказНаряды
		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоЗаказам КАК ДанныеПоЗаказам
		ПО ЗаказНаряды.Ссылка = ДанныеПоЗаказам.ДокументОснование</query>
