		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗапросПоЗаказам.Контрагент КАК Контрагент,
	ЗапросПоЗаказам.ДоговорВзаиморасчетов,
	ЗапросПоЗаказам.Заказ,
	ЗапросПоЗаказам.КоличествоОстаток,
	ЗапросПоЗаказам.РезервОстаток,
	ЕСТЬNULL(ЗапросПоВзаиморасчетам.СуммаОстаток, 0) КАК Сумма,
	ВЫБОР
		КОГДА ОстаткиАвтомобилейОстатки.Автомобиль ЕСТЬ NULL 
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК Оплачено
ИЗ
	(ВЫБРАТЬ
		ЗаказыАвтомобилейОстатки.Заказ.Контрагент КАК Контрагент,
		ЗаказыАвтомобилейОстатки.Заказ.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
		ЗаказыАвтомобилейОстатки.Заказ КАК Заказ,
		ЗаказыАвтомобилейОстатки.КоличествоОстаток КАК КоличествоОстаток,
		ЗаказыАвтомобилейОстатки.РезервОстаток КАК РезервОстаток
	ИЗ
		РегистрНакопления.ЗаказыАвтомобилей.Остатки(&amp;Дата, ) КАК ЗаказыАвтомобилейОстатки
	ГДЕ
		ЗаказыАвтомобилейОстатки.КоличествоОстаток &gt; 0) КАК ЗапросПоЗаказам
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ВзаиморасчетыКомпанииОстатки.Контрагент КАК Контрагент,
			ВзаиморасчетыКомпанииОстатки.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
			СУММА(ВзаиморасчетыКомпанииОстатки.СуммаОстаток) КАК СуммаОстаток
		ИЗ
			РегистрНакопления.ВзаиморасчетыКомпании.Остатки(
					&amp;Дата,
					(Контрагент, ДоговорВзаиморасчетов) В
						(ВЫБРАТЬ
							ЗаказыАвтомобилейОстатки.Заказ.Контрагент КАК Контрагент,
							ЗаказыАвтомобилейОстатки.Заказ.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов
						ИЗ
							РегистрНакопления.ЗаказыАвтомобилей.Остатки(&amp;Дата, ) КАК ЗаказыАвтомобилейОстатки
						ГДЕ
							ЗаказыАвтомобилейОстатки.КоличествоОстаток &gt; 0)) КАК ВзаиморасчетыКомпанииОстатки
		
		СГРУППИРОВАТЬ ПО
			ВзаиморасчетыКомпанииОстатки.Контрагент,
			ВзаиморасчетыКомпанииОстатки.ДоговорВзаиморасчетов) КАК ЗапросПоВзаиморасчетам
		ПО ЗапросПоЗаказам.Контрагент = ЗапросПоВзаиморасчетам.Контрагент
			И ЗапросПоЗаказам.ДоговорВзаиморасчетов = ЗапросПоВзаиморасчетам.ДоговорВзаиморасчетов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиАвтомобилей.Остатки(, СтатусПартии = ЗНАЧЕНИЕ(Перечисление.СтатусыПартий.ТоварКупленный)) КАК ОстаткиАвтомобилейОстатки
		ПО ЗапросПоЗаказам.Заказ.Автомобиль.VIN = ОстаткиАвтомобилейОстатки.Автомобиль.VIN

УПОРЯДОЧИТЬ ПО
	Контрагент</query>
