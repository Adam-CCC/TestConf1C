		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоЗаявок</dataPath>
			<field>КоличествоЗаявок</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество заявок</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоЗаказНарядов</dataPath>
			<field>КоличествоЗаказНарядов</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество заказ нарядов</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_Трафик.ТипТрафика,
	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК Обращение
ПОМЕСТИТЬ ВТ_ТрафикСОбращениями
ИЗ
	РегистрСведений.Renault_Трафик КАК Renault_Трафик
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		ПО Renault_Трафик.Идентификатор = Renault_CRM_ОбращениеВАвтоСервис.ИдентификаторТрафика
ГДЕ
	Renault_Трафик.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ТрафикСОбращениями.ТипТрафика,
	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК Заявка,
	Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд,
	Renault_CRM_ПриемкаАвтомобиля.Машиноместо КАК МастерПриемщик,
	ВТ_ТрафикСОбращениями.Обращение
ПОМЕСТИТЬ ВТ_ТрафикСЗаявками
ИЗ
	ВТ_ТрафикСОбращениями КАК ВТ_ТрафикСОбращениями
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		ПО ВТ_ТрафикСОбращениями.Обращение = Renault_CRM_ЗаявкаНаСервис.Обращение
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		ПО ВТ_ТрафикСОбращениями.Обращение = Renault_CRM_ПриемкаАвтомобиля.Обращение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ТрафикСЗаявками.ТипТрафика,
	ВТ_ТрафикСЗаявками.МастерПриемщик,
	ВТ_ТрафикСЗаявками.ЗаказНаряд.Диспетчер КАК Диспетчер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ТрафикСЗаявками.Заявка) КАК КоличествоЗаявок,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ТрафикСЗаявками.ЗаказНаряд) КАК КоличествоЗаказНарядов
ИЗ
	ВТ_ТрафикСЗаявками КАК ВТ_ТрафикСЗаявками

СГРУППИРОВАТЬ ПО
	ВТ_ТрафикСЗаявками.МастерПриемщик,
	ВТ_ТрафикСЗаявками.ТипТрафика,
	ВТ_ТрафикСЗаявками.ЗаказНаряд.Диспетчер</query>
