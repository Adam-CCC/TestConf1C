		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	т2.Обращение КАК Обращение,
	МИНИМУМ(т2.Ссылка) КАК МинСертификат,
	МАКСИМУМ(т2.Ссылка) КАК МаксСертификат,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т2.Ссылка) КАК КолвоСертификат,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т1.РекомендуемаяДатаВыполнения) КАК КолвоДатРек,
	МИНИМУМ(т1.РекомендуемаяДатаВыполнения) КАК МинДатаРек,
	МАКСИМУМ(т1.РекомендуемаяДатаВыполнения) КАК МаксДатаРек,
	МИНИМУМ(т1.Работа) КАК МинРабота,
	МАКСИМУМ(т1.Работа) КАК МаксРабота,
	КОЛИЧЕСТВО(т1.Работа) КАК КолвоРек
ПОМЕСТИТЬ СертКратко
ИЗ
	Документ.Renault_СертификатКонтроля.Работы КАК т1
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_СертификатКонтроля КАК т2
		ПО т1.Ссылка = т2.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК т3
		ПО (т2.Обращение = т3.Ссылка)
ГДЕ
	т2.ПометкаУдаления = ЛОЖЬ
	И т3.Дата &gt;= &amp;ДатаНач
	И т3.Дата &lt;= &amp;ДатаКон

СГРУППИРОВАТЬ ПО
	т2.Обращение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	т1.Обращение КАК Обращение,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т1.Автор) КАК КолвоАвтор,
	МИНИМУМ(т1.Машиноместо) КАК ПриемкаМинАвтор,
	МАКСИМУМ(т1.Машиноместо) КАК ПриемкаМаксАвтор,
	КОЛИЧЕСТВО(т1.Ссылка) КАК КолвоПриемок,
	МИНИМУМ(т1.Ссылка) КАК МинПриемка,
	МАКСИМУМ(т1.Ссылка) КАК МаксПриемка,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т1.Клиент) КАК КолвоКлиент,
	МИНИМУМ(т1.Клиент) КАК МинКлиент,
	МАКСИМУМ(т1.Клиент) КАК МаксКлиент,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ т1.Автомобиль) КАК КолвоАвтомобиль,
	МИНИМУМ(т1.Автомобиль) КАК МинАвтомобиль,
	МАКСИМУМ(т1.Автомобиль) КАК МаксАвтомобиль,
	МИНИМУМ(т1.ВремяНачала) КАК МинВремяНачала,
	МАКСИМУМ(т1.ВремяНачала) КАК МаксВремяНачала,
	МИНИМУМ(Факт.ВремяНачала) КАК ВремяНачала
ПОМЕСТИТЬ тПриемки
