	ЕСТЬNULL(СертКратко.МинРабота, "") КАК МинРаботаРеко,
	ЕСТЬNULL(СертКратко.МаксРабота, "") КАК МаксРаботаРеко,
	1 КАК КолвоОбращений,
	тПриемки.ВремяНачала КАК ВремяПриемкиФакт,
	тВыдачи.ВремяОкончания КАК ВремяВыдачиФакт
ИЗ
	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		ЛЕВОЕ СОЕДИНЕНИЕ тПриемки КАК тПриемки
		ПО Renault_CRM_ОбращениеВАвтоСервис.Ссылка = тПриемки.Обращение
		ЛЕВОЕ СОЕДИНЕНИЕ тВыдачи КАК тВыдачи
		ПО Renault_CRM_ОбращениеВАвтоСервис.Ссылка = тВыдачи.Обращение
		ЛЕВОЕ СОЕДИНЕНИЕ тЗаявки КАК тЗаявки
		ПО Renault_CRM_ОбращениеВАвтоСервис.Ссылка = тЗаявки.Обращение
		ЛЕВОЕ СОЕДИНЕНИЕ тСертификаты КАК тСертификаты
		ПО Renault_CRM_ОбращениеВАвтоСервис.Ссылка = тСертификаты.Обращение
		ЛЕВОЕ СОЕДИНЕНИЕ СертКратко КАК СертКратко
		ПО Renault_CRM_ОбращениеВАвтоСервис.Ссылка = СертКратко.Обращение
		ЛЕВОЕ СОЕДИНЕНИЕ тЗаказНарядыЗаявок КАК тЗаказНарядыЗаявок
		ПО Renault_CRM_ОбращениеВАвтоСервис.Ссылка = тЗаказНарядыЗаявок.Обращение
ГДЕ
	Renault_CRM_ОбращениеВАвтоСервис.ПометкаУдаления = ЛОЖЬ
	И Renault_CRM_ОбращениеВАвтоСервис.Дата &gt;= &amp;ДатаНач
	И Renault_CRM_ОбращениеВАвтоСервис.Дата &lt;= &amp;ДатаКон
	И Renault_CRM_ОбращениеВАвтоСервис.ДилерскийЦентр = &amp;ДилерскийЦентр

УПОРЯДОЧИТЬ ПО
	Renault_CRM_ОбращениеВАвтоСервис.ДилерскийЦентр,
	Renault_CRM_ОбращениеВАвтоСервис.Дата,
	Renault_CRM_ОбращениеВАвтоСервис.Ссылка</query>
