		<query>ВЫБРАТЬ
	ЗаказНаряд.Ссылка КАК ПервоначальныйЗНТО,
	ЗаказНаряд.Дата,
	ЗаказНаряд.Состояние,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.Автомобиль,
	ЗаказНаряд.Заказчик,
	ЗаказНаряд.Заказчик.ОсновнойТелефон КАК Телефон,
	ЗаказНарядПоследующий.Ссылка КАК ПоследующийЗНТО,
	ЗаказНаряд.ПодразделениеКомпании,
	ЗаказНаряд.Автомобиль.VIN КАК VIN,
	ХарактеристикиАвто.Значение КАК ГосНомер
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаказНаряд.Ссылка КАК Ссылка,
			ЗаказНаряд.Автомобиль КАК Автомобиль,
			ЗаказНаряд.Дата КАК Дата,
			ЗаказНаряд.ВидРемонта КАК ВидРемонта,
			ЗаказНаряд.Состояние КАК Состояние,
			ЗаказНаряд.Ссылка КАК Ссылка2,
			ЗаказНаряд.Дата КАК Дата2
		ИЗ
			Документ.ЗаказНаряд КАК ЗаказНаряд
		ГДЕ
			ЗаказНаряд.ВидРемонта = &amp;ВидРемонтаТО
			И ЗаказНаряд.Состояние = &amp;Состояние
			И ЗаказНаряд.Дата &gt; &amp;ДатаОкончания) КАК ЗаказНарядПоследующий
		ПО ЗаказНаряд.Автомобиль = ЗаказНарядПоследующий.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
			АвтомобилиСрезПоследних.Значение КАК Значение
		ИЗ
			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		ГДЕ
			АвтомобилиСрезПоследних.ВидЗначения = &amp;ВидЗначения) КАК ХарактеристикиАвто
		ПО ЗаказНаряд.Автомобиль = ХарактеристикиАвто.Автомобиль
ГДЕ
	ЗаказНаряд.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказНаряд.Состояние = &amp;Состояние
	И ЗаказНаряд.ВидРемонта = &amp;ВидРемонтаТО</query>
