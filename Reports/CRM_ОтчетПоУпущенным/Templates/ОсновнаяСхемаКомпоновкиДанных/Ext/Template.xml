<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Причина</dataPath>
			<field>Причина</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Причина</v8:content>
				</v8:item>
			</title>
			<attributeUseRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</attributeUseRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВсеУпущенныеКлиенты</dataPath>
			<field>ВсеУпущенныеКлиенты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Все упущенные клиенты</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВсеУпущенныеКлиентыПроцент</dataPath>
			<field>ВсеУпущенныеКлиентыПроцент</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Все упущенные клиенты %</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПервичныйТрафик</dataPath>
			<field>ПервичныйТрафик</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Первичный трафик</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УпущенныеКлиентыМенеджер</dataPath>
			<field>УпущенныеКлиентыМенеджер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Упущенные клиенты - менеджер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УпущенныеКлиентыМенеджерПроцент</dataPath>
			<field>УпущенныеКлиентыМенеджерПроцент</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Упущенные клиенты - менеджер %</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УпущенныеКлиентыРесепшн</dataPath>
			<field>УпущенныеКлиентыРесепшн</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Упущенные клиенты - ресепшн</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УпущенныеКлиентыРесепшнПроцент</dataPath>
			<field>УпущенныеКлиентыРесепшнПроцент</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Упущенные клиенты - ресепшн %</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Отдел</dataPath>
			<field>Отдел</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипТрафика</dataPath>
			<field>ТипТрафика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПервичныйПовторный</dataPath>
			<field>ПервичныйПовторный</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Первичный повторный</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДилерскийЦентр</dataPath>
			<field>ДилерскийЦентр</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дилерский центр</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗакрытыеРЛНеПоПричинеПродажи</dataPath>
			<field>ЗакрытыеРЛНеПоПричинеПродажи</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Закрытые РЛ не по причине продажи</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Обработан</dataPath>
			<field>Обработан</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Обработан</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	CRM_УпущенныйТрафик.Менеджер,
	CRM_УпущенныйТрафик.ДилерскийЦентр,
	CRM_УпущенныйТрафик.Причина КАК Причина,
	CRM_УпущенныйТрафик.ИдентификаторТрафика,
	1 КАК КоличествоУпущено,
	ВЫБОР
		КОГДА CRM_УпущенныйТрафик.ВидУпущения = ЗНАЧЕНИЕ(Перечисление.CRM_ТипыУпущенияТрафика.Администратор)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоУпущеноАдминистратор,
	ВЫБОР
		КОГДА CRM_УпущенныйТрафик.ВидУпущения = ЗНАЧЕНИЕ(Перечисление.CRM_ТипыУпущенияТрафика.Менеджер)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоУпущеноМенеджер
ПОМЕСТИТЬ УпущенныйТрафик
ИЗ
	РегистрСведений.CRM_УпущенныйТрафик КАК CRM_УпущенныйТрафик
ГДЕ
	CRM_УпущенныйТрафик.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Renault_Трафик.Менеджер,
	Renault_Трафик.ДилерскийЦентр,
	Renault_Трафик.Идентификатор,
	Renault_Трафик.ТипТрафика,
	Renault_Трафик.Клиент,
	Renault_Трафик.Отдел,
	Renault_Трафик.Обработан,
	Renault_Трафик.ПервичныйПовторный,
	ЗНАЧЕНИЕ(Справочник.CRM_ПричиныУпущенныхКлиентов.ПустаяСсылка) КАК Причина,
	1 КАК Количество
ПОМЕСТИТЬ ПолныйТрафик
ИЗ
	РегистрСведений.Renault_Трафик КАК Renault_Трафик
ГДЕ
	Renault_Трафик.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РабочиеЛисты.Сотрудник,
	РабочиеЛисты.Клиент,
	1 КАК Количество
ПОМЕСТИТЬ РабочиеЛисты
ИЗ
	Документ.Renault_РабочийЛист КАК РабочиеЛисты
ГДЕ
	РабочиеЛисты.ДатаID МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И РабочиеЛисты.ПричинаЗакрытия &lt;&gt; ЗНАЧЕНИЕ(Справочник.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа)
	И РабочиеЛисты.ЛистЗакрыт = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПолныйТрафик.Менеджер КАК Менеджер,
	ПолныйТрафик.ДилерскийЦентр КАК ДилерскийЦентр,
	ПолныйТрафик.ТипТрафика КАК ТипТрафика,
	ПолныйТрафик.Отдел КАК Отдел,
	ПолныйТрафик.Обработан КАК Обработан,
	ПолныйТрафик.ПервичныйПовторный КАК ПервичныйПовторный,
	ЕСТЬNULL(УпущенныйТрафик.Причина, ЗНАЧЕНИЕ(Справочник.CRM_ПричиныУпущенныхКлиентов.ПустаяСсылка)) КАК Причина,
	СУММА(ЕСТЬNULL(ПолныйТрафик.Количество, 0)) КАК ПервичныйТрафик,
	СУММА(ЕСТЬNULL(УпущенныйТрафик.КоличествоУпущено, 0) + ЕСТЬNULL(РабочиеЛисты.Количество, 0)) КАК ВсеУпущенныеКлиенты,
	СУММА(ЕСТЬNULL(УпущенныйТрафик.КоличествоУпущено, 0) + ЕСТЬNULL(РабочиеЛисты.Количество, 0)) / СУММА(ЕСТЬNULL(ПолныйТрафик.Количество, 0)) * 100 КАК ВсеУпущенныеКлиентыПроцент,
	СУММА(ЕСТЬNULL(УпущенныйТрафик.КоличествоУпущеноАдминистратор, 0)) КАК УпущенныеКлиентыРесепшн,
	СУММА(ЕСТЬNULL(УпущенныйТрафик.КоличествоУпущеноАдминистратор, 0)) / СУММА(ЕСТЬNULL(ПолныйТрафик.Количество, 0)) * 100 КАК УпущенныеКлиентыРесепшнПроцент,
	СУММА(ЕСТЬNULL(УпущенныйТрафик.КоличествоУпущеноМенеджер, 0)) КАК УпущенныеКлиентыМенеджер,
	СУММА(ЕСТЬNULL(УпущенныйТрафик.КоличествоУпущеноМенеджер, 0)) / СУММА(ЕСТЬNULL(ПолныйТрафик.Количество, 0)) * 100 КАК УпущенныеКлиентыМенеджерПроцент,
	СУММА(ЕСТЬNULL(РабочиеЛисты.Количество, 0)) КАК ЗакрытыеРЛНеПоПричинеПродажи
ПОМЕСТИТЬ Результат
ИЗ
	ПолныйТрафик КАК ПолныйТрафик
		ЛЕВОЕ СОЕДИНЕНИЕ УпущенныйТрафик КАК УпущенныйТрафик
		ПО ПолныйТрафик.Идентификатор = УпущенныйТрафик.ИдентификаторТрафика
		ЛЕВОЕ СОЕДИНЕНИЕ РабочиеЛисты КАК РабочиеЛисты
		ПО ПолныйТрафик.Менеджер = РабочиеЛисты.Сотрудник
			И ПолныйТрафик.Клиент = РабочиеЛисты.Клиент

СГРУППИРОВАТЬ ПО
	ПолныйТрафик.Менеджер,
	ПолныйТрафик.ДилерскийЦентр,
	ПолныйТрафик.ТипТрафика,
	ПолныйТрафик.Отдел,
	ПолныйТрафик.Обработан,
	ПолныйТрафик.ПервичныйПовторный,
	ЕСТЬNULL(УпущенныйТрафик.Причина, ЗНАЧЕНИЕ(Справочник.CRM_ПричиныУпущенныхКлиентов.ПустаяСсылка))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Результат.Менеджер КАК Менеджер,
	Результат.ДилерскийЦентр КАК ДилерскийЦентр,
	Результат.ТипТрафика КАК ТипТрафика,
	Результат.Отдел КАК Отдел,
	Результат.Обработан КАК Обработан,
	Результат.ПервичныйПовторный КАК ПервичныйПовторный,
	Результат.Причина,
	СУММА(Результат.ПервичныйТрафик) КАК ПервичныйТрафик,
	СУММА(Результат.ВсеУпущенныеКлиенты) КАК ВсеУпущенныеКлиенты,
	СУММА(Результат.ВсеУпущенныеКлиентыПроцент) КАК ВсеУпущенныеКлиентыПроцент,
	СУММА(Результат.УпущенныеКлиентыРесепшн) КАК УпущенныеКлиентыРесепшн,
	СУММА(Результат.УпущенныеКлиентыРесепшнПроцент) КАК УпущенныеКлиентыРесепшнПроцент,
	СУММА(Результат.УпущенныеКлиентыМенеджер) КАК УпущенныеКлиентыМенеджер,
	СУММА(Результат.УпущенныеКлиентыМенеджерПроцент) КАК УпущенныеКлиентыМенеджерПроцент,
	0 КАК ЗакрытыеРЛНеПоПричинеПродажи
ИЗ
	Результат КАК Результат

СГРУППИРОВАТЬ ПО
	Результат.Менеджер,
	Результат.ДилерскийЦентр,
	Результат.ТипТрафика,
	Результат.Отдел,
	Результат.Обработан,
	Результат.ПервичныйПовторный,
	Результат.Причина

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	РабочиеЛисты.Сотрудник,
	РабочиеЛисты.ДилерскийЦентр,
	РабочиеЛисты.ТипТрафика,
	РабочиеЛисты.Отдел,
	ИСТИНА,
	ЗНАЧЕНИЕ(Перечисление.CRM_ПервичныйПовторный.Первичный),
	РабочиеЛисты.ПричинаЗакрытия,
	0,
	0,
	0,
	0,
	0,
	0,
	0,
	СУММА(1)
ИЗ
	Документ.Renault_РабочийЛист КАК РабочиеЛисты
ГДЕ
	РабочиеЛисты.ДатаID МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И РабочиеЛисты.ПричинаЗакрытия &lt;&gt; ЗНАЧЕНИЕ(Справочник.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа)
	И РабочиеЛисты.ЛистЗакрыт = ИСТИНА

СГРУППИРОВАТЬ ПО
	РабочиеЛисты.Сотрудник,
	РабочиеЛисты.ДилерскийЦентр,
	РабочиеЛисты.ТипТрафика,
	РабочиеЛисты.Отдел,
	РабочиеЛисты.ПричинаЗакрытия</query>
	</dataSet>
	<totalField>
		<dataPath>ПервичныйТрафик</dataPath>
		<expression>Сумма(ПервичныйТрафик)</expression>
	</totalField>
	<totalField>
		<dataPath>ВсеУпущенныеКлиенты</dataPath>
		<expression>Сумма(ВсеУпущенныеКлиенты)</expression>
	</totalField>
	<totalField>
		<dataPath>ВсеУпущенныеКлиентыПроцент</dataPath>
		<expression>Сумма(ВсеУпущенныеКлиенты)/ВЫБОР КОГДА Сумма(ПервичныйТрафик) = 0 ТОГДА 1 ИНАЧЕ Сумма(ПервичныйТрафик) КОНЕЦ *100</expression>
	</totalField>
	<totalField>
		<dataPath>ВсеУпущенныеКлиентыПроцент</dataPath>
		<expression>Сумма(ВсеУпущенныеКлиенты)/ВЫБОР КОГДА Сумма(ПервичныйТрафик) = 0 ТОГДА 1 ИНАЧЕ Сумма(ПервичныйТрафик) КОНЕЦ *100</expression>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>УпущенныеКлиентыРесепшн</dataPath>
		<expression>Сумма(УпущенныеКлиентыРесепшн)</expression>
	</totalField>
	<totalField>
		<dataPath>УпущенныеКлиентыРесепшнПроцент</dataPath>
		<expression>Сумма(УпущенныеКлиентыРесепшн)/ВЫБОР КОГДА Сумма(ПервичныйТрафик) = 0 ТОГДА 1 ИНАЧЕ Сумма(ПервичныйТрафик) КОНЕЦ *100</expression>
	</totalField>
	<totalField>
		<dataPath>УпущенныеКлиентыРесепшнПроцент</dataPath>
		<expression>Сумма(УпущенныеКлиентыРесепшн)/ВЫБОР КОГДА Сумма(ПервичныйТрафик) = 0 ТОГДА 1 ИНАЧЕ Сумма(ПервичныйТрафик) КОНЕЦ *100</expression>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>УпущенныеКлиентыМенеджер</dataPath>
		<expression>Сумма(УпущенныеКлиентыМенеджер)</expression>
	</totalField>
	<totalField>
		<dataPath>УпущенныеКлиентыМенеджерПроцент</dataPath>
		<expression>Сумма(УпущенныеКлиентыМенеджер)/ВЫБОР КОГДА Сумма(ПервичныйТрафик) = 0 ТОГДА 1 ИНАЧЕ Сумма(ПервичныйТрафик) КОНЕЦ *100</expression>
	</totalField>
	<totalField>
		<dataPath>УпущенныеКлиентыМенеджерПроцент</dataPath>
		<expression>Сумма(УпущенныеКлиентыМенеджер)/ВЫБОР КОГДА Сумма(ПервичныйТрафик) = 0 ТОГДА 1 ИНАЧЕ Сумма(ПервичныйТрафик) КОНЕЦ *100</expression>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>ЗакрытыеРЛНеПоПричинеПродажи</dataPath>
		<expression>Сумма(ЗакрытыеРЛНеПоПричинеПродажи)</expression>
	</totalField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
