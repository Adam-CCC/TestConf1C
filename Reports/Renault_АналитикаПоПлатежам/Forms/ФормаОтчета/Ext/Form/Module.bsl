
&НаКлиенте
Процедура Печать(Команда)
	
	ТабДок = ПечатьОтчета();
	ТабДок.Показать();
КонецПроцедуры

&НаСервере
Функция ПечатьОтчета();
	//ОтчетОбъект =  РеквизитФормыВЗначение("Отчет");
	//
	//ОтчетОбъект.НапечататьТОРГ16();
	
	ДопКолонка = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	Если ДопКолонка = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
		ТоварКод = "Артикул";
	Иначе
		ТоварКод = "Код";
	КонецЕсли;
    Решение = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(3).Значение.Ссылка;
	//Склад   = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(2).Значение.Ссылка;
	Склады  = Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(2).Значение;		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОбороты.Регистратор.Ссылка,
	|	ТоварыНаСкладахОбороты.Регистратор.Дата КАК ДатаСписанияТовара,
	|	ТоварыНаСкладахОбороты.Номенклатура КАК НоменклатураРегистр,
	|	ТоварыНаСкладахОбороты.КоличествоРасход КАК Количество,
	|	ТоварыНаСкладахОбороты.Склад,
	|	ТоварыНаСкладахОбороты.Склад.Территория,
	|	пацРекламация.ПодтвержденнаяСумма КАК Стоимость,
	|	пацРекламация.Решение,
	|	пацРекламация.Организация КАК Организация,
	|	пацРекламация.Организация КАК Руководители,
	|	пацРекламация.ТипРекламации КАК ПризнакиПониженияКачестваНаименование,
	|	ТребованиеНакладнаяМатериалы.ЕдиницаИзмерения КАК ЕдиницаИзмеренияНаименование,
	|	ТребованиеНакладнаяМатериалы.ЕдиницаИзмерения.ЕдиницаПоКлассификатору,
	|	ТребованиеНакладнаяМатериалы.Номенклатура КАК Номенклатура,
	|	ТребованиеНакладнаяМатериалы.Номенклатура.Артикул КАК ТоварКод,
	|	ТоварыНаСкладахОбороты.Номенклатура.НаименованиеПолное КАК ТоварНаименование,
	|	ТребованиеНакладнаяМатериалы.СерияНоменклатуры КАК Серия,
	|	ТребованиеНакладнаяМатериалы.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ТребованиеНакладнаяМатериалы.ЕдиницаИзмерения.ЕдиницаПоКлассификатору.Код КАК ЕдиницаИзмеренияКодПоОКЕИ,
	|	ТребованиеНакладнаяМатериалы.КоличествоМест КАК КоличествоМест,
	|	ТребованиеНакладнаяМатериалы.ЕдиницаИзмеренияМест КАК ЕдиницаИзмеренияМестНаименование,
	|	ПоступлениеТоваровУслуг.ДатаВходящегоДокумента КАК ТоварнаяНакладнаяДата,
	|	ПоступлениеТоваровУслуг.НомерВходящегоДокумента КАК ТоварнаяНакладнаяНомер,
	|	Константы.ВалютаРегламентированногоУчета
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК ТоварыНаСкладахОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.пацРекламация КАК пацРекламация
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТребованиеНакладная.Материалы КАК ТребованиеНакладнаяМатериалы
	|			ПО пацРекламация.Ссылка = ТребованиеНакладнаяМатериалы.Ссылка.ДокументОснование.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|			ПО пацРекламация.ДокументОснование.Ссылка = ПоступлениеТоваровУслуг.Ссылка
	|		ПО ТоварыНаСкладахОбороты.Регистратор.ДокументОснование.Ссылка = пацРекламация.Ссылка,
	|	Константы КАК Константы
	|ГДЕ
	|	ТоварыНаСкладахОбороты.Регистратор.ДокументОснование ССЫЛКА Документ.пацРекламация
	|	И пацРекламация.Статус = ЗНАЧЕНИЕ(Перечисление.пацСтатусыРекламаций.Закрыто)
	|	И пацРекламация.Решение = &Решение
	|	И ТоварыНаСкладахОбороты.Склад В ИЕРАРХИИ(&Склад)";
	Запрос.УстановитьПараметр("Решение", Решение);
	Запрос.УстановитьПараметр("Склад", Склады);
	Запрос.УстановитьПараметр("СтатусРекламации", Перечисления.пацСтатусыРекламаций.Закрыто);
	Запрос.УстановитьПараметр("НачалоПериода", Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(0).Значение.Дата);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Получить(1).Значение.Дата));

	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();

Если НЕ Запрос.Выполнить().Пустой() Тогда
		
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = Отчеты.Renault_ОтчетПоРекламационнымСписаниям.ПолучитьМакет("ТОРГ16");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	// Выводим общие реквизиты шапки
	ОписаниеОрганизации = Renault_УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Шапка.Организация, ТекущаяДата());
	ОбластьШапка.Параметры.ДатаДокумента            = КонецМесяца(ДобавитьМесяц(ТекущаяДата(),(-1)));
	
	Если Решение = Справочники.пацРешенияАФМПоРекламациям.Отказ_СтоимостьМенее500 Тогда
		 ОбластьШапка.Параметры.НомерДокумента           = 1;
	ИначеЕсли Решение = Справочники.пацРешенияАФМПоРекламациям.Отказ_ПоРезультатамАФМ Тогда
		 ОбластьШапка.Параметры.НомерДокумента           = 2;
	ИначеЕсли Решение = Справочники.пацРешенияАФМПоРекламациям.ПоложительноеРешениеСкидки Тогда
		 ОбластьШапка.Параметры.НомерДокумента           = 3;
	ИначеЕсли Решение = Справочники.пацРешенияАФМПоРекламациям.ТОРГ2 Тогда
		 ОбластьШапка.Параметры.НомерДокумента           = 4;
	КонецЕсли;
	 

	
	ОбластьШапка.Параметры.ПредставлениеОрганизации = Renault_AdvancedКлиент.ОписаниеОрганизации(ОписаниеОрганизации);
	ОбластьШапка.Параметры.ОрганизацияПоОКПО        = ОписаниеОрганизации.КодПоОКПО;

	Руководители = Renault_Advanced_РегламентированнаяОтчетность.ОтветственныеЛицаОрганизации(Шапка.Руководители,ТекущаяДата(),);
	Руководитель = Руководители.Руководитель;
	Бухгалтер    = Руководители.ГлавныйБухгалтер;
	ОбластьШапка.Параметры.ФИОРуководителя = Руководитель;

	ТабДок.Вывести(ОбластьШапка);
	
	
	СтрокНаСтранице = 23;
	СтрокШапки      = 11;
	СтрокПодвала    = 0;
	НомерСтраницы   = 1;
	Ном             = 0;

	КоличествоСтрок    = Шапка.Количество();

	Если КоличествоСтрок = 1 Тогда
		ПереноситьПоследнююСтроку = 0;
	Иначе
		ЦелыхСтраницСПодвалом     = Цел((СтрокШапки + КоличествоСтрок + СтрокПодвала) / СтрокНаСтранице);
		ЦелыхСтраницБезПодвала    = Цел((СтрокШапки + КоличествоСтрок - 1) / СтрокНаСтранице);
		ПереноситьПоследнююСтроку = ЦелыхСтраницСПодвалом - ЦелыхСтраницБезПодвала;
	КонецЕсли;

	// Выводим заголовок таблицы
	ЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицыПервогоЛиста");
	ТабДок.Вывести(ЗаголовокТаблицы);

	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаПервогоЛиста");

	// Товары
	Шапка.Сбросить();
	Пока Шапка.Следующий() Цикл

		Если НЕ ЗначениеЗаполнено(Шапка.Номенклатура) Тогда
			Сообщить("В одной из строк не заполнено значение номенклатуры - строка при печати пропущена.", СтатусСообщения.Важное);
			Продолжить;
		КонецЕсли;

		Ном = Ном + 1;

		//Начинаем новую страницу, если предыдущая строка была последней на странице
		//или пора переносить последнюю строку на последнюю страницу с подвалом.
		ЦелаяСтраница = (СтрокШапки + Ном - 1) / СтрокНаСтранице;
		Если (ЦелаяСтраница = Цел(ЦелаяСтраница))
		 или ((ПереноситьПоследнююСтроку = 1) и (Ном = КоличествоСтрок)) Тогда

			ИтогоСтоимостьПоСтранице = 0;
			НомерСтраницы            = НомерСтраницы + 1;
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			ТабДок.Вывести(ЗаголовокТаблицы);
		КонецЕсли;

		ОбластьМакета.Параметры.Заполнить(Шапка);
		ОбластьМакета.Параметры.ДатаПоступленияТовара = Шапка.ТоварнаяНакладнаяДата;
		

		ТабДок.Вывести(ОбластьМакета);
	КонецЦикла;
	
	СтрокНаСтранице = 27;
	СтрокШапки      = 5;
	СтрокПодвала    = 11;
	НомерСтраницы   = 1;
	Ном             = 0;

	ТабДок.ВывестиГоризонтальныйРазделительСтраниц();

	НомерСтраницы                            = НомерСтраницы + 1;
	ЗаголовокТаблицы                         = Макет.ПолучитьОбласть("ЗаголовокТаблицыВторогоЛиста");
	ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы; 
	ТабДок.Вывести(ЗаголовокТаблицы);

	Если КоличествоСтрок = 1 Тогда
		ПереноситьПоследнююСтроку = 0;
	Иначе
		ЦелыхСтраницСПодвалом     = Цел((СтрокШапки + КоличествоСтрок + СтрокПодвала) / СтрокНаСтранице);
		ЦелыхСтраницБезПодвала    = Цел((СтрокШапки + КоличествоСтрок - 1) / СтрокНаСтранице);
		ПереноситьПоследнююСтроку = ЦелыхСтраницСПодвалом - ЦелыхСтраницБезПодвала;
	КонецЕсли;

	ИтогоСтоимость = 0;

	// Выводим многострочную часть докмента
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаВторогоЛиста");

	// Товары
	Шапка.Сбросить();
	
	Пока Шапка.Следующий() Цикл

		Если НЕ ЗначениеЗаполнено(Шапка.Номенклатура) Тогда
			Сообщить("В одной из строк не заполнено значение номенклатуры - строка при печати пропущена.", СтатусСообщения.Важное);
			
		КонецЕсли;

		Ном = Ном + 1;

		//Начинаем новую страницу, если предыдущая строка была последней на странице
		//или пора переносить последнюю строку на последнюю страницу с подвалом.
		ЦелаяСтраница = (СтрокШапки + Ном - 1) / СтрокНаСтранице;
		
		Если (ЦелаяСтраница = Цел(ЦелаяСтраница))
		 или ((ПереноситьПоследнююСтроку = 1) и (Ном = КоличествоСтрок)) Тогда

			ИтогоСтоимостьПоСтранице = 0;
			НомерСтраницы            = НомерСтраницы + 1;
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			ЗаголовокТаблицы.Параметры.НомерСтраницы = "Страница " + НомерСтраницы;
			ТабДок.Вывести(ЗаголовокТаблицы);
		КонецЕсли;
	
		ОбластьМакета.Параметры.Заполнить(Шапка);
        ОбластьМакета.Параметры.ТоварКод = СокрЛП(Шапка.ТоварКод);
		КоличествоМест = Формат(Шапка.Количество, "ЧЦ=15; ЧДЦ=3");

		//Если Шапка.КоличествоМест <> 0 И ЗначениеЗаполнено(Шапка.ЕдиницаИзмеренияМестНаименование) Тогда
		//	КоличествоМест = КоличествоМест 
		//					 + Символы.ПС
		//					 + " (" + Формат(Шапка.КоличествоМест,"ЧЦ=15; ЧДЦ=0")
		//					 + " "
		//					 + Шапка.ЕдиницаИзмеренияМестНаименование
		//					 + ")";
		//КонецЕсли;

		ОбластьМакета.Параметры.КоличествоМест    = КоличествоМест;
		ОбластьМакета.Параметры.ТоварНаименование = Строка(Шапка.Номенклатура); //+ ФормированиеПечатныхФорм.ПредставлениеСерий(Шапка);
		//МассаНетто                                = ВыборкаСтрокТовары.МассаОдногоМеста * ВыборкаСтрокТовары.КоличествоМест;
		//ОбластьМакета.Параметры.МассаНетто        = МассаНетто;
        ОбластьМакета.Параметры.Стоимость         = Шапка.Стоимость;
		ОбластьМакета.Параметры.Цена              = Шапка.Стоимость/Шапка.Количество;
		
		
		ТабДок.Вывести(ОбластьМакета);

		// Обновим итоги по документу
		ИтогоСтоимость = ИтогоСтоимость + Шапка.Стоимость;
	КонецЦикла;

   // Выводим итоги по документу в общем
	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	ОбластьМакета.Параметры.Итого = ИтогоСтоимость;
	ТабДок.Вывести(ОбластьМакета);

	// Выводим подвал документа
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.Заполнить(Шапка); 	
	

	ОбластьМакета.Параметры.СуммаСписанияПрописью = ЧислоПрописью(Цел(ИтогоСтоимость), "L=ru_RU;НП=Ложь", "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
	ОбластьМакета.Параметры.СуммаСписанияКопейки  = Строка(?((ИтогоСтоимость- Цел(ИтогоСтоимость))*Pow(10,2)<>0,(ИтогоСтоимость- Цел(ИтогоСтоимость))*Pow(10,2), "00"));
	ТабДок.Вывести(ОбластьМакета);

	// Зададим параметры макета
	ТабДок.ПолеСверху = 0;
	ТабДок.ПолеСлева  = 0;
	ТабДок.ПолеСнизу  = 0;
	ТабДок.ПолеСправа = 0;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

	//ТабДок.Показать();
	
	Возврат ТабДок;
Иначе
	Сообщить("Не найдено ни одного документа!");
		
КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не Renault_РаботаСПравамиПользователя.ЕстьПравоОткрытияПодсистемыСтрахования(ПараметрыСеанса.Пользователь) тогда
		Сообщить("Недостаточно прав доступа.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
КонецПроцедуры


