	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "ОфертаТрейдИн"; НоваяСтрока.Новое= "Оферта Trade-in";	
	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "ПодразделениеКомпании"; НоваяСтрока.Новое= "Подразделение";	
