	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "ПредпочтенияПоКоробкеПередач"; НоваяСтрока.Новое= "Предпочтения по КПП";	
	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "ПредпочтенияПоЦветам"; НоваяСтрока.Новое= "Предпочтения по цветам";	
	НоваяСтрока		= тзПредставлений.Добавить();
	//НоваяСтрока.Старое= "ПредыдущийАвтомобиль"; НоваяСтрока.Новое= "Предыдущий автомобиль";
	НоваяСтрока		= тзПредставлений.Добавить();
