// Стандартная процедура настройки построителя отчета 
//
// Параметры
//  ИмяМакета  – строка – название макета
//  ИмяМакетаПараметров  – строка – название макета параметров
//
Процедура ЗаполнитьНачальныеНастройки(ИмяМакета) Экспорт
	
	ДокументСсылка		= Документы.РабочийЛист.ПустаяСсылка();
	МетаданныеОбъекта	= ДокументСсылка.Метаданные();
	ТекДата				= ТекущаяДата();
	
	НаименованиеОтчета = "Печать документа ";
		
	Текст	= "ВЫБРАТЬ
	     	  |	РабочийЛист.Ссылка												КАК Ссылка,
			  |	МАКСИМУМ(СледующиеСобытия.ДатаНачала) 							КАК ДатаПланируемогоКонтакта,
			  |	МАКСИМУМ(РАЗНОСТЬДАТ(ЕстьNULL(СледующиеСобытия.ДатаНачала, &ПустаяДата), &ТекущаяДата, ДЕНЬ)) КАК ДнейПросрочено
			  |
	     	  |{ВЫБРАТЬ
			  |	Ссылка.*						КАК Ссылка,
	     	  |	Номер							КАК Номер,
