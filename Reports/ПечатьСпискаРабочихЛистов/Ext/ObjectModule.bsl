	НоваяСтрока.Старое= "РуководительПродавца"; НоваяСтрока.Новое= "Руководитель продавца";	
	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "СуммаДокумента"; НоваяСтрока.Новое= "Сумма документа";	
	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "ЮридическоеЛицо"; НоваяСтрока.Новое= "Юр. лицо";
	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "ТрейдИн"; НоваяСтрока.Новое= "Trade-in";	
	
	Для Каждого ТекСтрока Из тзПредставлений Цикл
		НайденнаяСтрока 	= ПостроительОтчета.ВыбранныеПоля.Найти(ТекСтрока.Старое);
		Если НайденнаяСтрока<>Неопределено Тогда
			НайденнаяСтрока.Представление	= ТекСтрока.Новое;
		КонецЕсли;
	КонецЦикла;
		
