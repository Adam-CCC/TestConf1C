	НоваяСтрока.Старое= "ПробегТрейдИн"; НоваяСтрока.Новое= "Пробег Trade-in";	
	НоваяСтрока		= тзПредставлений.Добавить();
	НоваяСтрока.Старое= "ПрочиеУслуги"; НоваяСтрока.Новое= "Прочие услуги";	
