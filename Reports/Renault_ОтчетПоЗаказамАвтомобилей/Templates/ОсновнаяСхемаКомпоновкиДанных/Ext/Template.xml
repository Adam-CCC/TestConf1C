		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказыАвтомобилейОбороты.Заказ,
	ЗаказыАвтомобилейОбороты.Заказ.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ЗаказыАвтомобилейОбороты.Заказ.Менеджер КАК Менеджер,
	ЗаказыАвтомобилейОбороты.ПериодМесяц,
	ЗаказыАвтомобилейОбороты.ПериодДень,
	ЗаказыАвтомобилейОбороты.КоличествоОборот КАК Количество,
	ВЫБОР
		КОГДА ЗаказыАвтомобилейОбороты.Заказ.Модель В ИЕРАРХИИ (&amp;BuiltUp)
			ТОГДА ЗаказыАвтомобилейОбороты.КоличествоОборот
		ИНАЧЕ 0
	КОНЕЦ КАК BuiltUp,
	ВЫБОР
		КОГДА ЗаказыАвтомобилейОбороты.Заказ.Модель В ИЕРАРХИИ (&amp;SR)
			ТОГДА ЗаказыАвтомобилейОбороты.КоличествоОборот
		ИНАЧЕ 0
	КОНЕЦ КАК SR,
	ВЫБОР
		КОГДА ЗаказыАвтомобилейОбороты.Заказ.Модель В ИЕРАРХИИ (&amp;J)
			ТОГДА ЗаказыАвтомобилейОбороты.КоличествоОборот
		ИНАЧЕ 0
	КОНЕЦ КАК J,
	ВЫБОР
		КОГДА ЗаказыАвтомобилейОбороты.Заказ.Модель В ИЕРАРХИИ (&amp;T)
			ТОГДА ЗаказыАвтомобилейОбороты.КоличествоОборот
		ИНАЧЕ 0
	КОНЕЦ КАК T,
	ЗаказыАвтомобилейОбороты.Регистратор КАК Регистратор,
	ЗаказыАвтомобилейОбороты.Автомобиль.VIN КАК VIN,
	ЗаказыАвтомобилейОбороты.Заказ.Модель КАК Модель,
	ЗаказыАвтомобилейОбороты.Заказ.Контрагент КАК Контрагент,
	ЗаказыАвтомобилейОбороты.Регистратор.ХозОперация КАК ХозОперация,
	//ВЫБОР
	//	КОГДА ЗаказыАвтомобилейОбороты.Заказ.Утилизация = 1
	//		ТОГДА 1
	//	ИНАЧЕ 0
	//КОНЕЦ КАК КоличествоУтиль,
	0 КоличествоУтиль,
	//ВЫБОР
	//	КОГДА ЗаказыАвтомобилейОбороты.Заказ.Утилизация = 2
	//		ТОГДА 1
	//	ИНАЧЕ 0
	//КОНЕЦ КАК КоличествоУтильTrade
	0 КоличествоУтильTrade
ПОМЕСТИТЬ ТЗЗаказов
ИЗ
	РегистрНакопления.ЗаказыАвтомобилей.Обороты(&amp;НачДата, &amp;КонДата, Авто, ) КАК ЗаказыАвтомобилейОбороты
ГДЕ
	(ЗаказыАвтомобилейОбороты.Регистратор ССЫЛКА Документ.ЗаказНаАвтомобиль
			ИЛИ ЗаказыАвтомобилейОбороты.Регистратор ССЫЛКА Документ.СнятиеРезервовАвтомобилей)
	//И НЕ ЕСТЬNULL(ЗаказыАвтомобилейОбороты.Регистратор.Перезаказ, ЛОЖЬ)

ИНДЕКСИРОВАТЬ ПО
	Регистратор,
	VIN,
	Контрагент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТЗЗаказов.Заказ КАК Заказ,
	ТЗЗаказов.ПодразделениеКомпании,
	ТЗЗаказов.Менеджер,
	ТЗЗаказов.ПериодМесяц,
	ТЗЗаказов.ПериодДень,
	ТЗЗаказов.Количество,
	ТЗЗаказов.BuiltUp,
	ТЗЗаказов.SR,
	ТЗЗаказов.J,
	ТЗЗаказов.T,
	ТЗЗаказов.Регистратор,
	ЕСТЬNULL(ЗапросПоОстаткам.НаПТС, ЛОЖЬ) КАК НаПТС,
	ТЗЗаказов.Модель,
	ЗапросПоСправочнику.Автомобиль,
	ЗапросПоСправочнику.Статус,
	ТЗЗаказов.Контрагент,
	ТЗЗаказов.ХозОперация,
	ТЗЗаказов.КоличествоУтиль,
	ТЗЗаказов.КоличествоУтильTrade,
	ЗапросПоВзаиморасчетам.СуммаДолга
ИЗ
	ТЗЗаказов КАК ТЗЗаказов
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			МАКСИМУМ(ВЫБОР
					КОГДА ОстаткиАвтомобилей.СтатусПартии = &amp;ТоварКуплен
						ТОГДА ИСТИНА
					ИНАЧЕ ЛОЖЬ
				КОНЕЦ) КАК НаПТС,
			ОстаткиАвтомобилей.Регистратор КАК Регистратор
		ИЗ
			РегистрНакопления.ОстаткиАвтомобилей КАК ОстаткиАвтомобилей
		ГДЕ
			ОстаткиАвтомобилей.Регистратор В
					(ВЫБРАТЬ
						ТЗЗаказов.Регистратор
					ИЗ
						ТЗЗаказов КАК ТЗЗаказов)
		
		СГРУППИРОВАТЬ ПО
			ОстаткиАвтомобилей.Регистратор) КАК ЗапросПоОстаткам
		ПО ТЗЗаказов.Регистратор = ЗапросПоОстаткам.Регистратор
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Автомобили.Ссылка КАК Автомобиль,
			Автомобили.VIN КАК VIN,
			//Автомобили.Статус КАК Статус
			"Статус" Статус
		ИЗ
			Справочник.Автомобили КАК Автомобили
		ГДЕ
			Автомобили.VIN В
					(ВЫБРАТЬ
						ТЗЗаказов.VIN
					ИЗ
						ТЗЗаказов КАК ТЗЗаказов)) КАК ЗапросПоСправочнику
		ПО ТЗЗаказов.VIN = ЗапросПоСправочнику.VIN
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ВзаиморасчетыКомпанииОстатки.Контрагент КАК Контрагент,
			СУММА(ВзаиморасчетыКомпанииОстатки.СуммаОстаток) КАК СуммаДолга
		ИЗ
			РегистрНакопления.ВзаиморасчетыКомпании.Остатки(
					&amp;КонДата,
					Контрагент В
						(ВЫБРАТЬ
							ТЗЗаказов.Контрагент
						ИЗ
							ТЗЗаказов КАК ТЗЗаказов)) КАК ВзаиморасчетыКомпанииОстатки
		
		СГРУППИРОВАТЬ ПО
			ВзаиморасчетыКомпанииОстатки.Контрагент) КАК ЗапросПоВзаиморасчетам
		ПО ТЗЗаказов.Контрагент = ЗапросПоВзаиморасчетам.Контрагент

УПОРЯДОЧИТЬ ПО
	Заказ</query>
