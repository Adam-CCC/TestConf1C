	ЧасыПоГрафику.ПодразделениеСылка,
	ЧасыПоГрафику.ЧасовГрафик,
	ЧасыПоГрафику.ВидДня,
	ЧасыПоГрафику.Дата
ИЗ
	ЧасыПоГрафику КАК ЧасыПоГрафику
		ЛЕВОЕ СОЕДИНЕНИЕ ЧасыОтработанные КАК ЧасыОтработанные
		ПО ЧасыПоГрафику.Дата = ЧасыОтработанные.Дата
			И ЧасыПоГрафику.СотрудникСсылка = ЧасыОтработанные.СотрудникСсылка</query>
	</dataSet>
