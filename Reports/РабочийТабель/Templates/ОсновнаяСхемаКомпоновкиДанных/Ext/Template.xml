		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СУММА(РегистрацияВремениСотрудника.Продолжительность) КАК Продолжительность,
	НАЧАЛОПЕРИОДА(РегистрацияВремениСотрудника.Период, ДЕНЬ) КАК Дата,
	Сотрудники.Ссылка КАК СотрудникСсылка
ПОМЕСТИТЬ ЧасыОтработанные
ИЗ
	Справочник.Сотрудники КАК Сотрудники
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РегистрацияВремениСотрудника КАК РегистрацияВремениСотрудника
		ПО Сотрудники.Ссылка = РегистрацияВремениСотрудника.Сотрудник
ГДЕ
	РегистрацияВремениСотрудника.Период МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И Сотрудники.ФлагУволен = ЛОЖЬ

СГРУППИРОВАТЬ ПО
	НАЧАЛОПЕРИОДА(РегистрацияВремениСотрудника.Период, ДЕНЬ),
	Сотрудники.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1), ГрафикРаботКалендарный.Продолжительность, СЕКУНДА) / 3600 КАК ЧасовГрафик,
	ГрафикРаботКалендарный.ВидДня,
	ГрафикРаботКалендарный.Дата,
	Сотрудники.Ссылка КАК СотрудникСсылка,
	Сотрудники.Наименование КАК Сотрудник,
	Сотрудники.Подразделение КАК ПодразделениеСылка
ПОМЕСТИТЬ ЧасыПоГрафику
ИЗ
	Справочник.Сотрудники КАК Сотрудники
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
		ПО Сотрудники.ГрафикРаботы = ГрафикРаботКалендарный.График
ГДЕ
	ГрафикРаботКалендарный.Дата МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И Сотрудники.ФлагУволен = ЛОЖЬ
;

