		<query>ВЫБРАТЬ
	ПродажиАвтомобилей.Период КАК Дата,
	ПродажиАвтомобилей.Автомобиль,
	ПродажиАвтомобилей.Покупатель,
	ПродажиАвтомобилей.Покупатель.ОсновнойТелефон КАК Телефон,
	ПродажиАвтомобилей.Количество,
	ПродажиАвтомобилей.Автомобиль.Модель КАК Модель,
	ПродажиАвтомобилей.ПодразделениеКомпании КАК Подразделение
ПОМЕСТИТЬ ПродажиЗаПериод
ИЗ
	РегистрНакопления.ПродажиАвтомобилей КАК ПродажиАвтомобилей
ГДЕ
	ПродажиАвтомобилей.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ПродажиАвтомобилей.Регистратор ССЫЛКА Документ.РеализацияАвтомобилей
	И НЕ ПродажиАвтомобилей.Покупатель.НашаФирма
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказНаряд.Автомобиль,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.НомерТО = 1
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ТО1,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.НомерТО = 2
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ТО2,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.НомерТО = 3
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ТО3,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.НомерТО = 4
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ТО4,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.НомерТО = 5
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ТО5,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.НомерТО = 6
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ТО6,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.НомерТО = 7
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ТО7
ПОМЕСТИТЬ ПройденныеТО
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.ДатаЗакрытия &gt; &amp;ДатаНачала
	И ЗаказНаряд.ВидРемонта.ТехОбслуживание
	И ЗаказНаряд.ВидРемонта.ТипРемонта = ЗНАЧЕНИЕ(Перечисление.ТипыРемонта.Платный)
	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.Автомобиль
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПродажиЗаПериод.Дата КАК ДатаПродажи,
	ПродажиЗаПериод.Покупатель,
	ПродажиЗаПериод.Телефон,
	ПродажиЗаПериод.Количество,
	ПродажиЗаПериод.Модель,
	ПродажиЗаПериод.Подразделение,
	ПройденныеТО.ТО1,
	ПройденныеТО.ТО2,
	ПройденныеТО.ТО3,
	ПройденныеТО.ТО4,
	ПройденныеТО.ТО5,
	ПройденныеТО.ТО6,
	ПройденныеТО.ТО7,
	ПродажиЗаПериод.Автомобиль КАК ПроданныйАвтомобиль
ИЗ
	ПродажиЗаПериод КАК ПродажиЗаПериод
		ЛЕВОЕ СОЕДИНЕНИЕ ПройденныеТО КАК ПройденныеТО
		ПО ПродажиЗаПериод.Автомобиль = ПройденныеТО.Автомобиль

УПОРЯДОЧИТЬ ПО
	ДатаПродажи</query>
