<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Документ</dataPath>
			<field>Документ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Тип</dataPath>
			<field>Тип</field>
			<orderExpression>
				<dcscom:expression>Порядок</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>true</dcscom:autoOrder>
			</orderExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Порядок</dataPath>
			<field>Порядок</field>
			<useRestriction>
				<field>true</field>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Подразделение</dataPath>
			<field>Подразделение</field>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.ПодразделенияКомпании</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПредполагаемыйСрок</dataPath>
			<field>ПредполагаемыйСрок</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаПродажи</dataPath>
			<field>СуммаПродажи</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.Сотрудники</v8:Type>
			</valueType>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	Событие.Ссылка КАК Ссылка,
	ВЫБОР
		КОГДА Событие.Контрагент ССЫЛКА Справочник.Контрагенты
			ТОГДА Событие.Контрагент
		КОГДА Контакты.Объект ЕСТЬ NULL 
			ТОГДА Событие.Контрагент
		ИНАЧЕ Контакты.Объект
	КОНЕЦ КАК Контрагент,
	Событие.Дата,
	Событие.Проведен,
	Событие.Продавец,
	Событие.ВидСобытия,
	Событие.ТипСообщения,
	Событие.Состояние
ПОМЕСТИТЬ ВТСобытие
ИЗ
	Документ.Событие КАК Событие
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК Контакты
		ПО (Контакты.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (ВЫБОР
				КОГДА Событие.Контрагент ССЫЛКА Справочник.Контрагенты
					ТОГДА Событие.Контрагент = Контакты.Объект
				ИНАЧЕ Событие.КонтактныйТелефон ПОДОБНО Контакты.Представление
			КОНЕЦ)
ГДЕ
	Событие.Проведен
	И Событие.ВидСобытия &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.Прочее)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	РабочийЛист.Ссылка КАК Ссылка,
	ВЫБОР
		КОГДА РабочийЛист.Контрагент ССЫЛКА Справочник.Контрагенты
			ТОГДА РабочийЛист.Контрагент
		КОГДА Контакты.Объект ЕСТЬ NULL 
			ТОГДА РабочийЛист.Контрагент
		ИНАЧЕ Контакты.Объект
	КОНЕЦ КАК Контрагент,
	РабочийЛист.Дата,
	РабочийЛист.Проведен,
	РабочийЛист.Автомобиль,
	РабочийЛист.Менеджер,
	РабочийЛист.СуммаПродажи,
	РабочийЛист.ПредполагаемыйСрок,
	РабочийЛист.Статус
ПОМЕСТИТЬ ВТРабочийЛист
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК Контакты
		ПО (Контакты.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (ВЫБОР
				КОГДА РабочийЛист.Контрагент ССЫЛКА Справочник.Контрагенты
					ТОГДА РабочийЛист.Контрагент = Контакты.Объект
				ИНАЧЕ РабочийЛист.ПредставлениеТелефона ПОДОБНО Контакты.Представление
			КОНЕЦ)
ГДЕ
	РабочийЛист.Проведен
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТРабочийЛист.Ссылка) КАК Первичные,
	ВТРабочийЛист.Контрагент КАК Контрагент,
	ВТРабочийЛист.Менеджер,
	ВТРабочийЛист.Менеджер.Подразделение
ПОМЕСТИТЬ ВТРабочийЛистДо
ИЗ
	ВТРабочийЛист КАК ВТРабочийЛист
ГДЕ
	ВТРабочийЛист.Дата &lt;= &amp;НачалоПериода
	И ВТРабочийЛист.Проведен

СГРУППИРОВАТЬ ПО
	ВТРабочийЛист.Контрагент,
	ВТРабочийЛист.Менеджер,
	ВТРабочийЛист.Менеджер.Подразделение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТРабочийЛист.Ссылка) КАК Первичные,
	ВТРабочийЛист.Контрагент КАК Контрагент,
	МИНИМУМ(ВТРабочийЛист.Ссылка) КАК Первичный,
	ВТРабочийЛист.Менеджер,
	ВТРабочийЛист.Менеджер.Подразделение
ПОМЕСТИТЬ ВТРабочийЛистТекущие
ИЗ
	ВТРабочийЛист КАК ВТРабочийЛист
ГДЕ
	ВТРабочийЛист.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ВТРабочийЛист.Проведен

СГРУППИРОВАТЬ ПО
	ВТРабочийЛист.Контрагент,
	ВТРабочийЛист.Менеджер,
	ВТРабочийЛист.Менеджер.Подразделение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Контракт.Менеджер КАК Менеджер,
	ВЫБОР
		КОГДА Контракт.Автомобиль.VIN = ""
				ИЛИ Контракт.Автомобиль = ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
			ТОГДА "Контракты без Vin"
		ИНАЧЕ "Контракты с Vin"
	КОНЕЦ КАК Тип,
	Контракт.Ссылка КАК Документ,
	ВЫБОР
		КОГДА Контракт.Автомобиль.VIN = ""
				ИЛИ Контракт.Автомобиль = ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
			ТОГДА "З"
		ИНАЧЕ "К"
	КОНЕЦ КАК Порядок,
	Контракт.Менеджер.Подразделение КАК Подразделение,
	Контракт.СуммаПродажи,
	Контракт.ПредполагаемыйСрок,
	Контракт.Контрагент
ИЗ
	ВТРабочийЛист КАК Контракт
ГДЕ
	Контракт.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И (Контракт.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Сделка)
			ИЛИ Контракт.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Продажа))

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТРабочийЛист.Менеджер,
	"Отказы",
	ВТРабочийЛист.Ссылка,
	"Е",
	ВТРабочийЛист.Менеджер.Подразделение,
	NULL,
	NULL,
	ВТРабочийЛист.Контрагент
ИЗ
	ВТРабочийЛист КАК ВТРабочийЛист
ГДЕ
	ВТРабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.СделкаОтказ)
	И ВТРабочийЛист.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Входящие.Менеджер,
	"Входящие",
	Входящие.Ссылка,
	"А",
	Входящие.Менеджер.Подразделение,
	NULL,
	NULL,
	Входящие.Контрагент
ИЗ
	ВТРабочийЛист КАК Входящие
ГДЕ
	Входящие.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	РабочийЛист.Менеджер,
	ВЫБОР
		КОГДА До.Первичные ЕСТЬ NULL 
				И Текущие.Первичный = РабочийЛист.Ссылка
			ТОГДА "Первичные"
		ИНАЧЕ "Повторные"
	КОНЕЦ,
	РабочийЛист.Ссылка,
	ВЫБОР
		КОГДА До.Первичные ЕСТЬ NULL 
				И Текущие.Первичный = РабочийЛист.Ссылка
			ТОГДА "Б"
		ИНАЧЕ "В"
	КОНЕЦ,
	РабочийЛист.Менеджер.Подразделение,
	NULL,
	NULL,
	РабочийЛист.Контрагент
ИЗ
	ВТРабочийЛист КАК РабочийЛист
		ЛЕВОЕ СОЕДИНЕНИЕ ВТРабочийЛистДо КАК До
		ПО РабочийЛист.Контрагент = До.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ ВТРабочийЛистТекущие КАК Текущие
		ПО РабочийЛист.Контрагент = Текущие.Контрагент
ГДЕ
	РабочийЛист.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТСобытие.Продавец,
	"Тест-драйв",
	ВТСобытие.Ссылка,
	"Д",
	ВТСобытие.Продавец.Подразделение,
	NULL,
	NULL,
	ВТСобытие.Контрагент
ИЗ
	ВТСобытие КАК ВТСобытие
ГДЕ
	ВТСобытие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТестДрайв)
	И ВТСобытие.Ссылка.ДатаНачала МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ВТСобытие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Входящие.Менеджер,
	"ФПК",
	Входящие.Ссылка,
	"Г",
	Входящие.Менеджер.Подразделение,
	NULL,
	NULL,
	Входящие.Контрагент
ИЗ
	ВТРабочийЛист КАК Входящие
ГДЕ
	Входящие.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И Входящие.Статус &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Отказ)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВТСобытие.Продавец,
	"Выдача",
	ВТСобытие.Ссылка,
	"Е",
	ВТСобытие.Продавец.Подразделение,
	NULL,
	NULL,
	ВТСобытие.Контрагент
ИЗ
	ВТСобытие КАК ВТСобытие
ГДЕ
	ВТСобытие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ВыдачаАвтомобиля)
	И ВТСобытие.Ссылка.ДатаНачала МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ВТСобытие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
	И ВТСобытие.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ВТСобытие.Ссылка.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И ВТСобытие.Ссылка.ДокументОснование.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Продажа)</query>
	</dataSet>
	<calculatedField>
		<dataPath>Количество</dataPath>
		<expression>1</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Основной</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Тип</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Количество</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Подразделение</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Справочник.ПодразделенияКомпании.ПустаяСсылка</dcsset:right>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Менеджер</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Справочник.Сотрудники.ПустаяСсылка</dcsset:right>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:dataParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
