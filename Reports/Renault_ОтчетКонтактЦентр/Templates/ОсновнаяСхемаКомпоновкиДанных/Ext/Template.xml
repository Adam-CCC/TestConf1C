		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	МИНИМУМ(Период) КАК ДатаОтвета,
	Renault_ИсторияПерепискиСКлиентом.Объект КАК Лид
ПОМЕСТИТЬ ВремТЗ
ИЗ
	РегистрСведений.Renault_ИсторияПерепискиСКлиентом КАК Renault_ИсторияПерепискиСКлиентом
ГДЕ
	Renault_ИсторияПерепискиСКлиентом.ЭтоОтветДилера = ИСТИНА
СГРУППИРОВАТЬ ПО Renault_ИсторияПерепискиСКлиентом.Объект
;
ВЫБРАТЬ
	Renault_ИсторияПерепискиСКлиентом.Период КАК ДатаОтвета,
	Renault_ИсторияПерепискиСКлиентом.Сообщение КАК ОтветДилера,
	Renault_ИсторияПерепискиСКлиентом.ТипОтветаДилера КАК ТипОтвета,
	Renault_ИсторияПерепискиСКлиентом.Объект КАК Лид
ПОМЕСТИТЬ Врем
ИЗ
	РегистрСведений.Renault_ИсторияПерепискиСКлиентом КАК Renault_ИсторияПерепискиСКлиентом
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТЗ КАК ВремТЗ
		ПО ВремТЗ.ДатаОтвета = Renault_ИсторияПерепискиСКлиентом.Период
		И ВремТЗ.Лид = Renault_ИсторияПерепискиСКлиентом.Объект
;
ВЫБРАТЬ
	Renault_ТрафикСрезПоследних.ТипТрафика,
	Renault_Лид.ДатаПоступления,
	Renault_Лид.ДатаЗаогрузки КАК ДатаЗагрузки,
	Renault_Лид.КритическаяДата,
	Renault_Лид.Приоритет КАК Вероятность,
	Renault_Лид.Теги КАК Категория,
	Renault_Лид.Клиент,
	Renault_Лид.КлиентАдресЭлектроннойПочты,
	Renault_Лид.КлиентМобильныйТелефон,
	Renault_Лид.ДатаЗакрытия,
	Renault_Лид.Менеджер КАК Ответственный,
	Renault_Лид.Модель,
	Renault_Лид.Сообщение,
	Renault_Лид.ДилерскийЦентр.BIR КАК BIR,
	Renault_Лид.ДилерскийЦентр.Бир_ЛМТ КАК BIR_LMT,
	Renault_Лид.ДилерскийЦентр.ОсновнойАдрес КАК Адрес,
	Renault_Лид.ДилерскийЦентр,
	Renault_Лид.ВидУслуги.Тип КАК ТипЛида,
	Renault_Лид.ВидУслуги.Классификация КАК Подтип,
	Renault_Лид.ПримечаниеДилера,
	ВЫБОР
		КОГДА НЕ ТрафикОтвечен.ИдТрафика ЕСТЬ NULL 
			ТОГДА ВЫБОР
					КОГДА Renault_ТрафикСрезПоследних.Закрытый
						ТОГДА "Закрыт"
					ИНАЧЕ "Обработан"
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА Renault_ТрафикСрезПоследних.Закрытый
					ТОГДА "Закрыт"
				ИНАЧЕ ВЫБОР
						КОГДА НЕ(Renault_ТрафикСрезПоследних.Закрытый
										ИЛИ НЕ ТрафикОтвечен.ИдТрафика ЕСТЬ NULL )
								И РАЗНОСТЬДАТ(Renault_Лид.КритическаяДата, &amp;ТекущаяДата, МИНУТА) &gt; 0
							ТОГДА "Просрочен"
						ИНАЧЕ "Новый"
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК Статус,
	ВЫБОР
		КОГДА НЕ ТрафикОтвечен.ИдТрафика ЕСТЬ NULL 
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Отвечен,
	Renault_ТрафикСрезПоследних.Закрытый КАК ЛидЗакрыт,
	Врем.ДатаОтвета,
	Врем.ОтветДилера,
	ВЫБОР КОГДА Врем.ТипОтвета = ЗНАЧЕНИЕ(Перечисление.Renault_ТипыОтветовДилера.Email) ТОГДА
		"по e-mail"
	КОГДА Врем.ТипОтвета = ЗНАЧЕНИЕ(Перечисление.Renault_ТипыОтветовДилера.Телефон) ТОГДА
		"по телефону"
	КОНЕЦ КАК ТипОтвета
ИЗ
	РегистрСведений.Renault_Трафик КАК Renault_ТрафикСрезПоследних
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_Лид КАК Renault_Лид
		ПО (Renault_Лид.ТрафикИД = Renault_ТрафикСрезПоследних.Идентификатор)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			Renault_ТрафикПоСотрудникам.ИдТрафика КАК ИдТрафика
		ИЗ
			РегистрСведений.Renault_ТрафикПоСотрудникам КАК Renault_ТрафикПоСотрудникам
		ГДЕ
			Renault_ТрафикПоСотрудникам.Отвечен = ИСТИНА) КАК ТрафикОтвечен
		ПО Renault_ТрафикСрезПоследних.Идентификатор = ТрафикОтвечен.ИдТрафика
		ЛЕВОЕ СОЕДИНЕНИЕ Врем КАК Врем
		ПО Врем.Лид = Renault_Лид.Ссылка
ГДЕ
	Renault_Лид.ДатаПоступления МЕЖДУ &amp;Дат1 И &amp;Дат2
	И Renault_ТрафикСрезПоследних.ТипТрафика = ЗНАЧЕНИЕ(Справочник.CRM_ТипТрафика.ЛидRenault)
	
ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТрафикПисьма.ТипТрафика,
	ТрафикПисьма.Период,
	ТрафикПисьма.Период,
	"",//Renault_Лид.КритическаяДата,
	"",//Renault_Лид.Приоритет КАК Вероятность,
	"",//Renault_Лид.Теги КАК Категория,
	ТрафикПисьма.Клиент,
	Renault_ТрафикПисьма.ПочтаКлиента,
	"",//Renault_Лид.КлиентМобильныйТелефон,
	"",//Renault_Лид.ДатаЗакрытия,
	ТрафикПисьма.Менеджер,
	"",//Renault_Лид.Модель,
	Renault_ТрафикПисьма.ТекстПисьма,
	ТрафикПисьма.ДилерскийЦентр.BIR,
	ТрафикПисьма.ДилерскийЦентр.Бир_ЛМТ,
	ТрафикПисьма.ДилерскийЦентр.ОсновнойАдрес,
	ТрафикПисьма.ДилерскийЦентр,
	"",//Renault_Лид.ВидУслуги.Тип КАК ТипЛида,
	"",//Renault_Лид.ВидУслуги.Классификация КАК Подтип,
	"",//Renault_Лид.ПримечаниеДилера,
	ВЫБОР
		КОГДА НЕ ТрафикОтвечен.ИдТрафика ЕСТЬ NULL 
			ТОГДА ВЫБОР
					КОГДА ТрафикПисьма.Закрытый
						ТОГДА "Закрыт"
					ИНАЧЕ "Обработан"
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ТрафикПисьма.Закрытый
					ТОГДА "Закрыт"
				ИНАЧЕ ВЫБОР
						КОГДА НЕ(ТрафикПисьма.Закрытый
										ИЛИ НЕ ТрафикОтвечен.ИдТрафика ЕСТЬ NULL )
								//И РАЗНОСТЬДАТ(Renault_Лид.КритическаяДата, &amp;ТекущаяДата, МИНУТА) &gt; 0
							ТОГДА "Просрочен"
						ИНАЧЕ "Новый"
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ,
	ВЫБОР
		КОГДА НЕ ТрафикОтвечен.ИдТрафика ЕСТЬ NULL 
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ,
	ТрафикПисьма.Закрытый,
	"",//Врем.ДатаОтвета,
	"",//Врем.ОтветДилера,
	""//Врем.ТипОтвета
ИЗ
	РегистрСведений.Renault_Трафик КАК ТрафикПисьма
	ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			Renault_ТрафикПоСотрудникам.ИдТрафика КАК ИдТрафика
		ИЗ
			РегистрСведений.Renault_ТрафикПоСотрудникам КАК Renault_ТрафикПоСотрудникам
		ГДЕ
			Renault_ТрафикПоСотрудникам.Отвечен = ИСТИНА) КАК ТрафикОтвечен
		ПО ТрафикПисьма.Идентификатор = ТрафикОтвечен.ИдТрафика
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ТрафикПисьма КАК Renault_ТрафикПисьма
	ПО Renault_ТрафикПисьма.ИдТрафика = ТрафикПисьма.Идентификатор
ГДЕ
	ТрафикПисьма.Период МЕЖДУ &amp;Дат1 И &amp;Дат2
	И ТрафикПисьма.ТипТрафика = ЗНАЧЕНИЕ(Справочник.CRM_ТипТрафика.Email)</query>
	</dataSet>
	<parameter>
		<name>Дат1</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дат1</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>Дат2</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дат2</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ТекущаяДата</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Текущая дата</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
	</parameter>
