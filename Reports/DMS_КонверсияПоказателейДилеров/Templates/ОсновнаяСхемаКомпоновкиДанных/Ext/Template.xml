		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(Статистика.ДатаВыполнения, МЕСЯЦ) КАК Период,
	Статистика.ДилерскийЦентр,
	СУММА(ВЫБОР КОГДА ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.ПосещениеАвтосалона) ТОГДА
		1
		ИНАЧЕ 0 КОНЕЦ) КАК Визиты,
	СУММА(ВЫБОР КОГДА ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.КоммерческоеПредложение) ТОГДА
		1
		ИНАЧЕ 0 КОНЕЦ) КАК КП,
	СУММА(ВЫБОР КОГДА ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.ДКП) ТОГДА
		1
		ИНАЧЕ 0 КОНЕЦ) КАК ДКП,
	СУММА(ВЫБОР КОГДА ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.ВыдачаАвтомобиля) ТОГДА
		1
		ИНАЧЕ 0 КОНЕЦ) КАК Выдачи,
	Статистика.IDK,
	РЛ.IDТрафика
ПОМЕСТИТЬ Врем
ИЗ
	РегистрСведений.Renault_СтатистикаВыполненияЭтаповПродаж КАК Статистика
ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК РЛ
	ПО РЛ.IDK = Статистика.IDK
	И (РЛ.Отдел.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделПродажАвтомобилей)
		ИЛИ РЛ.Отдел.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделКорпоративныхПродаж))
ГДЕ
	ДатаВыполнения &gt;= &amp;ДатаНачала
	И ДатаВыполнения &lt;= &amp;ДатаОкончания
СГРУППИРОВАТЬ ПО 
	НАЧАЛОПЕРИОДА(Статистика.ДатаВыполнения, МЕСЯЦ),
	Статистика.ДилерскийЦентр,
	Статистика.IDK,
	РЛ.IDТрафика
;
//ОБЪЕДИНИТЬ ВСЕ
ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(Трафик.Период, МЕСЯЦ) КАК Период,
	Трафик.ДилерскийЦентр,
	Трафик.Идентификатор,
	Трафик.ТипТрафика
ПОМЕСТИТЬ Врем1
ИЗ
	РегистрСведений.Renault_Трафик КАК Трафик
ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК РЛ
	ПО РЛ.IDТрафика = Трафик.Идентификатор
	И (РЛ.Отдел.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделПродажАвтомобилей)
		ИЛИ РЛ.Отдел.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделКорпоративныхПродаж))
ГДЕ
	Трафик.Период &gt;= &amp;ДатаНачала
	И Трафик.Период &lt;= &amp;ДатаОкончания
	И (Трафик.Отдел.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделПродажАвтомобилей)
	ИЛИ Трафик.Отдел.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделКорпоративныхПродаж))
	//И Трафик.ТипТрафика = ЗНАЧЕНИЕ(Справочник.ТипыТрафика.ПосещениеАвтосалона)
	//И РЛ.IDK ЕСТЬ NULL
;
ВЫБРАТЬ
	Врем1.Период,
	Врем1.ДилерскийЦентр,
	ВЫБОР КОГДА Врем1.ТипТрафика = ЗНАЧЕНИЕ(Справочник.CRM_ТипТрафика.ПосещениеАвтосалона) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК Визиты,
	0 КАК КП,
	0 КАК ДКП,
	0 КАК Выдачи
ПОМЕСТИТЬ Итог
ИЗ Врем1 КАК Врем1
ОБЪЕДИНИТЬ ВСЕ
ВЫБРАТЬ
	Врем.Период,
	Врем.ДилерскийЦентр,
	Врем.Визиты,
	Врем.КП,
	Врем.ДКП,
	Врем.Выдачи
ИЗ Врем КАК Врем
;
ВЫБРАТЬ
	Итог.Период,
	Итог.ДилерскийЦентр,
	Итог.ДилерскийЦентр.DMD КАК DMD,
	Итог.Визиты,
	Итог.КП,
	Итог.ДКП,
	Итог.Выдачи,
	1 КАК ГруппаВсегоЗвонки
ИЗ Итог КАК Итог
ГДЕ Итог.Визиты &lt;&gt; 0 ИЛИ
	Итог.КП &lt;&gt; 0 ИЛИ
	Итог.ДКП &lt;&gt; 0 ИЛИ
	Итог.Выдачи &lt;&gt; 0</query>
