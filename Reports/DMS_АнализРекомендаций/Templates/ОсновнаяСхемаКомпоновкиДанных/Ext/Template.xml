		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПоврежденияАвтомобилей.Регистратор КАК Рекомендация,
	ПоврежденияАвтомобилей.Регистратор.ДилерскийЦентр КАК ДилерскийЦентр,
	ПоврежденияАвтомобилей.Автомобиль КАК Автомобиль,
	ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения КАК РекомендуемаяДатаВыполнения,
	ПоврежденияАвтомобилей.Регистратор.ДилерскийЦентр.DMS_БизнесРегион КАК БизнесРегион,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		ИНАЧЕ ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения
	КОНЕЦ КАК ДатаНачала,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		ИНАЧЕ ДОБАВИТЬКДАТЕ(ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения, ДЕНЬ, &amp;КоличествоДней)
	КОНЕЦ КАК ДатаОкончания,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ДатаУказана,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.Цвет = ЗНАЧЕНИЕ(перечисление.Renault_ЦветаСертификатаКонтроля.Красный)
			ТОГДА "Цвет: 'Красный'"
		КОГДА ПоврежденияАвтомобилей.Цвет = ЗНАЧЕНИЕ(перечисление.Renault_ЦветаСертификатаКонтроля.Желтый)
			ТОГДА "Цвет: 'Желтый'"
		ИНАЧЕ ""
	КОНЕЦ КАК Цвет,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.Работа ССЫЛКА Справочник.Автоработы
				И ПоврежденияАвтомобилей.Работа &lt;&gt; ЗНАЧЕНИЕ(Справочник.Автоработы.ПустаяСсылка)
			ТОГДА ПоврежденияАвтомобилей.Работа.Наименование
		КОГДА ПоврежденияАвтомобилей.Работа ССЫЛКА Справочник.Автоработы
				И ПоврежденияАвтомобилей.Работа = ЗНАЧЕНИЕ(Справочник.Автоработы.ПустаяСсылка)
			ТОГДА "Работа не указана"
		КОГДА ПоврежденияАвтомобилей.Работа = НЕОПРЕДЕЛЕНО
			ТОГДА "Работа не указана"
		ИНАЧЕ ВЫРАЗИТЬ(ПоврежденияАвтомобилей.Работа КАК СТРОКА(200))
	КОНЕЦ КАК РаботаНаименование
ПОМЕСТИТЬ ТаблицаРекомендаций
ИЗ
	РегистрСведений.Renault_ПоврежденияАвтомобилей КАК ПоврежденияАвтомобилей
ГДЕ
	(ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения &gt;= &amp;ДатаНачала
			ИЛИ &amp;ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
	И (ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения &lt;= &amp;ДатаОкончания
			ИЛИ &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	И (ПоврежденияАвтомобилей.Регистратор.ДилерскийЦентр = &amp;ДилерскийЦентр
			ИЛИ &amp;ДилерскийЦентр = ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.ПустаяСсылка))
	И ПоврежденияАвтомобилей.РаботаАктуальна

СГРУППИРОВАТЬ ПО
	ПоврежденияАвтомобилей.Автомобиль,
	ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения,
	ПоврежденияАвтомобилей.Регистратор.ДилерскийЦентр,
	ПоврежденияАвтомобилей.Регистратор.ДилерскийЦентр.DMS_БизнесРегион,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		ИНАЧЕ ДОБАВИТЬКДАТЕ(ПоврежденияАвтомобилей.РекомендуемаяДатаВыполнения, ДЕНЬ, &amp;КоличествоДней)
	КОНЕЦ,
	ПоврежденияАвтомобилей.Регистратор,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.Цвет = ЗНАЧЕНИЕ(перечисление.Renault_ЦветаСертификатаКонтроля.Красный)
			ТОГДА "Цвет: 'Красный'"
		КОГДА ПоврежденияАвтомобилей.Цвет = ЗНАЧЕНИЕ(перечисление.Renault_ЦветаСертификатаКонтроля.Желтый)
			ТОГДА "Цвет: 'Желтый'"
		ИНАЧЕ ""
	КОНЕЦ,
	ВЫБОР
		КОГДА ПоврежденияАвтомобилей.Работа ССЫЛКА Справочник.Автоработы
				И ПоврежденияАвтомобилей.Работа &lt;&gt; ЗНАЧЕНИЕ(Справочник.Автоработы.ПустаяСсылка)
			ТОГДА ПоврежденияАвтомобилей.Работа.Наименование
		КОГДА ПоврежденияАвтомобилей.Работа ССЫЛКА Справочник.Автоработы
				И ПоврежденияАвтомобилей.Работа = ЗНАЧЕНИЕ(Справочник.Автоработы.ПустаяСсылка)
			ТОГДА "Работа не указана"
		КОГДА ПоврежденияАвтомобилей.Работа = НЕОПРЕДЕЛЕНО
			ТОГДА "Работа не указана"
		ИНАЧЕ ВЫРАЗИТЬ(ПоврежденияАвтомобилей.Работа КАК СТРОКА(200))
	КОНЕЦ
;

