	КонтактыСКлиентом.Результат КАК Результат,
	КонтактыСКлиентом.Результат.Действие КАК ТипРезультата,
	КонтактыСКлиентом.КонтактВыполнен КАК КонтактВыполнен
ПОМЕСТИТЬ ИсторияКонтактов
ИЗ
	ТаблицаРекомендаций КАК ТаблицаРекомендаций
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_КонтактСКлиентом КАК КонтактыСКлиентом
		ПО ТаблицаРекомендаций.Автомобиль = КонтактыСКлиентом.Автомобиль
			И (ТаблицаРекомендаций.ДатаУказана)
			И (НЕ КонтактыСКлиентом.ПометкаУдаления)
			И (КонтактыСКлиентом.КонтактВыполнен)
			И (КонтактыСКлиентом.ДатаВыполненияКонтакта &gt;= ТаблицаРекомендаций.ДатаНачала)
			И (КонтактыСКлиентом.ДатаВыполненияКонтакта &lt;= ТаблицаРекомендаций.ДатаОкончания)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаявкиНаСервис.Ссылка КАК ЗаявкаНаСервис,
	ЗаявкиНаСервис.Автомобиль КАК Автомобиль
ПОМЕСТИТЬ ЗаявкиНаСервис
ИЗ
	ТаблицаРекомендаций КАК ТаблицаРекомендаций
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК ЗаявкиНаСервис
		ПО ТаблицаРекомендаций.ДилерскийЦентр = ЗаявкиНаСервис.ДилерскийЦентр
			И ТаблицаРекомендаций.Автомобиль = ЗаявкиНаСервис.Автомобиль
			И (ТаблицаРекомендаций.ДатаУказана)
			И (ЗаявкиНаСервис.ВремяНачала &gt;= ТаблицаРекомендаций.ДатаНачала)
			И (ЗаявкиНаСервис.ВремяНачала &lt;= ТаблицаРекомендаций.ДатаОкончания)
			И (НЕ ЗаявкиНаСервис.ПометкаУдаления)
			И (ЗаявкиНаСервис.Проведен)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказНаряды.Ссылка КАК ЗаказНаряд,
	ЗаказНаряды.Автомобиль КАК Автомобиль
ПОМЕСТИТЬ ЗаказНаряды
ИЗ
	ТаблицаРекомендаций КАК ТаблицаРекомендаций
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряды
		ПО ТаблицаРекомендаций.Автомобиль = ЗаказНаряды.Автомобиль
			И (ТаблицаРекомендаций.ДатаУказана)
			И (ЗаказНаряды.ДатаОкончания &gt;= ТаблицаРекомендаций.ДатаНачала)
			И (ЗаказНаряды.ДатаОкончания &lt;= ДОБАВИТЬКДАТЕ(ТаблицаРекомендаций.ДатаОкончания, ДЕНЬ, 1))
			И (НЕ ЗаказНаряды.ПометкаУдаления)
			И (ЗаказНаряды.Проведен)
ГДЕ
	НЕ ЗаказНаряды.ПометкаУдаления
	И ЗаказНаряды.Проведен
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТаблицаРекомендаций.БизнесРегион КАК БизнесРегион,
	ТаблицаРекомендаций.ДилерскийЦентр КАК ДилерскийЦентр,
	ТаблицаРекомендаций.Автомобиль.VIN КАК VIN,
	0 КАК КоличествоРекомендаций,
	СУММА(ВЫБОР
			КОГДА КонтактПоТелефону.КонтактСКлиентом ЕСТЬ NULL 
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоЗвонков,
	СУММА(ВЫБОР
			КОГДА КонтактПоЭлектроннойПочте.КонтактСКлиентом ЕСТЬ NULL 
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоЭлектронныхПисем,
	СУММА(ВЫБОР
			КОГДА КонтактЧерезСМС.КонтактСКлиентом ЕСТЬ NULL 
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоСМС,
	СУММА(ВЫБОР
			КОГДА ЗаявкиНаСервис.ЗаявкаНаСервис ЕСТЬ NULL 
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоЗаявокНаСервис,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряды.ЗаказНаряд ЕСТЬ NULL 
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоЗаказНарядов,
	СУММА(ЕСТЬNULL(ЗаказНаряды.ЗаказНаряд.СуммаНоменклатурыДокумента, 0)) КАК СуммаТоваров,
	СУММА(ЕСТЬNULL(ЗаказНаряды.ЗаказНаряд.СуммаРаботДокумента, 0)) КАК СуммаРабот,
	СУММА(ЕСТЬNULL(ЗаказНаряды.ЗаказНаряд.СуммаДокумента, 0)) КАК СуммаДокумента,
	ТаблицаРекомендаций.Рекомендация КАК Рекомендация,
	ТаблицаРекомендаций.Автомобиль КАК Автомобиль,
	ТаблицаРекомендаций.РекомендуемаяДатаВыполнения КАК РекомендуемаяДатаВыполнения,
	ТаблицаРекомендаций.ДатаНачала КАК ДатаНачала,
	ТаблицаРекомендаций.ДатаОкончания КАК ДатаОкончания,
	ТаблицаРекомендаций.ДатаУказана КАК ДатаУказана,
	0 КАК КоличествоVIN,
	ЕСТЬNULL(ТаблицаРекомендаций.РаботаНаименование, "") + ВЫБОР
		КОГДА ТаблицаРекомендаций.Цвет = ""
			ТОГДА ""
		ИНАЧЕ ", " + ТаблицаРекомендаций.Цвет
	КОНЕЦ + ", рекомендуемая дата выполнения: " КАК ПредставлениеРекомендации,
	ТаблицаРекомендаций.ДилерскийЦентр.BIR КАК BIR
ИЗ
	ТаблицаРекомендаций КАК ТаблицаРекомендаций
		ЛЕВОЕ СОЕДИНЕНИЕ ИсторияКонтактов КАК КонтактПоТелефону
		ПО (ТаблицаРекомендаций.Автомобиль = КонтактПоТелефону.Автомобиль
					И КонтактПоТелефону.КонтактВыполнен
					И (КонтактПоТелефону.ТипРезультата = ЗНАЧЕНИЕ(Перечисление.Renault_ДействияРезультатов.ОтметитьТелефонНеверным)
				ИЛИ КонтактПоТелефону.ТипРезультата = ЗНАЧЕНИЕ(Перечисление.Renault_ДействияРезультатов.БольшеНеБеспокоитьКлиента)
				ИЛИ КонтактПоТелефону.ТипРезультата = ЗНАЧЕНИЕ(Перечисление.Renault_ДействияРезультатов.ПерезвонитьПозже)
				ИЛИ КонтактПоТелефону.ТипРезультата = ЗНАЧЕНИЕ(Перечисление.Renault_ДействияРезультатов.ОкончаниеЗвонка)))
		ЛЕВОЕ СОЕДИНЕНИЕ ИсторияКонтактов КАК КонтактПоЭлектроннойПочте
		ПО ТаблицаРекомендаций.Автомобиль = КонтактПоЭлектроннойПочте.Автомобиль
			И (КонтактПоЭлектроннойПочте.Результат = ЗНАЧЕНИЕ(Справочник.Renault_РезультатыКампаний.ОтправленоПисьмо))
		ЛЕВОЕ СОЕДИНЕНИЕ ИсторияКонтактов КАК КонтактЧерезСМС
		ПО (КонтактЧерезСМС.Результат = ЗНАЧЕНИЕ(Справочник.Renault_РезультатыКампаний.ОтправленоСМС))
			И ТаблицаРекомендаций.Автомобиль = КонтактЧерезСМС.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ ЗаявкиНаСервис КАК ЗаявкиНаСервис
		ПО ТаблицаРекомендаций.Автомобиль = ЗаявкиНаСервис.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказНаряды КАК ЗаказНаряды
		ПО ТаблицаРекомендаций.Автомобиль = ЗаказНаряды.Автомобиль

СГРУППИРОВАТЬ ПО
