		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоТестДрайваПодтверждено</dataPath>
			<field>КоличествоТестДрайваПодтверждено</field>
		</field>
		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	ТестДрайв.Ссылка КАК Ссылка,
	ТестДрайв.Менеджер КАК Менеджер,
	ТестДрайв.Организация КАК Организация,
	ТестДрайв.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ТестДрайв.Автомобиль КАК Автомобиль,
	ТестДрайв.Контрагент КАК Контрагент,
	ТестДрайв.ПредставлениеТелефона КАК ПредставлениеТелефона,
	ТестДрайв.ПодтвержденияТестДрайва КАК ПодтвержденияТестДрайва,
	ТестДрайв.РезультатТестДрайва КАК РезультатТестДрайва,
	1 КАК КоличествоТестДрайва,
	ВЫБОР
		КОГДА ТестДрайв.ПодтвержденияТестДрайва
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоТестДрайваПодтверждено
{ВЫБРАТЬ
	Ссылка.*,
	Менеджер.*,
	Организация.*,
	ПодразделениеКомпании.*,
	Автомобиль.*,
	Контрагент.*,
	ПредставлениеТелефона,
	ПодтвержденияТестДрайва,
	РезультатТестДрайва.*,
	КоличествоТестДрайва,
	КоличествоТестДрайваПодтверждено}
ИЗ
	Документ.ТестДрайв КАК ТестДрайв
ГДЕ
	ТестДрайв.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И ТестДрайв.Проведен = ИСТИНА</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<calculatedField>
		<dataPath>ПроцентПодтвержденногоТестДрайва</dataPath>
		<expression>КоличествоТестДрайваПодтверждено/КоличествоТестДрайва*100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Процент подтвержденного тест драйва</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="xs:string">ЧДЦ=2</dcscor:value>
			</dcscor:item>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
				<dcscor:value xsi:type="xs:decimal">0</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<totalField>
