				КонецЕсли;			
			Иначе
				ОбластьМакета.Рисунки.Фото.Картинка = Новый Картинка;
			КонецЕсли;				
		Исключение
		КонецПопытки;
		
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		Если СчетчикСтрок >= СтрокНаСтраницу -1 Тогда
			Прервать;
		КонецЕсли;
		
		Если НЕ Выборка.Следующий() Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
