Процедура СформироватьОтчетПриемкаЛада(ТабДокумент) Экспорт 
	
	ДатаОтчета = ТекущаяДата();
	
	МакетОтчета = ПолучитьМакет("МакетПриемкаЛада" + ТипМакета);
	
	ОбластьШапкаТаблицы	= МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьЗаголовкаОбластьШапкаТаблицы= ПромасштабироватьШирину(ОбластьШапкаТаблицы);
	ОбластьШапкаТаблицы.Параметры.Время = Формат(ДатаОтчета, "ДФ = 'Ч.мм'");
	ТабДокумент.Вывести(ОбластьШапкаТаблицы);
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СчетчикСтрок = 0;
	
	ОбластьМакета = МакетОтчета.ПолучитьОбласть("Строка");
	ОбластьМакета = ПромасштабироватьШирину(ОбластьМакета);
	
	ОбластьМакета.Рисунки.ФотоМ.Картинка = Новый Картинка;
	
	//   ОбластьЕстьЗН = МакетОтчета.ПолучитьОбласть("СтрокаЕстьЗН");
	//   ОбластьЕстьЗН = ПромасштабироватьШирину(ОбластьЕстьЗН);
	
	Пока  Истина  Цикл  
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
		Если Выборка.ЕстьЗН Тогда
			//   		ОбластьМакета = ОбластьЕстьЗН;
			//   		ОбластьМакета.Параметры.Статус = Выборка.Статус ;
			//   		ОбластьМакета.Параметры.Мастер = Выборка.ЗаказНаряд.Диспетчер;
			
			Если СчетчикСтрок = 1 Тогда
				ОбластьМакета.Параметры.Клиент0 = Выборка.ЗаказНаряд.Заказчик;
				ОбластьМакета.Параметры.Время0  = Формат(Выборка.Период, "ДФ = 'Ч:мм'");
			ИначеЕсли СчетчикСтрок = 2 Тогда
				ОбластьМакета.Параметры.Клиент1 = Выборка.ЗаказНаряд.Заказчик;			
				ОбластьМакета.Параметры.Время1  = Формат(Выборка.Период, "ДФ = 'Ч:мм'");
			ИначеЕсли СчетчикСтрок = 3 Тогда
				ОбластьМакета.Параметры.Клиент2 = Выборка.ЗаказНаряд.Заказчик;				
				ОбластьМакета.Параметры.Время2  = Формат(Выборка.Период, "ДФ = 'Ч:мм'");
			ИначеЕсли СчетчикСтрок = 4 Тогда
				ОбластьМакета.Параметры.Клиент3 = Выборка.ЗаказНаряд.Заказчик;				
				ОбластьМакета.Параметры.Время3  = Формат(Выборка.Период, "ДФ = 'Ч:мм'");
			ИначеЕсли СчетчикСтрок = 5 Тогда
				ОбластьМакета.Параметры.Клиент4 = Выборка.ЗаказНаряд.Заказчик;				
				ОбластьМакета.Параметры.Время4  = Формат(Выборка.Период, "ДФ = 'Ч:мм'");
			ИначеЕсли СчетчикСтрок = 6 Тогда
				ОбластьМакета.Параметры.Клиент5 = Выборка.ЗаказНаряд.Заказчик;				
