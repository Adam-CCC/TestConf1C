			ОбластьМакета.Параметры.Модель = Выборка.Автомобиль;
		КонецЕсли;
		
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	КартинкиИФайлы.Идентификатор,
		|	КартинкиИФайлы.ИмяФайла,
		|	КартинкиИФайлы.Данные,
		|	КартинкиИФайлы.ДанныеВоВнешнемФайле
		|ИЗ
		|	РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы
		|ГДЕ
		|	КартинкиИФайлы.Объект = &ОбъектИнформации
		|	И КартинкиИФайлы.Картинка = ИСТИНА
		|АВТОУПОРЯДОЧИВАНИЕ");
		
		Попытка
			Запрос.УстановитьПараметр("ОбъектИнформации",?(Выборка.ЗаказНаряд = NULL,Выборка.Заявка.Диспетчер,Выборка.ЗаказНаряд.Диспетчер ));
			РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			Если РезультатЗапроса.Количество()>0 Тогда			
				СтрокаКартинка = РезультатЗапроса[0];
				Если СтрокаКартинка.ДанныеВоВнешнемФайле Тогда
					Если Выборка.ЕстьЗН Тогда
						
						ОбластьМакета.Рисунки.ФотоМ2.Картинка = Новый Картинка(СтрокаКартинка.ИмяФайла,Ложь);	
						
					Иначе
						ОбластьМакета.Рисунки.ФотоМ.Картинка = Новый Картинка(СтрокаКартинка.ИмяФайла,Ложь);
					КонецЕсли;
				Иначе
					Если Выборка.ЕстьЗН Тогда
						
						ОбластьМакета.Рисунки.ФотоМ2.Картинка= Новый Картинка(СтрокаКартинка.Данные.Получить());
					Иначе
						ОбластьМакета.Рисунки.ФотоМ.Картинка= Новый Картинка(СтрокаКартинка.Данные.Получить());
					КонецЕсли;
				КонецЕсли;			
			Иначе
				Если Выборка.ЕстьЗН Тогда
					
					ОбластьМакета.Рисунки.ФотоМ2.Картинка = Новый Картинка;
				Иначе
					ОбластьМакета.Рисунки.ФотоМ.Картинка = Новый Картинка;
					
				КонецЕсли;
			КонецЕсли;				
		Исключение
		КонецПопытки;
		
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		Если СчетчикСтрок >= СтрокНаСтраницу Тогда
			Прервать;
		КонецЕсли;
		
		Если НЕ Выборка.Следующий() Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры     

