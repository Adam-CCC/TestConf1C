		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВыпискаСостав.Ссылка,
	ВыпискаСостав.Контрагент,
	ВыпискаСостав.ДоговорВзаиморасчетов,
	ВыпискаСостав.СуммаПриход КАК СуммаПриходСНДС,
	ВЫБОР
		КОГДА ВыпискаСостав.СуммаПриход &gt; 0
			ТОГДА ВыпискаСостав.СуммаНДС
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаПриходНДС,
	ВЫБОР
		КОГДА ВыпискаСостав.СуммаПриход &gt; 0
			ТОГДА ВыпискаСостав.СуммаПриход - ВыпискаСостав.СуммаНДС
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаПриходБезНДС,
	ВыпискаСостав.СуммаРасход КАК СуммаРасходСНДС,
	ВЫБОР
		КОГДА ВыпискаСостав.СуммаРасход &gt; 0
			ТОГДА ВыпискаСостав.СуммаНДС
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаРасходНДС,
	ВЫБОР
		КОГДА ВыпискаСостав.СуммаРасход &gt; 0
			ТОГДА ВыпискаСостав.СуммаРасход - ВыпискаСостав.СуммаНДС
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаРасходБезНДС,
	ВыпискаСостав.НазначениеПлатежа,
	ВыпискаСостав.Ссылка.Организация,
	ВыпискаСостав.Ссылка.ПодразделениеКомпании,
	ВыпискаСостав.Ссылка.БанковскийСчет
ИЗ
	Документ.Выписка.Состав КАК ВыпискаСостав
ГДЕ
	ВыпискаСостав.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&amp;ДатаНачала, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И ВыпискаСостав.Ссылка.Проведен</query>
