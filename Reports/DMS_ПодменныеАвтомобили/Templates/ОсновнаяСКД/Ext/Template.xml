					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:userSettingID>23d4ff45-af78-4cad-9ac4-3eadd5d1c321</dcsset:userSettingID>
				</dcsset:item>
			</dcsset:filter>
