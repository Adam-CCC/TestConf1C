				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заявка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДилерскийЦентр</dataPath>
			<field>ДилерскийЦентр</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Клиент</dataPath>
			<field>Клиент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>VIN</dataPath>
			<field>VIN</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>VIN</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Длительность</dataPath>
			<field>Длительность</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Статус</dataPath>
			<field>Статус</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПодменныйАвто.Машиноместо.Автомобиль.Модель КАК Автомобиль,
	ПодменныйАвто.Машиноместо.Автомобиль.VIN КАК VIN,
	ПодменныйАвто.Ссылка КАК Ссылка,
	ПодменныйАвто.ДилерскийЦентр КАК ДилерскийЦентр,
	ПодменныйАвто.Клиент КАК Клиент,
	ПодменныйАвто.Длительность КАК Длительность,
	ВЫБОР
		КОГДА ПодменныйАвто.Состояние = ЗНАЧЕНИЕ(Справочник.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка)
			ТОГДА "Запланирован"
		КОГДА ПодменныйАвто.Состояние = ЗНАЧЕНИЕ(Справочник.Renault_ВидыСостоянийДокументовАвтосервиса.ВРаботе)
			ТОГДА "Выдан"
		КОГДА ПодменныйАвто.Состояние = ЗНАЧЕНИЕ(Справочник.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен)
			ТОГДА "Возвращен"
		КОГДА ПодменныйАвто.Состояние = ЗНАЧЕНИЕ(Справочник.Renault_ВидыСостоянийДокументовАвтосервиса.Отмена)
			ТОГДА "Снять бронь"
		ИНАЧЕ "Запланирован"
	КОНЕЦ КАК Статус
ИЗ
	Документ.Renault_CRM_ЗаявкаНаПодменныйАвто КАК ПодменныйАвто
ГДЕ
	ПодменныйАвто.Дата МЕЖДУ &amp;ДатаНач И &amp;ДатаКон</query>
	</dataSet>
	<parameter>
		<name>ДатаНач</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
