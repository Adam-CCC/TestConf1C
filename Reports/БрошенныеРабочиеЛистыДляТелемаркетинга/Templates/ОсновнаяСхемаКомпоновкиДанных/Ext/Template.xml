		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РабочийЛист.Ссылка КАК РабочийЛист,
	РабочийЛист.Менеджер КАК Менеджер,
	РабочийЛист.ПодразделениеКомпании КАК ПодразделениеКомпании,
	РабочийЛист.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	РабочийЛист.Статус КАК Статус,
	РабочийЛист.Дата КАК Дата,
	РабочийЛист.Модель КАК МодельРЛ,
	1 КАК КоличествоБрошенных,
	РабочийЛист.Автор КАК Автор,
	РабочийЛист.ПредставлениеТелефона КАК ПредставлениеТелефона,
	РабочийЛист.Контрагент КАК Контрагент,
	ПоследниеСобытия.МаксДата КАК МаксДата
ПОМЕСТИТЬ ВТ_основная
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Событие.ДокументОснование КАК ДокументОснование,
			МАКСИМУМ(Событие.ДатаНачала) КАК МаксДата
		ИЗ
			Документ.Событие КАК Событие
		
		СГРУППИРОВАТЬ ПО
			Событие.ДокументОснование) КАК ПоследниеСобытия
		ПО РабочийЛист.Ссылка = ПоследниеСобытия.ДокументОснование
ГДЕ
	(РабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Создан)
			ИЛИ РабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Интерес))
	И РабочийЛист.ПометкаУдаления = ЛОЖЬ
	И РабочийЛист.Дата МЕЖДУ &amp;ДатаН И &amp;ДатаК
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Событие.ДокументОснование КАК ДокОсн,
	Событие.Ссылка КАК Событие
ПОМЕСТИТЬ ВТ_Исключения
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)
	И Событие.ДатаНачала &gt; &amp;ДатаК
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Основная.РабочийЛист КАК РабочийЛист,
	"" КАК Событие,
	ВТ_Основная.Дата КАК Дата,
	ВТ_Основная.Статус КАК Статус,
	ВТ_Основная.Менеджер КАК Менеджер,
	ВТ_Основная.КоличествоБрошенных КАК КоличествоДокументов,
	ВТ_Основная.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ВТ_Основная.МодельРЛ КАК МодельРЛ,
	ВТ_Основная.Автор КАК Автор,
	ВТ_Основная.ПредставлениеТелефона КАК ПредставлениеТелефона,
	ВТ_Основная.Контрагент КАК Контрагент,
	ВТ_Основная.МаксДата КАК МаксДата
ИЗ
	ВТ_основная КАК ВТ_Основная
ГДЕ
	НЕ ВТ_Основная.РабочийЛист В
				(ВЫБРАТЬ
					ВТ_Исключения.ДокОсн
				ИЗ
					ВТ_Исключения)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Событие.ДокументОснование,
	Событие.Ссылка,
	Событие.ДатаНачала,
	ДокументыОснования.РЛ.Статус,
	Событие.Продавец,
	1,
	Событие.ПодразделениеКомпании,
	ДокументыОснования.МодельРЛ,
	ДокументыОснования.РЛ.Автор,
	ДокументыОснования.РЛ.ПредставлениеТелефона,
	ДокументыОснования.РЛ.Контрагент,
	ПоследниеСобытия.МаксДата
ИЗ
	Документ.Событие КАК Событие
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			РабочийЛист.Ссылка КАК РЛ,
			РабочийЛист.Модель КАК МодельРЛ
		ИЗ
			Документ.РабочийЛист КАК РабочийЛист
		ГДЕ
			(РабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Создан)
					ИЛИ РабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Интерес))
			И НЕ РабочийЛист.ПометкаУдаления) КАК ДокументыОснования
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				Событие.ДокументОснование КАК ДокументОснование,
				МАКСИМУМ(Событие.ДатаНачала) КАК МаксДата
			ИЗ
				Документ.Событие КАК Событие
			
			СГРУППИРОВАТЬ ПО
				Событие.ДокументОснование) КАК ПоследниеСобытия
			ПО ДокументыОснования.РЛ = ПоследниеСобытия.ДокументОснование
		ПО Событие.ДокументОснование = ДокументыОснования.РЛ
ГДЕ
	Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)
	И Событие.ДатаНачала МЕЖДУ &amp;ДатаН И &amp;ДатаК
	И НЕ Событие.ДокументОснование В
				(ВЫБРАТЬ
					ВТ_основная.РабочийЛист
				ИЗ
					ВТ_основная)</query>
	</dataSet>
