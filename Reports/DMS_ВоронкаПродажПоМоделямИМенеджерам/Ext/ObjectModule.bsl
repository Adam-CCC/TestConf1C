
#Область ФормированиеОтчета

// Формирует табличный документ отчета
// 
// Возвращаемое значение:
//  ТабличныйДокумент - Результат формирования отчета
//
Функция СформироватьОтчет() Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьДилерскийЦентр 	= Макет.ПолучитьОбласть("ДилерскийЦентр");
	ОбластьШапкаТаблицы 	= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьБренд 			= Макет.ПолучитьОбласть("Бренд");
	ОбластьСтрокаМенеджер 	= Макет.ПолучитьОбласть("СтрокаМенеджер");
	ОбластьСтрокаОтдел 		= Макет.ПолучитьОбласть("СтрокаОтдел");
	
	Запрос = ПолучитьЗапросДляОтчета();
	ВыборкаДЦ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДЦ.Следующий() Цикл
		
		ОбластьДилерскийЦентр.Параметры.ДилерскийЦентр = ВыборкаДЦ.ДилерскийЦентр;
		ТабличныйДокумент.Вывести(ОбластьДилерскийЦентр);
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
		
		ВыборкаБренд = ВыборкаДЦ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаБренд.Следующий() Цикл
			
			ОбластьБренд.Параметры.Бренд = ВыборкаБренд.Бренд;
			
			ВыборкаМодели = ВыборкаБренд.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаМодели.Следующий() Цикл
			
				ВыборкаОтделы = ВыборкаМодели.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
				Пока ВыборкаОтделы.Следующий() Цикл
					
					ОбластьСтрокаОтдел.Параметры.Заполнить(ВыборкаОтделы);
					
					ВыборкаМенеджеры = ВыборкаОтделы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаМенеджеры.Следующий() Цикл
						
						ОбластьСтрокаМенеджер.Параметры.Заполнить(ВыборкаМенеджеры);
						ТабличныйДокумент.Вывести(ОбластьСтрокаМенеджер);
						
					КонецЦикла;

					ТабличныйДокумент.Вывести(ОбластьСтрокаОтдел);
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТекМодель = ТабличныйДокумент.Область(5, 1).Текст;
	НачалоМодели = 5;
	
	Для сч = 5 По ТабличныйДокумент.ВысотаТаблицы Цикл
		
		ЭтоДЦ = Лев(ТабличныйДокумент.Область(сч, 1).Текст, 17) = "Дилерский центр: ";
		
		Если ТабличныйДокумент.Область(сч, 1).Текст <> ТекМодель ИЛИ ЭтоДЦ Тогда
			
			ТабличныйДокумент.Область(НачалоМодели, 1, сч - 1, 1).Объединить();
			ТабличныйДокумент.Область(НачалоМодели, 1, сч - 1, 1).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
			ТекМодель = ТабличныйДокумент.Область(сч, 1).Текст; 
			НачалоМодели = сч;
						
		КонецЕсли;
		
		Если ЭтоДЦ Тогда
			сч = сч + 3;
			НачалоМодели = сч;
		КонецЕсли;
		
	КонецЦикла;
	
	ТабличныйДокумент.Область(НачалоМодели, 1, ТабличныйДокумент.ВысотаТаблицы , 1).Объединить();
	ТабличныйДокумент.Область(НачалоМодели, 1, ТабличныйДокумент.ВысотаТаблицы , 1).ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // СформироватьОтчет()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает запрос для формирования отчета
