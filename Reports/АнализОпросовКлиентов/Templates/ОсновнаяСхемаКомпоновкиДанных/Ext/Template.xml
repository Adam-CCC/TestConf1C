<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>ТекстЗапроса</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Категория</dataPath>
			<field>Категория</field>
			<orderExpression>
				<dcscom:expression>Порядок</dcscom:expression>
				<dcscom:orderType>Asc</dcscom:orderType>
				<dcscom:autoOrder>false</dcscom:autoOrder>
			</orderExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОпрашиваемоеЛицо</dataPath>
			<field>ОпрашиваемоеЛицо</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СреднийБалл</dataPath>
			<field>СреднийБалл</field>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧДЦ=2</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТиповаяАнкета</dataPath>
			<field>ТиповаяАнкета</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Порядок</dataPath>
			<field>Порядок</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	Опрос.ОпрашиваемоеЛицо КАК ОпрашиваемоеЛицо,
	СУММА(ЕСТЬNULL(ВариантыОтветовОпросов.ОценкаОтвета, 0)) КАК КоличествоБаллов,
	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(ВариантыОтветовОпросов.ОценкаОтвета, 0) = 0
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоОтветов,
	Опрос.ОпрашиваемоеЛицо.Автор КАК Менеджер
ПОМЕСТИТЬ ОтветыВБаллах
ИЗ
	Документ.Опрос КАК Опрос
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Опрос.Вопросы КАК ОпросВопросы
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыОтветовОпросов КАК ВариантыОтветовОпросов
			ПО ОпросВопросы.ТиповойОтвет = ВариантыОтветовОпросов.Ссылка
		ПО (ОпросВопросы.Ссылка = Опрос.Ссылка)
ГДЕ
	НЕ Опрос.ПометкаУдаления
	И Опрос.ОпросЗавершен
	И Опрос.ТиповаяАнкета = &amp;ТиповаяАнкета
	И ВЫБОР
			КОГДА &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Опрос.Дата &gt;= &amp;НачалоПериода
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ Опрос.Дата &lt;= &amp;КонецПериода
		КОНЕЦ
{ГДЕ
	Опрос.ТиповаяАнкета.*}

СГРУППИРОВАТЬ ПО
	Опрос.ОпрашиваемоеЛицо,
	Опрос.ОпрашиваемоеЛицо.Автор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОтветыВБаллах.ОпрашиваемоеЛицо,
	ВЫБОР
		КОГДА ОтветыВБаллах.КоличествоОтветов = 0
			ТОГДА 0
		ИНАЧЕ ОтветыВБаллах.КоличествоБаллов / ОтветыВБаллах.КоличествоОтветов
	КОНЕЦ КАК СреднийБалл,
	1 КАК Количество,
	ОтветыВБаллах.Менеджер
ПОМЕСТИТЬ СредниеБаллы
ИЗ
	ОтветыВБаллах КАК ОтветыВБаллах
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СредниеБаллы.ОпрашиваемоеЛицо,
	СредниеБаллы.СреднийБалл,
	ВЫБОР
		КОГДА СредниеБаллы.СреднийБалл = 5
			ТОГДА "Отличники"
		КОГДА СредниеБаллы.СреднийБалл &gt;= 4
				И СредниеБаллы.СреднийБалл &lt; 5
			ТОГДА "Хорошисты"
		ИНАЧЕ "Удовлетворительные"
	КОНЕЦ КАК Категория,
	СредниеБаллы.Количество,
	ВЫБОР
		КОГДА СредниеБаллы.СреднийБалл = 5
			ТОГДА 1
		КОГДА СредниеБаллы.СреднийБалл &gt;= 4
				И СредниеБаллы.СреднийБалл &lt; 5
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ КАК Порядок,
	СредниеБаллы.Менеджер
ИЗ
	СредниеБаллы КАК СредниеБаллы</query>
