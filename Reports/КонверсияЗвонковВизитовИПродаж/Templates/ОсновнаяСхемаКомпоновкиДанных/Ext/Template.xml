		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Событие.Ссылка КАК СамВизит,
	Событие.ВидСобытия,
	Событие.Продавец,
	Событие.ДатаОкончания,
	Событие.ДокументОснование,
	1 КАК КолСамВизит
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)
	И Событие.ДатаОкончания МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончанияВизитов, ДЕНЬ)
	И Событие.Проведен
	И НЕ Событие.ПометкаУдаления</query>
