		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РабочиеЛисты.Ссылка КАК РЛ,
	РабочиеЛисты.Проведен,
	РабочиеЛисты.ВидКонтакта,
	РабочиеЛисты.Организация,
	РабочиеЛисты.ПодразделениеКомпании,
	РабочиеЛисты.ТипРабочегоЛиста,
	РабочиеЛисты.ТрейдИн,
	РабочиеЛисты.Статус,
	РабочиеЛисты.Реклама,
	РабочиеЛисты.ПредставлениеТелефона,
	РабочиеЛисты.Контрагент,
	РабочиеЛисты.КлиентСервиса,
	РабочиеЛисты.Менеджер,
	РабочиеЛисты.Дата,
	1 КАК КолРЛ
ИЗ
	Документ.РабочийЛист КАК РабочиеЛисты
ГДЕ
	РабочиеЛисты.Дата МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И РабочиеЛисты.Проведен
	И НЕ РабочиеЛисты.ПометкаУдаления
	И РабочиеЛисты.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
	И РабочиеЛисты.ТипРабочегоЛиста = ЗНАЧЕНИЕ(Перечисление.ТипыСообщений.Входящее)</query>
