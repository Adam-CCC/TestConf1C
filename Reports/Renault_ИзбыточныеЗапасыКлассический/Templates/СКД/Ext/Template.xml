		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    ОстаткиТоваровКомпанииОстатки.СкладКомпании,
    ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул КАК Артикул,
    ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Номенклатура,
    ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры,
    Renault_ЗначенияТочкиЗаказаСрезПоследних.Классификация,
    Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи КАК СреднемесячныеПродажи,
    ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Остаток,
    ВЫБОР
        КОГДА ОстаткиТоваровКомпанииОстатки.КоличествоОстаток &gt; 3 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0)
            ТОГДА ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - 3 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0) КАК ЧИСЛО(12, 0))
        ИНАЧЕ 0
    КОНЕЦ КАК ОстатокЗапасаСвыше3М,
    ВЫБОР
        КОГДА ОстаткиТоваровКомпанииОстатки.КоличествоОстаток &gt; 6 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0)
            ТОГДА ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - 6 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0) КАК ЧИСЛО(12, 0))
        ИНАЧЕ 0
    КОНЕЦ КАК ОстатокЗапасаСвыше6М,
    ВЫБОР
        КОГДА ОстаткиТоваровКомпанииОстатки.КоличествоОстаток &gt; 9 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0)
            ТОГДА ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - 9 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0) КАК ЧИСЛО(12, 0))
        ИНАЧЕ 0
    КОНЕЦ КАК ОстатокЗапасаСвыше9М,
    ВЫБОР
        КОГДА ОстаткиТоваровКомпанииОстатки.КоличествоОстаток &gt; 12 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0)
            ТОГДА ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - 12 * ЕСТЬNULL(Renault_ЗначенияТочкиЗаказаСрезПоследних.СредниеПродажи, 0) КАК ЧИСЛО(12, 0))
        ИНАЧЕ 0
    КОНЕЦ КАК ОстатокЗапасаСвыше12М
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
    РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&amp;Период, ) КАК ОстаткиТоваровКомпанииОстатки
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ЗначенияТочкиЗаказа.СрезПоследних(&amp;Период, ) КАК Renault_ЗначенияТочкиЗаказаСрезПоследних
        ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = Renault_ЗначенияТочкиЗаказаСрезПоследних.Номенклатура
            И ОстаткиТоваровКомпанииОстатки.СкладКомпании = Renault_ЗначенияТочкиЗаказаСрезПоследних.СкладКомпании
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ВТ_Остатки.СкладКомпании,
    ВТ_Остатки.Артикул,
    ВТ_Остатки.Номенклатура,
    ВТ_Остатки.ХарактеристикаНоменклатуры,
    ВТ_Остатки.Классификация,
    ВТ_Остатки.СреднемесячныеПродажи,
    ВТ_Остатки.Остаток,
    ВТ_Остатки.ОстатокЗапасаСвыше3М,
    ВТ_Остатки.ОстатокЗапасаСвыше6М,
    ВТ_Остатки.ОстатокЗапасаСвыше9М,
    ВТ_Остатки.ОстатокЗапасаСвыше12М,
    ВТ_Остатки.Остаток * ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) КАК Сумма,
    ВТ_Остатки.ОстатокЗапасаСвыше3М * ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) КАК СуммаЗапасаСвыше3М,
    ВТ_Остатки.ОстатокЗапасаСвыше6М * ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) КАК СуммаЗапасаСвыше6М,
    ВТ_Остатки.ОстатокЗапасаСвыше9М * ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) КАК СуммаЗапасаСвыше9М,
    ВТ_Остатки.ОстатокЗапасаСвыше12М * ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) КАК СуммаЗапасаСвыше12М
ИЗ
    ВТ_Остатки КАК ВТ_Остатки
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(
                &amp;Период,
                ТипЦен = &amp;ТипЦен
                    И Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК ЦеныСрезПоследних
        ПО ВТ_Остатки.Номенклатура = ЦеныСрезПоследних.Номенклатура
            И ВТ_Остатки.ХарактеристикаНоменклатуры = ЦеныСрезПоследних.ХарактеристикаНоменклатуры</query>
	</dataSet>
