// возвращает текст запроса отчета
Функция ПолучитьТекстЗапроса() Экспорт
	
	ТекстВыборки = "";
	ТекстВыборкиОстатки = "";
	ТекстСгруппировать = "";
	ТекстСгруппироватьОстатки = "";
	ТекстСоединения = "";
	ТекстИндексировать = "";
	
	ПериодическийМассив = Новый Массив;
	ПериодическийМассив.Добавить("ПериодДень");
	ПериодическийМассив.Добавить("ПериодНеделя");
	ПериодическийМассив.Добавить("ПериодМесяц");
	ПериодическийМассив.Добавить("ПериодКвартал");
	ПериодическийМассив.Добавить("ПериодГод");
	
	СтруктураОписанияПериодов = Новый Структура("ПериодГод, ПериодКвартал, ПериодМесяц, ПериодНеделя, ПериодДень",
	"ГОД", "КВАРТАЛ", "МЕСЯЦ", "НЕДЕЛЯ", "ДЕНЬ");
	
	СтруктураПериодов	 = Новый Структура();
	СтруктураГруппировок = Новый Структура();
	ПериодическиеГруппировки = Новый Массив;
	МинИндекс = 99;
	ИмяПериода = "";
	ТекстПериодическойВыборки = "";
	ТекстПериодическойГруппировки = "";

	Для Каждого ТекСтрока Из ИзмеренияСтроки Цикл
		Если НЕ ТекСтрока.Использование Тогда Продолжить; КонецЕсли;
		ИмяПоля = СтрЗаменить(ТекСтрока.ПутьКДанным, ".", "");
		Если СтруктураСвязиСвойств.Свойство(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяПоля="Контрагент" ИЛИ ИмяПоля="ДоговорВзаиморасчетов" Тогда
			ТекстИндексировать = ТекстИндексировать+?(ТекстИндексировать="", "",",")+Символы.ПС+ИмяПоля;
		КонецЕсли;
		ВыражениеВыборки = "";
		Индекс = ПериодическийМассив.Найти(ИмяПоля);
		Если Индекс=Неопределено Тогда
			СтруктураГруппировок.Вставить(ИмяПоля);
		Иначе
			ТекстПериодическойВыборки = ТекстПериодическойВыборки + ",
			|	НАЧАЛОПЕРИОДА(ОстаткиИОборотыЗаПериод.Период, "+СтруктураОписанияПериодов[ИмяПоля]+") КАК "+ИмяПоля;
			ТекстПериодическойГруппировки = ТекстПериодическойГруппировки+",
			|	"+ИмяПоля;
			Если МинИндекс	> Индекс Тогда
				МинИндекс	= Индекс;
				ИмяПериода	= ИмяПоля;
			КонецЕсли;
			ПериодическиеГруппировки.Добавить(ИмяПоля);
			Продолжить;
		КонецЕсли;
		
		Если Найти(ТекСтрока.ПутьКДанным, "Организация")=1 Тогда
			ТекстСоединения = ТекстСоединения+" И ЕСТЬNULL("+Символы.ПС+"ТаблицаОборотов."+ИмяПоля+",1) = ЕСТЬNULL(ИтогиЗаПериод."+ИмяПоля+",1)";
			ВыражениеВыборки = "ОстаткиИОбороты.ДоговорВзаиморасчетов."+ТекСтрока.ПутьКДанным;
			ТекстВыборкиОстатки = ТекстВыборкиОстатки+","+Символы.ПС+"ТаблицаОстатков.ДоговорВзаиморасчетов."+ТекСтрока.ПутьКДанным+" КАК "+ИмяПоля;
			ТекстСгруппироватьОстатки = ТекстСгруппироватьОстатки+?(ТекстСгруппироватьОстатки="","",",")+Символы.ПС+"ТаблицаОстатков.ДоговорВзаиморасчетов."+ТекСтрока.ПутьКДанным;
		ИначеЕсли Найти(ТекСтрока.ПутьКДанным, "Подразделение")=1 Тогда
			ТекстСоединения = ТекстСоединения+" И ЕСТЬNULL("+Символы.ПС+"ТаблицаОборотов."+ИмяПоля+",1) = ЕСТЬNULL(ИтогиЗаПериод."+ИмяПоля+",1)";
			ВыражениеВыборки = "ОстаткиИОбороты.ДоговорВзаиморасчетов."+ТекСтрока.ПутьКДанным;
			ТекстВыборкиОстатки = ТекстВыборкиОстатки+","+Символы.ПС+"ТаблицаОстатков.ДоговорВзаиморасчетов."+ТекСтрока.ПутьКДанным+" КАК "+ИмяПоля;
			ТекстСгруппироватьОстатки = ТекстСгруппироватьОстатки+?(ТекстСгруппироватьОстатки="","",",")+Символы.ПС+"ТаблицаОстатков.ДоговорВзаиморасчетов."+ТекСтрока.ПутьКДанным;
		ИначеЕсли Найти(ТекСтрока.ПутьКДанным, "Проект")=1 Тогда
			ТекстСоединения = ТекстСоединения+" И "+Символы.ПС+" ЕСТЬNULL(ТаблицаОборотов."+ИмяПоля+",1) = ЕСТЬNULL(ИтогиЗаПериод."+ИмяПоля+",1)";
			ВыражениеВыборки = "ОстаткиИОбороты.Сделка."+ТекСтрока.ПутьКДанным;
			ТекстВыборкиОстатки = ТекстВыборкиОстатки+","+Символы.ПС+"ТаблицаОстатков.Сделка."+ТекСтрока.ПутьКДанным+" КАК "+ИмяПоля;
			ТекстСгруппироватьОстатки = ТекстСгруппироватьОстатки+?(ТекстСгруппироватьОстатки="","",",")+Символы.ПС+"ТаблицаОстатков.Сделка."+ТекСтрока.ПутьКДанным;
		ИначеЕсли Не Найти(ТекСтрока.ПутьКДанным, "ПериодРегистратор")=1 Тогда
			Если Найти(ТекСтрока.ПутьКДанным, ".")>0 Тогда
				ТекстСоединения = ТекстСоединения+" И "+Символы.ПС+" ЕСТЬNULL(ТаблицаОборотов."+ИмяПоля+",1) = ЕСТЬNULL(ИтогиЗаПериод."+ИмяПоля+",1)";
			Иначе
				ТекстСоединения = ТекстСоединения+" И "+Символы.ПС+" ТаблицаОборотов."+ИмяПоля+" = ИтогиЗаПериод."+ИмяПоля;
			КонецЕсли;
			ВыражениеВыборки = "ОстаткиИОбороты."+ТекСтрока.ПутьКДанным;
			ТекстВыборкиОстатки = ТекстВыборкиОстатки+","+Символы.ПС+"ТаблицаОстатков."+ТекСтрока.ПутьКДанным+" КАК "+ИмяПоля;
			ТекстСгруппироватьОстатки = ТекстСгруппироватьОстатки+?(ТекстСгруппироватьОстатки="","",",")+Символы.ПС+"ТаблицаОстатков."+ТекСтрока.ПутьКДанным;
		Иначе
			ВыражениеВыборки = "ОстаткиИОбороты."+СтрЗаменить(ТекСтрока.ПутьКДанным,"ПериодРегистратор","Регистратор");
		КонецЕсли;
		ТекстВыборки = ТекстВыборки+","+Символы.ПС+ВыражениеВыборки+" КАК "+ИмяПоля;
		ТекстСгруппировать = ТекстСгруппировать+","+Символы.ПС+ВыражениеВыборки;
	КонецЦикла;
	
	Пока ЗначениеЗаполнено(ИмяПериода) Цикл
		ТекИнд = ПериодическиеГруппировки.Найти(ИмяПериода);
		СтруктураДопПериодов = Новый Структура;
		ПериодическиеГруппировки.Удалить(ТекИнд);
		КоличествоДополнений = ПериодическиеГруппировки.Количество();
		Пока ТекИнд<КоличествоДополнений Цикл
			СтруктураДопПериодов.Вставить(ПериодическиеГруппировки[ТекИнд]);
			ПериодическиеГруппировки.Удалить(ТекИнд);
			КоличествоДополнений = КоличествоДополнений-1;
		КонецЦикла;
		СтруктураПериодов.Вставить(ИмяПериода, СтруктураДопПериодов);
		
		МинИндекс = 99;
		ИмяПериода = "";
		Для Каждого ТекСтрока Из ПериодическиеГруппировки Цикл
			Индекс = ПериодическийМассив.Найти(ТекСтрока);
			Если МинИндекс	> Индекс Тогда
				МинИндекс	= Индекс;
				ИмяПериода	= ТекСтрока;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если Не ТекстИндексировать = "" Тогда
		ТекстИндексировать = "ИНДЕКСИРОВАТЬ ПО"+ТекстИндексировать;
	КонецЕсли;
	
	СтруктураВидовОперацийРесурсов = ПолучитьСтруктуруВидовОперацийРесурсов();
	
	мОтборВидыОпераций = Новый Массив;
	мОтборВидыОпераций.Добавить(Перечисления.ВидыОперацийВзаиморасчетов.НачислениеДебиторскойЗадолженности);
	мОтборВидыОпераций.Добавить(Перечисления.ВидыОперацийВзаиморасчетов.ПогашениеДебиторскойЗадолженности);
	мОтборВидыОпераций.Добавить(Перечисления.ВидыОперацийВзаиморасчетов.НачислениеКредиторскойЗадолженности);
	мОтборВидыОпераций.Добавить(Перечисления.ВидыОперацийВзаиморасчетов.ПогашениеКредиторскойЗадолженности);
	мОтборВидыОпераций.Добавить(Перечисления.ВидыОперацийВзаиморасчетов.СписаниеКурсовойРазницыУпрВалюты);
	мОтборВидыОпераций.Добавить(Перечисления.ВидыОперацийВзаиморасчетов.СписаниеКурсовойРазницыБазВалюты);
	
	Для Каждого ТекПоказатель Из Показатели Цикл
		Если Не ТекПоказатель.Использование Тогда Продолжить; КонецЕсли;
		ИспользуемыеВидыОпераций = СтруктураВидовОперацийРесурсов[ТекПоказатель.Имя];
		Для Каждого ТекОперация Из ИспользуемыеВидыОпераций Цикл
			ИндОперации = мОтборВидыОпераций.Найти(ТекОперация);
			Если ИндОперации<>Неопределено Тогда
				мОтборВидыОпераций.Удалить(ИндОперации);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ТекстОтбора = "";
	Если мОтборВидыОпераций.Количество()>0 Тогда
		ПостроительОтчета.Параметры.Вставить("ОтборВидыОпераций", мОтборВидыОпераций);
		ТекстОтбора = "И НЕ ВзаиморасчетыКомпании.ВидОперации В (&ОтборВидыОпераций)";
	КонецЕсли;
	
	РезультатТекстЗапроса = "
	|	ВЫБРАТЬ
	|	ОстаткиИОбороты.Период КАК Период"+ТекстВыборки+",
