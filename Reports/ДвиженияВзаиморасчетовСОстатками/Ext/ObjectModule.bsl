	|	ДоговорВзаиморасчетов.Организация.* КАК Организация,
	|	ДоговорВзаиморасчетов.Подразделение.* КАК Подразделение,
	|	Контрагент.* КАК Контрагент,
	|	ДоговорВзаиморасчетов.* КАК ДоговорВзаиморасчетов,
	|	Сделка.* КАК Сделка,
	|	Сделка.Проект.* КАК Проект}) КАК ВзаиморасчетыКомпанииОстатки) КАК ТаблицаОстатков
	|"+?(ТекстСгруппироватьОстатки="",""," СГРУППИРОВАТЬ ПО
	|	"+ТекстСгруппироватьОстатки)+"
	|"+ТекстИндексировать+"
	|;
	|";
	
	ТекстТаблицыОборотов = "
	|	ВЫБРАТЬ
	|	ТаблицаОборотов.Период КАК Период";
	ТекстТаблицыОстатков = "
	|	(ВЫБРАТЬ
	|	ЕСТЬNULL(ТаблицаОборотов.Период, &ДатаНач) КАК Период";
	ТекстТаблицыОбщихОборотов = "ВЫБРАТЬ
	|	ОбщаяТаблицаОборотов.Период КАК Период";
	
	ТекстВыборки = "";
	ТекстСгруппировать = "";
	Для Каждого ТекСтрока Из СтруктураГруппировок Цикл
		ИмяПоля = ТекСтрока.Ключ;
		ТекстВыборки = ТекстВыборки + "
		|	ОборотыПоПериодам."+ИмяПоля+" КАК " + ИмяПоля+",";
		ТекстТаблицыОборотов = ТекстТаблицыОборотов+",
		|	ТаблицаОборотов."+ИмяПоля+" КАК "+ИмяПоля;
		Если Найти(ИмяПоля, "ПериодРегистратор")>0 Тогда
			ТекстТаблицыОстатков = ТекстТаблицыОстатков+",
			|	ТаблицаОборотов."+ИмяПоля+" КАК "+ИмяПоля;
		Иначе
			ТекстТаблицыОстатков = ТекстТаблицыОстатков+",
			|	ЕСТЬNULL(ТаблицаОборотов."+ИмяПоля+", ТаблицаОстатков."+ИмяПоля+") КАК "+ИмяПоля;
		КонецЕсли;
		ТекстТаблицыОбщихОборотов = ТекстТаблицыОбщихОборотов+",
		|	ОбщаяТаблицаОборотов."+ИмяПоля+" КАК "+ИмяПоля;
		ТекстСгруппировать = ТекстСгруппировать+","+Символы.ПС+"ОбщаяТаблицаОборотов."+ИмяПоля;
	КонецЦикла;
	
	Для Каждого ТекПоказатель Из Показатели Цикл
		Если Не ТекПоказатель.Использование Тогда Продолжить; КонецЕсли;
		ТекстТаблицыОбщихОборотов = ТекстТаблицыОбщихОборотов+",
		|	СУММА(ОбщаяТаблицаОборотов."+ТекПоказатель.Имя+"Приход) КАК "+ТекПоказатель.Имя+"Приход,
		|	СУММА(ОбщаяТаблицаОборотов."+ТекПоказатель.Имя+"Расход) КАК "+ТекПоказатель.Имя+"Расход,
		|	СУММА(ОбщаяТаблицаОборотов."+ТекПоказатель.Имя+"Оборот) КАК "+ТекПоказатель.Имя+"Оборот,
		|	СУММА(ОбщаяТаблицаОборотов."+ТекПоказатель.Имя+"НачальныйОстатокЗаПериод) КАК "+ТекПоказатель.Имя+"НачальныйОстатокЗаПериод";
		
		ТекстТаблицыОстатков = ТекстТаблицыОстатков+",
		|	ЕСТЬNULL(ТаблицаОборотов."+ТекПоказатель.Имя+"Приход, 0) КАК "+ТекПоказатель.Имя+"Приход,
		|	ЕСТЬNULL(ТаблицаОборотов."+ТекПоказатель.Имя+"Расход, 0) КАК "+ТекПоказатель.Имя+"Расход,
		|	ЕСТЬNULL(ТаблицаОборотов."+ТекПоказатель.Имя+"Приход-ТаблицаОборотов."+ТекПоказатель.Имя+"Расход, 0) КАК "+ТекПоказатель.Имя+"Оборот,
		|	ЕСТЬNULL(ТаблицаОстатков."+ТекПоказатель.Имя+"НачальныйОстаток, 0) КАК "+ТекПоказатель.Имя+"НачальныйОстатокЗаПериод";
		
		ТекстТаблицыОборотов = ТекстТаблицыОборотов+",
		|	0 КАК "+ТекПоказатель.Имя+"Приход,
		|	0 КАК "+ТекПоказатель.Имя+"Расход,
		|	0 КАК "+ТекПоказатель.Имя+"Оборот,
		|	ИтогиЗаПериод."+ТекПоказатель.Имя+"Приход-ИтогиЗаПериод."+ТекПоказатель.Имя+"Расход КАК "+ТекПоказатель.Имя+"НачальныйОстатокЗаПериод";
	КонецЦикла;
	ТекстСоединенияОстатков = Сред(ТекстСоединения,Найти(ТекстСоединения,"И")+1);
	ТекстСоединенияОстатков = СтрЗаменить(ТекстСоединенияОстатков, "ИтогиЗаПериод.", "ТаблицаОстатков.");
	ТекстТаблицыОборотов =" 
	|"+ТекстТаблицыОстатков+"
	|ИЗ
	|	ТаблицаОборотов КАК ТаблицаОборотов
	|ПОЛНОЕ СОЕДИНЕНИЕ ТаблицаОстатков КАК ТаблицаОстатков
	|ПО"+?(ТекстСоединенияОстатков=""," ИСТИНА ", ТекстСоединенияОстатков)+"
	|ОБЪЕДИНИТЬ ВСЕ
	|"+ТекстТаблицыОборотов+"
	|ИЗ
	|	ТаблицаОборотов КАК ТаблицаОборотов
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаОборотов КАК ИтогиЗаПериод
	|ПО
	|  ТаблицаОборотов.Период > ИтогиЗаПериод.Период"+ТекстСоединения;
	
	РезультатТекстЗапроса = РезультатТекстЗапроса+Символы.ПС+ТекстТаблицыОбщихОборотов+"
	|ПОМЕСТИТЬ ОстаткиИОборотыЗаПериод
	|ИЗ
	|"+ТекстТаблицыОборотов+") КАК ОбщаяТаблицаОборотов
	|СГРУППИРОВАТЬ ПО
	|	ОбщаяТаблицаОборотов.Период"+ТекстСгруппировать+"
	|"+ТекстИндексировать+"
	|;		
	|УНИЧТОЖИТЬ ТаблицаОборотов
	|;
	|
	|УНИЧТОЖИТЬ ТаблицаОстатков
	|;
	|";
	
	ТекстТаблицыОборотов = "
	|ВЫБРАТЬ
	|	ОстаткиИОборотыЗаПериод.Период КАК Период"+ТекстПериодическойВыборки;
	
	ТекстГруппировки	= "";
	
	ТекстВыборки 			= "";
	ТекстСоединения			= "";
	ТекстСгруппировать		= "";
	ТекстСоединенияТаблиц	= "";
	Для Каждого ТекСтрока Из СтруктураГруппировок Цикл
		ИмяПоля = ТекСтрока.Ключ;
		Если ИмяПоля = "ПериодРегистратор" Тогда Продолжить; КонецЕсли;
		ТекстВыборки = ТекстВыборки + "
		|	ОборотыПоПериодам."+ИмяПоля+" КАК " + ИмяПоля+",";
		ТекстСгруппировать = ТекстСгруппировать+?(ТекстСгруппировать="", "", ",")+Символы.ПС+"ОборотыПоПериодам."+ИмяПоля;
		ТекстСоединения = ТекстСоединения + " И 
			|	ОстаткиИОборотыЗаПериод."+ИмяПоля+" = ОборотыПоПериодам."+ИмяПоля;
	КонецЦикла;
	Для Каждого ТекПериод Из СтруктураПериодов Цикл
		ИмяПериода = ТекПериод.Ключ;
		Если ИмяПериода = "Период" Тогда Продолжить; КонецЕсли;
		ВидПериода=СтруктураОписанияПериодов[ИмяПериода];
		
		РезультатТекстЗапроса = РезультатТекстЗапроса + "
		|ВЫБРАТЬ
		|	"+ТекстВыборки+"
		|	МИНИМУМ(ОборотыПоПериодам.Период) КАК ПервыйПериод,
		|	НАЧАЛОПЕРИОДА(ОборотыПоПериодам.Период, "+ВидПериода+") КАК Период
		|ПОМЕСТИТЬ
		|	Обороты"+ИмяПериода+"
		|ИЗ
		|	ОстаткиИОборотыЗаПериод КАК ОборотыПоПериодам
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ОборотыПоПериодам.Период, "+ВидПериода+")"+?(ТекстСгруппировать="", "",","+ТекстСгруппировать)+"
		|"+ТекстИндексировать+"
		|;
		|";
		
		Для Каждого ТекПоказатель Из Показатели Цикл
			Если Не ТекПоказатель.Использование Тогда Продолжить; КонецЕсли;
			ТекстТаблицыОборотов = ТекстТаблицыОборотов + ",
			|	ВЫБОР
			|		КОГДА ОборотыПоПериодам"+ИмяПериода+".ПервыйПериод ЕСТЬ NULL ТОГДА 0
			|	ИНАЧЕ
			|		ОстаткиИОборотыЗаПериод."+ТекПоказатель.Имя+"НачальныйОстатокЗаПериод
			|	КОНЕЦ КАК "+ТекПоказатель.Имя+"НачальныйОстатокЗа"+ИмяПериода;
		КонецЦикла;
		
		ТекстСоединенияТаблиц = ТекстСоединенияТаблиц + "
		|ЛЕВОЕ СОЕДИНЕНИЕ Обороты"+ИмяПериода+" КАК ОборотыПоПериодам"+ИмяПериода+"
		|ПО
		|	ОстаткиИОборотыЗаПериод.Период = ОборотыПоПериодам"+ИмяПериода+".ПервыйПериод"+СтрЗаменить(ТекстСоединения,"ОборотыПоПериодам", "ОборотыПоПериодам"+ИмяПериода);
		
	КонецЦикла;
		
	РезультатТекстЗапроса = РезультатТекстЗапроса + "
	|ВЫБРАТЬ
	|	"+ТекстВыборки+"
	|	МИНИМУМ(ОборотыПоПериодам.Период) КАК ПервыйПериод
	|ПОМЕСТИТЬ
	|	ОборотыОбщие
	|ИЗ
	|	ОстаткиИОборотыЗаПериод КАК ОборотыПоПериодам"+?(ТекстСгруппировать="","","
	|СГРУППИРОВАТЬ ПО "+ТекстСгруппировать)+"
	|"+ТекстИндексировать+"
	|;
	|";
	
	Для Каждого ТекПоказатель Из Показатели Цикл
		Если Не ТекПоказатель.Использование Тогда Продолжить; КонецЕсли;
		ТекстТаблицыОборотов = ТекстТаблицыОборотов + ",
		|	ВЫБОР
		|		КОГДА ОборотыОбщие.ПервыйПериод ЕСТЬ NULL ТОГДА 0
		|	ИНАЧЕ
		|		ОстаткиИОборотыЗаПериод."+ТекПоказатель.Имя+"НачальныйОстатокЗаПериод
		|	КОНЕЦ КАК "+ТекПоказатель.Имя+"НачальныйОстаток";
	КонецЦикла;
	
	ТекстСоединенияТаблиц = ТекстСоединенияТаблиц + "
	|ЛЕВОЕ СОЕДИНЕНИЕ ОборотыОбщие КАК ОборотыОбщие
	|ПО
	|	ОстаткиИОборотыЗаПериод.Период = ОборотыОбщие.ПервыйПериод"+СтрЗаменить(ТекстСоединения, "ОборотыПоПериодам", "ОборотыОбщие");
	
	Для Каждого ТекСтрока Из СтруктураГруппировок Цикл
		ИмяПоля = ТекСтрока.Ключ;
		ТекстТаблицыОборотов = ТекстТаблицыОборотов+",
		|	ОстаткиИОборотыЗаПериод."+ИмяПоля+" КАК "+ИмяПоля;
		Если ИмяПоля="ПериодРегистратор" Тогда
			ТекстГруппировки = ТекстГруппировки+ТекстПериодическойГруппировки+",
			|	Период";
		КонецЕсли;
		ТекстГруппировки = ТекстГруппировки+",
		|	"+ИмяПоля;
	КонецЦикла;
	
	СтрЗапросаСвойств      = "";
	СтрЗапросаИтогиСвойств = "";
	СтрГруппировкиСвойств  = "";
	СтрСоединенийСвойств   = "";
	Для Каждого ТекСтруктура Из СтруктураСвязиСвойств Цикл
		ИмяСвойства = СтрЗаменить(ТекСтруктура.Ключ, "Значение", "");
		Свойство = ТекСтруктура.Значение.Свойство;
		ПутьКДаннымИзмерения = "ОстаткиИОборотыЗаПериод."+ТекСтруктура.Значение.ИмяИзмерения;
		ИмяПараметра = ТекСтруктура.Значение.ИмяПараметра;
		ПолеИзмерения = ИзмеренияСтроки.Найти(ИмяПараметра, "ПутьКДанным");
//		Если ПолеИзмерения=Неопределено ИЛИ (Не ПолеИзмерения.Использование) Тогда Продолжить; КонецЕсли;
		ЗапросСвойстваПоля = ", ЕСТЬNULL(" + ИмяСвойства + ".Значение, """ + Свойство.Наименование + ": <Пусто>"") КАК " + ИмяСвойства + "Значение	//СВОЙСТВО" + Символы.ПС;
		ЗапросСвойстваГруппы = ", ЕСТЬNULL(" + ИмяСвойства + ".Значение, """ + Свойство.Наименование + ": <Пусто>"") //СВОЙСТВО" + Символы.ПС;
		ЗапросСвойстваИтоги = ",МАКСИМУМ(" + ИмяСвойства + "Значение)	//СВОЙСТВО" + Символы.ПС;
		ЗапросСвойстваСоединение = "{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК " + ИмяСвойства + " ПО " + ИмяСвойства + ".Объект = " + ПутьКДаннымИзмерения + " И " + ИмяСвойства + ".Свойство = &" + ИмяПараметра + "}	//СВОЙСТВО" + Символы.ПС;
		
		СтрЗапросаСвойств      = СтрЗапросаСвойств      + ЗапросСвойстваПоля;
		СтрЗапросаИтогиСвойств = СтрЗапросаИтогиСвойств + ЗапросСвойстваИтоги;
		СтрГруппировкиСвойств  = СтрГруппировкиСвойств  + ЗапросСвойстваГруппы;
		СтрСоединенийСвойств   = СтрСоединенийСвойств   + ЗапросСвойстваСоединение;
	КонецЦикла;
	ТекстОтбора = "";
	Если Не ПустаяСтрока(СтрЗапросаСвойств) Тогда
		ТекстОтбора = "{ГДЕ
		|	ОстаткиИОборотыЗаПериод.ПериодРегистратор КАК ПериодРегистратор
		|	"+СтрЗапросаСвойств+Символы.ПС+"//ВЫБРАННЫЕСВОЙСТВА}";
	КонецЕсли;
	СтрЗапросаСвойств      = СтрЗапросаСвойств+Символы.ПС+"//ВЫБРАННЫЕСВОЙСТВА";
	СтрЗапросаИтогиСвойств = СтрЗапросаИтогиСвойств+Символы.ПС+"//ВЫБРАННЫЕИТОГИСВОЙСТВА";
	СтрГруппировкиСвойств  = СтрГруппировкиСвойств+Символы.ПС+"//ВЫБРАННЫЕСГРУППИРОВАТЬПО";
	СтрСоединенийСвойств   = СтрСоединенийСвойств+Символы.ПС+"//ВЫБРАННЫЕСОЕДИНЕНИЯ";
	
	ТекстИтогов = "";
	ТекстИтоговНачОст = "";
	ТекстИтоговКонОст = "";
	Для Каждого ТекПоказатель Из Показатели Цикл
		Если Не ТекПоказатель.Использование Тогда Продолжить; КонецЕсли;
		ИмяПоля = ТекПоказатель.Имя;
		ТекстТаблицыОборотов = ТекстТаблицыОборотов+",
		|	ОстаткиИОборотыЗаПериод."+ИмяПоля+"Приход КАК "+ИмяПоля+"Приход,
		|	ОстаткиИОборотыЗаПериод."+ИмяПоля+"Расход КАК "+ИмяПоля+"Расход,
		|	ОстаткиИОборотыЗаПериод."+ИмяПоля+"Оборот КАК "+ИмяПоля+"Оборот,
		|	ОстаткиИОборотыЗаПериод."+ИмяПоля+"НачальныйОстатокЗаПериод КАК "+ИмяПоля+"НачальныйОстатокЗаПериод,
		|	0 КАК "+ИмяПоля+"КонечныйОстаток";
		ТекстИтогов = ТекстИтогов+?(ТекстИтогов="", "", ",")+"
		|	СУММА("+ИмяПоля+"Приход),
		|	СУММА("+ИмяПоля+"Расход),
		|	СУММА("+ИмяПоля+"Оборот)";
		ТекстИтоговНачОст = ",
		|	(ВЫБОР
		|		КОГДА (НЕ ПериодРегистратор ЕСТЬ NULL) ИЛИ (НЕ Период ЕСТЬ NULL) ТОГДА СУММА("+ИмяПоля+"НачальныйОстатокЗаПериод)";
		ТекстИтоговОст = ",
		|	(ВЫБОР
		|		КОГДА (НЕ ПериодРегистратор ЕСТЬ NULL) ИЛИ (НЕ Период ЕСТЬ NULL) ТОГДА СУММА("+ИмяПоля+"НачальныйОстатокЗаПериод)";
		Для Каждого ТекПериод Из СтруктураПериодов Цикл
			ТекстИтоговОст = ТекстИтоговОст+"
			|		КОГДА (НЕ "+ТекПериод.Ключ+" ЕСТЬ NULL) ТОГДА СУММА("+ИмяПоля+"НачальныйОстатокЗа"+ТекПериод.Ключ+")";
		КонецЦикла;
		ТекстИтогов = ТекстИтогов+ТекстИтоговОст+"
		|	ИНАЧЕ СУММА("+ИмяПоля+"НачальныйОстаток)
		|КОНЕЦ) КАК "+ИмяПоля+"НачальныйОстаток"+ТекстИтоговОст+"
		|	ИНАЧЕ СУММА("+ИмяПоля+"НачальныйОстаток)
		|КОНЕЦ)+ СУММА("+ИмяПоля+"Оборот) КАК "+ИмяПоля+"КонечныйОстаток";
	КонецЦикла;
	
	РезультатТекстЗапроса = РезультатТекстЗапроса+Символы.ПС+ТекстТаблицыОборотов+"
	|	"+СтрЗапросаСвойств+"
	|ИЗ
	|	ОстаткиИОборотыЗаПериод КАК ОстаткиИОборотыЗаПериод"+ТекстСоединенияТаблиц+"
	|	"+СтрСоединенийСвойств+"
	|	"+ТекстОтбора+"
	|ИТОГИ
	|	"+ТекстИтогов+"
	|	"+СтрЗапросаИтогиСвойств+"
	|ПО
	|	ОБЩИЕ"+ТекстГруппировки+"
	|	"+СтрЗапросаСвойств+"
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	СтрЗапросаСвойств      = СтрЗапросаСвойств+Символы.ПС+"//ВЫБРАННЫЕСВОЙСТВА";

	Возврат РезультатТекстЗапроса;
	
КонецФункции // ПолучитьТекстЗапроса()

