			<field>ФИО</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЭлПочта</dataPath>
			<field>ЭлПочта</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>e-mail</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТелефонДляSMS</dataPath>
			<field>ТелефонДляSMS</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Телефон для SMS</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	КонтактнаяИнформация.Объект КАК Контрагент,
	КонтактнаяИнформация.Представление
ПОМЕСТИТЬ ЭлПочтаЗаказчиков
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	И КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	И КонтактнаяИнформация.ЗначениеПоУмолчанию
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КонтактнаяИнформация.Объект КАК Контрагент,
	КонтактнаяИнформация.Поле5 КАК ТелефонДляСМС
ПОМЕСТИТЬ ТелефоныЗаказчиков
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	И КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	И КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Поле5 ПОДОБНО "+79_________"
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(ЗаказНаряд.Дата) КАК ДатаПос,
	ЗаказНаряд.Автомобиль.ВариантКомплектации.ТипДвигателя КАК ВидДвигателя,
	ЗаказНаряд.Автомобиль.ГодВыпуска КАК ГодВыпуска,
	ЗаказНаряд.Автомобиль.ТипКПП КАК ТипКПП,
	ЗаказНаряд.Заказчик.Ссылка КАК ФИО,
	ЗаказНаряд.Заказчик.ОсновнойТелефон КАК Телефон,
	ЗаказНаряд.Заказчик.ОтсылатьСМС КАК ОтсылатьСМС,
	ЗаказНаряд.Заказчик.Пол КАК Пол,
	ЗаказНаряд.Заказчик.ДатаРождения КАК ДатаРождения,
	ЗаказНаряд.ПодразделениеКомпании,
	ЗаказНаряд.Автомобиль.Модель КАК Модель,
	ЗаказНаряд.Организация,
	ПОДСТРОКА(ЭлПочтаЗаказчиков.Представление, 1, 50) КАК ЭлПочта,
	ПОДСТРОКА(ТелефоныЗаказчиков.ТелефонДляСМС, 2, 11) КАК ТелефонДляSMS
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ ЭлПочтаЗаказчиков КАК ЭлПочтаЗаказчиков
		ПО ЗаказНаряд.Заказчик = ЭлПочтаЗаказчиков.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ ТелефоныЗаказчиков КАК ТелефоныЗаказчиков
		ПО ЗаказНаряд.Заказчик = ТелефоныЗаказчиков.Контрагент

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.Автомобиль.ВариантКомплектации.ТипДвигателя,
	ЗаказНаряд.Автомобиль.ТипКПП,
	ЗаказНаряд.Автомобиль.ГодВыпуска,
	ЗаказНаряд.Заказчик.Ссылка,
	ЗаказНаряд.Заказчик.ОсновнойТелефон,
	ЗаказНаряд.Заказчик.ОтсылатьСМС,
	ЗаказНаряд.Заказчик.Пол,
	ЗаказНаряд.Заказчик.ДатаРождения,
	ЗаказНаряд.ПодразделениеКомпании,
	ЗаказНаряд.Автомобиль.Модель,
	ЗаказНаряд.Организация,
	ПОДСТРОКА(ЭлПочтаЗаказчиков.Представление, 1, 50),
	ПОДСТРОКА(ТелефоныЗаказчиков.ТелефонДляСМС, 2, 11)</query>
	</dataSet>
