			<dataPath>Автомобиль</dataPath>
			<field>Автомобиль</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	КонтактнаяИнформация.Представление,
	КонтактнаяИнформация.Объект
ПОМЕСТИТЬ Адрес
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КонтактнаяИнформация.Представление,
	КонтактнаяИнформация.Объект
ПОМЕСТИТЬ АдресЭлектроннойПочты
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КонтактнаяИнформация.Представление,
	КонтактнаяИнформация.Объект
ПОМЕСТИТЬ Телефон
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.ЗначениеПоУмолчанию
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Событие.Организация,
	Событие.ПодразделениеКомпании,
	Событие.Продавец,
	Событие.Автомобиль,
	Событие.Контрагент,
	Адрес.Представление КАК Адрес,
	АдресЭлектроннойПочты.Представление КАК АдресЭлектроннойПочты,
	Телефон.Представление КАК Телефон,
	1 КАК Количество
ИЗ
	Документ.Событие КАК Событие
		ЛЕВОЕ СОЕДИНЕНИЕ Адрес КАК Адрес
		ПО Событие.Контрагент = Адрес.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ АдресЭлектроннойПочты КАК АдресЭлектроннойПочты
		ПО Событие.Контрагент = АдресЭлектроннойПочты.Объект
		ЛЕВОЕ СОЕДИНЕНИЕ Телефон КАК Телефон
		ПО Событие.Контрагент = Телефон.Объект
ГДЕ
	Событие.ДатаОкончания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Событие.Проведен
	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ВыдачаАвтомобиля)
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)

УПОРЯДОЧИТЬ ПО
	Событие.ДатаОкончания</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
