		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_СтраховойПолис.Ссылка,
	Renault_СтраховойПолис.ТипБСО,
	Renault_СтраховойПолис.СерияБСО,
	Renault_СтраховойПолис.НомерБСО,
	ВложенныйЗапрос.ДатаОплаты,
	ВложенныйЗапрос.НомерСтроки,
	ВложенныйЗапрос.Сумма,
	Renault_СтраховойПолис.СтраховаяКомпания,
	Renault_СтраховойПолис.Контрагент,
//	Renault_СтраховойПолис.КонтактныйТелефон,
	Renault_СтраховойПолис.Агент,
	Renault_СтраховойПолис.СуммаДокумента,
	ВЫБОР
		КОГДА Renault_СтраховойПолис.СуммаДокумента = 0
			ТОГДА 0
		ИНАЧЕ 100 * ВложенныйЗапрос.Сумма / Renault_СтраховойПолис.СуммаДокумента
	КОНЕЦ КАК Процент,
	Renault_СтраховойПолис.Состояние,
	ВЫБОР
		КОГДА &amp;ЕстьПравоВидетьТелефоны
			ТОГДА КИ_Телефон.Представление
		ИНАЧЕ ""
	КОНЕЦ КАК ТелефонКонтрагента,
	КИ_Емаил.Представление КАК Емаил
ИЗ
	(ВЫБРАТЬ
		Renault_СтраховойПолисГрафикОплаты.Ссылка КАК Ссылка,
		Renault_СтраховойПолисГрафикОплаты.НомерСтроки КАК НомерСтроки,
		Renault_СтраховойПолисГрафикОплаты.ДатаОплаты КАК ДатаОплаты,
		Renault_СтраховойПолисГрафикОплаты.Сумма КАК Сумма
	ИЗ
		Документ.Renault_СтраховойПолис.ГрафикОплаты КАК Renault_СтраховойПолисГрафикОплаты
	ГДЕ
		Renault_СтраховойПолисГрафикОплаты.ДатаОплаты МЕЖДУ НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)) КАК ВложенныйЗапрос
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_СтраховойПолис КАК Renault_СтраховойПолис
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				КонтактнаяИнформация.Объект КАК Объект,
				КонтактнаяИнформация.Представление КАК Представление
			ИЗ
				РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			ГДЕ
				КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
//				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
				) КАК КИ_Телефон
			ПО Renault_СтраховойПолис.Контрагент = КИ_Телефон.Объект
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				КонтактнаяИнформация.Объект КАК Объект,
				КонтактнаяИнформация.Представление КАК Представление
			ИЗ
				РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			ГДЕ
				КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
//				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами)
				) КАК КИ_Емаил
			ПО Renault_СтраховойПолис.Контрагент = КИ_Емаил.Объект
		ПО ВложенныйЗапрос.Ссылка = Renault_СтраховойПолис.Ссылка
ГДЕ
	Renault_СтраховойПолис.Проведен
	И НЕ Renault_СтраховойПолис.ПометкаУдаления</query>
