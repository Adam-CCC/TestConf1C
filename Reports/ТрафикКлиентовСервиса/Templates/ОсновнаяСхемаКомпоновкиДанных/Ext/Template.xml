		<query>ВЫБРАТЬ
	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
	ЗаказНаряд.Организация КАК Организация,
	ЗаказНаряд.ПодразделениеКомпании КАК Подразделение,
	ЗаказНаряд.Автор.Сотрудник КАК Сотрудник,
	ЗаказНаряд.ПредставлениеТелефона КАК Телефон,
	ЗаказНаряд.ДокументОснование КАК ДокументОснование
ПОМЕСТИТЬ ЗаказНаряды
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И НЕ ЗаказНаряд.Состояние В (&amp;НеактивныеСостояния)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаявкаНаРемонт.Ссылка КАК ЗаявкаНаРемонт,
	ЗаявкаНаРемонт.Организация КАК Организация,
	ЗаявкаНаРемонт.ПодразделениеКомпании КАК Подразделение,
	ЗаявкаНаРемонт.Менеджер КАК Менеджер,
	ЗаявкаНаРемонт.ПредставлениеТелефона КАК Телефон,
	ЗаказНаряды.ЗаказНаряд КАК ЗаказНаряд,
	ВЫБОР
		КОГДА ЗаказНаряды.ЗаказНаряд ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК Машинозаезды
ПОМЕСТИТЬ ЗаявкиИЗаказНаряды
ИЗ
	Документ.ЗаявкаНаРемонт КАК ЗаявкаНаРемонт
		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказНаряды КАК ЗаказНаряды
		ПО ЗаявкаНаРемонт.Ссылка = ЗаказНаряды.ДокументОснование
ГДЕ
	ЗаявкаНаРемонт.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Событие.Ссылка КАК Событие,
	Событие.Организация КАК Организация,
	Событие.ПодразделениеКомпании КАК Подразделение,
	Событие.Продавец КАК Сотрудник,
	Событие.ПредставлениеТелефона КАК Телефон,
	ЗаявкиИЗаказНаряды.ЗаявкаНаРемонт КАК ЗаявкаНаРемонт,
	ВЫБОР
		КОГДА НЕ Событие.ВторичныйКонтакт
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЗвонкиПервичные,
	ВЫБОР
		КОГДА Событие.ВторичныйКонтакт
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЗвонкиПовторные,
	1 КАК ЗвонкиВсего,
	ВЫБОР
		КОГДА ЗаявкиИЗаказНаряды.ЗаявкаНаРемонт ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК ЗаявкиПоЗвонкам,
	ВЫБОР
		КОГДА ЗаявкиИЗаказНаряды.ЗаявкаНаРемонт ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ ЗаявкиИЗаказНаряды.Машинозаезды
	КОНЕЦ КАК МашинозаездыПоЗвонкам,
	0 КАК ВизитыПервичные,
	0 КАК ВизитыПовторные,
	0 КАК ВизитыВсего,
	0 КАК ЗаявкиПоВизитам,
	0 КАК МашинозаездыПоВизитам
ИЗ
	Документ.Событие КАК Событие
		ЛЕВОЕ СОЕДИНЕНИЕ ЗаявкиИЗаказНаряды КАК ЗаявкиИЗаказНаряды
		ПО Событие.ПредставлениеТелефона = ЗаявкиИЗаказНаряды.Телефон
ГДЕ
	Событие.ПредметОбращения В(&amp;ОбращенияСервис)
	И Событие.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Событие.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщений.Входящее)
	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Событие.Ссылка,
	Событие.Организация,
	Событие.ПодразделениеКомпании,
	Событие.Продавец,
	Событие.ПредставлениеТелефона,
	ЗаявкиИЗаказНаряды.ЗаявкаНаРемонт,
	0,
	0,
	0,
	0,
	0,
	ВЫБОР
		КОГДА НЕ Событие.ВторичныйКонтакт
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА Событие.ВторичныйКонтакт
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ,
	1,
	ВЫБОР
		КОГДА ЗаявкиИЗаказНаряды.ЗаявкаНаРемонт ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ,
	ВЫБОР
		КОГДА ЗаявкиИЗаказНаряды.ЗаявкаНаРемонт ЕСТЬ NULL
			ТОГДА 0
		ИНАЧЕ ЗаявкиИЗаказНаряды.Машинозаезды
	КОНЕЦ
ИЗ
	Документ.Событие КАК Событие
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗаявкиИЗаказНаряды КАК ЗаявкиИЗаказНаряды
		ПО Событие.ПредставлениеТелефона = ЗаявкиИЗаказНаряды.Телефон
ГДЕ
	Событие.ПредметОбращения В(&amp;ОбращенияСервис)
	И Событие.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)</query>
