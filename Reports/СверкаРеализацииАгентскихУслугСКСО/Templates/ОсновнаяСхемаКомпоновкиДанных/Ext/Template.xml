		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтраховойПродукт</dataPath>
			<field>СтраховойПродукт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Страховой продукт</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДилерскийЦентр</dataPath>
			<field>ДилерскийЦентр</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дилерский центр</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РеализацияАгентскихУслуг</dataPath>
			<field>РеализацияАгентскихУслуг</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Реализация агентских услуг</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РеализацияТоваровТовары.Ссылка КАК РеализацияАгентскихУслуг,
	РеализацияТоваровТовары.Ссылка.Проведен КАК Проведен,
	РеализацияТоваровТовары.Ссылка.Дата КАК Дата,
	РеализацияТоваровТовары.Ссылка.ХозОперация КАК ХозОперация,
	РеализацияТоваровТовары.Ссылка.Организация КАК Организация,
	РеализацияТоваровТовары.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	РеализацияТоваровТовары.Номенклатура КАК СтраховойПродукт,
	РеализацияТоваровТовары.СуммаВсего КАК СуммаВсего,
	РеализацияТоваровТовары.Ссылка.Контрагент КАК Контрагент,
	РеализацияТоваровТовары.Ссылка.Комитент КАК Комитент,
	РеализацияТоваровТовары.Ссылка.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр
ИЗ
	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
ГДЕ
	РеализацияТоваровТовары.Ссылка.Проведен
	И РеализацияТоваровТовары.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.РеализацияАгентскихУслуг)
	И РеализацияТоваровТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
	<totalField>
		<dataPath>СуммаВсего</dataPath>
		<expression>Сумма(СуммаВсего)</expression>
	</totalField>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
