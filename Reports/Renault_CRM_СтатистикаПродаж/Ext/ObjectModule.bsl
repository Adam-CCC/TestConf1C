
Процедура ЗаполнитьНастройкиОтчета(НастройкиОтчета, ЭтоДиаграмма=Ложь) Экспорт
	
	СписокРесурсов = Новый СписокЗначений;
	СписокПолей = Новый СписокЗначений;
	
	Для Каждого текСтрока Из ДоступныеПоляОтчета Цикл
		Если текСтрока.Пометка=Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Если текСтрока.Ресурс Тогда
			Элемент = СписокРесурсов.Добавить(текСтрока.ИмяПоля);
			Элемент.Пометка = текСтрока.Пометка;
		Иначе
			Элемент = СписокПолей.Добавить(текСтрока.ИмяПоля);
			Элемент.Пометка = текСтрока.Пометка;
		КОнецЕсли;
	КонецЦикла;
	
	// добавим выбранные группировки                    
	Для Каждого текРесурс Из СписокРесурсов Цикл
		Если НайтиПолеКомпоновки(текРесурс.Значение, НастройкиОтчета.Выбор.Элементы) ИЛИ НЕ текРесурс.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
 		ПолеРесурса = НастройкиОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеРесурса.Использование = Истина;
		ПолеРесурса.Заголовок = текРесурс.Значение;
		ПолеРесурса.Поле = Новый ПолеКомпоновкиДанных(текРесурс.Значение);
	КонецЦикла;
	
	////////////
	НастройкиОтчета.Выбор.Элементы.Очистить();
	
	Для Каждого ПолеОтчета Из ДоступныеРесурсыОтчета Цикл
		Если ПолеОтчета.Пометка Тогда
			
			ПолеРесурса = НастройкиОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ПолеРесурса.Использование = Истина;
			ПолеРесурса.Заголовок = ПолеОтчета.Представление;
			ПолеРесурса.Поле = Новый ПолеКомпоновкиДанных(ПолеОтчета.ИмяПоля);
			
			ПолеРесурса = НастройкиОтчета.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ПолеРесурса.Использование = Истина;
			ПолеРесурса.Заголовок = ПолеОтчета.Представление + ", %";
			ПолеРесурса.Поле = Новый ПолеКомпоновкиДанных(ПолеОтчета.ИмяПоля+"Процент");
			
		КонецЕсли;
	КонецЦикла;
	
    //НастройкиОтчета.Структура.Очистить();
    
    НастройкиОтчета.УсловноеОформление.Элементы[0].Оформление.Элементы.Найти("Формат").Значение = "ЧДЦ=2";
	
	//Отбор = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	//Список = Новый СписокЗначений;
	//Список.ЗагрузитьЗначения(Дилеры.ВыгрузитьКолонку("Наименование"));
	//Отбор.ЛевоеЗначение = НастройкиОтчета.Отбор.ДоступныеПоляОтбора.Элементы.Найти("Дилер");
	//Отбор.ПравоеЗначение = Список;
	
    
    Если ЭтоДиаграмма Тогда
				
    Иначе
		//ЭлементСтруктуры = НастройкиОтчета;
		//Для Каждого Группировка Из Группировки Цикл
		//	// если не указан тип группировки, то установим тип "Элементы"
		//	Если ПустаяСтрока(Группировка.ТипГруппировки) Тогда
		//		Группировка.ТипГруппировки = "Элементы";
		//	КонецЕсли;
		//	
		//	ЭлементСтруктуры = ВложитьГруппировку(ЭлементСтруктуры, Группировка);
		//	
		//КонецЦикла;
		
	КонецЕсли;
	
	//Установим показатель воронки
	ПолеПоказателя = ЭтотОбъект.СхемаКомпоновкиДанных.НаборыДанных[0].Поля.Найти(ПоказательВоронки);
	НастройкиОтчета.Структура.Очистить();
	Поле = НастройкиОтчета.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Элемент = Поле.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	Элемент.Использование = Истина;
	Элемент.Поле = Новый ПолеКомпоновкиДанных("ДилерскийЦентр");
	ЭлементВыбора = Поле.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	Поле = Поле.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Элемент = Поле.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	Элемент.Использование = Истина;
	Элемент.Поле = Новый ПолеКомпоновкиДанных(ПоказательВоронки);
	ЭлементВыбора = Поле.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
		
	СтандартнаяОбработка = Ложь;
	
	СхемаКомпоновкиДанных = ЭтотОбъект.СхемаКомпоновкиДанных;
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	ЗаполнитьНастройкиОтчета(НастройкиОтчета);
	
	//Если ЗначениеЗаполнено(ОтчетМенеджер) Тогда
		//НастройкиОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("Менеджер", ОтчетМенеджер);
		НастройкиОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("Дилер", ?(Дилер = "", Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка(), Дилер));
	//КонецЕсли;
	
	// Далее, устанавливаем значения параметров и загружаем заполненные настройки
	НастройкиОтчета.ПараметрыДанных.УстановитьЗначениеПараметра("Период",Период);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки);
	ТекНабор = МакетКомпоновки.НаборыДанных[0];
	//Парам = МакетКомпоновки.ЗначенияПараметров.Найти("П");
	////Парам.Имя ="П";
	//Парам.Значение = ТекущаяДата();
	ТекНабор.Запрос =СтрЗаменить(ТекНабор.Запрос,"(&П,","(&ТекДата,");
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных,ЭтотОбъект.КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ТекНабор = МакетКомпоновки.НаборыДанных[0];
	//Парам = МакетКомпоновки.ЗначенияПараметров.Найти("П");
	////Парам.Имя ="П";
	//Парам.Значение = ТекущаяДата();
	ТекНабор.Запрос =СтрЗаменить(ТекНабор.Запрос,"(&П,","(&ТекДата,");
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	Дерево = Новый ДеревоЗначений;
	ПроцессорВыводаВКоллекцию = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаВКоллекцию.УстановитьОбъект(Дерево);
	ПроцессорВыводаВКоллекцию.Вывести(ПроцессорКомпоновкиДанных,Истина);
	
	Если Дерево.Строки.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;
	Если Дерево.Строки.Количество()>0 Тогда
		ИтоговаяСтрока = Дерево.Строки.Получить(Дерево.Строки.Количество()-1);
		//ГРАФИК  общий 
		Макет = ПолучитьМакет("Макет");
		ОбластьГрафикВоронки = Макет.ПолучитьОбласть("График");
		Диаграма = ОбластьГрафикВоронки.Рисунки.D1.Объект;
		Диаграма.Очистить();
		Диаграма.ШрифтПодписей = Новый Шрифт(Диаграма.ШрифтПодписей.Имя,8,Диаграма.ШрифтПодписей.Жирный,Диаграма.ШрифтПодписей.Наклонный,Диаграма.ШрифтПодписей.Подчеркивание,Диаграма.ШрифтПодписей.Зачеркивание);
		Диаграма.ОбластьЗаголовка.Текст =  "Статистика продаж с " + Лев(Период.ДатаНачала,10) + " по " + Лев(Период.ДатаОкончания,10);
		Серия = Диаграма.Серии.Добавить("Факт");
		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("Выдачи", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				Точка = Диаграма.Точки.Добавить("Выдачи ( " + СокрЛП(Окр(ИтоговаяСтрока.ВыдачиПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка, Серия, ИтоговаяСтрока.Выдачи);
			КонецЕсли;
		КонецЕсли;
		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ДоговорыКуплиПродажи", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
								
				Точка = Диаграма.Точки.Добавить("Договоры купли-продажи ( "+СокрЛП(Окр(ИтоговаяСтрока.ДоговорыКуплиПродажиПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка, Серия, ИтоговаяСтрока.ДоговорыКуплиПродажи);
			КонецЕсли;
		КонецЕсли;

		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ДоговорыНаАванс", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
								
				Точка = Диаграма.Точки.Добавить("Договоры на аванс ( "+СокрЛП(Окр(ИтоговаяСтрока.ДоговорыНаАвансПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка, Серия, ИтоговаяСтрока.ДоговорыНаАванс);
			КонецЕсли;
		КонецЕсли;
       		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ЗаявкиНаГарантиюВыполнено", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
		
				Точка = Диаграма.Точки.Добавить("Продленная гарантия - продажи ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаГарантиюВыполненоПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаГарантиюВыполнено);
			КонецЕсли;
		КонецЕсли;
						
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ЗаявкиНаГарантию", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				Точка = Диаграма.Точки.Добавить(" Продленная гарантия - заявки ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаГарантиюПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаГарантию);
			КонецЕсли;
		КонецЕсли;
		
		НайденныйРесурс = ДоступныеРесурсыОтчета.Найти("ЗаявкиНаКредитВыполнено", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				
				Точка = Диаграма.Точки.Добавить("Кредит - продажи ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаКредитВыполненоПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаКредитВыполнено);
			КонецЕсли;
		КонецЕсли;

		НайденныйРесурс = ДоступныеРесурсыОтчета.Найти("ЗаявкиНаКредит", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				Точка = Диаграма.Точки.Добавить("Кредит - заявки ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаКредитПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаКредит);
			КонецЕсли;
		КонецЕсли;
		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ЗаявкиНаОборудованиеВыполнено", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
		
				Точка = Диаграма.Точки.Добавить("Доп.оборудование - продажи ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаОборудованиеВыполненоПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаОборудованиеВыполнено);
			КонецЕсли;
		КонецЕсли;

		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ЗаявкиНаОборудование", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				Точка = Диаграма.Точки.Добавить("Доп.оборудование - заявки ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаОборудованиеПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаОборудование);
			КонецЕсли;
		КонецЕсли;
		
		НайденныйРесурс = ДоступныеРесурсыОтчета.Найти("ЗаявкиНаСтраховкуВыполнено", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
		
				Точка = Диаграма.Точки.Добавить("Страхование - продажи ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаСтраховкуВыполненоПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаСтраховкуВыполнено);
			КонецЕсли;
		КонецЕсли;
		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ЗаявкиНаСтраховку", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
			
				Точка = Диаграма.Точки.Добавить("Страхование - заявки ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаСтраховкуПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаСтраховку);
			КонецЕсли;
		КонецЕсли;
		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ЗаявкиНаТрейдИнВыполнено", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				Точка = Диаграма.Точки.Добавить("Трейд-ин - продажи ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаТрейдИнВыполненоПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаТрейдИнВыполнено);
			КонецЕсли;
	    КонецЕсли;

		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("ЗаявкиНаТрейдИн", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				Точка = Диаграма.Точки.Добавить("Трейд-ин - заявки ( "+СокрЛП(Окр(ИтоговаяСтрока.ЗаявкиНаТрейдИнПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка,Серия, ИтоговаяСтрока.ЗаявкиНаТрейдИн);
			КонецЕсли;

		КонецЕсли;
		
		НайденныйРесурс =  ДоступныеРесурсыОтчета.Найти("КоммерческиеПредложения", "ИмяПоля");
		Если Не (НайденныйРесурс = неопределено) Тогда
			Если НайденныйРесурс.Пометка Тогда
				Точка = Диаграма.Точки.Добавить("Коммерческие предложения ( "+СокрЛП(Окр(ИтоговаяСтрока.КоммерческиеПредложенияПроцент, 2))+"% )");
				Диаграма.УстановитьЗначение(Точка, Серия, ИтоговаяСтрока.КоммерческиеПредложения);
			КонецЕсли;
