		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Регистратор,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Период,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Организация,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Подразделение,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Контрагент,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.ДоговорКонтрагента,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.СуммаЗадаткаНачальныйОстаток,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.СуммаЗадаткаПриход,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.СуммаЗадаткаРасход,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.СуммаЗадаткаКонечныйОстаток,
	ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Регистратор.Комментарий КАК Комментарий,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Регистратор) = ТИП(Документ.КорректировкаДвиженийПоЗадаткам)
			ТОГДА ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Регистратор.Менеджер
		ИНАЧЕ ВЫБОР
				КОГДА ТИПЗНАЧЕНИЯ(ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Регистратор) = ТИП(Документ.ПриходныйКассовыйОрдер)
					ТОГДА ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Регистратор.Сделка.Менеджер
				ИНАЧЕ ВзаиморасчетыПоЗадаткамОстаткиИОбороты.Регистратор.Сделка.Сделка.Менеджер
			КОНЕЦ
	КОНЕЦ КАК Менеджер
ИЗ
	РегистрНакопления.ВзаиморасчетыПоЗадаткам.ОстаткиИОбороты(&amp;ДатаНачала, &amp;ДатаОкончания, Регистратор, , ) КАК ВзаиморасчетыПоЗадаткамОстаткиИОбороты</query>
