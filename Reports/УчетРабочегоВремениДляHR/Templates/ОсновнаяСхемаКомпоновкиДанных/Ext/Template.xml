	<totalField>
		<dataPath>ПродолжительностьПлан</dataPath>
		<expression>Сумма(ПродолжительностьПлан)</expression>
	</totalField>
	<totalField>
		<dataPath>ПродолжительностьФакт</dataPath>
		<expression>Сумма(ПродолжительностьФакт)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентПереработки</dataPath>
		<expression>ОКР(Среднее(ПроцентПереработки), 2)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентНедоработки</dataPath>
		<expression>ОКР(Среднее(ПроцентНедоработки), 2)</expression>
	</totalField>
