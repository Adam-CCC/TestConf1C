		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(РегистрацияВремениСотрудника.Период, ДЕНЬ) КАК Дата,
	РегистрацияВремениСотрудника.Сотрудник КАК Сотрудник,
	NULL КАК НачалоПлан,
	NULL КАК КонецПлан,
	РегистрацияВремениСотрудника.Период КАК НачалоФакт,
	РегистрацияВремениСотрудника.КонецРаботы КАК КонецФакт,
	NULL КАК ПродолжительностьПлан,
	ВЫБОР
		КОГДА РегистрацияВремениСотрудника.Продолжительность - 1 &lt; 0
			ТОГДА 0
		ИНАЧЕ РегистрацияВремениСотрудника.Продолжительность - 1
	КОНЕЦ КАК ПродолжительностьФакт
ПОМЕСТИТЬ ВТ_Соответствие
ИЗ
	РегистрСведений.РегистрацияВремениСотрудника КАК РегистрацияВремениСотрудника
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		ПО РегистрацияВремениСотрудника.Сотрудник = Сотрудники.Ссылка
ГДЕ
	РегистрацияВремениСотрудника.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(ГрафикРаботКалендарный.Дата, ДЕНЬ),
	Сотрудники.Ссылка,
	ДОБАВИТЬКДАТЕ(ГрафикРаботКалендарный.НачалоРабочегоВремени, ДЕНЬ, РАЗНОСТЬДАТ(ГрафикРаботКалендарный.НачалоРабочегоВремени, ГрафикРаботКалендарный.Дата, ДЕНЬ)),
	ДОБАВИТЬКДАТЕ(ГрафикРаботКалендарный.КонецРабочегоВремени, ДЕНЬ, РАЗНОСТЬДАТ(ГрафикРаботКалендарный.КонецРабочегоВремени, ГрафикРаботКалендарный.Дата, ДЕНЬ)),
	NULL,
	NULL,
	ВЫБОР
		КОГДА ЧАС(ГрафикРаботКалендарный.Продолжительность) - 1 &lt; 0
			ТОГДА 0
		ИНАЧЕ ЧАС(ГрафикРаботКалендарный.Продолжительность) - 1
	КОНЕЦ,
	NULL
ИЗ
	Справочник.Сотрудники КАК Сотрудники,
	РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
ГДЕ
	Сотрудники.ГрафикРаботы = ГрафикРаботКалендарный.График
	И ГрафикРаботКалендарный.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Соответствие.Дата КАК Дата,
	ВТ_Соответствие.Сотрудник.Подразделение КАК Подразделение,
	ВТ_Соответствие.Сотрудник.Должность КАК Должность,
	ВТ_Соответствие.Сотрудник КАК Сотрудник,
	МАКСИМУМ(ВТ_Соответствие.НачалоПлан) КАК НачалоПлан,
	МАКСИМУМ(ВТ_Соответствие.НачалоФакт) КАК НачалоФакт,
	МАКСИМУМ(ВТ_Соответствие.КонецПлан) КАК КонецПлан,
	МАКСИМУМ(ВТ_Соответствие.КонецФакт) КАК КонецФакт,
	МАКСИМУМ(ВЫБОР
			КОГДА ВТ_Соответствие.ПродолжительностьПлан = 0
				ТОГДА NULL
			ИНАЧЕ ВТ_Соответствие.ПродолжительностьПлан
		КОНЕЦ) КАК ПродолжительностьПлан,
	МАКСИМУМ(ВТ_Соответствие.ПродолжительностьФакт) КАК ПродолжительностьФакт
ПОМЕСТИТЬ ВТ_Объединение
ИЗ
	ВТ_Соответствие КАК ВТ_Соответствие

СГРУППИРОВАТЬ ПО
	ВТ_Соответствие.Сотрудник,
	ВТ_Соответствие.Сотрудник.Подразделение,
	ВТ_Соответствие.Сотрудник.Должность,
	ВТ_Соответствие.Дата
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Объединение.Дата КАК Дата,
	ВТ_Объединение.Подразделение КАК Подразделение,
	ВТ_Объединение.Должность КАК Должность,
	ВТ_Объединение.Сотрудник КАК Сотрудник,
	ВТ_Объединение.НачалоПлан КАК НачалоПлан,
	ВТ_Объединение.НачалоФакт КАК НачалоФакт,
	ВЫБОР
		КОГДА ВТ_Объединение.НачалоПлан = ДАТАВРЕМЯ(1, 1, 1)
				ИЛИ ВТ_Объединение.НачалоФакт = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА NULL
		ИНАЧЕ РАЗНОСТЬДАТ(ВТ_Объединение.НачалоПлан, ВТ_Объединение.НачалоФакт, СЕКУНДА) &gt; 0
	КОНЕЦ КАК Опоздал,
	ВТ_Объединение.КонецПлан КАК КонецПлан,
	ВТ_Объединение.КонецФакт КАК КонецФакт,
	ВЫБОР
		КОГДА ВТ_Объединение.КонецПлан = ДАТАВРЕМЯ(1, 1, 1)
				ИЛИ ВТ_Объединение.КонецФакт = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА NULL
		ИНАЧЕ РАЗНОСТЬДАТ(ВТ_Объединение.КонецФакт, ВТ_Объединение.КонецПлан, СЕКУНДА) &gt; 0
	КОНЕЦ КАК Недоработал,
	ОКР(ВТ_Объединение.ПродолжительностьПлан, 2) КАК ПродолжительностьПлан,
	ОКР(ВТ_Объединение.ПродолжительностьФакт, 2) КАК ПродолжительностьФакт,
	ОКР(ВЫБОР
			КОГДА ВТ_Объединение.ПродолжительностьФакт / ВЫБОР
					КОГДА ВТ_Объединение.ПродолжительностьПлан = 0
						ТОГДА 1
					ИНАЧЕ ВТ_Объединение.ПродолжительностьПлан
				КОНЕЦ * 100 &gt; 100
				ТОГДА ВТ_Объединение.ПродолжительностьФакт / ВЫБОР
						КОГДА ВТ_Объединение.ПродолжительностьПлан = 0
							ТОГДА 1
						ИНАЧЕ ВТ_Объединение.ПродолжительностьПлан
					КОНЕЦ * 100 - 100
		КОНЕЦ, 2) КАК ПроцентПереработки,
	ОКР(ВЫБОР
			КОГДА ВТ_Объединение.ПродолжительностьФакт / ВЫБОР
					КОГДА ВТ_Объединение.ПродолжительностьПлан = 0
						ТОГДА 1
					ИНАЧЕ ВТ_Объединение.ПродолжительностьПлан
				КОНЕЦ * 100 &lt; 100
				ТОГДА 100 - ВТ_Объединение.ПродолжительностьФакт / ВЫБОР
						КОГДА ВТ_Объединение.ПродолжительностьПлан = 0
							ТОГДА 1
						ИНАЧЕ ВТ_Объединение.ПродолжительностьПлан
					КОНЕЦ * 100
		КОНЕЦ, 2) КАК ПроцентНедоработки
ИЗ
	ВТ_Объединение КАК ВТ_Объединение</query>
	</dataSet>
