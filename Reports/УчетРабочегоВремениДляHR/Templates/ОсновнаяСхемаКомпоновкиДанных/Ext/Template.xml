	</totalField>
	<totalField>
		<dataPath>КонецФакт</dataPath>
		<expression>СУММА(ВЫБОР КОГДА КонецФакт = ДАТАВРЕМЯ(1,1,1) ТОГДА 0 ИНАЧЕ 1 КОНЕЦ)</expression>
	</totalField>
	<totalField>
		<dataPath>Недоработал</dataPath>
		<expression>СУММА(ВЫБОР КОГДА Недоработал = ЛОЖЬ ТОГДА 0 ИНАЧЕ 1 КОНЕЦ)</expression>
