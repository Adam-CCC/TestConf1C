		<dataPath>НачалоПлан</dataPath>
		<expression>СУММА(ВЫБОР КОГДА НачалоПлан = ДАТАВРЕМЯ(1,1,1) ТОГДА 0 ИНАЧЕ 1 КОНЕЦ)</expression>
	</totalField>
	<totalField>
