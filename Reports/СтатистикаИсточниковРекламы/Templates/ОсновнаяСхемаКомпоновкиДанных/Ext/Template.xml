			<field>Посещения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РабочийЛист</dataPath>
			<field>РабочийЛист</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Модель</dataPath>
			<field>Модель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодразделениеКомпании</dataPath>
			<field>ПодразделениеКомпании</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Подразделение</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(РабочийЛист.Дата, МЕСЯЦ) КАК Дата,
	РабочийЛист.Реклама КАК Источник,
	ВЫБОР
		КОГДА РабочийЛист.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Посещения,
	ВЫБОР
		КОГДА РабочийЛист.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
				И РабочийЛист.ТипРабочегоЛиста = ЗНАЧЕНИЕ(Перечисление.ТипыСообщений.Входящее)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Звонки,
	ВЫБОР
		КОГДА РабочийЛист.Автомобиль = ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
				ИЛИ РабочийЛист.Автомобиль.Модель = ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
			ТОГДА "&lt;модель не заполнена&gt;"
		ИНАЧЕ РабочийЛист.Автомобиль.Модель
	КОНЕЦ КАК Модель,
	РабочийЛист.Ссылка КАК РабочийЛист,
	РабочийЛист.ПодразделениеКомпании,
	РабочийЛист.Организация
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
ГДЕ
	НЕ РабочийЛист.ПометкаУдаления
	И РабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Продажа)
{ГДЕ
	(ВЫБОР
			КОГДА &amp;ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ РабочийЛист.Дата &gt;= &amp;ДатаНачала
		КОНЕЦ),
	(ВЫБОР
			КОГДА &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА ИСТИНА
			ИНАЧЕ РабочийЛист.Дата &lt;= &amp;ДатаОкончания
		КОНЕЦ)}</query>
	</dataSet>
	<totalField>
		<dataPath>Посещения</dataPath>
		<expression>Сумма(Посещения)</expression>
	</totalField>
	<totalField>
