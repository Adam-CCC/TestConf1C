Процедура СформироватьОтчетВыдача(ТабДокумент) Экспорт 
	
	МакетОтчета = ПолучитьМакет("МакетВыдача" + ТипМакета);
	ОбластьЗаголовка = МакетОтчета.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовка = ПромасштабироватьШирину(ОбластьЗаголовка);
	
	ОбластьЗаголовка.Параметры.Дата = Формат(ДатаОтчета,"ДФ = 'дд.ММ.гггг Ч:мм:сс'");
	ОбластьЗаголовка.Параметры.ДеньНедели = ТРег(Формат(ДатаОтчета,"ДФ = 'дддд'"));
	
	ТабДокумент.Вывести(ОбластьЗаголовка);
	
	ОбластьШапкаТаблицы = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьШапкаТаблицы = ПромасштабироватьШирину(ОбластьШапкаТаблицы);
	
	ТабДокумент.Вывести(ОбластьШапкаТаблицы);
	
	ДатаОтчета = ТекущаяДата();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СчетчикСтрок = 0;
	
	ОбластьМакета = МакетОтчета.ПолучитьОбласть("Строка");
	ОбластьМакета = ПромасштабироватьШирину(ОбластьМакета);
	
	Пока  Истина  Цикл  
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
		ОбластьМакета.Параметры.ЗН 	   = Выборка.ЗаказНаряд;
		ОбластьМакета.Параметры.Время  = Формат(Выборка.Время, "ДФ = 'Ч:мм'");
		ОбластьМакета.Параметры.Клиент = Выборка.Заказчик;
		ОбластьМакета.Параметры.Модель = Выборка.Автомобиль.Модель;
		ОбластьМакета.Параметры.Мастер = Выборка.ЗаказНаряд.Мастер;
		Если Выборка.Время > ДатаОтчета Тогда
			ОбластьМакета.Параметры.Статус = "" + Выборка.Состояние;
		Иначе
			ОбластьМакета.Параметры.Статус = "Задержан";
		КонецЕсли;
		Авто = Выборка.Автомобиль.ПолучитьОбъект();
		//ОбластьМакета.Параметры.Номер = Авто.ЧтениеЗначенияРегистраСведения(Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
		ОбластьМакета.Параметры.Номер  =     Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Выборка.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,Выборка.ЗаказНаряд.ДатаСоздания);
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	КартинкиИФайлы.Идентификатор,
		|	КартинкиИФайлы.ИмяФайла,
		|	КартинкиИФайлы.Данные,
		|	КартинкиИФайлы.ДанныеВоВнешнемФайле
		|ИЗ
		|	РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы
		|ГДЕ
		|	КартинкиИФайлы.Объект = &ОбъектИнформации
		|	И КартинкиИФайлы.Картинка = ИСТИНА
		|АВТОУПОРЯДОЧИВАНИЕ");
		
		Попытка
			Запрос.УстановитьПараметр("ОбъектИнформации",Выборка.ЗаказНаряд.Мастер);
			РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			Если РезультатЗапроса.Количество()>0 Тогда			
				СтрокаКартинка = РезультатЗапроса[0];
				Если СтрокаКартинка.ДанныеВоВнешнемФайле Тогда
					ОбластьМакета.Рисунки.Фото.Картинка = Новый Картинка(СтрокаКартинка.ИмяФайла,Ложь);				
				Иначе
					ОбластьМакета.Рисунки.Фото.Картинка= СтрокаКартинка.Данные.Получить();
				КонецЕсли;			
			Иначе
				ОбластьМакета.Рисунки.Фото.Картинка = Новый Картинка;
			КонецЕсли;				
		Исключение
		КонецПопытки;
		
		
		ТабДокумент.Вывести(ОбластьМакета);
		
		Если СчетчикСтрок >= СтрокНаСтраницу Тогда
			Прервать;
		КонецЕсли;
		
		Если НЕ Выборка.Следующий() Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

