Процедура СформироватьОтчетПриемка(ТабДокумент) Экспорт 
	
	МакетОтчета = ПолучитьМакет("МакетПриемка" + ТипМакета);
	ОбластьЗаголовка = МакетОтчета.ПолучитьОбласть("Заголовок");
	
	ОбластьЗаголовка = ПромасштабироватьШирину(ОбластьЗаголовка);
	
	ОбластьЗаголовка.Параметры.Дата = Формат(ДатаОтчета,"ДФ = 'дд.ММ.гггг Ч:мм:сс'");
	//ОбластьЗаголовка.Параметры.ДеньНедели = ТРег(Формат(ДатаОтчета,"ДФ = 'дддд'"));
	
	ТабДокумент.Вывести(ОбластьЗаголовка);
	ТабДокумент.ТОлькоПРосмотр= Истина;
	ОбластьШапкаТаблицы = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьШапкаТаблицы = ПромасштабироватьШирину(ОбластьШапкаТаблицы);
	
	ТабДокумент.Вывести(ОбластьШапкаТаблицы);
	
	ДатаОтчета = ТекущаяДата();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СчетчикСтрок = 0;
	
	ОбластьСтрока = МакетОтчета.ПолучитьОбласть("Строка");
	ОбластьСтрока = ПромасштабироватьШирину(ОбластьСтрока);
	
	ОбластьЕстьЗН = МакетОтчета.ПолучитьОбласть("СтрокаЕстьВыдача");
	ОбластьЕстьЗН = ПромасштабироватьШирину(ОбластьЕстьЗН);
	
	Пока  Истина  Цикл  
		СчетчикСтрок = СчетчикСтрок + 1;
		
		Если Выборка.Завершено Тогда
			ОбластьМакета = ОбластьЕстьЗН;
			//ОбластьМакета.Параметры.Статус = Выборка.Статус ;
			
			ОбластьМакета.Параметры.Менеджер = Выборка.Менеджер;
			ОбластьМакета.Параметры.Модель = Выборка.Модель;
					ОбластьМакета.Параметры.VIN = Выборка.VIN;
         	ОбластьМакета.Параметры.Время = Выборка.ПланируемоеВремяВыдачи;

		Иначе
					ОбластьМакета = ОбластьСтрока;

			ОбластьМакета.Параметры.Менеджер = Выборка.Менеджер;
			ОбластьМакета.Параметры.Модель = Выборка.Модель;
					ОбластьМакета.Параметры.VIN = Выборка.VIN;
         	ОбластьМакета.Параметры.Время = Выборка.ПланируемоеВремяВыдачи;

			
			
		КонецЕсли;
		ОбластьМакета.Параметры.ЗР	   = Выборка.Событие;

		//
		//ОбластьМакета.Параметры.ВремяВыдачи = Выборка.ВремяВыдачи;
		//
		//Если Выборка.Статус = Справочники.ВидыСостоянийЗаказНарядов.Выполнен  тогда
		//	ОбластьМакета.Параметры.Статус = "Готов";
		//	
		//КонецЕсли;  
		//Если Выборка.Статус = Справочники.ВидыСостоянийЗаказНарядов.Закрыт  тогда
		//	ОбластьМакета.Параметры.Статус = "Выдан";
		//	
		//КонецЕсли;
		//
		//ОбластьМакета.Параметры.ЗР	   = Выборка.Заявка;
