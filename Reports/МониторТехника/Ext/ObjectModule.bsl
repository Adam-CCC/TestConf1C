// расстягивает ширину колонок на заданное в форме количество раз
Функция ПромасштабироватьШирину(Область)
	Для Сч = 1 По Область.ШиринаТаблицы Цикл
		Область.Область(1,сч,1,сч).ШиринаКолонки = Область.Область(1,сч,1,сч).ШиринаКолонки * Коэффициент;
	КонецЦикла;
	Возврат Область;
КонецФункции

//Заполняет начальные настройки
//
//Без параметров
//
Процедура ЗаполнитьНачальныеНастройки() Экспорт
	Если ПериодСменыСтраниц = 0 Тогда
		ПериодСменыСтраниц = 1;
	КонецЕсли;
	Если СтрокНаСтраницу = 0 Тогда
		СтрокНаСтраницу = 1;
	КонецЕсли;
	Если Коэффициент = 0 Тогда
		Коэффициент = 1;
	КонецЕсли;
	
	// фильтры
	ДоступныеПоляОтбора.Очистить();
	//ПолеНастройки=ДоступныеПоляОтбора.Добавить("Организация","Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	//ПолеНастройки.Отбор=Истина;
	ПолеНастройки=ДоступныеПоляОтбора.Добавить("Подразделение","Подразделение",Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
	ПолеНастройки.Отбор=Истина;
	ФильтрыОтчета.УстановитьДоступныеПоля(ДоступныеПоляОтбора);
	//ФильтрыОтчета.Добавить("Организация","Организация","Организация");
	ФильтрыОтчета.Добавить("Подразделение","Подразделение","Подразделение");
	ФильтрыОтчета.Подразделение.Значение = ПараметрыСеанса.Пользователь.Подразделение;
	ФильтрыОтчета.Подразделение.Использование = Истина;
	ФильтрыОтчета.Подразделение.ВидСравнения = ВидСравнения.ВИерархии;
	//ФильтрыОтчета.Организация.Значение = ПараметрыСеанса.Пользователь.Организация;
	//ФильтрыОтчета.Организация.Использование = Истина;
КонецПроцедуры // ЗаполнитьНачальныеНастройки()

//Формирует текст запроса
//получаем все документы (Заявки) и их "рабочие места" по регистру ГрафикРаботыРесурсов из интервала [ДатаНачала ДатаКонца] и индикатор наличия ЗН 
Функция ПолучитьТекстЗапроса()
	
	// формируем строку фильтров виртуальной таблицы
	СтрокаУсловия="";
	Для Каждого ЭлементОтбора Из ФильтрыОтчета Цикл
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		СтрокаУсловия = СтрокаУсловия + " И " + СтрЗаменить(СтрЗаменить(отСформироватьСтрокуВидаСравнения(ЭлементОтбора.ВидСравнения),"#","#ИмяТаблицы#" + ЭлементОтбора.ПутьКДанным),"&","&"+ЭлементОтбора.Имя);
	КонецЦикла;
	
	СтрокаУсловия = СтрЗаменить(СтрокаУсловия, "#ИмяТаблицы#", "СобытиеКонтрагенты.Ссылка.");
	СтрокаУсловия = СтрЗаменить(СтрокаУсловия, "СобытиеКонтрагенты.Ссылка.Подразделение", "СобытиеКонтрагенты.Ссылка.ПодразделениеКомпании");
	
	
	// 1 пакет: получаем Заявки
	// 2 пакет: получаем ЗН на них
	// 3 пакет: пишем истина там где ЗН есть        
	
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СобытиеКонтрагенты.Ссылка КАК Ссылка,
	|	СобытиеКонтрагенты.Контрагент КАК Контрагент,
	|	СобытиеКонтрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ПОМЕСТИТЬ СобытиеКонтрагенты
	|ИЗ
	|	Документ.Событие.СторонниеЛица КАК СобытиеКонтрагенты
	|ГДЕ
	|	СобытиеКонтрагенты.Ссылка.ПланируемаяДатаВыдачиАвтомобиля МЕЖДУ &ДатаНачала И &ДатаОкончания
	|{ГДЕ
	|	СобытиеКонтрагенты.Ссылка.* КАК Событие,
	|	СобытиеКонтрагенты.Контрагент.* КАК Контрагент,
	|	СобытиеКонтрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация,
	|	СобытиеКонтрагенты.Ссылка.ВидСобытия КАК ВидСобытия}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Событие.ПланируемаяДатаВыдачиАвтомобиля КАК ПланируемаяДатаВыдачи,
	|	Событие.ПланируемоеВремяВыдачиАвтомобиля КАК ПланируемоеВремяВыдачи,
	|	Событие.Ссылка КАК Событие,
	|	СобытиеКонтрагенты.Контрагент КАК Контрагент,
	|	СобытиеКонтрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация,
	|	Событие.Автомобиль КАК Автомобиль,
	|	Событие.ВидСобытия КАК ВидСобытия,
	|	Событие.Автомобиль.Модель КАК Модель,
	|	Событие.Продавец КАК Менеджер,
	|	Событие.Организация,
	|	Событие.ПодразделениеКомпании,
	|	ВЫБОР
	|		КОГДА Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Завершено,
	|	Событие.Автомобиль.VIN КАК VIN
	|ИЗ
	|	Документ.Событие КАК Событие
	|		ЛЕВОЕ СОЕДИНЕНИЕ СобытиеКонтрагенты КАК СобытиеКонтрагенты
	|		ПО Событие.Ссылка = СобытиеКонтрагенты.Ссылка
	|ГДЕ
	|	Событие.ПланируемаяДатаВыдачиАвтомобиля МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ВыдачаАвтомобиля) " + СтрокаУсловия + "  ";
	
	Возврат ТекстЗапроса;
КонецФункции //ПолучитьТекстЗапроса()

//Формирует текст запроса
//получаем все документы (Заказ-Наряды) и их статусы из интервала [ДатаНачала ДатаКонца]
Функция ПолучитьТекстЗапроса_2()
	
	// формируем строку фильтров виртуальной таблицы
	СтрокаУсловия="";
	Для Каждого ЭлементОтбора Из ФильтрыОтчета Цикл
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		СтрокаУсловия = СтрокаУсловия + " И " + СтрЗаменить(СтрЗаменить(отСформироватьСтрокуВидаСравнения(ЭлементОтбора.ВидСравнения),"#","#ИмяТаблицы#" + ЭлементОтбора.ПутьКДанным),"&","&"+ЭлементОтбора.Имя);
	КонецЦикла;
	
	СтрокаУсловия = СтрЗаменить(СтрокаУсловия, "#ИмяТаблицы#", "ЗаказНаряд.");
	СтрокаУсловия = СтрЗаменить(СтрокаУсловия, "ЗаказНаряд.Подразделение", "ЗаказНаряд.ПодразделениеКомпании");
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЗаказНаряд.Ссылка) КАК ЗаказНаряд,
	|	МАКСИМУМ(ЗаказНаряд.ПлановаяДатаВыдачи) КАК Время,
	|	МАКСИМУМ(ЗаказНаряд.Диспетчер) КАК Мастер,
	|	ЗаказНаряд.Автомобиль,
	|	ЗаказНаряд.Заказчик,
	|	ЗаказНаряд.Состояние
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.ПлановаяДатаВыдачи МЕЖДУ &ДатаНачала И &ДатаКонца " + СтрокаУсловия + "
	|	И ЗаказНаряд.Состояние <> &Состояние
	|   И   ЗаказНаряд.Заказчик <> &Заказчик
	|	И НЕ ЗаказНаряд.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	ЗаказНаряд.Автомобиль,
	|	ЗаказНаряд.Заказчик,
	|	ЗаказНаряд.Состояние
	|УПОРЯДОЧИТЬ ПО
	|	Время
	|";
	
	Возврат ТекстЗапроса;
КонецФункции //ПолучитьТекстЗапроса_2()

