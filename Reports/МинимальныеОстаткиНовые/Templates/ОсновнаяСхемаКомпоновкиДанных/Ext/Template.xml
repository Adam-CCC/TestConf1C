		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ДополнительныеРеквизитыНоменклатурыСрезПоследних.Номенклатура,
	ДополнительныеРеквизитыНоменклатурыСрезПоследних.ПодразделениеКомпании,
	ДополнительныеРеквизитыНоменклатурыСрезПоследних.ЗначениеРеквизита КАК МинОстаток,
	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК ОстатокНаСкладах,
	ЗаказыПоставщикамОстатки.ЗаказаноОстаток,
	ОстаткиТоваровКомпанииОстатки.СкладКомпании,
	ДополнительныеРеквизитыНоменклатурыСрезПоследних.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	ОстаткиТоваровКомпанииОстатки.РезервОстаток,
	ДополнительныеРеквизитыНоменклатурыСрезПоследних.Номенклатура.Артикул КАК Артикул
ИЗ
	РегистрСведений.ДополнительныеРеквизитыНоменклатуры.СрезПоследних(&amp;ДатаОстатков, ) КАК ДополнительныеРеквизитыНоменклатурыСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&amp;ДатаОстатков, ) КАК ОстаткиТоваровКомпанииОстатки
		ПО ДополнительныеРеквизитыНоменклатурыСрезПоследних.Номенклатура = ОстаткиТоваровКомпанииОстатки.Номенклатура
			И ДополнительныеРеквизитыНоменклатурыСрезПоследних.ПодразделениеКомпании = ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки(&amp;ДатаОстатков, ) КАК ЗаказыПоставщикамОстатки
		ПО ДополнительныеРеквизитыНоменклатурыСрезПоследних.Номенклатура = ЗаказыПоставщикамОстатки.Номенклатура
			И ДополнительныеРеквизитыНоменклатурыСрезПоследних.ПодразделениеКомпании = ЗаказыПоставщикамОстатки.ЗаказПоставщику.ПодразделениеКомпании
ГДЕ
	ДополнительныеРеквизитыНоменклатурыСрезПоследних.ДополнительныйРеквизит = ЗНАЧЕНИЕ(Перечисление.ДополнительныеРеквизитыНоменклатуры.Минимальныйостаток)</query>
	</dataSet>
	<calculatedField>
		<dataPath>Нехватка</dataPath>
		<expression>ЕстьNULL(ОстатокНаСкладах,0)-ЕстьNULL(МинОстаток,0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Нед./Прев.</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ОсталосьЗаказать</dataPath>
		<expression>ЕстьNULL(МинОстаток,0)-ЕстьNULL(ОстатокНаСкладах,0)+ЕстьNULL(РезервОстаток,0) -ЕстьNULL(ЗаказаноОстаток,0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Осталось заказать</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
