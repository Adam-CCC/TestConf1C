    ПартииТоваровКомпанииОстатки.ХарактеристикаНоменклатуры,
    ПартииТоваровКомпанииОстатки.СтатусПартии,
    ПартииТоваровКомпанииОстатки.Партия,
    ПартииТоваровКомпанииОстатки.КоличествоОстаток,
    ПартииТоваровКомпанииОстатки.СуммаОстаток
ПОМЕСТИТЬ ВТ_НеликвидыПрошлогоПериода
ИЗ
    РегистрНакопления.ПартииТоваровКомпании.Остатки(&amp;ПрошлыйПериод, Партия.Дата &lt; ДОБАВИТЬКДАТЕ(&amp;ПрошлыйПериод, ДЕНЬ, -1 * &amp;КоличествоДнейНеликвида)) КАК ПартииТоваровКомпанииОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.СкладКомпании, ВТ_НеликвидыПрошлогоПериода.СкладКомпании) КАК СкладКомпании,
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.Артикул, ВТ_НеликвидыПрошлогоПериода.Артикул) КАК Артикул,
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.Номенклатура, ВТ_НеликвидыПрошлогоПериода.Номенклатура) КАК Номенклатура,
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.ХарактеристикаНоменклатуры, ВТ_НеликвидыПрошлогоПериода.ХарактеристикаНоменклатуры) КАК ХарактеристикаНоменклатуры,
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.СтатусПартии, ВТ_НеликвидыПрошлогоПериода.СтатусПартии) КАК СтатусПартии,
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.Партия, ВТ_НеликвидыПрошлогоПериода.Партия) КАК Партия,
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.КоличествоОстаток, 0) КАК КоличествоТекущийПериод,
    ЕСТЬNULL(ВТ_ТекущиеНеликвиды.СуммаОстаток, 0) КАК СуммаТекущийПериод,
    ЕСТЬNULL(ВТ_НеликвидыПрошлогоПериода.КоличествоОстаток, 0) КАК КоличествоПрошлыйПериод,
    ЕСТЬNULL(ВТ_НеликвидыПрошлогоПериода.СуммаОстаток, 0) КАК СуммаПрошлыйПериод
ИЗ
    ВТ_ТекущиеНеликвиды КАК ВТ_ТекущиеНеликвиды
        ПОЛНОЕ СОЕДИНЕНИЕ ВТ_НеликвидыПрошлогоПериода КАК ВТ_НеликвидыПрошлогоПериода
        ПО ВТ_ТекущиеНеликвиды.СкладКомпании = ВТ_НеликвидыПрошлогоПериода.СкладКомпании
            И ВТ_ТекущиеНеликвиды.Номенклатура = ВТ_НеликвидыПрошлогоПериода.Номенклатура
            И ВТ_ТекущиеНеликвиды.ХарактеристикаНоменклатуры = ВТ_НеликвидыПрошлогоПериода.ХарактеристикаНоменклатуры
            И ВТ_ТекущиеНеликвиды.СтатусПартии = ВТ_НеликвидыПрошлогоПериода.СтатусПартии
            И ВТ_ТекущиеНеликвиды.Партия = ВТ_НеликвидыПрошлогоПериода.Партия
            И ВТ_ТекущиеНеликвиды.Артикул = ВТ_НеликвидыПрошлогоПериода.Артикул</query>
