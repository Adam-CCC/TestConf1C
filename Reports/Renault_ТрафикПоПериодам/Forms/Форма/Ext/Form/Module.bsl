Процедура СохранитьНастройки(Команда)
	// Вставить содержимое обработчика.
	//Форма = ПолучитьФорму("ФормаСохраненияВариантовОтчетов");
	//Итог = Форма.ОткрытьМодально();
	
	Форма = ПолучитьФорму("Отчет.Renault_ТрафикПоПериодам.Форма.ФормаСохраненияНастроек");
	Форма.СохраненыеРанееНастройки = ХранилищеПользовательскихНастроекОтчетов.ПолучитьСписок("Отчеты.Renault_ТрафикПоПериодам.ПоУмолчанию");
	Форма.ВыбранноеЗначение = ТекущаяНастройка;
	Если Форма.ОткрытьМодально() = Истина Тогда
		Если СтрДлина(СокрЛП(Форма.ВыбранноеЗначение))>0 Тогда
		//ИмяКлюча = SaveSettingsName;
			ПередЗакрытиемСервер(СокрЛП(Форма.ВыбранноеЗначение));
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	// Вставить содержимое обработчика.
	СписокВариантов = ХранилищеПользовательскихНастроекОтчетов.ПолучитьСписок("Отчеты.Renault_ТрафикПоПериодам.ПоУмолчанию");
	Итог = СписокВариантов.ВыбратьЭлемент("Выберите нужные настройки",СписокВариантов.НайтиПоЗначению(ТекущаяНастройка));
	Если Итог = Неопределено Тогда
		
		ЗагрузитьНастройкиИзХранилищаСервер("Последняя использованная настройка с городом");
		
	Иначе
		
		ЗагрузитьНастройкиИзХранилищаСервер(Итог.Значение);
		
	КонецЕсли;
	ПриОкончанииРедактированияНастроекКДНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не Renault_РаботаСПравамиПользователя.ЕстьПравоОткрытияОтчетапродаж(ПараметрыСеанса.Пользователь,"Renault_ТрафикПоПериодам") тогда
		Сообщить("Недостаточно прав доступа.");
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
КонецПроцедуры

