&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначениямиПоУмолчанию();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СКД = ОбработкаОбъект.ПолучитьСхемуКД();
	
	СтруктураДополнительныхСвойств = ОбработкаОбъект.ПолучитьСписокДополнительныеПоля();
	
	// Поместим схему во временное хранилище
	URLСхемы = ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор);
	
	// Создадим источник
	ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
	НастройкиКД.Инициализировать(ИсточникДоступныхНастроек);
	НастройкиКД.ЗагрузитьНастройки(ПолучитьТекущиеНастройкиКопмоновки(СтруктураНастроек)); 
	ТекущаяНастройка = "Последняя использованная настройка с городом"; 
	ЗагрузитьНастройкиИзХранилищаСервер(ТекущаяНастройка);
	

	//+++ DMSREN-700
	Если ВыбранныеПоля.НайтиПоЗначению("Город")= Неопределено Тогда 
		НастройкиГруппировкиПоСтрокам.Добавить("Город",, Ложь);
		Элементы.ИзмерениеДиаграммы.СписокВыбора.Добавить("Город");
		ВыбранныеПоля.Добавить("Город",, Ложь);
	КонецЕсли;
	
	Если Не ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.ИспользоватьГородВТрафике Тогда 
		НастройкиГруппировкиПоСтрокам.Удалить(НастройкиГруппировкиПоСтрокам.НайтиПоЗначению("Город"));
		Элементы.ИзмерениеДиаграммы.СписокВыбора.Удалить(Элементы.ИзмерениеДиаграммы.СписокВыбора.НайтиПоЗначению("Город"));
		ВыбранныеПоля.Удалить(ВыбранныеПоля.НайтиПоЗначению("Город"));
	КонецЕсли;
	//---	
КонецПроцедуры

&НаСервере
процедура ЗагрузитьНастройкиИзХранилищаСервер(КлючНастроек ="Последняя использованная настройка с городом")
	
	Настр  = ХранилищеПользовательскихНастроекОтчетов.Загрузить("Отчеты.Renault_ТрафикПоПериодам.ПоУмолчанию",КлючНастроек);
	ТекущаяНастройка = КлючНастроек;
	Если не (настр = Неопределено) Тогда
		Поля = новый СписокЗначений();
		Если Настр.свойство("ВыбранныеПоля",Поля)Тогда 
			////Поля = Настр.поля;
			ВыбранныеПоля = Поля;
			//Для каждого Поле из Поля Цикл
			//	ТекПоле = ВыбранныеПоля.НайтиПоЗначению(Поле.Значение);
			//	Если НЕ(ТекПоле = неопределено)Тогда
			//		ТекПоле.Пометка = Поле.пометка;
			//	КонецЕсли;
			//
			//КонецЦикла;
		КонецЕсли;
		
		Если Настр.свойство("НастройкиГруппировкиПоСтрокам",Поля)Тогда 
			//Поля = Настр.НастройкиГруппировкиПоСтрокам;
			НастройкиГруппировкиПоСтрокам = Поля;
			//Для каждого Поле из Поля Цикл
			//	ТекПоле = НастройкиГруппировкиПоСтрокам.НайтиПоЗначению(Поле.Значение);
			//	Если НЕ(ТекПоле = неопределено)Тогда
			//		ТекПоле.Пометка = Поле.пометка;
			//	КонецЕсли;
			//
			//КонецЦикла;
        КонецЕсли;

		Если Настр.свойство("Периодичность")Тогда
        	Периодичность = Настр.Периодичность;
		КонецЕсли;
		Если Настр.свойство("Период")Тогда
        	Период = Настр.Период;
		КонецЕсли;

		Если Настр.свойство("ИзмерениеДиаграммы")Тогда
           ИзмерениеДиаграммы = Настр.ИзмерениеДиаграммы;
	   КонецЕсли;
	   Если Настр.Свойство("НастройкиКДПользовательскиеНастройки")Тогда
		   НастройкиКД.ЗагрузитьПользовательскиеНастройки(Настр.НастройкиКДПользовательскиеНастройки);
	   КонецЕсли;
	   
		
		//ЗначенияВыводимыеНаДиаграмму.ЗагрузитьЗначения(МассивДиа);
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере	
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	СтруктураНастроек = Настройки["СтруктураНастроек"];
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СКД = ОбработкаОбъект.ПолучитьСхемуКД();
	
	// Поместим схему во временное хранилище
	URLСхемы = ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор);
	
	// Создадим источник
	ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
	НастройкиКД.Инициализировать(ИсточникДоступныхНастроек);
	НастройкиКД.ЗагрузитьНастройки(ПолучитьТекущиеНастройкиКопмоновки(СтруктураНастроек)); 	
	
	ДобавитьДополнительноеПоле();
	
	

КонецПроцедуры

