&НаСервере
Процедура ЗаполнитьСписокВозможныхЗначенийНаСервере()
	
	Если ЗначениеЗаполнено(АдресТаблицыДанных) Тогда 
		
		Если ЗначениеЗаполнено(ИзмерениеДиаграммы) Тогда 
			
			ТаблицаДанных = ПолучитьИзВременногоХранилища(АдресТаблицыДанных);
			ВремТаблицаДанных = ТаблицаДанных.Скопировать();
			Если ВремТаблицаДанных.Колонки.Найти(ИзмерениеДиаграммы) <> Неопределено Тогда 
				ВремТаблицаДанных.Свернуть(ИзмерениеДиаграммы);
			Иначе 
				Возврат;
			КонецЕсли;
			
			ЗначенияВыводимыеНаДиаграмму.ЗагрузитьЗначения(ВремТаблицаДанных.ВыгрузитьКолонку(ИзмерениеДиаграммы));
			
			Для Каждого ВыводимоеЗначение Из ЗначенияВыводимыеНаДиаграмму Цикл 
				
				Если Не ЗначениеЗаполнено(ВыводимоеЗначение.Значение)  Тогда 
					
					ВыводимоеЗначение.Представление = "<не заполнено>";
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе 
		сфСообщитьОбОшибке("Нет данных для заполнения значений...");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиСКДПоНастройкамПользователя(НастройкиКомпоновки)
	
	НастройкиКомпоновки.Структура.Очистить();
	
	ТаблицаКомпоновки = НастройкиКомпоновки.Структура.Добавить(Тип("ТаблицаКомпоновкиДанных"));
	
	НастройкиКомпоновки.Порядок.Элементы.Очистить();
	
	ТекущаяГруппировкаПоСтрокам = Неопределено;
	Для Каждого ГруппировкаПоСтрокам Из НастройкиГруппировкиПоСтрокам Цикл 
		Если ГруппировкаПоСтрокам.Пометка Тогда 
			Если ТекущаяГруппировкаПоСтрокам = Неопределено Тогда 
				ТекущаяГруппировкаПоСтрокам = ДобавитьГруппировкуСКДПоПолям(ТаблицаКомпоновки.Строки, ГруппировкаПоСтрокам.Значение);
			Иначе 
				ТекущаяГруппировкаПоСтрокам = ДобавитьГруппировкуСКДПоПолям(ТекущаяГруппировкаПоСтрокам.Структура, ГруппировкаПоСтрокам.Значение);
			КонецЕсли;
			ДобавитьПорядокКомпоновкиДанных(НастройкиКомпоновки, ГруппировкаПоСтрокам.Значение);


		КонецЕсли;
	КонецЦикла;
	
	СтрокаВыбранныхПолей = "";
	Для Каждого ВыбранноеПоле Из ВыбранныеПоля Цикл 
		Если ВыбранноеПоле.Пометка Тогда 
			СтрокаВыбранныхПолей = СтрокаВыбранныхПолей + ?(ЗначениеЗаполнено(СтрокаВыбранныхПолей), ",", "") + ПроеобразоватьПредставление(Строка(ВыбранноеПоле.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Если ТекущаяГруппировкаПоСтрокам = Неопределено Тогда 
		ДобавитьГруппировкуСКДПоПолям(ТаблицаКомпоновки.Строки, СтрокаВыбранныхПолей);
	Иначе 
		ДобавитьГруппировкуСКДПоПолям(ТекущаяГруппировкаПоСтрокам.Структура, СтрокаВыбранныхПолей);
	КонецЕсли;
	
	ДобавитьГруппировкуСКДПоПолям(ТаблицаКомпоновки.Колонки, Периодичность);
	
	ДобавитьПорядокКомпоновкиДанных(НастройкиКомпоновки, Периодичность);
	
	
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьДиаграммуПоНастройкамНаСервере()
	
	Если ЗначениеЗаполнено(АдресТаблицыДанных) И ЗначениеЗаполнено(Периодичность) Тогда 
		
		ТаблицаДанных = ПолучитьИзВременногоХранилища(АдресТаблицыДанных);
		
		ТаблицаДиаграммы = Новый ТаблицаЗначений;
		ТаблицаДиаграммы.Колонки.Добавить("ИмяТочки");
		
		Сч = 1;
		
		ВремТаблицаДанных = ТаблицаДанных.Скопировать();
		
		Если Не ЗначениеЗаполнено(ИзмерениеДиаграммы) Или НетПомеченныхЗначенийВСпискеЗначений(ЗначенияВыводимыеНаДиаграмму) Тогда 
			ВремТаблицаДанных.Свернуть(Периодичность, "Количество");
		ИначеЕсли ВремТаблицаДанных.Колонки.Найти(ИзмерениеДиаграммы) <> Неопределено Тогда 
			ВремТаблицаДанных.Свернуть(ИзмерениеДиаграммы + ", " + Периодичность, "Количество");
		Иначе 
			Возврат;
		КонецЕсли;
		
		Для Каждого ЗначениеДляДиаграммы Из ЗначенияВыводимыеНаДиаграмму Цикл 
			
			Если ЗначениеДляДиаграммы.Пометка Тогда 
				
				НайденныеСтроки = ВремТаблицаДанных.НайтиСтроки(Новый Структура(ИзмерениеДиаграммы, ЗначениеДляДиаграммы.Значение));
				
				КолонкаСерии = ТаблицаДиаграммы.Колонки.Добавить("Колонка" + Сч, , Строка(?(ЗначениеЗаполнено(ЗначениеДляДиаграммы.Значение), ЗначениеДляДиаграммы.Значение, ЗначениеДляДиаграммы.Представление)));
				
				Сч = Сч + 1;
				Для Каждого СтрокаДанных Из НайденныеСтроки Цикл 
					
					СуществующаяСтрока = ТаблицаДиаграммы.Найти(СтрокаДанных[Периодичность], "ИмяТочки");
					Если СуществующаяСтрока = Неопределено Тогда 
						НовСтрока = ТаблицаДиаграммы.Добавить();
					Иначе 
						НовСтрока = СуществующаяСтрока;
					КонецЕсли;
					НовСтрока.ИмяТочки = СтрокаДанных[Периодичность];
					НовСтрока[КолонкаСерии.Имя] = СтрокаДанных.Количество;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Если никаких данных не выбрано просто выведем все данные в один график
		Если ВремТаблицаДанных.Колонки.Количество() = 2 Тогда 
			
			КолонкаСерии = ТаблицаДиаграммы.Колонки.Добавить("Колонка" + Сч, , "Весь трафик");
			
			Для Каждого СтрокаДанных Из ВремТаблицаДанных Цикл 
				
				СуществующаяСтрока = ТаблицаДиаграммы.Найти(СтрокаДанных[Периодичность], "ИмяТочки");
				Если СуществующаяСтрока = Неопределено Тогда 
					НовСтрока = ТаблицаДиаграммы.Добавить();
				Иначе 
					НовСтрока = СуществующаяСтрока;
				КонецЕсли;
				НовСтрока.ИмяТочки = СтрокаДанных[Периодичность];
				НовСтрока[КолонкаСерии.Имя] = СтрокаДанных.Количество;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ТаблицаДиаграммы.Сортировать("ИмяТочки");
		
		Диаграмма.СерииВСтроках = Ложь;
		Диаграмма.ТипДиаграммы = ТипДиаграммы.График;
		Диаграмма.ИсточникДанных = ТаблицаДиаграммы;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДополнительноеПоле()
	
	Если СписокВыбранныхДопПолей.Количество() > 0 Тогда 
		
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		СКД = ОбработкаОбъект.ПолучитьСхемуКД();
		// Поместим схему во временное хранилище
		
		Для Каждого ВыбранноеПоле Из СписокВыбранныхДопПолей Цикл 
			
			ИмяНовогоПоля = ПроеобразоватьПредставление(ВыбранноеПоле.Представление);
			
			НовоеПолеСКД = СКД.НаборыДанных.ВнешнийИсточник.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			
			НовоеПолеСКД.Поле = ИмяНовогоПоля;
			НовоеПолеСКД.Заголовок = ВыбранноеПоле.Представление;
			НовоеПолеСКД.ПутьКДанным = ИмяНовогоПоля;
			НовоеПолеСКД.ТипЗначения = ВыбранноеПоле.Значение.ТипЗначения;
					
			НовОтбор = СКД.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			НовОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяНовогоПоля);	
			НовОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
			НовОтбор.Использование = Ложь;
			НовОтбор.ИдентификаторПользовательскойНастройки = Строка(Новый УникальныйИдентификатор);
	
			Если ВыбранныеПоля.НайтиПоЗначению(ВыбранноеПоле.Значение) = Неопределено Тогда 
				НовВыбранноеПоле = ВыбранныеПоля.Добавить();
				НовВыбранноеПоле.Значение = ВыбранноеПоле.Значение;
				НовВыбранноеПоле.Представление = ВыбранноеПоле.Представление;
				НовВыбранноеПоле.Пометка = Истина;
			КонецЕсли;
			
		КонецЦикла;
	
		URLСхемы = ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор);
		
		// Создадим источник
		ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(URLСхемы);
		НастройкиКД.Инициализировать(ИсточникДоступныхНастроек);
		//НастройкиКД.ЗагрузитьНастройки(ПолучитьТекущиеНастройкиКопмоновки(СтруктураНастроек)); 	
		НастройкиКД.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
		
	КонецЕсли;
	
КонецПроцедуры

