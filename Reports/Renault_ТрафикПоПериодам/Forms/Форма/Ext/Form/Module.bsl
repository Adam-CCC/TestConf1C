&НаСервере
Функция ПолучитьТекущиеНастройкиКопмоновки(СтруктураНастроек)
	
	Если Не ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		СКД = ОбработкаОбъект.ПолучитьСхемуКД();
		СтруктураНастроек = Новый Структура("НастройкиКомпоновки", СКД.НастройкиПоУмолчанию);
	КонецЕсли;
	
	Возврат СтруктураНастроек.НастройкиКомпоновки;
	
КонецФункции

&НаСервере
Процедура ДобавитьПорядокКомпоновкиДанных(НастройкиКомпоновки, ИмяПоляПорядка)
	
	ПолеПорядок = НастройкиКомпоновки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядок.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляПорядка);
	ПолеПорядок.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьГруппировкуСКДПоПолям(КоллекцияЭлементовСтруктуры, СтрокаПолей)
	
	Если ТипЗнч(КоллекцияЭлементовСтруктуры) = Тип("КоллекцияЭлементовСтруктурыТаблицыКомпоновкиДанных") Или ТипЗнч(КоллекцияЭлементовСтруктуры) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда 
		ГруппировкаКД = КоллекцияЭлементовСтруктуры.Добавить();
	Иначе 
		Группировка = КоллекцияЭлементовСтруктуры.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	КонецЕсли;
	
	ГруппировкаКД.Использование = Истина;
	
	МассивПолей = РазложитьСтрокуВМассивПодстрок(СтрокаПолей);
	Для Каждого ЭлементПоле Из МассивПолей Цикл 
		
		Поле = ГруппировкаКД.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		Поле.Использование = Истина;
		Поле.Поле = Новый ПолеКомпоновкиДанных(ЭлементПоле);
	
	КонецЦикла;
	
	ВыбранныеПоляГруппировки = ГруппировкаКД.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ВыбранныеПоляГруппировки.Использование = Истина;
	
	Возврат ГруппировкаКД;
	
КонецФункции

Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",") Экспорт
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
КонецФункции // РазложитьСтрокуВМассивПодстрок

&НаСервере
Функция ПроеобразоватьПредставление(Знач Представление)
	
	МассивПодстрок = РазложитьСтрокуВМассивПодстрок(Представление, " ");
	
	Представление = "";
	Для Каждого Подстрока Из МассивПодстрок Цикл 
		Представление = Представление + ТРег(СокрЛП(Подстрока));
	КонецЦикла;
	
	Возврат Представление
	
КонецФункции

&НаСервере
Функция НетПомеченныхЗначенийВСпискеЗначений(СписокЗначений)
	
	ЕстьПомеченные = Ложь;
	
	Для Каждого ЗначениеСписка Из СписокЗначений Цикл 
		Если ЗначениеСписка.Пометка Тогда 
			ЕстьПомеченные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Не ЕстьПомеченные;
	
КонецФункции

&НаСервере
Функция ПолучитьЗначениеРеквизита(СсылкаНаОбъект, ИмяРеквзита)
	
	Возврат СсылкаНаОбъект[ИмяРеквзита];
	
КонецФункции

&НаСервере
Процедура СформироватьОтчетНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	НастройкиКомпоновки = ПолучитьТекущиеНастройкиКопмоновки(СтруктураНастроек);
	
	ЗаполнитьНастройкиСКДПоНастройкамПользователя(НастройкиКомпоновки);
	
	ОбработкаОбъект.СформироватьОтчет(Результат, АдресТаблицыДанных, URLСхемы, НастройкиКомпоновки, Период, СписокВыбранныхДопПолей);
	
	ЗначенияВыводимыеНаДиаграмму.ЗаполнитьПометки(Ложь);
	
	ПостроитьДиаграммуПоНастройкамНаСервере();
	
	Если ЗначениеЗаполнено(ИзмерениеДиаграммы) Тогда 
		ЗаполнитьСписокВозможныхЗначенийНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриОкончанииРедактированияНастроекКДНаСервере()
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("НастройкиКомпоновки", НастройкиКД.ПолучитьНастройки());
	
КонецПроцедуры

