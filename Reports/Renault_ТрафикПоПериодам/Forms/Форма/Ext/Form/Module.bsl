Процедура ДобавитьОтбор(Команда)
	
	ФормаВыбора = ПолучитьФорму("ПланВидовХарактеристик.CRM_РеквизитыТрафика.ФормаВыбора");
	РезультатВыбора = ФормаВыбора.ОткрытьМодально();
	
	Если РезультатВыбора <> Неопределено Тогда 
		
		Если СписокВыбранныхДопПолей.НайтиПоЗначению(РезультатВыбора) = Неопределено Тогда 
			НовВыбранноеЗначение = СписокВыбранныхДопПолей.Добавить();
			НовВыбранноеЗначение.Значение = РезультатВыбора;
			НовВыбранноеЗначение.Представление = ПолучитьЗначениеРеквизита(РезультатВыбора, "Наименование");
		КонецЕсли;
		
		ДобавитьДополнительноеПоле();
		
	КонецЕсли;

