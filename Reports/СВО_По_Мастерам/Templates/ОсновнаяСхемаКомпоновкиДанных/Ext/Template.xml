			<field>СтавкаЗаДень</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаЗаказНаряда</dataPath>
			<field>СуммаЗаказНаряда</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма ЗН</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ФактДней</dataPath>
			<field>ФактДней</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВалютаОтчета</dataPath>
			<field>ВалютаОтчета</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КурсВалютыОтчета</dataPath>
			<field>КурсВалютыОтчета</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СостояниеЗаказНаряда</dataPath>
			<field>СостояниеЗаказНаряда</field>
		</field>
		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	ЗаказНаряд.Мастер,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.ВидРемонта.Коммерческий
				ТОГДА ЗаказНаряд.СуммаДокумента
			ИНАЧЕ 0
		КОНЕЦ) КАК СуммаЗаказНаряда,
	СУММА(ВЫБОР
			КОГДА ЗаказНаряд.ВидРемонта.Коммерческий
				ТОГДА ЗаказНаряд.ВремяВыполненияРабот
			ИНАЧЕ 0
		КОНЕЦ) КАК ВремяВыполненияРабот
ПОМЕСТИТЬ ВТВыборЗаказНаряда
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.Проведен
	И ЗаказНаряд.Дата МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)

СГРУППИРОВАТЬ ПО
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.Мастер,
	ЗаказНаряд.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыВПроизводстве.Регистратор КАК ЗаказНаряд,
	СУММА(ЕСТЬNULL(ТоварыВПроизводстве.СуммаУпр, 0)) КАК Себестоимость
ПОМЕСТИТЬ ВТСебестоимостьДеталей
ИЗ
	РегистрНакопления.ТоварыВПроизводстве КАК ТоварыВПроизводстве
ГДЕ
	ТоварыВПроизводстве.Период МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И ТоварыВПроизводстве.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	И ТоварыВПроизводстве.Регистратор ССЫЛКА Документ.ЗаказНаряд
{ГДЕ
	(ВЫРАЗИТЬ(ТоварыВПроизводстве.Регистратор КАК Документ.ЗаказНаряд).Организация).* КАК Организация,
	(ВЫРАЗИТЬ(ТоварыВПроизводстве.Регистратор КАК Документ.ЗаказНаряд).ПодразделениеКомпании).* КАК ПодразделениеКомпании,
	(ВЫРАЗИТЬ(ТоварыВПроизводстве.Регистратор КАК Документ.ЗаказНаряд).Контрагент).* КАК Контрагент}

СГРУППИРОВАТЬ ПО
	ТоварыВПроизводстве.Регистратор

ИМЕЮЩИЕ
	НЕ СУММА(ТоварыВПроизводстве.СуммаУпр) = 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТВыборЗаказНаряда.Мастер КАК Мастер,
	ВТВыборЗаказНаряда.ВидРемонта КАК ВидРемонта,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТВыборЗаказНаряда.ЗаказНаряд) КАК ЗаказНаряд,
	СУММА(ВТВыборЗаказНаряда.СуммаЗаказНаряда) КАК СуммаЗаказНаряда,
	СУММА(ВТВыборЗаказНаряда.ВремяВыполненияРабот) КАК ВремяВыполненияРабот,
	СУММА(ВЫБОР
			КОГДА ВТВыборЗаказНаряда.ВидРемонта.Коммерческий
				ТОГДА ВТСебестоимостьДеталей.Себестоимость
			ИНАЧЕ 0
		КОНЕЦ) КАК Себестоимость,
	МАКСИМУМ(&amp;ОплатаЗаНаряд) КАК ОплатаЗаНаряд,
	МАКСИМУМ(&amp;ОплатаЗаНарядЧас) КАК ОплатаЗаНарядЧас,
	МАКСИМУМ(&amp;ПроцентОтВП) КАК ПроцентОтВП,
	МАКСИМУМ(1) КАК ПроцентСТО,
	МАКСИМУМ(1) КАК ПроцентДокументооборот,
	МАКСИМУМ(1) КАК ПроцентВозврат,
	МАКСИМУМ(1) КАК ПроцентПорядок,
	МАКСИМУМ(ЗапросФактДней.ФактДней) КАК ФактДней,
	МАКСИМУМ(ЗапросСтавка.Значение) КАК СтавкаЗаДень,
	ВТВыборЗаказНаряда.ЗаказНаряд.Состояние КАК Состояние
ПОМЕСТИТЬ ВТБезРасчетов
ИЗ
	ВТВыборЗаказНаряда КАК ВТВыборЗаказНаряда
		ЛЕВОЕ СОЕДИНЕНИЕ ВТСебестоимостьДеталей КАК ВТСебестоимостьДеталей
		ПО ВТВыборЗаказНаряда.ЗаказНаряд = ВТСебестоимостьДеталей.ЗаказНаряд
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			РегистрацияВремениСотрудника.Сотрудник КАК Сотрудник,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(КОНЕЦПЕРИОДА(РегистрацияВремениСотрудника.Период, ДЕНЬ), 0)) КАК ФактДней
		ИЗ
			РегистрСведений.РегистрацияВремениСотрудника КАК РегистрацияВремениСотрудника
		ГДЕ
			РегистрацияВремениСотрудника.Период МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
			И РегистрацияВремениСотрудника.ВидОтметки = ЗНАЧЕНИЕ(Справочник.ВидыОтметокВремени.Работа)
			И РегистрацияВремениСотрудника.Продолжительность &lt;&gt; 0
		
		СГРУППИРОВАТЬ ПО
			РегистрацияВремениСотрудника.Сотрудник) КАК ЗапросФактДней
		ПО ВТВыборЗаказНаряда.Мастер = ЗапросФактДней.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ДневнаяСтавкаСрезПоследних.Сотрудник КАК Сотрудник,
			ДневнаяСтавкаСрезПоследних.Значение КАК Значение
		ИЗ
			РегистрСведений.ДневнаяСтавка.СрезПоследних(КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ), ) КАК ДневнаяСтавкаСрезПоследних) КАК ЗапросСтавка
		ПО ВТВыборЗаказНаряда.Мастер = ЗапросСтавка.Сотрудник

СГРУППИРОВАТЬ ПО
	ВТВыборЗаказНаряда.Мастер,
	ВТВыборЗаказНаряда.ВидРемонта,
	ВТВыборЗаказНаряда.ЗаказНаряд.Состояние
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТБезРасчетов.Мастер КАК Мастер,
	ВТБезРасчетов.ВидРемонта КАК ВидРемонта,
	ВТБезРасчетов.ЗаказНаряд КАК ЗаказНаряд,
	ВТБезРасчетов.СуммаЗаказНаряда КАК СуммаЗаказНаряда,
	ВТБезРасчетов.ВремяВыполненияРабот КАК ВремяВыполненияРабот,
	ВТБезРасчетов.Себестоимость КАК Себестоимость,
	ВТБезРасчетов.СуммаЗаказНаряда - ВТБезРасчетов.Себестоимость КАК ВаловыйПродукт,
	ВЫБОР
		КОГДА ВТБезРасчетов.Себестоимость = 0
			ТОГДА 0
		ИНАЧЕ (ВТБезРасчетов.СуммаЗаказНаряда - ВТБезРасчетов.Себестоимость) / ВТБезРасчетов.СуммаЗаказНаряда * 100
	КОНЕЦ КАК Рентабельность,
	ВТБезРасчетов.ФактДней КАК ФактДней,
	ВТБезРасчетов.ОплатаЗаНаряд КАК ОплатаЗаНаряд,
	ВТБезРасчетов.ЗаказНаряд * ВТБезРасчетов.ОплатаЗаНаряд КАК ЗаЗаказНаряд,
	ВТБезРасчетов.ОплатаЗаНарядЧас КАК ОплатаЗаНарядЧас,
	ВТБезРасчетов.ОплатаЗаНарядЧас * ВТБезРасчетов.ВремяВыполненияРабот КАК ЗаНарядоЧас,
	ВТБезРасчетов.ПроцентОтВП КАК ПроцентОтВП,
	(ВТБезРасчетов.СуммаЗаказНаряда - ВТБезРасчетов.Себестоимость) * ВТБезРасчетов.ПроцентОтВП / 100 КАК ЗаВП,
	ВТБезРасчетов.СтавкаЗаДень КАК СтавкаЗаДень,
	ВТБезРасчетов.ФактДней * ВТБезРасчетов.СтавкаЗаДень КАК ЗаВыход,
	ВТБезРасчетов.ПроцентСТО КАК ПроцентСТО,
	ВТБезРасчетов.ПроцентДокументооборот КАК ПроцентДокументооборот,
	ВТБезРасчетов.ПроцентВозврат КАК ПроцентВозврат,
	ВТБезРасчетов.ПроцентПорядок КАК ПроцентПорядок,
	ВТБезРасчетов.ЗаказНаряд * ВТБезРасчетов.ОплатаЗаНаряд + ВТБезРасчетов.ОплатаЗаНарядЧас * ВТБезРасчетов.ВремяВыполненияРабот + (ВТБезРасчетов.СуммаЗаказНаряда - ВТБезРасчетов.Себестоимость) * ВТБезРасчетов.ПроцентОтВП / 100 + ВТБезРасчетов.ФактДней * ВТБезРасчетов.СтавкаЗаДень КАК Начислено,
	&amp;ВалютаОтчета,
	&amp;КурсВалютыОтчета,
	ВТБезРасчетов.Состояние КАК СостояниеЗаказНаряда
ИЗ
	ВТБезРасчетов КАК ВТБезРасчетов</query>
	</dataSet>
	<totalField>
		<dataPath>ВаловыйПродукт</dataPath>
		<expression>СУММА(СуммаЗаказНаряда) - СУММА(Себестоимость)</expression>
	</totalField>
	<totalField>
		<dataPath>ВремяВыполненияРабот</dataPath>
		<expression>Сумма(ВремяВыполненияРабот)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗаВП</dataPath>
		<expression>(СУММА(СуммаЗаказНаряда) - СУММА(Себестоимость)) * МАКСИМУМ(ПроцентОтВП) / 100</expression>
	</totalField>
	<totalField>
		<dataPath>ЗаВыход</dataPath>
		<expression>МАКСИМУМ(ФактДней) * МАКСИМУМ(СтавкаЗаДень)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗаЗаказНаряд</dataPath>
		<expression>МАКСИМУМ(ОплатаЗаНаряд) * СУММА(ЗаказНаряд)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗаказНаряд</dataPath>
		<expression>Сумма(ЗаказНаряд)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗаНарядоЧас</dataPath>
		<expression>МАКСИМУМ(ОплатаЗаНарядЧас) * СУММА(ВремяВыполненияРабот)</expression>
	</totalField>
	<totalField>
		<dataPath>Начислено</dataPath>
		<expression>МАКСИМУМ(ОплатаЗаНаряд) * СУММА(ЗаказНаряд) + МАКСИМУМ(ОплатаЗаНарядЧас) * СУММА(ВремяВыполненияРабот) + (СУММА(СуммаЗаказНаряда) - СУММА(Себестоимость)) * МАКСИМУМ(ПроцентОтВП) / 100 + МАКСИМУМ(ФактДней) * МАКСИМУМ(СтавкаЗаДень)</expression>
	</totalField>
	<totalField>
		<dataPath>ОплатаЗаНаряд</dataPath>
		<expression>Максимум(ОплатаЗаНаряд)</expression>
	</totalField>
	<totalField>
		<dataPath>ОплатаЗаНарядЧас</dataPath>
		<expression>Максимум(ОплатаЗаНарядЧас)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентВозврат</dataPath>
		<expression>Максимум(ПроцентВозврат)</expression>
	</totalField>
	<totalField>
		<dataPath>ПроцентДокументооборот</dataPath>
		<expression>Максимум(ПроцентДокументооборот)</expression>
