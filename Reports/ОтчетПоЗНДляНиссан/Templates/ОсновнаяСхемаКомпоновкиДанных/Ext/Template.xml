		<field xsi:type="DataSetFieldField">
			<dataPath>ТипЗаказНаряда</dataPath>
			<field>ТипЗаказНаряда</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тип заказ-наряда</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Цех</dataPath>
			<field>Цех</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Модель</dataPath>
			<field>Модель</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Модель</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидРемонта</dataPath>
			<field>ВидРемонта</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказНаряд.Номер,
	ЗаказНаряд.Дата,
	ЗаказНаряд.Автомобиль.VIN КАК VIN,
	ЗаказНаряд.Пробег,
	ЗаказНаряд.СуммаРаботДокумента КАК СуммаРабот,
	ЗаказНаряд.СуммаНоменклатурыДокумента КАК СуммаЗапасныхЧастей,
	ЗаказНаряд.Состояние,
	ЗаказНаряд.ПодразделениеКомпании,
	ВЫБОР
		КОГДА ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "Техническое%"
			ТОГДА "ТО"
		КОГДА ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "Кузовной%"
			ТОГДА "КР"
		КОГДА ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "Гарантия%"
			ТОГДА "Гарантия"
		КОГДА ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "Сезонная%"
			ТОГДА "Сезонная кампания"
		КОГДА ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "Масляный%"
			ТОГДА "Масляный сервис"
		КОГДА ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "Дополнительное%"
			ТОГДА ВЫБОР
					КОГДА ЗаказНаряд.Контрагент.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)
						ТОГДА "ДОП ритэйл"
					ИНАЧЕ "ДОП флит"
				КОНЕЦ
		КОГДА ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "Добрая%"
				ИЛИ ЗаказНаряд.ВидРемонта.Наименование ПОДОБНО "ТО-0%"
			ТОГДА "ВН/Д"
		ИНАЧЕ "МР/АСС"
	КОНЕЦ КАК ТипЗаказНаряда,
	ЗаказНаряд.Цех,
	ЗаказНаряд.Автомобиль.Модель КАК Модель,
	ЗаказНаряд.ВидРемонта
ИЗ
	Документ.ЗаказНаряд КАК ЗаказНаряд
ГДЕ
	ЗаказНаряд.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
