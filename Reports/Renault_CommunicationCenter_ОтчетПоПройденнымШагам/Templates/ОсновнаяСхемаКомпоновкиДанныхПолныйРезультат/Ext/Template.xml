		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_CommunicationCenter_Обзвон.Клиент,
	Renault_CommunicationCenter_Обзвон.Дата КАК ДатаОбзвона,
	ВЫБОР
		КОГДА Renault_CommunicationCenter_Обзвон.Недозвон = ИСТИНА
			ТОГДА "Недозвон"
		ИНАЧЕ ЕСТЬNULL(Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Результат, ЗНАЧЕНИЕ(Справочник.Renault_CommunicationCenter_РезультатыКоммуникации.ПустаяСсылка))
	КОНЕЦ КАК Результат,
	ЕСТЬNULL(Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Документ, "") КАК Документ,
	Renault_CommunicationCenter_Обзвон.Исполнитель КАК Исполнитель,
	Renault_CommunicationCenter_Обзвон.Ссылка
ПОМЕСТИТЬ ВТРезультаты
ИЗ
	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CommunicationCenter_Обзвон.РезультатКоммуникации КАК Renault_CommunicationCenter_ОбзвонРезультатКоммуникации
		ПО Renault_CommunicationCenter_Обзвон.Ссылка = Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Ссылка
ГДЕ
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона = &amp;СхемаОбзвона
	И НЕ Renault_CommunicationCenter_Обзвон.ПометкаУдаления
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТРезультаты.Клиент,
	ВТРезультаты.ДатаОбзвона,
	ВТРезультаты.Результат,
	ВТРезультаты.Исполнитель,
	Renault_CommunicationCenter_ОбзвонПройденныеШаги.Содержание,
	Renault_CommunicationCenter_ОбзвонПройденныеШаги.КомментарийШага,
	0 КАК Количество,
	ВТРезультаты.Документ
ИЗ
	ВТРезультаты КАК ВТРезультаты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CommunicationCenter_Обзвон.ПройденныеШаги КАК Renault_CommunicationCenter_ОбзвонПройденныеШаги
		ПО ВТРезультаты.Ссылка = Renault_CommunicationCenter_ОбзвонПройденныеШаги.Ссылка</query>
