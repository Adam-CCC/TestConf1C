			<field>Комментарий</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Комментарий</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_CommunicationCenter_Обзвон.Клиент,
	Renault_CommunicationCenter_Обзвон.Исполнитель,
	Renault_CommunicationCenter_Обзвон.Номер КАК НомерДокументаОбзвона,
	Renault_CommunicationCenter_Обзвон.Дата КАК ДатаДокументаОбзвона,
	МАКСИМУМ(Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.НомерСтроки) КАК НомерСтроки,
	Renault_CommunicationCenter_Обзвон.Ссылка,
	Renault_CommunicationCenter_ОбзвонПройденныеШаги.Шаг,
	Renault_CommunicationCenter_ОбзвонПройденныеШаги.КомментарийШага КАК Комментарий
ПОМЕСТИТЬ ВТОбзвон
ИЗ
	Документ.Renault_CommunicationCenter_Обзвон.ПройденныеШаги КАК Renault_CommunicationCenter_ОбзвонПройденныеШаги
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CommunicationCenter_Обзвон.РезультатКоммуникации КАК Renault_CommunicationCenter_ОбзвонРезультатКоммуникации
			ПО Renault_CommunicationCenter_Обзвон.Ссылка = Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Ссылка
				И (Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Результат.ТипРезультата &lt;&gt; &amp;ОкончаниеЗвонка)
		ПО Renault_CommunicationCenter_ОбзвонПройденныеШаги.Ссылка = Renault_CommunicationCenter_Обзвон.Ссылка
ГДЕ
	НЕ Renault_CommunicationCenter_Обзвон.Недозвон
	И Renault_CommunicationCenter_Обзвон.Проведен
	И Renault_CommunicationCenter_ОбзвонПройденныеШаги.Шаг = &amp;Шаг

СГРУППИРОВАТЬ ПО
	Renault_CommunicationCenter_Обзвон.Клиент,
	Renault_CommunicationCenter_Обзвон.Исполнитель,
	Renault_CommunicationCenter_Обзвон.Номер,
	Renault_CommunicationCenter_Обзвон.Дата,
	Renault_CommunicationCenter_Обзвон.Ссылка,
	Renault_CommunicationCenter_ОбзвонПройденныеШаги.Шаг,
	Renault_CommunicationCenter_ОбзвонПройденныеШаги.КомментарийШага
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	1 КАК Количество,
	Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Документ,
	Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Результат,
	ВТОбзвон.Клиент КАК Клиент,
	ВТОбзвон.Исполнитель,
	ВТОбзвон.НомерДокументаОбзвона,
	ВТОбзвон.ДатаДокументаОбзвона,
	ВТОбзвон.Шаг,
	ВТОбзвон.Комментарий
ИЗ
	ВТОбзвон КАК ВТОбзвон
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CommunicationCenter_Обзвон.РезультатКоммуникации КАК Renault_CommunicationCenter_ОбзвонРезультатКоммуникации
		ПО ВТОбзвон.Ссылка = Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Ссылка
			И ВТОбзвон.НомерСтроки = Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.НомерСтроки

УПОРЯДОЧИТЬ ПО
	Клиент</query>
