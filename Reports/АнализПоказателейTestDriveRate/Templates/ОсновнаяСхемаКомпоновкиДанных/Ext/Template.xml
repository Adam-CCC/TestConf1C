<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Подразделение</dataPath>
			<field>Подразделение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Модель</dataPath>
			<field>Модель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрактов</dataPath>
			<field>Контрактов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТестДрайвов</dataPath>
			<field>ТестДрайвов</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РабочийЛист</dataPath>
			<field>РабочийЛист</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Событие</dataPath>
			<field>Событие</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	Событие.Ссылка КАК Ссылка,
	Событие.Дата,
	Событие.Проведен,
	Событие.Продавец,
	Событие.ВидСобытия,
	Событие.ТипСообщения,
	Событие.Состояние,
	Событие.Автомобиль,
	Событие.ДокументОснование
ПОМЕСТИТЬ ВТСобытие
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.Проведен
	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТестДрайв)
	И Событие.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	РабочийЛист.Ссылка КАК Ссылка,
	РабочийЛист.Дата,
	РабочийЛист.Проведен,
	РабочийЛист.Автомобиль,
	РабочийЛист.Менеджер,
	РабочийЛист.СуммаПродажи,
	РабочийЛист.ПредполагаемыйСрок,
	РабочийЛист.Статус
ПОМЕСТИТЬ ВТРабочийЛист
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
ГДЕ
	РабочийЛист.Проведен
	И (РабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Сделка)
			ИЛИ РабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Продажа))
	И РабочийЛист.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТСобытие.Продавец КАК Менеджер,
	ВТСобытие.Продавец.Подразделение КАК Подразделение,
	ВТСобытие.Автомобиль.Модель КАК Модель,
	1 КАК ТестДрайвов,
	ВЫБОР
		КОГДА Контракт.Ссылка ЕСТЬ NULL 
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК Контрактов,
	ВТСобытие.Ссылка КАК Событие,
	Контракт.Ссылка КАК РабочийЛист
ИЗ
	ВТСобытие КАК ВТСобытие
		ЛЕВОЕ СОЕДИНЕНИЕ ВТРабочийЛист КАК Контракт
		ПО (Контракт.Ссылка = ВТСобытие.Ссылка.ДокументОснование)

УПОРЯДОЧИТЬ ПО
	Подразделение,
	Менеджер</query>
	</dataSet>
