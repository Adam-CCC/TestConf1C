		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СУММА(1) КАК КоличествоКлиентов,
	СУММА(1) КАК КоличествоОбзвонов,
	СУММА(ВЫБОР
			КОГДА Renault_CommunicationCenter_Обзвон.Недозвон
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК КоличествоНедозвонов,
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона,
	Renault_CommunicationCenter_Обзвон.Клиент,
	ЕСТЬNULL(КонтактнаяИнформация.Представление, "") КАК Телефон,
	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.НомерСтроки, 0) = 0
				ТОГДА 0
			ИНАЧЕ 1
		КОНЕЦ) КАК КоличествоПерезвонить,
	НАЧАЛОПЕРИОДА(Renault_CommunicationCenter_Обзвон.Дата, ДЕНЬ) КАК ДатаКоммуникации
ИЗ
	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		ПО Renault_CommunicationCenter_Обзвон.Клиент = КонтактнаяИнформация.Объект
			И (КонтактнаяИнформация.Тип = &amp;ТипТелефон)
			И (КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CommunicationCenter_Обзвон.РезультатКоммуникации КАК Renault_CommunicationCenter_ОбзвонРезультатКоммуникации
		ПО Renault_CommunicationCenter_Обзвон.Ссылка = Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Ссылка
			И (Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Результат.ТипРезультата = ЗНАЧЕНИЕ(Перечисление.Renault_ДействияРезультатов.ПерезвонитьПозже))
ГДЕ
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона = &amp;СхемаОбзвона
	И НЕ Renault_CommunicationCenter_Обзвон.ПометкаУдаления

СГРУППИРОВАТЬ ПО
	ЕСТЬNULL(КонтактнаяИнформация.Представление, ""),
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона,
	Renault_CommunicationCenter_Обзвон.Клиент,
	Renault_CommunicationCenter_Обзвон.Дата</query>
