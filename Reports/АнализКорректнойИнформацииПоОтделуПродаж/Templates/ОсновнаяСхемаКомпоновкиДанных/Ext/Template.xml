<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>ТекстЗапроса</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоКорректных</dataPath>
			<field>КоличествоКорректных</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоОбщее</dataPath>
			<field>КоличествоОбщее</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодразделениеКомпании</dataPath>
			<field>ПодразделениеКомпании</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Модель</dataPath>
			<field>Модель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Результат</dataPath>
			<field>Результат</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Содержание</dataPath>
			<field>Содержание</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Телефон</dataPath>
			<field>Телефон</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>МенеджерРЛ</dataPath>
			<field>МенеджерРЛ</field>
		</field>
		<dataSource>ИсточникДанных</dataSource>
		<query>ВЫБРАТЬ
	1 КАК КоличествоОбщее,
	РабочийЛист.Ссылка КАК Ссылка,
	РабочийЛист.ПодразделениеКомпании КАК ПодразделениеКомпании,
	РабочийЛист.Менеджер КАК Менеджер
ПОМЕСТИТЬ РЛ
{ВЫБРАТЬ
	КоличествоОбщее,
	Ссылка.*,
	ПодразделениеКомпании.*,
	Менеджер.*}
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
ГДЕ
	РабочийЛист.Проведен
	И РабочийЛист.Дата МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РЛ.КоличествоОбщее КАК КоличествоОбщее,
	РЛ.Ссылка КАК Ссылка,
	РЛ.ПодразделениеКомпании КАК ПодразделениеКомпании,
	РЛ.Менеджер КАК Менеджер,
	ВЫБОР
		КОГДА РЛ.Ссылка.Менеджер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
				И РЛ.Ссылка.Модель &lt;&gt; ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
				И РЛ.Ссылка.НомерТелефона &lt;&gt; ""
				И (ВЫРАЗИТЬ(РЛ.Ссылка.Контрагент КАК СТРОКА(5))) &lt;&gt; "     "
				И (ВЫРАЗИТЬ(Событие.Результат КАК СТРОКА(5))) &lt;&gt; ""
				И (ВЫРАЗИТЬ(Событие.Содержание КАК СТРОКА(5))) &lt;&gt; ""
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоКорректных,
	ВЫБОР
		КОГДА РЛ.Ссылка.Менеджер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
			ТОГДА "Менеджер"
		ИНАЧЕ ""
	КОНЕЦ КАК МенеджерРЛ,
	ВЫБОР
		КОГДА РЛ.Ссылка.Модель &lt;&gt; ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
			ТОГДА "Модель"
		ИНАЧЕ ""
	КОНЕЦ КАК Модель,
	ВЫБОР
		КОГДА РЛ.Ссылка.НомерТелефона &lt;&gt; ""
			ТОГДА "Телефон"
		ИНАЧЕ ""
	КОНЕЦ КАК Телефон,
	ВЫБОР
		КОГДА (ВЫРАЗИТЬ(РЛ.Ссылка.Контрагент КАК СТРОКА(5))) &lt;&gt; "     "
				И (ВЫРАЗИТЬ(Событие.Результат КАК СТРОКА(5))) &lt;&gt; ""
				И (ВЫРАЗИТЬ(Событие.Содержание КАК СТРОКА(5))) &lt;&gt; ""
			ТОГДА "Контрагент"
		ИНАЧЕ ""
	КОНЕЦ КАК Контрагент,
	ВЫБОР
		КОГДА (ВЫРАЗИТЬ(Событие.Результат КАК СТРОКА(5))) &lt;&gt; ""
			ТОГДА "Результат"
		ИНАЧЕ ""
	КОНЕЦ КАК Результат,
	ВЫБОР
		КОГДА (ВЫРАЗИТЬ(Событие.Содержание КАК СТРОКА(5))) &lt;&gt; ""
			ТОГДА "Содержание"
		ИНАЧЕ ""
	КОНЕЦ КАК Содержание
{ВЫБРАТЬ
	КоличествоОбщее,
	Ссылка.*,
	ПодразделениеКомпании.*,
	Менеджер.*,
	КоличествоКорректных,
	Модель,
	Телефон,
	Контрагент,
	Результат,
	Содержание,
	МенеджерРЛ}
ИЗ
	РЛ КАК РЛ
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
		ПО РЛ.Ссылка = Событие.ДокументОснование
ГДЕ
	Событие.ДокументОснование В
			(ВЫБРАТЬ
				РабЛист.Ссылка
			ИЗ
				РЛ КАК РабЛист)
	И Событие.Проведен</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
