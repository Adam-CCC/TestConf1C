		<query>ВЫБРАТЬ
	Событие.Ссылка КАК Событие,
	Событие.ВидСобытия КАК Вид,
	Событие.ПометкаУдаления,
	Событие.Состояние,
	Событие.ТипСообщения КАК Тип,
	Событие.Дата КАК Дата,
	Событие.ДокументОснование КАК РабочийЛист,
	Событие.ДокументОснование.МодельТрейдИн КАК Модель,
	Событие.ПодразделениеКомпании,
	Событие.ДокументОснование.ТрейдИнТипДвигателя КАК ТипДвигателя,
	Событие.ДокументОснование.ТрейдИнОбъемДвигателя КАК ОбъемДвигателя,
	Событие.ДокументОснование.ТрейдИнКоличествоВладельцев КАК КоличествоВладельцев,
	Событие.ДокументОснование.ТрейдИнVIN КАК VIN,
	Событие.Продавец КАК Менеджер
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.Дата МЕЖДУ &amp;ДатаН И &amp;ДатаК
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
	И ТИПЗНАЧЕНИЯ(Событие.ДокументОснование) = ТИП(Документ.РабочийЛист)
	И НЕ Событие.ПометкаУдаления

УПОРЯДОЧИТЬ ПО
	Дата УБЫВ</query>
