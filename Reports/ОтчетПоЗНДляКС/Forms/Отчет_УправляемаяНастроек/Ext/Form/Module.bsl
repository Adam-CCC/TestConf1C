&НаКлиенте
Процедура ИзмеренияСтрокиПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("ДанныеФормыЭлементКоллекции") Тогда
		СтрокаГруппировки = ПараметрыПеретаскивания.Значение;
		Если Строка = Неопределено Тогда
			НоваяСтрока = ИзмеренияСтроки.Добавить();
		Иначе
			ДанныеСтроки = ИзмеренияСтроки.НайтиПоИдентификатору(Строка);
			ИндексСтроки = ИзмеренияСтроки.Индекс(ДанныеСтроки);
			НоваяСтрока = ИзмеренияСтроки.Вставить(ИндексСтроки);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГруппировки);
		ОтчетыСервер.УстановитьПорядокПоУмолчанию(Отчет.КомпоновщикНастроек.Настройки, НоваяСтрока);
		УдалитьСтрокуИсточника(СтрокаГруппировки);
	ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		Счетчик = 0;
		Для Каждого ТекСтрока Из ПараметрыПеретаскивания.Значение Цикл
			Если Строка = Неопределено Тогда
				НоваяСтрока = ИзмеренияСтроки.Добавить();
			Иначе
				ДанныеСтроки = ИзмеренияСтроки.НайтиПоИдентификатору(Строка);
				ИндексСтроки = ИзмеренияСтроки.Индекс(ДанныеСтроки);
				НоваяСтрока = ИзмеренияСтроки.Вставить(ИндексСтроки+Счетчик);
				Счетчик = Счетчик + 1;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			ОтчетыСервер.УстановитьПорядокПоУмолчанию(Отчет.КомпоновщикНастроек.Настройки, НоваяСтрока);
			УдалитьСтрокуИсточника(ТекСтрока);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Число") Тогда
		Если Строка = Неопределено Тогда
			ИндексСтроки = ИзмеренияСтроки.Количество()-1;
		Иначе
			ДанныеСтроки = Элементы.ИзмеренияСтроки.ДанныеСтроки(Строка);
			ИндексСтроки = ИзмеренияСтроки.Индекс(ДанныеСтроки);
		КонецЕсли;
		НачальныйИндекс = ИзмеренияСтроки.Индекс(Элемент.ТекущиеДанные);
		ИзмеренияСтроки.Сдвинуть(НачальныйИндекс, ИндексСтроки-НачальныйИндекс);
	КонецЕсли;
	
КонецПроцедуры

