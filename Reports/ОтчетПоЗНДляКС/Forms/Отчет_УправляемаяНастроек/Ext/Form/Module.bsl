&НаКлиенте
Процедура УдалитьСтрокуИсточника(ТекущаяСтрока)
	
	ИндексСтроки = ИзмеренияСтроки.Индекс(ТекущаяСтрока);
	Если ИндексСтроки<0 Тогда
		ИндексСтроки = ИзмеренияКолонки.Индекс(ТекущаяСтрока);
		Если НЕ ИндексСтроки<0 Тогда
			ИзмеренияКолонки.Удалить(ИндексСтроки);
		КонецЕсли;
	Иначе
		ИзмеренияСтроки.Удалить(ИндексСтроки);
	КонецЕсли;
	
КонецПроцедуры

