		Если СтрокаСтруктуры = Неопределено Тогда
			СтрокаСтруктуры = Отчет.КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		КонецЕсли;
		
		СтруктураПараметров.Вставить("НастройкиОтчета", Отчет.КомпоновщикНастроек.ПолучитьНастройки());
		СтруктураПараметров.Вставить("ТекущаяСтрока",   Отчет.КомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(СтрокаСтруктуры));
		
		ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетВыборПоля", СтруктураПараметров, Элемент);
		
		Рез = ФормаВыбора.ОткрытьМодально();
		Если НЕ Рез = КодВозвратаДиалога.Отмена И НЕ Рез = Неопределено Тогда
			Если ТипЗнч(Рез) = Тип("Структура") ИЛИ ТипЗнч(Рез) = Тип("ДоступноеПолеКомпоновкиДанных") Тогда
				ЗаголовокГруппировки = Рез.Заголовок;
				ПолеГруппировки      = Рез.Поле;
			Иначе
				ЗаголовокГруппировки = Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.НайтиПоле(Рез).Заголовок;
				ПолеГруппировки      = Рез;
			КонецЕсли;
			
			ОтборПоДублям = Новый Структура("Поле", ПолеГруппировки);
			Дубли = ИзмеренияСтроки.НайтиСтроки(ОтборПоДублям);
			Если Дубли.Количество()>0 Тогда
				Предупреждение("Повторяющаяся группировка " + ЗаголовокГруппировки +"."+ Символы.ПС+
				"Нельзя использовать одинаковые поля группировки в строках и в колонках!", 30);
				Возврат;
			Иначе
				Дубли = ИзмеренияКолонки.НайтиСтроки(ОтборПоДублям);
				Если Дубли.Количество()>0 Тогда
					Предупреждение("Повторяющаяся группировка " + ЗаголовокГруппировки +"."+ Символы.ПС+
					"Нельзя использовать одинаковые поля группировки в строках и в колонках!", 30);
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			ТекущиеДанные = Элемент.ТекущиеДанные;
			ТекущиеДанные.Поле          = ПолеГруппировки;
			ТекущиеДанные.Заголовок     = ЗаголовокГруппировки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

