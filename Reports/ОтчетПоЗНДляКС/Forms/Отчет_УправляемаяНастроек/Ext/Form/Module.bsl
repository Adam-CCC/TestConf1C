&НаСервере
Процедура ИзменитьПараметрыИзбранного(СтруктураПараметров)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	//Избранное = Обработки.Избранное.Создать();
	Менеджер = "Отчеты." + ОтчетОбъект.Метаданные().Имя;
	СтруктураПараметров.Вставить("ИмяОтчета", ОтчетОбъект.Метаданные().Имя);
	
	НаименованиеОтчета = ?(ОтчетОбъект.Метаданные().Синоним = "", ОтчетОбъект.Метаданные().Имя, ОтчетОбъект.Метаданные().Синоним);
	
	ПараметрДатаНачала    = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаНачала"));
	ПараметрДатаОкончания = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаОкончания"));
	
	ДатаНачала    = Неопределено;
	ДатаОкончания = Неопределено;
	Если (НЕ ПараметрДатаНачала = Неопределено) И (НЕ ПараметрДатаОкончания = Неопределено) Тогда
		
		ДатаНачала    = ОтчетыСервер.КомпоновщикПолучитьЗначениеПараметра("ДатаНачала",    Отчет.КомпоновщикНастроек.Настройки);
		ДатаОкончания = ОтчетыСервер.КомпоновщикПолучитьЗначениеПараметра("ДатаОкончания", Отчет.КомпоновщикНастроек.Настройки);
		
		ПериодСтрокой = ПредставлениеПериода(ДатаНачала, ДатаОкончания, "ФП=Истина");
		Если Найти(ПериодСтрокой, " - ") > 0 Тогда
			Если ДатаНачала = ДатаОкончания Тогда
				ПериодСтрокой = Формат(ДатаНачала, "ДЛФ=DD");
			Иначе
				ПериодСтрокой = Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
			КонецЕсли;
		КонецЕсли;
		НаименованиеОтчета = "Отчет: " + НаименованиеОтчета + " (" + ПериодСтрокой + ")";
	Иначе
		НаименованиеОтчета = "Отчет: " + НаименованиеОтчета;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("Наименование", НаименованиеОтчета);
	СтруктураПараметров.Вставить("Менеджер",     Менеджер);
	
КонецПроцедуры	//	ИзменитьПараметрыИзбранного()

&НаСервере
Процедура ЗаполнитьОписаниеСтруктуры()
	
	Если РежимВыводаОтчета = 1 ИЛИ ОтключеныКолонки Тогда
		ЭтаФорма.Элементы.ИзмеренияСтроки.Заголовок = "Группировки";
		ЭтаФорма.Элементы.ИзмеренияКолонки.Видимость = Ложь;
		Элементы.ГруппаОформлениеТаблицы.Видимость = Истина;
		Элементы.ГруппаОформлениеДиаграммы.Видимость = Ложь;
	ИначеЕсли РежимВыводаОтчета = 2 Тогда
		ЭтаФорма.Элементы.ИзмеренияСтроки.Заголовок = "Строки";
		ЭтаФорма.Элементы.ИзмеренияКолонки.Заголовок = "Колонки";
		ЭтаФорма.Элементы.ИзмеренияКолонки.Видимость = Истина;
		Элементы.ГруппаОформлениеТаблицы.Видимость = Истина;
		Элементы.ГруппаОформлениеДиаграммы.Видимость = Ложь;
	ИначеЕсли РежимВыводаОтчета = 3 Тогда
		ЭтаФорма.Элементы.ИзмеренияСтроки.Заголовок = "Серии";
		ЭтаФорма.Элементы.ИзмеренияКолонки.Заголовок = "Точки";
		ЭтаФорма.Элементы.ИзмеренияКолонки.Видимость = Истина;
		Элементы.ГруппаОформлениеТаблицы.Видимость = Ложь;
		Элементы.ГруппаОформлениеДиаграммы.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

