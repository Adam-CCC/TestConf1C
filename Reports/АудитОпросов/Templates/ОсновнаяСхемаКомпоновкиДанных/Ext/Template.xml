		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	КонтактнаяИнформация.Объект,
	КонтактнаяИнформация.Представление
ПОМЕСТИТЬ Телефоны
ИЗ
	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
ГДЕ
	КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	И КонтактнаяИнформация.ЗначениеПоУмолчанию
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Опрос.ОпрашиваемоеЛицо,
	Телефоны.Представление КАК Телефон,
	ВЫБОР
		КОГДА Опрос.ДокументОснование ЕСТЬ NULL 
			ТОГДА NULL
		КОГДА Опрос.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
			ТОГДА Опрос.ДокументОснование.Автомобиль.Модель
		ИНАЧЕ NULL
	КОНЕЦ КАК Модель,
	Опрос.Мастер,
	Опрос.ОпросЗавершен,
	Опрос.Отказ,
	Опрос._г_НеДозвон КАК Недозвон,
	Опрос.ПричинаНедозвона,
	Опрос.Комментарий,
	Опрос.Принадлежность,
	Опрос.Дата КАК ДатаОпроса,
	Опрос._г_ДатаСоздания КАК ДатаСоздания
ИЗ
	Документ.Опрос КАК Опрос
		ЛЕВОЕ СОЕДИНЕНИЕ Телефоны КАК Телефоны
		ПО Опрос.ОпрашиваемоеЛицо = Телефоны.Объект
ГДЕ
	Опрос._г_ДатаСоздания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
