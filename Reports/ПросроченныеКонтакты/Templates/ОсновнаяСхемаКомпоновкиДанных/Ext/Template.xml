		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Событие.ДокументОснование КАК РабочийЛист,
	Событие.Ссылка КАК Событие,
	Событие.ДатаНачала КАК ДатаНачала,
	Событие.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	Событие.Продавец,
	СУММА(1) КАК КоличествоПросроченных,
	Событие.ПодразделениеКомпании
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)
	И Событие.ДатаНачала МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

СГРУППИРОВАТЬ ПО
	Событие.Ссылка,
	Событие.ДокументОснование,
	Событие.ДатаНачала,
	Событие.ПодразделениеКомпании.ДилерскийЦентр,
	Событие.Продавец</query>
	</dataSet>
