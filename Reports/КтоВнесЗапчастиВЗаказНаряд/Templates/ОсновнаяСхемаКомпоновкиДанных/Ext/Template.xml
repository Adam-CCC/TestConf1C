		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказНарядТовары.СуммаВсего КАК СуммаВсего,
	ЗаказНарядТовары.КтоВнес КАК КтоВнес,
	ЗаказНарядТовары.Ссылка КАК ЗаказНаряд,
	ЗаказНарядТовары.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	ЗаказНарядТовары.Ссылка.Дата КАК Дата,
	ТоварыВПроизводстве.Сумма КАК Себестоимость,
	ЗаказНарядТовары.Ссылка.ВидРемонта КАК ВидРемонта,
	ЗаказНарядТовары.Ссылка.ВидРемонта.ТипРемонта КАК ТипРемонта
ИЗ
	Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ТоварыВПроизводстве.ЗаказНаряд КАК ЗаказНаряд,
			ТоварыВПроизводстве.Номенклатура КАК Номенклатура,
			ТоварыВПроизводстве.Сумма КАК Сумма
		ИЗ
			РегистрНакопления.ТоварыВПроизводстве КАК ТоварыВПроизводстве) КАК ТоварыВПроизводстве
		ПО ЗаказНарядТовары.Ссылка = ТоварыВПроизводстве.ЗаказНаряд
			И ЗаказНарядТовары.Номенклатура = ТоварыВПроизводстве.Номенклатура
ГДЕ
	ЗаказНарядТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказНарядТовары.Ссылка.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)

СГРУППИРОВАТЬ ПО
	ЗаказНарядТовары.Ссылка.ПодразделениеКомпании,
	ЗаказНарядТовары.КтоВнес,
	ЗаказНарядТовары.Ссылка,
	ЗаказНарядТовары.Ссылка.Дата,
	ТоварыВПроизводстве.Сумма,
	ЗаказНарядТовары.Ссылка.ВидРемонта,
	ЗаказНарядТовары.СуммаВсего,
	ЗаказНарядТовары.Ссылка.ВидРемонта.ТипРемонта</query>
