		<query>ВЫБРАТЬ
	РабочийЛист.Менеджер.Подразделение КАК Подразделение,
	РабочийЛист.Модель КАК Модель,
	РабочийЛист.Менеджер КАК Менеджер,
	РабочийЛист.Контрагент,
	РабочийЛист.Ссылка КАК Документ,
	РабочийЛист.Автомобиль КАК Автомобиль,
	0 КАК ВсегоТрафика,
	0 КАК ВхЗвонки,
	0 КАК ВхКлиенты,
	1 КАК Сделки,
	0 КАК ТестДрайв,
	0 КАК Выдачи
ПОМЕСТИТЬ Результат
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСостояний.СрезПоследних(&amp;ДатаОкончания, Состояние В (ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Сделка), ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Продажа))) КАК ЖурналСостоянийСрезПоследних
		ПО РабочийЛист.Ссылка = ЖурналСостоянийСрезПоследних.Объект
ГДЕ
	ЖурналСостоянийСрезПоследних.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	РегистрацияЗвонковИКонтактов.Участник.Подразделение,
	РегистрацияЗвонковИКонтактов.РабочийЛист.Модель,
	РегистрацияЗвонковИКонтактов.Участник,
	РегистрацияЗвонковИКонтактов.Клиент,
	РегистрацияЗвонковИКонтактов.РабочийЛист,
	ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка),
	1,
	ВЫБОР
		КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ,
	0,
	0,
	0
ИЗ
	РегистрСведений.РегистрацияЗвонковИКонтактов КАК РегистрацияЗвонковИКонтактов
ГДЕ
	РегистрацияЗвонковИКонтактов.ДатаДень МЕЖДУ &amp;ДатаНачала И КОНЕЦПЕРИОДА(&amp;ДатаОкончания, ДЕНЬ)
	И РегистрацияЗвонковИКонтактов.РабочийЛист ССЫЛКА Документ.РабочийЛист

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Событие.Продавец.Подразделение,
	ВЫБОР
		КОГДА Событие.ДокументОснование ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
		КОГДА Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
			ТОГДА ВЫРАЗИТЬ(Событие.ДокументОснование КАК Документ.РабочийЛист).Модель
		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
	КОНЕЦ,
	Событие.Продавец,
	Событие.Контрагент,
	ВЫБОР
		КОГДА Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
			ТОГДА Событие.ДокументОснование
		ИНАЧЕ ЗНАЧЕНИЕ(Документ.РабочийЛист.ПустаяСсылка)
	КОНЕЦ,
	ВЫБОР
		КОГДА Событие.Автомобиль = ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
			ТОГДА "&lt;Автомобиль не указан&gt;"
		ИНАЧЕ Событие.Автомобиль
	КОНЕЦ,
	0,
	0,
	0,
	0,
	1,
	0
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТестДрайв)
	И Событие.ДатаОкончания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Событие.Продавец.Подразделение,
	Событие.Автомобиль.Модель,
	Событие.Продавец,
	Событие.Контрагент,
	ВЫБОР
		КОГДА Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
			ТОГДА Событие.ДокументОснование
		ИНАЧЕ ЗНАЧЕНИЕ(Документ.РабочийЛист.ПустаяСсылка)
	КОНЕЦ,
	Событие.Автомобиль,
	0,
	0,
	0,
	0,
	0,
	1
ИЗ
	Документ.Событие КАК Событие
ГДЕ
	Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ВыдачаАвтомобиля)
	И Событие.ДатаОкончания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)
	И Событие.ПометкаУдаления = ЛОЖЬ
	И Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист
	И Событие.ДокументОснование.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Продажа)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Результат.Менеджер,
	Результат.Документ,
	Результат.Подразделение,
	Результат.Контрагент,
	Результат.Автомобиль,
	Результат.ВсегоТрафика,
	Результат.ВхЗвонки,
	Результат.ВхКлиенты,
	Результат.ТестДрайв,
	Результат.Сделки,
	Результат.Выдачи,
	Результат.Модель
ИЗ
	Результат КАК Результат
ГДЕ
	ВЫБОР
			КОГДА &amp;ТолькоДействующиеСотрудники
				ТОГДА НЕ Результат.Менеджер.ФлагУволен
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ТолькоТрейдИн
				ТОГДА Результат.Документ.ТрейдИн
			ИНАЧЕ ИСТИНА
		КОНЕЦ</query>
