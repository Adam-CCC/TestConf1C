<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Запрос</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодразделениеКомпании</dataPath>
			<field>ПодразделениеКомпании</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Менеджер</dataPath>
			<field>Менеджер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>База</dataPath>
			<field>База</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>База</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контактов30</dataPath>
			<field>Контактов30</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>30 Контактов</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаявкаССайта</dataPath>
			<field>ЗаявкаССайта</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заявка с сайта</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СайтыОбъявлений</dataPath>
			<field>СайтыОбъявлений</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сайты объявлений</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РабочийЛист.Менеджер,
	РабочийЛист.ПодразделениеКомпании,
	РабочийЛист.Организация,
	СУММА(ВЫБОР
			КОГДА РабочийЛист.ИсточникОбзвона = ЗНАЧЕНИЕ(Перечисление.ИсточникиОбзвона.База)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК База,
	СУММА(ВЫБОР
			КОГДА РабочийЛист.ИсточникОбзвона = ЗНАЧЕНИЕ(Перечисление.ИсточникиОбзвона.СайтыОбъявлений)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК СайтыОбъявлений,
	СУММА(ВЫБОР
			КОГДА РабочийЛист.ИсточникОбзвона = ЗНАЧЕНИЕ(Перечисление.ИсточникиОбзвона.ЗаявкаССайта)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ЗаявкаССайта,
	СУММА(ВЫБОР
			КОГДА РабочийЛист.ИсточникОбзвона = ЗНАЧЕНИЕ(Перечисление.ИсточникиОбзвона.Контактов30)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Контактов30
ИЗ
	Документ.РабочийЛист КАК РабочийЛист
ГДЕ
	РабочийЛист.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И РабочийЛист.ТипРабочегоЛиста = ЗНАЧЕНИЕ(Перечисление.ТипыСообщений.Исходящее)

СГРУППИРОВАТЬ ПО
	РабочийЛист.Организация,
	РабочийЛист.ПодразделениеКомпании,
	РабочийЛист.Менеджер</query>
	</dataSet>
	<calculatedField>
		<dataPath>Всего</dataPath>
		<expression>База + ЗаявкаССайта + Контактов30 + СайтыОбъявлений</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Всего</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>База</dataPath>
		<expression>Сумма(База)</expression>
	</totalField>
	<totalField>
		<dataPath>ЗаявкаССайта</dataPath>
		<expression>Сумма(ЗаявкаССайта)</expression>
	</totalField>
	<totalField>
		<dataPath>Контактов30</dataPath>
		<expression>Сумма(Контактов30)</expression>
	</totalField>
	<totalField>
		<dataPath>СайтыОбъявлений</dataPath>
		<expression>Сумма(СайтыОбъявлений)</expression>
	</totalField>
	<totalField>
		<dataPath>Всего</dataPath>
		<expression>Сумма(Всего)</expression>
	</totalField>
