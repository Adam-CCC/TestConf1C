		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказНаряд.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	ЗаказНаряд.Контрагент КАК СтраховаяКомпания,
	ЗаказНаряд.НомерНаправленияСК,
	ЗаказНаряд.Автомобиль.Модель КАК Модель,
	ЗаказНаряд.Заказчик,
	ЗаказНаряд.Номер КАК НомерЗаказНаряда,
	СчетНаОплату.Номер КАК НомерСчета,
	СчетНаОплату.СуммаДокумента КАК СуммаПоСчету,
	ЗаказНаряд.ДатаЗакрытия КАК ДатаПодписанияАВР,
	СчетНаОплату.Дата КАК ДатаСчета,
	СчетНаОплату.Комментарий,
	ЗаказНаряд.ВидРемонта,
	ЗаказНаряд.Автомобиль.Модель.Родитель КАК Марка
ИЗ
	Документ.СчетНаОплату КАК СчетНаОплату
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряд
		ПО СчетНаОплату.ДокументОснование = ЗаказНаряд.Ссылка
ГДЕ
	ЗаказНаряд.Проведен
	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	И СчетНаОплату.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
