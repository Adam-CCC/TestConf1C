		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ИсторияТехОбслуживания.Автомобиль,
	СУММА(1) КАК КоличествоВизитовНаТО,
	МАКСИМУМ(ИсторияТехОбслуживания.ДатаТО) КАК ДатаПоследнегоТО,
	МАКСИМУМ(ИсторияТехОбслуживания.НомерТО) КАК НомерПоследнегоТО,
	ИсторияТехОбслуживания.ПодразделениеТО
ПОМЕСТИТЬ ИсторияТехобслуживания
ИЗ
	РегистрСведений.ИсторияТехОбслуживания КАК ИсторияТехОбслуживания
ГДЕ
	ИсторияТехОбслуживания.ЗаказНарядТО &lt;&gt; ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)

СГРУППИРОВАТЬ ПО
	ИсторияТехОбслуживания.Автомобиль,
	ИсторияТехОбслуживания.ПодразделениеТО
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИсторияТехОбслуживания.Автомобиль,
	ИсторияТехОбслуживания.НомерТО,
	ИсторияТехОбслуживания.ДатаТО,
	ИсторияТехОбслуживания.ПодразделениеТО
ПОМЕСТИТЬ ЗапланированныеТО
ИЗ
	РегистрСведений.ИсторияТехОбслуживания КАК ИсторияТехОбслуживания
ГДЕ
	ИсторияТехОбслуживания.ЗаказНарядТО = ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РеализацияАвтомобилейАвтомобили.Ссылка.Дата КАК ДатаПродажи,
	РеализацияАвтомобилейАвтомобили.Автомобиль КАК Автомобиль,
	РеализацияАвтомобилейАвтомобили.Автомобиль.Модель КАК Модель,
	РеализацияАвтомобилейАвтомобили.Ссылка.ПодразделениеКомпании КАК Подразделение,
	АвтомобилиСрезПоследних.Значение КАК Владелец
ПОМЕСТИТЬ ПроданныеАвтомобили
ИЗ
	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(, ) КАК АвтомобилиСрезПоследних
		ПО РеализацияАвтомобилейАвтомобили.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
ГДЕ
	РеализацияАвтомобилейАвтомобили.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И НЕ РеализацияАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма
	И РеализацияАвтомобилейАвтомобили.Ссылка.Проведен
	И НЕ РеализацияАвтомобилейАвтомобили.Ссылка.ПродажаБУАвто
	И АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПроданныеАвтомобили.Владелец,
	ПроданныеАвтомобили.Автомобиль,
	ПроданныеАвтомобили.Модель,
	ПроданныеАвтомобили.Подразделение,
	КонтактнаяИнформация.Представление КАК Адрес,
	ПроданныеАвтомобили.ДатаПродажи,
	ПроданныеАвтомобили.Владелец.ОсновнойТелефон КАК Телефон
ПОМЕСТИТЬ АвтомобилиИВладельцы
ИЗ
	ПроданныеАвтомобили КАК ПроданныеАвтомобили
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		ПО ПроданныеАвтомобили.Владелец = КонтактнаяИнформация.Объект
ГДЕ
	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	И КонтактнаяИнформация.ЗначениеПоУмолчанию
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	АвтомобилиИВладельцы.Автомобиль,
	АвтомобилиИВладельцы.ДатаПродажи,
	АвтомобилиИВладельцы.Владелец,
	ЕСТЬNULL(ЗапланированныеТО.НомерТО, 0) КАК НомерЗапланированногоТО,
	ЕСТЬNULL(ЗапланированныеТО.ДатаТО, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаЗапланированногоТО,
	ЕСТЬNULL(ИсторияТехобслуживания.КоличествоВизитовНаТО, 0) КАК КоличествоВизитовНаТО,
	ЕСТЬNULL(ИсторияТехобслуживания.ДатаПоследнегоТО, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаПоследнегоТО,
	ЕСТЬNULL(ИсторияТехобслуживания.НомерПоследнегоТО, 0) КАК НомерПоследнегоТО,
	АвтомобилиИВладельцы.Модель,
	АвтомобилиИВладельцы.Подразделение,
	АвтомобилиИВладельцы.Телефон,
	АвтомобилиИВладельцы.Адрес
ИЗ
	АвтомобилиИВладельцы КАК АвтомобилиИВладельцы
		ЛЕВОЕ СОЕДИНЕНИЕ ЗапланированныеТО КАК ЗапланированныеТО
		ПО АвтомобилиИВладельцы.Автомобиль = ЗапланированныеТО.Автомобиль
			И АвтомобилиИВладельцы.Подразделение = ЗапланированныеТО.ПодразделениеТО
		ЛЕВОЕ СОЕДИНЕНИЕ ИсторияТехобслуживания КАК ИсторияТехобслуживания
		ПО АвтомобилиИВладельцы.Автомобиль = ИсторияТехобслуживания.Автомобиль
			И АвтомобилиИВладельцы.Подразделение = ИсторияТехобслуживания.ПодразделениеТО</query>
	</dataSet>
