					Для Каждого ТекФайл Из МассивФайлов Цикл
						Если Найти(ТекФайл.Имя,"_"+КодПользователя+".")>0 Тогда
							// удаляем файл
							УдалитьФайлы(ТекФайл.ПолноеИмя);
						КонецЕсли;
					КонецЦикла;
				Иначе
					//ответ: восстановить
					Для каждого ТекФайл Из МассивФайлов Цикл
