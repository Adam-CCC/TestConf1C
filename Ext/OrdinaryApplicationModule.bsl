		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОписаниеИзмененийКонфигурации.Ссылка,
		|	ОписаниеИзмененийКонфигурации.Дата,
		|	ОписаниеИзмененийКонфигурации.ПометкаУдаления
		|ИЗ
		|	Документ.ОписаниеИзмененийКонфигурации КАК ОписаниеИзмененийКонфигурации
		|ГДЕ
		|	ОписаниеИзмененийКонфигурации.ПометкаУдаления = ЛОЖЬ
		|	И ОписаниеИзмененийКонфигурации.Дата МЕЖДУ &ВыбДата1 И &ВыбДата2";
		
		Запрос.Параметры.Вставить("ВыбДата1",НачалоДня(ТекДата));	
		Запрос.Параметры.Вставить("ВыбДата2",КонецДня(ТекДата));	
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Возврат ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
		
		Возврат "";
	Исключение
		Возврат "";
	КонецПопытки;	
	
КонецФункции	

// Процедура вызывается периодически для получения списка сообщений на оборудовании и обработка их
Процедура глПолучитьСписокSMSСообщений(GUIDОборудования) Экспорт
	Если обПраво("АдминистраторВходящихSMSСообщений",глПрава) Тогда
		////получаем сообщения с оборудования
		ТекОборудование = Справочники.Оборудование.НайтиПоРеквизиту("ИдентификаторОборудования",GUIDОборудования);
		Если НЕ ТекОборудование = Справочники.Оборудование.ПустаяСсылка() Тогда
			Фильтр = глТорговоеОборудование.СоздатьФильтр(2,0,0,"","",0,"",0,0,ТекОборудование);
			СписокСообщений = глТорговоеОборудование.ПолучитьСписокСообщений(Фильтр,ТекОборудование);
			кмОбработатьСписокВхСообщений(СписокСообщений,глТорговоеОборудование);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

