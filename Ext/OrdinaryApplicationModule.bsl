Процедура ВключитьОтображениеНапоминанияСРабочимиЛистами()
	
	ИнтервалОтображения = обПраво("ИнтервалНапоминанияСРабочимиЛистами");
	
	Если ИнтервалОтображения > 0 Тогда
		ПоказатьНапоминаниеСРабочимиЛистами();
		ПодключитьОбработчикОжидания("ПоказатьНапоминаниеСРабочимиЛистами", ИнтервалОтображения * 60);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьНапоминаниеСРабочимиЛистами() Экспорт 
	// +++++ Соколмоторс +++++
	ДатаНачала = НачалоДня(ТекущаяДата());
	ДатаОкончания = КонецДня(ТекущаяДата());
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Статус", Справочники.СтатусыРабочегоЛиста.Создан);
	Запрос.УстановитьПараметр("Сотрудник", ПараметрыСеанса.Пользователь.Сотрудник);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РабочийЛистСервиса.Ссылка
	               |ИЗ
	               |	Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
	               |ГДЕ
	               |	НЕ РабочийЛистСервиса.ПометкаУдаления
	               |	И РабочийЛистСервиса.Статус = &Статус
	               |	И РабочийЛистСервиса.Менеджер = &Сотрудник
	               |	И РабочийЛистСервиса.ДатаКонтакта МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	Результат = Запрос.Выполнить().Выбрать();	
	Если Не Результат.Следующий() Тогда
		Возврат;
	КонецЕсли;
	// ----- Соколмоторс -----
	
	ОбработкаАРМСервис = Обработки.АРМСервис.Создать();
	ОбработкаАРМСервис.ЭтоНапоминание = Истина;
	Форма = ОбработкаАРМСервис.ПолучитьФорму("ИнтерфейсСервис");
	
	СписокРабочихЛистов = Форма.СписокРабочихЛистов;
	СписокРабочихЛистов.Отбор.Статус.ВидСравнения = ВидСравнения.Равно;
	СписокРабочихЛистов.Отбор.Статус.Значение = Справочники.СтатусыРабочегоЛиста.Создан;
	СписокРабочихЛистов.Отбор.Статус.Использование = Истина;
	
	СписокРабочихЛистов.Отбор.Менеджер.ВидСравнения	= ВидСравнения.Равно;
	СписокРабочихЛистов.Отбор.Менеджер.Значение = ПараметрыСеанса.Пользователь.Сотрудник;
	СписокРабочихЛистов.Отбор.Менеджер.Использование = Истина;	
	
	//СписокРабочихЛистов.Отбор.УчастникПрограммыПроактивныйКонтакт.Значение = Истина;
	//СписокРабочихЛистов.Отбор.УчастникПрограммыПроактивныйКонтакт.Использование = Истина;
	СписокРабочихЛистов.Отбор.ДатаКонтакта.ВидСравнения = ВидСравнения.ИнтервалВключаяГраницы;
	СписокРабочихЛистов.Отбор.ДатаКонтакта.ЗначениеС = ДатаНачала;
	СписокРабочихЛистов.Отбор.ДатаКонтакта.ЗначениеПо = ДатаОкончания;
	СписокРабочихЛистов.Отбор.ДатаКонтакта.Использование = Истина;
	
	Форма.Открыть();
	
КонецПроцедуры

