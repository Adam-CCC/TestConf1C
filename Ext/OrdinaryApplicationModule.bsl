 		КонецЕсли;             
		//Бондаренко-- 20230616
		
		//Гэндальф+++
		
		Если РаботатьСМониторомТехника Тогда
			АрмТехника = Отчеты.МониторТехника.ПолучитьФорму("ФормаНастроек");
