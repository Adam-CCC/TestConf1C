						Если Найти(ТекФайл.Имя,"_"+КодПользователя+".")=0 Тогда Продолжить; КонецЕсли;
						//получим структуру файла
						Попытка
							СтруктураФайла = ЗначениеИзФайла(ТекФайл.ПолноеИмя);
						Исключение
							Сообщить("Ошибка считывания файла: " + ОписаниеОшибки());
