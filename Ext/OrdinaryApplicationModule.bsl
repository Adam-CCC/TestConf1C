// Обработка предопределенного события
// Выдает запрос на завершение работы
Процедура ПередЗавершениемРаботыСистемы(Отказ)
	// Проверим режим выхода (инициирован пользователем или нет)
	//Попытка
	//	ВнешняяКомпонентаПодключена=Обработки.Защита.Создать().Компонента.УправлениеАктивно();
	//Исключение 
	//	ВнешняяКомпонентаПодключена=Ложь;
	//КонецПопытки;
	//Если ВнешняяКомпонентаПодключена Тогда
	Если НЕ глЗавершениеРаботыСистемы Тогда
		// Запрос на завершение работы системы у пользователя
		Если (обПраво("РаботаСФронтомКассира",глПрава)<>Перечисления.РаботаСФронтомКассира.ТолькоСФронтом) И
			 (НЕ обПраво("УРВ_РаботатьТолькоСАРМомСотрудникаЦеха",глПрава)) Тогда
			Если обПраво("ПоказыватьЗапросНаЗавершениеРаботы",глПрава) Тогда
				Если Вопрос("Завершить работу программы?",РежимДиалогаВопрос.ДаНет,5,КодВозвратаДиалога.Да) = КодВозвратаДиалога.Нет Тогда
					Отказ = Истина; // Пользователь передумал и отменил выход из программы
					Возврат;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	ОбработкаПланировщикаЗадач(Перечисления.ПериодыЗапускаЗадачПланировщика.ПередЗавершениемРаботыСистемы);
	//Если ВнешняяКомпонентаПодключена Тогда
	//	Попытка // отключаем торговое оборудование
	//		Если глТорговоеОборудование<>НЕОПРЕДЕЛЕНО Тогда
	//			глТорговоеОборудование.ОтключитьТорговоеОборудование();
	//		КонецЕсли;
	//	Исключение
	//	КонецПопытки;
	//КонецЕсли;
	//+СофтФон
	Если НЕ Отказ Тогда
		// Завершим работу СофтФона перед выходом из предприятия
		Если НЕ (РарусСофтФонПроф = Неопределено) Тогда
			РарусСофтФонПроф.ЗавершитьСофтФон();
		КонецЕсли;
	КонецЕсли;
	
	//Бондаренко 20150923 ++
	Если НЕ Отказ Тогда
		
		ТекПользователь = ПараметрыСеанса.Пользователь;
		ТекДата = НачалоДня(ТекущаяДата());
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыРаботыПользователей.Пользователь,
		|	ДатыРаботыПользователей.ДатаРаботы
		|ИЗ
		|	РегистрСведений.ДатыРаботыПользователей КАК ДатыРаботыПользователей
		|ГДЕ
		|	ДатыРаботыПользователей.Пользователь = &ВыбПольз
		|	И ДатыРаботыПользователей.ДатаРаботы <> &ВыбДата";
		
		Запрос.УстановитьПараметр("ВыбДата",ТекДата);
		Запрос.УстановитьПараметр("ВыбПольз",ТекПользователь);
		
		Результат = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Количество() > 0 Тогда
			РегДРП=РегистрыСведений.ДатыРаботыПользователей.СоздатьНаборЗаписей();
			РегДРП.Отбор.Пользователь.Установить(ТекПользователь);
			Попытка
				РегДРП.Записать();
			Исключение
				//
			КонецПопытки;	
		КонецЕсли;
		РегДРП=РегистрыСведений.ДатыРаботыПользователей.СоздатьМенеджерЗаписи();
		РегДРП.Пользователь=ТекПользователь;
		РегДРП.ДатаРаботы = ТекДата;
		Попытка
			РегДРП.Записать();
		Исключение
			//
		КонецПопытки;	
 	
 	КонецЕсли;
	//Бондаренко 20150923 --
	
	  // SP1C / SIP Софтфон для 1С / НАЧАЛО
    Если НЕ РарусСофтФонПроф  = Неопределено Тогда
	РарусСофтФонПроф.ОтключитьВК();
    КонецЕсли;
    // SP1C / SIP Софтфон для 1С / КОНЕЦ
