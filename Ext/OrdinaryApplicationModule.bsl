							КонецЕсли;
						КонецЦикла;
						
						// откроем форму сохраненного документа
						ФормаДокумента = ТекДокумент.ПолучитьФорму("ФормаДокумента");
						ФормаДокумента.Открыть();
						ФормаДокумента.Модифицированность = Истина;
						
						// удаляем файл
						УдалитьФайлы(ТекФайл.ПолноеИмя);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Гэндальф+++
	   	#Если Клиент Тогда
	    Запрос =  Новый Запрос;
