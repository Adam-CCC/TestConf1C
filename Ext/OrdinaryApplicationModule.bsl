			//АрмСотрудника = Обработки.АРМСотрудникЦехаМобильный.ПолучитьФорму("ИнтерфейсСотрудникЦеха");
			АрмСотрудника = Обработки.АРМСотрудникЦехаШтрихкод.ПолучитьФорму("Форма");
			АрмСотрудника.ОткрытьМодально();
			ЗавершитьРаботуСистемы(Ложь);
			Возврат;
			// Семенихин 25.04.2023 -----
		КонецЕсли;
		
		//Бондаренко++ 20230616
		// запуск АРМа ТСД
		Если РаботатьТолькоСАРМомТСД Тогда
 			АрмТСД = Документы.ТСД.ПолучитьФормуНовогоДокумента("ФормаДокумента");
			АрмТСД.ОткрытьМодально();
			ЗавершитьРаботуСистемы(Ложь);
