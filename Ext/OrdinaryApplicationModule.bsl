		МассивФайлов = НайтиФайлы(ПараметрыСеанса.Компьютер.ЛокальныйКаталог, "*.dct");
		GUIDКонфиграции = СтрЗаменить(Сред(ЗначениеВСтрокуВнутр(Метаданные),6,36),"-","");
