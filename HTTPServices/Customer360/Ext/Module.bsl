Процедура ОтменитьЗапланированныеСобытия(РабочийЛистСсылка)
	ЗапросСобытия = Новый Запрос();
	ЗапросСобытия.УстановитьПараметр("Запланировано", Перечисления.СостоянияСобытий.Запланировано);
	ЗапросСобытия.УстановитьПараметр("РабочийЛист", РабочийЛистСсылка);
	ЗапросСобытия.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.Состояние = &Запланировано
	|	И Событие.ДокументОснование = &РабочийЛист";
	
	Результат = ЗапросСобытия.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		СобытиеОбъект = Результат.Ссылка.ПолучитьОбъект();
		СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Отменено;
		СобытиеОбъект.Результат = "Лид закрыт на портале Customer360.";
		Попытка
			СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			СобытиеОбъект.ОбменДанными.Загрузка = Истина;
			СобытиеОбъект.Записать();
		КонецПопытки;
	КонецЦикла;	
КонецПроцедуры
