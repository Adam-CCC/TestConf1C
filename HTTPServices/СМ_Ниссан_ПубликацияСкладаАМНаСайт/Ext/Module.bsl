Функция Excelget(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(204,"ОШИБКА! Файл XLSX не сформирован.");
	
	
	ФайлЭксел = ПолучитьФайлОстатков();   
	
	Если ФайлЭксел="" Тогда
		Ответ = Новый HTTPСервисОтвет(204,"ОШИБКА! Файл XLSX не сформирован.");
		Возврат Ответ;
	КонецЕсли; 
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/vnd.ms-excel");
	Ответ.Заголовки.Вставить("Content-Disposition", "attachement; filename=stock.xlsx");
	Ответ.УстановитьТелоИзДвоичныхДанных(ФайлЭксел);
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьФайлОстатков()
	
	ПутьКФайлуЭксел = "";
	
	//Бондаренко++ 20211129
 	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ЗначенияСвойствОбъектов.Объект КАК Автомобиль
	             |ИЗ
	             |	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	             |ГДЕ
	             |	ЗначенияСвойствОбъектов.Объект ССЫЛКА Справочник.Автомобили
	             |	И ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ИспользоватьДляТестДрайва)
	             |	И ЗначенияСвойствОбъектов.Значение = ИСТИНА";
	 
	
 	СписокАвтоТестДрайва = Новый СписокЗначений;
	СписокАвтоТестДрайва.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Автомобиль"));	
	//Бондаренко-- 20211129
 	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиАвтомобилейОстатки.Автомобиль,
	               |	ПОДСТРОКА(ОстаткиАвтомобилейОстатки.Автомобиль.VIN, 12, 6) КАК ID,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.VIN КАК VIN,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации.Артикул КАК КодМаркетинговойКомплектации,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.Цвет.Артикул КАК КодЦветаКузова,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.ТипСалона.КодСалона КАК КодЦветаСалона,
	               |	КодыДилеров.КодДилера КАК КодДилерскогоЦентра,
	               |	"""" КАК ПТС,
	               |	Цены.Цена + ОстаткиАвтомобилейОстатки.Автомобиль.СтоимостьДопОборудования КАК Цена,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.СпециальнаяЦена КАК СпециальнаяЦена,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.СкидаПриПокупкеВТрейдИн КАК ТрейдИнБонус,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриПокупкеВКредит КАК ПреимуществоПриПокупкеВКредит,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриСтраховании КАК ПреимуществоПриСтраховании,
	               |	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаМаксимальная КАК ТрейдИнБонусПлюсВКредит
	               |ИЗ
	               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
	               |			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
	               |			АвтомобилиСрезПоследних.Значение КАК Значение
	               |		ИЗ
	               |			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	               |		ГДЕ
	               |			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля)
	               |			И АвтомобилиСрезПоследних.Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.Новый)) КАК ХарАвто
	               |		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ХарАвто.Автомобиль
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			КодыДилеровСрезПоследних.ПодразделениеКомпании КАК ПодразделениеКомпании2,
	               |			КодыДилеровСрезПоследних.Бренд КАК Бренд,
	               |			КодыДилеровСрезПоследних.КодДилера КАК КодДилера
	               |		ИЗ
	               |			РегистрСведений.КодыДилеров.СрезПоследних КАК КодыДилеровСрезПоследних) КАК КодыДилеров
	               |		ПО ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение = КодыДилеров.ПодразделениеКомпании2
	               |			И ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка = КодыДилеров.Бренд
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ЦеныАвтомобилейСрезПоследних.ТипЦен КАК ТипЦен,
	               |			ЦеныАвтомобилейСрезПоследних.Автомобиль КАК АвтомобильЦены,
	               |			ЦеныАвтомобилейСрезПоследних.Цена КАК Цена
	               |		ИЗ
	               |			РегистрСведений.ЦеныАвтомобилей.СрезПоследних КАК ЦеныАвтомобилейСрезПоследних) КАК Цены
	               |		ПО ОстаткиАвтомобилейОстатки.Автомобиль = Цены.АвтомобильЦены
	               |ГДЕ
	               |	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
	               |	И ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка = ЗНАЧЕНИЕ(Справочник.Марка.NISSAN)
	               |	И Цены.ТипЦен = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)
	               |	И НЕ ОстаткиАвтомобилейОстатки.Автомобиль В (&СписокАвтоТестДрайва)"; 
	//Бондаренко++ 20211129
 	Запрос.УстановитьПараметр("СписокАвтоТестДрайва",СписокАвтоТестДрайва);
	//Бондаренко-- 20211129
 	
	ТзВрем = Запрос.Выполнить().Выгрузить();
	
	ТЗВрем.Колонки.Вставить(4,"ГодВыпуска", Новый ОписаниеТипов("Строка"));
	ТЗВрем.Колонки.Вставить(8,"ЛогистическийСтатус", Новый ОписаниеТипов("Строка"));
	ТЗВрем.Колонки.Вставить(9,"ДополнительныеОпции", Новый ОписаниеТипов("Строка")); 
	ТЗВрем.Колонки.Вставить(10,"ФотоАвтомобиля", Новый ОписаниеТипов("Строка")); 	
	ТЗВрем.Колонки.Вставить(11,"Описание", Новый ОписаниеТипов("Строка")); 	
	ТЗВрем.Колонки.Вставить(12,"Тэги", Новый ОписаниеТипов("Строка")); 		
 	
	Для каждого Стр Из ТЗВрем Цикл
		Если обЗначениеНеЗаполнено(Стр.Автомобиль) Тогда
			Продолжить;		
		КонецЕсли;
		Стр.ЛогистическийСтатус = "На складе дилера";
		Стр.ГодВыпуска = Сред(СокрЛП(Стр.Автомобиль.ГодВыпуска),7,4);
		СЗ  = ПолучитьСписокОпций(Стр.Автомобиль);
		Для каждого Элем Из СЗ Цикл
			Если СокрЛП(Стр.ДополнительныеОпции) <> "" Тогда
				Стр.ДополнительныеОпции = СокрЛП(Стр.ДополнительныеОпции)+";"+СокрЛП(Элем.Значение);
			Иначе
				Стр.ДополнительныеОпции = СокрЛП(Элем.Значение);			
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
	
	Колонка = ТЗврем.Колонки.Найти("Автомобиль");
	Если НЕ Колонка = Неопределено Тогда
		ТЗврем.Колонки.Удалить(Колонка);
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных=Новый ОписаниеИсточникаДанных(ТзВрем);       
	
	//Бондаренко++ 2021201
	Построитель.ВыводитьЗаголовокОтчета=Ложь;
	//Бондаренко-- 2021201
	
	Построитель.Вывести(ТабДокумент);
	
	//Бондаренко++ 2021201
	Попытка	ТабДокумент.УдалитьОбласть(ТабДокумент.Область(1,1,ТабДокумент.ВысотаТаблицы,1),ТипСмещенияТабличногоДокумента.ПоГоризонтали); Исключение КонецПопытки;	
	//Бондаренко-- 20211129
	
	//ТабДокумент.Показать("Создан табличный документ"); 
	
	Попытка
		ИмяФайла =   ПолучитьИмяВременногоФайла();         
		ТабДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX); 
		ДвоичныеДанныеФайлаЭксел = Новый ДвоичныеДанные(ИмяФайла);
	Исключение        
		ДвоичныеДанныеФайлаЭксел = "";
	КонецПопытки;
	
	Возврат ДвоичныеДанныеФайлаЭксел;	
	
КонецФункции // ПолучитьФайлОстатков()

Функция ПолучитьСписокОпций(Авто)
	
	СЗ = Новый СписокЗначений;
	ДатаПоследнегоПоступления = НайтиДатуПоследнегоПоступления(Авто);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КомплектацияАвтомобиляТовары.Номенклатура.Наименование КАК Номенклатура
	|ИЗ
	|	Документ.КомплектацияАвтомобиля.Товары КАК КомплектацияАвтомобиляТовары
	|ГДЕ
	|	КомплектацияАвтомобиляТовары.Ссылка.Дата >= &Дата
	|	И КомплектацияАвтомобиляТовары.Ссылка.Проведен = ИСТИНА
	|	И КомплектацияАвтомобиляТовары.Ссылка.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", Авто);
	Запрос.УстановитьПараметр("Дата", ДатаПоследнегоПоступления);
	
	СЗ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура"));
	
	Возврат СЗ;
	
КонецФункции // ПолучитьСписокОпций()

Функция НайтиДатуПоследнегоПоступления(Авто)
	
	ДатаПоступления = Дата(1,1,1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК Дата,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен = ИСТИНА
	|	И ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма = ЛОЖЬ
	|	И ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ"; 
	
	Запрос.УстановитьПараметр("Автомобиль",Авто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДатаПоступления = ВыборкаДетальныеЗаписи.Дата; 
		Прервать
	КонецЦикла;                   
	
	Возврат ДатаПоступления;
	
КонецФункции // НайтиДатуПоследнегоПоступления()
