
Функция ШаблонКлиентПолучитьДокументы(Запрос)
	НомерТелефона = Запрос.ПараметрыURL["PhoneNumber"];
	//ПолеХраненияНомера = ПолучитьИндексНомераТелефона(НомерТелефона, глЦифрДляИндексаТелефона);
	ПолеХраненияНомера = ПолучитьИндексНомераТелефона(НомерТелефона, 11);
	
	ЗаголовкиHTTP = Новый Соответствие;
	//ЗаголовкиHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Content-Type", "text/html; charset=utf-8");
	//ЗаголовкиHTTP.Вставить("Accept", "application/json");
	ЗаголовкиHTTP.Вставить("Connection", "Keep-Alive");
	Ответ = Новый HTTPСервисОтвет(200,, ЗаголовкиHTTP);
	стТелоОтвета = Новый Структура;
	
	ЗапросКонтрагенты = Новый Запрос();
	ЗапросКонтрагенты.Параметры.Вставить("ПолеХраненияНомера", ПолеХраненияНомера);
	ЗапросКонтрагенты.Текст = "ВЫБРАТЬ
	                          |	КонтактнаяИнформация.Объект КАК Контрагент
	                          |ИЗ
	                          |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                          |ГДЕ
	                          |	КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	                          |	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	                          |	И КонтактнаяИнформация.CRM_ПолеХраненияНомера = &ПолеХраненияНомера";
	
	РезультатКонтрагенты = ЗапросКонтрагенты.Выполнить().Выбрать();
	Если РезультатКонтрагенты.Следующий() Тогда
		Контрагент = РезультатКонтрагенты.Контрагент;
		стТелоОтвета.Вставить("КлиентНайден", Истина);
		стТелоОтвета.Вставить("Клиент", Строка(Контрагент));
	Иначе
		// не найден !!!
		стТелоОтвета.Вставить("КлиентНайден", Ложь);
		ЗаписьJSON = Новый ЗаписьJSON();
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, стТелоОтвета);		
		Ответ.КодСостояния = 200;
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
	КонецЕсли;
	
	ЗапросЗаказНаряды = Новый Запрос();
	ЗапросЗаказНаряды.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросЗаказНаряды.УстановитьПараметр("Закрыт", Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	ЗапросЗаказНаряды.Текст = "ВЫБРАТЬ
	                           |	ЗаказНаряд.Ссылка
	                           |ИЗ
	                           |	Документ.ЗаказНаряд КАК ЗаказНаряд
	                           |ГДЕ
	                           |	ЗаказНаряд.Заказчик = &Контрагент
	                           |	И ЗаказНаряд.ВидРемонта <> &Закрыт
	                           |	И НЕ ЗаказНаряд.ПометкаУдаления";
	
	РезультатЗаказНаряды = ЗапросЗаказНаряды.Выполнить().Выбрать();
	МассивЗаказНарядов = Новый Массив();
	Пока РезультатЗаказНаряды.Следующий() Цикл
		стЗаказНаряд = Новый Структура();
		стЗаказНаряд.Вставить("ЗаказНаряд", Строка(РезультатЗаказНаряды.Ссылка));
		МассивЗаказНарядов.Добавить(стЗаказНаряд);
	КонецЦикла;
	стТелоОтвета.Вставить("ЗаказНаряды", МассивЗаказНарядов);
	
	ЗапросРабочиеЛисты = Новый Запрос();
	ШаблонТелефона = "%" + Прав(ОставитьТолькоЦифры(НомерТелефона), 10);
	ЗапросРабочиеЛисты.УстановитьПараметр("ШаблонТелефона", ШаблонТелефона);
	ЗапросРабочиеЛисты.УстановитьПараметр("Продажа", Справочники.СтатусыРабочегоЛиста.Продажа);
	ЗапросРабочиеЛисты.Текст = "ВЫБРАТЬ
	                           |	РабочийЛист.Ссылка
	                           |ИЗ
	                           |	Документ.РабочийЛист КАК РабочийЛист
	                           |ГДЕ
	                           |	НЕ РабочийЛист.ПометкаУдаления
	                           |	И РабочийЛист.Статус <> &Продажа
	                           |	И РабочийЛист.ПредставлениеТелефона ПОДОБНО &ШаблонТелефона";
	
	РезультатРабочиеЛисты = ЗапросРабочиеЛисты.Выполнить().Выбрать();
	МассивРабочихЛистов = Новый Массив();
	Пока РезультатРабочиеЛисты.Следующий() Цикл
		стРабочийЛист = Новый Структура();
		стРабочийЛист.Вставить("РабочийЛист", Строка(РезультатРабочиеЛисты.Ссылка));
		МассивРабочихЛистов.Добавить(стРабочийЛист);
	КонецЦикла;
	стТелоОтвета.Вставить("РабочиеЛисты", МассивРабочихЛистов);
	
	//////////////////////////////////////////
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, стТелоОтвета);		
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

//Функция возвращает число - индекс для поиска номера телефона
Функция ПолучитьИндексНомераТелефона(НомерТелефона, ЧислоСимволов)
	ТолькоЦифрыНомера = "";
	Для сч = 1 По СтрДлина(НомерТелефона) Цикл
		СимволИзНомера = Сред(НомерТелефона, сч, 1);
		Если СтрЧислоВхождений("1234567890", СимволИзНомера) > 0 Тогда
			ТолькоЦифрыНомера = ТолькоЦифрыНомера + СимволИзНомера;
		КонецЕсли;
	КонецЦикла;
	
	Префикс = "1";
	Возврат ?(НЕ ЗначениеЗаполнено(ТолькоЦифрыНомера), 0, Число(Префикс + Прав(СокрЛП(ТолькоЦифрыНомера), ЧислоСимволов)));
КонецФункции

//Функция возвращает номер телефона в котором присутствуют только символы цифр
Функция ОставитьТолькоЦифры(НомерТелефона)
	ТолькоЦифрыНомера = "";
	Для сч = 1 По СтрДлина(НомерТелефона) Цикл
		СимволИзНомера = Сред(НомерТелефона, сч, 1);
		Если СтрЧислоВхождений("1234567890", СимволИзНомера) > 0 Тогда
			ТолькоЦифрыНомера = ТолькоЦифрыНомера + СимволИзНомера;
		КонецЕсли;
	КонецЦикла;
	Возврат ТолькоЦифрыНомера;
КонецФункции
