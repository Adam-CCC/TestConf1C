// POST метод
Функция v1_SetTraffic(Запрос)
	
	СтруктураПараметров = ПолучитьСтруктуруИзJSON(Запрос);
	
	Ошибки = ПроверитьЗаполнение(СтруктураПараметров);
	
	Если Ошибки <> Неопределено Тогда
		Возврат ОтветСервера(Ошибки.Код, Ошибки.Текст);
	КонецЕсли; 
	
	ЗаписатьНовыйТрафик(СтруктураПараметров);
	
	Возврат ОтветСервера(200, "Трафик успешно загружен");
	
КонецФункции


#Область Служебные
Функция ПолучитьСтруктуруИзJSON(Запрос)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
	Структура = ПрочитатьJSON(ЧтениеJSON);
	
	Возврат Структура;

КонецФункции

Функция ОтветСервера(КодОтвета, СтрокаОтвета="")
	
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "text/html; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаОтвета);
	
	Возврат Ответ;
	
КонецФункции	
#КонецОбласти  // Служебные


#Область ПроверкаЗаполненияСтруктуры

Функция ПроверитьЗаполнение(Структура)
	
	РеквизитыЗаполнены = Истина;
	МассивНеЗаполненных = Новый Массив;
	Ошибка = Новый Структура("Код, Текст");
	
	
	//--- 1. проверим наличие нужных полей в структуре ---
	#Область НаличиеПолей
	
	МассивПроверяемыхПолей = Новый Массив;
	МассивПроверяемыхПолей.Добавить("name");
	МассивПроверяемыхПолей.Добавить("phone");
	МассивПроверяемыхПолей.Добавить("callback");
	МассивПроверяемыхПолей.Добавить("sex");
	МассивПроверяемыхПолей.Добавить("primary");
	МассивПроверяемыхПолей.Добавить("department");
	МассивПроверяемыхПолей.Добавить("administrator");
	МассивПроверяемыхПолей.Добавить("source");
	МассивПроверяемыхПолей.Добавить("model");
	МассивПроверяемыхПолей.Добавить("manager");
	МассивПроверяемыхПолей.Добавить("comment");
	МассивПроверяемыхПолей.Добавить("claim");
	МассивПроверяемыхПолей.Добавить("remark");
	МассивПроверяемыхПолей.Добавить("missed");
	МассивПроверяемыхПолей.Добавить("missed_reason");
	МассивПроверяемыхПолей.Добавить("missed_text");
	МассивПроверяемыхПолей.Добавить("dealership");
	
	Для Каждого ПроверяемоеПоле Из МассивПроверяемыхПолей Цикл
		Если НЕ Структура.Свойство(ПроверяемоеПоле) Тогда
			РеквизитыЗаполнены = Ложь;
			МассивНеЗаполненных.Добавить(ПроверяемоеПоле);
		КонецЕсли; 
	КонецЦикла; 
	
	Если НЕ РеквизитыЗаполнены Тогда
		Текст = СтрСоединить(МассивНеЗаполненных, Символы.ПС);
		Ошибка.Текст = "В JSON-структуре отсутствуют поля:" + Символы.ПС + Текст;
		Ошибка.Код = 400;
		Возврат Ошибка;
	КонецЕсли; 
	
	#КонецОбласти	// НаличиеПолей
	
	
	//--- 2. дополним структуру нужными полями ---
	// перед проверкой заполняем всякие объектные значения из текста, типа поиска в справочнике по наименованию
	#Область ЗаполнимНужныеПоля
	
	//ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	ДилерскийЦентр = НайтиДилерскийЦентрПоBIR(Структура.dealership);
	ТипТрафика = Справочники.CRM_ТипТрафика.Звонок;
	
	Если НЕ ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		Ошибка.Текст = "У пользователя 1С не установлен дилерский центр по умолчанию";
		Ошибка.Код = 500;
		Возврат Ошибка;
	КонецЕсли;
	
	Пол = Перечисления.ПолФизическихЛиц[Структура.sex];
	ПервичныйПовторный = ?(Структура.primary, Перечисления.CRM_ПервичныйПовторный.Первичный, Перечисления.CRM_ПервичныйПовторный.Повторный);
	ВОтделПродаж = Ложь;
	Отдел = НайтиОтделПоНаименованию(ДилерскийЦентр, Структура.department, ВОтделПродаж);
	Администратор = НайтиАдминистратораПоНаименованию(ДилерскийЦентр, Структура.administrator);
	ИсточникИнформации = НайтиИсточникИнформацииПоНаименованию(Структура.source);
	Модель = НайтиМодельПоНаименованию(Структура.model, Отдел, ДилерскийЦентр);
	Менеджер = НайтиМенеджераПоНаименованию(Отдел, Структура.manager);
	Клиент = НайтиКлиента(Структура.name, Структура.phone);
	
	ПричинаУпущенногоКлиента = Справочники.CRM_ПричиныУпущенныхКлиентов.НайтиПоНаименованию(Структура.missed_reason, Истина);
	Если ПричинаУпущенногоКлиента = Неопределено Тогда
		ПричинаУпущенногоКлиента = Справочники.CRM_ПричиныУпущенныхКлиентов.ПустаяСсылка();
	КонецЕсли;
	
	ЗаписьНаСервис = Ложь;
	Если ДилерскийЦентр.ИспользуетАвтосервис Тогда
		Если Отдел.КлассификацияRenault = Перечисления.CRM_КлассификацияОтделов.ОтделСервиса Тогда
			ЗаписьНаСервис = ИСТИНА;
		КонецЕсли;
	КонецЕсли;
	
	
	Структура.Вставить("ДилерскийЦентр", ДилерскийЦентр);
	Структура.Вставить("ФИО", Структура.name);
	Структура.Вставить("Телефон", Структура.phone);
	Структура.Вставить("Перезвонить", Структура.callback);
	Структура.Вставить("Пол", Пол);
	Структура.Вставить("ПервичныйПовторный", ПервичныйПовторный);
	Структура.Вставить("Отдел", Отдел);
	Структура.Вставить("ВОтделПродаж", ВОтделПродаж);
	Структура.Вставить("Администратор", Администратор);
	Структура.Вставить("ИсточникИнформации", ИсточникИнформации);
	Структура.Вставить("Модель", Модель);
	Структура.Вставить("Менеджер", Менеджер);
	Структура.Вставить("Комментарий", Структура.comment);
	Структура.Вставить("Жалоба", Структура.claim);
	Структура.Вставить("ЗамечаниеМенеджеру", Структура.remark);
	Структура.Вставить("Упущен", Структура.missed);
	Структура.Вставить("Упущен_Причина", ПричинаУпущенногоКлиента);
	Структура.Вставить("Упущен_ТекстПричины", Структура.missed_text);
	
	Структура.Вставить("ТипТрафика", ТипТрафика);
	Структура.Вставить("ЗаписьНаСервис", ЗаписьНаСервис);
	Структура.Вставить("Клиент", Клиент);
	
	#КонецОбласти  // ЗаполнимНужныеПоля
	
	
	//--- 3. проверим заполнение обязательных полей ---
	// список реквизитов для проверки взят из обработки.Renault_ARM_Администратор.формы.ФормаРегистрацииОбщая - функция "ПроверитьЗаполнениеРеквизитов"
	#Область ПроверкаПолей
	
	СписокПроверяемыхПолей = Новый СписокЗначений;
	СписокПроверяемыхПолей.Добавить("ФИО", "ФИО (name)");
	СписокПроверяемыхПолей.Добавить("Телефон", "Телефон (phone)");
	СписокПроверяемыхПолей.Добавить("Администратор", "Администратор (administrator)");
	
	Если Не Структура.missed Тогда
		СписокПроверяемыхПолей.Добавить("Пол", "Пол (sex)");
		//СписокПроверяемыхПолей.Добавить("ИсточникИнформации", "Источник информации (source)");
		//СписокПроверяемыхПолей.Добавить("Модель", "Модель (model)");
		СписокПроверяемыхПолей.Добавить("Отдел", "Отдел (department)");
		СписокПроверяемыхПолей.Добавить("ПервичныйПовторный", "Первичный/Повторный (primary)");
	Иначе	// трафик упущен
		Если Структура.missed_reason = "Прочее" Тогда	    //Блинков внес доп условие проерки DMSREN-341
			СписокПроверяемыхПолей.Добавить("Упущен_Причина", "Причины упущенного клиента (missed_reason)");
			СписокПроверяемыхПолей.Добавить("Упущен_ТекстПричины", "Текст причины упущенного клиента (missed_text)");
		Иначе
			СписокПроверяемыхПолей.Добавить("Упущен_Причина", "Причины упущенного клиента (missed_reason)");
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ЭлементПП Из СписокПроверяемыхПолей Цикл
		Если НЕ ЗначениеЗаполнено(Структура[ЭлементПП.Значение]) Тогда
			РеквизитыЗаполнены = Ложь;
			МассивНеЗаполненных.Добавить(ЭлементПП.Представление);
		КонецЕсли;  
	КонецЦикла; 
	
	Если Не РеквизитыЗаполнены Тогда
		Текст = СтрСоединить(МассивНеЗаполненных, Символы.ПС);
		Ошибка.Текст = "В JSON-структуре не заполнены (или неправильно заполнены) поля:" + Символы.ПС + Текст;
		Ошибка.Код = 400;
		Возврат Ошибка;
	КонецЕсли; 
	
	#КонецОбласти  // ПроверкаПолей
	
	
	//--- конец проверок ---
	
	Возврат Неопределено;
	
КонецФункции 

Функция НайтиОтделПоНаименованию(ДилерскийЦентр, НаименованиеОтдела, ВОтделПродаж)
	
	Результат = Справочники.CRM_Отделы.ПустаяСсылка();
	
	// процедуры использованы те же, что и в АРМ Администратора при ручной регистрации трафика
	
	// это если нажата кнопка "другой отдел"
	СписокОтделов = Renault_CRM.ПолучитьСписокПрочихОтделовЦентра(ДилерскийЦентр);
	// а это если "отдел продаж"
	ОтделАвтосалона = Renault_CRM.ПолучитьОтделАвтосалона(ДилерскийЦентр);
	// объединим
	СписокОтделов.Добавить(ОтделАвтосалона);
	
	Для Каждого ЭлементСписка Из СписокОтделов Цикл
		Отдел = ЭлементСписка.Значение;
		Если Отдел.Наименование = НаименованиеОтдела Тогда
			Результат = Отдел;
			ВОтделПродаж = (Отдел = ОтделАвтосалона);
			Прервать;
		КонецЕсли;  
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //  

Функция НайтиАдминистратораПоНаименованию(ДилерскийЦентр, ФИОсотрудника)
	
	Результат = Неопределено;
	
	// процедуры использованы те же, что и в АРМ Администратора при ручной регистрации трафика
	СписокСотрудников = Renault_CRM.ПолучитьСписокСотрудниковРесепшн(ДилерскийЦентр);
	
	Для Каждого ЭлементСписка Из СписокСотрудников Цикл
		Сотрудник = ЭлементСписка.Значение;
		Если Сотрудник.Наименование = ФИОсотрудника Тогда
			Результат = Сотрудник;
			Прервать;
		КонецЕсли;  
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции //  

