КонецФункции //  

Функция НайтиИсточникИнформацииПоНаименованию(НаименованиеИИ)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсточникиИнформации.Ссылка
	               |ИЗ
	               |	Справочник.CRM_ИсточникиИнформации КАК ИсточникиИнформации
	               |ГДЕ
	               |	ИсточникиИнформации.ПометкаУдаления = ЛОЖЬ
	               |	И ИсточникиИнформации.Наименование = &Наименование
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИсточникиИнформации.Наименование";
	Запрос.УстановитьПараметр("Наименование", НаименованиеИИ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;  
	
	Возврат Результат;
	
КонецФункции //  

Функция НайтиМодельПоНаименованию(НаименованиеМодели, Отдел, ДилерскийЦентр)
	
	Результат = Неопределено;
	
	СписокМоделей = Справочники.CRM_Отделы.ПолучитьПервичныйИнтерес(Отдел);
	Если Не ЗначениеЗаполнено(СписокМоделей) Тогда
		СписокМоделей = Renault_CRM.ПолучитьПервичныйИнтерес(ДилерскийЦентр);
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из СписокМоделей Цикл
		ПервичныйИнтерес = ЭлементСписка.Значение;
		Если ПервичныйИнтерес.Наименование = НаименованиеМодели Тогда
			Результат = ПервичныйИнтерес;
			Прервать;
		КонецЕсли;  
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции //  

Функция НайтиДилерскийЦентрПоBIR(BIR)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_ДилерскиеЦентры.Ссылка
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	|ГДЕ
	|	НЕ CRM_ДилерскиеЦентры.ПометкаУдаления
	|	И CRM_ДилерскиеЦентры.BIR = &BIR";
	Запрос.УстановитьПараметр("BIR", BIR);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;  
	
	Возврат Результат;
	
КонецФункции //  

Функция НайтиКлиента(ФИО, Телефон)
	
	Результат = Неопределено;
	
	Телефон = НормализоватьТелефон(Телефон);
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_НормализованныеКонтактыДляПоиска.Объект КАК Контрагент
		|ИЗ
		|	РегистрСведений.Renault_НормализованныеКонтактыДляПоиска КАК Renault_НормализованныеКонтактыДляПоиска
		|ГДЕ
		|	(Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.Контрагенты
		|			ИЛИ Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.CRM_ПотенциальныеКонтрагенты)
		|	И Renault_НормализованныеКонтактыДляПоиска.Объект.Наименование = &Наименование
		|	И Renault_НормализованныеКонтактыДляПоиска.Данные = &Телефон";
		Запрос.УстановитьПараметр("Наименование", ФИО);
		Запрос.УстановитьПараметр("Телефон", Телефон);
		
		//|	И Renault_НормализованныеКонтактыДляПоиска.Объект.Наименование ПОДОБНО &Наименование
		//|	И Renault_НормализованныеКонтактыДляПоиска.Данные ПОДОБНО &Телефон";
		//Запрос.УстановитьПараметр("Наименование", "%"+СокрЛП(ФИО)+"%");
		//Запрос.УстановитьПараметр("Телефон", "%" + Телефон + "%");

		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Контрагент;
		КонецЕсли;  
	
	Возврат Результат;
	
КонецФункции //  

Функция НормализоватьТелефон(Телефон)
	
	Фрагмент = СокрЛП(Телефон);
	
	Фрагмент = СтрЗаменить(Фрагмент, "+", "");
	Фрагмент = СтрЗаменить(Фрагмент, "-", "");
	Фрагмент = СтрЗаменить(Фрагмент, ".", "");
	Фрагмент = СтрЗаменить(Фрагмент, "*", "");
	Фрагмент = СтрЗаменить(Фрагмент, " ", "");
	Фрагмент = СтрЗаменить(Фрагмент, "(", "");
	Фрагмент = СтрЗаменить(Фрагмент, ")", "");
	
	Если Найти(Фрагмент, "7") = 1 ИЛИ Найти(Фрагмент, "8") = 1 Тогда
		Фрагмент = Прав(Фрагмент, СтрДлина(Фрагмент) - 1);
	КонецЕсли;
	
	Возврат Фрагмент;
	
КонецФункции //  

#КонецОбласти  // ПроверкаЗаполненияСтруктуры


#Область ЗаписьТрафика

Процедура ЗаписатьНовыйТрафик(Параметры)
	
	//--- инициализация переменных ---

	НомерТестДрайва = "";
	МенеджерЗамены = Неопределено;
	
	ЕстьТД = ЗначениеЗаполнено(НомерТестДрайва);
	ТрафикУпущен = СтрДлина(Параметры.Упущен_ТекстПричины) > 0 ИЛИ Параметры.Упущен_Причина <> Справочники.CRM_ПричиныУпущенныхКлиентов.ПустаяСсылка();
	ЕстьЗамечаниеМенеджеру = (СтрДлина(Параметры.ЗамечаниеМенеджеру) > 0);
	МенеджерЗаменен = ЗначениеЗаполнено(МенеджерЗамены);
	//ВОтделПродаж = (Отдел = ОтделАвтосалона);
	ВОтделПродаж = (Параметры.ВОтделПродаж);
	
	//СоздаемРЛ = Не ТрафикУпущен И не ЗаписьНаСервис;
	
	ДилерскийЦентр = Параметры.ДилерскийЦентр;
	Клиент = Параметры.Клиент;
	

	
	//--------------------------------------------------
	//--- фиксация трафика ---
	
	Если Параметры.ЗаписьНаСервис = Ложь Тогда
		
		Идентификатор = "";
		Если ЗначениеЗаполнено(Клиент) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Renault_РабочиеЛисты.IDK,
			|	Renault_РабочиеЛисты.IDТрафика,
			|	Renault_РабочиеЛисты.Сотрудник
			|ИЗ
			|	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
			|ГДЕ
			|	Renault_РабочиеЛисты.Клиент = &Клиент
			|	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ";
			Запрос.УстановитьПараметр("Клиент", Клиент);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Идентификатор = Выборка.IDТрафика;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		
		ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
		
		ЗаписьТрафик.Период = ТекущаяДата();
		Идентификатор = Новый УникальныйИдентификатор();
		ЗаписьТрафик.ТипТрафика = Параметры.ТипТрафика;
		ЗаписьТрафик.Идентификатор = Идентификатор;
		ЗаписьТрафик.Менеджер = Параметры.Менеджер;
		ЗаписьТрафик.Администратор = Параметры.Администратор;
		ЗаписьТрафик.Отдел = Параметры.Отдел;
		ЗаписьТрафик.Клиент = Клиент;
		ЗаписьТрафик.ДилерскийЦентр = ДилерскийЦентр;
		ЗаписьТрафик.ПервичныйИнтерес = Параметры.Модель;
		ЗаписьТрафик.ИсточникИнформации = Параметры.ИсточникИнформации;
		ЗаписьТрафик.ПервичныйПовторный = Параметры.ПервичныйПовторный;
		ЗаписьТрафик.Представление = Параметры.ФИО;
		//ЗаписьТрафик.Обработан = ТрафикУпущен ИЛИ ЕстьТД;
		ЗаписьТрафик.Обработан = ТрафикУпущен;
		ЗаписьТрафик.Комментарий = Параметры.Комментарий;
		
		ЗаписьТрафик.Записать();
		
	КонецЕсли;
	
	//Создадим типизированные колонки в ТЗ
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	CRM_ЗначенияРеквизитовТрафика.РеквизитТрафика КАК РеквизитТрафика,
	                      |	CRM_ЗначенияРеквизитовТрафика.ЗначениеРеквизита КАК ЗначениеРеквизита,
	                      |	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика
	                      |ИЗ
	                      |	РегистрСведений.CRM_ЗначенияРеквизитовТрафика КАК CRM_ЗначенияРеквизитовТрафика
	                      |ГДЕ
	                      |	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика ЕСТЬ NULL ");
	РеквизитыТрафика = Запрос.Выполнить().Выгрузить();
	//Удалим "лишние записи" на всякий случай
	РеквизитыТрафика.Очистить();
	
	//Заполним реквизиты трафика
	
	//Пол
	НовоеСвойство = РеквизитыТрафика.Добавить();
	НовоеСвойство.ИдентификаторТрафика = Идентификатор;
	НовоеСвойство.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Пол;
	НовоеСвойство.ЗначениеРеквизита = Параметры.Пол;
	
	Если Параметры.ТипТрафика = Справочники.CRM_ТипТрафика.EmailДилера Тогда
		//email
		//НовоеСвойство = РеквизитыТрафика.Добавить();
		//НовоеСвойство.ИдентификаторТрафика = Идентификатор;
		//НовоеСвойство.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Email;
		//НовоеСвойство.ЗначениеРеквизита = Телефон;
	Иначе
		// телефон
		НовоеСвойство = РеквизитыТрафика.Добавить();
		НовоеСвойство.ИдентификаторТрафика = Идентификатор;
		НовоеСвойство.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Телефон;
		НовоеСвойство.ЗначениеРеквизита = Параметры.Телефон;
	КонецЕсли;
	
	//Запись в регистр
	НЗ = РегистрыСведений.CRM_ЗначенияРеквизитовТрафика.СоздатьНаборЗаписей();
	НЗ.Отбор.ИдентификаторТрафика.Установить(Идентификатор);
	НЗ.Прочитать();
	НЗ.Загрузить(РеквизитыТрафика);
	Нз.Записать();
	
	
	//--------------------------------------------------
	//--- Фиксация упущенного трафика ---

	Если ТрафикУпущен Тогда
		Запись = РегистрыСведений.CRM_УпущенныйТрафик.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.Менеджер = Параметры.Менеджер;
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		Запись.Комментарий = СокрЛП(Параметры.Упущен_ТекстПричины);
		Запись.Причина = Параметры.Упущен_Причина;
		Запись.АвторКомментария = Параметры.Администратор;
		Запись.ВидУпущения = Перечисления.CRM_ТипыУпущенияТрафика.Менеджер;
		Запись.Записать();
	КонецЕсли;
	
	
	//--------------------------------------------------
	//--- Фиксация замечания менеджеру ---
	
	Если ЕстьЗамечаниеМенеджеру Тогда
		Запись = РегистрыСведений.CRM_ЗамечанияМенеджерам.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.Менеджер = Параметры.Менеджер;
		Запись.ТекстЗамечания = СокрЛП(Параметры.ЗамечаниеМенеджеру);
		Запись.Записать();
	КонецЕсли;
	
	
	//--------------------------------------------------
	//--- Фиксация задачи по трафику ---
	
	Если Параметры.Перезвонить Тогда
		Запись = РегистрыСведений.CRM_ЗадачиПоТрафику.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.ИдентификаторЗадачи = Новый УникальныйИдентификатор;
		Запись.ТипЗадачи = Перечисления.CRM_ТипыЗадачПоТрафику.ПерезвонПоПросьбеКлиента;
		Запись.Менеджер = Параметры.Менеджер;
		Запись.Автор = Параметры.Администратор;
		Запись.Комментарий = СокрЛП(Параметры.Комментарий);
		Запись.Телефон = Параметры.Телефон;
		Запись.Представление = Параметры.ФИО;
		Запись.Обработано = Ложь;
		Запись.Записать();
	КонецЕсли;
	
	
	//--------------------------------------------------
	//--- Фиксация замены менеджера ---
	
	Если МенеджерЗаменен Тогда
		Запись = РегистрыСведений.CRM_ЗаменыМенеджеров.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.МенеджерЗаменил = Параметры.Менеджер;
		Запись.МенеджерЗаменен = МенеджерЗамены;
		Запись.Записать();
	КонецЕсли;
	
	
	//--------------------------------------------------
	//--- Создание рабочего листа и ТД ---
	
	Если ЕстьТД Тогда
		
		ЗаписьРЛ = Renault_CRM.СоздатьРабочийЛистПоТрафику(ЗаписьТрафик.Идентификатор);
		Если ЗаписьРЛ <> Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CRM_ЗаписьНаТестДрайв.Ссылка
			               |ИЗ
			               |	Документ.CRM_ЗаписьНаТестДрайв КАК CRM_ЗаписьНаТестДрайв
			               |ГДЕ
			               |	CRM_ЗаписьНаТестДрайв.РабочийЛист = &РабочийЛист
			               |	И CRM_ЗаписьНаТестДрайв.Проведен = ИСТИНА";
			Запрос.УстановитьПараметр("РабочийЛист", НомерТестДрайва);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Об = Выборка.Ссылка.ПолучитьОбъект();
				Об.РабочийЛист = ЗаписьРЛ.IDK;
				Об.Клиент = ЗаписьРЛ.Клиент;
				Об.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	//--------------------------------------------------
	//--- Создание обращения в автосервис ---
	
	Если Параметры.ЗаписьНаСервис и Не ТрафикУпущен Тогда
		
		Документ = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
		
		Документ.Дата = ТекущаяДата();
		Документ.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.СРешепшен;
		Документ.ДилерскийЦентр = ДилерскийЦентр;
		
		//от Вити
		//Документ.Менеджер = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Сотрудник);
		Документ.Менеджер = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Параметры.Администратор);
		//the-end
		
		Если ТипЗнч(Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") ИЛИ
			ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			Документ.Клиент = Клиент;
		Иначе
			Документ.Клиент = Параметры.ФИО;
		КонецЕсли;
		
		Документ.Примечание = Параметры.Комментарий + " Модель: " + Параметры.Модель.Наименование;
		Документ.ПервичныйПовторный = Параметры.ПервичныйПовторный;
		Документ.ОбращениеОбработано = Ложь;
		
		Попытка
			Документ.ИдентификаторТрафика = Идентификатор;
		Исключение
		Конецпопытки;
			
		Документ.Жалоба = Параметры.Жалоба;
		
		Попытка
			Документ.ТелефонПримечание = Параметры.Телефон;
		Исключение
			Документ.Примечание = Документ.Примечание + " Телефон клиента: " + Параметры.Телефон;
		КонецПопытки;
		
		Документ.Записать();
		
		
		Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
		
		Напоминание.Отправитель = Параметры.Администратор;
		Напоминание.Подробнее = Документ.Ссылка;
		Напоминание.Адресаты.Добавить().Сотрудник = Параметры.Менеджер;
		ДатаОтправки = ТекущаяДата();
		Напоминание.ДатаОтправки = ДатаОтправки;
		Напоминание.Комментарий = Параметры.Комментарий;
		Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера;
		Напоминание.ПоказыватьС = ДатаОтправки;
		Напоминание.ПоказыватьПо = ДатаОтправки;
		Напоминание.Наименование = Параметры.ФИО;
		Напоминание.Сообщение = "На вас назначен клиент: " + Параметры.ФИО + " | " + Параметры.Комментарий + " | " + Параметры.Модель.Наименование;;
		
		Напоминание.Записать();
		
	КонецЕсли;
	
	//Если ЗаписьНаСервис и Жалоба Тогда
	//	
	//	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	//	Напоминание.Отправитель = Администратор;
	//	
