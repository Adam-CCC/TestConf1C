//Для auto.ru
Функция rootGetAutoList3(Запрос)
	СЗ_КодПодразделения = Запрос.ПараметрыURL["UnitCode"];
	Если СЗ_КодПодразделения=Неопределено Тогда
		Возврат "ОШИБКА! Список кодов подразделений не заполнен.";
	КонецЕсли; 
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "text/xml; charset=utf-8");
	Ответ.Заголовки.Вставить("Connection", "Keep-Alive");
	Ответ.УстановитьТелоИзСтроки(СМ_ВыгрузкаОбъявленийОПродажеАвто.ВернутьXMLкакСтроку3(СЗ_КодПодразделения));
	Возврат Ответ;
КонецФункции

//Получение ссылки на фото
Функция rootGetImage(Запрос)
	
	Vin = Запрос.ПараметрыURL["VIN"];
 	Если Vin=Неопределено Тогда
		Ответ = Новый HTTPСервисОтвет(400,"ОШИБКА! Не заполнен VIN.");
		Возврат Ответ;
 	КонецЕсли; 
 	ImageNumber = Запрос.ПараметрыURL["ImageNumber"];
	ImageNumber = Сред(ImageNumber,1,СтрДлина(ImageNumber)-4);
	Если ImageNumber=Неопределено Тогда
		Ответ = Новый HTTPСервисОтвет(400,"ОШИБКА! Не заполнен ImageNumber.");
		Возврат Ответ;
 	КонецЕсли; 
	
	Картинка = СМ_ВыгрузкаОбъявленийОПродажеАвто.ПолучитьФотоАвтомобиля(Vin,ImageNumber);
	
	Если Картинка="" Тогда
		Ответ = Новый HTTPСервисОтвет(204,"ОШИБКА! Фотографии не существует.");
		Возврат Ответ;
 	КонецЕсли; 
	
 	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "image/jpeg");
 	Ответ.УстановитьТелоИзДвоичныхДанных(Картинка);
	Возврат Ответ;
	
 КонецФункции

