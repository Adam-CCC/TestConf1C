	|	КОНЕЦ КАК Исполнитель,
	|	ВЫБОР
	|		КОГДА Приемки.Статус = &Завершена
	|				И НЕ Выдачи.Дата ЕСТЬ NULL
	|			ТОГДА Выдачи.Статус
	|		ИНАЧЕ Приемки.Статус
	|	КОНЕЦ КАК Статус,
	|	ВЫБОР
	|		КОГДА Приемки.Статус = &Завершена
	|				И НЕ Выдачи.Дата ЕСТЬ NULL
	|			ТОГДА Выдачи.Номер
	|		ИНАЧЕ Приемки.Номер
	|	КОНЕЦ КАК Номер,
	|	ВЫБОР
	|		КОГДА Приемки.Статус = &Завершена
	|				И НЕ Выдачи.Дата ЕСТЬ NULL
	|			ТОГДА Выдачи.Операция
	|		ИНАЧЕ Приемки.Операция
	|	КОНЕЦ КАК Операция,
	|	ВЫБОР
	|		КОГДА Приемки.Статус = &Завершена
	|				И НЕ Выдачи.Дата ЕСТЬ NULL
	|			ТОГДА Выдачи.ДокументСсылка
	|		ИНАЧЕ Приемки.ДокументСсылка
	|	КОНЕЦ КАК ДокументСсылка,
	|	ВЫБОР
	|		КОГДА Приемки.Статус = &Завершена
	|				И НЕ Выдачи.Дата ЕСТЬ NULL
	|			ТОГДА Выдачи.КлиентСсылка
	|		ИНАЧЕ Приемки.КлиентСсылка
	|	КОНЕЦ КАК КлиентСсылка,
	|	ВЫБОР
	|		КОГДА Приемки.Статус = &Завершена
	|				И НЕ Выдачи.Дата ЕСТЬ NULL
	|			ТОГДА Выдачи.АвтоСсылка
	|		ИНАЧЕ Приемки.АвтоСсылка
	|	КОНЕЦ КАК АвтоСсылка,
	|	ВЫБОР
	|		КОГДА Приемки.Статус = &Завершена
	|				И НЕ Выдачи.Дата ЕСТЬ NULL
	|			ТОГДА Выдачи.СтрокаВывода
	|		ИНАЧЕ Приемки.СтрокаВывода
	|	КОНЕЦ КАК СтрокаВывода
	|ИЗ
	|	Приемки КАК Приемки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Выдачи КАК Выдачи
	|		ПО (Выдачи.Обращение = Приемки.Обращение)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА Выдачи.ДокументСсылка ЕСТЬ NULL
	|				ТОГДА Приемки.Отображать
	|			ИНАЧЕ Выдачи.Отображать
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Исполнитель,
	|	Дата
	|ИТОГИ ПО
	|	Исполнитель
	|АВТОУПОРЯДОЧИВАНИЕ";
	ТекВремя = ТекущаяДата();
	
	Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	Запрос.УстановитьПараметр("Завершена", Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен);
	Запрос.УстановитьПараметр("ВремяНачалаС", ТекВремя - ДилерскийЦентр.Автосервис_ПериодОтображенияЗаписиМониторС*3600);
	Запрос.УстановитьПараметр("ВремяНачалаПО", ТекВремя + ДилерскийЦентр.Автосервис_ПериодОтображенияЗаписиМониторПО*3600);
	Запрос.УстановитьПараметр("СокращенныйВводФИО", ДилерскийЦентр.Автосервис_МониторВыводитьЧастичноеФИО);
	Ответ = Запрос.Выполнить();
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьФото(СотрудникСсылка)
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	КартинкиИФайлы.Идентификатор,
	|	КартинкиИФайлы.ИмяФайла,
	|	КартинкиИФайлы.Данные,
	|	КартинкиИФайлы.ДанныеВоВнешнемФайле
	|ИЗ
	|	РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы
	|ГДЕ
	|	КартинкиИФайлы.Объект = &ОбъектИнформации
	|	И КартинкиИФайлы.Картинка = ИСТИНА
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	Попытка
		Запрос.УстановитьПараметр("ОбъектИнформации",СотрудникСсылка);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		Если РезультатЗапроса.Количество()>0 Тогда
			СтрокаКартинка = РезультатЗапроса[0];
			Если СтрокаКартинка.ДанныеВоВнешнемФайле Тогда
				Возврат Новый Картинка(СтрокаКартинка.ИмяФайла,Ложь);
			Иначе
				Данные = СтрокаКартинка.Данные.Получить();
				Если ТипЗнч(Данные) = Тип("Картинка") Тогда
					Возврат Данные;
				Иначе
					Картинка = Новый Картинка(Данные);
					Возврат Картинка;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Возврат Новый Картинка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецФункции

Функция ПодготовитьСтроку(Строка) 
	
	Если обЗначениеНеЗаполнено(Строка) Тогда
		Возврат "&nbsp";
	Иначе
		Возврат Строка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТекстСтатуса(Документ, ОбщиеНастройки)
	
	ТекущееСостояние = Документ.Ссылка.Состояние;
	Отбор = Новый Структура;
	Отбор.Вставить("СостояниеДокумента", ТекущееСостояние);
	Если Документ.Метаданные().Имя = "Renault_CRM_ПриемкаАвтомобиля" Тогда
		Отбор.Вставить("Документ", "Приемка");
	ИначеЕсли Документ.Метаданные().Имя = "Renault_CRM_ВыдачаАвтомобиля" Тогда
		Отбор.Вставить("Документ", "Выдача");
	КонецЕсли;
	МассивСтрок = ОбщиеНастройки.СтатусыВМониторЗаписи.НайтиСтроки(Отбор);
	
	СтрокаСтатуса = " ";
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаСтатуса = МассивСтрок[0].СтрокаСтатуса;
	КонецЕсли;
		
	Возврат СтрокаСтатуса;
	
КонецФункции

Функция ПредставлениеКлиента(КлиентСсылка)
	
	Если КлиентСсылка.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
		Ответ = КлиентСсылка.Наименование;
	Иначе
		Ответ = "" + КлиентСсылка.Фамилия + " " + Лев(СокрЛП(КлиентСсылка.Имя), 1) + "." + Лев(СокрЛП(КлиентСсылка.Отчество), 1) + ".";
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции
