
Функция html(Запрос)
	
	htm = Обработки.Renault_МониторАвтосервиса.ПолучитьМакет("htm").ПолучитьТекст();
	
	htm = СтрЗаменить(htm, "%IDСессии%", Строка(Новый УникальныйИдентификатор));
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "text/html; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(htm);
	
	Возврат Ответ;
	
КонецФункции

Функция getData(Запрос)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
	Структура = ПрочитатьJSON(ЧтениеJSON);
	IDСессии = Новый УникальныйИдентификатор(Структура.sessionID);
	
	ОбщиеНастройки = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза;
	Монитор_Заголовок = ОбщиеНастройки.Автосервис_ШаблонМонитора_Заголовок;
	//DMSREN-611
	Монитор_ДилерскийЦентр = Неопределено;
	Для Каждого Элемент из Запрос.ПараметрыЗапроса Цикл
		Если Элемент.Ключ = "DMD" Тогда 
			Монитор_ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.НайтиПоРеквизиту("DMD",Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Монитор_ДилерскийЦентр = Неопределено или Монитор_ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка() Тогда
		Монитор_ДилерскийЦентр = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	КонецЕсли;
	//DMSREN-611

	Монитор_ИнтервалСменыСтраниц = ?(ЗначениеЗаполнено(Монитор_ДилерскийЦентр.Автосервис_ИнтервалСменыСтраницМонитора), Монитор_ДилерскийЦентр.Автосервис_ИнтервалСменыСтраницМонитора, 7);
	Монитор_ЦветоваяСхема = ?(ЗначениеЗаполнено(Монитор_ДилерскийЦентр.Автосервис_ЦветоваяСхемаМонитора), Монитор_ДилерскийЦентр.Автосервис_ЦветоваяСхемаМонитора, "255,186,0");
	

	Если Монитор_ДилерскийЦентр.Пустая() Тогда Возврат ОшибкаСервера("Не выполнены настройки планшета") КонецЕсли;
	
	data = Новый Массив;
	
	Результат = ПолучитьТаблицуКВыводу(Монитор_ДилерскийЦентр);
	
	ВыборкаМастер = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Исполнитель");
	
	Пока ВыборкаМастер.Следующий() Цикл
		
		tab = Новый Массив;
		Выборка = ВыборкаМастер.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.ГосНомер) Тогда
				Автомобиль = Новый Структура("number", Выборка.ГосНомер);
			Иначе
				Автомобиль = Строка(Выборка.АвтоСсылка);
			КонецЕсли;	
			
			tab.Добавить(
				Новый Структура("time, auto, client, status",
					Формат(Выборка.Дата,"ДФ=ЧЧ:мм"),
					Автомобиль,
					Выборка.СтрокаВывода,//ПредставлениеКлиента(Выборка.КлиентСсылка),
					ПодготовитьСтроку(ПолучитьТекстСтатуса(Выборка.ДокументСсылка, ОбщиеНастройки))
				));
				
		КонецЦикла;	
		
		ФотоМастер = ПолучитьФото(ВыборкаМастер.Исполнитель);
		КартинкаМастер = Base64Строка(?(ЗначениеЗаполнено(ФотоМастер), ФотоМастер.ПолучитьДвоичныеДанные(), Обработки.Renault_МониторАвтосервиса.ПолучитьМакет("noPhoto")));
		data.Добавить(Новый Структура("user, img, tab", Строка(ВыборкаМастер.Исполнитель), КартинкаМастер, tab));
		
	КонецЦикла;	
	
	Попытка
		Logo = Монитор_ДилерскийЦентр.ЛоготипДЦ.Получить();
	Исключение
		Logo = Неопределено;
	КонецПопытки;
	
	Логотип = Base64Строка(?(ЗначениеЗаполнено(Logo), Logo.ПолучитьДвоичныеДанные(), Обработки.Renault_МониторАвтосервиса.ПолучитьМакет("defLogo")));
	baseColor = "rgb(" + Монитор_ЦветоваяСхема + ")";
	
	Попытка
		Возврат ОтветСервера(ObjToJSON(Новый Структура("caption, baseColor, logo, timeout, data", Монитор_Заголовок, baseColor, Логотип, Монитор_ИнтервалСменыСтраниц, data)));
	Исключение
		Возврат ОшибкаСервера(ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

Функция ObjToJSON(Объект) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Объект);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции	

Функция ОшибкаСервера(Сообщение = "Апышка!", Встроенная = Истина)
	
	html="<html><head><style>
	|div{
	|    height: 10em;
	|    position: relative 
	|    margin: 0;
	|    background: yellow;
	|    position: absolute;
	|    top: 30%;
	|    left: 50%;
	|    margin-right: -50%;
	|    transform: translate(-50%, -50%)
	|}
	|</style></head><body><div><img alt='' src='data:image/gif;base64," +
	Base64Строка(Обработки.Renault_МониторАвтосервиса.ПолучитьМакет("fail"))
	+ "'><br>" + Сообщение;
	
	Если Встроенная Тогда 
		Ответ=Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("{err:true,html:'" + html + "',description:'" + html + "'}");
	Иначе
		Ответ=Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Content-Type", "text/html; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(html);
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции	

Функция ОтветСервера(JSON)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(JSON);
	
	Возврат Ответ;
	
КонецФункции	

Функция ПолучитьТаблицуКВыводу(ДилерскийЦентр)Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ПриемкаАвтомобиля.ВремяНачала КАК Дата,
	|	Renault_CRM_ПриемкаАвтомобиля.Клиент КАК Клиент,
	|	Renault_CRM_ПриемкаАвтомобиля.ГосНомер КАК ГосНомер,
	|	Renault_CRM_ПриемкаАвтомобиля.Машиноместо КАК Исполнитель,
	|	Renault_CRM_ПриемкаАвтомобиля.Состояние КАК Статус,
	|	Renault_CRM_ПриемкаАвтомобиля.Номер КАК Номер,
	|	""Приемка"" КАК Операция,
	|	Renault_CRM_ПриемкаАвтомобиля.Ссылка КАК ДокументСсылка,
	|	Renault_CRM_ПриемкаАвтомобиля.Клиент.Ссылка КАК КлиентСсылка,
	|	Renault_CRM_ПриемкаАвтомобиля.Автомобиль.Ссылка КАК АвтоСсылка,
	|	Renault_CRM_ПриемкаАвтомобиля.Обращение КАК Обращение,
	|	ВЫБОР
	|		КОГДА &СокращенныйВводФИО
	|			ТОГДА ВЫБОР
	|					КОГДА Renault_CRM_ПриемкаАвтомобиля.Клиент.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)
	|						ТОГДА Renault_CRM_ПриемкаАвтомобиля.Клиент.Имя + "" "" + Renault_CRM_ПриемкаАвтомобиля.Клиент.Отчество + "" "" + ПОДСТРОКА(Renault_CRM_ПриемкаАвтомобиля.Клиент.Фамилия, 0, 1) + "".""
	|					ИНАЧЕ Renault_CRM_ПриемкаАвтомобиля.Клиент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ Renault_CRM_ПриемкаАвтомобиля.Клиент.Наименование
	|	КОНЕЦ КАК СтрокаВывода,
	|	ВЫБОР
	|		КОГДА Renault_ОбщиеНастройкиБазыДанныхСтатусыВМониторЗаписи.Ссылка = ЗНАЧЕНИЕ(Справочник.Renault_ОбщиеНастройкиБазыДанных.Этабаза)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Отображать
	|ПОМЕСТИТЬ Приемки
	|ИЗ
	|	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ОбщиеНастройкиБазыДанных.СтатусыВМониторЗаписи КАК Renault_ОбщиеНастройкиБазыДанныхСтатусыВМониторЗаписи
	|		ПО Renault_CRM_ПриемкаАвтомобиля.Состояние = Renault_ОбщиеНастройкиБазыДанныхСтатусыВМониторЗаписи.СостояниеДокумента
	|			И (Renault_ОбщиеНастройкиБазыДанныхСтатусыВМониторЗаписи.Документ = ""Приемка"")
	|			И (Renault_ОбщиеНастройкиБазыДанныхСтатусыВМониторЗаписи.Ссылка = ЗНАЧЕНИЕ(Справочник.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза))
	|ГДЕ
	|	Renault_CRM_ПриемкаАвтомобиля.ВремяНачала МЕЖДУ &ВремяНачалаС И &ВремяНачалаПО
	|	И Renault_CRM_ПриемкаАвтомобиля.ДилерскийЦентр = &ДилерскийЦентр
	|
	|СГРУППИРОВАТЬ ПО
	|	Renault_CRM_ПриемкаАвтомобиля.Машиноместо,
	|	Renault_CRM_ПриемкаАвтомобиля.ВремяНачала,
	|	Renault_CRM_ПриемкаАвтомобиля.Клиент,
	|	Renault_CRM_ПриемкаАвтомобиля.ГосНомер,
	|	Renault_CRM_ПриемкаАвтомобиля.Состояние.Наименование,
	|	Renault_CRM_ПриемкаАвтомобиля.Номер,
	|	Renault_CRM_ПриемкаАвтомобиля.Ссылка,
	|	Renault_CRM_ПриемкаАвтомобиля.Клиент.Ссылка,
	|	Renault_CRM_ПриемкаАвтомобиля.Автомобиль.Ссылка,
	|	Renault_CRM_ПриемкаАвтомобиля.Состояние,
	|	Renault_CRM_ПриемкаАвтомобиля.Обращение,
	|	ВЫБОР
	|		КОГДА &СокращенныйВводФИО
	|			ТОГДА ВЫБОР
	|					КОГДА Renault_CRM_ПриемкаАвтомобиля.Клиент.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)
	|						ТОГДА Renault_CRM_ПриемкаАвтомобиля.Клиент.Имя + "" "" + Renault_CRM_ПриемкаАвтомобиля.Клиент.Отчество + "" "" + ПОДСТРОКА(Renault_CRM_ПриемкаАвтомобиля.Клиент.Фамилия, 0, 1) + "".""
	|					ИНАЧЕ Renault_CRM_ПриемкаАвтомобиля.Клиент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ Renault_CRM_ПриемкаАвтомобиля.Клиент.Наименование
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Renault_ОбщиеНастройкиБазыДанныхСтатусыВМониторЗаписи.Ссылка = ЗНАЧЕНИЕ(Справочник.Renault_ОбщиеНастройкиБазыДанных.Этабаза)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_CRM_ВыдачаАвтомобиля.ВремяНачала КАК Дата,
	|	Renault_CRM_ВыдачаАвтомобиля.Клиент КАК Клиент,
	|	Renault_CRM_ВыдачаАвтомобиля.ГосНомер КАК ГосНомер,
	|	Renault_CRM_ВыдачаАвтомобиля.Машиноместо КАК Исполнитель,
	|	Renault_CRM_ВыдачаАвтомобиля.Состояние.Наименование КАК Статус,
	|	Renault_CRM_ВыдачаАвтомобиля.Номер КАК Номер,
	|	""Выдача"" КАК Операция,
	|	Renault_CRM_ВыдачаАвтомобиля.Ссылка КАК ДокументСсылка,
	|	Renault_CRM_ВыдачаАвтомобиля.Клиент.Ссылка КАК КлиентСсылка,
	|	Renault_CRM_ВыдачаАвтомобиля.Автомобиль.Ссылка КАК АвтоСсылка,
	|	Renault_CRM_ВыдачаАвтомобиля.Обращение КАК Обращение,
	|	ВЫБОР
	|		КОГДА &СокращенныйВводФИО
	|			ТОГДА ВЫБОР
	|					КОГДА Renault_CRM_ВыдачаАвтомобиля.Клиент.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)
	|						ТОГДА Renault_CRM_ВыдачаАвтомобиля.Клиент.Имя + "" "" + Renault_CRM_ВыдачаАвтомобиля.Клиент.Отчество + "" "" + ПОДСТРОКА(Renault_CRM_ВыдачаАвтомобиля.Клиент.Фамилия, 0, 1) + "".""
	|					ИНАЧЕ Renault_CRM_ВыдачаАвтомобиля.Клиент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ Renault_CRM_ВыдачаАвтомобиля.Клиент.Наименование
	|	КОНЕЦ КАК СтрокаВывода,
	|	ВЫБОР
	|		КОГДА Renault_ОбщиеНастройкиБазыДанныхСтатусыВМониторЗаписи.Ссылка = ЗНАЧЕНИЕ(Справочник.Renault_ОбщиеНастройкиБазыДанных.Этабаза)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Отображать
