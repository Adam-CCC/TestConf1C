&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	Найденные = ВариантыОтчета.НайтиСтроки(Новый Структура("Наименование", Наименование));
	Если Найденные.Количество() > 0 Тогда
		Элементы.ВариантыОтчета.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
		ВариантыОтчетаОбработчикАктивизацииСтроки(ЭтаФорма);
	Иначе
		ВариантОтчета             = ПредопределенноеЗначение("Справочник.ВариантыОтчетов.ПустаяСсылка");
		ПользовательскаяНастройка = 1;
		ПользовательскаяНастройкаПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

