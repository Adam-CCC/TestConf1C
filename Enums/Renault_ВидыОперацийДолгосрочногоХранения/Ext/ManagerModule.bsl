КонецФункции

Функция ПолучитьВидыОпераций(ТипАвтомобиля="", VIN="") Экспорт
	
	Если ПустаяСтрока(ТипАвтомобиля) Тогда
		ТипАвтомобиля = ?(ЭтоЭлектромобиль(VIN),"Электромобиль","ДВС");
	КонецЕсли;
	
	Вз = Новый Массив;
	Вз.Добавить(ДавлениеВШинах);
	//Вз.Добавить(МойкаКузова);
	//Вз.Добавить(Двигатель);
	
	Если ТипАвтомобиля = "Электромобиль" Тогда
		Вз.Добавить(ТяговаяБатарея);
	Иначе	
		//Вз.Добавить(Топливо);
		Вз.Добавить(АккумуляторнаяБатарея);
	КонецЕсли;
	
	Вз.Добавить(СистемаВентиляции);

	Возврат Вз;
	
КонецФункции

Функция ЭтоЭлектромобиль(Знач VIN) Экспорт

	VIN = НРег(СокрЛП(VIN));
	
	Если Лев(VIN,8)=НРег("VF1ACVYB") ИЛИ Лев(VIN,7)=НРег("VF1FW0Z") Тогда Возврат Истина; КонецЕсли;
	
	Возврат Ложь;	

КонецФункции

Функция МесяцыПроверок(ВидОперации, Подробности="") Экспорт

	Мс = Новый Массив;
	
	Если ВидОперации = ДавлениеВШинах Тогда
		Мс.Добавить(6); Мс.Добавить(12);
	//ИначеЕсли ВидОперации = АккумуляторнаяБатарея И Подробности = "Заряжать в течении 6 часов (ATEQ)" Тогда	
	ИначеЕсли ВидОперации = АккумуляторнаяБатарея И Подробности = "Заряжать ATEQ до полной зарядки (зеленый индикатор горит постоянно, не мигает)" Тогда		
		Мс.Добавить(3); Мс.Добавить(6); Мс.Добавить(9);
	//ИначеЕсли ВидОперации = АккумуляторнаяБатарея И Подробности = "Проверка о необходимости замены АКБ" Тогда	
	//	Мс.Добавить(12);	
	//ИначеЕсли ВидОперации = Топливо Тогда
	//	Мс.Добавить(3);
	//ИначеЕсли ВидОперации = МойкаКузова ИЛИ	ВидОперации = ТяговаяБатарея ИЛИ ВидОперации = СистемаВентиляции ИЛИ ВидОперации = Двигатель Тогда
	ИначеЕсли ВидОперации = ТяговаяБатарея ИЛИ ВидОперации = СистемаВентиляции Тогда
		Мс.Добавить(3); Мс.Добавить(6); Мс.Добавить(9); Мс.Добавить(12);
	КонецЕсли;	
	
	Возврат Мс;

КонецФункции
