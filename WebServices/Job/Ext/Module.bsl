			JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"1",ТаблицаОщибок,"Пакет успешно удален.");
			Возврат JobChange;
			
		Иначе
			Если МассивПакетаРабот.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC09";
				НоваяСтрока.ТекстОшибки = "Пакет не содержит работ";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;	
		
			ЗапросНомерПакета = Новый Запрос();
			ЗапросНомерПакета.УстановитьПараметр("ЗаказНарядСсылка", ЗаказНарядСсылка);
			ЗапросНомерПакета.УстановитьПараметр("ПакетРаботID", ПакетРаботID);
			ЗапросНомерПакета.Текст = "ВЫБРАТЬ
			                          |	ЗаказНарядРаботы.НомерПакета КАК НомерПакета
			                          |ИЗ
			                          |	Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
			                          |ГДЕ
			                          |	ЗаказНарядРаботы.Ссылка = &ЗаказНарядСсылка
			                          |	И ЗаказНарядРаботы.ПакетРабот = &ПакетРаботID";
			
			ВыборкаНомерПакета = ЗапросНомерПакета.Выполнить().Выбрать();
			НомерПакета = 1;
			Если ВыборкаНомерПакета.Следующий() Тогда
				НомерПакета = ВыборкаНомерПакета.НомерПакета;
			Иначе				
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC02";
				НоваяСтрока.ТекстОшибки = "Пакет работ с указанным идентификатором не найден";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;
			
			Для Каждого КодРаботыПакета Из МассивПакетаРабот Цикл
				РаботаССылка = Справочники.Автоработы.НайтиПоКоду(КодРаботыПакета);
				Если РаботаСсылка.Пустая() Тогда
					НоваяСтрока = ТаблицаОщибок.Добавить();
					НоваяСтрока.Код = "JC09";
					НоваяСтрока.ТекстОшибки = "Работа с указанным кодом не найдена";
					JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
					Возврат JobChange;  
				КонецЕсли;
				СтрокаРабота = ЗаказНарядОбъект.Работы.Найти(РаботаСсылка, "Работа");
				Если СтрокаРабота <> Неопределено Тогда
					СтрокаРабота.НомерПакета = НомерПакета;
					СтрокаРабота.ПакетРабот = ПакетРаботID;
				КонецЕсли;			
			КонецЦикла;		
		КонецЕсли;
		ЗаказНарядОбъект.ОбменДанными.Загрузка = Истина;
		ЗаказНарядОбъект.Записать();
		
	ИначеЕсли ЗначениеЗаполнено(Действие) И ЗначениеЗаполнено(ПакетРаботID) Тогда // отметки времени по пакету работ
		
		Если Действие = "1" Тогда // начать работу					
			Исполнитель = Справочники.Сотрудники.НайтиПоКоду(КодСотрудника);
			Если Исполнитель = Справочники.Сотрудники.ПустаяСсылка() ИЛИ Исполнитель=Неопределено Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC12";
				НоваяСтрока.ТекстОшибки = "Сотрудник с указанным кодом не найден";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange; 
			Иначе
				Цех = Исполнитель.Цех;
			КонецЕсли;
			
			Если МассивПакетаРабот.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC09";
				НоваяСтрока.ТекстОшибки = "Пакет не содержит работ";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;	
			
			Если ЗакрытьСтарыйИнтервал(Исполнитель, ЗаказНарядСсылка, ПакетРаботID) Тогда
				НачатьНовыйИнтервал(Справочники.ВидыОтметокВремени.Работа, Исполнитель, ЗаказНарядСсылка, ПакетРаботID);
			Иначе
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest", JobChangeRequest, JobChange, "0", ТаблицаОщибок);
				Возврат JobChange;				
			КонецЕсли;
			
		ИначеЕсли Действие = "2" Тогда // закрыть пакет работ
			Исполнитель = Справочники.Сотрудники.НайтиПоКоду(КодСотрудника);
			Если Исполнитель = Справочники.Сотрудники.ПустаяСсылка() ИЛИ Исполнитель=Неопределено Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC12";
				НоваяСтрока.ТекстОшибки = "Сотрудник с указанным кодом не найден";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;
		
			Если МассивПакетаРабот.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC09";
				НоваяСтрока.ТекстОшибки = "Пакет не содержит работ";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;		
			
			Если ЗакрытьСтарыйИнтервал(Исполнитель, ЗаказНарядСсылка, ПакетРаботID) Тогда
				НачатьНовыйИнтервал(Справочники.ВидыОтметокВремени.Простой, Исполнитель, ЗаказНарядСсылка, ПакетРаботID);
			Иначе
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest", JobChangeRequest, JobChange, "0", ТаблицаОщибок);
				Возврат JobChange;				
			КонецЕсли;		
			ЗаказНарядОбъект = ЗаказНарядСсылка.ПолучитьОбъект();
			Для Каждого СтрокаРабота Из ЗаказНарядОбъект.Работы Цикл
				Если СтрокаРабота.ПакетРабот = ПакетРаботID Тогда
					СтрокаРабота.ПакетЗакрыт = Истина;  
				КонецЕсли;
			КонецЦикла;		
			ЗаказНарядОбъект.ОбменДанными.Загрузка = Истина;
			ЗаказНарядОбъект.Записать();
			
		ИначеЕсли Действие = "3" Тогда // остановить работу (перерыв)				
			Исполнитель = Справочники.Сотрудники.НайтиПоКоду(КодСотрудника);
			Если Исполнитель = Справочники.Сотрудники.ПустаяСсылка() ИЛИ Исполнитель=Неопределено Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC12";
				НоваяСтрока.ТекстОшибки = "Сотрудник с указанным кодом не найден";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;
			
			Если МассивПакетаРабот.Количество() = 0 Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "JC09";
				НоваяСтрока.ТекстОшибки = "Пакет не содержит работ";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;	
			
			// проверить ЗначениеЗаполнено(КодПаузы)
			//ВидОтметки = Справочники.ВидыОтметокВремени.НайтиПоКоду(КодПаузы);
			// проверить ЗначениеЗаполнено(ВидОтметки), передать в НачатьНовыйИнтервал(...) 
			Если ЗакрытьСтарыйИнтервал(Исполнитель, ЗаказНарядСсылка, ПакетРаботID) Тогда
				НачатьНовыйИнтервал(Справочники.ВидыОтметокВремени.ПерерывОбед, Исполнитель, ЗаказНарядСсылка, ПакетРаботID);
			Иначе
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest", JobChangeRequest, JobChange, "0", ТаблицаОщибок);
				Возврат JobChange;				
			КонецЕсли;
			
		Иначе                  		
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "JC15";
			НоваяСтрока.ТекстОшибки = "Неверный статус отметки времени по пакету работ";
			JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
			Возврат JobChange;
		КонецЕсли;
	КонецЕсли;     	

    JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest", JobChangeRequest, JobChange, "1", ТаблицаОщибок, ПакетРаботID);
	Возврат JobChange; 

КонецФункции

Процедура НачатьНовыйИнтервал(Статус, Исполнитель, ЗаказНаряд, ПакетРабот)
	МенеджерЗаписи = РегистрыСведений.РегистрацияВремениРабот.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период    = ТекущаяДата();
	МенеджерЗаписи.Сотрудник = Исполнитель;
	МенеджерЗаписи.ЗаказНаряд   = ЗаказНаряд;
	МенеджерЗаписи.РабочееМесто = Исполнитель.Цех;
	МенеджерЗаписи.ВидОтметки= Статус;
	МенеджерЗаписи.ПакетРабот   = ПакетРабот;
	
	МенеджерЗаписи.Записать(Истина);
КонецПроцедуры

 Функция ЗакрытьСтарыйИнтервал(Исполнитель, ЗаказНаряд, ПакетРабот)
	ЗапросИнтервал = Новый Запрос();
	ЗапросИнтервал.УстановитьПараметр("Исполнитель", Исполнитель);
	ЗапросИнтервал.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
	ЗапросИнтервал.УстановитьПараметр("ПакетРабот", ПакетРабот);
	ЗапросИнтервал.УстановитьПараметр("ПустаяДата", Дата('00010101'));
	ЗапросИнтервал.Текст = "ВЫБРАТЬ
	                       |	РегистрацияВремениРаботСрезПоследних.Период КАК Период,
	                       |	РегистрацияВремениРаботСрезПоследних.ВидОтметки
	                       |ИЗ
	                       |	РегистрСведений.РегистрацияВремениРабот.СрезПоследних КАК РегистрацияВремениРаботСрезПоследних
	                       |ГДЕ
	                       |	РегистрацияВремениРаботСрезПоследних.Сотрудник = &Исполнитель
	                       |	И РегистрацияВремениРаботСрезПоследних.ЗаказНаряд = &ЗаказНаряд
	                       |	И РегистрацияВремениРаботСрезПоследних.ПакетРабот = &ПакетРабот
	                       |	И РегистрацияВремениРаботСрезПоследних.КонецРаботы = &ПустаяДата
	                       |	И РегистрацияВремениРаботСрезПоследних.Продолжительность = 0
	                       |
	                       |УПОРЯДОЧИТЬ ПО
	                       |	Период УБЫВ";
	
	ВыборкаИнтервал = ЗапросИнтервал.Выполнить().Выбрать();
	Если ВыборкаИнтервал.Следующий() Тогда
		МенеджерЗаписи = РегистрыСведений.РегистрацияВремениРабот.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период    = ВыборкаИнтервал.Период;
		МенеджерЗаписи.Сотрудник = Исполнитель;
		МенеджерЗаписи.ЗаказНаряд = ЗаказНаряд;
		МенеджерЗаписи.ВидОтметки = ВыборкаИнтервал.ВидОтметки;
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда
			КонецИнтервала = ТекущаяДата();
			МенеджерЗаписи.КонецРаботы = КонецИнтервала;
			МенеджерЗаписи.Продолжительность = (КонецИнтервала - МенеджерЗаписи.Период) / 3600;
			МенеджерЗаписи.Записать(Истина);
