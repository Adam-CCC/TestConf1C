				НоваяСтрока.ТекстОшибки = "Работа с указанным кодом не найдена";
				JobChange = обПолучитьВозвратWAError("http://wa.dms.webservice/JobGetRequest",JobChangeRequest,JobChange,"-1",ТаблицаОщибок);
				Возврат JobChange;  
			КонецЕсли;
			СтрокаРабота = ЗаказНарядОбъект.Работы.Найти(РаботаСсылка, "Работа");
			Если СтрокаРабота <> Неопределено Тогда
				СтрокаРабота.НомерПакета = НовыйНомерПакета;
				СтрокаРабота.ПакетРабот = ПакетРаботID;
				
				НетИсполнителя = Истина;
				Для Каждого СтрокаИсполнитель Из ЗаказНарядОбъект.Исполнители Цикл
					Если СтрокаИсполнитель.ИдентификаторРаботы = СтрокаРабота.ИдентификаторРаботы И СтрокаИсполнитель.Исполнитель = Исполнитель Тогда
						НетИсполнителя = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НетИсполнителя Тогда
					НовыйИсполнитель = ЗаказНарядОбъект.Исполнители.Добавить();
					НовыйИсполнитель.ИдентификаторРаботы = СтрокаРабота.ИдентификаторРаботы;
					НовыйИсполнитель.Исполнитель = Исполнитель;
					НовыйИсполнитель.Цех = Исполнитель.Цех;
					НовыйИсполнитель.Процент = 100;
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;		
		ЗаказНарядОбъект.ОбменДанными.Загрузка = Истина;
		ЗаказНарядОбъект.Записать();
		
		МенеджерПланирование = РегистрыСведений.ПланированиеПакетовРабот.СоздатьМенеджерЗаписи();
		МенеджерПланирование.ЗаказНаряд = ЗаказНарядСсылка;
		МенеджерПланирование.ПакетРабот = ПакетРаботID;
		МенеджерПланирование.ДатаНачала = НачалоПланирования;
		МенеджерПланирование.ДатаОкончания = КонецПланирования;
		МенеджерПланирование.Записать();
		
	ИначеЕсли Dispatch <> Неопределено И ЗначениеЗаполнено(ПакетРаботID) Тогда // изменение/расформирование пакета работ 
		ЗаказНарядОбъект = ЗаказНарядСсылка.ПолучитьОбъект();								
		Если НачалоПланирования = Дата('00010101') Тогда
			Для Каждого СтрокаРабота Из ЗаказНарядОбъект.Работы Цикл
				Если СтрокаРабота.ПакетРабот = ПакетРаботID Тогда
					СтрокаРабота.НомерПакета = 0;
					СтрокаРабота.ПакетРабот = "";
					
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("ИдентификаторРаботы", СтрокаРабота.ИдентификаторРаботы);
					НайденныеИсполнители = ЗаказНарядОбъект.Исполнители.НайтиСтроки(ПараметрыОтбора);
					Для Каждого СтрокаИсполнитель Из НайденныеИсполнители Цикл
						ЗаказНарядОбъект.Исполнители.Удалить(СтрокаИсполнитель);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			ЗаказНарядОбъект.ОбменДанными.Загрузка = Истина;
			ЗаказНарядОбъект.Записать();
			
			МенеджерПланирование = РегистрыСведений.ПланированиеПакетовРабот.СоздатьМенеджерЗаписи();
