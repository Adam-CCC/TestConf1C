
Функция Get(EmployeeGetRequest)
	// Вставить содержимое обработчика.
	EmployeeGetResponseType = ФабрикаXDTO.Тип("http://wa.dms.webservice/EmployeeGetRequest", "EmployeeGetResponse");
	EmployeeGetResponse = ФабрикаXDTO.Создать(EmployeeGetResponseType);   
	
	// Таблица для вызова функции общего назначения
	ТаблицаОщибок = Новый ТаблицаЗначений;
	ТаблицаОщибок.Колонки.Добавить("Код",	 Новый ОписаниеТипов("Строка"));
	ТаблицаОщибок.Колонки.Добавить("ТекстОшибки",		 Новый ОписаниеТипов("Строка"));
	DealerID = EmployeeGetRequest.TransactionHeader.DealerID;	
	Попытка
		IDСотрудника = EmployeeGetRequest.EmployeeGet.DMSEmployeeNo;
	Исключение
		IDСотрудника = "";   			
	КонецПопытки;
	
    Попытка
		ДатаИзмененийНачало = EmployeeGetRequest.EmployeeGet.LastModifiedDateTimeFromUTC;
	Исключение
		ДатаИзмененийНачало = Дата('00010101');
	КонецПопытки;        	
    Попытка
		ДатаИзмененийКонец = EmployeeGetRequest.EmployeeGet.LastModifiedDateTimeToUTC;
	Исключение
		ДатаИзмененийКонец = Дата('00010101');
	КонецПопытки;	
	Если ЗначениеЗаполнено(ДатаИзмененийНачало) Или ЗначениеЗаполнено(ДатаИзмененийКонец) Тогда
		EmployeeGetResponse = обПолучитьВозвратWAError("http://wa.dms.webservice/EmployeeGetRequest",EmployeeGetRequest,EmployeeGetResponse,"0",ТаблицаОщибок);  // функция общего назначения
		Возврат EmployeeGetResponse;  		
	КонецЕсли;
	
	// БЛОК КЛЮЧЕВОГО ПОИСКА
	Если ЗначениеЗаполнено(IDСотрудника) Тогда
		СотрудникСсылка = Справочники.Сотрудники.НайтиПоКоду(IDСотрудника);
		Если СотрудникСсылка.Пустая() Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "WA03";
			НоваяСтрока.ТекстОшибки = "Сотрудник с указанным кодом не найден";
			EmployeeGetResponse = обПолучитьВозвратWAError("http://wa.dms.webservice/EmployeeGetRequest", EmployeeGetRequest, EmployeeGetResponse,"-1",ТаблицаОщибок);
			Возврат EmployeeGetResponse;  		
		КонецЕсли;
	Иначе
		СотрудникСсылка = Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(СотрудникСсылка) Тогда  		
		Запрос.Текст = "ВЫБРАТЬ
		               |	Сотрудники.Ссылка КАК СотрудникСсылка
		               |ИЗ
		               |	Справочник.Сотрудники КАК Сотрудники
		               |ГДЕ
		               |	Сотрудники.Ссылка = &СотрудникСсылка
		               |	И Сотрудники.Должность.КодРолиWA > 0
		               |	И Сотрудники.Должность.КодРолиWA < 5
		               |	И Сотрудники.Подразделение.ДилерИД = &ДилерИД";
		Запрос.УстановитьПараметр("ДилерИД",DealerID);	
		Запрос.Параметры.Вставить("СотрудникСсылка", СотрудникСсылка); 
		
	// Выяснить, нужно ли версионирование и в каких запросах!!!
	//ИначеЕсли ЗначениеЗаполнено(ДатаИзмененийНачало) ИЛИ ЗначениеЗаполнено(ДатаИзмененийКонец) Тогда	                                                                        
	//	Запрос.Текст = "ВЫБРАТЬ
	//				   |	Версионирование.Идентификатор КАК СотрудникСсылка,
	//				   |	Версионирование.ПредставлениеМетаданных,
	//				   |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Версионирование.Автор) КАК Автор
	//				   |ИЗ
	//				   |	РегистрСведений.Версионирование КАК Версионирование
	//				   |ГДЕ
	//				   |	Версионирование.ДатаИзменения МЕЖДУ &ДатаНач И &ДатаКон
	//				   |	И Версионирование.ПредставлениеМетаданных = &СправочникСотрудники
	//				   |
	//				   |СГРУППИРОВАТЬ ПО
	//				   |	Версионирование.Идентификатор,
	//				   |	Версионирование.ПредставлениеМетаданных";
	//				   
	//	Запрос.Параметры.Вставить("ДатаНач", ?(обЗначениеНеЗаполнено(ДатаИзмененийНачало),Дата('00010101'),ДатаИзмененийНачало));            
	//	Запрос.Параметры.Вставить("ДатаКон", ?(обЗначениеНеЗаполнено(ДатаИзмененийКонец),Дата('20300101'),ДатаИзмененийКонец));
	//	Запрос.Параметры.Вставить("СправочникСотрудники","Справочник.Сотрудники"); 		
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	Сотрудники.Ссылка КАК СотрудникСсылка
		               |ИЗ
		               |	Справочник.Сотрудники КАК Сотрудники
		               |ГДЕ
		               |	Сотрудники.Должность.КодРолиWA > 0
		               |	И Сотрудники.Должность.КодРолиWA < 5
		               |	И Сотрудники.Подразделение.ДилерИД = &ДилерИД";
		Запрос.УстановитьПараметр("ДилерИД",DealerID);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Количество()=0 Тогда                         		
		EmployeeGetResponse = обПолучитьВозвратWAError("http://wa.dms.webservice/EmployeeGetRequest",EmployeeGetRequest,EmployeeGetResponse,"0",ТаблицаОщибок);  // функция общего назначения
		Возврат EmployeeGetResponse;  		
	Иначе
		ArrayOfEmployeeDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/EmployeeGetRequest", "ArrayOfEmployee");
		ArrayOfEmployeeData = ФабрикаXDTO.Создать(ArrayOfEmployeeDataType);
		
		ПустаяДата = Дата(1, 1, 1);
		Пока Выборка.Следующий() Цикл 			
			Если ТипЗнч(Выборка.СотрудникСсылка)=Тип("СправочникСсылка.Сотрудники") Тогда	
				Сотрудник = Выборка.СотрудникСсылка;
			Иначе
				Сотрудник = Справочники.Сотрудники.ПолучитьСсылку(Выборка.СотрудникСсылка); // Строка(GUID) в регистре версионирования
			КонецЕсли;
			
			EmployeeDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/EmployeeGetRequest", "Employee");
			EmployeeData = ФабрикаXDTO.Создать(EmployeeDataType); 
			EmployeeData.DMSEmployeeNo = Сотрудник.Код;
			EmployeeData.LastName = обПолучитьФамилия(Сотрудник.Наименование);
			EmployeeData.MiddleName = обПолучитьОтчество(Сотрудник.Наименование);
			EmployeeData.FirstName = обПолучитьИмя(Сотрудник.Наименование);
			EmployeeData.FullName = Сотрудник.Наименование;
			EmployeeData.Salution = "";
			
			EmployeeData.Gender = "1";
			EmployeeData.Language = "ru";
			EmployeeData.SkillsetString = "";
			EmployeeData.Title = "";
			EmployeeData.MobileNumber = ПредставлениеТелефонаДляWA(Сотрудник, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
			Если обЗначениеНеЗаполнено(EmployeeData.MobileNumber) Тогда
				EmployeeData.MobileNumber = ПредставлениеТелефонаДляWA(Сотрудник, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
			КонецЕсли;
			EmployeeData.PhoneNumber = ПредставлениеТелефонаДляWA(Сотрудник, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
			EmployeeData.Email = киПолучитьПредставлениеКИ(Сотрудник, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
			EmployeeData.LoginID = "";
			EmployeeData.LoginPassword = "";      			
			
			Если Сотрудник.ФлагУволен Тогда			
				EmployeeData.EmployeeStatus = "3";
			Иначе
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				               |	ГрафикРаботКалендарный.ВидДня,
				               |	ГрафикРаботКалендарный.Продолжительность
				               |ИЗ
				               |	РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
				               |ГДЕ
				               |	ГрафикРаботКалендарный.График = &ГрафикСотрудника
				               |	И ГрафикРаботКалендарный.Дата = &ДатаЗапроса";
							   
				Запрос.Параметры.Вставить("ГрафикСотрудника",Сотрудник.ГрафикРаботы);
				Запрос.Параметры.Вставить("ДатаЗапроса",НачалоДня(ТекущаяДата()));
				Выб = Запрос.Выполнить().Выбрать();
				Если Выб.Количество()=0 Тогда
					EmployeeData.EmployeeStatus = "2"; // “1” – работает, “2” – выходной, “3” – уволен
				Иначе
					Выб.Следующий();
					Если Выб.ВидДня = Перечисления.ВидДня.Рабочий Тогда
						EmployeeData.EmployeeStatus = "1";
					Иначе
						EmployeeData.EmployeeStatus = "2";
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			EmployeeData.Group = "";
			
			//ПерваяЗапись = РегистрыСведений.Версионирование.ПолучитьПервое(,Новый Структура("Идентификатор, ПредставлениеМетаданных",Сотрудник.УникальныйИдентификатор(),Сотрудник.Метаданные().ПолноеИмя()));
			//ПоследняяЗапись = РегистрыСведений.Версионирование.ПолучитьПоследнее(,Новый Структура("Идентификатор, ПредставлениеМетаданных",Сотрудник.УникальныйИдентификатор(),Сотрудник.Метаданные().ПолноеИмя()));
			ManagementFieldsDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/EmployeeGetRequest", "ManagementFields");
			ManagementFieldsData = ФабрикаXDTO.Создать(ManagementFieldsDataType); 
			ManagementFieldsData.CreateDateTimeUTC = ПустаяДата;
			ManagementFieldsData.LastModifiedDateTimeUTC = ПустаяДата;
			EmployeeData.ManagementFields = ManagementFieldsData;
			
			ArrayOfRoleDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/EmployeeGetRequest", "ArrayOfRole");
			ArrayOfRoleData = ФабрикаXDTO.Создать(ArrayOfRoleDataType); 
			RoleDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/EmployeeGetRequest", "Role");
			RoleData = ФабрикаXDTO.Создать(RoleDataType);
			RoleData.RoleName = Строка(Сотрудник.Должность.КодРолиWA);
			RoleData.RoleUserID = "";
			ArrayOfRoleData.Role.Добавить(RoleData);
			
			EmployeeData.Roles = ArrayOfRoleData;         			
			ArrayOfEmployeeData.Employee.Добавить(EmployeeData);			
		КонецЦикла;     
	КонецЕсли;
	
	EmployeeGetResponse.Employees = ArrayOfEmployeeData;
	EmployeeGetResponse = обПолучитьВозвратWAError("http://wa.dms.webservice/EmployeeGetRequest",EmployeeGetRequest,EmployeeGetResponse,"1",ТаблицаОщибок);
	Возврат EmployeeGetResponse;  	
КонецФункции 

