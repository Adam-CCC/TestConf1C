
Функция PackageCodeGet(PackageCodeGetRequest)
	// Вставить содержимое обработчика.
	PackageCodeGetType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "PackageCodeGetResponse");
	PackageCodeGet = ФабрикаXDTO.Создать(PackageCodeGetType);   
	
	ТаблицаОщибок = Новый ТаблицаЗначений;
	ТаблицаОщибок.Колонки.Добавить("Код",	 Новый ОписаниеТипов("Строка"));
	ТаблицаОщибок.Колонки.Добавить("ТекстОшибки",		 Новый ОписаниеТипов("Строка"));

	Попытка
		КодПакета = PackageCodeGetRequest.PackageCodeGet.Code;
	Исключение
		КодПакета = "";
	КонецПопытки;       
	Попытка
		Описание = PackageCodeGetRequest.PackageCodeGet.Description;
	Исключение
		Описание = "";
	КонецПопытки;     
    Попытка
		Модель = PackageCodeGetRequest.PackageCodeGet.ModelCode;
	Исключение
		Модель = "";
	КонецПопытки; 
    Попытка
		Двигатель = PackageCodeGetRequest.PackageCodeGet.EngineCode;
	Исключение
		Двигатель = "";
	КонецПопытки;     
    Попытка
		Пробег = PackageCodeGetRequest.PackageCodeGet.Mileage;
	Исключение
		Пробег = "";
	КонецПопытки;   	
	Попытка
		НачДатаИзменения = PackageCodeGetRequest.PackageCodeGet.LastModifiedDateTimeFromUTC;
	Исключение
		НачДатаИзменения = Дата('00010101');
	КонецПопытки;   
	Попытка
		КонДатаИзменения = PackageCodeGetRequest.AppointmentGet.LastModifiedDateTimeToUTC;
	Исключение
		КонДатаИзменения = Дата('00010101');
	КонецПопытки;

	МодельСсылка = Справочники.Модели.ПустаяСсылка();
	ПакетСсылка = Справочники.Автоработы.ПустаяСсылка();
	Если ЗначениеЗаполнено(Модель) Тогда
		МодельСсылка = Справочники.Модели.НайтиПоКоду(Модель);
		Если обЗначениеНеЗаполнено(МодельСсылка) Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PCG03";
			НоваяСтрока.ТекстОшибки = "Модель с указанным кодом не найдена";
			PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/PackageCodeGetRequest",PackageCodeGetRequest,PackageCodeGet,"-1",ТаблицаОщибок);
			Возврат PackageCodeGet;      
		КонецЕсли;		
	ИначеЕсли ЗначениеЗаполнено(КодПакета) Тогда
		ПакетСсылка = Справочники.Автоработы.НайтиПоКоду(КодПакета);
		Если обЗначениеНеЗаполнено(ПакетСсылка) Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PCG03";
			НоваяСтрока.ТекстОшибки = "Авторабота с указанным кодом не найдена";
			PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/PackageCodeGetRequest",PackageCodeGetRequest,PackageCodeGet,"-1",ТаблицаОщибок);
			Возврат PackageCodeGet;      
		КонецЕсли;
	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "PCG03";
		НоваяСтрока.ТекстОшибки = "Не заполено ни одно из обязательных полей для поиска";
		PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/PackageCodeGetRequest",PackageCodeGetRequest,PackageCodeGet,"-1",ТаблицаОщибок);
		Возврат PackageCodeGet;      		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Двигатель) Тогда 
		ДвигательСсылка = Справочники.ТипыДвигателей.НайтиПоКоду(Двигатель);
		Если обЗначениеНеЗаполнено(ДвигательСсылка) Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PCG04";
			НоваяСтрока.ТекстОшибки = "Тип двигателя с указанным кодом не найден";
			PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/PackageCodeGetRequest",PackageCodeGetRequest,PackageCodeGet,"-1",ТаблицаОщибок);
			Возврат PackageCodeGet;      
		КонецЕсли;
	Иначе
		ДвигательСсылка = Справочники.ТипыДвигателей.ПустаяСсылка();
	КонецЕсли;
	
    // БЛОК ПОИСКА
	//СписокВерсионирование = Новый СписокЗначений;
	//Если ЗначениеЗаполнено(НачДатаИзменения) ИЛИ ЗначениеЗаполнено(КонДатаИзменения) Тогда 
	//	Запрос = Новый Запрос;
	//	Запрос.Текст = "ВЫБРАТЬ
	//	               |	Версионирование.Идентификатор КАК ДокСсылка,
	//	               |	Версионирование.ПредставлениеМетаданных,
	//	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Версионирование.Автор) КАК Автор
	//	               |ИЗ
	//	               |	РегистрСведений.Версионирование КАК Версионирование
	//	               |ГДЕ
	//	               |	Версионирование.ДатаИзменения МЕЖДУ &ДатаНач И &ДатаКон
	//	               |	И Версионирование.ПредставлениеМетаданных = &СправочникАвтоработы
	//				   |СГРУППИРОВАТЬ ПО
	//	               |	Версионирование.Идентификатор,                                               
	//	               |	Версионирование.ПредставлениеМетаданных";

	//	Если обЗначениеНеЗаполнено(НачДатаИзменения) Тогда
	//		Запрос.Параметры.Вставить("ДатаНач",Дата('20150501'));
	//	Иначе
	//		Запрос.Параметры.Вставить("ДатаНач",НачДатаИзменения);
	//	КонецЕсли;		
	//	Если обЗначениеНеЗаполнено(КонДатаИзменения) Тогда
	//		Запрос.Параметры.Вставить("ДатаКон",Дата('20300101'));
	//	Иначе
	//		Запрос.Параметры.Вставить("ДатаКон",КонДатаИзменения);
	//	КонецЕсли;   
	//	Запрос.Параметры.Вставить("СправочникАвтоработы","Справочник.Автоработы"); 
	//	
	//	Выб = Запрос.Выполнить().Выбрать();
	//	Пока Выб.Следующий() Цикл
	//		СписокВерсионирование.Добавить(Справочники.Автоработы.ПолучитьСсылку(Выб.ДокСсылка));
	//	КонецЦикла;		
	//КонецЕсли;    

	// Тип двигателя - в Модели обязательный реквизит! Есть реквизит Тип работ в Автоработе - признак Пакета!
    Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("ПустойТипДвигателя", Справочники.ТипыДвигателей.ПустаяСсылка());
	ОтборПоТипуДвигателя = "И ВЫБОР
		               |		КОГДА АвтоработыНормыВремени.ВариантКомплектации ЕСТЬ NULL
		               |			ТОГДА ЛОЖЬ
		               |		ИНАЧЕ АвтоработыНормыВремени.ВариантКомплектации.ТипДвигателя = &ДвигательСсылка
		               |	КОНЕЦ";
		
	Запрос.Текст = "ВЫБРАТЬ
	               |	АвтоработыНормыВремени.Ссылка КАК ПакетСсылка,
	               |	АвтоработыНормыВремени.Ссылка.Код КАК КодПакета,
	               |	АвтоработыНормыВремени.Ссылка.Наименование КАК НаименованиеПакета,
	               |	АвтоработыНормыВремени.Ссылка.ТипРабот КАК ТипПакета,
	               |	АвтоработыНормыВремени.Ссылка.ВремяВыполнения КАК ВремяВыполнения,
	               |	АвтоработыНормыВремени.Модель КАК МодельСсылка,
	               |	ВЫБОР
	               |		КОГДА АвтоработыНормыВремени.ВариантКомплектации ЕСТЬ NULL
	               |			ТОГДА &ПустойТипДвигателя
	               |		ИНАЧЕ АвтоработыНормыВремени.ВариантКомплектации.ТипДвигателя
	               |	КОНЕЦ КАК ТипДвигателя
	               |ИЗ
	               |	Справочник.Автоработы.НормыВремени КАК АвтоработыНормыВремени
	               |ГДЕ
	               |	НЕ АвтоработыНормыВремени.Ссылка.ПометкаУдаления
	               |	" + ?(ЗначениеЗаполнено(МодельСсылка), "И АвтоработыНормыВремени.Модель = &МодельСсылка", "") + "
                   |	" + ?(ЗначениеЗаполнено(ПакетСсылка), "И АвтоработыНормыВремени.Ссылка = &ПакетСсылка", "") + "
	               |    " + ?(ЗначениеЗаполнено(ДвигательСсылка), ОтборПоТипуДвигателя, "") + "
				   |
	               |ИТОГИ ПО
	               |	ПакетСсылка";
	
	Если ЗначениеЗаполнено(МодельСсылка) Тогда
		Запрос.Параметры.Вставить("МодельСсылка", МодельСсылка);
	КонецЕсли;  
	Если ЗначениеЗаполнено(ПакетСсылка) Тогда
		Запрос.Параметры.Вставить("ПакетСсылка", ПакетСсылка);
	КонецЕсли;  
	Если ЗначениеЗаполнено(ДвигательСсылка) Тогда
		Запрос.Параметры.Вставить("ДвигательСсылка", ДвигательСсылка);
	КонецЕсли; 
	//Если СписокВерсионирование.Количество()>0 Тогда
	//	Запрос.Параметры.Вставить("СписокВерсионирование",СписокВерсионирование);
	//КонецЕсли;   
		
	ВыборкаПакеты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Если ВыборкаПакеты.Количество() = 0 Тогда                         		
		PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/PackageCodeGetRequest",PackageCodeGetRequest,PackageCodeGet,"0",ТаблицаОщибок);
		Возврат PackageCodeGet;  	
		
	Иначе           				
		ЗапросРаботы = Новый Запрос;
		ЗапросРаботы.Текст = "ВЫБРАТЬ
		               |	СвязанныеРаботы.СвязаннаяРабота КАК РаботаСсылка,
		               |	СвязанныеРаботы.СвязаннаяРабота.Код КАК КодРаботы,
		               |	СвязанныеРаботы.СвязаннаяРабота.Наименование КАК НаименованиеРаботы,
		               |	СвязанныеРаботы.СвязаннаяРабота.Артикул КАК АртикулРаботы,
		               |	СвязанныеРаботы.СвязаннаяРабота.ВремяВыполнения КАК ВремяВыполнения,
		               |	СвязанныеРаботы.Цена ЦенаРаботы,
		               |	СвязанныеРаботы.Количество КАК КоличествоРаботы
		               |ИЗ
		               |	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
		               |ГДЕ
		               |	СвязанныеРаботы.Авторабота = &ПакетСсылка
		               |	И СвязанныеРаботы.СвязаннаяРабота ССЫЛКА Справочник.Автоработы";
		
		ЗапросНоменклатура = Новый Запрос;
		ЗапросНоменклатура.Текст = "ВЫБРАТЬ
		               |	СвязанныеРаботы.СвязаннаяРабота КАК НоменклатураСсылка,
		               |	СвязанныеРаботы.СвязаннаяРабота.Код КАК КодНоменклатуры,
		               |	СвязанныеРаботы.СвязаннаяРабота.Наименование КАК НаименованиеНоменклатуры,
		               |	СвязанныеРаботы.СвязаннаяРабота.Артикул КАК АртикулНоменклатуры,
		               |	СвязанныеРаботы.СвязаннаяРабота.ОсновнаяЕдиницаИзмерения КАК ЕдИзмНоменклатуры,
		               |	СвязанныеРаботы.Цена ЦенаНоменклатуры,
		               |	СвязанныеРаботы.Количество КАК КоличествоНоменклатуры
		               |ИЗ
		               |	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
		               |ГДЕ
		               |	СвязанныеРаботы.Авторабота = &ПакетСсылка
		               |	И СвязанныеРаботы.СвязаннаяРабота ССЫЛКА Справочник.Номенклатура";
			
		PackageCodesType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "ArrayOfPackageCode");
		PackageCodes = ФабрикаXDTO.Создать(PackageCodesType); 	
		PackageCodeType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "PackageCode");       		
		Пока ВыборкаПакеты.Следующий() Цикл
			PackageCode = ФабрикаXDTO.Создать(PackageCodeType);		
			PackageCode.Code = ВыборкаПакеты.КодПакета;
			PackageCode.Description = ВыборкаПакеты.НаименованиеПакета;
			Если ВыборкаПакеты.ТипПакета = Перечисления.ТипыРабот.ТО Тогда
				PackageCode.PackageCodeType = "2";
			Иначе
				PackageCode.PackageCodeType = "3";
			КонецЕсли;
			PackageCode.DisplayPackageCode = ВыборкаПакеты.КодПакета;
			PackageCode.DisplayOperationDescription = ВыборкаПакеты.НаименованиеПакета;
			PackageCode.Make = "";
						
			ВыборкаМодели = ВыборкаПакеты.Выбрать();
			Если ВыборкаМодели.Следующий() И ЗначениеЗаполнено(ВыборкаМодели.МодельСсылка) Тогда
				МодельПакета = ВыборкаМодели.МодельСсылка;
				PackageCode.ModelCode = МодельПакета.КодМодели;	
				PackageCode.Model = МодельПакета.Наименование;
				Если ЗначениеЗаполнено(ВыборкаМодели.ТипДвигателя) Тогда
					PackageCode.EngineCode = ВыборкаМодели.ТипДвигателя.Код;
					PackageCode.Engine = ВыборкаМодели.ТипДвигателя.Наименование;			
				Иначе
					PackageCode.EngineCode = "";
					PackageCode.Engine = "";			
				КонецЕсли;
			Иначе
				МодельПакета = Справочники.Модели.ПустаяСсылка();
				PackageCode.ModelCode = "";	
				PackageCode.Model = "";
				PackageCode.EngineCode = "";
				PackageCode.Engine = "";							
			КонецЕсли;		
			
			PackageCode.Year = "";
			PackageCode.Mileage = "15000";
			PackageCode.Period = "";
			PackageCode.DefLinePaymentMethod = ""; 						
			PackageCode.EstimatedHours = Формат(ВыборкаПакеты.ВремяВыполнения, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");

			//ПерваяЗапись = РегистрыСведений.Версионирование.ПолучитьПервое(,Новый Структура("Идентификатор, ПредставлениеМетаданных",ВыборкаПакеты.Ссылка.УникальныйИдентификатор(),ВыборкаПакеты.Ссылка.Метаданные().ПолноеИмя()));
			//ПоследняяЗапись = РегистрыСведений.Версионирование.ПолучитьПоследнее(,Новый Структура("Идентификатор, ПредставлениеМетаданных",ВыборкаПакеты.Ссылка.УникальныйИдентификатор(),ВыборкаПакеты.Ссылка.Метаданные().ПолноеИмя()));
			ManagementFieldsDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "ManagementFields");
			ManagementFieldsData = ФабрикаXDTO.Создать(ManagementFieldsDataType); 
			ПерваяЗапись = ТекущаяДата();
			ПоследняяЗапись = ТекущаяДата();
			ManagementFieldsData.CreateDateTimeUTC = ПерваяЗапись;
			ManagementFieldsData.LastModifiedDateTimeUTC = ПоследняяЗапись;
			PackageCode.ManagementFields = ManagementFieldsData;
			
			//PriceType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "PriceType");
			//Price = ФабрикаXDTO.Создать(PriceType);
			//Если ЗначениеЗаполнено(МодельПакета) Тогда
			//	НормочасЦенаСтр = орПолучитьЦенуАвтоработы(Справочники.ТипыЦен.ОсновнойТипЦенПродажи, ВыборкаПакеты.ПакетСсылка, МодельПакета,
			//					Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка(), Справочники.Цеха.ПустаяСсылка(), Справочники.ВидыРемонта.ПустаяСсылка());
			//	ЦенаПакета = Формат(НормочасЦенаСтр.Цена * ВыборкаПакеты.ВремяВыполнения, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
			//	Price.UnitPrice = ЦенаПакета;
			//	Price.TotalPrice = ЦенаПакета;
			//	Price.TotalPriceIncludeTax = ЦенаПакета;
			//	Price.DiscountRate = "0";
			//	Price.DiscountPrice = "0";  
			//КонецЕсли;          
			//PackageCode.PriceType = Price;
			
			// связанные работы
			ЗапросРаботы.Параметры.Вставить("ПакетСсылка", ВыборкаПакеты.ПакетСсылка);
			ВыборкаРаботы = ЗапросРаботы.Выполнить().Выбрать();
			НетРабот = ВыборкаРаботы.Количество() = 0;
			OpCodesType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "ArrayOfOPCode");
			OpCodes = ФабрикаXDTO.Создать(OpCodesType);
            OPCodeType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "OPCode");			
			Пока ВыборкаРаботы.Следующий() Цикл
				OpCode = ФабрикаXDTO.Создать(OPCodeType); 
				OpCode.Code = ВыборкаРаботы.КодРаботы;
				OpCode.Description = ВыборкаРаботы.НаименованиеРаботы;
				OpCode.OPCodeType = ?(ВыборкаРаботы.КодРаботы = ВыборкаРаботы.АртикулРаботы, "1", "2");
				OpCode.DisplayOPCode = ВыборкаРаботы.КодРаботы;
				OpCode.DisplayOPDescription = ВыборкаРаботы.НаименованиеРаботы;
				OpCode.Make = "";
				OpCode.Model = "";			
				OpCode.Engine = "";
				OpCode.Year = "";
				OpCode.Mileage = "";
				OpCode.Period = "";
				OpCode.Quantity = Формат(ВыборкаРаботы.КоличествоРаботы, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");
				OpCode.DefLinePaymentMethod = "";
				OpCode.CorrectionLOP = "";
				OpCode.SkillLevel = "";			
				OpCode.HazardMaterialCharge = "";					
				OpCode.EstimatedHours = Формат(ВыборкаРаботы.ВремяВыполнения, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");
				OpCode.PredefinedCauseDescription = "";
				OpCode.CPSIND = "";  	
				OpCode.MandatoryYN = "";  

				PriceType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "PriceType");
				Price = ФабрикаXDTO.Создать(PriceType);
				Если ЗначениеЗаполнено(ВыборкаРаботы.ЦенаРаботы) Тогда
					ЦенаСвРаботы = Формат(ВыборкаРаботы.ЦенаРаботы, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
					Price.UnitPrice = ЦенаСвРаботы;
					Price.TotalPrice = ЦенаСвРаботы;
					Price.TotalPriceIncludeTax = ЦенаСвРаботы;
				Иначе
					Если ЗначениеЗаполнено(МодельПакета) Тогда
						НормочасЦенаСтр = орПолучитьЦенуАвтоработы(Справочники.ТипыЦен.ОсновнойТипЦенПродажи, ВыборкаРаботы.РаботаСсылка, МодельПакета,
										Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка(), Справочники.Цеха.ПустаяСсылка(), Справочники.ВидыРемонта.ПустаяСсылка());
						ЦенаСвРаботы = Формат(НормочасЦенаСтр.Цена * ВыборкаРаботы.ВремяВыполнения, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
						Price.UnitPrice = ЦенаСвРаботы;
						Price.TotalPrice = ЦенаСвРаботы;
						Price.TotalPriceIncludeTax = ЦенаСвРаботы;
						Price.DiscountRate = "0";
						Price.DiscountPrice = "0";  
					КонецЕсли;          
				КонецЕсли;				
				Price.DiscountRate = "0";
				Price.DiscountPrice = "0";  
				OpCode.PriceType = Price;
				
				PartsType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "ArrayOfPart");
				Parts = ФабрикаXDTO.Создать(PartsType);
                OpCode.Parts = Parts;     									  							
                OpCodes.OpCode.Добавить(OpCode);     
			КонецЦикла; 
			
			// связанная номенклатура
			OpCode = ФабрикаXDTO.Создать(OPCodeType); 
			OpCode.Code = "OP_Part";
			OpCode.Description = "";
			OpCode.OPCodeType = "";
			OpCode.DisplayOPCode = "";
			OpCode.DisplayOPDescription = "";
			OpCode.Make = "";
			OpCode.Model = "";			
			OpCode.Engine = "";
			OpCode.Year = "";
			OpCode.Mileage = "";
			OpCode.Period = "";
			OpCode.Quantity = Формат(0,"ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");
			OpCode.DefLinePaymentMethod = "";
			OpCode.CorrectionLOP = "";
			OpCode.SkillLevel = "";			
			OpCode.HazardMaterialCharge = "";					
			OpCode.EstimatedHours = Формат(0,"ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");
			OpCode.PredefinedCauseDescription = "";
			OpCode.CPSIND = "";  	
			OpCode.MandatoryYN = "";  
			
			PriceType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "PriceType");
			Price = ФабрикаXDTO.Создать(PriceType);
			OpCode.PriceType = Price;
			
			PartsType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "ArrayOfPart");
			Parts = ФабрикаXDTO.Создать(PartsType);
			
			ЗапросНоменклатура.Параметры.Вставить("ПакетСсылка", ВыборкаПакеты.ПакетСсылка);
			ВыборкаНоменклатура = ЗапросНоменклатура.Выполнить().Выбрать();
			НетЗапчастей = ВыборкаНоменклатура.Количество() = 0;
			Если НетРабот И НетЗапчастей Тогда
				Продолжить;
			КонецЕсли;
			
			Пока ВыборкаНоменклатура.Следующий() Цикл
				PartType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "Part");
				Part = ФабрикаXDTO.Создать(PartType);
				Part.Manufacturer = "";
				Part.PartNumber = ВыборкаНоменклатура.АртикулНоменклатуры; 
				Part.PartDescription = ВыборкаНоменклатура.НаименованиеНоменклатуры; 
				Part.Make = "";
				Part.PartStatus = "";
				Part.PartType = ?(ВыборкаНоменклатура.КодНоменклатуры = ВыборкаНоменклатура.АртикулНоменклатуры, "1", "2");
				
				Подразделение = Справочники.ПодразделенияКомпании.ПустаяСсылка();
				КодДилера = PackageCodeGetRequest.TransactionHeader.DealerID;
				Если КодДилера = "RC294" Тогда // исправить на RC294 в рабочей базе
					Подразделение = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001175");
				ИначеЕсли КодДилера = "RC536" Тогда
					Подразделение = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001258");
				КонецЕсли;				
				Если ЗначениеЗаполнено(Подразделение) Тогда
					ЗапросЦеныОстатки = Новый Запрос;
					ЗапросЦеныОстатки.Текст = "ВЫБРАТЬ
					               |	ВЫБОР
					               |		КОГДА ОстаткиТоваровКомпанииОстатки.КоличествоОстаток ЕСТЬ NULL
					               |			ТОГДА 0
					               |		ИНАЧЕ ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0)
					               |	КОНЕЦ КАК СвободныйОстаток,
					               |	ЦеныСрезПоследних.Цена КАК Цена
					               |ИЗ
					               |	РегистрСведений.Цены.СрезПоследних(
					               |			,
					               |			Номенклатура = &Номенклатура
					               |				И ПодразделениеКомпании = &Подразделение
					               |				И ТипЦен = &ТипЦен) КАК ЦеныСрезПоследних
					               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
					               |				,
					               |				СкладКомпании.Подразделение = &Подразделение
					               |					И Номенклатура = &Номенклатура) КАК ОстаткиТоваровКомпанииОстатки
					               |		ПО ЦеныСрезПоследних.Номенклатура = ОстаткиТоваровКомпанииОстатки.Номенклатура";
																							 
					ЗапросЦеныОстатки.Параметры.Вставить("ТипЦен", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
					ЗапросЦеныОстатки.Параметры.Вставить("Номенклатура", ВыборкаНоменклатура.НоменклатураСсылка);
					ЗапросЦеныОстатки.Параметры.Вставить("Подразделение", Подразделение);

					ВыборкаЦены = ЗапросЦеныОстатки.Выполнить().Выбрать();
					Если ВыборкаЦены.Следующий() Тогда
						UnitPrice = ВыборкаЦены.Цена;
						Part.QuantityOnHand = Формат(ВыборкаЦены.СвободныйОстаток, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0");
						Part.StockQuantity = ?(ВыборкаЦены.СвободныйОстаток > 0, "Y", "N");			
						Part.StockStatus = Формат(ВыборкаЦены.СвободныйОстаток, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0");					
					Иначе        		
						UnitPrice = 0;
						Part.QuantityOnHand = "0";
						Part.StockQuantity = "N";
						Part.StockStatus = "";
					КонецЕсли;  					
				Иначе
					UnitPrice = 0;
					Part.QuantityOnHand = "0";
					Part.StockQuantity = "N";
					Part.StockStatus = "";
				КонецЕсли;
					
				Part.DisplayPartNumber = ВыборкаНоменклатура.АртикулНоменклатуры; 
				Part.Remarks = "";    					
				Part.UnitOfMeasure = ВыборкаНоменклатура.ЕдИзмНоменклатуры.Наименование;
				Part.Quantity = Формат(ВыборкаНоменклатура.КоличествоНоменклатуры, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");
				Part.ServiceType = ""; 
				Part.DisplayRemarks = "";
				Part.MandatoryYN = "";

				PriceType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PackageCodeGetRequest", "PriceType");
				Price = ФабрикаXDTO.Создать(PriceType);				
				Price.UnitPrice = Формат(UnitPrice, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
				Price.TotalPrice = Формат(UnitPrice * ВыборкаНоменклатура.КоличествоНоменклатуры, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
				Price.TotalPriceIncludeTax = Price.TotalPrice;
				Price.DiscountRate = "0";
				Price.DiscountPrice = "0";  
				Part.PriceType = Price;   										         
	
                Parts.Part.Добавить(Part);
			КонецЦикла;   			
			
			OpCode.Parts = Parts;     									  							
            OpCodes.OpCode.Добавить(OpCode);     					
			PackageCode.OpCodes = OpCodes;
			PackageCodes.PackageCode.Добавить(PackageCode);  
		КонецЦикла;
    КонецЕсли;    		

    PackageCodeGet.PackageCodes = PackageCodes;
	PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/PackageCodeGetRequest",PackageCodeGetRequest,PackageCodeGet,"1",ТаблицаОщибок);
	Возврат PackageCodeGet;  

КонецФункции
