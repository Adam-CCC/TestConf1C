
Функция Print(PrintRequest)
	PrintType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PrintRequest", "PrintResponse");
	Print = ФабрикаXDTO.Создать(PrintType);   
	
	ТаблицаОщибок = Новый ТаблицаЗначений;
	ТаблицаОщибок.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	ТаблицаОщибок.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	
    Попытка
		НомерЗаказНаряда = PrintRequest.Print.DMSRONo;
	Исключение
		НомерЗаказНаряда = "";	 
	КонецПопытки; 
	
	Попытка
		IDЗаказНаряда = PrintRequest.Print.DMSROID;
	Исключение
		IDЗаказНаряда = "";	 
	КонецПопытки; 
	
	ЗаказНарядСсылка = Документы.ЗаказНаряд.ПустаяСсылка();
	Если ЗначениеЗаполнено(IDЗаказНаряда) Тогда
		Попытка
			ID = Новый УникальныйИдентификатор(IDЗаказНаряда);
		Исключение
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PR01";
			НоваяСтрока.ТекстОшибки = "Неверный параметр идентификатор заказ-наряда";
			Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
			Возврат Print;   	
		КонецПопытки;
		ЗаказНарядСсылка = Документы.ЗаказНаряд.ПолучитьСсылку(ID);
    	Если ЗаказНарядСсылка.ПолучитьОбъект() = Неопределено Тогда		
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PR01";
			НоваяСтрока.ТекстОшибки = "Заказ-наряд с указанным идентификатором не найден";
			Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
			Возврат Print;  		
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(НомерЗаказНаряда) Тогда 
		ЗаказНарядСсылка = Документы.ЗаказНаряд.НайтиПоНомеру(НомерЗаказНаряда, ТекущаяДата());
		Если ЗаказНарядСсылка.Пустая() Тогда  			
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PR01";
			НоваяСтрока.ТекстОшибки = "Заказ-наряд с указанным номером не найден";
			Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
			Возврат Print;  		
		КонецЕсли;
		
	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "PR01";
		НоваяСтрока.ТекстОшибки = "Не задано ни одного ключевого параметра для печати";
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
		Возврат Print;   	  
	КонецЕсли;	    

    Попытка
		ВидПечатнойФормы = PrintRequest.Print.PrintType;
	Исключение
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "PR02";
		НоваяСтрока.ТекстОшибки = "Не задан вид печатной формы";
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest", PrintRequest, Print, "-1", ТаблицаОщибок);
		Возврат Print;  
	КонецПопытки;   
	Если ВидПечатнойФормы = "1" Тогда
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.ПредварительныйЗН;	
	ИначеЕсли ВидПечатнойФормы = "2" Тогда	
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.РабочийЗН;	
	ИначеЕсли ВидПечатнойФормы = "3" Тогда
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.ФинальныйЗН;		
	ИначеЕсли ВидПечатнойФормы = "4" Тогда		
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.КонтрольКачества;
	ИначеЕсли ВидПечатнойФормы = "5" Тогда
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.АктПриемаПередачи;
	ИначеЕсли ВидПечатнойФормы = "6" Тогда
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.ПодборочныйЛистНаСклад;
	ИначеЕсли ВидПечатнойФормы = "7" Тогда
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.СогласиеНаОбработкуПерсональныхДанных;
	ИначеЕсли ВидПечатнойФормы = "8" Тогда
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.ПередачаДанныхПоНазначеннымСобытиям;
	ИначеЕсли ВидПечатнойФормы = "9" Тогда
		ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.ПередачаФотографий;
	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "PR02";
		НоваяСтрока.ТекстОшибки = "Неверный вид печатной формы";
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest", PrintRequest, Print, "-1", ТаблицаОщибок);
		Возврат Print;  		
	КонецЕсли;
	
	Попытка
		КоличествоЭкземпляров = PrintRequest.Print.CopyNumber;
	Исключение
    	КоличествоЭкземпляров = "1";
	КонецПопытки;    
	
	Попытка
		КодСотрудника = PrintRequest.TransactionHeader.RequestPollingToken;
	Исключение
		КодСотрудника = "";
	КонецПопытки; 
	Если ЗначениеЗаполнено(КодСотрудника) Тогда
		Сотрудник = Справочники.Сотрудники.НайтиПоКоду(КодСотрудника);
		Если Сотрудник.Пустая() Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "WA03";
			НоваяСтрока.ТекстОшибки = "Задан неверный код сотрудника (RequestPollingToken)!";
			Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest", PrintRequest,Print, "-1", ТаблицаОщибок);
			Возврат Print; 					
		КонецЕсли;
	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "WA03";
		НоваяСтрока.ТекстОшибки = "Не задан код сотрудника (RequestPollingToken)!";
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest", PrintRequest,Print, "-1", ТаблицаОщибок);
		Возврат Print; 					
	КонецЕсли;
	
	Попытка
		VHC = PrintRequest.Print.VHC;
	Исключение
    	VHC = Неопределено;       		
	КонецПопытки;  
	
	Если VHC <> Неопределено Тогда
		ЗаписьКруговогоОсмотра = РегистрыСведений.РезультатыКруговогоОсмотра.СоздатьМенеджерЗаписи();
		ЗаписьКруговогоОсмотра.ЗаказНаряд = ЗаказНарядСсылка;
		ДокументОснование = ЗаказНарядСсылка.ДокументОснование;
		Если ЗначениеЗаполнено(ДокументОснование) И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаНаРемонт") Тогда
			ЗаявкаНаРемонтСсылка = ДокументОснование;
		Иначе
			ЗаявкаНаРемонтСсылка = Документы.ЗаявкаНаРемонт.ПустаяСсылка();
		КонецЕсли;
		ЗаписьКруговогоОсмотра.ЗаявкаНаРемонт = ЗаявкаНаРемонтСсылка;
		ЗаписьКруговогоОсмотра.Прочитать();
		Если Не ЗаписьКруговогоОсмотра.Выбран() Тогда
			ЗаписьКруговогоОсмотра.ЗаявкаНаРемонт = ЗаявкаНаРемонтСсылка;
			ЗаписьКруговогоОсмотра.ЗаказНаряд = ЗаказНарядСсылка;
		КонецЕсли;
		
		Попытка
			ЗаписьКруговогоОсмотра.ЗвуковойСигнал = ?(PrintRequest.Print.VHC.InternalInspection.Horn="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = "n";       		
		КонецПопытки;  
        Попытка
			ЗаписьКруговогоОсмотра.СтояночныйТормоз = ?(PrintRequest.Print.VHC.InternalInspection.ParkingBrake="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
	    Попытка
			ЗаписьКруговогоОсмотра.РемниБезопасности = ?(PrintRequest.Print.VHC.InternalInspection.SafetyBelts="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
        Попытка
			ЗаписьКруговогоОсмотра.ОтопительКондиционер = ?(PrintRequest.Print.VHC.InternalInspection.ConditionSystem="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.СтеклоочистителиОмыватели = ?(PrintRequest.Print.VHC.InternalInspection.WipersWashers="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;  		
		Попытка
			ЗаписьКруговогоОсмотра.УровеньТоплива = PrintRequest.Print.VHC.LevelOfFuelInTank.Value;
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";   			
		КонецПопытки;  		
        Попытка
			ЗаписьКруговогоОсмотра.ВнешниеОсветительныеПриборы = ?(PrintRequest.Print.VHC.ExternalInspection.ExternalLights="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		
        Попытка
			ЗаписьКруговогоОсмотра.ВоздушныйФильтрДвигателя = ?(PrintRequest.Print.VHC.UnderhoodInspection.AirFilter="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
        Попытка
			ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = PrintRequest.Print.VHC.UnderhoodInspection.OilLevelInEngine;
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ПриводныеРемни = ?(PrintRequest.Print.VHC.UnderhoodInspection.DriveBelts="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;    
		Попытка
			ЗаписьКруговогоОсмотра.Трубопроводы = ?(PrintRequest.Print.VHC.UnderhoodInspection.PipelinesLeakage="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.КлеммыАКБ = ?(PrintRequest.Print.VHC.UnderhoodInspection.Battery="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;         	
				
		
		Попытка
			ЗаписьКруговогоОсмотра.РулевоеУправление = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.SteeringSystem="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ПодшипникиСтупицПередних = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.FrontWheelBearings="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ПодшипникиСтупицЗадних = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.RearWheelBearings="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;    
		Попытка
			ЗаписьКруговогоОсмотра.Амортизаторы = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.ShockAbsorbers="g",Истина,Ложь);  
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ТормозныеДискиПередние = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.FrontBrakeDiscs="g",Истина,Ложь);  
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки; 
		Попытка
			ЗаписьКруговогоОсмотра.ТормозныеДискиЗадние = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.RearBrakeDiscs="g",Истина,Ложь);     
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ТормозныеКолодкиПередние = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.FrontBrakePads="g",Истина,Ложь);     
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ТормозныеКолодкиЗадние = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.RearBrakePads="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;    
		Попытка
			ЗаписьКруговогоОсмотра.КолесныеДискиКолпакиШины = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.TyresWheelDiscs="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.СостояниеСотРадиатора = ?(PrintRequest.Print.VHC.VehicleIsPartlyLifted.Radiators="g",Истина,Ложь);   
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;      
					
		Попытка
			ЗаписьКруговогоОсмотра.ШРУСыИПыльники = ?(PrintRequest.Print.VHC.VehicleIsFullyLifted.DriveShafts="g",Истина,Ложь);  
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ПередняяПодвеска = ?(PrintRequest.Print.VHC.VehicleIsFullyLifted.FrontSuspension="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ЗадняяПодвеска = ?(PrintRequest.Print.VHC.VehicleIsFullyLifted.RearSuspension="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;    
		Попытка
			ЗаписьКруговогоОсмотра.СистемаВыпуска = ?(PrintRequest.Print.VHC.VehicleIsFullyLifted.ExhaustSystem="g",Истина,Ложь);  
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.ГерметичностьОтстутствиеПодтеканий = ?(PrintRequest.Print.VHC.VehicleIsFullyLifted.LeakageOfTechnicalLiquids="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки; 
		
		Попытка
			ЗаписьКруговогоОсмотра.ПоврежденияКузова = PrintRequest.Print.VHC.InspectionOfBodyAndWindows.Value;
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки; 
		
        Попытка
			ЗаписьКруговогоОсмотра.ЗапасноеКолесо = ?(PrintRequest.Print.VHC.Complectation.AdditionalWheel="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
        Попытка
			ЗаписьКруговогоОсмотра.ШтатныйНаборИнструментов = ?(PrintRequest.Print.VHC.Complectation.StandardToolkit="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.Домкрат = ?(PrintRequest.Print.VHC.Complectation.Jack="g",Истина,Ложь);    
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки;    
		Попытка
			ЗаписьКруговогоОсмотра.ДорожныйНабор = ?(PrintRequest.Print.VHC.Complectation.Roadkit="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.Аптечка = ?(PrintRequest.Print.VHC.Complectation.FirstAidkit="g",Истина,Ложь); 
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки; 
		Попытка
			ЗаписьКруговогоОсмотра.Пепельница = ?(PrintRequest.Print.VHC.Complectation.Ashtray="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";       		
		КонецПопытки;  
		Попытка
			ЗаписьКруговогоОсмотра.Прикуриватель = ?(PrintRequest.Print.VHC.Complectation.CigaretteLighter="g",Истина,Ложь);
		Исключение
			//СтрокаОтметок = СтрокаОтметок + ";" + "n";    		
		КонецПопытки; 

        Попытка
			ЗаписьКруговогоОсмотра.ОхранныеСистемыСБлокировкойЗапускаДвигателя = ?(PrintRequest.Print.VHC.AdditionalEquipment.SecuritySystemWithEngineImmobilizer="g",Истина,Ложь);
