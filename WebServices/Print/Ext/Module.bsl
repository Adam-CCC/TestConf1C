						НоваяСтрока = ТаблицаОщибок.Добавить();
						НоваяСтрока.Код = "WA03";
						НоваяСтрока.ТекстОшибки = "Внешняя печатная форма не загружена в базу или файл не указан";
						Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
						Возврат Print; 			
					КонецЕсли;
					
				Иначе
					НоваяСтрока = ТаблицаОщибок.Добавить();
					НоваяСтрока.Код = "WA03";
					НоваяСтрока.ТекстОшибки = "Не найдена внешняя печатная форма";
					Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
					Возврат Print; 			
				КонецЕсли;
				Попытка
					ТабДок.Записать(ИмяФайлаПечатнойФормы, ТипФайлаТабличногоДокумента.PDF);
				Исключение
					НоваяСтрока = ТаблицаОщибок.Добавить();
					НоваяСтрока.Код = "WA03";
					НоваяСтрока.ТекстОшибки = "Не удалось сохранить макет печатной формы на сервере";
					Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
					Возврат Print; 			
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;    		
		
	ИначеЕсли ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.СогласиеНаОбработкуПерсональныхДанных  Тогда
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "WA03";
		НоваяСтрока.ТекстОшибки = "Распечатать согласие на обработку персональных данных можно только из карточки Контрагента!";
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
		Возврат Print; 			
		
	ИначеЕсли ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.ПередачаДанныхПоНазначеннымСобытиям Тогда
	    Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"1",ТаблицаОщибок);
		Возврат Print; 

	ИначеЕсли ПечатнаяФорма = Перечисления.НазванияПечатныхФорм.ПередачаФотографий Тогда
	    Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"1",ТаблицаОщибок);
		Возврат Print; 		
	КонецЕсли;
	
	ИмяФайлаPostScript = ПолучитьИмяВременногоФайла("ps");
	КодВозврата = 0;
	ИмяФайлаGhostScript = "C:\Program Files\gs\gs9.55.0\bin\gswin64.exe";
	ЗапуститьПриложение(ИмяФайлаGhostScript + " -sDEVICE=pxlcolor -o " + ИмяФайлаPostScript + " " + ИмяФайлаПечатнойФормы, 
						КаталогВременныхФайлов(), Истина, КодВозврата);
	Если КодВозврата <> 0 Тогда
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "WA03";
		НоваяСтрока.ТекстОшибки = "Приложение GhostScript завершилось с ошибкой " + Строка(КодВозврата);
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
		Возврат Print; 			
	КонецЕсли;
						
	ИмяПринтера = "";
	КодДилера = PrintRequest.TransactionHeader.DealerID;
	Если КодДилера = "RC294" Тогда
		ИмяПринтера = Константы.waПринтерДляДилераRC294.Получить();
	ИначеЕсли КодДилера = "RC536" Тогда
		ИмяПринтера = Константы.waПринтерДляДилераRC445.Получить();
	КонецЕсли;				
	Если обЗначениеНеЗаполнено(ИмяПринтера) Тогда
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "WA03";
		НоваяСтрока.ТекстОшибки = "В настройках параметров 1С не задано имя принтера для " + КодДилера;
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
		Возврат Print; 			
	КонецЕсли;
	
	Попытка
		ФТП = Новый FTPСоединение(ИмяПринтера, 21, "anonymous", "anonymous");
		ФТП.Записать(ИмяФайлаPostScript, "WA");	
	Исключение
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "WA03";
		НоваяСтрока.ТекстОшибки = "Не удалось подключитьсч к FTP-серверу " + ИмяПринтера;
		Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"-1",ТаблицаОщибок);
		Возврат Print; 			
	КонецПопытки;
	
    Print = обПолучитьВозвратWAError("http://wa.dms.webservice/PrintRequest",PrintRequest,Print,"1",ТаблицаОщибок);
	Возврат Print; 

КонецФункции
