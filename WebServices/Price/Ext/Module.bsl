
Функция PriceCheck(PriceCheckRequest)
	// Вставить содержимое обработчика.
	PriceCheckType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PriceCheckRequest", "PriceCheckResponse");
	PriceCheck = ФабрикаXDTO.Создать(PriceCheckType);   
	
	ТаблицаОщибок = Новый ТаблицаЗначений;
	ТаблицаОщибок.Колонки.Добавить("Код",	 Новый ОписаниеТипов("Строка"));
	ТаблицаОщибок.Колонки.Добавить("ТекстОшибки",		 Новый ОписаниеТипов("Строка"));
	
	////////////////////////////////////////////////////	
	//ResultMessageDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PriceCheckRequest", "ResultMessage");
	//ResultMessageData = ФабрикаXDTO.Создать(ResultMessageDataType); 	
	//TransactionHeaderDataType = ФабрикаXDTO.Тип("http://wa.dms.webservice/PriceCheckRequest", "TransactionHeader");
	//TransactionHeaderData = ФабрикаXDTO.Создать(TransactionHeaderDataType);
	//TransactionHeaderData = PriceCheckRequest.TransactionHeader;      
	//ResultMessageData.Code = "-1";
	//ResultMessageData.Message = "Данная функция не поддерживается текущей версией обмена с WA"; 
	//
	//PriceCheck.ResultMessage = ResultMessageData;  	
	//PriceCheck.TransactionHeader = TransactionHeaderData;  
	//Возврат PriceCheck;
	////////////////////////////////////////////////////
	
    Попытка
		НомерЗаказНаряда = PriceCheckRequest.PriceCheck.DMSRONo;
	Исключение
		НомерЗаказНаряда = "";	    
	КонецПопытки;   	
	Попытка
		IDЗаказНаряда = PriceCheckRequest.PriceCheck.DMSROID;
	Исключение
		IDЗаказНаряда = "";
	КонецПопытки;  
	
	Если ЗначениеЗаполнено(IDЗаказНаряда) Тогда
		Попытка
			ID = Новый УникальныйИдентификатор(IDЗаказНаряда);
		Исключение
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PC01";
			НоваяСтрока.ТекстОшибки = "Некорректный ID Заказ-наряда";
			PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
			Возврат PriceCheck;  	
		КонецПопытки;
		ЗаказНарядСсылка = Документы.ЗаказНаряд.ПолучитьСсылку(ID);
	ИначеЕсли ЗначениеЗаполнено(НомерЗаказНаряда) Тогда
		ЗаказНарядСсылка = Документы.ЗаказНаряд.НайтиПоНомеру(НомерЗаказНаряда, ТекущаяДата());
    	Если обЗначениеНеЗаполнено(ЗаказНарядСсылка) Тогда		
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PC01";
			НоваяСтрока.ТекстОшибки = "Заказ-наряд с указанным номером не найден";
			PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
			Возврат PriceCheck;    
		КонецЕсли;		
	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "PC01";
		НоваяСтрока.ТекстОшибки = "Не указаны номер и ID Заказ-наряда";
		PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
		Возврат PriceCheck;   
	КонецЕсли;	
	
	ЗаказНарядОбъект = ЗаказНарядСсылка.ПолучитьОбъект();
	Если ЗаказНарядОбъект = Неопределено Тогда
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "PC01";
		НоваяСтрока.ТекстОшибки = "Заказ-наряд с указанным идентификатором не найден";
		PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
		Возврат PriceCheck;  	
	КонецЕсли;	
	
	// ТАБЛИЦЫ ТОВАРОВ И РАБОТ
	ТаблицаРабот = Новый ТаблицаЗначений;
	ТаблицаРабот.Колонки.Добавить("Code",		 		 Новый ОписаниеТипов("Строка"));
	ТаблицаРабот.Колонки.Добавить("PackageCode",		 Новый ОписаниеТипов("Строка"));
	ТаблицаРабот.Колонки.Добавить("Quantity",			 Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5,2)));
	ТаблицаРабот.Колонки.Добавить("EstimatedHours",		 Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5,2)));
	ТаблицаРабот.Колонки.Добавить("Discount",			 Новый ОписаниеТипов("СправочникСсылка.ТипыСкидок"));  
	ТаблицаРабот.Колонки.Добавить("DiscountRate",	 	 Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)));
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("PartNumber",		Новый ОписаниеТипов("Строка"));
	ТаблицаТоваров.Колонки.Добавить("PackageCode",		Новый ОписаниеТипов("Строка"));
	ТаблицаТоваров.Колонки.Добавить("Quantity",			Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5,2)));
	ТаблицаТоваров.Колонки.Добавить("Discount",		 	Новый ОписаниеТипов("СправочникСсылка.ТипыСкидок"));  
	ТаблицаТоваров.Колонки.Добавить("DiscountRate",	 	Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,2)));
	
	ТаблицаТоваровКлиента = Новый ТаблицаЗначений;
	ТаблицаТоваровКлиента.Колонки.Добавить("PartNumber",		Новый ОписаниеТипов("Строка"));
	ТаблицаТоваровКлиента.Колонки.Добавить("PartDescription",	Новый ОписаниеТипов("Строка"));
	ТаблицаТоваровКлиента.Колонки.Добавить("Quantity",			Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5,2)));
	ТаблицаТоваровКлиента.Колонки.Добавить("UnitOfMeasure",		Новый ОписаниеТипов("Строка"));
	ТаблицаТоваровКлиента.Колонки.Добавить("Comment",			Новый ОписаниеТипов("Строка"));
	
	Попытка
		МассивРабот = PriceCheckRequest.PriceCheck.OPCodes;    		
	Исключение
		МассивРабот = Неопределено;         		
	КонецПопытки;
	
	Попытка
		МассивТоваровКлиента = PriceCheckRequest.PriceCheck.CustomerParts;    		
	Исключение
		МассивТоваровКлиента = Неопределено;         		
	КонецПопытки;             
	
	Если МассивРабот <> Неопределено Тогда
		Для Каждого СтрокаРабота Из МассивРабот.OpCode Цикл
			Попытка
				Code = СтрокаРабота.Code;
			Исключение
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "PC02";
				НоваяСтрока.ТекстОшибки = "Отсутствует код автоработы";
				PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
				Возврат PriceCheck;  
			КонецПопытки; 		
			
			Если Code = "OP_Part" Тогда // Товары 						
				Попытка
					МассивТоваров = СтрокаРабота.Parts;  
				Исключение
					МассивТоваров = Неопределено;
				КонецПопытки;
				
				Если МассивТоваров <> Неопределено Тогда    							
					Для Каждого СтрокаНоменклатура Из МассивТоваров.Part Цикл
						НоваяСтрокаНоменклатура = ТаблицаТоваров.Добавить();
						Попытка
							НоваяСтрокаНоменклатура.PartNumber = СтрокаНоменклатура.PartNumber;
						Исключение
							НоваяСтрока = ТаблицаОщибок.Добавить();
							НоваяСтрока.Код = "PC03";
							НоваяСтрока.ТекстОшибки = "Отсутствует артикул номенклатуры";
							PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
							Возврат PriceCheck;   
						КонецПопытки;						
						Если обЗначениеНеЗаполнено(НоваяСтрокаНоменклатура.PartNumber) Тогда
							НоваяСтрока = ТаблицаОщибок.Добавить();
							НоваяСтрока.Код = "PC03";
							НоваяСтрока.ТекстОшибки = "Передан пустой артикул номенклатуры";
							PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
							Возврат PriceCheck;    
						КонецЕсли;
						
                        Попытка
							НоваяСтрокаНоменклатура.Quantity = Число(СтрокаНоменклатура.Quantity);
							НоваяСтрокаНоменклатура.PackageCode = СтрокаНоменклатура.PackageCode; // NEW PHASE 4
						Исключение
						КонецПопытки;
						Попытка
							DiscountRate = Число(СтрокаНоменклатура.PriceType.DiscountRate); 
							Если DiscountRate > 0 Тогда 
								Запрос = Новый Запрос;
								Запрос.Текст = "ВЫБРАТЬ
								               |	СкидкиСтрокиСрезПоследних.Скидка,
								               |	СкидкиСтрокиСрезПоследних.ЗначениеСкидки
								               |ИЗ
								               |	РегистрСведений.СкидкиСтроки.СрезПоследних(
								               |			,
								               |			ЗначениеСкидки = &ПроцентСкидки
								               |				И Подразделение = &Подразделение
								               |				И СкидкаНаТовары = ИСТИНА
								               |				И РучнаяСкидка = ИСТИНА) КАК СкидкиСтрокиСрезПоследних";
											   
								Запрос.Параметры.Вставить("ПроцентСкидки", DiscountRate);
								Запрос.Параметры.Вставить("Подразделение", ЗаказНарядОбъект.ПодразделениеКомпании);
								ВыборкаСкидок = Запрос.Выполнить().Выбрать();
								Если ВыборкаСкидок.Количество()=0 Тогда  							
									НоваяСтрока = ТаблицаОщибок.Добавить();
									НоваяСтрока.Код = "PC04";
									НоваяСтрока.ТекстОшибки = "Скидка на товары " + СтрокаНоменклатура.PriceType.DiscountRate + "% не зарегистрирована либо не назначена";
									PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
									Возврат PriceCheck;   
								Иначе
									ВыборкаСкидок.Следующий();
									НоваяСтрокаНоменклатура.Discount = ВыборкаСкидок.Скидка;
									НоваяСтрокаНоменклатура.DiscountRate = ВыборкаСкидок.ЗначениеСкидки;
								КонецЕсли;    
							КонецЕсли;
						Исключение
						КонецПопытки;
					КонецЦикла;   							
				КонецЕсли;
				
           Иначе // Работы 				
				НоваяСтрокаРабота = ТаблицаРабот.Добавить();
				НоваяСтрокаРабота.Code = Code;
				Если обЗначениеНеЗаполнено(НоваяСтрокаРабота.Code) Тогда
					НоваяСтрока = ТаблицаОщибок.Добавить();
					НоваяСтрока.Код = "PC02";
					НоваяСтрока.ТекстОшибки = "Не задан код автоработы";
					PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
					Возврат PriceCheck;   
				КонецЕсли;
	            Попытка
					НоваяСтрокаРабота.Quantity = Число(СтрокаРабота.Quantity); 	
					НоваяСтрокаРабота.EstimatedHours = Число(СтрокаРабота.EstimatedHours); 	
					НоваяСтрокаРабота.PackageCode = СтрокаРабота.PackageCode; // NEW PHASE 4
				Исключение
				КонецПопытки;
	          	Попытка
					DiscountRate = Число(СтрокаРабота.PriceType.DiscountRate); 
					Если DiscountRate > 0 Тогда 
						Запрос = Новый Запрос;
						Запрос.Текст = "ВЫБРАТЬ
						               |	СкидкиСтрокиСрезПоследних.Скидка,
						               |	СкидкиСтрокиСрезПоследних.ЗначениеСкидки
						               |ИЗ
						               |	РегистрСведений.СкидкиСтроки.СрезПоследних(
						               |			,
						               |			ЗначениеСкидки = &ПроцентСкидки
								       |				И Подразделение = &Подразделение
						               |				И СкидкаНаРаботы = ИСТИНА
						               |				И РучнаяСкидка = ИСТИНА) КАК СкидкиСтрокиСрезПоследних
						               |
						               |УПОРЯДОЧИТЬ ПО
						               |	СкидкиСтрокиСрезПоследних.Период УБЫВ";   
									   
						Запрос.Параметры.Вставить("ПроцентСкидки", DiscountRate);
						Запрос.Параметры.Вставить("Подразделение", ЗаказНарядОбъект.ПодразделениеКомпании);
						ВыборкаСкидок = Запрос.Выполнить().Выбрать();
						Если ВыборкаСкидок.Количество()=0 Тогда  							
							НоваяСтрока = ТаблицаОщибок.Добавить();
							НоваяСтрока.Код = "PC04";
							НоваяСтрока.ТекстОшибки = "Скидка на работы " + СтрокаРабота.PriceType.DiscountRate + "% не зарегистрирована либо не назначена";
							PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
							Возврат PriceCheck;  
						Иначе
							ВыборкаСкидок.Следующий();
							НоваяСтрокаРабота.Discount = ВыборкаСкидок.Скидка;
							НоваяСтрокаРабота.DiscountRate = ВыборкаСкидок.ЗначениеСкидки;        
						КонецЕсли;  
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	 
	
	// NEW PHASE 4
	Если МассивТоваровКлиента <> Неопределено Тогда
		Для Каждого СтрокаНоменклатура Из МассивТоваровКлиента.CustomerPart Цикл
			НоваяСтрокаТоварКлиента = ТаблицаТоваровКлиента.Добавить();
			Попытка
				НоваяСтрокаТоварКлиента.PartNumber = СтрокаНоменклатура.PartNumber;
			Исключение
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "PC03";
				НоваяСтрока.ТекстОшибки = "Отсутствует артикул запасной части клиента";
				PriceCheck = ПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
				Возврат PriceCheck;   
			КонецПопытки;
			Если обЗначениеНеЗаполнено(НоваяСтрокаТоварКлиента.PartNumber) Тогда
				НоваяСтрока = ТаблицаОщибок.Добавить();
				НоваяСтрока.Код = "PC03";
				НоваяСтрока.ТекстОшибки = "Передан пустой артикул запасной части клиента";
				PriceCheck = ПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
				Возврат PriceCheck;    
			КонецЕсли;
            Попытка
				НоваяСтрокаТоварКлиента.Quantity = Число(СтрокаНоменклатура.Quantity); 	
			Исключение
			КонецПопытки;
			НоваяСтрокаТоварКлиента.PartDescription = СтрокаНоменклатура.PartDescription;
			НоваяСтрокаТоварКлиента.UnitOfMeasure = СтрокаНоменклатура.UnitOfMeasure;
			НоваяСтрокаТоварКлиента.Comment = СтрокаНоменклатура.Comment;
         КонецЦикла;
	КонецЕсли;
	
	// Перерасчёт в объекте заказ-наряд
	СтараяТаблицаРабот = ЗаказНарядОбъект.Работы.Выгрузить(, "Работа");
	Для Каждого СтрокаРаботы Из ТаблицаРабот Цикл
		РаботаСсылка = Справочники.Автоработы.НайтиПоКоду(СтрокаРаботы.Code);
		Если обЗначениеНеЗаполнено(РаботаСсылка) Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "PC02";
			НоваяСтрока.ТекстОшибки = "Авторабота с кодом " + СтрокаРаботы.Code + " не найдена";
			PriceCheck = обПолучитьВозвратWAError("http://wa.dms.webservice/PriceCheckRequest",PriceCheckRequest,PriceCheck,"-1",ТаблицаОщибок);
			Возврат PriceCheck; 
		Иначе
			СтрокаВЗаявке = ЗаказНарядОбъект.Работы.Найти(РаботаСсылка, "Работа");
			Если СтрокаВЗаявке = Неопределено Тогда
				СтрокаВЗаявке = ЗаказНарядОбъект.Работы.Добавить();
				СтрокаВЗаявке.Основная = Ложь;			
				СтрокаВЗаявке.Работа = РаботаСсылка;
				СтрокаВЗаявке.ИдентификаторРаботы = Новый УникальныйИдентификатор;
				ЗаказНарядОбъект.ОбработкаРеквизита("Работы.Работа", СтрокаВЗаявке);   
			Иначе
				СтрокаВоВременнойТаблице = СтараяТаблицаРабот.Найти(РаботаСсылка, "Работа");
				СтараяТаблицаРабот.Удалить(СтрокаВоВременнойТаблице);
			КонецЕсли;
			Если СтрокаРаботы.EstimatedHours > 0 Тогда
				СтрокаВЗаявке.Коэффициент = СтрокаРаботы.EstimatedHours;
				ЗаказНарядОбъект.ОбработкаРеквизита("Работы.Коэффициент", СтрокаВЗаявке); 
			КонецЕсли;
			Если СтрокаРаботы.Quantity > 0 Тогда
				СтрокаВЗаявке.Количество = СтрокаРаботы.Quantity;
				ЗаказНарядОбъект.ОбработкаРеквизита("Работы.Количество", СтрокаВЗаявке); 
			КонецЕсли;
           	Если ЗначениеЗаполнено(СтрокаРаботы.Discount) И СтрокаРаботы.DiscountRate <> СтрокаВЗаявке.ПроцентСкидки Тогда
				СтрокаВЗаявке.ПроцентСкидки = СтрокаРаботы.DiscountRate;   
				СтрокаВЗаявке.СкидкаНаТовар = СтрокаРаботы.Discount;
				
				ОбработкаРасчетСкидокАвторабот = ЗаказНарядОбъект["ОбработкаРасчетСкидокАвторабот"];

				ОбработкаРасчетСкидокАвторабот.ПодобратьСтрочнуюСкидку(ЗаказНарядОбъект, СтрокаВЗаявке);
				СтрокаВЗаявке.СкидкаНаТовар  = ОбработкаРасчетСкидокАвторабот.ТекущаяСкидкаСтроки;
				СтрокаВЗаявке.ПроцентСкидкиСтроки = ОбработкаРасчетСкидокАвторабот.ТекущийПроцентСкидкиСтроки;
				СтрокаВЗаявке.СуммаСкидкиСтроки = ОбработкаРасчетСкидокАвторабот.ТекущаяСуммаСкидкиСтроки;

				СуммаИтого = 0;				
