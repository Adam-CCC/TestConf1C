
Функция OpCodeGet(OPCodeGetRequest)
	// в запросе передаётся: DMSROID, DMSRONo, Model код модели) и Description (строка поиска)
	OpCodeGetType = ФабрикаXDTO.Тип("http://wa.dms.webservice/OPCodeGetRequest", "OPCodeGetResponse");
	OpCodeGet = ФабрикаXDTO.Создать(OpCodeGetType);   
	
	ТаблицаОщибок = Новый ТаблицаЗначений;
	ТаблицаОщибок.Колонки.Добавить("Код",	 Новый ОписаниеТипов("Строка"));
	ТаблицаОщибок.Колонки.Добавить("ТекстОшибки",		 Новый ОписаниеТипов("Строка"));
	
    Попытка
		НомерЗаказНаряда = OPCodeGetRequest.OPCodeGet.DMSRONo;
	Исключение
		НомерЗаказНаряда = "";
	КонецПопытки;       
	Попытка
		IDЗаказНаряда = OPCodeGetRequest.OPCodeGet.DMSROID;
	Исключение
		IDЗаказНаряда = "";
	КонецПопытки; 
	Если ЗначениеЗаполнено(IDЗаказНаряда) Тогда
		Попытка
			ID = Новый УникальныйИдентификатор(IDЗаказНаряда);
		Исключение
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "OCG01";
			НоваяСтрока.ТекстОшибки = "Некорректный ID Заказ-наряда";
			OPCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"-1",ТаблицаОщибок);
			Возврат OPCodeGet;  		
		КонецПопытки;		
		ЗаказНарядСсылка = Документы.ЗаказНаряд.ПолучитьСсылку(ID);
    	Если ЗаказНарядСсылка.ПолучитьОбъект() = Неопределено Тогда		
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "OCG01";
			НоваяСтрока.ТекстОшибки = "Заказ-наряд с указанным идентификатором не найден";
			OPCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"-1",ТаблицаОщибок);
			Возврат OPCodeGet;  		
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(НомерЗаказНаряда) Тогда
		ЗаказНарядСсылка = Документы.ЗаказНаряд.НайтиПоНомеру(НомерЗаказНаряда, ТекущаяДата());
    	Если обЗначениеНеЗаполнено(ЗаказНарядСсылка) Тогда		
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "OCG01";
			НоваяСтрока.ТекстОшибки = "Заказ-наряд с указанным номером не найден";
			OPCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"-1",ТаблицаОщибок);
			Возврат OPCodeGet;  		
		КонецЕсли;		
	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "OCG01";
		НоваяСтрока.ТекстОшибки = "Не указаны номер и ID Заказ-наряда";
		OPCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"-1",ТаблицаОщибок);
		Возврат OPCodeGet;  		
	КонецЕсли;
	
	Попытка
		ОписаниеРаботы = OPCodeGetRequest.OPCodeGet.Description;
	Исключение
		ОписаниеРаботы = "";
	КонецПопытки;     	
	Если ЗначениеЗаполнено(ОписаниеРаботы) Тогда
		Если СтрДлина(ОписаниеРаботы) < 3 Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "OCG02";
			НоваяСтрока.ТекстОшибки = "Для поиска по фрагменту описания работы должно быть не менее 3 символов";
			OPCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"-1",ТаблицаОщибок);
			Возврат OPCodeGet;   
		КонецЕсли;    
	КонецЕсли;
	
    Попытка
		МодельКод = OPCodeGetRequest.OPCodeGet.Model; // код модели автомобиля
	Исключение
		МодельКод = "";
	КонецПопытки;
	Если ЗначениеЗаполнено(МодельКод) Тогда
		//МодельСсылка = Справочники.Модели.НайтиПоКоду("ЦБ00003644/" + МодельКод, Истина);
		ГруппаХендэ = Справочники.Модели.НайтиПоКоду("ЦБ00003644");
		Если ЗначениеЗаполнено(ГруппаХендэ) Тогда
			МодельСсылка = Справочники.Модели.НайтиПоРеквизиту("КодМодели", МодельКод, ГруппаХендэ);
		Иначе
			МодельСсылка = Справочники.Модели.НайтиПоРеквизиту("КодМодели", МодельКод);
		КонецЕсли;
		//Если обЗначениеНеЗаполнено(МодельСсылка) Тогда
		//	НоваяСтрока = ТаблицаОщибок.Добавить();
		//	НоваяСтрока.Код = "WA03";
		//	НоваяСтрока.ТекстОшибки = "Модель автомобиля с указанным кодом не найдена";
		//	PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"-1",ТаблицаОщибок);
		//	Возврат PackageCodeGet;      
		//КонецЕсли;
	Иначе
		МодельСсылка = Справочники.Модели.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Двигатель = OPCodeGetRequest.OPCodeGet.Engine;
	Исключение
		Двигатель = "";
	КонецПопытки;   		
	//Если ЗначениеЗаполнено(Двигатель) Тогда 
	//	ДвигательСсылка = Справочники.ТипыДвигателей.НайтиПоКоду(Двигатель);
	//	Если обЗначениеНеЗаполнено(ДвигательСсылка) Тогда
	//		НоваяСтрока = ТаблицаОщибок.Добавить();
	//		НоваяСтрока.Код = "WA03";
	//		НоваяСтрока.ТекстОшибки = "Некорректный код типа двигателя";
	//		PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"-1",ТаблицаОщибок);
	//		Возврат PackageCodeGet;      
	//	КонецЕсли;       
	//КонецЕсли;     
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("ОписаниеРаботы", "%" + ОписаниеРаботы + "%");
	Если ЗначениеЗаполнено(МодельСсылка) Тогда
		Запрос.Параметры.Вставить("МодельСсылка", МодельСсылка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	АвтоработыНормыВремени.Ссылка КАК Ссылка,
		               |	АвтоработыНормыВремени.Ссылка.Код КАК Код,
		               |	АвтоработыНормыВремени.Ссылка.Артикул КАК Артикул,
		               |	АвтоработыНормыВремени.Ссылка.Наименование КАК Наименование,
		               |	АвтоработыНормыВремени.ВремяВыполнения КАК ВремяВыполнения
		               |ИЗ
		               |	Справочник.Автоработы.НормыВремени КАК АвтоработыНормыВремени
		               |ГДЕ
		               |	АвтоработыНормыВремени.Модель = &МодельСсылка
		               |	И АвтоработыНормыВремени.ВремяВыполнения > 0
					   |	" + ?(ЗначениеЗаполнено(ОписаниеРаботы), "И АвтоработыНормыВремени.Ссылка.Наименование ПОДОБНО &ОписаниеРаботы", "");
		
	ИначеЕсли ЗначениеЗаполнено(ОписаниеРаботы) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	Автоработы.Ссылка КАК Ссылка,
		               |	Автоработы.Код КАК Код,
		               |	Автоработы.Артикул КАК Артикул,
		               |	Автоработы.Наименование КАК Наименование,
		               |	Автоработы.ВремяВыполнения КАК ВремяВыполнения
		               |ИЗ
		               |	Справочник.Автоработы КАК Автоработы
		               |ГДЕ
		               |	Автоработы.ВремяВыполнения > 0
		               |	И НЕ Автоработы.ЭтоГруппа
		               |	И Автоработы.Наименование ПОДОБНО &ОписаниеРаботы";
	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "WA03";
		НоваяСтрока.ТекстОшибки = "Не задано ни одного параметра для поиска!";
		PackageCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest", OPCodeGetRequest, OPCodeGet, "-1", ТаблицаОщибок);
		Возврат PackageCodeGet;      
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Количество()=0 Тогда                         		
		OPCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest", OPCodeGetRequest, OPCodeGet, "0", ТаблицаОщибок);
		Возврат OPCodeGet;  
	Иначе   		
		OpCodesType = ФабрикаXDTO.Тип("http://wa.dms.webservice/OPCodeGetRequest", "ArrayOfOPCode");
		OpCodes = ФабрикаXDTO.Создать(OpCodesType); 	
		OPCodeType = ФабрикаXDTO.Тип("http://wa.dms.webservice/OPCodeGetRequest", "OPCode");     		
		Пока Выборка.Следующий() Цикл
			OpCode = ФабрикаXDTO.Создать(OPCodeType); 
			OpCode.Code = Выборка.Код;
			OpCode.Description = Выборка.Наименование;
			OpCode.OPCodeType = ?(обЗначениеНеЗаполнено(Выборка.Артикул),"2","1");
			OpCode.DisplayOPCode = Выборка.Код;
			OpCode.DisplayOPDescription = Выборка.Наименование;
			OpCode.Make = "";
			OpCode.Model = "";			
			OpCode.Engine = "";
			OpCode.Year = "";
			OpCode.Mileage = "";
			OpCode.Period = "";
			OpCode.DefLinePaymentMethod = "";
			OpCode.CorrectionLOP = "";
			OpCode.SkillLevel = "";			
			OpCode.HazardMaterialCharge = "";
			
			ВремяВыполнения = Выборка.ВремяВыполнения;
			OpCode.EstimatedHours = Формат(ВремяВыполнения,"ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");
			OpCode.PredefinedCauseDescription = "";
			OpCode.CPSIND = "";  	
			OpCode.MandatoryYN = "";
			
			PriceType = ФабрикаXDTO.Тип("http://wa.dms.webservice/OPCodeGetRequest", "PriceType");
			Price = ФабрикаXDTO.Создать(PriceType);
			Если ЗначениеЗаполнено(МодельСсылка) Тогда
				НормочасЦенаСтр = орПолучитьЦенуАвтоработы(Справочники.ТипыЦен.ОсновнойТипЦенПродажи, Выборка.Ссылка,
					МодельСсылка, ЗаказНарядСсылка.ДоговорВзаиморасчетов, ЗаказНарядСсылка.Цех, ЗаказНарядСсылка.ВидРемонта);	
				НормочасЦена = НормочасЦенаСтр.Цена;       				
				Price.UnitPrice = Формат(НормочасЦена*ВремяВыполнения,"ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
				Price.TotalPrice = Формат(НормочасЦена*ВремяВыполнения,"ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
				Price.TotalPriceIncludeTax = Формат(НормочасЦена*ВремяВыполнения,"ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
				Price.DiscountRate = "0";
				Price.DiscountPrice = "0";  
			КонецЕсли;          
			OpCode.PriceType = Price;
			
			PartsType = ФабрикаXDTO.Тип("http://wa.dms.webservice/OPCodeGetRequest", "ArrayOfPart");
			Parts = ФабрикаXDTO.Создать(PartsType);

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	СвязанныеРаботы.Авторабота,
			               |	СвязанныеРаботы.СвязаннаяРабота,
			               |	СвязанныеРаботы.Количество
			               |ИЗ
			               |	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
			               |ГДЕ
			               |	СвязанныеРаботы.Авторабота = &Работа
			               |	И ТИПЗНАЧЕНИЯ(СвязанныеРаботы.СвязаннаяРабота) = ТИП(Справочник.Номенклатура)";
			
			Запрос.Параметры.Вставить("Работа", Выборка.Ссылка);
			Выб = Запрос.Выполнить().Выбрать();
			Если Выб.Количество() > 0 Тогда
				Пока Выб.Следующий() Цикл
					Номенклатура = Выб.СвязаннаяРабота;
					PartType = ФабрикаXDTO.Тип("http://wa.dms.webservice/OPCodeGetRequest", "Part");
					Part = ФабрикаXDTO.Создать(PartType);
					Part.Manufacturer = "";
					Part.PartNumber = Номенклатура.Артикул; 
					Part.PartDescription = Номенклатура.Наименование; 
					Part.Make = "";
					Part.PartStatus = ""; 
					Part.PartType = ?(Номенклатура.Код = Номенклатура.Артикул, "2", "1");
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ВЫБОР
					               |		КОГДА ОстаткиТоваровКомпанииОстатки.КоличествоОстаток ЕСТЬ NULL
					               |			ТОГДА 0
					               |		ИНАЧЕ ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ЕСТЬNULL(ОстаткиТоваровКомпанииОстатки.РезервОстаток, 0)
					               |	КОНЕЦ КАК СвободныйОстаток,
					               |	ЦеныСрезПоследних.Цена КАК Цена
					               |ИЗ
					               |	РегистрСведений.Цены.СрезПоследних(
					               |			,
					               |			Номенклатура = &Номенклатура
					               |				И ПодразделениеКомпании = &Подразделение
					               |				И ТипЦен = &ТипЦен) КАК ЦеныСрезПоследних
					               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
					               |				,
					               |				СкладКомпании.Подразделение = &Подразделение
					               |					И Номенклатура = &Номенклатура) КАК ОстаткиТоваровКомпанииОстатки
					               |		ПО ЦеныСрезПоследних.Номенклатура = ОстаткиТоваровКомпанииОстатки.Номенклатура";
																							 
					Запрос.Параметры.Вставить("ТипЦен", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
					Запрос.Параметры.Вставить("Номенклатура", Номенклатура);
					Запрос.Параметры.Вставить("Подразделение", ЗаказНарядСсылка.ПодразделениеКомпании);

					Выбор = Запрос.Выполнить().Выбрать();
					Если Выбор.Следующий() Тогда
						UnitPrice = Выбор.Цена;
						Part.QuantityOnHand = Формат(Выбор.СвободныйОстаток, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0");
						Part.StockQuantity = ?(Выбор.СвободныйОстаток > 0, "Y", "N");
						//Part.StockStatus = Формат(Выбор.СвободныйОстаток - Выбор.ЗначениеРеквизита, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0");					
						Part.StockStatus = Формат(Выбор.СвободныйОстаток, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0");					
					Иначе        		
						UnitPrice = 0;
						Part.QuantityOnHand = "0";
						Part.StockQuantity = "N";
						Part.StockStatus = "";
					КонецЕсли;  					
		
					Part.DisplayPartNumber = Номенклатура.Артикул; 
					Part.Remarks = "";    					
					Part.UnitOfMeasure = Номенклатура.ОсновнаяЕдиницаИзмерения.Наименование;
					Part.Quantity = Формат(Выб.Количество, "ЧЦ=7; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0");
					Part.ServiceType = ""; 
					Part.DisplayRemarks = "";
					Part.MandatoryYN = "";  
					
					PriceType = ФабрикаXDTO.Тип("http://wa.dms.webservice/OPCodeGetRequest", "PriceType");
					Price = ФабрикаXDTO.Создать(PriceType);
					//UnitPrice = обПолучитьЦену(Справочники.ТипыЦен.НайтиПоКоду("ЦБ000005"), Номенклатура);
					//Если обЗначениеНеЗаполнено(UnitPrice) Тогда
					//	UnitPrice = обПолучитьЦену(Справочники.ТипыЦен.ОсновнойТипЦенПродажи, Номенклатура);
					//КонецЕсли;   						
					Price.UnitPrice = Формат(UnitPrice, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=");
					Price.TotalPrice = Формат(UnitPrice * Выб.Количество, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=");
					Price.TotalPriceIncludeTax = Формат(UnitPrice * Выб.Количество, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=");
					Price.DiscountRate = "0";
					Price.DiscountPrice = "0";  
					         
					Part.PriceType = Price;   							
                    Parts.Part.Добавить(Part);
				КонецЦикла;   
			КонецЕсли;			   
			OpCode.Parts = Parts;			
			OpCodes.OpCode.Добавить(OpCode);
		КонецЦикла;
    КонецЕсли;    		

    OpCodeGet.OpCodes = OpCodes;
	OPCodeGet = обПолучитьВозвратWAError("http://wa.dms.webservice/OPCodeGetRequest",OPCodeGetRequest,OPCodeGet,"1",ТаблицаОщибок);
	Возврат OPCodeGet; 
КонецФункции
