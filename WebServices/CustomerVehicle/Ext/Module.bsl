
Функция CustomerVehicleGet(CustomerVehicleGetRequest)
	// Вставить содержимое обработчика.
	CustomerVehicleGetType = ФабрикаXDTO.Тип("http://wa.dms.webservice/CustomerVehicleGetRequest", "CustomerVehicleGetResponse");
	CustomerVehicleGet = ФабрикаXDTO.Создать(CustomerVehicleGetType);   
	
	ТаблицаОщибок = Новый ТаблицаЗначений;
	ТаблицаОщибок.Колонки.Добавить("Код",	 Новый ОписаниеТипов("Строка"));
	ТаблицаОщибок.Колонки.Добавить("ТекстОшибки",		 Новый ОписаниеТипов("Строка"));
    	
	CustomersType = ФабрикаXDTO.Тип("http://wa.dms.webservice/CustomerVehicleGetRequest", "ArrayOfCustomerVehicle");
	Customers = ФабрикаXDTO.Создать(CustomersType); 	
	Попытка
		НомерКонтрагент = CustomerVehicleGetRequest.CustomerVehicleGet.CustomerGet.DMSCustomerNo;
	Исключение
		НомерКонтрагент = "";
	КонецПопытки;
	Попытка
		ФамилияКонтрагент = CustomerVehicleGetRequest.CustomerVehicleGet.CustomerGet.LastName;
	Исключение
		ФамилияКонтрагент = "";
	КонецПопытки;                                  	
	Если ЗначениеЗаполнено(ФамилияКонтрагент) Тогда
		Если СтрДлина(ФамилияКонтрагент) < 3 Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "CVG01";
			НоваяСтрока.ТекстОшибки = "Для поиска по фамилии должно быть не менее 3 символов";
			CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"-1",ТаблицаОщибок);
			Возврат CustomerVehicleGet;  	
		КонецЕсли;     
	КонецЕсли;       
	
	Попытка
		ЭлПочтаКонтрагент = CustomerVehicleGetRequest.CustomerVehicleGet.CustomerGet.Email;
	Исключение
		ЭлПочтаКонтрагент = "";
	КонецПопытки;
	Если ЗначениеЗаполнено(ЭлПочтаКонтрагент) Тогда
		Если СтрДлина(ЭлПочтаКонтрагент)<3 Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "CVG02";
			НоваяСтрока.ТекстОшибки = "Для поиска по эл. почте должно быть не менее 3 символов";
			CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"-1",ТаблицаОщибок);
			Возврат CustomerVehicleGet;  	
		КонецЕсли;      
	КонецЕсли;   	
	
	Попытка
		МассивКонтактовКонтрагента = CustomerVehicleGetRequest.CustomerVehicleGet.CustomerGet.Contacts;  
		Для Каждого Контакт Из МассивКонтактовКонтрагента.Contact Цикл
			Если Контакт.ContactType = "2" Тогда
				ТелефонФрагмент = Контакт.ContactValue;	 				
			КонецЕсли;
		КонецЦикла; 
	Исключение
		ТелефонФрагмент = ""; 
	КонецПопытки;
	Если ЗначениеЗаполнено(ТелефонФрагмент) Тогда
		Если СтрДлина(ТелефонФрагмент)<4 Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "CVG04";
			НоваяСтрока.ТекстОшибки = "Для поиска по телефону должно быть не менее 4 символов";
			CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"-1",ТаблицаОщибок);
			Возврат CustomerVehicleGet;  	
		КонецЕсли;  
	КонецЕсли;  	
	
	Попытка	
		КодАвтомобиля = CustomerVehicleGetRequest.CustomerVehicleGet.VehicleGet.DMSVehicleNo;
	Исключение
		КодАвтомобиля = "";
	КонецПопытки;
	Попытка
		VINАвтомобиля = CustomerVehicleGetRequest.CustomerVehicleGet.VehicleGet.VIN;
	Исключение
		VINАвтомобиля = "";
	КонецПопытки;
	Если ЗначениеЗаполнено(VINАвтомобиля) Тогда 
		Если СтрДлина(VINАвтомобиля)<>17 Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "CVG05";
			НоваяСтрока.ТекстОшибки = "VIN должно быть равен 17 символам";
			CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"-1",ТаблицаОщибок);
			Возврат CustomerVehicleGet;  
		КонецЕсли; 		
	КонецЕсли;	
	
	Попытка
		ПоследниеСимволыVIN = CustomerVehicleGetRequest.CustomerVehicleGet.VehicleGet.LastSixVIN;
	Исключение
		ПоследниеСимволыVIN = "";
	КонецПопытки;
	Если ЗначениеЗаполнено(ПоследниеСимволыVIN) Тогда
		Если СтрДлина(ПоследниеСимволыVIN)<6 Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "CVG06";
			НоваяСтрока.ТекстОшибки = "Для поиску по фрагменту VIN должно быть не менее 6 символов";
			CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"-1",ТаблицаОщибок);
			Возврат CustomerVehicleGet;   
		КонецЕсли;
	КонецЕсли;
		
	Попытка
		ГосНомерАвтомобиля = CustomerVehicleGetRequest.CustomerVehicleGet.VehicleGet.LicensePlateNo; 
	Исключение
		ГосНомерАвтомобиля = "";
	КонецПопытки;
	Если ЗначениеЗаполнено(ГосНомерАвтомобиля) Тогда
		Если СтрДлина(ГосНомерАвтомобиля)<3 Тогда
			НоваяСтрока = ТаблицаОщибок.Добавить();
			НоваяСтрока.Код = "CVG07";
			НоваяСтрока.ТекстОшибки = "Для поиску по фрагменту гос. номера должно быть не менее 3 символов";
			CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"-1",ТаблицаОщибок);
			Возврат CustomerVehicleGet;   
		КонецЕсли;    
	КонецЕсли;        

	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(НомерКонтрагент) Тогда   		
		Запрос.Текст = "ВЫБРАТЬ
		               |	Контрагенты.Ссылка КАК Контрагент,
		               |	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль
		               |ИЗ
		               |	Справочник.Контрагенты КАК Контрагенты
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(, Автомобиль.Модель В ИЕРАРХИИ (&Hyundai)) КАК АвтомобилиСрезПоследних
		               |		ПО (АвтомобилиСрезПоследних.Значение = Контрагенты.Ссылка)
		               |ГДЕ
		               |	Контрагенты.Код = &КодКонтрагента";
					   
		Запрос.Параметры.Вставить("Hyundai",Справочники.Модели.НайтиПоКоду("ЦБ00003644")); 
		Запрос.Параметры.Вставить("КодКонтрагента",НомерКонтрагент);
		
	ИначеЕсли ЗначениеЗаполнено(VINАвтомобиля) Тогда	                                                                        
		Запрос.Текст = "ВЫБРАТЬ
		               |	Контрагенты.Ссылка КАК Контрагент,
		               |	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль
		               |ИЗ
		               |	РегистрСведений.Автомобили.СрезПоследних(, ВидЗначения = &Хозяин) КАК АвтомобилиСрезПоследних
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		               |		ПО АвтомобилиСрезПоследних.Значение = Контрагенты.Ссылка
		               |ГДЕ
		               |	АвтомобилиСрезПоследних.Автомобиль.Модель В ИЕРАРХИИ(&Hyundai)
		               |	И АвтомобилиСрезПоследних.Автомобиль.VIN = &VIN";
					   
		Запрос.Параметры.Вставить("Hyundai",Справочники.Модели.НайтиПоКоду("ЦБ00003644")); 
		Запрос.Параметры.Вставить("VIN",VINАвтомобиля);    	
		Запрос.Параметры.Вставить("Хозяин",Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
		
	ИначеЕсли ЗначениеЗаполнено(КодАвтомобиля) Тогда	                                                                        
		Запрос.Текст = "ВЫБРАТЬ
		               |	Контрагенты.Ссылка КАК Контрагент,
		               |	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль
		               |ИЗ
		               |	РегистрСведений.Автомобили.СрезПоследних(, ВидЗначения = &Хозяин) КАК АвтомобилиСрезПоследних
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		               |		ПО АвтомобилиСрезПоследних.Значение = Контрагенты.Ссылка
		               |ГДЕ
		               |	АвтомобилиСрезПоследних.Автомобиль.Модель В ИЕРАРХИИ(&Hyundai)
		               |	И АвтомобилиСрезПоследних.Автомобиль.Код = &Код";
					   
		Запрос.Параметры.Вставить("Hyundai",Справочники.Модели.НайтиПоКоду("ЦБ00003644")); 
		Запрос.Параметры.Вставить("Код",КодАвтомобиля);    	
		Запрос.Параметры.Вставить("Хозяин",Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
		
	ИначеЕсли ЗначениеЗаполнено(ПоследниеСимволыVIN) ИЛИ ЗначениеЗаполнено(ФамилияКонтрагент) ИЛИ ЗначениеЗаполнено(ГосНомерАвтомобиля) ИЛИ ЗначениеЗаполнено(ТелефонФрагмент) ИЛИ ЗначениеЗаполнено(ЭлПочтаКонтрагент) Тогда	   
	    Запрос.Текст = "ВЫБРАТЬ
	                   |	Контрагенты.Ссылка КАК Контрагент,
	                   |	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль
	                   |ПОМЕСТИТЬ ФамилияИВИН
	                   |ИЗ
	                   |	РегистрСведений.Автомобили.СрезПоследних(, ВидЗначения = &Хозяин) КАК АвтомобилиСрезПоследних
	                   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	                   |		ПО АвтомобилиСрезПоследних.Значение = Контрагенты.Ссылка
	                   |ГДЕ
	                   |	АвтомобилиСрезПоследних.Автомобиль.Модель В ИЕРАРХИИ(&Hyundai)
	    			   |	"+?(ЗначениеЗаполнено(ПоследниеСимволыVIN),"И АвтомобилиСрезПоследних.Автомобиль.VIN ПОДОБНО &VIN","")+"
	                   |	"+?(ЗначениеЗаполнено(ФамилияКонтрагент),"И Контрагенты.Фамилия ПОДОБНО &Фамилия","")+"   					 
	                   |;
	                   |
	                   |////////////////////////////////////////////////////////////////////////////////
	                   |ВЫБРАТЬ ПЕРВЫЕ 200
	                   |	ФамилияИВИН.Контрагент,
	                   |	ФамилияИВИН.Автомобиль,
	                   |	ВЫРАЗИТЬ(АвтомобилиСрезПоследних.Значение КАК СТРОКА(12)) КАК ГосНомер
	                   |ПОМЕСТИТЬ ГосНомера
	                   |ИЗ
	                   |	ФамилияИВИН КАК ФамилияИВИН
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(, ВидЗначения = &ГосНомер) КАК АвтомобилиСрезПоследних
	                   |		ПО ФамилияИВИН.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
					   |"+?(ЗначениеЗаполнено(ГосНомерАвтомобиля),"ГДЕ АвтомобилиСрезПоследних.Значение ПОДОБНО &ГосНомерФрагмент","")+"
	                   |;
	                   |
	                   |////////////////////////////////////////////////////////////////////////////////
	                   |ВЫБРАТЬ
	                   |	ГосНомера.Контрагент,
	                   |	ГосНомера.Автомобиль,
	                   |	ВложенныйЗапрос.Телефон,
	                   |	ВложенныйЗапрос1.ЭлПочта,
					   | 	ГосНомера.ГосНомер
	                   |ИЗ
	                   |	ГосНомера КАК ГосНомера
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                   |			КонтактнаяИнформация.Объект КАК Контрагент,
	                   |			ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(50)) КАК Телефон
	                   |		ИЗ
	                   |			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                   |		ГДЕ
	                   |			КонтактнаяИнформация.Тип = &ТипКИ
	                   |			И КонтактнаяИнформация.Вид = &ВидКИ
					   | И КонтактнаяИнформация.Объект В
					   |(ВЫБРАТЬ
					   |	ГосНомера.Контрагент
					   |ИЗ
				       |	ГосНомера КАК ГосНомера)) КАК ВложенныйЗапрос
	                   |		ПО ГосНомера.Контрагент = ВложенныйЗапрос.Контрагент
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                   |			КонтактнаяИнформация.Объект КАК Контрагент,
	                   |			ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(50)) КАК ЭлПочта
	                   |		ИЗ
	                   |			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                   |		ГДЕ
	                   |			КонтактнаяИнформация.Тип = &ТипЭлПочта
	                   |			И КонтактнаяИнформация.Вид = &ВидЭлПочта
					   |  И КонтактнаяИнформация.Объект В
					   |  (ВЫБРАТЬ
					   |  ГосНомера.Контрагент
					   |  ИЗ
					   |  ГосНомера КАК ГосНомера)) КАК ВложенныйЗапрос1
	                   |		ПО ГосНомера.Контрагент = ВложенныйЗапрос1.Контрагент
	                   |ГДЕ
	                   |	ГосНомера.Автомобиль.Модель В ИЕРАРХИИ(&Hyundai)
	                   |"+?(ЗначениеЗаполнено(ГосНомерАвтомобиля)," И ГосНомера.ГосНомер ПОДОБНО &ГосНомерФрагмент","")+"
	    			   |"+?(ЗначениеЗаполнено(ЭлПочтаКонтрагент)," И ВложенныйЗапрос1.ЭлПочта ПОДОБНО &ЭлПочтаФрагмент","")+"
	    			   |"+?(ЗначениеЗаполнено(ТелефонФрагмент)," И ВложенныйЗапрос.Телефон ПОДОБНО &ТелефонФрагмент","");
				   
		Запрос.Параметры.Вставить("Hyundai",Справочники.Модели.НайтиПоКоду("ЦБ00003644")); 
		Запрос.Параметры.Вставить("VIN","%"+ПоследниеСимволыVIN+"%");    	
		Запрос.Параметры.Вставить("Хозяин",Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин); 		
		Запрос.Параметры.Вставить("Фамилия","%"+ФамилияКонтрагент+"%"); 
		Запрос.Параметры.Вставить("ГосНомерФрагмент","%"+ГосНомерАвтомобиля+"%");    	
		Запрос.Параметры.Вставить("ГосНомер",Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер); 
		Запрос.Параметры.Вставить("ТелефонФрагмент","%"+ТелефонФрагмент+"%");  
		Запрос.Параметры.Вставить("ТипКИ",Перечисления.ТипыКонтактнойИнформации.Телефон); 
		Запрос.Параметры.Вставить("ВидКИ",Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);  
		Запрос.Параметры.Вставить("ЭлПочтаФрагмент","%"+ЭлПочтаКонтрагент+"%");  
		Запрос.Параметры.Вставить("ВидЭлПочта",Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний); 
		Запрос.Параметры.Вставить("ТипЭлПочта",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);  

	Иначе
		НоваяСтрока = ТаблицаОщибок.Добавить();
		НоваяСтрока.Код = "WA02";
		НоваяСтрока.ТекстОшибки = "Не заполено ни одно из полей для поиска контрагентов";
		CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"-1",ТаблицаОщибок);
		Возврат CustomerVehicleGet;  		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Количество()=0 Тогда                         		
		CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"0",ТаблицаОщибок);
		Возврат CustomerVehicleGet;  		
	Иначе
		Пока Выборка.Следующий() Цикл 			

			//Если ЗначениеЗаполнено(ФамилияКонтрагент) Тогда
			//	Фамилия = обПолучитьФамилия(Выборка.Контрагент.Наименование);
			//	Если нрег(Фамилия)<>нрег(ФамилияКонтрагент) Тогда
			//		продолжить;
			//	КонецЕсли;
			//КонецЕсли;
			
			CustomerVehicleType = ФабрикаXDTO.Тип("http://wa.dms.webservice/CustomerVehicleGetRequest", "CustomerVehicle");
			CustomerVehicle = ФабрикаXDTO.Создать(CustomerVehicleType);
			
			CustomerType = ФабрикаXDTO.Тип("http://wa.dms.webservice/CustomerVehicleGetRequest", "Customer");
			CustomerData = ФабрикаXDTO.Создать(CustomerType);
		    CustomerData = обGetCustomer("http://wa.dms.webservice/CustomerVehicleGetRequest", CustomerData, Выборка.Контрагент, "1");               			
			CustomerVehicle.Customer = CustomerData; 			
			
			VehicleType = ФабрикаXDTO.Тип("http://wa.dms.webservice/CustomerVehicleGetRequest", "Vehicle");
			VehicleData = ФабрикаXDTO.Создать(VehicleType);
			VehicleData = обGetVehicle("http://wa.dms.webservice/CustomerVehicleGetRequest", VehicleData, Выборка.Автомобиль);
			CustomerVehicle.Vehicle = VehicleData;  
		
			Customers.CustomerVehicle.Добавить(CustomerVehicle);
		КонецЦикла;
	КонецЕсли;
	
	CustomerVehicleGet.CustomerVehicles = Customers;
	CustomerVehicleGet = обПолучитьВозвратWAError("http://wa.dms.webservice/CustomerVehicleGetRequest",CustomerVehicleGetRequest,CustomerVehicleGet,"1",ТаблицаОщибок);
	Возврат CustomerVehicleGet;  
КонецФункции                                                                

Функция CustomerNehicleChange(CustomerVehicleChangeRequest)
	// Вставить содержимое обработчика.
	CustomerVehicleChangeType = ФабрикаXDTO.Тип("http://wa.dms.webservice/CustomerVehicleGetRequest", "CustomerVehicleChangeResponse");
