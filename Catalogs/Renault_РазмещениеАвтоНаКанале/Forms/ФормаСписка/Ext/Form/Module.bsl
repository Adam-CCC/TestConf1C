
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Автомобили") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Автомобили", Параметры.Автомобили);
		Автомобили.ЗагрузитьЗначения(Параметры.Автомобили);
	КонецЕсли;
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		МассивАвто = Новый Массив;
		МассивАвто.Добавить(Параметры.Отбор.Владелец);
		Список.Параметры.УстановитьЗначениеПараметра("Автомобили", МассивАвто);
		Автомобили.ЗагрузитьЗначения(МассивАвто);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	ПараметрыФормы = Новый Структура;
	Если Автомобили.Количество() = 0 Тогда
		Автомобиль = ОткрытьФормуМодально("Справочник.Автомобили.ФормаВыбора");
		Если Не ЗначениеЗаполнено(Автомобиль) Тогда
			Возврат;
		КонецЕсли;
		ПараметрыФормы.Вставить("Автомобиль", Автомобиль);
	ИначеЕсли Автомобили.Количество() = 1 Тогда
		ПараметрыФормы.Вставить("Автомобиль", Автомобили[0].Значение);
	Иначе
		Автомобиль = ВыбратьИзСписка(Автомобили);
		Если ЗначениеЗаполнено(Автомобиль) Тогда
			ПараметрыФормы.Вставить("Автомобиль", Автомобиль);
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Renault_РазмещениеАвтоНаКанале.Форма.ФормаЭлемента", ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Процедура ОпубликоватьНаСервере()
	Для Каждого Объявление из Элементы.Список.ВыделенныеСтроки Цикл
		Если не ПроверитьНаВозможностьОтправки (Объявление) Тогда
			Продолжить;
		КонецЕсли;
		сОтвет = Справочники.Renault_РазмещениеАвтоНаКанале.СформироватьФайл(Объявление);
		Если сОтвет.Ошибка Тогда
			Сообщить("Файл не был сформирован. Проверьте наличие Заяки на трейд-ин для данного авто!");
			Возврат;
		Иначе
			Ответ = Неопределено;
			DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"UsedCars_serv.PostAdvert",DMS_DataExchange.newPackage(сОтвет), Ответ);
		КонецЕсли;
		Объект = Объявление.ПолучитьОбъект(); 
		Объект.ДатаОтправкиНаКанал = ТекущаяДата();
		Объект.Активно = Истина;
		Объект.Записать();
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Опубликовать(Команда)
	ОпубликоватьНаСервере();
	Элементы.Список.Обновить();
КонецПроцедуры

&НаСервере
Функция ПроверитьНаВозможностьОтправки (Объявление)
	
	Если Объявление.ЗаявкаТрейдИн.РучнойВвод Тогда
		Сообщить("Автомобиль "+Объявление.Владелец+" в заявке на трейд-ин введен вручную. Автоматическая публикация не возможна.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объявление.СтатусОбъявления) Тогда
		Сообщить("Не заполнен статус объявления автомобиля "+Объявление.Владелец);
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объявление.АктивностьДо) Тогда
		Сообщить("Не заполенна дата ""Активность до"" автомобиля "+Объявление.Владелец);
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объявление.КодЦвета) Тогда
		Сообщить("Не заполнен цвет по класификатору автомобиля " +Объявление.Владелец);
		Возврат Ложь;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Объявление.СостояниеАвтомобиля) Тогда
		Сообщить("Не заполнено состояние автомобиля "+Объявление.Владелец);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции
