Функция ПолучитьОбъектДляЗаписиXML(Адрес)
	
	ЗаписьXML = Новый ЗаписьXML();
	
	ЗаписьXML.ОткрытьФайл(Адрес);
	
	Возврат ЗаписьXML;
	
КонецФункции // ПолучитьОбъектДляЗаписиXML()

Функция ПолучитьСтрокуЗаписиДляXML(Значение) 
	
	СтрокаЗаписи = Строка(Значение);
		
	Если ( ТипЗнч(Значение) = Тип("Число") ) Тогда
		
		СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, Символы.НПП, "");
		СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, ",", ".");
		
	ИначеЕсли ( ТипЗнч(Значение) = Тип("Булево") ) Тогда
		
		Если (Значение) Тогда
			СтрокаЗаписи = "true";
		Иначе
			СтрокаЗаписи = "false";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрокаЗаписи;
	
КонецФункции // ПолучитьСтрокуЗаписиДляXML(Значение)

Процедура ЗаписатьXMLПоСпискуЗначений(ОбъектXML, СписокЗначений) Экспорт
	
	ПрефиксУзлаXML	   = "XMLУзел.";
	ПрефиксАтрибутаXML = "XMLАтрибут.";
	НачалоЭлементаXML  = "XMLНачалоЭлемента";
	КонецЭлементаXML   = "XMLКонецЭлемента";
	ПефиксСекцииXML	   = "XMLСекция";
	
	Для Каждого Элемент Из СписокЗначений Цикл
		Если ( Элемент.Представление = КонецЭлементаXML ) Тогда
			
			ОбъектXML.ЗаписатьКонецЭлемента();
			
		ИначеЕсли ( Элемент.Представление = НачалоЭлементаXML ) Тогда	
			
			ОбъектXML.ЗаписатьНачалоЭлемента(Элемент.Значение);
			
		ИначеЕсли ( Элемент.Представление = "" ) Тогда
			
			ОбъектXML.ЗаписатьТекст(Элемент.Значение);
			
		ИначеЕсли ( Булево(Найти(Элемент.Представление, ПефиксСекцииXML)) ) Тогда
			
			ИмяСекции = СтрЗаменить(Элемент.Представление, ПефиксСекцииXML, "");
			ОбъектXML.ЗаписатьСекциюCDATA(Элемент.Значение);
			
		ИначеЕсли ( Булево(Найти(Элемент.Представление, ПрефиксУзлаXML)) ) Тогда
			
			ИмяУзла = СтрЗаменить(Элемент.Представление, ПрефиксУзлаXML, "");
			ЗаписатьТекстовойУзел(ОбъектXML, ИмяУзла, Элемент.Значение);
			
		ИначеЕсли ( Булево(Найти(Элемент.Представление, ПрефиксАтрибутаXML)) ) Тогда
			
			ИмяАтрибута = СтрЗаменить(Элемент.Представление, ПрефиксАтрибутаXML, "");
			ОбъектXML.ЗаписатьАтрибут(ИмяАтрибута, Элемент.Значение);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаписатьXMLПоСпискуЗначений(ОбъектXML, СписокЗначений)

Процедура ЗаписатьТекстовойУзел(ОбъектXML, Имя, Значение) 
	
	СтрокаЗаписи = ПолучитьСтрокуЗаписиДляXML(Значение);
	ОбъектXML.ЗаписатьБезОбработки("<"+Имя+">"+СтрокаЗаписи+"</"+Имя+">");

КонецПроцедуры // ЗаписатьТекстовойУзел(ОбъектXML, Имя, Значение)

///////////////////////////////////////////////
// Процедуры работы со списком структуры XML

Процедура ДобавитьУзелXML(СписокЗначений, НаименованиеУзла, Значение) Экспорт
	
	СписокЗначений.Добавить(Значение, "XMLУзел." + НаименованиеУзла);
	
КонецПроцедуры // ДобавитьУзелXML(СписокЗначений, НаименованиеУзла, Значение)

Процедура ДобавитьНачалоЭлементаXML(СписокЗначений, НаименованиеЭлемента) Экспорт
	
	СписокЗначений.Добавить(НаименованиеЭлемента, "XMLНачалоЭлемента");
	
КонецПроцедуры // ДобавитьНачалоЭлементаXML(СписокЗначений, НаименованиеЭлемента)

Процедура ДобавитьАтрибутXML(СписокЗначений, НаименованиеАтрибута, Значение) Экспорт
	
	СписокЗначений.Добавить(Значение, "XMLАтрибут." + НаименованиеАтрибута);
	
КонецПроцедуры // ДобавитьАтрибутXML(СписокЗначений, НаименованиеАтрибута, Значение)

Процедура ДобавитьТекстXML(СписокЗначений, Значение) Экспорт
	
	СписокЗначений.Добавить(Значение, "");
	
КонецПроцедуры // ДобавитьТекстXML(СписокЗначений, Значение)

Процедура ДобавитьКонецЭлементаXML(СписокЗначений) Экспорт
	
	СписокЗначений.Добавить("", "XMLКонецЭлемента");
	
КонецПроцедуры // ДобавитьКонецЭлементаXML(СписокЗначений)

Процедура ДобавитьСекциюXML(СписокЗначений, Значение)
	
	СписокЗначений.Добавить(Значение, "XMLСекция");
	
КонецПроцедуры

