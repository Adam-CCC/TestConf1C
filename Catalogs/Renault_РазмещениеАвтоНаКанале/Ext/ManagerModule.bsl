// Формирование запроса

Функция ПолучитьXMLЗапроса(Выборка) 
	
	//Первоначальная инициализация
	Адрес = ПолучитьИмяВременногоФайла("xml");
	XMLЗапроса = ПолучитьОбъектДляЗаписиXML(Адрес);
	
	СписокСтруктуры = Новый СписокЗначений;
	
	ДобавитьНачалоЭлементаXML(СписокСтруктуры, "Ads");
	ДобавитьАтрибутXML(СписокСтруктуры, "formatVersion", "3");
	//ДобавитьАтрибутXML(СписокСтруктуры, "target", "Avito.ru");
	
	ДобавитьНачалоЭлементаXML(СписокСтруктуры, "Ad");
	
	ДобавитьУзелXML(СписокСтруктуры, "BIR","6101");// Выборка.BIR);
	ДобавитьУзелXML(СписокСтруктуры,"Id",Строка(Выборка.Ссылка.УникальныйИдентификатор())); 
	ДобавитьУзелXML(СписокСтруктуры,"AdStatus", "Free");
	
	ДобавитьУзелXML(СписокСтруктуры,"EMail",Выборка.Емаил);
	ДобавитьУзелXML(СписокСтруктуры,"AllowEmail", "Нет");
	//ДобавитьУзелXML(СписокСтруктуры,"CompanyName", "");
	ДобавитьУзелXML(СписокСтруктуры,"ContactPhone", Выборка.Телефон);
	ДобавитьУзелXML(СписокСтруктуры,"Region", Выборка.Регион);
	Если ЗначениеЗаполнено(Выборка.Город) Тогда
		ДобавитьУзелXML(СписокСтруктуры,"City", Выборка.Город);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.Метро) Тогда
		ДобавитьУзелXML(СписокСтруктуры,"Subway", Выборка.Метро);
	КонецЕсли;
	ДобавитьУзелXML(СписокСтруктуры,"Category", "Автомобили");
	ДобавитьУзелXML(СписокСтруктуры,"CarType", "С пробегом");
	ДобавитьУзелXML(СписокСтруктуры,"Price", Формат(Выборка.ЦенаПродажи,"ЧЦ=10; ЧДЦ=; ЧГ=0"));
	ДобавитьУзелXML(СписокСтруктуры,"Kilometrage", Формат(Выборка.Пробег,"ЧЦ=10; ЧДЦ=; ЧГ=0"));
	ДобавитьУзелXML(СписокСтруктуры,"Accident", "Не битый");
	ДобавитьУзелXML(СписокСтруктуры,"Make", Выборка.Производитель);
	ДобавитьУзелXML(СписокСтруктуры,"Model", Выборка.Модель);
	ДобавитьУзелXML(СписокСтруктуры,"Year", Выборка.ГодВыпуска);
	ДобавитьУзелXML(СписокСтруктуры,"VIN", Выборка.VIN);
	ДобавитьУзелXML(СписокСтруктуры,"BodyType", Выборка.ТипКузова);
	ДобавитьУзелXML(СписокСтруктуры,"Doors", Выборка.КоличествоДверей);
	ДобавитьУзелXML(СписокСтруктуры,"Color", Выборка.Цвет);
	ДобавитьУзелXML(СписокСтруктуры,"EngineSize", Формат(Число(?(СокрЛП(Строка(Выборка.Объем))="",0,Выборка.Объем)),"ЧЦ=10; ЧДЦ=; ЧГ=0"));
	ДобавитьУзелXML(СписокСтруктуры,"Power", Формат(Число(?(СокрЛП(Строка(Выборка.ЛошадиныеСилы))="",0,Выборка.ЛошадиныеСилы)),"ЧЦ=10; ЧДЦ=; ЧГ=0"));
	ДобавитьУзелXML(СписокСтруктуры,"Transmission", Выборка.КПП);
	ДобавитьУзелXML(СписокСтруктуры,"DriveType", "Передний");
	ДобавитьУзелXML(СписокСтруктуры,"WheelType", "Левый");
	ДобавитьУзелXML(СписокСтруктуры,"FuelType", Выборка.ТипТоплива);
	ТекстОпции = "Дополнительное оборудование: ";
	ЕстьОпции = Ложь;
	СтрокаОпций = Выборка.Опции.Выбрать();
	Пока СтрокаОпций.Следующий () Цикл
		Если СтрокаОпций.Выбрана Тогда
			ТекстОпции = ТекстОпции +", " + СтрокаОпций.Опция.Наименование;
			ЕстьОпции = Истина;
		КонецЕсли;
	КонецЦикла;
	ДобавитьУзелXML(СписокСтруктуры,"Description", Прав(""+ Выборка.Объявление + Символы.ПС + ТекстОпции,3000));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ФотографииАвтомобилей.Фотография
	|ИЗ
	|	РегистрСведений.Renault_ФотографииАвтомобилей КАК Renault_ФотографииАвтомобилей
	|ГДЕ
	|	Renault_ФотографииАвтомобилей.Автомобиль = &Автомобиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_ФотографииАвтомобилей.Ракурс.Код";
	Запрос.УстановитьПараметр("Автомобиль", Выборка.Автомобиль);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		ВыборкаФото = Результат.Выбрать();
		Для х=1 по 5 Цикл
			Если ВыборкаФото.Следующий()Тогда
				ДобавитьНачалоЭлементаXML(СписокСтруктуры, "Image"+х);
				ДобавитьСекциюXML(СписокСтруктуры, "data:image/jpg;base64,"+ Base64Строка(ВыборкаФото.Фотография.Фотография.Получить()));
				ДобавитьКонецЭлементаXML(СписокСтруктуры);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//Закрываем <Ad> 
	ДобавитьКонецЭлементаXML(СписокСтруктуры);
	//Закрываем <Ads>
	ДобавитьКонецЭлементаXML(СписокСтруктуры);
	
	ЗаписатьXMLПоСпискуЗначений(XMLЗапроса, СписокСтруктуры);
	
	XMLЗапроса.Закрыть();
	Возврат Адрес;

КонецФункции

Функция СформироватьФайл (Размещение) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Цена КАК Цена,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.Владелец КАК Авто,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.Объявление КАК Объявление,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка КАК Ссылка,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.АктивностьОт КАК АктивностьОт,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.АктивностьДо КАК АктивностьДо,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.RenaultSelection КАК RenaultSelection,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.СтатусОбъявления КАК СтатусОбъявления,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.СостояниеАвтомобиля КАК СостояниеАвтомобиля,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.ЗаявкаТрейдИн КАК ЗаявкаТрейдИн,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.КолМесяцевГарантии КАК КолМесяцевГарантии,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.КодЦвета,
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка.Владелец КАК Автомобиль
	|ПОМЕСТИТЬ ВТ_ТЗ
	|ИЗ
	|	Справочник.Renault_РазмещениеАвтоНаКанале.ЦенаПродажи КАК Renault_РазмещениеАвтоНаКаналеЦенаПродажи
	|ГДЕ
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.Ссылка = &Ссылка
	|	И Renault_РазмещениеАвтоНаКаналеЦенаПродажи.ДатаСогласования <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_РазмещениеАвтоНаКаналеЦенаПродажи.ДатаУстановки УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаТрейдИн.Пробег КАК Пробег,
	|	Renault_CRM_ЗаявкаНаТрейдИн.VIN КАК VIN,
	|	Renault_CRM_ЗаявкаНаТрейдИн.МодификацияКод.КодМодификации КАК Модификация,
	|	Renault_CRM_ЗаявкаНаТрейдИн.Опции.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Опция КАК Опция,
	|		Выбрана КАК Выбрана
	|	) КАК Опции,
	|	CRM_ДилерскиеЦентры.UsedCars_Телефон КАК Телефон,
	|	CRM_ДилерскиеЦентры.UsedCars_Емаил КАК Емаил,
	|	ВТ_ТЗ.Цена,
	|	ВТ_ТЗ.Объявление,
	|	ВТ_ТЗ.АктивностьОт,
	|	ВТ_ТЗ.АктивностьДо,
	|	ВТ_ТЗ.RenaultSelection,
	|	ВТ_ТЗ.СтатусОбъявления,
	|	ВТ_ТЗ.СостояниеАвтомобиля,
	|	ВТ_ТЗ.КолМесяцевГарантии,
	|	ВТ_ТЗ.КодЦвета,
	|	CRM_ДилерскиеЦентры.Бир_ЛМТ,
	|	Renault_CRM_ЗаявкаНаТрейдИн.ОригиналПТС,
	|	ВТ_ТЗ.Ссылка,
	|	Renault_CRM_ЗаявкаНаТрейдИн.КоличествоВладельцевПоПТС КАК КоличествоВладельцев,
	|	ВТ_ТЗ.Автомобиль
	|ИЗ
	|	ВТ_ТЗ КАК ВТ_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_CRM_ЗаявкаНаТрейдИн
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	|			ПО Renault_CRM_ЗаявкаНаТрейдИн.ДилерскийЦентр = CRM_ДилерскиеЦентры.Ссылка
	|		ПО ВТ_ТЗ.ЗаявкаТрейдИн = Renault_CRM_ЗаявкаНаТрейдИн.Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Размещение);
	Результат = Запрос.Выполнить();
	сОтвет = Новый Структура;
	Если Результат.Пустой() Тогда 
		сОтвет.Вставить("Ошибка", Истина);
	Иначе
		сОтвет.Вставить("Ошибка", Ложь);
	КонецЕсли;
	
	ПолучитьСтруктуруОбъявления(Результат.Выгрузить(), сОтвет);
	
	Возврат сОтвет;
	
КонецФункции

Процедура ПолучитьСтруктуруОбъявления (ТаблицаДанных, сОтвет)
	
	Для Каждого СтрТЗ из ТаблицаДанных Цикл
		сОтвет.Вставить("GUID", Строка(СтрТЗ.Ссылка.УникальныйИдентификатор()));
		сОтвет.Вставить("bir", СтрТЗ.Бир_ЛМТ);
		сОтвет.Вставить("action_from", СтрТЗ.АктивностьОт);
		сОтвет.Вставить("action_before",СтрТЗ.АктивностьДо);
		сОтвет.Вставить("description", СтрТЗ.Объявление);
		сОтвет.Вставить("mileage", СтрТЗ.Пробег);
		сОтвет.Вставить("renault_selection", СтрТЗ.RenaultSelection);
		сОтвет.Вставить("release_date",);
		сОтвет.Вставить("price", СтрТЗ.Цена);
		сОтвет.Вставить("guarantee",СтрТЗ.КолМесяцевГарантии);
		сОтвет.Вставить("owners", СтрТЗ.КоличествоВладельцев);
		сОтвет.Вставить("second_hand", Истина);
		сОтвет.Вставить("vin", СтрТЗ.VIN);
		сОтвет.Вставить("color", СтрТЗ.КодЦвета);
		сОтвет.Вставить("specification", СтрТЗ.Модификация);
		сОтвет.Вставить("status", СтрТЗ.СтатусОбъявления);
		сОтвет.Вставить("condition", СтрТЗ.СостояниеАвтомобиля);
		сОтвет.Вставить("pts", СтрТЗ.ОригиналПТС);
		Если СтрТЗ.Опции.Количество() > 0 Тогда
			мОпций = Новый Массив;
			сСпрОпции = ПолучитьОпцииАвто();
			Для Каждого СтрОтция из СтрТЗ.Опции Цикл
				Если СтрОтция.Выбрана Тогда
					мОпций.Добавить(сСпрОпции[СтрОтция.Опция]);
				КонецЕсли;
			КонецЦикла;
			сОтвет.Вставить("option", мОпций);
		Иначе
			сОтвет.Вставить("option", Неопределено);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ФотографииАвтомобилей.Фотография,
		|	Renault_ФотографииАвтомобилей.Ракурс
		|ИЗ
		|	РегистрСведений.Renault_ФотографииАвтомобилей КАК Renault_ФотографииАвтомобилей
		|ГДЕ
		|	Renault_ФотографииАвтомобилей.Автомобиль = &Автомобиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Renault_ФотографииАвтомобилей.Ракурс.Код";
		Запрос.УстановитьПараметр("Автомобиль", СтрТЗ.Автомобиль);
		
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			сСпрФото = ПолучитьРакурсыФотограцийАвто();
			
			мФото = Новый Массив;
			ВыборкаФото = Результат.Выбрать();
			Счетчик = 1;
			Пока ВыборкаФото.Следующий() Цикл 
				сФото = Новый Структура;
				сФото.Вставить("name", "Image"+Формат(Счетчик, "ЧГ=0")+".jpg");
				сФото.Вставить("base64", "data:image/jpg;base64,"+ Base64Строка(ВыборкаФото.Фотография.Фотография.Получить()));
				сфото.Вставить("position", сСпрФото[ВыборкаФото.Ракурс]);
				мФото.Добавить(сФото);
				Счетчик = Счетчик +1;
			КонецЦикла;
			сОтвет.Вставить("pictures",мФото);
		иначе
			сОтвет.Вставить("pictures",Неопределено);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

