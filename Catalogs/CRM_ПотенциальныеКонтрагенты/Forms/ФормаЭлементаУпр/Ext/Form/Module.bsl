&НаКлиенте
Процедура Печать(Команда)

	Если ЭтаФорма.Модифицированность Тогда 
		Сообщить("Перед печатью документа, необходимо записать документ");
		Возврат;
	КонецЕсли;
	
	Если Объект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да Тогда 
		СтруктураПараметров = СофрмироватьПараметрыДляПФ("ПерсональныеДанные",Истина);
		МассивФайлов = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметров,Объект.Ссылка);
		Если МассивФайлов = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось получить печатную форму обработки персональных данных");
			Возврат;
		КонецЕсли;
		
		Для каждого Файл Из МассивФайлов Цикл
			НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
		КонецЦикла;
	КонецЕсли;
	
	Если Объект.СогласенНаКоммуникацию Тогда 
		СтруктураПараметров = СофрмироватьПараметрыДляПФ("Коммуникация",Истина);
		МассивФайлов = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметров,Объект.Ссылка);
		Если МассивФайлов = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось получить печатную форму обработки персональных данных");
			Возврат;
		КонецЕсли;
		
		Для каждого Файл Из МассивФайлов Цикл
			НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
		КонецЦикла;
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Функция СофрмироватьПараметрыДляПФ(ВидСогласия,Согласие)
	
	СтруктураОбъекта = Новый Структура;
	СтруктураКлиента = Новый Структура;
	СтруктураДокумента = Новый Структура;
	СтруктураАвтомобиля = Новый Структура;
	СтруктураСогласия = Новый Структура;
	СтруктураОтвветсвенный = Новый Структура;
	
	СтруктураДокумента.Вставить("passportnumber",ПаспортНомер);
	СтруктураДокумента.Вставить("passportseries",ПаспортСерия);
	СтруктураДокумента.Вставить("passportissued",ПаспортКемВыдан); 
	СтруктураДокумента.Вставить("passportday",Формат(ПаспортДатаВыдачи,"ДФ=dd"));
	СтруктураДокумента.Вставить("passportmonth",Формат(ПаспортДатаВыдачи,"ДФ=MM"));
	СтруктураДокумента.Вставить("passportyear",Формат(ПаспортДатаВыдачи,"ДФ=yyyy"));

	СтруктураКлиента.Вставить("lastname",Объект.Фамилия);
	СтруктураКлиента.Вставить("firstname",Объект.Имя);
	СтруктураКлиента.Вставить("middlename",Объект.Отчество);
	СтруктураКлиента.Вставить("birthday",Объект.ДатаРождения);
	СтруктураКлиента.Вставить("gender",?(Объект.Пол=Перечисления.ПолФизическихЛиц.НеУказан,"",""+Объект.Пол));
	СтруктураКлиента.Вставить("address",Адрес);
	СтруктураКлиента.Вставить("tel",МобильныйТелефон);
	СтруктураКлиента.Вставить("email",ЭлектронныйАдрес);
	СтруктураКлиента.Вставить("company",?(Объект.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо,Истина,Ложь));
	СтруктураКлиента.Вставить("document",СтруктураДокумента);
	СтруктураОбъекта.Вставить("client",СтруктураКлиента);
	
	СтруктураАвтомобиля.Вставить("mark","");
	СтруктураАвтомобиля.Вставить("vin","");
	СтруктураАвтомобиля.Вставить("daybuycar",Дата("00010101"));
	СтруктураОбъекта.Вставить("auto",СтруктураАвтомобиля);
	
	СтруктураСогласия.Вставить("form",ВидСогласия);
	СтруктураСогласия.Вставить("agree",Согласие);
	СтруктураОбъекта.Вставить("consent",СтруктураСогласия);
	
	СтруктураОтвветсвенный.Вставить("name",""+ПараметрыСеанса.Пользователь.Сотрудник);
	СтруктураОтвветсвенный.Вставить("from","Форма потенциального контрагента");
	СтруктураОбъекта.Вставить("responsible",СтруктураОтвветсвенный);
	
	Возврат СтруктураОбъекта;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьВФайл(Файл)
	
	выборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	выборФайла.ПолноеИмяФайла = Файл["ИмяФайла"];
	Если выборФайла.Выбрать() Тогда
		//ИмяФайла = Файл["ИмяФайла"];
		ДанныеФайла = Base64Значение(Файл["ДанныеФайла"]);	
		ДанныеФайла.записать(выборФайла.ПолноеИмяФайла);
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура СогласиеНаОбработкуПерсональныхДанныхПриИзменении(Элемент)
	УстановитьДоступностьПечатиОПД();
	Если Объект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Вопрос("Согласие на обработку персональных данных будет отозвано. Продолжить?",РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Нет);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		СтруктураПараметров = СофрмироватьПараметрыДляПФ("ПерсональныеДанные",Ложь);
		ОтветСервера = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметров,Объект.Ссылка);
		
		Если ОтветСервера = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось отозвать согласие.");
			Объект.СогласиеНаОбработкуПерсональныхДанных = СогласиеСохранение;
		Иначе 	
			ПоказатьПредупреждение(,ОтветСервера["answer"]);
		КонецЕсли;
	Иначе 
		Объект.СогласиеНаОбработкуПерсональныхДанных = СогласиеСохранение;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СогласенНаКоммуникациюПриИзменении(Элемент)
	УстановитьДоступностьПечатиОПД();
	
	Если Объект.СогласенНаКоммуникацию Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Вопрос("Согласие на коммуникацию будет отозвано. Продолжить?",РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Нет);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		СтруктураПараметров = СофрмироватьПараметрыДляПФ("Коммуникация",Ложь);
		ОтветСервера = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметров,Объект.Ссылка);
		Если ОтветСервера = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось отозвать согласие.");
			Объект.СогласенНаКоммуникацию = Истина;
		Иначе 	
			ПоказатьПредупреждение(,ОтветСервера["answer"]);
		КонецЕсли;
		
	Иначе 
		Объект.СогласенНаКоммуникацию = Истина;
	КонецЕсли;
	

	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьПечатиОПД()
	
	Если Объект.СогласиеНаОбработкуПерсональныхДанных <> Перечисления.ВариантыОтветов.Да И Не Объект.СогласенНаКоммуникацию Тогда 
		Элементы.Печать.Доступность = Ложь;
	Иначе 
		Элементы.Печать.Доступность = Истина;
	КонецЕсли;

	
КонецПроцедуры


&НаКлиенте
Процедура СогласиеНаОбработкуПерсональныхДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СогласиеСохранение = Объект.СогласиеНаОбработкуПерсональныхДанных;
КонецПроцедуры

