&НаКлиенте
Процедура СформироватьФИОНаКлиенте()  
	
	Объект.Наименование = СокрЛП(Объект.Фамилия) + ?(ПустаяСтрока(СокрЛП(Объект.Имя)),""," " + СокрЛП(Объект.Имя)) + ?(ПустаяСтрока(СокрЛП(Объект.Отчество)),""," " + СокрЛП(Объект.Отчество));
	
	Если ПустаяСтрока(Объект.НаименованиеПолное) Тогда
		Объект.НаименованиеПолное = СокрЛП(Объект.Наименование);
	КонецЕсли; 
	
КонецПроцедуры // СформироватьФИОНаКлиенте()

