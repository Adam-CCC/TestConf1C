
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Филиал	= ПараметрыСеанса.Организация;
		Объект.Автор	= ПараметрыСеанса.Пользователь;
		Объект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Спрашивать;
		Объект.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
		Объект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
		Объект.Пол = Перечисления.ПолФизическихЛиц.НеУказан;
	КонецЕсли;
	
	Если Параметры.Свойство("Наименование") Тогда
		Объект.НаименованиеПолное = Параметры.Наименование;
		Объект.Наименование = Параметры.Наименование;
	КонецЕсли;
	
	Документы.Отбор.Элементы[0].ПравоеЗначение = Объект.Ссылка;
	
	ЗаполнитьКонтакты();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьЮрФизЛицо();
КонецПроцедуры

&НаКлиенте
Процедура ФормаСобственностиПриИзменении(Элемент)
	УстановитьВидимостьЮрФизЛицо();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЮрФизЛицо()
	
	ЭтоФизлицо = (Объект.ФормаСобственности=ПредопределенноеЗначение("Перечисление.ФормыСобственности.ЧастноеЛицо"));
	Элементы.ФИО.Видимость			= ЭтоФизлицо;
	Элементы.Наименование.Видимость	= НЕ ЭтоФизлицо;
	Элементы.Физлицо.Видимость		= ЭтоФизлицо;
	Элементы.Юрлицо.Видимость		= НЕ ЭтоФизлицо;
	Элементы.ЛичныеДанные.Видимость	= ЭтоФизлицо;
	
КонецПроцедуры

&НаКлиенте
Процедура ФИОПриИзменении(Элемент)
	
	Объект.Наименование = СокрЛП(Объект.Фамилия + " " + Объект.Имя + " " + Объект.Отчество);
	
КонецПроцедуры

//Контактная информация
&НаСервере
Процедура ЗаполнитьКонтакты()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	""Поле1="" + КонтактнаяИнформация.Поле1 + ""
	|Поле2="" + КонтактнаяИнформация.Поле2 + ""
	|Поле3="" + КонтактнаяИнформация.Поле3 + ""
	|Поле4="" + КонтактнаяИнформация.Поле4 + ""
	|Поле5="" + КонтактнаяИнформация.Поле5 + ""
	|Поле6="" + КонтактнаяИнформация.Поле6 + ""
	|Поле7="" + КонтактнаяИнформация.Поле7 + ""
	|Поле8="" + КонтактнаяИнформация.Поле8 + ""
	|Поле9="" + КонтактнаяИнформация.Поле9 + ""
	|НаименованиеСтраны="" + (ВЫРАЗИТЬ(КонтактнаяИнформация.Комментарий КАК СТРОКА(500))) + ""
	|Комментарий="" + (ВЫРАЗИТЬ(КонтактнаяИнформация.Комментарий КАК СТРОКА(500))) КАК ЗначенияПолей,
	|	КонтактнаяИнформация.ТипДома,
	|	КонтактнаяИнформация.ТипКорпуса,
	|	КонтактнаяИнформация.ТипКвартиры
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Ссылка";
	Контакты.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформацияПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТипКонтИнф = ТипКонтактнойИнформации(Элементы.Контакты.ТекущиеДанные.Вид);
	Если ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес") = ТипКонтИнф Тогда
		ВвестиКонтактнуюИнформацияЧерезФорму("ОбщаяФорма.ВводАдреса")
	ИначеЕсли ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон") = ТипКонтИнф Тогда 
		ВвестиКонтактнуюИнформацияЧерезФорму("ОбщаяФорма.ВводТелефона")
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиКонтактнуюИнформацияЧерезФорму(ИмяФормы)
	
	ЗначенияПолей = Renault_УправлениеКонтактнойИнформацией.ПреобразоватьСтрокуВСписокПолей(Элементы.Контакты.ТекущиеДанные.ЗначенияПолей);
	ЗначенияПолей.Добавить(Элементы.Контакты.ТекущиеДанные.ТипДома, "ТипДома");
	ЗначенияПолей.Добавить(Элементы.Контакты.ТекущиеДанные.ТипКорпуса, "ТипКорпуса");
	ЗначенияПолей.Добавить(?(Элементы.Контакты.ТекущиеДанные.ТипКвартиры = ПредопределенноеЗначение("Перечисление.ТипыКвартир.Офис"), "офис", "квартира"), "ТипКвартиры");
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", Объект.Наименование);
	ПараметрыФормы.Вставить("ЗначенияПолей", ЗначенияПолей);
	ПараметрыФормы.Вставить("Вид", Элементы.Контакты.ТекущиеДанные.Вид);
	ПараметрыФормы.Вставить("Представление", Элементы.Контакты.ТекущиеДанные.Представление);
	Форма = ПолучитьФорму(ИмяФормы, ПараметрыФормы, ЭтаФорма);
	Результат = Форма.ОткрытьМодально();
	Если Неопределено <> Результат Тогда
		ТекДанные = Элементы.Контакты.ТекущиеДанные;
		ТекДанные.Представление = Результат.Представление;
		ТекДанные.ЗначенияПолей = Renault_УправлениеКонтактнойИнформацией.ПреобразоватьСписокПолейВСтроку(Результат.ЗначенияПолей);
		ЗаписатьКИ(ТекДанные.Тип, ТекДанные.Вид, Объект.Ссылка, ТекДанные.Представление, ТекДанные.ЗначенияПолей);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипКонтактнойИнформации(ВидКонтИнф)
	
	Если ЗначениеЗаполнено(ВидКонтИнф) Тогда
		Возврат ВидКонтИнф.Тип
	Иначе
		Возврат Перечисления.ТипыКонтактнойИнформации.ПустаяСсылка()
	КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура КонтактнаяИнформацияПредставлениеПриИзменении(Элемент)
	
	Элементы.Контакты.ТекущиеДанные.ЗначенияПолей = "";
	ТекДанные = Элементы.Контакты.ТекущиеДанные;
	ЗаписатьКИ(ТекДанные.Тип, ТекДанные.Вид, Объект.Ссылка, ТекДанные.Представление, ТекДанные.ЗначенияПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактыВидПриИзменении(Элемент)
	
	ТипКИ = ТипКонтактнойИнформации(Элементы.Контакты.ТекущиеДанные.Вид);
	Если НЕ ТипКИ = Элементы.Контакты.ТекущиеДанные.Тип Тогда
		Элементы.Контакты.ТекущиеДанные.Тип = ТипКИ;
		Элементы.Контакты.ТекущиеДанные.Представление = "";
		Элементы.Контакты.ТекущиеДанные.ЗначенияПолей = "";
	КонецЕсли;
	ТекДанные = Элементы.Контакты.ТекущиеДанные;
	ЗаписатьКИ(ТекДанные.Тип, ТекДанные.Вид, Объект.Ссылка, ТекДанные.Представление, ТекДанные.ЗначенияПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактыПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.Контакты.ТекущиеДанные;
	УдалитьКИ(ТекДанные.Тип, ТекДанные.Вид, Объект.Ссылка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьКИ(Тип, Вид, Ссылка)
	
	Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	Менеджер.Тип = Тип;
	Менеджер.Вид = Вид;
	Менеджер.Объект = Ссылка;
	Менеджер.Удалить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьКИ(Тип, Вид, Ссылка, Представление, ЗначенияПолей)
	
	Если НЕ ЗначениеЗаполнено(Представление) Тогда
		УдалитьКИ(Тип, Вид, Ссылка);
		Возврат
	КонецЕсли;
	Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	Менеджер.Тип = Тип;
	Менеджер.Вид = Вид;
	Менеджер.Объект = Ссылка;
	Менеджер.Представление = Представление;
	СписокПолей = Renault_УправлениеКонтактнойИнформацией.ПреобразоватьСтрокуВСписокПолей(ЗначенияПолей);
	Для Каждого Поле Из СписокПолей Цикл
		Если НЕ Неопределено = Метаданные.РегистрыСведений.КонтактнаяИнформация.Ресурсы.Найти(Поле.Представление) Тогда
			Менеджер[Поле.Представление] = Поле.Значение;
		КонецЕсли;
		Если Тип = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
			Если Поле.Представление = "НаименованиеСтраны" Тогда
				Менеджер.Комментарий = Поле.Значение;
			ИначеЕсли Поле.Представление = "ТипДома" Тогда
				Менеджер.ТипДома = Перечисления.ТипыДомов[Поле.Значение];
			ИначеЕсли Поле.Представление = "ТипКорпуса" Тогда
				Менеджер.ТипКорпуса = Перечисления.ТипыКорпусов[Поле.Значение];
			ИначеЕсли Поле.Представление = "ТипКвартиры" Тогда
				Менеджер.ТипКвартиры = Перечисления.ТипыКвартир[Поле.Значение];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Менеджер.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда //это новый
		Если Вопрос("Перед добавлением контактной информации клиента нужно сохранить в базе. Продоолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Записать();
		КонецЕсли;
	КонецЕсли;
	Отказ = НЕ ЗначениеЗаполнено(Объект.Ссылка)
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Изменены данные клиента", , ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Вопрос("Перед добавлением документов клиента необходимо записать. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Отказ = Истина;
			Возврат
		Иначе
			Записать();
			Документы.Отбор.Элементы[0].ПравоеЗначение = Объект.Ссылка;
			Отказ = НЕ ЗначениеЗаполнено(Объект.Ссылка);
		КонецЕсли
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПолноеПриИзменении(Элемент)
	
	Если Объект.ФормаСобственности = ПредопределенноеЗначение("Перечисление.ФормыСобственности.ЧастноеЛицо") Тогда
		Если ПустаяСтрока(Объект.Фамилия) И ПустаяСтрока(Объект.Имя) И ПустаяСтрока(Объект.Отчество) Тогда
			ОбновитьФИО()
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьФИО()
	
	МассивФИО = CRM_Клиент.ПолучитьМассивФИО(Объект.НаименованиеПолное);
	Объект.Фамилия 		= МассивФИО[0];
	Объект.Имя			= МассивФИО[1];
	Объект.Отчество		= МассивФИО[2];
	Объект.Наименование = СокрЛП(Объект.Фамилия + " " + Объект.Имя + " " + Объект.Отчество);
	
КонецПроцедуры

