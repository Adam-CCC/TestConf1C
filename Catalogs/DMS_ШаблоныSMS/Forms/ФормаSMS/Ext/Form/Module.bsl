&НаСервере
Функция ПолучитьТелефонОбъекта(Контрагент)
	
	Телефон = "";
	
	Если ЗначениеЗаполнено(Контрагент) И ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда	
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтактнаяИнформация.Вид КАК ВидТелефона,
		               |	КонтактнаяИнформация.Представление КАК ПредставлениеТелефона,
		               |	КонтактнаяИнформация.Поле1 КАК КодРегиона,
		               |	КонтактнаяИнформация.Поле2 КАК КодГорода,
		               |	КонтактнаяИнформация.Поле3 КАК НомерТелефона,
		               |	КонтактнаяИнформация.Поле4 КАК ВнутреннийНомер,
		               |	1 КАК Приоритет
		               |ИЗ
		               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		               |ГДЕ
		               |	КонтактнаяИнформация.Объект = &Контрагент
		               |	И КонтактнаяИнформация.Тип = &Тип
		               |	И КонтактнаяИнформация.ЗначениеПоУмолчанию
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	КонтактнаяИнформация.Вид,
		               |	КонтактнаяИнформация.Представление,
		               |	КонтактнаяИнформация.Поле1,
		               |	КонтактнаяИнформация.Поле2,
		               |	КонтактнаяИнформация.Поле3,
		               |	КонтактнаяИнформация.Поле4,
		               |	2
		               |ИЗ
		               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		               |ГДЕ
		               |	КонтактнаяИнформация.Объект = &Контрагент
		               |	И КонтактнаяИнформация.Тип = &Тип
		               |	И НЕ КонтактнаяИнформация.ЗначениеПоУмолчанию
		               |	И КонтактнаяИнформация.Вид = &ВидТелефонаМобильный
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	КонтактнаяИнформация.Вид,
		               |	КонтактнаяИнформация.Представление,
		               |	КонтактнаяИнформация.Поле1,
		               |	КонтактнаяИнформация.Поле2,
		               |	КонтактнаяИнформация.Поле3,
		               |	КонтактнаяИнформация.Поле4,
		               |	3
		               |ИЗ
		               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		               |ГДЕ
		               |	КонтактнаяИнформация.Объект = &Контрагент
		               |	И КонтактнаяИнформация.Тип = &Тип
		               |	И НЕ КонтактнаяИнформация.ЗначениеПоУмолчанию
		               |	И КонтактнаяИнформация.Вид = &ВидТелефонаКонтактный
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Приоритет";
		Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("ВидТелефонаМобильный", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонСотовый"));
		Запрос.УстановитьПараметр("ВидТелефонаКонтактный", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонКонтактный"));
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Телефон = Выборка.КодРегиона + Выборка.КодГорода + Выборка.НомерТелефона;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Телефон;
	
КонецФункции
//}
