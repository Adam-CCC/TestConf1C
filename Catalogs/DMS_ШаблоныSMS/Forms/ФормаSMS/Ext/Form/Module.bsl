&НаСервере
Процедура  НажатиеСервер()
    Шаблон = Справочники.DMS_ШаблоныSMS.НайтиПоКоду(СтрЗаменить(Этаформа.ТекущийЭлемент.Имя,"смс",""));
	Если Шаблон <> Справочники.DMS_ШаблоныSMS.ПустаяСсылка() тогда
		 СМС = Шаблон.ШаблонСообщения;
	КонецЕсли;	
	Если Клиент.Пол = Перечисления.ПолФизическихЛиц.Мужской тогда
		 СМС = СтрЗаменить(СМС,"Уважаемый(ая)","Уважаемый");
	ИначеЕсли Клиент.Пол = Перечисления.ПолФизическихЛиц.Женский Тогда
		 СМС = СтрЗаменить(СМС,"Уважаемый(ая)","Уважаемая");
	КонецЕсли;
	  СМС = СтрЗаменить(СМС,"[Клиент]",Клиент);
	  СМС = СтрЗаменить(СМС,"[Дилер]",Дилер);
	  // DMSREN-710
	  СМС = СтрЗаменить(СМС,"[ДатаВремя]",ДатаВремя);
	  // --
	  СМС = СтрЗаменить(СМС,"[Адрес]",Адрес); 
	  
	 НомерПолучателя = новый массив;
	 НомерПолучателя.Добавить("+"+Телефон);
	  // 
	  DMS_ОтправкаSMS.ОтправитьSMS(НомерПолучателя,СМС,);
	  Сообщить(СМС);
	  Сообщить ("Телефон " +Телефон);
//	 ОповеститьОВыборе(Шаблон); 
