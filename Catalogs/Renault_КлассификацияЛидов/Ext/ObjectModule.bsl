Процедура ПередЗаписью(Отказ)	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоНовый() Тогда 
		Возврат;
	КонецЕсли;
	
	ПоискДублей(Отказ);
КонецПроцедуры

Процедура ПоискДублей(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КлассификацияЛидов.Наименование КАК Наименование,
		|	КОЛИЧЕСТВО(Renault_КлассификацияЛидов.Ссылка) КАК КоличествоДублей
		|ИЗ
		|	Справочник.Renault_КлассификацияЛидов КАК Renault_КлассификацияЛидов
		|ГДЕ
		|	Renault_КлассификацияЛидов.Наименование ПОДОБНО &Наименование
		|
		|СГРУППИРОВАТЬ ПО
		|	Renault_КлассификацияЛидов.Наименование
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(Renault_КлассификацияЛидов.Ссылка) >= 1";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Отказ = Истина;
		Сообщить("Обнаружены дубли в количестве "+ВыборкаДетальныеЗаписи.КоличествоДублей+" шт. Запись элемента невозможна");
	КонецЦикла;
		
КонецПроцедуры


Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
