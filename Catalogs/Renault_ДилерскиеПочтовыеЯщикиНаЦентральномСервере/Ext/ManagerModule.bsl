
Функция ПолучитьОсновнойЯщикДляПочты(BIR) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.Ссылка
	|ИЗ
	|	Справочник.Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере КАК Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере
	|ГДЕ
	|	Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.BIR = &BIR
	|	И Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.ОсновнойДляПочты = ИСТИНА";
	Запрос.УстановитьПараметр("BIR", BIR);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

