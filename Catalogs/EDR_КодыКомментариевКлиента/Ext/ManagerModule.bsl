Функция СоздатьКодыПоСписку(СписокСтруктур) Экспорт
	
	Результат = Истина;
	
	Для каждого СтруктураЭлемента из СписокСтруктур Цикл
		
		CustomerCommCode = СтруктураЭлемента["CustomerCommCode"];
		
		//Ищем элемент
		ТекЭлемент = НайтиПоКоду(CustomerCommCode);
		Если НЕ ТекЭлемент = ПустаяСсылка() тогда 
			Элемент = ТекЭлемент.ПолучитьОбъект();
		Иначе
			Элемент = СоздатьЭлемент();
		КонецЕсли;
		
		Элемент.Код = CustomerCommCode;
		Элемент.Наименование = СтруктураЭлемента["CustomerComment"];
		
		Попытка
			
			Элемент.Записать();
			
			//Если есть хоть одна ошибка, в истину результат уже не выставляем
			Результат = ?(Результат, истина, ложь);
			
		Исключение
			
			Результат = Ложь;
			
		КонецПопытки; 
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

