 														НоменклатураОбъект.Записать();
													ИначеЕсли ЗначениеЗаполнено(ВыборкаЭлементовНаЯчейках.ЯчейкаНовый) И НЕ ЗначениеЗаполнено(ВыборкаЭлементовНаЯчейках.ЯчейкаОсновной) Тогда
														//Значит нужно просто снять с ячейки
														НоменклатураОбъект = ВыборкаЭлементовНаЯчейках.Номенклатура.ПолучитьОбъект();
														НайденнаяСТрока = НоменклатураОбъект.ЯчейкиХранения.Найти(НовыйСклад, "СкладКомпании");
														Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда
															СтрокаСнята = ТаблицаНоменклатураСнята.Добавить();
															СтрокаСнята.Номенклатура = ВыборкаЭлементовНаЯчейках.Номенклатура;
															СтрокаСнята.ЯчейкаХранения = НайденнаяСТрока.ЯчейкаХранения.Код;
															
															НоменклатураОбъект.ЯчейкиХранения.Удалить(НайденнаяСТрока);
														КонецЕсли;

														НоменклатураОбъект.Записать();
													КонецЕсли;
												КонецЦикла;												
											Иначе
												//3 случай
												УдалитьПодчиненные(ЯчейкаНовый, Неопределено, ТаблицаНоменклатураСнята);
											КонецЕсли;
										КонецЦикла; //ЯчейкиХранения
									Иначе
										//3 случай
										ПолкаНовыйОбъект = ПолкаНовый.ПолучитьОбъект();
										ПолкаНовыйОбъект.ПометкаУдаления = истина;
