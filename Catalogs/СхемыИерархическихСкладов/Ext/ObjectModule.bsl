										ПолкаНовыйОбъект.Записать();
										
										УдалитьПодчиненные(ПолкаНовый, "ЯчейкиХранения", ТаблицаНоменклатураСнята);
									КонецЕсли;
								КонецЦикла; //Полки
							Иначе
								//3 случай
								СтеллажНовыйОбъект = СтеллажНовый.ПолучитьОбъект();
								СтеллажНовыйОбъект.ПометкаУдаления = истина;
								Если ФлагКомментировать Тогда
									Сообщить("3.Удаляется стеллаж: ["+СтеллажНовыйОбъект.Код+"] "+СтеллажНовыйОбъект); 	
								КонецЕсли;
								
								СтеллажНовыйОбъект.Записать();
								
								УдалитьПодчиненные(СтеллажНовый, "Полки", ТаблицаНоменклатураСнята);
							КонецЕсли;
						КонецЦикла; //Стеллажи
					Иначе
						//3 случай
						РядНовыйОбъект = РядНовый.ПолучитьОбъект();
						РядНовыйОбъект.ПометкаУдаления = истина;
