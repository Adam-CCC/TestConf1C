		Возврат ИскомыйЭлемент;
	ИначеЕсли ТипЭлемента = "Стеллаж" Тогда
		ИскомыйЭлемент = Справочники.Стеллажи.НайтиПоКоду(Родитель.Код + "-" + НовоеИмяЭлемента,,,Родитель);
