
Функция ПолучитьТаблицуПоказателейДляСинхронизации(ВладелецОсновной, ВладелецНовый, Тип)
	ЗапросПоказателей = Новый Запрос();
	ЗапросПоказателей.Текст = "ВЫБРАТЬ
	                          |	ПоказателиНовый.Ссылка КАК ПоказательНовый
	                          |ПОМЕСТИТЬ ПоказателиНовый
	                          |ИЗ
	                          |	Справочник.%Тип% КАК ПоказателиНовый
	                          |ГДЕ
	                          |	ПоказателиНовый.%ТипВладельца% = &ВладелецНовый
	                          |;
	                          |
	                          |////////////////////////////////////////////////////////////////////////////////
	                          |ВЫБРАТЬ
	                          |	ПоказателиОсновной.Ссылка КАК ПоказательОсновной
	                          |ПОМЕСТИТЬ ПоказателиОсновной
	                          |ИЗ
	                          |	Справочник.%Тип% КАК ПоказателиОсновной
	                          |ГДЕ
	                          |	ПоказателиОсновной.%ТипВладельца% = &ВладелецОсновной
	                          |;
	                          |
	                          |////////////////////////////////////////////////////////////////////////////////
	                          |ВЫБРАТЬ
	                          |	ПоказателиНовый.ПоказательНовый,
	                          |	ПоказателиОсновной.ПоказательОсновной
	                          |ИЗ
	                          |	ПоказателиОсновной КАК ПоказателиОсновной
	                          |		ПОЛНОЕ СОЕДИНЕНИЕ ПоказателиНовый КАК ПоказателиНовый
	                          |		ПО ПоказателиОсновной.ПоказательОсновной.Код = ПоказателиНовый.ПоказательНовый.Код";	
	ЗапросПоказателей.Текст = СтрЗаменить(ЗапросПоказателей.Текст, "%Тип%", Тип);
	ЗапросПоказателей.Текст = СтрЗаменить(ЗапросПоказателей.Текст, "%ТипВладельца%", ?(Тип = "ЯчейкиХранения", "Полка", "Владелец"));
	ЗапросПоказателей.УстановитьПараметр("ВладелецНовый", ВладелецНовый);
	ЗапросПоказателей.УстановитьПараметр("ВладелецОсновной", ВладелецОсновной);
	
	Возврат ЗапросПоказателей.Выполнить().Выгрузить();
КонецФункции

Функция УдалитьПодчиненные(Показатель, Тип, ТаблицаСнятойНоменклатуры)
	СледующийТип = ?(Тип = "Ряды", "Стеллажи", ?(Тип = "Стеллажи", "Полки", ?(Тип = "Полки", "ЯчейкиХранения",Неопределено)));
	
	ЗапросДетей = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Показатели.Ссылка КАК Показатель
	               |ИЗ
	               |	Справочник.%Тип% КАК Показатели
	               |ГДЕ
	               |	Показатели.%ТипВладельца% = &Владелец
				   |	И НЕ Показатели.ПометкаУдаления";
	Если Тип <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%Тип%", Тип);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТипВладельца%", ?(Тип = "ЯчейкиХранения", "Полка", "Владелец"));
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%Тип%", "ЯчейкиХранения");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТипВладельца%", "Ссылка");
	КонецЕсли;
	ЗапросДетей.Текст = ТекстЗапроса;
	ЗапросДетей.УстановитьПараметр("Владелец", Показатель);
	
	ВыборкаИзЗапроса = ЗапросДетей.Выполнить().Выбрать();
	Пока ВыборкаИзЗапроса.Следующий() Цикл
		Если ТипЗнч(ВыборкаИзЗапроса.Показатель) = Тип("СправочникСсылка.ЯчейкиХранения") Тогда
			//Снимаем с ячеек
			ЗапросНоменклатурыНАЯчейке = Новый Запрос();
			ЗапросНоменклатурыНАЯчейке.Текст = "ВЫБРАТЬ
			                                   |	НоменклатураЯчейкиХранения.Ссылка КАК Номенклатура,
			                                   |	НоменклатураЯчейкиХранения.ЯчейкаХранения
			                                   |ИЗ
			                                   |	Справочник.Номенклатура.ЯчейкиХранения КАК НоменклатураЯчейкиХранения
			                                   |ГДЕ
			                                   |	НоменклатураЯчейкиХранения.ЯчейкаХранения = &ЯчейкаХранения";
			ЗапросНоменклатурыНАЯчейке.УстановитьПараметр("ЯчейкаХранения", ВыборкаИзЗапроса.Показатель);
			ВыборкаНоменклатурыНаЯчейке = ЗапросНоменклатурыНАЯчейке.Выполнить().Выбрать();
			
			Пока ВыборкаНоменклатурыНаЯчейке.Следующий() Цикл
				НоменклатураОбъект = ВыборкаНоменклатурыНаЯчейке.Номенклатура.ПолучитьОбъект();
				СтрокаДляУдаления = НоменклатураОбъект.ЯчейкиХранения.Найти(ВыборкаНоменклатурыНаЯчейке.ЯчейкаХранения, "ЯчейкаХранения");
				Если ЗначениеЗаполнено(СтрокаДляУдаления) Тогда
					НоменклатураОбъект.ЯчейкиХранения.Удалить(СтрокаДляУдаления);
				КонецЕсли;
				Попытка

					НоменклатураОбъект.Записать();
					//Пишем в табличку снятой номенклатуры
					ТаблицаСнятойНоменклатуры.Добавить();
					ТаблицаСнятойНоменклатуры.Номенклатура = НоменклатураОбъект.Ссылка;
					ТаблицаСнятойНоменклатуры.ЯчейкаХранения = ВыборкаИзЗапроса.Показатель.Код; 
				Исключение
					Возврат Ложь;
				КонецПопытки
			КонецЦикла;
		КонецЕсли;
		
		ПоказательДляУдаления = ВыборкаИзЗапроса.Показатель.ПолучитьОбъект();
		ПоказательДляУдаления.ПометкаУдаления = истина;
		Попытка 
			ПоказательДляУдаления.Записать();
		Исключение
			Возврат ложь;
		КонецПопытки;
		
		Если СледующийТип <> Неопределено И НЕ УдалитьПодчиненные(ПоказательДляУдаления.Ссылка, СледующийТип, ТаблицаСнятойНоменклатуры) Тогда
			Возврат ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат истина;
КонецФункции
		
Функция СинхронизацияСхемыСкладскихЯчеекСОсновной(НовыйСклад)
	ФлагКомментировать = Истина;
	Попытка
		ТаблицаНоменклатураРазмещена = Новый ТаблицаЗначений();
		ТаблицаНоменклатураРазмещена.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаНоменклатураРазмещена.Колонки.Добавить("ЯчейкаХранения", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));
		
		ТаблицаНоменклатураСнята = ТаблицаНоменклатураРазмещена.Скопировать();
		
		
		//Синхронизация зон
		ТаблицаЗон = ПолучитьТаблицуПоказателейДляСинхронизации(ОсновнойСкладСхемы, НовыйСклад, "Зоны");
		Для Каждого СтрокаТаблицыЗон Из ТаблицаЗон Цикл
			//Возможны 3 сценария развития событий
			//1 - Зона с таким кодом есть и там и там, тогда просто синхронизируем пометки удаления
			//2 - Зона есть только на основном - Тогда создаем зону
			//3 - Зона есть только на новом, тогда помечаем на удаление зону на новом, и все подчиненные (номенклатуру с ячеек снимаем
			ЗонаНовый = СтрокаТаблицыЗон.ПоказательНовый;
			ЗонаОсновной = СтрокаТаблицыЗон.ПоказательОсновной; 
			Если ЗначениеЗаполнено(ЗонаОсновной) Тогда
				Если ЗначениеЗаполнено(ЗонаНовый) ТОгда
					//1 случай
					Если ЗонаОсновной.ПометкаУдаления <> ЗонаНовый.ПометкаУдаления Тогда
						ЗонаНовыйОбъект = ЗонаНовый.ПолучитьОбъект();
						ЗонаНовыйОбъект.ПометкаУдаления = ЗонаОсновной.ПометкаУдаления;
						Если ФлагКомментировать Тогда
							Сообщить("1.Записывается зона: ["+ЗонаНовыйОбъект.Код+"] "+ЗонаНовыйОбъект); 	
						КонецЕсли;	
						ЗонаНовыйОбъект.Записать();
 					КонецЕсли;
				Иначе
					//2 случай
					ЗонаНовыйОбъект = Справочники.Зоны.СоздатьЭлемент();
					ЗонаНовыйОбъект.Владелец = НовыйСклад;
					ЗонаНовыйОбъект.ИдентификаторДляЯрлыка = ЗонаОсновной.ИдентификаторДляЯрлыка;
					ЗонаНовыйОбъект.ПометкаУдаления = ЗонаОсновной.ПометкаУдаления;
					ЗонаНовыйОбъект.Код = ЗонаОсновной.Код;
					Если ФлагКомментировать Тогда
						Сообщить("2.Записывается зона: ["+ЗонаНовыйОбъект.Код+"] "+ЗонаНовыйОбъект); 	
					КонецЕсли;	
 					ЗонаНовыйОбъект.Записать();
					ЗонаНовый = ЗонаНовыйОбъект.Ссылка;
				КонецЕсли;
				
				//Синхронизация рядов
				ТаблицаРядов = ПолучитьТаблицуПоказателейДляСинхронизации(ЗонаОсновной, ЗонаНовый, "Ряды");
				Для Каждого СтрокаТаблицыРядов Из ТаблицаРядов Цикл
					//Возможны 3 сценария развития событий
					//1 - Зона с таким кодом есть и там и там, тогда просто синхронизируем пометки удаления
					//2 - Зона есть только на основном - Тогда создаем зону
					//3 - Зона есть только на новом, тогда помечаем на удаление зону на новом, и все подчиненные (номенклатуру с ячеек снимаем
					РядОсновной = СтрокаТаблицыРядов.ПоказательОсновной;
					РядНовый = СтрокаТаблицыРядов.ПоказательНовый;
					
					Если ЗначениеЗаполнено(РядОсновной) Тогда
						Если ЗначениеЗаполнено(РядНовый) ТОгда
							//1 случай
							Если РядОсновной.ПометкаУдаления <> РядНовый.ПометкаУдаления Тогда
								РядНовыйОбъект = РядНовый.ПолучитьОбъект();
								РядНовыйОбъект.ПометкаУдаления = РядОсновной.ПометкаУдаления;
								Если ФлагКомментировать Тогда
									Сообщить("1.Записывается ряд: ["+РядНовыйОбъект.Код+"] "+РядНовыйОбъект); 	
								КонецЕсли;
								РядНовыйОбъект.Записать();
							КонецЕсли;
						Иначе
							//2 случай
							РядНовыйОбъект = Справочники.Ряды.СоздатьЭлемент();
							РядНовыйОбъект.Владелец = ЗонаНовый;
							РядНовыйОбъект.ИдентификаторДляЯрлыка = РядОсновной.ИдентификаторДляЯрлыка;
							РядНовыйОбъект.ПометкаУдаления = РядОсновной.ПометкаУдаления;
							РядНовыйОбъект.Код = РядОсновной.Код;
							Если ФлагКомментировать Тогда
								Сообщить("2.Записывается ряд: ["+РядНовыйОбъект.Код+"] "+РядНовыйОбъект); 	
							КонецЕсли;
 							РядНовыйОбъект.Записать();
							РядНовый = РядНовыйОбъект.Ссылка;
						КонецЕсли;
						//Синхронизация стеллажей
						ТаблицаСтеллажей = ПолучитьТаблицуПоказателейДляСинхронизации(РядОсновной, РядНовый, "Стеллажи");
						Для Каждого СтрокаТаблицыСтеллажей Из ТаблицаСтеллажей Цикл
							//Возможны 3 сценария развития событий
							//1 - Стеллаж с таким кодом есть и там и там, тогда просто синхронизируем пометки удаления
							//2 - Стеллаж есть только на основном - Тогда создаем Стеллаж
							//3 - Стеллаж есть только на новом, тогда помечаем на удаление стеллаж на новом, и все подчиненные (номенклатуру с ячеек снимаем
							СтеллажОсновной = СтрокаТаблицыСтеллажей.ПоказательОсновной;
							СтеллажНовый = СтрокаТаблицыСтеллажей.ПоказательНовый;
							
							Если ЗначениеЗаполнено(СтеллажОсновной) Тогда
								Если ЗначениеЗаполнено(СтеллажНовый) ТОгда
									//1 случай
									Если СтеллажОсновной.ПометкаУдаления <> СтеллажНовый.ПометкаУдаления Тогда
										СтеллажНовыйОбъект = СтеллажНовый.ПолучитьОбъект();
										СтеллажНовыйОбъект.ПометкаУдаления = СтеллажОсновной.ПометкаУдаления;
										Если ФлагКомментировать Тогда
											Сообщить("1.Записывается Стеллаж: ["+СтеллажНовыйОбъект.Код+"] "+СтеллажНовыйОбъект); 	
										КонецЕсли;
 										СтеллажНовыйОбъект.Записать();
									КонецЕсли;
								Иначе
									//2 случай
									СтеллажНовыйОбъект = Справочники.Стеллажи.СоздатьЭлемент();
									СтеллажНовыйОбъект.Владелец = РядНовый;
									СтеллажНовыйОбъект.ИдентификаторДляЯрлыка = СтеллажОсновной.ИдентификаторДляЯрлыка;
									СтеллажНовыйОбъект.ПометкаУдаления = СтеллажОсновной.ПометкаУдаления;
									СтеллажНовыйОбъект.Код = СтеллажОсновной.Код;
									Если ФлагКомментировать Тогда
										Сообщить("2.Записывается Стеллаж: ["+СтеллажНовыйОбъект.Код+"] "+СтеллажНовыйОбъект); 	
									КонецЕсли;
 									СтеллажНовыйОбъект.Записать();
									СтеллажНовый = СтеллажНовыйОбъект.Ссылка;
								КонецЕсли;
								//Синхронизация полок
								ТаблицаПолок = ПолучитьТаблицуПоказателейДляСинхронизации(СтеллажОсновной, СтеллажНовый, "Полки");
								Для Каждого СтрокаТаблицыПолок Из ТаблицаПолок Цикл
									//Возможны 3 сценария развития событий
									//1 - Полка с таким кодом есть и там и там, тогда просто синхронизируем пометки удаления
									//2 - Полка есть только на основном - Тогда создаем полку
									//3 - Полка есть только на новом, тогда помечаем на удаление стеллаж на новом, и все подчиненные (номенклатуру с ячеек снимаем
									ПолкаОсновной = СтрокаТаблицыПолок.ПоказательОсновной;
									ПолкаНовый = СтрокаТаблицыПолок.ПоказательНовый;
									
									Если ЗначениеЗаполнено(ПолкаОсновной) Тогда
										Если ЗначениеЗаполнено(ПолкаНовый) ТОгда
											//1 случай
											Если ПолкаОсновной.ПометкаУдаления <> ПолкаНовый.ПометкаУдаления Тогда
												ПолкаНовыйОбъект = ПолкаНовый.ПолучитьОбъект();
												ПолкаНовыйОбъект.ПометкаУдаления = ПолкаОсновной.ПометкаУдаления;
												Если ФлагКомментировать Тогда
													Сообщить("1.Записывается Полка: ["+ПолкаНовыйОбъект.Код+"] "+ПолкаНовыйОбъект); 	
												КонецЕсли;
 												ПолкаНовыйОбъект.Записать();
											КонецЕсли;
										Иначе
											//2 случай
											ПолкаНовыйОбъект = Справочники.Полки.СоздатьЭлемент();
											ПолкаНовыйОбъект.Владелец = СтеллажНовый;
											ПолкаНовыйОбъект.ИдентификаторДляЯрлыка = ПолкаОсновной.ИдентификаторДляЯрлыка;
											ПолкаНовыйОбъект.ПометкаУдаления = ПолкаОсновной.ПометкаУдаления;
											ПолкаНовыйОбъект.Код = ПолкаОсновной.Код;
											Если ФлагКомментировать Тогда
												Сообщить("2.Записывается Полка: ["+ПолкаНовыйОбъект.Код+"] "+ПолкаНовыйОбъект); 	
											КонецЕсли;
 											ПолкаНовыйОбъект.Записать();
											ПолкаНовый = ПолкаНовыйОбъект.Ссылка;
										КонецЕсли;
										//Синхронизация Ячеек (самый сложный случай, т.к. нужно еще синхронизировать номенклатуру)
										ТаблицаЯчеек = ПолучитьТаблицуПоказателейДляСинхронизации(ПолкаОсновной, ПолкаНовый, "ЯчейкиХранения");
										Для Каждого СтрокаТаблицыЯчеек Из ТаблицаЯчеек Цикл
											//Возможны 3 сценария развития событий
											//1 - Ячейка с таким кодом есть и там и там, тогда просто синхронизируем пометки удаления
											//2 - Ячейка есть только на основном - Тогда создаем ячейку
											//3 - Ячейка есть только на новом, тогда помечаем на удаление стеллаж на новом, и все подчиненные (номенклатуру с ячеек снимаем
											ЯчейкаОсновной = СтрокаТаблицыЯчеек.ПоказательОсновной;
											ЯчейкаНовый = СтрокаТаблицыЯчеек.ПоказательНовый;
											
											Если ЗначениеЗаполнено(ЯчейкаОсновной) Тогда
												Если ЗначениеЗаполнено(ЯчейкаНовый) ТОгда
													//1 случай
													Если ЯчейкаОсновной.ПометкаУдаления <> ЯчейкаНовый.ПометкаУдаления Тогда
														ЯчейкаНовыйОбъект = ЯчейкаНовый.ПолучитьОбъект();
														ЯчейкаНовыйОбъект.ПометкаУдаления = ЯчейкаОсновной.ПометкаУдаления;
														Если ФлагКомментировать Тогда
															Сообщить("1.Записывается Ячейка: ["+ЯчейкаНовыйОбъект.Код+"] "+ЯчейкаНовыйОбъект); 	
														КонецЕсли;
 														ЯчейкаНовыйОбъект.Записать();
													КонецЕсли;
												Иначе
													//2 случай
													ЯчейкаНовыйОбъект 					= Справочники.ЯчейкиХранения.СоздатьЭлемент();
													ЯчейкаНовыйОбъект.Владелец 			= НовыйСклад;
													ЯчейкаНовыйОбъект.Полка 			= ПолкаНовый;
