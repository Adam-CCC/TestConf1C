		КонецЦикла; //Зоны

		//Сформируем отчет по позициям, которые снимались/устанавливались на ячейки
		ЗапросЗаписей = Новый Запрос();
		ЗапросЗаписей.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ЗапросЗаписей.Текст = "ВЫБРАТЬ
		                      |	ТаблицаРазмещено.Номенклатура,
