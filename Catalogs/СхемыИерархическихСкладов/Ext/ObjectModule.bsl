		ИначеЕсли ИскомыйЭлемент.ПометкаУдаления Тогда
			
			#Если Клиент Тогда
			Ответ = Вопрос("Полка " + ИскомыйЭлемент.Код + " помечена на удаление. Воостановить полку?", РежимДиалогаВопрос.ДаНет);
			#Иначе
			Ответ = КодВозвратаДиалога.Да;
			#КонецЕсли
				
			Если ОТвет = КодВозвратаДиалога.Да Тогда
				ЭлементОбъект = ИскомыйЭлемент.ПолучитьОбъект();
				ЭлементОбъект.ПометкаУдаления = ложь;
				Попытка
					ЭлементОбъект.Записать();
				Исключение
					Возврат ложь;
				КонецПопытки;
				ИскомыйЭлемент = ЭлементОбъект.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		Возврат ИскомыйЭлемент;
	ИначеЕсли ТипЭлемента = "Ячейка" Тогда
		//Получим склад Полка.Стеллаж.Ряд.Зона.Склад
		СкладВладелец = Родитель.Владелец.Владелец.Владелец.Владелец;
		ИскомыйЭлемент = Справочники.ЯчейкиХранения.НайтиПоКоду(Родитель.Код + "-" + НовоеИмяЭлемента,,,СкладВладелец);
		Если НЕ ЗначениеЗаполнено(ИскомыйЭлемент) Тогда
			ЭлементОбъект = Справочники.ЯчейкиХранения.СоздатьЭлемент();
			ЭлементОбъект.НомерЯчейки = НовоеИмяЭлемента;
			ЭлементОбъект.Код = Родитель.Код + "-" + НовоеИмяЭлемента;
			ЭлементОбъект.Владелец = СкладВладелец;
			ЭлементОбъект.Полка = Родитель;
			ЭлементОбъект.Стеллаж = Родитель.Владелец;
			ЭлементОбъект.Ряд = Родитель.Владелец.Владелец;
			ЭлементОбъект.Зона = Родитель.Владелец.Владелец.Владелец;
			
			Попытка
				ЭлементОбъект.Записать();
			Исключение
				Возврат ложь;
			КонецПопытки;
			
			ИскомыйЭлемент = ЭлементОбъект.Ссылка;
		ИначеЕсли ИскомыйЭлемент.ПометкаУдаления Тогда
			
			#Если Клиент Тогда
			Ответ = Вопрос("Ячейка " + ИскомыйЭлемент.Код + " помечена на удаление. Воостановить ячейку?", РежимДиалогаВопрос.ДаНет);
			#Иначе
			Ответ = КодВозвратаДиалога.Да;
			#КонецЕсли
				
			Если ОТвет = КодВозвратаДиалога.Да Тогда
				ЭлементОбъект = ИскомыйЭлемент.ПолучитьОбъект();
				ЭлементОбъект.ПометкаУдаления = ложь;
				Попытка
					ЭлементОбъект.Записать();
				Исключение
					Возврат ложь;
				КонецПопытки;
				ИскомыйЭлемент = ЭлементОбъект.Ссылка;
			КонецЕсли;
		КонецЕсли;
		Возврат ИскомыйЭлемент;
	Иначе
		Возврат(Неопределено);
	КонецЕсли;
КонецФункции

//Функция НазначитьЯчейки
//Функция предназанчена для назначения иерархических складских ячеек на группу складов (соответствующих ДЦ и СхемеРазмещения)
//Принимаемые параметры:
//ТаблицаНоменклатурыИЯчеек 	- Таблица, содержащая колонки Номенклатура, Зона, Ряд, Стеллаж, Полка, Ячейка
Функция НазначитьЯчейки(ТаблицаНоменклатурыИЯчеек) Экспорт
	НачатьТранзакцию();
	ТаблицаНоменклатуры = Новый ТаблицаЗначений();
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура");
	ТаблицаНоменклатуры.Колонки.Добавить("ЯчейкаХранения");
	
	Для Каждого СтрокаТаблицыНоменклатурыИЯчеек Из ТаблицаНоменклатурыИЯчеек Цикл
		НоменклатураОбъект = СтрокаТаблицыНоменклатурыИЯчеек.Номенклатура.ПолучитьОбъект();
		ЗаписыватьНоменклатуру = ложь;
		
		Для Каждого СтрокаСклада Из Склады Цикл
			

			СкладКомпании = СтрокаСклада.СкладКомпании;
			
			ЗонаСклада = НайтиЭлемент(СтрокаТаблицыНоменклатурыИЯчеек.Зона, "Зона", СкладКомпании);
			Если ЗонаСклада = Неопределено Тогда
				Сообщить("В схеме не найдена или помечена на удаление зона " + СтрокаТаблицыНоменклатурыИЯчеек.Зона + ". Нет прав на создание новых зон");
				ОтменитьТранзакцию();
				Возврат ложь;
			ИначеЕсли ЗонаСклада = Ложь Тогда
				Сообщить("Не удалось записать зону " + СтрокаТаблицыНоменклатурыИЯчеек.Зона);
				ОтменитьТранзакцию();
				Возврат ложь;
			КонецЕсли;
			
			РядСклада = НайтиЭлемент(СтрокаТаблицыНоменклатурыИЯчеек.Ряд, "Ряд", ЗонаСклада);
			Если РядСклада = Неопределено Тогда
				Сообщить("В зоне " + ЗонаСклада.ИдентификаторДляЯрлыка + " не найден или помечен на удаление ряд " + СтрокаТаблицыНоменклатурыИЯчеек.Ряд + ". Нет прав на создание новых рядов");
				ОтменитьТранзакцию();
				Возврат ложь;
			ИначеЕсли РядСклада = Ложь Тогда
				Сообщить("Не удалось записать ряд " + СтрокаТаблицыНоменклатурыИЯчеек.Ряд);
				ОтменитьТранзакцию();
				Возврат ложь;
			КонецЕсли;
			
			СтеллажСклада = НайтиЭлемент(СтрокаТаблицыНоменклатурыИЯчеек.Стеллаж, "Стеллаж", РядСклада);
			Если СтеллажСклада = Неопределено Тогда
				Сообщить("В зоне " + СтрокаТаблицыНоменклатурыИЯчеек.Зона + " в ряду " + СтрокаТаблицыНоменклатурыИЯчеек.Ряд + " не найден или помечен на удаление стеллаж " + СтрокаТаблицыНоменклатурыИЯчеек.Стеллаж + ". Нет прав на создание новых стеллажей");
				ОтменитьТранзакцию();
				Возврат ложь;
			ИначеЕсли СтеллажСклада = Ложь Тогда
				Сообщить("Не удалось записать стеллаж " + СтрокаТаблицыНоменклатурыИЯчеек.Стеллаж);
				ОтменитьТранзакцию();
				Возврат ложь;
			КонецЕсли;
			
			ПолкаСклада = НайтиЭлемент(СтрокаТаблицыНоменклатурыИЯчеек.Полка, "Полка", СтеллажСклада);
			Если ПолкаСклада = Неопределено ИЛИ ПолкаСклада = ложь Тогда
				Сообщить("Не удалось записать полку");
				ОтменитьТранзакцию();
				Возврат ложь;
			КонецЕсли;
			
			ЯчейкаСклад = НайтиЭлемент(СтрокаТаблицыНоменклатурыИЯчеек.Ячейка, "Ячейка", ПолкаСклада);
			Если ЯчейкаСклад = Неопределено Или ЯчейкаСклад = ложь Тогда
				Сообщить("Не удалось записать ячейку");
				ОтменитьТранзакцию();
				Возврат ложь;
			КонецЕсли;
			
			ПолучитьНоменклатуруНаЯчейке(ЯчейкаСклад, ТаблицаНоменклатуры, НоменклатураОбъект.Ссылка);
			
			СуществующаяСтрока = НоменклатураОбъект.ЯчейкиХранения.Найти(СкладКомпании, "СкладКомпании");
			Если СуществующаяСтрока <> Неопределено Тогда
				Если СуществующаяСтрока.ЯчейкаХранения <> ЯчейкаСклад Тогда
					//Тут запишем представление старой ячейки в регистр
					СуществующаяСтрока.ЯчейкаХранения = ЯчейкаСклад;
					ЗаписыватьНоменклатуру = истина;
				КонецЕсли;
			Иначе
				СтрокаЯчейки = НоменклатураОбъект.ЯчейкиХранения.Добавить();
				СтрокаЯчейки.СкладКомпании = СкладКомпании;
				СтрокаЯчейки.ЯчейкаХранения = ЯчейкаСклад;
				ЗаписыватьНоменклатуру = истина;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗаписыватьНоменклатуру Тогда
			Попытка

				НоменклатураОбъект.Записать();
			Исключение
				ОтменитьТранзакцию();
				Возврат ложь;
			КонецПопытки
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНоменклатуры.Свернуть("Номенклатура, ЯчейкаХранения");
	Если ТаблицаНоменклатуры.Количество() <> 0 Тогда
		ТекстВопроса = "На ячейках уже есть номенклатура: ";
		Для Каждого СтрокаТаблицыНоменклатуры Из ТаблицаНоменклатуры Цикл
			ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.Таб +"Ячейка " + СтрокаТаблицыНоменклатуры.ЯчейкаХранения + " Номенклатура (" + СтрокаТаблицыНоменклатуры.Номенклатура.Артикул + ") " + СтрокаТаблицыНоменклатуры.Номенклатура.Наименование;
		КонецЦикла;
		ТекстВопроса = ТекстВопроса + Символы.ПС + "продолжить?";
		
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			ОтменитьТранзакцию();
			Возврат ложь;
		КонецЕсли;
	КонецЕсли; 
	
	ЗафиксироватьТранзакцию();
	Возврат истина;
КонецФункции

//Функция НазначитьЯчейкиДляОбъекта
//Функция предназначена для заполнения таблицы ячеек внутри формы номенклатуры
//Принимаемые значения:
//НоменклатураОбъект - Номенклатура для заполнения. Объект из формы
//СтурктураПолей - структура, в которой содержатся значения полей Идентификатор зоны, ряда, сталлажа, полки, ячейки.
//Структура("Зона, Ряд, Стеллаж, Полка, Ячейка");
//Для ячеки идентификатором является реквизит Номер Ячейки"
Функция НазначитьЯчейкиДляОбъекта(НоменклатураОбъект, СтруктураПолей) Экспорт
	НачатьТранзакцию();
	ТаблицаНоменклатуры = Новый ТаблицаЗначений();
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура");
	ТаблицаНоменклатуры.Колонки.Добавить("ЯчейкаХранения");
	
	
	Для Каждого СтрокаСклада Из Склады Цикл
		СкладКомпании = СтрокаСклада.СкладКомпании;
		
		ЗонаСклада = НайтиЭлемент(СтруктураПолей.Зона, "Зона", СкладКомпании);
		Если ЗонаСклада = Неопределено Тогда
			Сообщить("В схеме не найдена или помечена на удаление зона " + СтруктураПолей.Зона + ". Нет прав на создание новых зон");
			ОтменитьТранзакцию();
			Возврат ложь;
		ИначеЕсли ЗонаСклада = Ложь Тогда
			Сообщить("Не удалось записать зону " + СтруктураПолей.Зона);
			ОтменитьТранзакцию();
			Возврат ложь;
		КонецЕсли;
		
		РядСклада = НайтиЭлемент(СтруктураПолей.Ряд, "Ряд", ЗонаСклада);
		Если РядСклада = Неопределено Тогда
			Сообщить("В зоне " + ЗонаСклада.ИдентификаторДляЯрлыка + " не найден или помечен на удаление ряд " + СтруктураПолей.Ряд + ". Нет прав на создание новых рядов");
			ОтменитьТранзакцию();
			Возврат ложь;
		ИначеЕсли РядСклада = Ложь Тогда
			Сообщить("Не удалось записать ряд " + СтруктураПолей.Ряд);
			ОтменитьТранзакцию();
			Возврат ложь;
		КонецЕсли;
		
		СтеллажСклада = НайтиЭлемент(СтруктураПолей.Стеллаж, "Стеллаж", РядСклада);
		Если СтеллажСклада = Неопределено Тогда
			Сообщить("В зоне " + СтруктураПолей.Зона + " в ряду " + СтруктураПолей.Ряд + " не найден или помечен на удаление стеллаж " + СтруктураПолей.Стеллаж + ". Нет прав на создание новых стеллажей");
			ОтменитьТранзакцию();
			Возврат ложь;
		ИначеЕсли СтеллажСклада = Ложь Тогда
			Сообщить("Не удалось записать стеллаж " + СтруктураПолей.Стеллаж);
			ОтменитьТранзакцию();
			Возврат ложь;
		КонецЕсли;
		
		ПолкаСклада = НайтиЭлемент(СтруктураПолей.Полка, "Полка", СтеллажСклада);
		Если ПолкаСклада = Неопределено ИЛИ ПолкаСклада = ложь Тогда
			Сообщить("Не удалось записать полку");
			ОтменитьТранзакцию();
			Возврат ложь;
		КонецЕсли;
		
		ЯчейкаСклад = НайтиЭлемент(СтруктураПолей.Ячейка, "Ячейка", ПолкаСклада);
		Если ЯчейкаСклад = Неопределено Или ЯчейкаСклад = ложь Тогда
			Сообщить("Не удалось записать ячейку");
			ОтменитьТранзакцию();
			Возврат ложь;
		КонецЕсли;
		
		ПолучитьНоменклатуруНаЯчейке(ЯчейкаСклад, ТаблицаНоменклатуры);
		
		СуществующаяСтрока = НоменклатураОбъект.ЯчейкиХранения.Найти(СкладКомпании, "СкладКомпании");
		Если СуществующаяСтрока <> Неопределено Тогда
			Если СуществующаяСтрока.ЯчейкаХранения <> ЯчейкаСклад Тогда
				//Тут запишем представление старой ячейки в регистр
				СуществующаяСтрока.ЯчейкаХранения = ЯчейкаСклад;
			КонецЕсли;
		Иначе
			СтрокаЯчейки = НоменклатураОбъект.ЯчейкиХранения.Добавить();
			СтрокаЯчейки.СкладКомпании = СкладКомпании;
			СтрокаЯчейки.ЯчейкаХранения = ЯчейкаСклад;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНоменклатуры.Свернуть("Номенклатура");
	Если ТаблицаНоменклатуры.Количество() <> 0 Тогда
		ТекстВопроса = "На ячейке уже есть номенклатура: ";
		Для Каждого СтрокаТаблицыНоменклатуры Из ТаблицаНоменклатуры Цикл
			ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.Таб + "(" + СтрокаТаблицыНоменклатуры.Номенклатура.Артикул + ") " + СтрокаТаблицыНоменклатуры.Номенклатура.Наименование;
		КонецЦикла;
		
		Сообщить(ТекстВопроса);
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	Возврат истина;
КонецФункции

Процедура ПолучитьНоменклатуруНаЯчейке(ЯчейкаХранения, ТаблицаНоменклатуры, НоваяНоменклатура = Неопределено)
	
	ЗапросНоменклатуры = Новый Запрос();
	ЗапросНоменклатуры.Текст = "ВЫБРАТЬ
	                           |	НоменклатураЯчейкиХранения.Ссылка КАК Номенклатура
	                           |ИЗ
	                           |	Справочник.Номенклатура.ЯчейкиХранения КАК НоменклатураЯчейкиХранения
	                           |ГДЕ
	                           |	НоменклатураЯчейкиХранения.ЯчейкаХранения = &ЯчейкаХранения
	                           |	И НоменклатураЯчейкиХранения.Ссылка <> &Номенклатура
	                           |
	                           |СГРУППИРОВАТЬ ПО
	                           |	НоменклатураЯчейкиХранения.Ссылка";
	ЗапросНоменклатуры.УстановитьПараметр("ЯчейкаХранения", ЯчейкаХранения);
	ЗапросНоменклатуры.УстановитьПараметр("Номенклатура", НоваяНоменклатура);
	РезультатЗапроса = ЗапросНоменклатуры.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл
		СтрокаТаблицы = ТаблицаНоменклатуры.Добавить();
		СтрокаТаблицы.Номенклатура = РезультатЗапроса.Номенклатура;
		СтрокаТаблицы.ЯчейкаХранения = СокрЛП(ЯчейкаХранения.Код);
	КонецЦикла;
КОнецПроцедуры





			
			
			
				
	

		
								
							
						

						
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
				
	

		
								
							
						

						
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			