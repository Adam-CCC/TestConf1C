							Сообщить("3.Удаляется ряд: ["+РядНовыйОбъект.Код+"] "+РядНовыйОбъект); 	
						КонецЕсли;
						
						РядНовыйОбъект.Записать();
						
						УдалитьПодчиненные(РядНовый, "Стеллажи", ТаблицаНоменклатураСнята);
