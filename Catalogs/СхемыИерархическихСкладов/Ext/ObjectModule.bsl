					СтрокаТабДок.Параметры.Ячейка = СокрЛП(ВыборкаСтрок.ЯчейкаСнято);
					
					ТабДокумент.Вывести(СтрокаТабДок);
				КонецЦикла;
				ТабДокумент.ЗакончитьГруппуСтрок();
				ТабДокумент.Вывести(МакетОТчета.ПолучитьОбласть("Разделитель"));	
			ИначеЕсли РезультатЗапроса.Порядок = 3 Тогда
				//Это перемещение
				ТабДокумент.Вывести(МакетОТчета.ПолучитьОбласть("Заголовок3"));
				ТабДокумент.Вывести(МакетОТчета.ПолучитьОбласть("ШапкаТаблицы3"));
				ВыборкаСтрок = РезультатЗапроса.Выбрать();
				ТабДокумент.НачатьГруппуСтрок();
				Пока ВыборкаСтрок.Следующий() Цикл
					СтрокаТабДок = МакетОТчета.ПолучитьОбласть("СтрокаТаблицы3");
					СтрокаТабДок.Параметры.Номенклатура = ВыборкаСтрок.Номенклатура;
					СтрокаТабДок.Параметры.Артикул = ВыборкаСтрок.Номенклатура.Артикул;
					СтрокаТабДок.Параметры.ЯчейкаСнято = СокрЛП(ВыборкаСтрок.ЯчейкаСнято);
					СтрокаТабДок.Параметры.ЯчейкаРазмещено = СокрЛП(ВыборкаСтрок.ЯчейкаРазмещено);
					
					ТабДокумент.Вывести(СтрокаТабДок);
				КонецЦикла;
				ТабДокумент.ЗакончитьГруппуСтрок();
				ТабДокумент.Вывести(МакетОТчета.ПолучитьОбласть("Разделитель"));
			КонецЕсли;
		КонецЦикла;
			
		ТабДокумент.Показать();
	Исключение
		Сообщить("Не удалось синхронизировать склады");
		Возврат ложь;
	КонецПопытки;
	Возврат истина;
КонецФункции

Процедура ДобавитьСклады(Отказ, СписокНовыхСкладов)
	
	//Проверим, не входит ли склад в другую схему
	ЗапросСхем = Новый Запрос();
	ЗапросСхем.Текст = "ВЫБРАТЬ
	                   |	СхемыИерархическихСкладовСклады.Ссылка КАК Схема,
					   |	СхемыИерархическихСкладовСклады.СкладКомпании КАК Склад
	                   |ИЗ
	                   |	Справочник.СхемыИерархическихСкладов.Склады КАК СхемыИерархическихСкладовСклады
	                   |ГДЕ
	                   |	СхемыИерархическихСкладовСклады.СкладКомпании В (&СписокСкладов)
	                   |	И СхемыИерархическихСкладовСклады.Ссылка <> &Ссылка";
	ЗапросСхем.УстановитьПараметр("СписокСкладов", СписокНовыхСкладов);
	ЗапросСхем.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = ЗапросСхем.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Количество() <> 0 Тогда
		ТекстОшибок = "Следующие склады используются в других схемах:";
		Пока РезультатЗапроса.Следующий() Цикл
			ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + РезультатЗапроса.Склад + " используется в схеме " + РезультатЗапроса.Схема;
		КонецЦикла;
		ТекстОшибок = ТекстОшибок + Символы.ПС + "запись невозможна";
		Отказ = истина;
		Возврат;
	КОнецЕсли;
	
	Для Каждого СкладДляДОбавленияЭлемент Из СписокНовыхСкладов Цикл
		СкладДляДОбавления = СкладДляДОбавленияЭлемент.Значение;
		Если СкладДляДОбавления.ИдентификаторДляЯрлыка <> ИдентификаторСхемы Тогда
			Если НЕ ИзменитьИдентификаторСхемыСклада(СкладДляДОбавления) Тогда
				ОТказ = истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ СинхронизацияСхемыСкладскихЯчеекСОсновной(СкладДляДОбавления) ТОгда
			Отказ = истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
КОнецПроцедуры
			
Функция ПолучитьНовыеСклады()
	// Бондаренко 20151005 ++
	СписокНовыхСкладов = Новый СписокЗначений;
	// Бондаренко 20151005 --
	
	Если НЕ ЭтоНовый() Тогда
		// Бондаренко 20151005 ++
		// закомментировал и вынес за пределы цикла
		//СписокНовыхСкладов = Новый СписокЗначений;
		// Бондаренко 20151005 --
		Для Каждого Склад Из Склады Цикл
			Если Склад.СкладКомпании <> ОсновнойСкладСхемы Тогда
				НайденныйСклад = Ссылка.Склады.Найти(Склад.СкладКомпании, "СкладКомпании");
				Если НЕ ЗначениеЗаполнено(НайденныйСклад) Тогда 
					СписокНовыхСкладов.Добавить(Склад.СкладКомпании);
				КОнецЕслИ;
			КонецЕсли;
		КОнецЦикла;
	КонецЕсли;
	Возврат СписокНовыхСкладов;
КонецФункции

Функция ИзменитьИдентификаторСхемыСклада(СкладКомпании)
	СкладКомпанииОбъект = СкладКомпании.ПолучитьОбъект();
	СкладКомпанииОбъект.ИдентификаторДляЯрлыка = ИдентификаторСхемы;
	Попытка
		СкладКомпанииОбъект.Записать();
	Исключение
		Сообщить("Не удалось изменить идентификатор склада, для склада " + СкладКомпании);
		Возврат ложь;
	КонецПопытки;
 	Возврат истина;
КонецФункции

Процедура ПриЗаписи(Отказ)
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Склады.Свернуть("СкладКомпании");
	ОсновнойСкладВТЧ = Склады.Найти(ОсновнойСкладСхемы, "СкладКомпании");
	Если НЕ ЗначениеЗаполнено(ОсновнойСкладВТЧ) Тогда
		СтрокаОсновногоСклада = Склады.Добавить();
		СтрокаОсновногоСклада.СкладКомпании = ОсновнойСкладСхемы;
	КонецЕсли;
	
	Отказ = НЕ ПроверитьЗаполнениеПолей();
	
	Если ОТказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() ИЛИ Ссылка.ИдентификаторСхемы <> ИдентификаторСхемы ТОгда
		НачатьТранзакцию();
		Для Каждого СкладКомпании Из Склады Цикл
			Если НЕ ИзменитьИдентификаторСхемыСклада(СкладКомпании.СкладКомпании) Тогда
				ОтменитьТранзакцию();
				Отказ = истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	Если НЕ Отказ Тогда
		СписокНовыхСкладов = ПолучитьНовыеСклады();
		Если СписокНовыхСкладов.Количество() <> 0 Тогда
			НачатьТранзакцию();
			ДобавитьСклады(Отказ, СписокНовыхСкладов);
			Если Отказ Тогда
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьЗаполнениеПолей();
	ТекстОшибок = "Не указаны следующие поля:";
	Ошибка = ложь;
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "Не указано имя для схемы";
		Ошибка = истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "Не указандилерский центр";
		Ошибка = истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторСхемы) Тогда
		ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "Не указан идентификатор для схемы";
		Ошибка = истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОсновнойСкладСхемы) Тогда
		ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "Не указан основной склад для схемы";
		Ошибка = истина;
	КонецЕсли;
	
	//Бондаренко 20160518 ++
	Если НЕ РольДоступна("ПолныеПрава") Тогда
 	//Бондаренко 20160518 --
		Если НЕ ЭтоНовый() И ОсновнойСкладСхемы <> Ссылка.ОсновнойСкладСхемы Тогда
			ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "Нельзя менять основной склад схемы для существующей схемы";
			Ошибка = истина;
		КонецЕсли;
	//Бондаренко 20160518 ++	
	КонецЕсли;
	//Бондаренко 20160518 --
	
	Если НЕ Ошибка Тогда
		Для Каждого СтрокаСклада Из Склады Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаСклада.СкладКомпании) Тогда
				ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "В строке " + СтрокаСклада.НомерСтроки + " не указан склад";
				Ошибка = истина;
			КОнецЕсли;
			
			Если СтрокаСклада.СкладКомпании.Подразделение.ДилерскийЦентр <> ДилерскийЦентр Тогда   
				// Холышевская ++ 08.04.2026 #10598 
				// БЫЛО
				//ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "В строке " + СтрокаСклада.НомерСтроки + " дилерский центр склада не соответствует дилерскому центру схемы";
				//Ошибка = истина;   
				// СТАЛО
				Если НЕ ((СтрокаСклада.СкладКомпании.Подразделение.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Шолохова237
					И ДилерскийЦентр = Справочники.ДилерскиеЦентры.НайтиПоКоду("000000019")) ИЛИ  
					(СтрокаСклада.СкладКомпании.Подразделение.ДилерскийЦентр = Справочники.ДилерскиеЦентры.НайтиПоКоду("000000019") 					
					ИЛИ ДилерскийЦентр = Справочники.ДилерскиеЦентры.Шолохова237)) Тогда
					ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.Таб + "В строке " + СтрокаСклада.НомерСтроки + " дилерский центр склада не соответствует дилерскому центру схемы";
					Ошибка = истина;   
				КонецЕсли;      
				// Холышевская -- 08.04.2026
			КОнецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Ошибка Тогда
		ТекстОшибок = ТекстОшибок + Символы.ПС + "Запись невозможна!";
		Сообщить(ТекстОшибок, СтатусСообщения.Важное);
	КонецЕслИ;
	Возврат НЕ Ошибка;
КонецФункции	

