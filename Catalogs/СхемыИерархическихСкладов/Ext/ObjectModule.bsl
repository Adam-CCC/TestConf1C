 													ЯчейкаНовыйОбъект.Записать();
													ЯчейкаНовый = ЯчейкаНовыйОбъект.Ссылка;
												КонецЕсли;
												//Синхронизация номенклатуры на ячейках
												
												//Теперь контролируем ячейки, для этого сделаем выборку того, что отличается в ту или иную сторону, и синхронизируем
												КонтрольЭлементовНаЯчейках = Новый Запрос();
												КонтрольЭлементовНаЯчейках.Текст = "ВЫБРАТЬ
																				   |	НоменклатураЯчейкиХранения.Ссылка КАК Номенклатура,
																				   |	МАКСИМУМ(ВЫБОР
																				   |			КОГДА НоменклатураЯчейкиХранения.ЯчейкаХранения = &ЯчейкаНовый
																				   |				ТОГДА НоменклатураЯчейкиХранения.ЯчейкаХранения
																				   |			ИНАЧЕ NULL
																				   |		КОНЕЦ) КАК ЯчейкаНовый,
																				   |	МАКСИМУМ(ВЫБОР
																				   |			КОГДА НоменклатураЯчейкиХранения.ЯчейкаХранения = &ЯчейкаОсновной
																				   |				ТОГДА НоменклатураЯчейкиХранения.ЯчейкаХранения
																				   |			ИНАЧЕ NULL
																				   |		КОНЕЦ) КАК ЯчейкаОсновной
																				   |ИЗ
																				   |	Справочник.Номенклатура.ЯчейкиХранения КАК НоменклатураЯчейкиХранения
																				   |ГДЕ
																				   |	НоменклатураЯчейкиХранения.ЯчейкаХранения В (&ЯчейкаНовый, &ЯчейкаОсновной)
																				   |
																				   |СГРУППИРОВАТЬ ПО
																				   |	НоменклатураЯчейкиХранения.Ссылка";
												КонтрольЭлементовНаЯчейках.УстановитьПараметр("ЯчейкаНовый", ЯчейкаНовый);
