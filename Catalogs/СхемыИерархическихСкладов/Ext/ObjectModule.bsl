																НайденнаяСТрока = НоменклатураОбъект.ЯчейкиХранения.Найти(НовыйСклад, "СкладКомпании");
																Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда
																	СтрокаСнята = ТаблицаНоменклатураСнята.Добавить();
																	СтрокаСнята.Номенклатура = ВыборкаЭлементовНаЯчейках.Номенклатура;
																	СтрокаСнята.ЯчейкаХранения = НайденнаяСТрока.ЯчейкаХранения.Код;
																	
																	НоменклатураОбъект.ЯчейкиХранения.Удалить(НайденнаяСТрока);
																КонецЕсли;
															Иначе
																СтрокаСнята = ТаблицаНоменклатураСнята.Добавить();
																СтрокаСнята.Номенклатура = ВыборкаЭлементовНаЯчейках.Номенклатура;
																СтрокаСнята.ЯчейкаХранения = НайденнаяСТрока.ЯчейкаХранения.Код;
																
																СтрокаРазмещено = ТаблицаНоменклатураРазмещена.Добавить();
																СтрокаРазмещено.Номенклатура = ВыборкаЭлементовНаЯчейках.Номенклатура;
																СтрокаРазмещено.ЯчейкаХранения = ЯчейкаНовый.Код;
																
																НайденнаяСТрока.ЯчейкаХранения = ЯчейкаНовый;
															КонецЕсли;
														Иначе
															СтрокаРазмещено = ТаблицаНоменклатураРазмещена.Добавить();
															СтрокаРазмещено.Номенклатура = ВыборкаЭлементовНаЯчейках.Номенклатура;
															СтрокаРазмещено.ЯчейкаХранения = ЯчейкаНовый.Код;
															
															НоваяСтрокаЯчейки = НоменклатураОбъект.ЯчейкиХранения.ДОбавить();
															НоваяСтрокаЯчейки.СкладКомпании = НовыйСклад;
															НоваяСтрокаЯчейки.ЯчейкаХранения = ЯчейкаНовый;
														КонецЕсли;
														Если ФлагКомментировать Тогда
															Сообщить("2.Записывается Номенклатура: ["+НоменклатураОбъект.Код+"] "+НоменклатураОбъект); 	
