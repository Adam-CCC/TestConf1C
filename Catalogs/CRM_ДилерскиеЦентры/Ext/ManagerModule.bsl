Функция ПолучитьНачалоРабочегоДняАвтосервиса(ДилерскийЦентр = Неопределено, Дата = Неопределено, ДатаИВремя = Истина) Экспорт
	
	Если ЗначениеЗаполнено(ДилерскийЦентр) И ЗначениеЗаполнено(Дата) Тогда
		СтрокаГрафика = ДилерскийЦентр.АвтосервисГрафикРабот.Найти(ДеньНедели(Дата), "ДеньНедели");
		Если НЕ СтрокаГрафика = Неопределено Тогда
			НачалоРабДня = СтрокаГрафика.НачалоРабочегоДня;
		Иначе
			НачалоРабДня = '00010101080000';
		КонецЕсли;
		Если ДатаИВремя Тогда
			Возврат НачалоДня(Дата) + 3600 * Час(НачалоРабДня) + 60 * Минута(НачалоРабДня) + Секунда(НачалоРабДня);
		Иначе
			Возврат '00010101' + 3600 * Час(НачалоРабДня) + 60 * Минута(НачалоРабДня) + Секунда(НачалоРабДня);
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

