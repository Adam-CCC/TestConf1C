
Функция ПолучитьДолжностиАвтосервиса(ДилерскийЦентр = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Должности.Ссылка КАК ДилерскийЦентр,
	|	Должности.Должность КАК Должность
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры.ДолжностиМеханиковАвтосервиса КАК Должности";
	Если ЗначениеЗаполнено(ДилерскийЦентр) И ТипЗнч(ДилерскийЦентр) = Тип("СправочникСсылка.CRM_ДилерскиеЦентры") Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + 
		"ГДЕ
		|	Должности.Ссылка = &ДилерскийЦентр";
		Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

