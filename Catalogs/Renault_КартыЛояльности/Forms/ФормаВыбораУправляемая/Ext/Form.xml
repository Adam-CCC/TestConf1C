			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	КартыЛояльности.Ссылка,
	КартыЛояльности.ПометкаУдаления,
	КартыЛояльности.Предопределенный,
	КартыЛояльности.Код,
	КартыЛояльности.Наименование,
	КартыЛояльности.Контрагент,
	КартыЛояльности.Примечание,
	КартыЛояльности.ДатаВыдачи,
	КартыЛояльности.КемВыдана,
	КартыЛояльности.Недействительна,
	КартыЛояльности.ДилерскийЦентр,
	КартыЛояльности.ПрограммаЛояльности,
	КартыЛояльности.DMS_ВидКартыЛояльности КАК DMS_ВидКартыЛояльности,
	КартыЛояльности.DMS_ТипКарты КАК DMS_ТипКарты,
	КартыЛояльности.DMS_КартаЗамены КАК DMS_КартаЗамены,
	ЕСТЬNULL(КартыЛояльности.DMS_ВидКартыЛояльности.Персонализирована, ЛОЖЬ) КАК Персонализирована
ИЗ
	Справочник.Renault_КартыЛояльности КАК КартыЛояльности
ГДЕ
	(КартыЛояльности.DMS_ТипКарты = &amp;ТипКарты
			ИЛИ &amp;ТипКарты = ЗНАЧЕНИЕ(Перечисление.DMS_ТипыКартЛояльности.ПустаяСсылка))</QueryText>
