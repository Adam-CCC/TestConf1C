&НаКлиенте
Процедура СформироватьФайлы(Команда)
	
	Кампания = Элементы.Список.ТекущаяСтрока;
	Если Кампания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файлы";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		СформироватьФайлыНаСервере(Кампания, ДиалогОткрытияФайла.Каталог);
	КонецЕсли;

КонецПроцедуры

&НаСервереБЕЗконтекста
Процедура СформироватьФайлыНаСервере(Кампания, ИмяФайла)
	
	РегистрыСведений.Renault_BP_РезультатыКампаний.СформироватьФайлы(Кампания, ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "КампанияРезультат" Тогда
		ДД = СписокВыборНаСервере(ТекущиеДанные.Код);
		Имя = ПолучитьИмяВременногоФайла("docx");
		ДД.записать(Имя);
		ЗапуститьПриложение(Имя);
	КонецЕсли;
	
	Если Поле.Имя = "КампанияРасшифровка" Тогда
		 ПоказатьРасшифровку(Неопределено);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СписокВыборНаСервере(Код)
	
	BIRы = Renault_BonusPaymentЗагрузкаДанных.ПолучитьМассивБирДляПолученияДанных();
	BIR = BIRы[0];
	Прокси = Renault_BonusPaymentЗагрузкаДанных.ПолучитьПрокси();
	
	СериализованноеХранилище = Прокси.GetFilledResultsDoc(BIR, Код);
	Возврат СериализованноеХранилище.Получить();
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРасшифровку(Команда)
	
	Кампания = Элементы.Список.ТекущаяСтрока;
	Если Кампания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Кампания", Кампания);
	ОткрытьФорму("РегистрСведений.Renault_BP_ДетализацияРезультатов.Форма.ФормаСпискаПоКампании", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотретьРезультаты(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДД = СписокВыборНаСервере(ТекущиеДанные.Код);
	Имя = ПолучитьИмяВременногоФайла("docx");
	ДД.записать(Имя);
	ЗапуститьПриложение(Имя);

КонецПроцедуры
