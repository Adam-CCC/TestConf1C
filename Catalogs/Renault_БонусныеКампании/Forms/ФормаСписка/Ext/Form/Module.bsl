
&НаКлиенте
Процедура ЗагрузитьШаблон(Команда)
	
	Кампания = Элементы.Список.ТекущаяСтрока;
	Если Кампания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	Фильтр = НСтр("en='Document DOCX';ru='Документ DOCX'")
	    + "(*.docx)|*.docx";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = "Выберите файлы";
	Если ДиалогОткрытияФайла.Выбрать() Тогда
	    МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
	    Для Каждого ИмяФайла Из МассивФайлов Цикл
	       ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
		   ЗагрузитьШаблонФайла(Кампания, ДвоичныеДанные);
	    КонецЦикла;
	Иначе
	    Предупреждение(НСтр("en='File (s) not selected!';ru='Файл(ы) не выбран!'"));
	КонецЕсли;
	ОповеститьОбИзменении(Тип("СправочникСсылка.БонусныеКампании"));
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьШаблонФайла(Кампания, ДанныеФайла)
	
	РегистрыСведений.Renault_BP_ШаблоныДокументовРезультатов.ДобавитьШаблон(Кампания, ДанныеФайла);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОткрытьШаблонНаСервере(Кампания)
	
	Возврат РегистрыСведений.Renault_BP_ШаблоныДокументовРезультатов.ПолучитьШаблон(Кампания);	
	
КонецФункции

&НаКлиенте
Процедура ОткрытьШаблон(Команда)
	
	Кампания = Элементы.Список.ТекущаяСтрока;
	Если Кампания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеШаблона = ОткрытьШаблонНаСервере(Кампания);
	Если ДанныеШаблона = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("docx");
	ДанныеШаблона.Записать(ИмяФайла);
	ЗапуститьПриложение(ИмяФайла);
	
КонецПроцедуры

