	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	СправочникБонусныеКампании.Ссылка,
	СправочникБонусныеКампании.ПометкаУдаления,
	СправочникБонусныеКампании.Код,
	СправочникБонусныеКампании.Наименование,
	СправочникБонусныеКампании.Описание,
	ВЫБОР
		КОГДА BP_ШаблоныДокументовРезультатов.Кампания ЕСТЬ NULL 
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК КампанияШаблон,
	ВЫБОР
		КОГДА BP_РезультатыКампаний.Кампания ЕСТЬ NULL 
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК КампанияРезультат,
	ВЫБОР
		КОГДА BP_ДетализацияРезультатов.Кампания ЕСТЬ NULL 
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК КампанияРасшифровка
ИЗ
	Справочник.Renault_БонусныеКампании КАК СправочникБонусныеКампании
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_BP_ШаблоныДокументовРезультатов КАК BP_ШаблоныДокументовРезультатов
		ПО СправочникБонусныеКампании.Ссылка = BP_ШаблоныДокументовРезультатов.Кампания
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_BP_РезультатыКампаний КАК BP_РезультатыКампаний
		ПО СправочникБонусныеКампании.Ссылка = BP_РезультатыКампаний.Кампания
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_BP_ДетализацияРезультатов КАК BP_ДетализацияРезультатов
		ПО СправочникБонусныеКампании.Ссылка = BP_ДетализацияРезультатов.Кампания</QueryText>
				<MainTable>Catalog.Renault_БонусныеКампании</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
