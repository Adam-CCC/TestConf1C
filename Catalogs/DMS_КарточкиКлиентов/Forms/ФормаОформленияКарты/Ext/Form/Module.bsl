
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийЭтап = 1;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьVINНаСервере(VIN,Сообщение)
	
		Попытка
			ВебСервис = Справочники.DMS_КарточкиКлиентов.ПолучитьВебСервис();
		Исключение
			Сообщить("Не удалось соединиться с центральной базой!");
			Сообщить("Ошибка " +ОписаниеОшибки());
			Возврат 0;
		КонецПопытки;
		
		
		КодМодели = ВебСервис.CheckVin(VIN,Сообщение);
		Если КодМодели = "0" тогда
			Возврат 0;
		иначе		
			Возврат Число(КодМодели);
			//Сообщить(Сообщение+ " "+ "Код модели " + КодМодели);
		КонецЕсли;
	
	КонецФункции
	
&НаСервереБезКонтекста
Функция ПроверитьКартуНаСервере(НомерКарты,КодКарты)
	
	Попытка
		ВебСервис = Справочники.DMS_КарточкиКлиентов.ПолучитьВебСервис();
	Исключение
		Возврат -1;
	КонецПопытки;
	
	Возврат ВебСервис.CheckCard(СокрЛп(НомерКарты),СокрЛП(КодКарты));
	
КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьДанныеВладельца(Автомобиль);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвтомобилиСрезПоследних.Значение
		|ИЗ
		|	РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|ГДЕ
		|	АвтомобилиСрезПоследних.Автомобиль = &Автомобиль
		|	И АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураДанных = Новый Структура;
	
	Если Выборка.Следующий() тогда
		Клиент = Выборка.Значение;
		
		СтруктураДанных.Вставить("Клиент",Клиент);
	    СтруктураДанных.Вставить("Фамилия",Клиент.Фамилия);
		СтруктураДанных.Вставить("Имя",Клиент.Имя);
		СтруктураДанных.Вставить("Отчество",Клиент.Отчество);
		СтруктураДанных.Вставить("Документ", Справочники.DMS_КарточкиКлиентов.ВернутьДокументКлиента(Клиент));
		СтруктураДанных.Вставить("АдресРегистрации",Справочники.DMS_КарточкиКлиентов.ВернутьАдрес(Клиент));
		СтруктураДанных.Вставить("Телефон",Справочники.DMS_КарточкиКлиентов.ВернутьТелефон(Клиент));
		СтруктураДанных.Вставить("ГодРождения",Год(Клиент.ДатаРождения));
		СтруктураДанных.Вставить("eMail","e-mail");
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
	
КонецФункции

&НаКлиенте
Процедура ЗагрузкаУсловийПоКартам()
	ЗагрузитьУсловияПоКартам();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьУсловияПоКартам()
	
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("id");
	ТаблицаДанных.Колонки.Добавить("model_id");
	ТаблицаДанных.Колонки.Добавить("Price");
	ТаблицаДанных.Колонки.Добавить("MileageLimit");
	ТаблицаДанных.Колонки.Добавить("TimeLimit");
	ТаблицаДанных.Колонки.Добавить("Code");	
	ТаблицаДанных.Колонки.Добавить("Active");	
	ТаблицаДанных.Колонки.Добавить("do3mes");
	
	
	Попытка
		ВебСервис = Справочники.DMS_КарточкиКлиентов.ПолучитьВебСервис();
	Исключение
		Сообщить("Не удалось соединиться с центральной базой!");
		Сообщить("Ошибка " +ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ПакетДанных = ВебСервис.GetContracts();
	ТаблицаДанных = СериализаторXDTO.ПрочитатьXDTO(ПакетДанных);
	
	Если ТипЗнч(ТаблицаДанных) = Тип("ТаблицаЗначений") тогда
		Для каждого стр из ТаблицаДанных цикл
			
			Условие = Справочники.DMS_УсловияПоКарточкам.НайтиПоКоду(стр.id).Ссылка;
			
			Если Условие = Справочники.DMS_УсловияПоКарточкам.ПустаяСсылка() тогда
				УсловиеОбъект = Справочники.DMS_УсловияПоКарточкам.СоздатьЭлемент();
			иначе
				УсловиеОбъект = Условие.ПолучитьОбъект();
			КонецЕсли;
			УсловиеОбъект.Код = стр.id;
			УсловиеОбъект.Владелец = Справочники.DMS_ВидыКарточекКлиента.ПродленнаяГарантия;
			УсловиеОбъект.Наименование = Стр.Code;
			УсловиеОбъект.ОграничениеПоСроку = стр.TimeLimit;
			УсловиеОбъект.ОграничениеПоПробегу = стр.MileageLimit;
			УсловиеОбъект.Цена = Стр.Price;
			УсловиеОбъект.До3хМесяцев = ?(Стр.do3mes = 1, Истина, Ложь);
			Если ТекущаяДата() >= '20190101' Тогда
				УсловиеОбъект.НДС = Стр.Price * 0.20;
			Иначе
				УсловиеОбъект.НДС = Стр.Price * 0.18;
			КонецЕсли;
			УсловиеОбъект.КодМодели = стр.model_id;
			УсловиеОбъект.Активно = ?(стр.Active = 1,Истина,Ложь);
			УсловиеОбъект.Записать();
			
		КонецЦикла;
		
	Иначе 
		Сообщить("Ошибка, данные от сервера не получены!");
	КонецЕсли;

	
КонецПроцедуры



&НаКлиенте
Процедура ПерейтиНаСледующийЭтап(Команда)
	Если ЭтаФорма.ТекущийЭтап = 1 тогда
		Сообщение ="";	
		КодМодели = ПроверитьVINНаСервере(VIN,Сообщение);
		ЭтаФорма.ВариантыУсловииПоКарте.Параметры.УстановитьЗначениеПараметра("КодМодели",КодМодели);
		
		Если КодМодели <> 0 тогда
			ЭтаФорма.Элементы.ГруппаЭтап1.Видимость = Ложь;
			ЭтаФорма.Элементы.ГруппаЭтап2.Видимость = Истина;
			ЭтаФорма.ТекущийЭтап = 2;
			
		Иначе
			Сообщить(Сообщение);
		КонецЕсли;
		
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 2 тогда
		
		УсловияПоКарте = ЭтаФорма.Элементы.ВариантыУсловииПоКарте.ТекущаяСтрока;
		ЭтаФорма.Элементы.ГруппаЭтап2.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаЭтап3.Видимость = Истина;
		ЭтаФорма.ТекущийЭтап = 3;
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 3 тогда
		ЭтаФорма.Элементы.ГруппаЭтап3.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаЭтап4.Видимость = Истина;
		ЭтаФорма.ТекущийЭтап = 4;
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 4 тогда
		
		//Вызов веб сервиса проверки карты
		КодДилера = ПроверитьКартуНаСервере(НомерКарты,СекретныйКодКарты);
		
		Если КодДилера = 0 тогда
			
			Сообщить("Карта недоступна для выдачи");
			Возврат;
		ИначеЕсли КодДилера = -1 тогда
				Сообщить("Не удалось соединиться с центральной базой! Попробуйте повторить попытку проверки!");
				Возврат;
		КонецЕсли;	
		
		ЭтаФорма.Элементы.ГруппаЭтап4.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаЭтап5.Видимость = Истина;
		ЭтаФорма.Элементы.ПерейтиНаСледующийЭтап.Заголовок ="Завершить";
		ЭтаФорма.ТекущийЭтап = 5;
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 5 тогда
		//Отправить данные через веб-сервис на сервер и закрыть форму.
		Закрыть();		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаПредыдущийЭтап(Команда)
	
	Если ЭтаФорма.ТекущийЭтап = 1 тогда
		Возврат;
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 2 тогда
		ЭтаФорма.Элементы.ГруппаЭтап2.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаЭтап1.Видимость = Истина;
		ЭтаФорма.ТекущийЭтап = 1
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 3 тогда
		ЭтаФорма.Элементы.ГруппаЭтап3.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаЭтап2.Видимость = Истина;
		ЭтаФорма.ТекущийЭтап = 2;
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 4 тогда
		ЭтаФорма.Элементы.ГруппаЭтап4.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаЭтап3.Видимость = Истина;
		ЭтаФорма.ТекущийЭтап = 3;
	ИначеЕсли ЭтаФорма.ТекущийЭтап = 5 тогда
		ЭтаФорма.Элементы.ГруппаЭтап5.Видимость = Ложь;
		ЭтаФорма.Элементы.ГруппаЭтап4.Видимость = Истина;
		ЭтаФорма.ТекущийЭтап = 4;
		ЭтаФорма.Элементы.ПерейтиНаСледующийЭтап.Заголовок ="Далее";
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура VINПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Элемент.ТекстРедактирования) тогда
		Возврат;
	КонецЕсли;
	
	Автомобиль = НайтиАвтоПоVIN(Элемент.ТекстРедактирования);
	ЭтаФорма.Элементы.ОткрытьКарточкуАвто.Доступность = Автомобиль <> Справочники.Автомобили.ПустаяСсылка();
	Если Автомобиль <> Справочники.Автомобили.ПустаяСсылка() тогда
		ДатаНачалаГарантии = Автомобиль.ДатаНачалаГарантии;
		ЭтаФорма.Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);	
		ЗаполнитьЗначенияСвойств(ЭтаФорма,ПолучитьДанныеВладельца(Автомобиль));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиАвтоПоVIN(VIN)
	
	
	Возврат Справочники.Автомобили.НайтиПоРеквизиту("VIN",VIN).Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьКарточкуАвто(Команда)
	
	ОткрытьЗначение(Автомобиль);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидТоплива = "gasoline";
	ЭтаФорма.Элементы.ОткрытьКарточкуАвто.Доступность = Ложь;
	ЭтаФорма.Элементы.ГруппаЭтап1.Видимость = Истина;
	ВидКарты = Справочники.DMS_ВидыКарточекКлиента.ПродленнаяГарантия;
	ЭтаФорма.ВариантыУсловииПоКарте.Параметры.УстановитьЗначениеПараметра("ВидКарты",ВидКарты);
	ЭтаФорма.ВариантыУсловииПоКарте.Параметры.УстановитьЗначениеПараметра("КодМодели",0);
	ПодключитьОбработчикОжидания("ЗагрузкаУсловийПоКартам",0.1 ,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКартыПриИзменении(Элемент)
	
	ЭтаФорма.ВариантыУсловииПоКарте.Параметры.УстановитьЗначениеПараметра("ВидКарты",ВидКарты);
	
КонецПроцедуры


&НаСервере
Процедура ЗаписатьКартуНаСервере()
	
	Если КарточкаКлиента = Справочники.DMS_КарточкиКлиентов.ПустаяСсылка() тогда
		Элемент = Справочники.DMS_КарточкиКлиентов.СоздатьЭлемент();	
		ЗаполнитьЗначенияСвойств(Элемент,ЭтаФорма);
		Элемент.Наименование = ЭтаФорма.НомерДоговора;
		Элемент.ДатаОкончанияГарантии = ДобавитьМесяц(ЭтаФорма.ДатаНачалаГарантии, 36);
		Элемент.ДатаОкончанияГарантииРасширенная = ДобавитьМесяц(ЭтаФорма.ДатаНачалаГарантии, УсловияПоКарте.ОграничениеПоСроку * 12);
		Элемент.ДатаОкончания = ДобавитьМесяц(ЭтаФорма.ДатаНачалаГарантии, УсловияПоКарте.ОграничениеПоСроку * 12);
		Элемент.Записать();
		КарточкаКлиента = Элемент.Ссылка;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ЗаписатьКарточку(Команда)
	
	Если ЗначениеЗаполнено(НомерДоговора) и ЗначениеЗаполнено(ДатаОформления) тогда
		
		ЗаписатьКартуНаСервере();
		
		РезультатЗаписи = Справочники.DMS_КарточкиКлиентов.ЗаписатьПродажуКартыВБазуSQL(КарточкаКлиента);
		
		Если РезультатЗаписи.Ответ = 1 тогда
			ЭтаФорма.Элементы.ЗаписатьКарточку.Доступность = Ложь;
			ЭтаФорма.Элементы.СправочникDMS_КарточкиКлиентовПечатьАктУпр.Доступность = Истина;
			ЭтаФорма.Элементы.СправочникDMS_КарточкиКлиентовПечатьДоговорУпр.Доступность = Истина;
		Иначе
			Сообщить(РезультатЗаписи.Сообщение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

