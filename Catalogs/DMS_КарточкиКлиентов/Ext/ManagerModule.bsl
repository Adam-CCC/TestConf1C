Функция НайтиДанныеПоVINАвтомобиля(VIN) Экспорт
	
	Сообщение = "";
	
	Попытка
		ВебСервис = ПолучитьВебСервис();
		Ответ = ВебСервис.CheckExistingDataVIN(VIN,Сообщение);
		
		Сериал = новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
		Таблица = Сериал.ПрочитатьXDTO(Ответ);
		
	Исключение
		Сообщить("Не удалось соединиться с центральной базой!");
		Сообщить("Ошибка " +ОписаниеОшибки());
		Возврат Новый ТаблицаЗначений;
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Таблица) Тогда
		
		НоваяТаблица = Новый ТаблицаЗначений;
