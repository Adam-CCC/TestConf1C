Функция СоздатьКарточкуКлиента(КартаКлиента) Экспорт
	
	ВебСервис = ПолучитьВебСервис();
	
	НоваяКарта = Справочники.DMS_КарточкиКлиентов.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НоваяКарта,КартаКлиента,,"Код");
	НоваяКарта.Автомобиль = Справочники.Автомобили.НайтиПоРеквизиту("VIN",КартаКлиента.VIN);
	НоваяКарта.Клиент = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(НоваяКарта.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_УсловияПоКарточкам.Ссылка
		|ИЗ
		|	Справочник.DMS_УсловияПоКарточкам КАК DMS_УсловияПоКарточкам
		|ГДЕ
		|	DMS_УсловияПоКарточкам.КодМодели = &КодМодели
		|	И DMS_УсловияПоКарточкам.Цена = &Цена";
		
	Запрос.УстановитьПараметр("КодМодели", Число(КартаКлиента.КодМодели));
	Запрос.УстановитьПараметр("Цена", Число(КартаКлиента.Цена));
	
	ВыборкаУсловий = Запрос.Выполнить().Выбрать();
	Если ВыборкаУсловий.Следующий() Тогда	
		НоваяКарта.УсловияПоКарте = ВыборкаУсловий.Ссылка;
	КонецЕсли;
	НоваяКарта.Записать();
	
	Возврат НоваяКарта.Ссылка;
КонецФункции