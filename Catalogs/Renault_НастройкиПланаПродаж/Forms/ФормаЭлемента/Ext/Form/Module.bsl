
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СписокНастроек.Добавить("ДилерскиеЦентры", "Дилерские центры",Объект.ДилерскиеЦентры);
	СписокНастроек.Добавить("Отделы", "Отделы",Объект.Отделы);
	СписокНастроек.Добавить("Менеджеры", "Менеджеры",Объект.Менеджеры);
	СписокНастроек.Добавить("Модели", "Модели", Объект.Модели);
	СписокНастроек.Добавить("ТипыМоделей", "Типы моделей", Объект.ТипыМоделей);
	СписокНастроек.Добавить("ГаммаМоделей", "Гамма моделей", Объект.ГаммаМоделей);
	
	Если Объект.Порядок.Количество() > 0 Тогда
		Для х=0 по Объект.Порядок.Количество()-1 Цикл
			ИндексСписка = СписокНастроек.НайтиПоЗначению(Объект.Порядок[х].Значение);
			СписокНастроек.Сдвинуть(ИндексСписка, х-СписокНастроек.Индекс(ИндексСписка));
		КонецЦикла;
	КонецЕсли;
    ОтобразитьГруппуТипаПланирования();
	СформироватьТекстРасщифровки ();
КонецПроцедуры

&НаСервере 
Процедура ОтобразитьГруппуТипаПланирования ()
	Элементы.ГруппаТипыПлана.Видимость = Истина;	
	Если Объект.ТипПлана = Перечисления.Renault_ТипыПланирования.Количественный Тогда
		Элементы.ГруппаТипыПлана.ТекущаяСтраница = Элементы.ГруппаКоличественный;
	ИначеЕсли Объект.ТипПлана = Перечисления.Renault_ТипыПланирования.Процентный Тогда
		Элементы.ГруппаТипыПлана.ТекущаяСтраница = Элементы.ГруппаПроцентрый;
	ИначеЕсли Объект.ТипПлана = Перечисления.Renault_ТипыПланирования.Суммовой или
				Объект.ТипПлана = Перечисления.Renault_ТипыПланирования.СуммовойНаЕдиницу Тогда
		Элементы.ГруппаТипыПлана.ТекущаяСтраница = Элементы.ГруппаСуммовой;
	ИначеЕсли Объект.ТипПлана = Перечисления.Renault_ТипыПланирования.СуммаНаЭтапПродажи Тогда
		Элементы.ГруппаТипыПлана.ТекущаяСтраница = Элементы.ГруппаСуммаНаЭтап;
	Иначе
		Элементы.ГруппаТипыПлана.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокНастроекПриАктивизацииСтроки(Элемент)
	ВывестиСтраницуПоЗначениюСписка(Элемент.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСтраницуПоЗначениюСписка (ТекущиеДанные)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы["ГруппаСостав"+ТекущиеДанные.Значение];
	Элементы.Страницы.ТекущаяСтраница.ТолькоПросмотр = не ТекущиеДанные.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНастроекПометкаПриИзменении(Элемент)
	ВывестиСтраницуПоЗначениюСписка(Элемент.Родитель.ТекущиеДанные);
	Если не Элемент.Родитель.ТекущиеДанные.Пометка Тогда
		Объект["Состав"+Элемент.Родитель.ТекущиеДанные.Значение].Очистить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.Порядок.Очистить();
	Для Каждого СтрокаСписокНастроек из СписокНастроек Цикл
		ТекущийОбъект[СтрокаСписокНастроек.Значение] = СтрокаСписокНастроек.Пометка;
		Если СтрокаСписокНастроек.Пометка Тогда
			СтрПорядок = ТекущийОбъект.Порядок.Добавить();
			СтрПорядок.Значение = СтрокаСписокНастроек.Значение;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Дилеры(Команда)
	Текст = "ВЫБРАТЬ
	        |	CRM_ДилерскиеЦентры.Ссылка как Значение
	        |ИЗ
	        |	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры"; 
	ЗаполнитьНаСервере(Текст, "ДилерскиеЦентры");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере (Текст, ТипДанных, Отбор=Неопределено)
	Таблица = Объект["Состав"+ТипДанных];
	Таблица.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	Если Отбор <> Неопределено Тогда
		Для Каждого сОтбор из Отбор Цикл 
			Запрос.УстановитьПараметр(сОтбор.Ключ, сОтбор.Значение);
		КонецЦикла;
	КонецЕсли;
	Таблица.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура Отделы(Команда)
	НастройкаДилЦентры = СписокНастроек.НайтиПоЗначению("ДилерскиеЦентры");
	Если НастройкаДилЦентры <> Неопределено и НастройкаДилЦентры.Пометка Тогда
		Текст = "ВЫБРАТЬ
		        |	CRM_Отделы.Ссылка КАК Значение
		        |ИЗ
		        |	Справочник.CRM_Отделы КАК CRM_Отделы
		        |ГДЕ
		        |	CRM_Отделы.ДилерскийЦентр В(&ДилерскийЦентр)";
		Отбор = Новый Структура;
		мЗначений = Новый Массив;
		Для Каждого строкаСоставДилЦентры из Объект.СоставДилерскиеЦентры Цикл
			мЗначений.Добавить(строкаСоставДилЦентры.Значение);
		КонецЦикла;
		Отбор.Вставить("ДилерскийЦентр", мЗначений);
		ЗаполнитьНаСервере(Текст, "Отделы", Отбор);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Модели(Команда)
	Текст = "ВЫБРАТЬ
	        |	CRM_МаркаАвтомобиляМоделиАвтомобилейАвтосклад.Модель КАК Значение
	        |ИЗ
	        |	Справочник.CRM_МаркаАвтомобиля.МоделиАвтомобилейАвтосклад КАК CRM_МаркаАвтомобиляМоделиАвтомобилейАвтосклад
	        |ГДЕ
	        |	CRM_МаркаАвтомобиляМоделиАвтомобилейАвтосклад.Ссылка = &Ссылка";
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", Справочники.CRM_МаркаАвтомобиля.RENAULT);
	ЗаполнитьНаСервере(Текст, "Модели", Отбор);
КонецПроцедуры

&НаКлиенте
Процедура Менеджеры(Команда)
	Текст = 
	"ВЫБРАТЬ
	|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник Значение
	|ИЗ
	|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	|ГДЕ
	|	ВЫБОР
	|				КОГДА &ОтборДЦ
	|					ТОГДА Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ДилерскийЦентр В (&ДЦ)
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР
	|				КОГДА &ОтборОтдел
	|					ТОГДА Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел В (&Отдел)
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ";
	Отбор = Новый Структура;
	мЗначений = Новый Массив;
	Если Объект.СоставДилерскиеЦентры.Количество() Тогда
		Отбор.Вставить("ОтборДЦ", Истина);
		Для Каждого строкаСоставДилЦентры из Объект.СоставДилерскиеЦентры Цикл
			мЗначений.Добавить(строкаСоставДилЦентры.Значение);
		КонецЦикла;
		Отбор.Вставить("ДЦ", мЗначений);
	Иначе
		Отбор.Вставить("ОтборДЦ", Ложь);
		Отбор.Вставить("ДЦ", мЗначений);
	КонецЕсли;
	Если Объект.СоставОтделы.Количество() Тогда
		Отбор.Вставить("ОтборОтдел", Истина);
		Для Каждого строкаСоставОтдел из Объект.СоставОтделы Цикл
			мЗначений.Добавить(строкаСоставОтдел.Значение);
		КонецЦикла;
		Отбор.Вставить("Отдел", мЗначений);
	Иначе
		Отбор.Вставить("ОтборОтдел", Ложь);
		Отбор.Вставить("Отдел", мЗначений);
	КонецЕсли;
	ЗаполнитьНаСервере(Текст, "Менеджеры", Отбор);
КонецПроцедуры

