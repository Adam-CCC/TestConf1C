&НаКлиенте
Процедура ДекорацияТележкаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Значение = ПараметрыПеретаскивания.Значение;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда 
		
		Для каждого Выбраннаятрока Из Значение Цикл
			
			Если ТипЗнч(Выбраннаятрока) = Тип("ДанныеФормыЭлементДерева") Тогда
				Возврат;
			КонецЕсли; 
			
			ДанныеСтроки = Элементы[ТаблицаПереноса].ДанныеСтроки(Выбраннаятрока);
			
			НоваяСтрока = ВыбранныеАвтоработы.Добавить();
			НоваяСтрока.Авторабота 		= ДанныеСтроки.Авторабота;
			НоваяСтрока.ВремяВыполнения = ДанныеСтроки.ВремяВыполнения;
			НоваяСтрока.Цена			= ДанныеСтроки.Цена;
			НоваяСтрока.Нормочас		= ДанныеСтроки.Нормочас;
			НоваяСтрока.Количество 		= 1;
			
		КонецЦикла; 
		
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Автоработы") Тогда 
		
		НоваяСтрока = ВыбранныеАвтоработы.Добавить();
		НоваяСтрока.Авторабота 		= Значение;
		НоваяСтрока.ВремяВыполнения = 0;
		НоваяСтрока.Цена			= Нормочас.Цена;
		НоваяСтрока.Нормочас 		= Справочники.Нормочасы.ПустаяСсылка();
		НоваяСтрока.Количество 		= 1;
		
	КонецЕсли; 
	
	УстановитьДекорациюИНадписьКорзины();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДекорациюИНадписьКорзины()

	Если ВыбранныеАвтоработы.Количество() = 0 Тогда
		Элементы.ДекорацияТележка.Картинка = БиблиотекаКартинок.DMS_ТележкаПустая;
		Элементы.НадписьПодобраноТоваров.Заголовок = "Перетащите автоработу в корзину";
	Иначе 
		Элементы.ДекорацияТележка.Картинка = БиблиотекаКартинок.DMS_ТележкаСТоварами;
		Элементы.НадписьПодобраноТоваров.Заголовок = "Подобрано: " + Формат(ВыбранныеАвтоработы.Количество(), "ЧЦ=10; ЧН=-; ЧГ=");
	КонецЕсли;
	
	Элементы.ПеренестиВДокумент.Видимость = (ВыбранныеАвтоработы.Количество() <> 0);
	
КонецПроцедуры // УстановитьДекорациюИНадписьКорзины()

