&НаКлиенте
Процедура ДеревоСпецификацийПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоСпецификаций.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НаименованиеОтбор) И ПустаяСтрока(АртикулОтбор) И ПустаяСтрока(КодОтбор) Тогда	
		СпецификацияДляОтбора = ТекущаяСтрока.РесурснаяСпецификация;
	Иначе
		СпецификацияДляОтбора = ПустаяСпецификация;
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("РесурснаяСпецификация", СпецификацияДляОтбора);
	Список.Параметры.УстановитьЗначениеПараметра("КодОперации", 		  ТекущаяСтрока.КодОперации);
	Список.Параметры.УстановитьЗначениеПараметра("Модель", 		 		  Модель);
	Список.Параметры.УстановитьЗначениеПараметра("ВидРемонта", 		 	  ВидРемонта);
	Список.Параметры.УстановитьЗначениеПараметра("ДоступнаПятаяВерсия",   ДоступнаПятаяВерсия);
	Список.Параметры.УстановитьЗначениеПараметра("Нормочас",   			  Нормочас);
	Список.Параметры.УстановитьЗначениеПараметра("Код", 		 	  	  КодОтбор);
	Список.Параметры.УстановитьЗначениеПараметра("Артикул",   			  АртикулОтбор);
	Список.Параметры.УстановитьЗначениеПараметра("Наименование",   		  НаименованиеОтбор);
		
	ДанныеАвторабот = Элементы.Список.ТекущиеДанные;
	
	Если УстанавливатьОтбор Тогда
		
		УстановитьОтбор();
		
	Иначе
		
		
		
	КонецЕсли;
	
	Если ДанныеАвторабот = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("РесурснаяСпецификация", СпецификацияДляОтбора);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("КодОперации", 		  	ТекущаяСтрока.КодОперации);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Модель", 		 		Модель);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Авторабота", 		 	ДанныеАвторабот.Авторабота);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ВремяВыполнения", 		ДанныеАвторабот.ВремяВыполнения);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ВидРемонта", 		 	ВидРемонта);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ДоступнаПятаяВерсия",   ДоступнаПятаяВерсия);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Нормочас",   			Нормочас);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокАвторабот(Модель, РесурснаяСпецификация, КодОперации)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("РесурснаяСпецификация", РесурснаяСпецификация);
	Запрос.УстановитьПараметр("КодОперации", КодОперации);


	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СоставАвторабот.Авторабота КАК Авторабота,
	               |	СоставАвторабот.ВремяВыполнения КАК ВремяВыполнения,
	               |	Модели.Ссылка КАК Ссылка,
	               |	Модели.НомерСтроки КАК НомерСтроки,
	               |	Модели.Модель КАК Модель
	               |ИЗ
	               |	Справочник.DMS_РесурсныеСпецификации.СоставАвторабот КАК СоставАвторабот
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.DMS_КодыОпераций.Модели КАК Модели
	               |		ПО СоставАвторабот.КодОперации = Модели.Ссылка
	               |ГДЕ
	               |	(СоставАвторабот.Ссылка = &РесурснаяСпецификация
	               |			ИЛИ &РесурснаяСпецификация = ЗНАЧЕНИЕ(Справочник.DMS_РесурсныеСпецификации.ПустаяСсылка))
	               |	И Модели.Ссылка = &КодОперации
	               |	И Модели.Модель = &Модель";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

