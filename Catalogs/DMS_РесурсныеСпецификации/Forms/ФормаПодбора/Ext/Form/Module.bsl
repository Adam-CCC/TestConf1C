&НаКлиенте
Процедура СнятьУстановитьОтбор(Команда)
	
	УстанавливатьОтбор = НЕ УстанавливатьОтбор;
	
	Если УстанавливатьОтбор Тогда
		
		УстановитьОтбор();
		Элементы.СписокСнятьУстановитьОтбор.Картинка = БиблиотекаКартинок.ОтключитьОтбор;
		
	Иначе
		
		СнятьОтбор();
		Элементы.СписокСнятьУстановитьОтбор.Картинка = БиблиотекаКартинок.ОтборПоТекущемуЗначению;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтбор()
	
	Для Каждого Элемент из Список.Отбор.Элементы Цикл
		
		Если Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Авторабота") Тогда
			
			Список.Отбор.Элементы.Удалить(Элемент);
			Прервать;
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтбор()
	
	ТекущаяСтрока = Элементы.ДеревоСпецификаций.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НаименованиеОтбор) И ПустаяСтрока(АртикулОтбор) И ПустаяСтрока(КодОтбор) Тогда	
		СпецификацияДляОтбора = ТекущаяСтрока.РесурснаяСпецификация;
	Иначе
		СпецификацияДляОтбора = ПустаяСпецификация;
	КонецЕсли;
	
	ТаблицаАвторабот = ПолучитьСписокАвторабот(Модель, СпецификацияДляОтбора, КодОперации);
	
	Если ТаблицаАвторабот.Количество() > 0 Тогда
		
		Если НЕ ЗначениеЗаполнено(ИндексМоделиДвигателя) ИЛИ НЕ ЗначениеЗаполнено(КодМоделиДвигателя)
			ИЛИ НЕ ЗначениеЗаполнено(КодТипаКузова) ИЛИ НЕ ЗначениеЗаполнено(КодМоделиКПП) Тогда
			
			//ПоказатьПредупреждение(,"Для однозначного выбора, необходимо заполнить критерии автомобиля.");
			
		Иначе
			
			СтруктураКритериев = Новый Структура;
			СтруктураКритериев.Вставить("BVI3", КодМоделиКПП);
			СтруктураКритериев.Вставить("MOT3", КодМоделиДвигателя);
			СтруктураКритериев.Вставить("MOTII", ИндексМоделиДвигателя);
			СтруктураКритериев.Вставить("STYC", КодТипаКузова);
			СтруктураКритериев.Вставить("AIRC", КодКлиматическойУст);
			
			СписокАвторабот = ТаблицаАвторабот.ВыгрузитьКолонку("Авторабота");
			
			ПодходящиеРаботы = Renault_АвтосервисСерверПовтИспользования.НайтиПодходиящиеАвтоработы(СтруктураКритериев, СпецификацияДляОтбора, КодОперации);
			СписокОтбора = Новый СписокЗначений;
			СписокОтбора.ЗагрузитьЗначения(ПодходящиеРаботы);
			
			СнятьОтбор();
			
			ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Авторабота");
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.Использование = Истина;
			ЭлементОтбора.ПравоеЗначение = СписокОтбора;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КодМоделиДвигателяПриИзменении(Элемент)
	
	Если УстанавливатьОтбор Тогда
		
