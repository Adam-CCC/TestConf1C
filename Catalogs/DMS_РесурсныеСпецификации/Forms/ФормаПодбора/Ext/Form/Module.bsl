
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Модель") Тогда
		Модель = Параметры.Модель;
	КонецЕсли;
	
	Если Параметры.Свойство("Заголовок") Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли; 
	
	Если Параметры.Свойство("ТипЦены") Тогда
		ТипЦены = Параметры.ТипЦены;
	КонецЕсли; 
	
	Если Параметры.Свойство("Валюта") Тогда
		Валюта = Параметры.Валюта;
	КонецЕсли; 
	
	Если Параметры.Свойство("Нормочас") Тогда
		Нормочас = Параметры.Нормочас;
	КонецЕсли;
	
	Если Параметры.Свойство("Цех") Тогда
		Цех = Параметры.Цех;
	КонецЕсли; 
	
	Если Параметры.Свойство("ВидРемонта") Тогда
		ВидРемонта = Параметры.ВидРемонта;
	КонецЕсли; 
	
	Если Параметры.Свойство("ДоговорВзаиморасчетов") Тогда
		ДоговорВзаиморасчетов = Параметры.ДоговорВзаиморасчетов;
	КонецЕсли;
	
	Если Параметры.Свойство("ИндексМоделиДвигателя") Тогда
		ИндексМоделиДвигателя = Параметры.ИндексМоделиДвигателя;
	КонецЕсли; 
	
	Если Параметры.Свойство("КодМоделиКПП") Тогда
		КодМоделиКПП = Параметры.КодМоделиКПП;
	КонецЕсли;
	
	Если Параметры.Свойство("КодМоделиДвигателя") Тогда
		КодМоделиДвигателя = Параметры.КодМоделиДвигателя;
	КонецЕсли;
	
	Если Параметры.Свойство("ИндексМоделиКПП") Тогда
		ИндексМоделиКПП = Параметры.ИндексМоделиКПП;
	КонецЕсли;

	Если Параметры.Свойство("КодТипаКузова") Тогда
		КодТипаКузова = Параметры.КодТипаКузова;
	КонецЕсли;
	
	Если Параметры.Свойство("Автомобиль") Тогда
		
		Автомобиль = Параметры.Автомобиль;
		
		Критерии = РегистрыСведений.Renault_АвтомобилиДопРеквизиты.ПолучитьКритерииПоАвтомобилю(Автомобиль);
		
		Если ЗначениеЗаполнено(Критерии) Тогда
			
			КодМоделиДвигателя = Критерии[0].КодМоделиДвигателя;
			ИндексМоделиДвигателя = Критерии[0].ИндексМоделиДвигателя;
			КодМоделиКПП = Критерии[0].КодМоделиКПП; 
			ИндексМоделиКПП = Критерии[0].ИндексМоделиКПП;
			КодТипаКузова = Критерии[0].КодТипаКузова;
			КодКлиматическойУст = ?(Критерии[0].AC, "11", "5");
			
		КонецЕсли;
		
	КонецЕсли;
	
	КодОперации = Справочники.DMS_КодыОпераций.ПолучитьКодОперацииПоМодели(Модель);
	
	Элементы.КодМоделиДвигателя.СписокВыбора.ЗагрузитьЗначения(Renault_АвтосервисСерверПовтИспользования.ПолучитьВесьСписокПритериевКодДвигателя("MOT3", КодОперации).ВыгрузитьЗначения());
	Элементы.ИндексМоделиДвигателя.СписокВыбора.ЗагрузитьЗначения(Renault_АвтосервисСерверПовтИспользования.ПолучитьВесьСписокПритериевКодДвигателя("MOTI", КодОперации).ВыгрузитьЗначения());
	Элементы.КодМоделиКПП.СписокВыбора.ЗагрузитьЗначения(Renault_АвтосервисСерверПовтИспользования.ПолучитьВесьСписокПритериевКодДвигателя("BVI3", КодОперации).ВыгрузитьЗначения());
	Элементы.ИндексМоделиКПП.СписокВыбора.ЗагрузитьЗначения(Renault_АвтосервисСерверПовтИспользования.ПолучитьВесьСписокПритериевКодДвигателя("BVII", КодОперации).ВыгрузитьЗначения());
	Элементы.КодТипаКузова.СписокВыбора.ЗагрузитьЗначения(Renault_АвтосервисСерверПовтИспользования.ПолучитьВесьСписокПритериевКодДвигателя("$TYC", КодОперации).ВыгрузитьЗначения());               	
	Элементы.КодКлУстановки.СписокВыбора.ЗагрузитьЗначения(Renault_АвтосервисСерверПовтИспользования.ПолучитьВесьСписокПритериевКодДвигателя("AIRC", КодОперации).ВыгрузитьЗначения());               	

	
	Если Элементы.ИндексМоделиДвигателя.СписокВыбора.НайтиПоЗначению(ИндексМоделиДвигателя) = Неопределено Тогда
		
		Элементы.ИндексМоделиДвигателя.СписокВыбора.Добавить(ИндексМоделиДвигателя);
		
	КонецЕсли;
	
	Если Элементы.КодМоделиДвигателя.СписокВыбора.НайтиПоЗначению(КодМоделиДвигателя) = Неопределено Тогда
		
		Элементы.КодМоделиДвигателя.СписокВыбора.Добавить(КодМоделиДвигателя);
		
	КонецЕсли;
	
	Если Элементы.КодКлУстановки.СписокВыбора.НайтиПоЗначению(КодКлиматическойУст) = Неопределено Тогда
		
		Элементы.КодКлУстановки.СписокВыбора.Добавить(КодКлиматическойУст);
		
	КонецЕсли;
	
	Если Элементы.КодМоделиКПП.СписокВыбора.НайтиПоЗначению(КодМоделиКПП) = Неопределено Тогда
		
		Элементы.КодМоделиКПП.СписокВыбора.Добавить(КодМоделиКПП);
		
	КонецЕсли;
	
	Если Элементы.ИндексМоделиКПП.СписокВыбора.НайтиПоЗначению(ИндексМоделиКПП) = Неопределено Тогда
		
		Элементы.ИндексМоделиКПП.СписокВыбора.Добавить(ИндексМоделиКПП);
		
	КонецЕсли;
	
	Если Элементы.КодТипаКузова.СписокВыбора.НайтиПоЗначению(КодТипаКузова) = Неопределено Тогда
		
		Элементы.КодТипаКузова.СписокВыбора.Добавить(КодТипаКузова);
		
	КонецЕсли;
	
	ТаблицаПереноса = "Список";
	
	УстановитьПривилегированныйРежим(Истина);
	//ДоступнаПятаяВерсия = ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5";
	ДоступнаПятаяВерсия = Истина;
	УстановитьПривилегированныйРежим(Ложь);
	
	ГруппаАвтоработРено = Справочники.Автоработы.НайтиПоНаименованию("DMS Renault",Истина);
	
	СформироватьДеревоСпецификаций(Отказ); 
	
	Если Отказ Тогда
	
		Сообщить("По модели <"+СокрЛП(Модель)+"> нет данных для подбора авторабот",СтатусСообщения.Информация);
		Возврат;
		
	КонецЕсли; 
	
	Список.Параметры.УстановитьЗначениеПараметра("РесурснаяСпецификация", Неопределено);
	Список.Параметры.УстановитьЗначениеПараметра("КодОперации", 		  Неопределено);
	Список.Параметры.УстановитьЗначениеПараметра("Модель", 		 		  Модель);
	Список.Параметры.УстановитьЗначениеПараметра("ВидРемонта", 		 	  ВидРемонта);
	Список.Параметры.УстановитьЗначениеПараметра("ДоступнаПятаяВерсия",   ДоступнаПятаяВерсия);
	Список.Параметры.УстановитьЗначениеПараметра("Нормочас",   			  Нормочас);
	Список.Параметры.УстановитьЗначениеПараметра("Код", 		 	  	  КодОтбор);
	Список.Параметры.УстановитьЗначениеПараметра("Артикул",   			  АртикулОтбор);
	Список.Параметры.УстановитьЗначениеПараметра("Наименование",   		  НаименованиеОтбор);
	
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("РесурснаяСпецификация", Неопределено);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("КодОперации", 		  	Неопределено);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Модель", 		 		Модель);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Авторабота", 		 	Неопределено);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ВремяВыполнения", 		Неопределено);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ВидРемонта", 		 	ВидРемонта);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ДоступнаПятаяВерсия",   ДоступнаПятаяВерсия);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Нормочас",   			Нормочас);
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
