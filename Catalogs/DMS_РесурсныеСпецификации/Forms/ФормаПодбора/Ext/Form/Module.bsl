	КонецЕсли; 
	
	СтандартнаяОбработка = Ложь;
	
	НоваяСтрока = ВыбранныеАвтоработы.Добавить();
	НоваяСтрока.Авторабота 		= ТекущаяСтрока.Авторабота;
	НоваяСтрока.ВремяВыполнения = ТекущаяСтрока.ВремяВыполнения;
	НоваяСтрока.Нормочас 		= ТекущаяСтрока.Нормочас;
	НоваяСтрока.Цена			= ТекущаяСтрока.Цена;
	НоваяСтрока.Количество 		= 1;
	
	УстановитьДекорациюИНадписьКорзины();
	
