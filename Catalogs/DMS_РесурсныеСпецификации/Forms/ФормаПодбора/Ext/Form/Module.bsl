&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ТекущаяСтрокаСпецификаций = Элементы.ДеревоСпецификаций.ТекущиеДанные;
	
	Если ПустаяСтрока(НаименованиеОтбор) И ПустаяСтрока(АртикулОтбор) И ПустаяСтрока(КодОтбор) Тогда	
		СпецификацияДляОтбора = ТекущаяСтрокаСпецификаций.РесурснаяСпецификация;
	Иначе 
		СпецификацияДляОтбора = ПустаяСпецификация;
	КонецЕсли; 
	
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("РесурснаяСпецификация", СпецификацияДляОтбора);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("КодОперации", 		  	ТекущаяСтрокаСпецификаций.КодОперации);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Модель", 		 		Модель);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Авторабота", 		 	ТекущаяСтрока.Авторабота);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ВремяВыполнения", 		ТекущаяСтрока.ВремяВыполнения);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ВидРемонта", 		 	ВидРемонта);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("ДоступнаПятаяВерсия",   ДоступнаПятаяВерсия);
	СписокСвязанныхРабот.Параметры.УстановитьЗначениеПараметра("Нормочас",   			Нормочас);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
