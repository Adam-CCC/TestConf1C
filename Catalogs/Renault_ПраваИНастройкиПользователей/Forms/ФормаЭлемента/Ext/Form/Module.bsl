&НаКлиенте
Процедура ОбновитьДоступностьКнопок ()
	
	Если Объект.РазрешитьРаботуСАрмМенеджера Тогда
		Элементы.ЗапускатьПриСтартеАрмМенеджера.Доступность = Истина;
	Иначе
		Элементы.ЗапускатьПриСтартеАрмМенеджера.Доступность = Ложь;
		Объект.ЗапускатьПриСтартеАрмМенеджера = Ложь;
	КонецЕсли;
	
	Если Объект.РазрешитьРаботуСАрмРесепшена Тогда
		Элементы.ЗапускатьПриСтартеАрмАдминистратора.Доступность = Истина;
	Иначе
		Элементы.ЗапускатьПриСтартеАрмАдминистратора.Доступность = Ложь;
		Объект.ЗапускатьПриСтартеАрмАдминистратора = Ложь;
	КонецЕсли;
	
	Если Объект.РазрешитьРаботуСАрмРОП Тогда
		Элементы.ЗапускатьПриСтартеАрмРОП.Доступность = Истина;
	Иначе
		Элементы.ЗапускатьПриСтартеАрмРОП.Доступность = Ложь;
		Объект.ЗапускатьПриСтартеАрмРОП = Ложь;
	КонецЕсли;
	
	Если Объект.РазрешитьРаботуСПанельюСообщений Тогда
		Элементы.ЗапкускатьПриСтартеПанельСообщений.Доступность = Истина;
	Иначе
		Элементы.ЗапкускатьПриСтартеПанельСообщений.Доступность = Ложь;
		Объект.ЗапкускатьПриСтартеПанельСообщений = Ложь;
	КонецЕсли;
	
	Если Объект.РазрешитьРаботуСАрмАвтосклад Тогда
		Элементы.ЗапускатьПриСтартеАрмАвтосклад.Доступность = Истина;
	Иначе
		Элементы.ЗапускатьПриСтартеАрмАвтосклад.Доступность = Ложь;
		Объект.ЗапускатьПриСтартеАрмАвтосклад = Ложь;
	КонецЕсли;
	
	Если Объект.РазрешитьРаботуСАрмКонтактЦентра Тогда
		Элементы.ЗапускатьПриСтартеАрмКонтактЦентра.Доступность = Истина;
		Элементы.РаботаетОнлайнКонсультант.Доступность = Истина;
		Элементы.РаботаютЛиды.Доступность = Истина;
		Элементы.РаботаетПочта.Доступность = Истина;
		Элементы.ПраваКЦМенеджер.Доступность = Истина;
		Элементы.ПраваКЦАдминистратор.Доступность = Истина;
	Иначе
		Элементы.ЗапускатьПриСтартеАрмКонтактЦентра.Доступность = Ложь;
		Элементы.РаботаетОнлайнКонсультант.Доступность = Ложь;
		Элементы.РаботаютЛиды.Доступность = Ложь;
		Элементы.РаботаетПочта.Доступность = Ложь;
		Элементы.ПраваКЦМенеджер.Доступность = Ложь;
		Элементы.ПраваКЦАдминистратор.Доступность = Ложь;
		Объект.ЗапускатьПриСтартеАрмКонтактЦентра = Ложь;
		Объект.РаботаетОнлайнКонсультант = Ложь;
		Объект.РаботаютЛиды = Ложь;
		Объект.РаботаетПочта = Ложь;
		Объект.ПраваКЦМенеджер = Ложь;
		Объект.ПраваКЦАдминистратор = Ложь;
	КонецЕсли;
	
	Если Объект.Продажи_ВсеЭтапыВыдачи Тогда
		Элементы.Продажи_ЭтапыВыдачи.Доступность = Ложь;
	Иначе
		Элементы.Продажи_ЭтапыВыдачи.Доступность = Истина;
	КонецЕсли;
	
	Элементы.Группа24.Видимость = ОтображатьДоступныеРоли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьюЗависимыхФлагов()
	Элементы.РазрешитьРаботуБСО.Доступность = не Объект.ДоступКПодразделуСтрахованияЗапрещен;
	
	ДоступностьСервис = Не Объект.ДоступКПодразделуАвтосервисЗапрещен;
	
	Элементы.Сервис_ПравоОткрыватьАрмАвтосервиса.Доступность = ДоступностьСервис;
	Элементы.Сервис_АрмАвтосервис_ПравоОткрыватьФормуИзмененияСтатуса.Доступность = ДоступностьСервис;
	Элементы.Сервис_АрмАвтосервис_ПравоОткрыватьФормуИзмененияСтатусовМоек.Доступность = ДоступностьСервис;
	Элементы.Сервис_ПравоНаЦентрализованныеАкции.Доступность = ДоступностьСервис;
	Элементы.Сервис_ПравоОткрыватьФормуМониторАвтосервиса.Доступность = ДоступностьСервис;
	Элементы.Сервис_ТолькоПросмотрПланировщика.Доступность = ДоступностьСервис;
	Элементы.РазрешитьУстанавливатьЦеныДопОборудования.Доступность = ДоступностьСервис;
	Элементы.Сервис_АрмАвтосервис_ЗапретНаСозданиеПростоевНаГрафике.Доступность = ДоступностьСервис;
	Элементы.Сервис_АрмАвтосервис_ЗапретНаУдалениеПростоевНаГрафике.Доступность = ДоступностьСервис;
	Элементы.ОтменаВыдачиЗаДругогоМенеджера.Доступность = ДоступностьСервис;
	Элементы.Гарантия_ПравоНаОткрытиеАРМ.Доступность = ДоступностьСервис;
	Элементы.УведомлениеОбОТСНепроданные.Доступность = ДоступностьСервис;
	Элементы.УведомлениеОбОТСПроданные.Доступность = ДоступностьСервис;
	
	Элементы.Сервис_ОткрыватьАрмАвтосервисаПриОткрытии.Доступность = ДоступностьСервис;
	Элементы.Сервис_АрмАвтосервис_ОткрыватьФормуИзмененияСтатусаПриОткрытии.Доступность = ДоступностьСервис;
	Элементы.Сервис_АрмАвтосервис_ОткрыватьФормуИзмененияСтатусовМоекПриОткрытии.Доступность = ДоступностьСервис;
	Элементы.Сервис_ОткрыватьФормуМониторАвтосервисаПриОткрытии.Доступность = ДоступностьСервис;
	Элементы.Сервис_ОткрыватьПанельИнформацииПоПлануПродажСотрудника.Доступность = ДоступностьСервис;
	
	Элементы.РазрешитьВыдачуКартыВручную.Доступность = ДоступностьСервис;
	Элементы.РазрешитьИзменениеПрограммыЛояльности.Доступность = ДоступностьСервис;
	Элементы.РазрешитьИзменятьПравилаУчастия.Доступность = ДоступностьСервис;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДоступностьКнопок();
	
	ПостроитьДеревоКонтактЦентр();
	
	//+++DMS Каназин А.И.
	ЗаполнениеОбращенияКлиентовНаСервере();
	//--- DMS Каназин А.И.
	
	УправлениеВидимостьюЗависимыхФлагов();
	
КонецПроцедуры    

&НаСервере
Процедура ЗаполнениеОбращенияКлиентовНаСервере()
	
	Выборка = Справочники.DMS_ПраваРолейПоОбращениям.Выбрать();
	
	Пока Выборка.Следующий() цикл    
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Право", Выборка.Ссылка);
		Если Объект.ОбращенияКлиентов.НайтиСтроки(ПараметрыОтбора).Количество() = 0 тогда
			НовПраво = Объект.ОбращенияКлиентов.Добавить();
			НовПраво.Право = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	
КонецПроцедуры

Процедура ПостроитьДеревоКонтактЦентр()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.Ссылка,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.НомерСтроки,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.ДилерскийЦентр,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.ТипТрафика,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.ТипЛида,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.ПереводТрафика,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.ВидимостьСвой,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.ВидимостьЧужой,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.ВидимостьОбщий,
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.СозданиеРЛ
	|ИЗ
	|	Справочник.Renault_ПраваИНастройкиПользователей.КонтактЦентр КАК Renault_ПраваИНастройкиПользователейКонтактЦентр
	|ГДЕ
	|	Renault_ПраваИНастройкиПользователейКонтактЦентр.Ссылка = &Ссылка
	|ИТОГИ ПО ДилерскийЦентр,
	|		ТипТрафика";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ВыборкаДЦ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если ВыборкаДЦ.Количество() = 0 Тогда
		
		ПредзаполнитьНастройкиКонтактЦентра();
		
	Иначе
		
		Пока ВыборкаДЦ.Следующий() Цикл
			СтрокаДЦ = КонтактЦентрДерево.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДЦ, ВыборкаДЦ);
			СтрокаДЦ.ЭтоСтрокаДЦ = Истина;
			ДЦПереводТрафика = Истина;
			ДЦВидимостьСвой = Истина;
			ДЦВидимостьЧужой = Истина;
			ДЦВидимостьОбщий = Истина;
			ДЦСозданиеРЛ = Истина;
			ВыборкаПоТипуТрафика = ВыборкаДЦ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоТипуТрафика.Следующий() Цикл
				Выборка = ВыборкаПоТипуТрафика.Выбрать();
				Если Выборка.Количество() > 1 Тогда
					ЛидПереводТрафика = Истина;
					ЛидВидимостьСвой = Истина;
					ЛидВидимостьЧужой = Истина;
					ЛидВидимостьОбщий = Истина;
					ЛидСозданиеРЛ = Истина;
					СтрокаТипТрафика = СтрокаДЦ.ПолучитьЭлементы().Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТипТрафика, ВыборкаПоТипуТрафика);
					Пока Выборка.Следующий() Цикл
						СтрокаТипЛида = СтрокаТипТрафика.ПолучитьЭлементы().Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаТипЛида, Выборка, , "ТипТрафика");
						СтрокаТипЛида.ТипТрафика = Выборка.ТипЛида;
						ЛидПереводТрафика = ЛидПереводТрафика И Выборка.ПереводТрафика;
						ЛидВидимостьСвой = ЛидВидимостьСвой И Выборка.ВидимостьСвой;
						ЛидВидимостьЧужой = ЛидВидимостьЧужой И Выборка.ВидимостьЧужой;
						ЛидВидимостьОбщий = ЛидВидимостьОбщий И Выборка.ВидимостьОбщий;
						ЛидСозданиеРЛ = ЛидСозданиеРЛ И Выборка.СозданиеРЛ;
					КонецЦикла;
					СтрокаТипТрафика.ПереводТрафика = ЛидПереводТрафика;
					СтрокаТипТрафика.ВидимостьСвой = ЛидВидимостьСвой;
					СтрокаТипТрафика.ВидимостьЧужой = ЛидВидимостьЧужой;
					СтрокаТипТрафика.ВидимостьОбщий = ЛидВидимостьОбщий;
					СтрокаТипТрафика.СозданиеРЛ = ЛидСозданиеРЛ;
				Иначе
					Пока Выборка.Следующий() Цикл
						СтрокаТипТрафика = СтрокаДЦ.ПолучитьЭлементы().Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаТипТрафика, Выборка);
						ДЦПереводТрафика = ДЦПереводТрафика И Выборка.ПереводТрафика;
						ДЦВидимостьСвой = ДЦВидимостьСвой И Выборка.ВидимостьСвой;
						ДЦВидимостьЧужой = ДЦВидимостьЧужой И Выборка.ВидимостьЧужой;
						ДЦВидимостьОбщий = ДЦВидимостьОбщий И Выборка.ВидимостьОбщий;
						ДЦСозданиеРЛ = ДЦСозданиеРЛ И Выборка.СозданиеРЛ;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			СтрокаДЦ.ПереводТрафика = ДЦПереводТрафика;
			СтрокаДЦ.ВидимостьСвой = ДЦВидимостьСвой;
			СтрокаДЦ.ВидимостьЧужой = ДЦВидимостьЧужой;
			СтрокаДЦ.ВидимостьОбщий = ДЦВидимостьОбщий;
			СтрокаДЦ.СозданиеРЛ = ДЦСозданиеРЛ;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПредзаполнитьНастройкиКонтактЦентра()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДилерскиеЦентры.Ссылка КАК ДилерскийЦентр,
	|	ТипыТрафика.Ссылка КАК ТипТрафика,
	|	ВЫБОР
	|		КОГДА ТипыТрафика.Ссылка = ЗНАЧЕНИЕ(Справочник.CRM_ТипТрафика.ЛидRenault)
	|			ТОГДА Renault_ТипыЛидов.Ссылка
	|		ИНАЧЕ ЗНАЧЕНИЕ(перечисление.Renault_ТипыЛидов.ПустаяСсылка)
	|	КОНЕЦ КАК ТипЛида
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК ДилерскиеЦентры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_ТипТрафика КАК ТипыТрафика
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Перечисление.Renault_ТипыЛидов КАК Renault_ТипыЛидов
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ТипыТрафика.Ссылка В(&ТипыТрафика)
	|
	|СГРУППИРОВАТЬ ПО
	|	ДилерскиеЦентры.Ссылка,
	|	ТипыТрафика.Ссылка,
	|	ВЫБОР
	|		КОГДА ТипыТрафика.Ссылка = ЗНАЧЕНИЕ(Справочник.CRM_ТипТрафика.ЛидRenault)
	|			ТОГДА Renault_ТипыЛидов.Ссылка
	|		ИНАЧЕ ЗНАЧЕНИЕ(перечисление.Renault_ТипыЛидов.ПустаяСсылка)
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДилерскийЦентр
	|ИТОГИ ПО
	|	ДилерскийЦентр,
	|	ТипТрафика";
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Справочники.CRM_ТипТрафика.Email);
	МассивТипов.Добавить(Справочники.CRM_ТипТрафика.OnlineКонсультант);
	МассивТипов.Добавить(Справочники.CRM_ТипТрафика.ЛидRenault);
	Запрос.УстановитьПараметр("ТипыТрафика", МассивТипов);
	ВыборкаДЦ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДЦ.Следующий() Цикл
		СтрокаДЦ = КонтактЦентрДерево.ПолучитьЭлементы().Добавить();
		СтрокаДЦ.ДилерскийЦентр = ВыборкаДЦ.ДилерскийЦентр;
		СтрокаДЦ.ЭтоСтрокаДЦ = Истина;
		ВыборкаТипТрафика = ВыборкаДЦ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаТипТрафика.Следующий() Цикл
			СтрокаТипТрафика = СтрокаДЦ.ПолучитьЭлементы().Добавить();
			СтрокаТипТрафика.ДилерскийЦентр = ВыборкаТипТрафика.ДилерскийЦентр;
			СтрокаТипТрафика.ТипТрафика = ВыборкаТипТрафика.ТипТрафика;
			ВыборкаТипЛида = ВыборкаТипТрафика.Выбрать();
			Если ВыборкаТипЛида.Количество() > 1 Тогда
				Пока ВыборкаТипЛида.Следующий() Цикл
					СтрокаТипЛида = СтрокаТипТрафика.ПолучитьЭлементы().Добавить();
					СтрокаТипЛида.ДилерскийЦентр = ВыборкаТипЛида.ДилерскийЦентр;
					СтрокаТипЛида.ТипТрафика = ВыборкаТипЛида.ТипЛида;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

