&НаКлиенте
Процедура ПроверкаВремениСПо()
	ТекущаяСтрока = Элементы.События.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		ВремяУтроС = ТекущаяСтрока.ВремяОтправкиУтроС;
		ВремяУтроПо = ТекущаяСтрока.ВремяОтправкиУтроПо;
		ВремяВечерС = ТекущаяСтрока.ВремяОтправкиВечерС;
		ВремяВечерПо = ТекущаяСтрока.ВремяОтправкиВечерПо; 
		ЕстьСообщение = Ложь;
		
		Если ЗначениеЗаполнено(ВремяУтроС) И ЗначениеЗаполнено(ВремяУтроПо) И
			ВремяУтроС >= ВремяУтроПо  Тогда
			ТекущаяСтрока.ВремяОтправкиУтроПо = '0001-01-01';
			ЕстьСообщение = Истина;			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВремяВечерС) И ЗначениеЗаполнено(ВремяВечерПо) И
			ВремяВечерС >= ВремяВечерПо  Тогда
			ТекущаяСтрока.ВремяОтправкиВечерПо = '0001-01-01';
			ЕстьСообщение = Истина; 			
		КонецЕсли;
		
		Если ЕстьСообщение Тогда
			Сообщить("Начальное время должно быть меньше конечного!");
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры


