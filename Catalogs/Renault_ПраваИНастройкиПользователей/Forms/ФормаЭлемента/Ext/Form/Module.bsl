&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.КонтактЦентр.Очистить();
	Для Каждого Элемент ИЗ КонтактЦентрДерево.ПолучитьЭлементы() Цикл
		Для Каждого ЭлементСтрока ИЗ Элемент.ПолучитьЭлементы() Цикл
			УровеньНиже = ЭлементСтрока.ПолучитьЭлементы();
			Если УровеньНиже.Количество() = 0 Тогда
				НоваяСтрока = ТекущийОбъект.КонтактЦентр.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементСтрока);
			Иначе
				Для Каждого ЭлементСтрокаТипЛида ИЗ УровеньНиже Цикл
					НоваяСтрока = ТекущийОбъект.КонтактЦентр.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементСтрокаТипЛида, , "ТипТрафика");
					НоваяСтрока.ТипТрафика = ЭлементСтрока.ТипТрафика;
					НоваяСтрока.ТипЛида = ЭлементСтрокаТипЛида.ТипТрафика;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

