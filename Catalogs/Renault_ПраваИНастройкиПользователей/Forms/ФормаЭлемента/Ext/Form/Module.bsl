&НаКлиенте
Процедура ЗаполнитьАдминистратор(Команда)
	
	Ответ = Вопрос("Настройки будут сброшены. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		КонтактЦентрДерево.ПолучитьЭлементы().Очистить();
		Если ЗначениеЗаполнено(Объект.ДилерскийЦентр) Тогда
			ПредзаполнитьНастройкиКонтактЦентра();
			Коллекция = КонтактЦентрДерево.ПолучитьЭлементы();
			Для Каждого Элемент ИЗ Коллекция Цикл
				Если Элемент.ДилерскийЦентр = Объект.ДилерскийЦентр Тогда
					Элемент.ПереводТрафика = Истина;
					Элемент.ВидимостьСвой = Истина;
					Элемент.ВидимостьЧужой = Истина;
					Элемент.ВидимостьОбщий = Истина;
					Для Каждого Строка ИЗ Элемент.ПолучитьЭлементы() Цикл
						Строка.ПереводТрафика = Истина;
						Строка.ВидимостьСвой = Истина;
						Строка.ВидимостьЧужой = Истина;
						Строка.ВидимостьОбщий = Истина;
						Для Каждого СтрокаНиз ИЗ Строка.ПолучитьЭлементы() Цикл
							СтрокаНиз.ПереводТрафика = Истина;
							СтрокаНиз.ВидимостьСвой = Истина;
							СтрокаНиз.ВидимостьЧужой = Истина;
							СтрокаНиз.ВидимостьОбщий = Истина;
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

