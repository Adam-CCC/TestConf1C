	ИмяФормыОтчета = МетаданныеОтчета.ПолноеИмя() + ".Форма";
	
	Показатели      = НастройкиВарианта.Выбор;
	ОтборОтчета     = НастройкиВарианта.Отбор;
	СтруктураОтчета = НастройкиВарианта.Структура;
	
