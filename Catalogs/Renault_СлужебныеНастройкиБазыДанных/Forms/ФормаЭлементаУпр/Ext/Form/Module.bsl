&НаСервереБезКонтекста
Процедура ТестПодключенияВебСервисаНаСервере(АдресWSВебСервиса,ЛогинWSВебСервиса,ПарольWSВебСервиса)
	
	Попытка
		АдресWS = АдресWSВебСервиса;
		ЛогинWS = ЛогинWSВебСервиса;
		ПарольWS = ПарольWSВебСервиса;
		Определение = Новый WSОпределения(АдресWS,ЛогинWS, ПарольWS);
		Если Определение.Сервисы.Количество()>0 Тогда
			ВебСервис = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен,Определение.Сервисы[0].Имя,Определение.Сервисы[0].ТочкиПодключения[0].Имя);
			ВебСервис.Пользователь = ЛогинWS;
			ВебСервис.Пароль = ПарольWS;
			Сообщить("Подключение установлено!");  //Предупреждение
		Иначе
			Сообщить("Подключение не установлено!");
		КонецЕсли;
	Исключение
		Сообщить("Подключение не установлено!");
		Сообщить(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

