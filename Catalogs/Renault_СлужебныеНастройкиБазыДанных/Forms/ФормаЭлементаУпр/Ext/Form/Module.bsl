		Объект.SMSMTS = Ложь;
		Объект.SMSRenault = Ложь;
	ИначеЕсли ЭлементИмя = "SMSMTS" Тогда
		Объект.SMSNotice = Ложь; 
		Объект.SMSRenault = Ложь;
