
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Эл=Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Эл.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Ссылка");
	Эл.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
	Эл.Использование=Не РольДоступна("ПолныеПрава");
	Эл.ПравоеЗначение=Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
КонецПроцедуры
