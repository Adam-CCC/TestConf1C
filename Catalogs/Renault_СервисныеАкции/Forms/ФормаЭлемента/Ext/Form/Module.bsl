	ТЧ=СтрЗаменить(Команда.Имя,"кнЗаполнитьСкидки","");
	Для Каждого Стр Из ЭтаФорма[ТЧ] Цикл
	//Для Каждого Стр Из Объект[ТЧ] Цикл
		Для Каждого Эл Из Парам Цикл
			//Если Эл.Значение=0 Тогда Продолжить КонецЕсли;
			Стр[Эл.Ключ]=Эл.Значение
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры

