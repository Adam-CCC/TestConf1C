Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицу("Работы");
	ЗаполнитьТаблицу("Запчасти");
	ДоступностьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) ПоместитьТаблицы() КонецПроцедуры

Процедура ДоступностьЭлементов()
	ВцеломНаЗаказ=?(Объект.ПредоставляетсяНаЗаказНаряд=0,Ложь,Истина);
	Элементы.грСкидкаНаЗаказНаряд.Доступность=ВцеломНаЗаказ;
	Элементы.грЗапчасти.Видимость=НЕ ВцеломНаЗаказ;
	Элементы.грРаботы.Видимость=НЕ ВцеломНаЗаказ;
КонецПроцедуры	

Процедура ЗаполнитьТаблицу(ТЧ,МассивСтрок=Неопределено)
	Запрос=Новый Запрос;
	Если МассивСтрок=Неопределено Тогда
		Запрос.УстановитьПараметр("Т",Объект[ТЧ].Выгрузить()); //загрузка из тч справочника в ТаблицуЗначений
	Иначе
		Запрос.УстановитьПараметр("Т",ЭтаФорма[ТЧ].Выгрузить(МассивСтрок)); //редактирование строки ТаблицыЗначений
	КонецЕсли;	
	Запрос.Текст="
	|Выбрать т.Элемент,т.СкидкаВПроцентах,т.СкидкаВРублях,т.КомпенсацияВРублях Поместить т Из &Т т
	|;
	|Выбрать
	|	Элемент,СкидкаВПроцентах,СкидкаВРублях,КомпенсацияВРублях,
	|	Максимум(Цены.Цена) Цена
	|Из т т Левое Соединение 
	|РегистрСведений.ЦеныАвторабот.СрезПоследних(,ТипЦен=Значение(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)) Цены 
	|По т.Элемент=Цены.Авторабота
	|Сгруппировать По Элемент,СкидкаВПроцентах,СкидкаВРублях,КомпенсацияВРублях
	|";
	
	Если ТЧ="Запчасти" Тогда
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"РегистрСведений.ЦеныАвторабот","РегистрСведений.Цены");
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"Авторабота","Номенклатура");
	КонецЕсли;	
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если МассивСтрок=Неопределено Тогда
			Строка=ЭтаФорма[ТЧ].Добавить();
			ЗаполнитьЗначенияСвойств(Строка,Выборка);
		Иначе
			Для Каждого Стр Из МассивСтрок Цикл
				Если Стр.Элемент=Выборка.Элемент Тогда
					Строка=Стр;
					Прервать
				КонецЕсли;	
			КонецЦикла;	
			Строка.Цена=Выборка.Цена;
		КонецЕсли;	
		
		//связанные автоработы и запчасти
		Результат=СвязанныеРаботы(Выборка.Элемент);
		ВыборкаСв=Результат.Выбрать();
		Пока ВыборкаСв.Следующий() Цикл Строка.СвязанныеРаботы=Строка.СвязанныеРаботы+?(Строка.СвязанныеРаботы="","",Символы.ПС)+ВыборкаСв.СвязаннаяРабота+" ("+ВыборкаСв.Количество+")" КонецЦикла;
		
		//картинка
		Если ТЧ="Работы" Тогда Строка.ЭтоКомплект=?(Результат.Пустой(),3,6) КонецЕсли;	
		
	КонецЦикла;	
КонецПроцедуры
Процедура ПоместитьТаблицы()
	Объект.Работы.Загрузить(Работы.Выгрузить());
	Объект.Запчасти.Загрузить(Запчасти.Выгрузить());
КонецПроцедуры

Функция СвязанныеРаботы(Работа)
	Запрос=Новый Запрос("Выбрать СвязаннаяРабота,Количество Из РегистрСведений.СвязанныеРаботы ГДЕ Авторабота=&Авторабота");
	Запрос.УстановитьПараметр("Авторабота",Работа);
	Возврат Запрос.Выполнить()
КонецФункции	

