&НаКлиенте
Процедура кнПодбор(Команда)
	ТЧ=СтрЗаменить(Команда.Имя,"кнПодбор","");
	ОткрытьФорму("Справочник.Renault_СервисныеАкции.Форма.ПодборЭлементовАкции",Новый Структура("ВидыНоменклатуры,ТЧ",ОтборПоВидуНоменклатуры(ТЧ),ТЧ),ЭтаФорма,УникальныйИдентификатор)
КонецПроцедуры

Функция ОтборПоВидуНоменклатуры(ТЧ)
	Если ТЧ="Работы" Тогда Возврат "" КонецЕсли;
	ЗначениеОтбора=РеквизитФормыВЗначение("Объект").Метаданные().ТабличныеЧасти[ТЧ].Реквизиты.Элемент.ПараметрыВыбора[0].Значение;
	Если ТипЗнч(ЗначениеОтбора)=Тип("ФиксированныйМассив") Тогда
		Массив=Новый Массив(ЗначениеОтбора);
	Иначе
		Массив=Новый Массив;
		Массив.Добавить(ЗначениеОтбора);
	КонецЕсли;
	Возврат Массив
КонецФункции	

&НаКлиенте
Процедура ДобавитьМассив(Массив,ТЧ) Экспорт //CALLBACK из формы подбора
	Если ТипЗнч(Массив)=Тип("Массив") Тогда
		Для Каждого Эл Из Массив Цикл ДобавитьСтроку(Эл,ТЧ) КонецЦикла;	
	Иначе ДобавитьСтроку(Массив,ТЧ) КонецЕсли;
КонецПроцедуры

Процедура ДобавитьСтроку(ЭлементПодбора,ТЧ)
	//если выбрана группа то добавим каждый элемент в иерархии с отбором по виду номенклатуры
	Если ЭлементПодбора.ЭтоГруппа Тогда
		
		Если ТЧ="Запчасти" Тогда
			Запрос=Новый Запрос("Выбрать Ссылка ИЗ Справочник.Номенклатура ГДЕ Ссылка В Иерархии(&Группа) И НЕ ЭтоГруппа И НЕ ПометкаУдаления И ВидНоменклатуры В(&ВидыНоменклатуры)");
			Запрос.УстановитьПараметр("ВидыНоменклатуры",ОтборПоВидуНоменклатуры(ТЧ));
		Иначе
			Запрос=Новый Запрос("Выбрать Ссылка ИЗ Справочник.Автоработы ГДЕ Ссылка В Иерархии(&Группа) И НЕ ЭтоГруппа И НЕ ПометкаУдаления");
		КонецЕсли;
		Запрос.УстановитьПараметр("Группа",ЭлементПодбора);
		
		Выборка=Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл ДобавитьСтроку(Выборка.Ссылка,ТЧ) КонецЦикла;	
		Возврат	
	КонецЕсли;
	
	//Если Объект[ТЧ].НайтиСтроки(Новый Структура("Элемент",ЭлементПодбора)).Количество()>0 Тогда Возврат КонецЕсли;
	//Стр=Объект[ТЧ].Добавить();
	
	Если ЭтаФорма[ТЧ].НайтиСтроки(Новый Структура("Элемент",ЭлементПодбора)).Количество()>0 Тогда Возврат КонецЕсли;

	//проверим чтобы подчиненные работы в комплекте не были добавлены отдельно
	Если НЕ ПроверкаЭлемента(ЭлементПодбора) Тогда Возврат КонецЕсли;	
	
	Стр=ЭтаФорма[ТЧ].Добавить();
	
	Стр.Элемент=ЭлементПодбора;
	//Стр.Цена=ЗаполнитьЦены(ТЧ,ЭлементПодбора);
	
	Массив=Новый Массив; Массив.Добавить(Стр);
	ЗаполнитьТаблицу(ТЧ,Массив);
	
КонецПроцедуры

Функция ПроверкаЭлемента(Элемент)
	
	//Элемент не должна быть в составляющих работ
	Для Каждого Стр Из Работы Цикл
		Выборка=СвязанныеРаботы(Стр.Элемент).Выбрать();	
		Пока Выборка.Следующий() Цикл
			Если Выборка.СвязаннаяРабота=Элемент Тогда
				Сообщить("Запчасть "+Элемент+" принадлежит комплекту "+Выборка.СвязаннаяРабота+", 
				|	который уже добавлен. Добавление не возможно",СтатусСообщения.Внимание);
				Возврат	Ложь
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
	Если ТипЗнч(Элемент)=Тип("СправочникСсылка.Автоработы") Тогда
		//составляющие работы не должны быть в Запчастях и Работах
		
		Выборка=СвязанныеРаботы(Элемент).Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ТипЗнч(Выборка.СвязаннаяРабота)=Тип("СправочникСсылка.Номенклатура") Тогда
				ТЧ=Запчасти;
			ИначеЕсли ТипЗнч(Выборка.СвязаннаяРабота)=Тип("СправочникСсылка.Автоработы") Тогда
				ТЧ=Работы;
			КонецЕсли;	
			
			Если ТЧ.НайтиСтроки(Новый Структура("Элемент",Выборка.СвязаннаяРабота)).Количество()>0 Тогда 
				Сообщить("Комплект "+Элемент+" содержит элемент "+Выборка.СвязаннаяРабота+", 
				|	который уже добавлен. Добавление не возможно",СтатусСообщения.Внимание);
				Возврат	Ложь
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;	
	
	Возврат Истина
КонецФункции	

