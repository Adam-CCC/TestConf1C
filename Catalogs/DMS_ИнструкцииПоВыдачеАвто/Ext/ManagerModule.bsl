Процедура ЗагрузитьИнструкции() Экспорт
	
	ВебСервис = ПолучитьПрокси();
	
	СериализованнаяТаблицаИнструкций = ВебСервис.GetInstructions();
	
	ДатаАктуальности = ТекущаяДата();	
	
	ОбновитьМодели = Ложь;
	
	ТаблицаИнструкций = СериализаторXDTO.ПрочитатьXDTO(СериализованнаяТаблицаИнструкций);
	
	Для Каждого Строка Из ТаблицаИнструкций Цикл		
		
		Модель = Справочники.Модели.НайтиПоРеквизиту("Артикул",Строка.Наименование);
		Если Модель = Справочники.Модели.ПустаяСсылка() Тогда
			ОбновитьМодели = Истина;
			Продолжить;
		КонецЕсли;	
		
		Если Справочники.DMS_ИнструкцииПоВыдачеАвто.НайтиПоНаименованию(Строка.Наименование) = Справочники.DMS_ИнструкцииПоВыдачеАвто.ПустаяСсылка() Тогда
			НовыйЭлемент = Справочники.DMS_ИнструкцииПоВыдачеАвто.СоздатьЭлемент();
		Иначе
			НовыйЭлемент = Справочники.DMS_ИнструкцииПоВыдачеАвто.НайтиПоНаименованию(Строка.Наименование).ПолучитьОбъект();	
		КонецЕсли;
		
		НовыйЭлемент.Модель = Модель;
		НовыйЭлемент.Наименование = Модель.Артикул;
		НовыйЭлемент.НеобходимыеСведения  = Строка.НеобходимыеСведения;
		НовыйЭлемент.ПолезнаяИнформация   = Строка.ПолезнаяИнформация;
		НовыйЭлемент.ИсчерпывающаяИнформация = Строка.ИсчерпывающаяИнформация;
		НовыйЭлемент.Записать();
		
	КонецЦикла;
	
	Если ОбновитьМодели Тогда
		Renault_ЗагрузкаТарифа.ЗагрузитьМодели();
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПрокси()
	
	
	ВозвращаемоеЗначение = Ложь;
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	Адрес = Настройки.АдресWsGate;
		
		ОпределениеСервиса = Новый WSОпределения(СокрЛП(Адрес) + "ws/CarInfo.1cws?wsdl", ЛогинWS, ПарольWS);
		ВебСервис = Новый WSПрокси(
			ОпределениеСервиса, 
			"http://renault.ru/WSGate/GetCarInfo", 
			"Renault_CarInfo",
			"Renault_CarInfoSoap12",
			3600);
		ВебСервис.Пользователь	 = ЛогинWS;
		ВебСервис.Пароль		 = ПарольWS;
		
   Возврат ВебСервис;
	
КонецФункции

Функция Печать(Инструкция) Экспорт
	
	Попытка	
		ЗагрузитьИнструкции();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
		Макет = ПолучитьМакет("Макет");	
		ОбластьНеобходимыеСведения =  Макет.ПолучитьОбласть("Строки|НеобходимыеСведения");
		ОбластьПолезнаяИнформация =  Макет.ПолучитьОбласть("Строки|ПолезнаяИнформация");
		ОбластьИсчерпывающаяИнформация =  Макет.ПолучитьОбласть("Строки|ИсчерпывающаяИнформация");
		ОбластьПодвалНеобходимыеСведения =  Макет.ПолучитьОбласть("Подвал|НеобходимыеСведения");
		ОбластьПодвалПолезнаяИнформация =  Макет.ПолучитьОбласть("Подвал|ПолезнаяИнформация");
		ОбластьПодвалИсчерпывающаяИнформация =  Макет.ПолучитьОбласть("Подвал|ИсчерпывающаяИнформация");
		
		ОбластьНеобходимыеСведения.Параметры.Заполнить(Инструкция);	
		ОбластьНеобходимыеСведения.Параметры.ПС = Символы.ПС;
		ОбластьПолезнаяИнформация.Параметры.Заполнить(Инструкция);	
		ОбластьПолезнаяИнформация.Параметры.ПС = Символы.ПС;
		ОбластьИсчерпывающаяИнформация.Параметры.Заполнить(Инструкция);
		ОбластьИсчерпывающаяИнформация.Параметры.ПС = Символы.ПС;
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Вывести(ОбластьНеобходимыеСведения);
		ТабДок.Присоединить(ОбластьПолезнаяИнформация);
		ТабДок.Присоединить(ОбластьИсчерпывающаяИнформация);
		
		ТабДок.Вывести(ОбластьПодвалНеобходимыеСведения);
		ТабДок.Присоединить(ОбластьПодвалПолезнаяИнформация);
		ТабДок.Присоединить(ОбластьПодвалИсчерпывающаяИнформация);
		
		Возврат ТабДок;
		
КонецФункции