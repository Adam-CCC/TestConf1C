
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БонусныйТипКарты = (Объект.ТипКарты = Перечисления.DMS_ТипыКартЛояльности.Бонусная);
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
						
		РасписаниеРегламентногоЗадания = Справочники.DMS_ВидыКартЛояльности.РасписаниеРегламентногоЗаданияПоУмолчанию();
		
		Объект.ИспользоватьРегламентноеЗадание = Истина;
		
	Иначе
		
		Если Объект.ТипКарты = Перечисления.DMS_ТипыКартЛояльности.Бонусная Тогда
			
			// Получаем расписание из самого регламентного задания
			// если РЗ не задано, то расписание = Неопределено и будет создано на клиенте в момент редактирования расписания.
			РасписаниеРегламентногоЗадания = Справочники.DMS_ВидыКартЛояльности.ПолучитьРасписаниеВыполненияОбменаДанными(Объект.Ссылка);
		
		КонецЕсли; 
		
	КонецЕсли;
		
	УстановитьВидимость();	
	УстановитьЗаголовкиПериодичностиСрокаДействияБаллов();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
		
	ТекущийОбъект.ИспользоватьРегламентноеЗадание = (Не ТекущийОбъект.ПометкаУдаления И ТекущийОбъект.ИспользоватьСрокДействияБаллов И ТекущийОбъект.ТипКарты = Перечисления.DMS_ТипыКартЛояльности.Бонусная);
	
	Справочники.DMS_ВидыКартЛояльности.ОбновитьДанныеРегламентногоЗадания(Отказ, РасписаниеРегламентногоЗадания, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура НачислениеБалловОтТекущегоНакопленияПриИзменении(Элемент)
	УстановитьВидимость();	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьСрокДействияБалловПриИзменении(Элемент)
	УстановитьВидимость();	
КонецПроцедуры

&НаКлиенте
Процедура СрокДействияПриИзменении(Элемент)
	УстановитьЗаголовкиПериодичностиСрокаДействияБаллов();
КонецПроцедуры

&НаКлиенте
Процедура ТипКартыПриИзменении(Элемент)
	
	БонусныйТипКарты = (Объект.ТипКарты = Перечисления.DMS_ТипыКартЛояльности.Бонусная);
	
	УстановитьВидимость();	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()

	Элементы.СтраницаШкалаНачисленияБаллов.Видимость = Объект.НачислениеБалловОтТекущегоНакопления;	
	Элементы.СтраницаСрокДействия.Видимость			 = Объект.ИспользоватьСрокДействияБаллов;	
	
	Элементы.НачислениеБалловОтТекущегоНакопления.Видимость = БонусныйТипКарты;
	Элементы.ИспользоватьСрокДействияБаллов.Видимость 		= БонусныйТипКарты;
	Элементы.СтраницаПравилаЗаменыКарты.Видимость 		    = БонусныйТипКарты;
	Элементы.СтраницаПравилаЗаменыБонуснойКарты.Видимость   = БонусныйТипКарты;
	//Элементы.СтраницаШкалаНачисленияБаллов.Видимость 		= БонусныйТипКарты;
	//Элементы.СтраницаСрокДействия.Видимость 				= БонусныйТипКарты;
	Элементы.Уровень.Видимость 								= БонусныйТипКарты;
	Элементы.СтраницаВыдачаКарты.Видимость 					= БонусныйТипКарты;
	Элементы.СтраницаПривилегии.Видимость 					= БонусныйТипКарты;
	
КонецПроцедуры // УстановитьВидимость()

&НаСервере
Процедура УстановитьЗаголовкиПериодичностиСрокаДействияБаллов()

	Если Объект.СрокДействияБаллов = 1 Тогда
	
		СписокПериодичности = Элементы.Периодичность.СписокВыбора;
		
		ЭлементСписка = СписокПериодичности.НайтиПоЗначению(Перечисления.DMS_ПериодичностьДействияБаллов.День);
		ЭлементСписка.Представление = "дня";
		
		ЭлементСписка = СписокПериодичности.НайтиПоЗначению(Перечисления.DMS_ПериодичностьДействияБаллов.Месяц);
		ЭлементСписка.Представление = "месяца";
		
		ЭлементСписка = СписокПериодичности.НайтиПоЗначению(Перечисления.DMS_ПериодичностьДействияБаллов.Год);
		ЭлементСписка.Представление = "года";
		
	Иначе 
	
		СписокПериодичности = Элементы.Периодичность.СписокВыбора;
		
		ЭлементСписка = СписокПериодичности.НайтиПоЗначению(Перечисления.DMS_ПериодичностьДействияБаллов.День);
		ЭлементСписка.Представление = "дней";
		
		ЭлементСписка = СписокПериодичности.НайтиПоЗначению(Перечисления.DMS_ПериодичностьДействияБаллов.Месяц);
		ЭлементСписка.Представление = "месяцев";
		
		ЭлементСписка = СписокПериодичности.НайтиПоЗначению(Перечисления.DMS_ПериодичностьДействияБаллов.Год);
		ЭлементСписка.Представление = "лет";
		
	КонецЕсли; 	

КонецПроцедуры // УстановитьЗаголовкиПериодичностиСрокаДействияБаллов()
