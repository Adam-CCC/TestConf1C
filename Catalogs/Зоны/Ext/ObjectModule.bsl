Перем НужноМенятьПодчиненные;

Процедура ПередЗаписью(Отказ)
	Если НЕ обПраво("РедактированиеЛогикиСклада",глПрава) Тогда
		Сообщить("Нет прав на изменение зон, рядов, стеллажей", СтатусСообщения.Важное);
		Отказ = истина;
		Возврат;
	КонецЕсли;
	
	ИдентификаторДляЯрлыкаДляПроверки = ПривестиИдентификатор(ИдентификаторДляЯрлыка);
	
	Если Ссылка.ИдентификаторДляЯрлыка <> ИдентификаторДляЯрлыкаДляПроверки Тогда
		ИдентификаторДляЯрлыка = ИдентификаторДляЯрлыкаДляПроверки;
		Код = Владелец.ИдентификаторДляЯрлыка + "-"+ИдентификаторДляЯрлыка;
	КонецЕсли;
	
	Если Ссылка.Код <> Код ИЛИ ПометкаУдаления Тогда
		НужноМенятьПодчиненные = истина;
	КонецЕсли;
КонецПроцедуры

Функция ПривестиИдентификатор(Идентификатор)
	Попытка 
		Идентификатор = Формат(Число(СокрЛП(Идентификатор)), "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	Исключение
		Идентификатор = СокрЛП(Идентификатор);
	КонецПопытки;
	Возврат Идентификатор;
КонецФункции

Процедура ПриЗаписи(Отказ)
	Если НЕ ОТказ И НужноМенятьПодчиненные <> Неопределено И НужноМенятьПодчиненные  Тогда
		НачатьТранзакцию();
		Попытка
			ВыборкаПодчиненных = Справочники.Ряды.Выбрать(, Ссылка);
			Пока ВыборкаПодчиненных.Следующий() Цикл
				ПодчиненныйОбъект = ВыборкаПодчиненных.ПолучитьОбъект();
				ПодчиненныйОбъект.Код = Код + "-" + ПодчиненныйОбъект.ИдентификаторДляЯрлыка;
				ПодчиненныйОбъект.ПометкаУдаления = ПодчиненныйОбъект.ПометкаУдаления ИЛИ ПометкаУдаления;
				ПодчиненныйОбъект.Записать();
			КонецЦикла;
		Исключение
			ОтменитьТранзакцию();
			Отказ = истина;
			Сообщить("Не удалось изменить идентификатор для вложенных элементов. Смена имени зоны невозможна");
			Возврат;
		КонецПопытки;
		ЗафиксироватьТранзакцию();
	КонецЕсли;
КонецПроцедуры


