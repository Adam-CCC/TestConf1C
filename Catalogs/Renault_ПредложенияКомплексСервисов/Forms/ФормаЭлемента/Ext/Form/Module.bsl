&НаКлиенте
Процедура РедактироватьОписаниеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Документ = ДополнительныеПараметры.Документ;
	
	ОтредактТекст = Результат;
	
	Если ОтредактТекст <> Неопределено Тогда
		Документ.body.innerHTML = ОтредактТекст;
		Объект.ОписаниеHTML = ОтредактТекст;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОписаниеHTMLДокументСформирован(Элемент)
	
	Документ = Элемент.Документ;
	Документ.Body.innerHTML = Объект.ОписаниеHTML;
	Документ.body.scroll = "no";

КонецПроцедуры

&НаКлиенте
Процедура КомплексСервисНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Renault_ОбщегоНазначенияПовтИсп.Renault_Это83() Тогда
		ВЫПОЛНИТЬ("ОткрытьФорму(""Справочник.Renault_ПредложенияКомплексСервисов.Форма.ФормаПодбораКС"",,ЭтаФорма,,,, , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс)");
	Иначе
		ОткрытьФорму("Справочник.Renault_ПредложенияКомплексСервисов.Форма.ФормаПодбораКС",,ЭтаФорма);			
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(Объект.ПериодПроведенияС) Тогда
		Объект.ПериодПроведенияС = ТекущаяДата();
	КонецЕсли;			
	
	Если НЕ ЗначениеЗаполнено(Объект.ПериодПроведенияПо) Тогда
		Объект.ПериодПроведенияПо = ДобавитьМесяц(ТекущаяДата(),12);
	КонецЕсли;			

	Если Модифицированность = Истина Тогда
		Объект.ДатаИзменения = ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры

