&НаКлиенте
Процедура РедактироватьОписание(Команда)
	
	Документ = Элементы.ОписаниеHTML.Документ;
	ТекстДляРедактирования = Документ.body.innerHTML;
	Параметр = Новый Структура("ТекстHTML", ТекстДляРедактирования);
	
	ОтредактТекст = Неопределено;
	
	Если Renault_ОбщегоНазначенияПовтИсп.Renault_Это83() Тогда
		ВЫПОЛНИТЬ("ОткрытьФорму(""Обработка.Renault_РедакторHTML.Форма"",Параметр,ЭтаФорма,,,, Новый ОписаниеОповещения(""РедактироватьОписаниеЗавершение"", Объект, Новый Структура(""Документ"", Документ)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс)");
	Иначе
		ОткрытьФорму("Обработка.Renault_РедакторHTML.Форма",Параметр,ЭтаФорма);			
	КонецЕсли;

КонецПроцедуры

