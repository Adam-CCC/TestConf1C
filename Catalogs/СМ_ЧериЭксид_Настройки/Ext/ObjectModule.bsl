Функция ПолучитьОбязательныеРеквизиты(ДляЭлемента = Истина, ДляГруппы = Ложь) Экспорт
	
	ОбязательныеРеквизиты=Новый Структура();
	ОбязательныеРеквизиты.Вставить("Код",1);
	ОбязательныеРеквизиты.Вставить("Наименование",3);
	
	Если ДляЭлемента Тогда
		
		ОбязательныеРеквизиты.Вставить("КлючАПИ",1);
		ОбязательныеРеквизиты.Вставить("КодДилера",1);
		ОбязательныеРеквизиты.Вставить("Марка",1);
		ОбязательныеРеквизиты.Вставить("Дилер",1);
		
		ОбязательныеРеквизитыТЧ = Новый Структура;
		ОбязательныеРеквизитыТЧ.Вставить("ПодразделениеКомпании", 3);
 		ОбязательныеРеквизитыТЧ.Вставить("Подразделения" , ОбязательныеРеквизитыТЧ);
		
		ОбязательныеРеквизитыТЧ1 = Новый Структура;
		ОбязательныеРеквизитыТЧ1.Вставить("Склад", 3);
 		ОбязательныеРеквизиты.Вставить("Склады" , ОбязательныеРеквизитыТЧ1);

	КонецЕсли;
	
	Возврат ОбязательныеРеквизиты;
	
КонецФункции
