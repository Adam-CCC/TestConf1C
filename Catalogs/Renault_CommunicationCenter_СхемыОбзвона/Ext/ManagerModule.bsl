	КонецЦикла;
	
	Возврат ТекстДополнения;
	
КонецФункции

Функция ДополнитьТекстОтборомПоСобытиям(СхемаОбзвона)
	
    ТекстДополнения = ""
	
	+ ?(СхемаОбзвона.СервисныеКампании.Количество()>0,
	"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СервисныеКампании.СервиснаяКампания,
	|	СервисныеКампании.ДатаНачала,
	|	СервисныеКампании.ДатаОкончания
	|ПОМЕСТИТЬ ВТОтборСервисныеКампании
	|ИЗ
	|	&СервисныеКампании КАК СервисныеКампании
	|   ",
	"")
	+?(ЗначениеЗаполнено(СхемаОбзвона.ПоследнийЗаездОт) или ЗначениеЗаполнено(СхемаОбзвона.ПоследнийЗаездДо), 
	"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
    | ВЫБРАТЬ
	|	ЗаказНаряд.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ЗаказНаряд.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЗаказНаряд.Дата
	|		ИНАЧЕ ЗаказНаряд.ДатаНачала
	|	КОНЕЦ КАК ДатаЗаезда
	|ПОМЕСТИТЬ ПодИтог
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
