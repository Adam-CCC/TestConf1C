Функция ПолучитьСписокКлиентовПроизвольногоЗапроса(СхемаОбзвона) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = СхемаОбзвона.ТекстПроизвольногоЗапроса;
	
	Для Каждого Стр Из СхемаОбзвона.ПараметрыПроизвольногоЗапроса Цикл
		
		Если ЗначениеЗаполнено(Стр.ЗначениеПараметра) Тогда
			Запрос.УстановитьПараметр(Стр.Параметр, Стр.ЗначениеПараметра);
		Иначе
			Запрос.УстановитьПараметр(Стр.Параметр, Стр.Список.Получить());
		КонецЕсли;
		
	КонецЦикла;
		
	Результат = Запрос.Выполнить().Выгрузить();		
		
	Возврат Результат;

КонецФункции

Функция ЕстьОшибкиВПроизвольномЗапросе(ТекстПроизвольногоЗапроса, ПараметрыПроизвольногоЗапроса) Экспорт
	
	Запрос       = Новый Запрос;
	Запрос.Текст = ТекстПроизвольногоЗапроса;
	
	Для Каждого Стр Из ПараметрыПроизвольногоЗапроса Цикл
		
		Если ЗначениеЗаполнено(Стр.Список) Тогда
			Запрос.УстановитьПараметр(Стр.Параметр, Стр.Список.Получить());
		Иначе
			Запрос.УстановитьПараметр(Стр.Параметр, Стр.ЗначениеПараметра);
		КонецЕсли;
		
	КонецЦикла;

	Попытка
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Результат.Колонки.Найти("Клиент") = Неопределено Тогда
			Сообщить("В запросе нет поля результата Клиент");
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Истина;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьСписокКлиентовВыборки(СхемаОбзвона) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДляВыборки(СхемаОбзвона);
	
	Запрос.УстановитьПараметр("СхемаОбзвона", СхемаОбзвона);
	
	ПлановаяДата = СхемаОбзвона.ОкончаниеПериода;
		
	Если НЕ СхемаОбзвона.Одноразовая Тогда
		
		ПлановаяДата = НачалоДня(ТекущаяДата()) + СхемаОбзвона.ДнейНаОбзвон * 86400;
				
	КонецЕсли;

	Если ЗначениеЗаполнено(СхемаОбзвона.ДилерскийЦентр) Тогда
		Запрос.УстановитьПараметр("Организация", СхемаОбзвона.ДилерскийЦентр.Организация);
		Запрос.УстановитьПараметр("ДилерскийЦентр", СхемаОбзвона.ДилерскийЦентр);
	КонецЕсли;

    Запрос.УстановитьПараметр("ПлановаяДата", ПлановаяДата);	
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
    Запрос.УстановитьПараметр("Телефон", Перечисления.ТипыКонтактнойИнформации.Телефон);	
    Запрос.УстановитьПараметр("Емаил", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);	
	
	Если ЗначениеЗаполнено(СхемаОбзвона.Событие) Тогда
		Запрос.УстановитьПараметр("Событие", СхемаОбзвона.Событие);
		Запрос.УстановитьПараметр("ДнейДо", СхемаОбзвона.ДнейДоСобытия);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ВидКонтрагента) Тогда
		Запрос.УстановитьПараметр("ФормаСобственности",СхемаОбзвона.ВидКонтрагента);
	КонецЕсли;
			
	Пол = Новый СписокЗначений;
	
	Если СхемаОбзвона.ПолМужской Тогда
		Пол.Добавить(Перечисления.ПолФизическихЛиц.Мужской);
	КонецЕсли;
	
	Если СхемаОбзвона.ПолЖенский Тогда
		Пол.Добавить(Перечисления.ПолФизическихЛиц.Женский);
	КонецЕсли;
	
	Если Пол.Количество()=1 Тогда 
		Запрос.УстановитьПараметр("Пол",Пол);
	КонецЕсли;
	
	Если СхемаОбзвона.ВидКонтрагента = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		Запрос.УстановитьПараметр("СогласиеНаОбработкуПерсональныхДанных", Перечисления.ВариантыОтветов.Да);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ПоследнийТО) Тогда 
		Запрос.УстановитьПараметр("ПоследнийВидТО",СхемаОбзвона.ПоследнийТО);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ПоследнийЗаездОт) Тогда 
		Запрос.УстановитьПараметр("ПоследнийЗаездОт",СхемаОбзвона.ПоследнийЗаездОт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ПоследнийЗаездДо) Тогда 
		Запрос.УстановитьПараметр("ПоследнийЗаездДо",СхемаОбзвона.ПоследнийЗаездДо);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ВозрастОт) Тогда 
		Запрос.УстановитьПараметр("ВозрастОт",СхемаОбзвона.ВозрастОт);
		Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ВозрастДо) И СхемаОбзвона.ВозрастДо<>80 Тогда
		Запрос.УстановитьПараметр("ВозрастДо",СхемаОбзвона.ВозрастДо);
		Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ПробегОт) Тогда 
		Запрос.УстановитьПараметр("ПробегОт",СхемаОбзвона.ПробегОт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ПробегДо) Тогда
		Запрос.УстановитьПараметр("ПробегДо",СхемаОбзвона.ПробегДо);
	КонецЕсли;

	
	Если ЗначениеЗаполнено(СхемаОбзвона.ГодВыпускаОт) Тогда 
		Запрос.УстановитьПараметр("ГодВыпускаОт",СхемаОбзвона.ГодВыпускаОт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ГодВыпускаДо) Тогда 
		Запрос.УстановитьПараметр("ГодВыпускаДо",СхемаОбзвона.ГодВыпускаДо);
	КонецЕсли;
	
	Если СхемаОбзвона.Модели.Количество()>0 Тогда
		Запрос.УстановитьПараметр("Модель",СхемаОбзвона.Модели.ВыгрузитьКолонку("Модель"));
	КонецЕсли;
	
	Если СхемаОбзвона.Версии.Количество()>0 Тогда
		Запрос.УстановитьПараметр("Версия",СхемаОбзвона.Версии.ВыгрузитьКолонку("Версия"));
	КонецЕсли;
		
	Если СхемаОбзвона.ТипыКПП.Количество()>0 Тогда 
		Запрос.УстановитьПараметр("ТипКПП",СхемаОбзвона.ТипыКПП.ВыгрузитьКолонку("ТипКПП"));
	КонецЕсли;
	
	Если СхемаОбзвона.ТипыКузова.Количество()>0 Тогда 
		Запрос.УстановитьПараметр("ТипКузова",СхемаОбзвона.ТипыКузова.ВыгрузитьКолонку("ТипКузова"));
	КонецЕсли;
	
	Если СхемаОбзвона.ТипыДвигателей.Количество()>0 Тогда 
		Запрос.УстановитьПараметр("ТипДвигателя",СхемаОбзвона.ТипыДвигателей.ВыгрузитьКолонку("ТипДвигателя"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ДатаНачалаГарантии) Тогда 
		Запрос.УстановитьПараметр("ДатаНачалаГарантии",СхемаОбзвона.ДатаНачалаГарантии);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ДатаОкончанияГарантии) Тогда 
		Запрос.УстановитьПараметр("ДатаОкончанияГарантии",СхемаОбзвона.ДатаОкончанияГарантии);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ДатаРегистрацииОт) Тогда
		Запрос.УстановитьПараметр("ДатаРегистрацииОт",СхемаОбзвона.ДатаРегистрацииОт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ДатаРегистрацииДо) Тогда 
		Запрос.УстановитьПараметр("ДатаРегистрацииДо",СхемаОбзвона.ДатаРегистрацииДо);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ПробегОт) Тогда 
		Запрос.УстановитьПараметр("ПробегОт",СхемаОбзвона.ПробегОт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ПробегДо) Тогда 
		Запрос.УстановитьПараметр("ПробегДо",СхемаОбзвона.ПробегДо);
	КонецЕсли;
	
    Если СхемаОбзвона.СервисныеКампании.Количество()>0 Тогда
		Запрос.УстановитьПараметр("СервисныеКампании",СхемаОбзвона.СервисныеКампании.Выгрузить());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.Опции) Тогда
		Запрос.УстановитьПараметр("Опции",СхемаОбзвона.Опции.ВыгрузитьКолонку("Опция"));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.Оборудование) Тогда
		Запрос.УстановитьПараметр("Оборудование",СхемаОбзвона.Оборудование.ВыгрузитьКолонку("Оборудование"));
	КонецЕсли;
	
	ТабДопСегментацияПоКлиенту = Новый ТаблицаЗначений;
	ТабДопСегментацияПоКлиенту.Колонки.Добавить("Реквизит",);
	ТабДопСегментацияПоКлиенту.Колонки.Добавить("Значение",);
	
	Для Каждого Стр Из СхемаОбзвона.ДопСегментацияПоКлиенту Цикл
		
		Поиск = Новый Структура("Значение",  Стр.Реквизит);
		СущСтроки = ТабДопСегментацияПоКлиенту.НайтиСтроки(Поиск);
		
		Если СущСтроки.Количество()=0 Тогда
		
			НовСтрока = ТабДопСегментацияПоКлиенту.Добавить();
			
			НовСтрока.Реквизит = Стр.Реквизит;
			НовСтрока.Значение = Стр.Значение;
		
		Иначе
			
			НовСтрока = СущСтроки[0];
			СущЗначение = НовСтрока.Значение;
			
			Если Типзнч(СущЗначение) <> Тип("СписокЗначений") Тогда
								
				СущЗначение = Новый СписокЗначений;
				СущЗначение.Добавить(НовСтрока.Значение);
				
			КонецЕсли;
			
			СущЗначение.Добавить(Стр.Значение);
				
			НовСтрока.Значение = СущЗначение;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Стр Из СхемаОбзвона.ДопСегментацияПоАвтомобилю Цикл
					
		Поиск = Новый Структура("Реквизит",  Стр.Реквизит);
		СущСтроки = ТабДопСегментацияПоКлиенту.НайтиСтроки(Поиск);
		
		Если СущСтроки.Количество()=0 Тогда
		
			НовСтрока = ТабДопСегментацияПоКлиенту.Добавить();
			
			НовСтрока.Реквизит = Стр.Реквизит;
			НовСтрока.Значение = Стр.Значение;
		
		Иначе
			
			НовСтрока = СущСтроки[0];
			СущЗначение = НовСтрока.Значение;
			
			Если Типзнч(СущЗначение) <> Тип("СписокЗначений") Тогда
								
				СущЗначение = Новый СписокЗначений;
				СущЗначение.Добавить(НовСтрока.Значение);
				
			КонецЕсли;
			
			СущЗначение.Добавить(Стр.Значение);
				
			НовСтрока.Значение = СущЗначение;
		
		КонецЕсли;
					
	КонецЦикла;
	
	Для Каждого Стр Из СхемаОбзвона.ДопСегментацияПоПолису Цикл
					
		Поиск = Новый Структура("Реквизит",  Стр.Реквизит);
		СущСтроки = ТабДопСегментацияПоКлиенту.НайтиСтроки(Поиск);
		
		Если СущСтроки.Количество()=0 Тогда
		
			НовСтрока = ТабДопСегментацияПоКлиенту.Добавить();
			
			НовСтрока.Реквизит = Стр.Реквизит;
			НовСтрока.Значение = Стр.Значение;
		
		Иначе
			
			НовСтрока = СущСтроки[0];
			СущЗначение = НовСтрока.Значение;
			
			Если Типзнч(СущЗначение) <> Тип("СписокЗначений") Тогда
								
				СущЗначение = Новый СписокЗначений;
				СущЗначение.Добавить(НовСтрока.Значение);
				
			КонецЕсли;
			
			СущЗначение.Добавить(Стр.Значение);
				
			НовСтрока.Значение = СущЗначение;
		
		КонецЕсли;
					
	КонецЦикла;
	
	Для Каждого Стр Из ТабДопСегментацияПоКлиенту Цикл 
		Запрос.УстановитьПараметр(Стр.Реквизит, Стр.Значение);	
	КонецЦикла;
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

Функция ПолучитьСписокКлиентоПоЗадачам(СхемаОбзвона) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Renault_События.Контрагент КАК Клиент
	               |ИЗ
	               |	Задача.Renault_События КАК Renault_События
	               |ГДЕ
	               |	Renault_События.Объект = &СхемаОбзвона
	               |	И НЕ Renault_События.ПометкаУдаления
	               |	И НЕ Renault_События.Контрагент В (&Контрагент)";
	
	Запрос.УстановитьПараметр("СхемаОбзвона", СхемаОбзвона);
	
	КонтрагентСписок = Новый СписокЗначений;
	КонтрагентСписок.Добавить(Справочники.CRM_ПотенциальныеКонтрагенты.ПустаяСсылка());
	КонтрагентСписок.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	КонтрагентСписок.Добавить(Неопределено);
	КонтрагентСписок.Добавить(Null);
	
	Запрос.УстановитьПараметр("Контрагент", КонтрагентСписок);
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

Функция ПолучитьТекстЗапросаДляВыборки(СхемаОбзвона) 
		
	ЕстьОтборПоПолису = Ложь;
	
	Если СхемаОбзвона.ДопСегментацияПоПолису.Количество()>0 ИЛИ СхемаОбзвона.Событие = "Дней до окончания полиса" 
		                                                    ИЛИ СхемаОбзвона.Событие = "Дней до очередного взноса по полису" 
			                                                ИЛИ СхемаОбзвона.Событие = "Дней с момента окончания последнего полиса"  
															ИЛИ СхемаОбзвона.НетПолисов Тогда
		ЕстьОтборПоПолису = Истина;
	КонецЕсли;
    
	ТекстЗапросаДляВыборки = "";
	
	Если ЕстьОтборПоПолису Тогда  //отбор по страховому полису
		
		ТекстЗапросаДляВыборки = ДополнитьТекстОтборомПоПолису(СхемаОбзвона);
				
	Иначе //отбор по контрагенту
		
		Если ЗначениеЗаполнено(СхемаОбзвона.ДилерскийЦентр) Тогда
			ТекстЗапросаДляВыборки = ТекстЗапросаДляВыборки+
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	 		|	Контрагенты.Ссылка
	 		|ПОМЕСТИТЬ ВТКлиенты
	 		|ИЗ
	 		|	Справочник.Контрагенты КАК Контрагенты
	 		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	 		|		ПО Контрагенты.ОсновнойДоговорВзаиморасчетов = ДоговорыВзаиморасчетов.Ссылка
	 		|			И (НЕ ДоговорыВзаиморасчетов.ПометкаУдаления)
	 		|			И (ДоговорыВзаиморасчетов.Организация = &Организация)
	 		|ГДЕ
	 		|	НЕ Контрагенты.ПометкаУдаления";
		Иначе
			ТекстЗапросаДляВыборки = ТекстЗапросаДляВыборки+
	 		" ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 		|	Контрагенты.Ссылка
	 		|ПОМЕСТИТЬ ВТКлиенты
	 		|ИЗ
	 		|	Справочник.Контрагенты КАК Контрагенты
	 		|ГДЕ
	 		|	НЕ Контрагенты.ПометкаУдаления ";
		КонецЕсли;
		
	КонецЕсли;
	
	//отбор по контрагенту
	
    ТекстЗапросаДляВыборки = ТекстЗапросаДляВыборки + ДополнитьТекстОтборомПоКонтрагенту(СхемаОбзвона);
	
	//отбор по автомобилю
	
    ТекстЗапросаДляВыборки = ТекстЗапросаДляВыборки + ДополнитьТекстОтборомПоАвтомобилю(СхемаОбзвона);	
	
	//отбор по сервисным кампаниям и по событиям
	
	ТекстЗапросаДляВыборки = ТекстЗапросаДляВыборки + ДополнитьТекстОтборомПоСобытиям(СхемаОбзвона);
	
	ТекстЗапросаДляВыборки = ТекстЗапросаДляВыборки	+
	"
	|ИНДЕКСИРОВАТЬ ПО
	|	Клиент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ Различные
	|	ВТКлиентыИтог.Клиент КАК Клиент,
	|   isnull(КонтактнаяИнформация.Представление,"""") КАК Телефон,
	|   isnull(КонтактнаяИнформацияЕмаил.Представление,"""") КАК ЕмаилКлиента
	|ИЗ
	|	ВТКлиентыИтог КАК ВТКлиентыИтог
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|	ПО ВТКлиентыИтог.Клиент = КонтактнаяИнформация.Объект
	|		И (КонтактнаяИнформация.Тип = &Телефон)
	|		И (КонтактнаяИнформация.ЗначениеПоУмолчанию) 
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияЕмаил
	|	ПО ВТКлиентыИтог.Клиент = КонтактнаяИнформацияЕмаил.Объект
	|		И (КонтактнаяИнформацияЕмаил.Тип = &Емаил)
	|		И (КонтактнаяИнформацияЕмаил.ЗначениеПоУмолчанию) ";
	
	Возврат ТекстЗапросаДляВыборки;
	
КонецФункции

Функция ДополнитьТекстОтборомПоПолису(СхемаОбзвона)
	
	Если СхемаОбзвона.НетПолисов Тогда
		
		ТекстДополнения = 
		"
		|ВЫБРАТЬ РАЗЛИЧНЫЕ                                                                                              
	 	|	СтраховойПолис.Контрагент КАК Ссылка
	 	|ПОМЕСТИТЬ ВТСтраховыеПолисы
	 	|ИЗ
	 	|	Документ.Renault_СтраховойПолис КАК СтраховойПолис
	 	|ГДЕ
	 	|	СтраховойПолис.Проведен "
		+?(ЗначениеЗаполнено(СхемаОбзвона.ДилерскийЦентр), " И СтраховойПолис.Организация = &Организация ", "")
		+
		"
		|;
	    |
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
 		|	Контрагенты.Ссылка
 		|ПОМЕСТИТЬ ВТКлиенты
 		|ИЗ
 		|	Справочник.Контрагенты КАК Контрагенты
		| ЛЕВОЕ СОЕДИНЕНИЕ ВТСтраховыеПолисы КАК ВТСтраховыеПолисы
		| ПО ВТСтраховыеПолисы.Ссылка = Контрагенты.Ссылка
		| ГДЕ
	    |	НЕ Контрагенты.ПометкаУдаления 
		|   И isnull(ВТСтраховыеПолисы.Ссылка, Значение(Справочник.Контрагенты.ПустаяСсылка)) = Значение(Справочник.Контрагенты.ПустаяСсылка) ";

		Возврат ТекстДополнения;
		
	КонецЕсли;
	
	Если СхемаОбзвона.Событие = "Дней до очередного взноса по полису" Тогда
		
		ТекстДополнения = 

		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Renault_СтраховойПолисГрафикОплаты.Ссылка.Контрагент КАК Ссылка
		|ПОМЕСТИТЬ ВТСтраховыеПолисы
		|ИЗ
		|	Документ.Renault_СтраховойПолис.ГрафикОплаты КАК Renault_СтраховойПолисГрафикОплаты
		|ГДЕ
		|	Renault_СтраховойПолисГрафикОплаты.Ссылка.Проведен "
		+?(ЗначениеЗаполнено(СхемаОбзвона.ДилерскийЦентр), " И Renault_СтраховойПолисГрафикОплаты.Ссылка.Организация = &Организация ", "")
		+
		"
		|	И ВЫБОР
		|			КОГДА Renault_СтраховойПолисГрафикОплаты.Ссылка.ДатаОкончанияСтрахования <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|					И Renault_СтраховойПолисГрафикОплаты.Ссылка.ДатаОкончанияСтрахования <= &ТекущаяДата
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И Renault_СтраховойПолисГрафикОплаты.ДатаОплаты >= &ТекущаяДата
		|	И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), НАЧАЛОПЕРИОДА(Renault_СтраховойПолисГрафикОплаты.ДатаОплаты, ДЕНЬ), ДЕНЬ) "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДо "
	
	ИначеЕсли СхемаОбзвона.Событие = "Дней с момента окончания последнего полиса" Тогда
		
		ТекстДополнения = 
			
	 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	СтраховойПолис.Контрагент КАК Ссылка,
	 	|	МАКСИМУМ(СтраховойПолис.ДатаОкончанияСтрахования) КАК ДатаОкончанияСтрахования
	 	|ПОМЕСТИТЬ ВТПоследниеСтраховыеПолисы
	 	|ИЗ
	 	|	Документ.Renault_СтраховойПолис КАК СтраховойПолис
	 	|ГДЕ
	 	|	СтраховойПолис.Проведен "
		+?(ЗначениеЗаполнено(СхемаОбзвона.ДилерскийЦентр), " И СтраховойПолис.Организация = &Организация ", "")
		+
		"
	 	|
	 	|СГРУППИРОВАТЬ ПО
	 	|	СтраховойПолис.Контрагент
	 	|;
	 	|
	 	|////////////////////////////////////////////////////////////////////////////////
	 	|ВЫБРАТЬ
	 	|	ВТПоследниеСтраховыеПолисы.Ссылка
	 	|ПОМЕСТИТЬ ВТСтраховыеПолисы
	 	|ИЗ
	 	|	ВТПоследниеСтраховыеПолисы КАК ВТПоследниеСтраховыеПолисы
	 	|ГДЕ
	 	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВТПоследниеСтраховыеПолисы.ДатаОкончанияСтрахования, ДЕНЬ), НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), ДЕНЬ) "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДо " ;
		
	Иначе

		ТекстДополнения = 
			
	 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ                                                                                              
	 	|	СтраховойПолис.Контрагент КАК Ссылка
	 	|ПОМЕСТИТЬ ВТСтраховыеПолисы
	 	|ИЗ
	 	|	Документ.Renault_СтраховойПолис КАК СтраховойПолис
	 	|ГДЕ
	 	|	 "//СтраховойПолис.Проведен
		+?(ЗначениеЗаполнено(СхемаОбзвона.ДилерскийЦентр), "  СтраховойПолис.Организация = &Организация ", "");
	
	КонецЕсли;

	Если СхемаОбзвона.Событие = "Дней до окончания полиса" Тогда
		
		ТекстДополнения = ТекстДополнения+
		"	
		|   И СтраховойПолис.ДатаОкончанияСтрахования > &ТекущаяДата
		|   И РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ), НАЧАЛОПЕРИОДА(СтраховойПолис.ДатаОкончанияСтрахования, ДЕНЬ), ДЕНЬ) "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДо "
			
	КонецЕсли;
			
	Если СхемаОбзвона.ДопСегментацияПоПолису.Количество()>0 Тогда
	
		ОбработанныйПараметр = Новый СписокЗначений;
					
		Для Каждого Стр Из СхемаОбзвона.ДопСегментацияПоПолису Цикл 
			
			Если ОбработанныйПараметр.НайтиПоЗначению(Стр.Реквизит) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
				
			ЕстьКовычка = Ложь;
			
			ВидСравненияПоля = ОпределитьВидСравнения(Стр.ВидСравнения);
			
			Если ВидСравненияПоля = Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если Найти(ВидСравненияПоля,"(")>0 Тогда
				
				ЕстьКовычка = Истина;
								
			КонецЕсли;
							
			ТекстДополнения = ТекстДополнения+
			"	
			|   И СтраховойПолис."+Стр.Реквизит+" "+ВидСравненияПоля+" &"+Стр.Реквизит+?(ЕстьКовычка, ") "," "); 
			
			ОбработанныйПараметр.Добавить(Стр.Реквизит);
			
		КонецЦикла;
		
	КонецЕсли;	
	
	ТекстДополнения = ТекстДополнения+

	"
	|;
    |
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ 
	|	ВТСтраховыеПолисы.Ссылка
	|ПОМЕСТИТЬ ВТКлиенты
	|ИЗ
	|	ВТСтраховыеПолисы КАК ВТСтраховыеПолисы
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	| ПО ВТСтраховыеПолисы.Ссылка = Контрагенты.Ссылка
	| ГДЕ
    |	НЕ Контрагенты.ПометкаУдаления ";
			
	Возврат ТекстДополнения;

КонецФункции

Функция ДополнитьТекстОтборомПоКонтрагенту(СхемаОбзвона)
	
	Пол = Новый СписокЗначений;
	
	Если СхемаОбзвона.ПолМужской Тогда	
		Пол.Добавить(Перечисления.ПолФизическихЛиц.Мужской);
	КонецЕсли;
	
	Если СхемаОбзвона.ПолЖенский Тогда	
		Пол.Добавить(Перечисления.ПолФизическихЛиц.Женский);
	КонецЕсли;
	
	ЕстьОтборПоПолу = ?(Пол.Количество()=1, Истина, Ложь);

	ТекстДополнения = ""
	
	+?(СхемаОбзвона.ВидКонтрагента = Перечисления.ФормыСобственности.ЧастноеЛицо, 
	"	
	|   И Контрагенты.СогласиеНаОбработкуПерсональныхДанных = &СогласиеНаОбработкуПерсональныхДанных ",
	"")
	+?(СхемаОбзвона.Событие = "Дней до дня рождения", 
	"	
	|   И 	РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(Контрагенты.ДатаРождения, ГОД, ГОД(НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ)) - ГОД(Контрагенты.ДатаРождения)), НАЧАЛОПЕРИОДА(&ТекущаяДата,ДЕНЬ), ДЕНЬ)  "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДО ",  
	"")
	+?(ЗначениеЗаполнено(СхемаОбзвона.ВидКонтрагента), 
	"	
	|   И Контрагенты.ФормаСобственности = &ФормаСобственности ",  
	"")
	+?(ЕстьОтборПоПолу, 
	"	
	|   И Контрагенты.Пол В (&Пол) ", 
	"")
	+?(ЗначениеЗаполнено(СхемаОбзвона.ВозрастОт), 
	"	
	|   И РАЗНОСТЬДАТ(Контрагенты.ДатаРождения, &ТекущаяДата, ГОД) >= &ВозрастОт ", 
	"")
    +?(ЗначениеЗаполнено(СхемаОбзвона.ВозрастДо) И СхемаОбзвона.ВозрастДо<>80, 
	"	
	|   И РАЗНОСТЬДАТ(Контрагенты.ДатаРождения, &ТекущаяДата, ГОД) <= &ВозрастДо ", 
	"");
	
	ОбработанныйПараметр = Новый СписокЗначений;
	
	Для Каждого Стр Из СхемаОбзвона.ДопСегментацияПоКлиенту Цикл 
		
		Если ОбработанныйПараметр.НайтиПоЗначению(Стр.Реквизит) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
			
		ЕстьКовычка = Ложь;
		
		ВидСравненияПоля = ОпределитьВидСравнения(Стр.ВидСравнения);
		
		Если ВидСравненияПоля = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если Найти(ВидСравненияПоля,"(")>0 Тогда
			
			ЕстьКовычка = Истина;
							
		КонецЕсли;
						
		ТекстДополнения = ТекстДополнения+
		"	  
		|   И Контрагенты."+Стр.Реквизит+" "+ВидСравненияПоля+" &"+Стр.Реквизит+?(ЕстьКовычка, ") "," "); 
		
		ОбработанныйПараметр.Добавить(Стр.Реквизит);
		
	КонецЦикла;

	Возврат ТекстДополнения;
	
КонецФункции

Функция ДополнитьТекстОтборомПоАвтомобилю(СхемаОбзвона)
		
	ТекстДополнения =
	
	"
	|;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
    |	ВТКлиенты.Ссылка,
    |	isnull(АвтомобилиСрезПоследних.Автомобиль, Значение(Справочник.Автомобили.ПустаяСсылка)) КАК Автомобиль
    |ПОМЕСТИТЬ ВТКлиентыИАвтомобили
    |ИЗ
    |	ВТКлиенты КАК ВТКлиенты
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(	,
