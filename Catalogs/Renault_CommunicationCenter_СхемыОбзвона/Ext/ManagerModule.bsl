    +?(СхемаОбзвона.Версии.Количество()>0, 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ВариантКомплектации В (&Версия) ", 
	"")
	+?(СхемаОбзвона.ТипыКПП.Количество()>0, 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ТипКПП В (&ТипКПП) ", 
	"")
    +?(СхемаОбзвона.ТипыКузова.Количество()>0, 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ТипКузова В (&ТипКузова) ", 
	"")
    +?(СхемаОбзвона.ТипыДвигателей.Количество()>0, 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ТипДвигателя В (&ТипДвигателя) ", 
	"")
    +?(ЗначениеЗаполнено(СхемаОбзвона.ДатаНачалаГарантии), 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ДатаНачалаГарантии >= НАЧАЛОПЕРИОДА(&ДатаНачалаГарантии, ДЕНЬ) ", 
	"")
    +?(ЗначениеЗаполнено(СхемаОбзвона.ДатаОкончанияГарантии), 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ДатаОкончанияГарантии <= КонецПериода(&ДатаОкончанияГарантии, ДЕНЬ) ", 
	"")
    +?(ЗначениеЗаполнено(СхемаОбзвона.ДатаРегистрацииОт), 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ДатаРегистрации >= НАЧАЛОПЕРИОДА(&ДатаРегистрацииОт, ДЕНЬ) ", 
	"")
    +?(ЗначениеЗаполнено(СхемаОбзвона.ДатаРегистрацииДо), 
	"	
	|   И АвтомобилиСрезПоследних.Автомобиль.ДатаРегистрации <= КонецПериода(&ДатаРегистрацииДо, ДЕНЬ) ", 
	"");
	
	ОбработанныйПараметр = Новый СписокЗначений;

	Для Каждого Стр Из СхемаОбзвона.ДопСегментацияПоАвтомобилю Цикл 
						
		Если ОбработанныйПараметр.НайтиПоЗначению(Стр.Реквизит) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЕстьКовычка = Ложь;
		
		ВидСравненияПоле = ОпределитьВидСравнения(Стр.ВидСравнения);
		
