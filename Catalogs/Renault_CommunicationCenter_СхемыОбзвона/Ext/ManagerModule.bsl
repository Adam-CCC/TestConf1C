	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОбращения КАК ВТОбращения
	|       ПО ВТКлиентыИАвтомобили.Ссылка = ВТОбращения.Ссылка
	|	    И (ВТОбращения.ДнейСМоментаВизита "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДО) ",
	"")
    +?(СхемаОбзвона.Событие = "Дней с момента обращения",
	"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОбращения КАК ВТОбращения
	|       ПО ВТКлиентыИАвтомобили.Ссылка = ВТОбращения.Ссылка
	|       И (ВТОбращения.ДнейСМоментаОбращенияВАвтосервис "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДО) ",
	"")
    +?(СхемаОбзвона.Событие = "Дней с даты продажи",
	"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПродажаАвто КАК ВТПродажаАвто
	|       ПО ВТКлиентыИАвтомобили.Ссылка = ВТПродажаАвто.Ссылка
	|	    И (ВТПродажаАвто.ДнейСПродажи "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДО) ",
	"")
	 +?(СхемаОбзвона.Событие = "Дней с момента закрытия заказ-наряда",
	"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗакрытиеЗН КАК ВТЗакрытиеЗН
	|       ПО ВТКлиентыИАвтомобили.Ссылка = ВТЗакрытиеЗН.Ссылка
	|	    И (ВТЗакрытиеЗН.ДнейСМоментаЗакрытияЗаказНаряда "+СхемаОбзвона.ВидСравненияПоСобытию+" &ДнейДО) ",
	"")
	+?(ЗначениеЗаполнено(СхемаОбзвона.ПоследнийТО),
	"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследниеТО КАК ВТПоследниеТО
	|       ПО ВТКлиентыИАвтомобили.Ссылка = ВТПоследниеТО.Покупатель 
	|       И  ВТПоследниеТО.ВидТО = &ПоследнийВидТО ",				
	"")
	+ ?(СхемаОбзвона.СервисныеКампании.Количество()>0,
	"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеСервисныхКампаний КАК ВыполнениеСервисныхКампаний
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОтборСервисныеКампании КАК ВТОтборСервисныеКампании
	|			ПО ВТОтборСервисныеКампании.СервиснаяКампания = ВыполнениеСервисныхКампаний.СервиснаяКампания
	|				И (ВЫБОР КОГДА ВТОтборСервисныеКампании.ДатаНачала<>ДатаВремя(1,1,1,0,0,0) Тогда
	|                  ВыполнениеСервисныхКампаний.ДатаВыполнения >= ВТОтборСервисныеКампании.ДатаНачала иначе истина конец)
	|               И (ВЫБОР КОГДА ВТОтборСервисныеКампании.ДатаОкончания<>ДатаВремя(1,1,1,0,0,0) Тогда
	|                   ВыполнениеСервисныхКампаний.ДатаВыполнения  <= ВТОтборСервисныеКампании.ДатаОкончания иначе истина конец)
	|		ПО ВТКлиентыИАвтомобили.Автомобиль.VIN = ВыполнениеСервисныхКампаний.VIN ",
	"")
	+ ?(СхемаОбзвона.Опции.Количество()>0,
	"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОпцииВариантовКомплектации КАК ОпцииВариантовКомплектации
	|		ПО (ВТКлиентыИАвтомобили.Автомобиль.ВариантКомплектации = ОпцииВариантовКомплектации.ВариантКомплектации)
	|			И (ОпцииВариантовКомплектации.Опция В (&Опции))
	|			И (ОпцииВариантовКомплектации.ВидВключения = 2) ",
	"")
	+ ?(СхемаОбзвона.Оборудование.Количество()>0,
	"
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.КомплектацияАвтомобилей КАК КомплектацияАвтомобилей
	|		ПО (ВТКлиентыИАвтомобили.Автомобиль = КомплектацияАвтомобилей.Автомобиль)
	|			И (КомплектацияАвтомобилей.Номенклатура В (&Оборудование))
	|			И (КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ВводОстатковАвтомобилей
	|				ИЛИ КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ЗаказНаряд
	|				ИЛИ КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ИнвентаризацияАвтомобилей
	|				ИЛИ КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ПоступлениеАвтомобилей)
	|			И (КомплектацияАвтомобилей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
	|			И (КомплектацияАвтомобилей.Количество <> 0)" , 
	"");
	
	Возврат ТекстДополнения;

КонецФункции

Функция АктуализироватьРаботуПоСхеме(СхемаОбзвона) Экспорт
	
	//если последний день работы схемы то актуализируем список необработанных 
	//если период закончился тогда схему завершаем
	Если СхемаОбзвона.Завершена или СхемаОбзвона.ПометкаУдаления Тогда
		
		ЗавершитьРаботуПоСхеме(СхемаОбзвона);
		
	ИначеЕсли ЗначениеЗаполнено(СхемаОбзвона.ОкончаниеПериода) Тогда
		
		Если НачалоДня(СхемаОбзвона.ОкончаниеПериода) <= НачалоДня(ТекущаяДата()) Тогда
					
			ЗавершитьРаботуПоСхеме(СхемаОбзвона);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НЕ СхемаОбзвона.Завершена;
		
КонецФункции

Процедура ЗавершитьРаботуПоСхеме(СхемаОбзвона)
	
	Если Не СхемаОбзвона.Завершена Тогда
		СхемаОбзвонаОбъект = СхемаОбзвона.ПолучитьОбъект();
		СхемаОбзвонаОбъект.Завершена = Истина;
		Попытка
			СхемаОбзвонаОбъект.Записать();
		Исключение
			ТекстСообщения = "Ошибка при завершении схемы обзвона " + СхемаОбзвонаОбъект.Наименование;
			ЗаписьЖурналаРегистрации("Завершение схемы обзвона", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	//завершаем напоминания
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_СообщенияПользователю.Ссылка
	               |ИЗ
	               |	Справочник.Renault_СообщенияПользователю КАК Renault_СообщенияПользователю
	               |ГДЕ
	               |	Renault_СообщенияПользователю.СхемаОбзвона = &СхемаОбзвона
	               |	И НЕ Renault_СообщенияПользователю.Обработано
	               |	И Renault_СообщенияПользователю.ВидСообщения = ЗНАЧЕНИЕ(Справочник.Renault_ВидСообщения.CommunicationCenter_Обзвон)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_События.Ссылка
	               |ИЗ
	               |	Задача.Renault_События КАК Renault_События
	               |ГДЕ
	               |	Renault_События.Объект = &СхемаОбзвона
	               |	И Renault_События.ВидСобытия В (&ВидыСобытий)
	               |	И НЕ Renault_События.Выполнена";
	
	Запрос.УстановитьПараметр("СхемаОбзвона", СхемаОбзвона);
	
	ВидыСобытий = Новый СписокЗначений;
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.ПлановаяПролонгация);
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.КлиентыСервиса);
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.УтеряннаяБаза);
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.НапоминаниеОВзносе);
	
	Запрос.УстановитьПараметр("ВидыСобытий", ВидыСобытий);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Напоминание = Выборка.Ссылка.ПолучитьОбъект();
		
		Если ТипЗнч(Выборка.Ссылка) = Тип("ЗадачаСсылка.Renault_События") Тогда
			Напоминание.Выполнена    = Истина;
			Напоминание.Состояние    = Справочники.Renault_Состояния.ЗавершеноУспешно;
			Напоминание.ДатаЗакрытия = ТекущаяДата();
		Иначе 
			Напоминание.Обработано = Истина;
		КонецЕсли;
		
		Попытка
			Напоминание.Записать();
	    Исключение
			ТекстСообщения = "Не удалось установить признак выполнения у напоминания/задачи " + Напоминание.Код;
			ЗаписьЖурналаРегистрации("Завершение схемы обзвона", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ОпределитьВидСравнения(ВидСравнения)
	
	Если ВидСравнения = "Больше" Тогда
		СтрокаСравнения = ">";
	ИначеЕсли ВидСравнения = "Больше или равно" Тогда
		СтрокаСравнения = ">=";
    ИначеЕсли ВидСравнения = "Меньше" Тогда
		СтрокаСравнения = "<";
    ИначеЕсли ВидСравнения = "Меньше или равно" Тогда
		СтрокаСравнения = "<=";
    ИначеЕсли ВидСравнения = "Не равно" Тогда
		СтрокаСравнения = "<>";
    ИначеЕсли ВидСравнения = "Равно" Тогда
		СтрокаСравнения = "=";
	ИначеЕсли ВидСравнения = "В списке" Тогда
		СтрокаСравнения = "В (";		
	ИначеЕсли ВидСравнения = "Не в списке" Тогда
		СтрокаСравнения = "НЕ В (";
	ИначеЕсли ВидСравнения = "В группе" Тогда
		СтрокаСравнения = "В Иерархии (";
	ИначеЕсли ВидСравнения = "Не в группе" Тогда
		СтрокаСравнения = "НЕ В Иерархии (";
	ИначеЕсли ВидСравнения = "Содержит" Тогда
		СтрокаСравнения = "ПОДОБНО";
	ИначеЕсли ВидСравнения = "Заполнено" Тогда
		СтрокаСравнения = "<>";
	ИначеЕсли ВидСравнения = "НЕ Заполнено" Тогда
		СтрокаСравнения = "=";
    Иначе
		СтрокаСравнения = Неопределено;
	КонецЕсли;
	
	Возврат СтрокаСравнения;

КонецФункции

Процедура СоздатьНапоминания(СхемаОбзвона) Экспорт
	
	Если СхемаОбзвона.НеНапоминать Тогда
		Возврат;
	КонецЕсли;
	
	Если СхемаОбзвона.НапоминаниеЗадачами Тогда
		
		СоздатьЗадачи(СхемаОбзвона);
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Исполнители.Исполнитель
	               |ПОМЕСТИТЬ ВТИсполнители
	               |ИЗ
	               |	&Исполнители КАК Исполнители
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Сотрудники.Ссылка КАК Пользователь
	               |ПОМЕСТИТЬ ВТИсполнителиПодразделенияОтделы
	               |ИЗ
	               |	ВТИсполнители КАК ВТИсполнители
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CRM_Отделы.Подразделения КАК CRM_ОтделыПодразделения
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	               |			ПО CRM_ОтделыПодразделения.Подразделение = Сотрудники.Подразделение
	               |				И (Сотрудники.ФлагУволен = ЛОЖЬ)
	               |				И (Сотрудники.ПометкаУдаления = ЛОЖЬ)
	               |		ПО ВТИсполнители.Исполнитель = CRM_ОтделыПодразделения.Ссылка
	               |ГДЕ
	               |	ВТИсполнители.Исполнитель ССЫЛКА Справочник.CRM_Отделы
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Пользователи.Сотрудник
	               |ИЗ
	               |	ВТИсполнители КАК ВТИсполнители
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	               |		ПО ВТИсполнители.Исполнитель = Пользователи.Ссылка
	               |ГДЕ
	               |	ВТИсполнители.Исполнитель ССЫЛКА Справочник.Пользователи
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Сотрудники.Ссылка
	               |ИЗ
	               |	ВТИсполнители КАК ВТИсполнители
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	               |		ПО ВТИсполнители.Исполнитель = Сотрудники.Подразделение
	               |			И (Сотрудники.ФлагУволен = ЛОЖЬ)
	               |			И (Сотрудники.ПометкаУдаления = ЛОЖЬ)
	               |ГДЕ
	               |	ВТИсполнители.Исполнитель ССЫЛКА Справочник.ПодразделенияКомпании
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТИсполнителиПодразделенияОтделы.Пользователь,
	               |	ЕСТЬNULL(Renault_СообщенияПользователю.Ссылка, ЗНАЧЕНИЕ(Справочник.Renault_СообщенияПользователю.ПустаяСсылка)) КАК Ссылка
	               |ИЗ
	               |	ВТИсполнителиПодразделенияОтделы КАК ВТИсполнителиПодразделенияОтделы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_СообщенияПользователю КАК Renault_СообщенияПользователю
	               |		ПО ВТИсполнителиПодразделенияОтделы.Пользователь = Renault_СообщенияПользователю.Получатель
	               |			И (Renault_СообщенияПользователю.ВидСообщения = ЗНАЧЕНИЕ(Справочник.Renault_ВидСообщения.CommunicationCenter_Обзвон))
	               |			И (Renault_СообщенияПользователю.СхемаОбзвона = &СхемаОбзвона)";			   
					   				   
	Запрос.УстановитьПараметр("СхемаОбзвона", СхемаОбзвона);
	Запрос.УстановитьПараметр("Исполнители", СхемаОбзвона.Исполнители);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Напоминание = Выборка.Ссылка.ПолучитьОбъект();
		Иначе		
			Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			Напоминание.Отправитель = ПараметрыСеанса.Пользователь;
			Напоминание.Получатель   = Выборка.Пользователь;
			Напоминание.СхемаОбзвона         = СхемаОбзвона;
			НовАдресат = Напоминание.Адресаты.Добавить();
			НовАдресат.Сотрудник   = Выборка.Пользователь;
			Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.CommunicationCenter_Обзвон;
            Напоминание.ИдентификаторОбъекта = Новый УникальныйИдентификатор();
			Напоминание.ДатаОтправки = ТекущаяДата();
		КонецЕсли;	
		
		Напоминание.Обработано   = Ложь;
		Напоминание.Комментарий  = "Коммуникация по схеме "+СхемаОбзвона.Наименование;
		Напоминание.ПоказыватьС  = СхемаОбзвона.НачалоПериода;
		Если ЗначениеЗаполнено(СхемаОбзвона.ОкончаниеПериода) Тогда
			Напоминание.ПоказыватьПо = КонецДня(СхемаОбзвона.ОкончаниеПериода);
		КонецЕсли;	
		Напоминание.Наименование = "Коммуникация по схеме "+СхемаОбзвона.Наименование;
		Напоминание.Сообщение    = "Есть необработанные клиенты по схеме "+СхемаОбзвона.Наименование;
		Напоминание.Записать();
		
		Сообщить("Актуализировано напоминание пользователю " + Выборка.Пользователь.Наименование+ " о коммуникации");
		
	КонецЦикла;

КонецПроцедуры

Процедура СоздатьЗадачи(СхемаОбзвона)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Исполнители.Исполнитель
	               |ПОМЕСТИТЬ ВТИсполнители
	               |ИЗ
	               |	&Исполнители КАК Исполнители
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТИсполнители.Исполнитель КАК Пользователь,
	               |	ЕСТЬNULL(Renault_События.Ссылка, ЗНАЧЕНИЕ(Задача.Renault_События.ПустаяСсылка)) КАК Ссылка
	               |ИЗ
	               |	ВТИсполнители КАК ВТИсполнители
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Задача.Renault_События КАК Renault_События
	               |		ПО (Renault_События.Объект = &СхемаОбзвона)
	               |			И (Renault_События.ВидСобытия В (&ВидыСобытий))
	               |			И (ВЫБОР
	               |				КОГДА ВТИсполнители.Исполнитель ССЫЛКА Справочник.Пользователи
	               |					ТОГДА Renault_События.Сотрудник = ВЫРАЗИТЬ(ВТИсполнители.Исполнитель КАК Справочник.Пользователи).Сотрудник
	               |				КОГДА ВТИсполнители.Исполнитель ССЫЛКА Справочник.ПодразделенияКомпании
	               |					ТОГДА Renault_События.Подразделение = ВТИсполнители.Исполнитель
	               |				ИНАЧЕ Renault_События.Отдел = ВТИсполнители.Исполнитель
	               |			КОНЕЦ)";				   
					   
	Запрос.УстановитьПараметр("СхемаОбзвона", СхемаОбзвона);
	Запрос.УстановитьПараметр("Исполнители", СхемаОбзвона.Исполнители);
	
	ВидыСобытий = Новый СписокЗначений;
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.ПлановаяПролонгация);
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.КлиентыСервиса);
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.УтеряннаяБаза);
	ВидыСобытий.Добавить(Справочники.CRM_ВидыСобытий.НапоминаниеОВзносе);
	
	Запрос.УстановитьПараметр("ВидыСобытий", ВидыСобытий);

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			ЗадачаНаПролонгацию = Выборка.Ссылка.ПолучитьОбъект();
		Иначе		
			ЗадачаНаПролонгацию = Задачи.Renault_События.СоздатьЗадачу();
			ЗадачаНаПролонгацию.Наименование = СхемаОбзвона.Наименование;
			ЗадачаНаПролонгацию.Объект       = СхемаОбзвона;
			ЗадачаНаПролонгацию.ВидСобытия   = СхемаОбзвона.ВидСобытия;
			ЗадачаНаПролонгацию.Дата         = ТекущаяДата();
			ЗадачаНаПролонгацию.Автор        = ПараметрыСеанса.Пользователь;
			ЗадачаНаПролонгацию.Состояние    = Справочники.Renault_Состояния.ПринятКИсполнению;
			
		КонецЕсли;	
		
		ЗадачаНаПролонгацию.ДилерскийЦентр = СхемаОбзвона.ДилерскийЦентр;
			
		Если ТипЗнч(Выборка.Пользователь) = Тип("СправочникСсылка.CRM_Отделы") Тогда
			ЗадачаНаПролонгацию.Отдел     = Выборка.Пользователь;
		ИначеЕсли ТипЗнч(Выборка.Пользователь) = Тип("СправочникСсылка.ПодразделенияКомпании") Тогда
			ЗадачаНаПролонгацию.Подразделение = Выборка.Пользователь;
		Иначе
			ЗадачаНаПролонгацию.Сотрудник = Выборка.Пользователь.Сотрудник;
		КонецЕсли;
			
		ЗадачаНаПролонгацию.Записать();
	
		Сообщить("Актуализирована задача пользователя " + Выборка.Пользователь.Наименование+ " о коммуникации");
		
	КонецЦикла;

КонецПроцедуры

Функция ПерезаполнитьСписокКлиентовВыборки(СхемаОбзвона) Экспорт
	
	Если СхемаОбзвона.ТипКоммуникации = Перечисления.ВидыСобытий.ТелефонныйЗвонок
		И СхемаОбзвона.ШагиСхемы.Количество()=0 Тогда
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбзвона.ТекстПроизвольногоЗапроса) Тогда
		КлиентыДляОбзвона = ПолучитьСписокКлиентовПроизвольногоЗапроса(СхемаОбзвона);
	Иначе
		КлиентыДляОбзвона = ПолучитьСписокКлиентовВыборки(СхемаОбзвона);
	КонецЕсли;
	
	Возврат КлиентыДляОбзвона;
	
КонецФункции	

Функция ПолучитьТекстСМСДляКлиента(ТекстСМС = "", Контрагент, СхемаОбзвона = Неопределено, ВычисляемыеВставкиВТекстШаблона = Неопределено) Экспорт
	
	Если ТекстСМС = "" И СхемаОбзвона = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТекстСМС = "" Тогда
		Если ЗначениеЗаполнено(СхемаОбзвона.ТекстСМС) Тогда
			ТекстСМС = СхемаОбзвона.ТекстСМС;
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	Если Контрагент.ЭтоГруппа Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстСМСВычисляемый = ТекстСМС;
	
	Для Каждого Стр Из ВычисляемыеВставкиВТекстШаблона Цикл
		
		ПараметрДляВычисления = "";
		
		Попытка
			Если Стр.ЭтоФункция Тогда
				Выполнить(СтрЗаменить(Стр.Формула, Символы.ПС,""));
			Иначе
				ПараметрДляВычисления = Вычислить(Стр.Формула);
			КонецЕсли;
		Исключение
			Сообщить("Не удалось вычислить параметр "+Стр.Параметр);
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		ТекстСМСВычисляемый = СтрЗаменить(ТекстСМСВычисляемый, "{"+Стр.Параметр+"}", ПараметрДляВычисления);
				
	КонецЦикла;	
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("МакетСМС");
	
	ОбластьСМС = Макет.ПолучитьОбласть("ОбластьСМС");
	ОбластьСМС.Область("R1C1:R9C6").Текст = ТекстСМСВычисляемый;
	ОбластьСМС.Параметры.Заполнить(Контрагент);
		
	ТабДок.Вывести(ОбластьСМС);
	
	ТекстРезультат = ТабДок.ТекущаяОбласть.Текст;
		
	Возврат ТекстРезультат;
	
КонецФункции

Функция ПолучитьСхемуПоУид(УИД) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_CommunicationCenter_СхемыОбзвона.Ссылка
	|ИЗ
	|	Справочник.Renault_CommunicationCenter_СхемыОбзвона КАК Renault_CommunicationCenter_СхемыОбзвона
	|ГДЕ
	|	Renault_CommunicationCenter_СхемыОбзвона.УИД = &УИД
	|	И НЕ Renault_CommunicationCenter_СхемыОбзвона.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("УИД", УИД);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе	
		Возврат Результат.Выгрузить()[0].Ссылка;
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьШагиПоГрафСхеме(СхемаОбзвона, ГрафическаяСхема, ТаблицаДействий = Неопределено) Экспорт
	
	ПометитьСуществующиеШагиНаУдаление(СхемаОбзвона);
	
	ТаблицаЛиний = ПолучитьПорядокЭлементовСхемы(ГрафическаяСхема.ЭлементыГрафическойСхемы);
	
	Если ТаблицаЛиний = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокСозданныхШагов = Новый ТаблицаЗначений;
	СписокСозданныхШагов.Колонки.Добавить("СозданныйШагСхемы",);
	СписокСозданныхШагов.Колонки.Добавить("Наименование",);
	
	СправочникСхема = СхемаОбзвона.ПолучитьОбъект();
	СправочникСхема.ШагиСхемы.Очистить();
	
	Для Каждого СтрЭлемент Из ТаблицаЛиний Цикл
		
		Если ТипЗнч(СтрЭлемент.ПредыдущийШаг) = Тип("ВариантЭлементаГрафическойСхемыВыборВарианта") Тогда			
			СуществующийШаг = СписокСозданныхШагов.НайтиСтроки(Новый Структура("Наименование", СтрЭлемент.ПредыдущийШаг.Наименование));			
		Иначе			
			СуществующийШаг = СписокСозданныхШагов.НайтиСтроки(Новый Структура("Наименование", СтрЭлемент.ПредыдущийШаг.Имя));
		КонецЕсли;

		Если СуществующийШаг.Количество() = 0 Тогда
			ПредыдущийШаг              = Справочники.Renault_CommunicationCenter_ШагиСхемОбзвона.СоздатьЭлемент(); //предыдущий
			ПредыдущийШаг.Владелец     = СхемаОбзвона;
			ПредыдущийШаг.Наименование = ?(ТипЗнч(СтрЭлемент.ПредыдущийШаг) = Тип("ВариантЭлементаГрафическойСхемыВыборВарианта"),СтрЭлемент.ПредыдущийШаг.Наименование,СтрЭлемент.ПредыдущийШаг.Имя);
			ПредыдущийШаг.Содержание   = СОКРЛП(СтрЭлемент.ПредыдущийШаг.Наименование);
			ПредыдущийШаг.Вид          = Строка(ТипЗнч(СтрЭлемент.ПредыдущийШаг));
			СтрокаБлока = ТаблицаДействий.Найти(ПредыдущийШаг.Наименование, "ЭлементСхемы");
			Если СтрокаБлока<>Неопределено Тогда
				ПредыдущийШаг.Действие              = СтрокаБлока.Действие;
				ПредыдущийШаг.НазначениеОпросов     = СтрокаБлока.НазначениеОпросов;
				ПредыдущийШаг.СхемаОбзвонаВторичная = СтрокаБлока.СхемаОбзвонаВторичная;
			КонецЕсли;			
			ПредыдущийШаг.Записать();
			НовШаг                   = СписокСозданныхШагов.Добавить();
			НовШаг.СозданныйШагСхемы = ПредыдущийШаг.Ссылка;
			НовШаг.Наименование      = ПредыдущийШаг.Наименование;
		Иначе
			ПредыдущийШаг = СуществующийШаг[0].СозданныйШагСхемы;
		КонецЕсли;
				
		Если ТипЗнч(СтрЭлемент.Шаг) = Тип("ВариантЭлементаГрафическойСхемыВыборВарианта") Тогда			
			СуществующийШаг = СписокСозданныхШагов.НайтиСтроки(Новый Структура("Наименование", СтрЭлемент.Шаг.Наименование));			
		Иначе			
			СуществующийШаг = СписокСозданныхШагов.НайтиСтроки(Новый Структура("Наименование", СтрЭлемент.Шаг.Имя));
		КонецЕсли;

		Если СуществующийШаг.Количество() = 0 Тогда
			Шаг = Справочники.Renault_CommunicationCenter_ШагиСхемОбзвона.СоздатьЭлемент(); //текущий
			Шаг.Владелец     = СхемаОбзвона;
			Шаг.Наименование = СтрЭлемент.Шаг.Имя;
			Шаг.Содержание   = СОКРЛП(СтрЭлемент.Шаг.Наименование);
			Шаг.Вид          = Строка(ТипЗнч(СтрЭлемент.Шаг));
			СтрокаБлока = ТаблицаДействий.Найти(Шаг.Наименование, "ЭлементСхемы");
			Если СтрокаБлока<>Неопределено Тогда
				Шаг.Действие          = СтрокаБлока.Действие;
				Шаг.НазначениеОпросов = СтрокаБлока.НазначениеОпросов;
				Шаг.СхемаОбзвонаВторичная = СтрокаБлока.СхемаОбзвонаВторичная;
			КонецЕсли;
			Шаг.Записать();
			НовШаг                   = СписокСозданныхШагов.Добавить();
			НовШаг.СозданныйШагСхемы = Шаг.Ссылка;
			НовШаг.Наименование      = Шаг.Наименование;
		Иначе
			Шаг = СуществующийШаг[0].СозданныйШагСхемы;
        КонецЕсли;
		
		Если ТипЗнч(СтрЭлемент.СледующийШаг) = Тип("ВариантЭлементаГрафическойСхемыВыборВарианта") Тогда			
			СуществующийШаг = СписокСозданныхШагов.НайтиСтроки(Новый Структура("Наименование", СтрЭлемент.СледующийШаг.Наименование));			
		Иначе			
			СуществующийШаг = СписокСозданныхШагов.НайтиСтроки(Новый Структура("Наименование", СтрЭлемент.СледующийШаг.Имя));
		КонецЕсли;
		
		Если СуществующийШаг.Количество() = 0 Тогда
			СледующийШаг = Справочники.Renault_CommunicationCenter_ШагиСхемОбзвона.СоздатьЭлемент(); //следующий
			СледующийШаг.Владелец     = СхемаОбзвона;
			СледующийШаг.Наименование = ?(ТипЗнч(СтрЭлемент.СледующийШаг) = Тип("ВариантЭлементаГрафическойСхемыВыборВарианта"), СтрЭлемент.СледующийШаг.Наименование,СтрЭлемент.СледующийШаг.Имя);
			СледующийШаг.Содержание   = СОКРЛП(СтрЭлемент.СледующийШаг.Наименование);
			СледующийШаг.Вид          = Строка(ТипЗнч(СтрЭлемент.СледующийШаг));
			СтрокаБлока = ТаблицаДействий.Найти(СледующийШаг.Наименование, "ЭлементСхемы");
			Если СтрокаБлока<>Неопределено Тогда
				СледующийШаг.Действие          = СтрокаБлока.Действие;
				СледующийШаг.НазначениеОпросов = СтрокаБлока.НазначениеОпросов;
				СледующийШаг.СхемаОбзвонаВторичная = СтрокаБлока.СхемаОбзвонаВторичная;
			КонецЕсли;
			СледующийШаг.Записать();
		    НовШаг                   = СписокСозданныхШагов.Добавить();
			НовШаг.СозданныйШагСхемы = СледующийШаг.Ссылка;
			НовШаг.Наименование      = СледующийШаг.Наименование;
		Иначе
			СледующийШаг = СуществующийШаг[0].СозданныйШагСхемы;		
		КонецЕсли;
			
		НовСтрока = СправочникСхема.ШагиСхемы.Добавить();  //предыдущий и текущий 
		НовСтрока.ШагСхемы = ПредыдущийШаг.Ссылка;
		НовСтрока.Вид      = ПредыдущийШаг.Вид;
		НовСтрока.СледующийШаг = Шаг.Ссылка;
				
		НовСтрока = СправочникСхема.ШагиСхемы.Добавить(); //текущий и следующий  
		НовСтрока.ШагСхемы = Шаг.Ссылка;
		НовСтрока.Вид      = Шаг.Вид;
		НовСтрока.СледующийШаг = СледующийШаг.Ссылка;
				
		//Завершение записываем отдельно
		Если ТипЗнч(СтрЭлемент.СледующийШаг) = Тип("ЭлементГрафическойСхемыЗавершение") Тогда
			НовСтрока = СправочникСхема.ШагиСхемы.Добавить();  
			НовСтрока.ШагСхемы = СледующийШаг.Ссылка;
			НовСтрока.Вид      = СледующийШаг.Вид;
		КонецЕсли;
		
	КонецЦикла;
	
	СправочникСхема.Записать();
		
КонецПроцедуры

Функция ПолучитьПорядокЭлементовСхемы(ЭлементыГрафическойСхемы) Экспорт
	
	//получим варианты след. шагов по линиям,
	//если по точкам линии нельзя определить следующий и предыдущий шаг, значит выдаем сообщение пользователю о том,
	//что линию надо подсоединить к блоку
	
	ВлевоНачало  = 0;
	ВверхНачало  = 0;
	
	ВлевоКонец  = 0;
	ВверхКонец  = 0;
	
	ТаблицаЛиний = Новый ТаблицаЗначений;
	ТаблицаЛиний.Колонки.Добавить("Шаг",);
	ТаблицаЛиний.Колонки.Добавить("Влево",);
	ТаблицаЛиний.Колонки.Добавить("Вверх",);
	ТаблицаЛиний.Колонки.Добавить("Высота",);
	ТаблицаЛиний.Колонки.Добавить("Ширина",);
	ТаблицаЛиний.Колонки.Добавить("ПредыдущийШаг",);
	ТаблицаЛиний.Колонки.Добавить("СледующийШаг",);
	ТаблицаЛиний.Колонки.Добавить("ВыборВарианта",);
	ТаблицаЛиний.Колонки.Добавить("ЕстьВыборВарианта",);
		
	ТаблицаБлоков = Новый ТаблицаЗначений;
	ТаблицаБлоков.Колонки.Добавить("ЭлементСхемы",);
	ТаблицаБлоков.Колонки.Добавить("Влево",);
    ТаблицаБлоков.Колонки.Добавить("Вверх",);
    ТаблицаБлоков.Колонки.Добавить("Высота",);
    ТаблицаБлоков.Колонки.Добавить("Ширина",);
    ТаблицаБлоков.Колонки.Добавить("ВыборВарианта",);

	ЛинииСОшибкой = Новый СписокЗначений;
	
	Для Каждого СтрЭлемент Из ЭлементыГрафическойСхемы Цикл
		
		Если ТипЗнч(СтрЭлемент) = Тип("ЭлементГрафическойСхемыСоединительнаяЛиния") 
			ИЛИ  ТипЗнч(СтрЭлемент) = Тип("ЭлементГрафическойСхемыДекоративнаяЛиния") Тогда
			
			НовСтрока = ТаблицаЛиний.Добавить();
			НовСтрока.Шаг = СтрЭлемент;
			НовСтрока.Влево = СтрЭлемент.НачалоЛево;
	        НовСтрока.Вверх = СтрЭлемент.НачалоВерх;
	        НовСтрока.Высота = СтрЭлемент.КонецВерх;
	        НовСтрока.Ширина = СтрЭлемент.КонецЛево;
	        НовСтрока.ЕстьВыборВарианта = Ложь;

		Иначе
			
			НовСтрока = ТаблицаБлоков.Добавить();
			НовСтрока.ЭлементСхемы = СтрЭлемент;
			НовСтрока.Влево = СтрЭлемент.Лево;
	        НовСтрока.Вверх = СтрЭлемент.Верх;
	        НовСтрока.Высота = СтрЭлемент.Высота+СтрЭлемент.Верх;
	        НовСтрока.Ширина = СтрЭлемент.Ширина+СтрЭлемент.Лево;

			Если ТипЗнч(СтрЭлемент) = Тип("ЭлементГрафическойСхемыВыборВарианта") Тогда
				
				НовСтрока.Высота = СтрЭлемент.Высота+СтрЭлемент.Верх-СтрЭлемент.Элементы.Количество()*20;
				
				ВысотаЭлемента = 20+НовСтрока.Высота; 
				ВверхЭлемента  = НовСтрока.Высота;
				
				Для Каждого СтрВариант Из СтрЭлемент.Элементы Цикл
					
					НовСтрока = ТаблицаБлоков.Добавить();
					НовСтрока.ЭлементСхемы = СтрВариант;
					НовСтрока.Влево = СтрЭлемент.Лево;
			        НовСтрока.Вверх  = ВверхЭлемента;
			        НовСтрока.Высота = ВысотаЭлемента;
			        НовСтрока.Ширина = СтрЭлемент.Ширина+СтрЭлемент.Лево;
					НовСтрока.ВыборВарианта = СтрЭлемент;
					
					ВверхЭлемента  = ВверхЭлемента+20;
					ВысотаЭлемента = ВысотаЭлемента+20;		
					
				КонецЦикла;
				
			КонецЕсли;

		КонецЕсли;	
							
	КонецЦикла;
		
	Для Каждого Стр Из ТаблицаЛиний Цикл
		
		ВлевоНачало  = Стр.Влево;
		ВверхНачало  = Стр.Вверх;	
			
		ВлевоКонец  = Стр.Ширина;
		ВверхКонец  = Стр.Высота;
		
		Если Стр.Шаг.ЦветЛинии = Новый Цвет(255,0,0) Тогда
			 Стр.Шаг.ЦветЛинии = ЦветаСтиля.ЦветРамки;
		КонецЕсли;
		
		Для Каждого СтрБлок Из ТаблицаБлоков Цикл  //ищем блоки линий
		
			Если СтрБлок.Влево<=ВлевоНачало
				И ВлевоНачало<=СтрБлок.Ширина 
				И СтрБлок.Вверх<=ВверхНачало
				И ВверхНачало<=СтрБлок.Высота Тогда //проверяем начало линии 

			    Стр.ПредыдущийШаг = СтрБлок.ЭлементСхемы;
				
				Если СтрБлок.ВыборВарианта<>Неопределено Тогда
					Стр.ВыборВарианта = СтрБлок.ВыборВарианта;
					Стр.ЕстьВыборВарианта = Истина;
				КонецЕсли;
								
			КонецЕсли;
			
			Если СтрБлок.Влево<=ВлевоКонец
				И ВлевоКонец<=СтрБлок.Ширина 
				И СтрБлок.Вверх<=ВверхКонец
				И ВверхКонец<=СтрБлок.Высота Тогда //проверяем Конец линии 

			    Стр.СледующийШаг = СтрБлок.ЭлементСхемы;
								
			КонецЕсли;	
			
		КонецЦикла;
		
		Если Стр.ПредыдущийШаг = Неопределено ИЛИ Стр.СледующийШаг = Неопределено Тогда
			Если ЛинииСОшибкой.НайтиПоЗначению(Стр.Шаг) = Неопределено Тогда
				ЛинииСОшибкой.Добавить(Стр.Шаг);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;	
	
	//добавляем строки с вариантами
	СтрокиВариантов = ТаблицаЛиний.НайтиСтроки(Новый Структура("ЕстьВыборВарианта", Истина));
	
	Для Каждого СтрокаВарианта Из СтрокиВариантов Цикл
		НовСтрока = ТаблицаЛиний.Добавить();
		НовСтрока.Шаг = СтрокаВарианта.ПредыдущийШаг;
		НовСтрока.ПредыдущийШаг = СтрокаВарианта.ВыборВарианта;
		НовСтрока.СледующийШаг  = СтрокаВарианта.Шаг;
	КонецЦикла;	
	
	ТаблицаЛиний.Сортировать("ПредыдущийШаг");
	
	Для Каждого ОшибкаЛинии Из ЛинииСОшибкой Цикл
		ОшибкаЛинии.Значение.ЦветЛинии = Новый Цвет(255,0,0);
	КонецЦикла;	
	
	Если ЛинииСОшибкой.Количество()>0 Тогда
		Сообщить("Есть линии не соединенные с блоками схемы!");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаЛиний;
	
КонецФункции

Процедура ПометитьСуществующиеШагиНаУдаление(СхемаОбзвона)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_CommunicationCenter_ШагиСхемОбзвона.Ссылка
	|ИЗ
	|	Справочник.Renault_CommunicationCenter_ШагиСхемОбзвона КАК Renault_CommunicationCenter_ШагиСхемОбзвона
	|ГДЕ
	|	Renault_CommunicationCenter_ШагиСхемОбзвона.Владелец = &Владелец
	|	И НЕ Renault_CommunicationCenter_ШагиСхемОбзвона.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Владелец", СхемаОбзвона);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ШагСхемы = Выборка.Ссылка.ПолучитьОбъект();
		ШагСхемы.ПометкаУдаления = Истина;
		ШагСхемы.Записать();		
	
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьКлиентаНаОтказОтКонтакта(ТекущийКлиент) Экспорт
	
	Запись = РегистрыСведений.CRM_КлиентскиеДанные.СоздатьНаборЗаписей();			
	Запись.Отбор.Клиент.Установить(ТекущийКлиент);
	Запись.Прочитать();
		
	Если Запись.Количество() >0 Тогда
		Если Запись[0].ОтказОтКонтакта = Истина Тогда
			Возврат Истина;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции
