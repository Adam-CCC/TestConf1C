Функция ВернутьМассивФайловОбъекта(ВладелецФайла) Экспорт
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ПрикрепленныеФайлы.ПутьКФайлу,
	               |	Renault_ПрикрепленныеФайлы.Файл,
	               |	Renault_ПрикрепленныеФайлы.ФайлВоВнешнемХранилище,
	               |	Renault_ПрикрепленныеФайлы.Ссылка
	               |ИЗ
	               |	Справочник.Renault_ПрикрепленныеФайлы КАК Renault_ПрикрепленныеФайлы
	               |ГДЕ
	               |	Renault_ПрикрепленныеФайлы.ВладелецФайла = &ВладелецФайла
	               |	И НЕ Renault_ПрикрепленныеФайлы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ВладелецФайла",ВладелецФайла);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		СтруктураОписанияФайла = Новый Структура("ПутьКФайлу,Файл,ФайлВоВнешнемХранилище,Ссылка");
		ЗаполнитьЗначенияСвойств(СтруктураОписанияФайла,Выборка);
		Результат.Добавить(СтруктураОписанияФайла);
	КонецЦикла;	
	Возврат Результат;
КонецФункции

