Функция ПолучитьПервичныйИнтерес(Отдел) Экспорт
	
	//Первоначальная инициализация
	СписокИнтерес = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_ОтделыПервичныйИнтерес.ПервичныйИнтерес КАК Ссылка
	|ИЗ
	|	Справочник.CRM_Отделы.ПервичныйИнтерес КАК CRM_ОтделыПервичныйИнтерес
	|ГДЕ
	|	CRM_ОтделыПервичныйИнтерес.ПервичныйИнтерес.ПометкаУдаления = ЛОЖЬ
	|	И CRM_ОтделыПервичныйИнтерес.Ссылка = &Отдел
	|
	|УПОРЯДОЧИТЬ ПО
	|	CRM_ОтделыПервичныйИнтерес.ПервичныйИнтерес";
	Запрос.УстановитьПараметр("Отдел", Отдел);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокИнтерес.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокИнтерес;
	
КонецФункции

Функция ПолучитьОтделыСотрудника(Сотрудник) Экспорт
	
	Отделы = Новый СписокЗначений;
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Отделы.Добавить(Справочники.CRM_Отделы.ПустаяСсылка());
		Возврат Отделы;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ОтделыДолжности.Ссылка
	               |ПОМЕСТИТЬ ВТДолжности
	               |ИЗ
	               |	Справочник.CRM_Отделы.Должности КАК CRM_ОтделыДолжности
	               |ГДЕ
	               |	CRM_ОтделыДолжности.Должность = &Должность
	               |	И CRM_ОтделыДолжности.ВыбиратьВСписки
	               |	И НЕ CRM_ОтделыДолжности.Ссылка.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CRM_ОтделыПодразделения.Ссылка
	               |ПОМЕСТИТЬ ВТПодразделения
	               |ИЗ
	               |	Справочник.CRM_Отделы.Подразделения КАК CRM_ОтделыПодразделения
	               |ГДЕ
	               |	CRM_ОтделыПодразделения.Подразделение = &Подразделение
	               |	И НЕ CRM_ОтделыПодразделения.Ссылка.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	CRM_Отделы.Ссылка КАК Отдел
	               |ИЗ
	               |	Справочник.CRM_Отделы КАК CRM_Отделы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДолжности КАК ВТДолжности
	               |		ПО CRM_Отделы.Ссылка = ВТДолжности.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПодразделения КАК ВТПодразделения
	               |		ПО CRM_Отделы.Ссылка = ВТПодразделения.Ссылка";
	
	Запрос.УстановитьПараметр("Должность", Сотрудник.Должность);
	Запрос.УстановитьПараметр("Подразделение", Сотрудник.Подразделение);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Отделы.Добавить(Справочники.CRM_Отделы.ПустаяСсылка());
		Возврат Отделы;
	Иначе
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("Отдел");
	КонецЕсли;
	
КонецФункции