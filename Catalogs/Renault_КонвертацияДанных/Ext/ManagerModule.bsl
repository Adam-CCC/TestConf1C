Функция СоздатьМД(ИмяМД,БазаДанных,Родитель=Неопределено) Экспорт
	Ссылка=МДСуществует(ИмяМД,Истина); Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка КонецЕсли; //поиск
	//создание
	Объект=Справочники.Renault_КонвертацияДанных.СоздатьЭлемент();
	Объект.Активно=Истина;
	Если Родитель<>Неопределено Тогда Объект.Родитель=Родитель КонецЕсли;
	Объект.Наименование=ИмяМД;
	Объект.ВнешниеМетаданные=ВнешниеМетаданныеПоНаимеменованию(ИмяМД,БазаДанных);
	
	ТекстОшибки="";
	//Если НЕ ЗаполнитьРеквизитыОбъекта(Объект.Ссылка,ТекстОшибки,ИмяКоманды) Тогда Сообщить(ТекстОшибки,СтатусСообщения.Внимание) КонецЕсли;
	ЗаполнитьТЧРеквизиты(Объект);
	
	Объект.Записать();
	Возврат Объект.Ссылка
КонецФункции
Функция МДСуществует(ИмяМД,ВернутьСсылку=Ложь) Экспорт
	Запрос=Новый Запрос("Выбрать Ссылка Из Справочник.Renault_КонвертацияДанных ГДЕ Наименование=&ИмяМД");
	Запрос.УстановитьПараметр("ИмяМД",ИмяМД);
	Если ВернутьСсылку Тогда
		Выборка=Запрос.Выполнить().Выбрать();	
		Выборка.Следующий();
		Возврат Выборка.Ссылка
	Иначе Возврат НЕ Запрос.Выполнить().Пустой() КонецЕсли;
КонецФункции	