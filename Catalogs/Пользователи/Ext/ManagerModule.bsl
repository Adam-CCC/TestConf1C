Функция СМГ_ПодразделениеНедоступно(ПроверяемоеПодразделение) Экспорт
	
	флОтказ = Ложь;	
	
	Если обЗначениеНеЗаполнено(ПроверяемоеПодразделение) Тогда
		флОтказ = Истина;	
	КонецЕсли; 
	
	СписокДоступныхПодразделенийПользователя =  СМГ_ПолучитьСписокПодразделений();
	
	Если СписокДоступныхПодразделенийПользователя.Количество() = 0 Тогда
		флОтказ = Истина;	
	КонецЕсли;                                                    
	
Если СписокДоступныхПодразделенийПользователя.НайтиПоЗначению(ПроверяемоеПодразделение) = Неопределено Тогда
		флОтказ = Истина;		
 	КонецЕсли;
 	
	Возврат флОтказ;	

КонецФункции // СМГ_ПодразделениеНедоступно(ТекущееПодразделение)


Функция СМГ_ПолучитьСписокПодразделений() Экспорт
	СписокПодразделений = Новый СписокЗначений; 
    Для каждого Стр1 Из ПараметрыСеанса.Пользователь.Сотрудник.ТаблицаПодразделенийРаботы Цикл
		СписокПодразделений = СМГ_НайтиПодчиненныеПодразделения(Стр1.ПодразделениеРаботы,СписокПодразделений);	
	КонецЦикла;
	СписокПодразделений.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	Возврат СписокПодразделений;	
КонецФункции // СМГ_ПолучитьСписокПодразделений()

Функция СМГ_НайтиПодчиненныеПодразделения(ГоловноеПодразделение,СпПодр)
	 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&ГоловноеПодразделение)
		|	И НЕ ПодразделенияКомпании.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ГоловноеПодразделение", ГоловноеПодразделение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл                   
		ТекПодразделение = ВыборкаДетальныеЗаписи.Ссылка; 
		Если СМГ_ЕстьПодчиненныеПодразделения(ТекПодразделение) Тогда
			Продолжить;
 		КонецЕсли;
 		Если СпПодр.НайтиПоЗначению(ТекПодразделение) = Неопределено Тогда
 			СпПодр.Добавить(ТекПодразделение);		 
 		 КонецЕсли;
	КонецЦикла;
 	
	Возврат СпПодр;

КонецФункции // СМГ_НайтиПодчиненныеПодразделения() 

Функция СМГ_ЕстьПодчиненныеПодразделения(ГоловноеПодразделение)
	
	КоличествоПодчиненных = 0;
 	ЕстьПодчиненныеПодразделения = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&ГоловноеПодразделение)
		|	И НЕ ПодразделенияКомпании.ПометкаУдаления
		|	И ПодразделенияКомпании.Ссылка <> &ГоловноеПодразделение";
	
	Запрос.УстановитьПараметр("ГоловноеПодразделение", ГоловноеПодразделение);
	
	ТЗ = Запрос.Выполнить().Выгрузить() ;
	КоличествоПодчиненных =  ТЗ.Количество();
	
	Если КоличествоПодчиненных > 0 Тогда
		ЕстьПодчиненныеПодразделения=Истина;
	КонецЕсли;
	
	Возврат ЕстьПодчиненныеПодразделения;
  
КонецФункции // СМГ_НайтиПодчиненныеПодразделения()

