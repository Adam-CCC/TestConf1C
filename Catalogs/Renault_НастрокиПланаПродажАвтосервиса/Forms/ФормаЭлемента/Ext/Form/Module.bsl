///////////////////////////////////////////////////////////////События формы///////////////////////////////////////////////////////////
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЦветФонаСтандартный = Новый Цвет(255, 255, 255);
	ЦветФонаСтрокиСДанными = Новый Цвет(64, 244, 208);
	ЦветФонаСтрокиСОшибками = Новый Цвет(255, 136, 108);
	
	Запрос = Новый Запрос;
	
	СсылкаНаОбъект = Объект.Ссылка;
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ВидыПланированияПланаПродажАвтосервиса.Ссылка КАК ВидПланирования
		|ИЗ
		|	Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса КАК Renault_ВидыПланированияПланаПродажАвтосервиса
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_НастрокиПланаПродажАвтосервиса.ДанныеПоБонусамМалусам КАК Renault_НастрокиПланаПродажАвтосервисаДанныеПоБонусамМалусам
		|		ПО (Renault_НастрокиПланаПродажАвтосервисаДанныеПоБонусамМалусам.ВидПланирования = Renault_ВидыПланированияПланаПродажАвтосервиса.Ссылка)
		|			И (Renault_НастрокиПланаПродажАвтосервисаДанныеПоБонусамМалусам.Ссылка = &Ссылка)
		|ГДЕ
		|	НЕ Renault_ВидыПланированияПланаПродажАвтосервиса.ПометкаУдаления
		|	И Renault_НастрокиПланаПродажАвтосервисаДанныеПоБонусамМалусам.ВидПланирования ЕСТЬ NULL "; 
		
		//Для оформления табличной части ДанныеПоБонусамМалусам
		ЗапросДляОформления = Новый Запрос;
		ЗапросДляОформления.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Renault_НастрокиПланаПродажАвтосервисаДанныеПоВидамПланирования.ВидПланирования
			|ИЗ
			|	Справочник.Renault_НастрокиПланаПродажАвтосервиса.ДанныеПоВидамПланирования КАК Renault_НастрокиПланаПродажАвтосервисаДанныеПоВидамПланирования
			|ГДЕ
			|	Renault_НастрокиПланаПродажАвтосервисаДанныеПоВидамПланирования.Ссылка = &Ссылка";		
		ЗапросДляОформления.УстановитьПараметр("Ссылка", СсылкаНаОбъект);	
		РезультатЗапросаДляОформления = ЗапросДляОформления.Выполнить();
		
		Выборка = РезультатЗапросаДляОформления.Выбрать();
		
		СписокВидовПланирования = Новый СписокЗначений();
		
		Пока Выборка.Следующий() Цикл
			СписокВидовПланирования.Добавить(Выборка.ВидПланирования);
		КонецЦикла;
		
		Оформление(ЦветФонаСтрокиСДанными, СписокВидовПланирования);
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ВидыПланированияПланаПродажАвтосервиса.Ссылка КАК ВидПланирования
		|ИЗ
		|	Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса КАК Renault_ВидыПланированияПланаПродажАвтосервиса
		|ГДЕ
		|	НЕ Renault_ВидыПланированияПланаПродажАвтосервиса.ПометкаУдаления";
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		
		ТабВидыПланирования = Объект.ДанныеПоБонусамМалусам;
		
		Пока Выборка.Следующий() Цикл
			Стр = ТабВидыПланирования.Добавить();
			Стр.ВидПланирования = Выборка.ВидПланирования;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Объект.Автор) Тогда
		Элементы.Автор.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ТекущийВидПланирования) Тогда
		Если ДанныеПоВидамПланированияБуфер.Количество() <> 0 Тогда
			ПерезаполнитьДанныеПоВидамПланированияИзБуфера();
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.Утвержден Тогда
