			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ЕСТЬNULL(ТаблицаНезаполненныхБонусовМалусов.ВидПланирования, ТаблицаНезаполненныхДанных.ВидПланирования) КАК ВидПланирования
			|ИЗ
			|	ТаблицаНезаполненныхДанных КАК ТаблицаНезаполненныхДанных
			|		ПОЛНОЕ СОЕДИНЕНИЕ ТаблицаНезаполненныхБонусовМалусов КАК ТаблицаНезаполненныхБонусовМалусов
			|		ПО ТаблицаНезаполненныхДанных.ВидПланирования = ТаблицаНезаполненныхБонусовМалусов.ВидПланирования";
		Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Ссылка);	
		Результат = Запрос.ВыполнитьПакет();
		
		Если НЕ Результат[2].Пустой() Тогда
			Выборка = Результат[2].Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ВидПланированияПредставление = Выборка.ВидПланированияПредставление;
				
				Сообщить("Для настроек вида планирования - """ + ВидПланированияПредставление + """, заполнены не все обязательные поля!");
			КонецЦикла;
			
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ Результат[3].Пустой() Тогда
			Выборка = Результат[3].Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ВидПланированияПредставление = Выборка.ВидПланированияПредставление;
				
				Сообщить("Для вида планирования - """ + ВидПланированияПредставление + """, не заполнены поля вид бонуса или/и вид малуса!");
			КонецЦикла;
			
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ Результат[4].Пустой() Тогда
			Выборка = Результат[4].Выбрать();
			
			СписокВидовПланирования = Новый СписокЗначений();
			
			Пока Выборка.Следующий() Цикл
				СписокВидовПланирования.Добавить(Выборка.ВидПланирования);
			КонецЦикла;
			
			Оформление(ЦветФонаСтрокиСОшибками, СписокВидовПланирования);
			
			Оформить = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВидамПланированияБуферПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ ЗначениеЗаполнено(ТекущийВидПланирования) Тогда
		Отказ = Истина;
	Иначе
		Если ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеСреднегоЧекаПроданныхАвторабот") 
			ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеСреднегоЧекаПроданныхТоваров") 
			ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоОборотуЗаПериодПоАвтоработам") 
			ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоОборотуЗаПериодПоТоварам") Тогда
			
			Если ДанныеПоВидамПланированияБуфер.Количество() > 0 Тогда
				Сообщить("Для выбранного вида планирования предусмотрена только одна строка!");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВидамПланированияБуферПослеУдаления(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийВидПланирования) Тогда
		Если ДанныеПоВидамПланированияБуфер.Количество() = 0 Тогда
			ТабДанныеПоВидамПланирования = Объект.ДанныеПоВидамПланирования;
			Отбор = Новый Структура("ВидПланирования", ТекущийВидПланирования);
			Строки = ТабДанныеПоВидамПланирования.НайтиСтроки(Отбор);
			Для Каждого Строка Из Строки Цикл
				Индекс = ТабДанныеПоВидамПланирования.Индекс(Строка);
				ТабДанныеПоВидамПланирования.Удалить(Индекс);
			КонецЦикла;
		КонецЕсли;
		ОформитьСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВидамПланированияБуферПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если ЗначениеЗаполнено(ТекущийВидПланирования) И НоваяСтрока Тогда
		Строка = Элементы.ДанныеПоВидамПланированияБуфер.ТекущиеДанные;
		Строка.ВидПланирования = ТекущийВидПланирования;
		ОформитьСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВидамПланированияБуферПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущийЭлемент.Имя = "ДанныеПоВидамПланированияБуферРесурсПланирования" Тогда
		МассивТипов = Новый Массив;
		
		Если ЗначениеЗаполнено(ТекущийВидПланирования) Тогда
			МассивТипов = Новый Массив;
			
			Если ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданныхАвторабот")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданныхАвторабот") Тогда
				
				МассивТипов.Добавить(Тип("СправочникСсылка.Автоработы"));
			ИначеЕсли ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовара")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданногоТовара") 
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданногоТовараИзПапки")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовараИзПапки") Тогда 
				
				МассивТипов.Добавить(Тип("СправочникСсылка.Номенклатура"));
			ИначеЕсли ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданныхРаботПоВидамРемонта")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеСреднегоЧекаПроданныхРаботПоВидамРемонта") Тогда 
				
				МассивТипов.Добавить(Тип("СправочникСсылка.ВидыРемонта"));
			КонецЕсли; 
			
			ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);
			Элемент.ПодчиненныеЭлементы.ДанныеПоВидамПланированияБуферРесурсПланирования.ОграничениеТипа = ОписаниеТипов;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоВидамПланированияБуферРесурсПланированияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ТекущийВидПланирования) Тогда
		ВыбранноеЗначение = Элементы.ДанныеПоВидамПланированияБуфер.ТекущиеДанные.РесурсПланирования;
		
		Если ЭтоГруппа(ВыбранноеЗначение) Тогда
			Если ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданныхАвторабот")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданныхАвторабот") Тогда
				
				Сообщить("Выберите автоработу, а не папку!");
				Элементы.ДанныеПоВидамПланированияБуфер.ТекущиеДанные.РесурсПланирования = ПредопределенноеЗначение("Справочник.Автоработы.ПустаяСсылка");
			ИначеЕсли ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовара")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданногоТовара") Тогда
				
				Сообщить("Выберите товар, а не папку!");
				Элементы.ДанныеПоВидамПланированияБуфер.ТекущиеДанные.РесурсПланирования = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
			КонецЕсли;
		Иначе
			Если ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданногоТовараИзПапки")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовараИзПапки") Тогда 
				
				Сообщить("Выберите папку с товарами, а не товар!");
				Элементы.ДанныеПоВидамПланированияБуфер.ТекущиеДанные.РесурсПланирования = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоБонусамМалусамПриАктивизацииСтроки(Элемент)
	
	ТекущийВидПланирования = ТекущийВидПланирования();
	
	Если ЗначениеЗаполнено(ТекущийВидПланирования) Тогда
		Если ДанныеПоВидамПланированияБуфер.Количество() <> 0 Тогда
			ПерезаполнитьДанныеПоВидамПланированияИзБуфера();
		КонецЕсли;
		ДанныеПоВидамПланированияБуфер.Очистить();
		Отбор = Новый Структура("ВидПланирования", ТекущийВидПланирования);
		Строки = Объект.ДанныеПоВидамПланирования.НайтиСтроки(Отбор);
		Для Каждого Строка Из Строки Цикл
			Стр = ДанныеПоВидамПланированияБуфер.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, Строка);
		КонецЦикла;
		УстановитьИнтерфейсФормы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеПоБонусамМалусамПриИзменении(Элемент)
	
	ОформитьСтроки();
	
КонецПроцедуры
/////////////////////////////////////////////////////////////Разные процедуры и функции/////////////////////////////////////////////
&НаКлиенте
Процедура ПерезаполнитьДанныеПоВидамПланированияИзБуфера()
	
	ВидПланирования = ДанныеПоВидамПланированияБуфер[0].ВидПланирования;
	
	ТабДанныеПоВидамПланирования = Объект.ДанныеПоВидамПланирования;
	
	Отбор = Новый Структура("ВидПланирования", ВидПланирования);
	Строки = ТабДанныеПоВидамПланирования.НайтиСтроки(Отбор);
	
	Для Каждого Строка Из Строки Цикл
		Индекс = ТабДанныеПоВидамПланирования.Индекс(Строка);
		ТабДанныеПоВидамПланирования.Удалить(Индекс);
	КонецЦикла;
	
	Для Каждого Строка Из ДанныеПоВидамПланированияБуфер Цикл
		Стр = ТабДанныеПоВидамПланирования.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Строка);
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ТекущийВидПланирования()
	
	ТекущиеДанныеПоБонусамМалусам = Элементы.ДанныеПоБонусамМалусам.ТекущиеДанные;
	
	Если ТекущиеДанныеПоБонусамМалусам = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат ТекущиеДанныеПоБонусамМалусам.ВидПланирования;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоГруппа(СсылкаНаОбъект)
	
	Возврат СсылкаНаОбъект.ЭтоГруппа;
	
КонецФункции

&НаКлиенте
Процедура УстановитьИнтерфейсФормы()
	
	НастраиваемыеЭлементы = Новый Структура("РесурсПланирования, СуммаРесурса, КоличествоРесурса");
	
	Для Каждого ЭлементНастройки Из НастраиваемыеЭлементы Цикл
		Ключ = ЭлементНастройки.Ключ;
		
		Если Ключ = "РесурсПланирования" Тогда
			ЗаголовокКолонки = "Товар";
			ВидимостьКолонки  = Истина;
			
			Если ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданныхАвторабот")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданныхАвторабот") Тогда
				
				ЗаголовокКолонки = "Авторабота";
			ИначеЕсли ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовара")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданногоТовара") Тогда
				
				ЗаголовокКолонки = "Товар";
			ИначеЕсли ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовараИзПапки") 
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданногоТовараИзПапки") Тогда
				
				ЗаголовокКолонки = "Папка товаров";
			ИначеЕсли ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеПроданныхРаботПоВидамРемонта")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеСреднегоЧекаПроданныхРаботПоВидамРемонта") Тогда
				
				ЗаголовокКолонки = "Вид ремонта"
			ИначеЕсли ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеСреднегоЧекаПроданныхАвторабот") 
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоСуммеСреднегоЧекаПроданныхТоваров") 
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоОборотуЗаПериодПоАвтоработам") 
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоОборотуЗаПериодПоТоварам") Тогда
				
				ВидимостьКолонки = Ложь;
			КонецЕсли;
		ИначеЕсли Ключ = "СуммаРесурса" Тогда
			ЗаголовокКолонки = "Сумма";
			ВидимостьКолонки  = Истина;
			
			Если ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданныхАвторабот") 
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовара")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовараИзПапки") Тогда
				
				ВидимостьКолонки  = Ложь;	
			КонецЕсли;
		ИначеЕсли Ключ = "КоличествоРесурса" Тогда
			ЗаголовокКолонки = "Количество";
			ВидимостьКолонки  = Ложь;
			
			Если ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданныхАвторабот") 
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовара")
				ИЛИ ТекущийВидПланирования = ПредопределенноеЗначение("Справочник.Renault_ВидыПланированияПланаПродажАвтосервиса.ПоКоличествуПроданногоТовараИзПапки")Тогда
				
				ВидимостьКолонки  = Истина;
			КонецЕсли;
		КонецЕсли;
		
		НастройкаЭлемента = Новый Структура("Заголовок, АвтоОтметкаНезаполненного, Видимость", ЗаголовокКолонки, ВидимостьКолонки, ВидимостьКолонки);
		НастраиваемыеЭлементы.Вставить(Ключ, НастройкаЭлемента);
	КонецЦикла;
	
	Для Каждого ЭлементНастройки Из НастраиваемыеЭлементы Цикл
		ЗаполнитьЗначенияСвойств(Элементы["ДанныеПоВидамПланированияБуфер" + ЭлементНастройки.Ключ], ЭлементНастройки.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОформитьСтроки()
	
	Если ДанныеПоВидамПланированияБуфер.Количество() = 0 Тогда 
		ЦветФона = ЦветФонаСтандартный;
	ИначеЕсли ДанныеПоВидамПланированияБуфер.Количество() = 1 ИЛИ Оформить Тогда
		ЦветФона = ЦветФонаСтрокиСДанными;
	Иначе
		Возврат;
	КонецЕсли;
	
	Оформление(ЦветФона, ТекущийВидПланирования);
	
КонецПроцедуры

&НаСервере
Процедура Оформление(ЦветФонаСтроки, ВидПланирования)
	
	НачальнаяТочкаОформления = "ВидПланирования";
	
	ИмяТабЧасти = "ДанныеПоБонусамМалусам";
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;
	
	ОформлениеУО = ЭлементУсловногоОформления.Оформление;
	ОтборУО = ЭлементУсловногоОформления.Отбор;
	ОформляемыеПоляУО = ЭлементУсловногоОформления.Поля;
	
	ОформлениеУО.УстановитьЗначениеПараметра("ЦветФона", ЦветФонаСтроки);
	
	ЭлементОтбора                = ОтборУО.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Объект." + ИмяТабЧасти + "." + НачальнаяТочкаОформления);
	
	Если ТипЗнч(ВидПланирования) = Тип("СправочникСсылка.Renault_ВидыПланированияПланаПродажАвтосервиса") Тогда
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Иначе
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	КонецЕсли;
	
	ЭлементОтбора.ПравоеЗначение = ВидПланирования;
	ЭлементОтбора.Использование  = Истина;
	
	Для каждого РеквизитТЧ Из Метаданные["Справочники"]["Renault_НастрокиПланаПродажАвтосервиса"].ТабличныеЧасти[ИмяТабЧасти].Реквизиты Цикл
		НазваниеРеквизита = РеквизитТЧ.Имя;
		ОформляемоеПоле = ОформляемыеПоляУО.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТабЧасти + НазваниеРеквизита);
	КонецЦикла;
	
	ОформляемоеПоле = ОформляемыеПоляУО.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТабЧасти + "НомерСтроки");
	
КонецПроцедуры










































