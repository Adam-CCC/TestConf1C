	ЕстьNULL(ТЧ.ВариантСкидки,Значение(Перечисление.DMS_ВариантыСкидки.Сумма)) ВариантСкидки
	
ИЗ Справочник.DMS_КоммерческиеАкции Спр
Полное Соединение Справочник.DMS_КоммерческиеАкции.Условия ТЧ По Спр.Ссылка=ТЧ.Ссылка
ГДЕ Спр.Активность 
	И НЕ Спр.Автовыбор 
	
	//проверка периода
	И НачалоПериода(&amp;ТекДата,День) Между Спр.НачалоДействия И Спр.ОкончаниеДействия //период в шапке
	И Выбор //проверка периода в ТЧ
		Когда ТЧ.Ссылка Есть NULL Тогда Истина
		Иначе ТЧ.НачалоДействия=ДатаВремя(1,1,1,0,0,0) ИЛИ НачалоПериода(&amp;ТекДата,День) Между ТЧ.НачалоДействия И ТЧ.ОкончаниеДействия
	Конец	

	// проверка на флаги Кредит, TradeIn, Утилизция
	И( Спр.ТипАкции=0 
		ИЛИ Спр.ТипАкции=1
		//ИЛИ (Спр.ТипАкции=1 И &amp;Кредит)
		ИЛИ (Спр.ТипАкции=2 И &amp;TradeIn)
		ИЛИ (Спр.ТипАкции=3 И &amp;Утилизация)
	)

	//годы
	И Спр.Ссылка В(
		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции ГДЕ Ссылка НЕ В(Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ГодыВыпуска)		
		Объединить
		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ГодыВыпуска ГДЕ Год=&amp;Год
	)
	
	//дилерские центры
	И Спр.Ссылка В(
		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции ГДЕ Ссылка НЕ В(Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры)		
		Объединить
		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры ГДЕ ДилерскийЦентр=&amp;ДилерскийЦентр
	)	
	
	//все акции Контрагентов но отбор акций Автомобиля
	И Выбор 
		Когда Спр.ВладелецАкции=Значение(Перечисление.DMS_ВладельцыСервисов.Контрагент) Тогда Истина 
		Иначе &amp;БезОтбора ИЛИ ТЧ.Объект=&amp;ВариантКомплектации ИЛИ ТЧ.Объект=&amp;Модель ИЛИ ТЧ.Объект=&amp;VIN
	Конец</QueryText>
