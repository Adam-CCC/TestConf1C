
&НаКлиенте
Процедура ВыбратьНастройку()
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Закрыть(ТекДанные.Ссылка);
КонецПроцедуры	//ВыбратьНастройку

&НаКлиенте
Процедура Выбрать(Команда)
	ВыбратьНастройку();
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыбратьНастройку();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборПоПользователю = Неопределено;
	
	// ищем искомый элемент отбора: если добавляли его при прошлом открытии формы, то система сохранит его, только сбросить флаг Использование
	Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный Тогда
			ОтборПоПользователю = ЭлементОтбора;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборПоПользователю = Неопределено Тогда	// первое использование формы. Элемент отбора еще не добавлен. Добавляем
		ОтборПоПользователю = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоПользователю.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
		ОтборПоПользователю.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("Пользователь");
		ОтборПоПользователю.ПравоеЗначение 		= ПараметрыСеанса.Пользователь;
		ОтборПоПользователю.РежимОтображения	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	Иначе	// форму уже использовали. Нужно только включить существующий элемент отбора
		ОтборПоПользователю.Использование 		= Истина;
	КонецЕсли;
	
	// отбор по ключу объекта
	ОтборПоКлючуОбъекта = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоКлючуОбъекта.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
	ОтборПоКлючуОбъекта.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("КлючОбъекта");
	ОтборПоКлючуОбъекта.ПравоеЗначение 		= Параметры.КлючОбъекта;
	ОтборПоКлючуОбъекта.РежимОтображения	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
	ОтборПоКлючуОбъекта.Использование 		= Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекПользователь()
	Возврат ПараметрыСеанса.Пользователь;
КонецФункции

&НаКлиенте
Процедура НастройкиВсехПользователей(Команда)
	
	Элементы.СписокНастройкиВсехПользователей.Пометка = Не Элементы.СписокНастройкиВсехПользователей.Пометка;
	
	ОтборПоПользователю = Неопределено;
	
	// ищем искомый элемент отбора: если добавляли его при прошлом открытии формы, то система сохранит его, только сбросить флаг Использование
	Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Пользователь") Тогда
			ОтборПоПользователю = ЭлементОтбора;
		КонецЕсли;
	КонецЦикла;
	
	Если Элементы.СписокНастройкиВсехПользователей.Пометка Тогда	 // выключить отбор по пользователю
		Если ОтборПоПользователю = Неопределено Тогда
			//  нет отбора по пользователю. И не нужно
		Иначе	// есть отбор по пользователю. Выключим его
			ОтборПоПользователю.Использование 		= Ложь;
		КонецЕсли;
		
	Иначе	// включить отбор по пользователю
		Если ОтборПоПользователю = Неопределено Тогда	//  нет отбора по пользователю. Создадим			
			ОтборПоПользователю = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборПоПользователю.ВидСравнения 		= ВидСравненияКомпоновкиДанных.Равно;
			ОтборПоПользователю.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("Пользователь");
			ОтборПоПользователю.ПравоеЗначение 		= ТекПользователь();
			ОтборПоПользователю.РежимОтображения	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		Иначе	// есть отбор по пользователю. Выключим его
			ОтборПоПользователю.Использование 		= Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

