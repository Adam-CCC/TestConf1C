Функция ЕстьОшибкиЗаполненияДляПечатиСогласияНаОбработку()
	
	Если СогласиеНаОбработкуПерсональныхДанных<>Перечисления.ВариантыОтветов.Да Тогда
		Возврат Истина;
	КонецЕсли; 
	
	Если Не Константы.ДилерскийЦентр.Получить() = Справочники.ДилерскиеЦентры.Дельта Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СписокОбязательныхРеквизитов = Новый СписокЗначений;
	СписокОбязательныхРеквизитов.Добавить("Фамилия", "Фамилия");
	СписокОбязательныхРеквизитов.Добавить("Имя", "Имя");
	СписокОбязательныхРеквизитов.Добавить("Отчество", "Отчество");
	СписокОбязательныхРеквизитов.Добавить("Пол", "Пол");
	СписокОбязательныхРеквизитов.Добавить("РекламныйИсточник", "Источник информации");
	
	Если ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		СписокОбязательныхРеквизитов.Добавить("ОсновнойТелефон", "Телефон");
	КонецЕсли;
	
	Отказ = Ложь;
	
	Для Каждого Запись Из СписокОбязательныхРеквизитов Цикл
		Если Не ЗначениеЗаполнено(ЭтотОбъект[Запись.Значение]) Тогда
			#Если НаКлиенте Тогда
				Сообщить("Не заполнен реквизит """ + Запись.Представление + """!");
			#КонецЕсли 
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Email = киПолучитьПредставлениеКИ(Ссылка, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	
	Если Не ЗначениеЗаполнено(Email) Тогда
		#Если НаКлиенте Тогда
			Сообщить("Не заполнен адрес электронной почты!");
		#КонецЕсли 
		Отказ = Истина;
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции
