	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Контрагенты.ОсновнойТелефон = &ОсновнойТелефон
	|	И НЕ Контрагенты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("ОсновнойТелефон", ОсновнойТелефон);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДубльКонтрагента_ = ВыборкаДетальныеЗаписи.Контр;
		Прервать;
	КонецЦикла;
	
	Возврат ДубльКонтрагента_;
 
КонецФункции // НайтиДубльКонтрагентаПоНаименованиюИОсновномуТелефону(ОсновнойТелефон,Наименование)
 

