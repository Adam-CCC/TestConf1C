	#Если Клиент Тогда
		
		Макет = ПолучитьМакет("СОПД_Belgee_Согласие_родственника");   	
	
		// 1. Заполнение структуры параметров
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ФИО_Полностью", спПолучитьНаименование(Ссылка));  // вместо Клиент используем Ссылка
		СтруктураПараметров.Вставить("Адрес_Проживания", киПолучитьПредставлениеКИ(Ссылка, Справочники.ВидыКонтактнойИнформации.АдресПочтовый));
		
		ПодтверждающийДокумент = спПолучитьПодтверждающийДокументОбъектаПоВиду(Ссылка, Перечисления.ВидыДокументов.Паспорт);  // вместо Клиент используем Ссылка
		
		Если НЕ ПодтверждающийДокумент.Пустая() Тогда		
			СтруктураПараметров.Вставить("Документ", ПодтверждающийДокумент.ВидПодтверждающегоДокумента);
			СтруктураПараметров.Вставить("СерияНомер", ПодтверждающийДокумент.Серия + " " + ПодтверждающийДокумент.Номер);
			СтруктураПараметров.Вставить("КогдаВыдан", Формат(ПодтверждающийДокумент.ДатаВыдачи, "ДФ=dd.MM.yyyy"));
			СтруктураПараметров.Вставить("КемВыдан", ПодтверждающийДокумент.КемВыдан);  
