		ОтборПоКонтрагенту.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборПоКонтрагенту.ПравоеЗначение = Ссылка;
		
		//отДействияФормыСформировать(ФормаОтчета, Истина);
