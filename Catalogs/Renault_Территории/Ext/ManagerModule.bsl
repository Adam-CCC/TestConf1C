Функция ПодобратьСклады(Территория, Склад) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Склад
	|ГДЕ
	|	&Склад <> ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СкладыКомпании.Ссылка
	|ИЗ
	|	Справочник.СкладыКомпании КАК СкладыКомпании
	|ГДЕ
	|	СкладыКомпании.Renault_Территория = &Территория
	|	И &Территория <> ЗНАЧЕНИЕ(Справочник.REnault_Территории.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Территория", Территория);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("Склад");
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции
