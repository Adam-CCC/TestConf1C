
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Модель") И Параметры.Свойство("Версия") И Параметры.Свойство("ГодПроизводства") Тогда
		
		Список.ПроизвольныйЗапрос = Истина;
		Список.ТекстЗапроса =
		"ВЫБРАТЬ
		|	СправочникКредитныеПрограммы.Ссылка,
		|	СправочникКредитныеПрограммы.ВерсияДанных,
		|	СправочникКредитныеПрограммы.ПометкаУдаления,
		|	СправочникКредитныеПрограммы.Предопределенный,
		|	СправочникКредитныеПрограммы.Код,
		|	СправочникКредитныеПрограммы.Наименование,
		|	СправочникКредитныеПрограммы.Банк,
		|	СправочникКредитныеПрограммы.Описание,
		|	СправочникКредитныеПрограммы.ГодоваяСтавка,
		|	СправочникКредитныеПрограммы.СсылкаНаКалькулятор
		|ИЗ
		|	РегистрСведений.CRM_ПрименениеКредитныхПрограмм КАК CRM_ПрименениеКредитныхПрограмм
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КредитныеПрограммы КАК СправочникКредитныеПрограммы
		|		ПО CRM_ПрименениеКредитныхПрограмм.КредитнаяПрограмма = СправочникКредитныеПрограммы.Ссылка
		|ГДЕ
		|	CRM_ПрименениеКредитныхПрограмм.Модель = &Модель
		|	И CRM_ПрименениеКредитныхПрограмм.Версия = &Версия
		|	И CRM_ПрименениеКредитныхПрограмм.ГодПроизводства = &ГодПроизводства";
		Список.Параметры.УстановитьЗначениеПараметра("Модель", Параметры.Модель);
		Список.Параметры.УстановитьЗначениеПараметра("Версия", Параметры.Версия);
		Список.Параметры.УстановитьЗначениеПараметра("ГодПроизводства", Параметры.ГодПроизводства);
		
	КонецЕсли;
	
КонецПроцедуры
