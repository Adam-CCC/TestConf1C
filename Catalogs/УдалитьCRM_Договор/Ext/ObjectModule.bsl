Процедура ПересчитатьНДС(тСумма, тСуммаНДС)
	Если ЗначениеЗаполнено(СтавкаНДС) Тогда 
		ПроцентНДС = СтавкаНДС.Ставка / 100;
	Иначе
		ПроцентНДС = 0;
	КонецЕсли;
	тСуммаНДС = тСумма - тСумма / (1 + ПроцентНДС);
КонецПроцедуры

Функция ПолучитьИдентификаторВерсии()
	
	Если Не ЗначениеЗаполнено(Модель) И Не ЗначениеЗаполнено(Версия) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	AOC_КомплектацииСрезПоследних.Идентификатор
	|ИЗ
	|	РегистрСведений.AOC_Комплектации.СрезПоследних(&ДатаДоговора, ) КАК AOC_КомплектацииСрезПоследних
	|ГДЕ
	|	AOC_КомплектацииСрезПоследних.МодельСпр = &Модель
	|	И AOC_КомплектацииСрезПоследних.ВариантКомплектацииСпр = &Версия";
	Запрос.УстановитьПараметр("ДатаДоговора", Дата);
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("Версия", Версия);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Идентификатор;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции


Функция НайтиСоздатьАвтомобильПоВину(ДанныеПоАвтомобилю) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Автомобили.Ссылка
	|ИЗ
	|	Справочник.Автомобили КАК Автомобили
	|ГДЕ
	|	Автомобили.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN", ДанныеПоАвтомобилю.VIN);
	Рез = Запрос.Выполнить();
	Выгрузка = Рез.Выгрузить();
	
	Если Не Рез.Пустой() Тогда
		НовыйАвтомобиль = Выгрузка[0].Ссылка;
	Иначе 
		НовыйАвтомобиль = Справочники.Автомобили.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НовыйАвтомобиль, ДанныеПоАвтомобилю);
		НовыйАвтомобиль.VIN = VIN;
		НовыйАвтомобиль.Наименование = "" + ДанныеПоАвтомобилю.Модель + ", " + ДанныеПоАвтомобилю.Цвет + ", VIN: " + ДанныеПоАвтомобилю.VIN;
		НовыйАвтомобиль.ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
		Если Не Лев(СокрЛП(Метаданные.Версия),1)="4" Тогда
			НовыйАвтомобиль.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ВсегдаНеВключатьВПрайсЛист;
		КонецЕсли;
		НовыйАвтомобиль.УстановитьНовыйКод();
		НовыйАвтомобиль.Модель = ДанныеПоАвтомобилю.Модель;
		НовыйАвтомобиль.ВариантКомплектации = Версия;
		НовыйАвтомобиль.Цвет = Цвет;
		НовыйАвтомобиль.Записать();
	КонецЕсли;
	
	Возврат НовыйАвтомобиль.Ссылка;
	
КонецФункции

Процедура ПриЗаписи(Отказ)
	
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	СтатусРезервирования = ДилерскийЦентр.СтатусДоговораРезервированияАвтомобиля;
	
	//Попытка движения по регистрам контрактования автомобиля
	//В будущем договор будет один и архитектура упростится
		
	//Найдем запись по этому объекту
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ *
	               |ИЗ
	               |	РегистрСведений.Renault_ЗаконтрактованныеАвтомобили КАК Renault_ЗаконтрактованныеАвтомобили
	               |ГДЕ
	               |	Renault_ЗаконтрактованныеАвтомобили.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Запись = РегистрыСведений.Renault_ЗаконтрактованныеАвтомобили.СоздатьМенеджерЗаписи();
	Если Выборка.Следующий() Тогда		
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
	КонецЕсли;
	
	//Перезаполним ее
	Запись.VIN = VIN;
	Запись.Автомобиль = Автомобиль;
	Запись.РабочийЛист = IDK;
	Запись.Объект = Ссылка;		
	Запись.Период = ТекущаяДата();
	
	ЕстьРезерв = Ложь;
	
	Если Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан
		ИЛИ Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.НаРасторжение Тогда
	    ЕстьРезерв = Истина;
	
	ИначеЕсли Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.НаОформление
			И СтатусРезервирования = 1 Тогда
		ЕстьРезерв = Истина;
		
	ИначеЕсли Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Оформлен
			И СтатусРезервирования >= 1 Тогда
		ЕстьРезерв = Истина;
		
	КонецЕсли;
	
	Если ПометкаУдаления ИЛИ Не ЗначениеЗаполнено(Автомобиль) Тогда
		ЕстьРезерв = Ложь;
	КонецЕсли;
	
	Если ЕстьРезерв Тогда
		
		//Проверим возможность записи
		//1) Наличие других контрактов
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Renault_ЗаконтрактованныеАвтомобили.Период,
		               |	Renault_ЗаконтрактованныеАвтомобили.VIN,
		               |	Renault_ЗаконтрактованныеАвтомобили.Автомобиль,
		               |	Renault_ЗаконтрактованныеАвтомобили.РабочийЛист,
		               |	Renault_ЗаконтрактованныеАвтомобили.Объект
		               |ИЗ
		               |	РегистрСведений.Renault_ЗаконтрактованныеАвтомобили КАК Renault_ЗаконтрактованныеАвтомобили
		               |ГДЕ
		               |	Renault_ЗаконтрактованныеАвтомобили.РабочийЛист <> &РабочийЛист
		               |	И Renault_ЗаконтрактованныеАвтомобили.Автомобиль = &Автомобиль";
		Запрос.УстановитьПараметр("РабочийЛист", IDK);
		Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Отказ = Истина;
			#Если НаКлиенте Тогда
				Сообщить("Автомобиль законтрактован под другого клиента - рабочий лист №" + Строка(Выборка.РабочийЛист));
			#КонецЕсли
			Возврат;
		КонецЕсли;
		
		//2) Наличие отметки "не для продажи"
		ЗаписьДопИнфо = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
		ЗаписьДопИнфо.Автомобиль = Автомобиль;
		ЗаписьДопИнфо.Прочитать();
		Если ЗаписьДопИнфо.Выбран() И ЗаписьДопИнфо.НеДляПродажи = Истина Тогда
			Отказ = Истина;
			#Если НаКлиенте Тогда
				Сообщить("Автомобиль отмечен руководителем как недоступный для продажи");
			#КонецЕсли
			Возврат;
		КонецЕсли;	
			
		//3) Наличие утвержденного резерва под другой рабочий лист
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Renault_УтвержденныеРезервы.Регистратор,
		               |	Renault_УтвержденныеРезервы.НомерСтроки,
		               |	Renault_УтвержденныеРезервы.Активность,
		               |	Renault_УтвержденныеРезервы.VIN,
		               |	Renault_УтвержденныеРезервы.Автомобиль,
		               |	Renault_УтвержденныеРезервы.Менеджер,
		               |	Renault_УтвержденныеРезервы.Комментарий,
		               |	Renault_УтвержденныеРезервы.Автор,
		               |	Renault_УтвержденныеРезервы.Контролер,
		               |	Renault_УтвержденныеРезервы.РабочийЛист,
		               |	Renault_УтвержденныеРезервы.SedreNum,
		               |	Renault_УтвержденныеРезервы.Клиент
		               |ИЗ
		               |	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
		               |ГДЕ
		               |	Renault_УтвержденныеРезервы.Автомобиль = &Автомобиль
		               |	И Renault_УтвержденныеРезервы.РабочийЛист <> &РабочийЛист";
		Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
		Запрос.УстановитьПараметр("РабочийЛист", IDK);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Отказ = Истина;
			#Если НаКлиенте Тогда
				Сообщить("Автомобиль зарезервирован под клиента " + Строка(Выборка.Клиент) + " менеджером " + Строка(Выборка.Менеджер));
			#КонецЕсли
			Возврат;
		КонецЕсли;
		
		//Если ограничений нет - можно проводить
		Попытка
			Запись.Записать();
			
			//Если провели - нужно снять резервы (резервирование автомобилей)
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Renault_УтвержденныеРезервы.Регистратор
			               |ИЗ
			               |	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
			               |ГДЕ
			               |	Renault_УтвержденныеРезервы.Автомобиль = &Автомобиль
			               |	И Renault_УтвержденныеРезервы.РабочийЛист = &РабочийЛист";
			Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
			Запрос.УстановитьПараметр("РабочийЛист", IDK);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ДокРезервОбъект = Выборка.Регистратор.ПолучитьОбъект();
				ДокРезервОбъект.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервСнят;
				ДокРезервОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;	
				
		Исключение
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		
	Иначе
		
		Если Запись.Выбран() Тогда
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.Удалить();
		КонецЕсли;
		
	КонецЕсли;
	
	//Запишем данные в регистр по заказам в производство
	
	Запись = РегистрыСведений.Renault_ЗаказыВПроизводствоПодКлиентов.СоздатьМенеджерЗаписи();	
			
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.Renault_ЗаказыВПроизводствоПодКлиентов КАК Renault_ЗаказыВПроизводствоПодКлиентов
	               |ГДЕ
	               |	Renault_ЗаказыВПроизводствоПодКлиентов.Договор = &Договор";
	Запрос.УстановитьПараметр("Договор", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
	КонецЕсли;
	
	Запись.Прочитать();
	
	Если (Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан ИЛИ Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.НаРасторжение)
			И ЗаказВПроизводство И НЕ ПометкаУдаления Тогда 
					
		Запись.Договор = Ссылка;
		Запись.РабочийЛист = IDK;
		ЗаполнитьЗначенияСвойств(Запись, ЭтотОбъект);
		Запись.Записать();
		
	Иначе
		
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
		
	КонецЕсли;	
	
	//Воронка
	ОбновитьВоронкуПродаж();
	
КонецПроцедуры

Процедура ОбновитьВоронкуПродаж()
	
	Если ВидДоговора = Перечисления.CRM_ВидыДоговоров.Аванс Тогда
		
		Если Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан
				ИЛИ Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.НаРасторжение Тогда
			Renault_CRM.Воронка_ПредварительныйКонтракт_Установить(IDK, Ссылка, Дата);
		Иначе
			Renault_CRM.Воронка_ПредварительныйКонтракт_Снять(IDK, Ссылка);
		КонецЕсли;
		
		Если Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Расторгнут Тогда
			Renault_CRM.Воронка_РасторжениеДоговора_Установить(IDK, Ссылка, Дата);
		Иначе
			Renault_CRM.Воронка_РасторжениеДоговора_Снять(IDK, Ссылка);
		КонецЕсли;
		
	ИначеЕсли ВидДоговора = Перечисления.CRM_ВидыДоговоров.ДКП Тогда
		
		Если Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан 
				ИЛИ Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.НаРасторжение Тогда
			Renault_CRM.Воронка_ДКП_Установить(IDK, Ссылка, Дата);
		Иначе
			Renault_CRM.Воронка_ДКП_Снять(IDK, Ссылка);
		КонецЕсли;
		
		Если Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Расторгнут Тогда
			Renault_CRM.Воронка_РасторжениеДКП_Установить(IDK, Ссылка, Дата);
		Иначе
			Renault_CRM.Воронка_РасторжениеДКП_Снять(IDK, Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьЦенуРОП()Экспорт
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	CRM_ДополнительнаяИнформацияПоАвтомобилям.ЦенаПродажиРОП
		                      |ИЗ
		                      |	РегистрСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям КАК CRM_ДополнительнаяИнформацияПоАвтомобилям
		                      |ГДЕ
		                      |	CRM_ДополнительнаяИнформацияПоАвтомобилям.Автомобиль = &Автомобиль");
		Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.ЦенаПродажиРОП;
		Иначе
			Возврат  0;
		КонецЕсли;
		
	Иначе
		Возврат 0;
	КонецЕсли;
	

КонецФункции

Процедура ПередЗаписью(Отказ)
	
	//Временно
	//Снимаем галку "Заказ в производство" для договоров без данных (для дилеров, которые не работают по процессу)
	Если Не ЗначениеЗаполнено(Модель) ИЛИ Не ЗначениеЗаполнено(Версия) ИЛИ Не ЗначениеЗаполнено(Цвет) Тогда
		ЗаказВПроизводство = Ложь;
	КонецЕсли;	
		
	
КонецПроцедуры
