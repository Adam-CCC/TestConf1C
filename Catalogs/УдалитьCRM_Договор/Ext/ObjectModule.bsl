		Дата = ТекущаяДата();
		ЗаявкаНаТрейдИн = Выборка.ЗаявкаНаТрейдИн;
		ЗаявкаНаКредит = Выборка.ЗаявкаНаКредит;
        ЗаявкаНаСтраховку = Выборка.ЗаявкаНаСтраховку;
		ЗагрузитьЗаявкуНаТрейдИн();
		ЗагрузитьЗаявкуНаКредит();
		ЗагрузитьЗаявкуНаГарантию();
		ЗагрузитьЗаявкуНаОборудование();
		ЗагрузитьЗаявкунаСтраховку();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭкспVINПриИзменении()Экспорт
	
	Автомобиль = Справочники.Автомобили.НайтиПоРеквизиту("VIN", VIN);
	ЭкспАвтомобильПриИзменении();
	
КонецПроцедуры

Процедура ЭкспАвтомобильПриИзменении() Экспорт
	
	Если ЗначениеЗаполнено(Автомобиль)Тогда
		
		VIN = Автомобиль.VIN;
		ЗаписьСостояниеАвтомобилейПроизводителя = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
		ЗаписьСостояниеАвтомобилейПроизводителя.VIN = VIN;
		ЗаписьСостояниеАвтомобилейПроизводителя.Прочитать();
		
		Если ЗаписьСостояниеАвтомобилейПроизводителя.Выбран() Тогда
		
			Модель = ЗаписьСостояниеАвтомобилейПроизводителя.Модель;
			Версия = ЗаписьСостояниеАвтомобилейПроизводителя.Версия;
			Цвет = ЗаписьСостояниеАвтомобилейПроизводителя.Цвет;
			
		Иначе
			
			Модель = Автомобиль.Модель;
			Версия = Автомобиль.ВариантКомплектации;
			Цвет = Автомобиль.Цвет;
			
		КонецЕсли;
		
		ОбновитьСписокДополнительныхОпций();
		ОбновитьСписокДополнительныхОпцийДилера();
				
		Если ЗаписьСостояниеАвтомобилейПроизводителя.Выбран() Тогда
			Если ЗначениеЗаполнено(Автомобиль) Или ЗначениеЗаполнено(VIN) Тогда
				ОпцииАвто = Renault_CRM.ПолучитьТаблицуОпцийПоВин(?(ЗначениеЗаполнено(Автомобиль),Автомобиль.VIN,VIN),"Ссылка КАК Опция");
				Для Каждого Стр Из ДопОпции Цикл
					
					Если ОпцииАвто.Найти(Стр.Опция) <> Неопределено Тогда
						Стр.Выбран = Истина;
					Иначе
						Стр.Выбран = Ложь;
					КонецЕсли;
					
				КонецЦикла;

			Иначе
				МассивПодстрок = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(ЗаписьСостояниеАвтомобилейПроизводителя.OPTIONS, " ");
				
				Для Каждого Стр Из ДопОпции Цикл
					
					Если МассивПодстрок.Найти(СокрЛП(Стр.Код)) <> Неопределено Тогда
						Стр.Выбран = Истина;
					Иначе
						Стр.Выбран = Ложь;
					КонецЕсли;
					
				КонецЦикла;

			КонецЕсли;
			
						
		КонецЕсли;
		
		//Заполним данные по ПТС	
		ПТС = ЗаписьСостояниеАвтомобилейПроизводителя.PTS_SERIE + " " + ЗаписьСостояниеАвтомобилейПроизводителя.PTS_NUM;
		МаркаМодельПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ModelTS;
		ТипПТС = ЗаписьСостояниеАвтомобилейПроизводителя.TypeTS;
		КатегорияПТС = ЗаписьСостояниеАвтомобилейПроизводителя.CategTS;
		ГодИзготовленияПТС = ЗаписьСостояниеАвтомобилейПроизводителя.YEAR;
		НомерДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ENGINE_NUM;
		НомерШассиПТС = ЗаписьСостояниеАвтомобилейПроизводителя.Shassi;
		НомерКузоваПТС = ЗаписьСостояниеАвтомобилейПроизводителя.Kuzov;
		ЦветКузоваПТС = ЗаписьСостояниеАвтомобилейПроизводителя.COLOR_PTS;
		РазрешеннаяМаксимальнаяМассаПТС = ЗаписьСостояниеАвтомобилейПроизводителя.MaxMass;
		МассаБезНагрузкиПТС = ЗаписьСостояниеАвтомобилейПроизводителя.MinMass;
		МощностьДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.PowerLS;
		РабочийОбъемДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.VolumeEngine;
		ТипДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.TypeEngine;
		ЭкологическийКлассДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.EcoClass;
		ОрганизацияИзготовительПТС = ЗаписьСостояниеАвтомобилейПроизводителя.NaimProiz;
		ОдобрениеТипаТСПТС = ЗаписьСостояниеАвтомобилейПроизводителя.APPROV_STRING; 		
		ДатаПТС = ЗаписьСостояниеАвтомобилейПроизводителя.DATE_PTS;
		МодельДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ENGINE_MODEL;
		
	КонецЕсли;
	
	ЗаполнитьЦенуДоставкиПоУмолчанию();
	ЗаполнитьЦенуБазыПоТарифу();
	ПересчитатьСтоимостьДопОпций();
	ПересчитатьСтоимостьОпцийДилера();
	//ПересчитатьСуммуДоговора();
	
КонецПроцедуры

Процедура ЗаполнитьЦенуДоставкиПоУмолчанию()
	ДилерскийЦентр = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);	
	СуммаДоставки = ДилерскийЦентр.СтоимостьДоставкиПоУмолчанию;
		
КонецПроцедуры

Процедура ЗаполнитьЦенуБазыПоТарифу()
	
	СтоимостьБазовойКомплектации = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", Версия);
	Запрос.УстановитьПараметр("ТекДата", Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	AOC_КомплектацииСрезПоследних.ЦенаКлиентская
	|ИЗ
	|	РегистрСведений.AOC_Комплектации.СрезПоследних(&ТекДата, ) КАК AOC_КомплектацииСрезПоследних
	|ГДЕ
	|	AOC_КомплектацииСрезПоследних.МодельСпр = &Модель
	|	И AOC_КомплектацииСрезПоследних.ВариантКомплектацииСпр = &ВариантКомплектации";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтоимостьБазовойКомплектации = Выборка.ЦенаКлиентская;
	КонецЕсли;
	
	ПересчитатьНДС(СтоимостьБазовойКомплектации, СтоимостьБазовойКомплектацииНДС);
	ПересчитатьСуммуДоговора();
	
КонецПроцедуры

Процедура ОбновитьСписокДополнительныхОпций()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", ПолучитьИдентификаторВерсии());
	Запрос.УстановитьПараметр("УжеВыбрано", ДопОпции.Выгрузить());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УжеВыбрано.Выбран,
	|	УжеВыбрано.Опция
	|ПОМЕСТИТЬ ВТ_УжеВыбрано
	|ИЗ
	|	&УжеВыбрано КАК УжеВыбрано
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АОС_Опции.ОпцияСпр,
	|	АОС_Опции.ЦенаКлиентская,
	|	АОС_Опции.КодОпции,
	|	ВЫРАЗИТЬ(АОС_Опции.ОпцияСпр.НаименованиеПолное КАК СТРОКА(500)) КАК ДопОпцииНаименование
	|ПОМЕСТИТЬ ВТ_Опции
	|ИЗ
	|	РегистрСведений.AOC_Опции КАК АОС_Опции
	|ГДЕ
	|	АОС_Опции.Базовая = ЛОЖЬ
	|	И АОС_Опции.Идентификатор = &Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Опции.ОпцияСпр КАК Опция,
	|	ВТ_Опции.ЦенаКлиентская КАК Цена,
	|	ЕСТЬNULL(ВТ_УжеВыбрано.Выбран, ЛОЖЬ) КАК Выбран,
	|	ВТ_Опции.КодОпции КАК Код,
	|	ВТ_Опции.ДопОпцииНаименование
	|ИЗ
	|	ВТ_Опции КАК ВТ_Опции
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УжеВыбрано КАК ВТ_УжеВыбрано
	|		ПО ВТ_Опции.ОпцияСпр = ВТ_УжеВыбрано.Опция";
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ДопОпции.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

Процедура ОбновитьСписокДополнительныхОпцийДилера()
	
	ОпцииДилера.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КомплектацияАвтомобилей.Номенклатура КАК Номенклатура,
	//|	КомплектацияАвтомобилей.Номенклатура.Наименование КАК ОпцияНаименование,
	|	СУММА(КомплектацияАвтомобилей.Количество) КАК Количество,
	|	СУММА(КомплектацияАвтомобилей.СуммаПродажи) КАК Цена
	|ИЗ
	|	РегистрНакопления.КомплектацияАвтомобилей КАК КомплектацияАвтомобилей
	|ГДЕ
	|	КомплектацияАвтомобилей.Автомобиль = &Автомобиль И 
	|	(КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ВводОстатковАвтомобилей ИЛИ
	|	КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ЗаказНаряд ИЛИ
	|	КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ИнвентаризацияАвтомобилей)
	//|	КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ПоступлениеАвтомобилей)
	|	И 
	|	КомплектацияАвтомобилей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|СГРУППИРОВАТЬ ПО
	|	КомплектацияАвтомобилей.Автомобиль,
	|	КомплектацияАвтомобилей.Номенклатура
	|ИМЕЮЩИЕ 
	|	СУММА(КомплектацияАвтомобилей.Количество)<>0";
	//|УПОРЯДОЧИТЬ ПО
	//|	ОпцияНаименование";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОпцииДилера.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
	КонецЦикла;
	//ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	//ОпцииДилера.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

