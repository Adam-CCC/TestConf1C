Процедура ЗагрузитьЗаявкуНаОборудование()
	
	Если ЗначениеЗаполнено(ЗаявкаНаОборудование) тогда
		ОпцииДилера.Очистить();

		Для Каждого Оборудование Из ЗаявкаНаОборудование.ДопОпции Цикл
			Если Оборудование.Выбрана Тогда
				ТекОпция = Оборудование.ПсевдоОпция;
				ТекКоличество = Оборудование.ПсевдоКоличество;
				ТекСумма = оборудование.ПсевдоСумма;
				ТекЦена = Оборудование.Цена;
				Если ЗначениеЗаполнено(Оборудование.Опция) Тогда
					ТекОпция  = Оборудование.Опция;
					ТекКоличество = Оборудование.Количество;
					ТекСумма = оборудование.Сумма;
				КонецЕсли;
				НовСтрока  = ОпцииДилера.Добавить();
				НовСтрока.Номенклатура = ТекОпция;
				НовСтрока.Количество = ТекКоличество;
				НовСтрока.Сумма = ТекСумма;
				НовСтрока.Цена = ТекЦена;
			КонецЕсли;

			 
		КонецЦикла;
    КонецЕсли;
	
КонецПроцедуры


