
Функция ПолучитьДанныеПечати(знач МассивДокументов, знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, ПолучитьДанныеОбъекта(ОбъектСсылка, ИмяМакета));
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ОписаниеОбластей.Вставить(ИмяМакета, ПолучитьОписаниеОбластейМакетаОфисногоДокумента());
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие;
	
	Для Каждого ИмяМакета Из МассивИменМакетов Цикл
		Если ИмяМакета = "ПФ_DOC_ДоговорНаАванс_ФизЛицо" Тогда
			//ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.ПолучитьМакет("Справочник.CRM_Договор.ПФ_DOC_ДоговорНаАванс_ФизЛицо"));
			//ТипыМакетов.Вставить(ИмяМакета, "DOC");
		ИначеЕсли ИмяМакета = "ПФ_DOC_ДоговорНаАванс_Шаблон" Тогда
			//ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.ПолучитьМакет("Справочник.CRM_Договор.ПФ_DOC_ДоговорНаАванс_Шаблон"));
			//ТипыМакетов.Вставить(ИмяМакета, "DOC");
		Иначе
			//ДвоичныеДанныеМакетов.Вставить(ИмяМакета, УправлениеПечатью.ПолучитьМакет("Договор"));
			//ТипыМакетов.Вставить(ИмяМакета, "DOC");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Данные, Макеты",
							ДанныеПоВсемОбъектам,
							Новый Структура("ОписаниеОбластей, ТипыМакетов, ДвоичныеДанныеМакетов",
											ОписаниеОбластей,
											ТипыМакетов,
											ДвоичныеДанныеМакетов));
	
КонецФункции

Функция ПолучитьДанныеОбъекта(СсылкаНаОбъект, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_Договор.Ссылка,
	               |	CRM_Договор.Дата,
	               |	CRM_Договор.Статус,
	               |	CRM_Договор.НомерДоговора,
	               |	CRM_Договор.Клиент,
	               |	CRM_Договор.Автомобиль,
	               |	CRM_Договор.Сумма,
	               |	CRM_Договор.Клиент.Наименование КАК Наименование,
	               |	CRM_Договор.Клиент.НаименованиеПолное КАК НаименованиеПолное,
	               |	CRM_Договор.Клиент.ФормаСобственности КАК ФормаСобственности,
	               |	CRM_Договор.Клиент.ДатаРождения КАК ДатаРождения,
	               |	CRM_Договор.Клиент.Пол КАК Пол,
	               |	CRM_Договор.Клиент.Фамилия КАК Фамилия,
	               |	CRM_Договор.Клиент.Имя КАК Имя,
	               |	CRM_Договор.Клиент.Отчество КАК Отчество,
	               |	КонтактнаяИнформация_АдресФактический.Представление КАК АдресФактический,
				   |	КонтактнаяИнформация_АдресЮридический.Представление КАК АдресЮридический,
	               |	КонтактнаяИнформация_Телефон.Представление КАК ТелефонСотовый,
	               |	КонтактнаяИнформация_Email.Представление КАК АдресЭлектроннойПочтыДомашний,
	               |	CRM_Договор.СуммаНДС КАК СуммаНДС,
	               |	CRM_Договор.СтоимостьПродленнойГарантии КАК СуммаПродленнойГарантии,
	               |	CRM_Договор.СтоимостьПродленнойГарантииНДС КАК СуммаПродленнойГарантииНДС,
	               |	CRM_Договор.Модель,
	               |	CRM_Договор.Версия,
	               |	CRM_Договор.Цвет,
	               |	CRM_Договор.VIN,
	               |	CRM_Договор.ГодВыпуска,
	               |	ПодтверждающиеДокументы_Паспорт.Серия КАК ПаспортСерия,
	               |	ПодтверждающиеДокументы_Паспорт.Номер КАК ПаспортНомер,
	               |	ПодтверждающиеДокументы_Паспорт.ДатаВыдачи КАК ПаспортВыданДата,
	               |	ПодтверждающиеДокументы_Паспорт.КемВыдан КАК ПаспортВыданКем,
	               |	CRM_Договор.ПродленнаяГарантия,
	               |	CRM_Договор.СуммаАванса,
	               |	CRM_Договор.СуммаАвансаНДС,
	               |	CRM_Договор.СтоимостьБазовойКомплектации,
	               |	CRM_Договор.СтоимостьБазовойКомплектацииНДС,
	               |	CRM_Договор.СтоимостьДопОпций,
	               |	CRM_Договор.СтоимостьОпцийДилера,
	               |	CRM_Договор.СтоимостьДопОпцийНДС,
	               |	CRM_Договор.СтоимостьОпцийДилераНДС,
	               |	CRM_Договор.СтоимостьСтраховки,
	               |	CRM_Договор.СтоимостьСтраховкиНДС,
	               |	CRM_Договор.СуммаКредита,
	               |	CRM_Договор.СуммаКредитаНДС,
	               |	CRM_Договор.СуммаТрейдИн,
	               |	CRM_Договор.СуммаТрейдИнНДС,
	               |	CRM_Договор.ВидСтраховойПрограммы,
	               |	CRM_Договор.СтраховаяКомпания,
	               |	CRM_Договор.КредитнаяПрограмма,
	               |	CRM_Договор.ТрейдИнМодель,
	               |	CRM_КлиентскиеДанные.ПодписантВЛице,
	               |	CRM_КлиентскиеДанные.ПодписантНаОсновании,
	               |	CRM_КлиентскиеДанные.ПодписантПодпись,
	               |	CRM_КлиентскиеДанные.ПодписантДолжность,
	               |	БанковскиеСчета.НомерСчета КАК Счет,
	               |	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
	               |	БанковскиеСчета.Банк.Код КАК БИК,
	               |	CRM_Договор.ДопОпции.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		Выбран,
	               |		Опция,
	               |		Цена,
	               |		Код
	               |	),
	               |	CRM_Договор.ОпцииДилера.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		Номенклатура,
	               |		Цена,
	               |		Количество,
	               |		Сумма
	               |	),
	               |	CRM_Договор.Организация,
	               |	CRM_Договор.ВидДоговора,
	               |	CRM_Договор.СтавкаНДС,
	               |	CRM_Договор.БанкПредоставляющийКредит,
	               |	CRM_Договор.Дата КАК ДатаДоговора,
	               |	CRM_Договор.Клиент.НаименованиеПолное КАК НаименованиеОрганизацииКлиента,
	               |	CRM_Договор.Клиент.ИНН КАК ИНН,
	               |	CRM_Договор.Клиент.КПП КАК КПП,
	               |	CRM_Договор.ДилерПодписантВЛице,
	               |	CRM_Договор.ДилерПодписантНаОсновании,
	               |	CRM_Договор.ДилерПодписантПодпись,
	               |	CRM_Договор.ДилерПодписантДолжность,
	               |	CRM_Договор.МаркаМодельПТС,
	               |	CRM_Договор.ТипПТС,
	               |	CRM_Договор.КатегорияПТС,
	               |	CRM_Договор.ГодИзготовленияПТС,
	               |	CRM_Договор.НомерДвигателяПТС,
	               |	CRM_Договор.НомерШассиПТС,
	               |	CRM_Договор.НомерКузоваПТС,
	               |	CRM_Договор.ЦветКузоваПТС,
	               |	CRM_Договор.МощностьДвигателяПТС,
	               |	CRM_Договор.РабочийОбъемДвигателяПТС,
	               |	CRM_Договор.ТипДвигателяПТС,
	               |	CRM_Договор.ЭкологическийКлассДвигателяПТС,
	               |	CRM_Договор.ПТС,
	               |	CRM_Договор.ОрганизацияИзготовительПТС,
	               |	CRM_Договор.ГарантияПТС,
	               |	CRM_Договор.РазрешеннаяМаксимальнаяМассаПТС,
	               |	CRM_Договор.МассаБезНагрузкиПТС,
	               |	CRM_Договор.ОдобрениеТипаТСПТС,
	               |	БанковскиеСчета.Банк.Наименование КАК Банк,
	               |	ЕСТЬNULL(CRM_Договор.Сумма, 0) - ЕСТЬNULL(CRM_Договор.СуммаАванса, 0) КАК СуммаЗаВычетомАванса,
	               |	CRM_Договор.Клиент.КодПоОКПО КАК КодПоОКПО,
	               |	CRM_Договор.Клиент.КодИМНС КАК КодИМНС,
	               |	CRM_Договор.СуммаСкидки,
	               |	CRM_Договор.СуммаДоставки,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.OPTIONS КАК СоставДопОпций,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.VERSION КАК КодВерсии,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.MODEL КАК КодМодели,
	               |	CRM_Договор.МодельДвигателяПТС,
	               |	CRM_Договор.ДатаПТС,
	               |	CRM_Договор.АдресИзготовителяПТС,
				   |	CRM_Договор.Организация.НаименованиеПолное КАК ДилерНаименованиеПолное,
				   |	CRM_Договор.Организация.ИНН КАК ДилерИНН,
				   |	CRM_Договор.Организация.КПП КАК ДилерКПП,
				   |	CRM_Договор.Организация.ОсновнойБанковскийСчет КАК ДилерСчет,
				   |	CRM_Договор.Организация.ОсновнойБанковскийСчет.Банк.КоррСчет КАК ДилерКоррСчет,
				   |	CRM_Договор.Организация.ОсновнойБанковскийСчет.Банк КАК ДилерБанк,
				   |	CRM_Договор.Организация.ОсновнойБанковскийСчет.Банк.Код КАК ДилерБИК,
				   |	КонтактнаяИнформацияДилер_АдресЮридический.Представление КАК ДилерАдресЮридический,
				   |	КонтактнаяИнформацияДилер_АдресФактический.Представление КАК ДилерАдресФактический,
				   |	КонтактнаяИнформацияДилер_АдресФактический.Поле4 КАК ДилерГород,
				   |	КонтактнаяИнформацияДилер_Телефон.Представление КАК ДилерТелефон,
				   |	CRM_Договор.ЖелаемаяДатаДоставки КАК СрокПоставки
	               |ИЗ
	               |	Справочник.CRM_Договор КАК CRM_Договор
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанные
	               |		ПО CRM_Договор.Клиент = CRM_КлиентскиеДанные.Клиент
				   |
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_Телефон
	               |		ПО CRM_Договор.Клиент = КонтактнаяИнформация_Телефон.Объект
	               |			И (КонтактнаяИнформация_Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	               |			И (КонтактнаяИнформация_Телефон.ЗначениеПоУмолчанию = ИСТИНА)
				   |
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_АдресФактический
	               |		ПО CRM_Договор.Клиент = КонтактнаяИнформация_АдресФактический.Объект
	               |			И (КонтактнаяИнформация_АдресФактический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический))
				   |
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_АдресЮридический
	               |		ПО CRM_Договор.Клиент = КонтактнаяИнформация_АдресЮридический.Объект
	               |			И (КонтактнаяИнформация_АдресЮридический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
				   |
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияДилер_АдресФактический
	               |		ПО CRM_Договор.Организация = КонтактнаяИнформацияДилер_АдресФактический.Объект
	               |			И (КонтактнаяИнформацияДилер_АдресФактический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический))
				   |
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияДилер_АдресЮридический
	               |		ПО CRM_Договор.Организация = КонтактнаяИнформацияДилер_АдресЮридический.Объект
	               |			И (КонтактнаяИнформацияДилер_АдресЮридический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
				   |
				   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияДилер_Телефон
	               |		ПО CRM_Договор.Организация = КонтактнаяИнформацияДилер_Телефон.Объект
	               |			И (КонтактнаяИнформацияДилер_Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	               |			И (КонтактнаяИнформацияДилер_Телефон.ЗначениеПоУмолчанию = ИСТИНА)
				   |
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_Email
	               |		ПО CRM_Договор.Клиент = КонтактнаяИнформация_Email.Объект
	               |			И (КонтактнаяИнформация_Email.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний))
				   |
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	               |		ПО CRM_Договор.Клиент.ОсновнойБанковскийСчет = БанковскиеСчета.Ссылка
				   |
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы_Паспорт
	               |		ПО CRM_Договор.Клиент = ПодтверждающиеДокументы_Паспорт.Владелец
	               |			И (ПодтверждающиеДокументы_Паспорт.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт))
				   |
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	               |		ПО CRM_Договор.Автомобиль = CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль
	               |			И (CRM_Договор.VIN <> """")
	               |ГДЕ
	               |	CRM_Договор.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("Сотрудник", ПараметрыСеанса.Пользователь.Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ВалютаРубли = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
		ВыборкаТТХИБазовыеОпции = ПолучитьВыборкуПоТТХИБазовымОпциям(Выборка.Модель, Выборка.Версия);
		
		ДанныеОбъекта = Новый Структура;
		
		ДанныеОбъекта.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеОбъекта.Вставить("Дата", Формат(Выборка.Дата, "ДФ='дд ММММ гггг'"));
		
		ДанныеОбъекта.Вставить("Статус", Выборка.Статус);
		ДанныеОбъекта.Вставить("НомерДоговора", ПолучитьНомерПечать(Выборка.НомерДоговора));
		ДанныеОбъекта.Вставить("ВидДоговора", Выборка.ВидДоговора);
		ДанныеОбъекта.Вставить("ДатаДоговора", Формат(Выборка.ДатаДоговора,"ДЛФ=ДД"));		
		ДанныеОбъекта.Вставить("СтавкаНДС", Выборка.СтавкаНДС);		
		ДанныеОбъекта.Вставить("Организация", Выборка.Организация);
		ДанныеОбъекта.Вставить("ДилерНаименованиеПолное", Выборка.ДилерНаименованиеПолное);
		ДанныеОбъекта.Вставить("ДилерИНН", Выборка.ДилерИНН);
		ДанныеОбъекта.Вставить("ДилерКПП", Выборка.ДилерКПП);
		ДанныеОбъекта.Вставить("ДилерСчет", Выборка.ДилерСчет);
		ДанныеОбъекта.Вставить("ДилерКоррСчет", Выборка.ДилерКоррСчет);
		ДанныеОбъекта.Вставить("ДилерБанк", Выборка.ДилерБанк);
		ДанныеОбъекта.Вставить("ДилерБИК", Выборка.ДилерБИК);
		ДанныеОбъекта.Вставить("ДилерТелефон", Выборка.ДилерТелефон);
		ДанныеОбъекта.Вставить("ДилерАдресЮридический", Выборка.ДилерАдресЮридический);
		ДанныеОбъекта.Вставить("ДилерАдресФактический", Выборка.ДилерАдресФактический);
