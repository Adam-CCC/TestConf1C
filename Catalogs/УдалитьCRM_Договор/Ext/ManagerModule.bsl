Процедура ПересчитатьНДС(тСумма, тСуммаНДС, СтавкаНДС)
	Если ЗначениеЗаполнено(СтавкаНДС) Тогда 
		ПроцентНДС = СтавкаНДС.Ставка / 100;
	Иначе
		ПроцентНДС = 0;
	КонецЕсли;
	тСуммаНДС = тСумма - тСумма / (1 + ПроцентНДС);
	Если тСуммаНДС <> 0 Тогда
		тСуммаНДС = Формат(тСуммаНДС, "ЧЦ=10; ЧДЦ=2");
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьНомерПечать(Номер)
	Ответ = Номер;
	ТекНомер = Номер;
	Итог = Лев(ТекНомер, 1);
	ЭтоПрефикс = Ложь;
	ПозицияПрефикса = 0;
	Нпп = 1;
	ПредИтог = "";
	Префикс = "";
	Пока  Итог <> "0" И Нпп <=СтрДлина(Номер) Цикл
		ТекНомер = Прав(ТекНомер,СтрДлина(ТекНомер) - 1);
		ПредИтог = Итог;
		Итог = Лев(ТекНомер, 1);
		//ЭтотОбъектНомер = Сред(ЭтотОбъектНомер, 2);
		ЭтоПрефикс = Истина;
		Если Не ЭтоЦифра(Итог) Тогда
			ПозицияПрефикса = Нпп-1;
		КонецЕсли;
		
		Нпп=Нпп+1;
	КонецЦикла;
	Если ЭтоПрефикс И Не ЭтоЦифра(ПредИтог) Тогда
		
		ПозицияПрефикса = Нпп-1;
	Иначе 
		ЭтоПрефикс = Ложь;
	КонецЕсли;
	Если ЭтоПрефикс И (ПозицияПрефикса > 0) Тогда
		ТекНомер = Прав(Ответ,СтрДлина(Ответ)-ПозицияПрефикса);
		Префикс = Лев(Ответ,ПозицияПрефикса);
		Итог = Лев(ТекНомер, 1);
		Пока  Итог = "0" Цикл
			ПредИтог = ТекНомер;
			ТекНомер = Прав(ТекНомер,СтрДлина(ТекНомер) - 1);
			Итог = Лев(ТекНомер, 1);
			//ЭтотОбъектНомер = Сред(ЭтотОбъектНомер, 2);
		КонецЦикла;
	ИначеЕсли  ЭтоПрефикс И (ПозицияПрефикса = 0) Тогда
		ТекНомер = Ответ;
	Иначе
		
		ТекНомер = Ответ;
		Итог = Лев(ТекНомер, 1);
		Пока  Итог = "0" Цикл
			ПредИтог = ТекНомер;
			ТекНомер = Прав(ТекНомер,СтрДлина(ТекНомер) - 1);
			Итог = Лев(ТекНомер, 1);
			//ЭтотОбъектНомер = Сред(ЭтотОбъектНомер, 2);
		КонецЦикла;

	
	КонецЕсли;
	Ответ = Префикс + ТекНомер;
	Возврат Ответ;
КонецФункции

Функция ЭтоЦифра(Слово)
	
	Цифры = "1234567890";
	Если Найти(Цифры,Слово) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина
	
КонецФункции

Функция ПолучитьВыборкуПоТТХИБазовымОпциям(Модель, ВариантКомплектации)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", ВариантКомплектации);
	Запрос.Текст = "ВЫБРАТЬ
	               |	AOC_КомплектацииСрезПоследних.Идентификатор,
	               |	AOC_КомплектацииСрезПоследних.ДвигательОбъем,
	               |	AOC_КомплектацииСрезПоследних.ДвигательТипТоплива,
	               |	AOC_КомплектацииСрезПоследних.ДвигательЛС,
	               |	AOC_КомплектацииСрезПоследних.Двигатель_кВт,
	               |	AOC_КомплектацииСрезПоследних.Двигатель_НормаЕвро,
	               |	AOC_КомплектацииСрезПоследних.МассаMax,
	               |	AOC_КомплектацииСрезПоследних.МассаMin
	               |ИЗ
	               |	РегистрСведений.AOC_Комплектации.СрезПоследних(
	               |			,
	               |			ВариантКомплектацииСпр = &ВариантКомплектации
	               |				И МодельСпр = &Модель) КАК AOC_КомплектацииСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТекущийИдентификатор = Выборка.Идентификатор;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//			   |	AOC_ОпцииСрезПоследних.НаименованиеОпции КАК Опция
	//			   |ИЗ
	//			   |	РегистрСведений.AOC_Опции.СрезПоследних КАК AOC_ОпцииСрезПоследних
	//			   |ГДЕ
	//			   |	AOC_ОпцииСрезПоследних.Идентификатор = &Идентификатор
	//			   |	И AOC_ОпцииСрезПоследних.Базовая = ИСТИНА";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	AOC_ОпцииСрезПоследних.ОпцияСпр.НаименованиеПолное КАК Опция
	               |ИЗ
	               |	РегистрСведений.AOC_Опции.СрезПоследних КАК AOC_ОпцииСрезПоследних
	               |ГДЕ
	               |	AOC_ОпцииСрезПоследних.Идентификатор = &Идентификатор
	               |	И AOC_ОпцииСрезПоследних.Базовая = ИСТИНА";

	Запрос.УстановитьПараметр("Идентификатор", ТекущийИдентификатор);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено
	Иначе
		Возврат Результат;
	КонецЕсли;

КонецФункции

Функция ПолучитьТекстДопОпции(ВыборкаОпции)

