
&НаСервере
Процедура УСтановитьДаты()
	
	для Каждого ст из Список.Отбор.Элементы Цикл
		Если Строка(Ст.ЛевоеЗначение) = "Дата" Тогда
			Если Ст.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
				Ст.ПравоеЗначение = Период.ДатаОкончания;
				Ст.Использование = Истина;
			ИначеЕсли  Ст.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
				Ст.ПравоеЗначение = Период.ДатаНачала;
				Ст.Использование = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Список.Обновить();	

КонецПроцедуры  

&НаСервере
Процедура УбратьДаты()
	для Каждого ст из Список.Отбор.Элементы Цикл
		Если Строка(Ст.ЛевоеЗначение) = "Дата" Тогда
			Если Ст.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
				Ст.Использование = Ложь;
			ИначеЕсли  Ст.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
				Ст.Использование = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	УСтановитьДаты();
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПериод(Команда)
	// Вставить содержимое обработчика.
	УбратьДаты();
КонецПроцедуры

&НаКлиенте
Процедура ОтборКЗ(Команда)
	
	ОтключитьВсеОтборыКромеДаты();
	
	Для Каждого Ст из Список.Отбор.Элементы Цикл
		
		Если Строка(Ст.ЛевоеЗначение) = "Статус" Тогда
			Ст.ПравоеЗначение = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан;
			Ст.Использование = Истина;
		КонецЕсли;
		
		Если Строка(Ст.ЛевоеЗначение) = "VIN" Тогда
			Ст.ПравоеЗначение = "";
			Ст.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Ст.Использование = Истина;
		КонецЕсли;
		
		Если Строка(Ст.ЛевоеЗначение) = "НомерКЗDistri" Тогда
			Ст.ПравоеЗначение = "";
			Ст.Использование = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	ВыделитьКнопку(Элементы.ОтборКЗ);
	
КонецПроцедуры

