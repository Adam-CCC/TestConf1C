&НаКлиенте
Процедура ОтборНаСозданиеРеализаций(Команда)
	
	ОтключитьВсеОтборыКромеДаты();
	
	Для Каждого Ст из Список.Отбор.Элементы Цикл
		Если Строка(Ст.ЛевоеЗначение) = "РеализацияАвтомобиля" Тогда
			Ст.ПравоеЗначение = Документы.РеализацияАвтомобилей.ПустаяСсылка();
			Ст.Использование = Истина;
		КонецЕсли;
		Если Строка(Ст.ЛевоеЗначение) = "Статус" Тогда
			Ст.ПравоеЗначение = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан;
			Ст.Использование = Истина;
		КонецЕсли;
		Если Строка(Ст.ЛевоеЗначение) = "ВидДоговора" Тогда
			Ст.ПравоеЗначение = Перечисления.CRM_ВидыДоговоров.ДКП;
			Ст.Использование = Истина;
		КонецЕсли;
		Если Строка(Ст.ЛевоеЗначение) = "VIN" Тогда
			Ст.ПравоеЗначение = "";
			Ст.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
			Ст.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Список.Обновить();
	ВыделитьКнопку(Элементы.ОтборНаСозданиеРеализаций);
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия= "ОбновитьРабочийЛистПослеЗаписиДоговора" Тогда	
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьКнопку(КнопкаДляВыделения)
	
	ЦветФормы = Новый Цвет(245, 242, 221);
	
	Элементы.ОтборВсе.ЦветФона = ЦветФормы;
	Элементы.ОтборНаСозданиеРеализаций.ЦветФона = ЦветФормы;
	Элементы.ОтборНаОформление.ЦветФона = ЦветФормы;
	Элементы.ОтборНаПодписание.ЦветФона = ЦветФормы;
	Элементы.ОтборЗаказВПроизводство.ЦветФона = ЦветФормы;
	Элементы.ОтборКЗ.ЦветФона = ЦветФормы;
	Элементы.ОтборНаОформлениеАванс.ЦветФона = ЦветФормы;
	
	ЦветРено = Новый Цвет(255, 182, 0);
	КнопкаДляВыделения.ЦветФона = ЦветРено;
	
КонецПроцедуры

