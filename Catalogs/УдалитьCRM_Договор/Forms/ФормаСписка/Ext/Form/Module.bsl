Процедура ОтключитьВсеОтборыКромеДаты()
	
	Для Каждого Ст из Список.Отбор.Элементы Цикл
		Если Строка(Ст.ЛевоеЗначение) <> "Дата" Тогда
			Ст.Использование = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Список.Обновить();	

КонецПроцедуры

