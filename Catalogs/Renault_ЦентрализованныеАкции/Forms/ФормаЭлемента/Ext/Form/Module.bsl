	МоделиПриАктивизацииСтроки(Элементы.Модели);
	
КонецПроцедуры

&НаСервере
Процедура НормализоватьНаСервере()
	
	Настройки = Renault_CRM.ПолучитьНастройкиЗапчастей();
	ТипЦен = Настройки.ТипЦенPCL;
	
	Для Каждого Строка ИЗ Объект.Модели Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("УИД", Строка.УИД);
		СтрокиНоменклатуры = Объект.Номенклатура.НайтиСтроки(Отбор); // находим строки с номенклатурой
		РазницаЦен = 0;
		Для Каждого СтрокаНоменклатуры ИЗ СтрокиНоменклатуры Цикл
			СтараяЦена = СтрокаНоменклатуры.PCL_БезНДС;
			Если ЗначениеЗаполнено(СтрокаНоменклатуры.Реферанс) Тогда // если есть номенклатура, то берем её цену из базы
				СтрокаНоменклатуры.PCL_БезНДС = Renault_АвтосервисОбщий.ПолучитьЦенуТоваров(СтрокаНоменклатуры.Реферанс, ТипЦен);
			КонецЕсли;
			РазницаЦен = РазницаЦен + (СтрокаНоменклатуры.PCL_БезНДС - СтараяЦена); // получаем разницу между новой и старой ценами
		КонецЦикла;
		
		Если РазницаЦен <> 0 Тогда // Вычтем из стоимости работ полученную разницу
			ОстатокДляВычета = РазницаЦен;
			СуммаРабот = 0;
			СтрокиРабот = Объект.Работы.НайтиСтроки(Отбор);
			Для Каждого СтрокаРаботы ИЗ СтрокиРабот Цикл
				СуммаРабот = СуммаРабот + СтрокаРаботы.СтоимостьРаботы;
			КонецЦикла;
			Для Каждого СтрокаРаботы ИЗ СтрокиРабот Цикл
				ВычитаемаяЧасть = РазницаЦен * СтрокаРаботы.СтоимостьРаботы / СуммаРабот;
				СтрокаРаботы.СтоимостьРаботы = СтрокаРаботы.СтоимостьРаботы - ВычитаемаяЧасть;
				УстановитьНовуюЦену(СтрокаРаботы.Работа, СтрокаРаботы.СтоимостьРаботы, ТипЦен);
				ОстатокДляВычета = ОстатокДляВычета - ВычитаемаяЧасть;
			КонецЦикла;
			СтрокаРаботы.СтоимостьРаботы = СтрокаРаботы.СтоимостьРаботы - ОстатокДляВычета;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьНовуюЦену(Авторабота, Цена, ТипЦен)
	
	ИзменениеЦен = Документы.ИзменениеЦенАвторабот.СоздатьДокумент();
	НоваяРабота = ИзменениеЦен.Автоработы.Добавить();
	НоваяРабота.Авторабота = Авторабота;
	//НоваяРабота.Нормочас = Нормочас;
	//ЦенаНормочаса = (ЦенаИтого - ЦенаСвязанных);
	НоваяРабота.Цена = Цена;
	
	ИзменениеЦен.Автор = ПараметрыСеанса.Пользователь;
	ИзменениеЦен.Организация = ПараметрыСеанса.Пользователь.Организация;
	ИзменениеЦен.ТипЦен = ТипЦен;
	ИзменениеЦен.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	ИзменениеЦен.КурсДокумента = 1;
	ИзменениеЦен.ХозОперация = Справочники.ХозОперации.УстановкаЦенАвтоработКомпании;
	ИзменениеЦен.Дата = ТекущаяДата();
	ИзменениеЦен.ДатаНачалаДействия = ТекущаяДата();
	ИзменениеЦен.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;
	ИзменениеЦен.УстановитьНовыйНомер();
	ИзменениеЦен.Записать();
	ИзменениеЦен.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураРеферансНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	АналогиИЗамены = НайтиАналогиЗамены(Элемент.Родитель.ТекущиеДанные.Реферанс);
	Если АналогиИЗамены.Количество() = 0 Тогда
		Предупреждение("По данной номенклатуре нет замен или аналогов!");
	Иначе
		Ответ = АналогиИЗамены.ВыбратьЭлемент("Выберите замену для номенклатуры");
		Если Ответ <> Неопределено Тогда
			Элемент.Родитель.ТекущиеДанные.Реферанс = Ответ.Значение;
			НоменклатураРеферансПриИзменении(Элемент);
			НоменклатураПриИзменении(Элемент.Родитель)
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиАналогиЗамены(НоменклатураСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыАналогов.ИдентификаторГруппы
	|ПОМЕСТИТЬ ВремТЗ
	|ИЗ
	|	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
	|ГДЕ
	|	ГруппыАналогов.Артикул = &Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка
	|ИЗ
	|	РегистрСведений.ГруппыАналогов КАК ГруппыАналогов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТЗ КАК ВремТЗ
	|		ПО (ВремТЗ.ИдентификаторГруппы = ГруппыАналогов.ИдентификаторГруппы)
	|			И (ГруппыАналогов.Артикул <> &Артикул)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО (Номенклатура.Артикул = ГруппыАналогов.Артикул)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Замены КАК Замены
	|		ПО (Замены.АртикулЗамены = Номенклатура.Артикул)
	|ГДЕ
	|	Замены.Артикул = &Артикул";
	Запрос.УстановитьПараметр("Артикул", НоменклатураСсылка.Артикул);
	Результат = Запрос.Выполнить().Выгрузить();
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Ссылка"));
	Возврат Список;
	
КонецФункции

