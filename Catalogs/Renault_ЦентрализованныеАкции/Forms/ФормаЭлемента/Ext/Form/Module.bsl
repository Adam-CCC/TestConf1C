
&НаКлиенте
Процедура МоделиПриАктивизацииСтроки(Элемент)
	
	Если Элементы.Модели.ТекущаяСтрока = Неопределено ИЛИ ЭтаФорма.ТолькоПросмотр Тогда
		
		Элементы.РаботыКоманднаяПанель.Доступность = ЛОЖЬ;
		Элементы.НоменклатураКоманднаяПанель.Доступность = ЛОЖЬ;
		
	Иначе
		
		Элементы.РаботыКоманднаяПанель.Доступность = Истина;
		Элементы.НоменклатураКоманднаяПанель.Доступность = Истина;
		
	КонецЕсли;
	
	СписокНоменклатура.Очистить();
	СписокРаботы.Очистить();
	СписокВариантыКомплектации.Очистить();
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Если НЕ Элемент.ТекущиеДанные.УИД = "" Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("УИД", Элемент.ТекущиеДанные.УИД);
			МассивСтрок = Объект.Номенклатура.НайтиСтроки(Отбор);
			Для Каждого Строка ИЗ МассивСтрок Цикл
				НоваяСтрока = СписокНоменклатура.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			КонецЦикла;
			МассивСтрок = Объект.Работы.НайтиСтроки(Отбор);
			Для Каждого Строка ИЗ МассивСтрок Цикл
				НоваяСтрока = СписокРаботы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			КонецЦикла;
			МассивСтрок = Объект.ВариантыКомплектации.НайтиСтроки(Отбор);
			Для Каждого Строка ИЗ МассивСтрок Цикл
				НоваяСтрока = СписокВариантыКомплектации.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				Если Строка.ГУР = -1 Тогда
					НоваяСтрока.ГУР = "Не используется";
				ИначеЕсли Строка.ГУР = 0 Тогда
					НоваяСтрока.ГУР = "Нет";
				ИначеЕсли Строка.ГУР = 1 Тогда
					НоваяСтрока.ГУР = "Да";
				КонецЕсли;
				Если Строка.АС = -1 Тогда
					НоваяСтрока.АС = "Не используется";
				ИначеЕсли Строка.АС = 0 Тогда
					НоваяСтрока.АС = "Нет";
				ИначеЕсли Строка.АС = 1 Тогда
					НоваяСтрока.АС = "Да";
				КонецЕсли;
				Если Строка.СФ = -1 Тогда
					НоваяСтрока.СФ = "Не используется";
				ИначеЕсли Строка.СФ = 0 Тогда
					НоваяСтрока.СФ = "Нет";
				ИначеЕсли Строка.СФ = 1 Тогда
					НоваяСтрока.СФ = "Да";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МоделиПриИзменении(Элемент)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Если Элемент.ТекущиеДанные.УИД = "" Тогда
			Элемент.ТекущиеДанные.УИД = Новый УникальныйИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	
	ТекущийУИД = Элементы.Модели.ТекущиеДанные.УИД;
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Если Элемент.ТекущиеДанные.УИД = "" Тогда
			Элемент.ТекущиеДанные.УИД = ТекущийУИД;
		КонецЕсли;
	КонецЕсли;
	
	ПерезаписатьСтрокиНоменклатура(ТекущийУИД);
	Элементы.Модели.ТекущиеДанные.СтоимостьВсего = ПолучитьИтогНоменклатура(ТекущийУИД) + ПолучитьИтогРаботы(ТекущийУИД);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыПриИзменении(Элемент)
	
	ТекущийУИД = Элементы.Модели.ТекущиеДанные.УИД;
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		Если Элемент.ТекущиеДанные.УИД = "" Тогда
			Элемент.ТекущиеДанные.УИД = ТекущийУИД;
		КонецЕсли;
	КонецЕсли;
	
	ПерезаписатьСтрокиРаботы(ТекущийУИД);
	Элементы.Модели.ТекущиеДанные.СтоимостьВсего = ПолучитьИтогНоменклатура(ТекущийУИД) + ПолучитьИтогРаботы(ТекущийУИД);
	
КонецПроцедуры

&НаСервере
Процедура ПерезаписатьСтрокиНоменклатура(УИД)
	
	Отбор = Новый Структура;
	Отбор.Вставить("УИД", УИД);
	Строки = Объект.Номенклатура.НайтиСтроки(Отбор);
	Для Каждого Строка ИЗ Строки Цикл
		Объект.Номенклатура.Удалить(Строка);
	КонецЦикла;
	Для Каждого Элемент ИЗ СписокНоменклатура Цикл
		НоваяСтрока = Объект.Номенклатура.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаписатьСтрокиРаботы(УИД)
	
	Отбор = Новый Структура;
	Отбор.Вставить("УИД", УИД);
	Строки = Объект.Работы.НайтиСтроки(Отбор);
	Для Каждого Строка ИЗ Строки Цикл
		Объект.Работы.Удалить(Строка);
	КонецЦикла;
	Для Каждого Элемент ИЗ СписокРаботы Цикл
		НоваяСтрока = Объект.Работы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИтогНоменклатура(ТекущийУИД)
	
	Таблица = ДанныеФормыВЗначение(СписокНоменклатура, Тип("ТаблицаЗначений"));
	Возврат Таблица.Итог("Стоимость");
	
КонецФункции

&НаСервере
Функция ПолучитьИтогРаботы(ТекущийУИД)
	
	Таблица = ДанныеФормыВЗначение(СписокРаботы, Тип("ТаблицаЗначений"));
	Если Объект.СтоимостьВключаетРаботы = Истина Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ЭтоРаботаДилера", Ложь);
		//МассивСтрок = Таблица.НайтиСтроки(Отбор);
		Результат = Таблица.Скопировать(Отбор);
		Возврат Результат.Итог("СтоимостьРаботы");
	Иначе
		Возврат Таблица.Итог("СтоимостьРаботы");
	КонецЕсли;
	
КонецФункции

