&НаКлиенте
Процедура НоменклатураРеферансПриИзменении(Элемент)

	ТекДанные = Элементы.Номенклатура.ТекущиеДанные;

	Настройки = Renault_CRM.ПолучитьНастройкиЗапчастей();
	ТипЦенPCL = Настройки.ТипЦенPCL;
	ТипЦенPNC = Настройки.ТипЦенPNC;
	Реф       = ТекДанные.Реферанс;

	ЦенаPCL = Renault_АвтосервисОбщий.ПолучитьЦенуТоваров(Реф, ТипЦенPCL);
	ЦенаPNC = Renault_АвтосервисОбщий.ПолучитьЦенуТоваров(Реф, ТипЦенPNC);

	ТекДанные.PCL_БезНДС = ЦенаPCL;
	ТекДанные.PNC_БезНДС = ЦенаPNC;
	ТекДанные.Артикул    = Реф.Артикул;
	ТекДанные.Стоимость  = ТекДанные.Количество * ТекДанные.PCL_БезНДС;

КонецПроцедуры


