&НаКлиенте
Процедура СтоимостьВключаетРаботыПриИзменении(Элемент)
	
	Для Каждого СтрокаМодель ИЗ Объект.Модели Цикл
		СтрокаМодель.СтоимостьВсего = ПолучитьИтогЗЧ(СтрокаМодель.УИД) + ПолучитьИтогРабот(СтрокаМодель.УИД);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИтогЗЧ(УИД)
	
	Отбор = Новый Структура;
	Отбор.Вставить("УИД", УИД);
	Строки = Объект.Номенклатура.Выгрузить(Отбор);
	Возврат Строки.Итог("Стоимость");
	
КонецФункции

&НаСервере
Функция ПолучитьИтогРабот(УИД)
	
	Отбор = Новый Структура;
	Отбор.Вставить("УИД", УИД);
	Строки = Объект.Работы.Выгрузить(Отбор);
	Если Объект.СтоимостьВключаетРаботы = Истина Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ЭтоРаботаДилера", Ложь);
		Результат = Строки.Скопировать(Отбор);
		Возврат Результат.Итог("СтоимостьРаботы");
	Иначе
		Возврат Строки.Итог("СтоимостьРаботы");
	КонецЕсли;
	
КонецФункции



