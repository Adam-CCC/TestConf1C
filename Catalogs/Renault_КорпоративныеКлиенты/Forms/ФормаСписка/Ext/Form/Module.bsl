&НаКлиенте
Процедура КомандаИзменить(Команда)
	
	ТекущийКлиент = Неопределено;
	Если Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаЧерновики Тогда
		ТекущиеДанные = Элементы.СписокЧерновики.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаНаСогласовании Тогда
		ТекущиеДанные = Элементы.СписокНаСогласовании.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаСогласованные Тогда
		ТекущиеДанные = Элементы.СписокСогласованные.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаНесогласованные Тогда
		ТекущиеДанные = Элементы.СписокНеСогласованные.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтрагентСсылка = ТекущиеДанные.Контрагент;
	ОткрытьКарточкуКлиента(КонтрагентСсылка, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	РежимВопроса = РежимДиалогаВопрос.ДаНет;
	Ответ = Вопрос("Удалить данного клиента?", РежимВопроса, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;	
	КонецЕсли;
	
	ТекущийКлиент = Неопределено;
	Если Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаЧерновики Тогда
		ТекущиеДанные = Элементы.СписокЧерновики.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаНаСогласовании Тогда
		ТекущиеДанные = Элементы.СписокНаСогласовании.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаСогласованные Тогда
		ТекущиеДанные = Элементы.СписокСогласованные.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСпискиКлиентов.ТекущаяСтраница = Элементы.ГруппаНесогласованные Тогда
		ТекущиеДанные = Элементы.СписокНеСогласованные.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КорпоративныйКлиентСсылка = ТекущиеДанные.Ссылка;
	ИзменитьПометкуУдаленияКлиента(КорпоративныйКлиентСсылка);
	Оповестить("Запись_КорпоративныеКлиенты");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьПометкуУдаленияКлиента(КорпоративныйКлиентСсылка)
	
	КорпоративныйКлиент = КорпоративныйКлиентСсылка.ПолучитьОбъект();
	Контрагент = КорпоративныйКлиент.Контрагент.ПолучитьОбъект();
	КорпоративныйКлиент.УстановитьПометкуУдаления(Не КорпоративныйКлиент.ПометкаУдаления);
	Контрагент.УстановитьПометкуУдаления(Не Контрагент.ПометкаУдаления);
	
КонецПроцедуры

