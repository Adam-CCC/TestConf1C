Процедура ЗаполнитьДанными(ДатаСообщения, вхСообщение ="", вхОтправитель = неопределено, СрокДней = 0, вхПолучатель = неопределено, Подробно = неопределено) Экспорт
	
	ДатаОтправки = ДатаСообщения;
	ПоказыватьС = ДатаСообщения;
	Если СрокДней > 0 Тогда
		ПоказыватьПо = КонецДня(ДатаСообщения)+24*60*60*(СрокДней-1);
	Иначе
		ПоказыватьПо = ПоказыватьС;
	КонецЕсли;
	Наименование = Сообщение;
	Сообщение	 = вхСообщение;
	Отправитель	 = вхОтправитель;
	Получатель	 = вхПолучатель;
	Подробнее	 = Новый ХранилищеЗначения(Подробно);
	
КонецПроцедуры
