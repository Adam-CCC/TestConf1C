//Бондаренко++ 20240912
Функция ПолучитьБонусыИСкидкиМаркетинговойПрограммы(МаркетинговаяПрограмма_)
	
	Рез1 = Новый Структура();
	Рез1.Вставить("РазмерБонуса",0);
	Рез1.Вставить("РазмерСкидки",0); 
	
	Если НЕ ОбЗначениеНеЗаполнено(МаркетинговаяПрограмма_) Тогда
		
 		Если ДатаРитейла = Дата(1,1,1) Тогда
			ДатаРитейла = ТекущаяДата();
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.МаркетинговаяПрограмма КАК МаркетинговаяПрограмма,
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.Модель КАК Модель,
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.ВариантКомплектации КАК ВариантКомплектации,
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.РазмерБонуса КАК РазмерБонуса,
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.РазмерСкидки КАК РазмерСкидки
		|ИЗ
		|	РегистрСведений.ПоказателиМаркетинговыхПрограмм.СрезПоследних(&ДатаРитейла, ) КАК ПоказателиМаркетинговыхПрограммСрезПоследних
		|ГДЕ
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.МаркетинговаяПрограмма = &МаркетинговаяПрограмма
		|	И ПоказателиМаркетинговыхПрограммСрезПоследних.Модель = &Модель
		|	И ПоказателиМаркетинговыхПрограммСрезПоследних.ВариантКомплектации = &ВариантКомплектации";
		
		Запрос.УстановитьПараметр("ВариантКомплектации", ВариантКомплектации);
		Запрос.УстановитьПараметр("МаркетинговаяПрограмма", МаркетинговаяПрограмма_);
		Запрос.УстановитьПараметр("Модель", Модель);
		Запрос.УстановитьПараметр("ДатаРитейла", КонецДня(ДатаРитейла));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Рез1.РазмерСкидки = ВыборкаДетальныеЗаписи.РазмерСкидки;
			Рез1.РазмерБонуса = ВыборкаДетальныеЗаписи.РазмерБонуса; 
		КонецЦикла;
	КонецЕсли;
	
	Возврат Рез1;
	
КонецФункции // БонусыИСкидкиМаркетинговойПрограммы()
