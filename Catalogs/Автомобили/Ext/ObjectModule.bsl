Функция СМГ_ПередЗаписью()
	
 	флОтказ = Ложь; 
	
	//Бондаренко++ 20250130
	Если обЗначениеНеЗаполнено(Модель) Тогда
		Модель = Справочники.Модели.НЕОПРЕДЕЛЕНО;
		Если СтрНайти(Наименование,Модель)=0 Тогда
			Наименование = СокрЛП(Модель)+" "+СокрЛП(Наименование);
 		КонецЕсли;
 	КонецЕсли;
	//Бондаренко++ 20250130
	
	//Бондаренко++ 20220414
	VIN = СокрЛП(Врег(VIN));
	
	Если СтрДлина(VIN) < 17 И СтрДлина(VIN) > 0 Тогда
		#Если Клиент Тогда
		Сообщить("ОШИБКА! Заполненный VIN должен содержать 17 символов.",СтатусСообщения.ОченьВажное);
 		#КонецЕсли
 		флОтказ = Истина;
 	КонецЕсли;     
	//Бондаренко-- 20220414  
	
	//Бондаренко++ 20220505
	Если СтрДлина(VIN) > 0 Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Автомобили.Ссылка КАК Ссылка,
		|	Автомобили.Код КАК Код
		|ИЗ
		|	Справочник.Автомобили КАК Автомобили
		|ГДЕ
		|	(Автомобили.VIN = &VIN
		|			ИЛИ Автомобили.ОригинальныйVIN = &VIN)
		|	И Автомобили.Ссылка <> &Авто";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Авто" , Ссылка);
		Запрос.УстановитьПараметр("VIN"  , СокрЛП(VIN));
		РезультатЗапроса = Запрос.Выполнить();
		
		//Бондаренко++ 20260220
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			#Если Клиент Тогда
				Сообщить("Ошибка! Реквизит 'VIN' или 'Оригинальный VIN' не уникален.",СтатусСообщения.ОченьВажное);
				Сообщить("Код дублируемого автомобиля = <<"+СокрЛП(ВыборкаДетальныеЗаписи.Код)+">>.",СтатусСообщения.ОченьВажное);
 			#КонецЕсли	
 			флОтказ = Истина;
			Прервать;
		КонецЦикла;
		//Бондаренко-- 20260220
		
	КонецЕсли;
	//Бондаренко-- 20220505
	
	Если НЕ флОтказ Тогда
		
		Если Не ЭтоГруппа Тогда
			СемьСимволовVIN = Прав(VIN,7);
			Если КраткийVIN <> СемьСимволовVIN Тогда
				КраткийVIN = СемьСимволовVIN;
			КонецЕсли; 
		КонецЕсли;
		
		//Бондаренко++ 20220302
		// заполним guid если он пустой
		Если ЭтотОбъект.ПутьКФото.Количество() > 0 Тогда
			Для Каждого Запись Из ЭтотОбъект.ПутьКФото Цикл
				Если обЗначениеНеЗаполнено(Запись.GUID) Тогда
					Запись.GUID = Новый УникальныйИдентификатор;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;             
		//Бондаренко-- 20220302
		
	КонецЕсли;
  	
 	Возврат флОтказ; 	
	
КонецФункции //СМГ_ПередЗаписью()
