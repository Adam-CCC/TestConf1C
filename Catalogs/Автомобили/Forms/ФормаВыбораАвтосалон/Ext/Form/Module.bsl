
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	/////////было
	Список.Параметры.УстановитьЗначениеПараметра("Код"     , СтрокаПоиска);
	//Список.Параметры.УстановитьЗначениеПараметра("Архивный", ОтображатьАрхив);
	////////
	
	Если Параметры.Свойство("Период") Тогда
		//Параметры "Период" и "МассивАвто" передаются из документов Перемещение автомобилей и Заявка на перемещение
		//Параметры "Контрагент" или "Склад.Территория" из Заявки на перемещение
		//Параметр  "склад" из перемещения автомобилей
		Список.Параметры.УстановитьЗначениеПараметра("Код"     , СтрокаПоиска);
		//Список.Параметры.УстановитьЗначениеПараметра("Архивный", ОтображатьАрхив);
		Список.Параметры.УстановитьЗначениеПараметра("Период", Параметры.Период);
		Если Параметры.Свойство("МассивАвто") Тогда
			Список.Параметры.УстановитьЗначениеПараметра("МассивАвто", Параметры.МассивАвто);
		Иначе
			Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"И НЕ Автомобиль В (&МассивАвто)","");
		КонецЕсли;
		
		Если Параметры.Свойство("Контрагент") Тогда
			ТекстЗапроса = Список.ТекстЗапроса;
			Список.ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад.Территория","Контрагент");
			Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,"РегистрНакопления.АвтомобилиНаСкладах","РегистрНакопления.Renault_АвтомобилиВРезерве");
			Список.Параметры.УстановитьЗначениеПараметра("Склад", Параметры.Контрагент);
		ИначеЕсли Параметры.Свойство("СкладТерритория") Тогда
			Список.Параметры.УстановитьЗначениеПараметра("Склад",Параметры.СкладТерритория);
		ИначеЕсли Параметры.Свойство("Склад") Тогда
			ТекстЗапроса = Список.ТекстЗапроса;
			Список.ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Склад.Территория", "Склад"); 		
			Список.Параметры.УстановитьЗначениеПараметра("Склад",Параметры.Склад);
		КонецЕсли;
	Иначе
		//выполняется, если форма вызвана не из документов Заявка на перемещение или Перемещение автомобилей
		НовыйТекстЗапроса = "ВЫБРАТЬ
		|	Спр.Ссылка,
		|	Спр.ПометкаУдаления,
		|	Спр.Предопределенный,
		|	Спр.Код,
		|	Спр.Наименование,
		|	Спр.Модель,
		//|	Спр.Версия,
		//|	Спр.ЦветКузова,
		|	Спр.ГодВыпуска
		//|	Спр.ПТС,
		//|	Спр.Архивный
		|ИЗ
		|	Справочник.Автомобили КАК Спр
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &Код = """"
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ Спр.Код ПОДОБНО ""%"" + &Код
		|		КОНЕЦ";
		//|	И (&Архивный = ИСТИНА
		//|			ИЛИ НЕ Спр.Архивный)";
		
		Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,Список.ТекстЗапроса, НовыйТекстЗапроса);
		Список.Параметры.УстановитьЗначениеПараметра("Код"     , СтрокаПоиска);
		//Список.Параметры.УстановитьЗначениеПараметра("Архивный", ОтображатьАрхив);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("Код", Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	Список.Параметры.УстановитьЗначениеПараметра("Код", Текст);
	
	СтрокаПоиска = Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьАрхивПриИзменении(Элемент)
	
	Список.Параметры.УстановитьЗначениеПараметра("Архивный", ОтображатьАрхив);
	
КонецПроцедуры
