		ПО АвтомобилиНаСкладахОстатки.Автомобиль = Спр.Ссылка
ГДЕ
	ВЫБОР
			КОГДА &amp;Код = ""
				ТОГДА ИСТИНА
			ИНАЧЕ Спр.Код ПОДОБНО "%" + &amp;Код
