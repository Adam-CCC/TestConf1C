Функция СМГ_СоздатьДоговор(ТекКонтрагент,ТекОрганизация,ТекПодразделениеКомпании,ТекНомер,ТекДата,ТекТипЗНЧДокумент) Экспорт
  	
	НовДог = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
  	УстановитьПривилегированныйРежим(Истина);
   	
	НовДог = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	НовДог.УстановитьНовыйКод();
	НовДог.ТипЦенПродажи = Справочники.ТипыЦен.НайтиПоКоду("ЦБ000032");
	НовДог.ТипДоговора = Перечисления.ТипыДоговоров.Договор;
	НовДог.НомерДоговора = СокрЛП(ТекНомер);	
 	НовДог.ВидДоговора=Перечисления.ВидыДоговоров.Продажа;
	НовДог.Владелец = ТекКонтрагент;
 	НовДог.Организация = ТекОрганизация;
	НовДог.Подразделение = ТекПодразделениеКомпании;
 	НовДог.НомерДоговора = ТекНомер;
	
	//Бондаренко++ 20220524
	Если НЕ ТекДата = Дата(1,1,1) Тогда
		НовДог.ДатаНачала = ТекДата;
	Иначе	
		НовДог.ДатаНачала = ТекущаяДата();	
	КонецЕсли;             
	//Бондаренко-- 20220524
	 
	Если ТекТипЗНЧДокумент = Тип("ДокументОбъект.ЗаказНаАвтомобиль") Тогда
    	ЧастьНаименования = "Договор продажи транспортного средства";
		НовДог.ДляАвтосалона = Истина;
	ИначеЕсли ТекТипЗНЧДокумент = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
      	ЧастьНаименования = "Договор продажи";		
		НовДог.ДляАвтосервиса = Истина;
	ИначеЕсли ТекТипЗНЧДокумент = Тип("ДокументОбъект.ЗаказНаряд") Тогда
      	ЧастьНаименования = "Заказ-наряд";		
		НовДог.ДляАвтосервиса = Истина;		
	Иначе	
		ЧастьНаименования = "";				
 	КонецЕсли;
 	НовДог.Наименование = СокрЛП(ЧастьНаименования+" № "+СокрЛП(НовДог.НомерДоговора)+" от "+Формат(НовДог.ДатаНачала,"ДЛФ=D")); 
	НовДог.Автор = ПараметрыСеанса.Пользователь;
	НовДог.ДатаСоздания = ТекущаяДата();
	НовДог.ВидОплаты = Перечисления.ВидыОплаты.ПроизвольнаяОплата;
	НовДог.Комментарий = "Договор создан автоматически пользователем: "+ПараметрыСеанса.Пользователь+" "+Формат(ТекущаяДата(),"ДЛФ=DDT");
	НовДог.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Попытка
		НовДог.Записать();
		#Если Клиент Тогда 
		//Сообщить("Создан новый договор "+НовДог);
		#КонецЕсли
	Исключение
		#Если Клиент Тогда 
			Сообщить("ОШИБКА! Не удалось создать новый договор.",СтатусСообщения.ОченьВажное);	
		#КонецЕсли
 		Форма = НовДог.ПолучитьФорму("ФормаЭлемента");
		Если Не Форма.Открыта() Тогда
			Попытка Форма.ОткрытьМодально(); Исключение КонецПопытки;
 		КонецЕсли;
 	КонецПопытки; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат НовДог.Ссылка;

КонецФункции // СоздатьДоговор(ТекКонтрагент,ТекОрганизация,ТекПодразделениеКомпании,ТекНомер,ТекДата,ТекТипЗНЧДокумент)
//Бондаренко-- 20210923 

//Бондаренко++ 20220519
Процедура СМГ_ОбновитьДоговор(ТекДог,ТекНомер,ТекДата,ТекТипЗНЧДокумент) Экспорт

  	
	Если СокрЛП(ТекДог.НомерДоговора) <> СокрЛП(ТекНомер) Тогда

		УстановитьПривилегированныйРежим(Истина);                	
 		
 		ТекДог.НомерДоговора = СокрЛП(ТекНомер);	
		ТекДог.ДатаНачала = ТекДата;
 		
		Если ТекТипЗНЧДокумент = Тип("ДокументОбъект.ЗаказНаАвтомобиль") Тогда
  			ЧастьНаименования = "Договор продажи транспортного средства";
		ИначеЕсли ТекТипЗНЧДокумент = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
 			ЧастьНаименования = "Договор продажи";		
		ИначеЕсли ТекТипЗНЧДокумент = Тип("ДокументОбъект.ЗаказНаряд") Тогда
 			ЧастьНаименования = "Заказ-наряд";		
		Иначе	
			ЧастьНаименования = "";				
		КонецЕсли;

		ТекДог.Наименование = СокрЛП(ЧастьНаименования+" № "+СокрЛП(ТекДог.НомерДоговора)+" от "+Формат(ТекДог.ДатаНачала,"ДЛФ=D")); 
		ТекДог.Автор = ПараметрыСеанса.Пользователь;
		ТекДог.ДатаСоздания = ТекущаяДата();
		ТекДог.Комментарий = "Договор обновлён автоматически пользователем: "+ПараметрыСеанса.Пользователь+" "+Формат(ТекущаяДата(),"ДЛФ=DDT");
 		
 		Попытка
			ТекДог.Записать();
			#Если Клиент Тогда 
				//Сообщить("Обновлён договор "+ТекДог);
			#КонецЕсли
		Исключение
			#Если Клиент Тогда 
				Сообщить("ОШИБКА! Не удалось обновить договор.",СтатусСообщения.ОченьВажное);	
			#КонецЕсли
		КонецПопытки; 
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры // СМГ_ОбновитьДоговор(ДокументИсточник)
