//Гэндальф+++
Функция НельзяИспользоватьПрочие()
	Если ВидДоговора = Перечисления.ВидыДоговоров.Прочее и Не обПраво("РазрешитьИспользоватьПрочиеДоговора",,,ЭтотОбъект) тогда
		НельзяИспользовать = Истина;
		Сообщить("У Вас нет прав на использование договора с видом Прочие");
	Иначе
		НельзяИспользовать = Ложь;		
	КонецЕсли;
	Возврат НельзяИспользовать;
КонецФункции
//Гэндальф---

Процедура СМГ_ПередЗаписью(Отказ)
	АвтоЗакрытиеСделок = Ложь;
	Отказ = Отказ Или НельзяИспользоватьПрочие();
	Если ЭтоНовый() Тогда
		Если обЗначениеНеЗаполнено(ЕдиницаИзмеренияАвтоработВПечатныхФормах) Тогда
			ЕдиницаИзмеренияАвтоработВПечатныхФормах=Перечисления.ЕдиницаИзмеренияАвтоработВПечатныхФормах.ЕдиницаИзмеренияПрочерк;
 		КонецЕсли; 
	КонецЕсли; 
	
	//Бондаренко++ 20230930
	Если ДатаНачала <> Дата(1,1,1) Тогда
		Если ДатаКП <> Дата(1,1,1) Тогда
			Если ДатаКП < ДатаНачала Тогда
				СМГ_Сообщить("ОШИБКА! 'Дата КП' = "+Формат(ДатаКП,"ДЛФ=D")+" и меньше, чем 'Дата начала' = "+Формат(ДатаНачала,"ДЛФ=D"),СтатусСообщения.ОченьВажное);			
				Отказ = Истина;
  			КонецЕсли;
 		КонецЕсли;	
	КонецЕсли;	
	//Бондаренко-- 20230930
	
	// Бондаренко++ 20250614
	ЕстьПодчиненные = Справочники.ПодразделенияКомпании.СМГ_ЕстьПодчиненныеПодразделения(Подразделение);
	Если ЕстьПодчиненные Тогда
		Если ЭтоНовый() ИЛИ  ( ДатаНачала >= Дата(2025,1,1) ) Тогда
			СМГ_Сообщить("ОШИБКА! Запрещено использовать подразделение """+СокрЛП(Подразделение)+""" из группы """+СокрЛП(Подразделение.Родитель)+""".",СтатусСообщения.ОченьВажное);
			Отказ = Истина;
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	// Бондаренко-- 20250614
	
	//Бондаренко++ 20230308
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		Если ВидДоговора = Перечисления.ВидыДоговоров.Покупка И Не обПраво("РазрешитьСозданиеДоговоровПоставка",,,ЭтотОбъект) Тогда
			//Бондаренко++ 20240424
			//Если Найти(Наименование," СУБПОДРЯД") > 0 Тогда
			Если Найти(Наименование," СУБПОДРЯД") > 0 ИЛИ ДляПерепродажАвтомобилей Тогда	
			//Бондаренко-- 20240424	
				Сообщить("Есть право на программное создание договора с видом Поставка.",СтатусСообщения.Информация);	
			Иначе
				Отказ = Истина;
				Сообщить("У Вас нет прав на создание договора с видом Поставка.",СтатусСообщения.ОченьВажное);	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	//Бондаренко-- 20230308
	
	//Бондаренко++ 20210923
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&Ссылка)
		|	И ПодразделенияКомпании.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Подразделение);	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();	
	//Бондаренко-- 20210923
	
	// Семенихин 12.10.2021 +++++
	Если РезультатЗапроса.Количество() > 0 Тогда
		НовоеПодразделение = Справочники.ПодразделенияКомпании.ПустаяСсылка();
		Для Каждого СтрокаРезультат Из РезультатЗапроса Цикл
			Если СтрокаРезультат.Ссылка.Организация = Подразделение.Организация Тогда
				НовоеПодразделение = СтрокаРезультат.Ссылка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Подразделение = НовоеПодразделение;
	КонецЕсли;
	// Семенихин 12.10.2021 -----
КонецПроцедуры

