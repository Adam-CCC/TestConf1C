
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) И Параметры.Свойство("РекламнаяКампания") Тогда
		Объект.РекламнаяКампания = Параметры.РекламнаяКампания;
		РекламнаяКампанияПриИзмененииНаСервере();
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Статус) И Статус <> Справочники.DMS_СтатусыМакетовРекламнойКампании.Заявлен 
		И Статус <> Справочники.DMS_СтатусыМакетовРекламнойКампании.БезДействия Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если Не Объект.ФайлКартинки.Пустая() Тогда
		АдресКартинки = ПолучитьНавигационнуюСсылку(Объект.ФайлКартинки,"ФайлХранилище");
	Иначе
		АдресКартинки = "";
	Конецесли;
	
	Если Объект.Согласован Тогда
		Статус = Справочники.DMS_СтатусыМакетовРекламнойКампании.Согласован;
	Иначе 
		Статус = ТекущееСостояниеМакета(Объект.Ссылка);
	КонецЕсли; 
	
	Элементы.ФормаЗаписатьИЗакрыть.Заголовок = "Сохранить макет";
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ПрисоединенныйФайл" Тогда
		
		Модифицированность = Истина;
		СсылкаНаФайл = ?(ТипЗнч(Источник) = Тип("Массив"), Источник[0], Источник);
		
		Если ВыборИзображения Тогда
			
			Объект.ФайлКартинки = СсылкаНаФайл;
			АдресКартинки = ПолучитьНавигационнуюСсылку(Объект.ФайлКартинки,"ФайлХранилище");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.DMS_МакетыРекламнойКампанииПрисоединенныеФайлы") Тогда
		
		Объект.ФайлКартинки = ВыбранноеЗначение;
		АдресКартинки = ПолучитьНавигационнуюСсылку(Объект.ФайлКартинки, "ФайлХранилище");
		
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("Запись_Макеты",Объект.РекламнаяКампания);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.Согласован Тогда
		Статус = Справочники.DMS_СтатусыМакетовРекламнойКампании.Согласован;
	Иначе 
		Статус = ТекущееСостояниеМакета(Объект.Ссылка);
	КонецЕсли; 
	
	Элементы.ФормаЗаписатьИЗакрыть.Заголовок = "Сохранить макет";
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИзображение(Команда)
	
	Объект.ФайлКартинки = ПредопределенноеЗначение("Справочник.DMS_МакетыРекламнойКампании.ПустаяСсылка");
	АдресКартинки = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображение(Команда)
		
    ИдентификаторФайла = Новый УникальныйИдентификатор;
    ДобавитьФайлы(Объект.Ссылка, ИдентификаторФайла);
		                                               
КонецПроцедуры

&НаКлиенте
Процедура ИзПрисоединенныхФайлов(Команда)
	
	ПараметрыФормы = Новый Структура("Отбор",Новый Структура("ВладелецФайла",Объект.Ссылка));
	ОткрытьФорму("Справочник.DMS_МакетыРекламнойКампанииПрисоединенныеФайлы.ФормаВыбора",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
			
	ПросмотретьПрисоединенныйФайл(Элемент.Имя, Элемент.Имя,Объект.Ссылка,
		НСтр("ru='Отсутствует изображение для просмотра';en='No picture to show'"));
	
КонецПроцедуры

&НаСервере
Процедура РекламнаяКампанияПриИзмененииНаСервере()

	Объект.Представитель = Объект.РекламнаяКампания.Представитель;
	Объект.ДилерскийЦентр  = Объект.РекламнаяКампания.ДилерскийЦентр;

КонецПроцедуры // РекламнаяКампанияПриИзмененииНаСервере()

&НаСервереБезКонтекста
Функция ТекущееСостояниеМакета(МакетРекламнойКампании)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МакетРекламнойКампании", МакетРекламнойКампании);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтатусыМакетовРекламныхКампанийСрезПоследних.Статус
		|ИЗ
		|	РегистрСведений.DMS_СтатусыМакетовРекламныхКампаний.СрезПоследних(, МакетРекламнойКампании = &МакетРекламнойКампании) КАК СтатусыМакетовРекламныхКампанийСрезПоследних";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Статус = Справочники.DMS_СтатусыМакетовРекламнойКампании.ПустаяСсылка();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Статус = ВыборкаДетальныеЗаписи.Статус;
	КонецЕсли; 
	
	Возврат Статус;
	
КонецФункции // ТекущееСостояниеМакета()

&НаКлиенте
Процедура РекламнаяКампанияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("Ключ",Объект.РекламнаяКампания);
	
	ОткрытьФорму("Документ.DMS_РекламнаяКампания.Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьНаСогласованиеНаСервере(Ссылка)
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Предмет", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
		|	СогласованиеМакетов.Ссылка КАК Ссылка
		|ИЗ
		|	БизнесПроцесс.DMS_СогласованиеМакетовРекламнойКампании КАК СогласованиеМакетов
		|ГДЕ
		|	СогласованиеМакетов.Предмет = &Предмет
		|	И НЕ СогласованиеМакетов.ПометкаУдаления
		|	И НЕ СогласованиеМакетов.Стартован
		|	И НЕ СогласованиеМакетов.Завершен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли; 
	
	БизнесПроцесс = БизнесПроцессы.DMS_СогласованиеМакетовРекламнойКампании.СоздатьБизнесПроцесс();
	БизнесПроцесс.Заполнить(Ссылка);
	
	БизнесПроцессСсылка = БизнесПроцессы.DMS_СогласованиеМакетовРекламнойКампании.ПолучитьСсылку();
	БизнесПроцесс.УстановитьСсылкуНового(БизнесПроцессСсылка);
	БизнесПроцесс.ОбменДанными.Загрузка = Истина;
	БизнесПроцесс.Записать();
	
	Возврат БизнесПроцессСсылка;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Предупреждение("Сначала необходимо записать макет",15,"Внимание");
		Возврат;
	КонецЕсли; 
	
	СсылкаБизнесПроцесс = ОтправитьНаСогласованиеНаСервере(Объект.Ссылка);
	
	ПараметрыФормы = Новый Структура("Ключ",СсылкаБизнесПроцесс);	
	ОткрытьФорму("БизнесПроцесс.DMS_СогласованиеМакетовРекламнойКампании.Форма.ФормаБизнесПроцесса",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлы(СсылкаНаМакет, ИдентификаторФайла)
	                 
	ВладелецФайла = СсылкаНаМакет;
	ИдентификаторФормы = ИдентификаторФайла;
	
	Фильтр = DMS_РекламныеКампанииКлиент.ФильтрФайловИзображений();
	
	ВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ВыборФайла.МножественныйВыбор = Истина;
	ВыборФайла.Заголовок = НСтр("ru='Выбор файла';en='file selection'");
	ВыборФайла.Фильтр = ?(ЗначениеЗаполнено(Фильтр), Фильтр, НСтр("ru='Все файлы';en='All files'") + " (*.*)|*.*");
	
	Если ВыборФайла.Выбрать() Тогда
		ПрисоединенныеФайлыМассив = Новый Массив;
		ПоместитьВыбранныеФайлыВХранилище(
		ВыборФайла.ВыбранныеФайлы,
		ВладелецФайла,
		ПрисоединенныеФайлыМассив,
		ИдентификаторФормы);
		
		Если ПрисоединенныеФайлыМассив.Количество() = 1 Тогда
			ПрисоединенныйФайл = ПрисоединенныеФайлыМассив[0];
			
			ПоказатьОповещениеПользователя(
			НСтр("ru='Создание:';en='Creature:'"),
			ПолучитьНавигационнуюСсылку(ПрисоединенныйФайл),
			ПрисоединенныйФайл,
			БиблиотекаКартинок.Информация32);
			
			АдресКартинки = ПолучитьНавигационнуюСсылку(ПрисоединенныйФайл, "ФайлХранилище");
			
			ПараметрыФормы = Новый Структура("Ключ", ПрисоединенныйФайл);
			ОткрытьФорму("Справочник.DMS_МакетыРекламнойКампанииПрисоединенныеФайлы.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
			
		КонецЕсли;
		
		Если ПрисоединенныеФайлыМассив.Количество() > 0 Тогда
			ОповеститьОбИзменении(ПрисоединенныеФайлыМассив[0]);
			Оповестить("Запись_ПрисоединенныйФайл", Новый Структура("ЭтоНовый", Истина), ПрисоединенныеФайлыМассив);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ДобавитьФайлы()

&НаКлиенте
Процедура ПоместитьВыбранныеФайлыВХранилище(Знач ВыбранныеФайлы,
                                            Знач ВладелецФайла,
                                            ПрисоединенныеФайлыМассив,
                                            Знач ИдентификаторФормы) Экспорт
		
	ДвоичныйФайл = Новый ДвоичныеДанные(ВыбранныеФайлы[0]);
	
	Файл = Новый Файл(ВыбранныеФайлы[0]);	
	
	СтруктураФайла = Новый Структура("Файл,Имя,Размер,Расширение",ДвоичныйФайл,Файл.ИмяБезРасширения,Файл.Размер(),Файл.Расширение);
	
	ПрисоединенныйФайл = СоздатьПрисоединенныйФайл(СтруктураФайла,ВладелецФайла);
	
	Объект.ФайлКартинки = ПрисоединенныйФайл; 
	
	ПрисоединенныеФайлыМассив.Добавить(ПрисоединенныйФайл);
	
	Файл = Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьПрисоединенныйФайл(СтруктураФайла,ВладелецФайла)
		
	ОбъектФайл = Справочники.DMS_МакетыРекламнойКампанииПрисоединенныеФайлы.СоздатьЭлемент();
	ОбъектФайл.ВладелецФайла = ВладелецФайла;
	ОбъектФайл.Наименование  = СтруктураФайла.Имя;
	ОбъектФайл.Размер 		 = СтруктураФайла.Размер;
	ОбъектФайл.Расширение    = СтрЗаменить(СтруктураФайла.Расширение,".","");
	ОбъектФайл.ФайлХранилище = Новый ХранилищеЗначения(СтруктураФайла.Файл,Новый СжатиеДанных(9));
		
	ОбъектФайл.ОбменДанными.Загрузка = Истина;
	ОбъектФайл.Записать();
	
	Возврат ОбъектФайл.Ссылка;
	
КонецФункции // СоздатьПрисоединенныйФайл()

&НаКлиенте
Процедура ПросмотретьПрисоединенныйФайл(ИмяРеквизитаОбъекта, ИмяРеквизитаФормы,ВладелецПрисоединенныйФайл, ТекстСообщенияОбОшибке)
	
	ОчиститьСообщения();
	
	Если ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизитаОбъекта]) Тогда
		
		ДанныеФайла = ПолучитьДанныеПрисоединенногоФайла(ВладелецПрисоединенныйФайл.ФайлКартинки);
		
		ИмяВременногоФайла =  ПолучитьИмяВременногоФайла(ДанныеФайла.Расширение);
		ДанныеФайла.Файл.Записать(ИмяВременногоФайла);
		
		ЗапуститьПриложение(ИмяВременногоФайла);
		
		// УдалитьФайлы(ИмяВременногоФайла);
		
	Иначе
		Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияОбОшибке,, ИмяРеквизитаФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПрисоединенногоФайла(ПрисоединенныйФайл)

	Возврат Новый Структура("Файл,Расширение",ПрисоединенныйФайл.ФайлХранилище.Получить(),ПрисоединенныйФайл.Расширение)

КонецФункции // ПолучитьДанныеПрисоединенногоФайла()

