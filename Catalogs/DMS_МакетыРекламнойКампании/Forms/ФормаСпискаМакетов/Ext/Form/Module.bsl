&НаСервереБезКонтекста
Функция ОтправитьНаСогласованиеНаСервере(Ссылка)
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Предмет", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
		|	СогласованиеМакетов.Ссылка КАК Ссылка
		|ИЗ
		|	БизнесПроцесс.DMS_СогласованиеМакетовРекламнойКампании КАК СогласованиеМакетов
		|ГДЕ
		|	СогласованиеМакетов.Предмет = &Предмет
		|	И НЕ СогласованиеМакетов.ПометкаУдаления
		|	И НЕ СогласованиеМакетов.Стартован
		|	И НЕ СогласованиеМакетов.Завершен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли; 
	
	БизнесПроцесс = БизнесПроцессы.DMS_СогласованиеМакетовРекламнойКампании.СоздатьБизнесПроцесс();
	БизнесПроцесс.Заполнить(Ссылка);
	
	БизнесПроцессСсылка = БизнесПроцессы.DMS_СогласованиеМакетовРекламнойКампании.ПолучитьСсылку();
	БизнесПроцесс.УстановитьСсылкуНового(БизнесПроцессСсылка);
	БизнесПроцесс.ОбменДанными.Загрузка = Истина;
	БизнесПроцесс.Записать();
	
	Возврат БизнесПроцессСсылка;
	
КонецФункции

&НаСервере
Процедура ОчиститьЭлементыФормыИРеквизитыНаСервере()
	
	Элементы.ГруппаСписокМакетов.Видимость = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РекламнаяКампания", РекламнаяКампания);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	МакетыКампании.Ссылка КАК Макет
		|ИЗ
		|	Справочник.DMS_МакетыРекламнойКампании КАК МакетыКампании
		|ГДЕ
		|	МакетыКампании.РекламнаяКампания = &РекламнаяКампания
		|
		|УПОРЯДОЧИТЬ ПО
		|	Макет
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаМакетов = РезультатЗапроса.Выбрать();
	
	УдаляемыеРеквизиты = Новый Массив;
	
	Пока ВыборкаМакетов.Следующий() Цикл
		
		ИдентификаторМакета = СтрЗаменить(ВРег(Строка(ВыборкаМакетов.Макет.УникальныйИдентификатор())), "-", "x");
		
		//Удаление команд
		
		КомандаКУдалению = "КомандаСогласовать_"+ИдентификаторМакета;
		
		Если Элементы.Найти(КомандаКУдалению) <> Неопределено Тогда
			УдалитьКоманду(КомандаКУдалению);
		КонецЕсли; 
		
		//Удаление декораций         
		
		ДекорацияКУдалению = "ДекорацияНетПлощадки_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ДекорацияКУдалению) <> Неопределено Тогда
			УдалитьЭлементФормы(ДекорацияКУдалению);
		КонецЕсли; 
		
		ДекорацияКУдалению = "ДекорацияПлощадка_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ДекорацияКУдалению) <> Неопределено Тогда      
			УдалитьЭлементФормы(ДекорацияКУдалению);
		КонецЕсли; 
		
		ДекорацияКУдалению = "ДекорацияНаСогласовании_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ДекорацияКУдалению) <> Неопределено Тогда
			УдалитьЭлементФормы(ДекорацияКУдалению);
		КонецЕсли; 
		
		ДекорацияКУдалению = "ДекорацияИмяИзображения_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ДекорацияКУдалению) <> Неопределено Тогда
			УдалитьЭлементФормы(ДекорацияКУдалению);
		КонецЕсли; 
		
		ДекорацияКУдалению = "ДекорацияРазмерИзображения_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ДекорацияКУдалению) <> Неопределено Тогда
			УдалитьЭлементФормы(ДекорацияКУдалению);
		КонецЕсли; 
		
		//Удаление элементов формы и реквизитов
		
		РеквизитИЭлементКУдалению = "Изображение_"+ИдентификаторМакета;
		
		Если Элементы.Найти(РеквизитИЭлементКУдалению) <> Неопределено Тогда
			УдалитьЭлементИРеквизитыФормы(РеквизитИЭлементКУдалению,УдаляемыеРеквизиты);
		КонецЕсли; 
		
		РеквизитИЭлементКУдалению = "Макет_"+ИдентификаторМакета;
		
		Если Элементы.Найти(РеквизитИЭлементКУдалению) <> Неопределено Тогда
			УдалитьЭлементИРеквизитыФормы(РеквизитИЭлементКУдалению,УдаляемыеРеквизиты);
		КонецЕсли; 
		
		//Для каждого ТекущаяСтрока Из ВыборкаМакетов.Макет.КонтактнаяИнформация Цикл
		//	
		//	//Реквизит "Адрес"
		//	УдалитьЭлементИРеквизитыФормы = "Адрес"+Формат(ТекущаяСтрока.НомерСтроки,"ЧЦ=10; ЧН=0; ЧГ=")+"_" + ИдентификаторМакета;
		//	
		//	Если Элементы.Найти(УдалитьЭлементИРеквизитыФормы) <> Неопределено Тогда
		//		УдалитьЭлементИРеквизитыФормы(УдалитьЭлементИРеквизитыФормы,УдаляемыеРеквизиты);
		//	КонецЕсли; 
		//	
		//КонецЦикла; 
		
		//Удаление группа
		
		ГруппаКУдалению = "ГруппаКИМакета_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ГруппаКУдалению) <> Неопределено Тогда
			УдалитьЭлементФормы(ГруппаКУдалению);
		КонецЕсли; 
		
		ГруппаКУдалению = "ГруппаМакета_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ГруппаКУдалению) <> Неопределено Тогда
			УдалитьЭлементФормы(ГруппаКУдалению);
		КонецЕсли; 
		
		ГруппаКУдалению = "ГруппаМакетаОбщая_"+ИдентификаторМакета;
		
		Если Элементы.Найти(ГруппаКУдалению) <> Неопределено Тогда
			УдалитьЭлементФормы(ГруппаКУдалению);
		КонецЕсли; 
		
	КонецЦикла;
	
	Если УдаляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	КонецЕсли;
	
	Элементы.ГруппаСписокМакетов.Видимость = Истина;
	
КонецПроцедуры // ОчиститьЭлементыФормыИРеквизитыНаСервере()

&НаСервере
Процедура УдалитьЭлементФормы(ИмяЭлементыФормы)
	
	Элементы.Удалить(Элементы[ИмяЭлементыФормы]);	
	
КонецПроцедуры // УдалитьКоманду()

&НаСервере
Процедура УдалитьЭлементИРеквизитыФормы(ИмяЭлементыФормы,УдаляемыеРеквизиты)
	
	УдаляемыеРеквизиты.Добавить(ИмяЭлементыФормы);
	Элементы.Удалить(Элементы[ИмяЭлементыФормы]);	
	
КонецПроцедуры // УдалитьКоманду()

&НаСервере
Процедура УдалитьКоманду(ИмяКоманды)
	
	ЭтаФорма.Команды.Удалить(ЭтаФорма.Команды.Найти(ИмяКоманды));
	Элементы.Удалить(Элементы[ИмяКоманды]);	
	
КонецПроцедуры // УдалитьКоманду()

&НаСервереБезКонтекста
Функция ЗаписатьФайлКартинкиМакета(Макет,Картинка)
	
	Попытка
		ОбъектМакет = Макет.ПолучитьОбъект();
		ОбъектМакет.ФайлКартинки = Картинка;
		ОбъектМакет.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("Запись изображения в макет",УровеньЖурналаРегистрации.Ошибка,,Макет,КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции // ЗаписатьФайлКартинкиМакета()

&НаСервере
Процедура ИзменитьДекорацииИзображения(СсылкаНаФайл,ИдентификаторМакета)
	
	//Элемент формы "Имя изображения"
	ИмяДекорацииИмяИзображения = "ДекорацияИмяИзображения_" + ИдентификаторМакета;
	
	Элемент = Элементы[ИмяДекорацииИмяИзображения];
	Элемент.Заголовок 			  	  = СокрЛП(СсылкаНаФайл.Наименование)+"."+СокрЛП(СсылкаНаФайл.Расширение);
	Элемент.РастягиватьПоГоризонтали  = Ложь;
	Элемент.ЦветТекста				  = ЦветаСтиля.ТекстИнформационнойНадписи;
	Элемент.Ширина				      = 15;
	Элемент.Гиперссылка 			  = Ложь;
	
	Родитель = Элемент.Родитель;
	
	//Элемент формы "Размер изображения"
	ИмяДекорацииРазмерИзображения = "ДекорацияРазмерИзображения_" + ИдентификаторМакета;
	
	Элемент = Элементы.Добавить(ИмяДекорацииРазмерИзображения, Тип("ДекорацияФормы"),Родитель);
	Элемент.Заголовок 			  	  = ПолучитьСтроковоеПредставлениеРазмераФайла(СсылкаНаФайл.Размер);
	Элемент.РастягиватьПоГоризонтали  = Ложь;
	Элемент.ЦветТекста				  = ЦветаСтиля.ТекстИнформационнойНадписи;
	Элемент.Ширина				      = 15;
	
	ИмяКомандыСогласовать 	   = "КомандаСогласовать_"      + ИдентификаторМакета;
	ИмяДекорацииНаСогласовании = "ДекорацияНаСогласовании_" + ИдентификаторМакета;
	
	Если Элементы.Найти(ИмяКомандыСогласовать) <> Неопределено Тогда
		Элементы.Переместить(Элемент,Родитель,Элементы[ИмяКомандыСогласовать]);
	КонецЕсли; 
	
	Если Элементы.Найти(ИмяДекорацииНаСогласовании) <> Неопределено Тогда
		Элементы.Переместить(Элемент,Родитель,Элементы[ИмяДекорацииНаСогласовании]);
	КонецЕсли; 
	
КонецПроцедуры // ИзменитьДекорацииИзображения()

&НаКлиенте
Процедура ДобавитьФайлы(СсылкаНаМакет, ИдентификаторФайла,ИдентификаторМакета)
	                 
	ВладелецФайла = ТекущийМакет;
	ИдентификаторФормы = ИдентификаторФайла;
	
	Фильтр = DMS_РекламныеКампанииКлиент.ФильтрФайловИзображений();
	
	ВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ВыборФайла.МножественныйВыбор = Истина;
	ВыборФайла.Заголовок = НСтр("ru='Выбор файла';en='file selection'");
	ВыборФайла.Фильтр = ?(ЗначениеЗаполнено(Фильтр), Фильтр, НСтр("ru='Все файлы';en='All files'") + " (*.*)|*.*");
	
	Если ВыборФайла.Выбрать() Тогда
		ПрисоединенныеФайлыМассив = Новый Массив;
		ПоместитьВыбранныеФайлыВХранилище(
		ВыборФайла.ВыбранныеФайлы,
		ВладелецФайла,
		ПрисоединенныеФайлыМассив,
		ИдентификаторФормы);
		
		Если ПрисоединенныеФайлыМассив.Количество() = 1 Тогда
			ПрисоединенныйФайл = ПрисоединенныеФайлыМассив[0];
			
			ПоказатьОповещениеПользователя(
			НСтр("ru='Создание:';en='Creature:'"),
			ПолучитьНавигационнуюСсылку(ПрисоединенныйФайл),
			ПрисоединенныйФайл,
			БиблиотекаКартинок.Информация32);
			
			мИдентификаторМакета = СтрЗаменить(ВРег(ИдентификаторМакета), "-", "x");
			
			Этаформа["Изображение_"+мИдентификаторМакета] = ПолучитьНавигационнуюСсылку(ПрисоединенныйФайл, "ФайлХранилище");
			
			ПараметрыФормы = Новый Структура("Ключ", ПрисоединенныйФайл);
			ОткрытьФорму("Справочник.DMS_МакетыРекламнойКампанииПрисоединенныеФайлы.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
			
		КонецЕсли;
		
		Если ПрисоединенныеФайлыМассив.Количество() > 0 Тогда
			ОповеститьОбИзменении(ПрисоединенныеФайлыМассив[0]);
			Оповестить("Запись_ПрисоединенныйФайл", Новый Структура("ЭтоНовый", Истина), ПрисоединенныеФайлыМассив);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ДобавитьФайлы()

&НаКлиенте
Процедура ПоместитьВыбранныеФайлыВХранилище(Знач ВыбранныеФайлы,
                                            Знач ВладелецФайла,
                                            ПрисоединенныеФайлыМассив,
                                            Знач ИдентификаторФормы) Экспорт
		
	ДвоичныйФайл = Новый ДвоичныеДанные(ВыбранныеФайлы[0]);
	
	Файл = Новый Файл(ВыбранныеФайлы[0]);	
	
	СтруктураФайла = Новый Структура("Файл,Имя,Размер,Расширение",ДвоичныйФайл,Файл.ИмяБезРасширения,Файл.Размер(),Файл.Расширение);
	
	ПрисоединенныйФайл = СоздатьПрисоединенныйФайл(СтруктураФайла,ВладелецФайла);
	
	ПрисоединенныеФайлыМассив.Добавить(ПрисоединенныйФайл);
	
	Файл = Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьПрисоединенныйФайл(СтруктураФайла,ВладелецФайла)
		
	ОбъектФайл = Справочники.DMS_МакетыРекламнойКампанииПрисоединенныеФайлы.СоздатьЭлемент();
	ОбъектФайл.ВладелецФайла = ВладелецФайла;
	ОбъектФайл.Наименование  = СтруктураФайла.Имя;
	ОбъектФайл.Размер 		 = СтруктураФайла.Размер;
	ОбъектФайл.Расширение    = СтрЗаменить(СтруктураФайла.Расширение,".","");
	ОбъектФайл.ФайлХранилище = Новый ХранилищеЗначения(СтруктураФайла.Файл,Новый СжатиеДанных(9));
	
	ОбъектФайл.ОбменДанными.Загрузка = Истина;
	ОбъектФайл.Записать();
	
	ОбъектВладелец = ВладелецФайла.ПолучитьОбъект();
	ОбъектВладелец.ФайлКартинки = ОбъектФайл.Ссылка;
	ОбъектФайл.ОбменДанными.Загрузка = Истина;
	ОбъектВладелец.Записать();
	
	Возврат ОбъектФайл.Ссылка;
	
КонецФункции // СоздатьПрисоединенныйФайл()

&НаСервере
Процедура ИзменитьИнформациюОСтатусе(Знач ИмяКоманды,Знач ИдентификаторМакета)
	
	// Команда "Согласовать"
	
	ИмяКомандыСогласовать = "КомандаСогласовать_"+ИдентификаторМакета;
	
	мИдентификаторМакета = СтрЗаменить(ВРег(ИдентификаторМакета), "-", "x");
	
	ГруппаМакета = Элементы[ИмяКоманды].Родитель;
	
	УдалитьКоманду(ИмяКоманды);
		
	//Элемент формы "ДекорацияНаСогласовании"
	ИмяДекорацииНаСогласовании = "ДекорацияНаСогласовании_" + мИдентификаторМакета;
	
	Элемент = Элементы.Добавить(ИмяДекорацииНаСогласовании, Тип("ДекорацияФормы"),ГруппаМакета);
	Элемент.Заголовок 			  	  = "<На согласовании>";
	Элемент.РастягиватьПоГоризонтали  = Ложь;
	Элемент.Шрифт			     	  = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,,,,,Истина);
	Элемент.ЦветТекста				  = WebЦвета.Зеленый;
	Элемент.Ширина				  	  = 30;
	
КонецПроцедуры // ИзменитьИнформациюОСтатусе()
 
////#КонецОбласти

