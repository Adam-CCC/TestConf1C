
////#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли; 
	
	Если Параметры.Отбор.Свойство("РекламнаяКампания") Тогда
		РекламнаяКампания = Параметры.Отбор.РекламнаяКампания;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(РекламнаяКампания) Тогда
		ЗаполнитьМакетыНаФорме();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_Макеты" 
		И Параметр = РекламнаяКампания Тогда
		
		ОчиститьЭлементыФормыИРеквизитыНаСервере();
		ЗаполнитьМакетыНаФорме();
		
	КонецЕсли; 
	
	Если ИмяСобытия = "Запись_ПрисоединенныйФайл" Тогда
		
		Модифицированность = Истина;
		СсылкаНаФайл = ?(ТипЗнч(Источник) = Тип("Массив"), Источник[0], Источник);
		
		Если ЗначениеЗаполнено(ТекущийМакет) Тогда
			
			Успешно = ЗаписатьФайлКартинкиМакета(ТекущийМакет,СсылкаНаФайл);
			
			Если Успешно Тогда
				
				ИдентификаторМакета = СтрЗаменить(ВРег(Строка(ТекущийМакет.УникальныйИдентификатор())), "-", "x");
				
				ИмяИзображения = "Изображение_" + ИдентификаторМакета;
				                           
				ЭтаФорма[ИмяИзображения] = ПолучитьНавигационнуюСсылку(СсылкаНаФайл, "ФайлХранилище");				
				
				ИзменитьДекорацииИзображения(СсылкаНаФайл,ИдентификаторМакета);
				
				ТекущийМакет = Неопределено;
				
			Иначе 
				Предупреждение("Произошла ошибка при записи изображения(см. журнал регистрации)",15,"Внимание");
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

////#КонецОбласти

////#Область ОбработчикиСобытийРеквизитовФормы

&НаКлиенте
Процедура РекламнаяКампанияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("Ключ",РекламнаяКампания);
	ОткрытьФорму("Документ.DMS_РекламнаяКампания.ФормаОбъекта",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

////#КонецОбласти

////#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрикрепитьМакет(Команда)
	
	ПараметрыФормы = Новый Структура("РекламнаяКампания", РекламнаяКампания);
	ОткрытьФорму("Справочник.DMS_МакетыРекламнойКампании.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

////#КонецОбласти

////#Область ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_КомандаНажатиеСогласовать(Команда) 
	
	ИдентификаторМакета = СтрЗаменить(НРег(СтрЗаменить(Команда.Имя,"КомандаСогласовать_","")), "x", "-");
	
	СсылкаНаМакет = ПолучитьМакетПоУникальномуИдентификатору(ИдентификаторМакета);
	
	СсылкаБизнесПроцесс = ОтправитьНаСогласованиеНаСервере(СсылкаНаМакет);
	
	ПараметрыФормы = Новый Структура("Ключ",СсылкаБизнесПроцесс);	
	ОткрытьФорму("БизнесПроцесс.DMS_СогласованиеМакетовРекламнойКампании.Форма.ФормаБизнесПроцесса",ПараметрыФормы,ЭтаФорма);
	
	ИзменитьИнформациюОСтатусе(Команда.Имя,ИдентификаторМакета);
	
КонецПроцедуры // Подключаемый_КомандаНажатиеСогласовать()

&НаКлиенте
Процедура Подключаемый_ПриНажатииЗагрузитьИзображение(Команда)
	
	ИдентификаторМакета = СтрЗаменить(НРег(СтрЗаменить(Команда.Имя,"ДекорацияИмяИзображения_","")), "x", "-");
	
	ТекущийМакет = Неопределено;
	
	СсылкаНаМакет = ПолучитьМакетПоУникальномуИдентификатору(ИдентификаторМакета);
	
	ТекущийМакет = СсылкаНаМакет;
	
    ИдентификаторФайла = Новый УникальныйИдентификатор;
    ДобавитьФайлы(СсылкаНаМакет, ИдентификаторФайла,ИдентификаторМакета);
		                                               
КонецПроцедуры // Подключаемый_ПриНажатииНаИзображение()
 
&НаКлиенте
Процедура Подключаемый_ПриНажатииНаИзображение(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИдентификаторМакета = СтрЗаменить(НРег(СтрЗаменить(Элемент.Имя,"Изображение_","")), "x", "-");
	
	СсылкаНаМакет = ПолучитьМакетПоУникальномуИдентификатору(ИдентификаторМакета);
	
	ПросмотретьПрисоединенныйФайл(Элемент.Имя, Элемент.Имя,СсылкаНаМакет,
		НСтр("ru='Отсутствует изображение для просмотра';en='No picture to show'"));
	
КонецПроцедуры // Подключаемый_ПриНажатииНаИзображение()

////#КонецОбласти

////#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьМакетыНаФорме()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РекламнаяКампания", РекламнаяКампания);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	МакетыКампании.Ссылка КАК Макет,
		|	МакетыКампании.Наименование КАК Наименование,
		|	МакетыКампании.ФайлКартинки КАК ФайлКартинки,
		|	МакетыКампании.Согласован КАК Согласован,
		|	СтатусыМакетов.Статус КАК Статус,
		|	МакетыКампании.ДатаРегистрации КАК ДатаРегистрации
		|ИЗ
		|	Справочник.DMS_МакетыРекламнойКампании КАК МакетыКампании
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.DMS_СтатусыМакетовРекламныхКампаний.СрезПоследних(, ) КАК СтатусыМакетов
		|		ПО (СтатусыМакетов.МакетРекламнойКампании = МакетыКампании.Ссылка)
		|			И (СтатусыМакетов.РекламнаяКампания = МакетыКампании.РекламнаяКампания)
		|ГДЕ
		|	МакетыКампании.РекламнаяКампания = &РекламнаяКампания
		|
		|УПОРЯДОЧИТЬ ПО
		|	Макет
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаМакетов = РезультатЗапроса.Выбрать();
	
	// Создание реквизитов.
	ДобавляемыеРеквизиты = Новый Массив;
	
	Пока ВыборкаМакетов.Следующий() Цикл
		
		ИдентификаторМакета = СтрЗаменить(ВРег(Строка(ВыборкаМакетов.Макет.УникальныйИдентификатор())), "-", "x");
		
		//Реквизит "Макет"
		ИмяМакета = "Макет_" + ИдентификаторМакета;
		                                               
		ТипЗначенияМакета = Новый ОписаниеТипов("СправочникСсылка.DMS_МакетыРекламнойКампании");
			
		РеквизитМакет = Новый РеквизитФормы(ИмяМакета, ТипЗначенияМакета,,"", Ложь);
		
		ДобавляемыеРеквизиты.Добавить(РеквизитМакет);
		
		//Реквизит "ДатаРегистрации"
		ИмяМакета = "ДатаРегистрации_" + ИдентификаторМакета;
		                                               
		ТипЗначенияДатыРегистрации = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(15));
			
		РеквизитДатаРегистрации = Новый РеквизитФормы(ИмяМакета, ТипЗначенияДатыРегистрации,,"", Ложь);
		
		ДобавляемыеРеквизиты.Добавить(РеквизитДатаРегистрации);
		
		//Реквизит "Изображение"
		ИмяИзображения = "Изображение_" + ИдентификаторМакета;
		                                               
		ТипЗначенияИзображения = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(0));
			
		РеквизитИзображение = Новый РеквизитФормы(ИмяИзображения, ТипЗначенияИзображения,,"", Ложь);
		
		ДобавляемыеРеквизиты.Добавить(РеквизитИзображение);
		
		//Для каждого ТекущаяСтрока Из ВыборкаМакетов.Макет.КонтактнаяИнформация Цикл
		//	
		//	//Реквизит "Адрес"
		//	ИмяАдреса = "Адрес"+Формат(ТекущаяСтрока.НомерСтроки,"ЧЦ=10; ЧН=0; ЧГ=")+"_" + ИдентификаторМакета;
		//	
		//	ТипЗначенияАдреса = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(0));
		//	
		//	РеквизитИзображение = Новый РеквизитФормы(ИмяАдреса, ТипЗначенияАдреса,,"", Ложь);
		//	
		//	ДобавляемыеРеквизиты.Добавить(РеквизитИзображение);
		//	
		//КонецЦикла; 
		
	КонецЦикла; 	
	
   	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ВыборкаМакетов.Сбросить();
	
	НомерТекущейГруппы = 1;
	
	Пока ВыборкаМакетов.Следующий() Цикл
		
		Родитель = Элементы["ГруппаСписокМакетов"+Формат(НомерТекущейГруппы,"ЧЦ=1; ЧН=0; ЧГ=")];
		
		ИдентификаторМакета = СтрЗаменить(ВРег(Строка(ВыборкаМакетов.Макет.УникальныйИдентификатор())), "-", "x");
		
		//Группа макета общая
		ГруппаМакетаОбщая = Элементы.Добавить("ГруппаМакетаОбщая_"+ИдентификаторМакета,Тип("ГруппаФормы"),Родитель);
		ГруппаМакетаОбщая.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаМакетаОбщая.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		ГруппаМакетаОбщая.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
		ГруппаМакетаОбщая.ШиринаПодчиненныхЭлементов = ШиринаПодчиненныхЭлементовФормы.Одинаковая;
		
		//Группа макета
		ГруппаМакета = Элементы.Добавить("ГруппаМакета_"+ИдентификаторМакета,Тип("ГруппаФормы"),ГруппаМакетаОбщая);
		ГруппаМакета.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		
		//Элемент формы "Макет"
		
		ИмяМакета = "Макет_" + ИдентификаторМакета;
		
		Элемент = Элементы.Добавить(ИмяМакета, Тип("ПолеФормы"),ГруппаМакета);
 		Элемент.ПутьКДанным 			  = ИмяМакета;
		Элемент.Вид 					  = ВидПоляФормы.ПолеНадписи;
		Элемент.Гиперссылка 			  = Истина;
		Элемент.РастягиватьПоГоризонтали  = Ложь;
		Элемент.ПоложениеЗаголовка  	  = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
		ЭтаФорма[ИмяМакета] = ВыборкаМакетов.Макет;
		
		//Элемент формы "ДатаРегистрации"
		
		ИмяДекорацииДатаРегистрации = "ДекорацияДатаРегистрации_" + ИдентификаторМакета;
		
		Элемент = Элементы.Добавить(ИмяДекорацииДатаРегистрации, Тип("ДекорацияФормы"),ГруппаМакета);
		Элемент.Заголовок 			  	  = "Дата регистрации:";
		Элемент.РастягиватьПоГоризонтали  = Ложь;
		Элемент.ЦветТекста				  = ЦветаСтиля.DMS_ПоясняющийТекст;
		Элемент.Ширина				      = 15;
		
		ИмяМакета = "ДатаРегистрации_" + ИдентификаторМакета;
		
		Элемент = Элементы.Добавить(ИмяМакета, Тип("ПолеФормы"),ГруппаМакета);
 		Элемент.ПутьКДанным 			  = ИмяМакета;
		Элемент.Вид 					  = ВидПоляФормы.ПолеНадписи;
		Элемент.Гиперссылка 			  = Ложь;
		Элемент.РастягиватьПоГоризонтали  = Ложь;
		Элемент.ПоложениеЗаголовка  	  = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
		ЭтаФорма[ИмяМакета] = Формат(ВыборкаМакетов.ДатаРегистрации,"ДФ=dd.MM.yyyy; ДП='Нет даты'");
		
		//Элемент формы "Изображение"
		
		ИмяИзображения = "Изображение_" + ИдентификаторМакета;
		
		Элемент = Элементы.Добавить(ИмяИзображения, Тип("ПолеФормы"),ГруппаМакета);
 		Элемент.ПутьКДанным 			  = ИмяИзображения;
		Элемент.Вид 					  = ВидПоляФормы.ПолеКартинки;
		Элемент.Гиперссылка 			  = Истина;
		Элемент.РастягиватьПоГоризонтали  = Ложь;
		Элемент.РастягиватьПоВертикали	  = Ложь;
		Элемент.ПоложениеЗаголовка  	  = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Элемент.РазмерКартинки      	  = РазмерКартинки.Пропорционально;
		Элемент.Ширина      			  = 15;
		Элемент.Высота		         	  = 5;
		Элемент.ТекстНевыбраннойКартинки  = "<Нет изображения>";
		Элемент.УстановитьДействие("Нажатие","Подключаемый_ПриНажатииНаИзображение");
		
		Если ЗначениеЗаполнено(ВыборкаМакетов.ФайлКартинки) Тогда
			
			ЭтаФорма[ИмяИзображения] = ПолучитьНавигационнуюСсылку(ВыборкаМакетов.ФайлКартинки, "ФайлХранилище");
			
			//Элемент формы "Имя изображения"
			ИмяДекорацииИмяИзображения = "ДекорацияИмяИзображения_" + ИдентификаторМакета;
			
			Элемент = Элементы.Добавить(ИмяДекорацииИмяИзображения, Тип("ДекорацияФормы"),ГруппаМакета);
			Элемент.Заголовок 			  	  = СокрЛП(ВыборкаМакетов.ФайлКартинки.Наименование)+"."+СокрЛП(ВыборкаМакетов.ФайлКартинки.Расширение);
			Элемент.РастягиватьПоГоризонтали  = Ложь;
			Элемент.ЦветТекста				  = ЦветаСтиля.ТекстИнформационнойНадписи;
			Элемент.Ширина				      = 15;
			
			//Элемент формы "Размер изображения"
			ИмяДекорацииРазмерИзображения = "ДекорацияРазмерИзображения_" + ИдентификаторМакета;
			
			Элемент = Элементы.Добавить(ИмяДекорацииРазмерИзображения, Тип("ДекорацияФормы"),ГруппаМакета);
			Элемент.Заголовок 			  	  = ПолучитьСтроковоеПредставлениеРазмераФайла(ВыборкаМакетов.ФайлКартинки.Размер);
			Элемент.РастягиватьПоГоризонтали  = Ложь;
			Элемент.ЦветТекста				  = ЦветаСтиля.ТекстИнформационнойНадписи;
			Элемент.Ширина				      = 15;
			
		Иначе
			
			//Элемент формы "Имя изображения"
			ИмяДекорацииИмяИзображения = "ДекорацияИмяИзображения_" + ИдентификаторМакета;
			
			Элемент = Элементы.Добавить(ИмяДекорацииИмяИзображения, Тип("ДекорацияФормы"),ГруппаМакета);
			Элемент.Заголовок 			  	  = "Загрузить изображение";
			Элемент.РастягиватьПоГоризонтали  = Ложь;
			Элемент.ЦветТекста				  = ЦветаСтиля.ТекстИнформационнойНадписи;
			Элемент.Ширина				      = 15;
			Элемент.Гиперссылка				  = Истина;
			Элемент.УстановитьДействие("Нажатие","Подключаемый_ПриНажатииЗагрузитьИзображение");
			
			ЭтаФорма[ИмяИзображения] = "";
			
		Конецесли;
		
		Если Не ВыборкаМакетов.Согласован И (ВыборкаМакетов.Статус = Справочники.DMS_СтатусыМакетовРекламнойКампании.Заявлен 
			Или ВыборкаМакетов.Статус = Справочники.DMS_СтатусыМакетовРекламнойКампании.БезДействия) Тогда
			
			// Команда "Согласовать"
			
			ИмяКомандыСогласовать = "КомандаСогласовать_"+ИдентификаторМакета;
			
			ДобавляемаяКомандаСогласовать = Команды.Добавить(ИмяКомандыСогласовать);
			ДобавляемаяКомандаСогласовать.Действие = "Подключаемый_КомандаНажатиеСогласовать";
			
			НовыйЭлемент = Элементы.Добавить(ИмяКомандыСогласовать, Тип("КнопкаФормы"), ГруппаМакета);
			НовыйЭлемент.Заголовок   = "Согласовать";	
			НовыйЭлемент.ИмяКоманды  = ИмяКомандыСогласовать;	
			НовыйЭлемент.Картинка    = БиблиотекаКартинок.Утвержден;	
			НовыйЭлемент.Отображение = ОтображениеКнопки.КартинкаИТекст;
			
		Иначе 
			
			//Элемент формы "ДекорацияНаСогласовании"
			ИмяДекорацииНаСогласовании = "ДекорацияНаСогласовании_" + ИдентификаторМакета;
			
