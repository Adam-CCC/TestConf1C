#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////#Область ОбработчикиСобытий

Процедура ПриУстановкеНовогоКода(СтандартнаяОбработка, Префикс)
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
	//Если НЕ спПриУстановкеНовогоКода(ЭтотОбъект, СтандартнаяОбработка, Префикс) Тогда Возврат; КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 	
	
	DMS_РекламныеКампанииСервер.ОтразитьСтатусМакетаРекламнойКампании(Ссылка,Ссылка,ДатаРегистрации,Справочники.DMS_СтатусыМакетовРекламнойКампании.Заявлен,Отказ);	
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("РекламнаяКампания") Тогда
			РекламнаяКампания = ДанныеЗаполнения.РекламнаяКампания
		КонецЕсли; 
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.DMS_РекламнаяКампания") Тогда 
		РекламнаяКампания = ДанныеЗаполнения
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(РекламнаяКампания) Тогда
		
		Если РекламнаяКампания.ВидОперации = Перечисления.DMS_ВидыОперацийРекламнойКампании.СозданиеШаблона Тогда
			ВызватьИсключение "Создание макетов возможно только для кампаний с операцией <Размещение кампании>";
		КонецЕсли; 
		
		Представитель  = РекламнаяКампания.Представитель;
		ДилерскийЦентр = РекламнаяКампания.ДилерскийЦентр;
		МедиаРесурс    = РекламнаяКампания.МедиаРесурс;
		
	КонецЕсли; 	
	
	Автор = DMS_РекламныеКампанииСервер.ТекущийПользователь();
	
	ВАрхиве    = Ложь;
	Согласован = Ложь;
	
	ДатаРегистрации = ТекущаяДатаСеанса();
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Автор = DMS_РекламныеКампанииСервер.ТекущийПользователь();
	ВАрхиве    = Ложь;
	Согласован = Ложь;
	ДатаРегистрации = ТекущаяДатаСеанса();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	
	 DMS_ОбщегоНазначенияСервер.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты,МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

