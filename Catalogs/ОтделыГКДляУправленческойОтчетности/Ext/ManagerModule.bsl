Функция ПолучитьДеревоСправочника() Экспорт	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтделыГКДляУправленческойОтчетности.Ссылка КАК Ссылка,
		|	ОтделыГКДляУправленческойОтчетности.Родитель КАК РодительСсылка
		|ИЗ
		|	Справочник.ОтделыГКДляУправленческойОтчетности КАК ОтделыГКДляУправленческойОтчетности
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОтделыГКДляУправленческойОтчетности.Код";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ДеревоСправочника = Новый ДеревоЗначений;
	ДеревоСправочника.Колонки.Добавить("Ссылка"			,Новый ОписаниеТипов("СправочникСсылка.ОтделыГКДляУправленческойОтчетности"));
	ДеревоСправочника.Колонки.Добавить("РодительСсылка"	,Новый ОписаниеТипов("СправочникСсылка.ОтделыГКДляУправленческойОтчетности"));
	
	Для Каждого Строка Из РезультатЗапроса Цикл
		Если Не ЗначениеЗаполнено(Строка.РодительСсылка) Тогда
			НоваяСтрока = ДеревоСправочника.Строки.Добавить();
			НоваяСтрока.Ссылка = Строка.Ссылка;
			НоваяСтрока.РодительСсылка = Строка.РодительСсылка;
		Иначе
			ПоискСтроки = ДеревоСправочника.Строки.Найти(Строка.РодительСсылка,"Ссылка");
			Если ПоискСтроки <> Неопределено Тогда
				НоваяСтрока = ПоискСтроки.Строки.Добавить();
				НоваяСтрока.Ссылка = Строка.Ссылка;
				НоваяСтрока.РодительСсылка = ПоискСтроки.Ссылка;
			Иначе
				НоваяСтрока = ДеревоСправочника.Строки.Добавить();
				НоваяСтрока.Ссылка = Строка.Ссылка;
				НоваяСтрока.РодительСсылка = Строка.РодительСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	МассивЭлементовНаУдаление = Новый Массив;
	
	Для Каждого Строка Из ДеревоСправочника.Строки Цикл                                 
		Если Не ЗначениеЗаполнено(Строка.РодительСсылка) Тогда
			Продолжить;
		КонецЕсли;
		ПоискСтроки = ДеревоСправочника.Строки.Найти(Строка.РодительСсылка,"Ссылка",Истина);
		Если ПоискСтроки <> Неопределено Тогда
			РекурсивныйОбходСтроки(Строка,ПоискСтроки);
			МассивЭлементовНаУдаление.Добавить(Строка);
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;    
	
	Для Каждого Строка Из МассивЭлементовНаУдаление Цикл
		ДеревоСправочника.Строки.Удалить(Строка);
	КонецЦикла;
	
	Возврат ДеревоСправочника; 
КонецФункции 

Процедура РекурсивныйОбходСтроки(ТекущаяСтрока,НайденнаяСтрока)
    НоваяСтрока = НайденнаяСтрока.Строки.Добавить();
	НоваяСтрока.Ссылка = ТекущаяСтрока.Ссылка;
	
	Для Каждого Строка Из ТекущаяСтрока.Строки Цикл 
		Если Строка.Строки.Количество() > 0 Тогда
			РекурсивныйОбходСтроки(Строка,НоваяСтрока);
		Иначе
			НоваяСтрокаУровня = НоваяСтрока.Строки.Добавить();
			НоваяСтрокаУровня.Ссылка = Строка.Ссылка; 
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры