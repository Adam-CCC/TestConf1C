	//Если меняется номер ячейки, то нужно это отразить в регистре
	Попытка
		Если Ссылка.Код <> Код Тогда
			//Узнаем, не было ли записей от того же пользователя в течение 5 минут, если были, то не будем писать.
			ДатаЗаписи = ТекущаяДата();
			
			ЗапросНоменклатуры = Новый Запрос();
			ЗапросНоменклатуры.Текст = "ВЫБРАТЬ
			                           |	НоменклатураЯчейкиХранения.Ссылка КАК Номенклатура
			                           |ПОМЕСТИТЬ НоменклатураДляЗаписи
			                           |ИЗ
			                           |	Справочник.Номенклатура.ЯчейкиХранения КАК НоменклатураЯчейкиХранения
			                           |ГДЕ
			                           |	НоменклатураЯчейкиХранения.ЯчейкаХранения = &ЯчейкаХранения
			                           |
			                           |СГРУППИРОВАТЬ ПО
			                           |	НоменклатураЯчейкиХранения.Ссылка,
			                           |	НоменклатураЯчейкиХранения.СкладКомпании
			                           |;
			                           |
			                           |////////////////////////////////////////////////////////////////////////////////
			                           |ВЫБРАТЬ
			                           |	НоменклатураДляЗаписи.Номенклатура,
			                           |	ИсторияСкладскихЯчеекСрезПоследних.Период
			                           |ИЗ
			                           |	НоменклатураДляЗаписи КАК НоменклатураДляЗаписи
			                           |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияСкладскихЯчеек.СрезПоследних(, СкладКомпании = &СкладДляПроверки) КАК ИсторияСкладскихЯчеекСрезПоследних
			                           |		ПО НоменклатураДляЗаписи.Номенклатура = ИсторияСкладскихЯчеекСрезПоследних.Номенклатура
			                           |			И (ИсторияСкладскихЯчеекСрезПоследних.Пользователь = &Пользователь
			                           |				И РАЗНОСТЬДАТ(ИсторияСкладскихЯчеекСрезПоследних.Период, &ДатаПроверки, МИНУТА) < 5)
			                           |ГДЕ
			                           |	ИсторияСкладскихЯчеекСрезПоследних.Период ЕСТЬ NULL";
			ЗапросНоменклатуры.УстановитьПараметр("ЯчейкаХранения", Ссылка);
			ЗапросНоменклатуры.УстановитьПараметр("ДатаПроверки", ДатаЗаписи);
			ЗапросНоменклатуры.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
			ЗапросНоменклатуры.УстановитьПараметр("СкладДляПроверки", Владелец);
			
			
			РезультатЗапроса = ЗапросНоменклатуры.Выполнить();
			Если НЕ РезультатЗапроса.Пустой() Тогда
				
				НаборЗаписейРегистра = РегистрыСведений.ИсторияСкладскихЯчеек.СоздатьНаборЗаписей();
				НаборЗаписейРегистра.Отбор.СкладКомпании.Установить(Владелец);
				НаборЗаписейРегистра.Прочитать();
				
				ВыборкаИзЗапроса = РезультатЗапроса.Выбрать();
				Пока ВыборкаИзЗапроса.Следующий() Цикл
					СтрокаРегистра = НаборЗаписейРегистра.Добавить();
					СтрокаРегистра.Номенклатура = ВыборкаИзЗапроса.Номенклатура;
					СтрокаРегистра.СкладКомпании = Владелец;
					СтрокаРегистра.НомерЯчейки = Ссылка.Код;
					СтрокаРегистра.Пользователь = ПараметрыСеанса.Пользователь;
					СтрокаРегистра.Период = ДатаЗаписи;
				КонецЦикла;
				НаборЗаписейРегистра.Записать();
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция ПривестиИдентификатор(Идентификатор)
	Попытка 
		Идентификатор = Формат(Число(СокрЛП(Идентификатор)), "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	Исключение
		Идентификатор = СокрЛП(Идентификатор);
	КонецПопытки;
	Возврат Идентификатор;
КонецФункции

