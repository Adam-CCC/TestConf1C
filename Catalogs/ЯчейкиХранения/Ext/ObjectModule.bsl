// Стандартный обработчик ПередЗаписью элемента справочника
Процедура ПередЗаписью(Отказ)
	Если НЕ спПередЗаписью(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
	Отказ = Отказ ИЛИ ОчиститьМакетСклада();
	// свойство Недоступна должно меняться при смене пометки удаления
	Если НЕ Отказ И НЕ ЭтоГруппа И НЕ (ПометкаУдаления = ЭтотОбъект.Ссылка.ПометкаУдаления) Тогда
		Недоступна = ПометкаУдаления;
	КонецЕсли;	
	
	//Корельский
	//Если изменился НомерЯчейки для иерархической структуры, то нужно менять код;
	НомерЯчейкиДляПроверки = ПривестиИдентификатор(НомерЯчейки);
	Если Ссылка.НомерЯчейки <> НомерЯчейкиДляПроверки И ЗначениеЗаполнено(Стеллаж) Тогда
		НомерЯчейки = НомерЯчейкиДляПроверки;
		Код = Полка.Код + "-" + НомерЯчейки;
	КонецЕсли;
	
	Если НЕ ЭтоНовый() И НЕ Отказ Тогда
		ЗаписатьИзмененияНоменклатуре();
	КонецЕсли;
	
	//}
КонецПроцедуры // ПередЗаписью()

// Стандартный обработчик ПриЗаписи элемента справочника
Процедура ПриЗаписи(Отказ)
	Если НЕ спПриЗаписи(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
	
	//Бондаренко 20151021 ++
	
	ТекЯчейкаОбъект = ЭтотОбъект;
	ТекАвтор = ПараметрыСеанса.Пользователь;
	ТекВалюта = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	ТекВид = Перечисления.ВидыНоменклатуры.Адрес;
	ТекТип = Справочники.ТипыНоменклатуры.Адрес;
	ТекСтавкаНДС = Справочники.СтавкиНДС.БезНДС;
	ТекСпособРаспределенияДопРасходов=Перечисления.СпособыРаспределенияДопРасходов.НаДоходыИРасходы;
	ТекСтатьяДопРасходов=Справочники.СтатьиДоходовИРасходов.Операционные;
	ТекБазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;
	ТекПроизводитель = Справочники.Производители.Неизвестен;
	ТекСтрана = ТекПроизводитель.СтранаПроисхождения;
	ТекГруппаНоменклатуры = Справочники.Номенклатура.Адреса;
	
	НовЭл = Справочники.Номенклатура.ПустаяСсылка();
	
	АртикулПоиска = СокрЛП(ЭтотОбъект.Код);
	
	НовЭл = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",АртикулПоиска);
	
	ФлНовый=Ложь;
	
	Если НовЭл = Справочники.Номенклатура.ПустаяСсылка() Тогда
		НовЭл = Справочники.Номенклатура.СоздатьЭлемент();
		ФлНовый = Истина;
	Иначе
		НовЭл = НовЭл.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если ФлНовый Тогда
		НовЭл.Автор = ТекАвтор;
		НовЭл.Артикул = АртикулПоиска;
		НовЭл.БазоваяЕдиницаИзмерения = ТекБазоваяЕдиницаИзмерения;
		НовЭл.Наименование = АртикулПоиска;
		НовЭл.НаименованиеИностранное = АртикулПоиска;
		НовЭл.НаименованиеПолное = АртикулПоиска;
		НовЭл.Производитель = ТекПроизводитель;
		НовЭл.СтранаПроисхождения = ТекСтрана;
		НовЭл.Родитель = ТекГруппаНоменклатуры;
		НовЭл.ВидНоменклатуры=ТекВид ;
		НовЭл.ТипНоменклатуры=ТекТип; 
		НовЭл.СтавкаНДС=ТекСтавкаНДС;
		НовЭл.ВалютаУчета=ТекВалюта;
		НовЭл.СпособРаспределенияДопРасходов=ТекСпособРаспределенияДопРасходов;
		НовЭл.СтатьяДопРасходов=ТекСтатьяДопРасходов;
		НовЭл.ЗапретЗакупки=Истина;
		НовЭл.ЗапретПродажи=Истина;
		НовЭл.СнятаСПроизводства=Истина;
		НовЭл.Комментарий="Элемент создан при записи ячейки "+ТекущаяДата()+" пользователем "+ТекАвтор;
		//Бондаренко++ 20201029
		НовЭл.УстановитьНовыйКод("");
		//Бондаренко-- 20201029
		
		Попытка 
			НовЭл.Записать();
			//Сообщить("1).Записан элемент "+НовЭл,СтатусСообщения.Информация);		
		Исключение
			Сообщить("1).ОШИБКА!!! Не удалось записать элемент.",СтатусСообщения.ОченьВажное);		
		КонецПопытки;
		
		СпрЕдИзм = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		СпрЕдИзм.Владелец = НовЭл.Ссылка;
		СпрЕдИзм.ЕдиницаПоКлассификатору=Справочники.КлассификаторЕдиницИзмерения.шт;
		СпрЕдИзм.Наименование = Справочники.КлассификаторЕдиницИзмерения.шт;
		СпрЕдИзм.Коэффициент=1;
		//Бондаренко++ 20201029
		СпрЕдИзм.УстановитьНовыйКод("");
		//Бондаренко-- 20201029

		СпрЕдИзм.Записать();
		
		НовЭл.ОсновнаяЕдиницаИзмерения=СпрЕдИзм.Ссылка;
		
		Попытка 
			НовЭл.Записать();
			//Сообщить("2).Записан элемент "+НовЭл,СтатусСообщения.Внимание);		
		Исключение
			Сообщить("2).ОШИБКА!!! Не удалось записать элемент.",СтатусСообщения.ОченьВажное);		
		КонецПопытки;
	КонецЕсли; 
	
	
	ШК = "";
	
	НаборЗаписей = РегистрыСведений.ШтрихКоды.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(НовЭл.Ссылка);
	НаборЗаписей.Прочитать();
	
	Для каждого ЗаписьТек Из НаборЗаписей Цикл
		ШК = ЗаписьТек.ШтрихКод;
		Прервать;
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(ШК) Тогда
		НовЗапРег = РегистрыСведений.ШтрихКоды.СоздатьМенеджерЗаписи();
		НовЗапРег.Объект = ТекЯчейкаОбъект.Ссылка;
		НовЗапРег.ШтрихКод = ШК;
		НовЗапРег.ВыгружатьВОборудование=Ложь;
		Попытка
			НовЗапРег.Записать();
			Сообщить("Записан ШтрихКод = "+ШК+" для ячейки "+ТекЯчейкаОбъект.Ссылка,СтатусСообщения.Информация);
		Исключение
			Сообщить("ОШИБКА! Не удалось записать ШтрихКод = "+ШК+" для ячейки "+ТекЯчейкаОбъект.Ссылка,СтатусСообщения.ОченьВажное);
		КонецПопытки;	
	КонецЕсли; 
   	
	//Бондаренко 20151021 --
КонецПроцедуры // ПриЗаписи()

