Процедура ПередЗаписью(Отказ)
	
	Отказ = Ложь;
 	Отбор = Новый Структура();
	Отбор.Вставить("Наименование",ЭтотОбъект.Наименование);
	Выборка = Справочники.ДоменныеЗоны.Выбрать(,,Отбор,);
	
	Пока Выборка.Следующий() Цикл
		СМГ_Сообщить("ОШИБКА! Уже существует элемент с наименованием "+Выборка.ПолучитьОбъект().Наименование,СтатусСообщения.ОченьВажное);
		Отказ = Истина;
		Возврат;
	КонецЦикла;
   	
КонецПроцедуры
