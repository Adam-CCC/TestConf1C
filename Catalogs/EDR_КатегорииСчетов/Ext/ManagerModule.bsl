Функция ПолучитьОписаниеТипов() Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("СправочникСсылка.EDR_КатегорииСчетов"));
	Массив.Добавить(Тип("Строка"));
	
	СтрокаНаименования = Новый КвалификаторыСтроки(100);
	
	ОписаниеТипа = Новый ОписаниеТипов(массив, , СтрокаНаименования);
	
	Возврат ОписаниеТипа;
	
КонецФункции // ПолучитьОписаниеТипов()
