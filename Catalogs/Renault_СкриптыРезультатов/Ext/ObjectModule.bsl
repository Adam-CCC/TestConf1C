Функция ПолучитьИтоговыйТекст(ТаблицаОбъектов) Экспорт
	
	МассивЭлементов = ПолучитьМассивПараметров();
	ТаблицаВсего = РасшифроватьПараметры(МассивЭлементов, ТаблицаОбъектов);
	
	Текст = ЭтотОбъект.ТекстСценария;
	
	Для Каждого Ст из ТаблицаВсего Цикл
		
		Если ЗначениеЗаполнено(Ст.РасшифровкаПараметра) Тогда
			
			Текст = СтрЗаменить(Текст, "[" + Ст.Параметр + "]", Ст.РасшифровкаПараметра);
			
		Иначе
			
			Текст = СтрЗаменить(Текст, "[" + Ст.Параметр + "]", " __ ");
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Текст;
	
	
КонецФункции

Функция ПолучитьМассивПараметров() Экспорт
	
	Текст = ЭтотОбъект.ТекстСценария;
	
	Если ЗначениеЗаполнено(Текст) Тогда
	
	Скобка = Найти(Текст, "[");
	МассивПараметров = Новый Массив(); 
	
		Если Скобка > 0 Тогда
		
		Стр = обРазложитьСтрокуВМассивПодстрок(Текст,"[");
		ЭтоПрев = Истина;
			Для Каждого Строк из Стр Цикл
				Если ЭтоПрев Тогда
					ЭтоПрев = Ложь;
					Продолжить;
				КонецЕсли;
				
				Стр2 = обРазложитьСтрокуВМассивПодстрок(Строк, "]");
				МассивПараметров.Добавить(Стр2[0]);
				
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат МассивПараметров;
	
КонецФункции

Функция РасшифроватьПараметры(МассивПараметров, ТаблицаОбъектов)
	
	ТЗ = Новый ТаблицаЗначений();
//	ТЗ.Колонки.Добавить("Параметр", Новый ОписаниеТипов("Строка"));
//	ТЗ.Колонки.Добавить("ИмяПараметра", Новый ОписаниеТипов("Строка"));
//	ТЗ.Колонки.Добавить("РасшифровкаПараметра", Новый ОписаниеТипов("Строка"));
	
	ТЗ.Колонки.Добавить("Параметр");
	ТЗ.Колонки.Добавить("ИмяПараметра");
	ТЗ.Колонки.Добавить("РасшифровкаПараметра");
	
	ТаблицаОбъекты = ТаблицаОбъектов;
	
	Для Каждого Параметр из МассивПараметров Цикл
		
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Параметр = Параметр;
		
		Пар = обРазложитьСтрокуВМассивПодстрок(Параметр, ".");
		
		Если Пар[0] = "Спр" Тогда
			
			Пар[0] = "Справочник";
			
		ИначеЕсли Пар[0] = "Док" Тогда
			
			Пар[0] = "Документ";
			
		ИначеЕсли Пар[0] = "Рег" Тогда
			
			Пар[0] = "РегистрСведений";
			
		КонецЕсли;
		
		НоваяСтрока.ИмяПараметра = Пар[0]+ "." + Пар[1] + "." + Пар[2];
		
		СтрокаОбъекта = ТаблицаОбъекты.Найти(Пар[0] + "." + Пар[1], "СсылкаСтрока");
		
		Если СтрокаОбъекта <> Неопределено Тогда 
		
			Если ЗначениеЗаполнено(СтрокаОбъекта.ЭлементДляПроверки) Тогда
				
				Объект = СтрокаОбъекта.ЭлементДляПроверки.Ссылка;
				
				Если Пар[2] = "ОстатокБаллов" Тогда
					РасшифрокаПараметра = ПолучитьОстатокБаллов(Объект);
				Иначе
					РасшифрокаПараметра = Объект[Пар[2]];
				КонецЕсли;
				
				НоваяСтрока.РасшифровкаПараметра = РасшифрокаПараметра;
				
			Иначе
				
				НоваяСтрока.РасшифровкаПараметра = Параметр;
				
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока.РасшифровкаПараметра = " __ ";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

Функция ПолучитьОстатокБаллов(КартаЛояльности)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_ОстаткиБалловОстатки.КоличествоБалловОстаток КАК Остаток_Баллов
	|ИЗ
	|	РегистрНакопления.Renault_ОстаткиБаллов.Остатки(
	|			&ТекущаяДата,
	|			КартаЛояльности = &КартаЛояльности
	|				И (ПогаситьДо >= &ТекущаяДата
	|					ИЛИ ПогаситьДо = &ПустаяДата)) КАК Renault_ОстаткиБалловОстатки";
	
	Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101")); 
	Запрос.УстановитьПараметр("КартаЛояльности", КартаЛояльности);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Остаток_Баллов;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции
