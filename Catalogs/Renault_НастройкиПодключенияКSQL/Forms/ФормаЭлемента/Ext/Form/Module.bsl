
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
КонецПроцедуры


&НаКлиенте
Процедура ТестПодключения(Команда)

    Если ЭтаФорма.Модифицированность Тогда
        Сообщить("Перед проверкой настройка должна быть сохранена");
        Возврат;
    КонецЕсли;

    СтрокаПодключения = Справочники.Renault_НастройкиПодключенияКSQL.ПолучитьСтрокуПодключения(Объект.Ссылка);

    Попытка
        Подключение = Новый COMОбъект("ADODB.Connection");
    Исключение
        Сообщить("Не удалось поключить компоненту ADODB.Connection");
        СообщитьОбОшибке(ИнформацияОбОшибке());
        Возврат;
    КонецПопытки;

    Попытка
        Подключение.open(СтрокаПодключения);
    Исключение
        Сообщить("Не удалось соединиться с базой данных");
        СообщитьОбОшибке(ИнформацияОбОшибке());
        Возврат;
    КонецПопытки;

    Попытка
        Подключение.Execute("SELECT SUM(*) FROM " + Объект.БазаДанных + ".A2A_DATA");
    Исключение
        Сообщить("Не удалось выполнить запрос к базе данных");
        СообщитьОбОшибке(ИнформацияОбОшибке());
        Возврат;
    КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбОшибке(Инфо)
    Сообщить(НСтр("en='Description =';ru='Описание='")      + Инфо.Описание);
    Сообщить(НСтр("en='ImyaModulya =';ru='ИмяМодуля='")      + Инфо.ИмяМодуля);
    Сообщить(НСтр("en='NomerStroki =';ru='НомерСтроки='")    + Инфо.НомерСтроки);
    Сообщить(НСтр("en='IskhodnayaStroka =';ru='ИсходнаяСтрока='") + Инфо.ИсходнаяСтрока);
КонецПроцедуры

