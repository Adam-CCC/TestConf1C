Функция ПолучитьСтрокуПодключения(Настройка) Экспорт

    СтрокаПодключения =   "DRIVER="   + Настройка.Драйвер +
                        "; SERVER="   + Настройка.АдресСервера +
                        "; DATABASE=" + Настройка.БазаДанных +
                        "; UID="      + Настройка.Логин +
                        "; PWD="      + Настройка.Пароль + ";";

    Возврат СтрокаПодключения;

КонецФункции
