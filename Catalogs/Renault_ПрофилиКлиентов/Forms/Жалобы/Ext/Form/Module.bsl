
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивКлиентов = Параметры.Клиенты.ВыгрузитьЗначения();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	DMS_ОбращениеКлиента.Описание КАК Жалоба,
	               |	DMS_ОбращениеКлиента.Комментарий КАК Результат,
	               |	DMS_ОбращениеКлиента.Дата КАК Дата
	               |ИЗ
	               |	Документ.ЖалобаКлиента КАК ЖалобаКлиента,
	               |	Документ.DMS_ОбращениеКлиента КАК DMS_ОбращениеКлиента
	               |ГДЕ
	               |	DMS_ОбращениеКлиента.Контрагент В(&МассивКлиентов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";
	Запрос.УстановитьПараметр("МассивКлиентов", МассивКлиентов);
	ТаблицаВзаимодействия.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

