
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.КоличествоКлиентов.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.КоличествоКлиентов");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Больше;
	ОтборЭлемента.ПравоеЗначение = 1;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", ">1");
	
КонецПроцедуры // УстановитьУсловноеОформление()

&НаКлиенте
Процедура ЗаполнитьПрофили(Команда)
	
	ЗаполнитьПрофилиНаСервере();
	Состояние("Заполнение родственных связей");
	ЗаполнитьРодствоВПрофиляхНаСервере();
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПрофилиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ЭтоГруппа
		|	И Контрагенты.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКонтрагентов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаКонтрагентов.Следующий() Цикл
		Справочники.Renault_ПрофилиКлиентов.СоздатьИзменитьПрофильКонтрагента(ВыборкаКонтрагентов.Ссылка);
		Справочники.Renault_ПрофилиКлиентов.ЗаполнитьРодственников(ВыборкаКонтрагентов.Ссылка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	CRM_ПотенциальныеКонтрагенты.Ссылка 
		|ИЗ
		|	Справочник.CRM_ПотенциальныеКонтрагенты КАК CRM_ПотенциальныеКонтрагенты
		|ГДЕ
		|	НЕ CRM_ПотенциальныеКонтрагенты.ЭтоГруппа";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПотенциальныхКонтрагентов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаПотенциальныхКонтрагентов.Следующий() Цикл
		Справочники.Renault_ПрофилиКлиентов.СоздатьИзменитьПрофильПотенциальногоКонтрагента(ВыборкаПотенциальныхКонтрагентов.Ссылка);
		Справочники.Renault_ПрофилиКлиентов.ЗаполнитьРодственников(ВыборкаПотенциальныхКонтрагентов.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

