	ФормаКоммуникации = Документы.Renault_CommunicationCenter_Обзвон.ПолучитьФормуСписка();
	ФормаКоммуникации.Отбор.Клиент.ВидСравнения  = ВидСравнения.ВСписке;
	ФормаКоммуникации.Отбор.Клиент.Использование = Истина;
	ФормаКоммуникации.Отбор.Клиент.Значение      = СписокКлиентов;
	
