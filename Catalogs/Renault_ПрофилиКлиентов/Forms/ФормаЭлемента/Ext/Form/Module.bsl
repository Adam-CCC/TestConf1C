
Процедура ОбновитьПрофильКлиента()
	
	КоличествоКлиентов = Объект.Клиенты.Количество();
	
	Если КоличествоКлиентов = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// Установим отбор
	Ограничения = Новый Структура;
	Ограничения.Вставить("ДатаНачала",    Дата(1, 1, 1));
	Ограничения.Вставить("ДатаОкончания", ТекущаяДата());
	
	//для начала добавим в список все выбранные документы по текущему контрагенту
	Клиенты_ = Объект.Клиенты.Выгрузить().ВыгрузитьКолонку("Клиент");
	Для Каждого Клиент Из Клиенты_ Цикл
		Ограничения.Вставить("Контрагент", Клиент);
		Если ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
			ТаблицаДокументов = Renault_ПолучитьСписокПодтверждающихДокументов(Клиент);
			Для Каждого ТекСтрока Из ТаблицаДокументов Цикл
				НоваяСтрока = КлиентыПрофиля.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Renault_ДобавитьВПрофильРабочиеЛистыКлиентов(Клиенты_);
	ПрочитатьТрафикКлиентов(Клиенты_);
	
	СписокКлиентов.ЗагрузитьЗначения(Клиенты_);
	
	ТЗ = КлиентыПрофиля.Выгрузить();
	ТЗ.Свернуть("Активность,Дата,ID,ТипID");
	КлиентыПрофиля.Загрузить(ТЗ);
	КлиентыПрофиля.Сортировать("Дата Убыв");
		
	Клиент = Объект.Клиенты[Объект.Клиенты.Количество()-1].Клиент;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление КАК Представление,
		|	КонтактнаяИнформация.Тип
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект В(&Клиенты)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КонтактнаяИнформация.Тип,
		|	КонтактнаяИнформация.Вид";
		
	Запрос.УстановитьПараметр("Клиенты", Клиенты_);
	ВсеКонтакты = Запрос.Выполнить().Выгрузить();
		
	КоличествоКонтактов = ВсеКонтакты.Количество();
	
	Телефонс = ВсеКонтакты.Найти(Перечисления.ТипыКонтактнойИнформации.Телефон, "Тип");
	
	Если ЗначениеЗаполнено(Телефонс) Тогда
		
		Телефон = Телефонс.Представление;
		
	КонецЕсли;
	
	Почтас = ВсеКонтакты.Найти(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, "Тип");
	
	Если ЗначениеЗаполнено(Почтас) Тогда
		
		EMail = Почтас.Представление;
		
	КонецЕсли;
	
	ПрочитатьАвтомобили();
	
	////////////////////////////////////////
	//Временное заполнение профиля
	////////////////////////////////////////
	//
	//Автомобили.Добавить();
	//Автомобили.Добавить();
	//Автомобили.Добавить();
	//Автомобили.Добавить();
	
	Наименование = Клиент.Наименование;
	
	Если Клиент.ДатаРождения < НачалоДня(ТекущаяДата()) И ЗначениеЗаполнено(Клиент.ДатаРождения) Тогда
	
		ВозрастПоГодам = Цел((ТекущаяДата() - Клиент.ДатаРождения)/(365*86400));
		
	Иначе
		
		ВозрастПоГодам = 0;
		
	КонецЕсли;
	
	Пол = "пол не определен";
	
	Если ЗначениеЗаполнено(Клиент.Пол) Тогда
		
		Если Клиент.Пол = Перечисления.ПолФизическихЛиц.Мужской Тогда
			
			Пол = "Мужчина";
			
		ИначеЕсли Клиент.Пол = Перечисления.ПолФизическихЛиц.Женский Тогда
			
			Пол = "Женщина";
			
		Иначе
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПолВозраст = Пол + ", " + Строка(?(ВозрастПоГодам >0, ВозрастПоГодам, "(возвраст не указан)"));
	ДокументыКлиента = "Документы ";
	
	Если ТаблицаДокументов <> Неопределено И ТаблицаДокументов.Количество() > 0 Тогда
		
		ДокументыКлиента = ДокументыКлиента +"(" + Строка(ТаблицаДокументов.Количество()) + "):";
		
		Если ТаблицаДокументов.Количество() > 1 Тогда
			
			ДокументыКлиента = ДокументыКлиента + Строка(ТаблицаДокументов[0].Наименование) + ", " + Строка(ТаблицаДокументов[1].Наименование);
			
			
		Иначе
			
			ДокументыКлиента = ДокументыКлиента + Строка(ТаблицаДокументов[0].Наименование);
			
		КонецЕсли;
		
	Иначе
		
		ДокументыКлиента = ДокументыКлиента + "(документы не найдены)";
		
	КонецЕсли;
	
	//(2): Паспорт, Водительское удостоверение";
	АккаунтыКлиента = "Аккаунты (0)";
	СвязанныеПрофилиКлиента = "Связанные профили (0)";
	
	Если Автомобили.Количество() > 0 Тогда
		
		Если Автомобили.Количество() = 1 Тогда
			
			АвтомобилиКлиента = Строка(Автомобили[0].Автомобиль);
			
		Иначе
			
			АвтомобилиКлиента = Строка(Автомобили[0].Автомобиль) + " и еще " + Строка(Автомобили.Количество() - 1) + " авто";
			
		КонецЕсли;
		
	Иначе
		
		АвтомобилиКлиента = "Нет известных автомобилей"		
		
	КонецЕсли;
	
	ПолучитьВсеПродуктыКлиента();
	
	ВсеПродукты.Сортировать("ДатаНачалаДействия Убыв");
	
	Если ВсеПродукты.Количество() > 0 Тогда
		
		Если ВсеПродукты.Количество() = 1 Тогда
			
			ПродуктыКлиента = "1 продукт с "  + Строка(Формат(ВсеПродукты[0].ДатаНачалаДействия, "ДФ=гггг")) + " года";
			ПродуктКлиента1 = Строка(ВсеПродукты[0].ТипПродукта) + " - " + Строка(ВсеПродукты[0].Продукт);
			
		ИначеЕсли ВсеПродукты.Количество() = 2 Тогда 
			
			ПродуктыКлиента = "2 продукта начиная с "  + Строка(Формат(ВсеПродукты[0].ДатаНачалаДействия, "ДФ=гггг")) + " года";
			ПродуктКлиента1 = Строка(ВсеПродукты[0].ТипПродукта) + " - " + Строка(ВсеПродукты[0].Продукт);
			ПродуктКлиента2 = Строка(ВсеПродукты[1].ТипПродукта) + " - " + Строка(ВсеПродукты[1].Продукт);
			
		ИначеЕсли ВсеПродукты.Количество() = 3 Тогда 
			
			ПродуктыКлиента = "3 продукта начиная с "  + Строка(Формат(ВсеПродукты[0].ДатаНачалаДействия, "ДФ=гггг")) + " года";
			ПродуктКлиента1 = Строка(ВсеПродукты[0].ТипПродукта) + " - " + Строка(ВсеПродукты[0].Продукт);
			ПродуктКлиента2 = Строка(ВсеПродукты[1].ТипПродукта) + " - " + Строка(ВсеПродукты[1].Продукт);
			ПродуктКлиента3 = Строка(ВсеПродукты[2].ТипПродукта) + " - " + Строка(ВсеПродукты[2].Продукт);
			
		ИначеЕсли ВсеПродукты.Количество() > 3 Тогда 
			
			ПродуктыКлиента = "Несколько (" + Строка(ВсеПродукты.Количество()) + ") продуктов начиная с "  + Строка(Формат(ВсеПродукты[0].ДатаНачалаДействия, "ДФ=гггг")) + " года";
			ПродуктКлиента1 = Строка(ВсеПродукты[0].ТипПродукта) + " - " + Строка(ВсеПродукты[0].Продукт);
			ПродуктКлиента2 = Строка(ВсеПродукты[1].ТипПродукта) + " - " + Строка(ВсеПродукты[1].Продукт);
			ПродуктКлиента3 = Строка(ВсеПродукты[2].ТипПродукта) + " - " + Строка(ВсеПродукты[2].Продукт);
			
		КонецЕсли;
		
	Иначе
		
		ПродуктыКлиента = "Нет известных продуктов";
		
	КонецЕсли;
	
	ИнтересыКлиента = "Интересы (0)";
	
	//Получим все предложения
	ПрочитатьПредложения();
	
	Если ВсеПредложения.Количество() > 0 Тогда
		
		ПредложитьКлиенту = "Предложить (" + Строка(ВсеПредложения.Количество()) + ")";
		
		ПредложитьКлиенту1 = ВсеПредложения[0].Источник + " - " + ВсеПредложения[0].ТипПредложения;
		
		Если ВсеПредложения.Количество() > 1 Тогда
			
			ПредложитьКлиенту2 = ВсеПредложения[1].Источник + " - " + ВсеПредложения[1].ТипПредложения;
			
		КонецЕсли;
		
	Иначе
		
		ПредложитьКлиенту = "Пока нечего предложить клиенту"; 
		
	КонецЕсли;
	
	КонтактыКлиента = "Контакты (" +  Строка(КоличествоКонтактов) + ")";
	КонтактПозвонить = Телефон;
	КонтактЭлектроннаяПочта = EMail;
	КонтактныеЛицаКлиента = "Контактные лица (0)";
	
	Лояльность = "Лояльный клиент";
	Лояльность = "Лояльность не определена";
	
	СтатусКлиента = Лояльность + " " + ?(СкоростьПробега > 0, ", за месяц проезжает около: " + Строка(СкоростьПробега) + " км", ", среднемесячный пробег неизвестен");
	ИсторияВзаимодействий = "(12) 12.05.2015 - 12.05.2015";
	ИсторияВзаимодействийПродажи = "("+ Строка(Renault_ПолучитьКоличествоВзаимодействийПродажи(СписокКлиентов)) + ")";
	
	СтруктураДанныхПоРассылкам = ПолучитьДанныеПоРассылкам();	
	Если СтруктураДанныхПоРассылкам.Количество = 0 Тогда
		ИсторияВзаимодействийРассылки = "Нет информации о рассылках";
	Иначе
		ИсторияВзаимодействийРассылки = "(" + Строка(СтруктураДанныхПоРассылкам.Количество) + ") - " + Строка(СтруктураДанныхПоРассылкам.ПоследняяДата);
	КонецЕсли;
	
	СтруктураДанныхПоЖалобам = ПолучитьДанныеПоЖалобам();
	Если СтруктураДанныхПоРассылкам.Количество = 0 Тогда
		ИсторияВзаимодействийЖалобы = "Нет информации о жалобах";
	Иначе
		ИсторияВзаимодействийЖалобы = "(" + Строка(СтруктураДанныхПоЖалобам.Количество) + ") - " + Строка(СтруктураДанныхПоЖалобам.ПоследняяДата);
	КонецЕсли;
	
	СтруктураДанныхMyRenault = ПолучитьДанныеПоMyRenault();
	Если СтруктураДанныхMyRenault.ЕстьРегистрация Тогда
		ИсторияВзаимодействийMyRenault = "Зарегистрирован " + Строка(СтруктураДанныхMyRenault.ПоследняяДата);
	Иначе
		ИсторияВзаимодействийMyRenault = "Не зарегистрирован";
	КонецЕсли;
	
	ПолучитьВсеЗаездыНаСервис();
	Если ВсеЗаездыНаСервис.Количество() > 0 Тогда
		
		ИсторияВзаимодействийСервис = Строка(ВсеЗаездыНаСервис.Количество()) + " - " + Формат(ВсеЗаездыНаСервис[0].ДатаЗаезда, "ДФ=дд.ММ.гггг");
		
	Иначе
		
		ИсторияВзаимодействийСервис = "Заездов в сервис пока не было";
		
	КонецЕсли;
	
	ИсторияВзаимодействийОпросы = "(0)";
	
	Заголовок = Наименование + " - Профиль клиента";
	
	//Заполним все будущие звонки
	ПолучитьДанныеПоЗвонкам();
	
	ВсеЗвонки.Сортировать("ПлановаяДатаКонтакта Убыв"); 
	
	СледующиеСобытияЗвонки = "(0)";
	
	Если ВсеЗвонки.Количество() > 0 Тогда
		
		СледующиеСобытияЗвонки = "(" + Строка(ВсеЗвонки.Количество()) + ") - " + Строка(ВсеЗвонки[0].Кампания);
		
	КонецЕсли;
	
	КоличествоХобби = Renault_АвтосервисСервер.ПолучитьКоличествоХоббиПрофиля(СписокКлиентов);
	
	Если КоличествоХобби > 0 Тогда
		
		Элементы.Хобби.Видимость = Истина;
		Элементы.Хобби.Заголовок = "хобби (" + Строка(КоличествоХобби) + ")";
		
	Иначе
		
		Элементы.Хобби.Заголовок = "нет данных о хобби";
		
	КонецЕсли;
	
	События.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_CommunicationCenter_Обзвон.Дата КАК Дата,
	               |	Renault_CommunicationCenter_Обзвон.СхемаОбзвона.ТипКоммуникации КАК ТипКоммуникации,
	               |	Renault_CommunicationCenter_Обзвон.СхемаОбзвона.Наименование КАК Наименование
	               |ИЗ
	               |	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
	               |ГДЕ
	               |	Renault_CommunicationCenter_Обзвон.Проведен
	               |	И Renault_CommunicationCenter_Обзвон.Клиент В(&СписокКлиентов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата";
	
	Запрос.УстановитьПараметр("СписокКлиентов", СписокКлиентов);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	
		НовСобытие = События.Добавить();
		НовСобытие.DATE_ACTION  = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
		НовСобытие.ACTION       = ""+ Выборка.ТипКоммуникации;
		НовСобытие.VIN_DESC     = "Схема коммуникации: " + Выборка.Наименование;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПоРассылкам()
	
	МассивКлиентов = Объект.Ссылка.Клиенты.ВыгрузитьКолонку("Клиент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ЦентрализованныеРассылки.Идентификатор,
	               |	Renault_ЦентрализованныеРассылки.НазваниеКампании КАК Событие,
	               |	Renault_ЦентрализованныеРассылки.ДатаРассылки КАК Дата
	               |ИЗ
	               |	РегистрСведений.Renault_ЦентрализованныеРассылки КАК Renault_ЦентрализованныеРассылки
	               |ГДЕ
	               |	Renault_ЦентрализованныеРассылки.Объект В(&МассивКлиентов)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	"""",
	               |	Renault_CommunicationCenter_Обзвон.СхемаОбзвона.Наименование,
	               |	Renault_CommunicationCenter_Обзвон.Дата
				   |ИЗ
	               |	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
	               |ГДЕ
	               |	Renault_CommunicationCenter_Обзвон.Клиент В(&МассивКлиентов)
	               |	И НЕ Renault_CommunicationCenter_Обзвон.Ссылка.ПометкаУдаления
	               |	И Renault_CommunicationCenter_Обзвон.СхемаОбзвона.ТипКоммуникации = &ТипКоммуникации
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";

	Запрос.УстановитьПараметр("МассивКлиентов", МассивКлиентов);
	Запрос.УстановитьПараметр("ТипКоммуникации", Перечисления.ВидыСобытий.ЭлектронноеПисьмо);

	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Выборка.Количество();
	Если Выборка.Следующий() Тогда
		ПоследняяДата = Выборка.Дата;
	Иначе
		ПоследняяДата = Дата('00010101');
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("Количество", Количество);
	Ответ.Вставить("ПоследняяДата", ПоследняяДата);
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьДанныеПоЖалобам()
	
	МассивКлиентов = Объект.Ссылка.Клиенты.ВыгрузитьКолонку("Клиент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	DMS_ОбращениеКлиента.Описание КАК Жалоба,
	               |	DMS_ОбращениеКлиента.Комментарий КАК Результат,
	               |	DMS_ОбращениеКлиента.Дата КАК Дата
	               |ИЗ
	               |	Документ.ЖалобаКлиента КАК ЖалобаКлиента,
	               |	Документ.DMS_ОбращениеКлиента КАК DMS_ОбращениеКлиента
	               |ГДЕ
	               |	DMS_ОбращениеКлиента.Контрагент В(&МассивКлиентов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";
	Запрос.УстановитьПараметр("МассивКлиентов", МассивКлиентов);
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Выборка.Количество();
	Если Выборка.Следующий() Тогда
		ПоследняяДата = Выборка.Дата;
	Иначе
		ПоследняяДата = Дата('00010101');
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("Количество", Количество);
	Ответ.Вставить("ПоследняяДата", ПоследняяДата);
	
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьДанныеПоЗвонкам()
	
	МассивКлиентов = Объект.Ссылка.Клиенты.ВыгрузитьКолонку("Клиент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_КонтактСКлиентом.Ссылка КАК Контакт,
	               |	Renault_КонтактСКлиентом.КонтактВыполнен,
	               |	Renault_КонтактСКлиентом.Кампания,
	               |	Renault_КонтактСКлиентом.ПлановаяДата КАК ПлановаяДатаКонтакта
	               |ИЗ
	               |	Документ.Renault_КонтактСКлиентом КАК Renault_КонтактСКлиентом
	               |ГДЕ
	               |	Renault_КонтактСКлиентом.Контрагент В(&СписокКлиентов)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_CommunicationCenter_Обзвон.Ссылка,
	               |	ИСТИНА,
	               |	Renault_CommunicationCenter_Обзвон.СхемаОбзвона,
	               |	Renault_CommunicationCenter_Обзвон.Дата
	               |ИЗ
	               |	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
	               |ГДЕ
	               |	Renault_CommunicationCenter_Обзвон.Клиент В(&СписокКлиентов)
	               |	И Renault_CommunicationCenter_Обзвон.СхемаОбзвона.ТипКоммуникации = &ТипКоммуникации";
	Запрос.УстановитьПараметр("СписокКлиентов", МассивКлиентов);
	Запрос.УстановитьПараметр("ТипКоммуникации", Перечисления.ВидыСобытий.ТелефонныйЗвонок);
	ВсеЗвонки.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		НоваяСтрока = ВсеЗвонки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьДанныеПоMyRenault()
	
	МассивКлиентов = Объект.Ссылка.Клиенты.ВыгрузитьКолонку("Клиент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_РегистрацииMyRenault.ДатаРегистрации
	               |ИЗ
	               |	РегистрСведений.Renault_РегистрацииMyRenault КАК Renault_РегистрацииMyRenault
	               |ГДЕ
	               |	Renault_РегистрацииMyRenault.Клиент В(&МассивКлиентов)";
	Запрос.УстановитьПараметр("МассивКлиентов", МассивКлиентов);
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Выборка.Количество();
	Если Выборка.Следующий() Тогда
		ЕстьРегистрация = Истина;
		ПоследняяДата = Выборка.ДатаРегистрации;
	Иначе
		ЕстьРегистрация = Ложь;
		ПоследняяДата = Дата('00010101');
	КонецЕсли;
	
	Если Не ЕстьРегистрация Тогда
		Для Каждого Строка Из События Цикл
			Если НРег(Строка.ACTION) = "создан в myrenault" Тогда
				ЕстьРегистрация = Истина;
				ПоследняяДата = Дата(СтрЗаменить(Строка.DATE_ACTION, "-", "") + "010101");
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("ЕстьРегистрация", ЕстьРегистрация);
	Ответ.Вставить("ПоследняяДата", ПоследняяДата);
	
	Возврат Ответ;
	
КонецФункции

