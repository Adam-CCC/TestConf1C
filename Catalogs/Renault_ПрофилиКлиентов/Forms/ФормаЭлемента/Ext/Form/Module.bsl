	              |	Справочник.Renault_КартыЛояльности КАК Renault_КартыЛояльности
	              |ГДЕ
	              |	Renault_КартыЛояльности.Контрагент В(&Клиенты)
	              |	И Renault_КартыЛояльности.Недействительна = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Клиенты", МассивКлиентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеПродукты.Добавить();
		НоваяСтрока.Продукт = ?(ЗначениеЗаполнено(Строка(Выборка.ПрограммаЛояльности)), Строка(Выборка.ПрограммаЛояльности),"Программа не указана");
		НоваяСтрока.ДатаНачалаДействия = Выборка.ДатаВыдачи;
		НоваяСтрока.ТипПродукта = "Бонусная карта";
		
	КонецЦикла;
	
	//Продленная гарантия, SARA, кредиты
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ЦентрализованныеПродукты.ДатаНачалаДействияГарантии КАК ДатаНачалаДействия,
	               |	Renault_ЦентрализованныеПродукты.ТипКарты КАК ТипПродукта,
	               |	ВЫБОР
	               |		КОГДА Renault_ЦентрализованныеПродукты.ТипКарты = ""Кредит RN-Банка""
	               |			ТОГДА Renault_ЦентрализованныеПродукты.СуммаКредита
	               |		ИНАЧЕ Renault_ЦентрализованныеПродукты.НомерКарты
	               |	КОНЕЦ КАК Продукт
	               |ИЗ
	               |	РегистрСведений.Renault_ЦентрализованныеПродукты КАК Renault_ЦентрализованныеПродукты
	               |ГДЕ
	               |	Renault_ЦентрализованныеПродукты.Клиент В(&Клиенты)";
	
	Запрос.УстановитьПараметр("Клиенты", МассивКлиентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеПродукты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьПредложения()
	
	ТаблицаАвтомобили = ДанныеФормыВЗначение(Автомобили, Тип("ТаблицаЗначений"));
	
	МассивАвто = ТаблицаАвтомобили.ВыгрузитьКолонку("Автомобиль");
	
	//Сначала повреждения
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Работа,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Автомобиль,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Цвет
	               |ИЗ
	               |	РегистрСведений.Renault_ПоврежденияАвтомобилей.СрезПоследних КАК Renault_ПоврежденияАвтомобилейСрезПоследних
	               |ГДЕ
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Автомобиль В(&Автомобили)
	               |	И Renault_ПоврежденияАвтомобилейСрезПоследних.РаботаАктуальна = ИСТИНА";
	
	Запрос.УстановитьПараметр("Автомобили", МассивАвто);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеПредложения.Добавить();
		НоваяСтрока.Источник = "Сервис";
		НоваяСтрока.Предложение = Строка(Выборка.Работа);
		НоваяСтрока.ДляАвтомобиля = Строка(Выборка.Автомобиль);
		НоваяСтрока.ТипПредложения = ?(Выборка.Цвет = Перечисления.Renault_ЦветаСертификатаКонтроля.Красный, "Рекомендация срочная", "Рекомендация");
		
	КонецЦикла;
	
	//ТеперьАкции	
	Для Каждого Автомобиль из МассивАвто Цикл
		
		ОтобратьАкции(Автомобиль);
		
	КонецЦикла;
	
	
	//Предложение по ТО
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ВыполнениеТОСрезПоследних.ВидТО,
	               |	Renault_ВыполнениеТОСрезПоследних.ДатаПлан,
	               |	Renault_ВыполнениеТОСрезПоследних.Автомобиль,
	               |	Renault_ВыполнениеТОСрезПоследних.СкоростьПробега
	               |ИЗ
	               |	РегистрСведений.Renault_ВыполнениеТО.СрезПоследних КАК Renault_ВыполнениеТОСрезПоследних
	               |ГДЕ
	               |	Renault_ВыполнениеТОСрезПоследних.Автомобиль В(&Автомобили)
	               |	И Renault_ВыполнениеТОСрезПоследних.ДатаПлан >= &ДатаПланНачало
	               |	И Renault_ВыполнениеТОСрезПоследних.ДатаПлан <= &ДатаПланКонец
	               |	И Renault_ВыполнениеТОСрезПоследних.ДатаФакт = &Пустая";
	
	Запрос.УстановитьПараметр("ДатаПланНачало", ТекущаяДата() - 60*60*24*30);
	Запрос.УстановитьПараметр("ДатаПланКонец", ТекущаяДата() + 60*60*24*30*3);
	Запрос.УстановитьПараметр("Автомобили", МассивАвто);
	Запрос.УстановитьПараметр("Пустая", Дата('00010101'));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СкоростьПробега = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеПредложения.Добавить();
		НоваяСтрока.Источник = "Сервис";
		НоваяСтрока.Предложение = Выборка.ВидТО;
		Новаястрока.ДляАвтомобиля = Выборка.Автомобиль;
		НоваяСтрока.ТипПредложения = "Приглашение на следующее ТО";
		
	КонецЦикла;
	
	//Калькуляции
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_Калькуляция.Автомобиль,
	               |	Renault_Калькуляция.Дата,
	               |	Renault_Калькуляция.Ссылка КАК Калькуляция
	               |ИЗ
	               |	Документ.Renault_Калькуляция КАК Renault_Калькуляция
	               |ГДЕ
	               |	Renault_Калькуляция.Автомобиль В(&Автомобили)";
	
	Запрос.УстановитьПараметр("Автомобили", МассивАвто);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеПредложения.Добавить();
		НоваяСтрока.Источник = "Сервис";
		НоваяСтрока.Предложение = Выборка.Калькуляция;
		Новаястрока.ДляАвтомобиля = Выборка.Автомобиль;
		НоваяСтрока.ДокументИсточник = Выборка.Калькуляция;
		НоваяСтрока.ТипПредложения = "Калькуляция";
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(Renault_ВыполнениеТО.СкоростьПробега) КАК СкоростьПробега,
	               |	СУММА(1) КАК КоличествоЗаписей
	               |ИЗ
	               |	РегистрСведений.Renault_ВыполнениеТО КАК Renault_ВыполнениеТО
	               |ГДЕ
	               |	Renault_ВыполнениеТО.Автомобиль В(&Автомобили)";
	
	Запрос.УстановитьПараметр("Автомобили", МассивАвто);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.СкоростьПробега) И ЗначениеЗаполнено(Выборка.КоличествоЗаписей) Тогда
			
			СкоростьПробега = Выборка.СкоростьПробега / Выборка.КоличествоЗаписей;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтобратьАкции(Автомобиль)
	
//Отберем локальные акции	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_АкцииИСкидки.Ссылка,
	               |	Renault_АкцииИСкидки.Наименование
	               |ИЗ
	               |	Справочник.Renault_АкцииИСкидки КАК Renault_АкцииИСкидки
	               |ГДЕ
	               |	(Renault_АкцииИСкидки.ДляВсехМоделейАвто = ИСТИНА
	               |			ИЛИ Renault_АкцииИСкидки.МоделиАвто.Модель = &Модель)
	               |	И Renault_АкцииИСкидки.ПометкаУдаления = ЛОЖЬ
	               |	И (Renault_АкцииИСкидки.НачалоАкции <= &ТекДата
	               |	И Renault_АкцииИСкидки.ОкончаниеАкции >= &ТекДата)";
	
	Запрос.УстановитьПараметр("Модель", Автомобиль.Модель);
	Запрос.УстановитьПараметр("ВидАкции", Перечисления.Renault_ВидыАкций.Глобальная);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
	
	Если ЗначениеЗаполнено(Пробег) Тогда
		
		Запрос.УстановитьПараметр("Пробег", Пробег);
		Запрос.Текст = Запрос.Текст + "
		|  	И (Renault_АкцииИСкидки.ПробегОт <= &Пробег
		|	И Renault_АкцииИСкидки.ПробегДо >= &Пробег)";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Автомобиль.ГодВыпуска) Тогда
		
		Запрос.УстановитьПараметр("ГодВыпуска", Автомобиль.ГодВыпуска);
		Запрос.Текст = Запрос.Текст + "
		| 	И (Renault_АкцииИСкидки.ГодВыпускаОт <= &ГодВыпуска
		|	И Renault_АкцииИСкидки.ГодВыпускаДо >= &ГодВыпуска)";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Автомобиль.ТипДвигателя) Тогда
		
		Запрос.УстановитьПараметр("ТипДВС", Автомобиль.ТипДвигателя);
		Запрос.УстановитьПараметр("ТипДВСПустой", Справочники.ТипыДвигателей.ПустаяСсылка());
		Запрос.Текст = Запрос.Текст + "
		|	И (Renault_АкцииИСкидки.ТипДВС = &ТипДВС 
		|	ИЛИ Renault_АкцииИСкидки.ТипДВС = &ТипДВСПустой)";
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеПредложения.Добавить();
		НоваяСтрока.Предложение = Выборка.Наименование;
		НоваяСтрока.Источник = "Сервис";
		НоваяСтрока.ТипПредложения = "Акция дилера";
		НоваяСтрока.ДляАвтомобиля = Автомобиль;
		
	КонецЦикла;
	
	//Отберем центральные акции
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ЦентрализованныеАкцииМодели.Ссылка,
	|	Renault_ЦентрализованныеАкцииМодели.Ссылка.Наименование,
	|	Renault_ЦентрализованныеАкцииМодели.Ссылка.ТолькоMyRenault,
	|	Renault_ЦентрализованныеАкцииМодели.УИД
	|ИЗ
	|	Справочник.Renault_ЦентрализованныеАкции.Модели КАК Renault_ЦентрализованныеАкцииМодели
	|ГДЕ
	|	(Renault_ЦентрализованныеАкцииМодели.Модель = &Модель
	|	ИЛИ Renault_ЦентрализованныеАкцииМодели.Модель = &ПустаяМодель)
	|	И Renault_ЦентрализованныеАкцииМодели.Ссылка.НачалоДействия <= &ТекущаяДата
	|	И Renault_ЦентрализованныеАкцииМодели.Ссылка.ОкончаниеДействия >= &ТекущаяДата
	|	И Renault_ЦентрализованныеАкцииМодели.Ссылка.УчастиеПодтверждено = ИСТИНА
	|	И Renault_ЦентрализованныеАкцииМодели.Ссылка.ДаноСогласиеНаУчастие = ИСТИНА";
	Запрос.УстановитьПараметр("Модель", Автомобиль.Модель);
	Запрос.УстановитьПараметр("ПустаяМодель", Справочники.Модели.ПустаяСсылка());
	
	Если ЗначениеЗаполнено(Автомобиль.ВариантКомплектации) Тогда
		
		Запрос.Текст = Запрос.Текст + Символы.ПС +
		"И (Renault_ЦентрализованныеАкцииМодели.ВариантКомплектации = &ВариантКомплектации
		| ИЛИ Renault_ЦентрализованныеАкцииМодели.ВариантКомплектации = &ПустойВариант)";
		
		Запрос.УстановитьПараметр("ВариантКомплектации", Автомобиль.ВариантКомплектации);
		Запрос.УстановитьПараметр("ПустойВариант", Справочники.ВариантыКомплектации.ПустаяСсылка());
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + Символы.ПС +
		"И Renault_ЦентрализованныеАкцииМодели.ВариантКомплектации = &ПустойВариант";
		Запрос.УстановитьПараметр("ПустойВариант", Справочники.ВариантыКомплектации.ПустаяСсылка());
		
	КонецЕсли;
	
	Если НЕ Renault_АвтосервисОбщий.ЕстьMyRenault(Клиент) Тогда
		
		Запрос.Текст = Запрос.Текст + Символы.ПС +
		
		"И Renault_ЦентрализованныеАкцииМодели.Ссылка.ТолькоMyRenault = ЛОЖЬ";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Автомобиль.ТипДвигателя) Тогда
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + 
		"И (Renault_ЦентрализованныеАкцииМодели.ТипДвигателя = &ТипДвигателя
		| ИЛИ  Renault_ЦентрализованныеАкцииМодели.ТипДвигателя = &ПустойТип)";
		
		Запрос.УстановитьПараметр("ТипДвигателя", Автомобиль.ТипДвигателя);
		Запрос.УстановитьПараметр("ПустойТип", Справочники.ТипыДвигателей.ПустаяСсылка());
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + 
		"И Renault_ЦентрализованныеАкцииМодели.ТипДвигателя = &ПустойТип";
		
		Запрос.УстановитьПараметр("ПустойТип", Справочники.ТипыДвигателей.ПустаяСсылка());
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеПредложения.Добавить();
		НоваяСтрока.Предложение = Выборка.Наименование;
		НоваяСтрока.Источник = "Сервис";
		НоваяСтрока.ТипПредложения = ?(Выборка.ТолькоMyRenault, "MyRenault", "Акция Renault");
		НоваяСтрока.ДляАвтомобиля = Автомобиль;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыНажатие(Элемент, СтандартнаяОбработка)
	
	Если ДокументыКлиента = "Документы " + "(документы не найдены)" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Клиент", Клиент);
	ПараметрыОткрытия.Вставить("Клиенты", Объект.Клиенты);
	
	ОткрытьФорму("ОбщаяФорма.Renault_ВсеДокументы", ПараметрыОткрытия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолВозрастНажатие(Элемент, СтандартнаяОбработка)
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаСервере
Процедура ПолучитьВсеЗаездыНаСервис()
	
	Если Объект.Клиенты.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	МассивКлиентов = Объект.Ссылка.Клиенты.ВыгрузитьКолонку("Клиент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказНаряд.Ссылка,
	               |	ЗаказНаряд.ВидРемонта,
	               |	ЗаказНаряд.Автомобиль,
	               |	ВЫБОР
	               |		КОГДА ЗаказНаряд.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |			ТОГДА ЗаказНаряд.Дата
	               |		ИНАЧЕ ЗаказНаряд.ДатаНачала
	               |	КОНЕЦ КАК ДатаНачала
	               |ИЗ
	               |	Документ.ЗаказНаряд КАК ЗаказНаряд
	               |ГДЕ
	               |	ЗаказНаряд.Контрагент В(&Клиенты)
	               |	И ЗаказНаряд.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаНачала УБЫВ";
	
	Запрос.УстановитьПараметр("Клиенты", МассивКлиентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ВсеЗаездыНаСервис.Добавить();
		НоваяСтрока.Автомобиль = Выборка.Автомобиль;
		НоваяСтрока.ДатаЗаезда = Выборка.ДатаНачала;
		НоваяСтрока.ВидРемонта = Выборка.ВидРемонта;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияВзаимодействийСервисНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ИсторияВзаимодействийСервис = "Заездов в сервис пока не было" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Клиент", Клиент);
	
	ПараметрыОткрытия.Вставить("ВсеЗаезды", ВсеЗаездыНаСервис);
	
