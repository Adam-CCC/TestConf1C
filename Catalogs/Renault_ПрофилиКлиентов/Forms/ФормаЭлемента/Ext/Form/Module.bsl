&НаСервере
Процедура ЗаполнитьИсториюСтатусов()
	
	Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	АдресWS	 = Настройки.АдресWsGate;
	ЛогинWS	 = Настройки.ЛогинДоступаКВебСервисам;
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/ClientsInfo.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/ClientsInfo", 
							   "Renault_ClientsInfo", "Renault_ClientsInfoSoap12", 60000);
	
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Результат = ВебСервис.GetDataHubInfo(Строка(объект.GoldenId), "dms_get_commstatus");
	ТаблицаРезультат = СериализаторXDTO.ПрочитатьXDTO(Результат);
	
	Для Каждого Строка Из ТаблицаРезультат Цикл
		НоваяСТрока = СтатусыКлиента.Добавить();
		НоваяСтрока.Дата = Строка.DATE_ACTION;
		НоваяСтрока.Статус = Строка.STATUS_NAME;
		НоваяСтрока.goldenID = Строка.GOLDEN_ID;
	КонецЦикла;
	
	Результат = ВебСервис.GetDataHubInfo(Строка(объект.GoldenId), "dms_get_phones");
	ТаблицаРезультат = СериализаторXDTO.ПрочитатьXDTO(Результат);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Тип = &Тип";
	Запрос.УстановитьПараметр("Объект", Клиент);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ТаблицаРезультат Цикл
		
		Найден = Ложь;
		Для Каждого КонтСтрока ИЗ Таблица Цикл
			Если КонтСтрока.Представление = Строка(Строка.CITY_CODE) + Строка(Строка.NUMBER) Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не найден Тогда
			
			ВидКИ = Неопределено;
			
			Для Счетчик = 1 по 10 Цикл
				МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект = Клиент;
				МенеджерЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				
				ВидКИ = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("RenaultТелефон" + Строка(Счетчик));
				Если Не ЗначениеЗаполнено(ВидКИ) Тогда
					Вид = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
					Вид.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
					Вид.Наименование = "RenaultТелефон" + Строка(Счетчик);
					Вид.Записать();
					ВидКИ = Вид.Ссылка;
				КонецЕсли;
				МенеджерЗаписи.Вид = ВидКИ;
				МенеджерЗаписи.Прочитать();
				Если Не МенеджерЗаписи.Выбран() Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = Клиент;
			МенеджерЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			МенеджерЗаписи.Вид = ВидКИ;
			МенеджерЗаписи.Представление = Строка(Строка.CITY_CODE) + Строка(Строка.NUMBER);
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = ВебСервис.GetDataHubInfo(Строка(объект.GoldenId), "dms_get_emails");
	ТаблицаРезультат = СериализаторXDTO.ПрочитатьXDTO(Результат);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Тип = &Тип";
	Запрос.УстановитьПараметр("Объект", Клиент);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ТаблицаРезультат Цикл
		Найден = Ложь;
		Для Каждого КонтСтрока ИЗ Таблица Цикл
			Если КонтСтрока.Представление = Строка.EMAIL Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не найден Тогда
			
			ВидКИ = Неопределено;
			
			Для Счетчик = 1 по 10 Цикл
				МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Объект = Клиент;
				МенеджерЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				
				ВидКИ = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("RenaultEmail" + Строка(Счетчик));
				Если Не ЗначениеЗаполнено(ВидКИ) Тогда
					Вид = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
					Вид.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
					Вид.Наименование = "RenaultEmail" + Строка(Счетчик);
					Вид.Записать();
					ВидКИ = Вид.Ссылка;
				КонецЕсли;
				МенеджерЗаписи.Вид = ВидКИ;
				МенеджерЗаписи.Прочитать();
				Если Не МенеджерЗаписи.Выбран() Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = Клиент;
			МенеджерЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			МенеджерЗаписи.Вид = ВидКИ;
			МенеджерЗаписи.Представление = Строка(Строка.EMAIL);
			МенеджерЗаписи.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

