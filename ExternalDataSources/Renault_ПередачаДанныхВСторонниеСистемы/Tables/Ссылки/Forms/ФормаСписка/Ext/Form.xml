		<Attribute name="Реквизиты" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Реквизиты объектов</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>Выбрать
	*,
	Выбор Когда НомерСтроки=0 Тогда 22 Иначе 21 Конец Картинка,
	
	//тип значения
	Выбор Когда Значение Есть NULL Тогда "" Иначе Реквизит.Тип Конец ТипЗначение,
	//картинка значения
	Выбор
		Когда Значение Есть NULL Тогда 100
		Когда Реквизит.Тип Подобно "Перечисление.%" Тогда 11
		Когда Подстрока(Реквизит.Тип,0,10)="Строка" Тогда 2
		Когда Подстрока(Реквизит.Тип,0,10)="Число" Тогда 1
		Когда Подстрока(Реквизит.Тип,0,10)="Дата" Тогда 3
		Когда Подстрока(Реквизит.Тип,0,10)="Булево" Тогда 4
		//Когда Реквизит.Тип Подобно "%.%" Тогда 0
		Иначе 0
	Конец КартинкаЗначение,	
	
	//тип значения-ссылки
	Выбор Когда ЗначениеСсылка Есть NULL Тогда "" Иначе ЗначениеСсылка.ОбъектМД.Имя Конец ТипЗначениеСсылка,
	//картинка значения-ссылки
	Выбор
		//Когда ЗначениеСсылка.ОбъектМД.Имя="УникальныйИдентификатор" Тогда 5
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "ВнешнийИсточникДанных.%" Тогда 12
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "%.%.%" Тогда 6 //составной тип
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "Справочник.%" Тогда 14
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "Документ.%" Тогда 15
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "БизнесПроцесс.%" Тогда 16
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "Задача.%" Тогда 17
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "ПланСчетов.%" Тогда 18
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "ПланОбмена.%" Тогда 19
		Когда ЗначениеСсылка.ОбъектМД.Имя Подобно "ПланВидовХарактеристик.%" Тогда 20
		Когда ЗначениеСсылка=Значение(ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки.ПустаяСсылка) Тогда 100
		Иначе 0
	Конец КартинкаСсылка
ИЗ(	
	Выбрать
		СсылкаНаОбъект,
		Реквизит,
		НомерСтроки,
