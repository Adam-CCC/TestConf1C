	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	*,
	Выбор 
		Когда ОбъектМД.Имя Подобно "Справочник.%" Тогда 14
		Когда ОбъектМД.Имя Подобно "Документ.%" Тогда 15
		Когда ОбъектМД.Имя Подобно "БизнесПроцесс.%" Тогда 16
		Когда ОбъектМД.Имя Подобно "Задача.%" Тогда 17
		Когда ОбъектМД.Имя Подобно "ПланСчетов.%" Тогда 18
		Когда ОбъектМД.Имя Подобно "ПланОбмена.%" Тогда 19
		Когда ОбъектМД.Имя Подобно "ПланВидовХарактеристик.%" Тогда 20
		Когда ОбъектМД.Имя Подобно "РегистрСведений.%" Тогда 13
		Иначе 0
	Конец Картинка
ИЗ ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки</QueryText>
				<MainTable>ExternalDataSource.Renault_ПередачаДанныхВСторонниеСистемы.Table.Ссылки</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Пакет</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
