
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.СУБД.СписокВыбора.Добавить("MSSQLServer","MS SQL Server");
	Элементы.СУБД.СписокВыбора.Добавить("PostgreSQL","Postgre SQL");
	Элементы.СУБД.СписокВыбора.Добавить("IBMDB2","IBM DB2");
	Элементы.СУБД.СписокВыбора.Добавить("OracleDatabase","Oracle Database");
	Элементы.СУБД.СписокВыбора.Добавить("MySQL","My SQL");
	Элементы.СУБД.СписокВыбора.Добавить("","Прочее");
	
	Парам=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.ПолучитьОбщиеПараметрыСоединения();
	АутентификацияОС=Парам.АутентификацияОС;
	АутентификацияСтандартная=Парам.АутентификацияСтандартная;
	ИмяПользователя=Парам.ИмяПользователя;
	//Пароль=Парам.Пароль;
	ПарольУстановлен=Парам.ПарольУстановлен;
	СтрокаСоединения=Парам.СтрокаСоединения;
	СУБД=Парам.СУБД;
	
	Элементы.Драйвер.СписокВыбора.Добавить("SQL Server");
	Элементы.Драйвер.СписокВыбора.Добавить("SQL Server Native Client 11.0");
	Элементы.Драйвер.СписокВыбора.Добавить("ODBC Driver 11 for SQL Server");
	
	СтруктураСоединения=РазобратьСтрокуСоединения(СтрокаСоединения);
	
	Драйвер=?(СтруктураСоединения.DRIVER="","SQL Server",СтруктураСоединения.DRIVER);
	Сервер=?(СтруктураСоединения.SERVER="","127.0.0.1",СтруктураСоединения.SERVER);
	БазаДанных=?(СтруктураСоединения.DATABASE="","DataExchange",СтруктураСоединения.DATABASE);
	
	//значения по умолчанию
	//Если СтрокаСоединения="" Тогда СтрокаСоединения="DRIVER={SQL Server};SERVER=127.0.0.1;DATABASE=DataExchange;LANGUAGE=русский" КонецЕсли;
	Если СУБД="" Тогда СУБД="MSSQLServer"; АутентификацияСтандартная=Истина; КонецЕсли;
	
	УправлениеЭлементами();
	
КонецПроцедуры

Процедура УправлениеЭлементами()
	Элементы.Пароль.Видимость=Не ПарольУстановлен;
	Элементы.ПарольУстановлен.Видимость=ПарольУстановлен;
	Если Renault_ПередачаДанныхВСторонниеСистемы.ПодключениеУстановлено() Тогда
		Элементы.кнОтключить.Доступность=Истина;
		Элементы.кнУстановитьПодключение.Доступность=Ложь;
	Иначе
		Элементы.кнОтключить.Доступность=Ложь;
		Элементы.кнУстановитьПодключение.Доступность=Истина;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура кнУстановитьПодключение(Команда)
	СтрокаСоединения=СобратьСтрокуСоединения();
	Если СтрокаСоединения="" Тогда Возврат КонецЕсли;
	
	Парам=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.ПолучитьОбщиеПараметрыСоединения();
	Парам.АутентификацияОС=АутентификацияОС;
	Парам.АутентификацияСтандартная=АутентификацияСтандартная;
	Парам.ИмяПользователя=ИмяПользователя;
	Если Не ПарольУстановлен Тогда Парам.Пароль=Пароль КонецЕсли;
	Парам.СтрокаСоединения=СтрокаСоединения;
	Парам.СУБД=СУБД;
	
	ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.УстановитьОбщиеПараметрыСоединения(Парам);
	ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.УстановитьСоединение();
	УправлениеЭлементами();
КонецПроцедуры

&НаКлиенте
Процедура кнРазорватьСоединение(Команда) 
	ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.РазорватьСоединение();
	
	Парам=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.ПолучитьОбщиеПараметрыСоединения();
	Парам.АутентификацияОС=Ложь;
	Парам.АутентификацияСтандартная=Ложь;
	Парам.ИмяПользователя="";
	Парам.Пароль=Неопределено;
	//Парам.ПарольУстановлен=Ложь;
	Парам.СтрокаСоединения="";
	Парам.СУБД="";
	ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.УстановитьОбщиеПараметрыСоединения(Парам);
	
	УправлениеЭлементами()
КонецПроцедуры

&НаКлиенте
Процедура ПарольУстановленПриИзменении(Элемент) УправлениеЭлементами() КонецПроцедуры

&НаКлиенте
Процедура кнСкрипт(Команда)
	Текст=Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ПолучитьСкрипт());
	Текст.Показать("SQL скрипт","DataExchange.sql");
КонецПроцедуры
Функция ПолучитьСкрипт() Возврат СтрЗаменить( ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.БазыДанных.ПолучитьМакет("sql").ПолучитьТекст() ,"DataExchange", БазаДанных) КонецФункции	

Функция РазобратьСтрокуСоединения(Знач СтрокаСоединения)
	Структура=Новый Структура("DRIVER","SERVER","DATABASE");
	
	//драйвер
	Подстрока=Сред(СтрокаСоединения,9);
	Поз=Найти(Подстрока,"}");
	Структура.Вставить("DRIVER",Лев(Подстрока,Поз-1));
	
	//сервер
	Поз=Найти(СтрокаСоединения,"SERVER");
	Подстрока=Сред(СтрокаСоединения,Поз+7);
	Поз=Найти(Подстрока,";");
	Структура.Вставить("SERVER",Лев(Подстрока,Поз-1));
	
	//база
	Поз=Найти(СтрокаСоединения,"DATABASE");
	Подстрока=Сред(СтрокаСоединения,Поз+9);
	Поз=Найти(Подстрока,";");
	Структура.Вставить("DATABASE",Лев(Подстрока,Поз-1));
	
	Возврат Структура
КонецФункции	
Функция СобратьСтрокуСоединения()
	Если Драйвер="" Тогда Сообщить("Не задан драйвер для подключения",СтатусСообщения.Информация); Возврат "" КонецЕсли;
	Если Сервер="" Тогда Сообщить("Не задан сервер для подключения",СтатусСообщения.Информация); Возврат "" КонецЕсли;
	Если БазаДанных="" Тогда Сообщить("Не задана база данных для подключения",СтатусСообщения.Информация); Возврат "" КонецЕсли;
	Возврат "DRIVER={"+Драйвер+"};SERVER="+Сервер+";DATABASE="+БазаДанных+";LANGUAGE=русский"
КонецФункции	

&НаКлиенте
Процедура СоздатьСтрокуПодключения(Элемент) СтрокаСоединения=СобратьСтрокуСоединения() КонецПроцедуры
