//идентификатор базы
//Процедура ПередЗаписью(Отказ) ИдентификаторБазы=Renault_ПередачаДанныхВСторонниеСистемы.ИдентификаторБазы() КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	ТекБаза=Renault_ПередачаДанныхВСторонниеСистемы.ТекущаяБазаДанных();
	
	//проверка ссылок на объекты другой базы
	Если НЕ Родитель.Пустая() И Родитель.БазаДанных<>ТекБаза Тогда
		Сообщить("Родитель не может принадлежать метаданным другой базы",СтатусСообщения.Внимание);
		Отказ=Истина;
	КонецЕсли;	
	
	//блокирование записи МД другой базы
	Если БазаДанных<>ТекБаза Тогда
		Сообщить("Метаданные другой базы не доступны для редактирования",СтатусСообщения.Информация);
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	
	//проверка реквизитов
	Если Найти(Имя,".")>0 Тогда //иначе это не метаданные, проверять не надо
		Попытка
			СтруктураМетаданных=Renault_ПередачаДанныхВСторонниеСистемы.СтруктураРеквизитовОбъектаМД(Ссылка)
		Исключение
			Сообщить(ОписаниеОшибки(),СтатусСообщения.Внимание);
			Возврат
		КонецПопытки;	
			
		Если СтруктураМетаданных=Ложь Тогда
			//нет таких метаданных то это фиктивная запись в таблицу, возможно элемент иерархии		
			//Активно=Ложь;
		Иначе 
			Если НЕ ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.ОбъектыМД.ВыполнитьПроверкуРеквизитов(Имя,БазаДанных,СтруктураМетаданных,Новый Массив) И Активно Тогда
				//Отказ=Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли; 
	
	Если Правило=Справочники.Renault_КонвертацияДанных.ПустаяСсылка() Тогда Правило=NULL КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если БазаДанных<>Renault_ПередачаДанныхВСторонниеСистемы.ТекущаяБазаДанных() Тогда
		Сообщить("Метаданные другой базы не доступны для редактирования",СтатусСообщения.Внимание);
		Отказ=Истина;
		Возврат
	КонецЕсли;
	
	Если ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.ОбъектыМД.ЕстьПодчиненные(Ссылка) Тогда
		Сообщить("Существуют подчиненные объекты метаданных, удаление не возможно",СтатусСообщения.Внимание);
		Отказ=Истина;
		Возврат
	КонецЕсли;	
	
КонецПроцедуры

	