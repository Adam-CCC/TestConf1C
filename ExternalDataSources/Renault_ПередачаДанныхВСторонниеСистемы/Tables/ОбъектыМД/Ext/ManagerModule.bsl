Функция Удалить(Ссылка) Экспорт Попытка Ссылка.ПолучитьОбъект().Удалить(); Возврат Истина Исключение Сообщить(ОписаниеОшибки(),СтатусСообщения.Внимание); Возврат Ложь КонецПопытки КонецФункции	

Функция СоздатьРаздел(ИмяРаздела) Экспорт
	Ссылка=МДСуществует(ИмяРаздела,Истина); Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка КонецЕсли; //поиск
	//создание
	Объект=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.ОбъектыМД.СоздатьОбъект();	
	Объект.Активно=Ложь;
	Объект.БазаДанных=Renault_ПередачаДанныхВСторонниеСистемы.ТекущаяБазаДанных();
	Объект.Имя=ИмяРаздела;
	Объект.Правило=Null;
	Объект.Записать();
	Возврат Объект.Ссылка
КонецФункции	

Функция СоздатьМД(ИмяМД,ИмяКоманды,Родитель=Неопределено) Экспорт
	Ссылка=МДСуществует(ИмяМД,Истина); Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка КонецЕсли; //поиск
	//создание
	Объект=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.ОбъектыМД.СоздатьОбъект();	
	Объект.Активно=Истина;
	Объект.БазаДанных=Renault_ПередачаДанныхВСторонниеСистемы.ТекущаяБазаДанных();
	Если Родитель=Неопределено Тогда 
		Родитель=МДСуществует(Renault_ПередачаДанныхВСторонниеСистемы.СтруктураМетаданных(ИмяМД).ТипМД,Истина);
		Объект.Родитель=?(Родитель=Неопределено,ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.ОбъектыМД.ПустаяСсылка(),Родитель);
	Иначе
		Объект.Родитель=Родитель 
	КонецЕсли;
	Объект.Имя=ИмяМД;
	Объект.Правило=Null;
	Объект.Записать();
	ТекстОшибки="";
	Если НЕ ЗаполнитьРеквизитыОбъекта(Объект.Ссылка,ТекстОшибки,ИмяКоманды) Тогда Сообщить(ТекстОшибки,СтатусСообщения.Внимание) КонецЕсли;
	Возврат Объект.Ссылка
КонецФункции
Функция МДСуществует(ИмяМД,ВернутьСсылку=Ложь) Экспорт
	Запрос=Новый Запрос("Выбрать Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.ОбъектыМД ГДЕ Имя=&Имя И БазаДанных=&ТекБаза");
	Запрос.УстановитьПараметр("Имя",ИмяМД);
	Запрос.УстановитьПараметр("ТекБаза",Renault_ПередачаДанныхВСторонниеСистемы.ТекущаяБазаДанных());
	Если ВернутьСсылку Тогда
		Выборка=Запрос.Выполнить().Выбрать();	
		Выборка.Следующий();
		Возврат Выборка.Ссылка
	Иначе Возврат НЕ Запрос.Выполнить().Пустой() КонецЕсли;
КонецФункции	

Функция ЗаполнитьРеквизитыОбъекта(Ссылка,ТекстОшибки,ИмяКоманды) Экспорт
	//реквизиты должны быть согласованы с объектом, поэтому объект должен быть записан.
	Если Ссылка.Пустая() Тогда ТекстОшибки="Объект не записан"; Возврат Ложь КонецЕсли;
	
	//запомним старые реквизиты
	Запрос=Новый Запрос("Выбрать Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.РеквизитыМД ГДЕ ОбъектМД=&ОбъектМД");
	Запрос.УстановитьПараметр("ОбъектМД",Ссылка);
	СтарыеРеквизиты=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	//ЕстьКомментарии=Ложь;
	
	//Если Не ПустаяСтрока(Ссылка.ТекстЗапроса) Тогда
	Если ИмяКоманды="кнЗаписатьРеквизитыПоЗапросу" Тогда
	//по запросу
		СпРеквПолный=Новый Массив; 
		ПодстрокаЗапрос=Сред(СокрЛП(Ссылка.ТекстЗапроса),8);
		ПозГДЕ=Найти(Врег(ПодстрокаЗапрос),"ГДЕ");
		Если ПозГДЕ>0 Тогда ПодстрокаЗапрос=Лев(ПодстрокаЗапрос,ПозГДЕ-1) КонецЕсли;
		
		ТекстЗапроса="Выбрать Первые 1"+Символы.ПС+ПодстрокаЗапрос;
	Иначе	
	//по метаданным
	
		МД=Renault_ПередачаДанныхВСторонниеСистемы.МетаданныеИзСтроки(Ссылка.Имя);
		Если МД=Неопределено Тогда ТекстОшибки="Метаданные <"+Ссылка.Имя+"> не определены"; Возврат Ложь КонецЕсли;
		//ЕстьКомментарии=Истина;
		
		//полный список реквизитов - предопределенные + метаданные
		СпРеквПолный=Renault_ПередачаДанныхВСторонниеСистемы.СписокПредопределенныхРеквизитов(Ссылка.Имя).ВыгрузитьЗначения();	
		Для Каждого Реквизит Из МД.Реквизиты Цикл СпРеквПолный.Добавить(Реквизит.Имя) КонецЦикла;
		
		Если Найти(Ссылка.Имя,"РегистрСведений")>0 Тогда
			СпРекв=СпРеквПолный;
		ИначеЕсли ИмяКоманды="кнЗаписатьПредопределенныеРеквизиты" Тогда
			СпРекв=Renault_ПередачаДанныхВСторонниеСистемы.СписокПредопределенныхРеквизитов(Ссылка.Имя).ВыгрузитьЗначения();	
		ИначеЕсли ИмяКоманды="кнЗаписатьРеквизитыМД" Тогда
			СпРекв=Новый Массив; Для Каждого Реквизит Из МД.Реквизиты Цикл СпРекв.Добавить(Реквизит.Имя) КонецЦикла;
		ИначеЕсли ИмяКоманды="кнЗаписатьРеквизитыМДИПредопределенные" Тогда
			СпРекв=СпРеквПолный;
		Иначе Возврат Истина //Если ИмяКоманды="кнЗаписатьТолькоСсылки" Тогда Возврат Истина	
		КонецЕсли;	
		
		Если СпРекв.Количество()=0 Тогда ТекстЗапроса="" Иначе
			ТекстЗапроса="Выбрать Первые 1"+Символы.ПС+Renault_ПередачаДанныхВСторонниеСистемы.МассивВСтроку(СпРекв,","+Символы.ПС)+Символы.ПС+"Из "+Ссылка.Имя;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ТекстЗапроса<>"" Тогда	
		Попытка
			Запрос=Новый Запрос(ТекстЗапроса);
			Табл=Запрос.Выполнить().Выгрузить();
			Для Каждого Кол Из Табл.Колонки Цикл
				Если Кол.ТипЗначения=Новый ОписаниеТипов("ТаблицаЗначений") Тогда Продолжить КонецЕсли;
				Если Кол.Имя="Renault_ВерсияВнешнихДанных" Тогда Продолжить КонецЕсли; //служебный реквизит этого механизма предназначен для хранения версии источника в приемнике для сравнения перед загрузкой
				//Если Кол.ТипЗначения=Новый ОписаниеТипов("ХранилищеЗначения") Тогда Продолжить КонецЕсли;
				Если Кол.ТипЗначения.Типы()[1]=Тип("ХранилищеЗначения") Тогда Продолжить КонецЕсли;
				ОбъектРеквизит=ПолучитьОбъектРеквизит(СтарыеРеквизиты,Кол.Имя);
				ОбъектРеквизит.Активно=Истина;
				ОбъектРеквизит.Имя=Кол.Имя;
				ОбъектРеквизит.ОбъектМД=Ссылка;
				ОбъектРеквизит.Тип=Renault_ПередачаДанныхВСторонниеСистемы.ОписаниеТиповВСтроку(Кол.ТипЗначения.Типы());
				ОбъектРеквизит.Правило=NULL;
				//Если ЕстьКомментарии Тогда
					Попытка ОбъектРеквизит.Описание=МД.Реквизиты[Кол.Имя].Комментарий Исключение КонецПопытки;
				//КонецЕсли;	
				ОбъектРеквизит.Записать();
			КонецЦикла;	
		Исключение
			ТекстОшибки=ОписаниеОшибки();
			Возврат Ложь
		КонецПопытки;	
	КонецЕсли;
	
	//очистка оставшихся старых реквизитов если они не найденны в полном списке реквизитов
	Для Каждого Эл Из СтарыеРеквизиты Цикл 
		Если СпРеквПолный.Найти(Эл.Имя)=Неопределено Тогда 
			Эл.ПолучитьОбъект().Удалить()
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Истина
КонецФункции
Функция ПолучитьОбъектРеквизит(СтарыеРеквизиты,ИмяРеквизита)
	Н=0;
	Для Каждого Эл Из СтарыеРеквизиты Цикл
		Если Эл.Имя=ИмяРеквизита Тогда 
			СтарыеРеквизиты.Удалить(Н);
			Возврат Эл.ПолучитьОбъект()
		КонецЕсли;
		Н=Н+1;
	КонецЦикла;
	Возврат ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.РеквизитыМД.СоздатьОбъект()
КонецФункции	

Функция ВыполнитьПроверкуРеквизитов(ИмяМД,БазаДанных,СтруктураМетаданных,МассивНеНайденныхТипов) Экспорт
	ЕстьОшибки=Ложь;
	
	//поиск метаданных по типам значений
	//более надежный алгоритм чем в конструкторе УстановитьПодчиненныеМД(), поскольку там метаданные 100% верные, а тут пользователь мог ввести что угодно
	спПримитивныеТипы=Новый Массив;
	спПримитивныеТипы.Добавить(Тип("Null"));
	спПримитивныеТипы.Добавить(Тип("Строка"));
	спПримитивныеТипы.Добавить(Тип("Число"));
	спПримитивныеТипы.Добавить(Тип("Дата"));
	спПримитивныеТипы.Добавить(Тип("Булево"));
	спПримитивныеТипы.Добавить(Тип("УникальныйИдентификатор"));
	спПримитивныеТипы.Добавить(Тип("ДвоичныеДанные"));
	спПримитивныеТипы.Добавить(Тип("ХранилищеЗначения"));
	спПримитивныеТипы.Добавить(Тип("ТаблицаЗначений"));
	спПримитивныеТипы.Добавить(Тип("ВидСчета"));
	//спПримитивныеТипы.Добавить(Тип("Тип"));
	
	//добавим перечисления
	Для Каждого МД Из Метаданные.Перечисления Цикл спПримитивныеТипы.Добавить(Тип("ПеречислениеСсылка."+МД.Имя)) КонецЦикла;	
	
	Запрос=Новый Запрос("Выбрать 1 Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.ОбъектыМД ГДЕ Активно И Имя=&Имя И БазаДанных=&БазаДанных"); 
	Запрос.УстановитьПараметр("БазаДанных",БазаДанных);//Renault_ПередачаДанныхВСторонниеСистемы.ТекущаяБазаДанных());
	
	Для Каждого Эл Из СтруктураМетаданных Цикл
		МассивТипов=Эл.Значение.Типы();
		//удалить тип NULL из списка типов для корректного определения составных типов
		Индекс=МассивТипов.Найти(Тип("Null")); Если Индекс<>Неопределено Тогда МассивТипов.Удалить(Индекс) КонецЕсли;	
		
		МножественныйТип=МассивТипов.Количество()>1;
		МассивМножественных=Новый Массив;
		
		Для Каждого Тип Из МассивТипов Цикл
			Если спПримитивныеТипы.Найти(Тип)<>Неопределено Тогда Продолжить КонецЕсли; //примитивные типы не проверяем
			ИмяМДРекв=Renault_ПередачаДанныхВСторонниеСистемы.ТипЗначенияВМетаданныеСтрокой(Тип);
			Если ИмяМДРекв=ИмяМД Тогда Продолжить КонецЕсли; //ссылку на себя проверять не надо 
			Запрос.УстановитьПараметр("Имя",ИмяМДРекв);
			Если Запрос.Выполнить().Пустой() Тогда 
				Если МассивНеНайденныхТипов.Найти(ИмяМДРекв)=Неопределено Тогда МассивНеНайденныхТипов.Добавить(ИмяМДРекв) КонецЕсли; //общий список не найденных
				Если МножественныйТип Тогда МассивМножественных.Добавить(ИмяМДРекв) //отдельный список не найденных составных
				Иначе //отдельный список не найденных не составных
					ЕстьОшибки=Истина;
					Сообщить("Реквизит <"+Эл.Ключ+"> типа "+ИмяМДРекв+" не описан в Метаданных",СтатусСообщения.Внимание);
				КонецЕсли; 
			КонецЕсли;	
		КонецЦикла;
		
		//оповещение о не найденных составных типах 
		Если МножественныйТип И МассивМножественных.Количество()>0 Тогда
			Сообщить("Реквизит <"+Эл.Ключ+"> имеет составной тип значений, возможна ошибка при выгрузке т.к. не описаны типы:"+Символы.ПС+Renault_ПередачаДанныхВСторонниеСистемы.МассивВСтроку(МассивМножественных,Символы.ПС+Символы.Таб),СтатусСообщения.Информация);
		КонецЕсли;	
	КонецЦикла;
		
	Возврат НЕ ЕстьОшибки		
КонецФункции

Функция СоздатьСсылкиОбъектовМетаданных(МассивИменМД) Экспорт
	ЕстьОшибка=Ложь;
	Сп=Новый СписокЗначений;
	Сп.Добавить("кнЗаписатьТолькоСсылки","Только ссылки");
	Сп.Добавить("кнЗаписатьПредопределенныеРеквизиты","Предопределенные реквизиты");
	Сп.Добавить("кнЗаписатьРеквизитыМД","Реквизиты метаданных");
	Сп.Добавить("кнЗаписатьРеквизитыМДИПредопределенные","Реквизиты метаданных и предопределенные");
	ИмяКоманды=Сп.ВыбратьЭлемент("Укажите способ создания","кнЗаписатьТолькоСсылки");
	Для Каждого ИмяМД Из МассивИменМД Цикл
		Если Не ТипЗнч( СоздатьМД(ИмяМД,ИмяКоманды.Значение) )=Тип("ВнешнийИсточникДанныхТаблицаСсылка.Renault_ПередачаДанныхВСторонниеСистемы.ОбъектыМД") Тогда
			ЕстьОшибка=Истина;
		КонецЕсли;	
	КонецЦикла;
	Возврат Не ЕстьОшибка
КонецФункции

&НаКлиенте
Функция СоздатьРеквизитыОбъектаМетаданных(ОбъектМД) Экспорт
	Если ОбъектМД.ТекстЗапроса="" И Найти(ОбъектМД.Имя,".")=0 Тогда Возврат Истина КонецЕсли;
	Если НЕ ЕстьРеквизитыОбъектаМД(ОбъектМД) И Вопрос("Создать реквизиты объекта метаданных?",РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда
		Если ПустаяСтрока(ОбъектМД.ТекстЗапроса) Тогда
			Сп=Новый СписокЗначений;
			//Сп.Добавить("кнЗаписатьТолькоСсылки","Только ссылки");
			Сп.Добавить("кнЗаписатьПредопределенныеРеквизиты","Предопределенные реквизиты");
			Сп.Добавить("кнЗаписатьРеквизитыМД","Реквизиты метаданных");
			Сп.Добавить("кнЗаписатьРеквизитыМДИПредопределенные","Реквизиты метаданных и предопределенные");
			ИмяКоманды=Сп.ВыбратьЭлемент("Укажите способ создания","кнЗаписатьТолькоСсылки").Значение;
		Иначе
			ИмяКоманды="кнЗаписатьРеквизитыПоЗапросу";
		КонецЕсли;
		
		ТекстОшибки="";
		Если ЗаполнитьРеквизитыОбъекта(ОбъектМД,ТекстОшибки,ИмяКоманды) Тогда 
			Сообщить("Реквизиты записаны",СтатусСообщения.Информация);
			ВыполнитьПроверку(ОбъектМД);
			Возврат Истина
		Иначе
			Сообщить("Реквизиты не записаны",СтатусСообщения.Внимание);
			Возврат Ложь
		КонецЕсли;	
	КонецЕсли;	
КонецФункции

Функция ЕстьРеквизитыОбъектаМД(ОбъектМД)
	Запрос=Новый Запрос("Выбрать 1 Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.РеквизитыМД ГДЕ ОбъектМД=&ОбъектМД");
	Запрос.УстановитьПараметр("ОбъектМД",ОбъектМД);
	Возврат НЕ Запрос.Выполнить().Пустой()
КонецФункции	

&НаКлиенте
Функция ВыполнитьПроверку(ОбъектМД) Экспорт
	Если Не ОбъектМД.Активно Тогда Возврат Истина КонецЕсли;
	Если ОбъектМД.Ссылка.Пустая() Тогда Сообщить("Не выбран объект метаданных",СтатусСообщения.Внимание); Возврат Ложь КонецЕсли;
	СтруктураРеквизитов=Renault_ПередачаДанныхВСторонниеСистемы.СтруктураРеквизитовОбъектаМД(ОбъектМД.Ссылка);
	
	МассивНеНайденныхТипов=Новый Массив;
	Если ВыполнитьПроверкуРеквизитов(ОбъектМД.Имя,ОбъектМД.БазаДанных,СтруктураРеквизитов,МассивНеНайденныхТипов) Тогда
		Сообщить("Проверка выполнена успешно",СтатусСообщения.Информация);
		Возврат Истина
	Иначе
		Если Вопрос("Создать ссылки не найденных объектов метаданных?",РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда
			Возврат СоздатьСсылкиОбъектовМетаданных(МассивНеНайденныхТипов)
		КонецЕсли;	
	КонецЕсли;	
КонецФункции	

Функция ЕстьПодчиненные(СсылкаОбъектМД) Экспорт
	Запрос=Новый Запрос("Выбрать 1 Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.ОбъектыМД ГДЕ Родитель=&Родитель");
	Запрос.УстановитьПараметр("Родитель",СсылкаОбъектМД);
	Возврат НЕ Запрос.Выполнить().Пустой()
КонецФункции

Функция УдалениеИерархическогоСписка(СсылкаОбъектМД) Экспорт
	Если ЕстьПодчиненные(СсылкаОбъектМД) Тогда
		Запрос=Новый Запрос("Выбрать Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.ОбъектыМД ГДЕ Родитель=&Родитель");
		Запрос.УстановитьПараметр("Родитель",СсылкаОбъектМД);
		Выборка=Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			УдалениеИерархическогоСписка(Выборка.Ссылка)
		КонецЦикла;
	КонецЕсли;
	СсылкаОбъектМД.ПолучитьОбъект().Удалить()
КонецФункции	
