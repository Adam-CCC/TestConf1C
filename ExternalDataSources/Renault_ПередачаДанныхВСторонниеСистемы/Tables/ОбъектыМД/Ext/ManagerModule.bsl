Функция УстановитьАктивность(ОбъектМД,Знач Активно) Экспорт
	Объект=ОбъектМД.ПолучитьОбъект();
	Объект.Активно=Активно;
	Попытка
		Объект.Записать();
	Исключение
		Сообщить(ОписаниеОшибки(),СтатусСообщения.Внимание);
	КонецПопытки;
	Возврат Объект.Ссылка.Активно	
КонецФункции

