// Отправка СМС на портал Билайн

// Функция предназначена для отправки группы одинаковых sms-сообщений на сервер Билайн. 
// Группу сообщений объединяют единые временные характеристики отправки 
// (дата отправки, актуальность и т.п.). В предметной реализации группой 
// можно считать отдельный документ рассылки либо, например, набор сообщений 
// с незаполненными временными характеристиками.
//							
// Параметры:
//
//  ДокументСсылка -            Сылка на документ SMS
//
//  СписокСообщений (массив) -	Обязательный параметр. Содержит массив структур, содержащих поля
//								sms-сообщений, предназначенных для отправки на сервер.
//							
// НомерОтправителя (строка) - 	Обязательный параметр. Номер, с которого отправляются сообщения.
//							
//  ТекстСообщенияПоУмолчанию (строка) - Необязательный параметр. Данный текст будет использоваться
//								для отправки тем получателям, для которых в списке сообщений не указан
//								текст сообщения. В случае групповой рассылки сообщений с одним общим
//								текстом достаточно заполнить данный параметр и в списке сообщений 
//								нигде не указывать текст сообщения. В случае если для получателя указан
//								персональный текст, текст по умолчанию не будет использоваться для
//								отправки сообщения данному получателю.
//							
//  ДатаОтправки (дата) - 		Необязательный параметр. Дата начала отправки sms-сообщения
//							
//  Актуальность (дата) - 		Необязательный параметр. Дата, до которой сообщение будет пытаться
//								отправиться сервером sms4b.
//							
//  НачалоПериодаЗапрета (дата) - Необязательный параметр. Указывает, с какого времени начинается период,
//								в который сообщения не должны отправляться (например, чтобы они не 
//								приходили получателям ночью). Актуальным является только временная часть
//								даты (ЧЧ:ММ:СС). Сама дата (ДД.ММ,ГГГГ) не анализируется и может быть 
//								передана любая (в том числе пустая).
//							
// - КонецПериодаЗапрета (дата) - Необязательный параметр. Указывает время окончания периода, в который
//								сообщения не должны отправляться (например, чтобы они не приходили 
//								получателям ночью). Актуальным является только временная часть даты 
//								(ЧЧ:ММ:СС). Сама дата (ДД.ММ,ГГГГ) не анализируется и может быть передана 
//								любая (в том числе пустая).
//							
// - РавномернаяРассылка(булево) - Необязательный параметр. Содержит признак равномерной рассылки. При 
//								использовании равномерной рассылки сообщения группы будут отправляться
//								через равные промежутки времени пропорционально периоду рассылки. 
//								Значение по умолчанию – ложь.
//
// 
// Возвращаемое значение (число):
// 
// Возвращает числовой код ошибки, 1 – если функция выполнена успешно, 
// и код ошибки < 0, если функция выполнена не успешно.
//
Функция ОтправитьСообщения(ДокументСсылка, СписокСообщений, НомерОтправителя, ТекстСообщенияПоУмолчанию = "", _ДатаОтправки, _Актуальность = '00010101', НачалоПериодаЗапрета = '00010101', 
										КонецПериодаЗапрета = '00010101', РавномернаяРассылка = Ложь) Экспорт
	
	Если СписокСообщений.Количество() > 12000 Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Запрещено отправлять более 12000 сообщений в одном документе!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;
	
	Результат = Новый Структура("ОтправленныеСообщения,ОписаниеОшибки", Новый Массив, "");
	СтрокаПолучателей = МассивПолучателейСтрокой(СписокСообщений);
	Если ПустаяСтрока(СтрокаПолучателей) Тогда
		Результат.ОписаниеОшибки = "Список номеров получателей пуст";
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщения. Список номеров получателей пуст!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстСообщенияПоУмолчанию) Тогда
		Результат.ОписаниеОшибки = "Текст сообщения пуст";
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщения. Текст сообщения пуст!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -1;
	
	ИначеЕсли СтрДлина(ТекстСообщенияПоУмолчанию) > 480 Тогда
		Результат.ОписаниеОшибки = "Длина сообщения превышает 480 символов";
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщения. Длина сообщение превышает 480 символов!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("user",	 Константы.смсИмяПользователя.Получить());
	ПараметрыЗапроса.Вставить("pass",	 Константы.смсПарольПользователя.Получить());
	ПараметрыЗапроса.Вставить("gzip",	 "none");
	ПараметрыЗапроса.Вставить("action",	 "post_sms");
	ПараметрыЗапроса.Вставить("message", ТекстСообщенияПоУмолчанию);
	ПараметрыЗапроса.Вставить("target",	 СтрокаПолучателей);
	ПараметрыЗапроса.Вставить("sender",	 НомерОтправителя);
	ПараметрыЗапроса.Вставить("show_description", "true");
	
	ТелоОтвета = ВыполнитьЗапрос(ПараметрыЗапроса);
	Если ПустаяСтрока(ТелоОтвета) Тогда
		Результат.ОписаниеОшибки = "Соединение не установлено!";
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщения. Соединение не установлено!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;		
	
	ТелоОтветаXML = Новый ЧтениеXML;
	ТелоОтветаXML.УстановитьСтроку(ТелоОтвета);
	ОписаниеОшибки = "";
	Пока ТелоОтветаXML.Прочитать() Цикл 
		Если ТелоОтветаXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если ТелоОтветаXML.Имя = "sms" Тогда 
				ИдентификаторСообщения = "";
				НомерПолучателя = "";
				Пока ТелоОтветаXML.ПрочитатьАтрибут() Цикл 
					Если ТелоОтветаXML.Имя = "id" Тогда 
						ИдентификаторСообщения = ТелоОтветаXML.Значение;
					ИначеЕсли ТелоОтветаXML.Имя = "phone" Тогда
						НомерПолучателя = ТелоОтветаXML.Значение;
					КонецЕсли;
				КонецЦикла;
				
				Если Не ПустаяСтрока(НомерПолучателя) Тогда
					НомерПолучателя = смсРаботаССообщениями.УбратьЛишниеСимволыТелефона(НомерПолучателя);
					ОтправленноеСообщение = Новый Структура("НомерПолучателя,ИдентификаторСообщения",
														 НомерПолучателя, ИдентификаторСообщения);
					Результат.ОтправленныеСообщения.Добавить(ОтправленноеСообщение);
				КонецЕсли;
			ИначеЕсли ТелоОтветаXML.Имя = "error" Тогда
				ТелоОтветаXML.Прочитать();
				ОписаниеОшибки = ОписаниеОшибки + ТелоОтветаXML.Значение + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат.ОписаниеОшибки = СокрП(ОписаниеОшибки);	
	Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		смсРаботаССообщениями.ВывестиСообщение("Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить часть сообщений. " + Результат.ОписаниеОшибки,
					СтатусСообщения.Важное, "Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
	КонецЕсли;
	
	СписокОтправленных = Результат.ОтправленныеСообщения;
	Для Каждого Сообщение Из СписокСообщений Цикл
		Сообщение.КодОшибки = -3;
		Для Каждого Отправленное Из СписокОтправленных Цикл
			Если Сообщение.НомерПолучателя = Отправленное.НомерПолучателя Тогда
				Сообщение.КодОшибки = 3;
				Сообщение.sms_id = Отправленное.ИдентификаторСообщения;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	Возврат 1;
КонецФункции

Функция ОбновитьСтатусы(СписокСообщений) Экспорт
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("action",	 "status");
	ПараметрыЗапроса.Вставить("user",	 Константы.смсИмяПользователя.Получить());
	ПараметрыЗапроса.Вставить("pass",	 Константы.смсПарольПользователя.Получить());
	ПараметрыЗапроса.Вставить("smstype", "SENDSMS");
	ПараметрыЗапроса.Вставить("gzip",	 "none");
	
	Для Каждого Сообщение Из СписокСообщений Цикл
		ПараметрыЗапроса.Вставить("sms_id", Сообщение.sms_id);
		ДокументСсылка = Сообщение.ДокументСсылка;
		ТелоОтвета = ВыполнитьЗапрос(ПараметрыЗапроса);
		Если ПустаяСтрока(ТелоОтвета) Тогда
			смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось получить статусы сообщений. Соединение не установлено!'"), СтатусСообщения.Важное,
			"Получение статусов СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
			Возврат -3;
		КонецЕсли;		
		
		ТелоОтветаXML = Новый ЧтениеXML;
		ТелоОтветаXML.УстановитьСтроку(ТелоОтвета);
		КодСтатусаБилайн = "";
		ОписаниеОшибки = "";
		Пока ТелоОтветаXML.Прочитать() Цикл 
			Если ТелоОтветаXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Если ТелоОтветаXML.Имя = "SMSSTC_CODE" Тогда 
					ТелоОтветаXML.Прочитать();
					КодСтатусаБилайн = ТелоОтветаXML.Значение;
					Если ЗначениеЗаполнено(КодСтатусаБилайн) Тогда
						Сообщение.СтатусСообщения = КодБилайнВСтатус(КодСтатусаБилайн);
						// Меняем состояние сообщения в регистре сведений "смсСостоянияСообщений"
						МенеджерЗаписи = РегистрыСведений.смсСостоянияСообщений.СоздатьМенеджерЗаписи();
						МенеджерЗаписи.Сообщение = Сообщение.ДокументСсылка;
						МенеджерЗаписи.НомерСтрокиДокумента = Сообщение.НомерСтрокиДокумента;
						МенеджерЗаписи.GUID	= Сообщение.GUID;
						МенеджерЗаписи.sms_id	= Сообщение.sms_id;
						МенеджерЗаписи.Статус = Сообщение.СтатусСообщения;
						МенеджерЗаписи.Записать();
						Сообщение.КодОшибки = 3;
					Иначе
						смсРаботаССообщениями.ВывестиСообщение("Документ №"+ ДокументСсылка.Номер
									+ ". Код статуса Билайн пуст!",
									СтатусСообщения.Важное, "Получение статусов СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
						Сообщение.КодОшибки = -3;
					КонецЕсли;
				ИначеЕсли ТелоОтветаXML.Имя = "error" Тогда
					ТелоОтветаXML.Прочитать();
					ОписаниеОшибки = ТелоОтветаXML.Значение;
					Сообщение.КодОшибки = -3;
					смсРаботаССообщениями.ВывестиСообщение("Документ №"+ ДокументСсылка.Номер
								+ ". Не удалось получить статус сообщения. " + ОписаниеОшибки,
								СтатусСообщения.Важное, "Получение статусов СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
	Возврат 1;
КонецФункции

Функция ПолучитьСтатусыЗаПериод(ДатаНачала, ДатаОкончания) Экспорт
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("action",	 "status");
	ПараметрыЗапроса.Вставить("user",	 Константы.смсИмяПользователя.Получить());
	ПараметрыЗапроса.Вставить("pass",	 Константы.смсПарольПользователя.Получить());
	ПараметрыЗапроса.Вставить("smstype", "SENDSMS");
	ПараметрыЗапроса.Вставить("gzip",	 "none");
	ПараметрыЗапроса.Вставить("date_from",	Формат(ДатаНачала, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'")); // "ДЛФ=ДВ" 
	ПараметрыЗапроса.Вставить("date_to",	Формат(ДатаОкончания, "ДФ='дд.ММ.гггг ЧЧ:мм:сс'"));
	
	ТелоОтвета = ВыполнитьЗапрос(ПараметрыЗапроса);
	Если ПустаяСтрока(ТелоОтвета) Тогда
		смсРаботаССообщениями.ВывестиСообщение("Не удалось получить статусы сообщений. Соединение не установлено!", СтатусСообщения.Важное,
		"Получение статусов СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;		
	
	ТелоОтветаXML = Новый ЧтениеXML;
	ТелоОтветаXML.УстановитьСтроку(ТелоОтвета);
	КодСтатусаБилайн = "";
	ОписаниеОшибки = "";
	ОтветПостроительDOM = Новый ПостроительDOM();
	ОтветDOM = ОтветПостроительDOM.Прочитать(ТелоОтветаXML);
	СписокСообщенийDOM = ОтветDOM.ПолучитьЭлементыПоИмени("MESSAGE");
	Если СписокСообщенийDOM.Количество() = 0 Тогда
		смсРаботаССообщениями.ВывестиСообщение("Отсутствуют сообщения за период с " + ПараметрыЗапроса.date_from + " по " + ПараметрыЗапроса.date_to + "!", СтатусСообщения.Важное,
		"Получение статусов СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат 0;
	КонецЕсли;
	
	ОписаниеТипаСтрока = Новый ОписаниеТипов("Строка");
	ОписаниеТипаДата = Новый ОписаниеТипов("Дата");
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10));
	ТаблицаСообщений = Новый ТаблицаЗначений();
	ТаблицаСообщений.Колонки.Добавить("SMS_ID", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("SMS_GROUP_ID", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("ДатаСоздания", ОписаниеТипаДата);
	ТаблицаСообщений.Колонки.Добавить("СистемаОтправки", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("ИмяОтправителя", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("ТелефонАдресата", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("КоличествоСМС", ОписаниеТипаЧисло);
	ТаблицаСообщений.Колонки.Добавить("ТекстСМС", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("СтатусКод", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("СтатусОписание", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("СтатусОбработкиСМС", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("СтатусОтправкиСМС", ОписаниеТипаСтрока);
	ТаблицаСообщений.Колонки.Добавить("ДатаЗавершенияОбработкиСМС", ОписаниеТипаДата);
	
	Для Каждого СообщениеDOM Из СписокСообщенийDOM Цикл
		SMS_ID = СообщениеDOM.ПолучитьАтрибут("SMS_ID");
		Если обЗначениеНеЗаполнено(SMS_ID) Тогда
			Продолжить;
		КонецЕсли;
		Если СообщениеDOM.ДочерниеУзлы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаСообщений.Добавить();
		НоваяСтрока.SMS_ID = SMS_ID;
		НоваяСтрока.SMS_GROUP_ID = СообщениеDOM.ПолучитьАтрибут("SMS_GROUP_ID");		
		Для Каждого УзелСообщения Из СообщениеDOM.ДочерниеУзлы Цикл
			Если УзелСообщения.ТипУзла = ТипУзлаDOM.Элемент Тогда
				ТекстУзла = "";
				Для Каждого ДочернийУзел Из УзелСообщения.ДочерниеУзлы Цикл
					Если ДочернийУзел.ТипУзла = ТипУзлаDOM.Текст Или ДочернийУзел.ТипУзла = ТипУзлаDOM.СекцияCDATA Тогда
						ТекстУзла = ДочернийУзел.Данные;
					КонецЕсли;
				КонецЦикла;			
				Если УзелСообщения.ИмяУзла = "CREATED" Тогда
					НоваяСтрока.ДатаСоздания = Дата(ТекстУзла);
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_SUBMITTER_SUBSYSTEM" Тогда
					НоваяСтрока.СистемаОтправки = ТекстУзла;
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_SENDER" Тогда
					НоваяСтрока.ИмяОтправителя = ТекстУзла;
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_TARGET" Тогда
					НоваяСтрока.ТелефонАдресата = ТекстУзла;
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_RES_COUNT" Тогда
					НоваяСтрока.КоличествоСМС = XMLЗначение(Тип("Число"), ТекстУзла);
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_TEXT" Тогда
					НоваяСтрока.ТекстСМС = ТекстУзла
				ИначеЕсли УзелСообщения.ИмяУзла = "SMSSTC_CODE" Тогда
					НоваяСтрока.СтатусКод = ТекстУзла;
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_STATUS" Тогда
					НоваяСтрока.СтатусОписание = ТекстУзла;
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_CLOSED" Тогда
					НоваяСтрока.СтатусОбработкиСМС = ТекстУзла;
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_SENT" Тогда
					НоваяСтрока.СтатусОтправкиСМС = ТекстУзла;
				ИначеЕсли УзелСообщения.ИмяУзла = "SMS_CLOSE_TIME" Тогда
					НоваяСтрока.ДатаЗавершенияОбработкиСМС = Дата(ТекстУзла);
				КонецЕсли;
			КонецЕсли;					
		КонецЦикла;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смсСостоянияСообщений.Сообщение,
	|	смсСостоянияСообщений.НомерСтрокиДокумента,
	|	смсСостоянияСообщений.Статус,
	|	смсСостоянияСообщений.sms_id
	|ИЗ
	|	РегистрСведений.смсСостоянияСообщений КАК смсСостоянияСообщений
	|ГДЕ
	|	смсСостоянияСообщений.Сообщение.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	СостоянияСообщений = Запрос.Выполнить().Выгрузить();
	
	ДокументОбъектСМС = Документы.SMS.СоздатьДокумент();
	ДокументОбъектСМС.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
	ДокументОбъектСМС.Организация = ДокументОбъектСМС.ПодразделениеКомпании.Организация;
	ДокументОбъектСМС.Автор = Справочники.Пользователи.Робот;
	ДокументОбъектСМС.ХозОперация = Справочники.ХозОперации.SMS;
	ДокументОбъектСМС.Дата = ТекущаяДата();
	ДокументОбъектСМС.Входящее_Исходящее = Перечисления.ТипыСообщений.Исходящее;
	
	мзСостоянияСообщений = РегистрыСведений.смсСостоянияСообщений.СоздатьМенеджерЗаписи();
	КодРассылки = "";
	Для Каждого СтрокаСообщение Из ТаблицаСообщений Цикл
		СостояниеСМС = КодБилайнВСтатус(СтрокаСообщение.СтатусКод);
		ДатаЗавершения = Дата(2000 + Год(СтрокаСообщение.ДатаЗавершенияОбработкиСМС), Месяц(СтрокаСообщение.ДатаЗавершенияОбработкиСМС), День(СтрокаСообщение.ДатаЗавершенияОбработкиСМС),
							Час(СтрокаСообщение.ДатаЗавершенияОбработкиСМС), Минута(СтрокаСообщение.ДатаЗавершенияОбработкиСМС), Секунда(СтрокаСообщение.ДатаЗавершенияОбработкиСМС));
							
		СтрокаСостояния = СостоянияСообщений.Найти(СтрокаСообщение.SMS_ID, "sms_id");
		Если СтрокаСостояния = Неопределено Тогда		
			Если КодРассылки <> СтрокаСообщение.SMS_GROUP_ID Тогда
				КодРассылки = СтрокаСообщение.SMS_GROUP_ID;
				Если ДокументОбъектСМС.Получатели.Количество() > 0 Тогда
					ДокументОбъектСМС.ТекстСообщения = ДокументОбъектСМС.Получатели[0].ТекстСообщения;
					ДокументОбъектСМС.Записать();
					
					ДокументОбъектСМС = Документы.SMS.СоздатьДокумент();
					ДокументОбъектСМС.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
					ДокументОбъектСМС.Организация = ДокументОбъектСМС.ПодразделениеКомпании.Организация;
					ДокументОбъектСМС.Автор = Справочники.Пользователи.Робот;
					ДокументОбъектСМС.ХозОперация = Справочники.ХозОперации.SMS;
					ДокументОбъектСМС.Дата = ТекущаяДата();
					ДокументОбъектСМС.Входящее_Исходящее = Перечисления.ТипыСообщений.Исходящее;
				КонецЕсли;
			КонецЕсли;
			
			ДокументОбъектСМС.НомерОтправителя = СтрокаСообщение.ИмяОтправителя;
			НовыйПолучатель = ДокументОбъектСМС.Получатели.Добавить();
			НовыйПолучатель.GUID_SMS = Новый УникальныйИдентификатор;
			НовыйПолучатель.Контрагент = "WEB-Рассылка, id=" + КодРассылки;
			НовыйПолучатель.НомерТелефона = СтрокаСообщение.ТелефонАдресата;
			НовыйПолучатель.ТекстСообщения = СтрокаСообщение.ТекстСМС;
			НовыйПолучатель.Статус = СостояниеСМС;
			НовыйПолучатель.ДатаЗавершения = ДатаЗавершения;
			
			Если ДокументОбъектСМС.ЭтоНовый() Тогда
				ДокументОбъектСМС.Записать();
			КонецЕсли;
			
			мзСостоянияСообщений = РегистрыСведений.смсСостоянияСообщений.СоздатьМенеджерЗаписи();
			мзСостоянияСообщений.Сообщение = ДокументОбъектСМС.Ссылка;
			мзСостоянияСообщений.НомерСтрокиДокумента = НовыйПолучатель.НомерСтроки;
			мзСостоянияСообщений.GUID = НовыйПолучатель.GUID_SMS;
			мзСостоянияСообщений.Статус = СостояниеСМС;
			мзСостоянияСообщений.sms_id = СтрокаСообщение.SMS_ID;
			мзСостоянияСообщений.Записать();
					
		ИначеЕсли СтрокаСостояния.Статус <> СостояниеСМС Тогда
			мзСостоянияСообщений = РегистрыСведений.смсСостоянияСообщений.СоздатьМенеджерЗаписи();
			мзСостоянияСообщений.Сообщение = СтрокаСостояния.Сообщение;
			мзСостоянияСообщений.НомерСтрокиДокумента = СтрокаСостояния.НомерСтрокиДокумента;
			мзСостоянияСообщений.Прочитать();
			Если мзСостоянияСообщений.Выбран() Тогда
				мзСостоянияСообщений.Статус = СостояниеСМС;
				мзСостоянияСообщений.Записать();
				ДокументОбъект = СтрокаСостояния.Сообщение.ПолучитьОбъект();
				ДокументОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ДокументОбъектСМС.Получатели.Количество() > 0 Тогда
		ДокументОбъектСМС.ТекстСообщения = ДокументОбъектСМС.Получатели[0].ТекстСообщения;
		ДокументОбъектСМС.Записать();
	КонецЕсли;
	
	Возврат 1;
КонецФункции

Функция ВыполнитьЗапрос(ПараметрыЗапроса)
	Результат = "";	
	ТелоЗапроса = СформироватьСтрокуДляPOSTЗапроса(ПараметрыЗапроса);
	Если обЗначениеНеЗаполнено(ТелоЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Таймаут = 120;
	SSL =  Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());
	Попытка
	    НТТР = Новый HTTPСоединение("a2p-sms-https.beeline.ru", , , , , Таймаут, SSL);
	Исключение
		Сообщить("Не удалось установить соединение с сервером:" 
		    	+ Символы.ПС + ИнформацияОбОшибке().Описание, СтатусСообщения.Важное);
	    Возврат Результат;
	КонецПопытки;
	
	// Заголовки запросов Билайн	
	ЗаголовкиHTTPБилайн = Новый Соответствие;
	ЗаголовкиHTTPБилайн.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=utf-8");
	ЗаголовкиHTTPБилайн.Вставить("Accept", "text/xml (UTF-8)");
	ЗаголовкиHTTPБилайн.Вставить("Connection", "Keep-Alive");
	
	ЗапросHTTP = Новый HTTPЗапрос();
	ЗапросHTTP.Заголовки = ЗаголовкиHTTPБилайн;	
	ЗапросHTTP.АдресРесурса = "/proto/http/";
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса,, ИспользованиеByteOrderMark.НеИспользовать);
	
	//Галактионов++ 20250715
 	Попытка
	//Галактионов-- 20250715
		НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);
		Возврат НТТРОтвет.ПолучитьТелоКакСтроку();
	//Галактионов-- 20250715	
	Исключение  
		Возврат "";
	КонецПопытки;	
	//Галактионов-- 20250715
	
КонецФункции

Функция СформироватьСтрокуДляPOSTЗапроса(ПараметрыЗапроса) Экспорт
	СтрокаЗапроса = "";
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Если Не ПустаяСтрока(СтрокаЗапроса) Тогда
			СтрокаЗапроса = СтрокаЗапроса + "&";
		КонецЕсли;
		СтрокаЗапроса = СтрокаЗапроса + Параметр.Ключ + "=" + Параметр.Значение;
	КонецЦикла;
	
	Возврат СтрокаЗапроса;
КонецФункции

// Функция предназначена для перевода статуса Билайн в значение перечияления смсСостоянияСообщений  
//
// Параметры:
//
//  КодБилайн (строка)- код статуса Билайн.
// 
// Возвращаемое значение (Перечисления.смсСостоянияСообщений):
// 
// Возвращает статус СМС
//
Функция КодБилайнВСтатус(КодБилайн)
	
	Если КодБилайн = "queued" Тогда
		Статус = Перечисления.смсСостоянияСообщений.ВОчереди;
	ИначеЕсли КодБилайн = "wait" Тогда
		Статус = Перечисления.смсСостоянияСообщений.ВОчереди;
	ИначеЕсли КодБилайн = "accepted" Тогда
		Статус = Перечисления.смсСостоянияСообщений.Отправлено;
	ИначеЕсли КодБилайн = "delivered" Тогда
		Статус = Перечисления.смсСостоянияСообщений.Доставлено;
	ИначеЕсли КодБилайн = "not_delivered" Тогда
		Статус = Перечисления.смсСостоянияСообщений.НеДоставлено;
	ИначеЕсли КодБилайн = "failed" Тогда
		Статус = Перечисления.смсСостоянияСообщений.Ошибка;
	Иначе
		Статус = Перечисления.смсСостоянияСообщений.ВОчереди;
	КонецЕсли; 
	
	Возврат Статус;	
КонецФункции

Функция СформироватьФайлДляPOSTЗапроса(ПараметрыЗапроса)
	СтрокаЗапроса = "";
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Если Не ПустаяСтрока(СтрокаЗапроса) Тогда
			СтрокаЗапроса = СтрокаЗапроса + "&";
		КонецЕсли;
		СтрокаЗапроса = СтрокаЗапроса + Параметр.Ключ + "=" + URLEncode(Параметр.Значение);
	КонецЦикла;
	
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла("txt");
	
	ФайлЗапроса = Новый ЗаписьТекста(ИмяФайлаЗапроса, КодировкаТекста.ANSI);
	ФайлЗапроса.Записать(СтрокаЗапроса);
	ФайлЗапроса.Закрыть();
	
	Возврат ИмяФайлаЗапроса;
КонецФункции

Функция РазмерФайла(ИмяФайла)
    Файл = Новый Файл(ИмяФайла);
    Возврат Файл.Размер();
КонецФункции

Функция МассивПолучателейСтрокой(СписокСообщений)
	Результат = "";
	Для Каждого Сообщение Из СписокСообщений Цикл
		Номер = ФорматироватьНомер(Сообщение.НомерПолучателя);
		Если НЕ ПустаяСтрока(Номер) Тогда 
			Если Не ПустаяСтрока(Результат) Тогда
				Результат = Результат + ",";
			КонецЕсли;
			Результат = Результат + Номер;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ОтправкаСообщенийДокумента(ДокументСсылка, НеОбновлятьСтатус = Истина) Экспорт
	Если НЕ смсРаботаССообщениями.ПроверитьЗаполнениеКонстант() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	стРеглЗадание = СМ_ПривилегированныйРежим.ПолучитьРасписаниеРегламентного("СМ_РассылкаСМССоколмоторс");
	УстановитьПривилегированныйРежим(Ложь);
	Если обЗначениеНеЗаполнено(стРеглЗадание.ВремяКонца) Тогда
		стРеглЗадание.ВремяКонца = Дата(1, 1, 1, 23, 59, 59);
	КонецЕсли;
		
	стРассылка = Новый Структура();
	стРассылка.Вставить("ДокументСсылка", ДокументСсылка);
	стРассылка.Вставить("НачалоРассылки", ДокументСсылка.НачалоОтправки);
	стРассылка.Вставить("ОкончаниеРассылки", ДокументСсылка.Актуальность);
	стРассылка.Вставить("НачалоПериодаРассылки", стРеглЗадание.ВремяНачала);
	стРассылка.Вставить("ОкончаниеПериодаРассылки", стРеглЗадание.ВремяКонца);
	Если стРассылка.НачалоПериодаРассылки > стРассылка.ОкончаниеПериодаРассылки Тогда
		ПериодРассылки = Дата(1, 1, 1, 23, 59, 59) - стРассылка.НачалоПериодаРассылки;
		ПериодРассылки = ПериодРассылки + Час(стРассылка.ОкончаниеПериодаРассылки)*3600;
		ПериодРассылки = ПериодРассылки + Минута(стРассылка.ОкончаниеПериодаРассылки)*60;
		ПериодРассылки = ПериодРассылки + Секунда(стРассылка.ОкончаниеПериодаРассылки);		
	Иначе
		ПериодРассылки = стРассылка.ОкончаниеПериодаРассылки - стРассылка.НачалоПериодаРассылки; 
	КонецЕсли;
	стРассылка.Вставить("ПериодРассылки", ПериодРассылки);
	стРассылка.Вставить("ВсегоСообщений", ДокументСсылка.Получатели.Количество());		
	
	Если стРассылка.НачалоРассылки > ТекущаяДата() Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ стРассылка.ДокументСсылка.Номер 
		+ ". Текущая дата меньше даты начала отправки!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;
	
	// Выбираем сообщения для отправки
	Если ЗначениеЗаполнено(стРассылка.ОкончаниеРассылки) Тогда
		СообщенийДляОтправки = ПолучитьКоличествоСообщений(стРассылка);
		Если СообщенийДляОтправки > 0 Тогда
			РезультатЗапроса = ПолучитьСообщенияДокумента(ДокументСсылка, СообщенийДляОтправки);
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		РезультатЗапроса = ПолучитьСообщенияДокумента(ДокументСсылка);
	КонецЕсли;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Заполняем параметры отправки сообщений
	НомерОтправителя = ДокументСсылка.НомерОтправителя;		
	стСообщение = Новый Структура();
	стСообщение.Вставить("ДокументСсылка", ДокументСсылка);
	КодОшибки = 0;
	
	Выборка = РезультатЗапроса.Выбрать();
	ВсегоСообщений = Выборка.Количество();	
	КолОтправленных = 0;
	Пока Выборка.Следующий() Цикл
		стСообщение.Вставить("НомерПолучателя", смсРаботаССообщениями.УбратьЛишниеСимволыТелефона(Выборка.НомерПолучателя));
		стСообщение.Вставить("ТекстСообщения", Выборка.ТекстСообщения);
		стСообщение.Вставить("НомерСтрокиДокумента", Выборка.НомерСтрокиДокумента);
		стСообщение.Вставить("GUID", Выборка.GUID);
		стСообщение.Вставить("КодОшибки", Выборка.КодОшибки);
		стСообщение.Вставить("sms_id", Выборка.sms_id);
		// Отправляем сообщение
		КодОшибки = смсКоммуникаторБилайн.ОтправитьСообщениеБилайн(ДокументСсылка, стСообщение, НомерОтправителя);
		
		Если КодОшибки > 0 И стСообщение.КодОшибки > 0 Тогда // Отправленное сообщение
			КолОтправленных = КолОтправленных + 1;
		КонецЕсли; 
	КонецЦикла;
	
	// Если отправились не все сообщения
	Если КолОтправленных < ВсегоСообщений Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер 
		+ " Отправлено: "+КолОтправленных+" из "+ВсегоСообщений+"'") , СтатусСообщения.Важное,
		"Отправка сообщений", УровеньЖурналаРегистрации.Предупреждение);
	КонецЕсли;
	
	Если НеОбновлятьСтатус Тогда
		Возврат;
	КонецЕсли;
	
	// обновляем статус документа
	Попытка
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ДокументОбъект.ПолучитьСтатусыСообщений();
		СтруктураСтатуса = ДокументОбъект.ПолучитьСтатусДокумента();
		ДокументОбъект.СтатусСтрокой = СтруктураСтатуса.СтатусСтрокой;
		ДокументОбъект.Статус        = СтруктураСтатуса.Статус;
		ДокументОбъект.Записать();
	Исключение
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Не удалось записать документ: "+ДокументОбъект.Номер+"'"), СтатусСообщения.Важное,
		"Запись документа", УровеньЖурналаРегистрации.Предупреждение);
	КонецПопытки; 
КонецПроцедуры

Функция ПолучитьСообщенияДокумента(ДокументСсылка, Количество = 0)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ " + ?(Количество = 0, "", " ПЕРВЫЕ " + Строка(Количество)) + "
	|	смсСостоянияСообщений.НомерСтрокиДокумента,
	|	смсСообщениеПолучатели.НомерТелефона КАК НомерПолучателя,
	|	смсСообщениеПолучатели.ТекстСообщения КАК ТекстСообщения,
	|	смсСостоянияСообщений.GUID,
	|	0 КАК КодОшибки,
	|	смсСостоянияСообщений.sms_id
	|ИЗ
	|	РегистрСведений.смсСостоянияСообщений КАК смсСостоянияСообщений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.SMS.Получатели КАК смсСообщениеПолучатели
	|		ПО смсСостоянияСообщений.Сообщение = смсСообщениеПолучатели.Ссылка
	|			И смсСостоянияСообщений.НомерСтрокиДокумента = смсСообщениеПолучатели.НомерСтроки
	|ГДЕ
	|	смсСостоянияСообщений.Статус = ЗНАЧЕНИЕ(Перечисление.смсСостоянияСообщений.Доставка)
	|	И смсСостоянияСообщений.Сообщение = &ДокументСсылка";
	
	Возврат Запрос.Выполнить();
КонецФункции

Функция ОтправитьСообщениеБилайн(ДокументСсылка, стСообщение, НомерОтправителя) Экспорт
		
	Если ПустаяСтрока(стСообщение.НомерПолучателя) Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщение. Номер получателя пуст!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;
	
	Если ПустаяСтрока(стСообщение.ТекстСообщения) Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщение. Текст сообщения пуст!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -1;
	
	ИначеЕсли СтрДлина(стСообщение.ТекстСообщения) > 480 Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщение. Длина сообщения превышает 480 символов!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("user",	 Константы.смсИмяПользователя.Получить());
	ПараметрыЗапроса.Вставить("pass",	 Константы.смсПарольПользователя.Получить());
	ПараметрыЗапроса.Вставить("gzip",	 "none");
	ПараметрыЗапроса.Вставить("action",	 "post_sms");
	ПараметрыЗапроса.Вставить("message", ЭкранированиеСпецсимволов(стСообщение.ТекстСообщения));
	ПараметрыЗапроса.Вставить("target",	 стСообщение.НомерПолучателя);
	ПараметрыЗапроса.Вставить("sender",	 НомерОтправителя);
	ПараметрыЗапроса.Вставить("show_description", "true");
	
	ТелоОтвета = ВыполнитьЗапрос(ПараметрыЗапроса);
	Если ПустаяСтрока(ТелоОтвета) Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщение. Соединение не установлено!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
		Возврат -3;
	КонецЕсли;		
	
	Результат = Новый Структура("ОтправленныеСообщения,ОписаниеОшибки", Новый Массив, "");
	ТелоОтветаXML = Новый ЧтениеXML;
	ТелоОтветаXML.УстановитьСтроку(ТелоОтвета);
	
	ОписаниеОшибки = "";
	Попытка
		Пока ТелоОтветаXML.Прочитать() Цикл 
			Если ТелоОтветаXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Если ТелоОтветаXML.Имя = "sms" Тогда 
					ИдентификаторСообщения = "";
					НомерПолучателя = "";
					Пока ТелоОтветаXML.ПрочитатьАтрибут() Цикл 
						Если ТелоОтветаXML.Имя = "id" Тогда 
							ИдентификаторСообщения = ТелоОтветаXML.Значение;
						ИначеЕсли ТелоОтветаXML.Имя = "phone" Тогда
							НомерПолучателя = ТелоОтветаXML.Значение;
						КонецЕсли;
					КонецЦикла;
					
					Если Не ПустаяСтрока(НомерПолучателя) Тогда					
						стСообщение.sms_id = ИдентификаторСообщения;
						стСообщение.КодОшибки = 3;
					КонецЕсли;
					
				ИначеЕсли ТелоОтветаXML.Имя = "error" Тогда
					ТелоОтветаXML.Прочитать();
					ОписаниеОшибки = ОписаниеОшибки + ТелоОтветаXML.Значение + Символы.ПС;
					стСообщение.КодОшибки = -3;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		ОписаниеОшибки = ОписаниеОшибки + "Ошибка при чтении тела ответа сервера a2p-sms.beeline.ru," + Символы.ПС;
		ОписаниеОшибки = ОписаниеОшибки + "проверьте наличие в тексте СМС управляющих символов.";
		стСообщение.КодОшибки = -3;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		смсРаботаССообщениями.ВывестиСообщение("Документ №"+ ДокументСсылка.Номер + ". Не удалось отправить сообщение. " + ОписаниеОшибки,
					СтатусСообщения.Важное, "Отправка СМС сообщений", УровеньЖурналаРегистрации.Предупреждение);
	КонецЕсли;
													
	// Меняем состояния сообщения в регистре сведений "смсСостоянияСообщений"
	мзСостояниеСообщения = РегистрыСведений.смсСостоянияСообщений.СоздатьМенеджерЗаписи();
	мзСостояниеСообщения.Сообщение = ДокументСсылка;
	мзСостояниеСообщения.НомерСтрокиДокумента = стСообщение.НомерСтрокиДокумента;
	мзСостояниеСообщения.Прочитать();
	Если мзСостояниеСообщения.Выбран() Тогда
		Если стСообщение.КодОшибки = 0 Тогда // Сообщение не отправилось
			мзСостояниеСообщения.Статус = Перечисления.смсСостоянияСообщений.Доставка;
		ИначеЕсли стСообщение.КодОшибки < 0 Тогда // Ошибка отправки
			мзСостояниеСообщения.Статус = Перечисления.смсСостоянияСообщений.Ошибка;
			мзСостояниеСообщения.ОписаниеОшибки = смсКоммуникатор.ОписаниеОшибокВебСервиса(стСообщение.КодОшибки);
		ИначеЕсли стСообщение.КодОшибки > 0 Тогда // Успешно Отправленное(ые) сообщение(я), части сообщений
			мзСостояниеСообщения.Статус = Перечисления.смсСостоянияСообщений.ВОчереди;
			мзСостояниеСообщения.sms_id = стСообщение.sms_id;
		КонецЕсли;
		мзСостояниеСообщения.Записать();
	КонецЕсли;
	
	Возврат 1;
КонецФункции

 Функция ПолучитьКоличествоСообщений(Рассылка)
	ПараметрыЗаданы = ЗначениеЗаполнено(Рассылка.НачалоРассылки) И ЗначениеЗаполнено(Рассылка.ОкончаниеРассылки)
		И ЗначениеЗаполнено(Рассылка.НачалоПериодаРассылки) И ЗначениеЗаполнено(Рассылка.ОкончаниеПериодаРассылки);
		
	Если ПараметрыЗаданы Тогда
		Если Рассылка.НачалоРассылки > Рассылка.ОкончаниеРассылки Тогда
			смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ Рассылка.ДокументСсылка.Номер 
			+ ". Дата начала отправки больше, чем актуальновть!'"), СтатусСообщения.Важное,
			"Отправка СМС сообщений", УровеньЖурналаРегистрации.Ошибка);
			Возврат 0;
		КонецЕсли;
		
	Иначе
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ Рассылка.ДокументСсылка.Номер 
		+ ". Не заданы параметры рассылки!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Ошибка);
		Возврат 0;
	КонецЕсли;
	
	РезультатЗапроса = ПолучитьСообщенияДокумента(Рассылка.ДокументСсылка);
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	ВсегоНеотправленных = Выборка.Количество();	
	
	ДлительностьВсего = ПолучитьДлительностьРассылки(Рассылка);
	Если ДлительностьВсего = 0 Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ Рассылка.ДокументСсылка.Номер 
		+ ". При заданых параметрах отправка рассылки регламентным заданием невозможна!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Ошибка);
		Возврат 0;
	КонецЕсли;
	
	Рассылка.Вставить("ОкончаниеРассылки", ТекущаяДата());
	ДлительностьТекущая = ПолучитьДлительностьРассылки(Рассылка);
	Если ДлительностьТекущая = 0 Тогда
		смсРаботаССообщениями.ВывестиСообщение(НСтр("ru = 'Документ №"+ Рассылка.ДокументСсылка.Номер 
		+ ". Отправка рассылки на текущий момент невозможна!'"), СтатусСообщения.Важное,
		"Отправка СМС сообщений", УровеньЖурналаРегистрации.Ошибка);
		Возврат 0;
	КонецЕсли;
	
	КоличествоТекущее = Цел(Рассылка.ВсегоСообщений*ДлительностьТекущая/ДлительностьВсего) + ВсегоНеотправленных - Рассылка.ВсегоСообщений;
	Если КоличествоТекущее > 0 Тогда
		Возврат КоличествоТекущее;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ПолучитьДлительностьРассылки(Рассылка)
	Если Рассылка.ОкончаниеРассылки <= Рассылка.НачалоРассылки Тогда
		Возврат 0;
	КонецЕсли;
	
	СутокОтправки = Цел((Рассылка.ОкончаниеРассылки - Рассылка.НачалоРассылки) / 86400);
	ВремяНачала = Дата(1, 1, 1, Час(Рассылка.НачалоРассылки), Минута(Рассылка.НачалоРассылки), Секунда(Рассылка.НачалоРассылки));
	ВремяОкончания = Дата(1, 1, 1, Час(Рассылка.ОкончаниеРассылки), Минута(Рассылка.ОкончаниеРассылки), Секунда(Рассылка.ОкончаниеРассылки));

	Если ВремяОкончания > ВремяНачала Тогда
		Если ВремяНачала > Рассылка.ОкончаниеПериодаРассылки Тогда
			Длительность = 0;
			
		ИначеЕсли ВремяНачала < Рассылка.НачалоПериодаРассылки И ВремяОкончания > Рассылка.ОкончаниеПериодаРассылки Тогда
			Длительность = Рассылка.ПериодРассылки;
			
		ИначеЕсли ВремяНачала < Рассылка.НачалоПериодаРассылки И ВремяОкончания < Рассылка.ОкончаниеПериодаРассылки Тогда
			Если СутокОтправки = 0 Тогда
				Длительность = ВремяОкончания - Рассылка.НачалоПериодаРассылки;
			Иначе
				Длительность = Рассылка.ПериодРассылки;
			КонецЕсли;
				
		ИначеЕсли ВремяНачала > Рассылка.НачалоПериодаРассылки И ВремяОкончания > Рассылка.ОкончаниеПериодаРассылки Тогда
			Длительность = Рассылка.ОкончаниеПериодаРассылки - ВремяНачала;
			
		ИначеЕсли ВремяНачала > Рассылка.НачалоПериодаРассылки И ВремяОкончания < Рассылка.ОкончаниеПериодаРассылки Тогда
			Если СутокОтправки = 0 Тогда
				Длительность = ВремяОкончания - ВремяНачала;
			Иначе
				Длительность = Рассылка.ОкончаниеПериодаРассылки - ВремяНачала;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		Если ВремяНачала > Рассылка.ОкончаниеПериодаРассылки Тогда
			Длительность = 0;
			
		ИначеЕсли ВремяНачала < Рассылка.НачалоПериодаРассылки Тогда
			Длительность = Рассылка.ПериодРассылки;
			
		Иначе
			Длительность = Рассылка.ОкончаниеПериодаРассылки - ВремяНачала;
		КонецЕсли;
		
		Если ВремяОкончания > Рассылка.НачалоПериодаРассылки И ВремяОкончания < Рассылка.ОкончаниеПериодаРассылки Тогда
			Длительность = Длительность + (ВремяОкончания - Рассылка.НачалоПериодаРассылки);
			
		ИначеЕсли ВремяОкончания >= Рассылка.ОкончаниеПериодаРассылки Тогда
			Длительность = Длительность + Рассылка.ПериодРассылки;
		КонецЕсли;		
	КонецЕсли;
		
	Если СутокОтправки > 0 Тогда
		Если ВремяОкончания > ВремяНачала Тогда
			Если ВремяОкончания < Рассылка.НачалоПериодаРассылки Тогда
				Длительность = Длительность + (СутокОтправки - 1)*Рассылка.ПериодРассылки;
				
			ИначеЕсли ВремяОкончания < Рассылка.ОкончаниеПериодаРассылки Тогда
				Длительность = Длительность + (ВремяОкончания - Рассылка.НачалоПериодаРассылки) + (СутокОтправки - 1)*Рассылка.ПериодРассылки;
				
			ИначеЕсли ВремяОкончания > Рассылка.ОкончаниеПериодаРассылки Тогда
				Длительность = Длительность + СутокОтправки*Рассылка.ПериодРассылки;
			КонецЕсли;	
			
		Иначе
			Длительность = Длительность + СутокОтправки*Рассылка.ПериодРассылки;
		КонецЕсли;				
	КонецЕсли;
	
	Если Длительность > 0 Тогда
		Возврат Длительность;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ЭкранированиеСпецсимволов(СтрокаСообщение)
	СтрокаРезультат = СтрЗаменить(СтрокаСообщение, "%", "%25"); // с этого начинать!
	
	СтрокаРезультат = СтрЗаменить(СтрокаРезультат, "+", "%2b");
	Возврат СтрокаРезультат;
КонецФункции
