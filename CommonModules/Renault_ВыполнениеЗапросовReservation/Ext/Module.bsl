
Функция ВыполнитьФункцию(ТекстЗапроса) Экспорт
	
	Подключение = ПодключитьсяКБудде();
	Результат = Подключение.Execute(ТекстЗапроса);
	РезультатТаблица = Новый ТаблицаЗначений;
	Для Каждого Поле Из Результат.Fields Цикл
		Если РезультатТаблица.Колонки.Найти(Поле.Name) = Неопределено Тогда
			РезультатТаблица.Колонки.Добавить(Поле.Name);
		КонецЕсли;
	КонецЦикла;
	Пока Не Результат.eof Цикл
		НоваяСтрока = РезультатТаблица.Добавить();
		Для Каждого Поле Из Результат.Fields Цикл
			НоваяСтрока[Поле.Name] = Поле.Value;
		КонецЦикла;
		Результат.MoveNext();
	КонецЦикла;
	ОтключитьсяОтБудды(Подключение);
	Возврат РезультатТаблица;
	
КонецФункции

Процедура ВыполнитьПроцедуру(ТекстЗапроса) Экспорт
	
	Попытка
		Подключение = ПодключитьсяКБудде();
		Подключение.Execute(ТекстЗапроса);
		ОтключитьсяОтБудды(Подключение);
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			"Выполнение запроса Reservation",
			УровеньЖурналаРегистрации.Ошибка,,,
		 	ПодробноеПредставлениеОшибки(Инфо) + Символы.ПС + ТекстЗапроса);
	КонецПопытки
	
КонецПроцедуры

Функция ПодключитьсяКБудде()
	
	СтрокаПодключения = 
				"Driver={SQL Server Native Client 10.0};
				|Server=BUDDHA;
				|Database=Reservation;
				|Uid=1cAgavaTransfer;
				|Pwd=1cpassword;";
	Подключение = Новый COMОбъект("ADODB.Connection");
	Подключение.CommandTimeout = 6000;
	Подключение.Open(СтрокаПодключения);	
	
	Возврат Подключение;
	
КонецФункции

Процедура ОтключитьсяОтБудды(Подключение)
	
	Подключение.Close();
	
КонецПроцедуры
