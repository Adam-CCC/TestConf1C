
Функция ПолучитьВебСервис()
	
	Перем ВебСервис;
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	Адрес = Настройки.АдресWsGate+"ws/RenaultReclamations.1cws?wsdl";
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	ОпределениеСервиса = Новый WSОпределения(Адрес, ЛогинWS, ПарольWS);
	
	Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
		Выполнить("ВебСервис=Новый WSПрокси(ОпределениеСервиса,""http://renault.ru/WSGate/RenaultReclamations"",""Renault_Reclamations"",""Renault_ReclamationsSoap12"",60)");
	Иначе
		Выполнить("ВебСервис=Новый WSПрокси(ОпределениеСервиса,""http://renault.ru/WSGate/RenaultReclamations"",""Renault_Reclamations"",""Renault_ReclamationsSoap12"",,60)");
	КонецЕсли;	
	
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Возврат ВебСервис;
	
КонецФункции

// Преобразует ссылочные значения для формирования строки JSON
//
// Параметры:
//  Свойство				 - Произвольный - Выгружаемое свойство документа
//  Значение				 - Произвольный - Значение выгружаемого свойства
//  ДополнительныеПараметры	 - Структура 	- Структура дополнительных параметров
//  Отказ					 - Булево 		- Отказ от записи свойств
// 
// Возвращаемое значение:
//  Структура - Структура свойств выгружаемого значения в пределах допустимых типов для формирования строки JSON
//
Функция ПреобразованиеJSON(Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт
	
	СтруктураСвойств = Новый Структура;
	
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.Номенклатура") Тогда
	
		СтруктураСвойств.Вставить("Артикул", 					Значение.Артикул);

	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда	
		
		СтруктураСвойств.Вставить("ЕдиницаПоКлассификаторуКод", Значение.ЕдиницаПоКлассификатору.Код);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("ПеречислениеСсылка.Renault_РекламацииВиды") Тогда	
		
		ВидРекламацииСтрокой = "";
		
		Если Значение = Перечисления.Renault_РекламацииВиды.Брак Тогда
			ВидРекламацииСтрокой = "Брак";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииВиды.Излишек Тогда	
			ВидРекламацииСтрокой = "Излишек";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииВиды.НевернаяОтгрузка Тогда	
			ВидРекламацииСтрокой = "НевернаяОтгрузка";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииВиды.Недостача Тогда	
			ВидРекламацииСтрокой = "Недостача";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииВиды.ОшибкаДокументации Тогда	
			ВидРекламацииСтрокой = "ОшибкаДокументации";
		КонецЕсли;
		
		СтруктураСвойств.Вставить("ВидРекламацииСтрокой", ВидРекламацииСтрокой);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.CRM_ДилерскиеЦентры") Тогда	
		
		СтруктураСвойств.Вставить("ДилерскийЦентрBIR", Значение.BIR);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Renault_КлассификацияОтказов") Тогда
		
		СтруктураСвойств.Вставить("КлассификацияОтказовКод", Значение.Код);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("ПеречислениеСсылка.Renault_РекламацииСтатусы") Тогда 	
		
		ТекущийСтатусСтрокой = "";
		
		Если Значение = Перечисления.Renault_РекламацииСтатусы.Draft Тогда
			ТекущийСтатусСтрокой = "Draft";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииСтатусы.Sent Тогда	
			ТекущийСтатусСтрокой = "Sent";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииСтатусы.Registered Тогда	
			ТекущийСтатусСтрокой = "Registered";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииСтатусы.Returned Тогда	
			ТекущийСтатусСтрокой = "Returned";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииСтатусы.Refreshed Тогда	
			ТекущийСтатусСтрокой = "Refreshed";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииСтатусы.Updated Тогда	
			ТекущийСтатусСтрокой = "Updated";
		ИначеЕсли Значение = Перечисления.Renault_РекламацииСтатусы.Closed Тогда	
			ТекущийСтатусСтрокой = "Closed";
		КонецЕсли;
		
		СтруктураСвойств.Вставить("ТекущийСтатусСтрокой", ТекущийСтатусСтрокой);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("ПеречислениеСсылка.SAPPR_ВидЗаказаПоставщику") Тогда
		
		ВидЗаказаПоставщикуСтрокой = "";
		
		Если Значение = Перечисления.SAPPR_ВидЗаказаПоставщику.ZMP1 Тогда
			ВидЗаказаПоставщикуСтрокой = "ZMP1";
		ИначеЕсли Значение = Перечисления.SAPPR_ВидЗаказаПоставщику.ZMP2 Тогда
			ВидЗаказаПоставщикуСтрокой = "ZMP2";
		ИначеЕсли Значение = Перечисления.SAPPR_ВидЗаказаПоставщику.ZMP4 Тогда
			ВидЗаказаПоставщикуСтрокой = "ZMP4";
		ИначеЕсли Значение = Перечисления.SAPPR_ВидЗаказаПоставщику.ZMP8 Тогда
			ВидЗаказаПоставщикуСтрокой = "ZMP8";
		ИначеЕсли Значение = Перечисления.SAPPR_ВидЗаказаПоставщику.ZMP9 Тогда
			ВидЗаказаПоставщикуСтрокой = "ZMP9";
		КонецЕсли;
		
		СтруктураСвойств.Вставить("ВидЗаказаПоставщикуСтрокой", ВидЗаказаПоставщикуСтрокой);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ТипыЦен") Тогда	
		
		СтруктураСвойств.Вставить("ТипЦенНаименование", Значение.Наименование);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Renault_ПредложенияПоРекламациям") Тогда
		
		ПредложениеИнициатораСтрокой = "";
		
		Если Значение = Справочники.Renault_ПредложенияПоРекламациям.Возврат Тогда
			ПредложениеИнициатораСтрокой = "Возврат";
		ИначеЕсли Значение = Справочники.Renault_ПредложенияПоРекламациям.Возмещение Тогда
			ПредложениеИнициатораСтрокой = "Возмещение";
		ИначеЕсли Значение = Справочники.Renault_ПредложенияПоРекламациям.Восстановление Тогда
			ПредложениеИнициатораСтрокой = "Восстановление";
		ИначеЕсли Значение = Справочники.Renault_ПредложенияПоРекламациям.Довоз Тогда
			ПредложениеИнициатораСтрокой = "Довоз";
		ИначеЕсли Значение = Справочники.Renault_ПредложенияПоРекламациям.Замена Тогда
			ПредложениеИнициатораСтрокой = "Замена";
		ИначеЕсли Значение = Справочники.Renault_ПредложенияПоРекламациям.ПересортНаСкладеДилера Тогда
			ПредложениеИнициатораСтрокой = "ПересортНаСкладеДилера";
		ИначеЕсли Значение = Справочники.Renault_ПредложенияПоРекламациям.Покупка Тогда
			ПредложениеИнициатораСтрокой = "Покупка";
		КонецЕсли;
		
		СтруктураСвойств.Вставить("ПредложениеИнициатораСтрокой", ПредложениеИнициатораСтрокой);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("ДокументСсылка.Renault_Рекламация") Тогда	
		
		СтруктураСвойств.Вставить("ДатаТН",  Значение.ДатаТН);
		СтруктураСвойств.Вставить("НомерТН", Значение.НомерТН);
		
	Иначе
		
		СтруктураСвойств.Вставить("НетСвойства", "Не прописано");
		
	КонецЕсли;
	
	Возврат СтруктураСвойств;
	
КонецФункции // ПреобразованиеJSON()


