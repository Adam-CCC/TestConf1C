// ОБНОВЛЕНИЕ v 2.0

Процедура ОбновитьСтатусыРекламаций(Параметр=Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_Рекламация.ДилерскийЦентр КАК ДилерскийЦентр,
	               |	Renault_Рекламация.Номер,
	               |	Renault_Рекламация.ЦентральныйНомер
	               |ИЗ
	               |	Документ.Renault_Рекламация КАК Renault_Рекламация
	               |ГДЕ
	               |	НЕ Renault_Рекламация.ТекущийСтатус В (ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииСтатусы.Closed), ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииСтатусы.Returned), ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииСтатусы.Draft))
	               |ИТОГИ ПО
	               |	ДилерскийЦентр";
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДилеров = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДилеров.Следующий() Цикл
		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("ДилерскийЦентр", ВыборкаДилеров.ДилерскийЦентр.BIR);
		МассивРекламаций = Новый Массив;

		ВыборкаРекламаций = ВыборкаДилеров.Выбрать();
		Пока ВыборкаРекламаций.Следующий() Цикл
			МассивРекламаций.Добавить(ВыборкаРекламаций.ЦентральныйНомер);
		КонецЦикла;

		СтруктураЗапроса.Вставить("Рекламации", МассивРекламаций);
		

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		Настройки = Справочники.Renault_ПараметрыПодключенияКСервисам.Orders;
		HTTPСоединение = Новый HTTPСоединение(Настройки.АдресСервера,, Настройки.Логин, Настройки.Пароль);
		HTTPЗапрос = Новый HTTPЗапрос(Настройки.ИмяСервиса + "v1/status");
		
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON);
		
		HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);

		СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON,,"Дата");

		Для Каждого Рек Из СтруктураОтвета.Рекламации Цикл

			Рекламация = Документы.Renault_Рекламация.НайтиПоРеквизиту("ЦентральныйНомер", Рек.Номер);
			Статус = Перечисления.Renault_РекламацииСтатусы[Рек.Статус];

			Если Рекламация.ТекущийСтатус <> Статус Тогда

				РекламацияОбъект = Рекламация.ПолучитьОбъект();	
				РекламацияОбъект.ТекущийСтатус = Статус;
				РекламацияОбъект.ОписаниеРешения      = Рек.ОписаниеРешения;
				РекламацияОбъект.СуммаВозмещения      = Рек.СуммаВозмещения;
				РекламацияОбъект.ДатаПринятияРешения  = Рек.ДатаПринятияРешения;
				РекламацияОбъект.КоличествоНормоЧасов = Рек.КоличествоНормоЧасов;
				РекламацияОбъект.Решение			  = НайтиРешениеРекламации(СокрЛП(Рек.Решение)); // DMSREN-297 23.09.2019

				РекламацияОбъект.Сообщения.Очистить();
				Для Каждого Сообщение Из Рек.Сообщения Цикл
					Стр = РекламацияОбъект.Сообщения.Добавить();
					Стр.Дата         = Сообщение.Дата;
					Стр.Пользователь = Сообщение.Пользователь;
					Стр.Сообщение    = Сообщение.Сообщение;
				КонецЦикла;

				РекламацияОбъект.Записать();

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// НАЧАЛО DMSREN-297 24.09.2019
Функция НайтиРешениеРекламации(РешениеСтр)
	
	РешениеСпр = Справочники.Renault_РешенияПоРекламациям.НайтиПоНаименованию(РешениеСтр);
	
	Если НЕ ЗначениеЗаполнено(РешениеСпр) Тогда
		
		лРешение = Справочники.Renault_РешенияПоРекламациям.СоздатьЭлемент();
		лРешение.Наименование = РешениеСтр;
		лРешение.ПолноеНаименование = РешениеСтр;
		
		Попытка
			лРешение.Записать();
			РешениеСпр = лРешение.Ссылка;
		Исключение
			Информация = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Запись решения по рекламациям", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Renault_РешенияПоРекламациям, ПодробноеПредставлениеОшибки(Информация));
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат РешениеСпр;
	
КонецФункции
// КОНЕЦ DMSREN-297 24.09.2019
