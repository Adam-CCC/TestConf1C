// Выгружает данные массива рекламаций
//
// Параметры:
//  МассивРекламаций - Массив - Массив ссылок на документы "Renault_Рекламация"
//  АдресХранилища	 - Строка - Адрес временного хранилища для хранения результата выгрузки
//
Функция ВыгрузитьСинхронно20(МассивРекламаций) Экспорт
	
	СтрокаJSON = СформироватьJSON(МассивРекламаций);
	
	Настройки = Справочники.Renault_ПараметрыПодключенияКСервисам.Orders;
	HTTPСоединение = Новый HTTPСоединение(Настройки.АдресСервера,, Настройки.Логин, Настройки.Пароль);
	HTTPЗапрос = Новый HTTPЗапрос(Настройки.ИмяСервиса + "v1/upload");

	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON);
	
	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
	
	СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
	
	РезультатВыполнения = Новый Структура;
	
	Если СтруктураОтвета.ReturnCode = "H000" Тогда
		РезультатВыполнения.Вставить("ЗавершенУспешно", Истина);
		РезультатВыполнения.Вставить("Номер", СтруктураОтвета.Number);
	Иначе                                                        
		РезультатВыполнения.Вставить("ЗавершенУспешно", Ложь);
		ОписаниеОшибок = СтруктураОтвета.ReturnCode + ": ";
		Если СтруктураОтвета.ReturnCode = "H002" Тогда
			ОписаниеОшибок = ОписаниеОшибок + "Неверный формат JSON";
		Иначе
			ОписаниеОшибок = ОписаниеОшибок + СтруктураОтвета.Description;
		КонецЕсли;
		РезультатВыполнения.Вставить("ОписаниеОшибок", ОписаниеОшибок);
	КонецЕсли;

	
	Возврат РезультатВыполнения;
	
КонецФункции // Выгрузить20()

// Формирует строку JSON для выгрузки рекламаций
//
// Параметры:
//  МассивРекламаций - Массив - Массив ссылок на документы "Renault_Рекламация"
// 
// Возвращаемое значение:
//  Строка - Сформированная строка JSON
//
Функция СформироватьJSON(МассивРекламаций)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рекламация.Ссылка КАК Ссылка,
	|	Рекламация.Номер КАК НомерДокДилера,
	|	Рекламация.Дата КАК ДатаДокДилера,
	|	Рекламация.Автор.Наименование КАК АвторДилера,
	|	Рекламация.АктОПоврежденииСТК КАК АктОПоврежденииСТК,
	|	Рекламация.ВидРекламации КАК ВидРекламации,
	|	Рекламация.ДатаТН КАК ДатаТН,
	|	Рекламация.ДатаПолученияГруза КАК ДатаПолученияГруза,
	|	Рекламация.ДатаПринятияРешения КАК ДатаПринятияРешения,
	|	Рекламация.КлассификацияОтказов КАК КлассификацияОтказов,
	|	Рекламация.Количество КАК Количество,
	|	Рекламация.КоличествоМестЗафактурованно КАК КоличествоМестЗафактурованно,
	|	Рекламация.КоличествоМестПовреждено КАК КоличествоМестПовреждено,
	|	Рекламация.КоличествоМестПолучено КАК КоличествоМестПолучено,
	|	Рекламация.КоличествоПлан КАК КоличествоПлан,
	|	Рекламация.КомментарийДилера КАК КомментарийДилера,
	|	Рекламация.Номенклатура КАК Номенклатура,
	|	Рекламация.НоменклатураПлан КАК НоменклатураПлан,
	|	Рекламация.ДилерскийЦентр.BIR КАК НомерДилера,
	|	Рекламация.НомерТН КАК НомерТН,
	|	Рекламация.НомерКоробки КАК НомерКоробки,
	|	Рекламация.НомерМеста КАК НомерМеста,
	|	Рекламация.ДатаТрН КАК ДатаТрН,
	|	Рекламация.НомерТрН КАК НомерТрН,
	|	Рекламация.СчетФактура КАК СчетФактура,
	|	Рекламация.ПоврежденноеКоличество КАК РекламируемоеКоличество,
	|	Рекламация.ПредложениеИнициатора КАК ПредложениеИнициатора,
	|	Рекламация.Сумма КАК Сумма,
	|	Рекламация.СуммаПлан КАК СуммаПлан,
	|	Рекламация.ТипЗаказа КАК ТипЗаказа,
	|	Рекламация.ФИОВодителя КАК ФИОВодителя,
	|	Рекламация.Цена КАК Цена,
	|	Рекламация.ЦенаПлан КАК ЦенаПлан,
	|	Рекламация.ЭлектронныйАдрес КАК ЭлектронныйАдрес,
	|	Рекламация.ЦентральныйНомер КАК ЦентральныйНомер,
	|	Рекламация.VIN КАК VIN,
	|	Рекламация.РегистрационныйНомер КАК РегистрационныйНомер
	|ИЗ
	|	Документ.Renault_Рекламация КАК Рекламация
	|ГДЕ
	|	Рекламация.Ссылка В(&МассивРекламаций)
	|	И НЕ Рекламация.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("МассивРекламаций", МассивРекламаций);
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	СтруктураДанных = Новый Структура;
	Для Каждого ТекущаяКолонка Из ТаблицаДанных.Колонки Цикл
		СтруктураДанных.Вставить(ТекущаяКолонка.Имя);
	КонецЦикла;
	
	СтруктураДанных.Вставить("Фотографии");
		
	ЗаписьJSON = Новый ЗаписьJSON;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураДанных, СтрокаДанных);
		ДобавитьФотографииJSON(СтруктураДанных, СтрокаДанных.Ссылка);
		
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураДанных,, "ПреобразованиеJSON", Renault_РекламацииСервер);
		
	КонецЦикла;
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции // СформироватьJSON()	

// Добавляет информацию о прикрепленных фотографиях в структуру данных для формата JSON
//
// Параметры:
//  СтруктураДанных	 - Структура 							- Структура данных для формата JSON
//  Рекламация		 - ДокументСсылка.Renault_Рекламация	- Выгружаемый документ
//
Процедура ДобавитьФотографииJSON(СтруктураДанных, Рекламация)
	
	МассивФотографий = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КартинкиИФайлы.Идентификатор,
	|	КартинкиИФайлы.ИмяФайла,
	|	КартинкиИФайлы.ДатаСохранения,
	|	КартинкиИФайлы.Комментарий,
	|	КартинкиИФайлы.Данные КАК ХранилищеДанных
	|ИЗ
	|	РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы
	|ГДЕ
	|	КартинкиИФайлы.Объект = &Рекламация";
	Запрос.УстановитьПараметр("Рекламация", Рекламация);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтруктураФотографии = Новый Структура("Идентификатор, ИмяФайла, ДатаСохранения, Комментарий, Base64Фотография");
			
			ЗаполнитьЗначенияСвойств(СтруктураФотографии, Выборка);
			ДвоичныеДанныеФотографии = Выборка.ХранилищеДанных.Получить();
			СтруктураФотографии.Вставить("Base64Фотография", Base64Строка(ДвоичныеДанныеФотографии));
			МассивФотографий.Добавить(СтруктураФотографии);
			
		КонецЦикла;
		
	КонецЕсли;
		
	СтруктураДанных.Фотографии = МассивФотографий;
	
КонецПроцедуры // ДобавитьФотографииJSON()



Функция СформироватьJSONКомментарий(Номер, Комментарий)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(ЗаписьJSON, Новый Структура("Номер,Сообщение", Номер, Комментарий));

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Добавляет комментарий к рекламации
//
Функция ВыгрузитьКомментарий(Номер, Комментарий) Экспорт

	ТекстЗапроса = СформироватьJSONКомментарий(Номер, Комментарий);

	Настройки = Справочники.Renault_ПараметрыПодключенияКСервисам.Orders;
	HTTPСоединение = Новый HTTPСоединение(Настройки.АдресСервера,, Настройки.Логин, Настройки.Пароль);
	HTTPЗапрос = Новый HTTPЗапрос(Настройки.ИмяСервиса + "v1/comment");

	HTTPЗапрос.УстановитьТелоИзСтроки(ТекстЗапроса);

	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();

	ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
	СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);

	РезультатВыполнения = Новый Структура;

	Если СтруктураОтвета.ReturnCode = "H000" Тогда
		РезультатВыполнения.Вставить("ЗавершенУспешно", Истина);
	Иначе                                                  
		РезультатВыполнения.Вставить("ЗавершенУспешно", Ложь);
		РезультатВыполнения.Вставить("ОписаниеОшибок", СтруктураОтвета.Description);
	КонецЕсли;

	Возврат РезультатВыполнения;

КонецФункции


