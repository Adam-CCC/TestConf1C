// Процедуры и функции Формирования, отправки данных в CRM

// Подписка на событие при записи по передаче данных по документам в CRM 
//                           
// Параметры:   
//  Источник - ДокументОбъект - Объект документ.
//	Отказ    - Флаг отказа
//
Процедура Инфотек_ПриЗаписиДокументаПриЗаписи(Источник, Отказ) Экспорт
	Возврат;
	//////////////////////////////////////////////////////////////////
	Попытка
		//KamikadZe begin add 13.02.2024 22:39:36
		Если обПраво("ВыгрузкаВ_СРМ_Автодилер") Тогда
			//KamikadZe end add
			НастройкаПодключения = ПолучитьНастройкуПодключенияПоДокументу(Источник); 
			
			Если НастройкаПодключения <> Неопределено Тогда
				Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказНаряд") И НастройкаПодключения.ВыгрузкаЗаказНарядов = Истина Тогда		
					
					ОписаниеЗаказНаряда = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьОписаниеЗаказНарядаCRM(Источник.Ссылка,НастройкаПодключения);
					Если ОписаниеЗаказНаряда <> Неопределено Тогда
						Успешно = СоздатьОбновитьЗаказНарядВCRM(Источник.Ссылка,ОписаниеЗаказНаряда,НастройкаПодключения);			
						Если Не Успешно Тогда
							Сообщить("Произошла ошибка! Не удалось передать документ в CRM-систему!!!");
						КонецЕсли;
						Если Успешно Тогда
							Для Каждого СтрокаРабот ИЗ Источник.Работы Цикл
								ЗначениеТО = обПолучитьЗначениеСвойства(СтрокаРабот.Работа,НастройкаПодключения.СвойствоЗаказНарядаТО); 
								Если ЗначениеЗаполнено(ЗначениеТО) Тогда
									ИдентификаторВидаРемонтаТО = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ЗначениеТО,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ВидРемонтаТО);
									Если ЗначениеЗаполнено(ИдентификаторВидаРемонтаТО) Тогда
										Прервать;
									КонецЕсли;  
								КонецЕсли;					
							КонецЦикла; 
							Если Не ЗначениеЗаполнено(ИдентификаторВидаРемонтаТО) Тогда      
								ЗначениеТО = обПолучитьЗначениеСвойства(Источник.Ссылка,НастройкаПодключения.СвойствоЗаказНарядаТО); 
								Если ЗначениеЗаполнено(ЗначениеТО) Тогда
									ИдентификаторВидаРемонтаТО = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ЗначениеТО,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ВидРемонтаТО);
								КонецЕсли;
							КонецЕсли;
							Если ЗначениеЗаполнено(ИдентификаторВидаРемонтаТО) Тогда
								Успешно = ОбработатьДанныеПоТО(Источник.Ссылка,ИдентификаторВидаРемонтаТО,НастройкаПодключения);	
								Если Не Успешно Тогда
									Сообщить("Произошла ошибка! Не удалось передать данные по ТО в CRM-систему!!!");
								КонецЕсли;
							КонецЕсли;					
						КонецЕсли;
					КонецЕсли; 
					Если Инфотек_ОбщиеПроцедуры.ЭтоДополнительноеОборудование(Источник.Ссылка,НастройкаПодключения) Тогда
						// Теперь поищем авто в регистре ранее переданных данных
						ID_Автомобиля = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Источник.Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада);
						Если Не ЗначениеЗаполнено(ID_Автомобиля) Тогда
							// Не нашли. Теперь поищем авто на складе в CRM по его VIN номеру    
							НастройкаДляПоискаАвто = Справочники.Инфотек_НастройкиПодключения.Выбрать();
							Пока НастройкаДляПоискаАвто.Следующий() Цикл 
								Если НастройкаДляПоискаАвто.Ссылка.ПометкаУдаления = Ложь Тогда 
									ID_Автомобиля = ПолучитьИдентфикаторАвтомобиляНаСкладеПоVIN(Источник.Автомобиль.VIN,НастройкаДляПоискаАвто.Ссылка);    
									Если ЗначениеЗаполнено(ID_Автомобиля) Тогда
										Прервать;
									КонецЕсли;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						Если ЗначениеЗаполнено(ID_Автомобиля) И Источник.СуммаДокумента > 0 Тогда
							// Обновим дополнительное оборудование
							ОписаниеДополнительногоОборудованияАвтомобиля = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьОписаниеДополнительногоОборудованияАвтомобиля(Источник.Ссылка,ID_Автомобиля,НастройкаПодключения);
							Успешно = СоздатьОбновитьДополнительноеОборудованиеАвтомобиляВCRM(ОписаниеДополнительногоОборудованияАвтомобиля,НастройкаПодключения);			
							Если Не Успешно Тогда
								Сообщить("Произошла ошибка! Не удалось передать дополнительное оборудование автомобиля в CRM-систему!!!");
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;					
				ИначеЕсли  ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаРемонт") Тогда
					Если ЗначениеЗаполнено(Источник.Инфотек_ИдентификаторОбращения) Тогда  
						Если Источник.Состояние = Перечисления.СостоянияЗаявкиНаРемонт.Отклонено Тогда  
							Успешно = ЗавершитьОбращениеОтменойИзДокумента(Источник.Ссылка,НастройкаПодключения);
						Иначе
							Успешно = ЗавершитьОбращение(Источник.Ссылка,НастройкаПодключения); 
						КонецЕсли;
					КонецЕсли; 	
					
				ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияАвтомобилей") Тогда	 
					Если Источник.ПометкаУдаления = Истина Тогда 
						МассивРабочихЛистов = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьРабочиеЛистыПоДокументу(Источник.Ссылка);
						Для Индекс = 0 По МассивРабочихЛистов.Количество() - 1 Цикл
							Если ЗначениеЗаполнено(МассивРабочихЛистов[Индекс].Инфотек_Идентификатор_CRM) И МассивРабочихЛистов[Индекс].Инфотек_ОтключитьОбменCRM = Ложь Тогда
								Для Каждого СтрокаАвто Из Источник.Автомобили Цикл		
									Результат = ПодтвердитьВыдачу(Источник.Ссылка,СтрокаАвто.Автомобиль,НастройкаПодключения,МассивРабочихЛистов[Индекс].Инфотек_Идентификатор_CRM);
									Если Результат = Ложь Тогда
										Отказ = Истина;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
						КонецЦикла;	
					КонецЕсли;
					
				ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПеремещениеАвтомобилей") Тогда	
					// Здесь все сложнее: перемещение может быть между складами, а может и между дц (т.е. разные CRM учетки)
					Для Каждого СтрокаАвто Из Источник.Автомобили Цикл
						ID_Автомобиля = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,СтрокаАвто.Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада);
						Выборка = Справочники.Инфотек_НастройкиПодключения.Выбрать();
						Пока Выборка.Следующий() Цикл  
							СтруктураАвтомобиля = ПолучитьСтруктуруАвтомобиляНаСкладеПоVIN(СтрокаАвто.Автомобиль.VIN,НастройкаПодключения);
							Если ЗначениеЗаполнено(СтруктураАвтомобиля) Тогда     
								Прервать;
							КонецЕсли;
						КонецЦикла;	
						Если Не ЗначениеЗаполнено(ID_Автомобиля) Тогда
							Если ЗначениеЗаполнено(СтруктураАвтомобиля) Тогда 
								ID_Автомобиля = СтруктураАвтомобиля.id;
							КонецЕсли;
						КонецЕсли;
						Если ЗначениеЗаполнено(ID_Автомобиля) Тогда   
							ИдентификаторАвтосалонаОтправителя = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Источник.СкладКомпании.ПодразделениеКомпании,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Автосалон); 
							ИдентификаторАвтосалонаПолучателя = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Источник.СкладПолучатель.ПодразделениеКомпании,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Автосалон); 
							Если ЗначениеЗаполнено(ИдентификаторАвтосалонаОтправителя) И ЗначениеЗаполнено(ИдентификаторАвтосалонаПолучателя) И ИдентификаторАвтосалонаОтправителя <> ИдентификаторАвтосалонаПолучателя Тогда	
								Успешно = ОбновитьАвтосалонАвтомобиляВCRM(ИдентификаторАвтосалонаПолучателя,СтрокаАвто.Автомобиль,ID_Автомобиля,НастройкаПодключения);
								Если Не Успешно Тогда
									Сообщить("Произошла ошибка! Не удалось передать изменение автосалона автомобиля в CRM-систему!!!");
								КонецЕсли;                                                              
							КонецЕсли;	
							ИдентификаторСклада = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Источник.СкладПолучатель,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.МестоХранения);		
							Если ЗначениеЗаполнено(ИдентификаторСклада) Тогда
								СтруктураСкладаПеремещения = ПолучитьМестоХраненияПоИдентификатору(НастройкаПодключения,ИдентификаторСклада);
								ОписаниеМестаХранения = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьОписаниеМестаХраненияСклада(СтруктураСкладаПеремещения,Источник.Ссылка,ID_Автомобиля,НастройкаПодключения);
								Успешно = СоздатьОбновитьМестоХраненияНаСкладеВCRM(СтрокаАвто.Автомобиль,ОписаниеМестаХранения,НастройкаПодключения);			
								Если Не Успешно Тогда
									Сообщить("Произошла ошибка! Не удалось передать место хранения автомобиля в CRM-систему!!!");
								КонецЕсли;
								ПередаватьСтатус = Ложь;
								Если ЗначениеЗаполнено(СтруктураАвтомобиля) Тогда
									Если Не ЗначениеЗаполнено(СтруктураАвтомобиля.internalStatusId) ИЛИ (СтруктураАвтомобиля.internalStatusId = 1 ИЛИ СтруктураАвтомобиля.internalStatusId = 6 ИЛИ СтруктураАвтомобиля.internalStatusId = 8) Тогда 
										ПередаватьСтатус = Истина;
									КонецЕсли;
								Иначе
									ПередаватьСтатус = Истина;
								КонецЕсли;
								Если ПередаватьСтатус = Истина Тогда
									ОписаниеСтатусаАвтомобиля = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьОписаниеСтатусаАвтомобиляНаСкладе(Источник.Ссылка,ID_Автомобиля,НастройкаПодключения);
									Успешно = СоздатьОбновитьСтатусАвтомобиляНаСкладеВCRM(СтрокаАвто.Автомобиль,ОписаниеСтатусаАвтомобиля,НастройкаПодключения);			
									Если Не Успешно Тогда
										Сообщить("Произошла ошибка! Не удалось передать статус автомобиля в CRM-систему!!!");
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;		
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить("Произошла ошибка! Не удалось передать документ в CRM-систему!!!");
	КонецПопытки;
	
КонецПроцедуры

Процедура Инфотек_ПриПроведенииДокументаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Попытка
