// Склад автомобилей

// Функция отправки запроса предачи данных по дополнительному оборудованию автомобиля на складе в CRM    
//                           
// Параметры:   
//  Описание             - Структура - Структура дополнительного оборудования.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция СоздатьОбновитьДополнительноеОборудованиеАвтомобиляВCRM(Описание,НастройкаПодключения)  Экспорт
	
	Идентификатор = Описание.Идентификатор;
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = ПолучитьИдентфикаторАвтомобиляНаСкладеПоVIN(Описание.Автомобиль.VIN,НастройкаПодключения);		
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,Описание.Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада,Идентификатор);
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Описание.Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада)) Тогда
		Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,Описание.Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада,Идентификатор);	
	КонецЕсли;
	
	СтруктураПередачи = СформироватьСтруктуруДополнительноеОборудованиеАвтомобиляПоОписанию(Описание,НастройкаПодключения);
	Результат = Ложь;
	
	//PUT /warehouseVehicle/updateFromRef
	
	Запрос = "/yii/api/warehouseVehicle/updateFromRef";
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураПередачи,Истина);
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Запрос = Запрос + "/" + Формат(Идентификатор,"ЧГ=0");
		Ответ = Инфотек_Запросы.PUTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
