// Процедура обработки массива обращений в 1С, проверяет на закрытые обращения в CRM   
//                           
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
Процедура ЗакрытьЛишниеОбращения(НастройкаПодключения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инфотек_ОбращенияCRM.Идентификатор КАК Идентификатор,
	|	Инфотек_ОбращенияCRM.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.Инфотек_ОбращенияCRM КАК Инфотек_ОбращенияCRM
	|ГДЕ
	|	Инфотек_ОбращенияCRM.Статус В(&Статусы)";   
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.Инфотек_СтатусыОбращений.ВзятВРаботу);
	МассивСтатусов.Добавить(Перечисления.Инфотек_СтатусыОбращений.НеВзятВРаботу);
	МассивСтатусов.Добавить(Перечисления.Инфотек_СтатусыОбращений.ВРаботе);   
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов); 
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда    
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураОбращения = ПолучитьСтруктуруОбращенияПоИдентификатору(Выборка.Идентификатор,НастройкаПодключения); 
			Если СтруктураОбращения.success Тогда
				СтруктураОбращения = СтруктураОбращения.Result;
				Если СтруктураОбращения.state = "4" Или СтруктураОбращения.state = "3" Или СтруктураОбращения.state = "-1" Тогда
					МенеджерЗаписи = РегистрыСведений.Инфотек_ОбращенияCRM.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
					МенеджерЗаписи.НастройкаПодключения = НастройкаПодключения;     
					МенеджерЗаписи.Статус = Выборка.Статус;
					МенеджерЗаписи.Прочитать();
					Если Не МенеджерЗаписи.Выбран() Тогда 
						МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.Завершён;
						МенеджерЗаписи.Записать();
					КонецЕсли;  
				КонецЕсли;  
			КонецЕсли;  
		КонецЦикла;	
	КонецЕсли;       
	
КонецПроцедуры

