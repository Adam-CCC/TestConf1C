//
// Возвращаемое значение:
//  МассивВозврата - массив объектов бренды из CRM.  
//  
Функция ПолучитьМассивБрендов(НастройкаПодключения,БрендыTradeIn) Экспорт      
	
	Если БрендыTradeIn = Ложь Тогда
		Запрос = "/yii/api/refBrand";  
	Иначе
		Запрос = "/yii/api/reference/brand";
	КонецЕсли;	
	КоличествоСтраниц = Инфотек_Запросы.ПолучитьКоличествоСтраницИзОтвета(Запрос,НастройкаПодключения);
	
	ТекущаяСтраница = 1;
	МассивВозврата = Новый Массив;
	
	Пока ТекущаяСтраница <= КоличествоСтраниц Цикл        
		Если БрендыTradeIn = Ложь Тогда
			ЗапросКВыполнению = Запрос + "?RefBrandSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");
		Иначе
			ЗапросКВыполнению = Запрос + "?BrandSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");
		КонецЕсли;		
		Ответ = Инфотек_Запросы.GETЗапрос(ЗапросКВыполнению,НастройкаПодключения);
		
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			СтруктураJson = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Для каждого Элемент ИЗ СтруктураJson.result Цикл
				МассивВозврата.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
			КонецЦикла;
		КонецЕсли;
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЦикла;
	
	Возврат МассивВозврата;
	
КонецФункции

// Функция получения массива моделей из CRM     
//                           
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//  id_бренда            - Число - ID бренда CRM.
//  МоделиTradeIn        - Булево - определяет какие сущности получаем из CRM
//
// Возвращаемое значение:
//  МассивВозврата - массив объектов модели из CRM.  
//  
Функция ПолучитьМассивМоделей(НастройкаПодключения,id_бренда = Неопределено,МоделиTradeIn) Экспорт      
	
	Если МоделиTradeIn = Ложь Тогда
		Если id_бренда = Неопределено Тогда
			Запрос = "/yii/api/refModel";
		Иначе
			id_бренда = Строка(id_бренда);
			id_бренда = СтрЗаменить(id_бренда,Символы.НПП,"");	
			Запрос = "/yii/api/refModel?brand_id=" + Инфотек_Запросы.СтрокаВФорматеURL(id_бренда) + "&is_deleted=0";
		КонецЕсли;
	Иначе
		Если id_бренда = Неопределено Тогда
			Запрос = "/yii/api/reference/model";
		Иначе
			id_бренда = Строка(id_бренда);
			id_бренда = СтрЗаменить(id_бренда,Символы.НПП,"");	
			Запрос = "/yii/api/reference/model?brand_id=" + Инфотек_Запросы.СтрокаВФорматеURL(id_бренда) + "&is_deleted=0";
		КонецЕсли;
   	КонецЕсли;
	КоличествоСтраниц = Инфотек_Запросы.ПолучитьКоличествоСтраницИзОтвета(Запрос,НастройкаПодключения);
	
	ТекущаяСтраница = 1;
	МассивВозврата = Новый Массив;
	
	Пока ТекущаяСтраница <= КоличествоСтраниц Цикл  
		Если МоделиTradeIn = Ложь Тогда
			Если id_бренда = Неопределено Тогда
				ЗапросКВыполнению = Запрос + "?RefModelSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");		
			Иначе
				ЗапросКВыполнению = Запрос + "&RefModelSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");
			КонецЕсли;
		Иначе   
			Если id_бренда = Неопределено Тогда
				ЗапросКВыполнению = Запрос + "?ModelSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");		
			Иначе
				ЗапросКВыполнению = Запрос + "&ModelSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");
			КонецЕсли;	
		КонецЕсли;
		Ответ = Инфотек_Запросы.GETЗапрос(ЗапросКВыполнению,НастройкаПодключения);
		
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			СтруктураJson = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Для каждого Элемент ИЗ СтруктураJson.result Цикл
				МассивВозврата.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
			КонецЦикла;
		КонецЕсли;
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЦикла;
	
	Возврат МассивВозврата;
	
КонецФункции

// Функция получения массива комплектаций из CRM     
//                           
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключения - Ссылка на настройку подключения для получения параметров авторизации.
//  id_модели            - Число - ID модели CRM.
//
// Возвращаемое значение:
//  МассивВозврата - массив объектов комплектации из CRM.  
//  
Функция ПолучитьМассивКомплектаций(НастройкаПодключения,id_модели = Неопределено) Экспорт   
	
	Если id_модели = Неопределено Тогда
		Запрос = "/yii/api/refEquipment";
	Иначе	
		id_модели = Строка(id_модели);
		id_модели = СтрЗаменить(id_модели,Символы.НПП,"");	
		Запрос = "/yii/api/refEquipment?model_id=" + Инфотек_Запросы.СтрокаВФорматеURL(id_модели);
	КонецЕсли;
	
	КоличествоСтраниц = Инфотек_Запросы.ПолучитьКоличествоСтраницИзОтвета(Запрос,НастройкаПодключения);
	
	ТекущаяСтраница = 1;
	МассивВозврата = Новый Массив;
	
	Пока ТекущаяСтраница <= КоличествоСтраниц Цикл
		Если id_модели = Неопределено Тогда
			ЗапросКВыполнению = Запрос + "?RefEquipmentSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");			
		Иначе
			ЗапросКВыполнению = Запрос + "&status=1&RefEquipmentSearch_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0");
		КонецЕсли;
		Ответ = Инфотек_Запросы.GETЗапрос(ЗапросКВыполнению,НастройкаПодключения);
		
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			СтруктураJson = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Для каждого Элемент ИЗ СтруктураJson.result Цикл
				МассивВозврата.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
			КонецЦикла;
		КонецЕсли;
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЦикла;
	
	Возврат МассивВозврата;
	
КонецФункции

