// Функция формирования структуры запроса предачи данных по изменению цены автомобиля на складе в CRM    
//                           
// Параметры:   
//  Описание             - Структура - Структура цены.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Структура - запроса.  
// 
Функция СформироватьСтруктуруАвтомобиляНаСкладеПоОписанию(Описание,НастройкаПодключения)
	
	СтруктураПередачи = Новый Структура;
	
	//WarehouseVehicleRef  {
	
	//vin (string): VIN
	СтруктураПередачи.Вставить("vin",Описание.VIN);
	
	//productionYear (string): Год выпуска
	СтруктураПередачи.Вставить("productionYear",Описание.ГодВыпуска);
	
	//modelYearCode (string): Код модельного года
	КодМодельногоГода = Строка(Описание.ГодВыпуска);
	КодМодельногоГода = СтрЗаменить(Описание.ГодВыпуска,Символы.НПП,"");	
	СтруктураПередачи.Вставить("modelYearCode",КодМодельногоГода);
	
	//brandId (integer): ID бренда
	СтруктураПередачи.Вставить("brandId",Описание.ИдентификаторБренда);
	
	//modelId (integer): ID модели
	СтруктураПередачи.Вставить("modelId",Описание.ИдентификаторМодели);
	
	//equipmentId (integer): ID комплектации
	СтруктураПередачи.Вставить("equipmentId",Описание.ИдентификаторКомплектации);
	
	//modificationId (integer): ID модификайии
	СтруктураПередачи.Вставить("modificationId",Описание.ИдентификаторМодификации);
	
	//generationId (integer): ID поколения
	СтруктураПередачи.Вставить("generationId",Описание.ИдентификаторПоколения);
	
	//serieId (integer): ID серии
	СтруктураПередачи.Вставить("serieId",Описание.ИдентификаторСерии);
	
	//colorCode (string): Код цвета
	СтруктураПередачи.Вставить("colorCode",Описание.КодЦвета);
	
	//trimCode (string): Код отделки
	СтруктураПередачи.Вставить("trimCode",Описание.КодОтделки);
	
	//code (string): Код автомобиля
	СтруктураПередачи.Вставить("code",Описание.КодАвтомобиля);
	
	//autosalonId (string): ID автосалона
	Если Описание.Свойство("ИдентификаторСалона") Тогда
		СтруктураПередачи.Вставить("autosalonId", Описание.ИдентификаторСалона);
	Иначе
		СтруктураПередачи.Вставить("autosalonId", Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,НастройкаПодключения,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Автосалон));
	КонецЕсли;	
	
	//dateReceived (string): Дата прихода на склад
	СтруктураПередачи.Вставить("dateReceived",Описание.ДатаПоступления);
	
	Если Описание.Свойство("ВходящаяЦена") Тогда		
		//invoicePrice (string): Входящая стоимость
		СтруктураПередачи.Вставить("invoicePrice",Описание.ВходящаяЦена);
	КонецЕсли;
	
	//fixedPrice (string): Фиксированная стоимость
	СтруктураПередачи.Вставить("fixedPrice",Описание.Цена);
	
	Если Описание.Свойство("ДатаВыдачиПТС") Тогда	
		//ptsIssuedAt (string): Дата выдачи ПТС
		СтруктураПередачи.Вставить("ptsIssuedAt",Описание.ДатаВыдачиПТС);
	КонецЕсли;
	Если Описание.Свойство("НомерПТС") Тогда	
		//ptsNumber (string): номер ПТС
		СтруктураПередачи.Вставить("ptsNumber",Описание.НомерПТС);
	КонецЕсли;
	Если Описание.Свойство("КемВыданПТС") Тогда	
		//ptsIssuedBy (string): Кем выдан ПТС
		СтруктураПередачи.Вставить("ptsIssuedBy",Описание.КемВыданПТС);
	КонецЕсли;
	
	//onSaleAt (string): Дата вывода авто в продажу в формате dd.MM.yyyy
	СтруктураПередачи.Вставить("onSaleAt",Описание.ДатаПоступления);
	
	//engineNumber (string): Номер двигателя
	СтруктураПередачи.Вставить("engineNumber",Описание.НомерДвигателя);
	
	//bodyNumber (string): Номер кузова
	СтруктураПередачи.Вставить("bodyNumber",Описание.НомерКузова);
	
	//comment (string): Примечание
	СтруктураПередачи.Вставить("comment",Описание.Комментарий);
	
	//mileage (integer): Пробег
	СтруктураПередачи.Вставить("mileage",Описание.Пробег);
	
	//inStock (integer): Признак "В наличии"
	СтруктураПередачи.Вставить("inStock",Описание.ПризнакВНаличии);
	
	Если Описание.Свойство("СтрокаДополнительногоОборудования") Тогда			
		//equipmentText (string): Список доп. оборудования
		СтруктураПередачи.Вставить("equipmentText",Описание.СтрокаДополнительногоОборудования);
	КонецЕсли;
	
	Если Описание.Свойство("СуммаДополнительногоОборудования") Тогда			
		//equipmentPrice (integer): Цена реализации доп. оборудования
		СтруктураПередачи.Вставить("equipmentPrice",Описание.СуммаДополнительногоОборудования);
	КонецЕсли;
	
	Если Описание.Свойство("ТрейдИн") Тогда			
		//isTradeIn (integer): Trade-in
		Если Описание.ТрейдИн = Истина Тогда
			СтруктураПередачи.Вставить("isTradeIn",1);
		Иначе
			СтруктураПередачи.Вставить("isTradeIn",0);
		КонецЕсли;	
	КонецЕсли;
	
	//bodyColor (string): Цвет кузова
	СтруктураПередачи.Вставить("bodyColor",Описание.Цвет);
	
	Возврат СтруктураПередачи;
	
КонецФункции

// Функция отправки запроса предачи данных по изменению места хранения автомобиля на складе в CRM    
//                           
// Параметры:   
//  Автомобиль           - СправочникСсылка.Автомобили - Ссылка на автомобиль.
//  Описание             - Структура - Структура места хранения.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция СоздатьОбновитьМестоХраненияНаСкладеВCRM(Автомобиль,Описание,НастройкаПодключения)  Экспорт
	
	Идентификатор = Описание.Идентификатор;
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = ПолучитьИдентфикаторАвтомобиляНаСкладеПоVIN(Автомобиль.VIN,НастройкаПодключения);		
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада,Идентификатор);
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада)) Тогда
		Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада,Идентификатор);	
	КонецЕсли;
	
	СтруктураПередачи = СформироватьСтруктуруМестаХраненияПоОписанию(Описание,НастройкаПодключения);
	Результат = Ложь;
	
	//PUT /warehouseVehicle/saveStoragePlace
	
	Запрос = "/yii/api/warehouseVehicle/saveStoragePlace";
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураПередачи,Истина);
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Запрос = Запрос+"/"+Формат(Идентификатор,"ЧГ=0");
		Ответ = Инфотек_Запросы.PUTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
	Иначе
		Возврат Результат;
	КонецЕсли;	
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		Результат = Истина;
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			СтруктураРезультата = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада,ИдентификаторВСтроку(СтруктураРезультата.result.id));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

