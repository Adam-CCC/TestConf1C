// Процедура получения массива обращений из CRM     
//                           
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
Процедура ПолучитьМассивОбращенийCRM(НастройкаПодключения) Экспорт      
	
	МассивОбращений = Новый Массив;
	
	Запрос = "/yii/api/preparedServiceCase?state=0&createdSince=" + Формат(ДобавитьМесяц(ТекущаяДата(),-1),"ДФ=dd.MM.yyyy");
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос,НастройкаПодключения);
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда  
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку()); 	
		СтруктураJson = ПрочитатьJSON(ЧтениеJSON,Ложь);			
		Для каждого Элемент Из СтруктураJson.result Цикл 
			МассивОбращений.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
		КонецЦикла;
	КонецЕсли; 
	Если МассивОбращений.Количество() > 0 Тогда 
		ОбработатьМассивОбращений(МассивОбращений,НастройкаПодключения);
	КонецЕсли;
	МассивОбращений.Очистить();
	
	Запрос = "/yii/api/preparedServiceCase?state=1&createdSince=" + Формат(ДобавитьМесяц(ТекущаяДата(),-1),"ДФ=dd.MM.yyyy");
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос,НастройкаПодключения);
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда 
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку()); 	
		СтруктураJson = ПрочитатьJSON(ЧтениеJSON,Ложь);			
		Для каждого Элемент Из СтруктураJson.result Цикл 
			МассивОбращений.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
		КонецЦикла;
	КонецЕсли;
	Если МассивОбращений.Количество() > 0 Тогда 
		ОбработатьМассивОбращений(МассивОбращений,НастройкаПодключения);
	КонецЕсли;
	
	ЗакрытьЛишниеОбращения(НастройкаПодключения); 
	
КонецПроцедуры

// Процедура обработки массива обращений из CRM, обновление и создание записей регистра     
//                           
// Параметры:
//  МассивОбращений - Массив - Обращения, полученные из CRM.  
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
Процедура ОбработатьМассивОбращений(МассивОбращений,НастройкаПодключения)
	
	Для Каждого Обращение Из МассивОбращений Цикл   
		Если ЗначениеЗаполнено(Обращение.id) Тогда
			МенеджерЗаписи = РегистрыСведений.Инфотек_ОбращенияCRM.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Идентификатор = Обращение.id;
			МенеджерЗаписи.НастройкаПодключения = НастройкаПодключения;     
			МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.ВРаботе;
			МенеджерЗаписи.Прочитать();
			Если Не МенеджерЗаписи.Выбран() Тогда 
				Если Обращение.state = "1" Тогда 
					МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.ВРаботе;  
				ИначеЕсли Обращение.state = "0" Тогда 
					МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.НеВзятВРаботу;
				Иначе
					МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.ВзятВРаботу;
				КонецЕсли;
			КонецЕсли;     
			СтруктураАвто = Обращение.clientVehicle;
			МенеджерЗаписи.Автомобиль = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиАвтомобильПоСтруктуре(СтруктураАвто,НастройкаПодключения);
			Если Обращение.Свойство("generalClient") Тогда
				
				СтруктураКлиент = Обращение.generalClient;
				Тип = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураКлиент.type);		
				Если Найти(Тип, "individual") <> 0 Тогда
					СтруктураФизЛицо = СтруктураКлиент.primaryPerson;    
					Фамилия = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
					Имя = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
					Отчество = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);		
					Наименование  = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
					МассивТелефоны = СтруктураФизЛицо.phones;
					Для каждого Эл из МассивТелефоны Цикл
						Если ЗначениеЗаполнено(Эл.number) Тогда      	
							МенеджерЗаписи.Телефон = Эл.number;
							Контрагент =  Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоНомеруТелефонаФИО(Эл.number,Наименование);	
							Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
								Контрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоНомеруТелефона(Эл.number);
							КонецЕсли;	
						КонецЕсли; 	
					КонецЦикла;
					ДатаРожд      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.birthday);
					Наименование  = Фамилия + " " + Имя + " " + Отчество;
					
					Если ЗначениеЗаполнено(Контрагент) Тогда
						МенеджерЗаписи.Контрагент = Контрагент;
					Иначе 
						Контрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоФИОДатеРождения(Наименование,ДатаРожд);			 
						Если ЗначениеЗаполнено(Контрагент) Тогда
							МенеджерЗаписи.Контрагент = Контрагент;              
						Иначе
							МенеджерЗаписи.Контрагент = Фамилия + " " + Имя + " " + Отчество;    
						КонецЕсли;
					КонецЕсли;		
				ИначеЕсли Найти(Тип, "business") <> 0 Тогда			
					СтруктураОрганизация =  СтруктураКлиент.company;			
					НаименованиеКомпании = СтруктураОрганизация.name;
					email  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.email);
					ИНН    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.inn);
					КПП    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.kpp);
					ОКПО   = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.ogrn); 
					
					МассивТелефоны  = СтруктураОрганизация.phones;
					
					//1.Поискать по ОКПО
					Если ЗначениеЗаполнено(ОКПО) Тогда
						Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоОКПО",ОКПО);
					КонецЕсли;
					
					//2.Поискать по ИНН
					Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() И ЗначениеЗаполнено(ИНН) Тогда
						Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН",ИНН);
					КонецЕсли;
					
					////3.Поискать по КПП
					//Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() И ЗначениеЗаполнено(КПП) Тогда
					//	Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КПП",КПП);
					//КонецЕсли;    
					
					//4.По номеру телефона
					Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
						//Учесть +,7,8
						Для каждого Эл из МассивТелефоны Цикл
							Если ЗначениеЗаполнено(Эл.number) Тогда
								Контрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоНомеруТелефона(Эл.number);
								Если Не Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
									Прервать;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли; 
					Если ЗначениеЗаполнено(Контрагент) Тогда
						МенеджерЗаписи.Контрагент = Контрагент;
					Иначе
						МенеджерЗаписи.Контрагент = НаименованиеКомпании;
					КонецЕсли;			
				КонецЕсли;      
				МенеджерЗаписи.ПричинаОбращения = Инфотек_ОбщиеПроцедуры.УбратьКавычки(Обращение.service_client_statement);      
				Попытка
					ФИОМастера = Обращение.assignee.person;
					ИдентификаторМастера = Обращение.assignee.id;
					Если ЗначениеЗаполнено(ИдентификаторМастера) Тогда
						Мастер = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдентификаторМастера,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
						Если ЗначениеЗаполнено(Мастер) Тогда
							МенеджерЗаписи.МастерКонсультант = Мастер;
						КонецЕсли;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(Мастер) Тогда
						ЗапросСотр = новый запрос();
						ЗапросСотр.УстановитьПараметр("парФИО",СокрЛП(ФИОМастера));
						ЗапросСотр.Текст = "ВЫБРАТЬ
						|	Сотрудники.Ссылка,
						|	Сотрудники.Наименование,
						|	Сотрудники.Представление
						|ИЗ
						|	Справочник.Сотрудники КАК Сотрудники
						|ГДЕ
						|	Сотрудники.Наименование ПОДОБНО ""%"" + &парФИО + ""%""";
						
						РезультатСотр = ЗапросСотр.Выполнить().Выбрать();
						Если РезультатСотр.Следующий() Тогда
							МенеджерЗаписи.МастерКонсультант = РезультатСотр.Ссылка;
						КонецЕсли;
					КонецЕсли;	  
				Исключение
				КонецПопытки;
				МенеджерЗаписи.НастройкаПодключения = НастройкаПодключения;
				МенеджерЗаписи.ДатаОбращения = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(Обращение.createdat);
				МенеджерЗаписи.Идентификатор = Обращение.id;
				МенеджерЗаписи.Записать();
			КонецЕсли;
		КонецЕсли;  
	КонецЦикла;	
	
КонецПроцедуры

// Функция получения массива новых автомобилей на складе из CRM
//                           
// Параметры:   
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  МассивВозврата - Массив автомобилей из CRM
//
Функция ПолучитьМассивНовыхАвтомобилейНаСкладе(НастройкаПодключения) Экспорт
	
	МассивВозврата = Неопределено;
	
	Запрос = "/yii/api/warehouseVehicle?isTradeIn=0&metastatus=present";
 	КоличествоСтраниц = Инфотек_Запросы.ПолучитьКоличествоСтраницИзОтвета(Запрос,НастройкаПодключения);
	
	ТекущаяСтраница = 1;
	МассивВозврата = Новый Массив;

	Пока ТекущаяСтраница <= КоличествоСтраниц Цикл
		ЗапросКВыполнению = "/yii/api/warehouseVehicle?WarehouseVehicle_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0") + "&isTradeIn=0&metastatus=present";	
		Ответ = Инфотек_Запросы.GETЗапрос(ЗапросКВыполнению,НастройкаПодключения);	
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			СтруктураJson = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Для Каждого Элемент ИЗ СтруктураJson.result Цикл
				МассивВозврата.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
			КонецЦикла;
		КонецЕсли;
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЦикла;
	
	Возврат МассивВозврата;
	
КонецФункции     

// Функция получения массива подержанных автомобилей на складе из CRM
//                           
// Параметры:   
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  МассивВозврата - Массив автомобилей из CRM
//
Функция ПолучитьМассивБУАвтомобилейНаСкладе(НастройкаПодключения) Экспорт
	
	МассивВозврата = Неопределено;

	МассивВозврата = Новый Массив;
	
	Запрос = "/yii/api/warehouseVehicle?isTradeIn=1&metastatus=waiting";
 	КоличествоСтраниц = Инфотек_Запросы.ПолучитьКоличествоСтраницИзОтвета(Запрос,НастройкаПодключения);
	
	ТекущаяСтраница = 1;

	Пока ТекущаяСтраница <= КоличествоСтраниц Цикл
		ЗапросКВыполнению = "/yii/api/warehouseVehicle?WarehouseVehicle_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0") + "&isTradeIn=1&metastatus=waiting";	
		Ответ = Инфотек_Запросы.GETЗапрос(ЗапросКВыполнению,НастройкаПодключения);	
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			СтруктураJson = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Для Каждого Элемент ИЗ СтруктураJson.result Цикл
				МассивВозврата.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
			КонецЦикла;
		КонецЕсли;
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЦикла;

	Запрос = "/yii/api/warehouseVehicle?isTradeIn=1&metastatus=on-sale";
	КоличествоСтраниц = Инфотек_Запросы.ПолучитьКоличествоСтраницИзОтвета(Запрос,НастройкаПодключения);
	
	ТекущаяСтраница = 1;
	
	Пока ТекущаяСтраница <= КоличествоСтраниц Цикл
		ЗапросКВыполнению = "/yii/api/warehouseVehicle?WarehouseVehicle_page=" + Формат(ТекущаяСтраница,"ЧН=0; ЧГ=0") + "&isTradeIn=1&metastatus=on-sale";	
		Ответ = Инфотек_Запросы.GETЗапрос(ЗапросКВыполнению,НастройкаПодключения);	
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			СтруктураJson = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Для Каждого Элемент ИЗ СтруктураJson.result Цикл
				МассивВозврата.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
			КонецЦикла;
		КонецЕсли;
		ТекущаяСтраница = ТекущаяСтраница + 1;
	КонецЦикла;
	
	Возврат МассивВозврата;
	
КонецФункции

// Процедура получения массива рабочих листов из CRM     
//                           
// Параметры:
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
Функция ПолучитьМассивРабочихЛистовCRM(НастройкаПодключения) Экспорт      
	
	МассивРабочихЛистов = Новый Массив;
	
	Запрос = "/yii/api/retailCase?createdSince=" + Формат(НастройкаПодключения.ДатаНачалаЗагрузкиРабочихЛистов,"ДФ=dd.MM.yyyy") + "&scheduledStageType=11";
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос,НастройкаПодключения);
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда  
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку()); 	
		СтруктураJson = ПрочитатьJSON(ЧтениеJSON,Ложь);			
		Для каждого Элемент Из СтруктураJson.result Цикл 
			МассивРабочихЛистов.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
		КонецЦикла;
	КонецЕсли; 
	
	Запрос = "/yii/api/SaleUsedCase?createdSince=" + Формат(НастройкаПодключения.ДатаНачалаЗагрузкиРабочихЛистов,"ДФ=dd.MM.yyyy") + "&scheduledStageType=11";
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос,НастройкаПодключения);
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда  
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку()); 	
		СтруктураJson = ПрочитатьJSON(ЧтениеJSON,Ложь);			
		Для каждого Элемент Из СтруктураJson.result Цикл 
			МассивРабочихЛистов.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
		КонецЦикла;
	КонецЕсли; 
	
	Запрос = "/yii/api/CorporateCase?createdSince=" + Формат(НастройкаПодключения.ДатаНачалаЗагрузкиРабочихЛистов,"ДФ=dd.MM.yyyy") + "&scheduledStageType=11";
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос,НастройкаПодключения);
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда  
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку()); 	
		СтруктураJson = ПрочитатьJSON(ЧтениеJSON,Ложь);			
		Для каждого Элемент Из СтруктураJson.result Цикл 
			МассивРабочихЛистов.Добавить(Инфотек_ОбщиеПроцедуры.СкопироватьРекурсивно(Элемент));
		КонецЦикла;
	КонецЕсли; 
	
	Возврат МассивРабочихЛистов;

КонецФункции

