// Функция получает/создает Контрагента для рабочего листа трейд-ин из CRM     
//                           
// Параметры:
//  СтруктураРезультата - резутьтат запроса рабочего листа трейд-ин из CRM
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM
// Возвращаемое значение:
//  Контрагент - ссылка на элемент справочника Контрагенты.  
//
Функция ПолучитьСоздатьКонтрагентаТрейдИн(СтруктураРезультата, НастройкаПодключения)
	СтруктураКлиент = СтруктураРезультата.generalClient;      
	ТипКлиента = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураКлиент.type);
	Если СтрНайти(ТипКлиента,"individual") > 0 Тогда
		МассивТелефоны = СтруктураКлиент.primaryPerson.phones;				
	ИначеЕсли СтрНайти(ТипКлиента, "business") > 0 Тогда
		МассивТелефоны = СтруктураКлиент.company.phones;
	КонецЕсли;
	Если МассивТелефоны = Неопределено Или МассивТелефоны.Количество() = 0 Тогда
		Сообщить("Не указаны телефоны Клиента в Рабочем листе TradeIn №" + Строка(СтруктураРезультата.id), СтатусСообщения.Внимание);
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;			

	Если Найти(ТипКлиента,"individual") <> 0 Тогда	
		СтруктураФизЛицо =  СтруктураКлиент.primaryPerson;
		Фамилия       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
		Имя           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
		Отчество      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
		Если ЗначениеЗаполнено(Фамилия) И ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(Отчество) Тогда 
			Возврат Инфотек_ИнтеграцияCRM.СоздатьОбновитьКонтрагента(СтруктураКлиент, НастройкаПодключения);			
			
		Иначе
			Сообщить("Не полностью указано ФИО Клиента в Рабочем листе TradeIn №" + Строка(СтруктураРезультата.id), СтатусСообщения.Внимание);
			Возврат Справочники.Контрагенты.ПустаяСсылка();	
		КонецЕсли;
		
	ИначеЕсли Найти(ТипКлиента,"business") <> 0 Тогда	
		СтруктураОрганизация =  СтруктураКлиент.company;			
		НаименованиеКомпании = СтруктураОрганизация.name;
		email  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.email);
		ИНН    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.inn);
		Если ЗначениеЗаполнено(НаименованиеКомпании) И ЗначениеЗаполнено(ИНН) Тогда 
			Возврат Инфотек_ИнтеграцияCRM.СоздатьОбновитьКонтрагента(СтруктураКлиент, НастройкаПодключения);			

		Иначе
			Сообщить("Не указано Наименовиние или ИНН юр. лица в Рабочем листе TradeIn №" + Строка(СтруктураРезультата.id), СтатусСообщения.Внимание);
			Возврат  Справочники.Контрагенты.ПустаяСсылка();	
		КонецЕсли;
	КонецЕсли;
КонецФункции

// Функция получает Предложенную цену из оценки трейд-ин из CRM     
//                           
// Параметры:
//  СтруктураРезультата - резутьтат запроса рабочего листа трейд-ин из CRM
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM
// Возвращаемое значение:
//  Контрагент - ссылка на элемент справочника Контрагенты.  
//
Функция ПолучитьПредложеннуюЦенуТрейдИн(id_CRM, НастройкаПодключения)
	Запрос = "/yii/api/TradeInValuation?caseId=" + id_CRM;
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос, НастройкаПодключения);
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		СтурктураРезультата = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);
	Иначе
		Сообщить("Не удалось получить Оценку автомобиля Рабочем листе TradeIn №" + id_CRM, СтатусСообщения.Внимание);
		Возврат 0;	
	КонецЕсли;
	
	Если СтурктураРезультата = Неопределено Тогда
		Сообщить("Не удалось получить Оценку автомобиля Рабочем листе TradeIn №" + id_CRM, СтатусСообщения.Внимание);
		Возврат 0;
	КонецЕсли;
	
	Если Не СтурктураРезультата.success Тогда
		Сообщить("Не удалось получить Оценку автомобиля Рабочем листе TradeIn №" + id_CRM, СтатусСообщения.Внимание);
		Возврат 0;
	Иначе
		СтурктураРезультата = СтурктураРезультата.result;
	КонецЕсли;
	
	Если ТипЗнч(СтурктураРезультата) = Тип("Массив") Тогда
		стОценка = Новый Структура();
		Если СтурктураРезультата.Количество() = 0 Тогда
			Сообщить("Не проведена Оценка автомобиля Рабочем листе TradeIn №" + id_CRM, СтатусСообщения.Внимание);
			Возврат 0;
			
		Иначе
			стОценка = СтурктураРезультата[0];
		КонецЕсли;
		
		ПредложеннаяЦена = Неопределено;
		Если стОценка.Свойство("proposedPrice", ПредложеннаяЦена) Тогда
			Возврат Число(ПредложеннаяЦена);
			
		Иначе
			Сообщить("Не указана Предложенная цена автомобиля Рабочем листе TradeIn №" + id_CRM, СтатусСообщения.Внимание);
			Возврат 0;
		КонецЕсли;
		
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

