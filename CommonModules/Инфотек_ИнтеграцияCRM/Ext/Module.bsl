// Функция отправки запроса данных по ТО в CRM    
//                           
// Параметры:   
//  ДокЗаказНаряд              - ДокументСсылка - Ссылка на документ заказ наряд, заявка на ремонт.
//  ИдентификаторВидаРемонтаТО - Строка - Идентификатор ТО из CRM.
//  НастройкаПодключения       - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция ОбработатьДанныеПоТО(ДокЗаказНаряд,ИдентификаторВидаРемонтаТО,НастройкаПодключения) Экспорт
	
	ДанныеДляПередачи = Новый Структура();
	ИдентификаторАвтомобиля = ПолучитьИдентфикаторАвтомобиляПоVIN(ДокЗаказНаряд.Автомобиль.VIN,НастройкаПодключения);
	ИдентификаторТО = ПолучитьИдентфикаторТОПоАвтомобилю(ИдентификаторАвтомобиля,ИдентификаторВидаРемонтаТО,НастройкаПодключения);	
	ДанныеДляПередачи.Вставить("client_vehicle_id",ИдентификаторАвтомобиля);
	ДанныеДляПередачи.Вставить("ref_work_id",ИдентификаторВидаРемонтаТО);
	ДанныеДляПередачи.Вставить("seller_id",Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ДокЗаказНаряд.ПодразделениеКомпании,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Продавец));
	ДанныеДляПередачи.Вставить("autosalon_id",Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ДокЗаказНаряд.ПодразделениеКомпании,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Автосалон));
	ДанныеДляПередачи.Вставить("date",Формат(ДокЗаказНаряд.Дата,"ДФ=dd.MM.yyyy"));
	Пробег = "";
	Если ЗначениеЗаполнено(ДокЗаказНаряд.Пробег) Тогда
		Пробег = ДокЗаказНаряд.Пробег;
	Иначе	
		ВыборкаПробег = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьИнфоПоАвто(ДокЗаказНаряд.Автомобиль,Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
		Если ВыборкаПробег.Следующий() Тогда
			Пробег = ВыборкаПробег.Значение;
		КонецЕсли;
	КонецЕсли;
	ДанныеДляПередачи.Вставить("mileage", Пробег);	
	
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(ДанныеДляПередачи,Истина);
	Если ЗначениеЗаполнено(ИдентификаторТО) Тогда
		Запрос = "/yii/api/vehicleMaintenance/" + Формат(ИдентификаторТО,"ЧГ=0");
		Ответ = Инфотек_Запросы.PUTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
	Иначе
		Запрос = "/yii/api/vehicleMaintenance";
		Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
	КонецЕсли;
	
	Результат = Ложь;
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
	
КонецФункции	

// Функция отправки запроса заказ наряда в CRM    
//                           
// Параметры:   
//  ЗаказНаряд           - ДокументСсылка - Ссылка на документ заказ наряд, заявка на ремонт.
//  Описание             - Структура - Структура описания заказ наряда.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция СоздатьОбновитьЗаказНарядВCRM(ЗаказНаряд,Описание,НастройкаПодключения)  Экспорт
	
	Идентификатор = Описание.Id;
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = ПолучитьИдентфикаторЗаказНарядаПоКоду(Описание.Id,НастройкаПодключения);		
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,ЗаказНаряд.Ссылка,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ЗаказНаряд,Идентификатор);
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДляПередачи = Новый Структура;
	
	//POST /Package
	
	Запрос = "/yii/api/Package";
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(Описание,Истина);
	ДанныеДляПередачи.Вставить("body", ТелоЗапроса);
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(ДанныеДляПередачи,Истина);
	Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
	Результат = Ложь;
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		Результат = Истина;
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
			СтруктураРезультата = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,ЗаказНаряд.Ссылка,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ЗаказНаряд,ИдентификаторВСтроку(СтруктураРезультата.result.id));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция отправки запроса завершения обращения в CRM    
//                           
// Параметры:   
//  ДокументЗаявка       - ДокументСсылка.ЗаявкаНаРемонт - Ссылка на документ заявка на ремонт.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция ЗавершитьОбращение(ДокументЗаявка,НастройкаПодключения) Экспорт	
	
	ДанныеДляПередачи = Новый Структура();
	ДанныеДляПередачи.Вставить("comment","Заявка сохранена");	
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(ДанныеДляПередачи,Истина);
	Запрос = "/yii/api/preparedServiceStage/finish?case_id=" + ДокументЗаявка.Инфотек_ИдентификаторОбращения + "&type=30";
	Ответ = Инфотек_Запросы.PUTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
	Результат = Ложь;
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		Результат = Истина;  
		МенеджерЗаписи = РегистрыСведений.Инфотек_ОбращенияCRM.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = ДокументЗаявка.Инфотек_ИдентификаторОбращения;
		МенеджерЗаписи.НастройкаПодключения = НастройкаПодключения; 
		МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.ВРаботе;
		МенеджерЗаписи.Прочитать();  
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Контрагент = ДокументЗаявка.Заказчик;
			МенеджерЗаписи.Автомобиль = ДокументЗаявка.Автомобиль;	  
			МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.Завершён;
			МенеджерЗаписи.Записать();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция отправки запроса завершения обращения отменой в CRM из заявки на ремонт 1С    
//                           
// Параметры:   
//  ДокументЗаявка       - ДокументСсылка.ЗаявкаНаРемонт - Ссылка на документ заявка на ремонт.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция ЗавершитьОбращениеОтменойИзДокумента(ДокументЗаявка,НастройкаПодключения) Экспорт	
	
	ДанныеДляПередачи = Новый Структура();   
	Если ЗначениеЗаполнено(ДокументЗаявка.ПричинаОтказа) Тогда   
		ДанныеДляПередачи.Вставить("comment",ДокументЗаявка.ПричинаОтказа.Наименование);
	Иначе
		ДанныеДляПередачи.Вставить("comment","Заявка отменена");	
	КонецЕсли;
	ДанныеДляПередачи.Вставить("result_id","1");
	
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(ДанныеДляПередачи,Истина);
	Запрос = "/yii/api/PreparedServiceCase/reject?id=" + ДокументЗаявка.Инфотек_ИдентификаторОбращения;
	Ответ = Инфотек_Запросы.PUTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
	Результат = Ложь;
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		Результат = Истина;  
		МенеджерЗаписи = РегистрыСведений.Инфотек_ОбращенияCRM.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = ДокументЗаявка.Инфотек_ИдентификаторОбращения;
		МенеджерЗаписи.НастройкаПодключения = НастройкаПодключения; 
		МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.ВОтказе;
		МенеджерЗаписи.Прочитать();  
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Контрагент = ДокументЗаявка.Заказчик;
			МенеджерЗаписи.Автомобиль = ДокументЗаявка.Автомобиль;	  
			МенеджерЗаписи.Статус = Перечисления.Инфотек_СтатусыОбращений.Завершён;
			МенеджерЗаписи.Записать();
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

