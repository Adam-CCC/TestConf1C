// Функция получает/создает Договор взаиморасчетов     
//                           
// Параметры:
//  КлиентСсылка - ссылка на элемент справочника Контрагенты
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM
//  ВидДоговора - элемент перечисления Виды договоров
// Возвращаемое значение:
//  Контрагент - ссылка на элемент справочника контрагенты.  
//
Функция ПолучитьСоздатьДоговорВзаиморасчетов(КлиентСсылка, НастройкаПодключения, ВидДоговора)
	ЗапросДоговор = Новый Запрос();
	ЗапросДоговор.УстановитьПараметр("парКонтрагент", КлиентСсылка);
	ЗапросДоговор.УстановитьПараметр("Организация", НастройкаПодключения.Организация);
	ЗапросДоговор.УстановитьПараметр("ВидДоговора", ВидДоговора);
	ЗапросДоговор.Текст = "ВЫБРАТЬ
	                      |	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка,
	                      |	ДоговорыВзаиморасчетов.Владелец КАК Владелец
	                      |ИЗ
	                      |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	                      |ГДЕ
	                      |	ДоговорыВзаиморасчетов.Владелец = &парКонтрагент
	                      |	И НЕ ДоговорыВзаиморасчетов.ПометкаУдаления
	                      |	И ДоговорыВзаиморасчетов.Организация = &Организация
	                      |	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора";
	
	РезультатДог = ЗапросДоговор.Выполнить();
	Если РезультатДог.Пустой() Тогда	
		НовДоговор = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		НовДоговор.Владелец = КлиентСсылка;
		НовДоговор.ВидДоговора = ВидДоговора;
		НовДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");;
		НовДоговор.ВидОплаты =  Перечисления.ВидыОплаты.ПроизвольнаяОплата;
		НовДоговор.ДатаНачала = ТекущаяДата();
		НовДоговор.Организация = НастройкаПодключения.Организация;
		НовДоговор.Подразделение = НастройкаПодключения.ПодразделениеОрганизации; 
		НовДоговор.ТипДоговора = Перечисления.ТипыДоговоров.Договор;
		НовДоговор.Основной = Истина;
		НовДоговор.ДляАвтосалона = Истина;    
		НовДоговор.ЕдиницаИзмеренияАвтоработВПечатныхФормах = Перечисления.ЕдиницаИзмеренияАвтоработВПечатныхФормах.ЕдиницаИзмеренияПрочерк;
		СформироватьНаименование(НовДоговор);
		НовДоговор.УстановитьНовыйКод();
		НовДоговор.ОбменДанными.Загрузка = Истина;
		НовДоговор.Записать();
		Возврат НовДоговор.Ссылка;
		
	Иначе
		ВыборкаДоговор = РезультатДог.Выбрать();
		ВыборкаДоговор.Следующий();
		Возврат ВыборкаДоговор.Ссылка;
	КонецЕсли;
КонецФункции

// Функция получает/создает автомобиль для рабочего листа трейд-ин из CRM     
//                           
// Параметры:
//  СтруктураРезультата - резутьтат запроса рабочего листа трейд-ин из CRM
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM
// Возвращаемое значение:
//  Автомобиль - ссылка на элемент справочника Автомобили.  
//
Функция ПолучитьСоздатьАвтомобильТрейдИн(СтруктураРезультата, НастройкаПодключения)
	СтруктураАвто  = СтруктураРезультата.vehicle;  
	VIN            = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.vin);
	ГосНомер       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.stateNumber); 
	ИдМодели       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.refModelId);
	ИдКомплектации = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.ref_equipment_id); 
	ГодВыпуска     = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.productionYear);     

	Если обЗначениеНеЗаполнено(VIN) Тогда
		Сообщить("Не указан VIN автомобиля в Рабочем листе TradeIn №" + Строка(СтруктураРезультата.id), СтатусСообщения.Внимание);
		Возврат Справочники.Автомобили.ПустаяСсылка();
	КонецЕсли;
	
	Кузов = "";
	Цвет = ""; 
	Салон = "";
	мМассивИнфо = Неопределено;
	Если СтруктураРезультата.Свойство("vehicleInfo", мМассивИнфо) И ТипЗнч(мМассивИнфо) = Тип("Массив")
		И мМассивИнфо.Количество() > 0 Тогда
		Кузов = Инфотек_ОбщиеПроцедуры.УбратьКавычки(мМассивИнфо[0].series);
		Цвет = Инфотек_ОбщиеПроцедуры.УбратьКавычки(мМассивИнфо[0].color); 
		Салон = Инфотек_ОбщиеПроцедуры.УбратьКавычки(мМассивИнфо[0].skin);
	КонецЕсли;
	
	МодельАвтомобиля = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдМодели,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Модель);
	Если МодельАвтомобиля = Неопределено Тогда
		СтруктураМодели = Инфотек_ИнтеграцияCRM.ПолучитьМодельПоИдентификатору(НастройкаПодключения, ИдМодели);
		СтруктураБренда = Инфотек_ИнтеграцияCRM.ПолучитьБрендПоИдентификатору(НастройкаПодключения,СтруктураМодели.brand_id);
		МодельАвтомобиля = Справочники.Модели.НайтиПоНаименованию(СтруктураБренда.Name + " " + СтруктураМодели.Name);
		Если обЗначениеНеЗаполнено(МодельАвтомобиля) Тогда
			ЗапросГруппыБренда = Новый Запрос;
			ЗапросГруппыБренда.Текст = 
			"ВЫБРАТЬ
			|	Модели.Ссылка КАК Ссылка
			|ИЗ
