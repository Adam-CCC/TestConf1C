							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеАвтомобилей") ИЛИ ТипЗнч(Источник) = Тип("ДокументОбъект.ВозвратПоставщикуАвтомобилей") 
				ИЛИ ТипЗнч(Источник) = Тип("ДокументОбъект.КорректировкаПоступленияАвтомобилей") Тогда
				//МассивРабочихЛистов = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьРабочиеЛистыВыкупаПоДокументу(Источник.Ссылка);
