							Если ЭлМарка = Справочники.Модели.ПустаяСсылка() Тогда
								ЭлМарка = Справочники.Модели.СоздатьГруппу();
								ЭлМарка.Наименование = Марка;
								ЭлМарка.Записать();
								Модель.Родитель = ЭлМарка.Ссылка;
							КонецЕсли;
						КонецЕсли;	
						Модель.ВалютаУчета = Справочники.Валюты.НайтиПоКоду("643"); 
						Модель.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;   
						Модель.УстановитьНовыйКод();
						Модель.Записать();
						НовАвто.Модель = Модель.Ссылка;
					КонецЕсли;
				КонецЕсли;
				
				НовАвто.ВалютаУчета = НовАвто.Модель.ВалютаУчета;
				Если Не ЗначениеЗаполнено(НовАвто.ВалютаУчета) Тогда
					НовАвто.ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
				КонецЕсли;	
				Если ЗначениеЗаполнено(ДатаНачалаГарантии) Тогда
					НовАвто.ДатаНачалаГарантии = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(ДатаНачалаГарантии);
				КонецЕсли;
				Если ЗначениеЗаполнено(ДатаКонцаГарантии) Тогда
					НовАвто.ДатаОкончанияГарантии = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(ДатаКонцаГарантии);
				КонецЕсли;		
				Попытка
					Если ЗначениеЗаполнено(ГодВыпуска) Тогда
						НовАвто.ГодВыпуска = Дата(ГодВыпуска+"0101");
					КонецЕсли;
				Исключение
				КонецПопытки;
				Наименование = "";
				Если ЗначениеЗаполнено(НовАвто.Модель) Тогда
					Наименование = Наименование + СокрЛП(НовАвто.Модель.Наименование);
				КонецЕсли;
				Если ЗначениеЗаполнено(ГосНомер) Тогда
					Если Не ПустаяСтрока(Наименование) Тогда 
						Наименование = Наименование + " "; 
					КонецЕсли; 
					Наименование = Наименование + "№ " + СокрЛП(ГосНомер);
				КонецЕсли;
				Если ЗначениеЗаполнено(VIN) Тогда
					Если Не ПустаяСтрока(Наименование) Тогда
						Наименование = Наименование + " ";
					КонецЕсли;  
					Наименование = Наименование + "VIN " + СокрЛП(VIN);
				КонецЕсли;
				Если Не ПустаяСтрока(Наименование) Тогда
					НовАвто.Наименование = Наименование; 
				КонецЕсли; 
				НовАвто.Записать();
				НачалоТекущегоДня = НачалоДня(ТекущаяДата());			
				Инфотек_ИнтеграцияCRM.ЗаписьЗначенияРегистраСведения(Контрагент,Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин,НовАвто);
				Если ЗначениеЗаполнено(ГосНомер) Тогда
					Инфотек_ИнтеграцияCRM.ЗаписьЗначенияРегистраСведения(ГосНомер,Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,НовАвто);
				КонецЕсли;
				ОбДокумент.Автомобиль = НовАвто.Ссылка;
			Иначе
				ЭлМодель = Справочники.Модели.НайтиПоНаименованию(СокрЛП(НаименованиеМодели));			
				Если ЭлМодель = Справочники.Модели.ПустаяСсылка() Тогда
					ОбДокумент.Автомобиль = СокрЛП(НаименованиеМодели);
				Иначе
					ОбДокумент.Автомобиль = ЭлМодель;				
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			ОбДокумент.Автомобиль = Авто;
		КонецЕсли;
		
		ОбДокумент.ПричинаОбращения = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.service_client_statement);
		
		Если црмРезультат.Свойство("serviceRepairType") Тогда 
			ТипРемонта = црмРезультат.serviceRepairType.name;
			
			ЗапросВР = Новый запрос();
			
			ЗапросВР.Текст = "ВЫБРАТЬ
			|	ВидыРемонта.Ссылка,
			|	ВидыРемонта.ТипРемонта
			|ИЗ
			|	Справочник.ВидыРемонта КАК ВидыРемонта
			|ГДЕ
			|	НЕ ВидыРемонта.ПометкаУдаления
			|	И ВидыРемонта.Наименование ПОДОБНО ""%"" + &ПарНаименование + ""%""";
			ЗапросВР.УстановитьПараметр("ПарНаименование",ТипРемонта);
			
			РезВР = ЗапросВР.Выполнить().Выбрать();
			Если РезВР.Следующий() Тогда
				ОбДокумент.ВидРемонта = РезВР.Ссылка;
			КонецЕсли;
		КонецЕсли;
		//КонецЕсли;
		Если црмРезультат.Свойство("works") Тогда 
			МассивРаботы = црмРезультат.works;
			Для Каждого ЭлРаботы Из МассивРаботы Цикл
				СтруктураРаботы = ЭлРаботы.serviceWork;
				
				НаименованиеРаботы = СтруктураРаботы.name;
				КодРаботы          = СтруктураРаботы.code;
				ВремяВыполнения    = СтруктураРаботы.execution_time;
				НормаВремени       = СтруктураРаботы.standard_execution_time; 
				
				Работа = Справочники.Автоработы.НайтиПоКоду(СокрЛП(КодРаботы));
				
				Если Работа = Справочники.Автоработы.ПустаяСсылка() Тогда
					Сообщить("Внимание! Работа --" + НаименованиеРаботы + "-- не найдена по номеру каталога!");
				Иначе
					НоваяСтрока = ОбДокумент.Работы.Добавить();
					НоваяСтрока.Работа = Работа;
					НоваяСтрока.Количество = 1;
					НоваяСтрока.ИдентификаторРаботы = Новый УникальныйИдентификатор();
					НоваяСтрока.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС; 
					ОбДокумент.ОбработкаРеквизита("Работы.Работа",НоваяСтрока,ОбДокументФорма);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
		
		ОбДокумент.ПерерасчетЦенАвторабот(Ложь,Новый Структура);
		
		#Если Клиент Тогда
			дкВывестиЗаголовокСуммаДокумента(ОбДокументФорма);
		#КонецЕсли
		
		ФИОМастера = "";
		
		ФИОМастера = црмРезультат.assignee.person;
		ИдентификаторМастера = црмРезультат.assignee.id;
		Если ЗначениеЗаполнено(ИдентификаторМастера) Тогда
			ОбДокумент.Мастер = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдентификаторМастера,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбДокумент.Мастер) Тогда
			ЗапросСотр = Новый запрос();
			ЗапросСотр.УстановитьПараметр("парФИО", СокрЛП(ФИОМастера));
			ЗапросСотр.Текст = "ВЫБРАТЬ
			|	Сотрудники.Ссылка,
			|	Сотрудники.Наименование,
			|	Сотрудники.Представление
			|ИЗ
			|	Справочник.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.Наименование ПОДОБНО ""%"" + &парФИО + ""%""";
			
			РезультатСотр = ЗапросСотр.Выполнить().Выбрать();
			Если РезультатСотр.Следующий() Тогда
				ОбДокумент.Мастер = РезультатСотр.Ссылка;
			КонецЕсли;
		КонецЕсли;
		//Диспетчер
		СписокДиспетчер = црмРезультат.author;
		ФИОДиспетчера = СписокДиспетчер.person;
		ИдентификаторДиспетчера = СписокДиспетчер.id;
		Если ЗначениеЗаполнено(ИдентификаторДиспетчера) Тогда
			ОбДокумент.Диспетчер = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдентификаторДиспетчера,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ОбДокумент.Диспетчер) Тогда
			ЗапросСотр = Новый запрос();
			ЗапросСотр.УстановитьПараметр("парФИО", СокрЛП(ФИОДиспетчера));
			ЗапросСотр.Текст = "ВЫБРАТЬ
			|	Сотрудники.Ссылка,
			|	Сотрудники.Наименование,
			|	Сотрудники.Представление
			|ИЗ
			|	Справочник.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.Наименование ПОДОБНО ""%"" + &парФИО + ""%""";
			РезультатДиспетчер = ЗапросСотр.Выполнить().Выбрать();
			Если РезультатДиспетчер.Следующий() Тогда
				ОбДокумент.Диспетчер = РезультатДиспетчер.Ссылка;
			КонецЕсли;  
		КонецЕсли;				
		
		стрПробег = 0;
		РезПробег = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьИнфоПоАвто(ОбДокумент.Автомобиль,Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
		Если РезПробег.Следующий() Тогда
			стрПробег = РезПробег.Значение;
		КонецЕсли;
		Если ЗначениеЗаполнено(Пробег) Тогда
			Если Число(Пробег) > стрПробег Тогда			
				ЗаписьЗначенияРегистраСведения(Число(Пробег),Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег,ОбДокумент.Автомобиль,ОбДокумент.Дата);   
				ОбДокумент.Пробег = Число(Пробег);
			КонецЕсли;
		КонецЕсли;			
	Иначе
		Сообщить("Внимание!!! Не выполнен запрос в CRM!!! Проверьте настройки подключения!", СтатусСообщения.Важное);
	КонецЕсли;	
	
КонецПроцедуры

// Процедура заполнения рабочего листа по структуре рабочего листа из CRM 
//                           
// Параметры:   
//  СтурктураРезультата - Структура - Обращение из CRM.
//  ОбДокумент          - ДокументОбъект.РабочийЛист - Объект документ рабочий лист.
//  ОбДокументФорма     - Форма - Форма документа рабочий лист.
//
Процедура ОбработатьСтруктуруЗаполнитьРеквизитыРабочегоЛиста(СтруктураРезультата, НастройкаПодключения, ОбДокумент, ОбДокументФорма) Экспорт
	Если СтруктураРезультата.success Тогда
		црмРезультат = СтруктураРезультата.result;	
		Если црмРезультат.Свойство("generalClient") Тогда        
			СтруктураКлиент = црмРезультат.generalClient;
			ТипКлиента = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураКлиент.type);
			Если СтрНайти(ТипКлиента,"individual") > 0 Тогда
				МассивТелефоны = СтруктураКлиент.primaryPerson.phones;				
			ИначеЕсли СтрНайти(ТипКлиента, "business") > 0 Тогда
				МассивТелефоны = СтруктураКлиент.company.phones;
			КонецЕсли;
			Если МассивТелефоны = Неопределено Или МассивТелефоны.Количество() = 0 Тогда
				Сообщить("В рабочем листе CRM Автодилер №" + црмРезультат.id + " не указаны телефоны клиента!", СтатусСообщения.Внимание);
				Возврат;
			КонецЕсли;
			
			МассивАвто     = црмРезультат.needs;
			СтруктураАвто  = МассивАвто[0];
			VIN            = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.vin);
			ИдМодели       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.refModelId);
			ИдКомплектации = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.ref_equipment_id);
			ИдИсточника    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.informationSourceId);     
			Если ЗначениеЗаполнено(ИдИсточника) Тогда
				ИсточникОбращения = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдИсточника,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ИсточникОбращения);
				ОбДокумент.Реклама = ИсточникОбращения; 
			КонецЕсли;
			
			ОбДокумент.Дата = ТекущаяДата();
			ОбДокумент.Инфотек_Идентификатор_CRM = ИдентификаторВСтроку(црмРезультат.id);
			
			Если Найти(ТипКлиента,"individual") <> 0 Тогда	
				СтруктураФизЛицо =  СтруктураКлиент.primaryPerson;
				ОбДокумент.ЮридическоеЛицо = Ложь;
				Фамилия       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
				Имя           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
				Отчество      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
				Пол           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.gender);
				Если ЗначениеЗаполнено(Фамилия) И ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(Отчество) Тогда 
					Контрагент = СоздатьОбновитьКонтрагента(СтруктураКлиент, НастройкаПодключения);			
					ОбДокумент.Контрагент = Контрагент;
					ОбДокумент.ДоговорВзаиморасчетов = ПолучитьСоздатьДоговорВзаиморасчетов(Контрагент, НастройкаПодключения, Перечисления.ВидыДоговоров.Продажа);
					ОбДокумент.Пол = Контрагент.Пол;
					ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
					КонецЕсли; 
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонДомашний);
					КонецЕсли;
					
				Иначе
					ОбДокумент.Контрагент = Имя;
					Если ЗначениеЗаполнено(Пол) Тогда
						ОбДокумент.Пол = ?(Пол = "M",Перечисления.ПолФизическихЛиц.Мужской,Перечисления.ПолФизическихЛиц.Женский);
					Иначе
						Если Найти(нрег(Прав(Отчество,3)),"вич") Тогда
							ОбДокумент.Пол = Перечисления.ПолФизическихЛиц.Мужской;
						ИначеЕсли Найти(нрег(Прав(Отчество,3)),"вна") Тогда
							ОбДокумент.Пол = Перечисления.ПолФизическихЛиц.Женский;
						КонецЕсли;
					КонецЕсли;   
					Для Каждого Эл Из МассивТелефоны Цикл			
						ОбДокумент.ПредставлениеТелефона = Эл.number;
					КонецЦикла;	
				КонецЕсли;
				
			ИначеЕсли Найти(ТипКлиента,"business") <> 0 Тогда	
				ОбДокумент.ЮридическоеЛицо = Истина;
				СтруктураОрганизация =  СтруктураКлиент.company;			
				НаименованиеКомпании = СтруктураОрганизация.name;
				ИНН    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.inn);
				Если ЗначениеЗаполнено(НаименованиеКомпании) И ЗначениеЗаполнено(ИНН) Тогда 
					Контрагент = СоздатьОбновитьКонтрагента(СтруктураКлиент, НастройкаПодключения);			
					ОбДокумент.Контрагент = Контрагент;
					ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
					КонецЕсли; 
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонДомашний);
					КонецЕсли;
				Иначе
					ОбДокумент.Контрагент = НаименованиеКомпании; 
					Для Каждого Эл Из МассивТелефоны Цикл			
						ОбДокумент.ПредставлениеТелефона = Эл.number;
					КонецЦикла;	
				КонецЕсли;
			КонецЕсли;
			
			МодельАвтомобиля = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдМодели,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Модель);
			Если МодельАвтомобиля <> Неопределено Тогда
				ОбДокумент.Модель = МодельАвтомобиля;   
				
			Иначе
				СтруктураМодели = ПолучитьМодельПоИдентификатору(НастройкаПодключения,ИдМодели);
				МодельАвтомобиля = Справочники.Модели.НайтиПоНаименованию(СтруктураМодели.Name);      
				Если Не ЗначениеЗаполнено(МодельАвтомобиля) Тогда
					СтруктураБренда = ПолучитьБрендПоИдентификатору(НастройкаПодключения,СтруктураМодели.brand_id);
					МодельАвтомобиля = Справочники.Модели.НайтиПоНаименованию(СтруктураБренда.Name + " " + СтруктураМодели.Name);   
				Иначе
					ОбДокумент.Модель = МодельАвтомобиля;
				КонецЕсли;	
				
				Если Не ЗначениеЗаполнено(МодельАвтомобиля) Тогда
					Бренд = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,СтруктураМодели.brand_id,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Бренд);
					Если Не ЗначениеЗаполнено(Бренд) Тогда
						Бренд = Справочники.Модели.НайтиПоНаименованию(СтруктураБренда.Name);
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Бренд) Тогда
						МодельАвтомобиля = Справочники.Модели.СоздатьЭлемент();
						МодельАвтомобиля.Наименование = Бренд.Наименование + " " + СтруктураМодели.Name;    
						МодельАвтомобиля.НаименованиеПолное = МодельАвтомобиля.Наименование;    
						МодельАвтомобиля.ВалютаУчета = Справочники.Валюты.НайтиПоКоду("643");
						МодельАвтомобиля.Марка = Бренд;
						
						ГруппаРодитель = Справочники.Модели.НайтиПоНаименованию(СтруктураБренда.Name,, Справочники.Модели.АВТОМОБИЛИ_В_ПРОДАЖЕ);
						Если обЗначениеНеЗаполнено(ГруппаРодитель) Тогда
							ГруппаРодитель = Справочники.Модели.АВТОМОБИЛИ_В_ПРОДАЖЕ;
						КонецЕсли;
						
						МодельАвтомобиля.Родитель = ГруппаРодитель;
						МодельАвтомобиля.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
						МодельАвтомобиля.УстановитьНовыйКод();
						МодельАвтомобиля.ОбменДанными.Загрузка = Истина;
						МодельАвтомобиля.Записать();
						МодельАвтомобиля = МодельАвтомобиля.Ссылка;
						ОбДокумент.Модель = МодельАвтомобиля;
						
					Иначе
						Сообщить("Не удалось найти/создать модель " + СтруктураМодели.Name + "!", СтатусСообщения.Внимание);
						Возврат;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
			Если ЗначениеЗаполнено(ИдКомплектации) Тогда
				КомплектацияАвтомобиля = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдКомплектации,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Комплектация);
				Если КомплектацияАвтомобиля <> Неопределено Тогда
					ОбДокумент.ВариантКомплектации = КомплектацияАвтомобиля;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(VIN) Тогда
				ЗапросАвто = Новый Запрос();
				ЗапросАвто.Текст = 
				"ВЫБРАТЬ
				|	Авто.Ссылка КАК Ссылка,
				|	Авто.Модель КАК Модель
				|ИЗ
				|	Справочник.Автомобили КАК Авто
				|ГДЕ
				|	НЕ Авто.ПометкаУдаления
				|	И НЕ Авто.ЭтоГруппа
				|	И Авто.VIN ПОДОБНО ""%"" + &VIN + ""%""";
				ЗапросАвто.УстановитьПараметр("VIN","%"+VIN+"%");
				РезАвто = ЗапросАвто.Выполнить();
				Если Не РезАвто.Пустой() Тогда
					ВыборкаАвто = РезАвто.Выбрать();
					ВыборкаАвто.Следующий();
					ОбДокумент.Автомобиль = ВыборкаАвто.Ссылка;
					ОбДокумент.Модель = ВыборкаАвто.Модель;
					
				ИначеЕсли ЗначениеЗаполнено(МодельАвтомобиля) Тогда	
					НовАвто = Справочники.Автомобили.СоздатьЭлемент();
					НовАвто.УстановитьНовыйКод();
					НовАвто.VIN = VIN;
					НовАвто.НомерКузова = VIN;
					НовАвто.Модель = МодельАвтомобиля;	
					НовАвто.ВалютаУчета = НовАвто.Модель.ВалютаУчета;
					НовАвто.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;
					Если Не ЗначениеЗаполнено(НовАвто.ВалютаУчета) Тогда
						НовАвто.ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
					КонецЕсли;
					Если ЗначениеЗаполнено(КомплектацияАвтомобиля) Тогда
						НовАвто.ВариантКомплектации = КомплектацияАвтомобиля;
					КонецЕсли;
					Наименование = "";
					Если ЗначениеЗаполнено(НовАвто.Модель) Тогда
						Наименование = Наименование + СокрЛП(НовАвто.Модель.Наименование);
					КонецЕсли;
					Если ЗначениеЗаполнено(VIN) Тогда
						Если НЕ ПустаяСтрока(Наименование) Тогда
							Наименование = Наименование + " ";
						КонецЕсли;  
						Наименование = Наименование + "VIN " + СокрЛП(VIN);
					КонецЕсли;
					Если НЕ ПустаяСтрока(Наименование) Тогда
						НовАвто.Наименование = Наименование; 
					КонецЕсли;
					
					НовАвто.ОбменДанными.Загрузка = Истина;
					НовАвто.Записать();
					ОбДокумент.Автомобиль = НовАвто.Ссылка;
					ОбДокумент.Модель = МодельАвтомобиля;
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(МодельАвтомобиля) Тогда	 
				ОбДокумент.Модель = МодельАвтомобиля;	
			КонецЕсли;
			
			Если црмРезультат.type = "5" Тогда
				ОбДокумент.ВидАвтомобиля = Перечисления.ВидАвтомобиля.АвтомобильСПробегом;
				ОбДокумент.ТолькоБУ = Истина;
				ОбДокумент.Модель = Справочники.Модели.АвтоСПробегом;
				Попытка
					ОбДокумент.РРЦ = Число(црмРезультат.contract.sum);
				Исключение
				КонецПопытки;
				
			Иначе
				ОбДокумент.ВидАвтомобиля = Перечисления.ВидАвтомобиля.Новый;
			КонецЕсли;
			
			Попытка
				ФИОМенеджера = "";
				ФИОМенеджера = црмРезультат.assignee.person; 
				Если ФИОМенеджера = Неопределено Тогда
					ФамилияМенеджера       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.assignee.lastName);
					ИмяМенеджера           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.assignee.firstName);
					ОтчествоМенеджера      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.assignee.middleName);	
					ФИОМенеджера = ФамилияМенеджера + " " + ИмяМенеджера + " " + ОтчествоМенеджера;
				КонецЕсли;
				ИдентификаторМенеджера = црмРезультат.assignee.id;  
				Менеджер = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдентификаторМенеджера,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
				Если ЗначениеЗаполнено(Менеджер) Тогда			
					ОбДокумент.Менеджер = Менеджер;
				КонецЕсли;	
				Если Не ЗначениеЗаполнено(ОбДокумент.Менеджер) Тогда			
					ЗапросСотр = Новый Запрос();
					ЗапросСотр.УстановитьПараметр("парФИО",СокрЛП(ФИОМенеджера));
					ЗапросСотр.Текст = 
					"ВЫБРАТЬ
					|	Сотрудники.Ссылка,
					|	Сотрудники.Наименование,
					|	Сотрудники.Представление
					|ИЗ
					|	Справочник.Сотрудники КАК Сотрудники
					|ГДЕ
					|	Сотрудники.Наименование ПОДОБНО ""%"" + &парФИО + ""%""";
					РезультатСотр = ЗапросСотр.Выполнить().Выбрать();
					Если РезультатСотр.Следующий() Тогда
						ОбДокумент.Менеджер = РезультатСотр.Ссылка;
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			Автор = црмРезультат.author;
			ФИОАвтор = црмРезультат.author.person;
			Если ФИОАвтор = Неопределено Тогда
				ФамилияАвтор       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.author.lastName);
				ИмяАвтор           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.author.firstName);
				ОтчествоАвтор      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(црмРезультат.author.middleName);	
				ФИОАвтор = ФамилияАвтор + " " + ИмяАвтор + " " + ОтчествоАвтор;
			КонецЕсли;
			
			ИдентификаторАвтора = црмРезультат.author.id;
			АвторСотрудник = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдентификаторАвтора,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
			Если ЗначениеЗаполнено(АвторСотрудник) Тогда
				ОбДокумент.Автор = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник",АвторСотрудник);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ОбДокумент.Автор) Тогда		
				ЗапросПользователи = Новый запрос();
				ЗапросПользователи.УстановитьПараметр("парФИО",СокрЛП(ФИОАвтор));
				ЗапросПользователи.Текст = 
				"ВЫБРАТЬ
				|	Пользователи.Ссылка,
				|	Пользователи.Наименование,
				|	Пользователи.Представление
				|ИЗ
				|	Справочник.Пользователи КАК Пользователи
				|ГДЕ
				|	Пользователи.Наименование ПОДОБНО ""%"" + &парФИО + ""%""";
				
				РезультатПользователи = ЗапросПользователи.Выполнить().Выбрать();
				Если РезультатПользователи.Следующий() Тогда
					ОбДокумент.Автор = РезультатПользователи.Ссылка;
				КонецЕсли;
			КонецЕсли;
			
			РабочийЛистТрейдИнID = "";
			мСвязанныеРЛ = Новый Массив();
			Если црмРезультат.Свойство("relatedCases", мСвязанныеРЛ) И мСвязанныеРЛ.Количество() > 0 Тогда
				Для Каждого СвязанныйРЛ Из мСвязанныеРЛ Цикл
					Если СвязанныйРЛ.type = "1" Тогда
						РабочийЛистТрейдИнID = СвязанныйРЛ.id;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РабочийЛистТрейдИнID) Тогда
				стРабочийЛистТрейдИн = ПолучитьСтруктуруРабочегоЛистаTradeInПоИдентификатору(РабочийЛистТрейдИнID, НастройкаПодключения);
				Если Не стРабочийЛистТрейдИн.success Тогда
					Возврат;
				КонецЕсли;
				АвтомобильТрейдИн = ПолучитьСоздатьАвтомобильТрейдИн(стРабочийЛистТрейдИн.result, НастройкаПодключения);
				Если обЗначениеНеЗаполнено(АвтомобильТрейдИн) Тогда
					Возврат;
				Иначе
					ОбДокумент.ТрейдИн = Истина;
				КонецЕсли;
				
				ОбДокумент.СобственникТрейдИн = ПолучитьСоздатьКонтрагентаТрейдИн(стРабочийЛистТрейдИн.result, НастройкаПодключения);
				ОбДокумент.АвтомобильТрейдИн = АвтомобильТрейдИн;
				ОбДокумент.ТрейдИнVIN = АвтомобильТрейдИн.VIN;
				ОбДокумент.МодельТрейдИн = АвтомобильТрейдИн.Модель;
				ОбДокумент.НетОбъявленияВInternet = Истина;
				
				СтруктураАвто  = стРабочийЛистТрейдИн.result.vehicle;
				ДополнительныеРеквизитыАвто = Инфотек_JSON.мПрочитатьJSON(СтруктураАвто.dataJson, Истина);
				Попытка
					ПрогнозСуммыРемонта = Число(ДополнительныеРеквизитыАвто.main.plannedCosts);
				Исключение
					ПрогнозСуммыРемонта = 1;
				КонецПопытки;
				Если ПрогнозСуммыРемонта > 2 Тогда
					ОбДокумент.ПрогнозСуммыРемонта = ПрогнозСуммыРемонта - 2;
				Иначе
					ОбДокумент.ПрогнозСуммыРемонта = 1;
				КонецЕсли;
				ОбДокумент.ПрогнозСуммыМКЦ = 1;
				ОбДокумент.ПрогнозСуммыДетейлинга = 1;
			КонецЕсли;
		КонецЕсли;  
	КонецЕсли;  
КонецПроцедуры

// Процедура заполнения рабочего листа Trade In по структуре рабочего листа из CRM 
//                           
// Параметры:   
//  СтурктураРезультата - Структура - Обращение из CRM.
//  ОбДокумент          - ДокументОбъект.РабочийЛистВыкупаАвтомобиля - Объект документ рабочий лист.
//  ОбДокументФорма     - Форма - Форма документа рабочий лист.
//
Процедура ОбработатьСтруктуруЗаполнитьРеквизитыРабочегоЛистаTradeIn(СтруктураРезультата,НастройкаПодключения,ОбДокумент,ОбДокументФорма) Экспорт
	
	Если СтруктураРезультата.success Тогда
		СтруктураРезультата = СтруктураРезультата.result; 	
		Если СтруктураРезультата.Свойство("generalClient") Тогда        
			СтруктураКлиент = СтруктураРезультата.generalClient;      
			ТипКлиента = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураКлиент.type);
			Если СтрНайти(ТипКлиента,"individual") > 0 Тогда
				МассивТелефоны = СтруктураКлиент.primaryPerson.phones;				
			ИначеЕсли СтрНайти(ТипКлиента, "business") > 0 Тогда
				МассивТелефоны = СтруктураКлиент.company.phones;
			КонецЕсли;
			Если МассивТелефоны = Неопределено Или МассивТелефоны.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;			
			
			СтруктураАвто  = СтруктураРезультата.vehicle;  
			VIN            = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.vin);
			ГосНомер       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.stateNumber); 
			ИдМодели       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.refModelId);
			ИдКомплектации = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.ref_equipment_id); 
			ГодВыпуска     = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.productionYear);     
			
			Попытка
				СтруктураДопРеквизитов = СтруктураАвто.warehouseVehicle;
				Цвет                   = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураДопРеквизитов.vehicle_color); 
				Салон                  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураДопРеквизитов.vehicle_trim);
			Исключение
			КонецПопытки;
			МассивИнфоАвтомобиля = СтруктураРезультата.vehicleInfo;
			Кузов                = Инфотек_ОбщиеПроцедуры.УбратьКавычки(МассивИнфоАвтомобиля[0].series);

			ОбДокумент.Инфотек_Идентификатор_CRM = ИдентификаторВСтроку(СтруктураРезультата.id);   
			ОбДокумент.ГосНомер = ГосНомер; 
			Если Найти(ТипКлиента,"individual") <> 0 Тогда	
				СтруктураФизЛицо =  СтруктураКлиент.primaryPerson;
				Фамилия       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
				Имя           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
				Отчество      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
				Если ЗначениеЗаполнено(Фамилия) И ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(Отчество) Тогда 
					Контрагент = Инфотек_ИнтеграцияCRM.СоздатьОбновитьКонтрагента(СтруктураКлиент, НастройкаПодключения);			
					ОбДокумент.Контрагент = Контрагент;
					ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
					КонецЕсли; 
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонДомашний);
					КонецЕсли;
				Иначе
					ОбДокумент.Контрагент = Имя;
					Для Каждого Эл Из МассивТелефоны Цикл			
						ОбДокумент.ПредставлениеТелефона = Эл.number;
					КонецЦикла;	
				КонецЕсли;
			ИначеЕсли Найти(ТипКлиента,"business") <> 0 Тогда	
				СтруктураОрганизация =  СтруктураКлиент.company;			
				НаименованиеКомпании = СтруктураОрганизация.name;
				email  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.email);
				ИНН    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.inn);
				Если ЗначениеЗаполнено(НаименованиеКомпании) И ЗначениеЗаполнено(ИНН) Тогда 
					Контрагент = Инфотек_ИнтеграцияCRM.СоздатьОбновитьКонтрагента(СтруктураКлиент, НастройкаПодключения);	
					ОбДокумент.Контрагент = Контрагент;
					ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
					КонецЕсли; 
					Если Не ЗначениеЗаполнено(ОбДокумент.ПредставлениеТелефона) Тогда
						ОбДокумент.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонДомашний);
					КонецЕсли;
				Иначе
					ОбДокумент.Контрагент = НаименованиеКомпании; 
					Для Каждого Эл Из МассивТелефоны Цикл			
						ОбДокумент.ПредставлениеТелефона = Эл.number;
					КонецЦикла;	
				КонецЕсли;
			КонецЕсли;
			МодельАвтомобиля = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдМодели,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Модель);
			Если МодельАвтомобиля <> Неопределено Тогда
				ОбДокумент.Модель = МодельАвтомобиля;  
			Иначе
				СтруктураМодели = Инфотек_ИнтеграцияCRM.ПолучитьМодельПоИдентификатору(НастройкаПодключения,ИдМодели);
				МодельАвтомобиля = Справочники.Модели.НайтиПоНаименованию(СтруктураМодели.Name);      
				Если Не ЗначениеЗаполнено(МодельАвтомобиля) Тогда
					СтруктураБренда = Инфотек_ИнтеграцияCRM.ПолучитьБрендПоИдентификатору(НастройкаПодключения,СтруктураМодели.brand_id);
					МодельАвтомобиля = Справочники.Модели.НайтиПоНаименованию(СтруктураБренда.Name + " " + СтруктураМодели.Name);          
				Иначе
					ОбДокумент.Модель = МодельАвтомобиля;   
				КонецЕсли;	 
				Если Не ЗначениеЗаполнено(МодельАвтомобиля) Тогда
					Бренд = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,СтруктураМодели.brand_id,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Бренд);
					Если Не ЗначениеЗаполнено(Бренд) Тогда
						ЗапросБренда = Новый Запрос;
						ЗапросБренда.Текст = 
						"ВЫБРАТЬ
						|	Модели.Ссылка КАК Ссылка
						|ИЗ
						|	Справочник.Модели КАК Модели
						|ГДЕ
						|	Модели.Наименование = &Наименование
						|	И Модели.ЭтоГруппа = ИСТИНА";
						ЗапросБренда.УстановитьПараметр("Наименование",СтруктураБренда.Name);
						РезультатБренда = ЗапросБренда.Выполнить();
						Если Не РезультатБренда.Пустой() Тогда
							ВыборкаБренда = РезультатБренда.Выбрать();
							ВыборкаБренда.Следующий();
							Бренд = ВыборкаБренда.Ссылка;
						Иначе
							Бренд = Справочники.Модели.НайтиПоКоду("ЦБ00000049");
						КонецЕсли;
					КонецЕсли;
					Если ЗначениеЗаполнено(Бренд) Тогда
						МодельАвтомобиля = Справочники.Модели.СоздатьЭлемент();
						МодельАвтомобиля.Наименование = СтруктураБренда.Name + " " + СтруктураМодели.Name;    
						МодельАвтомобиля.НаименованиеПолное = СтруктураБренда.Name + " " + СтруктураМодели.Name;  
						МодельАвтомобиля.ВалютаУчета = Справочники.Валюты.НайтиПоКоду("643");	
						МодельАвтомобиля.Родитель = Бренд;     
						МодельАвтомобиля.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
						МодельАвтомобиля.УстановитьНовыйКод();
						Попытка 
							МодельАвтомобиля.Записать();
							МодельАвтомобиля = МодельАвтомобиля.Ссылка;
							ОбДокумент.Модель = МодельАвтомобиля;   
						Исключение
						КонецПопытки;
					КонецЕсли;  
				Иначе
					ОбДокумент.Модель = МодельАвтомобиля;   
				КонецЕсли;		
			КонецЕсли;

			Если ЗначениеЗаполнено(VIN) Тогда     
				ОбДокумент.VIN = VIN;
				ДополнительныеРеквизитыАвто = Инфотек_JSON.мПрочитатьJSON(СтруктураАвто.dataJson, Истина);   
				Попытка
					ПаспортАвтомобиля = ДополнительныеРеквизитыАвто.reg.passport;
					НомерДвигателя = ПаспортАвтомобиля.engineNumber;
					НомерКузова = ПаспортАвтомобиля.bodyNumber;
					НомерШасси = ПаспортАвтомобиля.chassisNumber;
				Исключение   
					ПаспортАвтомобиля = Неопределено;
					НомерКузова = "";
					НомерДвигателя = "";
					НомерШасси = "";
				КонецПопытки;									
				Попытка   
					Пробег = ДополнительныеРеквизитыАвто.main.mileage;
					ОбДокумент.Пробег = Число(Пробег);
				Исключение 
					Пробег = ""; 
				КонецПопытки;
				Попытка   
					СвидетельствоОРегистрации = ДополнительныеРеквизитыАвто.reg.certificate; 
				Исключение 
					СвидетельствоОРегистрации = Неопределено; 
				КонецПопытки;
				
				ЗапросАвто = Новый Запрос();
				ЗапросАвто.Текст = 
				"ВЫБРАТЬ
				|	Авто.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Автомобили КАК Авто
				|ГДЕ
				|	НЕ Авто.ПометкаУдаления
				|	И НЕ Авто.ЭтоГруппа
				|	И Авто.VIN ПОДОБНО ""%"" + &VIN + ""%""";
				ЗапросАвто.УстановитьПараметр("VIN","%"+VIN+"%");
				РезАвто = ЗапросАвто.Выполнить();
				Если Не РезАвто.Пустой() Тогда
					ВыборкаАвто = РезАвто.Выбрать();
					ВыборкаАвто.Следующий();  
					Автомобиль = ВыборкаАвто.Ссылка.ПолучитьОбъект(); 
					Если ЗначениеЗаполнено(НомерДвигателя) Тогда
						Автомобиль.НомерДвигателя = НомерДвигателя;
					КонецЕсли;	
					Если ЗначениеЗаполнено(НомерКузова) Тогда
						Автомобиль.НомерКузова = НомерКузова;
					КонецЕсли;	
					Если ЗначениеЗаполнено(НомерШасси) Тогда
						Автомобиль.НомерШасси = НомерШасси;
					КонецЕсли;   
					Попытка
						Если ЗначениеЗаполнено(ГодВыпуска) Тогда
							Автомобиль.ГодВыпуска = Дата(ГодВыпуска+"0101");
						КонецЕсли;
					Исключение
					КонецПопытки;
					Попытка
						Если ЗначениеЗаполнено(Цвет) Тогда   
							ЦветАвтомобиля = Справочники.Цвета.НайтиПоНаименованию(Цвет);
							Если ЗначениеЗаполнено(ЦветАвтомобиля) Тогда 
								Автомобиль.Цвет = ЦветАвтомобиля;      
								ОбДокумент.Цвет = ЦветАвтомобиля;      
							Иначе
								ЦветАвтомобиля = Справочники.Цвета.СоздатьЭлемент();
								ЦветАвтомобиля.Наименование = Цвет; 
								ЦветАвтомобиля.Артикул = Цвет; 
								ЦветАвтомобиля.ЦветПоГИБДД = Цвет;
								ЦветАвтомобиля.УстановитьНовыйКод();
								ЦветАвтомобиля.Записать();
								Автомобиль.Цвет = ЦветАвтомобиля.Ссылка;  
								ОбДокумент.Цвет = ЦветАвтомобиля.Ссылка;  
							КонецЕсли;
						КонецЕсли;
					Исключение
					КонецПопытки;		
					Попытка
						Если ЗначениеЗаполнено(Кузов) Тогда   
							ТипКузова = Справочники.ТипыКузовов.НайтиПоНаименованию(Кузов);
							Если ЗначениеЗаполнено(ТипКузова) Тогда 
								Автомобиль.ТипКузова = ТипКузова;   
								ОбДокумент.ТипКузова = ТипКузова;
							Иначе
								ТипКузова = Справочники.ТипыКузовов.СоздатьЭлемент();
								ТипКузова.Наименование = Кузов;  
								ТипКузова.УстановитьНовыйКод();
								ТипКузова.Записать();
								Автомобиль.ТипКузова = ТипКузова.Ссылка;  
								ОбДокумент.ТипКузова = ТипКузова.Ссылка;  
							КонецЕсли;
						КонецЕсли;
					Исключение
					КонецПопытки;		
					Попытка
						Если ЗначениеЗаполнено(Салон) Тогда   
							ТипСалона = Справочники.ТипыСалона.НайтиПоНаименованию(Салон);
							Если ЗначениеЗаполнено(ТипСалона) Тогда 
								Автомобиль.ТипСалона = ТипСалона;      
							Иначе
								ТипСалона = Справочники.ТипыСалона.СоздатьЭлемент();
								ТипСалона.Наименование = Салон;   
								ТипСалона.УстановитьНовыйКод();
								ТипСалона.Записать();
								Автомобиль.ТипСалона = ТипСалона.Ссылка;  
							КонецЕсли;
						КонецЕсли;
					Исключение
					КонецПопытки;		
					Автомобиль.Записать();    
					ОбДокумент.Автомобиль = Автомобиль.Ссылка;
				ИначеЕсли ЗначениеЗаполнено(МодельАвтомобиля) Тогда	
					НовАвто = Справочники.Автомобили.СоздатьЭлемент();
					НовАвто.УстановитьНовыйКод();
					НовАвто.VIN = VIN;
					НовАвто.НомерКузова = VIN;
					НовАвто.Модель = МодельАвтомобиля;	
					НовАвто.ВалютаУчета = НовАвто.Модель.ВалютаУчета;  
					НовАвто.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;
					Попытка
						Если ЗначениеЗаполнено(ГодВыпуска) Тогда
							НовАвто.ГодВыпуска = Дата(ГодВыпуска+"0101");
						КонецЕсли;
					Исключение
					КонецПопытки;
					Попытка
						Если ЗначениеЗаполнено(Цвет) Тогда   
							ЦветАвтомобиля = Справочники.Цвета.НайтиПоНаименованию(Цвет);
							Если ЗначениеЗаполнено(ЦветАвтомобиля) Тогда 
								НовАвто.Цвет = ЦветАвтомобиля; 
								ОбДокумент.Цвет = ЦветАвтомобиля;
							Иначе
								ЦветАвтомобиля = Справочники.Цвета.СоздатьЭлемент();
								ЦветАвтомобиля.Наименование = Цвет; 
								ЦветАвтомобиля.Артикул = Цвет; 
								ЦветАвтомобиля.ЦветПоГИБДД = Цвет;
								ЦветАвтомобиля.УстановитьНовыйКод();
								ЦветАвтомобиля.Записать();
								НовАвто.Цвет = ЦветАвтомобиля.Ссылка; 
								ОбДокумент.Цвет = ЦветАвтомобиля.Ссылка;
							КонецЕсли;
						КонецЕсли;
					Исключение
					КонецПопытки;  
					Попытка
						Если ЗначениеЗаполнено(Кузов) Тогда   
							ТипКузова = Справочники.ТипыКузовов.НайтиПоНаименованию(Кузов);
							Если ЗначениеЗаполнено(ТипКузова) Тогда 
								НовАвто.ТипКузова = ТипКузова;      
								ОбДокумент.ТипКузова = ТипКузова;
							Иначе
								ТипКузова = Справочники.ТипыКузовов.СоздатьЭлемент();
								ТипКузова.Наименование = Кузов;  
								ТипКузова.УстановитьНовыйКод();
								ТипКузова.Записать();
								НовАвто.ТипКузова = ТипКузова.Ссылка;     
								ОбДокумент.ТипКузова = ТипКузова.Ссылка;
							КонецЕсли;
						КонецЕсли;
					Исключение
					КонецПопытки;
					Попытка
						Если ЗначениеЗаполнено(Салон) Тогда   
							ТипСалона = Справочники.ТипыСалона.НайтиПоНаименованию(Салон);
							Если ЗначениеЗаполнено(ТипСалона) Тогда 
								НовАвто.ТипСалона = ТипСалона;      
							Иначе
								ТипСалона = Справочники.ТипыСалона.СоздатьЭлемент();
								ТипСалона.Наименование = Салон;    
								ТипСалона.УстановитьНовыйКод();
								ТипСалона.Записать();
								НовАвто.ТипСалона = ТипСалона.Ссылка;  
							КонецЕсли;
						КонецЕсли;
					Исключение
					КонецПопытки;		
					Если ЗначениеЗаполнено(НомерДвигателя) Тогда
						НовАвто.НомерДвигателя = НомерДвигателя;
					КонецЕсли;	
					Если ЗначениеЗаполнено(НомерКузова) Тогда
						НовАвто.НомерКузова = НомерКузова;
					КонецЕсли;	
					Если ЗначениеЗаполнено(НомерШасси) Тогда
						НовАвто.НомерШасси = НомерШасси;
					КонецЕсли;
					Если Не ЗначениеЗаполнено(НовАвто.ВалютаУчета) Тогда
						НовАвто.ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
					КонецЕсли;   
					Если ЗначениеЗаполнено(ИдКомплектации) Тогда
						КомплектацияАвтомобиля = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдКомплектации,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Комплектация);
						Если ЗначениеЗаполнено(КомплектацияАвтомобиля) Тогда
							НовАвто.ВариантКомплектации = КомплектацияАвтомобиля;
						КонецЕсли;
					КонецЕсли;				
					Наименование = "";
					Если ЗначениеЗаполнено(НовАвто.Модель) Тогда
						Наименование = Наименование + СокрЛП(НовАвто.Модель.Наименование);
					КонецЕсли;
					Если ЗначениеЗаполнено(VIN) Тогда
						Если Не ПустаяСтрока(Наименование) Тогда
							Наименование = Наименование + " ";
						КонецЕсли;  
						Наименование = Наименование + "VIN " + СокрЛП(VIN);
					КонецЕсли;
					Если Не ПустаяСтрока(Наименование) Тогда
						НовАвто.Наименование = Наименование; 
					КонецЕсли; 
					Попытка
						НовАвто.Записать();
						ОбДокумент.Автомобиль = НовАвто.Ссылка;   
					Исключение
					КонецПопытки;   				
				КонецЕсли; 
				Если ЗначениеЗаполнено(ОбДокумент.Автомобиль) Тогда
					Попытка 
						Если ПаспортАвтомобиля <> Неопределено Тогда
							ТехПаспорт = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ОбДокумент.Автомобиль,Перечисления.ДополнительнаяИнформацияАвтомобилей.ТехПаспорт); 
							Если Не ЗначениеЗаполнено(ТехПаспорт) И ЗначениеЗаполнено(ПаспортАвтомобиля.number) Тогда
								ТехПаспорт = Справочники.ПодтверждающиеДокументы.СоздатьЭлемент();  
								ТехПаспорт.ВидПодтверждающегоДокумента = Перечисления.ВидыДокументов.ПТС;
								НомерПТС = СтрЗаменить(ПаспортАвтомобиля.number," ","");
								ТехПаспорт.Серия = Лев(НомерПТС,4);
								ТехПаспорт.Номер = Сред(НомерПТС,5);
								ТехПаспорт.ДатаВыдачи = Инфотек_ОбщиеПроцедуры.СтрокаВДатуВремя(ПаспортАвтомобиля.issuedAt,"dd.mm.yyyy");
								ТехПаспорт.КемВыдан = ПаспортАвтомобиля.issuedBy;
								ТехПаспорт.Владелец = ОбДокумент.Автомобиль;   
								ТехПаспорт.Организация = НастройкаПодключения.Организация; 
