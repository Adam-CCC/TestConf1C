		Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада,Идентификатор);	
	КонецЕсли;
	
	СтруктураПередачи = СформироватьСтруктуруВходнойЦеныАвтомобиляПоОписанию(Описание,НастройкаПодключения);
	Результат = Ложь;
	
	//PUT /warehouseVehicle/updateFromRef
	
	Запрос = "/yii/api/warehouseVehicle/updateFromRef";
	ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураПередачи,Истина);
	
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Запрос = Запрос+"/"+Формат(Идентификатор,"ЧГ=0");
		Ответ = Инфотек_Запросы.PUTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);
	Иначе
		Возврат Результат;
	КонецЕсли;	
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		Результат = Истина;
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			СтруктураРезультата = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);		
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,Автомобиль,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.АвтомобильСклада,ИдентификаторВСтроку(СтруктураРезультата.result.id));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
