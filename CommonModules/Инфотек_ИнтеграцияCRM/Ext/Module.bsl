// Функция создает/обновляет данные по контрагенту из CRM     
//                           
// Параметры:
//  СтруктураКлиент - Структура - Обращение полученное из CRM.  
// Возвращаемое значение:
//  Контрагент - ссылка на элемент справочника контрагенты.  
//
Функция СоздатьОбновитьКонтрагента(СтруктураКлиент, НастройкаПодключения) Экспорт           
	Тип = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураКлиент.type);		
	
	Если Найти(Тип, "individual") <> 0 Тогда
		СтруктураФизЛицо =  СтруктураКлиент.primaryPerson;
		МассивТелефоны   =  СтруктураФизЛицо.phones;
		
		црмКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		Контрагент    = Справочники.Контрагенты.ПустаяСсылка();
		
		Фамилия       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
		Имя           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
		Отчество      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
		Пол           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.gender);
		ДатаРожд      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.birthday);
		Наименование  = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
		
		Для Каждого Эл из МассивТелефоны Цикл
			Если ЗначениеЗаполнено(Эл.number) Тогда     
				црмКонтрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоНомеруТелефонаФИО(Эл.number,Наименование);
				Если ЗначениеЗаполнено(црмКонтрагент) Тогда  
					Контрагент = црмКонтрагент;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если обЗначениеНеЗаполнено(Контрагент) Тогда
			црмКонтрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоФИОДатеРождения(Наименование,ДатаРожд);  
			Если ЗначениеЗаполнено(црмКонтрагент) Тогда
				Контрагент = црмКонтрагент; 
			КонецЕсли;
		КонецЕсли;
		
		НовыйКонтрагент = Ложь;	
		Если обЗначениеНеЗаполнено(Контрагент) Тогда		
			НовКонтрагент = Справочники.Контрагенты.СоздатьЭлемент(); 
			НовыйКонтрагент = Истина;	
			НовКонтрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;			
			НовКонтрагент.Фамилия  = Фамилия;
			НовКонтрагент.Имя      = Имя;
			НовКонтрагент.Отчество = Отчество;	
			НовКонтрагент.Наименование = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
			НовКонтрагент.НаименованиеПолное = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
			ДатаРождения = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(ДатаРожд);
			НовКонтрагент.ДатаРождения = ДатаРождения;      
			НовКонтрагент.РекламныйИсточник = Справочники.ИсточникиИнформации.ЛичныйВизит; 
			НовКонтрагент.УстановитьНовыйКод();
			Если ЗначениеЗаполнено(НастройкаПодключения.ГруппаКонтрагентовФизическиеЛица) Тогда
				НовКонтрагент.Родитель = НастройкаПодключения.ГруппаКонтрагентовФизическиеЛица;	
			КонецЕсли;   
			НовКонтрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель; 			
			
		Иначе
			НовКонтрагент = Контрагент.ПолучитьОбъект(); 
			Если НЕ ЗначениеЗаполнено(НовКонтрагент.Фамилия) И ЗначениеЗаполнено(Фамилия) Тогда
				НовКонтрагент.Фамилия  = Фамилия;
				НовКонтрагент.Наименование = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
				НовКонтрагент.НаименованиеПолное = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(НовКонтрагент.Имя) И ЗначениеЗаполнено(Имя) Тогда
				НовКонтрагент.Имя  = Имя;
				НовКонтрагент.Наименование = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
				НовКонтрагент.НаименованиеПолное = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(НовКонтрагент.Отчество) И ЗначениеЗаполнено(Отчество) Тогда
				НовКонтрагент.Отчество  = Отчество;
				НовКонтрагент.Наименование = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
				НовКонтрагент.НаименованиеПолное = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
			КонецЕсли; 
			Если НЕ ЗначениеЗаполнено(НовКонтрагент.ДатаРождения) И ЗначениеЗаполнено(ДатаРожд) Тогда
				ДатаРождения = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(ДатаРожд);
				НовКонтрагент.ДатаРождения = ДатаРождения; 
			КонецЕсли;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Пол) Тогда
			НовКонтрагент.Пол = ?(Пол = "M",Перечисления.ПолФизическихЛиц.Мужской,Перечисления.ПолФизическихЛиц.Женский);
		Иначе
			Если Найти(нрег(Прав(Отчество,3)),"вич") Тогда
				НовКонтрагент.Пол = Перечисления.ПолФизическихЛиц.Мужской;
			ИначеЕсли Найти(нрег(Прав(Отчество,3)),"вна") Тогда
				НовКонтрагент.Пол = Перечисления.ПолФизическихЛиц.Женский;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураФизЛицо.consentProcessingPersonalInformation) Тогда
			Если СтруктураФизЛицо.consentProcessingPersonalInformation = "1" Тогда
				НовКонтрагент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да;
			Иначе
				НовКонтрагент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Нет;
			КонецЕсли;
		Иначе
			НовКонтрагент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Спрашивать;
		КонецЕсли;	 
		
		Если ЗначениеЗаполнено(СтруктураФизЛицо.consentObtainingSmsMailing) Тогда
			Если СтруктураФизЛицо.consentObtainingSmsMailing = "1" Тогда
				НовКонтрагент.СогласиеНаПолучениеSMS = Истина;
			Иначе
				НовКонтрагент.СогласиеНаПолучениеSMS = Ложь;
			КонецЕсли;
		КонецЕсли;	

		Для Каждого Эл Из МассивТелефоны Цикл
			СтруктураЗаписи = Новый структура();
			
			ОсновнойТелефон = Эл.number;
			ТипТелефона     = Эл.type; //1 - рабочий, 2 - мобильный, 3 - факс, 4 - домашний
			Если ТипТелефона = "1" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий;
			иначеЕсли ТипТелефона = "2" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
			иначеЕсли ТипТелефона = "3" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.Факс;
			иначеЕсли ТипТелефона = "4" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонДомашний;
			КонецЕсли;
					
			КодСтраны = Лев(ОсновнойТелефон,1);
			СтруктураЗаписи.Вставить("Поле1","+"+КодСтраны);
			
			КодГорода = Сред(ОсновнойТелефон,2,3);
			СтруктураЗаписи.Вставить("Поле2",КодГорода);
			
			НомерТелефона = Сред(ОсновнойТелефон,5);
			СтруктураЗаписи.Вставить("Поле3", НомерТелефона);
			
			СтруктураЗаписи.Вставить("Представление", "+" + КодСтраны + ", " + КодГорода + НомерТелефона);
			НовКонтрагент.ОсновнойТелефон = СтруктураЗаписи.Представление;
			
			НовКонтрагент.ОбменДанными.Загрузка = Истина;
			НовКонтрагент.Записать();
			
			СтруктураЗаписи.Вставить("Объект", НовКонтрагент.Ссылка);
			СтруктураЗаписи.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
			СтруктураЗаписи.Вставить("Вид", ВидТелефона);
			СтруктураЗаписи.Вставить("ЗначениеПоУмолчанию", Истина);

			ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "КонтактнаяИнформация");   
		КонецЦикла;
		
		Контрагент = НовКонтрагент.Ссылка;
		
		email = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.email);
		Если ЗначениеЗаполнено(email) Тогда
			СтруктураЗаписи = Новый структура();
			СтруктураЗаписи.Вставить("Объект",Контрагент);
			СтруктураЗаписи.Вставить("Тип",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
			СтруктураЗаписи.Вставить("Вид",Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
			СтруктураЗаписи.Вставить("Представление",email);
			ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "КонтактнаяИнформация");
		КонецЕсли;
		
		Если СтруктураФизЛицо.Свойство("address") Тогда 
			СтруктураАдрес = СтруктураФизЛицо.address;
			ЗаписатьАдрес(СтруктураАдрес, Контрагент, Справочники.ВидыКонтактнойИнформации.АдресФактический);
		КонецЕсли;
		
		
		//Вод.удостоверение
		ВодПраваНомер      = СтруктураФизЛицо.driverLicenseNumber;
		ВодПраваДатаВыдачи = СтруктураФизЛицо.driverLicenseIssuedAt;
		ВодПраваВыданы     = СтруктураФизЛицо.driverLicenseIssuedBy;
		ЗапросВодПрава = Новый Запрос;
		ЗапросВодПрава.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.Владелец = &Контрагент
		|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Удостоверение)";
		ЗапросВодПрава.УстановитьПараметр("Контрагент", Контрагент);
		РезультатВодПрава = ЗапросВодПрава.Выполнить();
		Если РезультатВодПрава.Пустой() Тогда		
			Если ЗначениеЗаполнено(ВодПраваНомер) И ЗначениеЗаполнено(ВодПраваВыданы)
				И ЗначениеЗаполнено(ВодПраваДатаВыдачи) Тогда
				НовыйПодтверждающийДокумент = Справочники.ПодтверждающиеДокументы.СоздатьЭлемент();
				НовыйПодтверждающийДокумент.Владелец = Контрагент;      
				НовыйПодтверждающийДокумент.ВидПодтверждающегоДокумента = Перечисления.ВидыДокументов.Удостоверение;
				НовыйПодтверждающийДокумент.Номер = ВодПраваНомер;
				НовыйПодтверждающийДокумент.ДатаВыдачи = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(ВодПраваДатаВыдачи);
				НовыйПодтверждающийДокумент.КемВыдан =  ВодПраваВыданы;
				НовыйПодтверждающийДокумент.УстановитьНовыйКод();
				НовыйПодтверждающийДокумент.Наименование = НовыйПодтверждающийДокумент.СформироватьНаименование();
				НовыйПодтверждающийДокумент.Записать();
			КонецЕсли;
		КонецЕсли;  
		
		//Паспорт
		Паспорт_Серия      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.passportSeries);
		Паспорт_Номер      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.passportNumber);
		Паспорт_ДатаВыдачи = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.passportIssuedAt);
		Паспорт_Выдан      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.passportIssuedBy);
		ПаспортКодПодразд  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.passportDepartmentCode);
		ЗапросПаспорт = Новый Запрос;
		ЗапросПаспорт.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.Владелец = &Контрагент
		|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт)";
		ЗапросПаспорт.УстановитьПараметр("Контрагент", Контрагент);
		РезультатПаспорт = ЗапросПаспорт.Выполнить();
		Если РезультатПаспорт.Пустой() Тогда			
			Если ЗначениеЗаполнено(Паспорт_Серия) И ЗначениеЗаполнено(Паспорт_Номер)
				И ЗначениеЗаполнено(Паспорт_Выдан) И ЗначениеЗаполнено(Паспорт_ДатаВыдачи) Тогда
				НовыйПодтверждающийДокумент = Справочники.ПодтверждающиеДокументы.СоздатьЭлемент();
				НовыйПодтверждающийДокумент.Владелец = Контрагент;
				НовыйПодтверждающийДокумент.ВидПодтверждающегоДокумента = Перечисления.ВидыДокументов.Паспорт;
				НовыйПодтверждающийДокумент.Серия = Паспорт_Серия;
				НовыйПодтверждающийДокумент.Номер = Паспорт_Номер;
				НовыйПодтверждающийДокумент.ДатаВыдачи = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(Паспорт_ДатаВыдачи);
				НовыйПодтверждающийДокумент.КемВыдан =  Паспорт_Выдан;
				НовыйПодтверждающийДокумент.УстановитьНовыйКод();
				НовыйПодтверждающийДокумент.Наименование = НовыйПодтверждающийДокумент.СформироватьНаименование();
				НовыйПодтверждающийДокумент.Записать();
			КонецЕсли;
		КонецЕсли;   
		
	ИначеЕсли Найти(Тип, "business") <> 0 Тогда
		црмКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		Контрагент    = Справочники.Контрагенты.ПустаяСсылка();
		
		СтруктураОрганизация =  СтруктураКлиент.company;
		
		НаименованиеКомпании = СтруктураОрганизация.name;
		email  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.email);
		ИНН    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.inn);
		КПП    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.kpp);
		ОКПО   = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураОрганизация.ogrn); 
		
		МассивТелефоны  = СтруктураОрганизация.phones;  
		Если МассивТелефоны.Количество() = 0 Тогда 
			СтруктураФизЛицо =  СтруктураКлиент.primaryPerson;
			МассивТелефоны   =  СтруктураФизЛицо.phones;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИНН) Тогда
			ЦрмКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИНН);
		КонецЕсли;

		Если ЗначениеЗаполнено(ОКПО) И обЗначениеНеЗаполнено(ЦрмКонтрагент) Тогда
			ЦрмКонтрагент = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоОКПО", ОКПО);
		КонецЕсли;
		
		Если обЗначениеНеЗаполнено(ЦрмКонтрагент) Тогда
			//Создаем
			НовКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовКонтрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;
			НовКонтрагент.Наименование       = НаименованиеКомпании;
			НовКонтрагент.НаименованиеПолное = НаименованиеКомпании;
			НовКонтрагент.КодПоОКПО          = ОКПО;
			НовКонтрагент.ИНН                = ИНН;
			НовКонтрагент.КПП                = КПП;
			НовКонтрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
			НовКонтрагент.РекламныйИсточник = Справочники.ИсточникиИнформации.ЛичныйВизит;
			Если ЗначениеЗаполнено(НастройкаПодключения.ГруппаКонтрагентовЮридическиеЛица) Тогда
				НовКонтрагент.Родитель = НастройкаПодключения.ГруппаКонтрагентовЮридическиеЛица;	
			КонецЕсли;
			НовКонтрагент.УстановитьНовыйКод();
			НовКонтрагент.ОбменДанными.Загрузка = Истина;
			НовКонтрагент.Записать();
			Контрагент = НовКонтрагент.Ссылка;
			
		Иначе
			Контрагент = ЦрмКонтрагент;
		КонецЕсли;
		
		Если СтруктураОрганизация.Свойство("address") Тогда 
			СтруктураАдрес = СтруктураОрганизация.address;
			ЗаписатьАдрес(СтруктураАдрес, Контрагент, Справочники.ВидыКонтактнойИнформации.АдресФактический);
		КонецЕсли;
		Если СтруктураОрганизация.Свойство("juridicalAddress") Тогда 
			СтруктураАдрес = СтруктураОрганизация.juridicalAddress;
			ЗаписатьАдрес(СтруктураАдрес, Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
		КонецЕсли;
		
		ОсновнойТелефон = "";
		Для Каждого Эл Из МассивТелефоны Цикл
			СтруктураЗаписи = Новый Структура();
			
			ОсновнойТелефон = Эл.number;
			ТипТелефона     = Эл.type; //1 - рабочий, 2 - мобильный, 3 - факс, 4 - домашний
			Если ТипТелефона = "1" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий;
			иначеЕсли ТипТелефона = "2" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
			иначеЕсли ТипТелефона = "3" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.Факс;
			иначеЕсли ТипТелефона = "4" Тогда
				ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонДомашний;
			КонецЕсли;
			
			СтруктураЗаписи.Вставить("Объект", Контрагент);
			СтруктураЗаписи.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
			
			СтруктураЗаписи.Вставить("Вид", ВидТелефона);
			СтруктураЗаписи.Вставить("ЗначениеПоУмолчанию", Истина);
			
			КодСтраны = Лев(ОсновнойТелефон,1);
			СтруктураЗаписи.Вставить("Поле1","+"+КодСтраны);
			
			КодГорода = Сред(ОсновнойТелефон,2,3);
			СтруктураЗаписи.Вставить("Поле2",КодГорода);
			
			НомерТелефона = Сред(ОсновнойТелефон,5);
			СтруктураЗаписи.Вставить("Поле3",НомерТелефона);
			
			СтруктураЗаписи.Вставить("Представление", "+" + КодСтраны + ", " + КодГорода + НомерТелефона);
			ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "КонтактнаяИнформация");   
			ОсновнойТелефон = СтруктураЗаписи.Представление;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОсновнойТелефон) Тогда
			ОбКонтрагент = Контрагент.ПолучитьОбъект();		
			ОбКонтрагент.ОсновнойТелефон = ОсновнойТелефон;
			ОбКонтрагент.ОбменДанными.Загрузка = Истина;
			ОбКонтрагент.Записать();
		КонецЕсли;
	КонецЕсли;		     
	
	Возврат Контрагент;
КонецФункции

