	КонецЕсли;
	
	Если ЭтапыРЛ.Количество() = 0 Тогда
		Сообщить("Не найдены этапы рабочего листа в CRM системе! Проверьте наличие этапов в рабочем листе, либо принадлежность автосалона CRM учетной записи настройки подключения в 1С!");
		Возврат Результат;
	КонецЕсли;
	
	Если ЗаказНаАвтомобиль.ХозОперация = Справочники.ХозОперации.ЗаказНаАвтомобильИзменение Тогда
		Для Каждого ЭлМассива Из ЭтапыРЛ Цикл
			ИДЭтапа = ИдентификаторВСтроку(ЭлМассива.id); 
			Если ИдентификаторВСтроку(ЭлМассива.type) = "11" И ИдентификаторВСтроку(ЭлМассива.state) <> "4" Тогда		   
				Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
					Запрос = "/yii/api/retailStage/cancel?id=" + ИДЭтапа;	
				ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда 
					Запрос = "/yii/api/CorporateCase/cancel?id=" + ИДЭтапа;	
				Иначе
					Запрос = "/yii/api/SaleUsedStage/cancel?id=" + ИДЭтапа;	
				КонецЕсли;
				СтруктураДанных = Новый Структура(); 
				Попытка
					ИдентификаторПричиныОтказа = Строка(НастройкаПодключения.ИдентфикаторПричиныОтказаОтКонтрактаПоУмолчанию);
					Если Не ЗначениеЗаполнено(ИдентификаторПричиныОтказа) Тогда
						СтруктураДанных.Вставить("resultId","18");
					Иначе
						СтруктураДанных.Вставить("resultId",ИдентификаторПричиныОтказа);    
					КонецЕсли;
				Исключение			
					СтруктураДанных.Вставить("resultId","18"); 
				КонецПопытки;	
				СтруктураДанных.Вставить("comment","Передан из 1С: документ отмена заказа на автомобиль № " + ЗаказНаАвтомобиль.ДокументОснование.Номер + " от " + Формат(ЗаказНаАвтомобиль.ДокументОснование.Дата,"ДФ=dd.MM.yyyy")); 
				
				ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураДанных,Истина);
				Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);				
				Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
					Результат = Истина;
				Иначе
					Результат = Ложь;
					Сообщить(Ответ.ПолучитьТелоКакСтроку());
				КонецЕсли; 
				ЕстьДоговор = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
	
	Потребность = "";
	Попытка
		МассивПотребностей = СтруктураРабочегоЛиста.result.needs; 
		Для Каждого СтрокаПотребности Из МассивПотребностей Цикл
			Если ЗначениеЗаполнено(ЗаказНаАвтомобиль.Автомобиль.VIN) Тогда
				Если СтрокаПотребности.VIN = ЗаказНаАвтомобиль.Автомобиль.VIN Тогда
					Потребность = ИдентификаторВСтроку(СтрокаПотребности.id); 
				КонецЕсли;
			Иначе
				Потребность = ИдентификаторВСтроку(СтрокаПотребности.id);
			КонецЕсли;
		КонецЦикла;
	Исключение 
	КонецПопытки;
	Если ЗначениеЗаполнено(ЗаказНаАвтомобиль.Автомобиль) И Не ЗначениеЗаполнено(Потребность) И ЗаказНаАвтомобиль.ПометкаУдаления = Ложь Тогда
		Сообщить("Проведение невозможно! Не соответствие потребности заказа на автомобиль и рабочего листа № " + id_CRM);  
		Результат = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	Если ЕстьДоговор = Ложь И ЗначениеЗаполнено(Потребность) И ЗаказНаАвтомобиль.ХозОперация <> Справочники.ХозОперации.ЗаказНаАвтомобильОтмена И ЗаказНаАвтомобиль.ПометкаУдаления = Ложь Тогда
		//Контракт планирование этапа             
		Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
			Запрос = "/yii/api/retailStage/schedule?id=" + id_CRM + "&type=11";	 
		ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда 
			Запрос = "/yii/api/CorporateCase/schedule?id=" + id_CRM + "&type=11";	 
		Иначе
			Запрос = "/yii/api/SaleUsedStage/schedule?id=" + id_CRM + "&type=11";	
		КонецЕсли;
		СтруктураДанных = Новый Структура();       
		Если НачалоДня(ТекущаяДата()) > НачалоДня(ЗаказНаАвтомобиль.Дата) Тогда
			СтруктураДанных.Вставить("scheduleAt",Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ТекущаяДата()),"ДФ=ЧЧ:мм"));
		Иначе	
			СтруктураДанных.Вставить("scheduleAt",Формат(ЗаказНаАвтомобиль.Дата,"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ЗаказНаАвтомобиль.Дата),"ДФ=ЧЧ:мм"));
		КонецЕсли;
		СтруктураДанных.Вставить("objectKey","2/" + Потребность);  
		Если ЗначениеЗаполнено(ЗаказНаАвтомобиль.Комментарий) Тогда
			СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ЗаказНаАвтомобиль.Номер + " от " + Формат(ЗаказНаАвтомобиль.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + ЗаказНаАвтомобиль.Комментарий);
		Иначе
			СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ЗаказНаАвтомобиль.Номер + " от " + Формат(ЗаказНаАвтомобиль.Дата,"ДФ=dd.MM.yyyy")); 	
		КонецЕсли;				
		ИдентификаторСотрудника = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ЗаказНаАвтомобиль.Менеджер,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
		Если ЗначениеЗаполнено(ИдентификаторСотрудника) Тогда
			СтруктураДанных.Вставить("assistantId",ИдентификаторСотрудника);
		КонецЕсли;
		ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураДанных,Истина);
		Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);				
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			Результат = Истина;
		Иначе
			Результат = Ложь;
			Сообщить(Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли; 
		ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,НастройкаПодключения);   
	КонецЕсли;
	
	Для Каждого ЭлМассива Из ЭтапыРЛ Цикл
		Если ИдентификаторВСтроку(ЭлМассива.type) = "11" И ИдентификаторВСтроку(ЭлМассива.state) <> "4" Тогда		   
			ИДЭтапа = ИдентификаторВСтроку(ЭлМассива.id); 
			ИДПотребности = ИдентификаторВСтроку(ЭлМассива.need_id);
			ИДМенеджера = ИдентификаторВСтроку(ЭлМассива.assigneeId);
			//Контракт завершение этапа или отмена этапа   
			Если (ЗаказНаАвтомобиль.ХозОперация = Справочники.ХозОперации.ЗаказНаАвтомобильОтмена И ЗаказНаАвтомобиль.ПометкаУдаления = Ложь) Тогда         
				Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
					Запрос = "/yii/api/retailStage/cancel?id=" + ИДЭтапа;	
				ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда 
					Запрос = "/yii/api/CorporateCase/cancel?id=" + ИДЭтапа;	
				Иначе
					Запрос = "/yii/api/SaleUsedStage/cancel?id=" + ИДЭтапа;	
				КонецЕсли;
				СтруктураДанных = Новый Структура(); 
				Попытка
					ИдентификаторПричиныОтказа = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ЗаказНаАвтомобиль.ДокументОснование.ДокументОснование.ПричинаОтказа,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ПричинаОтказа);
					Если Не ЗначениеЗаполнено(ИдентификаторПричиныОтказа) Тогда
						СтруктураДанных.Вставить("resultId","18");
					Иначе
						СтруктураДанных.Вставить("resultId",ИдентификаторПричиныОтказа);    
					КонецЕсли;
				Исключение			
					СтруктураДанных.Вставить("resultId","18"); 
				КонецПопытки;	
				СтруктураДанных.Вставить("comment","Передан из 1С: документ отмена заказа на автомобиль № " + ЗаказНаАвтомобиль.Номер + " от " + Формат(ЗаказНаАвтомобиль.Дата,"ДФ=dd.MM.yyyy")); 
				
			Иначе 
				Если ЭлМассива.state = "3" Тогда
					Сообщить("Этап рабочего листа Контракт уже закрыт: " + ЭлМассива.closedAt);
					Возврат Истина;
				КонецЕсли;
				
				Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
					СтруктураПотребности = ПолучитьСтруктуруПотребностиПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.need_id),НастройкаПодключения);   
				ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда
					СтруктураПотребности = ПолучитьСтруктуруКорпоративнойПотребностиПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.need_id),НастройкаПодключения);   					
				Иначе	
					СтруктураПотребности = ПолучитьСтруктуруБУПотребностиПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.need_id),НастройкаПодключения);
				КонецЕсли;
				Если СтруктураПотребности.result.VIN <> ЗаказНаАвтомобиль.Автомобиль.VIN И НастройкаПодключения.ПроверятьСоответствиеVIN = Истина Тогда	
					Сообщить("Проведение невозможно! Не соответствие потребности заказа на автомобиль и рабочего листа № " + id_CRM); 
