//
Функция ПолучитьИдентфикаторЗаказНарядаПоКоду(Код,НастройкаПодключения) Экспорт
	
	Идентификатор = "";
	
	//GET /purchase
	Запрос = "/yii/api/purchase?number=" + Инфотек_Запросы.СтрокаВФорматеURL(Код);
	
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос,НастройкаПодключения);
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		МассивРезультата = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);
		
		Если МассивРезультата.Количество()=0 Тогда
			Возврат Идентификатор;
		КонецЕсли;
		
		СтруктураРезультата = МассивРезультата[0];
		
		Если Не СтруктураРезультата.Свойство("id") Тогда
			Возврат Идентификатор;
		КонецЕсли;
		
		Идентификатор = СтруктураРезультата.id;
		
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Функция получения структуры обращения из CRM системы по идентификатору
//                           
// Параметры:   
//  id_Обращения_CRM     - Строка - ID обращения CRM.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  СтруктураРезультата - Структура реквизитов.
//
Функция ПолучитьСтруктуруОбращенияПоИдентификатору(id_Обращения_CRM,НастройкаПодключения) Экспорт
	
	//GET /preparedServiceCase	
	Запрос = "/yii/api/preparedServiceCase/"+id_Обращения_CRM;
	Ответ = Инфотек_Запросы.GETЗапрос(Запрос,НастройкаПодключения);
	СтруктураРезультата = Неопределено;
	
	Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
		СтруктураРезультата = Инфотек_JSON.мПрочитатьJSON(Ответ.ПолучитьТелоКакСтроку(),Истина);        
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции

// Процедура заполнения заявки на ремонт по структуре обращения из CRM 
//                           
// Параметры:   
//  СтруктураРезультата - Структура - Обращение из CRM.
//  ОбДокумент          - ДокументОбъект.ЗаявкаНаРемонт - Объект документ заявка на ремонт.
//  ОбДокументФорма     - Форма - Форма документа заявка на ремонт.
//
Процедура ОбработатьСтруктуруЗаполнитьРеквизитыЗаявки(СтруктураРезультата,НастройкаПодключения,ОбДокумент,ОбДокументФорма,Контрагент = Неопределено,Автомобиль = Неопределено) Экспорт
	
	ОбДокумент.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ОбДокумент.Заказчик   = Справочники.Контрагенты.ПустаяСсылка();
	ОбДокумент.ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	ОбДокумент.Работы.Очистить();
	ЕстьАвтомобиль = Ложь;
	Если ЗначениеЗаполнено(Автомобиль) И ТипЗнч(Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда
		ЕстьАвтомобиль = Истина;
	КонецЕсли;
	ЕстьКонтрагент = Ложь;
	Если ЗначениеЗаполнено(Контрагент) И ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		ЕстьКонтрагент = Истина;
	КонецЕсли;
	
	НовДоговор = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	црмКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	Если СтруктураРезультата.success Тогда
		
		
		црмРезультат = СтруктураРезультата.result;
		
		СтруктураКлиент = црмРезультат.generalClient;
		
		
		СтруктураАвто = црмРезультат.clientVehicle;
		VIN           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.vin);
		ГосНомер      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.reg_number);
		ГодВыпуска    = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.production_year);
		Пробег        = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.mileage);
		ИДАвтом       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.id);
		ДатаНачалаГарантии = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.warranty_start_at);
		ДатаКонцаГарантии = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.warranty_end_at);
		
		СтруктураМодель = СтруктураАвто.model;
		ИдМодели      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураМодель.id);
		НаименованиеМодели      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.brand.name) + " " + Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураМодель.name);
		ИдМарки       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.brand_id);
		
		Авто = Справочники.Автомобили.ПустаяСсылка();
		
		Если (ЗначениеЗаполнено(VIN) Или ЗначениеЗаполнено(ГосНомер)) И ЕстьАвтомобиль = Ложь Тогда
			ЗапросАвто = Новый Запрос();
			ЗапросАвто.УстановитьПараметр("парДатаЗаписи",ТекущаяДата());
			ЗапросАвто.Текст = 
			"ВЫБРАТЬ
			|	Авто.Ссылка КАК Ссылка,
			|	Авто.VIN КАК VIN,
			|	РС.Значение КАК ГосНомер
			|ИЗ
			|	Справочник.Автомобили КАК Авто
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&парДатаЗаписи, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК РС
			|		ПО (РС.Автомобиль = Авто.Ссылка)
			|ГДЕ
			|	НЕ Авто.ПометкаУдаления
			|	И НЕ Авто.ЭтоГруппа
			|  "+?(ЗначениеЗаполнено(ГосНомер),"И РС.Значение ПОДОБНО ""%"" + &ГосНомер + ""%""","")+"
			|	И Авто.VIN ПОДОБНО ""%"" + &VIN + ""%""";
			
			ЗапросАвто.УстановитьПараметр("VIN","%"+VIN+"%");
			ЗапросАвто.УстановитьПараметр("ГосНомер","%"+ГосНомер+"%");
			РезАвто = ЗапросАвто.Выполнить().Выбрать();
			Пока РезАвто.Следующий() Цикл
				Авто = РезАвто.Ссылка;
				Прервать;
			КонецЦикла;		 
		ИначеЕсли ЕстьАвтомобиль = Истина Тогда
			Авто = Автомобиль;	
		КонецЕсли;
		
		ИдКлиента = СтруктураКлиент.id;
		
		Тип = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураКлиент.type);
		
		Если Найти(Тип, "individual") <> 0 И ЕстьКонтрагент = Ложь Тогда
			
			СтруктураФизЛицо =  СтруктураКлиент.primaryPerson;
			МассивТелефоны   =  СтруктураФизЛицо.phones;
			
			црмКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
			Контрагент    = Справочники.Контрагенты.ПустаяСсылка();
			Фамилия       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
			Имя           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
			Отчество      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
			Наименование  = СокрЛП(Фамилия + " " + Имя + " " + Отчество);
			ДатаРожд      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.birthday);
			
			Для Каждого Эл из МассивТелефоны Цикл
				Если ЗначениеЗаполнено(Эл.number) Тогда     
					црмКонтрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоНомеруТелефонаФИО(Эл.number,Наименование);
					Если црмКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
						црмКонтрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоНомеруТелефона(Эл.number);  
						Если црмКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
							црмКонтрагент = Инфотек_ИнтеграцияCRMПереопределяемый.НайтиПоФИОДатеРождения(Наименование,ДатаРожд);			 
						КонецЕсли; 	
						Если Не црмКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
							Контрагент = црмКонтрагент; 
							Прервать;
						КонецЕсли;   
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			//по авто
			Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
				
				НовКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
				
				НовКонтрагент.Фамилия     = Фамилия;
				НовКонтрагент.Имя         = Имя;
				НовКонтрагент.Отчество    = Отчество;			
				Пол                       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.gender);
				НовКонтрагент.РекламныйИсточник = Справочники.ИсточникиИнформации.НайтиПоКоду("ЦБ000003"); 			
				НовКонтрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
				НовКонтрагент.Наименование = СокрЛП(НовКонтрагент.Фамилия + " " + НовКонтрагент.Имя + " " + НовКонтрагент.Отчество);
				НовКонтрагент.НаименованиеПолное = СокрЛП(НовКонтрагент.Фамилия + " " + НовКонтрагент.Имя + " " + НовКонтрагент.Отчество);
				Если ЗначениеЗаполнено(Пол) Тогда
					НовКонтрагент.Пол = ?(Пол = "M",Перечисления.ПолФизическихЛиц.Мужской,Перечисления.ПолФизическихЛиц.Женский);
				Иначе
					Если Найти(нрег(Прав(НовКонтрагент.Отчество,3)),"вич") Тогда
						НовКонтрагент.Пол = Перечисления.ПолФизическихЛиц.Мужской;
					ИначеЕсли Найти(нрег(Прав(НовКонтрагент.Отчество,3)),"вна") Тогда
						НовКонтрагент.Пол = Перечисления.ПолФизическихЛиц.Женский;
					КонецЕсли;
				КонецЕсли;
				
				ДатаРождения = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(ДатаРожд);
				
				НовКонтрагент.ДатаРождения = ДатаРождения; 
				НовКонтрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель; 
				НовКонтрагент.УстановитьНовыйКод();
				Если ЗначениеЗаполнено(СтруктураФизЛицо.consentProcessingPersonalInformation) Тогда
					Если СтруктураФизЛицо.consentProcessingPersonalInformation = "1" Тогда
						НовКонтрагент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да;
					Иначе
						НовКонтрагент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Нет;
					КонецЕсли;
				Иначе
					НовКонтрагент.СогласиеНаОбработкуПерсональныхДанных =  Перечисления.ВариантыОтветов.Спрашивать;
				КонецЕсли;	 
				Если СтруктураФизЛицо.consentObtainingSmsMailing = "1" Тогда
					НовКонтрагент.СогласиеНаПолучениеSMS = Истина;
				Иначе
					НовКонтрагент.СогласиеНаПолучениеSMS = Ложь;
				КонецЕсли;
				
				НовКонтрагент.Родитель = НастройкаПодключения.ГруппаКонтрагентовФизическиеЛица;
				СтруктураПоиска = Новый Структура("Код,Наименование,НаименованиеПолное, ИНН,ОсновнойТелефон",Неопределено,"=",Неопределено,Неопределено,Неопределено);
				НайденныеОбъекты  = обНайтиДубли(НовКонтрагент,СтруктураПоиска);
				Если НайденныеОбъекты.Количество() > 0 Тогда
					Для Каждого СтрокаКонтрагента Из НайденныеОбъекты Цикл
						НовКонтрагент = СтрокаКонтрагента.Ссылка;
					КонецЦикла;  
				Иначе
					Для Каждого Эл Из МассивТелефоны Цикл
						СтруктураЗаписи = Новый структура();
						
						ОсновнойТелефон = Эл.number;
						ТипТелефона     = Эл.type; //1 - рабочий, 2 - мобильный, 3 - факс, 4 - домашний
						Если ТипТелефона = "1" Тогда
							ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий;
						иначеЕсли ТипТелефона = "2" Тогда
							ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
						иначеЕсли ТипТелефона = "3" Тогда
							ВидТелефона = Справочники.ВидыКонтактнойИнформации.Факс;
						иначеЕсли ТипТелефона = "4" Тогда
							ВидТелефона = Справочники.ВидыКонтактнойИнформации.ТелефонДомашний;
						КонецЕсли;
						
						КодСтраны = Лев(ОсновнойТелефон,1);
						СтруктураЗаписи.Вставить("Поле1","+"+КодСтраны);
						
						КодГорода = Сред(ОсновнойТелефон,2,3);
						СтруктураЗаписи.Вставить("Поле2",КодГорода);
						
						НомерТелефона = Сред(ОсновнойТелефон,5);
						СтруктураЗаписи.Вставить("Поле3",НомерТелефона);
						
						СтруктураЗаписи.Вставить("Представление","+" + КодСтраны + " (" + КодГорода + ") " + НомерТелефона);
						ОсновнойТелефон = "+" + КодСтраны + " (" + КодГорода + ") " + НомерТелефона;   
						НовКонтрагент.ОсновнойТелефон = ОсновнойТелефон; 
						НовКонтрагент.Записать(); 
						Контрагент = НовКонтрагент.Ссылка;
						СтруктураЗаписи.Вставить("Объект",Контрагент);
						СтруктураЗаписи.Вставить("Тип",Перечисления.ТипыКонтактнойИнформации.Телефон);
						
						СтруктураЗаписи.Вставить("Вид",ВидТелефона);
						СтруктураЗаписи.Вставить("ЗначениеПоУмолчанию",Истина);
						
						ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "КонтактнаяИнформация");   
					КонецЦикла;
					//Договор
					НовДоговор = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
					НовДоговор.УстановитьНовыйКод();
					НовДоговор.Владелец      = НовКонтрагент.Ссылка;
					НовДоговор.ВидДоговора   = Перечисления.ВидыДоговоров.Продажа;
					НовДоговор.ВалютаВзаиморасчетов = обДокумент.ВалютаДокумента;
					НовДоговор.ВидОплаты     =  Перечисления.ВидыОплаты.ПроизвольнаяОплата;
					НовДоговор.ДатаНачала    = ТекущаяДата();
					НовДоговор.Организация = ОбДокумент.Организация;
					НовДоговор.Подразделение = ОбДокумент.ПодразделениеКомпании; 
					НовДоговор.ТипДоговора = Перечисления.ТипыДоговоров.Договор;
					НовДоговор.Основной = Истина;
					НовДоговор.ДляАвтосервиса = Истина;    
					НовДоговор.ЕдиницаИзмеренияАвтоработВПечатныхФормах = Перечисления.ЕдиницаИзмеренияАвтоработВПечатныхФормах.ЕдиницаИзмеренияПрочерк;
					СформироватьНаименование(НовДоговор); 
					Попытка
						НовДоговор.Записать();			
					Исключение
					КонецПопытки;   
				КонецЕсли;							
				
				Контрагент = НовКонтрагент.Ссылка;
				
				email       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.email);
				
				Если ЗначениеЗаполнено(email) Тогда
					СтруктураЗаписи = Новый структура();
					СтруктураЗаписи.Вставить("Объект",Контрагент);
					СтруктураЗаписи.Вставить("Тип",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
					СтруктураЗаписи.Вставить("Вид",Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
					СтруктураЗаписи.Вставить("Представление",email);
					ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "КонтактнаяИнформация");
				КонецЕсли;
				
				Если СтруктураФизЛицо.Свойство("address") Тогда 
					СтруктураАдрес = СтруктураФизЛицо.address;
					ЗаписатьАдрес(СтруктураАдрес, Контрагент, Справочники.ВидыКонтактнойИнформации.АдресФактический);
				КонецЕсли;
				
				
				//Вод.удостоверение
				ВодПраваНомер      = СтруктураФизЛицо.driverLicenseNumber;
				ВодПраваВыданы     = СтруктураФизЛицо.driverLicenseIssuedAt;
				ВодПраваДатаВыдачи = СтруктураФизЛицо.driverLicenseIssuedBy;
				
				//Паспорт
				Паспорт_Серия      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.passportSeries);
				Паспорт_Номер      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.passportNumber);
