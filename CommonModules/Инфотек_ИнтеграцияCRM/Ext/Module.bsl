// Отдел продаж

// Функция отправки запроса завершения выдачи по рабочему листу в CRM    
//                           
// Параметры:   
//  Реализация           - ДокументСсылка.РеализацияАвтомобилей - Ссылка на документ реализация автомобиля.  
//  Автомобиль           - СправочникСсылка.Автомобили - Ссылка на автомобиль реализации
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//  id_CRM               - Строка - Идентификатор рабочего листа.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция ПодтвердитьВыдачу(Реализация, Автомобиль, НастройкаПодключения, id_CRM) Экспорт
	Результат = Ложь;
	ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,НастройкаПодключения);  
	Если ЭтапыРЛ.Количество() = 0 Тогда
		ВыборкаНастроекПодключения = Справочники.Инфотек_НастройкиПодключения.Выбрать();
		Пока ВыборкаНастроекПодключения.Следующий() Цикл 
			Если ВыборкаНастроекПодключения.ПометкаУдаления = Ложь Тогда 
				ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,ВыборкаНастроекПодключения.Ссылка);
				Если ЭтапыРЛ.Количество() > 0 Тогда	
					НастройкаПодключения = ВыборкаНастроекПодключения.Ссылка; 
					Прервать;
				КонецЕсли;    
			КонецЕсли;  
		КонецЦикла;
	КонецЕсли;	
	
	Если ЭтапыРЛ.Количество() = 0 Тогда
		Сообщить("Не найдены этапы рабочего листа в CRM системе! Проверьте наличие этапов в рабочем листе, либо принадлежность автосалона CRM учетной записи настройки подключения в 1С!");
		Возврат Результат;
		
	Иначе
		ЕстьВыдача = Ложь;
		Для Каждого ЭлМассива Из ЭтапыРЛ Цикл
			Если ИдентификаторВСтроку(ЭлМассива.type) = "12" И ИдентификаторВСтроку(ЭлМассива.state) <> "4" Тогда
				ЕстьВыдача = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ЕстьДоговор = Ложь;
		Для Каждого ЭлМассива Из ЭтапыРЛ Цикл
			Если ИдентификаторВСтроку(ЭлМассива.type) = "11" И ИдентификаторВСтроку(ЭлМассива.state) <> "4" Тогда
				ЕстьДоговор = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли;
	
	РабочийЛистБУ = Ложь;	
	РабочийЛистКорпоративныхПродаж = Ложь;      
	
	СтруктураРабочегоЛиста = ПолучитьСтруктуруРабочегоЛистаПоИдентификатору(id_CRM,НастройкаПодключения);  
	Если СтруктураРабочегоЛиста = Неопределено Тогда     
		СтруктураРабочегоЛиста = ПолучитьСтруктуруРабочегоЛистаКорпоративныхПродажПоИдентификатору(id_CRM,НастройкаПодключения);  
		Если СтруктураРабочегоЛиста = Неопределено Тогда
			СтруктураРабочегоЛиста = ПолучитьСтруктуруРабочегоЛистаБУПоИдентификатору(id_CRM,НастройкаПодключения);  
			Если СтруктураРабочегоЛиста = Неопределено Тогда
				Сообщить("Не найден в CRM рабочий лист № " + id_CRM + "; " + " Закрытие этапа не произойдет!");
				Возврат Истина; 
			Иначе
				РабочийЛистБУ = Истина;
			КонецЕсли; 
		Иначе
			РабочийЛистКорпоративныхПродаж = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если РабочийЛистБУ = Истина И НастройкаПодключения.ЗакрытиеЭтаповРабочихЛистовБУCRM = Ложь Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если РабочийЛистБУ = Ложь И НастройкаПодключения.ЗакрытиеЭтаповРабочихЛистовCRM = Ложь Тогда
		Возврат Истина;
	КонецЕсли;                 
	
	Потребность = "";   
	Попытка
		МассивПотребностей = СтруктураРабочегоЛиста.result.needs; 
		Для Каждого СтрокаПотребности Из МассивПотребностей Цикл
			Если СтрокаПотребности.VIN = Автомобиль.VIN Тогда
				Потребность = ИдентификаторВСтроку(СтрокаПотребности.id);
			КонецЕсли;
		КонецЦикла;
	Исключение 
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Автомобиль) И Не ЗначениеЗаполнено(Потребность) И Реализация.ПометкаУдаления = Ложь Тогда
		Сообщить("Запись невозможна! Не соответствие автомобиля в Реализации автомобиля и в Рабочем листе CRM № " + id_CRM);  
		Возврат Истина;
	КонецЕсли;	
	
	Если ЕстьВыдача = Ложь  И ЗначениеЗаполнено(Потребность) И ЕстьДоговор = Истина И Реализация.ПометкаУдаления = Ложь Тогда
		//Выдача планирование этапа
		Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
			Запрос = "/yii/api/retailStage/schedule?id=" + id_CRM + "&type=12";	
		ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда  
			Запрос = "/yii/api/CorporateCase/schedule?id=" + id_CRM + "&type=12";				
		Иначе
			Запрос = "/yii/api/SaleUsedStage/schedule?id=" + id_CRM + "&type=12";	
		КонецЕсли;
		
		СтруктураДанных = Новый Структура();
		Если НачалоДня(ТекущаяДата()) > НачалоДня(Реализация.Дата) Тогда
			СтруктураДанных.Вставить("scheduleAt",Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ТекущаяДата()),"ДФ=ЧЧ:мм"));
		Иначе	
			СтруктураДанных.Вставить("scheduleAt",Формат(Реализация.Дата,"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(Реализация.Дата),"ДФ=ЧЧ:мм"));
		КонецЕсли;
		
		СтруктураДанных.Вставить("objectKey","2/" + Потребность);  
		Если ЗначениеЗаполнено(Реализация.Комментарий) Тогда
			СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + Реализация.Номер + " от " + Формат(Реализация.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + Реализация.Комментарий);
		Иначе
			СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + Реализация.Номер + " от " + Формат(Реализация.Дата,"ДФ=dd.MM.yyyy"));   
		КонецЕсли;
		
		ИдентификаторСотрудника = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Реализация.Менеджер,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
		Если ЗначениеЗаполнено(ИдентификаторСотрудника) Тогда
			СтруктураДанных.Вставить("assistantId",ИдентификаторСотрудника);
		КонецЕсли;
		
		ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураДанных,Истина);
		Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);				
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			Результат = Истина;
			ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,НастройкаПодключения);
			
		Иначе
			Результат = Ложь;
			Сообщить(Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли;   
		
	КонецЕсли;
	
	Для Каждого ЭлМассива Из ЭтапыРЛ Цикл
		Если ИдентификаторВСтроку(ЭлМассива.type) = "12" И ИдентификаторВСтроку(ЭлМассива.state) <> "4" Тогда
			ИДЭтапа       = ИдентификаторВСтроку(ЭлМассива.id); 
			ИДПотребности = ИдентификаторВСтроку(ЭлМассива.need_id);
			ИДМенеджера   = ИдентификаторВСтроку(ЭлМассива.assigneeId);	
			//Выдача завершение этапа
			Если Реализация.ПометкаУдаления = Истина Тогда         
				Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
					Запрос = "/yii/api/retailStage/cancel?id=" + ИДЭтапа;	
				ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда
					Запрос = "/yii/api/CorporateCase/cancel?id=" + ИДЭтапа;						
				Иначе
					Запрос = "/yii/api/SaleUsedStage/cancel?id=" + ИДЭтапа;	
				КонецЕсли;
				СтруктураДанных = Новый Структура(); 
				Если ЗначениеЗаполнено(Реализация.Комментарий) Тогда
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + Реализация.Номер + " от " + Формат(Реализация.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + Реализация.Комментарий);
				Иначе
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + Реализация.Номер + " от " + Формат(Реализация.Дата,"ДФ=dd.MM.yyyy"));   
				КонецЕсли;      
				Попытка
					ИдентификаторПричиныОтказа = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Реализация.ДокументОснование.ДокументОснование.ПричинаОтказа,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ПричинаОтказа);
					Если Не ЗначениеЗаполнено(ИдентификаторПричиныОтказа) Тогда
						СтруктураДанных.Вставить("resultId","18");
					Иначе
						СтруктураДанных.Вставить("resultId",ИдентификаторПричиныОтказа);    
					КонецЕсли;
				Исключение			
					СтруктураДанных.Вставить("resultId","18"); 
				КонецПопытки;
				
			Иначе
				Если ИдентификаторВСтроку(ЭлМассива.state) = "3" Тогда
					Сообщить("Этап Выдача рабочего листа закрыт: " + ЭлМассива.closedAt);
					Возврат Истина;
				КонецЕсли;
				
				Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
					СтруктураПотребности = ПолучитьСтруктуруПотребностиПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.need_id),НастройкаПодключения);   
				ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда
					СтруктураПотребности = ПолучитьСтруктуруКорпоративнойПотребностиПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.need_id),НастройкаПодключения);   					
				Иначе	
					СтруктураПотребности = ПолучитьСтруктуруБУПотребностиПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.need_id),НастройкаПодключения);
				КонецЕсли;
				
				Если СтруктураПотребности.result.VIN <> Автомобиль.VIN И НастройкаПодключения.ПроверятьСоответствиеVIN = Истина	Тогда
					Сообщить("Проведение невозможно! Не соответствие автомобиля в Реализации автомобиля и в Рабочем листе CRM № " + id_CRM); 
					Сообщить("Потребность 1С: " + Автомобиль.VIN + "; " + "Потребность CRM: " + СтруктураПотребности.result.VIN);
					Возврат Ложь;
				КонецЕсли;
				
				СтруктураКлиента = ПолучитьСтруктуруКлиентаПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.client_id),НастройкаПодключения);
				Клиент = СтруктураКлиента.result;
				СтруктураФизЛицо = Клиент.primaryPerson;   
				Если НастройкаПодключения.ПроверятьСоответствиеТелефона = Истина Тогда 
					МассивТелефоны = СтруктураФизЛицо.phones;
					Если МассивТелефоны.Количество() = 0 ИЛИ МассивТелефоны = Неопределено Тогда
						СтруктураОрганизация = Клиент.company;
						МассивТелефоны = СтруктураОрганизация.phones;  					
					КонецЕсли; 
					Если МассивТелефоны.Количество() = 0 ИЛИ МассивТелефоны = Неопределено Тогда
						Сообщить("Проведение невозможно! В CRM системе не заполнен телефон контрагента в рабочем листе № " + id_CRM); 
						Возврат Ложь;
					КонецЕсли;  				
					ТелефоныСовпадают = Ложь;   			
					Для Каждого Эл Из МассивТелефоны Цикл
						Если ЗначениеЗаполнено(Эл.number) Тогда
							НомерТелефонаCRM = Эл.number;	 
							НомерТелефонаCRM = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(НомерТелефонаCRM);
							Если Лев(НомерТелефонаCRM,1) = "7" или Лев(НомерТелефонаCRM,1)= "8" Тогда
								НомерТелефонаCRM = Сред(НомерТелефонаCRM,2);
							КонецЕсли;    
							КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(Реализация.Заказчик,Перечисления.ТипыКонтактнойИнформации.Телефон);
							Пока КонтактнаяИнформация.Следующий() Цикл  
								НомерТелефона = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(КонтактнаяИнформация.Представление);
								Если Лев(НомерТелефона,1) = "7" или Лев(НомерТелефона,1)= "8" Тогда
									НомерТелефона = Сред(НомерТелефона,2);
								КонецЕсли; 						
								Если НомерТелефонаCRM = НомерТелефона Тогда
									ТелефоныСовпадают = Истина;
								КонецЕсли;
							КонецЦикла; 
							КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(Реализация.Контрагент,Перечисления.ТипыКонтактнойИнформации.Телефон);
							Пока КонтактнаяИнформация.Следующий() Цикл  
								НомерТелефона = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(КонтактнаяИнформация.Представление);
								Если Лев(НомерТелефона,1) = "7" или Лев(НомерТелефона,1)= "8" Тогда
									НомерТелефона = Сред(НомерТелефона,2);
								КонецЕсли; 						
								Если НомерТелефонаCRM = НомерТелефона Тогда
									ТелефоныСовпадают = Истина;
								КонецЕсли;
							КонецЦикла; 
						КонецЕсли;
					КонецЦикла;        
					Если ТелефоныСовпадают = Ложь Тогда
						Сообщить("Проведение невозможно! Не совпадают телефоны клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("Номер телефона 1С: " + НомерТелефона + "; " + "Номер телефона CRM: " + НомерТелефонаCRM);
						Возврат Ложь;
					КонецЕсли; 
				КонецЕсли; 
				
				Если НастройкаПодключения.ПроверятьСоответствиеEmail = Истина Тогда 
					emailCRM = СокрЛП(Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.email)); 
					emailСовпадают = Ложь;   
					КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(Реализация.Заказчик,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
					Пока КонтактнаяИнформация.Следующий() Цикл  
						email = СокрЛП(КонтактнаяИнформация.Представление); 
						Если email = emailCRM Тогда
							emailСовпадают = Истина;
						КонецЕсли;
					КонецЦикла; 	   
					КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(Реализация.Контрагент,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
					Пока КонтактнаяИнформация.Следующий() Цикл  
						email = СокрЛП(КонтактнаяИнформация.Представление); 
						Если email = emailCRM Тогда
							emailСовпадают = Истина;
						КонецЕсли;
					КонецЦикла; 	
					Если emailСовпадают = Ложь Тогда
						Сообщить("Проведение невозможно! Не совпадают email клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("Email 1С: " + email + "; " + "Email CRM: " + emailCRM);
						Возврат Ложь;
					КонецЕсли; 
				КонецЕсли;
				
				Тип = Инфотек_ОбщиеПроцедуры.УбратьКавычки(Клиент.type);					
				Если Найти(Тип,"individual") <> 0 И НастройкаПодключения.ПроверятьСоответствиеФИО = Истина Тогда	
					Фамилия  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
					Имя      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
					Отчество = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
					Наименование = Фамилия + " " + Имя + " " + Отчество;
					Если СокрЛП(Наименование) <> СокрЛП(Реализация.Заказчик.Наименование) И СокрЛП(Наименование) <> СокрЛП(Реализация.Контрагент.Наименование) Тогда
						Сообщить("Проведение невозможно! Не совпадают ФИО клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("ФИО 1С: " + СокрЛП(Реализация.Заказчик.Наименование) + "; " + "ФИО CRM: " + Наименование);
						Возврат Ложь;
					КонецЕсли;
				КонецЕсли;
				
				Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
					Запрос = "/yii/api/retailStage/finish?id=" + ИДЭтапа;
				ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда
					Запрос = "/yii/api/CorporateCase/finish?id=" + ИДЭтапа;	
				Иначе
					Запрос = "/yii/api/SaleUsedStage/finish?id=" + ИДЭтапа;	
				КонецЕсли;
				СтруктураДанных = Новый Структура();
				Если НачалоДня(ТекущаяДата()) > НачалоДня(Реализация.Дата) Тогда
					СтруктураДанных.Вставить("scheduleAt", Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ТекущаяДата()),"ДФ=ЧЧ:мм"));
				Иначе	
					СтруктураДанных.Вставить("scheduleAt", Формат(Реализация.Дата,"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(Реализация.Дата),"ДФ=ЧЧ:мм"));
				КонецЕсли;
				Если ЗначениеЗаполнено(Реализация.Комментарий) Тогда
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + Реализация.Номер + " от " + Формат(Реализация.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + Реализация.Комментарий);
				Иначе
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + Реализация.Номер + " от " + Формат(Реализация.Дата,"ДФ=dd.MM.yyyy"));   
				КонецЕсли;      
				СтруктураДанных.Вставить("objectKey","2/" + ИДПотребности);
				СтруктураДанных.Вставить("assistantId",ИДМенеджера);
			КонецЕсли;
			
			ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураДанных,Истина);
			Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);				
			Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
				Результат = Истина;   
				Если СтрНайти(Ответ.ПолучитьТелоКакСтроку(),"""success"":false") > 0 Тогда
					//Результат = Ложь;
					Сообщить("Не удалось завершить этап Выдача в CRM!" + Символы.ПС + Ответ.ПолучитьТелоКакСтроку());	
				КонецЕсли;			
			Иначе
				Результат = Ложь;
				Сообщить(Ответ.ПолучитьТелоКакСтроку());
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Функция отправки запроса завершения контракта по рабочему листу в CRM    
//                           
// Параметры:   
//  Реализация           - ДокументСсылка.ЗаказНаАвтомобиль - Ссылка на документ заказ на автомобиль.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//  id_CRM               - Строка - Идентификатор рабочего листа.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция ПередатьВCRMДоговор(ЗаказНаАвтомобиль,НастройкаПодключения,id_CRM)
	
	Результат = Ложь;
	ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,НастройкаПодключения);            
	Если ЭтапыРЛ.Количество() = 0 Тогда
		ВыборкаНастроекПодключения = Справочники.Инфотек_НастройкиПодключения.Выбрать();
		Пока ВыборкаНастроекПодключения.Следующий() Цикл 
			Если ВыборкаНастроекПодключения.ПометкаУдаления = Ложь Тогда 
				ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,ВыборкаНастроекПодключения.Ссылка);
				Если ЭтапыРЛ.Количество() > 0 Тогда	
					НастройкаПодключения = ВыборкаНастроекПодключения.Ссылка; 
					Прервать;
				КонецЕсли;    
			КонецЕсли;  
		КонецЦикла;
	КонецЕсли;	
	
	ЕстьДоговор = Ложь;
	Если ЭтапыРЛ.Количество() > 0 Тогда	
		Для Каждого ЭлМассива Из ЭтапыРЛ Цикл
			Если ИдентификаторВСтроку(ЭлМассива.type) = "11" И ИдентификаторВСтроку(ЭлМассива.state) <> "4" Тогда
				ЕстьДоговор = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли;  
	
	РабочийЛистБУ = Ложь;
	РабочийЛистКорпоративныхПродаж = Ложь;
	
	СтруктураРабочегоЛиста = ПолучитьСтруктуруРабочегоЛистаПоИдентификатору(id_CRM,НастройкаПодключения);  
	Если СтруктураРабочегоЛиста = Неопределено Тогда     
		СтруктураРабочегоЛиста = ПолучитьСтруктуруРабочегоЛистаКорпоративныхПродажПоИдентификатору(id_CRM,НастройкаПодключения);  
		Если СтруктураРабочегоЛиста = Неопределено Тогда
			СтруктураРабочегоЛиста = ПолучитьСтруктуруРабочегоЛистаБУПоИдентификатору(id_CRM,НастройкаПодключения);  
			Если СтруктураРабочегоЛиста = Неопределено Тогда
				Сообщить("Не найден в CRM рабочий лист № " + id_CRM + "; " + " Закрытие этапа не произойдет!");
				Результат = Истина;
				Возврат Результат; 
			Иначе
				РабочийЛистБУ = Истина;
			КонецЕсли; 
		Иначе
			РабочийЛистКорпоративныхПродаж = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если РабочийЛистБУ = Истина И НастройкаПодключения.ЗакрытиеЭтаповРабочихЛистовБУCRM = Ложь Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если РабочийЛистБУ = Ложь И НастройкаПодключения.ЗакрытиеЭтаповРабочихЛистовCRM = Ложь Тогда
