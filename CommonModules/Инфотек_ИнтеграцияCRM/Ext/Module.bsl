// Процедура заполнения Поступления автомобилей по структуре рабочего листа Trade In из CRM 
//                           
// Параметры:   
//  СтурктураРезультата - Структура - Обращение из CRM.
//  ОбДокумент          - ДокументОбъект.ПоступлениеАвтомобилей - Объект документ ПоступлениеАвтомобилей.
//  ОбДокументФорма     - Форма - Форма документа ПоступлениеАвтомобилей.
//
Процедура ОбработатьСтруктуруЗаполнитьРеквизитыПоступленияАвтомобилей(СтруктураРезультата,НастройкаПодключения,ОбДокумент,ОбДокументФорма) Экспорт
	Если Не СтруктураРезультата.success Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРезультата = СтруктураРезультата.result; 	
	Если Не СтруктураРезультата.Свойство("generalClient") Тогда
		Сообщить("Нет данных по Клиенту в Рабочем листе TradeIn №" + Строка(СтруктураРезультата.id), СтатусСообщения.Внимание);
		Возврат;
	Иначе
		ОбДокумент.Инфотек_Идентификатор_CRM = ИдентификаторВСтроку(СтруктураРезультата.id); 
	КонецЕсли;

	Контрагент = ПолучитьСоздатьКонтрагентаТрейдИн(СтруктураРезультата, НастройкаПодключения);
	Если обЗначениеНеЗаполнено(Контрагент) Тогда
		Возврат;
		
	Иначе
		ОбДокумент.Контрагент = Контрагент;
		ОбДокумент.ДоговорВзаиморасчетов = ПолучитьСоздатьДоговорВзаиморасчетов(Контрагент, НастройкаПодключения, Перечисления.ВидыДоговоров.Покупка);
	КонецЕсли;
	
	Автомобиль = ПолучитьСоздатьАвтомобильТрейдИн(СтруктураРезультата, НастройкаПодключения);
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаАвтомобиль = ОбДокумент.Автомобили.Добавить();
	СтрокаАвтомобиль.Автомобиль = Автомобиль;
	СтрокаАвтомобиль.ИдентификаторАвтомобиля = Новый УникальныйИдентификатор;
	СтрокаАвтомобиль.VIN = Автомобиль.VIN;
	СтрокаАвтомобиль.АвтомобильБУ = Истина;
	СтрокаАвтомобиль.ВидАвтомобиля = Перечисления.ВидАвтомобиля.АвтомобильСПробегом;
	СтрокаАвтомобиль.АвтомобильБезЗаказа = Истина;
	СтрокаАвтомобиль.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
	СтрокаАвтомобиль.Количество = 1;
	СтрокаАвтомобиль.Цена = ПолучитьПредложеннуюЦенуТрейдИн(ОбДокумент.Инфотек_Идентификатор_CRM, НастройкаПодключения);
	ОбДокумент.ОбработкаРеквизита("Автомобили.Цена", СтрокаАвтомобиль);
	
	ФИОМенеджера = "";
	ФИОМенеджера = СтруктураРезультата.assignee.person; 
	Если ФИОМенеджера = Неопределено Тогда
		ФамилияМенеджера       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураРезультата.assignee.lastName);
		ИмяМенеджера           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураРезультата.assignee.firstName);
		ОтчествоМенеджера      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураРезультата.assignee.middleName);	
		ФИОМенеджера = ФамилияМенеджера + " " + ИмяМенеджера + " " + ОтчествоМенеджера;
	КонецЕсли;
	ИдентификаторМенеджера = СтруктураРезультата.assignee.id;  
	Менеджер = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдентификаторМенеджера,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
	Если ЗначениеЗаполнено(Менеджер) Тогда			
		ОбДокумент.Менеджер = Менеджер;
		
	Иначе
		ЗапросСотр = Новый Запрос();
		ЗапросСотр.УстановитьПараметр("парФИО",СокрЛП(ФИОМенеджера));
		ЗапросСотр.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка,
		|	Сотрудники.Наименование,
		|	Сотрудники.Представление
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Наименование ПОДОБНО ""%"" + &парФИО + ""%""";
		
		РезультатСотр = ЗапросСотр.Выполнить().Выбрать();
		Если РезультатСотр.Следующий() Тогда
			ОбДокумент.Менеджер = РезультатСотр.Ссылка;
		КонецЕсли;	
	КонецЕсли;	

	Автор = СтруктураРезультата.author;
	ФИОАвтор = СтруктураРезультата.author.person;
	Если ФИОАвтор = Неопределено Тогда
		ФамилияАвтор       = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураРезультата.author.lastName);
		ИмяАвтор           = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураРезультата.author.firstName);
		ОтчествоАвтор      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураРезультата.author.middleName);	
		ФИОАвтор = ФамилияАвтор + " " + ИмяАвтор + " " + ОтчествоАвтор;
	КонецЕсли;
	ИдентификаторАвтора = СтруктураРезультата.author.id;
	АвторСотрудник = Инфотек_ОбщиеПроцедуры.ПолучитьОбъектПоИдентификаторуСоответствия(НастройкаПодключения,ИдентификаторАвтора,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
	Если ЗначениеЗаполнено(АвторСотрудник) Тогда
		ОбДокумент.Автор = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник",АвторСотрудник);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОбДокумент.Автор) Тогда		
		ЗапросПользователи = Новый запрос();
		ЗапросПользователи.УстановитьПараметр("парФИО",СокрЛП(ФИОАвтор));
		ЗапросПользователи.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка,
		|	Пользователи.Наименование,
		|	Пользователи.Представление
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование ПОДОБНО ""%"" + &парФИО + ""%""";
		
		РезультатПользователи = ЗапросПользователи.Выполнить().Выбрать();
		Если РезультатПользователи.Следующий() Тогда
			ОбДокумент.Автор = РезультатПользователи.Ссылка;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

