						Если ЗначениеЗаполнено(Эл.number) Тогда
							НомерТелефонаCRM = Эл.number;	 
							НомерТелефонаCRM = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(НомерТелефонаCRM);
							Если Лев(НомерТелефонаCRM,1) = "7" или Лев(НомерТелефонаCRM,1)= "8" Тогда
								НомерТелефонаCRM = Сред(НомерТелефонаCRM,2);
							КонецЕсли;   
							КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(ЗаказНаАвтомобиль.Заказчик,Перечисления.ТипыКонтактнойИнформации.Телефон);
							Пока КонтактнаяИнформация.Следующий() Цикл  
								НомерТелефона = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(КонтактнаяИнформация.Представление);
								Если Лев(НомерТелефона,1) = "7" или Лев(НомерТелефона,1)= "8" Тогда
									НомерТелефона = Сред(НомерТелефона,2);
								КонецЕсли; 						
								Если НомерТелефонаCRM = НомерТелефона Тогда
									ТелефоныСовпадают = Истина;
								КонецЕсли;
							КонецЦикла; 
							КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(ЗаказНаАвтомобиль.Контрагент,Перечисления.ТипыКонтактнойИнформации.Телефон);
							Пока КонтактнаяИнформация.Следующий() Цикл  
								НомерТелефона = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(КонтактнаяИнформация.Представление);
								Если Лев(НомерТелефона,1) = "7" или Лев(НомерТелефона,1)= "8" Тогда
									НомерТелефона = Сред(НомерТелефона,2);
								КонецЕсли; 						
								Если НомерТелефонаCRM = НомерТелефона Тогда
									ТелефоныСовпадают = Истина;
								КонецЕсли;
							КонецЦикла; 	
						КонецЕсли;
					КонецЦикла;     
					Если ТелефоныСовпадают = Ложь Тогда
						Сообщить("Проведение невозможно! Не совпадают телефоны клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("Номер телефона 1С: " + НомерТелефона + "; " + "Номер телефона CRM: " + НомерТелефонаCRM);
						Результат = Ложь;
						Возврат Результат;
					КонецЕсли; 
				КонецЕсли;
				
				Если НастройкаПодключения.ПроверятьСоответствиеEmail = Истина Тогда 
					emailCRM = СокрЛП(Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.email)); 
					emailСовпадают = Ложь;     
					КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(ЗаказНаАвтомобиль.Заказчик,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
					Пока КонтактнаяИнформация.Следующий() Цикл  
						email = СокрЛП(КонтактнаяИнформация.Представление); 
						Если email = emailCRM Тогда
							emailСовпадают = Истина;
						КонецЕсли;
					КонецЦикла; 	   
					КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(ЗаказНаАвтомобиль.Контрагент,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
					Пока КонтактнаяИнформация.Следующий() Цикл  
						email = СокрЛП(КонтактнаяИнформация.Представление); 
						Если email = emailCRM Тогда
							emailСовпадают = Истина;
						КонецЕсли;
					КонецЦикла; 	
					Если emailСовпадают = Ложь Тогда
						Сообщить("Проведение невозможно! Не совпадают email клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("Email 1С: " + email + "; " + "Email CRM: " + emailCRM);
						Результат = Ложь;
						Возврат Результат;
					КонецЕсли; 
				КонецЕсли;
				
				Тип = Инфотек_ОбщиеПроцедуры.УбратьКавычки(Клиент.type);					
				Если Найти(Тип, "individual") <> 0 И НастройкаПодключения.ПроверятьСоответствиеФИО = Истина Тогда	
					Фамилия  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
					Имя      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
					Отчество = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
					Наименование = Фамилия + " " + Имя + " " + Отчество;
					Если СокрЛП(Наименование) <> СокрЛП(ЗаказНаАвтомобиль.Заказчик.Наименование) И СокрЛП(Наименование) <> СокрЛП(ЗаказНаАвтомобиль.Контрагент.Наименование) Тогда
						Сообщить("Проведение невозможно! Не совпадают ФИО клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("ФИО 1С: " + СокрЛП(ЗаказНаАвтомобиль.Заказчик.Наименование) + "; " + "ФИО CRM: " + Наименование);
						Результат = Ложь;
						Возврат Результат;
					КонецЕсли;
				КонецЕсли;
				
				Если РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Ложь Тогда
					Запрос = "/yii/api/retailStage/finish?id=" + ИДЭтапа;	
				ИначеЕсли РабочийЛистБУ = Ложь И РабочийЛистКорпоративныхПродаж = Истина Тогда 
					Запрос = "/yii/api/CorporateCase/finish?id=" + ИДЭтапа;	
				Иначе
					Запрос = "/yii/api/SaleUsedStage/finish?id=" + ИДЭтапа;	
				КонецЕсли;
				СтруктураДанных = Новый Структура();
				Если НачалоДня(ТекущаяДата()) > НачалоДня(ЗаказНаАвтомобиль.Дата) Тогда
					СтруктураДанных.Вставить("scheduleAt", Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ТекущаяДата()),"ДФ=ЧЧ:мм"));
				Иначе	
					СтруктураДанных.Вставить("scheduleAt", Формат(ЗаказНаАвтомобиль.Дата,"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ЗаказНаАвтомобиль.Дата),"ДФ=ЧЧ:мм"));
				КонецЕсли;    
				Если ЗначениеЗаполнено(ЗаказНаАвтомобиль.Комментарий) Тогда
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ЗаказНаАвтомобиль.Номер + " от " + Формат(ЗаказНаАвтомобиль.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + ЗаказНаАвтомобиль.Комментарий);
				Иначе
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ЗаказНаАвтомобиль.Номер + " от " + Формат(ЗаказНаАвтомобиль.Дата,"ДФ=dd.MM.yyyy")); 	
				КонецЕсли;				
				ИдентификаторСотрудника = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ЗаказНаАвтомобиль.Менеджер,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
				Если ЗначениеЗаполнено(ИдентификаторСотрудника) Тогда
					СтруктураДанных.Вставить("assistantId",ИдентификаторСотрудника);
				КонецЕсли;	
				СтруктураДанных.Вставить("objectKey","2/" + ИДПотребности);
			КонецЕсли;
			
			ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураДанных,Истина);
			Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);				
			Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
				Результат = Истина; 
				Если СтрНайти(Ответ.ПолучитьТелоКакСтроку(),"""success"":false") > 0 Тогда
					Сообщить("Не удалось завершить этап Контракт в CRM!" + Символы.ПС + Ответ.ПолучитьТелоКакСтроку(), СтатусСообщения.Внимание);	
				КонецЕсли;			
			Иначе
				Результат = Ложь;
				Сообщить(Ответ.ПолучитьТелоКакСтроку());  
				Возврат Результат;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;			
	
	Результат = Истина; 
	Возврат Результат;	
КонецФункции

// Функция отправки запроса завершения поступления по рабочему листу TradeIn в CRM    
//                           
// Параметры:   
//  ДокументДвижения     - ДокументСсылка - Ссылка на документ поступление/возврат автомобиля.
//  СтрокаАвто           - Строка табличной части документа
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//  id_CRM               - Строка - Идентификатор рабочего листа.
//
// Возвращаемое значение:
//  Булево - Успешна/неудачна отправка запроса.  
// 
Функция ПодтвердитьПоступлениеTradeIn(ДокументДвижения,СтрокаАвто,НастройкаПодключения,id_CRM) Экспорт
	Результат = Ложь;	
	ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,НастройкаПодключения);   
	Если ЭтапыРЛ.Количество() = 0 Тогда
		ВыборкаНастроекПодключения = Справочники.Инфотек_НастройкиПодключения.Выбрать();
		Пока ВыборкаНастроекПодключения.Следующий() Цикл 
			Если ВыборкаНастроекПодключения.ПометкаУдаления = Ложь Тогда 
				ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,ВыборкаНастроекПодключения.Ссылка);
				Если ЭтапыРЛ.Количество() > 0 Тогда	
					НастройкаПодключения = ВыборкаНастроекПодключения.Ссылка; 
					Прервать;
				КонецЕсли;    
			КонецЕсли;  
		КонецЦикла;
	КонецЕсли;	
	
		
	Если ЭтапыРЛ.Количество() = 0 Тогда
		Сообщить("Не найдены этапы рабочего листа в CRM системе! Проверьте наличие этапов в рабочем листе, либо принадлежность автосалона CRM учетной записи настройки подключения в 1С!");
		Возврат Результат;
		
	Иначе
		ЕстьПоступление = Ложь;
		Для Каждого ЭлМассива Из ЭтапыРЛ  Цикл
			Если ИдентификаторВСтроку(ЭлМассива.type) = "5" И ИдентификаторВСтроку(ЭлМассива.state) <> "4" Тогда
				ЕстьПоступление = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	
	СтруктураРабочегоЛиста = ПолучитьСтруктуруРабочегоЛистаTradeInПоИдентификатору(id_CRM, НастройкаПодключения);
	Если СтруктураРабочегоЛиста = Неопределено Тогда  
		Сообщить("На портале не найден в CRM рабочий лист № " + id_CRM + "; " + " Закрыть этап Приём невозможно!");
		Возврат Истина;
	КонецЕсли;
	
	Если НастройкаПодключения.ЗакрытиеЭтаповTradeInCRM = Ложь Тогда
		Возврат Истина;
	КонецЕсли;
	
	Автомобиль = СтрокаАвто.Автомобиль;
	АвтомобильCRM = "";   
	Попытка
		СтруктураАвтомобиля = СтруктураРабочегоЛиста.result.Vehicle; 
		Если СтруктураАвтомобиля.vin = Автомобиль.VIN Тогда
			АвтомобильCRM = ИдентификаторВСтроку(СтруктураАвтомобиля.id);
		КонецЕсли;
	Исключение 
	КонецПопытки;             
	
	Если обЗначениеНеЗаполнено(АвтомобильCRM) Тогда
		Сообщить("Закрыть этап Приём невозможно! На портале не найден автомобиль поступления для рабочего листа № " + id_CRM);  
		Возврат Истина;
	КонецЕсли; 
	
	Если ЕстьПоступление = Ложь И ТипЗнч(ДокументДвижения) = Тип("ДокументСсылка.ПоступлениеАвтомобилей") И ДокументДвижения.ПометкаУдаления = Ложь Тогда
		//Поступление планирование этапа
		Запрос = "/yii/api/tradeinStage/schedule?id=" + id_CRM + "&type=5";	
		СтруктураДанных = Новый Структура();  
		Если НачалоДня(ТекущаяДата()) > НачалоДня(ДокументДвижения.Дата) Тогда
			СтруктураДанных.Вставить("scheduleAt",Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ТекущаяДата()),"ДФ=ЧЧ:мм"));
		Иначе	
			СтруктураДанных.Вставить("scheduleAt",Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ДокументДвижения.Дата),"ДФ=ЧЧ:мм"));
		КонецЕсли;
		
		СтруктураДанных.Вставить("objectKey","1/" + АвтомобильCRM);  
		Если ЗначениеЗаполнено(ДокументДвижения.Комментарий) Тогда
			СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + ДокументДвижения.Комментарий);
		Иначе
			СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy"));   
		КонецЕсли;
		
		ИдентификаторСотрудника = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,ДокументДвижения.Менеджер,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Сотрудник);
		Если ЗначениеЗаполнено(ИдентификаторСотрудника) Тогда
			СтруктураДанных.Вставить("assistantId",ИдентификаторСотрудника);
		КонецЕсли;
		
		ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураДанных,Истина);
		Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);				
		Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
			Результат = Истина;
		Иначе
			Результат = Ложь;
			Сообщить(Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли;   
		ЭтапыРЛ = ПолучитьМассивСобытийПоИдентификаторуРабочегоЛиста(id_CRM,НастройкаПодключения);   
	КонецЕсли;
	
	Для Каждого ЭлМассива из ЭтапыРЛ Цикл
		Если ИдентификаторВСтроку(ЭлМассива.type) = "5" И ИдентификаторВСтроку(ЭлМассива.state) <> "4"  Тогда
			ИДЭтапа       = ИдентификаторВСтроку(ЭлМассива.id); 
			ИДПотребности = ИдентификаторВСтроку(ЭлМассива.client_vehicle_id);
			Если обЗначениеНеЗаполнено(ИДПотребности) Тогда
				ИДПотребности = ИдентификаторВСтроку(СтруктураРабочегоЛиста.result.Vehicle.id); 
			КонецЕсли;
			ИДМенеджера   = ИдентификаторВСтроку(ЭлМассива.assigneeId);	
			//Поступление завершение этапа
			Если (ТипЗнч(ДокументДвижения) = Тип("ДокументСсылка.ПоступлениеАвтомобилей") И ДокументДвижения.ПометкаУдаления = Истина) ИЛИ
				(ТипЗнч(ДокументДвижения) = Тип("ДокументСсылка.ВозвратПоставщикуАвтомобилей") И ДокументДвижения.ПометкаУдаления = Ложь) Тогда  				
				Запрос = "/yii/api/tradeinStage/cancel?id=" + ИДЭтапа;	
				СтруктураДанных = Новый Структура(); 
				Если ЗначениеЗаполнено(ДокументДвижения.Комментарий) Тогда
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + ДокументДвижения.Комментарий);
				Иначе
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy"));   
				КонецЕсли;   
				
			ИначеЕсли ТипЗнч(ДокументДвижения) = Тип("ДокументСсылка.КорректировкаПоступленияАвтомобилей") И ДокументДвижения.ПометкаУдаления = Ложь Тогда 
				Для Каждого СтрокаАвтомобиля Из ДокументДвижения.Автомобили Цикл
					Если СтрокаАвтомобиля.Количество = 0 Тогда
						Запрос = "/yii/api/tradeinStage/cancel?id=" + ИДЭтапа;	
						СтруктураДанных = Новый Структура(); 
						Если ЗначениеЗаполнено(ДокументДвижения.Комментарий) Тогда
							СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + ДокументДвижения.Комментарий);
						Иначе
							СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy"));   
						КонецЕсли;   
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				Если ЭлМассива.state = "3" Тогда
					Сообщить("Этап рабочего листа Приём уже закрыт: " + ЭлМассива.closedAt);
					Возврат Истина;
				КонецЕсли;
				
				стАвтомобильCRM = ПолучитьСтруктуруАвтомобиляTradeInПоИдентификатору(ИДПотребности, НастройкаПодключения);
				Если стАвтомобильCRM.result.vin <> Автомобиль.VIN И НастройкаПодключения.ПроверятьСоответствиеVIN = Истина	Тогда
					Сообщить("Проведение невозможно! Не соответствие автомобиля в Поступлении автомобиля и в Рабочем листе TradeIn CRM № " + id_CRM); 
					Сообщить("Потребность 1С: " + Автомобиль.VIN + "; " + "Потребность CRM: " + стАвтомобильCRM.result.VIN);
					Возврат Ложь;
				КонецЕсли;
				
				СтруктураКлиента = ПолучитьСтруктуруКлиентаПоИдентификатору(ИдентификаторВСтроку(ЭлМассива.client_id),НастройкаПодключения);
				Клиент = СтруктураКлиента.result;
				СтруктураФизЛицо =  Клиент.primaryPerson;   
				Если НастройкаПодключения.ПроверятьСоответствиеТелефона = Истина Тогда 
					МассивТелефоны   =  СтруктураФизЛицо.phones;
					Если МассивТелефоны.Количество() = 0 Или МассивТелефоны = Неопределено Тогда
						СтруктураОрганизация =  Клиент.company;
						МассивТелефоны  = СтруктураОрганизация.phones;  					
					КонецЕсли; 
					Если МассивТелефоны.Количество() = 0 Или МассивТелефоны = Неопределено Тогда
						Сообщить("Проведение невозможно! В CRM системе не заполнен телефон контрагента в рабочем листе № " + id_CRM); 
						Возврат Ложь;
					КонецЕсли;
					
					ТелефоныСовпадают = Ложь;
					Для Каждого Эл Из МассивТелефоны Цикл
						Если ЗначениеЗаполнено(Эл.number) Тогда
							НомерТелефонаCRM = Эл.number;	 
							НомерТелефонаCRM = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(НомерТелефонаCRM);
							Если Лев(НомерТелефонаCRM,1) = "7" или Лев(НомерТелефонаCRM,1)= "8" Тогда
								НомерТелефонаCRM = Сред(НомерТелефонаCRM,2);
							КонецЕсли;  
							КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(ДокументДвижения.Контрагент,Перечисления.ТипыКонтактнойИнформации.Телефон);
							Пока КонтактнаяИнформация.Следующий() Цикл
								НомерТелефона = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьТелефонЦифрами(КонтактнаяИнформация.Представление);
								Если Лев(НомерТелефона,1) = "7" или Лев(НомерТелефона,1)= "8" Тогда
									НомерТелефона = Сред(НомерТелефона,2);
								КонецЕсли; 						
								Если НомерТелефонаCRM = НомерТелефона Тогда
									ТелефоныСовпадают = Истина;
								КонецЕсли;
							КонецЦикла; 	
						КонецЕсли;
					КонецЦикла;        
					Если ТелефоныСовпадают = Ложь Тогда
						Сообщить("Проведение невозможно! Не совпадают телефоны клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("Номер телефона 1С: " + НомерТелефона + "; " + "Номер телефона CRM: " + НомерТелефонаCRM);
						Возврат Ложь;
					КонецЕсли; 
				КонецЕсли; 
				
				Если НастройкаПодключения.ПроверятьСоответствиеEmail = Истина Тогда 
					emailCRM = СокрЛП(Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.email)); 
					emailСовпадают = Ложь;
					КонтактнаяИнформация = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьКИ(ДокументДвижения.Контрагент,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
					Пока КонтактнаяИнформация.Следующий() Цикл  
						email = СокрЛП(КонтактнаяИнформация.Представление); 
						Если email = emailCRM Тогда
							emailСовпадают = Истина;
						КонецЕсли;
					КонецЦикла; 	   
					Если emailСовпадают = Ложь Тогда
						Сообщить("Проведение невозможно! Не совпадают email клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("Email 1С: " + email + "; " + "Email CRM: " + emailCRM);
						Возврат Ложь;
					КонецЕсли; 
				КонецЕсли;
				
				Тип = Инфотек_ОбщиеПроцедуры.УбратьКавычки(Клиент.type);					
				Если Найти(Тип, "individual") <> 0 И НастройкаПодключения.ПроверятьСоответствиеФИО = Истина Тогда	
					Фамилия  = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.lastName);
					Имя      = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.firstName);
					Отчество = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураФизЛицо.middleName);	
					Наименование = Фамилия + " " + Имя + " " + Отчество;
					Если СокрЛП(Наименование) <> СокрЛП(ДокументДвижения.Контрагент.Наименование) Тогда
						Сообщить("Проведение невозможно! Не совпадают ФИО клиента 1С и рабочего листа CRM № " + id_CRM); 
						Сообщить("ФИО 1С: " + СокрЛП(ДокументДвижения.Контрагент.Наименование) + "; " + "ФИО CRM: " + Наименование);
						Возврат Ложь;
					КонецЕсли;
				КонецЕсли;
				
				Запрос = "/yii/api/tradeinStage/finish?id=" + ИДЭтапа;	
				СтруктураДанных = Новый Структура();
				Если НачалоДня(ТекущаяДата()) > НачалоДня(ДокументДвижения.Дата) Тогда
					СтруктураДанных.Вставить("scheduleAt", Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ТекущаяДата()),"ДФ=ЧЧ:мм"));
				Иначе	
					СтруктураДанных.Вставить("scheduleAt", Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy") + " " + Формат(КонецДня(ДокументДвижения.Дата),"ДФ=ЧЧ:мм"));
				КонецЕсли;
				
				СтруктураДанных.Вставить("acceptanceBuyPrice", СтрокаАвто.СуммаВсего);		
				СтруктураДанных.Вставить("acceptanceSellPrice", 1);      			
				Если ЗначениеЗаполнено(ДокументДвижения.Комментарий) Тогда
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy") + ", комментарий документа: " + ДокументДвижения.Комментарий);
				Иначе
					СтруктураДанных.Вставить("comment","Передан из 1С: документ № " + ДокументДвижения.Номер + " от " + Формат(ДокументДвижения.Дата,"ДФ=dd.MM.yyyy"));   
				КонецЕсли;
				
				СтруктураДанных.Вставить("objectKey","1/" + ИДПотребности); // было "objectKey","2/"
				СтруктураДанных.Вставить("assistantId",ИДМенеджера);
			КонецЕсли;
			
			ТелоЗапроса = Инфотек_JSON.мЗаписатьJSON(СтруктураДанных,Истина);
			Ответ = Инфотек_Запросы.POSTЗапрос(Запрос,НастройкаПодключения,ТелоЗапроса);				
			Если Инфотек_Запросы.ПроверитьУспешностьВыполненияЗапроса(Ответ) Тогда
				Результат = Истина;  
				Если СтрНайти(Ответ.ПолучитьТелоКакСтроку(),"""success"":false") > 0 Тогда
					Сообщить("Не удалось завершить этап Приём в CRM!" + Символы.ПС + Ответ.ПолучитьТелоКакСтроку());	
				КонецЕсли;			
				
			Иначе
				Результат = Ложь;
				Сообщить(Ответ.ПолучитьТелоКакСтроку());
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;      
	
	Если Результат = Ложь Тогда  
		Сообщить("Не найден этап Приём автомобиля в CRM, рабочий лист № " + id_CRM + "; " + " либо не удалось закрыть этап!");    
		Результат = Истина;
	КонецЕсли;
	Возврат Результат;
КонецФункции

