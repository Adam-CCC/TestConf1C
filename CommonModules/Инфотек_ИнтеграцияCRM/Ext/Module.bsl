					Если ЗначениеЗаполнено(Источник.Инфотек_Идентификатор_CRM) Тогда  
						//Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеАвтомобилей") Тогда 
							Для Каждого СтрокаАвто Из Источник.Автомобили Цикл	
								Если СтрокаАвто.АвтомобильБУ = Истина Тогда
									Результат = ПодтвердитьПоступлениеTradeIn(Источник.Ссылка, СтрокаАвто, НастройкаПодключения, Источник.Инфотек_Идентификатор_CRM);
									Если Результат = Ложь Тогда
										Отказ = Истина;
									КонецЕсли; 
								КонецЕсли;
							КонецЦикла;  
							
						//Иначе 
						//	Для Каждого СтрокаАвто Из Источник.Автомобили Цикл	
						//		Результат = ПодтвердитьПоступлениеTradeIn(Источник.Ссылка,СтрокаАвто,НастройкаПодключения,МассивРабочихЛистов[Индекс].Инфотек_Идентификатор_CRM);
						//		Если Результат = Ложь Тогда
						//			Отказ = Истина;
						//		КонецЕсли; 
