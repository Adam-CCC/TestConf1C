// Процедура выполняет отключение от сервера CLON
//
// Параметры:
//	Нет.
//
Процедура сфпОтключитьCLON() Экспорт
	Если сфпObjCLON = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		сфпObjCLON.Disconnect();				
	Исключение
	КонецПопытки;
	сфпObjCLON = Неопределено;
КонецПроцедуры // сфпОтключитьCLON()

// Функция выполняет подключение к серверу CLON
//
// Параметры:
//	Нет.
//
// Возвращаемое значение:
//	Булево	- Результат подключения
//
Функция сфпПодключитьCLON() Экспорт
	#Если ВебКлиент Тогда
		Состояние(НСтр("ru='Работа СофтФона невозможна в web-клиенте!'"));
		Возврат Ложь;
	#Иначе
		сфпОтключитьCLON();
		Состояние("Загрузка компоненты записи разговоров CLON");
		КодВозврата = ПодключитьВнешнююКомпоненту("ОбщийМакет.сфпКомпонентаCLON", "CLON", ТипВнешнейКомпоненты.Native);
		Если НЕ КодВозврата Тогда
			УстановитьВнешнююКомпоненту("ОбщийМакет.сфпКомпонентаCLON");
			КодВозврата = ПодключитьВнешнююКомпоненту("ОбщийМакет.сфпКомпонентаCLON", "CLON", ТипВнешнейКомпоненты.Native);
		КонецЕсли;
		Попытка
			сфпObjCLON = Новый ("AddIn.CLON.DbControl");
		Исключение
			сфпObjCLON = Неопределено;
		КонецПопытки;	
		Если сфпObjCLON = Неопределено Тогда
			Состояние(НСтр("ru='Не удалось загрузить компоненту записи разговоров CLON'"));
			Возврат Ложь;
		КонецЕсли;
		// Проверяем версию подключенной компоненты
		Попытка
			ВерсияКомпонентыCLON = сфпObjCLON.GetVersion();	
		Исключение
			ВерсияКомпонентыCLON = "0.0.0.0";	
		КонецПопытки;	
		Если ВерсияКомпонентыCLON < "1.0.6.0" Тогда
			// Обновляем установленную компоненту
			УстановитьВнешнююКомпоненту("ОбщийМакет.сфпКомпонентаCLON");
			КодВозврата = ПодключитьВнешнююКомпоненту("ОбщийМакет.сфпКомпонентаCLON", "CLON", ТипВнешнейКомпоненты.Native);
			Попытка
				сфпObjCLON = Новый ("AddIn.CLON.DbControl");
			Исключение
				сфпObjCLON = Неопределено;
			КонецПопытки;	
			Если сфпObjCLON = Неопределено Тогда
				Состояние(НСтр("ru='Не удалось загрузить компоненту записи разговоров CLON'"));
				Возврат Ложь;
			КонецЕсли;
			// Проверяем версию подключенной компоненты
			Попытка
				ВерсияКомпонентыCLON = сфпObjCLON.GetVersion();	
			Исключение
				ВерсияКомпонентыCLON = "0.0.0.0";	
			КонецПопытки;	
			Если ВерсияКомпонентыCLON < "1.0.6.0" Тогда
				сфпObjCLON = Неопределено;
				Предупреждение(НСтр("ru='Не удалось обновить компоненту записи разговоров CLON. Удалите вручную файл компоненты'")
				+ """SearchModuleNative.dll""" + НСтр("ru=' и перезапустите программу'"));
				Возврат Ложь;
			КонецЕсли;;
		КонецЕсли;	
		// Подключаемся к серверу CLON
		Список = сфпСофтФонПроСервер.сфпПолучитьНастройкиCLON(); 
		Попытка
			КодВозврата = сфпObjCLON.Connect(Список.CLONServerIP, Список.CLONServerPort, Список.CLONType, Список.CLONServerLogin, Список.CLONServerPassword);				
		Исключение
			КодВозврата = -1;
		КонецПопытки;
		Если КодВозврата = -1 Тогда
			сфпCLON = Неопределено;
			Сообщить(НСтр("ru='Проверьте параметры подключения к системе записи телефонных переговоров CLON!'"));
			Возврат Ложь;
		КонецЕсли;	
		Возврат Истина;
	#КонецЕсли
КонецФункции // сфпПодключитьCLON()

// Процедура открывает форму настроек CLON
