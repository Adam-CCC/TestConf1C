// МАРШРУТИЗАЦИЯ

// Процедура сохраняет изменение маршрутизации при записи документа
//
// Параметры:
//	Ссылка			- ДокументСсылка	- Ссылка на документ
//	Ответственный	- СправочникСсылка	- Ответственный
//
Процедура ИзменениеМаршрутизацииПриЗаписиДокумента(Ссылка, Ответственный) Экспорт
	Контакт = сфпСофтФонПроСервер.сфпПолучитьКонтактноеЛицоИлиПартнера(Ссылка);
	Если НЕ ЗначениеЗаполнено(Контакт) Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
		ЕстьВзаимодействия = сфпСофтФонПроСервер.сфпЕстьВзаимодействияПоПользователю(Ссылка);
		Если ЕстьВзаимодействия Тогда
			сфпСофтФонПроСервер.сфпИзменитьТаблицуМаршрутизации(Контакт, Ответственный);
			// Обновим таблицу маршрутизации
			Если НЕ (сфпФормаТелефонВнешняяПанель = Неопределено) Тогда
				сфпФормаТелефонВнешняяПанель.ИзменитьМаршрутизациюВАТС(Ответственный);
			КонецЕсли;	
			// Изменим пользователя
			сфпСофтФонПроСервер.сфпИзменитьПользователяДляПереключенияЗвонков(Контакт, Ответственный);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры // ИзменениеМаршрутизацииПриЗаписиДокумента()

