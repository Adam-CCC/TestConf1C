// КОНТАКТНАЯ ИНФОРМАЦИЯ

// Функция возвращает список телефонов объектов из списка
//
// Параметры:
//	СписокОбъектов	- СписокЗначений	- Список объектов, для которых выбираются телефоны
//
// Возвращаемое значение:
//	СписокЗначений	- Список телефонов объектов
//
Функция сфпЗаполнитьСписокТелефонов(СписокОбъектов) Экспорт
	СписокТелефонов = Новый СписокЗначений;
	ТекКонтакт = "";
	Для Каждого СтрокаКонтакт Из СписокОбъектов Цикл
		ТелефоныКонтакта = сфпСофтФонПроСервер.сфпПолучитьСписокТелефоновИФаксов(СтрокаКонтакт.Значение);
		Для Каждого Телефон Из ТелефоныКонтакта Цикл
			Значение = Новый Структура;
			Значение.Вставить("Контакт", СтрокаКонтакт.Значение);
			Значение.Вставить("Телефон", Телефон.Представление);
			Если НЕ (ТекКонтакт = СтрокаКонтакт.Значение)Тогда
				СписокТелефонов.Добавить(Значение, СокрЛП(СтрокаКонтакт.Значение));
				ТекКонтакт = СтрокаКонтакт.Значение;
			КонецЕсли;
			СписокТелефонов.Добавить(Значение, "  " + СокрЛП(Телефон.Вид) + ": " + Телефон.Представление);
		КонецЦикла;
	КонецЦикла;
	Возврат СписокТелефонов;
КонецФункции // сфпЗаполнитьСписокТелефонов()

// Функция определяет контакт по номеру телефона
//
// Параметры:
//	НомерТелефона	- Строка	- Номер телефона контакта
//	ВыбратьПервый	- Булево	- Признак возврата первого контакта без выбора из списка
//
// Возвращаемое значение:
//	СправочникСсылка	- Контакт
//
Функция сфпОпределитьКонтактПоНомеруТелефона(НомерТелефона, ВыбратьПервый = Ложь) Экспорт
	МассивЗвонящих = сфпСофтФонПроСервер.сфпНайтиОбъектВРегистреПоТелефону(НомерТелефона);
	СписокКонтактов = Новый СписокЗначений;
	Для Каждого Контакт Из МассивЗвонящих Цикл
		Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Контакт.ВедушийКонтрагент) Тогда
			СписокКонтактов.Добавить(Контакт, Строка(Контакт) + " <" + Строка(Контакт.ВедушийКонтрагент) + ">");
		Иначе
			СписокКонтактов.Добавить(Контакт, Строка(Контакт));
		КонецЕсли;	
	КонецЦикла;
	Если СписокКонтактов.Количество() = 0 Тогда
		Контакт = Неопределено;
	ИначеЕсли СписокКонтактов.Количество() = 1 Тогда
		Контакт = СписокКонтактов[0].Значение;	
	ИначеЕсли ВыбратьПервый Тогда
		Контакт = СписокКонтактов[0].Значение;	
	Иначе	
		ВыбранныйЭлемент = СписокКонтактов.ВыбратьЭлемент(НСтр("ru='Выберите контакт для номера '") + НомерТелефона);
		Если ВыбранныйЭлемент = Неопределено Тогда
			Контакт = Неопределено;
		Иначе	
			Контакт = ВыбранныйЭлемент.Значение;
		КонецЕсли;
	КонецЕсли;
	Возврат Контакт;
КонецФункции // сфпОпределитьКонтактПоНомеруТелефона()

