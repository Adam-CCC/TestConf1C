// СОФТФОН

// Процедура переподключает панели СофтФона
//
// Параметры:
//	ВыводитьПредупреждения	- Булево	- Признак вывода предупреждений
//
Процедура сфпПереподключитьСофтФон(ВыводитьПредупреждения = Истина) Экспорт
	Если НЕ (сфпФормаТелефонВнешняяПанель = Неопределено) И сфпФормаТелефонВнешняяПанель.Открыта() Тогда
		сфпФормаТелефонВнешняяПанель.Закрыть();
	КонецЕсли;	
	сфпФормаТелефонВнешняяПанель = Неопределено;
	ПанельСофтФон = Неопределено;
	#Если ВебКлиент Тогда
	Состояние(Нстр("ru = 'Работа СофтФона невозможна в web-клиенте!'"));
	#Иначе
	Если сфпСофтФонПроСервер.сфпИспользоватьСофтФон() Тогда
		Если сфпСофтФонПроСервер.сфпПолучитьЗначениеПоУмолчаниюПользователя("ИспользоватьСофтФон") Тогда
			РезультатПодключения = Ложь;
			Попытка
				сфпФормаТелефонВнешняяПанель = ПолучитьФорму("Обработка.сфпСофтФонВнешняяПанель.Форма.Форма");
				РезультатПодключения = сфпФормаТелефонВнешняяПанель.Подключиться();
			Исключение
			КонецПопытки;
			Если НЕ РезультатПодключения Тогда
				сфпОткрытьФормуОшибкиПодключения("СофтФон", Нстр("ru = 'Не удалось подключиться к внешней панели СофтФон'"));
			КонецЕсли;
		Иначе
			Если ВыводитьПредупреждения Тогда
				Предупреждение(НСтр("ru = 'В персональных настройках пользователя отключено использование СофтФон'"));
			Иначе
				Состояние(НСтр("ru = 'В персональных настройках пользователя отключено использование СофтФон'"));
			КонецЕсли;	
		КонецЕсли;
	Иначе
		Если ВыводитьПредупреждения Тогда
			Предупреждение(НСтр("ru = 'В настройках системы отключено использование СофтФон'"));
		Иначе
			Состояние(НСтр("ru = 'В настройках системы отключено использование СофтФон'"));
		КонецЕсли;	
	КонецЕсли;
	#КонецЕсли
КонецПроцедуры // сфпПереподключитьСофтФон()	

// Функция проверяет доступность использования СофтФона
//
// Параметры:
//	ВыводитьПредупреждения	- Булево	- Признак вывода предупреждений
//
// Возвращаемое значение:
//	Булево	- Доступность СофтФона
//
Функция сфпПроверитьДоступностьСофтФона(ВыводитьПредупреждения = Истина) Экспорт
	#Если ВебКлиент Тогда
		Состояние(Нстр("ru = 'Работа СофтФона невозможна в web-клиенте!'"));
		Возврат Ложь;
	#Иначе
		Если НЕ сфпСофтФонПроСервер.сфпИспользоватьСофтФон() Тогда
			Если ВыводитьПредупреждения Тогда
				Предупреждение(НСтр("ru = 'В настройках системы отключено использование СофтФон'"));
			КонецЕсли;	
			Возврат Ложь;
		ИначеЕсли НЕ сфпСофтФонПроСервер.сфпПолучитьЗначениеПоУмолчаниюПользователя("ИспользоватьСофтФон") Тогда	
			Если ВыводитьПредупреждения Тогда
				Предупреждение(НСтр("ru = 'В персональных настройках пользователя отключено использование СофтФон'"));
			Иначе
				Состояние(НСтр("ru = 'В персональных настройках пользователя отключено использование СофтФон'"));
			КонецЕсли;	
			Возврат Ложь;
		ИначеЕсли сфпФормаТелефонВнешняяПанель = Неопределено Тогда
			Если ВыводитьПредупреждения Тогда
				Предупреждение(НСтр("ru = 'Отсутствует подключение к серверу СофтФона'"));
			Иначе
				Состояние(НСтр("ru = 'Отсутствует подключение к серверу СофтФона'"));
			КонецЕсли;	
			Возврат Ложь;
		КонецЕсли;	
		Возврат Истина;
	#КонецЕсли
КонецФункции // сфпПроверитьДоступностьСофтФона()	

// Процедура открывает форму ошибки подключения
//
// Параметры:
//	ВидФормы	- Строка	- Вид формы ошибки подключения
//	ТекстОшибки	- Строка	- Текст ошибки
//
Процедура сфпОткрытьФормуОшибкиПодключения(ВидФормы, ТекстОшибки = "") Экспорт
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВидФормы",		ВидФормы);	
	ПараметрыФормы.Вставить("ТекстОшибки",	ТекстОшибки);
	ФормаОшибкиПодключения = ПолучитьФорму("ОбщаяФорма.CRM_СообщенияПодключения", ПараметрыФормы);
	Если ФормаОшибкиПодключения = Неопределено Тогда
		Возврат;
	ИначеЕсли ФормаОшибкиПодключения.Открыта() Тогда
		ФормаОшибкиПодключения.Активизировать();
	Иначе
		ФормаОшибкиПодключения.Открыть();
	КонецЕсли;
КонецПроцедуры // сфпОткрытьФормуОшибкиПодключения()

