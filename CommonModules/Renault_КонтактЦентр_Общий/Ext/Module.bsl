Процедура ОткрытьФормуРЛ(НомерРЛ) Экспорт
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьРЛПоIDK(НомерРЛ);	
	
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураКлючЗаписи = Новый Структура;
	СтруктураКлючЗаписи.Вставить("ID", Запись.ID);
	СтруктураКлючЗаписи.Вставить("IDK", Запись.IDK);
	СтруктураКлючЗаписи.Вставить("Отдел", Запись.Отдел);
	СтруктураКлючЗаписи.Вставить("Подразделение", Запись.Подразделение);
	СтруктураКлючЗаписи.Вставить("ДилерскийЦентр", Запись.ДилерскийЦентр);
	
	КлючЗаписи = РегистрыСведений.Renault_РабочиеЛисты.СоздатьКлючЗаписи(СтруктураКлючЗаписи);
	ЗаполнитьЗначенияСвойств(КлючЗаписи, Запись);
	
	СтруктураПараметрыФормы = Новый Структура;
	СтруктураПараметрыФормы.Вставить("Ключ", КлючЗаписи);
	ОткрытьФорму("РегистрСведений.Renault_РабочиеЛисты.ФормаЗаписи", СтруктураПараметрыФормы);
	
КонецПроцедуры
	
