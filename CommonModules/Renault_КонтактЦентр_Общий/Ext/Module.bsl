Функция ПолучитьПервичныйИнтерес(ДилерскийЦентр) Экспорт
	
	//Первоначальная инициализация
	СписокИнтерес = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_ДилерскиеЦентрыПервичныйИнтерес.ПервичныйИнтерес КАК Ссылка
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры.ПервичныйИнтерес КАК CRM_ДилерскиеЦентрыПервичныйИнтерес
	|ГДЕ
	|	CRM_ДилерскиеЦентрыПервичныйИнтерес.ПервичныйИнтерес.ПометкаУдаления = ЛОЖЬ
	|	И CRM_ДилерскиеЦентрыПервичныйИнтерес.Ссылка = &ДилерскийЦентр
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПервичныйИнтерес";
	Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокИнтерес.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокИнтерес;
	
КонецФункции

