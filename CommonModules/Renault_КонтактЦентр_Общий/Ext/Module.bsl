Функция ПолучитьНастройкиОтправкиКП(Сотрудник) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	CRM_ПользовательскиеДанныеСотрудников.УчетнаяЗаписьПочты,
	                      |	CRM_ПользовательскиеДанныеСотрудников.ТемаПисьмаКП,
	                      |	CRM_ПользовательскиеДанныеСотрудников.ТекстПисьмаКП
	                      |ИЗ
	                      |	РегистрСведений.CRM_ПользовательскиеДанныеСотрудников КАК CRM_ПользовательскиеДанныеСотрудников
	                      |ГДЕ
	                      |	CRM_ПользовательскиеДанныеСотрудников.Сотрудник = &Сотрудник");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Ответ = Новый Структура();
	
	Если Выборка.Следующий() Тогда
		Ответ.Вставить("УчетнаяЗапись", Выборка.УчетнаяЗаписьПочты);
		Ответ.Вставить("Тема", Выборка.ТемаПисьмаКП);
		Ответ.Вставить("Текст", Выборка.ТекстПисьмаКП);
	Иначе
		Ответ.Вставить("УчетнаяЗапись", Справочники.УчетныеЗаписиЭлектроннойПочты.ПустаяСсылка());
		Ответ.Вставить("Тема", "КоммерческиеДанные");
		Ответ.Вставить("Текст", "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ответ.Текст) Тогда
		Ответ.Текст = 	"Уважаемый {Клиент},"+Символы.ПС+ Символы.Пс+
						"Благодарим Вас за интерес, проявленный к модели Renault {Модель},"+
						"и за то, что обратились к официальному дилеру Renault, город {Город}, компания {Дилер}."+Символы.ПС+Символы.Пс+
						"Отправляю Вам копию Вашего коммерческого предложения."+Символы.ПС+
						"Приглашаю Вас в автосалон в удобное для Вас время,"+
						"для прохождения пробной поездки и выбора комплектации автомобиля."+
						"Возьмите с собой водительское удостоверение."+Символы.ПС+
                        "Я всегда к Вашим услугам и буду рад предоставить более подробную информацию по телефону: {Телефон}.";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ответ.Тема) Тогда
		Ответ.Тема = "Коммерческое предложение";
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Процедура СохранитьНастройкиОтправкиКП(Сотрудник, УчетнаяЗаписьПочты, Тема, Текст) Экспорт
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда Возврат КонецЕсли;
	
	Запись = РегистрыСведений.CRM_ПользовательскиеДанныеСотрудников.СоздатьМенеджерЗаписи();
	Запись.Сотрудник = Сотрудник;
	Запись.Прочитать();
	Запись.Сотрудник = Сотрудник;
	Запись.УчетнаяЗаписьПочты = УчетнаяЗаписьПочты;
	Запись.ТемаПисьмаКП = Тема;
	Запись.ТекстПисьмаКП = Текст;
	Запись.Записать();	
	
КонецПроцедуры

