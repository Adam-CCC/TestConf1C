//  	<ОписаниеРезультата>Список с отделами организации для выбора в формах</ОписаниеРезультата>
//  </Результат>
//</Функция>
//</xml>
//@-
Функция ПолучитьСписокОтделовЦентра(ДилерскийЦентр = Неопределено) Экспорт
	
	Если ДилерскийЦентр = Неопределено Тогда
		ДилерскийЦентр = ПолучитьДилерскийЦентрПользователя();
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	
	ЗапросОтделов = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	CRM_Отделы.Ссылка
	               |ИЗ
	               |	Справочник.CRM_Отделы КАК CRM_Отделы
	               |ГДЕ
	               |	CRM_Отделы.ПометкаУдаления = ЛОЖЬ
	               |	И CRM_Отделы.ДилерскийЦентр = &ДилерскийЦентр";
	
	ЗапросОтделов.Текст = ТекстЗапроса;
	ЗапросОтделов.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	Выборка = ЗапросОтделов.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокВыбора.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции // ПолучитьСписокОтделовЦентра()

