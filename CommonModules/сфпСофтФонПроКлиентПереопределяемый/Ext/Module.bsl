// Функция создает и открывает документ "Событие"
//
// Параметры:
//	СтруктураЗвонка	- Структура	- Структура данных звонка
//
Процедура сфпОткрытьСобытие(СтруктураЗвонка)
	Если НЕ (сфпДанныеЗаполнения = Неопределено) И ТипЗнч(сфпДанныеЗаполнения) = Тип("Структура") Тогда
		Если сфпДанныеЗаполнения.Свойство("Основание") И ТипЗнч(сфпДанныеЗаполнения.Основание) = Тип("ДокументСсылка.Событие") Тогда
			СостояниеСобытия = сфпСофтФонПроСервер.сфпВернутьСостояниеСобытияПоСсылке(сфпДанныеЗаполнения.Основание);
			Если Не (СостояниеСобытия = ПредопределенноеЗначение("Перечисление.СостоянияСобытий.Завершено")) 
			И Не (СостояниеСобытия = ПредопределенноеЗначение("Перечисление.СостоянияСобытий.Отменено")) Тогда
				// отличный от стандартного алгоритм: новое событие не создаём, а в текущее событие прописываем тел. звонок
				НовыйЗвонок = сфпСофтФонПроСервер.сфпСоздатьТелефонныйЗвонок(СтруктураЗвонка, сфпДанныеЗаполнения);
				сфпСофтФонПроКлиент.сфпВыполнитьДействияПослеЗаписиТелефонногоЗвонка(НовыйЗвонок, СтруктураЗвонка); 				
				ФормаСобытия = ПолучитьФорму("Документ.Событие.ФормаОбъекта", Новый Структура("Ключ", сфпДанныеЗаполнения.Основание));
				Если ФормаСобытия.Открыта() Тогда
					ФормаСобытия["ДокументОснование"] = НовыйЗвонок;
				Иначе
					ФормаСобытия.Открыть();
					ФормаСобытия["ДокументОснование"] = НовыйЗвонок;
				КонецЕсли;
				ФормаСобытия.Модифицированность = Истина;				
				СтруктураЗвонка.Вставить("ФормаПолучена", Истина);					
			КонецЕсли;				
		КонецЕсли;			
	КонецЕсли;		
	Если СтруктураЗвонка.Свойство("ФормаПолучена") и СтруктураЗвонка.ФормаПолучена Тогда
		Возврат;
	КонецЕсли;		
	ФормаСобытия = сфпИнициализироватьФормуСобытия(СтруктураЗвонка, сфпДанныеЗаполнения);
	Если НЕ (ФормаСобытия = Неопределено) Тогда
		Если ЗначениеЗаполнено(СтруктураЗвонка["МассивЗвонящих"]) И СтруктураЗвонка["МассивЗвонящих"].Количество() > 1 Тогда
			СписокКонтактов = сфпСофтФонПроСервер.сфпСформироватьСписокОбъектовДляВыбораПоМассивуЗвонящих(СтруктураЗвонка["МассивЗвонящих"], Истина);
			Если СписокКонтактов.Количество() = 1 Тогда
				ВыбранныйЭлемент = СписокКонтактов[0];
			Иначе				
				ВыбранныйЭлемент = СписокКонтактов.ВыбратьЭлемент(Нстр(" ru = 'Выберите контакт для номера '") + СтруктураЗвонка["НомерТелефона"]);
				Если ВыбранныйЭлемент = Неопределено Тогда
					СтруктураЗвонка.Вставить("Контакт", СписокКонтактов[0].Значение);			
					ФормаСобытия.Модифицированность = Истина;
					ФормаСобытия.Открыть();
					НовыйЗвонок = сфпСофтФонПроСервер.сфпСоздатьТелефонныйЗвонок(СтруктураЗвонка, сфпДанныеЗаполнения);
					сфпСофтФонПроКлиент.сфпВыполнитьДействияПослеЗаписиТелефонногоЗвонка(НовыйЗвонок, СтруктураЗвонка); 				
					ФормаСобытия["ДокументОснование"] = НовыйЗвонок;
					Возврат;
				КонецЕсли;
			КонецЕсли;
			Если ТипЗнч(ВыбранныйЭлемент.Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
				НовыйУчастник	= ФормаСобытия.ЭтотОбъект["СторонниеЛица"].Добавить();		
				Если ТипЗнч(ВыбранныйЭлемент.Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
					Ведущий = РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(ВыбранныйЭлемент.Значение);			
					Если ЗначениеЗаполнено(Ведущий) Тогда
						ФормаСобытия.ЭтотОбъект["Контрагент"] 		= Ведущий;
						ФормаСобытия.ЭтотОбъект["КонтактноеЛицо"]	= ВыбранныйЭлемент.Значение;
						НовыйУчастник["Контрагент"]					= Ведущий;
						НовыйУчастник["КонтактноеЛицо"]             = ВыбранныйЭлемент.Значение;
					Иначе
						ФормаСобытия.ЭтотОбъект["Контрагент"]		= ВыбранныйЭлемент.Значение;
						ФормаСобытия.ЭтотОбъект["КонтактноеЛицо"]	= Справочники.Контрагенты.ПустаяСсылка();
						НовыйУчастник["Контрагент"]					= ВыбранныйЭлемент.Значение;
					КонецЕсли;			
				КонецЕсли;
			КонецЕсли;
			СтруктураЗвонка.Вставить("Контакт", ВыбранныйЭлемент.Значение);			
			Если Найти(Строка(ВыбранныйЭлемент.Значение), НСтр("ru = '<Объект не найден>'")) > 0 Тогда
				ФормаСобытия.ЭтотОбъект["Содержание"]	= Строка(ТипЗнч(ВыбранныйЭлемент.Значение)) + ": "
				+ сфпСофтФонПроСервер.сфпПолучитьНаименованиеКонтакта(ВыбранныйЭлемент.Значение) + НСтр("ru = ', номер: '") 
				+ сфпСофтФонПроСервер.сфпПолучитьПредставлениеНомераТелефона(ВыбранныйЭлемент.Значение, СтруктураЗвонка.НомерТелефона)
				+ Символы.ПС + НСтр("ru='К данному абоненту в доступе отказано.'")
				+ НСтр("ru=' Для разрешения работы с абонентом обратитесь к руководителю или администратору.'");			
			КонецЕсли;	
			ФормаСобытия.Модифицированность = Истина;
			ФормаСобытия.Открыть();
			НовыйЗвонок = сфпСофтФонПроСервер.сфпСоздатьТелефонныйЗвонок(СтруктураЗвонка, сфпДанныеЗаполнения);
			сфпСофтФонПроКлиент.сфпВыполнитьДействияПослеЗаписиТелефонногоЗвонка(НовыйЗвонок, СтруктураЗвонка); 				
			ФормаСобытия["ДокументОснование"] = НовыйЗвонок;
		Иначе			
			ФормаСобытия.Модифицированность = Истина;
			ФормаСобытия.Открыть();
			НовыйЗвонок = сфпСофтФонПроСервер.сфпСоздатьТелефонныйЗвонок(СтруктураЗвонка, сфпДанныеЗаполнения);
			сфпСофтФонПроКлиент.сфпВыполнитьДействияПослеЗаписиТелефонногоЗвонка(НовыйЗвонок, СтруктураЗвонка); 				
			ФормаСобытия["ДокументОснование"] = НовыйЗвонок;			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры // сфпОткрытьСобытие() 	

