Функция ПолучитьЗаменуКассира(Кассир, Организация, ДатаДок) Экспорт
	
	КассирЗамена = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтпускаКассировСрезПоследних.Кассир,
	|	ОтпускаКассировСрезПоследних.ДатаНачалаОтпуска,
	|	ОтпускаКассировСрезПоследних.ДатаОкончанияОтпуска,
	|	ОтпускаКассировСрезПоследних.Замещает,
	|	ОтпускаКассировСрезПоследних.Замещает.Сотрудник.Контрагент.ИНН КАК ИННКассира,
	|	ОтпускаКассировСрезПоследних.Замещает.Наименование КАК НаименованиеКассира
	|ИЗ
	|	РегистрСведений.ОтпускаКассиров.СрезПоследних(
	|			&ДатаДок,
	|			Кассир = &Кассир
	|				И Организация = &Организация) КАК ОтпускаКассировСрезПоследних";
	Запрос.УстановитьПараметр("Кассир", Кассир);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаДок", ДатаДок);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ДатаНачалаОтпуска < ДатаДок И ДатаДок < КонецДня(Выборка.ДатаОкончанияОтпуска) Тогда 
			КассирЗамена = Выборка.Замещает;
		КонецЕсли;
	КонецЕсли;
	
	Возврат КассирЗамена; 
	
КонецФункции