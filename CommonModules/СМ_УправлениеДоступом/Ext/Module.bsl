Процедура ОткрытьВсеЭлементыФормы(Форма) Экспорт
	Для Каждого ТекЭлемент из Форма.ЭлементыФормы Цикл
		РазрешитьРедактирование(Форма,ТекЭлемент);
	КонецЦикла;
	
	// Бондаренко++ 20211224
	ОбъектМетаданных = Форма.Ссылка.Метаданные();
	Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Попытка
			КоманднаяПанельОсновныеДействия = Форма.ЭлементыФормы.ОсновныеДействияФормы;
			Если ТипЗнч(КоманднаяПанельОсновныеДействия) = Тип("КоманднаяПанель") Тогда
				КоманднаяПанельОсновныеДействия.Доступность = Истина;
				Для Каждого КнопкаПанели Из КоманднаяПанельОсновныеДействия.Кнопки Цикл
					КнопкаПанели.Доступность = Истина;
				КонецЦикла;
			КонецЕсли;		
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Бондаренко-- 20211224

КонецПроцедуры
 
Процедура ЗакрытьВсеЭлементыФормы(Форма) Экспорт
	Для Каждого ТекЭлемент из Форма.ЭлементыФормы Цикл
		Если ТипЗнч(ТекЭлемент) = Тип("Надпись") Тогда			
			Продолжить;
		КонецЕсли;
		
 		Попытка	
			ТекЭлемент.ТолькоПросмотр = Истина; 
		Исключение
			Если ТипЗнч(ТекЭлемент)<>Тип("Панель") Тогда
 				Попытка	
					ТекЭлемент.Доступность = Ложь;  
				Исключение 
					//
				КонецПопытки;
			КонецЕсли;						
		КонецПопытки;
	КонецЦикла;
	Попытка
		ЗапретитьРедактированиеКолонок(Форма.ЭлементыФормы.Товары);
	Исключение
		//	
	КонецПопытки; 
	
	// Семенихин 17.12.2021 +++++
	ОбъектМетаданных = Форма.Ссылка.Метаданные();
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Попытка
			КоманднаяПанельДействия = Форма.ЭлементыФормы.ДействияФормы;
			Если ТипЗнч(КоманднаяПанельДействия) = Тип("КоманднаяПанель") Тогда
				КоманднаяПанельДействия.Доступность = Истина; 
			КонецЕсли;		
		Исключение
		КонецПопытки;		
	
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Попытка
			КоманднаяПанельДействия = Форма.ЭлементыФормы.ДействияФормы;
			Если ТипЗнч(КоманднаяПанельДействия) = Тип("КоманднаяПанель") Тогда
				КоманднаяПанельДействия.Доступность = Истина;
			КонецЕсли;		
		Исключение
		КонецПопытки;
		Попытка
			КоманднаяПанельОсновныеДействия = Форма.ЭлементыФормы.ОсновныеДействияФормы;
			Если ТипЗнч(КоманднаяПанельОсновныеДействия) = Тип("КоманднаяПанель") Тогда
				КоманднаяПанельОсновныеДействия.Доступность = Истина;
				Для Каждого КнопкаПанели Из КоманднаяПанельОсновныеДействия.Кнопки Цикл
					КнопкаПанели.Доступность = Ложь;
				КонецЦикла;
				//Бондаренко++ 20211224 
				Попытка КоманднаяПанельОсновныеДействия.Кнопки.Закрыть.Доступность = Истина; Исключение	КонецПопытки; 
				Попытка КоманднаяПанельОсновныеДействия.Кнопки.ДействиеЗакрыть.Доступность = Истина; Исключение	КонецПопытки; 
				//Бондаренко-- 20211224 
			КонецЕсли;		
		Исключение
		КонецПопытки;
	КонецЕсли;
	// Семенихин 20.12.2021 -----
КонецПроцедуры
 
