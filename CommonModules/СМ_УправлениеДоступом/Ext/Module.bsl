Процедура НастроитьОтборПоПодразделениям(ЭтаФорма, Подразделение, Отбор) Экспорт
	Если Отбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	сзГруппыПодразделений = Новый СписокЗначений();
	сзГруппыПодразделений.Добавить(Подразделение);
	
	//Бондаренко++ 20220908
	ТекущийСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
	Если ЗначениеЗаполнено(ТекущийСотрудник) Тогда
		Для Каждого СтрокаПодразделение Из ТекущийСотрудник.ТаблицаПодразделенийРаботы Цикл
			Если СтрокаПодразделение.ПодразделениеРаботы = Подразделение Тогда
				Продолжить;
			КонецЕсли;	
			Если СтрокаПодразделение.ПодразделениеРаботы = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
				Продолжить;				
			КонецЕсли;
			сзГруппыПодразделений.Добавить(СтрокаПодразделение.ПодразделениеРаботы);
		КонецЦикла;
	КонецЕсли;             
	//Бондаренко++ 20220908
	
	ЗапросПодразделения = Новый Запрос;
	ЗапросПодразделения.Текст =
	"ВЫБРАТЬ
	|ПодразделенияКомпании.Ссылка
	|ИЗ
	|Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&Подразделение)";
	
	сзПодразделенияОтбора = Новый СписокЗначений();
	Для Каждого ЗлементГруппа Из сзГруппыПодразделений Цикл
		ЗапросПодразделения.Параметры.Вставить("Подразделение", ЗлементГруппа.Значение);
		мПодразделенияОтбора = ЗапросПодразделения.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Для Каждого ПодразделениеОтбора Из мПодразделенияОтбора Цикл
			сзПодразделенияОтбора.Добавить(ПодразделениеОтбора);
		КонецЦикла;		
	КонецЦикла;
	
	Если ЭтаФорма.ЭлементыФормы.Найти("ПодразделениеКомпании") <> Неопределено Тогда
		ЭтаФорма.ЭлементыФормы.ПодразделениеКомпании.Значение = Подразделение;
		//ЭтаФорма.ЭлементыФормы.ПодразделениеКомпании.Доступность = Ложь;
		//ЭтаФорма.ЭлементыФормы.Список.НастройкаОтбора.ПодразделениеКомпании.Доступность = Ложь;
		
	ИначеЕсли ЭтаФорма.ЭлементыФормы.Найти("Подразделение") <> Неопределено Тогда
		ЭтаФорма.ЭлементыФормы.Подразделение.Значение = Подразделение;
		//ЭтаФорма.ЭлементыФормы.Подразделение.Доступность = Ложь;
		//ЭтаФорма.ЭлементыФормы.Список.НастройкаОтбора.Подразделение.Доступность = Ложь;
	КонецЕсли;
	
	Если Отбор.Найти("ПодразделениеКомпании") <> Неопределено Тогда
		Отбор.ПодразделениеКомпании.ВидСравнения  = ВидСравнения.ВСписке;
		Отбор.ПодразделениеКомпании.Значение  = сзПодразделенияОтбора;
		Отбор.ПодразделениеКомпании.Использование  = Истина;
		
	ИначеЕсли Отбор.Найти("Подразделение") <> Неопределено Тогда
		Отбор.Подразделение.ВидСравнения  = ВидСравнения.ВСписке;
		Отбор.Подразделение.Значение  = сзПодразделенияОтбора;
		Отбор.Подразделение.Использование  = Истина;
	КонецЕсли;	
КонецПроцедуры

Процедура УстановитьДоступКДокументу(ФормаДокумента) Экспорт
	Если обЗначениеНеЗаполнено(ФормаДокумента) Тогда
		Возврат;
	ИначеЕсли ФормаДокумента.ЭтоНовый() Тогда
		Возврат;
	Иначе
		омДокумент = ФормаДокумента.ДокументОбъект.Метаданные();
	КонецЕсли;
	
	Если омДокумент.Реквизиты.Найти("ПодразделениеКомпании") <> Неопределено Тогда
		ПодразделениеДокумента = ФормаДокумента.ДокументОбъект.ПодразделениеКомпании;
	ИначеЕсли омДокумент.Реквизиты.Найти("Подразделение") <> Неопределено Тогда
		ПодразделениеДокумента = ФормаДокумента.ДокументОбъект.Подразделение;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(ПодразделениеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПодразделения = Новый Запрос;
	ЗапросПодразделения.Текст =
	"ВЫБРАТЬ
	|ПодразделенияКомпании.Ссылка
	|ИЗ
	|Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&Подразделение)";
	
	сзГруппыПодразделений = Новый СписокЗначений();
	ТекущийСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
	Если ЗначениеЗаполнено(ТекущийСотрудник) Тогда
		Для Каждого СтрокаПодразделение Из ТекущийСотрудник.ТаблицаПодразделенийРаботы Цикл
			сзГруппыПодразделений.Добавить(СтрокаПодразделение.ПодразделениеРаботы);
		КонецЦикла;
	КонецЕсли;
	
	ЭтоЧужойДокумент = Истина;
	Для Каждого ЗлементГруппа Из сзГруппыПодразделений Цикл
		ЗапросПодразделения.Параметры.Вставить("Подразделение", ЗлементГруппа.Значение);
		мПодразделенияОтбора = ЗапросПодразделения.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Если мПодразделенияОтбора.Найти(ПодразделениеДокумента) <> Неопределено Тогда
			ЭтоЧужойДокумент = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ФормаДокумента.ТолькоПросмотр = ЭтоЧужойДокумент;
КонецПроцедуры

Процедура УстановитьПодразделениеДляОтбора(ПользовательСсылка, ПодразделениеДляОтбора) Экспорт
	мзПраваИНастройки = РегистрыСведений.ПраваИНастройки.СоздатьМенеджерЗаписи();
	мзПраваИНастройки.Объект = ПользовательСсылка;
	мзПраваИНастройки.ПравоНастройка = ПланыВидовХарактеристик.ПраваИНастройки.ПодразделениеДляПросмотраИОтбора;
	Если ЗначениеЗаполнено(ПодразделениеДляОтбора) Тогда
		мзПраваИНастройки.Значение = ПодразделениеДляОтбора;
		Попытка
			мзПраваИНастройки.Записать();
		Исключение
			Сообщить("Не удалось сохранить настройку ПодразделениеДляПросмотраИОтбора!", СтатусСообщения.Внимание);
		КонецПопытки;
		
	Иначе
		мзПраваИНастройки.Прочитать();
		Если мзПраваИНастройки.Выбран() Тогда
			мзПраваИНастройки.Удалить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ЭтоРабочаяБаза() Экспорт
