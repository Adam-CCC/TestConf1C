	Возврат Найти(СтрокаСоединения, "1cserver") > 0 И Найти(СтрокаСоединения, "alfaauto") > 0;
КонецФункции

Функция ДокументНеДоступен(ДокументСсылка) Экспорт
	Если РольДоступна("ПолныеПрава") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ПодразделениеКомпании = ДокументСсылка.ПодразделениеКомпании;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	НеДоступен = Истина;
	ТекущийСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
	Для Каждого СтрокаПодразделение Из ТекущийСотрудник.ТаблицаПодразделенийРаботы Цикл
		Если СтрокаПодразделение.ПодразделениеРаботы = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПодразделениеКомпании = СтрокаПодразделение.ПодразделениеРаботы 
			Или ПодразделениеКомпании.ПринадлежитЭлементу(СтрокаПодразделение.ПодразделениеРаботы) Тогда
			НеДоступен = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат НеДоступен;
КонецФункции
