Процедура РазрешитьРедактированиеКолонок(Форма,ТекЭлемент,СписокКолонок) Экспорт
	Если ТипЗнч(ТекЭлемент)=Тип("ТабличноеПоле") Тогда
		СписокЗн = РазложитьСтрокуВСписок(СписокКолонок,";");
 		Для каждого ТекКолонка Из ТекЭлемент.Колонки Цикл
			Если СписокЗн.Количество() > 0 Тогда
	 			Если СписокЗн.НайтиПоЗначению(ТекКолонка.Имя)<>Неопределено Тогда
					ТекКолонка.ТолькоПросмотр=Ложь;	
 				КонецЕсли; 
			Иначе
				ТекКолонка.ТолькоПросмотр=Ложь;	
 			КонецЕсли; 
  		КонецЦикла; 
	КонецЕсли;
 КонецПроцедуры	

Процедура ЗапретитьРедактированиеКолонок(ТекЭлемент) Экспорт
	Если ТипЗнч(ТекЭлемент) = Тип("ТабличноеПоле") Тогда
		Для каждого ТекКолонка Из ТекЭлемент.Колонки Цикл
	 		ТекКолонка.ТолькоПросмотр=Истина;	
	 	КонецЦикла; 
	КонецЕсли;
КонецПроцедуры

Функция РазложитьСтрокуВСписок(Знач ИсходнаяСтрока, Разделитель = ";") Экспорт
	
	//Сначала получаем массив
	Если СокрЛП(ИсходнаяСтрока) = "" Тогда
		МассивСтрок = Новый Массив;
 	Иначе
		МассивСтрок = РазложитьСтрокуВМассивПодстрок(ИсходнаяСтрока, ";");
 	КонецЕсли; 
 	
	//Теперь массив загружаем в СписокЗначений
	СписокСтрок = Новый СписокЗначений;
	СписокСтрок.ЗагрузитьЗначения(МассивСтрок);

	Возврат СписокСтрок;
	
КонецФункции // РазложитьСтрокуВСписок(Знач ИсходнаяСтрока, Разделитель = ";")

Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ";") Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ";")
