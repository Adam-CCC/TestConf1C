Процедура УстановитьСтатусНекорректныйФПК(Параметры = Неопределено) Экспорт
	СписокСтатусов = Новый Массив();
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Интерес);
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Создан);
	
	ЗапросРабЛисты = Новый Запрос();
	ЗапросРабЛисты.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
	ЗапросРабЛисты.Текст =
	"ВЫБРАТЬ
	|	РабочийЛист.Ссылка КАК РабЛист,
	|	РабочийЛист.ТолькоБУ КАК ТолькоБУ,
	|	РабочийЛист.ЮридическоеЛицо КАК ЮридическоеЛицо
	|ИЗ
	|	Документ.РабочийЛист КАК РабочийЛист
	|ГДЕ
	|	РабочийЛист.Статус В(&СписокСтатусов)
	|	И РабочийЛист.ПредставлениеТелефона ПОДОБНО ""+7, 800%""
	|	И РабочийЛист.ВидОплаты <> ЗНАЧЕНИЕ(Перечисление.ВидыОплаты.Лизинг)";
	
	ВыборкаРабЛисты = ЗапросРабЛисты.Выполнить().Выбрать();
	ВсегоСтрок = ВыборкаРабЛисты.Количество();
	Если ВсегоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	сч = 1;
	Пока ВыборкаРабЛисты.Следующий() Цикл
		ЗавершитьЗапланированныеСобытия(ВыборкаРабЛисты.РабЛист);
		
		Если Не ВыборкаРабЛисты.ТолькоБУ Тогда // добавить Отказ
			СобытиеОбъект = Документы.Событие.СоздатьДокумент();
			СобытиеОбъект.Заполнить(ВыборкаРабЛисты.РабЛист);
			СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Завершено;
			СобытиеОбъект.Приоритет = Перечисления.Важность.Средняя;
			СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля;
			СобытиеОбъект.Результат = "Некорректный ФПК";
			СобытиеОбъект.ДатаНачала = ТекущаяДата();
			СобытиеОбъект.ДатаОкончания = СобытиеОбъект.ДатаНачала + 900;
			СобытиеОбъект.ПредметОбращения = Справочники.ПредметыОбращения.Автосалон;
			СобытиеОбъект.ВторичныйКонтакт = Истина;
			Если ВыборкаРабЛисты.ЮридическоеЛицо Тогда
				СобытиеОбъект.ТипКлиента = Перечисления.ФормыСобственности.ЮридическоеЛицо;
			Иначе
				СобытиеОбъект.ТипКлиента = Перечисления.ФормыСобственности.ЧастноеЛицо;
			КонецЕсли;
			
			Попытка
				СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				СобытиеОбъект.ОбменДанными.Загрузка = Истина;
				СобытиеОбъект.Записать();
				СМ_ВыгрузкаВАвтодилер.РегистрацияИзмененныхДокументов(СобытиеОбъект, Ложь);
			КонецПопытки;
		КонецЕсли;
		
		// записать РЛ
		РабЛистОбъект = ВыборкаРабЛисты.РабЛист.ПолучитьОбъект();
		РабЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.ОшибочныйНомер;
		ПричинаОтказа = Справочники.ВозраженияИПричиныОтказов.НайтиПоКоду("ЦБ000018"); //Неправильный номер телефона
		РабЛистОбъект.ПричинаОтказа = ПричинаОтказа;
		РабЛистОбъект.Комментарий = РабЛистОбъект.Комментарий + "; Автоматически установлен статус <Некорректный ФПК> " +
		Формат(ТекущаяДата(), "ДЛФ=ДД");
		
		Попытка
			РабЛистОбъект.Записать();
		Исключение
			РабЛистОбъект.ОбменДанными.Загрузка = Истина;
			РабЛистОбъект.Записать();
			СМ_ВыгрузкаВАвтодилер.РегистрацияИзмененныхДокументов(РабЛистОбъект, Ложь);
		КонецПопытки;
		
		Сообщить("Обработано строк " + сч + " из " + ВсегоСтрок, СтатусСообщения.Информация);
		сч = сч + 1;
	КонецЦикла;
КонецПроцедуры

Процедура ЗавершитьЗапланированныеСобытия(РабЛист)
	Если обЗначениеНеЗаполнено(РабЛист) Тогда
		Возврат;
	КонецЕсли;
	
	СписокВидов = Новый Массив();
	СписокВидов.Добавить(Перечисления.ВидыСобытий.ЛичнаяВстреча);
	СписокВидов.Добавить(Перечисления.ВидыСобытий.ТелефонныйЗвонок);
	СписокВидов.Добавить(Перечисления.ВидыСобытий.ЗаявкаССайта);
	СписокВидов.Добавить(Перечисления.ВидыСобытий.ТестДрайв);
	
	ЗапросЗапланированные = Новый Запрос();
	ЗапросЗапланированные.УстановитьПараметр("РабочийЛист", РабЛист);
	ЗапросЗапланированные.УстановитьПараметр("СписокВидов", СписокВидов);
	ЗапросЗапланированные.УстановитьПараметр("Запланировано", Перечисления.СостоянияСобытий.Запланировано);
	ЗапросЗапланированные.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ДокументОснование = &РабочийЛист
	|	И Событие.ВидСобытия В(&СписокВидов)
	|	И Событие.Состояние = &Запланировано";
	
	ВыборкаЗапланированные = ЗапросЗапланированные.Выполнить().Выбрать();
	Пока ВыборкаЗапланированные.Следующий() Цикл
		СобытиеОбъект = ВыборкаЗапланированные.Ссылка.ПолучитьОбъект();
		Если СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ТестДрайв Тогда
			СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Отменено;
		Иначе
			СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Завершено;
		КонецЕсли;
		СобытиеОбъект.Результат = "Клиент отказся сообщить номер телефона.";
		
		Попытка
			СобытиеОбъект.Записать();
		Исключение
			Сообщить("Ошибка при отмене запланированного " + Строка(СобытиеОбъект) + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;		
	КонецЦикла;
КонецПроцедуры
