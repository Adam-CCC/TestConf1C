Процедура РаспределитьРабочиеЛистыУволенныхМОП(Параметры = Неопределено) Экспорт
	АктивныеСтатусы = Новый Массив();
	АктивныеСтатусы.Добавить(Справочники.СтатусыРабочегоЛиста.Создан);
	АктивныеСтатусы.Добавить(Справочники.СтатусыРабочегоЛиста.Интерес);
	АктивныеСтатусы.Добавить(Справочники.СтатусыРабочегоЛиста.Сделка);
	АктивныеСтатусы.Добавить(Справочники.СтатусыРабочегоЛиста.Архив);
	
	ЗапросРЛ = Новый Запрос();
	ЗапросРЛ.УстановитьПараметр("АктивныеСтатусы", АктивныеСтатусы);
	ЗапросРЛ.Текст =
	"ВЫБРАТЬ
	|	РабочийЛист.Ссылка КАК Ссылка,
	|	РабочийЛист.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	Документ.РабочийЛист КАК РабочийЛист
	|ГДЕ
	|	РабочийЛист.Менеджер.ФлагУволен
	|	И РабочийЛист.Менеджер.Подразделение В ИЕРАРХИИ(&ГруппаПодразделений)
	|	И РабочийЛист.Статус В(&АктивныеСтатусы)
	|	И НЕ РабочийЛист.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЛист.Дата";
	
	ЗапросПереводРЛ = Новый Запрос();
	ЗапросПереводРЛ.УстановитьПараметр("АктивныеСтатусы", АктивныеСтатусы);
	ЗапросПереводРЛ.УстановитьПараметр("МенеджерОП", Справочники.Должности.МенеджерОтделаПродажАвтомобилей);
	ЗапросПереводРЛ.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка
	|ПОМЕСТИТЬ ПереведенныеСотрудники
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Должность = &МенеджерОП
	|	И НЕ Сотрудники.Подразделение В ИЕРАРХИИ (&ГруппаПодразделений)
	|	И НЕ Сотрудники.ФлагУволен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочийЛист.Ссылка КАК Ссылка,
	|	РабочийЛист.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	Документ.РабочийЛист КАК РабочийЛист
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПереведенныеСотрудники КАК ПереведенныеСотрудники
	|		ПО РабочийЛист.Менеджер = ПереведенныеСотрудники.Ссылка
	|ГДЕ
	|	РабочийЛист.Статус В(&АктивныеСтатусы)
	|	И НЕ РабочийЛист.ПометкаУдаления
	|	И РабочийЛист.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделений)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЛист.Дата";
	
	ЗапросМОП = Новый Запрос();
	ЗапросМОП.УстановитьПараметр("МенеджерОП", Справочники.Должности.МенеджерОтделаПродажАвтомобилей);
	ЗапросМОП.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Подразделение В ИЕРАРХИИ(&ГруппаПодразделений)
	|	И Сотрудники.Должность = &МенеджерОП
	|	И НЕ Сотрудники.ФлагУволен";
	
	сзМенеджерыОП = Новый СписокЗначений;
	ПодразделенияВыборка = Справочники.ПодразделенияКомпании.Выбрать(Справочники.ПодразделенияКомпании.ОсновноеПодразделение,,, "Наименование");
	Пока ПодразделенияВыборка.Следующий() Цикл
		КодПодр = ПодразделенияВыборка.Код;
		Если КодПодр = "ЦБ001247" Или КодПодр = "00002" Тогда // _Управляющая компания или ОПТ
			Продолжить;
			
		ИначеЕсли ПодразделенияВыборка.Ссылка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		ЗапросМОП.УстановитьПараметр("ГруппаПодразделений", ПодразделенияВыборка.Ссылка);
	 	сзМенеджерыОП.ЗагрузитьЗначения(ЗапросМОП.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		Если сзМенеджерыОП.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗапросРЛ.УстановитьПараметр("ГруппаПодразделений", ПодразделенияВыборка.Ссылка);
		выбРабочиеЛисты = ЗапросРЛ.Выполнить().Выбрать();
		Если выбРабочиеЛисты.Количество() > 0 Тогда
			РаспределитьРабочиеЛисты(выбРабочиеЛисты, сзМенеджерыОП);
		КонецЕсли;
		
		//ЗапросПереводРЛ.УстановитьПараметр("ГруппаПодразделений", ПодразделенияВыборка.Ссылка);
		//выбРабочиеЛисты = ЗапросПереводРЛ.Выполнить().Выбрать();
		//РаспределитьРабочиеЛисты(выбРабочиеЛисты, сзМенеджерыОП);
	КонецЦикла;	
КонецПроцедуры

Процедура РаспределитьРабочиеЛисты(ВыборкаРЛ, СписокМенеджеров) Экспорт
	КоличествоМенеджеров = СписокМенеджеров.Количество();
	ТекущаяДата = ТекущаяДата();
	ВсегоДокументов = ВыборкаРЛ.Количество();
	
	сч = 0;
	сч1 = 0;
	КоличествоМенеджеровБезДоступа = 0;
	ЕстьРабЛисты = ВыборкаРЛ.Следующий();	
	Пока ЕстьРабЛисты Цикл			
		Для Каждого Менеджер Из СписокМенеджеров Цикл
			Если ЕстьДоступКДокументам(Менеджер.Значение, ВыборкаРЛ.ПодразделениеКомпании) Тогда
				ПередатьРабочийЛист(ВыборкаРЛ.Ссылка, Менеджер.Значение);
				сч = сч + 1;
				
				ЕстьРабЛисты = ВыборкаРЛ.Следующий();
				Если Не ЕстьРабЛисты Тогда
					Прервать;
				КонецЕсли;
				
			Иначе
				КоличествоМенеджеровБезДоступа = КоличествоМенеджеровБезДоступа + 1;
				Если КоличествоМенеджеровБезДоступа = КоличествоМенеджеров Тогда
					РОП = ВыборкаРЛ.ПодразделениеКомпании.РуководительОП;
					Если ЗначениеЗаполнено(РОП) Тогда
						ПередатьРабочийЛист(ВыборкаРЛ.Ссылка, РОП);
						сч = сч + 1;
					Иначе
						сч1 = сч1 + 1;
					КонецЕсли;
					
					ЕстьРабЛисты = ВыборкаРЛ.Следующий();
					Если Не ЕстьРабЛисты Тогда
						Прервать;
					КонецЕсли;
					КоличествоМенеджеровБезДоступа = 0;
					
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		КоличествоМенеджеровБезДоступа = 0;
		#Если Клиент Тогда
		Состояние("Обработано: " + Строка(сч + сч1) + " документов из " + ВсегоДокументов);
		#КонецЕсли
	КонецЦикла;
	
	#Если Клиент Тогда
	Состояние();
	Сообщить("Модифицировано рабочих листов: " + Строка(сч) + ".", СтатусСообщения.Информация);
	Если сч1 > 0 Тогда
		Сообщить("Не удалось записать: " + Строка(сч1) + " рабочих листов.", СтатусСообщения.Внимание);
	КонецЕсли;
	#КонецЕсли
КонецПроцедуры

Функция ЕстьДоступКДокументам(Сотрудник, Подразделение)
	Если Сотрудник.Подразделение = Подразделение Тогда
		Возврат Истина;
	Иначе
		ЕстьДоступ = Ложь;	
	КонецЕсли;
	
	Для Каждого СтрокаПодразделение Из Сотрудник.ТаблицаПодразделенийРаботы Цикл
		Если СтрокаПодразделение.ПодразделениеРаботы = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
			Продолжить;
		КонецЕсли;
		
		Если Подразделение = СтрокаПодразделение.ПодразделениеРаботы 
			Или Подразделение.ПринадлежитЭлементу(СтрокаПодразделение.ПодразделениеРаботы) Тогда
			ЕстьДоступ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьДоступ;
КонецФункции

Процедура ПередатьРабочийЛист(РабочийЛистСсылка, Менеджер)
	РабочийЛист = РабочийЛистСсылка.ПолучитьОбъект();
	РабочийЛист.Менеджер = Менеджер;
	РабочийЛист.ДатаИзменения = ТекущаяДата();
	#Если Клиент Тогда
		НовыйКомментарий = "Оператор: " + Строка(ПараметрыСеанса.Пользователь) + ".";
	#Иначе
		НовыйКомментарий = "Распределение РЛ уволенных МОП.";
	#КонецЕсли
	РабочийЛист.Комментарий = РабочийЛист.Комментарий + Символы.ПС + НовыйКомментарий +
	" Передан " + Формат(ТекущаяДата(), "ДЛФ=ДВ") + " от " + Строка(РабочийЛист.Ссылка.Менеджер);
	
	РабочийЛистЗаписан = Истина;
	Попытка
		РабочийЛист.ОбменДанными.Загрузка = Истина;
		РабочийЛист.Записать();
	Исключение
		РабочийЛистЗаписан = Ложь;
	КонецПопытки;

	Если РабочийЛистЗаписан Тогда
		ПередатьЗапланированныеСобытия(РабочийЛистСсылка, Менеджер)
	КонецЕсли;
КонецПроцедуры

Процедура ПередатьЗапланированныеСобытия(РабочийЛист, Менеджер)
	ЗапросСобытия = Новый Запрос();
	ЗапросСобытия.УстановитьПараметр("Запланировано", Перечисления.СостоянияСобытий.Запланировано);
	ЗапросСобытия.УстановитьПараметр("РабочийЛист", РабочийЛист);
	ЗапросСобытия.Текст = "ВЫБРАТЬ
	                      |	Событие.Ссылка,
	                      |	Событие.ДатаНачала,
	                      |	Событие.ДатаОкончания,
	                      |	Событие.Содержание
	                      |ИЗ
	                      |	Документ.Событие КАК Событие
	                      |ГДЕ
	                      |	Событие.Состояние = &Запланировано
	                      |	И Событие.ДокументОснование = &РабочийЛист";

	ВыборкаСобытия = ЗапросСобытия.Выполнить().Выбрать();
	Пока ВыборкаСобытия.Следующий() Цикл
		ДокументСобытие = ВыборкаСобытия.Ссылка.ПолучитьОбъект();
		ДокументСобытие.Продавец = Менеджер;
		Попытка
			ДокументСобытие.ОбменДанными.Загрузка = Истина;
			ДокументСобытие.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры
