Процедура ПроверкаНачалаОбслуживания(Параметры = Неопределено) Экспорт
	
	ТекущаяДата = ТекущаяДата();
	КонецПериода = ТекущаяДата - 900;
	НачалоПериода = КонецПериода - 1200; // запас = 5 минут 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаявкаНаРемонт.Ссылка,
	|	ЗаявкаНаРемонт.Дата,
	|	ЗаявкаНаРемонт.Диспетчер
	|ИЗ
	|	Документ.ЗаявкаНаРемонт КАК ЗаявкаНаРемонт
	|ГДЕ
	|	ЗаявкаНаРемонт.ДатаНачала МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ЗаявкаНаРемонт.ХозОперация = &Опреация";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Опреация", Справочники.ХозОперации.ПланРемонта);
	
	ПланыРемонта = Запрос.Выполнить().Выгрузить();
	Для Каждого ПланРемонта Из ПланыРемонта Цикл
		
		ЗаказНарядСоздан = Ложь;	
		ВыборкаЗН = Документы.ЗаказНаряд.Выбрать(ПланРемонта.Дата, ТекущаяДата);
		Пока ВыборкаЗН.Следующий() Цикл
			Если ВыборкаЗН.ДокументОснование = ПланРемонта.Ссылка Тогда
				ЗаказНарядСоздан = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЗаказНарядСоздан Тогда
			Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", ПланРемонта.Диспетчер);
			Если Пользователь <> Неопределено И Не Пользователь.Пустая() Тогда
				НаборЗаписей = РегистрыСведений.Напоминания.СоздатьНаборЗаписей();
				Запись = НаборЗаписей.Добавить();
				Запись.Автор = Справочники.Пользователи.Робот;
				Запись.Пользователь = Пользователь;
				Запись.Объект = ПланРемонта.Ссылка;
				Запись.РеальнаяДатаОповещения = ТекущаяДата;
				Запись.ДатаНачала = ТекущаяДата;
				Запись.ТипПериода = "00";
				Запись.УдалитьПоИстеченииСрока = Истина;
				Запись.Тема = "Проверка начала обслуживания клиента";
				Запись.Описание = "С момента начала работ прошло 15 минут, однако соответствующий заказ-наряд ещё не создан!";
				НаборЗаписей.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Процедура СоставлениеСпискаНеликвидов(Параметры = Неопределено) Экспорт
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПартииТоваровКомпании.Номенклатура,
	               |	СУММА(ПартииТоваровКомпании.Количество) КАК КоличествоРасход,
	               |	0 КАК КоличествоОстаток
	               |ПОМЕСТИТЬ ОстаткиИРасход
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	               |ГДЕ
	               |	ПартииТоваровКомпании.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |	И НЕ ПартииТоваровКомпании.Регистратор ССЫЛКА Документ.ПеремещениеТоваров
	               |	И ВЫБОР
	               |			КОГДА ПартииТоваровКомпании.Регистратор ССЫЛКА Документ.РеализацияТоваров
	               |				ТОГДА НЕ ПартииТоваровКомпании.Регистратор.Контрагент.НашаФирма
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПартииТоваровКомпании.Номенклатура
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ПартииТоваровКомпании.Количество) > 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПартииТоваровКомпанииОстатки.Номенклатура,
	               |	0,
	               |	СУММА(ПартииТоваровКомпанииОстатки.КоличествоОстаток)
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровКомпании.Остатки(&ДатаНачала, ) КАК ПартииТоваровКомпанииОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПартииТоваровКомпанииОстатки.Номенклатура
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ПартииТоваровКомпанииОстатки.КоличествоОстаток) > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОстаткиИРасход.Номенклатура
	               |ИЗ
	               |	ОстаткиИРасход КАК ОстаткиИРасход
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиИРасход.Номенклатура
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ОстаткиИРасход.КоличествоРасход) = 0";
				   
	ДатаОкончания = ТекущаяДата();
	ДатаНачала = ДобавитьМесяц(ДатаОкончания, -12); 
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
    СписокНеликвидов = Запрос.Выполнить().Выгрузить();
	НаборНеликвидов = РегистрыСведений.УценкаТоваров.СоздатьНаборЗаписей();
	НаборНеликвидов.Загрузить(СписокНеликвидов);
	НаборНеликвидов.Записать();
КонецПроцедуры

