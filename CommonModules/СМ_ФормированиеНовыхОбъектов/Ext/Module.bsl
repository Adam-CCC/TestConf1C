Функция СМГ_ОтменаПроведенияАктОказанияУслугСубподряд(Источник) Экспорт
	
	ФлОтказ = Ложь;  
	
	ПоступлениеТоваров = "";
	
	//Бондаренко++ 20220802
	Если РольДоступна("ПолныеПрава") Тогда
		Возврат ФлОтказ;
	КонецЕсли;             
	//Бондаренко-- 20220802

	Запрос = Новый Запрос;
	
   	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваров.Ссылка КАК Поступление_Товаров
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.ДокументОснование = &ДокументОснование
	|	И ПоступлениеТоваров.ХозОперация = &ХозОперация
	|	И ПоступлениеТоваров.Организация.КонтрагентОрганизации = &КонтрагентИсточника";
 	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
	Запрос.УстановитьПараметр("ХозОперация", Справочники.ХозОперации.УслугиПоСубподряду);
 	Запрос.УстановитьПараметр("КонтрагентИсточника", Источник.Контрагент);	
	
	РезультатЗапроса = Запрос.Выполнить();
  	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
  	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПоступлениеТоваров = ВыборкаДетальныеЗаписи.Поступление_Товаров.ПолучитьОбъект();
 	КонецЦикла;
	
	Если НЕ обЗначениеНеЗаполнено(ПоступлениеТоваров) Тогда
		Попытка
			ПоступлениеТоваров.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
			Сообщить("Подчинённый документ "+СокрЛП(ПоступлениеТоваров)+" стал непроведённым.",СтатусСообщения.Обычное);			
		Исключение
			ФлОтказ = Истина;	
			#Если Клиент Тогда
				Сообщить("ОШИБКА! Документ '"+ПоступлениеТоваров+"'. Не удалось отменить проведение.",СтатусСообщения.ОченьВажное);
			#КонецЕсли 
		КонецПопытки; 
		
		 Если Не ФлОтказ Тогда
			СМГ_ОтменаПроведенияСФполученный(ПоступлениеТоваров);
		КонецЕсли;
	КонецЕсли;

	Возврат ФлОтказ;
	
КонецФункции // СМГ_ОтменаПроведенияАктОказанияУслугСубподряд(Источник) 

Функция СМГ_ОтменаПроведенияСФполученный(Источник)
	
	ФлОтказ = Ложь;
	
	Запрос = Новый Запрос;
	
	СчетФактура = "";
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураПолученный.Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.ДокументОснование = &ДокументОснование";
 	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
  	РезультатЗапроса = Запрос.Выполнить();
  	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
  	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СчетФактура = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	
	Если НЕ обЗначениеНеЗаполнено(СчетФактура) Тогда
		Попытка
			СчетФактура.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Сообщить("Подчинённый документ "+СокрЛП(СчетФактура)+" также стал непроведённым.",СтатусСообщения.Обычное);			
		Исключение
			ФлОтказ = Истина;	
			#Если Клиент Тогда
				Сообщить("ОШИБКА! Документ '"+СчетФактура+"'. Не удалось отменить проведение.",СтатусСообщения.ОченьВажное);
			#КонецЕсли 
		КонецПопытки;                                          
	КонецЕсли;

	Возврат ФлОтказ; 
	
КонецФункции // СМГ_ОтменаПроведенияСФполученный(Источник)  
