		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СФ_объект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
 		Если СФ_объект.ДоговорВзаиморасчетов <> ДокументОснование.ДоговорВзаиморасчетов Тогда
			Попытка
				СФ_объект.Контрагент = ДокументОснование.Контрагент;
				СФ_объект.ДоговорВзаиморасчетов = ДокументОснование.ДоговорВзаиморасчетов;
				СФ_объект.Грузополучатель = ДокументОснование.Контрагент;
				СФ_объект.Записать(РежимЗаписиДокумента.Запись);
			Исключение
	 		КонецПопытки;
		КонецЕсли;            
 		Прервать;
	КонецЦикла;
	
	Если обЗначениеНеЗаполнено(СФ_объект) Тогда
		СФ_объект = Документы.СчетФактураВыданный.СоздатьДокумент();
 	КонецЕсли; 
 	 
 	СФ_объект.ОбработкаЗаполнения(ДокументОснование);
	СФ_объект.Номер = ДокументОснование.Номер;
	СФ_объект.Дата = ДокументОснование.Дата;
	
	Если ПометкаУдаления Тогда
		Если НЕ ИзФормыДокумента Тогда
			СФ_объект.Товары.Очистить();
 		КонецЕсли; 
 	КонецЕсли; 
 	
	Если ДокументОснование.Проведен И Не ПометкаУдаления Тогда
		Попытка
 		    Если ИзФормыДокумента Тогда
				СФ_объект.Записать(РежимЗаписиДокумента.Проведение);
  			Иначе
				СФ_объект.Записать(РежимЗаписиДокумента.Запись);
  			КонецЕсли;  
 		Исключение
 		КонецПопытки;
 	Иначе
		Попытка
		    СФ_объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
  		Исключение
 		КонецПопытки;
	КонецЕсли;
 	
	Возврат СФ_объект.Ссылка;

КонецФункции // НайтиСоздатьСинхронизироватьДокументСчетФактураВыданныйБезСообщений(ДокументОснование)
