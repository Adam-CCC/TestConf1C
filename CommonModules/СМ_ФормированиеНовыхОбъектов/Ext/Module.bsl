// закрытие просроченных рабочих листов сервиса
Процедура ЗакрытьПросроченныеРЛСервиса(Параметры = Неопределено) Экспорт
	СписокСтатусов = Новый Массив();
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Интерес);
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Создан);
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Сделка);
	ПричинаОтказа = Справочники.ВозраженияИПричиныОтказов.НайтиПоКоду("ЦБ000049"); // Истёк срок рабочего листа сервиса
	ДатаНачала = НачалоДня(ТекущаяДата() - 1209600); // за 14 дней
	
	ЗапросРЛ = Новый Запрос();
	ЗапросРЛ.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ЗапросРЛ.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаНачала));
	ЗапросРЛ.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
	ЗапросРЛ.Текст =
	"ВЫБРАТЬ
	|	РабочийЛистСервиса.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
	|ГДЕ
	|	РабочийЛистСервиса.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И РабочийЛистСервиса.Статус В(&СписокСтатусов)
	|	И НЕ РабочийЛистСервиса.ПометкаУдаления";
	
	ВыборкаРЛ = ЗапросРЛ.Выполнить().Выбрать();
	Пока ВыборкаРЛ.Следующий() Цикл
		РабочийЛистОбъект = ВыборкаРЛ.Ссылка.ПолучитьОбъект();
		РабочийЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.Отказ;
		РабочийЛистОбъект.ПричинаОтказа = ПричинаОтказа;
		РабочийЛистОбъект.Комментарий = РабочийЛистОбъект.Комментарий + Символы.ВК +
		"Закрыт автоматически по истечении 14 дней со дня обращения.";
		РабочийЛистОбъект.ОбменДанными.Загрузка = Истина;
		РабочийЛистОбъект.Записать();
	КонецЦикла;
КонецПроцедуры

Функция ПроверитьСодержаниеРезультатСобытия(СтрокаТекста, МинБуквЦифр) Экспорт
	Если ТипЗнч(СтрокаТекста) <> Тип("Строка") Тогда
		Сообщить("ОШИБКА! При вызове ПроверитьСодержаниеРезультатСобытия() параметром передана не строка!", СтатусСообщения.ОченьВажное);
		Возврат Ложь;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(СтрокаТекста) Тогда
		Сообщить("ОШИБКА! Содержание или Результат События не заполнен!", СтатусСообщения.ОченьВажное);
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаТекста = СокрЛП(СтрокаТекста);
	ДлинаСтроки = СтрДлина(СтрокаТекста);
	Если ДлинаСтроки = 0 Тогда
		Сообщить("ОШИБКА! Содержание или Результат События не заполнен (только пробелы)!", СтатусСообщения.ОченьВажное);
		Возврат Ложь;
	КонецЕсли;

	КоличествоБуквЦифр = 0;
	Для сч = 1 По ДлинаСтроки Цикл
		КодСимвола = КодСимвола(Сред(СтрокаТекста, сч, 1));
		Если КодСимвола >= 1040 И КодСимвола <= 1103 Тогда // кириллица
			КоличествоБуквЦифр = КоличествоБуквЦифр + 1;
			
		ИначеЕсли КодСимвола = 1025 Или КодСимвола = 1105 Тогда // символы "Ё" и "ё"
			КоличествоБуквЦифр = КоличествоБуквЦифр + 1;
			
		ИначеЕсли КодСимвола >= 65 И КодСимвола <= 90 Тогда // латиница большие
			КоличествоБуквЦифр = КоличествоБуквЦифр + 1;
			
		ИначеЕсли КодСимвола >= 97 И КодСимвола <= 122 Тогда // латиница маленькие
			КоличествоБуквЦифр = КоличествоБуквЦифр + 1;
			
		ИначеЕсли КодСимвола >= 48 И КодСимвола <= 57 Тогда // цифры
			КоличествоБуквЦифр = КоличествоБуквЦифр + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоБуквЦифр >= МинБуквЦифр Тогда
		Возврат Истина;
	Иначе
		Сообщить("ОШИБКА! Содержание или Результат События содержит менее " + МинБуквЦифр + " букв или цифр!", СтатусСообщения.ОченьВажное);
		Возврат Ложь;		
	КонецЕсли;
КонецФункции

Функция СоздатьЗавершитьВыдачуАвтомобиля(Дата, АвтомобильВыдачи, РабочийЛист) Экспорт
	Если обЗначениеНеЗаполнено(АвтомобильВыдачи) Тогда
		Возврат Документы.Событие.ПустаяСсылка();
	КонецЕсли;
	Если обЗначениеНеЗаполнено(РабочийЛист) Тогда
		Возврат Документы.Событие.ПустаяСсылка();
	КонецЕсли;
	
	Если АвтомобильВыдачи.ЗеленыйАвтомобиль Тогда
		Сообщить("Для зелёного автомобиля событие Выдача не создаётся/завершается.", СтатусСообщения.Информация);
		Возврат Документы.Событие.ПустаяСсылка();
	КонецЕсли;
	
	АктивныеСостояния = Новый Массив();
	АктивныеСостояния.Добавить(Перечисления.СостоянияСобытий.Запланировано);
	АктивныеСостояния.Добавить(Перечисления.СостоянияСобытий.Завершено);
	
	ЗапросВыдачи = Новый Запрос();
	ЗапросВыдачи.УстановитьПараметр("Выдача", Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
	ЗапросВыдачи.УстановитьПараметр("РабочийЛист", РабочийЛист);
	ЗапросВыдачи.УстановитьПараметр("АктивныеСостояния", АктивныеСостояния);
	ЗапросВыдачи.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка КАК Ссылка,
	|	Событие.Состояние КАК Состояние
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ВидСобытия = &Выдача
	|	И Событие.ДокументОснование = &РабочийЛист
	|	И Событие.Состояние В(&АктивныеСостояния)
	|	И НЕ Событие.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Событие.Дата";
	
	РезультатВыдача = ЗапросВыдачи.Выполнить();
	Если РезультатВыдача.Пустой() Тогда
		СобытиеОбъект = Документы.Событие.СоздатьДокумент();
		СобытиеОбъект.Заполнить(РабочийЛист);
		СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля;
		СобытиеОбъект.Автомобиль = АвтомобильВыдачи;	
		СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Завершено;
		СобытиеОбъект.Результат = "Автомобиль выдан.";
		СобытиеОбъект.Приоритет = Перечисления.Важность.Средняя;
		СобытиеОбъект.Дата = Дата;
		СобытиеОбъект.ДатаНачала = Дата;
		СобытиеОбъект.ДатаОкончания = СобытиеОбъект.ДатаНачала + 1800;
		СобытиеОбъект.ВторичныйКонтакт = Истина;
		СобытиеОбъект.ПредметОбращения = Справочники.ПредметыОбращения.Автосалон;
		
		Попытка
			СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("Создана выдача автомобиля: " + Строка(СобытиеОбъект.Ссылка), СтатусСообщения.Информация);
		Исключение
			Сообщить("ВНИМАНИЕ! Ошибка при создании Выдачи автомобиля." + Символы.ПС 
				+ ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;
		Возврат СобытиеОбъект.Ссылка;
		
	Иначе
		ВыборкаВыдача = РезультатВыдача.Выбрать();
		Пока ВыборкаВыдача.Следующий() Цикл
			ВыдачаСсылка = ВыборкаВыдача.Ссылка;
			Если ВыборкаВыдача.Состояние = Перечисления.СостоянияСобытий.Запланировано Тогда
				СобытиеОбъект = ВыдачаСсылка.ПолучитьОбъект();
				СобытиеОбъект.Контрагент = РабочийЛист.Контрагент;
				СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Завершено;
				СобытиеОбъект.Результат = "Автомобиль выдан.";
				
				Попытка
					СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Сообщить("Завершена выдача автомобиля: " + Строка(СобытиеОбъект.Ссылка), СтатусСообщения.Информация);
				Исключение
					Сообщить("ВНИМАНИЕ! Ошибка при завершении Выдачи автомобиля." + Символы.ПС 
						+ ОписаниеОшибки(), СтатусСообщения.Важное);
				КонецПопытки;
				Возврат СобытиеОбъект.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Документы.Событие.ПустаяСсылка();
КонецФункции
