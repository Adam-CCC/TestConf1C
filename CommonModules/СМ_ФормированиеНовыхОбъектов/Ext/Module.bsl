	РабочийЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.Создан;
	РабочийЛистОбъект.Комментарий = "Создан автоматически при планировании исходящего звонка.";
	
	Попытка
		РабочийЛистОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		//СобытиеОбъект.ОбменДанными.Загрузка = Истина;
		//СобытиеОбъект.Записать();
		#Если Клиент Тогда
		Сообщить("Не удалось создать новай Рабочий лист: " 
		    	+ Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
		#КонецЕсли
	КонецПопытки;
	
	Возврат РабочийЛистОбъект.Ссылка;
КонецФункции
