Процедура ЗапланироватьЗвонкиПриглашенияНаТО(Параметры = Неопределено)  Экспорт
	//ТекущаяДата = Дата(2018, 5, 30);
	ТекущаяДата = НачалоДня(ТекущаяДата());
	ДатаТО = ТекущаяДата + 1209600; // 3600 * 24 * 14
	
	ЗапросПриглашения = Новый Запрос();
	ЗапросПриглашения.УстановитьПараметр("Владелец", Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
	ЗапросПриглашения.УстановитьПараметр("ПустаяСсылка", Документы.ЗаказНаряд.ПустаяСсылка());
	ЗапросПриглашения.УстановитьПараметр("ДатаТО", ДатаТО);
	ЗапросПриглашения.Текст = "ВЫБРАТЬ
	                          |	ИсторияТехОбслуживания.Автомобиль,
	                          |	ИсторияТехОбслуживания.НомерТО,
	                          |	АвтомобилиСрезПоследних.Значение КАК Владелец,
	                          |	ИсторияТехОбслуживания.ДатаТО,
	                          |	ИсторияТехОбслуживания.ПодразделениеТО КАК ПодразделениеТО
	                          |ИЗ
	                          |	РегистрСведений.ИсторияТехОбслуживания КАК ИсторияТехОбслуживания
	                          |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(, ВидЗначения = &Владелец) КАК АвтомобилиСрезПоследних
	                          |		ПО ИсторияТехОбслуживания.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
	                          |ГДЕ
	                          |	ИсторияТехОбслуживания.ЗаказНарядТО = &ПустаяСсылка
	                          |	И ИсторияТехОбслуживания.ДатаТО = &ДатаТО
	                          |ИТОГИ ПО
	                          |	ПодразделениеТО";
	
	мДолжности = Новый Массив();
	мДолжности.Добавить(Справочники.Должности.МастерПриемщик);
	мДолжности.Добавить(Справочники.Должности.ОператорСервисБюро);
	ГруппаМКЦ = Справочники.Сотрудники.НайтиПоКоду("ЦБ0002711");
	Если обЗначениеНеЗаполнено(ГруппаМКЦ) Тогда
		ГруппаМКЦ = Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	ЗапросСотрудники = Новый Запрос();
	ЗапросСотрудники.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	ЗапросСотрудники.УстановитьПараметр("СписокДолжностей", мДолжности);
	ЗапросСотрудники.УстановитьПараметр("ГруппаМКЦ", ГруппаМКЦ);
	ЗапросСотрудники.Текст = "ВЫБРАТЬ
	                         |	Сотрудники.Ссылка КАК Сотрудник
	                         |ИЗ
	                         |	Справочник.Сотрудники КАК Сотрудники
	                         |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
	                         |		ПО Сотрудники.ГрафикРаботы = ГрафикРаботКалендарный.График
	                         |ГДЕ
	                         |	Сотрудники.Подразделение В ИЕРАРХИИ(&ГруппаПодразделений)
	                         |	И Сотрудники.Должность В(&СписокДолжностей)
	                         |	И ГрафикРаботКалендарный.Дата = &ТекущаяДата
	                         |	И ГрафикРаботКалендарный.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидДня.Рабочий)
	                         |	И Сотрудники.Родитель <> &ГруппаМКЦ";
	
	ПриглашенияПоПодразделениям = ЗапросПриглашения.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ГСЧ = Новый ГенераторСлучайныхЧисел(255);
	Пока ПриглашенияПоПодразделениям.Следующий() Цикл
		Подразделение = ПриглашенияПоПодразделениям.ПодразделениеТО;
		Если обЗначениеНеЗаполнено(Подразделение) Тогда
			Продолжить;
		ИначеЕсли Подразделение.Родитель = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
			ГруппаПодразделений = Подразделение;
		Иначе
			ГруппаПодразделений = Подразделение.Родитель;
		КонецЕсли;
		
		ЗапросСотрудники.УстановитьПараметр("ГруппаПодразделений", ГруппаПодразделений);
		СписокСотрудников = ЗапросСотрудники.Выполнить().Выгрузить();
		
		ПриглашенияПоАвтомобилям = ПриглашенияПоПодразделениям.Выбрать();
		Пока ПриглашенияПоАвтомобилям.Следующий() Цикл
			ПредставлениеТелефона = ПриглашенияПоАвтомобилям.Владелец.ОсновнойТелефон;
			Если ЗначениеЗаполнено(ПредставлениеТелефона) Тогда
				РабочийЛистСервиса = НайтиРабочийЛистСервиса(Подразделение, ПредставлениеТелефона);
			Иначе
				Продолжить;
			КонецЕсли;

			Если ЗначениеЗаполнено(РабочийЛистСервиса) Тогда
				РабочийЛистНайден = Истина;
			Иначе
				РабочийЛистНайден = Ложь;	
				РабочийЛистСервиса = СоздатьРабочийЛистСервиса(ПриглашенияПоАвтомобилям, СписокСотрудников, ТекущаяДата);
			КонецЕсли;
			
			Если обЗначениеНеЗаполнено(РабочийЛистСервиса) Тогда
				Продолжить;
			КонецЕсли;
	
			СобытиеОбъект = Документы.Событие.СоздатьДокумент();
			СобытиеОбъект.Заполнить(РабочийЛистСервиса);
			СобытиеОбъект.ДокументОснование = РабочийЛистСервиса;
			
		 	СобытиеОбъект.Автор = СобытиеОбъект.ПодразделениеКомпании.РуководительСервиса;
			Если РабочийЛистНайден Тогда
				КоличествоСотрудников = СписокСотрудников.Количество();
				Если КоличествоСотрудников = 0 Тогда
					СобытиеОбъект.Продавец = СобытиеОбъект.Автор.Сотрудник;
				ИначеЕсли КоличествоСотрудников = 1 Тогда
					СобытиеОбъект.Продавец = СписокСотрудников[0].Сотрудник;
				Иначе
					Индекс = ГСЧ.СлучайноеЧисло(0, КоличествоСотрудников - 1);
					СобытиеОбъект.Продавец = СписокСотрудников[Индекс].Сотрудник;
				КонецЕсли;
			КонецЕсли;
			
			СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок;
			СобытиеОбъект.ТипСообщения = Перечисления.ТипыСообщений.Исходящее;
			СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Запланировано;
			СобытиеОбъект.Приоритет = Перечисления.Важность.Высокая;
			
			СобытиеОбъект.ДатаНачала = ТекущаяДата + 36000;
			СобытиеОбъект.ДатаОкончания = СобытиеОбъект.ДатаНачала + 900;
			СобытиеОбъект.ОбработкаРеквизита("ДатаНачала");
			СобытиеОбъект.Содержание = "Пригласить клиента на ТО-" + ПриглашенияПоАвтомобилям.НомерТО +
			", запланированное на " + Формат(ПриглашенияПоАвтомобилям.ДатаТО, "ДЛФ=ДД");
			СобытиеОбъект.ИсточникИнформации = Справочники.ИсточникиИнформации.ЛичныйВизит;
			СобытиеОбъект.Комментарий = "Звонок создан автоматически по даным о запланированном ТО";
			СобытиеОбъект.ВторичныйКонтакт = РабочийЛистНайден;
			
			НовСтрока = СобытиеОбъект.Автомобили.Добавить();
			НовСтрока.Автомобиль = ПриглашенияПоАвтомобилям.Автомобиль;
			НовСтрока.Количество = 1;
		 	 
		    НайдМен = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", СобытиеОбъект.Продавец);
		    Если НайдМен <> Неопределено Тогда
		    	НовСтрока = СобытиеОбъект.Пользователи.Добавить();
		     	НовСтрока.Пользователь =  НайдМен;
		    	НовСтрока.Ответственный=Истина;
		  	КонецЕсли; 
		 	
			Попытка
				СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				#Если Клиент Тогда
				Сообщить("Ошибка при создании события!" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
				#КонецЕсли
			КонецПопытки; 
		КонецЦикла;				
	КонецЦикла;
КонецПроцедуры

Функция СоздатьРабочийЛистСервиса(ПриглашенияПоАвтомобилям, СписокСотрудников, ТекущаяДата)
	РабочийЛист = Документы.РабочийЛистСервиса.СоздатьДокумент();		
	РабочийЛист.Дата = ТекущаяДата();
	Подразделение = ПриглашенияПоАвтомобилям.ПодразделениеТО;
	РабочийЛист.ПодразделениеКомпании = Подразделение;
	РабочийЛист.Организация = Подразделение.Организация;
	РабочийЛист.ХозОперация = Справочники.ХозОперации.РабочийЛистСервиса;
	
	РабочийЛист.Автор = Подразделение.РуководительСервиса;
	Если обЗначениеНеЗаполнено(РабочийЛист.Автор) Тогда
		РабочийЛист.Автор = ПараметрыСеанса.Пользователь;
	КонецЕсли;
	
	КоличествоСотрудников = СписокСотрудников.Количество();
	Если КоличествоСотрудников = 0 Тогда
		РабочийЛист.Менеджер = Подразделение.РуководительСервиса.Сотрудник;
	ИначеЕсли КоличествоСотрудников = 1 Тогда
		РабочийЛист.Менеджер = СписокСотрудников[0].Сотрудник;
	Иначе
		ГСЧ = Новый ГенераторСлучайныхЧисел(255);
		Индекс = ГСЧ.СлучайноеЧисло(0, КоличествоСотрудников - 1);
		РабочийЛист.Менеджер = СписокСотрудников[Индекс].Сотрудник;
	КонецЕсли;
	
	РабочийЛист.Контрагент = ПриглашенияПоАвтомобилям.Владелец;
	РабочийЛист.УчастникПрограммыПроактивныйКонтакт = РабочийЛист.Контрагент.СогласиеНаУчастиеВПрограммеПроактивныйКонтакт = Перечисления.ВариантыОтветов.Да;
	Если ЗначениеЗаполнено(РабочийЛист.Контрагент.Пол) Тогда
		РабочийЛист.Пол = РабочийЛист.Контрагент.Пол;
	Иначе
		РабочийЛист.Пол = Перечисления.ПолФизическихЛиц.НеУказан;
	КонецЕсли;
	Если ЗначениеЗаполнено(РабочийЛист.Контрагент.ФормаСобственности) Тогда
		РабочийЛист.ЮридическоеЛицо = Не РабочийЛист.Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
	КонецЕсли;
	
	РабочийЛист.Автомобиль = ПриглашенияПоАвтомобилям.Автомобиль;
	РабочийЛист.VIN = ПриглашенияПоАвтомобилям.Автомобиль.VIN;
	РабочийЛист.Модель = РабочийЛист.Автомобиль.Модель;
	РабочийЛист.Статус = Справочники.СтатусыРабочегоЛиста.Создан;
	
	РабочийЛист.ВидКонтакта = Перечисления.ВидыСобытий.ТелефонныйЗвонок;
	РабочийЛист.ПредставлениеТелефона = РабочийЛист.Контрагент.ОсновнойТелефон;
	Если обЗначениеНеЗаполнено(РабочийЛист.ПредставлениеТелефона) Тогда
		РабочийЛист.ПредставлениеТелефона = киПолучитьПредставлениеКИ(РабочийЛист.Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	КонецЕсли;					
	Если обЗначениеНеЗаполнено(РабочийЛист.ПредставлениеТелефона) Тогда
		РабочийЛист.ПредставлениеТелефона = киПолучитьПредставлениеКИ(РабочийЛист.Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;					
	Если Не ЗначениеЗаполнено(РабочийЛист.ПредставлениеТелефона) Тогда
		РабочийЛист.ПредставлениеТелефона = "<не указан>";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Подразделение.РуководительСервиса) Тогда
		РабочийЛист.РуководительМенеджера = Подразделение.РуководительСервиса.Сотрудник;
	КонецЕсли;
	
	РабочийЛист.Пользователи.Очистить();			
	Если ЗначениеЗаполнено(РабочийЛист.Автор) Тогда
		СтрокаПользователь = РабочийЛист.Пользователи.Добавить();
		СтрокаПользователь.Пользователь	= РабочийЛист.Автор; 			
	КонецЕсли;
	
	РабочийЛист.Реклама = Справочники.ИсточникиИнформации.ЛичныйВизит;
	РабочийЛист.ПричинаОбращения = "Приглашение клиента на ТО-" + ПриглашенияПоАвтомобилям.НомерТО;
	РабочийЛист.ДатаКонтакта = ТекущаяДата;
	РабочийЛист.КонтактнаяИнформацияПроактивногоКонтакта = "ТО-" + ПриглашенияПоАвтомобилям.НомерТО + " для автомобиля клиента запланировано на " + Формат(ПриглашенияПоАвтомобилям.ДатаТО, "ДЛФ=Д");
	РабочийЛист.Комментарий = "Рабочий лист создан автоматически по даным о запланированном ТО";
	
	//РабочийЛист.ОбменДанными.Загрузка = Истина;
	Попытка
		РабочийЛист.Записать(РежимЗаписиДокумента.Проведение);
		Возврат РабочийЛист.Ссылка;
	Исключение
		#Если Клиент Тогда
		Сообщить("Ошибка при создании Рабочего листа сервиса!" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		#КонецЕсли
		Возврат Документы.РабочийЛистСервиса.ПустаяСсылка();
	КонецПопытки;
КонецФункции

Функция НайтиРабочийЛистСервиса(ПодразделениеКомпании, ПредставлениеТелефона)  Экспорт
	СписокСтатусов = Новый Массив();
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Интерес);
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Создан);
	СписокСтатусов.Добавить(Справочники.СтатусыРабочегоЛиста.Сделка);
	
	Подразделение = ПодразделениеКомпании.Родитель;
	Если обЗначениеНеЗаполнено(Подразделение) Или Подразделение = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
		Подразделение = ПодразделениеКомпании;
	КонецЕсли;
	ДатаНачала = НачалоДня(ТекущаяДата() - 1209600); // за 14 дней
	
	ЗапросРЛ = Новый Запрос();
	ЗапросРЛ.УстановитьПараметр("ПредставлениеТелефона",  СокрЛП(ПредставлениеТелефона));
	ЗапросРЛ.УстановитьПараметр("Подразделение", Подразделение);
	ЗапросРЛ.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ЗапросРЛ.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
		
	ЗапросРЛ.Текст =
	"ВЫБРАТЬ
	|	РабочийЛистСервиса.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
	|ГДЕ
	|	РабочийЛистСервиса.ПредставлениеТелефона = &ПредставлениеТелефона
	|	И РабочийЛистСервиса.ПодразделениеКомпании В ИЕРАРХИИ(&Подразделение)
	|	И РабочийЛистСервиса.Проведен = ИСТИНА
	|	И НЕ РабочийЛистСервиса.ПометкаУдаления
	|	И РабочийЛистСервиса.Дата > &ДатаНачала
	|	И РабочийЛистСервиса.Статус В(&СписокСтатусов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РабочийЛистСервиса.ДатаИзменения УБЫВ";
	
 	РезультатРабочийЛистСервиса = ЗапросРЛ.Выполнить();
	Если РезультатРабочийЛистСервиса.Пустой() Тогда
		Возврат Документы.РабочийЛистСервиса.ПустаяСсылка();
		
	Иначе
		ВыборкаРабочийЛистСервиса = РезультатРабочийЛистСервиса.Выбрать();
		Если ВыборкаРабочийЛистСервиса.Следующий() Тогда
			Возврат ВыборкаРабочийЛистСервиса.Ссылка;
		Иначе
			Возврат Документы.РабочийЛистСервиса.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
КонецФункции
