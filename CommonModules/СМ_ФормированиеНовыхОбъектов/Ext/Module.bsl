Процедура СоздатьЗвонкиВежливости(ТекущаяДата)
	Сутки = 86400;
	МассивДат = Новый Массив();
	МассивДат.Добавить(ТекущаяДата - Сутки);
	МассивДат.Добавить(ТекущаяДата - 10 * Сутки);
	МассивДат.Добавить(ДобавитьМесяц(ТекущаяДата, -12));
	
	ИндексЗвонка = 0;
	Для Каждого ДатаВыборки Из МассивДат Цикл
		ДатаНачала = НачалоДня(ДатаВыборки);
		ДатаОкончания = КонецДня(ДатаВыборки);
		
		тзЗавершенныеВыдачи = ПолучитьЗавершенныеВыдачи(ДатаНачала, ДатаОкончания);
		
		тзВыдачиРаботающихМенеджеров = тзЗавершенныеВыдачи.Скопировать(Новый Структура("ПродавецУволен", Ложь));
		Для Каждого СтрокаВыдача Из тзВыдачиРаботающихМенеджеров Цикл
			//Если АвтомобильНовый(СтрокаВыдача.Автомобиль, ДатаНачала) Тогда // Семенихин 16.02.2023
				Содержание = ПолучитьСодержаниеЗвонка(СтрокаВыдача.Марка, ИндексЗвонка);
				ЗапланироватьЗвонокВежливости(СтрокаВыдача.Ссылка, Справочники.Сотрудники.ПустаяСсылка(), Содержание);
			//КонецЕсли;			
		КонецЦикла;
		
		тзВыдачиУволенныхМенеджеров = тзЗавершенныеВыдачи.Скопировать(Новый Структура("ПродавецУволен", Истина));		
		Для Каждого СтрокаВыдача Из тзВыдачиУволенныхМенеджеров Цикл
			//Если АвтомобильНовый(СтрокаВыдача.Автомобиль, ДатаНачала) Тогда
				Менеджер = СлучайныйВыборСотрудника(СтрокаВыдача.Подразделение, Справочники.Должности.МенеджерОтделаПродажАвтомобилей, ТекущаяДата);
				Если ЗначениеЗаполнено(Менеджер) Тогда
					Содержание = ПолучитьСодержаниеЗвонка(СтрокаВыдача.Марка, ИндексЗвонка);
					ЗапланироватьЗвонокВежливости(СтрокаВыдача.Ссылка, Менеджер, Содержание);
				Иначе
					Продолжить;
				КонецЕсли;			
			//КонецЕсли;			
		КонецЦикла;
		
		ИндексЗвонка = ИндексЗвонка + 1;
	КонецЦикла;	
КонецПроцедуры

