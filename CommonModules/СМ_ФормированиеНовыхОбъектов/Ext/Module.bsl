Процедура  ПроверкаЗаполненияРЛСервиса(Параметры = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЖурналСостоянийСрезПоследних.Период,
	|	ЖурналСостоянийСрезПоследних.Объект,
	|	ЖурналСостоянийСрезПоследних.Состояние,
	|	ЖурналСостоянийСрезПоследних.Объект.ДатаКонтакта,
	|	Напоминания.Объект КАК ЕстьНапоминание
	|ИЗ
	|	РегистрСведений.ЖурналСостояний.СрезПоследних(&Дата, ) КАК ЖурналСостоянийСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Напоминания КАК Напоминания
	|		ПО ЖурналСостоянийСрезПоследних.Объект = Напоминания.Объект
	|ГДЕ
	|	ЖурналСостоянийСрезПоследних.Объект ССЫЛКА Документ.РабочийЛистСервиса
	|	И ЖурналСостоянийСрезПоследних.Объект.ДатаКонтакта <> &ПустаяДата
	|	И ЖурналСостоянийСрезПоследних.Объект.ДатаКонтакта > ДАТАВРЕМЯ(2013, 1, 1, 1, 1, 1)
	|	И ЖурналСостоянийСрезПоследних.Объект.ДатаКонтакта МЕЖДУ &ДатаКонтактаНач И &ДатаКонтактаКОн
	|	И ЖурналСостоянийСрезПоследних.Объект.ДатаКонтакта <= &ДатаПроверки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналСостоянийСрезПоследних.Объект.ДатаКонтакта";
	ДатаПроверки = ТекущаяДата();
	Запрос.УстановитьПараметр("Дата", ДатаПроверки);
	Запрос.УстановитьПараметр("ДатаКонтактаКОн", ДатаПроверки+300);
	Запрос.УстановитьПараметр("ДатаКонтактаНач", ДатаПроверки-300);
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	Пользователи = г_Функции.ПолучитьПользователейСПравом(ПланыВидовХарактеристик.ПраваИНастройки.СоздаватьНапоминаниеКолЦентр);
	Если Пользователи.Количество()=0 тогда
		Возврат;	
	КонецЕсли;	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если  ВыборкаДетальныеЗаписи.ЕстьНапоминание <> NULL тогда
			Продолжить;
		КонецЕсли;	
		
		Для Каждого РегистраторАвтор из Пользователи цикл 
			НаборЗаписейНапоминания=РегистрыСведений.Напоминания.СоздатьНаборЗаписей();
			НаборЗаписейНапоминания.Отбор.Автор.Установить(РегистраторАвтор.Объект);
			НаборЗаписейНапоминания.Отбор.Завершено.Установить(Ложь);
			НаборЗаписейНапоминания.Прочитать();
			ДатаОповещения=ТекущаяДата();
			
			ЗаписатьНапоминания = Истина;
			
			//Для каждого автора создадим напоминание
			НоваяЗапись = НаборЗаписейНапоминания.Добавить();
			//НоваяЗапись.Пользователь            = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник",ВыборкаДетальныеЗаписи.Объект.Менеджер);
			НоваяЗапись.Пользователь            = РегистраторАвтор.Объект;
			
			НоваяЗапись.Автор                   = РегистраторАвтор.Объект;
			НоваяЗапись.Завершено               = Ложь;
			НоваяЗапись.РеальнаяДатаОповещения  = ДатаОповещения;
			НоваяЗапись.Объект                  = ВыборкаДетальныеЗаписи.Объект;
			НоваяЗапись.ДатаНачала              = ДатаОповещения;
			НоваяЗапись.ДатаОповещения          = ДатаОповещения;
			НоваяЗапись.Описание                = СокрЛП(ВыборкаДетальныеЗаписи.Объект)+"! Позвоните сотруднику <"+ВыборкаДетальныеЗаписи.Объект.Менеджер+"> чтобы он связался с клиентом по рабочему листу.";
			
			НоваяЗапись.Редактирование          = Ложь;
			НоваяЗапись.Тема                    = "Обзвон по рабочему листу сервиса"; 
			НоваяЗапись.ТипПериода              = "00"; 
			НоваяЗапись.УдалитьПоИстеченииСрока = Истина; 
			
			ЗаписатьНапоминания = Истина;
			
			
			
			Попытка
				НаборЗаписейНапоминания.Записать(Истина);
			Исключение
				#Если Клиент Тогда
					Сообщить("Ошибка создания напоминаний о резервировании товаров: "+ОписаниеОшибки());
				#КонецЕсли
			КонецПопытки;
			
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

//Бондаренко++ 20210405
 Функция НайтиСоздатьСинхронизироватьДокументСчетФактураВыданный(ДокументОснование,ПометкаУдаления,ИзФормыДокумента) Экспорт

  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка,
		|	СчетФактураВыданный.ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СФ_объект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		//Бондаренко++ 2023207
		Если СФ_объект.ДоговорВзаиморасчетов <> ДокументОснование.ДоговорВзаиморасчетов Тогда
			Попытка
				СФ_объект.Контрагент = ДокументОснование.Контрагент;
				СФ_объект.ДоговорВзаиморасчетов = ДокументОснование.ДоговорВзаиморасчетов;
				СФ_объект.Грузополучатель = ДокументОснование.Контрагент;
				СФ_объект.Записать(РежимЗаписиДокумента.Запись);
			Исключение
	 		КонецПопытки;
		КонецЕсли;            
		//Бондаренко-- 2023207
		Прервать;
	КонецЦикла;
	
	Если обЗначениеНеЗаполнено(СФ_объект) Тогда
		СФ_объект = Документы.СчетФактураВыданный.СоздатьДокумент();
 	КонецЕсли; 
 	 
 	СФ_объект.ОбработкаЗаполнения(ДокументОснование);
	СФ_объект.Номер = ДокументОснование.Номер;
	СФ_объект.Дата = ДокументОснование.Дата;
	
	Если ПометкаУдаления Тогда
		Если НЕ ИзФормыДокумента Тогда
			СФ_объект.Товары.Очистить();
 		КонецЕсли; 
 	КонецЕсли; 
 	
	Если ДокументОснование.Проведен И Не ПометкаУдаления Тогда
		Попытка
 		    Если ИзФормыДокумента Тогда
				СФ_объект.Записать(РежимЗаписиДокумента.Проведение);
				Сообщить("Проведен документ: "+СФ_объект);			
 			Иначе
				СФ_объект.Записать(РежимЗаписиДокумента.Запись);
				Сообщить("Записан документ: "+СФ_объект);			
 			КонецЕсли;  
 		Исключение
			Сообщить("ОШИБКА! Не удалось "+?(ИзФормыДокумента,"провести","записать")+" документ: "+СФ_объект,СтатусСообщения.ОченьВажное);		
		КонецПопытки;
 	Иначе
		Попытка
		    СФ_объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Сообщить("Записан непроведенный документ: "+СФ_объект);		
 		Исключение
			Сообщить("ОШИБКА! Не удалось записать непроведённый документ: "+СФ_объект,СтатусСообщения.ОченьВажное);		
		КонецПопытки;
	КонецЕсли;
 	
	Возврат СФ_объект.Ссылка;

КонецФункции // НайтиСоздатьСинхронизироватьДокументСчетФактураВыданный(ДокументОснование)
