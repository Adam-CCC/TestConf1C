Функция НайтиПодразделениеПоМаркеАвто(Марка) Экспорт
	
	Подр_ = "";
	
	СписокПодразделенийГК  = Новый СписокЗначений;
	
	Для каждого Эл Из ПараметрыСеанса.Пользователь.Сотрудник.ТаблицаПодразделенийГК Цикл
  		СписокПодразделенийГК.Добавить(Эл.ПодразделениеГК);	
	КонецЦикла;
  	
	Запрос = Новый Запрос;
