Процедура СоздатьРабочиеЛистыПоПрограммеПроактивныйКонтакт(Параметры = Неопределено) Экспорт	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВидыРемонта.Ссылка КАК ВидРем
	|ПОМЕСТИТЬ ВидыРемонтаПро
	|ИЗ
	|	Справочник.ВидыРемонта КАК ВидыРемонта
	|ГДЕ
	|	ВидыРемонта.УчаствуетВПроактивномКонтакте = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЗаказНаряд.Ссылка) КАК Ссылка,
	|	ЗаказНаряд.Автомобиль
	|ПОМЕСТИТЬ ЗаказыНаряды
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Проведен
	|	И НЕ ЗаказНаряд.ДатаПроактивногоКонтакта = ДАТАВРЕМЯ(1, 1, 1)
	|	И ЗаказНаряд.Дата МЕЖДУ &НачПериода И &КонПериода
	|	И ЗаказНаряд.ВидРемонта В
	|			(ВЫБРАТЬ
	|				ВыбНомен.ВидРем
	|			ИЗ
	|				ВидыРемонтаПРо КАК ВыбНомен)
	|	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказНаряд.Автомобиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочийЛистСервиса.Автомобиль,
	|	МАКСИМУМ(РабочийЛистСервиса.Дата) КАК Дата
	|ПОМЕСТИТЬ РабочиеЛистыПоДате
	|ИЗ
	|	Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
	|ГДЕ
	|	РабочийЛистСервиса.Проведен
	|	И РабочийЛистСервиса.УчастникПрограммыПроактивныйКонтакт
	|	И РабочийЛистСервиса.Автомобиль В
	|			(ВЫБРАТЬ
	|				ЗаказыНаряды.Автомобиль
	|			ИЗ
	|				ЗаказыНаряды КАК ЗаказыНаряды)
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочийЛистСервиса.Автомобиль
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочиеЛистыПоДате.Автомобиль,
	|	МАКСИМУМ(РабочийЛистСервиса.Ссылка) КАК ПоследнийРабочийЛист
	|ПОМЕСТИТЬ ПоследниеРабочиеЛисты
	|ИЗ
	|	РабочиеЛистыПоДате КАК РабочиеЛистыПоДате
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
	|		ПО РабочиеЛистыПоДате.Автомобиль = РабочийЛистСервиса.Автомобиль
	|			И РабочиеЛистыПоДате.Дата = РабочийЛистСервиса.Дата
	|			И (РабочийЛистСервиса.Проведен)
	|
	|СГРУППИРОВАТЬ ПО
	|	РабочиеЛистыПоДате.Автомобиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоследниеРабочиеЛисты.Автомобиль
	|ПОМЕСТИТЬ АвтомобилиИсключить
	|ИЗ
	|	ПоследниеРабочиеЛисты КАК ПоследниеРабочиеЛисты
	|ГДЕ
	|	ПоследниеРабочиеЛисты.ПоследнийРабочийЛист.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Создан)
	//|	НЕ ПоследниеРабочиеЛисты.ПоследнийРабочийЛист.Статус В (ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Сделка), ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Отказ))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыНаряды.Ссылка
	|ИЗ
	|	ЗаказыНаряды КАК ЗаказыНаряды
	|ГДЕ
	|	НЕ ЗаказыНаряды.Автомобиль В
	|				(ВЫБРАТЬ
	|					АвтомобилиИсключить.Автомобиль
	|				ИЗ
	|					АвтомобилиИсключить КАК АвтомобилиИсключить)";
	
	Запрос.УстановитьПараметр("НачПериода", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонПериода", КонецДня(ТекущаяДата()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Заказ = Выборка.Ссылка;		
		// Семенихин 09.11.2017 +++++
		Автолига = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000117");
		Если Заказ.ПодразделениеКомпании = Автолига Или Заказ.ПодразделениеКомпании.ПринадлежитЭлементу(Автолига) Тогда
			Продолжить;
		КонецЕсли;
		// Семенихин 09.11.2017 -----
			
		РабочийЛист = Документы.РабочийЛистСервиса.СоздатьДокумент();
		
		РабочийЛист.Дата = ТекущаяДата();
		РабочийЛист.Организация = Заказ.Организация;
		РабочийЛист.ПодразделениеКомпании = Заказ.ПодразделениеКомпании;
		РабочийЛист.УчастникПрограммыПроактивныйКонтакт = Истина;
		РабочийЛист.Реклама = Заказ.ИсточникИнформации;
		РабочийЛист.ХозОперация = Справочники.ХозОперации.РабочийЛистСервиса;
		
		Если Константы.НазначениеРабочегоЛиста.Получить() = Перечисления.НазначениеРабочегоЛиста.Оператор Тогда
			РабочийЛист.Менеджер = Заказ.Оператор;
		Иначе
			РабочийЛист.Менеджер = Заказ.Диспетчер;
		КонецЕсли;
		
		РабочийЛист.Контрагент = Заказ.Заказчик;
		РабочийЛист.Автор = Заказ.Автор;
		РабочийЛист.Автомобиль = Заказ.Автомобиль;		
		РабочийЛист.Статус = Справочники.СтатусыРабочегоЛиста.Создан;
		РабочийЛист.ВидКонтакта = Перечисления.ВидыСобытий.ЛичнаяВстреча;
		РабочийЛист.ДокументОснование = Заказ;
		РабочийЛист.ПредставлениеТелефона = киПолучитьПредставлениеКИ(Заказ.Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
		
		Если Не ЗначениеЗаполнено(РабочийЛист.ПредставлениеТелефона) Тогда
			РабочийЛист.ПредставлениеТелефона = "<не указан>";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РабочийЛист.Автомобиль) Тогда
			РабочийЛист.Модель = РабочийЛист.Автомобиль.Модель;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РабочийЛист.Контрагент) И ЗначениеЗаполнено(РабочийЛист.Контрагент.Пол) Тогда
			РабочийЛист.Пол = РабочийЛист.Контрагент.Пол;
		Иначе
			РабочийЛист.Пол = Перечисления.ПолФизическихЛиц.НеУказан;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РабочийЛист.Организация) И ЗначениеЗаполнено(РабочийЛист.Организация.РуководительСервиса) Тогда
			РабочийЛист.РуководительМенеджера = РабочийЛист.Организация.РуководительСервиса.Сотрудник;
		КонецЕсли;
		
		РабочийЛист.Пользователи.Очистить();
		
		Если ЗначениеЗаполнено(РабочийЛист.Автор) Тогда
			СтрокаПользователь				= РабочийЛист.Пользователи.Добавить();
			СтрокаПользователь.Пользователь	= Заказ.Автор; 			
		КонецЕсли;
		
		РабочийЛист.ПричинаОбращения = "Обращение по программе ""Проактивный контакт"" на основании документа ""Заказ-наряд"" №" + Заказ.Номер + " от " + Формат(Заказ.Дата, "ДФ=dd.MM.yyyy") + ?(ЗначениеЗаполнено(Заказ.Рекомендации), " (" + Заказ.Рекомендации + ")", "");
		РабочийЛист.ДатаКонтакта = Дата(Год(Заказ.ДатаПроактивногоКонтакта), Месяц(Заказ.ДатаПроактивногоКонтакта), День(Заказ.ДатаПроактивногоКонтакта), Час(Заказ.ВремяПроактивногоКонтакта), Минута(Заказ.ВремяПроактивногоКонтакта), Секунда(Заказ.ВремяПроактивногоКонтакта));
		РабочийЛист.КонтактнаяИнформацияПроактивногоКонтакта = Заказ.КонтактнаяИнформацияПроактивногоКонтакта;
		РабочийЛист.Комментарий = "Последнее обращение: " + Строка(Заказ.ПричинаОбращения) + Символы.ПС;
		РабочийЛист.Комментарий = РабочийЛист.Комментарий + Строка(Заказ.Ссылка);
		
		Попытка
			РабочийЛист.Записать(РежимЗаписиДокумента.Проведение);
		Исключение			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры
