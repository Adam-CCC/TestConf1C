// Закрытие РЛ по которым нет контакта более 30 дней
Процедура ЗакрытьРЛПравило30Дней(НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт  
	
	Если НачалоПериода = Дата(1, 1, 1) 
		ИЛИ НачалоПериода = Неопределено Тогда
		НачалоПериода = НачалоГода(ТекущаяДата());
	КонецЕсли;
	Если КонецПериода = Дата(1, 1, 1) 
		ИЛИ КонецПериода = Неопределено Тогда
		КонецПериода = КонецГода(ТекущаяДата());
	КонецЕсли;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочийЛист.Ссылка КАК РЛ,
		|	РабочийЛист.Статус КАК СтатусРЛ,
		|	Событие.Ссылка КАК Событие,
		|	Событие.ВидСобытия КАК ВидСобытия,
		|	Событие.Состояние КАК Состояние,
		|	Событие.ТипСообщения КАК ТипСообщения,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Событие.Дата >= ДОБАВИТЬКДАТЕ(&ТекущаяДата, МЕСЯЦ, -1)
		|					И Событие.ВидСобытия В (&ВидыСобытий)
		|					И Событие.Состояние В (&Состояния)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК УдачныйКонтакт30Дней
		|ИЗ
		|	Документ.РабочийЛист КАК РабочийЛист
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
		|		ПО РабочийЛист.Ссылка = Событие.ДокументОснование
		|ГДЕ
		|	РабочийЛист.Статус = &Статус
		|	И РабочийЛист.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ РабочийЛист.ПометкаУдаления
		|	И НЕ Событие.ПометкаУдаления
		|	И РабочийЛист.Проведен
		|	И РабочийЛист.Дата < ДОБАВИТЬКДАТЕ(&ТекущаяДата, МЕСЯЦ, -1)
		|
		|СГРУППИРОВАТЬ ПО
		|	РабочийЛист.Ссылка,
		|	РабочийЛист.Статус,
		|	Событие.Ссылка,
		|	Событие.ВидСобытия,
		|	Событие.Состояние,
		|	Событие.ТипСообщения
		|
		|УПОРЯДОЧИТЬ ПО
		|	РабочийЛист.Дата УБЫВ
		|ИТОГИ ПО
		|	РЛ";
	
	Статус = Справочники.СтатусыРабочегоЛиста.Интерес;     
	
	ВидыСобытий = Новый СписокЗначений;
	ВидыСобытий.Добавить(Перечисления.ВидыСобытий.ЗаявкаССайта);  
	ВидыСобытий.Добавить(Перечисления.ВидыСобытий.ЛичнаяВстреча); 
	ВидыСобытий.Добавить(Перечисления.ВидыСобытий.ТелефонныйЗвонок);
	ВидыСобытий.Добавить(Перечисления.ВидыСобытий.ТестДрайв); 
	
	Состояния = Новый СписокЗначений;
	Состояния.Добавить(Перечисления.СостоянияСобытий.Завершено);
	Состояния.Добавить(Перечисления.СостоянияСобытий.Выполняется);
	
	Запрос.УстановитьПараметр("ВидыСобытий", ВидыСобытий);
	Запрос.УстановитьПараметр("Состояния", Состояния);
	Запрос.УстановитьПараметр("Статус", Статус);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));

	
	РезультатЗапроса = Запрос.Выполнить();                 
		
	ВыборкаРЛ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРЛ.Следующий() Цикл
		
		// если нет контакта более 30 дней
		Если НЕ ВыборкаРЛ.УдачныйКонтакт30Дней Тогда
			РЛ = ВыборкаРЛ.РЛ;
			ВыборкаСобытий = ВыборкаРЛ.Выбрать(); 			
			Пока ВыборкаСобытий.Следующий() Цикл	
				Попытка
					Событие = ВыборкаСобытий.Событие.ПолучитьОбъект();
					Если Событие.Состояние <> Перечисления.СостоянияСобытий.Выполняется
						И Событие.Состояние <> Перечисления.СостоянияСобытий.Завершено Тогда
						Событие.Состояние = Перечисления.СостоянияСобытий.Отменено;	
					КонецЕсли;
					Событие.Записать(РежимЗаписиДокумента.Проведение); 
				Исключение
					Сообщить("Не удалось провести " + ВыборкаСобытий.Событие + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное); 
				КонецПопытки;
			КонецЦикла; 
			СобытиеОбъект = Документы.Событие.СоздатьДокумент();
			СобытиеОбъект.Заполнить(РЛ); 
			СобытиеОбъект.ДокументОснование = РЛ.Ссылка;
			СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Завершено;
			СобытиеОбъект.Приоритет = Перечисления.Важность.Средняя;
			СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля;
			СобытиеОбъект.Результат = "Отсутствие контакта больше 30 дней";
			СобытиеОбъект.ДатаНачала = ТекущаяДата();
			СобытиеОбъект.ДатаОкончания = СобытиеОбъект.ДатаНачала + 900;
			СобытиеОбъект.ПредметОбращения = Справочники.ПредметыОбращения.Автосалон;
			СобытиеОбъект.ВторичныйКонтакт = Истина;
			Если РЛ.ЮридическоеЛицо Тогда
				СобытиеОбъект.ТипКлиента = Перечисления.ФормыСобственности.ЮридическоеЛицо;
			Иначе
				СобытиеОбъект.ТипКлиента = Перечисления.ФормыСобственности.ЧастноеЛицо;
			КонецЕсли;
			
			Попытка
				СобытиеОбъект.Записать(РежимЗаписиДокумента.Запись);
			Исключение    
				Сообщить("Не удалось записать Отказ !" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
			КонецПопытки;

			Попытка 
				РЛ = ВыборкаРЛ.РЛ.ПолучитьОбъект();
				РЛ.Статус = Справочники.СтатусыРабочегоЛиста.НайтиПоКоду("00000020");
				РЛ.Записать(РежимЗаписиДокумента.Проведение); 
				РЛИзменен = Истина;
			Исключение
				Сообщить("Не удалось провести " + ВыборкаРЛ.РЛ + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
				РЛИзменен = Ложь;
			КонецПопытки;
			
		КонецЕсли; 
		
	КонецЦикла;	      

КонецПроцедуры // ЗакрытьРЛ30Дней()  
