Процедура СоздатьОпросПриПроведенииДокумента(Источник) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	АнкетаПоБренду = Истина;
	ЗаполнениеПоЗН = ложь;
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
		ЗаполнениеПоЗН = истина;
	КонецЕсли;
	
	Если (НачалоДня(ТекущаяДата()) - НачалоДня(Источник.Дата)) / (60 * 60 * 24) > 2 тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаполнениеПоЗН Тогда
		Если Источник.Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт
			ИЛИ НЕ ВидРемонтаПодходит(Источник.ВидРемонта) тогда 
			Возврат;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Источник.Заказчик) И 
			(Источник.Заказчик.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ПодотчетноеЛицо ИЛИ Источник.Заказчик.НашаФирма) Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Источник.Контрагент.НашаФирма тогда
			Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Опрос.Ссылка
		|ИЗ
		|	Документ.Опрос КАК Опрос
		|ГДЕ
		|	Опрос.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
	
	Результат = Запрос.Выполнить();	
	Если НЕ Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиЗвонковВежливости.Подразделение,
		|	НастройкиЗвонковВежливости.Анкета3Дня,
		|	НастройкиЗвонковВежливости.АнкетаСервис,
		|	НастройкиЗвонковВежливости.ОтветственныйМенеджер,
		|	1 КАК УровеньИерархии
		|ИЗ
		|	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
		|ГДЕ
		|	НастройкиЗвонковВежливости.Подразделение = &Подразделение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкиЗвонковВежливости.Подразделение,
		|	НастройкиЗвонковВежливости.Анкета3Дня,
		|	НастройкиЗвонковВежливости.АнкетаСервис,
		|	НастройкиЗвонковВежливости.ОтветственныйМенеджер,
		|	2
		|ИЗ
		|	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
		|ГДЕ
		|	НастройкиЗвонковВежливости.Подразделение = ВЫРАЗИТЬ(&Подразделение КАК Справочник.ПодразделенияКомпании).Родитель
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкиЗвонковВежливости.Подразделение,
		|	НастройкиЗвонковВежливости.Анкета3Дня,
		|	НастройкиЗвонковВежливости.АнкетаСервис,
		|	НастройкиЗвонковВежливости.ОтветственныйМенеджер,
		|	3
		|ИЗ
		|	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
		|ГДЕ
		|	НастройкиЗвонковВежливости.Подразделение = ВЫРАЗИТЬ(&Подразделение КАК Справочник.ПодразделенияКомпании).Родитель.Родитель";
	
	Запрос.УстановитьПараметр("Подразделение", Источник.ПодразделениеКомпании);	
	Результат = Запрос.Выполнить().Выбрать();
	Для Сч = 1 По 3 Цикл
		Если Результат.НайтиСледующий(Сч,"УровеньИерархии") тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ДокОпрос = Документы.Опрос.СоздатьДокумент();
	ДокОпрос.Заполнить(Источник);
	ДокОпрос.ДокументОснование = Источник.Ссылка;
	Если ЗаполнениеПоЗН тогда
		ДокОпрос.Дата = Источник.ДатаЗакрытия + 60*60*24*3;
		ДокОпрос.ОпрашиваемоеЛицо = Источник.Заказчик;
		ДокОпрос.Мастер = Источник.Диспетчер; 
	Иначе
		ДокОпрос.Дата = Источник.Дата + 60*60*24*3;
		ДокОпрос.ОпрашиваемоеЛицо = Источник.Контрагент;
		ДокОпрос.Мастер = Источник.Менеджер; 
	КонецЕсли;
	ДокОпрос._г_ДатаСоздания = ТекущаяДата();
	ДокОпрос.СпособКонтакта = Перечисления.ВидыСобытий.ТелефонныйЗвонок;
	ДокОпрос.Менеджер = Результат.ОтветственныйМенеджер;
	Если ЗначениеЗаполнено(ДокОпрос.ОпрашиваемоеЛицо) И ТипЗнч(ДокОпрос.ОпрашиваемоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		ДокОпрос.Поле = ДокОпрос.ОпрашиваемоеЛицо.ОсновнойТелефон;
	КонецЕсли;
	
	Если АнкетаПоБренду Тогда
		Если ЗаполнениеПоЗН тогда
			МаркаАМ = Источник.Автомобиль.Модель.Марка;
		Иначе
			МаркаАМ = Источник.Автомобили[0].Автомобиль.Модель.Марка;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиЗвонковВежливости.Анкета3Дня,
		|	НастройкиЗвонковВежливости.АнкетаСервис,
		|	1 КАК Приоритет
		|ИЗ
		|	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
		|ГДЕ
		|	НастройкиЗвонковВежливости.МаркаАМ = &МаркаАМ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкиЗвонковВежливости.Анкета3Дня,
		|	НастройкиЗвонковВежливости.АнкетаСервис,
		|	2
		|ИЗ
		|	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
		|ГДЕ
		|	НастройкиЗвонковВежливости.Подразделение =  Значение(Справочник.ПодразделенияКомпании.ПустаяСсылка)
		|	И НастройкиЗвонковВежливости.МаркаАМ =  Значение(Справочник.Марка.ПустаяСсылка)";
		
		Запрос.УстановитьПараметр("МаркаАМ", МаркаАМ);
		Запрос.УстановитьПараметр("Подразделение", Источник.ПодразделениеКомпании);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() тогда  
			Результат = РезультатЗапроса.Выбрать(); 
			Для Сч = 1 По 2 Цикл
				Если Результат.НайтиСледующий(Сч,"Приоритет") тогда
				Прервать;
		КонецЕсли;
	КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если ЗаполнениеПоЗН тогда
		ДокОпрос.ТиповаяАнкета = Результат.АнкетаСервис;
	Иначе
		ДокОпрос.ТиповаяАнкета = Результат.Анкета3Дня;
	КонецЕсли;
	
	#Если Клиент Тогда
	Попытка
		зфОпросОбновитьСписокВопросов(ДокОпрос);
	Исключение
	КонецПопытки;
	#КонецЕсли
	
	Попытка
	ДокОпрос.Записать(РежимЗаписиДокумента.Запись);
	Исключение
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры     

Функция ВидРемонтаПодходит(ВидРемонта) 
	
	Если ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.КоммерческийРемонт
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ТехническоеОбслуживание
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ТехническоеОбслуживаниеБесплатное
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ТО_ноль
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ТО_нольПлатный
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ГарантияHPromise
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ГарантияДистирибьютера
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ГарантияПроизводителя
		ИЛИ ВидРемонта = Справочники.ВидыРемонта.ГарантияПроизводителяЛКП
		Тогда 
		Возврат Истина;
	Иначе
		Возврат ложь;
	КонецЕсли;
КонецФункции

