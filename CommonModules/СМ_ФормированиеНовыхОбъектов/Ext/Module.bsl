Процедура ЗапланироватьИсходящийЗвонок(ДокументСсылка, Содержание, ДатаНачала)
	Если ОбЗначениеНеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументСсылка.Статус = Справочники.СтатусыРабочегоЛиста.Отказ 
		Или ДокументСсылка.Статус = Справочники.СтатусыРабочегоЛиста.Продажа Тогда
		
		ТекущийРабочийЛист = СоздатьНовыйРабочийЛист(ДокументСсылка);
		Если обЗначениеНеЗаполнено(ТекущийРабочийЛист) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		ТекущийРабочийЛист = ДокументСсылка;
	КонецЕсли;
	
	СобытиеОбъект = Документы.Событие.СоздатьДокумент();
	СобытиеОбъект.Заполнить(ТекущийРабочийЛист);
	СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок;
	СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Запланировано;
	СобытиеОбъект.Содержание = Содержание;
	СобытиеОбъект.Приоритет = Перечисления.Важность.Средняя;
	СобытиеОбъект.ДатаНачала = ДатаНачала;
	СобытиеОбъект.ДатаОкончания = ДатаНачала + 900;
	
	Попытка
		СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		//СобытиеОбъект.ОбменДанными.Загрузка = Истина;
		//СобытиеОбъект.Записать();
		#Если Клиент Тогда
		Сообщить("Не удалось запланировать событие: " 
		    	+ Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
		#КонецЕсли
	КонецПопытки;
	#Если Клиент Тогда
	Сообщить("Запланировано " + Строка(СобытиеОбъект.Ссылка), СтатусСообщения.Информация);
	#КонецЕсли
	
КонецПроцедуры

Функция СоздатьНовыйРабочийЛист(ДокументСсылка)
