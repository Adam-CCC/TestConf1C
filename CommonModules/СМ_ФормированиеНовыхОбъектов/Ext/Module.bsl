Функция ВернутьСтруктуруПоступления(Авто,ДатаЗнач) Экспорт
	
	Если НЕ обЗначениеНеЗаполнено(Авто) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
		               |	ОстаткиАвтомобилейОстатки.СкладКомпании КАК СкладКомпании,
		               |	ОстаткиАвтомобилейОстатки.СтатусПартии КАК СтатусПартии,
		               |	ОстаткиАвтомобилейОстатки.Партия КАК Партия,
		               |	ОстаткиАвтомобилейОстатки.ГТД КАК ГТД,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.КоличествоОстаток, 0) КАК Количество,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаОстаток, 0) КАК Сумма,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаУпрОстаток, 0) КАК СуммаУпр,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаНДСОстаток, 0) КАК СуммаНДС
		               |ПОМЕСТИТЬ ПартияАвто
		               |ИЗ
		               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&Момент, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки
		               |
		               |ДЛЯ ИЗМЕНЕНИЯ
		               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЕСТЬNULL(ПоступлениеАвтомобилейАвтомобили.АвтомобильБУ, ЛОЖЬ) КАК БУ,
		               |	ПоступлениеАвтомобилейАвтомобили.СуммаВсего,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Организация,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Организация.ФормаСобственности КАК ОрганизацияФормаСобственности,
		               |	ЕСТЬNULL(ПоступлениеАвтомобилейАвтомобили.ПараллельныйИмпорт, ЛОЖЬ) КАК ПараллельныйИмпорт,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент КАК Контрагент,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.ОГРН КАК КонтрагентОГРН,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.ИНН КАК КонтрагентИНН,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.ХозОперация КАК ХозОперация,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.ФормаСобственности КАК КонтрагентФормаСобственности,
		               |	ПоступлениеАвтомобилейАвтомобили.ВидАвтомобиля КАК ВидАвтомобиля,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата
		               |ИЗ
		               |	ПартияАвто КАК ПартияАвто
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
		               |		ПО ПартияАвто.Партия.Ссылка = ПоступлениеАвтомобилейАвтомобили.Ссылка
		               |ГДЕ
		               |	(ПоступлениеАвтомобилейАвтомобили.Ссылка.ХозОперация = &ХозОперацияПоступлениеАвтомобилейКомиссия
		               |			ИЛИ ПоступлениеАвтомобилейАвтомобили.Ссылка.ХозОперация = &ХозОперацияПоступлениеАвтомобилей)";
		
		Запрос.УстановитьПараметр("Момент",ДатаЗнач);
		Запрос.УстановитьПараметр("Автомобиль",Авто);
		Запрос.УстановитьПараметр("ХозОперацияПоступлениеАвтомобилейКомиссия",Справочники.ХозОперации.ПоступлениеАвтомобилейКомиссия);
		Запрос.УстановитьПараметр("ХозОперацияПоступлениеАвтомобилей",Справочники.ХозОперации.ПоступлениеАвтомобилей);
 	  								   
		Результат = Запрос.Выполнить().Выбрать();
 		СтруктураВозврата = Новый Структура;
		Если Результат.Следующий() тогда
			СтруктураВозврата.Вставить("БУ",Результат.БУ);
			СтруктураВозврата.Вставить("ХозОперация",Результат.ХозОперация);
			СтруктураВозврата.Вставить("ПараллельныйИмпорт",Результат.ПараллельныйИмпорт);
			СтруктураВозврата.Вставить("Импортер",Результат.Контрагент);
			СтруктураВозврата.Вставить("ИмпортерИНН",Результат.КонтрагентИНН);
			СтруктураВозврата.Вставить("ИмпортерОГРН",Результат.КонтрагентОГРН);
			СтруктураВозврата.Вставить("ВидАвтомобиля",Результат.ВидАвтомобиля);
			//Бондаренко++ 20230222
			СтруктураВозврата.Вставить("ИмпортерФормаСобственности",Результат.КонтрагентФормаСобственности);
            //Бондаренко-- 20230222
			//Бондаренко++ 20230222
			СтруктураВозврата.Вставить("ОрганизацияФормаСобственности",Результат.ОрганизацияФормаСобственности);
			СтруктураВозврата.Вставить("ДатаПоступления",Результат.Дата);
            //Бондаренко-- 20230222
  			Возврат СтруктураВозврата;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции //ВернутьСтруктуруПоступленияОМ(Авто,ДатаЗнач)
