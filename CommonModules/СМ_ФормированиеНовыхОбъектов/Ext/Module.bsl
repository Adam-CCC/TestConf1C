	//ТекущаяДата = Дата(2021, 9, 15); 
	ТекущаяДата = ТекущаяДата();
	СоздатьЗвонкиВежливости(ТекущаяДата);
	СоздатьЗвонкиВежливостиФордФиат(ТекущаяДата);
