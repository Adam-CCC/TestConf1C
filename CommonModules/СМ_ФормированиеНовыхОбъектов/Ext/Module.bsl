				ЗапланироватьЗвонокВежливости(СтрокаВыдача.Ссылка, Справочники.Сотрудники.ПустаяСсылка(), Содержание);
			//КонецЕсли;			
		КонецЦикла;
		
		тзВыдачиУволенныхМенеджеров = тзЗавершенныеВыдачи.Скопировать(Новый Структура("ПродавецУволен", Истина));		
		Для Каждого СтрокаВыдача Из тзВыдачиУволенныхМенеджеров Цикл
			//Если АвтомобильНовый(СтрокаВыдача.Автомобиль, ДатаНачала) Тогда
				Менеджер = СлучайныйВыборСотрудника(СтрокаВыдача.Подразделение, Справочники.Должности.МенеджерОтделаПродажАвтомобилей, ТекущаяДата);
				Если ЗначениеЗаполнено(Менеджер) Тогда
					Содержание = ПолучитьСодержаниеЗвонка(СтрокаВыдача.Марка, ИндексЗвонка);
					ЗапланироватьЗвонокВежливости(СтрокаВыдача.Ссылка, Менеджер, Содержание);
				Иначе
					Продолжить;
				КонецЕсли;			
			//КонецЕсли;			
		КонецЦикла;
		
		ИндексЗвонка = ИндексЗвонка + 1;
	КонецЦикла;	
КонецПроцедуры

Функция ПолучитьЗавершенныеВыдачи(ДатаНачала, ДатаОкончания, ТолькоФордФиат = Ложь)
	мМаркиАвто = Новый Массив();
	мМаркиАвто.Добавить(Справочники.Марка.FORD);
	мМаркиАвто.Добавить(Справочники.Марка.FIAT);
	
	ЗапросВыдачи = Новый Запрос();
	ЗапросВыдачи.УстановитьПараметр("Завершено", Перечисления.СостоянияСобытий.Завершено);
	ЗапросВыдачи.УстановитьПараметр("ВыдачаАвтомобиля", Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
	ЗапросВыдачи.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ЗапросВыдачи.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ЗапросВыдачи.УстановитьПараметр("СписокМарок", мМаркиАвто);
	ЗапросВыдачи.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка КАК Ссылка,
	|	Событие.Продавец.ФлагУволен КАК ПродавецУволен,
	|	Событие.Автомобиль КАК Автомобиль,
	|	Событие.ПодразделениеКомпании КАК Подразделение,
	|	Событие.Автомобиль.Модель.Марка КАК Марка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.Состояние = &Завершено
	|	И Событие.ВидСобытия = &ВыдачаАвтомобиля
	|	И Событие.ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	Если ТолькоФордФиат Тогда
		ЗапросВыдачи.Текст = ЗапросВыдачи.Текст + " И Событие.Автомобиль.Модель.Марка В (&СписокМарок)";
	Иначе
		ЗапросВыдачи.Текст = ЗапросВыдачи.Текст + " И Не Событие.Автомобиль.Модель.Марка В (&СписокМарок)";
	КонецЕсли;
	
	Возврат ЗапросВыдачи.Выполнить().Выгрузить();
КонецФункции

Процедура ЗапланироватьЗвонокВежливости(ВыдачаСсылка, Продавец, Содержание)
	РабочийЛист = ВыдачаСсылка.ДокументОснование;
	Если обЗначениеНеЗаполнено(РабочийЛист) Или ТипЗнч(РабочийЛист) <> Тип("ДокументСсылка.РабочийЛист") Тогда
		#Если Клиент Тогда
		Сообщить("Выдача <" + Строка(ВыдачаСсылка) + "> не на основании рабочего листа!", СтатусСообщения.Информация);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	СобытиеОбъект = Документы.Событие.СоздатьДокумент();
	СобытиеОбъект.Заполнить(РабочийЛист);
	СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ЗвонокВежливости;
	СобытиеОбъект.Содержание = Содержание;
	СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Запланировано;
	СобытиеОбъект.Приоритет = Перечисления.Важность.Средняя;
	СобытиеОбъект.ВторичныйКонтакт = Истина;
	
	ТекущаяДата = ТекущаяДата();
	ДатаНачала = Дата(Год(ТекущаяДата), Месяц(ТекущаяДата), День(ТекущаяДата), 10, 0, 0);
	СобытиеОбъект.ДатаНачала = ДатаНачала;
	СобытиеОбъект.ДатаОкончания = ДатаНачала + 900;
	
	Если ЗначениеЗаполнено(Продавец) Тогда
		СобытиеОбъект.Продавец = Продавец;
	Иначе
		СобытиеОбъект.Продавец = ВыдачаСсылка.Продавец;
	КонецЕсли;
	
	Попытка
		СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		СобытиеОбъект.ОбменДанными.Загрузка = Истина;
		СобытиеОбъект.Записать();
	КонецПопытки;
	
	#Если Клиент Тогда
	Сообщить("Запланировано " + Строка(СобытиеОбъект.Ссылка), СтатусСообщения.Информация);
	#КонецЕсли
КонецПроцедуры

Функция АвтомобильНовый(Автомобиль, НаДату) Экспорт
	Значение = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, НаДату);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение = Перечисления.ВидАвтомобиля.Новый;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции
 
Функция СлучайныйВыборСотрудника(Подразделение, Должность, Дата) Экспорт
	ЗапросСотрудники = Новый Запрос();
	ЗапросСотрудники.УстановитьПараметр("Подразделение", Подразделение);
	ЗапросСотрудники.УстановитьПараметр("Должность", Должность);
	ЗапросСотрудники.УстановитьПараметр("Дата", НачалоДня(Дата));
	ЗапросСотрудники.Текст =
	"ВЫБРАТЬ
	|	ГрафикРаботКалендарный.График
	|ПОМЕСТИТЬ ГрафикиРаботающих
	|ИЗ
	|	РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
	|ГДЕ
	|	ГрафикРаботКалендарный.Дата = &Дата
	|	И ГрафикРаботКалендарный.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидДня.Рабочий)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ГрафикиРаботающих КАК ГрафикиРаботающих
	|		ПО Сотрудники.ГрафикРаботы = ГрафикиРаботающих.График
	|ГДЕ
	|	Сотрудники.Подразделение В ИЕРАРХИИ(&Подразделение)
	|	И Сотрудники.Должность = &Должность
	|	И НЕ Сотрудники.ФлагУволен";
	
	тзСотрудники = ЗапросСотрудники.Выполнить().Выгрузить();
	КоличествоСотрудников = тзСотрудники.Количество();
	Если КоличествоСотрудников = 0 Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	ИначеЕсли КоличествоСотрудников = 1 Тогда
		Возврат тзСотрудники[0].Сотрудник; 
	КонецЕсли;
	
	ГСЧ = Новый ГенераторСлучайныхЧисел();
	Индекс = ГСЧ.СлучайноеЧисло(0, КоличествоСотрудников - 1);	
	Возврат тзСотрудники[Индекс].Сотрудник;
КонецФункции

