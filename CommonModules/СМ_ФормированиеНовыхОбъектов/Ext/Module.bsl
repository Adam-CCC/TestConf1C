Функция СМГ_НайтиХозяинаПоЗаказНаряду(Автомобиль) Экспорт                 
	
	ХозяинПоЗН = Справочники.Контрагенты.ПустаяСсылка();
	
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказНаряд.Автомобиль.Ссылка КАК Автомобиль,
		|	ЗаказНаряд.Заказчик КАК Заказчик,
		|	ЗаказНаряд.Дата
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗаказНаряд.Проведен КАК Проведен,
		|			МАКСИМУМ(ЗаказНаряд.Дата) КАК Дата,
		|			ЗаказНаряд.Автомобиль КАК Автомобиль
		|		ИЗ
		|			Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ГДЕ
		|			ЗаказНаряд.Проведен = ИСТИНА
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЗаказНаряд.Проведен,
		|			ЗаказНаряд.Автомобиль) КАК ВложенныйЗапрос
		|		ПО ЗаказНаряд.Автомобиль = ВложенныйЗапрос.Автомобиль
		|ГДЕ
		|	ЗаказНаряд.Проведен = ИСТИНА
		|	И ЗаказНаряд.Автомобиль = &Автомобиль
		|	И ЗаказНаряд.Дата = ВложенныйЗапрос.Дата";
		
		Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ХозяинПоЗН = ВыборкаДетальныеЗаписи.Заказчик;
		КонецЦикла; 
		
		Возврат ХозяинПоЗН;
 
КонецФункции // СМГ_НайтиХозяинаПоЗаказНаряду(Автомобиль)
