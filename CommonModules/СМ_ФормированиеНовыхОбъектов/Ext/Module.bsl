	"ВЫБРАТЬ
	|	СчетФактураПолученный.Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.ДокументОснование = &ДокументОснование";
 	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
  	РезультатЗапроса = Запрос.Выполнить();
  	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
  	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СчетФактура = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	
	СчетФактура.ОбработкаЗаполнения(Источник.Ссылка);
	
	СчетФактура.ДоговорВзаиморасчетов = Источник.ДоговорВзаиморасчетов;
	
 	Попытка
		СчетФактура.Дата = Источник.Дата;	
 	Исключение
	КонецПопытки;           
	
 	Попытка
		СчетФактура.УстановитьНовыйНомер();	
 	Исключение
	КонецПопытки;          
 	
  	Попытка
		СчетФактура.Записать(РежимЗаписиДокумента.Запись);
		Попытка
			СчетФактура.Записать(РежимЗаписиДокумента.Проведение);
		Исключение 
		ФлОтказ = Истина;	
 	 	#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+СчетФактура+"' не удалось провести.",СтатусСообщения.ОченьВажное);
	  	#КонецЕсли 
 		КонецПопытки;
	Исключение
		ФлОтказ = Истина;	
	 	#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+СчетФактура+"' не удалось записать.",СтатусСообщения.ОченьВажное);
	  	#КонецЕсли 
	КонецПопытки;           
	Возврат ФлОтказ;
КонецФункции // СМГ_НайтиСоздатьСФполученный(Источник)  
 
Функция НайтиСоздатьДоговор(Владелец,Организация,Подразделение,ВидДоговора) Экспорт
  	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка,
		|	ДоговорыВзаиморасчетов.ВидДоговора КАК ВидДоговора,
		|	ДоговорыВзаиморасчетов.Организация КАК Организация,
		|	ДоговорыВзаиморасчетов.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
		|ГДЕ
		|	ДоговорыВзаиморасчетов.Владелец = &Владелец
		|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
		|	И ДоговорыВзаиморасчетов.Организация = &Организация
		|	И НЕ ДоговорыВзаиморасчетов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;

	НовДоговор = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	НовДоговор.ВидДоговора = ВидДоговора;
	НовДоговор.Автор = ПараметрыСеанса.Пользователь; 
	НовДоговор.Организация = Организация;
	НовДоговор.Подразделение = Подразделение;
	НовДоговор.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	Новдоговор.ДатаНачала = ТекущаяДата();
	НовДоговор.ТипДоговора=Перечисления.ТипыДоговоров.Договор;
	НовДоговор.ВидОплаты=Перечисления.ВидыОплаты.БезналичныйРасчет;
	НовДоговор.Владелец=Владелец; 
	НовДоговор.СформироватьНаименование();                         
	НовДоговор.УстановитьНовыйКод("");
	
	Попытка
		НовДоговор.Записать();
	Исключение
		УстановитьПривилегированныйРежим(Истина);
		ОбновитьНумерациюОбъектов(Метаданные.Справочники.ДоговорыВзаиморасчетов);
		УстановитьПривилегированныйРежим(Ложь);
		НовДоговор.УстановитьНовыйКод("");
 		Попытка
  			НовДоговор.Записать();
		Исключение 
			СМГ_Сообщить("Ошибка! Не создан договор взаиморасчетов.",СтатусСообщения.ОченьВажное);
		КонецПопытки;
	КонецПопытки;
	
	Возврат НовДоговор.Ссылка;
 
КонецФункции // НайтиСоздатьДоговор(Владелец,Организация,Подразделение,ВидДоговора)
 
Функция СМГ_НайтиПодразделениеПоРодителю(Организация,Родитель) Экспорт
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка,
		|	ПодразделенияКомпании.Организация,
		|	ПодразделенияКомпании.Родитель
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Организация = &Организация
		|	И ПодразделенияКомпании.Родитель = &Родитель
		|	И ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Справочники.ПодразделенияКомпании.ПустаяСсылка();
 
КонецФункции // СМГ_НайтиПодразделениеПоРодителю(Организация,Родитель)

Функция СМГ_НайтиПодразделениеПоСкладуОстатковАвто(Автомобиль,ДатаОстатков) Экспорт
	
	НайденноеПодразделение = Справочники.ПодразделенияКомпании.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение КАК Подразделение,
		|	ОстаткиАвтомобилейОстатки.Автомобиль,
		|	ОстаткиАвтомобилейОстатки.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&ДатаОстатков, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки
		|ГДЕ
		|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0";
	
 		Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
 		Запрос.УстановитьПараметр("ДатаОстатков", ДатаОстатков);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();;
		
		Если РезультатЗапроса.Количество() > 0 тогда
 			НайденноеПодразделение = РезультатЗапроса[0].Подразделение;
		КонецЕсли;                                   
		
		Возврат НайденноеПодразделение; 
 
КонецФункции // СМГ_НайтиПодразделениеПоСкладуОстатковАвто()

Функция СМГ_НайтиСоздатьДоговорСубподрядСВидомДоговора(ТекКонтрагент,ТекОрганизация,ТекПодразделение,ТекВидДоговора) 
	
	НовДог = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыВзаиморасчетов.Ссылка,
	               |	ДоговорыВзаиморасчетов.Владелец,
	               |	ДоговорыВзаиморасчетов.Организация,
	               |	ДоговорыВзаиморасчетов.ВидДоговора
	               |ИЗ
	               |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	               |ГДЕ
	               |	ДоговорыВзаиморасчетов.Владелец = &Владелец
	               |	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
	               |	И ДоговорыВзаиморасчетов.Организация = &Организация
	               |	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
	               |	И ДоговорыВзаиморасчетов.ЭтоГруппа = ЛОЖЬ
	               |	И ДоговорыВзаиморасчетов.Наименование ПОДОБНО &Субподряд";
	 
	Запрос.УстановитьПараметр("Владелец",ТекКонтрагент);
 	Запрос.УстановитьПараметр("Организация",ТекОрганизация);
	Запрос.УстановитьПараметр("ВидДоговора",ТекВидДоговора);
	Запрос.УстановитьПараметр("Субподряд","%%"+"СУБПОДРЯД"+"%%");
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовДог                      = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	
	НовДог.УстановитьНовыйКод();
	
	НовДог.ТипДоговора          = Перечисления.ТипыДоговоров.Договор;
 	НовДог.ВидДоговора          = ТекВидДоговора;
	НовДог.Владелец             = ТекКонтрагент;
	НовДог.Организация          = ТекОрганизация;
	НовДог.Подразделение        = ТекПодразделение;
	НовДог.Владелец             = ТекКонтрагент;
	НовДог.ДатаНачала           = ТекущаяДата();
	НовДог.НомерДоговора        = "";
 	НовДог.Автор                = ПараметрыСеанса.Пользователь;
	НовДог.ДатаСоздания         = ТекущаяДата();
	НовДог.ВидОплаты            = Перечисления.ВидыОплаты.ПроизвольнаяОплата;
	НовДог.Комментарий          = "Договор создан обработкой. Пользователь: "+ПараметрыСеанса.Пользователь+" "+Формат(ТекущаяДата(),"ДЛФ=DDT");
	НовДог.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
 	НовДог.ТипЦенПродажи        = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
	НовДог.ТипЦенРабот          = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
	НовДог.ТипЦенПокупки        = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;

	НовДог.СформироватьНаименование();
	НовДог.Наименование = СокрЛП(НовДог.Наименование)+" СУБПОДРЯД";

	//Форма = НовДог.ПолучитьФорму("ФормаЭлемента");
	//Если Не Форма.Открыта() Тогда
	//	Форма.ОткрытьМодально();
	//КонецЕсли;
	
	Попытка
		НовДог.Записать();
		#Если Клиент Тогда 
			Сообщить("Записан новый договор "+НовДог);
		#КонецЕсли
	Исключение
		#Если Клиент Тогда 
			Сообщить("ОШИБКА! Не удалось записать новый договор взаиморасчетов ",СтатусСообщения.ОченьВажное);	
		#КонецЕсли
   	КонецПопытки; 
	
	Возврат НовДог.Ссылка;

КонецФункции // СМГ_НайтиСоздатьДоговорСубподрядСВидомДоговора(ТекКонтрагент,ТекОрганизация,ТекПодразделение,ТекВидДоговора)
