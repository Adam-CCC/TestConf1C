		"ВЫБРАТЬ
		|	ПодразделенияГКМаркиАвтомобилей.Марка КАК Марка,
		|	ПодразделенияГКМаркиАвтомобилей.Ссылка КАК ПодразделениеГК
		|ИЗ
		|	Справочник.ПодразделенияГК.МаркиАвтомобилей КАК ПодразделенияГКМаркиАвтомобилей
		|ГДЕ
		|	ПодразделенияГКМаркиАвтомобилей.Ссылка В(&СписокПодразделенийГК)
		|	И ПодразделенияГКМаркиАвтомобилей.Марка = &Марка
		|	И ПодразделенияГКМаркиАвтомобилей.Ссылка.Сервис";
	
	Запрос.УстановитьПараметр("СписокПодразделенийГК", СписокПодразделенийГК);
	Запрос.УстановитьПараметр("Марка", Марка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Подр_ = ВыборкаДетальныеЗаписи.ПодразделениеГК;
		Прервать;
