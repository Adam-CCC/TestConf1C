// Формирование штрихкодов внешним компонентом 1C:Печать штрихкодов
// Формирование штрихкода внешним компонентом 1С:Печать штрихкодов
//
// ТипКода:
// 1  - EAN13
// 24 - GS1 DataMatrix
//
Процедура ВывестиКартинкуШтрихКода(Рисунок, ШтрихКод, ТипКода = Неопределено) Экспорт

	ВнешняяКомпонента = ПодключитьВнешнююКомпонентуПечатиШтрихкода();

	Если ВнешняяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	омЭталон = Метаданные.ОбщиеМакеты.Найти("Эталон");

	Если омЭталон = Неопределено Тогда
		Сообщить(
			"Не найден общий макет Эталон, печать штрихкода невозможна!",
			СтатусСообщения.Важное
		);
		Возврат;
	Иначе
		МакетЭталон = ПолучитьОбщийМакет("Эталон");
	КонецЕсли;

	КоличествоМиллиметровВПикселе =
		МакетЭталон.Рисунки.Квадрат100Пикселей.Высота / 100;

	// Размер картинки
	ВнешняяКомпонента.Ширина =
		Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе);

	ВнешняяКомпонента.Высота =
		Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе);

	// Общие настройки
	ВнешняяКомпонента.ОтображатьТекст = Истина;
	ВнешняяКомпонента.АвтоТип = Ложь;
	ВнешняяКомпонента.ТипВходныхДанных = 0;
	ВнешняяКомпонента.ЗначениеКода = Строка(ШтрихКод);
	ВнешняяКомпонента.УголПоворота = 0;
	ВнешняяКомпонента.УровеньКоррекцииQR = 1;

	// Если тип явно передан — используем его.
	// Если не передан — сохраняем старую логику.
	Если ТипКода <> Неопределено Тогда

		ВнешняяКомпонента.ТипКода = ТипКода;

	Иначе

		// Старая логика определения EAN13 / весового штрихкода
		ПрефиксВесовогоШК = Константы.ПрефиксВесовогоШК.Получить();

		ВнешняяКомпонента.ТипКода =
			Число(
				НЕ (
					СтрДлина(ШтрихКод) = 8
					И Число(Лев(ШтрихКод, 2)) <> ПрефиксВесовогоШК
				)
			);

	КонецЕсли;

	// Формируем картинку
	ДвоичныеДанныеКартинки = ВнешняяКомпонента.ПолучитьШтрихкод();

	Если ДвоичныеДанныеКартинки <> Неопределено Тогда
		Рисунок.Картинка = Новый Картинка(ДвоичныеДанныеКартинки);
	Иначе
		Сообщить(
			"Не удалось сформировать штрихкод. Тип: "
			+ Строка(ВнешняяКомпонента.ТипКода)
		);
	КонецЕсли;

КонецПроцедуры

Функция ПодключитьВнешнююКомпонентуПечатиШтрихкода()
	// Подлючение компоненты
	Попытка
		Если ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаПечатиШтрихкодов", "Barcode", ТипВнешнейКомпоненты.Native) Тогда
			ВнешняяКомпонента = Новый("AddIn.Barcode.Barcode");
		Иначе
			Сообщить("Не удалось подключить компоненту для формирования штрихкодов!");
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Сообщить("ОШИБКА при подключении компоненты для формирования штрихкодов: " + Символы.ПС + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	// Если нет возможности рисовать
	Если НЕ ВнешняяКомпонента.ГрафикаУстановлена Тогда
		// То картинку сформировать не сможем
		Сообщить("Не найдена графическая библиотека компоненты для формирования штрихкодов!");
		Возврат Неопределено;
		
	Иначе
		// Установим основные параметры компоненты
		Если ВнешняяКомпонента.НайтиШрифт("Tahoma") = Истина Тогда
			// Выбираем его как шрифт для формирования картинки
			ВнешняяКомпонента.Шрифт = "Tahoma";
			
		Иначе
			// Шрифт Tahoma в системе отсутствует
			// Обойдем все доступные компоненте шрифты
			Для Сч = 0 По ВнешняяКомпонента.КоличествоШрифтов -1 Цикл
				// Получим очередной шрифт, доступный компоненте
				ТекущийШрифт = ВнешняяКомпонента.ШрифтПоИндексу(Сч);
				// Если шрифт доступен
				Если ТекущийШрифт <> Неопределено Тогда
					// Они и будет шрифтом для формирования штри-кода
					ВнешняяКомпонента.Шрифт = ТекущийШрифт;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		// Утановим размер шрифта
		ВнешняяКомпонента.РазмерШрифта = 7;
		Возврат ВнешняяКомпонента;
	КонецЕсли;
КонецФункции

