Процедура ЗагрузитьБлокАвтомобиляИзДругойТочки(ОбъектXDTO)
	
	ЗагрузитьДокумент("Renault_БлокАвтомобиляИзДругойТочки", ОбъектXDTO);

КонецПроцедуры

Процедура ЗагрузитьВводОстатковАвтомобилейДругойТочки(ОбъектXDTO)
	
	НазваниеДокумента = "Renault_ВводОстатковАвтомобилейДругойТочки";
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	ТаблицаДанных = Сериализатор.ПрочитатьXDTO(ОбъектXDTO);
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого Строка Из ТаблицаДанных Цикл
		СсылкаНаОбъект = Документы[НазваниеДокумента].НайтиПоРеквизиту("BIR", Строка.BIR);
		Если СсылкаНаОбъект.Пустая() Тогда
			ДокОбъект = Документы[НазваниеДокумента].СоздатьДокумент();
		Иначе
			ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДокОбъект, Строка);		
		ДокОбъект.АвтомобилиНаОстатках.Очистить();
		Для Каждого СтрокаСостав Из Строка.АвтомобилиНаОстатках Цикл
			СтрокаАвтомобиля = ДокОбъект.АвтомобилиНаОстатках.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаАвтомобиля, СтрокаСостав);
			СтрокаАвтомобиля.Автомобиль = Справочники.Автомобили.НайтиПоРеквизиту("VIN", СтрокаСостав.VIN);
		КонецЦикла;
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

КонецПроцедуры