Процедура Обменяться() Экспорт
	
	Выборка = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	Пока Выборка.Следующий() Цикл 
		ЗагрузитьСообщенияДилера(Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьСообщенияДилера(Дилер)
	
	ВебСервис = ПолучитьПрокси();
	
	Server = СтрокаСоединенияИнформационнойБазы();

	ОбъектXDTO = ВебСервис.GetDataFromServerToDealer(Дилер.УникальныйИдентификатор(), Server);
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	ТаблицаДанных = Сериализатор.ПрочитатьXDTO(ОбъектXDTO);
	
	МассивОбработанных = Новый Массив;
	
	Для Каждого Пакет Из ТаблицаДанных Цикл
		
		Попытка
			
			ОбработатьОдноСообщение(Пакет);
			МассивОбработанных.Добавить(Пакет.МоментВремени);
			
		Исключение
			
			// Ничего не предпринимать - переходим к следующему сообщению	
			Инфо = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				"Обмен внутри дилера, загрузка данных из сервера",
				УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(Инфо));
		КонецПопытки;
		
	КонецЦикла;
	
	МассивОбработанныхОбъектXDTO = Сериализатор.ЗаписатьXDTO(МассивОбработанных);
	
	ВебСервис.ConfirmProcessingDealer(МассивОбработанныхОбъектXDTO, Дилер.УникальныйИдентификатор());
	
КонецПроцедуры

Процедура ОбработатьОдноСообщение(ДанныеСообщения)
	
	ДвоичныеДанныеФайла = ДанныеСообщения.Данные.Получить();
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	ЧтениеXML.Прочитать();
	ЧтениеXML.Прочитать(); // пропуск тэга Message
	Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		ТипXDTO = ФабрикаXDTO.Тип(ДанныеСообщения.ПространствоИменДанных, ЧтениеXML.Имя);
		ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
		СтрокаДляВыполнения = ДанныеСообщения.ИмяКомандыОбработки + "(ОбъектXDTO);";
		Выполнить(СтрокаДляВыполнения);
	КонецЦикла;
	ЧтениеXML.Закрыть();
	УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

Процедура ЗагрузитьДокумент(НазваниеДокумента, ОбъектXDTO)
	
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	ТаблицаДанных = Сериализатор.ПрочитатьXDTO(ОбъектXDTO);
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого Строка Из ТаблицаДанных Цикл
		
		СсылкаНаОбъект = Документы[НазваниеДокумента].ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.UID));
		ДокОбъект = СсылкаНаОбъект.ПолучитьОбъект();
		
		Если Строка.УдаленнаяЗапись И ДокОбъект <> Неопределено Тогда
			ДокОбъект.УстановитьПометкуУдаления(Истина);
			Продолжить;
		КонецЕсли;
		
		Если Строка.УдаленнаяЗапись И ДокОбъект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		БылПроведен = Ложь;
		Если ДокОбъект = Неопределено Тогда
			ДокОбъект = Документы[НазваниеДокумента].СоздатьДокумент();
			ДокОбъект.УстановитьСсылкуНового(СсылкаНаОбъект);
		Иначе
			БылПроведен = ДокОбъект.Проведен;
		КонецЕсли;
		
		ЗаполнитьРеквизитыДокументаПриЗагрузке(НазваниеДокумента, ДокОбъект, Строка);
		
		Если Строка.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Если БылПроведен Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Иначе
				ДокОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		
		Если Строка.ПометкаУдаления = Истина Тогда
			ДокОбъект.УстановитьПометкуУдаления(Истина);
		Иначе
			ДокОбъект.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыДокументаПриЗагрузке(НазваниеДокумента, ДокОбъект, Строка)
	
	Если НазваниеДокумента = "Renault_БлокАвтомобиляИзДругойТочки" Тогда
		ЗаполнитьЗначенияСвойств(ДокОбъект, Строка);
		ДокОбъект.Автомобили.Очистить();
		Для Каждого СтрокаСостав Из Строка.Автомобили Цикл
			СтрокаАвтомобиля = ДокОбъект.Автомобили.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаАвтомобиля, СтрокаСостав);
			СтрокаАвтомобиля.Автомобиль = Справочники.Автомобили.НайтиПоРеквизиту("VIN", СтрокаСостав.VIN);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПрокси()
	
	Адрес = "http://gate.rnlt.ru/renault-ws-gate/ws/DealerExchange.1cws?wsdl";
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	ОпределениеСервиса = Новый WSОпределения(Адрес, ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(
		ОпределениеСервиса, 
		"http://renault.ru/WSGate/DealerExchange", 
		"Renault_DealerExchange",
		"Renault_DealerExchangeSoap",
		3600);
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Возврат ВебСервис;
	                         
КонецФункции


