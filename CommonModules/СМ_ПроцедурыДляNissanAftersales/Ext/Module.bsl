КонецПроцедуры

Процедура ВыгрузкаДанныхДилерскогоЦентра(СтрокаАутентификации, Подразделение, ТекущаяДата)
	// устанавливаем соединение с сервером
	Таймаут = 120;
	SSL =  Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());
	Попытка
	    НТТР = Новый HTTPСоединение("customer360.ru", , , , , Таймаут, SSL); // Рабочий сервер
	    //НТТР = Новый HTTPСоединение("int2.nissan-aftersales.ru", , , , , Таймаут, SSL); // Тестовый сервер
	Исключение
		#Если Клиент Тогда
		Сообщить("Не удалось установить соединение с сервером:" 
		    	+ Символы.ПС + ИнформацияОбОшибке().Описание, СтатусСообщения.Важное);
		#КонецЕсли
	    Возврат;
	КонецПопытки;
	
	Если стрНайти(СтрокаАутентификации, "21409201") > 0 Тогда
		МаркаАвтомобилей = Справочники.Марка.DATSUN; // Датсун
		ГруппаПроизводителей = Справочники.Производители.Datsun;
		
	ИначеЕсли стрНайти(СтрокаАутентификации, "R3461") > 0 Тогда
		МаркаАвтомобилей = Справочники.Марка.RENAULT; // Рено
		ГруппаПроизводителей = Справочники.Производители.Renault;
		
	ИначеЕсли стрНайти(СтрокаАутентификации, "R3471") > 0 Тогда
		МаркаАвтомобилей = Справочники.Марка.RENAULT; // Рено
		ГруппаПроизводителей = Справочники.Производители.Renault;
		
	Иначе
		МаркаАвтомобилей = Справочники.Марка.NISSAN; // Ниссан
		ГруппаПроизводителей = Справочники.Производители.Nissan;
	КонецЕсли;
	
	// Заголовки запросов	
	ЗаголовкиHTTP = Новый Соответствие;
	ЗаголовкиHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовкиHTTP.Вставить("Accept", "application/json");
	ЗаголовкиHTTP.Вставить("Connection", "Keep-Alive");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла();   
    Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
    Запись.Записать(СтрокаАутентификации);
    Запись.Закрыть();    
    ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
    УдалитьФайлы(ВременныйФайл);	
	ЗаголовкиHTTP.Вставить("Authorization", "Basic " + Base64Строка(ДвДанные));	
	
	ЗапросHTTP = Новый HTTPЗапрос();
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
	
	// получение маркера доступа
	ЗапросHTTP.АдресРесурса = "/api/identity/connect/token";
	ЗапросHTTP.УстановитьТелоИзСтроки("grant_type=client_credentials&scope=int_aftersalesreports", "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	Если НТТРОтвет.КодСостояния < 300 Тогда
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Попытка
			стОтвет = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			#Если Клиент Тогда
			Сообщить("JSON-парсинг ответа на запрос токена:" + Символы.ПС 
			+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
			+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
			#КонецЕсли
			Возврат;
		КонецПопытки;
		МаркерДоступа = стОтвет.access_token;
		ТипМаркераДоступа = стОтвет.token_type;
	Иначе
		#Если Клиент Тогда	
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		Сообщить("Ошибка запроса токена:" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	// заголовки с маркером доступа	
	ЗаголовкиHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Authorization", ТипМаркераДоступа + " " + МаркерДоступа);
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
		
	// Выгрузить отчет по машинозаездам
	ЗапросHTTP.АдресРесурса = "/api/v1/aftersalesreports/carvisitvins";
	//Если МаркаАвтомобилей = Справочники.Марка.RENAULT Тогда
		//	ТелоЗапроса = ОтчетПоМашинозаездамРено(ТекущаяДата, Подразделение, МаркаАвтомобилей);
		//Иначе
		//	ТелоЗапроса = ОтчетПоМашинозаездамНиссан(ТекущаяДата, Подразделение, МаркаАвтомобилей);
	//КонецЕсли;
	ТелоЗапроса = ОтчетПоМашинозаездамРено(ТекущаяДата, Подразделение, МаркаАвтомобилей);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
	#Если Клиент Тогда	
	Если НТТРОтвет.КодСостояния > 299 Тогда
		Сообщить("Выгрузка отчёта по машинозаездам от " + Формат(ТекущаяДата, "ДЛФ=Д") + ":" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
	КонецЕсли;		
	#КонецЕсли
	
	// Выгрузить отчет по продажам
	ЗапросHTTP.АдресРесурса = "/api/v1/aftersalesreports/partswholesale";
	ТелоЗапроса = ОтчетПоПродажам(ТекущаяДата, Подразделение, ГруппаПроизводителей);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
	#Если Клиент Тогда	
	Если НТТРОтвет.КодСостояния > 299 Тогда
		Сообщить("Выгрузка отчёта по продажам от " + Формат(ТекущаяДата, "ДЛФ=Д") + ":" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
	КонецЕсли;		
	#КонецЕсли
		
	// Выгрузить отчет по складским остаткам
	ЗапросHTTP.АдресРесурса = "/api/v1/aftersalesreports/partsstock";
	ТелоЗапроса = ОтчетПоСкладскимОстаткам(ТекущаяДата, Подразделение, ГруппаПроизводителей);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
	#Если Клиент Тогда	
	Если НТТРОтвет.КодСостояния > 299 Тогда
		Сообщить("Выгрузка отчёта по складским остаткам от " + Формат(ТекущаяДата, "ДЛФ=Д") + ":" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
	КонецЕсли;		
	#КонецЕсли
КонецПроцедуры

Функция ОтчетПоМашинозаездамНиссан(ТекущаяДата, Подразделение, МаркаАвтомобилей)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ТекущаяДата));
	Запрос.УстановитьПараметр("ДатаОкончания", ТекущаяДата);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("МаркаАвтомобилей", МаркаАвтомобилей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеДляОтчетаНиссан.VIN,
	               |	ДанныеДляОтчетаНиссан.ЗаказНарядНомер,
	               |	ДанныеДляОтчетаНиссан.ЗаказНарядДата,
	               |	ДанныеДляОтчетаНиссан.ЗаказНарядТип,
	               |	ДанныеДляОтчетаНиссан.АвтомобильПробег,
	               |	ДанныеДляОтчетаНиссан.ЗаказНарядСуммаРабот,
	               |	ДанныеДляОтчетаНиссан.ЗаказНарядСуммаДеталей,
	               |	ДанныеДляОтчетаНиссан.Плательщик,
	               |	ДанныеДляОтчетаНиссан.ТипПродукта
	               |ИЗ
	               |	РегистрСведений.ДанныеДляОтчетаНиссан КАК ДанныеДляОтчетаНиссан
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Автомобили КАК Автомобили
	               |		ПО ДанныеДляОтчетаНиссан.VIN = Автомобили.VIN
	               |ГДЕ
	               |	ДанныеДляОтчетаНиссан.ЗаказНарядДата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ДанныеДляОтчетаНиссан.Подразделение В ИЕРАРХИИ(&Подразделение)
	               |	И Автомобили.Модель.Марка = &МаркаАвтомобилей";
		
	мЗаказНаряды = Новый Массив();
	ТаблицаНевыгруженных = Запрос.Выполнить().Выгрузить();	
	Для Каждого СтрокаТаблицы Из ТаблицаНевыгруженных Цикл
		стЗаказНаряд = Новый Структура();
		стЗаказНаряд.Вставить("vin", СтрокаТаблицы.VIN);
		
		ДатаЗаказНаряда = Формат(Год(СтрокаТаблицы.ЗаказНарядДата), "ЧЦ=4;ЧГ=0;ЧВН=") + "-" + Формат(Месяц(СтрокаТаблицы.ЗаказНарядДата), "ЧЦ=2;ЧВН=") + "-" + Формат(День(СтрокаТаблицы.ЗаказНарядДата), "ЧЦ=2;ЧВН=") + "T00:00:00";
		стЗаказНаряд.Вставить("date", ДатаЗаказНаряда);
		
		стЗаказНаряд.Вставить("order_number", СтрокаТаблицы.ЗаказНарядНомер);		
		стЗаказНаряд.Вставить("order_Type", СтрокаТаблицы.ЗаказНарядТип);		
		стЗаказНаряд.Вставить("mileage", СтрокаТаблицы.АвтомобильПробег);
		стЗаказНаряд.Вставить("work_total", СтрокаТаблицы.ЗаказНарядСуммаРабот);
		стЗаказНаряд.Вставить("parts_total", СтрокаТаблицы.ЗаказНарядСуммаДеталей);
		стЗаказНаряд.Вставить("product_type", СтрокаТаблицы.ТипПродукта);
		стЗаказНаряд.Вставить("payer", СтрокаТаблицы.Плательщик);
		мЗаказНаряды.Добавить(стЗаказНаряд);
	КонецЦикла;
	
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("year", Год(ТекущаяДата));
	стТелоЗапроса.Вставить("month", Месяц(ТекущаяДата));
	стТелоЗапроса.Вставить("items", мЗаказНаряды);

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные для выгрузки отчёта по машинозаездам!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ОтчетПоПродажам(ТекущаяДата, Подразделение, ГруппаПроизводителей)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ТекущаяДата));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.Регистратор КАК ДокументПродажи,
	               |	Продажи.Период КАК ДатаПродажи,
	               |	Продажи.Регистратор.Номер КАК ДокументНомер,
	               |	Продажи.Номенклатура.АртикулАЦ КАК Артикул,
	               |	Продажи.Покупатель,
	               |	СУММА(Продажи.Количество) КАК Количество,
	               |	СРЕДНЕЕ(Продажи.Сумма / Продажи.Количество) КАК СтоимостьЕдиницы
	               |ИЗ
	               |	РегистрНакопления.Продажи КАК Продажи
	               |ГДЕ
	               |	Продажи.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И Продажи.ХозОперация В (ЗНАЧЕНИЕ(Справочник.ХозОперации.ЗаказНаряд), ЗНАЧЕНИЕ(Справочник.ХозОперации.КомплектацияАвтомобиля), ЗНАЧЕНИЕ(Справочник.ХозОперации.РеализацияТоваров))
	               |	И Продажи.ПодразделениеКомпании В ИЕРАРХИИ(&Подразделение)
	               |	И НЕ Продажи.Покупатель.НашаФирма
	               |	И Продажи.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Продажи.Регистратор.Номер,
	               |	Продажи.Номенклатура.АртикулАЦ,
	               |	Продажи.Покупатель,
	               |	Продажи.Регистратор,
	               |	Продажи.Период";
	
	мПродажи = Новый Массив();
	ТаблицаНевыгруженных = Запрос.Выполнить().Выгрузить();	
	Для Каждого СтрокаТаблицы Из ТаблицаНевыгруженных Цикл
		Если Не ПравильныйАртикул(СтрокаТаблицы.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		
		стПродажа = Новый Структура();
		стПродажа.Вставить("dn", СтрокаТаблицы.ДокументНомер);
		
		ДатаРеализации = Формат(Год(СтрокаТаблицы.ДатаПродажи), "ЧЦ=4;ЧГ=0;ЧВН=") + "-" + Формат(Месяц(СтрокаТаблицы.ДатаПродажи), "ЧЦ=2;ЧВН=") + "-" + Формат(День(СтрокаТаблицы.ДатаПродажи), "ЧЦ=2;ЧВН=") + "T00:00:00";
		стПродажа.Вставить("realization", ДатаРеализации);
		
		стПродажа.Вставить("pn", СтрокаТаблицы.Артикул);		
		
		Если ТипЗнч(СтрокаТаблицы.ДокументПродажи) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			ВидРемонта = СтрокаТаблицы.ДокументПродажи.ВидРемонта;
			ЭтоКузовнойРемонт = (ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт Или ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий);
			Если ЭтоКузовнойРемонт Тогда
				КаналРеализации = "кузовной цех";
			Иначе
				КаналРеализации = "слесарный цех";
			КонецЕсли;
		ИначеЕсли ТипЗнч(СтрокаТаблицы.ДокументПродажи) = Тип("ДокументСсылка.КомплектацияАвтомобиля") Тогда
			КаналРеализации = "доп";
		//Бондаренко++ 20201105	
		//Иначе
		//	Если СтрокаТаблицы.Покупатель.ОптовыйПокупатель Тогда
		//		КаналРеализации = "опт";
		//	Иначе
		//		КаналРеализации = "розница";
		//	КонецЕсли;
		//Бондаренко++ 20201105		
		ИначеЕсли ТипЗнч(СтрокаТаблицы.ДокументПродажи) = Тип("ДокументСсылка.РеализацияТоваров") Тогда
			Если СтрокаТаблицы.ДокументПродажи.ОптоваяПродажа Тогда
				КаналРеализации = "опт";
			Иначе
				КаналРеализации = "розница";
			КонецЕсли;	
		Иначе
			КаналРеализации = "розница";
	    //Бондаренко-- 20201105	
 		КонецЕсли;
		стПродажа.Вставить("chn", КаналРеализации);
		
		стПродажа.Вставить("cnt", СтрокаТаблицы.Количество);
		стПродажа.Вставить("prc", СтрокаТаблицы.СтоимостьЕдиницы);
		мПродажи.Добавить(стПродажа);
	КонецЦикла;
	
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("year", Год(ТекущаяДата));
	стТелоЗапроса.Вставить("month", Месяц(ТекущаяДата));
	стТелоЗапроса.Вставить("items", мПродажи);

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные для выгрузки отчёта по продажам!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ОтчетПоСкладскимОстаткам(ТекущаяДата, Подразделение, ГруппаПроизводителей)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаВыборки", КонецДня(ТекущаяДата));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПартииТоваровКомпанииОстатки.Номенклатура.АртикулАЦ КАК Артикул,
	               |	ПартииТоваровКомпанииОстатки.Партия.Дата КАК ДатаПоступления,
	               |	ПартииТоваровКомпанииОстатки.КоличествоОстаток КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровКомпании.Остатки(
	               |			&ДатаВыборки,
	               |			Номенклатура.Производитель В ИЕРАРХИИ (&ГруппаПроизводителей)
	               |				И Партия.ПодразделениеКомпании В ИЕРАРХИИ (&Подразделение)) КАК ПартииТоваровКомпанииОстатки
	               |ГДЕ
	               |	ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0";
		
	мОстатки = Новый Массив();
	ТаблицаНевыгруженных = Запрос.Выполнить().Выгрузить();	
	Для Каждого СтрокаТаблицы Из ТаблицаНевыгруженных Цикл
		Если Не ПравильныйАртикул(СтрокаТаблицы.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		
		стОстаток = Новый Структура();
		стОстаток.Вставить("pn", СтрокаТаблицы.Артикул);		
		стОстаток.Вставить("qty", СтрокаТаблицы.Количество);
		
		ДатаПоступления = Формат(Год(СтрокаТаблицы.ДатаПоступления), "ЧЦ=4;ЧГ=0;ЧВН=") + "-" + Формат(Месяц(СтрокаТаблицы.ДатаПоступления), "ЧЦ=2;ЧВН=") + "-" + Формат(День(СтрокаТаблицы.ДатаПоступления), "ЧЦ=2;ЧВН=") + "T00:00:00";
		стОстаток.Вставить("arrived", ДатаПоступления);
		
		мОстатки.Добавить(стОстаток);
	КонецЦикла;
	
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("year", Год(ТекущаяДата));
	стТелоЗапроса.Вставить("month", Месяц(ТекущаяДата));
	стТелоЗапроса.Вставить("items", мОстатки);

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные для выгрузки отчёта по остаткам!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ПравильныйАртикул(Артикул)
	Длина = СтрДлина(Артикул);
	Если Длина < 7 Или Длина > 16 Тогда
		Возврат Ложь;
	КонецЕсли;
	// усеченный вариант "0123456789ABCDEFGHJKLMNPRSTUVWXYZ"
	Для сч = 1 По Длина Цикл
		Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сред(Артикул, сч, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
		
	Возврат Истина;
КонецФункции

Функция ОтчетПоМашинозаездамРено(ТекущаяДата, Подразделение, МаркаАвтомобилей)
	мСостояния = Новый Массив();
	мСостояния.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Выполнен);
	мСостояния.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	
	ЗапросЗН = Новый Запрос();
	ЗапросЗН.УстановитьПараметр("ВыполненИлиЗакрыт", мСостояния);
	ЗапросЗН.УстановитьПараметр("Подразделение", Подразделение);
	ЗапросЗН.УстановитьПараметр("МаркаАвтомобилей", МаркаАвтомобилей);
	ЗапросЗН.УстановитьПараметр("ДатаНачала", НачалоМесяца(ТекущаяДата));
	ЗапросЗН.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата));
	ЗапросЗН.Текст = "ВЫБРАТЬ
	                 |	ЗаказНаряд.Дата КАК ЗаказНарядДата,
	                 |	ЗаказНаряд.Номер КАК Номер,
	                 |	ЗаказНаряд.Автомобиль.VIN КАК VIN,
	                 |	ЗаказНаряд.Пробег КАК Пробег,
	                 |	ЗаказНаряд.СуммаРаботДокумента КАК СуммаРабот,
	                 |	ЗаказНаряд.СуммаНоменклатурыДокумента КАК СуммаЗапчастей,
	                 |	ЗаказНаряд.ВидРемонта.Наименование КАК НаименованиеВидаРемонта,
	                 |	ЗаказНаряд.Контрагент.ФормаСобственности КАК КонтрагентФС,
	                 |	ЗаказНаряд.Цех КАК Цех,
	                 |	ЗаказНаряд.Состояние КАК Состояние,
	                 |	ЗаказНаряд.ВидРемонта КАК ВидРемонта
	                 |ИЗ
	                 |	Документ.ЗаказНаряд КАК ЗаказНаряд
	                 |ГДЕ
	                 |	ЗаказНаряд.Состояние В(&ВыполненИлиЗакрыт)
	                 |	И ЗаказНаряд.ПодразделениеКомпании В ИЕРАРХИИ(&Подразделение)
	                 |	И ЗаказНаряд.Автомобиль.Модель.Марка = &МаркаАвтомобилей
	                 |	И ЗаказНаряд.ДатаЗакрытия МЕЖДУ &ДатаНачала И &ДатаОкончания";
		
	мЗаказНаряды = Новый Массив();
	ТаблицаНевыгруженных = ЗапросЗН.Выполнить().Выгрузить();	
	Для Каждого СтрокаТаблицы Из ТаблицаНевыгруженных Цикл
		Если СтрокаТаблицы.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен 
			И Не СтрокаТаблицы.ВидРемонта.ГарантияЗавода Тогда
			Продолжить;
		КонецЕсли;
		
		стЗаказНаряд = Новый Структура();
		стЗаказНаряд.Вставить("vin", СтрокаТаблицы.VIN);	
		ДатаЗаказНаряда = Формат(Год(СтрокаТаблицы.ЗаказНарядДата), "ЧЦ=4;ЧГ=0;ЧВН=") + "-" + Формат(Месяц(СтрокаТаблицы.ЗаказНарядДата), "ЧЦ=2;ЧВН=") + "-" + Формат(День(СтрокаТаблицы.ЗаказНарядДата), "ЧЦ=2;ЧВН=") + "T00:00:00";
		стЗаказНаряд.Вставить("date", ДатаЗаказНаряда);
		
		Если СтрокаТаблицы.ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт Тогда
			стЗаказНаряд.Вставить("order_Type", "КР");
			стЗаказНаряд.Вставить("product_type", "КЛИЕНТ");
			стЗаказНаряд.Вставить("payer", "КЛИЕНТ");
			
		ИначеЕсли СтрокаТаблицы.ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий Тогда
			стЗаказНаряд.Вставить("order_Type", "КР");
			стЗаказНаряд.Вставить("product_type", "КЛИЕНТ");
			стЗаказНаряд.Вставить("payer", "КЛИЕНТ");
			
		ИначеЕсли Найти(СтрокаТаблицы.НаименованиеВидаРемонта, "Техническое") > 0 Тогда
			стЗаказНаряд.Вставить("order_Type", "ТО");
			
		ИначеЕсли СтрокаТаблицы.ВидРемонта.ГарантияЗавода Тогда
			стЗаказНаряд.Вставить("order_Type", "Гарантия");
			
		ИначеЕсли СтрокаТаблицы.ВидРемонта = Справочники.ВидыРемонта.СезоннаяКомпания Тогда
			стЗаказНаряд.Вставить("order_Type", "Сезонная кампания");
			
		ИначеЕсли СтрокаТаблицы.ВидРемонта = Справочники.ВидыРемонта.МасляныйСервис Тогда
			стЗаказНаряд.Вставить("order_Type", "Масляный сервис");
			
		ИначеЕсли Найти(СтрокаТаблицы.НаименованиеВидаРемонта, "Дополнительное") > 0 Тогда
			Если СтрокаТаблицы.КонтрагентФС = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
				стЗаказНаряд.Вставить("order_Type", "ДОП ритэйл");
			Иначе
				стЗаказНаряд.Вставить("order_Type", "ДОП флит");
			КонецЕсли;
			
		ИначеЕсли СтрокаТаблицы.ВидРемонта.ТипРемонта = Перечисления.ТипыРемонта.Бесплатный Тогда
			стЗаказНаряд.Вставить("order_Type", "ВН/Д");
			
		Иначе
			стЗаказНаряд.Вставить("order_Type", "МР/АСС");
		КонецЕсли;
		
		стЗаказНаряд.Вставить("order_number", СокрЛП(СтрокаТаблицы.Номер));			
		стЗаказНаряд.Вставить("mileage", СтрокаТаблицы.Пробег);
		стЗаказНаряд.Вставить("work_total", СтрокаТаблицы.СуммаРабот);
		стЗаказНаряд.Вставить("parts_total", СтрокаТаблицы.СуммаЗапчастей);
		
		мЗаказНаряды.Добавить(стЗаказНаряд);
	КонецЦикла;
	
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("year", Год(ТекущаяДата));
	стТелоЗапроса.Вставить("month", Месяц(ТекущаяДата));
	стТелоЗапроса.Вставить("items", мЗаказНаряды);

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные для выгрузки отчёта по машинозаездам!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

