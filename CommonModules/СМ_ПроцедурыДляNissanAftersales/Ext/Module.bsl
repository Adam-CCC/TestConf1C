		//СтрокаАутентификации = "21409201\dealer_crm:demo_123"; // Аутентификация Датсун Шахты для тестового сервера
		СтрокаАутентификации = "21409201\integr_sh:Olimp62"; // Аутентификация Датсун Шахты
