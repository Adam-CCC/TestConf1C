Функция ОбновитьСтатусЛида(КодДилера, ЛидИД, НовыйСтатус, Параметры) Экспорт
	стОшибка = Новый Структура("error, is_success");
	Если Не СМ_УправлениеДоступом.ЭтоРабочаяБаза() Тогда
		стОшибка.error = "Обновление статуса лида возможно только из рабочей базы!";
		стОшибка.is_success = Ложь;
		Возврат стОшибка;
	КонецЕсли;
	
	// устанавливаем соединение с сервером
	Таймаут = 120;
	SSL =  Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());

    НТТР = Новый HTTPСоединение("customer360.ru", , , , , Таймаут, SSL); // Рабочий сервер
    //НТТР = Новый HTTPСоединение("int2.nissan-aftersales.ru", , , , , Таймаут, SSL); // Тестовый сервер
	
	// Заголовки запросов	
	ЗаголовкиHTTP = Новый Соответствие;
	ЗаголовкиHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовкиHTTP.Вставить("Accept", "application/json");
	ЗаголовкиHTTP.Вставить("Connection", "Keep-Alive");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла();   
    Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	стрАутентификации = СтрокаАутентификации(КодДилера);
    Запись.Записать(стрАутентификации);
    Запись.Закрыть();    
    ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
    УдалитьФайлы(ВременныйФайл);	
	ЗаголовкиHTTP.Вставить("Authorization", "Basic " + Base64Строка(ДвДанные));	
	
	ЗапросHTTP = Новый HTTPЗапрос();
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
	
	// получение маркера доступа
	ЗапросHTTP.АдресРесурса = "/api/identity/connect/token";
	ЗапросHTTP.УстановитьТелоИзСтроки("grant_type=client_credentials&scope=int_leadcrm", "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	Если НТТРОтвет.КодСостояния < 300 Тогда
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Попытка
			стОтвет = ПрочитатьJSON(ЧтениеJSON);
			МаркерДоступа = стОтвет.access_token;
			ТипМаркераДоступа = стОтвет.token_type;
		Исключение
			стОшибка.error = "Обновить статус лида: ошибка JSON-парсинга тела ответа на запрос токена!";
			стОшибка.is_success = Ложь;
			#Если Клиент Тогда
			Сообщить(стОшибка.error, СтатусСообщения.Важное);
			#КонецЕсли
			Возврат стОшибка;
		КонецПопытки;
		
	Иначе
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		СообщениеОшибка = "Обновить статус лида: ошибка запроса токена:" + Символы.ПС
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета;
		стОшибка.error = СообщениеОшибка;
		стОшибка.is_success = Ложь;
		#Если Клиент Тогда	
		Сообщить(СообщениеОшибка, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат стОшибка;
	КонецЕсли;
	
	// заголовки с маркером доступа	
	ЗаголовкиHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Authorization", ТипМаркераДоступа + " " + МаркерДоступа);
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
		
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("status", НовыйСтатус);
	стТелоЗапроса.Вставить("lead_id", ЛидИД);
	
	Если Параметры.Свойство("dealer_visit_planned_date") Тогда
		стТелоЗапроса.Вставить("dealer_visit_planned_date", Параметры.dealer_visit_planned_date);
	КонецЕсли;
	Если Параметры.Свойство("dealer_recall_date") Тогда
		стТелоЗапроса.Вставить("dealer_recall_date", Параметры.dealer_recall_date);
	КонецЕсли;
	Если Параметры.Свойство("status_comment") Тогда
		стТелоЗапроса.Вставить("status_comment", Параметры.status_comment);
	КонецЕсли;
	
	Если НовыйСтатус = "refuse" Тогда // Отказ
		Если Параметры.Свойство("dealer_refuse_reason_id") И ЗначениеЗаполнено(Параметры.dealer_refuse_reason_id) Тогда
			стТелоЗапроса.Вставить("dealer_refuse_reason_id", Параметры.dealer_refuse_reason_id);
		Иначе
			стТелоЗапроса.Вставить("dealer_refuse_reason_id", 4); //Прочее
		КонецЕсли;
		Если Параметры.Свойство("refuse_reason_comment") Тогда
			стТелоЗапроса.Вставить("refuse_reason_comment", Параметры.refuse_reason_comment);
		Иначе
			стТелоЗапроса.Вставить("refuse_reason_comment", "");
		КонецЕсли;	
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
		стОшибка.error = "Обновить статус лида: не удалось записать JSON-данные для запроса!";
		стОшибка.is_success = Ложь;
		#Если Клиент Тогда	
		Сообщить(стОшибка.error, СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат стОшибка;
	КонецПопытки;

	// Запрос обновления статуса лида
	ЗапросHTTP.АдресРесурса = "/api/v1/crm/status";
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
	Если НТТРОтвет.КодСостояния < 300 Тогда
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
