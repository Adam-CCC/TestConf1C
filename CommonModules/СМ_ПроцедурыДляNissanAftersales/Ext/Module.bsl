Процедура ВыгрузкаДляNissanAftersales(Параметры = Неопределено) Экспорт
	ТекущаяДата = НачалоДня(ТекущаяДата());
	//ТекущаяДата = Дата(2018, 5, 3); // дата для тестирования
	
	ПодразделениеШахты = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001160");	
	////СтрокаАутентификации = "21112401\dealer_int:demo_123"; // Аутентификация Ниссан Шахты для тестового сервера
	СтрокаАутентификации = "21112401\integr_sh:12401sh"; // Аутентификация Ниссан Шахты
	ВыгрузкаДанныхДилерскогоЦентра(СтрокаАутентификации, ПодразделениеШахты, ТекущаяДата);
	
	СтрокаАутентификации = "21409201\integr_sh:Olimp62"; // Аутентификация Датсун Шахты
	ВыгрузкаДанныхДилерскогоЦентра(СтрокаАутентификации, ПодразделениеШахты, ТекущаяДата);
	
	ПодразделениеВолгодонск = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000190");
	//СтрокаАутентификации = "21115701\dealer_int:demo_123"; // Аутентификация Ниссан Волгодонск для тестового сервера
	СтрокаАутентификации = "21115701\integr_vd:15701vd"; // Аутентификация Ниссан Волгодонск
	ВыгрузкаДанныхДилерскогоЦентра(СтрокаАутентификации, ПодразделениеВолгодонск, ТекущаяДата);
КонецПроцедуры

Процедура ВыгрузкаДляRenaultAftersales(Параметры = Неопределено) Экспорт
	ТекущаяДата = НачалоДня(ТекущаяДата());
	//ТекущаяДата = Дата(2018, 5, 3); // дата для тестирования
		
	ПодразделениеШахтыРено = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000149");
