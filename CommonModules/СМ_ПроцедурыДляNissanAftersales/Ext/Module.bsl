Процедура ОбновитьСтатусЛидаПоСобытию(ДокументСсылка) Экспорт
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Событие") Тогда
		ДокументОснование = ДокументСсылка.ДокументОснование;
		Если ЗначениеЗаполнено(ДокументОснование) И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РабочийЛист") Тогда
			РабочийЛистСсылка = ДокументОснование;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;

	нзКонтакты = РегистрыСведений.КонтактыCustomer360.СоздатьНаборЗаписей();
	нзКонтакты.Отбор.СсылкаНаОбъект.Значение = РабочийЛистСсылка;
	нзКонтакты.Отбор.СсылкаНаОбъект.Использование = Истина;
	нзКонтакты.Прочитать();	
	Если нзКонтакты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	мзКонтакт = РегистрыСведений.КонтактыCustomer360.СоздатьМенеджерЗаписи();
	мзКонтакт.СсылкаНаОбъект = РабочийЛистСсылка;
	мзКонтакт.ЛидИД = нзКонтакты[0].ЛидИД;
	мзКонтакт.Прочитать();
	Если Не мзКонтакт.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	Если мзКонтакт.ЛидЗакрыт Тогда
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Структура();
	НовыйСтатус = "";
	
	ВидСобытия = ДокументСсылка.ВидСобытия;
	Если ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок И ДокументСсылка.ТипСообщения = Перечисления.ТипыСообщений.Исходящее
		И ДокументСсылка.Состояние = Перечисления.СостоянияСобытий.Запланировано Тогда
		НовыйСтатус = "call_back"; // Перезвонить
		Параметры.Вставить("dealer_recall_date", ЗаписатьДатуJSON(ДокументСсылка.ДатаНачала, ФорматДатыJSON.ISO));
		Содержание = ДокументСсылка.Содержание;
		Если ЗначениеЗаполнено(Содержание) Тогда
			Параметры.Вставить("status_comment", Содержание);
		КонецЕсли;
		
	ИначеЕсли ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча Тогда
		Если ДокументСсылка.Состояние = Перечисления.СостоянияСобытий.Запланировано Тогда
			НовыйСтатус = "visit_planned"; // Назначена дата визита
			Параметры.Вставить("dealer_visit_planned_date", ЗаписатьДатуJSON(ДокументСсылка.ДатаНачала, ФорматДатыJSON.ISO));
			Содержание = ДокументСсылка.Содержание;
			Если ЗначениеЗаполнено(Содержание) Тогда
				Параметры.Вставить("status_comment", Содержание);
			КонецЕсли;
			
		ИначеЕсли ДокументСсылка.Состояние = Перечисления.СостоянияСобытий.Завершено Тогда
			НовыйСтатус = "visit_completed"; // Встреча состоялась
			Результат = ДокументСсылка.Результат;
			Если ЗначениеЗаполнено(Результат) Тогда
				Параметры.Вставить("status_comment", Результат);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовыйСтатус) Тогда
		стРезультат = ОбновитьСтатусЛида(мзКонтакт.КодДилера, мзКонтакт.ЛидИД, НовыйСтатус, Параметры);	
		Если стРезультат.is_success Тогда
			мзКонтакт.ДатаИзменения = ТекущаяДата();
			мзКонтакт.Записать();
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

