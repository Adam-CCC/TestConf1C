		Исключение
			стОшибка.error = "Обновить статус лида: не удалось извлечь JSON-данные из тела ответа сервера!";
			стОшибка.is_success = Ложь;
			#Если Клиент Тогда	
			Сообщить(стОшибка.error, СтатусСообщения.Внимание);
			#КонецЕсли
			Возврат стОшибка;
		КонецПопытки;	
		
	Иначе
		СообщениеОшибка = "Обновить статус лида " + ЛидИД + ":" + Символы.ПС
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета;
		стОшибка.error = СообщениеОшибка;
		стОшибка.is_success = Ложь;
		#Если Клиент Тогда	
		Сообщить(СообщениеОшибка, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат стОшибка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеЛида(ЛидИД, СтрокаАутентификации) Экспорт
	// устанавливаем соединение с сервером
	Таймаут = 120;
	SSL =  Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());

    НТТР = Новый HTTPСоединение("customer360.ru", , , , , Таймаут, SSL); // Рабочий сервер
    //НТТР = Новый HTTPСоединение("int2.nissan-aftersales.ru", , , , , Таймаут, SSL); // Тестовый сервер
	
	// Заголовки запросов	
	ЗаголовкиHTTP = Новый Соответствие;
	ЗаголовкиHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовкиHTTP.Вставить("Accept", "application/json");
	ЗаголовкиHTTP.Вставить("Connection", "Keep-Alive");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла();   
    Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
    Запись.Записать(СтрокаАутентификации);
    Запись.Закрыть();    
    ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
    УдалитьФайлы(ВременныйФайл);	
	ЗаголовкиHTTP.Вставить("Authorization", "Basic " + Base64Строка(ДвДанные));	
	
	ЗапросHTTP = Новый HTTPЗапрос();
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
	
	// получение маркера доступа
	ЗапросHTTP.АдресРесурса = "/api/identity/connect/token";
	ЗапросHTTP.УстановитьТелоИзСтроки("grant_type=client_credentials&scope=int_leadcrm", "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	Если НТТРОтвет.КодСостояния < 300 Тогда
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Попытка
			стОтвет = ПрочитатьJSON(ЧтениеJSON);
			МаркерДоступа = стОтвет.access_token;
			ТипМаркераДоступа = стОтвет.token_type;
		Исключение
			стОшибка = Новый Структура("error", "Получить данные лида: ошибка JSON-парсинга тела ответа на запрос токена!");
			#Если Клиент Тогда
			Сообщить(стОшибка.error, СтатусСообщения.Важное);
			#КонецЕсли
			Возврат стОшибка;
		КонецПопытки;
		
	Иначе
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		СообщениеОшибка = "Получить данные лида: ошибка запроса токена:" + Символы.ПС
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета;
		стОшибка = Новый Структура("error", СообщениеОшибка);
		#Если Клиент Тогда	
		Сообщить(СообщениеОшибка, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат стОшибка;
	КонецЕсли;
	
	// заголовки с маркером доступа	
	ЗаголовкиHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Authorization", ТипМаркераДоступа + " " + МаркерДоступа);
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
		
	стТелоЗапроса = Новый Структура("lead_id", ЛидИД);
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
		стОшибка = Новый Структура("error", "Получить данные лида: не удалось записать JSON-данные для запроса!");
		#Если Клиент Тогда	
		Сообщить(стОшибка.error, СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат стОшибка;
	КонецПопытки;

	// Запрос данных лида
	ЗапросHTTP.АдресРесурса = "/api/v1/crm/lead";
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
	Если НТТРОтвет.КодСостояния < 300 Тогда
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Попытка
			стДанныеЛида = ПрочитатьJSON(ЧтениеJSON);
			Возврат стДанныеЛида;
		Исключение
			стОшибка = Новый Структура("error", "Получить данные лида: некорректный JSON в теле ответа сервера!");
			#Если Клиент Тогда	
			Сообщить(стОшибка.error, СтатусСообщения.Внимание);
			#КонецЕсли
			Возврат стОшибка;
		КонецПопытки;
		
	Иначе
		СообщениеОшибка = "Получить данные лида " + ЛидИД + ":" + Символы.ПС
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета;
		стОшибка = Новый Структура("error", СообщениеОшибка);
		#Если Клиент Тогда	
		Сообщить(СообщениеОшибка, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат стОшибка;
	КонецЕсли;
КонецФункции

Процедура ОбновитьСтатусЛидаПоРЛСервиса(РабочийЛистСсылка) Экспорт
	Если ТипЗнч(РабочийЛистСсылка) <> Тип("ДокументСсылка.РабочийЛистСервиса") Тогда
		Возврат;
	КонецЕсли;

	нзКонтакты = РегистрыСведений.КонтактыCustomer360.СоздатьНаборЗаписей();
	нзКонтакты.Отбор.СсылкаНаОбъект.Значение = РабочийЛистСсылка;
	нзКонтакты.Отбор.СсылкаНаОбъект.Использование = Истина;
	нзКонтакты.Прочитать();	
	Если нзКонтакты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	мзКонтакт = РегистрыСведений.КонтактыCustomer360.СоздатьМенеджерЗаписи();
	мзКонтакт.СсылкаНаОбъект = РабочийЛистСсылка;
	мзКонтакт.ЛидИД = нзКонтакты[0].ЛидИД;
	мзКонтакт.Прочитать();
	Если Не мзКонтакт.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	Если мзКонтакт.ЛидЗакрыт Тогда
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Структура();
	ТекущийСтатус = РабочийЛистСсылка.Статус;
	Если ТекущийСтатус = Справочники.СтатусыРабочегоЛиста.Отказ Тогда
		НовыйСтатус = "refuse";
		ПричинаОтказа = РабочийЛистСсылка.ПричинаОтказа;
		Если ЗначениеЗаполнено(ПричинаОтказа) Тогда
			Параметры.Вставить("dealer_refuse_reason_id", ПричинаОтказа.КодCustomer360);
			Параметры.Вставить("refuse_reason_comment", Строка(ПричинаОтказа));
		КонецЕсли;
		
	ИначеЕсли ТекущийСтатус = Справочники.СтатусыРабочегоЛиста.Продажа Тогда
		НовыйСтатус = "served";
		
	ИначеЕсли ТекущийСтатус = Справочники.СтатусыРабочегоЛиста.ОшибочныйНомер Тогда
		НовыйСтатус = "bad_phone";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	стРезультат = ОбновитьСтатусЛида(мзКонтакт.КодДилера, мзКонтакт.ЛидИД, НовыйСтатус, Параметры);	
	Если стРезультат.is_success Тогда
		мзКонтакт.ЛидЗакрыт = Истина;
		мзКонтакт.ДатаИзменения = ТекущаяДата();
		мзКонтакт.Записать();
	КонецЕсли;	
КонецПроцедуры

