Процедура ВыгрузитьДанныеAftersales(Подразделение, ТекущаяДата, ВидыДанных) Экспорт
	ПодразделениеШахты = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001160");	
	ПодразделениеВолгодонск = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000190");
	ПодразделениеШахтыРено = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000149");
	ПодразделениеВолгодонскРено = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000191");
	
	Если Подразделение = ПодразделениеШахты Тогда
		СтрокаАутентификации = "21112401\integr_sh:12401sh"; // Аутентификация Ниссан Шахты
		//СтрокаАутентификации = "21409201\integr_sh:Olimp62"; // Аутентификация Датсун Шахты
		
	ИначеЕсли Подразделение = ПодразделениеВолгодонск Тогда
		СтрокаАутентификации = "21115701\integr_vd:15701vd"; // Аутентификация Ниссан Волгодонск
		
	ИначеЕсли Подразделение = ПодразделениеШахтыРено Тогда
		СтрокаАутентификации = "R3461\integr_sh:Olimp3461"; // Аутентификация Рено Шахты
		
	ИначеЕсли Подразделение = ПодразделениеВолгодонскРено Тогда
		СтрокаАутентификации = "R3471\integr_vd:vd3471"; // Аутентификация Рено Волгодонск
		
	Иначе
		Возврат;
	КонецЕсли;
	
	// устанавливаем соединение с сервером
	Таймаут = 120;
	SSL =  Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());
	Попытка
	    НТТР = Новый HTTPСоединение("customer360.ru", , , , , Таймаут, SSL); // Рабочий сервер
	    //НТТР = Новый HTTPСоединение("int2.nissan-aftersales.ru", , , , , Таймаут, SSL); // Тестовый сервер
	Исключение
		#Если Клиент Тогда
		Сообщить("Не удалось установить соединение с сервером:" 
		    	+ Символы.ПС + ИнформацияОбОшибке().Описание, СтатусСообщения.Важное);
		#КонецЕсли
	    Возврат;
	КонецПопытки;
	
	Если стрНайти(СтрокаАутентификации, "21409201") > 0 Тогда
		МаркаАвтомобилей = Справочники.Марка.DATSUN; // Датсун
		ГруппаПроизводителей = Справочники.Производители.Datsun;
		
	ИначеЕсли стрНайти(СтрокаАутентификации, "R3461") > 0 Тогда
		МаркаАвтомобилей = Справочники.Марка.RENAULT; // Рено
		ГруппаПроизводителей = Справочники.Производители.Renault;
		
	ИначеЕсли стрНайти(СтрокаАутентификации, "R3471") > 0 Тогда
		МаркаАвтомобилей = Справочники.Марка.RENAULT; // Рено
		ГруппаПроизводителей = Справочники.Производители.Renault;
		
	Иначе
		МаркаАвтомобилей = Справочники.Марка.NISSAN; // Ниссан
		ГруппаПроизводителей = Справочники.Производители.Nissan;
	КонецЕсли;
	
	// Заголовки запросов	
	ЗаголовкиHTTP = Новый Соответствие;
	ЗаголовкиHTTP.Вставить("Content-Type", "application/x-www-form-urlencoded");
	ЗаголовкиHTTP.Вставить("Accept", "application/json");
	ЗаголовкиHTTP.Вставить("Connection", "Keep-Alive");
	
	ВременныйФайл = ПолучитьИмяВременногоФайла();   
    Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
    Запись.Записать(СтрокаАутентификации);
    Запись.Закрыть();    
    ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
    УдалитьФайлы(ВременныйФайл);	
	ЗаголовкиHTTP.Вставить("Authorization", "Basic " + Base64Строка(ДвДанные));	
	
	ЗапросHTTP = Новый HTTPЗапрос();
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
	
	// получение маркера доступа
	ЗапросHTTP.АдресРесурса = "/api/identity/connect/token";
	ЗапросHTTP.УстановитьТелоИзСтроки("grant_type=client_credentials&scope=int_aftersalesreports", "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
	Если НТТРОтвет.КодСостояния < 300 Тогда
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Попытка
			стОтвет = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			#Если Клиент Тогда
			Сообщить("JSON-парсинг ответа на запрос токена:" + Символы.ПС 
			+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
			+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
			#КонецЕсли
			Возврат;
		КонецПопытки;
		МаркерДоступа = стОтвет.access_token;
		ТипМаркераДоступа = стОтвет.token_type;
	Иначе
		#Если Клиент Тогда	
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		Сообщить("Ошибка запроса токена:" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	// заголовки с маркером доступа	
	ЗаголовкиHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Authorization", ТипМаркераДоступа + " " + МаркерДоступа);
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
	
	Если ВидыДанных.Машинозаезды Тогда
		// Выгрузить отчет по машинозаездам
		ЗапросHTTP.АдресРесурса = "/api/v1/aftersalesreports/carvisitvins";
		//Если МаркаАвтомобилей = Справочники.Марка.RENAULT Тогда
		//	ТелоЗапроса = ОтчетПоМашинозаездамРено(ТекущаяДата, Подразделение, МаркаАвтомобилей);
		//Иначе
		//	ТелоЗапроса = ОтчетПоМашинозаездамНиссан(ТекущаяДата, Подразделение, МаркаАвтомобилей);
		//КонецЕсли;
		ТелоЗапроса = ОтчетПоМашинозаездамРено(ТекущаяДата, Подразделение, МаркаАвтомобилей);
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
		
		НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		#Если Клиент Тогда	
		Если НТТРОтвет.КодСостояния > 299 Тогда
			Сообщить("Выгрузка отчёта по машинозаездам от " + Формат(ТекущаяДата, "ДЛФ=Д") + ":" + Символы.ПС 
			+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
			+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		КонецЕсли;		
		#КонецЕсли
	КонецЕсли;
	
	Если ВидыДанных.Продажи Тогда
		// Выгрузить отчет по продажам
		ЗапросHTTP.АдресРесурса = "/api/v1/aftersalesreports/partswholesale";
		ТелоЗапроса = ОтчетПоПродажам(ТекущаяДата, Подразделение, ГруппаПроизводителей);
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
		
		НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		#Если Клиент Тогда	
		Если НТТРОтвет.КодСостояния > 299 Тогда
			Сообщить("Выгрузка отчёта по продажам от " + Формат(ТекущаяДата, "ДЛФ=Д") + ":" + Символы.ПС 
			+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
			+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		КонецЕсли;		
		#КонецЕсли
	КонецЕсли;
	
	Если ВидыДанных.СкладскиеОстатки Тогда
		// Выгрузить отчет по складским остаткам
		ЗапросHTTP.АдресРесурса = "/api/v1/aftersalesreports/partsstock";
		ТелоЗапроса = ОтчетПоСкладскимОстаткам(ТекущаяДата, Подразделение, ГруппаПроизводителей);
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
		
		НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);	
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		#Если Клиент Тогда	
		Если НТТРОтвет.КодСостояния > 299 Тогда
			Сообщить("Выгрузка отчёта по складским остаткам от " + Формат(ТекущаяДата, "ДЛФ=Д") + ":" + Символы.ПС 
			+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
			+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		КонецЕсли;		
		#КонецЕсли
	КонецЕсли;	
