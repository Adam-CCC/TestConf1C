// Функция - Получить сумму скидки по программам обновления
//
// Параметры:
//  VIN				 - Строка	 - VIN автомобиля
//  Вид				 - 	Строка -  Вид коммерческой акции: "ТрейдИн" / "Утилизация" / "Прочее"
Функция ПолучитьСуммуСкидкиПоПрограммамОбновления(VIN, Вид, Модель, ВариантКомплектации, ГодВыпуска, ТолькоИтоги = Истина, ДатаДоговора = Неопределено)

	Если Не ЗначениеЗаполнено(VIN) И Модель = Неопределено И НЕ Вид = "Утилизация" Тогда
		Если ТолькоИтоги Тогда
			Возврат 0;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(VIN) Тогда
		Автомобиль = НайтиАвтоПоVIN(VIN);
		
		Если Не ЗначениеЗаполнено(Автомобиль) Тогда
			#Если Клиент Тогда
				Сообщить("Не найден автомобиль по VIN");
			#КонецЕсли
			Возврат 0;
		КонецЕсли;
		
		Если ГодВыпуска = Неопределено Тогда 
			ГодВыпуска = ПолучитьГодВыпуска(Автомобиль); 
		КонецЕсли;

	Иначе	
		Автомобиль = Новый Структура;
		Автомобиль.Вставить("Модель", Модель);
		Автомобиль.Вставить("ВариантКомплектации", ВариантКомплектации);
		Если ГодВыпуска = Неопределено Тогда 
			ГодВыпуска = 0; 
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ДатаДоговора = Неопределено Тогда
		Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()));
	Иначе	
		Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаДоговора));
	КонецЕсли;
	Запрос.УстановитьПараметр("Модель", Автомобиль.Модель);
	Запрос.УстановитьПараметр("Версия", Автомобиль.ВариантКомплектации);
	Запрос.УстановитьПараметр("ГодВыпуска", ГодВыпуска);
	Запрос.УстановитьПараметр("Вид", Вид);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	DMS_КоммерческиеАкцииУсловия.Ссылка КАК Ссылка,
	               |	МАКСИМУМ(DMS_КоммерческиеАкцииУсловия.ЗначениеСкидки) КАК ЗначениеСкидки,
	               |	МАКСИМУМ(DMS_КоммерческиеАкцииУсловия.ЗначениеСкидкиУчастиеДилера) КАК ЗначениеСкидкиУчастиеДилера,
	               |	DMS_КоммерческиеАкцииУсловия.ВариантСкидки КАК ВариантСкидки
	               |ИЗ
	               |	Справочник.DMS_КоммерческиеАкции.Условия КАК DMS_КоммерческиеАкцииУсловия
	               |ГДЕ
	               |	DMS_КоммерческиеАкцииУсловия.НачалоДействия <= &Дата
	               |	И (DMS_КоммерческиеАкцииУсловия.ОкончаниеДействия >= &Дата
	               |			ИЛИ DMS_КоммерческиеАкцииУсловия.ОкончаниеДействия = ДАТАВРЕМЯ(1, 1, 1))
	               |	И (DMS_КоммерческиеАкцииУсловия.Объект = &Модель
	               |			ИЛИ DMS_КоммерческиеАкцииУсловия.Объект = &Версия)
	               |	И (&Вид = ""Утилизация""
	               |				И DMS_КоммерческиеАкцииУсловия.Ссылка.ТипАкции = 3
	               |			ИЛИ &Вид = ""ТрейдИн""
	               |				И DMS_КоммерческиеАкцииУсловия.Ссылка.ТипАкции = 2)
	               |	И DMS_КоммерческиеАкцииУсловия.ВариантСкидки = ""Сумма""
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	DMS_КоммерческиеАкцииУсловия.Ссылка,
	               |	DMS_КоммерческиеАкцииУсловия.ВариантСкидки";
	
	//Запрос.Текст = "ВЫБРАТЬ
