	//               |	И Renault_КоммерческиеАкции.Модель = &Модель
	//               |	И Renault_КоммерческиеАкции.Версия = &Версия
	//               |	И Renault_КоммерческиеАкции.Вид = &Вид
	//               |	И Renault_КоммерческиеАкции.ВариантСкидки = ""Сумма""
	//               |
