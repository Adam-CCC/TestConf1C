	//КонецЕсли;
	
КонецПроцедуры


Функция НайтиАвтоПоVIN(VIN) Экспорт

	ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	ВерсияАльфаАвто = Renault_CRM.ВерсияАльфаАвто();
		
	//Если ВерсияАльфаАвто = "5" Тогда		
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автомобили.Ссылка
		|ИЗ
		|	Справочник.Автомобили КАК Автомобили
		|ГДЕ
		|	(Автомобили.VIN = &VIN
		|			ИЛИ Автомобили.ОригинальныйVIN = &VIN)";
		
	//Иначе
	//	
	//	Запрос = Новый Запрос;
	//	Запрос.Текст = 
	//	"ВЫБРАТЬ
	//	|	Автомобили.Ссылка
	//	|ИЗ
	//	|	Справочник.Автомобили КАК Автомобили
	//	|ГДЕ
	//	|	Автомобили.VIN = &VIN";
	//	
	//КонецЕсли;
	
	Запрос.УстановитьПараметр("VIN", VIN);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Автомобиль = Выборка.Ссылка;
	Иначе	
		Автомобиль = Справочники.Автомобили.ПустаяСсылка();
	КонецЕсли;

	Возврат Автомобиль;
	
КонецФункции 

// Функция - Получить стоимость базовой комплектации по тарифу ЦенаКлиентская
//
Функция ПолучитьЦенуБазовойКомплектацииПоТарифу(VIN, УчитыватьФиксацию = Истина, пДатаФиксации = Неопределено, Модель = Неопределено, ВариантКомплектации = Неопределено, ГодВыпуска = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(VIN) И Модель = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(VIN) И ЗначениеЗаполнено(Модель) Тогда
		Автомобиль = Новый Структура;
		Автомобиль.Вставить("Модель", Модель);
		Автомобиль.Вставить("ВариантКомплектации", ВариантКомплектации);
		
		ГодВыпуска = ?(ЗначениеЗаполнено(ГодВыпуска), ГодВыпуска, Неопределено);
		ТекущийТариф = Справочники.Renault_ТарифыНаАвтомобили.ПолучитьТарифДляРасчетаЦены(ГодВыпуска);
	Иначе
		
		Автомобиль = НайтиАвтоПоVIN(VIN);
		
		Если Не ЗначениеЗаполнено(Автомобиль) Тогда
			#Если Клиент Тогда
				Сообщить("Не найден автомобиль по VIN");
			#КонецЕсли
			
			Возврат 0;
		КонецЕсли;
		
		Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
		Запись.Автомобиль = Автомобиль;
		Запись.Прочитать();
		
		Если ЗначениеЗаполнено(пДатаФиксации) Тогда
			ТекущийТариф = ПолучитьТарифПоДатеФиксации(пДатаФиксации);		
		ИначеЕсли Запись.ЦенаФиксирована И УчитыватьФиксацию Тогда
			ТекущийТариф = ПолучитьТарифПоДатеФиксации(Запись.ДатаФиксации);		
		Иначе
			ГодВыпуска = ?(ЗначениеЗаполнено(Автомобиль.ГодВыпуска), Год(Автомобиль.ГодВыпуска), Неопределено);
			ТекущийТариф = Справочники.Renault_ТарифыНаАвтомобили.ПолучитьТарифДляРасчетаЦены(ГодВыпуска);
		КонецЕсли;	
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
			
	Запрос.УстановитьПараметр("Модель", Автомобиль.Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", Автомобиль.ВариантКомплектации);
	Запрос.УстановитьПараметр("ТекущийТариф", ТекущийТариф);
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ЦенаКлиентская
	               |ИЗ
	               |	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних КАК Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних
	               |ГДЕ
	               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.Модель = &Модель
	               |	И Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации = &ВариантКомплектации
	               |	И Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.Тариф = &ТекущийТариф";
	
	Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA И ЗначениеЗаполнено(Автомобиль.ГодВыпуска) Тогда
		Запрос.УстановитьПараметр("ГодПТС", Год(Автомобиль.ГодВыпуска));
		Запрос.Текст = "ВЫБРАТЬ
		               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ЦенаКлиентская
		               |ИЗ
		               |	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних КАК Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних
		               |ГДЕ
		               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.Модель = &Модель
		               |	И Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации = &ВариантКомплектации
		               |	И Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.Тариф = &ТекущийТариф
		               |	И Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ГодПТС = &ГодПТС";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		ЦенаПродажиБаза = Выборка.ЦенаКлиентская;
	Иначе
		ЦенаПродажиБаза = 0;
	КонецЕсли;
	
	Возврат ЦенаПродажиБаза;
	
КонецФункции

Функция ПолучитьСтоимостьЗаводскихОпцийПоТарифу(VIN, УчитыватьФиксацию = Истина, пДатаФиксации = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(VIN) Тогда
		Возврат 0;
	КонецЕсли;
	
	Автомобиль = НайтиАвтоПоVIN(VIN);
	
	Если Не ЗначениеЗаполнено(Автомобиль) Тогда
		#Если Клиент Тогда
			Сообщить("Не найден автомобиль по VIN");
		#КонецЕсли
		
		Возврат 0;
	КонецЕсли;
	
	Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
	Запись.Автомобиль = Автомобиль;
	Запись.Прочитать();
	
	Если ЗначениеЗаполнено(пДатаФиксации) Тогда
		ТекущийТариф = ПолучитьТарифПоДатеФиксации(пДатаФиксации);		
	ИначеЕсли Запись.ЦенаФиксирована И УчитыватьФиксацию Тогда
		ТекущийТариф = ПолучитьТарифПоДатеФиксации(Запись.ДатаФиксации);		
	Иначе
		ГодВыпуска = ?(ЗначениеЗаполнено(Автомобиль.ГодВыпуска), Год(Автомобиль.ГодВыпуска), Неопределено);
		ТекущийТариф = Справочники.Renault_ТарифыНаАвтомобили.ПолучитьТарифДляРасчетаЦены(ГодВыпуска);
	КонецЕсли;	
	
	Запись = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
	Запись.VIN = Автомобиль.VIN;
	Запись.Прочитать();
	Если ЗначениеЗаполнено(Запись.OPTIONS) Тогда	
		//Получим таблицы опций для парсинга
		ТаблицаПакетовОпций = Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.ПолучитьТаблицуСоставныхОпций();
		ТаблицаОтдельныхОпций = Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.ПолучитьТаблицуОтдельныхОпций();
		
		МассивОпцийАвтомобиля = Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.МассивОпцийПоСтроке(Запись.OPTIONS, ТаблицаПакетовОпций, ТаблицаОтдельныхОпций, Автомобиль.ВариантКомплектации, ТекущийТариф);		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Опция.Ссылка КАК Опция,
	               |	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Опция.Артикул КАК Код,
	               |	ВЫРАЗИТЬ(Renault_ТарифНаОпцииАвтомобилейСрезПоследних.НаименованиеОпции КАК СТРОКА(150)) КАК Наименование,
	               |	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.ЦенаКлиентская КАК Цена,
	               |	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.ЦенаДилерская
	               |ИЗ
	               |	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних(
	               |			,
	               |			Тариф = &ТекущийТариф
	               |				И Опция.Ссылка В (&МассивОпций)
	               |				И ВариантКомплектации.Ссылка = &ВариантКомплектации) КАК Renault_ТарифНаОпцииАвтомобилейСрезПоследних";
	Запрос.УстановитьПараметр("ТекущийТариф", ТекущийТариф);
	Запрос.УстановитьПараметр("МассивОпций", МассивОпцийАвтомобиля);
	Запрос.УстановитьПараметр("ВариантКомплектации", Автомобиль.ВариантКомплектации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЦенаПродажиОпции = 0;
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Цена) Тогда
			ЦенаПродажиОпции = ЦенаПродажиОпции + Выборка.Цена;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЦенаПродажиОпции;
	
КонецФункции

Функция ПолучитьТарифПоДатеФиксации(ДатаФиксации)

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата", ДатаФиксации);
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Renault_ТарифыНаАвтомобили.Ссылка
	               |ИЗ
	               |	Справочник.Renault_ТарифыНаАвтомобили КАК Renault_ТарифыНаАвтомобили
	               |ГДЕ
	               |	Renault_ТарифыНаАвтомобили.НачалоДействия <= &Дата
	               |	И (Renault_ТарифыНаАвтомобили.ОкончаниеДействия >= &Дата
	               |			ИЛИ Renault_ТарифыНаАвтомобили.ОкончаниеДействия = ДАТАВРЕМЯ(1, 1, 1))";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Тариф = Справочники.Renault_ТарифыНаАвтомобили.ПустаяСсылка();
	Если Выборка.Следующий() Тогда
		Тариф = Выборка.Ссылка;
	КонецЕсли;

	Возврат Тариф;
	
КонецФункции

Функция ПолучитьСтоимостьОборудования(VIN, ВидРемонта) Экспорт

	Если Не ЗначениеЗаполнено(VIN) Тогда
		Возврат 0;
	КонецЕсли;
	
	Автомобиль = НайтиАвтоПоVIN(VIN);
	
	Если Не ЗначениеЗаполнено(Автомобиль) Тогда
		#Если Клиент Тогда
			Сообщить("Не найден автомобиль по VIN");
		#КонецЕсли
		
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ЗаказНаряд.СуммаДокумента) КАК Сумма
	               |ИЗ
	               |	Документ.ЗаказНаряд КАК ЗаказНаряд
	               |ГДЕ
	               |	ЗаказНаряд.Автомобиль = &Автомобиль
	               |	И ЗаказНаряд.ВидРемонта = &ВидРемонта
	               |	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)";
	
	Запрос.УстановитьПараметр("ВидРемонта", ВидРемонта);
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);

	Выборка = Запрос.Выполнить().Выбрать();
	
	СтоимостьОборудования = 0;
	Пока Выборка.Следующий() Цикл
		СтоимостьОборудования = Выборка.Сумма;
	КонецЦикла;

	Возврат СтоимостьОборудования;
	
