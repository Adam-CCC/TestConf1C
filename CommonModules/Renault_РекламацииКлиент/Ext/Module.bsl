//Только клиентская часть
Функция ВыбратьФайлДляРекламации(ФормаВладелец) Экспорт
	
	МаксимальныйРазмер = ФормаВладелец.МаксимальныйРазмер;
	
	АдресВременногоХранилищаФайла = "";
	
	// Создание из файла
	ПолноеИмяФайла = "";
	
	РасширениеПодключено = ПодключитьРасширениеРаботыСФайлами();
	
	Если РасширениеПодключено Тогда
		
		ВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ВыборФайла.МножественныйВыбор = Ложь;
		ВыборФайла.Заголовок = "Выбор файла";
		
		Результат = ВыборФайла.Выбрать();
		ПолноеИмяФайла = ВыборФайла.ПолноеИмяФайла;
		
		Если НЕ Результат Тогда
			Возврат "";
		КонецЕсли;
		
		Файл = Новый Файл(ПолноеИмяФайла);
		
		Если Файл.ЭтоКаталог() тогда
			
			ПоказатьПредупреждение(,"Выбор каталога не возможен", 5);
			Возврат "";
			
		КонецЕсли;
		
		ИмяФайла	 = Файл.ИмяБезРасширения;
		Расширение	 = СтрЗаменить(Файл.Расширение, ".","");
		Размер		 = Файл.Размер();
		
		Если Размер > МаксимальныйРазмер тогда
			
			Предупреждение("Размер файла более 4 Мб. Добавление невозможно!", 10);
			Возврат "";
			
		КонецЕсли;
		АдресВременногоХранилищаФайла = ПоместитьФайлВоВременноеХранилище(ПолноеИмяФайла, ФормаВладелец);
		
	Иначе 
		// Если веб-клиент
		
		// Поместим Файл в ВременноеХранилище
		АдресВременногоХранилищаФайла = "";
		ПутьФайла = "";
		Если НЕ ПоместитьФайл(АдресВременногоХранилищаФайла, ПутьФайла, ПутьФайла, Истина,ФормаВладелец.УникальныйИдентификатор) Тогда
			Возврат "";
		КонецЕсли;
		
		Файл = Новый Файл(ПутьФайла);
		
		Если Файл.ЭтоКаталог() тогда
			
			ПоказатьПредупреждение(,"Выбор каталога не возможен", 5);
			Возврат "";
			
		КонецЕсли;
		
		ИмяФайла	 = Файл.ИмяБезРасширения;
		Расширение	 = Файл.Расширение;

	КонецЕсли;
	
	////////////////////////////////
	//	Проверки
	Если ЗначениеЗаполнено(АдресВременногоХранилищаФайла) тогда
		
		ФормаВладелец.НаименованиеФайла	 = ИмяФайла;
		ФормаВладелец.РасширениеФайла	 = Расширение;
		
	КонецЕсли;
	
	Возврат АдресВременногоХранилищаФайла;
	
КонецФункции

