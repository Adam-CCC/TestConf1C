// Помещает файл во временное хранилище и возвращает строковое представление адреса
//
// Параметры
//  ПолноеИмяФайла  - Строка(0) - полное имя файла в строковом представлении
//
//  ФормаВладелец - Управл. форма - Форма УУИД которой используем в качестве УУИД хранилища.
//
// Возвращаемое значение
//  АдресВременногоХранилищаФайла  - Строка(0) - Строковое представление адреса врем. хранилища
//
Функция ПоместитьФайлВоВременноеХранилище(ПолноеИмяФайла, ФормаВладелец) Экспорт
	
	//Первоначальная инициализация
	АдресВременногоХранилищаФайла = неопределено;
	
	ПомещаемыеФайлы = Новый Массив;
	Описание = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, "");
	ПомещаемыеФайлы.Добавить(Описание);
	
	ПомещенныеФайлы = Новый Массив;
	
	Если НЕ ПоместитьФайлы(ПомещаемыеФайлы, ПомещенныеФайлы,, Ложь, ФормаВладелец.УникальныйИдентификатор) Тогда
		ВызватьИсключение "Ошибка при помещении файла в хранилище: " + ПолноеИмяФайла;
	КонецЕсли;
	
	Если ПомещенныеФайлы.Количество() = 1 Тогда
		АдресВременногоХранилищаФайла = ПомещенныеФайлы[0].Хранение;
	КонецЕсли;
	
	Возврат АдресВременногоХранилищаФайла;
	
КонецФункции

Функция ПоместитьФайлДляРекламации(ФормаВладелец) Экспорт
	
	ОписаниеФайла = ФормаВладелец.ОписаниеФайла;

	АдресВременногоХранилищаФайла = ФормаВладелец.АдресВременногоХранилища;
	
	ДатаЗаписи = ФормаВладелец.ДатаЗаписи;

	ИмяБезРасширения = ФормаВладелец.НаименованиеФайла;
	Расширение		 = ФормаВладелец.РасширениеФайла;
	
	ВладелецСсылка = ФормаВладелец.ВладелецСсылка;
	
	ИдентификаторВХранилище = Renault_ОбщийМодульСервер.ЗаписатьФайлВБазу(АдресВременногоХранилищаФайла, ВладелецСсылка, ИмяБезРасширения, Расширение,
												ОписаниеФайла, ДатаЗаписи);
	
	Возврат ИдентификаторВХранилище;
	
КонецФункции

Процедура ОткрытьФайлПоИдентификатору(Идентификатор) Экспорт
	
	РасширениеПодключено = ПодключитьРасширениеРаботыСФайлами();
	
	ЭтоВебКлиент = Renault_Открытый.ЭтоВебКлиент();
	
	Если РасширениеПодключено Тогда
		Если НЕ ЭтоВебКлиент тогда
			КаталогВременныхФайлов = КаталогВременныхФайлов();
		КонецЕсли;
	
		АдресВременногоХранилищаФайла = Renault_ОбщийМодульСервер.ПолучитьФайлИзБазы(Идентификатор);
		
		Если ЗначениеЗаполнено(АдресВременногоХранилищаФайла) тогда
			ДанныеИзХранилища = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаФайла);
			
			ДДанные = ДанныеИзХранилища["ДДанные"];
			ИмяФайла = ДанныеИзХранилища["ИмяФайла"];
			
			Если Не ЭтоВебКлиент тогда
				ПутьКФайлу = КаталогВременныхФайлов + ИмяФайла;
				ДанныеФайла = ПолучитьИзВременногоХранилища(ДДанные);
				ДанныеФайла.Записать(ПутьКФайлу);
				ОткрытьФайлПриложением(ПутьКФайлу);
			Иначе
				ПолучитьФайл(ДДанные,ИмяФайла,Истина);
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Функция предназначена для открытия файла соответствующим приложением
//
// Параметры
//  ДанныеФайла  - структура с данными файла
//  ИмяОткрываемогоФайла - Строка - полное имя файла
Процедура ОткрытьФайлПриложением(ИмяОткрываемогоФайла)
	
	РасширениеПодключено = ПодключитьРасширениеРаботыСФайлами();
	Если РасширениеПодключено Тогда
		Попытка
			ДопПараметры = Новый Структура("ИмяФайла",ИмяОткрываемогоФайла);
			НачатьЗапускПриложения(Новый ОписаниеОповещения("ОткрытьФайлПриложениемЗавершение",Renault_РекламацииКлиент,ДопПараметры),ИмяОткрываемогоФайла,,Истина);
		Исключение
			Инфо = ИнформацияОбОшибке();
			Предупреждение("Описание="""+ Инфо.Описание +"""");
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры 

Процедура ОткрытьФайлПриложениемЗавершение(КодВозврата, ДополнительныеПараметры) Экспорт
	УдалитьФайлы(ДополнительныеПараметры.ИмяФайла);	
КонецПроцедуры
