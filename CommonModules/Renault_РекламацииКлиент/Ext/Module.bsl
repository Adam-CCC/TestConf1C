// Производит выбор файлов для загрузки в документ рекламации
//
// Параметры:
//  ФормаВладелец	 - УправляемаяФорма	 -  Форма загрузки файлов в рекламацию
//
Процедура ВыбратьФайлыДляРекламации(ФормаВладелец) Экспорт
	
	МаксимальныйРазмер = ФормаВладелец.МаксимальныйРазмер;
	
	РасширениеПодключено = ПодключитьРасширениеРаботыСФайлами();
	
	Если РасширениеПодключено Тогда
		
		ВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ВыборФайла.МножественныйВыбор = Истина;
		ВыборФайла.Заголовок = "Выберите один или несколько файлов...";
		
		Результат = ВыборФайла.Выбрать();
		
		Если Результат Тогда
			
			Для Каждого ВыбранныйФайл Из ВыборФайла.ВыбранныеФайлы Цикл
				
				Файл = Новый Файл(ВыбранныйФайл);
				
				Если НЕ Файл.ЭтоКаталог() Тогда
					
					ИмяФайла	 = Файл.ИмяБезРасширения;
					Расширение	 = СтрЗаменить(Файл.Расширение, ".","");
					Размер		 = Файл.Размер();
					
					Если Размер > МаксимальныйРазмер тогда
						
						Предупреждение("Размер файла " + ИмяФайла + " более 4 Мб. Добавление невозможно!", 10);
						Продолжить;
						
					КонецЕсли;
					
					НоваяСтрока = ФормаВладелец.ТаблицаФайловДляЗагрузки.Добавить();
					
					НоваяСтрока.НаименованиеФайла 			= ИмяФайла;
					НоваяСтрока.Расширение 					= Расширение;
					НоваяСтрока.АдресВоВременномХранилище 	= ПоместитьФайлВоВременноеХранилище(ВыбранныйФайл, ФормаВладелец);
					
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе 
		// Если веб-клиент
		
		Для Каждого ВыбранныйФайл Из ВыборФайла.ВыбранныеФайлы Цикл
		
			// Поместим Файл в ВременноеХранилище
			АдресВременногоХранилищаФайла = "";
			ПутьФайла = "";
			Если НЕ ПоместитьФайл(АдресВременногоХранилищаФайла, ПутьФайла, ПутьФайла, Истина,ФормаВладелец.УникальныйИдентификатор) Тогда
				Продолжить;
			КонецЕсли;
			
			Файл = Новый Файл(ПутьФайла);
			
			Если НЕ Файл.ЭтоКаталог() тогда
				
				ИмяФайла	 = Файл.ИмяБезРасширения;
				Расширение	 = СтрЗаменить(Файл.Расширение, ".","");
				Размер		 = Файл.Размер();
				
				Если Размер > МаксимальныйРазмер тогда
					
					Сообщить("Размер файла " + ИмяФайла + " более 4 Мб. Добавление невозможно!", 10);
					Продолжить;
					
				КонецЕсли;
				
				НоваяСтрока = ФормаВладелец.ТаблицаФайловДляЗагрузки.Добавить();
				
				НоваяСтрока.НаименованиеФайла 			= ИмяФайла;
				НоваяСтрока.Расширение 					= Расширение;
				НоваяСтрока.АдресВоВременномХранилище 	= АдресВременногоХранилищаФайла;
				
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;
	
КонецПроцедуры // ВыбратьФайлыДляРекламации()

// Функция - Поместить файлы для рекламации
//
// Параметры:
//  ФормаВладелец	 - УправляемаяФорма	 - Форма загрузки файлов в рекламацию
// 
// Возвращаемое значение:
//  Строка - Идентификатор файла в хранилище
//
Функция ПоместитьФайлыДляРекламации(ФормаВладелец, ОписаниеФайла, АдресВременногоХранилищаФайла, НаименованиеФайла, РасширениеФайла) Экспорт
	
	ДатаЗаписи = ФормаВладелец.ДатаЗаписи;
	
	ВладелецСсылка = ФормаВладелец.ВладелецСсылка;
	
	ИдентификаторВХранилище = Renault_ОбщийМодульСервер.ЗаписатьФайлВБазу(АдресВременногоХранилищаФайла, ВладелецСсылка, НаименованиеФайла, РасширениеФайла,
												ОписаниеФайла, ДатаЗаписи);
	
	Возврат ИдентификаторВХранилище;
	
КонецФункции // ПоместитьФайлыДляРекламации()

