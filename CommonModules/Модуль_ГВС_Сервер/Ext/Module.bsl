Процедура СформироватьНапоминание (Тема,Описание,Объект = Неопределено ,ТаблицаПользователей)

	Пользователи = ТаблицаПользователей;
	Тема         = Тема;
	Описание     = Описание; 
	
	Если Объект <> Неопределено Тогда
		Объект       = Объект;                         
		КтоСоздал    = Объект.Автор;
	Иначе
		Объект ="";
		КтоСоздал = Справочники.Пользователи.Робот;
	КонецЕсли;
	
	Для Каждого Пользователь Из Пользователи Цикл	
		Напоминание = РегистрыСведений.Напоминания.СоздатьМенеджерЗаписи();		
		Напоминание.Объект                  = Объект; 
		Напоминание.ДатаНачала              = ТекущаяДата(); 
		Напоминание.РеальнаяДатаОповещения  = ТекущаяДата() + 5; 
		Напоминание.ДатаОповещения          = ТекущаяДата(); 
		Напоминание.СрокДоНачала            = 0; 
		Напоминание.Автор                   = КтоСоздал; 
		Напоминание.Тема                    = Тема; 
		Напоминание.ТипПериода              = "00"; 
		Напоминание.ДатаАктуальности        = Дата(1,1,1,0,0,0); 
		Напоминание.Описание                = Описание; 
		Напоминание.УдалитьПоИстеченииСрока = Истина; 
		Напоминание.Редактирование          = Ложь;		
		Напоминание.Завершено               = Ложь;
		Напоминание.Пользователь            = Пользователь.Получатель;
		Напоминание.Записать();
		//РегистрыСведений.Напоминания.СоздатьНаборЗаписей().ПоказатьБаннер(Напоминание);
	КонецЦикла;
	
КонецПроцедуры

Процедура НапоминаниеОДнеРождения () Экспорт  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Пользователь,
		|   Пользователи.Сотрудник.ДатаРождения КАК ДатаРождения
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.Сотрудник.ФлагУволен
		|	И НЕ Пользователи.ЭтоГруппа
		|	И Пользователи.Сотрудник.Должность В
		|			(ВЫБРАТЬ
		|				ЗНАЧЕНИЕ(Справочник.Должности.Бухгалтер) КАК Д_1
		|		
		|			ОБЪЕДИНИТЬ ВСЕ
		|		
		|			ВЫБРАТЬ
		|				&Должность)
		|	И ВЫБОР
		|			КОГДА ДЕНЬГОДА(Пользователи.Сотрудник.ДатаРождения) - (ДЕНЬГОДА(&ТекущаяДата)-1) = 1
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Должность", Справочники.Должности.НайтиПоКоду("ЦБ000254"));   //Бухга-касс. Предопред не работает
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли; 
	
	Тема = "Оповещение о Дне Рождения!!!";          
	ПеречислениеСотрудников = "";
	Для Каждого Строчка Из РезультатЗапроса Цикл
		ПеречислениеСотрудников = Строка(Строчка.Пользователь) + ПеречислениеСотрудников + Символы.ПС;
	КонецЦикла; 
	
	Описание = "У сотрудников " + ПеречислениеСотрудников + "завтра ДЕНЬ РОЖДЕНИЯ!!! :3 :D";
	
	КомуОтправить = Новый ТаблицаЗначений;
	КомуОтправить.Колонки.Добавить("Получатель",Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	КомуОтправить.Добавить().Получатель = Справочники.Пользователи.НайтиПоКоду("Колесникова Елена Александровна");
	
	СформироватьНапоминание(Тема,Описание,,КомуОтправить);
		
КонецПроцедуры