Функция ПолучитьПраваАРМЗапчасти() Экспорт

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМКаталог КАК Каталог,
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМСнабжение КАК Снабжение,
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМСклад КАК Склад,
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМРеноПартс КАК РеноПартс,
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМРекламации КАК Рекламации,
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМКладовщика КАК АРМКладовщика,
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМЛогиста КАК АРМЛогиста,
				   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМРеализации КАК АРМРеализации
                   |ИЗ
                   |    РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
                   |ГДЕ
                   |    Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
    Выборка = Запрос.Выполнить().Выбрать();

    Ответ = Новый Структура("Каталог, Снабжение, Склад, РеноПартс, Рекламации, АРМКладовщика, АРМЛогиста, АРМРеализации",
                            Истина, Истина, Истина, Истина, Истина, Истина, Истина, Истина);

    Если Выборка.Следующий() Тогда
        ЗаполнитьЗначенияСвойств(Ответ, Выборка);
    КонецЕсли;

    Возврат Ответ;

КонецФункции
