Функция ЕстьПравоАРМЗапчастиСнабжение() Экспорт

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
                   |    Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ЗЧ_АРМСнабжение КАК Право
                   |ИЗ
                   |    РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
                   |ГДЕ
                   |    Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.Право;

    Иначе
        Возврат Истина;

    КонецЕсли;

КонецФункции

