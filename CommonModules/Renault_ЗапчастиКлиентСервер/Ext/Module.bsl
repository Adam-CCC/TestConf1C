Процедура Renault_ЗаказПоставщикуПриЗаписиСтатусПриЗаписи(Источник, Отказ) Экспорт

    Если НЕ Отказ Тогда

        МенеджерЗаписи = РегистрыСведений.Renault_СтатусыЗаказовПоставщику.СоздатьМенеджерЗаписи();
        МенеджерЗаписи.ЗаказПоставщику = Источник.Ссылка;
        МенеджерЗаписи.Прочитать();

        Если Не МенеджерЗаписи.Выбран() Тогда // Делаем новую запись
            МенеджерЗаписи.ЗаказПоставщику = Источник.Ссылка;
            МенеджерЗаписи.Статус          = Перечисления.Renault_СтатусыЗаказаПоставщику.Новый;
            МенеджерЗаписи.Записать(Истина);
        КонецЕсли;

    КонецЕсли;

КонецПроцедуры


Функция ЗаказОтправленВРено(ЗаказСсылка) Экспорт

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказСсылка);
    Запрос.УстановитьПараметр("СтатусНового",    Перечисления.Renault_СтатусыЗаказаПоставщику.Новый);

    Запрос.Текст = "ВЫБРАТЬ
                   |    Renault_СтатусыЗаказовПоставщику.ЗаказПоставщику,
                   |    Renault_СтатусыЗаказовПоставщику.Статус
                   |ИЗ
                   |    РегистрСведений.Renault_СтатусыЗаказовПоставщику КАК Renault_СтатусыЗаказовПоставщику
                   |ГДЕ
                   |    Renault_СтатусыЗаказовПоставщику.ЗаказПоставщику = &ЗаказПоставщику
                   |    И НЕ Renault_СтатусыЗаказовПоставщику.Статус = &СтатусНового";

     Возврат Не Запрос.Выполнить().Пустой();

КонецФункции


Функция НайтиДилераРПартс(DMD) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("DMD", DMD);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Renault_НастройкиОбменаССайтом.ДилерскийЦентр
	               |ИЗ
	               |	РегистрСведений.Renault_НастройкиОбменаССайтом КАК Renault_НастройкиОбменаССайтом
	               |ГДЕ
	               |	Renault_НастройкиОбменаССайтом.DMD = &DMD";
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Возврат Результат.Выгрузить()[0].ДилерскийЦентр;
	Иначе
		Возврат Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции


