

Функция ПолучитьПодразделениеДокумента(ДокОбъект)
	
	Подразделение = Неопределено;
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.Renault_Договор") Тогда 
		Подразделение = ДокОбъект.DMS_Подразделение;
	ИначеЕсли
		ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.Renault_РабочийЛист") Тогда 
		Подразделение = ДокОбъект.Подразделение;
	КонецЕсли;
	
	Возврат Подразделение;
	
КонецФункции

Функция ПроверкаПодразделенияНаСквознуюНумерацию(Подразделение,ДилерскийЦентр)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Подразделение",Подразделение);
	МассивПодразделений = ДилерскийЦентр.DMS_ПодразделенияНумерации.НайтиСтроки(Отбор);
	Возврат Не (МассивПодразделений.Количество()>0);	
	
КонецФункции

Процедура ПроверитьНомерДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	ПроверитьНомерОбъектаПоДате(Источник);
	
КонецПроцедуры

Процедура УстановитьПрефиксПодразделения(Источник, СтандартнаяОбработка, Префикс) Экспорт
	
	УстановитьПрефикс(Источник,Префикс);
		
КонецПроцедуры

Процедура УстановитьПрефикс(Источник, Префикс)
	
	ПрефиксПодразделения = "";
	ПрефиксПоУмолчанию = Константы.DMS_ПрефиксДокументовПоУмолчанию.Получить();
	Подразделение = ПолучитьПодразделениеДокумента(Источник);
	Если Подразделение = Неопределено Тогда
		Префикс = ПрефиксПоУмолчанию;
		Возврат;
	КонецЕсли;
	
	Если Не ПроверкаПодразделенияНаСквознуюНумерацию(Подразделение,Источник.ДилерскийЦентр) Тогда
		ПрефиксПодразделения = Подразделение.Префикс;		
	КонецЕсли;
	Если ПрефиксПодразделения = "" Тогда 
		ПрефиксПодразделения = ПрефиксПоУмолчанию;
	КонецЕсли;
	
	Префикс = ПрефиксПодразделения;
	
КонецПроцедуры

Процедура ПроверитьНомерОбъектаПоДате(Объект)
	
	Если Объект.ОбменДанными.Загрузка Тогда
		Возврат;
	ИначеЕсли Объект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ШапкаОбъекта.Дата КАК Дата
	|ИЗ
	|	" + МетаданныеОбъекта.ПолноеИмя() + " КАК ШапкаОбъекта
	|ГДЕ
	|	ШапкаОбъекта.Ссылка = &Ссылка
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если Не ДатыОбъектаОдногоПериода(Выборка.Дата, Объект.Дата, Объект.Ссылка) Тогда
		Объект.Номер = "";
	КонецЕсли;
	
КонецПроцедуры

Функция ДатыОбъектаОдногоПериода(Знач Дата1, Знач Дата2, Ссылка) Экспорт
	
	МетаданныеОбъекта = Ссылка.Метаданные();
	
	Если ПериодичностьНомераДокументаГод(МетаданныеОбъекта) Тогда
		
		РазностьДат = НачалоГода(Дата1) - НачалоГода(Дата2);
		
	ИначеЕсли ПериодичностьНомераДокументаКвартал(МетаданныеОбъекта) Тогда
		
		РазностьДат = НачалоКвартала(Дата1) - НачалоКвартала(Дата2);
		
	ИначеЕсли ПериодичностьНомераДокументаМесяц(МетаданныеОбъекта) Тогда
		
		РазностьДат = НачалоМесяца(Дата1) - НачалоМесяца(Дата2);
		
	ИначеЕсли ПериодичностьНомераДокументаДень(МетаданныеОбъекта) Тогда
		
		РазностьДат = НачалоДня(Дата1) - НачалоДня(Дата2);
		
	Иначе // ПериодичностьНомераДокументаНеопределено
		
		РазностьДат = 0;
		
	КонецЕсли;
	
	Возврат РазностьДат = 0;
	
КонецФункции

Функция ПериодичностьНомераДокументаГод(МетаданныеОбъекта)
	
	Возврат МетаданныеОбъекта.ПериодичностьНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Год;
	
КонецФункции

Функция ПериодичностьНомераДокументаКвартал(МетаданныеОбъекта)
	
	Возврат МетаданныеОбъекта.ПериодичностьНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Квартал;
	
КонецФункции

Функция ПериодичностьНомераДокументаМесяц(МетаданныеОбъекта)
	
	Возврат МетаданныеОбъекта.ПериодичностьНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.Месяц;
	
КонецФункции

Функция ПериодичностьНомераДокументаДень(МетаданныеОбъекта)
	
	Возврат МетаданныеОбъекта.ПериодичностьНомера = Метаданные.СвойстваОбъектов.ПериодичностьНомераДокумента.День;
	
КонецФункции

