// Возвращает ID реквизита из таблицы props по переданным параметрам МетаданныеИД, ИмяТЧ, ИмяРеквизита
// При необходимости создает переданный ID
Функция ПолучитьИДРеквизитов(внСоединение, МетаданныеИД, ИмяТЧ, ИмяРеквизита)
	
	УИД = 0;
	RecordSet = Новый COMОбъект("ADODB.Recordset");
	RecordSet.ActiveConnection = внСоединение;
	
	ТекстЗапроса = "SELECT uid FROM props WHERE (meta_uid = " + ЧислоSQL(МетаданныеИД) + ") AND (UPPER(nametp) = UPPER('" + ИмяТЧ + "')) AND (UPPER(namerec) = UPPER('" + ИмяРеквизита + "'))";
	RecordSet.Open(ТекстЗапроса);
	
	Если RecordSet.RecordCount <> 0 Тогда  
		УИД = RecordSet.Fields("uid").Value;
	Иначе 
		RecordSet.Close();
		
		ТекстЗапроса = "INSERT INTO props (meta_uid, nametp, namerec) OUTPUT INSERTED.uid VALUES (" + ЧислоSQL(МетаданныеИД) + ", '" + ИмяТЧ + "', '" + ИмяРеквизита + "')";
		RecordSet.Open(ТекстЗапроса);
		
		УИД = RecordSet.Fields("uid").Value;
	КонецЕсли;
	
	RecordSet.Close();
	
	Возврат ЧислоSQL(УИД);
	
КонецФункции // ПолучитьИДРеквизитов

// Создает в БД временную таблицу для хранения данных таблицы journ_rec до сжатия
Функция СоздатьВременнуюТаблицуJournRecMSSQL(Command)
	
	ИмяВТ = "##J" + СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	// Удалим если ВТ есть на сервере
	УдалитьВременнуюТаблицуMSSQL(Command, ИмяВТ);
	
	ВыполнитьЗапросMSSQL(Command,
		"CREATE TABLE " + ИмяВТ + "(" +
		"[journ_uid] [bigint] NOT NULL," +
		"[prop_uid] [int] NULL," +
		"[numtp] [int] NULL," +
		"[oldview] [nvarchar](max) NULL," +
		"[newview] [nvarchar](max) NULL," +
		"[typerec] [tinyint] NULL," +
		"[oldval] [nvarchar](max) NULL," +
		"[newval] [nvarchar](max) NULL" +
		")"
	);
	
	Возврат ИмяВТ;
	
КонецФункции // СоздатьВременнуюТаблицуJournRecMSSQL

// Удаляет временную таблицу, после сжатия
Функция УдалитьВременнуюТаблицуMSSQL(Command, ИмяВТ)
	
	ВыполнитьЗапросMSSQL(Command, "IF OBJECT_ID('" + ИмяВТ + "') IS NOT NULL DROP TABLE " + ИмяВТ);
	
КонецФункции // УдалитьВременнуюТаблицуMSSQL

// Выполняет запрос к БД MS SQL
Процедура ВыполнитьЗапросMSSQL(Command, ТекстЗапроса)
	
	Command.CommandText			= ТекстЗапроса;
	Command.Execute();	
	
КонецПроцедуры // ВыполнитьЗапросMSSQL

// Возвращает соответствие из таблица "ИмяТаблицы" где Ключ - caption, Значение - uid 
Функция СоответствиеЗначенийБД(внСоединение, ИмяТаблицы)
	
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.Open("SELECT uid, caption FROM " + ИмяТаблицы + " WHERE (base_uid = " + ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ()) + ") ORDER BY caption", внСоединение);
	
	Соответствие = Новый Соответствие;	
	Пока НаборЗаписей.EOF = 0 Цикл
		Соответствие.Вставить(НаборЗаписей.Fields("caption").Value, ЧислоSQL(НаборЗаписей.Fields("uid").Value));
		НаборЗаписей.MoveNext();
	КонецЦикла;
	НаборЗаписей.Close();
	
	Возврат Соответствие;
	
КонецФункции // СоответствиеЗначенийБД

// Функция записывает в БД данные по событию
Функция ДобавитьЗаписьВЖурналРегистрацииБД(Recordset, ИдентификаторИБ, РИБИД, ДатаИзменения, ГУИДОбъекта, МИД, СобытиеИД, Представление, ИДПользователя, ИДКомпьютера, Версия)
	
	ТекстЗапроса = "INSERT INTO journ (base_uid, rib_uid, datechange, object_guid, meta_uid, user_uid, computer_uid, event_uid, caption, ver) OUTPUT INSERTED.uid VALUES (" + 
	    ИдентификаторИБ + "," + 
		РИБИД + ",'" + 
		ДатаВремяSQL(ДатаИзменения) + "'," + 
		?(ГУИДОбъекта = "", "NULL", "'" + ГУИДОбъекта + "'") + "," + 
		МИД + "," + 
		ИДПользователя + "," + 
		ИДКомпьютера + ","  + 
		СобытиеИД + "," + 
		?(Представление = "", "NULL", "'" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(Представление) + "'") + 
		", " + ЧислоSQL(Версия) + ")";
	Recordset.Open(ТекстЗапроса);
	
	УИД = ЧислоSQL(RecordSet.Fields("uid").Value);
	
	RecordSet.Close();
		
	Возврат УИД;
	
КонецФункции // ДобавитьЗаписьВЖурналРегистрацииБД

// Возвращает полный образ объекта "ГУИДОбъекта" на "ДатаАктуальности"
// Результат ТаблицаЗначений
Функция ПолныйОбразОбъектаНаДату(НаборЗаписей, ИдентификаторИБ, ДатаАктуальности, ГУИДОбъекта, ВключаяТекущийОбъект = Истина) Экспорт
	
	//====================================================================
	// Запрос по всем изменениям		
	
	// Для остальных объектов
	ТекстЗапроса = 
		"SELECT j.journ_uid,j.numtp,j.oldval,j.newval,j.oldview,j.newview,j.typerec,p.nametp,p.namerec FROM journ_rec as j LEFT JOIN journ as jn ON j.journ_uid=jn.uid LEFT JOIN props as p ON j.prop_uid=p.uid
		|WHERE (jn.datechange" + ?(ВключаяТекущийОбъект, "<=", "<") + "'" + ДатаВремяSQL(ДатаАктуальности) + "')AND(jn.object_guid='" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(ГУИДОбъекта) + "')AND(jn.base_uid=" + ИдентификаторИБ + ")
		|ORDER BY j.journ_uid,p.nametp,p.namerec"
	;
	НаборЗаписей.Open(ТекстЗапроса);
	
	//====================================================================
	// Если нет изменений до этой записи
	// занчит это первоначальная запись(образ объекта), запишем его и закончим...
	Если НаборЗаписей.EOF <> 0 Тогда
		
		НаборЗаписей.Close();		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	
	//====================================================================
	// Создаем пустую таблицу изменений	и получаем все изменения по объекту
	// формируя образ объекта на дату
		
	ТаблицаИзменений = Новый ТаблицаЗначений;
	ТаблицаИзменений.Колонки.Добавить("ИмяТЧ", 					Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ТаблицаИзменений.Колонки.Добавить("ИмяРеквизита", 			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ТаблицаИзменений.Колонки.Добавить("НомерСтрокиТЧ", 			Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ТаблицаИзменений.Колонки.Добавить("ЗначениеСтарое", 		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаИзменений.Колонки.Добавить("ЗначениеНовое", 			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаИзменений.Колонки.Добавить("ПредставлениеСтарое", 	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));
	ТаблицаИзменений.Колонки.Добавить("ПредставлениеНовое", 	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));
	ТаблицаИзменений.Колонки.Добавить("ТипРеквизита", 			Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Любой)));
	ТаблицаИзменений.Индексы.Добавить("ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ"); // добавим индексы для быстроты поиска

	СтруктураПоиска = Новый Структура("ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ");
	ВерсияИзменения = 0;
	ТекущийИД		= -1;
	
	Пока НаборЗаписей.EOF = 0 Цикл
		
		СтруктураПоиска.ИмяТЧ				= НаборЗаписей.Fields("nametp").Value;		
		СтруктураПоиска.ИмяРеквизита		= НаборЗаписей.Fields("namerec").Value;
		СтруктураПоиска.НомерСтрокиТЧ		= НаборЗаписей.Fields("numtp").Value;		
		Массив 								= ТаблицаИзменений.НайтиСтроки(СтруктураПоиска);
		
		Если Массив.Количество() = 0 Тогда
			
			Массив.Добавить(ТаблицаИзменений.Добавить());			
			Массив[0].ИмяТЧ					= НаборЗаписей.Fields("nametp").Value;
			Массив[0].ИмяРеквизита			= НаборЗаписей.Fields("namerec").Value;
			Массив[0].НомерСтрокиТЧ			= НаборЗаписей.Fields("numtp").Value;
			Массив[0].ЗначениеСтарое		= НаборЗаписей.Fields("oldval").Value;
			Массив[0].ЗначениеНовое			= НаборЗаписей.Fields("newval").Value;
			Массив[0].ПредставлениеСтарое	= НаборЗаписей.Fields("oldview").Value;
			Массив[0].ПредставлениеНовое	= НаборЗаписей.Fields("newview").Value;
			Массив[0].ТипРеквизита			= НаборЗаписей.Fields("typerec").Value;
			
		Иначе
			
			Массив[0].ЗначениеСтарое		= Массив[0].ЗначениеНовое;
			Массив[0].ПредставлениеСтарое	= Массив[0].ПредставлениеНовое;
			Массив[0].ЗначениеНовое			= НаборЗаписей.Fields("newval").Value;
			Массив[0].ПредставлениеНовое	= НаборЗаписей.Fields("newview").Value;
			
		КонецЕсли;
		
		Если ТекущийИД <> НаборЗаписей.Fields("journ_uid").Value Тогда
			ВерсияИзменения = ВерсияИзменения + 1;
			ТекущийИД = НаборЗаписей.Fields("journ_uid").Value;
		КонецЕсли;
			
		НаборЗаписей.MoveNext();
		
	КонецЦикла;
	
	НаборЗаписей.Close();
	
	Результат.Вставить("ОбразОбъекта", 		ТаблицаИзменений);
	Результат.Вставить("ВерсияИзменения", 	ВерсияИзменения);	
	
	Возврат Результат;
	
КонецФункции // ПолныйОбразОбъектаНаДату

// Возвращает полный образ объекта "ГУИДОбъекта" на "ДатаАктуальности"
// Результат ТаблицаЗначений
Функция ОбразОбъектаНаДату(ДатаАктуальности, ГУИДОбъекта) Экспорт
	
	внСоединение = ПолучитьСоединение();	
	Если внСоединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаборЗаписей 				= Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.CursorLocation = 2;
	НаборЗаписей.ActiveConnection = внСоединение;
	
	ИдентификаторИБ = ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ());
	
	Результат = ПолныйОбразОбъектаНаДату(НаборЗаписей, ИдентификаторИБ, ДатаАктуальности, ГУИДОбъекта, Ложь);
	внСоединение.Close();
	
	Возврат Результат;
	
КонецФункции // ОбразОбъектаНаДату

// Сравнивает полный образ объекта до текущей версии изменения и возвращает
// структуру(ВерсияИзменения, ОбразОбъекта) или Неопределено в зависимости
// от того, произошло изменение версии или нет
Функция ИзмененияДляСжатия(НаборЗаписей, ИдентификаторИБ, ОбразОбъекта, ВыборкаВерсии)
	
	Результат 		= Новый Структура;
	
	// Проверка, если регистр сведений и это запись по одним и тем же полям кроме ресурса, то пропускаем это событие
	Если ВыборкаВерсии.ТипМетаданных = 10 И ВыборкаВерсии.Событие = 4 И ОбразОбъекта <> Неопределено Тогда
		
		// Регистр сведений и физическое удаление
		// Ищем следующим событием идет та же запись по ключевым полям?
		ВыборкаОбъектСл = Справочники.Renault_внКэшЖурналаРегистрации.НайтиПоКоду(ВыборкаВерсии.Код + 1);		
		Если ЗначениеЗаполнено(ВыборкаОбъектСл) Тогда
			Если ВыборкаОбъектСл.ТипМетаданных = 10 И ВыборкаОбъектСл.Событие = 8 И ВыборкаВерсии.Пользователь = ВыборкаОбъектСл.Пользователь И ВыборкаВерсии.Компьютер = ВыборкаОбъектСл.Компьютер Тогда
				
				ОбразОбъектаСл = ПолучитьИзмененияПоОбъектуВКэше(ВыборкаВерсии.Код + 1, ВыборкаВерсии.УзелРИБ);
				Если ОбразОбъектаСл <> Неопределено Тогда
					НеобходимоУдалитьЗапись = Истина;
					Для каждого Строки Из ОбразОбъекта Цикл
						
						Если Строки.ТипРеквизита = 3 ИЛИ Строки.ТипРеквизита = 5 Тогда
							
							// Если Измерения или стандартные реквизиты (Период, Регистратор, ... если они есть)
							Отбор = Новый Структура();
							Отбор.Вставить("ИмяРеквизита", 	Строки.ИмяРеквизита);
							Отбор.Вставить("ТипРеквизита", 	Строки.ТипРеквизита);
							Отбор.Вставить("ЗначениеНовое", Строки.ЗначениеНовое);
							НайденныеСтроки = ОбразОбъектаСл.НайтиСтроки(Отбор);
							
							Если НайденныеСтроки.Количество() = 0 Тогда
								
								// Не нашли по ключевым полям
								НеобходимоУдалитьЗапись = Ложь;
								Прервать;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
					// Это не изменение по ключевым поляем (изменился только ресурс)
					// Поэтому необходимо удалить эту запись
					Если НеобходимоУдалитьЗапись Тогда
						Возврат Неопределено;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Это обычное удаление записи, фиксируем его, т.к. образ будет пустым
		Для Каждого Строки Из ОбразОбъекта Цикл			
			Строки.ЗначениеСтарое		= Строки.ЗначениеНовое;
			Строки.ПредставлениеСтарое	= Строки.ПредставлениеНовое;
			Строки.ЗначениеНовое		= "";
			Строки.ПредставлениеНовое	= "";
		КонецЦикла;
	КонецЕсли;
	
	//====================================================================
	// Если нет изменений до этой записи
	// это первоначальная запись(образ объекта), запишем его и закончим...
	Если ОбразОбъекта = Неопределено Тогда
		
		Результат.Вставить("ВерсияИзменения",	0);
		Результат.Вставить("ОбразОбъекта",		ОбразОбъекта);		
		
		Возврат Результат;
		
	КонецЕсли;
	
	// Получим структуру с образом объекта на дату изменения (включая ее) для объекта.
	// Т.е. в результате получим все данные по объекту до его изменения.	
	СтруктураОбраза		= ПолныйОбразОбъектаНаДату(НаборЗаписей, ИдентификаторИБ, ВыборкаВерсии.ДатаИзменения, ВыборкаВерсии.ГУИДОбъекта); 
	
	// Объект не имеет версий, записываем полный образ объекта
	Если СтруктураОбраза = Неопределено Тогда
		
		Результат.Вставить("ВерсияИзменения",	0);
		Результат.Вставить("ОбразОбъекта",		ОбразОбъекта);
		
		Возврат Результат;		
		
	КонецЕсли;
	
	ТаблицаИзменений	= СтруктураОбраза.ОбразОбъекта;
	ВерсияИзменения		= СтруктураОбраза.ВерсияИзменения;
	
	//====================================================================
	// В ТаблицаИзменений содержится полный образ до изменений этого объекта
	// Удалим строки, которые не были изменены	
	// Собираем образ нового объекта с реквизитами
	
	ОбразАктуальный = Новый ТаблицаЗначений;
	ОбразАктуальный.Колонки.Добавить("ИмяТЧ", 				Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ОбразАктуальный.Колонки.Добавить("ИмяРеквизита", 		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ОбразАктуальный.Колонки.Добавить("НомерСтрокиТЧ", 		Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ОбразАктуальный.Колонки.Добавить("ЗначениеСтарое", 		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ОбразАктуальный.Колонки.Добавить("ЗначениеНовое", 		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ОбразАктуальный.Колонки.Добавить("ПредставлениеСтарое", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));
	ОбразАктуальный.Колонки.Добавить("ПредставлениеНовое", 	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));
	ОбразАктуальный.Колонки.Добавить("ТипРеквизита", 		Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Любой)));
	
	СтруктураПоиска	= Новый Структура("ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ");
	
	Для Каждого Строки Из ТаблицаИзменений Цикл
		
		СтруктураПоиска.ИмяТЧ					= Строки.ИмяТЧ;   
		СтруктураПоиска.ИмяРеквизита			= Строки.ИмяРеквизита;
		СтруктураПоиска.НомерСтрокиТЧ			= Строки.НомерСтрокиТЧ;                              
		Массив									= ОбразОбъекта.НайтиСтроки(СтруктураПоиска);
		
		Если Массив.Количество() > 0 Тогда
			
			// Есть и в образе объекта и в таблице изменений
			Если Строки.ЗначениеНовое <> Массив[0].ЗначениеНовое Тогда				
				НоваяСтрока 					= ОбразАктуальный.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строки, "ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ, ТипРеквизита");
				НоваяСтрока.ЗначениеНовое		= Массив[0].ЗначениеНовое;
				НоваяСтрока.ЗначениеСтарое		= Строки.ЗначениеНовое;
				НоваяСтрока.ПредставлениеНовое	= Массив[0].ПредставлениеНовое;
				НоваяСтрока.ПредставлениеСтарое = Строки.ПредставлениеНовое;
			КонецЕсли;			
			
		Иначе
			
			// В образе объекта нет, но есть в таблице изменений т.е. строка была удалена
			Если Строки.ЗначениеНовое <> "" Тогда // << Проверка обязательна
				НоваяСтрока						= ОбразАктуальный.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строки, "ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ, ТипРеквизита");
				НоваяСтрока.ЗначениеСтарое		= Строки.ЗначениеНовое;
				НоваяСтрока.ПредставлениеСтарое	= Строки.ПредставлениеНовое;
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЦикла;
	
	// Проверка есть в образе объекта, но нет в таблице изменений
	Для каждого Строки Из ОбразОбъекта Цикл
		
		СтруктураПоиска.ИмяТЧ					= Строки.ИмяТЧ;   
		СтруктураПоиска.ИмяРеквизита			= Строки.ИмяРеквизита;
		СтруктураПоиска.НомерСтрокиТЧ			= Строки.НомерСтрокиТЧ;                              
		Массив									= ТаблицаИзменений.НайтиСтроки(СтруктураПоиска);
		
		Если Массив.Количество() = 0 Тогда
			
			// Строка была добавлена в текущей версии
			НоваяСтрока							= ОбразАктуальный.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строки);
			
		КонецЕсли;
		
	КонецЦикла;
		
	// Обработка подписок на события
	// Получаем подписки на события
	ПодпискиНаСобытия = Renault_внОбщийМодульПовтИсп.ПодпискиНаСобытия(ВыборкаВерсии.МетаданныеОбъекта);
	Если ПодпискиНаСобытия.Количество() > 0 Тогда
		
		ОбработкаПодпискиНаСобытие(ВыборкаВерсии.Ссылка, ОбразАктуальный, ПодпискиНаСобытия);
		
	КонецЕсли;
	
	// Возвращаем результат
	Если ОбразАктуальный.Количество() > 0 Тогда
		
		// Есть результат
		Результат.Вставить("ВерсияИзменения",	ВерсияИзменения);		
		Результат.Вставить("ОбразОбъекта",		ОбразАктуальный);
		
		Возврат Результат;
		
	Иначе
				
		// Не нужно переносить объект
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ИзмененияДляСжатия

// Функция возвращает таблицу значений с изменениями по объекту в БД журнала
Функция ПолучитьИзмененияПоОбъекту(КодИзменения) Экспорт
	
	внСоединение = ПолучитьСоединение();
	Если внСоединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИдентификаторИБ = ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ());
		
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.CursorLocation = 2;
	ТекстЗапроса =
		"SELECT journ_rec.uid, props.nametp, props.namerec, journ_rec.numtp, journ_rec.oldview, journ_rec.newview, journ_rec.typerec, journ_rec.oldval, journ_rec.newval
		|FROM journ_rec LEFT JOIN journ ON journ_rec.journ_uid = journ.uid LEFT JOIN props ON props.uid = journ_rec.prop_uid
		|WHERE (journ_rec.journ_uid = " + ЧислоSQL(КодИзменения) + ") and (journ.base_uid = " + ИдентификаторИБ +")
		|ORDER BY journ_rec.uid";
		
	ТЧ = Новый ТаблицаЗначений;
	ТЧ.Колонки.Добавить("НомерСтроки");
	ТЧ.Колонки.Добавить("ИмяТЧ");
	ТЧ.Колонки.Добавить("ИмяРеквизита");
	ТЧ.Колонки.Добавить("НомерСтрокиТЧ");
	ТЧ.Колонки.Добавить("ЗначениеСтарое");
	ТЧ.Колонки.Добавить("ЗначениеНовое");
	ТЧ.Колонки.Добавить("ПредставлениеСтарое");
	ТЧ.Колонки.Добавить("ПредставлениеНовое");
	ТЧ.Колонки.Добавить("ТипРеквизита");
	
	// добавим индексы для быстроты поиска
	ТЧ.Индексы.Добавить("ИмяТЧ,ИмяРеквизита,НомерСтрокиТЧ");
		
	// Соединяемся с SQL если нужно
	Ошибка = Ложь;
	СтрОшибки = "";
	Попытка
		
		НаборЗаписей.Open(ТекстЗапроса, внСоединение);
		
	Исключение		
		Ошибка = Истина;
		СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, ,СтрОшибки);
		Возврат ТЧ;		
	КонецПопытки;	
	
	НомерСтроки = 0;
	Пока НаборЗаписей.EOF = 0 Цикл
		
		НоваяСтрока 					= ТЧ.Добавить();
		НоваяСтрока.НомерСтроки			= НомерСтроки;
		НоваяСтрока.ИмяТЧ				= НаборЗаписей.Fields("nametp").Value;
		НоваяСтрока.ИмяРеквизита		= НаборЗаписей.Fields("namerec").Value;
		НоваяСтрока.НомерСтрокиТЧ		= НаборЗаписей.Fields("numtp").Value;
		НоваяСтрока.ЗначениеСтарое		= НаборЗаписей.Fields("oldval").Value;
		НоваяСтрока.ЗначениеНовое		= НаборЗаписей.Fields("newval").Value;
		НоваяСтрока.ПредставлениеСтарое	= НаборЗаписей.Fields("oldview").Value;
		НоваяСтрока.ПредставлениеНовое	= НаборЗаписей.Fields("newview").Value;
		НоваяСтрока.ТипРеквизита		= НаборЗаписей.Fields("typerec").Value;
		
		НаборЗаписей.MoveNext();
		НомерСтроки						= НомерСтроки + 1;
		
	КонецЦикла;
	
	НаборЗаписей.Close();
	внСоединение.Close();
	
	Возврат ТЧ;
	
КонецФункции // ПолучитьИзмененияПоОбъекту

// Функция возвращает таблицу значений с изменениями по объекту из кэша
Функция ПолучитьИзмененияПоОбъектуВКэше(КодИзменения, УзелРИБ) Экспорт
	
	// Ищем дочерние элементы
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	внКэшЖурналаРегистрацииИзменения.НомерСтроки КАК НомерСтроки,
		|	внКэшЖурналаРегистрацииИзменения.ИмяРеквизита,
		|	внКэшЖурналаРегистрацииИзменения.ИмяТЧ,
		|	внКэшЖурналаРегистрацииИзменения.НомерСтрокиТЧ,
		|	внКэшЖурналаРегистрацииИзменения.ТипРеквизита,
		|	"""" КАК ПредставлениеСтарое,
		|	внКэшЖурналаРегистрацииИзменения.Представление КАК ПредставлениеНовое,
		|	"""" КАК ЗначениеСтарое,
		|	внКэшЖурналаРегистрацииИзменения.Значение КАК ЗначениеНовое
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации.внИзменения КАК внКэшЖурналаРегистрацииИзменения
		|ГДЕ
		|	внКэшЖурналаРегистрацииИзменения.Ссылка.Код = &Код
		|	И внКэшЖурналаРегистрацииИзменения.Ссылка.УзелРИБ = &УзелРИБ
		|
		|УПОРЯДОЧИТЬ ПО
		|	внКэшЖурналаРегистрацииИзменения.Ссылка.Часть,
		|	НомерСтроки"
	);
	
	Запрос.УстановитьПараметр("Код", 		КодИзменения);	
	Запрос.УстановитьПараметр("УзелРИБ", 	УзелРИБ);	
	РезультатЗапроса = Запрос.Выполнить();
		
	Если НЕ РезультатЗапроса.Пустой() Тогда
			
		ТЧ = РезультатЗапроса.Выгрузить();
		
		ТЧ.Индексы.Добавить("ИмяТЧ,ИмяРеквизита,НомерСтрокиТЧ"); // добавим индексы для быстроты поиска

		Возврат ТЧ;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ПолучитьИзмененияПоОбъектуВКэше

// Перенос из справочника "внКэшЖурналаРегистрации" в базу данных MS SQL Server
// Сразу делает сжатие данных	
Функция СжатьИсториюИзменений(Оповещать = Ложь, ЗаписыватьВСтандартныйЖурнал = Ложь) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	// Проверка, что база РИБ и попытка запустить сжатие в базе с полным типом обмена
	// запрещено запускать сжатие в дочерней базе РИБ
	Если Renault_внОбщийМодульПовтИсп.ТипОбменаРИБПолный() И ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Если ЗаписыватьВСтандартныйЖурнал Тогда
			ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Информация, , "Запуск в дочерней базе РИБ, сжатие не может быть выполнено");
		КонецЕсли;
		Возврат Ложь;		
	КонецЕсли;
	
	// Если регистрация отключена
	Если НЕ Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ВестиИсториюИзменений") Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Если ЗаписыватьВСтандартныйЖурнал Тогда
			ПУ = ПараметрУникальностиИБ();			
			ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, , "Запуск сжатия по регламентному заданию не был выполнен (история отключена, или не подходят параметры уникальности (сервер: <" + ПУ.Сервер + ">, имя базы: <" + ПУ.ИмяБазы + ">)).");
		КонецЕсли;
		Возврат Ложь;
	Иначе
		Если ЗаписыватьВСтандартныйЖурнал Тогда
			ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Информация, , "Запуск сжатия по регламентному заданию " + Формат(ТекущаяДата(), "ДФ='dd.MM.yy HH:mm:ss'"));
		КонецЕсли;
	КонецЕсли;
			
	//====================================================================
	// Проверка, что текущая ИБ не является дубликатом(копией) для которой
	// не нужно фиксировать изменения и если база оригинал, то подключаемся
	// к ней
	внСоединение = ПолучитьСоединение();
	
	Если внСоединение = Неопределено Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Если ЗаписыватьВСтандартныйЖурнал Тогда
			ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, , "Запуск сжатия по регламентному заданию не был выполнен (нет соединения с БД MS SQL).");
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
		
	// Получаем родительские версии (где часть = 0, упорядоченные в хронологическом порядке)
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ
		|	внКэшЖурналаРегистрации.Ссылка,
		|	внКэшЖурналаРегистрации.Событие,
		|	внКэшЖурналаРегистрации.Код,
		|	внКэшЖурналаРегистрации.УзелРИБ,
		|	внКэшЖурналаРегистрации.ТипМетаданных,
		|	внКэшЖурналаРегистрации.Пользователь,
		|	внКэшЖурналаРегистрации.Компьютер,
		|	внКэшЖурналаРегистрации.ГУИДОбъекта,
		|	внКэшЖурналаРегистрации.МетаданныеОбъекта,
		|	внКэшЖурналаРегистрации.ДатаИзменения,
		|	внКэшЖурналаРегистрации.ПредставлениеОбъекта
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК внКэшЖурналаРегистрации
		|ГДЕ
		|	внКэшЖурналаРегистрации.Часть = 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	внКэшЖурналаРегистрации.ДатаИзменения,
		|	внКэшЖурналаРегистрации.УзелРИБ,
		|	внКэшЖурналаРегистрации.Код,
		|	внКэшЖурналаРегистрации.Часть"
	;
	ВыборкаВерсии = Запрос.Выполнить().Выбрать();
	
	// Получаем все версии включая их подверсии
	Запрос.Текст =
		"ВЫБРАТЬ
		|	внКэшЖурналаРегистрации.Ссылка,
		|	внКэшЖурналаРегистрации.Код,
		|	внКэшЖурналаРегистрации.УзелРИБ
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК внКэшЖурналаРегистрации
		|
		|УПОРЯДОЧИТЬ ПО
		|	внКэшЖурналаРегистрации.ДатаИзменения,
		|	внКэшЖурналаРегистрации.УзелРИБ,
		|	внКэшЖурналаРегистрации.Код,
		|	внКэшЖурналаРегистрации.Часть"
	;
	ВыборкаПодверсий = Запрос.Выполнить().Выбрать();
	
	
	ИдентификаторИБ							= ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ());
	Command									= Новый COMОбъект("ADODB.Command");
	Command.ActiveConnection				= внСоединение;
	Command.CommandType						= 1; // adCmdText

	// Создаем RecordSet для записи в таблцу journ
	Recordset 								= Новый COMОбъект("ADODB.Recordset");	
	Recordset.CursorLocation 				= 2;
	RecordSet.ActiveConnection 				= внСоединение;

	// Создаем RecordSet для записи в таблцу journ_rec
	внНаборЗаписейИзменений					= Новый COMОбъект("ADODB.RecordSet");
	внНаборЗаписейИзменений.CursorLocation	= 2;
	внНаборЗаписейИзменений.LockType		= 3;

	// Узнаем сколько всего записей для удаления
	Если Оповещать Тогда
		ОбщееКоличествоЭлементов = ВыборкаВерсии.Количество();
		
		// Периодичность с которой вызывается индикация (каждые 0.5%)
		ШагОповещения = Окр(ОбщееКоличествоЭлементов / 200); 
		Если ШагОповещения = 0 Тогда
			ШагОповещения = 1;
		КонецЕсли;
		
		ДатаНачалаСжатия = ТекущаяДата();
		Структура = Новый Структура;
		Структура.Вставить("ОбщееКоличествоЭлементов", ОбщееКоличествоЭлементов);
		Структура.Вставить("ДатаНачалаСжатия", ДатаНачалаСжатия);
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Оповестить("внУстановитьМаксимумПрогрессаСжатия", Структура);			
		#КонецЕсли
	КонецЕсли;
	
	ИзмененияТЧ = Новый ТаблицаЗначений;
	ИзмененияТЧ.Колонки.Добавить("ИмяТЧ", 				Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ИзмененияТЧ.Колонки.Добавить("ИмяРеквизита", 		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ИзмененияТЧ.Колонки.Добавить("НомерСтрокиТЧ", 		Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ИзмененияТЧ.Колонки.Добавить("ЗначениеСтарое", 		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ИзмененияТЧ.Колонки.Добавить("ЗначениеНовое", 		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ИзмененияТЧ.Колонки.Добавить("ПредставлениеСтарое", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));
	ИзмененияТЧ.Колонки.Добавить("ПредставлениеНовое", 	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));	
	ИзмененияТЧ.Колонки.Добавить("ТипРеквизита", 		Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(2, 0, ДопустимыйЗнак.Любой)));
	ИзмененияТЧ.Индексы.Добавить("ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ");	
	
	// Кэш используемых данных (для уменьшения запросов к серверу журанала)
	СоответствиеМетаданных		= СоответствиеЗначенийБД(внСоединение, "metadata");
	СоответствиеПользователей	= СоответствиеЗначенийБД(внСоединение, "users");
	СоответствиеКомпьютеров		= СоответствиеЗначенийБД(внСоединение, "computers");
	СоответствиеРИБ				= СоответствиеЗначенийБД(внСоединение, "ribs");
	ТаблицаРеквизитов			= ПолучитьТаблицуРеквизитов(внСоединение);
	
	КоличествоОбработанных		= 0;
	ФиксироватьПерепроведенияДокументов = Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ФиксироватьПерепроведенияДокументов");
	
	// Обработка записей кэша
	ИмяТаблицыJournRec			= СоздатьВременнуюТаблицуJournRecMSSQL(Command);	
	НаборЗаписей 				= Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.CursorLocation = 2;
	НаборЗаписей.ActiveConnection = внСоединение;	
	
	СтруктураПоиска				= Новый Структура("Код,УзелРИБ");
	СтруктураПоискаРеквизитов	= Новый Структура("МетаИД,ТЧ,Реквизит");
	СтруктураПоискаПроведен		= Новый Структура("ИмяТЧ,ИмяРеквизита,НомерСтрокиТЧ");
	СтруктураПоискаПроведен.ИмяТЧ = "";
	СтруктураПоискаПроведен.ИмяРеквизита	= "Проведен";
	СтруктураПоискаПроведен.НомерСтрокиТЧ	= 0;
	ПерепроведениеДокумента		= Ложь;
	
	НомерЗаписи					= 0;
	МассивОбработанныхСсылок	= Новый Массив;
	
	Пока ВыборкаВерсии.Следующий() Цикл
				
		ФиксироватьСобытие		= Ложь;
		ВерсияИзменения			= 0;
		СтандартнаяОбработка	= Истина;		
		Событие					= ВыборкаВерсии.Событие;
		Код						= ВыборкаВерсии.Код;
		УзелРИБ					= ВыборкаВерсии.УзелРИБ;
		ТипМетаданных			= ВыборкаВерсии.ТипМетаданных;
		ПерепроведениеДокумента	= Ложь;
		
		// Выбираем все версии изменения для базы
		МассивОбработанныхСсылок.Очистить();
		ВыборкаПодверсий.Сбросить();
		СтруктураПоиска.Код		= Код;
		СтруктураПоиска.УзелРИБ = УзелРИБ;
		Пока ВыборкаПодверсий.НайтиСледующий(СтруктураПоиска) Цикл
		    МассивОбработанныхСсылок.Добавить(ВыборкаПодверсий.Ссылка);
		КонецЦикла;
		
		// Получаем строки изменений всего объекта включая всех версий
		ИзмененияТЧ.Очистить();
		Для Каждого ЭлементМассива Из МассивОбработанныхСсылок Цикл
			внИзменения = ЭлементМассива.внИзменения;
			Для Каждого СтрокиВерсии Из внИзменения Цикл
				НоваяСтрока							= ИзмененияТЧ.Добавить();
				НоваяСтрока.ИмяТЧ					= СтрокиВерсии.ИмяТЧ;
				НоваяСтрока.ИмяРеквизита			= СтрокиВерсии.ИмяРеквизита;
				НоваяСтрока.НомерСтрокиТЧ			= СтрокиВерсии.НомерСтрокиТЧ;
				НоваяСтрока.ЗначениеНовое			= СтрокиВерсии.Значение;
				НоваяСтрока.ПредставлениеНовое		= СтрокиВерсии.Представление;
				НоваяСтрока.ТипРеквизита			= СтрокиВерсии.ТипРеквизита;
			КонецЦикла;
		КонецЦикла;
						
		// Если есть необходимость переопределить сжатие каких-то своих событий
		Renault_внОбщийМодульПереопределяемый.СжатьЭлементВКэше(СтандартнаяОбработка, ВыборкаВерсии, ИзмененияТЧ, ВерсияИзменения, ФиксироватьСобытие);
		
		Если СтандартнаяОбработка Тогда
			
			Если Событие = 9 ИЛИ Событие = 10 Тогда
				
				ФиксироватьСобытие = Истина;				
				
			Иначе
				
				// Одна из главных функций, возвращает структуру после "сжатия объекта"
				Результат = ИзмененияДляСжатия(НаборЗаписей, ИдентификаторИБ, ИзмененияТЧ, ВыборкаВерсии);
				
				Если Результат = Неопределено Тогда
					// Документ и фиксировать перепроведение проверяем был ли он проведен
					Если ТипМетаданных = 1 И ФиксироватьПерепроведенияДокументов Тогда
						Массив = ИзмененияТЧ.НайтиСтроки(СтруктураПоискаПроведен);
						Если Массив.Количество() > 0 Тогда
							Попытка
								Если ЗначениеИзСтрокиВнутр(Массив[0].ЗначениеНовое) = Истина Тогда
									ФиксироватьСобытие = Истина;
									ПерепроведениеДокумента = Истина;
									ИзмененияТЧ.Очистить();
								КонецЕсли;
							Исключение
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;					
				Иначе
					ВерсияИзменения 	= Результат.ВерсияИзменения;
					ИзмененияТЧ			= Результат.ОбразОбъекта;
					ФиксироватьСобытие	= Истина;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		// Необходимо перенести данные в MS SQL? Если = Неопределено, то объект переносить не нужно
		Если ФиксироватьСобытие Тогда
			//==================================
			// Записываем в основной журнал
			//==================================
			
			// Для ускорения используем списки значений для определения часто используемых переменных (метаданные, пользователи, компьютеры, РИБы)
			МетаданныеИД = СоответствиеМетаданных.Получить(ВыборкаВерсии.МетаданныеОбъекта); 
			Если МетаданныеИД = Неопределено Тогда
				МетаданныеИД = ЧислоSQL(ПолучитьИДМетаданных(внСоединение, ИдентификаторИБ, ВыборкаВерсии.МетаданныеОбъекта));
				СоответствиеМетаданных.Вставить(ВыборкаВерсии.МетаданныеОбъекта, МетаданныеИД);
			КонецЕсли;
			ПользовательИД = СоответствиеПользователей.Получить(ВыборкаВерсии.Пользователь); 
			Если ПользовательИД = Неопределено Тогда
				ПользовательИД = ЧислоSQL(ПолучитьИДПользователя(внСоединение, ИдентификаторИБ, ВыборкаВерсии.Пользователь));
				СоответствиеПользователей.Вставить(ВыборкаВерсии.Пользователь, ПользовательИД);
			КонецЕсли;
			КомпьютерИД = СоответствиеКомпьютеров.Получить(ВыборкаВерсии.Компьютер);
			Если КомпьютерИД = Неопределено Тогда
				КомпьютерИД = ЧислоSQL(ПолучитьИДКомпьютера(внСоединение, ИдентификаторИБ, ВыборкаВерсии.Компьютер));
				СоответствиеКомпьютеров.Вставить(ВыборкаВерсии.Компьютер, КомпьютерИД);
			КонецЕсли;
			РИБИД = СоответствиеРИБ.Получить(Строка(УзелРИБ)); 
			Если РИБИД = Неопределено Тогда
				РИБИД = ЧислоSQL(ПолучитьИДРИБ(внСоединение, ИдентификаторИБ, Строка(УзелРИБ)));
				СоответствиеРИБ.Вставить(Строка(УзелРИБ), РИБИД);
			КонецЕсли;
			
			Если СтандартнаяОбработка Тогда
				Если ПерепроведениеДокумента Тогда
					Событие = 3; // << Перепроведение (если реквизиты в документе не изменены)
				ИначеЕсли ВерсияИзменения = 0 И Событие = 2 И ТипМетаданных <> 4 И ТипМетаданных <> 10 Тогда
					Событие = 1; // << Создание
				КонецЕсли;
			КонецЕсли;
			
			// Запись в журнал во временную таблицу MS SQL
			ИДЗаписиВЖурнале = ДобавитьЗаписьВЖурналРегистрацииБД(Recordset, ИдентификаторИБ, РИБИД, ВыборкаВерсии.ДатаИзменения, ВыборкаВерсии.ГУИДОбъекта, МетаданныеИД, Событие, ВыборкаВерсии.ПредставлениеОбъекта, ПользовательИД, КомпьютерИД, ВерсияИзменения);
			
			// Добавляем записи в таблицу изменений
			Если ИзмененияТЧ.Количество() > 0 Тогда
				
				внНаборЗаписейИзменений.Open(ИмяТаблицыJournRec, внСоединение);
				Для каждого Строки Из ИзмененияТЧ Цикл
					внНаборЗаписейИзменений.AddNew();
					внНаборЗаписейИзменений.Fields("journ_uid").Value 		= ИДЗаписиВЖурнале;
					
					// Поиск prop_uid					
					СтруктураПоискаРеквизитов.МетаИД	= МетаданныеИД;
					СтруктураПоискаРеквизитов.ТЧ		= Строки.ИмяТЧ;
					СтруктураПоискаРеквизитов.Реквизит	= Строки.ИмяРеквизита;
					НайденныеСтроки						= ТаблицаРеквизитов.НайтиСтроки(СтруктураПоискаРеквизитов);
					Если НайденныеСтроки.Количество() = 0 Тогда
						ПропИД					= ПолучитьИДРеквизитов(внСоединение, МетаданныеИД, Строки.ИмяТЧ, Строки.ИмяРеквизита);
						НоваяСтрока				= ТаблицаРеквизитов.Добавить();
						НоваяСтрока.ИД			= ПропИД;
						НоваяСтрока.МетаИД		= МетаданныеИД;
						НоваяСтрока.ТЧ			= Строки.ИмяТЧ;
						НоваяСтрока.Реквизит	= Строки.ИмяРеквизита;
					Иначе
						ПропИД					= НайденныеСтроки[0].ИД;
					КонецЕсли;
					
					внНаборЗаписейИзменений.Fields("prop_uid").Value		= ПропИД;
					внНаборЗаписейИзменений.Fields("numtp").Value 			= Строки.НомерСтрокиТЧ;					
					внНаборЗаписейИзменений.Fields("typerec").Value 		= Строки.ТипРеквизита;
					
					Если НЕ ПустаяСтрока(Строки.ПредставлениеСтарое) Тогда
						внНаборЗаписейИзменений.Fields("oldview").Value 	= Строки.ПредставлениеСтарое;
					КонецЕсли;
					Если НЕ ПустаяСтрока(Строки.ЗначениеСтарое) Тогда
						внНаборЗаписейИзменений.Fields("oldval").Value 	    = Строки.ЗначениеСтарое;
					КонецЕсли;
					
					Если НЕ ПустаяСтрока(Строки.ПредставлениеНовое) Тогда
						внНаборЗаписейИзменений.Fields("newview").Value 	= Строки.ПредставлениеНовое;
					КонецЕсли;
					Если НЕ ПустаяСтрока(Строки.ЗначениеНовое) Тогда
						внНаборЗаписейИзменений.Fields("newval").Value 	    = Строки.ЗначениеНовое;
					КонецЕсли;					
					
					внНаборЗаписейИзменений.Update();
				КонецЦикла;
				внНаборЗаписейИзменений.Close();
							
			КонецЕсли;
				
		КонецЕсли;
		
		НомерЗаписи = НомерЗаписи + 1;
		
		// Переносим из временной таблицы в основную
		ВыполнитьЗапросMSSQL(Command, 
			"INSERT INTO journ_rec (journ_uid,numtp,oldview,newview,typerec,oldval,newval,prop_uid) " + 
			"SELECT journ_uid,numtp,oldview,newview,typerec,oldval,newval,prop_uid FROM " + ИмяТаблицыJournRec
		);
		ВыполнитьЗапросMSSQL(Command, "DELETE FROM " + ИмяТаблицыJournRec); 			
		
		// Удаляем обработанные записи
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		Попытка
			Для Каждого ЭлементМассиваКУдалению Из МассивОбработанныхСсылок Цикл
				
				// Физическое удаление
				попытка // DMSCOR-1890 
					Объект = ЭлементМассиваКУдалению.ПолучитьОбъект();
					Объект.Удалить();
				исключение
				КонецПопытки;	
			КонецЦикла;
			ЗафиксироватьТранзакцию();			
		Исключение
			ОтменитьТранзакцию();
			Если ЗаписыватьВСтандартныйЖурнал Тогда
				ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, ,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
		КонецПопытки;
		
		// Счетчик обработанных версий
		КоличествоОбработанных = КоличествоОбработанных + 1;
		
		// Оповещаем в обычных формах
		Если Оповещать Тогда
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Если КоличествоОбработанных % ШагОповещения = 0 Тогда
					Структура = Новый Структура;
					Структура.Вставить("КоличествоОбработанных",КоличествоОбработанных);
					Структура.Вставить("ТекущаяДатаНаСервере", 	ТекущаяДата());
					Оповестить("внПрогрессСжатия", Структура);
				КонецЕсли;
			#КонецЕсли
		КонецЕсли;		
		
	КонецЦикла;
	
	// Удаление временной таблицы
	УдалитьВременнуюТаблицуMSSQL(Command, ИмяТаблицыJournRec);
		
	УстановитьПривилегированныйРежим(Ложь);	
	внСоединение.Close();
	
	Если ЗаписыватьВСтандартныйЖурнал Тогда
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Информация, , "Успешное завершение сжатия по регламентному заданию " + Формат(ТекущаяДата(), "ДФ='dd.MM.yy HH:mm:ss'") + ". Обработано " + Строка(КоличествоОбработанных) + " изменений.");
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции // СжатьИсториюИзменений

Функция ОчиститьЖурналРегистрацииТекущейИБ(Оповещать = Ложь) Экспорт
	
	// Удаляем из базы
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	внКэшЖурналаРегистрации.Ссылка
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК внКэшЖурналаРегистрации
		|
		|УПОРЯДОЧИТЬ ПО
		|	внКэшЖурналаРегистрации.Код"
	);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Оповещать Тогда
		ОбщееКоличествоЭлементов = Выборка.Количество();
		
		// Периодичность с которой вызывается индикация (каждые 0.5%)
		ШагОповещения = Окр(ОбщееКоличествоЭлементов / 200); 
		Если ШагОповещения = 0 Тогда
			ШагОповещения = 1;
		КонецЕсли;
		
		ДатаНачалаУдаления = ТекущаяДата();
		Структура = Новый Структура;
		Структура.Вставить("ОбщееКоличествоЭлементов", ОбщееКоличествоЭлементов);
		Структура.Вставить("ДатаНачалаУдаления", ДатаНачалаУдаления);
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			Оповестить("внУстановитьМаксимумПрогрессаУдаления", Структура);			
		#КонецЕсли
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Попытка
			Об.Удалить();
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
