// СИСТЕМНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Возникает при начале работы системы
Процедура ПриНачалеРаботыСистемы(Параметры = Неопределено) Экспорт
	
	// Если нет прав
	Если НЕ РольДоступна("Renault_внПользовательИсторииИзменений") И НЕ РольДоступна("Renault_внАдминистраторЖурналаРегистрации") Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры <> Неопределено Тогда
		УстановитьПривилегированныйРежим(Истина);
		ПараметрыСеанса.Renault_внПараметрыКлиентаНаСервере = Новый ФиксированноеСоответствие(Параметры);	
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
		
	//====================================================================
	// Проверка, что Настройки заполнены
	ПроверкаЗаполненияНастроек();
	
	// Защита от дубликатов баз
	Если Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ВестиИсториюИзменений") Тогда
		
		// Проверим дальнюю дату журнала регистрации
		// Записи в журнале регистрации должны выгружаться ежедневно и не должно быть записей за вчерашний день
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_внКэшЖурналаРегистрации.ДатаИзменения КАК ДатаИзменения
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК Renault_внКэшЖурналаРегистрации
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаИзменения";
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Если Выборка.ДатаИзменения < НачалоДня(ТекущаяДата()) Тогда
				Сообщить("Во внешнем журнеле регистрации присутствуют даннные с " + Выборка.ДатаИзменения + ". Проверьте работу регламентного задания ""(DMS) (ВН) Обработка журнала регистрации""" 
				+ Символы.ПС + "Рекомендуем обрабатывать журнал регистрации ежедневно в начале дня для корректной работы данного механизма", СтатусСообщения.ОченьВажное);
			КонецЕсли;
		КонецЕсли;
		
		// Обновление информационной базы
		Если ПравоДоступа("Использование", Метаданные.Обработки.Renault_внНастройкаЖурналаРегистрации) Тогда		
			Обработки.Renault_внНастройкаЖурналаРегистрации.ВыполнитьОбновление();
		КонецЕсли;
			
		// Отправляем на сервер информацию о том, что пользователь вошел
		Если Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("РегистрироватьВходыИВыходыПользователей") Тогда
			Попытка
				ЭлементКэша					= Справочники.Renault_внКэшЖурналаРегистрации.СоздатьЭлемент();
				ЭлементКэша.УзелРИБ			= ПолучитьУзелРИБ();
				ЭлементКэша.ДатаИзменения	= ТекущаяДата();
				ЭлементКэша.Пользователь	= ИмяПользователя();
				ЭлементКэша.Компьютер		= Renault_внОбщийМодульПовтИсп.ПолучитьИмяКомпьютера();
				ЭлементКэша.Событие			= 9;
				ЭлементКэша.Записать();		
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ПриНачалеРаботыСистемы

// Возникает при завершении работы
Процедура ПриЗавершенииРаботыСистемы() Экспорт
	
	// Сжатие и очистка запущены запуском из командной строки, не регистрируем входы и выходы
	Если (НРег(ИмяПользователя()) = "автоматическоесжатие") ИЛИ (НРег(ИмяПользователя()) = "автоматическаяочистка") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ РольДоступна("Renault_внПользовательИсторииИзменений") И НЕ РольДоступна("Renault_внАдминистраторЖурналаРегистрации") Тогда
		Возврат;
	КонецЕсли;
	
	Если Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ВестиИсториюИзменений") Тогда
		
		// Отправляем на сервер информацию о том, что пользователь вышел	
		Если Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("РегистрироватьВходыИВыходыПользователей") Тогда
			Попытка
				ЭлементКэша					= Справочники.Renault_внКэшЖурналаРегистрации.СоздатьЭлемент();
				ЭлементКэша.УзелРИБ			= ПолучитьУзелРИБ();
				ЭлементКэша.ДатаИзменения	= ТекущаяДата();
				ЭлементКэша.Пользователь	= ИмяПользователя();
				ЭлементКэша.Компьютер		= Renault_внОбщийМодульПовтИсп.ПолучитьИмяКомпьютера();
				ЭлементКэша.Событие			= 10;
				ЭлементКэша.Записать();			
			Исключение
			КонецПопытки;	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПриЗавершенииРаботыСистемы

