КонецФункции // ПолучитьвнСоединение

// Возвращает Таблицу значений со столбцами Пользователь, КоличествоИзменений, ДатаИзменений
// со статистикой по пользователю в данный день.
Функция ПолучитьСтатистикуРаботыПользователей(ДатаНач, ДатаКон) Экспорт
	
	внСоединение = ПолучитьСоединение();
	Если внСоединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ТЗ = Новый  ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Пользователь");
	ТЗ.Колонки.Добавить("КоличествоИзменений");
	ТЗ.Колонки.Добавить("ДатаИзменений");
	
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.CursorLocation = 2;
	
	ТекстЗапроса = 
		"SELECT users.caption as username, COUNT(journ.uid) as countchanges, CAST(FLOOR(CAST(journ.datechange AS FLOAT)) AS DATETIME) as dt
		|FROM journ LEFT OUTER JOIN users ON journ.user_uid = users.uid
		|WHERE (journ.datechange >= '" + ДатаВремяSQL(НачалоДня(ДатаНач)) + "') AND (journ.datechange <= '" + ДатаВремяSQL(КонецДня(ДатаКон)) + "') and (journ.base_uid = " + ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ()) + ")
		|GROUP BY users.caption, CAST(FLOOR(CAST(journ.datechange AS FLOAT)) AS DATETIME)"
	;
	
	// Соединяемся с SQL если нужно
	Ошибка = Ложь;
	СтрОшибки = "";
	Попытка
		
		НаборЗаписей.Open(ТекстЗапроса, внСоединение);
		
	Исключение
		
		Ошибка = Истина;
		СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
		Возврат ТЗ;
		
	КонецПопытки;	
			
	Пока НаборЗаписей.EOF = 0 Цикл
		НоваяСтрока						= ТЗ.Добавить();
		НоваяСтрока.Пользователь		= НаборЗаписей.Fields("username").Value;
		НоваяСтрока.КоличествоИзменений = НаборЗаписей.Fields("countchanges").Value;
		НоваяСтрока.ДатаИзменений		= НаборЗаписей.Fields("dt").Value;
		
		// Переходим к следующей
		НаборЗаписей.MoveNext();
	КонецЦикла;	
	
	НаборЗаписей.Close();
	внСоединение.Close();	
	
	// Из Кэша
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(внКэшЖурналаРегистрации.ДатаИзменения, ДЕНЬ) КАК ДатаИзменений,
		|	внКэшЖурналаРегистрации.Пользователь,
		|	СУММА(1) КАК КоличествоИзменений
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК внКэшЖурналаРегистрации
		|ГДЕ
		|	внКэшЖурналаРегистрации.ДатаИзменения МЕЖДУ &ДатаНач И &ДатаКон
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(внКэшЖурналаРегистрации.ДатаИзменения, ДЕНЬ),
		|	внКэшЖурналаРегистрации.Пользователь
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаИзменений"
	);
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНач));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаКон));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Выборка);
	КонецЦикла;	
	
	ТЗ.Свернуть("ДатаИзменений,Пользователь", "КоличествоИзменений");
	ТЗ.Сортировать("ДатаИзменений, Пользователь");
	
	Возврат ТЗ;
	
КонецФункции // ПолучитьСтатистикуРаботыПользователей

// Получает из внешней ИБ всех пользователей, которые делали изменения
Функция ПолучитьПользователейИстории(Соединение = Неопределено) Экспорт
	
	СЗ = Новый СписокЗначений;
	
	СоздатьСоединение = Соединение = Неопределено;
	
	Если СоздатьСоединение Тогда
		внСоединение = ПолучитьСоединение();
	Иначе
		внСоединение = Соединение;
	КонецЕсли;
	
	Если внСоединение = Неопределено Тогда
		Возврат СЗ;
	КонецЕсли;
		
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.Open("SELECT uid, caption FROM users WHERE base_uid = " + ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ()) + " ORDER BY caption", внСоединение);

	Пока НаборЗаписей.EOF = 0 Цикл
		СЗ.Добавить(НаборЗаписей.Fields("uid").Value, НаборЗаписей.Fields("caption").Value);
		НаборЗаписей.MoveNext();
	КонецЦикла;
	
	НаборЗаписей.Close();
	Если СоздатьСоединение Тогда
		внСоединение.Close();
	КонецЕсли;
		
	Возврат СЗ;
	
КонецФункции // ПолучитьПользователейИстории

