// Получает таблицу реквизитов метаданных
Функция ПолучитьТаблицуРеквизитов(Соединение = Неопределено) Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ИД",		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(15, ДопустимаяДлина.Переменная)));
	ТЗ.Колонки.Добавить("МетаИД",	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(15, ДопустимаяДлина.Переменная)));
	ТЗ.Колонки.Добавить("ТЧ",		Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ТЗ.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));	
	ТЗ.Индексы.Добавить("МетаИД,ТЧ,Реквизит");
	
	СоздатьСоединение = Соединение = Неопределено;
	
	Если СоздатьСоединение Тогда
		внСоединение = ПолучитьСоединение();
	Иначе
		внСоединение = Соединение;
	КонецЕсли;	

	Если внСоединение = Неопределено Тогда
		Возврат ТЗ;
	КонецЕсли;
	
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.Open(
		"SELECT props.uid, props.meta_uid, props.nametp, props.namerec FROM 
		|props LEFT JOIN metadata ON metadata.uid = props.meta_uid
		|WHERE (metadata.base_uid = " + ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ()) + ") ORDER BY props.meta_uid, props.nametp, props.namerec",
		внСоединение
	);
	
	Пока НаборЗаписей.EOF = 0 Цикл
		
		НоваяСтрока				= ТЗ.Добавить();
		НоваяСтрока.ИД			= ЧислоSQL(НаборЗаписей.Fields("uid").Value);
		НоваяСтрока.МетаИД		= ЧислоSQL(НаборЗаписей.Fields("meta_uid").Value);
		НоваяСтрока.ТЧ			= НаборЗаписей.Fields("nametp").Value;
		НоваяСтрока.Реквизит	= НаборЗаписей.Fields("namerec").Value;
		
		НаборЗаписей.MoveNext();
	КонецЦикла;
	
	НаборЗаписей.Close();
	Если СоздатьСоединение Тогда
		внСоединение.Close();
	КонецЕсли;
	
	Возврат ТЗ;	
	
КонецФункции // ПолучитьТаблицуРеквизитов

// Возвращает строку для подключения к MSSQL
Функция ПолучитьСтрокуПодключенияMSSQL(ИмяСервера, ИмяБазы, ИмяПользователя, Пароль)
		
	// Строка подключения к MS SQL	
	Если ПустаяСтрока(ИмяПользователя) И ПустаяСтрока(Пароль) Тогда
		
		стрПодключения = "Provider=SQLOLEDB.1;Integrated Security=SSPI;Initial Catalog=" + ИмяБазы + ";Data Source=" + ИмяСервера + ";Trusted_Connection=True;";
		
	Иначе
		
		стрПодключения = "Provider=SQLOLEDB.1;User ID=" + ИмяПользователя + ";Pwd=" + Пароль + ";Persist Security Info=True;Data Source=" + ИмяСервера + ";Initial Catalog=" + ИмяБазы + ";";
		
	КонецЕсли;
	
	Возврат стрПодключения;
	
КонецФункции // ПолучтьСтрокуПодключенияMSSQL

//ПодключитьSQL - Функция подключения к SQL-серверу с использованием механизмов ADO DB
//Параметры:
//	ПараметрыПодключения - тип Структура("ИмяСервера,ИмяПользователя,Пароль,ИмяБазы,СтрокаПодключения")
//			ИмяСервера			- имя SQL-сервера
//			ИмяПользователя		- Имя пользователя (sa или другой)
//			Пароль				- Пароль пользователя
//			ИмяБазы				- Имя базы данных
//			СтрокаПодключения	- (необязательный параметр) можно передать готовую строку подключения, 
//									если пустая тогда подключение по параметрам
Функция ПодключитьSQL(ПараметрыПодключения, Ошибка = "") Экспорт

	ТипБД				= ПараметрыПодключения.ТипБД;
	ИмяСервера			= СокрЛП(ПараметрыПодключения.СерверВнешнейИБ);
	ИмяПользователя 	= СокрЛП(ПараметрыПодключения.ПользовательВнешнейИБ);
	Пароль				= СокрЛП(ПараметрыПодключения.ПарольВнешнейИБ);
	ИмяБазы				= СокрЛП(ПараметрыПодключения.ИмяВнешнейИБ);
	ТаймаутСоединенияИБ = ПараметрыПодключения.ТаймаутСоединенияИБ;
	
	Если ПустаяСтрока(ИмяСервера) ИЛИ ПустаяСтрока(ИмяБазы) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Соединение						= Новый COMОбъект("ADODB.Connection"); 
	Соединение.CursorLocation 		= 3;
	Соединение.ConnectionTimeOut 	= 60; // << 60 секунд попытка соединится с сервером
	Соединение.CommandTimeOut 		= ТаймаутСоединенияИБ;
	
	// Конструктор строк подключений см. на сайте http://www.connectionstrings.com/
	Если НЕ ЗначениеЗаполнено(ТипБД) ИЛИ ТипБД = Перечисления.Renault_внТипБД.MSSQL Тогда
		
		Соединение.ConnectionString = ПолучитьСтрокуПодключенияMSSQL(ИмяСервера, ИмяБазы, ИмяПользователя, Пароль);
		
	КонецЕсли;	
	
	Попытка
		
		Соединение.Open();  
		
	Исключение
		
    	Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
		
	КонецПопытки;

	Возврат Соединение;
	
КонецФункции // ПодключитьSQL

// Возвращает параметры подключения к серверу MS SQL
// Возвращает Структуру
Функция ПолучитьПараметрыДоступаКБазеДанных() Экспорт
	
	Параметры = Новый Структура();
	
	Параметры.Вставить("ТипБД", 				Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ТипБД"));
	Параметры.Вставить("СерверВнешнейИБ", 		Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("СерверВнешнейИБ"));
	Параметры.Вставить("ПользовательВнешнейИБ", Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ПользовательВнешнейИБ"));
	Параметры.Вставить("ПарольВнешнейИБ", 		Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ПарольВнешнейИБ"));
	Параметры.Вставить("ИмяВнешнейИБ", 			Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ИмяВнешнейИБ"));
	Параметры.Вставить("ТаймаутСоединенияИБ", 	Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ТаймаутСоединенияИБ"));
	
	Возврат Параметры;
	
КонецФункции // ПолучитьПараметрыДоступаКБазеДанных

// Возвращает параметры подключения к серверу MS SQL
// Возвращает Структуру
Функция ЗадатьПараметрыДоступаКБазеДанных(ТипБД, СерверВнешнейИБ, ПользовательВнешнейИБ, ПарольВнешнейИБ, ИмяВнешнейИБ, ТаймаутСоединенияИБ) Экспорт
	
	Параметры = Новый Структура();
	
	Параметры.Вставить("ТипБД", 				ТипБД);
	Параметры.Вставить("СерверВнешнейИБ", 		СерверВнешнейИБ);
	Параметры.Вставить("ПользовательВнешнейИБ", ПользовательВнешнейИБ);
	Параметры.Вставить("ПарольВнешнейИБ", 		ПарольВнешнейИБ);
	Параметры.Вставить("ИмяВнешнейИБ", 			ИмяВнешнейИБ);
	Параметры.Вставить("ТаймаутСоединенияИБ", 	ТаймаутСоединенияИБ);
	
	Возврат Параметры;
	
КонецФункции // ПолучитьПараметрыДоступаКБазеДанных

// Создает БД на сервере
Функция СозданиеБДИсторииНаСервере(ТипБД, ИмяСервера, ИмяБД, ИмяПользователяБД, ПарольПользователяБД, Ошибка) Экспорт
	
	Макет			= Обработки.Renault_внНастройкаЖурналаРегистрации.ПолучитьМакет("МакетСозданияБД_MSSQL");
	ТекстSQLЗапроса = Макет.ПолучитьТекст();
	
	// Заменяем [History] на нашу БД
	ТекстSQLЗапроса	= СтрЗаменить(ТекстSQLЗапроса, "[History]", "[" + СокрЛП(ИмяБД) + "]");
	ТекстSQLЗапроса	= СтрЗаменить(ТекстSQLЗапроса, "'History'", "'" + СокрЛП(ИмяБД) + "'");
	                           
	// Обнуляем кэш
	Попытка
		// Функция ПолучитьСтрокуПодключенияMSSQL(ИмяБазы, ИмяСервера, ИмяПользователя, Пароль)
		Если НЕ ЗначениеЗаполнено(ТипБД) ИЛИ ТипБД = Перечисления.Renault_внТипБД.MSSQL Тогда
			стрПодключения = ПолучитьСтрокуПодключенияMSSQL(ИмяСервера, "master", ИмяПользователяБД, ПарольПользователяБД);
		КонецЕсли;
		
		Соединение 						= Новый COMОбъект("ADODB.Connection"); 
		Соединение.ConnectionTimeOut 	= 600;
		Соединение.CursorLocation 		= 3;
		Соединение.ConnectionString 	= стрПодключения;
		Соединение.CommandTimeOut 		= 600;
		
		// Пытаемся подключиться к скулине	
		Соединение.Open();  
						
		Command							= Новый COMОбъект("ADODB.Command");
		Command.ActiveConnection		= Соединение;
		Command.CommandType				= 1; // adCmdText		
		ТекстSQLКВыполнению				= "";
		Для Индекс = 1 По СтрЧислоСтрок(ТекстSQLЗапроса) Цикл
			
			Стр = СтрПолучитьСтроку(ТекстSQLЗапроса, Индекс);
			Если Стр = "GO" Тогда
				Command.CommandText = ТекстSQLКВыполнению;
				Command.Execute();
				
				ТекстSQLКВыполнению = "";
			Иначе
				ТекстSQLКВыполнению = ТекстSQLКВыполнению + Стр + Символы.ПС;
			КонецЕсли;			
		КонецЦикла;
		
		Соединение.Close();
		
		// Устанавливаем новые настройки
		УстановитьНастройкуЖурналаРегистрации("ТипБД",					ТипБД);
		УстановитьНастройкуЖурналаРегистрации("СерверВнешнейИБ",		ИмяСервера);
		УстановитьНастройкуЖурналаРегистрации("ИмяВнешнейИБ", 			ИмяБД);
		УстановитьНастройкуЖурналаРегистрации("ПользовательВнешнейИБ",	ИмяПользователяБД);
		УстановитьНастройкуЖурналаРегистрации("ПарольВнешнейИБ",		ПарольПользователяБД);		
		
		ПриНачалеРаботыСистемы();
		ОбновитьПовторноИспользуемыеЗначения();
		
		Возврат Истина;
		
	Исключение
		
		Ошибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции // СозданиеБДИсторииНаСервере()

// Проверяет уникальна ли строка идентификатора если да возращает Истина, иначе Ложь
// В переменной Ошибка возвращает строку с указанием ошибки пользователю
Функция ПроверитьИдентификаторИБНаУникальность(ИдентификаторИБ, Ошибка) Экспорт
	
	Ошибка = "";
	Результат = Истина;
	внСоединение = ПолучитьСоединение();
	Если внСоединение = Неопределено Тогда
		Ошибка = "Невозможно подключиться к базе данных!";
		Возврат Ложь;
	КонецЕсли;
	
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.Open("SELECT caption, SUM(1) as counter FROM bases WHERE UPPER(caption) = '" + ВРег(ИдентификаторИБ) + "' GROUP BY caption", внСоединение);
	СЗ = Новый СписокЗначений;
	
	Пока НаборЗаписей.EOF = 0 Цикл
		Если ВРег(НаборЗаписей.Fields("caption").Value) = ВРег(ИдентификаторИБ) И Число(НаборЗаписей.Fields("counter").Value) >= 1 Тогда
			Ошибка = "Данный идентификатор базы данных уже есть в журнале регистрации!";
			НаборЗаписей.Close();
			Возврат Ложь;
		КонецЕсли;
		НаборЗаписей.MoveNext();
	КонецЦикла;
	
	НаборЗаписей.Close();
	внСоединение.Close();
		
	Возврат Истина;
		
КонецФункции // ПроверитьИдентификаторИБНаУникальность

// Возвращает число идентфикатор данной ИБ
Функция ПолучитьИдентификаторИБНаСервере() Экспорт
	
	внСоединение = Renault_внОбщийМодуль.ПолучитьСоединение();
	Если внСоединение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.Open("SELECT uid FROM bases WHERE UPPER(caption) = UPPER('" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ИдентификаторИБ")) + "')", внСоединение);

	Если НаборЗаписей.EOF = 0 Тогда
		
		Результат = Число(НаборЗаписей.Fields("uid").Value);
		
	Иначе
		
		// Вставляем новый идентификатор, т.к. старый он не найден
		НаборЗаписей.Close();
		НаборЗаписей.Open("INSERT INTO bases (caption) OUTPUT INSERTED.uid VALUES ('" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ИдентификаторИБ")) + "')", внСоединение);
		Результат = Число(НаборЗаписей.Fields("uid").Value);
		
	КонецЕсли;
	НаборЗаписей.Close();
	внСоединение.Close();
		
	Возврат Результат;
	
КонецФункции // ПолучитьUIDИдентификаторИБ

// Список идентификторов ИБ с параметрами
Функция ПолучитьСписокИдентификаторовИБ(ТипБД, СерверВнешнейИБ, ПользовательВнешнейИБ, ПарольВнешнейИБ, ИмяИБ) Экспорт
	
	Параметры = Renault_внОбщийМодуль.ЗадатьПараметрыДоступаКБазеДанных(ТипБД, СерверВнешнейИБ, ПользовательВнешнейИБ, ПарольВнешнейИБ, ИмяИБ, 60);
	внСоединение = Renault_внОбщийМодуль.ПолучитьСоединениеПоПарамерам(Параметры);
	Если внСоединение = Неопределено Тогда
		Сообщить("Ошибка подключения к <" + ИмяИБ + ">!");
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.Open("SELECT caption FROM bases ORDER BY caption", внСоединение);
	
	СЗ = Новый СписокЗначений;
	
	Пока НаборЗаписей.EOF = 0 Цикл
		СЗ.Добавить(НаборЗаписей.Fields("caption").Value);
		НаборЗаписей.MoveNext();
	КонецЦикла;
	НаборЗаписей.Close();
	внСоединение.Close();
	
	Возврат СЗ;
	
КонецФункции

// Возвращает ТЗ со всеми изменениями с Отбором ДатаНач, ДатаКон
// МассивПользователи, МассивКомпьютеры, МассивСобытий должны быть массивами с ссылками из внешней базы
// МассивОбъектов должен быть массивом с строками
// Представление Представление строки (допускается использование %, _ и т.д.)
Функция ПолучитьИсториюИзменений(ДатаНач, ДатаКон, МассивПользователи, МассивКомпьютеры, МассивМетаданных,
	МассивОбъектов, МассивОбъектовСсылок, МассивСобытий, МассивУзловРИБ, МассивПодписок, Представление = "") Экспорт
	
	// Первоначальные тексты запросов для локального кэша и внешней БД
	ТекстВЗапросе = "dbo.journ.base_uid = " + ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ()) + " ";
	ТекстВЗапросеИБ = "ИСТИНА ";	
	
	Запрос = Новый Запрос;
	
	// Условие по датам
	Если ДатаКон <> Дата(1, 1, 1) И ДатаНач <= ДатаКон Тогда
		ТекстВЗапросе = ТекстВЗапросе + 
			"AND (dbo.journ.datechange >= CONVERT(datetime, '" + ДатаВремяSQL(ДатаНач) + "', 20)) AND (dbo.journ.datechange <= CONVERT(datetime, '" + ДатаВремяSQL(ДатаКон) + "', 20))";
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			"И (внКэшЖурналаРегистрации.ДатаИзменения МЕЖДУ &ДатаНач И &ДатаКон) ";
		Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
		Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	КонецЕсли;
	
	// Отбор по подпискам
	Если ЗначениеЗаполнено(МассивПодписок) И МассивПодписок.Количество() > 0 Тогда
				
		Подзапрос = "";
		ПодзапросИБ = "";
		Для Индекс = 0 По МассивПодписок.Количество() - 1 Цикл 
			
			П = МассивПодписок[Индекс];
			
			Если П.Получить("ИмяТЧ") = "" И П.Получить("ИмяРеквизита") = "" Тогда
				
				// Только метаданные
				Подзапрос = Подзапрос + "        
					|	(dbo.metadata.caption = '" + П.Получить("МетаданныеОбъекта") + "')";
					
				ПодзапросИБ = ПодзапросИБ + 
					" внКэшЖурналаРегистрации.МетаданныеОбъекта = """ + П.Получить("МетаданныеОбъекта") + """ ";
			
			Иначе
					
				// Реквизиты и ТЧ
				Подзапрос = Подзапрос + "
					|	(dbo.journ.uid IN (
					|		SELECT dbo.journ_rec.journ_uid FROM dbo.journ_rec LEFT JOIN dbo.props ON dbo.props.uid = dbo.journ_rec.prop_uid
					|		WHERE dbo.props.nametp = '" +  П.Получить("ИмяТЧ") + "' AND dbo.props.namerec = '" +  П.Получить("ИмяРеквизита") + "') AND
					|	(dbo.metadata.caption = '" + П.Получить("МетаданныеОбъекта") + "'))";
					
				ПодзапросИБ = ПодзапросИБ + "
					|	внКэшЖурналаРегистрации.Ссылка В(
					|		ВЫБРАТЬ Кэш.Ссылка ИЗ Справочник.Renault_внКэшЖурналаРегистрации.внИзменения КАК Кэш
                    |		ГДЕ Кэш.ИмяТЧ = """ +  П.Получить("ИмяТЧ") + """ И Кэш.ИмяРеквизита = """ +  П.Получить("ИмяРеквизита") + """ И Кэш.Ссылка.МетаданныеОбъекта = """ + П.Получить("МетаданныеОбъекта") + """
					|)";
					
			КонецЕсли;
				
			Если Индекс <> МассивПодписок.Количество() - 1 Тогда
				Подзапрос = Подзапрос + " OR ";
				ПодзапросИБ = ПодзапросИБ + " ИЛИ ";
			КонецЕсли;
			
		КонецЦикла;
		
		// В БД MS SQL
		Если Не ПустаяСтрока(Подзапрос) Тогда
			ТекстВЗапросе = ТекстВЗапросе + " AND (" + Подзапрос + ")";
		КонецЕсли;
		
		// В кэше
		Если Не ПустаяСтрока(ПодзапросИБ) Тогда
			ТекстВЗапросеИБ = ТекстВЗапросеИБ + " И (" + ПодзапросИБ + ")";
		КонецЕсли;
		
	КонецЕсли;
	
	// Установим отбор по пользователям
	Если ЗначениеЗаполнено(МассивПользователи) И МассивПользователи.Количество() > 0 Тогда		
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND (";                                    
		Для Индекс = 0 По МассивПользователи.Количество() - 1 Цикл 
			ТекстВЗапросе = ТекстВЗапросе + "
				|	dbo.journ.user_uid = " + ЧислоSQL(МассивПользователи[Индекс]);
				
			Если Индекс <> МассивПользователи.Количество() - 1 Тогда
				ТекстВЗапросе = ТекстВЗапросе + " OR ";
			КонецЕсли;				
		КонецЦикла;
		ТекстВЗапросе = ТекстВЗапросе + "
			|)";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			" И внКэшЖурналаРегистрации.Пользователь В (&МассивПользователей) ";
		Список = ПолучитьПользователейИстории();
		МассивВОтбор = Новый Массив();
		Для каждого Элемент Из Список Цикл 
			Если МассивПользователи.Найти(Элемент.Значение) <> Неопределено Тогда
				МассивВОтбор.Добавить(Элемент.Представление);
			КонецЕсли;			
		КонецЦикла;
		Запрос.УстановитьПараметр("МассивПользователей", МассивВОтбор);
	КонецЕсли;
	
	// Установим отбор по компьютерам
	Если ЗначениеЗаполнено(МассивКомпьютеры) И МассивКомпьютеры.Количество() > 0 Тогда
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND (";                                    
		Для Индекс = 0 По МассивКомпьютеры.Количество() - 1 Цикл 
			ТекстВЗапросе = ТекстВЗапросе + "
				|	dbo.journ.computer_uid = " + ЧислоSQL(МассивКомпьютеры[Индекс]);
				
			Если Индекс <> МассивКомпьютеры.Количество() - 1 Тогда
				ТекстВЗапросе = ТекстВЗапросе + " OR ";
			КонецЕсли;				
		КонецЦикла;
		ТекстВЗапросе = ТекстВЗапросе + "
			|)";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			" И внКэшЖурналаРегистрации.Компьютер В (&МассивКомпьютеров) ";
		Список = ПолучитьКомпьютерыИстории();
		МассивВОтбор = Новый Массив();
		Для каждого Элемент Из Список Цикл 
			Если МассивКомпьютеры.Найти(Элемент.Значение) <> Неопределено Тогда
				МассивВОтбор.Добавить(Элемент.Представление);
			КонецЕсли;			
		КонецЦикла;
		Запрос.УстановитьПараметр("МассивКомпьютеров", МассивВОтбор);
			
	КонецЕсли;
	
	// Установим отбор по РИБ
	Если ЗначениеЗаполнено(МассивУзловРИБ) И МассивУзловРИБ.Количество() > 0 Тогда
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND (";                                    
		Для Индекс = 0 По МассивУзловРИБ.Количество() - 1 Цикл 
			ТекстВЗапросе = ТекстВЗапросе + "
				|	dbo.journ.rib_uid = " + ЧислоSQL(МассивУзловРИБ[Индекс]);
				
			Если Индекс <> МассивУзловРИБ.Количество() - 1 Тогда
				ТекстВЗапросе = ТекстВЗапросе + " OR ";
			КонецЕсли;				
		КонецЦикла;
		ТекстВЗапросе = ТекстВЗапросе + "
			|)";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			" И внКэшЖурналаРегистрации.УзелРИБ В (&МассивУзловРИБ) ";
		Список = ПолучитьУзлыРИБИстории();
		МассивВОтбор = Новый Массив();
		Для каждого Элемент Из Список Цикл 
			Если МассивУзловРИБ.Найти(Элемент.Значение) <> Неопределено Тогда
				СсылкаНаУзел = Справочники.Renault_внУзлыРИБ.НайтиПоНаименованию(Элемент.Значение);
				Если СсылкаНаУзел <> Неопределено Тогда
					МассивВОтбор.Добавить(СсылкаНаУзел);
				КонецЕсли;
			КонецЕсли;			
		КонецЦикла;
		Запрос.УстановитьПараметр("МассивУзловРИБ", МассивВОтбор);
		
	КонецЕсли;	
	
	// Установим отбор по метаданным
	Если ЗначениеЗаполнено(МассивМетаданных) И МассивМетаданных.Количество() > 0 Тогда
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND (";                                    
		Для Индекс = 0 По МассивМетаданных.Количество() - 1 Цикл 
			ТекстВЗапросе = ТекстВЗапросе + "
				|	dbo.metadata.caption = '" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(МассивМетаданных[Индекс]) + "'";
				
			Если Индекс <> МассивМетаданных.Количество() - 1 Тогда
				ТекстВЗапросе = ТекстВЗапросе + " OR ";
			КонецЕсли;				
		КонецЦикла;
		ТекстВЗапросе = ТекстВЗапросе + "
			|)";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			"И внКэшЖурналаРегистрации.МетаданныеОбъекта В(&МетаданныеОбъекта)";
		Запрос.УстановитьПараметр("МетаданныеОбъекта", МассивМетаданных);
		
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			" И внКэшЖурналаРегистрации.МетаданныеОбъекта В (&МассивМетаданныеОбъекта) ";
		Запрос.УстановитьПараметр("МассивМетаданныеОбъекта", МассивМетаданных);
		
	КонецЕсли;
	
	// Установим отбор по объектам
	Если ЗначениеЗаполнено(МассивОбъектов) И МассивОбъектов.Количество() > 0 Тогда
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND (";                                    
		Для Индекс = 0 По МассивОбъектов.Количество() - 1 Цикл 
			ТекстВЗапросе = ТекстВЗапросе + "
				|	dbo.journ.object_guid = '" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(МассивОбъектов[Индекс]) + "'";
				
			Если Индекс <> МассивОбъектов.Количество() - 1 Тогда
				ТекстВЗапросе = ТекстВЗапросе + " OR ";
			КонецЕсли;				
		КонецЦикла;
		ТекстВЗапросе = ТекстВЗапросе + "
			|)";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			"И внКэшЖурналаРегистрации.ГУИДОбъекта В(&ГУИДОбъекта)";
		Запрос.УстановитьПараметр("ГУИДОбъекта", МассивОбъектов);			
	КонецЕсли;
	
	// Установим отбора по объектам ссылкам
	Если ЗначениеЗаполнено(МассивОбъектовСсылок) И МассивОбъектовСсылок.Количество() > 0 Тогда
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND (";                                    
		Для Индекс = 0 По МассивОбъектовСсылок.Количество() - 1 Цикл 
			ТекстВЗапросе = ТекстВЗапросе + "
				|	dbo.journ.object_guid = '" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(МассивОбъектовСсылок[Индекс]) + "' OR dbo.journ.uid IN (SELECT DISTINCT journ_uid FROM journ_rec WHERE (journ_rec.oldval = '" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(МассивОбъектовСсылок[Индекс]) + "' OR journ_rec.newval = '" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(МассивОбъектовСсылок[Индекс]) + "'))";
				
			Если Индекс <> МассивОбъектовСсылок.Количество() - 1 Тогда
				ТекстВЗапросе = ТекстВЗапросе + " OR ";
			КонецЕсли;				
		КонецЦикла;
		ТекстВЗапросе = ТекстВЗапросе + "
			|)";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			"И (внКэшЖурналаРегистрации.ГУИДОбъекта В(&ГУИДОбъекта) ИЛИ внКэшЖурналаРегистрации.Ссылка В
			|(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	внКэшЖурналаРегистрацииИзменения.Ссылка
			|ИЗ
			|	Справочник.Renault_внКэшЖурналаРегистрации.внИзменения КАК внКэшЖурналаРегистрацииИзменения
			|ГДЕ
			|	ПОДСТРОКА(внКэшЖурналаРегистрацииИзменения.Значение, 1, 300) В(&ГУИДОбъекта)))";
				
		Запрос.УстановитьПараметр("ГУИДОбъекта", МассивОбъектовСсылок);		
	КонецЕсли;
	
	// Установим отбор по событиям
	Если ЗначениеЗаполнено(МассивСобытий) И МассивСобытий.Количество() > 0 Тогда
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND (";                                    
		Для Индекс = 0 По МассивСобытий.Количество() - 1 Цикл 
			ТекстВЗапросе = ТекстВЗапросе + "
				|	dbo.events.uid = " + ЧислоSQL(МассивСобытий[Индекс]);
				
			Если Индекс <> МассивСобытий.Количество() - 1 Тогда
				ТекстВЗапросе = ТекстВЗапросе + " OR ";
			КонецЕсли;				
		КонецЦикла;
		ТекстВЗапросе = ТекстВЗапросе + "
			|)";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			"И внКэшЖурналаРегистрации.Событие В(&МассивСобытий)";
		Запрос.УстановитьПараметр("МассивСобытий", МассивСобытий);			
	КонецЕсли;
	
	// Установим отбор по представлению	
	Если НЕ ПустаяСтрока(Представление) Тогда
		ТекстВЗапросе = ТекстВЗапросе + "
			|	AND dbo.journ.caption LIKE '%" + ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(Представление) + "%'";
			
		ТекстВЗапросеИБ = ТекстВЗапросеИБ + 
			"И внКэшЖурналаРегистрации.ПредставлениеОбъекта ПОДОБНО &ПредставлениеОбъекта";
		Запрос.УстановитьПараметр("ПредставлениеОбъекта", "%" + СокрЛП(Представление) + "%");		
	КонецЕсли;
	
	// Здесь добавим результат, который будет выведен и показан пользователю
	ТаблицаРезультата = Новый ТаблицаЗначений;	
	ТаблицаРезультата.Колонки.Добавить("Код");
	МассивТиповУзловРИБ = Новый Массив;
	МассивТиповУзловРИБ.Добавить(Тип("Строка"));
	МассивТиповУзловРИБ.Добавить(Тип("СправочникСсылка.Renault_внУзлыРИБ"));
	ТипУзловРИБ = Новый ОписаниеТипов(МассивТиповУзловРИБ);
	ТаблицаРезультата.Колонки.Добавить("УзелРИБ", ТипУзловРИБ);
	ТаблицаРезультата.Колонки.Добавить("ДатаИзменения");
	ТаблицаРезультата.Колонки.Добавить("Объект");
	ТаблицаРезультата.Колонки.Добавить("МетаданныеОбъекта");
	ТаблицаРезультата.Колонки.Добавить("Пользователь");
	ТаблицаРезультата.Колонки.Добавить("Компьютер");
	ТаблицаРезультата.Колонки.Добавить("ВерсияИзменения");
	ТаблицаРезультата.Колонки.Добавить("ПредставлениеОбъекта");
	ТаблицаРезультата.Колонки.Добавить("Событие");
	ТаблицаРезультата.Колонки.Добавить("СобытиеПредставление");
	ТаблицаРезультата.Колонки.Добавить("Сжат");
	
	// Сначала добавляем данные по сжатым объектам в БД MS SQL Server
	внСоединение = ПолучитьСоединение();
	
	Если внСоединение <> Неопределено Тогда
		
		// Делаем запрос через MS SQL
		НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
		НаборЗаписей.CursorLocation = 2;
		ТекстЗапроса =
			"SELECT dbo.journ.uid, dbo.journ.datechange, dbo.journ.ver, dbo.journ.caption, dbo.computers.caption AS computer, dbo.users.caption AS userchange, 
			|	dbo.metadata.caption AS meta, dbo.events.caption AS event, dbo.journ.object_guid, dbo.events.uid AS eventuid, dbo.ribs.caption AS ribcaption
			|FROM         
			|	dbo.journ LEFT JOIN
			|	dbo.events ON dbo.journ.event_uid = dbo.events.uid LEFT JOIN
			|	dbo.metadata ON dbo.journ.meta_uid = dbo.metadata.uid LEFT JOIN
			|	dbo.users ON dbo.journ.user_uid = dbo.users.uid LEFT JOIN
			|	dbo.computers ON dbo.journ.computer_uid = dbo.computers.uid LEFT JOIN
			|	dbo.bases ON dbo.journ.base_uid = dbo.bases.uid LEFT JOIN
			|	dbo.ribs ON dbo.journ.rib_uid = dbo.ribs.uid
			|WHERE &ДОПОЛНИТЕЛЬНОЕУСЛОВИЕ
			|ORDER BY dbo.journ.uid";
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДОПОЛНИТЕЛЬНОЕУСЛОВИЕ", ТекстВЗапросе);
		
		// Соединяемся с SQL если нужно
		Ошибка = Ложь;
		СтрОшибки = "";
		Попытка
			НаборЗаписей.Open(ТекстЗапроса, внСоединение);		
		Исключение		
			Ошибка = Истина;
			СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
			Возврат ТаблицаРезультата;		
		КонецПопытки;	
			
		Пока НаборЗаписей.EOF = 0 Цикл
			НоваяСтрока 					= ТаблицаРезультата.Добавить();
			НоваяСтрока.Код 				= НаборЗаписей.Fields("uid").Value;
			НоваяСтрока.УзелРИБ		 		= НаборЗаписей.Fields("ribcaption").Value;
			НоваяСтрока.ДатаИзменения 		= НаборЗаписей.Fields("datechange").Value;
			НоваяСтрока.Объект 				= НаборЗаписей.Fields("object_guid").Value;			
			НоваяСтрока.Пользователь 		= НаборЗаписей.Fields("userchange").Value;
			НоваяСтрока.Компьютер 			= НаборЗаписей.Fields("computer").Value;
			НоваяСтрока.ВерсияИзменения 	= НаборЗаписей.Fields("ver").Value;
			НоваяСтрока.ПредставлениеОбъекта= НаборЗаписей.Fields("caption").Value;
			НоваяСтрока.Событие 			= НаборЗаписей.Fields("eventuid").Value;
			НоваяСтрока.СобытиеПредставление= НаборЗаписей.Fields("event").Value;
			НоваяСтрока.Сжат				= Истина;
			
			Если НоваяСтрока.Событие = 9 Тогда
				НоваяСтрока.МетаданныеОбъекта = "Сеанс начало";
			ИначеЕсли НоваяСтрока.Событие = 10 Тогда
				НоваяСтрока.МетаданныеОбъекта = "Сеанс окончание";
			Иначе
				НоваяСтрока.МетаданныеОбъекта 	= НаборЗаписей.Fields("meta").Value;
			КонецЕсли;			
			
			НаборЗаписей.MoveNext();
		КонецЦикла;
		
		НаборЗаписей.Close();		
		внСоединение.Close();
		
	КонецЕсли;
	
	// Получим представление и номер событий в журнале	
	События	= Новый Соответствие;
	События.Вставить(0,	"Начальное заполнение");
	События.Вставить(1,	"Создание");
	События.Вставить(2,	"Изменение");
	События.Вставить(3,	"Проведение");
	События.Вставить(4,	"Физическое удаление");
	События.Вставить(5,	"Установлена пометка на удаление");
	События.Вставить(6,	"Снята пометка на удаление");
	События.Вставить(7,	"Отмена проведения");
	События.Вставить(8,	"Запись");
	События.Вставить(9,	"Начало сеанса");
	События.Вставить(10,"Завершение сеанса");
	
	// Добавим не сжатые данные из кэша в журнал
	Запрос.Текст =
		"ВЫБРАТЬ
		|	внКэшЖурналаРегистрации.Код КАК Код,
		|	внКэшЖурналаРегистрации.УзелРИБ КАК УзелРИБ,
		|	внКэшЖурналаРегистрации.ДатаИзменения,
		|	внКэшЖурналаРегистрации.ГУИДОбъекта КАК Объект,
		|	ВЫБОР
		|		КОГДА внКэшЖурналаРегистрации.Событие = 9
		|			ТОГДА ""Начало сеанса""
		|		КОГДА внКэшЖурналаРегистрации.Событие = 10
		|			ТОГДА ""Завершение сеанса""
		|		ИНАЧЕ внКэшЖурналаРегистрации.МетаданныеОбъекта
		|	КОНЕЦ КАК МетаданныеОбъекта,
		|	внКэшЖурналаРегистрации.Пользователь,
		|	внКэшЖурналаРегистрации.Компьютер,
		|	внКэшЖурналаРегистрации.ПредставлениеОбъекта,
		|	внКэшЖурналаРегистрации.Событие,
		|	Ложь КАК Сжат
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК внКэшЖурналаРегистрации
		|ГДЕ
		|	внКэшЖурналаРегистрации.Часть = 0
		|	И &ДОПОЛНИТЕЛЬНОЕУСЛОВИЕ
		|
		|УПОРЯДОЧИТЬ ПО
		|	внКэшЖурналаРегистрации.ДатаИзменения,
		|	Код";
		
	Запрос.Текст	= СтрЗаменить(Запрос.Текст, "&ДОПОЛНИТЕЛЬНОЕУСЛОВИЕ", ТекстВЗапросеИБ);
	Выборка			= Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока						= ТаблицаРезультата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);		
		НоваяСтрока.СобытиеПредставление= События.Получить(НоваяСтрока.Событие);
		
	КонецЦикла;
	
	Возврат ТаблицаРезультата;	
	
КонецФункции // ПолучитьИсториюИзменений

// Получаем uid компютера в БД SQL Server
Функция ПолучитьИДКомпьютера(внСоединение, ИдентификаторИБСтрокойВБД, ИмяКомпьютераТекст)
	
	УИД = 0;	
	RecordSet 					= Новый COMОбъект("ADODB.Recordset");
	Recordset.CursorLocation 	= 3;
	Recordset.LockType 		 	= 2;
	RecordSet.ActiveConnection 	= внСоединение;
	
	Компьютер = ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(ИмяКомпьютераТекст);
	
	ТекстЗапроса = "select uid from computers where upper(caption) = upper('" + Компьютер + "') and base_uid = " + ИдентификаторИБСтрокойВБД;
	RecordSet.Open(ТекстЗапроса);
	
	Если RecordSet.RecordCount <> 0 Тогда  
		УИД = RecordSet.Fields("uid").Value;
	Иначе 
		RecordSet.Close();

		ТекстЗапроса = "INSERT INTO computers (caption, base_uid) OUTPUT INSERTED.uid VALUES ('" + Компьютер + "', " + ИдентификаторИБСтрокойВБД + ")";
		RecordSet.Open(ТекстЗапроса);
		
		УИД = RecordSet.Fields("uid").Value;
	КонецЕсли;
	
	RecordSet.Close();
	
	Возврат УИД;
	
КонецФункции // ПолучитьИДКомпьютера

// Получаем uid пользователя в БД SQL Server
Функция ПолучитьИДПользователя(внСоединение, ИдентификаторИБСтрокойВБД, ПользовательТекст)
	
	УИД = 0;
	RecordSet 					= Новый COMОбъект("ADODB.Recordset");
	Recordset.CursorLocation 	= 3;
	Recordset.LockType 		 	= 2;
	RecordSet.ActiveConnection 	= внСоединение;
	
	Пользователь = ЗаменитьЗапрещенныеСимволыВТекстеЗапроса(ПользовательТекст);
	
	ТекстЗапроса = "select uid from users where upper(caption) = upper('" + Пользователь + "') and base_uid = " + ИдентификаторИБСтрокойВБД;
	RecordSet.Open(ТекстЗапроса);
	
	Если RecordSet.RecordCount <> 0 Тогда  
		УИД = RecordSet.Fields("uid").Value;
	Иначе 
		RecordSet.Close();
		
		ТекстЗапроса = "INSERT INTO users (caption, base_uid) OUTPUT INSERTED.uid VALUES ('" + Пользователь + "', " + ИдентификаторИБСтрокойВБД + ")";
		RecordSet.Open(ТекстЗапроса);
				
		УИД = RecordSet.Fields("uid").Value;
	КонецЕсли;
	
	RecordSet.Close();
	
	Возврат УИД;
	
КонецФункции // ПолучитьИДПользователя

// Получаем uid объекта метаданных в БД SQL Server
Функция ПолучитьИДМетаданных(внСоединение, ИдентификаторИБСтрокойВБД, ИмяОбъектаМетаданных)
	
	УИД = 0;
	RecordSet = Новый COMОбъект("ADODB.Recordset");
	RecordSet.ActiveConnection = внСоединение;
	
	ТекстЗапроса = "select uid from metadata where upper(caption) = upper('" + ИмяОбъектаМетаданных + "') and base_uid = " + ИдентификаторИБСтрокойВБД;
	RecordSet.Open(ТекстЗапроса);
	
	Если RecordSet.RecordCount <> 0 Тогда  
		УИД = RecordSet.Fields("uid").Value;
	Иначе 
		RecordSet.Close();
		
		ТекстЗапроса = "INSERT INTO metadata (caption, type_uid, base_uid) OUTPUT INSERTED.uid VALUES ('" + ИмяОбъектаМетаданных + "','" + ПолучитьТипОбъектаПоИмени(ИмяОбъектаМетаданных) + "', " + ИдентификаторИБСтрокойВБД + ")";
		RecordSet.Open(ТекстЗапроса);
		
		УИД = RecordSet.Fields("uid").Value;
	КонецЕсли;
	
	RecordSet.Close();
	
	Возврат УИД;
	
КонецФункции // ПолучитьИДМетаданных

