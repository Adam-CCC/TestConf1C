// Получает текст запроса создания БД MS SQL журнала для ручного создания БД
Функция ПолучитьТекстЗапросаСозданияБД(ИмяВнешнейИБ) Экспорт
	
	Макет = Обработки.Renault_внНастройкаЖурналаРегистрации.ПолучитьМакет("МакетСозданияБД_MSSQL");
	Текст = Макет.ПолучитьТекст();
	
	Если НЕ ПустаяСтрока(ИмяВнешнейИБ) Тогда
		// Заменяем [History] на нашу БД
		Текст = СтрЗаменить(Текст, "[History]", СокрЛП(ИмяВнешнейИБ));
		Текст = СтрЗаменить(Текст, "'History'", "'" + СокрЛП(ИмяВнешнейИБ) + "'");		
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции // ПолучитьТекстЗапросаСозданияБД

// Очистка всей истории изменений удаленной базы и локального кэша
Функция ОчиститьЖурналРегистрацииПолностью() Экспорт
	
	// Проверка, что база РИБ и попытка запустить сжатие в базе с полным типом обмена
	// запрещено запускать сжатие в дочерней базе РИБ
	Если Renault_внОбщийМодульПовтИсп.ТипОбменаРИБПолный() И ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Информация, , "Запуск в дочерней базе РИБ, очистка не может быть выполнена");
		Возврат Ложь;		
	КонецЕсли;
	
	// Удаляем из базы
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	внКэшЖурналаРегистрации.Ссылка
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК внКэшЖурналаРегистрации
		|
		|УПОРЯДОЧИТЬ ПО
		|	внКэшЖурналаРегистрации.Код"
	);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.Удалить();
	КонецЦикла;
	
	// Удаляем из SQL Server	
	внСоединение = ПолучитьСоединение();
	Если внСоединение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИдентификаторИБ				= ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ());
	
	НаборЗаписей				= Новый COMОбъект("ADODB.Recordset");
	НаборЗаписей.CursorLocation	= 2;
	НаборЗаписей.LockType		= 3;
	
	// Начинаем транзакцию
	Попытка
		внСоединение.BeginTrans();		
	Исключение		
		СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
		Возврат Ложь;		
	КонецПопытки;	
	
	Попытка                                           
				
		НаборЗаписей.Open("DELETE FROM journ_rec WHERE journ_rec.journ_uid in (SELECT uid FROM journ WHERE journ.base_uid = " + ИдентификаторИБ + ")", внСоединение);
		НаборЗаписей.Open("DELETE FROM journ WHERE journ.base_uid = " + ИдентификаторИБ, внСоединение);
		НаборЗаписей.Open("DELETE FROM props WHERE props.meta_uid IN (SELECT uid FROM metadata WHERE metadata.base_uid = " + ИдентификаторИБ + ")", внСоединение);
		НаборЗаписей.Open("DELETE FROM metadata WHERE metadata.base_uid = " + ИдентификаторИБ, внСоединение);
		НаборЗаписей.Open("DELETE FROM users WHERE users.base_uid = " + ИдентификаторИБ, внСоединение);
		НаборЗаписей.Open("DELETE FROM computers WHERE computers.base_uid = " + ИдентификаторИБ, внСоединение);
		НаборЗаписей.Open("DELETE FROM ribs WHERE ribs.base_uid = " + ИдентификаторИБ, внСоединение);
		НаборЗаписей.Open("DELETE FROM bases WHERE uid = " + ИдентификаторИБ, внСоединение);
			
		внСоединение.CommitTrans();
		
		ОбновитьПовторноИспользуемыеЗначения();
		
	Исключение
		
		внСоединение.RollbackTrans();
		СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
		Возврат Ложь;
		
	КонецПопытки;
	
	внСоединение.Close();
	
	Возврат Истина;
	
КонецФункции // ОчиститьЖурналРегистрацииПолностью

// Очистка истории изменений удаленной базы на указанную дату
Функция ОчиститьЖурналРегистрацииНаДату(Оповещать = Ложь, ДатаОчистки) Экспорт
	
	Если НЕ Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ВеренПараметрУникальности") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Если дата пустая, значит очиска всей БД
	Если ДатаОчистки = Дата(1, 1, 1) Тогда
		Возврат ОчиститьЖурналРегистрацииПолностью();
	КонецЕсли;
	
	внСоединение = ПолучитьСоединение();
	Если внСоединение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИдентификаторИБ			= ЧислоSQL(Renault_внОбщийМодульПовтИсп.ПолучитьUIDИдентификаторИБ());
	ДатаУстановкиОбъектов	= ДатаОчистки;
	
	Попытка		
        //====================================================================
		// Тут выбираем всю историю		
		НаборЗаписейДоп = Новый COMОбъект("ADODB.Recordset");
	
		// Удалим все входы и выходы пользователей
		ТекстЗапроса = 
			"DELETE FROM journ
			|WHERE (journ.datechange <= CONVERT(datetime, '" + ДатаВремяSQL(ДатаОчистки) + "', 20)) and (journ.event_uid = 9 or journ.event_uid = 10) and (journ.base_uid = " + ИдентификаторИБ + ")";
		// Соединяемся с SQL если нужно
		Ошибка = Ложь;
		СтрОшибки = "";
		Попытка
			НаборЗаписейДоп.Open(ТекстЗапроса, внСоединение);
		Исключение		
			Ошибка = Истина;
			СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
			Возврат Ложь;
		КонецПопытки;			
		
		НаборЗаписей = Новый COMОбъект("ADODB.Recordset");
		// Остались объекты, которые необходимо сжать выберем все различные объекты у которых object_guid одинаковый
		ТекстЗапроса = 
			"SELECT journ.object_guid, COUNT(*) as counter
			|FROM journ
			|WHERE (journ.datechange <= CONVERT(datetime, '" + ДатаВремяSQL(ДатаОчистки) + "', 20)) and (journ.base_uid = " + ИдентификаторИБ + ")
			|GROUP BY journ.object_guid";
			
		// Соединяемся с SQL если нужно
		Ошибка = Ложь;
		СтрОшибки = "";
		Попытка
			НаборЗаписей.Open(ТекстЗапроса, внСоединение);
		Исключение		
			Ошибка = Истина;
			СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
			Возврат Ложь;
		КонецПопытки;	
		
		// Узнаем сколько всего записей для обработки
		Если Оповещать Тогда
			ОбщееКоличествоЭлементов = НаборЗаписей.RecordCount();
			
			// Периодичность с которой вызывается индикация (каждые 0.5%)
			ШагОповещения = Окр(ОбщееКоличествоЭлементов / 200); 
			Если ШагОповещения = 0 Тогда
				ШагОповещения = 1;
			КонецЕсли;
			
			ДатаНачалаОчистки = ТекущаяДата();
			Структура = Новый Структура;
			Структура.Вставить("ОбщееКоличествоЭлементов", ОбщееКоличествоЭлементов);
			Структура.Вставить("ДатаНачалаОчистки", ДатаНачалаОчистки);
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Оповестить("внУстановитьМаксимумПрогрессаОчистки", Структура);			
			#КонецЕсли
		КонецЕсли;
		
		//====================================================================
		ОбразОбъекта = Новый ТаблицаЗначений;
		ОбразОбъекта.Колонки.Добавить("НомерСтроки");
		ОбразОбъекта.Колонки.Добавить("ИмяТЧ");
		ОбразОбъекта.Колонки.Добавить("ИмяРеквизита");
		ОбразОбъекта.Колонки.Добавить("НомерСтрокиТЧ");
		ОбразОбъекта.Колонки.Добавить("ЗначениеСтарое");
		ОбразОбъекта.Колонки.Добавить("ЗначениеНовое");
		ОбразОбъекта.Колонки.Добавить("ПредставлениеСтарое");
		ОбразОбъекта.Колонки.Добавить("ПредставлениеНовое");
		ОбразОбъекта.Колонки.Добавить("ТипРеквизита");
		ОбразОбъекта.Индексы.Добавить("ИмяТЧ,ИмяРеквизита,НомерСтрокиТЧ"); // добавим индексы для быстроты поиска
		
		НаборЗаписейИзменения					= Новый COMОбъект("ADODB.Recordset");
		НаборЗаписейИзменения.CursorLocation	= 2;
		НаборЗаписейИзменения.LockType			= 3;
				
		ТаблицаИзменений = Новый ТаблицаЗначений;		
		КоличествоОбработанных = 0;
		
		ТекущаяСтрока = 1;
		Пока НаборЗаписей.EOF = 0 Цикл
			
			// Собираем историю по GUID
			ГУИД = Строка(НаборЗаписей.Fields("object_guid").Value);
			UID = -1;
			
			// Получаем образ объекта
			// Для остальных объектов
			ТекстЗапроса = 
				"SELECT journ_rec.*, journ.uid, props.nametp, props.namerec
				|FROM 
				|	journ_rec LEFT JOIN journ ON journ_rec.journ_uid = journ.uid LEFT JOIN props ON journ_rec.prop_uid = props.uid
				|WHERE (journ.datechange <= '" + ДатаВремяSQL(ДатаОчистки) + "') AND (journ.object_guid = '" + ГУИД + "')  and (journ.base_uid = " + ИдентификаторИБ + ")
				|ORDER BY journ_rec.journ_uid, props.nametp, props.namerec"
			;
			НаборЗаписейИзменения.Open(ТекстЗапроса, внСоединение);
			
			//
			ТаблицаИзменений.Очистить();
			ТаблицаИзменений = ОбразОбъекта.СкопироватьКолонки(); // тут пустая таблица изменений
			ТаблицаИзменений.Индексы.Добавить("ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ"); // добавим индексы для быстроты поиска

			СтруктураПоиска = Новый Структура("ИмяТЧ, ИмяРеквизита, НомерСтрокиТЧ");
			Пока НаборЗаписейИзменения.EOF = 0 Цикл
				СтруктураПоиска.ИмяТЧ				= НаборЗаписейИзменения.Fields("nametp").Value;		
				СтруктураПоиска.ИмяРеквизита		= НаборЗаписейИзменения.Fields("namerec").Value;
				СтруктураПоиска.НомерСтрокиТЧ		= НаборЗаписейИзменения.Fields("numtp").Value;		
				Массив 								= ТаблицаИзменений.НайтиСтроки(СтруктураПоиска);
				
				Если Массив.Количество() = 0 Тогда
					Массив.Добавить(ТаблицаИзменений.Добавить());			
					Массив[0].ИмяТЧ					= НаборЗаписейИзменения.Fields("nametp").Value;
					Массив[0].ИмяРеквизита			= НаборЗаписейИзменения.Fields("namerec").Value;
					Массив[0].НомерСтрокиТЧ			= НаборЗаписейИзменения.Fields("numtp").Value;
					Массив[0].ЗначениеСтарое		= НаборЗаписейИзменения.Fields("oldval").Value;
					Массив[0].ЗначениеНовое			= НаборЗаписейИзменения.Fields("newval").Value;
					Массив[0].ПредставлениеСтарое	= НаборЗаписейИзменения.Fields("oldview").Value;
					Массив[0].ПредставлениеНовое	= НаборЗаписейИзменения.Fields("newview").Value;
					Массив[0].ТипРеквизита			= НаборЗаписейИзменения.Fields("typerec").Value;
				Иначе			
					Массив[0].ЗначениеСтарое		= Массив[0].ЗначениеНовое;
					Массив[0].ПредставлениеСтарое	= Массив[0].ПредставлениеНовое;
					Массив[0].ЗначениеНовое			= НаборЗаписейИзменения.Fields("newval").Value;
					Массив[0].ПредставлениеНовое	= НаборЗаписейИзменения.Fields("newview").Value;			
				КонецЕсли;
				
				Если Число(НаборЗаписейИзменения.Fields("uid").Value) > UID Тогда
					UID = Число(НаборЗаписейИзменения.Fields("uid").Value);
				КонецЕсли;
				
				НаборЗаписейИзменения.MoveNext();
			КонецЦикла;
			НаборЗаписейИзменения.Close();			
			
			//***********************************************
			// ЗАПИСЫВАЕМ
			
			// Начинаем транзакцию
			Попытка
				
				внСоединение.BeginTrans();
				
			Исключение
				
				СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
				Возврат Ложь;
				
			КонецПопытки;
			
			Попытка
				
				// Удаляем предыдущие версии
				НаборЗаписейИзменения.Open(
					"DELETE FROM journ_rec
					|WHERE journ_rec.journ_uid in (SELECT uid FROM journ WHERE (journ.datechange <= CONVERT(datetime, '" + ДатаВремяSQL(ДатаОчистки) + "', 20)) and
					|(journ.object_guid = '" + ГУИД + "') and (journ.base_uid = " + ИдентификаторИБ + "))",
					внСоединение);
				
				НаборЗаписейИзменения.Open(
					"DELETE FROM journ
					|WHERE (journ.uid <> " + ЧислоSQL(UID) + ") and
					|(journ.datechange <= CONVERT(datetime, '" + ДатаВремяSQL(ДатаОчистки) + "', 20)) and
					|(journ.object_guid = '" + ГУИД + "') and
					|(journ.base_uid = " + ИдентификаторИБ + ")",
				внСоединение);
				
				НаборЗаписейИзменения.Open(
					"UPDATE journ SET
					| journ.datechange = CONVERT(datetime, '" + ДатаВремяSQL(ДатаУстановкиОбъектов) + "', 20),
					| journ.event_uid = 0
					|WHERE (dbo.journ.datechange <= CONVERT(datetime, '" + ДатаВремяSQL(ДатаОчистки) + "', 20)) and 
					|(journ.uid = " + ЧислоSQL(UID) + ") and (journ.base_uid = " + ИдентификаторИБ + ")",
				внСоединение);
				
				НаборЗаписейИзменения.Open("journ_rec", внСоединение);
				Для каждого Строки Из ТаблицаИзменений Цикл
					НаборЗаписейИзменения.AddNew();
					НаборЗаписейИзменения.Fields("journ_uid").Value 		= UID;
					Если НЕ ПустаяСтрока(Строки.ИмяТЧ) Тогда
						НаборЗаписейИзменения.Fields("nametp").Value		= Строки.ИмяТЧ;
						НаборЗаписейИзменения.Fields("numtp").Value 		= Строки.НомерСтрокиТЧ;
					КонецЕсли;
					НаборЗаписейИзменения.Fields("namerec").Value 			= Строки.ИмяРеквизита;
					НаборЗаписейИзменения.Fields("typerec").Value 			= Строки.ТипРеквизита;				
					
					Если НЕ ПустаяСтрока(Строки.ПредставлениеНовое) Тогда
						НаборЗаписейИзменения.Fields("newview").Value 		= Строки.ПредставлениеНовое;
					КонецЕсли;
					Если НЕ ПустаяСтрока(Строки.ЗначениеНовое) Тогда
						НаборЗаписейИзменения.Fields("newval").Value 	    = Строки.ЗначениеНовое;
					КонецЕсли;
					НаборЗаписейИзменения.Update();					
				КонецЦикла;
				НаборЗаписейИзменения.Close();
				
				внСоединение.CommitTrans();
				
			Исключение
				
				внСоединение.RollbackTrans();
				СтрОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, СтрОшибки);
				Возврат Ложь;
				
			КонецПопытки;	
			
			// Оповещаем в обычных формах
			Если Оповещать Тогда
				#Если ТолстыйКлиентОбычноеПриложение Тогда
					Если КоличествоОбработанных % ШагОповещения = 0 Тогда
						Структура										= Новый Структура;
						Структура.Вставить("КоличествоОбработанных", 	КоличествоОбработанных);
						Структура.Вставить("ТекущаяДатаНаСервере", 		ТекущаяДата());
						Оповестить("внПрогрессОчистки", 				Структура);
					КонецЕсли;
				#КонецЕсли
				КоличествоОбработанных = КоличествоОбработанных + 1;
			КонецЕсли;
			
			НаборЗаписей.MoveNext();
		КонецЦикла;
		
		НаборЗаписей.Close();
		внСоединение.Close();
		
		Результат = Истина;
		
	Исключение
		
		Результат = Ложь;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ОчиститьЖурналРегистрацииНаДату

// Проверяет необходимо ли фиксировать изменения объекта или нет при обмене данных
Функция ПолучитьУзелРИБ(Объект = Неопределено)

	Если Объект <> Неопределено 
		И Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ТипОбменаРИБ") = Перечисления.Renault_внТипОбменаРИБ.УпрощенныйОбмен 
		И Найти(Объект.Метаданные().ПолноеИмя(), "ПланОбмена.") <> 1 Тогда
		
		// Это обмен?
		Если Объект.ОбменДанными.Загрузка Тогда
			Отправитель = Объект.ОбменДанными.Отправитель;
			Если Отправитель <> Неопределено И Отправитель.Метаданные().РаспределеннаяИнформационнаяБаза Тогда
				
				// Это РИБ и запущена процедуры получения данных из дочерней или родительской базы
				Возврат Renault_внОбщийМодульПовтИсп.ПолучитьУзелРИБПоОтправителю(Отправитель);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ТекущийУзелРИБ");
	
КонецФункции // ПолучитьУзелРИБ

// Проверка нужно ли регистрировать событие в РИБ
Функция ЭтоПолныйОбменВРИБ(Объект) Экспорт
	
	Если Renault_внОбщийМодульПовтИсп.ТипОбменаРИБПолный() И Найти(Объект.Метаданные().ПолноеИмя(), "ПланОбмена.") <> 1 Тогда
		
		// Это обмен?
		Если Объект.ОбменДанными.Загрузка Тогда
			Отправитель = Объект.ОбменДанными.Отправитель;
			Если Отправитель <> Неопределено И Отправитель.Метаданные().РаспределеннаяИнформационнаяБаза Тогда
				
				// Это РИБ и запущена процедуры получения данных из дочерней или родительской базы
				// В таком случае не регистрируем изменения, они будут загружены автоматически из другой базы
				Возврат Истина;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции // ПроверитьОбменВРИБ 

// Возвращает на клиент имя компьютера на сервере
Функция ИмяКомпьютераНаСервере() Экспорт
	
	Возврат ИмяКомпьютера();
	
КонецФункции // ИмяКомпьютераНаСервере

// Фукнция возвращает системное представление объекта.
// Если передана ссылка, возвращает вместо номера таблицы 0 (фикс при РИБ)
// Т.е. строку вида:
// {"#",4dcc257a-be68-4de0-bad6-a7dc42232078,135:8269998f2df8084a11e421234b28682d}
// Преобразует в:
// {"#",4dcc257a-be68-4de0-bad6-a7dc42232078,0:8269998f2df8084a11e421234b28682d}
Функция СистемноеПредставлениеОбъекта(Объект) Экспорт
	
	Значение = ЗначениеВСтрокуВнутр(Объект);	
	Возврат ?(Лев(Значение, 5) = "{""#"",", Лев(Значение, 42) + "0" + Сред(Значение, Найти(Значение, ":")), Значение);
	
КонецФункции // СистемноеПредставлениеОбъекта()

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕСС РЕГИСТРАЦИИ ИЗМЕНЕНИЙ В КЭШЕ

// Процедура фиксирует текущее состояние объекта и записывает в справочник внКэшЖурналаРегистрации
Процедура РегистрацияИзмененияОбъекта(Объект, НачальноеЗаполнение =  Ложь)

	ОбъектМетаданные 	= Объект.Метаданные();
	ПолноеИмя			= ОбъектМетаданные.ПолноеИмя();
	
	// Объект конфигурации принадлежащий журналу (изменения в нем не надо регистрировать)
	Массив = МассивПредопределенныхНеРегистрируемыхОбъектов();
	Если Массив.Найти(ПолноеИмя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим необходимо ли регистрировать объект	полностью
	НеРегистрируемое = Renault_внОбщийМодульПовтИсп.НеРегистрируемыеОбъектыМетаданных(ПолноеИмя);	
	Если НеРегистрируемое.Количество() = 1 Тогда
		// В настройках указано, что бы НЕ регистрировались изменения объекта
		Если ПустаяСтрока(НеРегистрируемое[0].ИмяТЧ) И ПустаяСтрока(НеРегистрируемое[0].ИмяРеквизита) Тогда
			Возврат;
		КонецЕсли;		
	КонецЕсли;	 
	РегистрироватьПоРеквизитам	= НеРегистрируемое.Количество() > 0;
		
	ОбъектИмя 			= ОбъектМетаданные.Имя;
	ТипОбъекта			= ПолучитьТипОбъектаПоИмени(ПолноеИмя);
	РеквизитыСобытие	= -1;
	
	// Таблица, в которую будем записывать все реквизиты
	ИзмененияТЧ			= Новый ТаблицаЗначений;
	ИзмененияТЧ.Колонки.Добавить("ИмяРеквизита",	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	ИзмененияТЧ.Колонки.Добавить("ИмяТЧ",			Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));	
	ИзмененияТЧ.Колонки.Добавить("НомерСтрокиТЧ",	Новый ОписаниеТипов("Число"));
	ИзмененияТЧ.Колонки.Добавить("ТипРеквизита",	Новый ОписаниеТипов("Число"));	
	ИзмененияТЧ.Колонки.Добавить("Представление",	Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(300, ДопустимаяДлина.Переменная)));
	ИзмененияТЧ.Колонки.Добавить("Значение",		Новый ОписаниеТипов("Строка"));

	
	Если ТипОбъекта = 4 Тогда
		
		// У константы нет реквизитов, поэтому сразу добавляем изменения
		// Добавляем
		НоваяЗаписьТаблицы					= ИзмененияТЧ.Добавить();
		НоваяЗаписьТаблицы.ИмяРеквизита		= ОбъектИмя;
		НоваяЗаписьТаблицы.Значение			= СистемноеПредставлениеОбъекта(Объект.Значение);
		НоваяЗаписьТаблицы.Представление	= Строка(Объект.Значение);
		НоваяЗаписьТаблицы.ТипРеквизита		= 0;

	ИначеЕсли ТипОбъекта = 10 Тогда
		
		// Для регистра сведений свой механизм		
		// Список реквизитов, измерений и ресурсов
		
		ТаблицаРеквизитов = Новый ТаблицаЗначений;
		ТаблицаРеквизитов.Колонки.Добавить("ИмяРеквизита");
		ТаблицаРеквизитов.Колонки.Добавить("ТипРеквизита");

		Для каждого Реквизит Из ОбъектМетаданные.СтандартныеРеквизиты Цикл
			
			// Пропускаем регистрацию изменений для не регистрируемых реквизитов
			Если РегистрироватьПоРеквизитам Тогда
				ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", "", Реквизит.Имя);
				НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
				Если НайденныеСтроки.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока 				= ТаблицаРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита 	= Реквизит.Имя;
			НоваяСтрока.ТипРеквизита 	= 5;
		КонецЦикла;
		
		Для каждого Реквизит Из ОбъектМетаданные.Измерения Цикл
			// Пропускаем регистрацию изменений для не регистрируемых реквизитов
			Если РегистрироватьПоРеквизитам Тогда
				ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", "", Реквизит.Имя);
				НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
				Если НайденныеСтроки.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока 				= ТаблицаРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита 	= Реквизит.Имя;
			НоваяСтрока.ТипРеквизита 	= 3;
		КонецЦикла;
				
		Для каждого Реквизит Из ОбъектМетаданные.Ресурсы Цикл
			
			// Пропускаем регистрацию изменений для не регистрируемых реквизитов
			Если РегистрироватьПоРеквизитам Тогда
				ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", "", Реквизит.Имя);
				НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
				Если НайденныеСтроки.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока 				= ТаблицаРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита 	= Реквизит.Имя;
			НоваяСтрока.ТипРеквизита 	= 4;
		КонецЦикла;	
		
		Для каждого Реквизит Из ОбъектМетаданные.Реквизиты Цикл
			
			// Пропускаем регистрацию изменений для не регистрируемых реквизитов			
			Если РегистрироватьПоРеквизитам Тогда
				ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", "", Реквизит.Имя);
				НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
				Если НайденныеСтроки.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока 				= ТаблицаРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита 	= Реквизит.Имя;
			НоваяСтрока.ТипРеквизита 	= 1;
		КонецЦикла;		
		
		// То, что есть при записи
		Если Объект.Количество() > 0 Тогда
			
			// Записываемые данные
			НомерСтроки = 1; 
			Для каждого Запись Из Объект Цикл				
				Для Каждого Реквизит Из ТаблицаРеквизитов Цикл
					
					// Добавляем
					НоваяЗаписьТаблицы						= ИзмененияТЧ.Добавить();
					НоваяЗаписьТаблицы.ИмяТЧ				= "Записи";
					НоваяЗаписьТаблицы.ИмяРеквизита			= Реквизит.ИмяРеквизита;
					НоваяЗаписьТаблицы.НомерСтрокиТЧ		= НомерСтроки;						
					НоваяЗаписьТаблицы.Значение				= СистемноеПредставлениеОбъекта(Запись[Реквизит.ИмяРеквизита]);
					НоваяЗаписьТаблицы.Представление		= Строка(Запись[Реквизит.ИмяРеквизита]);
					НоваяЗаписьТаблицы.ТипРеквизита			= Реквизит.ТипРеквизита;
					
				КонецЦикла;
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
			
		Иначе
			// Очистка по отбору
			Если Объект.ДополнительныеСвойства.Свойство("внРегистрСведенийЗаписью") Тогда
				НомерСтроки = 1;
				Для каждого Запись Из Объект.ДополнительныеСвойства.внРегистрСведенийЗаписью Цикл
					Для Каждого Реквизит Из ТаблицаРеквизитов Цикл
						
						// Добавляем
						НоваяЗаписьТаблицы					= ИзмененияТЧ.Добавить();
						НоваяЗаписьТаблицы.ИмяТЧ			= "Записи";
						НоваяЗаписьТаблицы.ИмяРеквизита		= Реквизит.ИмяРеквизита;
						НоваяЗаписьТаблицы.НомерСтрокиТЧ	= НомерСтроки;						
						НоваяЗаписьТаблицы.Значение			= СистемноеПредставлениеОбъекта(Запись[Реквизит.ИмяРеквизита]);
						НоваяЗаписьТаблицы.Представление	= Строка(Запись[Реквизит.ИмяРеквизита]);
						НоваяЗаписьТаблицы.ТипРеквизита		= Реквизит.ТипРеквизита;
						
					КонецЦикла;					
					НомерСтроки = НомерСтроки + 1;
				КонецЦикла;			
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		// Добавляем все реквизиты объекта
		Реквизиты = ПолучитьРеквизитыОбъекта(ОбъектМетаданные, ТипОбъекта, Объект);
		Для каждого Реквизит Из Реквизиты Цикл
			
			РеквизитИмя = Реквизит.Значение;
			
			// Пропускаем регистрацию изменений для не регистрируемых реквизитов
			Если РегистрироватьПоРеквизитам Тогда
				ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", "", РеквизитИмя);
				НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
				Если НайденныеСтроки.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			// Добавляем
			Попытка
				ЗначениеРеквизита					= СистемноеПредставлениеОбъекта(Объект[РеквизитИмя]);
			Исключение
				Продолжить;
			КонецПопытки;
			НоваяЗаписьТаблицы						= ИзмененияТЧ.Добавить();
			НоваяЗаписьТаблицы.ИмяРеквизита			= РеквизитИмя;
			НоваяЗаписьТаблицы.Значение				= ЗначениеРеквизита;
			НоваяЗаписьТаблицы.Представление		= Строка(Объект[РеквизитИмя]);
			НоваяЗаписьТаблицы.ТипРеквизита			= 0;
			
		КонецЦикла;
				
		// Проведение
		Если ТипОбъекта = 1 И Объект.ДополнительныеСвойства.Свойство("внПроведен") Тогда
			Если Объект.Проведен <> Объект.ДополнительныеСвойства.внПроведен Тогда
				РеквизитыСобытие = ?(Объект.Проведен, 3, 7);
			КонецЕсли;
		КонецЕсли;
		
		// Пометка удаления
		Если Объект.ДополнительныеСвойства.Свойство("внПометкаУдаления") Тогда
			Если Объект.ПометкаУдаления <> Объект.ДополнительныеСвойства.внПометкаУдаления Тогда
				РеквизитыСобытие = ?(Объект.ПометкаУдаления, 5, 6);
			КонецЕсли;
		КонецЕсли;
		
		//=========================================
		// Для табличных частей                  //
		//========================================
		// По каждой ТЧ
		
		Для Каждого Таблица Из ОбъектМетаданные.ТабличныеЧасти Цикл
			
			ТаблицаРеквизиты	= Таблица.Реквизиты;
			ТаблицаИмя			= Таблица.Имя;
			
			// Пропускаем регистрацию изменений для не регистрируемых ТЧ
			Если РегистрироватьПоРеквизитам Тогда
				ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", ТаблицаИмя, "");
				НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
				Если НайденныеСтроки.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ТаблицаНовая		= Объект[ТаблицаИмя];
			// По каждому реквизиту в строке ТЧ
			Для Каждого Реквизит Из ТаблицаРеквизиты Цикл
				
				РеквизитИмя = Реквизит.Имя;
				
				// Пропускаем регистрацию изменений для не регистрируемых реквизитов
				Если РегистрироватьПоРеквизитам Тогда
					ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", ТаблицаИмя, РеквизитИмя);
					НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество() > 0 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				// По каждой строке ТЧ
				Для Каждого Строки Из ТаблицаНовая Цикл
					
					// Добавляем
					НоваяЗаписьТаблицы					= ИзмененияТЧ.Добавить();
					НоваяЗаписьТаблицы.ИмяРеквизита		= РеквизитИмя;
					НоваяЗаписьТаблицы.ИмяТЧ			= ТаблицаИмя;
					НоваяЗаписьТаблицы.НомерСтрокиТЧ	= Строки.НомерСтроки;
					НоваяЗаписьТаблицы.Значение			= СистемноеПредставлениеОбъекта(Строки[РеквизитИмя]);
					НоваяЗаписьТаблицы.Представление	= Строка(Строки[РеквизитИмя]);
					НоваяЗаписьТаблицы.ТипРеквизита		= 2;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		//=========================================
		// Для предопределенных табличных частей //
		//=========================================
		Если ТипОбъекта = 5 Тогда
						
			// Планы счетов
			// Признаки учета
			Для Каждого Признак Из ОбъектМетаданные.ПризнакиУчета Цикл
				
				Если РегистрироватьПоРеквизитам Тогда
					ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", "ПризнакиУчета", Признак.Имя);
					НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
					Если НайденныеСтроки.Количество() > 0 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				// Добавляем
				НоваяЗаписьТаблицы						= ИзмененияТЧ.Добавить();
				НоваяЗаписьТаблицы.ИмяРеквизита			= Признак.Имя;
				НоваяЗаписьТаблицы.Значение				= СистемноеПредставлениеОбъекта(Объект[Признак.Имя]);
				НоваяЗаписьТаблицы.Представление		= Строка(Объект[Признак.Имя]);
				НоваяЗаписьТаблицы.ТипРеквизита			= 1;
				
			КонецЦикла;
						
			Массив = Новый Массив;
			Массив.Добавить("ВидСубконто");
			Массив.Добавить("ТолькоОбороты");
			Для Каждого Признак Из ОбъектМетаданные.ПризнакиУчетаСубконто Цикл
				Массив.Добавить(Признак.Имя);
			КонецЦикла;
			
			// Признаки учета субконто
			
			Для Каждого Элемент Из Массив Цикл
				
				Если РегистрироватьПоРеквизитам Тогда
					ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", "ВидыСубконто", Элемент);
					НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
					Если НайденныеСтроки.Количество() > 0 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				НомерСтроки = 1;
				Для Каждого Строки Из Объект.ВидыСубконто Цикл
										
					// Добавляем
					НоваяЗаписьТаблицы						= ИзмененияТЧ.Добавить();
					НоваяЗаписьТаблицы.ИмяРеквизита			= Элемент;
					НоваяЗаписьТаблицы.ИмяТЧ				= "ВидыСубконто";
					НоваяЗаписьТаблицы.НомерСтрокиТЧ		= НомерСтроки;
					НоваяЗаписьТаблицы.Значение				= СистемноеПредставлениеОбъекта(Строки[Элемент]);
					НоваяЗаписьТаблицы.Представление		= Строка(Строки[Элемент]);
					НоваяЗаписьТаблицы.ТипРеквизита			= 1;
					
					НомерСтроки = НомерСтроки + 1;
				КонецЦикла;
			КонецЦикла;
			
		ИначеЕсли ТипОбъекта = 6 Тогда
			
			// План видов расчета			
			Массив = Новый Массив;
			Массив.Добавить("БазовыеВидыРасчета");
			Массив.Добавить("ВедущиеВидыРасчета");
			Массив.Добавить("ВытесняющиеВидыРасчета");
			
			Для каждого ИмяВидаРасчета Из Массив Цикл			
				
				Попытка
					ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", ИмяВидаРасчета, "");
					НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);		
					Если НайденныеСтроки.Количество() = 0 Тогда
						Для Каждого Строки Из Объект[ИмяВидаРасчета] Цикл    
							
							Если РегистрироватьПоРеквизитам Тогда
								ПараметрыОтбора = Новый Структура("ИмяТЧ,ИмяРеквизита", ИмяВидаРасчета, "ВидРасчета");
								НайденныеСтроки = НеРегистрируемое.НайтиСтроки(ПараметрыОтбора);
								Если НайденныеСтроки.Количество() > 0 Тогда
									Продолжить;
								КонецЕсли;						
							КонецЕсли;
							
							ВидРасчета								= Строки.ВидРасчета;
							
							// Добавляем
							НоваяЗаписьТаблицы						= ИзмененияТЧ.Добавить();
							НоваяЗаписьТаблицы.ИмяРеквизита			= "ВидРасчета";
							НоваяЗаписьТаблицы.ИмяТЧ				= ИмяВидаРасчета;
							НоваяЗаписьТаблицы.НомерСтрокиТЧ		= Строки.НомерСтроки;
							НоваяЗаписьТаблицы.Значение				= СистемноеПредставлениеОбъекта(ВидРасчета);
							НоваяЗаписьТаблицы.Представление		= Строка(ВидРасчета);
							НоваяЗаписьТаблицы.ТипРеквизита			= 2;
							
						КонецЦикла;						
					КонецЕсли;
				Исключение
				КонецПопытки;
				
			КонецЦикла;			
		КонецЕсли;		
	КонецЕсли;
	
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	
	Попытка		
		ЭлементКэша							= Справочники.Renault_внКэшЖурналаРегистрации.СоздатьЭлемент();
		ЭлементКэша.ДатаИзменения			= ТекущаяДата();
		ЭлементКэша.Пользователь			= ИмяПользователя();
		ЭлементКэша.Компьютер				= Renault_внОбщийМодульПовтИсп.ПолучитьИмяКомпьютера();
		ЭлементКэша.МетаданныеОбъекта		= ПолноеИмя;		
		ЭлементКэша.ТипМетаданных			= ТипОбъекта;
		ЭлементКэша.УзелРИБ					= ПолучитьУзелРИБ(Объект);
		ЭлементКэша.Часть					= 0;		
		Если ТипОбъекта = 4 Тогда // Константа
			Если НачальноеЗаполнение Тогда
				ЭлементКэша.Событие			= 0; // только изменение
			Иначе
				ЭлементКэша.Событие			= 2; // только изменение
			КонецЕсли;
			ЭлементКэша.ПредставлениеОбъекта= Строка(Объект.Значение);
			ЭлементКэша.ГУИДОбъекта			= ПолноеИмя;
		ИначеЕсли ТипОбъекта = 10 Тогда // Регистр сведений
			Если Объект.Количество() > 0 Тогда
				Если НачальноеЗаполнение Тогда
					ЭлементКэша.Событие		= 0; // только изменение
				Иначе
					ЭлементКэша.Событие		= 8; // сохранение
				КонецЕсли;
			Иначе
				ЭлементКэша.Событие			= 4; // физическое удаление
			КонецЕсли;			
			ЭлементКэша.ПредставлениеОбъекта= "";
			Для каждого ЭлементОтбора Из Объект.Отбор Цикл
				Если НЕ ЭлементОтбора.Использование Тогда
					Продолжить;				
				КонецЕсли;
				ЭлементОтбораЗначение = Строка(ЭлементОтбора.Значение);
				Если ПустаяСтрока(ЭлементОтбораЗначение) Тогда
					ЭлементОтбораЗначение = "<>";
				КонецЕсли;
				ЭлементКэша.ПредставлениеОбъекта = ЭлементКэша.ПредставлениеОбъекта + ЭлементОтбора.Имя + " = " + ЭлементОтбораЗначение + "; ";
			КонецЦикла;
			ЭлементКэша.ПредставлениеОбъекта = СокрЛП(ЭлементКэша.ПредставлениеОбъекта);
			Если ПустаяСтрока(ЭлементКэша.ПредставлениеОбъекта) Тогда				
				ЭлементКэша.ПредставлениеОбъекта= "<Запись набора регистра сведений>";
			КонецЕсли;
			
			// Если нет изменений, проставим GUID по отбору.
			Если ИзмененияТЧ.Количество() = 0 Тогда
				СтрокаХэша = ПолноеИмя;
				Для Каждого Реквизит Из Объект.Отбор Цикл					
					СтрокаХэша = СтрокаХэша + Реквизит.Имя + СистемноеПредставлениеОбъекта(Реквизит.Значение);
				КонецЦикла;
				ЭлементКэша.ГУИДОбъекта	= Из_Число_В_16(ВычислитьХэш(СтрокаХэша));
			КонецЕсли;			
		Иначе
			ЭлементКэша.ГУИДОбъекта				= СистемноеПредставлениеОбъекта(Объект.Ссылка);
			ЭлементКэша.ПредставлениеОбъекта	= Строка(Объект);			
			Если НачальноеЗаполнение Тогда
				ЭлементКэша.Событие = 0; // начальное заполнение
			ИначеЕсли РеквизитыСобытие = -1 Тогда
				ЭлементКэша.Событие = 2; // изменение
			Иначе
				ЭлементКэша.Событие = РеквизитыСобытие;
			КонецЕсли;		
		КонецЕсли;		
		
		
		Если ИзмененияТЧ.Количество() > 0 Тогда
			
			ЭлементКэшаИзменения = ЭлементКэша.внИзменения;
			
			Если ТипОбъекта = 10 Тогда
				// Для регистров сведений для уникальных измерений своя запись
				// Делаем запись
				ТекСтрока = ИзмененияТЧ[0].НомерСтрокиТЧ;
				СтрокаХэша = ПолноеИмя;
				Для Индекс = 0 По ИзмененияТЧ.Количество() - 1 Цикл
					
					Строки = ИзмененияТЧ[Индекс];
					
					Если Строки.ТипРеквизита = 3 ИЛИ (Строки.ТипРеквизита = 5 И Строки.ИмяРеквизита = "Период") ИЛИ (Строки.ТипРеквизита = 5 И Строки.ИмяРеквизита = "Регистратор") Тогда
						СтрокаХэша = СтрокаХэша + СистемноеПредставлениеОбъекта(Строки.Значение);
					КонецЕсли;
					
					Если ТекСтрока <> Строки.НомерСтрокиТЧ Тогда
						ЭлементКэша.ГУИДОбъекта		= Из_Число_В_16(ВычислитьХэш(СтрокаХэша));
						СтрокаХэша					= ПолноеИмя;
						ЭлементКэша.Записать();
						
						НовыйЭлементКэша			= Справочники.Renault_внКэшЖурналаРегистрации.СоздатьЭлемент();
						ЗаполнитьЗначенияСвойств(НовыйЭлементКэша, ЭлементКэша,,"Родитель,Владелец");
						ЭлементКэша					= НовыйЭлементКэша;					
						ЭлементКэшаИзменения		= ЭлементКэша.внИзменения;
						ТекСтрока					= Строки.НомерСтрокиТЧ;
					Иначе
						ЗаполнитьЗначенияСвойств(ЭлементКэшаИзменения.Добавить(), Строки);
					КонецЕсли;
					
				КонецЦикла;
				
				Если СтрокаХэша <> ПолноеИмя Тогда
					ЭлементКэша.ГУИДОбъекта	= Из_Число_В_16(ВычислитьХэш(СтрокаХэша));
				КонецЕсли;
				
			Иначе
				// Для остальных элементов				
				КоличествоСтрок = 0;
				Для каждого Строки Из ИзмененияТЧ Цикл
					
					ЗаполнитьЗначенияСвойств(ЭлементКэшаИзменения.Добавить(), Строки);
					
					// Обходим проблему с количеством максимальных строк в 100000 штук.
					// Просто создаем новый элемент кэша и в него дописываем остаток данных
					КоличествоСтрок = КоличествоСтрок + 1;
					Если КоличествоСтрок = 99999 Тогда
						
						// Запись самого элемента
						ЭлементКэша.Записать();
												
						КоличествоСтрок				= 0;
						НовыйЭлементКэша			= Справочники.Renault_внКэшЖурналаРегистрации.СоздатьЭлемент();
						ЗаполнитьЗначенияСвойств(НовыйЭлементКэша, ЭлементКэша,,"Родитель,Владелец");
						НовыйЭлементКэша.Часть		= НовыйЭлементКэша.Часть + 1;
						ЭлементКэша					= НовыйЭлементКэша;					
						ЭлементКэшаИзменения		= ЭлементКэша.внИзменения;
					КонецЕсли;
					
				КонецЦикла;				
			КонецЕсли;
			
			// То, что не записалось ранее записываем
			Если ЭлементКэша.внИзменения.Количество() > 0 Тогда
				
				// Запись самого элемента
				ЭлементКэша.Записать();
				
			КонецЕсли;
			
		Иначе
			
			// Запись самого элемента
			ЭлементКэша.Записать();
			
		КонецЕсли;		
				
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();		
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, , "Ошибка регистрации объекта: "+ ПолноеИмя + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;	
		
КонецПроцедуры // РегистрацияИзмененияОбъекта

// Регистрирует во внешней ИБ удаление объекта
Процедура РегистрацияУдаленияОбъекта(Объект)  Экспорт 
	
	// Если регистрация отключена
	Если НЕ Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ВестиИсториюИзменений") Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмя			= Объект.Метаданные().ПолноеИмя();
		
	// Проверка, нужно ли фиксировать изменения для данного типа объектов	
	Если НЕ Renault_внОбщийМодульПовтИсп.РегистрироватьСобытиеОбъекта(ПолноеИмя) Тогда
		Возврат;
	КонецЕсли;
	ТипОбъекта			= ПолучитьТипОбъектаПоИмени(ПолноеИмя);
	
	// Запись на сервере в БД SQL Server
	НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
	Попытка
		
		ЭлементКэша							= Справочники.Renault_внКэшЖурналаРегистрации.СоздатьЭлемент();
		ЭлементКэша.ДатаИзменения			= ТекущаяДата();
		ЭлементКэша.Пользователь			= ИмяПользователя();
		ЭлементКэша.Компьютер				= Renault_внОбщийМодульПовтИсп.ПолучитьИмяКомпьютера();
		ЭлементКэша.Событие					= 4; //<< Удаление
		ЭлементКэша.МетаданныеОбъекта		= ПолноеИмя;
		ЭлементКэша.ГУИДОбъекта				= Renault_внОбщийМодуль.СистемноеПредставлениеОбъекта(Объект.Ссылка);
		ЭлементКэша.ПредставлениеОбъекта	= Строка(Объект);
		ЭлементКэша.ТипМетаданных			= ТипОбъекта;
		ЭлементКэша.УзелРИБ					= ПолучитьУзелРИБ(Объект);
		ЭлементКэша.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, , "Ошибка регистрации объекта: "+ ПолноеИмя + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры // РегистрацияУдаленияОбъекта

