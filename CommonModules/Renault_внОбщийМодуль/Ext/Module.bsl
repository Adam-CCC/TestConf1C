Процедура внОбработкаЖурналаРегистрации(П = Неопределено) Экспорт
	
	Результат = СжатьИсториюИзменений(Ложь, Истина);
	
КонецПроцедуры // внОбработкаЖурналаРегистрации

Процедура внОчисткаЖурналаРегистрации(П = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Проверка, что база РИБ и попытка запустить сжатие в базе с полным типом обмена
	// запрещено запускать сжатие в дочерней базе РИБ
	Если Renault_внОбщийМодульПовтИсп.ТипОбменаРИБПолный() И ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Информация, , "Запуск в дочерней базе РИБ, очистка не может быть выполнена");
		Возврат;
	КонецЕсли;
	
	// Если регистрация отключена
	Если НЕ Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ВестиИсториюИзменений") Тогда		
		УстановитьПривилегированныйРежим(Ложь);
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Ошибка, , "Запуск сжатия по регламентному заданию не был выполнен (история отключена, или не подходят параметры уникальности).");
		Возврат;
	Иначе
		ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Информация, , "Запуск очистки по регламентному заданию " + Формат(ТекущаяДата(), "ДФ='dd.MM.yy HH:mm:ss'"));
	КонецЕсли;
	
	// Получаем дату на которую надо очистить
	Если НЕ Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ОчищатьЖурналРегистрацииАвтоматически") Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;	
	КонецЕсли;
	
	Дней = Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("ПериодАвтоматическойОчисткиЖурналаРегистрации");
	
	Если Дней > 0 Тогда
		ДатаОчистки = НачалоДня(ТекущаяДата()) - 86400 * Дней;
		Результат = ОчиститьЖурналРегистрацииНаДату(Ложь, ДатаОчистки);		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗаписьЖурналаРегистрации("ВнешнийЖурналРегистрации", УровеньЖурналаРегистрации.Информация, , "Завершение сжатия по регламентному заданию " + Формат(ТекущаяДата(), "ДФ='dd.MM.yy HH:mm:ss'"));
	
КонецПроцедуры
 