
Функция ПолучитьМассивБирДляПолученияДанных() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CRM_ДилерскиеЦентры.BIR_Distri
	               |ИЗ
	               |	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	               |ГДЕ
	               |	CRM_ДилерскиеЦентры.BIR_Distri <> """"";
	МассивСтрокБИР = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("BIR_Distri");
	
	МассивБИР = Новый Массив;
	Для Каждого СтрокаБИР Из МассивСтрокБИР Цикл
		МассивБИРСтроки = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(СтрокаБИР, ",");
		Для Каждого БИР Из МассивБИРСтроки Цикл
			Если МассивБИР.Найти(БИР) = Неопределено Тогда
				МассивБИР.Добавить(БИР);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивБИР;	
	
КонецФункции


Функция ПолучитьПрокси() Экспорт 
	
	Адрес = "http://gate.rnlt.ru/dms-dictionary/ws/bonuspayment.1cws?wsdl";
	ЛогинWS = "Администратор";
	ПарольWS = "logan30";	
	ОпределениеСервиса = Новый WSОпределения(Адрес, ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(
		ОпределениеСервиса, 
		"http://renault.ru/BonusPayment", 
		"BonusPayment",
		"BonusPaymentSoap12",
		3600);
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Возврат ВебСервис;
	
КонецФункции

