Процедура BonusPaymentЗагрузкаДанных(Параметр = Неопределено) Экспорт
	
	BIRы = ПолучитьМассивБирДляПолученияДанных();
	BIR = BIRы[0];
	Прокси = ПолучитьПрокси();
	
	СериализованнаяТаблица = Прокси.GetCampains();
	Таблица = СериализаторXDTO.ПрочитатьXDTO(СериализованнаяТаблица);
	Для Каждого Строка Из Таблица Цикл
		Ссылка = Справочники.Renault_БонусныеКампании.НайтиПоКоду(Строка.Код);
		Если Ссылка = Неопределено Или Ссылка = Справочники.Renault_БонусныеКампании.ПустаяСсылка() Тогда
			Кампания = справочники.Renault_БонусныеКампании.СоздатьЭлемент();
			Кампания.Код = Строка.Код;
		Иначе
			Кампания = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		      
		Кампания.Наименование = Строка.Наименование;
		Кампания.Описание = Строка.Описание;
		
		Кампания.Записать();
	КонецЦикла;	
	
	СериализованнаяТаблица = Прокси.GetResults(BIR);
	Таблица = СериализаторXDTO.ПрочитатьXDTO(СериализованнаяТаблица);
	Для Каждого Строка Из Таблица Цикл
		Кампания = Справочники.Renault_БонусныеКампании.НайтиПоКоду(Строка.Код);
		Если Кампания = Неопределено Или Кампания = Справочники.Renault_БонусныеКампании.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;

		Набор = РегистрыСведений.Renault_BP_РезультатыКампаний.СоздатьНаборЗаписей();
		Набор.Отбор.Кампания.Установить(Кампания);
		Набор.Записать();
		
	КонецЦикла;
	Для Каждого Строка Из Таблица Цикл
		Кампания = Справочники.Renault_БонусныеКампании.НайтиПоКоду(Строка.Код);
		Если Кампания = Неопределено Или Кампания = Справочники.Renault_БонусныеКампании.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.Renault_BP_РезультатыКампаний.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Кампания = Кампания;
		МенеджерЗаписи.Дилер = Строка.Дилер;
		МенеджерЗаписи.Выплата = Строка.Выплата;
		МенеджерЗаписи.Сумма = Строка.Сумма;
		МенеджерЗаписи.Описание = Строка.Описание;
		
		МенеджерЗаписи.Записать();	
	КонецЦикла;
	
	СериализованнаяТаблица = Прокси.GetDetails(BIR);
	Таблица = СериализаторXDTO.ПрочитатьXDTO(СериализованнаяТаблица);
	Для Каждого Строка Из Таблица Цикл
		Кампания = Справочники.Renault_БонусныеКампании.НайтиПоКоду(Строка.Код);
		Если Кампания = Неопределено Или Кампания = Справочники.Renault_БонусныеКампании.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;

		Набор = РегистрыСведений.Renault_BP_ДетализацияРезультатов.СоздатьНаборЗаписей();
		Набор.Отбор.Кампания.Установить(Кампания);
		Набор.Записать();
		
	КонецЦикла;
	Для Каждого Строка Из Таблица Цикл
		Кампания = Справочники.Renault_БонусныеКампании.НайтиПоКоду(Строка.Код);
		Если Кампания = Неопределено Или Кампания = Справочники.Renault_БонусныеКампании.ПустаяСсылка() Тогда
			Продолжить;			
		КонецЕсли;	
		
		МенеджерЗаписи = РегистрыСведений.Renault_BP_ДетализацияРезультатов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Кампания = Кампания;
		МенеджерЗаписи.Дилер = Строка.Дилер;
		МенеджерЗаписи.VIN = Строка.VIN;
		МенеджерЗаписи.Выплата = Строка.Выплата;
		МенеджерЗаписи.Сумма = Строка.Сумма;
		МенеджерЗаписи.Комментарий1 = Строка.Комментарий1;
		МенеджерЗаписи.Комментарий2 = Строка.Комментарий2;
		МенеджерЗаписи.Комментарий3 = Строка.Комментарий3;
		МенеджерЗаписи.Комментарий4 = Строка.Комментарий4;
		МенеджерЗаписи.Комментарий5 = Строка.Комментарий5;
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
