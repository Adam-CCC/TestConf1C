
Процедура ВыгрузкаПоступленийАвтоОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт //подписка на событие проведение
	
	Если ПараметрыСеанса.DMS_Бренд<>Справочники.CRM_МаркаАвтомобиля.LADA Тогда Возврат КонецЕсли;
	
	ВремRenault_ПраваПользователя = Renault_РаботаСПравамиПользователя.ПолучитьСписокПрав(Источник.Автор);
	
	Массив=Новый Массив;
	Для Каждого Стр Из Источник.Автомобили Цикл
		Массив.Добавить(Новый Структура("arrivaldate,no,dealer_inn,dealer_filial,dealer_name,vin,firstarrival,guid_arrival,guid_delivery,notes,oper_type,dealer_bir_code",
			Источник.Дата,
			Источник.Номер,
			СокрЛП(Источник.Организация.ИНН),
			СокрЛП(ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.BIR),
			ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.НаименованиеДляПечати,
			Стр.VIN,
			?(Источник.Контрагент.ВидКонтрагента=Перечисления.ВидыКонтрагентов.Поставщик,1,0),
			Строка(Источник.Ссылка.УникальныйИдентификатор())+"|"+Стр.НомерСтроки,
			"",
			Источник.Комментарий,
			1,
			СокрЛП(ВремRenault_ПраваПользователя.ДилерскийЦентр.BIR)
		));
	КонецЦикла;	
	
	Если Не LADA_Services.ПередачаДанных("LADA_Services.arrivalAuto",Массив) Тогда
		Сообщить("Произошла ошибка при выгрузке информации в АвтоВАЗ. Повторите, пожалуйста, попытку.");
		Отказ=Истина
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузкаПоступленийАвтоОтменаПроведения(Источник, Отказ) Экспорт
	
	Если ПараметрыСеанса.DMS_Бренд<>Справочники.CRM_МаркаАвтомобиля.LADA Тогда Возврат КонецЕсли;
	ВремRenault_ПраваПользователя = Renault_РаботаСПравамиПользователя.ПолучитьСписокПрав(Источник.Автор);
	Массив=Новый Массив;
	Для Каждого Стр Из Источник.Автомобили Цикл
		Массив.Добавить(Новый Структура("arrivaldate,no,dealer_inn,dealer_filial,dealer_name,vin,firstarrival,guid_arrival,guid_delivery,notes,oper_type,dealer_bir_code",
			Источник.Дата,
			Источник.Номер,
			СокрЛП(Источник.Организация.ИНН),
			СокрЛП(ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.BIR),
			ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.НаименованиеДляПечати,
			Стр.VIN,
			?(Источник.Контрагент.ВидКонтрагента=Перечисления.ВидыКонтрагентов.Поставщик,1,0),
			Строка(Источник.Ссылка.УникальныйИдентификатор())+"|"+Стр.НомерСтроки,
			"",
			Источник.Комментарий,
			0,
			СокрЛП(ВремRenault_ПраваПользователя.ДилерскийЦентр.BIR)
		));
	КонецЦикла;	
	
	Если Не LADA_Services.ПередачаДанных("LADA_Services.arrivalAuto",Массив) Тогда
		Сообщить("Произошла ошибка при выгрузке информации в АвтоВАЗ. Повторите, пожалуйста, попытку.");
		Отказ=Истина
	КонецЕсли;
	
КонецПроцедуры


