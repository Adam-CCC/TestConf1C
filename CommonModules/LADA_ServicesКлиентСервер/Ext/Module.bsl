Функция Паспорт(Контрагент)
	
	Запрос=Новый Запрос("Выбрать Ссылка ИЗ Справочник.ПодтверждающиеДокументы ГДЕ Владелец=&Контрагент И НЕ Устаревший И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Выборка=Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(),Новый Структура("Дата,Номер,Серия,Выдан",Выборка.Ссылка.ДатаВыдачи,Выборка.Ссылка.Номер,Выборка.Ссылка.Серия,Выборка.Ссылка.КемВыдан),Новый Структура("Дата,Номер,Серия,Выдан",Дата(1,1,1),"","",""))
	
КонецФункции

Функция Телефон(Контрагент)
	Запрос=Новый Запрос("Выбрать Первые 1 Представление Из РегистрСведений.КонтактнаяИнформация ГДЕ Объект=&Контрагент И Тип=Значение(Перечисление.ТипыКонтактнойИнформации.Телефон) Упорядочить По ЗначениеПоУмолчанию Убыв");
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Выборка=Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(),Выборка.Представление,"")
КонецФункции	

Функция Email(Контрагент)
	Запрос=Новый Запрос("Выбрать Первые 1 Представление Из РегистрСведений.КонтактнаяИнформация ГДЕ Объект=&Контрагент И Тип=Значение(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты) Упорядочить По ЗначениеПоУмолчанию Убыв");
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Выборка=Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(),Выборка.Представление,"")
КонецФункции	

Функция Адрес(Контрагент)
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.Текст="
	|Выбрать Первые 1
	|	Представление
	|ИЗ(
	|	Выбрать Первые 1 Представление, 1 Порядок Из РегистрСведений.КонтактнаяИнформация 
	|	ГДЕ Объект=&Контрагент И ЗначениеПоУмолчанию 
	|	И Вид В(Значение(Справочник.ВидыКонтактнойИнформации.АдресИностранный),
	|			Значение(Справочник.ВидыКонтактнойИнформации.АдресПочтовый),
	|			Значение(Справочник.ВидыКонтактнойИнформации.АдресФактический),
	|			Значение(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|	Объединить
	|	Выбрать Первые 1 Представление, 2 Порядок Из РегистрСведений.КонтактнаяИнформация 
	|	ГДЕ Объект=&Контрагент 
	|	И Вид В(Значение(Справочник.ВидыКонтактнойИнформации.АдресИностранный),
	|			Значение(Справочник.ВидыКонтактнойИнформации.АдресПочтовый),
	|			Значение(Справочник.ВидыКонтактнойИнформации.АдресФактический),
	|			Значение(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|)ЗП
	|Упорядочить По Порядок
	|";	
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Представление
КонецФункции

Функция UID_Поступление(VIN,Дата)
	Запрос=Новый Запрос("Выбрать Первые 1 Ссылка Из Документ.ПоступлениеАвтомобилей.Автомобили ГДЕ VIN=&VIN И Ссылка.Дата<=КонецПериода(&Дата,День) Упорядочить По Ссылка.Дата Убыв");
	Запрос.УстановитьПараметр("VIN",VIN);
	Запрос.УстановитьПараметр("Дата",Дата);
	Выборка=Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(),Выборка.Ссылка.УникальныйИдентификатор(),"")
КонецФункции

Функция UID_Реализация(VIN,Дата)
	Запрос=Новый Запрос("Выбрать Первые 1 Ссылка Из Документ.РеализацияАвтомобилей.Автомобили ГДЕ Автомобиль.VIN=&VIN И Ссылка.Дата<=КонецПериода(&Дата,День) Упорядочить По Ссылка.Дата Убыв");
	Запрос.УстановитьПараметр("VIN",VIN);
	Запрос.УстановитьПараметр("Дата",Дата);
	Выборка=Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(),Выборка.Ссылка.УникальныйИдентификатор(),"")
КонецФункции

Функция СогласиеНаОбработкуПерсональныхДанных(Контрагент)
	Возврат ?(Контрагент.СогласиеНаОбработкуПерсональныхДанных=Перечисления.ВариантыОтветов.Да,1,0);
КонецФункции

