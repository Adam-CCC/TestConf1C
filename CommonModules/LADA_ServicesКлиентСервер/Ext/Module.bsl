		Структура.Вставить("PASNO","_");
		Структура.Вставить("PASOVD","_");
		Структура.Вставить("PASSERIA","_");
		Структура.Вставить("CUSTOMER_PHONE","_");
		Структура.Вставить("CUSTOMER_MOPHONE","_");
		Структура.Вставить("CUSTOMER_EMAIL","_");
		Структура.Вставить("RITEMNO","_");
		Структура.Вставить("CORPORATIONREC",0); //Признак продажи корпоративным клиентам (0 - нет, 1 - корпоративным клиентам)
		Структура.Вставить("LADAFINANCEREC",0);
		Структура.Вставить("CREDITREC",0); //Признак продажи  в кредит  (0 - нет, 1 - в кредит)
		Структура.Вставить("SALEREC",1); //Признак продажи за наличные  (0 - нет, 1 - за наличные)
		Структура.Вставить("SOGLASIEREC",СогласиеНаОбработкуПерсональныхДанных(Источник.Контрагент)); //Признак Согласие покупателя на обработку персональных данных и участие в опросах.  (0 - нет, 1 - согласен)
		Структура.Вставить("LADAASSISTANCE","КАРТА НЕ ВЫДАВАЛАСЬ"); //Номер карты LADA Assistance. Если карта не выдана написать КАРТА НЕ ВЫДАВАЛАСЬ
		Структура.Вставить("LADAINSURANCE",0); //Признак продажи по программе LADA INSURANCE. (0 - нет, 1 - LADA INSURANCE)
		Структура.Вставить("FLAG_UTIL",0); //Признак договор по утилизации (0 - нет, 1 - утилизация)
		Структура.Вставить("FLAG_TRADEIN",0); //Признак договор trade-in (0 - нет, 1 - trade-in)
		Структура.Вставить("PRIZN_PO_SUDU",0); //Признак оформления продажи по решению суда (0 - нет, 1 - решение суда)
