Процедура _P1SMSRU_Баланс(Баланс, ЕстьОшибка,Логин, Пароль) Экспорт
	
	ЕстьОшибка		= Ложь;
	ОписаниеОшибки 	= "";
	СписокОшибок	= _P1SMSRU_СписокОшибок();
	Ответ			= _P1SMSRU_ПослатьКоманду("sendsms.php", "balance=1",Логин, Пароль);
	СуммаИлиОшибка  = СтрПолучитьСтроку(Ответ, 1);
	Ошибка		= СписокОшибок.НайтиПоЗначению(СуммаИлиОшибка);
	Баланс = "";
	Если Ошибка <> Неопределено Тогда
		Баланс	= Ошибка.Представление;
	Иначе
		Попытка
			БалансЧисло	= Число(СуммаИлиОшибка);
		Исключение			
			ЕстьОшибка = Истина;
		КонецПопытки;                            
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(Ответ);		
		Для Индекс = 1 По Текст.КоличествоСтрок() Цикл
			Баланс	= Баланс + " " + Текст.ПолучитьСтроку(Индекс); 
		КонецЦикла;
		Баланс = СокрЛП(Баланс);
	КонецЕсли;
		
КонецПроцедуры // _P1SMSRU_Баланс

Функция _P1SMSRU_СписокОтправителей(Логин, Пароль) Экспорт
	
	СписокОшибок	= _P1SMSRU_СписокОшибок();
	Ответ			= _P1SMSRU_ПослатьКоманду("sendsms.php", "originators=1",Логин, Пароль);
	
	Если НЕ ПустаяСтрока(Ответ) Тогда
		
		Результат = Новый СписокЗначений;
		Для Индекс = 1 По СтрЧислоСтрок(Ответ) Цикл
			Результат.Добавить(СтрПолучитьСтроку(Ответ, Индекс));
		КонецЦикла;
		
		Возврат Результат;
		
	Иначе
		
		СтрокаОшибки	= "Ошибка получения отправителя";
		Возврат СтрокаОшибки;
		
	КонецЕсли;	
	
КонецФункции


Функция URLEncode(Стр) Экспорт
	
	Длина=СтрДлина(Стр);
	Итог="";
	Для Н=1 По Длина Цикл
		Знак=Сред(Стр,Н,1);
		Код=КодСимвола(Знак);
		
		Если ((Знак>="a")и(Знак<="z")) или
			 ((Знак>="A")и(Знак<="Z")) или
			 ((Знак>="0")и(Знак<="9")) тогда
			Итог=Итог + Знак;
		Иначе
			Если (Код>=КодСимвола("А"))И(Код<=КодСимвола("п")) Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(208,16)+"%"+ПреобразоватьвСистему(144+Код-КодСимвола("А"),16);
			ИначеЕсли (Код>=КодСимвола("р"))И(Код<=КодСимвола("я")) Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(209,16)+"%"+ПреобразоватьвСистему(128+Код-КодСимвола("р"),16);
			ИначеЕсли (Знак="ё") Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(209,16)+"%"+ПреобразоватьвСистему(145,16);
			ИначеЕсли (Знак="Ё") Тогда
				Итог=Итог+"%"+ПреобразоватьвСистему(208,16)+"%"+ПреобразоватьвСистему(129,16);
			Иначе
				Итог=Итог+"%"+ПреобразоватьвСистему(Код,16);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Итог;
КонецФункции

функция Hex(КС)
	
	_Hex = Новый Массив(16);
	_Hex[0]="0";
	_Hex[1]="1";
	_Hex[2]="2";
	_Hex[3]="3";
	_Hex[4]="4";
	_Hex[5]="5";
	_Hex[6]="6";
	_Hex[7]="7";
	_Hex[8]="8";
	_Hex[9]="9";
	_Hex[10]="A";
	_Hex[11]="B";
	_Hex[12]="C";
	_Hex[13]="D";
	_Hex[14]="E";
	_Hex[15]="F";	
	
	возврат(_Hex[Цел(КС / 16)] + _Hex[Цел(КС % 16)]);
	
конецфункции

Функция URLEncode2(Стр1) Экспорт
	
	Рез = ""; 
	Стр= СокрЛП(Стр1);
	Для Сч = 1 По СтрДлина(Стр) Цикл
 
		Символ = Сред(Стр, Сч, 1);
		КС = КодСимвола(Символ);
		
		Рез = Рез + "%" + Hex(Цел(КС / 256)) + "%"+ Hex(КС % 256);
		
	КонецЦикла;
 
	Возврат Рез;	
 
	Возврат Рез;
КонецФункции // URLEncode() 


