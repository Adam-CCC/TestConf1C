Процедура _P1SMSRU_ОбновитьСтатусДоставки(ТЗ,Логин, Пароль) Экспорт
	
	Статусы = _P1SMSRU_СписокСтатусовДоставкиСообщений();
	
	Для каждого Стр Из ТЗ Цикл
		
		Если ПустаяСтрока(Стр.ИДСообщения) ИЛИ НЕ Стр.Флаг Тогда
			Продолжить;
		КонецЕсли;
		
		Ответ = _P1SMSRU_ПослатьКоманду("sendsms.php", "&smsid=" + URLEncode(Стр.ИДСообщения),Логин, Пароль);
		Статус = СтрПолучитьСтроку(Ответ, 1);
		Элемент	= Статусы.НайтиПоЗначению(Статус);
		Если Элемент <> Неопределено Тогда
			Стр.Статус	= Элемент.Представление;
		Иначе
			Стр.Статус	= "Не известный статус доставки (" + Строка(Статус) + ")";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // _P1SMSRU_ОбновитьСтатусДоставки

