	DMS_РекламныеКампанииСервер.ОтразитьСтатусМакетаРекламнойКампании(Установил,Макет,ДатаСобытия,Статус,Отказ);	

КонецПроцедуры

Процедура ОтразитьСтатусОтчетаПоРекламнойКампании(Установил,Макет,ДатаСобытия,Статус,Отказ) Экспорт 

	DMS_РекламныеКампанииСервер.ОтразитьСтатусОтчетаПоРекламнойКампании(Установил,Макет,ДатаСобытия,Статус,Отказ);	

КонецПроцедуры

Процедура УстановитьПараметрыСеансаВидОперацииРекламнойКампании(ИмяПараметра, УстановленныеПараметры) Экспорт

	Если ИмяПараметра = "DMS_ВидОперацииРекламнойКампании" Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		ПараметрыСеанса.DMS_ВидОперацииРекламнойКампании = Неопределено;//ЗначениеНастроекПовтИсп.ПолучитьВидОперацииРекламнойКампанииПользователяПоУмолчанию(ПараметрыСеанса.ТекущийПользователь);
		ОбновитьПовторноИспользуемыеЗначения();

		Если ТипЗнч(УстановленныеПараметры) = Тип("Структура") Тогда
			УстановленныеПараметры.Вставить("DMS_ВидОперацииРекламнойКампании");
		Иначе
			УстановленныеПараметры.Добавить("DMS_ВидОперацииРекламнойКампании");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОтправитьКампаниюНаСервер(Кампания) Экспорт
	
	
	
	
	Попытка

		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("РезультатыКампаний",DMS_ВзаимодействияСКлиентом.ПодготовитьРезультатыДляВыгрузки(Кампания.Сценарий));
		СтруктураПараметров.Вставить("СценарийКампании",DMS_ВзаимодействияСКлиентом.ПодготовитьСценарииДляВыгрузки(Кампания.Сценарий));
		СтруктураПараметров.Вставить("Кампания",DMS_ВзаимодействияСКлиентом.ПодготовитьКампаниюДляВыгрузки(Кампания));
		

		ИсходящийПараметр = СериализаторXDTO.ЗаписатьXDTO(СтруктураПараметров);
		СтрокаЗапроса = Renault_ОбщиеФункцииСервер.ПолучитьСтрокуJSONИзXDTO(ИсходящийПараметр);


		
		Настройки = Renault_ОбщиеФункцииСервер.ПолучитьНастройкиПодключенияПоБренду(ПараметрыСеанса.DMS_Бренд);
		HTTPЗапрос = Новый HTTPЗапрос();
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса);
		HTTPЗапрос.АдресРесурса = Настройки.Адрес2 + "/hs/Campaigns/Accept";
		Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,Настройки.ЗащищенноеСоединениеOpenSSL);
                
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);

		Если ОтветHTTP.КодСостояния = 200 Тогда		
			Возврат Истина;
		Иначе
			Сообщить("Ошибка: " + ОтветHTTP.ПолучитьТелоКакСтроку());	
			Возврат Ложь;	 
		КонецЕсли;
		
	Исключение
		Сообщить("Ошибка " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура ОбновитьКампании() Экспорт
	
	Попытка 
		//обновим статусы кампаний находящихся на рассмотрении
		ВебСервис = DMS_ВзаимодействияСКлиентом.ПолучитьВебСервисКампании();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_Кампании.Ссылка
		|ИЗ
		|	Справочник.Renault_Кампании КАК Renault_Кампании
		|ГДЕ
		|	Renault_Кампании.Архивная = ЛОЖЬ
		|	И Renault_Кампании.ПометкаУдаления = ЛОЖЬ
		|	И Renault_Кампании.Загружаемая = ЛОЖЬ
		|	И Renault_Кампании.Родитель = ЗНАЧЕНИЕ(Справочник.Renault_Кампании.ПустаяСсылка)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если выборка.Количество()>0 тогда
			
			BIR = Константы.Renault_BIR_db.Получить();
			
			Пока Выборка.Следующий() Цикл
				
				СтруктураПараметров	= новый Структура;
				СтруктураПараметров.Вставить("BIR",BIR);
				СтруктураПараметров.Вставить("УИД",Строка(Выборка.Ссылка.УникальныйИдентификатор()));
				
				ЗаписьJSON = Новый ЗаписьJSON();
				ЗаписьJSON.УстановитьСтроку();
				ЗаписатьJSON(ЗаписьJSON, СтруктураПараметров);
				ТелоЗапроса = ЗаписьJSON.Закрыть();
				
				Настройки = Renault_ОбщиеФункцииСервер.ПолучитьНастройкиПодключенияПоБренду(ПараметрыСеанса.DMS_Бренд);
	
				HTTPЗапрос = Новый HTTPЗапрос();
				HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
				HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
				HTTPЗапрос.АдресРесурса = Настройки.Адрес2 + "/hs/Campaigns/Export";
				Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,Настройки.ЗащищенноеСоединениеOpenSSL);
			                
				ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	
				ОтветСтруктура = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());

				Если ОтветСтруктура.Количество()>0 тогда
					Если DMS_ВзаимодействияСКлиентом.ВернутьЗначениеПеречисления("CRM_СтатусыКлиентскихЗаявок",ОтветСтруктура.Статус) <> Перечисления.CRM_СтатусыКлиентскихЗаявок.НаРассмотрение Тогда
						КампанияОбъект = Выборка.Ссылка.ПолучитьОбъект();
						Если КампанияОбъект.Активная = Ложь и ОтветСтруктура.Активная = Истина и ЗначениеЗаполнено(КампанияОбъект.РодительскаяКампания) Тогда
							РодКампания = КампанияОбъект.РодительскаяКампания.ПолучитьОбъект();
							РодКампания.Родитель = Справочники.Renault_Кампании.Архивные;
							РодКампания.Активная = Ложь;
							РодКампания.Записать();
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(КампанияОбъект,ОтветСтруктура);
						ВыбранныеПоля = ОтветСтруктура.ВыбранныеПоля.Получить();
						Если ВыбранныеПоля <> Неопределено и ВыбранныеПоля.Количество()>1 Тогда
							Настройки = КампанияОбъект.НастройкиОтбора.Получить();
							Настройки.Выбор.Элементы.Очистить();
							Для каждого ВыбПоле из ВыбранныеПоля Цикл
								
								Если ВыбПоле.Заголовок = Неопределено Тогда

									Продолжить;

								КонецЕсли; 
								
								Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
								ЗаполнитьЗначенияСвойств(Поле,ВыбПоле);
							КонецЦикла;
							КампанияОбъект.НастройкиОтбора = Новый ХранилищеЗначения(Настройки);
						КонецЕсли;
						КампанияОбъект.Статус = DMS_ВзаимодействияСКлиентом.ВернутьЗначениеПеречисления("CRM_СтатусыКлиентскихЗаявок",ОтветСтруктура.Статус);
						КампанияОбъект.Записать();
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		//Получим кампании с центрального сервера
		
		HTTPЗапрос = Новый HTTPЗапрос();
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		HTTPЗапрос.АдресРесурса = Настройки.Адрес2 + "/hs/Campaigns/ExportAll";
		Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,Настройки.ЗащищенноеСоединениеOpenSSL);
	                
		ОтветHTTP = Соединение.Получить(HTTPЗапрос);

		Ответ = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());	
	
		Если ТипЗнч(Ответ) = Тип("СписокЗначений") и Ответ.Количество()>0 Тогда
			
			
			//заполним центральные настройки
			Для каждого Эл из Ответ цикл
				Если Эл.Значение.ЦентральнаяНастройка = Ложь тогда 
					Продолжить;
				КонецЕсли;
				НастройкиДляВсех = Эл.Значение.НастройкиДополнительные.Получить();
				Если ТипЗнч(НастройкиДляВсех) = Тип("НастройкиКомпоновкиДанных") Тогда
					DMS_ВзаимодействияСКлиентом.ЗаполнитьЦентральныеНастройкиДляВсехКампаний(Эл.Значение);
				КонецЕсли;
			КонецЦикла;
			
			//отберем УИДы кампаний, которые нужно создавать
			ТЗ_Уиды = Новый ТаблицаЗначений;
			ТЗ_Уиды.Колонки.Добавить("ЦентральныйУИД",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));

			Для каждого Эл из Ответ цикл
				Если Эл.Значение.ЦентральнаяНастройка = Ложь тогда 
					ЗаполнитьЗначенияСвойств(ТЗ_Уиды.Добавить(),Эл.Значение);	
				КонецЕсли;
   			КонецЦикла;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТЗ_УИДы.ЦентральныйУИД
			|ПОМЕСТИТЬ ВТ_УИДы
			|ИЗ
			|	&ТЗ_УИДы КАК ТЗ_УИДы
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_УИДы.ЦентральныйУИД,
			|	Renault_Кампании.Ссылка
			|ИЗ
			|	ВТ_УИДы КАК ВТ_УИДы
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_Кампании КАК Renault_Кампании
			|		ПО ВТ_УИДы.ЦентральныйУИД = Renault_Кампании.ЦентральныйУИД
			|ГДЕ
			|	Renault_Кампании.Загружаемая = ИСТИНА
			|	И НЕ Renault_Кампании.Ссылка ЕСТЬ NULL ";
			
			Запрос.УстановитьПараметр("ТЗ_УИДы",ТЗ_Уиды);
			НовыеУИДы = Запрос.Выполнить().Выгрузить();
			
			Для каждого Эл из Ответ цикл
				
				Если Эл.Значение.ЦентральнаяНастройка = Истина тогда 
					Продолжить;
				КонецЕсли;

				Если НЕ ЗначениеЗаполнено(Эл.Значение.ЦентральныйУИД) Тогда
					Продолжить;
				КонецЕсли;
				СтрокаУИД = НовыеУИДы.Найти(Эл.Значение.ЦентральныйУИД,"ЦентральныйУИД");
				Если СтрокаУИД = Неопределено тогда
					КампанияОбъект = Справочники.Renault_Кампании.СоздатьЭлемент();
					
				Иначе
					КампанияОбъект = СтрокаУИД.Ссылка.ПолучитьОбъект();
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(КампанияОбъект,Эл.Значение);
				КампанияОбъект.НастройкиОтбора = Эл.Значение.НастройкиДополнительные;
				КампанияОбъект.НастройкиДополнительные = Неопределено;
				КампанияОбъект.Статус = DMS_ВзаимодействияСКлиентом.ВернутьЗначениеПеречисления("CRM_СтатусыКлиентскихЗаявок",Эл.Значение.Статус);
				КампанияОбъект.ВидКонтакта = DMS_ВзаимодействияСКлиентом.ВернутьЗначениеПеречисления("Renault_ВидыКонтактаКампаний",Эл.Значение.ВидКонтакта);
				Если ЗначениеЗаполнено(Эл.Значение.Приоритет) тогда
					КампанияОбъект.Приоритет = Справочники.DMS_Приоритет[Эл.Значение.Приоритет];
				КонецЕсли;
				Если ЗначениеЗаполнено(Эл.Значение.ТипСообщения) тогда
					КампанияОбъект.ТипСообщения = DMS_ВзаимодействияСКлиентом.ВернутьЗначениеПеречисления("DMS_ТипСообщенияКампании",Эл.Значение.ТипСообщения);
				КонецЕсли;
				КампанияОбъект.Родитель = Справочники.Renault_Кампании.Загруженные;
				КампанияОбъект.Загружаемая = Истина;
				КампанияОбъект.Записать();
				
			КонецЦикла;
			
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("Обновление списка кампаний",,,,ОписаниеОшибки());
	КонецПопытки;
		

	
КонецПроцедуры	

//получает статус схемы коммуникации
Функция ПолучитьВебСервисСхемКоммуникации()
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	АдресWS = СокрЛП(Настройки.АдресWsGate);
	
	ЛогинWS = СокрЛП(Настройки.ЛогинДоступаКВебСервисам);
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	                                                
	Определение = Новый WSОпределения(АдресWS + "ws/CommunicationCenterGate.1cws?wsdl",ЛогинWS, ПарольWS);
	
	Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
		ВебСервис = Новый WSПрокси(Определение,Определение.Сервисы[0].URIПространстваИмен,Определение.Сервисы[0].Имя,Определение.Сервисы[0].ТочкиПодключения[0].Имя,60);
	Иначе
		Выполнить("ВебСервис=Новый WSПрокси(Определение,""http://renault.ru/WSGate/RenaultCommunicationCenterGate"",""Renault_CommunicationCenter"",""Renault_CommunicationCenterSoap"",,60)");	
	КонецЕсли;	

	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
		
	Возврат ВебСервис;
		
КонецФункции

