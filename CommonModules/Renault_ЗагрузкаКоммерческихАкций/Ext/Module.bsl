Процедура Renault_ТипыСкидокПередЗаписью(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Отказ Тогда
	
		Если Не Источник.ЭтоНовый()
			И СокрЛП(Источник.Ссылка.Код) = "RenltCA"
			И СокрЛП(Источник.Код) <> "RenltCA" Тогда
			
			Сообщить("Запрещено изменять код элемента");
			Отказ = Истина;	
		КонецЕсли;	
	
	КонецЕсли;
КонецПроцедуры

//Козлов Е.А. Начало 24.01.2017
#Если Клиент Тогда
Функция УстановитьТипАвтомобиля(VIN, ДилерскийЦентр) Экспорт
	ТипАвтомобиля = Неопределено;
	
	Если ЗначениеЗаполнено(VIN) Тогда 		
		BIR_Distri = СокрЛП(ДилерскийЦентр.BIR_Distri);
		
		МассивСкладовДилера = ДилерскийЦентр.СкладыДилера.ВыгрузитьКолонку("Склад");
		//Корзюков Начало 
		Если ДилерскийЦентр.Автосклад_ИспользоватьНовуюФормуСклада = Истина Тогда
			ФормаАвтосклад = Обработки.Renault_АРМ_Автосклад_Упр.ПолучитьФорму("ФормаДинамическийСписок");
		Иначе
			ФормаАвтосклад = Обработки.Renault_АРМ_Автосклад.ПолучитьФорму("Форма");
		КонецЕсли;
		
		//ФормаАвтосклад = Обработки.Renault_АРМ_Автосклад.ПолучитьФорму("Форма");
		//Корзюков Конец
		//ФормаАвтосклад.ПоказыватьЗарезервированные = Истина;
		//ФормаАвтосклад.МассивСкладовДилера = МассивСкладовДилера;
		
		// Ищем в новых		
		Результат = CRM_Сервер.Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей(VIN, МассивСкладовДилера, BIR_Distri, Истина, Истина, Истина, Истина,,,,, Неопределено, Неопределено,, Неопределено);
		Если Результат.Количество() > 0 Тогда
			ТипАвтомобиля = "Новый";
		КонецЕсли;
		
		// Ищем в подержанных		
		Если ТипАвтомобиля = Неопределено Тогда		
			Результат = CRM_Сервер.Автосклад_ПолучитьТаблицуПодержанныхАвтомобилей(VIN);
			Если Результат.Количество() > 0 Тогда
				ТипАвтомобиля = "Подержанный";
			КонецЕсли;		
		КонецЕсли;
		
		// Ищем в демо/подменных		
		Если ТипАвтомобиля = Неопределено Тогда 			
			Результат = ФормаАвтосклад.Автосклад_ПолучитьТаблицуДемоПодменок(VIN);
			Если Результат.Количество() > 0 Тогда
				ТипАвтомобиля = "Демо";
			КонецЕсли;			
		КонецЕсли;
		
		// Если так и не удалось определить тип, считаем что новый
		Если ТипАвтомобиля = Неопределено Тогда
			ТипАвтомобиля = "Новый";
		КонецЕсли; 		
	КонецЕсли;
	
	Возврат ТипАвтомобиля;
КонецФункции
#КонецЕсли
