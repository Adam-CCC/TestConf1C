Функция ПолучитьВсеСкидки(VIN, Модель, Версия, ТипАвтомобиля, ГодВыпуска = 0, Знач Дата = Неопределено) Экспорт
//Андрианова Конец 16.01.2017

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = НачалоДня(ТекущаяДата());	
	Иначе
		Дата = НачалоДня(Дата);	
	КонецЕсли;
	
	Если ТипАвтомобиля = "Новый" Тогда
		ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.НовыйАвтомобиль;		
