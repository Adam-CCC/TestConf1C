
Функция ПолучитьПрокси()
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	// Сериализация полученной таблицы и передача ее в web-сервис
	Адрес = Настройки.АдресWsGate+"ws/RenaultCommercialAction.1cws?wsdl";
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	ОпределениеСервиса = Новый WSОпределения(Адрес, ЛогинWS, ПарольWS);
	ВебСервис=Новый WSПрокси(ОпределениеСервиса,"http://renault.ru/WSGate/RenaultCommercialAction","Renault_CommercialAction","Renault_CommercialActionSoap12",,60);
	
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Возврат ВебСервис;
	
КонецФункции

Процедура Renault_ЗагрузкаКоммерческихАкций(Параметры=Неопределено) Экспорт
	
	ДатаАктуальности = Константы.Renault_ДатаАктуальностиКоммерческихАкций.Получить();
	ДилерскиеЦентры = ПолучитьДилерскиеЦенты();
	МассивБИР = ДилерскиеЦентры.ВыгрузитьКолонку("BIR");
	
	Если НЕ Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьHTTPСервисы Тогда
		
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		МассивБИРXDTO = Сериализатор.ЗаписатьXDTO(МассивБИР);
		ВебСервис = ПолучитьПрокси();
		Ответ = Вебсервис.GetForBir(ДатаАктуальности, МассивБИРXDTO); //Ответ = Вебсервис.Get(ДатаАктуальности);
		
	Иначе
		
		Ответ = Неопределено;
		ПараметрыЗапроса = Новый Структура();
		ПараметрыЗапроса.Вставить("ДатаАктуальности", ДатаАктуальности);
		ПараметрыЗапроса.Вставить("BIR", МассивБИР);
		Если Не DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"DMS_CommercialActions.CommercialActionGET",DMS_DataExchange.newPackage(ПараметрыЗапроса),Ответ) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Данные = Ответ.Получить();
	
	КоммАкции = Данные.КоммАкции;
	КУдалению = Данные.КУдалению;
	УсловияАкции = Данные.УсловияАкции;
	ГодаВыпуска = Данные.ГодаВыпуска;
	
	// Загружаем модели и версии
	Попытка
		Renault_ЗагрузкаТарифа.ЗагрузитьМодели();
		Renault_ЗагрузкаТарифа.ЗагрузитьНастройкиПоМаркам(Дата("00010101"));
		Renault_ЗагрузкаТарифа.ЗагрузитьВерсии();
	Исключение
		Инфо = ИнформацияОбОшибке();
		ДанныеОшибки = ПодробноеПредставлениеОшибки(Инфо);
		
		ЗаписьЖурналаРегистрации("Загрузка справочника модели",УровеньЖурналаРегистрации.Ошибка,,, ДанныеОшибки); 	
	КонецПопытки;
	
	// Сопоставление моделей и версий
	Запрос = Новый Запрос;
			
	Запрос.УстановитьПараметр("КоммАкции", УсловияАкции); 
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	КоммАкции.КодМодели,
	               |	КоммАкции.КодВерсии,
	               |	КоммАкции.НачалоДействия,
	               |	КоммАкции.ОкончаниеДействия,
	               |	КоммАкции.КоммерческаяАкцияGUID,
	               |	КоммАкции.ЗначениеСкидки,
	               |	КоммАкции.ЗначениеСкидкиУчастиеДилера,
	               |	КоммАкции.ВариантСкидки
	               |ПОМЕСТИТЬ ВТ_КоммАкции
	               |ИЗ
	               |	&КоммАкции КАК КоммАкции
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(Модели.Ссылка, ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)) КАК Модель,
	               |	ЕСТЬNULL(ВариантыКомплектации.Ссылка, ЗНАЧЕНИЕ(Справочник.ВариантыКомплектации.ПустаяСсылка)) КАК Версия,
	               |	ВТ_КоммАкции.КоммерческаяАкцияGUID КАК КоммерческаяАкцияGUID,
	               |	ВТ_КоммАкции.ЗначениеСкидки,
	               |	ВТ_КоммАкции.ЗначениеСкидкиУчастиеДилера,
	               |	ВТ_КоммАкции.ВариантСкидки,
	               |	ВТ_КоммАкции.КодМодели,
	               |	ВТ_КоммАкции.КодВерсии,
	               |	ВТ_КоммАкции.НачалоДействия,
	               |	ВТ_КоммАкции.ОкончаниеДействия
	               |ИЗ
	               |	ВТ_КоммАкции КАК ВТ_КоммАкции
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Модели КАК Модели
	               |		ПО ВТ_КоммАкции.КодМодели = Модели.Артикул
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектации КАК ВариантыКомплектации
	               |		ПО (Модели.Ссылка = ВариантыКомплектации.Владелец)
	               |			И ВТ_КоммАкции.КодВерсии = ВариантыКомплектации.Артикул";
	
	ТаблицаСтоимость = Запрос.Выполнить().Выгрузить();   
	
	НачатьТранзакцию();
	
	Для Каждого Строка Из КоммАкции Цикл
		
		СправочникСсылка = Справочники.DMS_КоммерческиеАкции.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка.КоммерческаяАкцияGUID));
		
		Если ЗначениеЗаполнено(СправочникСсылка) И СтрНайти(Строка(СправочникСсылка), "<Объект не найден>") = 0 Тогда
			КоммАкция = СправочникСсылка.ПолучитьОбъект();
		Иначе
			КоммАкция = Справочники.DMS_КоммерческиеАкции.СоздатьЭлемент();
			КоммАкция.УстановитьСсылкуНового(СправочникСсылка);
		КонецЕсли;
		
		КоммАкция.Условия.Очистить();
		КоммАкция.ГодыВыпуска.Очистить();
		КоммАкция.ДилерскиеЦентры.Очистить();
		
		ЗаполнитьЗначенияСвойств(КоммАкция, Строка,, "ВладелецАкции");
		КоммАкция.ВладелецАкции = Перечисления.DMS_ВладельцыСервисов[Строка.ВладелецАкции];
		Если ЗначениеЗаполнено(Строка.РодительНаименование) Тогда
			Если ЗначениеЗаполнено(Справочники.DMS_КоммерческиеАкции.НайтиПоНаименованию(Строка.РодительНаименование)) Тогда
				КоммАкция.Родитель = Справочники.DMS_КоммерческиеАкции.НайтиПоНаименованию(Строка.РодительНаименование);
			Иначе
				Родитель = Справочники.DMS_КоммерческиеАкции.СоздатьГруппу();
				Родитель.Наименование = Строка.РодительНаименование;
				Родитель.Записать();
				КоммАкция.Родитель =  Родитель.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		НайденныеУсловия = ТаблицаСтоимость.НайтиСтроки(Новый Структура("КоммерческаяАкцияGUID", Строка.КоммерческаяАкцияGUID));
		
		Для Каждого Стр Из НайденныеУсловия Цикл
			
			Если ЗначениеЗаполнено(Стр.Модель) И ЗначениеЗаполнено(Стр.КодМодели) и НЕ ЗначениеЗаполнено(Стр.КодВерсии) Тогда
				НоваяСтрока = КоммАкция.Условия.Добавить();
				НоваяСтрока.Объект = Стр.Модель;
			ИначеЕсли ЗначениеЗаполнено(Стр.Версия) И ЗначениеЗаполнено(Стр.КодВерсии) Тогда
				НоваяСтрока = КоммАкция.Условия.Добавить();
				НоваяСтрока.Объект = Стр.Версия;
			Иначе
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр,, "ВариантСкидки");
			НоваяСтрока.ВариантСкидки = Перечисления.DMS_ВариантыСкидки[Стр.ВариантСкидки];
			
		КонецЦикла;
		
		НайденныеГода = ГодаВыпуска.НайтиСтроки(Новый Структура("КоммерческаяАкцияGUID", Строка.КоммерческаяАкцияGUID));
		
		Для Каждого Стр Из НайденныеГода Цикл
					
			ЗаполнитьЗначенияСвойств(КоммАкция.ГодыВыпуска.Добавить(), Стр);
			
		КонецЦикла;
		
		КоммАкция.ДилерскиеЦентры.Загрузить(ДилерскиеЦентры);
		
		Попытка
			КоммАкция.ОбменДанными.Загрузка = Истина;
			КоммАкция.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("Загрузка коммерческих акций",,Метаданные.Справочники.DMS_КоммерческиеАкции, КоммАкция.Ссылка, ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Константы.Renault_ДатаАктуальностиКоммерческихАкций.Установить(ТекущаяДата());
	
	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ЗагрузкаКоммерческихАкций"),
	ТекущаяДатаСеанса());

КонецПроцедуры

Функция ПолучитьДилерскиеЦенты()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_ДилерскиеЦентры.Ссылка КАК ДилерскийЦентр,
	|	CRM_ДилерскиеЦентры.BIR_Distri КАК BIR
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	|ГДЕ
	|	CRM_ДилерскиеЦентры.BIR_Distri <> """"
	|	И НЕ CRM_ДилерскиеЦентры.ПометкаУдаления";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

