
//Точка входа. Вызывает регламентное задание во время выполнения
Процедура Renault_ВыгрузкаДанныхКонтактЦентр(Параметр1 = Неопределено) Экспорт
	
	ПланОбмена = ПолучитьПланОбмена();
	
	Если ЗначениеЗаполнено(ПланОбмена) тогда
		ВыполнитьОтправкуДанных(ПланОбмена);
		РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
		ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ВыгрузкаДанныхКонтактЦентр"),
		ТекущаяДатаСеанса());
	Иначе
		Renault_Открытый.СообщитьПользователю("Формирование отменено, не удалось определить план обмена");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПланОбмена()
		
	Выборка = ПланыОбмена.Renault_ContactCenter.Выбрать();
	ЭтаБаза = ПланыОбмена.Renault_ContactCenter.ЭтотУзел();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> ЭтаБаза Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция ВыполнитьОтправкуДанных(ПланОбмена) Экспорт
	
	ЕстьВыгрузкаСтатистики = Ложь;
	Если Метаданные.ОбщиеМодули.Найти("Renault_ВыгрузкаСтатистики") <> Неопределено Тогда
		ЕстьВыгрузкаСтатистики = Истина;
	КонецЕсли;
	
	ВебСервис = ПолучитьПрокси();
	Сериализатор = Новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
	
	РезультатВыполнения = Новый Структура();
	Server = СтрокаСоединенияИнформационнойБазы();
	BIR = Константы.Renault_BIR_db.Получить();
	ЗаписьЖурналаРегистрации("Renault_ВыгрузкаДанныхКонтактЦентр.НачалоВыгрузки",
		УровеньЖурналаРегистрации.Информация,,, СтрокаСоединенияИнформационнойБазы()); 
	
	//Получим ссылки на все изменения, с учетом добавленных клиентов
	Выборка = ПланыОбмена.ВыбратьИзменения(ПланОбмена, 2);
	
	//Посчитаем количество изменений
	ОбщееКоличество = 0;
	Пока Выборка.Следующий() Цикл
		ОбщееКоличество = ОбщееКоличество + 1;
	КонецЦикла;
	Выборка.Сбросить();
	
	// если отправлять нечего сделаем пустой прозвон WS для подтверждения что все ок
	Если ОбщееКоличество = 0 Тогда
		ПустаяТаблица = Новый ТаблицаЗначений;
		Фабрика = ВебСервис.ФабрикаXDTO;
		Сериализатор = Новый СериализаторXDTO(Фабрика);
		Результат = Сериализатор.ЗаписатьXDTO(ПустаяТаблица);
		ДанныеОтправлены = ВебСервис.SetData(Результат, "SetConnection");
	КонецЕсли;
	
	//Заполним таблицы первоначальной информацией из плана обмена
	Счетчик = 0; ВсегоПередано = 0;
	Пока Выборка.Следующий() Цикл
		
		Если Счетчик = 0 Тогда
			//Инициализируем таблицы
			ТаблицаРезультатыОбработки = ИнициализироватьТаблицуРезультатыОбработки();
			ТаблицаВидыУслуг = ИнициализироватьТаблицуВидыУслуг();
			ТаблицаТрафикЛиды = ИнициализироватьТаблицуТрафикЛиды();
			ТаблицаТрафикПисьма = ИнициализироватьТаблицуТрафикПисьма();
			ТаблицаОтветыНаЛиды = ИнициализироватьТаблицуОтветыНаЛиды();
			ТаблицаОтветыНаПисьмо = ИнициализироватьТаблицуОтветыНаПисьмо();
			ТаблицаТрафикПоСотрудникам = ИнициализироватьТаблицуТрафикПоСотрудникам();
			ТаблицаТрафикЧат = ИнициализироватьТаблицуТрафикЧат();
			
			ТаблицаНастройкиКЦ = ИнициализироватьТаблицуНАстройкиКЦ();
			
			//Инициализируем таблицы для отмены регистрации
			ТаблицаРезультатыОбработки_ДляУдаленияРегистрации = ТаблицаРезультатыОбработки.Скопировать();
			ТаблицаВидыУслуг_ДляУдаленияРегистрации = ТаблицаВидыУслуг.Скопировать();
			ТаблицаТрафикЛиды_ДляУдаленияРегистрации = ТаблицаТрафикЛиды.Скопировать();
			ТаблицаТрафикПисьма_ДляУдаленияРегистрации = ТаблицаТрафикПисьма.Скопировать();
			ТаблицаОтветыНаЛиды_ДляУдаленияРегистрации = ТаблицаОтветыНаЛиды.Скопировать();
			ТаблицаОтветыНаПисьмо_ДляУдаленияРегистрации = ТаблицаОтветыНаПисьмо.Скопировать();
			ТаблицаТрафикПоСотрудникам_ДляУдаленияРегистрации = ТаблицаТрафикПоСотрудникам.Скопировать();
			ТаблицаТрафикЧат_ДляУдаленияРегистрации = ТаблицаТрафикЧат.Скопировать();
			
			ТаблицаНастройкиКЦ_ДляУдаленияРегистрации = ТаблицаНастройкиКЦ.Скопировать();
			
			// отправим данные по дц
			//ОтправитьТаблицуДЦ(BIR, ВебСервис, ПланОбмена);
			
		КонецЕсли;
		
		ЭлементИзмененныхДанных = Выборка.Получить();
		ДобавитьЭлементВТаблицуДляОтправки(ЭлементИзмененныхДанных, 
			ТаблицаРезультатыОбработки,	ТаблицаРезультатыОбработки_ДляУдаленияРегистрации,
			ТаблицаВидыУслуг,			ТаблицаВидыУслуг_ДляУдаленияРегистрации,
			ТаблицаТрафикЛиды,			ТаблицаТрафикЛиды_ДляУдаленияРегистрации,
			ТаблицаТрафикПисьма,		ТаблицаТрафикПисьма_ДляУдаленияРегистрации,
			ТаблицаОтветыНаЛиды,		ТаблицаОтветыНаЛиды_ДляУдаленияРегистрации,
			ТаблицаОтветыНаПисьмо,		ТаблицаОтветыНаПисьмо_ДляУдаленияРегистрации,
			ТаблицаТрафикПоСотрудникам,	ТаблицаТрафикПоСотрудникам_ДляУдаленияРегистрации,
			ТаблицаТрафикЧат,			ТаблицаТрафикЧат_ДляУдаленияРегистрации,
			ТаблицаНастройкиКЦ,			ТаблицаНастройкиКЦ_ДляУдаленияРегистрации
		);
		
		Счетчик = Счетчик + 1;
		ВсегоПередано = ВсегоПередано + 1;
		
		Если Счетчик = 1000 ИЛИ ВсегоПередано = ОбщееКоличество Тогда
			
			Попытка 
				
				Если ЕстьВыгрузкаСтатистики = Ложь Тогда
					
					// если нет выгрузки трафика отправим вручную трафик, который участвует в контакт-центре
					ТаблицаТрафикКОтправке = ОтправитьТаблицуТрафик(ТаблицаТрафикЛиды, ТаблицаТрафикПисьма, ТаблицаОтветыНаЛиды, ТаблицаОтветыНаПисьмо, ТаблицаТрафикЧат, BIR, ВебСервис);
					ОтправитьТаблицуКлиенты(ТаблицаТрафикКОтправке, BIR, ВебСервис);
					
				КонецЕсли;
				
				ОтправитьТаблицуРезультатыОбработки(ТаблицаРезультатыОбработки, ТаблицаРезультатыОбработки_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуВидыУслуг(ТаблицаВидыУслуг, ТаблицаВидыУслуг_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуТрафикЛиды(ТаблицаТрафикЛиды, ТаблицаТрафикЛиды_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуТрафикПисьма(ТаблицаТрафикПисьма, ТаблицаТрафикПисьма_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуОтветыНаЛиды(ТаблицаОтветыНаЛиды, ТаблицаОтветыНаЛиды_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуОтветыНаПисьмо(ТаблицаОтветыНаПисьмо, ТаблицаОтветыНаПисьмо_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуТрафикПоСотрудникам(ТаблицаТрафикПоСотрудникам, ТаблицаТрафикПоСотрудникам_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуТрафикЧат(ТаблицаТрафикЧат, ТаблицаТрафикЧат_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				ОтправитьТаблицуНастройкиКЦ(ТаблицаНастройкиКЦ, ТаблицаНастройкиКЦ_ДляУдаленияРегистрации, BIR, ВебСервис, ПланОбмена);
				
			Исключение
				ЗаписьЖурналаРегистрации("Renault_ВыгрузкаДанныхКонтактЦентр", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			Счетчик = 0;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("Renault_ВыгрузкаДанныхКонтактЦентр.ОкончаниеВыгрузки", УровеньЖурналаРегистрации.Информация,,, СтрокаСоединенияИнформационнойБазы()); 
	
	Возврат РезультатВыполнения;
	
КонецФункции // ВыполнитьОтправкуДанныхВЦентраль()

Процедура ДобавитьЭлементВТаблицуДляОтправки(ЭлементИзмененныхДанных, 
			ТаблицаРезультатыОбработки,	ТаблицаРезультатыОбработки_ДляУдаленияРегистрации,
			ТаблицаВидыУслуг,			ТаблицаВидыУслуг_ДляУдаленияРегистрации,
			ТаблицаТрафикЛиды,			ТаблицаТрафикЛиды_ДляУдаленияРегистрации,
			ТаблицаТрафикПисьма,		ТаблицаТрафикПисьма_ДляУдаленияРегистрации,
			ТаблицаОтветыНаЛиды,		ТаблицаОтветыНаЛиды_ДляУдаленияРегистрации,
			ТаблицаОтветыНаПисьмо,		ТаблицаОтветыНаПисьмо_ДляУдаленияРегистрации,
			ТаблицаТрафикПоСотрудникам,	ТаблицаТрафикПоСотрудникам_ДляУдаленияРегистрации,
			ТаблицаТрафикЧат,			ТаблицаТрафикЧат_ДляУдаленияРегистрации,
			ТаблицаНастройкиКЦ,			ТаблицаНастройкиКЦ_ДляУдаленияРегистрации
	)
	
	Если ТипЗнч(ЭлементИзмененныхДанных) =  Тип("УдалениеОбъекта") Тогда
		
		Если ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("СправочникСсылка.Renault_РезультатОбработки") Тогда
			ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаРезультатыОбработки, ТаблицаРезультатыОбработки_ДляУдаленияРегистрации);
			
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("СправочникСсылка.Renault_ВидУслуги") Тогда
			ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаВидыУслуг, ТаблицаВидыУслуг_ДляУдаленияРегистрации);
			
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("ДокументСсылка.Renault_Лид") Тогда
			ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаТрафикЛиды, ТаблицаТрафикЛиды_ДляУдаленияРегистрации);
			
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("СправочникСсылка.Renault_НастройкиОнлайнКонсультанта") Тогда
			ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаНастройкиКЦ, ТаблицаНастройкиКЦ_ДляУдаленияРегистрации);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("СправочникОбъект.Renault_РезультатОбработки") Тогда
		ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаРезультатыОбработки, ТаблицаРезультатыОбработки_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("СправочникОбъект.Renault_ВидУслуги") Тогда
		ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаВидыУслуг, ТаблицаВидыУслуг_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("ДокументОбъект.Renault_Лид") Тогда
		ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаТрафикЛиды, ТаблицаТрафикЛиды_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("СправочникОбъект.Renault_НастройкиОнлайнКонсультанта") Тогда
		ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаНастройкиКЦ, ТаблицаНастройкиКЦ_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("РегистрСведенийНаборЗаписей.Renault_ТрафикПисьма") Тогда
		ДобавитьУдалениеНабораРегистра(ЭлементИзмененныхДанных, ТаблицаТрафикПисьма, ТаблицаТрафикПисьма_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("РегистрСведенийНаборЗаписей.Renault_ОтветыНаЛиды") Тогда
		ДобавитьУдалениеНабораРегистра(ЭлементИзмененныхДанных, ТаблицаОтветыНаЛиды, ТаблицаОтветыНаЛиды_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("РегистрСведенийНаборЗаписей.Renault_ОтветыНаПисьмо") Тогда
		ДобавитьУдалениеНабораРегистра(ЭлементИзмененныхДанных, ТаблицаОтветыНаПисьмо, ТаблицаОтветыНаПисьмо_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("РегистрСведенийНаборЗаписей.Renault_ТрафикПоСотрудникам") Тогда
		ДобавитьУдалениеНабораРегистра(ЭлементИзмененныхДанных, ТаблицаТрафикПоСотрудникам, ТаблицаТрафикПоСотрудникам_ДляУдаленияРегистрации);
		
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("РегистрСведенийНаборЗаписей.Renault_ОК_Сообщения") Тогда
		ДобавитьУдалениеНабораРегистра(ЭлементИзмененныхДанных, ТаблицаТрафикЧат, ТаблицаТрафикЧат_ДляУдаленияРегистрации);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, Таблица, Таблица_ДляУдаленияРегистрации)
	
	Стр = Таблица.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	Стр.УдаленнаяЗапись = Истина;
	
	Стр = Таблица_ДляУдаленияРегистрации.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	
КонецПроцедуры

Процедура ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, Таблица, Таблица_ДляУдаленияРегистрации)
	
	Стр = Таблица.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	Стр.УдаленнаяЗапись = Ложь;
	Если Таблица.Колонки.Найти("ТрафикИД") <> Неопределено Тогда
		Стр.ТрафикИД = ЭлементИзмененныхДанных.ТрафикИД;
	КонецЕсли;
	
	Стр = Таблица_ДляУдаленияРегистрации.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	
КонецПроцедуры

Процедура ДобавитьУдалениеНабораРегистра(ЭлементИзмененныхДанных, Таблица, Таблица_ДляУдаленияРегистрации)
	
	Измерения = ЭлементИзмененныхДанных.Метаданные().Измерения;
	
	//Удаленные записи
	Если ЭлементИзмененныхДанных.Количество() = 0 Тогда
		//Для отправки
		Стр = Таблица.Добавить();
		Стр.УдаленнаяЗапись = Истина;
		Для Каждого Измерение ИЗ Измерения Цикл
			Стр[Измерение.Имя] = ЭлементИзмененныхДанных.Отбор[Измерение.Имя].Значение;
		КонецЦикла;
		
		//Для удаления регистрации
		Стр = Таблица_ДляУдаленияРегистрации.Добавить();
		Стр.УдаленнаяЗапись = Истина;
		Для Каждого Измерение ИЗ Измерения Цикл
			Стр[Измерение.Имя] = ЭлементИзмененныхДанных.Отбор[Измерение.Имя].Значение;
		КонецЦикла;
		
	КонецЕсли;
	
	//Новые и измененные записи
	Для Каждого ЗаписьНабораИзмененныхДанных Из ЭлементИзмененныхДанных Цикл
		//Для отправки
		Стр = Таблица.Добавить();
		Стр.УдаленнаяЗапись = Ложь;
		Для Каждого Измерение ИЗ Измерения Цикл
			Стр[Измерение.Имя] = ЗаписьНабораИзмененныхДанных[Измерение.Имя];
		КонецЦикла;
		
		//Для удаления регистрации
		Стр = Таблица_ДляУдаленияРегистрации.Добавить();
		Стр.УдаленнаяЗапись = Ложь;
		Для Каждого Измерение ИЗ Измерения Цикл
			Стр[Измерение.Имя] = ЗаписьНабораИзмененныхДанных[Измерение.Имя];
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

