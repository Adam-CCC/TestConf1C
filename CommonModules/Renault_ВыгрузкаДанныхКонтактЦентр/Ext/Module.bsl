Процедура ОтменитьРегистрациюОтветыНаЛиды(ТаблицаОписание, ПланОбмена)
	
	Для Каждого КлючевыеПоля из ТаблицаОписание Цикл
		Если КлючевыеПоля.УдаленнаяЗапись = Неопределено или КлючевыеПоля.УдаленнаяЗапись Тогда
			Набор = РегистрыСведений.Renault_ОтветыНаЛиды.СоздатьНаборЗаписей();
			Набор.Отбор.ИдТрафика.Установить(КлючевыеПоля.ИдТрафика);
			Набор.Отбор.ДатаОтвета.Установить(КлючевыеПоля.ДатаОтвета);
			Набор.Отбор.ВидСообщения.Установить(КлючевыеПоля.ВидСообщения);
			ПланыОбмена.УдалитьРегистрациюИзменений(ПланОбмена, Набор);
		Иначе
			Набор = РегистрыСведений.Renault_ОтветыНаЛиды.СоздатьНаборЗаписей();
			Набор.Отбор.ИдТрафика.Установить(КлючевыеПоля.ИдТрафика);
			Набор.Отбор.ДатаОтвета.Установить(КлючевыеПоля.ДатаОтвета);
			Набор.Отбор.ВидСообщения.Установить(КлючевыеПоля.ВидСообщения);
			Набор.Прочитать();
			Если Набор.Количество() <> 0 Тогда
				Для Каждого СтрокаНД из Набор Цикл
					СтрокаНД.Отправлен = Истина;
				КонецЦикла;
				Набор.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

