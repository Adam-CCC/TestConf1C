//Отправка таблиц данных

Функция ОтправитьТаблицуТрафик(ТаблицаТрафикЛиды, ТаблицаТрафикПисьма, ТаблицаОтветыНаЛиды, ТаблицаОтветыНаПисьмо, ТаблицаТрафикЧат, BIR, ВебСервис)
	
	//Если ТаблицаДанных.Количество() = 0 Тогда
	//	Возврат;
	//КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТрафикЛиды.ТрафикИД
	|ПОМЕСТИТЬ ВремТаблицаТрафикЛиды
	|ИЗ
	|	&ТаблицаТрафикЛиды КАК ТаблицаТрафикЛиды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТрафикПисьма.ИдТрафика
	|ПОМЕСТИТЬ ВремТаблицаТрафикПисьма
	|ИЗ
	|	&ТаблицаТрафикПисьма КАК ТаблицаТрафикПисьма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОтветыНаЛиды.ИдТрафика
	|ПОМЕСТИТЬ ВремТаблицаОтветыНаЛиды
	|ИЗ
	|	&ТаблицаОтветыНаЛиды КАК ТаблицаОтветыНаЛиды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОтветыНаПисьмо.ИдТрафика
	|ПОМЕСТИТЬ ВремТаблицаОтветыНаПисьмо
	|ИЗ
	|	&ТаблицаОтветыНаПисьмо КАК ТаблицаОтветыНаПисьмо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТрафикЧат.IDТрафика КАК ИдТрафика
	|ПОМЕСТИТЬ ВремТаблицаТрафикЧат
	|ИЗ
	|	&ТаблицаТрафикЧат КАК ТаблицаТрафикЧат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТаблицаТрафикЛиды.ТрафикИД КАК ИдТрафика
	|ПОМЕСТИТЬ Врем
	|ИЗ
	|	ВремТаблицаТрафикЛиды КАК ВремТаблицаТрафикЛиды
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВремТаблицаТрафикПисьма.ИдТрафика
	|ИЗ
	|	ВремТаблицаТрафикПисьма КАК ВремТаблицаТрафикПисьма
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВремТаблицаОтветыНаЛиды.ИдТрафика
	|ИЗ
	|	ВремТаблицаОтветыНаЛиды КАК ВремТаблицаОтветыНаЛиды
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВремТаблицаОтветыНаПисьмо.ИдТрафика
	|ИЗ
	|	ВремТаблицаОтветыНаПисьмо КАК ВремТаблицаОтветыНаПисьмо
	|;
	|
	|ВЫБРАТЬ
	|	ВремТаблицаТрафикЧат.ИдТрафика
	|ИЗ
	|	ВремТаблицаТрафикЧат КАК ВремТаблицаТрафикЧат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Врем.ИдТрафика
	|ПОМЕСТИТЬ ВремТаб
	|ИЗ
	|	Врем КАК Врем
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&BIR КАК ИдентификаторИБ,
	|	ЛОЖЬ КАК УдаленнаяЗапись,
	|	Renault_Трафик.Период КАК Период,
	|	Renault_Трафик.Идентификатор КАК Идентификатор,
	|	Renault_Трафик.ТипТрафика КАК ТипТрафикаСсылка,
	|	Renault_Трафик.Обработан КАК Обработан,
	|	Renault_Трафик.Отдел КАК ОтделСсылка,
	|	Renault_Трафик.Менеджер КАК МенеджерСсылка,
	|	Renault_Трафик.Администратор КАК АдминистраторСсылка,
	|	Renault_Трафик.Клиент КАК КлиентСсылка,
	|	Renault_Трафик.ПервичныйПовторный КАК ПервичныйПовторный,
	|	Renault_Трафик.ДилерскийЦентр КАК ДилерскийЦентрСсылка,
	|	Renault_Трафик.Представление КАК Представление,
	|	Renault_Трафик.Комментарий КАК Комментарий,
	|	Renault_Трафик.ПервичныйИнтерес КАК ПервичныйИнтересСсылка,
	|	Renault_Трафик.ИсточникИнформации КАК ИсточникИнформацииСсылка
	|ИЗ
	|	ВремТаб КАК ВремТаб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|		ПО (Renault_Трафик.Идентификатор = ВремТаб.ИдТрафика)";
	Запрос.УстановитьПараметр("ТаблицаТрафикЛиды", ТаблицаТрафикЛиды);
	Запрос.УстановитьПараметр("ТаблицаТрафикПисьма", ТаблицаТрафикПисьма);
	Запрос.УстановитьПараметр("ТаблицаОтветыНаЛиды", ТаблицаОтветыНаЛиды);
	Запрос.УстановитьПараметр("ТаблицаОтветыНаПисьмо", ТаблицаОтветыНаПисьмо);
	Запрос.УстановитьПараметр("ТаблицаТрафикЧат", ТаблицаТрафикЧат);
	Запрос.УстановитьПараметр("BIR", BIR);
	ТаблицаТрафик = Запрос.Выполнить().Выгрузить();
	
	Фабрика = ВебСервис.ФабрикаXDTO;
	
	ТаблицаТрафик.Колонки.Добавить("ТипТрафикаНаименование", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "ТипТрафикаНаименование", 40);
	ТаблицаТрафик.Колонки.Добавить("МенеджерНаименование", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "МенеджерНаименование", 40);
	ТаблицаТрафик.Колонки.Добавить("АдминистраторНаименование", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "АдминистраторНаименование", 40);
	ТаблицаТрафик.Колонки.Добавить("ПервичныйПовторныйСтрока", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "ПервичныйПовторныйСтрока", 40);
	ТаблицаТрафик.Колонки.Добавить("UIDОтдел", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UIDОтдел", 40);
	ТаблицаТрафик.Колонки.Добавить("UIDДилерскийЦентр", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UIDДилерскийЦентр", 40);
	ТаблицаТрафик.Колонки.Добавить("UIDКлиент", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UIDКлиент", 40);
	ТаблицаТрафик.Колонки.Добавить("UIDПервичныйИнтерес", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UIDПервичныйИнтерес", 40);
	ТаблицаТрафик.Колонки.Добавить("UIDИсточникИнформации", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UIDИсточникИнформации", 40);
	Для Каждого СтрокаТЗ ИЗ ТаблицаТрафик Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.ТипТрафикаСсылка) Тогда
			СтрокаТЗ.ТипТрафикаНаименование = СтрокаТЗ.ТипТрафикаСсылка.Наименование;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.МенеджерСсылка) Тогда
			СтрокаТЗ.МенеджерНаименование = СтрокаТЗ.МенеджерСсылка.Наименование;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.АдминистраторСсылка) Тогда
			СтрокаТЗ.АдминистраторНаименование = СтрокаТЗ.АдминистраторСсылка.Наименование;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.ПервичныйПовторный) Тогда
			СтрокаТЗ.ПервичныйПовторныйСтрока = ИмяЗначенияПеречисления(СтрокаТЗ.ПервичныйПовторный);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.ОтделСсылка) Тогда
			СтрокаТЗ.UIDОтдел = Строка(СтрокаТЗ.ОтделСсылка.УникальныйИдентификатор());
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.ДилерскийЦентрСсылка) Тогда
			СтрокаТЗ.UIDДилерскийЦентр = Строка(СтрокаТЗ.ДилерскийЦентрСсылка.УникальныйИдентификатор());
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.КлиентСсылка) Тогда
			СтрокаТЗ.UIDКлиент = Строка(СтрокаТЗ.КлиентСсылка.УникальныйИдентификатор());
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.ПервичныйИнтересСсылка) Тогда
			СтрокаТЗ.UIDПервичныйИнтерес = Строка(СтрокаТЗ.ПервичныйИнтересСсылка.УникальныйИдентификатор());
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.ИсточникИнформацииСсылка) Тогда
			СтрокаТЗ.UIDИсточникИнформации = Строка(СтрокаТЗ.ИсточникИнформацииСсылка.УникальныйИдентификатор());
		КонецЕсли;
	КонецЦикла;
	ТаблицаТрафик.Колонки.Удалить("ТипТрафикаСсылка");
	ТаблицаТрафик.Колонки.Удалить("МенеджерСсылка");
	ТаблицаТрафик.Колонки.Удалить("АдминистраторСсылка");
	ТаблицаТрафик.Колонки.Удалить("ПервичныйПовторный");
	ТаблицаТрафик.Колонки.Удалить("ОтделСсылка");
	ТаблицаТрафик.Колонки.Удалить("ДилерскийЦентрСсылка");
	ТаблицаТрафик.Колонки.Удалить("КлиентСсылка");
	ТаблицаТрафик.Колонки.Удалить("ПервичныйИнтересСсылка");
	ТаблицаТрафик.Колонки.Удалить("ИсточникИнформацииСсылка");
	
	Сериализатор = Новый СериализаторXDTO(Фабрика);
	Результат = Сериализатор.ЗаписатьXDTO(ТаблицаТрафик);
	ДанныеОтправлены = ВебСервис.SetData(Результат, "SetOKTraffic");
	
	Возврат ТаблицаТрафик;
	
	//Если ДанныеОтправлены = Истина Тогда
	//	ОтменитьРегистрациюТрафикЛиды(Таблица_ДляУдаленияРегистрации, ПланОбмена);
	//КонецЕсли;
	
КонецФункции

Процедура ОтправитьТаблицуКлиенты(ТаблицаТрафикКОтправке, BIR, ВебСервис)
	
	Если ТаблицаТрафикКОтправке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивИД = ТаблицаТрафикКОтправке.ВыгрузитьКолонку("Идентификатор");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
