Процедура ОтменитьРегистрациюТрафикЧат(ТаблицаОписание, ПланОбмена)
	
	Для Каждого КлючевыеПоля из ТаблицаОписание Цикл
		Набор = РегистрыСведений.Renault_ОК_Сообщения.СоздатьНаборЗаписей();
		Набор.Отбор.id_mess.Установить(КлючевыеПоля.id_mess);
		ПланыОбмена.УдалитьРегистрациюИзменений(ПланОбмена, Набор);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПрокси()
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	
	Адрес = Настройки.КЦАдресСервера;
	ОпределениеСервиса = Новый WSОпределения(СокрЛП(Адрес) + "ws/ContactCenter.ws?wsdl", ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(
		ОпределениеСервиса, 
		"http://renault-nissan.com/schema/ContactCenter", 
		"Renault_ContactCenter",
		"Renault_ContactCenterSoap12",
		3600);
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Возврат ВебСервис;
	
КонецФункции

Функция ИмяЗначенияПеречисления(Значение) Экспорт
 
	 ОбъектМетаданных = Значение.Метаданные();
	 
	 ИндексЗначения = Перечисления[ОбъектМетаданных.Имя].Индекс(Значение);
	 
	 Возврат ОбъектМетаданных.ЗначенияПеречисления[ИндексЗначения].Имя;
 
КонецФункции
