			НовСообщение.ЗаполнитьДанными(ТекущаяДата(),"Документ ""Заявка На Гарантию"" №"+Строка(Источник.номер)+" от "+Строка(Источник.Дата)+" Отправлен на оформление",неопределено,0,неопределено,неопределено);
			ЗаполнитьАдресатовСообщения(НовСообщение,МассивПолучателей);
			НовСообщение.Записать();
		КонецЕсли;

	ИначеЕсли (Источник.Статус =  Перечисления.Renault_CRM_СтатусЗаявокНаГарантию.Выполнена ) ИЛИ
		(Источник.Черновик = Истина) Или  (Источник.ВыполненаУспешно = Истина  )ИЛи (Источник.Закрыта = истина)Тогда
		Сообщ = Неопределено;
		Если ЗаписьСообщенияСуществует(Строка(Источник.Ссылка.УникальныйИдентификатор()),Сообщ) Тогда
			НовСообщение =Сообщ.ПолучитьОбъект();
			НовСообщение.Обработано = Истина;
			НовСообщение.Записать();
		//Иначе
		//	НовСообщение = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
