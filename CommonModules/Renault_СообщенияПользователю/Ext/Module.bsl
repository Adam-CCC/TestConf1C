Функция ВернутьОписаниеСтатусаРезерва(Статус, Клиент = Неопределено)
	
	Если Статус = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервУтвержден Тогда
		Ответ = "Утвержден резерв";
	ИначеЕсли Статус = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервОтклонен Тогда
		Ответ = "Отклонен резерв";
	ИначеЕсли Статус = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервСнят Тогда
		Ответ = "Снят резерв";
	Иначе 
		Ответ = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(Клиент) Тогда
		Ответ = Ответ + " для клиента " + Строка(Клиент);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция СформироватьКлюч(Запись,Ид)
	
	Результат = Новый Структура();
	Ответ = Новый Массив();
	Для каждого Зн Из Запись.Отбор Цикл
		Сравнение = новый Структура();
		
		Сравнение.Вставить(Зн.Имя, Зн.Значение);
		Сравнение.Вставить("ВидСравнения", Зн.ВидСравнения);
		Ответ.Добавить(Сравнение);
	КонецЦикла;
	Результат.Вставить("МассивОтборов", Ответ);
	Результат.Вставить("Ид", Ид);
	Возврат Результат;
	
КонецФункции

Функция ЗаписьСообщенияСуществует(Ид,Сообщение)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Renault_СообщенияПользователю.Ссылка
	                      |ИЗ
	                      |	Справочник.Renault_СообщенияПользователю КАК Renault_СообщенияПользователю
	                      |ГДЕ
	                      |	Renault_СообщенияПользователю.ИдентификаторОбъекта = &Ид
	                      |	И Renault_СообщенияПользователю.Обработано = ЛОЖЬ");
	Запрос.УстановитьПараметр("Ид", Ид);	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Сообщение = Выборка.Ссылка;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

