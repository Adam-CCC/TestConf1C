
//События по трафику + НОВАЯ
// {События по Контакт-центру перенесены в отдельную подписку "Renault_КонтактЦентр_ПриЗаписиТрафика"
// и модуль "Renault_КонтактЦентр_СообщенияПользователю"}
Процедура Renault_ОбработкаЗаписиТрафикаПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	//Старые сообщения
	
	Для Каждого Запись из Источник Цикл
		Трафик = Запись;
		ТрафикОбработан = Запись.Обработан;
		ТрафикСМенеджером = ЗначениеЗаполнено(Запись.Менеджер);
		ТрафикИд = Запись.Идентификатор;
		МассивСообщений = ПолучитьМассивВсехСообщений(ТрафикИд);
		МассивЭквивалентныхВидов = Новый Массив();
		МассивЗакрываемыхВидов = Новый Массив();
		
		Если ТрафикОбработан Тогда
			УстановитьОбработкуСообщения(МассивСообщений, Неопределено, "Трафик обработан");
		Иначе
			Если ТрафикСМенеджером Тогда
				
				МассивЭквивалентныхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
				МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера);
				МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.ОК_НовыйТрафик);
				СоздатьСообщение(Источник,Трафик, МассивСообщений, Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру,
								МассивЭквивалентныхВидов, МассивЗакрываемыхВидов);
			Иначе
				Если Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.OnlineКонсультант Тогда
					МассивЭквивалентныхВидов.Добавить(Справочники.Renault_ВидСообщения.ОК_НовыйТрафик);
					МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					СоздатьСообщение(Источник, Трафик, МассивСообщений, Справочники.Renault_ВидСообщения.ОК_НовыйТрафик,
									МассивЭквивалентныхВидов, МассивЗакрываемыхВидов);
				ИначеЕсли Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.ЛидRenault Тогда
					МассивЭквивалентныхВидов.Добавить(Справочники.Renault_ВидСообщения.КЦ_НовыйЛид);
					МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					СоздатьСообщение(Источник, Трафик, МассивСообщений, Справочники.Renault_ВидСообщения.КЦ_НовыйЛид,
									МассивЭквивалентныхВидов, МассивЗакрываемыхВидов);
				ИначеЕсли Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
					МассивЭквивалентныхВидов.Добавить(Справочники.Renault_ВидСообщения.КЦ_НовоеПисьмо);
					МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					СоздатьСообщение(Источник, Трафик, МассивСообщений, Справочники.Renault_ВидСообщения.КЦ_НовоеПисьмо,
									МассивЭквивалентныхВидов, МассивЗакрываемыхВидов);
				Иначе
					МассивЭквивалентныхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера);
					МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					СоздатьСообщение(Источник, Трафик, МассивСообщений, Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера,
									МассивЭквивалентныхВидов, МассивЗакрываемыхВидов);
				КонецЕсли;
							
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
	//Новые сообщения
	
	Для Каждого ЗаписьТрафик из Источник Цикл
		
		ТрафикОбработан = ЗаписьТрафик.Обработан;
		ТрафикСМенеджером = ЗначениеЗаполнено(ЗаписьТрафик.Менеджер);
		ТрафикИдентификатор = ЗаписьТрафик.Идентификатор;		
		ТрафикДилерскийЦентр = ЗаписьТрафик.ДилерскийЦентр;
		
		Если ТрафикОбработан Тогда
			Renault_СообщенияПользователям.УдалитьСообщение(ТрафикИдентификатор, Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
			Renault_СообщенияПользователям.УдалитьСообщение(ТрафикИдентификатор, Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера);
		Иначе
			Если ТрафикСМенеджером Тогда //Персональное сообщение менеджеру о назначенном трафике
				Если Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.OnlineКонсультант Тогда
					//Renault_СообщенияПользователям.ПослатьСообщениеПользователю(Справочники.Renault_ВидСообщения.ОК_НовыйТрафик, ЗаписьТрафик.Менеджер, "На вас назначен новый чат онлайн-консультанта", ТрафикИдентификатор);					
					
				ИначеЕсли Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.ЛидRenault Тогда
					//Renault_СообщенияПользователям.ПослатьСообщениеПользователю(Справочники.Renault_ВидСообщения.КЦ_НовыйЛид, ЗаписьТрафик.Менеджер, "На вас назначен новый лид", ТрафикИдентификатор);
					
				ИначеЕсли Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
					//Renault_СообщенияПользователям.ПослатьСообщениеПользователю(Справочники.Renault_ВидСообщения.КЦ_НовоеПисьмо, ЗаписьТрафик.Менеджер, "На вас назначено новое письмо", ТрафикИдентификатор);
					
				Иначе //Посещения, звонки
					Renault_СообщенияПользователям.УдалитьСообщение(ТрафикИдентификатор, Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера);				
					Renault_СообщенияПользователям.ПослатьСообщениеПользователю(Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру, ЗаписьТрафик.Менеджер, "На вас назначен новый клиент", ТрафикИдентификатор);
				КонецЕсли;
			Иначе //Общее сообщение о новом трафике //Только в рамках дилерского центра трафика
				Если Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.OnlineКонсультант Тогда
					//Renault_СообщенияПользователям.УдалитьСообщение(ТрафикИдентификатор, Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					//Renault_СообщенияПользователям.ПослатьСообщение(Справочники.Renault_ВидСообщения.ОК_НовыйТрафик, Истина, "Новый чат онлайн-консультанта", ТрафикИдентификатор, ТрафикДилерскийЦентр);
				ИначеЕсли Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.ЛидRenault Тогда
					//Renault_СообщенияПользователям.УдалитьСообщение(ТрафикИдентификатор, Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					//Renault_СообщенияПользователям.ПослатьСообщение(Справочники.Renault_ВидСообщения.КЦ_НовыйЛид, Истина, "Новый лид", ТрафикИдентификатор, ТрафикДилерскийЦентр);
				ИначеЕсли Трафик.ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
					//Renault_СообщенияПользователям.УдалитьСообщение(ТрафикИдентификатор, Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					//Renault_СообщенияПользователям.ПослатьСообщение(Справочники.Renault_ВидСообщения.КЦ_НовоеПисьмо, Истина, "Новое письмо", ТрафикИдентификатор, ТрафикДилерскийЦентр);
				Иначе
					Renault_СообщенияПользователям.УдалитьСообщение(ТрафикИдентификатор, Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру);
					Renault_СообщенияПользователям.ПослатьСообщение(Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера, Истина, "Новый клиент без менеджера", ТрафикИдентификатор, ТрафикДилерскийЦентр);
				КонецЕсли;
							
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

//События по договору
Процедура Renault_События_ПриЗаписиДоговораПередЗаписью(Источник, Отказ) Экспорт
	
	//Старые сообщения
	
	ДоговорИд = Строка(Источник.Ссылка.УникальныйИдентификатор()); 
	МассивСообщений = ПолучитьМассивВсехСообщений(ДоговорИд);
	ДоговорНаОформление = (Источник.Статус =  Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.НаОформление);
	ДоговорПодписан = (Источник.Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан);
	ДоговорЧерновик = (Источник.Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик);
	ДоговорОформлен = (Источник.Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Оформлен);
	ДоговорРасторгнут = (Источник.Статус = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Расторгнут); 
	МассивЭквивалентныхВидов = Новый Массив();
	МассивЗакрываемыхВидов = Новый Массив();

	Если ДоговорПодписан Или ДоговорЧерновик Или ДоговорРасторгнут Тогда
		Коммент = "Договор Подписан";
		Если ДоговорЧерновик Тогда 
			Коммент = "Договор Переведен в статус черновика";
		Иначе
			Если ДоговорРасторгнут тогда
				Коммент = "Договор расторгнут";
			КонецЕсли;
			
		КонецЕсли;
		УстановитьОбработкуСообщения(МассивСообщений, Неопределено, Коммент);
	Иначе
		Если ДоговорНаОформление Тогда
			МассивЭквивалентныхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйДоговорСКлиентом);
			МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.ОформленДоговорСКлиентом);
			СоздатьСообщение(Источник, Неопределено, МассивСообщений, Справочники.Renault_ВидСообщения.НовыйДоговорСКлиентом,
								МассивЭквивалентныхВидов, МассивЗакрываемыхВидов);
		ИначеЕсли ДоговорОформлен Тогда
			МассивЭквивалентныхВидов.Добавить(Справочники.Renault_ВидСообщения.ОформленДоговорСКлиентом);
			МассивЗакрываемыхВидов.Добавить(Справочники.Renault_ВидСообщения.НовыйДоговорСКлиентом);
			СоздатьСообщение(Источник, Неопределено, МассивСообщений, Справочники.Renault_ВидСообщения.ОформленДоговорСКлиентом,
								МассивЭквивалентныхВидов, МассивЗакрываемыхВидов);
		Иначе
			УстановитьОбработкуСообщения(МассивСообщений,Неопределено,"Событие завершено");
		КонецЕсли;
	КонецЕсли;		
	
	//Новые сообщения
	
