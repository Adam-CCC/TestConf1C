	                   |	Renault_СообщенияПользователю.ИдентификаторОбъекта = &Ид
	                   |	И Renault_СообщенияПользователю.ПометкаУдаления = ЛОЖЬ");
	Зап.УстановитьПараметр("Ид",Ид);
	Таблица = Зап.Выполнить().Выгрузить();
	Для Каждого  Сообщение Из Таблица Цикл
