Функция НастройкиСотрудники(ВидСообщения,ДЦ) Экспорт
	
	МассивСотрудников = Новый Массив();
	Запрос = новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_НастройкиСообщенийПользователям.ВидСообщения,
	|	Renault_НастройкиСообщенийПользователям.Отдел,
	|	Renault_НастройкиСообщенийПользователям.ДилерскийЦентр,
	|	Renault_НастройкиСообщенийПользователям.Должность
	|ИЗ
	|	РегистрСведений.Renault_НастройкиСообщенийПользователям КАК Renault_НастройкиСообщенийПользователям
	|ГДЕ
	|	Renault_НастройкиСообщенийПользователям.ВидСообщения = &ВидСообщения");
	Запрос.УстановитьПараметр("ВидСообщения", ВидСообщения);
	Настройки = Запрос.Выполнить().Выгрузить();
	Если Настройки.Количество() = 0 тогда
		//Зап = Новый Запрос("ВЫБРАТЬ
		//|	Сотрудники.Ссылка
		//|ИЗ
		//|	Справочник.Сотрудники КАК Сотрудники
		//|ГДЕ
		//|	Сотрудники.ЭтоГруппа = ЛОЖЬ
		//|	И Сотрудники.ПометкаУдаления = ЛОЖЬ");
		//Таблица = Зап.Выполнить().Выгрузить();
		//Для каждого Сотрудник Из Таблица Цикл
		//	Если МассивСотрудников.Найти(Сотрудник.Ссылка) = неопределено Тогда
		//		МассивСотрудников.Добавить(Сотрудник.Ссылка);
		//	КонецЕсли;
		//КонецЦикла;
		
	Иначе
		Для каждого Настройка Из Настройки Цикл
			Если ЗначениеЗаполнено(Настройка.ДилерскийЦентр) И ЗначениеЗаполнено(Настройка.Должность) Тогда
				Если ДЦ = Настройка.ДилерскийЦентр Тогда
					Зап = Новый Запрос("ВЫБРАТЬ
					|	Сотрудники.Ссылка,
					|	Сотрудники.Должность
					|ПОМЕСТИТЬ СотрудникиДЦ
					|ИЗ
					|	Справочник.Сотрудники КАК Сотрудники
					|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_Отделы.Подразделения КАК CRM_ОтделыПодразделения
					|		ПО (CRM_ОтделыПодразделения.Подразделение = Сотрудники.Подразделение)
					|ГДЕ
					|	CRM_ОтделыПодразделения.Ссылка.ДилерскийЦентр = &ДилерскийЦентр
					|	И НЕ CRM_ОтделыПодразделения.Подразделение ЕСТЬ NULL 
					|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
					|	И Сотрудники.ЭтоГруппа = ЛОЖЬ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	СотрудникиДЦ.Ссылка
					|ИЗ
					|	СотрудникиДЦ КАК СотрудникиДЦ
					|ГДЕ
					|	СотрудникиДЦ.Должность = &Должность");
					Зап.УстановитьПараметр("Должность",Настройка.Должность);
					Зап.УстановитьПараметр("ДилерскийЦентр",ДЦ);
					Таблица = Зап.Выполнить().Выгрузить();
					Для каждого Сотрудник Из Таблица Цикл
						Если МассивСотрудников.Найти(Сотрудник.Ссылка) = неопределено Тогда
							МассивСотрудников.Добавить(Сотрудник.Ссылка);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли (НЕ ЗначениеЗаполнено(Настройка.ДилерскийЦентр)) И ЗначениеЗаполнено(Настройка.Должность) Тогда
				Зап = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	Сотрудники.Ссылка
				|ИЗ
				|	Справочник.Сотрудники КАК Сотрудники
				|ГДЕ
				|	Сотрудники.Должность = &Должность
				|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
				|	И Сотрудники.ЭтоГруппа = ЛОЖЬ");
				Зап.УстановитьПараметр("Должность",Настройка.Должность);
				Таблица = Зап.Выполнить().Выгрузить();
				Для каждого Сотрудник Из Таблица Цикл
					Если МассивСотрудников.Найти(Сотрудник.Ссылка) = неопределено Тогда
						МассивСотрудников.Добавить(Сотрудник.Ссылка);
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ( ЗначениеЗаполнено(Настройка.ДилерскийЦентр)) И (не ЗначениеЗаполнено(Настройка.Должность)) Тогда
				Если ДЦ = Настройка.ДилерскийЦентр Тогда
					Зап = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	Сотрудники.Ссылка,
					|	Сотрудники.Должность
					|ИЗ
					|	Справочник.Сотрудники КАК Сотрудники
					|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_Отделы.Подразделения КАК CRM_ОтделыПодразделения
					|		ПО (CRM_ОтделыПодразделения.Подразделение = Сотрудники.Подразделение)
					|ГДЕ
					|	CRM_ОтделыПодразделения.Ссылка.ДилерскийЦентр = &ДилерскийЦентр
					|	И НЕ CRM_ОтделыПодразделения.Подразделение ЕСТЬ NULL 
					|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
					|	И Сотрудники.ЭтоГруппа = ЛОЖЬ");
					Зап.УстановитьПараметр("ДилерскийЦентр",ДЦ);
					Таблица = Зап.Выполнить().Выгрузить();
					Для каждого Сотрудник Из Таблица Цикл
						Если МассивСотрудников.Найти(Сотрудник.Ссылка) = Неопределено Тогда
							МассивСотрудников.Добавить(Сотрудник.Ссылка);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			Иначе
				Зап = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	Сотрудники.Ссылка
				|ИЗ
				|	Справочник.Сотрудники КАК Сотрудники
				|ГДЕ
				|	Сотрудники.ПометкаУдаления = ЛОЖЬ
				|	И Сотрудники.ЭтоГруппа = ЛОЖЬ");
				//Зап.УстановитьПараметр("ДилерскийЦентр",ДЦ);
				Таблица = Зап.Выполнить().Выгрузить();
				Для каждого Сотрудник Из Таблица Цикл
					Если МассивСотрудников.Найти(Сотрудник.Ссылка) = Неопределено Тогда
						МассивСотрудников.Добавить(Сотрудник.Ссылка);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивСотрудников;
	
КонецФункции

Функция НастройкиАдресатовОнлайнКонсультант(ВидСообщения, ДЦ, Отдел = Неопределено) Экспорт
	
	МассивСотрудников = Новый Массив();
	Настройки = Renault_ОнлайнКонсультант.ПолучитьНастройкиОнлайнКонсультант(ДЦ);
	Если Не (Настройки = неопределено) И Не(Настройки = Справочники.Renault_НастройкиОнлайнКонсультанта.ПустаяСсылка()) Тогда
		
		Отбор = Новый Структура();
		Отбор.Вставить("ВидСообщения", ВидСообщения);
		НужныеНастройки = Настройки.НастройкиПолучателейСообщений.НайтиСтроки(Отбор);
		Для Каждого Настройка Из НужныеНастройки Цикл
			
			Если ЗначениеЗаполнено(Настройка.Сотрудник) Тогда
				
				Если МассивСотрудников.Найти(Настройка.Сотрудник) = Неопределено Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь
					|ИЗ
					|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
					|ГДЕ
					|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник = &Сотрудник
					|	И ВЫБОР
					|			КОГДА &Отдел = ЗНАЧЕНИЕ(Справочник.CRM_Отделы.ПустаяСсылка)
					|				ТОГДА ИСТИНА
					|			ИНАЧЕ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел = &Отдел
					|		КОНЕЦ
					|	И (Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ПраваКЦАдминистратор = ИСТИНА
					|	ИЛИ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ПраваКЦМенеджер = ИСТИНА)
					|УПОРЯДОЧИТЬ ПО Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Наименование";
					Запрос.УстановитьПараметр("Сотрудник", Настройка.Сотрудник);
					Запрос.УстановитьПараметр("Отдел", ?(ЗначениеЗаполнено(Отдел), Отдел, Справочники.CRM_Отделы.ПустаяСсылка()));
					Результат = Запрос.Выполнить();
					Если НЕ Результат.Пустой() Тогда
						МассивСотрудников.Добавить(Настройка.Сотрудник);
					КонецЕсли;
				КонецЕсли;
				
			Иначе 
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник КАК Сотрудник
				|ИЗ
				|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
				|ГДЕ
				|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
				|	И Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник ЕСТЬ НЕ NULL 
				|	И ВЫБОР
				|			КОГДА &Отдел = ЗНАЧЕНИЕ(Справочник.CRM_Отделы.ПустаяСсылка)
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел = &Отдел
				|		КОНЕЦ
				|	И ВЫБОР
				|			КОГДА &ВыбранныйОтдел = ЗНАЧЕНИЕ(Справочник.CRM_Отделы.ПустаяСсылка)
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел = &ВыбранныйОтдел
				|		КОНЕЦ
				|	И ВЫБОР
				|			КОГДА &Должность = ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник.Должность = &Должность
				|		КОНЕЦ
				|	И ВЫБОР
				|			КОГДА &ДилерскийЦентр = ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.ПустаяСсылка)
				|				ТОГДА ИСТИНА
				|			ИНАЧЕ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ДилерскийЦентр = &ДилерскийЦентр
				|		КОНЕЦ
				|	И (Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ПраваКЦАдминистратор = ИСТИНА
				|	ИЛИ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ПраваКЦМенеджер = ИСТИНА)
				|УПОРЯДОЧИТЬ ПО Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник.Наименование";
				Запрос.УстановитьПараметр("Отдел",
				?(ЗначениеЗаполнено(Настройка.Отдел), Настройка.Отдел,Справочники.CRM_Отделы.ПустаяСсылка()));
				Запрос.УстановитьПараметр("ВыбранныйОтдел",
				?(ЗначениеЗаполнено(Отдел), Отдел, Справочники.CRM_Отделы.ПустаяСсылка()));
				Запрос.УстановитьПараметр("Должность",
				?(ЗначениеЗаполнено(Настройка.Должность), Настройка.Должность, Справочники.Должности.ПустаяСсылка()));
				Запрос.УстановитьПараметр("ДилерскийЦентр",
				?(ЗначениеЗаполнено(Настройка.ДилерскийЦентр), Настройка.ДилерскийЦентр, Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка()));
				Таблица = Запрос.Выполнить().Выгрузить();
				Для Каждого СтрокаРезультата Из Таблица Цикл
					
					Если МассивСотрудников.Найти(СтрокаРезультата.Сотрудник) = неопределено Тогда
						МассивСотрудников.Добавить(СтрокаРезультата.Сотрудник);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивСотрудников;
	
КонецФункции

