Процедура СоздатьСообщениеНоваяЗаявкаНаРезерв(Источник, СрокОтображенияДней = 0, МассивУдаляемыхВидов = Неопределено, МассивСообщений = Неопределено) Экспорт
	Если (Не(МассивУдаляемыхВидов = Неопределено)) И (Не(МассивСообщений = Неопределено))Тогда
		Для Каждого Сообщ Из МассивСообщений Цикл
			Если МассивУдаляемыхВидов.Найти(Сообщ.ВидСообщения) <> Неопределено Тогда
				СообщОб = Сообщ.получитьОбъект();
				СообщОб.Обработано = Истина;
				СообщОб.пометкаудаления = Истина;
				СообщОб.Записать();
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;		

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_РабочиеЛисты.ДилерскийЦентр
	               |ИЗ
	               |	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	               |ГДЕ
	               |	Renault_РабочиеЛисты.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", Источник.РабочийЛист);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		МассивПолучателей = НастройкиСотрудники(Справочники.Renault_ВидСообщения.Автосклад_НоваяЗаявкаНаРезерв, Выборка.ДилерскийЦентр);
		НовСообщение = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
		НовСообщение.Наименование = "Новая заявка на резерв";
		НовСообщение.ИдентификаторОбъекта = Строка(Источник.Ссылка.УникальныйИдентификатор());;
		НовСообщение.Обработано = Ложь;
		НовСообщение.ВидСообщения = Справочники.Renault_ВидСообщения.Автосклад_НоваяЗаявкаНаРезерв;
		//НовСообщение.ЗаполнитьДанными(ТекущаяДата(),"Новая заявка на резерв от менеджера " + Строка(Источник.Менеджер), СрокОтображенияДней,неопределено,СформироватьКлюч(Источник,Строка(Источник.Ссылка.УникальныйИдентификатор())));
		НовСообщение.ЗаполнитьДанными(ТекущаяДата(),"Новая заявка на резерв от менеджера " + Строка(Источник.Менеджер), неопределено, СрокОтображенияДней, неопределено, неопределено);
		ЗаполнитьАдресатовСообщения(НовСообщение,МассивПолучателей);
		НовСообщение.Записать();
	КонецЕсли;
	
