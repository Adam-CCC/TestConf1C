	МассивСообщений = Новый Массив();
	Зап = Новый Запрос("ВЫБРАТЬ
	                   |	Renault_СообщенияПользователю.Ссылка
	                   |ИЗ
	                   |	Справочник.Renault_СообщенияПользователю КАК Renault_СообщенияПользователю
