//События по Заявке на оборудование
Процедура Renault_События_ПриЗаписиЗаявиНаДилерскиеОпцииОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если не ЗначениеЗаполнено(Источник.Статус) тогда
		УстановитьСтатусЗаявкиНаОборудование(Источник);
	КонецЕсли;
	МассивВидовСобытий = Новый Массив();
	МассивВидовСобытий.Добавить(справочники.Renault_ВидСообщения.НоваяЗаявкаНаОпции);
	МассивВидовСобытий.Добавить(справочники.Renault_ВидСообщения.ОдобренаЗаявкаНаОпции);
	
	Если  (Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.НаРассмотрении)ИЛИ
		  (Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.Черновик) ИЛИ
		  (Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.ПустаяСсылка()) Тогда
		Сообщ = Неопределено;
		МассивПолучателей = НастройкиСотрудники(Справочники.Renault_ВидСообщения.НоваяЗаявкаНаОпции, Источник.ДилерскийЦентр);
		СоздаватьСобытие = Истина;
		Если ЗаписьСообщенияСуществует(Строка(Источник.Ссылка.УникальныйИдентификатор()), Сообщ) Тогда
			НовСообщение = Сообщ.ПолучитьОбъект();
			Если НовСообщение.ВидСообщения = справочники.Renault_ВидСообщения.ОдобренаЗаявкаНаОпции тогда
				НовСообщение.обработано = Истина;
				НовСообщение.Записать();
			иначе
				СоздаватьСобытие = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		если СоздаватьСобытие тогда
			НовСообщение = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			
			НовСообщение.ИдентификаторОбъекта = Строка(Источник.Ссылка.УникальныйИдентификатор());
			НовСообщение.Обработано = Ложь;
			НовСообщение.ВидСообщения = Справочники.Renault_ВидСообщения.НоваяЗаявкаНаОпции;
			НовСообщение.ЗаполнитьДанными(ТекущаяДата(), "Документ ""Заявка На Опции"" №" + Строка(Источник.номер) + " от " + Строка(Источник.Дата) + " Отправлен на оформление", неопределено, 0, неопределено, неопределено);
			ЗаполнитьАдресатовСообщения(НовСообщение,МассивПолучателей);
			НовСообщение.Записать();
		КонецЕсли;
	ИначеЕсли (Источник.Статус =  Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.Выполнена)ИЛИ
		(Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.Отменена)Тогда
		Сообщ = Неопределено;
		Если ЗаписьСообщенияСуществует(Строка(Источник.Ссылка.УникальныйИдентификатор()), Сообщ) Тогда
			НовСообщение = Сообщ.ПолучитьОбъект();
			
			//Если НовСообщение.ВидСообщения = справочники.Renault_ВидСообщения.НоваяЗаявкаНаОпции тогда
			НовСообщение.обработано = Истина;
			НовСообщение.Записать();
			//КонецЕсли;
			
