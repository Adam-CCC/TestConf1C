Процедура СоздатьСообщениеПоВыполниниюЗаявкиВАвтосервисСДопОборудованием(ИсточникСсылка, ВидСообщения)
	МассивПолучателей = НастройкиСотрудники(ВидСообщения, ИсточникСсылка.ДилерскийЦентр);
	
	Если МассивПолучателей.Количество() <> 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПРЕДСТАВЛЕНИЕ(Renault_CRM_ЗаявкаНаСервис.Автомобиль) КАК АвтомобильПредставление,
		               |	ПРЕДСТАВЛЕНИЕ(Renault_CRM_ЗаявкаНаСервис.Ссылка) КАК ЗаявкаНаСервисПредставление
		               |ИЗ
		               |	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис";
		Запрос.УстановитьПараметр("ЗаявкаНаСервис", ИсточникСсылка);
		Результат = Запрос.Выполнить(); 		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Сообщение = "Установлено доп. оборудование по заявке - " + Выборка.ЗаявкаНаСервисПредставление + ", на автомобиль " +
		Выборка.АвтомобильПредставление + ".";	
		
		НовСообщение = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
		НовСообщение.ИдентификаторОбъекта = Строка(ИсточникСсылка.УникальныйИдентификатор());	
		НовСообщение.Обработано = Ложь;	
		НовСообщение.ВидСообщения = ВидСообщения; 		
		НовСообщение.ЗаполнитьДанными(ТекущаяДата(), Сообщение, ИсточникСсылка.Автор, , , Неопределено);
		ЗаполнитьАдресатовСообщения(НовСообщение, МассивПолучателей);
		НовСообщение.Наименование = "Установка доп. оборудования по заявке на сервис.";
		НовСообщение.Записать();
	КонецЕсли; 	
КонецПроцедуры
