Процедура СоздатьСообщениеПоРаботеСЖалобами(Источник, ВидСообщения, ПараметрыСообщения) Экспорт
	
	МассивПолучателей = Новый Массив();
	
	Если ТипЗнч(ПараметрыСообщения.Исполнитель) = Тип("СправочникСсылка.CRM_Отделы") Тогда
		Пользователи = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(ПараметрыСообщения.Исполнитель);
	Иначе
		Пользователи = Новый СписокЗначений;
		Пользователи.Добавить(ПараметрыСообщения.Исполнитель);
	КонецЕсли;
	
	Для Каждого Стр Из Пользователи Цикл
		МассивПолучателей.Добавить(Стр.Значение);	
	КонецЦикла;
	
	НовСообщение = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	НовСообщение.ИдентификаторОбъекта = Строка(Источник.Ссылка.УникальныйИдентификатор());	
	НовСообщение.Обработано = Ложь;	
	НовСообщение.ВидСообщения = ВидСообщения;
	Сообщение = ПараметрыСообщения.Содержание;
	НовСообщение.ЗаполнитьДанными(ТекущаяДата(), Сообщение, ПараметрыСообщения.Автор, , , Неопределено);
	ЗаполнитьАдресатовСообщения(НовСообщение, МассивПолучателей);
	НовСообщение.Наименование = ПараметрыСообщения.Содержание;
	НовСообщение.Комментарий = ПараметрыСообщения.Комментарий;
	НовСообщение.Записать();	
	
КонецПроцедуры
 

Функция СообщениеУжеРанееСоздано(МассивСообщений,МассивИдентичныхВидовСообщений,ИсточникЗаписи = неопределено) Экспорт
	
	СообщениеУжеСоздано = Ложь;
	Для Каждого Сообщ Из МассивСообщений Цикл
		ВидСообщенияВМассиве = (МассивИдентичныхВидовСообщений.Найти(Сообщ.ВидСообщения) <> Неопределено);
		Если ВидСообщенияВМассиве Тогда
			Если Сообщ.ВидСообщения = Справочники.Renault_ВидСообщения.НовыйКлиентПереданМенеджеру Тогда
				Если ИсточникЗаписи <> неопределено Тогда
					Если (ИсточникЗаписи.Менеджер = Сообщ.получатель)И Не Сообщ.Обработано  Тогда
						СообщениеУжеСоздано = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Сообщ.ВидСообщения = Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера Тогда
				Если Не Сообщ.Обработано Тогда
					СообщениеУжеСоздано = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли Сообщ.ВидСообщения = Справочники.Renault_ВидСообщения.НовыйДоговорСКлиентом Тогда
				Если Не Сообщ.Обработано Тогда
					СообщениеУжеСоздано = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли Сообщ.ВидСообщения = Справочники.Renault_ВидСообщения.ОформленДоговорСКлиентом Тогда
				Если Не Сообщ.Обработано Тогда
					СообщениеУжеСоздано = Истина;
					Прервать;
				КонецЕсли;
			Иначе
				СообщениеУжеСоздано = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СообщениеУжеСоздано;
	
КонецФункции

Процедура ОзнакомилсяССобытием(Событие,Пользователь) Экспорт
	ПараметрыОтбор = Новый Структура();
	ПараметрыОтбор.Вставить("Сотрудник",Пользователь.Сотрудник);
	ПараметрыОтбор.Вставить("Ознакомлен",Ложь);
	СобытиеОб = Событие.Ссылка.ПолучитьОбъект();
	Строки = СобытиеОб.Адресаты.НайтиСтроки(ПараметрыОтбор);
	Если Строки.количество() = 0 Тогда
		ЗановоОзнакомитьсяССобытием(Событие,Пользователь);
	Иначе
		Для Каждого ТекСтрока из Строки Цикл
			ТекСтрока.Ознакомлен = Истина;
			ТекСтрока.ДатаОзнакомления = ТекущаяДата();
		КонецЦикла;
		СобытиеОб.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура ЗановоОзнакомитьсяССобытием(Событие,Пользователь) Экспорт
	ПараметрыОтбор = Новый Структура();
	ПараметрыОтбор.Вставить("Сотрудник",Пользователь.Сотрудник);
	ПараметрыОтбор.Вставить("Ознакомлен",Истина);
	СобытиеОб = Событие.Ссылка.ПолучитьОбъект();
	Строки = СобытиеОб.Адресаты.НайтиСтроки(ПараметрыОтбор);
	Если Строки.Количество()>0 Тогда
		Для Каждого ТекСтрока из Строки Цикл
			ТекСтрока.Ознакомлен = Ложь;
			ТекСтрока.ДатаОзнакомления = Дата(1,1,1,0,0,0);
		КонецЦикла;
		СобытиеОб.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьСтатусЗаявкиНаОборудование(Источник)Экспорт
	
	Если Источник.Черновик = Истина Тогда
		Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.Черновик;
	Иначе
		Если  Источник.Закрыта = Истина Тогда
			Если Источник.ВыполненаУспешно = Истина Тогда
				Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.Выполнена;
			Иначе
				Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.Отменена;
			КонецЕсли;
		Иначе
			Источник.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.НаРассмотрении;
		КонецЕсли;	
    КонецЕсли;	
КонецПроцедуры

