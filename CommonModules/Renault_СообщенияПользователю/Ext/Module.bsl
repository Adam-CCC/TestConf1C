//События по заявке на кредит
Процедура Renault_События_ПриЗаписиЗаявкиНаКредитОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда Возврат КонецЕсли;
	
	//Если не ЗначениеЗаполнено(Источник.Статус) тогда
	//	УстановитьСтатусЗаявкиНаКредит(Источник);
	//КонецЕсли;

	МассивВидовСобытий = Новый Массив();
	МассивВидовСобытий.Добавить(справочники.Renault_ВидСообщения.ОдобренаЗаявкаНаКредит);
	МассивВидовСобытий.Добавить(справочники.Renault_ВидСообщения.НоваяЗаявкаНаКредит);
	
	Если (ТипЗнч(Источник)=Тип("ДокументОбъект.Renault_РабочийЛистОФУ") И Источник.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.НаРассмотрении) 
		ИЛИ (ТипЗнч(Источник)=Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаКредит") И 
		(Источник.Статус=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.НаРассмотрении ИЛИ (Не Источник.Черновик И НЕ Источник.Закрыта И НЕ Источник.ВыполненаУспешно И НЕ Источник.Одобрена)))	
	Тогда
		Сообщ = Неопределено;
		МассивПолучателей = НастройкиСотрудники(Справочники.Renault_ВидСообщения.НоваяЗаявкаНаКредит,Источник.ДилерскийЦентр);
		СоздаватьСобытие = Истина;
		Если ЗаписьСообщенияСуществует(Строка(Источник.Ссылка.УникальныйИдентификатор()),Сообщ) Тогда
			НовСообщение =Сообщ.ПолучитьОбъект();
			ЕСли НовСообщение.ВидСообщения = справочники.Renault_ВидСообщения.ОдобренаЗаявкаНаКредит Тогда
				НовСообщение.обработано = Истина;
				НовСообщение.Записать();
			Иначе
				СоздаватьСобытие = Ложь;
			КонецЕсли;
		КонецЕсли;
		Если СоздаватьСобытие тогда
			НовСообщение = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			НовСообщение.ИдентификаторОбъекта = Строка(Источник.Ссылка.УникальныйИдентификатор());
			НовСообщение.Обработано = Ложь;
			НовСообщение.ВидСообщения = Справочники.Renault_ВидСообщения.НоваяЗаявкаНаКредит;
			НовСообщение.ЗаполнитьДанными(ТекущаяДата(),"Документ ""Заявка На Кредит"" №"+Строка(Источник.номер)+" от "+Строка(Источник.Дата)+" Отправлен на оформление",неопределено,0,неопределено,неопределено);
			ЗаполнитьАдресатовСообщения(НовСообщение,МассивПолучателей);
			НовСообщение.Записать();
		КонецЕсли;
	ИначеЕсли (	ТипЗнч(Источник)=Тип("ДокументОбъект.Renault_РабочийЛистОФУ") И Источник.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Одобрена) 
		ИЛИ( ТипЗнч(Источник)=Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаКредит") И 
			(Источник.Статус=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Одобрена ИЛИ (НЕ Источник.Черновик И НЕ Источник.Закрыта И НЕ Источник.ВыполненаУспешно И Источник.Одобрена) )
		) 
	Тогда	
		Сообщ = Неопределено;
		МассивПолучателей = НастройкиСотрудники(Справочники.Renault_ВидСообщения.ОдобренаЗаявкаНаКредит,Источник.ДилерскийЦентр);
		СоздаватьСобытие = Истина;
        Если ЗаписьСообщенияСуществует(Строка(Источник.Ссылка.УникальныйИдентификатор()),Сообщ) Тогда
			НовСообщение =Сообщ.ПолучитьОбъект();
			ЕСли НовСообщение.ВидСообщения = справочники.Renault_ВидСообщения.НоваяЗаявкаНаКредит Тогда
				НовСообщение.обработано = Истина;
				НовСообщение.Записать();
			Иначе
				СоздаватьСобытие = Ложь;
			КонецЕсли;
		КонецЕсли;
		Если СоздаватьСобытие Тогда
			НовСообщение = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			НовСообщение.ИдентификаторОбъекта = Строка(Источник.Ссылка.УникальныйИдентификатор());
			НовСообщение.Обработано = Ложь;
			НовСообщение.ВидСообщения = Справочники.Renault_ВидСообщения.ОдобренаЗаявкаНаКредит;
			НовСообщение.ЗаполнитьДанными(ТекущаяДата(),"Документ ""Заявка На Кредит"" №"+Строка(Источник.номер)+" от "+Строка(Источник.Дата)+" одобрен",неопределено,0,неопределено,неопределено);
			ЗаполнитьАдресатовСообщения(НовСообщение,МассивПолучателей);
			НовСообщение.Записать();
		КонецЕсли;
	Иначе	
	//ИначеЕсли  Источник.Черновик Или Источник.Закрыта ИЛИ источник.ВыполненаУспешно Тогда
		Сообщ = Неопределено;
		Если ЗаписьСообщенияСуществует(Строка(Источник.Ссылка.УникальныйИдентификатор()),Сообщ) Тогда
			НовСообщение =Сообщ.ПолучитьОбъект();
			НовСообщение.обработано = Истина;
			НовСообщение.Записать();			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

