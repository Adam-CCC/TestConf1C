	Если Источник.ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Источник.Статус) тогда
		УстановитьСтатусЗаявкиНаГарантию(Источник);
	КонецЕсли;

	МассивВидовСобытий = Новый Массив();
