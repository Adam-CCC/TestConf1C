		|	Статус
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСтатусов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСтатусов.Следующий() Цикл
		
		Отказ = Ложь;
		
		Попытка
			ОтразитьСтатусОтчетаПоРекламнойКампании("Регламентное задание",ВыборкаСтатусов.ОтчетПоКампании,ТекущаяДатаСеанса(),Справочники.DMS_СтатусыОтчетовПоРекламнойКампании.БезДействия,Отказ);		
		Исключение
			
			КодОсновногоЯзыка  = DMS_ОбменДаннымиСДМСервер.КодОсновногоЯзыка(); // Для записи события в журнал регистрации.
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Установка статуса <Без действия>'", КодОсновногоЯзыка),
				УровеньЖурналаРегистрации.Ошибка,,ВыборкаСтатусов.ОтчетПоКампании,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
			Продолжить;	
			
		КонецПопытки;
		
		КодОсновногоЯзыка  = DMS_ОбменДаннымиСДМСервер.КодОсновногоЯзыка(); // Для записи события в журнал регистрации.
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Установка статуса <Без действия>'", КодОсновногоЯзыка),
			УровеньЖурналаРегистрации.Информация,,ВыборкаСтатусов.ОтчетПоКампании,"Выполнено успешно");
			
	КонецЦикла;
	
КонецПроцедуры
 
