Процедура СформироватьУведомлениеИсполнителяОНовойЗадаче(Задача,Предмет = Неопределено) Экспорт 

	мЭлектронноеПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();
	мЭлектронноеПисьмо.Важность 	 = Перечисления.ВариантЗаписиЭлектронногоПисьма.ПоместитьВПапкуИсходящие;
	мЭлектронноеПисьмо.СтатусПисьма  = Перечисления.СтатусыСообщений.Исходящее;
	мЭлектронноеПисьмо.Автор 		 = Задача.Автор;
	мЭлектронноеПисьмо.УчетнаяЗапись = ПолучитьПерсональнуюУчетнуюЗаписьПользователя(Задача.Автор);
	мЭлектронноеПисьмо.Дата			 = ТекущаяДатаСеанса();
	
	Если Не ЗначениеЗаполнено(мЭлектронноеПисьмо.УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли; 
	
	НоваяСтрока = мЭлектронноеПисьмо.Получатели.Добавить();
	НоваяСтрока.АдресЭлектроннойПочты = ПолучитьEMailПолучателя(Задача.Исполнитель);
	НоваяСтрока.Представление 		  = СокрЛП(Задача.Исполнитель.Наименование);
	НоваяСтрока.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
	
	мЭлектронноеПисьмо.ПолучателиПредставление = мЭлектронноеПисьмо.ПредставлениеПолучателей();

	мЭлектронноеПисьмо.ОтправительПредставление = ПолучитьПредставлениеДляУчетнойЗаписи(мЭлектронноеПисьмо.УчетнаяЗапись);
	
	мЭлектронноеПисьмо.Тема = СокрЛП(Задача.БизнесПроцесс);
	
	мЭлектронноеПисьмо.ТекстПисьма = СокрЛП(Задача.Наименование);
	
	мЭлектронноеПисьмо.ДатаОтправления = ТекущаяДатаСеанса();
	мЭлектронноеПисьмо.ПодразделениеКомпании = Задача.Автор.Подразделение;
	мЭлектронноеПисьмо.УстановитьНовыйНомер();
	мЭлектронноеПисьмо.Записать(РежимЗаписиДокумента.Запись);
	мЭлектронноеПисьмо.ФорматТекста = Перечисления.ФорматТекста.ПростойТекст;
	
	СтруктураРежимовОбмена = Новый Структура("Получить, Отправить", Ложь, Истина);
	СоединениеСПочтовымСервером = эпПодключитьсяКПочтовомуСерверу(мЭлектронноеПисьмо.УчетнаяЗапись, СтруктураРежимовОбмена);
	Если СоединениеСПочтовымСервером <> Неопределено Тогда
		Если эпОтправитьПисьмо(мЭлектронноеПисьмо, СоединениеСПочтовымСервером) Тогда
			эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
		Иначе
			эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПредставлениеДляУчетнойЗаписи(УчетнаяЗапись)

	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеЗаписиЭлектроннойПочты.Пользователь,
	|	УчетныеЗаписиЭлектроннойПочты.АдресЭлектроннойПочты
	|ИЗ
	|	Справочник.УчетныеЗаписиЭлектроннойПочты КАК УчетныеЗаписиЭлектроннойПочты
	|ГДЕ
	|	УчетныеЗаписиЭлектроннойПочты.Ссылка = &УчетнаяЗапись";
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Представление = СокрЛП(Выборка.Пользователь);
	Если ПустаяСтрока(Представление) Тогда
		Возврат Выборка.АдресЭлектроннойПочты;
	Иначе
		Возврат Представление + " <" + Выборка.АдресЭлектроннойПочты + ">";
	КонецЕсли;

КонецФункции

Функция ПолучитьПерсональнуюУчетнуюЗаписьПользователя(Пользователь)
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Пользователь.Сотрудник);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
		|	CRM_ПользовательскиеДанныеСотрудников.УчетнаяЗаписьПочты КАК УчетнаяЗапись
		|ИЗ
		|	РегистрСведений.CRM_ПользовательскиеДанныеСотрудников КАК CRM_ПользовательскиеДанныеСотрудников
		|ГДЕ
		|	CRM_ПользовательскиеДанныеСотрудников.Сотрудник = &Сотрудник";
	
	РезультатЗапроса = Запрос.Выполнить();
	
