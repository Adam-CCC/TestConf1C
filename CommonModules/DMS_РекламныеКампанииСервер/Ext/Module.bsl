Процедура ОтразитьРекламныеКампании(ДополнительныеСвойства, Движения, Отказ) Экспорт

	ТаблицаРекламныеКампании = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаРекламныеКампании;
	
	Если Отказ ИЛИ ТаблицаРекламныеКампании.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияРекламныеКампании = Движения.DMS_РекламныеКампании;
	ДвиженияРекламныеКампании.Записывать = Истина;
	ДвиженияРекламныеКампании.Загрузить(ТаблицаРекламныеКампании);
	
КонецПроцедуры

Процедура ОтразитьРекламныеКампанииПредставителей(ДополнительныеСвойства, Движения, Отказ) Экспорт

	ТаблицаРекламныеКампанииПредставителей = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаРекламныеКампанииПредставителей;
	
	Если Отказ ИЛИ ТаблицаРекламныеКампанииПредставителей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияРекламныеКампанииПредставителей = Движения.DMS_РекламныеКампанииПредставителей;
	ДвиженияРекламныеКампанииПредставителей.Записывать = Истина;
	ДвиженияРекламныеКампанииПредставителей.Загрузить(ТаблицаРекламныеКампанииПредставителей);
	
КонецПроцедуры

Процедура ОтразитьСтатусМакетаРекламнойКампании(Установил,Макет,ДатаСобытия,Статус,Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Установил", 		   Установил);
	Запрос.УстановитьПараметр("РекламнаяКампания", Макет.РекламнаяКампания);
	Запрос.УстановитьПараметр("Макет", 			   Макет);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыМакетовРекламныхКампаний.Период,
		|	СтатусыМакетовРекламныхКампаний.РекламнаяКампания,
		|	СтатусыМакетовРекламныхКампаний.МакетРекламнойКампании,
		|	СтатусыМакетовРекламныхКампаний.Статус,
		|	СтатусыМакетовРекламныхКампаний.Установил
		|ИЗ
		|	РегистрСведений.DMS_СтатусыМакетовРекламныхКампаний КАК СтатусыМакетовРекламныхКампаний
		|ГДЕ
		|	СтатусыМакетовРекламныхКампаний.МакетРекламнойКампании = &Макет
		|	И СтатусыМакетовРекламныхКампаний.Установил = &Установил
		|	И СтатусыМакетовРекламныхКампаний.РекламнаяКампания = &РекламнаяКампания";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.DMS_СтатусыМакетовРекламныхКампаний.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РекламнаяКампания.Установить(Выборка.РекламнаяКампания);
		НаборЗаписей.Отбор.МакетРекламнойКампании.Установить(Выборка.МакетРекламнойКампании);
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		НаборЗаписей.Записать(Истина);
	
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.DMS_СтатусыМакетовРекламныхКампаний.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.РекламнаяКампания.Установить(Макет.РекламнаяКампания);
	НаборЗаписей.Отбор.МакетРекламнойКампании.Установить(Макет);
	НаборЗаписей.Отбор.Период.Установить(ДатаСобытия);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.РекламнаяКампания = Макет.РекламнаяКампания;
	НоваяЗапись.МакетРекламнойКампании = Макет;
	НоваяЗапись.Период 			  = ДатаСобытия;
	НоваяЗапись.Статус 			  = Статус;
	НоваяЗапись.Установил 		  = Установил;
	
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		Отказ = Истина;
		
		Если ТипЗнч(Установил) = Тип("Строка") Тогда
			Возврат;
		КонецЕсли; 
		
		ЗаписьЖурналаРегистрации("Запись статуса макета рекламной кампании",УровеньЖурналаРегистрации.Ошибка,,Установил,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтразитьСтатусОтчетаПоРекламнойКампании(Установил,Отчет,ДатаСобытия,Статус,Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Установил", 		   Установил);
	Запрос.УстановитьПараметр("РекламнаяКампания", Отчет.РекламнаяКампания);
	Запрос.УстановитьПараметр("ОтчетПоКампании",   Отчет);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыОтчетовПоРекламнойКампании.Период,
		|	СтатусыОтчетовПоРекламнойКампании.РекламнаяКампания,
		|	СтатусыОтчетовПоРекламнойКампании.Статус,
		|	СтатусыОтчетовПоРекламнойКампании.Установил,
		|	СтатусыОтчетовПоРекламнойКампании.ОтчетПоКампании
		|ИЗ
		|	РегистрСведений.DMS_СтатусыОтчетовПоРекламнойКампании КАК СтатусыОтчетовПоРекламнойКампании
		|ГДЕ
		|	СтатусыОтчетовПоРекламнойКампании.РекламнаяКампания = &РекламнаяКампания
		|	И СтатусыОтчетовПоРекламнойКампании.Установил = &Установил
		|	И СтатусыОтчетовПоРекламнойКампании.ОтчетПоКампании = &ОтчетПоКампании";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.DMS_СтатусыОтчетовПоРекламнойКампании.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.РекламнаяКампания.Установить(Выборка.РекламнаяКампания);
		НаборЗаписей.Отбор.ОтчетПоКампании.Установить(Выборка.ОтчетПоКампании);
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		НаборЗаписей.Записать(Истина);
	
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.DMS_СтатусыОтчетовПоРекламнойКампании.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.РекламнаяКампания.Установить(Отчет.РекламнаяКампания);
	НаборЗаписей.Отбор.ОтчетПоКампании.Установить(Отчет);
	НаборЗаписей.Отбор.Период.Установить(ДатаСобытия);
	
	НоваяЗапись = НаборЗаписей.Добавить();
	НоваяЗапись.РекламнаяКампания = Отчет.РекламнаяКампания;
	НоваяЗапись.ОтчетПоКампании	  = Отчет;
	НоваяЗапись.Период 			  = ДатаСобытия;
	НоваяЗапись.Статус 			  = Статус;
	НоваяЗапись.Установил 		  = Установил;
	
	Попытка
		НаборЗаписей.Записать(Истина);
	Исключение
		Отказ = Истина;
		ЗаписьЖурналаРегистрации("Запись статуса отчета по рекламной кампании",УровеньЖурналаРегистрации.Ошибка,,Установил,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УсловноеОформлениеСпискаМакетовРекламнойКампании(Форма) Экспорт

	Элементы = Форма.Элементы;
	УсловноеОформление = Форма.УсловноеОформление;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтатусыМакетов.Ссылка КАК Статус
		|ИЗ
		|	Справочник.DMS_СтатусыМакетовРекламнойКампании КАК СтатусыМакетов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Статус
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСтатусов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСтатусов.Следующий() Цикл
		
		Статус = ВыборкаСтатусов.Статус;
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТекущийСтатус.Имя);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ТекущийСтатус");
		ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = ВыборкаСтатусов.Статус;
		
		ЦветФона   = Статус.ЦветФона.Получить();
		ЦветТекста = Статус.ЦветТекста.Получить();
		Шрифт	   = Статус.ШрифтТекста.Получить();
		
		Если ЦветТекста <> Неопределено Тогда
			Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);
		КонецЕсли; 
		
		Если ЦветФона <> Неопределено Тогда
			Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
		КонецЕсли; 
		
		Если Шрифт <> Неопределено Тогда
			Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Шрифт);
		КонецЕсли; 
		
	КонецЦикла;
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДилерскийЦентр.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ДилерскийЦентр");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<Для всех>");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.DMS_ТекстЗапрещеннойЯчейкиЦвет);
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	Для каждого ТекущийЭлемент Из Элементы.Список.ПодчиненныеЭлементы Цикл
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ТекущийЭлемент.Имя);
	КонецЦикла; 
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ПометкаУдаления");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.DMS_ТекстЗапрещеннойЯчейкиЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", 	 ШрифтыСтиля.DMS_УдаленныйДополнительныйРеквизитШрифт);
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТекущийСтатус.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ТекущийСтатус");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Справочники.DMS_СтатусыМакетовРекламнойКампании.БезДействия;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ПометкаУдаления");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "Без действия");
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТекущийСтатус.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ТекущийСтатус");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Справочники.DMS_СтатусыМакетовРекламнойКампании.ВАрхиве;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ПометкаУдаления");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "В архиве");
	
	//
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ТекущийСтатус.Имя);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ТекущийСтатус");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеВСписке;
	
	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить(Справочники.DMS_СтатусыМакетовРекламнойКампании.ВАрхиве);
	СписокСтатусов.Добавить(Справочники.DMS_СтатусыМакетовРекламнойКампании.БезДействия);
	
	ОтборЭлемента.ПравоеЗначение = СписокСтатусов;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ПометкаУдаления");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "Удален");
	
КонецПроцедуры

