Процедура УстановкаСтатусаБезДействия() Экспорт
		
	УстановкаСтатусаБезДействияМакетам();
	
	УстановкаСтатусаБезДействияОтчетам();
	
КонецПроцедуры

Процедура УстановкаСтатусаБезДействияМакетам()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтатусыМакетов.Период,
		|	СтатусыМакетов.РекламнаяКампания КАК РекламнаяКампания,
		|	СтатусыМакетов.МакетРекламнойКампании КАК МакетРекламнойКампании,
		|	СтатусыМакетов.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.DMS_СтатусыМакетовРекламныхКампаний.СрезПоследних КАК СтатусыМакетов
		|ГДЕ
		|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(СтатусыМакетов.Период, ДЕНЬ), НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), ДЕНЬ) > 3
		|	И СтатусыМакетов.Статус <> ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.Согласован)
		|	И СтатусыМакетов.Статус <> ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.БезДействия)
		|			И СтатусыМакетов.Статус <> ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.ВАрхиве)
		|
		|УПОРЯДОЧИТЬ ПО
		|	РекламнаяКампания,
		|	МакетРекламнойКампании,
		|	Статус
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСтатусов = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаСтатусов.Следующий() Цикл
		
		Отказ = Ложь;
		
		Попытка
			ОтразитьСтатусМакетаРекламнойКампании("Регламентное задание",ВыборкаСтатусов.МакетРекламнойКампании,ТекущаяДатаСеанса(),Справочники.DMS_СтатусыМакетовРекламнойКампании.БезДействия,Отказ);		
		Исключение
			
			КодОсновногоЯзыка  = DMS_ОбменДаннымиСДМСервер.КодОсновногоЯзыка(); // Для записи события в журнал регистрации.
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Установка статуса <Без действия>'", КодОсновногоЯзыка),
				УровеньЖурналаРегистрации.Ошибка,,ВыборкаСтатусов.МакетРекламнойКампании,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
			Продолжить;	
			
		КонецПопытки;
		
		КодОсновногоЯзыка  = DMS_ОбменДаннымиСДМСервер.КодОсновногоЯзыка(); // Для записи события в журнал регистрации.
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Установка статуса <Без действия>'", КодОсновногоЯзыка),
			УровеньЖурналаРегистрации.Информация,,ВыборкаСтатусов.МакетРекламнойКампании,"Выполнено успешно");
			
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановкаСтатусаБезДействияОтчетам()
	
