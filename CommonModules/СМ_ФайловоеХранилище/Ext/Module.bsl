Функция УдалитьФотоАвтомобиля(Вин,Гуид) Экспорт

	ПолноеИмяУдаляемогоФайла = СокрЛП(Константы.ПустьКХранилищюСканов.Получить())+"\"+СокрЛП(ОбщиеСервер.ПолучитьИмяИБ())+"\carphoto\"+СокрЛП(Вин)+"\"+СокрЛП(Гуид)+".jpg";
	УдаляемыйФайл = Новый Файл(ПолноеИмяУдаляемогоФайла);
	
	ОписаниеОшибки = "";
	
	Если УдаляемыйФайл.Существует() Тогда
  		Попытка
 			УдалитьФайлы(УдаляемыйФайл.Путь,УдаляемыйФайл.Имя);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;
	
	Возврат ОписаниеОшибки;

КонецФункции // УдалитьФотоАвтомобиля(Вин,Гуид)

Функция ПолучитьФотоАвтомобиля(Вин,Гуид) Экспорт

	ПолноеИмяФайла = СокрЛП(Константы.ПустьКХранилищюСканов.Получить())+"\"+СокрЛП(ОбщиеСервер.ПолучитьИмяИБ())+"\carphoto\"+СокрЛП(Вин)+"\"+СокрЛП(Гуид)+".jpg";
	ПолучаемыйФайл = Новый Файл(ПолноеИмяФайла);
	
	ОписаниеОшибки = "";
	
	Если ПолучаемыйФайл.Существует() Тогда
  		Возврат СМГ_ПолучитьДвоичныеДанныеИзФайла(ПолучаемыйФайл.ПолноеИмя);
 	КонецЕсли;
	
	Возврат "";

КонецФункции // ПолучитьФотоАвтомобиля(Вин,Гуид)
