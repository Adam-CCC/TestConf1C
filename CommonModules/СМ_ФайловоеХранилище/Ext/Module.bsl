Функция СохранитьФотоАвтомобиля(ДвоичныеДанныеФайла,Вин,Гуид) Экспорт 
	
	ОписаниеОшибки = "";
	
	ДвоичныеДанные = ДвоичныеДанныеФайла.Получить(); 
 	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	
	Если ПустаяСтрока(ИмяВременногоФайла) Тогда Возврат Неопределено; КонецЕсли;
	
	Попытка
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	
 	КаталогНаДиске = Новый Файл(Константы.ПустьКХранилищюСканов.Получить()+"\"+ОбщиеСервер.ПолучитьИмяИБ()+"\carphoto\"+Вин);
	
	Если  НЕ КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(КаталогНаДиске.ПолноеИмя);
	КонецЕсли;	
	
 	ИмяФайлаАвто = КаталогНаДиске.ПолноеИмя+"\"+Гуид+".jpg"; 
	
	Если ПустаяСтрока(ИмяФайлаАвто) Тогда Возврат Неопределено; КонецЕсли;
	
    ОписаниеОшибки = СМГ_СжатьИзображение(ИмяВременногоФайла,"1920x1920",ИмяФайлаАвто);			
	
 	Попытка	УдалитьФайлы(ИмяВременногоФайла); Исключение КонецПопытки;          
 	
	Возврат ИмяФайлаАвто;
	
КонецФункции //СкопироватьНаСервер()	
