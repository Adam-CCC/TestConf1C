Функция СМГ_СжатьИзображение(ИмяИсходногоФайла,Разрешение,ИмяРезультирующегоФайла) Экспорт
	
	ОписаниеОшибки = "";
  	
 	ИмяКоманды = """C:\Program Files\ImageMagick\magick.exe"""+" """+ИмяИсходногоФайла+""" -resize "+Разрешение+" "+ИмяРезультирующегоФайла;
	
	Попытка
		ОбщиеСервер.ВыполнитьКомандуНаСервере(ИмяКоманды,ОписаниеОшибки);
 	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка конвертора", УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки);
 	КонецПопытки;	
	
	Возврат ОписаниеОшибки;		
 
КонецФункции // СжатьИзображение()
