Функция УдалениеФотоАвтоПоРеквизитуURLудалить(URLудалить) Экспорт
	
	ИмяБазыДанных = СокрЛП(ОбщиеСервер.ПолучитьИмяИБ());
	
	Если ИмяБазыДанных <> "ALFAAUTO" Тогда
		ИмяБазыДанных = "ALFAAUTO";	
 	КонецЕсли;
	
	ПолнИмяУдаляемогоФайла = СокрЛП(Константы.ПустьКХранилищюСканов.Получить())+"\"+ИмяБазыДанных+"\"+СокрЛП(URLудалить);
	УдФайл = Новый Файл(ПолнИмяУдаляемогоФайла);
 	
	ОписаниеОшибки = "";
	
	Если УдФайл.Существует() Тогда 
		УдФайлПуть = СокрЛП(УдФайл.Путь);
		УдФайлИмя = СокрЛП(УдФайл.Имя);	
		Если НЕ обЗначениеНеЗаполнено(УдФайлИмя) Тогда
			Если НЕ обЗначениеНеЗаполнено(УдФайлПуть) Тогда		
				Попытка
					УдалитьФайлы(УдФайл.Путь,УдФайл.Имя);
				Исключение
					ОписаниеОшибки = ОписаниеОшибки();
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОписаниеОшибки;

КонецФункции // УдалениеФотоАвтоПоРеквизитуURLудалить(URLудалить)
