Процедура ПроверкаТабличнойЧастиТоварыНаКорректноеЗаполнение(Отказ, РежимЗаписи, РежимПроведения, ЭтотОбъект) Экспорт	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	SM_СлужебныеМетодыКлиентСервер.ОтключитьАвтоматическуюЗаменуЕдиницИзмеренияИСумм(ЭтотОбъект);
	ТаблицаЗначенийТовары	= ЭтотОбъект.Товары.Выгрузить();
	ПараметрыПроверки		= SM_СлужебныеМетодыФормСервер.ПроверитьТабличнуюЧастьТовары(ТаблицаЗначенийТовары);  
	
	Если ПараметрыПроверки.ЕстьОшибки Тогда
		ТекстОшибки = СформироватьТекстОшибки(ЭтотОбъект, ПараметрыПроверки);    
		Сообщить(ТекстОшибки);
		Отказ = Истина;
		Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство(SM_СлужебныеМетодыФормСервер.ПолучитьИмяДополнительногоСвойства_2()) Тогда
			Если SM_СлужебныеМетодыФормСервер.ЭтоПолныеПрава() Тогда
				ЗадатьВопросНаОтменуОшибки(Отказ);
			КонецЕсли;                          
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры   

Функция СформироватьТекстОшибки(ЭтотОбъект, ПараметрыПроверки)	
	Товары      = ЭтотОбъект.Товары;
	ТекстОшибки = "";
	
	Если ПараметрыПроверки.НомераСтрокСОшибкамиЕдиниц.Количество() > 0 Тогда
		ТекстОшибки = ТекстОшибки + "Проверка №1. В поступлении присутствуют позиции с несоответствием единиц измерения:" + Символы.ПС;
		
		Для Каждого ИндексСтроки Из ПараметрыПроверки.НомераСтрокСОшибкамиЕдиниц Цикл
			СтрокаТовара		= Товары[ИндексСтроки];
			НомерСтроки			= СтрокаТовара.НомерСтроки;
			ТекущаяЕдиница		= СтрокаТовара.ЕдиницаИзмерения;
			БазоваяЕдиница		= СтрокаТовара.Номенклатура.ОсновнаяЕдиницаИзмерения;
			
			ТекстОшибки = ТекстОшибки + СтрШаблон("Строка %1: указана единица <%2 %3>, а основная единица измерения в карточке номенклатуры <%4 %5>.",
											 	   НомерСтроки,ТекущаяЕдиница,ТекущаяЕдиница.Код,БазоваяЕдиница,БазоваяЕдиница.Код) + Символы.ПС;
		КонецЦикла;	
	КонецЕсли;
	
	Если ПараметрыПроверки.ОшибкиРасчетаСуммы.Количество() > 0 Тогда
		ТекстОшибки = ТекстОшибки + "Проверка №2. Цена не равна расчетной цене:" + Символы.ПС;
		
		Для Каждого КлючИЗначение Из ПараметрыПроверки.ОшибкиРасчетаСуммы Цикл
			ИндексСтроки	= КлючИЗначение.Ключ;
			ДанныеРасчета	= КлючИЗначение.Значение;
			СтрокаТовара	= Товары[ИндексСтроки];
			НомерСтроки		= СтрокаТовара.НомерСтроки;
			ЦенаСтроки		= Формат(ДанныеРасчета.Цена			, "ЧДЦ=2");
			ЦенаРасчетная	= Формат(ДанныеРасчета.РасчетЦены	, "ЧДЦ=2");
			
			ТекстОшибки = ТекстОшибки + СтрШаблон("Строка %1: цена по документу <%2>, а расчетная цена <%3>.",
												   НомерСтроки,ЦенаСтроки,ЦенаРасчетная) + Символы.ПС;
		КонецЦикла;	
	КонецЕсли;
	
	ТекстОшибки = ТекстОшибки + "Проведение отменено. Проверьте количество, цену и единицы измерения.";
	
	Возврат ТекстОшибки;		
КонецФункции

Процедура ЗадатьВопросНаОтменуОшибки(Отказ)
	Ответ = Вопрос("Выявлены ошибки, указанные в служебном сообщении. Продолжить запись?",РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Отказ = Ложь;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПодстановкаПартииНеФИФОМаркировка(ЭтотОбъект) Экспорт	
	Если Не ТабличныеЧастиПрисутствуют(ЭтотОбъект) Тогда 
		Возврат;
	КонецЕсли;
	
	СкладКомпании		= ЭтотОбъект.СкладКомпании;
	Товары              = ЭтотОбъект.Товары;
	КодыМаркировки      = ЭтотОбъект.КодыМаркировки;
	КопияТабличнойЧасти = Товары.ВыгрузитьКолонки();
	ОтменитьОбработку   = Ложь;
		
	Для Каждого СтрокаТовара Из Товары Цикл
		Номенклатура        = СтрокаТовара.Номенклатура;    
		ИдентификаторТовара = СтрокаТовара.ИдентификаторТовара;
		
		Если Не SM_СлужебныеМетодыФормСервер.ЭтоМаркированнаяНоменклатура(Номенклатура) Тогда
			НоваяСтрока = КопияТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовара); 
			Продолжить;
		КонецЕсли; 
		
		КодыМаркировкиПоТекущейСтроке = КодыМаркировки.НайтиСтроки(Новый Структура("ИдентификаторТовара", ИдентификаторТовара));
		
		Если КодыМаркировкиПоТекущейСтроке.Количество() = 0 Тогда
			ОтменитьОбработку = Истина;
			Прервать;
		КонецЕсли;
		
		Для Каждого СтрокаМаркировки Из КодыМаркировкиПоТекущейСтроке Цикл
			ТекущийКодМаркировки = СтрокаМаркировки.КодМаркировки;
			ПартияМаркировки     = ПолучитьПартиюМаркировкиТекущейСтроки(Номенклатура, ТекущийКодМаркировки,СкладКомпании);
			
			Если ПартияМаркировки = Неопределено Тогда
				ПоискТекущейСтрокиВКопии = КопияТабличнойЧасти.Найти(СтрокаТовара.ИдентификаторТовара,"ИдентификаторТовара");
				Если ПоискТекущейСтрокиВКопии = Неопределено Тогда
					ЗаполнитьЗначенияСвойств(КопияТабличнойЧасти.Добавить(), СтрокаТовара);
				КонецЕсли;
				Продолжить;
			КонецЕсли;  
			
			ПоискСтрокиСТекущейПартией = КопияТабличнойЧасти.Найти(ПартияМаркировки,"Партия");
			
			Если ПоискСтрокиСТекущейПартией = Неопределено Тогда
				НоваяСтрокаТоваров                     = КопияТабличнойЧасти.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, СтрокаТовара);
				УникальныйИдентификатор                = Строка(Новый УникальныйИдентификатор);
				НоваяСтрокаТоваров.ИдентификаторТовара = УникальныйИдентификатор;
				СтрокаМаркировки.ИдентификаторТовара   = УникальныйИдентификатор;
				НоваяСтрокаТоваров.Партия              = ПартияМаркировки;
			Иначе
				СтрокаМаркировки.ИдентификаторТовара	= ПоискСтрокиСТекущейПартией.ИдентификаторТовара;
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла;
	
	Если Не ОтменитьОбработку Тогда
		Товары.Загрузить(КопияТабличнойЧасти);
	КонецЕсли;
КонецПроцедуры

Функция ТабличныеЧастиПрисутствуют(ЭтотОбъект)
	Возврат ЭтотОбъект.Метаданные().ТабличныеЧасти.Найти("Товары")			<> Неопределено
		  И ЭтотОбъект.Метаданные().ТабличныеЧасти.Найти("КодыМаркировки")	<> Неопределено; 
КонецФункции
	  
Функция СоздатьТаблицуСравненияДанных(ЭтотОбъект) Экспорт
	Товары				= ЭтотОбъект.Товары;
	ОписаниеТиповПартии = Товары.ВыгрузитьКолонки("Партия").Колонки.Партия.ТипЗначения;
	
	СравнениеДанных		= Новый ТаблицаЗначений;
	СравнениеДанных.Колонки.Добавить("СтрокаТоваровДо"				,Новый ОписаниеТипов("Строка"));
	СравнениеДанных.Колонки.Добавить("СтрокаТоваровПартияДо"		,ОписаниеТиповПартии);
	СравнениеДанных.Колонки.Добавить("СтрокаТоваровПричинаДо"		,Новый ОписаниеТипов("Строка"));
	СравнениеДанных.Колонки.Добавить("СтрокаТоваровПосле"			,Новый ОписаниеТипов("Строка"));
	СравнениеДанных.Колонки.Добавить("СтрокаТоваровПартияПосле"		,ОписаниеТиповПартии);
	СравнениеДанных.Колонки.Добавить("СтрокаТоваровПричинаПосле"	,Новый ОписаниеТипов("Строка"));
	
	Возврат СравнениеДанных;
КонецФункции 

Функция ДобавитьСтрокуВТаблицуСравненияДанных(СравнениеДанных,Параметры) Экспорт
	НоваяСтрока	= СравнениеДанных.Добавить();
	Для Каждого Строка Из Параметры Цикл 
		Если Строка.Значение <> Неопределено Тогда
			НоваяСтрока[Строка.Ключ] = Строка.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока;
КонецФункции

Процедура ОбновитьСтрокуВТаблицуСравненияДанных(СтрокаСравнениеДанных,Параметры) Экспорт	
	Для Каждого Строка Из Параметры Цикл 
		Если Строка.Значение <> Неопределено Тогда
			СтрокаСравнениеДанных[Строка.Ключ] = Строка.Значение;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 

Функция ПолучитьСтруктуруПараметров() Экспорт
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СтрокаТоваровДо"				, Неопределено);
	СтруктураПараметров.Вставить("СтрокаТоваровПартияДо"		, Неопределено);
	СтруктураПараметров.Вставить("СтрокаТоваровПричинаДо"		, Неопределено);
	СтруктураПараметров.Вставить("СтрокаТоваровПосле"			, Неопределено);
	СтруктураПараметров.Вставить("СтрокаТоваровПартияПосле"		, Неопределено);
	СтруктураПараметров.Вставить("СтрокаТоваровПричинаПосле"	, Неопределено);  
	
	Возврат СтруктураПараметров;
КонецФункции

Функция ПолучитьПартиюМаркировкиТекущейСтроки(Номенклатура,КодМаркировки,Склад)	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SM_ОстаткиКодовМаркировкиОстатки.Склад КАК Склад,
		|	SM_ОстаткиКодовМаркировкиОстатки.Номенклатура КАК Номенклатура,
		|	SM_ОстаткиКодовМаркировкиОстатки.Партия КАК Партия,
		|	SM_ОстаткиКодовМаркировкиОстатки.КодМаркировки КАК КодМаркировки,
		|	SM_ОстаткиКодовМаркировкиОстатки.ОбъемОстаток КАК ОбъемОстаток,
		|	SM_ОстаткиКодовМаркировкиОстатки.ВРезервеОстаток КАК ВРезервеОстаток
		|ИЗ
		|	РегистрНакопления.SM_ОстаткиКодовМаркировки.Остатки КАК SM_ОстаткиКодовМаркировкиОстатки
		|ГДЕ
		|	SM_ОстаткиКодовМаркировкиОстатки.Номенклатура = &Номенклатура
		|	И SM_ОстаткиКодовМаркировкиОстатки.КодМаркировки = &КодМаркировки
		|	И SM_ОстаткиКодовМаркировкиОстатки.ОбъемОстаток > 0
		|	И SM_ОстаткиКодовМаркировкиОстатки.Склад = &Склад";
	
	Запрос.УстановитьПараметр("Номенклатура"	, Номенклатура);
	Запрос.УстановитьПараметр("КодМаркировки"	, КодМаркировки);
	Запрос.УстановитьПараметр("Склад"			, Склад);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Если РезультатЗапроса.Количество() <> 0 Тогда
		Возврат РезультатЗапроса[0].Партия;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции