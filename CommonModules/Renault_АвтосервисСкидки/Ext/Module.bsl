	//КонецЕсли;
	
КонецПроцедуры

Процедура Renault_ЗаписатьОстатокБаллов(Контрагент, КартаЛояльности, КоличествоБалловСписано, КоличествоБалловНачислено, ЗаказНаряд = Неопределено, ЗаявкаНаСервис = Неопределено, Предварительно = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(ЗаявкаНаСервис) Тогда
		
		ДокументСсылка = Документы.Renault_СписаниеНачислениеБаллов.НайтиПоРеквизиту("ЗаявкаНаСервис", ЗаявкаНаСервис);
		
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			
			Документ = ДокументСсылка.Ссылка.ПолучитьОбъект();
			
		Иначе
			
			Документ = Документы.Renault_СписаниеНачислениеБаллов.СоздатьДокумент();
			Документ.Ответственный = ПараметрыСеанса.Пользователь;
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
			
			ДокументСсылка = Документы.Renault_СписаниеНачислениеБаллов.НайтиПоРеквизиту("ЗаказНаряд", ЗаказНаряд);
			
			Если Не ЗначениеЗаполнено(ДокументСсылка) 
				И ЕстьВыдачаИлиЗаменаНаОснованииЗаказНаряда(ЗаказНаряд) Тогда
				Возврат;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				
				Документ = ДокументСсылка.Ссылка.ПолучитьОбъект();
				Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				
			Иначе
				
				Документ = Документы.Renault_СписаниеНачислениеБаллов.СоздатьДокумент();
				Документ.Ответственный = ПараметрыСеанса.Пользователь;
				
			КонецЕсли;
			
		Иначе
			
			Документ = Документы.Renault_СписаниеНачислениеБаллов.СоздатьДокумент();
			Документ.Ответственный = ПараметрыСеанса.Пользователь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоличествоБалловСписано) Тогда
		
		Документ.КоличествоБалловСписано = КоличествоБалловСписано;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КоличествоБалловНачислено) Тогда
		
		Документ.КоличествоБалловНачислено = КоличествоБалловНачислено;
		
		Если ЗначениеЗаполнено(КартаЛояльности.ПрограммаЛояльности.СрокДействияБаллов) Тогда
			
			Документ.ПогаситьДо = КонецДня(ТекущаяДата() + КартаЛояльности.ПрограммаЛояльности.СрокДействияБаллов * 60 * 60 * 24);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Документ.Дата = ТекущаяДата();
	Документ.КартаЛояльности = КартаЛояльности;
	Документ.Контрагент = Контрагент;
	
	Если Документ.ЭтоНовый() Тогда //DMS+
		Документ.УстановитьНовыйНомер();
		Документ.Ответственный = ПараметрыСеанса.Пользователь;
	КонецЕсли; //DMS- 
	
	Документ.ЗаказНаряд = ЗаказНаряд;
	
	Если ЗначениеЗаполнено(ЗаявкаНаСервис) Тогда
		
		Документ.ЗаявкаНаСервис = ЗаявкаНаСервис;
		Документ.Обращение = ЗаявкаНаСервис.Обращение;
		
	КонецЕсли;
	
	Если Предварительно Тогда
		
		Документ.Записать(РежимЗаписиДокумента.Запись);
		
	Иначе
		
		Если Документ.ПометкаУдаления Тогда
			Документ.ПометкаУдаления = Ложь;
		КонецЕсли; 
		
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЕсли;
	
КонецПроцедуры

Функция Renault_ПредложитьКлиентуКарту(Контрагент, СуществующаяКарта = Неопределено, ЗаказНаряд) Экспорт
	
	//DMS +
	
	Если ЗначениеЗаполнено(СуществующаяКарта) Тогда
		
		ТекущаяДата = НачалоДня(ТекущаяДата());
		
		мОрганизация = ?(ЗаказНаряд = Неопределено,Справочники.Организации.ПустаяСсылка(),ЗаказНаряд.Организация);
		
		Возврат ПроверитьКартуНаВозможностьЗамены(мОрганизация,Контрагент,СуществующаяКарта,ТекущаяДата,ЗаказНаряд);
	
	КонецЕсли;
	
	//DMS -
	
	СписокПрограмм = Новый СписокЗначений();
	
	ЮрФизЛицо = КонтрагентЮрФизЛицо(Контрагент,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ЮрФизЛицо",ЮрФизЛицо); //DMS
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПравилаУчастия.Ссылка,
		|	ПравилаУчастия.СуммаВсегоРаботОт КАК СуммаВсегоРаботОт,
		|	ПравилаУчастия.СуммаВсегоЗапчастейОт КАК СуммаВсегоЗапчастейОт,
		|	ПравилаУчастия.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	ПравилаУчастия.ПериодПроверкиРабот,
		|	ПравилаУчастия.ПериодПроверкиЗапчастей,
		|	ПравилаУчастия.СуммаВсегоЗаказНарядОт,
		|	ПравилаУчастия.СуммаВсегоРаботДо,
		|	ПравилаУчастия.СуммаВсегоЗапчастейДо,
		|	ПравилаУчастия.СуммаВсегоЗаказНарядДо,
		|	ПравилаУчастия.ПериодПроверкиСуммыДокумента,
		|	ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.Уровень, 0) КАК УровеньПрограммы,
		|	ПравилаУчастия.ДействуетДляОрганизации
		|ИЗ
		|	Справочник.Renault_ПравилаУчастияВПрограммеЛояльности КАК ПравилаУчастия
		|ГДЕ
		|	(ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = &ЮрФизЛицо
		|			ИЛИ ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПравилаУчастия.СуммаВсегоРаботДо УБЫВ,
		|	ПравилаУчастия.СуммаВсегоЗапчастейДо УБЫВ";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(СуществующаяКарта) Тогда
			
			Если Выборка.ПрограммаЛояльности = СуществующаяКарта.ПрограммаЛояльности Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если Выборка.УровеньПрограммы <= СуществующаяКарта.ПрограммаЛояльности.Уровень Тогда
				
				Продолжить;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//проверяем сумму по работам		
		Если ЗначениеЗаполнено(Выборка.СуммаВсегоРаботОт) ИЛИ ЗначениеЗаполнено(Выборка.СуммаВсегоРаботДо) Тогда 
			
			ЗапросСуммаРабот = Новый Запрос;
			
			ЗапросСуммаРабот.Текст = "ВЫБРАТЬ
			                         |	ЕСТЬNULL(СУММА(ЗаказНаряд.СуммаРаботДокумента), 0) КАК СуммаРаботДокумента
			                         |ИЗ
			                         |	Документ.ЗаказНаряд КАК ЗаказНаряд
			                         |ГДЕ
			                         |	ЗаказНаряд.ДатаЗакрытия МЕЖДУ &Период И &ТекущаяДата
			                         |	И ЗаказНаряд.Заказчик = &Заказчик
			                         |	И ЗаказНаряд.Организация = &Организация
			                         |	И (НЕ ЗаказНаряд.ВидРемонта В(&ВидРемонта))";
									 
			ЗапросСуммаРабот.УстановитьПараметр("Организация", Выборка.ДействуетДляОрганизации);
			ЗапросСуммаРабот.УстановитьПараметр("ВидРемонта", Выборка.Ссылка.ИключаемыеВидыРемонта.ВыгрузитьКолонку("ВидРемонта"));
			
			ТекущаяДата = НачалоДня(ТекущаяДата());
			
			ЗапросСуммаРабот.УстановитьПараметр("Заказчик", Контрагент);
			ЗапросСуммаРабот.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
			ЗапросСуммаРабот.УстановитьПараметр("Период", ТекущаяДата - Выборка.ПериодПроверкиРабот*3600*24);
			
			ВыборкаСуммыРабот = ЗапросСуммаРабот.Выполнить().Выбрать();
			
			Если ВыборкаСуммыРабот.Следующий() Тогда
				
				Если (ВыборкаСуммыРабот.СуммаРаботДокумента >= Выборка.СуммаВсегоРаботОт 
					И ВыборкаСуммыРабот.СуммаРаботДокумента <= Выборка.СуммаВсегоРаботДо) Тогда
					
					Если СписокПрограмм.НайтиПоЗначению(Выборка.ПрограммаЛояльности) = Неопределено Тогда
						
						НоваяПрограмма = СписокПрограмм.Добавить();
						НоваяПрограмма.Значение = Выборка.ПрограммаЛояльности;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//проверяем сумму по запчастям
		Если ЗначениеЗаполнено(Выборка.СуммаВсегоЗапчастейОт) ИЛИ ЗначениеЗаполнено(Выборка.СуммаВсегоЗапчастейДо) Тогда
			
			ЗапросЗЧ = Новый Запрос;
			
			ЗапросЗЧ.Текст = "ВЫБРАТЬ
			                 |	ЕСТЬNULL(СУММА(ЗаказНаряд.СуммаНоменклатурыДокумента), 0) КАК СуммаНоменклатурыДокумента
			                 |ИЗ
			                 |	Документ.ЗаказНаряд КАК ЗаказНаряд
			                 |ГДЕ
			                 |	ЗаказНаряд.ДатаЗакрытия МЕЖДУ &Период И &ТекущаяДата
			                 |	И ЗаказНаряд.Заказчик = &Заказчик
			                 |	И ЗаказНаряд.Организация = &Организация
			                 |	И (НЕ ЗаказНаряд.ВидРемонта В(&ВидРемонта))";
			
			ТекущаяДата = НачалоДня(ТекущаяДата());
			
			ЗапросЗЧ.УстановитьПараметр("Заказчик", Контрагент);
			ЗапросЗЧ.УстановитьПараметр("ВидРемонта", Выборка.Ссылка.ИключаемыеВидыРемонта.ВыгрузитьКолонку("ВидРемонта"));
			ЗапросЗЧ.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
			ЗапросЗЧ.УстановитьПараметр("Период", ТекущаяДата - Выборка.ПериодПроверкиЗапчастей*3600*24);
			ЗапросЗЧ.УстановитьПараметр("Организация", Выборка.ДействуетДляОрганизации);
			
			ВыборкаЗЧ = ЗапросЗЧ.Выполнить().Выбрать();
			
			Если ВыборкаЗЧ.Следующий() Тогда
				
				Если (ВыборкаЗЧ.СуммаНоменклатурыДокумента >= Выборка.СуммаВсегоЗапчастейОт 
					И ВыборкаЗЧ.СуммаНоменклатурыДокумента <= Выборка.СуммаВсегоЗапчастейДо) Тогда
					
					Если СписокПрограмм.НайтиПоЗначению(Выборка.ПрограммаЛояльности) = Неопределено Тогда
						
						НоваяПрограмма = СписокПрограмм.Добавить();
						НоваяПрограмма.Значение = Выборка.ПрограммаЛояльности;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//проверяем сумму всего по документу
		Если ЗначениеЗаполнено(Выборка.СуммаВсегоЗаказНарядОт) ИЛИ ЗначениеЗаполнено(Выборка.СуммаВсегоЗаказНарядДо) Тогда
			
			ЗапросСуммаДокумента = Новый Запрос;
			
			ЗапросСуммаДокумента.Текст = "ВЫБРАТЬ
			                             |	ЕСТЬNULL(СУММА(ЗаказНаряд.СуммаДокумента), 0) КАК СуммаДокумента
			                             |ИЗ
			                             |	Документ.ЗаказНаряд КАК ЗаказНаряд
			                             |ГДЕ
			                             |	ЗаказНаряд.ДатаЗакрытия МЕЖДУ &Период И &ТекущаяДата
			                             |	И ЗаказНаряд.Заказчик = &Заказчик
			                             |	И ЗаказНаряд.Организация = &Организация
			                             |	И (НЕ ЗаказНаряд.ВидРемонта В(&ВидРемонта))";
			
			ТекущаяДата = НачалоДня(ТекущаяДата());
			
			ЗапросСуммаДокумента.УстановитьПараметр("Заказчик", Контрагент);
			ЗапросСуммаДокумента.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
			ЗапросСуммаДокумента.УстановитьПараметр("Период", ТекущаяДата - Выборка.ПериодПроверкиСуммыДокумента*3600*24);
			ЗапросСуммаДокумента.УстановитьПараметр("Организация", Выборка.ДействуетДляОрганизации);
            ЗапросСуммаДокумента.УстановитьПараметр("ВидРемонта", Выборка.Ссылка.ИключаемыеВидыРемонта.ВыгрузитьКолонку("ВидРемонта"));
			
			ВыборкаСуммыДокумента = ЗапросСуммаДокумента.Выполнить().Выбрать();
			
			Если ВыборкаСуммыДокумента.Следующий() Тогда
				
				Если (ВыборкаСуммыДокумента.СуммаДокумента >= Выборка.СуммаВсегоЗаказНарядОт 
					И ВыборкаСуммыДокумента.СуммаДокумента <= Выборка.СуммаВсегоЗаказНарядДо) Тогда
					
					Если СписокПрограмм.НайтиПоЗначению(Выборка.ПрограммаЛояльности) = Неопределено Тогда
						
						НоваяПрограмма = СписокПрограмм.Добавить();
						НоваяПрограмма.Значение = Выборка.ПрограммаЛояльности;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СписокПрограмм) Тогда
		
		#Если Клиент Тогда
			
			// Сергеев В.Н. DMSREN-905
			//убираем диалог и возможность создать карту
			Возврат Неопределено;
			
			Если Вопрос("Выдать клиенту новую дисконтную карту?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
				
				Сообщить("Клиенту можно выдать карту.");
				
				Возврат Неопределено;
				
			КонецЕсли;
						
			Если СписокПрограмм.Количество() = 1 Тогда
				
				//Если ЗначениеЗаполнено(СуществующаяКарта) Тогда
				//	
				//	Карта = СуществующаяКарта.Ссылка.ПолучитьОбъект();
				//	Карта.Недействительна = Истина;
				//	Карта.ПометкаУдаления = Истина;
				//	Карта.Записать();
				//	
				//КонецЕсли;
				
				НоваяКарта = Справочники.Renault_КартыЛояльности.СоздатьЭлемент();
				НоваяКарта.УстановитьНовыйКод();
				НоваяКарта.Контрагент = Контрагент;
				НоваяКарта.Наименование = "Карта: " + Строка(Контрагент);
				НоваяКарта.Примечание = "";
				НоваяКарта.ДатаВыдачи = ТекущаяДата;
				НоваяКарта.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
				НоваяКарта.ПрограммаЛояльности = СписокПрограмм[0].Значение;
				НоваяКарта.КемВыдана = ПараметрыСеанса.Пользователь.Сотрудник;
				НоваяКарта.Записать();
				
				Если ЗначениеЗаполнено(СуществующаяКарта) Тогда
					
					ПеренестиБаллыНаНовуюКарту(СуществующаяКарта, НоваяКарта, НоваяКарта.ПрограммаЛояльности);
					
				КонецЕсли;
				
				//Предупреждение("Клиенту сгенерирована новая карта: " + Строка(НоваяКарта.Код));
				
				Форма = НоваяКарта.ПолучитьФорму();
				Ответ = Форма.ОткрытьМодально();
				
				Если ЗначениеЗаполнено(Ответ) Тогда //DMS+
					Возврат Ответ;	
				КонецЕсли;//DMS- 
				
				//Renault_ЗаписатьОстатокБаллов(Контрагент, НоваяКарта.Ссылка, 0, ЗаказНаряд);
				
				
			ИначеЕсли СписокПрограмм.Количество() > 1 Тогда
				
				Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
				Форма.Заголовок = "Какую программу лояльности выдаем?";
				Форма.СписокВыбора = СписокПрограмм;
				
				Ответ = Форма.ОткрытьМодально();
				
				Если ЗначениеЗаполнено(Ответ) Тогда
					
					//Если ЗначениеЗаполнено(СуществующаяКарта) Тогда
					//	
					//	Карта = СуществующаяКарта.Ссылка.ПолучитьОбъект();
					//	Карта.Недействительна = Истина;
					//	Карта.ПометкаУдаления = Истина;
					//	Карта.Записать();
					//	
					//КонецЕсли;
					
					НоваяКарта = Справочники.Renault_КартыЛояльности.СоздатьЭлемент();
					НоваяКарта.УстановитьНовыйКод();
					НоваяКарта.Контрагент = Контрагент;
					НоваяКарта.Наименование = "Карта: " + Строка(Контрагент);
					НоваяКарта.Примечание = "";
					НоваяКарта.ДатаВыдачи = ТекущаяДата;
					НоваяКарта.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
					НоваяКарта.ПрограммаЛояльности = Ответ;
					НоваяКарта.КемВыдана = ПараметрыСеанса.Пользователь.Сотрудник;
					НоваяКарта.Записать();
					
					//Предупреждение("Клиенту сгенерирована новая карта: " + Строка(НоваяКарта.Код));
					
					Форма = НоваяКарта.ПолучитьФорму();
					мОтвет = Форма.ОткрытьМодально();
					
					Если ЗначениеЗаполнено(мОтвет) Тогда
						Возврат мОтвет;
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЕсли;			
			
		#КонецЕсли
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	
КонецФункции

Процедура ПеренестиБаллыНаНовуюКарту(СтараяКарта, НоваяКарта, ПрограммаЛояльности)
	
	//Спишем старые баллы
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_ОстаткиБалловОстатки.КоличествоБалловОстаток
	|ИЗ
	|	РегистрНакопления.Renault_ОстаткиБаллов.Остатки(&ТекущаяДата, ПогаситьДо >= &ТекущаяДата) КАК Renault_ОстаткиБалловОстатки";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОстатокБаллов = 0;
	
	Если Выборка.Следующий() Тогда
		
		ОстатокБаллов = Выборка.КоличествоБалловОстаток;
		
	КонецЕсли;
	
	Документ = Документы.Renault_СписаниеНачислениеБаллов.СоздатьДокумент();
	
	Документ.КартаЛояльности = СтараяКарта.Ссылка;
	Документ.КоличествоБалловСписано = ОстатокБаллов;
	Документ.Контрагент = СтараяКарта.Контрагент;
	Документ.Дата = ТекущаяДата();
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	//Начислим баллы на новую карту
	Документ = Документы.Renault_СписаниеНачислениеБаллов.СоздатьДокумент();
	Документ.КоличествоБалловНачислено = ОстатокБаллов;
	Документ.Контрагент = НоваяКарта.Контрагент;
	Документ.Дата = ТекущаяДата();
	Документ.ПогаситьДо = НачалоДня(ТекущаяДата() + ПрограммаЛояльности.СрокДействияБаллов * 60 * 60 * 24);
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура Renault_ЗаказНаряд_ПередЗаписью_НачислениеСписаниеБалловПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	#Если Клиент Тогда
	
		Если Отказ = Истина Тогда
			
			Возврат;
			
		КонецЕсли;
		
		Если НЕ ПараметрыСеанса.Renault_ПраваПользователя.РазрешитьВыдачуКартыВручную Тогда
			
			Возврат;
			
		КонецЕсли;
				
		Гарантия = РегистрыСведений.Renault_ВидыРемонтаДопРеквизиты.ПолучитьГарантиюЗавода(Источник.ВидРемонта);
			
		Если Гарантия = Истина Тогда
				
			Возврат;
				
		КонецЕсли;
		
		ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		
		Если ЗначениеЗаполнено(ДЦ) И ДЦ.ИспользуетПрограммуЛояльностиRenault Тогда
			
			Статус = Источник.Состояние;
			
			Если Статус = ДЦ.Автосервис_СтатусЗаказНарядаДляВыдачиКарты Тогда
		
				Renault_АвтосервисСкидки.Renault_СписатьНачислитьБаллы(Источник.Заказчик, Источник.Ссылка);	
			
			КонецЕсли;
			
		КонецЕсли;
	
	#КонецЕсли
	
КонецПроцедуры

Процедура Renault_СписатьНачислитьБаллыПриВыдаче(ЗаказНаряд, КоличествоБаллов)
	
	Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
	
		Источник = ЗаказНаряд;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Гарантия = РегистрыСведений.Renault_ВидыРемонтаДопРеквизиты.ПолучитьГарантиюЗавода(Источник.ВидРемонта);
			
	Если Гарантия = Истина Тогда
			
		Возврат;
			
	КонецЕсли;
	
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Если ЗначениеЗаполнено(ДЦ) И ДЦ.ИспользуетПрограммуЛояльностиRenault Тогда
	
		Renault_АвтосервисСкидки.Renault_СписатьНачислитьБаллы(Источник.Заказчик, Источник.Ссылка);	
	
	КонецЕсли;
	
	
КонецПроцедуры

Функция Reanult_НайтиСоздатьТиповуюСкидку () Экспорт
	
	Код = "RENAULTDMSDISCOUNT";
	
	Скидка = Справочники.ТипыСкидок.НайтиПоКоду(Код);
	
	Если НЕ ЗначениеЗаполнено(Скидка) Тогда
		
		Скидка = Справочники.ТипыСкидок.СоздатьЭлемент();
		Скидка.Код = Код;
		Скидка.Наименование = "Скидка Renault DMS";
		Скидка.ВидСкидки = Перечисления.ВидыСкидок.НаСтрокуДокумента;
		Скидка.РучнаяСкидка = Истина;
		Скидка.СпособВычисления = Перечисления.СкидкиСпособВычисления.Абсолютная;
		
		Попытка
			
			Скидка.Записать();
			
			Возврат Скидка.Ссылка;
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Ошибка при создании скидки DMS", УровеньЖурналаРегистрации.Ошибка,
			,,Строка(ОписаниеОшибки()));
			Возврат Справочники.ТипыСкидок.ПустаяСсылка();
			
		КонецПопытки;
		
	Иначе
		
		Возврат Скидка;
		
	КонецЕсли;
	
КонецФункции

