
Функция Renault_НайтиКарточку(Контрагент) Экспорт	
	
	Если обЗначениеНеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст = "ВЫБРАТЬ
	|	Карточки.Ссылка КАК Карточка
	|ИЗ
	|	Справочник.Карточки КАК Карточки
	|ГДЕ
	|	Карточки.Объект = &Контрагент
	|	И Карточки.КарточкаЗаблокирована = ЛОЖЬ";
	НайденныеКарточки = Запрос.Выполнить().Выгрузить();
	Если НайденныеКарточки.Количество() = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли НайденныеКарточки.Количество() = 1 Тогда
		Возврат НайденныеКарточки[0].Карточка;
	Иначе
		Сообщить("По контрагенту " + Контрагент + " найдено несколько карточек! Выберите карточку вручную!");
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

