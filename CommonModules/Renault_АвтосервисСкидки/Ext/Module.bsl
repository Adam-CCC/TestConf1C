	Запрос.УстановитьПараметр("ЮрФизЛицо",		 ЮрФизЛицо);//DMS	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	КартыЛояльности.Ссылка КАК КартаЛояльности,
		|	КартыЛояльности.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	КартыЛояльности.DMS_ВидКартыЛояльности КАК ВидКарты,
		|	ЕСТЬNULL(БонусныеБаллы.НачисленоОстаток, 0) КАК КоличествоБаллов
		|ПОМЕСТИТЬ КартаЛояльностиКлиента
		|ИЗ
		|	Справочник.Renault_КартыЛояльности КАК КартыЛояльности
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.DMS_БонусныеБаллы.Остатки(&Период, ) КАК БонусныеБаллы
		|		ПО (БонусныеБаллы.КартаЛояльности = КартыЛояльности.Ссылка)
