		//				Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ДокументОбъект.Автомобиль,Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег,ДокументОбъект.Дата);
		//				Если ЗначениеЗаполнено(Пробег) И Пробег <= 100000 Тогда
		//					ОтказПоДатеГарантии = Истина;
		//				КонецЕсли;	
		//			КонецЕсли;
		//		Иначе	
		//			ОтказПоДатеГарантии = Истина;
		//		КонецЕсли;
		//	КонецЕсли;
		//КонецЕсли;
		//---
		
		ОтСуммыЧекаВВалютеДокумента = ТекСтрокаКэша.ОтСуммыЧека / КоэффициентПересчетаВВалютуДокумента;
		
		Если ОтСуммыЧекаВВалютеДокумента>ОбработкаРасчетСкидокАвторабот.БазаДляРасчетаСкидки Тогда // Сумма документа недостаточна для скидки
			ТекСтрокаКэша.РассчитаннаяСуммаСкидки = 0;
			ТекСтрокаКэша.НеПодходит             = Истина;
			//ИначеЕсли ОтказПоНесовпадениюСвойства Тогда
			//+++
		ИначеЕсли ОтказПоНесовпадениюСвойства ИЛИ ОтказПоНесовпадениюФормыСобственнности ИЛИ ОтказПоДатеГарантии Тогда
			//---
			ТекСтрокаКэша.РассчитаннаяСуммаСкидки = 0;
			ТекСтрокаКэша.НеПодходит             = Истина;
		Иначе
			ТекСтрокаКэша.НеПодходит = Ложь;
			// Раcсчитываем сумму скидки.
			Если ТекСтрокаКэша.СпособВычисления = Перечисления.СкидкиСпособВычисления.Относительная Тогда
				ТекСтрокаКэша.РассчитаннаяСуммаСкидки = ОбработкаРасчетСкидокАвторабот.СуммаДляРасчетаШапочнойСкидки * ТекСтрокаКэша.ЗначениеСкидки / 100;
			Иначе
				// Если скидка абсолютная, то ее значение - это сумма в валюте рег. учета.
				// Выполним пересчет в валюту документа.
				ТекСтрокаКэша.РассчитаннаяСуммаСкидки = ТекСтрокаКэша.ЗначениеСкидки / КоэффициентПересчетаВВалютуДокумента;
				
				// Если сумма абсолютной скидки превышает значение базы для расчета скидки (т.е больше суммы документа), 
				// то итоговая сумма уйдет в минус, поэтому такая скидка не подойдет.
				Если ТекСтрокаКэша.РассчитаннаяСуммаСкидки>ОбработкаРасчетСкидокАвторабот.СуммаДляРасчетаШапочнойСкидки Тогда
					ТекСтрокаКэша.НеПодходит = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Сортируем по убыванию.
	ОбработкаРасчетСкидокАвторабот.КэшСкидок.Сортировать("НеПодходит ВОЗР, ЭтоПодарок УБЫВ, ФлагВытеснения УБЫВ, РассчитаннаяСуммаСкидки УБЫВ, ЗначениеСкидки УБЫВ");
	
	Если Не ОбработкаРасчетСкидокАвторабот.КэшСкидок[0].НеПодходит Тогда
		// Подходящая скидка найдена, сразу заполним итоговую сумму скидки на документ.
		НайденноеЗначениеСкидки = ?(ОбработкаРасчетСкидокАвторабот.КэшСкидок[0].СпособВычисления = Перечисления.СкидкиСпособВычисления.Абсолютная, ОбработкаРасчетСкидокАвторабот.КэшСкидок[0].РассчитаннаяСуммаСкидки, ОбработкаРасчетСкидокАвторабот.КэшСкидок[0].ЗначениеСкидки);
		ТекущаяСуммаСкидки = ОбработкаРасчетСкидокАвторабот.КэшСкидок[0].РассчитаннаяСуммаСкидки;
		Если (ТекущаяСкидкаНаценка<>ОбработкаРасчетСкидокАвторабот.КэшСкидок[0].Скидка) ИЛИ (ТекущееЗначениеСкидки<>НайденноеЗначениеСкидки) Тогда
			ОбработкаРасчетСкидокАвторабот.ТекущаяСкидкаНаценка  = ОбработкаРасчетСкидокАвторабот.КэшСкидок[0].Скидка;
			ОбработкаРасчетСкидокАвторабот.ТекущееЗначениеСкидки = НайденноеЗначениеСкидки;
			//ТребуетсяПересчет     = Истина;
			
		ИначеЕсли БазаДляРасчетаСкидкиИзменилась И (ТекущаяСкидкаНаценка.СпособВычисления=Перечисления.СкидкиСпособВычисления.Абсолютная) Тогда
			// Если тип и значение скидки не изменились, но произошло изменение суммовой базы для расчета абсолютной скидки, то
			// придется пересчитать табличную часть.
			//ТребуетсяПересчет = Истина;
		КонецЕсли;
	Иначе 
		Если Не ТекущаяСкидкаРучная Тогда
			ОбработкаРасчетСкидокАвторабот.ТекущаяСкидкаНаценка = Справочники.ТипыСкидок.ПустаяСсылка();
		КонецЕсли;
		Если ТекущееЗначениеСкидки<>0 Тогда
			//ТребуетсяПересчет     = Истина;
			ОбработкаРасчетСкидокАвторабот.ТекущееЗначениеСкидки = 0;
			ОбработкаРасчетСкидокАвторабот.ТекущаяСуммаСкидки    = 0; 
		КонецЕсли;
	КонецЕсли;
	
	Выполнить("ОбработкаРасчетСкидокАвторабот.ТекущаяСуммаСкидки=дкОкруглитьСуммуСкидки(ОбработкаРасчетСкидокАвторабот.ТекущаяСуммаСкидки,ОбработкаРасчетСкидокАвторабот.ТекущаяСкидкаНаценка)");
	
	//Возврат ТребуетсяПересчет;
	Возврат Истина;
	
КонецФункции // ПолучитьСкидкуШапки() 

//Наши собственные скидки. Получаем все.
Функция НайтиДоступныеСкидкиПоКлиенту(Контрагент) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	//Если Контрагент.ФормаСобственности <> Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
	//	
	//	Возврат Неопределено;
	//	
	//КонецЕсли;
	
	
	Запрос = Новый Запрос;
	
	ЮрФизЛицо = КонтрагентЮрФизЛицо(Контрагент,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	Запрос.УстановитьПараметр("ЮрФизЛицо",ЮрФизЛицо);//DMS
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КартыЛояльности.Ссылка КАК Карта,
	               |	КартыЛояльности.ПрограммаЛояльности.Ссылка КАК ПрограммаЛояльности,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.ЗапчастиСкидкаВнутренняя, 0) КАК Процент_Отчисления_Баллов_Запчасти,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.ЗапчастиСкидкаВнешняя, 0) КАК Скидка_На_Запчасти,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.ЗапчастиКурсБаллов, 0) КАК Коэффициент_Баллов_Запчасти,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.ЗапчастиМаксимумБалловОплата, 0) КАК Максимум_Оплаты_Баллами_Запчасти,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.ЗапчастиМаксимумБалловОплатаПроцент, 0) КАК Максимальный_Процент_Оплаты_Баллами_Запчасти,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.РаботыСкидкаВнутренняя, 0) КАК Процент_Отчисления_Баллов_Работы,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.РаботыСкидкаВнешняя, 0) КАК Скидка_На_Работы,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.РаботыКурсБаллов, 0) КАК Коэффициент_Баллов_Работы,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.РаботыМаксимумБалловОплата, 0) КАК Максимум_Оплаты_Баллами_Работы,
	               |	ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.РаботыМаксимумБалловОплатаПроцент, 0) КАК Максимальный_Процент_Оплаты_Баллами_Работы,
	               |	ЕСТЬNULL(ОстаткиБаллов.КоличествоБалловОстаток, 0) КАК Остаток_Баллов,
	               |	КартыЛояльности.Код КАК Номер_Карты
	               |ИЗ
	               |	Справочник.Renault_КартыЛояльности КАК КартыЛояльности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Renault_ОстаткиБаллов.Остатки(
	               |				&ТекущаяДата,
	               |				ПогаситьДо >= &ТекущаяДата
	               |					ИЛИ ПогаситьДо = &ПустаяДата) КАК ОстаткиБаллов
	               |		ПО (ОстаткиБаллов.КартаЛояльности = КартыЛояльности.Ссылка)
	               |ГДЕ
	               |	КартыЛояльности.Контрагент = &Контрагент
	               |	И КартыЛояльности.Недействительна = ЛОЖЬ
	               |	И КартыЛояльности.ПометкаУдаления = ЛОЖЬ
	               |	И (ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = &ЮрФизЛицо
	               |			ИЛИ ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка))";
		
	
	Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101")); 
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура Renault_СписатьНачислитьБаллы(Контрагент, ЗаказНаряд = Неопределено) Экспорт
	
	//Если Контрагент.ФормаСобственности <> Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
	//	Возврат;
	//КонецЕсли;
	
	//DMS +
	
	Карта_ПрограммаЛояльности = Справочники.Renault_КартыЛояльности.ПустаяСсылка();
	
	КартаЛояльностиКлиента = ПолучитьКартуЛояльностиКлиента(Контрагент);
	
	НоваяКарта = Ложь;
	
	Если ЗначениеЗаполнено(КартаЛояльностиКлиента) Тогда
		
		Карта_ПрограммаЛояльности = Renault_ПредложитьКлиентуКарту(Контрагент, КартаЛояльностиКлиента, ЗаказНаряд);
		
		Если Не ЗначениеЗаполнено(Карта_ПрограммаЛояльности) Тогда
			Карта_ПрограммаЛояльности = КартаЛояльностиКлиента;
		КонецЕсли; 
		
	Иначе 

		ТекущаяДата = НачалоДня(ТекущаяДата());
		
		мОрганизация = ?(ЗаказНаряд = Неопределено,Справочники.Организации.ПустаяСсылка(),ЗаказНаряд.Организация);
		
		Карта_ПрограммаЛояльности = ПроверитьВозможностьВыдачиКартыБонусной(мОрганизация,Контрагент,ТекущаяДата,ЗаказНаряд);

		Если Не ЗначениеЗаполнено(Карта_ПрограммаЛояльности) Тогда
			Карта_ПрограммаЛояльности = Renault_ПредложитьКлиентуКарту(Контрагент, , ЗаказНаряд);
		КонецЕсли; 
		
		НоваяКарта = ЗначениеЗаполнено(Карта_ПрограммаЛояльности);
		
	КонецЕсли; 
	
	Если НоваяКарта Тогда
		Возврат;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Карта_ПрограммаЛояльности) 
		И ЗначениеЗаполнено(ЗаказНаряд) Тогда
		
		ДанныеПоСкидкамИБаллам = Renault_АвтосервисСкидки.ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту(Контрагент,Карта_ПрограммаЛояльности);
		
		ВсегоБаллов = 0;
		
		Если ДанныеПоСкидкамИБаллам.ПроцентОтчисленияБалловЗапчасти > 0 Тогда
			
			НачислитьБаллыЗапчасти = ДанныеПоСкидкамИБаллам.ПроцентОтчисленияБалловЗапчасти * ЗаказНаряд.СуммаНоменклатурыДокумента /100;
			
			ВсегоБаллов = НачислитьБаллыЗапчасти; 
			
			Если ЗаказНаряд.Заказчик <> ЗаказНаряд.Контрагент Тогда
				
				ВсегоБаллов = 0;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ДанныеПоСкидкамИБаллам.ПроцентОтчисленияБалловРаботы > 0 Тогда
			
			НачислитьБаллыРаботы = ДанныеПоСкидкамИБаллам.ПроцентОтчисленияБалловРаботы * ЗаказНаряд.СуммаРаботДокумента / 100;	
			
			ВсегоБаллов = ВсегоБаллов + НачислитьБаллыРаботы;
			
			Если ЗаказНаряд.Заказчик <> ЗаказНаряд.Контрагент Тогда
				
