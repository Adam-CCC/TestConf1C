		|	И НЕ КартыЛояльности.Недействительна
		|	И (КартыЛояльности.Ссылка = &КартаЛояльности
		|			ИЛИ &КартаЛояльности = ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.ПустаяСсылка))
		|	И (ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)
		|			ИЛИ ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)) = &ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КартаЛояльностиКлиента.КартаЛояльности КАК КартаЛояльности,
		|	КартаЛояльностиКлиента.ВидКарты КАК ВидКарты,
		|	КартаЛояльностиКлиента.КоличествоБаллов КАК КоличествоБаллов,
		|	ШкалаНачисленияБаллов.ПроцентСуммы КАК ПроцентОтЧека
		|ПОМЕСТИТЬ ПроцентОтЧекаПоКарте
		|ИЗ
		|	КартаЛояльностиКлиента КАК КартаЛояльностиКлиента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.DMS_ВидыКартЛояльности.ШкалаНачисленияБаллов КАК ШкалаНачисленияБаллов
		|		ПО КартаЛояльностиКлиента.ВидКарты = ШкалаНачисленияБаллов.Ссылка
		|			И КартаЛояльностиКлиента.КоличествоБаллов >= ШкалаНачисленияБаллов.БалансОт
		|			И (КартаЛояльностиКлиента.КоличествоБаллов <= ШкалаНачисленияБаллов.БалансДо
		|				ИЛИ ШкалаНачисленияБаллов.БалансДо = 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КартаЛояльностиКлиента.КартаЛояльности КАК КартаЛояльности,
		|	КартаЛояльностиКлиента.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	КартаЛояльностиКлиента.ВидКарты КАК ВидКарты,
		|	КартаЛояльностиКлиента.КоличествоБаллов КАК КоличествоБаллов,
		|	ЕСТЬNULL(ПроцентОтЧекаПоКарте.ПроцентОтЧека, 0) КАК ПроцентОтЧека
		|ПОМЕСТИТЬ ДанныеПоКарте
		|ИЗ
		|	КартаЛояльностиКлиента КАК КартаЛояльностиКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПроцентОтЧекаПоКарте КАК ПроцентОтЧекаПоКарте
		|		ПО КартаЛояльностиКлиента.КартаЛояльности = ПроцентОтЧекаПоКарте.КартаЛояльности
		|			И КартаЛояльностиКлиента.ВидКарты = ПроцентОтЧекаПоКарте.ВидКарты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПоКарте.КартаЛояльности КАК КартаЛояльностиКлиента,
		|	ДанныеПоКарте.КартаЛояльности.Код КАК Номер_Карты,
		|	ДанныеПоКарте.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	ВЫБОР
		|		КОГДА ДанныеПоКарте.ПроцентОтЧека = 0
		|			ТОГДА ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.ЗапчастиСкидкаВнутренняя, 0)
		|		ИНАЧЕ ДанныеПоКарте.ПроцентОтЧека
		|	КОНЕЦ КАК ПроцентОтчисленияБалловЗапчасти,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.ЗапчастиСкидкаВнешняя, 0) КАК СкидкаЗапчасти,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.ЗапчастиКурсБаллов, 0) КАК Коэффициент_Баллов_Запчасти,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.ЗапчастиМаксимумБалловОплата, 0) КАК МаксимумБалламиЗапчасти,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.ЗапчастиМаксимумБалловОплатаПроцент, 0) КАК МаксимумПроцентЗапчасти,
		|	ВЫБОР
		|		КОГДА ДанныеПоКарте.ПроцентОтЧека = 0
		|			ТОГДА ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.РаботыСкидкаВнутренняя, 0)
		|		ИНАЧЕ ДанныеПоКарте.ПроцентОтЧека
		|	КОНЕЦ КАК ПроцентОтчисленияБалловРаботы,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.РаботыСкидкаВнешняя, 0) КАК СкидкаРаботы,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.РаботыКурсБаллов, 0) КАК Коэффициент_Баллов_Работы,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.РаботыМаксимумБалловОплата, 0) КАК МаксимумБалламиРаботы,
		|	ЕСТЬNULL(ДанныеПоКарте.ПрограммаЛояльности.РаботыМаксимумБалловОплатаПроцент, 0) КАК МаксимумПроцентРаботы,
		|	ЕСТЬNULL(ДанныеПоКарте.КоличествоБаллов, 0) КАК ОстатокБаллов,
		|	ДанныеПоКарте.КартаЛояльности КАК БонуснаяКарта,
		|	ДанныеПоКарте.ВидКарты КАК ВидКарты
		|ИЗ
		|	ДанныеПоКарте КАК ДанныеПоКарте";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеПоСкидкамИБаллам = Новый Структура;
	
	Для каждого ТекущаяКолонка Из РезультатЗапроса.Колонки Цикл
		ДанныеПоСкидкамИБаллам.Вставить(ТекущаяКолонка.Имя);
	КонецЦикла; 
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеПоСкидкамИБаллам,ВыборкаДетальныеЗаписи);
	Иначе 
		Возврат Новый Структура("БонуснаяКарта,КартаЛояльностиКлиента,МаксимумПроцентЗапчасти,ПроцентОтчисленияБалловЗапчасти,Коэффициент_Баллов_Работы,ПроцентОтчисленияБалловРаботы,МаксимумПроцентРаботы,ОстатокБаллов,ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы",Неопределено,Неопределено,0,0,0,0,0,0,Неопределено,0,0,0,0);
	КонецЕсли; 
	
	Возврат ДанныеПоСкидкамИБаллам;
	
КонецФункции // ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту()

Процедура DMS_СписаниеНачислениеБаллов(КодВидаКарт) Экспорт
	
	Период = ТекущаяДатаСеанса();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", 	КодВидаКарт);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыКартЛояльности.Ссылка КАК ВидКарты,
		|	Карты.Ссылка КАК КартаЛояльности
		|ПОМЕСТИТЬ КартыЛояльности
		|ИЗ
		|	Справочник.Renault_КартыЛояльности КАК Карты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.DMS_ВидыКартЛояльности КАК ВидыКартЛояльности
		|		ПО Карты.DMS_ВидКартыЛояльности = ВидыКартЛояльности.Ссылка
		|ГДЕ
		|	ВидыКартЛояльности.Код = &Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Дата,
		|	КартыЛояльности.КартаЛояльности КАК КартаЛояльности,
		|	БонусныеБаллыОстатки.КартаЛояльности.Контрагент КАК Контрагент,
		|	-БонусныеБаллыОстатки.КСписаниюОстаток КАК БаллыКСписанию
		|ИЗ
		|	КартыЛояльности КАК КартыЛояльности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.DMS_БонусныеБаллы.Остатки(&Период, ) КАК БонусныеБаллыОстатки
		|		ПО КартыЛояльности.КартаЛояльности = БонусныеБаллыОстатки.КартаЛояльности
		|			И (НЕ КартыЛояльности.КартаЛояльности.ПрограммаЛояльности.DMS_Недействительна)
		|ГДЕ
		|	БонусныеБаллыОстатки.КСписаниюОстаток < 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&Период,
		|	КартыЛояльности.КартаЛояльности,
		|	БонусныеБаллыОстатки.КартаЛояльности.Контрагент,
		|	БонусныеБаллыОстатки.НачисленоОстаток
		|ИЗ
		|	КартыЛояльности КАК КартыЛояльности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.DMS_БонусныеБаллы.Остатки(&Период, ) КАК БонусныеБаллыОстатки
		|		ПО КартыЛояльности.КартаЛояльности = БонусныеБаллыОстатки.КартаЛояльности
		|			И (КартыЛояльности.КартаЛояльности.ПрограммаЛояльности.DMS_Недействительна)
		|ГДЕ
		|	БонусныеБаллыОстатки.НачисленоОстаток > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	КартаЛояльности
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДокументСписания = Документы.Renault_СписаниеНачислениеБаллов.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(ДокументСписания,ВыборкаДетальныеЗаписи);
		ДокументСписания.УстановитьНовыйНомер();
		
		Попытка
			ДокументСписания.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации("Регламентное списание баллов",УровеньЖурналаРегистрации.Ошибка,,,КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));	
		КонецПопытки;
		
	КонецЦикла;
	
	НачислитьБаллыВДеньРожденияКлиента(Период,КодВидаКарт);
	
	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.СписаниеНачислениеБаллов"),
	ТекущаяДатаСеанса());
	
КонецПроцедуры

Процедура НачислитьБаллыВДеньРожденияКлиента(Период,КодВидаКарт)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", 	 Период);
	Запрос.УстановитьПараметр("КодВидаКарт", КодВидаКарт);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Привилегии.Ссылка,
		|	СУММА(Привилегии.Привилегия.СуммаБонуса) КАК ПривилегияСуммаБонуса
		|ПОМЕСТИТЬ ВидыКарт
		|ИЗ
		|	Справочник.DMS_ВидыКартЛояльности.Привилегии КАК Привилегии
		|ГДЕ
		|	НЕ Привилегии.Ссылка.ПометкаУдаления
		|	И Привилегии.Ссылка.ТипКарты = ЗНАЧЕНИЕ(Перечисление.DMS_ТипыКартЛояльности.Бонусная)
		|	И Привилегии.Привилегия.НачисляютсяБонусыВДеньРожденияКлиента
		|	И Привилегии.Ссылка.Код = &КодВидаКарт
		|
		|СГРУППИРОВАТЬ ПО
		|	Привилегии.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) КАК Период,
		|	КартыЛояльности.Ссылка КАК КартаЛояльности,
		|	КартыЛояльности.Контрагент КАК Контрагент,
		|	ВидыКарт.ПривилегияСуммаБонуса КАК БаллыКНачислению
		|ПОМЕСТИТЬ мБаллыКНачислению
		|ИЗ
		|	Справочник.Renault_КартыЛояльности КАК КартыЛояльности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВидыКарт КАК ВидыКарт
		|		ПО КартыЛояльности.DMS_ВидКартыЛояльности = ВидыКарт.Ссылка
		|			И (НЕ КартыЛояльности.Недействительна)
		|			И (НЕ КартыЛояльности.ПометкаУдаления)
		|ГДЕ
		|	ДЕНЬ(КартыЛояльности.Контрагент.ДатаРождения) = ДЕНЬ(&Период)
		|	И МЕСЯЦ(КартыЛояльности.Контрагент.ДатаРождения) = МЕСЯЦ(&Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	мБаллыКНачислению.Период КАК Дата,
		|	мБаллыКНачислению.КартаЛояльности,
		|	мБаллыКНачислению.Контрагент,
		|	мБаллыКНачислению.БаллыКНачислению
		|ИЗ
		|	мБаллыКНачислению КАК мБаллыКНачислению
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.DMS_БонусныеБаллы КАК БонусныеБаллы
		|		ПО (мБаллыКНачислению.Период = НАЧАЛОПЕРИОДА(БонусныеБаллы.Период, ДЕНЬ))
		|			И мБаллыКНачислению.КартаЛояльности = БонусныеБаллы.КартаЛояльности
		|			И (БонусныеБаллы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.DMS_ВидыОперацийКартЛояльности.НачислениеБалловРегламентно))
		|			И мБаллыКНачислению.Контрагент = БонусныеБаллы.Контрагент
		|ГДЕ
		|	БонусныеБаллы.КартаЛояльности ЕСТЬ NULL ";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДанных.Следующий() Цикл
		
		Попытка
			ДокументНачисления = Документы.Renault_СписаниеНачислениеБаллов.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(ДокументНачисления,ВыборкаДанных);
			
			ДокументНачисления.Ответственный = ПараметрыСеанса.Пользователь;
			ДокументНачисления.Комментарий   = "#Начислено в день рождение клиента регламетно.";
			
			ЗаполнитьДатуПогашения(ДокументНачисления);
			
			ДокументНачисления.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ЗаписьЖурналаРегистрации("Создание документа начисления баллов регламентно",УровеньЖурналаРегистрации.Ошибка,,,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДатуПогашения(мОбъект)
	
	ВидКартыЛояльности  = мОбъект.КартаЛояльности.DMS_ВидКартыЛояльности;
	ПрограммаЛояльности = мОбъект.КартаЛояльности.ПрограммаЛояльности;
	
	Если ЗначениеЗаполнено(ВидКартыЛояльности)
		И ВидКартыЛояльности.ИспользоватьСрокДействияБаллов Тогда
		
		мОбъект.ПогаситьДо = ДобавитьКДате(мОбъект.Дата,Формат(ВидКартыЛояльности.СрокДействияБаллов,"ЧЦ=10; ЧН=0; ЧГ="),СокрЛП(ВидКартыЛояльности.ПериодичностьДействияБаллов)); 
		
	ИначеЕсли ЗначениеЗаполнено(ПрограммаЛояльности) 
		И ПрограммаЛояльности.СрокДействияБаллов <> 0 Тогда  
		
		мОбъект.ПогаситьДо = ДобавитьКДате(НачалоДня(мОбъект.Дата),Формат(ПрограммаЛояльности.СрокДействияБаллов,"ЧЦ=10; ЧН=0; ЧГ=")); 
	
	КонецЕсли; 	

КонецПроцедуры

Функция ДобавитьКДате(мДата,Количество,Тип = "День")
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("мДата", мДата);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&мДата, "+Тип+", "+Количество+") КАК НоваяДата";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НоваяДата = мДата;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяДата = ВыборкаДетальныеЗаписи.НоваяДата;
	КонецЦикла;
	
	Возврат НоваяДата;
	
КонецФункции // ДобавитьКДате()

Функция ПолучитьСозданнуюНовуюКарту(ПараметрыЗапроса)
	
	Запрос = Новый Запрос;
	
	Для каждого ТекущийПараметр Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(ТекущийПараметр.Ключ,ТекущийПараметр.Значение);
	КонецЦикла; 
	ЮрФизЛицо = КонтрагентЮрФизЛицо(ПараметрыЗапроса.Контрагент,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	Запрос.УстановитьПараметр("ЮрФизЛицо",ЮрФизЛицо);//DMS	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КартыПокупателей.КартаПриемник,
		|	КартыПокупателей.Ссылка
		|ИЗ
		|	Документ.DMS_ЗаменаКартЛояльности.КартыПокупателей КАК КартыПокупателей
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(КартыПокупателей.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|	И КартыПокупателей.Ссылка.Проведен
		|	И КартыПокупателей.Ссылка.ВидОперации = &ВидОперации
		|	И КартыПокупателей.КартаИсточник = &КартаИсточник
		|	И КартыПокупателей.КартаИсточник.Недействительна
		|	И НЕ ЕСТЬNULL(КартыПокупателей.КартаПриемник.Недействительна, ИСТИНА)
		|	И КартыПокупателей.КартаПриемник.Контрагент = &Контрагент
		|	И КартыПокупателей.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.DMS_СтатусЗаменыКарт.Согласован)
		|	И КартыПокупателей.КартаИсточник <> ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.пустаяСсылка)
		|	И КартыПокупателей.КартаПриемник <> ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.пустаяСсылка)
		|	И КартыПокупателей.КартаИсточник.DMS_КартаЗамены = КартыПокупателей.КартаПриемник
		|	И (ЕСТЬNULL(КартыПокупателей.КартаПриемник.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)
		|			ИЛИ ЕСТЬNULL(КартыПокупателей.КартаПриемник.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)) = &ЮрФизЛицо)
		|	И КартыПокупателей.Ссылка.ЗаказНаряд = &ЗаказНаряд";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();

	Если ВыборкаДанных.Следующий() Тогда
		Возврат ВыборкаДанных.КартаПриемник;	
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции // ПолучитьСозданнуюНовуюКарту()

Функция ПолучитьРаннееСозданнуюЗаменуКарт(ВидОперации,Дата,Контрагент,КартаИсточник)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидОперации",	ВидОперации);
	Запрос.УстановитьПараметр("Дата", 			Дата);
	Запрос.УстановитьПараметр("КартаИсточник",  КартаИсточник);
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
	
	ЮрФизЛицо = КонтрагентЮрФизЛицо(Контрагент,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	Запрос.УстановитьПараметр("ЮрФизЛицо",ЮрФизЛицо);//DMS
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КартыПокупателей.КартаПриемник,
		|	КартыПокупателей.Ссылка
		|ИЗ
		|	Документ.DMS_ЗаменаКартЛояльности.КартыПокупателей КАК КартыПокупателей
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(КартыПокупателей.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|	И КартыПокупателей.Ссылка.ВидОперации = &ВидОперации
		|	И КартыПокупателей.КартаИсточник = &КартаИсточник
		|	И КартыПокупателей.КартаИсточник.Недействительна
		|	И НЕ ЕСТЬNULL(КартыПокупателей.КартаПриемник.Недействительна, ИСТИНА)
		|	И КартыПокупателей.КартаПриемник.Контрагент = &Контрагент
		|	И КартыПокупателей.КартаИсточник <> ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.пустаяСсылка)
		|	И КартыПокупателей.КартаПриемник <> ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.пустаяСсылка)
		|	И (ЕСТЬNULL(КартыПокупателей.КартаПриемник.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)
		|			ИЛИ ЕСТЬNULL(КартыПокупателей.КартаПриемник.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.пустаяСсылка)) = &ЮрФизЛицо)
		|	И КартыПокупателей.Ссылка.ЗаказНаряд = &ЗаказНаряд";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();

	Если ВыборкаДанных.Следующий() Тогда
	
		Возврат ВыборкаДанных.Ссылка;	
	
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции // ПолучитьРаннееСозданнуюЗаменуКарт()

Функция ПроверитьКартуНаВозможностьЗамены(Организация,Заказчик,КартаЛояльности,Период,ЗаказНаряд = Неопределено) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказчик", 		 Заказчик);
	Запрос.УстановитьПараметр("КартаЛояльности", КартаЛояльности);
	Запрос.УстановитьПараметр("Организация", 	 Организация);
	Запрос.УстановитьПараметр("Период",		     Период);
	Запрос.УстановитьПараметр("ТекущаяДата",     ТекущаяДата());
	Запрос.УстановитьПараметр("ЗаказНаряд",      ?(ЗаказНаряд = Неопределено,Документы.ЗаказНаряд.ПустаяСсылка(),ЗаказНаряд));
	
	ЮрФизЛицо = КонтрагентЮрФизЛицо(Заказчик,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	Запрос.УстановитьПараметр("ЮрФизЛицо",ЮрФизЛицо);//DMS
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПравилаУчастия.Ссылка,
		|	ПравилаУчастия.СуммаВсегоРаботОт КАК СуммаВсегоРаботОт,
		|	ПравилаУчастия.СуммаВсегоЗапчастейОт КАК СуммаВсегоЗапчастейОт,
		|	ПравилаУчастия.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	ПравилаУчастия.ПериодПроверкиРабот,
		|	ПравилаУчастия.ПериодПроверкиЗапчастей,
		|	ПравилаУчастия.СуммаВсегоЗаказНарядОт,
		|	ПравилаУчастия.СуммаВсегоРаботДо,
		|	ПравилаУчастия.СуммаВсегоЗапчастейДо,
		|	ПравилаУчастия.СуммаВсегоЗаказНарядДо,
		|	ПравилаУчастия.ПериодПроверкиСуммыДокумента,
		|	ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.Уровень, 0) КАК УровеньПрограммы,
		|	ПравилаУчастия.ДействуетДляОрганизации,
		|	ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности) КАК ТекущаяКартаЛольности
		|ПОМЕСТИТЬ ТаблицаПравил
		|ИЗ
		|	Справочник.Renault_ПравилаУчастияВПрограммеЛояльности КАК ПравилаУчастия
		|ГДЕ
		|	НЕ ПравилаУчастия.ПометкаУдаления
		|	И ПравилаУчастия.ПрограммаЛояльности <> ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).ПрограммаЛояльности
		|	И ЕСТЬNULL(ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).ПрограммаЛояльности.Уровень, 0) < ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.Уровень, 0)
		|	И ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_ТипКарты <> ЗНАЧЕНИЕ(Перечисление.DMS_ТипыКартЛояльности.Бонусная)
		|	И (ПравилаУчастия.ДействуетДляОрганизации = &Организация
		|			ИЛИ ПравилаУчастия.ДействуетДляОрганизации = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|	И (ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = &ЮрФизЛицо
		|			ИЛИ ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(ИключаемыеВидыРемонта.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.пустаяСсылка)) КАК ВидРемонта,
		|	ТаблицаПравил.Ссылка КАК ПравилоУчастия
		|ПОМЕСТИТЬ ИсключенныеПравилаОбмена
		|ИЗ
		|	ТаблицаПравил КАК ТаблицаПравил
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПравилаУчастияВПрограммеЛояльности.ИключаемыеВидыРемонта КАК ИключаемыеВидыРемонта
		|		ПО ТаблицаПравил.Ссылка = ИключаемыеВидыРемонта.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ИключаемыеВидыРемонта.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.пустаяСсылка)),
		|	ТаблицаПравил.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия КАК ПравилоУчастия,
		|	МАКСИМУМ(ЗаказНаряд.СуммаДокумента) КАК СуммаДокумента,
		|	МАКСИМУМ(0) КАК СуммаЗапчастей,
		|	МАКСИМУМ(0) КАК СуммаРабот
		|ПОМЕСТИТЬ мЗаказНаряды
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсключенныеПравилаОбмена КАК ИсключенныеПравилаОбмена
		|		ПО (ЗаказНаряд.ВидРемонта <> ЕСТЬNULL(ИсключенныеПравилаОбмена.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.ПустаяСсылка)))
		|ГДЕ
		|	ЗаказНаряд.ДатаЗакрытия МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -ИсключенныеПравилаОбмена.ПравилоУчастия.ПериодПроверкиСуммыДокумента) И &Период
		|	И ЗаказНаряд.Заказчик = &Заказчик
		|	И ЗаказНаряд.Организация = &Организация
		|	И НЕ ИсключенныеПравилаОбмена.ПравилоУчастия ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия,
		|	МАКСИМУМ(0),
		|	МАКСИМУМ(0),
		|	МАКСИМУМ(ЗаказНаряд.СуммаРаботДокумента)
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсключенныеПравилаОбмена КАК ИсключенныеПравилаОбмена
		|		ПО (ЗаказНаряд.ВидРемонта <> ЕСТЬNULL(ИсключенныеПравилаОбмена.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.ПустаяСсылка)))
		|ГДЕ
		|	ЗаказНаряд.ДатаЗакрытия МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -ИсключенныеПравилаОбмена.ПравилоУчастия.ПериодПроверкиРабот) И &Период
		|	И ЗаказНаряд.Заказчик = &Заказчик
		|	И ЗаказНаряд.Организация = &Организация
		|	И НЕ ИсключенныеПравилаОбмена.ПравилоУчастия ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия,
		|	МАКСИМУМ(0),
		|	МАКСИМУМ(ЗаказНаряд.СуммаНоменклатурыДокумента),
		|	МАКСИМУМ(0)
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсключенныеПравилаОбмена КАК ИсключенныеПравилаОбмена
		|		ПО (ЗаказНаряд.ВидРемонта <> ЕСТЬNULL(ИсключенныеПравилаОбмена.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.ПустаяСсылка)))
		|ГДЕ
		|	ЗаказНаряд.ДатаЗакрытия МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -ИсключенныеПравилаОбмена.ПравилоУчастия.ПериодПроверкиЗапчастей) И &Период
		|	И ЗаказНаряд.Заказчик = &Заказчик
		|	И ЗаказНаряд.Организация = &Организация
		|	И НЕ ИсключенныеПравилаОбмена.ПравилоУчастия ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мЗаказНаряды.ПравилоУчастия,
		|	СУММА(мЗаказНаряды.СуммаДокумента) КАК СуммаДокумента,
		|	СУММА(мЗаказНаряды.СуммаЗапчастей) КАК СуммаЗапчастей,
		|	СУММА(мЗаказНаряды.СуммаРабот) КАК СуммаРабот
		|ПОМЕСТИТЬ СуммыПоПравилам
		|ИЗ
		|	мЗаказНаряды КАК мЗаказНаряды
		|
		|СГРУППИРОВАТЬ ПО
		|	мЗаказНаряды.ПравилоУчастия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СуммыПоПравилам.ПравилоУчастия,
		|	СуммыПоПравилам.СуммаДокумента,
		|	СуммыПоПравилам.СуммаЗапчастей,
		|	СуммыПоПравилам.СуммаРабот,
		|	ТаблицаПравил.ПрограммаЛояльности,
		|	ТаблицаПравил.ТекущаяКартаЛольности,
		|	ВЫБОР
		|		КОГДА ТаблицаПравил.СуммаВсегоЗаказНарядОт >= СуммыПоПравилам.СуммаДокумента
		|				ИЛИ ТаблицаПравил.СуммаВсегоЗаказНарядДо <= СуммыПоПравилам.СуммаДокумента
		|			ТОГДА ИСТИНА
		|		КОГДА ТаблицаПравил.СуммаВсегоРаботОт >= СуммыПоПравилам.СуммаРабот
		|				ИЛИ ТаблицаПравил.СуммаВсегоРаботДо <= СуммыПоПравилам.СуммаРабот
		|			ТОГДА ИСТИНА
		|		КОГДА ТаблицаПравил.СуммаВсегоЗапчастейОт >= СуммыПоПравилам.СуммаЗапчастей
		|				ИЛИ ТаблицаПравил.СуммаВсегоЗапчастейДо <= СуммыПоПравилам.СуммаЗапчастей
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Подходит
		|ПОМЕСТИТЬ мПрограммыЛояльности
		|ИЗ
		|	СуммыПоПравилам КАК СуммыПоПравилам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПравил КАК ТаблицаПравил
		|		ПО СуммыПоПравилам.ПравилоУчастия = ТаблицаПравил.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности) КАК КартаЛояльности,
		|	ПравилаЗаменыБонусныхКарт.ВидБонуснойКарты КАК ВидБонуснойКарты,
		|	ПравилаЗаменыБонусныхКарт.Ссылка КАК ВидКарты,
		|	ПравилаЗаменыБонусныхКарт.СуммаБалловОт КАК СуммаБалловОт
		|ПОМЕСТИТЬ ВидыКартБонусныхКарт
		|ИЗ
		|	Справочник.DMS_ВидыКартЛояльности.ПравилаЗаменыБонусныхКарт КАК ПравилаЗаменыБонусныхКарт
		|ГДЕ
		|	НЕ ПравилаЗаменыБонусныхКарт.Ссылка.ПометкаУдаления
		|	И ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_ВидКартыЛояльности <> ЗНАЧЕНИЕ(Справочник.DMS_ВидыКартЛояльности.пустаяСсылка)
		|	И ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_ТипКарты = ЗНАЧЕНИЕ(Перечисление.DMS_ТипыКартЛояльности.Бонусная)
		|	И ПравилаЗаменыБонусныхКарт.ВидБонуснойКарты = ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_ВидКартыЛояльности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БонусныеБаллы.КартаЛояльности КАК КартаЛояльности,
		|	БонусныеБаллы.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	БонусныеБаллы.НачисленоОстаток КАК Остаток
		|ПОМЕСТИТЬ ОстаткиПоКарте
		|ИЗ
		|	РегистрНакопления.DMS_БонусныеБаллы.Остатки(
		|			&ТекущаяДата,
		|			КартаЛояльности = (ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности))
		|					И ЕСТЬNULL(ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = &ЮрФизЛицо
		|				ИЛИ ЕСТЬNULL(ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) КАК БонусныеБаллы
		|ГДЕ
		|	БонусныеБаллы.НачисленоОстаток + БонусныеБаллы.КСписаниюОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Заказчик КАК Контрагент,
		|	ОстаткиПоКарте.КартаЛояльности КАК КартаЛояльности,
		|	ОстаткиПоКарте.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	ВидыКартБонусныхКарт.ВидКарты КАК ВидКарты,
		|	ОстаткиПоКарте.Остаток КАК Номинал
		|ПОМЕСТИТЬ ЗаменаБонуснойНаНовую
		|ИЗ
		|	ВидыКартБонусныхКарт КАК ВидыКартБонусныхКарт
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиПоКарте КАК ОстаткиПоКарте
		|		ПО ВидыКартБонусныхКарт.КартаЛояльности = ОстаткиПоКарте.КартаЛояльности
		|			И ВидыКартБонусныхКарт.СуммаБалловОт <= ОстаткиПоКарте.Остаток
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаменаБонуснойНаНовую.ВидКарты,
		|	МАКСИМУМ(ЗаменаБонуснойНаНовую.Номинал) КАК Номинал
		|ПОМЕСТИТЬ МаксимальноеЗначениеВидаКарт
		|ИЗ
		|	ЗаменаБонуснойНаНовую КАК ЗаменаБонуснойНаНовую
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаменаБонуснойНаНовую.ВидКарты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПравилаЗаменыДисконтныхКарт.Ссылка КАК ВидКарты,
		|	ПравилаЗаменыДисконтныхКарт.Номинал КАК Номинал,
		|	&Заказчик КАК Контрагент,
		|	ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности) КАК КартаИсточник,
		|	ЗНАЧЕНИЕ(Перечисление.DMS_ВидыОперацийКартЛояльности.ЗаменаДисконтнойКарты) КАК ВидОперации,
		|	&ТекущаяДата КАК Дата,
		|	ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_КартаЗамены КАК КартаПриемник,
		|	&ЗаказНаряд
		|ИЗ
		|	Справочник.DMS_ВидыКартЛояльности.ПравилаЗаменыДисконтныхКарт КАК ПравилаЗаменыДисконтныхКарт
		|ГДЕ
		|	НЕ ПравилаЗаменыДисконтныхКарт.Ссылка.ПометкаУдаления
		|	И ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_ВидКартыЛояльности <> ЗНАЧЕНИЕ(Справочник.DMS_ВидыКартЛояльности.пустаяСсылка)
		|	И ПравилаЗаменыДисконтныхКарт.ВидДисконтнойКарты = ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_ВидКартыЛояльности
		|	И ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_ТипКарты = ЗНАЧЕНИЕ(Перечисление.DMS_ТипыКартЛояльности.Дисконтная)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	мПрограммыЛояльности.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	&Заказчик КАК Контрагент,
		|	&ЗаказНаряд
		|ИЗ
		|	мПрограммыЛояльности КАК мПрограммыЛояльности
		|ГДЕ
		|	мПрограммыЛояльности.Подходит
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПрограммаЛояльности
		|АВТОУПОРЯДОЧИВАНИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаменаБонуснойНаНовую.Контрагент,
		|	ЗаменаБонуснойНаНовую.КартаЛояльности КАК КартаИсточник,
		|	ЗаменаБонуснойНаНовую.ПрограммаЛояльности,
		|	ЗаменаБонуснойНаНовую.ВидКарты,
		|	ЗаменаБонуснойНаНовую.Номинал,
		|	ЗНАЧЕНИЕ(Перечисление.DMS_ВидыОперацийКартЛояльности.ЗаменаБонуснойКарты) КАК ВидОперации,
		|	&ТекущаяДата КАК Дата,
		|	ВЫРАЗИТЬ(&КартаЛояльности КАК Справочник.Renault_КартыЛояльности).DMS_КартаЗамены КАК КартаПриемник,
		|	&ЗаказНаряд
		|ИЗ
		|	ЗаменаБонуснойНаНовую КАК ЗаменаБонуснойНаНовую
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МаксимальноеЗначениеВидаКарт КАК МаксимальноеЗначениеВидаКарт
		|		ПО ЗаменаБонуснойНаНовую.ВидКарты = МаксимальноеЗначениеВидаКарт.ВидКарты
		|			И ЗаменаБонуснойНаНовую.Номинал = МаксимальноеЗначениеВидаКарт.Номинал";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаЗаменыДисконтнойНаБонусную = РезультатЗапроса[9].Выбрать();
	
	МассивВидовЗамен = Новый Массив;
	
	Пока ВыборкаЗаменыДисконтнойНаБонусную.Следующий() Цикл
		
		СтруктураДаннных = Новый Структура("Контрагент,ВидОперации,Дата,КартаИсточник,КартаПриемник,ВидКарты,Номинал,ЗаказНаряд");
		
		ЗаполнитьЗначенияСвойств(СтруктураДаннных,ВыборкаЗаменыДисконтнойНаБонусную);
		
		МассивВидовЗамен.Добавить(СтруктураДаннных);
				
	КонецЦикла;                                     
	
	Если МассивВидовЗамен.Количество() > 0 Тогда
		
		#Если Клиент Тогда
			
			Если Вопрос("Заменить клиенту дисконтную карту на бонусную?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
				
				Сообщить("Клиенту можно заменить карту.");
				
				Возврат Неопределено;
				
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("МассивВариантовЗамены",МассивВидовЗамен);
			
			ОткрытьФормуМодально("Документ.DMS_ЗаменаКартЛояльности.Форма.ФормаВыбораПрограммЛояльности",ПараметрыФормы);
			
			Для каждого ТекущаяСтруктураПоиска Из МассивВидовЗамен Цикл
				
				мКарта = ПолучитьСозданнуюНовуюКарту(ТекущаяСтруктураПоиска);
				
				Если ЗначениеЗаполнено(мКарта) Тогда
					Возврат мКарта;
				КонецЕсли; 	
			
			КонецЦикла; 
			
			Возврат Неопределено;
			
		#КонецЕсли
		
	КонецЕсли; 	
	
	ВыборкаПредложенияДисконтнойКарты = РезультатЗапроса[10].Выбрать();
	
	СписокПрограмм = Новый СписокЗначений;
	
	Пока ВыборкаПредложенияДисконтнойКарты.Следующий() Цикл
		СписокПрограмм.Добавить(ВыборкаПредложенияДисконтнойКарты.ПрограммаЛояльности);	
	КонецЦикла; 
	
	Если СписокПрограмм.Количество() > 0 Тогда
		Возврат ПредложитьДисконтнуюКарту(СписокПрограмм,Заказчик,Организация,КартаЛояльности,Период);	
	КонецЕсли; 
	
	ВыборкаЗаменыНаНовуюБонускнуюКарту = РезультатЗапроса[11].Выбрать();
	
	Если ВыборкаЗаменыНаНовуюБонускнуюКарту.Следующий() Тогда
		
		#Если Клиент Тогда
			
			Если Вопрос("Заменить клиенту бонусную карту на новую?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
				
				Сообщить("Клиенту можно заменить карту.");
				
				Возврат Неопределено;
				
			КонецЕсли;
			
			ДанныеЗаменыКарты = Новый Структура("Контрагент,ВидОперации,Дата,КартаИсточник,КартаПриемник,ВидКарты,Номинал,ЗаказНаряд");
			
			ЗаполнитьЗначенияСвойств(ДанныеЗаменыКарты,ВыборкаЗаменыНаНовуюБонускнуюКарту);		
			
			ПараметрыФормы = Новый Структура("ДанныеЗаменыКарты",ДанныеЗаменыКарты);
			
			ОткрытьФормуМодально("Документ.DMS_ЗаменаКартЛояльности.Форма.ФормаДокумента",ПараметрыФормы);
			
			Возврат ПолучитьСозданнуюНовуюКарту(ДанныеЗаменыКарты);
			
		#КонецЕсли
		
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции

Функция ПроверитьВозможностьВыдачиКартыБонусной(Организация,Заказчик,Период,ЗаказНаряд = Неопределено) Экспорт 
	
	ЮрФизЛицо = КонтрагентЮрФизЛицо(Заказчик,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказчик", 		 Заказчик);
	Запрос.УстановитьПараметр("Организация", 	 Организация);
	Запрос.УстановитьПараметр("Период",		     Период);
	Запрос.УстановитьПараметр("ТекущаяДата",     ТекущаяДата());
	Запрос.УстановитьПараметр("ЮрФизЛицо",       ЮрФизЛицо);//DMS
	Запрос.УстановитьПараметр("ЗаказНаряд",      ?(ЗаказНаряд = Неопределено,Документы.ЗаказНаряд.ПустаяСсылка(),ЗаказНаряд));//DMS
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПравилаУчастия.Ссылка,
		|	ПравилаУчастия.СуммаВсегоРаботОт КАК СуммаВсегоРаботОт,
		|	ПравилаУчастия.СуммаВсегоЗапчастейОт КАК СуммаВсегоЗапчастейОт,
		|	ПравилаУчастия.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	ПравилаУчастия.ПериодПроверкиРабот,
		|	ПравилаУчастия.ПериодПроверкиЗапчастей,
		|	ПравилаУчастия.СуммаВсегоЗаказНарядОт,
		|	ПравилаУчастия.СуммаВсегоРаботДо,
		|	ПравилаУчастия.СуммаВсегоЗапчастейДо,
		|	ПравилаУчастия.СуммаВсегоЗаказНарядДо,
		|	ПравилаУчастия.ПериодПроверкиСуммыДокумента,
		|	ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.Уровень, 0) КАК УровеньПрограммы,
		|	ПравилаУчастия.ДействуетДляОрганизации
		|ПОМЕСТИТЬ ТаблицаПравил
		|ИЗ
		|	Справочник.Renault_ПравилаУчастияВПрограммеЛояльности КАК ПравилаУчастия
		|ГДЕ
		|	НЕ ПравилаУчастия.ПометкаУдаления
		|	И (ПравилаУчастия.ДействуетДляОрганизации <> &Организация
		|			ИЛИ ПравилаУчастия.ДействуетДляОрганизации = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
		|	И (ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = &ЮрФизЛицо
		|			ИЛИ ЕСТЬNULL(ПравилаУчастия.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(ИключаемыеВидыРемонта.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.пустаяСсылка)) КАК ВидРемонта,
		|	ТаблицаПравил.Ссылка КАК ПравилоУчастия
		|ПОМЕСТИТЬ ИсключенныеПравилаОбмена
		|ИЗ
		|	ТаблицаПравил КАК ТаблицаПравил
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПравилаУчастияВПрограммеЛояльности.ИключаемыеВидыРемонта КАК ИключаемыеВидыРемонта
		|		ПО ТаблицаПравил.Ссылка = ИключаемыеВидыРемонта.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ИключаемыеВидыРемонта.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.пустаяСсылка)),
		|	ТаблицаПравил.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказНаряд.Ссылка КАК ЗаказНаряд,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия КАК ПравилоУчастия,
		|	МАКСИМУМ(ЗаказНаряд.СуммаДокумента) КАК СуммаДокумента,
		|	МАКСИМУМ(0) КАК СуммаЗапчастей,
		|	МАКСИМУМ(0) КАК СуммаРабот
		|ПОМЕСТИТЬ мЗаказНаряды
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсключенныеПравилаОбмена КАК ИсключенныеПравилаОбмена
		|		ПО (ЗаказНаряд.ВидРемонта <> ЕСТЬNULL(ИсключенныеПравилаОбмена.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.ПустаяСсылка)))
		|ГДЕ
		|	ЗаказНаряд.ДатаЗакрытия МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -ИсключенныеПравилаОбмена.ПравилоУчастия.ПериодПроверкиСуммыДокумента) И &Период
		|	И ЗаказНаряд.Заказчик = &Заказчик
		|	И ЗаказНаряд.Организация = &Организация
		|	И НЕ ИсключенныеПравилаОбмена.ПравилоУчастия ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия,
		|	МАКСИМУМ(0),
		|	МАКСИМУМ(0),
		|	МАКСИМУМ(ЗаказНаряд.СуммаРаботДокумента)
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсключенныеПравилаОбмена КАК ИсключенныеПравилаОбмена
		|		ПО (ЗаказНаряд.ВидРемонта <> ЕСТЬNULL(ИсключенныеПравилаОбмена.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.ПустаяСсылка)))
		|ГДЕ
		|	ЗаказНаряд.ДатаЗакрытия МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -ИсключенныеПравилаОбмена.ПравилоУчастия.ПериодПроверкиРабот) И &Период
		|	И ЗаказНаряд.Заказчик = &Заказчик
		|	И ЗаказНаряд.Организация = &Организация
		|	И НЕ ИсключенныеПравилаОбмена.ПравилоУчастия ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия,
		|	МАКСИМУМ(0),
		|	МАКСИМУМ(ЗаказНаряд.СуммаНоменклатурыДокумента),
		|	МАКСИМУМ(0)
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИсключенныеПравилаОбмена КАК ИсключенныеПравилаОбмена
		|		ПО (ЗаказНаряд.ВидРемонта <> ЕСТЬNULL(ИсключенныеПравилаОбмена.ВидРемонта, ЗНАЧЕНИЕ(Справочник.ВидыРемонта.ПустаяСсылка)))
		|ГДЕ
		|	ЗаказНаряд.ДатаЗакрытия МЕЖДУ ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -ИсключенныеПравилаОбмена.ПравилоУчастия.ПериодПроверкиЗапчастей) И &Период
		|	И ЗаказНаряд.Заказчик = &Заказчик
		|	И ЗаказНаряд.Организация = &Организация
		|	И НЕ ИсключенныеПравилаОбмена.ПравилоУчастия ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказНаряд.Ссылка,
		|	ИсключенныеПравилаОбмена.ПравилоУчастия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мЗаказНаряды.ПравилоУчастия,
		|	СУММА(мЗаказНаряды.СуммаДокумента) КАК СуммаДокумента,
		|	СУММА(мЗаказНаряды.СуммаЗапчастей) КАК СуммаЗапчастей,
		|	СУММА(мЗаказНаряды.СуммаРабот) КАК СуммаРабот
		|ПОМЕСТИТЬ СуммыПоПравилам
		|ИЗ
		|	мЗаказНаряды КАК мЗаказНаряды
		|
		|СГРУППИРОВАТЬ ПО
		|	мЗаказНаряды.ПравилоУчастия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СуммыПоПравилам.ПравилоУчастия,
		|	СуммыПоПравилам.СуммаДокумента,
		|	СуммыПоПравилам.СуммаЗапчастей,
		|	СуммыПоПравилам.СуммаРабот,
		|	ТаблицаПравил.ПрограммаЛояльности,
		|	ВЫБОР
		|		КОГДА ТаблицаПравил.СуммаВсегоЗаказНарядОт >= СуммыПоПравилам.СуммаДокумента
		|				ИЛИ ТаблицаПравил.СуммаВсегоЗаказНарядДо <= СуммыПоПравилам.СуммаДокумента
		|			ТОГДА ИСТИНА
		|		КОГДА ТаблицаПравил.СуммаВсегоРаботОт >= СуммыПоПравилам.СуммаРабот
		|				ИЛИ ТаблицаПравил.СуммаВсегоРаботДо <= СуммыПоПравилам.СуммаРабот
		|			ТОГДА ИСТИНА
		|		КОГДА ТаблицаПравил.СуммаВсегоЗапчастейОт >= СуммыПоПравилам.СуммаЗапчастей
		|				ИЛИ ТаблицаПравил.СуммаВсегоЗапчастейДо <= СуммыПоПравилам.СуммаЗапчастей
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Подходит
		|ПОМЕСТИТЬ мПрограммыЛояльности
		|ИЗ
		|	СуммыПоПравилам КАК СуммыПоПравилам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПравил КАК ТаблицаПравил
		|		ПО СуммыПоПравилам.ПравилоУчастия = ТаблицаПравил.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	мПрограммыЛояльности.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	МАКСИМУМ(&Заказчик) КАК Контрагент,
		|	ПравилаВыдачиКарт.Ссылка КАК ВидКарты,
		|	СУММА(ПравилаВыдачиКарт.Номинал) КАК Номинал,
		|	ЗНАЧЕНИЕ(перечисление.DMS_ВидыОперацийКартЛояльности.ВыдачаБонуснойКарты) КАК ВидОперации,
		|	ЗНАЧЕНИЕ(Перечисление.DMS_СтатусЗаменыКарт.НаОзнакомлении) КАК Статус,
		|	&ТекущаяДата КАК Дата,
		|	&ЗаказНаряд КАК ЗаказНаряд
		|ИЗ
		|	мПрограммыЛояльности КАК мПрограммыЛояльности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.DMS_ВидыКартЛояльности.ПравилаВыдачиКарт КАК ПравилаВыдачиКарт
		|		ПО мПрограммыЛояльности.ПрограммаЛояльности = ПравилаВыдачиКарт.ПрограммаЛояльности
		|ГДЕ
		|	мПрограммыЛояльности.Подходит
		|
		|СГРУППИРОВАТЬ ПО
		|	ПравилаВыдачиКарт.Ссылка,
		|	мПрограммыЛояльности.ПрограммаЛояльности
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	МассивВариантов = Новый Массив;
	
	Пока ВыборкаДанных.Следующий() Цикл
	
		СтруктураВариантов = Новый Структура;
		
		Для каждого ТекущаяКолонка Из РезультатЗапроса.Колонки Цикл
			СтруктураВариантов.Вставить(ТекущаяКолонка.Имя,ВыборкаДанных[ТекущаяКолонка.Имя]);
		КонецЦикла; 
		
		МассивВариантов.Добавить(СтруктураВариантов);
		
	КонецЦикла; 
	
	Если МассивВариантов.Количество() > 0 Тогда
		
		#Если Клиент Тогда
			
			Если Вопрос("Выдать клиенту новую бонусную карту?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
				
				Сообщить("Клиенту можно выдать бонусную карту.");
				
				Возврат Неопределено;
				
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("МассивВариантов",МассивВариантов);
			
			ОткрытьФормуМодально("Документ.DMS_ВыдачаКартыЛояльности.Форма.ФормаВыбораВариантов",ПараметрыФормы);
			
			Для каждого ТекущаяСтруктураПоиска Из МассивВариантов Цикл
				
				мКарта = ПолучитьРаннееСозданнуюНовуюБонуснуюКарт(ТекущаяСтруктураПоиска);
				
				Если ЗначениеЗаполнено(мКарта) Тогда
					Возврат мКарта;
				КонецЕсли; 	
				
			КонецЦикла; 
			
		#КонецЕсли
		
		Возврат Неопределено;
		
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции

Функция ПредложитьДисконтнуюКарту(СписокПрограмм,Контрагент,Организация,СуществующаяКарта,ТекущаяДата)
	
	Если ЗначениеЗаполнено(СписокПрограмм) Тогда
		
		#Если Клиент Тогда
			
			Если Вопрос("Выдать клиенту новую дисконтную карту?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
				
				Сообщить("Клиенту можно выдать карту.");
				
				Возврат Неопределено;
				
			КонецЕсли;
						
			Если СписокПрограмм.Количество() = 1 Тогда
								
				НоваяКарта = Справочники.Renault_КартыЛояльности.СоздатьЭлемент();
				НоваяКарта.УстановитьНовыйКод();
				НоваяКарта.Контрагент = Контрагент;
				НоваяКарта.Наименование = "Карта: " + Строка(Контрагент);
				НоваяКарта.Примечание = "";
				НоваяКарта.ДатаВыдачи = ТекущаяДата;
				НоваяКарта.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
				НоваяКарта.ПрограммаЛояльности = СписокПрограмм[0].Значение;
				НоваяКарта.КемВыдана = ПараметрыСеанса.Пользователь.Сотрудник;
				НоваяКарта.Записать();
				
				Если ЗначениеЗаполнено(СуществующаяКарта) Тогда
					
					ПеренестиБаллыНаНовуюКарту(СуществующаяКарта, НоваяКарта, НоваяКарта.ПрограммаЛояльности);
					
				КонецЕсли;
				
				Форма = НоваяКарта.ПолучитьФорму();
				Форма.ОткрытьМодально();
				
			ИначеЕсли СписокПрограмм.Количество() > 1 Тогда
				
				Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
				Форма.Заголовок = "Какую программу лояльности выдаем?";
				Форма.СписокВыбора = СписокПрограмм;
				
				Ответ = Форма.ОткрытьМодально();
				
				Если ЗначениеЗаполнено(Ответ) Тогда
										
					НоваяКарта = Справочники.Renault_КартыЛояльности.СоздатьЭлемент();
					НоваяКарта.УстановитьНовыйКод();
					НоваяКарта.Контрагент = Контрагент;
					НоваяКарта.Наименование = "Карта: " + Строка(Контрагент);
					НоваяКарта.Примечание = "";
					НоваяКарта.ДатаВыдачи = ТекущаяДата;
					НоваяКарта.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
					НоваяКарта.ПрограммаЛояльности = Ответ;
					НоваяКарта.КемВыдана = ПараметрыСеанса.Пользователь.Сотрудник;
					НоваяКарта.Записать();
										
					Форма = НоваяКарта.ПолучитьФорму();
					Форма.ОткрытьМодально();
					
				КонецЕсли;
				
			КонецЕсли;			
			
		#КонецЕсли
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ПредложитьДисконтнуюКарту()

Функция ПолучитьРаннееСозданнуюНовуюБонуснуюКарт(ПараметрыЗапроса)
	
	Запрос = Новый Запрос;
	
	Для каждого ТекущийПараметр Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(ТекущийПараметр.Ключ,ТекущийПараметр.Значение);
	КонецЦикла; 
	
	ЮрФизЛицо = КонтрагентЮрФизЛицо(ПараметрыЗапроса.Контрагент,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	Запрос.УстановитьПараметр("ЮрФизЛицо",ЮрФизЛицо);//DMS	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КартыПокупателей.КартаЛояльности,
		|	КартыПокупателей.Ссылка
		|ИЗ
		|	Документ.DMS_ВыдачаКартыЛояльности.КартыПокупателей КАК КартыПокупателей
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(КартыПокупателей.Ссылка.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|	И КартыПокупателей.Ссылка.ВидОперации = &ВидОперации
		|	И НЕ ЕСТЬNULL(КартыПокупателей.КартаЛояльности.Недействительна, ИСТИНА)
		|	И КартыПокупателей.КартаЛояльности.Контрагент = &Контрагент
		|	И КартыПокупателей.КартаЛояльности <> ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.пустаяСсылка)
		|	И КартыПокупателей.ВидКарты = &ВидКарты
		|	И КартыПокупателей.Ссылка.ПрограммаЛояльности = &ПрограммаЛояльности
		|	И (ЕСТЬNULL(КартыПокупателей.Ссылка.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = &ЮрФизЛицо
		|			ИЛИ ЕСТЬNULL(КартыПокупателей.Ссылка.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка))
		|	И КартыПокупателей.Ссылка.ЗаказНаряд = &ЗаказНаряд";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();

	Если ВыборкаДанных.Следующий() Тогда
		Возврат ВыборкаДанных.КартаЛояльности;	
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции // ПолучитьРаннееСозданнуюЗаменуКарт()

Функция ПолучитьКартуЛояльностиКлиента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	ЮрФизЛицо = КонтрагентЮрФизЛицо(Контрагент,Renault_CRM.ПолучитьДилерскийЦентрПользователя());//DMS
	Запрос.УстановитьПараметр("ЮрФизЛицо",ЮрФизЛицо);//DMS	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	КартыЛояльности.Ссылка
		|ИЗ
		|	Справочник.Renault_КартыЛояльности КАК КартыЛояльности
		|ГДЕ
		|	КартыЛояльности.Контрагент = &Контрагент
		|	И НЕ КартыЛояльности.ПометкаУдаления
		|	И НЕ КартыЛояльности.Недействительна
		|	И (ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = &ЮрФизЛицо
		|			ИЛИ ЕСТЬNULL(КартыЛояльности.ПрограммаЛояльности.DMS_ЮрФизЛицо, ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	КартаЛояльности = Справочники.Renault_КартыЛояльности.ПустаяСсылка();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		КартаЛояльности = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли; 
	
	Возврат КартаЛояльности;

КонецФункции // ПолучитьКартуЛояльностиКлиента()

Функция Renault_ЕстьПривилегии(Контрагент = Неопределено, КартаЛояльности = Неопределено) Экспорт
	
			
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", 	 ?(Контрагент <> Неопределено, Контрагент,Справочники.Контрагенты.ПустаяСсылка()));
	Запрос.УстановитьПараметр("КартаЛояльности", ?(КартаЛояльности<>Неопределено,КартаЛояльности,Справочники.Renault_КартыЛояльности.ПустаяСсылка()));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	КартыЛояльности.Контрагент КАК Контрагент,
		|	КартыЛояльности.Ссылка КАК КартаЛояльности
		|ПОМЕСТИТЬ ДанныеПоКонтрагенту
		|ИЗ
		|	Справочник.Renault_КартыЛояльности КАК КартыЛояльности
		|ГДЕ
		|	(КартыЛояльности.Ссылка = &КартаЛояльности
		|			ИЛИ &КартаЛояльности = ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.ПустаяСсылка))
		|	И (КартыЛояльности.Контрагент = &Контрагент
		|			ИЛИ &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.пустаяСсылка))
		|	И НЕ КартыЛояльности.ПометкаУдаления
		|	И НЕ КартыЛояльности.Недействительна
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПоКонтрагенту.Контрагент,
		|	ДанныеПоКонтрагенту.КартаЛояльности
		|ИЗ
		|	ДанныеПоКонтрагенту КАК ДанныеПоКонтрагенту
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПривилегииПоКарте.Привилегия КАК Привилегия
		|ИЗ
		|	ДанныеПоКонтрагенту КАК ДанныеПоКонтрагенту
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.DMS_ВидыКартЛояльности.Привилегии КАК ПривилегииПоКарте
		|		ПО ДанныеПоКонтрагенту.КартаЛояльности.DMS_ВидКартыЛояльности = ПривилегииПоКарте.Ссылка";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатЗапроса[1].Пустой() Тогда
		
		Возврат Ложь;
		
	КонецЕсли; 
		
	ДанныеПоПривилегиям = РезультатЗапроса[2].Выбрать();
	
	Если ДанныеПоПривилегиям.Количество() = 0 Тогда
				
		Возврат Ложь;
		
	КонецЕсли; 
		
    Возврат Истина;
	
КонецФункции

Функция ПечатьПривилегийКартыКлиента(Контрагент = Неопределено,КартаЛояльности = Неопределено) Экспорт 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
		
	ТабличныйДокумент.ТолькоПросмотр  = Истина;
	ТабличныйДокумент.АвтоМасштаб     = Истина;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	
	Макет = ПолучитьОбщийМакет("DMS_МакетПривилегии");
	
	ОбластьШапка 	  = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьПривилегии = Макет.ПолучитьОбласть("ОбластьПривилегии");
	ОбластьНетДанных  = Макет.ПолучитьОбласть("ОбластьНетДанных");
	
	Если Контрагент = Неопределено 
		И КартаЛояльности = Неопределено Тогда
		
		ТабличныйДокумент.Вывести(ОбластьНетДанных);
		
		Возврат ТабличныйДокумент;
		
	КонецЕсли; 
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", 	 ?(Контрагент <> Неопределено, Контрагент,Справочники.Контрагенты.ПустаяСсылка()));
	Запрос.УстановитьПараметр("КартаЛояльности", ?(КартаЛояльности<>Неопределено,КартаЛояльности,Справочники.Renault_КартыЛояльности.ПустаяСсылка()));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	КартыЛояльности.Контрагент КАК Контрагент,
		|	КартыЛояльности.Ссылка КАК КартаЛояльности
		|ПОМЕСТИТЬ ДанныеПоКонтрагенту
		|ИЗ
		|	Справочник.Renault_КартыЛояльности КАК КартыЛояльности
		|ГДЕ
		|	(КартыЛояльности.Ссылка = &КартаЛояльности
		|			ИЛИ &КартаЛояльности = ЗНАЧЕНИЕ(Справочник.Renault_КартыЛояльности.ПустаяСсылка))
		|	И (КартыЛояльности.Контрагент = &Контрагент
		|			ИЛИ &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.пустаяСсылка))
		|	И НЕ КартыЛояльности.ПометкаУдаления
		|	И НЕ КартыЛояльности.Недействительна
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеПоКонтрагенту.Контрагент,
		|	ДанныеПоКонтрагенту.КартаЛояльности
		|ИЗ
		|	ДанныеПоКонтрагенту КАК ДанныеПоКонтрагенту
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПривилегииПоКарте.Привилегия КАК Привилегия
		|ИЗ
		|	ДанныеПоКонтрагенту КАК ДанныеПоКонтрагенту
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.DMS_ВидыКартЛояльности.Привилегии КАК ПривилегииПоКарте
		|		ПО ДанныеПоКонтрагенту.КартаЛояльности.DMS_ВидКартыЛояльности = ПривилегииПоКарте.Ссылка";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатЗапроса[1].Пустой() Тогда
		
		ТабличныйДокумент.Вывести(ОбластьНетДанных);
		
		Возврат ТабличныйДокумент;
		
	КонецЕсли; 
	
	ШапкаВывода = РезультатЗапроса[1].Выбрать();
	
	Если ШапкаВывода.Следующий() Тогда
		
		ОбластьШапка.Параметры.Заполнить(ШапкаВывода);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
	КонецЕсли;
	
	ДанныеПоПривилегиям = РезультатЗапроса[2].Выбрать();
	
	Если ДанныеПоПривилегиям.Количество() = 0 Тогда
		
		ТабличныйДокумент.Вывести(ОбластьНетДанных);
		
		Возврат ТабличныйДокумент;
		
	КонецЕсли; 
	
	Пока ДанныеПоПривилегиям.Следующий() Цикл
		
		ОбластьПривилегии.Параметры.Заполнить(ДанныеПоПривилегиям);
		ТабличныйДокумент.Вывести(ОбластьПривилегии);
		
	КонецЦикла; 
	
    Возврат ТабличныйДокумент;
	
КонецФункции // ПечатьПривилегийКартыКлиента()

Функция КонтрагентЮрФизЛицо(Контрагент,ДилерскийЦентр)
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Перечисления.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка();
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДилерскийЦентр", 	ДилерскийЦентр);
	Запрос.УстановитьПараметр("ФормаСобственности", Контрагент.ФормаСобственности);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	СопоставлениеФормСобственности.ЮрФизЛицо
		|ИЗ
		|	Справочник.CRM_ДилерскиеЦентры.DMS_СопоставлениеФормСобственности КАК СопоставлениеФормСобственности
		|ГДЕ
		|	СопоставлениеФормСобственности.ФормаСобственности = &ФормаСобственности
		|	И СопоставлениеФормСобственности.Ссылка = &ДилерскийЦентр";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Значение = Перечисления.DMS_ЮридическоеФизическоеЛицо.ПустаяСсылка();
	
	Если Выборка.Следующий() Тогда
		Значение = Выборка.ЮрФизЛицо;
	КонецЕсли; 
	
	Возврат Значение;
	
КонецФункции // КонтрагентЮрФизЛицо()

Функция ЕстьВыдачаИлиЗаменаНаОснованииЗаказНаряда(ЗаказНаряд)
	
	Если Не ЗначениеЗаполнено(ЗаказНаряд) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	ЗаменаКартЛояльности.ЗаказНаряд
		|ИЗ
		|	Документ.DMS_ЗаменаКартЛояльности КАК ЗаменаКартЛояльности
		|ГДЕ
		|	ЗаменаКартЛояльности.ЗаказНаряд = &ЗаказНаряд
		|	И НЕ ЗаменаКартЛояльности.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	ВыдачаКартыЛояльности.ЗаказНаряд
		|ИЗ
		|	Документ.DMS_ВыдачаКартыЛояльности КАК ВыдачаКартыЛояльности
		|ГДЕ
		|	ВыдачаКартыЛояльности.ЗаказНаряд = &ЗаказНаряд
		|	И НЕ ВыдачаКартыЛояльности.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции // ЕстьВыдачаИлиЗаменаНаОснованииЗаказНаряда()
 

