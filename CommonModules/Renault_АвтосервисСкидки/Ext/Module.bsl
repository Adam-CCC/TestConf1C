			КонецЕсли;
			
		КонецЕсли;
		
		Если ВсегоБаллов > 0 Тогда
			
			ВсегоБалловНачислено = Окр(ВсегоБаллов, 2);
			
			Если ТипЗнч(Карта_ПрограммаЛояльности) = Тип("СправочникСсылка.Renault_КартыЛояльности")//DMS
				И ЗначениеЗаполнено(Карта_ПрограммаЛояльности) Тогда
				Renault_ЗаписатьОстатокБаллов(Контрагент, Карта_ПрограммаЛояльности, 0, ВсегоБалловНачислено, ЗаказНаряд);
