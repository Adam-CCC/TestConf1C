Процедура ОповещениеОЗацикленныхЦепочкахОснований(Параметры = Неопределено)  Экспорт
	xmlЗапись = Новый ЗаписьXML;
	xmlЗапись.УстановитьСтроку();
	
	HelpDeskУзел = ПланыОбмена.ЗацикленныеЦепочкиОснований.НайтиПоКоду("HelpDesk");
	Если обЗначениеНеЗаполнено(HelpDeskУзел) Тогда
		Возврат;
	КонецЕсли;
	
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(xmlЗапись, HelpDeskУзел);
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    ДокументСсылка = ВыборкаИзменений.Получить();
		Если ТипЗнч(ДокументСсылка) = Тип("УдалениеОбъекта") Тогда
			Продолжить;
		ИначеЕсли ДокументСсылка = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
	    //ЗаписатьXML(xmlЗапись, ДокументСсылка);
	КонецЦикла;
	
	ЗаписьСообщения.ЗакончитьЗапись();
КонецПроцедуры
