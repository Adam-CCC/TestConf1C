Процедура РазослатьОповещенияОБрошенныхРЛ(Параметры = Неопределено)  Экспорт
	ДатаНачала = Дата(2019, 05, 01);
	ДатаОкончания = НачалоДня(ТекущаяДата());
	
	ЗапросПриглашения = Новый Запрос();
	ЗапросПриглашения.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ЗапросПриглашения.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ЗапросПриглашения.УстановитьПараметр("Создан", Справочники.СтатусыРабочегоЛиста.Создан);
	ЗапросПриглашения.УстановитьПараметр("ПустойРезультат", Справочники.РезультатКонтакта.ПустаяСсылка());
	ЗапросПриглашения.Текст = "ВЫБРАТЬ
	                          |	РабочийЛистСервиса.Номер,
	                          |	РабочийЛистСервиса.ДатаКонтакта,
	                          |	РабочийЛистСервиса.Менеджер КАК Сотрудник,
	                          |	РабочийЛистСервиса.ПодразделениеКомпании КАК ПодразделениеКомпании
	                          |ИЗ
	                          |	Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
	                          |ГДЕ
	                          |	РабочийЛистСервиса.ДатаКонтакта МЕЖДУ &ДатаНачала И &ДатаОкончания
	                          |	И (РабочийЛистСервиса.Статус = &Создан
	                          |			ИЛИ РабочийЛистСервиса.РезультатКонтакта = &ПустойРезультат)
	                          |ИТОГИ ПО
	                          |	ПодразделениеКомпании";
	
	РассылкаПоПодразделениям = ЗапросПриглашения.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДисконтЗапчастьООО = Справочники.Организации.НайтиПоКоду("ЦБ000015");
	Пока РассылкаПоПодразделениям.Следующий() Цикл
		Подразделение = РассылкаПоПодразделениям.ПодразделениеКомпании;
		Если обЗначениеНеЗаполнено(Подразделение) Тогда
			Продолжить;
		//ИначеЕсли Подразделение.Организация = ДисконтЗапчастьООО Тогда
		//	Продолжить;
		КонецЕсли;
		
		мКому = Новый Массив();
		Если ЗначениеЗаполнено(Подразделение.EmailСервисБюро) Тогда
			мКому.Добавить(Подразделение.EmailСервисБюро);
		Иначе
			АдресЭлПочты = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
			Если ЗначениеЗаполнено(АдресЭлПочты) Тогда
				мКому.Добавить(АдресЭлПочты);
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Подразделение.РуководительСервиса) Тогда
			Руководитель = Подразделение.РуководительСервиса.Сотрудник;
		Иначе
			Руководитель = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;
		Если ЗначениеЗаполнено(Руководитель) Тогда
			Если ЗначениеЗаполнено(Руководитель.РабочийEmail) Тогда
				мКому.Добавить(Руководитель.РабочийEmail);
			Иначе
				АдресЭлПочты = киПолучитьПредставлениеКИ(Руководитель, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
				Если ЗначениеЗаполнено(АдресЭлПочты) Тогда
					мКому.Добавить(АдресЭлПочты);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если мКому.Количество() > 0 Тогда
			ТемаПисьма = "Уведомление о брошенных рабочих листах сервиса";
			ТелоПисьма = "По подразделению " + Подразделение + " имеются брошенные рабочие листы сервиса:" + Символы.ПС + Символы.ПС;
			РассылкаПоРабочимЛистам = РассылкаПоПодразделениям.Выбрать();
			Пока РассылкаПоРабочимЛистам.Следующий() Цикл
				ТелоПисьма = ТелоПисьма + РассылкаПоРабочимЛистам.Номер + ", дата контакта " + Формат(РассылкаПоРабочимЛистам.ДатаКонтакта, "ДЛФ=Д");
				ТелоПисьма = ТелоПисьма + ", менеджер " + РассылкаПоРабочимЛистам.Сотрудник + ";" + Символы.ПС;
			КонецЦикла;		
			мКопии = Новый Массив();
			г_Функции.СоздатьИОтпраитьЭлПисьмо(мКому, мКопии, ТемаПисьма, ТелоПисьма, Документы.ЗаказНаряд.ПустаяСсылка());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
