//Овечкин++ 20260930
#Если Клиент Тогда
Если Тип_Источника = Тип("ДокументОбъект.РеализацияТоваров") Тогда
	Параметры = Модуль_ГВС.Присутствие_Маркированная_Номенклатура(Источник.Товары);
	
	Если Параметры.Маркировка_Присутствует Тогда
		Количество_Маркированной_Номенклатуры = Параметры.Сумма_Количество_В_Позициях;
		Если Количество_Маркированной_Номенклатуры <> Источник.КодыМаркировки.Количество() Тогда
			Если РольДоступна("ПолныеПрава") ИЛИ РольДоступна("СМ_ИТОтдел") Тогда
				Сообщить("При проведении обнаружены ошибки маркировки!!!");
			Иначе
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Попытка
			ТаблицаРезультата = SM_API_ЧЗ.ПроверитьКМ(Источник);
			ИННОрганизации = СтрЗаменить(Строка(Источник.Организация.ИНН)," ","");
			ОшибкаКМ = Ложь;
			КМНеНайден = Ложь;
			НесовпадениеВладельцаИлиСтатуса = Ложь;
			Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
				Если СтрокаРезультата.ИННВладельца <> ИННОрганизации Тогда
					ОшибкаКМ = Истина;
					НесовпадениеВладельцаИлиСтатуса = Истина;
					Сообщить("КМ " + Строка(СтрокаРезультата.КИ)+ ": ИНН владельца " + Строка(СтрокаРезультата.ИННВладельца)+ " не совпадает с ИНН организации " + ИННОрганизации + "У маркировки другой владелец:" + Строка(СтрокаРезультата.Владелец));
				КонецЕсли;
				Если СтрокаРезультата.Статус = "Списан" ИЛИ СтрокаРезультата.Статус = "Выбыл"  Тогда
					ОшибкаКМ = Истина;
					НесовпадениеВладельцаИлиСтатуса = Истина;
					Сообщить("КМ " + Строка(СтрокаРезультата.КИ)+ " имеет статус ""Списан"".");
				КонецЕсли;
			КонецЦикла; 
			
			Если КМНеНайден Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;  
			
			Если НесовпадениеВладельцаИлиСтатуса Тогда
				Если Источник.Проведен Тогда
					Если РольДоступна("ПолныеПрава") ИЛИ РольДоступна("СМ_Бухгалтер") Тогда
						Ответ = Вопрос("Вы уверены, что хотите провести документ, который уже выгружен в ЧЗ?"+ Символы.ПС+ "Маркировки уже находятся у другого владельца или имеют статус ""Списан""."+ Символы.ПС+ "Продолжить проведение?",РежимДиалогаВопрос.ДаНет);
						Если Ответ = КодВозвратаДиалога.Да Тогда
							ОшибкаКМ = Ложь;
						Иначе
							Отказ = Истина;
							Возврат;
						КонецЕсли;
					Иначе
						Отказ = Истина;
						Возврат;
					КонецЕсли;
				Иначе
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			КонецЕсли; 
			
			Если ОшибкаКМ Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли; 
			
		Исключение  
			ТекстОшибки = ОписаниеОшибки();
			Если СтрНайти(ТекстОшибки,"Не удалось получить токен ЧЗ") > 0
				ИЛИ СтрНайти(ТекстОшибки,"Не найден сертификат для подписи") > 0 Тогда
				Ответ = Вопрос("Токен не найден. Провести реализацию без проверки в ЧЗ?",РежимДиалогаВопрос.ДаНет);
				Если Ответ = КодВозвратаДиалога.Нет Тогда
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			Иначе
				Сообщить("Ошибка проверки КМ: " + ТекстОшибки);
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
КонецЕсли;
#КонецЕсли
