Процедура ОтправитьЭлектронныйЧек(ПараметрыЧека, ТекстСообщения, ПокупательEmail, ПокупательНомер)
	
	// формируем отправку письма или СМС
	BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	
	ТаблицаСообщений = Новый ТаблицаЗначений;
	ТаблицаСообщений.Колонки.Добавить("Получатели");
	ТаблицаСообщений.Колонки.Добавить("ТекстСообщения");
	ТаблицаСообщений.Колонки.Добавить("BIR");
						
	НоваяСтрока = ТаблицаСообщений.Добавить();
	НоваяСтрока.BIR = ?(ЗначениеЗаполнено(BIR),BIR,"99999999");
	НоваяСтрока.ТекстСообщения = ТекстСообщения;
			
	Получатели = Новый ТаблицаЗначений;
	Если ЗначениеЗаполнено(ПокупательНомер) Тогда
		
		Получатели.Колонки.Добавить("Телефон");
		СтрокаПолучатель = Получатели.Добавить();
		СтрокаПолучатель.Телефон =  ПокупательНомер;
		НоваяСтрока.Получатели = Получатели;
		
		DMS_ВзаимодействияСКлиентом.ВыполнитьРассылкуСМС(ТаблицаСообщений);
		
	Иначе
		
		Получатели.Колонки.Добавить("Адрес");	
		СтрокаПолучатели = Получатели.Добавить();
		СтрокаПолучатели.Адрес = ПокупательEmail;					
		НоваяСтрока.Получатели = Получатели;
		
		DMS_ВзаимодействияСКлиентом.ВыполнитьРассылкуПисем(ТаблицаСообщений);
				
	КонецЕсли;
		
КонецПроцедуры
