//Функция добавляет в реализацию строку и вызывает все необходимые обработчики
//данные берутся из выборки, если указываем партию, то заполняется реквизит "Партия"
//возвращает заполненную строку
Функция ДобавитьСтрокуРеализации(РеализацияОбъект,Выборка)
	
	СтрокаРеализации = РеализацияОбъект.Товары.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаРеализации,Выборка);
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("НеКонтролироватьЗамены",Истина);
	
	РеализацияОбъект.ОбработкаРеквизита("Товары.Номенклатура", СтрокаРеализации,, ДопПараметры);
	РеализацияОбъект.ОбработкаРеквизита("Товары.ХарактеристикаНоменклатуры", СтрокаРеализации,, ДопПараметры);
	РеализацияОбъект.ОбработкаРеквизита("Товары.ЕдиницаИзмерения", СтрокаРеализации,, ДопПараметры);
	РеализацияОбъект.ОбработкаРеквизита("Товары.Количество", СтрокаРеализации,, ДопПараметры);
	РеализацияОбъект.ОбработкаРеквизита("Товары.Коэффициент", СтрокаРеализации,, ДопПараметры);
	
	Возврат СтрокаРеализации;
	
КонецФункции

