//Процедура добавляет в перемещение в производство строку и вызывает все необходимые обработчики
//данные берутся из выборки, если указываем партию, рекзивит "Партия" заполняется по указанной ссылке
Процедура ДобавитьСтрокуПеремещение(ПеремещениеОбъект,Выборка,СсылкаНаПартию)
	
	СтрокаПеремещения = ПеремещениеОбъект.Товары.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаПеремещения,Выборка);
	
	СтрокаПеремещения.Партия = СсылкаНаПартию;
	
	ДопПараметры = Новый Структура;
	
	ПеремещениеОбъект.ОбработкаРеквизита("Товары.Номенклатура", СтрокаПеремещения,, ДопПараметры);
	ПеремещениеОбъект.ОбработкаРеквизита("Товары.ХарактеристикаНоменклатуры", СтрокаПеремещения,, ДопПараметры);
	ПеремещениеОбъект.ОбработкаРеквизита("Товары.ЕдиницаИзмерения", СтрокаПеремещения,, ДопПараметры);
	ПеремещениеОбъект.ОбработкаРеквизита("Товары.Количество", СтрокаПеремещения,, ДопПараметры);
	ПеремещениеОбъект.ОбработкаРеквизита("Товары.Коэффициент", СтрокаПеремещения,, ДопПараметры);	
	
КонецПроцедуры

Функция ПолучитьПараметры() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	НастройкаМежскладскихПеремещений.ДоговорПоставщикПокупатель,
	|	НастройкаМежскладскихПеремещений.ДоговорПокупательПоставщик,
	|	НастройкаМежскладскихПеремещений.ПутьКФайлуЛогаРаботы + &ИмяФайла КАК ПутьКФайлуЛогаРаботы,
	|	НастройкаМежскладскихПеремещений.ТипЦен,
	|	НастройкаМежскладскихПеремещений.СкладОтправитель КАК СкладОтправитель,
	|	НастройкаМежскладскихПеремещений.СкладПолучатель,
	|	НастройкаМежскладскихПеремещений.ДоговорПоставщикПокупатель.Владелец КАК КонтрагентПокупатель,
	|	НастройкаМежскладскихПеремещений.ДоговорПокупательПоставщик.Владелец КАК КонтрагентПоставщик,
	|	НастройкаМежскладскихПеремещений.ТипЦен.ВалютаЦены КАК Валюта,
	|	НастройкаМежскладскихПеремещений.СкладПолучатель.Подразделение КАК ПодразделениеПокупатель,
	|	НастройкаМежскладскихПеремещений.ОрганизацияПокупатель КАК ОрганизацияПокупатель,
	|	НастройкаМежскладскихПеремещений.СкладОтправитель.Подразделение КАК ПодразделениеПоставщик,
	|	НастройкаМежскладскихПеремещений.ОрганизацияПоставщик КАК ОрганизацияПоставщик
	|ИЗ
	|	РегистрСведений.НастройкаМежскладскихПеремещений КАК НастройкаМежскладскихПеремещений
	|ГДЕ
	|	НастройкаМежскладскихПеремещений.ОрганизацияПоставщик <> НастройкаМежскладскихПеремещений.ДоговорПокупательПоставщик";
	Запрос.УстановитьПараметр("ИмяФайла","\log_"+Формат(НачалоДня(ТекущаяДата()),"ДЛФ=D") + ".txt");
	Выборка = Запрос.Выполнить().Выбрать();
	
	//Если Выборка.Следующий() Тогда
	
	Возврат Выборка;
	
	//Иначе
	//	
	//	Возврат Неопределено;
	//	
	//КонецЕсли;
	
	
