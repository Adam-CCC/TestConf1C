//Процедура создает документ "Снятие резервов покупателя"
Процедура СоздатьДокументСнятияРезерва(ТаблицаЗаказов,Отказ,ЛогРаботы,Параметры)
	
	МассивЗаказов = ТаблицаЗаказов.ВыгрузитьКолонку("Заказ");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказыПокупателейОстатки.Контрагент КАК Контрагент,
	|	ЗаказыПокупателейОстатки.Заказ КАК ЗаказПокупателя,
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
	|	ЗаказыПокупателейОстатки.СкладКомпании КАК МестоРазмещения,
	|	СУММА(ЗаказыПокупателейОстатки.РезервОстаток) КАК Количество,
	|	ЗаказыПокупателейОстатки.Заказ.ДокументОснование КАК ДокументОснование,
	|	ЕСТЬNULL(ЕдиницыИзмерения.Ссылка, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	|	МАКСИМУМ(ЕСТЬNULL(ЕдиницыИзмерения.Коэффициент, 1)) КАК Коэффициент
	|ИЗ
	|	РегистрНакопления.ЗаказыПокупателей.Остатки(
	|			&Дата,
	|			Заказ.ДокументОснование В (&МассивЗаказов)
	|				И СкладКомпании = &Склад) КАК ЗаказыПокупателейОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	|		ПО ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	|ГДЕ
	|	ЗаказыПокупателейОстатки.РезервОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПокупателейОстатки.Контрагент,
	|	ЗаказыПокупателейОстатки.Номенклатура,
	|	ЗаказыПокупателейОстатки.Заказ,
	|	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
	|	ЗаказыПокупателейОстатки.СкладКомпании,
	|	ЗаказыПокупателейОстатки.Заказ.ДокументОснование,
	|	ЗаказыПокупателейОстатки.Заказ.Дата,
	|	ЕСТЬNULL(ЕдиницыИзмерения.Ссылка, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка))
	|ИТОГИ ПО
	|	ДокументОснование,
	|	Контрагент";
	
	Запрос.УстановитьПараметр("Дата",КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);
	Запрос.УстановитьПараметр("Склад",Параметры.СкладОтправитель);
	
	ВыборкаЗаказНарядов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаЗаказов.Индексы.Добавить("Заказ");
	
	Пока ВыборкаЗаказНарядов.Следующий() Цикл
		ВыборкаКонтрагентов = ВыборкаЗаказНарядов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКонтрагентов.Следующий() Цикл
			
			Выборка = ВыборкаКонтрагентов.Выбрать();
			
			СнятиеРезервов = Документы.СнятиеРезервовЗаказовПокупателя.СоздатьДокумент();
			
			СтрокаТаблицы = ТаблицаЗаказов.Найти(ВыборкаЗаказНарядов.ДокументОснование,"Заказ");
			
			СнятиеРезервов.Дата = СтрокаТаблицы.Дата - 4;
			СнятиеРезервов.ДокументОснование = ВыборкаЗаказНарядов.ДокументОснование;
			СнятиеРезервов.Организация = Параметры.ОрганизацияПоставщик;
			СнятиеРезервов.ПодразделениеКомпании= Параметры.ПодразделениеПоставщик;
			СнятиеРезервов.Автор = ПараметрыСеанса.Пользователь;
			СнятиеРезервов.КорректировкаЗаказа = Истина;
			ЗаполнитьЗначенияСвойств(СнятиеРезервов,ВыборкаЗаказНарядов.ДокументОснование,"КурсДокумента,ВалютаДокумента");
			
			Если ЗначениеЗаполнено(ВыборкаКонтрагентов.Контрагент) Тогда
				СнятиеРезервов.ХозОперация = Справочники.ХозОперации.СнятиеРезерваПокупателя;
				СнятиеРезервов.Контрагент = ВыборкаКонтрагентов.Контрагент;
			Иначе
				СнятиеРезервов.ХозОперация = Справочники.ХозОперации.СнятиеРезерваВнутреннего;
			КонецЕсли;
			СнятиеРезервов.Комментарий = "Создан автоматически при межскладском перемещении";
			
			Пока Выборка.Следующий() Цикл
				СтрокаДокумента = СнятиеРезервов.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДокумента,Выборка);
			КонецЦикла;
			
			ЗаписатьДокумент(СнятиеРезервов,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			ЗаписатьДокумент(СнятиеРезервов,ЛогРаботы,РежимЗаписиДокумента.Проведение,Отказ);
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

//Функция создает документ "Реализация товаров" с указанной датой 
//и заполняет реквизиты по переданным параметрам
//Возвращает ДокументОбъект
Функция СоздатьРеализацию(Параметры, ДатаЗаказНаряда)
	
	РеализацияОбъект = Документы.РеализацияТоваров.СоздатьДокумент();
	РеализацияОбъект.РегламентированныйУчет = Истина;
	РеализацияОбъект.Дата = ДатаЗаказНаряда;
	РеализацияОбъект.УстановитьНовыйНомер();
	РеализацияОбъект.ХозОперация = Справочники.ХозОперации.РеализацияТоваров;
	
	РеализацияОбъект.Организация = Параметры.ОрганизацияПоставщик;
	РеализацияОбъект.ОбработкаРеквизита("Организация");
	
	РеализацияОбъект.ПодразделениеКомпании = Параметры.ПодразделениеПоставщик;
	РеализацияОбъект.ОбработкаРеквизита("ПодразделениеКомпании");
	
	РеализацияОбъект.СкладКомпании = Параметры.СкладОтправитель;
	ДопПараметры = Новый Структура("НеРассчитыватьСкидки,ВозможностьИзмененияЦен",Истина,Ложь);
	РеализацияОбъект.ОбработкаРеквизита("СкладКомпании",,,ДопПараметры);
	
	РеализацияОбъект.ТипЦен = Параметры.ТипЦен;
	РеализацияОбъект.ОбработкаРеквизита("ТипЦен");
	
	РеализацияОбъект.ВалютаДокумента = Параметры.Валюта;
	РеализацияОбъект.ОбработкаРеквизита("ВалютаДокумента");
	
	РеализацияОбъект.Контрагент = Параметры.КонтрагентПокупатель;
	РеализацияОбъект.ОбработкаРеквизита("Контрагент");
	
	РеализацияОбъект.ДоговорВзаиморасчетов = Параметры.ДоговорПоставщикПокупатель;
	РеализацияОбъект.ОбработкаРеквизита("ДоговорВзаиморасчетов");	
	
	РеализацияОбъект.Автор = ПараметрыСеанса.Пользователь;
	РеализацияОбъект.Комментарий = "Создан автоматически для перепродажи зап. частей между организациями";
	
	Возврат РеализацияОбъект;
	
КонецФункции

