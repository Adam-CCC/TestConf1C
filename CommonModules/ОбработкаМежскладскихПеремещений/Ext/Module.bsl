				СтрокаРеализации = ДобавитьСтрокуРеализации(РеализацияОбъект,Выборка);
				//копируем строку из реализации
				ДобавитьСтрокуИзвлечение(ИзвлечениеОбъект,СтрокаРеализации);
				ДобавитьСтрокуПоступления(ПоступлениеОбъект,СтрокаРеализации);
				ДобавитьСтрокуПеремещение(ПеремещениеОбъект,Выборка,СсылкаНаПоступление);
				
			КонецЦикла;
			
			//на случай если у организация разная политика по НДС
			ПоступлениеОбъект.ОбработкаРеквизита("Организация");
			
			//РезервированиеОбъект = СоздатьРезервирование(Параметры,ЗаказНаряд,ДатаЗаказНаряда - 2);
			
			ЗаписатьДокумент(ИзвлечениеОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			ЗаписатьДокумент(РеализацияОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			ЗаписатьДокумент(ПоступлениеОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			ЗаписатьДокумент(ПеремещениеОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			Если Отказ Тогда
				Прервать;
			КонецЕсли;
			
			
			
			//добавляем записанные документы в таблицу для последующего проведения
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ИзвлечениеОбъект.Ссылка; 
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = РеализацияОбъект.Ссылка; 
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ПоступлениеОбъект.Ссылка;
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ПеремещениеОбъект.Ссылка;
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ЗаказНаряд;
			СтрокаДокументов.Дата = ДатаОкончания;
			
			//При необходимости создаем счета-фактуры
			Если РеализацияОбъект.Товары.Итог("СуммаНДС") > 0 Тогда
				СФИсходящий = Документы.СчетФактураВыданный.СоздатьДокумент();
				СФИсходящий.Заполнить(РеализацияОбъект.Ссылка);
				СФИсходящий.Дата = РеализацияОбъект.Дата;
				СФИсходящий.УстановитьНовыйНомер();
				ЗаписатьДокумент(СФИсходящий,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
				Если Отказ Тогда
					Прервать;
				Иначе
					СтрокаДокументов = ТаблицаДокументов.Добавить();
					СтрокаДокументов.Документ = СФИсходящий.Ссылка;
				КонецЕсли;
			КонецЕсли;
			
			Если ПоступлениеОбъект.Товары.Итог("СуммаНДС") > 0 Тогда
				СФВходящий = Документы.СчетФактураПолученный.СоздатьДокумент();
				СФВходящий.Заполнить(ПоступлениеОбъект.Ссылка);
				СФВходящий.Дата = ПоступлениеОбъект.Дата;
				СФВходящий.УстановитьНовыйНомер();
				ЗаписатьДокумент(СФВходящий,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
				Если Отказ Тогда
					Прервать;
				Иначе
					СтрокаДокументов = ТаблицаДокументов.Добавить();
					СтрокаДокументов.Документ = СФВходящий.Ссылка;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		
		//Если Не Отказ Тогда
		//	//Отменяем проведение у документов перемещения и изъятия из производства, подчиненных заказ-наряду
		//	ТаблицаДокументовПеремещения = МассивРезультатов[4].Выгрузить();
		//	
		//	Для Каждого СтрокаТаблицы Из ТаблицаДокументовПеремещения Цикл
		//		ЗаписатьДокумент(СтрокаТаблицы.Ссылка.ПолучитьОбъект(),ЛогРаботы,РежимЗаписиДокумента.ОтменаПроведения,Отказ);
		//	КонецЦикла; 
		//	
		//КонецЕсли;
		
		
		//здесь нужно проверить наличие резервов по снятым с проведения документам
		
		//Если Не Отказ Тогда	
		//	СоздатьДокументСнятияРезерва(ТаблицаЗаказов,Отказ,ЛогРаботы,Параметры);
		//КонецЕсли;
		//
		
		//Займемся перепроведением документов
		Если Не Отказ Тогда
			ПровестиДокументыИзТаблицы(ТаблицаДокументов,ЛогРаботы,Отказ);
		КонецЕсли;
		
		//фиксируем результат работы
		Если Отказ Тогда
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
		ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Завершение работы");
		СохранитьЛогРаботы(ЛогРаботы,Параметры.ПутьКФайлуЛогаРаботы);
		
	КонецЦикла;
	
КонецПроцедуры



Процедура ЗаписатьДокумент(ДокументОбъект,ЛогРаботы,РежимЗаписи,Отказ)	
	
	ДокСтрока = Строка(ДокументОбъект);
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписи);
		ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"" + РежимЗаписи + ": " + ДокСтрока);
	Исключение 
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"" + РежимЗаписи + ": " + ДокСтрока + ": " + ОписаниеОшибки(),Истина);			 
		
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПровестиДокументыИзТаблицы(ТаблицаДокументов,ЛогРаботы,Отказ)
	Для Каждого СтрокаДокументов ИЗ ТаблицаДокументов Цикл
		
		ДокументОбъект = СтрокаДокументов.Документ.ПолучитьОбъект();
		
		ДокСтрока = Строка(СтрокаДокументов.Документ);
		
		Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЗаказНаряд") Тогда
			//проведем заказ-наряд
			Попытка
				ДокументОбъект.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен;
				ДокументОбъект.ДатаОкончания  = СтрокаДокументов.Дата+7;
				ДокументОбъект.Записать();
				ДокументОбъект.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт;
				ДокументОбъект.Записать();
				ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Проведение: " + ДокСтрока);
			Исключение
				Если ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
				КонецЕсли;
				ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Проведение: " + ДокСтрока + ": " + ОписаниеОшибки(),Истина);				 
				Отказ = Истина;
			КонецПопытки;
		Иначе
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
				ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Проведение: " + ДокСтрока);
			Исключение
				//Сообщить(ОписаниеОшибки());

				Если ТранзакцияАктивна() Тогда
					ОтменитьТранзакцию();
				КонецЕсли;
				ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Проведение: " + ДокСтрока + ": " + ОписаниеОшибки(),Истина);
				Отказ = Истина;
				
			КонецПопытки;
		КонецЕсли;
		
		Если Отказ Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Процедуры для работы с логом работы обработки
Функция ИнициализироватьЛогРаботы(ПутьКФайлуЛогаРаботы)
	
	ФайлЛога = Новый Файл(ПутьКФайлуЛогаРаботы);
	
	ЛогРаботы = Новый ЗаписьТекста;
	
	
	Если ФайлЛога.Существует() Тогда
		ЛогРаботы.Открыть(ПутьКФайлуЛогаРаботы,,,Истина);
	Иначе
		ЛогРаботы.Открыть(ПутьКФайлуЛогаРаботы);
	КонецЕсли;
	
	Возврат ЛогРаботы;
	
КонецФункции

Процедура ДобавитьЗаписьВЛогРаботы(ЛогРаботы,Запись,Ошибка = Ложь)
	
	ЛогРаботы.ЗаписатьСтроку("" + ТекущаяДата() + ?(Ошибка," ОШИБКА!!!", "") + Символы.Таб + Запись);
	
КонецПроцедуры

Процедура СохранитьЛогРаботы(ЛогРаботы,ПутьКФайлуЛогаРаботы)
	
	ЛогРаботы.Закрыть();
	
КонецПроцедуры


//Обработчик события "При проведени изъятия товаров из производства"
Процедура ИзвлечениеТоваровИзПроизводстваПриПроведении(ДокументОбъект,Отказ, Режим) Экспорт 
	
	
	ДокументОбъект.Движения.ПартииТоваровКомпании.Записать();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПартииТоваровКомпании.Номенклатура,
	|	ПартииТоваровКомпании.ХарактеристикаНоменклатуры,
	|	ПартииТоваровКомпании.Партия,
	|	СУММА(ПартииТоваровКомпании.Количество) КАК Количество,
	|	ПартииТоваровКомпании.СкладКомпании.Организация КАК Организация
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|ГДЕ
	|	ПартииТоваровКомпании.Период = &Период
	|	И ПартииТоваровКомпании.Регистратор = &Регистратор
	|	И ПартииТоваровКомпании.Партия.Организация <> ПартииТоваровКомпании.СкладКомпании.Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваровКомпании.ХарактеристикаНоменклатуры,
	|	ПартииТоваровКомпании.Номенклатура,
	|	ПартииТоваровКомпании.Партия,
	|	ПартииТоваровКомпании.СкладКомпании.Организация";
	
	Запрос.УстановитьПараметр("Период",ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("Регистратор",ДокументОбъект.Ссылка);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Отказ = Истина;
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Сообщить("Партия " + Выборка.Партия + " номенклатуры " + Выборка.Номенклатура 
			+ " принадлежит организации, отличной от " + Выборка.Организация + "!"
			+ Символы.ПС + "Извлечение невозможно!");
			
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры
