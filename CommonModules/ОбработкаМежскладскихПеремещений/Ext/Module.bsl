	               |	Товары.Номенклатура,
	               |	Товары.ХарактеристикаНоменклатуры,
	               |	СУММА(Товары.Количество) КАК Количество,
	               |	ЕСТЬNULL(СправочникНоменклатуры.ОсновнаяЕдиницаИзмерения.Коэффициент, 1) КАК Коэффициент,
	               |	ЕСТЬNULL(СправочникНоменклатуры.ОсновнаяЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмерения,
	               |	Товары.Регистратор КАК ЗаказНаряд,
	               |	ЕСТЬNULL(ЗаказНаряды.ДатаЗаказНаряда, Товары.Регистратор.Дата) КАК ДатаЗаказНаряда,
	               |	ЕСТЬNULL(ЗаказНаряды.Цех, ЗНАЧЕНИЕ(Справочник.Цеха.ПустаяСсылка)) КАК ЦехЗаказНаряда
	               |ИЗ
	               |	Товары КАК Товары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатуры
	               |		ПО Товары.Номенклатура = СправочникНоменклатуры.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказНаряды КАК ЗаказНаряды
	               |		ПО Товары.Регистратор = ЗаказНаряды.Ссылка
	               |ГДЕ
	               |	Товары.Регистратор В
	               |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |				ЗаказНаряды.Ссылка
	               |			ИЗ
	               |				ЗаказНаряды)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Товары.Номенклатура,
	               |	Товары.ХарактеристикаНоменклатуры,
	               |	ЕСТЬNULL(СправочникНоменклатуры.ОсновнаяЕдиницаИзмерения.Коэффициент, 1),
	               |	ЕСТЬNULL(СправочникНоменклатуры.ОсновнаяЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)),
	               |	Товары.Регистратор,
	               |	ЕСТЬNULL(ЗаказНаряды.ДатаЗаказНаряда, Товары.Регистратор.Дата),
	               |	ЕСТЬNULL(ЗаказНаряды.Цех, ЗНАЧЕНИЕ(Справочник.Цеха.ПустаяСсылка))
	               |ИТОГИ
	               |	МАКСИМУМ(ДатаЗаказНаряда),
	               |	МАКСИМУМ(ЦехЗаказНаряда)
	               |ПО
	               |	ЗаказНаряд";
	Запрос.УстановитьПараметр("ДатаОбработки",?(Дата = Неопределено,ТекущаяДата(),КонецДня(Дата)));
	Запрос.УстановитьПараметр("ОрганизацияПоставщик",Параметры.ОрганизацияПоставщик);
	Запрос.УстановитьПараметр("ОрганизацияПокупатель",Параметры.ОрганизацияПокупатель);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура СформироватьДокументыПерепродажи() Экспорт	
	
	//Получение настроек + проверка заполнения обязательных настроек
	
	ВыборкаПараметров = ПолучитьПараметры();
	
	Если ВыборкаПараметров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Пока ВыборкаПараметров.Следующий() Цикл
		
		Параметры = ВыборкаПараметров;
		//
		//Если НЕ Параметры.Следующий() Тогда
		//	Продолжить;
		//КонецЕсли;
		
		ЛогРаботы = ИнициализироватьЛогРаботы(Параметры.ПутьКФайлуЛогаРаботы);
		ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Начало работы");
		
		//Получаем результат запроса по товарам
		
		Результат = ПолучитьРезультатЗапросаПоЗаказНарядам(Параметры);
		
		Если Результат.Пустой() Тогда
			ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Завершение работы");
			СохранитьЛогРаботы(ЛогРаботы,Параметры.ПутьКФайлуЛогаРаботы);
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию();
		
		//Создадим таблицу для хранения документов для группового проведения
		ТаблицаДокументов = Новый ТаблицаЗначений;
		ТаблицаДокументов.Колонки.Добавить("Документ");	
		ТаблицаДокументов.Колонки.Добавить("Дата");
		
		//Начинаем формировать документы перепродажи между организациями
		
		ВыборкаЗаказНарядов = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Отказ = Ложь;
		
		ТаблицаЗаказов = Новый ТаблицаЗначений;
		ТаблицаЗаказов.Колонки.Добавить("Заказ");
		ТаблицаЗаказов.Колонки.Добавить("Дата");
		
		Пока ВыборкаЗаказНарядов.Следующий() Цикл
			
			#Если Клиент Тогда
				//Прерывание пользователя
				ОбработкаПрерыванияПользователя();
			#КонецЕсли
			ЗаказНаряд = ВыборкаЗаказНарядов.ЗаказНаряд;
			
			ДатаОкончания = ЗаказНаряд.ДатаОкончания;
			ДатаЗаказНарядаОкончание =ВыборкаЗаказНарядов.ЗаказНаряд.ДатаОкончания;

			СтрокаЗаказов = ТаблицаЗаказов.Добавить();
			СтрокаЗаказов.Заказ = ЗаказНаряд;
			СтрокаЗаказов.Дата = ВыборкаЗаказНарядов.ДатаЗаказНаряда;
			
			
			//Отменим проведение у заказ-наряда
			ЗаписатьДокумент(ЗаказНаряд.ПолучитьОбъект(),ЛогРаботы,РежимЗаписиДокумента.ОтменаПроведения,Отказ);
			
			Если Отказ Тогда
				Прервать;
			КонецЕсли;
			
			//Необходимо проверить - были ли уже сформированы документы перепродажи по заказ-наряду
			//пока эту обработку не делаем
			
			ДатаЗаказНаряда = ВыборкаЗаказНарядов.ДатаЗаказНаряда;
			ЦехЗаказНаряда = ВыборкаЗаказНарядов.ЦехЗаказНаряда;
			
			//Создаем три документа:  реализацию, поступление и перемещение в производство
			ИзвлечениеОбъект = СоздатьИзвлечениеИзПроизводства(Параметры, ЦехЗаказНаряда, ДатаЗаказНарядаОкончание - 4);
			РеализацияОбъект = СоздатьРеализацию(Параметры, ДатаЗаказНарядаОкончание - 3);
			ПоступлениеОбъект = СоздатьПоступление(Параметры, ДатаЗаказНарядаОкончание - 2);
			ПеремещениеОбъект = СоздатьПеремещениеВПроизводство(Параметры, ЦехЗаказНаряда, ДатаЗаказНарядаОкончание - 1);
			
			//указываем в качестве основания заказ-наряд
			ИзвлечениеОбъект.ДокументОснование = ЗаказНаряд;
			РеализацияОбъект.ЗаказНаряд = ЗаказНаряд;
			ПоступлениеОбъект.ЗаказНаряд = ЗаказНаряд;
			ПеремещениеОбъект.ДокументОснование = ЗаказНаряд;
			
			ЗаписатьДокумент(ПоступлениеОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			Если Отказ Тогда
				Прервать;
			КонецЕсли;
			
			СсылкаНаПоступление = ПоступлениеОбъект.Ссылка;
			
			Выборка = ВыборкаЗаказНарядов.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				#Если Клиент Тогда
					//Прерывание пользователя
					ОбработкаПрерыванияПользователя();
				#КонецЕсли
				
				
				//заполняем строки документов
				СтрокаРеализации = ДобавитьСтрокуРеализации(РеализацияОбъект,Выборка);
				//копируем строку из реализации
				ДобавитьСтрокуИзвлечение(ИзвлечениеОбъект,СтрокаРеализации);
				ДобавитьСтрокуПоступления(ПоступлениеОбъект,СтрокаРеализации);
				ДобавитьСтрокуПеремещение(ПеремещениеОбъект,Выборка,СсылкаНаПоступление);
				
			КонецЦикла;
			
			//на случай если у организация разная политика по НДС
			ПоступлениеОбъект.ОбработкаРеквизита("Организация");
			
			//РезервированиеОбъект = СоздатьРезервирование(Параметры,ЗаказНаряд,ДатаЗаказНаряда - 2);
			
			ЗаписатьДокумент(ИзвлечениеОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			ЗаписатьДокумент(РеализацияОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			ЗаписатьДокумент(ПоступлениеОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			ЗаписатьДокумент(ПеремещениеОбъект,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
			
			Если Отказ Тогда
				Прервать;
			КонецЕсли;
			
			
			
			//добавляем записанные документы в таблицу для последующего проведения
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ИзвлечениеОбъект.Ссылка; 
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = РеализацияОбъект.Ссылка; 
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ПоступлениеОбъект.Ссылка;
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ПеремещениеОбъект.Ссылка;
			
			СтрокаДокументов = ТаблицаДокументов.Добавить();
			СтрокаДокументов.Документ = ЗаказНаряд;
			СтрокаДокументов.Дата = ДатаОкончания;
			
			//При необходимости создаем счета-фактуры
			Если РеализацияОбъект.Товары.Итог("СуммаНДС") > 0 Тогда
				СФИсходящий = Документы.СчетФактураВыданный.СоздатьДокумент();
				СФИсходящий.Заполнить(РеализацияОбъект.Ссылка);
				СФИсходящий.Дата = РеализацияОбъект.Дата;
				СФИсходящий.УстановитьНовыйНомер();
				ЗаписатьДокумент(СФИсходящий,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
				Если Отказ Тогда
					Прервать;
				Иначе
					СтрокаДокументов = ТаблицаДокументов.Добавить();
					СтрокаДокументов.Документ = СФИсходящий.Ссылка;
				КонецЕсли;
			КонецЕсли;
			
			Если ПоступлениеОбъект.Товары.Итог("СуммаНДС") > 0 Тогда
				СФВходящий = Документы.СчетФактураПолученный.СоздатьДокумент();
				СФВходящий.Заполнить(ПоступлениеОбъект.Ссылка);
				СФВходящий.Дата = ПоступлениеОбъект.Дата;
				СФВходящий.УстановитьНовыйНомер();
				ЗаписатьДокумент(СФВходящий,ЛогРаботы,РежимЗаписиДокумента.Запись,Отказ);
				Если Отказ Тогда
					Прервать;
				Иначе
					СтрокаДокументов = ТаблицаДокументов.Добавить();
					СтрокаДокументов.Документ = СФВходящий.Ссылка;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		
		//Если Не Отказ Тогда
		//	//Отменяем проведение у документов перемещения и изъятия из производства, подчиненных заказ-наряду
		//	ТаблицаДокументовПеремещения = МассивРезультатов[4].Выгрузить();
		//	
		//	Для Каждого СтрокаТаблицы Из ТаблицаДокументовПеремещения Цикл
		//		ЗаписатьДокумент(СтрокаТаблицы.Ссылка.ПолучитьОбъект(),ЛогРаботы,РежимЗаписиДокумента.ОтменаПроведения,Отказ);
		//	КонецЦикла; 
		//	
		//КонецЕсли;
		
		
		//здесь нужно проверить наличие резервов по снятым с проведения документам
		
		//Если Не Отказ Тогда	
		//	СоздатьДокументСнятияРезерва(ТаблицаЗаказов,Отказ,ЛогРаботы,Параметры);
		//КонецЕсли;
		//
		
		//Займемся перепроведением документов
		Если Не Отказ Тогда
			ПровестиДокументыИзТаблицы(ТаблицаДокументов,ЛогРаботы,Отказ);
		КонецЕсли;
		
		//фиксируем результат работы
		Если Отказ Тогда
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
		ДобавитьЗаписьВЛогРаботы(ЛогРаботы,"Завершение работы");
		СохранитьЛогРаботы(ЛогРаботы,Параметры.ПутьКФайлуЛогаРаботы);
		
	КонецЦикла;
	
КонецПроцедуры

