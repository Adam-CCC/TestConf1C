Функция ПолучитьСуммуЗакупкиБУучетДатыГлобальный(Автомобиль,Дата) Экспорт
	
	Если ЗначениеЗаполнено(Автомобиль) Тогда
 		
		ЗапросАвтомобиль = Новый Запрос();
		
		СЗ_Форм = Новый СписокЗначений; 
 		
		СЗ_Форм.Добавить(Перечисления.ФормыСобственности.ЧастноеЛицо);
		СЗ_Форм.Добавить(Перечисления.ФормыСобственности.Прочее);
		
		Если Дата >= Дата(2024,4,1) Тогда
 			СЗ_Форм.Добавить(Перечисления.ФормыСобственности.ЮридическоеЛицо);
			СЗ_Форм.Добавить(Перечисления.ФормыСобственности.ЧастныйПредприниматель);
		КонецЕсли;
		
		ЗапросАвтомобиль.УстановитьПараметр("СЗ_Форм", СЗ_Форм);
		ЗапросАвтомобиль.УстановитьПараметр("Автомобиль", Автомобиль);
		ЗапросАвтомобиль.УстановитьПараметр("Дата", Дата);
 		
		ЗапросАвтомобиль.Текст = "ВЫБРАТЬ
		                         |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК ДатаПоступления,
		                         |	ПоступлениеАвтомобилейАвтомобили.СуммаВсего КАК СуммаВсего
		                         |ИЗ
		                         |	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
		                         |ГДЕ
		                         |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
		                         |	И ПоступлениеАвтомобилейАвтомобили.АвтомобильБУ
		                         |	И ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
		                         |	И ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.ФормаСобственности В(&СЗ_Форм)
		                         |	И ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата < &Дата
		                         |
		                         |УПОРЯДОЧИТЬ ПО
		                         |	ДатаПоступления УБЫВ";
		
		Результат = ЗапросАвтомобиль.Выполнить().Выгрузить();
		Если Результат.Количество() > 0 Тогда
			СуммаЗакупкиБУ =  Результат[0].СуммаВсего;
		Иначе
			СуммаЗакупкиБУ = 0;
		КонецЕсли;
	Иначе
		СуммаЗакупкиБУ = 0;
	КонецЕсли;
	
	Возврат СуммаЗакупкиБУ;
	
КонецФункции // ПолучитьСуммуЗакупкиБУучетДатыГлобальный(Автомобиль,Дата)
