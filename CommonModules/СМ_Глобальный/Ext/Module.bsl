Функция СокращенныйСписокПечатныхФормЗаказНаряда() Экспорт
	
	Рез = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПользователиСокращенногоСпискаПечатныхФормЗаказНаряда.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.ПользователиСокращенногоСпискаПечатныхФормЗаказНаряда КАК ПользователиСокращенногоСпискаПечатныхФормЗаказНаряда
		|ГДЕ
		|	ПользователиСокращенногоСпискаПечатныхФормЗаказНаряда.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Рез = Истина;
	КонецЦикла;
	
 	Возврат Рез;
	
КонецФункции // СокращенныйСписокПечатныхФормЗаказНаряда()
