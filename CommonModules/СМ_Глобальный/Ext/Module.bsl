Функция НайтиОсновнойЦехПодразделения(ПодразделениеКомпании) Экспорт
	
	Цех_ = "";
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Цеха.Ссылка КАК Ссылка,
		|	Цеха.Подразделение КАК Подразделение,
		|	Цеха.ОсновнойЦехПодразделения КАК ОсновнойЦехПодразделения,
		|	Цеха.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Цеха КАК Цеха
		|ГДЕ
		|	НЕ Цеха.ПометкаУдаления
		|	И Цеха.Подразделение = &Подразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОсновнойЦехПодразделения УБЫВ";
	
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Цех_ = ВыборкаДетальныеЗаписи.Ссылка;
		Прервать;
	КонецЦикла;
  	
	Возврат Цех_;
	
КонецФункции // НайтиОсновнойЦехПодразделения(ПодразделениеКомпании)
