Процедура СоздатьОткрытьЦельЗадачи(Задача) Экспорт
	
	ВидСобытия = DMS_ЗадачиСервер.ПолучитьВидСобытия(Задача.ВидСобытия);
	
	Если ВидСобытия = "ОФУ" Тогда//Задача.ВидСобытия=Справочники.CRM_ВидыСобытий.Кредит ИЛИ Задача.ВидСобытия=Справочники.CRM_ВидыСобытий.Страховка ИЛИ Задача.ВидСобытия=Справочники.CRM_ВидыСобытий.КонсультацияОФУ Тогда
		
		Запрос=Новый Запрос("Выбрать Ссылка Из Документ.Renault_РабочийЛистОФУ ГДЕ Не ПометкаУдаления И Задача=&Задача");
		Запрос.УстановитьПараметр("Задача",Задача);
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Количество()=0 Тогда //создаем новый документ КСО		
			ВидДокумента="Renault_РабочийЛистОФУ";
			Форма= ПолучитьФорму("Документ.Renault_РабочийЛистОФУ.Форма.ФормаДокумента");
			Заявка=ЗаполнитьЗаявку(Задача,Форма.Объект);
			КопироватьДанныеФормы(Заявка,Форма.Объект);
			Форма.Открыть();
		Иначе//Если Выборка.Количество()=1 Тогда // открыть документ КСО
			Выборка.Следующий();
			Форма = ПолучитьФорму("Документ.Renault_РабочийЛистОФУ.Форма.ФормаДокумента",Новый Структура("Ключ",Выборка.Ссылка));
			Форма.Открыть();
		КонецЕсли;
		
	ИначеЕсли ВидСобытия = "Пролонгация" Тогда
		ПолучитьИнтерфейсДляРаботыПоСхеме(Задача);
		Возврат;
	Иначе 
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

Процедура ПолучитьИнтерфейсДляРаботыПоСхеме(Задача)
	
	Если Не ЗначениеЗаполнено(Задача.Объект) ИЛИ
		ТипЗнч(Задача.Объект)<> Тип("СправочникСсылка.Renault_CommunicationCenter_СхемыОбзвона") Тогда
		Возврат;
	КонецЕсли;
	
	ДниОбзвона = Задача.Объект.ДниНеделиОбзвона;
			
	Если ДниОбзвона.Количество()=0 Тогда
		
		Сообщить("В схеме не указаны дни недели, по которым будет производится коммуникация");
	
	ИначеЕсли ДниОбзвона.Найти(ДеньНедели(ТекущаяДата()), "ДеньНедели") = Неопределено Тогда
		
		СообщениеТекст = "Коммуникация по данной схеме производится только по ";
		
		Для Каждого Стр Из ДниОбзвона Цикл
			
			Если Стр.ДеньНедели = 1 Тогда							
				ТестДня = "понедельникам; ";							
			ИначеЕсли Стр.ДеньНедели = 2 Тогда
				ТестДня = "вторникам; ";
			ИначеЕсли Стр.ДеньНедели = 3 Тогда
				ТестДня = "средам; ";
			ИначеЕсли Стр.ДеньНедели = 4 Тогда
				ТестДня = "четвергам; ";
			ИначеЕсли Стр.ДеньНедели = 5 Тогда
				ТестДня = "пятницам; ";
			ИначеЕсли Стр.ДеньНедели = 6 Тогда
				ТестДня = "субботам; ";
			ИначеЕсли Стр.ДеньНедели = 7 Тогда
				ТестДня = "воскресеньям; ";
			Иначе
            КонецЕсли;

			СообщениеТекст = СообщениеТекст + ТестДня;
			
		КонецЦикла;					
		
		Сообщить(СообщениеТекст);
		
   Иначе
	   	   
	    Если Задача.Объект.ТипКоммуникации = Перечисления.ВидыСобытий.ЭлектронноеПисьмо Тогда		
			ФормаАРМОбзвона = ПолучитьФорму("Обработка.Renault_CommunicationCenter_АРМ_ОбзвонКлиентов.Форма.ФормаОтправкиЭлПисем");		
		ИначеЕсли Задача.Объект.ТипКоммуникации = Перечисления.ВидыСобытий.SMS Тогда
			ФормаАРМОбзвона = ПолучитьФорму("Обработка.Renault_CommunicationCenter_АРМ_ОбзвонКлиентов.Форма.ФормаОтправкиСМС");										
		Иначе		
		    ФормаАРМОбзвона = ПолучитьФорму("Обработка.Renault_CommunicationCenter_АРМ_ОбзвонКлиентов.Форма.Форма");								
			ФормаАРМОбзвона.ТекущийКонтрагент = Задача.Контрагент;
		КонецЕсли;
		
		ФормаАРМОбзвона.СхемаОбзвона = Задача.Объект;
		ФормаАРМОбзвона.ЗадачаОснование = Задача.Ссылка;
		ФормаАРМОбзвона.Открыть();					

	КонецЕсли;
	
КонецПроцедуры

Функция ЗаполнитьЗаявку(Задача,Док)
	Перем СтрТЗ;
	
	Док.Дата=ТекущаяДата();
	Док.Автор=ПараметрыСеанса.Пользователь;
	Док.Задача=Задача;
	Док.РабочийЛист=Задача.IDK;
	Док.ДилерскийЦентр=Задача.ДилерскийЦентр;
	Док.Клиент=Задача.Контрагент;
	
	Док.КоммерческоеПредложение=Задача.Объект;
	Если Задача.ВидСобытия=Справочники.CRM_ВидыСобытий.Страховка Тогда
		Док.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаСтраховку.Черновик;
	ИначеЕсли Задача.ВидСобытия=Справочники.CRM_ВидыСобытий.Кредит Тогда
		Док.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Черновик;	
	КонецЕсли;
	
	Если ТипЗнч(Задача.Объект) = Тип("ДокументСсылка.CRM_КоммерческоеПредложение") Тогда
		Док.РабочийЛист=Задача.Объект.РабочийЛист;
		Док.ДилерскийЦентр=Задача.Объект.ДилерскийЦентр;
		Док.Клиент=Задача.Объект.Клиент;

		Если Задача.Объект.Состав.Количество()=1 Тогда
			СтрТЗ=Задача.Объект.Состав[0]
		ИначеЕсли Задача.Объект.Состав.Количество()>1 Тогда
			ТЗ=Задача.Объект.Состав.Выгрузить();
			СтрТЗ=ТЗ.ВыбратьСтроку("Выберите конфигурацию");
		КонецЕсли;
		Если СтрТЗ<>Неопределено Тогда
			Док.СтоимостьАвтомобиля=СтрТЗ.Сумма;
			Док.Версия=СтрТЗ.Конфигурация.Версия;
			Док.Автомобиль=?(СтрТЗ.Конфигурация.Автомобиль.Пустая(),СтрТЗ.Конфигурация.Модель,СтрТЗ.Конфигурация.Автомобиль);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Док
КонецФункции
