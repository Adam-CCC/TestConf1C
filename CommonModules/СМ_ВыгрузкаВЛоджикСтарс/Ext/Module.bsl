///////////////// для Битрикс ///////////////////
Функция ПолучитьДанныеЗаказНаряда(ЗаказНаряд)
	стТелоЗапроса = Новый Структура();

	стТелоЗапроса.Вставить("department", СокрЛП(ЗаказНаряд.ПодразделениеКомпании));
	стТелоЗапроса.Вставить("repair_code", СокрЛП(ЗаказНаряд.Номер));
	стТелоЗапроса.Вставить("works_sum", Окр(ЗаказНаряд.СуммаРаботДокумента, 2));
	стТелоЗапроса.Вставить("spare_sum", Окр(ЗаказНаряд.СуммаНоменклатурыДокумента, 2));
	стТелоЗапроса.Вставить("repair_sum", Окр(ЗаказНаряд.СуммаДокумента, 2));
	стТелоЗапроса.Вставить("claim_code", СокрЛП(ЗаказНаряд.Рекламация));
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные продажи для " + Строка(ЗаказНаряд) + "!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ПолучитьДанныеЗаказаПоставщику(ЗаказПоставщику)
	стТелоЗапроса = Новый Структура();

	стТелоЗапроса.Вставить("order_code", СокрЛП(ЗаказПоставщику.Номер));
	стТелоЗапроса.Вставить("employee_code", СокрЛП(ЗаказПоставщику.Согласовал.Сотрудник.Код));
	
	мТовары = Новый Массив();
	Для Каждого СтрокаТовар Из ЗаказПоставщику.Товары Цикл	
		//Если Не ПравильныйАртикул(ВыборкаТовары.Артикул) Тогда
		//	Продолжить;
		//КонецЕсли;

		стТовар = Новый Структура();
		стТовар.Вставить("postion_name", СокрЛП(СтрокаТовар.Номенклатура.Наименование));
		стТовар.Вставить("postion_code", СокрЛП(СтрокаТовар.Номенклатура.Артикул));		
		стТовар.Вставить("sum", Окр(СтрокаТовар.СуммаВсего, 2));
		мТовары.Добавить(стТовар);
	КонецЦикла;
	
	Если мТовары.Количество() > 0 Тогда
		стТелоЗапроса.Вставить("spare_list", мТовары);
	Иначе
		Возврат "";
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные продажи для " + Строка(ЗаказПоставщику) + "!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции