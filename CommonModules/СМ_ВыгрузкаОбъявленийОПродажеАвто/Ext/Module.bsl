		|			ЦеныАвтомобилейСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)) КАК ЦенаАвто
		|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ЦенаАвто.Автомобиль
		|			И ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации = ЦенаАвто.Автомобиль.ВариантКомплектации
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
		|			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
		|			АвтомобилиСрезПоследних.Значение КАК Значение
		|		ИЗ
		|			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|		ГДЕ
		|			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля)) КАК ХарАвто
		|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ХарАвто.Автомобиль
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
		|			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
		|			АвтомобилиСрезПоследних.Значение КАК Значение
		|		ИЗ
		|			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|		ГДЕ
		|			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Пробег)) КАК ПробегиАвто
		|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ПробегиАвто.Автомобиль
		|ГДЕ
		|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
		|	И ХарАвто.Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.Новый)
		|	И ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение В(&СписокПодразделений)
		|	И ОстаткиАвтомобилейОстатки.Автомобиль.Модель.КатегорияТС <> ЗНАЧЕНИЕ(Справочник.КатегорииТранспортныхСредств.АвтомобилиЛегковые)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиАвтомобилейОстатки.Автомобиль,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.VIN,
		|	ЦенаАвто.Цена,
		|	ХарАвто.Значение,
		|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение.ДилерскийЦентр,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации.МодификацияАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СпециальнаяЦена,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриПокупкеВКредит,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриСтраховании,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидаПриПокупкеВТрейдИн,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаМаксимальная,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации.КомплектацияАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Цвет.ЦветАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Цвет.ОкраскаМеталлик,
		|	ПробегиАвто.Значение,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Состояние,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.КоличествоВладельцевПоПТС,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации.ТипКузова.ТипКузоваАвтоРу,
		|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.ТипКузова.ТипКузоваАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.МодельАвтоРуКоммерция,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.МодельАвтоРуКоммерция.МаркаАвтоРуКоммерция,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.КатегорияТС,
		|	ГОД(ОстаткиАвтомобилейОстатки.Партия.Дата),
		|	ОстаткиАвтомобилейОстатки.Партия.Номер
		|
		|УПОРЯДОЧИТЬ ПО
		|	VIN";
	
	Запрос.УстановитьПараметр("СписокПодразделений",СписокПодразделений);
     	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ИмяБазы = "alfaauto";
	Попытка
		Результат = Renault_внОбщийМодуль.ПараметрУникальностиИБ();
