		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Родитель.Код В (&СЗ_КодовРодителей)";
	
	Запрос.УстановитьПараметр("СЗ_КодовРодителей", СЗ_КодовРодителей);
	
