		|	ПодразделенияКомпанииМаркиАвтомобилей.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Подр);
	
	СЗ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Марка"));
	
	Если СЗ.Количество() = 0 Тогда
		Если НЕ обЗначениеНеЗаполнено(Подр.Родитель) Тогда
			СЗ = ПолучитьСписокМарокАвто(Подр.Родитель);
			Если СЗ.Количество() > 0 Тогда
				Возврат СЗ;	 	
 			КонецЕсли;
		Иначе
			Возврат СЗ;	 	
		КонецЕсли; 
	Иначе	
		Возврат СЗ;	 
 	КонецЕсли; 
  
КонецФункции // ПолучитьСписокМарок()

