Функция Renault_ПолучитьПробег(Автомобиль) Экспорт
	
	Если ТипЗнч(Автомобиль) = Тип("СправочникСсылка.Renault_ЧерновикиАвтомобилей") Тогда
		Возврат Автомобиль.Пробег;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АвтомобилиСрезПоследних.Значение КАК Пробег
	               |ИЗ
	               |	РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	               |ГДЕ
	               |	АвтомобилиСрезПоследних.Автомобиль = &Автомобиль
	               |	И АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения";
				   
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Пробег;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
	
КонецФункции

Функция Renault_ПолучитьПостыПоОбращению(ВидОбращения, ДилерскийЦентр) Экспорт
	
	МассивЦеховДЦ = ДилерскийЦентр.АвтосервисЦеха.ВыгрузитьКолонку("Цех"); 
	
	Если НЕ ЗначениеЗаполнено(ВидОбращения.НастройкаПостов) Тогда
		
		Возврат МассивЦеховДЦ;
		
	КонецЕсли;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Исключать", ЛОЖЬ);
	
	МассивПостовВкл = ВидОбращения.НастройкаПостов.НайтиСтроки(Отбор);
	
	Если ЗначениеЗаполнено(МассивПостовВкл) Тогда
		
		МассивЦехов = Новый Массив;
		
		Для Каждого Строка Из МассивПостовВкл Цикл
			
			МассивЦехов.Добавить(Строка.Цех);
			
		КонецЦикла;
		
		Возврат МассивЦехов;
		
	КонецЕсли;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Исключать", Истина);
	
	МассивПостовВыкл = ВидОбращения.НастройкаПостов.НайтиСтроки(Отбор);
	
	Если ЗначениеЗаполнено(МассивПостовВыкл) Тогда
		
		МассивПостовПромВыкл = Новый Массив;
		
		Для Каждого Строка из МассивПостовВыкл Цикл
			
			МассивПостовПромВыкл.Добавить(Строка.Цех);
			
		КонецЦикла;
		
		МассивПостовВыкл = МассивПостовПромВыкл;
		
		МассивЦехов = Новый Массив;
		
		Для Каждого Строка Из МассивЦеховДЦ Цикл
			
			Если МассивПостовВыкл.Найти(Строка.Ссылка) = Неопределено Тогда 
			
				МассивЦехов.Добавить(Строка.Ссылка);
				
			Иначе
				
				Продолжить;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат МассивЦехов;
		
	КонецЕсли;

КонецФункции

