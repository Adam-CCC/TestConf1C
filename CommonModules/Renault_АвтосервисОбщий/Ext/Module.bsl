	//		Если ТипЗнч(Источник) = Тип("СправочникОбъект.ПодразделенияКомпании") Тогда
	//			НовСтр = ОбДЦ.ПодразделенияОрганизации.Добавить();
	//			НовСтр.Подразделение = ИсточникСсылка;
	//			ОбДЦ.Записать();
	//		ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.Цеха") Тогда
