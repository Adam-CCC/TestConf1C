Функция ПолучитьМастеровПриемщиковДЦ(ДилерскийЦентр) Экспорт 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Пользователи.Ссылка КАК Пользователь,
	               |	Пользователи.Сотрудник КАК Сотрудник
	               |ИЗ
	               |	Справочник.Пользователи КАК Пользователи
	               |ГДЕ
	               |	Пользователи.Сотрудник.Должность В(&Должность)
	               |	И Пользователи.Сотрудник.Подразделение В(&Подразделение)
	               |	И Пользователи.Сотрудник.ПометкаУдаления = ЛОЖЬ
	               |	И Пользователи.Сотрудник.ФлагУволен = ЛОЖЬ";
	
	Должности = ДилерскийЦентр.ДолжностиМеханиковАвтосервиса.ВыгрузитьКолонку("Должность");
	Подразделения = ДилерскийЦентр.ПодразделенияОрганизации.ВыгрузитьКолонку("Подразделение");
	
	Запрос.УстановитьПараметр("Должность", Должности);
	Запрос.УстановитьПараметр("Подразделение", Подразделения);
	
	Список = Запрос.Выполнить().Выгрузить();
	
	Возврат Список;
	
КонецФункции

Функция ПолучитьИсполнителейДЦ(ДилерскийЦентр) Экспорт 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Сотрудники.Ссылка КАК Сотрудник
	               |ИЗ
	               |	Справочник.Сотрудники КАК Сотрудники
	               |ГДЕ
	               |	Сотрудники.Должность В(&Должности)
	               |	И Сотрудники.Подразделение В(&Подразделения)
	               |	И Сотрудники.ФлагУволен = ЛОЖЬ
	               |	И Сотрудники.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Сотрудники.Наименование";
	
	Должности = ДилерскийЦентр.ДолжностиИсполнителейНаПостах.ВыгрузитьКолонку("Должность");
	Подразделения = ДилерскийЦентр.ПодразделенияОрганизации.ВыгрузитьКолонку("Подразделение");
	
	Запрос.УстановитьПараметр("Должности", Должности);
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	
	Список = Запрос.Выполнить().Выгрузить();
	
	Возврат Список;
	
КонецФункции

