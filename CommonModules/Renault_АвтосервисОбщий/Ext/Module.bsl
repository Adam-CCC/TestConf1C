	|	Renault_CRM_ЗаявкаНаМойку.ПометкаУдаления,
	|	Renault_CRM_ЗаявкаНаМойку.Номер,
	|	Renault_CRM_ЗаявкаНаМойку.Дата,
	|	Renault_CRM_ЗаявкаНаМойку.Проведен,
