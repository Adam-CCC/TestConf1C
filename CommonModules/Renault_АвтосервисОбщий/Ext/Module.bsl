	|	Renault_CRM_ЗаявкаНаМойку.ВремяОкончания,
	|	Renault_CRM_ЗаявкаНаМойку.Машиноместо,
	|	Renault_CRM_ЗаявкаНаМойку.ГосНомер,
	|	Renault_CRM_ЗаявкаНаМойку.Автомобиль,
	|	Renault_CRM_ЗаявкаНаМойку.Упущена,
	|	Renault_CRM_ЗаявкаНаМойку.Обращение,
	|	Renault_CRM_ЗаявкаНаМойку.Длительность,
	|	Renault_CRM_ЗаявкаНаМойку.Состояние,
	|	Renault_CRM_ЗаявкаНаМойку.Примечание,
	|	Renault_CRM_ЗаявкаНаМойку.СостояниеИзменено,
	|	Renault_CRM_ЗаявкаНаМойку.ХозОперация,
	|	Renault_CRM_ЗаявкаНаМойку.РаботаМойка,
	|	Renault_CRM_ЗаявкаНаМойку.Платная,
	|	Renault_CRM_ЗаявкаНаМойку.Стоимость,
	|	Renault_CRM_ЗаявкаНаМойку.РаботаМойка.Авторабота
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ РаботыЗаявки КАК РаботыЗаявки
	|	ПО РаботыЗаявки.Работа = Renault_CRM_ЗаявкаНаМойку.РаботаМойка
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаМойку.Обращение = &Обращение
	|	И Renault_CRM_ЗаявкаНаМойку.Платная = &Платная";
	
	Запрос.УстановитьПараметр("Обращение", ЗаявкаНаСервис.Обращение);
	Запрос.УстановитьПараметр("СсылкаЗаявка", ЗаявкаНаСервис.Ссылка);
	Запрос.УстановитьПараметр("Платная", ИСТИНА);
	ПлатныеМойки = Запрос.Выполнить().Выбрать();
	Пока ПлатныеМойки.Следующий() Цикл
		Если ТипЗнч(ПлатныеМойки.РаботаМойка) = Тип("СправочникСсылка.Автоработы") Тогда
			Авторабота = ПлатныеМойки.РаботаМойка;
		Иначе
			Авторабота = ПлатныеМойки.РаботаМойка.Авторабота;
		КонецЕсли;
		
		Если ЗаказНаряд.Работы.Найти(Авторабота, "Работа") <> Неопределено Тогда
