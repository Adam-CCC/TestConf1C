Процедура ДобавитьПриемкуИвыдачу(Обращение, Автомобиль, Сотрудник, ДилерскийЦентр) Экспорт
	
	ГосНомер = Renault_ПолучитьГосНомер(Автомобиль);
	
	// добавим приемку и выдачу
	НоваяПриемка = Документы.Renault_CRM_ПриемкаАвтомобиля.СоздатьДокумент();
	НоваяПриемка.ДилерскийЦентр = ДилерскийЦентр;
	НоваяПриемка.Дата = ТекущаяДата();
	НоваяПриемка.Обращение = Обращение;
	НоваяПриемка.Автомобиль = Автомобиль;
	НоваяПриемка.ГосНомер = ГосНомер;
	НоваяПриемка.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
	НоваяПриемка.Клиент = ДилерскийЦентр;
	НоваяПриемка.Записать();
	
	НоваяВыдача = Документы.Renault_CRM_ВыдачаАвтомобиля.СоздатьДокумент();
	НоваяВыдача.ДилерскийЦентр = ДилерскийЦентр;
	НоваяВыдача.Дата = ТекущаяДата();
	НоваяВыдача.Обращение = Обращение;
	НоваяВыдача.Автомобиль = Автомобиль;
	НоваяВыдача.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
	НоваяВыдача.Клиент = ДилерскийЦентр;
	НоваяВыдача.ГосНомер = ГосНомер;
	НоваяВыдача.Записать();
	
КонецПроцедуры

