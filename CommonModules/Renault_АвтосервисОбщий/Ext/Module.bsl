		КонецПопытки;
		
	Иначе
		
		Попытка
			
			НовыйСчет.Записать(РежимЗаписиДокумента.Запись);
			Возврат НовыйСчет.Ссылка;
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
КонецФункции

Функция Renault_CRM_НачатьЗаписьНаСервис(Автомобиль, Сотрудник = Неопределено, ДилерскийЦентр = Неопределено, IDK = Неопределено) Экспорт
	
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Форма = ПолучитьОбщуюФорму("Renault_АвтосервисДобавлениеЗЧ");
	Форма.Автомобиль = Автомобиль;
	Форма.ВидРемонта = Справочники.ВидыРемонта.КомплектацияАвтомобиля;
	Форма.ЗаполнятьСвязаннымиРаботами = ИСТИНА;
	Форма.ДилерскийЦентр = ДилерскийЦентр;
	форма.Нормочас = ДилерскийЦентр.Автосервис_Нормочас;
	Форма.ТипЦен = ДилерскийЦентр.Автосервис_ТипЦенПродажи;
	Форма.Обращение = Документы.Renault_CRM_ОбращениеВАвтоСервис.ПустаяСсылка();
	форма.IDK = IDK;
	Форма.Заголовок = "Запрос автосервиса на комлектацию.";
	
	Результат = Форма.ОткрытьМодально();
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Возврат Результат.Обращение;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция Renault_ЗаписатьНаДокомплектациюСервис(Автомобиль, Сотрудник, ДилерскийЦентр, НомерРабочегоЛиста = Неопределено, ТипУстановкиДопов) Экспорт
	
	Форма = Справочники.Renault_СписокДопов.ПолучитьФорму("ФормаВыбора_Новая");
	//форма.МножественныйВыбор = ИСТИНА;
	Форма.Автомобиль = Автомобиль;
	Ответ = Форма.ОткрытьМодально();
	
	Если НЕ ЗначениеЗаполнено(Ответ) Тогда
		
		Возврат Документы.Renault_CRM_ОбращениеВАвтоСервис.ПустаяСсылка();
		
	КонецЕсли;
	
	Документ = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
	Документ.Дата = ТекущаяДата();
	Документ.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.CRM_ДокомплектацияАвто;
	
	Если ЗначениеЗаполнено(НомерРабочегоЛиста) Тогда
		
		Документ.IDK = НомерРабочегоЛиста;
		
	КонецЕсли;
	
	Документ.ДилерскийЦентр = ДилерскийЦентр;
	Документ.Менеджер = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Сотрудник);
	Документ.Клиент = ДилерскийЦентр;
	Документ.Примечание = "Модель: " + Автомобиль.Модель.Наименование;
	Документ.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный;
	Документ.Автомобиль = Автомобиль;
	Документ.ОбращениеОбработано = Ложь;
	Документ.Внутренний = ИСТИНА;
	Документ.Жалоба = Ложь;
	Документ.Записать();
	
	СоздатьЗаявкуНаСервис(Ответ, Документ);
	
	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	Напоминание.Отправитель = Сотрудник;
	Напоминание.Подробнее = Документ.Ссылка;
	
	ДатаОтправки = ТекущаяДата();
	
	Напоминание.ДатаОтправки = ДатаОтправки;
	Напоминание.Комментарий = Автомобиль;
	Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.Автосервис_КлиентНазначенНаМастера;    
	Напоминание.ПоказыватьС = ДатаОтправки;
	Напоминание.ПоказыватьПо = ДатаОтправки;
	Напоминание.Наименование = "Внутренний заезд.";
	Напоминание.Сообщение = "Регистрация внутреннего заезда: " + Автомобиль.Модель.Наименование;;
	Напоминание.Записать();
	
	Возврат Документ.Ссылка;
	
КонецФункции

