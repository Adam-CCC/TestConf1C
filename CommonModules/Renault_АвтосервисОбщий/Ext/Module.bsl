Функция ПараметрыПодключенияКБазеПланшет() Экспорт
	
	Ответ = Новый Структура();
	Подключение = Справочники.Renault_АвтосервисНастройкиРаботыСПланшетом.ПодключениеПоУмолчанию;
	
	Для Каждого Рекв Из Метаданные.Справочники.Renault_АвтосервисНастройкиРаботыСПланшетом.Реквизиты Цикл
		
		Ответ.Вставить(Рекв.Имя,Подключение[Рекв.Имя]);
		
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

