Функция ВернутьДатыДокумента(ЗаказНаряд, ЗаявкаНаСервис)
	Запрос = Новый Запрос;
	ЗАпрос.Текст = "ВЫБРАТЬ
	               |	МИНИМУМ(ЕСТЬNULL(Renault_CRM_ПриемкаАвтомобиля.ВремяНачала, &ВремяНачала)) КАК ДатаЗаезда,
	               |	МАКСИМУМ(ЕСТЬNULL(Renault_CRM_ВыдачаАвтомобиля.ВремяНачала, &ВремяОкончания)) КАК ДатаВыдачи
	               |ИЗ
	               |	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля,
	               |	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
	               |ГДЕ
	               |	Renault_CRM_ВыдачаАвтомобиля.Обращение = &Обращение
	               |	И Renault_CRM_ПриемкаАвтомобиля.Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение",ЗаявкаНаСервис.Обращение);
	Запрос.УстановитьПараметр("ВремяНачала",ЗаявкаНаСервис.ВремяНачала);
	Запрос.УстановитьПараметр("ВремяОкончания",ЗаявкаНаСервис.ВремяОкончания);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		ВремяНачала = Выборка.ДатаЗаезда;
		ВремяОкончания = Выборка.ДатаВыдачи;
		ЗаказНаряд.ДатаМашинозаезда = ВремяНачала; 
		ЗаказНаряд.ПлановаяДатаВыдачи = ВремяОкончания; 
		Если ВремяНачала>ТекущаяДата() Тогда
			ЗаказНаряд.Дата = ТекущаяДата();
		Иначе
			ЗаказНаряд.Дата = ВремяНачала;
		КонецЕсли;
	КонецЕСли;	
КонецФункции	
// Изменения МИС 06/08/2018 --

Функция Reanult_ОбновитьСформироватьЗаказНаряд(ЗаказНарядСсылка, ЗаявкаНаСервис, ПоказыватьДокумент = Истина, Обращение = неопределено) Экспорт

	ДилерскийЦентр = ЗаявкаНаСервис.ДилерскийЦентр;
	УдалятьОтсутствующиеВЗаявке = ДилерскийЦентр.Автосервис_УдалятьВЗНОтсутствующиеВЗаявке;

	Модальность = Истина;
	
	Если ЗаказНарядСсылка = Неопределено Тогда
		
		ЗаказНаряд = Документы.ЗаказНаряд.СоздатьДокумент();
		ТаблицаРаботЗН = ЗаказНаряд.Работы.Выгрузить();
		ТаблицаТоваровЗН = ЗаказНаряд.Товары.Выгрузить();
		ТаблицаИсполнителейЗН = ЗаказНаряд.Исполнители.Выгрузить();
		ЗаказНаряд.Дата = ТекущаяДата();
		
		ЗаказНаряд.Организация=ПараметрыСеанса.Пользователь.Организация; //ЗаказНаряд.Организация = ЗаявкаНаСервис.ДилерскийЦентр.Организация;
		ЗаказНаряд.ПодразделениеКомпании=ПараметрыСеанса.Пользователь.Подразделение; //ЗаказНаряд.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
		
		ЗаказНаряд.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка;
		ЗаказНаряд.Автомобиль = ЗаявкаНаСервис.Автомобиль;
		ЗаказНаряд.Контрагент = ЗаявкаНаСервис.Клиент;
		ЗаказНаряд.ВидРемонта = ЗаявкаНаСервис.ВидРемонта;
		ЗаказНаряд.Заказчик = ЗаявкаНаСервис.Клиент;
		ЗаказНаряд.ВидОплаты = ЗаявкаНаСервис.ВидОплаты;
		ЗаказНаряд.РегламентированныйУчет = Истина;
		ЗаказНаряд.УстановитьНовыйНомер();
		
		если ЗначениеЗаполнено(Обращение) тогда
			
			если ЗначениеЗаполнено(Обращение.МенеджерКупонов_Акция) тогда
				ЗаказНаряд.Комментарий = "Акция """ + Обращение.МенеджерКупонов_Акция +"""";
			КонецЕсли;
			
			если ЗначениеЗаполнено(Обращение.МенеджерКупонов_Промокод) тогда
				ЗаказНаряд.Комментарий = "Купон """ + Обращение.МенеджерКупонов_Промокод +"""";	
			КонецЕсли;
			
		КонецЕсли;

		
	Иначе
		
		ЗаказНаряд = ЗаказНарядСсылка.Ссылка.ПолучитьОбъект();
		ЗаказНаряд.Автомобиль = ЗаявкаНаСервис.Автомобиль;
		ЗаказНаряд.Контрагент = ЗаявкаНаСервис.Клиент;
		ЗаказНаряд.ВидРемонта = ЗаявкаНаСервис.ВидРемонта;
		ЗаказНаряд.Заказчик = ЗаявкаНаСервис.Клиент;
		ЗаказНаряд.РегламентированныйУчет = Истина;
		
		Если НЕ ЗначениеЗаполнено(ЗаказНаряд.Номер) Тогда
			ЗаказНаряд.Организация = ЗаявкаНаСервис.ДилерскийЦентр.Организация;
			ЗаказНаряд.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
			ЗаказНаряд.УстановитьНовыйНомер();
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЗаказНаряд.Состояние) Тогда
			ЗаказНаряд.Состояние = Справочники.ВидыСостоянийЗаказНарядов.ВРаботе;
		КонецЕсли;
		
		Модальность = ЛОЖЬ;
		
		ТаблицаРаботЗН = ЗаказНаряд.Работы.Выгрузить();
		ТаблицаТоваровЗН = ЗаказНаряд.Товары.Выгрузить();
		ТаблицаИсполнителейЗН = ЗаказНаряд.Исполнители.Выгрузить();
		Если УдалятьОтсутствующиеВЗаявке Тогда
			ЗаказНаряд.Работы.Очистить();
			ЗаказНаряд.Товары.Очистить();
		КонецЕсли;
		ЗаказНаряд.Исполнители.Очистить();
		
		//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
			
		ЗаказНаряд.МатериалыЗаказчика.Очистить();
		
		//КонецЕсли;
		
	КонецЕсли;
	
	ВидРемонта = ЗаявкаНаСервис.ВидРемонта;
	
	СтавкаНДСТовары = Справочники.СтавкиНДС.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ВидРемонта) Тогда
		
		СтрТаб = ЗаявкаНаСервис.ДилерскийЦентр.Автосервис_СоответсвиеНДСИВидРемонта.Найти(ВидРемонта, "ВидРемонта");
		
		Если ЗначениеЗаполнено(СтрТаб) Тогда
			
			СтавкаНДСРаботы = СтрТаб.СтавкаНДС;
			СтавкаНДСТовары = СтрТаб.СтавкаНДСЗапчасти;
			
		Иначе
			
			СтавкаНДСРаботы = ЗаявкаНаСервис.ДилерскийЦентр.Автосервис_СтавкаНДС;
			СтавкаНДСТовары = СтавкаНДСРаботы;
			
		КонецЕсли;
		
	Иначе
		
		СтавкаНДСРаботы = ЗаявкаНаСервис.ДилерскийЦентр.Автосервис_СтавкаНДС;
		СтавкаНДСТовары = СтавкаНДСРаботы;
		
	КонецЕсли;
	
	Попытка ЗаказНаряд.ОбработкаЗаполнения(Неопределено); 	Исключение 	КонецПопытки;
		
	//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
	ЗаказНаряд.ТипЦенРабот = ЗаявкаНаСервис.ТипЦен;
	ЗаказНаряд.ТипЦен = обПраво("ОсновнойТипЦенПродажи",,,);
	//КонецЕсли;
	
	ЭтоГарантия = РегистрыСведений.Renault_ВидыРемонтаДопРеквизиты.ПолучитьГарантиюЗавода(ЗаказНаряд.ВидРемонта);
	
	// И для гарантии теперь заполняем договор и контрагента DMSCOR-562 13.11.2018
	//Если ЭтоГарантия = ЛОЖЬ Тогда
		// DMSREN-1353
		если ЭтоГарантия тогда 
			ЗаказНаряд.Контрагент = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.ОсновнойПоставщик;
		иначе
			ЗаказНаряд.Контрагент = ЗаявкаНаСервис.Клиент;
		КонецЕсли;

		ДопПараметры = Новый Структура;
		ВидДоговора = Перечисления.ВидыДоговоров.Продажа;
		ДопПараметры.Вставить("ВидДоговора", ВидДоговора);
		ЕстьТипЦен = (ЗаказНаряд.Метаданные().Реквизиты.Найти("ТипЦен") <> Неопределено);
		ДопПараметры.Вставить("ТипЦенПродажи", ?(ЕстьТипЦен, ЗаказНаряд.ТипЦен, Справочники.ТипыЦен.ПустаяСсылка()));
		ДопПараметры.Вставить("ВалютаВзаиморасчетов", ?(ЗначениеЗаполнено(ДопПараметры.ТипЦенПродажи.ВалютаЦены), ДопПараметры.ТипЦенПродажи.ВалютаЦены, Константы.ВалютаУправленческогоУчетаКомпании.Получить()));
		ДопПараметры.Вставить("ВидОплаты",Перечисления.ВидыОплаты.ПроизвольнаяОплата);

		ЗаказНаряд.ДоговорВзаиморасчетов = дкПолучитьДоговорВзаиморасчетов(ЗаказНаряд.Контрагент, ВидДоговора, ЗаказНаряд, ДопПараметры, Истина);
		Если НЕ ЗначениеЗаполнено(ЗаказНаряд.ДоговорВзаиморасчетов) Тогда
			Попытка
				Выполнить("ЗаказНаряд.ДоговорВзаиморасчетов = Справочники.Контрагенты.ПолучитьДоговорВзаиморасчетов(ЗаказНаряд.Контрагент, ВидДоговора, ЗаказНаряд, ДопПараметры, Истина)");
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		//Дозаполним реквизиты договора.
		Если ЗначениеЗаполнено(ЗаказНаряд.ДоговорВзаиморасчетов) Тогда
			Если НЕ ЗначениеЗаполнено(ЗаказНаряд.ДоговорВзаиморасчетов.ВидОплаты) ИЛИ НЕ ЗначениеЗаполнено(ЗаказНаряд.ДоговорВзаиморасчетов.ВидОплаты) Тогда
				Договор = ЗаказНаряд.ДоговорВзаиморасчетов.ПолучитьОбъект();
				Договор.ВидОплаты = Перечисления.ВидыОплаты.ПроизвольнаяОплата;
				Договор.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
				Договор.ЕдиницаИзмеренияАвтоработВПечатныхФормах = обПраво("ЕдиницаИзмеренияАвтоработВПечатныхФормах"); // DMSREN-1228
				Договор.Записать();
			КонецЕсли;
		КонецЕсли;
	//Иначе
