Функция ПолучитьРекомендуемыеДатыВизита(Автомобиль) Экспорт
	
	ДатаБлижайшейРекомендации = Дата(1,1,1);
	ДатаСледующегоТО = Дата(1,1,1);
	ДатаЧерезМесяц = ДобавитьМесяц(ТекущаяДата(), 1);
	ДатаЧерезТриМесяца = ДобавитьМесяц(ТекущаяДата(), 3);
	
	ДатаСледующегоТО = РегистрыСведений.Renault_ВыполнениеТО.ПолучитьПоследнийТО(Автомобиль);
	ДатаБлижайшейРекомендации = ПолучитьДатуБлижайшейРекомендации(Автомобиль);
	
	Результат = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ДатаБлижайшейРекомендации) Тогда
		
		Результат.Добавить("Дата ближайшей рекомендации: " + Формат(ДатаБлижайшейРекомендации, "ДФ=dd.MM.yyyy"), ДатаБлижайшейРекомендации);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаСледующегоТО) Тогда
		
		Результат.Добавить("Дата следующего ТО: " + Формат(ДатаСледующегоТО, "ДФ=dd.MM.yyyy"), ДатаСледующегоТО);
		
	КонецЕсли;
	
	Результат.Добавить("Через месяц", ДатаЧерезМесяц);
	Результат.Добавить("Через три месяца", ДатаЧерезТриМесяца);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДатуБлижайшейРекомендации(Автомобиль) Экспорт
	
	ДатаБлижайшейРекомендации = Дата(1,1,1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.РекомендуемаяДатаВыполнения
	               |ИЗ
	               |	РегистрСведений.Renault_ПоврежденияАвтомобилей.СрезПоследних КАК Renault_ПоврежденияАвтомобилейСрезПоследних
	               |ГДЕ
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Автомобиль = &Автомобиль
	               |	И Renault_ПоврежденияАвтомобилейСрезПоследних.РаботаАктуальна = &РаботаАктуальна";
				   
				   Запрос.УстановитьПараметр("РаботаАктуальна", Истина);
				   Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.РекомендуемаяДатаВыполнения > ТекущаяДата() Тогда
			
			ДатаБлижайшейРекомендации = Выборка.РекомендуемаяДатаВыполнения;
			
			
		Иначе
			
			ДатаБлижайшейРекомендации = ТекущаяДата();
			
		КонецЕсли
		
	КонецЕсли;
	
	Возврат ДатаБлижайшейРекомендации;
	
КонецФункции

функция СоздатьЗаявкуНаСервис(Данные, Обращение) Экспорт
	
	ДокОбъект = Документы.Renault_CRM_ЗаявкаНаСервис.СоздатьДокумент();
	ДокОбъект.ДилерскийЦентр = Обращение.ДилерскийЦентр;
	//ДокОбъект.ОбработкаЗаполнения(Неопределено);
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Клиент = Обращение.ДилерскийЦентр.Автосервис_Контрагент;
	ДокОбъект.Автомобиль = Обращение.Автомобиль;
	ДокОбъект.Обращение = Обращение.Ссылка;
	ДокОбъект.ВидРемонта = Справочники.ВидыРемонта.ДополнительноеОборудование;
	
	//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
		
	ДокОбъект.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка;
		
	//Иначе
	//	
	//	ДокОбъект.Состояние = Перечисления.СостояниеЗаказНаряда.Заявка;
	//	
	//КонецЕсли;
	
	Для Каждого Допник из Данные Цикл
		
		Доп = Допник.Ссылка;
		
		ИдРаботы = 0;
		
		ОбщаяДлительность = 0;
		
		Для Каждого СтрокаРаботы из Доп.Работы Цикл
			
			ИдРаботы = ИдРаботы + 1;
			НоваяРабота = ДокОбъект.Работы.Добавить();
			НоваяРабота.Работа = СтрокаРаботы.Авторабота;
			НоваяРабота.Длительность = СтрокаРаботы.Длительность;
			НоваяРабота.ДлительностьЗН = СтрокаРаботы.Длительность;
			
			Запрос = Новый Запрос();
			
			Запрос.Текст = "ВЫБРАТЬ
			               |	ЦеныАвтоработСрезПоследних.Нормочас
			               |ИЗ
			               |	РегистрСведений.ЦеныАвторабот.СрезПоследних КАК ЦеныАвтоработСрезПоследних
			               |ГДЕ
			               |	ЦеныАвтоработСрезПоследних.Авторабота = &Авторабота
			               |	И ЦеныАвтоработСрезПоследних.ВидРемонта = &ВидРемонта";
						   
			Запрос.УстановитьПараметр("Авторабота", СтрокаРаботы.Авторабота);
			Запрос.УстановитьПараметр("ВидРемонта", Справочники.ВидыРемонта.ДополнительноеОборудование);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				НоваяРабота.Нормочас = Выборка.Нормочас;
				
			КонецЕсли;
			
			НоваяРабота.Цена = СтрокаРаботы.Стоимость;
			НоваяРабота.Сумма = СтрокаРаботы.Стоимость;
			НоваяРабота.ИдентификаторРаботы = ИдРаботы;
			
			IDРаботы = Новый УникальныйИдентификатор();
			
			НоваяРабота.IDРаботы = IDРаботы;
			
			ОбщаяДлительность = ОбщаяДлительность + НоваяРабота.Длительность;
			
		КонецЦикла;
		
		Для Каждого СтрокаТовара ИЗ Доп.Товары Цикл
			
			ИдРаботы = ИдРаботы + 1;
			НоваяСтрока = ДокОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура = СтрокаТовара.Номенклатура;
			НоваяСтрока.Количество = СтрокаТовара.Количество;
			НоваяСтрока.Цена = СтрокаТовара.Стоимость;
			НоваяСтрока.Сумма = СтрокаТовара.Стоимость;
			
		КонецЦикла;
		
		ДокОбъект.СуммаЗапчастиВсего = ДокОбъект.Товары.Итог("Сумма");
		ДокОбъект.СуммаРаботВсего = ДокОбъект.Работы.Итог("Сумма");
		ДокОбъект.СуммаДокумента = ДокОбъект.СуммаЗапчастиВсего + ДокОбъект.СуммаРаботВсего;
		
		ДокОбъект.Записать();
		
	КонецЦикла;
	
КонецФункции

