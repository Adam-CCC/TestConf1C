		НовыйСчет.ПолучитьФорму().ОткрытьМодально();
		
		Возврат НовыйСчет.Ссылка;
		
	Исключение
		
		НовыйСчет.ПолучитьФорму().ОткрытьМодально();
		
		Если НЕ НовыйСчет.ЭтоНовый() тогда
			
			Возврат НовыйСчет.Ссылка;
			
		Иначе
			
			Возврат Неопределено;
			
