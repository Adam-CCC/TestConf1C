Функция ПолучитьЦенуТоваров (Номенклатура, ТипЦен, Подразделение = Неопределено) Экспорт 
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	ЦеныСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.ТипЦен = &ТипЦен
	|	И ЦеныСрезПоследних.Номенклатура = &Номенклатура";
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		
		Запрос.Текст = Запрос.Текст + Символы.ПС +
		"И ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпании";
		
		Запрос.УстановитьПараметр("ПодразделениеКомпании", Подразделение);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Цены = Запрос.Выполнить().Выгрузить();
	
	Если ЗначениеЗаполнено(Цены) Тогда
		
		Возврат Цены[0].Цена;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
	
КонецФункции

Функция ЭтоАвтомобильРено(Данные) Экспорт
	
	Модель = Неопределено;
	
	Если ТипЗнч(Данные) = Тип("СправочникСсылка.Модели") Тогда
		
		Модель = Данные;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникСсылка.Автомобили") Тогда
		
		Модель = Данные.Модель;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникСсылка.Renault_ЧерновикиАвтомобилей") Тогда
		
		Модель = Данные.Модель;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Справочники.CRM_МаркаАвтомобиля.RENAULT.МоделиАвтомобилей.Найти(Модель, "Модель")) Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

