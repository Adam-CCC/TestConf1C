Функция Renault_ЗавершитьВсеРаботыПоОбращению(Обращение) Экспорт
	
	//Завершить все мойки:
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаМойку.Ссылка,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Цех
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО Renault_CRM_ЗаявкаНаМойку.Обращение = Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение
	|			И Renault_CRM_ЗаявкаНаМойку.Ссылка = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаМойку.Обращение = &Обращение
	|	И Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы <> &СтатусРаботы";
	
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	
	Мойки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Мойка из Мойки Цикл
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
		Запись.ДилерскийЦентр = Обращение.ДилерскийЦентр;
		Запись.Обращение = Обращение;
		Запись.Период = ТекущаяДата();
		Запись.РабочийДокумент = Мойка.Ссылка;
		Запись.Цех = Мойка.Цех;
		Запись.ЭтапРабот = "1";
		Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена;
		Запись.Записать();
		
	КонецЦикла;
	
	//Все этапы завершим, всех их завершим :)
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Цех,
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка КАК Ссылка,
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.IDЭтапа
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаСервис.Этапы КАК Renault_CRM_ЗаявкаНаСервисЭтапы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|			И Renault_CRM_ЗаявкаНаСервисЭтапы.IDЭтапа = Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот
	|ГДЕ
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы <> &СтатусРаботы
	|	И Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка.Обращение = &Обращение
	|
	|СГРУППИРОВАТЬ ПО
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Цех,
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.IDЭтапа
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	
	ВыборкаЗаявки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Пока ВыборкаЗаявки.Следующий() Цикл
		
		Этапы = ВыборкаЗаявки.Выбрать();
		
		Пока Этапы.Следующий() Цикл
			
			Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
			Запись.ДилерскийЦентр = Обращение.ДилерскийЦентр;
			Запись.Обращение = Обращение;
			Запись.Период = ТекущаяДата();
			Запись.РабочийДокумент = ВыборкаЗаявки.Ссылка;
			Запись.Цех = Этапы.Цех;
			Запись.ЭтапРабот = Этапы.IDЭтапа;
			Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена;
			Запись.Записать();
			
		КонецЦикла;
		
		Заявка = ВыборкаЗаявки.Ссылка;
		
		ОбЗаявка = Заявка.Ссылка.ПолучитьОбъект();
		ОбЗаявка.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен;
		ОбЗаявка.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
	//Завершить все подменки:
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Ссылка,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Цех
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаПодменныйАвто КАК Renault_CRM_ЗаявкаНаПодменныйАвто
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО Renault_CRM_ЗаявкаНаПодменныйАвто.Обращение = Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение
	|			И Renault_CRM_ЗаявкаНаПодменныйАвто.Ссылка = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Обращение = &Обращение
	|	И Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы <> &СтатусРаботы";
	
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	
	Подменки = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Подменка из Подменки Цикл
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
		Запись.ДилерскийЦентр = Обращение.ДилерскийЦентр;
		Запись.Обращение = Обращение;
		Запись.Период = ТекущаяДата();
		Запись.РабочийДокумент = Подменка.Ссылка;
		Запись.Цех = Подменка.Цех;
		Запись.ЭтапРабот = "1";
		Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена;
		Запись.Записать();
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьСтрокуСоединенияКБазеПланшетПоПараметрам(Параметры = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Параметры) Тогда
		
		Параметры = ПараметрыПодключенияКБазеПланшет();
		
	КонецЕсли;
	
	Ответ = "Driver={"+Параметры.Драйвер+"};Server="+Параметры.АдресСервера+
	";Database="+Параметры.БазаДанных+";Uid="+Параметры.Логин+";Pwd="+Параметры.Пароль+";";
	
	Возврат Ответ;
	
КонецФункции

Функция НайтиВБазеСсылкуПоОтбору(ИмяОбъекта, СтруктураОтбора) Экспорт
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ 
	|	ИсточникПоиска.Ссылка КАК Ссылка
	|ИЗ
	|	" + ИмяОбъекта + " КАК ИсточникПоиска";
	ЭтоПервоеУсловие = Истина;
	Для Каждого Условие Из СтруктураОтбора Цикл
		Если ЭтоПервоеУсловие Тогда
			ЭтоПервоеУсловие = Ложь;
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + " ГДЕ " + Символы.ПС;
		Иначе
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + " ИсточникПоиска." + Условие.Ключ + " = &" + Условие.Ключ;
		Запрос.УстановитьПараметр(Условие.Ключ, Условие.Значение);
	КонецЦикла;
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

