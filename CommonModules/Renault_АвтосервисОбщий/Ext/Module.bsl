			Рекомендации = Строка(РекомендацииВСЕ.Комментарий);
		КонецЕсли;
		Выборка2 = РекомендацииВСЕ.Выбрать();
		Пока Выборка2.Следующий() Цикл
			Рекомендации = ?(ЗначениеЗаполнено(Рекомендации), Рекомендации + Символы.ПС + Строка(Выборка2.Работа), Строка(Выборка2.Работа));
		КонецЦикла;
	КонецЦикла;
	
	Если Метаданные.Документы.ЗаказНаряд.Реквизиты.Найти("Рекомендации") <> Неопределено Тогда
		ЗаказНаряд.Рекомендации = Рекомендации;
