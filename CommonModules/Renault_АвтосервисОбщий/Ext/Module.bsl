Процедура ОтметитьВыполнениеСтандартаМастером(Обращение, Сотрудник = Неопределено, ПредложилАкции = Неопределено, ПредложилРекомендации = Неопределено, ПредложилТаксиПодменку = Неопределено) Экспорт
	
	Запись = РегистрыСведений.Renault_ВыполнениеСтандартовМастерами.СоздатьМенеджерЗаписи();
	Запись.Обращение = Обращение;
	Запись.Прочитать();
	Запись.Обращение = Обращение;
	Если ПредложилАкции <> Неопределено Тогда
		Запись.ПредложилАкции = ПредложилАкции;
	КонецЕсли;
	Если ПредложилРекомендации <> Неопределено Тогда
		Запись.ПредложилРекомендации = ПредложилРекомендации;
	КонецЕсли;
	Если ПредложилТаксиПодменку <> Неопределено Тогда
		Запись.ПредложилТаксиПодменку = ПредложилТаксиПодменку;
	КонецЕсли;
	Если Сотрудник <> Неопределено Тогда
		Запись.Сотрудник = Сотрудник;
	КонецЕсли;
	Запись.Записать();
	
КонецПроцедуры

Функция Renault_НайтиНомераТелефоновИНормализовать() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтактнаяИнформация.Объект,
	               |	КонтактнаяИнформация.Представление
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Тип = &Тип";
	
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	
	ТаблицаКонтактнойИнформации = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка из ТаблицаКонтактнойИнформации Цикл
		
		Нормал = Строка.Представление;
		
		Нормал = СтрЗаменить(Нормал, "+", "");
		Нормал = СтрЗаменить(Нормал, "-", "");
		Нормал = СтрЗаменить(Нормал, ".", "");
		Нормал = СтрЗаменить(Нормал, "*", "");
		Нормал = СтрЗаменить(Нормал, " ", "");
		Нормал = СтрЗаменить(Нормал, "(", "");
		Нормал = СтрЗаменить(Нормал, ")", "");
		
		Если Найти(Нормал, "7") = 1 ИЛИ Найти(Нормал, "8") = 1 Тогда
			
			Нормал = Прав(Нормал, СтрДлина(Нормал) - 1);
			
		КонецЕсли;
		
		Строка.Представление = Нормал;
		
	КонецЦикла;
	
	Возврат ТаблицаКонтактнойИнформации;
	
КонецФункции

Функция Renault_ВыбратьТелефон(Контрагент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Комментарий
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контрагент
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	ТелефоныКлиента = Запрос.Выполнить().Выгрузить();
	Если ТелефоныКлиента.Количество() = 1 Тогда
		
		ВыбраннаяСтрока = ТелефоныКлиента[0];
		
	ИначеЕсли ТелефоныКлиента.Количество() > 1 Тогда
		#Если Клиент Тогда
			
			ВыбраннаяСтрока = ТелефоныКлиента.ВыбратьСтроку("Выберите контактный телефон");
			Если ВыбраннаяСтрока = Неопределено Тогда
				Предупреждение("Не выбраны контактные данные");
				Возврат "";
			КонецЕсли;
			
		#Иначе
			
			ВыбраннаяСтрока = ТелефоныКлиента[0];
			
		#КонецЕсли
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат ВыбраннаяСтрока.Представление;
	
КонецФункции

