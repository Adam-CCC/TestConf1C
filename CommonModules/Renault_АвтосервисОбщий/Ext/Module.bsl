	Документ.Примечание = "Модель: " + Автомобиль.Модель.Наименование;
	Документ.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный;
	Документ.ОбращениеОбработано = Ложь;
	Документ.Внутренний = ИСТИНА;
	Документ.Жалоба = Ложь;
	Документ.Записать();
	
	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	Напоминание.Отправитель = Сотрудник;
	Напоминание.Подробнее = Документ.Ссылка;
	
	ДатаОтправки = ТекущаяДата();
	
	Напоминание.ДатаОтправки = ДатаОтправки;
	Напоминание.Комментарий = Автомобиль;
	Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.Автосервис_КлиентНазначенНаМастера;
	Напоминание.ПоказыватьС = ДатаОтправки;
	Напоминание.ПоказыватьПо = ДатаОтправки;
