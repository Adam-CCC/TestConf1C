Процедура Renault_ПроверкаКорректностиГосНомераПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если НЕ Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.ГосНомерАвтоТолькоЛатиницей Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для Каждого СтрокаИсточника из Источник Цикл
		Если СтрокаИсточника.ВидЗначения = Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер Тогда
			
			ЗапрещенныеСимволы = "";
			
			Если ЕстьКириллица(СтрокаИсточника.Значение, ЗапрещенныеСимволы) Тогда
				
				Сообщить("Установлена запись госномера только латиницей. Запрещенные кириллические символы: " + ВРег(ЗапрещенныеСимволы) + " запись отменена");
				
				Отказ = Истина;
				
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьКириллица(ИсходнаяСтрока, ЗапрещенныеСимволы = "") Экспорт 
	ЕстьКириллица=ложь; 
	ИсходнаяСтрока=СокрЛП(ИсходнаяСтрока); 
	Если СтрДлина(ИсходнаяСтрока)>0 Тогда 
		Для Сч=1 по СтрДлина(ИсходнаяСтрока) Цикл 
		Символ = НРег(Сред(ИсходнаяСтрока, Сч, 1)); 
		Если Найти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", Символ) Тогда
			
			ЗапрещенныеСимволы = ЗапрещенныеСимволы + Строка(Символ);
				ЕстьКириллица=истина; 
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 

	Возврат ЕстьКириллица; 
КонецФункции

