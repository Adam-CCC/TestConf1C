		КонецЕсли;
		
		НоваяСтрока = ЗаказНаряд.Работы.Добавить();
		НоваяСтрока.Работа = Авторабота;
		ИзРегистра = РегистрыСведений.ЦеныАвторабот.СрезПоследних().Найти(Авторабота, "Авторабота");
		
		Если ЗначениеЗаполнено(ПлатныеМойки.Ссылка.Нормочас) Тогда
			НоваяСтрока.Нормочас = ПлатныеМойки.Ссылка.Нормочас;
		ИначеЕсли ИзРегистра = Неопределено Тогда
			Сообщить("Не указан нормочас для работы " + Авторабота);
		Иначе
			НоваяСтрока.Нормочас = ИзРегистра.Нормочас;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Нормочас) Тогда
			НоваяСтрока.Нормочас = ДилерскийЦентр.Автосервис_Нормочас;
		КонецЕсли;
		
		Длительность = ПлатныеМойки.Длительность;
		Если НЕ ЗначениеЗаполнено(Длительность) Тогда
			Если ТипЗнч(ПлатныеМойки.РаботаМойка) = Тип("СправочникСсылка.Автоработы") Тогда
				Длительность = ПлатныеМойки.РаботаМойка.Ссылка.ВремяВыполнения; 
			Иначе
				Длительность = ПлатныеМойки.РаботаМойка.Длительность;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока.СуммаВсего = ПлатныеМойки.Стоимость;
		НоваяСтрока.Цена = ПлатныеМойки.Ссылка.Цена;
		НоваяСтрока.Сумма = ПлатныеМойки.Стоимость;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.СтавкаНДС = СтавкаНДСРаботы;
		НоваяСтрока.Коэффициент = Длительность;
		НоваяСтрока.ИдентификаторРаботы = Новый УникальныйИдентификатор;
		
		Если ЗаявкаНаСервис.ДилерскийЦентр.Автосервис_ИсполнителиМойкиВЗН = ИСТИНА Тогда
			Если ЗначениеЗаполнено(ПлатныеМойки.Машиноместо) и ЗначениеЗаполнено(ПлатныеМойки.Машиноместо.Исполнитель) Тогда
				СтрокаИсполнители = ЗаказНаряд.Исполнители.Добавить();
				СтрокаИсполнители.ИдентификаторРаботы = НоваяСтрока.ИдентификаторРаботы;
				СтрокаИсполнители.Цех = ПлатныеМойки.Машиноместо;
				СтрокаИсполнители.Исполнитель = ПлатныеМойки.Машиноместо.Исполнитель;
				СтрокаИсполнители.Процент = 100;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	СуммаСкидкиПоБалламРаботы = 0;
	СуммаСкидкиПоБалламЗЧ = 0;
	
	Для Каждого Строка ИЗ ЗаявкаНаСервис.Работы Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Работа", Строка.Работа);
		Отбор.Вставить("Коэффициент", Строка.ДлительностьЗН);
		МассивСтрок = ЗаказНаряд.Работы.НайтиСтроки(Отбор);
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Отбор = Новый Структура;
		Отбор.Вставить("Работа", Строка.Работа);
		Отбор.Вставить("Коэффициент", Строка.ДлительностьЗН);
		МассивСтрок = ТаблицаРаботЗН.НайтиСтроки(Отбор);
		
		КоличествоОдинаковыхСтрок = МассивСтрок.Количество();
		Если КоличествоОдинаковыхСтрок > 0 Тогда
			Для Каждого СтрокаИЗМассива ИЗ МассивСтрок Цикл
				НоваяСтрока = ЗаказНаряд.Работы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИЗМассива, , "ПроцентСкидки, СуммаСкидки");
				НоваяСтрока.ПроцентСкидкиСтроки = Строка.ПроцентСкидки;
				НоваяСтрока.СуммаВсего = Строка.Сумма * КоличествоОдинаковыхСтрок;
				НоваяСтрока.СуммаСкидкиСтроки = Строка.СуммаСкидки * КоличествоОдинаковыхСтрок;
				НоваяСтрока.СуммаСкидки = Строка.СуммаСкидки * КоличествоОдинаковыхСтрок;
				НоваяСтрока.Сумма = НоваяСтрока.СуммаВсего + НоваяСтрока.СуммаСкидкиСтроки;
				НоваяСтрока.Цена = Строка.Цена;
				НоваяСтрока.Нормочас = Строка.Нормочас;
				Если ДилерскийЦентр.ИспользуетПрограммуЛояльностиRenault Тогда
					НоваяСтрока.СкидкаНаТовар = Скидка;
