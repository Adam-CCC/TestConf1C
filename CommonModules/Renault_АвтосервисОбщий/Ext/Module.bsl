	// посмотрим есть ли заметки
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаметкиПользователей.Объект,
	|	ЗаметкиПользователей.Автор,
	|	ЗаметкиПользователей.Дата,
	|	ЗаметкиПользователей.ТекстЗаметки,
	|	ЗаметкиПользователей.Напоминать
	|ИЗ
	|	РегистрСведений.ЗаметкиПользователей КАК ЗаметкиПользователей
	|ГДЕ
	|	ЗаметкиПользователей.Напоминать = ИСТИНА
	|	И ЗаметкиПользователей.Объект = &Значение";
	Запрос.УстановитьПараметр("ПустаяСтрока" , "");
	Запрос.УстановитьПараметр("Значение"     , Клиент);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ТекстЗаметкиВсего = "Заметка по контрагенту: " + Символы.ПС;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл;
			
			ТекстЗаметкиВсего = ТекстЗаметкиВсего + Символы.ПС + Выборка.ТекстЗаметки;
			
		КонецЦикла;
		
	КонецЕсли;
	
	//  ++
	Если BIR<>"" И VIN<>"" Тогда
		Если СтрДлина(ТекстЗаметкиВсего)>0 Тогда
			ТекстЗаметкиВсего = ТекстЗаметкиВсего + Символы.ПС + Символы.ПС;
		КонецЕсли;
		ТекстЗаметкиВсего = ТекстЗаметкиВсего + Renault_АвтосервисСерверСинхрСПланшетом.ПолучитьПоследниеТриКомментарияVOC(BIR,VIN);
	КонецЕсли;
	// ++
	
	Возврат ТекстЗаметкиВсего;
	
КонецФункции

Функция Renault_ПолучитьДолгКлиента(Контрагент) Экспорт
	
	СтруктураОтбора = Новый Структура("Контрагент",Контрагент);
		МоментВремени = Новый МоментВремени(КонецДня(ТекущаяДата()));
		тзДолги=РегистрыНакопления.ВзаиморасчетыКомпании.Остатки(МоментВремени,СтруктураОтбора,,"Сумма");
		ВыводимСумму=Формат(тзДолги.Итог("Сумма"),"ЧДЦ=2");
		Если ПустаяСтрока(ВыводимСумму) Тогда
			Возврат "Текущий долг составляет: 0 ";
		Иначе
			Возврат "Текущий долг составляет: "+Формат(тзДолги.Итог("Сумма"),"ЧДЦ=2");
		КонецЕсли;
	
КонецФункции

