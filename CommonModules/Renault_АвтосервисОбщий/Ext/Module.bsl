	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ВидДоговора = Перечисления.ВидыДоговоров.Продажа;
	ДопПараметры.Вставить("ВидДоговора", ВидДоговора);
	
	Договор = дкПолучитьДоговорВзаиморасчетов(Контрагент, ВидДоговора, , ДопПараметры, Ложь);  
	
	Возврат Договор;
	
КонецФункции

Процедура Renault_ПроверкаКорректностиVINПередЗаписью(Источник, Отказ) Экспорт
	
	Если РольДоступна("Renault_ОтключитьКонтрольЗаполненияVIN") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	
	Если НЕ Источник.ЭтоГруппа И (ЗначениеЗаполнено(Источник.VIN) И СтрДлина(Источник.VIN) < 13 И НЕ Источник.VIN = "ОТСУТСТВУЕТ") Тогда
		
		Сообщить("Необходимо указать VIN, длиной не менее 13 символов.");
		
		Отказ = Истина;
	
	КонецЕсли;
	
	
КонецПроцедуры

Процедура DMS_ЗаписьПодразделенияЦехаПриЗаписи(Источник, Отказ) Экспорт
	
	#Если Клиент Тогда
	
	ИсточникСсылка = Источник.Ссылка;
	ОпределениеДЦВЗН = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.ОпределениеДЦВЗН;
	
	Если ОпределениеДЦВЗН = 0 И ТипЗнч(Источник) = Тип("СправочникОбъект.ПодразделенияКомпании") Тогда
		
		Запрос = Новый Запрос;
