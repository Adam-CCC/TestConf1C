Функция ПолучитьДанныеКонтрагентаНаСервере(Контрагент) Экспорт
	
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("EMail",Renault_CRM.ПолучитьЕмаилКлиент(Контрагент));
	СтруктураДанных.Вставить("Телефон",Renault_CRM.ПолучитьТелефонКлиент(Контрагент));
	СтруктураДанных.Вставить("Адрес",Renault_CRM.ПолучитьАдресКлиент(Контрагент));
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция Renault_ОформитьЖалобу(Клиент, Автомобиль, СуществующаяЖалоба = Неопределено, ПоказыватьДокумент = Истина, Дата = Неопределено) Экспорт

	
		Жалоба = Документы.DMS_ОбращениеКлиента.СоздатьДокумент();
		Жалоба.Контрагент = Клиент; 
		Жалоба.ТипКлиента = Перечисления.Renault_ТипыКлиентов.РозничныйКлиент; 
		Жалоба.Автомобиль = Автомобиль;
		Жалоба.КомплектацияАвто = Автомобиль.ВариантКомплектации;
		Жалоба.ПричинаОбращения = "";
		Жалоба.Дата = ТекущаяДата();
		Жалоба.ДатаОбращенияВДЦ = ?(Дата = Неопределено, '00010101', Дата);
		Жалоба.ГосНомер = Renault_АвтосервисОбщий.Renault_ПолучитьГосНомер(Автомобиль);
		Жалоба.Модель = Автомобиль.Модель;
		Жалоба.VIN = Автомобиль.VIN;
		Жалоба.EMail = Renault_CRM.ПолучитьЕмаилКлиент(Клиент);
		Жалоба.Телефон = Renault_CRM.ПолучитьТелефонКлиент(Клиент);
		Жалоба.Пробег = Renault_АвтосервисОбщий.Renault_ПолучитьПробег(Автомобиль);
		
		НоваяСтрока = Жалоба.ДействияПоОбращению.Добавить();
		НоваяСтрока.Действие = Справочники.DMS_ДействияПоОбращениям.НазначитьИсполнителя;
		НоваяСтрока.ДатаПланируемая = ТекущаяДата();
		
		Если ПоказыватьДокумент Тогда
		
		Попытка
			
			Жалоба.Записать(РежимЗаписиДокумента.Запись);
			
			#Если Клиент Тогда
				
				//pu0XXXX+
				ОткрытьЗначение(Жалоба.Ссылка);
				
				//Форма = ПолучитьФорму("Документ.DMS_ОбращениеКлиента.Форма.ФормаДокументаУпр");
				//Докма = ДанныеФормыВЗначение(Форма.Объект,Тип("ДокументОбъект.DMS_ОбращениеКлиента"));
				//ЗаполнитьЗначенияСвойств(Докма,Жалоба);
				//ЗначениеВДанныеФормы (Жалоба,Форма.Объект);
				//Форма.ОткрытьМодально();
				//
				//Жалоба = ДанныеФормыВЗначение(Форма.Объект, Тип("ДокументОбъект.DMS_ОбращениеКлиента"));
					
			
			#КонецЕсли
			
			Возврат Жалоба.Ссылка;
			
		Исключение
			
			#Если Клиент Тогда
						
				//ПараметрыФормы = Новый Структура("Ключ", Жалоба);
				//ПараметрыФормы.Вставить("Контрагент", Клиент);
				//ПараметрыФормы.Вставить("Автомобиль", Автомобиль);
				//		
				//ОткрытьФорму("Документ.DMS_ОбращениеКлиента.Форма.ФормаДокументаУпр", ПараметрыФормы);
				//
				Форма = ПолучитьФорму("Документ.DMS_ОбращениеКлиента.Форма.ФормаДокументаУпр");
				Докма = ДанныеФормыВЗначение(Форма.Объект,Тип("ДокументОбъект.DMS_ОбращениеКлиента"));
				ЗаполнитьЗначенияСвойств(Докма,Жалоба);
				ЗначениеВДанныеФормы (Жалоба,Форма.Объект);
				Форма.ОткрытьМодально();
				
				Жалоба = ДанныеФормыВЗначение(Форма.Объект, Тип("ДокументОбъект.DMS_ОбращениеКлиента"));
								
			#КонецЕсли
			
			Если НЕ Жалоба.ЭтоНовый() тогда
				
				Возврат Жалоба.Ссылка;
				
			Иначе
				
				Возврат Неопределено;
				
			КонецЕсли;
			
		КонецПопытки;
		
	Иначе
		
		Попытка
			
			Жалоба.Записать(РежимЗаписиДокумента.Запись);
			
			Возврат Жалоба.Ссылка;
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;

			
КонецФункции

Функция НайтиКонтрагентаПоТелефону(Телефон) Экспорт
	
	// Текст запроса для построения временной таблицы
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_НормализованныеКонтактыДляПоиска.Объект КАК Контрагент,
	               |	Renault_НормализованныеКонтактыДляПоиска.Данные
	               |ИЗ
	               |	РегистрСведений.Renault_НормализованныеКонтактыДляПоиска КАК Renault_НормализованныеКонтактыДляПоиска
	               |ГДЕ
	               |	Renault_НормализованныеКонтактыДляПоиска.Данные ПОДОБНО &Фрагмент";
	
	Фрагмент = Телефон;
	
	Фрагмент = СтрЗаменить(Фрагмент, "+", "");
	Фрагмент = СтрЗаменить(Фрагмент, "-", "");
	Фрагмент = СтрЗаменить(Фрагмент, ".", "");
	Фрагмент = СтрЗаменить(Фрагмент, "*", "");
	Фрагмент = СтрЗаменить(Фрагмент, " ", "");
	Фрагмент = СтрЗаменить(Фрагмент, "(", "");
	Фрагмент = СтрЗаменить(Фрагмент, ")", "");
	
	Если Найти(Фрагмент, "7") = 1 ИЛИ Найти(Фрагмент, "8") = 1 Тогда
		Фрагмент = Прав(Фрагмент, СтрДлина(Фрагмент) - 1);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Фрагмент", "%" + Фрагмент + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Контрагент;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции
