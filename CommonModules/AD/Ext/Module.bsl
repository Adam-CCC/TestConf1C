
Функция СозадатьAD (Логин, ПарольПользователя, ОрганизационнаяЕдиница, UsGUID="") Экспорт
	
	ПутьОЕ = ПолучитьОргЕдиницуПоGUID (ОрганизационнаяЕдиница);
	
    фРезультат                    = Истина;
	
	Попытка    
		
		ОрганизационнаяЕдиницаОбъект        = ПолучитьCOMОбъект("LDAP://" + ПутьОЕ);
		
		ПользовательAD                      = ОрганизационнаяЕдиницаОбъект.Create("user", "CN=" + Логин);
		ПользовательAD.sAMAccountName       = Логин;
        ПользовательAD.userPrincipalName    = Логин + "@" +"sokolmotors.lan";
		
		ПользовательAD.pwdLastSet           = -1;
        ПользовательAD.description          = Логин;    
		//ПользовательAD.name                 = Логин;    
		ПользовательAD.SetInfo();
		ПользовательAD.SetPassword(ПарольПользователя);
                		
	Исключение
		
		фРезультат    = Ложь;
        ОписаниеОшибки    = ОписаниеОшибки();
		
	КонецПопытки;

       
    Если фРезультат Тогда
		
		ПользовательAD.AccountDisabled = Ложь;
        ПользовательAD.SetInfo();
		
		UsGUID = ПреобразоватьМассивВСтроку(ПользовательAD.objectGUID);

	КонецЕсли;

    Возврат фРезультат;
КонецФункции	

Функция ПреобразоватьSID(objectSid)
    SID    = "S-";
    
    МассивSID    = Новый Массив;
    Для Каждого ЭлементSID Из objectSid Цикл
        МассивSID.Добавить(ЭлементSID);
    КонецЦикла;
    //SID_REVISION
    SID    = SID + Строка(МассивSID[0]) + "-";
    
    КоличествоДашей    = МассивSID[1];
    
    SECURITY_NT_AUTHORITY    = 0;
    Для Инд = 0 По 5 Цикл
        SECURITY_NT_AUTHORITY    = SECURITY_NT_AUTHORITY + МассивSID[2 + Инд] * Pow(2, (5 - Инд) * 8);
    КонецЦикла;
    SID    = SID + Строка(SECURITY_NT_AUTHORITY);
    
    Для Инд = 0 По КоличествоДашей - 1 Цикл
        SID    = SID + "-";
        Даш    = 0;
        Для ИндДаш = 0 По 3 Цикл
            Даш    = Даш + МассивSID[8 + 4 * Инд + ИндДаш] * Pow(2, (ИндДаш) * 8);
        КонецЦикла;
        SID    = SID + Строка(Даш);
    КонецЦикла;
    
    Возврат SID;    
КонецФункции


Функция ПолучитьОргЕдиницуПоGUID (GUID) Экспорт 
	GUIDOb = СтрЗаменить("\"+GUID," ","\")  ;
	
	АДОКоннектор = Новый COMОбъект("ADODB.Connection");
	АДОКоннектор.ConnectionString = "Provider=""ADsDSOObject""";
	АДОКоннектор.Open();
	
	КореньDSE = ПолучитьCOMОбъект("LDAP://RootDSE");
	
	ДоменDNS = КореньDSE.Get("defaultNamingContext");
	
	ТекстЗапроса = "select AdsPath from 'LDAP://"+ДоменDNS+"'  WHERE objectGUID='"+GUIDOb+"'";
	
	ВыборкаАДО = АДОКоннектор.Execute(ТекстЗапроса);
	
	Пока НЕ ВыборкаАДО.EOF Цикл
		
		ПутьОбъекта = ВыборкаАДО.Fields("AdsPath").Value;
		Попытка
			СписокАтрибутов = ПолучитьCOMОбъект(ПутьОбъекта);
			//СписокАтрибутов.GetInfo();
			Возврат СтрЗаменить(ПутьОбъекта,"LDAP://","");
			
		Исключение
			Сообщить(ОписаниеОшибки());
			Возврат "";
		КонецПопытки;
		
		ВыборкаАДО.MoveNext();
	КонецЦикла;
	ВыборкаАДО.Close();
	АДОКоннектор.Close();
	
	
КонецФункции	

Функция ГенераторПароля () Экспорт 
	пароль="";
	ГСЧ=Новый ГенераторСлучайныхЧисел();
	Для сч=1 по 8 Цикл
		слч=ГСЧ.СлучайноеЧисло(97,122);
		Если ((слч % 2) = 0 ) Тогда
			слч=ГСЧ.СлучайноеЧисло(0,9);
			Пароль=пароль+слч;
			Продолжить;
		КонецЕсли;
		Пароль=пароль+Символ(слч);
	КонецЦикла;	
	
	Возврат пароль;
КонецФункции	

Функция ДобавитьПользователяВГруппу(ПолноеИмяГруппыБезопасности,  ПутьПользователяAD, ОписаниеОшибки = "" ) Экспорт
