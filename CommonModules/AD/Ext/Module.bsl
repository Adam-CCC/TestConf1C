    Попытка    
        ГруппаБезопасности            = ПолучитьCOMОбъект("LDAP://" + ПолноеИмяГруппыБезопасности);
        ГруппаБезопасности.Add("LDAP://" + ПутьПользователяAD);
        ГруппаБезопасности.SetInfo();
    Исключение
        фРезультат    = Ложь;
        ОписаниеОшибки    = ОписаниеОшибки();
    КонецПопытки;
    
    Возврат фРезультат;
КонецФункции

