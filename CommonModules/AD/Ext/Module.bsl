Функция ПолучитьСписокГруппУПользователя (GUID) Экспорт 
	МГрупп = Новый Массив;	
	Путь= ПолучитьОргЕдиницуПоGUID (GUID);
	
	АДОКоннектор = Новый COMОбъект("ADODB.Connection");
	АДОКоннектор.ConnectionString = "Provider=""ADsDSOObject""";
	АДОКоннектор.Open();
	
	КореньDSE = ПолучитьCOMОбъект("LDAP://RootDSE");
	
	ДоменDNS = КореньDSE.Get("defaultNamingContext");
	
	ТекстЗапроса = "select AdsPath from 'LDAP://"+ДоменDNS+"'  WHERE member='"+Путь+"'";
	
	ВыборкаАДО = АДОКоннектор.Execute(ТекстЗапроса);
	
	Пока НЕ ВыборкаАДО.EOF Цикл
		
		ПутьОбъекта = ВыборкаАДО.Fields("AdsPath").Value;
		Попытка
			СписокАтрибутов = ПолучитьCOMОбъект(ПутьОбъекта);
			СписокАтрибутов.GetInfo();
			МГрупп.Добавить(ПреобразоватьМассивВСтроку(СписокАтрибутов.objectGUID));
			
		Исключение
			Сообщить(ОписаниеОшибки());
			Возврат "";
		КонецПопытки;
		
		ВыборкаАДО.MoveNext();
	КонецЦикла;
	ВыборкаАДО.Close();
	АДОКоннектор.Close();
	
	Если МГрупп.Количество() = 0 тогда
		Возврат Неопределено;	
	Иначе
		Возврат МГрупп;	
	КонецЕсли;	
КонецФункции	

