Функция DecToHex(Знач _Число)
	
	
	База = 16;
	
	
	Результат = "";
	
	
	Пока _Число <> 0 Цикл
		
		
		Поз =_Число % База;
		
		
		Результат = Сред("0123456789ABCDEF", Поз + 1, 1) + Результат;
		
		
		_Число = Цел(_Число / База);
		
		
	КонецЦикла;
	
	
	Возврат Результат;
	
	
КонецФункции // DecToHex()

Функция СоздатьГруппуИОргСтруктуру(GUID) Экспорт 
	distinguishedName = ПолучитьАтрибут (GUID,"distinguishedName") ;	 
	Если distinguishedName = "" тогда
		Сообщить("Ошибка получение COM объекта");	
	КонецЕсли;	
	
	СписокОЕИГрупп = РазложитьИПривестиКСтандарту(distinguishedName);
	
	ПредпоследняяГруппа = Справочники.Должности.ПустаяСсылка();
	Для Каждого  стр из СписокОЕИГрупп цикл
		OU = СтрЗаменить(стр,"OU=","");
		//ПоискOU = Справочники.Должности.НайтиПоНаименованию(OU);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Должности.Ссылка
		|ИЗ
		|	Справочник.Должности КАК Должности
		|ГДЕ
		|	Должности.Наименование = &Наименование
		|	И Должности.Родитель = &Родитель";
		
		Запрос.УстановитьПараметр("Наименование", OU);
		Запрос.УстановитьПараметр("Родитель", ПредпоследняяГруппа);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если  ВыборкаДетальныеЗаписи.Следующий() тогда
			ПоискOU = ВыборкаДетальныеЗаписи.Ссылка;
		Иначе
			ПоискOU = Справочники.Должности.ПустаяСсылка();
		КонецЕсли;
		
		Если ПоискOU = Справочники.Должности.ПустаяСсылка() тогда 
			GRUPGUID = ПоискGUIDпоOU(OU);
			ПолноеИмя = "";
			ОписаниеОшибки= "";
			ОЕ = Справочники.Должности.СоздатьГруппу();
			ОЕ.УстановитьНовыйКод();
			Если ПредпоследняяГруппа = Справочники.Должности.ДолжностиСоколМоторс тогда
				ОЕ.ПрефиксГорода = OU;
				ОЕ.Наименование = OU;
				
				ОЕ.ПолноеИмя = Ad.ПолучитьОргЕдиницуПоGUID(GRUPGUID);
				ОЕ.АнглискоеНаименование = AD.ПолучитьАтрибутПоGUID(GRUPGUID);
				ОЕ.GRUPGUID = GRUPGUID;
				ОЕ.Родитель = ПредпоследняяГруппа;
			КонецЕсли;
			
			Если ПредпоследняяГруппа <> Справочники.Должности.ДолжностиСоколМоторс тогда
				ОЕ.ПрефиксАвтосалона = OU;
				ОЕ.Наименование = OU;
				
				ОЕ.ПолноеИмя = Ad.ПолучитьОргЕдиницуПоGUID(GRUPGUID);
				ОЕ.АнглискоеНаименование = AD.ПолучитьАтрибутПоGUID(GRUPGUID);
				ОЕ.GRUPGUID = GRUPGUID;
				ОЕ.Родитель = ПредпоследняяГруппа;
				
			КонецЕсли;
			ОЕ.Записать();
			ПоискOU = ОЕ;
		КонецЕсли;	
		
		ПредпоследняяГруппа = ПоискOU;
	КонецЦикла;
	
	
	//GRUPGUID=  "";
	
	ГруппаAD = Справочники.Должности.СоздатьЭлемент();
	OU = ПолучитьАтрибут (GUID,"cn") ;
	
	ГруппаAD.GRUPGUID = ПоискGUIDпоOU(OU);
	
	ГруппаAD.УстановитьНовыйКод();
	ГруппаAD.Родитель = ПредпоследняяГруппа;
	ГруппаAD.ПрефиксГорода = OU;
	ГруппаAD.Наименование = OU;
	//АнглискоеНаименование = ПрефиксГорода;
	Попытка
		ГруппаAD.Псевдоним = ПолучитьАтрибут (GUID,"description");
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;	
	ГруппаAD.ПолноеИмя = Ad.ПолучитьОргЕдиницуПоGUID(ГруппаAD.GRUPGUID);
	ГруппаAD.АнглискоеНаименование = OU;
	ГруппаAD.Записать();
	Возврат ГруппаAD;
	
КонецФункции	 
 
Функция РазложитьИПривестиКСтандарту(Знач Стр, Разделитель = ",") Экспорт
	
	Список = Новый Массив();
	Длина = СтрДлина(Разделитель);
	
	Стр = СокрЛП(Стр);
	Поз = Найти(Стр, Разделитель);
	
	Пока 0 < Поз Цикл
		Список.Добавить(СокрП(Лев(Стр, Поз-1)));
		
		Стр = СокрЛ(Сред(Стр, Поз+Длина));
		Поз = Найти(Стр, Разделитель);
	КонецЦикла;
	
	Список.Добавить(Стр);
	
	СписокOU = Новый Массив;
	Для Каждого стр из Список цикл
		Если  Найти(Стр,"OU=")>0 тогда
			 СписокOU.Добавить(Стр);
		КонецЕсли;	
	КонецЦикла;
	СписокOUсорт = Новый Массив;

	Для н = 0 По СписокOU.Количество()-1 Цикл
	   индекс = СписокOU.Количество() - н - 1;
	   элемент = СписокOU[индекс];
	   СписокOUсорт.Добавить(элемент);
   КонецЦикла;
   
	Возврат СписокOUсорт;
	
КонецФункции //Разложить() 

