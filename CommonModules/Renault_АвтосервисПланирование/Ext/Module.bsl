	|УНИЧТОЖИТЬ ПланОперативный";
	
	Статусы = Новый Массив();
	
	Если НЕ ДилерскийЦентр.Автосервис_НеДвигатьПросроченныеРаботы Тогда
	
		Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПросрочена);
	
	КонецЕсли;
	
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаНачата);
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПауза);
	
	ЗапросПланаОперативного.УстановитьПараметр("Статусы", Статусы);
	ЗапросПланаОперативного.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	ЗапросПланаОперативного.УстановитьПараметр("НачалоДня", НачалоРабочегоДня);
	ЗапросПланаОперативного.УстановитьПараметр("КонецДня", КонецРабочегоДня);
	ЗапросПланаОперативного.УстановитьПараметр("ВТПОСТЫ", ТаблицаМашиномест);
	ЗапросПланаОперативного.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ЗапросПланаОперативного.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	
	ВыборкаПланаОперативного = ЗапросПланаОперативного.Выполнить().Выбрать();
	
	Пока ВыборкаПланаОперативного.Следующий() Цикл
		
		Если ВыборкаПланаОперативного.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена Тогда
			
			ЦветФона = "ЦветПросроченнойРаботы"; //СтруктураЦветов.ЦветПросроченнойРаботы;
			Обращение = ВыборкаПланаОперативного.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			Если ЗначениеЗаполнено(ВыборкаПланаОперативного.РабочийДокумент) Тогда
				Если ТипЗнч(ВыборкаПланаОперативного.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					ЦветФона = "ЦветПросроченнойВыдачи";//СтруктураЦветов.ЦветПросроченнойВыдачи;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ВыборкаПланаОперативного.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаНачата Тогда
			
			ЦветФона = "ЦветАктивнойРаботыПлан"; //СтруктураЦветов.ЦветАктивнойРаботыПлан;
			Обращение = ВыборкаПланаОперативного.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			
		ИначеЕсли ВыборкаПланаОперативного.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПауза Тогда
			
			ЦветФона = "ЦветПриостановленнойРаботы";
			Обращение = ВыборкаПланаОперативного.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			
		Иначе
			
			ЦветФона = "";
			
		КонецЕсли;
		
		
		ВремяНачала = Неопределено;
		ВремяОкончания = Неопределено;
		
		Если ВыборкаПланаОперативного.ВремяНачала < НачалоРабочегоДня Тогда
			
			ВремяНачала = НачалоРабочегоДня;
			
		Иначе
			
			ВремяНачала = ВыборкаПланаОперативного.ВремяНачала;
			
		КонецЕсли;
		
		
		Если ВыборкаПланаОперативного.ВремяОкончания > КонецРабочегоДня Тогда
			
			ВремяОкончания = КонецРабочегоДня;	
			
		Иначе
			
			ВремяОкончания = ВыборкаПланаОперативного.ВремяОкончания
			
		КонецЕсли;
		
		НоваяСтрока = ТаблицаЗакраска.Добавить();
		
		Если ОкрашиватьДругимиПользователями Тогда
			
			НоваяСтрока.Цвет = Renault_ОкраситьДругимПользователем(ЦветФона, ВыборкаПланаОперативного.РабочийДокумент, ПользовательПоУмолчанию);
			
		Иначе
		
			НоваяСтрока.Цвет = ЦветФона;
		
		КонецЕсли;

		
		НоваяСтрока.Цех = ВыборкаПланаОперативного.НомерПоста;
		НоваяСтрока.ВремяНачала = ВремяНачала;
		//НоваяСтрока.ВремяОкончания = ВремяОкончания;
		ИнтерваловСНачалаДня = (ВремяОкончания - НачалоРабочегоДня) / (ШагПланирования * 60);
		Если Цел(ИнтерваловСНачалаДня) <> ИнтерваловСНачалаДня Тогда
			ИнтерваловСНачалаДня = Цел(ИнтерваловСНачалаДня) + 1;
		КонецЕсли;
		ВремяОкончания = НачалоРабочегоДня + ИнтерваловСНачалаДня * (ШагПланирования * 60);
		НоваяСтрока.ВремяОкончания = ВремяОкончания;
		НоваяСтрока.Обращение = Обращение;
		НоваяСтрока.РабочийДокумент = ВыборкаПланаОперативного.РабочийДокумент;
		НоваяСтрока.Узор = Узор;
		НоваяСтрока.Клиент = ВыборкаПланаОперативного.Клиент;
		НоваяСтрока.Жалоба = ВыборкаПланаОперативного.Жалоба;
		НоваяСтрока.Модель = ВыборкаПланаОперативного.Модель;
		НоваяСтрока.Примечание = ВыборкаПланаОперативного.Примечание;
		НоваяСтрока.ЭтапРабот = ВыборкаПланаОперативного.ЭтапРабот;
		НоваяСтрока.ВремяНачалаРег = ВыборкаПланаОперативного.ВремяНачала;
		НоваяСтрока.ВремяОкончанияРег = ВыборкаПланаОперативного.ВремяОкончания;
		НоваяСтрока.Статус = ВыборкаПланаОперативного.СтатусРаботы;
		НоваяСтрока.ТипПаузы = ВыборкаПланаОперативного.ТипПаузы;
		НоваяСтрока.ГосНомер = ВыборкаПланаОперативного.ГосНомер;
		
	КонецЦикла;
	
	
	ЗапросФактаОперативного = Новый Запрос();
	ЗапросФактаОперативного.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросФактаОперативного.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисФактОперативныйСрезПоследних.Период,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.ДилерскийЦентр КАК ДилерскийЦентр,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.Обращение КАК Обращение,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.РабочийДокумент КАК РабочийДокумент,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.ЭтапРабот КАК ЭтапРабот,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.Цех КАК Цех,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.Авторабота,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.ВремяНачала,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.ВремяОкончания
	|ПОМЕСТИТЬ Renault_АвтосервисФактОперативный
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисФактОперативный.СрезПоследних(
	|			,
	|			ВремяНачала >= &НачалоДня
	|					И ВремяНачала <= &КонецДня
	|				ИЛИ ВремяНачала <= &НачалоДня
	|					И ВремяОкончания >= &НачалоДня
	|				ИЛИ ВремяНачала <= &НачалоДня
	|					И ВремяОкончания >= &КонецДня) КАК Renault_АвтосервисФактОперативныйСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДилерскийЦентр,
	|	РабочийДокумент,
	|	Обращение,
	|	Цех,
	|	ЭтапРабот
	|;
