	ЕстьПересечения = ЛОЖЬ;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатусыРаботАвтосервиса.ДилерскийЦентр КАК ДилерскийЦентр,
	|	СтатусыРаботАвтосервиса.РабочийДокумент КАК РабочийДокумент,
	|	СтатусыРаботАвтосервиса.Цех КАК Цех,
	|	СтатусыРаботАвтосервиса.ЭтапРабот КАК ЭтапРабот,
	|	СтатусыРаботАвтосервиса.СтатусРаботы КАК СтатусРаботы,
	|	ЕСТЬNULL(ПланРаботАвтосервиса.Длительность, 0) КАК Длительность,
	|	ЕСТЬNULL(ПланРаботАвтосервиса.ВремяНачала, ДАТАВРЕМЯ(1, 1, 1)) КАК ВремяНачалаПлан,
	|	ЕСТЬNULL(ПланРаботАвтосервиса.ВремяОкончания, ДАТАВРЕМЯ(1, 1, 1)) КАК ВремяОкончанияПлан,
	|	ЕСТЬNULL(ПланОперативныйАвтосервиса.ВремяНачала, ДАТАВРЕМЯ(1, 1, 1)) КАК ВремяНачала,
	|	ЕСТЬNULL(ПланОперативныйАвтосервиса.ВремяОкончания, ДАТАВРЕМЯ(1, 1, 1)) КАК ВремяОкончания,
	|	ВЫБОР
	|		КОГДА СтатусыРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисОбед
	|				ИЛИ СтатусыРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПростой
	|				ИЛИ СтатусыРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПрочаяЗанятость
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПропуститьОбход
	|ПОМЕСТИТЬ ТаблицаДанных
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних(
	|			&ТекущаяДата,
	|			РабочийДокумент <> &РабочийДокумент
	|				И ВЫБОР
	|					КОГДА &ЭтапРАБОТ <> ""1""
	|						ТОГДА ЭтапРабот <> &ЭтапРабот
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК СтатусыРаботАвтосервиса
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланРабот КАК ПланРаботАвтосервиса
	|		ПО СтатусыРаботАвтосервиса.ДилерскийЦентр = ПланРаботАвтосервиса.ДилерскийЦентр
	|			И СтатусыРаботАвтосервиса.Обращение = ПланРаботАвтосервиса.Обращение
	|			И СтатусыРаботАвтосервиса.РабочийДокумент = ПланРаботАвтосервиса.РабочийДокумент
	|			И СтатусыРаботАвтосервиса.Цех = ПланРаботАвтосервиса.Цех
	|			И СтатусыРаботАвтосервиса.ЭтапРабот = ПланРаботАвтосервиса.ЭтапРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланОперативный.СрезПоследних КАК ПланОперативныйАвтосервиса
	|		ПО СтатусыРаботАвтосервиса.ДилерскийЦентр = ПланОперативныйАвтосервиса.ДилерскийЦентр
	|			И СтатусыРаботАвтосервиса.Обращение = ПланОперативныйАвтосервиса.Обращение
	|			И СтатусыРаботАвтосервиса.РабочийДокумент = ПланОперативныйАвтосервиса.РабочийДокумент
	|			И СтатусыРаботАвтосервиса.ЭтапРабот = ПланОперативныйАвтосервиса.ЭтапРабот
	|			И СтатусыРаботАвтосервиса.Цех = ПланОперативныйАвтосервиса.Цех
	|ГДЕ
	|	ПланРаботАвтосервиса.ВремяНачала >= &НачалоДня
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	РабочийДокумент,
