		//	ИЛИ ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_АвтосервисПрочаяЗанятость") Тогда
		//	
		//	Продолжить;
		//	
		//КонецЕсли;
		
