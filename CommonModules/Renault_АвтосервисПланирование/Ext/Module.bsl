Функция ПолучитьСтатусЭтапа(Док, Этап) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|ГДЕ
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент = &РабочийДокумент
	|	И Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот = &ЭтапРабот";
	
	Запрос.УстановитьПараметр("РабочийДокумент", Док.Ссылка);
	Запрос.УстановитьПараметр("ЭтапРабот", Этап);
	
	Статусы = Запрос.Выполнить().Выгрузить();
	
	Если Статусы.Количество() > 0 Тогда
		
		СтатусЭтапа = Статусы[0].СтатусРаботы;
		
	КонецЕсли;
	
	Возврат СтатусЭтапа;
	
КонецФункции

Функция ДатаВходитВИнтервал(Дата, НачалоИнтервала, КонецИнтервала)
	
	Возврат (Дата >= НачалоИнтервала И Дата <= КонецИнтервала);
	
КонецФункции

Функция ДатаПередИнтервалом(Дата, НачалоИнтервала, КонецИнтервала)
	
	Возврат (Дата < НачалоИнтервала);
	
КонецФункции

Функция ДатаПослеИнтервала(Дата, НачалоИнтервала, КонецИнтервала)
	
	Возврат (Дата > КонецИнтервала);
	
КонецФункции

Функция ЗапланироватьЭтап(ДокОбъект, Этап, ВремяНачала, Цех , НачалоРабочегоДня, КонецРабочегоДня)
	
	Ошибка = "";
	
	ТекущийКонецРабочегоДня = КонецРабочегоДня;
	ТекущееНачалоРабочегоДня = НачалоРабочегоДня;
	
	СтрокаЭтапа = Этап;
	
	Если СтрокаЭтапа.ДлительностьЭтапаПлан = 0 Тогда
		
		Ошибка = "Нельзя запланировать этап без длительности.";
		Возврат Ошибка;
		
	КонецЕсли;
	
	СтрокаЭтапа.Цех = Цех;
	СтрокаЭтапа.НачалоЭтапа = ВремяНачала;
	
	ВремяОкончания = ВремяНачала + СтрокаЭтапа.ДлительностьЭтапаПлан * 3600;
	Пока ВремяОкончания > ТекущийКонецРабочегоДня Цикл
		
		ПереносимаяЧасть = ВремяОкончания - ТекущийКонецРабочегоДня;
		ВремяОкончания = ТекущееНачалоРабочегоДня + 86400 + ПереносимаяЧасть;
		ЭтоРаботыСледующегоДня = Истина;
		ВремяПредыдущихРабот = ПереносимаяЧасть;
		ВремяНачалаРаботы = ТекущееНачалоРабочегоДня + 86400;
		
		ТекущееНачалоРабочегоДня = ТекущееНачалоРабочегоДня + 86400;
		ТекущийКонецРабочегоДня = ТекущийКонецРабочегоДня + 86400;
		
	КонецЦикла;
	СтрокаЭтапа.КонецЭтапа = ВремяОкончания;
	
	Если ПроверитьНакладки(ВремяНачала, ВремяОкончания, Цех, ДокОбъект.Ссылка, Этап.IDЭтапа, ЛОЖЬ) Тогда
		
		СтрокаЭтапа.Цех = Справочники.Renault_CRM_МашиноместаВЦеху.ПустаяСсылка();
		СтрокаЭтапа.НачалоЭтапа = '00010101';
		СтрокаЭтапа.КонецЭтапа = '00010101';
		
		Ошибка = "Возможны накладки в планировании. Перепланируйте этап или работы.";
		
	Иначе
		
		ЗаписатьЭтапВрегистр(ДокОбъект, Этап, Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);
		
		ДокОбъект.Записать();
		
	КонецЕсли;
	
	Возврат Ошибка;
	
КонецФункции

Процедура ОчиститьПланПоЭтапу(ДокОбъект, Этап)
	
	Если ТипЗнч(Этап) = Тип("Строка") Тогда
		
		IDЭтапа = Этап;
		
	Иначе
		
		IDЭтапа = Этап.IDЭтапа;
		
	КонецЕсли;
	
	ОтборПлана = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьНаборЗаписей();
	
	ОтборПлана.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
	ОтборПлана.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборПлана.Прочитать();
	ОтборПлана.Очистить();
	ОтборПлана.Записать();
	
	//{ до вставки данного блока все работало
	ОтборПлана = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
	ОтборПлана.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
	ОтборПлана.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборПлана.Прочитать();
	ОтборПлана.Очистить();
	ОтборПлана.Записать();
	//} до вставки данного блока все работало
	
	ОтборСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
	ОтборСтатуса.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
	ОтборСтатуса.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборСтатуса.Прочитать();
	ОтборСтатуса.Очистить();
	ОтборСтатуса.Записать();
	
КонецПроцедуры

Процедура ЗаписатьЭтапВрегистр(ДокОбъект, Этап, Статус)
	
	Если ЗначениеЗаполнено(Этап.НачалоЭтапа) и ЗначениеЗаполнено(Этап.КонецЭтапа) и Этап.ДлительностьЭтапаПлан > 0  Тогда
		
		ОчиститьПланПоЭтапу(ДокОбъект, Этап);
		
		Запись = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьМенеджерЗаписи();
		Запись.Обращение = ДокОбъект.Обращение;
		Запись.РабочийДокумент = ДокОбъект.Ссылка;
		Запись.ДилерскийЦентр = ДокОбъект.ДилерскийЦентр;
		Запись.Длительность = Этап.ДлительностьЭтапаПлан;
		Запись.ВремяНачала = Этап.НачалоЭтапа;
		Запись.ВремяОкончания = Этап.КонецЭтапа;
		Запись.ЭтапРабот = Этап.IDЭтапа;
		Запись.Цех = Этап.Цех;
		
		Этап.СтатусЭтапа = Статус;
		
		Запись.Записать();
		
		ЗаписьПлана = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьПлана, Запись);
		ЗаписьПлана.Период = ТекущаяДата();
		ЗаписьПлана.Записать();
		
		ОбновитьСтатусЭтапаВрегистре(ДокОбъект, Этап);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьСтатусЭтапаВрегистре(ДокОбъект, Этап)
	
	ЗаписьСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
	ЗаписьСтатуса.РабочийДокумент = ДокОбъект.Ссылка;
	ЗаписьСтатуса.Период = ТекущаяДата();
	ЗаписьСтатуса.Обращение = ДокОбъект.Обращение;
	ЗаписьСтатуса.ДилерскийЦентр = ДокОбъект.ДилерскийЦентр;
	ЗаписьСтатуса.ЭтапРабот = Этап.IDЭтапа;
	ЗаписьСтатуса.Цех = Этап.Цех;
	ЗаписьСтатуса.СтатусРаботы = Этап.СтатусЭтапа;
	
	Если ЗначениеЗаполнено(ЗаписьСтатуса.СтатусРаботы) Тогда
		
		ЗаписьСтатуса.Записать();
		
	КонецЕсли;
	
	Если Этап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена Тогда
		Набор = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		Набор.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
		Набор.Отбор.Обращение.Установить(ДокОбъект.Обращение);
		Набор.Отбор.ДилерскийЦентр.Установить(ДокОбъект.ДилерскийЦентр);
		Набор.Отбор.ЭтапРабот.Установить(Этап.IDЭтапа);
		Набор.Отбор.Цех.Установить(Этап.Цех);
		//Набор.Отбор.Авторабота.Установить(Этап.СтатусЭтапа);
		Набор.Прочитать();
		Набор.Очистить();
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ВОдинЭтап(ДокОбъект)
	
	Для Каждого СтрокаЭтапа ИЗ ДокОбъект.Этапы Цикл
		ОчиститьПланПоЭтапу(ДокОбъект, СтрокаЭтапа.IDЭтапа);
	КонецЦикла;
	
	ДокОбъект.Этапы.Очистить();
	
	НовыйЭтап = ДокОбъект.Этапы.Добавить();
	
	НовыйЭтап.Этап = "Этап 1";
	НовыйЭтап.IDЭтапа = Новый УникальныйИдентификатор();
	
	ДокОбъект.СоставЭтапа.Очистить();
	
	Длительность = 0;
	
	Для Каждого Работа из ДокОбъект.Работы Цикл
		
		НовыйСостав = ДокОбъект.СоставЭтапа.Добавить();
		Длительность = Длительность + Работа.Длительность;
		
		НовыйСостав.IDЭтапа = НовыйЭтап.IDЭтапа;
		
		НовыйСостав.Работа = Работа.Работа;
		
		Если НЕ ЗначениеЗаполнено(Работа.IDРаботы) Тогда
			
			Работа.IDРаботы = Новый УникальныйИдентификатор();
			
		КонецЕсли;
		
		НовыйСостав.IDРаботы = Работа.IDРаботы;
		
	КонецЦикла;
	
	НовыйЭтап.ДлительностьЭтапаПлан = Длительность;
	
	ДокОбъект.Записать();
	
//	ОбновитьДанныеЗаказНаряд_Прототип(ДокОбъект.Ссылка);
	
КонецПроцедуры

Функция ВыполнитьПланирование(Параметры, 
	Машиноместо, 
	ДилерскийЦентр, 
	ВидСобытия, 
	Обращение, 
	ЖелаемоеВремя = Неопределено, 
	НачалоРабочегоДня = Неопределено, КонецРабочегоДня = Неопределено, Ошибка = "", ТолькоРаботающие = ЛОЖЬ, ВсеПроверки = Ложь) Экспорт
	
	Клиент = Обращение.Клиент;
	
	НеобходимПереносНаСледующийДень = Ложь;
	ДокументСоздан = Ложь;
	ДлительностьДокумента = 0;
	//НачалоОбласти = Область;
	ДлительностьРаботы = Параметры.Длительность; // pu02028 #0001
	
	ДлительностьПоУмолчаниюВыдача = ДилерскийЦентр.ДлительностьВыдачи * 60;
	
	Если ТипЗнч(Параметры.Ссылка) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") И Параметры.Ссылка.Интерактивная Тогда
		ДлительностьПоУмолчаниюПриемка = ДилерскийЦентр.ДлительностьПриемки * 2 * 60;
	Иначе	
		ДлительностьПоУмолчаниюПриемка = ДилерскийЦентр.ДлительностьПриемки * 60;
	КонецЕсли;
	
	ШагПланирования = ДилерскийЦентр.АвтосервисШагПланирования;
	
	Если ЗначениеЗаполнено(ЖелаемоеВремя) Тогда
		
		ВремяНачалаРаботы = ЖелаемоеВремя;
		
	Иначе
		
		Ошибка = "Не указано время начала работы";
		Возврат Ложь;
		//ВремяНачалаРаботы = НачалоРабочегоДня + (ШагПланирования * 60) * (ПерваяКолонка-3);
		
	КонецЕсли;
	
	Если ВремяНачалаРаботы < ТекущаяДата() Тогда
		Ошибка  = "Нельзя назначить работу на прошлое время!";
		Возврат Ложь;
	КонецЕсли;
		
	ВремяОкончанияРаботы = ВремяНачалаРаботы + Параметры.Длительность * 3600;
	Если ВремяОкончанияРаботы > КонецРабочегоДня Тогда
		НеобходимПереносНаСледующийДень = Истина;
	КонецЕсли;
	
	ВидМашиноместа = ТипЗнч(Машиноместо);
		
	Если ТолькоРаботающие Тогда
		
		Если ВидМашиноместа = Тип("СправочникСсылка.Цеха") Тогда
			
			ТЗГрафик = Renault_АвтосервисОбщий.Renault_ПолучитьИсполнителейЗаПериод(НачалоРабочегоДня, КонецРабочегоДня, Неопределено, Машиноместо);
			
			//Проверим входит ли планируемый отрезок целиком в рабочий интервал
			ОК = Ложь;
			Для Каждого СтрокаЗанятости ИЗ ТЗГрафик Цикл
				Если ДатаВходитВИнтервал(ВремяНачалаРаботы, СтрокаЗанятости.НачалоРаботы, СтрокаЗанятости.КонецРаботы) И
					ДатаВходитВИнтервал(?(ВремяОкончанияРаботы > КонецРабочегоДня, КонецРабочегоДня, ВремяОкончанияРаботы), СтрокаЗанятости.НачалоРаботы, СтрокаЗанятости.КонецРаботы) Тогда
					ОК = Истина;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ОК Тогда
				#Если Клиент Тогда
				
					Ответ = Вопрос("Данный отрезок времени помечен, как нерабочий. Продолжить?", РежимДиалогаВопрос.ДаНет);
					Если Ответ = КодВозвратаДиалога.Нет Тогда
						ОтказВПерепланировании = Истина;
						Возврат Ложь;
					КонецЕсли;
				
				#Иначе
				
					 Ошибка = "Данный отрезок времени помечен, как нерабочий"; 
				 
					 Возврат Ложь;
				#КонецЕсли
				
			КонецЕсли;
			
		ИначеЕсли ВидМашиноместа = Тип("СправочникСсылка.Сотрудники") Тогда
			
			ТЗГрафик = Renault_АвтосервисОбщий.Renault_ПолучитьИсполнителейЗаПериод(НачалоРабочегоДня, КонецРабочегоДня, Машиноместо, Неопределено);
			
			//Проверим входит ли планируемый отрезок целиком в рабочий интервал
			ОК = Ложь;
			Для Каждого СтрокаЗанятости ИЗ ТЗГрафик Цикл
				Если ДатаВходитВИнтервал(ВремяНачалаРаботы, СтрокаЗанятости.НачалоРаботы, СтрокаЗанятости.КонецРаботы) И
					ДатаВходитВИнтервал(?(ВремяОкончанияРаботы > КонецРабочегоДня, КонецРабочегоДня, ВремяОкончанияРаботы), СтрокаЗанятости.НачалоРаботы, СтрокаЗанятости.КонецРаботы) Тогда
					ОК = Истина;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ОК Тогда
				#Если Клиент Тогда
				
					Ответ = Вопрос("Данный отрезок времени помечен, как нерабочий. Продолжить?", РежимДиалогаВопрос.ДаНет);
					Если Ответ = КодВозвратаДиалога.Нет Тогда
						ОтказВПерепланировании = Истина;
						Возврат Ложь;
					КонецЕсли;
				
				#Иначе
				
					 Ошибка = "Данный отрезок времени помечен, как нерабочий"; 
				 
					 Возврат Ложь;
				#КонецЕсли
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЕстьДокумент = Ложь;
	//Если ПараметрыПеретаскивания.Значение.Владелец().Колонки.Найти("Ссылка") <> Неопределено Тогда
	Если ЗначениеЗаполнено(Параметры.Ссылка) Тогда
		ЕстьДокумент = Истина;
	КонецЕсли;
	//КонецЕсли;
	
	//// Планируем мойку
	Если ВидСобытия = Перечисления.CRM_ВидыСобытийАвтоСервиса.МойкаАвто И ВидМашиноместа = Тип("СправочникСсылка.Renault_CRM_Мойки") Тогда//ВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.Мойка Тогда
		
		Если НеобходимПереносНаСледующийДень Тогда
			Ошибка = "Разбитие мойки на несколько рабочих дней не поддерживается.";
			ОтказВПерепланировании = Истина;
			Возврат Ложь;
		КонецЕсли;
		
		ДлительностьМойки = 600/3600;
		
		Если ЕстьДокумент = Истина Тогда
			НовыйДокумент = Параметры.Ссылка.ПолучитьОбъект();
			
			Отбор = Новый Структура();
			Отбор.Вставить("Обращение", Обращение);
			Отбор.Вставить("РабочийДокумент", НовыйДокумент.Ссылка);
			
			ПоследнийСтатус = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних().НайтиСтроки(Отбор);
			
			//Если  Тогда
			
			Если ЗначениеЗаполнено(ПоследнийСтатус) И
				(ПоследнийСтатус[0].СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена или 
				ПоследнийСтатус[0].СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаНачата или
				ПоследнийСтатус[0].СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПауза) Тогда
				
				Ошибка = "Планирование возможно только для запланированной мойки.";
				ОтказВПерепланировании = Истина;
				Возврат Ложь;
				
			КонецЕсли;
			//КонецЕсли;
			
			ДлительностьМойки = НовыйДокумент.Длительность;
			Если НЕ НовыйДокумент.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка Тогда
				Ошибка = "Планирование недоступно для документа!";
				Возврат Ложь; // планинг только для заявок
			Иначе
				НаборПлан = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
				НаборПлан.Отбор.РабочийДокумент.Установить(НовыйДокумент.Ссылка);
				НаборПлан.Прочитать();
				НаборПлан.Очистить();
				НаборПлан.Записать();
			КонецЕсли;
		Иначе
			НовыйДокумент = Документы.Renault_CRM_ЗаявкаНаМойку.СоздатьДокумент();
			НовыйДокумент.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
			НовыйДокумент.Обращение = Обращение;
		КонецЕсли;
		
		//Проверим наличие оформленной приемки
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_CRM_ПриемкаАвтомобиля.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		|ГДЕ
		|	Renault_CRM_ПриемкаАвтомобиля.Обращение = &Обращение
		|	И Renault_CRM_ПриемкаАвтомобиля.ВремяНачала <> &ПустаяДата
		|	И Renault_CRM_ПриемкаАвтомобиля.ВремяОкончания <= &ВремяНачалаРаботы";
		Запрос.УстановитьПараметр("Обращение", Обращение);
		Запрос.УстановитьПараметр("ВремяНачалаРаботы", ВремяНачалаРаботы);
		Запрос.УстановитьПараметр("ПустаяДата", '00010101');
