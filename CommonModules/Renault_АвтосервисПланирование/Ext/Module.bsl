			КонецЕсли;
			
			ЗапросПрошлых = Новый Запрос;
			ЗапросПрошлых.УстановитьПараметр("Документ", 			РабочийДокумент);
			ЗапросПрошлых.УстановитьПараметр("ДокументПересечение", Выборка.РабочийДокумент);
