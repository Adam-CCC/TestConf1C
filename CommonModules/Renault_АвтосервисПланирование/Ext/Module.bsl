	             |			ТОГДА ЗП.РабочийДокумент
	             |		КОГДА ЗП.СтатусРаботы = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаПростой)
	             |			ТОГДА ЗП.РабочийДокумент
	             |		КОГДА ЗП.СтатусРаботы = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаПрочаяЗанятость)
	             |			ТОГДА ЗП.РабочийДокумент
	             |		ИНАЧЕ ЗП.Обращение
	             |	КОНЕЦ КАК Обращение,
	             |	ВЫБОР
	             |		КОГДА ЗП.СтатусРаботы = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаОбед)
	             |			ТОГДА ""ЦветРаботыОбед""
	             |		КОГДА ЗП.СтатусРаботы = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаПростой)
	             |			ТОГДА ""ЦветРаботыПростой""
	             |		КОГДА ЗП.СтатусРаботы = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаПрочаяЗанятость)
	             |			ТОГДА ""ЦветРаботыПростой""
	             |		КОГДА ЗП.СтатусРаботы = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаЗапланирована)
	             |			ТОГДА ВЫБОР
	             |					КОГДА ЗП.РабочийДокумент ССЫЛКА Документ.Renault_CRM_ВыдачаАвтомобиля
	             |						ТОГДА ""ЦветЗапланированнойВыдачи""
	             |					ИНАЧЕ ""ЦветЗапланированнойРаботы""
