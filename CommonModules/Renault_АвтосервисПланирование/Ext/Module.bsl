	|	АвтомобилиСрезПоследних.Значение КАК ГосНомер,
	|	Renault_АвтосервисФактОперативный.Обращение.Жалоба КАК Жалоба
	|ИЗ
	|	Renault_АвтосервисФактОперативный КАК Renault_АвтосервисФактОперативный
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних(
	|				,
	|				Обращение В
	|					(ВЫБРАТЬ
	|						Renault_АвтосервисФактОперативный.Обращение
	|					ИЗ
	|						Renault_АвтосервисФактОперативный)) КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО Renault_АвтосервисФактОперативный.ДилерскийЦентр = Renault_АвтосервисСтатусыРаботСрезПоследних.ДилерскийЦентр
	|			И Renault_АвтосервисФактОперативный.Обращение = Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение
	|			И Renault_АвтосервисФактОперативный.РабочийДокумент = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|			И Renault_АвтосервисФактОперативный.ЭтапРабот = Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот
	|			И Renault_АвтосервисФактОперативный.Цех = Renault_АвтосервисСтатусыРаботСрезПоследних.Цех
	|		ЛЕВОЕ СОЕДИНЕНИЕ вт_Посты КАК вт_ПОСТЫ
	|		ПО Renault_АвтосервисФактОперативный.Цех = вт_ПОСТЫ.Машиноместо
	|			И (Renault_АвтосервисФактОперативный.ДилерскийЦентр = &ДилерскийЦентр)
	|			И (Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы = &Завершена
	|				ИЛИ Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы = &ВРаботе
	|				ИЛИ Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы = &Пауза)
	|			И (Renault_АвтосервисФактОперативный.ВремяНачала >= &НачалоДня
	|					И Renault_АвтосервисФактОперативный.ВремяНачала <= &КонецДня
	|				ИЛИ Renault_АвтосервисФактОперативный.ВремяНачала <= &НачалоДня
	|					И Renault_АвтосервисФактОперативный.ВремяОкончания >= &НачалоДня
	|				ИЛИ Renault_АвтосервисФактОперативный.ВремяНачала <= &НачалоДня
	|					И Renault_АвтосервисФактОперативный.ВремяОкончания >= &КонецДня)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&НачалоДня) КАК АвтомобилиСрезПоследних
	|		ПО АвтомобилиСрезПоследних.Автомобиль = Renault_АвтосервисФактОперативный.Обращение.Автомобиль
	|			И АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения
	|ГДЕ
	|	НЕ вт_ПОСТЫ.НомерПоста ЕСТЬ NULL
	|{УПОРЯДОЧИТЬ ПО
	|	ВремяОкончания}";
	
	ЗапросФактаОперативного.УстановитьПараметр("Завершена", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	ЗапросФактаОперативного.УстановитьПараметр("ВРаботе", Справочники.Renault_СтатусыАвторабот.РаботаНачата);
	ЗапросФактаОперативного.УстановитьПараметр("Пауза", Справочники.Renault_СтатусыАвторабот.РаботаПауза);
	ЗапросФактаОперативного.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	
	ЗапросФактаОперативного.УстановитьПараметр("НачалоДня", НачалоРабочегоДня);
	ЗапросФактаОперативного.УстановитьПараметр("КонецДня", КонецРабочегоДня);
	
	ЗапросФактаОперативного.УстановитьПараметр("ВТПОСТЫ", ТаблицаМашиномест);
	
	ЗапросФактаОперативного.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	
	ВыборкаФактаОперативного = ЗапросФактаОперативного.Выполнить().Выбрать();
	
	Пока ВыборкаФактаОперативного.Следующий() Цикл
		
		Если ВыборкаФактаОперативного.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена Тогда
			
			ЦветФона = "ЦветЗаконченойРаботы";// "ЦветЗаконченойРаботы").Описание;
			Обращение = ВыборкаФактаОперативного.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			
		ИначеЕсли ВыборкаФактаОперативного.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаНачата Тогда
			
			ЦветФона = "ЦветАктивнойРаботыФакт"; //СтруктураЦветов.ЦветАктивнойРаботыФакт;
			Обращение = ВыборкаФактаОперативного.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			
		ИначеЕсли ВыборкаФактаОперативного.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПауза Тогда
			
			ЦветФона = "ЦветПриостановленнойРаботы";//СтруктураЦветов.ЦветПриостановленнойРаботы;
			Обращение = ВыборкаФактаОперативного.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			
		Иначе
			
			ЦветФона = Новый Цвет(0, 0, 0);
			
		КонецЕсли;
		
		Если ВыборкаФактаОперативного.ВремяНачала < НачалоРабочегоДня Тогда
			
			ВремяНачала = НачалоРабочегоДня;
			
		Иначе
			
			ВремяНачала = ВыборкаФактаОперативного.ВремяНачала;
			
		КонецЕсли;
		
		Если ВыборкаФактаОперативного.ВремяОкончания > КонецРабочегоДня Тогда
			
			ВремяОкончания = КонецРабочегоДня;	
			
		Иначе
			
			
			ВремяОкончания = ВыборкаФактаОперативного.ВремяОкончания
			
		КонецЕсли;
		
		Если ОкрашиватьДругимиПользователями Тогда
			
			
			
		КонецЕсли;
		
		СтрокиПоОбращениюПлан = ТаблицаЗакраска.НайтиСтроки(Новый Структура("Обращение, РабочийДокумент, ЭтапРабот", ВыборкаФактаОперативного.Обращение, ВыборкаФактаОперативного.РабочийДокумент, ВыборкаФактаОперативного.ЭтапРабот));
		
		Если СтрокиПоОбращениюПлан.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаЗакраска.Добавить();
		Иначе
			НоваяСтрока = СтрокиПоОбращениюПлан[0];
		КонецЕсли;
		
		Если ОкрашиватьДругимиПользователями Тогда
			
			НоваяСтрока.Цвет = Renault_ОкраситьДругимПользователем(ЦветФона, ВыборкаФактаОперативного.РабочийДокумент, ПользовательПоУмолчанию);
			
		Иначе
		
			НоваяСтрока.Цвет = ЦветФона;
		
		КонецЕсли;
		
		НоваяСтрока.Цех = ВыборкаФактаОперативного.НомерПоста;
		НоваяСтрока.ВремяНачала = ВремяНачала;
		//НоваяСтрока.ВремяОкончания = ВремяОкончания;
		ИнтерваловСНачалаДня = (ВремяОкончания - НачалоРабочегоДня) / (ШагПланирования * 60);
		Если Цел(ИнтерваловСНачалаДня) <> ИнтерваловСНачалаДня Тогда
			ИнтерваловСНачалаДня = Цел(ИнтерваловСНачалаДня) + 1;
		КонецЕсли;
		ВремяОкончания = НачалоРабочегоДня + ИнтерваловСНачалаДня * (ШагПланирования * 60);
		НоваяСтрока.ВремяОкончания = ВремяОкончания;
		НоваяСтрока.Обращение = Обращение;
		НоваяСтрока.РабочийДокумент = ВыборкаФактаОперативного.РабочийДокумент;
		НоваяСтрока.Узор = Узор;
		НоваяСтрока.Клиент = ВыборкаФактаОперативного.Клиент;
		НоваяСтрока.Жалоба = ВыборкаФактаОперативного.Жалоба;
		НоваяСтрока.Модель = ВыборкаФактаОперативного.Модель;
		НоваяСтрока.Примечание = ВыборкаФактаОперативного.Примечание;
		НоваяСтрока.ЭтапРабот = ВыборкаФактаОперативного.ЭтапРабот;
		НоваяСтрока.ВремяНачалаРег = ВыборкаФактаОперативного.ВремяНачала;
		НоваяСтрока.ВремяОкончанияРег = ВыборкаФактаОперативного.ВремяОкончания;
		НоваяСтрока.Статус = ВыборкаФактаОперативного.СтатусРаботы;
		НоваяСтрока.ТипПаузы = ВыборкаФактаОперативного.ТипПаузы;
		НоваяСтрока.ГосНомер = ВыборкаФактаОперативного.ГосНомер;
		
	КонецЦикла;
	
	Если НаправлениеЗакраскиЛевоПраво Тогда
		
		ТаблицаЗакраска.Сортировать("ВремяНачала Убыв");
		
	Иначе
		
		ТаблицаЗакраска.Сортировать("ВремяНачала Возр");
		
	КонецЕсли;
	
	Возврат ТаблицаЗакраска;
	
КонецФункции

Функция ПолучитьТаблицуЗакраски(ДилерскийЦентр,НачалоРабочегоДня,КонецРабочегоДня,ШагПланирования,ТаблицаМашиномест,НаправлениеЗакраскиЛевоПраво,ОкрашиватьДругимиПользователями=Ложь,ПользовательПоУмолчанию=Неопределено) Экспорт
	
	Если ДилерскийЦентр.Автосервис_ИспользоватьНовыйЗапросГрафика = Истина Тогда
		
		Возврат Новый_ПолучитьТаблицуЗакраски(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, ШагПланирования, ТаблицаМашиномест, НаправлениеЗакраскиЛевоПраво,
		ОкрашиватьДругимиПользователями, ПользовательПоУмолчанию);
		
	Иначе
		
		Возврат Оригинал_ПолучитьТаблицуЗакраски(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, ШагПланирования, ТаблицаМашиномест, НаправлениеЗакраскиЛевоПраво,
		ОкрашиватьДругимиПользователями, ПользовательПоУмолчанию);
	         
	КонецЕсли;
	
КонецФункции

