	Пока Выборка.Следующий() Цикл
		
		//Если Выборка.РабочийДокумент = РабочийДокумент И Выборка.ЭтапРабот = ЭтапРабот Тогда
		//	
		//	Продолжить;
		//	
		//КонецЕсли;
		
