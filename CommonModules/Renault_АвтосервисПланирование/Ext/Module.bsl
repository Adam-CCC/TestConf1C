				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПересеченияРаботАвтосервиса.Документ КАК Документ,
				|	ПересеченияРаботАвтосервиса.ДокументПересечение КАК ДокументПересечение,
				|	ПересеченияРаботАвтосервиса.УникальныйИдентификатор КАК УникальныйИдентификатор,
				|	ПересеченияРаботАвтосервиса.ДатаСоздания КАК ДатаСоздания,
				|	МАКСИМУМ(СообщенияПользователю.Ссылка) КАК Сообщение
				|ИЗ
				|	РегистрСведений.Renault_АвтосервисПересеченияРабот КАК ПересеченияРаботАвтосервиса
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Renault_СообщенияПользователю КАК СообщенияПользователю
				|		ПО ПересеченияРаботАвтосервиса.УникальныйИдентификатор = СообщенияПользователю.ИдентификаторОбъекта
				|			И (НЕ СообщенияПользователю.ПометкаУдаления)
				|			И (СообщенияПользователю.Обработано)
				|ГДЕ
				|	ПересеченияРаботАвтосервиса.Документ = &Документ
				|	И ПересеченияРаботАвтосервиса.ДокументПересечение = &ДокументПересечение
				|
				|СГРУППИРОВАТЬ ПО
				|	ПересеченияРаботАвтосервиса.ДокументПересечение,
				|	ПересеченияРаботАвтосервиса.УникальныйИдентификатор,
				|	ПересеченияРаботАвтосервиса.Документ,
				|	ПересеченияРаботАвтосервиса.ДатаСоздания";
				
			РезультатЗапроса = ЗапросПрошлых.Выполнить();	
				
			ВыборкаЗаписей = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаЗаписей.Следующий() Цикл
				
				//Сообщение = Справочники.Renault_СообщенияПользователю.НайтиПоРеквизиту("ИдентификаторОбъекта", ВыборкаЗаписей.УникальныйИдентификатор);
				//
				//Если ЗначениеЗаполнено(ВыборкаЗаписей.Сообщение) Тогда
					
					//Если Сообщение.Обработано Тогда
					
					СообщениеОбъект = ВыборкаЗаписей.Сообщение.ПолучитьОбъект();
					СообщениеОбъект.Обработано   = Ложь;
					СообщениеОбъект.ДатаОтправки = ТекущаяДата();
					СообщениеОбъект.Записать();
					
					//КонецЕсли;
					
				//КонецЕсли;
				
			КонецЦикла;
			
			//Если ВыборкаЗаписей.Количество() = 0 Тогда
		
			Если РезультатЗапроса.Пустой() Тогда
				
				Запись = РегистрыСведений.Renault_АвтосервисПересеченияРабот.СоздатьМенеджерЗаписи();
				
				Запись.Документ 	= РабочийДокумент;
				Запись.ДокументЭтап = ЭтапРабот;
				
				Запись.ДокументПересечениеЭтап = Выборка.ЭтапРабот;
				Запись.ДокументПересечение = Выборка.РабочийДокумент;
				
				Запись.ДатаСоздания = ТекущаяДата();
				
				Отдел = Renault_CRM.ПолучитьОтделАвтосалона(ДилерскийЦентр);
				
				ЗапросМастеров = Новый Запрос();
				ЗапросМастеров.УстановитьПараметр("Должность", Справочники.Должности.Мастер);
				ЗапросМастеров.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
					|	Пользователи.Сотрудник.Ссылка КАК Сотрудник
					|ИЗ
					|	Справочник.Пользователи КАК Пользователи
					|ГДЕ
					|	Пользователи.Сотрудник.Должность = &Должность
					|	И Пользователи.Сотрудник.Подразделение В(&Подразделения)";
				
				
				Если Отдел = Неопределено Тогда
					
					Отдел = Справочники.CRM_Отделы.НайтиПоНаименованию("Сервис Renault");
					
					Если Отдел = Неопределено Тогда
						
						Отдел = Справочники.CRM_Отделы.ПустаяСсылка();
						
					КонецЕсли;
					
				КонецЕсли;
				
				ЗапросМастеров.УстановитьПараметр("Подразделения", Отдел.Подразделения.ВыгрузитьКолонку("Подразделение"));
				
				ВыборкаАдресаты = ЗапросМастеров.Выполнить().Выбрать();
				
				Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
				
				Пока ВыборкаАдресаты.Следующий() Цикл
					НоваяСтрока = Напоминание.Адресаты.Добавить();
					НоваяСтрока.Сотрудник = ВыборкаАдресаты.Сотрудник.Ссылка;
				КонецЦикла;
				
				ДатаОтправки = ТекущаяДата();
				
				Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.Автосервис_КоллизияПланирования;
				Напоминание.Наименование = Строка(Цех) + " " + Строка(РабочийДокумент);
				
				Ид = Новый УникальныйИдентификатор(); 
				
				Напоминание.ИдентификаторОбъекта = Ид;
				
				Запись.УникальныйИдентификатор = Ид;
				
				Напоминание.ДатаОтправки = ДатаОтправки;
				
				Напоминание.Сообщение = Проблема;
				
				Напоминание.Комментарий = Проблема;
				
				ТипРабочегоДокумента = ТипЗнч(РабочийДокумент);
				
				Если ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_АвтосервисОбед") 
					Или ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой")
					Или ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_АвтосервисПрочаяЗанятость") Тогда
					
					//Если ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_АвтосервисОбед") 
					//	Или ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой")
					//	Или ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_АвтосервисПрочаяЗанятость") Тогда
						
						Клиент = Неопределено;
						
					//Иначе
					//	
					//	Клиент = Выборка.РабочийДокумент.Клиент;
					//	
					//КонецЕсли;
					
				Иначе
					
					Клиент = РабочийДокумент.Клиент;
					
				КонецЕсли;
				
				Напоминание.Подробнее = Новый ХранилищеЗначения(Клиент);
				
				Напоминание.ПоказыватьС = ДатаОтправки;
				Напоминание.ПоказыватьПо = ДатаОтправки;
				
				Напоминание.Записать();
				Запись.Записать();
				
				Примечание = "";
				
			Иначе
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьПересечения;
	
КонецФункции

Функция ПолучитьТаблицуЗакраскиАрхив(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, ШагПланирования, ТаблицаМашиномест
	, НаправлениеЗакраскиЛевоПраво, ОкрашиватьДругимиПользователями = Ложь, ПользовательПоУмолчанию = Неопределено) Экспорт
	
	Если ПользовательПоУмолчанию = Неопределено Тогда
		
		ПользовательПоУмолчанию = Справочники.Пользователи.ПустаяСсылка();
		
	КонецЕсли;
	
	//В эту таблицу все и запишем
	ТаблицаЗакраска = Новый ТаблицаЗначений();
	ТаблицаЗакраска.Колонки.Добавить("Цвет");
	ТаблицаЗакраска.Колонки.Добавить("Обращение", Документы.ТипВсеСсылки());
	ТаблицаЗакраска.Колонки.Добавить("РабочийДокумент");
	ТаблицаЗакраска.Колонки.Добавить("Цех");
	ТаблицаЗакраска.Колонки.Добавить("ВремяНачала");
	ТаблицаЗакраска.Колонки.Добавить("ВремяОкончания");
	ТаблицаЗакраска.Колонки.Добавить("Узор");
	ТаблицаЗакраска.Колонки.Добавить("Клиент");
	ТаблицаЗакраска.Колонки.Добавить("ЭтапРабот");
	ТаблицаЗакраска.Колонки.Добавить("ВремяНачалаРег");
	ТаблицаЗакраска.Колонки.Добавить("ВремяОкончанияРег");
	ТаблицаЗакраска.Колонки.Добавить("Статус");
	ТаблицаЗакраска.Колонки.Добавить("Модель");
	ТаблицаЗакраска.Колонки.Добавить("ГосНомер");
	ТаблицаЗакраска.Колонки.Добавить("Жалоба");
	
	ТаблицаЗакраска.Индексы.Добавить("Обращение, РабочийДокумент, Цех, ВремяНачала, ВремяОкончания, Клиент, ВремяНачалаРег, ВремяОкончанияРег");
	
	ЗапросРаботЗапланированыхИОбедов = Новый Запрос();
	
	ЗапросРаботЗапланированыхИОбедов.Текст = 
	"ВЫБРАТЬ
	|	вт_Посты.Машиноместо КАК Машиноместо,
	|	вт_Посты.НомерПоста
	|ПОМЕСТИТЬ вт_Посты
	|ИЗ
	|	&ВТПОСТЫ КАК вт_Посты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Машиноместо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_АвтосервисПланРабот.Обращение,
	|	Renault_АвтосервисПланРабот.РабочийДокумент,
	|	Renault_АвтосервисПланРабот.Цех,
	|	Renault_АвтосервисПланРабот.ЭтапРабот,
	|	Renault_АвтосервисПланРабот.ВремяНачала,
	|	Renault_АвтосервисПланРабот.ВремяОкончания,
	|	Renault_АвтосервисПланРабот.Длительность,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	вт_ПОСТЫ.НомерПоста,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.ТипПаузы,
	|	ЕСТЬNULL(Renault_АвтосервисПланРабот.Обращение.Жалоба, ЛОЖЬ) КАК Жалоба,
	|	Renault_АвтосервисПланРабот.Обращение.Автомобиль.Модель КАК Модель,
	|	АвтомобилиСрезПоследних.Значение КАК ГосНомер
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО Renault_АвтосервисПланРабот.ДилерскийЦентр = Renault_АвтосервисСтатусыРаботСрезПоследних.ДилерскийЦентр
	|			И Renault_АвтосервисПланРабот.Обращение = Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение
	|			И Renault_АвтосервисПланРабот.РабочийДокумент = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|			И Renault_АвтосервисПланРабот.Цех = Renault_АвтосервисСтатусыРаботСрезПоследних.Цех
	|			И Renault_АвтосервисПланРабот.ЭтапРабот = Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_Посты КАК вт_ПОСТЫ
	|		ПО Renault_АвтосервисПланРабот.Цех = вт_ПОСТЫ.Машиноместо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	|		ПО Renault_АвтосервисПланРабот.Обращение.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
	|			И (АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер))
	|ГДЕ
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.ДилерскийЦентр = &ДилерскийЦентр
	|	И (Renault_АвтосервисПланРабот.ВремяНачала >= &НачалоДня
	|				И Renault_АвтосервисПланРабот.ВремяНачала <= &КонецДня
	|			ИЛИ Renault_АвтосервисПланРабот.ВремяНачала <= &НачалоДня
	|				И Renault_АвтосервисПланРабот.ВремяОкончания > &НачалоДня
	|			ИЛИ Renault_АвтосервисПланРабот.ВремяНачала <= &НачалоДня
	|				И Renault_АвтосервисПланРабот.ВремяОкончания >= &КонецДня)
	|	И Renault_АвтосервисПланРабот.ДилерскийЦентр = &ДилерскийЦентр
	|{УПОРЯДОЧИТЬ ПО
	|	ВремяОкончания}";
	
	Статусы = Новый Массив();
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаОбед);
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПростой);
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПрочаяЗанятость);
	
	//Если ДилерскийЦентр.Автосервис_НеДвигатьПросроченныеРаботы Тогда
	//	
	//	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПросрочена);
	//	
	//КонецЕсли;
	
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("Статусы", Статусы);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("НачалоДня", НачалоРабочегоДня);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("КонецДня", КонецРабочегоДня);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("ВТПОСТЫ", ТаблицаМашиномест);
	
	ВыборкаРаботЗапланированыхИОбедов = ЗапросРаботЗапланированыхИОбедов.Выполнить().Выбрать();
	
	Пока ВыборкаРаботЗапланированыхИОбедов.Следующий() Цикл
		
		Обращение = Неопределено;
		Узор = Неопределено;
		ЦветФона = Неопределено;
		Клиент = Неопределено;
		
		Если ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаОбед Тогда
			
			ЦветФона = "ЦветРаботыОбед";//СтруктураЦветов.ЦветРаботыОбед;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
			Узор = ТипУзораТабличногоДокумента.Узор15;
			
			Клиент = Неопределено;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПростой Тогда
			
			ЦветФона = "ЦветРаботыПростой";//СтруктураЦветов.ЦветРаботыПростой;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
			Узор = ТипУзораТабличногоДокумента.Узор17;
			
			Клиент = Неопределено;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПрочаяЗанятость Тогда
			
			ЦветФона = "ЦветРаботыПростой";//СтруктураЦветов.ЦветРаботыПростой;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
			//Узор = ТипУзораТабличногоДокумента.Узор17;
			
			Клиент = Неопределено;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована Тогда
			
			ЦветФона = "ЦветЗапланированнойРаботы";//СтруктураЦветов.ЦветЗапланированнойРаботы;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			Клиент = ВыборкаРаботЗапланированыхИОбедов.Обращение.Клиент;
			Если ЗначениеЗаполнено(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) Тогда
				Если ТипЗнч(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					ЦветФона = "ЦветЗапланированнойВыдачи";//СтруктураЦветов.ЦветЗапланированнойВыдачи;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена Тогда
			
			ЦветФона = "ЦветПросроченнойРаботы";//СтруктураЦветов.ЦветПросроченнойРаботы;		
			Обращение = ВыборкаРаботЗапланированыхИОбедов.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			Клиент = ВыборкаРаботЗапланированыхИОбедов.Обращение.Клиент;		
			Если ЗначениеЗаполнено(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) Тогда
				Если ТипЗнч(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					ЦветФона = "ЦветПросроченнойВыдачи";//СтруктураЦветов.ЦветПросроченнойВыдачи;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			ЦветФона = "ЦветПросроченнойРаботы";//СтруктураЦветов.ЦветПросроченнойРаботы;		
			Обращение = ВыборкаРаботЗапланированыхИОбедов.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			Клиент = ВыборкаРаботЗапланированыхИОбедов.Обращение.Клиент;		
			Если ЗначениеЗаполнено(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) Тогда
				Если ТипЗнч(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					ЦветФона = "ЦветПросроченнойВыдачи";//СтруктураЦветов.ЦветПросроченнойВыдачи;
				КонецЕсли;
			КонецЕсли;
			
			ЦветФона = "ЦветЗапланированнойРаботы";
			
		КонецЕсли;
		
		ВремяНачала = Неопределено;
		ВремяОкончания = Неопределено;
		
		Если ВыборкаРаботЗапланированыхИОбедов.ВремяНачала < НачалоРабочегоДня Тогда
			
			ВремяНачала = НачалоРабочегоДня;
			
		Иначе
			
			ВремяНачала = ВыборкаРаботЗапланированыхИОбедов.ВремяНачала;
			
		КонецЕсли;
		
		
		Если ВыборкаРаботЗапланированыхИОбедов.ВремяОкончания > КонецРабочегоДня Тогда
			
			ВремяОкончания = КонецРабочегоДня;	
			
		Иначе
			
			ВремяОкончания = ВыборкаРаботЗапланированыхИОбедов.ВремяОкончания;
			
		КонецЕсли;
		
		НоваяСтрока = ТаблицаЗакраска.Добавить();
		
		Если ОкрашиватьДругимиПользователями Тогда
			
			НоваяСтрока.Цвет = Renault_ОкраситьДругимПользователем(ЦветФона, ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент, ПользовательПоУмолчанию);
			
		Иначе
		
			НоваяСтрока.Цвет = ЦветФона;
		
		КонецЕсли;
		
		НоваяСтрока.Цех = ВыборкаРаботЗапланированыхИОбедов.НомерПоста;
		НоваяСтрока.ВремяНачала = ВремяНачала;
		//НоваяСтрока.ВремяОкончания = ВремяОкончания;
		ИнтерваловСНачалаДня = (ВремяОкончания - НачалоРабочегоДня) / (ШагПланирования * 60);
		Если Цел(ИнтерваловСНачалаДня) <> ИнтерваловСНачалаДня Тогда
			ИнтерваловСНачалаДня = Цел(ИнтерваловСНачалаДня) + 1;
		КонецЕсли;
		ВремяОкончания = НачалоРабочегоДня + ИнтерваловСНачалаДня * (ШагПланирования * 60);
		НоваяСтрока.ВремяОкончания = ВремяОкончания;
		НоваяСтрока.Обращение = Обращение;
		НоваяСтрока.РабочийДокумент = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
		НоваяСтрока.Узор = Узор;
		НоваяСтрока.Клиент = Клиент;
		НоваяСтрока.ЭтапРабот = ВыборкаРаботЗапланированыхИОбедов.ЭтапРабот;
		НоваяСтрока.ВремяНачалаРег = ВыборкаРаботЗапланированыхИОбедов.ВремяНачала;
		НоваяСтрока.ВремяОкончанияРег = ВыборкаРаботЗапланированыхИОбедов.ВремяОкончания;
		НоваяСтрока.Статус = ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы;
		НоваяСтрока.Жалоба = ВыборкаРаботЗапланированыхИОбедов.Жалоба;
		НоваяСтрока.Госномер = ВыборкаРаботЗапланированыхИОбедов.Госномер;
		НоваяСтрока.Модель = ВыборкаРаботЗапланированыхИОбедов.Модель;
		
	КонецЦикла;
	
	
	Если НаправлениеЗакраскиЛевоПраво Тогда
		
		ТаблицаЗакраска.Сортировать("ВремяНачала Убыв");
		
	Иначе
		
		ТаблицаЗакраска.Сортировать("ВремяНачала Возр");
		
	КонецЕсли;
	
	Возврат ТаблицаЗакраска;
	
КонецФункции

Функция Renault_ОкраситьДругимПользователем(ЦветФона, РабочийДокумент, ПользовательПоУмолчанию) Экспорт
	
	Пользователь = ПользовательПоУмолчанию;
	ЦветаПоУмолчанию = Renault_АвтосервисПланированиеПовтИспользования.Renault_ЦветаПоУмолчанию();
	
	Если ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаСервис") Тогда
		
		СвязанаяПриемка = Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту("Обращение", РабочийДокумент.Обращение);
		
		Если ЗначениеЗаполнено(СвязанаяПриемка) Тогда
			
			Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", СвязанаяПриемка.Машиноместо);
			
			Если Не ЗначениеЗаполнено(Пользователь) Тогда
				
				Пользователь = СвязанаяПриемка.Автор;
				
			КонецЕсли;
			
		Иначе
			
			Пользователь = РабочийДокумент.Автор;
			
			Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
				
				Пользователь = ПользовательПоУмолчанию;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") 
		ИЛИ ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") Тогда
		
		Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", РабочийДокумент.Машиноместо);
		
	Иначе
		
		НовыйЦвет = ЦветаПоУмолчанию[ЦветФона];
					
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		
		НовыйЦвет = ЦветаПоУмолчанию[ЦветФона];
		
	Иначе
		
		НовыйЦвет = Renault_СтруктураЦветовПользователя(Пользователь)[ЦветФона];
		
	КонецЕсли;
		
	
	МассивЦвет = Новый Массив;
		
	Если НовыйЦвет = Неопределено Тогда
		
		МассивЦвет.Добавить(0);
		МассивЦвет.Добавить(0);
		МассивЦвет.Добавить(0);
		
	Иначе
		
		Если НовыйЦвет.Вид <> ВидЦвета.Абсолютный Тогда
			
			//НовыйЦвет = Renault_АвтосервисПланированиеПовтИспользования.ПреобразоватьЦветВАбсолютный(НовыйЦвет);                                                                                                                                                                                                                                                                                                                                                                                       
			Попытка
				текТаблица = Новый ТабличныйДокумент;
				текТаблица.Область().ЦветФона = НовыйЦвет;
				текТаблица.Записать("ПреобразованиеЦвета.mxl", ТипФайлаТабличногоДокумента.MXL7); 
				текТаблица.Прочитать("ПреобразованиеЦвета.mxl");
				НовыйЦвет = текТаблица.Область().ЦветФона;
			Исключение
				НовыйЦвет = Новый Цвет(0,0,0);
			КонецПопытки;
			
		КонецЕсли;
		
		МассивЦвет.Добавить(НовыйЦвет.Красный);
		МассивЦвет.Добавить(НовыйЦвет.Зеленый);
		МассивЦвет.Добавить(НовыйЦвет.Синий);
		
	КонецЕсли;
	
	Возврат МассивЦвет;
	
КонецФункции

