
Функция ПолучитьТаблицуМашиномест(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, 
	ВыделятьСебя, ТолькоРаботающие, ОтборМашиноместо, ОтборВидМашиноместа, Сотрудник, ТаблицаЗанятости) Экспорт
	
	ПодразделенияДЦ   = Справочники.CRM_ДилерскиеЦентры.ПолучитьПодразделенияДЦ(ДилерскийЦентр).ВыгрузитьКолонку("Подразделение");
	ДолжностиПриемки = Справочники.CRM_ДилерскиеЦентры.ПолучитьДолжностиАвтосервиса(ДилерскийЦентр).ВыгрузитьКолонку("Должность");
	
	Запрос = Новый Запрос();
	
	//Запрос.УстановитьПараметр("ВыделятьСебя",	  ВыделятьСебя);
	//Запрос.УстановитьПараметр("ТекПриемщик", 	  Сотрудник);
	Запрос.УстановитьПараметр("ВидМашиноместа",	  ОтборВидМашиноместа);
	//Запрос.УстановитьПараметр("ЛюбоеМашиноместо", Не ЗначениеЗаполнено(ОтборМашиноместо));
	
	Запрос.УстановитьПараметр("ОтборДата", 		  НачалоРабочегоДня);
	Запрос.УстановитьПараметр("НачалоДня", 		  НачалоРабочегоДня);
	Запрос.УстановитьПараметр("КонецДня", 		  КонецРабочегоДня);
	Запрос.УстановитьПараметр("ДилерскийЦентр",   ДилерскийЦентр);
			
	Запрос.УстановитьПараметр("ПодразделенияДЦ", ПодразделенияДЦ);
	Запрос.УстановитьПараметр("ДолжностиПриемки", ДолжностиПриемки);
	
	Если ЗначениеЗаполнено(ОтборМашиноместо) Тогда
		Запрос.УстановитьПараметр("Машиноместо", 	  ОтборМашиноместо);
	// начало добавление Зеленчук
	// Инициатор Михаил
		Запрос.УстановитьПараметр("МашиноместоЗаполнено", 	  Истина);
	Иначе
		Запрос.УстановитьПараметр("Машиноместо", 	  Справочники.Цеха.ПустаяСсылка());
		Запрос.УстановитьПараметр("МашиноместоЗаполнено", 	  Ложь);
	// окончание добавление Зеленчук
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(Сотрудник) И ЗначениеЗаполнено(ВыделятьСебя) Тогда
		
		Запрос.УстановитьПараметр("ТекПриемщик", 	  Сотрудник);
		
		Запрос.УстановитьПараметр("ВыделятьСебя",	  ВыделятьСебя);
	//КонецЕсли;

	
	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЦехаАвтосервиса.Цех КАК Ссылка,
		|	ЦехаАвтосервиса.КоэффициентЗагрузки КАК КоэффициентЗагрузки,
		|	2 КАК ВидМашиноместа,
		|	ЦехаАвтосервиса.НомерСтроки,
		|	ЦехаАвтосервиса.ЦветФонаСтроки
		|ПОМЕСТИТЬ Машиноместа
		|ИЗ
		|	Справочник.CRM_ДилерскиеЦентры.АвтосервисЦеха КАК ЦехаАвтосервиса
		|ГДЕ
		|	НЕ ЦехаАвтосервиса.Ссылка.ПометкаУдаления
		|	И ЦехаАвтосервиса.Ссылка.Ссылка = &ДилерскийЦентр
		|	И (&ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.МашиноместоВЦеху)
		|			ИЛИ &ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МойкиАвтосервиса.Мойка,
		|	0,
		|	1,
		|	NULL,
		|	NULL
		|ИЗ
		|	Справочник.CRM_ДилерскиеЦентры.АвтосервисМойки КАК МойкиАвтосервиса
		|ГДЕ
		|	НЕ МойкиАвтосервиса.Ссылка.ПометкаУдаления
		|	И МойкиАвтосервиса.Ссылка.Ссылка = &ДилерскийЦентр
		|	И (&ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.Мойка)
		|			ИЛИ &ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПодменныеАвтоАвтосервиса.Авто,
		|	0,
		|	4,
		|	NULL,
		|	NULL
		|ИЗ
		|	Справочник.CRM_ДилерскиеЦентры.АвтосервисПодменныеАвто КАК ПодменныеАвтоАвтосервиса
		|ГДЕ
		|	НЕ ПодменныеАвтоАвтосервиса.Ссылка.ПометкаУдаления
		|	И ПодменныеАвтоАвтосервиса.Ссылка.Ссылка = &ДилерскийЦентр
		|	И (&ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.ПодменныйАвтомобиль)
		|			ИЛИ &ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сотрудники.Ссылка,
		|	0,
		|	0,
		|	NULL,
		|	NULL
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	(&ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.МастерПриемщик)
		|			ИЛИ &ВидМашиноместа = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыМашиноместВЦеху.ПустаяСсылка))
		|	И НЕ Сотрудники.ПометкаУдаления
		|	И Сотрудники.Должность В(&ДолжностиПриемки)
		|	И Сотрудники.Подразделение В(&ПодразделенияДЦ)
		|	И НЕ Сотрудники.ФлагУволен
		|	И (НЕ &ВыделятьСебя
		|			ИЛИ Сотрудники.Ссылка = &ТекПриемщик)
		|{УПОРЯДОЧИТЬ ПО
		|	НомерСтроки}
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВидМашиноместа,
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПланРаботАвтосервиса.Цех КАК Цех,
		|	СУММА(ПланРаботАвтосервиса.Длительность) КАК Длительность,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПланРаботАвтосервиса.Обращение) КАК КоличествоОбращений
		|ПОМЕСТИТЬ Работы
		|ИЗ
		|	РегистрСведений.Renault_АвтосервисПланРабот КАК ПланРаботАвтосервиса
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ПланРаботАвтосервиса.ВремяНачала, ДЕНЬ) = НАЧАЛОПЕРИОДА(&ОтборДата, ДЕНЬ)
		|	И НЕ ПланРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисОбед
		|	И НЕ ПланРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПростой
		|	И НЕ ПланРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПрочаяЗанятость
		|
		|СГРУППИРОВАТЬ ПО
		|	ПланРаботАвтосервиса.Цех
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Цех
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Машиноместа.Ссылка КАК Машиноместо,
		|	Машиноместа.ВидМашиноместа КАК ВидМашиноместа,
		|	0 КАК НомерПоста,
		|	ЕСТЬNULL(Работы.Длительность, 0) КАК ОбщаяЗанятость,
		|	ЕСТЬNULL(Работы.КоличествоОбращений, 0) КАК КоличествоОбращений,
		|	Машиноместа.КоэффициентЗагрузки КАК КоэффициентЗагрузки,
		|	ЛОЖЬ КАК Работает,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК НачалоРаботы,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК КонецРаботы,
		|	Машиноместа.НомерСтроки КАК НомерСтроки,
		|	Машиноместа.ЦветФонаСтроки
		|ИЗ
		|	Машиноместа КАК Машиноместа
		|		ЛЕВОЕ СОЕДИНЕНИЕ Работы КАК Работы
		|		ПО Машиноместа.Ссылка = Работы.Цех
		// начало добавление Зеленчук
		// инициатор Михаил
		|ГДЕ
		|	ВЫБОР 
		|		КОГДА &МашиноместоЗаполнено
		|		ТОГДА Машиноместа.Ссылка = &Машиноместо
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ
		// окончание добавление Зеленчук
		|УПОРЯДОЧИТЬ ПО
		|	ВидМашиноместа,
		|	НомерСтроки,
		|	Машиноместо
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Зап = Новый Запрос;
	Зап.УстановитьПараметр("НачалоОтбора",НачалоРабочегоДня);
	Зап.УстановитьПараметр("КонецОтбора",КонецДня(НачалоРабочегоДня));
	Зап.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПланРаботАвтосервиса.Цех КАК Цех,
		|	ПланРаботАвтосервиса.ВремяНачала,
		|	ПланРаботАвтосервиса.ВремяОкончания,
		|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(5, 3)) КАК Длительность
		|ПОМЕСТИТЬ ТаблицаДанных
		|ИЗ
		|	РегистрСведений.Renault_АвтосервисПланРабот КАК ПланРаботАвтосервиса
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ПланРаботАвтосервиса.ВремяНачала >= &НачалоОтбора
		|					И ПланРаботАвтосервиса.ВремяНачала <= &КонецОтбора
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ПланРаботАвтосервиса.ВремяНачала < &НачалоОтбора
		|							И ПланРаботАвтосервиса.ВремяОкончания > &НачалоОтбора
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|		КОНЕЦ
		|	И НЕ ПланРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисОбед
		|	И НЕ ПланРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПростой
		|	И НЕ ПланРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПрочаяЗанятость
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Цех
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДанных.Цех,
		|	ТаблицаДанных.ВремяНачала,
		|	ТаблицаДанных.ВремяОкончания,
		|	ТаблицаДанных.Длительность
		|ИЗ
		|	ТаблицаДанных КАК ТаблицаДанных";
		
	ТаблицаЗанятости = Зап.Выполнить().Выгрузить();
	
	ТаблицаЗанятости.Индексы.Добавить("Цех");
	
	Для Каждого Опис Из ТаблицаЗанятости Цикл
		
		ВремяНач =  Опис.ВремяНачала;
		Если ВремяНач < НачалоРабочегоДня Тогда
			ВремяНач = НачалоРабочегоДня;
		КонецЕсли;
		
		ВремяКон = Опис.ВремяОкончания;
		
		Если ВремяКон > КонецРабочегоДня Тогда
			ВремяКон = КонецРабочегоДня;
		КонецЕсли;
		
		Длит = ВремяКон - ВремяНач;
		
		Опис.Длительность = Длит/3600;
		
	КонецЦикла;
	
	ТаблицаЗанятости.Свернуть("Цех","Длительность");
	
	ТаблицаМашиноместа = Запрос.Выполнить().Выгрузить();
	
	ТаблицаМашиноместа.Индексы.Добавить("Машиноместо, НомерПоста");
	
	НомерПоста = 1;
	
	Для Каждого Строка Из ТаблицаМашиноместа Цикл
		
		Строка.НомерПоста = НомерПоста;
		НомерПоста = НомерПоста + 1;
		
	КонецЦикла;
	
	ТаблицаМашиноместа.Индексы.Добавить("Машиноместо, НомерПоста");
	
	ТаблицаМашиноместа.Колонки.Добавить("ТЗ", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Для Каждого Строка из ТаблицаМашиноместа Цикл
		
		Если Строка.ВидМашиноместа = 0 Тогда
			
			Работает = Renault_АвтосервисПланированиеПовтИспользования.Renault_ПолучитьИсполнителейЗаПериод(НачалоРабочегоДня, КонецРабочегоДня, Строка.Машиноместо, Неопределено);
			
			Если ЗначениеЗаполнено(Работает) Тогда
				
				Строка.Работает = ИСТИНА;
				Строка.НачалоРаботы = Работает[0].НачалоРаботы;
				Строка.КонецРаботы = Работает[0].КонецРаботы;
				Строка.ТЗ = Работает;
				
			Иначе
				
				Строка.Работает = ЛОЖЬ;
				Строка.ТЗ = Работает;
				
			КонецЕсли;
			
		ИначеЕсли Строка.ВидМашиноместа = 2 Тогда
			
			Если ДилерскийЦентр.Автосервис_НеИспользоватьГрафикЦехов = Ложь Тогда
				
				Работает = Renault_АвтосервисОбщий.Renault_ПолучитьИсполнителейЗаПериод(НачалоРабочегоДня, КонецРабочегоДня, Неопределено, Строка.Машиноместо);
				
				Если ЗначениеЗаполнено(Работает) Тогда
					
					Строка.Работает = ИСТИНА;
					Строка.НачалоРаботы = Работает[0].НачалоРаботы;
					Строка.КонецРаботы = Работает[0].КонецРаботы;
					Строка.ТЗ = Работает;
					
				Иначе
					
					Строка.Работает = ЛОЖЬ;
					Строка.ТЗ = Работает;
					
				КонецЕсли;
				
			Иначе
				
				Строка.Работает = ИСТИНА;
				Строка.НачалоРаботы = НачалоРабочегоДня;
				Строка.КонецРаботы = КонецРабочегоДня;
				Строка.ТЗ = Работает;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРезультат = ТаблицаМашиноместа.СкопироватьКолонки();
	
	Если ТолькоРаботающие Тогда
		
		НомерПоста = 1;
		Для Каждого Строка из ТаблицаМашиноместа Цикл
			
			Если Строка.Работает Тогда
				
				НоваяСтрока = ТаблицаРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.НомерПоста = НомерПоста;
				НомерПоста = НомерПоста + 1;
				
			ИначеЕсли Строка.ВидМашиноместа = 1 Тогда
				
				НоваяСтрока = ТаблицаРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.НомерПоста = НомерПоста;
				НомерПоста = НомерПоста + 1;
				
			ИначеЕсли Строка.ВидМашиноместа = 4 Тогда
				
				НоваяСтрока = ТаблицаРезультат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.НомерПоста = НомерПоста;
				НомерПоста = НомерПоста + 1;
				
			КонецЕсли;
			
			
		КонецЦикла;
		
	Иначе
		
		ТаблицаРезультат = ТаблицаМашиноместа.Скопировать();
		
	КонецЕсли;
	
//v+
	Если ДилерскийЦентр.ИспользоватьДополнительныеПараметрыСменыАвтосервиса Тогда
		Для Каждого Стр Из ТаблицаРезультат Цикл
			Если Стр.ТЗ.Колонки.Найти("ДопДлительностьРабочегоДня")<>Неопределено Тогда Стр.ТЗ.Колонки.Удалить("ДопДлительностьРабочегоДня") КонецЕсли;
			Стр.ТЗ.Колонки.Добавить("ДопДлительностьРабочегоДня");
			Если Стр.ТЗ.Колонки.Найти("ДопПарамСмены")<>Неопределено Тогда Стр.ТЗ.Колонки.Удалить("ДопПарамСмены") КонецЕсли;
			Стр.ТЗ.Колонки.Добавить("ДопПарамСмены");
			Для Каждого СтрТЗ Из Стр.ТЗ Цикл
				Запрос=Новый Запрос("Выбрать ВремяНачала,ВремяОкончания Из РегистрСведений.Renault_ДополнительныеПараметрыСменыАвтосервиса ГДЕ ДилерскийЦентр=&ДЦ И Смена=&Смена");
				Запрос.УстановитьПараметр("ДЦ",ДилерскийЦентр);
				Запрос.УстановитьПараметр("Смена",СтрТЗ.Смена);
				СтрТЗ.ДопПарамСмены=Запрос.Выполнить().Выгрузить();
				СтрТЗ.ДопДлительностьРабочегоДня = 0;
				Для Каждого СтрДоп из СтрТЗ.ДопПарамСмены Цикл
					РазницаВСекундах = СтрДоп.ВремяОкончания - СтрДоп.ВремяНачала;
					СтрТЗ.ДопДлительностьРабочегоДня = СтрТЗ.ДопДлительностьРабочегоДня + РазницаВСекундах;
				КонецЦикла;
			КонецЦикла;	
			
			
			
			
		КонецЦикла;	
		
	КонецЕсли;
//v-
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура ПолучитьТаблицуЗакраскиВФоне(ПараметрыВызоваСервера, АдресХранилища) Экспорт
	
	Если ПараметрыВызоваСервера.ПросмотрАрхива = Ложь Тогда
		
		сОтвет = ПолучитьТаблицуЗакраски(ПараметрыВызоваСервера.ДилерскийЦентр, ПараметрыВызоваСервера.НачалоРабочегоДня, ПараметрыВызоваСервера.КонецРабочегоДня, ПараметрыВызоваСервера.ШагПланирования, ПараметрыВызоваСервера.ТаблицаМашиномест
	, ПараметрыВызоваСервера.НаправлениеЗакраскиЛевоПраво, ПараметрыВызоваСервера.ПросмотрЦветовДругихПользователей, ПараметрыВызоваСервера.ПользовательПоУмолчанию)		
		
	Иначе
		
		сОтвет = ПолучитьТаблицуЗакраскиАрхив(ПараметрыВызоваСервера.ДилерскийЦентр, ПараметрыВызоваСервера.НачалоРабочегоДня, ПараметрыВызоваСервера.КонецРабочегоДня, ПараметрыВызоваСервера.ШагПланирования, ПараметрыВызоваСервера.ТаблицаМашиномест
	, ПараметрыВызоваСервера.НаправлениеЗакраскиЛевоПраво, ПараметрыВызоваСервера.ПросмотрЦветовДругихПользователей, ПараметрыВызоваСервера.ПользовательПоУмолчанию)
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(сОтвет, АдресХранилища);
	
КонецПроцедуры

Функция Оригинал_ПолучитьТаблицуЗакраски(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, ШагПланирования, ТаблицаМашиномест
	, НаправлениеЗакраскиЛевоПраво, ОкрашиватьДругимиПользователями = Ложь, ПользовательПоУмолчанию = Неопределено) Экспорт
	
	Если ПользовательПоУмолчанию = Неопределено Тогда
		
		ПользовательПоУмолчанию = Справочники.Пользователи.ПустаяСсылка();
		
	КонецЕсли;
	
	//В эту таблицу все и запишем
	ТаблицаЗакраска = Новый ТаблицаЗначений();
	ТаблицаЗакраска.Колонки.Добавить("Цвет");
	ТаблицаЗакраска.Колонки.Добавить("Обращение", Документы.ТипВсеСсылки());
	ТаблицаЗакраска.Колонки.Добавить("ГосНомер");
	ТаблицаЗакраска.Колонки.Добавить("РабочийДокумент");
	ТаблицаЗакраска.Колонки.Добавить("Цех");
	ТаблицаЗакраска.Колонки.Добавить("ВремяНачала");
	ТаблицаЗакраска.Колонки.Добавить("ВремяОкончания");
	ТаблицаЗакраска.Колонки.Добавить("Узор");
	ТаблицаЗакраска.Колонки.Добавить("Клиент");
	ТаблицаЗакраска.Колонки.Добавить("Модель");
	ТаблицаЗакраска.Колонки.Добавить("ЭтапРабот");
	ТаблицаЗакраска.Колонки.Добавить("ВремяНачалаРег");
	ТаблицаЗакраска.Колонки.Добавить("ВремяОкончанияРег");
	ТаблицаЗакраска.Колонки.Добавить("Статус");
	ТаблицаЗакраска.Колонки.Добавить("ТипПаузы");
	ТаблицаЗакраска.Колонки.Добавить("Примечание");
	ТаблицаЗакраска.Колонки.Добавить("Жалоба");
	

	ТаблицаЗакраска.Индексы.Добавить("Обращение, РабочийДокумент, Цех, ВремяНачала, ВремяОкончания, Клиент, ВремяНачалаРег, ВремяОкончанияРег");
	
	ЗапросРаботЗапланированыхИОбедов = Новый Запрос();
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросРаботЗапланированыхИОбедов.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросРаботЗапланированыхИОбедов.Текст = 
	"ВЫБРАТЬ
	|	вт_Посты.Машиноместо КАК Машиноместо,
	|	вт_Посты.НомерПоста
	|ПОМЕСТИТЬ вт_Посты
	|ИЗ
	|	&ВТПОСТЫ КАК вт_Посты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Машиноместо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_АвтосервисПланРабот.Обращение,
	|	Renault_АвтосервисПланРабот.Обращение.Клиент КАК Клиент,
	|	Renault_АвтосервисПланРабот.Обращение.Автомобиль.Модель КАК Модель,
	|	Renault_АвтосервисПланРабот.Обращение.Примечание КАК Примечание,
	|	Renault_АвтосервисПланРабот.РабочийДокумент,
	|	Renault_АвтосервисПланРабот.Цех,
	|	Renault_АвтосервисПланРабот.ЭтапРабот,
	|	Renault_АвтосервисПланРабот.ВремяНачала,
	|	Renault_АвтосервисПланРабот.ВремяОкончания,
	|	Renault_АвтосервисПланРабот.Длительность,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	вт_ПОСТЫ.НомерПоста,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.ТипПаузы,
	|	АвтомобилиСрезПоследних.Значение КАК ГосНомер,
	|	ЕСТЬNULL(Renault_АвтосервисПланРабот.Обращение.Жалоба, ЛОЖЬ) КАК Жалоба
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних(
	|				,
	|				ДилерскийЦентр = &ДилерскийЦентр
	|					И СтатусРаботы В (&Статусы)) КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО Renault_АвтосервисПланРабот.ДилерскийЦентр = Renault_АвтосервисСтатусыРаботСрезПоследних.ДилерскийЦентр
	|			И Renault_АвтосервисПланРабот.Обращение = Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение
	|			И Renault_АвтосервисПланРабот.РабочийДокумент = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|			И Renault_АвтосервисПланРабот.Цех = Renault_АвтосервисСтатусыРаботСрезПоследних.Цех
	|			И Renault_АвтосервисПланРабот.ЭтапРабот = Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот
	|			И (Renault_АвтосервисПланРабот.ВремяНачала >= &НачалоДня
	|					И Renault_АвтосервисПланРабот.ВремяНачала <= &КонецДня
	|				ИЛИ Renault_АвтосервисПланРабот.ВремяНачала <= &НачалоДня
	|					И Renault_АвтосервисПланРабот.ВремяОкончания > &НачалоДня
	|				ИЛИ Renault_АвтосервисПланРабот.ВремяНачала <= &НачалоДня
	|					И Renault_АвтосервисПланРабот.ВремяОкончания >= &КонецДня)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_Посты КАК вт_ПОСТЫ
	|		ПО Renault_АвтосервисПланРабот.Цех = вт_ПОСТЫ.Машиноместо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&НачалоДня, ) КАК АвтомобилиСрезПоследних
	|		ПО (АвтомобилиСрезПоследних.Автомобиль = Renault_АвтосервисПланРабот.Обращение.Автомобиль)
	|			И (АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения)
	|{УПОРЯДОЧИТЬ ПО
	|	ВремяОкончания}";
	
	Статусы = Новый Массив();
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаОбед);
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПростой);
	Статусы.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПрочаяЗанятость);
		
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("Статусы", Статусы);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("НачалоДня", НачалоРабочегоДня);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("КонецДня", КонецРабочегоДня);
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("ВТПОСТЫ", ТаблицаМашиномест);
	
	ЗапросРаботЗапланированыхИОбедов.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	
	ВыборкаРаботЗапланированыхИОбедов = ЗапросРаботЗапланированыхИОбедов.Выполнить().Выбрать();
	
	Пока ВыборкаРаботЗапланированыхИОбедов.Следующий() Цикл
		
		Обращение = Неопределено;
		Узор = Неопределено;
		ЦветФона = Неопределено;
		Клиент = Неопределено;
		
		Если ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаОбед Тогда
			
			ЦветФона = "ЦветРаботыОбед";//СтруктураЦветов.ЦветРаботыОбед;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
			Узор = ТипУзораТабличногоДокумента.Узор15;
			
			Клиент = Неопределено;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПростой Тогда
			
			ЦветФона = "ЦветРаботыПростой";//СтруктураЦветов.ЦветРаботыПростой;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
			Узор = ТипУзораТабличногоДокумента.Узор17;
			
			Клиент = Неопределено;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПрочаяЗанятость Тогда
			
			ЦветФона = "ЦветРаботыПростой";//СтруктураЦветов.ЦветРаботыПростой;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
			//Узор = ТипУзораТабличногоДокумента.Узор17;
			
			Клиент = Неопределено;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована Тогда
			
			ЦветФона = "ЦветЗапланированнойРаботы";//СтруктураЦветов.ЦветЗапланированнойРаботы;
			Обращение = ВыборкаРаботЗапланированыхИОбедов.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			Клиент = ВыборкаРаботЗапланированыхИОбедов.Клиент;
			Если ЗначениеЗаполнено(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) Тогда
				Если ТипЗнч(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					ЦветФона = "ЦветЗапланированнойВыдачи";//СтруктураЦветов.ЦветЗапланированнойВыдачи;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена Тогда
			
			ЦветФона = "ЦветПросроченнойРаботы";//СтруктураЦветов.ЦветПросроченнойРаботы;		
			Обращение = ВыборкаРаботЗапланированыхИОбедов.Обращение;
			Узор = ТипУзораТабличногоДокумента.БезУзора;
			Клиент = ВыборкаРаботЗапланированыхИОбедов.Клиент;		
			Если ЗначениеЗаполнено(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) Тогда
				Если ТипЗнч(ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					ЦветФона = "ЦветПросроченнойВыдачи";//СтруктураЦветов.ЦветПросроченнойВыдачи;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			ЦветФона = Новый Цвет(0, 0, 0);
			
		КонецЕсли;
		
		ВремяНачала = Неопределено;
		ВремяОкончания = Неопределено;
		
		Если ВыборкаРаботЗапланированыхИОбедов.ВремяНачала < НачалоРабочегоДня Тогда
			
			ВремяНачала = НачалоРабочегоДня;
			
		Иначе
			
			ВремяНачала = ВыборкаРаботЗапланированыхИОбедов.ВремяНачала;
			
		КонецЕсли;
		
		
		Если ВыборкаРаботЗапланированыхИОбедов.ВремяОкончания > КонецРабочегоДня Тогда
			
			ВремяОкончания = КонецРабочегоДня;	
			
		Иначе
			
			ВремяОкончания = ВыборкаРаботЗапланированыхИОбедов.ВремяОкончания;
			
		КонецЕсли;
		
		НоваяСтрока = ТаблицаЗакраска.Добавить();
		
		Если ОкрашиватьДругимиПользователями Тогда
			
			НоваяСтрока.Цвет = Renault_ОкраситьДругимПользователем(ЦветФона, ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент, ПользовательПоУмолчанию);
			
		Иначе
		
			НоваяСтрока.Цвет = ЦветФона;
		
		КонецЕсли;
	
		НоваяСтрока.Цех = ВыборкаРаботЗапланированыхИОбедов.НомерПоста;
		НоваяСтрока.ВремяНачала = ВремяНачала;
		//НоваяСтрока.ВремяОкончания = ВремяОкончания;
		ИнтерваловСНачалаДня = (ВремяОкончания - НачалоРабочегоДня) / (ШагПланирования * 60);
		Если Цел(ИнтерваловСНачалаДня) <> ИнтерваловСНачалаДня Тогда
			ИнтерваловСНачалаДня = Цел(ИнтерваловСНачалаДня) + 1;
		КонецЕсли;
		ВремяОкончания = НачалоРабочегоДня + ИнтерваловСНачалаДня * (ШагПланирования * 60);
		НоваяСтрока.ВремяОкончания = ВремяОкончания;
		НоваяСтрока.Обращение = Обращение;
		НоваяСтрока.Модель = ВыборкаРаботЗапланированыхИОбедов.Модель;
		НоваяСтрока.Жалоба = ВыборкаРаботЗапланированыхИОбедов.Жалоба;
		НоваяСтрока.Примечание = ВыборкаРаботЗапланированыхИОбедов.Примечание;
		НоваяСтрока.РабочийДокумент = ВыборкаРаботЗапланированыхИОбедов.РабочийДокумент;
		НоваяСтрока.Узор = Узор;
		НоваяСтрока.Клиент = Клиент;
		НоваяСтрока.ЭтапРабот = ВыборкаРаботЗапланированыхИОбедов.ЭтапРабот;
		НоваяСтрока.ВремяНачалаРег = ВыборкаРаботЗапланированыхИОбедов.ВремяНачала;
		НоваяСтрока.ВремяОкончанияРег = ВыборкаРаботЗапланированыхИОбедов.ВремяОкончания;
		НоваяСтрока.Статус = ВыборкаРаботЗапланированыхИОбедов.СтатусРаботы;
		НоваяСтрока.ГосНомер = ВыборкаРаботЗапланированыхИОбедов.ГосНомер;
		
	КонецЦикла;
	
	
	ЗапросПланаОперативного = Новый Запрос();	
	ЗапросПланаОперативного.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	ЗапросПланаОперативного.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисПланОперативныйСрезПоследних.Период,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.ДилерскийЦентр КАК ДилерскийЦентр,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.Обращение КАК Обращение,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.РабочийДокумент КАК РабочийДокумент,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.ЭтапРабот КАК ЭтапРабот,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.Цех КАК Цех,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала КАК ВремяНачала,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.ВремяОкончания КАК ВремяОкончания,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.Длительность,
	|	вт_Посты.Машиноместо КАК Машиноместо,
	|	вт_Посты.НомерПоста КАК НомерПоста
	|ПОМЕСТИТЬ ПланОперативный
	|ИЗ
	|	вт_Посты КАК вт_Посты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланОперативный.СрезПоследних(
	|				&ТекущаяДата,
	|				Цех В
	|						(ВЫБРАТЬ
	|							вт_Посты.Машиноместо
	|						ИЗ
	|							вт_Посты КАК вт_Посты)
	|					И (ВремяНачала >= &НачалоДня
	|							И ВремяНачала <= &КонецДня
	|						ИЛИ ВремяНачала <= &НачалоДня
	|							И ВремяОкончания >= &НачалоДня
	|						ИЛИ ВремяНачала <= &НачалоДня
	|							И ВремяОкончания >= &КонецДня)) КАК Renault_АвтосервисПланОперативныйСрезПоследних
	|		ПО вт_Посты.Машиноместо = Renault_АвтосервисПланОперативныйСрезПоследних.Цех
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Машиноместо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПланОперативный.Цех КАК Цех,
