				Исключение
					
					Сообщить("Не удалось отправить данные в планшетное приложение." + Символы.ПС + ОписаниеОшибки());
					Если ТранзакцияАктивна() Тогда
						ОтменитьТранзакцию();
					КонецЕсли;

				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		//// Планируем выдачу
	ИначеЕсли ВидСобытия = Перечисления.CRM_ВидыСобытийАвтоСервиса.ВыдачаАвто И ВидМашиноместа = Тип("СправочникСсылка.Сотрудники") Тогда
		
		Если НеобходимПереносНаСледующийДень Тогда
			Ошибка = "Давай не будем разбивать выдачу по дням! :-)";
			ОтказВПерепланировании = Истина;
			Возврат Ложь;
		КонецЕсли;
		
		Если ЕстьДокумент Тогда
			НовыйДокумент = Параметры.Ссылка.ПолучитьОбъект();
			НовыйДокумент.ДилерскийЦентр = ДилерскийЦентр;
			Если НЕ НовыйДокумент.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка 
				И НЕ НовыйДокумент.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.КлиентОжидает 
				И НЕ НовыйДокумент.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Отмена Тогда
				Оишбка = "Планирование недоступно для документа!";
				ОтказВПерепланировании = Истина;
				Возврат Ложь; // планинг только для заявок
			Иначе
				НаборПлан = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
				НаборПлан.Отбор.РабочийДокумент.Установить(НовыйДокумент.Ссылка);
				НаборПлан.Прочитать();
				НаборПлан.Очистить();
				НаборПлан.Записать();
			КонецЕсли;
		Иначе
			НовыйДокумент = Документы.Renault_CRM_ВыдачаАвтомобиля.СоздатьДокумент();
			НовыйДокумент.ДилерскийЦентр = ДилерскийЦентр;
			НовыйДокумент.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
			НовыйДокумент.Обращение = Обращение;
			НовыйДокумент.Клиент = Клиент;
		КонецЕсли;
		
		Если ПроверитьНакладки(ВремяНачалаРаботы, ВремяНачалаРаботы + ДлительностьПоУмолчаниюВыдача, Машиноместо, НовыйДокумент.Ссылка, "1", ЛОЖЬ) Тогда
			
			Ошибка = "Возможны накладки в планировании. Перепланируйте выдачу или работы.";
			ОтказВПерепланировании = Истина;
			Возврат Ложь;
			
		КонецЕсли;
		
		Если ВсеПроверки Тогда
		
			// Проверим запланированы ли все работы по обращению
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_CRM_ЗаявкаНаСервисРаботы.ВремяНачала,
			|	Renault_CRM_ЗаявкаНаСервисРаботы.ВремяОкончания
			|ИЗ
			|	Документ.Renault_CRM_ЗаявкаНаСервис.Работы КАК Renault_CRM_ЗаявкаНаСервисРаботы
			|ГДЕ
			|	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка.Обращение = &Обращение
			|	И Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка.ПометкаУдаления = ЛОЖЬ";
			Запрос.УстановитьПараметр("Обращение", Обращение);
			Выборка = Запрос.Выполнить().Выбрать();
			
			//Временно, т.к. логика кривая, переделать
			//Пока Выборка.Следующий() Цикл
			//	Если НЕ (ЗначениеЗаполнено(Выборка.ВремяНачала) И ЗначениеЗаполнено(Выборка.ВремяНачала)) Тогда
			//		Предупреждение("Перед планированием выдачи необходимо запланировать все предыдущие работы!");
			//		Возврат;
			//	КонецЕсли;
			//КонецЦикла;
			
			// Проверим запланированы ли все работы по обращению
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала,
			|	Renault_АвтосервисПланОперативныйСрезПоследних.ВремяОкончания,
			|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы
			|ИЗ
			|	РегистрСведений.Renault_АвтосервисПланОперативный.СрезПоследних КАК Renault_АвтосервисПланОперативныйСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
			|		ПО Renault_АвтосервисПланОперативныйСрезПоследних.ДилерскийЦентр = Renault_АвтосервисСтатусыРаботСрезПоследних.ДилерскийЦентр
			|			И Renault_АвтосервисПланОперативныйСрезПоследних.Обращение = Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение
			|			И Renault_АвтосервисПланОперативныйСрезПоследних.РабочийДокумент = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
			|			И Renault_АвтосервисПланОперативныйСрезПоследних.Цех = Renault_АвтосервисСтатусыРаботСрезПоследних.Цех
			|			И Renault_АвтосервисПланОперативныйСрезПоследних.ЭтапРабот = Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот
			|ГДЕ
			|	Renault_АвтосервисПланОперативныйСрезПоследних.Обращение = &Обращение
			|	И ТИПЗНАЧЕНИЯ(Renault_АвтосервисПланОперативныйСрезПоследних.РабочийДокумент) <> ТИП(Документ.Renault_CRM_ВыдачаАвтомобиля)
			|	И Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы <> &Статус";
			
			Запрос.УстановитьПараметр("Статус", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
			Запрос.УстановитьПараметр("Обращение", Обращение);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.ВремяОкончания > ВремяНачалаРаботы Тогда
					
					#Если Клиент Тогда
					
						Режим = РежимДиалогаВопрос.ОКОтмена;
						Ответ = Вопрос("Выдачу нельзя начинать до завершения всех работ!", Режим, 0);
						Если Ответ = КодВозвратаДиалога.Отмена Тогда
							
							ОтказВПерепланировании = Истина;
							Возврат Ложь;
							
						КонецЕсли;
					
					#Иначе
						
						Ошибка = "Выдачу нельзя начинать до завершения всех работ!";
						Возврат Ложь;
					
					#КонецЕсли
					
				КонецЕсли;
			КонецЦикла;
		
		КонецЕсли;
		
		НовыйДокумент.Дата = ТекущаяДата();
		//НовыйДокумент.Клиент = ТекущийКлиент;
		//НовыйДокумент.Обращение = ТекущееОбращение;
		НовыйДокумент.Автор = ПараметрыСеанса.Пользователь;
		НовыйДокумент.Автомобиль = Обращение.Автомобиль;
		//НовыйДокумент.ГосНомер = ГосНомер;
		НовыйДокумент.Машиноместо = Машиноместо;
		ВремяНачала = ВремяНачалаРаботы;
		НовыйДокумент.ВремяНачала = ВремяНачала;
		ВремяОкончания = ВремяНачала + ДлительностьПоУмолчаниюВыдача;
		НовыйДокумент.ВремяОкончания = ВремяОкончания;
		ДлительностьДокумента = ДлительностьПоУмолчаниюВыдача;
		Попытка
			НовыйДокумент.Записать();
			ДокументСоздан = Истина;
			
			Набор = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
			//Набор.Отбор.Обращение.Установить(ТекущееОбращение);
			Набор.Отбор.Обращение.Установить(НовыйДокумент.Обращение);
			Набор.Отбор.РабочийДокумент.Установить(НовыйДокумент.Ссылка);
			Набор.Прочитать();
			Набор.Очистить();
			Запись = Набор.Добавить();
			
			Запись.ДилерскийЦентр = ДилерскийЦентр;
			//Запись.Обращение = ТекущееОбращение;
			Запись.Обращение = НовыйДокумент.Обращение;
			Запись.РабочийДокумент = НовыйДокумент.Ссылка;
			Запись.Цех = Машиноместо;
			Запись.ЭтапРабот = 1;
			Запись.Период = ТекущаяДата();
			//Запись.ДатаВремяИзменения = ТекущаяДата();
			Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована;
			Набор.Записать();
			
			Набор = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьНаборЗаписей();
			//Набор.Отбор.Обращение.Установить(ТекущееОбращение);
			Набор.Отбор.Обращение.Установить(НовыйДокумент.Обращение);
			Набор.Отбор.РабочийДокумент.Установить(НовыйДокумент.Ссылка);
			Набор.Прочитать();
			Набор.Очистить();
			Запись = Набор.Добавить();
			
			Запись.ДилерскийЦентр = ДилерскийЦентр;
			//Запись.Обращение = ТекущееОбращение;
			Запись.Обращение = НовыйДокумент.Обращение;
			Запись.РабочийДокумент = НовыйДокумент.Ссылка;
			Запись.Цех = Машиноместо;
			Запись.ЭтапРабот = 1;
			Запись.ВремяНачала = ВремяНачала;
			Запись.ВремяОкончания = ВремяОкончания;
			Запись.Длительность = ДлительностьПоУмолчаниюВыдача/3600;
			Набор.Записать();
			
		Исключение
			
			Сообщить(Строка(ИнформацияОбОшибке()) + " " + Строка(ОписаниеОшибки()));
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;

		КонецПопытки;
		
	КонецЕсли;
	
	Если ДокументСоздан Тогда
		СтруктураСозданногоОбъекта = Новый Структура;
		СтруктураСозданногоОбъекта.Вставить("Документ", НовыйДокумент.Ссылка);
		СтруктураСозданногоОбъекта.Вставить("Машиноместо", Машиноместо);
		СтруктураСозданногоОбъекта.Вставить("Длительность", ДлительностьДокумента / 3600);
		СтруктураСозданногоОбъекта.Вставить("ВремяНачала", ВремяНачала);
		СтруктураСозданногоОбъекта.Вставить("ВремяОкончания", ВремяОкончания);
		СтруктураСозданногоОбъекта.Вставить("Дата", ВремяНачала);
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

Процедура ПереносНезавершенныхРабот(Параметры1 = Неопределено) Экспорт
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаНачата);
	МассивСтатусов.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПауза);
	МассивСтатусов.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПросрочена);
	
	СледующийДень = КонецДня(ТекущаяДата()) + 1;
	НачалоРабочегоДня = '00010101080000';
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	DMS_АРМ_Автосервис.ДилерскийЦентр,
	|	DMS_АРМ_Автосервис.РабочийПериод,
	|	DMS_АРМ_Автосервис.Обращение,
	|	DMS_АРМ_Автосервис.РабочийДокумент,
	|	DMS_АРМ_Автосервис.ВремяНачалаРег,
	|	DMS_АРМ_Автосервис.ВремяОкончанияРег,
	|	DMS_АРМ_Автосервис.ВремяНачала,
	|	DMS_АРМ_Автосервис.ВремяОкончания,
	|	DMS_АРМ_Автосервис.Узор,
	|	DMS_АРМ_Автосервис.Цвет,
	|	DMS_АРМ_Автосервис.ГосНомер,
	|	DMS_АРМ_Автосервис.Модель,
	|	DMS_АРМ_Автосервис.Клиент,
	|	DMS_АРМ_Автосервис.ТипПаузы,
	|	DMS_АРМ_Автосервис.Статус,
	|	DMS_АРМ_Автосервис.ЭтапРабот,
	|	DMS_АРМ_Автосервис.Цех,
	|	DMS_АРМ_Автосервис.ПризнакМодифицированности,
	|	CRM_ДилерскиеЦентрыАвтосервисГрафикРабот.НачалоРабочегоДня
	|ИЗ
	|	РегистрСведений.DMS_АРМ_Автосервис КАК DMS_АРМ_Автосервис
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_ДилерскиеЦентры.АвтосервисГрафикРабот КАК CRM_ДилерскиеЦентрыАвтосервисГрафикРабот
	|		ПО DMS_АРМ_Автосервис.ДилерскийЦентр = CRM_ДилерскиеЦентрыАвтосервисГрафикРабот.Ссылка
	|ГДЕ
	|	DMS_АРМ_Автосервис.РабочийПериод = &РабочийПериод
	|	И DMS_АРМ_Автосервис.Статус В(&Статус)
	|	И CRM_ДилерскиеЦентрыАвтосервисГрафикРабот.ДеньНедели = &ДеньНедели
	|	И ТИПЗНАЧЕНИЯ(DMS_АРМ_Автосервис.РабочийДокумент) = ТИП(Документ.Renault_CRM_ЗаявкаНаСервис)";
	
	Запрос.УстановитьПараметр("РабочийПериод", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Статус", МассивСтатусов);
	Запрос.УстановитьПараметр("ДеньНедели", ДеньНедели(СледующийДень));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		мНачалоРабочегоДня = ?(ЗначениеЗаполнено(Выборка.НачалоРабочегоДня), Выборка.НачалоРабочегоДня, НачалоРабочегоДня);
		Запись = РегистрыСведений.DMS_АРМ_Автосервис.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка, , "РабочийПериод, ВремяНачала, ВремяОкончания");
		Запись.РабочийПериод = СледующийДень;
		Запись.ВремяНачала = СледующийДень + 3600 * Час(мНачалоРабочегоДня) + 60 * Минута(мНачалоРабочегоДня) + Секунда(мНачалоРабочегоДня);
		
		Попытка
			Запись.Записать();
		Исключение
			Информация = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации("Перенос авторабот на следующий день", УровеньЖурналаРегистрации.Ошибка, Метаданные.РегламентныеЗадания.DMS_ПереносНезаконченныхРабот, , ПодробноеПредставлениеОшибки(Информация));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры
