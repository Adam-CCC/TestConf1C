	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьПродвинутыйМеханизмПеремещений Тогда
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Если Источник.DMS_Статус = Источник.Ссылка.DMS_Статус Тогда
				Отказ = Renault_ОбщегоНазначенияКлиентСервер.ПроверитьДатуОперации(Источник);
			КонецЕсли;
			
			Если Источник.СкладКомпании.Renault_Территория = Источник.СкладПолучатель.Renault_Территория Тогда
				Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто;
			КонецЕсли;
			
		ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.ВПути;
		КонецЕсли;
						
		Если Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
			Источник.DMS_Принял = ПараметрыСеанса.Пользователь;
		ИначеЕсли Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.ВПути Тогда
			Если Источник.СкладКомпании.Renault_Территория = Источник.СкладПолучатель.Renault_Территория Тогда
				Источник.DMS_Принял = ПараметрыСеанса.Пользователь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

