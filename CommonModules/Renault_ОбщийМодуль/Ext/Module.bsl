	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТабЧасть.Ссылка КАК Регистратор,
	|	ВТ_ТабЧасть.ДатаОперации КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВТ_Остатки.Автомобиль КАК Автомобиль,
	|	ВТ_Остатки.Склад КАК СкладКомпании,
	|	ВТ_Остатки.Партия КАК Партия,
	|	ВТ_Остатки.Количество КАК Количество,
	|	ВТ_Остатки.СтатусПартии КАК СтатусПартии,
	|	&ХозОперация КАК ХозОперация,
	|	ВТ_Остатки.Сумма КАК Сумма,
	|	ВТ_Остатки.СуммаУпр КАК СуммаУпр,
	|	ВТ_Остатки.СуммаНДС КАК СуммаНДС,
	|	ВТ_Остатки.ГТД КАК ГТД
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТабЧасть КАК ВТ_ТабЧасть
	|		ПО ВТ_Остатки.Автомобиль = ВТ_ТабЧасть.Автомобиль
	|			И ВТ_Остатки.Склад = ВТ_ТабЧасть.СкладИз
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ТабЧасть.Ссылка,
	|	ВТ_ТабЧасть.ДатаОперации,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВТ_Остатки.Автомобиль,
	|	ВТ_ТабЧасть.СкладВ,
	|	ВТ_Остатки.Партия,
	|	ВТ_Остатки.Количество,
	|	ВТ_Остатки.СтатусПартии,
	|	&ХозОперация,
	|	ВТ_Остатки.Сумма,
	|	ВТ_Остатки.СуммаУпр,
	|	ВТ_Остатки.СуммаНДС,
	|	ВТ_Остатки.ГТД
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТабЧасть КАК ВТ_ТабЧасть
	|		ПО ВТ_Остатки.Автомобиль = ВТ_ТабЧасть.Автомобиль
	|			И ВТ_Остатки.Склад = ВТ_ТабЧасть.СкладИз";
	
	ОбщийЗапрос.УстановитьПараметр("Ссылка", 		Источник.Ссылка);
	ОбщийЗапрос.УстановитьПараметр("ДатаОперации",	Источник.Дата);
	ОбщийЗапрос.УстановитьПараметр("СкладИз",		Источник.СкладКомпании);
	ОбщийЗапрос.установитьПараметр("СкладЭвакуатор", СкладЭвакуатор);
	ОбщийЗапрос.УстановитьПараметр("ХозОперация",Источник.ХозОперация);

	Возврат ОбщийЗапрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура Renault_ПеремещениеАвтомобилейОбработкаУдаленияПроведенияОбработкаУдаленияПроведения(Источник, Отказ) Экспорт

	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьПродвинутыйМеханизмПеремещений Тогда

		Для Каждого Стр Из Источник.Автомобили Цикл
			
			Если ЗначениеЗаполнено(Стр.DMS_Потребность) Тогда
				НаборЗ = РегистрыСведений.Renault_ПланПеремещения.СоздатьНаборЗаписей();
				НаборЗ.Отбор.ПотребностьПеремещения.Установить(Стр.DMS_Потребность);
				НаборЗ.Прочитать();
				Для Каждого СтрокаАвто Из НаборЗ Цикл
					Если СтрокаАвто.Автомобиль = Стр.Автомобиль Тогда
						СтрокаАвто.Перемещено = Ложь;
						СтрокаАвто.ДокументПеремещения = Документы.ПеремещениеАвтомобилей.ПустаяСсылка();
					КонецЕсли;
				КонецЦикла;
				НаборЗ.Записать();
				
				//Если Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
					ПотребностьОбъект = Стр.DMS_Потребность.ПолучитьОбъект();
					ПотребностьОбъект.Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Заявка;
					ПотребностьОбъект.Записать();
				//КонецЕсли;
			
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	Renault_РазмещениеАвтомобилей.Склад,
			|	Renault_РазмещениеАвтомобилей.Место,
			|	Renault_РазмещениеАвтомобилей.Автомобиль
			|ИЗ
			|	РегистрСведений.Renault_РазмещениеАвтомобилей КАК Renault_РазмещениеАвтомобилей
			|ГДЕ
			|	Renault_РазмещениеАвтомобилей.Место = &Место
			|	И Renault_РазмещениеАвтомобилей.Автомобиль = &Автомобиль";
			
			Запрос.УстановитьПараметр("Автомобиль", Стр.Автомобиль);
			Запрос.УстановитьПараметр("Место", Стр.DMS_Место);

			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Пока Выборка.Следующий() Цикл
			
				НаборРазмещение = РегистрыСведений.Renault_РазмещениеАвтомобилей.СоздатьНаборЗаписей();
				НаборРазмещение.Отбор.Склад.Установить(ВЫборка.Склад);
				НаборРазмещение.Отбор.Место.Установить(Выборка.Место);
				НаборРазмещение.Прочитать();
				
				Если НаборРазмещение.Количество()>0 Тогда
					НаборРазмещение[0].Автомобиль = Справочники.Автомобили.ПустаяСсылка();
					НаборРазмещение.Записать();
				КонецЕсли;
			
			КонецЦикла;

		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗанятьМестаАвтомобилей(Источник)
	
	Для Каждого СтрокаАвтомобили Из Источник.Автомобили Цикл
		
		
		НаборЗаписейПоТерритории = РегистрыСведений.Renault_РазмещениеАвтомобилей.СоздатьНаборЗаписей();
		НаборЗаписейПоТерритории.Отбор.Склад.Установить(?(ЗначениеЗаполнено(Источник.СкладПолучатель.Renault_Территория), Источник.СкладПолучатель.Renault_Территория, Источник.СкладПолучатель));
		НаборЗаписейПоТерритории.Отбор.Место.Установить(СтрокаАвтомобили.DMS_Место);
		НаборЗаписейПоТерритории.Прочитать();
		
		Если НаборЗаписейПоТерритории.Количество()>0 Тогда
			НаборЗаписейПоТерритории[0].Автомобиль = СтрокаАвтомобили.Автомобиль;
			НаборЗаписейПоТерритории.Записать();
		Иначе
			НаборЗаписейПоСкладу = РегистрыСведений.Renault_РазмещениеАвтомобилей.СоздатьНаборЗаписей();
			НаборЗаписейПоСкладу.Отбор.Склад.Установить(Источник.СкладПолучатель);
			НаборЗаписейПоСкладу.Отбор.Место.Установить(СтрокаАвтомобили.DMS_Место);
			НаборЗаписейПоСкладу.Прочитать();
			
			Если НаборЗаписейПоСкладу.Количество()>0 Тогда
				НаборЗаписейПоСкладу[0].Автомобиль = СтрокаАвтомобили.Автомобиль;
				НаборЗаписейПоСкладу.Записать();
			Иначе
				Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Парковочное место " + СтрокаАвтомобили.DMS_Место + " на складе и территории отсутствует!!!");
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНачисленияВодителям(Источник)
	
	Источник.Движения.Renault_НачисленияВодителей.Записывать = Истина;
	Источник.Движения.Renault_НачисленияВодителей.Очистить();
	
	Движение = Источник.Движения.Renault_НачисленияВодителей.Добавить();
	Движение.Период = Источник.Дата;
	Движение.ОбратныйРейс = Источник.DMS_ОбратныйРейс;
	Движение.Водитель = Источник.DMS_Водитель;
	Движение.Маршрут = Источник.Автомобили[0].DMS_Потребность.Маршрут;
	Если Источник.Автомобили.Количество() = 1 Тогда
		Движение.ТипМаршрута = Перечисления.Renault_ТипМаршрута.Прямой1;
	ИначеЕсли Источник.Автомобили.Количество() = 2 Тогда
		Движение.ТипМаршрута = Перечисления.Renault_ТипМаршрута.Прямой2;
	КонецЕсли;
	
КонецПроцедуры

