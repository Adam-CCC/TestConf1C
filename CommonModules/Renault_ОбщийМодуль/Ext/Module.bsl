Процедура Renault_ПоступлениеТоваровСозданиеЗаказа(Источник, Отказ, РежимПроведения) Экспорт
	
	Если ЗначениеЗаполнено(ПараметрыСеанса.DMS_Бренд) Тогда
		СоздаватьЗаказы = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].СоздаватьЗаказыДляПоступленияТоваров;
		Если НЕ СоздаватьЗаказы Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка
		ИЛИ Отказ
		ИЛИ НЕ Источник.ДополнительныеСвойства.Свойство("ЗаписьИзФормы") Тогда
	
		Возврат;
	КонецЕсли;
	
	// Проверям, что заказами поставщику закрыты все поступившие товары
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаРаспределено.Номенклатура,
	               |	ТаблицаРаспределено.Заказано,
	               |	ТаблицаРаспределено.ХарактеристикаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_ТаблицаРаспределено
	               |ИЗ
	               |	&РаспределеноПоЗаказам КАК ТаблицаРаспределено
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Поступило.Номенклатура,
	               |	Поступило.Количество,
	               |	Поступило.ХарактеристикаНоменклатуры
	               |ПОМЕСТИТЬ ВТ_Поступило
	               |ИЗ
	               |	&ОстаткиПоступление КАК Поступило
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Поступило.Номенклатура,
	               |	Поступило.ХарактеристикаНоменклатуры,
	               |	Поступило.Количество - ЕСТЬNULL(ВТ_ТаблицаРаспределено.Заказано, 0) КАК Нераспределено
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_Поступило.Номенклатура КАК Номенклатура,
	               |		СУММА(ВТ_Поступило.Количество) КАК Количество,
	               |		ВТ_Поступило.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	               |	ИЗ
	               |		ВТ_Поступило КАК ВТ_Поступило
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_Поступило.Номенклатура,
	               |		ВТ_Поступило.ХарактеристикаНоменклатуры) КАК Поступило
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_ТаблицаРаспределено.Номенклатура КАК Номенклатура,
	               |			СУММА(ВТ_ТаблицаРаспределено.Заказано) КАК Заказано,
	               |			ВТ_ТаблицаРаспределено.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	               |		ИЗ
	               |			ВТ_ТаблицаРаспределено КАК ВТ_ТаблицаРаспределено
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_ТаблицаРаспределено.Номенклатура,
	               |			ВТ_ТаблицаРаспределено.ХарактеристикаНоменклатуры) КАК ВТ_ТаблицаРаспределено
	               |		ПО Поступило.Номенклатура = ВТ_ТаблицаРаспределено.Номенклатура
	               |			И Поступило.ХарактеристикаНоменклатуры = ВТ_ТаблицаРаспределено.ХарактеристикаНоменклатуры
	               |ГДЕ
	               |	Поступило.Количество - ЕСТЬNULL(ВТ_ТаблицаРаспределено.Заказано, 0) > 0";
	
	Запрос.УстановитьПараметр("РаспределеноПоЗаказам", Источник.Движения.ЗаказыПоставщикам.Выгрузить());
	Запрос.УстановитьПараметр("ОстаткиПоступление", Источник.Движения.ОстаткиТоваровКомпании.Выгрузить());
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
	#Если Клиент Тогда
		Если Вопрос("Есть назакрытые позиции. Создать заказ поставщику?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			
			Отказ = Истина;	
			Сообщить("Проведение без создания заказа невозможно.");
			
			Возврат;
			
		КонецЕсли;	
	#КонецЕсли
	
	ИначеЕсли Результат.Пустой() Тогда
		Возврат; // все ок
	КонецЕсли;
	
	ЗаказПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();
	
	ДатаЗаказа = ?(Источник.Дата = НачалоДня(Источник.Дата), НачалоДня(Источник.Дата-1), НачалоДня(Источник.Дата));
	
	ЗаказПоставщику.Дата = ДатаЗаказа; // дата должна быть меньше даты поступления, иначе не распределится
	ЗаказПоставщику.Комментарий = "#Создан автоматически при проведении поступления: " + Источник.Ссылка;
	ЗаказПоставщику.Заполнить(Источник.Ссылка);
	//ЗаказПоставщику.ДокументОснование = Неопределено;
	
	ЗаказПоставщику.Товары.Очистить();

	ВыборкаНераспределено = Результат.Выбрать();
	Пока ВыборкаНераспределено.Следующий() Цикл
		СтрокаПоступления = Источник.Товары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", ВыборкаНераспределено.Номенклатура, ВыборкаНераспределено.ХарактеристикаНоменклатуры))[0];
		
		СтрокаТовары = ЗаказПоставщику.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТовары, СтрокаПоступления); 

		СтрокаТовары.Количество = ВыборкаНераспределено.Нераспределено / СтрокаТовары.Коэффициент;
		ЗаказПоставщику.ОбработкаРеквизита("Товары.Количество", СтрокаТовары);
	КонецЦикла;

    // Очищаем, чтобы небыло сообщения о том, что документ проведен раньше документа основания
    //ЗаказПоставщику.ДокументОснование = Неопределено; 
    // Озеров: Пусть все-таки выдает сообщение, зато видим иерархию.

	ЗаказПоставщику.Записать(РежимЗаписиДокумента.Проведение);

	Источник.ДополнительныеСвойства.Вставить("ЗаказСоздан");
	Источник.ДополнительныеСвойства.Вставить("ЗаказПоставщику", ЗаказПоставщику.Ссылка);
	
КонецПроцедуры

Процедура Renault_ЗаписьПлановыхДатПоступленияПоЗаказуПоставщикуОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	НаборЗаписей = РегистрыСведений.Renault_ПлановыеДатыПоступления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заказ.Установить(Источник.Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Для каждого СтрокаТовары Из Источник.Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовары.Renault_ДатаПоступления) Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = НаборЗаписей.Добавить();
		Запись.Номенклатура = СтрокаТовары.Номенклатура;
		Запись.Характеристика = СтрокаТовары.ХарактеристикаНоменклатуры;
		Запись.Заказ = Источник.Ссылка;
		Запись.КлючСтроки = СтрокаТовары.НомерСтроки;
		Запись.ДатаПоступления = СтрокаТовары.Renault_ДатаПоступления;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура Renault_ЗаписьПлановыхДатПоступленияПоЗаказуПоставщикуОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	НаборЗаписей = РегистрыСведений.Renault_ПлановыеДатыПоступления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заказ.Установить(Источник.Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
КонецПроцедуры

