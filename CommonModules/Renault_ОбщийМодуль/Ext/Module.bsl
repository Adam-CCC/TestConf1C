Процедура РассылкаОповещенийККП(Парам=Неопределено) Экспорт
	
	Попытка 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_ЭтапыККПИсполнители.Сотрудник,
		|	DMS_ЭтапыККПИсполнители.Ссылка КАК ЭтапККП
		|ИЗ
		|	Справочник.DMS_ЭтапыККП.Исполнители КАК DMS_ЭтапыККПИсполнители
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";
		
		ИсполнителиЭтаповККП = Запрос.Выполнить().Выгрузить();
		ИсполнителиЭтаповККП.Индексы.Добавить("ЭтапККП");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_КартаКачестваПоставки.Ссылка,
		|	DMS_КартаКачестваПоставки.ВыполненПриемкаАвтомобиля,
		|	DMS_КартаКачестваПоставки.ВыполненПланированиеПредпродажнойПодготовки,
		|	DMS_КартаКачестваПоставки.ВыполненПредпродажнаяПодготовка,
		|	DMS_КартаКачестваПоставки.ВыполненТоржественнаяВыдача
		|ИЗ
		|	Документ.DMS_КартаКачестваПоставки КАК DMS_КартаКачестваПоставки
		|ГДЕ
		|	DMS_КартаКачестваПоставки.ВыполненТоржественнаяВыдача = ЛОЖЬ";
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если НЕ Выборка.ВыполненПриемкаАвтомобиля Тогда
				Этап = Справочники.DMS_ЭтапыККП.ПриемкаАвтомобиля;  
			ИначеЕсли НЕ Выборка.ВыполненПланированиеПредпродажнойПодготовки Тогда
				Этап = Справочники.DMS_ЭтапыККП.ПланированиеПредпродажнойПодготовки;  
			ИначеЕсли НЕ Выборка.ВыполненПредпродажнаяПодготовка Тогда
				Этап = Справочники.DMS_ЭтапыККП.ПредпродажнаяПодготовка;  
			ИначеЕсли НЕ Выборка.ВыполненТоржественнаяВыдача Тогда
				Этап = Справочники.DMS_ЭтапыККП.ТоржественнаяВыдача;  
			Иначе
				Продолжить;
			КонецЕсли;
			
			УИД = Строка(Выборка.Ссылка.УникальныйИдентификатор());

			МассивИсполнителей = ИсполнителиЭтаповККП.НайтиСтроки(Новый Структура("ЭтапККП",Этап));
			Если МассивИсполнителей.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			//формируются оповещения о запланированных этапах ККП
			ДатаСобытия = ТекущаяДата();
			Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			Напоминание.Отправитель = "Система";
			Напоминание.ДатаОтправки = ДатаСобытия;
			Напоминание.Комментарий = Этап.Наименование;
			Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.НазначениеЭтапаККП;
			Напоминание.ПоказыватьС = ДатаСобытия;
			Напоминание.ПоказыватьПо = ДатаСобытия+900;
			Напоминание.Наименование = "Назначение этапа ККП";
			Напоминание.Сообщение = "Вам назначен этап ККП";
			Напоминание.ИдентификаторОбъекта = УИД;
				
			Для каждого Сотр из МассивИсполнителей Цикл
				
				//Сообщение для обработки Renault_ПанельСообщений - не используется.
				//МенеджерРС = РегистрыСведений.Renault_СообщенияСотрудникам.СоздатьМенеджерЗаписи();
				//МенеджерРС.УИД  = УИД;
				//МенеджерРС.ВидСообщения = Справочники.Renault_ВидСообщения.НазначениеЭтапаККП;
				//МенеджерРС.Получатель = Сотр.Пользователь;
				//МенеджерРС.ДатаСобытия = ДатаСобытия;
				//МенеджерРС.ТекстСообщения = "Вам назначен этап ККП: "+Этап.Наименование;
				//МенеджерРС.ВыполнитьОдному = Истина;
				//МенеджерРС.Записать();
				
				Напоминание.Адресаты.Добавить().Сотрудник = Сотр.Сотрудник;
				
			КонецЦикла;
			
			Напоминание.Записать();
				
		КонецЦикла;
		
		ЗаписьЖурналаРегистрации("Рассылка оповещений ККП",,,,"Успешно выполнена рассылка оповещений по этапам ККП");	
	Исключение
		ЗаписьЖурналаРегистрации("Рассылка оповещений ККП",,,,ОписаниеОшибки());	
	КонецПопытки

КонецПроцедуры

	
