Процедура ОтправитьПисьмоИзКарточкиКонтрагента(Контрагент, ФормаРодитель) Экспорт
	
	ТекстСообщения = "";
	
	ЗаголовокПисьма = Константы.DMS_ШаблонЗаголовкаПисьма.Получить();
	
	BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	
	ФормаСообщений = ПолучитьОбщуюФорму("Renault_ФормаОтправкиСообщенийКлиенту", ФормаРодитель);
	СписокПараметров = Новый СписокЗначений;
	СписокПараметров.Добавить(Контрагент);
	СписокПараметров.Добавить(Справочники.Автомобили.ПустаяСсылка());
	ФормаСообщений.СписокПараметров = СписокПараметров;
	ТекстСообщения = ФормаСообщений.ОткрытьМодально();
	
	ПочтаКлиента = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Контрагент);
	
	Если Не ЗначениеЗаполнено(ПочтаКлиента) Тогда
		
		#Если Клиент Тогда
			Предупреждение("У клиента не указан адрес электронной почты");
		#КонецЕсли
		Возврат;
		
	КонецЕсли;
	
	//Для Каждого СтрокаЗначений ИЗ ТекущийКонтакт.ОснованиеДляКонтакта_Значения Цикл
	//	Тег = "<" + СтрокаЗначений.ИмяКолонки + ">";
	//	ЗаголовокПисьма = СтрЗаменить(ЗаголовокПисьма, Тег, Строка(СтрокаЗначений.Значение));
	//КонецЦикла;
	
	ЗаголовокПисьма = Строка(Renault_CRM.ПолучитьДилерскийЦентрПользователя());
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		
		ТаблицаСообщений = Новый ТаблицаЗначений;
		ТаблицаСообщений.Колонки.Добавить("Получатели");
		ТаблицаСообщений.Колонки.Добавить("ТекстСообщения");
		ТаблицаСообщений.Колонки.Добавить("BIR");
		ТаблицаСообщений.Колонки.Добавить("ТипТекстаСообщения");
		
		НоваяСтрока = ТаблицаСообщений.Добавить();
		НоваяСтрока.BIR = BIR; // "99999999";
		СсылкаНаКартинку = " <IMG src=""http://app.renault.ru/pixel.php?subid="+ ПочтаКлиента + "&campaign=" + "no" + "&bir="+BIR+""">";
		НоваяСтрока.ТекстСообщения = ЗаголовокПисьма  + Символы.ПС + ТекстСообщения +СсылкаНаКартинку;
		
		НоваяСтрока.ТипТекстаСообщения = "HTML";
		
		Получатели = Новый ТаблицаЗначений;
		Получатели.Колонки.Добавить("Адрес");
		
		СтрокаПолучатели = Получатели.Добавить();
		СтрокаПолучатели.Адрес = ПочтаКлиента;
		
		НоваяСтрока.Получатели = Получатели;
		
		DMS_ВзаимодействияСКлиентом.ВыполнитьРассылкуПисем(ТаблицаСообщений);
		
	КонецЕсли;

	
КонецПроцедуры

Процедура ОтправитьСМСИзКарточкиКонтрагента(Контрагент, ФормаРодитель) Экспорт
	
	  ТелефонКлиента = Renault_АвтосервисОбщий.Renault_ВыбратьТелефон(Контрагент);
	
	Если НЕ ЗначениеЗаполнено(ТелефонКлиента) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Если Не ЗначениеЗаполнено(ДЦ) Тогда
		
		#Если Клиент Тогда
		
			Предупреждение("У пользователя не указан дилерский центр");
		
		#КонецЕсли
		
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = "";
	
	ФормаСообщений = ПолучитьОбщуюФорму("Renault_ФормаОтправкиСообщенийКлиенту", ФормаРодитель);
	СписокПараметров = Новый СписокЗначений;
	СписокПараметров.Добавить(Контрагент);
	СписокПараметров.Добавить(Справочники.Автомобили.ПустаяСсылка());
	ФормаСообщений.СписокПараметров = СписокПараметров;
	
	ТекстСообщения = ФормаСообщений.ОткрытьМодально();
	
	//Если ЕстьСообщение = Истина Тогда
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ТаблицаСообщений = Новый ТаблицаЗначений;
		ТаблицаСообщений.Колонки.Добавить("Получатели");
		ТаблицаСообщений.Колонки.Добавить("ТекстСообщения");
		ТаблицаСообщений.Колонки.Добавить("BIR");
		НоваяСтрока = ТаблицаСообщений.Добавить();
		НоваяСтрока.BIR = ДЦ.BIR;
		
		НоваяСтрока.ТекстСообщения = ТекстСообщения;
		Получатели = Новый ТаблицаЗначений;
		Получатели.Колонки.Добавить("Телефон");
		СтрокаПолучатель = Получатели.Добавить();
		СтрокаПолучатель.Телефон = ТелефонКлиента;
		НоваяСтрока.Получатели = Получатели;
		
		ТаблицаКВозврату = DMS_ВзаимодействияСКлиентом.ВыполнитьРассылкуСМС(ТаблицаСообщений);
		
		Для Каждого Строка ИЗ ТаблицаКВозврату Цикл
			СтруктураРезультата = Строка.Результат;
			МассивСтруктурРезультата = СтруктураРезультата.ОтправленныеСообщения;
			Для Каждого СтруктураРезультата ИЗ МассивСтруктурРезультата Цикл
				ИдентификаторСообщения = СтруктураРезультата.ИдентификаторСообщения;
			КонецЦикла;
		КонецЦикла;
				
	КонецЕсли;

	
КонецПроцедуры

Процедура НайтиСогласиеНаобработку(Контрагент, ЭтаФорма) Экспорт
	
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Если НЕ ЗначениеЗаполнено(ДЦ) Тогда
		
		Сообщить("Не указан дилерский центр пользователя");
		
		Возврат;
		
	КонецЕсли;
	
	Ошибка = "";
	
	ФИОПОиск = Контрагент.Наименование;
	
	ТаблицаРезультат = Renault_РаботаСSalesTablet.ПолучитьТаблицуСоглашения(ДЦ, ФИОПОиск, Контрагент.ДатаРождения, Ошибка);
	
	
	Если Не ЗначениеЗаполнено(ТаблицаРезультат) И ЗначениеЗаполнено(Ошибка) Тогда
		
		Сообщить("При поиске произошла ошибка: " + Строка(Ошибка));
		Возврат;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ТаблицаРезультат) Тогда
		
		Сообщить("Нет данных по этому клиенту");
		Возврат;
		
	КонецЕсли;
	
	Форма = ПолучитьОбщуюФорму("Renault_ПоискСогласияНаОбработкуПД");
	
	ТаблицаКлиенты = Форма.ТаблицаКлиенты.Скопировать();
	
	Для Каждого Стр из ТаблицаРезультат Цикл
		
		НовСтр = ТаблицаКлиенты.Добавить();
		НовСтр.ИмяФайлаНаСервере = Стр.ИмяФайла;
		НовСтр.ДатаСогласия = Стр.ДатаСогласия;
		НовСтр.ФИО = Контрагент.Наименование;
		НовСтр.Датарождения = Контрагент.ДатаРождения;
		
	КонецЦикла;
	
	Форма.ТаблицаКлиенты = ТаблицаКлиенты;
	
	Форма.Открыть();	
	
КонецПроцедуры

Функция ПолучитьНомераСотрудника(Сотрудник)
	
	
	ТекСотрудник = Сотрудник;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КонтактнаяИнформация.Представление КАК Номер
	                      |ИЗ
	                      |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                      |ГДЕ
	                      |	КонтактнаяИнформация.Тип = &Тип
	                      |	И КонтактнаяИнформация.Вид.Наименование ПОДОБНО ""Внутренний%""
	                      |	И КонтактнаяИнформация.Объект = &Объект");
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Объект",ТекСотрудник);
	
	Номер = "Номер не указан!  ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 тогда
		Номер = "";
		Пока Выборка.Следующий() Цикл
			Номер = Номер + Выборка.Номер +"; ";
		КонецЦикла;
	КонецЕсли;
	
	Номер = Лев(Номер,СтрДлина(Номер)-2);
	
	Возврат Номер;
	
КонецФункции


