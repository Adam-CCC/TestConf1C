	Если Источник.ЭтоГруппа тогда возврат КонецЕсли;
	
	//Для помеченных на удаление так же не вызываем
	Если Источник.ПометкаУдаления тогда возврат КонецЕсли;
	
	//Нужно просмотреть № по каталогу (Артикул)
	//и прописать ссылку на эту работу в регистр OPERACODE_НормыРабот
	Если ЗначениеЗаполнено(Источник.Артикул) тогда //№ по каталогу указан
			
			//Создаем набор записей регистра сведений, которые будем переписывать.
			НаборЗаписей = РегистрыСведений.OPERACODE_НормыРабот.СоздатьНаборЗаписей();
			
			//Устанавливаем отбор и считываем
			НаборЗаписей.Отбор.КодПоКаталогу.Установить(СокрЛП(Источник.Артикул));
			НаборЗаписей.Прочитать();
			
			//Выгрузим в таблицу значений для пакетной обработки.
			ВремТЗ = НаборЗаписей.Выгрузить();
			Если ВремТЗ.Количество() > 0 тогда
				ВремТЗ.ЗаполнитьЗначения(Источник.Ссылка,"Авторабота");
				
				НаборЗаписей.Загрузить(ВремТЗ);
				НаборЗаписей.Записать();
			КонецЕсли;
		КонецЕсли;

КонецПроцедуры // OPERACODE_СопоставлениеАвтоработАвтоработыПриЗаписи(Источник, Отказ)

Процедура ПолучитьТекстЗаголовкаИРасписанияРегламентнойНастройки(Задание, ТекстЗаголовка, ТекстРасписания, РассписаниеАктивно) Экспорт
	
	РассписаниеАктивно = Ложь;
	
	ТекстЗаголовка = "Дополнительные настройки расписания ...";
	
	Если Задание = Неопределено Тогда
		
		ТекстРасписания = "<Расписание не задано>";
		
	Иначе
		
		Если Задание.Использование Тогда
			ПрефиксРасписания = "Расписание: ";
			РассписаниеАктивно = Истина;
		Иначе
			ПрефиксРасписания = "Расписание (НЕ АКТИВНО): ";
		КонецЕсли;
		
		ТекстРасписания = ПрефиксРасписания + Строка(Задание.Расписание);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПредставлениеСотрудника() Экспорт
	
	Пользователь = ПараметрыСеанса.Пользователь;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) тогда
		Возврат "<Текущий пользователь не определен>";
	КонецЕсли;
	
	Сотрудник = Пользователь.Сотрудник;
	
	
	Если НЕ ЗначениеЗаполнено(Сотрудник) тогда
		
		ПредставлениеСотрудника = "Пользователь <" + СокрЛП(Пользователь.Наименование) +">. Сотрудник не назначен.";
		
	Иначе
		
		ПредставлениеСотрудника = СокрЛП(Сотрудник.Наименование);
		
	КонецЕсли;
	
	Возврат ПредставлениеСотрудника;
	
КонецФункции

