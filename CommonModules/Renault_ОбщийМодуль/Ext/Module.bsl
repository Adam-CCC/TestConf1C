Процедура Renault_АвтосервисПриЗаписиЗаказНарядаПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен 
	 И Источник.ВидРемонта = Справочники.ВидыРемонта.КомплектацияАвтомобиля 
	 И Не Отказ Тогда
		
		ШапкаДокумента = Источник.ПолучитьШапкуДокумента(Источник.Ссылка);
		ВидРемонта = Источник.ВидРемонта;
		
		//Если НЕ обЗначениеНеЗаполнено(ВидРемонта) Тогда
		//	Если ВидРемонта.ТипРемонта=Перечисления.ТипыРемонта.Бесплатный И ВидРемонта<>Справочники.ВидыРемонта.КомплектацияАвтомобиля Тогда
		//		НаСебестоимость=ВидРемонта.НаСебестоимость;
		//	Иначе
		//		НаСебестоимость=Ложь;
		//	КонецЕсли;
		//Иначе
		//	НаСебестоимость=Ложь;
		//КонецЕсли;
		
		ВалютаРегл=Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить(); 
		СтруктураКурса = обКурсДляВалюты(ВалютаРегл,ШапкаДокумента.МоментВремени);
		КурсРегл	   = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
		ВалютаУпр=Константы.ВалютаУправленческогоУчетаКомпании.Получить(); 
		Попытка
			КурсУпр=ШапкаДокумента.КурсВалютыУпр;
		Исключение
			КурсУпр=Неопределено;
		КонецПопытки; 
		Если КурсУпр=Неопределено ИЛИ обЗначениеНеЗаполнено(КурсУпр) Тогда
			СтруктураКурса = обКурсДляВалюты(ВалютаУпр,ШапкаДокумента.МоментВремени);
			КурсУпр		   = СтруктураКурса.Курс / ?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
		КонецЕсли;
		
		ТаблицаТовары = Источник.Товары;
		
		НаборЗаписей = РегистрыНакопления.КомплектацияАвтомобилей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Значение=ШапкаДокумента.Ссылка;
		НаборЗаписей.Отбор.Регистратор.Использование=Истина;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ОстаткиАвтомобилейОстатки.СкладКомпании КАК СкладКомпании,
		|	ОстаткиАвтомобилейОстатки.Партия КАК Партия,
		|	ОстаткиАвтомобилейОстатки.СтатусПартии КАК СтатусПартии,
		|	ОстаткиАвтомобилейОстатки.ГТД КАК ГТД
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&НаДату, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки
		|ГДЕ
		|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0";
		Запрос.УстановитьПараметр("НаДату",ШапкаДокумента.МоментВремени);
		Запрос.УстановитьПараметр("Автомобиль",ШапкаДокумента.Автомобиль);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПартияКомплектуемогоАвтомобиля=Выборка.Партия;
			СтатусПартииКомплектуемогоАвтомобиля=Выборка.СтатусПартии;
			ГТДКомплектуемогоАвтомобиля=Выборка.ГТД;
			АвтомобильСкладКомпании=Выборка.СкладКомпании;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТоварыВПроизводствеОстатки.Цех.Организация КАК Организация,
		               |	ТоварыВПроизводствеОстатки.Цех КАК Цех,
		               |	ТоварыВПроизводствеОстатки.Номенклатура КАК Номенклатура,
		               |	ТоварыВПроизводствеОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		               |	ТоварыВПроизводствеОстатки.СтатусПартии КАК СтатусПартии,
		               |	ТоварыВПроизводствеОстатки.Партия КАК Партия,
		               |	ТоварыВПроизводствеОстатки.Партия.Контрагент КАК Поставщик,
		               |	ТоварыВПроизводствеОстатки.Партия.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
		               |	ТоварыВПроизводствеОстатки.ГТД КАК ГТД,
		               |	СУММА(ТоварыВПроизводствеОстатки.КоличествоОстаток) КАК Количество,
		               |	СУММА(ТоварыВПроизводствеОстатки.СуммаОстаток) КАК Сумма,
		               |	СУММА(ТоварыВПроизводствеОстатки.СуммаУпрОстаток) КАК СуммаУпр,
		               |	СУММА(ТоварыВПроизводствеОстатки.СуммаНДСОстаток) КАК СуммаНДС
		               |ИЗ
		               |	РегистрНакопления.ТоварыВПроизводстве.Остатки(, ЗаказНаряд = &ЗаказНаряд) КАК ТоварыВПроизводствеОстатки
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТоварыВПроизводствеОстатки.Цех,
		               |	ТоварыВПроизводствеОстатки.Номенклатура,
		               |	ТоварыВПроизводствеОстатки.ХарактеристикаНоменклатуры,
		               |	ТоварыВПроизводствеОстатки.СтатусПартии,
		               |	ТоварыВПроизводствеОстатки.Партия,
		               |	ТоварыВПроизводствеОстатки.Партия.Контрагент,
		               |	ТоварыВПроизводствеОстатки.Партия.ДоговорВзаиморасчетов,
		               |	ТоварыВПроизводствеОстатки.ГТД
		               |
		               |ДЛЯ ИЗМЕНЕНИЯ";
		Запрос.УстановитьПараметр("ЗаказНаряд",ШапкаДокумента.Ссылка);
		// Наложим блокировку на считываемые данные
		СтруктураПараметровБлокировки = Новый Структура("ТипТаблицы, ИмяТаблицы", "РегистрНакопления", "ТоварыВПроизводстве");
		ЗначенияБлокировки = Новый Соответствие;
		ЗначенияБлокировки.Вставить("Период", Новый Диапазон(, ШапкаДокумента.Дата)); 
		ЗначенияБлокировки.Вставить("ЗаказНаряд", ШапкаДокумента.Ссылка); 
		обУстановитьУправляемуюБлокировку(СтруктураПараметровБлокировки, ЗначенияБлокировки);
		тзДеталиВПроизводстве = Запрос.Выполнить().Выгрузить();
		
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ
					 |	ЗаказНарядТовары.Номенклатура,
					 |	ЗаказНарядТовары.ХарактеристикаНоменклатуры,
					 |	ЗаказНарядТовары.СтавкаНДС,
					 |	СУММА(ЗаказНарядТовары.Количество * ЗаказНарядТовары.Коэффициент) КАК Количество,
					 |	СУММА(ЗаказНарядТовары.СуммаНДС) КАК СуммаНДС,
					 |	СУММА(ЗаказНарядТовары.СуммаСкидки + ЗаказНарядТовары.СуммаСкидкиСтроки + ЗаказНарядТовары.СуммаСкидкиБонусами) КАК СуммаСкидки,
					 |	СУММА(ЗаказНарядТовары.СуммаВсего) КАК СуммаВсего
					 |ИЗ
					 |	Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
					 |ГДЕ
					 |	ЗаказНарядТовары.Ссылка = &ЗаказНаряд
					 |СГРУППИРОВАТЬ ПО
					 |	ЗаказНарядТовары.Номенклатура,
					 |	ЗаказНарядТовары.ХарактеристикаНоменклатуры,
					 |	ЗаказНарядТовары.СтавкаНДС";
		Запрос.УстановитьПараметр("ЗаказНаряд",ШапкаДокумента.Ссылка);
		тзДеталиЗаказНаряда=Запрос.Выполнить().Выгрузить();
		Сообщение="";
		Для каждого СтрокаЗаказНаряда Из тзДеталиЗаказНаряда Цикл
			
			СуммаПродажи=Окр(обПересчет(СтрокаЗаказНаряда.СуммаВсего,ШапкаДокумента.ВалютаДокумента,ШапкаДокумента.КурсДокумента,ВалютаРегл,КурсРегл),2);
			СуммаПродажиУпр=Окр(обПересчет(СтрокаЗаказНаряда.СуммаВсего,ШапкаДокумента.ВалютаДокумента,ШапкаДокумента.КурсДокумента,ВалютаУпр,КурсУпр),2);
			СуммаНДСПродажи=Окр(обПересчет(СтрокаЗаказНаряда.СуммаНДС,ШапкаДокумента.ВалютаДокумента,ШапкаДокумента.КурсДокумента,ВалютаРегл,КурсРегл),2);
			СуммаСкидкиПродажи=Окр(обПересчет(СтрокаЗаказНаряда.СуммаСкидки,ШапкаДокумента.ВалютаДокумента,ШапкаДокумента.КурсДокумента,ВалютаРегл,КурсРегл),2);
			СтрокиВПроизводстве=тзДеталиВПроизводстве.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",СтрокаЗаказНаряда.Номенклатура,СтрокаЗаказНаряда.ХарактеристикаНоменклатуры));
			ОсталосьСписать=СтрокаЗаказНаряда.Количество; Списано=0;
			
			//Если НаСебестоимость Тогда
			//	СуммаНаСебестоимость=СуммаНаСебестоимость+СуммаПродажи;
			//	СуммаУпрНаСебестоимость=СуммаУпрНаСебестоимость+СуммаПродажиУпр;
			//	СуммаНДСНаСебестоимость=СуммаНДСНаСебестоимость+СуммаНДСПродажи;
			//КонецЕсли;
			
			Для каждого СтрокаВПроизводстве Из СтрокиВПроизводстве Цикл
				
				Списывается = Мин(ОсталосьСписать,СтрокаВПроизводстве.Количество);
				
				ОсталосьСписать=ОсталосьСписать-Списывается;
				Списано=Списано+Списывается;
				Сумма=?(СтрокаВПроизводстве.Количество=0,0,Окр((СтрокаВПроизводстве.Сумма*Списывается)/СтрокаВПроизводстве.Количество,2));
				СуммаУпр=?(СтрокаВПроизводстве.Количество=0,0,Окр((СтрокаВПроизводстве.СуммаУпр*Списывается)/СтрокаВПроизводстве.Количество,2));
				СуммаНДС=?(СтрокаВПроизводстве.Количество=0,0,Окр((СтрокаВПроизводстве.СуммаНДС*Списывается)/СтрокаВПроизводстве.Количество,2));
				
				СтрокаВПроизводстве.Количество=СтрокаВПроизводстве.Количество-Списывается;
				СтрокаВПроизводстве.Сумма=СтрокаВПроизводстве.Сумма-Сумма;
				СтрокаВПроизводстве.СуммаУпр=СтрокаВПроизводстве.СуммаУпр-СуммаУпр;
				СтрокаВПроизводстве.СуммаНДС=СтрокаВПроизводстве.СуммаНДС-СуммаНДС;
				
				Если СтрокаВПроизводстве.Количество=0 Тогда
					Сумма=Сумма+СтрокаВПроизводстве.Сумма;
					СуммаУпр=СуммаУпр+СтрокаВПроизводстве.СуммаУпр;
					СуммаНДС=СуммаНДС+СтрокаВПроизводстве.СуммаНДС;
				КонецЕсли;
				
				НоваяЗаписьКомплектацияАвтомобилей=НаборЗаписей.Добавить();
				НоваяЗаписьКомплектацияАвтомобилей.ВидДвижения=ВидДвиженияНакопления.Приход;
				НоваяЗаписьКомплектацияАвтомобилей.Период=ШапкаДокумента.Дата;
				НоваяЗаписьКомплектацияАвтомобилей.Регистратор=ШапкаДокумента.Ссылка;
				НоваяЗаписьКомплектацияАвтомобилей.Автомобиль=ШапкаДокумента.Автомобиль;
				НоваяЗаписьКомплектацияАвтомобилей.СкладКомпании=АвтомобильСкладКомпании;
				НоваяЗаписьКомплектацияАвтомобилей.Номенклатура=СтрокаВПроизводстве.Номенклатура;
				НоваяЗаписьКомплектацияАвтомобилей.ХарактеристикаНоменклатуры=СтрокаВПроизводстве.ХарактеристикаНоменклатуры;
				НоваяЗаписьКомплектацияАвтомобилей.СтатусПартии=Перечисления.СтатусыПартий.ТоварКупленный;
				НоваяЗаписьКомплектацияАвтомобилей.Партия=СтрокаВПроизводстве.Партия;
				НоваяЗаписьКомплектацияАвтомобилей.ГТД=СтрокаВПроизводстве.ГТД;
				НоваяЗаписьКомплектацияАвтомобилей.ХозОперация=ШапкаДокумента.ХозОперация;
				НоваяЗаписьКомплектацияАвтомобилей.СтавкаНДС=СтрокаЗаказНаряда.СтавкаНДС;
				НоваяЗаписьКомплектацияАвтомобилей.Количество=Списывается;
				НоваяЗаписьКомплектацияАвтомобилей.Сумма=Сумма;
				НоваяЗаписьКомплектацияАвтомобилей.СуммаНДС=СуммаНДС;
				НоваяЗаписьКомплектацияАвтомобилей.СуммаУпр=СуммаУпр;
				СуммаПродажи=(СтрокаЗаказНаряда.СуммаВсего*НоваяЗаписьКомплектацияАвтомобилей.Количество)/СтрокаЗаказНаряда.Количество;
				НоваяЗаписьКомплектацияАвтомобилей.СуммаПродажи=Окр(обПересчет(СуммаПродажи,ШапкаДокумента.ВалютаДокумента,ШапкаДокумента.КурсДокумента,ВалютаРегл,КурсРегл),2);
				НоваяЗаписьКомплектацияАвтомобилей.СуммаПродажиУпр=Окр(обПересчет(СуммаПродажи,ШапкаДокумента.ВалютаДокумента,ШапкаДокумента.КурсДокумента,ВалютаУпр,КурсУпр),2);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьРегистрыАвтосервиса() Экспорт
	
	ШагПланирования = 60;
	ТекВремя = ТекущаяДата();
	
	//ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	//АвтосервисНачалоРабочегоДня = ДЦ.АвтосервисНачалоРабочегоДня;
	//АвтосервисКонецРабочегоДня = ДЦ.АвтосервисКонецРабочегоДня;
	//НачалоРабочегоДня = НачалоДня(ТекущаяДата()) + 3600 * Час(АвтосервисНачалоРабочегоДня) + 60 * Минута(АвтосервисНачалоРабочегоДня) + Секунда(АвтосервисНачалоРабочегоДня);
	//КонецРабочегоДня = НачалоДня(ТекущаяДата()) + 3600 * Час(АвтосервисКонецРабочегоДня) + 60 * Минута(АвтосервисКонецРабочегоДня) + Секунда(АвтосервисКонецРабочегоДня);
	//НачалоРабочегоДня = НачалоДня(ТекущаяДата()) + 8*3600;
	//КонецРабочегоДня = НачалоРабочегоДня + 14*3600;
	
	//Запишем просроченные работы в регистр
	////////////////////////////////////////
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СправочникДЦ.Ссылка,
	|	ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(&НачалоДня, ЧАС, ЧАС(СправочникДЦ.НачалоРабочегоДня)), МИНУТА, МИНУТА(СправочникДЦ.НачалоРабочегоДня)), СЕКУНДА, СЕКУНДА(СправочникДЦ.НачалоРабочегоДня)) КАК НачалоРабочегоДня,
	|	ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(&НачалоДня, ЧАС, ЧАС(СправочникДЦ.КонецРабочегоДня)), МИНУТА, МИНУТА(СправочникДЦ.КонецРабочегоДня)), СЕКУНДА, СЕКУНДА(СправочникДЦ.КонецРабочегоДня)) КАК КонецРабочегоДня
	|ПОМЕСТИТЬ ТаблицаДЦ
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры.АвтосервисГрафикРабот КАК СправочникДЦ
	|ГДЕ
	|	СправочникДЦ.ДеньНедели = &ДеньНедели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_АвтосервисПланРабот.ДилерскийЦентр,
	|	ТаблицаДЦ.НачалоРабочегоДня КАК НачалоРабочегоДня,
	|	ТаблицаДЦ.КонецРабочегоДня КАК КонецРабочегоДня,
	|	Renault_АвтосервисПланРабот.РабочийДокумент,
	|	Renault_АвтосервисПланРабот.Цех,
	//|	Renault_АвтосервисПланРабот.Авторабота,
	|	Renault_АвтосервисПланРабот.ВремяНачала,
	|	Renault_АвтосервисПланРабот.ВремяОкончания,
	|	Renault_АвтосервисПланРабот.Длительность,
	|	Renault_АвтосервисПланРабот.ЭтапРабот,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	Renault_АвтосервисПланРабот.Обращение
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаДЦ КАК ТаблицаДЦ
	|		ПО (ТаблицаДЦ.Ссылка = Renault_АвтосервисПланРабот.ДилерскийЦентр)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО Renault_АвтосервисПланРабот.Цех = Renault_АвтосервисСтатусыРаботСрезПоследних.Цех
	|			И Renault_АвтосервисПланРабот.РабочийДокумент = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|			И Renault_АвтосервисПланРабот.ЭтапРабот = Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланОперативный.СрезПоследних КАК Renault_АвтосервисПланОперативныйСрезПоследних
	|		ПО Renault_АвтосервисПланРабот.Цех = Renault_АвтосервисПланОперативныйСрезПоследних.Цех
	|			И Renault_АвтосервисПланРабот.РабочийДокумент = Renault_АвтосервисПланОперативныйСрезПоследних.РабочийДокумент
	|			И Renault_АвтосервисПланРабот.ЭтапРабот = Renault_АвтосервисПланОперативныйСрезПоследних.ЭтапРабот
	|ГДЕ
	|	ВЫБОР
	|			КОГДА Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала ЕСТЬ NULL 
	|				ТОГДА Renault_АвтосервисПланРабот.ВремяНачала <= &ТекДата
	|			ИНАЧЕ Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала <= &ТекДата
	|		КОНЕЦ";
				   
	Запрос.УстановитьПараметр("ТекДата", ТекВремя);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекВремя));
	Запрос.УстановитьПараметр("ДеньНедели", ДеньНедели(ТекВремя));
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована Тогда
			Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
			Запись.ДилерскийЦентр = Выборка.ДилерскийЦентр;
			Запись.РабочийДокумент = Выборка.РабочийДокумент;
			Запись.Цех = Выборка.Цех;
			Запись.ЭтапРабот = Выборка.ЭтапРабот;
			Запись.Обращение = Выборка.Обращение;
			Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена;
			Запись.Период = ТекВремя;
			Запись.Записать();
		КонецЕсли;
		
		Запись = Неопределено;
		
		Если НЕ Выборка.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена
			И НЕ Выборка.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаОбед
			И НЕ Выборка.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПростой Тогда
			
			Если ТекВремя > Выборка.КонецРабочегоДня
				И Выборка.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаНачата Тогда
				Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
				Запись.ДилерскийЦентр = Выборка.ДилерскийЦентр;
				Запись.РабочийДокумент = Выборка.РабочийДокумент;
				//Запись.ДатаВремяИзменения = ТекВремя;
				Запись.Цех = Выборка.Цех;
				Запись.ЭтапРабот = Выборка.ЭтапРабот;
				Запись.Обращение = Выборка.Обращение;
				
				Если ТипЗнч(Выборка.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля")
					ИЛИ ТипЗнч(Выборка.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					
					Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена;
					Док = Выборка.РабочийДокумент.Ссылка.ПолучитьОбъект();
					Док.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен;
					Док.Записать();
					
				ИначеЕсли ТипЗнч(Выборка.РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаПодменныйАвто") Тогда
					
					Запись.СтатусРаботы = Выборка.СтатусРаботы;
					
				Иначе
					
					Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПауза;
					
				КонецЕсли;	
					
				Запись.Период = ТекВремя;
				Запись.Записать();
			КонецЕсли;
			
			//получим факт
			Запрос = Новый Запрос();
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_АвтосервисФактОперативный.Период,
			|	Renault_АвтосервисФактОперативный.Авторабота,
			|	Renault_АвтосервисФактОперативный.Цех,
			|	Renault_АвтосервисФактОперативный.РабочийДокумент,
			|	Renault_АвтосервисФактОперативный.ЭтапРабот,
			|	Renault_АвтосервисФактОперативный.ВремяНачала,
			|	Renault_АвтосервисФактОперативный.ВремяОкончания
			|ИЗ
			|	РегистрСведений.Renault_АвтосервисФактОперативный КАК Renault_АвтосервисФактОперативный
			|ГДЕ
			|	Renault_АвтосервисФактОперативный.РабочийДокумент = &РабочийДокумент
			|	И Renault_АвтосервисФактОперативный.Цех = &Цех
			|	И Renault_АвтосервисФактОперативный.ЭтапРабот = &ЭтапРабот";
			
			Запрос.УстановитьПараметр("РабочийДокумент", Выборка.РабочийДокумент);
			Запрос.УстановитьПараметр("Цех", Выборка.Цех);
			Запрос.УстановитьПараметр("ЭтапРабот", Выборка.ЭтапРабот);
			
			ВыборкаФакт = Запрос.Выполнить().Выбрать();
			
			Факт = 0;
			
			Пока ВыборкаФакт.Следующий() Цикл
				
				 Факт = Факт + (ВыборкаФакт.ВремяОкончания - ВыборкаФакт.ВремяНачала);
				
			КонецЦикла;
			
			НаборПлан = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
			НаборПлан.Отбор.РабочийДокумент.Установить(Выборка.РабочийДокумент);
			НаборПлан.Отбор.ЭтапРабот.Установить(Выборка.ЭтапРабот);
			НаборПлан.Отбор.Цех.Установить(Выборка.Цех);
			НаборПлан.Прочитать();
			
			Если НаборПлан.Количество() <> 0 Тогда
				Запись = НаборПлан[0];
			Иначе
				Запись = НаборПлан.Добавить();
			КонецЕсли;
			Запись.ДилерскийЦентр = Выборка.ДилерскийЦентр;
			Запись.ВремяНачала = ТекВремя;
			Запись.ЭтапРабот = Выборка.ЭтапРабот;
			Запись.Цех = Выборка.Цех;
			Запись.РабочийДокумент = Выборка.РабочийДокумент;
			Запись.Обращение = Выборка.Обращение;
			
			ТекущийКонецРабочегоДня = Выборка.КонецРабочегоДня;
			ИнтервалМеждуРабочимиДнями = Выборка.НачалоРабочегоДня - Выборка.КонецРабочегоДня + 86400;
			Длительность = ((Выборка.ВремяОкончания - Выборка.ВремяНачала) - Факт);
			Пока Запись.ВремяОкончания > ТекущийКонецРабочегоДня Цикл
				Длительность = Длительность - ИнтервалМеждуРабочимиДнями;
				ТекущийКонецРабочегоДня = ТекущийКонецРабочегоДня + 86400;
			КонецЦикла;
			
			Если Длительность < 0 Тогда
				Запись.ВремяОкончания = ТекВремя + ШагПланирования;
			Иначе
				Запись.ВремяОкончания = ТекВремя + Длительность;
			КонецЕсли;
			
			Запись.Длительность = Длительность / 3600;
			
			ТекущийКонецРабочегоДня = Выборка.КонецРабочегоДня;
			ТекущееНачалоРабочегоДня = Выборка.НачалоРабочегоДня;
			ИнтервалМеждуРабочимиДнями = Выборка.НачалоРабочегоДня - Выборка.КонецРабочегоДня + 86400;
			Пока Запись.ВремяОкончания > ТекущийКонецРабочегоДня Цикл
				ПереносимаяЧасть = Запись.ВремяОкончания - ТекущийКонецРабочегоДня;
				Запись.ВремяОкончания = ТекущееНачалоРабочегоДня + 86400 + ПереносимаяЧасть;
				//Запись.Длительность = (Запись.ВремяОкончания - Запись.ВремяНачала - (Выборка.НачалоРабочегоДня - Выборка.КонецРабочегоДня + 86400)) / 3600;
				ТекущийКонецРабочегоДня = ТекущийКонецРабочегоДня + 86400;
				ТекущееНачалоРабочегоДня = ТекущееНачалоРабочегоДня + 86400;
			КонецЦикла;
			
			Запись.Период = ТекВремя;
			НаборПлан.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Неопределено;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.ДилерскийЦентр,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Период,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Цех,
//	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Авторабота,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот,
	|	ЕСТЬNULL(Renault_АвтосервисФактОперативныйСрезПоследних.ВремяОкончания, &ПустаяДата) КАК ВремяОкончания
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисФактОперативный.СрезПоследних КАК Renault_АвтосервисФактОперативныйСрезПоследних
	|	ПО Renault_АвтосервисФактОперативныйСрезПоследних.РабочийДокумент = Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	|	И Renault_АвтосервисФактОперативныйСрезПоследних.ЭтапРабот = Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот
	|ГДЕ
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы = &СтатусРаботы";
				   
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаНачата);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Макс(Выборка.ВремяОкончания, ТекВремя) - Мин(Выборка.ВремяОкончания, ТекВремя) < ШагПланирования Тогда
			Набор = РегистрыСведений.Renault_АвтосервисФактОперативный.СоздатьНаборЗаписей();
			Набор.Отбор.Обращение.Установить(Выборка.Обращение);
			Набор.Отбор.РабочийДокумент.Установить(Выборка.РабочийДокумент);
			Набор.Отбор.Цех.Установить(Выборка.Цех);
			Набор.Отбор.ЭтапРабот.Установить(Выборка.ЭтапРабот);
			Набор.Прочитать();
			Для Каждого Запись ИЗ Набор Цикл
				Если Запись.ВремяОкончания = Выборка.ВремяОкончания Тогда
					Запись.Период = ТекВремя;
					Запись.ВремяОкончания = ТекВремя + ШагПланирования;
				КонецЕсли;
			КонецЦикла;
			Набор.Записать();
		Иначе
			Запись = РегистрыСведений.Renault_АвтосервисФактОперативный.СоздатьМенеджерЗаписи();
			Запись.ДилерскийЦентр = Выборка.ДилерскийЦентр;
			Запись.РабочийДокумент = Выборка.РабочийДокумент;
			Запись.Цех = Выборка.Цех;
			Запись.ВремяНачала = ТекВремя;
			Запись.Период = ТекВремя;
			Запись.ВремяОкончания = ТекВремя + ШагПланирования;
			Запись.ЭтапРабот = Выборка.ЭтапРабот;
			Запись.Обращение = Выборка.Обращение;
			Запись.Записать();
		КонецЕсли;
		
	КонецЦикла;

	
КонецПроцедуры

Процедура Renault_СобытияОбработкаПроведенияЗаказНарядаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	ТекущийДЦ = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	
	ВалютаРегл = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	СтруктураКурса = обКурсДляВалюты(ВалютаРегл, Источник.Дата);
	КурсРегл = СтруктураКурса.Курс/?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
	ВалютаУпр = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	Если Источник.КурсВалютыУпр = 0 Тогда
		СтруктураКурса = обКурсДляВалюты(ВалютаУпр, Источник.Дата);
		КурсУпр = СтруктураКурса.Курс/?(СтруктураКурса.Кратность = 0, 1, СтруктураКурса.Кратность);
	Иначе
		КурсУпр = Источник.КурсВалютыУпр;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийДЦ) Тогда
		
		ВидРемонта = Источник.ВидРемонта;
		СостояниеЗН = Источник.Состояние;
		Отбор = Новый Структура;
		Отбор.Вставить("ВидРемонта", ВидРемонта);
		Отбор.Вставить("СостояниеЗН", СостояниеЗН);
		
		МассивСтрок = ТекущийДЦ.АвтосервисНастройкиЗаписиЗН.НайтиСтроки(Отбор);
		Если МассивСтрок.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТоварыВПроизводствеОстатки.Цех.Организация КАК Организация,
			|	ТоварыВПроизводствеОстатки.Цех КАК Цех,
			|	ТоварыВПроизводствеОстатки.Номенклатура КАК Номенклатура,
			|	ТоварыВПроизводствеОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			|	ТоварыВПроизводствеОстатки.СтатусПартии КАК СтатусПартии,
			|	ТоварыВПроизводствеОстатки.Партия КАК Партия,
			|	ТоварыВПроизводствеОстатки.Партия.Контрагент КАК Поставщик,
			|	ТоварыВПроизводствеОстатки.Партия.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
			|	ТоварыВПроизводствеОстатки.ГТД КАК ГТД,
			|	СУММА(ТоварыВПроизводствеОстатки.КоличествоОстаток) КАК Количество,
			|	СУММА(ТоварыВПроизводствеОстатки.СуммаОстаток) КАК Сумма,
			|	СУММА(ТоварыВПроизводствеОстатки.СуммаУпрОстаток) КАК СуммаУпр,
			|	СУММА(ТоварыВПроизводствеОстатки.СуммаНДСОстаток) КАК СуммаНДС
			|ИЗ
			|	РегистрНакопления.ТоварыВПроизводстве.Остатки(, ЗаказНаряд = &ЗаказНаряд) КАК ТоварыВПроизводствеОстатки
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыВПроизводствеОстатки.Цех,
			|	ТоварыВПроизводствеОстатки.Номенклатура,
			|	ТоварыВПроизводствеОстатки.ХарактеристикаНоменклатуры,
			|	ТоварыВПроизводствеОстатки.СтатусПартии,
			|	ТоварыВПроизводствеОстатки.Партия,
			|	ТоварыВПроизводствеОстатки.Партия.Контрагент,
			|	ТоварыВПроизводствеОстатки.Партия.ДоговорВзаиморасчетов,
			|	ТоварыВПроизводствеОстатки.ГТД,
			|	ТоварыВПроизводствеОстатки.Цех.Организация
			|
			|ДЛЯ ИЗМЕНЕНИЯ";
			Запрос.УстановитьПараметр("ЗаказНаряд", Источник.Ссылка);
			тзДеталиВПроизводстве = Запрос.Выполнить().Выгрузить();
			
			Набор = РегистрыНакопления.КомплектацияАвтомобилей.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Значение = Источник.Ссылка;
			Набор.Отбор.Регистратор.Использование = Истина;
			Набор.Очистить();
			
			Для Каждого СтрокаТовара ИЗ Источник.Товары Цикл
				ОсталосьСписать = СтрокаТовара.Количество;
				СтрокиВПроизводстве = тзДеталиВПроизводстве.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", СтрокаТовара.Номенклатура, СтрокаТовара.ХарактеристикаНоменклатуры));
				Для Каждого СтрокаВПроизводстве ИЗ СтрокиВПроизводстве Цикл
					Списывается = Мин(ОсталосьСписать, СтрокаВПроизводстве.Количество);
					НоваяЗаписьКомплектацияАвтомобилей = Набор.Добавить();
					НоваяЗаписьКомплектацияАвтомобилей.ВидДвижения = ВидДвиженияНакопления.Приход;
					НоваяЗаписьКомплектацияАвтомобилей.Период = Источник.Дата;
					НоваяЗаписьКомплектацияАвтомобилей.Регистратор = Источник.Ссылка;
					НоваяЗаписьКомплектацияАвтомобилей.Автомобиль = Источник.Автомобиль;
					НоваяЗаписьКомплектацияАвтомобилей.СкладКомпании = СтрокаТовара.СкладКомпании;
					НоваяЗаписьКомплектацияАвтомобилей.Номенклатура = СтрокаВПроизводстве.Номенклатура;
					НоваяЗаписьКомплектацияАвтомобилей.ХарактеристикаНоменклатуры = СтрокаВПроизводстве.ХарактеристикаНоменклатуры;
					НоваяЗаписьКомплектацияАвтомобилей.СтатусПартии = Перечисления.СтатусыПартий.ТоварКупленный;
					НоваяЗаписьКомплектацияАвтомобилей.Партия = СтрокаВПроизводстве.Партия;
					НоваяЗаписьКомплектацияАвтомобилей.ГТД = СтрокаВПроизводстве.ГТД;
					НоваяЗаписьКомплектацияАвтомобилей.ХозОперация = Источник.ХозОперация;
					НоваяЗаписьКомплектацияАвтомобилей.СтавкаНДС = СтрокаТовара.СтавкаНДС;
					НоваяЗаписьКомплектацияАвтомобилей.Количество = СтрокаВПроизводстве.Количество;
					НоваяЗаписьКомплектацияАвтомобилей.Сумма = ?(СтрокаВПроизводстве.Количество = 0, 0, Окр((СтрокаВПроизводстве.Сумма*Списывается)/СтрокаВПроизводстве.Количество, 2));
					НоваяЗаписьКомплектацияАвтомобилей.СуммаНДС = ?(СтрокаВПроизводстве.Количество = 0, 0, Окр((СтрокаВПроизводстве.СуммаНДС*Списывается)/СтрокаВПроизводстве.Количество, 2));
					НоваяЗаписьКомплектацияАвтомобилей.СуммаУпр = ?(СтрокаВПроизводстве.Количество = 0, 0, Окр((СтрокаВПроизводстве.СуммаУпр*Списывается)/СтрокаВПроизводстве.Количество, 2));
					СуммаПродажи = (СтрокаТовара.СуммаВсего*НоваяЗаписьКомплектацияАвтомобилей.Количество)/СтрокаВПроизводстве.Количество;
					НоваяЗаписьКомплектацияАвтомобилей.СуммаПродажи = Окр(обПересчет(СуммаПродажи, Источник.ВалютаДокумента, Источник.КурсДокумента, ВалютаРегл, КурсРегл), 2);
					НоваяЗаписьКомплектацияАвтомобилей.СуммаПродажиУпр = Окр(обПересчет(СуммаПродажи, Источник.ВалютаДокумента, Источник.КурсДокумента, ВалютаУпр, КурсУпр), 2);
				КонецЦикла;
			КонецЦикла;
			
			Набор.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Renault_СобытиеОбработкаПроведенияЗаказПоставщикуПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	//ВОЗВРАТ; //Временно, пока не внедрен SAPPR
	
	Если Источник.ДополнительныеСвойства.Свойство("ЗагрузкаСтатуса") 
		или не ЗначениеЗаполнено(Источник.Ссылка) Тогда
			Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	SAPPR_Заказано.Отправлен
	|ИЗ
	|	РегистрСведений.SAPPR_Заказано КАК SAPPR_Заказано
	|ГДЕ
	|	SAPPR_Заказано.ЗаказПоставщику = &ЗаказПоставщику
	|	И SAPPR_Заказано.Отправлен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Renault_ИсторияВыгрузкиЗаказов.ВОбработке
	|ИЗ
	|	РегистрСведений.Renault_ИсторияВыгрузкиЗаказов КАК Renault_ИсторияВыгрузкиЗаказов
	|ГДЕ
	|	Renault_ИсторияВыгрузкиЗаказов.ЗаказПоставщику = &ЗаказПоставщику
	|	И Renault_ИсторияВыгрузкиЗаказов.Отправлено";
	Запрос.УстановитьПараметр("ЗаказПоставщику", Источник.Ссылка);
	Результат = Запрос.Выполнить();
	Если не Результат.Пустой() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КаталогРеферансов.Номенклатура
		|ИЗ
		|	РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
		|ГДЕ
		|	НЕ Renault_КаталогРеферансов.НаличиеВSAPе
		|	И Renault_КаталогРеферансов.Номенклатура В(&Номенклатура)";
		Запрос.УстановитьПараметр("Номенклатура", Источник.Товары.ВыгрузитьКолонку("Номенклатура"));
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Возврат;
		КонецЕсли; 
		
		Выборка = Результат.Выбрать();
		Если Выборка.Количество() = Источник.Товары.Количество() Тогда
			Менеджер = РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.СоздатьМенеджерЗаписи();
			Менеджер.ЗаказПоставщику = Источник.Ссылка;
			Менеджер.Прочитать();
			Если Менеджер.ОтправлятьВRenault Тогда
				Набор = РегистрыСведений.Renault_ДопТабЧастиЗаказПоставщику.СоздатьНаборЗаписей();
				Набор.Отбор.ЗаказПоставщику.Установить(Источник.Ссылка);
				Набор.Прочитать();
				ТаблицаRenault = Набор.Выгрузить();
				Для Каждого СтрокаТЧ из ТаблицаRenault Цикл
					Если Не ЗначениеЗаполнено(СтрокаТЧ.ВИН) Тогда
						Отказ = Истина;
						#Если Клиент тогда
							Предупреждение("Поля VIN обязательны для заполнения",,"Ошибка");
						#КонецЕсли
						Возврат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		Форма = Обработки.Renault_ARM_Запчасти.ПолучитьФорму("ФормаРедНоменклатуры");
		Пока Выборка.Следующий() Цикл
			Набор = РегистрыСведений.Renault_ДопТабЧастиЗаказПоставщику.СоздатьНаборЗаписей();
			Набор.Отбор.ЗаказПоставщику.Установить(Источник.Ссылка);
			Набор.Прочитать();
			ТаблицаRenault = Набор.Выгрузить();
			СтрокаДопТаб = ТаблицаRenault.Найти(Выборка.Номенклатура,"Номенклатура");
			СтрокаТЧ = Форма.Таблица.Добавить();
			СтрокаТЧ.Номенклатура = Выборка.Номенклатура;
			Если СтрокаДопТаб <> Неопределено Тогда
				СтрокаТЧ.ВИН = СтрокаДопТаб.ВИН;
				СтрокаТЧ.Автомобиль = СтрокаДопТаб.Автомобиль;
				СтрокаТЧ.Комментарий = СтрокаДопТаб.Комментарий;
			КонецЕсли;
		КонецЦикла;
		Ответ = Форма.ОткрытьМодально();
		Попытка
			Таблица = ДанныеФормыВЗначение(Ответ,Тип("ТаблицаЗначений"));
			Ответ = Истина;
		Исключение
			Отказ = Истина;
			Ответ = Ложь;
		КонецПопытки;
		Если Ответ Тогда
			ДокументОбъект = Источник.Скопировать();
			ДокументОбъект.Товары.Очистить();
			Для Каждого СтрокаТЗ Из Таблица Цикл
				НайденаяСтрока = Источник.Товары.Найти(СтрокаТЗ.Номенклатура,"Номенклатура");
				СтрокаТЧ = ДокументОбъект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЧ, НайденаяСтрока);
				Источник.Товары.Удалить(НайденаяСтрока);
				//Набор = РегистрыСведений.Renault_ДопТабЧастиЗаказПоставщику.СоздатьНаборЗаписей();
				//Набор.Отбор.ЗаказПоставщику.Установить(Источник.Ссылка);
				//Набор.Отбор.Номенклатура.Установить(СтрокаТЗ.Номенклатура);   
				//Набор.Записать();
				
				//СтрокаТЧ = ДокументОбъект.ТаблицаRenault.Добавить();
				//ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТЗ);
				
				//СтрокаТабРено = Источник.ТаблицаRenault.Найти(СтрокаТЗ.Номенклатура,"Номенклатура");
				//Источник.ТаблицаRenault.Удалить(СтрокаТабРено);
			КонецЦикла;
			ДокументОбъект.Дата = Источник.Дата;
			ДокументОбъект.УстановитьНовыйНомер();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Менеджер = РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.СоздатьМенеджерЗаписи();
			Менеджер.ЗаказПоставщику = ДокументОбъект.Ссылка;
			Менеджер.Прочитать();
			Менеджер.ЗаказПоставщику = ДокументОбъект.Ссылка;
			Менеджер.ТипЗаказаSappr = Перечисления.SAPPR_ВидЗаказаПоставщику[Лев(Справочники.ТипыЗаказов.ПолучитьИмяПредопределенного(ДокументОбъект.ТипЗаказа),4)];
			Менеджер.Записать();
			#Если Клиент тогда
				Предупреждение("Создан документ №"+ДокументОбъект.Номер+ " от " + ДокументОбъект.Дата+" с реферансами, недоступными для заказа в SAP. Для отправки заказа подтвердите его!",,"Предупреждение");
				ФормаДокумента = ПолучитьОбщуюФорму("Renault_ФормаДокументаЗаказПоставшику");
				ФормаДокумента.ДокументОбъект = ДокументОбъект;
				ФормаДокумента.ЭлементыФормы.ТипЗаказа.ТолькоПросмотр = Истина;
				ФормаДокумента.УчитыватьКратность = Истина;
				ФормаДокумента.ЭлементыФормы.Контрагент.ТолькоПросмотр = Истина;
				ФормаДокумента.ЭлементыФормы.КоманднаяПанельТовары.Кнопки.Renault.Доступность = Истина;
				ФормаДокумента.Открыть();
			#КонецЕсли
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСИТизБИР (БИРПолный) Экспорт
	Если СтрДлина(СокрЛП(БИРПолный)) = 12 Тогда
		Возврат ""+ Прав(БИРПолный,2) + Лев(БИРПолный, 8);
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура Renault_ПоступлениеАвтомобилейВводСобытияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	ОсновныяНастройка = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза;
	Если ОсновныяНастройка.ИспользоватьМодифицированныйФункционалВыдачи Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Автомобиль,
		|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.РабочийЛист,
		|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Клиент,
		|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Менеджер,
		|	Renault_РабочиеЛисты.Отдел,
		|	Renault_РабочиеЛисты.ДилерскийЦентр,
		|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.VIN,
		|	CRM_СобытияПоРабочимЛистам.Ссылка КАК СобытиеСогласование
		|ИЗ
		|	РегистрСведений.Renault_ЗаконтрактованныеАвтомобили.СрезПоследних КАК Renault_ЗаконтрактованныеАвтомобилиСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|		ПО Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.РабочийЛист = Renault_РабочиеЛисты.IDK
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|		ПО (CRM_СобытияПоРабочимЛистам.IDK = Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.РабочийЛист)
		|			И ((CRM_СобытияПоРабочимЛистам.Комментарий ПОДОБНО &КомментарийСогласование)
		|				ИЛИ (CRM_СобытияПоРабочимЛистам.ВидСобытия = &ВидСобытия))
		|ГДЕ
		|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Автомобиль В(&Автомобили)
		|	И Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.ДатаСнятияРезерва = ДАТАВРЕМЯ(1, 1, 1)";
		Запрос.УстановитьПараметр("Автомобили", Источник.Автомобили.ВыгрузитьКолонку("Автомобиль"));
		Запрос.УстановитьПараметр("КомментарийСогласование", "Согласовать дату выдачи автомобиля%");
		Запрос.УстановитьПараметр("ВидСобытия", Справочники.CRM_ВидыСобытий.Выдача);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.СобытиеСогласование) Тогда
				Продолжить;
			КонецЕсли;
			ДокСобытие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
			ДокСобытие.IDK = Выборка.РабочийЛист;
			ДокСобытие.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
			ДокСобытие.Сотрудник = Выборка.Менеджер;
			ДокСобытие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прозвон;
			ДокСобытие.Дата = ТекущаяДата();
			ДокСобытие.ДатаНапоминания = ТекущаяДата();
			ДокСобытие.ДилерскийЦентр = Выборка.ДилерскийЦентр;
			ДокСобытие.Комментарий = "Согласовать дату выдачи автомобиля " + Выборка.Автомобиль + " VIN " + Выборка.VIN;
			ДокСобытие.Отдел = Выборка.Отдел;
			ДокСобытие.Подразделение = ?(ТипЗнч(Выборка.Менеджер)= Тип("Строка"),Справочники.ПодразделенияКомпании.ПустаяСсылка(),Выборка.Менеджер.Подразделение);
			ДокСобытие.Записать(РежимЗаписиДокумента.Проведение);
		КонецЦикла;
	КонецЕсли;
	
	//+++ DMS
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автомобили.Автомобиль,
		|	Автомобили.VIN
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ПоступлениеАвтомобилей.Автомобили КАК Автомобили
		|ГДЕ
		|	Автомобили.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Renault_Договор.РабочийЛист,
		|	Renault_Договор.VIN,
		|	ВТ.Автомобиль,
		|	Renault_РабочиеЛисты.Сотрудник,
		|	Renault_РабочиеЛисты.Отдел,
		|	Renault_РабочиеЛисты.ДилерскийЦентр,
		|	Renault_РабочиеЛисты.Подразделение
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Договор КАК Renault_Договор
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_СообщенияПользователю КАК Renault_СообщенияПользователю
		|			ПО Renault_Договор.VIN = Renault_СообщенияПользователю.ИдентификаторОбъекта
		|				И (Renault_СообщенияПользователю.ВидСообщения = ЗНАЧЕНИЕ(Справочник.Renault_ВидСообщения.Автосклад_АвтомобильПоступилНаСкладДилера))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|			ПО Renault_Договор.РабочийЛист = Renault_РабочиеЛисты.IDK
		|		ПО ВТ.VIN = Renault_Договор.VIN
		|ГДЕ
		|	НЕ Renault_Договор.Ссылка ЕСТЬ NULL 
		|	И НЕ Renault_РабочиеЛисты.Сотрудник ЕСТЬ NULL 
		|	И Renault_СообщенияПользователю.Ссылка ЕСТЬ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	Renault_Договор.VIN,
		|	ВТ.Автомобиль,
		|	Renault_Договор.РабочийЛист,
		|	Renault_РабочиеЛисты.Сотрудник,
		|	Renault_РабочиеЛисты.Отдел,
		|	Renault_РабочиеЛисты.ДилерскийЦентр,
		|	Renault_РабочиеЛисты.Подразделение";
		
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() тогда
		ТекСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
		ДатаСобытия = ТекущаяДата();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Комментарий = "Согласовать дату выдачи автомобиля " + Выборка.Автомобиль;
			//СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
			//СобытиеОбъект.IDK = Выборка.РабочийЛист;
			//СобытиеОбъект.Дата = ДатаСобытия;
			//СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.Прозвон;
			//СобытиеОбъект.Сотрудник = Выборка.Сотрудник;
			//СобытиеОбъект.Автор = ТекСотрудник;
			//СобытиеОбъект.Отдел = Выборка.Отдел;
			//СобытиеОбъект.ДилерскийЦентр = Выборка.ДилерскийЦентр;
			//СобытиеОбъект.Подразделение = Выборка.Подразделение;
			//СобытиеОбъект.Комментарий = Комментарий;
			//СобытиеОбъект.ДатаНапоминания = ДатаСобытия;
			//СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			Напоминание.Отправитель = ТекСотрудник;
			Напоминание.Адресаты.Добавить().Сотрудник = Выборка.Сотрудник;
			Напоминание.ДатаОтправки = ДатаСобытия;
			Напоминание.Комментарий = Комментарий;
			Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.Автосклад_АвтомобильПоступилНаСкладДилера;
			Напоминание.ПоказыватьС = ДатаСобытия;
			Напоминание.Наименование = Формат(Строка(Выборка.РабочийЛист),"ЧГ=");
			Напоминание.Сообщение = "Автомобиль поступил на склад";
			Напоминание.ИдентификаторОбъекта = Выборка.VIN;
			Напоминание.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	//--- DMS
	
	//v+
	Если НЕ Отказ Тогда
		//Для Каждого Стр Из Источник.Автомобили Цикл
		//	Движение=Источник.Движения.ЦеныАвтомобилей.Добавить();
		//	Движение.Период=Источник.Дата;
		//	Движение.ТипЦен=Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
		//	Движение.Автомобиль=Стр.Автомобиль;
		//	Движение.Цена=Стр.СуммаВсего;
		//КонецЦикла;	
	КонецЕсли;	
	//v-
	
КонецПроцедуры

Процедура ВыгрузкаОстаткаРеноПартс(СтруктураПараметров = Неопределено) Экспорт
	
	Обработка = Обработки.Renault_ВыгрузкаОстаткаРеноПартс.Создать();
	Обработка.ВыполнитьВыгрузку();
	
КонецПроцедуры

Процедура Renault_РеализацияТоваровОбработкаПроведенияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт

    Если ЗначениеЗаполнено(Источник.ДокументОснование) и ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда

        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |	Renault_ЗаказЗапчастейПокупателя.ЗаказПокупателя
        |ИЗ
        |	Документ.Renault_ЗаказЗапчастейПокупателя КАК Renault_ЗаказЗапчастейПокупателя
        |ГДЕ
        |	Renault_ЗаказЗапчастейПокупателя.ЗаказПокупателя = &ЗаказПокупателя";
        Запрос.УстановитьПараметр("ЗаказПокупателя", Источник.ДокументОснование);

        Результат = Запрос.Выполнить();

        Если Результат.Пустой() Тогда
            Возврат;
        КонецЕсли;

        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |	ЗаказыПокупателейОбороты.Номенклатура,
        |	ЗаказыПокупателейОбороты.ЗаказаноПриход,
        |	РеализацияТоваровТовары.Количество
        |ИЗ
        |	РегистрНакопления.ЗаказыПокупателей.Обороты КАК ЗаказыПокупателейОбороты
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
        |		ПО ЗаказыПокупателейОбороты.Номенклатура = РеализацияТоваровТовары.Номенклатура
        |ГДЕ
        |	ЗаказыПокупателейОбороты.Заказ = &Заказ
        |	И РеализацияТоваровТовары.Ссылка = &Ссылка";
        Запрос.УстановитьПараметр("Заказ", Источник.ДокументОснование);
        Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);

        Движения = Источник.Движения.Renault_РеализацияПоЗаказам;
        Движения.Записывать = Истина;

        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл

            СтрокаДвижений = Движения.Добавить(); 
            СтрокаДвижений.Период = Источник.Дата;
            СтрокаДвижений.Заказ = Источник.ДокументОснование;
            СтрокаДвижений.Номенклатура = Выборка.Номенклатура;
            СтрокаДвижений.Количество = Выборка.Количество;

        КонецЦикла;

    КонецЕсли;

КонецПроцедуры

Процедура Renault_ПеремещениеАвтомобилейОбработкаПроведенияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьПродвинутыйМеханизмПеремещений Тогда
	
		СкладЭвакуатор = Константы.Renault_СкладЭвакуатор.Получить();
		
		Если НЕ Отказ Тогда
			
			Если Источник.СкладКомпании.Renault_Территория = Источник.СкладПолучатель.Renault_Территория Тогда
				
				ОстаткиАвтомобилей = ПолучитьТаблицуОстаткиАвтомобилей(Источник);
				
				Источник.Движения.ОстаткиАвтомобилей.Прочитать();
				Источник.Движения.ОстаткиАвтомобилей.Загрузить(ОстаткиАвтомобилей);
				Источник.Движения.ОстаткиАвтомобилей.Записать();
				//ЗанятьМестаАвтомобилей(Источник);
			Иначе
				
				Если СкладЭвакуатор.Пустая() Тогда
					Сообщить("Склад-эвакуатор не выбран!", СтатусСообщения.Важное);
					Отказ = Истина;
				КонецЕсли;
				
				Если Не Отказ Тогда
					
					Если Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.ВПути Тогда
						
						Источник.Движения.ОстаткиАвтомобилей.Очистить();
						Источник.Движения.ОстаткиАвтомобилей.Записать();
						
						ОстаткиАвтомобилей = ПолучитьТаблицуОстаткиАвтомобилейСписание(СкладЭвакуатор, Источник);
						
						Источник.Движения.ОстаткиАвтомобилей.Прочитать();
						Источник.Движения.ОстаткиАвтомобилей.Загрузить(ОстаткиАвтомобилей);
						Источник.Движения.ОстаткиАвтомобилей.Записать();
						
						Если НЕ РегистрыСведений.Renault_РазмещениеАвтомобилей.ОсвободитьПарковочноеМесто(Источник.Автомобили.ВыгрузитьКолонку("Автомобиль")) Тогда
							Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось очистить парковочные места автомобилей. Документ:" + Источник.Ссылка, Неопределено, "", Отказ);
							Возврат;
						КонецЕсли;
						
					ИначеЕсли Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
						
						Источник.Движения.ОстаткиАвтомобилей.Очистить();
						Источник.Движения.ОстаткиАвтомобилей.Записать();
						
						ОстаткиАвтомобилей = ПолучитьТаблицуОстаткиАвтомобилейСписание(СкладЭвакуатор, Источник);
						
						Источник.Движения.ОстаткиАвтомобилей.Прочитать();
						Источник.Движения.ОстаткиАвтомобилей.Загрузить(ОстаткиАвтомобилей);

						Источник.Движения.ОстаткиАвтомобилей.Записать();
						
						ОстаткиАвтомобилей = ПолучитьТаблицуОстаткиАвтомобилейПоступление(СкладЭвакуатор, Источник);						
						
						Для Каждого Строка Из ОстаткиАвтомобилей Цикл
							НоваяСтрока = Источник.Движения.ОстаткиАвтомобилей.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
							НоваяСтрока.Период = ТекущаяДата();
						КонецЦикла;	
						
						Источник.Движения.ОстаткиАвтомобилей.Записать();
						ЗанятьМестаАвтомобилей(Источник);
						ЗаписатьНачисленияВодителям(Источник);
						
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не Отказ Тогда
				ЗаписатьОтметкиВПланПеремещений(Источник);			
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТаблицуОстаткиАвтомобилейПоступление(СкладЭвакуатор, Источник)
	
	ОбщийЗапрос = Новый Запрос;
	
	ОбщийЗапрос.Текст = 
	"ВЫБРАТЬ
	|	ТабЧастьАвтомобили.Автомобиль КАК Автомобиль,
	|	ТабЧастьАвтомобили.Ссылка.Ссылка КАК Ссылка,
	|	ТабЧастьАвтомобили.Ссылка.ДатаОперации КАК ДатаОперации,
	|	ТабЧастьАвтомобили.Ссылка.СкладКомпании КАК СкладИз1,
	|	&СкладВ КАК СкладВ,
	|	&СкладИЗ КАК СкладИз
	|ПОМЕСТИТЬ ВТ_ТабЧасть
	|ИЗ
	|	Документ.ПеремещениеАвтомобилей.Автомобили КАК ТабЧастьАвтомобили
	|ГДЕ
	|	ТабЧастьАвтомобили.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АвтоНаСкладахОстатки.Автомобиль КАК Автомобиль,
	|	АвтоНаСкладахОстатки.СкладКомпании КАК СкладКомпании,
	|	АвтоНаСкладахОстатки.Партия КАК Партия,
	|	АвтоНаСкладахОстатки.КоличествоОстаток КАК Количество,
	|	АвтоНаСкладахОстатки.СтатусПартии КАК СтатусПартии,
	|	АвтоНаСкладахОстатки.СуммаОстаток КАК Сумма,
	|	АвтоНаСкладахОстатки.СуммаУпрОстаток КАК СуммаУпр,
	|	АвтоНаСкладахОстатки.СуммаНДСОстаток КАК СуммаНДС,
	|	АвтоНаСкладахОстатки.ГТД КАК ГТД
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(
	|			&ДатаОперации,
	|			СкладКомпании = &СкладИЗ
	|				И Автомобиль В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Табл.Автомобиль
	|					ИЗ
	|						ВТ_ТабЧасть КАК Табл)) КАК АвтоНаСкладахОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТабЧасть.Ссылка КАК Регистратор,
	|	ВТ_ТабЧасть.ДатаОперации КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВТ_Остатки.Автомобиль КАК Автомобиль,
	|	ВТ_Остатки.СкладКомпании КАК СкладКомпании,
	|	ВТ_Остатки.Партия КАК Партия,
	|	ВТ_Остатки.Количество КАК Количество,
	|	ВТ_Остатки.СтатусПартии КАК СтатусПартии,
	|	&ХозОперация КАК ХозОперация,
	|	ВТ_Остатки.Сумма КАК Сумма,
	|	ВТ_Остатки.СуммаУпр КАК СуммаУпр,
	|	ВТ_Остатки.СуммаНДС КАК СуммаНДС,
	|	ВТ_Остатки.ГТД КАК ГТД
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТабЧасть КАК ВТ_ТабЧасть
	|		ПО ВТ_Остатки.Автомобиль = ВТ_ТабЧасть.Автомобиль
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ТабЧасть.Ссылка,
	|	ВТ_ТабЧасть.ДатаОперации,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВТ_Остатки.Автомобиль,
	|	ВТ_ТабЧасть.СкладВ,
	|	ВТ_Остатки.Партия,
	|	ВТ_Остатки.Количество,
	|	ВТ_Остатки.СтатусПартии,
	|	&ХозОперация,
	|	ВТ_Остатки.Сумма,
	|	ВТ_Остатки.СуммаУпр,
	|	ВТ_Остатки.СуммаНДС,
	|	ВТ_Остатки.ГТД
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТабЧасть КАК ВТ_ТабЧасть
	|		ПО ВТ_Остатки.Автомобиль = ВТ_ТабЧасть.Автомобиль";
	
	ОбщийЗапрос.УстановитьПараметр("Ссылка", 		Источник.Ссылка);
	ОбщийЗапрос.УстановитьПараметр("ДатаОперации",	ТекущаяДата());
	ОбщийЗапрос.УстановитьПараметр("СкладИЗ",		СкладЭвакуатор);
	ОбщийЗапрос.установитьПараметр("СкладВ", Источник.СкладПолучатель);
	ОбщийЗапрос.УстановитьПараметр("ХозОперация",Источник.ХозОперация);

	Возврат ОбщийЗапрос.Выполнить().Выгрузить();
	
КонецФункции

