////@+ Функция ПолучитьИдентификатор(Организация)
// Дата создания - 16.05.2012 11:48:33; Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Функция получает Идентификатор дилера (BIR)
//
// Параметры
//  Организация  - СправочникЭлемент.Ссылка  - Ссылка на организацию
//
// Возвращаемое значение
//  ИдентификаторДилера  - Строка(9) - Строковое значение BIR 
//                 нормализованное до 9 символов
//@-
Функция ПолучитьИдентификатор(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(CRM_ДилерскиеЦентры.BIR, 1, 8) КАК BIR
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	|ГДЕ
	|	CRM_ДилерскиеЦентры.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.BIR;
	
КонецФункции // ПолучитьИдентификатор(Организация)

////@+ Функция РазложитьСтрокуВСписок(Знач ИсходнаяСтрока, Разделитель = ";")
// Дата создания - 16.05.2012 11:44:23; Автор - Окипний Андрей Евгеньевич
//
// Описание функции
//  Функция "расщепляет" строку на подстроки, используя заданный 
//  разделитель. Разделитель может иметь любую длину. 
//  
//  Например, 
//   РазложитьСтрокуВМассивПодстрок(",ку,,,му", ",") возвратит массив значений из пяти элементов, 
//   три из которых - пустые строки.
//
// Параметры
//  ИсходнаяСтрока  - Строка (неограниченная) - Строка, которую необходимо 
//                 разложить на составляющие
//  Разделитель  - Строка - Строковое представление разделителя
//                 <продолжение описания параметра>
//
// Возвращаемое значение
//  СписокСтрок  - СписокЗначений - Список значений с элементами полученными 
//                 из переданной строки
//@-
Функция РазложитьСтрокуВСписок(Знач ИсходнаяСтрока, Разделитель = ";") Экспорт
	
	//Сначала получаем массив
	МассивСтрок = РазложитьСтрокуВМассив(ИсходнаяСтрока, Разделитель);
	
	//Теперь массив загружаем в СписокЗначений
	СписокСтрок = Новый СписокЗначений;
	СписокСтрок.ЗагрузитьЗначения(МассивСтрок);

	Возврат СписокСтрок;
	
КонецФункции // РазложитьСтрокуВСписок(Знач ИсходнаяСтрока, Разделитель = ";")

////@+ Функция РазложитьСтрокуВМассив(Знач Стр, Разделитель = ",")
// Дата создания - 16.05.2012 11:32:11; Автор - Окипний Андрей Евгеньевич
//
// Описание функции
//  Функция "расщепляет" строку на подстроки, используя заданный 
//  разделитель. Разделитель может иметь любую длину. 
//  
//  Например, 
//   РазложитьСтрокуВМассивПодстрок(",ку,,,му", ",") возвратит массив значений из пяти элементов, 
//   три из которых - пустые строки.
//
// Параметры
//  Стр  - Строка - строка, которую необходимо разложить на подстроки. 
//						Параметр передается по значению.
//  Разделитель  - Строка-разделитель, по умолчанию - запятая.
//
// Возвращаемое значение
//  МассивСтрок  - Массив - массив значений, элементы которого - подстроки
//
//@-
Функция РазложитьСтрокуВМассив(Знач Стр, Разделитель = ",") Экспорт
	
	МассивСтрок = Новый Массив();
	
	Если Разделитель = " " Тогда
		
		Стр = СокрЛП(Стр);
		
		Пока Истина Цикл
			
			Поз = Найти(Стр,Разделитель);
			
			Если Поз=0 Тогда
				
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
				
			КонецЕсли;
			
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
			
		КонецЦикла;
		
	Иначе
		
		ДлинаРазделителя = СтрДлина(Разделитель);
		
		Пока Истина Цикл
			
			Поз = Найти(Стр,Разделитель);
			
			Если Поз=0 Тогда
				
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
				
			КонецЕсли;
			
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции // РазложитьСтрокуВМассив(Знач Стр, Разделитель = ",")

// Функция возвращает значение свойства для переданного объекта
//
// Параметры:
//	Объект   			- ДокументСсылка, СправочникСсылка 	- Ссылка на документ или справочник,
//						для которого получается значение свойства
//  Свойство 			- Строка 							- Свойство, значение которого необходимо получить
// 	ЗначениеПоУмолчанию - Неопределено 						- Значение по умолчанию, которое возвращает функция,
//						если значения свойства или свойства не существует
//
// Возвращаемое значение:
//	Неопределено - Значение свойства для данного объекта или переданное значение по умолчанию
//
Функция ПолучитьЗначениеСвойства(Объект,Свойство,ЗначениеПоУмолчанию=Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект) ИЛИ НЕ ЗначениеЗаполнено(Свойство) Тогда Возврат ЗначениеПоУмолчанию КонецЕсли;
	
	Попытка
		ОбъектСсылка = Объект.Ссылка
	Исключение
		Возврат ЗначениеПоУмолчанию	
	КонецПопытки;
	
	// Найдем ссылку на переданное свойство
	
	ТипЗначения=ТипЗнч(Свойство);
	Если ТипЗначения=Тип("ПланВидовХарактеристикСсылка.СвойстваОбъектов") Тогда
		СвойствоСсылка = Свойство 
	ИначеЕсли ТипЗначения=Тип("Строка") Тогда
		// Поиск предопределенного или по наименованию
		Попытка		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов[СокрЛП(Свойство)];
		Исключение	СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(СокрЛП(Свойство),Истина);
		КонецПопытки; 
	ИначеЕсли ТипЗначения=Тип("Число") Тогда
		// Поиск по коду
		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду(Свойство);
	Иначе СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка()
	КонецЕсли;
	
	Если СвойствоСсылка.Пустая() Тогда Возврат ЗначениеПоУмолчанию КонецЕсли;
	
	// Если свойство найдено, осталось только получить его значение
	СтруктураОтбора = Новый Структура("Объект,Свойство",ОбъектСсылка,СвойствоСсылка);
	ЗначениеСвойства = РегистрыСведений.ЗначенияСвойствОбъектов.Получить(СтруктураОтбора).Значение;
	ВозвратЗначениеПоУмолчанию = ?(ЗначениеПоУмолчанию = Неопределено,ПустоеЗначениеТипа(СвойствоСсылка.ТипЗначения.Типы()[0]),ЗначениеПоУмолчанию);
	
	Возврат ?(ЗначениеСвойства = Неопределено,ВозвратЗначениеПоУмолчанию,ЗначениеСвойства);
	
КонецФункции // ПолучитьЗначениеСвойства()

Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт
	
	Если ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;
		
	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";
		
	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101000000';
		
	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;
		
	Иначе
		Возврат Новый (ЗаданныйТип);
		
	КонецЕсли;
	
КонецФункции // ПустоеЗначениеТипа();

Процедура НазначитьТип(Значение, ТипЗначения) Экспорт
	
	Если ТипЗнч(ТипЗначения.ПривестиЗначение())<>ТипЗнч(Значение) Тогда
		Значение = ТипЗначения.ПривестиЗначение();
	КонецЕсли;
	
КонецПроцедуры

Процедура Запись_ЗаказПоставщику_В_Регистр_при_проведенииОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	//ВОЗВРАТ; //Временно, пока не внедрен SAPPR
	
	КС_8 = Новый КвалификаторыСтроки(8);
	КС_10 = Новый КвалификаторыСтроки(10);
	КС_18 = Новый КвалификаторыСтроки(18);
	КС_20 = Новый КвалификаторыСтроки(20);
	Попытка
		мТипов = Новый Массив;
		мТипов.Добавить(Справочники.ТипыЗаказов.ZMP2Гарантийный);
		мТипов.Добавить(Справочники.ТипыЗаказов.ZMP2Срочный);
		мТипов.Добавить(Справочники.ТипыЗаказов.ZMP4Складской);
	Исключение
		Возврат
	КонецПопытки;

	Если мТипов.Найти(Источник.ТипЗаказа) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Менеджер = РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.СоздатьМенеджерЗаписи();
	Менеджер.ЗаказПоставщику = Источник.Ссылка;
	Менеджер.Прочитать();
	
	Если Менеджер.ОтправлятьВRenault  тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЗаказПоставщикуТовары.Номенклатура.Артикул КАК Артикул,
		                      |	ЗаказПоставщикуТовары.Количество,
		                      |	ЗаказПоставщикуТовары.Коэффициент,
		                      |	ЗаказПоставщикуТовары.ПримечаниеНоменклатура,
		                      |	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику,
		                      |	ЗаказПоставщикуТовары.НомерСтроки КАК ITM_NUMBER,
		                      |	Renault_ДопТабЧастиЗаказПоставщику.ВИН КАК TEXT_LINE,
		                      |	Renault_ДопРеквизитыЗаказаПоставщику.ДатаВыдачиПодменногоАвтомобиля КАК ДатаВыдачи,
		                      |	Renault_ДопРеквизитыЗаказаПоставщику.ТипЗаказаSappr,
		                      |	CRM_ДилерскиеЦентрыПодразделенияОрганизации.Ссылка КАК ДилерскийЦентр
		                      |ПОМЕСТИТЬ ВремТЗ
		                      |ИЗ
		                      |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		                      |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_ДилерскиеЦентры.ПодразделенияОрганизации КАК CRM_ДилерскиеЦентрыПодразделенияОрганизации
		                      |		ПО ЗаказПоставщикуТовары.Ссылка.ПодразделениеКомпании = CRM_ДилерскиеЦентрыПодразделенияОрганизации.Подразделение
		                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопТабЧастиЗаказПоставщику КАК Renault_ДопТабЧастиЗаказПоставщику
		                      |		ПО ЗаказПоставщикуТовары.Номенклатура = Renault_ДопТабЧастиЗаказПоставщику.Номенклатура
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
		                      |		ПО ЗаказПоставщикуТовары.Номенклатура = Renault_КаталогРеферансов.Номенклатура
