////@+ Процедура SAPPR_Запись_ЗаказПоставщику_В_Регистр_при_удаленииПроведенияОбработкаУдаленияПроведения(Источник, Отказ)
//Дата создания - 14.05.2012 16:51:17; Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура производит удаление не отправленных записей из регистра сведений SAPPR_Заказано.
//
// Параметры
//  Источник  - ДокументОбъект.ЗаказПоставщику - документ, который вызвал процедуру по подписке
//
//  Отказ  - Булево - При программном установлении в Истина - выполнение процедуры прекращается.
//
//@-
Процедура SAPPR_Запись_ЗаказПоставщику_В_Регистр_при_удаленииПроведенияОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	//ВОЗВРАТ; //Временно, пока не внедрен SAPPR
	
	// Комментарий 
	//Дата создания - 14.05.2012 16:49:19; Автор - Окипний Андрей Евгеньевич
	//При отмене проведения нужно удалять строки документа, но только те, которые не отправлены.
	//
	Менеджер = РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.СоздатьМенеджерЗаписи();
	Менеджер.ЗаказПоставщику = Источник.Ссылка;
	Менеджер.Прочитать();
	Если Менеджер.ОтправлятьВRenault тогда
		
		//создаем набор записей
		НЗ = РегистрыСведений.SAPPR_Заказано.СоздатьНаборЗаписей();
		//Устанавливаем отбор по заказу
		НЗ.Отбор.ЗаказПоставщику.Установить(Источник.Ссылка);
		НЗ.Отбор.Отправлен.Установить(Ложь);
		
		//Считываем                            
		НЗ.Прочитать();
		НЗ.Очистить();
		НЗ.Записать();
		
	КонецЕсли;
	
КонецПроцедуры // SAPPR_Запись_ЗаказПоставщику_В_Регистр_при_удаленииПроведенияОбработкаУдаленияПроведения(Источник, Отказ)

////@+ Процедура ПодпискаНаСобытиеЗаписьНоменклатуры_TariffPRПриЗаписи(Источник, Отказ)
//Дата создания - 16.05.2012 11:22:37; Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура выполняет подстановку ссылки на номенклатуру в регистр сведений Renault_TariffPR_Номенклатура
//
// Параметры
//  Источник  - СправочникЭлементОбъект - Объект элемента справочника "Номенклатура"
//
//  Отказ  - Булево - флаг отказа от выполнения
//  При установки в ИСТИНА - происходит отказ от выполнения процедуры.
//@-
Процедура ПодпискаНаСобытиеЗаписьНоменклатуры_TariffPRПриЗаписи(Источник, Отказ) Экспорт
	
	ВОЗВРАТ; //Временно, пока не внедрен TARIFPR
	
	//Для груп не выполняем
	Если Источник.ЭтоГруппа тогда возврат КонецЕсли;
	
	//Для помеченных на удаление так же не вызываем
	Если Источник.ПометкаУдаления тогда возврат КонецЕсли;
	
	//Нужно просмотреть № по каталогу (Артикул)
	//и прописать ссылку на эту работу в регистр Renault_TariffPR_Номенклатура
	Если ЗначениеЗаполнено(Источник.Артикул) тогда //№ по каталогу указан
			
			//Создаем набор записей регистра сведений, которые будем переписывать.
			НаборЗаписей = РегистрыСведений.Renault_TariffPR_Номенклатура.СоздатьНаборЗаписей();
			
			//Устанавливаем отбор и считываем
			НаборЗаписей.Отбор.Реферанс.Установить(СокрЛП(Источник.Артикул));
			НаборЗаписей.Прочитать();
			
			//Выгрузим в таблицу значений для пакетной обработки.
			ВремТЗ = НаборЗаписей.Выгрузить();
			Если ВремТЗ.Количество() > 0 тогда
				
				ВремТЗ.ЗаполнитьЗначения(Источник.Ссылка,"Номенклатура");
				
				НаборЗаписей.Загрузить(ВремТЗ);
				НаборЗаписей.Записать();
				
			КонецЕсли;
			
		КонецЕсли;

КонецПроцедуры // ПодпискаНаСобытиеЗаписьНоменклатуры_TariffPRПриЗаписи(Источник, Отказ)

////@+ Процедура OPERACODE_СопоставлениеАвтоработАвтоработыПриЗаписи(Источник, Отказ)
