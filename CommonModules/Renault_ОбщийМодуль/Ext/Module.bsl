Процедура ЗаписатьОтметкиВПланПеремещений(Источник)
	
	Для Каждого СтрокаАвтомобили Из Источник.Автомобили Цикл
		
		Если ЗначениеЗаполнено(СтрокаАвтомобили.DMS_Потребность) Тогда
			текДатаПоступления = СтрокаАвтомобили.DMS_Потребность.ЖелаемаяДатаПеремещения + (СтрокаАвтомобили.DMS_Потребность.ВремяПоступления - Дата('00010101')); 
			МенеджерЗаписи = РегистрыСведений.Renault_ПланПеремещения.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ПотребностьПеремещения = СтрокаАвтомобили.DMS_Потребность;
			МенеджерЗаписи.ДатаПлан = текДатаПоступления;
			МенеджерЗаписи.Прочитать();
			
			Если МенеджерЗаписи.Выбран() Тогда
				МенеджерЗаписи.ДокументПеремещения = Источник.Ссылка;
				МенеджерЗаписи.Перемещено = Истина;
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
			Если Источник.DMS_Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
				ПотребностьОбъект = СтрокаАвтомобили.DMS_Потребность.ПолучитьОбъект();
				ПотребностьОбъект.Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто;
				ПотребностьОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // ЗаписатьОтметкиВПланПеремещений()

Функция ПолучитьПарковочноеМесто(Автомобиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РазмещениеАвтомобилей.Место
	|ИЗ
	|	РегистрСведений.Renault_РазмещениеАвтомобилей КАК Renault_РазмещениеАвтомобилей
	|ГДЕ
	|	Renault_РазмещениеАвтомобилей.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Место;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Процедура DMS_ВыводИзЭксплуатацииАвтомобилейОбработкаПроведенияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
		
	Для Каждого ТекСтрока Из Источник.Активы Цикл
		Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(ТекСтрока.Автомобиль, Перечисления.ВидАвтомобиля.DMS_ДемоПродажа, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Источник.Дата);
	КонецЦикла;
		
КонецПроцедуры

//проверка блокировки автомобиля
//где Объект - VIN(Автомобиль)/Модель/ВариантКомплектации
Функция Блокировка(Объект) Экспорт
	Если ТипЗнч(Объект)=Тип("Строка") Тогда
		Запрос=Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 ГДЕ IS_BLOCKED=ИСТИНА И VIN=&VIN");
		Запрос.УстановитьПараметр("VIN",Объект);
	Иначе
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ РегистрСведений.DMS_БлокировкаПродажиАвтомобилей ГДЕ "
		+?(ТипЗнч(Объект)=Тип("СправочникСсылка.Модели"),"Модель","ВариантКомплектации")+"=&Объект");
		Запрос.УстановитьПараметр("Объект",Объект);
	КонецЕсли;	
	Возврат Не Запрос.Выполнить().Пустой()
КонецФункции