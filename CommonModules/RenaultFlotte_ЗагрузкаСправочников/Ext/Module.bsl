Процедура RenaultFlotte_ЗагрузкаСправочников() Экспорт
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Настройки = DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(,ПараметрыСеанса.DMS_Бренд);
		HTTPЗапрос = Новый HTTPЗапрос();
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		HTTPЗапрос.АдресРесурса = СтрЗаменить(Настройки.serviceName, "/hs/traffic/", "")+ "/hs/Fleet/Dictionaries";
		Соединение = Новый HTTPСоединение(Настройки.URL,Настройки.port,Настройки.login,Настройки.password,,,?(Настройки.SSL, Новый ЗащищенноеСоединениеOpenSSL, Неопределено));
		
		ОтветHTTP = Соединение.Получить(HTTPЗапрос);
		Если ОтветHTTP.КодСостояния <> 200 Тогда
			Возврат;
		КонецЕсли;	
		
		СтруктураОтвет = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());
		ОбновитьСправочник (СтруктураОтвет.Spheres, "Renault_СферыДеятельностиКлиентов");
		ОбновитьСправочник (СтруктураОтвет.Bodymakers, "Renault_Кузовостроители");
		ОбновитьСправочник (СтруктураОтвет.Leasing, "Renault_ЛизинговыеКомпании");
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
		"КорпЗагрузкаДанных.ЗагрузкаСправочников",
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Инфо));
		ВызватьИсключение;
	КонецПопытки;	
КонецПроцедуры

Процедура ОбновитьСправочник(Таблица, ИмяСправочника)
		
	Выборка = Справочники[ИмяСправочника].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		НайденоВТаблице = Ложь;
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Если СтрокаТаблицы.Идентификатор = Выборка.Ссылка.УникальныйИдентификатор() Тогда
				НайденоВТаблице = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не НайденоВТаблице Тогда
			ВыборкаОбъект = Выборка.ПолучитьОбъект();
			ВыборкаОбъект.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ОбъектСсылка = Справочники[ИмяСправочника].ПолучитьСсылку(СтрокаТаблицы.Идентификатор);	
		Объект = ОбъектСсылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.УстановитьПометкуУдаления(СтрокаТаблицы.ПометкаУдаления);
			Объект.Наименование = СтрокаТаблицы.Наименование;
			Объект.Записать();
		Иначе
			Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
			Объект.УстановитьСсылкуНового(ОбъектСсылка);
			Объект.ПометкаУдаления = СтрокаТаблицы.ПометкаУдаления;
			Объект.Наименование = СтрокаТаблицы.Наименование;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры