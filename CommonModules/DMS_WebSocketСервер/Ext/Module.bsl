#Область ПланшетМастераПриемщика

Функция ПроверитьДоступностьПользователя(СтруктураСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.Renault_Автосервис_НастройкиСотрудниковПланшет КАК Renault_Автосервис_НастройкиСотрудниковПланшет
		|ГДЕ
		|	Renault_Автосервис_НастройкиСотрудниковПланшет.Логин = &Логин
		|	И Renault_Автосервис_НастройкиСотрудниковПланшет.Пароль = &Пароль";
	
	Запрос.УстановитьПараметр("Логин", СтруктураСообщения.login);
	Запрос.УстановитьПараметр("Пароль", СтруктураСообщения.password);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции 

Процедура ОтправитьСообщениеОДоступностиПользователя(СтруктураСообщения,Доступен)
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("Available",Доступен);	
	СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.name);
	СтруктураОтвета.Data = СтруктураЗаписи;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);
	
