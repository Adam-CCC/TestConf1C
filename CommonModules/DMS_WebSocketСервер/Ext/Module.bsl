
#Область Вспомогательные_методы

Функция ПолучитьСтруктуруСообщения(type="", from="", destination="")
	СтруктураСообщения = Новый Структура;
	СтруктураСообщения.Вставить("type",type);
	СтруктураСообщения.Вставить("from",from);
	СтруктураСообщения.Вставить("to",destination);
	//СтруктураСообщения.Вставить("message",message);
	СтруктураОшибки = Новый Структура;
	СтруктураОшибки.Вставить("code","");
	СтруктураОшибки.Вставить("description","");
	СтруктураСообщения.Вставить("error",СтруктураОшибки);
	СтруктураСообщения.Вставить("data",Новый Структура);
	
	Возврат СтруктураСообщения;
КонецФункции

Процедура ЗаписатьСообщениеВРегистрСообщенийНаСервере(СтруктураСообщения, Входящее)
	
	Если СтруктураСообщения.type = "error" Тогда 
		Возврат;
	КонецЕсли;
	
	Рег = РегистрыСведений.DMS_WebSocket_Сообщения.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Рег, СтруктураСообщения);
	Рег.ДатаСообщения = ТекущаяДата();
	Рег.ИД = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Рег.Входящее = Входящее;
  	Рег.full = Новый ХранилищеЗначения(СтруктураСообщения);
	// Беседин 23.11.21 заявка 1373 логирование планшета
	Попытка
		Рег.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("СообщениеПланшет" + ?(Входящее, "Вх", "Исх"), УровеньЖурналаРегистрации.Ошибка, Метаданные.РегистрыСведений.DMS_WebSocket_Сообщения,
				СокрЛП(СтруктураСообщения.from) + "_" + СокрЛП(СтруктураСообщения.to) + "_" + СокрЛП(СтруктураСообщения.type), ОписаниеОшибки());		
	КонецПопытки;
	
КонецПроцедуры

Процедура ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураСообщения) Экспорт 

	Очередь = РегистрыСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Очередь, СтруктураСообщения);
	Очередь.NameFrom = СтруктураСообщения.From;
	Очередь.ДатаСообщения = ТекущаяДата();
	Очередь.ИД = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Очередь.full = Новый ХранилищеЗначения(СтруктураСообщения);  
	// Беседин 23.11.21 заявка 1373 логирование планшета
	Попытка
		Очередь.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("СообщениеВПланшетОчередь", УровеньЖурналаРегистрации.Ошибка, Метаданные.РегистрыСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки,
				СокрЛП(СтруктураСообщения.from) + " " + СокрЛП(СтруктураСообщения.to) + " " + СокрЛП(СтруктураСообщения.type), ОписаниеОшибки());		
	КонецПопытки;

КонецПроцедуры
 
Функция СформироватьСтрокуJSON(Объект)
	
	Запись = новый ЗаписьJSON;
    Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Объект);
	
	Возврат Запись.Закрыть();
 
КонецФункции

функция ПрочитатьСтрокуJSON(СтрокаJSON, Соответствие = Ложь)
	
	Если СтрокаJSON = Неопределено Тогда
		Результат = ПолучитьСтруктуруСообщения();
		Возврат Результат;
	КонецЕсли;
	
	Чтение = новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(Чтение, Соответствие);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область Работа_с_компонентой

// возвращаемое значение - Истина если все хорошо, иначе Ложь
Функция вс_ИнициироватьСоединение(ОбъектВебСокет, ПсевдонимНаСервере, АдресПодключения, ПутьККомпоненте) Экспорт
	
	// проверка наличия нужных сведений
	Если ПустаяСтрока(АдресПодключения) 
		Или ПустаяСтрока(ПутьККомпоненте) 
		Или ПустаяСтрока(ПсевдонимНаСервере) Тогда
		
		Сообщить("DMS_WebSocket: Не заполнены параметры подключения");
		
		// Беседин 23.11.21 заявка 1373
		ЗаписьЖурналаРегистрации("ПодключениеПланшет", УровеньЖурналаРегистрации.Ошибка,,"ВебСокет","Не заполнены параметры подключения");
		
		Возврат Ложь;
	КонецЕсли;
	
	// собственно подключение
	Если ОбъектВебСокет = Неопределено Тогда
		Если Не ПодключитьВнешнююКомпоненту(ПутьККомпоненте, "WebSocket", ТипВнешнейКомпоненты.Native) Тогда
			Сообщить("DMS_WebSocket: Ошибка подключения внешней компоненты");
			
			ЗаписьЖурналаРегистрации("ПодключениеПланшет", УровеньЖурналаРегистрации.Ошибка,,"ВебСокет","Ошибка подключения внешней компоненты");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	попытка
		ОбъектВебСокет = Новый("AddIn.WebSocket.Client");
	Исключение // обходим ошибку  Тип не определен (AddIn.WebSocket.Client) 
		Удачно = Ложь;
		для сч = 0 по 100 цикл
			попытка
				ИмяКомпоненты = "WebSocket" + сч;
				ПодключитьВнешнююКомпоненту(ПутьККомпоненте, ИмяКомпоненты, ТипВнешнейКомпоненты.Native);	
			    ОбъектВебСокет = Новый("AddIn."+ИмяКомпоненты+".Client");
			исключение				
				
				Продолжить;
			КонецПопытки;
			Удачно = Истина;
			Прервать;
		КонецЦикла;  		
		
		Если Удачно = Ложь Тогда
			ЗаписьЖурналаРегистрации("ПодключениеПланшет", УровеньЖурналаРегистрации.Ошибка,,"ВебСокет","AddIn.WebSocket.Client");
		КонецЕсли;
	КонецПопытки;
	
	// Беседин 24.11.21 заявка 1963 логировать частую ошибку
	Удачно = Ложь;	
	Описание = ""; ТекстОшибки = "";
	Для Сч = 1 По 20 Цикл
		Попытка
			ОбъектВебСокет.Подключиться(АдресПодключения);
			Удачно = Истина;  // дошли до удачной попытки
		Исключение
			Описание = ОписаниеОшибки();
	 		ТекстОшибки = ОбъектВебСокет.ОписаниеОшибки();
			Удачно = Ложь;
			Продолжить;
		КонецПопытки;
				
		Прервать;
	КонецЦикла;
	Если Удачно = Ложь Тогда
		ЗаписьЖурналаРегистрации("ПодключениеПланшет", УровеньЖурналаРегистрации.Ошибка,,"ВебСокет", Описание + ":" + ТекстОшибки);		
		
		Возврат Ложь;
	КонецЕсли; // Беседин кон
	
	// сразу после подключения, предполагается авторизация на сервере
	ТаймаутПодключения = 5000;	// миллисекунды, сек*1000
	СтруктураОтвета = "";
	Если вс_ПринятьДанные(ОбъектВебСокет, СтруктураОтвета, ТаймаутПодключения, Истина) Тогда
		Если СтруктураОтвета.type = "whoAreYou" Тогда
			СтруктураАвторизации = Новый Структура("name, type", ПсевдонимНаСервере, "whoAreYou");
			вс_ОтправитьДанные(ОбъектВебСокет, СтруктураАвторизации, Истина);
		КонецЕсли;
	Иначе
		Сообщить("DMS_WebSocket: ошибка авторизации");   
		
		ЗаписьЖурналаРегистрации("ПодключениеПланшет", УровеньЖурналаРегистрации.Ошибка,,"ВебСокет","ошибка авторизации");

		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина
	
КонецФункции

Функция вс_ИнициироватьСоединениеСтар(ОбъектВебСокет, ПсевдонимНаСервере, АдресПодключения, ПутьККомпоненте) Экспорт
	
	// проверка наличия нужных сведений
	Если ПустаяСтрока(АдресПодключения) 
		Или ПустаяСтрока(ПутьККомпоненте) 
		Или ПустаяСтрока(ПсевдонимНаСервере) Тогда
		
		Сообщить("DMS_WebSocket: Не заполнены параметры подключения");
		Возврат Ложь;
	КонецЕсли;
	
	// собственно подключение
	Если ОбъектВебСокет = Неопределено Тогда
		Если Не ПодключитьВнешнююКомпоненту(ПутьККомпоненте, "WebSocket", ТипВнешнейКомпоненты.Native) Тогда
			Сообщить("DMS_WebSocket: Ошибка подключения внешней компоненты");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	попытка
		ОбъектВебСокет = Новый("AddIn.WebSocket.Client");
	Исключение // обходим ошибку  Тип не определен (AddIn.WebSocket.Client) 
		для сч = 0 по 100 цикл
			попытка
				ИмяКомпоненты = "WebSocket" + сч;
				ПодключитьВнешнююКомпоненту(ПутьККомпоненте, ИмяКомпоненты, ТипВнешнейКомпоненты.Native);	
			    ОбъектВебСокет = Новый("AddIn."+ИмяКомпоненты+".Client");
			исключение
				Продолжить;
			КонецПопытки;
			Прервать;
		КонецЦикла;  		
	КонецПопытки;
	
	ОбъектВебСокет.Подключиться(АдресПодключения);
	
	// сразу после подключения, предполагается авторизация на сервере
	ТаймаутПодключения = 5000;	// миллисекунды, сек*1000
	СтруктураОтвета = "";
	Если вс_ПринятьДанные(ОбъектВебСокет, СтруктураОтвета, ТаймаутПодключения, Истина) Тогда
		Если СтруктураОтвета.type = "whoAreYou" Тогда
			СтруктураАвторизации = Новый Структура("name, type", ПсевдонимНаСервере, "whoAreYou");
			вс_ОтправитьДанные(ОбъектВебСокет, СтруктураАвторизации, Истина);
		КонецЕсли;
	Иначе
		Сообщить("DMS_WebSocket: ошибка авторизации");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина
	
КонецФункции


Функция вс_ПринятьДанные(ОбъектВебСокет, СтруктураСообщения, Таймаут=0, ЗаписатьВРегистрСообщений=Ложь)
	Перем ДанныеJSON;
	
	Если ОбъектВебСокет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = ОбъектВебСокет.Принять(Таймаут, ДанныеJSON);
	СтруктураСообщения = ПрочитатьСтрокуJSON(ДанныеJSON);
	
	Если Результат Тогда
		Если ЗаписатьВРегистрСообщений Тогда
			ЗаписатьСообщениеВРегистрСообщенийНаСервере(СтруктураСообщения, Истина);
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура вс_ОтправитьДанные(ОбъектВебСокет, СтруктураСообщения, ЗаписатьВРегистрСообщений=Ложь)
	Если ОбъектВебСокет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектВебСокет.Отправить(СформироватьСтрокуJSON(СтруктураСообщения));
	
	Если ЗаписатьВРегистрСообщений Тогда
		ЗаписатьСообщениеВРегистрСообщенийНаСервере(СтруктураСообщения, Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура вс_Отключиться(ОбъектВебСокет) Экспорт
	Если ОбъектВебСокет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектВебСокет.Отключиться();
	ОбъектВебСокет = Неопределено;
КонецПроцедуры

Процедура ПройтиАвторизациюНаСервереВебСокета(ОбъектВебСокет)
	
	ПсевдонимНаСервере = "тест";
	СтруктураАвторизации = Новый Структура("name, type", ПсевдонимНаСервере, "whoAreYou");
	вс_ОтправитьДанные(ОбъектВебСокет, СтруктураАвторизации, Истина);
		
КонецПроцедуры

#КонецОбласти


#Область ЭкспортныеМетоды

Функция ОтправитьСообщенияИзОчереди(ОбъектВебСокет, СчетчикОтправленныхСообщений,ПсевдонимНаСервере) Экспорт
	
	Если ОбъектВебСокет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("NameFrom", ПсевдонимНаСервере);
		БлокировкаДанных.Заблокировать();
		
		Выборка = РегистрыСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки.Выбрать(Новый Структура("NameFrom",ПсевдонимНаСервере), "ИД Возр");
		Пока Выборка.Следующий() Цикл
			СтруктураСообщения = Выборка.full.Получить();
			Если СтруктураСообщения.type = "CheckConnection" Тогда 
				вс_ОтправитьДанные(ОбъектВебСокет, СтруктураСообщения, Ложь);
			Иначе 
				вс_ОтправитьДанные(ОбъектВебСокет, СтруктураСообщения, Истина);
			КонецЕсли;
			СчетчикОтправленныхСообщений = СчетчикОтправленныхСообщений + 1;
			
			Рег = РегистрыСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Рег, Выборка);
			Рег.Прочитать();
			Если Рег.Выбран() Тогда
				Рег.Удалить();
			КонецЕсли;
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(Выборка.to) Тогда 
			//ДобавитьСообщениеВОчередьСообщений(ПсевдонимНаСервере,"CheckConnection","CheckConnection","CheckConnection test");	
 		КонецЕсли;
		
		Если ОбъектВебСокет.Статус <> 1 Тогда 
			ОтменитьТранзакцию(); //  DS-17369
			Возврат Ложь;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ОписаниеОшибки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВебСокет", УровеньЖурналаРегистрации.Ошибка, "РегистрСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки",
			ОписаниеОшибки(), "DMS_WebSocket: Не удалось отправить сообщения:");	
		
		Сообщить("DMS_WebSocket: Не удалось отправить сообщения: " + ОписаниеОшибки);
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Процедура ДобавитьСообщениеВОчередьСообщений(Кто, Кому, ТипСообщения, Сообщение) Экспорт 
	
	СтруктураСообщения = Новый Структура;
	СтруктураСообщения.Вставить("from", Кто);
	СтруктураСообщения.Вставить("to", Кому);
	СтруктураСообщения.Вставить("type", ТипСообщения);
	СтруктураСообщения.Вставить("message", Сообщение);
	
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураСообщения);
	
КонецПроцедуры

Функция ЕстьАктивныеФоновыеЗадания(МассивФЗ = Неопределено) Экспорт
	
	Результат = Ложь;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ИмяМетода", "DMS_WebSocketСервер.ЗапуститьРаботуВФоне");
	СтруктураОтбора.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	МассивФЗ = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураОтбора);
	
	Если МассивФЗ.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция СериализоватьВСтрокуJSON(Объект) Экспорт
	
	Запись = новый ЗаписьJSON;
    Запись.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьJSON(Запись, Объект, НазначениеТипаXML.Явное);
	
	Возврат Запись.Закрыть();
 
КонецФункции

функция ДесериализоватьСтрокуJSON(СтрокаJSON) Экспорт
	
	Чтение = новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	
	Результат = ПрочитатьJSON(Чтение);
	
	Возврат Результат;
	
КонецФункции

