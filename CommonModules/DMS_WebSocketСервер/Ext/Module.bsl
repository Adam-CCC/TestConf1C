	НаборЗаписей = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.РабочийДокумент.Установить(Заявка);
	Попытка
		НаборЗаписей.Записать();
	Исключение
	КонецПопытки;

	
