	ДокОбъект = Док.ПолучитьОбъект();
	ДокОбъект.Заблокировать();
	ДокОбъект.ВремяНачала = '00010101';
	ДокОбъект.ВремяОкончания = '00010101'; 
	ДокОбъект.Записать();	
	
