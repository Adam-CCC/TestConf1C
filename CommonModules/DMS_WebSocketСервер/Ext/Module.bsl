		|	Renault_CRM_ВыдачаАвтомобиля.Автомобиль.Модель.Производитель КАК Марка,
		|	Renault_CRM_ВыдачаАвтомобиля.Автомобиль.Модель КАК НаименованиеМодели,
		|	ЕСТЬNULL(АвтомобилиСрезПоследних.Значение, 0) КАК Пробег,
		|	Renault_CRM_ВыдачаАвтомобиля.ВремяНачала КАК ВремяНачала,
		|	Renault_CRM_ВыдачаАвтомобиля.Клиент КАК Клиент,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Renault_CRM_ВыдачаАвтомобиля.Клиент) = ТИП(Справочник.CRM_ПотенциальныеКонтрагенты)
		|			ТОГДА Renault_CRM_ВыдачаАвтомобиля.Клиент.Фамилия + "" "" + Renault_CRM_ВыдачаАвтомобиля.Клиент.Имя + "" "" + Renault_CRM_ВыдачаАвтомобиля.Клиент.Отчество
		|		ИНАЧЕ Renault_CRM_ВыдачаАвтомобиля.Клиент.Фамилия + "" "" + Renault_CRM_ВыдачаАвтомобиля.Клиент.Имя + "" "" + Renault_CRM_ВыдачаАвтомобиля.Клиент.Отчество
		|	КОНЕЦ КАК ФИО,
		|	Renault_CRM_ВыдачаАвтомобиля.Обращение.Примечание КАК ОбращениеПримечание,
		|	Renault_CRM_ВыдачаАвтомобиля.Обращение КАК Обращение,
		|	Renault_CRM_ВыдачаАвтомобиля.Машиноместо КАК Машиноместо,
		|	Renault_CRM_ВыдачаАвтомобиля.Машиноместо.Представление КАК МастерПриемщик,
		|	ЕСТЬNULL(Renault_СертификатКонтроля.Ссылка, ЗНАЧЕНИЕ(Документ.Renault_СертификатКонтроля.ПустаяСсылка)) КАК СертификатКонтроля,
		|	ЕСТЬNULL(DMS_КонтрольКачестваРабот.Ссылка, ЗНАЧЕНИЕ(Документ.DMS_КонтрольКачестваРабот.ПустаяСсылка)) КАК ККР,
		|	Renault_CRM_ВыдачаАвтомобиля.ДилерскийЦентр.Планшет_ИспользоватьКодАвторабот КАК ИспользоватьКодАвторабот
		|ИЗ
		|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|		ПО Renault_CRM_ВыдачаАвтомобиля.Обращение = Renault_CRM_ЗаявкаНаСервис.Обращение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|		ПО Renault_CRM_ВыдачаАвтомобиля.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
		|			И (АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Пробег))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_СертификатКонтроля КАК Renault_СертификатКонтроля
		|		ПО Renault_CRM_ВыдачаАвтомобиля.Обращение = Renault_СертификатКонтроля.Обращение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.DMS_КонтрольКачестваРабот КАК DMS_КонтрольКачестваРабот
		|		ПО Renault_CRM_ВыдачаАвтомобиля.Обращение = DMS_КонтрольКачестваРабот.Обращение
		|ГДЕ
		|	Renault_CRM_ВыдачаАвтомобиля.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документы.Renault_CRM_ВыдачаАвтомобиля.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.guid)));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураДанных = Новый Структура();
	
	Если Выборка.Следующий() Тогда
		СтруктураДанных.Вставить("guid",Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		
		СтруктураДанных.Вставить("FullName",Строка(Выборка.ФИО));
		СтруктураДанных.Вставить("Number",Renault_УправлениеКонтактнойИнформацией.ТелефонКлиента(Выборка.Клиент));
		СтруктураДанных.Вставить("Email",Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Выборка.Клиент));
		СтруктураДанных.Вставить("Mileage",Строка(Выборка.Пробег));
		
		СтруктураДанных.Вставить("Brand",Строка(Выборка.Марка));
		СтруктураДанных.Вставить("StateNumber",Строка(Выборка.ГосНомер));
		СтруктураДанных.Вставить("VIN",Строка(Выборка.VIN));
		СтруктураДанных.Вставить("Model",Строка(Выборка.НаименованиеМодели));		
		СтруктураДанных.Вставить("Status",Строка(Выборка.Состояние));
		СтруктураДанных.Вставить("TimeOfReceipt",Строка(Формат(Выборка.ВремяНачала,"ДФ=HH:mm")));

		СтруктураДанных.Вставить("Appeal",Строка(Выборка.ОбращениеПримечание));
		СтруктураДанных.Вставить("Version",ЗаписатьДатуJSON(ТекущаяДата(),ФорматДатыJSON.ISO));
		
		СтруктураДанных.Вставить("Recommendation",ПолучитьРекомендациюПоАвтомобилю(Выборка.Автомобиль));
		СтруктураДанных.Вставить("Master",Строка(Выборка.МастерПриемщик));
		
		
		МассивРабот = Новый Массив;

		Если Выборка.ККР = Документы.DMS_КонтрольКачестваРабот.ПустаяСсылка() Тогда
			ЗапросРаботы = Новый Запрос;
			ЗапросРаботы.Текст = 
			"ВЫБРАТЬ
			|	ЗаказНарядРаботы.Ссылка КАК Ссылка,
			|	ЗаказНарядРаботы.Работа КАК Работа,
			|	ЗаказНарядРаботы.Работа.Артикул КАК Артикул,
			|	ЗаказНарядИсполнители.Исполнитель КАК Исполнитель,
			|	ЗаказНарядРаботы.Ссылка.Состояние КАК Состояние,
			|	ЗаказНарядРаботы.Ссылка.Номер КАК Номер,
			|	ЗаказНарядРаботы.Ссылка.Дата КАК Дата,
			|	ЗаказНарядРаботы.ИдентификаторРаботы КАК ИдентификаторРаботы,
			|	ЗаказНарядРаботы.ПримечаниеРаботы КАК ПримечаниеРаботы,
			|	ЗаказНарядРаботы.Ссылка.Комментарий КАК Комментарий,
			|	ЗаказНарядРаботы.Работа.Код КАК КодРаботы
			|ИЗ
			|	Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Исполнители КАК ЗаказНарядИсполнители
			|		ПО ЗаказНарядРаботы.ИдентификаторРаботы = ЗаказНарядИсполнители.ИдентификаторРаботы
			|ГДЕ
			|	ЗаказНарядРаботы.Ссылка В
			|			(ВЫБРАТЬ
			|				Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд КАК ЗаказНаряд
			|			ИЗ
			|				Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
			|					ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
			|					ПО
			|						Renault_CRM_ВыдачаАвтомобиля.Обращение = Renault_CRM_ЗаявкаНаСервис.Обращение
			|			ГДЕ
			|				Renault_CRM_ВыдачаАвтомобиля.Ссылка = &Ссылка)";
			
			ЗапросРаботы.УстановитьПараметр("Ссылка", Выборка.Ссылка);
			
			ВыборкаРаботы = ЗапросРаботы.Выполнить().Выбрать();
			
			ПервыйПроход = Истина;	
			Пока ВыборкаРаботы.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаРаботы.Исполнитель) 
					И Не (ВыборкаРаботы.Исполнитель = Справочники.Сотрудники.ПустаяСсылка()) Тогда
					СтруктураРаботы = Новый Структура;
					СтруктураРаботы.Вставить("AutoWork",Строка(ВыборкаРаботы.Работа));
					Если Выборка.ИспользоватьКодАвторабот Тогда
						СтруктураРаботы.Вставить("AutoWorkCode",СокрЛП(ВыборкаРаботы.КодРаботы));
					Иначе	
						СтруктураРаботы.Вставить("AutoWorkCode",СокрЛП(ВыборкаРаботы.Артикул));
					КонецЕсли;
					СтруктураРаботы.Вставить("Executor",Строка(ВыборкаРаботы.Исполнитель));
					СтруктураРаботы.Вставить("ExecutorID",Строка(ВыборкаРаботы.Исполнитель.УникальныйИдентификатор()));
					СтруктураРаботы.Вставить("Status",Строка(ВыборкаРаботы.Состояние));
					СтруктураРаботы.Вставить("WorkId",ВыборкаРаботы.ИдентификаторРаботы);
					СтруктураРаботы.Вставить("Comment",ВыборкаРаботы.ПримечаниеРаботы);
					СтруктураРаботы.Вставить("Checked",Ложь);
					
					МассивРабот.Добавить(СтруктураРаботы);
				КонецЕсли;
			
				Если ПервыйПроход Тогда
					СтруктураДанных.Вставить("NumderOfOrderWork",Строка(ВыборкаРаботы.Номер));
					СтруктураДанных.Вставить("DateOfOrderWork",ЗаписатьДатуJSON(ВыборкаРаботы.Дата,ФорматДатыJSON.ISO));
					СтруктураДанных.Вставить("CommentOfOrderWork",ВыборкаРаботы.Комментарий);
					СтруктураДанных.Вставить("IdOfOrderWork",Строка(ВыборкаРаботы.Ссылка.УникальныйИдентификатор()));
					ПервыйПроход = Ложь;
				КонецЕсли;
			КонецЦикла;
		Иначе
			//ККР = Документы.DMS_КонтрольКачестваРабот.ПустаяСсылка();
			Для Каждого ОписаниеРаботы Из Выборка.ККР.ВыполненныеРаботы Цикл
				СтруктураРаботы = Новый Структура;
				СтруктураРаботы.Вставить("AutoWork",Строка(ОписаниеРаботы.Работа));
				Если Выборка.ИспользоватьКодАвторабот Тогда
					СтруктураРаботы.Вставить("AutoWorkCode",СокрЛП(ОписаниеРаботы.Работа.Код));
				Иначе
					СтруктураРаботы.Вставить("AutoWorkCode",СокрЛП(ОписаниеРаботы.Работа.Артикул));
				КонецЕсли;
				СтруктураРаботы.Вставить("Executor",Строка(ОписаниеРаботы.Исполнитель));
				СтруктураРаботы.Вставить("ExecutorID",Строка(ОписаниеРаботы.Исполнитель.УникальныйИдентификатор()));
				СтруктураРаботы.Вставить("Status",Строка(ОписаниеРаботы.Статус));
				СтруктураРаботы.Вставить("WorkId",ОписаниеРаботы.ИдентификаторРаботы);
				СтруктураРаботы.Вставить("Comment",ОписаниеРаботы.Комментарий);
				СтруктураРаботы.Вставить("Checked",ОписаниеРаботы.Проверка);
				
				МассивРабот.Добавить(СтруктураРаботы);
			КонецЦикла;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЗаказНаряд.Ссылка КАК Ссылка,
			|	ЗаказНаряд.Номер КАК Номер,
			|	ЗаказНаряд.Дата КАК Дата,
			|	ЗаказНаряд.Комментарий КАК Комментарий
			|ИЗ
			|	Документ.ЗаказНаряд КАК ЗаказНаряд
			|ГДЕ
			|	ЗаказНаряд.Ссылка В
			|			(ВЫБРАТЬ
			|				Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд КАК ЗаказНаряд
			|			ИЗ
			|				Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
			|					ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
			|					ПО
			|						Renault_CRM_ВыдачаАвтомобиля.Обращение = Renault_CRM_ЗаявкаНаСервис.Обращение
			|			ГДЕ
			|				Renault_CRM_ВыдачаАвтомобиля.Ссылка = &Ссылка)";
			
			Запрос.УстановитьПараметр("Ссылка", Выборка.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаРаботы = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаРаботы.Следующий() Цикл
				СтруктураДанных.Вставить("NumderOfOrderWork",Строка(ВыборкаРаботы.Номер));
				СтруктураДанных.Вставить("DateOfOrderWork",ЗаписатьДатуJSON(ВыборкаРаботы.Дата,ФорматДатыJSON.ISO));
				СтруктураДанных.Вставить("CommentOfOrderWork",ВыборкаРаботы.Комментарий);
				СтруктураДанных.Вставить("IdOfOrderWork",Строка(ВыборкаРаботы.Ссылка.УникальныйИдентификатор()));
			КонецЦикла;

		КонецЕсли;			
		СтруктураДанных.Вставить("AutoWorks",МассивРабот);

		Если Выборка.СертификатКонтроля = Документы.Renault_СертификатКонтроля.ПустаяСсылка() Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	DMS_ПереченьОперацийКСиТО.Родитель КАК Родитель,
			|	DMS_ПереченьОперацийКСиТО.Ссылка КАК Ссылка,
			|	DMS_ПереченьОперацийКСиТО.Код КАК Код,
			|	DMS_ПереченьОперацийКСиТО.Наименование КАК Наименование,
			|	DMS_ПереченьОперацийКСиТО.КС КАК КС,
			|	DMS_ПереченьОперацийКСиТО.ТО КАК ТО,
			|	ЛОЖЬ КАК ЗначениеКС,
			|	ЛОЖЬ КАК ЗначениеТО
			|ИЗ
			|	Справочник.DMS_ПереченьОперацийКСиТО КАК DMS_ПереченьОперацийКСиТО
			|ГДЕ
			|	НЕ DMS_ПереченьОперацийКСиТО.ПометкаУдаления
			|	И НЕ DMS_ПереченьОперацийКСиТО.ЭтоГруппа
			|ИТОГИ ПО
			|	Родитель ИЕРАРХИЯ";
			
			РезультатЗапроса = Запрос.Выполнить();
						
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_СертификатКонтроляПереченьОпераций.Операция.Родитель КАК Родитель,
			|	Renault_СертификатКонтроляПереченьОпераций.Операция.Ссылка КАК Ссылка,
			|	Renault_СертификатКонтроляПереченьОпераций.Операция.Код КАК Код,
			|	Renault_СертификатКонтроляПереченьОпераций.Операция.Наименование КАК Наименование,
			|	Renault_СертификатКонтроляПереченьОпераций.Операция.КС КАК КС,
			|	Renault_СертификатКонтроляПереченьОпераций.Операция.ТО КАК ТО,
			|	Renault_СертификатКонтроляПереченьОпераций.КС КАК ЗначениеКС,
			|	Renault_СертификатКонтроляПереченьОпераций.ТО КАК ЗначениеТО
			|ИЗ
			|	Документ.Renault_СертификатКонтроля.ПереченьОпераций КАК Renault_СертификатКонтроляПереченьОпераций
			|ГДЕ
			|	Renault_СертификатКонтроляПереченьОпераций.Ссылка = &Ссылка
			|ИТОГИ ПО
			|	Родитель ИЕРАРХИЯ";
			
			Запрос.УстановитьПараметр("Ссылка", Выборка.СертификатКонтроля);
			
			РезультатЗапроса = Запрос.Выполнить();
						
		КонецЕсли;
		
		МассивРодитель = Новый Массив;
		
		
		ВыборкаРодитель = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаРодитель.Следующий() Цикл
			СтруктураРодитель = Новый Структура;
			СтруктураРодитель.Вставить("OperationParentName",Строка(ВыборкаРодитель.Родитель));
			СтруктураРодитель.Вставить("OperationParentCode",ВыборкаРодитель.Родитель.Код);
			
			ВыборкаДетальныеЗаписи = ВыборкаРодитель.Выбрать();
			
			МассивОпераций = Новый Массив;
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СтруктураОперации = Новый Структура;
				
				СтруктураОперации.Вставить("OperationName",ВыборкаДетальныеЗаписи.Наименование);
				СтруктураОперации.Вставить("OperationCode",ВыборкаДетальныеЗаписи.Код);
				СтруктураОперации.Вставить("CanBeFilledP",ВыборкаДетальныеЗаписи.КС);
				СтруктураОперации.Вставить("CanBeFilledTO",ВыборкаДетальныеЗаписи.ТО);
				СтруктураОперации.Вставить("P",ВыборкаДетальныеЗаписи.ЗначениеКС);
				СтруктураОперации.Вставить("TO",ВыборкаДетальныеЗаписи.ЗначениеТО);
				МассивОпераций.Добавить(СтруктураОперации);
			КонецЦикла;
			СтруктураРодитель.Вставить("ChildOperations",МассивОпераций);
			МассивРодитель.Добавить(СтруктураРодитель);
		КонецЦикла;
		СтруктураДанных.Вставить("Operations",МассивРодитель);
	КонецЕсли;
	
	СтруктураОтвета = ПолучитьСтруктуруСообщения("Extradition", СтруктураСообщения.to, СтруктураСообщения.name);
	СтруктураОтвета.Data = СтруктураДанных;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);

КонецПроцедуры

Функция ПолучитьРекомендациюПоАвтомобилю(Автомобиль)
	
	МассивРекомендаций = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПоврежденияАвтомобилейСрезПоследних.Работа КАК Авторабота,
		|	Renault_ПоврежденияАвтомобилейСрезПоследних.Работа.Артикул КАК АртикулРекомендации,
		|	Renault_ПоврежденияАвтомобилейСрезПоследних.РаботаАктуальна КАК АктуальностьРекомендованныхРабот,
		|	Renault_ПоврежденияАвтомобилейСрезПоследних.РекомендуемаяДатаВыполнения КАК РекомендуемаяДатаВыполнения,
		|	Renault_ПоврежденияАвтомобилейСрезПоследних.ПроцентИзноса КАК ПроцентИзноса
		|ИЗ
		|	РегистрСведений.Renault_ПоврежденияАвтомобилей.СрезПоследних(
		|			&ТекущаяДата,
		|			Автомобиль = &Автомобиль
		|				И Работа.Артикул <> """") КАК Renault_ПоврежденияАвтомобилейСрезПоследних
		|ГДЕ
		|	Renault_ПоврежденияАвтомобилейСрезПоследних.РаботаАктуальна";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураРекомендаций = Новый Структура;
		СтруктураРекомендаций.Вставить("Recommendation", Строка(Выборка.Авторабота));
		СтруктураРекомендаций.Вставить("RecommendationCode", Строка(Выборка.АртикулРекомендации));
		//СтруктураРекомендаций.Вставить("RelevanceOfRecommendation",Выборка.АктуальностьРекомендованныхРабот);
		СтруктураРекомендаций.Вставить("RecommendedDueDate", ЗаписатьДатуJSON(Выборка.РекомендуемаяДатаВыполнения,ФорматДатыJSON.ISO));
		Попытка
			СтруктураРекомендаций.Вставить("RecommendedWearPercentage", Число(Выборка.ПроцентИзноса));
		Исключение
			СтруктураРекомендаций.Вставить("RecommendedWearPercentage", 0);
		КонецПопытки;		
		//СтруктураРекомендаций.Вставить("RecommendationPrice",Выборка.СтоимостьРекомендации);
		Цена = Renault_АвтосервисОбщий.ПолучитьЦенуРаботы(Выборка.Авторабота,Автомобиль);
		СуммаРаботы = ?(ЗначениеЗаполнено(Цена),Цена[0].Цена * Выборка.Авторабота.ВремяВыполнения,0);		
		СтруктураРекомендаций.Вставить("RecommendationPrice",?(СуммаРаботы = 0 И ЗначениеЗаполнено(Цена),Цена[0].Нормочас.Цена * Выборка.Авторабота.ВремяВыполнения,СуммаРаботы));
		МассивРекомендаций.Добавить(СтруктураРекомендаций);
		
	КонецЦикла;
	
	Возврат МассивРекомендаций;
	
КонецФункции

Функция ПолучитьТоп30Работ(Автомобиль, ДилерскийЦентр)

	МассивРабот = Новый Массив;
	
	НоваяСхема = Истина;
	
	Если НоваяСхема Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CRM_ДилерскиеЦентрыРаботыДляПланшета.Авторабота КАК РаботаЗапчасть,
		               |	CRM_ДилерскиеЦентрыРаботыДляПланшета.Авторабота.ВремяВыполнения КАК ДлительностьКоличество,
		               |	ВЫБОР
		               |		КОГДА CRM_ДилерскиеЦентрыРаботыДляПланшета.Ссылка.Планшет_ИспользоватьКодАвторабот
		               |			ТОГДА CRM_ДилерскиеЦентрыРаботыДляПланшета.Авторабота.Код
		               |		ИНАЧЕ CRM_ДилерскиеЦентрыРаботыДляПланшета.Авторабота.Артикул
		               |	КОНЕЦ КАК Артикул
		               |ИЗ
		               |	Справочник.CRM_ДилерскиеЦентры.РаботыДляПланшета КАК CRM_ДилерскиеЦентрыРаботыДляПланшета
		               |ГДЕ
		               |	CRM_ДилерскиеЦентрыРаботыДляПланшета.Ссылка = &ДилерскийЦентр";	
		
		Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);

	Иначе
		ГодВыпуска = Год(Автомобиль.ГодВыпуска);
		Пробег = Renault_АвтосервисОбщий.Renault_ПолучитьПробег(Автомобиль);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 30
		|	Renault_ЧастоИспользуемыеРаботы.Авторабота КАК РаботаЗапчасть,
		|	СУММА(1) КАК Количество,
		|	Renault_ЧастоИспользуемыеРаботы.Модель КАК Модель,
		|	Renault_ЧастоИспользуемыеРаботы.Авторабота.Артикул КАК Артикул,
		|	Renault_ЧастоИспользуемыеРаботы.Авторабота.ВремяВыполнения КАК ДлительностьКоличество
		|ИЗ
		|	РегистрНакопления.Renault_ЧастоИспользуемыеРаботы КАК Renault_ЧастоИспользуемыеРаботы
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ОтборМодель = ИСТИНА
		|				ТОГДА Renault_ЧастоИспользуемыеРаботы.Модель = &Модель
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &Пробег > 1
		|				ТОГДА Renault_ЧастоИспользуемыеРаботы.Пробег МЕЖДУ &Пробег - 5000 И &Пробег + 5000
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &ГодВыпуска > 1
		|				ТОГДА Renault_ЧастоИспользуемыеРаботы.ГодВыпуска МЕЖДУ &ГодВыпуска - 1 И &ГодВыпуска + 1
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	Renault_ЧастоИспользуемыеРаботы.Авторабота,
		|	Renault_ЧастоИспользуемыеРаботы.Модель,
		|	Renault_ЧастоИспользуемыеРаботы.Авторабота.Артикул,
		|	Renault_ЧастоИспользуемыеРаботы.Авторабота.ВремяВыполнения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Количество УБЫВ";
		
		Запрос.УстановитьПараметр("ГодВыпуска", ГодВыпуска);
		Запрос.УстановитьПараметр("Модель", Автомобиль.Модель);
		Запрос.УстановитьПараметр("ОтборМодель", Истина);
		Запрос.УстановитьПараметр("Пробег", Пробег);
	КонецЕсли;
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураРаботы = Новый Структура;
		СтруктураРаботы.Вставить("AutoWork",Строка(Выборка.РаботаЗапчасть));
		СтруктураРаботы.Вставить("AutoWorkCode",СокрЛП(Выборка.Артикул));
		СтруктураРаботы.Вставить("WorkDuration",Строка(Выборка.ДлительностьКоличество));
		Цена = Renault_АвтосервисОбщий.ПолучитьЦенуРаботы(Выборка.РаботаЗапчасть,Автомобиль);
		СуммаРаботы = ?(ЗначениеЗаполнено(Цена),Цена[0].Цена * Выборка.ДлительностьКоличество,0);		
		СтруктураРаботы.Вставить("Price",?(СуммаРаботы = 0 И ЗначениеЗаполнено(Цена),Цена[0].Нормочас.Цена * Выборка.ДлительностьКоличество,СуммаРаботы));
		МассивРабот.Добавить(СтруктураРаботы);
	КонецЦикла;
	
	Возврат МассивРабот;

КонецФункции // ПолучитьТоп30Работ()

Функция ПолучитьТоп30Запчастей(Автомобиль, ТипЦен)
	
	МассивЗапчастей = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.РаботаЗапчасть КАК РаботаЗапчасть,
	|	ВложенныйЗапрос.Количество КАК Количество,
	|	ВложенныйЗапрос.Модель КАК Модель,
	|	ВложенныйЗапрос.Артикул КАК Артикул,
	|	ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) КАК Цена
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 30
	|		Renault_ЧастоИспользуемыеЗапчасти.Номенклатура КАК РаботаЗапчасть,
	|		СУММА(1) КАК Количество,
	|		Renault_ЧастоИспользуемыеЗапчасти.Модель КАК Модель,
	|		Renault_ЧастоИспользуемыеЗапчасти.Номенклатура.Артикул КАК Артикул
	|	ИЗ
	|		РегистрНакопления.Renault_ЧастоИспользуемыеЗапчасти КАК Renault_ЧастоИспользуемыеЗапчасти
	|	ГДЕ
	|		ВЫБОР
	|				КОГДА &ОтборМодель = ИСТИНА
	|					ТОГДА Renault_ЧастоИспользуемыеЗапчасти.Модель = &Модель
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Renault_ЧастоИспользуемыеЗапчасти.Номенклатура,
	|		Renault_ЧастоИспользуемыеЗапчасти.Модель,
	|		Renault_ЧастоИспользуемыеЗапчасти.Номенклатура.Артикул
	|	
	|	УПОРЯДОЧИТЬ ПО
	|		Количество УБЫВ) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(, ) КАК ЦеныСрезПоследних
	|		ПО ВложенныйЗапрос.РаботаЗапчасть = ЦеныСрезПоследних.Номенклатура
	|			И (ЦеныСрезПоследних.ТипЦен = &ТипЦен)";
	
	Запрос.УстановитьПараметр("ОтборМодель", Истина);
	Запрос.УстановитьПараметр("Модель", Автомобиль.Модель);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураЗапчасти = Новый Структура;
		СтруктураЗапчасти.Вставить("Part",Строка(Выборка.РаботаЗапчасть));
		СтруктураЗапчасти.Вставить("PartCode",СокрЛП(Выборка.Артикул));
		СтруктураЗапчасти.Вставить("Price",Выборка.Цена);
		МассивЗапчастей.Добавить(СтруктураЗапчасти);
	КонецЦикла;

	Возврат МассивЗапчастей;
	
КонецФункции

Процедура ОбработатьЗаявкуСПланшета(СтруктураСообщения) 
	
	ЗаявкаОбновлена = Ложь;
	ЗаявкаДополнена = Ложь;

	Если СтруктураСообщения.Свойство("id") Тогда
		
		ЗаявкаСсылка = Документы.Renault_CRM_ЗаявкаНаСервис.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.id));
		ТипЦен = ЗаявкаСсылка.ДилерскийЦентр.Автосервис_ТипЦенПродажи;
		Если DMS_ОбщегоНазначенияСервер.СсылкаСуществует(ЗаявкаСсылка) Тогда
			ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();
			
			Если Не ЗаявкаСсылка.ОбновленСПланшета Тогда
				
				#Область ОбновлениеРаботИЗапчастей
				ТаблицаЗапчастиПланшет = Новый ТаблицаЗначений;
				ТаблицаЗапчастиПланшет.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
				ТаблицаЗапчастиПланшет.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
				Для Каждого ЭлементМассива Из СтруктураСообщения.parts Цикл
					НоваяСтрока = ТаблицаЗапчастиПланшет.Добавить();
					НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",ЭлементМассива.part.id);
					НоваяСтрока.Количество = ЭлементМассива.count;
				КонецЦикла;
				ТаблицаЗапчастейБаза = ЗаявкаОбъект.Товары.Выгрузить(,"Номенклатура,Количество");
				
				РазницаТаблицЗапчасти = РазницаТаблицЗначений(ТаблицаЗапчастиПланшет,ТаблицаЗапчастейБаза,"Номенклатура,Количество");
				
				ЗаявкаОбъект.ТоварыДополнениеПланшет.Очистить();
				
				Для Каждого ЭлементМассива Из РазницаТаблицЗапчасти Цикл 
					НоваяСтрока = ЗаявкаОбъект.Товары.Добавить();
					НоваяСтрока.Номенклатура 	= ЭлементМассива.Номенклатура;
					НоваяСтрока.Количество 		= ЭлементМассива.Количество;
					НоваяСтрока.Цена 			= Renault_Advanced_Ценообразование.ПолучитьЦенуНоменклатуры(НоваяСтрока.Номенклатура,,ТипЦен,ЗаявкаОбъект.Дата);
					НоваяСтрока.Сумма 			= НоваяСтрока.Количество * НоваяСтрока.Цена;
					НоваяСтрока.ОстатокНаСкладе = Renault_АвтосервисОбщий.Renault_ПроверитьОстатокНаСкладе(НоваяСтрока.Номенклатура, ЗаявкаСсылка.ДилерскийЦентр.Автосервис_СкладПоУмолчанию);
					
					//заполнение дополнения с планшета
					НоваяСтрокаТоварыДоп = ЗаявкаОбъект.ТоварыДополнениеПланшет.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаТоварыДоп,НоваяСтрока);
				КонецЦикла;
				
				
				//Сравнение работ
				ТаблицаРаботПланшет = Новый ТаблицаЗначений;
				ТаблицаРаботПланшет.Колонки.Добавить("Работа",Новый ОписаниеТипов("СправочникСсылка.Автоработы"));
				//ТаблицаЗапчастейПланшет.Колонки.Добавить("Длительность");
				Для Каждого ЭлементМассива Из СтруктураСообщения.works Цикл
					НоваяСтрока = ТаблицаРаботПланшет.Добавить();
					Если ЗаявкаСсылка.ДилерскийЦентр.Планшет_ИспользоватьКодАвторабот Тогда
						Работа = Справочники.Автоработы.НайтиПоКоду(ЭлементМассива.work.id);
						Если Работа.Пустая() Тогда
							НоваяСтрока.Работа = Справочники.Автоработы.НайтиПоРеквизиту("Артикул",ЭлементМассива.work.id);	//Если это комплекс сервис				
						Иначе
							НоваяСтрока.Работа = Работа;
						КонецЕсли;
					Иначе
						НоваяСтрока.Работа = Справочники.Автоработы.НайтиПоРеквизиту("Артикул",ЭлементМассива.work.id);
					КонецЕсли;
				КонецЦикла;	
				
				ТаблицаРаботБаза = ЗаявкаОбъект.Работы.Выгрузить(,"Работа");
				
				РазницаТаблицРабота = РазницаТаблицЗначений(ТаблицаРаботПланшет,ТаблицаРаботБаза,"Работа");
				
				ЗаявкаОбъект.РаботыДополнениеПланшет.Очистить();
				
				Для Каждого ЭлементМассива Из РазницаТаблицРабота Цикл 
					КомплексСервис = Справочники.Renault_КомплексСервисыАвторабот.НайтиПоРеквизиту("Артикул",ЭлементМассива.Работа.Артикул);
					
					Если КомплексСервис.Пустая() Тогда
						НоваяСтрока = ЗаявкаОбъект.Работы.Добавить();
						НоваяСтрока.Работа 		= ЭлементМассива.Работа;
						НоваяСтрока.Нормочас 	= ЗаявкаОбъект.Нормочас;
						
						НоваяСтрока.Длительность 	= ПолучитьВремяВыполненияРаботы(НоваяСтрока.Работа, ЗаявкаОбъект.Автомобиль.Модель);
						Если НоваяСтрока.Длительность = 0 Тогда
							НоваяСтрока.Длительность = 1;
						КонецЕсли;
						НоваяСтрока.ДлительностьЗН 	= НоваяСтрока.Длительность;					
						
						Цена 				= Renault_АвтосервисОбщий.ПолучитьЦенуРаботы(НоваяСтрока.Работа,ЗаявкаОбъект.Автомобиль);
						СуммаРаботы = ?(ЗначениеЗаполнено(Цена),Цена[0].Цена * НоваяСтрока.Работа.ВремяВыполнения,0);		
						СуммаРаботы = ?(СуммаРаботы = 0 И ЗначениеЗаполнено(Цена),Цена[0].Нормочас.Цена * НоваяСтрока.Длительность,СуммаРаботы);
						НоваяСтрока.Сумма = СуммаРаботы;
						
						//НоваяСтрока.Цена 	= ?(ЗначениеЗаполнено(Цена),Цена,ЗаявкаОбъект.Нормочас.Цена);
						
						
						//НоваяСтрока.Сумма 	= НоваяСтрока.Цена * НоваяСтрока.Длительность;
						НоваяСтрока.Цена = СуммаРаботы/НоваяСтрока.Длительность;
						
						НоваяСтрокаТоварыДоп = ЗаявкаОбъект.РаботыДополнениеПланшет.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТоварыДоп,НоваяСтрока);
						
					Иначе
						ТаблицаСоставаКС = ТаблицаСоставаКС();
						ОбработкаПодбораКС = Обработки.Renault_ПодборКомплексСервисов.Создать();
						ОбработкаПодбораКС.ЗаполнитьСоставПоКомплексу(КомплексСервис,ТаблицаСоставаКС,ЗаявкаСсылка.ДилерскийЦентр);
						
						Для каждого ТекСтрока из ТаблицаСоставаКС Цикл
							Если ЗначениеЗаполнено(ТекСтрока.Работа) Тогда
								СуммаРабот = ТекСтрока.Цена;
								НоваяСтрокаРабота = ЗаявкаОбъект.Работы.Добавить();
								НоваяСтрокаРабота.Коэффициент = 1;//ПолучитьКоэффициентСложностиРаботы(ТекСтрока.Работа, ТекВидРемонта);
								ЗаполнитьЗначенияСвойств(НоваяСтрокаРабота, ТекСтрока);
								НоваяСтрокаРабота.Нормочас = ЗаявкаСсылка.Нормочас;
								Если НоваяСтрокаРабота.Длительность <> 0 Тогда
									НоваяСтрокаРабота.Цена = НоваяСтрокаРабота.Сумма / НоваяСтрокаРабота.Длительность;
								КонецЕсли;
								НоваяСтрокаРабота.Сумма = ТекСтрока.Стоимость;
								НоваяСтрокаРабота.ЭтоКомплексСервис = Истина;
								НоваяСтрокаТоварыДоп = ЗаявкаОбъект.РаботыДополнениеПланшет.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрокаТоварыДоп,НоваяСтрокаРабота);
								НоваяСтрокаТоварыДоп.Сумма = СуммаРабот; 
							ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
								НоваяСтрока = ЗаявкаОбъект.Товары.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
								//НоваяСтрока.Цена = ПолучитьЦену(ТекСтрока.Номенклатура,ЗаявкаСсылка.ТипЦен,Истина);
								НоваяСтрока.Цена = ПолучитьЦену(ТекСтрока.Номенклатура,ТипЦен,Истина);
								НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
								СуммаРабот = СуммаРабот - НоваяСтрока.Сумма;
								НоваяСтрока.ОстатокНаСкладе = Renault_АвтосервисОбщий.Renault_ПроверитьОстатокНаСкладе(НоваяСтрока.Номенклатура, ЗаявкаСсылка.ДилерскийЦентр.Автосервис_СкладПоУмолчанию);
							КонецЕсли;
							Если НоваяСтрокаРабота.Длительность <> 0 Тогда
								НоваяСтрокаРабота.Цена = СуммаРабот / НоваяСтрокаРабота.Длительность;
							КонецЕсли;
							НоваяСтрокаРабота.Сумма = СуммаРабот;
							
						КонецЦикла;
					КонецЕсли;
					
				КонецЦикла;
				ЗаявкаДополнена = РазницаТаблицЗапчасти.Количество() > 0 ИЛИ РазницаТаблицРабота.Количество() > 0;
				Если ЗаявкаДополнена Тогда
					ЗаявкаОбъект.СуммаРаботВсего = ЗаявкаОбъект.Работы.Итог("Сумма");
					ЗаявкаОбъект.СуммаЗапчастиВсего = ЗаявкаОбъект.Товары.Итог("Сумма");
					ЗаявкаОбъект.СтоимостьВсего = ЗаявкаОбъект.СуммаРаботВсего + ЗаявкаОбъект.СуммаЗапчастиВсего;
				КонецЕсли;
				#КонецОбласти
			КонецЕсли;	
			
			#Область Повреждения
			НаборЗаписей = РегистрыСведений.Renault_ПоврежденияКузова.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Обращение.Установить(ЗаявкаСсылка.Обращение);
			НаборЗаписей.Отбор.Автомобиль.Установить(ЗаявкаСсылка.Автомобиль);
			НаборЗаписей.Записать();
			
			Если ЗначениеЗаполнено(СтруктураСообщения.exteriorPoints.back) Тогда
				ЗаполнитьПоврежденияКузова(ЗаявкаСсылка,СтруктураСообщения.exteriorPoints.back);	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтруктураСообщения.exteriorPoints.front) Тогда
				ЗаполнитьПоврежденияКузова(ЗаявкаСсылка,СтруктураСообщения.exteriorPoints.front);		
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтруктураСообщения.exteriorPoints.left) Тогда
				ЗаполнитьПоврежденияКузова(ЗаявкаСсылка,СтруктураСообщения.exteriorPoints.left);		
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтруктураСообщения.exteriorPoints.right) Тогда
				ЗаполнитьПоврежденияКузова(ЗаявкаСсылка,СтруктураСообщения.exteriorPoints.right);		
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтруктураСообщения.interiorPoints) Тогда
				ЗаполнитьПоврежденияКузова(ЗаявкаСсылка,СтруктураСообщения.interiorPoints);		
			КонецЕсли;
			
			#КонецОбласти
			//ЗаявкаОбъект.Состояние = Справочники.ВидыСостоянийЗаказНарядов.ВРаботе;
			//ЗаявкаОбъект.ДобавленыРаботыСПланшета = РазницаТаблицРабота.Количество() > 0;
			
			// Беседин 10.12.21 заявка 1373
			ЗаявкаОбъект.ОбновленСПланшета = Истина;
			ЗаписьЖурналаРегистрации("ЗаявкаСПланшета", УровеньЖурналаРегистрации.Предупреждение,,ЗаявкаСсылка, "Пришла заявка с планшета");
			
			Попытка
				ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
				ЗаявкаОбновлена = Истина;
			Исключение
				ЗаписьЖурналаРегистрации("ЗаявкаСПланшета", УровеньЖурналаРегистрации.Ошибка,,ЗаявкаСсылка, "Не обновилась заявка с планшета");
			КонецПопытки;
				
			Попытка
				ТабДок = ЗаявкаОбъект.ПодготовитьФормуЗаявкиКПечати();
				ТабДок.АвтоМасштаб=Истина;
				ИмяФайла=ПолучитьИмяВременногоФайла("pdf");
				ТабДок.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
				Данные=Новый ДвоичныеДанные(ИмяФайла);
				ЗаявкаКПечати = Base64Строка(Данные);
			Исключение
				ТабДок = Новый ТабличныйДокумент;
				ИмяФайла=ПолучитьИмяВременногоФайла("pdf");
				ТабДок.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
				Данные=Новый ДвоичныеДанные(ИмяФайла);
				ЗаявкаКПечати = Base64Строка(Данные);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	//Сделать печать заявки "Заявка на ремонт" или "Печать заявки"
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("status",?(ЗаявкаОбновлена,"success","error"));
	Если ЗаявкаОбновлена Тогда
		СтруктураДанных.Вставить("PrintFile",ЗаявкаКПечати);
	КонецЕсли;
	СтруктураОтвета = ПолучитьСтруктуруСообщения("OrderUpdate", СтруктураСообщения.to, СтруктураСообщения.name);
	СтруктураОтвета.Data = СтруктураДанных;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);

КонецПроцедуры

Процедура ОбработатьВыдачуСПланшета(СтруктураСообщения)
	
	ВыдачаОбновлена = Ложь;
	СертификатОбновлен = Ложь;
	НеобходимаПечать = СтруктураСообщения.Свойство("needPrint") И СтруктураСообщения.needPrint;
	Если СтруктураСообщения.Свойство("id") Тогда
		
		ВыдачаСсылка = Документы.Renault_CRM_ВыдачаАвтомобиля.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.id));
		
		Если DMS_ОбщегоНазначенияСервер.СсылкаСуществует(ВыдачаСсылка) Тогда
			Если СтруктураСообщения.Свойство("works") И (СтруктураСообщения.works.Количество() > 0) Тогда
				
				ККРСсылка = ПолучитьККРПоВыдаче(ВыдачаСсылка);
				ККРОбъект = ККРСсылка.ПолучитьОбъект();
				
				Для Каждого РаботаСКомментарием из СтруктураСообщения.works Цикл
					Отбор = Новый Структура;
					Отбор.Вставить("ИдентификаторРаботы",РаботаСКомментарием.id);
					Отбор.Вставить("Исполнитель", Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(РаботаСКомментарием.executorID)));
					СтрокиККР = ККРОбъект.ВыполненныеРаботы.НайтиСтроки(Отбор);
					Если СтрокиККР.Количество() = 1 Тогда 
						СтрокаККР = СтрокиККР[0];
					Иначе
						СтрокаККР = ККРОбъект.ВыполненныеРаботы.Найти(РаботаСКомментарием.id,"ИдентификаторРаботы");
					КонецЕсли;
					СтрокаККР.Комментарий = РаботаСКомментарием.comment;
					СтрокаККР.Проверка = РаботаСКомментарием.checked;
					Если ВРег(РаботаСКомментарием.result) = "ГОТОВО" Тогда
						СтатусРабот = Справочники.ВидыСостоянийЗаказНарядов.Выполнен;
					ИначеЕсли ВРег(РаботаСКомментарием.result) = "НЕ ГОТОВО" Тогда
						СтатусРабот = Справочники.ВидыСостоянийЗаказНарядов.НайтиПоНаименованию("Не готово");	
					ИначеЕсли ВРег(РаботаСКомментарием.result) = "В РАБОТЕ" Тогда
						СтатусРабот = Справочники.ВидыСостоянийЗаказНарядов.ВРаботе;
					ИначеЕсли ВРег(РаботаСКомментарием.result) = "НЕ НАЧАТА" Тогда
						СтатусРабот = Справочники.ВидыСостоянийЗаказНарядов.НачатьРаботу;
					Иначе
						Продолжить;
					КонецЕсли;
					СтрокаККР.Статус = СтатусРабот;
				КонецЦикла;
				ККРОбъект.Записать();
			КонецЕсли;
			Если СтруктураСообщения.Свойство("reason") И Не ПустаяСтрока(СтруктураСообщения.reason.id) Тогда
				ЗаказНарядСсылка = Документы.ЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.reason.id));
				Если DMS_ОбщегоНазначенияСервер.СсылкаСуществует(ЗаказНарядСсылка) И (Не ЗаказНарядСсылка.Комментарий = СтруктураСообщения.reason.comment) Тогда
					ЗаказНарядОбъект = ЗаказНарядСсылка.ПолучитьОбъект();
					ЗаказНарядОбъект.ОбменДанными.Загрузка = Истина;
					ЗаказНарядОбъект.Комментарий = СтруктураСообщения.reason.comment;
					ЗаказНарядОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
			Если СтруктураСообщения.Свойство("operations") Тогда
				СертификатСсылка = ПолучитьСертификатКонтроляПоВыдаче(ВыдачаСсылка);
				Если Не СертификатСсылка = Документы.Renault_СертификатКонтроля.ПустаяСсылка() Тогда 
					СертификатОбъект = СертификатСсылка.ПолучитьОбъект();
					//СертификатОбъект = Документы.Renault_СертификатКонтроля.СоздатьДокумент();

					Для Каждого ОперацияОсмотра Из СтруктураСообщения.operations Цикл
						
						Если ОперацияОсмотра.OperationCode = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						ТекущаяОперация = Справочники.DMS_ПереченьОперацийКСиТО.НайтиПоКоду(ОперацияОсмотра.OperationCode);
						СтрокаОперации = СертификатОбъект.ПереченьОпераций.Найти(ТекущаяОперация,"Операция");
						Если ЗначениеЗаполнено(СтрокаОперации) Тогда
							СтрокаОперации.ТО = ОперацияОсмотра.TO;
							СтрокаОперации.КС = ОперацияОсмотра.P;
						Иначе
							НоваяСтрока = СертификатОбъект.ПереченьОпераций.Добавить();
							НоваяСтрока.Операция = ТекущаяОперация;
							НоваяСтрока.ТО = ОперацияОсмотра.TO;
							НоваяСтрока.КС = ОперацияОсмотра.P;
						КонецЕсли;
						
					КонецЦикла;
					СертификатОбъект.Записать();
					
					СертификатОбновлен = Истина;
					
					Если НеобходимаПечать Тогда
						Если СтруктураСообщения.formNumber = 1 Тогда 
							ТабДок = СертификатОбъект.ПечатьПланшет(СертификатСсылка);
						Иначе 
							ТабДок = СертификатОбъект.Печать(СертификатСсылка);
						КонецЕсли;
						ТабДок.АвтоМасштаб=Истина;
						ИмяФайла=ПолучитьИмяВременногоФайла("pdf");
						ТабДок.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
						Данные=Новый ДвоичныеДанные(ИмяФайла);
						СертификатКПечати = Base64Строка(Данные);
						
					Иначе
						СертификатКПечати = "";
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			ВыдачаОбновлена = Истина;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("status",?(ВыдачаОбновлена,"success","error"));
	СтруктураДанных.Вставить("needPrint",НеобходимаПечать);
	
	Если НеобходимаПечать Тогда
		СтруктураДанных.Вставить("PrintFile",СертификатКПечати);
	КонецЕсли;
	
	
	СтруктураОтвета = ПолучитьСтруктуруСообщения("ExtraditionUpdate", СтруктураСообщения.to, СтруктураСообщения.name);
	СтруктураОтвета.Data = СтруктураДанных;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);

КонецПроцедуры

Процедура ВернутьСертификатКонтроля(СтруктураСообщения)
	
	СтруктураДанных = Новый Структура;
	ТабДок = Новый ТабличныйДокумент;
	
	Если СтруктураСообщения.Свойство("id") Тогда
		
		ВыдачаСсылка = Документы.Renault_CRM_ВыдачаАвтомобиля.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.id));
		
		Если DMS_ОбщегоНазначенияСервер.СсылкаСуществует(ВыдачаСсылка) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_СертификатКонтроля.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_СертификатКонтроля КАК Renault_СертификатКонтроля
			|		ПО Renault_CRM_ВыдачаАвтомобиля.Обращение = Renault_СертификатКонтроля.Обращение
			|ГДЕ
			|	Renault_CRM_ВыдачаАвтомобиля.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка", ВыдачаСсылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Следующий() Тогда
				СертификатКонтроля = Документы.Renault_СертификатКонтроля.СоздатьДокумент();
				ТабДок = СертификатКонтроля.ПечатьПланшет(Выборка.Ссылка);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	
	ТабДок.АвтоМасштаб=Истина;
	ИмяФайла=ПолучитьИмяВременногоФайла("pdf");
	ТабДок.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
	Данные=Новый ДвоичныеДанные(ИмяФайла);
	СертификатКПечати = Base64Строка(Данные);
	
	СтруктураДанных.Вставить("PrintFile",СертификатКПечати);
	
	СтруктураОтвета = ПолучитьСтруктуруСообщения("ExtraditionPrint", СтруктураСообщения.to, СтруктураСообщения.name);
	
	СтруктураОтвета.Data = СтруктураДанных;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);

КонецПроцедуры


Функция ПолучитьВремяВыполненияРаботы(Авторабота, Модель)
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	АвтоработыНормыВремени.ВремяВыполнения
	|ИЗ
	|	Справочник.Автоработы.НормыВремени КАК АвтоработыНормыВремени
	|ГДЕ
	|	АвтоработыНормыВремени.Ссылка = &Авторабота
	|	И АвтоработыНормыВремени.Модель = &Модель";
	
	Запрос.УстановитьПараметр("Авторабота", Авторабота);
	Запрос.УстановитьПараметр("Модель", Модель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВремяВыполнения;
	Иначе
		Возврат Авторабота.ВремяВыполнения;
	КонецЕсли;
	
КонецФункции

Функция РазницаТаблицЗначений(Таблица0, Таблица1, Измерения) Экспорт
    
    Запрос = Новый Запрос(
    
    "ВЫБРАТЬ
    |    0 КАК Знак,
    |    Т.Поле
    |ПОМЕСТИТЬ Т0
    |ИЗ
    |    &Таблица0 КАК Т
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    1 КАК Знак,
    |    Т.Поле
    |ПОМЕСТИТЬ Т1
    |ИЗ
    |    &Таблица1 КАК Т
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Т.Знак,
    |    Т.Поле
    |ПОМЕСТИТЬ Т
    |ИЗ
    |    Т0 КАК Т
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ
    |    Т.Знак,
    |    Т.Поле
    |ИЗ
    |    Т1 КАК Т
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    СУММА(Т.Знак) КАК Знак,
    |    Т.Поле
    |ИЗ
    |    Т КАК Т
    |
    |СГРУППИРОВАТЬ ПО
    |    Т.Поле
    |
    |ИМЕЮЩИЕ
    |    КОЛИЧЕСТВО(*) = 1
    |
    |УПОРЯДОЧИТЬ ПО
    |    Поле//"
    
    );
    
    ВсеКолонки = "";
    
    Для Каждого Колонка Из Таблица1.Колонки Цикл 
        ВсеКолонки = ВсеКолонки + ", Т." + Колонка.Имя;
    КонецЦикла;
    
    Запрос.Текст = СтрЗаменить(Запрос.Текст, "Т.Поле", Сред(ВсеКолонки, 2)); 
    
    Запрос.Текст = СтрЗаменить(Запрос.Текст, "Поле//", Измерения);
    
    Запрос.УстановитьПараметр("Таблица0", Таблица0);
    Запрос.УстановитьПараметр("Таблица1", Таблица1);
    
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

Функция ПолучитьЦену(Номенклатура, ТекущийТипЦен, ОсновнойМеханизм = Ложь)
	
	Если ОсновнойМеханизм Тогда
		Возврат обПолучитьЦену(ТекущийТипЦен, Номенклатура,,,,,,,ПараметрыСеанса.ПодразделениеКомпании);
	КонецЕсли;
	
	//ДилерскийЦентрОтбор = ДилерскийЦентр;
	//
	//Если НЕ ЗначениеЗаполнено(ДилерскийЦентрОтбор) Тогда
	//	ДилерскийЦентрОтбор = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	//КонецЕсли;
	
	УчитыватьПодразделение = Ложь;//ДилерскийЦентрОтбор.Автосервис_УчитыватьПодразделениеВТипеЦен;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних(&ТекущаяДата, ) КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.ТипЦен = &ТипЦен
	|	И ЦеныСрезПоследних.Номенклатура = &Номенклатура
	|	И ВЫБОР
	|			КОГДА &УчитыватьПодразделение
	|				ТОГДА ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпании
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("ТипЦен", ТекущийТипЦен);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("УчитыватьПодразделение", УчитыватьПодразделение);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПараметрыСеанса.ПодразделениеКомпании);	
	Цены = Запрос.Выполнить().Выгрузить();
	
	Если Цены.Количество() > 0 Тогда
		
		Возврат Цены[0].Цена;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
	
КонецФункции

