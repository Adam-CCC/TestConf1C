Процедура ОтменитьЗаписьОнлайн(СтруктураСообщения)
	
	ДокументОнлайнЗаписи = Документы.DMS_ОнлайнЗаписьВАвтосервис.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.data.resuuid));
	
	Если Не ЗначениеЗаполнено(ДокументОнлайнЗаписи.Номер) Тогда 
		// Беседин заявка 1373 логирование в журнал		
		ЗаписьЖурналаРегистрации("ОтменаОнлайнЗаписи", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписНаСервис",
				СтруктураСообщения.data.resuuid, "Не найден документ онлайн записи.");
		
		ВызватьИсключение("Не найден документ онлайн записи.");
	КонецЕсли;
	
	ОбращениеСсылка = Документы.Renault_CRM_ОбращениеВАвтоСервис.ПолучитьОбращениеПоОнлайнЗаписи(ДокументОнлайнЗаписи);
	
	Если Не ЗначениеЗаполнено(ОбращениеСсылка) Тогда 
		
		ЗаписьЖурналаРегистрации("ОтменаОнлайнЗаписи", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписНаСервис",
				ДокументОнлайнЗаписи, "Не найдено обращение по онлайн записи");
	
		ВызватьИсключение("Не найдено обращение по онлайн записи");
	КонецЕсли;
	
	ПриемкаСсылка = Документы.Renault_CRM_ПриемкаАвтомобиля.ПолучитьПриемкуПоОбращению(ОбращениеСсылка);	
	
	Если Не ЗначениеЗаполнено(ПриемкаСсылка) Тогда  
		ЗаписьЖурналаРегистрации("ОтменаОнлайнЗаписи", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписНаСервис",
				ДокументОнлайнЗаписи, "Не найдена приемка автомобиля по обращению.");
		
		ВызватьИсключение("Не найдена приемка автомобиля по обращению.");
	КонецЕсли;
	
	ВыдачаСсылка = Документы.Renault_CRM_ВыдачаАвтомобиля.ПолучитьВыдачуПоОбращению(ОбращениеСсылка);	
	
	Если Не ЗначениеЗаполнено(ВыдачаСсылка) Тогда  
		ЗаписьЖурналаРегистрации("ОтменаОнлайнЗаписи", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписНаСервис",
			ДокументОнлайнЗаписи, "Не найдена выдача автомобиля по обращению."); 
			
		ВызватьИсключение("Не найдена выдача автомобиля по обращению");
	КонецЕсли;
	
	ЗаявкаНаСервисСсылка = Документы.Renault_CRM_ЗаявкаНаСервис.ПолучитьЗаявкуНаСервисПоОбращению(ОбращениеСсылка);	
	
	Если Не ЗначениеЗаполнено(ЗаявкаНаСервисСсылка) Тогда 
		ЗаписьЖурналаРегистрации("ОтменаОнлайнЗаписи", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписНаСервис",
			ДокументОнлайнЗаписи, "Не найдена заявка в автосервис по обращению.");
		
		ВызватьИсключение("Не найдена заявка в автосервис по обращению.");
	КонецЕсли;
	
	Попытка
		НачатьТранзакцию();
		ОбращениеОбъект = ОбращениеСсылка.ПолучитьОбъект();
		ОбращениеОбъект.Заблокировать();
		ОбращениеОбъект.ОтменилЗапись = Истина;
		
		ОбращениеОбъект.Записать();
		
		ОчиститьДатыНачалИКонцаДокумента(ПриемкаСсылка);
		ОчиститьДатыНачалИКонцаДокумента(ВыдачаСсылка);
		ОчиститьДатыНачалИКонцаДокумента(ЗаявкаНаСервисСсылка);
		БлокировкаДанных = Новый БлокировкаДанных;	
		ЭлементБлокировкиПР = БлокировкаДанных.Добавить("РегистрСведений.Renault_АвтосервисПланРабот");	
		ЭлементБлокировкиПО = БлокировкаДанных.Добавить("РегистрСведений.Renault_АвтосервисПланОперативный");	
		ЭлементБлокировкиСР = БлокировкаДанных.Добавить("РегистрСведений.Renault_АвтосервисСтатусыРабот");	
		ЭлементБлокировкиПР.Режим = РежимБлокировкиДанных.Исключительный;	
		ЭлементБлокировкиПО.Режим = РежимБлокировкиДанных.Исключительный;	
		ЭлементБлокировкиСР.Режим = РежимБлокировкиДанных.Исключительный;	
		ЭлементБлокировкиПР.УстановитьЗначение("РабочийДокумент", ПриемкаСсылка);
		ЭлементБлокировкиПР.УстановитьЗначение("РабочийДокумент", ВыдачаСсылка);
		ЭлементБлокировкиПР.УстановитьЗначение("РабочийДокумент", ЗаявкаНаСервисСсылка);
		ЭлементБлокировкиПО.УстановитьЗначение("РабочийДокумент", ПриемкаСсылка);
		ЭлементБлокировкиПО.УстановитьЗначение("РабочийДокумент", ВыдачаСсылка);
		ЭлементБлокировкиПО.УстановитьЗначение("РабочийДокумент", ЗаявкаНаСервисСсылка);
		ЭлементБлокировкиСР.УстановитьЗначение("РабочийДокумент", ПриемкаСсылка);
		ЭлементБлокировкиСР.УстановитьЗначение("РабочийДокумент", ВыдачаСсылка);
		ЭлементБлокировкиСР.УстановитьЗначение("РабочийДокумент", ЗаявкаНаСервисСсылка);
		
		УдалитьЗаписиПланРабот(ПриемкаСсылка,ВыдачаСсылка,ЗаявкаНаСервисСсылка);
		
		УдалитьЗаписиПланОперативный(ПриемкаСсылка,ВыдачаСсылка,ЗаявкаНаСервисСсылка);
		
		УдалитьЗаписиСтатусыРабот(ПриемкаСсылка,ВыдачаСсылка,ЗаявкаНаСервисСсылка);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();                 
		
		ЗаписьЖурналаРегистрации("ОтменаОнлайнЗаписи", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписНаСервис",
			ДокументОнлайнЗаписи, "Не удалось очистить данные по планированию");
		
		ВызватьИсключение(ОписаниеОшибки() + " Не удалось очистить данные по планированию.");
	КонецПопытки;	
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("status","success");
	СтруктураЗаписи.Вставить("resuuid",СтруктураСообщения.data.resuuid);
	
	СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
	СтруктураОтвета.Data = СтруктураЗаписи;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);

	
КонецПроцедуры

