		|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК СсылкаОбращение,
		|	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК СсылкаЗаявка,
		|	Renault_CRM_ОбращениеВАвтоСервис.Клиент КАК Клиент,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль КАК Автомобиль,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.Модель.НаименованиеПолное КАК НаименованиеМодели,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.Модель.Артикул КАК АртикулМодели,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.ВариантКомплектации.Артикул КАК ВариантКомплектации,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.ЦветКод КАК Цвет,
		|	Renault_АвтомобилиДопРеквизиты.Фаза КАК Фаза,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Renault_CRM_ОбращениеВАвтоСервис.Клиент) = ТИП(Справочник.CRM_ПотенциальныеКонтрагенты)
		|			ТОГДА Renault_CRM_ОбращениеВАвтоСервис.Клиент.Фамилия + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Имя + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Отчество
		|		ИНАЧЕ Renault_CRM_ОбращениеВАвтоСервис.Клиент.Фамилия + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Имя + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Отчество
		|	КОНЕЦ КАК ФИО,
		|	Renault_CRM_ОбращениеВАвтоСервис.Автомобиль.Модель.Производитель КАК Марка,
		|	АвтомобилиСрезПоследних.Значение КАК ГосНомер,
		|	Renault_CRM_ОбращениеВАвтоСервис.Автомобиль.VIN КАК VIN,
		|	Renault_CRM_ЗаявкаНаСервис.КомментарииМенеджера КАК КомментарийКЗаявке,
		|	Renault_CRM_ПриемкаАвтомобиля.Состояние КАК Статус,
		|	Renault_CRM_ПриемкаАвтомобиля.ВремяНачала КАК ВремяПриемки,
		|	Renault_CRM_ЗаявкаНаСервис.Дата КАК ДатаЗаявки,
		|	Renault_CRM_ЗаявкаНаСервис.Работы.(
		|		Работа КАК Авторабота,
		|		ВЫБОР
		|			КОГДА Renault_CRM_ЗаявкаНаСервис.ДилерскийЦентр.Планшет_ИспользоватьКодАвторабот
		|				ТОГДА Renault_CRM_ЗаявкаНаСервис.Работы.Работа.Код
		|			ИНАЧЕ Renault_CRM_ЗаявкаНаСервис.Работы.Работа.Артикул
		|		КОНЕЦ КАК АртикулаРаботы,
		|		Длительность КАК ДлительностьРаботы,
		|		Цена КАК ЦенаРаботы,
		|		Сумма КАК Сумма
		|	) КАК Работы,
		|	Renault_CRM_ЗаявкаНаСервис.Товары.(
		|		Номенклатура.Артикул КАК АртикулЗапчасти,
		|		Номенклатура.НаименованиеПолное КАК НаименованиеЗапчасти,
		|		Номенклатура.БазоваяЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|		Количество КАК Количество,
		|		Цена КАК Цена
		|	) КАК Запчасти,
		|	Renault_CRM_ЗаявкаНаСервис.СуммаРаботВсего + Renault_CRM_ЗаявкаНаСервис.СуммаЗапчастиВсего КАК СуммаДокумента,
		|	Renault_CRM_ПриемкаАвтомобиля.Машиноместо КАК МастерПриемщик
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|			ПО Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
		|				И (АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер))
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		|			ПО (Renault_CRM_ПриемкаАвтомобиля.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтомобилиДопРеквизиты КАК Renault_АвтомобилиДопРеквизиты
		|			ПО Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = Renault_АвтомобилиДопРеквизиты.Автомобиль
		|		ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаСервис.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Документы.Renault_CRM_ЗаявкаНаСервис.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.guid)));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтруктураДанных = Новый Структура("FullName,Brand,Model,ModelCode,VersionCode,ColorCode,
									|StateNumber,VIN,CommentToApplication,
									|Status,TimeOfReceipt,Applicaton,AutoWorks,Parts,
									|Total,Discount,NumberOfBonuses,
									|Recommendation,History,Master,guid,Version,
									|TopRecommendedWorks,TopRecommendedParts,Mileage");
	СтруктураДанных.Вставить("AutoWorks",Новый Массив);
	СтруктураДанных.Вставить("Parts",Новый Массив);

	Если Выборка.Следующий() Тогда
		
		СтруктураДанных.Вставить("guid",Строка(Выборка.СсылкаЗаявка.УникальныйИдентификатор()));
		СтруктураДанных.Вставить("FullName",Строка(Выборка.ФИО));
		СтруктураДанных.Вставить("Email",Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Выборка.Клиент));
		СтруктураДанных.Вставить("Brand",Строка(Выборка.Марка));
		
		СтруктураДанных.Вставить("StateNumber",Строка(Выборка.ГосНомер));
		СтруктураДанных.Вставить("VIN",Строка(Выборка.VIN));
		СтруктураДанных.Вставить("CommentToApplication",Строка(Выборка.КомментарийКЗаявке));
		СтруктураДанных.Вставить("Status",Строка(Выборка.Статус));
		СтруктураДанных.Вставить("Mileage",Строка(Renault_АвтосервисОбщий.Renault_ПолучитьПробег(Выборка.Автомобиль)));

		//СтруктураДанных.Вставить("TimeOfReceipt",Строка(Формат(Выборка.ВремяПриемки,"ДФ=HH:mm")));
		Если ЗначениеЗаполнено(Выборка.ВремяПриемки) Тогда
			СтруктураДанных.Вставить("TimeOfReceipt",Строка(Формат(Выборка.ВремяПриемки,"ДФ=HH:mm")));
		Иначе
			СтруктураДанных.Вставить("TimeOfReceipt",Строка(Формат(Выборка.СсылкаЗаявка.ВремяНачала,"ДФ=HH:mm")));
		КонецЕсли;
		СтруктураДанных.Вставить("Applicaton",Строка(Формат(Выборка.ДатаЗаявки,"ДФ=dd.MM.yyyy")));
		СтруктураДанных.Вставить("Master",Строка(Выборка.МастерПриемщик));
		СтруктураДанных.Вставить("Version",ЗаписатьДатуJSON(ТекущаяДата(),ФорматДатыJSON.ISO));
		СтруктураДанных.Вставить("Model",Строка(Выборка.НаименованиеМодели));		
		
		Если ЗначениеЗаполнено(Выборка.Фаза) Тогда
			СтруктураДанных.Вставить("ModelCode",Выборка.АртикулМодели + " " + Выборка.Фаза.Фаза);
		Иначе
			СтруктураДанных.Вставить("ModelCode",Выборка.АртикулМодели + " 1");
		КонецЕсли;
		

		Если ЗначениеЗаполнено(Выборка.ВариантКомплектации) Тогда
			СтруктураДанных.Вставить("VersionCode",Строка(Выборка.ВариантКомплектации));		
		Иначе
			СтруктураДанных.Вставить("VersionCode","EmptyVersion");		
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Цвет) Тогда
			СтруктураДанных.Вставить("ColorCode",Строка(Выборка.Цвет));		
		Иначе
			СтруктураДанных.Вставить("ColorCode","EmptyColor");		
		КонецЕсли;

		ДанныеПоСкидкамИБаллам = Renault_АвтосервисСкидки.ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту(Выборка.Клиент);
		СтруктураДанных.Вставить("NumberOfBonuses",ДанныеПоСкидкамИБаллам.ОстатокБаллов);
		СтруктураДанных.Вставить("Discount",ДанныеПоСкидкамИБаллам.СкидкаЗапчасти);
		СтруктураДанных.Вставить("Recommendation",ПолучитьРекомендациюПоАвтомобилю(Выборка.Автомобиль));
		
		СтруктураДанных.Вставить("History",ПолучитьИсториюПоАвтомобилю(Выборка.Автомобиль));

		СтруктураДанных.Вставить("TopRecommendedWorks",ПолучитьТоп30Работ(Выборка.Автомобиль, Выборка.СсылкаЗаявка.ДилерскийЦентр));
		СтруктураДанных.Вставить("TopRecommendedParts",ПолучитьТоп30Запчастей(Выборка.Автомобиль, Выборка.СсылкаЗаявка.ДилерскийЦентр.Автосервис_ТипЦенПродажи));
		
		СтруктураДанных.Вставить("Total",Выборка.СуммаДокумента);
		
		ВыборкаРаботы = Выборка.Работы.Выбрать();
		МассивРабот = Новый Массив;
		Пока ВыборкаРаботы.Следующий() Цикл
			СтруктураРаботы = Новый Структура;
			СтруктураРаботы.Вставить("AutoWork",Строка(ВыборкаРаботы.Авторабота));
			СтруктураРаботы.Вставить("AutoWorkCode",СокрЛП(ВыборкаРаботы.АртикулаРаботы));
			СтруктураРаботы.Вставить("WorkDuration",Строка(ВыборкаРаботы.ДлительностьРаботы));
			СтруктураРаботы.Вставить("Price",ВыборкаРаботы.Сумма);
			МассивРабот.Добавить(СтруктураРаботы);
		КонецЦикла;
		МассивСуществующихРабот = СтруктураДанных.AutoWorks;
		Renault_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСуществующихРабот,МассивРабот);
		СтруктураДанных.Вставить("AutoWorks",МассивСуществующихРабот);
		
		ВыборкаЗапчасти = Выборка.Запчасти.Выбрать();
		МассивЗапчасти = Новый Массив;
		Пока ВыборкаЗапчасти.Следующий() Цикл
			СтруктураЗапчасти = Новый Структура;
			СтруктураЗапчасти.Вставить("Part",Строка(ВыборкаЗапчасти.НаименованиеЗапчасти));
			СтруктураЗапчасти.Вставить("PartCode",СокрЛП(ВыборкаЗапчасти.АртикулЗапчасти));
			СтруктураЗапчасти.Вставить("PartMeasure",СокрЛП(Строка(ВыборкаЗапчасти.ЕдиницаИзмерения)));
			СтруктураЗапчасти.Вставить("Quantity",ВыборкаЗапчасти.Количество);
			СтруктураЗапчасти.Вставить("Price",ВыборкаЗапчасти.Цена);
			МассивЗапчасти.Добавить(СтруктураЗапчасти);
		КонецЦикла;
		МассивСуществующихЗапчастей = СтруктураДанных.Parts;
		Renault_ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСуществующихЗапчастей,МассивЗапчасти);
		СтруктураДанных.Вставить("Parts",МассивСуществующихЗапчастей);
		
	КонецЕсли;
	
	СтруктураОтвета = ПолучитьСтруктуруСообщения("Order", СтруктураСообщения.to, СтруктураСообщения.name);
	СтруктураОтвета.Data = СтруктураДанных;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);

КонецПроцедуры

Процедура ВернутьВыдачу(СтруктураСообщения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
