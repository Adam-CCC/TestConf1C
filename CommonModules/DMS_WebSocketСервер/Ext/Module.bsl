Процедура ДобавитьТокенПланшетаВБазу(СтруктураСообщения)

	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	Если Настройки.ПланшетыПриемщиков.Найти(СтруктураСообщения.token) = Неопределено Тогда
		
		НастройкиОбъект = Настройки.ПолучитьОбъект();
		
		НастройкиОбъект.ПланшетыПриемщиков.Добавить().RightToken = СтруктураСообщения.token;
		
		Попытка	
			НастройкиОбъект.Записать();	
		Исключение
			ЗаписьЖурналаРегистрации("ОбменЧерезWebSocket", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВернутьСписокЗаявок(СтруктураСообщения)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК СсылкаОбращение,
		|	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК СсылкаЗаявка,
		|	Renault_CRM_ОбращениеВАвтоСервис.Клиент КАК Клиент,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль КАК Автомобиль,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.Модель.НаименованиеПолное КАК НаименованиеМодели,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.Модель.Артикул КАК АртикулМодели,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.ВариантКомплектации.Артикул КАК ВариантКомплектации,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль.ЦветКод КАК Цвет,
		|	Renault_АвтомобилиДопРеквизиты.Фаза КАК Фаза,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(Renault_CRM_ОбращениеВАвтоСервис.Клиент) = ТИП(Справочник.CRM_ПотенциальныеКонтрагенты)
		|			ТОГДА Renault_CRM_ОбращениеВАвтоСервис.Клиент.Фамилия + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Имя + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Отчество
		|		ИНАЧЕ Renault_CRM_ОбращениеВАвтоСервис.Клиент.Фамилия + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Имя + "" "" + Renault_CRM_ОбращениеВАвтоСервис.Клиент.Отчество
		|	КОНЕЦ КАК ФИО,
		|	Renault_CRM_ОбращениеВАвтоСервис.Автомобиль.Модель.Производитель КАК Марка,
		|	АвтомобилиСрезПоследних.Значение КАК ГосНомер,
		|	Renault_CRM_ОбращениеВАвтоСервис.Автомобиль.VIN КАК VIN,
		|	Renault_CRM_ЗаявкаНаСервис.КомментарииМенеджера КАК КомментарийКЗаявке,
		|	Renault_CRM_ПриемкаАвтомобиля.Состояние КАК Статус,
		|	Renault_CRM_ПриемкаАвтомобиля.ВремяНачала КАК ВремяПриемки,
		|	Renault_CRM_ЗаявкаНаСервис.Дата КАК ДатаЗаявки,
		|	Renault_CRM_ПриемкаАвтомобиля.Машиноместо КАК МастерПриемщик
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|			ПО Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = АвтомобилиСрезПоследних.Автомобиль
		|				И (АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер))
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		|			ПО (Renault_CRM_ПриемкаАвтомобиля.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтомобилиДопРеквизиты КАК Renault_АвтомобилиДопРеквизиты
		|			ПО Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = Renault_АвтомобилиДопРеквизиты.Автомобиль
		|		ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка
		|ГДЕ
		|	НЕ Renault_CRM_ЗаявкаНаСервис.ПометкаУдаления
		|	И НЕ Renault_CRM_ПриемкаАвтомобиля.Ссылка ЕСТЬ NULL
		|	И Renault_CRM_ПриемкаАвтомобиля.ВремяНачала МЕЖДУ &Дата1 И &Дата2
		|	И Renault_CRM_ПриемкаАвтомобиля.Машиноместо = &МастерПриемщик
		|   И Renault_CRM_ЗаявкаНаСервис.ДилерскийЦентр.Бир_ЛМТ = &Бир_ЛМТ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВремяПриемки";
	
	Запрос.УстановитьПараметр("Дата1", ПрочитатьДатуJSON(СтруктураСообщения.dateStart, ФорматДатыJSON.ISO));
	Запрос.УстановитьПараметр("Дата2", ПрочитатьДатуJSON(СтруктураСообщения.dateFinish, ФорматДатыJSON.ISO));
	Запрос.УстановитьПараметр("Бир_ЛМТ", СтруктураСообщения.to);
	Если СтруктураСообщения.Свойство("login") Тогда
		Запрос.УстановитьПараметр("МастерПриемщик",  ПолучитьМастераПоЛогину(СтруктураСообщения.login));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И Renault_CRM_ПриемкаАвтомобиля.Машиноместо = &МастерПриемщик","");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураДанных = Новый Структура();
	
	ТекущееОбращение = Документы.Renault_CRM_ОбращениеВАвтоСервис.ПустаяСсылка();
	
	МассивЗаписей = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		Если ТекущееОбращение = Выборка.СсылкаОбращение Тогда
			Продолжить;
		Иначе
			ТекущееОбращение = Выборка.СсылкаОбращение;
		КонецЕсли;
		
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("guid",Строка(Выборка.СсылкаЗаявка.УникальныйИдентификатор()));
		СтруктураЗаписи.Вставить("FullName",Строка(Выборка.ФИО));
		СтруктураЗаписи.Вставить("Model",Строка(Выборка.НаименованиеМодели));		
		Если ЗначениеЗаполнено(Выборка.Фаза) Тогда
			СтруктураЗаписи.Вставить("ModelCode",СтрШаблон("%1 %2", Выборка.АртикулМодели, Выборка.Фаза.Фаза));
		Иначе
			СтруктураЗаписи.Вставить("ModelCode",СтрШаблон("%1 1", Выборка.АртикулМодели));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ВариантКомплектации) Тогда
			СтруктураЗаписи.Вставить("VersionCode",Строка(Выборка.ВариантКомплектации));		
		Иначе
			СтруктураЗаписи.Вставить("VersionCode","EmptyVersion");		
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Цвет) Тогда
			СтруктураЗаписи.Вставить("ColorCode",Строка(Выборка.Цвет));		
		Иначе
			СтруктураЗаписи.Вставить("ColorCode","EmptyColor");		
		КонецЕсли;
		
		СтруктураЗаписи.Вставить("StateNumber",Строка(Выборка.ГосНомер));
		СтруктураЗаписи.Вставить("VIN",Строка(Выборка.VIN));
		СтруктураЗаписи.Вставить("CommentToApplication",Строка(Выборка.КомментарийКЗаявке));
		СтруктураЗаписи.Вставить("Status",Строка(Выборка.Статус));
		Если ЗначениеЗаполнено(Выборка.ВремяПриемки) Тогда
			СтруктураЗаписи.Вставить("TimeOfReceipt",ЗаписатьДатуJSON(Выборка.ВремяПриемки,ФорматДатыJSON.ISO));
		Иначе
			СтруктураЗаписи.Вставить("TimeOfReceipt",ЗаписатьДатуJSON(Выборка.СсылкаЗаявка.ВремяНачала,ФорматДатыJSON.ISO));
		КонецЕсли;
		СтруктураЗаписи.Вставить("Master",Строка(Выборка.МастерПриемщик));

		МассивЗаписей.Добавить(СтруктураЗаписи);
	КонецЦикла;
	
	СтруктураДанных.Вставить("list",МассивЗаписей);
			
	СтруктураОтвета = ПолучитьСтруктуруСообщения("ReturnOrderList", СтруктураСообщения.to, СтруктураСообщения.name);
	СтруктураОтвета.Data = СтруктураДанных;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);
	
КонецПроцедуры

