#Область ФоновоеИлиРегламентноеЗадание

Процедура ПроверитьИЗапуститьОбменWebSocket(Параметры = Неопределено) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	МассивФЗ = Новый Массив;
	Если ЕстьАктивныеФоновыеЗадания(МассивФЗ) Тогда
		Для каждого ФоновоеЗадание Из МассивФЗ Цикл
			ФоновоеЗадание.Отменить();
		КонецЦикла; 
	КонецЕсли; 
	
	СтруктураОтбора = Новый Структура;
	СтруктураПараметров = Новый Структура;
	МассивДляЗапускаФоновогоЗадания = Новый Массив;
	//Пройдем по каждому элементу справочника и будем запускать ФЗ
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_ДилерскиеЦентры.Ссылка КАК Ссылка,
	|	CRM_ДилерскиеЦентры.Бир_ЛМТ КАК Бир_ЛМТ
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	|ГДЕ
	|	CRM_ДилерскиеЦентры.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Индекс = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураОтбора.Очистить();
		ГУИД = "" + ВыборкаДетальныеЗаписи.Ссылка.УникальныйИдентификатор();
		//СтруктураОтбора.Вставить("Ключ",ГУИД);
		//СтруктураОтбора.Вставить("Состояние",СостояниеФоновогоЗадания.Активно);
		//МассивФЗ = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураОтбора);
		//Если МассивФЗ.Количество()>0 Тогда 
		//	Продолжить;
		//КонецЕсли;
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Ключ", ГУИД);
		СтруктураПараметров.Вставить("BIR", ВыборкаДетальныеЗаписи.Бир_ЛМТ);
		СтруктураПараметров.Вставить("Индекс", Индекс);
		МассивДляЗапускаФоновогоЗадания.Добавить(СтруктураПараметров);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Если МассивДляЗапускаФоновогоЗадания.Количество()>0 Тогда 
		ЗапуститьФоновыеЗадания(МассивДляЗапускаФоновогоЗадания);
	КонецЕсли;
	
	//РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	//ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ОбменЧерезWebSocket"),
	//ТекущаяДатаСеанса());
	
КонецПроцедуры

Процедура ЗапуститьФоновыеЗадания(Массив)
	
	МассивПараметров = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		МассивПараметров.Очистить();
		МассивПараметров.Добавить(Элемент);
		ФоновыеЗадания.Выполнить("DMS_WebSocketСервер.ЗапуститьРаботуВФоне",МассивПараметров,,"Обмен через WebSocket сервер");	
	КонецЦикла;
	
КонецПроцедуры


// эта штука может запускаться фоновым или регламентным заданием, поэтому ОбъектВебСокет инициализируем прямо в ней
Процедура ЗапуститьРаботуВФоне(Параметры) Экспорт
	
	Перем ОбъектВебСокет, СтруктураСообщения, МассивФЗ;
	
	УстановитьПривилегированныйРежим(Истина);
	// 1. инициализируем соединение
	ПсевдонимНаСервере = Параметры.BIR;
	АдресСервера = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].АдресWebSocket;
	ПутьККомпоненте = "Обработка.DMS_WebSocket_Клиент.Макет.websocket_Win_64_dll";
	
	Если НЕ вс_ИнициироватьСоединение(ОбъектВебСокет, ПсевдонимНаСервере, АдресСервера, ПутьККомпоненте) Тогда
		Возврат;
	КонецЕсли;
	
	// 2. в цикле будем принимать данные, каждую секунду отправлять наши данные
	СчетчикОтправленныхСообщений = 0;
	СчетчикПринятыхСообщений = 0;
	
	Таймаут = 10000;	// миллисекунды, сек*1000
	ДанныеJSON = "";
	Пока Истина Цикл 
	//Пока ОбъектВебСокет.Принять(0, ДанныеJSON) Цикл
		Если вс_ПринятьДанные(ОбъектВебСокет, СтруктураСообщения, Таймаут, Истина) Тогда
			//СтруктураСообщения = ПрочитатьСтрокуJSON(ДанныеJSON);
			//ЗаписатьСообщениеВРегистрСообщенийНаСервере(СтруктураСообщения, Истина);
			ОбработатьВходящееСообщение(СтруктураСообщения);
			СчетчикПринятыхСообщений = СчетчикПринятыхСообщений + 1;
		КонецЕсли;
		СоединениеАктуально = ОтправитьСообщенияИзОчереди(ОбъектВебСокет, СчетчикОтправленныхСообщений,ПсевдонимНаСервере);
		Если не СоединениеАктуально Тогда
			ОбъектВебСокет = Неопределено;
			Если НЕ вс_ИнициироватьСоединение(ОбъектВебСокет, ПсевдонимНаСервере, АдресСервера, ПутьККомпоненте) Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Индекс = Параметры.Индекс;
	Если Индекс = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_WebSocket_Сообщения.ИД КАК ИД,
		|	DMS_WebSocket_Сообщения.ДатаСообщения КАК ДатаСообщения,
		|	DMS_WebSocket_Сообщения.name КАК name,
		|	DMS_WebSocket_Сообщения.to КАК to
		|ИЗ
		|	РегистрСведений.DMS_WebSocket_Сообщения КАК DMS_WebSocket_Сообщения
		|ГДЕ
		|	DMS_WebSocket_Сообщения.ДатаСообщения < &ДатаСообщения
		|УПОРЯДОЧИТЬ ПО DMS_WebSocket_Сообщения.ДатаСообщения";
		Запрос.УстановитьПараметр("ДатаСообщения", ТекущаяДата() - 86400*14);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Набор = РегистрыСведений.DMS_WebSocket_Сообщения.СоздатьНаборЗаписей();
			Набор.Отбор.ИД.Установить(Выборка.ИД);
			Набор.Отбор.ДатаСообщения.Установить(Выборка.ДатаСообщения);
			Набор.Отбор.name.Установить(Выборка.name);
			Набор.Отбор.to.Установить(Выборка.to);
			
			Попытка
				Набор.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("ОтправкаСообщенийСокет", УровеньЖурналаРегистрации.Ошибка,,
					"РегистрСведений.DMS_WebSocket_Сообщения", "Невозможно стереть старые сообщения");
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

//В этой процедуре должна происходить обработка полученных сообщений
Процедура ОбработатьВходящееСообщение(Знач СтруктураСообщения) Экспорт 
	
	СтруктураПереданныхПараметров = Новый Структура;
	
	ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.НайтиПоРеквизиту("Бир_ЛМТ", СтруктураСообщения.to);
	
	//Если Не ЗначениеЗаполнено(ДилерскийЦентр) Тогда 
	//	//ОтдатьОшибку();
	//	Возврат;
	//КонецЕсли;
	
	СтруктураПереданныхПараметров.Вставить("Дилер",ДилерскийЦентр);
	
	
		Если СтруктураСообщения.type = "ПолучитьГрафикЗанятостиДилерскогоЦентраНаДату" Тогда
			
		ИначеЕсли НРег(СтруктураСообщения.type) = "getavailableslots" Тогда
			Попытка
				СтруктураСообщения.type = "AvailableSlots";
				ПредоставитьДоступныеСлотыДляЗаписи(СтруктураСообщения,СтруктураПереданныхПараметров);
			Исключение
				СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
				СтруктураОтвета.error.code = "E201";
				СтруктураОтвета.error.description = "Не удалось получить слоты для записи. "+ОписаниеОшибки();
				ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);	
			КонецПопытки;
			
		ИначеЕсли НРег(СтруктураСообщения.type) = "reserveslot" Тогда
			Попытка
				СтруктураСообщения.type = "Slot";
				СоздатьДокументОнлайнЗаписи(СтруктураСообщения,СтруктураПереданныхПараметров);
			Исключение
				СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
				СтруктураОтвета.error.code = "E202";
				СтруктураОтвета.error.description = "Не удалось получить план работ "+ОписаниеОшибки();
				ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);	
			КонецПопытки;
		ИначеЕсли НРег(СтруктураСообщения.type) = "approveslot" Тогда
			Попытка
				СтруктураСообщения.type = "ReserveSlotConfirmation";				
				ПодтвердитьЗаписьОнлайн(СтруктураСообщения);
			Исключение
				СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
				СтруктураОтвета.error.code = "E203";
				СтруктураОтвета.error.description = "Не удалось подтвердить запись. "+ОписаниеОшибки();
				ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);	
			КонецПопытки;
		ИначеЕсли НРег(СтруктураСообщения.type) = "error" Тогда
			//ничего не делаем, но обработать надо
		ИначеЕсли НРег(СтруктураСообщения.type) = "deletereservedslot" Тогда
			Попытка
				СтруктураСообщения.type = "ApproveDeleteReservedSlot";
				ОтменитьЗаписьОнлайн(СтруктураСообщения);
			Исключение
				СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
				СтруктураОтвета.error.code = "E204";
				СтруктураОтвета.error.description = "Не удалось отменить запись. "+ОписаниеОшибки();
				ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);	
			КонецПопытки;		
		//Сергеев В.Н. SI +++	
		ИначеЕсли НРег(СтруктураСообщения.type) = "getuser" Тогда
			ОтправитьСообщениеОДоступностиПользователя(СтруктураСообщения,ПроверитьДоступностьПользователя(СтруктураСообщения));
		ИначеЕсли НРег(СтруктураСообщения.type) = "righttoken" Тогда
			ДобавитьТокенПланшетаВБазу(СтруктураСообщения);
		ИначеЕсли НРег(СтруктураСообщения.type) = "orderlist" Тогда
			ВернутьСписокЗаявок(СтруктураСообщения);
		ИначеЕсли НРег(СтруктураСообщения.type) = "getorder" Тогда	
			ВернутьЗаявку(СтруктураСообщения);
		ИначеЕсли НРег(СтруктураСообщения.type) = "returnorder" Тогда	
			ОбработатьЗаявкуСПланшета(СтруктураСообщения);
		ИначеЕсли НРег(СтруктураСообщения.type) = "extraditionlist" Тогда
			ВернутьСписокВыдач(СтруктураСообщения);	
		ИначеЕсли НРег(СтруктураСообщения.type) = "getextradition" Тогда	
			ВернутьВыдачу(СтруктураСообщения)	
		ИначеЕсли НРег(СтруктураСообщения.type) = "returnextradition" Тогда	
			ОбработатьВыдачуСПланшета(СтруктураСообщения)
		ИначеЕсли НРег(СтруктураСообщения.type) = "getextraditionprint" Тогда	
			ВернутьСертификатКонтроля(СтруктураСообщения)	
		//Сергеев В.Н. SI ---	
		Иначе
				СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
				СтруктураОтвета.error.code = "E299";
				СтруктураОтвета.error.description = "Передан некорректный метод";
				ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);	
		КонецЕсли;
	
	
	
	
КонецПроцедуры

Процедура ЗаписатьОповещение(id) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь КАК Пользователь
	|ИЗ
	|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПраваИНастройкиПользователей КАК Renault_ПраваИНастройкиПользователей
	|		ПО Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки = Renault_ПраваИНастройкиПользователей.Ссылка
	|ГДЕ
	|	Renault_ПраваИНастройкиПользователей.УведомленияОбОнлайнЗаписи = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяЗапись = РегистрыСведений.ЗадачиПланировщика.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = ТекущаяДата();
		НоваяЗапись.ДатаИВремяОднократногоЗапуска = ТекущаяДата();
		НоваяЗапись.ВидЗадачи = Перечисления.ВидЗадачПланировщика.ЗапускПроцедуры;
		НоваяЗапись.УдалятьЗадачуПослеЗапуска =Истина;
		НоваяЗапись.ДействиеПриОшибке =   Перечисления.ВидыДействийПриОшибкеВыполненияЗадачи.ПовторятьПопытку;
		НоваяЗапись.Объект = "CRM_Клиент.ПоказатьЗаявкуНаСервисЧерезОповещение("""+id+""")"; 
		НоваяЗапись.Пользователь = ВыборкаДетальныеЗаписи.Пользователь;
		Попытка
			НоваяЗапись.Записать(Истина);
		Исключение
			ЗаписьЖурналаРегистрации("Данные.Запись", 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.ЗадачиПланировщика,
			НоваяЗапись,
			"Не удалось запланировать оповещение об онлайн записи");
		КонецПопытки;
		
	КонецЦикла;
	
	
	
КонецПроцедуры

Функция ПолучитьГрафикЗагруженности(Параметры)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТолькоРаботающие",Ложь);
	//Параметры.Date = ПрочитатьДатуJSON(Параметры.date, ФорматДатыJSON.ISO);
	ОбработкаОбъект = Обработки.CRM_АРМ_АвтоСервис_4.Создать();
	ОбработкаОбъект.ДилерскийЦентр = Параметры.Дилер;
	СвободныеИнтервалы = ОбработкаОбъект.ПолучитьТаблицуСвободныхИнтервалов(НачалоДня(ТекущаяДата()), "Сотрудники", ДополнительныеПараметры);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СвободныеИнтервалы.ВремяНачала КАК ДатаНачала,
	|	СвободныеИнтервалы.ВремяНачалаИнтервала КАК ДатаНачалаИнтервала,
	|	СвободныеИнтервалы.ВремяОкончания КАК ДатаОкончания,
	|	СвободныеИнтервалы.Дата КАК Дата,
	|	СвободныеИнтервалы.ДлинаИнтервала КАК ДлинаИнтервала,
	|	СвободныеИнтервалы.Длительность КАК Длительность,
	|	СвободныеИнтервалы.Цех КАК Цех
	|ПОМЕСТИТЬ ВТСвободныеИнтервалы
	|ИЗ
	|	&СвободныеИнтервалы КАК СвободныеИнтервалы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДОБАВИТЬКДАТЕ(&ТекущаяДата, ЧАС, 3) > ВТСвободныеИнтервалы.ДатаНачала
	|			ТОГДА ДОБАВИТЬКДАТЕ(&ТекущаяДата, ЧАС, 3)
	|		ИНАЧЕ ВТСвободныеИнтервалы.ДатаНачала
	|	КОНЕЦ КАК ДатаНачала,
	|	ВТСвободныеИнтервалы.ДатаНачалаИнтервала КАК ДатаНачалаИнтервала,
	|	ВТСвободныеИнтервалы.ДатаОкончания КАК ДатаОкончания,
	|	ВТСвободныеИнтервалы.Дата КАК Дата,
	|	ВТСвободныеИнтервалы.ДлинаИнтервала КАК ДлинаИнтервала,
	|	ВТСвободныеИнтервалы.Длительность КАК Длительность,
	|	ВТСвободныеИнтервалы.Цех КАК Цех
	|ИЗ
	|	ВТСвободныеИнтервалы КАК ВТСвободныеИнтервалы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала,
	|	ДатаОкончания,
	|	Цех";

	Запрос.УстановитьПараметр("СвободныеИнтервалы",СвободныеИнтервалы);
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата()); 
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("starttime");
	ТЗ.Колонки.Добавить("endtime");
	ТЗ.Колонки.Добавить("tsuuid"); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		//Разобьем интервалы по времени приемки авто, лучше сделать в запросе,но... не получилось
				
		МассивОтвета = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ВремяОкончания = Выборка.ДатаОкончания - Параметры.Дилер.ДлительностьПриемки*60;
			Если Выборка.ДатаНачала>=ВремяОкончания Тогда 
				Продолжить;
			КонецЕсли;
			НовоеВремяНачала = Выборка.ДатаНачала;
			НовоеВремяНачала = ?(Секунда(НовоеВремяНачала) = 0 , НовоеВремяНачала,НовоеВремяНачала + 60 - Секунда(НовоеВремяНачала));//округляем до целых минут
			
			Если Минута(НовоеВремяНачала) % 5 <> 0 Тогда 
				НовоеВремяНачала = НачалоДня(НовоеВремяНачала) + Час(НовоеВремяНачала) * 3600 + (Цел(Минута(НовоеВремяНачала)/5)+1)*5*60;
			КонецЕсли;
			
			Пока НовоеВремяНачала<=ВремяОкончания Цикл 
				НовоеВремяОкончания = НовоеВремяНачала + Параметры.Дилер.ДлительностьПриемки*60;//минус 1 секунда
				НоваяСтрока = ТЗ.Добавить();
				НоваяСтрока.starttime = НовоеВремяНачала;
				НоваяСтрока.endtime = НовоеВремяОкончания;
				НоваяСтрока.tsuuid =  ""+Выборка.Цех.УникальныйИдентификатор();
				НовоеВремяНачала = НовоеВремяОкончания;
			КонецЦикла;
		КонецЦикла;
		
		ТЗ.Сортировать("starttime ВОЗР");
		Для Каждого Элем из ТЗ Цикл 	
			Структура = Новый Структура;
			Структура.Вставить("starttime",ЗаписатьДатуJSON(Элем.starttime,ФорматДатыJSON.ISO));
			Структура.Вставить("endtime",ЗаписатьДатуJSON(Элем.endtime,ФорматДатыJSON.ISO));
			Структура.Вставить("tsuuid",Элем.tsuuid);
			МассивОтвета.Добавить(Структура);
		КонецЦикла;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;                                                                     
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON,МассивОтвета,Новый НастройкиСериализацииJSON);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	Возврат МассивОтвета;
КонецФункции

Процедура ПредоставитьДоступныеСлотыДляЗаписи(СтруктураСообщения,СтруктураПараметров)
	
	МассивОтвета = ПолучитьГрафикЗагруженности(СтруктураПараметров);
	СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
