Процедура ЗаполнитьПоврежденияКузова(Заявка, МассивПовреждений)

	Для Каждого ЭлементВерхнегоУровня Из МассивПовреждений Цикл
		Для Каждого ЭлементСреднегоУровня Из ЭлементВерхнегоУровня.sections Цикл
			//СтруктураСообщения.exteriorPoints.left[0].sections[0]
			СтруктураЗаписи = Новый Структура;
			СтруктураЗаписи.Вставить("Автомобиль",	Заявка.Автомобиль);
			СтруктураЗаписи.Вставить("Обращение",	Заявка.Обращение);			
			СтруктураЗаписи.Вставить("Приемка", 	Документы.Renault_CRM_ПриемкаАвтомобиля.ПолучитьПриемкуПоОбращению(Заявка.Обращение));
			СтруктураЗаписи.Вставить("Период",		Заявка.Дата);
			
			Если Не ЭлементСреднегоУровня.Свойство("code") Тогда
				Прервать;
			КонецЕсли;
			
			ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.НайтиПоКоду(ЭлементСреднегоУровня.code);
			СтруктураЗаписи.Вставить("ЗонаПовреждения",Справочники.Renault_ЗоныПоврежденийАвто.НайтиПоКоду(ЭлементСреднегоУровня.code));
			Если ЭлементСреднегоУровня.totalDamage Тогда
				Повреждение = Справочники.Renault_Автосервис_Повреждения.ТребуетсяЗамена;
				СтруктураЗаписи.Вставить("Повреждение",Справочники.Renault_Автосервис_Повреждения.ТребуетсяЗамена);
				// Беседин 22.02.22 заявка 1089
				СтруктураЗаписи.Вставить("ПриемкаИзПланшета", Истина);
				Запись = РегистрыСведений.Renault_ПоврежденияКузова.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись,СтруктураЗаписи);
				Запись.Записать();
			Иначе
				Для Каждого ЭлементНижнегоУровня Из ЭлементСреднегоУровня.data Цикл	
					СтруктураЗаписи.Вставить("Повреждение", Справочники.Renault_Автосервис_Повреждения.НайтиПоКоду(ЭлементНижнегоУровня.code));
					
					Запись = РегистрыСведений.Renault_ПоврежденияКузова.СоздатьМенеджерЗаписи();

					Если СтруктураЗаписи.Повреждение = Справочники.Renault_Автосервис_Повреждения.ПоказаниеОдометра Тогда
						Попытка
							Если ЗначениеЗаполнено(ЭлементНижнегоУровня.data) тогда
								ТекПробег = Число(ЭлементНижнегоУровня.data);
								Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтруктураЗаписи.Автомобиль, ТекПробег, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
								СтруктураЗаписи.Вставить("Значение",ТекПробег);  
								// Беседин 22.02.22 заявка 1089
								СтруктураЗаписи.Вставить("ПриемкаИзПланшета", Истина);
							КонецЕсли;
						Исключение
							
						КонецПопытки;
					ИначеЕсли СтруктураЗаписи.Повреждение = Справочники.Renault_Автосервис_Повреждения.УровеньТоплива Тогда
						Попытка
							ТекПроцент = Число(ЭлементНижнегоУровня.data)/100;
							СтруктураЗаписи.Вставить("Значение",ТекПроцент);  
							// Беседин 22.02.22 заявка 1089
							СтруктураЗаписи.Вставить("ПриемкаИзПланшета", Истина);
						Исключение	
						КонецПопытки;
					Иначе
						Если Не ЭлементНижнегоУровня.type = "checkBox" Тогда
							СтруктураЗаписи.Вставить("Комментарий", ЭлементНижнегоУровня.data);
						КонецЕсли;
					КонецЕсли;
					
					Если ЭлементНижнегоУровня.type = "checkBox" И Не ЭлементНижнегоУровня.data Тогда
						Продолжить;
					КонецЕсли;
					
					СтруктураЗаписи.Вставить("СтепеньПовреждения", Справочники.Renault_Автосервис_СтепениПовреждения.НайтиПоНаименованию(ЭлементНижнегоУровня.tuning.intensivity));
					// Беседин 22.02.22 заявка 1089
					СтруктураЗаписи.Вставить("ПриемкаИзПланшета", Истина);  
					ЗаполнитьЗначенияСвойств(Запись,СтруктураЗаписи);    
					
					Запись.Записать();
					Если ЭлементНижнегоУровня.tuning.Свойство("images") Тогда
						Для Каждого Картинка64 Из ЭлементНижнегоУровня.tuning.images Цикл
							МенеджерЗаписи = РегистрыСведений.Renault_КартинкиИФайлы.СоздатьМенеджерЗаписи();
							МенеджерЗаписи.Объект = СтруктураЗаписи.Приемка;
							//МенеджерЗаписи.Данные = Новый ХранилищеЗначения(Новый Картинка(Base64Значение(Картинка64)));
							МенеджерЗаписи.Данные = Новый ХранилищеЗначения(Base64Значение(Картинка64));
							МенеджерЗаписи.Идентификатор = ОпределитьИндексКартинкиВыбраннойЗоны(ЗонаПовреждения);
							МенеджерЗаписи.Картинка = Истина;
							МенеджерЗаписи.ДатаСохранения = ТекущаяДатаСеанса();
							МенеджерЗаписи.Записать();
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;	

КонецПроцедуры

Функция ПолучитьИсториюПоАвтомобилю(Автомобиль)

	МассивПосещений = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	Renault_CRM_ЗаявкаНаСервис.Дата КАК Дата,
		|	Renault_CRM_ЗаявкаНаСервис.ДилерскийЦентр КАК ДилерскийЦентр,
		|	Renault_CRM_ЗаявкаНаСервис.ДилерскийЦентр.Наименование КАК НаименованиеДЦ,
		|	ЗаказНарядТиповой.Товары.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Номенклатура КАК Номенклатура
		|	) КАК Товары,
		|	ЗаказНарядТиповой.Работы.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Работа КАК Работа
		|	) КАК Работы
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНарядТиповой
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|		ПО (Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд = ЗаказНарядТиповой.Ссылка)
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд.Проведен
		|	И Renault_CRM_ЗаявкаНаСервис.Автомобиль = &Автомобиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураПосещения = Новый Структура;
		СтруктураПосещения.Вставить("date", ЗаписатьДатуJSON(Выборка.Дата, ФорматДатыJSON.ISO));
		СтруктураПосещения.Вставить("dealerName", Выборка.НаименованиеДЦ);
		МассивРабот = Новый Массив;
		ВыборкаРабот = Выборка.Работы.Выбрать();
		Пока ВыборкаРабот.Следующий() Цикл
			СтруктураРаботы = Новый Структура;
			СтруктураРаботы.Вставить("work", ВыборкаРабот.Работа.Наименование);
			СтруктураРаботы.Вставить("code", ВыборкаРабот.Работа.Артикул);
			МассивРабот.Добавить(СтруктураРаботы);
		КонецЦикла;
		СтруктураПосещения.Вставить("works",МассивРабот);
		
		МассивТоваров = Новый Массив;
		ВыборкаТовары = Выборка.Товары.Выбрать();
		Пока ВыборкаТовары.Следующий() Цикл
			СтруктураРаботы = Новый Структура;
			СтруктураРаботы.Вставить("part", ВыборкаТовары.Номенклатура.Наименование);
			СтруктураРаботы.Вставить("code", ВыборкаТовары.Номенклатура.Артикул);
			МассивТоваров.Добавить(СтруктураРаботы);
		КонецЦикла;
		СтруктураПосещения.Вставить("parts",МассивТоваров);
		МассивПосещений.Добавить(СтруктураПосещения);
	КонецЦикла;
	
	Возврат МассивПосещений;

КонецФункции 

Процедура ОбновитьПримечания(МассивРабот)
	
	Для Каждого РаботаСКомментарием из МассивРабот Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНарядРаботы.Ссылка КАК Ссылка,
		|	ЗаказНарядРаботы.Работа КАК Работа,
		|	ЗаказНарядРаботы.ИдентификаторРаботы КАК ИдентификаторРаботы,
		|	ЗаказНарядРаботы.ПримечаниеРаботы КАК ПримечаниеРаботы
		|ИЗ
		|	Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
		|ГДЕ
		|	ЗаказНарядРаботы.ИдентификаторРаботы = &ИдентификаторРаботы";
		
		Запрос.УстановитьПараметр("ИдентификаторРаботы", РаботаСКомментарием.id);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Если Не Выборка.ПримечаниеРаботы = РаботаСКомментарием.comment Тогда
				//ЗаказОбъект = Документы.ЗаказНаряд.СоздатьДокумент();
				ЗаказОбъект = Выборка.Ссылка.ПолучитьОбъект();
				СтрокаРабот = ЗаказОбъект.Работы.Найти(РаботаСКомментарием.id,"ИдентификаторРаботы");
				СтрокаРабот.ПримечаниеРаботы = РаботаСКомментарием.comment;
				ЗаказОбъект.ОбменДанными.Загрузка = Истина;
				
				ЗаказОбъект.Записать();
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСертификатКонтроляПоВыдаче(ВыдачаСсылка) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_СертификатКонтроля.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_СертификатКонтроля КАК Renault_СертификатКонтроля
		|		ПО Renault_CRM_ВыдачаАвтомобиля.Обращение = Renault_СертификатКонтроля.Обращение
		|ГДЕ
		|	Renault_CRM_ВыдачаАвтомобиля.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ВыдачаСсылка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	Иначе
		СертификатКонтроляОбъект = Документы.Renault_СертификатКонтроля.СоздатьДокумент();
		//СертификатКонтроляОбъект.Автор = ПараметрыСеанса.Пользователь;
		СертификатКонтроляОбъект.ЗаполнитьПоОбращению(ВыдачаСсылка.Обращение);
		Если ВыдачаСсылка.Обращение.ВидОбращения =  Справочники.Renault_ВидыОбращенийВАвтосервис.ДиагностикаТрейдИн Тогда
			СертификатКонтроляОбъект.R_Selection = Истина;
		КонецЕсли;	
		СертификатКонтроляОбъект.ЗаполнитьПереченьОпераций();

		СертификатКонтроляОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат СертификатКонтроляОбъект.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьККРПоВыдаче(ВыдачаСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_КонтрольКачестваРабот.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.DMS_КонтрольКачестваРабот КАК DMS_КонтрольКачестваРабот
		|		ПО Renault_CRM_ВыдачаАвтомобиля.Обращение = DMS_КонтрольКачестваРабот.Обращение
		|ГДЕ
		|	Renault_CRM_ВыдачаАвтомобиля.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ВыдачаСсылка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	Иначе
		ДокККРОбъект = Документы.DMS_КонтрольКачестваРабот.СоздатьДокумент();
		ДокККРОбъект.ЗаполнитьПоОбращению(ВыдачаСсылка.Обращение);
		ДокККРОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ДокККРОбъект.Ссылка;
	КонецЕсли;

КонецФункции

Функция ОпределитьИндексКартинкиВыбраннойЗоны(ЗонаПовреждения)

	СоответствияЗон = Renault_АвтосервисСерверСинхрСПланшетом.ПолучитьСоответствияКодовЭлементовЗонПовреждений();
	
	Для Каждого ЭлЗон из СоответствияЗон Цикл
		Если ЭлЗон.Значение = ЗонаПовреждения Тогда
			Возврат Число(ЭлЗон.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьМастераПоЛогину(Логин)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.Renault_Автосервис_НастройкиСотрудниковПланшет КАК Renault_Автосервис_НастройкиСотрудниковПланшет
		|ГДЕ
		|	Renault_Автосервис_НастройкиСотрудниковПланшет.Логин = &Логин";
	
	Запрос.УстановитьПараметр("Логин", Логин);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сотрудник;
	Иначе
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;

КонецФункции
