Функция СоздатьДокументОнлайнЗаписи(СтруктураСообщения,СтруктураПараметров)
	
	НовыйДокумент = Документы.DMS_ОнлайнЗаписьВАвтосервис.СоздатьДокумент();	
	НовыйДокумент.ЗаполнитьДокументОнлайнДанными(СтруктураСообщения);	
	СтруктураЗаписи = ПодготовитьСтруктуруЗаписи(НовыйДокумент);
	СтруктураОтвета = ПолучитьСтруктуруСообщения(СтруктураСообщения.type, СтруктураСообщения.to, СтруктураСообщения.from);
	СтруктураОтвета.Data = СтруктураЗаписи;
	ДобавитьСообщениеВРегистрОчередьСообщенийНаСервере(СтруктураОтвета);
	
КонецФункции

Функция ПодготовитьСтруктуруЗаписи(Док)
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("resuuid","" + Док.Ссылка.УникальныйИдентификатор());
	ДатаJSONНачалаПриемки = ЗаписатьДатуJSON(Док.ПриемкаВремяНачала,ФорматДатыJSON.ISO);
	ДатаJSONОкончанияПриемки = ЗаписатьДатуJSON(Док.ПриемкаВремяОкончания,ФорматДатыJSON.ISO);
	СтруктураПриемки = Новый Структура("starttime,endtime",ДатаJSONНачалаПриемки,ДатаJSONОкончанияПриемки);
	СтруктураОтвета.Вставить("reception",СтруктураПриемки);
	МассивРабот = Новый Массив;
	Для Каждого Работа Из Док.Этапы Цикл
		ДатаJSONНачала = ЗаписатьДатуJSON(Работа.НачалоЭтапа,ФорматДатыJSON.ISO);
		ДатаJSONОкончания = ЗаписатьДатуJSON(Работа.КонецЭтапа,ФорматДатыJSON.ISO);
		СтруктураЭтапа = Новый Структура;
		СтруктураЭтапа = Новый Структура("starttime,endtime",ДатаJSONНачала,ДатаJSONОкончания);
		МассивРабот.Добавить(СтруктураЭтапа);
	КонецЦикла;
	СтруктураОтвета.Вставить("works",МассивРабот);
	
	ДатаJSONНачалаВыдачи = ЗаписатьДатуJSON(Док.ВыдачаВремяНачала,ФорматДатыJSON.ISO);
	ДатаJSONОкончанияВыдачи = ЗаписатьДатуJSON(Док.ВыдачаВремяОкончания,ФорматДатыJSON.ISO);
	СтруктураВыдачи = Новый Структура("starttime,endtime",ДатаJSONНачалаВыдачи,ДатаJSONОкончанияВыдачи);
	СтруктураОтвета.Вставить("issue",СтруктураВыдачи);
	Возврат СтруктураОтвета;
КонецФункции

Процедура ПодтвердитьЗаписьОнлайн(СтруктураСообщения)
	
	ДокументОнлайнЗаписи = Документы.DMS_ОнлайнЗаписьВАвтосервис.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураСообщения.data.resuuid));
	
	Если Не ЗначениеЗаполнено(ДокументОнлайнЗаписи.Номер) Тогда 
		// Беседин 23.11.21 заявка 1373
		ЗаписьЖурналаРегистрации("ОнлайнЗапись", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписьНаСервис",
				СтруктураСообщения.data.resuuid, "Не найден документ для онлайн записи");		
		ВызватьИсключение("Не найден документ для онлайн записи");
	КонецЕсли;
	
	ДокументОнлайнЗаписи.ПолучитьОбъект().ЗапланироватьДаннымиДокумента(СтруктураСообщения);
	Если ДокументОнлайнЗаписи.Подтверждена Тогда
		Обращение = Документы.Renault_CRM_ОбращениеВАвтоСервис.ПолучитьОбращениеПоОнлайнЗаписи(ДокументОнлайнЗаписи);
		Заявка = Документы.Renault_CRM_ЗаявкаНаСервис.ПолучитьЗаявкуНаСервисПоОбращению(Обращение);
		ОтправитьСообщениеОбУспехеЗаписи(СтруктураСообщения,Заявка.Номер);
		ЗаписатьОповещение(""+Заявка.УникальныйИдентификатор());
	Иначе                       
		ЗаписьЖурналаРегистрации("ОнлайнЗапись", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписьНаСервис",
				ДокументОнлайнЗаписи, "Не удалось подтвердить документ, под онлайн запись");
		
		ВызватьИсключение("Не удалось подтвердить документ, под онлайн запись");
	КонецЕсли;
	
КонецПроцедуры

