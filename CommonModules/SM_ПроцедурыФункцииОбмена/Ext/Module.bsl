Процедура ОсновнаяПроцедураОбмена() Экспорт 
	
	Узел_АА5 = ПланыОбмена.SM_ОбменКонтрагентами_АА5_БП3.ЭтотУзел();
	Узел_БП3 = ПланыОбмена.SM_ОбменКонтрагентами_АА5_БП3.НайтиПоКоду("Узел_БП3");
	АдресКаталога = Константы.SM_АдресКаталога.Получить();  // \\1C01\1caccExchange\КонтрагентыИДоговора
	
	ОсновнаяЗаписьXML(Узел_АА5,Узел_БП3,АдресКаталога);
	
	HTTPОтвет = ОсновнаяОтправитьHTTPЗапрос();
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		ОсновнаяЧтениеXMLФайлаОтвета(Узел_АА5,Узел_БП3,АдресКаталога);
		УдалитьФайлы(АдресКаталога);
	КонецЕсли;
		
КонецПроцедуры 

Процедура ОсновнаяЗаписьXML(Узел_АА5,Узел_БП3,АдресКаталога)
	
	ЗаписьXML	= Новый ЗаписьXML;
	
	ИмяФайла	= СтрШаблон("%1\%2_%3",АдресКаталога,Узел_АА5.Код,Узел_БП3.Код);
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьСообщения	= ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML,Узел_БП3);
	
	ВыборкаПланаОбмена	= ПланыОбмена.ВыбратьИзменения(Узел_БП3,ЗаписьСообщения.НомерСообщения);
	
	Пока ВыборкаПланаОбмена.Следующий() Цикл
		Данные					= ВыборкаПланаОбмена.Получить();
		СтруктураКонтрагента	= СоздатьСтруктуруКонтрагента();
		Контрагент				= СтруктураКонтрагента.Контрагент;
		ТаблицаДоговоров        = Контрагент.Договоры;
		Контрагент.Наименование				= Данные.Наименование;
		Контрагент.НаименованиеПолное		= Данные.НаименованиеПолное;
		Контрагент.РегистрационныйНомер		= Данные.ОГРН;
		Контрагент.НомерТелефона			= Данные.ОсновнойТелефон;
		Контрагент.ИНН						= Данные.ИНН;
		Контрагент.КПП						= Данные.КПП;
		Контрагент.УникальныйИдентификатор	= Строка(Данные.Ссылка.УникальныйИдентификатор());	
		Контрагент.ВидКонтрагента			= Строка(Данные.ВидКонтрагента);
		ЗаполнитьДоговоры(ВыборкаПланаОбмена.Ссылка,ТаблицаДоговоров);
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML,СтруктураКонтрагента);	
	КонецЦикла; 
	
	ЗаписьСообщения.ЗакончитьЗапись();
	
КонецПроцедуры

Функция ОсновнаяОтправитьHTTPЗапрос()
	
	HTTPЗапрос = Новый HTTPЗапрос;
	HTTPЗапрос.АдресРесурса = "/ACC/hs/SM_MEofC/MakeAnExchange";
	HTTPСоединение = Новый HTTPСоединение("1c01");
	HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("GET", HTTPЗапрос);
	
	Возврат HTTPОтвет;
	
КонецФункции

Процедура ОсновнаяЧтениеXMLФайлаОтвета(Узел_АА5,Узел_БП3,АдресКаталога)

	ИмяФайла = СтрШаблон("%1\%2_%3",АдресКаталога,Узел_БП3,Узел_АА5);
	Файл = Новый Файл(ИмяФайла);	
	Если НЕ Файл.Существует() Тогда
		
	КонецЕсли; 	
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	ЧтениеСообщения = ПланыОбмена.СоздатьЧтениеСообщения();
	ЧтениеСообщения.НачатьЧтение(ЧтениеXML);
	ПланыОбмена.УдалитьРегистрациюИзменений(ЧтениеСообщения.Отправитель,ЧтениеСообщения.НомерПринятого);
	ЧтениеСообщения.ЗакончитьЧтение();
	
КонецПроцедуры  

Процедура ЗаполнитьДоговоры(Контрагент,ТаблицаДоговоров)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка,
		|	ДоговорыВзаиморасчетов.ВидДоговора КАК ВидДоговора,
		|	ДоговорыВзаиморасчетов.НомерДоговора КАК НомерДоговора,
		|	ДоговорыВзаиморасчетов.ДатаНачала КАК ДатаНачала,
		|	ДоговорыВзаиморасчетов.Организация КАК Организация,
		|	ДоговорыВзаиморасчетов.Наименование КАК Наименование,
		|	ДоговорыВзаиморасчетов.Организация.ИНН КАК ОрганизацияИНН
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
		|ГДЕ
		|	НЕ ДоговорыВзаиморасчетов.ПометкаУдаления
		|	И ДоговорыВзаиморасчетов.ДатаКонца = ДАТАВРЕМЯ(1, 1, 1)
		|	И ДоговорыВзаиморасчетов.ВидДоговора В(&ВидДоговора)
		|	И ДоговорыВзаиморасчетов.Владелец = &Контрагент";
	
	ВидДоговора = Новый Массив;
	ВидДоговора.Добавить(Перечисления.ВидыДоговоров.Покупка);
	ВидДоговора.Добавить(Перечисления.ВидыДоговоров.Продажа);
	
	Запрос.УстановитьПараметр("ВидДоговора",	ВидДоговора);
	Запрос.УстановитьПараметр("Контрагент",		Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		НоваяЗапись = ТаблицаДоговоров.Добавить();
		НоваяЗапись.ВидДоговора	= Строка(РезультатЗапроса.ВидДоговора);
		НоваяЗапись.НомерДоговора = Строка(РезультатЗапроса.НомерДоговора);
		НоваяЗапись.ДатаНачала = Строка(РезультатЗапроса.ДатаНачала);
		НоваяЗапись.Организация = Строка(РезультатЗапроса.Организация);
		НоваяЗапись.ОрганизацияИНН = Строка(РезультатЗапроса.ОрганизацияИНН);
		НоваяЗапись.Наименование = Строка(РезультатЗапроса.Наименование);
		НоваяЗапись.УникальныйИдентификатор = Строка(РезультатЗапроса.Ссылка.УникальныйИдентификатор());
			
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьСтруктуруКонтрагента()
	
	СоставКонтрагента	= "Наименование,НаименованиеПолное,РегистрационныйНомер,НомерТелефона,ИНН,КПП,УникальныйИдентификатор,ВидКонтрагента,Договоры";
	
	ТаблицаДоговоров = Новый ТаблицаЗначений;
	ТаблицаДоговоров.Колонки.Добавить("ВидДоговора",	Новый ОписаниеТипов("Строка"));
	ТаблицаДоговоров.Колонки.Добавить("НомерДоговора",	Новый ОписаниеТипов("Строка"));
	ТаблицаДоговоров.Колонки.Добавить("ДатаНачала",		Новый ОписаниеТипов("Строка"));
	ТаблицаДоговоров.Колонки.Добавить("Организация",	Новый ОписаниеТипов("Строка"));
	ТаблицаДоговоров.Колонки.Добавить("ОрганизацияИНН",	Новый ОписаниеТипов("Строка"));
	ТаблицаДоговоров.Колонки.Добавить("Наименование",	Новый ОписаниеТипов("Строка"));
	ТаблицаДоговоров.Колонки.Добавить("УникальныйИдентификатор",	Новый ОписаниеТипов("Строка"));
	
	Контрагент = Новый Структура(СоставКонтрагента,,,,,,,,,ТаблицаДоговоров);
	
	Структура = Новый Структура("Контрагент",Контрагент);
	
	Возврат Структура; 
	
КонецФункции

