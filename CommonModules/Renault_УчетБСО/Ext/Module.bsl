Функция ПолучитьБСОВОрганизацииНеПереданныеНаТочки(Дата, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВложенныйБСОВОрганизации.Организация,
	               |	ВложенныйБСОВОрганизации.СтраховаяКомпания,
	               |	ВложенныйБСОВОрганизации.ТипБСО,
	               |	ВложенныйБСОВОрганизации.СерияБСО,
	               |	ВложенныйБСОВОрганизации.НомерБСО,
	               |	ВложенныйБСОВОрганизации.Количество - ЕСТЬNULL(ВложенныйБСОНаТочках.Количество, 0) КАК Количество
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Renault_БСОВОрганизацииОстатки.Организация КАК Организация,
	               |		Renault_БСОВОрганизацииОстатки.СтраховаяКомпания КАК СтраховаяКомпания,
	               |		Renault_БСОВОрганизацииОстатки.ТипБСО КАК ТипБСО,
	               |		Renault_БСОВОрганизацииОстатки.СерияБСО КАК СерияБСО,
	               |		Renault_БСОВОрганизацииОстатки.НомерБСО КАК НомерБСО,
	               |		СУММА(Renault_БСОВОрганизацииОстатки.КоличествоОстаток) КАК Количество
	               |	ИЗ
	               |		РегистрНакопления.Renault_БСОВОрганизации.Остатки(&Дата, Организация = &Организация) КАК Renault_БСОВОрганизацииОстатки
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		Renault_БСОВОрганизацииОстатки.НомерБСО,
	               |		Renault_БСОВОрганизацииОстатки.СерияБСО,
	               |		Renault_БСОВОрганизацииОстатки.СтраховаяКомпания,
	               |		Renault_БСОВОрганизацииОстатки.Организация,
	               |		Renault_БСОВОрганизацииОстатки.ТипБСО
	               |	
	               |	ИМЕЮЩИЕ
	               |		СУММА(Renault_БСОВОрганизацииОстатки.КоличествоОстаток) > 0) КАК ВложенныйБСОВОрганизации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Renault_БСОНаТочкеПродажОстатки.Организация КАК Организация,
	               |			Renault_БСОНаТочкеПродажОстатки.СтраховаяКомпания КАК СтраховаяКомпания,
	               |			Renault_БСОНаТочкеПродажОстатки.ТипБСО КАК ТипБСО,
	               |			Renault_БСОНаТочкеПродажОстатки.СерияБСО КАК СерияБСО,
	               |			Renault_БСОНаТочкеПродажОстатки.НомерБСО КАК НомерБСО,
	               |			СУММА(Renault_БСОНаТочкеПродажОстатки.КоличествоОстаток) КАК Количество
	               |		ИЗ
	               |			РегистрНакопления.Renault_БСОНаТочкеПродаж.Остатки(&Дата, Организация = &Организация) КАК Renault_БСОНаТочкеПродажОстатки
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			Renault_БСОНаТочкеПродажОстатки.Организация,
	               |			Renault_БСОНаТочкеПродажОстатки.ТипБСО,
	               |			Renault_БСОНаТочкеПродажОстатки.НомерБСО,
	               |			Renault_БСОНаТочкеПродажОстатки.СтраховаяКомпания,
	               |			Renault_БСОНаТочкеПродажОстатки.СерияБСО
	               |		
	               |		ИМЕЮЩИЕ
	               |			СУММА(Renault_БСОНаТочкеПродажОстатки.КоличествоОстаток) > 0) КАК ВложенныйБСОНаТочках
	               |		ПО ВложенныйБСОВОрганизации.Организация = ВложенныйБСОНаТочках.Организация
	               |			И ВложенныйБСОВОрганизации.СтраховаяКомпания = ВложенныйБСОНаТочках.СтраховаяКомпания
	               |			И ВложенныйБСОВОрганизации.ТипБСО = ВложенныйБСОНаТочках.ТипБСО
	               |			И ВложенныйБСОВОрганизации.СерияБСО = ВложенныйБСОНаТочках.СерияБСО
	               |			И ВложенныйБСОВОрганизации.НомерБСО = ВложенныйБСОНаТочках.НомерБСО
	               |ГДЕ
	               |	ВложенныйБСОВОрганизации.Количество - ЕСТЬNULL(ВложенныйБСОНаТочках.Количество, 0) > 0";
				   
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат ПолучитьПустуюТаблицуБСО(); 	
	Иначе
		Возврат Результат.Выгрузить();	
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьПустуюТаблицуБСО() Экспорт
	ТаблицаБСО = Новый ТаблицаЗначений();
	ТаблицаБСО.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	Массив=Новый Массив; 
	Массив.Добавить(Тип("СправочникСсылка.Контрагенты"));
	Массив.Добавить(Тип("СправочникСсылка.Банки"));
	ТаблицаБСО.Колонки.Добавить("СтраховаяКомпания", Новый ОписаниеТипов(Массив));
	ТаблицаБСО.Колонки.Добавить("ТочкаПродаж", Новый ОписаниеТипов("СправочникСсылка.ПодразделенияКомпании"));
	ТаблицаБСО.Колонки.Добавить("ТипБСО", Новый ОписаниеТипов("СправочникСсылка.Renault_ТипыБСО"));
	ТаблицаБСО.Колонки.Добавить("СерияБСО", Новый ОписаниеТипов("СправочникСсылка.Renault_СерииБСО"));
	ТаблицаБСО.Колонки.Добавить("НомерБСО", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	ТаблицаБСО.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Возврат ТаблицаБСО;
КонецФункции

Функция ПроверитьНаличиеБСО(Дата, ТаблицаБСО, Организация, СтраховаяКомпания = неопределено, ТочкаПродаж = неопределено, НеобходимоНаличие = ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
	Запрос.УстановитьПараметр("ТаблицаБСО", ТаблицаБСО);
	
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_ТаблицаБСО ИЗ &ТаблицаБСО КАК ТаблицаБСО";
	Запрос.Выполнить();
	
	Если ТочкаПродаж = неопределено Тогда
		
		Запрос.УстановитьПараметр("БСОВОрганизации", ПолучитьБСОВОрганизации(Дата, Организация));
		
		Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_БСОВОрганизации ИЗ &БСОВОрганизации КАК БСОВОрганизации";
		Запрос.Выполнить();
		
		Если НеобходимоНаличие Тогда
			
			Запрос.Текст = "ВЫБРАТЬ
			               |	ВТ_ТаблицаБСО.Организация,
			               |	ВТ_ТаблицаБСО.СтраховаяКомпания,
			               |	ВТ_ТаблицаБСО.ТипБСО,
			               |	ВТ_ТаблицаБСО.СерияБСО,
			               |	ВТ_ТаблицаБСО.НомерБСО,
			               |	ВТ_ТаблицаБСО.Количество
			               |ИЗ
			               |	ВТ_ТаблицаБСО КАК ВТ_ТаблицаБСО
			               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БСОВОрганизации КАК ВТ_БСОВОрганизации
			               |		ПО ВТ_ТаблицаБСО.Организация = ВТ_БСОВОрганизации.Организация
			               |			И ВТ_ТаблицаБСО.СтраховаяКомпания = ВТ_БСОВОрганизации.СтраховаяКомпания
			               |			И ВТ_ТаблицаБСО.ТипБСО = ВТ_БСОВОрганизации.ТипБСО
			               |			И ВТ_ТаблицаБСО.СерияБСО = ВТ_БСОВОрганизации.СерияБСО
			               |			И ВТ_ТаблицаБСО.НомерБСО = ВТ_БСОВОрганизации.НомерБСО
			               |ГДЕ
			               |	ВТ_БСОВОрганизации.НомерБСО ЕСТЬ NULL ";
						   
			Результат = Запрос.Выполнить();
			
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Сообщить("Бланк " + Выборка.СерияБСО + " " + Выборка.НомерБСО + " не принят в организацию");
			КонецЦикла;	
				
			Возврат Результат.Пустой();
			
		Иначе	
		
			Запрос.Текст = "ВЫБРАТЬ
			               |	ВТ_ТаблицаБСО.Организация,
			               |	ВТ_ТаблицаБСО.СтраховаяКомпания,
			               |	ВТ_ТаблицаБСО.ТипБСО,
			               |	ВТ_ТаблицаБСО.СерияБСО,
			               |	ВТ_ТаблицаБСО.НомерБСО,
			               |	ВТ_ТаблицаБСО.Количество
			               |ИЗ
			               |	ВТ_ТаблицаБСО КАК ВТ_ТаблицаБСО
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_БСОВОрганизации КАК ВТ_БСОВОрганизации
			               |		ПО ВТ_ТаблицаБСО.Организация = ВТ_БСОВОрганизации.Организация
			               |			И ВТ_ТаблицаБСО.СтраховаяКомпания = ВТ_БСОВОрганизации.СтраховаяКомпания
			               |			И ВТ_ТаблицаБСО.ТипБСО = ВТ_БСОВОрганизации.ТипБСО
			               |			И ВТ_ТаблицаБСО.СерияБСО = ВТ_БСОВОрганизации.СерияБСО
			               |			И ВТ_ТаблицаБСО.НомерБСО = ВТ_БСОВОрганизации.НомерБСО";
						   
			Результат = Запрос.Выполнить();
			
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Сообщить("Бланк " + Выборка.СерияБСО + " " + Выборка.НомерБСО + " уже принят в организацию");
			КонецЦикла;	
				
			Возврат НЕ Результат.Пустой();
			
		КонецЕсли;	
		
	Иначе
		
