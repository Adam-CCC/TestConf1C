Функция ПолучитьТаблицуБСОПоТабЧасти(ТабЧасть, Организация, СтраховаяКомпания = неопределено, ТочкаПродаж = неопределено, ЭтоИнтервалНомеров = истина) Экспорт
	
	Если ТабЧасть = неопределено ИЛИ ТабЧасть.Количество() = 0 Тогда
		Возврат ПолучитьПустуюТаблицуБСО();
	Иначе
		
		БСО = ПолучитьПустуюТаблицуБСО();
		
		Если ЭтоИнтервалНомеров Тогда
		
			Для Каждого Строка Из ТабЧасть Цикл
				
				ТекСтрока = Строка; // чтобы не исправлять код
				
				НомерБСО = СокрЛП(ТекСтрока.НомерБСОНач);
				
				Для Индекс = 1 По ТекСтрока.Количество Цикл
					
					НоваяСтрока = БСО.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
					НоваяСтрока.НомерБСО = НомерБСО;
					НоваяСтрока.Количество = 1; 
					НоваяСтрока.Организация = Организация;
					Если СтраховаяКомпания = неопределено Тогда
						НоваяСтрока.СтраховаяКомпания = Строка.СтраховаяКомпания;
					Иначе
						НоваяСтрока.СтраховаяКомпания = СтраховаяКомпания;
					КонецЕсли;
					Если ТочкаПродаж <> неопределено Тогда
						НоваяСтрока.ТочкаПродаж = ТочкаПродаж;
					КонецЕсли;	
					
					НомерБСО = ДобавитьКНомеру(НомерБСО, 1);
					
				КонецЦикла;	
				
				//НоваяСтрока = БСО.Добавить();
				//ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				//НоваяСтрока.НомерБСО = Строка.НомерБСОНач;
				//НоваяСтрока.Организация = Организация;
				//Если СтраховаяКомпания = неопределено Тогда
				//	НоваяСтрока.СтраховаяКомпания = Строка.СтраховаяКомпания;
				//Иначе
				//	НоваяСтрока.СтраховаяКомпания = СтраховаяКомпания;
				//КонецЕсли;
				//Если ТочкаПродаж <> неопределено Тогда
				//	НоваяСтрока.ТочкаПродаж = ТочкаПродаж;
				//КонецЕсли;	
					
			КонецЦикла;
			
		Иначе
			
			Для Каждого Строка Из ТабЧасть Цикл
				
				НоваяСтрока = БСО.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				НоваяСтрока.Количество = 1; 
				НоваяСтрока.Организация = Организация;
				Если СтраховаяКомпания = неопределено Тогда
					НоваяСтрока.СтраховаяКомпания = Строка.СтраховаяКомпания;
				Иначе
					НоваяСтрока.СтраховаяКомпания = СтраховаяКомпания;
				КонецЕсли;
				Если ТочкаПродаж <> неопределено Тогда
					НоваяСтрока.ТочкаПродаж = ТочкаПродаж;
				КонецЕсли;	
					
			КонецЦикла;
			
		КонецЕсли;	
		
		Возврат БСО;
		
	КонецЕсли;	
	
