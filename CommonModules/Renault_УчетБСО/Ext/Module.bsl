//#Если ЭтоКлиент Тогда
Процедура ОбработатьНачалоВыбора(Элемент, СтандартнаяОбработка, Форма, СтраховаяКомпания, ТипБСО = неопределено) Экспорт

	СтандартнаяОбработка = ложь;
	
	Если ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.Renault_ТипыБСО") Тогда
		
		Если НЕ ЗначениеЗаполнено(СтраховаяКомпания) Тогда
			Сообщить("Необходимо выбрать страховую компанию",СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;	
		
		ФормаВыбора = Справочники.Renault_ТипыБСО.ПолучитьФормуВыбора();
		Список = ПолучитьСписокТиповБСОПоСК(СтраховаяКомпания);
		
	ИначеЕсли ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.Renault_СерииБСО") Тогда
		
		Если НЕ ЗначениеЗаполнено(СтраховаяКомпания) Тогда
			Сообщить("Необходимо выбрать страховую компанию",СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(ТипБСО) Тогда
			Сообщить("Необходимо выбрать тип бланка",СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;	
		
		ФормаВыбора = Справочники.Renault_СерииБСО.ПолучитьФормуВыбора();
		Список = ПолучитьСписокСерийБСО(СтраховаяКомпания, ТипБСО);
		
	КонецЕсли;	
	
	ФормаВыбора.СправочникСписок.Отбор.Ссылка.ВидСравнения = ВидСравнения.ВСписке;
	ФормаВыбора.СправочникСписок.Отбор.Ссылка.Значение = Список;
	ФормаВыбора.СправочникСписок.Отбор.Ссылка.Использование = Истина;
		
	Элемент.Значение = ФормаВыбора.ОткрытьМодально();

КонецПроцедуры	
//#КонецЕсли

Процедура ЗаполнитьПоследнийНомерБСО(ТекСтрока) Экспорт
	
	Если ПустаяСтрока(ТекСтрока.НомерБСОНач) Тогда
		ТекСтрока.НомерБСОКон = "";
		Возврат;
	КонецЕсли;	
	
	Если ТекСтрока.Количество = 1 Тогда
		ТекСтрока.НомерБСОКон = ТекСтрока.НомерБСОНач;
	ИначеЕсли ТекСтрока.Количество = 0 Тогда
		ТекСтрока.НомерБСОКон = "";
	Иначе	
		НомерНач = ТекСтрока.НомерБСОНач;
		Количество = ТекСтрока.Количество;
		НомерНачЧисло = Число(НомерНач);
		//КоличествоНулейДо = 0;
		Суффикс = СтрЗаменить(НомерНач, " ", "");
		//ДлинаНомера = СтрДлина(НомерНач);
		ЛевСимвол = "";
		Префикс = "";
		Пока истина Цикл
			ЛевСимвол = Лев(Суффикс, 1);
			Суффикс = Прав(Суффикс, СтрДлина(Суффикс) - 1);
			Если ЛевСимвол <> "0" Тогда
				Прервать;
			КонецЕсли;
			Префикс = Префикс + "0"; 
		КонецЦикла;	
		
		НомерКонЧисло = НомерНачЧисло + Количество - 1;
		
		НомерКон = Префикс + Строка(НомерКонЧисло);
		
		ТекСтрока.НомерБСОКон = Прав(СтрЗаменить(НомерКон, Символы.НПП, ""), СтрДлина(СтрЗаменить(НомерНач, " ", "")));
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьНомераБланков(ТекСтрока, НомераБланков) Экспорт
	
	Если ТекСтрока = неопределено ИЛИ ПустаяСтрока(ТекСтрока.НомерБСОНач) ИЛИ ТекСтрока.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	НомерБСО = СокрЛП(ТекСтрока.НомерБСОНач);	
	//НаименованиеБСО = "" + ТекСтрока.ТипБСО + " " + ТекСтрока.СерияБСО + " " + НомерБСО; 
	//Отбор.Вставить("На", ТекСтрока.ТипБСО);
	//Отбор.Вставить("СерияБСО", ТекСтрока.СерияБСО);
	Для Индекс = 1 По ТекСтрока.Количество Цикл 
		НаименованиеБСО = "" + ТекСтрока.ТипБСО + " " + ТекСтрока.СерияБСО + " " + НомерБСО; 
		Отбор.Вставить("НаименованиеБСО", НаименованиеБСО);
		МассивСтрок = НомераБланков.НайтиСтроки(Отбор);
		Для Каждого Строка Из МассивСтрок Цикл
			НомераБланков.Удалить(Строка);	
		КонецЦикла;	
		//Индекс = Индекс + 1;
		НомерБСО = ДобавитьКНомеру(НомерБСО, 1);
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьНомераБланков(ТекСтрока, НомераБланков) Экспорт
	
	Если ТекСтрока = неопределено ИЛИ ПустаяСтрока(ТекСтрока.НомерБСОНач) ИЛИ ТекСтрока.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерБСО = СокрЛП(ТекСтрока.НомерБСОНач);
	
	Для Индекс = 1 По ТекСтрока.Количество Цикл
		
		НоваяСтрока = НомераБланков.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.НомерБСО = НомерБСО;
		НоваяСтрока.Количество = 1; 
		НоваяСтрока.НаименованиеБСО = "" + ТекСтрока.ТипБСО + " " + ТекСтрока.СерияБСО + " " + НомерБСО; 
		
		НомерБСО = ДобавитьКНомеру(НомерБСО, 1);
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ДобавитьКНомеру(НомерБСО, Значение)
	
	НомерНач = НомерБСО;
	Количество = 1;
	НомерНачЧисло = Число(НомерНач);
	//КоличествоНулейДо = 0;
	Суффикс = СтрЗаменить(НомерНач, " ", "");
	//ДлинаНомера = СтрДлина(НомерНач);
	ЛевСимвол = "";
	Префикс = "";
	Пока истина Цикл
		ЛевСимвол = Лев(Суффикс, 1);
		Суффикс = Прав(Суффикс, СтрДлина(Суффикс) - 1);
		Если ЛевСимвол <> "0" Тогда
			Прервать;
		КонецЕсли;
		Префикс = Префикс + "0"; 
	КонецЦикла;	
	
	НомерКонЧисло = НомерНачЧисло + Количество;
	
	НомерКон = Префикс + Строка(НомерКонЧисло);
	
	НомерБСОКон = Прав(СтрЗаменить(НомерКон, Символы.НПП, ""), СтрДлина(СтрЗаменить(НомерНач, " ", "")));
	
	Возврат НомерБСОКон;
	
КонецФункции	
	
