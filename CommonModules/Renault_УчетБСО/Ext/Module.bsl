Процедура ПечатьАктаПриемаПередачиБСО(Дата, Номер, Выдал, Принял, ТабЧасть) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьОбщийМакет("Renault_АктПриемаПередачиБСО");	
    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Дата = Дата;
	ОбластьШапка.Параметры.Номер = Номер;
	ОбластьШапка.Параметры.Выдал = Выдал;
	ОбластьШапка.Параметры.Принял = Принял;
	
	ТабДок.Вывести(ОбластьШапка);
	
    ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	
	НомерПоПорядку = 1;
	Для Каждого Строка Из ТабЧасть Цикл;

		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Строка);
		ОбластьСтрока.Параметры.НомерПоПорядку = НомерПоПорядку;
		ТабДок.Вывести(ОбластьСтрока);
		
		НомерПоПорядку = НомерПоПорядку + 1;

	КонецЦикла;	
	
    ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Выдал = "(" + Выдал + ")";
	ОбластьПодвал.Параметры.Принял = "(" + Принял + ")";
	ТабДок.Вывести(ОбластьПодвал);
	
	ТабДок.Показать();
	
КонецПроцедуры

Функция ПолучитьБСОВОрганизации(Дата, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_БСОВОрганизацииОстатки.Организация,
	               |	Renault_БСОВОрганизацииОстатки.СтраховаяКомпания,
	               |	Renault_БСОВОрганизацииОстатки.ТипБСО,
	               |	Renault_БСОВОрганизацииОстатки.СерияБСО,
	               |	Renault_БСОВОрганизацииОстатки.НомерБСО,
	               |	СУММА(Renault_БСОВОрганизацииОстатки.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.Renault_БСОВОрганизации.Остатки(&Дата, Организация = &Организация) КАК Renault_БСОВОрганизацииОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Renault_БСОВОрганизацииОстатки.НомерБСО,
	               |	Renault_БСОВОрганизацииОстатки.СерияБСО,
	               |	Renault_БСОВОрганизацииОстатки.СтраховаяКомпания,
	               |	Renault_БСОВОрганизацииОстатки.Организация,
	               |	Renault_БСОВОрганизацииОстатки.ТипБСО
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(Renault_БСОВОрганизацииОстатки.КоличествоОстаток) > 0";
				   
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат ПолучитьПустуюТаблицуБСО(); 	
	Иначе
		Возврат Результат.Выгрузить();	
	КонецЕсли;	
	
КонецФункции	

Функция ПолучитьБСОНаТочке(Дата, Организация, ТочкаПродаж)
	
