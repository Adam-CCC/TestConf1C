Процедура ПолучитьРабочиеЛистыИСобытия(ДатаНачала,ДатаОкончания) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочийЛист.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ РабочиеЛисты
		|ИЗ
		|	Документ.РабочийЛист КАК РабочийЛист
		|ГДЕ
		|	РабочийЛист.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РабочиеЛисты.Ссылка КАК РабочийЛист,
		|	Событие.Ссылка КАК Событие,
		|	Событие.Дата КАК Дата,
		|	Событие.ДатаНачала КАК ДатаНачала,
		|	Событие.ДатаОкончания КАК ДатаОкончания,
		|	Событие.СМ_ДатаСоздания КАК СМ_ДатаСоздания
		|ПОМЕСТИТЬ Выборка
		|ИЗ
		|	РабочиеЛисты КАК РабочиеЛисты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Событие КАК Событие
		|		ПО РабочиеЛисты.Ссылка = Событие.ДокументОснование
		|			И (Событие.ДокументОснование ССЫЛКА Документ.РабочийЛист)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Выборка.РабочийЛист КАК РабочийЛист,
		|	Выборка.Событие КАК Событие,
		|	Выборка.Дата КАК Дата,
		|	Выборка.ДатаНачала КАК ДатаНачала,
		|	Выборка.ДатаОкончания КАК ДатаОкончания,
		|	Выборка.СМ_ДатаСоздания КАК СМ_ДатаСоздания
		|ИЗ
		|	Выборка КАК Выборка
		|ГДЕ
		|	НЕ Выборка.Событие ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	Выборка.РабочийЛист.Дата УБЫВ
		|ИТОГИ ПО
		|	РабочийЛист";
	
	Запрос.УстановитьПараметр("ДатаНачала"		, ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ДатаОкончания);
	
	МенеджерРегистраМаркетинговыеЛиды = РегистрыСведений.МаркетинговыеЛиды;
	
	РезультатЗапроса = Запрос.Выполнить();
	//ОбработкаПоДатам();
	ВыборкаРабочийЛист = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"РабочийЛист");
	//КоличествоРабочихЛистов = ВыборкаРабочийЛист.Количество();
	//КоличествоРабочихЛистовИтерация = 0;
	//Сообщить("Дата начала обработки: " + ТекущаяДата());
