Процедура ВыполнитьРегистрациюДляОбъектаRenault_ОбменСБП(Объект,ВспомогательныйРеквизит = "",ТолькоПоПредставителю = Ложь)
	
	СтруктураПараметров = ПолучитьПараметрыОтбораДляОбъекта(Объект,ВспомогательныйРеквизит = "",ТолькоПоПредставителю = Ложь);
	
	Получатели = ПолучателиПоОтборуУзлаRenault_ОбменСБП(СтруктураПараметров);
	
	ДополнитьПолучателей(Объект,Получатели);
	
КонецПроцедуры

Функция ПолучателиПоОтборуУзлаRenault_ОбменСБП(СтруктураПараметров)
			
	Запрос = Новый Запрос;
	
	Для каждого ПараметрОбъекта Из СтруктураПараметров Цикл
		Запрос.УстановитьПараметр(ПараметрОбъекта.Ключ,ПараметрОбъекта.Значение);	
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("ЭтотУзел", ПланыОбмена.Renault_Advanced_ОбменСБухгалтерией.ЭтотУзел());
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Renault_Advanced_ОбменСБухгалтерией.Ссылка
		|ИЗ
		|	ПланОбмена.Renault_Advanced_ОбменСБухгалтерией КАК Renault_Advanced_ОбменСБухгалтерией
		|ГДЕ
		|	Renault_Advanced_ОбменСБухгалтерией.Ссылка <> &ЭтотУзел
		|	И НЕ Renault_Advanced_ОбменСБухгалтерией.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Получатели = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Получатели.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Возврат Получатели;
	
КонецФункции // ПолучателиПоОтборуУзла()


