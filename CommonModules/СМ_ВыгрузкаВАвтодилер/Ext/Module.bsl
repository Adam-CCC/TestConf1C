Процедура НайтиВыгрузитьАнкетуСОПД(ЗаказНаряд) Экспорт
	Автомобиль = ЗаказНаряд.Автомобиль;
	Модель = Автомобиль.Модель;
	Марка = Модель.Марка;
	ЭтоHavalPro = ВИерархии(Модель, Справочники.Модели.НайтиПоКоду("ЦБ00005940")); // HAVAL Pro
	ЭтоHavalCity = ВИерархии(Модель, Справочники.Модели.НайтиПоКоду("ЦБ00005871")) Или Марка = Справочники.Марка.GREAT_WALL; // HAVAL City
	
	ЭтоШахтыХавал = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001290"); // Автоком Шахты ООО Шахты (HAVAL)
	ЭтоМалиновскогоХавал = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001718"); // Автоком Шахты ООО РМ43(HAVAL)
	ЭтоТекучеваХавалПро = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001721"); // Автоком Шахты ООО РТК354(HAVAL)
	
	Если ЭтоHavalCity И ЭтоШахтыХавал Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШахтыХавалППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоHavalCity И ЭтоМалиновскогоХавал Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоХавалППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоHavalCity И ЭтоТекучеваХавалПро Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоХавалППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоHavalPro И ЭтоТекучеваХавалПро Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ТекучеваХавалПроППО");
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;

	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда	
		Возврат;
	КонецЕсли;
	
	Если ЗаказНаряд.Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ВыгрузкаЗаказНарядаДляАнкеты(УзелОбмена, ЗаказНаряд);
	Если РезультатВыгрузки = -422 Или РезультатВыгрузки = 0 Тогда
		Сообщить("Не удалось выгрузить " + Строка(ЗаказНаряд), СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	Клиент = ЗаказНаряд.Заказчик;
	ЭтоВладелец = Клиент = ЗаказНаряд.Владелец;
	Если Клиент.ФормаСобственности <> Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		мТипыВедомых = Новый Массив();
		мТипыВедомых.Добавить(Тип("СправочникСсылка.Контрагенты"));
		ТаблицаВедомых = Неопределено;
		Если РаботаСКонтактнымиЛицами.ПолучитьВедомых(Клиент, ТаблицаВедомых, мТипыВедомых) Тогда
			Клиент = ТаблицаВедомых[0].Ведомый;
			ЭтоВладелец = Ложь;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьПодходящаяАнкета(УзелОбмена, Клиент) Тогда
		Возврат;
	КонецЕсли;
	
	ТелоЗапроса = ДанныеАнкетыСОПД(Клиент, ЭтоВладелец, ЗаказНаряд);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
		ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
		ЗапросHTTP.АдресРесурса = "/api/personal-data-agreement/event";
		стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(Клиент));
		
		Если стРезультат.id > 0 Тогда
			Сообщить("Выгружены данные Анкеты СОПД для " + Строка(Клиент), СтатусСообщения.Информация);
			Возврат;
			
		ИначеЕсли стРезультат.КодСостояния = 422 Тогда
			СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
			Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
				ТемаПисьма = "Ошибка при выгрузке данных Анкеты СОПД на портал Автодилер";
				ЗаголовокПисьма = Строка(ЗаказНаряд.Ссылка) + Символы.ПС + "Контрагент " + Строка(Клиент);
				ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
				
				стДанныеСообщения = Новый Структура();
				стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
				стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
				стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
				стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаряд.Ссылка);
				ОтправитьСообщениеОбОшибке(стДанныеСообщения);
			КонецЕсли;
			Сообщить("Не удалось выгрузить данные Анкеты СОПД для " + Строка(Клиент), СтатусСообщения.Внимание);
			Возврат;
			
		Иначе
			Сообщить("Не удалось выгрузить данные Анкеты СОПД для " + Строка(Клиент), СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;
		
	Иначе
		Сообщить("Нет данных Анкеты СОПД для " + Строка(Клиент), СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
КонецПроцедуры


//// Процедуры / функции для выгрузки данных по продажам на портал Автодилер
/////////////////////////////////////////////////////////////////////////////

Функция ДанныеСтроковогоКлиента(РабочийЛист, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", СокрЛП(РабочийЛист.Номер));
		стЗапись.Вставить("type", 0);
		ИмяКлиента = СокрЛП(РабочийЛист.Контрагент);
		ПозПробела = СтрНайти(ИмяКлиента, " ");
		Если ПозПробела > 1 Тогда
			ИмяКлиента = Лев(ИмяКлиента, ПозПробела - 1);
		КонецЕсли;
		стЗапись.Вставить("name", ИмяКлиента);	
	КонецЕсли;
	
	стЗапись.Вставить("may_process_personal_data", 1);
	стЗапись.Вставить("client_confirm_communication", 1);
	Телефон = РабочийЛист.ПредставлениеТелефона;	
	ТелефонТолькоЦифры = "";
	СимволовВПредставлении = СтрДлина(Телефон);
	Если СимволовВПредставлении > 0 Тогда
		Для сч = 1 По СимволовВПредставлении Цикл
			СимволИзНомера = Сред(Телефон, сч, 1);
			Если СтрНайти("1234567890", СимволИзНомера) > 0 Тогда
				ТелефонТолькоЦифры = ТелефонТолькоЦифры + СимволИзНомера;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТелефонТолькоЦифры) Тогда
		мТелефоны = Новый Массив();
		стТелефон = Новый Структура();
		стТелефон.Вставить("number", ТелефонТолькоЦифры);
		стТелефон.Вставить("type", 1);
		мТелефоны.Добавить(стТелефон);
		стЗапись.Вставить("phones", мТелефоны);
		//Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
		//Хеширование.Добавить(ТелефонТолькоЦифры);
		//стЗапись.Вставить("phone_hash", ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
		
	Иначе
		Сообщить("В " + Строка(РабочийЛист) + " не задан телефон контрагента!" +
		Символы.ВК + "Выгрузка в Автодилер невозможна!!!", СтатусСообщения.Внимание);
		Возврат "";
	КонецЕсли;
		
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные контрагента для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ДанныеКлиентаПродажи(Клиент, СписокТелефонов, РабочийЛист, ЭтоВыгрузка = Истина)
	Если ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат ДанныеКлиента(Клиент, СписокТелефонов, РабочийЛист.Модель.Марка, ЭтоВыгрузка, РабочийЛист.Номер, Ложь);
		
	ИначеЕсли ТипЗнч(Клиент) = Тип("Строка") Тогда
		Возврат ДанныеСтроковогоКлиента(РабочийЛист, ЭтоВыгрузка);
		
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ДанныеПотребности(РабочийЛист, КодБренда, КодМодели, КодАлиаса, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", СокрЛП(РабочийЛист.Номер));
		стЗапись.Вставить("brand_id", КодБренда);
	КонецЕсли;
	
	стЗапись.Вставить("model_id", КодМодели);
	
	Если КодБренда = 140 Тогда // CHANGAN
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 125 Тогда // LADA
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 2058 Тогда // GAC
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 2643 Или КодБренда = 2692 Тогда // Omoda-Jaecoo
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 30 Или КодБренда = 2798 Тогда // CHERY или TENET
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 2716 Тогда // VGV
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 2634 Тогда // SOLLERS
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 2710 Тогда // BELGEE
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 46 Тогда // GEELY
		стЗапись.Вставить("model_alias_id", КодАлиаса);
		
	ИначеЕсли КодБренда = 2708 Тогда // HONGQI
		стЗапись.Вставить("model_alias_id", КодАлиаса);
	КонецЕсли;

	Если ЗначениеЗаполнено(РабочийЛист.Автомобиль) Тогда
		VIN = РабочийЛист.Автомобиль.VIN;
		Если ЗначениеЗаполнено(VIN) Тогда
			стЗапись.Вставить("vin", VIN);
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные потребности для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ДанныеРабочегоЛиста(РабочийЛист, КодБренда, client_id, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", СокрЛП(РабочийЛист.Номер));
		стЗапись.Вставить("client_id", client_id);
	ИначеЕсли КодБренда = 125 Тогда // LADA
		стЗапись.Вставить("client_id", client_id);
	КонецЕсли;
	стЗапись.Вставить("is_trade_in", РабочийЛист.ТрейдИн);

	мзИсточник = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
