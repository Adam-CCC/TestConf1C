Функция ПолучитьКодМастераПриемщика(УзелОбмена, МастерПриемщик)	
	acceptor_id = 0;
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = МастерПриемщик;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда
		МаркаАвтомобиля = УзелОбмена.МаркаАвтомобиля;
		Если МаркаАвтомобиля = Справочники.Марка.UAZ Тогда
			acceptor_id = мзИдентификаторыDSF.DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FORD Тогда
			acceptor_id = мзИдентификаторыDSF.FordDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GEELY Тогда
			acceptor_id = мзИдентификаторыDSF.GeelyDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.BELGEE Тогда
			acceptor_id = мзИдентификаторыDSF.BelgeeDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
			acceptor_id = мзИдентификаторыDSF.FiatDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
			acceptor_id = мзИдентификаторыDSF.JeepDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.EXEED Или МаркаАвтомобиля = Справочники.Марка.ESTEO Тогда
			acceptor_id = мзИдентификаторыDSF.ExeedDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GAC Тогда
			acceptor_id = мзИдентификаторыDSF.GAC_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.VGV Тогда
			acceptor_id = мзИдентификаторыDSF.VGV_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHANGAN Тогда
			acceptor_id = мзИдентификаторыDSF.ChanganDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ Тогда
			acceptor_id = мзИдентификаторыDSF.VAZ_DSF_id;
			
		ИначеЕсли (МаркаАвтомобиля = Справочники.Марка.CHERY Или МаркаАвтомобиля = Справочники.Марка.TENET) Тогда
			acceptor_id = мзИдентификаторыDSF.CheryDSF_id;	
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HAVAL Тогда
			acceptor_id = мзИдентификаторыDSF.HavalDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.SOLLERS Тогда
			acceptor_id = мзИдентификаторыDSF.SollersDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HONGQI Тогда
			acceptor_id = мзИдентификаторыDSF.HongqiDSF_id;
		КонецЕсли;
	КонецЕсли;
	
	Если acceptor_id = 0 Тогда
		acceptor_id = ВыгрузитьСотрудника(УзелОбмена, МастерПриемщик);
	КонецЕсли;	
	Если acceptor_id = 0 Тогда
		#Если Клиент Тогда
		Сообщить("С порталом Автодилер не удалось синхронизировать сотрудника " + МастерПриемщик.Наименование + ". Выгрузка заказ-наряда невозможна!!!", СтатусСообщения.Внимание);						
		#КонецЕсли
	КонецЕсли;
	
	Возврат acceptor_id;
КонецФункции

Функция ДанныеРаботы(СтрокаРабота, purchase_id, Марка, ЗаказНаряд, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	Работа = СтрокаРабота.Работа;
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("purchase_id", purchase_id);
		Если Марка = Справочники.Марка.GEELY Или Марка = Справочники.Марка.BELGEE Тогда
			стЗапись.Вставить("code", КодРаботыДжили(СтрокаРабота, ЗаказНаряд));
			
		ИначеЕсли Марка = Справочники.Марка.CHANGAN Или Марка = Справочники.Марка.HAVAL Тогда
			Артикул = Работа.Артикул;
			Если ЗначениеЗаполнено(Артикул) Тогда
				стЗапись.Вставить("code", СокрЛП(Артикул));
			Иначе
				стЗапись.Вставить("code", СокрЛП(Работа.Код));
			КонецЕсли;
			
		Иначе
			стЗапись.Вставить("code", СокрЛП(Работа.Код));
		КонецЕсли;
	КонецЕсли;
	
	стЗапись.Вставить("name", Работа.Наименование);
	стЗапись.Вставить("price", Окр(СтрокаРабота.Цена, 4, РежимОкругления.Окр15как20));
	стЗапись.Вставить("quantity", СтрокаРабота.Коэффициент); // время выполнения
	стЗапись.Вставить("discount", -Окр(СтрокаРабота.СуммаСкидки, 4, РежимОкругления.Окр15как20));	
	стЗапись.Вставить("sum", Окр(СтрокаРабота.СуммаВсего, 4, РежимОкругления.Окр15как20));
	стЗапись.Вставить("status", 0);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки Работы " + стЗапись.name + " в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ДанныеТовара(СтрокаТовар, purchase_id, ЭтоВыгрузка = Истина)
