			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 9);	
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.GEELY Тогда // Geely
			КодОтказа = Событие.ПричинаОтмены.КодДжили;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 46);	
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.BELGEE Тогда // Belgee
			КодОтказа = Событие.ПричинаОтмены.КодBelgee;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 46);	
			КонецЕсли;
			
		ИначеЕсли (Марка = Справочники.Марка.CHERY Или Марка = Справочники.Марка.TENET
			Или Марка = Справочники.Марка.TENET_Plus) Тогда // CHERY или TENET или TENET_Plus
			КодОтказа = Событие.ПричинаОтмены.КодChery;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 9);	
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.VGV Тогда // VGV
			КодОтказа = Событие.ПричинаОтмены.КодVGV;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 44);
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.HAVAL Или Марка = Справочники.Марка.GREAT_WALL Тогда // HAVAL
			КодОтказа = Событие.ПричинаОтмены.КодHaval;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 45);
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.SOLLERS Тогда // SOLLERS
			КодОтказа = Событие.ПричинаОтмены.КодSollers;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("cancel_reason_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("cancel_reason_id", 48);	
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.HONGQI Тогда // HONGQI
			КодОтказа = Событие.ПричинаОтмены.КодHongqi;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("cancel_reason_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("cancel_reason_id", 9);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные завершенного события для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ЗаверщитьЗапланированноеСобытие(УзелОбмена, Событие, code)
	мСобытияПлан = НайтиОбъекты(УзелОбмена, "/api/nearest-contact", code);
	Если мСобытияПлан = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	nearest_contact_id = ПолучитьИдентификатор(мСобытияПлан);
	Если nearest_contact_id = 0 Тогда
		Возврат Истина;
	КонецЕсли;
				
	стЗапись = Новый Структура();	
	стЗапись.Вставить("closed", Формат(Событие.ДатаОкончания, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("closed_message", Событие.Результат);	
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();		
	Исключение
		Сообщить("Не удалось записать JSON-данные запланированного события для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат Ложь;
	КонецПопытки;	
	
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
		ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);	
		ЗапросHTTP.АдресРесурса = "/api/nearest-contact/" + Формат(nearest_contact_id, "ЧГ=0,0");
		КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
		Если КодСостояния < 300 Тогда
			Возврат Истина;
		Иначе
			Сообщить("Не удалось завершить запланированное событие " + Строка(Событие), СтатусСообщения.Внимание);
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

Процедура ДобавитьПричинуВОтмененныеКонтракты(УзелОбмена, Объект, СобытиеСсылка)
	Если УзелОбмена.МаркаАвтомобиля <> Справочники.Марка.CHANGAN Тогда
		Возврат;		
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		Если Объект.Количество() > 0 Тогда
			стОбъект = Объект[0];		
		Иначе
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		стОбъект = Объект;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	КодПричины = Неопределено;
	Если стОбъект.Свойство("cancel_reason_id", КодПричины) Тогда
		Если ТипЗнч(КодПричины) = Тип("Число") Тогда
			Если КодПричины > 0 Тогда
				КодПричиныОтказа = КодПричины;
			Иначе
				КодПричиныОтказа = 59; // Прочее
			КонецЕсли;
		Иначе
			КодПричиныОтказа = 35; // Передумал покупать
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	мКонтракты = Новый Массив();
	мСобытия = стОбъект.events;
	Для Каждого стСобытие Из мСобытия Цикл
		Если Не стСобытие.Свойство("event_type") И стСобытие.Свойство("status") 
			И стСобытие.Свойство("id") И стСобытие.Свойство("code") Тогда
			Продолжить;
		КонецЕсли;
		
		Если стСобытие.event_type = "contract" И стСобытие.status = "canceled" Тогда
			НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
			ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
			ЗапросHTTP.АдресРесурса = "/api/event/" + Формат(стСобытие.id, "ЧГ=0,0");
			ТелоЗапроса = "{""result_id"":" + Формат(КодПричиныОтказа, "ЧГ=0,0") + "}";
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат;			
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке причины отказа в контракт на портале Автодилер";
					ЗаголовокПисьма = "Заказ на автомобиль " + стСобытие.code;
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", СобытиеСсылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат;
				
			Иначе
				ЗаголовокПисьма = "Добавление причины отказа для Заказа на автомобиль " + стСобытие.code;
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Сообщить(ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке,  СтатусСообщения.Важное);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВыгрузитьСобытие(УзелОбмена, Событие)
	manager_id = 0;
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	Продавец = Событие.Продавец;
	мзИдентификаторыDSF.ОбъектАльфаАвто = Продавец;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда
		МаркаАвтомобиля = УзелОбмена.МаркаАвтомобиля;
		Если МаркаАвтомобиля = Справочники.Марка.UAZ Тогда
			manager_id = мзИдентификаторыDSF.DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FORD Тогда
			manager_id = мзИдентификаторыDSF.FordDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GEELY Тогда
			manager_id = мзИдентификаторыDSF.GeelyDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.BELGEE Тогда
			manager_id = мзИдентификаторыDSF.BelgeeDSF_id;
						
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.EXEED Тогда
			manager_id = мзИдентификаторыDSF.ExeedDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHANGAN Тогда
			manager_id = мзИдентификаторыDSF.ChanganDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ Тогда
			manager_id = мзИдентификаторыDSF.VAZ_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GAC Тогда
			manager_id = мзИдентификаторыDSF.GAC_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.OMODA Тогда
			manager_id = мзИдентификаторыDSF.OmodaJaecooDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JAECOO Тогда
			manager_id = мзИдентификаторыDSF.JaecooDSF_id;
			
		ИначеЕсли (МаркаАвтомобиля = Справочники.Марка.CHERY Или МаркаАвтомобиля = Справочники.Марка.TENET
			Или МаркаАвтомобиля = Справочники.Марка.TENET_Plus) Тогда
			manager_id = мзИдентификаторыDSF.CheryDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.VGV Тогда
			manager_id = мзИдентификаторыDSF.VGV_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HAVAL Тогда
			manager_id = мзИдентификаторыDSF.HavalDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.SOLLERS Тогда
			manager_id = мзИдентификаторыDSF.SollersDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HONGQI Тогда
			manager_id = мзИдентификаторыDSF.HongqiDSF_id;
			
		//ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
		//	manager_id = мзИдентификаторыDSF.FiatDSF_id;
		//ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
		//	manager_id = мзИдентификаторыDSF.JeepDSF_id;
		КонецЕсли;
	КонецЕсли;
	
	Если manager_id = 0 Тогда
		manager_id = ВыгрузитьСотрудника(УзелОбмена, Продавец);
		Если manager_id = 0 Тогда
			#Если Клиент Тогда
			Сообщить("С порталом Автодилер не удалось синхронизировать сотрудника " + Продавец.Наименование + ". Выгрузка события невозможна!!!", СтатусСообщения.Внимание);						
			#КонецЕсли
			Возврат 0;
		КонецЕсли;	
	КонецЕсли;
	
	code = СокрЛП(Событие.ДокументОснование.Номер);
	мРабочиеЛисты = НайтиОбъекты(УзелОбмена, "/api/worksheet", code);
	Если мРабочиеЛисты = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	worksheet_id = ПолучитьИдентификатор(мРабочиеЛисты);
	Если worksheet_id = 0 Тогда
		Сообщить("Для события " + Строка(Событие) + " не выгружен рабочий лист!", СтатусСообщения.Важное);
		Возврат -422;
	КонецЕсли;
	
	мПотребности = НайтиОбъекты(УзелОбмена, "/api/need", code);
	Если мПотребности = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	car_id = ПолучитьИдентификатор(мПотребности);
	// 28.09.2022 этот код через несколько месяцев можно удалить
	Если car_id = 0 Тогда
		code = Формат(Событие.ДокументОснование.Дата, "ДФ=""г""") + code;
		мПотребности = НайтиОбъекты(УзелОбмена, "/api/need", code);
		Если мПотребности = Неопределено Тогда
			Возврат 0;
		КонецЕсли;
		car_id = ПолучитьИдентификатор(мПотребности);
	КонецЕсли;
	
	Если car_id = 0 Тогда
		Сообщить("Для события " + Строка(Событие) + " не выгружен автомобиль-потребность!", СтатусСообщения.Важное);
		Возврат -422;
	КонецЕсли;
	
	Завершено = Ложь;
	Если Событие.Состояние = Перечисления.СостоянияСобытий.Запланировано Тогда
		АдресРесурса = "/api/nearest-contact";
		Завершено = Ложь;
		
	Иначе
		АдресРесурса = "/api/event";
		Завершено = Истина;
	КонецЕсли;
	
	code = Формат(Событие.Дата, "ДФ=""г""") + СокрЛП(Событие.Номер);
	мСобытия = НайтиОбъекты(УзелОбмена, АдресРесурса, code);
	Если мСобытия = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	event_id = ПолучитьИдентификатор(мСобытия);		
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если event_id > 0 Тогда
		Если Завершено Тогда
			ТелоЗапроса = ДанныеЗавершенногоСобытия(Событие, manager_id, worksheet_id, car_id, Ложь);
		Иначе
			ТелоЗапроса = ДанныеЗапланированногоСобытия(Событие, worksheet_id, Ложь);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = АдресРесурса + "/" + Формат(event_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат event_id;			
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных события на портале Автодилер";
					ЗаголовокПисьма = "Событие " + Строка(Событие);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", Событие.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		Если Завершено Тогда
			Если Не ЗаверщитьЗапланированноеСобытие(УзелОбмена, Событие, code) Тогда
				Возврат 0;
			КонецЕсли;
			ТелоЗапроса = ДанныеЗавершенногоСобытия(Событие, manager_id, worksheet_id, car_id);
			//Если Событие.ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля Тогда
			//	ДобавитьПричинуВОтмененныеКонтракты(УзелОбмена, мРабочиеЛисты, Событие.Ссылка);
			//КонецЕсли;
			
		Иначе
			ТелоЗапроса = ДанныеЗапланированногоСобытия(Событие, worksheet_id);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда			
			ЗапросHTTP.АдресРесурса = АдресРесурса;
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(Событие));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных события на портал Автодилер";
					ЗаголовокПисьма = "Событие " + Строка(Событие);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", Событие.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
				
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;	
КонецФункции

//// Заказы на автомобиль (Контракты)
Функция ДанныеКонтракта(ЗаказНаАвтомобиль, manager_id, worksheet_id, car_id, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", Формат(ЗаказНаАвтомобиль.Дата, "ДФ=""Кг""") + СокрЛП(ЗаказНаАвтомобиль.Номер));
		стЗапись.Вставить("event_type", "contract");
		стЗапись.Вставить("worksheet_id", worksheet_id);
		стЗапись.Вставить("car_id", car_id);
	КонецЕсли;
	
	стЗапись.Вставить("manager_id", manager_id);
	стЗапись.Вставить("occurred", Формат(ЗаказНаАвтомобиль.Дата, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("scheduled", Формат(ЗаказНаАвтомобиль.Дата - 1800, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("comment", ЗаказНаАвтомобиль.Комментарий);		
	
	РабочийЛист = ЗаказНаАвтомобиль.ДокументОснование;
	Марка = РабочийЛист.Модель.Марка;
	Если РабочийЛист.Статус = Справочники.СтатусыРабочегоЛиста.Отказ Тогда
		Если Марка = Справочники.Марка.ESTEO Или Марка = Справочники.Марка.EXEED Тогда
			КодОтказа = РабочийЛист.ПричинаОтказа.КодЭксид;
			Если КодОтказа > 0 И РабочийЛист.ПричинаОтказа.ДляКонтракта Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 59);	
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.CHANGAN Тогда
			КодОтказа = РабочийЛист.ПричинаОтказа.КодЧанган;
			Если КодОтказа > 0 И РабочийЛист.ПричинаОтказа.ДляКонтракта Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 59);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные контракта для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ОбновитьКонтрагента(УзелОбмена, Контрагент, СписокТелефонов, client_id, ДокументСсылка)
	ТелоЗапроса = ДанныеКлиента(Контрагент, СписокТелефонов, УзелОбмена.МаркаАвтомобиля, Ложь,, Ложь);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
		ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
		ЗапросHTTP.АдресРесурса = "/api/client/" + Формат(client_id, "ЧГ=0,0");
		КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
		Если КодСостояния < 300 Тогда
			Возврат Истина;			
			
		ИначеЕсли КодСостояния = 422 Тогда
			СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
			Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
				ТемаПисьма = "Ошибка при оформлении контракта на портале Автодилер";
				ЗаголовокПисьма = Строка(ДокументСсылка) + Символы.ПС + "Контрагент " + Строка(Контрагент);
				ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
				
				стДанныеСообщения = Новый Структура();
				стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
				стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
				стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
				стДанныеСообщения.Вставить("ДокументСсылка", ДокументСсылка);
				ОтправитьСообщениеОбОшибке(стДанныеСообщения);
			КонецЕсли;				
			Возврат Ложь;
			
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

Функция ОбновитьПотребность(УзелОбмена, VIN, car_id, ДокументСсылка)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/need/" + Формат(car_id, "ЧГ=0,0");
	ТелоЗапроса = "{""vin"":""" + VIN + """}";
	КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
	Если КодСостояния < 300 Тогда
		Возврат Истина;			
		
	ИначеЕсли КодСостояния = 422 Тогда
		СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
		Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			ТемаПисьма = "Ошибка при оформлении контракта на портале Автодилер";
			ЗаголовокПисьма = Строка(ДокументСсылка) + Символы.ПС + "VIN " + VIN;
			ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
			
			стДанныеСообщения = Новый Структура();
			стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
			стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
			стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
			стДанныеСообщения.Вставить("ДокументСсылка", ДокументСсылка);
			ОтправитьСообщениеОбОшибке(стДанныеСообщения);
		КонецЕсли;				
		Возврат Ложь;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция ОтменитьКонтракт(УзелОбмена, ЗаказНаАвтомобиль)
	АдресРесурса = "/api/event";
	code = Формат(ЗаказНаАвтомобиль.Дата, "ДФ=""Кг""") + СокрЛП(ЗаказНаАвтомобиль.Номер);
	мСобытия = НайтиОбъекты(УзелОбмена, АдресРесурса, code);
	Если мСобытия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	event_id = ПолучитьИдентификатор(мСобытия);		
	
	Если event_id > 0 Тогда
		НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
		ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
		МаркаАвтомобиля = УзелОбмена.МаркаАвтомобиля;
		Если МаркаАвтомобиля = Справочники.Марка.CHANGAN Тогда
			ТелоЗапроса = "{""result_id"":35,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.UAZ Тогда
			ТелоЗапроса = "{""result_id"":25,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ Тогда
			ТелоЗапроса = "{""result_id"":9,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GAC Тогда
			ТелоЗапроса = "{""result_id"":9,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JAECOO Или МаркаАвтомобиля = Справочники.Марка.OMODA Тогда
			ТелоЗапроса = "{""result_id"":9,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.VGV Тогда
			ТелоЗапроса = "{""result_id"":44,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GEELY Тогда
			ТелоЗапроса = "{""result_id"":43,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.BELGEE Тогда
			ТелоЗапроса = "{""result_id"":43,""status"":""canceled""}";
			
		ИначеЕсли (МаркаАвтомобиля = Справочники.Марка.CHERY Или МаркаАвтомобиля = Справочники.Марка.TENET
			Или МаркаАвтомобиля = Справочники.Марка.TENET_Plus) Тогда
			ТелоЗапроса = "{""result_id"":9,""status"":""canceled""}";
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HAVAL Тогда
			ТелоЗапроса = "{""result_id"":45,""status"":""canceled""}";
			
		Иначе
			ТелоЗапроса = "{""status"":""canceled""}";		
		КонецЕсли;
		ЗапросHTTP.АдресРесурса = АдресРесурса + "/" + Формат(event_id, "ЧГ=0,0");
		КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
		Если КодСостояния < 300 Тогда
			Возврат event_id;			
			
		ИначеЕсли КодСостояния = 422 Тогда
			СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
			Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
				ТемаПисьма = "Ошибка при отмене контракта на портале Автодилер";
				ЗаголовокПисьма = "Контракт " + Строка(ЗаказНаАвтомобиль);
				ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
				
				стДанныеСообщения = Новый Структура();
				стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
				стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
				стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
				стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаАвтомобиль.Ссылка);
				ОтправитьСообщениеОбОшибке(стДанныеСообщения);
			КонецЕсли;				
			Возврат -422;
			
		Иначе
			Возврат 0;
		КонецЕсли;
		
	Иначе
		Сообщить("Для " + Строка(ЗаказНаАвтомобиль) + " не выгружен Контракт, отмена невозможна!", СтатусСообщения.Важное);
		Возврат -422;
	КонецЕсли;	
КонецФункции

Функция ВыгрузитьКонтракт(УзелОбмена, ЗаказНаАвтомобиль)
	ЭтоОтмена = ЗаказНаАвтомобиль.ХозОперация = Справочники.ХозОперации.ЗаказНаАвтомобильОтмена И ТипЗнч(ЗаказНаАвтомобиль.ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль");
	Если ЭтоОтмена Тогда
		Возврат ОтменитьКонтракт(УзелОбмена, ЗаказНаАвтомобиль.ДокументОснование)
	КонецЕсли;
		
	manager_id = 0;
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	Продавец = ЗаказНаАвтомобиль.Менеджер;
	мзИдентификаторыDSF.ОбъектАльфаАвто = Продавец;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда
		МаркаАвтомобиля = УзелОбмена.МаркаАвтомобиля;
		Если МаркаАвтомобиля = Справочники.Марка.UAZ Тогда
			manager_id = мзИдентификаторыDSF.DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FORD Тогда
			manager_id = мзИдентификаторыDSF.FordDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GEELY Тогда
			manager_id = мзИдентификаторыDSF.GeelyDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.BELGEE Тогда
			manager_id = мзИдентификаторыDSF.BelgeeDSF_id;			
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.EXEED Тогда
			manager_id = мзИдентификаторыDSF.ExeedDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHANGAN Тогда
			manager_id = мзИдентификаторыDSF.ChanganDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ Тогда
			manager_id = мзИдентификаторыDSF.VAZ_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GAC Тогда
			manager_id = мзИдентификаторыDSF.GAC_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.OMODA Тогда
			manager_id = мзИдентификаторыDSF.OmodaJaecooDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JAECOO Тогда
			manager_id = мзИдентификаторыDSF.JaecooDSF_id;
			
		ИначеЕсли (МаркаАвтомобиля = Справочники.Марка.CHERY Или МаркаАвтомобиля = Справочники.Марка.TENET
			Или МаркаАвтомобиля = Справочники.Марка.TENET_Plus) Тогда
			manager_id = мзИдентификаторыDSF.CheryDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.VGV Тогда
			manager_id = мзИдентификаторыDSF.VGV_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HAVAL Тогда
			manager_id = мзИдентификаторыDSF.HavalDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.SOLLERS Тогда
			manager_id = мзИдентификаторыDSF.SollersDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HONGQI Тогда
			manager_id = мзИдентификаторыDSF.HongqiDSF_id;
			
		//ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
		//	manager_id = мзИдентификаторыDSF.FiatDSF_id;
		//ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
		//	manager_id = мзИдентификаторыDSF.JeepDSF_id;
		КонецЕсли;
	КонецЕсли;
	
	Если manager_id = 0 Тогда
		manager_id = ВыгрузитьСотрудника(УзелОбмена, Продавец);
		Если manager_id = 0 Тогда
			#Если Клиент Тогда
			Сообщить("С порталом Автодилер не удалось синхронизировать сотрудника " + Продавец.Наименование + ". Выгрузка контракта невозможна!!!", СтатусСообщения.Внимание);						
			#КонецЕсли
			Возврат 0;
		КонецЕсли;	
	КонецЕсли;
	
	code = СокрЛП(ЗаказНаАвтомобиль.ДокументОснование.Номер);
	мРабочиеЛисты = НайтиОбъекты(УзелОбмена, "/api/worksheet", code);
	Если мРабочиеЛисты = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	worksheet_id = ПолучитьИдентификатор(мРабочиеЛисты);
	Если worksheet_id = 0 Тогда
		Сообщить("Для контракта " + Строка(ЗаказНаАвтомобиль) + " не выгружен рабочий лист!", СтатусСообщения.Важное);
		Возврат -422;
	КонецЕсли;
	
	мКлиент = НайтиОбъекты(УзелОбмена, "/api/client", code);
	Если мКлиент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	client_id = ПолучитьИдентификатор(мКлиент);
	Если client_id = 0 Тогда
		Сообщить("Для рабочего листа " + code + " не выгружен контрагент, выгрузка Контракта невозможна!", СтатусСообщения.Важное);
		Возврат -422;
	КонецЕсли;
	
	//Если Не ОбновитьКонтрагента(УзелОбмена, ЗаказНаАвтомобиль.Заказчик, client_id, ЗаказНаАвтомобиль.Ссылка) Тогда
	//	Возврат -422;
	//КонецЕсли;
	
	мПотребности = НайтиОбъекты(УзелОбмена, "/api/need", code);
	Если мПотребности = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	car_id = ПолучитьИдентификатор(мПотребности);
	// 28.09.2022 этот код через несколько месяцев можно удалить
	Если car_id = 0 Тогда
		мПотребности = НайтиОбъекты(УзелОбмена, "/api/need", Формат(ЗаказНаАвтомобиль.ДокументОснование.Дата, "ДФ=""г""") + code);
		Если мПотребности = Неопределено Тогда
			Возврат 0;
		КонецЕсли;
		car_id = ПолучитьИдентификатор(мПотребности);
	КонецЕсли;
	
	Если car_id = 0 Тогда
		Сообщить("Для контракта " + Строка(ЗаказНаАвтомобиль) + " не выгружен автомобиль-потребность!", СтатусСообщения.Важное);
		Возврат -422;
	КонецЕсли;
	
	Если Не ОбновитьПотребность(УзелОбмена, ЗаказНаАвтомобиль.Автомобиль.VIN, car_id, ЗаказНаАвтомобиль.Ссылка) Тогда
		Возврат -422;
	КонецЕсли;
		
	АдресРесурса = "/api/event";
	code = Формат(ЗаказНаАвтомобиль.Дата, "ДФ=""Кг""") + СокрЛП(ЗаказНаАвтомобиль.Номер);
	мСобытия = НайтиОбъекты(УзелОбмена, АдресРесурса, code);
	Если мСобытия = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	event_id = ПолучитьИдентификатор(мСобытия);		
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если event_id > 0 Тогда
		ТелоЗапроса = ДанныеКонтракта(ЗаказНаАвтомобиль, manager_id, worksheet_id, car_id, Ложь);				
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = АдресРесурса + "/" + Формат(event_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат event_id;			
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных контракта на портале Автодилер";
					ЗаголовокПисьма = "Контракт " + Строка(ЗаказНаАвтомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаАвтомобиль.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеКонтракта(ЗаказНаАвтомобиль, manager_id, worksheet_id, car_id);	
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда			
			ЗапросHTTP.АдресРесурса = АдресРесурса;
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(ЗаказНаАвтомобиль));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных контракта на портал Автодилер";
					ЗаголовокПисьма = "Контракт " + Строка(ЗаказНаАвтомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаАвтомобиль.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
				
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;	
КонецФункции

Процедура ВыгрузкаАвтодилерСобытия(УзелОбмена)
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	
	мВыдачаИлиОтказ = Новый Массив();
	мВыдачаИлиОтказ.Добавить(Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
	мВыдачаИлиОтказ.Добавить(Перечисления.ВидыСобытий.ОтказОтАвтомобиля);
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    Событие = ВыборкаИзменений.Получить();
		Если ТипЗнч(Событие) = Тип("ДокументОбъект.Событие") И мВыдачаИлиОтказ.Найти(Событие.ВидСобытия) = Неопределено Тогда
			Если Событие.ВидСобытия = Перечисления.ВидыСобытий.ТестДрайв Тогда
				ВыгрузитьКлиентаТестДрайв(УзелОбмена, Событие);
			КонецЕсли;
			event_id = ВыгрузитьСобытие(УзелОбмена, Событие);
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если event_id > 0 Или event_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Событие);
		КонецЕсли;
	КонецЦикла;
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    Событие = ВыборкаИзменений.Получить();
		Если ТипЗнч(Событие) = Тип("ДокументОбъект.ЗаказНаАвтомобиль") И Событие.ХозОперация = Справочники.ХозОперации.ЗаказНаАвтомобильОтмена Тогда
			event_id = ВыгрузитьКонтракт(УзелОбмена, Событие);			
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если event_id > 0 Или event_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Событие);
		КонецЕсли;
	КонецЦикла;
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    Событие = ВыборкаИзменений.Получить();
		Если ТипЗнч(Событие) = Тип("ДокументОбъект.ЗаказНаАвтомобиль") И Событие.ХозОперация = Справочники.ХозОперации.ЗаказНаАвтомобиль Тогда
			event_id = ВыгрузитьКонтракт(УзелОбмена, Событие);			
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если event_id > 0 Или event_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Событие);
		КонецЕсли;
	КонецЦикла;
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    Событие = ВыборкаИзменений.Получить();
		Если ТипЗнч(Событие) = Тип("ДокументОбъект.Событие") И мВыдачаИлиОтказ.Найти(Событие.ВидСобытия) <> Неопределено Тогда
			event_id = ВыгрузитьСобытие(УзелОбмена, Событие);
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если event_id > 0 Или event_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Событие);
		КонецЕсли;
	КонецЦикла;
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

//// Выгрузка трафика при реализации непрофильного автомобиля
/////////////////////////////////////////////////////////////////////

Процедура ВыгрузитьТрафикДляВыдачиНепрофильного(Реализация) Экспорт
	Если Реализация.ПродажаБУАвто Или Не Реализация.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказСсылка = Документы.ЗаказНаАвтомобиль.ПустаяСсылка();
	ДокументОснование = Реализация.ДокументОснование;
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
			ЗаказСсылка = ДокументОснование;
			РабочийЛист = ЗаказСсылка.ДокументОснование;
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтгрузкаАвтомобиляБезРеализации") Тогда
			ЗаказСсылка = ДокументОснование.ДокументОснование;
			РабочийЛист = ЗаказСсылка.ДокументОснование;
		Иначе
			Возврат;
		КонецЕсли;
		
		Если обЗначениеНеЗаполнено(РабочийЛист) Тогда
			Возврат;
		ИначеЕсли ТипЗнч(РабочийЛист) <> Тип("ДокументСсылка.РабочийЛист") Тогда
			Возврат;
		КонецЕсли;
		
		УзелОбмена = НайтиУзелОбменаДляРабЛиста(РабочийЛист);
		Если ЗначениеЗаполнено(УзелОбмена) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;

	НепрофильныйАвтомобиль = РабочийЛист.Автомобиль;
	Если РабочийЛист.ТолькоБУ Или РабочийЛист.ВидАвтомобиля = Перечисления.ВидАвтомобиля.СобственныйПарк Тогда
		Возврат;
	ИначеЕсли РабочийЛист.Статус <> Справочники.СтатусыРабочегоЛиста.Продажа Тогда
		Возврат;
	ИначеЕсли обЗначениеНеЗаполнено(НепрофильныйАвтомобиль) Тогда
		Возврат;
	ИначеЕсли Реализация.Автомобили[0].Автомобиль <> НепрофильныйАвтомобиль Тогда
		Возврат;
	КонецЕсли;
	Модель = РабочийЛист.Модель;
	Если обЗначениеНеЗаполнено(Модель) Или Не Модель.ПринадлежитЭлементу(Справочники.Модели.АВТОМОБИЛИ_В_ПРОДАЖЕ) Тогда
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(ЗаказСсылка) Тогда
		Сообщить(Строка(Реализация) + ": нет Заказа на автомобиль, выгрузка Продажи непрофильного автомобиля не возможна!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	ПодразделениеПоступления = НайтиПодразделениеПоступления(НепрофильныйАвтомобиль);
	Если обЗначениеНеЗаполнено(ПодразделениеПоступления) Тогда
		Сообщить(Строка(НепрофильныйАвтомобиль) + ": не найдено Поступление нового автомобиля, выгрузка Продажи непрофильного автомобиля не возможна!", СтатусСообщения.Внимание);
		Возврат;
		
	//ИначеЕсли ПодразделениеПоступления = Реализация.ПодразделениеКомпании Тогда
	//	Возврат;
	
	Иначе
		ГруппаДляВыгрузки = ПодразделениеПоступления.Родитель;
		Если ГруппаДляВыгрузки = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
			Сообщить(Строка(НепрофильныйАвтомобиль) + ": в Поступлении указано неверное Подразделение, выгрузка Продажи непрофильного автомобиля не возможна!", СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;
		
		УзелОбменаДилера = НайтиУзелОбмена(ПодразделениеПоступления, Истина);
		Если обЗначениеНеЗаполнено(УзелОбменаДилера) Тогда
			Сообщить(Строка(ПодразделениеПоступления) + ": не найден Узел обмена для РЛ, выгрузка Продажи непрофильного автомобиля не возможна!", СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	мПодчиненные = КритерииОтбора.ПодчиненныеДокументы.Найти(РабочийЛист);
	мСобытия = Новый Массив();
	ВыдачаСсылка = Документы.Событие.ПустаяСсылка();
	Для Каждого ПодчиненныйСсылка Из мПодчиненные Цикл
		Если ТипЗнч(ПодчиненныйСсылка) = Тип("ДокументСсылка.Событие")
			И ПодчиненныйСсылка.Состояние = Перечисления.СостоянияСобытий.Завершено Тогда
			
			Если ПодчиненныйСсылка.ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля Тогда
				ВыдачаСсылка = ПодчиненныйСсылка;
			Иначе
				мСобытия.Добавить(ПодчиненныйСсылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если мСобытия.Количество() = 0 Тогда
		Сообщить(Строка(РабочийЛист) + ": нет завершенных Событий, выгрузка Продажи непрофильного автомобиля не возможна!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ВыдачаСсылка) Тогда
		Сообщить(Строка(РабочийЛист) + ": нет завершенной Выдачи автомобиля, выгрузка Продажи непрофильного автомобиля не возможна!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	Продавец = СМ_ФормированиеНовыхОбъектов.СлучайныйВыборСотрудника(ГруппаДляВыгрузки, Справочники.Должности.МенеджерОтделаПродажАвтомобилей, РабочийЛист.Дата);
	Если обЗначениеНеЗаполнено(Продавец) Тогда
		Сообщить(Строка(ГруппаДляВыгрузки) + ": в подразделении не найден МОП, выгрузка Продажи непрофильного автомобиля не возможна!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	worksheet_id = ВыгрузитьРабочийЛистНаПортал(УзелОбменаДилера, РабочийЛист.ПолучитьОбъект());
	Если worksheet_id = -422 Или worksheet_id = 0 Тогда
		Возврат;
	Иначе
		Сообщить("Вугрузка трафика CRM для непрофильного автомобиля:", СтатусСообщения.Информация);
		Сообщить(Строка(РабочийЛист) + ": выгружен.", СтатусСообщения.Информация);
	КонецЕсли;
	
	Для Каждого СобытиеСсылка Из мСобытия Цикл
		СобыиеОбъект = СобытиеСсылка.ПолучитьОбъект();
		СобыиеОбъект.Продавец = Продавец;
		event_id = ВыгрузитьСобытие(УзелОбменаДилера, СобыиеОбъект);
		Если event_id > 0 Тогда
			Сообщить(Строка(СобыиеОбъект) + ": выгружено.", СтатусСообщения.Информация);
		КонецЕсли;
	КонецЦикла;
	
	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	ЗаказОбъект.Менеджер = Продавец;
	event_id = ВыгрузитьКонтракт(УзелОбменаДилера, ЗаказОбъект);
	Если event_id > 0 Тогда
		Сообщить(Строка(ЗаказОбъект) + ": выгружен.", СтатусСообщения.Информация);
	КонецЕсли;
	
	ВыдачаОбъект = ВыдачаСсылка.ПолучитьОбъект();
	ВыдачаОбъект.Продавец = Продавец;
	event_id = ВыгрузитьСобытие(УзелОбменаДилера, ВыдачаОбъект);
	Если event_id > 0 Тогда
		Сообщить(Строка(ВыдачаОбъект) + ": выгружена.", СтатусСообщения.Информация);
	КонецЕсли;
КонецПроцедуры

Функция НайтиПодразделениеПоступления(Автомобиль)
	ЗапросПоступление = Новый Запрос();
	ЗапросПоступление.УстановитьПараметр("Автомобиль", Автомобиль);
	//ЗапросПоступление.УстановитьПараметр("ПереходВСобственность", Справочники.ХозОперации.ПереходВСобственностьАвтомобилей);
	ЗапросПоступление.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	|	И ПоступлениеАвтомобилейАвтомобили.АвтомобильНовый";
	
	ВыборкаПоступление = ЗапросПоступление.Выполнить().Выбрать();
	Если ВыборкаПоступление.Следующий() Тогда
		Возврат ВыборкаПоступление.ПодразделениеКомпании;
	Иначе
		Возврат Справочники.ПодразделенияКомпании.ПустаяСсылка();
	КонецЕсли;
КонецФункции
	
Функция НайтиУзелОбмена(ПодразделениеПоступления, ДляРабЛиста)
	ЗапросУзелОбмена = Новый Запрос();
	ЗапросУзелОбмена.УстановитьПараметр("Подразделение", ПодразделениеПоступления);
	ЗапросУзелОбмена.Текст =
	"ВЫБРАТЬ
	|	ОбменСАвтодилер.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.ОбменСАвтодилер КАК ОбменСАвтодилер
	|ГДЕ
	|	ОбменСАвтодилер.Подразделение = &Подразделение";
	
	Если ДляРабЛиста Тогда
		ЗапросУзелОбмена.Текст = ЗапросУзелОбмена.Текст + " И ОбменСАвтодилер.Код ПОДОБНО ""%РабЛист""";
	Иначе
		ЗапросУзелОбмена.Текст = ЗапросУзелОбмена.Текст + " И ОбменСАвтодилер.Код ПОДОБНО ""%Событие""";
	КонецЕсли;
	
	ВыборкаУзелОбмена = ЗапросУзелОбмена.Выполнить().Выбрать();
	Если ВыборкаУзелОбмена.Следующий() Тогда
		Возврат ВыборкаУзелОбмена.Ссылка;
	Иначе
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
КонецФункции

//// Синхронная выгрузка документов отдела продаж
/////////////////////////////////////////////////////////////////////

Функция ВыгрузитьРабочийЛистНаПортал(УзелОбмена, РабочийЛист)
	code = СокрЛП(РабочийЛист.Номер);
	мРабочийЛист = НайтиОбъекты(УзелОбмена, "/api/worksheet", code);
	Если мРабочийЛист = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	worksheet_id = ПолучитьИдентификатор(мРабочийЛист);		
	
	client_id = ВыгрузитьКлиентаПродажи(УзелОбмена, РабочийЛист, worksheet_id);
	Если client_id = -422 Или client_id = 0 Тогда
		Возврат client_id;
	КонецЕсли;
	
	worksheet_id = ВыгрузитьРабочийЛист(УзелОбмена, РабочийЛист, client_id, worksheet_id);
	Если worksheet_id = -422 Или worksheet_id = 0 Тогда
		Возврат worksheet_id;
	КонецЕсли;
	
	car_id = ВыгрузитьПотребность(УзелОбмена, РабочийЛист, worksheet_id);
	Если car_id = -422 Или car_id = 0 Тогда
		Возврат car_id;
	КонецЕсли;
	
	Возврат worksheet_id;
КонецФункции

Процедура ВыгрузитьРабочийЛистСинхронно(РабЛистОбъект) Экспорт
	УзелОбмена = НайтиУзелОбменаДляРабЛиста(РабЛистОбъект);
	
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		worksheet_id = ВыгрузитьРабочийЛистНаПортал(УзелОбмена, РабЛистОбъект);
		Если worksheet_id > 0 Тогда
			Сообщить("Выгружен " + Строка(РабЛистОбъект), СтатусСообщения.Информация);
				
		ИначеЕсли worksheet_id = 0 Тогда
			Сообщить("Не удалось выгрузить " + Строка(РабЛистОбъект), СтатусСообщения.Внимание);
			Сообщить("из-за проблем на портале. Повторите попытку в другое время.", СтатусСообщения.Внимание);
			
		Иначе
			Сообщить("Портал обнаружил ошибки в данных " + Строка(РабЛистОбъект), СтатусСообщения.Внимание);
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузитьСобытиеСинхронно(СобытиеОбъект) Экспорт
	УзелОбмена = НайтиУзелОбменаДляСобытия(СобытиеОбъект);
	
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		event_id = ВыгрузитьСобытие(УзелОбмена, СобытиеОбъект);
		Если event_id > 0 Тогда
			Сообщить("Выгружено " + Строка(СобытиеОбъект), СтатусСообщения.Информация);
			
		ИначеЕсли event_id = 0 Тогда
			Сообщить("Не удалось выгрузить " + Строка(СобытиеОбъект), СтатусСообщения.Внимание);
			Сообщить("из-за проблем на портале. Повторите попытку в другое время.", СтатусСообщения.Внимание);
			
		Иначе
			Сообщить("Портал обнаружил ошибки в данных " + Строка(СобытиеОбъект), СтатусСообщения.Внимание);
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузитьКонтрактСинхронно(ЗаказОбъект) Экспорт
	УзелОбмена = НайтиУзелОбменаДляЗаказаНаАвтомобиль(ЗаказОбъект);

	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		event_id = ВыгрузитьКонтракт(УзелОбмена, ЗаказОбъект);
		Если event_id > 0 Тогда
			Сообщить("Выгружен " + Строка(ЗаказОбъект), СтатусСообщения.Информация);
			
		ИначеЕсли event_id = 0 Тогда
			Сообщить("Не удалось выгрузить " + Строка(ЗаказОбъект), СтатусСообщения.Внимание);
			Сообщить("из-за проблем на портале. Повторите попытку в другое время.", СтатусСообщения.Внимание);
			
		Иначе
			Сообщить("Портал обнаружил ошибки в данных " + Строка(ЗаказОбъект), СтатусСообщения.Внимание);
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

