	//	Возврат -422;
	//КонецЕсли;
		
	Модель = РабочийЛист.Модель;
	Если обЗначениеНеЗаполнено(Модель) Тогда
		Возврат -422;
	КонецЕсли;
	
	МаркаАвтомобиля = Модель.Марка;
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда
		КодМодели = мзИдентификаторыDSF.DSF_id; 
		Если УзелОбмена.МаркаАвтомобиля = Справочники.Марка.GEELY И Модель.Марка = Справочники.Марка.BELGEE Тогда
			КодМодели = мзИдентификаторыDSF.BelgeeDSF_id; //Belgee у дилера Geely, якобы это временно)))
		КонецЕсли;
		
	Иначе
		#Если Клиент Тогда
		Сообщить("С порталом Автодилер не синхронизирована модель " + Модель + ". Выгрузка автомобиля-потребности невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат 0;
	КонецЕсли;
	
	КодАлиаса = 0;
	Если МаркаАвтомобиля = Справочники.Марка.FORD Тогда
		КодБренда = 6; // Ford
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.UAZ Тогда
		КодБренда = 134; // УАЗ
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GEELY Тогда
		КодБренда = 46; // Geely
		КодАлиаса = мзИдентификаторыDSF.GeelyDSF_id;
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.BELGEE Тогда
		КодБренда = 2710; // BELGEE
		КодАлиаса = мзИдентификаторыDSF.BelgeeDSF_id;
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.KNEWSTAR Тогда
		КодБренда = 2771; // KNEWSTAR
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.ESTEO Тогда
		КодБренда = 2796; // ESTEO
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.EXEED Тогда
		КодБренда = 2082; // EXEED
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHANGAN Тогда
		КодБренда = 140; // CHANGAN
		КодАлиаса = мзИдентификаторыDSF.ChanganDSF_id;
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ Тогда
		КодБренда = 125; // LADA
		КодАлиаса = мзИдентификаторыDSF.VAZ_DSF_id;
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GAC Тогда
		КодБренда = 2058; // GAC
		КодАлиаса = мзИдентификаторыDSF.GAC_DSF_id;
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.OMODA Тогда
		КодБренда = 2643; // OMODA
		КодАлиаса = мзИдентификаторыDSF.OmodaJaecooDSF_id;
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JAECOO Тогда
		КодБренда = 2692; // JAECOO
		КодАлиаса = мзИдентификаторыDSF.OmodaJaecooDSF_id;
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JELAND Тогда
		КодБренда = 2812; // JELAND
		КодАлиаса = мзИдентификаторыDSF.OmodaJaecooDSF_id;
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHERY Тогда
