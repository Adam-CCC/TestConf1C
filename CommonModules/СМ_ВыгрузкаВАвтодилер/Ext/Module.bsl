			Возврат 0;
		КонецЕсли;
		car_id = ПолучитьИдентификатор(мАвтомобиль);
	КонецЕсли;
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если car_id > 0 Тогда
		ТелоЗапроса = ДанныеПотребности(РабочийЛист, КодБренда, КодМодели, КодАлиаса, Ложь);
