//// Процедуры / функции для продажи автомобиля другого дилера УАЗ
/////////////////////////////////////////////////////////////////////

Функция ДанныеКонтрактаДругогоДилера(ЗаказНаАвтомобиль, ДатаРЛ, СтруктураКоды, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	Дата = ДатаРЛ + 1800;
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", Формат(Дата, "ДФ=""Кг""") + СокрЛП(ЗаказНаАвтомобиль.Номер));
		стЗапись.Вставить("event_type", "contract");
		стЗапись.Вставить("worksheet_id", СтруктураКоды.worksheet_id);
		стЗапись.Вставить("car_id", СтруктураКоды.car_id);
	КонецЕсли;
	
	стЗапись.Вставить("manager_id", СтруктураКоды.manager_id);
	стЗапись.Вставить("occurred", Формат(Дата, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("scheduled", Формат(Дата - 900, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("comment", ЗаказНаАвтомобиль.Комментарий);		
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные контракта для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ДанныеВыдачиДругогоДилера(Событие, ДатаРЛ, СтруктураКоды, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	Дата = ДатаРЛ + 3600;
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", Формат(Дата, "ДФ=""г""") + СокрЛП(Событие.Номер));
		стЗапись.Вставить("worksheet_id", СтруктураКоды.worksheet_id);
		стЗапись.Вставить("car_id", СтруктураКоды.car_id);
		стЗапись.Вставить("event_type", "issue");
	КонецЕсли;
	
	стЗапись.Вставить("manager_id", СтруктураКоды.manager_id);
	стЗапись.Вставить("scheduled", Формат(Дата - 600, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("occurred", Формат(Дата, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));;
	стЗапись.Вставить("comment", Лев(Событие.Результат, 1000));	
	
	Если Событие.Состояние = Перечисления.СостоянияСобытий.Отменено Тогда
		стЗапись.Вставить("status", "canceled");
	Иначе
		стЗапись.Вставить("status", "active");
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные завершенного события для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ВыгрузитьКонтрактДругогоДилера(УзелОбмена, мзПродажаЧужогоАвто)
	СтруктураВозврата = Новый Структура();
	ЗаказНаАвтомобиль = мзПродажаЧужогоАвто.ЗаказНаАвтомобиль;
	ЭтоОтмена = ЗаказНаАвтомобиль.ХозОперация = Справочники.ХозОперации.ЗаказНаАвтомобильОтмена И ТипЗнч(ЗаказНаАвтомобиль.ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль");
	Если ЭтоОтмена Тогда
		event_id = ОтменитьКонтракт(УзелОбмена, ЗаказНаАвтомобиль.ДокументОснование);
		СтруктураВозврата.Вставить("event_id", event_id);
		Возврат СтруктураВозврата;
	КонецЕсли;
		
	manager_id = 0;
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	Продавец = мзПродажаЧужогоАвто.РабочийЛистДилера.Менеджер;
	мзИдентификаторыDSF.ОбъектАльфаАвто = Продавец;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда
		МаркаАвтомобиля = УзелОбмена.МаркаАвтомобиля;
		Если МаркаАвтомобиля = Справочники.Марка.BELGEE Тогда
			МаркаАвтомобиля = Справочники.Марка.GEELY;
		КонецЕсли;
		
		Если МаркаАвтомобиля = Справочники.Марка.UAZ Тогда
			manager_id = мзИдентификаторыDSF.DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FORD Тогда
			manager_id = мзИдентификаторыDSF.FordDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GEELY Тогда
			manager_id = мзИдентификаторыDSF.GeelyDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.EXEED Тогда
			manager_id = мзИдентификаторыDSF.ExeedDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHANGAN Тогда
			manager_id = мзИдентификаторыDSF.ChanganDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ Тогда
			manager_id = мзИдентификаторыDSF.VAZ_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GAC Тогда
			manager_id = мзИдентификаторыDSF.GAC_DSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.OMODA Тогда
			manager_id = мзИдентификаторыDSF.OmodaJaecooDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JAECOO Тогда
			manager_id = мзИдентификаторыDSF.JaecooDSF_id;
			
		ИначеЕсли МаркаАвтомобиля = Справочники.Марка.VGV Тогда
			manager_id = мзИдентификаторыDSF.VGV_DSF_id;
		КонецЕсли;
	КонецЕсли;
	
	Если manager_id = 0 Тогда
		manager_id = ВыгрузитьСотрудника(УзелОбмена, Продавец);
		Если manager_id = 0 Тогда
			#Если Клиент Тогда
			Сообщить("С порталом Автодилер не удалось синхронизировать сотрудника " + Продавец.Наименование + ". Выгрузка контракта невозможна!!!", СтатусСообщения.Внимание);						
			#КонецЕсли
			СтруктураВозврата.Вставить("event_id", 0);
			Возврат СтруктураВозврата;
		Иначе
			СтруктураВозврата.Вставить("manager_id", manager_id);
		КонецЕсли;
		
	Иначе
		СтруктураВозврата.Вставить("manager_id", manager_id);
	КонецЕсли;
	
	code = СокрЛП(мзПродажаЧужогоАвто.РабочийЛистДилера.Номер);
	мРабочиеЛисты = НайтиОбъекты(УзелОбмена, "/api/worksheet", code);
	Если мРабочиеЛисты = Неопределено Тогда
		СтруктураВозврата.Вставить("event_id", 0);
		Возврат СтруктураВозврата;
	КонецЕсли;
	worksheet_id = ПолучитьИдентификатор(мРабочиеЛисты);
	Если worksheet_id = 0 Тогда
		Сообщить("Для контракта " + Строка(ЗаказНаАвтомобиль) + " не выгружен рабочий лист!", СтатусСообщения.Важное);
		СтруктураВозврата.Вставить("event_id", -422);
		Возврат СтруктураВозврата;
	Иначе
		СтруктураВозврата.Вставить("worksheet_id", worksheet_id);
	КонецЕсли;
	
	мКлиент = НайтиОбъекты(УзелОбмена, "/api/client", code);
	Если мКлиент = Неопределено Тогда
		СтруктураВозврата.Вставить("event_id", 0);
		Возврат СтруктураВозврата;
	КонецЕсли;	
	client_id = ПолучитьИдентификатор(мКлиент);
	//// 28.09.2022 этот код через несколько месяцев можно удалить
	//Если client_id = 0 Тогда
	//	мКлиент = НайтиОбъекты(УзелОбмена, "/api/client", Формат(ЗаказНаАвтомобиль.ДокументОснование.Дата, "ДФ=""г""") + code);
	//	Если мКлиент = Неопределено Тогда
	//		Возврат СтруктураВозврата.Вставить("event_id", 0);
	//	КонецЕсли;
	//	client_id = ПолучитьИдентификатор(мКлиент);
	//КонецЕсли;
	
	Если client_id = 0 Тогда
		Сообщить("Для рабочего листа " + code + " не выгружен контрагент, выгрузка Контракта невозможна!", СтатусСообщения.Важное);
		СтруктураВозврата.Вставить("event_id", -422);
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	//Если Не ОбновитьКонтрагента(УзелОбмена, ЗаказНаАвтомобиль.Заказчик, client_id, ЗаказНаАвтомобиль) Тогда
	//	СтруктураВозврата.Вставить("event_id", -422);
	//	Возврат СтруктураВозврата;
	//КонецЕсли;
	
	мПотребности = НайтиОбъекты(УзелОбмена, "/api/need", code);
	Если мПотребности = Неопределено Тогда
		СтруктураВозврата.Вставить("event_id", 0);
		Возврат СтруктураВозврата;
	КонецЕсли;
	car_id = ПолучитьИдентификатор(мПотребности);
	//// 28.09.2022 этот код через несколько месяцев можно удалить
	//Если car_id = 0 Тогда
	//	мПотребности = НайтиОбъекты(УзелОбмена, "/api/need", Формат(ЗаказНаАвтомобиль.ДокументОснование.Дата, "ДФ=""г""") + code);
	//	Если мПотребности = Неопределено Тогда
	//		Возврат СтруктураВозврата.Вставить("event_id", 0);
	//	КонецЕсли;
	//	car_id = ПолучитьИдентификатор(мПотребности);
	//КонецЕсли;
	
	Если car_id = 0 Тогда
		Сообщить("Для контракта " + Строка(ЗаказНаАвтомобиль) + " не выгружен автомобиль-потребность!", СтатусСообщения.Важное);
		СтруктураВозврата.Вставить("event_id", -422);
		Возврат СтруктураВозврата;
	Иначе
		СтруктураВозврата.Вставить("car_id", car_id);
	КонецЕсли;
	
	Если Не ОбновитьПотребность(УзелОбмена, ЗаказНаАвтомобиль.Автомобиль.VIN, car_id, ЗаказНаАвтомобиль) Тогда
		СтруктураВозврата.Вставить("event_id", -422);
		Возврат СтруктураВозврата;
	КонецЕсли;
		
	АдресРесурса = "/api/event";
	ДатаРЛ = мзПродажаЧужогоАвто.РабочийЛистДилера.Дата;
	code = Формат(ДатаРЛ, "ДФ=""Кг""") + СокрЛП(ЗаказНаАвтомобиль.Номер);
	мСобытия = НайтиОбъекты(УзелОбмена, АдресРесурса, code);
	Если мСобытия = Неопределено Тогда
		СтруктураВозврата.Вставить("event_id", 0);
		Возврат СтруктураВозврата;
	КонецЕсли;
	event_id = ПолучитьИдентификатор(мСобытия);		
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если event_id > 0 Тогда
		ТелоЗапроса = ДанныеКонтрактаДругогоДилера(ЗаказНаАвтомобиль, ДатаРЛ, СтруктураВозврата, Ложь);				
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = АдресРесурса + "/" + Формат(event_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				СтруктураВозврата.Вставить("event_id", event_id);
				Возврат СтруктураВозврата;
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных контракта на портале Автодилер";
					ЗаголовокПисьма = "Контракт " + Строка(ЗаказНаАвтомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаАвтомобиль.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				СтруктураВозврата.Вставить("event_id", -422);
				Возврат СтруктураВозврата;
				
			Иначе
				СтруктураВозврата.Вставить("event_id", 0);
				Возврат СтруктураВозврата;
			КонецЕсли;
			
		Иначе
			СтруктураВозврата.Вставить("event_id", 0);
			Возврат СтруктураВозврата;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеКонтрактаДругогоДилера(ЗаказНаАвтомобиль, ДатаРЛ, СтруктураВозврата);	
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда			
			ЗапросHTTP.АдресРесурса = АдресРесурса;
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(ЗаказНаАвтомобиль));
			Если стРезультат.id > 0 Тогда
				СтруктураВозврата.Вставить("event_id", стРезультат.id);
				Возврат СтруктураВозврата;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных контракта на портал Автодилер";
					ЗаголовокПисьма = "Контракт " + Строка(ЗаказНаАвтомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаАвтомобиль.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				СтруктураВозврата.Вставить("event_id", -422);
				Возврат СтруктураВозврата;
				
			Иначе
				СтруктураВозврата.Вставить("event_id", 0);
				Возврат СтруктураВозврата;
			КонецЕсли;
				
		Иначе
			СтруктураВозврата.Вставить("event_id", 0);
			Возврат СтруктураВозврата;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ВыгрузитьВыдачуДругогоДилера(УзелОбмена, мзПродажаЧужогоАвто, СтруктураКоды)
	Событие = мзПродажаЧужогоАвто.ВыдачаАвтомобиля;
	ДатаРЛ = мзПродажаЧужогоАвто.РабочийЛистДилера.Дата;
	АдресРесурса = "/api/event";
	
	code = Формат(ДатаРЛ, "ДФ=""г""") + СокрЛП(Событие.Номер);
	мСобытия = НайтиОбъекты(УзелОбмена, АдресРесурса, code);
	Если мСобытия = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	event_id = ПолучитьИдентификатор(мСобытия);		
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если event_id > 0 Тогда
		ТелоЗапроса = ДанныеВыдачиДругогоДилера(Событие, ДатаРЛ, СтруктураКоды, Ложь);	
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = АдресРесурса + "/" + Формат(event_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат event_id;			
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных события на портале Автодилер";
					ЗаголовокПисьма = "Событие " + Строка(Событие);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", Событие.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеВыдачиДругогоДилера(Событие, ДатаРЛ, СтруктураКоды);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда			
			ЗапросHTTP.АдресРесурса = АдресРесурса;
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(Событие));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных события на портал Автодилер";
					ЗаголовокПисьма = "Событие " + Строка(Событие);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительОП);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", Событие.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
				
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Процедура ВыгрузитьПродажиДругимДилером(УзелОбмена)
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    РеализацияАвтомобилей = ВыборкаИзменений.Получить();
		мзПродажаЧужогоАвто = РегистрыСведений.ПродажаАвтоДругогоДилера.СоздатьМенеджерЗаписи();
		мзПродажаЧужогоАвто.РеализацияАвтомобиля = РеализацияАвтомобилей.Ссылка;
		мзПродажаЧужогоАвто.Прочитать();
		Если Не мзПродажаЧужогоАвто.Выбран() Тогда
			Сообщить(Строка(РеализацияАвтомобилей) + ": запись отсутствует в регистре.", СтатусСообщения.Важное);
			Продолжить;
		КонецЕсли;
		
		СтруктураВозврата = ВыгрузитьКонтрактДругогоДилера(УзелОбмена, мзПродажаЧужогоАвто);			
		Если СтруктураВозврата.event_id = 0 Или СтруктураВозврата.event_id = -422 Тогда
			Продолжить;
		КонецЕсли;
		
		event_id = ВыгрузитьВыдачуДругогоДилера(УзелОбмена, мзПродажаЧужогоАвто, СтруктураВозврата);			
		Если event_id > 0 Или event_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, РеализацияАвтомобилей);
		КонецЕсли;
	КонецЦикла;
	
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();
КонецПроцедуры

Процедура ВыгрузкаПродажиДругимДилеромРентаУАЗ(Параметры = Неопределено) Экспорт
	УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РентаУАЗПродДрДилер");
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		ВыгрузитьПродажиДругимДилером(УзелОбмена);
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузкаПродажиДругимДилеромКорандоУАЗ(Параметры = Неопределено) Экспорт
	УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("КорандоУАЗПродДрДилер");
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		ВыгрузитьПродажиДругимДилером(УзелОбмена);
	КонецЕсли;
КонецПроцедуры


//// Процедуры / функции для выгрузки данных по остаткам партий и продажам товаров на портал Автодилер
/////////////////////////////////////////////////////////////////////////////////////////////////////////

Функция ПолучитьОстатки(Подразделение, ГруппаПроизводителей, Марка, НаДату)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаВыборки", КонецДня(НаДату));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПартииТоваровКомпанииОстатки.Номенклатура.АртикулАЦ КАК Артикул,
	               |	ПартииТоваровКомпанииОстатки.Номенклатура.Наименование КАК Наименование,
	               |	ПартииТоваровКомпанииОстатки.Партия.Дата КАК ДатаПоступления,
	               |	ПартииТоваровКомпанииОстатки.КоличествоОстаток КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	               |			ТОГДА ПартииТоваровКомпанииОстатки.СуммаОстаток / ПартииТоваровКомпанииОстатки.КоличествоОстаток
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СтоимостьЗаЕд,
	               |	ВЫБОР
	               |		КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	               |			ТОГДА (ПартииТоваровКомпанииОстатки.СуммаОстаток - ПартииТоваровКомпанииОстатки.СуммаНДСОстаток) / ПартииТоваровКомпанииОстатки.КоличествоОстаток
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СтоимостьЗаЕдБезНДС,
	               |	ПартииТоваровКомпанииОстатки.Партия КАК Партия
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровКомпании.Остатки(
	               |			&ДатаВыборки,
	               |			Номенклатура.Производитель В ИЕРАРХИИ (&ГруппаПроизводителей)
	               |				И Партия ССЫЛКА Документ.ПоступлениеТоваров
	               |				И Партия.ПодразделениеКомпании В ИЕРАРХИИ (&Подразделение)) КАК ПартииТоваровКомпанииОстатки
	               |ГДЕ
	               |	ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаПоступления";
		
	мОстатки = Новый Массив();
	ТаблицаНевыгруженных = Запрос.Выполнить().Выгрузить();	
	Для Каждого СтрокаТаблицы Из ТаблицаНевыгруженных Цикл
		Если Не ПравильныйАртикул(СтрокаТаблицы.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		
		стОстаток = Новый Структура();
		стОстаток.Вставить("article", СтрокаТаблицы.Артикул);		
		стОстаток.Вставить("count", СтрокаТаблицы.Количество);	
		ДатаПоступления = Формат(СтрокаТаблицы.ДатаПоступления, "ДФ=""гггг-ММ-дд""");
		стОстаток.Вставить("doc_date", ДатаПоступления);
		//Если Марка = Справочники.Марка.GAC Тогда
		//	стОстаток.Вставить("cost", СтрокаТаблицы.СтоимостьЗаЕдБезНДС);
		//Иначе
		//	стОстаток.Вставить("cost", СтрокаТаблицы.СтоимостьЗаЕд);
		//КонецЕсли;
		стОстаток.Вставить("cost", СтрокаТаблицы.СтоимостьЗаЕдБезНДС);
		Если Марка = Справочники.Марка.HAVAL Тогда
			стОстаток.Вставить("name", СтрокаТаблицы.Наименование);
			стОстаток.Вставить("inn", СтрокаТаблицы.Партия.Контрагент.ИНН);
			стОстаток.Вставить("receipt_doc_number", СтрокаТаблицы.Партия.Номер);
		КонецЕсли;
		
		мОстатки.Добавить(стОстаток);
	КонецЦикла;

	Если мОстатки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("items", мОстатки);
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные для выгрузки отчёта по остаткам!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ПолучитьПродажи(Подразделение, ГруппаПроизводителей, НаДату)
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(НаДату));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(НаДату));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	Запрос.УстановитьПараметр("Закрыт", Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	Запрос.УстановитьПараметр("ДопОборудование", Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.Регистратор КАК ДокументПродажи,
	               |	Продажи.Период КАК ДатаПродажи,
	               |	Продажи.Регистратор.Номер КАК ДокументНомер,
	               |	Продажи.Номенклатура.АртикулАЦ КАК Артикул,
	               |	СУММА(Продажи.Количество) КАК Количество,
	               |	СРЕДНЕЕ(Продажи.Сумма / Продажи.Количество) КАК СтоимостьЕдиницы
	               |ИЗ
	               |	РегистрНакопления.Продажи КАК Продажи
	               |ГДЕ
	               |	Продажи.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И Продажи.ХозОперация В (ЗНАЧЕНИЕ(Справочник.ХозОперации.ЗаказНаряд), ЗНАЧЕНИЕ(Справочник.ХозОперации.КомплектацияАвтомобиля), ЗНАЧЕНИЕ(Справочник.ХозОперации.РеализацияТоваров))
	               |	И Продажи.ПодразделениеКомпании В ИЕРАРХИИ(&Подразделение)
	               |	И НЕ Продажи.Покупатель.НашаФирма
	               |	И Продажи.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Продажи.Регистратор.Номер,
	               |	Продажи.Номенклатура.АртикулАЦ,
	               |	Продажи.Регистратор,
	               |	Продажи.Период
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаказНарядТовары.Ссылка,
	               |	ЗаказНарядТовары.Ссылка.Дата,
	               |	ЗаказНарядТовары.Ссылка.Номер,
	               |	ЗаказНарядТовары.Номенклатура.АртикулАЦ,
	               |	СУММА(ЗаказНарядТовары.Количество),
	               |	СРЕДНЕЕ(ЗаказНарядТовары.Цена)
	               |ИЗ
	               |	Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
	               |ГДЕ
	               |	ЗаказНарядТовары.Ссылка.Состояние = &Закрыт
	               |	И ЗаказНарядТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ЗаказНарядТовары.Ссылка.ПодразделениеКомпании В ИЕРАРХИИ(&Подразделение)
	               |	И ЗаказНарядТовары.Ссылка.ВидРемонта = &ДопОборудование
	               |	И ЗаказНарядТовары.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказНарядТовары.Ссылка,
	               |	ЗаказНарядТовары.Ссылка.Дата,
	               |	ЗаказНарядТовары.Ссылка.Номер,
	               |	ЗаказНарядТовары.Номенклатура.АртикулАЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаПродажи";
	
	мПродажи = Новый Массив();
	ТаблицаНевыгруженных = Запрос.Выполнить().Выгрузить();	
	Для Каждого СтрокаТаблицы Из ТаблицаНевыгруженных Цикл
		Если Не ПравильныйАртикул(СтрокаТаблицы.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		
		стПродажа = Новый Структура();
		стПродажа.Вставить("dn", СокрЛП(СтрокаТаблицы.ДокументНомер));		
		ДатаРеализации = Формат(СтрокаТаблицы.ДатаПродажи, "ДФ=""гггг-ММ-дд""");
		стПродажа.Вставить("realization", ДатаРеализации);		
		стПродажа.Вставить("pn", СтрокаТаблицы.Артикул);		
		
		Если ТипЗнч(СтрокаТаблицы.ДокументПродажи) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			ВидРемонта = СтрокаТаблицы.ДокументПродажи.ВидРемонта;
			ЭтоКузовнойРемонт = (ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт 
				Или ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий);
			ЭтоДопОборудование = (ВидРемонта = Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером 
				Или ВидРемонта = Справочники.ВидыРемонта.ДополнительноеОборудование);
				
			Если ЭтоКузовнойРемонт Тогда
				КаналРеализации = 2;
			ИначеЕсли ЭтоДопОборудование Тогда
				КаналРеализации = 5;
			Иначе
				КаналРеализации = 1;
			КонецЕсли;

		ИначеЕсли ТипЗнч(СтрокаТаблицы.ДокументПродажи) = Тип("ДокументСсылка.РеализацияТоваров") Тогда
			Если СтрокаТаблицы.ДокументПродажи.ОптоваяПродажа Тогда
				КаналРеализации = 4;
			Иначе
				КаналРеализации = 3;
			КонецЕсли;	
			
		Иначе
			КаналРеализации = 3;
 		КонецЕсли;
		стПродажа.Вставить("chn", КаналРеализации);
		
		стПродажа.Вставить("cnt", СтрокаТаблицы.Количество);
		стПродажа.Вставить("prc", СтрокаТаблицы.СтоимостьЕдиницы);
		мПродажи.Добавить(стПродажа);
	КонецЦикла;

	Если мПродажи.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("items", мПродажи);
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
	#Если Клиент Тогда	
		Сообщить("Не удалось записать JSON-данные для выгрузки отчёта по продажам!", СтатусСообщения.Внимание);
	#КонецЕсли
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ПравильныйАртикул(Артикул)
	Длина = СтрДлина(Артикул);
	Если Длина < 7 Или Длина > 16 Тогда
		Возврат Ложь;
	КонецЕсли;
	// усеченный вариант "0123456789ABCDEFGHJKLMNPRSTUVWXYZ"
	Для сч = 1 По Длина Цикл
		Если Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сред(Артикул, сч, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
		
	Возврат Истина;
КонецФункции

Процедура ВыгрузитьОстатки(УзелОбмена, ГруппаПроизводителей)
	Подразделение = УзелОбмена.Подразделение.Родитель;
	Если Подразделение = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
		Подразделение = УзелОбмена.Подразделение;
	КонецЕсли;
	
	НаДату = ТекущаяДата();
	ГодСтрока = Формат(Год(НаДату), "ЧЦ=4;ЧГ=0;ЧВН=");
	МесяцСтрока = Строка(Месяц(НаДату));
	КодДилера = Формат(УзелОбмена.КодДилера, "ЧГ=0;ЧВН=");;
	ПараметрыСтрока = "?year=" + ГодСтрока + "&month=" + МесяцСтрока + "&dealer_id=" + КодДилера;
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ТелоЗапроса = ПолучитьОстатки(Подразделение, ГруппаПроизводителей, УзелОбмена.МаркаАвтомобиля, НаДату);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда	
		ЗапросHTTP.АдресРесурса = "/api/service/stock-balance/balance" + ПараметрыСтрока;
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
		НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);
		Если НТТРОтвет.КодСостояния > 299 Тогда
			ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
			Сообщить("Выгрузка данных по остаткам партий товаров:" + Символы.ПС 
			+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
			+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузитьПродажи(УзелОбмена, ГруппаПроизводителей)
	Подразделение = УзелОбмена.Подразделение.Родитель;
	Если Подразделение = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
		Подразделение = УзелОбмена.Подразделение;
	КонецЕсли;
	
	НаДату = ТекущаяДата();
	ГодСтрока = Формат(Год(НаДату), "ЧЦ=4;ЧГ=0;ЧВН=");
	МесяцСтрока = Строка(Месяц(НаДату));
	КодДилера = Формат(УзелОбмена.КодДилера, "ЧГ=0;ЧВН=");;
	ПараметрыСтрока = "?year=" + ГодСтрока + "&month=" + МесяцСтрока + "&dealer_id=" + КодДилера;

	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ТелоЗапроса = ПолучитьПродажи(Подразделение, ГруппаПроизводителей, НаДату);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		ЗапросHTTP.АдресРесурса = "/api/service/stock-balance/implementation" + ПараметрыСтрока;
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
		НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);
		Если НТТРОтвет.КодСостояния > 299 Тогда
			ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
			Сообщить("Выгрузка данных по продажам товаров:" + Символы.ПС 
			+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
			+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

