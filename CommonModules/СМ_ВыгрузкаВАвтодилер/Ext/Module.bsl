Функция НайтиУзелОбменаДляСобытия(Событие)
	УзелОбмена = ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	
	РабЛистСсылка = Событие.ДокументОснование;
	Если ТипЗнч(РабЛистСсылка) <> Тип("ДокументСсылка.РабочийЛист") Тогда
		Возврат УзелОбмена;
	КонецЕсли;
	Если РабЛистСсылка.ТолькоБУ Или РабЛистСсылка.ВидАвтомобиля = Перечисления.ВидАвтомобиля.СобственныйПарк Тогда
		Возврат УзелОбмена;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(Событие.Продавец) Тогда
		#Если Клиент Тогда
		Сообщить("В событии не указан продавец. Выгрузка на портал Автодилер невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат УзелОбмена;
	КонецЕсли;
	
	СобытиеДляВыгрузки = Событие.ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля 
						Или Событие.ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча 
						Или Событие.ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок 
						Или Событие.ВидСобытия = Перечисления.ВидыСобытий.ТестДрайв 
						Или Событие.ВидСобытия = Перечисления.ВидыСобытий.ЗаявкаССайта 
						Или Событие.ВидСобытия = Перечисления.ВидыСобытий.ЭлектронноеПисьмо
						Или Событие.ВидСобытия = Перечисления.ВидыСобытий.БачатаАвто
						Или Событие.ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля;											
	Если Не СобытиеДляВыгрузки Тогда
		Возврат УзелОбмена;
	КонецЕсли;
	
	Модель = РабЛистСсылка.Модель;
	Если обЗначениеНеЗаполнено(Модель) Или Не Модель.ПринадлежитЭлементу(Справочники.Модели.АВТОМОБИЛИ_В_ПРОДАЖЕ) Тогда
