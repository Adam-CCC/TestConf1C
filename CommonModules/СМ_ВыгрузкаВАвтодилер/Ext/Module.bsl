//// Процедуры / функции для выгрузки данных календарных графиков на портал Автодилер
/////////////////////////////////////////////////////////////////////////////////////

Функция ЗагрузитьСписокСотрудниковДляЖурнала(УзелОбмена)
	АдресРесурса = "/api/manager?show_in_maintenance_schedule=1&page=";
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	мРезультат = Новый Массив();
	
	ЗапросHTTP.АдресРесурса = АдресРесурса + "1";
	НТТРОтвет = НТТР.Получить(ЗапросHTTP);
	Если НТТРОтвет.КодСостояния < 300 Тогда
		ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);				
		мОтвет = ПрочитатьJSON(ЧтениеJSON);
		Если ТипЗнч(мОтвет) = Тип("Массив") Тогда
			Для Каждого элОтвет Из мОтвет Цикл
				мРезультат.Добавить(элОтвет);
			КонецЦикла;
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
		
		Если мРезультат.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;

		Если НТТРОтвет.Заголовки["x-pagination-page-count"] <> Неопределено Тогда
			ВсегоСтраниц = Число(НТТРОтвет.Заголовки["x-pagination-page-count"]);
		ИначеЕсли НТТРОтвет.Заголовки["X-Pagination-Page-Count"] <> Неопределено Тогда
			ВсегоСтраниц = Число(НТТРОтвет.Заголовки["X-Pagination-Page-Count"]);
		Иначе
			ВсегоСтраниц = 1;
		КонецЕсли;
		
		Для сч = 2 По ВсегоСтраниц Цикл
			ЗапросHTTP.АдресРесурса = АдресРесурса + сч;
			НТТРОтвет = НТТР.Получить(ЗапросHTTP);
			Если НТТРОтвет.КодСостояния < 300 Тогда
				ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
				ЧтениеJSON = Новый ЧтениеJSON();
				ЧтениеJSON.УстановитьСтроку(ТелоОтвета);				
				мОтвет = ПрочитатьJSON(ЧтениеJSON);
				Если ТипЗнч(мОтвет) = Тип("Массив") Тогда
					Для Каждого элОтвет Из мОтвет Цикл
						мРезультат.Добавить(элОтвет);
					КонецЦикла;
				КонецЕсли;	
				
			Иначе
				Сообщить("Ошибка при получении объектов " + ЗапросHTTP.АдресРесурса + Символы.ПС 
				+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
				+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Сообщить("Ошибка при получении объектов " + ЗапросHTTP.АдресРесурса + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецЕсли;				
	
	Возврат мРезультат;
КонецФункции

Функция ПолучитьСписокГрафиков(УзелОбмена)
	мСотрудникиПортал = ЗагрузитьСписокСотрудниковДляЖурнала(УзелОбмена);
	Если мСотрудникиПортал = Неопределено Тогда
		Сообщить("На портале нет пользователей для отображения в Журнале записи на сервис!", СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецЕсли;
	
	мГрафикиСотрудников = Новый Массив();
	Для Каждого стСотрудник Из мСотрудникиПортал Цикл
		Если ЗначениеЗаполнено(стСотрудник.code) Тогда
			СотрудникСсылка = Справочники.Сотрудники.НайтиПоКоду(СокрЛП(стСотрудник.code));
			Если ЗначениеЗаполнено(СотрудникСсылка) И ЗначениеЗаполнено(СотрудникСсылка.ГрафикРаботы) Тогда
				стГрафик = Новый Структура();
				стГрафик.Вставить("id", стСотрудник.id);
				стГрафик.Вставить("ГрафикСсылка", СотрудникСсылка.ГрафикРаботы);
				мГрафикиСотрудников.Добавить(стГрафик);
				
			ИначеЕсли обЗначениеНеЗаполнено(СотрудникСсылка) Тогда
				Сообщить("В базе данных не найден сотрудник с кодом " + стСотрудник.code + "!", СтатусСообщения.Важное);
				Продолжить;
				
			ИначеЕсли обЗначениеНеЗаполнено(СотрудникСсылка.ГрафикРаботы) Тогда
				Сообщить("К сотруднику " + Строка(СотрудникСсылка) + " в базе данных не привязан график работы!", СтатусСообщения.Важное);
				Продолжить;
			КонецЕсли;
			
		Иначе
			ФИО = стСотрудник.last_name +" "+ стСотрудник.first_name +" "+ стСотрудник.middle_name;
			Сообщить("Для пользователя " + ФИО + " на портале не указан внешний код!", СтатусСообщения.Важное);
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Если мГрафикиСотрудников.Количество() = 0 Тогда
		Сообщить("Список графиков сотрудников для выгрузки на портал пуст!", СтатусСообщения.Важное);
		Возврат Неопределено;
	Иначе
		Возврат мГрафикиСотрудников;
	КонецЕсли;
КонецФункции

Функция ПолучитьГрафикСотрудника(ГрафикСсылка, ДатаНачала, ДатаОкончания)
	ЗапросГрафик = Новый Запрос();
	ЗапросГрафик.УстановитьПараметр("ГрафикСсылка", ГрафикСсылка);
	ЗапросГрафик.УстановитьПараметр("ДатаНачала", ДатаНачала);
	ЗапросГрафик.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ЗапросГрафик.Текст =
	"ВЫБРАТЬ
	|	ГрафикРаботКалендарный.Дата КАК Дата,
	|	ГрафикРаботКалендарный.НачалоРабочегоВремени КАК НачалоРабочегоВремени,
	|	ГрафикРаботКалендарный.КонецРабочегоВремени КАК КонецРабочегоВремени,
	|	ГрафикРаботКалендарный.ВидДня КАК ВидДня
	|ИЗ
	|	РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
	|ГДЕ
	|	ГрафикРаботКалендарный.График = &ГрафикСсылка
	|	И ГрафикРаботКалендарный.Дата >= &ДатаНачала
	|	И ГрафикРаботКалендарный.Дата <= &ДатаОкончания";
	
	РезультатГрафик = ЗапросГрафик.Выполнить();
	Если РезультатГрафик.Пустой() Тогда
		Сообщить("В календарном графике работы " + Строка(ГрафикСсылка) + " отсутствуют данные за период с "
		+ Формат(ДатаНачала, "ДЛФ=Д") +" по "+ Формат(ДатаОкончания, "ДЛФ=Д") + "!", СтатусСообщения.Важное);
		Возврат Неопределено;
		
	Иначе
		Возврат РезультатГрафик.Выбрать();
	КонецЕсли;
КонецФункции

Функция ДанныеГрафикаСотрудника(user_id, ВыборкаГрафик)
	стГрафикДень = Новый Структура();
	стГрафикДень.Вставить("user_id", user_id);
	стГрафикДень.Вставить("date", Формат(ВыборкаГрафик.Дата, "ДФ=""гггг-ММ-дд"""));
	стГрафикДень.Вставить("time_from", Формат(ВыборкаГрафик.НачалоРабочегоВремени, "ДФ=""ЧЧ:мм:сс"""));
	стГрафикДень.Вставить("time_to", Формат(ВыборкаГрафик.КонецРабочегоВремени, "ДФ=""ЧЧ:мм:сс"""));
	Если ВыборкаГрафик.ВидДня = Перечисления.ВидДня.Рабочий Тогда
		стГрафикДень.Вставить("status", 1);
	Иначе
		стГрафикДень.Вставить("status", 2);
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стГрафикДень);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки графика работы сотрудника!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Процедура ВыгрузитьЗаписьГрафика(УзелОбмена, user_id, ВыборкаГрафик)
	АдресРесурса = "api/staff/schedule?userId=" + Формат(user_id, "ЧГ=0,0");
	АдресРесурса = АдресРесурса + "&year=" + Формат(Год(ВыборкаГрафик.Дата), "ЧГ=0,0");
	АдресРесурса = АдресРесурса + "&month=" + Формат(Месяц(ВыборкаГрафик.Дата), "ЧГ=0,0");
	АдресРесурса = АдресРесурса + "&day=" + Формат(День(ВыборкаГрафик.Дата), "ЧГ=0,0");
	стЗапись = НайтиОбъектПоПараметрам(УзелОбмена, АдресРесурса);
	Если стЗапись = Неопределено Тогда
		запись_id = 0;
		
	Иначе
		Если ТипЗнч(стЗапись) = Тип("Структура") И стЗапись.Свойство("id") Тогда
			запись_id = стЗапись.id;
		Иначе
			запись_id = 0;
		КонецЕсли;
	КонецЕсли;

	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если запись_id > 0 Тогда
		ТелоЗапроса = ДанныеГрафикаСотрудника(user_id, ВыборкаГрафик);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/staff/schedule/" + Формат(запись_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния > 300 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					Сообщить("Ошибка при обновлении данных графика работы"  + Символы.ПС + СообщениеОбОшибке, СтатусСообщения.Важное);
				КонецЕсли;				
			КонецЕсли;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеГрафикаСотрудника(user_id, ВыборкаГрафик);;
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/staff/schedule";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "График работы на " + Формат(ВыборкаГрафик.Дата, "ДФ=""dd.MM.yyyy"""));
			Если стРезультат.КодСостояния > 300 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					Сообщить("Ошибка при выгрузке графика работы"  + Символы.ПС + СообщениеОбОшибке, СтатусСообщения.Важное);
				КонецЕсли;				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВыгрузкаКалендарныхГрафиков(УзелОбмена)
	ДатаНачала = НачалоДня(ТекущаяДата());
	ДатаОкончания = КонецМесяца(ДобавитьМесяц(ДатаНачала, 1));
	мГрафикиСотрудников = ПолучитьСписокГрафиков(УзелОбмена);
	Если мГрафикиСотрудников = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого стГрафик Из мГрафикиСотрудников Цикл
		ВыборкаГрафик = ПолучитьГрафикСотрудника(стГрафик.ГрафикСсылка, ДатаНачала, ДатаОкончания);
		Если ВыборкаГрафик = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Пока ВыборкаГрафик.Следующий() Цикл
			ВыгрузитьЗаписьГрафика(УзелОбмена, стГрафик.id, ВыборкаГрафик)
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

//// Процедуры / функции для выгрузки данных по записи на ремонт на портал Автодилер
/////////////////////////////////////////////////////////////////////////////////////

Функция ДанныеСтроковогоКлиентаЗаявка(ЗаявкаНаРемонт, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		ВнешнийКод = Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер);
		стЗапись.Вставить("code", ВнешнийКод);
		стЗапись.Вставить("may_process_personal_data", 0);
		стЗапись.Вставить("client_confirm_communication", 0);
		стЗапись.Вставить("type", 0);
		ИмяКлиента = СокрЛП(ЗаявкаНаРемонт.Заказчик);
		ПозПробела = СтрНайти(ИмяКлиента, " ");
		Если ПозПробела > 1 Тогда
			ИмяКлиента = Лев(ИмяКлиента, ПозПробела - 1);
		КонецЕсли;
		стЗапись.Вставить("name", ИмяКлиента);	
	КонецЕсли;
	
	Телефон = ЗаявкаНаРемонт.ПредставлениеТелефона;	
	ТелефонТолькоЦифры = "";
	СимволовВПредставлении = СтрДлина(Телефон);
	Если СимволовВПредставлении > 0 Тогда
		Для сч = 1 По СимволовВПредставлении Цикл
			СимволИзНомера = Сред(Телефон, сч, 1);
			Если СтрНайти("1234567890", СимволИзНомера) > 0 Тогда
				ТелефонТолькоЦифры = ТелефонТолькоЦифры + СимволИзНомера;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТелефонТолькоЦифры) Тогда
		Хеширование = Новый ХешированиеДанных(ХешФункция.MD5);
		Хеширование.Добавить(ТелефонТолькоЦифры);
		стЗапись.Вставить("phone_hash", ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
		
	Иначе
		Сообщить("В " + Строка(ЗаявкаНаРемонт) + " не задан телефон заказчика!" +
		Символы.ВК + "Выгрузка в Автодилер невозможна!!!", СтатусСообщения.Внимание);
		Возврат "";
	КонецЕсли;
		
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные контрагента для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ДанныеКлиентаЗаявка(СписокТелефонов, ЗаявкаНаРемонт, ЭтоВыгрузка = Истина)
	Клиент = ЗаявкаНаРемонт.Заказчик;
	Если ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		ВнешнийКод = Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер);
		Если ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда
			Марка = ЗаявкаНаРемонт.Автомобиль.Модель.Марка;
		ИначеЕсли ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Модели") Тогда
			Марка = ЗаявкаНаРемонт.Автомобиль.Марка;
		Иначе
			Марка = Справочники.Марка.ПустаяСсылка();
		КонецЕсли;
		Возврат ДанныеКлиента(Клиент, СписокТелефонов, Марка, ЭтоВыгрузка, ВнешнийКод);
		
	ИначеЕсли ТипЗнч(Клиент) = Тип("Строка") Тогда
		Возврат ДанныеСтроковогоКлиента(ЗаявкаНаРемонт, ЭтоВыгрузка);
		
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ВыгрузитьКлиентаЗаявка(УзелОбмена, ЗаявкаНаРемонт)	
	code = Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер);
	мКлиент = НайтиОбъекты(УзелОбмена, "/api/client", code);
	Если мКлиент = Неопределено Тогда
		Возврат 0;
	КонецЕсли;	
	СписокТелефонов = ПолучитьСписокТелефонов(мКлиент);
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	client_id = ПолучитьИдентификатор(мКлиент);
	Если client_id > 0 Тогда
		ТелоЗапроса = ДанныеКлиентаЗаявка(СписокТелефонов, ЗаявкаНаРемонт, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/client/" + Формат(client_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат client_id;
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных контрагента на портале Автодилер";
					ЗаголовокПисьма = Строка(ЗаявкаНаРемонт) + Символы.ПС + "Заказчик " + Строка(ЗаявкаНаРемонт.Заказчик);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаявкаНаРемонт.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеКлиентаЗаявка(СписокТелефонов, ЗаявкаНаРемонт);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/client";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Контрагент для " + Строка(ЗаявкаНаРемонт));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных контрагента на портал Автодилер";
					ЗаголовокПисьма = Строка(ЗаявкаНаРемонт) + Символы.ПС + "Заказчик " + Строка(ЗаявкаНаРемонт.Заказчик);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаявкаНаРемонт.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ДанныеАвтомобиляЗаявка(ЗаявкаНаРемонт, КодБренда, КодМодели, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		ВнешнийКод = Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер);
		стЗапись.Вставить("code", ВнешнийКод);
		стЗапись.Вставить("brand_id", КодБренда);
	КонецЕсли;
	
	стЗапись.Вставить("model_id", КодМодели);

	Если ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда
		VIN = ЗаявкаНаРемонт.Автомобиль.VIN;
		Если ЗначениеЗаполнено(VIN) Тогда
			стЗапись.Вставить("vin", VIN);
		Иначе
			стЗапись.Вставить("vin", "");
		КонецЕсли;
		
		Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЗаявкаНаРемонт.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
		Если обЗначениеНеЗаполнено(Пробег) Тогда
			стЗапись.Вставить("mileage", 0);
		Иначе
			стЗапись.Вставить("mileage", Пробег);
		КонецЕсли;
		
		ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЗаявкаНаРемонт.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
		Если Не обЗначениеНеЗаполнено(ГосНомер) Тогда
			стЗапись.Вставить("reg_number", ГосНомер);
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные потребности для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ВыгрузитьАвтомобильЗаявка(УзелОбмена, ЗаявкаНаРемонт)
	Если ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда
		Модель = ЗаявкаНаРемонт.Автомобиль.Модель;
	ИначеЕсли ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Модели") Тогда
		Модель = ЗаявкаНаРемонт.Автомобиль;
	Иначе
		Модель = Справочники.Модели.АвтоСПробегом;
	КонецЕсли;
	
	МаркаАвтомобиля = Модель.Марка;
	КодБренда = 0;
	Если МаркаАвтомобиля = Справочники.Марка.FORD И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 6; // Ford
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.UAZ И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 134; // УАЗ
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GEELY И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 46; // Geely
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.BELGEE И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 2710; // Belgee
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.KNEWSTAR И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 2771; // KNEWSTAR
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.EXEED И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 2082; // EXEED
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHANGAN И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 140; // CHANGAN
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 125; // LADA
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.GAC И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 2058; // GAC
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.OMODA И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 2643; // OMODA
				
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JAECOO И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 2692; // JAECOO
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.CHERY И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 30; // CHERY
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.VGV И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		КодБренда = 2716; // VGV
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HAVAL Или МаркаАвтомобиля = Справочники.Марка.GREAT_WALL
		 И УзелОбмена.МаркаАвтомобиля = МаркаАвтомобиля Тогда
		Если ВИерархии(Модель, Справочники.Модели.НайтиПоКоду("ЦБ00005940")) Тогда
			КодБренда = 2732; // HAVAL Pro
		Иначе
			КодБренда = 152; // HAVAL City - одинаковый!
		КонецЕсли;
	КонецЕсли;
	
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда
		КодМодели = мзИдентификаторыDSF.DSF_id; 
		Если УзелОбмена.МаркаАвтомобиля = Справочники.Марка.GEELY И Модель.Марка = Справочники.Марка.BELGEE Тогда
			КодМодели = мзИдентификаторыDSF.BelgeeDSF_id; //Belgee у дилера Geely, якобы это временно)))
		КонецЕсли;
		
	ИначеЕсли УзелОбмена.МаркаАвтомобиля = Справочники.Марка.LADA_ВАЗ Тогда
		КодБренда = 139;
		КодМодели = 2166;
		
	//Иначе
	//	#Если Клиент Тогда
	//	Сообщить("С порталом Автодилер не синхронизирована модель " + Модель + ". Выгрузка автомобиля невозможна!!!", СтатусСообщения.Внимание);
	//	#КонецЕсли
	//	Возврат 0;
	КонецЕсли;

	code = Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер);
	мАвтомобиль = НайтиОбъекты(УзелОбмена, "/api/vehicle", code);
	Если мАвтомобиль = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	car_id = ПолучитьИдентификатор(мАвтомобиль);
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если car_id > 0 Тогда
		ТелоЗапроса = ДанныеАвтомобиляЗаявка(ЗаявкаНаРемонт, КодБренда, КодМодели, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/vehicle/" + Формат(car_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат car_id;
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных автомобиля на портале Автодилер";
					Автомобиль = ЗаявкаНаРемонт.Автомобиль;
					Если обЗначениеНеЗаполнено(Автомобиль) Тогда
						Автомобиль = ЗаявкаНаРемонт.Модель;
					КонецЕсли;
					ЗаголовокПисьма = Строка(ЗаявкаНаРемонт) + Символы.ПС + "Автомобиль " + Строка(Автомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаявкаНаРемонт.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеАвтомобиляЗаявка(ЗаявкаНаРемонт, КодБренда, КодМодели);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/vehicle";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Потребность для " + Строка(ЗаявкаНаРемонт));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных автомобиля на портал Автодилер";
					Автомобиль = ЗаявкаНаРемонт.Автомобиль;
					Если обЗначениеНеЗаполнено(Автомобиль) Тогда
						Автомобиль = ЗаявкаНаРемонт.Модель;
					КонецЕсли;
					ЗаголовокПисьма = Строка(ЗаявкаНаРемонт) + Символы.ПС + "Автомобиль " + Строка(Автомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаявкаНаРемонт.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция НайтиИдентификаторПоКоду(Объект, Код)
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		Если Объект.Количество() > 0 Тогда
			id = 0;
			Для Каждого ЭлементОбъекта Из Объект Цикл
				Если ТипЗнч(ЭлементОбъекта) = Тип("Структура") И ЭлементОбъекта.Свойство("code")
					И ЭлементОбъекта.code = Код Тогда
					id = ?(ЭлементОбъекта.Свойство("id"), ЭлементОбъекта.id, 0);
					Прервать;
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЦикла;
			Возврат id;
			
		Иначе
			Возврат 0;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") И Объект.Свойство("id") Тогда
		Возврат Объект.id;
		
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ДанныеЗаявкиНаРемонт(ЗаявкаНаРемонт, client_id, contact_person_id, car_id, acceptor_id, ПериодПриёмки, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер));
	КонецЕсли;
	
	стЗапись.Вставить("status", 1);
	стЗапись.Вставить("occupying_type", 1);	
	стЗапись.Вставить("accept_from", Формат(ЗаявкаНаРемонт.ДатаНачала, "ДФ=""dd.MM.yyyy HH:mm"""));
	стЗапись.Вставить("accept_to", Формат(ЗаявкаНаРемонт.ДатаНачала + ПериодПриёмки, "ДФ=""dd.MM.yyyy HH:mm"""));
	Если ЗначениеЗаполнено(acceptor_id) Тогда
		стЗапись.Вставить("acceptor_id", acceptor_id); //  ID мастера-приёмщика
	Иначе
		Возврат "";
	КонецЕсли;
	
	стЗапись.Вставить("issue_from", Формат(ЗаявкаНаРемонт.ДатаОкончания - ПериодПриёмки, "ДФ=""dd.MM.yyyy HH:mm"""));
	стЗапись.Вставить("issue_to", Формат(ЗаявкаНаРемонт.ДатаОкончания, "ДФ=""dd.MM.yyyy HH:mm"""));
	стЗапись.Вставить("issued_by_id", стЗапись.acceptor_id); //  ID мастера-приёмщика
	
	Если ЗначениеЗаполнено(client_id) Тогда
		стЗапись.Вставить("client_id", client_id);	// ID клиента
	Иначе
		Возврат "";
	КонецЕсли;
	Если contact_person_id > 0 Тогда
		стЗапись.Вставить("contact_person_id ", contact_person_id);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(car_id) Тогда
		стЗапись.Вставить("car_id", car_id);	// ID автомобиля
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаРемонт.ПричинаОбращения) Тогда
		стЗапись.Вставить("request_reason", ЗаявкаНаРемонт.ПричинаОбращения);		
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки Заявки на ремонт на портал DNM!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();	
	Возврат ТелоЗапроса;
КонецФункции

Функция ВыгрузитьЗаявкуНаРемонт(УзелОбмена, ЗаявкаНаРемонт, client_id, car_id, ПериодПриёмки)	
	Если ЗначениеЗаполнено(ЗаявкаНаРемонт.Диспетчер) Тогда
		МастерПриемщик = ЗаявкаНаРемонт.Диспетчер;
	ИначеЕсли ЗначениеЗаполнено(ЗаявкаНаРемонт.Менеджер) Тогда
		МастерПриемщик = ЗаявкаНаРемонт.Менеджер;
	Иначе
		#Если Клиент Тогда
		Сообщить("В " + Строка(ЗаявкаНаРемонт) + " не указаны Мастер-приемщик и Менеджер. Выгрузка Заявки на ремонт на портал DNM невозможна!!!", СтатусСообщения.Внимание);						
		#КонецЕсли
		Возврат 0;
	КонецЕсли;
	
	acceptor_id = ПолучитьКодМастераПриемщика(УзелОбмена, МастерПриемщик);
	Если acceptor_id  = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	maintenance_schedule_id = 0;
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/service/maintenance-schedule";
	code = Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер);
	мЗаявкаНаРемонт = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, code);
	Если мЗаявкаНаРемонт = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаРемонт._г_ДоверенноеЛицоЗаказчика) Тогда
		contact_person_id = ВыгрузитьКлиента(УзелОбмена, ЗаявкаНаРемонт._г_ДоверенноеЛицоЗаказчика, ЗаявкаНаРемонт.Ссылка); // контактное лицо Заказчика
	Иначе
		contact_person_id = 0;	
	КонецЕсли;
	
	maintenance_schedule_id = ПолучитьИдентификатор(мЗаявкаНаРемонт);		
	Если maintenance_schedule_id > 0 Тогда
		ТелоЗапроса = ДанныеЗаявкиНаРемонт(ЗаявкаНаРемонт, client_id, contact_person_id, car_id, acceptor_id, ПериодПриёмки, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/service/maintenance-schedule/" + Формат(maintenance_schedule_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				КодСостояния = ВыгрузитьПостыСТО(УзелОбмена, ЗаявкаНаРемонт, client_id, car_id, maintenance_schedule_id, ПериодПриёмки, Ложь);
				Если КодСостояния = -422 Тогда
					Возврат КодСостояния;
					
				ИначеЕсли КодСостояния = 0 Или КодСостояния = maintenance_schedule_id Тогда
					Возврат maintenance_schedule_id;
					
				Иначе
					Возврат 0;
				КонецЕсли;

			ИначеЕсли КодСостояния = 403 Тогда
				Возврат -422;
			
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных Заявки на ремонт на портале Автодилер";
					ЗаголовокПисьма = Строка(ЗаявкаНаРемонт);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаявкаНаРемонт.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеЗаявкиНаРемонт(ЗаявкаНаРемонт, client_id, contact_person_id, car_id, acceptor_id, ПериодПриёмки);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/service/maintenance-schedule";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(ЗаявкаНаРемонт));
			Если стРезультат.id > 0 Тогда
				КодСостояния = ВыгрузитьПостыСТО(УзелОбмена, ЗаявкаНаРемонт, client_id, car_id, стРезультат.id, ПериодПриёмки);
				Если КодСостояния = -422 Тогда
					Возврат КодСостояния;
					
				ИначеЕсли КодСостояния = 0 Или КодСостояния = стРезультат.id Тогда
					Возврат стРезультат.id;
					
				Иначе
					Возврат 0;
				КонецЕсли;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных Заявки на ремонт на портал Автодилер";
					ЗаголовокПисьма = Строка(ЗаявкаНаРемонт);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаявкаНаРемонт.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ДанныеПоПостамСТО(ЗаявкаНаРемонт, ПериодПриёмки, УзелОбмена)
	мПостыПланРемонта = Новый Массив();
	
	Если ЗаявкаНаРемонт.ХозОперация = Справочники.ХозОперации.ПланРемонта Тогда
		сч = 0;
		ВсегоПостов = ЗаявкаНаРемонт.Планирование.Количество();
		Для Каждого СтрокаПланирования Из ЗаявкаНаРемонт.Планирование Цикл
			Если обЗначениеНеЗаполнено(СтрокаПланирования.РабочееМесто) Или обЗначениеНеЗаполнено(СтрокаПланирования.НачалоВыполнения)
				Или обЗначениеНеЗаполнено(СтрокаПланирования.ОкончаниеВыполнения) Тогда
				сч = сч + 1;
				Продолжить;
			КонецЕсли;
			
			мПостыСТО = Новый Массив();
			АдресРесурса = "/api/service/post-service";
			мПостыСТО = НайтиОбъекты(УзелОбмена, АдресРесурса, СокрЛП(СтрокаПланирования.РабочееМесто.Код));
			// не ищет по полю code, возвращает массив всех постов!!!
			Если мПостыСТО = Неопределено Тогда
				сч = сч + 1;
				Продолжить;
			КонецЕсли;
			
			//station_id = ПолучитьИдентификатор(мПостыСТО);
			station_id = НайтиИдентификаторПоКоду(мПостыСТО, СокрЛП(СтрокаПланирования.РабочееМесто.Код));
			Если station_id = 0 Тогда
				сч = сч + 1;
				Продолжить;
			КонецЕсли;
			
			стПостСТО = Новый Структура();
			стПостСТО.Вставить("station_id", station_id);
			Если сч = 0 Тогда
				стПостСТО.Вставить("service_from", Формат(ЗаявкаНаРемонт.ДатаНачала + ПериодПриёмки, "ДФ=""dd.MM.yyyy HH:mm"""));
			Иначе
				стПостСТО.Вставить("service_from", Формат(СтрокаПланирования.НачалоВыполнения, "ДФ=""dd.MM.yyyy HH:mm"""));
			КонецЕсли;
			Если сч = ВсегоПостов - 1 Тогда
				стПостСТО.Вставить("service_to", Формат(ЗаявкаНаРемонт.ДатаОкончания - ПериодПриёмки, "ДФ=""dd.MM.yyyy HH:mm"""));
			Иначе
				стПостСТО.Вставить("service_to", Формат(СтрокаПланирования.ОкончаниеВыполнения, "ДФ=""dd.MM.yyyy HH:mm"""));
			КонецЕсли;
			стПостСТО.Вставить("status", 1);
			
			мПостыПланРемонта.Добавить(стПостСТО);
			сч = сч + 1;
		КонецЦикла;
		
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если мПостыПланРемонта.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	стЗапись = Новый Структура();
	стЗапись.Вставить("stations", мПостыПланРемонта);
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки планирования постов на портал DNM!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();	
	Возврат ТелоЗапроса;
КонецФункции

Функция ВыгрузитьПостыСТО(УзелОбмена, ЗаявкаНаРемонт, client_id, car_id, maintenance_schedule_id, ПериодПриёмки, ЭтоВыгрузка = Истина)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если ЭтоВыгрузка Тогда
		ЗапросHTTP.АдресРесурса = "/api/service/maintenance-schedule/add-station-schedule/" + Формат(maintenance_schedule_id, "ЧГ=0,0");
	Иначе
		ЗапросHTTP.АдресРесурса = "/api/service/maintenance-schedule/station-reschedule/" + Формат(maintenance_schedule_id, "ЧГ=0,0");
	КонецЕсли;

	ТелоЗапроса = ДанныеПоПостамСТО(ЗаявкаНаРемонт, ПериодПриёмки, УзелОбмена);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
		Если КодСостояния < 300 Тогда
			Возврат maintenance_schedule_id;
			
		ИначеЕсли КодСостояния = 403 Тогда
			Возврат -422;
		
		ИначеЕсли КодСостояния = 422 Тогда
			СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
			Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
				ТемаПисьма = "Ошибка при выгрузке/обновлении данных записи по постам СТО на портал Автодилер";
				ЗаголовокПисьма = Строка(ЗаявкаНаРемонт);
				ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
				
				стДанныеСообщения = Новый Структура();
				стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
				стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
				стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
				стДанныеСообщения.Вставить("ДокументСсылка", ЗаявкаНаРемонт.Ссылка);
				ОтправитьСообщениеОбОшибке(стДанныеСообщения);
			КонецЕсли;				
			Возврат -422;
			
		Иначе
			Возврат 0;
		КонецЕсли;
		
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Процедура ВыгрузкаАвтодилерЗаявкиНаРемонт(УзелОбмена)
	ПериодПриёмки = 900;
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    ЗаявкаНаРемонт = ВыборкаИзменений.Получить();	
		
		client_id = ВыгрузитьКлиентаЗаявка(УзелОбмена, ЗаявкаНаРемонт);
		Если client_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
			Продолжить;
		ИначеЕсли client_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		car_id = ВыгрузитьАвтомобильЗаявка(УзелОбмена, ЗаявкаНаРемонт);
		Если car_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
			Продолжить;
		ИначеЕсли car_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		maintenance_schedule_id = ВыгрузитьЗаявкуНаРемонт(УзелОбмена, ЗаявкаНаРемонт, client_id, car_id, ПериодПриёмки);
		Если maintenance_schedule_id > 0 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
			
		ИначеЕсли maintenance_schedule_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
			Продолжить;			
		КонецЕсли;
	КонецЦикла;
	
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

