				Если ЗаказНаряд.НомерТО > 15 Тогда
					ВидыРемонтаDNM.Добавить(29); // ТО другое (более 150000 км или от 84 месяцев и старше)
				Иначе
					ВидыРемонтаDNM.Добавить(мзИдентификаторы.GACВидРемонта_id + ЗаказНаряд.НомерТО); // ТО-0 GAC = 13
				КонецЕсли;
				
			ИначеЕсли мзИдентификаторы.ВидРемонта.ГарантияЗавода Тогда
				Если ЗначениеЗаполнено(ЗаказНаряд.СервиснаяКампания) Тогда
					ВидыРемонтаDNM.Добавить(3); // Сервисная (Отзывная) кампания
				Иначе
					ВидыРемонтаDNM.Добавить(мзИдентификаторы.GACВидРемонта_id);
