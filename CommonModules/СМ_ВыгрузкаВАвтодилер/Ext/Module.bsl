					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат client_id;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеКлиента(Клиент, СписокТелефонов, Марка);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/client";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(Клиент));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных контрагента на портал Автодилер";
					ЗаголовокПисьма = Строка(ДокументСсылка) + Символы.ПС + "Контрагент " + Строка(Клиент);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ДокументСсылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции
	
Функция ВыгрузитьАвтомобиль(УзелОбмена, Автомобиль, ДокументСсылка)	
	Модель = Автомобиль.Модель;
	Марка = Модель.Марка;
	Если Марка = Справочники.Марка.FORD Тогда
		КодБренда = 6; // Ford
		
	ИначеЕсли Марка = Справочники.Марка.UAZ Тогда
		КодБренда = 134; // УАЗ
		
	ИначеЕсли Марка = Справочники.Марка.GEELY Тогда
		КодБренда = 46; // Geely
		
	ИначеЕсли Марка = Справочники.Марка.BELGEE Тогда
		КодБренда = 2710; // Belgee
		
	ИначеЕсли Марка = Справочники.Марка.KNEWSTAR Тогда
		КодБренда = 2771; // KNEWSTAR
		
	ИначеЕсли Марка = Справочники.Марка.FIAT Тогда
		КодБренда = 45; // Fiat
		
	ИначеЕсли Марка = Справочники.Марка.JEEP Тогда
		КодБренда = 63; // Jeep
		
	ИначеЕсли Марка = Справочники.Марка.ESTEO Тогда
		КодБренда = 2796; // ESTEO
		
	ИначеЕсли Марка = Справочники.Марка.EXEED Тогда
		КодБренда = 2082; // EXEED
		
	ИначеЕсли Марка = Справочники.Марка.CHANGAN Тогда
		КодБренда = 140; // CHANGAN
		
	ИначеЕсли Марка = Справочники.Марка.LADA_ВАЗ Тогда
		КодБренда = 125; // LADA
		
	ИначеЕсли Марка = Справочники.Марка.GAC Тогда
		КодБренда = 2058; // GAC
		
	ИначеЕсли Марка = Справочники.Марка.VGV Тогда
		КодБренда = 2716; // VGV
		
	ИначеЕсли Марка = Справочники.Марка.HAVAL Или Марка = Справочники.Марка.GREAT_WALL Тогда
		Если ВИерархии(Модель, Справочники.Модели.НайтиПоКоду("ЦБ00005940")) Тогда
			КодБренда = 2732; // HAVAL Pro
		Иначе
			КодБренда = 152; // HAVAL City - одинаковый!
		КонецЕсли;
		
	ИначеЕсли Марка = Справочники.Марка.SOLLERS Тогда
		КодБренда = 2634; // SOLLERS	
		
	ИначеЕсли Марка = Справочники.Марка.HONGQI Тогда
		КодБренда = 2708; // HONGQI	
		
	ИначеЕсли Марка = Справочники.Марка.TENET Тогда
		КодБренда = 2798; // TENET
		
	ИначеЕсли Марка = Справочники.Марка.TENET_Plus Тогда
		КодБренда = 2815; // TENET_Plus
		
	ИначеЕсли Марка = Справочники.Марка.CHERY Тогда
		КодБренда = 30; // CHERY
		
	Иначе
		#Если Клиент Тогда
		Сообщить("Неверно указана марка автомобиля " + Марка + ". Выгрузка заказ-наряда невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат 0;
	КонецЕсли;
	
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда		
		КодМодели = мзИдентификаторыDSF.DSF_id;
		Если УзелОбмена.МаркаАвтомобиля <> Марка И Марка = Справочники.Марка.BELGEE Тогда
			КодМодели = мзИдентификаторыDSF.BelgeeDSF_id; //Belgee у дилера Geely
		КонецЕсли;
		
	Иначе
		#Если Клиент Тогда
		Сообщить("С порталом Автодилер не синхронизирована модель " + Модель + ". Выгрузка заказ-наряда невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат 0;
	КонецЕсли;
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/vehicle";
	code = СокрЛП(Автомобиль.Код);
	мАвтомобиль = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, code);
	Если мАвтомобиль = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	car_id = ПолучитьИдентификатор(мАвтомобиль);		
	Если car_id > 0 Тогда
		ТелоЗапроса = ДанныеАвтомобиля(Автомобиль, КодБренда, КодМодели, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/vehicle/" + Формат(car_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат car_id;
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных автомобиля на портале Автодилер";
					ЗаголовокПисьма = Строка(ДокументСсылка) + Символы.ПС + "Автомобиль " + Строка(Автомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ДокументСсылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат car_id;
		КонецЕсли;
		
	Иначе
		ТелоЗапроса = ДанныеАвтомобиля(Автомобиль, КодБренда, КодМодели);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/vehicle";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(Автомобиль));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных автомобиля на портал Автодилер";
					ЗаголовокПисьма = Строка(ДокументСсылка) + Символы.ПС + "Автомобиль " + Строка(Автомобиль);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ДокументСсылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ВыгрузитьЗаказНаряд(УзелОбмена, ЗаказНаряд, client_id, car_id)	
	Если ЗначениеЗаполнено(ЗаказНаряд.Диспетчер) Тогда
		МастерПриемщик = ЗаказНаряд.Диспетчер;
	ИначеЕсли ЗначениеЗаполнено(ЗаказНаряд.Менеджер) Тогда
		МастерПриемщик = ЗаказНаряд.Менеджер;
	Иначе
		#Если Клиент Тогда
		Сообщить("В заказ-наряде " + Строка(ЗаказНаряд) + " не указаны Мастер-приемщик и Менеджер. Выгрузка заказ-наряда невозможна!!!", СтатусСообщения.Внимание);						
		#КонецЕсли
		Возврат 0;
	КонецЕсли;
	
	acceptor_id = ПолучитьКодМастераПриемщика(УзелОбмена, МастерПриемщик);
	Если acceptor_id  = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	purchase_id = 0;
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/purchase";
	code = СокрЛП(ЗаказНаряд.Номер);
	мЗаказНаряд = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, code);
	Если мЗаказНаряд = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказНаряд._г_ДоверенноеЛицоЗаказчика) Тогда
		contact_person_id = ВыгрузитьКлиента(УзелОбмена, ЗаказНаряд._г_ДоверенноеЛицоЗаказчика, ЗаказНаряд.Ссылка); // контактное лицо Заказчика
	Иначе
		contact_person_id = 0;	
	КонецЕсли;
	
	purchase_id = ПолучитьИдентификатор(мЗаказНаряд);		
	Если purchase_id > 0 Тогда
		ТелоЗапроса = ДанныеЗаказНаряда(ЗаказНаряд, client_id, contact_person_id, car_id, acceptor_id, УзелОбмена.МаркаАвтомобиля, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/purchase/" + Формат(purchase_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат purchase_id;
				
			ИначеЕсли КодСостояния = 403 Тогда
				Возврат -403;
			
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных заказ-наряда на портале Автодилер";
					ЗаголовокПисьма = Строка(ЗаказНаряд);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаряд.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеЗаказНаряда(ЗаказНаряд, client_id, contact_person_id, car_id, acceptor_id, УзелОбмена.МаркаАвтомобиля);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/purchase";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(ЗаказНаряд));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при выгрузке данных заказ-наряда на портал Автодилер";
					ЗаголовокПисьма = Строка(ЗаказНаряд);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
					стДанныеСообщения.Вставить("ДокументСсылка", ЗаказНаряд.Ссылка);
					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ВыгрузитьРаботы(УзелОбмена, ЗаказНаряд, purchase_id)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/purchase-work";
	мРаботы = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, Формат(purchase_id, "ЧГ=0,0"), Истина);
	Если мРаботы = Неопределено Тогда
		Возврат 0;
	ИначеЕсли ТипЗнч(мРаботы) <> Тип("Массив") Тогда
		Возврат 0;
	Иначе
		Марка = ЗаказНаряд.Автомобиль.Модель.Марка;
	КонецЕсли;
	
	сч = 0;
	Если мРаботы.Количество() = 0 Тогда
		Для Каждого СтрокаРабота Из ЗаказНаряд.Работы Цикл
			ТелоЗапроса = ДанныеРаботы(СтрокаРабота, purchase_id, Марка, ЗаказНаряд);
			Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
				ЗапросHTTP.АдресРесурса = "/api/purchase-work";
				стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Авторабота " + Строка(СтрокаРабота.Работа));
				Если стРезультат.id > 0 Тогда
					сч = сч + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Если Не (Марка = Справочники.Марка.GEELY Или Марка = Справочники.Марка.BELGEE) Тогда
			Для Каждого стРабота Из мРаботы Цикл
				Если ТипЗнч(стРабота) = Тип("Структура") И стРабота.Свойство("code") И стРабота.Свойство("status") Тогда
					Если стРабота.status > 0 Тогда
						Продолжить;
					КонецЕсли;
					
					НайденнаяСтрока = НайтиРаботуВТЧ(ЗаказНаряд.Работы, стРабота.code);
					Если НайденнаяСтрока = Неопределено Тогда
						Если стРабота.Свойство("id") Тогда
							ЗапросHTTP.АдресРесурса = "/api/purchase-work/" + Формат(стРабота.id, "ЧГ=0,0");
							КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, "{""status"":1}");
						КонецЕсли;
					КонецЕсли;
					
				Иначе
					Продолжить;
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого СтрокаРабота Из ЗаказНаряд.Работы Цикл
			Работа = СтрокаРабота.Работа;
			Если Марка = Справочники.Марка.GEELY Тогда
				КодРаботы = КодРаботыДжили(СтрокаРабота, ЗаказНаряд);
				
			ИначеЕсли Марка = Справочники.Марка.CHANGAN Или Марка = Справочники.Марка.HAVAL Тогда
				Артикул = Работа.Артикул;
				Если ЗначениеЗаполнено(Артикул) Тогда
					КодРаботы = СокрЛП(Артикул);
				Иначе
					КодРаботы = СокрЛП(Работа.Код);
				КонецЕсли;
				
			Иначе
				КодРаботы = СокрЛП(Работа.Код);
			КонецЕсли;
			PurchaseWork_id = НайтиРаботуТовар(мРаботы, КодРаботы);
			Если PurchaseWork_id = 0 Тогда
				ТелоЗапроса = ДанныеРаботы(СтрокаРабота, purchase_id, Марка, ЗаказНаряд);
				Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
					ЗапросHTTP.АдресРесурса = "/api/purchase-work";
					стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Авторабота " + Строка(Работа));
					Если стРезультат.id > 0 Тогда
						сч = сч + 1;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				ТелоЗапроса = ДанныеРаботы(СтрокаРабота, purchase_id, Марка, ЗаказНаряд, Ложь);
				Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
					ЗапросHTTP.АдресРесурса = "/api/purchase-work/" + Формат(PurchaseWork_id, "ЧГ=0,0");
					КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
					Если КодСостояния < 300 Тогда
						сч = сч + 1;
					КонецЕсли;				
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат сч;
КонецФункции

Функция ВыгрузитьТовары(УзелОбмена, ЗаказНаряд, purchase_id)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/purchase-spare";
	мТовары = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, Формат(purchase_id, "ЧГ=0,0"), Истина);
	Если мТовары = Неопределено Тогда
		Возврат 0;
	ИначеЕсли ТипЗнч(мТовары) <> Тип("Массив") Тогда
		Возврат 0;
	КонецЕсли;
	
	ЭтоДопОборудованиеХавал = УзелОбмена.МаркаАвтомобиля = Справочники.Марка.HAVAL
	 И ЗаказНаряд.ВидРемонта = Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером; 
	сч = 0;
	Если мТовары.Количество() = 0 Тогда
		Для Каждого СтрокаТовар Из ЗаказНаряд.Товары Цикл
			Если ЭтоДопОборудованиеХавал И Не ВИерархии(СтрокаТовар.Номенклатура.Производитель, Справочники.Производители.HAVAL) Тогда
				Продолжить;
			КонецЕсли;
			
			ТелоЗапроса = ДанныеТовара(СтрокаТовар, purchase_id);
			Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
				ЗапросHTTP.АдресРесурса = "/api/purchase-spare";
				стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Товар " + Строка(СтрокаТовар.Номенклатура));
				Если стРезультат.id > 0 Тогда
					сч = сч + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Для Каждого стТовар Из мТовары Цикл
			Если ТипЗнч(стТовар) = Тип("Структура") И стТовар.Свойство("code") И стТовар.Свойство("status") Тогда
				Если стТовар.status > 0 Тогда
					Продолжить;
				КонецЕсли;
					
				НайденнаяСтрока = НайтиТоварВТЧ(ЗаказНаряд.Товары, СМ_ВыгрузкаВЛоджикСтарс.УдалитьТочку(стТовар.code));
				Если НайденнаяСтрока = Неопределено Тогда
					Если стТовар.Свойство("id") Тогда
						ЗапросHTTP.АдресРесурса = "/api/purchase-spare/" + Формат(стТовар.id, "ЧГ=0,0");
						КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, "{""status"":1}");
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				Продолжить;
			КонецЕсли;		
		КонецЦикла;
		
		Для Каждого СтрокаТовар Из ЗаказНаряд.Товары Цикл
			Если ЭтоДопОборудованиеХавал И Не ВИерархии(СтрокаТовар.Номенклатура.Производитель, Справочники.Производители.HAVAL) Тогда
				Продолжить;
			КонецЕсли;
			
			Номенклатура = СтрокаТовар.Номенклатура;
			PurchaseSpare_id = НайтиРаботуТовар(мТовары, СМ_ВыгрузкаВЛоджикСтарс.УдалитьТочку(СокрЛП(Номенклатура.Артикул)));
			Если PurchaseSpare_id = 0 Тогда
				ТелоЗапроса = ДанныеТовара(СтрокаТовар, purchase_id);
				Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
					ЗапросHTTP.АдресРесурса = "/api/purchase-spare";
					стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Товар " + Строка(Номенклатура));
					Если стРезультат.id > 0 Тогда
						сч = сч + 1;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				ТелоЗапроса = ДанныеТовара(СтрокаТовар, purchase_id, Ложь);
				Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
					ЗапросHTTP.АдресРесурса = "/api/purchase-spare/" + Формат(PurchaseSpare_id, "ЧГ=0,0");
					КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
					Если КодСостояния < 300 Тогда
						сч = сч + 1;
					КонецЕсли;					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат сч;
КонецФункции

Функция ЕстьПодходящаяАнкета(УзелОбмена, Клиент)	
	АдресПараметрыРесурса = "/api/personal-data-agreement/event?";
	Имя = СокрЛП(Клиент.Имя);
	Если ЗначениеЗаполнено(Имя) Тогда
		АдресПараметрыРесурса = АдресПараметрыРесурса + "firstName=" + Имя;
	Иначе
		Возврат Истина;
	КонецЕсли;
	Отчество = СокрЛП(Клиент.Отчество);
	Если ЗначениеЗаполнено(Отчество) Тогда
		АдресПараметрыРесурса = АдресПараметрыРесурса + "&middleName=" + Отчество;
	Иначе
		АдресПараметрыРесурса = АдресПараметрыРесурса + "&middleNameRequired=0";
	КонецЕсли;
	Фамилия = СокрЛП(Клиент.Фамилия);
	Если ЗначениеЗаполнено(Фамилия) Тогда
		АдресПараметрыРесурса = АдресПараметрыРесурса + "&lastName=" + Фамилия;
	Иначе
		Возврат Истина;
	КонецЕсли;
	СтруктураТелефон = ТелефонЦифрами(Клиент);
	Если ЗначениеЗаполнено(СтруктураТелефон.Представление) Тогда
		АдресПараметрыРесурса = АдресПараметрыРесурса + "&phone=" + СтруктураТелефон.Представление;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	РезультатАнкета = НайтиОбъектПоПараметрам(УзелОбмена, АдресПараметрыРесурса);
	Если РезультатАнкета = Неопределено Тогда
		Сообщить("Не выполнен запрос Анкеты СОПД для " + Строка(Клиент), СтатусСообщения.Внимание);
		Возврат Истина;
	ИначеЕсли ТипЗнч(РезультатАнкета) = Тип("Структура") Тогда
		Сообщить("У провайдера есть подходящая Анкета СОПД для " + Строка(Клиент), СтатусСообщения.Информация);
		Возврат Истина;
		
	ИначеЕсли ТипЗнч(РезультатАнкета) = Тип("Строка") Тогда
		Если РезультатАнкета = "null" Тогда
			Возврат Ложь;
		Иначе
			Сообщить("Запрос Анкеты СОПД для " + Строка(Клиент) + " вернул результат: " + РезультатАнкета, СтатусСообщения.Внимание);
			Возврат Истина;
		КонецЕсли;
		
	Иначе
		Сообщить("Некорректный ответ сервера на запрос Анкеты СОПД для " + Строка(Клиент), СтатусСообщения.Внимание);
		Возврат Истина;
	КонецЕсли;
КонецФункции

Процедура ВыгрузкаАвтодилерППО(УзелОбмена)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    ЗаказНаряд = ВыборкаИзменений.Получить();
		client_id = ВыгрузитьКлиента(УзелОбмена, ЗаказНаряд.Заказчик, ЗаказНаряд.Ссылка); // клиентом в заказ-наряде является Заказчик
		Если client_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
			Продолжить;
		ИначеЕсли client_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		car_id = ВыгрузитьАвтомобиль(УзелОбмена, ЗаказНаряд.Автомобиль, ЗаказНаряд.Ссылка);
		Если car_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
			Продолжить;
		ИначеЕсли car_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		purchase_id = ВыгрузитьЗаказНаряд(УзелОбмена, ЗаказНаряд, client_id, car_id);
		Если purchase_id > 0 Тогда
			счРаботы = ВыгрузитьРаботы(УзелОбмена, ЗаказНаряд, purchase_id);
			счТовары = ВыгрузитьТовары(УзелОбмена, ЗаказНаряд, purchase_id);
			Если счРаботы + счТовары > 0 Тогда
				ТелоЗапроса = "{""verify"":""approved""}";
				ЗапросHTTP.АдресРесурса = "/api/purchase/" + Формат(purchase_id, "ЧГ=0,0");
				КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			КонецЕсли;
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
			
		ИначеЕсли purchase_id = -422 Или purchase_id = -403 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
			Продолжить;			
		КонецЕсли;		
	КонецЦикла;
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

Функция ВыгрузкаЗаказНарядаДляАнкеты(УзелОбмена, ЗаказНаряд)
	ЕстьРегистрация = ПланыОбмена.ИзменениеЗарегистрировано(УзелОбмена, ЗаказНаряд);
	
	client_id = ВыгрузитьКлиента(УзелОбмена, ЗаказНаряд.Заказчик, ЗаказНаряд.Ссылка); // клиентом в заказ-наряде является Заказчик
	Если client_id = -422 Тогда
		Если ЕстьРегистрация Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
		КонецЕсли;
		Возврат client_id;
	ИначеЕсли client_id = 0 Тогда
		Возврат client_id;
	КонецЕсли;
	
	car_id = ВыгрузитьАвтомобиль(УзелОбмена, ЗаказНаряд.Автомобиль, ЗаказНаряд.Ссылка);
	Если car_id = -422 Тогда
		Если ЕстьРегистрация Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
		КонецЕсли;
		Возврат car_id;
	ИначеЕсли car_id = 0 Тогда
		Возврат car_id;
	КонецЕсли;
	
	purchase_id = ВыгрузитьЗаказНаряд(УзелОбмена, ЗаказНаряд, client_id, car_id);
	Если purchase_id > 0 Тогда
		счРаботы = ВыгрузитьРаботы(УзелОбмена, ЗаказНаряд, purchase_id);
		счТовары = ВыгрузитьТовары(УзелОбмена, ЗаказНаряд, purchase_id);
		Если счРаботы + счТовары > 0 Тогда
			НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
			ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
			ТелоЗапроса = "{""verify"":""approved""}";
			ЗапросHTTP.АдресРесурса = "/api/purchase/" + Формат(purchase_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
		КонецЕсли;
		Если ЕстьРегистрация Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
		КонецЕсли;
		
	ИначеЕсли purchase_id = -422 Или purchase_id = -403 Тогда
		Если ЕстьРегистрация Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаказНаряд);
		КонецЕсли;			
	КонецЕсли;
	Возврат purchase_id;
КонецФункции

//// Остатки и движения товаров
Функция ДанныеОстатокТовара(ВыборкаТовар, ЭтоВыгрузка = Истина)
	Если ВыборкаТовар.Количество < 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ВыборкаТовар.СебестоимостьБезНДС < 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ВыборкаТовар.СебестоимостьНДС < 0 Тогда
		Возврат "";
	КонецЕсли;
	
	стЗапись = Новый Структура();
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", СокрЛП(ВыборкаТовар.Артикул));	
		стЗапись.Вставить("manufacture", СокрЛП(ВыборкаТовар.Производитель));
		стЗапись.Вставить("measure", СокрЛП(ВыборкаТовар.ЕдиницаИзмерения));	
	КонецЕсли;
	
	стЗапись.Вставить("count", ВыборкаТовар.Количество);
	стЗапись.Вставить("name", СокрЛП(ВыборкаТовар.Наименование));
	стЗапись.Вставить("cost", Окр(ВыборкаТовар.СебестоимостьБезНДС, 2, РежимОкругления.Окр15как20));
	стЗапись.Вставить("cost_nds", Окр(ВыборкаТовар.СебестоимостьНДС, 2, РежимОкругления.Окр15как20));	
	стЗапись.Вставить("price", Окр(ВыборкаТовар.ЦенаБезНДС, 2, РежимОкругления.Окр15как20));	
	стЗапись.Вставить("price_nds", Окр(ВыборкаТовар.ЦенаНДС, 2, РежимОкругления.Окр15как20));
	стЗапись.Вставить("price_list_cost", стЗапись.price);	
	стЗапись.Вставить("price_list_cost_nds", стЗапись.price_nds);
	стЗапись.Вставить("status", 1);	
		
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки остатка '" + стЗапись.name + "' в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ДанныеКорректировкиОстаткаТовара(ВыборкаОстаток)	
	стЗапись = Новый Структура();
	Если ВыборкаОстаток.Следующий() Тогда
		Если ВыборкаОстаток.Количество < 0 Тогда
			Возврат "";
		КонецЕсли;
		Если ВыборкаОстаток.СебестоимостьБезНДС < 0 Тогда
			Возврат "";
		КонецЕсли;
		Если ВыборкаОстаток.СебестоимостьНДС < 0 Тогда
			Возврат "";
		КонецЕсли;
		стЗапись.Вставить("count", ВыборкаОстаток.Количество);
		стЗапись.Вставить("cost", Окр(ВыборкаОстаток.СебестоимостьБезНДС, 2, РежимОкругления.Окр15как20));
		стЗапись.Вставить("cost_nds", Окр(ВыборкаОстаток.СебестоимостьНДС, 2, РежимОкругления.Окр15как20));	
		стЗапись.Вставить("price", ВыборкаОстаток.ЦенаБезНДС);	
		стЗапись.Вставить("price_nds", ВыборкаОстаток.ЦенаНДС);	
		
	Иначе
		стЗапись.Вставить("count", 0);	
	КонецЕсли;	
		
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для корректировки остатка '" + ВыборкаОстаток.Наименование + "' в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ПолучитьКодыТранзакции(ВыборкаТовар)
	стКоды = Новый Структура();
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ОфициальныйПоставщик = Справочники.Контрагенты.НайтиПоКоду("ЦБ300933"); // ГРЕЙТ ВОЛЛ МОТОР РУС ООО
	
	Если ВыборкаТовар.ХозОперация = Справочники.ХозОперации.РеализацияТоваров Тогда
		Контрагент = ВыборкаТовар.Регистратор.Контрагент;
		Если ЗначениеЗаполнено(Контрагент) И Контрагент.ПринадлежитЭлементу(Справочники.Контрагенты.Оптовики) Тогда
			стКоды.Вставить("КодПодтипаТранзакции", 29); // Реализация оптовому клиенту
		Иначе
			стКоды.Вставить("КодПодтипаТранзакции", 26); // Реализация розничному клиенту
		КонецЕсли;
		
	ИначеЕсли ВыборкаТовар.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровВПроизводство Тогда
		ДокументПродажи = ВыборкаТовар.ДокументПродажи;
		Если ЗначениеЗаполнено(ДокументПродажи) И ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			Контрагент = ДокументПродажи.Заказчик;
			Если ДокументПродажи.ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт 
				Или ДокументПродажи.ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий Тогда
				стКоды.Вставить("КодПодтипаТранзакции", 20); // Реализация через ЗН (кузовной цех)
			Иначе
				стКоды.Вставить("КодПодтипаТранзакции", 17); // Реализация через ЗН (слесарный цех)
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ВыборкаТовар.Регистратор.ДокументОснование) = Тип("ДокументСсылка.КомплектацияАвтомобиля") Тогда
			Контрагент = ВыборкаТовар.Регистратор.ДокументОснование.Заказчик;
			стКоды.Вставить("КодПодтипаТранзакции", 17); // Реализация через ЗН (слесарный цех)
			
		Иначе
			стКоды.Вставить("КодПодтипаТранзакции", 17); // Реализация через ЗН (слесарный цех)
		КонецЕсли;
		
	ИначеЕсли ВыборкаТовар.ХозОперация = Справочники.ХозОперации.ПоступлениеТоваров Тогда
		Контрагент = ВыборкаТовар.Регистратор.Контрагент;
		Если Контрагент = ОфициальныйПоставщик Тогда
			стКоды.Вставить("КодПодтипаТранзакции", 2); // Поступление от ГВМР
		Иначе
			стКоды.Вставить("КодПодтипаТранзакции", 5); // Поступление от стороннего поставщика
		КонецЕсли;
		
	ИначеЕсли ВыборкаТовар.ХозОперация = Справочники.ХозОперации.СписаниеТоваров Тогда
		стКоды.Вставить("КодПодтипаТранзакции", 32); // Списание товаров
		
	Иначе
		Если ВыборкаТовар.ВидДвижения = 1 Тогда
			стКоды.Вставить("КодПодтипаТранзакции", 11); // Коррекция стока (+)
		Иначе
			стКоды.Вставить("КодПодтипаТранзакции", 35); // Коррекция стока (-)
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Если Контрагент = ОфициальныйПоставщик Тогда
			стКоды.Вставить("КодТипаКонтрагента", 11); // Импортер
			
		ИначеЕсли Контрагент.ПринадлежитЭлементу(Справочники.Контрагенты.Оптовики) Тогда
			стКоды.Вставить("КодТипаКонтрагента", 17); // Оптовый покупатель (ФЛ или ЮЛ)
			
		ИначеЕсли Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
			стКоды.Вставить("КодТипаКонтрагента", 5); // Физическое лицо, розничный клиент 
			
		ИначеЕсли Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо 
			Или Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
			стКоды.Вставить("КодТипаКонтрагента", 8); // Юридическое лицо, розничный клиент
			
		Иначе
			стКоды.Вставить("КодТипаКонтрагента", 23); // Другое
		КонецЕсли;
		
	Иначе
		стКоды.Вставить("КодТипаКонтрагента", 23); // Другое
	КонецЕсли;
	
	Возврат стКоды;
КонецФункции

Функция ДанныеДвижениеТовара(УзелОбмена, ВыборкаТовар, spare_id, ЭтоВыгрузка = Истина)
	Если ВыборкаТовар.Количество < 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ВыборкаТовар.СебестоимостьБезНДС < 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ВыборкаТовар.СебестоимостьНДС < 0 Тогда
		Возврат "";
	КонецЕсли;
	
	стЗапись = Новый Структура();
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", СокрЛП(ВыборкаТовар.Регистратор.Номер));
		стЗапись.Вставить("spare_id", spare_id);	
		стЗапись.Вставить("type", ВыборкаТовар.ВидДвижения);
	КонецЕсли;
	
	стЗапись.Вставить("datetime", Формат(ВыборкаТовар.Дата, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
	стЗапись.Вставить("count", ВыборкаТовар.Количество);
	стЗапись.Вставить("name", СокрЛП(ВыборкаТовар.Наименование));
	стЗапись.Вставить("cost", Окр(ВыборкаТовар.СебестоимостьБезНДС, 2, РежимОкругления.Окр15как20));
	стЗапись.Вставить("cost_nds", Окр(ВыборкаТовар.СебестоимостьНДС, 2, РежимОкругления.Окр15как20));	
	стЗапись.Вставить("price", Окр(ВыборкаТовар.ЦенаБезНДС, 2, РежимОкругления.Окр15как20));	
	стЗапись.Вставить("price_nds", Окр(ВыборкаТовар.ЦенаНДС, 2, РежимОкругления.Окр15как20));
	стЗапись.Вставить("status", 1);
	
	стКоды = ПолучитьКодыТранзакции(ВыборкаТовар);
	Если стКоды.Свойство("КодПодтипаТранзакции") И стКоды.Свойство("КодТипаКонтрагента") Тогда
		стЗапись.Вставить("sub_type_id", стКоды.КодПодтипаТранзакции);
		стЗапись.Вставить("partner_id", стКоды.КодТипаКонтрагента);
		
	Иначе
		Сообщить("Не удалось получить коды транзакции для " + стЗапись.name, СтатусСообщения.Внимание);
		Возврат "";
	КонецЕсли;
	
	ПризнакАкции = 0;
	Если ВыборкаТовар.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваровВПроизводство Тогда
		ДокументПродажи = ВыборкаТовар.ДокументПродажи;
		Если ЗначениеЗаполнено(ДокументПродажи) И ТипЗнч(ДокументПродажи) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			ВидРемонта = ДокументПродажи.ВидРемонта;
			
		ИначеЕсли ТипЗнч(ВыборкаТовар.Регистратор.ДокументОснование) = Тип("ДокументСсылка.КомплектацияАвтомобиля") Тогда
			ВидРемонта = Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером;
			
		Иначе
			Сообщить("Не удалось получить Вид ремонта для " + Строка(ВыборкаТовар.Регистратор), СтатусСообщения.Внимание);
			Возврат "";
		КонецЕсли;
		
		мзИдентификаторы = РегистрыСведений.УАЗDNMИдентификаторы.СоздатьМенеджерЗаписи();
		мзИдентификаторы.ВидРемонта = ВидРемонта;
		мзИдентификаторы.Прочитать();
		Если мзИдентификаторы.Выбран() Тогда
			Марка = УзелОбмена.МаркаАвтомобиля;
			Если Марка = Справочники.Марка.HAVAL Тогда
				стЗапись.Вставить("purchase_tag_id", мзИдентификаторы.HavalВидРемонта_id);
				
			Иначе
				Сообщить("Не удалось получить код Вида ремонта для " + Строка(ВыборкаТовар.Регистратор), СтатусСообщения.Внимание);
				Возврат "";
			КонецЕсли;
			
		Иначе
			Сообщить("Вид ремонта '" + Строка(ВидРемонта) + "' не выгружается в Автодилер!", СтатусСообщения.Внимание);
			Возврат "";
		КонецЕсли;
		
		Если СтрНайти(ВидРемонта.Наименование, "Акция") > 0 Тогда
			ПризнакАкции = 1;
		КонецЕсли;
	КонецЕсли;
	стЗапись.Вставить("is_promo", ПризнакАкции);
		
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки движения '" + ВыборкаТовар.Наименование + "' в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ДанныеРеализацияТоваров(ВыборкаРеализация, client_id, type, ЭтоВыгрузка = Истина)
	ЕстьСтроки = ВыборкаРеализация.Следующий();
	Если Не ЕстьСтроки Тогда
		Возврат "";
	КонецЕсли;
	
	стЗапись = Новый Структура();	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("client_id", client_id);	
		стЗапись.Вставить("code", Формат(ВыборкаРеализация.Дата, "ДФ=""г""") + СокрЛП(ВыборкаРеализация.Номер));
	КонецЕсли;	
	стЗапись.Вставить("date", Формат(ВыборкаРеализация.Дата, "ДФ=""дд.ММ.гггг"""));	
	стЗапись.Вставить("type", type);
	
	мТовары = Новый Массив();
	Пока ЕстьСтроки Цикл
		стСтрокаТовар = Новый Структура();
		стСтрокаТовар.Вставить("code", СокрЛП(ВыборкаРеализация.Артикул));
		стСтрокаТовар.Вставить("name", СокрЛП(ВыборкаРеализация.Наименование));
		стСтрокаТовар.Вставить("price", Окр(ВыборкаРеализация.Цена, 2, РежимОкругления.Окр15как20));	
		стСтрокаТовар.Вставить("quantity", ВыборкаРеализация.Количество);
		стСтрокаТовар.Вставить("discount", ВыборкаРеализация.СуммаСкидкиСтроки + ВыборкаРеализация.СуммаСкидки);
		стСтрокаТовар.Вставить("sum", Окр(ВыборкаРеализация.СуммаВсего, 2, РежимОкругления.Окр15как20));
		мТовары.Добавить(стСтрокаТовар);
		
		ЕстьСтроки = ВыборкаРеализация.Следующий();
	КонецЦикла;
	стЗапись.Вставить("spares", мТовары);		
		
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки движения '" + ВыборкаРеализация.Наименование + "' в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция НайтиДвижениеТовара(мМассив, spare_id)
	Для Каждого стСтруктура Из мМассив Цикл
		Если ТипЗнч(стСтруктура) = Тип("Структура") И стСтруктура.Свойство("spare_id") И стСтруктура.spare_id = spare_id Тогда
			Если стСтруктура.Свойство("id") Тогда
				Возврат стСтруктура.id;
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат 0;
КонецФункции

Функция ПолучитьОстаткиИзDNM(НТТР, ЗапросHTTP)
	//Если ТоварыРаботы Тогда
	//	ЗапросHTTP.АдресРесурса = ЗапросHTTP.АдресРесурса + "?purchase_id=" + ВнешнийКод;
	//Иначе
	//	ЗапросHTTP.АдресРесурса = ЗапросHTTP.АдресРесурса + "?code=" + ВнешнийКод;
	//КонецЕсли;	
	мОстатки = Новый Массив();
	Для сч = 1 По 5 Цикл
		мОстатки.Очистить();
		Попытка
			ЗапросHTTP.АдресРесурса = ЗапросHTTP.АдресРесурса + "?per-page=50";
			НТТРОтвет = НТТР.Получить(ЗапросHTTP);
			ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
			Если НТТРОтвет.КодСостояния < 300 Тогда
				ВсегоСтраниц = НТТРОтвет.Заголовки.Получить("x-pagination-page-count");
				Если ВсегоСтраниц = Неопределено Тогда
					Продолжить;
				ИначеЕсли ВсегоСтраниц = 0 Тогда
					Возврат Неопределено;
				КонецЕсли;
				
				ЧтениеJSON = Новый ЧтениеJSON();
				ЧтениеJSON.УстановитьСтроку(ТелоОтвета);				
				мОстатки = ПрочитатьJSON(ЧтениеJSON);
				Если ТипЗнч(мОстатки) = Тип("Массив") Тогда
					Если мОстатки.Количество() > 0 Тогда
						Если ВсегоСтраниц = 1 Тогда
							Возврат мОстатки;				
						КонецЕсли;						
					Иначе
						Возврат Неопределено;
					КонецЕсли;
					
				Иначе
					Возврат Неопределено;
				КонецЕсли;	
				
			Иначе
			#Если Клиент Тогда
				Сообщить("Получение остатков из DNM " + ЗапросHTTP.АдресРесурса + "(попытка " + сч + "):" + Символы.ПС 
				+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
				+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
			#КонецЕсли
				Продолжить;
			КонецЕсли;				
			
		Исключение
			#Если Клиент Тогда
				Сообщить("Ошибка при получении остатков из DNM (попытка " + сч + "):" + Символы.ПС 
				+ ОписаниеОшибки()); 
			#КонецЕсли
			Продолжить;
		КонецПопытки;
		
		АдресРесурса = ЗапросHTTP.АдресРесурса;
		Для нстр = 2 По ВсегоСтраниц Цикл
			ЗапросHTTP.АдресРесурса = АдресРесурса + "&page=" + Формат(нстр, "ЧГ=0,0");
			Попытка
				НТТРОтвет = НТТР.Получить(ЗапросHTTP);
				ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
				Если НТТРОтвет.КодСостояния < 300 Тогда					
					ЧтениеJSON = Новый ЧтениеJSON();
					ЧтениеJSON.УстановитьСтроку(ТелоОтвета);				
					мОтвет = ПрочитатьJSON(ЧтениеJSON);
					Если ТипЗнч(мОтвет) = Тип("Массив") Тогда
						Если мОтвет.Количество() > 0 Тогда
							Для Каждого стОстаток Из мОтвет Цикл
								мОстатки.Добавить(стОстаток);
							КонецЦикла;
				
						Иначе
							Возврат Неопределено;
						КонецЕсли;
						
					Иначе
						Возврат Неопределено;
					КонецЕсли;	
					
				Иначе
				#Если Клиент Тогда
					Сообщить("Получение остатков из DNM " + ЗапросHTTP.АдресРесурса + "(попытка " + сч + "):" + Символы.ПС 
					+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
					+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
				#КонецЕсли
					Продолжить; // проблемы с продолжением!!!!!!!
				КонецЕсли;				
				
			Исключение
				#Если Клиент Тогда
					Сообщить("Ошибка при получении остатков из DNM (попытка " + сч + "):" + Символы.ПС 
					+ ОписаниеОшибки()); 
				#КонецЕсли
				Продолжить;
			КонецПопытки;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция ПолучитьНоменклатуру(ГруппаПроизводителей)
	ЗапросНоменклатура = Новый Запрос();
	ЗапросНоменклатура.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	ЗапросНоменклатура.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	|	И НЕ Номенклатура.ПометкаУдаления";
	
	тзАртикулы = ЗапросНоменклатура.Выполнить().Выгрузить();
	Если тзАртикулы.Количество() > 0 Тогда
		Возврат тзАртикулы.ВыгрузитьКолонку(0);
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции

Процедура ВыгрузитьОстаткиНоменклатуры(УзелОбмена)
	Если УзелОбмена.МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
		ГруппаПроизводителей = Справочники.Производители.Fiat;
		
	ИначеЕсли УзелОбмена.МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
		ГруппаПроизводителей = Справочники.Производители.Chrysler;
		
	ИначеЕсли УзелОбмена.МаркаАвтомобиля = Справочники.Марка.HAVAL Тогда
		ГруппаПроизводителей = Справочники.Производители.HAVAL;
	Иначе
		Возврат;
	КонецЕсли;
	
	ПодразделениеДилера = УзелОбмена.Подразделение;
	СтавкаНДС = СМГ_ПолучитьСтавкуНДС(ПодразделениеДилера.Организация);
	ЗапросОстатки = Новый Запрос();
	ЗапросОстатки.УстановитьПараметр("ГруппаПодразделений", ПодразделениеДилера.Родитель);
	ЗапросОстатки.УстановитьПараметр("ЦеныПродажи", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	ЗапросОстатки.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	ЗапросОстатки.УстановитьПараметр("СтавкаНДС", СтавкаНДС.Ставка);
	ЗапросОстатки.УстановитьПараметр("ПодразделениеДилера", ПодразделениеДилера);
	ЗапросОстатки.УстановитьПараметр("Обычный", Перечисления.ВидыСкладов.Обычный);
	ЗапросОстатки.Текст =
	"ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	СРЕДНЕЕ(ЦеныСрезПоследних.Цена * 100 / (100 + &СтавкаНДС)) КАК ЦенаБезНДС,
	|	СРЕДНЕЕ(ЦеныСрезПоследних.Цена * &СтавкаНДС / (100 + &СтавкаНДС)) КАК ЦенаНДС
	|ПОМЕСТИТЬ Цены
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделений)
	|	И ЦеныСрезПоследних.ТипЦен = &ЦеныПродажи
	|	И ЦеныСрезПоследних.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныСрезПоследних.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Наименование КАК Наименование,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.АртикулАЦ КАК Артикул,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Производитель.Наименование КАК Производитель,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(ПартииТоваровКомпанииОстатки.КоличествоОстаток) КАК Количество,
	|	СРЕДНЕЕ(ВЫБОР
	|			КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	|				ТОГДА (ПартииТоваровКомпанииОстатки.СуммаОстаток - ПартииТоваровКомпанииОстатки.СуммаНДСОстаток) / ПартииТоваровКомпанииОстатки.КоличествоОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СебестоимостьБезНДС,
	|	СРЕДНЕЕ(ВЫБОР
	|			КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	|				ТОГДА ПартииТоваровКомпанииОстатки.СуммаНДСОстаток / ПартииТоваровКомпанииОстатки.КоличествоОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СебестоимостьНДС,
	|	ПартииТоваровКомпанииОстатки.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ОстаткиПартий
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании.Остатки КАК ПартииТоваровКомпанииОстатки
	|ГДЕ
	|	ПартииТоваровКомпанииОстатки.СкладКомпании.Подразделение = &ПодразделениеДилера
	|	И ПартииТоваровКомпанииОстатки.СкладКомпании.ВидСклада = &Обычный
	|	И ПартииТоваровКомпанииОстатки.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	|	И ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Наименование,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.АртикулАЦ,
	|	ПартииТоваровКомпанииОстатки.Номенклатура,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Производитель.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиПартий.Артикул КАК Артикул,
	|	ОстаткиПартий.Наименование КАК Наименование,
	|	ОстаткиПартий.Производитель КАК Производитель,
	|	ОстаткиПартий.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ОстаткиПартий.Количество КАК Количество,
	|	ОстаткиПартий.СебестоимостьБезНДС КАК СебестоимостьБезНДС,
	|	ОстаткиПартий.СебестоимостьНДС КАК СебестоимостьНДС,
	|	ЕСТЬNULL(Цены.ЦенаБезНДС, 0) КАК ЦенаБезНДС,
	|	ЕСТЬNULL(Цены.ЦенаНДС, 0) КАК ЦенаНДС
	|ИЗ
	|	ОстаткиПартий КАК ОстаткиПартий
	|		ЛЕВОЕ СОЕДИНЕНИЕ Цены КАК Цены
	|		ПО ОстаткиПартий.Номенклатура = Цены.Номенклатура";
	
	РезультатОстатки = ЗапросОстатки.Выполнить();
	Если РезультатОстатки.Пустой() Тогда
		Сообщить("Склад дилера " + Строка(УзелОбмена.Подразделение) + " пустой!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	
	ВыборкаОстатки = РезультатОстатки.Выбрать();	
	Пока ВыборкаОстатки.Следующий() Цикл
		ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/spare";
		мТовар = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, СокрЛП(ВыборкаОстатки.Артикул));
		Если мТовар = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		spare_id = ПолучитьИдентификатор(мТовар);				
		Если spare_id > 0 Тогда
			ТелоЗапроса = ДанныеОстатокТовара(ВыборкаОстатки, Ложь);
			Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
				ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/spare/" + Формат(spare_id, "ЧГ=0,0");
				КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Иначе
				Продолжить;
			КонецЕсли;
							
		Иначе
			ТелоЗапроса = ДанныеОстатокТовара(ВыборкаОстатки);
			Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
				ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/spare";
				стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Остатки товара " + ВыборкаОстатки.Наименование);
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция КорректировкаОстаткаТовара(УзелОбмена, Артикул, spare_id)
	Если УзелОбмена.МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
		ГруппаПроизводителей = Справочники.Производители.Fiat;
	ИначеЕсли УзелОбмена.МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
		ГруппаПроизводителей = Справочники.Производители.Chrysler;
	Иначе
		Возврат "";
	КонецЕсли;
	
	ЗапросОстаток = Новый Запрос();
	ЗапросОстаток.УстановитьПараметр("ГруппаПодразделений", Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
	ЗапросОстаток.УстановитьПараметр("ЦеныПродажи", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	ЗапросОстаток.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	ЗапросОстаток.УстановитьПараметр("ПодразделениеДилера", УзелОбмена.Подразделение);
	ЗапросОстаток.УстановитьПараметр("Обычный", Перечисления.ВидыСкладов.Обычный);
	ЗапросОстаток.УстановитьПараметр("Артикул", Артикул);
	ЗапросОстаток.Текст =
	"ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура,
	|	СРЕДНЕЕ(ЦеныСрезПоследних.Цена * 100 / (100 + ЦеныСрезПоследних.Номенклатура.СтавкаНДС.Ставка)) КАК ЦенаБезНДС,
	|	СРЕДНЕЕ(ЦеныСрезПоследних.Цена * ЦеныСрезПоследних.Номенклатура.СтавкаНДС.Ставка / (100 + ЦеныСрезПоследних.Номенклатура.СтавкаНДС.Ставка)) КАК ЦенаНДС
	|ПОМЕСТИТЬ Цены
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.Номенклатура.Артикул = &Артикул
	|	И ЦеныСрезПоследних.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделений)
	|	И ЦеныСрезПоследних.ТипЦен = &ЦеныПродажи
	|	И ЦеныСрезПоследних.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныСрезПоследних.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Наименование КАК Наименование,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Артикул КАК Артикул,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Производитель.Наименование КАК Производитель,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(ПартииТоваровКомпанииОстатки.КоличествоОстаток) КАК Количество,
	|	СРЕДНЕЕ(ВЫБОР
	|			КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	|				ТОГДА (ПартииТоваровКомпанииОстатки.СуммаОстаток - ПартииТоваровКомпанииОстатки.СуммаНДСОстаток) / ПартииТоваровКомпанииОстатки.КоличествоОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СебестоимостьБезНДС,
	|	СРЕДНЕЕ(ВЫБОР
	|			КОГДА ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	|				ТОГДА ПартииТоваровКомпанииОстатки.СуммаНДСОстаток / ПартииТоваровКомпанииОстатки.КоличествоОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СебестоимостьНДС,
	|	ПартииТоваровКомпанииОстатки.Номенклатура
	|ПОМЕСТИТЬ ОстаткиПартий
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании.Остатки КАК ПартииТоваровКомпанииОстатки
	|ГДЕ
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Артикул = &Артикул
	|	И ПартииТоваровКомпанииОстатки.СкладКомпании.Подразделение = &ПодразделениеДилера
	|	И ПартииТоваровКомпанииОстатки.СкладКомпании.ВидСклада = &Обычный
	|	И ПартииТоваровКомпанииОстатки.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	//|	И ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Наименование,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Артикул,
	|	ПартииТоваровКомпанииОстатки.Номенклатура,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения,
	|	ПартииТоваровКомпанииОстатки.Номенклатура.Производитель.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиПартий.Артикул,
	|	ОстаткиПартий.Наименование,
	|	ОстаткиПартий.Производитель,
	|	ОстаткиПартий.ЕдиницаИзмерения,
	|	ОстаткиПартий.Количество,
	|	ОстаткиПартий.СебестоимостьБезНДС,
	|	ОстаткиПартий.СебестоимостьНДС,
	|	ЕСТЬNULL(Цены.ЦенаБезНДС, 0) КАК ЦенаБезНДС,
	|	ЕСТЬNULL(Цены.ЦенаНДС, 0) КАК ЦенаНДС
	|ИЗ
	|	ОстаткиПартий КАК ОстаткиПартий
	|		ЛЕВОЕ СОЕДИНЕНИЕ Цены КАК Цены
	|		ПО ОстаткиПартий.Номенклатура = Цены.Номенклатура";
	
	ВыборкаОстаток = ЗапросОстаток.Выполнить().Выбрать();
	
	ТелоЗапроса = ДанныеКорректировкиОстаткаТовара(ВыборкаОстаток);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
		ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
		ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/spare/" + Формат(spare_id, "ЧГ=0,0");
		КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
		
	Иначе
		КодСостояния = 800;
	КонецЕсли;
	
	Возврат КодСостояния;
КонецФункции

Функция ПолучитьДвиженияТоваров(ПодразделениеДилера, ГруппаПроизводителей)
	ДатаДвижений = ТекущаяДата();
	//ДатаДвижений = '20260525';
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ГруппаПодразделенийЦены", ПодразделениеДилера.Родитель);
	ЗапросДвижения.УстановитьПараметр("ЦеныПродажи", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	ЗапросДвижения.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	ЗапросДвижения.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаДвижений));
	ЗапросДвижения.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаДвижений));
	ЗапросДвижения.УстановитьПараметр("Обычный", Перечисления.ВидыСкладов.Обычный);
	ЗапросДвижения.УстановитьПараметр("ПодразделениеДилера", ПодразделениеДилера);
	
	ЗапросДвижения.Текст =
	"ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	|	СРЕДНЕЕ(ЦеныСрезПоследних.Цена * 100 / (100 + ЦеныСрезПоследних.Номенклатура.СтавкаНДС.Ставка)) КАК ЦенаБезНДС,
	|	СРЕДНЕЕ(ЦеныСрезПоследних.Цена * ЦеныСрезПоследних.Номенклатура.СтавкаНДС.Ставка / (100 + ЦеныСрезПоследних.Номенклатура.СтавкаНДС.Ставка)) КАК ЦенаНДС
	|ПОМЕСТИТЬ Цены
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделенийЦены)
	|	И ЦеныСрезПоследних.ТипЦен = &ЦеныПродажи
	|	И ЦеныСрезПоследних.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныСрезПоследних.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПартииТоваровКомпании.Номенклатура.Наименование КАК Наименование,
	|	ПартииТоваровКомпании.Номенклатура.АртикулАЦ КАК Артикул,
	|	ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПартииТоваровКомпании.Номенклатура.Производитель.Наименование КАК Производитель,
	|	ПартииТоваровКомпании.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ПартииТоваровКомпании.Количество > 0
	|			ТОГДА (ПартииТоваровКомпании.Сумма - ПартииТоваровКомпании.СуммаНДС) / ПартииТоваровКомпании.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СебестоимостьБезНДС,
	|	ВЫБОР
	|		КОГДА ПартииТоваровКомпании.Количество > 0
	|			ТОГДА ПартииТоваровКомпании.СуммаНДС / ПартииТоваровКомпании.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СебестоимостьНДС,
	|	ПартииТоваровКомпании.Период КАК Дата,
	|	ПартииТоваровКомпании.ХозОперация КАК ХозОперация,
	|	ПартииТоваровКомпании.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА ПартииТоваровКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ВидДвижения,
	|	ПартииТоваровКомпании.Номенклатура КАК Номенклатура,
	|	ПартииТоваровКомпании.ДокументПродажи КАК ДокументПродажи
	|ПОМЕСТИТЬ ДвиженияТоваров
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|ГДЕ
	|	ПартииТоваровКомпании.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПартииТоваровКомпании.СкладКомпании.ВидСклада = &Обычный
	|	И ПартииТоваровКомпании.СкладКомпании.Подразделение = &ПодразделениеДилера
	|	И ПартииТоваровКомпании.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)
	|	И ПартииТоваровКомпании.ХозОперация <> ЗНАЧЕНИЕ(Справочник.ХозОперации.ПеремещениеТоваров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДвиженияТоваров.Дата КАК Дата,
	|	ДвиженияТоваров.ХозОперация КАК ХозОперация,
	|	ДвиженияТоваров.Регистратор КАК Регистратор,
	|	ДвиженияТоваров.ВидДвижения КАК ВидДвижения,
	|	ДвиженияТоваров.ДокументПродажи КАК ДокументПродажи,
	|	ДвиженияТоваров.Артикул КАК Артикул,
	|	ДвиженияТоваров.Наименование КАК Наименование,
	|	ДвиженияТоваров.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ДвиженияТоваров.Производитель КАК Производитель,
	|	ДвиженияТоваров.Количество КАК Количество,
	|	ДвиженияТоваров.СебестоимостьБезНДС КАК СебестоимостьБезНДС,
	|	ДвиженияТоваров.СебестоимостьНДС КАК СебестоимостьНДС,
	|	ЕСТЬNULL(Цены.ЦенаБезНДС, 0) КАК ЦенаБезНДС,
	|	ЕСТЬNULL(Цены.ЦенаНДС, 0) КАК ЦенаНДС
	|ИЗ
	|	ДвиженияТоваров КАК ДвиженияТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Цены КАК Цены
	|		ПО ДвиженияТоваров.Номенклатура = Цены.Номенклатура";
	
	Возврат ЗапросДвижения.Выполнить().Выбрать();
КонецФункции

Функция ВыгрузитьДвиженияТоваров(УзелОбмена)
	Если УзелОбмена.МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
		ГруппаПроизводителей = Справочники.Производители.Fiat;
	ИначеЕсли УзелОбмена.МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
		ГруппаПроизводителей = Справочники.Производители.Chrysler;
	ИначеЕсли УзелОбмена.МаркаАвтомобиля = Справочники.Марка.HAVAL Тогда
		ГруппаПроизводителей = Справочники.Производители.HAVAL;
	Иначе
		Возврат 1;
	КонецЕсли;
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	
	ВыборкаДвижения = ПолучитьДвиженияТоваров(УзелОбмена.Подразделение, ГруппаПроизводителей);
	Если ВыборкаДвижения.Количество() = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	сч = 0;
	Пока ВыборкаДвижения.Следующий() Цикл
		spare_id = 0;	
		ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/spare";
		Артикул = СокрЛП(ВыборкаДвижения.Артикул);
		мТовар = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, Артикул);
		Если мТовар = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		spare_id = ПолучитьИдентификатор(мТовар);
		
		Если spare_id > 0 Тогда
			ТелоЗапроса = ДанныеДвижениеТовара(УзелОбмена, ВыборкаДвижения, spare_id);
			Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
				ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/transaction";
				стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Движение товара " + ВыборкаДвижения.Наименование);
				Если стРезультат.id > 0 Тогда
					//КодСостояния = КорректировкаОстаткаТовара(УзелОбмена, Артикул, spare_id);
					//Если КодСостояния < 300 Тогда
						сч = сч + 1;
					//КонецЕсли;		
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли ВыборкаДвижения.ВидДвижения = 1 Тогда
			ТелоЗапроса = ДанныеОстатокТовара(ВыборкаДвижения);
			Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
				ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/spare";
				стОстатокРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Остатки товара " + ВыборкаДвижения.Наименование);
				Если стОстатокРезультат.id > 0 Тогда
					ТелоЗапроса = ДанныеДвижениеТовара(УзелОбмена, ВыборкаДвижения, стОстатокРезультат.id);
					Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
						ЗапросHTTP.АдресРесурса = "/api/spare-warehouse/transaction";
						стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Движение товара " + ВыборкаДвижения.Наименование);
						Если стРезультат.id > 0 Тогда
							сч = сч + 1;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			сч = сч + 1;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат сч;
КонецФункции

Функция ВыгрузитьРеализациюТоваров(УзелОбмена, Реализация, ГруппаПроизводителей)	
	ЗапросРеализации = Новый Запрос();
	ЗапросРеализации.УстановитьПараметр("РеализацияСсылка", Реализация.Ссылка);
	ЗапросРеализации.УстановитьПараметр("ГруппаПроизводителей", ГруппаПроизводителей);
	ЗапросРеализации.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровТовары.Ссылка.Номер КАК Номер,
	|	РеализацияТоваровТовары.Ссылка.Дата КАК Дата,
	|	РеализацияТоваровТовары.Номенклатура.Артикул КАК Артикул,
	|	РеализацияТоваровТовары.Номенклатура.Наименование КАК Наименование,
	|	РеализацияТоваровТовары.Цена,
	|	РеализацияТоваровТовары.Количество,
	|	РеализацияТоваровТовары.СуммаСкидкиСтроки,
	|	РеализацияТоваровТовары.СуммаСкидки,
	|	РеализацияТоваровТовары.СуммаВсего
	|ИЗ
	|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	|ГДЕ
	|	РеализацияТоваровТовары.Ссылка = &РеализацияСсылка
	|	И РеализацияТоваровТовары.Номенклатура.Производитель В ИЕРАРХИИ(&ГруппаПроизводителей)";
	
	РезультатРеализации = ЗапросРеализации.Выполнить();
	Если РезультатРеализации.Пустой() Тогда
		Возврат 1;
	КонецЕсли;
	
 	client_id = ВыгрузитьКлиента(УзелОбмена, Реализация.Контрагент, Реализация.Ссылка);
	Если client_id = -422 Или client_id = 0 Тогда
		Возврат client_id;
	КонецЕсли;

	ВыборкаРеализация = РезультатРеализации.Выбрать();	
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/spare-sale";
	code = Формат(Реализация.Дата, "ДФ=""г""") + СокрЛП(Реализация.Номер);
	мРеализации = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, code);
	Если мРеализации = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Реализация.Контрагент.НашаФирма Тогда
		type = 2;
	Иначе
		type = 1;
	КонецЕсли;
	
	sale_id = ПолучитьИдентификатор(мРеализации);	
	Если sale_id > 0 Тогда
		ТелоЗапроса = ДанныеРеализацияТоваров(ВыборкаРеализация, client_id, type, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/spare-sale/" + Формат(sale_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат sale_id;
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат sale_id;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеРеализацияТоваров(ВыборкаРеализация, client_id, type);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/spare-sale";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(Реализация));
			Возврат стРезультат.id;
		Иначе
			Возврат 1;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Процедура ВыгрузкаАвтодилерДвижения(УзелОбмена)
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    ДокументДвижения = ВыборкаИзменений.Получить();		
		сч = ВыгрузитьДвиженияТоваров(УзелОбмена);
		Если сч > 0 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ДокументДвижения);
		Иначе
			Продолжить;
		КонецЕсли;		
	КонецЦикла;
	//ЗаписьСообщения.ПрерватьЗапись();
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

Процедура ВыгрузкаАвтодилерРеализации(УзелОбмена)
	МаркаАвтомобиля = УзелОбмена.МаркаАвтомобиля;
	Если МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
		ГруппаПроизводителей = Справочники.Производители.Fiat;
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
		ГруппаПроизводителей = Справочники.Производители.Chrysler;
	Иначе
		Сообщить("В узле обмена '" + Строка(УзелОбмена) + "' указана неверная марка автомобиля!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    Реализация = ВыборкаИзменений.Получить();		
		sale_id = ВыгрузитьРеализациюТоваров(УзелОбмена, Реализация, ГруппаПроизводителей);
		Если sale_id > 0 Или sale_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, Реализация);		
		КонецЕсли;	
	КонецЦикла;
	//ЗаписьСообщения.ПрерватьЗапись();
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

//// Калькуляция
Функция ДанныеКалькуляция(ЗаявкаНаРемонт, client_id, car_id, purchase_id, ГруппаПроизводителей, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер));
		стЗапись.Вставить("purchase_id", purchase_id);	
		стЗапись.Вставить("client_id", client_id);	
		стЗапись.Вставить("car_id", car_id);	
	КонецЕсли;	
	стЗапись.Вставить("date_next_contact", Формат(ЗаявкаНаРемонт.ДатаВремяОбзвона, "ДФ=""дд.ММ.гггг"""));	
	
	мРаботы = Новый Массив();
	Для Каждого СтрокаРабота Из ЗаявкаНаРемонт.Работы Цикл
		стРабота = Новый Структура();
		Работа = СтрокаРабота.Работа;
		стРабота.Вставить("code", СокрЛП(Работа.Код));	
		стРабота.Вставить("name", Работа.Наименование);
		стРабота.Вставить("price", Окр(СтрокаРабота.Цена, 4, РежимОкругления.Окр15как20));
		стРабота.Вставить("quantity", СтрокаРабота.Коэффициент); // время выполнения
		стРабота.Вставить("sum", Окр(СтрокаРабота.СуммаВсего, 4, РежимОкругления.Окр15как20));	
		стРабота.Вставить("status", 1); //1 - Рекомендация, 2 - Выполнен, 3 - Отказ	
		мРаботы.Добавить(стРабота);
	КонецЦикла;
	Если мРаботы.Количество() > 0 Тогда
		стЗапись.Вставить("works", мРаботы);
	КонецЕсли;
	
	мТовары = Новый Массив();
	Для Каждого СтрокаТовар Из ЗаявкаНаРемонт.Товары Цикл
		стТовар = Новый Структура();
		Номенклатура = СтрокаТовар.Номенклатура;
		//Если Не ВИерархии(Номенклатура.Производитель, ГруппаПроизводителей) Тогда
		//	Продолжить;
		//КонецЕсли;	
		стТовар.Вставить("code", СокрЛП(Номенклатура.Артикул));	
		стТовар.Вставить("name", Номенклатура.Наименование);
		стТовар.Вставить("price", Окр(СтрокаТовар.Цена, 4, РежимОкругления.Окр15как20));
		стТовар.Вставить("quantity", СтрокаТовар.Количество);
		стТовар.Вставить("sum", Окр(СтрокаТовар.СуммаВсего, 4, РежимОкругления.Окр15как20));	
		стТовар.Вставить("status", 1); //1 - Рекомендация, 2 - Выполнен, 3 - Отказ	
		мТовары.Добавить(стТовар);
	КонецЦикла;	
	Если мТовары.Количество() > 0 Тогда
		стЗапись.Вставить("spares", мТовары);
	КонецЕсли;
	
	Комментарий = СокрЛП(ЗаявкаНаРемонт.Комментарий);
	Если ЗначениеЗаполнено(Комментарий) Тогда
		стЗапись.Вставить("comment", Комментарий);
	Иначе
		стЗапись.Вставить("comment", "Калькуляция отложенных работ к " + Строка(ЗаявкаНаРемонт.ДокументОснование));
	КонецЕсли;	
	стЗапись.Вставить("status", 1); //1 - Активна, 2 - Выполнена, 3 - Выполнена частично, 4 - Не актуально, 5 - Удалена
		
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки калькуляции '" + Строка(ЗаявкаНаРемонт) + "' в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ВыгрузитьКалькуляцию(УзелОбмена, ЗаявкаНаРемонт, client_id, car_id, ГруппаПроизводителей)
	Комментарий = СокрЛП(ЗаявкаНаРемонт.Комментарий);
	Если обЗначениеНеЗаполнено(Комментарий) И ЗаявкаНаРемонт.Работы.Количество() = 0 И ЗаявкаНаРемонт.Товары.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/purchase";
	code = СокрЛП(ЗаявкаНаРемонт.ДокументОснование.Номер);
	мЗаказНаряд = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, code);
	Если мЗаказНаряд = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	purchase_id = ПолучитьИдентификатор(мЗаказНаряд);	
	Если purchase_id = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ЗапросHTTP.АдресРесурса = "/api/repair-calc";
	code = Формат(ЗаявкаНаРемонт.Дата, "ДФ=""г""") + СокрЛП(ЗаявкаНаРемонт.Номер);
	мКалькуляции = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, code);
	Если мКалькуляции = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	calc_id = ПолучитьИдентификатор(мКалькуляции);		
	Если calc_id > 0 Тогда
		ТелоЗапроса = ДанныеКалькуляция(ЗаявкаНаРемонт, client_id, car_id, purchase_id, ГруппаПроизводителей, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/repair-calc/" + Формат(calc_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат calc_id;
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат calc_id;
		КонецЕсли;	

	Иначе
		ТелоЗапроса = ДанныеКалькуляция(ЗаявкаНаРемонт, client_id, car_id, purchase_id, ГруппаПроизводителей);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/repair-calc";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(ЗаявкаНаРемонт));
			Возврат стРезультат.id;
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;	
КонецФункции

Процедура ВыгрузкаАвтодилерКалькуляции(УзелОбмена)
	МаркаАвтомобиля = УзелОбмена.МаркаАвтомобиля;
	Если МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
		ГруппаПроизводителей = Справочники.Производители.Fiat;
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
		ГруппаПроизводителей = Справочники.Производители.Chrysler;
	Иначе
		Сообщить("В узле обмена '" + Строка(УзелОбмена) + "' указана неверная марка автомобиля!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    ЗаявкаНаРемонт = ВыборкаИзменений.Получить();
		client_id = ВыгрузитьКлиента(УзелОбмена, ЗаявкаНаРемонт.Заказчик, ЗаявкаНаРемонт.Ссылка); // клиентом является Заказчик
		Если client_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
			Продолжить;
		ИначеЕсли client_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Автомобили") И ЗначениеЗаполнено(ЗаявкаНаРемонт.Автомобиль) Тогда
			Автомобиль = ЗаявкаНаРемонт.Автомобиль;
		Иначе
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
			Продолжить;
		КонецЕсли;
		car_id = ВыгрузитьАвтомобиль(УзелОбмена, Автомобиль, ЗаявкаНаРемонт.Ссылка);
		Если car_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
			Продолжить;
		ИначеЕсли car_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		calc_id = ВыгрузитьКалькуляцию(УзелОбмена, ЗаявкаНаРемонт, client_id, car_id, ГруппаПроизводителей);
		Если calc_id > 0 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ЗаявкаНаРемонт);
		Иначе
			Продолжить;
		КонецЕсли;		
	КонецЦикла;
	//ЗаписьСообщения.ПрерватьЗапись();
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

