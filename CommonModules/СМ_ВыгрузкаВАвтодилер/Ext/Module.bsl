				стСогласие.Вставить("status_id", 1);
				стСогласие.Вставить("startedAt", ДатаСогласия);
				стСогласие.Вставить("expiredAt", ДатаОкончанияСогласия);
				Согласия.Добавить(стСогласие);
				стСогласие = Новый Структура();
				стСогласие.Вставить("type_id", 6);
				стСогласие.Вставить("status_id", 1);
				стСогласие.Вставить("startedAt", ДатаСогласия);
				стСогласие.Вставить("expiredAt", ДатаОкончанияСогласия);
				Согласия.Добавить(стСогласие);
				стЗапись.Вставить("personalDataList", Согласия);
			КонецЕсли;
			
		Иначе
			стЗапись.Вставить("may_process_personal_data", 0);
			стЗапись.client_confirm_communication = 0;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Клиент.Пол) И Клиент.Пол = Перечисления.ПолФизическихЛиц.Женский Тогда
			стЗапись.Вставить("sex", 0);
		Иначе
			стЗапись.Вставить("sex", 1);
		КонецЕсли;
		
		СтруктураТелефон = ТелефонЦифрами(Клиент);
