			МассивДолжностей.Добавить(12);
		ИначеЕсли Должность = Справочники.Должности.РуководительОтделаПродажАвтомобилейСПробегом Тогда
			МассивДолжностей.Добавить(15);
		Иначе
			МассивДолжностей.Добавить(18);
		КонецЕсли;
		стЗапись.Вставить("position_list", МассивДолжностей);
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.UAZ Тогда
