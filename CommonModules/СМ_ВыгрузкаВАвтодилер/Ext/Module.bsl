		КодБренда = 2708; // HONGQI
		КодАлиаса = мзИдентификаторыDSF.HongqiDSF_id;
	
	//ИначеЕсли МаркаАвтомобиля = Справочники.Марка.FIAT Тогда
	//	КодБренда = 45; // Fiat
	//ИначеЕсли МаркаАвтомобиля = Справочники.Марка.JEEP Тогда
	//	КодБренда = 63; // Jeep
		
	Иначе
