		#КонецЕсли
		Возврат 0;
	КонецЕсли;
	
	code = СокрЛП(РабочийЛист.Номер);
	мАвтомобиль = НайтиОбъекты(УзелОбмена, "/api/need", code);
	Если мАвтомобиль = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	car_id = ПолучитьИдентификатор(мАвтомобиль);
	// 28.09.2022 этот код через несколько месяцев можно удалить
	Если car_id = 0 Тогда
		code = Формат(РабочийЛист.Дата, "ДФ=""г""") + code;
		мАвтомобиль = НайтиОбъекты(УзелОбмена, "/api/need", code);
