			КонецЕсли;
						
		ИначеЕсли Марка = Справочники.Марка.LADA_ВАЗ Тогда // LADA_ВАЗ
			КодОтказа = Событие.ПричинаОтмены.КодЛада;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 15);	
			КонецЕсли;
						
		ИначеЕсли Марка = Справочники.Марка.GAC Тогда // GAC
			КодОтказа = Событие.ПричинаОтмены.КодGAC;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
