Процедура РегистрацияДвиженийТоваров(УзелОбмена, Источник)	
	Если Не Источник.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.Метаданные().Реквизиты.Найти("СкладКомпании") = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Подразделение = УзелОбмена.Подразделение; 
	Если Источник.ПодразделениеКомпании <> Подразделение Тогда
		Возврат;
	КонецЕсли;		
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваров") И Источник.ХозОперация <> Справочники.ХозОперации.ПоступлениеТоваров Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваров") И Источник.ХозОперация <> Справочники.ХозОперации.РеализацияТоваров Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.СкладКомпании.Подразделение <> Подразделение Тогда
		Возврат;
	КонецЕсли;	
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Источник);
КонецПроцедуры

Процедура РегистрацияРабочегоЛиста(РабочийЛист)
	Если РабочийЛист.ТолькоБУ Или РабочийЛист.ВидАвтомобиля = Перечисления.ВидАвтомобиля.СобственныйПарк Тогда
		Возврат;
	КонецЕсли;
	
	УзелОбмена = НайтиУзелОбменаДляРабЛиста(РабочийЛист);
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(РабочийЛист.Менеджер) Тогда
		#Если Клиент Тогда
		Сообщить("В рабочем листе не указан менеджер. Выгрузка на портал Автодилер невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	Модель = РабочийЛист.Модель;
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда
		КодМодели = мзИдентификаторыDSF.DSF_id;
		Если УзелОбмена.МаркаАвтомобиля = Справочники.Марка.GEELY И Модель.Марка = Справочники.Марка.BELGEE Тогда
			КодМодели = мзИдентификаторыDSF.BelgeeDSF_id; //Belgee у дилера Geely, якобы это временно)))
		КонецЕсли;
		стМодель = НайтиОбъектПоПараметрам(УзелОбмена, "/api/model?id=" + Формат(КодМодели, "ЧГ=0,0"));
		Если стМодель = Неопределено Тогда
			#Если Клиент Тогда
			Сообщить("Не удалось определить актуальность модели " + Модель + " для портала Автодилер!", СтатусСообщения.Внимание);
			#КонецЕсли
			
		Иначе
			Если ТипЗнч(стМодель) = Тип("Структура") И стМодель.Свойство("is_recent") Тогда
				Если обЗначениеНеЗаполнено(стМодель.is_recent) Тогда
					#Если Клиент Тогда
					Сообщить("Модель " + Модель + " на портале Автодилер не актуальна. Выгрузка на портал невозможна!", СтатусСообщения.Информация);
					#КонецЕсли
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		#Если Клиент Тогда
		Сообщить("С порталом Автодилер не синхронизирована модель " + Модель + ". Выгрузка на портал невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, РабочийЛист);
КонецПроцедуры

Процедура РегистрацияСобытия(Событие)
	УзелОбмена = НайтиУзелОбменаДляСобытия(Событие);
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда	
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, Событие);
	СинхронизироватьКлиентаТестДрайв(Событие); 
КонецПроцедуры

Процедура РегистрацияКонтракта(ЗаказНаАвтомобиль)
	УзелОбмена = НайтиУзелОбменаДляЗаказаНаАвтомобиль(ЗаказНаАвтомобиль);
	Если ЗначениеЗаполнено(УзелОбмена) Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ЗаказНаАвтомобиль);
		
	Иначе
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура РегистрацияРеализацииЧужогоАвто(РеализацияАвтомобилей)
	Если РеализацияАвтомобилей.Дата < '20240131' Тогда
		Возврат;
	КонецЕсли;
	Если Не РеализацияАвтомобилей.Проведен Тогда
		Возврат;
	КонецЕсли;
	Если РеализацияАвтомобилей.Контрагент.НашаФирма Тогда
		Возврат;
	КонецЕсли;
	Если РеализацияАвтомобилей.ПродажаБУАвто Тогда
		Возврат;
	КонецЕсли;
	
	Если РеализацияАвтомобилей.Автомобили.Количество() > 0 Тогда
		АвтомобильВыдачи = РеализацияАвтомобилей.Автомобили[0].Автомобиль;			
		Если АвтомобильВыдачи.Модель.Марка <> Справочники.Марка.UAZ Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ЗаказНаАвтомобиль = РеализацияАвтомобилей.ДокументОснование;
	Если ЗначениеЗаполнено(ЗаказНаАвтомобиль) И ТипЗнч(ЗаказНаАвтомобиль) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
		РабочийЛист = ЗаказНаАвтомобиль.ДокументОснование;
		Если обЗначениеНеЗаполнено(РабочийЛист) Или ТипЗнч(РабочийЛист) <> Тип("ДокументСсылка.РабочийЛист") Тогда
			Возврат;
		КонецЕсли;	
	Иначе
		Возврат;
	КонецЕсли;
	
	ГруппаШолоховаУАЗ = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001534"); // РШ237(UAZ)
	ГруппаЕврокар = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001589"); // РД169(UAZ)
	ПодразделениеПродажи = РабочийЛист.ПодразделениеКомпании;
	Если ПодразделениеПродажи = ГруппаШолоховаУАЗ Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РентаУАЗСобытие");
	ИначеЕсли ПодразделениеПродажи = ГруппаЕврокар Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("КорандоУАЗСобытие");
	Иначе
		Возврат;
	КонецЕсли;
	Если ЗаказНаАвтомобиль.ПодразделениеКомпании = УзелОбмена.Подразделение Тогда
		Возврат;
	КонецЕсли;
	
	РентаКар = Справочники.Организации.НайтиПоКоду("ЦБ000012");
	КорандоШахты = Справочники.Организации.НайтиПоКоду("ЦБ000023");
	Организация = ЗаказНаАвтомобиль.Организация;
	УзелОбмена = ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	Если Организация = РентаКар Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РентаУАЗПродДрДилер");
	ИначеЕсли Организация = КорандоШахты Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("КорандоУАЗПродДрДилер");
	Иначе
		Возврат;
	КонецЕсли;
		
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда	
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, РеализацияАвтомобилей);
	
	мзПродажаЧужогоАвто = РегистрыСведений.ПродажаАвтоДругогоДилера.СоздатьМенеджерЗаписи();
	мзПродажаЧужогоАвто.РеализацияАвтомобиля = РеализацияАвтомобилей.Ссылка;
	мзПродажаЧужогоАвто.Прочитать();
	Если Не мзПродажаЧужогоАвто.Выбран() Тогда
		мзПродажаЧужогоАвто.РеализацияАвтомобиля = РеализацияАвтомобилей.Ссылка;
		мзПродажаЧужогоАвто.ЗаказНаАвтомобиль = ЗаказНаАвтомобиль;
		мзПродажаЧужогоАвто.Записать();
	КонецЕсли;
КонецПроцедуры

