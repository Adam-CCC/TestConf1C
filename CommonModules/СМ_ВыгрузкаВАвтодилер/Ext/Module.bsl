			МассивДолжностей.Добавить(9);
		ИначеЕсли Должность = Справочники.Должности.РуководительОтделаПродажАвтомобилейСПробегом Тогда
			МассивДолжностей.Добавить(6);
		Иначе
			МассивДолжностей.Добавить(12); // мастер-приёмщик
		КонецЕсли;
		стЗапись.Вставить("position_list", МассивДолжностей);	
		
	ИначеЕсли МаркаАвтомобиля = Справочники.Марка.HONGQI Тогда
		Если Должность = Справочники.Должности.МенеджерОтделаПродажАвтомобилей Тогда
			МассивДолжностей.Добавить(8);
		ИначеЕсли Должность = Справочники.Должности.РуководительОтделаПродажАвтомобилейСПробегом Тогда
			МассивДолжностей.Добавить(1);
		Иначе
			МассивДолжностей.Добавить(4); // мастер-приёмщик
		КонецЕсли;
		стЗапись.Вставить("position_list", МассивДолжностей);	
	
	Иначе
		Сообщить("Подготовка выгрузки сотрудника " + Строка(Сотрудник) + ": неверная марка автомобиля в узле!", СтатусСообщения.Внимание);
		Возврат "";
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные сотрудника для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ВыгрузитьСотрудника(УзелОбмена, Сотрудник)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/manager";
	
	Марка = УзелОбмена.МаркаАвтомобиля;
	ТелоЗапроса = ДанныеСотрудника(Сотрудник, Марка);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, Строка(Сотрудник));
		Если стРезультат.id > 0 Тогда
			мзИдентификаторы = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
			мзИдентификаторы.ОбъектАльфаАвто = Сотрудник;
			мзИдентификаторы.Прочитать();
			Если Не мзИдентификаторы.Выбран() Тогда
				мзИдентификаторы.ОбъектАльфаАвто = Сотрудник;
			КонецЕсли;
			
			Если Марка = Справочники.Марка.GEELY Тогда
				мзИдентификаторы.GeelyDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.BELGEE Тогда
				мзИдентификаторы.BelgeeDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.UAZ Тогда
				мзИдентификаторы.DSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.FORD Тогда
				мзИдентификаторы.FordDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.FIAT Тогда
				мзИдентификаторы.FiatDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.JEEP Тогда
				мзИдентификаторы.JeepDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.EXEED Или Марка = Справочники.Марка.ESTEO Тогда
				мзИдентификаторы.ExeedDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.CHANGAN Тогда
				мзИдентификаторы.ChanganDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.LADA_ВАЗ Тогда
				мзИдентификаторы.VAZ_DSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.GAC Тогда
				мзИдентификаторы.GAC_DSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.OMODA Тогда
				мзИдентификаторы.OmodaJaecooDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.JAECOO Тогда
				мзИдентификаторы.JaecooDSF_id = стРезультат.id;
				
			ИначеЕсли (Марка = Справочники.Марка.CHERY Или Марка = Справочники.Марка.TENET
				Или Марка = Справочники.Марка.TENET_Plus) Тогда
				мзИдентификаторы.CheryDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.VGV Тогда
				мзИдентификаторы.VGV_DSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.HAVAL Тогда
				мзИдентификаторы.HavalDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.SOLLERS Тогда
				мзИдентификаторы.SollersDSF_id = стРезультат.id;
				
			ИначеЕсли Марка = Справочники.Марка.HONGQI Тогда
				мзИдентификаторы.HongqiDSF_id = стРезультат.id;	
			
			Иначе
				Сообщить("Синхронизация сотрудника " + Строка(Сотрудник) + ": неверная марка автомобиля в узле!", СтатусСообщения.Внимание);
				Возврат 0;
			КонецЕсли;
			
			мзИдентификаторы.Записать();
			Возврат стРезультат.id;
			
		Иначе
			Возврат 0;
		КонецЕсли;
		
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция НайтиУзелОбменаВладельца(РабЛистСсылка, Марка)
	ЭтоВыгружаемаяМарка = Марка = Справочники.Марка.GEELY Или Марка = Справочники.Марка.UAZ;
	Если Не ЭтоВыгружаемаяМарка Тогда
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	Автомобиль = РабЛистСсылка.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Или АвтомобильСПробегом(Автомобиль) Тогда 
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	Модель = Автомобиль.Модель;
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если Не мзИдентификаторыDSF.Выбран() Тогда
		#Если Клиент Тогда
		Сообщить("С порталом Автодилер не синхронизирована модель проданного автомобиля " + Модель
		+ ". Выгрузка невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	ЗапросПродажа = Новый Запрос();
	ЗапросПродажа.УстановитьПараметр("Автомобиль", Автомобиль);
	ЗапросПродажа.Текст =
	"ВЫБРАТЬ
	|	ПродажиАвтомобилей.Регистратор.ДокументОснование КАК ЗаказНаАвтомобиль,
	|	ПродажиАвтомобилей.Регистратор.Организация КАК ОрганизацияВладелец,
	|	ПродажиАвтомобилей.Регистратор.ПодразделениеКомпании КАК ПодразделениеВладелец
	|ИЗ
	|	РегистрНакопления.ПродажиАвтомобилей КАК ПродажиАвтомобилей
	|ГДЕ
	|	ПродажиАвтомобилей.Автомобиль = &Автомобиль
	|	И ПродажиАвтомобилей.Регистратор ССЫЛКА Документ.РеализацияАвтомобилей
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПродажиАвтомобилей.Период";

	РезультатПродажа = ЗапросПродажа.Выполнить();
	Если РезультатПродажа.Пустой() Тогда
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	ВыборкаПродажа = РезультатПродажа.Выбрать();
	ВыборкаПродажа.Следующий();
	ЗаказНаАвтомобиль = ВыборкаПродажа.ЗаказНаАвтомобиль;
	Если обЗначениеНеЗаполнено(ЗаказНаАвтомобиль) Или ТипЗнч(ЗаказНаАвтомобиль) <> Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	ОрганизацияВладелец = ВыборкаПродажа.ОрганизацияВладелец;
	Если обЗначениеНеЗаполнено(ОрганизацияВладелец) Тогда
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	ПодразделениеВладелец = ВыборкаПродажа.ПодразделениеВладелец;
	Если обЗначениеНеЗаполнено(ПодразделениеВладелец) Тогда
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	ГруппаАвтолига = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000117"); // Авто Лига
	ГруппаШахтыДжили = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001285"); // Шахты Джили
	ГруппаШолоховаДжили = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001492"); // Шолохова Джили
	ГруппаПойменнаяЭксид = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000223"); // Пойменная Сокол Моторс (EXEED)
	
	Если Марка = Справочники.Марка.UAZ И ОрганизацияВладелец.Код = "ЦБ000012" Тогда
		УзелОбменаСобытие = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РентаУАЗСобытие");
		УзелОбменаРабЛист = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РентаУАЗРабЛист");
		
	ИначеЕсли Марка = Справочники.Марка.UAZ И ОрганизацияВладелец.Код = "ЦБ000023" Тогда
		УзелОбменаСобытие = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("КорандоУАЗСобытие");
		УзелОбменаРабЛист = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("КорандоУАЗРабЛист");
		
	ИначеЕсли Марка = Справочники.Марка.GEELY И ВИерархии(ПодразделениеВладелец, ГруппаШахтыДжили)  Тогда
		УзелОбменаСобытие = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаШахтыДжилиСобытие");
		УзелОбменаРабЛист = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаШахтыДжилиРабЛист");
		
	ИначеЕсли Марка = Справочники.Марка.GEELY И ВИерархии(ПодразделениеВладелец, ГруппаШолоховаДжили) Тогда
		УзелОбменаСобытие = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаРостовДжилиСобытие");
		УзелОбменаРабЛист = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаРостовДжилиРабЛист");
		
	ИначеЕсли Марка = Справочники.Марка.EXEED И ВИерархии(ПодразделениеВладелец, ГруппаПойменнаяЭксид) Тогда
		УзелОбменаСобытие = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ПойменнаяЭксидСобытие");
		УзелОбменаРабЛист = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ПойменнаяЭксидРабЛист");
		
	Иначе
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(УзелОбменаСобытие) Или обЗначениеНеЗаполнено(УзелОбменаРабЛист) Тогда	
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
	КонецЕсли;
	
	СписокИсключений = Новый Массив();
	СписокИсключений.Добавить(Перечисления.ВидыСобытий.ОтказОтАвтомобиля);
	СписокИсключений.Добавить(Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
	СписокИсключений.Добавить(Перечисления.ВидыСобытий.ЗвонокВежливости);
	
	ЗапросСобытия = Новый Запрос();
	ЗапросСобытия.УстановитьПараметр("РабочийЛист", РабЛистСсылка);
	ЗапросСобытия.УстановитьПараметр("Завершено", Перечисления.СостоянияСобытий.Завершено);
	ЗапросСобытия.УстановитьПараметр("СписокИсключений", СписокИсключений);
	ЗапросСобытия.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ДокументОснование = &РабочийЛист
	|	И Событие.Состояние = &Завершено
	|	И НЕ Событие.ВидСобытия В (&СписокИсключений)
	|	И Событие.Проведен
	|	И НЕ Событие.ПометкаУдаления";
	
	РезультатСобытия = ЗапросСобытия.Выполнить();
	Если РезультатСобытия.Пустой() Тогда
		Возврат ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
		
	Иначе
		ПланыОбмена.ЗарегистрироватьИзменения(УзелОбменаРабЛист, РабЛистСсылка);
		ВыборкаСобытия = РезультатСобытия.Выбрать();
		Пока ВыборкаСобытия.Следующий() Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбменаСобытие, ВыборкаСобытия.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбменаСобытие, ЗаказНаАвтомобиль);
	Возврат УзелОбменаСобытие;
КонецФункции

Процедура СинхронизироватьКлиентаТестДрайв(Событие)
	Если Событие.ВидСобытия <> Перечисления.ВидыСобытий.ТестДрайв Тогда
		Возврат;
	КонецЕсли;
	Контрагент = Событие.Контрагент;
	Если ТипЗнч(Контрагент) = Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	РабочийЛист = Событие.ДокументОснование;
	Если обЗначениеНеЗаполнено(РабочийЛист) Тогда
		Возврат;
	КонецЕсли;
	
	Если РабочийЛист.Контрагент = Контрагент Тогда
		Возврат;
		
	Иначе
		РабочийЛистОбъект = РабочийЛист.ПолучитьОбъект();
		РабочийЛистОбъект.Контрагент = Контрагент;
		РабочийЛистОбъект.ОбменДанными.Загрузка = Истина;
		РабочийЛистОбъект.Записать();	
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьКодЛидаПродажи(РабочийЛистСсылка)
	ЗапросКодЛида = Новый Запрос();
	ЗапросКодЛида.УстановитьПараметр("РабочийЛист", РабочийЛистСсылка);
	ЗапросКодЛида.Текст =
	"ВЫБРАТЬ
	|	ЛидыСайтаПровайдераСрезПоследних.КодЛида КАК КодЛида
	|ИЗ
	|	РегистрСведений.ЛидыСайтаПровайдера.СрезПоследних(, РабочийЛист = &РабочийЛист) КАК ЛидыСайтаПровайдераСрезПоследних";
	
	ВыборкаКодЛида = ЗапросКодЛида.Выполнить().Выбрать();
	Если ВыборкаКодЛида.Следующий() Тогда
		Возврат ВыборкаКодЛида.КодЛида;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция НетЗавершенныхСобытий(РабочийЛист) Экспорт
	ЗапросЗавершенные = Новый Запрос();
	ЗапросЗавершенные.УстановитьПараметр("РабочийЛист", РабочийЛист);
	ЗапросЗавершенные.УстановитьПараметр("Завершено", Перечисления.СостоянияСобытий.Завершено);
	ЗапросЗавершенные.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ДокументОснование = &РабочийЛист
	|	И Событие.Состояние = &Завершено";
	
	Результат = ЗапросЗавершенные.Выполнить();
	Возврат Результат.Пустой();
КонецФункции

Функция ПолучитьКодЛидаСервис(ЗаказНарядОснование)
	Если обЗначениеНеЗаполнено(ЗаказНарядОснование) Тогда
		Возврат 0;
	ИначеЕсли ТипЗнч(ЗаказНарядОснование) <> Тип("ДокументСсылка.ЗаявкаНаРемонт") Тогда
		Возврат 0;
	Иначе
		РабочийЛистСервиса = ЗаказНарядОснование.ДокументОснование;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(РабочийЛистСервиса) Тогда
		Возврат 0;
	ИначеЕсли ТипЗнч(РабочийЛистСервиса) <> Тип("ДокументСсылка.РабочийЛистСервиса") Тогда
		Возврат 0;
	КонецЕсли;
	
	ЗапросКодЛида = Новый Запрос();
	ЗапросКодЛида.УстановитьПараметр("РабочийЛистСервиса", РабочийЛистСервиса);
	ЗапросКодЛида.Текст =
	"ВЫБРАТЬ
	|	ЛидыСайтаПровайдераСрезПоследних.КодЛида КАК КодЛида
	|ИЗ
	|	РегистрСведений.ЛидыСайтаПровайдера.СрезПоследних(, РабочийЛист = &РабочийЛистСервиса) КАК ЛидыСайтаПровайдераСрезПоследних";
	
	ВыборкаКодЛида = ЗапросКодЛида.Выполнить().Выбрать();
	Если ВыборкаКодЛида.Следующий() Тогда
		Возврат ВыборкаКодЛида.КодЛида;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

//// Процедуры / функции для выгрузки данных ППО на портал Автодилер
