Функция ДанныеСотрудника(Сотрудник, МаркаАвтомобиля)
	стЗапись = Новый Структура();
	стЗапись.Вставить("code", Сотрудник.Код);
	стЗапись.Вставить("first_name", Сотрудник.Имя);
	стЗапись.Вставить("last_name", Сотрудник.Фамилия);
	стЗапись.Вставить("middle_name", Сотрудник.Отчество);
	
	ЭлПочта = киПолучитьПредставлениеКИ(Сотрудник, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(ЭлПочта) Тогда
		Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Сотрудник);
		Если ЗначениеЗаполнено(Пользователь) Тогда			
			УстановитьПривилегированныйРежим(Истина);
			ПользовательИБ = СМ_ПривилегированныйРежим.ПолучитьПользователяИБ(Пользователь);
			Если обЗначениеНеЗаполнено(ПользовательИБ) Тогда
				Сообщить("Не найден Пользователь ИБ для пользователя " + Строка(Пользователь) +
				"!" + Символы.ПС + " Выгрузка на портал Автодилер невозможна!", СтатусСообщения.Важное);
				УстановитьПривилегированныйРежим(Ложь);
				Возврат "";
			КонецЕсли;		
			ИмяПользователяОС = ПользовательИБ.ПользовательОС;
			УстановитьПривилегированныйРежим(Ложь);
			
			ном = СтрНайти(ИмяПользователяОС, "\", НаправлениеПоиска.СКонца);
			Если ном > 0 Тогда
				ЭлПочта = Сред(ИмяПользователяОС, ном + 1);
			Иначе
				ЭлПочта = ИмяПользователяОС;
			КонецЕсли;
			ЭлПочта = ЭлПочта + "@sokolmotors.ru";
			
		Иначе
			Сообщить("Не задан email и не найден Пользователь для сотрудника " + Строка(Сотрудник) +
			"!" + Символы.ПС + " Выгрузка на портал Автодилер невозможна!", СтатусСообщения.Важное);
			Возврат "";
		КонецЕсли;		
	КонецЕсли;
	стЗапись.Вставить("email", ЭлПочта);
	
	стЗапись.Вставить("birthday", Формат(Сотрудник.ДатаРождения, "ДЛФ=Д"));
	стЗапись.Вставить("employment", Формат(Сотрудник.ДатаПриема, "ДЛФ=Д"));
		
	МассивДолжностей = Новый Массив();
	Должность = Сотрудник.Должность;
	Если МаркаАвтомобиля = Справочники.Марка.GEELY Или МаркаАвтомобиля = Справочники.Марка.BELGEE Тогда
