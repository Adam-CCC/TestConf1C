	//	УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантДжипДвижениеТоваров");
	//	Если ЗначениеЗаполнено(УзелОбмена) Тогда
	//		РегистрацияДвиженийТоваров(УзелОбмена, Источник);
	//	КонецЕсли;
	//	УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантФиатДвижениеТоваров");
	//	Если ЗначениеЗаполнено(УзелОбмена) Тогда
	//		РегистрацияДвиженийТоваров(УзелОбмена, Источник);
	//	КонецЕсли;
	//КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказНаряд") Тогда
		РегистрацияЗаказНаряда(Источник);
	
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаявкаНаРемонт") Тогда
		РегистрацияЗаявкиНаРемонт(Источник);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваров") Тогда
		РегистрацияРеализацииТоваров(Источник);	
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РабочийЛист") Тогда
		РегистрацияРабочегоЛиста(Источник);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.Событие") Тогда
		РегистрацияСобытия(Источник);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказНаАвтомобиль") Тогда
		РегистрацияКонтракта(Источник);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияАвтомобилей") Тогда
		РегистрацияРеализацииЧужогоАвто(Источник);
	КонецЕсли;	
КонецПроцедуры

Процедура РегистрацияЗаказНаряда(ЗаказНаряд)	
	Модель = ЗаказНаряд.Автомобиль.Модель;
	ЗаказНарядЗакрыт = ЗаказНаряд.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт;
	
	Марка = Модель.Марка;
	ЭтоУАЗ = Марка = Справочники.Марка.UAZ; 
	ЭтоФорд = Марка = Справочники.Марка.FORD;
	ЭтоGeely = Марка = Справочники.Марка.GEELY Или Марка = Справочники.Марка.BELGEE Или Марка = Справочники.Марка.KNEWSTAR;
	ЭтоФиат = Марка = Справочники.Марка.FIAT;
	ЭтоДжип = Марка = Справочники.Марка.JEEP;
	ЭтоExeed = Марка = Справочники.Марка.ESTEO Или Марка = Справочники.Марка.EXEED;
	ЭтоGAC = Марка = Справочники.Марка.GAC;
	ЭтоChangan = Марка = Справочники.Марка.CHANGAN;
	ЭтоVGV = Марка = Справочники.Марка.VGV;
	ЭтоBelgee = Марка = Справочники.Марка.BELGEE;
	ЭтоЛада = Марка = Справочники.Марка.LADA_ВАЗ;
	ЭтоHavalPro = ВИерархии(Модель, Справочники.Модели.НайтиПоКоду("ЦБ00005940")); // HAVAL Pro
	ЭтоHavalCity = ВИерархии(Модель, Справочники.Модели.НайтиПоКоду("ЦБ00005871")) Или Марка = Справочники.Марка.GREAT_WALL; // HAVAL City
	ЭтоSollers = Марка = Справочники.Марка.SOLLERS;
	ЭтоHongqi = Марка = Справочники.Марка.HONGQI;
	ЭтоTenet = Марка = Справочники.Марка.TENET Или Марка = Справочники.Марка.CHERY;
	
	ЭтоКорандоГамма = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000174"); // Корандо Шахты ООО Шолохова 231 (GAC)
	ЭтоРентаКарАвтолига = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000121"); // Рента Кар ООО Автолига
	ЭтоШахтыДжили = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001292"); // Гамма Моторс ООО Шахты Джили
	ЭтоРостовДжили = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001300"); // Гамма Моторс ООО Шолохова Джили
	ЭтоВолгодонскДжили = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001541"); // Гамма Моторс ООО Волгодонск Ниссан
	ЭтоАтлантГамма = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000032"); // Атлант Моторс ООО Гамма
	ЭтоПойменнаяЭксид = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000235"); // Атлант Моторс ООО Пойменная
	ЭтоМалиновскогоЭксид = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001717"); // Атлант Моторс ООО РМ43(EXEED)
	ЭтоПрестижШолохова = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000110"); // Престиж Моторс ООО Шолохова 231
	
	ЭтоМалиновскогоЧанган = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000036"); // Атлант Моторс ООО Стекло
	ЭтоШолоховаЧанган = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001507") // Атлант Моторс ООО Шолохова 237 (CHANGAN)
		Или ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001563"); // Атлант Моторс ООО Шолохова 235 (CHANGAN)
	ЭтоТаганрогЧанган = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001518"); // Атлант Моторс ООО Таганрог Ростовское шоссе 10
	ЭтоВолгодонскЧанган = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001505"); // Атлант Моторс ООО Волгодонск Чанган
	ЭтоШахтыЧанган = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001232"); // Атлант Моторс ООО Хендэ Шахты
	ЭтоДельтаЧанган = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000062"); // Атлант Моторс ООО Дельта Моторс (CHANGAN)
	
	ЭтоШолоховаVGV = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001571"); // Автоком-Дон ООО Шолохова 237 (VGV))
	ЭтоТаганрогVGV = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000213"); // Автоком-Дон ООО Таганрог
	ЭтоАвтолигаVGV = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000165"); // Автоком Дон ООО Автолига
	ЭтоЕврокарVGV = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001628"); // Автоком-Дон ООО РД169(VGV)

	ЭтоГаммаОлимп = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001298"); // Гамма Моторс ООО ШД290(BELGEE)
	
	ЭтоРассветЛада = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000247"); // Транзит ООО Рассвет
	ЭтоВолгодонскЛада = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000166"); // Транзит ООО Волгодонск Лада
	
	ЭтоШахтыХавал = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001290"); // Автоком Шахты ООО Шахты (HAVAL)
	ЭтоМалиновскогоХавал = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001718"); // Автоком Шахты ООО РМ43(HAVAL)
	ЭтоТекучеваХавалПро = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001721"); // Автоком Шахты ООО РТК354(HAVAL)
	ЭтоТаганрогХавал = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001688"); // Автоком Шахты ООО Таганрог Ростовское шоссе 10а
	
	ЭтоПойменнаяСоллерс = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001728"); // Корандо Шахты ООО РП1Г(SOLLERS)
	ЭтоШолоховаСоллерс = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001730"); // Корандо Шахты ООО РШ237(SOLLERS)
	
	ЭтоШолоховаХонгчи = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001763"); // Автопарк ООО РШ231(HONGQI)
	ЭтоВавиловаТенет = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001707"); // Престиж Моторс ООО РВ59К(CHERY)
	ЭтоВолгодонскТенет = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000109"); // Престиж Моторс ООО Волгодонск Чери
	ЭтоШолоховаТенет = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001502"); // Престиж Моторс ООО Шолохова 235 (CHERY)
	
	Если ЭтоФиат И ЭтоАтлантГамма Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантФиатППО");
		
	ИначеЕсли ЭтоДжип И ЭтоАтлантГамма Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантДжипППО");
	
	//ИначеЕсли ЭтоФорд И ЭтоРентаКарАвтолига Тогда
	//	Если Модель.Код = "ЦБ00005706" Тогда // FORD ГЕРМЕС
	//		Возврат;
	//	КонецЕсли;
	//	УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РентаКарФордППО");
		
	ИначеЕсли ЭтоExeed И ЭтоПойменнаяЭксид Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ПойменнаяЭксидППО");
		
	ИначеЕсли ЭтоExeed И ЭтоМалиновскогоЭксид Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоЭксидППО");
		
	ИначеЕсли ЭтоУАЗ И ЭтоКорандоГамма Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("КорандоУАЗППО");
		
	ИначеЕсли ЭтоGAC И ЭтоПрестижШолохова Тогда
		Если ЗаказНаряд.Дата > '20240326' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШолоховаGACППО");
		КонецЕсли;
		
	ИначеЕсли ЗаказНарядЗакрыт И ЭтоGeely И ЭтоШахтыДжили Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаШахтыДжилиППО");
		
	ИначеЕсли ЗаказНарядЗакрыт И ЭтоGeely И ЭтоРостовДжили Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаРостовДжилиППО");
		
	ИначеЕсли ЗаказНарядЗакрыт И ЭтоGeely И ЭтоВолгодонскДжили Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ВолгодонскДжилиППО");
		
	ИначеЕсли ЭтоVGV И ЭтоЕврокарVGV Тогда
		Если ЗаказНаряд.Дата > '20240916' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ЕврокарVGVППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоVGV И ЭтоАвтолигаVGV Тогда
		Если ЗаказНаряд.Дата > '20240916' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АвтолигаVGVППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоVGV И ЭтоТаганрогVGV Тогда
		Если ЗаказНаряд.Дата > '20240916' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ТаганрогVGVППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоVGV И ЭтоШолоховаVGV Тогда
		Если ЗаказНаряд.Дата > '20240916' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШолоховаVGVППО");
		КонецЕсли;
	
	ИначеЕсли ЭтоChangan И ЭтоШахтыЧанган Тогда
		Если ЗаказНаряд.Дата > '20240501' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШахтыЧанганППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоChangan И ЭтоМалиновскогоЧанган Тогда
		Если ЗаказНаряд.Дата > '20240501' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоЧанганППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоChangan И ЭтоШолоховаЧанган Тогда
		Если ЗаказНаряд.Дата > '20240501' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШолоховаЧанганППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоChangan И ЭтоВолгодонскЧанган Тогда
		Если ЗаказНаряд.Дата > '20240501' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ВолгодонскЧанганППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоChangan И ЭтоТаганрогЧанган Тогда
		Если ЗаказНаряд.Дата > '20240501' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ТаганрогЧанганППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоChangan И ЭтоДельтаЧанган Тогда
		Если ЗаказНаряд.Дата > '20241204' Тогда
			//УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ДельтаЧанганППО");
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоЧанганППО");
		КонецЕсли;
		
	ИначеЕсли ЗаказНарядЗакрыт И ЭтоBelgee И ЭтоГаммаОлимп Тогда
		Если ЗаказНаряд.Дата > '20240501' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ОлимпBelgeeППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоЛада И ЭтоРассветЛада Тогда
		Если ЗаказНаряд.Дата > '20240601' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РассветЛадаППО");
		КонецЕсли;	
		
	ИначеЕсли ЭтоЛада И ЭтоВолгодонскЛада Тогда
		Если ЗаказНаряд.Дата > '20240601' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ВолгодонскЛадаППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоHavalCity И ЭтоШахтыХавал Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШахтыХавалППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоHavalCity И ЭтоМалиновскогоХавал Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоХавалППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоHavalCity И (ЭтоТекучеваХавалПро Или ЭтоТаганрогХавал) Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоХавалППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоHavalPro И (ЭтоТекучеваХавалПро Или ЭтоТаганрогХавал) Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ТекучеваХавалПроППО");
		КонецЕсли;	
		
	ИначеЕсли ЭтоSollers И ЭтоПойменнаяСоллерс Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ПойменнаяСоллерсППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоSollers И ЭтоКорандоГамма Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШолоховаСоллерсППО");
		КонецЕсли;	
		
	ИначеЕсли ЭтоHongqi И ЭтоШолоховаХонгчи Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШолоховаХонгчиППО");
		КонецЕсли;	
		
	ИначеЕсли ЭтоTenet И ЭтоВавиловаТенет Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ВавиловаТенетППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоTenet И ЭтоВолгодонскТенет Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ВолгодонскТенетППО");
		КонецЕсли;
		
	ИначеЕсли ЭтоTenet И ЭтоШолоховаТенет Тогда
		Если ЗаказНаряд.Дата > '20241001' Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ШолоховаТенетППО");
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда	
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(ЗаказНаряд.Диспетчер) И обЗначениеНеЗаполнено(ЗаказНаряд.Менеджер) Тогда
		#Если Клиент Тогда
		Сообщить("В заказ-наряде не указаны Мастер-приёмщик и Менеджер. Выгрузка на портал Автодилер невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если Не мзИдентификаторыDSF.Выбран() Тогда
		#Если Клиент Тогда
		Сообщить("С порталом Автодилер не синхронизирована модель " + Модель
		+ ". Выгрузка заказ-наряда на портал Автодилер невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	ВидРемонта = ЗаказНаряд.ВидРемонта;
	мзИдентификаторыDNM = РегистрыСведений.УАЗDNMИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDNM.ВидРемонта = ВидРемонта;
	мзИдентификаторыDNM.Прочитать();
	Если Не мзИдентификаторыDNM.Выбран() Тогда		
		#Если Клиент Тогда
		Сообщить("Заказ-наряды с видом ремонта "
		+ ВидРемонта + " на портал Автодилер не выгружаются.", СтатусСообщения.Информация);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ЗаказНаряд);
	Сообщить(Строка(ЗаказНаряд) + " поставлен в очередь на выгрузку в DNM.", СтатусСообщения.Информация);
КонецПроцедуры

Процедура РегистрацияЗаявкиНаРемонт(ЗаявкаНаРемонт)
	Если обЗначениеНеЗаполнено(ЗаявкаНаРемонт.Автомобиль) 
		Или ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("Строка") Тогда
		Возврат;
	ИначеЕсли ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Модели") Тогда
		Модель = ЗаявкаНаРемонт.Автомобиль;
	ИначеЕсли ТипЗнч(ЗаявкаНаРемонт.Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда
		Модель = ЗаявкаНаРемонт.Автомобиль.Модель;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(Модель) Тогда
		Возврат;
	КонецЕсли;
	
	Марка = Модель.Марка;
	ПодразделениеКомпании = ЗаявкаНаРемонт.ПодразделениеКомпании;
	
	// Фиат, Джип
	////////////////////////////////////////
	ЭтоФиат = Марка = Справочники.Марка.FIAT;
	ЭтоДжип = Марка = Справочники.Марка.JEEP;
	ЭтоАтлантМоторс = ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000032"); //Атлант Моторс ООО Шолохова 231 (GAC)
	Если ЭтоАтлантМоторс И (ЭтоФиат Или ЭтоДжип) Тогда
		Если обЗначениеНеЗаполнено(ЗаявкаНаРемонт.ДокументОснование) 
			Или ТипЗнч(ЗаявкаНаРемонт.ДокументОснование) <> Тип("ДокументСсылка.ЗаказНаряд") Тогда
			Возврат;
		КонецЕсли;
	
		Если обЗначениеНеЗаполнено(ЗаявкаНаРемонт.Заказчик) 
			Или ТипЗнч(ЗаявкаНаРемонт.Заказчик) = Тип("Строка") Тогда
			Возврат;
		КонецЕсли;
	
		мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
		Модель = ЗаявкаНаРемонт.Автомобиль.Модель;
		мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
		мзИдентификаторыDSF.Прочитать();
		Если Не мзИдентификаторыDSF.Выбран() Тогда
			#Если Клиент Тогда
			Сообщить("С порталом Автодилер не синхронизирована модель " + Модель
			+ ". Выгрузка заявки на ремонт невозможна!!!", СтатусСообщения.Внимание);
			#КонецЕсли
			Возврат;
		КонецЕсли;
		
		Если ЭтоФиат Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантФиатКалькуляции");
		ИначеЕсли ЭтоДжип Тогда
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантДжипКалькуляции");
		Иначе
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.ПустаяСсылка();
		КонецЕсли;
		Если ЗначениеЗаполнено(УзелОбмена) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ЗаявкаНаРемонт);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Лада
	////////////////////////////////////////////
	ЭтоЛада = Марка = Справочники.Марка.LADA_ВАЗ;
	РассветЛада = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000099"); // РАС(LADA)
	ВолгодонскЛада = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000189"); // ВК50Г(LADA)
	Если ВИерархии(ПодразделениеКомпании, РассветЛада) Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РассветЛадаЗаявки");
	ИначеЕсли ВИерархии(ПодразделениеКомпании, ВолгодонскЛада) Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ВолгодонскЛадаЗаявки");	
	Иначе
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда	
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаРемонт.Диспетчер) Тогда
		МастерПриемщик = ЗаявкаНаРемонт.Диспетчер;
	ИначеЕсли ЗначениеЗаполнено(ЗаявкаНаРемонт.Менеджер) Тогда
		МастерПриемщик = ЗаявкаНаРемонт.Менеджер;
	Иначе
		Сообщить("В " + Строка(ЗаявкаНаРемонт) + " не указаны Мастер-приемщик и Менеджер. Выгрузка Заявки на ремонт на портал DNM невозможна!!!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;

	Если обЗначениеНеЗаполнено(ЗаявкаНаРемонт.ДатаНачала) Тогда
		Сообщить("В " + Строка(ЗаявкаНаРемонт) + " не указана Дата начала работ. Выгрузка Заявки на ремонт на портал DNM невозможна!!!", СтатусСообщения.Внимание);
		Возврат;
	ИначеЕсли обЗначениеНеЗаполнено(ЗаявкаНаРемонт.ДатаОкончания) Тогда
		Сообщить("В " + Строка(ЗаявкаНаРемонт) + " не указана Дата окончания работ. Выгрузка Заявки на ремонт на портал DNM невозможна!!!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	Если ЗаявкаНаРемонт.ДатаНачала > ЗаявкаНаРемонт.ДатаОкончания Тогда
		Сообщить("В " + Строка(ЗаявкаНаРемонт) + " указана Дата начала работ позже, чем Дата окончания. Выгрузка Заявки на ремонт на портал DNM невозможна!!!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	Если ЗаявкаНаРемонт.ДатаНачала < ТекущаяДата() Тогда
		Сообщить("В " + Строка(ЗаявкаНаРемонт) + " указана Дата начала работ в прошлом периоде. Выгрузка Заявки на ремонт на портал DNM невозможна!", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	
	ДатаГрафика = НачалоДня(ЗаявкаНаРемонт.ДатаНачала);
	нзГрафикРаботКалендарный = РегистрыСведений.ГрафикРаботКалендарный.СоздатьНаборЗаписей();
	нзГрафикРаботКалендарный.Отбор.График.Установить(МастерПриемщик.ГрафикРаботы);
	нзГрафикРаботКалендарный.Отбор.Дата.Установить(ДатаГрафика);
	нзГрафикРаботКалендарный.Прочитать();
	Если нзГрафикРаботКалендарный.Количество() = 0 Тогда
		Сообщить("У " + Строка(МастерПриемщик) + " отсутствует график работы на дату заявки " + Формат(ЗаявкаНаРемонт.ДатаНачала, "ДФ=""dd.MM.yyyy""")
		+ ". Выгрузка Заявки на ремонт на портал DNM невозможна!!!", СтатусСообщения.Внимание);
		Возврат;
		
	ИначеЕсли нзГрафикРаботКалендарный[0].ВидДня <> Перечисления.ВидДня.Рабочий Тогда
		Сообщить("У " + Строка(МастерПриемщик) + " нерабочий день на Дату начала работ " + Формат(ЗаявкаНаРемонт.ДатаНачала, "ДФ=""dd.MM.yyyy""")
		+ ". Выгрузка Заявки на ремонт на портал DNM невозможна!!!", СтатусСообщения.Внимание);
		Возврат;
		
	Иначе
		НачалоРабочегоВремени = ДатаГрафика + 3600 * Час(нзГрафикРаботКалендарный[0].НачалоРабочегоВремени) + 60 * Минута(нзГрафикРаботКалендарный[0].НачалоРабочегоВремени);
		КонецРабочегоВремени = ДатаГрафика + 3600 * Час(нзГрафикРаботКалендарный[0].КонецРабочегоВремени) + 60 * Минута(нзГрафикРаботКалендарный[0].КонецРабочегоВремени);
		Если НачалоРабочегоВремени > ЗаявкаНаРемонт.ДатаНачала Тогда
			Сообщить("Заявка запланирована на время, ранее чем начало рабочего дня " + Строка(МастерПриемщик) + " (на " + Формат(ЗаявкаНаРемонт.ДатаНачала, "ДФ=""HH:mm""")
			+ "). Выгрузка Заявки на ремонт на портал DNM невозможна!!!!", СтатусСообщения.Внимание);
			Возврат;
			
		ИначеЕсли КонецРабочегоВремени < ЗаявкаНаРемонт.ДатаОкончания Тогда
			Сообщить("Заявка запланирована на время, позже чем окончание рабочего дня " + Строка(МастерПриемщик) + " (на " + Формат(ЗаявкаНаРемонт.ДатаОкончания, "ДФ=""HH:mm""")
			+ "). Выгрузка Заявки на ремонт на портал DNM невозможна!!!!", СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ЗаявкаНаРемонт);		
КонецПроцедуры

