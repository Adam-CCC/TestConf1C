Функция ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса)	
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	НТТРОтвет = НТТР.Записать(ЗапросHTTP);
	
	Если НТТРОтвет.КодСостояния >= 300 Тогда
		ТелоЗапроса = НТТРОтвет.ПолучитьТелоКакСтроку();
		#Если Клиент Тогда
		Сообщить("Обновление объекта " + ЗапросHTTP.АдресРесурса + ":" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоЗапроса, СтатусСообщения.Важное);
		#КонецЕсли
	КонецЕсли;
	
	Возврат НТТРОтвет.КодСостояния;	
КонецФункции

Функция ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, СтрокаОбъект)
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);
	
	ТелоЗапроса = НТТРОтвет.ПолучитьТелоКакСтроку();
	стРезультат = Новый Структура();
	стРезультат.Вставить("id", 0);
	стРезультат.Вставить("КодСостояния", НТТРОтвет.КодСостояния);
	
	Если стРезультат.КодСостояния < 300 Тогда
		ЧтениеJSON = Новый ЧтениеJSON();
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Попытка
			стОтвет = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			#Если Клиент Тогда
			Сообщить("Выгрузка объекта " + СтрокаОбъект + ":" + Символы.ПС 
			+ "Ошибка чтения json!", СтатусСообщения.Важное);
			#КонецЕсли
			Возврат стРезультат;
		КонецПопытки;
		
		Если ТипЗнч(стОтвет) = Тип("Структура") И стОтвет.Свойство("id") Тогда
			стРезультат.id = стОтвет.id;
		Иначе
			#Если Клиент Тогда
			Сообщить("Выгрузка объекта " + СтрокаОбъект + ":" + Символы.ПС 
			+ "Неверный тип json!", СтатусСообщения.Важное);
			#КонецЕсли
			Возврат стРезультат;
		КонецЕсли;
		
	Иначе
		#Если Клиент Тогда	
		Сообщить("Выгрузка объекта " + СтрокаОбъект + ":" + Символы.ПС 
		+ "Код состояния: " + стРезультат.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + ТелоЗапроса, СтатусСообщения.Важное);
		#КонецЕсли
	КонецЕсли;
	
	Возврат стРезультат;
КонецФункции

Функция СформироватьСообщениеОбОшибке(ТелоОтвета)
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Попытка
		мОтвет = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если ТипЗнч(мОтвет) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаСообщений = "";
	Для Каждого стОтвет Из мОтвет Цикл
		Если ТипЗнч(стОтвет) = Тип("Структура") И стОтвет.Свойство("message") Тогда
			СтрокаСообщений = ?(ЗначениеЗаполнено(СтрокаСообщений), СтрокаСообщений + Символы.ПС + стОтвет.message, стОтвет.message);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрокаСообщений;
КонецФункции

Процедура ОтправитьСообщениеОбОшибке(ДанныеСообщения)
	мКому = Новый Массив();
	//мКому.Добавить("semenikhin_i@sokolmotors.ru");
	
	Если ЗначениеЗаполнено(ДанныеСообщения.Руководитель) И Не ДанныеСообщения.Руководитель.ФлагУволен Тогда
		АдресЭлПочты = ДанныеСообщения.Руководитель.РабочийEmail;
		Если обЗначениеНеЗаполнено(АдресЭлПочты) Тогда
			АдресЭлПочты = киПолучитьПредставлениеКИ(ДанныеСообщения.Руководитель, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресЭлПочты)  Тогда
			мКому.Добавить(АдресЭлПочты);
		КонецЕсли;
	КонецЕсли;
	
	Если мКому.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	мКопии = Новый Массив();
	г_Функции.СоздатьИОтпраитьЭлПисьмо(мКому, мКопии, ДанныеСообщения.ТемаПисьма, ДанныеСообщения.ТелоПисьма, ДанныеСообщения.ДокументСсылка);
КонецПроцедуры

Функция ВИерархии(Элемент, Группа) Экспорт
	Если обЗначениеНеЗаполнено(Элемент) Или обЗначениеНеЗаполнено(Группа) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Группа) <> ТипЗнч(Элемент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Группа = Элемент Или Элемент.ПринадлежитЭлементу(Группа);
КонецФункции

