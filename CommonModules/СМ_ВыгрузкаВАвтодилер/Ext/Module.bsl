Функция ТелефонЦифрами(Объект)
	НаборЗаписейКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписейКИ.Отбор.Объект.Значение = Объект;
	НаборЗаписейКИ.Отбор.Объект.Использование = Истина;
	НаборЗаписейКИ.Отбор.Тип.Значение = Перечисления.ТипыКонтактнойИнформации.Телефон;
	НаборЗаписейКИ.Отбор.Тип.Использование = Истина;
	НаборЗаписейКИ.Прочитать();
	Представление = "";
	СтруктураТелефон = Новый Структура();
	СтруктураТелефон.Вставить("Представление", Представление);
	СтруктураТелефон.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	
	Для каждого Запись Из НаборЗаписейКИ Цикл
		Если ПустаяСтрока(Запись.Поле1) Тогда
			Представление = Запись.Поле2 + Запись.Поле3;
		Иначе
			Представление = Запись.Поле1 + Запись.Поле2 + Запись.Поле3;
			Представление = Сред(Представление, 2);
		КонецЕсли;
		Если обЗначениеНеЗаполнено(Представление) Тогда
			Представление = Запись.Представление;
		КонецЕсли;
		
		ТелефонТолькоЦифры = "";
		СимволовВПредставлении = СтрДлина(Представление);
		Если СимволовВПредставлении > 0 Тогда
			Для сч = 1 По СимволовВПредставлении Цикл
				СимволИзНомера = Сред(Представление, сч, 1);
				Если СтрНайти("1234567890", СимволИзНомера) > 0 Тогда
					ТелефонТолькоЦифры = ТелефонТолькоЦифры + СимволИзНомера;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
			
		СтруктураТелефон.Вставить("Представление", ТелефонТолькоЦифры);
		СтруктураТелефон.Вставить("Вид", Запись.Вид);
		
		Если Запись.ЗначениеПоУмолчанию Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтруктураТелефон;
КонецФункции

Функция ЭлПочтаКорректна(ЭлПочта)
	Если Не ЗначениеЗаполнено(ЭлПочта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(ЭлПочта, " ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДлинаАдреса = СтрДлина(ЭлПочта);
	Если ДлинаАдреса < 6 Тогда
		Возврат Ложь;
	КонецЕсли;	
	ЭлПочтаНР = НРег(ЭлПочта);
	Для сч = 1 По ДлинаАдреса Цикл
		СимволИзАдреса = Сред(ЭлПочтаНР, сч, 1);
		Если СтрНайти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", СимволИзАдреса) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Позиция1 = Найти(ЭлПочта, "@");
	Если Позиция1 < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Позиция2 = Найти(Сред(ЭлПочта, Позиция1), ".");
	Возврат Позиция2 > 2;
КонецФункции

Функция ПолучитьСоединениеHTTP(УзелОбмена)
	Таймаут = 120;
	SSL = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());
	Возврат Новый HTTPСоединение(УзелОбмена.Хост, , , , , Таймаут, SSL);
КонецФункции

Функция ПолучитьЗапросHTTP(УзелОбмена)
	ЗаголовкиHTTP = Новый Соответствие;
	ЗаголовкиHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Accept", "application/json");
	ЗаголовкиHTTP.Вставить("Connection", "Keep-Alive");
	
	Если ЗначениеЗаполнено(УзелОбмена.Токен) Тогда
		ЗаголовкиHTTP.Вставить("Authorization", "Bearer " + УзелОбмена.Токен);
		
	Иначе
		ВременныйФайл = ПолучитьИмяВременногоФайла();   
	    Запись = Новый ЗаписьТекста(ВременныйФайл, КодировкаТекста.UTF8);
	    Запись.Записать(УзелОбмена.Логин + ":" + УзелОбмена.Пароль);
	    Запись.Закрыть();    
	    ДвДанные = Новый ДвоичныеДанные(ВременныйФайл);
	    УдалитьФайлы(ВременныйФайл);	
		ЗаголовкиHTTP.Вставить("Authorization", "Basic " + Base64Строка(ДвДанные));	
	КонецЕсли;
	
	ЗапросHTTP = Новый HTTPЗапрос();
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
	Возврат ЗапросHTTP;
КонецФункции

Функция НайтиОбъекты(УзелОбмена, АдресРесурса, ВнешнийКод, ТоварыРаботы = Ложь)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	Если ТоварыРаботы Тогда
		ЗапросHTTP.АдресРесурса = АдресРесурса + "?purchase_id=" + ВнешнийКод;
	Иначе
		ЗапросHTTP.АдресРесурса = АдресРесурса + "?code=" + ВнешнийКод;
	КонецЕсли;	
	
	Для сч = 1 По 3 Цикл
		Попытка
			НТТРОтвет = НТТР.Получить(ЗапросHTTP);
			ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
			Если НТТРОтвет.КодСостояния < 300 Тогда
				ЧтениеJSON = Новый ЧтениеJSON();
				ЧтениеJSON.УстановитьСтроку(ТелоОтвета);				
				мОтвет = ПрочитатьJSON(ЧтениеJSON);
				Если ТипЗнч(мОтвет) = Тип("Массив") Или ТипЗнч(мОтвет) = Тип("Структура") Тогда
					Возврат мОтвет;									
				Иначе
					Возврат Неопределено;
				КонецЕсли;	
				
			Иначе
			#Если Клиент Тогда
				Сообщить("Получение идентификатора " + ЗапросHTTP.АдресРесурса + "(попытка " + сч + "):" + Символы.ПС 
				+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
				+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
			#КонецЕсли
				Продолжить;
			КонецЕсли;				
			
		Исключение
			#Если Клиент Тогда
				Сообщить("Ошибка при получении объектов " + ЗапросHTTP.АдресРесурса + "(попытка " + сч + "):" + Символы.ПС 
				+ ОписаниеОшибки()); 
			#КонецЕсли
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Функция НайтиОбъектПоПараметрам(УзелОбмена, АдресПараметрыРесурса)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = АдресПараметрыРесурса;
	
	Для сч = 1 По 3 Цикл
		Попытка
			НТТРОтвет = НТТР.Получить(ЗапросHTTP);
			ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
			Если НТТРОтвет.КодСостояния < 300 Тогда
				Если ТелоОтвета = "null" Тогда
					Возврат ТелоОтвета;
				КонецЕсли;
				
				ЧтениеJSON = Новый ЧтениеJSON();
				ЧтениеJSON.УстановитьСтроку(ТелоОтвета);				
				мОтвет = ПрочитатьJSON(ЧтениеJSON);
				Если ТипЗнч(мОтвет) = Тип("Массив") Тогда
					Если мОтвет.Количество() > 0 Тогда
						Возврат мОтвет[0];
					Иначе
						Возврат Неопределено;
					КонецЕсли;
					
				ИначеЕсли ТипЗнч(мОтвет) = Тип("Структура") Тогда
					Возврат мОтвет;
					
				Иначе
				#Если Клиент Тогда
					Сообщить("Получение объекта " + ЗапросHTTP.АдресРесурса + " (попытка " + сч + "):" + Символы.ПС 
					+ "Сервер вернул неверный тип данных: " + Строка(ТипЗнч(мОтвет))); 
				#КонецЕсли
					Возврат Неопределено;
				КонецЕсли;	
				
			Иначе
			#Если Клиент Тогда
				Сообщить("Получение объекта " + ЗапросHTTP.АдресРесурса + " (попытка " + сч + "):" + Символы.ПС 
				+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
				+ "Тело ответа: " + ТелоОтвета, СтатусСообщения.Важное);
			#КонецЕсли
				Продолжить;
			КонецЕсли;				
			
		Исключение
		#Если Клиент Тогда
			Сообщить("Ошибка при получении объекта " + ЗапросHTTP.АдресРесурса + " (попытка " + сч + "):" + Символы.ПС 
			+ ОписаниеОшибки()); 
		#КонецЕсли
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Неопределено;
