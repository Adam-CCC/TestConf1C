Функция НайтиРаботуТовар(мМассив, Код)
	Для Каждого стСтруктура Из мМассив Цикл
		Если ТипЗнч(стСтруктура) = Тип("Структура") И стСтруктура.Свойство("code") И
			СМ_ВыгрузкаВЛоджикСтарс.УдалитьТочку(стСтруктура.code) = Код Тогда
			Если стСтруктура.Свойство("id") Тогда
				Возврат стСтруктура.id;
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат 0;
КонецФункции

Функция НайтиРаботуВТЧ(ТЧРаботы, АртикулКодРаботы)
	Для Каждого СтрокаРабота Из ТЧРаботы Цикл
		Артикул = СокрЛП(СтрокаРабота.Работа.Артикул);
		Код = СокрЛП(СтрокаРабота.Работа.Код);
		Если Артикул = АртикулКодРаботы Или Код = АртикулКодРаботы Тогда
			Возврат СтрокаРабота.Работа;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиТоварВТЧ(ТЧТовары, АртикулТовара)
	Для Каждого СтрокаТовар Из ТЧТовары Цикл
		Артикул = СокрЛП(СтрокаТовар.Номенклатура.Артикул);
		Если СМ_ВыгрузкаВЛоджикСтарс.УдалитьТочку(Артикул) = АртикулТовара Тогда
			Возврат СтрокаТовар.Номенклатура;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КодРаботыДжили(СтрокаРабота, ЗаказНаряд)
	Если ЗначениеЗаполнено(СтрокаРабота.Работа.Артикул) Тогда
		КодРаботы = СокрЛП(СтрокаРабота.Работа.Артикул);
	Иначе
		КодРаботы = СокрЛП(СтрокаРабота.Работа.Код);
	КонецЕсли;
	
	НаименованиеРаботы = СтрокаРабота.Работа.Наименование;
	Если ЗаказНаряд.ВидРемонта.ТехОбслуживание Или ЗаказНаряд.ВидРемонта = Справочники.ВидыРемонта.ТО_нольПлатный Тогда
		Если стрНайти(НаименованиеРаботы, "ТО-") > 0 Тогда
			Суффикс = ЗаказНаряд.Автомобиль.ВариантКомплектации.КодТОДжили;
			Если ЗначениеЗаполнено(Суффикс) Тогда
				Если ЗаказНаряд.НомерТО < 10 Тогда
					Префикс = "ТО0" + Строка(ЗаказНаряд.НомерТО);
				ИначеЕсли ЗаказНаряд.НомерТО > 15 Тогда
					Префикс = "ТО99";
				Иначе
					Префикс = "ТО" + Строка(ЗаказНаряд.НомерТО);
				КонецЕсли;
				КодРаботы = Префикс + Суффикс;
			КонецЕсли;
		КонецЕсли;
			
	Иначе
		НаименованиеРаботы = НРег(НаименованиеРаботы);
		Если стрНайти(НаименованиеРаботы, "коммерческая мойка") > 0 Тогда
			КодРаботы = "CCWW" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "шиномонтаж") > 0 Тогда
			КодРаботы = "TIRE" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "предпродажная подготовка") > 0 Тогда
			КодРаботы = "PDIW" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "установка сигнализации") > 0 Тогда
			КодРаботы = "ALSI" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "установка защиты картера") > 0 Тогда
			КодРаботы = "ENPR" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "установка сетки защиты радиатора") > 0 Тогда
			КодРаботы = "RAPR" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "замена салонного фильтра") > 0 Тогда
			КодРаботы = "ACFI" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "замена моторного масла") > 0 Тогда
			КодРаботы = "OILC" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "замена топливного фильтра") > 0 Тогда
			КодРаботы = "FUEL" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "замена воздушного фильтра") > 0 Тогда
			КодРаботы = "AIRF" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "замена масла в кпп") > 0 Тогда
			КодРаботы = "TRSM" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "замена тормозных колодок") > 0 Тогда
			КодРаботы = "BRKE" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "замена тормозных дисков") > 0 Тогда
			КодРаботы = "DISC" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "сход-развал") > 0 Тогда
			КодРаботы = "CAST" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "установка брызговиков") > 0 Тогда
			КодРаботы = "MUDG" + КодРаботы;
		ИначеЕсли стрНайти(НаименованиеРаботы, "установка подкрылков") > 0 Тогда
			КодРаботы = "WHGU" + КодРаботы;
		КонецЕсли;
	КонецЕсли;
	
	Возврат КодРаботы;
КонецФункции

Функция ДанныеКлиента(Клиент, СписокТелефонов, Марка, ЭтоВыгрузка = Истина, ДокНомер = Неопределено, КлиентСервиса = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		Если ДокНомер = Неопределено Тогда
			стЗапись.Вставить("code", СокрЛП(Клиент.Код));
		Иначе
			стЗапись.Вставить("code", СокрЛП(ДокНомер));
		КонецЕсли;	
	КонецЕсли;
	
	Если Клиент.СогласиеНаУчастиеВПрограммеПроактивныйКонтакт = Перечисления.ВариантыОтветов.Да Тогда
		стЗапись.Вставить("client_confirm_communication", 1);
	Иначе
		стЗапись.Вставить("client_confirm_communication", 0);
	КонецЕсли;
	
	Если Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		стЗапись.Вставить("type", 0);
		
		стЗапись.Вставить("name", Клиент.Имя);
		//ЕстьСОПД = Клиент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да;
		ЕстьСОПД = Истина;
		Если Клиент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да Тогда
			стЗапись.Вставить("last_name", Клиент.Фамилия);
			стЗапись.Вставить("middle_name", Клиент.Отчество);
			стЗапись.Вставить("may_process_personal_data", 1);
			стЗапись.client_confirm_communication = 1;
			Если Марка = Справочники.Марка.TENET Тогда
				ДатаСогласия = Формат(Клиент.СогласиеНаОбработкуПерсональныхДанныхДата, "ДЛФ=Д");
				ДатаОкончанияСогласия = Формат(Клиент._г_ДатаОкончанияСогласия, "ДЛФ=Д");
				Согласия = Новый Массив();
