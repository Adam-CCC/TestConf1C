Функция ПолучитьСписокТелефонов(Объект)
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		Если Объект.Количество() > 0 Тогда
			стОбъект = Объект[0];		
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		стОбъект = Объект;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(стОбъект) = Тип("Структура") И стОбъект.Свойство("phones") Тогда
		Если ТипЗнч(стОбъект.phones) = Тип("Массив") Тогда
			Возврат стОбъект.phones;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
