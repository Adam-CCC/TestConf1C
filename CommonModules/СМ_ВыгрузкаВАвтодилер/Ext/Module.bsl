	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    РабочийЛист = ВыборкаИзменений.Получить();
	
		code = СокрЛП(РабочийЛист.Номер);
		мРабочийЛист = НайтиОбъекты(УзелОбмена, "/api/worksheet", code);
		Если мРабочийЛист = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		worksheet_id = ПолучитьИдентификатор(мРабочийЛист);		
		
		car_id = ВыгрузитьПотребность(УзелОбмена, РабочийЛист, worksheet_id);
		Если car_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, РабочийЛист);
			Продолжить;
		ИначеЕсли car_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		client_id = ВыгрузитьКлиентаПродажи(УзелОбмена, РабочийЛист, worksheet_id);
		Если client_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, РабочийЛист);
			Продолжить;
		ИначеЕсли client_id = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		worksheet_id = ВыгрузитьРабочийЛист(УзелОбмена, РабочийЛист, client_id, worksheet_id);
		Если worksheet_id > 0 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, РабочийЛист);
		КонецЕсли;
	КонецЦикла;
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

//// События
Функция ДанныеЗапланированногоСобытия(Событие, worksheet_id, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", Формат(Событие.Дата, "ДФ=""г""") + СокрЛП(Событие.Номер));
		стЗапись.Вставить("worksheet_id", worksheet_id);
	КонецЕсли;
	
	стЗапись.Вставить("opened", Формат(Событие.Дата, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("scheduled", Формат(Событие.ДатаНачала, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
	стЗапись.Вставить("scheduled_message", Лев(Событие.Содержание, 1000));
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
		ТелоЗапроса = ЗаписьJSON.Закрыть();
		Возврат ТелоЗапроса;
		
	Исключение
		Сообщить("Не удалось записать JSON-данные запланированного события для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;	
КонецФункции

Функция ДанныеЗавершенногоСобытия(Событие, manager_id, worksheet_id, car_id, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если Событие.ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля Тогда
		Если АвтомобильСПробегом(Событие.Автомобиль) Тогда
			ТипСобытия = "reject";
			стЗапись.Вставить("comment", "Купил автомобиль с пробегом");	
		Иначе
			ТипСобытия = "issue";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Событие.ФактическаяДатаВыдачиАвтомобиля) Тогда
			стЗапись.Вставить("occurred", Формат(Событие.ФактическаяДатаВыдачиАвтомобиля, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
		КонецЕсли;
		
	ИначеЕсли Событие.ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча Тогда
		ТипСобытия = "visit";
	ИначеЕсли Событие.ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок Тогда
		ТипСобытия = "call";
	ИначеЕсли Событие.ВидСобытия = Перечисления.ВидыСобытий.ТестДрайв Тогда
		ТипСобытия = "test-drive";
	ИначеЕсли Событие.ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля Тогда
		ТипСобытия = "reject";
	ИначеЕсли Событие.ВидСобытия = Перечисления.ВидыСобытий.ЗаявкаССайта Тогда
		ТипСобытия = "internet";
	ИначеЕсли Событие.ВидСобытия = Перечисления.ВидыСобытий.ЭлектронноеПисьмо Тогда
		ТипСобытия = "internet";
	ИначеЕсли Событие.ВидСобытия = Перечисления.ВидыСобытий.БачатаАвто Тогда
		ТипСобытия = "internet";
	Иначе
		ТипСобытия = "call";
	КонецЕсли;
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", Формат(Событие.Дата, "ДФ=""г""") + СокрЛП(Событие.Номер));
		стЗапись.Вставить("worksheet_id", worksheet_id);
		стЗапись.Вставить("car_id", car_id);
		стЗапись.Вставить("event_type", ТипСобытия);
	КонецЕсли;
	
	стЗапись.Вставить("manager_id", manager_id);
	//стЗапись.Вставить("scheduled", Формат(Событие.ДатаНачала, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
		
	Если ЗначениеЗаполнено(Событие.ДатаФактическогоЗавершения) Тогда
		ДатаФактическогоЗавершения = Событие.ДатаФактическогоЗавершения;
	Иначе
		ДатаФактическогоЗавершения = Событие.ДатаОкончания;
	КонецЕсли;
	Если Событие.Состояние = Перечисления.СостоянияСобытий.Отменено Тогда
		стЗапись.Вставить("canceled", Формат(ДатаФактическогоЗавершения, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
		стЗапись.Вставить("status", "canceled");
	Иначе
		стЗапись.Вставить("occurred", Формат(ДатаФактическогоЗавершения, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
		стЗапись.Вставить("status", "active");
	КонецЕсли;
	стЗапись.Вставить("comment", Лев(Событие.Результат, 1000));
	
	РабочийЛист = Событие.ДокументОснование;
	Марка = РабочийЛист.Модель.Марка;
	Если Событие.ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля Тогда
		Если Марка = Справочники.Марка.ESTEO Или Марка = Справочники.Марка.EXEED Тогда
			КодОтказа = Событие.ПричинаОтмены.КодЭксид;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 59);	
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.CHANGAN Тогда
			КодОтказа = Событие.ПричинаОтмены.КодЧанган;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
			Иначе
				стЗапись.Вставить("result_id", 59);	
			КонецЕсли;
						
		ИначеЕсли Марка = Справочники.Марка.UAZ Тогда // UAZ
			КодОтказа = Событие.ПричинаОтмены.КодУАЗ;
			Если КодОтказа > 0 Тогда
				стЗапись.Вставить("result_id", КодОтказа);	
