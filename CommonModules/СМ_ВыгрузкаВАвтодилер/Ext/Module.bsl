					ОтправитьСообщениеОбОшибке(стДанныеСообщения);
				КонецЕсли;				
				Возврат -422;
				
			Иначе
				Возврат 0;
			КонецЕсли;
			
		Иначе
			Возврат 0;
		КонецЕсли;	
		
	Иначе
		ТелоЗапроса = ДанныеПотребности(РабочийЛист, КодБренда, КодМодели, КодАлиаса);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/need";
			стРезультат = ВыгрузитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса, "Потребность для " + Строка(РабочийЛист));
			Если стРезультат.id > 0 Тогда
				Возврат стРезультат.id;
				
			ИначеЕсли стРезультат.КодСостояния = 422 Тогда
