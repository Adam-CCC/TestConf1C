			//УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ДельтаЧанганСобытие");
			УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("МалиновскогоЧанганСобытие");
