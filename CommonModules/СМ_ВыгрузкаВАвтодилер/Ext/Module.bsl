Процедура ВыгрузитьОтказОтАвтомобиля(РабЛистСсылка) Экспорт
	Если обЗначениеНеЗаполнено(РабЛистСсылка.Автомобиль) Или АвтомобильСПробегом(РабЛистСсылка.Автомобиль) Тогда
		Возврат;
	КонецЕсли;
	
	УзелОбмена = НайтиУзелОбменаДляРабЛиста(РабЛистСсылка);
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда
		Сообщить("Не найден Узел обмена для " + Строка(РабЛистСсылка) + ", выгрузка Отказа не возможна!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	СобытиеОтказ = Документы.Событие.СоздатьДокумент();
	СобытиеОтказ.Номер = РабЛистСсылка.Номер;
	СобытиеОтказ.ДокументОснование = РабЛистСсылка;
	СобытиеОтказ.ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля;
	СобытиеОтказ.Состояние = Перечисления.СостоянияСобытий.Завершено;
	СобытиеОтказ.ПричинаОтмены = Справочники.ВозраженияИПричиныОтказов.НайтиПоКоду("ЦБ000043"); //Передумал покупать
	СобытиеОтказ.ДатаОкончания = ТекущаяДата();
	СобытиеОтказ.Продавец = РабЛистСсылка.Менеджер;
	СобытиеОтказ.Результат = "Отказ от покупки автомобиля.";
	
	Если ВыгрузитьСобытие(УзелОбмена, СобытиеОтказ) > 0 Тогда
		Сообщить("Выгрузка Отказа для желтого автомобиля:", СтатусСообщения.Информация);
		Сообщить("Отказ по " + Строка(РабЛистСсылка) + " выгружен.", СтатусСообщения.Информация);
	КонецЕсли;
КонецПроцедуры

