Процедура РегистрацияИзмененныхДокументов(Источник, Отказ) Экспорт
	//Если Не СМ_УправлениеДоступом.ЭтоРабочаяБаза() Тогда
	//	Возврат;
	//КонецЕсли;
	
	//мТипыДокДвижений = Новый Массив();
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.ПеремещениеТоваровВПроизводство"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.РеализацияТоваров"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.ПоступлениеТоваров"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.ИзвлечениеТоваровИзПроизводства"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.КорректировкаПоступления"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.КорректировкаРеализации"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.ВозвратОтПокупателя"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.ВозвратПоставщику"));
	//мТипыДокДвижений.Добавить(Тип("ДокументОбъект.ПересортицаТоваров"));
