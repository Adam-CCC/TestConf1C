		КонецЕсли;
		Если ВыгружатьЭлПочту Тогда
			стЗапись.Вставить("company_email", ЭлПочта);
		КонецЕсли;
	КонецЕсли;
	
	стЗапись.Вставить("created");
	стЗапись.Вставить("updated");
	стЗапись.Вставить("fields");

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные контрагента для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ДанныеАнкетыСОПД(Клиент, ЭтоВладелец, ЗаказНаряд)	
	Если Клиент.ФормаСобственности <> Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		Возврат "";
	КонецЕсли;
	
	стЗапись = Новый Структура();
	стЗапись.Вставить("first_name", СокрЛП(Клиент.Имя));	
	стЗапись.Вставить("last_name", СокрЛП(Клиент.Фамилия));
	Отчество = СокрЛП(Клиент.Отчество);
	Если ЗначениеЗаполнено(Отчество) Тогда
		стЗапись.Вставить("middle_name", Клиент.Отчество);
	Иначе
		стЗапись.Вставить("middleNameRequired", Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Клиент.Пол) И Клиент.Пол = Перечисления.ПолФизическихЛиц.Женский Тогда
		стЗапись.Вставить("gender", 2);
	Иначе
		стЗапись.Вставить("gender", 1);
	КонецЕсли;
	
	СтруктураТелефон = ТелефонЦифрами(Клиент);	
	стЗапись.Вставить("phone", СтруктураТелефон.Представление);
	Если СтруктураТелефон.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий Тогда
		стЗапись.Вставить("phoneType", 2);
	Иначе
		стЗапись.Вставить("phoneType", 1);
	КонецЕсли;
	
	ЭлПочта = Клиент.ОсновнойАдресЭлектроннойПочты;
	Если обЗначениеНеЗаполнено(ЭлПочта) Тогда
		ЭлПочта = киПолучитьПредставлениеКИ(Клиент, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	КонецЕсли;
	ВыгружатьЭлПочту = ЭлПочтаКорректна(ЭлПочта);
	Если ВыгружатьЭлПочту Тогда
		стЗапись.Вставить("email", ЭлПочта);
	КонецЕсли;	
	
	стЗапись.Вставить("birthdayAt", Формат(Клиент.ДатаРождения, "ДЛФ=Д"));
	
	стЗапись.Вставить("passportType", 1);
	ЗапросПаспорт = Новый Запрос;
	ЗапросПаспорт.УстановитьПараметр("Владелец", Клиент);
	ЗапросПаспорт.Текст =
	"ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Серия КАК Серия,
	|	ПодтверждающиеДокументы.Номер КАК Номер,
	|	ПодтверждающиеДокументы.КемВыдан КАК КемВыдан,
	|	ПодтверждающиеДокументы.ДатаВыдачи КАК ДатаВыдачи
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Владелец
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт)
	|	И ПодтверждающиеДокументы.Текущий = ИСТИНА";
	
	ПаспортКлиента = ЗапросПаспорт.Выполнить().Выбрать();
	Если ПаспортКлиента.Следующий() Тогда
		стЗапись.Вставить("passportSeries", СтрЗаменить(ПаспортКлиента.Серия, " ", ""));
		стЗапись.Вставить("passportNumber", СтрЗаменить(ПаспортКлиента.Номер, " ", ""));
		стЗапись.Вставить("passportIssueDate", Формат(ПаспортКлиента.ДатаВыдачи, "ДЛФ=Д"));
		стЗапись.Вставить("passportAuthority", ПаспортКлиента.КемВыдан);
	Иначе
		стЗапись.Вставить("passportSeries", "");
		стЗапись.Вставить("passportNumber", "");
		стЗапись.Вставить("passportIssueDate", "");
		стЗапись.Вставить("passportAuthority", "");	
	КонецЕсли;
	
	Адрес = киПолучитьПредставлениеКИ(Клиент, Перечисления.ТипыКонтактнойИнформации.Адрес);
	стЗапись.Вставить("address", Адрес);
	
	Если ЭтоВладелец Тогда
		стЗапись.Вставить("role", 1);
	Иначе
		стЗапись.Вставить("role", 2);
	КонецЕсли;
	стЗапись.Вставить("type", 2);
	
	Автомобиль = ЗаказНаряд.Автомобиль;
	Модель = Автомобиль.Модель;
	Марка = Модель.Марка;
	Если Марка = Справочники.Марка.FORD Тогда
		КодБренда = 6; // Ford
		
	ИначеЕсли Марка = Справочники.Марка.UAZ Тогда
		КодБренда = 134; // УАЗ
		
	ИначеЕсли Марка = Справочники.Марка.GEELY Тогда
		КодБренда = 46; // Geely
		
	ИначеЕсли Марка = Справочники.Марка.BELGEE Тогда
		КодБренда = 2710; // Belgee
		
	ИначеЕсли Марка = Справочники.Марка.KNEWSTAR Тогда
		КодБренда = 2771; // KNEWSTAR
		
	ИначеЕсли Марка = Справочники.Марка.FIAT Тогда
		КодБренда = 45; // Fiat
		
	ИначеЕсли Марка = Справочники.Марка.JEEP Тогда
		КодБренда = 63; // Jeep
		
	ИначеЕсли Марка = Справочники.Марка.ESTEO Тогда
		КодБренда = 2796; // ESTEO
		
	ИначеЕсли Марка = Справочники.Марка.EXEED Тогда
		КодБренда = 2082; // EXEED
		
	ИначеЕсли Марка = Справочники.Марка.CHANGAN Тогда
		КодБренда = 140; // CHANGAN
		
	ИначеЕсли Марка = Справочники.Марка.LADA_ВАЗ Тогда
		КодБренда = 125; // LADA
		
	ИначеЕсли Марка = Справочники.Марка.GAC Тогда
		КодБренда = 2058; // GAC
		
	ИначеЕсли Марка = Справочники.Марка.VGV Тогда
		КодБренда = 2716; // VGV
		
	ИначеЕсли Марка = Справочники.Марка.HAVAL Или Марка = Справочники.Марка.GREAT_WALL Тогда
		Если ВИерархии(Модель, Справочники.Модели.НайтиПоКоду("ЦБ00005940")) Тогда
			КодБренда = 2732; // HAVAL Pro
		Иначе
			КодБренда = 152; // HAVAL City - одинаковый!
		КонецЕсли;
	
	Иначе
		КодБренда = 0;
	КонецЕсли;
	стЗапись.Вставить("brand_id", КодБренда);
	
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если мзИдентификаторыDSF.Выбран() Тогда		
		КодМодели = мзИдентификаторыDSF.DSF_id;
	Иначе
		КодМодели = 0;
	КонецЕсли;
	стЗапись.Вставить("model_id", КодМодели);
	
	стЗапись.Вставить("vin", Автомобиль.vin);
	стЗапись.Вставить("date", Формат(ЗаказНаряд.ДатаЗакрытия, "ДЛФ=Д"));
	 
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные контрагента для выгрузки в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ДанныеАвтомобиля(Автомобиль, КодБренда, КодМодели, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("brand_id", КодБренда);	// ID бренда
		стЗапись.Вставить("model_id", КодМодели);
		стЗапись.Вставить("code", СокрЛП(Автомобиль.Код));	
		стЗапись.Вставить("type", "vehicle"); // ТипАвто: need - потребность, vehicle - автомобиль
		стЗапись.Вставить("vin", Автомобиль.VIN);
		
		ВариантКомплектации = Строка(Автомобиль.ВариантКомплектации);
		Если ЗначениеЗаполнено(ВариантКомплектации) Тогда
			стЗапись.Вставить("version", ВариантКомплектации);	
		Иначе
			стЗапись.Вставить("version");	
		КонецЕсли;
		
		Цвет = Строка(Автомобиль.Цвет);
		Если ЗначениеЗаполнено(Цвет) Тогда
			стЗапись.Вставить("color", Цвет);	
		Иначе
			стЗапись.Вставить("color");	
		КонецЕсли;
	КонецЕсли;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
	стЗапись.Вставить("mileage", Пробег);
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	стЗапись.Вставить("reg_number", ГосНомер);
	стЗапись.Вставить("is_test_drive");
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для выгрузки автомобиля в Автодилер!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции

Функция ДанныеЗаказНаряда(ЗаказНаряд, client_id, contact_person_id, car_id, acceptor_id, Марка, ЭтоВыгрузка = Истина)
	стЗапись = Новый Структура();
	Если ЭтоВыгрузка Тогда
		стЗапись.Вставить("code", СокрЛП(ЗаказНаряд.Номер));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(client_id) Тогда
		стЗапись.Вставить("client_id", client_id);	// ID клиента
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(car_id) Тогда
		стЗапись.Вставить("car_id", car_id);	// ID автомобиля
	Иначе
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(acceptor_id) Тогда
		стЗапись.Вставить("acceptor_id", acceptor_id); //  ID мастера-приёмщика
	Иначе
		Возврат "";
	КонецЕсли;	
		
	стЗапись.Вставить("dateOpen", Формат(ЗаказНаряд.ДатаСоздания, "ДФ=""дд.ММ.гггг"""));	
	Состояние = ЗаказНаряд.Состояние;
	Если Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
		стЗапись.Вставить("dateClose", Формат(ЗаказНаряд.ДатаЗакрытия, "ДФ=""дд.ММ.гггг"""));
	ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка Тогда
		стЗапись.Вставить("accept_at", Формат(ЗаказНаряд.ДатаМашинозаезда, "ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""));
	КонецЕсли;		
	
	мзИдентификаторы = РегистрыСведений.УАЗDNMИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторы.ВидРемонта = ЗаказНаряд.ВидРемонта;
	мзИдентификаторы.Прочитать();
	ВидыРемонтаDNM = Новый Массив();
	Если мзИдентификаторы.Выбран() Тогда
		Если Марка = Справочники.Марка.FORD Тогда
			стЗапись.Вставить("purchase_type_id", мзИдентификаторы.ФордЦех_id);
			стЗапись.Вставить("purchase_group_id", мзИдентификаторы.ФордТипОплаты_id);
			Если мзИдентификаторы.ВидРемонта = Справочники.ВидыРемонта.ТехническоеОбслуживание Тогда
				ВидыРемонтаDNM.Добавить(мзИдентификаторы.ФордВидРемонта_id + 3*ЗаказНаряд.НомерТО); // ТО Форд
 			Иначе
				ВидыРемонтаDNM.Добавить(мзИдентификаторы.ФордВидРемонта_id);
			КонецЕсли;
			
			Если Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
				стЗапись.Вставить("status", "closed");
			ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Отказ Тогда
				стЗапись.Вставить("status", "canceled");
			Иначе
				стЗапись.Вставить("status", "opened");
			КонецЕсли;
			
		ИначеЕсли (Марка = Справочники.Марка.FIAT Или Марка = Справочники.Марка.JEEP) Тогда
			стЗапись.Вставить("purchase_type_id", мзИдентификаторы.FiatЦех_id);
			стЗапись.Вставить("purchase_group_id", мзИдентификаторы.FiatТипОплаты_id);
			ВидыРемонтаDNM.Добавить(мзИдентификаторы.FiatВидРемонта_id);
			
			Если Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
				стЗапись.Вставить("status", "closed");
			ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Отказ Тогда
				стЗапись.Вставить("status", "canceled");
			ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка Тогда
				стЗапись.Вставить("status", "application");
			Иначе
				стЗапись.Вставить("status", "opened");
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.EXEED Или Марка = Справочники.Марка.ESTEO Тогда
			стЗапись.Вставить("purchase_type_id", мзИдентификаторы.ExeedЦех_id);
			стЗапись.Вставить("purchase_group_id", мзИдентификаторы.ExeedТипОплаты_id);
			ВидыРемонтаDNM.Добавить(мзИдентификаторы.ExeedВидРемонта_id);
			
			Если Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
				стЗапись.Вставить("status", "closed");
			ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Отказ Тогда
				стЗапись.Вставить("status", "canceled");
			ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка Тогда
				стЗапись.Вставить("status", "application");
			Иначе
				стЗапись.Вставить("status", "opened");
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.UAZ Тогда
			стЗапись.Вставить("purchase_type_id", мзИдентификаторы.Цех_id);
			стЗапись.Вставить("purchase_group_id", мзИдентификаторы.ТипОплаты_id);
			ВидыРемонтаDNM.Добавить(мзИдентификаторы.ВидРемонта_id);
			
			Если Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
				стЗапись.Вставить("status", "closed");
			ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Отказ Тогда
				стЗапись.Вставить("status", "canceled");
			ИначеЕсли Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка Тогда
				стЗапись.Вставить("status", "application");
			Иначе
				стЗапись.Вставить("status", "opened");
			КонецЕсли;
			
		ИначеЕсли Марка = Справочники.Марка.GAC Тогда
			стЗапись.Вставить("purchase_type_id", мзИдентификаторы.GACЦех_id);
			стЗапись.Вставить("purchase_group_id", мзИдентификаторы.GACТипОплаты_id);
