Функция ВыгрузитьКлиента(УзелОбмена, Клиент, ДокументСсылка)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	ЗапросHTTP.АдресРесурса = "/api/client";
	code = СокрЛП(Клиент.Код);
	мКлиент = НайтиОбъекты(УзелОбмена, ЗапросHTTP.АдресРесурса, code);
	Если мКлиент = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	client_id = ПолучитьИдентификатор(мКлиент);
	СписокТелефонов = ПолучитьСписокТелефонов(мКлиент);
	Марка = УзелОбмена.МаркаАвтомобиля;
	Если client_id > 0 Тогда	
		ТелоЗапроса = ДанныеКлиента(Клиент, СписокТелефонов, Марка, Ложь);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗапросHTTP.АдресРесурса = "/api/client/" + Формат(client_id, "ЧГ=0,0");
			КодСостояния = ОбновитьОбъект(НТТР, ЗапросHTTP, ТелоЗапроса);
			Если КодСостояния < 300 Тогда
				Возврат client_id;
				
			ИначеЕсли КодСостояния = 422 Тогда
				СообщениеОбОшибке = СформироватьСообщениеОбОшибке(ТелоЗапроса);
				Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
					ТемаПисьма = "Ошибка при обновлении данных контрагента на портале Автодилер";
					ЗаголовокПисьма = Строка(ДокументСсылка) + Символы.ПС + "Контрагент " + Строка(Клиент);
					ТелоПисьма = ЗаголовокПисьма + Символы.ПС + СообщениеОбОшибке;
					
					стДанныеСообщения = Новый Структура();
					стДанныеСообщения.Вставить("Руководитель", УзелОбмена.Подразделение.РуководительСервиса.Сотрудник);
					стДанныеСообщения.Вставить("ТемаПисьма", ТемаПисьма);
					стДанныеСообщения.Вставить("ТелоПисьма", ТелоПисьма);
