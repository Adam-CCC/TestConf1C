			Если ЕстьСОПД Тогда
				//ЭтоНовыйТелефон = НовыйНомерТелефона(СписокТелефонов, СтруктураТелефон.Представление);
				//Если ЭтоНовыйТелефон Тогда
					Телефоны = Новый Массив();
					стТелефон = Новый Структура();
					стТелефон.Вставить("number", СтруктураТелефон.Представление);
