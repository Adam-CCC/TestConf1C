Функция ПолучитьИдентификатор(Объект)
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		Если Объект.Количество() > 0 Тогда
			стОбъект = Объект[0];		
		Иначе
			Возврат 0;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		стОбъект = Объект;
		
	Иначе
		Возврат 0;
	КонецЕсли;
	
