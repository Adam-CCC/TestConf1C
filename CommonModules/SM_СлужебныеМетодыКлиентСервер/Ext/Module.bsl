Процедура ИзменитьКоэффициентыИПересчитатьСуммы(ЭтотОбъект) Экспорт
	Товары							= ЭтотОбъект.Товары;
	ТаблицаЗначенийТовары			= Товары.Выгрузить();
	ПараметрыПроверки				= SM_СлужебныеМетодыФормСервер.ПроверитьТабличнуюЧастьТовары(ТаблицаЗначенийТовары);
	ТекстСОшибкамиЕдиницИзмерения 	= "";
	ТекстСОшибкамиРасчетаСуммы 		= "";
	
	Если ПараметрыПроверки.ЕстьОшибки Тогда
		Если ПараметрыПроверки.НомераСтрокСОшибкамиЕдиниц.Количество() > 0 Тогда
			ТекстСОшибкамиЕдиницИзмерения = "Изменена единица зимерения в строках: ";
			Для Каждого ИндексСтроки Из ПараметрыПроверки.НомераСтрокСОшибкамиЕдиниц Цикл 
				СтрокаТовара					= Товары[ИндексСтроки];
				БазоваяЕдиница					= СтрокаТовара.Номенклатура.ОсновнаяЕдиницаИзмерения;
				ТекущаяЕдиницаИзмерения			= СтрокаТовара.ЕдиницаИзмерения;
				СтрокаТовара.ЕдиницаИзмерения	= БазоваяЕдиница;
				ТекстСОшибкамиЕдиницИзмерения	= ТекстСОшибкамиЕдиницИзмерения + СтрШаблон(" %1) Было <%2> Стало <%3>",
																				СтрокаТовара.НомерСтроки,ТекущаяЕдиницаИзмерения,БазоваяЕдиница); 
			КонецЦикла;
		КонецЕсли;
		
		Если ПараметрыПроверки.ОшибкиРасчетаСуммы.Количество() > 0 Тогда
			ТекстСОшибкамиРасчетаСуммы = "Изменена цена и коэффициент в строках: ";
			Для Каждого КлючИЗначение Из ПараметрыПроверки.ОшибкиРасчетаСуммы Цикл
				ИндексСтроки					= КлючИЗначение.Ключ;
				СтрокаТовара					= Товары[ИндексСтроки];
				Количество						= СтрокаТовара.Количество;
				Сумма							= СтрокаТовара.Сумма;
				Коэффициент						= СтрокаТовара.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент;
				Цена							= Сумма / (Количество * Коэффициент);
				ТекущийКоэффициент				= СтрокаТовара.Коэффициент;
				ТекущаяЦена						= СтрокаТовара.Цена;
				СтрокаТовара.КоличествоБазовое	= Количество * Коэффициент;
				СтрокаТовара.Коэффициент		= Коэффициент; 
				СтрокаТовара.Цена				= Цена;  
				ТекстСОшибкамиРасчетаСуммы		= ТекстСОшибкамиРасчетаСуммы + СтрШаблон(" %1) Коэффициент был <%2> стал <%3>, Цена была <%4> стала <%5>",
																				СтрокаТовара.НомерСтроки,ТекущийКоэффициент,Коэффициент,ТекущаяЦена,Цена);
			КонецЦикла;
		КонецЕсли;
		ТекстКомментария = ?(ЗначениеЗаполнено(ТекстСОшибкамиЕдиницИзмерения),ТекстСОшибкамиЕдиницИзмерения + Символы.ПС,"") + 
						   ?(ЗначениеЗаполнено(ТекстСОшибкамиРасчетаСуммы),ТекстСОшибкамиРасчетаСуммы,"");
		ЭтотОбъект.Комментарий = ЭтотОбъект.Комментарий + ТекстКомментария;
		#Если Клиент Тогда 
			Сообщить("Данные изменены");
		#КонецЕсли
	КонецЕсли;
КонецПроцедуры

Процедура ОтключитьАвтоматическуюЗаменуЕдиницИзмеренияИСумм(ЭтотОбъект) Экспорт
	ЭтотОбъект.ДополнительныеСвойства.Вставить(SM_СлужебныеМетодыФормСервер.ПолучитьИмяДополнительногоСвойства_1());
КонецПроцедуры

Процедура ОтключитьВопросНаОтменуОшибки(ЭтотОбъект) Экспорт
	ЭтотОбъект.ДополнительныеСвойства.Вставить(SM_СлужебныеМетодыФормСервер.ПолучитьИмяДополнительногоСвойства_2());
КонецПроцедуры

Процедура ПроверитьДоступностьПроведенияРеализацииДляЮрЛицИФизЛиц(ЭтотОбъект)
	ВидКлиента			= ЭтотОбъект.Контрагент.ФормаСобственности; 
	Товары				= ЭтотОбъект.Товары;
	Параметры			= Модуль_ГВС.Присутствие_Маркированная_Номенклатура(Товары);
	ТекстОшибки			= "Перепродажа отменена в связи с частичной перепродажей номенклатур:" + Символы.ПС;
	ЭтоНеПолныеПрава 	= Не РольДоступна("ПолныеПрава");                                                   
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОтменитьПерепродажу",Ложь);
	
	Если Параметры.Маркировка_Присутствует И ЭтоНеПолныеПрава И ВидКлиента = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда 
		Для Каждого СтрокаТоваров Из Товары Цикл 
			ТекущийТипНоменклатуры = СтрокаТоваров.Номенклатура.ТипНоменклатуры;
			Если ТекущийТипНоменклатуры = Справочники.ТипыНоменклатуры.НайтиПоКоду("ЦБ000096") Тогда                                                              
				ТекущаяНоменклатура								= СтрокаТоваров.Номенклатура;
				НомерСтроки										= СтрокаТоваров.НомерСтроки;
				ТекущийКоэффициент								= СтрокаТоваров.Коэффициент;
				ТекущееКоличество								= СтрокаТоваров.Количество;
				ТекущаяЕдиницаИзмерения							= СтрокаТоваров.ЕдиницаИзмерения;
				ТекущийКлассификатор							= ТекущаяЕдиницаИзмерения.ЕдиницаПоКлассификатору;
				ТекущийБазовыйКлассификатор						= ТекущаяНоменклатура.БазоваяЕдиницаИзмерения;
				ТекущийКлассификаторОсновнойЕдиницыИзмерения	= ТекущаяНоменклатура.ОсновнаяЕдиницаИзмерения.ЕдиницаПоКлассификатору;
				КоэффициентОсновнойЕдиницыИзмерения				= ТекущаяНоменклатура.ОсновнаяЕдиницаИзмерения.Коэффициент; 
				ТекущееКоличествоМаркировки						= ЭтотОбъект.КодыМаркировки.НайтиСтроки(Новый Структура("ИдентификаторТовара",СтрокаТоваров.ИдентификаторТовара)).Количество();
				
				Если ТекущийКлассификатор = ТекущийКлассификаторОсновнойЕдиницыИзмерения Тогда 
					ИсходноеЧисло = ТекущееКоличество;
					ЦелаяЧасть    = Цел(ИсходноеЧисло);
					Если ИсходноеЧисло = ЦелаяЧасть И ТекущееКоличество = ТекущееКоличествоМаркировки И ТекущийКоэффициент = КоэффициентОсновнойЕдиницыИзмерения Тогда
						
					Иначе
						ТекстОшибки	= ТекстОшибки + Символы.ПС +
						СтрШаблон("%1) %2 , Количество должно быть целым и коэффициент должен быть равен <%3>!!!Частичная продажа запрещена",НомерСтроки,ТекущаяНоменклатура,КоэффициентОсновнойЕдиницыИзмерения);     
						ЭтотОбъект.ДополнительныеСвойства.ОтменитьПерепродажу = Истина;
					КонецЕсли;
				ИначеЕсли ТекущийКлассификатор = ТекущийБазовыйКлассификатор Тогда
					Если ТекущийКоэффициент = 1 И ТекущееКоличество = КоэффициентОсновнойЕдиницыИзмерения Тогда
						
					Иначе
						ТекстОшибки	= ТекстОшибки + Символы.ПС +
						СтрШаблон("%1) %2 , Количество должно быть равно <%3> и коэффициент должен быть равен <1> !!! Частичная продажа запрещена",НомерСтроки,ТекущаяНоменклатура,КоэффициентОсновнойЕдиницыИзмерения);     
						ЭтотОбъект.ДополнительныеСвойства.ОтменитьПерепродажу = Истина;
					КонецЕсли;
				КонецЕсли;		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры