Функция НайтиДоговорОбщийМодуль(ПараметрыДоговора) Экспорт
	
	ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДоговорыВзаиморасчетов.Ссылка,
	|	ДоговорыВзаиморасчетов.ВидДоговора,
	|	ДоговорыВзаиморасчетов.Владелец,
	|	ДоговорыВзаиморасчетов.Организация,
	|	ДоговорыВзаиморасчетов.ДатаСоздания КАК ДатаСоздания,
	|	ДоговорыВзаиморасчетов.ПометкаУдаления,
	|	ДоговорыВзаиморасчетов.Владелец.ОсновнойДоговорВзаиморасчетов КАК ОснДоговор,
	|	ДоговорыВзаиморасчетов.ДляПерепродаж,
	|	ДоговорыВзаиморасчетов.ДляЗапчастей
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	|ГДЕ
	|	ДоговорыВзаиморасчетов.Владелец = &ВыбВладелец
	|	И ДоговорыВзаиморасчетов.Организация = &ВыбОрганизация
	|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВыбВидДоговора
	|	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорыВзаиморасчетов.ДляЗапчастей = ИСТИНА
	|	И ДоговорыВзаиморасчетов.ДляПерепродаж = ИСТИНА
	//Бондаренко++ 20220527
	|	И (ДоговорыВзаиморасчетов.ДатаКонца = &ПустаяДата
	|			ИЛИ ДоговорыВзаиморасчетов.ДатаКонца > &ТекущаяДата)
	//Бондаренко-- 20220527
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания";
	
	Запрос.УстановитьПараметр("ВыбВидДоговора", ПараметрыДоговора.ВидДоговора);
	Запрос.УстановитьПараметр("ВыбВладелец", ПараметрыДоговора.Контрагент);
	Запрос.УстановитьПараметр("ВыбОрганизация", ПараметрыДоговора.Организация);
	
	//Бондаренко++ 20220527
	Запрос.УстановитьПараметр("ПустаяДата",Дата(1,1,1));
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());	
	//Бондаренко-- 20220527
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорВзаиморасчетов = ВыборкаДетальныеЗаписи.Ссылка; 
		Если ВыборкаДетальныеЗаписи.ДляПерепродаж Тогда
			Прервать;
		КонецЕсли; 
	КонецЦикла;
	
	Если обЗначениеНезаполнено(ДоговорВзаиморасчетов) Тогда
		Дог = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		Дог.Автор=ПараметрыСеанса.Пользователь;
		Дог.ДатаСоздания=ТекущаяДата();
		Дог.ДатаНачала=ТекущаяДата();
		Дог.ВидДоговора=ПараметрыДоговора.ВидДоговора;
		Дог.Владелец = ПараметрыДоговора.Контрагент;
		Дог.Организация = ПараметрыДоговора.Организация;
		Дог.Подразделение = ПараметрыДоговора.Подразделение;
		Дог.ВалютаВзаиморасчетов=Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		Дог.ВидОплаты=Перечисления.ВидыОплаты.ПроизвольнаяОплата;
		Дог.ДляЗапчастей=Истина;
		Дог.ДляПерепродаж=Истина;
		Дог.Наименование = СокрЛП(Строка(Дог.ВидДоговора))
		+ ?(ПустаяСтрока(Дог.НомерДоговора),""," № " + СокрЛП(Дог.НомерДоговора))
		+ " в " + Дог.ВалютаВзаиморасчетов.Наименование
		+ " от "+Формат(Дог.ДатаНачала,"ДФ=дд.ММ.гг");
		Дог.УстановитьНовыйКод();
		
		Попытка
			Дог.Записать();
			ДоговорВзаиморасчетов = Дог.Ссылка;
		Исключение
			СМГ_Сообщить("ОШИБКА! Не удалось записать договор");		
		КонецПопытки;
		
	КонецЕсли; 
	
	Возврат ДоговорВзаиморасчетов;
	
	
КонецФункции // НайтиДоговорОбщийМодуль(ПараметрыДоговора)

Функция СоздатьДокументыПерепродажиПоЮрЛицамОбщийМодуль(ТоварыКПродаже,ДокументОснование,СкладОтправитель, СкладПолучатель) Экспорт 
	
 	ЕстьОшибки=Ложь;
	
	РеализацияОбъект = Документы.РеализацияТоваров.СоздатьДокумент();
	РеализацияОбъект.РегламентированныйУчет = Истина;
	РеализацияОбъект.Дата = ТекущаяДата();
	 
	РеализацияОбъект.ХозОперация = Справочники.ХозОперации.РеализацияТоваров;
	
	РеализацияОбъект.ДокументОснование=ДокументОснование;
	
	РеализацияОбъект.Организация = СкладОтправитель.Организация;
	РеализацияОбъект.ОбработкаРеквизита("Организация");
	
	РеализацияОбъект.ПодразделениеКомпании = СкладОтправитель.Подразделение;
	//РеализацияОбъект.ОбработкаРеквизита("ПодразделениеКомпании");
		
	РеализацияОбъект.СкладКомпании = СкладОтправитель;
	
	РеализацияОбъект.УстановитьНовыйНомер();
	
	РеализацияОбъект.ИсточникИнформации=Справочники.ИсточникиИнформации.ЛичныйВизит;
 	
	ДопПараметры = Новый Структура("НеРассчитыватьСкидки,ВозможностьИзмененияЦен",Истина,Ложь);
	РеализацияОбъект.ОбработкаРеквизита("СкладКомпании",,,ДопПараметры);
	
