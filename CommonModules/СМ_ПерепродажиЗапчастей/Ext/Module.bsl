	Попытка
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		#Если НаКлиенте Тогда
			СМГ_Сообщить(ОписаниеОшибки());
		#КонецЕсли
		ЕстьОшибки=Истина;
	КонецПопытки;	
 	
	Возврат ЕстьОшибки;
	
