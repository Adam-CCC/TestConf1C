  
Функция УниверсальнаяПерепродажаПоВсемСкладам(Ссылка_Товары,Ссылка_КодыМаркировки,Ссылка,ТекСкладКомпании) Экспорт 

	//Бондаренко++ 20220120
 	Отказ = Ложь;
	//Бондаренко-- 20220120
	
	СписокСкладов = Новый СписокЗначений;
	
	Для каждого Стр Из Ссылка_Товары Цикл 
		Если ТипЗНЧ(Ссылка)<>Тип("ДокументСсылка.ПеремещениеТоваров") Тогда 
			//Бондаренко++ 20220120
			Если обЗначениеНеЗаполнено(Стр.СкладКомпании) Тогда
			    Продолжить;
			КонецЕсли;
			Если Стр.СкладКомпании.Организация = ТекСкладКомпании.Организация Тогда
				Если ТипЗНЧ(Ссылка)<>Тип("ДокументСсылка.ПеремещениеТоваровВПроизводство") И ТипЗНЧ(Ссылка)<>Тип("ДокументСсылка.РеализацияТоваров") Тогда
					Продолжить;			
 				КонецЕсли;
			КонецЕсли;
			Если Стр.СкладКомпании = ТекСкладКомпании Тогда
				Продолжить;			
 			КонецЕсли;
            //Бондаренко-- 20220120
  			Если СписокСкладов.НайтиПоЗначению(Стр.СкладКомпании) = Неопределено Тогда
				СписокСкладов.Добавить(Стр.СкладКомпании);					
			КонецЕсли;
		Иначе 
			//Бондаренко++ 20220120
			Если обЗначениеНеЗаполнено(Стр.СкладыКомпании) Тогда
			    Продолжить;
			КонецЕсли;
			Если Стр.СкладыКомпании.Организация = ТекСкладКомпании.Организация Тогда
				Продолжить;			
 			КонецЕсли;
            //Бондаренко-- 20220120
 			Если СписокСкладов.НайтиПоЗначению(Стр.СкладыКомпании) = Неопределено Тогда
				СписокСкладов.Добавить(Стр.СкладыКомпании);					
			КонецЕсли;
		КонецЕсли;
 	КонецЦикла;
	
	//Бондаренко++ 20220120
	Если СписокСкладов.Количество() > 0 Тогда
	//Бондаренко-- 20220120	
 		Для каждого СкладОтправитель Из СписокСкладов Цикл
			//Бондаренко++ 20220120
			Если обЗначениеНеЗаполнено(СкладОтправитель.Значение) Тогда
				Продолжить;
			КонецЕсли;
			Если СкладОтправитель.Значение.Организация = ТекСкладКомпании.Организация Тогда
				//Бондаренко++ 20220120
				Если СкладОтправитель.Значение <> ТекСкладКомпании Тогда
					Если ТипЗНЧ(Ссылка) = Тип("ДокументСсылка.ПеремещениеТоваровВПроизводство") ИЛИ ТипЗНЧ(Ссылка) = Тип("ДокументСсылка.РеализацияТоваров") Тогда
						Отказ = СоздатьМежскладскоеПеремещение(Ссылка_Товары,Ссылка,СкладОтправитель.Значение,ТекСкладКомпании);
					КонецЕсли;	
 				КонецЕсли;
 				//Бондаренко++ 20220120
				Продолжить;			
			КонецЕсли;
			//Бондаренко-- 20220120
			Отказ = УниверсальнаяПерепродажа(Ссылка_Товары,Ссылка_КодыМаркировки,Ссылка,ТекСкладКомпании,СкладОтправитель.Значение);
			Если Отказ Тогда
				СМГ_Сообщить("Ошибка! Документы перепродажи не сформированы.",СтатусСообщения.ОченьВажное);
				СМГ_Сообщить("_____________________________________________",СтатусСообщения.ОченьВажное);	
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Отказ Тогда
			СМГ_Сообщить("Обработка по перепродаже завершена без ошибок.",СтатусСообщения.Обычное);	
			СМГ_Сообщить("=============================================",СтатусСообщения.Обычное);	
		КонецЕсли;
	//Бондаренко++ 20220120	
	Иначе
		СМГ_Сообщить("Список складов пустой. Нечего перепродавать.",СтатусСообщения.Обычное);	
  	КонецЕсли;                 	
    //Бондаренко-- 20220120
	
	Возврат Отказ;
	
КонецФункции // УнмверсальнаяПерепродажаПоВсемСкладам()

Функция УниверсальнаяПерепродажа(Ссылка_Товары,Ссылка_КодыМаркировки,Ссылка,ТекСкладКомпании,СкладОтправитель) Экспорт 
	
 	СтавкаНДС20 = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка", 20);
 	
	ЕстьОшибки=Ложь;
 	
 	РеализацияОбъект = Документы.РеализацияТоваров.СоздатьДокумент();
	РеализацияОбъект.РегламентированныйУчет = Истина;
	РеализацияОбъект.Дата = ТекущаяДата();
	РеализацияОбъект.УстановитьНовыйНомер();
	РеализацияОбъект.ХозОперация = Справочники.ХозОперации.РеализацияТоваров;
	
 	РеализацияОбъект.ДокументОснование=Ссылка;
	
	РеализацияОбъект.Организация = СкладОтправитель.Организация;
	РеализацияОбъект.ОбработкаРеквизита("Организация");
	
	РеализацияОбъект.ПодразделениеКомпании = СкладОтправитель.Подразделение;
 	
	РеализацияОбъект.СкладКомпании = СкладОтправитель;
	
	ДопПараметры = Новый Структура("НеРассчитыватьСкидки,ВозможностьИзмененияЦен",Истина,Ложь);
	РеализацияОбъект.ОбработкаРеквизита("СкладКомпании",,,ДопПараметры);
 	
	Попытка
		РеализацияОбъект.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
		РеализацияОбъект.ОбработкаРеквизита("ТипЦен");
	Исключение
		#Если НаКлиенте Тогда
			СМГ_Сообщить("ОШИБКА! Не найден тип цен 'Основной тип цен закупки'. Обработка прервана.", СтатусСообщения.ОченьВажное);
		#КонецЕсли 
		ЕстьОшибки=Истина;
		Возврат ЕстьОшибки;
	КонецПопытки;	
  	
	РеализацияОбъект.КурсВалютыВзаиморасчетов=1;
	РеализацияОбъект.КурсВалютыУпр=1;
	РеализацияОбъект.КурсДокумента=1;
	
	РеализацияОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	РеализацияОбъект.ОбработкаРеквизита("ВалютаДокумента");
 	
	РеализацияОбъект.Контрагент = ТекСкладКомпании.Организация.КонтрагентОрганизации;
	РеализацияОбъект.ОбработкаРеквизита("Контрагент");
	
  	ПараметрыДоговора = Новый Структура;
	ПараметрыДоговора.Вставить("Контрагент",РеализацияОбъект.Контрагент);
	ПараметрыДоговора.Вставить("ВидДоговора",Перечисления.ВидыДоговоров.Продажа);
	ПараметрыДоговора.Вставить("Организация",РеализацияОбъект.Организация);
	ПараметрыДоговора.Вставить("Подразделение",РеализацияОбъект.ПодразделениеКомпании);
	ПараметрыДоговора.Вставить("ТипДоговора",Перечисления.ТипыДоговоров.Договор); 
  	
	РеализацияОбъект.ДоговорВзаиморасчетов = НайтиДоговор(ПараметрыДоговора);
  	РеализацияОбъект.ОбработкаРеквизита("ДоговорВзаиморасчетов");	
	
	РеализацияОбъект.Автор = ПараметрыСеанса.Пользователь;
	РеализацияОбъект.Комментарий = "Создан автоматически "+ТекущаяДата()+" пользователем "+ПараметрыСеанса.Пользователь+" для перепродажи запасных частей между организациями";
	
	//Бондаренко++ 20241225
	//Если РеализацияОбъект.Организация.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Упрощенная Тогда
	//	ТекСтавкаНДС=Справочники.СтавкиНДС.БезНДС;
	//Иначе	
	//	ТекСтавкаНДС=СтавкаНДС20;
	//КонецЕсли;
 	ТекСтавкаНДС = СМГ_ПолучитьСтавкуНДС(РеализацияОбъект.Организация,РеализацияОбъект.Дата);
 	//Бондаренко-- 20241225
	
	Для Каждого стр из Ссылка_Товары Цикл 
		
		Если ТипЗНЧ(Ссылка)<>Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			Если стр.СкладКомпании <> СкладОтправитель Тогда
				Продолжить;
	 		КонецЕсли;
		Иначе	
			Если стр.СкладыКомпании <> СкладОтправитель Тогда
				Продолжить;
	 		КонецЕсли;
 		КонецЕсли;
 		
		СтрокаРеализации = РеализацияОбъект.Товары.Добавить();
		СтрокаРеализации.Номенклатура = стр.Номенклатура;
		Попытка
			СтрокаРеализации.ИдентификаторТовара = стр.ИдентификаторТовара;
 		Исключение
	 	КонецПопытки;
  		
   		СтрокаРеализации.Цена = обПолучитьЦену(РеализацияОбъект.ТипЦен,СтрокаРеализации.Номенклатура,РеализацияОбъект.Дата,,РеализацияОбъект.ВалютаДокумента,РеализацияОбъект.КурсДокумента, ,СтрокаРеализации.ЕдиницаИзмерения , РеализацияОбъект.ПодразделениеКомпании);
 		 
		СтрокаРеализации.Количество = стр.Количество;
		СтрокаРеализации.ЕдиницаИзмерения = стр.ЕдиницаИзмерения;
  	   
	    СтрокаРеализации.СтавкаНДС = ТекСтавкаНДС;
 
	    ДопПараметры = Новый Структура;
	    
	    ДопПараметры.Вставить("НеКонтролироватьЗамены",Истина);
	    ДопПараметры.Вставить("ПересчитатьЦену",Истина);
	    РеализацияОбъект.ОбработкаРеквизита("Товары.Номенклатура", СтрокаРеализации,, ДопПараметры);
	  
	    РеализацияОбъект.ОбработкаРеквизита("Товары.ХарактеристикаНоменклатуры", СтрокаРеализации,, ДопПараметры);
	    РеализацияОбъект.ОбработкаРеквизита("Товары.ЕдиницаИзмерения", СтрокаРеализации,, ДопПараметры);
	    РеализацияОбъект.ОбработкаРеквизита("Товары.Количество", СтрокаРеализации,, ДопПараметры);
	    РеализацияОбъект.ОбработкаРеквизита("Товары.Коэффициент", СтрокаРеализации,, ДопПараметры);
		
  		СтрокаРеализации.СтавкаНДС = ТекСтавкаНДС;
		
	    РеализацияОбъект.ОбработкаРеквизита("Товары.СтавкаНДС", СтрокаРеализации,, ДопПараметры);
 		
 		СтрокаРеализации.СуммаВсего=СтрокаРеализации.Сумма;
  		РеализацияОбъект.ОбработкаРеквизита("Товары.СуммаВсего", СтрокаРеализации,, ДопПараметры);
		
	КонецЦикла;
	
 	Если Ссылка_КодыМаркировки.Количество() > 0 Тогда
 		//РеализацияОбъект.КодыМаркировки.Загрузить(ТабКодов);			
		Для каждого ТекКод Из Ссылка_КодыМаркировки Цикл          
			ПарОтбора = Новый Структура();
			ПарОтбора.Вставить("ИдентификаторТовара",ТекКод.ИдентификаторТовара);
			НайденныеСтроки = РеализацияОбъект.Товары.НайтиСтроки(ПарОтбора);
		    Если НайденныеСтроки.Количество() > 0  Тогда
				НоваяСтрокаКодовМаркировки = РеализацияОбъект.КодыМаркировки.Добавить();			
				НоваяСтрокаКодовМаркировки.ИдентификаторТовара = ТекКод.ИдентификаторТовара;
				НоваяСтрокаКодовМаркировки.КодМаркировки = ТекКод.КодМаркировки;
 			КонецЕсли;
 		КонецЦикла;
 	КонецЕсли; 
 	
	РеализацияОбъект.ПересчитатьПоСебестоимости(""); 
	
 	Для каждого СтрокаРеализации Из РеализацияОбъект.Товары Цикл
		Если СтрокаРеализации.Цена = 0 Тогда
			СтрокаРеализации.Цена = обПолучитьЦену(Справочники.ТипыЦен.ОсновнойТипЦенЗакупки,СтрокаРеализации.Номенклатура,РеализацияОбъект.Дата,,РеализацияОбъект.ВалютаДокумента,РеализацияОбъект.КурсДокумента, ,СтрокаРеализации.ЕдиницаИзмерения , Справочники.ПодразделенияКомпании.ОсновноеПодразделение );
			Если СтрокаРеализации.Цена = 0 Тогда
				СтрокаРеализации.Цена = обПолучитьЦену(Справочники.ТипыЦен.ОсновнойТипЦенЗакупки,СтрокаРеализации.Номенклатура,РеализацияОбъект.Дата,,РеализацияОбъект.ВалютаДокумента,РеализацияОбъект.КурсДокумента, ,СтрокаРеализации.ЕдиницаИзмерения, РеализацияОбъект.ПодразделениеКомпании);			   
			КонецЕсли;		
			Если СтрокаРеализации.Цена = 0 Тогда
				СтрокаРеализации.Цена = 1;			   
			КонецЕсли;
			СтрокаРеализации.Сумма = СтрокаРеализации.Цена*СтрокаРеализации.Количество*СтрокаРеализации.Коэффициент;
			СтрокаРеализации.СуммаВсего = СтрокаРеализации.Сумма;
			СтрокаРеализации.СуммаНДС = СтрокаРеализации.СуммаВсего*СтрокаРеализации.СтавкаНДС.Ставка/(100+СтрокаРеализации.СтавкаНДС.Ставка);				
		КонецЕсли;
	КонецЦикла;
 	
	Если ЕстьОшибки Тогда
		#Если НаКлиенте Тогда
			СМГ_Сообщить("ОШИБКА! Реализация для перепродажи не сформирована.",СтатусСообщения.ОченьВажное);
		#КонецЕсли 
		Возврат ЕстьОшибки;
	КонецЕсли;
	
 	Попытка
		РеализацияОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		#Если НаКлиенте Тогда
			СМГ_Сообщить(ОписаниеОшибки());
		#КонецЕсли
		ЕстьОшибки=Истина;
	КонецПопытки;
	
	Попытка
		СвойствоАвто = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		СвойствоАвто.Объект   = РеализацияОбъект.Ссылка;
		СвойствоАвто.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДокументСозданАвтоматически;
		СвойствоАвто.Значение = Истина;
		СвойствоАвто.Записать(Истина);
	Исключение
 	Конецпопытки;	
 	
	Попытка
		РеализацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		#Если НаКлиенте Тогда
			СМГ_Сообщить(ОписаниеОшибки());
		#КонецЕсли
		ЕстьОшибки=Истина;
	КонецПопытки;	
	
	ТЗ_Себест = РеализацияОбъект.Движения.ПартииТоваровКомпании.Выгрузить();
 	ТЗ_Себест.Свернуть("Номенклатура","СуммаУпр,Количество");  
	
	ТЗ_Себест.Очистить();
	
	БылПовторныйПересчет=Ложь;
	
	Для Каждого СтрокаТовары Из РеализацияОбъект.Товары Цикл
		
		СуммаСписания = дкПолучитьСуммуСписания(РеализацияОбъект, "ПартииТоваровКомпании", , СтрокаТовары.Номенклатура,, СтрокаТовары.НомерСтроки);
		
		НовСтр = ТЗ_Себест.Добавить();
		НовСтр.Номенклатура = СтрокаТовары.Номенклатура;
		НовСтр.Количество = СтрокаТовары.Количество * СтрокаТовары.Коэффициент;
		НовСтр.СуммаУпр = СуммаСписания;
		
 		Если СтрокаТовары.Количество > 0 Тогда
 			Если РеализацияОбъект.Организация.ИНН = "616714023180" Тогда
				Если СуммаСписания > 1.00 Тогда
					СтрокаТовары.Цена  =  СуммаСписания / СтрокаТовары.Количество;
					СтрокаТовары.СуммаВсего = СтрокаТовары.Цена*СтрокаТовары.КоличествоБазовое;
					СтрокаТовары.Сумма=СтрокаТовары.Цена*СтрокаТовары.КоличествоБазовое;
					РеализацияОбъект.ОбработкаРеквизита("Товары.СуммаВсего", СтрокаТовары,, ДопПараметры);
					БылПовторныйПересчет=Истина;
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
 	КонецЦикла;
	
 	Если БылПовторныйПересчет Тогда
		Попытка
			РеализацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			#Если НаКлиенте Тогда
				СМГ_Сообщить(ОписаниеОшибки());
			#КонецЕсли
			ЕстьОшибки=Истина;
		КонецПопытки;
	КонецЕсли; 
 	
	Если ЕстьОшибки Тогда
		#Если НаКлиенте Тогда
			СМГ_Сообщить("ОШИБКА! Реализация для перепродажи не сформирована.",СтатусСообщения.ОченьВажное);
		#КонецЕсли 
		Возврат ЕстьОшибки;
	КонецЕсли; 
	
 	Попытка
		СвойствоАвто = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		СвойствоАвто.Объект   = РеализацияОбъект.Ссылка;
		СвойствоАвто.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДокументСозданАвтоматически;
		СвойствоАвто.Значение = Истина;
