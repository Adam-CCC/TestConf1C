Функция ПереместитьЗапасныеЧастиСПерепродажамиПриНеобходимости(ДокументИсточник) Экспорт
	
	Рез=Истина;
	
	СкладПолучатель = Справочники.СкладыКомпании.ПустаяСсылка();
	
	Попытка
		ТаблицаТоваровСИсточниками = ДокументИсточник.Товары.Выгрузить();
	Исключение
 		СМГ_Сообщить("ОШИБКА! Не удалось выгрузить табличную часть товары из документа "+ДокументИсточник);
		Рез=Ложь;
		Возврат Рез;		
 	КонецПопытки; 
 	
	Если ТипЗНЧ(ДокументИсточник) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
 		СкладПолучатель = ДокументИсточник.Цех.СкладКомпании;
	Иначе 
		СкладПолучатель = ДокументИсточник.СкладКомпании;
 	КонецЕсли; 
	
	СписокСкладов = Новый СписокЗначений;
	НовТаб = ТаблицаТоваровСИсточниками.Скопировать();
 	НовТаб.Свернуть("СкладКомпании");
	СписокСкладов.ЗагрузитьЗначения(НовТаб.ВыгрузитьКолонку("СкладКомпании"));
	
	Для Каждого СкладОтправитель из СписокСкладов Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("СкладКомпании",СкладОтправитель.Значение);
		ТаблицаТоваров = ТаблицаТоваровСИсточниками.Скопировать(Отбор);
		Если ТаблицаТоваров.Количество() > 0 Тогда
		    СоздатьДокументы(ТаблицаТоваров,ДокументИсточник,СкладОтправитель.Значение,СкладПолучатель);
 		КонецЕсли; 
	КонецЦикла;
  	
	Возврат Рез; 
	
КонецФункции // ПереместитьЗапасныеЧастиСПерепродажамиПриНеобходимости(ДокументИсточник)

Процедура СоздатьДокументы(ТаблицаТоваров,СсылкаНаДокументИнициатор,СкладОтправитель,СкладПолучатель) Экспорт
	
  	НачатьТранзакцию();
	
	СкладИсточникПеремещения = СкладОтправитель;
	
	Если СкладОтправитель.Организация <> СкладПолучатель.Организация Тогда
		СкладИсточникПеремещения = НайтиСоответствующийСкладОрганизации(СкладПолучатель.Организация,СкладОтправитель);
	 	ДокОбъектРеализация = СоздатьДокументыПерепродажиПоЮрЛицамОбщийМодуль(ТаблицаТоваров,СсылкаНаДокументИнициатор, СкладОтправитель, СкладИсточникПеремещения);
	КонецЕсли;	
	
	Если СкладИсточникПеремещения.Подразделение.Родитель <> СкладПолучатель.Подразделение.Родитель Или СкладИсточникПеремещения <> СкладПолучатель Тогда
		ДокОбъектПеремещение = СоздатьМежскладскоеПеремещениеОбщийМодуль(ТаблицаТоваров,СсылкаНаДокументИнициатор,СкладИсточникПеремещения,СкладПолучатель);
		Если Не обЗначениеНеЗаполнено(ДокОбъектПеремещение) Тогда
			Если Не обЗначениеНеЗаполнено(ДокОбъектРеализация) Тогда
				ДокОбъектПеремещение.ДокументОснование = ДокОбъектРеализация.Ссылка;
				Попытка
					ДокОбъектПеремещение.Записать(РежимЗаписиДокумента.Запись);
					СМГ_Сообщить("Записан документ: "+ДокОбъектПеремещение+" с документом-основанием: "+ДокОбъектПеремещение.ДокументОснование,СтатусСообщения.ОченьВажное);		
				Исключение
					СМГ_Сообщить("ОШИБКА!! Не удалось записать документ: "+ДокОбъектПеремещение,СтатусСообщения.ОченьВажное);		
				КонецПопытки; 
			КонецЕсли; 		
		КонецЕсли; 			
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
  	
КонецПроцедуры

Функция НайтиСоответствующийСкладОрганизации(Организация,Склад) Экспорт
	
	//Найти подразделение нужной организации в родительском подразделении
	
	НайденноеПодразделение = Справочники.ПодразделенияКомпании.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка,
	|	ПодразделенияКомпании.Родитель,
	|	ПодразделенияКомпании.Организация
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Родитель = &Родитель
	|	И ПодразделенияКомпании.Организация = &Организация
	|	И ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Родитель", Склад.Подразделение.Родитель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НайденноеПодразделение=ВыборкаДетальныеЗаписи.Ссылка; 
		Прервать;
	КонецЦикла;
	
	
	//Найти склад нужного типа в найденном подразделении
	
	НайденныйСклад = Справочники.СкладыКомпании.ПустаяСсылка();
	
	Если Не обЗначениеНеЗаполнено(НайденноеПодразделение) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладыКомпании.Ссылка,
		|	СкладыКомпании.ЭтоГруппа,
		|	СкладыКомпании.ПометкаУдаления,
		|	СкладыКомпании.Подразделение,
		|	СкладыКомпании.ВидСклада,
		|	СкладыКомпании.ТипСклада,
		|	СкладыКомпании.Основной КАК Основной
		|ИЗ
		|	Справочник.СкладыКомпании КАК СкладыКомпании
		|ГДЕ
		|	СкладыКомпании.ЭтоГруппа = ЛОЖЬ
		|	И СкладыКомпании.Подразделение = &НайденноеПодразделение
		|	И СкладыКомпании.ПометкаУдаления = ЛОЖЬ
		|	И СкладыКомпании.ВидСклада = ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Обычный)
		|	И СкладыКомпании.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.ЗапЧасти)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Основной УБЫВ";
		
		Запрос.УстановитьПараметр("НайденноеПодразделение", НайденноеПодразделение);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НайденныйСклад = ВыборкаДетальныеЗаписи.Ссылка;
			Прервать;
		КонецЦикла;
		
	КонецЕсли; 
	
	Возврат  НайденныйСклад;
	
КонецФункции
 
Процедура ТоварыСкладКомпанииНачалоВыбораИзСпискаОбщийМодуль(Элемент, СтандартнаяОбработка, Организация, ТекСтрока) Экспорт
	
 	ТекНоменклатура = ТекСтрока.Номенклатура;
	ТекСклад = ТекСтрока.СкладКомпании;
	
	Если обЗначениеНеЗаполнено(ТекНоменклатура) Тогда
		Возврат;
	КонецЕсли; 
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании,
		|	СУММА(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток) КАК КоличествоОстаток,
		|	СУММА(ОстаткиТоваровКомпанииОстатки.РезервОстаток) КАК РезервОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки КАК ОстаткиТоваровКомпанииОстатки
		|ГДЕ
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура = &Номенклатура
		//Бондаренко++ 20210311
		|	И (ОстаткиТоваровКомпанииОстатки.СкладКомпании.Организация.КонтрагентОрганизации В ИЕРАРХИИ (&НашиФирмы)
		|			ИЛИ ОстаткиТоваровКомпанииОстатки.СкладКомпании.Организация = &ТекущаяОрганизация)
		//Бондаренко-- 20210311
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании";
	
	Запрос.УстановитьПараметр("Номенклатура", ТекНоменклатура);
	//Бондаренко++ 20210311
	Запрос.УстановитьПараметр("НашиФирмы", Справочники.Контрагенты.НашиФирмы);
	Запрос.УстановитьПараметр("ТекущаяОрганизация",Организация);	
	//Бондаренко-- 20210311
 
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	НайдСтр = Новый Массив;
	
	Если Не обЗначениеНеЗаполнено(ТекСклад) Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("СкладКомпании",ТекСклад);
		НайдСтр = ТЗ.НайтиСтроки(Отбор);
	КонецЕсли; 
	
	Если НайдСтр.Количество() = 0 Тогда
		Рез = ТЗ.ВыбратьСтроку("Выберите склад остатков для ["+ТекНоменклатура.Артикул+"] "+ТекНоменклатура);
 	Иначе
		Рез = ТЗ.ВыбратьСтроку("Выберите склад остатков для ["+ТекНоменклатура.Артикул+"] "+ТекНоменклатура,НайдСтр[0]);
	КонецЕсли; 
 	
	Если Рез <> Неопределено Тогда
		ТекСтрока.СкладКомпании = Рез.СкладКомпании;	
	Иначе
		ТекСтрока.СкладКомпании = Справочники.СкладыКомпании.ПустаяСсылка();
 	КонецЕсли; 
  	
КонецПроцедуры
  
Функция ПерепродажаРазрешена(ДокСсылка) Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ = ДокСсылка.Товары.Выгрузить().Скопировать();
	ТЗ.Свернуть("СкладКомпании");
	ТекКонтр=ДокСсылка.Контрагент;
  	ФлагПерепродажаРазрешена = Истина;
	Для каждого Стр Из ТЗ Цикл
		Если (Стр.СкладКомпании.Организация.КонтрагентОрганизации.Родитель = Справочники.Контрагенты.НашиФирмы И ТекКонтр.Родитель=Справочники.Контрагенты.ДопОборудование) ИЛИ 
			 (Стр.СкладКомпании.Организация.КонтрагентОрганизации.Родитель = Справочники.Контрагенты.ДопОборудование И ТекКонтр.Родитель=Справочники.Контрагенты.НашиФирмы) Тогда
 				#Если НаКлиенте Тогда
				СМГ_Сообщить("Перепродажа со склада '"+Стр.СкладКомпании+"' контрагенту '"+ТекКонтр+"' запрещена.",СтатусСообщения.ОченьВажное);	 
 				#КонецЕсли
 				ФлагПерепродажаРазрешена = Ложь;				 
  		КонецЕсли; 
	КонецЦикла; 
 	Возврат ФлагПерепродажаРазрешена;
КонецФункции // ПерепродажаРазрешена(ТабличнаяЧастьТовары)
