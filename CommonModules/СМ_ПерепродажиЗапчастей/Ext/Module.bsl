Функция ГВС_УниверсальнаяПерепродажаПоВсемСкладам(Ссылка_Товары,Ссылка_КодыМаркировки,Ссылка,ТекСкладКомпании) Экспорт 

 	Отказ = Ложь;
	
	СписокСкладов = Новый СписокЗначений;
	
	Для каждого Стр Из Ссылка_Товары Цикл 
		Если ТипЗНЧ(Ссылка)<>Тип("ДокументСсылка.ПеремещениеТоваров") Тогда 
			//Бондаренко++ 20220120
			Если обЗначениеНеЗаполнено(Стр.СкладКомпании) Тогда
			    Продолжить;
			КонецЕсли;
			Если Стр.СкладКомпании.Организация = ТекСкладКомпании.Организация Тогда
				Если ТипЗНЧ(Ссылка)<>Тип("ДокументСсылка.ПеремещениеТоваровВПроизводство") И ТипЗНЧ(Ссылка)<>Тип("ДокументСсылка.РеализацияТоваров") Тогда
					Продолжить;			
 				КонецЕсли;
			КонецЕсли;
			Если Стр.СкладКомпании = ТекСкладКомпании Тогда
				Продолжить;			
 			КонецЕсли;
            //Бондаренко-- 20220120
  			Если СписокСкладов.НайтиПоЗначению(Стр.СкладКомпании) = Неопределено Тогда
				СписокСкладов.Добавить(Стр.СкладКомпании);					
			КонецЕсли;
		Иначе 
			//Бондаренко++ 20220120
			Если обЗначениеНеЗаполнено(Стр.СкладыКомпании) Тогда
			    Продолжить;
			КонецЕсли;
			Если Стр.СкладыКомпании.Организация = ТекСкладКомпании.Организация Тогда
				Продолжить;			
 			КонецЕсли;
            //Бондаренко-- 20220120
 			Если СписокСкладов.НайтиПоЗначению(Стр.СкладыКомпании) = Неопределено Тогда
				СписокСкладов.Добавить(Стр.СкладыКомпании);					
			КонецЕсли;
		КонецЕсли;
 	КонецЦикла;
	
	//Бондаренко++ 20220120
	Если СписокСкладов.Количество() > 0 Тогда
	//Бондаренко-- 20220120	
 		Для каждого СкладОтправитель Из СписокСкладов Цикл
			//Бондаренко++ 20220120
			Если обЗначениеНеЗаполнено(СкладОтправитель.Значение) Тогда
				Продолжить;
			КонецЕсли;
			Если СкладОтправитель.Значение.Организация = ТекСкладКомпании.Организация Тогда
				//Бондаренко++ 20220120
				Если СкладОтправитель.Значение <> ТекСкладКомпании Тогда
					Если ТипЗНЧ(Ссылка) = Тип("ДокументСсылка.ПеремещениеТоваровВПроизводство") ИЛИ ТипЗНЧ(Ссылка) = Тип("ДокументСсылка.РеализацияТоваров") Тогда
						Отказ = СоздатьМежскладскоеПеремещение(Ссылка_Товары,Ссылка,СкладОтправитель.Значение,ТекСкладКомпании);
					КонецЕсли;	
 				КонецЕсли;
 				//Бондаренко++ 20220120
				Продолжить;			
			КонецЕсли;
			//Бондаренко-- 20220120
			Отказ = УниверсальнаяПерепродажа(Ссылка_Товары,Ссылка_КодыМаркировки,Ссылка,ТекСкладКомпании,СкладОтправитель.Значение);
			Если Отказ Тогда
				СМГ_Сообщить("Ошибка! Документы перепродажи не сформированы.",СтатусСообщения.ОченьВажное);
				СМГ_Сообщить("_____________________________________________",СтатусСообщения.ОченьВажное);	
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Отказ Тогда
			СМГ_Сообщить("Обработка по перепродаже завершена без ошибок.",СтатусСообщения.Обычное);	
			СМГ_Сообщить("=============================================",СтатусСообщения.Обычное);
			Возврат Истина;
		КонецЕсли;
	//Бондаренко++ 20220120	
	Иначе
		СМГ_Сообщить("Список складов пустой. Нечего перепродавать.",СтатусСообщения.Обычное);
		Возврат Ложь;
  	КонецЕсли;                 	
    //Бондаренко-- 20220120
	
	//Возврат Отказ;
	
КонецФункции
