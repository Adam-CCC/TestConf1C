Функция ПолучитьШтрихкодНомеклатуры(Номенклатура) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ШтрихКоды.ШтрихКод КАК ШтрихКод
	               |ИЗ
	               |	РегистрСведений.ШтрихКоды КАК ШтрихКоды
	               |ГДЕ
	               |	ШтрихКоды.Объект = &Объект
	               |	И ШтрихКоды.ХарактеристикаНоменклатуры = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Объект", Номенклатура);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ШтрихКод;
	КонецЕсли;

	Возврат "";
КонецФункции 

Функция ПолучитьСледующийНомер(GTIN, Номенклатура) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(СчетчикВнутреннихКМ.СерийныйНомер) КАК МаксНомер
	|ИЗ
	|	РегистрСведений.СчетчикСерийногоНомераДляВнутреннегоКМ КАК СчетчикВнутреннихКМ";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.МаксНомер) Тогда
		НовыйНомер = Выборка.МаксНомер + 1;
	Иначе
		НовыйНомер = 1; // регистр вообще пуст - самый первый запуск
	КонецЕсли;

	// 2. Записываем новую запись именно под этот ГТИН
	Набор = РегистрыСведений.СчетчикСерийногоНомераДляВнутреннегоКМ.СоздатьНаборЗаписей();
	Набор.Отбор.GTIN.Установить(GTIN);

	Запись = Набор.Добавить();
	Запись.GTIN = GTIN;
	Запись.СерийныйНомер = НовыйНомер;
	Запись.Номенклатура = Номенклатура;
	
	Набор.Записать(Истина);

	Возврат Формат(НовыйНомер, "ЧЦ=6; ЧГ=0; ЧВН=");
КонецФункции
			                               	
Функция НайтиСгенерированныйКМ(GTIN, Номенклатура) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВнутренниеКодыМаркировок.ВнутреннийКодМаркировки КАК ВнутреннийКодМаркировки
	|ИЗ
	|	РегистрСведений.ВнутренниеКодыМаркировок КАК ВнутренниеКодыМаркировок
	|ГДЕ
	|	ВнутренниеКодыМаркировок.GTIN = &GTIN
	|	И ВнутренниеКодыМаркировок.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("GTIN", GTIN);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВнутреннийКодМаркировки;
	КонецЕсли;

	Возврат "";
КонецФункции

Функция СгенерироватьВнутреннийКМ(Номенклатура) Экспорт
	ШтрихкодНоменклатуры = ПолучитьШтрихкодНомеклатуры(Номенклатура);
	
	Если ЗначениеЗаполнено(ШтрихкодНоменклатуры) Тогда
		GTIN = "0" + ШтрихкодНоменклатуры;
	Иначе
		Сообщить("У номенклатуры отсутствует штрихкод");
		Возврат "";
	КонецЕсли;                                                
	СуществуетВнутреннийКМ = НайтиСгенерированныйКМ(GTIN, Номенклатура);
	Если ЗначениеЗаполнено(СуществуетВнутреннийКМ) Тогда
		Сообщить("Внутренний код маркировки для данной номенклатуры уже сгенерирован!", СтатусСообщения.Внимание);	
		Сообщить("Проверьте нету ли дубликата данного штрихкода", СтатусСообщения.Внимание);	
		Возврат СуществуетВнутреннийКМ;
	КонецЕсли;
	
	СерйныйНомер = ПолучитьСледующийНомер(GTIN, Номенклатура);
	ВнутреннийКМ = "!SM!" + "01" + GTIN + "21" + СерйныйНомер;
	Сообщить("Сгенерирован новый код маркировки - " + ВнутреннийКМ);
	
	МенеджерЗаписи = РегистрыСведений.ВнутренниеКодыМаркировок.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.ВнутреннийКодМаркировки = ВнутреннийКМ;
    МенеджерЗаписи.Номенклатура            = Номенклатура;
	МенеджерЗаписи.GTIN            		   = GTIN;
	МенеджерЗаписи.СерийныйНомер           = СерйныйНомер;
    МенеджерЗаписи.Записать(Истина);
	
	Возврат ВнутреннийКМ;	
КонецФункции

//=====================================================================================
// Из внешнего кода маркировки делаем внутреннюю
//=====================================================================================

Функция СделатьВнешнююМаркировкуВнутренней(КодМаркировки, Номенклатура) Экспорт

    //Разбираем КМ на GTIN и серийный номер
    ОбработкаШК = Обработки.ШтрихКоды.Создать();
    СтруктураМаркировки = ОбработкаШК.РазобратьСтрокуШтрихкодаGS1(КодМаркировки, Истина);
    
    Если НЕ СтруктураМаркировки.Разобран Тогда
        Сообщить("Не удалось разобрать КМ: " + КодМаркировки, СтатусСообщения.Важное);
        Возврат "";
    КонецЕсли;
    
    GTIN          = СтруктураМаркировки.ДанныеШтрихкода["01"].Значение;
    СерийныйНомер = СтруктураМаркировки.ДанныеШтрихкода["21"].Значение;
    
    //Смотрим состояние в регистре
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   СостоянияКМ.Состояние КАК Состояние
    |ИЗ
    |   РегистрСведений.СостоянияКодовМаркировки.СрезПоследних КАК СостоянияКМ
    |ГДЕ
    |   СостоянияКМ.Номенклатура = &Номенклатура
    |   И СостоянияКМ.GTIN = &GTIN
    |   И СостоянияКМ.СерийныйНомер = &СерийныйНомер";
    
    Запрос.УстановитьПараметр("Номенклатура",  Номенклатура);
    Запрос.УстановитьПараметр("GTIN",          GTIN);
    Запрос.УстановитьПараметр("СерийныйНомер", СерийныйНомер);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    //Если в обороте — не трогаем
    Если Выборка.Следующий() Тогда
		Если Выборка.Состояние = Перечисления.СостоянияКодовМаркировки.ВведенВОборот Тогда
		    Сообщить("КМ в обороте, внутренний код не создаётся: " + КодМаркировки, СтатусСообщения.Важное);
		    Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//Проверка разработан ли уже внутренниий КМ для внешнего КМ
	ЕстьВнутреннийКМДляВнешнегоКМ = ЕстьВнутреннийКМДляВнешнегоКМ(КодМаркировки);	
	Если ЗначениеЗаполнено(ЕстьВнутреннийКМДляВнешнегоКМ) Тогда
		Сообщить("Внутренний код маркировки уже разработан");
		Возврат ЕстьВнутреннийКМДляВнешнегоКМ;	
	КонецЕсли;
	
    // 4. Делаем внутренний КМ
    ВнешнийКМ = "01" + GTIN + "21" + СерийныйНомер;
    ВнутреннийКМ  = "!SM!" + ВнешнийКМ;
    
    // 5. Пишем в регистр
    МенеджерЗаписи = РегистрыСведений.ВнутренниеКодыМаркировок.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.ВнутреннийКодМаркировки = ВнутреннийКМ;
    МенеджерЗаписи.ВнешнийКодМаркировки    = ВнешнийКМ;
    МенеджерЗаписи.Номенклатура            = Номенклатура;
	МенеджерЗаписи.GTIN            		   = GTIN;
	МенеджерЗаписи.СерийныйНомер           = СерийныйНомер;
    МенеджерЗаписи.Записать(Истина);
    
    Возврат ВнутреннийКМ;
КонецФункции

Функция ЕстьВнутреннийКМДляВнешнегоКМ(ВнешнийКМ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнутренниеКодыМаркировок.ВнешнийКодМаркировки КАК ВнешнийКодМаркировки,
		|	ВнутренниеКодыМаркировок.ВнутреннийКодМаркировки КАК ВнутреннийКодМаркировки
		|ИЗ
		|	РегистрСведений.ВнутренниеКодыМаркировок КАК ВнутренниеКодыМаркировок
		|ГДЕ
		|	ВнутренниеКодыМаркировок.ВнешнийКодМаркировки = &ВнешнийКМ";
	
	Запрос.УстановитьПараметр("ВнешнийКМ", ВнешнийКМ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.ВнутреннийКодМаркировки;	
	КонецЦикла;
	
	Возврат "";
КонецФункции
