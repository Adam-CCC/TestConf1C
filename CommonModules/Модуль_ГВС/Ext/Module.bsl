Процедура СМГ_СписаниеМаркировки(Объект) Экспорт
	
	Если Не(ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказНаряд")) Тогда      
		Возврат;
	КонецЕсли;
	
		СостояниеКодаМаркировки = ?(Объект.ВидРемонта.ТипРемонта = Перечисления.ТипыРемонта.Платный,
		Перечисления.СостоянияКодовМаркировки.ВыведенИзОборотаРозничнаяПродажа,
		Перечисления.СостоянияКодовМаркировки.ВыведенИзОборотаИспользованДляСобственныхНуждПредприятия);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНарядТовары.Цена КАК Цена,
		|	МаркировкаТоваровВПроизводстве.ЗаказНаряд КАК ЗаказНаряд,
		|	МаркировкаТоваровВПроизводстве.Номенклатура КАК Номенклатура,
		|	""(01)"" + МаркировкаТоваровВПроизводстве.GTIN + ""(21)"" + МаркировкаТоваровВПроизводстве.СерийныйНомер КАК КодМаркировки,
		|	МаркировкаТоваровВПроизводстве.КодМаркировкиBase64 КАК КодМаркировкиBase64,
		|	МаркировкаТоваровВПроизводстве.ГТД КАК ГТД
		|ИЗ
		|	РегистрНакопления.МаркировкаТоваровВПроизводстве КАК МаркировкаТоваровВПроизводстве
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
		|		ПО МаркировкаТоваровВПроизводстве.ЗаказНаряд = ЗаказНарядТовары.Ссылка
		|			И МаркировкаТоваровВПроизводстве.Номенклатура = ЗаказНарядТовары.Номенклатура
		|ГДЕ
		|	МаркировкаТоваровВПроизводстве.ЗаказНаряд = &ЗаказНаряд
		|	И МаркировкаТоваровВПроизводстве.ВидДвижения = &ВидДвижения";
		
		Запрос.УстановитьПараметр("ЗаказНаряд", Объект.Ссылка);
		Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Приход);
		
		ТаблицаКодовМаркировки = Запрос.Выполнить();
		
		СМГ_ВыводИзОборотаМаркированнойНоменклатуры(ТаблицаКодовМаркировки,СостояниеКодаМаркировки,Объект); 
			
КонецПроцедуры

Процедура СМГ_ВыводИзОборотаМаркированнойНоменклатуры (ТаблицаКодовМаркировки,СостояниеКодаМаркировки,Объект)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВыводИзОборотаКодовМаркировки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВыводИзОборотаКодовМаркировки КАК ВыводИзОборотаКодовМаркировки
	|ГДЕ
	|	ВыводИзОборотаКодовМаркировки.ДокументОснование = &ДокументОснование
	|	И ВыводИзОборотаКодовМаркировки.Проведен
	|	И НЕ ВыводИзОборотаКодовМаркировки.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокументОснование",Объект.Ссылка);
	Пустой = Запрос.Выполнить().Пустой();
	
	Если Пустой Тогда
		
		Если Не ТаблицаКодовМаркировки.Пустой() Тогда //Если есть маркированный товар тогда начинаем списывать коды маркировки 
			
			Если СостояниеКодаМаркировки = Перечисления.СостоянияКодовМаркировки.ВыведенИзОборотаРозничнаяПродажа Тогда   
				ПричинаВывода = Перечисления.ПричиныВыводаИзОборота.РозничнаяПродажа;
			ИначеЕсли СостояниеКодаМаркировки = Перечисления.СостоянияКодовМаркировки.ВыведенИзОборотаИспользованДляСобственныхНуждПредприятия Тогда
				ПричинаВывода = Перечисления.ПричиныВыводаИзОборота.ДляСобственныхНужд;
			КонецЕсли;
			
			ВыводИзОборота = Документы.ВыводИзОборотаКодовМаркировки.СоздатьДокумент();
			ВыводИзОборота.Организация                     = Объект.Организация; 
			ВыводИзОборота.Дата                            = Объект.Дата;
			ВыводИзОборота.Статус                          = Перечисления.СтатусыВыводаИзОборота.Выполнен;
			ВыводИзОборота.ПричинаВывода                   = ПричинаВывода;
			ВыводИзОборота.ДокументОснование               = Объект.Ссылка;
			ВыводИзОборота.ВидПервичногоДокумента          = Перечисления.ВидыПервичныхДокументов.Прочее;
			ВыводИзОборота.НаименованиеПервичногоДокумента = Строка(Объект.Ссылка);
			ВыводИзОборота.НомерПервичногоДокумента        = Объект.Номер;
			ВыводИзОборота.ДатаПервичногоДокумента         = Объект.Дата;
			ВыводИзОборота.ДатаВыводаИзОборота             = ТекущаяДата();
			ВыводИзОборота.Автор                           = Объект.Автор;
			ВыводИзОборота.ПодразделениеКомпании           = Объект.ПодразделениеКомпании;
			
			ОбходНоменклатура          = ТаблицаКодовМаркировки.Выгрузить();
			ОбходНоменклатура.Свернуть("Номенклатура,Цена");
			КодыМаркировкиНоменклатуры = ТаблицаКодовМаркировки.Выгрузить();
			КодыМаркировкиНоменклатуры.Свернуть("Номенклатура,КодМаркировкиBase64,КодМаркировки");
			
			Для Каждого Строка Из ОбходНоменклатура Цикл
				//Галактионов ЧЗ ++
				Если Строка.Номенклатура.ТипНоменклатуры = Справочники.ТипыНоменклатуры.НайтиПоКоду("ЦБ000096") Тогда
					Продолжить;
				КонецЕсли;
				//Галактионов ЧЗ ++
				СтрокаТовара = ВыводИзОборота.Товары.Добавить();
				СтрокаТовара.Номенклатура = Строка.Номенклатура;
				СтрокаТовара.Цена         = Строка.Цена; // Вытянуть цену
				ВыводИзОборота.ОбработкаРеквизита("Товары.Номенклатура",СтрокаТовара);
				
				ПарОтбора = Новый Структура();
				ПарОтбора.Вставить("Номенклатура",СтрокаТовара.Номенклатура);
				
				НайденныеСтроки = КодыМаркировкиНоменклатуры.НайтиСтроки(ПарОтбора);
				СтрокаТовара.Количество         = НайденныеСтроки.Количество();	
				Если НайденныеСтроки.Количество() > 0  Тогда
					Для Каждого Строка Из НайденныеСтроки Цикл
						НоваяСтрокаКодовМаркировки = ВыводИзОборота.КодыМаркировки.Добавить();			
						НоваяСтрокаКодовМаркировки.ИдентификаторТовара = СтрокаТовара.ИдентификаторТовара;
						НоваяСтрокаКодовМаркировки.КодМаркировки       = Строка.КодМаркировки;
					КонецЦикла;
				КонецЕсли; 	
			КонецЦикла;   
			ВыводИзОборота.Записать(РежимЗаписиДокумента.Проведение);
			ОтправкаЗапросаВыводаИзОборота(ВыводИзОборота,Объект);
		Иначе
			Если РольДоступна("ПолныеПрава") Тогда
				Сообщить("В заказ-наряде нет маркированного товара.") 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры 
	
Процедура ОтправкаЗапросаВыводаИзОборота(Документ,Объект)
	
	ПричинаВывода = УправлениеКодамиМаркировкиКлиентСервер.ПричинаВыводаИзОборотаCSV(Документ.ПричинаВывода);
	
	Если НЕ ЗначениеЗаполнено(ПричинаВывода) Тогда
		Возврат;
	КонецЕсли;
	
	СтрОрганизация = Строка(Объект.Организация);
	ИмяКаталога  = "\\sokolmotors.lan\global\_Управляющая компания\Честный знак\ВыгрузкаМаркировки\"+СтрОрганизация;
	
	КаталогНаДиске = Новый Файл(ИмяКаталога); 
    Если Не КаталогНаДиске.Существует() Тогда
        СоздатьКаталог(ИмяКаталога);
		СоздатьКаталог(ИмяКаталога + "\Реализация-Авто");
		СоздатьКаталог(ИмяКаталога + "\Заказ-Наряд");
    КонецЕсли;
				
	ВидПервичногоДокумента = УправлениеКодамиМаркировкиКлиентСервер.ВидПервичногоДокументаCSV(Документ.ВидПервичногоДокумента);
	
	НаименованиеПервичногоДокумента = "";
	Если Документ.ВидПервичногоДокумента = Перечисления.ВидыПервичныхДокументов.Прочее Тогда
		НаименованиеПервичногоДокумента = Документ.НаименованиеПервичногоДокумента;
	КонецЕсли;
	
	ИмяФайла = "З_Н_Ч_" + Строка(Объект.Номер)+ "" + СтрОрганизация; 
	Расширение_ = ".csv";	
	ИмяКаталога  = ИмяКаталога+"\Заказ-Наряд\"+СтрЗаменить(Формат(Документ.Дата, "ДФ=yyyy.MM.dd"), ".", "_");
	
	КаталогНаДиске = Новый Файл(ИмяКаталога);
	
	Если Не КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(ИмяКаталога);
	КонецЕсли;  
	
	ФайлИмя = ИмяКаталога+"\"+ИмяФайла+Расширение_;  
	
	ТекстовыйФайл = Новый ТекстовыйДокумент();
	
	ПричинаВывода = СокрЛП(СтрЗаменить(Строка(ПричинаВывода),"предприятия",""));
	
	
	ТекстовыйФайл = ДобавитьТекст(ТекстовыйФайл,Документ,ПричинаВывода,ВидПервичногоДокумента,НаименованиеПервичногоДокумента);	
	ТекстовыйФайл.Записать(ФайлИмя, КодировкаТекста.UTF8,Символы.ПС);
	//\Заказ-Наряд\
КонецПроцедуры 

Функция ДобавитьТекст (ТекстовыйФайл,Документ,ПричинаВывода,ВидПервичногоДокумента,НаименованиеПервичногоДокумента) 
	
	ТекстовыйФайл.ДобавитьСтроку(
		"ИНН участника оборота,Причина вывода из оборота,Дата вывода из оборота,Тип первичного документа,"
		+ "Номер первичного документа,Дата первичного документа,Наименование первичного документа,"
		+ "Регистрационный номер ККТ,Версия");
	ТекстовыйФайл.ДобавитьСтроку(
		СтрШаблон("%1,%2,%3,%4,%5,%6,%7,%8,%9",
			СокрЛП(Документ.Организация.ИНН),
			ПричинаВывода,
			Формат(Документ.ДатаВыводаИзОборота, "ДФ=dd.MM.yyyy"),
			ВидПервичногоДокумента,
			Документ.НомерПервичногоДокумента,
			Формат(Документ.ДатаПервичногоДокумента, "ДФ=dd.MM.yyyy"),
			НаименованиеПервичногоДокумента,
			"",
			"4"));
	ТекстовыйФайл.ДобавитьСтроку("Параметры товаров,,,,,");
	ТекстовыйФайл.ДобавитьСтроку("КИ,Цена за единицу,Тип первичного документа,Номер первичного документа,"
		+ "Дата первичного документа,Наименование первичного документа");
	
	ОбъектШК = Обработки.ШтрихКоды.Создать();
	Для Каждого ТекущаяСтрока Из Документ.КодыМаркировки Цикл
		
		СтруктураМаркировки = ОбъектШК.РазобратьСтрокуШтрихкодаGS1(ТекущаяСтрока.КодМаркировки);
		
		Если НЕ СтруктураМаркировки.Разобран Тогда
			Продолжить;
		КонецЕсли;
		
		Идентификатор01 = "01" + СтруктураМаркировки.ДанныеШтрихкода["01"].Значение;
		// Замена по специфике csv
		Идентификатор21 = "21" + СтруктураМаркировки.ДанныеШтрихкода["21"].Значение;
		
		КИ = Идентификатор01 + Идентификатор21;
		КИ = СтрЗаменить(КИ, """", """""");
		
		// Параметры по ТЧ Товары
		НайденнаяСтрока = Документ.Товары.Найти(ТекущаяСтрока.ИдентификаторТовара, "ИдентификаторТовара");
		
		Цена = СтрЗаменить(Строка(НайденнаяСтрока.Цена * 100), Символы.НПП, "");
		
		ВидПервичногоДокумента = "";
		НомерПервичногоДокумента = "";
		ДатаПервичногоДокумента = "";
		НаименованиеПервичногоДокумента = "";
		Если ЗначениеЗаполнено(НайденнаяСтрока.ВидПервичногоДокумента) Тогда
			ВидПервичногоДокумента = УправлениеКодамиМаркировкиКлиентСервер.ВидПервичногоДокументаCSV(НайденнаяСтрока.ВидПервичногоДокумента);
			НомерПервичногоДокумента = НайденнаяСтрока.НомерПервичногоДокумента;
			ДатаПервичногоДокумента = Формат(НайденнаяСтрока.ДатаПервичногоДокумента, "ДФ=dd.MM.yyyy");
			Если НайденнаяСтрока.ВидПервичногоДокумента = Перечисления.ВидыПервичныхДокументов.Прочее Тогда
				НаименованиеПервичногоДокумента = НайденнаяСтрока.НаименованиеПервичногоДокумента;
			КонецЕсли;
		КонецЕсли;
		
		ТекстовыйФайл.ДобавитьСтроку(
			СтрШаблон(
				"%1,%2,%3,%4,%5,%6",
				"""" + КИ + """",
				Цена,
				ВидПервичногоДокумента,
				НомерПервичногоДокумента,
				ДатаПервичногоДокумента,
				НаименованиеПервичногоДокумента));
		
	КонецЦикла;
	
	ТекстовыйФайл.УстановитьТекст(СтрЗаменить(ТекстовыйФайл.ПолучитьТекст() + Символы.ПС, Символы.ПС + Символы.ПС, ""));
	Возврат ТекстовыйФайл;
	
КонецФункции //Галактионов -- 10.02.2024 ЧестныйЗнак

