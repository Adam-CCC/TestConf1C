//Честный_знак_10.10.2024

//1.Проверка таблицы на наличие маркированной номенклатуры
Функция Присутствие_Маркированная_Номенклатура(Товары) Экспорт
	
	Количество_Маркированной_Номенклатуры = 0; //Количество номенклатурных позиций
	Количество_В_Позиции = 0;                  //Количество в позиции
	
	Для Каждого Строка Из Товары Цикл
		ЭтоМаркируемаяНоменклатура = дкЭтоМаркируемаяНоменклатура(Строка.Номенклатура);
		Количество_Маркированной_Номенклатуры = ?(ЭтоМаркируемаяНоменклатура,Количество_Маркированной_Номенклатуры + 1,Количество_Маркированной_Номенклатуры);
		Количество_В_Позиции = ?(ЭтоМаркируемаяНоменклатура,Количество_В_Позиции + Строка.Количество,Количество_В_Позиции);
	КонецЦикла;
	
	Итог = Новый Структура ("Маркировка_Присутствует,Количество,Сумма_Количество_В_Позициях"
	,Булево(Количество_Маркированной_Номенклатуры)
	,Количество_Маркированной_Номенклатуры
	,Количество_В_Позиции);
	Возврат Итог;
	
КонецФункции

//2.Вывод кнопки на форму
Процедура Видимость_Кнопки_Загрузки_Файлов(ЭлементыФормы,Товары) Экспорт
	
	Параметры = Присутствие_Маркированная_Номенклатура(Товары);
	
	Если Параметры.Маркировка_Присутствует Тогда
		ЭлементыФормы.КоманднаяПанельТовары.Кнопки.Хранилище_Файлов_Честный_Знак.Доступность = Истина;
	Иначе 
		ЭлементыФормы.КоманднаяПанельТовары.Кнопки.Хранилище_Файлов_Честный_Знак.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

//3.Процедура состояний кнопки
Процедура Состояние_Хранилища_Файлов(ЭлементыФормы,Объект) Экспорт
	
	Значение_Хранилище_Файлов_Честный_Знак = Объект.Хранилище_Файлов_Честный_Знак.Получить();
	Кнопка_Загрузки_Файлов = ЭлементыФормы.КоманднаяПанельТовары.Кнопки.Хранилище_Файлов_Честный_Знак; 
	
	Если Значение_Хранилище_Файлов_Честный_Знак = Неопределено И Кнопка_Загрузки_Файлов.Доступность Тогда
		Кнопка_Загрузки_Файлов.Текст = "Загрузите файлы из честного знака";
		Кнопка_Загрузки_Файлов.Картинка = БиблиотекаКартинок.Нет;
	ИначеЕсли ТипЗнч(Значение_Хранилище_Файлов_Честный_Знак) = Тип("Массив") И Кнопка_Загрузки_Файлов.Доступность Тогда
		Кнопка_Загрузки_Файлов.Текст = "Данные загружены";
		Кнопка_Загрузки_Файлов.Картинка = БиблиотекаКартинок.Да;
	ИначеЕсли Не Кнопка_Загрузки_Файлов.Доступность Тогда
		Кнопка_Загрузки_Файлов.Текст = "";
		Кнопка_Загрузки_Файлов.Картинка = БиблиотекаКартинок.Пусто;
		Если Значение_Хранилище_Файлов_Честный_Знак <> Неопределено Тогда
			Объект.Коды_Маркировки_Честный_Знак.Очистить();
			Объект.Хранилище_Файлов_Честный_Знак = Новый ХранилищеЗначения(Неопределено);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//4.Загрузка и разбор файлов из честного знака
Процедура Загрузка_И_Разбор_Файлов_Из_Честного_Знака(Объект,Макет)
	
	Текст_Из_Файла = Новый ТекстовыйДокумент;
	
	Массив_Файлов = Новый Массив();
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);	
	ДиалогВыбораФайла.Заголовок  = "Выбирите файл(ы): ";
	ДиалогВыбораФайла.Расширение = "xml"; 
	ДиалогВыбораФайла.Фильтр     = "(*.xml)|*.xml";
	ДиалогВыбораФайла.МножественныйВыбор = Истина;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		Для Каждого Файл_Путь Из ДиалогВыбораФайла.ВыбранныеФайлы Цикл 	
			Текст_Из_Файла.Прочитать(Файл_Путь);
			Текст_XML = Текст_Из_Файла.ПолучитьТекст();
			Таблица_Значений = Преобразовать_XML_в_Таблица_Значений(Текст_XML,Макет);
			Файл = Новый Файл(Файл_Путь);
			Имя_Файла = Файл.Имя;	
			Если Таблица_Значений.Количество() = 0 Тогда
				Сообщить("В файле " + Имя_Файла + " отсутствует маркировка, файл не будет записан в документ.");
				Продолжить;
			Иначе
				Объект.Коды_Маркировки_Честный_Знак.Очистить();
				РазборСроки = Обработки.ШтрихКоды.Создать();
				Для Каждого Строка Из Таблица_Значений Цикл 
					Новая_Строка = Объект.Коды_Маркировки_Честный_Знак.Добавить(); 
					Структура = РазборСроки.РазобратьСтрокуШтрихкодаGS1(Строка.Колонка1,Истина,Истина);
					//Новая_Строка.КодМаркировки = "(01)" + Структура.ДанныеШтрихкода["01"].Значение + "(21)" + Структура.ДанныеШтрихкода["21"].Значение; 
					Новая_Строка.КодМаркировки = Строка.Колонка1;
				КонецЦикла;
				Массив_Файлов.Добавить(Новый ДвоичныеДанные(Файл_Путь));
				Объект.Хранилище_Файлов_Честный_Знак = Новый ХранилищеЗначения(Массив_Файлов,Новый СжатиеДанных(9));
				Сообщить("Файл " + Имя_Файла + " записан в документ.");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

//5.Текст XML в таблицу
Функция Преобразовать_XML_в_Таблица_Значений(Текст_XML,Макет);
	
	СхемаПреобразования = Макет; 
	СхемаПреобразования = СхемаПреобразования.ПолучитьТекст();
	
	ПроцессорПреобразования = Новый ПреобразованиеXSL;
	ПроцессорПреобразования.ЗагрузитьИзСтроки(СхемаПреобразования);
	РезультатПреобразованияXML = ПроцессорПреобразования.ПреобразоватьИзСтроки(Текст_XML);
	ЧтениеXML = Новый ЧтениеXML();
	ЧтениеXML.УстановитьСтроку(РезультатПреобразованияXML);
	Таблица_Значений = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	
	Возврат Таблица_Значений;
	
КонецФункции

//6.Процедура кнопки
Процедура Выполнение_Кнопки(Объект,Форма) Экспорт
	
	Объект.Коды_Маркировки_Честный_Знак.Очистить();
	Загрузка_И_Разбор_Файлов_Из_Честного_Знака(Объект,Объект.ПолучитьМакет("Сценарий"));
	Состояние_Хранилища_Файлов(Форма.ЭлементыФормы,Объект);
	
КонецПроцедуры

//7.Проведение с маркированной номенклатурой 
Процедура Проведение_С_Маркированной_Номенклатурой(Объект,Отказ) Экспорт  
	
	Параметры = Присутствие_Маркированная_Номенклатура(Объект.Товары); 
	
	Маркировки_Нет = Не Параметры.Маркировка_Присутствует;
	
	Если Маркировки_Нет Тогда
		Возврат;
	КонецЕсли;
	
	Значение_Хранилище_Файлов_Честный_Знак = Объект.Хранилище_Файлов_Честный_Знак.Получить();
	
	Если Значение_Хранилище_Файлов_Честный_Знак = Неопределено Тогда
		Отказ = Истина;
		Сообщить("Файл(ы) с честного знакак не загружен(ы)!!!"
		        "Проведение отменено.");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	//Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = Текст_Запроса();
	Таблица_С_Маркировкой_Из_Документа_ТЗ = Таблица_С_Маркировкой_Из_Документа(Объект.КодыМаркировки);
	Для Каждого Строка Из Таблица_С_Маркировкой_Из_Документа_ТЗ Цикл
		Строка.КодМаркировки = СтрЗаменить(СтрЗаменить(Строка.КодМаркировки,"(01)","01"),"(21)","21");
	КонецЦикла; 
	Коды_Маркировки_Честный_Знак_ТЗ = Объект.Коды_Маркировки_Честный_Знак.Выгрузить();
	Для Каждого Строка Из Коды_Маркировки_Честный_Знак_ТЗ Цикл
		Строка.КодМаркировки = СтрЗаменить(СтрЗаменить(Строка.КодМаркировки,"(01)","01"),"(21)","21");
	КонецЦикла;
	Запрос.УстановитьПараметр("ТаблицаСМаркировкойИзДокумента",Таблица_С_Маркировкой_Из_Документа_ТЗ);
	Запрос.УстановитьПараметр("МаркировкаИзФайлаЧестногоЗнака",Коды_Маркировки_Честный_Знак_ТЗ);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Если Таблица.Количество() > 0 Тогда
		Таблицу_Значений_В_Табличный_Документ(Таблица).Показать();
		Сообщить("Проведение отменено,QR-коды не совпадают.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

Функция Таблицу_Значений_В_Табличный_Документ(Таблица) 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Таблица);       
	Построитель.Вывести(ТабличныйДокумент);
		
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция Таблица_С_Маркировкой_Из_Документа(КодыМаркировки)
	
	Таблица_С_Маркировкой_Из_Документа = КодыМаркировки.ВыгрузитьКолонки("КодМаркировки");
	РазборСроки = Обработки.ШтрихКоды.Создать();
	Для Каждого Строка Из КодыМаркировки Цикл 	
		Новая_Строка = Таблица_С_Маркировкой_Из_Документа.Добавить();
		Строка_QR = "" + Строка.КодМаркировки;
		Структура = РазборСроки.РазобратьСтрокуШтрихкодаGS1(Строка_QR,Истина,Истина);
		//Новая_Строка.КодМаркировки = "(01)" + Структура.ДанныеШтрихкода["01"].Значение + "(21)" + Структура.ДанныеШтрихкода["21"].Значение;	
		Новая_Строка.КодМаркировки = Строка_QR;
	КонецЦикла;
	
	Возврат Таблица_С_Маркировкой_Из_Документа;
	
КонецФункции

Функция Текст_Запроса()
	
	Текст = "ВЫБРАТЬ
	        |	МаркировкаИзДокумента.КодМаркировки КАК КодМаркировки,
	        |	1 КАК Состояние
	        |ПОМЕСТИТЬ ТаблицаСМаркировкойИзДокумента1
	        |ИЗ
	        |	&ТаблицаСМаркировкойИзДокумента КАК МаркировкаИзДокумента
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	МаркировкаИзФайлаЧестногоЗнака.КодМаркировки КАК КодМаркировки,
	        |	-1 КАК Состояние
	        |ПОМЕСТИТЬ МаркировкаИзФайлаЧестногоЗнака1
	        |ИЗ
	        |	&МаркировкаИзФайлаЧестногоЗнака КАК МаркировкаИзФайлаЧестногоЗнака
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ТаблицаСМаркировкойИзДокумента.КодМаркировки КАК КодМаркировки,
	        |	ТаблицаСМаркировкойИзДокумента.Состояние КАК Состояние
	        |ПОМЕСТИТЬ ОбъединенеиеМаркировки
	        |ИЗ
	        |	ТаблицаСМаркировкойИзДокумента1 КАК ТаблицаСМаркировкойИзДокумента
	        |
	        |ОБЪЕДИНИТЬ
	        |
	        |ВЫБРАТЬ
	        |	МаркировкаИзФайлаЧестногоЗнака.КодМаркировки,
	        |	МаркировкаИзФайлаЧестногоЗнака.Состояние
	        |ИЗ
	        |	МаркировкаИзФайлаЧестногоЗнака1 КАК МаркировкаИзФайлаЧестногоЗнака
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	Объединенеие_Маркировки.КодМаркировки КАК КодМаркировки,
	        |	СУММА(Объединенеие_Маркировки.Состояние) КАК Состояние
	        |ПОМЕСТИТЬ Итог1
	        |ИЗ
	        |	ОбъединенеиеМаркировки КАК Объединенеие_Маркировки
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	Объединенеие_Маркировки.КодМаркировки
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	Итог_1.КодМаркировки КАК КодМаркировки,";
			Если РольДоступна("ПолныеПрава") Тогда
				Текст = Текст + "Итог_1.Состояние КАК Состояние,";
			КонецЕсли;
			Текст = Текст +"
			|	ВЫБОР
	        |		КОГДА Итог_1.Состояние = 1
	        |			ТОГДА ""Код не найден в файле честного знака""
	        |		КОГДА Итог_1.Состояние = -1
	        |			ТОГДА ""Код не найден в документе поступления""
	        |	КОНЕЦ КАК Информация
	        |ИЗ
	        |	Итог1 КАК Итог_1
	        |ГДЕ
	        |	Итог_1.Состояние <> 0";
	
	Возврат Текст;
	
КонецФункции

Функция ЕстьКириллица(ИсходнаяСтрока) Экспорт
	
	ЕстьКириллица=ложь;
	ИсходнаяСтрока=СокрЛП(ИсходнаяСтрока);
	Если СтрДлина(ИсходнаяСтрока)>0 Тогда
		Для Сч=1 по СтрДлина(ИсходнаяСтрока) Цикл
			Символ = НРег(Сред(ИсходнаяСтрока, Сч, 1));
			Если Найти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", Символ) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ложь;  
	
КонецФункции

//8. Запрет проведения БУ шины
Процедура Запрет_Проведения_БУ_Шин (Отказ,Товары) Экспорт	
	Для Каждого Строка Из Товары Цикл
		Тип_Номенклатуры = Строка.Номенклатура.ТипНоменклатуры;
		Шины_БУ = Справочники.ТипыНоменклатуры.НайтиПоКоду("ЦБ000090"); 
		Право_Проведение_С_Бу_Шинами = обПраво("РазрешитьПроведениеПоступленияСБуШинами"); 
		
		Если Тип_Номенклатуры = Шины_БУ Тогда
			
			Если Право_Проведение_С_Бу_Шинами Тогда  
				Возврат;
			КонецЕсли; 
			
			Отказ = Истина;
			Сообщить("Запрещенно проводить документ в котором присутствует номенклатура с типом шина БУ.
			        |Номенклатура:<"+Строка.Номенклатура.Наименование+">");
			Возврат;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

//9. QR-Код в базе 
Функция ПроверкаКорректностиВведенныхQRКодов(Источник) Экспорт
	
	Отказ = Ложь;
	//1. Разбор QRКода и получение таблицы значений для дальнейшей сверки
	ТаблицаКодовМаркировок = РазборQRКода(Источник);
	
	//2. Проверяем в регистре сведений "Состояние кодов маркировки" присутствие QR-кода
	НайденныеQRКоды = ПрисутствиеQRКодаВРегистре(ТаблицаКодовМаркировок,Источник);
	
	//3. Сраниваем 2 таблицы с QR кодами
	Для Каждого ТекущаяСтрока Из ТаблицаКодовМаркировок Цикл 
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Номенклатура" ,ТекущаяСтрока.Номенклатура );
		ПараметрыПоиска.Вставить("Организация"  ,Источник.Организация       );
		ПараметрыПоиска.Вставить("GTIN"         ,ТекущаяСтрока.GTIN         );
		ПараметрыПоиска.Вставить("СерийныйНомер",ТекущаяСтрока.СерийныйНомер);
		ПараметрыПоиска.Вставить("Состояние"    ,Перечисления.СостоянияКодовМаркировки.ВведенВОборот);
		
		Поиск = НайденныеQRКоды.НайтиСтроки(ПараметрыПоиска);
		
		Если Поиск.Количество() = 0 Тогда 
			ТекстСообщений = СтрШаблон("У организации <%1> в номенклатеру <%2> отсутвует QR-код <%3> в статусе В Обороте в базе данных.Проверьте документ поступление товаров.",Источник.Организация,ТекущаяСтрока.Номенклатура,ТекущаяСтрока.КодМаркировки);	
			Сообщить(ТекстСообщений,СтатусСообщения.ОченьВажное);
			Отказ = Истина;
		КонецЕсли;	
	КонецЦикла;  
	
	Возврат Отказ;
	
КонецФункции

Функция РазборQRКода (Источник) 
	
	ТаблицаКодовМаркировок = Новый ТаблицаЗначений;
	ТаблицаКодовМаркировок.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКодовМаркировок.Колонки.Добавить("ИдентификаторТовара",Новый ОписаниеТипов("Строка"));
	ТаблицаКодовМаркировок.Колонки.Добавить("КодМаркировки",Новый ОписаниеТипов("Строка"));
	ТаблицаКодовМаркировок.Колонки.Добавить("GTIN",Новый ОписаниеТипов("Строка"));
	ТаблицаКодовМаркировок.Колонки.Добавить("СерийныйНомер",Новый ОписаниеТипов("Строка"));
	
	ОбработкаШК = Обработки.ШтрихКоды.Создать();
	
	Для Каждого ТекущаяСтрока Из Источник.КодыМаркировки Цикл
		
		НоваяСтрока = ТаблицаКодовМаркировок.Добавить();
		
		СтруктураМаркировки =
		ОбработкаШК.РазобратьСтрокуШтрихкодаGS1(ТекущаяСтрока.КодМаркировки, Истина); 
		
		Если НЕ СтруктураМаркировки.Разобран Тогда
			Продолжить;
		КонецЕсли; 
		НоваяСтрока.Номенклатура        = Источник.Товары.Найти(ТекущаяСтрока.ИдентификаторТовара,"ИдентификаторТовара").Номенклатура;
		НоваяСтрока.ИдентификаторТовара = ТекущаяСтрока.ИдентификаторТовара;
		НоваяСтрока.КодМаркировки       = ТекущаяСтрока.КодМаркировки;
		НоваяСтрока.GTIN                = СтруктураМаркировки.ДанныеШтрихкода["01"].Значение;
		НоваяСтрока.СерийныйНомер       = СтруктураМаркировки.ДанныеШтрихкода["21"].Значение;	
		
	КонецЦикла;
	
	Возврат ТаблицаКодовМаркировок; 
	
КонецФункции 

Функция ПрисутствиеQRКодаВРегистре (ТаблицаКодовМаркировок,Источник)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаКодовМаркировки.СерийныйНомер КАК СерийныйНомер,
		|	ТаблицаКодовМаркировки.GTIN КАК GTIN
		|ПОМЕСТИТЬ ТаблицаКодовМаркировки
		|ИЗ
		|	&ТаблицаКодовМаркировки КАК ТаблицаКодовМаркировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостоянияКодовМаркировкиСрезПоследних.Период КАК Период,
		|	СостоянияКодовМаркировкиСрезПоследних.Номенклатура КАК Номенклатура,
		|	СостоянияКодовМаркировкиСрезПоследних.Организация КАК Организация,
		|	СостоянияКодовМаркировкиСрезПоследних.GTIN КАК GTIN,
		|	СостоянияКодовМаркировкиСрезПоследних.СерийныйНомер КАК СерийныйНомер,
		|	СостоянияКодовМаркировкиСрезПоследних.Состояние КАК Состояние
		|ПОМЕСТИТЬ СостояниеQRКодаВРегистреПоследнийСрез
		|ИЗ
		|	РегистрСведений.СостоянияКодовМаркировки.СрезПоследних(
		|			&Дата,
		|			(СерийныйНомер, GTIN) В
		|				(ВЫБРАТЬ
		|					ТаблицаКодовМаркировки.СерийныйНомер КАК СерийныйНомер,
		|					ТаблицаКодовМаркировки.GTIN КАК GTIN
		|				ИЗ
		|					ТаблицаКодовМаркировки КАК ТаблицаКодовМаркировки)) КАК СостоянияКодовМаркировкиСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(СостояниеQRКодаВРегистреПоследнийСрез.Период) КАК Период
		|ПОМЕСТИТЬ ПоследняяДатаQRКода
		|ИЗ
		|	СостояниеQRКодаВРегистреПоследнийСрез КАК СостояниеQRКодаВРегистреПоследнийСрез
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(СостояниеQRКодаВРегистреПоследнийСрез.Период, ДЕНЬ) КАК Период,
		|	СостояниеQRКодаВРегистреПоследнийСрез.Номенклатура КАК Номенклатура,
		|	СостояниеQRКодаВРегистреПоследнийСрез.Организация КАК Организация,
		|	СостояниеQRКодаВРегистреПоследнийСрез.GTIN КАК GTIN,
		|	СостояниеQRКодаВРегистреПоследнийСрез.СерийныйНомер КАК СерийныйНомер,
		|	СостояниеQRКодаВРегистреПоследнийСрез.Состояние КАК Состояние
		|ИЗ
		|	ПоследняяДатаQRКода КАК ПоследняяДатаQRКода
		|		ЛЕВОЕ СОЕДИНЕНИЕ СостояниеQRКодаВРегистреПоследнийСрез КАК СостояниеQRКодаВРегистреПоследнийСрез
		|		ПО (НАЧАЛОПЕРИОДА(СостояниеQRКодаВРегистреПоследнийСрез.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(ПоследняяДатаQRКода.Период, ДЕНЬ))";
	
	Запрос.УстановитьПараметр("ТаблицаКодовМаркировки",ТаблицаКодовМаркировок);
	Запрос.УстановитьПараметр("Дата",Источник.Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();			
		
КонецФункции

