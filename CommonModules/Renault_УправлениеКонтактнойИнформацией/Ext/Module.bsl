Функция РазобратьНомерТелефонаВСтруктуру(ПредставлениеТелефона) Экспорт
	
	ПреобразовыватьТелефон = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьТиповойФорматТелефонов;

	СтруктураНомераТелефона = Неопределено;
	
	Если НЕ ПустаяСтрока(ПредставлениеТелефона) Тогда
		
		МаксимальнаяДлинаВнутреннегоНомера = ПолучитьМаксимальнуюДлинуВнутреннегоНомера();
		
		СтруктураНомераТелефона = Новый Структура;
		СтруктураНомераТелефона.Вставить("КодСтраны",		"");
		СтруктураНомераТелефона.Вставить("КодГорода",		"");
		СтруктураНомераТелефона.Вставить("НомерТелефона",	"");
		СтруктураНомераТелефона.Вставить("Внутренний",	"");
		СтруктураНомераТелефона.Вставить("Представление",	"");
				
		// попытаемся разложить телефонный номер, если получится
		// на составляющие, если номер введен правильно
		// т.е. полностью 8(или 7, +7)903 7721122, то будем по нему звонить
		// номер должен прийти в следующем формате +7(903)7721122 или 8(903)7721122
		НомерТелефона = ПредставлениеТелефона;
		
		СтрокаЦифр = "0123456789";
		ОчищенныйНомер = "";
		ДлинаНомера = СтрДлина(НомерТелефона);
		
		Для НомерСимвола = 1 По ДлинаНомера Цикл
			ТекущийСимвол = Сред(НомерТелефона, НомерСимвола, 1);
			Если Найти(СтрокаЦифр, ТекущийСимвол) > 0 Тогда
				ОчищенныйНомер = ОчищенныйНомер + ТекущийСимвол;
			КонецЕсли;
		КонецЦикла;
		
		НомерТелефона = ОчищенныйНомер;
		
	    ДлинаНомераТелефона = СтрДлина(СокрЛП(НомерТелефона));
		
	    ЭтоВнутренний = (ДлинаНомераТелефона <= МаксимальнаяДлинаВнутреннегоНомера);

		Если ЭтоВнутренний Тогда
			СтруктураНомераТелефона.Внутренний = НомерТелефона;
		Иначе
			
			// удалим + если есть
			Если не ПреобразовыватьТелефон Тогда
				ПредставлениеТелефона = СтрЗаменить(ПредставлениеТелефона, "+", "");
			КонецЕсли;
			
			НомКодГородаНачало = Найти(ПредставлениеТелефона, "(");
			НомКодГородаКонец = Найти(ПредставлениеТелефона, ")");
				
			// если был просто введен номер, то передадим его и позвоним
			// если был введен как полный разберем
			Если НомКодГородаНачало = 0 И НомКодГородаКонец = 0 Тогда
				ПредставлениеТелефона = ?(Лев(ПредставлениеТелефона, 1) = "7", "+" + ПредставлениеТелефона, ПредставлениеТелефона);
				СтруктураНомераТелефона.НомерТелефона = ПредставлениеТелефона;
			Иначе
				КодСтраны = СокрЛП(Лев(ПредставлениеТелефона, НомКодГородаНачало-1));
				СтруктураНомераТелефона.КодСтраны = ?(Лев(КодСтраны, 1) = "7", "+" + КодСтраны, КодСтраны);
				СтруктураНомераТелефона.КодГорода = СокрЛП(Сред(ПредставлениеТелефона, НомКодГородаНачало+1, НомКодГородаКонец-НомКодГородаНачало-1));
				СтруктураНомераТелефона.НомерТелефона = Прав(ПредставлениеТелефона, СтрДлина(ПредставлениеТелефона)-НомКодГородаКонец);
				ПредставлениеТелефона = ?(Лев(ПредставлениеТелефона, 1) = "7", "+" + ПредставлениеТелефона, ПредставлениеТелефона);
			КонецЕсли;
			
		КонецЕсли;
						
	КонецЕсли;
	
	Возврат СтруктураНомераТелефона;
	
КонецФункции	

//v+
Функция СуществуютДублиТелефона(ВладелецТелефона,Телефон) Экспорт
	Если ТипЗнч(Телефон)=Тип("Строка") Тогда
		Индекс=Renault_ОбщиеФункции.ПреобразоватьНомерДляСохранения(Телефон,СтрДлина(Телефон));
	ИначеЕсли ТипЗнч(Телефон)=Тип("Число") Тогда
		Индекс=Телефон;
	Иначе Возврат Ложь КонецЕсли;
	Если Индекс=0 Тогда Возврат Ложь КонецЕсли;
	
	Запрос=Новый Запрос("Выбрать Первые 1 1 Из РегистрСведений.КонтактнаяИнформация ГДЕ CRM_ПолеХраненияНомера=&Индекс И Объект<>&ВладелецТелефона И Объект <> NULL");
	Запрос.УстановитьПараметр("Индекс",Индекс);
	Запрос.УстановитьПараметр("ВладелецТелефона",ВладелецТелефона);
	Результат=Запрос.Выполнить();
	Если Результат.Пустой() Тогда Возврат Ложь 
		
	Иначе
		Сообщить("Обнаружены дубли телефона "+Телефон);
		Возврат Истина	
	КонецЕсли;
КонецФункции	
//v-

Функция НормализацияНомераТелефона(НомерТелефона,ДилерскийЦентр) Экспорт
	
	Телефон = CRM_Сервер.Renault_CRM_СкорректироватьТелефонПриЗаписи(НомерТелефона);
	Телефон = СтрЗаменить(Телефон, "+", "");
	
	Если НЕ ПустаяСтрока(Телефон) Тогда
		
		ПервыйСимволТелефона = ДилерскийЦентр.ПервыйСимволТелефона;
		
		Если НЕ ПустаяСтрока(ПервыйСимволТелефона) Тогда
			
			КодСтраны = СокрЛП(Лев(Телефон, 1));
			Если (КодСтраны<>"7" И КодСтраны<>"8") Тогда
				Телефон = ПервыйСимволТелефона + Телефон;
			ИначеЕсли КодСтраны="7" Или КодСтраны="8" Тогда
				Телефон = ПервыйСимволТелефона + Прав(Телефон,СтрДлина(Телефон)-1);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат Телефон;
		
	Иначе
		
		Возврат НомерТелефона;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСтруктуруТелефонаПоПолям(НомерТелефона,ДилерскийЦентр) Экспорт
	
	СтруктураТелефона = Новый Структура;
	СтруктураТелефона.Вставить("Поле1",);
	СтруктураТелефона.Вставить("Поле2",);
	СтруктураТелефона.Вставить("Поле3",);

	СтруктураТелефона.Поле1 = ?(ЛЕВ(НомерТелефона,1) = "+", ЛЕВ(НомерТелефона,2),ЛЕВ(НомерТелефона,1));
	Если ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		Если ЗначениеЗаполнено(ДилерскийЦентр.ПервыйСимволТелефона) Тогда
			СтруктураТелефона.Поле1 = ДилерскийЦентр.ПервыйСимволТелефона;
		КонецЕсли;
	КонецЕсли;

	Если СтрНайти(НомерТелефона,"(") = 0 Тогда
		Если СтрНайти(ЛЕВ(НомерТелефона, СтрДлина(ДилерскийЦентр.ПервыйСимволТелефона)),ДилерскийЦентр.ПервыйСимволТелефона) = 0 Тогда
			Если СтрДлина(НомерТелефона) = 11 Тогда
				СтруктураТелефона.Поле2 = СРеД(НомерТелефона,2,3);
				СтруктураТелефона.Поле3 = СРЕД(НомерТелефона,5);
			Иначе
				СтруктураТелефона.Поле2 = ЛЕВ(НомерТелефона,3);
				СтруктураТелефона.Поле3 = СРЕД(НомерТелефона,4,СтрДлина(НомерТелефона));
			КонецЕсли;
		Иначе
			СтруктураТелефона.Поле2 = СРЕД(НомерТелефона,СтрДлина(ДилерскийЦентр.ПервыйСимволТелефона)+1,3);
			СтруктураТелефона.Поле3 = СРЕД(НомерТелефона,СтрДлина(ДилерскийЦентр.ПервыйСимволТелефона)+4,СтрДлина(НомерТелефона));
		КонецЕсли;	
	Иначе
		СтруктураТелефона.Поле2 = СРЕД(НомерТелефона,СтрНайти(НомерТелефона,"("),5);
		СтруктураТелефона.Поле3 = СРЕД(НомерТелефона,СтрНайти(НомерТелефона,"(")+6,СтрДлина(НомерТелефона));
	КонецЕсли;
	
	Возврат СтруктураТелефона;
	
КонецФункции