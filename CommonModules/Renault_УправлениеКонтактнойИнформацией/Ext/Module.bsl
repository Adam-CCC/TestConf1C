// Процедура создает или перезаписывает телефон клиента, используемый по умолчанию
Процедура ЗаписатьОсновнойТелефонКлиента(ПредставлениеТелефона, Клиент) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	СтруктураНомераТелефона = РазобратьНомерТелефонаВСтруктуру(ПредставлениеТелефона);
	ЕстьЗначениеПоУмолчанию = Ложь;
	Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	Набор.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Телефон);
	Набор.Отбор.Объект.Установить(Клиент);
	Набор.Прочитать();
	Для Каждого Запись Из Набор Цикл
		Если Запись.ЗначениеПоУмолчанию Тогда
			ЕстьЗначениеПоУмолчанию = Истина;
			Если ЗначениеЗаполнено(ПредставлениеТелефона) Тогда
				Если СтруктураНомераТелефона<>Неопределено Тогда
					Запись.Поле1 = СтруктураНомераТелефона.КодСтраны;
					Запись.Поле2 = СтруктураНомераТелефона.КодГорода;
					Запись.Поле3 = СтруктураНомераТелефона.НомерТелефона;
					Запись.Поле4 = СтруктураНомераТелефона.Внутренний;
				КонецЕсли;
				Запись.Представление = ПредставлениеТелефона;
			Иначе
				Набор.Удалить(Запись);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьЗначениеПоУмолчанию = Истина Тогда
		Если ЗначениеЗаполнено(ПредставлениеТелефона) Тогда
			Если Набор.Количество() = 0 Тогда
				Запись = Набор.Добавить();
				Запись.Объект = Клиент;
				Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
				Запись.ЗначениеПоУмолчанию = Истина;
				Если СтруктураНомераТелефона<>Неопределено Тогда
					Запись.Поле1 = СтруктураНомераТелефона.КодСтраны;
					Запись.Поле2 = СтруктураНомераТелефона.КодГорода;
					Запись.Поле3 = СтруктураНомераТелефона.НомерТелефона;
					Запись.Поле4 = СтруктураНомераТелефона.Внутренний;
				КонецЕсли;
				Запись.Представление = ПредставлениеТелефона;
			Иначе
				Записано = Ложь;
				Для Каждого Запись ИЗ Набор Цикл
					Если Запись.Представление = ПредставлениеТелефона Тогда
						Запись.ЗначениеПоУмолчанию = Истина;
						Записано = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ Записано = Истина Тогда
					Для Каждого Запись ИЗ Набор Цикл
						Если Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый Тогда
							Если СтруктураНомераТелефона<>Неопределено Тогда
								Запись.Поле1 = СтруктураНомераТелефона.КодСтраны;
								Запись.Поле2 = СтруктураНомераТелефона.КодГорода;
								Запись.Поле3 = СтруктураНомераТелефона.НомерТелефона;
								Запись.Поле4 = СтруктураНомераТелефона.Внутренний;
							КонецЕсли;
							Запись.Представление = ПредставлениеТелефона;
							Запись.ЗначениеПоУмолчанию = Истина;
							Записано = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ Записано = Истина Тогда
						Запись = Набор.Добавить();
						Запись.Объект = Клиент;
						Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
						Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
						Если СтруктураНомераТелефона<>Неопределено Тогда
							Запись.Поле1 = СтруктураНомераТелефона.КодСтраны;
							Запись.Поле2 = СтруктураНомераТелефона.КодГорода;
							Запись.Поле3 = СтруктураНомераТелефона.НомерТелефона;
							Запись.Поле4 = СтруктураНомераТелефона.Внутренний;
						КонецЕсли;
						Запись.Представление = ПредставлениеТелефона;
						Запись.ЗначениеПоУмолчанию = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Набор.Записать();
	
	КлиентОбъект = Клиент.ПолучитьОбъект();
	КлиентОбъект.ОсновнойТелефон = ПредставлениеТелефона;
	КлиентОбъект.Записать();
	
КонецПроцедуры

// Процедура создает или перезаписывает электронную почту клиента, используемую по умолчанию
Процедура ЗаписатьОсновнойEmailКлиента(ПредставлениеEmail, Клиент) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	// Сначала выберем все почтовые адреса клиента и поищем значение по умолчанию.
	// Если нашли, то переписываем представление или удаляем запись если ПредставлениеEmail = ""
	ЕстьЗначениеПоУмолчанию = Ложь;
	Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	Набор.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Набор.Отбор.Объект.Установить(Клиент);
	Набор.Прочитать();
	Для Каждого Запись Из Набор Цикл
		Если Запись.ЗначениеПоУмолчанию Тогда
			ЕстьЗначениеПоУмолчанию = Истина;
			Если ЗначениеЗаполнено(ПредставлениеEmail) Тогда
				Запись.Представление = ПредставлениеEmail;
			Иначе
				Набор.Удалить(Запись);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Если значение по умолчанию не нашли, но надо записать ( если ЗначениеЗаполнено(ПредставлениеEmail)),
	// то либо добавляем новую запись если их вообще нет,
	// либо проходимся по существующим - сначала ищем запись с таким же адресом, чтобы отметить основным
	// если такой нет, то перезаписываем адрес домашней почты
	Если НЕ ЕстьЗначениеПоУмолчанию = Истина Тогда
		Если ЗначениеЗаполнено(ПредставлениеEmail) Тогда
			Если Набор.Количество() = 0 Тогда
				Запись = Набор.Добавить();
				Запись.Объект = Клиент;
				Запись.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний;
				Запись.ЗначениеПоУмолчанию = Истина;
				Запись.Представление = ПредставлениеEmail;
			Иначе
				Записано = Ложь;
				Для Каждого Запись ИЗ Набор Цикл
					Если Запись.Представление = ПредставлениеEmail Тогда
						Запись.ЗначениеПоУмолчанию = Истина;
						Записано = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ Записано = Истина Тогда
					Для Каждого Запись ИЗ Набор Цикл
						Если Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний Тогда
							Запись.Представление = ПредставлениеEmail;
							Запись.ЗначениеПоУмолчанию = Истина;
							Записано = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если НЕ Записано = Истина Тогда
						Запись = Набор.Добавить();
						Запись.Объект = Клиент;
						Запись.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
						Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний;
						Запись.Представление = ПредставлениеEmail;
						Запись.ЗначениеПоУмолчанию = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Набор.Записать();
	
КонецПроцедуры

