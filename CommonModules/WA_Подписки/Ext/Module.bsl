Процедура WA_ЗаписьСпециальногоПредложения(Источник, Отказ) Экспорт
	Если Источник.Ссылка.ЭтоГруппа = Ложь Тогда
	Если Источник.Ссылка.ЭтоДополнительноеПредложение Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СвязанныеРаботы.Авторабота,
			|	СвязанныеРаботы.СвязаннаяРабота
			|ИЗ
			|	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
			|ГДЕ
			|	СвязанныеРаботы.Авторабота = &Работа";
			
		Запрос.УстановитьПараметр("Работа", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
		// Передача данных в WA
		ОтправитьЗапросВWA(Строка(Источник.Ссылка.Код),"4","C");
		КонецЕсли;
	КонецЕсли;
	КонецЕсли;
КонецПроцедуры
