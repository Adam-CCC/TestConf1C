Функция ПолучитьКлючСвязиСРаботой(Работы, Запчасть) Экспорт

	КлючСвязи = Неопределено;
	
	Если Работы.Количество() > 0 Тогда
		СписокРабот = Новый Массив;
		
		Для Каждого СтрокаРабот Из Работы Цикл
			СписокРабот.Добавить(СтрокаРабот.Работа);
		КонецЦикла;	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СвязанныеРаботы.Авторабота КАК Работа
			|ИЗ
			|	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
			|ГДЕ
			|	СвязанныеРаботы.Авторабота В(&СписокРабот)
			|	И СвязанныеРаботы.СвязаннаяРабота = &Запчасть";		
		Запрос.УстановитьПараметр("Запчасть", Запчасть);
		Запрос.УстановитьПараметр("СписокРабот", СписокРабот);   		
		Результат = Запрос.Выполнить();
		
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			
			Работа = Выборка.Работа;
			
			Для Каждого СтрокаРабот Из Работы Цикл
				Если СтрокаРабот.Работа = Работа Тогда
					КлючСвязи = СтрокаРабот.КлючСвязи;
					Прервать;
				КонецЕсли;				
			КонецЦикла; 			
		КонецЕсли;		
	КонецЕсли;
	
	Возврат КлючСвязи;
КонецФункции

