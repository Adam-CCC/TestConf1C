//Козлов Е.А. Конец

// Функция возвращает возможность проведения платежного документа без указания ссылки
// на заявку.
//
// Параметры:
//  нет.
//
// Возвращаемое значение:
//  Истина - если можно проводить, иначе Ложь.
//
Функция ЕстьРазрешениеПроводитьБезЗаявки() Экспорт

	СписокФильтров = Renault_Advanced_УправлениеПользователями.ПолучитьЗначениеПраваДляТекущегоПользователя(ПланыВидовХарактеристик.Renault_Advanced_ПраваПользователей.РазрешитьПроведениеПлатежаБезЗаявки, Истина);

	Возврат НЕ СписокФильтров.НайтиПоЗначению(Истина) = Неопределено;

КонецФункции // ЕстьРазрешениеПроводитьБезЗаявки()

// Проверяет остатки по регистрам "ЗаявкиНаРасходованиеСредств" и "ДенежныеСредстваВРезерве"
// по переданной в параметре заявке и управляет значением отказа в проведении платежного документа
//
// Параметры
//  ЗаявкаНаРасходованиеСредств	:Документ.ЗаявкаНаРасходованиеСредств  – заявка, для которой формируются остатки
//  Дата						:Дата –дата, на которую формируются остатки
//  Отказ						:Булево –отказ в проведении документа
//  Заголовок					:Строка –представление документа при проведении
//  БанковскийСчетКасса			:Банковский счет, касса - место списания денежных средств
//  СуммаДокумента				:Число - сумма денежных средств к списанию
//  СуммаВзаиморасчетов			:Число - сумма взаиморасчетов по документу
//
Процедура ПроверитьОстаткиПоЗаявке(Дата,Отказ,Заголовок,ПараметрыДокумента,ЕстьРазрешение) Экспорт
	
	ДоговорКонтрагента = ПараметрыДокумента.ДоговорКонтрагента;
	Сделка = ПараметрыДокумента.Сделка;
	ДокументПланированияПлатежа = ПараметрыДокумента.ДокументПланированияПлатежа;
	СуммаДокумента = ПараметрыДокумента.СуммаДокумента;
	ВалютаДокумента = ПараметрыДокумента.ВалютаДокумента;
	
	// Проверяем соответствие суммы взаиморасчетов документа сумме взаиморасчетов в ТЧ заявки

	Если ЕстьРазрешение И НЕ ЗначениеЗаполнено(ДокументПланированияПлатежа) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьРазрешение И НЕ ЗначениеЗаполнено(ДокументПланированияПлатежа) Тогда
		
		ТекстСообщения = "Договор: " + ДоговорКонтрагента 
		+ ", сделка: " + ?(ЗначениеЗаполнено(Сделка), Сделка, "не указана")
		+ ": не указана заявка.";
		
		Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения, Отказ, Заголовок);	
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЕстьРазрешение И НЕ ДокументПланированияПлатежа.Проведен Тогда
		
		Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке(Строка(ДокументПланированияПлатежа)+" не проведена.", Отказ, Заголовок);	
		
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ТекстУсловия = "ЗаявкаНаРасходование = &ДокументЗаявка";
	
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		ТекстУсловия = ТекстУсловия + "
		|И ДоговорКонтрагента = &ДоговорКонтрагента";
		Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сделка) Тогда
		ТекстУсловия = ТекстУсловия + "
		|И (Сделка = &Сделка ИЛИ Сделка=Неопределено)";
		Запрос.УстановитьПараметр("Сделка", Сделка);
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкиНаРасходованиеСредствОстатки.СуммаОстаток КАК СуммаОстаток
				   |	
	               |ИЗ
	               |	РегистрНакопления.Renault_Advanced_ЗаявкиНаРасходованиеСредств.Остатки(, " + ТекстУсловия + " ) КАК ЗаявкиНаРасходованиеСредствОстатки";
	
	Запрос.УстановитьПараметр("ДокументЗаявка", ДокументПланированияПлатежа);
	 		
	РезультатЗапроса = Запрос.Выполнить();
	ВыбраннаяЗаявка  = РезультатЗапроса.Выбрать();
	
	Если НЕ ВыбраннаяЗаявка.Следующий() Тогда
		ОстатокПоЗаявке = 0;
	Иначе
		ОстатокПоЗаявке = ?(ВыбраннаяЗаявка.СуммаОстаток = NULL, 0, ВыбраннаяЗаявка.СуммаОстаток);
	КонецЕсли;
	
	Если ВалютаДокумента <> ДокументПланированияПлатежа.ВалютаДокумента 
		И ОстатокПоЗаявке <> 0 Тогда
	
		ОстатокПоЗаявке = обПересчет(ОстатокПоЗаявке,ДокументПланированияПлатежа.ВалютаДокумента,Дата,ВалютаДокумента,Дата);	
	
	КонецЕсли;
	
	Если ОстатокПоЗаявке < СуммаДокумента Тогда
		ВалютаПлатежа = ВалютаДокумента;

		ТекстОшибки = "Договор: " + ДоговорКонтрагента + ", сделка: " + ?(ЗначениеЗаполнено(Сделка), Сделка, "не указана") + "
		|Сумма превышает остаток по заявке.
		|Текущий остаток = " + Формат(ОстатокПоЗаявке, "ЧЦ=15; ЧДЦ=2; ЧН=") + " " + ВалютаПлатежа + "
		|Сумма = "+Формат(СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧН=") + " " + ВалютаПлатежа;
		
		Если ЕстьРазрешение Тогда
			Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке(ТекстОшибки, , Заголовок, СтатусСообщения.Информация);
		Иначе
			Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке(ТекстОшибки, Отказ, Заголовок);
		КонецЕсли;

	КонецЕсли;
		
КонецПроцедуры // ПроверитьОстаткиПоЗаявке()

Функция ЕстьПравоСразуРезервироватьАвтомобиль(Пользователь) Экспорт
	Значение = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки
		|ПОМЕСТИТЬ ВТПраваИНастройкиПользователя
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Renault_Advanced_ЗначенияДополнительныхПравПользователя.Значение КАК Значение
		|ИЗ
		|	ВТПраваИНастройкиПользователя КАК ВТПраваИНастройкиПользователя
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Advanced_ЗначенияДополнительныхПравПользователя КАК Renault_Advanced_ЗначенияДополнительныхПравПользователя
		|		ПО ВТПраваИНастройкиПользователя.ПраваИНастройки = Renault_Advanced_ЗначенияДополнительныхПравПользователя.Пользователь
		|			И (Renault_Advanced_ЗначенияДополнительныхПравПользователя.Право = ЗНАЧЕНИЕ(ПланВидовХарактеристик.Renault_Advanced_ПраваПользователей.РазрешитьСтавитьАвтомобильВРезерв))";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);  	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();  		
		Выборка.Следующий();	
		
		Значение = Выборка.Значение;
	КонецЕсли; 
	
	Возврат Значение;
КонецФункции

// Проверяет выполнение необходимых для проведения условий - все работы имеют стадию
// "Выполнено" и все запчасти умеют статус "Установлен".
//
//Процедура ПроверитьВозможностьПроведения(Отказ, Заголовок = "", ЭтоЗакрытие = Ложь) Экспорт
Процедура ПроверитьВозможностьПроведения(Источник, Отказ, ЭтоЗакрытие = Ложь, СтатусВыполнено = Ложь) Экспорт
	
	Если СтатусВыполнено Тогда
		ТекстСообщения = "Установить статус ""Выполнено"" можно только тогда, когда установлены все запчасти и выполнены все работы.";		
	Иначе		
		ТекстСообщения = "Документ можно " + ?(ЭтоЗакрытие, "закрыть", "провести") + " только тогда, когда установлены все запчасти и выполнены все работы.";
	КонецЕсли;

	// Определим максимально возможный статус
	//МаксимальныйСтатусУстановлен = Renault_Advanced_СтатусыЗапчастей.НайтиСледующийСтатус(Справочники.Renault_Advanced_СтатусыЗапчастей.Установлен);
	//Если МаксимальныйСтатусУстановлен = Неопределено Тогда
		МаксимальныйСтатусУстановлен = Справочники.Renault_Advanced_СтатусыЗапчастей.Установлен;
	//КонецЕсли;
	
	// Сначала проверим табличную часть "Запчасти", потому что это
	// быстрее.
	Для Каждого СтрокаТабличнойЧасти Из Источник.Товары Цикл
		Если СтрокаТабличнойЧасти.DMS_Статус <> МаксимальныйСтатусУстановлен Тогда
			Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения, Отказ, "");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	// Теперь проверим, все ли работы выполнены.	
	Если Источник.Работы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры // ПроверитьВозможностьПроведения()

Функция ЭтоУслуга(Работа) Экспорт 
		
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Автоработы.Ссылка
	               |ИЗ
	               |	Справочник.Автоработы КАК Автоработы
	               |ГДЕ
	               |	Автоработы.Ссылка В ИЕРАРХИИ (&Услуги)
	               |	И Автоработы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Работа);
	Запрос.УстановитьПараметр("Услуги", Справочники.Автоработы.НайтиПоНаименованию("Услуги", Истина));
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// В наборе записей рассчитывает управленческие суммы из сумм взаиморасчетов
//
Процедура РассчитатьУправленческиеСуммы(ЗаказНарядОбъект, НаборЗаписей, НаборРесурсов)
	
	СписокРесурсов = Новый Структура(НаборРесурсов);
	
	Для Каждого Движение Из НаборЗаписей Цикл
		Для Каждого Ресурс Из СписокРесурсов Цикл
			Движение[Ресурс.Ключ + "Упр"] = Движение[Ресурс.Ключ] * ЗаказНарядОбъект.КурсВалютыУпр;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры // РассчитатьУправленческиеСуммы()

