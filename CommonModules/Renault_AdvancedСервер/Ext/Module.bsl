Процедура ИзвлечьЗначения(Строка, Массив, Разделитель, СимволКавычки, СтрокаФайла) Экспорт
	
	ПоискПоля = 0;
	АнализПоля = 1;
	АнализПоляСКавычкой = 2;
	ЗавершениеАнализаПоляСКавычкой = 3;
	
	Массив = Новый Массив;
	Если Строка = Неопределено ИЛИ СтрДлина(Строка) = 0 Тогда
		Массив.Добавить("");
		Возврат;
	КонецЕсли;
	
	Состояние = ПоискПоля;
	
	ЗначениеПоля = "";
	НачальнаяПозиция = 1;
	КонечнаяПозиция = СтрДлина(Строка);
	Индекс = 1;
	
	Пока Индекс <= КонечнаяПозиция Цикл
		
		ТекущийСимвол = Сред(Строка, Индекс, 1);
		
		Если Состояние = ПоискПоля Тогда
			
			Если ТекущийСимвол = СимволКавычки Тогда
				Состояние = АнализПоляСКавычкой;
				НачальнаяПозиция = Индекс + 1;
				ЗначениеПоля = "";
				Индекс = НайтиВПодстроке(Строка, НачальнаяПозиция, СимволКавычки);
				Продолжить;
				
			Иначе
				Если ТекущийСимвол = Разделитель Тогда
					Массив.Добавить("");
				Иначе
					Состояние = АнализПоля;
					НачальнаяПозиция = Индекс;
					Индекс = НайтиВПодстроке(Строка, НачальнаяПозиция, Разделитель);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли Состояние = АнализПоля Тогда
			
			Если ТекущийСимвол = Разделитель Тогда
				Массив.Добавить(Сред(Строка, НачальнаяПозиция, Индекс - НачальнаяПозиция));
				Состояние = ПоискПоля;
			КонецЕсли;
			
		ИначеЕсли Состояние = АнализПоляСКавычкой Тогда
			
			Если ТекущийСимвол = СимволКавычки Тогда
				Состояние = ЗавершениеАнализаПоляСКавычкой;
				ЗначениеПоля = ЗначениеПоля + Сред(Строка, НачальнаяПозиция, Индекс - НачальнаяПозиция);
			КонецЕсли;
			
		ИначеЕсли Состояние = ЗавершениеАнализаПоляСКавычкой Тогда
			
			Если ТекущийСимвол = Разделитель Тогда
				Массив.Добавить(ЗначениеПоля);
				Состояние = ПоискПоля;
			ИначеЕсли ТекущийСимвол = СимволКавычки Тогда
				Состояние = АнализПоляСКавычкой;
				ЗначениеПоля = ЗначениеПоля + СимволКавычки;
				НачальнаяПозиция = Индекс + 1;
				Индекс = НайтиВПодстроке(Строка, НачальнаяПозиция, СимволКавычки);
				Продолжить;
			Иначе
				ВызватьИсключение("Не найден разделитель """ + Разделитель + """ в строке " + СтрокаФайла + ".");
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Если Состояние = АнализПоляСКавычкой Тогда
		ВызватьИсключение("Нет закрывающей скобки в строке " + СтрокаФайла + ".");
	КонецЕсли;
	
	Если Состояние = ЗавершениеАнализаПоляСКавычкой Тогда
		Массив.Добавить(ЗначениеПоля);
	ИначеЕсли Состояние = АнализПоля Тогда
		Массив.Добавить(Сред(Строка, НачальнаяПозиция, Индекс - НачальнаяПозиция));
	КонецЕсли;
	
КонецПроцедуры // ИзвлечьЗначения()

Функция ПолучитьЗначение(Колонка, Значения, Колонки) Экспорт
	
	Индекс = Колонки.Получить(Колонка);
	
	Если Индекс = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Значения[Индекс];
	КонецЕсли;
	
КонецФункции // ПолучитьЗначение()

Функция НайтиВПодстроке(Стр1, Поз1, ИскомыйСимвол)
	
	Стр = Сред(Стр1, Поз1);
	Поз = Найти(Стр, ИскомыйСимвол);
	Если Поз = 0 Тогда
		Возврат СтрДлина(Стр1) + 1;
	КонецЕсли;
	  
	Возврат Поз1 + Поз - 1;
	
КонецФункции // НайтиВПодстроке()

Функция ПолучитьСкладыИзГруппы(ГруппаДоступностиСкладов, мСоставыГруппДоступностиСкладов = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ГруппаДоступностиСкладов) Тогда
		Возврат Справочники.СкладыКомпании.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(ГруппаДоступностиСкладов) = Тип("СправочникСсылка.СкладыКомпании") Тогда
		Возврат ГруппаДоступностиСкладов;
	КонецЕсли;
	
	Если ТипЗнч(мСоставыГруппДоступностиСкладов) <> Тип("Соответствие") Тогда
		мСоставыГруппДоступностиСкладов = Новый Соответствие;
	КонецЕсли;
	
	СписокСкладов = мСоставыГруппДоступностиСкладов.Получить(ГруппаДоступностиСкладов);
	
	Если СписокСкладов <> Неопределено Тогда
		Возврат СписокСкладов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппаДоступностиСкладов", ГруппаДоступностиСкладов);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставГруппДоступностиСкладов.Склад
	|ИЗ
	|	РегистрСведений.Renault_СоставГруппДоступностиСкладов КАК СоставГруппДоступностиСкладов
	|ГДЕ
	|	СоставГруппДоступностиСкладов.ГруппаДоступности = &ГруппаДоступностиСкладов";
	
	СписокСкладов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");
	
	мСоставыГруппДоступностиСкладов.Вставить(ГруппаДоступностиСкладов, СписокСкладов);
	
	Возврат СписокСкладов;
	
КонецФункции // ПолучитьСкладыИзГруппы()

Процедура ЗаполнитьРеквизитыПоУмолчанию(ЗаказНаряд) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияРеквизитовЗаказНарядовПоУмолчанию.*
	|ИЗ
	|	РегистрСведений.Renault_Advanced_ЗначенияРеквизитовЗаказНарядовПоУмолчанию КАК ЗначенияРеквизитовЗаказНарядовПоУмолчанию
	|ГДЕ
	|	(ЗначенияРеквизитовЗаказНарядовПоУмолчанию.Пользователь = &Пользователь
	|			ИЛИ ЗначенияРеквизитовЗаказНарядовПоУмолчанию.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗначенияРеквизитовЗаказНарядовПоУмолчанию.Пользователь УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		МетаданныеРегистра = Метаданные.РегистрыСведений.Renault_Advanced_ЗначенияРеквизитовЗаказНарядовПоУмолчанию;
		
		Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
			Попытка
				Если Не ЗначениеЗаполнено(ЗаказНаряд[Ресурс.Имя]) Тогда ЗаказНаряд[Ресурс.Имя] = Выборка[Ресурс.Имя]; КонецЕсли;
			Исключение
				Если Не ЗначениеЗаполнено(ЗаказНаряд["DMS_"+Ресурс.Имя]) Тогда ЗаказНаряд["DMS_"+Ресурс.Имя] = Выборка[Ресурс.Имя]; КонецЕсли;
			КонецПопытки;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСсылкуНаСчетНаОплату(ЗаказПокупателя) Экспорт
	
	СчетНаОплатуПокупателю = Неопределено;
	
	// Если заказ покупателя по каким-либо причинам не создан, то счет найти мы не сможем - выходим
	Если НЕ ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетНаОплату КАК СчетНаОплатуПокупателю
	|ГДЕ
	|	СчетНаОплатуПокупателю.ДокументОснование = &ЗаказПокупателя";

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СчетНаОплатуПокупателю = Выборка.Ссылка;
	КонецЕсли;

	Возврат СчетНаОплатуПокупателю;
	
КонецФункции // ПолучитьСсылкуНаСчетНаОплату()

Функция СформироватьТабличнуюЧастьУслуг(ЗаказНаряд, ТолькоУслуги = Ложь, ДляРеализации = Ложь)
	
	Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("Ссылка", ЗаказНаряд);
	Запрос.УстановитьПараметр("Автоуслуга", ЗаказНаряд.DMS_Автоуслуга);
	
	Запрос.УстановитьПараметр("ДляРелизации", ДляРеализации);
	
	//Если Модифицированность() Тогда
		Запрос.УстановитьПараметр("Запчасти", ЗаказНаряд.Товары.Выгрузить());
		Запрос.УстановитьПараметр("Работы", ЗаказНаряд.Работы.Выгрузить());
	//КонецЕсли;
	
	Запрос.УстановитьПараметр("АвтоУслугаЗапчастей", ЗаказНаряд.DMS_АвтоУслугаЗапчастей);
	Запрос.Текст =
	"ВЫБРАТЬ
	//|	ВЫБОР КОГДА &ДляРелизации = ИСТИНА И &АвтоУслугаЗапчастей <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА &АвтоУслугаЗапчастей ИНАЧЕ &Автоуслуга КОНЕЦ КАК Номенклатура,
	|   &Автоуслуга КАК Номенклатура,
	|	ЗаказНарядЗапчасти.Цена * ЗаказНарядЗапчасти.Количество КАК СуммаБезСкидок,
	|	ЗаказНарядЗапчасти.Сумма,
	|	ВЫБОР КОГДА ЗаказНарядЗапчасти.СтавкаНДС = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка) ТОГДА ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС) ИНАЧЕ ЗаказНарядЗапчасти.СтавкаНДС КОНЕЦ КАК СтавкаНДС,
	|	ЗаказНарядЗапчасти.СуммаНДС
	|ПОМЕСТИТЬ Запчасти
	|ИЗ
	|	&Запчасти КАК ЗаказНарядЗапчасти
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНарядРаботы.Работа КАК Номенклатура,
	|	ЗаказНарядРаботы.Цена * ЗаказНарядРаботы.Количество КАК СуммаБезСкидок,
	|	ЗаказНарядРаботы.Сумма,
	|	ВЫБОР КОГДА ЗаказНарядРаботы.СтавкаНДС = ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка) ТОГДА ЗНАЧЕНИЕ(Справочник.СтавкиНДС.БезНДС) ИНАЧЕ ЗаказНарядРаботы.СтавкаНДС КОНЕЦ КАК СтавкаНДС,
	|	ЗаказНарядРаботы.СуммаНДС
	|ПОМЕСТИТЬ Работы
	|ИЗ
	|	&Работы КАК ЗаказНарядРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабличныеЧасти.Номенклатура,
	|	СУММА(ТабличныеЧасти.СуммаБезСкидок) КАК Цена,
	|	СУММА(ТабличныеЧасти.Сумма) КАК Сумма,
	|	ТабличныеЧасти.СтавкаНДС КАК СтавкаНДС, 
	|	СУММА(ТабличныеЧасти.СуммаНДС) КАК СуммаНДС,
	|	ВЫРАЗИТЬ(ВЫБОР КОГДА СУММА(ТабличныеЧасти.СуммаБезСкидок) = 0 ТОГДА 0 ИНАЧЕ (1 - СУММА(ТабличныеЧасти.Сумма) / СУММА(ТабличныеЧасти.СуммаБезСкидок)) * 100 КОНЕЦ КАК ЧИСЛО(5, 2)) КАК ПроцентСкидкиНаценки
	|ИЗ
	|	(" + ?(ТолькоУслуги, "", "ВЫБРАТЬ
	|		Запчасти.Номенклатура КАК Номенклатура,
	|		Запчасти.СуммаБезСкидок КАК СуммаБезСкидок,
	|		Запчасти.Сумма КАК Сумма,
	|		Запчасти.СтавкаНДС КАК СтавкаНДС,
	|		Запчасти.СуммаНДС КАК СуммаНДС
	|	ИЗ
	|		Запчасти КАК Запчасти
	|	
	|	ОБЪЕДИНИТЬ ВСЕ") + "
	|	
	|	ВЫБРАТЬ
	//|		ВЫБОР КОГДА &ДляРелизации = ИСТИНА И Работы.Номенклатура.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА Работы.Номенклатура.Номенклатура ИНАЧЕ &Автоуслуга КОНЕЦ КАК Номенклатура,
	|       &Автоуслуга КАК Номенклатура,
	|		Работы.СуммаБезСкидок,
	|		Работы.Сумма,
	|		Работы.СтавкаНДС,
	|		Работы.СуммаНДС
	|	ИЗ
	|		Работы КАК Работы) КАК ТабличныеЧасти
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабличныеЧасти.Номенклатура,
	|	ТабличныеЧасти.СтавкаНДС";
	Результат = Запрос.Выполнить();
	
	Возврат Результат;
	
КонецФункции // СформироватьТабличнуюЧастьУслуг()



