Процедура СМ_Ниссан_МониторЗаписи(Параметры=Неопределено) Экспорт
	
	Выборка = Справочники.СМ_Ниссан_Настройки.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ЭтоГруппа Тогда
		    Продолжить;
		КонецЕсли;
		
		Если Выборка.ПометкаУдаления Тогда
		    Продолжить;
 		КонецЕсли;
		
		АдресFTP = Выборка.АдресСервера;		
 		Если ПустаяСтрока(АдресFTP) Тогда
			Продолжить;		
		КонецЕсли;
		
		КодДилера = Выборка.КодДилера;
 		Если ПустаяСтрока(КодДилера) Тогда
			Продолжить;		
		КонецЕсли;
 		
		ГруппаПодразделений = Выборка.ГруппаПодразделений;
		Если обЗначениеНеЗаполнено(ГруппаПодразделений) Тогда
			Продолжить;		
		КонецЕсли;	
		
		Для Счетчик = 1  По 2 Цикл
			
 			СписокСотрудников = Новый СписокЗначений;
 			СписокСотрудников = ЗаполнитьРегистрСведенийСМНиссанСотрудники(Счетчик);		
			ОтправитьСжатыеФотоНаСерверFTP(СписокСотрудников,АдресFTP);
 			
			ФайлXML = ПолучитьИмяВременногоФайла("XML");
			
			СформироватьФайлXML(ФайлXML,ГруппаПодразделений,КодДилера,АдресFTP,Счетчик);
			
			Если НЕ обЗначениеНеЗаполнено(ФайлXML) Тогда
				
				ИмяПользователя = "dmsdataprovider";
				ПарольПользователя = "F3tpzJVybp";
				
				Соединение = ПодключитьсяКFTPСерверу(АдресFTP,ИмяПользователя,ПарольПользователя);
				
				Если Счетчик = 1 Тогда
					Соединение.Записать(ФайлXML, "/service_meetings.xml");
 				Иначе
					Соединение.Записать(ФайлXML, "/other_meetings.xml");
				КонецЕсли;
				
 			КонецЕсли; 
			
			ФайлДляУдаления = Новый Файл(ФайлXML);
			
			Если ФайлДляУдаления.Существует() Тогда
				
				Попытка
					УдалитьФайлы(ФайлДляУдаления.Путь,ФайлДляУдаления.Имя);                                                         
				Исключение
				КонецПопытки;
				
			КонецЕсли;
		КонецЦикла;

 		
	КонецЦикла;   
	
КонецПроцедуры 
     
Процедура СформироватьФайлXML(ФайлXML,ГруппаПодразделений,КодДилера,АдресFTP,Счетчик) Экспорт 
   	
	ТЗ = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
	
	Если Счетчик = 1 Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаРемонтПланирование.Ссылка,
		|	ЗаявкаНаРемонтПланирование.Авторабота,
		|	ЗаявкаНаРемонтПланирование.НачалоВыполнения КАК НачалоВыполнения,
		|	ЗаявкаНаРемонтПланирование.Ссылка.Диспетчер,
		|	ЗаявкаНаРемонтПланирование.Ссылка.Заказчик,
		|	ЗаявкаНаРемонтПланирование.Ссылка.Автомобиль КАК Автомобиль,
		|	ЗаявкаНаРемонтПланирование.Ссылка.ПредставлениеТелефона,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаРемонтПланирование.Ссылка.Автомобиль) = ТИП(Справочник.Модели)
		|			ТОГДА ЗаявкаНаРемонтПланирование.Ссылка.Автомобиль.Наименование
		|		ИНАЧЕ ЗаявкаНаРемонтПланирование.Ссылка.Автомобиль.Модель.Наименование
		|	КОНЕЦ КАК МодельАвто,
		|	ХарактеристикиАвто.Значение КАК ГосНомер,
		|	ВЫРАЗИТЬ(ЗаявкаНаРемонтПланирование.Авторабота.НаименованиеПолное КАК СТРОКА(100)) КАК НаименованиеРаботы,
		|	ЗаявкаНаРемонтПланирование.Ссылка.Диспетчер.Фамилия КАК ДиспетчерФамилия,
		|	ЗаявкаНаРемонтПланирование.Ссылка.Диспетчер.Имя КАК ДиспетчерИмя,
		|	РегистрКодовСотрудников.КодСотрудника
		|ИЗ
		|	Документ.ЗаявкаНаРемонт.Планирование КАК ЗаявкаНаРемонтПланирование
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
		|			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
		|			АвтомобилиСрезПоследних.Значение КАК Значение
		|		ИЗ
		|			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|		ГДЕ
		|			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК ХарактеристикиАвто
		|		ПО ЗаявкаНаРемонтПланирование.Ссылка.Автомобиль = ХарактеристикиАвто.Автомобиль
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СМ_Ниссан_Сотрудники.Сотрудник КАК Сотрудник,
		|			СМ_Ниссан_Сотрудники.КодСотрудника КАК КодСотрудника
		|		ИЗ
		|			РегистрСведений.СМ_Ниссан_Сотрудники КАК СМ_Ниссан_Сотрудники) КАК РегистрКодовСотрудников
		|		ПО ЗаявкаНаРемонтПланирование.Ссылка.Диспетчер = РегистрКодовСотрудников.Сотрудник
		|ГДЕ
		|	ЗаявкаНаРемонтПланирование.НачалоВыполнения МЕЖДУ &ДатаВремяНачала И &ДатаВремяОкончания
		|	И ЗаявкаНаРемонтПланирование.РабочееМесто.Подразделение В ИЕРАРХИИ(&ГруппаПодразделений)
		|	И (ЗаявкаНаРемонтПланирование.Авторабота.НаименованиеПолное ПОДОБНО &Приемка
		|			ИЛИ ЗаявкаНаРемонтПланирование.Авторабота.НаименованиеПолное ПОДОБНО &Выдача)
		|	И ЗаявкаНаРемонтПланирование.Ссылка.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделений)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачалоВыполнения";
		
		Запрос.УстановитьПараметр("Приемка","%приемка%");  
		Запрос.УстановитьПараметр("Выдача","%выдача%"); 
		
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Событие.Ссылка,
		|	Событие.ВидСобытия КАК Авторабота,
		|	Событие.ДатаНачала КАК НачалоВыполнения,
		|	Событие.Продавец КАК Диспетчер,
		|	Событие.Контрагент КАК Заказчик,
		|	РабочиеЛисты.Автомобиль КАК Автомобиль,
		|	Событие.ПредставлениеТелефона,
		|	РабочиеЛисты.МодельНаименование КАК МодельАвто,
		|	ХарактеристикиАвто.ГосНомер КАК ГосНомер,
		|	Событие.ВидСобытия КАК НаименованиеРаботы,
		|	Событие.Продавец.Фамилия КАК ДиспетчерФамилия,
		|	Событие.Продавец.Имя КАК ДиспетчерИмя,
		|	СМ_Ниссан_Сотрудники.КодСотрудника КАК КодСотрудника
		|ИЗ
		|	Документ.Событие КАК Событие
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			РабочийЛист.Ссылка КАК Ссылка,
		|			РабочийЛист.Модель КАК Модель,
		|			РабочийЛист.Модель.Наименование КАК МодельНаименование,
		|			РабочийЛист.Автомобиль КАК Автомобиль
		|		ИЗ
		|			Документ.РабочийЛист КАК РабочийЛист) КАК РабочиеЛисты
		|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
		|				АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
		|				АвтомобилиСрезПоследних.Значение КАК ГосНомер
		|			ИЗ
		|				РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|			ГДЕ
		|				АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК ХарактеристикиАвто
		|			ПО РабочиеЛисты.Автомобиль = ХарактеристикиАвто.Автомобиль
		|		ПО Событие.ДокументОснование = РабочиеЛисты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СМ_Ниссан_Сотрудники.Сотрудник КАК Сотрудник,
		|			СМ_Ниссан_Сотрудники.КодСотрудника КАК КодСотрудника
		|		ИЗ
		|			РегистрСведений.СМ_Ниссан_Сотрудники КАК СМ_Ниссан_Сотрудники) КАК СМ_Ниссан_Сотрудники
		|		ПО Событие.Продавец = СМ_Ниссан_Сотрудники.Сотрудник
		|ГДЕ
		|	Событие.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделений)
		|	И Событие.ДатаНачала МЕЖДУ &ДатаВремяНачала И &ДатаВремяОкончания
		|	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)
		|	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ГруппаПодразделений",ГруппаПодразделений); //	
	Запрос.УстановитьПараметр("ДатаВремяНачала",НачалоДня(ТекущаяДата()));
	//Запрос.УстановитьПараметр("ДатаВремяНачала",ДобавитьМесяц(НачалоДня(ТекущаяДата()),-1));
	Запрос.УстановитьПараметр ("ДатаВремяОкончания",КонецДня(ТекущаяДата()));
	
	ТЗ = Запрос.Выполнить().Выгрузить(); 
	
  	ИмяБазы = "alfaauto";
	Попытка
		Результат = Renault_внОбщийМодуль.ПараметрУникальностиИБ();
 		ИмяБазы = СокрЛП(Результат.ИмяБазы);
	Исключение
		//	
	КонецПопытки; 
	
	ДатаТек    = Строка(Формат(ТекущаяДата(),"ДФ=yyyy-MM-dd"));
	ВремяТек   = Строка(Формат(ТекущаяДата(),"ДЛФ=T"));	
 	ЧасыРаботы = "Часы работы: 08:00 - 19:00";
 	
  	XML=Новый ЗаписьXML();
	
	XML.ОткрытьФайл(ФайлXML);
	
	//XML.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8","1.0",false));
	   	
 	XML.ЗаписатьОбъявлениеXML();
	
  	XML.ЗаписатьНачалоЭлемента("АFTERSALES_DMS");
	
		XML.ЗаписатьНачалоЭлемента("EXTRACTION");
	
			XML.ЗаписатьНачалоЭлемента("EXTRACTION_DATE");            XML.ЗаписатьТекст(ДатаТек);     XML.ЗаписатьКонецЭлемента();
			XML.ЗаписатьНачалоЭлемента("EXTRACTION_TIME");            XML.ЗаписатьТекст(ВремяТек);    XML.ЗаписатьКонецЭлемента();
			XML.ЗаписатьНачалоЭлемента("EXTRACTION_DEALERSHIP_CODE"); XML.ЗаписатьТекст(КодДилера);   XML.ЗаписатьКонецЭлемента();
			XML.ЗаписатьНачалоЭлемента("SCROLLING_BANNER_MESSAGE");   XML.ЗаписатьТекст(ЧасыРаботы);  XML.ЗаписатьКонецЭлемента();
	
		XML.ЗаписатьКонецЭлемента(); //EXTRACTION	
	
		XML.ЗаписатьНачалоЭлемента("MEETINGS");
		
			Для каждого Стр1 Из ТЗ Цикл
				
				ДатаНачала     = Строка(Формат(Стр1.НачалоВыполнения,"ДФ=yyyy-MM-dd"));
				ВремяНачала    = Строка(Формат(Стр1.НачалоВыполнения,"ДЛФ=T"));
				
				Если Счетчик = 1 Тогда
					КлиентСтрокой = СокрЛП(Стр1.МодельАвто)+" | "+СокрЛП(Стр1.ГосНомер);
 					Если Найти(ВРЕГ(Стр1.НаименованиеРаботы),"ВЫДАЧА") > 0 Тогда
						КлиентСтрокой = СокрЛП(КлиентСтрокой) + " | "+"ВЫДАЧА";
					Иначе	
						КлиентСтрокой = СокрЛП(КлиентСтрокой) + " | "+"ЗАЕЗД";	 				
					КонецЕсли;
				Иначе
					КлиентСтрокой = СокрЛП(Стр1.МодельАвто)+" "+СокрЛП(Стр1.ГосНомер);
					КлиентСтрокой = СокрЛП(КлиентСтрокой) + " | "+СокрЛП(Стр1.НаименованиеРаботы)+" "+СокрЛП(Стр1.Заказчик);
				КонецЕсли;
 				
				Если НЕ обЗначениеНеЗаполнено(Стр1.ДиспетчерФамилия) И НЕ обЗначениеНеЗаполнено(Стр1.ДиспетчерИмя) Тогда
					ДиспетчерСтрокой = СокрЛП(Стр1.ДиспетчерФамилия)+" "+СокрЛП(Стр1.ДиспетчерИмя);
				Иначе	
					ДиспетчерСтрокой = СокрЛП(Стр1.Диспетчер);					
				КонецЕсли;  
				
				ДиспетчерКод = СокрЛП(Стр1.КодСотрудника);
				
				XML.ЗаписатьНачалоЭлемента("MEETING");
				
				XML.ЗаписатьНачалоЭлемента("DEPOSIT_DATE");  XML.ЗаписатьТекст(ДатаНачала);       XML.ЗаписатьКонецЭлемента();
				XML.ЗаписатьНачалоЭлемента("DEPOSIT_TIME");  XML.ЗаписатьТекст(ВремяНачала);      XML.ЗаписатьКонецЭлемента();
				XML.ЗаписатьНачалоЭлемента("CUSTOMER_NAME"); XML.ЗаписатьТекст(КлиентСтрокой);    XML.ЗаписатьКонецЭлемента();
				XML.ЗаписатьНачалоЭлемента("ADVISOR_CODE");  XML.ЗаписатьТекст(ДиспетчерКод);     XML.ЗаписатьКонецЭлемента();
				XML.ЗаписатьНачалоЭлемента("ADVISOR_NAME");  XML.ЗаписатьТекст(ДиспетчерСтрокой); XML.ЗаписатьКонецЭлемента();
				
				XML.ЗаписатьКонецЭлемента(); //MITING
				
			КонецЦикла; 
		
		XML.ЗаписатьКонецЭлемента();	 //MITINGS
		
	XML.ЗаписатьКонецЭлемента();     //АFTERSALES_DMS	

	XML.Закрыть(); 
   
КонецПроцедуры // СформироватьФайлXML(ФайлXML,ГруппаПодразделений,КодДилера) )

Функция ПодключитьсяКFTPСерверу(АдресFTP,ИмяПользователя,ПарольПользователя) Экспорт
	Соединение = Новый FTPСоединение(
        АдресFTP, // адрес ftp сервера
        21, // порт сервера
        ИмяПользователя, // имя пользователя
        ПарольПользователя, // пароль пользователя
        Неопределено, // прокси не используется
        Истина, // пассивный режим работы
        0, // таймаут (0 - без ограничений)
        Неопределено // незащищенное соединение
    );
 
    // Для случаев, когда у ftp сервера нет возможности
    // обращаться к нам (мы находимся за межсетевым экраном)
    // следует использовать пассивный режим работы.
 
    Возврат Соединение;
КонецФункции
  
Функция ЗаполнитьРегистрСведенийСМНиссанСотрудники(Счетчик) Экспорт
	
	СписокСотрудниковТек = Новый СписокЗначений;
	
 	Запрос = Новый Запрос;
	
	Если Счетчик = 1 Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаНаРемонтПланирование.Ссылка.Диспетчер КАК Диспетчер
		|ИЗ
		|	Документ.ЗаявкаНаРемонт.Планирование КАК ЗаявкаНаРемонтПланирование
		|ГДЕ
		|	(ЗаявкаНаРемонтПланирование.Авторабота.НаименованиеПолное ПОДОБНО &Приемка
		|			ИЛИ ЗаявкаНаРемонтПланирование.Авторабота.НаименованиеПолное ПОДОБНО &Выдача)
		|	И ЗаявкаНаРемонтПланирование.Ссылка.Дата >= &ДатаНачала";
 		Запрос.УстановитьПараметр("Приемка","%приемка%");  
		Запрос.УстановитьПараметр("Выдача","%выдача%");
 	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Событие.Продавец КАК Диспетчер
		|ИЗ
		|	Документ.Событие КАК Событие
		|ГДЕ
		|	Событие.Проведен = ИСТИНА
		|	И Событие.ДатаНачала >= &ДатаНачала
		|	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)
		|	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)";
	КонецЕсли;
 	Запрос.УстановитьПараметр("ДатаНачала",НачалоДня(ТекущаяДата()));		
       	
	СписокСотрудниковТек.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Диспетчер")); 
	
	НаборЗаписей = РегистрыСведений.СМ_Ниссан_Сотрудники.СоздатьНаборЗаписей();
	
	Для каждого ТекЭл Из СписокСотрудниковТек Цикл
		
		Если обЗначениеНеЗаполнено(ТекЭл.Значение) Тогда
			Продолжить;		
 		КонецЕсли; 		
		
 		НаборЗаписей.Отбор.Сотрудник.Установить(ТекЭл.Значение);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			НовЗапись = РегистрыСведений.СМ_Ниссан_Сотрудники.СоздатьМенеджерЗаписи();		
			НовЗапись.Сотрудник = ТекЭл.Значение;
			НовыйКодСотрудника = НайтиМаксимальныйКодСотрудника()+1;
			НовЗапись.КодСотрудника = ДополнитьСтрокуЛ(СтрЗаменить(НовыйКодСотрудника,Символы.НПП,""), 4, "0"); 
			НовЗапись.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокСотрудниковТек;
  
КонецФункции

Функция НайтиМаксимальныйКодСотрудника() Экспорт
	
	КодСотрудника = Число("0");	
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СМ_Ниссан_Сотрудники.КодСотрудника КАК КодСотрудника
		|ИЗ
		|	РегистрСведений.СМ_Ниссан_Сотрудники КАК СМ_Ниссан_Сотрудники
		|
		|УПОРЯДОЧИТЬ ПО
		|	КодСотрудника УБЫВ";
	
	ТабЗн = Запрос.Выполнить().Выгрузить();
 	 
 	Если ТабЗН.Количество() >  0 Тогда
		КодСотрудника = Число(ТабЗН[0].КодСотрудника);
 	КонецЕсли;

	Возврат КодСотрудника;

КонецФункции // НайтиМаксимальныйКодСотрудника()

// Функция дополняет строку слева до указаной длины определенным символом
//
// Параметры:
//	Стр		- Строка	- Строка
//	Длина	- Число		- Длина строки
//	Чем		- Строка	- Символ для добавления
//
// Возвращаемое значение:
//	Строка	- Строка, дополненная слева до указанной длины
//
Функция ДополнитьСтрокуЛ(Знач Стр, Длина, Чем = " ") Экспорт
	
	СимволовДополнить = Длина - СтрДлина(Стр);
	
	Добавок = "";
	
	Для Н = 1 По СимволовДополнить Цикл
		Добавок = Добавок + Чем;
	КонецЦикла;
	
	Возврат Добавок + Стр;

КонецФункции

