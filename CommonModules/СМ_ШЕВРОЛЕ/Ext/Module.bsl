Процедура ИнтерактивнаяПроверкаСВыгрузкой(Ссылка) Экспорт                      
	
	СзВидовРемонтаДляВыгрузкиПоШевроле = Новый СписокЗначений;
	
	СзВидовРемонтаДляВыгрузкиПоШевроле.Добавить(Справочники.ВидыРемонта.ГарантияПроизводителя);
	СзВидовРемонтаДляВыгрузкиПоШевроле.Добавить(Справочники.ВидыРемонта.КоммерческийРемонт);
	СзВидовРемонтаДляВыгрузкиПоШевроле.Добавить(Справочники.ВидыРемонта.ТехническоеОбслуживание);
	//Бондаренко++ 20220606
	СзВидовРемонтаДляВыгрузкиПоШевроле.Добавить(Справочники.ВидыРемонта.ТехническоеОбслуживаниеБесплатное);	
	//Бондаренко-- 20220606
 	СзВидовРемонтаДляВыгрузкиПоШевроле.Добавить(Справочники.ВидыРемонта.ДополнительноеОборудование);
	СзВидовРемонтаДляВыгрузкиПоШевроле.Добавить(Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером);
   	
	Если Ссылка.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000231") ИЛИ
		 Ссылка.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001330")  ИЛИ
		 Ссылка.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000126")  Тогда
		Если ( (Ссылка.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен) И (Ссылка.ВидРемонта = Ссылка.ВидРемонта = Справочники.ВидыРемонта.ГарантияПроизводителя) ) ИЛИ 
			 ( (Ссылка.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт)   И (СзВидовРемонтаДляВыгрузкиПоШевроле.НайтиПоЗначению(Ссылка.ВидРемонта)<>Неопределено) ) Тогда
			 Если Ссылка.Автомобиль.ГодВыпуска >= Дата(2020,1,1) Тогда
 				СМ_ШЕВРОЛЕ_Сервер.ВыгрузитьЗНпоШевроле(Ссылка);					                                            
				Сообщить("Завершена выгрузка на портал CHEVROLET",СтатусСообщения.Информация);
			Иначе
				Сообщить("Дата выпуска авто в документе '"+СокрЛП(Ссылка.Автомобиль.ГодВыпуска)+"' не соответствует критериям выгрузки на портал. Должна быть больше (или равна) 1 января 2020.",СтатусСообщения.ОченьВажное);							 		
			КонецЕсли;
		Иначе
			Сообщить("Вид ремонта документа '"+СокрЛП(Ссылка.ВидРемонта)+"'и состояние документа '"+СокрЛП(Ссылка.Состояние)+"' не соответствуют критериям выгрузки на портал. Должен быть 'Коммерческий ремонт','Техническое обслуживание' или 'Гарантия производителя'",СтатусСообщения.ОченьВажное);							 	
		КонецЕсли;	                                                   
	Иначе
		Сообщить("Подразделение документа '"+СокрЛП(Ссылка.Организация)+"' не соответствует критериям выгрузки на портал. Должно быть 'Престиж Моторс ООО Пойменная', 'Престиж Моторс ООО Волгодонск Лада' или 'Престиж Моторс ООО Олимп'",СтатусСообщения.ОченьВажное);						
	КонецЕсли;	
  	
КонецПроцедуры // ИнтерактивнаяПроверкаСВыгрузкой(Ссылка)
