	Исключение
		#Если Клиент Тогда
		Сообщить("Ошибка при сохранении книги " + ИмяФайла + ":" + Символы.ПС + ОписаниеОшибки());
        #Иначе 
        ЗаписьЖурналаРегистрации("ВыгрузкаSmartTools.СохранениеExcel", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при сохранении книги: " + ОписаниеОшибки()); 
        #КонецЕсли
		Excel.Quit();
		Возврат Ложь; 
	КонецПопытки;
	
	Excel.Quit();	
	Возврат Истина;
КонецФункции

Функция СформироватьФайлАксессуаров(ИмяФайла, ГруппаПодразделений)
	ГруппаПодразделений = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001160"); // группа Олимп!!!
	ЗапросСклад = Новый Запрос();
	ЗапросСклад.УстановитьПараметр("ГруппаПодразделений", ГруппаПодразделений);
	ЗапросСклад.УстановитьПараметр("ГруппаНиссанДО", Справочники.Номенклатура.НайтиПоКоду("ЦБ269653"));
	ЗапросСклад.УстановитьПараметр("ГруппаНиссан", Справочники.Производители.Nissan);
	ЗапросСклад.УстановитьПараметр("ЦеныПродажи", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	ЗапросСклад.Текст = "ВЫБРАТЬ
	                    |	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул КАК Артикул,
	                    |	ОстаткиТоваровКомпанииОстатки.Номенклатура.Наименование КАК Наименование,
	                    |	ОстаткиТоваровКомпанииОстатки.Номенклатура.ГруппаАксессуаров.ОбозначениеГруппы КАК Категория,
	                    |	ЦеныСрезПоследних.Цена,
	                    |	ОстаткиТоваровКомпанииОстатки.Номенклатура.ЦенаУстановки КАК ЦенаУстановки,
	                    |	ОстаткиТоваровКомпанииОстатки.Номенклатура.ГруппаАксессуаров.ПриоритетВыдачи КАК ПриоритетВыдачи
	                    |ИЗ
	                    |	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
	                    |			,
	                    |			СкладКомпании.Подразделение В ИЕРАРХИИ (&ГруппаПодразделений)
	                    |				И Номенклатура В ИЕРАРХИИ (&ГруппаНиссанДО)
	                    |				И Номенклатура.Производитель В ИЕРАРХИИ (&ГруппаНиссан)) КАК ОстаткиТоваровКомпанииОстатки
	                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(
	                    |				,
	                    |				ТипЦен = &ЦеныПродажи
	                    |					И ПодразделениеКомпании В ИЕРАРХИИ (&ГруппаПодразделений)
	                    |					И Номенклатура В ИЕРАРХИИ (&ГруппаНиссанДО)
	                    |					И Номенклатура.Производитель В ИЕРАРХИИ (&ГруппаНиссан)) КАК ЦеныСрезПоследних
	                    |		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = ЦеныСрезПоследних.Номенклатура";
		
	Excel = Неопределено;
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
	Исключение
		#Если Клиент Тогда
		Сообщить("Ошибка запуска MS Excel:" + Символы.ПС + ОписаниеОшибки());
        #Иначе 
        ЗаписьЖурналаРегистрации("ВыгрузкаSmartTools.ЗапускExcel", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка запуска MS Excel: " + ОписаниеОшибки()); 
        #КонецЕсли
		Возврат Ложь;
	КонецПопытки;
	WorkBook = Excel.Workbooks.Add();
	WorkSheet = WorkBook.WorkSheets.Item(1);
	
	
	Остатки = ЗапросСклад.Выполнить().Выгрузить();
	// 1-я сторока - Заголовок
	WorkSheet.Cells(1, 1).Value = "Серийный номер*";
	WorkSheet.Cells(1, 2).Value = "Наименование*";
	WorkSheet.Cells(1, 3).Value = "Код модели";
	WorkSheet.Cells(1, 4).Value = "Категория*";
	WorkSheet.Cells(1, 5).Value = "Код комплектации";
	WorkSheet.Cells(1, 6).Value = "Цена (руб.)*";
	WorkSheet.Cells(1, 7).Value = "Цена установки (руб.)*";
	WorkSheet.Cells(1, 8).Value = "nofit";
	WorkSheet.Cells(1, 9).Value = "extrafit";
	WorkSheet.Cells(1, 10).Value = "optionfit";	
	WorkSheet.Cells(1, 11).Value = "Приоритет";
	WorkSheet.Cells(1, 12).Value = "Изображение";
	нстр = 2; сч = 1;
	Для Каждого СтрокаДанные Из Остатки Цикл
		Если ТолькоЦифровойАртикул(СтрокаДанные.Артикул) Тогда
			Продолжить;
		КонецЕсли;
		
		//Worksheet.Cells(нстр, 1).NumberFormat = "@";
		WorkSheet.Cells(нстр, 1).Value = СтрокаДанные.Артикул;
		WorkSheet.Cells(нстр, 2).Value = СтрокаДанные.Наименование;
		//WorkSheet.Cells(нстр, 3).Value = СтрокаДанные.ДатаНачалаГарантии;
		WorkSheet.Cells(нстр, 4).Value = СтрокаДанные.Категория;
		//WorkSheet.Cells(нстр, 5).Value = СтрокаДанные.ДатаТО;
		WorkSheet.Cells(нстр, 6).Value = СтрокаДанные.Цена;
		WorkSheet.Cells(нстр, 7).Value = СтрокаДанные.ЦенаУстановки;
		//WorkSheet.Cells(нстр, 8).Value = СтрокаДанные.ТелефонКлиента;
		//WorkSheet.Cells(нстр, 9).Value = СтрокаДанные.ТелефонКлиента;
		//WorkSheet.Cells(нстр, 10).Value = СтрокаДанные.ТелефонКлиента;	
		WorkSheet.Cells(нстр, 11).Value = СтрокаДанные.ПриоритетВыдачи;
		//WorkSheet.Cells(нстр, 12).Value = СтрокаДанные.ВИН;

		нстр  = нстр + 1;
	КонецЦикла;
	
	xlExcel8 = 56;
	Попытка
		WorkBook.SaveAs(ИмяФайла, xlExcel8);
	Исключение
		#Если Клиент Тогда
		Сообщить("Ошибка при сохранении книги " + ИмяФайла + ":" + Символы.ПС + ОписаниеОшибки());
        #Иначе 
        ЗаписьЖурналаРегистрации("ВыгрузкаSmartTools.СохранениеExcel", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка при сохранении книги: " + ОписаниеОшибки()); 
        #КонецЕсли
		Excel.Quit();
		Возврат Ложь; 
	КонецПопытки;
	
	Excel.Quit();	
	Возврат Истина;
КонецФункции

Функция ТолькоЦифровойАртикул(Артикул)
	Длина = СтрДлина(Артикул);
	Если Длина < 7 Или Длина > 16 Тогда
		Возврат Истина; // арткул не относится к товарам Ниссан
	КонецЕсли;
	// усеченный вариант "0123456789ABCDEFGHJKLMNPRSTUVWXYZ"
	Артикул = ВРег(Артикул);
	Для сч = 1 По Длина Цикл
		Если Найти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сред(Артикул, сч, 1)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
		
	Возврат Истина;
КонецФункции