Функция ПреобразоватьСтрокаВУИ(УИ) Экспорт 
		Первый = Лев(УИ,8);
	Пятый = Прав(УИ,12);
	
	УИ = СтрЗаменить(УИ,Первый,"");
	УИ = СтрЗаменить(УИ,Пятый,"");
	
	Второй = Лев(УИ,4);
	Четвертый = Прав(УИ,4);
	
	УИ = СтрЗаменить(УИ,Второй,"");
	УИ = СтрЗаменить(УИ,Четвертый,"");
	
	Третий = 	УИ;
	Возврат Первый+"-"+Второй+"-"+Третий+"-"+Четвертый+"-"+Пятый;	
