Функция ПолучитьVIN (стр,Разделитель = " ")    Экспорт 
	МассивСтрок = Новый Массив();
	НазначениПалтежаБезРазделителей = СтрЗаменить(стр," ","");
	
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Прервать;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Прервать;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	Если Константы.ДилерскийЦентр.Получить() = Справочники.ДилерскиеЦентры.Дельта тогда
		Флаг = Ложь;
		Для Каждого стр из МассивСтрок цикл
			ВИН = ЛЕВ( стр	,3);
			//ВИН2 = ЛЕВ( стр	,4);
			
			//Решетка =  ЛЕВ( стр	,1);
			//АМ1 = ЛЕВ( стр	,3);
			//АМ2 =  ЛЕВ( стр	,3);
			//VIN = "";
			//ЕСли НРег(VIN)<> "vin" или   Решетка  <>"#"     тогда
			//	
			//	Продолжить;
			//КонецЕсли;	 
			Если Флаг тогда
				VIN = стр;
				Прервать;
			КонецЕсли;	
			ЕСЛИ  НРег(ВИН)= "vin" тогда
				ДлиннаVIN = СтрДлина(стр);
				VIN = Прав(стр,ДлиннаVIN-3);
				VIN=СтрЗаменить(VIN," ","");
				VIN=СтрЗаменить(VIN,",","");
				Если  НРег(VIN) = "vin" тогда
					Флаг = Истина;	
							Иначе
							Возврат VIn;

				КонецЕсли;
				Продолжить;
			Иначе
				Продолжить;
				
			КонецЕсли;	
			Возврат VIn;
		КонецЦикла;	
		
	ИначеЕсли     Константы.ДилерскийЦентр.Получить() = Справочники.ДилерскиеЦентры.Олимп тогда
		Для Каждого стр из МассивСтрок цикл
			ВИН = ЛЕВ( стр	,3);
			ВИН2 = ЛЕВ( стр	,4);
			
			Решетка =  ЛЕВ( стр	,1);
			АМ1 = ЛЕВ( стр	,3);
			АМ2 =  ЛЕВ( стр	,3);
			VIN = "";
			//ЕСли НРег(VIN)<> "vin" или   Решетка  <>"#"     тогда
			//	
			//	Продолжить;
			//КонецЕсли;	 
			ЕСЛИ  НРег(ВИН2)= "vin:" тогда
				ДлиннаVIN = СтрДлина(стр);
				VIN = Прав(стр,ДлиннаVIN-4);
				VIN=СтрЗаменить(VIN," ","");
				VIN=СтрЗаменить(VIN,",","");
				
			ИначеЕСЛИ  НРег(ВИН)= "vin" тогда
				ДлиннаVIN = СтрДлина(стр);
				VIN = Прав(стр,ДлиннаVIN-3);
				VIN=СтрЗаменить(VIN," ","");
				VIN=СтрЗаменить(VIN,",","");
			ИначеЕсли    Решетка  ="#" тогда
				ДлиннаVIN = СтрДлина(стр);
				VIN = Прав(стр,ДлиннаVIN-1);
				VIN=СтрЗаменить(VIN," ","");
				VIN=СтрЗаменить(VIN,",","");
				
			ИначеЕсли   АМ1  ="а/м" тогда
				ДлиннаVIN = СтрДлина(стр);
				VIN = Прав(стр,ДлиннаVIN-3);
				VIN=СтрЗаменить(VIN," ","");
				VIN=СтрЗаменить(VIN,",","");
				
				
				
			ИначеЕсли    АМ2  ="а\м:" тогда
				ДлиннаVIN = СтрДлина(стр);
				VIN = Прав(стр,ДлиннаVIN-3);
				VIN=СтрЗаменить(VIN," ","");
				VIN=СтрЗаменить(VIN,",","");
				
				
				
			ИначеЕсли VIN = "" тогда
				
				Продолжить;
				
			КонецЕсли;	
			
			Если VIN = "" тогда
				
				Продолжить;
				
			КонецЕсли;	
			Если VIN = "" или найти("0123456789",VIN)=0 тогда
				АМ1  ="а\м:"; 
				Поз = Найти(НРег(НазначениПалтежаБезРазделителей),АМ1);
				Если Поз>0 Тогда
					Vin =  Сред(НазначениПалтежаБезРазделителей,Поз+4);
					ДлиннаVIN = СтрДлина(VIN);
					VIN = Лев(VIN,7);
					Возврат VIn;
				КонецЕсли;	
				АМ1  ="а/м:"; 
				Поз = Найти(НРег(НазначениПалтежаБезРазделителей),АМ1);
				Если Поз>0 Тогда
					Vin =  Сред(НазначениПалтежаБезРазделителей,Поз+4);
					ДлиннаVIN = СтрДлина(VIN);
					VIN = Лев(VIN,7);
					Возврат VIn;
				КонецЕсли;	
			КонецЕсли;	
			
			Возврат VIn;
		КонецЦикла;	
		
		
	Иначе
		НазначениПалтежаБезРазделителей = СтрЗаменить(НазначениПалтежаБезРазделителей," ","");
		АМ1  ="а/м:"; 
		Поз = Найти(НРег(НазначениПалтежаБезРазделителей),АМ1);
		Если Поз>0 Тогда
			Vin =  Сред(НазначениПалтежаБезРазделителей,Поз+5);
			ДлиннаVIN = СтрДлина(VIN);
			VIN = Лев(VIN,7);
			Возврат VIn;
			
		КонецЕсли;
		АМ1  ="а/м:"; 
		Поз = Найти(НРег(НазначениПалтежаБезРазделителей),АМ1);
		Если Поз>0 Тогда
			Vin =  Сред(НазначениПалтежаБезРазделителей,Поз+5);
			ДлиннаVIN = СтрДлина(VIN);
			VIN = Лев(VIN,7);
			Возврат VIn;
			
		КонецЕсли;
		АМ1  ="а/м"; 
		Поз = Найти(НРег(НазначениПалтежаБезРазделителей),АМ1);
		Если Поз>0 Тогда
			Vin =  Сред(НазначениПалтежаБезРазделителей,Поз+4);
			ДлиннаVIN = СтрДлина(VIN);
			VIN = Лев(VIN,7);
			Возврат VIn;
			
		КонецЕсли;
		АМ1  ="а/м"; 
		Поз = Найти(НРег(НазначениПалтежаБезРазделителей),АМ1);
		Если Поз>0 Тогда
			Vin =  Сред(НазначениПалтежаБезРазделителей,Поз+4);
			ДлиннаVIN = СтрДлина(VIN);
			VIN = Лев(VIN,7);
			Возврат VIn;
			
		КонецЕсли;
		
		АМ1  ="vin"; 
		Поз = Найти(НРег(НазначениПалтежаБезРазделителей),АМ1);
		Если Поз>0 Тогда
			Vin =  Сред(НазначениПалтежаБезРазделителей,Поз+17);
			ДлиннаVIN = СтрДлина(VIN);
			VIN = Лев(VIN,8);
			Возврат VIn;
		КонецЕсли;	
		
		
		
		
	КонецЕсли;
	
	
	Возврат Неопределено;
	
	
КонецФункции	

Процедура ЗавершитьВыдачу(СотрудникАвторизирован)  Экспорт 
	// проверим наличие открытых интервалов
	ВыполяетсяАвторабота = Справочники.Автоработы.ПустаяСсылка();
	Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	
	
	//Если Автоработы.Найти(Справочники.Автоработы.ВыдачаЗЧ,"Авторабота")<>Неопределено  тогда
	ВыполяетсяАвторабота =  Справочники.Автоработы.ВыдачаЗЧ;
	//Запрос = НОвый Запрос;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РегистрацияВремениСотрудника.Период КАК Период,
	|	РегистрацияВремениСотрудника.Сотрудник КАК Сотрудник,
	|	РегистрацияВремениСотрудника.ВидОтметки КАК ВидОтметки,
	|	РегистрацияВремениСотрудника.КонецРаботы КАК КонецРаботы,
	|	РегистрацияВремениСотрудника.Продолжительность КАК Продолжительность,
	|	РАЗНОСТЬДАТ(РегистрацияВремениСотрудника.Период, &ТекДата, МИНУТА) / 60 КАК Часы,
	|	РегистрацияВремениСотрудника.Авторабота
	|ИЗ
	|	РегистрСведений.РегистрацияВремениРаботТехПроцесс КАК РегистрацияВремениСотрудника
	|ГДЕ
	|	РегистрацияВремениСотрудника.ВидОтметки = &Работа
	|	И РегистрацияВремениСотрудника.КонецРаботы = &ПустаяДата
	|	И РегистрацияВремениСотрудника.Продолжительность = 0
	|	И РегистрацияВремениСотрудника.КонецРаботы = &ПустаяДата
	|	И РегистрацияВремениСотрудника.Период МЕЖДУ &НАчПериода И &КонПериода
	|	И РегистрацияВремениСотрудника.ЗаказНаряд = &ЗаказНаряд
	|	И РегистрацияВремениСотрудника.Авторабота = &Авторабота";
	
	Запрос.УстановитьПараметр("ЗаказНаряд"  , СотрудникАвторизирован);
	Запрос.УстановитьПараметр("Авторабота"  ,ВыполяетсяАвторабота);
	
	Запрос.УстановитьПараметр("ТекДата"  , ТекущаяДата());
	Запрос.УстановитьПараметр("Работа"     , Справочники.ВидыОтметокВремени.Работа);
	Запрос.УстановитьПараметр("ПустаяДата" , Дата("00010101"));
	Запрос.УстановитьПараметр("НАчПериода"  , НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонПериода"  , КонецДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если Не РезультатЗапроса.Следующий() тогда
		//Предупреждение("Выдача не начаналась");
		Возврат
		
	КонецЕсли;	
	
	СтрокаЗапроса =  РезультатЗапроса;
	СтрокаЗапроса.Сбросить();
	Попытка
		ПОка СтрокаЗапроса.Следующий() цикл 
			
			
			МенеджерЗаписи = РегистрыСведений.РегистрацияВремениРаботТехПроцесс.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период    = СтрокаЗапроса.Период;
			МенеджерЗаписи.ЗаказНаряд = СотрудникАвторизирован;
			МенеджерЗаписи.Сотрудник = СтрокаЗапроса.Сотрудник;
			МенеджерЗаписи.Авторабота =  СтрокаЗапроса.Авторабота;
			
			МенеджерЗаписи.ВидОтметки= Справочники.ВидыОтметокВремени.Работа;
			
			МенеджерЗаписи.Продолжительность= СтрокаЗапроса.Часы;
			МенеджерЗаписи.КонецРаботы= ТекущаяДата();
			
			МенеджерЗаписи.Записать(Истина);
		КонецЦикла;
	Исключение
	КонецПопытки;
КонецПроцедуры

