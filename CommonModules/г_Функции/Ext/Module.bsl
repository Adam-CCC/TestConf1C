Функция ПроверитьВидАвтоДляУбыточныхОрганизаций(АвтомобильСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвтомобилиСрезПоследних.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|ГДЕ
		|	АвтомобилиСрезПоследних.Значение В(&СписокДляСрезаПоследних)
		|	И АвтомобилиСрезПоследних.Автомобиль = &Автомобиль
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Автомобили.Значение
		|ИЗ
		|	РегистрСведений.Автомобили КАК Автомобили
		|ГДЕ
		|	Автомобили.Значение В(&СписокДляВсегоРегистра)
		|	И Автомобили.Автомобиль = &Автомобиль";
	
	// авто никогда не должен был быть подменным и тестовым
	СписокДляВсегоРегистра = Новый СписокЗначений;
	СписокДляВсегоРегистра.Добавить(Перечисления.ВидАвтомобиля.ТестовыйАвтомобиль);
	СписокДляВсегоРегистра.Добавить(Перечисления.ВидАвтомобиля.ПодменныйАвтомобиль);
	
	// авто на данный момент не должен быть новым, паралленым импортом, корпоративной квотой 
	СписокДляСрезаПоследних = Новый СписокЗначений;
	СписокДляСрезаПоследних.Добавить(Перечисления.ВидАвтомобиля.Новый);
	СписокДляСрезаПоследних.Добавить(Перечисления.ВидАвтомобиля.ПараллельныйИмпорт);
	СписокДляСрезаПоследних.Добавить(Перечисления.ВидАвтомобиля.КорпоративнаяКвота);
	СписокДляСрезаПоследних.Добавить(Перечисления.ВидАвтомобиля.СобственныйПарк);
	
	Запрос.УстановитьПараметр("Автомобиль", АвтомобильСсылка);
	Запрос.УстановитьПараметр("СписокДляВсегоРегистра", СписокДляВсегоРегистра);
	Запрос.УстановитьПараметр("СписокДляСрезаПоследних", СписокДляСрезаПоследних);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Если РезультатЗапроса.Пустой() тогда
		Возврат Истина
	Иначе
		Возврат ложь;
	КонецЕсли;
	 
КонецФункции
