Функция ПолучитьВыполнениеПриемки (Документ) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РегистрацияВремениРаботТехПроцесс.Период,
	|	РегистрацияВремениРаботТехПроцесс.Сотрудник,
	|	РегистрацияВремениРаботТехПроцесс.ЗаказНаряд,
	|	РегистрацияВремениРаботТехПроцесс.Авторабота,
	|	РегистрацияВремениРаботТехПроцесс.ВидОтметки,
	|	РегистрацияВремениРаботТехПроцесс.КонецРаботы,
	|	РегистрацияВремениРаботТехПроцесс.Продолжительность,
	|	РегистрацияВремениРаботТехПроцесс.РабочееМесто
	|ИЗ
	|	РегистрСведений.РегистрацияВремениРаботТехПроцесс КАК РегистрацияВремениРаботТехПроцесс
	|ГДЕ
	|	РегистрацияВремениРаботТехПроцесс.ЗаказНаряд.Автомобиль = &Автомобиль
	|	И РегистрацияВремениРаботТехПроцесс.Авторабота = &Авторабота
	|	И РегистрацияВремениРаботТехПроцесс.Период МЕЖДУ &ДатаНачало И &ДатаОкончания";
	Запрос.УстановитьПараметр("Авторабота",Справочники.Автоработы.Приемка);				 
	Запрос.УстановитьПараметр("Автомобиль",Документ.Ссылка.Автомобиль);	
	Запрос.УстановитьПараметр("ДатаНачало",   НачалоДня(?(Документ.Ссылка.ДатаНачала='00010101',ТекущаяДата(),Документ.Ссылка.ДатаНачала)));	
	
	Запрос.УстановитьПараметр("ДатаОкончания",КонецДня(?(Документ.Ссылка.ДатаНачала='00010101',ТекущаяДата(),Документ.Ссылка.ДатаНачала)));	
	
	
	
	Результат = Запрос.Выполнить().Выбрать();
	Если  Результат.Следующий() тогда
		Возврат Истина;
	Иначе 
		Возврат Ложь;
	КонецЕсли;	
КонецФункции	

