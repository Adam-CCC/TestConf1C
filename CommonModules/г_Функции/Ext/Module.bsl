Функция г_ПоискРЛСТакимЖеНомером (НомерТел,Ссылка) Экспорт 
	
	// + КМ
	// БЫЛО:
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//|	РабочийЛист.Ссылка
	//|ИЗ
	//|	Документ.РабочийЛист КАК РабочийЛист
	//|ГДЕ
	//|	РабочийЛист.ПредставлениеТелефона = &ПредставлениеТелефона
	//|	И РабочийЛист.Ссылка <> &Ссылка
	//|	И РабочийЛист.ПометкаУдаления = ЛОЖЬ";
	//ЗАпрос.УстановитьПараметр("ПредставлениеТелефона",НомерТел);	
	//ЗАпрос.УстановитьПараметр("Ссылка",Ссылка);	
	////ЗАпрос.УстановитьПараметр("Статус",Справочники.СтатусыРабочегоЛиста.Сделка);	
	//
	// СТАЛО:
	ОсновнойТелефон = "";
	ДобавочныйТелефон = "";
	
	Если Найти(НомерТел, ", доб.") > 0 Тогда 	// есть добавочный номер
		ОсновнойТелефон = "%" + СокрЛП(Лев(НомерТел, Найти(НомерТел, ", доб.") - 1)) + "%";
		ДобавочныйТелефон = "%" + СокрЛП(Сред(НомерТел, Найти(НомерТел, ", доб.") + 6)) + "%";
	Иначе
		ОсновнойТелефон = "%" + СокрЛП(НомерТел) + "%";
		ДобавочныйТелефон = "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РабочийЛист.Ссылка
	|ИЗ
	|	Документ.РабочийЛист КАК РабочийЛист
	|ГДЕ
	|	(РабочийЛист.ПредставлениеТелефона ПОДОБНО &ОсновнойТелефон
	|			ИЛИ ВЫБОР
	|				КОГДА &ДобавочныйТелефон <> """"
	|					ТОГДА РабочийЛист.ПредставлениеТелефона ПОДОБНО &ДобавочныйТелефон
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|	И РабочийЛист.Ссылка <> &Ссылка
	|	И РабочийЛист.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ОсновнойТелефон", ОсновнойТелефон);	
	Запрос.УстановитьПараметр("ДобавочныйТелефон", ДобавочныйТелефон);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);	
	// - КМ
	
	СписокРЛ = Новый СписокЗначений;
	
	Результат = Запрос.Выполнить().Выбрать();
	
	ПОка Результат.Следующий() цикл
		СписокРЛ.Добавить(Результат.Ссылка);
		
	КонецЦикла;	
	
	Возврат СписокРЛ;
КонецФункции

Процедура ПроставитьЯчейкиВНоменклатуре (Документ) Экспорт 
	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.ПеремещениеТоваров")   тогда
		
		
		Для Каждого стр из Документ.Товары цикл
			Если стр.Ячейка <> Справочники.ЯчейкиХранения.ПустаяСсылка() тогда
				//Для Каждого ячейки из стр.ЯчейкиХранения цикл
				Номенклатура = стр.Номенклатура.ПолучитьОбъект();
				НайденнаяСтрока = Номенклатура.ЯчейкиХранения.Найти(Документ.СкладКомпании, "СкладКомпании");
				Если НайденнаяСтрока = Неопределено тогда
					СтрокаЯчейки = Номенклатура.ЯчейкиХранения.Добавить();
					СтрокаЯчейки.СкладКомпании = Документ.СкладКомпании;
					СтрокаЯчейки.ЯчейкаХранения = стр.Ячейка;
					
				Иначе
					//НайденнаяСтрока = Номенклатура.ЯчейкиХранения.Найти(стр.Ячейка, "ЯчейкаХранения");
					Номенклатура.ЯчейкиХранения.Удалить(НайденнаяСтрока);
					СтрокаЯчейки = Номенклатура.ЯчейкиХранения.Добавить();
					СтрокаЯчейки.СкладКомпании = Документ.СкладКомпании;
					СтрокаЯчейки.ЯчейкаХранения = стр.Ячейка;
				КонецЕсли;   
				Попытка
					Номенклатура.Записать();
				Исключение
				КонецПопытки;
				//КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого стр из Документ.Товары цикл
			Если стр.ЯчейкаПолучатель <> Справочники.ЯчейкиХранения.ПустаяСсылка() тогда
				//Для Каждого ячейки из стр.ЯчейкиХранения цикл
				Номенклатура = стр.Номенклатура.ПолучитьОбъект();
				НайденнаяСтрока = Номенклатура.ЯчейкиХранения.Найти(Документ.СкладКомпании, "СкладКомпании");
				Если НайденнаяСтрока = Неопределено тогда
					СтрокаЯчейки = Номенклатура.ЯчейкиХранения.Добавить();
					СтрокаЯчейки.СкладКомпании = Документ.СкладКомпании;
					СтрокаЯчейки.ЯчейкаХранения = стр.ЯчейкаПолучатель;
					
				Иначе
					//НайденнаяСтрока = Номенклатура.ЯчейкиХранения.Найти(стр.Ячейка, "ЯчейкаХранения");
					Номенклатура.ЯчейкиХранения.Удалить(НайденнаяСтрока);
					СтрокаЯчейки = Номенклатура.ЯчейкиХранения.Добавить();
					СтрокаЯчейки.СкладКомпании = Документ.СкладКомпании;
					СтрокаЯчейки.ЯчейкаХранения = стр.ЯчейкаПолучатель;
				КонецЕсли;   
				Попытка
					Номенклатура.Записать();
				Исключение
				КонецПопытки;
				//КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
КонецПроцедуры	

Функция ВыгрузитьДеревоЗначенийВТаблицуЗначений(Дерево, Таблица = Неопределено) Экспорт
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл  //Перебираем все строкидерева значений используя рекурсию и формируем такие же в таблице значений
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), СтрокаДерева); 
		ВыгрузитьДеревоЗначенийВТаблицуЗначений(СтрокаДерева, Таблица);
	КонецЦикла;    
	Возврат Таблица;
	
