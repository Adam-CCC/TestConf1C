	//ПоступлениеОбъект.НеКонтролироватьЗаказПоставщику = Истина;
	//ПоступлениеОбъект.КонтролироватьЯчейкиХранения = Ложь;
	ПоступлениеОбъект.ВхДокДата  =РеализацияОбъект.Дата;
	ПоступлениеОбъект.ВхДокНомер = РеализацияОбъект.Номер;
	
	ПоступлениеОбъект.Автор = ПараметрыСеанса.Пользователь;
	ПоступлениеОбъект.Комментарий = "Создан автоматически для перепродажи зап. частей между организациями";
	Для Каждого стр из ТоварыКПродажи цикл 
		СтрокаРеализации = ПоступлениеОбъект.Товары.Добавить();
		СтрокаРеализации.Номенклатура = стр.Товар;
		СтрокаРеализации.Цена = стр.Цена;
		СтрокаРеализации.Количество = стр.Количество;
		СтрокаРеализации.ЕдиницаИзмерения = стр.ЕдиницаИзмерения;
		
		ДопПараметры = Новый Структура;
		
		ДопПараметры.Вставить("НеКонтролироватьЗамены",Истина);
		ДопПараметры.Вставить("ПересчитатьЦену",Ложь);
		ПоступлениеОбъект.ОбработкаРеквизита("Товары.Номенклатура", СтрокаРеализации,, ДопПараметры);
		СтрокаРеализации.Цена = стр.Цена;
		
		ПоступлениеОбъект.ОбработкаРеквизита("Товары.ХарактеристикаНоменклатуры", СтрокаРеализации,, ДопПараметры);
		ПоступлениеОбъект.ОбработкаРеквизита("Товары.ЕдиницаИзмерения", СтрокаРеализации,, ДопПараметры);
		ПоступлениеОбъект.ОбработкаРеквизита("Товары.Количество", СтрокаРеализации,, ДопПараметры);
		ПоступлениеОбъект.ОбработкаРеквизита("Товары.Коэффициент", СтрокаРеализации,, ДопПараметры);
		//РеализацияОбъект.ОбработкаРеквизита("Товары.Сумма", СтрокаРеализации,, ДопПараметры);
	КонецЦикла;
	
	
	Попытка
		ПоступлениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;			
