Функция СМГ_АвтоЕстьНаСкладе(ОбъектДокумент)
	
	ЕстьНаСкладе = Истина;
	
 	Попытка
		КонтрагентСтаричков = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН","262804044870");
	Исключение
		КонтрагентСтаричков = Справочники.Контрагенты.ПустаяСсылка();
	КонецПопытки;
	
	Если Не обЗначениеНеЗаполнено(КонтрагентСтаричков) Тогда	
		Если Не обЗначениеНеЗаполнено(ОбъектДокумент.Контрагент) Тогда
			Если ОбъектДокумент.Контрагент = КонтрагентСтаричков Тогда
				Возврат ЕстьНаСкладе;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Если обЗначениеНеЗаполнено(ОбъектДокумент.Автомобиль) Тогда
		Возврат ЕстьНаСкладе;	
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&ТекущаяДата, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки";
	
	Если обЗначениеНеЗаполнено(ОбъектДокумент.Дата) Тогда
		Запрос.Параметры.Вставить("ТекущаяДата", ТекущаяДата());
	Иначе	
		Запрос.Параметры.Вставить("ТекущаяДата", ОбъектДокумент.Дата);
	КонецЕсли; 
	
	Запрос.Параметры.Вставить("Автомобиль", ОбъектДокумент.Автомобиль);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
 	Если Результат[0].КоличествоОстаток > 0 Тогда
		ЕстьНаСкладе = Истина;
	Иначе
 		ЕстьНаСкладе = Ложь;
	КонецЕсли;               
	
	Возврат ЕстьНаСкладе;
 	
КонецФункции // СМГ_АвтоЕстьНаСкладе(ОбъектДокумент)
