	  Имя = СтрЗаменить(Имя,"(",""); 
	  Имя = СтрЗаменить(Имя,")",""); 
	  Имя = СтрЗаменить(Имя,"-",""); 
	  //Имя = СтрЗаменить(Имя,"+",""); 
	  Возврат Имя;
	
