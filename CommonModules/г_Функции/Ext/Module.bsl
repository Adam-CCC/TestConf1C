Процедура ЗаписатьУпушеныйСпрос(ТекСтрока,ФормаДок) Экспорт 
	ТекСтрока = ФормаДок.ЭлементыФормы.Товары.ТекущаяСтрока;
	Если   ТипЗнч(ФормаДок.ДокументОбъект) = Тип("ДокументОбъект.ЗаказНаряд") или
		ТипЗнч(ФормаДок.ДокументОбъект) = Тип("ДокументОбъект.ЗаявкаНаРемонт") или
		ТипЗнч(ФормаДок.ДокументОбъект) = Тип("ОбработкаОбъект.АРМКалькуляция")  или
		ТипЗнч(ФормаДок.ДокументОбъект) = Тип("ОбработкаОбъект.АРМКорзина")    тогда
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
		// Данный фрагмент построен конструктором.
		// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ОстаткиТоваровОрдерныйСкладОстатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровОрдерныйСклад.Остатки КАК ОстаткиТоваровОрдерныйСкладОстатки
		|ГДЕ
		|	ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("Номенклатура",ТекСтрока.Номенклатура);
		Результат = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		ЕСЛИ НЕ ВыборкаДетальныеЗаписи.Следующий() ТОгда
			Возврат ;
		КонецЕсли;;
		
		//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
		
		ФормаСпроса = Обработки.УпущенныйСпрос.ПолучитьФорму("ФормаСпроса",ФормаДок);
		Если ТекСтрока<>Неопределено И (Не ТекСтрока.Номенклатура.ЭтоГруппа) Тогда
			ФормаСпроса.Артикул=ТекСтрока.Номенклатура.Артикул;
			ФормаСпроса.Номенклатура=ТекСтрока.Номенклатура;
		КонецЕсли;
		ФормаСпроса.Количество=1;
		ФормаСпроса.ВладелецФормы = ФормаДок;
		ФормаСпроса.ОткрытьМодально();
	КонецЕсли;
КонецПроцедуры	


