Процедура ЗаполнитьЦентральныеНастройкиДляВсехКампаний(ЦентральнаяКампания)Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_Кампании.Ссылка
	|ИЗ
	|	Справочник.Renault_Кампании КАК Renault_Кампании
	|ГДЕ
	|	Renault_Кампании.Родитель <> ЗНАЧЕНИЕ(Справочник.Renault_Кампании.Архивные)
	|	И Renault_Кампании.Загружаемая = ЛОЖЬ
	|	И Renault_Кампании.Статус <> ЗНАЧЕНИЕ(Перечисление.CRM_СтатусыКлиентскихЗаявок.Отклонена)
	|	И Renault_Кампании.ПометкаУдаления = ЛОЖЬ";
	
	Для Каждого Рек из ЦентральнаяКампания цикл
		
		Если НЕ ЗначениеЗаполнено(Рек.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Рек.Ключ = "Наименование" 
			или Рек.Ключ = "Ссылка"
			или Рек.Ключ = "Код"
			или Рек.Ключ = "Владелец"
			или Рек.Ключ = "Родитель"
			или Рек.Ключ = "ЭтоГруппа"
			или Рек.Ключ = "ПометкаУдаления"
			или Рек.Ключ = "Предопределенный"
			или Рек.Ключ = "ИмяПредопределенныхДанных" 
			или Рек.Ключ = "РазоваяКампания"
			или Рек.Ключ = "НастройкиОтбора"
			или Рек.Ключ = "Архивная"
			или Рек.Ключ = "ФлРазоваяКампания"
			или Рек.Ключ = "Загружаемая"
			или Рек.Ключ = "ЦентральныйУИД"
			или Рек.Ключ = "НастройкиДополнительные"
			или Рек.Ключ = "Активная"
			или Рек.Ключ = "ЦентральнаяНастройка" Тогда 
			Продолжить;
		КонецЕсли;
		Запрос.Текст = Запрос.Текст  + " И Renault_Кампании." + Рек.Ключ +" = " + Рек.Значение;
		
	КонецЦикла;
	
	
	Выборка  = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кампания = Выборка.Ссылка.ПолучитьОбъект();
		//НастройкиДополнительные = Кампания.НастройкиДополнительные.Получить();
		//Если ТипЗнч(НастройкиДополнительные) = Тип("НастройкиКомпоновкиДанных") тогда
		//	//УдалитьПересеченияНастроекОтбора(НастройкиДляВсех,НастройкиДополнительные);
		//	//Для Каждого ЭлОтбораЦентральный из НастройкиДляВсех.Отбор.Элементы Цикл
		//	//	ЗаполнитьЗначенияСвойств(НастройкиЦентральные.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")),ЭлОтбораЦентральный);
		//	//КонецЦикла;
		//	Кампания.НастройкиЦентральные =  Новый ХранилищеЗначения(НастройкиДляВсех);
		//	Кампания.Записать();
		//Иначе
		Кампания.НастройкиЦентральные =  ЦентральнаяКампания.НастройкиДополнительные;
		Кампания.Записать();
		//КонецЕсли;
		
	КонецЦикла;
	
	
	
КонецПроцедуры

