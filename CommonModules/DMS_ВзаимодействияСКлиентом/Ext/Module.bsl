// Функция выполняет рассылку через веб-сервис консолидированной базы Renault
// параметры:
// ТаблицаСообщений - таблица с данными к отправке
// колонки - "ТекстСообщения" (Строка), "BIR" (Строка), "Получатели" (ТаблицаЗначений с колонкой "Адрес")
Функция ВыполнитьРассылкуПисем(ТаблицаСообщений) Экспорт
	
	ВебСервис = ПолучитьВебСервис();
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	Сериализатор = Новый СериализаторXDTO(СервисФабрика);
	Параметры = Сериализатор.ЗаписатьXDTO(ТаблицаСообщений);
	Ответ = ВебСервис.SendMailDelivery(Параметры);
	
КонецФункции

// Функция выполняет рассылку СМС через веб-сервис консолидированной базы Renault
// параметры:
// ТаблицаСообщений - таблица с данными к отправке
// колонки - "ТекстСообщения" (Строка), "BIR" (Строка), "Получатели" (ТаблицаЗначений с колонкой "Телефон")
Функция ВыполнитьРассылкуСМС(ТаблицаСообщений, Логин = "", Пароль = "") Экспорт 	
	ВебСервис = ПолучитьВебСервис();
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	Сериализатор = Новый СериализаторXDTO(СервисФабрика);
	Параметры = Сериализатор.ЗаписатьXDTO(ТаблицаСообщений);
	
	НастройкаБренда = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	Если НастройкаБренда.SMSNotice Тогда
		Если Не ЗначениеЗаполнено(Логин) Тогда
			Логин = НастройкаБренда.SMSNoticeLog;
			Пароль = НастройкаБренда.SMSNoticePas;
		КонецЕсли;
		Задержка = НастройкаБренда.SMSNoticeWait;
		Ответ = ВебСервис.SendSMSDelivery_NS(Параметры, Логин, Пароль, Задержка);
	ИначеЕсли НастройкаБренда.SMSMTS Тогда
		Логин = НастройкаБренда.SMSMTSLog;
		Пароль = НастройкаБренда.SMSMTSPas;
	    Ответ = ВебСервис.SendSMSDelivery_MTS(Параметры, Логин, Пароль);		
	Иначе
		Ответ = ВебСервис.SendSMSDelivery(Параметры);
	КонецЕсли;
	
	ТаблицаКВозврату = Сериализатор.ПрочитатьXDTO(Ответ);
	ОтправленоНаГейт = Перечисления.Renault_СтатусыСМС.ОтправленоНаГейт;
	
	Для Каждого Строка ИЗ ТаблицаКВозврату Цикл
		СтруктураРезультата = Строка.Результат;
		МассивСтруктурРезультата = СтруктураРезультата.ОтправленныеСообщения;
		Для Каждого СтруктураРезультата ИЗ МассивСтруктурРезультата Цикл
			ИД = СтруктураРезультата.ИдентификаторСообщения;
			
			Запись = РегистрыСведений.Renault_SMS.СоздатьМенеджерЗаписи();
			Запись.MessageID = ИД;
			Запись.Прочитать();
			Если НЕ Запись.Выбран() Тогда
				Запись.MessageID = ИД;
				Запись.Статус = ОтправленоНаГейт;
				Запись.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаКВозврату
КонецФункции

Функция ПолучитьВебСервис() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	
	АдресWS = Настройки.КЦАдресСервера;
	СообщениеОбОшибке = "";
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/ContactCenter.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/ContactCenter", 
							   "Renault_ContactCenter", "Renault_ContactCenterSoap12",300);
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ВебСервис;
	
КонецФункции

