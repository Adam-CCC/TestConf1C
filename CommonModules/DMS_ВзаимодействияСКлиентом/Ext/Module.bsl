Процедура ПолучитьОтчетБюджетСМС(ПараметрыВызоваСервера, АдресХранилища) Экспорт 
	ВебСервис = ПолучитьВебСервис();
	ТЗ_XDTO = ВебСервис.GetReportSMS(ПараметрыВызоваСервера.BIR, ПараметрыВызоваСервера.НачПериода, ПараметрыВызоваСервера.КонПериода);
	ТЗ = СериализаторXDTO.ПрочитатьXDTO(ТЗ_XDTO);   
	ПоместитьВоВременноеХранилище(ТЗ, АдресХранилища); 
КонецПроцедуры

