
//Подписки на события
Процедура DMS_ЗаписьВзаимодействийСКлиентомПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.Количество()=0 тогда	
		Возврат;
	КонецЕсли;
	
	Менеджер = 	DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
	
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.DMS_ЖурналСобытий") тогда 
		
				
		Для каждого ЗаписьИсточника из Источник цикл
			
			Если НЕ ЗначениеЗаполнено(ЗаписьИсточника.ДатаИсполнения) тогда 
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ЗаписьИсточника.ОбъектОповещения) <> Тип("СправочникСсылка.Контрагенты") 
				И ТипЗнч(ЗаписьИсточника.ОбъектОповещения) <> Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") тогда 
				Продолжить;
			КонецЕсли;
			
			
			Если ЗаписьИсточника.СпособОповещения = Справочники.DMS_СпособыОповещения.ПоСМС  тогда
				ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.СМС;
			ИначеЕсли ЗаписьИсточника.СпособОповещения = Справочники.DMS_СпособыОповещения.ПоПочте тогда
				ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.email;	
			Иначе
				Продолжить;
			КонецЕсли;
			
			ИД = Строка(ЗаписьИсточника.РегистраторСобытия.УникальныйИдентицикатор()) +" "+ Строка(ЗаписьИсточника.НомерСобытия);
			Направление = Перечисления.ТипыСообщений.Исходящее;
			
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(ЗаписьИсточника.ОбъектОповещения);
			Набор.Отбор.ИД.Установить(ИД);
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.ОбращенияКлиентов);
			Набор.Отбор.Направление.Установить(Направление);
			
			ЗаписьВзаимодействия = Набор.Добавить();
			ЗаписьВзаимодействия.ИД = ИД;
			ЗаписьВзаимодействия.Клиент = ЗаписьИсточника.ОбъектОповещения;
			ЗаписьВзаимодействия.Направление = Направление;
			ЗаписьВзаимодействия.ДатаСобытия = ЗаписьИсточника.ДатаИсполнения;
			ЗаписьВзаимодействия.ДатаПланируемая = ЗаписьИсточника.ДатаОповещения;
			ЗаписьВзаимодействия.Период = ?(ЗначениеЗаполнено(ЗаписьВзаимодействия.ДатаСобытия),ЗаписьВзаимодействия.ДатаСобытия,ЗаписьВзаимодействия.ДатаПланируемая);
			ЗаписьВзаимодействия.Событие = ЗаписьИсточника.Событие; 
			ЗаписьВзаимодействия.ВидКонтакта = ВидКонтакта;
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.ОбращенияКлиентов;
			ЗаписьВзаимодействия.Менеджер = Менеджер;
			ЗаписьВзаимодействия.ИсточникСобытия = ЗаписьИсточника.РегистраторСобытия;
			ЗаписьВзаимодействия.Результат = ЗаписьИсточника.Описание;
			
			Набор.Записать(Истина);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.Renault_ТрафикПисьма") тогда 
		
		
		Для каждого ЗаписьИсточника из Источник цикл
			
			Клиент = НайтиКлиентаПоПочте(ЗаписьИсточника.ПочтаКлиента);
			
			Если Клиент = Неопределено тогда
				Возврат;
			КонецЕсли;
			
			ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.email;	
			Направление = Перечисления.ТипыСообщений.Входящее;
			
			ИД = ЗаписьИсточника.ИдТрафика + " " + Строка(ЗаписьИсточника.ДатаПоступления);
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(Клиент);
			Набор.Отбор.ИД.Установить(ИД);
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.КонтактЦентр);
			Набор.Отбор.Направление.Установить(Направление);
			
			Набор.Прочитать();
			Если Набор.Количество() = 0 тогда
				ЗаписьВзаимодействия = Набор.Добавить();
			Иначе 
				ЗаписьВзаимодействия = Набор.Получить(0);
			КонецЕсли;
			
			ЗаписьВзаимодействия.Клиент = Клиент;
			ЗаписьВзаимодействия.ИД = ИД;
			ЗаписьВзаимодействия.Направление = Направление;

			ЗаписьВзаимодействия.ДатаСобытия = ЗаписьИсточника.ДатаПоступления;
			ЗаписьВзаимодействия.Период = ЗаписьВзаимодействия.ДатаСобытия;
			ЗаписьВзаимодействия.Событие = "Входящее письмо"; 
			ЗаписьВзаимодействия.ВидКонтакта = ВидКонтакта;
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.КонтактЦентр;
			ЗаписьВзаимодействия.Примечание =  ЗаписьИсточника.ТекстПисьма;
			ЗаписьВзаимодействия.Менеджер = Менеджер;
			ЗаписьВзаимодействия.ИсточникСобытия = "Электронное письмо "+ ЗаписьИсточника.ИдентификаторПисьма;
			ЗаписьВзаимодействия.Результат = ЗаписьИсточника.РезультатОбработки;
			
			Набор.Записать(Истина);
			
		КонецЦикла;
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.Renault_ОтветыНаПисьмо") тогда
	
		Для каждого ЗаписьИсточника из Источник цикл
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_НормализованныеКонтактыДляПоиска.Объект КАК Клиент,
			|	Renault_ТрафикПисьма.ИдентификаторПисьма
			|ИЗ
			|	РегистрСведений.Renault_ТрафикПисьма КАК Renault_ТрафикПисьма
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_НормализованныеКонтактыДляПоиска КАК Renault_НормализованныеКонтактыДляПоиска
			|		ПО Renault_ТрафикПисьма.ПочтаКлиента = Renault_НормализованныеКонтактыДляПоиска.Данные
			|ГДЕ
			|	Renault_ТрафикПисьма.ИдТрафика = &ИдТрафика
			|	И НЕ Renault_НормализованныеКонтактыДляПоиска.Объект ЕСТЬ NULL 
			|	И (Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.Контрагенты
			|			ИЛИ Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.CRM_ПотенциальныеКонтрагенты)";
			
			Запрос.УстановитьПараметр("ИдТрафика", ЗаписьИсточника.ИдТрафика);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если НЕ Выборка.Следующий() Тогда
				Возврат;
			КонецЕсли;
			
			ИД = ЗаписьИсточника.ИдТрафика + " "+ Строка(ЗаписьИсточника.ДатаОтвета);
			Направление = Перечисления.ТипыСообщений.Исходящее;
			
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(Выборка.Клиент);
			Набор.Отбор.ИД.Установить(ИД);
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.КонтактЦентр);
			Набор.Отбор.Направление.Установить(Направление);

			Набор.Прочитать();
			Если Набор.Количество() = 0 тогда
				ЗаписьВзаимодействия = Набор.Добавить();
			Иначе
				ЗаписьВзаимодействия = Набор.Получить(0);
			КонецЕсли;
			
			ЗаписьВзаимодействия.ИД = ИД;
			ЗаписьВзаимодействия.Клиент = Выборка.Клиент;
			ЗаписьВзаимодействия.Направление = Направление;

			ЗаписьВзаимодействия.ДатаСобытия = ЗаписьИсточника.ДатаОтвета;
			ЗаписьВзаимодействия.ДатаПланируемая = ЗаписьИсточника.ДатаОтвета;
			ЗаписьВзаимодействия.Период = ЗаписьВзаимодействия.ДатаСобытия;
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.КонтактЦентр;
			ЗаписьВзаимодействия.ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.Email;
			ЗаписьВзаимодействия.Событие = "Ответ клиенту на письмо"; 
			ЗаписьВзаимодействия.Менеджер = Менеджер;
			ЗаписьВзаимодействия.Примечание =  ЗаписьИсточника.Ответ;
			ЗаписьВзаимодействия.Результат = "Ответ отправлен";
			ЗаписьВзаимодействия.ИсточникСобытия = "Электронное письмо " + Выборка.ИдентификаторПисьма;
			Набор.Записать(Истина);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.Renault_ОтветыНаЛиды") тогда
		
				
		Для каждого ЗаписьИсточника из Источник цикл
		  	Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_Лид.Клиент
			|ИЗ
			|	Документ.Renault_Лид КАК Renault_Лид
			|ГДЕ
			|	Renault_Лид.ТрафикИД = &ТрафикИД";
			
			Запрос.УстановитьПараметр("ТрафикИД", ЗаписьИсточника.ИдТрафика);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если НЕ Выборка.Следующий() Тогда
				Возврат;
			КонецЕсли;
			
			ИД = ЗаписьИсточника.ИдТрафика + " "+ Строка(ЗаписьИсточника.ДатаОтвета);
			Направление = Перечисления.ТипыСообщений.Исходящее;
			
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(Выборка.Клиент);
			Набор.Отбор.ИД.Установить(ИД);
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.КонтактЦентр);
			Набор.Отбор.Направление.Установить(Направление);

			Набор.Прочитать();
			
			Если Набор.Количество() = 0 тогда
				ЗаписьВзаимодействия = Набор.Добавить();
			Иначе
				ЗаписьВзаимодействия = Набор.Получить(0);
			КонецЕсли;
				
			ЗаписьВзаимодействия.ИД = ИД;
			ЗаписьВзаимодействия.Клиент = Выборка.Клиент;
			ЗаписьВзаимодействия.Направление = Направление;

			ЗаписьВзаимодействия.ДатаСобытия = ЗаписьИсточника.ДатаОтвета;
			ЗаписьВзаимодействия.ДатаПланируемая = ЗаписьИсточника.ДатаОтвета;
			ЗаписьВзаимодействия.Период = ЗаписьВзаимодействия.ДатаСобытия;
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.КонтактЦентр;
			ЗаписьВзаимодействия.ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.Email;
			ЗаписьВзаимодействия.Событие = "Ответ клиенту на ЛИД"; 
			ЗаписьВзаимодействия.Менеджер = Менеджер;
			ЗаписьВзаимодействия.Примечание =  ЗаписьИсточника.Ответ;
			ЗаписьВзаимодействия.Результат = "Ответ отправлен";
			ЗаписьВзаимодействия.ИсточникСобытия = "Электронное письмо " + ЗаписьИсточника.ИдентификаторПисьма;
			Набор.Записать(Истина);
		
		КонецЦикла;
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.DMS_ИсторияЗвонков") тогда 
		
		 Для каждого ЗаписьИсточника из Источник цикл
			 
			 Если Не ЗначениеЗаполнено(ЗаписьИсточника.Клиент) тогда
				 Продолжить;
			 КонецЕсли;
			 
			ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.Звонок;	
			
			Если СтрДлина(ЗаписьИсточника.ТелефонЗвонящего) = 3 тогда 
				Направление = Перечисления.ТипыСообщений.Исходящее;
				Событие = "Звонок клиенту";
			ИначеЕсли СтрДлина(ЗаписьИсточника.НашТелефон) = 3 
				ИЛИ ЗаписьИсточника.Клиент = DMS_ОбращенияКлиентов.НайтиКонтрагентаПоТелефону(ЗаписьИсточника.ТелефонЗвонящего) тогда 
				Направление = Перечисления.ТипыСообщений.Входящее;
				Событие = "Звонок клиента";
			иначе
				Направление = Перечисления.ТипыСообщений.Исходящее;
				Событие = "Звонок клиенту";
			КонецЕсли;

			 
			ИД = ЗаписьИсточника.UniqueID;
			
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(ЗаписьИсточника.Клиент);
			Набор.Отбор.ИД.Установить(ИД);
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.Телефония);
			Набор.Отбор.Направление.Установить(Направление);

			Набор.Прочитать();
			
			Если Набор.Количество() = 0 тогда
				ЗаписьВзаимодействия = Набор.Добавить();
			Иначе
				ЗаписьВзаимодействия = Набор.Получить(0);
			КонецЕсли;
				
			ЗаписьВзаимодействия.ИД = ИД;
			ЗаписьВзаимодействия.Клиент = ЗаписьИсточника.Клиент;
			ЗаписьВзаимодействия.Направление = Направление;

			ЗаписьВзаимодействия.ДатаСобытия = ЗаписьИсточника.ДатаНачалаРазговора;
			ЗаписьВзаимодействия.ДатаПланируемая = ЗаписьИсточника.Период;
			ЗаписьВзаимодействия.Период = ?(ЗначениеЗаполнено(ЗаписьВзаимодействия.ДатаСобытия),ЗаписьВзаимодействия.ДатаСобытия,ЗаписьВзаимодействия.ДатаПланируемая);
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.Телефония;
			ЗаписьВзаимодействия.ВидКонтакта = ВидКонтакта;
			ЗаписьВзаимодействия.Событие = Событие; 
			ЗаписьВзаимодействия.Менеджер = ЗаписьИсточника.Сотрудник;
			ЗаписьВзаимодействия.Примечание = ЗаписьИсточника.ТелефонЗвонящего + " -> " + ЗаписьИсточника.НашТелефон;
			ЗаписьВзаимодействия.Результат = ?(ЗначениеЗаполнено(ЗаписьИсточника.ДатаНачалаРазговора),"Звонок обработан","Звонок пропущен");
			ЗаписьВзаимодействия.ИсточникСобытия = "Телефоный звонок " + ИД;
			Набор.Записать(Истина);
		
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура DMS_ЗаписьВзаимодействийСКлиентомДокументыПриЗаписи(Источник, Отказ) Экспорт
     	
	Если Источник.ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Renault_Лид") тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ОтветыНаЛиды.ДатаОтвета
		|ИЗ
		|	РегистрСведений.Renault_ОтветыНаЛиды КАК Renault_ОтветыНаЛиды
		|ГДЕ
		|	Renault_ОтветыНаЛиды.ИдТрафика = &ИдТрафика";
		
		Запрос.УстановитьПараметр("ИдТрафика", Источник.ТрафикИД);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДатаОтвета = Дата(1,1,1);
		
		Пока Выборка.Следующий() Цикл
			ДатаОтвета = Выборка.ДатаОтвета;
		КонецЦикла;
		
		Направление = Перечисления.ТипыСообщений.Входящее;
		
		Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
		Набор.Отбор.Клиент.Установить(Источник.Клиент);
		Набор.Отбор.ИД.Установить(Строка(Источник.Ссылка.УникальныйИдентификатор()));
		Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.КонтактЦентр);
		Набор.Отбор.Направление.Установить(Направление);
		
		Набор.Прочитать();
		Если Набор.Количество() = 0 тогда
			ЗаписьВзаимодействия = Набор.Добавить();
		Иначе
			ЗаписьВзаимодействия = Набор.Получить(0);
		КонецЕсли;

		ЗаписьВзаимодействия.ИД = Строка(Источник.Ссылка.УникальныйИдентификатор());
		ЗаписьВзаимодействия.Клиент = Источник.Клиент;
		ЗаписьВзаимодействия.Направление = Направление;
		ЗаписьВзаимодействия.ДатаСобытия = ДатаОтвета;
		ЗаписьВзаимодействия.ДатаПланируемая = Источник.Дата;
		ЗаписьВзаимодействия.Период = ?(ЗначениеЗаполнено(ЗаписьВзаимодействия.ДатаСобытия),ЗаписьВзаимодействия.ДатаСобытия,ЗаписьВзаимодействия.ДатаПланируемая);
		ЗаписьВзаимодействия.Событие = Источник.ВидУслуги; 
		ЗаписьВзаимодействия.ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.Лид;
		ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.КонтактЦентр;
		ЗаписьВзаимодействия.Менеджер = Источник.Менеджер;
		ЗаписьВзаимодействия.ИсточникСобытия = Источник.Ссылка;
		ЗаписьВзаимодействия.Примечание = Лев(СокрЛП(Источник.Сообщение),200);
		ЗаписьВзаимодействия.Результат = Строка(Источник.РезультатОбработки);
		
		Набор.Записать(Истина);

	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.CRM_СобытияПоРабочимЛистам") тогда
		
		Если Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.Встреча 
			ИЛИ Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.Выдача 
			ИЛИ Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.ТестДрайв тогда
			ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.ПосещениеСалона;
			Направление = Перечисления.ТипыСообщений.Входящее;
		ИначеЕсли Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.ЗвонокВежливости3
			ИЛИ Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.ЗвонокВежливости30 
			ИЛИ Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.ЗвонокВежливости360
			ИЛИ Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.Прочее 
			ИЛИ Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.ЗвонокВежливостиНовый
			ИЛИ Источник.ВидСобытия =  Справочники.CRM_ВидыСобытий.Прозвон тогда
			ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.Звонок;
			Направление = Перечисления.ТипыСообщений.Исходящее;
		Иначе
			ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.Прочее;	
			Направление = Перечисления.ТипыСообщений.Исходящее;
		КонецЕсли;	
		
		ВыборкаРЛ = РегистрыСведений.Renault_РабочиеЛисты.Выбрать(Новый Структура("IDK",Источник.IDK));
		Если ВыборкаРЛ.Следующий() тогда
			Клиент = ВыборкаРЛ.Клиент;
			ДатаРабочегоЛиста=ВыборкаРЛ.ДатаID;
		Иначе  //не был определен рабочий лист
			Возврат;
		КонецЕсли;
		
		Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
		Набор.Отбор.Клиент.Установить(Клиент);
		Набор.Отбор.ИД.Установить(Строка(Источник.Ссылка.УникальныйИдентификатор()));
		Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.Продажи);
		Набор.Отбор.Направление.Установить(Направление);
		
		Набор.Прочитать();
		Если Набор.Количество() = 0 тогда
			ЗаписьВзаимодействия = Набор.Добавить();
		Иначе
			ЗаписьВзаимодействия = Набор.Получить(0);
		КонецЕсли;
		
		ЗаписьВзаимодействия.Клиент = Клиент;
		ЗаписьВзаимодействия.ИД = Строка(Источник.Ссылка.УникальныйИдентификатор());
		ЗаписьВзаимодействия.Направление = Направление;
		ЗаписьВзаимодействия.ДатаСобытия = Источник.ДатаЗакрытия;
		ЗаписьВзаимодействия.ДатаПланируемая = Источник.Дата;
		ЗаписьВзаимодействия.Период = ?(ЗначениеЗаполнено(ЗаписьВзаимодействия.ДатаСобытия),ЗаписьВзаимодействия.ДатаСобытия,ЗаписьВзаимодействия.ДатаПланируемая);
		ЗаписьВзаимодействия.Событие = Источник.ВидСобытия; 
		ЗаписьВзаимодействия.ВидКонтакта = ВидКонтакта;
		ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.Продажи;
		ЗаписьВзаимодействия.Менеджер = Источник.Сотрудник;
		ЗаписьВзаимодействия.ИсточникСобытия = "Рабочий лист №"+Формат(Источник.IDK,"ЧГ=") + " от " + ДатаРабочегоЛиста;
		ЗаписьВзаимодействия.Примечание = Источник.Комментарий;
		ЗаписьВзаимодействия.Результат = Источник.КомментарийЗакрытия;
		
		Набор.Записать(Истина);
		
	ИначеЕсли  ТипЗнч(Источник) = Тип("ДокументОбъект.DMS_ОбращениеКлиента") тогда 
		
		Для каждого Стр из Источник.ДействияПоОбращению цикл
			
			Если стр.Действие <> Справочники.DMS_ДействияПоОбращениям.ВизитКлиента 
				и стр.Действие <> Справочники.DMS_ДействияПоОбращениям.СвязатьсяСКлиентом тогда 
				Продолжить;
			КонецЕсли;
			
			Если стр.Действие = Справочники.DMS_ДействияПоОбращениям.ВизитКлиента тогда
				ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.ПосещениеСалона;
				Направление = Перечисления.ТипыСообщений.Входящее;
			иначе
				ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.Звонок;	
				Направление = Перечисления.ТипыСообщений.Исходящее;
			КонецЕсли;
			
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(Источник.Контрагент);
			Набор.Отбор.ИД.Установить(Строка(Источник.Ссылка.УникальныйИДентификатор()) + " " + Строка(Стр.НомерСтроки));
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.ОбращенияКлиентов);
			Набор.Отбор.Направление.Установить(Направление);
			
			ЗаписьВзаимодействия = Набор.Добавить();
			
			ЗаписьВзаимодействия.ИД = Строка(Источник.Ссылка.УникальныйИДентификатор()) + " " + Строка(Стр.НомерСтроки);
			ЗаписьВзаимодействия.Направление = Направление;
			ЗаписьВзаимодействия.Клиент = Источник.Контрагент;
			ЗаписьВзаимодействия.ДатаСобытия = Стр.ДатаВыполнения;
			ЗаписьВзаимодействия.ДатаПланируемая = Стр.ДатаПланируемая;
			ЗаписьВзаимодействия.Период = ?(ЗначениеЗаполнено(ЗаписьВзаимодействия.ДатаСобытия),ЗаписьВзаимодействия.ДатаСобытия,ЗаписьВзаимодействия.ДатаПланируемая);
			ЗаписьВзаимодействия.Событие = ВидКонтакта; 
			ЗаписьВзаимодействия.ВидКонтакта = ВидКонтакта;
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.ОбращенияКлиентов;
			ЗаписьВзаимодействия.Менеджер = стр.Исполнитель;
			ЗаписьВзаимодействия.ИсточникСобытия = Источник.Ссылка;
			ЗаписьВзаимодействия.Примечание = Стр.Описание;
			
			Набор.Записать(Истина);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.Renault_CRM_ОбращениеВАвтоСервис") тогда
		
		Если ТипЗнч(Источник.Клиент) <> Тип("СправочникСсылка.Контрагенты") 
			И ТипЗнч(Источник.Клиент) <> Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
			Возврат;
		КонецЕсли;
		
		Если Источник.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.Ошибка тогда
			Возврат;
		КонецЕсли;
			
			ИД = Строка(Источник.Ссылка.УникальныйИДентификатор());
			
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(Источник.Клиент);
			Набор.Отбор.ИД.Установить(ИД);
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.Сервис);
			Набор.Отбор.Направление.Установить(Перечисления.ТипыСообщений.Входящее);
			
			ЗаписьВзаимодействия = Набор.Добавить();
			
			ЗаписьВзаимодействия.ИД = ИД;
			ЗаписьВзаимодействия.Клиент = Источник.Клиент;
			ЗаписьВзаимодействия.Направление = Перечисления.ТипыСообщений.Входящее;
			ЗаписьВзаимодействия.ДатаСобытия = Источник.Дата;
			ЗаписьВзаимодействия.ДатаПланируемая = Источник.Дата;
			ЗаписьВзаимодействия.Период = ЗаписьВзаимодействия.ДатаСобытия;
			ЗаписьВзаимодействия.Событие = Источник.ВидОбращения; 
			ЗаписьВзаимодействия.ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.ПосещениеСалона;
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.Сервис;
			ЗаписьВзаимодействия.Менеджер = Источник.Менеджер.Сотрудник;
			ЗаписьВзаимодействия.ИсточникСобытия = Источник.Ссылка;
			ЗаписьВзаимодействия.Результат = ?(Источник.ОбращениеОбработано,"Обращение обработано","");
			ЗаписьВзаимодействия.Примечание = Источник.Примечание;
			
			Набор.Записать(Истина);
			
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.Renault_КонтактСКлиентом") тогда
		
		Если ТипЗнч(Источник.Контрагент) <> Тип("СправочникСсылка.Контрагенты") тогда
			Возврат;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Источник.ВидКонтакта) тогда
			Возврат;
		КонецЕсли;
				
			
			ПланируемаяДатаКонтакта = Макс(Источник.Дата,Источник.ПлановаяДата,Источник.ОбещаннаяДатаКонтакта);
			//ДатаВыполненияКонтакта = Макс(Источник.ДатаВыполненияКонтакта,Источник.ДатаКонтакта);
			
			ИД = Строка(Источник.Ссылка.УникальныйИДентификатор());
			
			Набор = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьНаборЗаписей();
			Набор.Отбор.Клиент.Установить(Источник.Контрагент);
			Набор.Отбор.ИД.Установить(ИД);
			Набор.Отбор.Подсистема.Установить(Справочники.DMS_Подсистемы.КонтактыСКлиентом);
			Набор.Отбор.Направление.Установить(Перечисления.ТипыСообщений.Исходящее);
			
			Если ЗначениеЗаполнено(Источник.КонтактПереемник) тогда   // контакт объединился с другим контактом.
				Набор.Очистить();
				Набор.Записать(Истина);
				Возврат;
			КонецЕсли;

			РезультатКонтакта = Источник.ТекстРассылки;
			Если Источник.РезультатыКонтакта.Количество()>0 Тогда
				РезультатКонтакта = Строка(Источник.РезультатыКонтакта.Получить(Источник.РезультатыКонтакта.Количество()-1).Результат);	
			КонецЕсли;

			ЗаписьВзаимодействия = Набор.Добавить();
			
			ЗаписьВзаимодействия.ИД = ИД;
			ЗаписьВзаимодействия.Клиент = Источник.Контрагент;
			ЗаписьВзаимодействия.Направление = Перечисления.ТипыСообщений.Исходящее;
			ЗаписьВзаимодействия.ДатаСобытия = Источник.ДатаВыполненияКонтакта;
			ЗаписьВзаимодействия.ДатаПланируемая = ПланируемаяДатаКонтакта; 
			ЗаписьВзаимодействия.Период = ?(ЗначениеЗаполнено(ЗаписьВзаимодействия.ДатаСобытия),ЗаписьВзаимодействия.ДатаСобытия,ЗаписьВзаимодействия.ДатаПланируемая);
			ЗаписьВзаимодействия.Событие = Источник.Кампания; 
			ЗаписьВзаимодействия.ВидКонтакта = Источник.ВидКонтакта;//Перечисления.Renault_ВидыКонтактаКампаний.Прочее;
			ЗаписьВзаимодействия.Подсистема = Справочники.DMS_Подсистемы.КонтактыСКлиентом;
			ЗаписьВзаимодействия.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
			ЗаписьВзаимодействия.ИсточникСобытия = Источник.Ссылка;
			ЗаписьВзаимодействия.Результат = ?(Источник.КонтактВыполнен,"Контакт выполнен",РезультатКонтакта);
			ЗаписьВзаимодействия.Примечание = РезультатКонтакта;
			ЗаписьВзаимодействия.SMS_ID = Источник.SMS_ID;
			
			Набор.Записать(Истина);
		
			
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиКлиентаПоПочте(ПочтаКлиента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_НормализованныеКонтактыДляПоиска.Объект
	|ИЗ
	|	РегистрСведений.Renault_НормализованныеКонтактыДляПоиска КАК Renault_НормализованныеКонтактыДляПоиска
	|ГДЕ
	|	Renault_НормализованныеКонтактыДляПоиска.Данные = &ПочтаКлиента
	|	И (Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.CRM_ПотенциальныеКонтрагенты
	|			ИЛИ Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.Контрагенты)";
	
	Запрос.УстановитьПараметр("ПочтаКлиента", ПочтаКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Объект;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаполнитьДатыПрочтенияКонтактов(Параметр1 = Неопределено) Экспорт
	
	Попытка 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КонтактСКлиентом.Ссылка,
		|	Renault_КонтактСКлиентом.EMail,
		|	Renault_КонтактСКлиентом.Кампания.Код КАК Код,
		|	Renault_BIR_db.Значение КАК BIR,
		|	НачалоПериода(Renault_КонтактСКлиентом.ДатаВыполненияКонтакта,День) КАК Дата
		|ИЗ
		|	Документ.Renault_КонтактСКлиентом КАК Renault_КонтактСКлиентом,
		|	Константа.Renault_BIR_db КАК Renault_BIR_db
		|ГДЕ
		|	Renault_КонтактСКлиентом.ДатаВыполненияКонтакта >= ДОБАВИТЬКДАТЕ(&ТекДата, МЕСЯЦ, -1)
		|	И Renault_КонтактСКлиентом.ДатаПрочтенияПисьма = ДАТАВРЕМЯ(1, 1, 1)
		|	И Renault_КонтактСКлиентом.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.Renault_ВидыКонтактаКампаний.Email)
		|	И Renault_КонтактСКлиентом.ДатаВыполненияКонтакта <> ДАТАВРЕМЯ(1, 1, 1)
		|	И Renault_КонтактСКлиентом.КонтактВыполнен = ИСТИНА";
		
		Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		РезультатЗапроса.Индексы.Добавить("Email,Код,BIR,Дата");
		ТаблицаОтправки = РезультатЗапроса.Скопировать(,"Email,Код,BIR,Дата");
		
		Настройки = Renault_ОбщиеФункцииСервер.ПолучитьНастройкиПодключенияПоБренду(ПараметрыСеанса.DMS_Бренд);
	    ТелоЗапроса = Renault_ОбщиеФункцииСервер.ПолучитьСтрокуJSONИзXDTO(СериализаторXDTO.ЗаписатьXDTO(ТаблицаОтправки));
		HTTPЗапрос = Новый HTTPЗапрос();
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
		HTTPЗапрос.АдресРесурса = Настройки.Адрес2 + "/hs/Campaigns/SendMailReadDate";
		Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,Настройки.ЗащищенноеСоединениеOpenSSL);
	                
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);

		ТаблицаОтвет = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());	

		Если ТаблицаОтвет.Количество()=0 Тогда
			Возврат;
		КонецЕсли;
		
		Для каждого Стр из ТаблицаОтвет Цикл
			
			Отбор = Новый Структура("Email,Код,BIR,Дата",Стр.Email,Стр.Код,Стр.BIR,Стр.Дата);
			НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
			Для каждого НСтр из НайденныеСтроки Цикл
				Док = НСтр.Ссылка.ПолучитьОбъект();
				Док.ДатаПрочтенияПисьма = Стр.ДатаПрочтения;
				Док.Записать();
				Сообщить(Док.Ссылка);
			КонецЦикла;
		КонецЦикла;
		
		РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
		ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ЗаполнениеДатыПрочтенияПисем"),
		ТекущаяДатаСеанса());
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьГрупповуюРассылкуПисем(Параметр1 = Неопределено) Экспорт
	
	Попытка 
		
		Заголовок = Константы.DMS_ШаблонЗаголовкаПисьма.Получить();	
		
		ВебСервис = ПолучитьВебСервисКампании();
		
		BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
		
		ИдентификаторДилера = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
		
		ТаблицаСообщений = Новый ТаблицаЗначений;
		ТаблицаСообщений.Колонки.Добавить("Получатели");
		ТаблицаСообщений.Колонки.Добавить("ТекстСообщения");
		ТаблицаСообщений.Колонки.Добавить("BIR");
		ТаблицаСообщений.Колонки.Добавить("ТипТекстаСообщения");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Renault_КонтактСКлиентом.Ссылка КАК Контакт,
		|	Renault_КонтактСКлиентом.EMail,
		|	Renault_КонтактСКлиентом.ТекстРассылки,
		|	Renault_КонтактСКлиентом.Кампания
		|ИЗ
		|	Документ.Renault_КонтактСКлиентом КАК Renault_КонтактСКлиентом
		|ГДЕ
		|	Renault_КонтактСКлиентом.Кампания.Активная = ИСТИНА
		|	И Renault_КонтактСКлиентом.Кампания.Архивная = ЛОЖЬ
		|	И Renault_КонтактСКлиентом.КонтактВыполнен = ЛОЖЬ
		|	И Renault_КонтактСКлиентом.ПлановаяДата <= &ТекущаяДата
		|	И Renault_КонтактСКлиентом.ВидКонтакта = &ВидКонтакта";
		
		
		Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("ВидКонтакта",Перечисления.Renault_ВидыКонтактаКампаний.email);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ТаблицаСообщений.Очистить();
			
			НоваяСтрока = ТаблицаСообщений.Добавить();
			НоваяСтрока.BIR = BIR;
			ТекстРассылки = Выборка.Кампания.ТекстРассылки;
			ЗаголовокПисьма = Заголовок;
			Для Каждого СтрокаЗначений ИЗ Выборка.Контакт.ОснованиеДляКонтакта_Значения Цикл
				Тег = "<" + СтрокаЗначений.ИмяКолонки + ">";
				ТекстРассылки = СтрЗаменить(ТекстРассылки, Тег, Строка(СтрокаЗначений.Значение));
				ЗаголовокПисьма = СтрЗаменить(ЗаголовокПисьма, Тег, Строка(СтрокаЗначений.Значение));
			КонецЦикла;
			
			НоваяСтрока.ТипТекстаСообщения = "HTML";
			СсылкаНаКартинку = " <IMG src=""http://app.renault.ru/pixel.php?subid="+ Выборка.Email + "&campaign=" + Выборка.Кампания.Код+ "&bir="+BIR+""">";
			НоваяСтрока.ТекстСообщения = ЗаголовокПисьма  + Символы.ПС + ТекстРассылки +СсылкаНаКартинку;
			Получатели = Новый ТаблицаЗначений;
			Получатели.Колонки.Добавить("Адрес");
			ПочтаКлиента = Выборка.Email;
			Если ПочтаКлиента = "" Тогда
				Продолжить;
			КонецЕсли;
			СтрокаПолучатели = Получатели.Добавить();
			СтрокаПолучатели.Адрес = ПочтаКлиента;
			НоваяСтрока.Получатели = Получатели;
			
			Если ВыполнитьРассылкуПисем(ТаблицаСообщений) = Неопределено тогда
				
				ВебСервис.GetReadDate(Выборка.Email,Выборка.Кампания.Код,Выборка.ИдентификаторДилера,2); //зафиксируем отправку письма в центральной базе.
				
				ДокОбъект = Выборка.Контакт.ПолучитьОбъект();
				ДокОбъект.КонтактВыполнен = Истина;
				ДокОбъект.ДатаВыполненияКонтакта = ТекущаяДата();
				ДокОбъект.Результат = Справочники.Renault_РезультатыКампаний.ОтправленоПисьмо;
				
				НоваяСтрока = ДокОбъект.РезультатыКонтакта.Добавить();
				НоваяСтрока.Результат = Справочники.Renault_РезультатыКампаний.ОтправленоСМС;
				НоваяСтрока.ПользовательКтоВнесРезультат = ПараметрыСеанса.Пользователь;
				НоваяСтрока.ДатаВыполнения = ТекущаяДата();
				
				ДокОбъект.Записать();
			Иначе
				Сообщить("Письмо на адрес " + Выборка.Email +  " не отправлено");
			КонецЕсли;
		КонецЦикла;
		
		РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
		ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ВыполнитьГрупповуюРассылкуПисем"),
		ТекущаяДатаСеанса());
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьГрупповуюРассылкуСМС(Параметр1 = Неопределено) Экспорт
	
	Заголовок = Константы.DMS_ШаблонЗаголовкаСМС.Получить();
	
	Попытка
		ВебСервис = ПолучитьВебСервисКампании();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	
	ТаблицаСообщений = Новый ТаблицаЗначений;
	ТаблицаСообщений.Колонки.Добавить("Получатели");
	ТаблицаСообщений.Колонки.Добавить("ТекстСообщения");
	ТаблицаСообщений.Колонки.Добавить("BIR");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_КонтактСКлиентом.Ссылка КАК Контакт,
	|	Renault_КонтактСКлиентом.Телефон,
	|	Renault_КонтактСКлиентом.ТекстРассылки,
	|	Renault_КонтактСКлиентом.Кампания
	|ИЗ
	|	Документ.Renault_КонтактСКлиентом КАК Renault_КонтактСКлиентом
	|ГДЕ
	|	Renault_КонтактСКлиентом.Кампания.Активная = ИСТИНА
	|	И Renault_КонтактСКлиентом.Кампания.Архивная = ЛОЖЬ
	|	И Renault_КонтактСКлиентом.КонтактВыполнен = ЛОЖЬ
	|	И Renault_КонтактСКлиентом.ПлановаяДата <= &ТекущаяДата
	|	И Renault_КонтактСКлиентом.ВидКонтакта = &ВидКонтакта
	|ИТОГИ ПО
	|	Renault_КонтактСКлиентом.Кампания";
	
	Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ВидКонтакта",Перечисления.Renault_ВидыКонтактаКампаний.СМС);
	
	ВыборкаКампании = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКампании.Следующий() Цикл
		
		КампанияОдобрена = Истина;
		ПроверятьКампанию = Истина;
		ИдентификаторСообщения = "";
		
		Выборка = ВыборкаКампании.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ТекстРассылки = ВыборкаКампании.Кампания.ТекстРассылки;
			
			Если ПроверятьКампанию = Истина Тогда
				
				ТекстДляПроверки = ТекстРассылки;
				// получим текст первой смс для порверки
				Для Каждого СтрокаЗначений ИЗ Выборка.Контакт.ОснованиеДляКонтакта_Значения Цикл
					Тег = "<" + СтрокаЗначений.ИмяКолонки + ">";
					ТекстДляПроверки = СтрЗаменить(ТекстДляПроверки, Тег, Строка(СтрокаЗначений.Значение));
					Заголовок = СтрЗаменить(Заголовок, Тег, Строка(СтрокаЗначений.Значение));
				КонецЦикла;
				ФормаПроверки = ПолучитьОбщуюФорму("Renault_ФормаОтправкиСообщенийКлиенту");
				ФормаПроверки.ТекстСообщения = ТекстДляПроверки;
				ФормаПроверки.Заголовок = "Подтвердите рассылку смс по кампании";
				//ФормаПроверки.Заголовок = "Подтвердите рассылку смс по кампании " + Выборка.Кампания.Наименование; //Андрианова 10.02.2017
				Список = Новый СписокЗначений;
				Список.Добавить("ОткрытьВторуюСтраницу");
				ФормаПроверки.СписокПараметров = Список;
				КампанияОдобрена = ФормаПроверки.ОткрытьМодально();
				
				Если КампанияОдобрена <> Истина Тогда
					Прервать;
				КонецЕсли;
				ПроверятьКампанию = Ложь;
				
			КонецЕсли;
			
			ТаблицаСообщений.Очистить();
			
			НоваяСтрока = ТаблицаСообщений.Добавить();
			
			НоваяСтрока.BIR = BIR;
			ТекстРассылки = Выборка.Кампания.ТекстРассылки;
			Для Каждого СтрокаЗначений ИЗ Выборка.Контакт.ОснованиеДляКонтакта_Значения Цикл
				Тег = "<" + СтрокаЗначений.ИмяКолонки + ">";
				ТекстРассылки = СтрЗаменить(ТекстРассылки, Тег, Строка(СтрокаЗначений.Значение));
				Заголовок = СтрЗаменить(Заголовок, Тег, Строка(СтрокаЗначений.Значение));
				
			КонецЦикла;
			НоваяСтрока.ТекстСообщения = Заголовок + " " + ТекстРассылки;
			Получатели = Новый ТаблицаЗначений;
			Получатели.Колонки.Добавить("Телефон");
			ТелефонКлиента = РегистрыСведений.Renault_НормализованныеКонтактыДляПоиска.НормализоватьНомерТелефона(Выборка.Телефон);
			Если ТелефонКлиента = "" Тогда
				Продолжить;
			КонецЕсли;
			СтрокаПолучатели = Получатели.Добавить();
			СтрокаПолучатели.Телефон = ?(Лев(ТелефонКлиента,1) ="9","7"+ТелефонКлиента,ТелефонКлиента);
			НоваяСтрока.Получатели = Получатели;
			
			Ответ = ВыполнитьРассылкуСМС(ТаблицаСообщений);
			
			Для Каждого Строка ИЗ Ответ Цикл
				СтруктураРезультата = Строка.Результат;
				МассивСтруктурРезультата = СтруктураРезультата.ОтправленныеСообщения;
				Для Каждого СтруктураРезультата ИЗ МассивСтруктурРезультата Цикл
					ИдентификаторСообщения = СтруктураРезультата.ИдентификаторСообщения;
				КонецЦикла;
			КонецЦикла;
			
			ДокОбъект = Выборка.Контакт.ПолучитьОбъект();
			ДокОбъект.КонтактВыполнен = Истина;
			ДокОбъект.ДатаВыполненияКонтакта = ТекущаяДата();
			ДокОбъект.Результат = Справочники.Renault_РезультатыКампаний.ОтправленоСМС;
			ДокОбъект.SMS_ID = ИдентификаторСообщения;
			
			НоваяСтрока = ДокОбъект.РезультатыКонтакта.Добавить();
			НоваяСтрока.Результат = Справочники.Renault_РезультатыКампаний.ОтправленоСМС;
			НоваяСтрока.ПользовательКтоВнесРезультат = ПараметрыСеанса.Пользователь;
			НоваяСтрока.ДатаВыполнения = ТекущаяДата();
			
			ДокОбъект.Записать();
			
			ИдентификаторСообщения = "";
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВебСервисКампании() Экспорт
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	АдресWS = СокрЛП(Настройки.АдресWsGate+"ws/DMS_Campaigns.ws?wsdl");
	ЛогинWS = СокрЛП(Настройки.ЛогинДоступаКВебСервисам);
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	
	Определение = Новый WSОпределения(АдресWS,ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(Определение, Определение.Сервисы[0].URIПространстваИмен,Определение.Сервисы[0].Имя,Определение.Сервисы[0].ТочкиПодключения[0].Имя);       
	
	ВебСервис.Пользователь = ЛогинWS;
	ВебСервис.Пароль = ПарольWS;
	
	Возврат ВебСервис;
	
КонецФункции

Функция ПолучитьВебСервисКарточки() Экспорт
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	АдресWS = Настройки.АдресWsGate+"ws/DMS_Cards.1cws?wsdl";
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	Определение = Новый WSОпределения(АдресWS,ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(Определение, 
	"http://v8.1c.ru/8.1/data/core",Определение.Сервисы[0].Имя,Определение.Сервисы[0].ТочкиПодключения[0].Имя);       
	
	ВебСервис.Пользователь = ЛогинWS;
	ВебСервис.Пароль = ПарольWS;
	
	Возврат ВебСервис;
КонецФункции

Процедура DMS_ВыгрузкаПользователяВЦБПриЗаписи(Источник, Отказ) Экспорт
	// Семенихин 18.07.2024 +++++
	Возврат;
	// Семенихин 18.07.2024 -----
     	
	Если Источник.ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Источник.Ссылка);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("DMS_ВзаимодействияСКлиентом.ВыгрузкаПользователяВЦБ",МассивОбъектов);
			
КонецПроцедуры

Процедура ВыгрузкаПользователяВЦБ(Объект) Экспорт
	
	 Попытка
		Если ТипЗнч(Объект) =  Тип("СправочникСсылка.Пользователи") тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Пользователи.Ссылка,
			|	Пользователи.Наименование,
			|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки
			|ИЗ
			|	Справочник.Пользователи КАК Пользователи
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
			|		ПО (Renault_ПользователиИШаблоныПравИНастроек.Пользователь = Пользователи.Ссылка)
			|ГДЕ
			|	//НЕ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки ЕСТЬ NULL 
			|	Пользователи.Ссылка = &Ссылка";
			
			Запрос.УстановитьПараметр("Ссылка",Объект);
			
			Выборка = Запрос.Выполнить().Выбрать();
				
		ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.Renault_ПраваИНастройкиПользователей") тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Пользователи.Ссылка,
			|	Пользователи.Наименование,
			|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки
			|ИЗ
			|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
			|		ПО Renault_ПользователиИШаблоныПравИНастроек.Пользователь = Пользователи.Ссылка
			|ГДЕ
			|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки = &ПраваИНастройки";
			
			Запрос.УстановитьПараметр("ПраваИНастройки",Объект);
			
			Выборка = Запрос.Выполнить().Выбрать();
		Иначе
			ВызватьИсключение "Не верный тип источника подписки на событие";
		КонецЕсли;
		
		Если Выборка.Количество()=0 тогда
			Возврат;
		КонецЕсли;
		
		Пользователи = Новый СписокЗначений;
		ВебСервис = DMS_ВзаимодействияСКлиентом.ПолучитьВебСервисКампании();
		
		BIR = Константы.Renault_BIR_db.Получить();
		
		// НАЧАЛО DMSCOR-1137 28.02.2019
		Попытка
			МассивПользователейИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
		Исключение
			МассивПользователейИБ = Новый Массив(); 
			//МассивПользователейИБ.Добавить(ПользователиИнформационнойБазы.ТекущийПользователь());;
			МассивПользователейИБ.Добавить(ПараметрыСеанса.Пользователь);
		КонецПопытки;
		// КОНЕЦ DMSCOR-1137 28.02.2019
		
		Пока Выборка.Следующий() Цикл
			
			ОписаниеРолей= "";           
			Для каждого Эл из МассивПользователейИБ Цикл
				Если Эл.ПолноеИмя = Выборка.Ссылка.Наименование тогда
					ОписаниеРолей = "Доступные роли:";
					Для каждого Роль из Эл.Роли цикл
						ОписаниеРолей = ОписаниеРолей  + Символы.ПС +  Роль.Имя;
					КонецЦикла;
				КонецЕсли;	
			КонецЦикла;
			
			Если ЗначениеЗаполнено(Выборка.ПраваИНастройки) Тогда
				ОписаниеПрав = "Шаблон прав: " +    Выборка.ПраваИНастройки.Наименование;
				Для каждого Рек из Метаданные.Справочники.Renault_ПраваИНастройкиПользователей.Реквизиты Цикл
					Если Строка(Рек.Тип) = "Строка" или Строка(Рек.Тип) = "Число" или Строка(Рек.Тип) = "Булево" или Строка(Рек.Тип) = "Дата" ИЛИ Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Рек.Тип.ПривестиЗначение())) Тогда
						ОписаниеПрав = ОписаниеПрав  +Символы.ПС+  Рек.Синоним + ": " + Строка(Выборка.ПраваИНастройки[Рек.Имя]);
					Иначе
						ОписаниеПрав = ОписаниеПрав  +Символы.ПС+  Рек.Синоним + ": " + ?(ЗначениеЗаполнено(Выборка.ПраваИНастройки[Рек.Имя]), Строка(Выборка.ПраваИНастройки[Рек.Имя].Наименование), "");
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				ОписаниеПрав = "Не указан шаблон прав";
			КонецЕсли;
			
			стрПользователь = Новый Структура;
			стрПользователь.Вставить("Наименование", Выборка.Наименование);
			стрПользователь.Вставить("ВнешнийУИД", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			стрПользователь.Вставить("BIR", BIR);
			стрПользователь.Вставить("Наименование", Выборка.Наименование);
			стрПользователь.Вставить("ОписаниеПрав", ОписаниеПрав);
			стрПользователь.Вставить("ОписаниеРолей", ОписаниеРолей);
			стрПользователь.Вставить("ПометкаУдаления",Выборка.Ссылка.ПометкаУдаления);
			Если ЗначениеЗаполнено(Выборка.ПраваИНастройки) Тогда
				Если ЗначениеЗаполнено(Выборка.ПраваИНастройки.ДилерскийЦентр) Тогда
					стрПользователь.Вставить("BIR_LMT",Выборка.ПраваИНастройки.ДилерскийЦентр.Бир_ЛМТ);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.Ссылка.Сотрудник) Тогда
				НаборКонтактнойИнформации = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
				киПрочитатьКонтактнуюИнформацию(НаборКонтактнойИнформации, Выборка.Ссылка.Сотрудник);
				ТабКИ = Новый ТаблицаЗначений;
				ТабКИ.Колонки.Добавить("Тип");
				ТабКИ.Колонки.Добавить("Вид");
				ТабКИ.Колонки.Добавить("Представление");
				ТабКИ.Колонки.Добавить("ЗначениеПоУмолчанию");
				Для Каждого Запись ИЗ НаборКонтактнойИнформации Цикл
					НовСтр = ТабКИ.Добавить();
					НовСтр.Тип = Строка(Запись.Тип);
					НовСтр.Вид = Запись.Вид.Наименование;
					НовСтр.Представление = Запись.Представление;
					НовСтр.ЗначениеПоУмолчанию = Запись.ЗначениеПоУмолчанию;
				КонецЦикла;
				стрПользователь.Вставить("КонтактнаяИнформация", ТабКИ);
			КонецЕсли;
			
			Пользователи.Добавить(стрПользователь);
			
		КонецЦикла;
		
		Ответ = ВебСервис.LoadUsers(СериализаторXDTO.ЗаписатьXDTO(Пользователи));
	Исключение
		ЗаписьЖурналаРегистрации("Выгрузка пользователя в ЦБ",УровеньЖурналаРегистрации.Ошибка,Объект.Метаданные(), Объект,ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры

Функция ПодготовитьРезультатыДляВыгрузки(Сценарий) Экспорт
	
	ТаблицаРезультатов = Новый ТаблицаЗначений;
	
	Если Сценарий = Справочники.Renault_СценарийКампании.ПустаяСсылка() тогда
		Возврат ТаблицаРезультатов;
	КонецЕсли;

	Для Каждого Рек из Справочники.Renault_РезультатыКампаний.ПустаяСсылка().Метаданные().Реквизиты цикл
		Если  Строка(Рек.Тип) = "Строка" тогда
			Тип = Новый ОписаниеТипов("Строка",,,,Рек.Тип.КвалификаторыСтроки);
			ТаблицаРезультатов.Колонки.Добавить(Рек.Имя,Тип);
		Иначе
			ТаблицаРезультатов.Колонки.Добавить(Рек.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРезультатов.Колонки.Добавить("BIR",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(9)));
	ТаблицаРезультатов.Колонки.Добавить("УИД",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаРезультатов.Колонки.Добавить("Наименование",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));	
	
	BIR = Константы.Renault_BIR_db.Получить();
	
	//Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ Справочник.Renault_РезультатыКампаний КАК Renault_РезультатыКампаний");
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_СценарийКампанииТелоСценария.Результат КАК Результат
		|ИЗ
		|	Справочник.Renault_СценарийКампании.ТелоСценария КАК Renault_СценарийКампанииТелоСценария
		|ГДЕ
		|	Renault_СценарийКампанииТелоСценария.Ссылка <> ЗНАЧЕНИЕ(Справочник.Renault_РезультатыКампаний.ПустаяСсылка)
		|	И Renault_СценарийКампанииТелоСценария.Ссылка = &Сценарий";
	
	Запрос.УстановитьПараметр("Сценарий", Сценарий);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НовСтр = ТаблицаРезультатов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Выборка.Результат,,"Атрибут,Действие");
		НовСтр.Действие = Строка(Выборка.Результат.Действие); 
		НовСтр.Атрибут = Строка(Выборка.Результат.Атрибут);
		НовСтр.BIR = BIR;
		НовСтр.УИД = Строка(Выборка.Результат.УникальныйИдентификатор());
		НовСтр.Наименование = Выборка.Результат.Наименование;
	КонецЦикла;

	Возврат ТаблицаРезультатов;
	
КонецФункции

Функция ПодготовитьСценарииДляВыгрузки(Сценарий) Экспорт
	
	ТаблицаРезультатов = Новый ТаблицаЗначений;
	
	Если Сценарий = Справочники.Renault_СценарийКампании.ПустаяСсылка() тогда
		Возврат ТаблицаРезультатов;
	КонецЕсли;
	
	
	Для Каждого Рек из Справочники.Renault_СценарийКампании.ПустаяСсылка().Метаданные().ТабличныеЧасти.ТелоСценария.Реквизиты цикл
		
		Если Рек.Имя = "Результат" тогда
			Продолжить;
		КонецЕсли;
		Если  Строка(Рек.Тип) = "Строка" тогда
			Тип = Новый ОписаниеТипов("Строка",,,,Рек.Тип.КвалификаторыСтроки);
			ТаблицаРезультатов.Колонки.Добавить(Рек.Имя,Тип);
		Иначе
			ТаблицаРезультатов.Колонки.Добавить(Рек.Имя);
		КонецЕсли;
	КонецЦикла;
	
	
	ТаблицаРезультатов.Колонки.Добавить("BIR",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(9)));
	ТаблицаРезультатов.Колонки.Добавить("УИД",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаРезультатов.Колонки.Добавить("Результат",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаРезультатов.Колонки.Добавить("Наименование",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	
	BIR = Константы.Renault_BIR_db.Получить();
	
	Для каждого СтрТЧ из Сценарий.ТелоСценария цикл
		НовСтр = ТаблицаРезультатов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ,,"Результат");
		НовСтр.Результат = ?(ЗначениеЗаполнено(СтрТЧ.Результат),Строка(СтрТЧ.Результат.УникальныйИдентификатор()),"");
		НовСтр.BIR = BIR;
		НовСтр.УИД = Строка(Сценарий.УникальныйИдентификатор());
		НовСтр.Наименование = Сценарий.Наименование;
	КонецЦикла;

	Возврат ТаблицаРезультатов;
	
КонецФункции

Функция ПодготовитьКампаниюДляВыгрузки(Кампания) Экспорт
	
	КампанияСтруктура = Новый Структура;
	
	Если Кампания = Справочники.Renault_Кампании.ПустаяСсылка() тогда
		Возврат КампанияСтруктура;
	КонецЕсли;
		
	BIR = Константы.Renault_BIR_db.Получить();
	
	Отбор = Новый ТаблицаЗначений;
	Отбор.Колонки.Добавить("ЛевоеЗначение");
	Отбор.Колонки.Добавить("ВидСравнения");
	Отбор.Колонки.Добавить("ПравоеЗначение");
	
	ВыбранныеПоля = Новый ХранилищеЗначения(Неопределено);
		
	НастрокиОтбора = Кампания.НастройкиОтбора.Получить();
	НастройкиДополнительные = Кампания.НастройкиДополнительные.Получить();		
	//оставим настройки кампании, которые не пересекаются с централизованными настройками.
	Если ТипЗнч(НастрокиОтбора) =  Тип("НастройкиКомпоновкиДанных") тогда
		Для каждого СтрОтбора из НастрокиОтбора.Отбор.Элементы цикл
			Добавить = Истина;
			Если ТипЗнч(НастройкиДополнительные) =  Тип("НастройкиКомпоновкиДанных") тогда
				//поищем отбор среди централизованных настроек отбора.
				Для каждого ЭлементОтбораФиксНастроек из НастройкиДополнительные.Отбор.Элементы Цикл
					Если СтрОтбора.ЛевоеЗначение = ЭлементОтбораФиксНастроек.ЛевоеЗначение тогда 
						//если нашли, то не добавляем в основной отбор
						Добавить = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

			Если Добавить тогда
				НовОтбор = Отбор.Добавить();
				НовОтбор.ЛевоеЗначение = Строка(СтрОтбора.ЛевоеЗначение);
				НовОтбор.ВидСравнения = Строка(СтрОтбора.ВидСравнения);
				Если СтрОтбора.ВидСравнения = ВидСравнения.ВСписке тогда
					Для каждого ЭлементСписка из СтрОтбора.ПравоеЗначение цикл
						НовОтбор.ПравоеЗначение = НовОтбор.ПравоеЗначение + ", " +Строка(ЭлементСписка.Значение);
					КонецЦикла;
				Иначе
					НовОтбор.ПравоеЗначение = Строка(СтрОтбора.ПравоеЗначение);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ВыбПоля = Новый ТаблицаЗначений; 
		ВыбПоля.Колонки.Добавить("Заголовок");
		ВыбПоля.Колонки.Добавить("Использование");
		ВыбПоля.Колонки.Добавить("Поле");
		ВыбПоля.Колонки.Добавить("РежимОтображения");
		ВыбПоля.Колонки.Добавить("Родитель");
		
		Для каждого СтрПолейВыбора из НастрокиОтбора.Выбор.Элементы цикл
			ЗаполнитьЗначенияСвойств(ВыбПоля.Добавить(),СтрПолейВыбора);
		КонецЦикла;
		
		ВыбранныеПоля = Новый ХранилищеЗначения(ВыбПоля);	
		
	КонецЕсли;

	
	
	КампанияСтруктура.Вставить("BIR",BIR);
	КампанияСтруктура.Вставить("УИД",Строка(Кампания.Ссылка.УникальныйИдентификатор()));
	КампанияСтруктура.Вставить("Наименование",Кампания.Наименование);
	КампанияСтруктура.Вставить("Сценарий",?(ЗначениеЗаполнено(Кампания.Сценарий),Строка(Кампания.Сценарий.УникальныйИдентификатор()),""));
	КампанияСтруктура.Вставить("НастройкиОтбора",Отбор);
	КампанияСтруктура.Вставить("НастройкиДополнительные",Кампания.Ссылка.НастройкиДополнительные);
	КампанияСтруктура.Вставить("Цели",Кампания.Цели);
	КампанияСтруктура.Вставить("ВидКонтакта",Строка(Кампания.ВидКонтакта));
	КампанияСтруктура.Вставить("Приоритет",Строка(Кампания.Приоритет));
	КампанияСтруктура.Вставить("ТипСообщения",Строка(Кампания.ТипСообщения));
	КампанияСтруктура.Вставить("РазоваяКампания",Кампания.РазоваяКампания);
	КампанияСтруктура.Вставить("ДатаНачалаАктивности",Кампания.ДатаНачалаАктивности);
	КампанияСтруктура.Вставить("ДатаОкончанияАктивности",Кампания.ДатаОкончанияАктивности);
	КампанияСтруктура.Вставить("ДатаНачалаВыполнения",Кампания.ДатаНачалаВыполнения);
	КампанияСтруктура.Вставить("ДатаОкончанияВыполнения",Кампания.ДатаОкончанияВыполнения);
	КампанияСтруктура.Вставить("ТекстРассылки",Кампания.ТекстРассылки);
	КампанияСтруктура.Вставить("ФлРазоваяКампания",Кампания.ФлРазоваяКампания);
	КампанияСтруктура.Вставить("РазоваяКампания",Кампания.РазоваяКампания);
	КампанияСтруктура.Вставить("ДнейНаОбзвон",Кампания.ДнейНаОбзвон);
	КампанияСтруктура.Вставить("Комментарий",Кампания.Комментарий);	
	КампанияСтруктура.Вставить("Статус",Строка(Кампания.Статус));
	КампанияСтруктура.Вставить("Активная",Кампания.Активная);
	КампанияСтруктура.Вставить("Архивная",Кампания.Архивная);
	КампанияСтруктура.Вставить("ВыбранныеПоля",ВыбранныеПоля);

	Возврат КампанияСтруктура;
	
КонецФункции

