Процедура ЗаписатьФактОтправкиСМСАвтосервис(Клиент, Обращение, Текст, Дата, Автор, ИдентификаторСообщения = "") Экспорт
	
	Запись = РегистрыСведений.DMS_ЖурналВзаимодействий.СоздатьМенеджерЗаписи();
	
	Запись.Период = ТекущаяДата();
	Запись.Клиент = Клиент;
	Запись.ИД = Строка(Обращение.Ссылка.УникальныйИдентификатор()) + Строка(ТекущаяДата());
	Запись.Подсистема = Справочники.DMS_Подсистемы.Сервис;
	Запись.Направление = Перечисления.ТипыСообщений.Исходящее;
	Запись.ДатаСобытия = Дата;
	Запись.ДатаПланируемая = Дата;
	Запись.ВидКонтакта = Перечисления.Renault_ВидыКонтактаКампаний.СМС; 
	Запись.Событие = Обращение.ВидОбращения;
	Запись.Результат =  Текст;
	Запись.ИсточникСобытия = Обращение;
	Запись.Менеджер = Автор;
	Запись.SMS_ID = ИдентификаторСообщения;
	Запись.Записать();
	
КонецПроцедуры

Функция ПолучитьСМСПоИсточнику(Источник) Экспорт
	
