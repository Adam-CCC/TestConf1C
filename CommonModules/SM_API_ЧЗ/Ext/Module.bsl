// ========================================================
// ПОЛУЧЕНИЕ ОТПЕЧАТКА СЕРТИФИКАТА
// ========================================================

Функция ПолучитьОтпечатокСертификата() Экспорт

Список = Новый СписокЗначений;

Попытка
	oStore = Новый COMОбъект("CAdESCOM.Store");
	oStore.Open(2,"My",0);
	
	Для Каждого Сертификат Из oStore.Certificates Цикл
		Если Сертификат.HasPrivateKey() Тогда
			Отпечаток = ВРег(СтрЗаменить(СтрЗаменить(Сертификат.Thumbprint," ",""),Символ(8206),""));
			Имя = Сертификат.GetInfo(2);
			Список.Добавить(Отпечаток,Имя);
		КонецЕсли;
	КонецЦикла;
	oStore.Close();
Исключение
	Возврат "";
КонецПопытки;
Если Список.Количество() = 0 Тогда
	Возврат "";
КонецЕсли;

Выбор = Список.ВыбратьЭлемент("Выберите сертификат");
Если Выбор = Неопределено Тогда
	Возврат "";
КонецЕсли;

Возврат ВРег(СтрЗаменить(СтрЗаменить(Выбор.Значение," ",""),Символ(8206),""));


КонецФункции

// ========================================================
// ОСНОВНАЯ ПРОЦЕДУРА ПРОВЕРКИ КМ
// ========================================================

Функция ПроверитьКМ(ДокументОбъект) Экспорт

	// Получаем актуальный токен ЧЗ
	Токен = ПолучитьАктуальныйТокенЧЗ(ДокументОбъект);
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не удалось получить токен ЧЗ";
	КонецЕсли;
	// Проверяем коды маркировки
	Возврат ПроверитьКодыМаркировки(ДокументОбъект,Токен);
КонецФункции

// ========================================================
// ПОЛУЧЕНИЕ АКТУАЛЬНОГО ТОКЕНА
// ========================================================

Функция ПолучитьАктуальныйТокенЧЗ(ДокументОбъект) Экспорт
	
	Пользователь = ПараметрыСеанса.Пользователь;
	Организация = ДокументОбъект.Организация;
	НаборЗаписей = РегистрыСведений.SM_API_ЧЗ_Токен.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	ЗаписьТокена = Неопределено;
	
	// ========================================================
	// ИЩЕМ ТОКЕН ТЕКУЩЕГО ПОЛЬЗОВАТЕЛЯ И ОРГАНИЗАЦИИ
	// ========================================================
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.Пользователь = Пользователь
			И Запись.Организация = Организация Тогда
			ЗаписьТокена = Запись;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// ========================================================
	// ВРЕМЕННЫЙ РЕЖИМ
	// ЕСЛИ НЕТ СВОЕГО ТОКЕНА - БЕРЕМ ТОКЕН ДРУГОГО ПОЛЬЗОВАТЕЛЯ
	// НО ТОЛЬКО ДЛЯ ЭТОЙ ЖЕ ОРГАНИЗАЦИИ
	// ========================================================
	Если ЗаписьТокена = Неопределено Тогда
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.Организация = Организация Тогда
				ЗаписьТокена = Запись;
				Сообщить(
				"ВНИМАНИЕ! Используется токен другого пользователя."
				+ Символы.ПС
				+ "Владелец токена: "
				+ Строка(ЗаписьТокена.Пользователь)
				+ Символы.ПС
				+ "Организация: "
				+ Строка(Организация)
				);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// ========================================================
	// ПРОВЕРЯЕМ СУЩЕСТВУЮЩИЙ ТОКЕН
	// ========================================================
	Если ЗаписьТокена <> Неопределено Тогда
		Возраст = ТекущаяДата() - ЗаписьТокена.ДатаПолучения;
		// До 7 часов используем автоматически
		Если Возраст <= 7 * 60 * 60 Тогда
			Возврат ЗаписьТокена.Токен;
		КонецЕсли;
		// От 7 до 10 часов спрашиваем
		Если Возраст <= 10 * 60 * 60 Тогда
			Ответ = Вопрос(
			"Токен старше 7 часов."
			+ Символы.ПС
			+ "Организация: "
			+ Строка(Организация)
			+ Символы.ПС
			+ "Использовать существующий?",
			РежимДиалогаВопрос.ДаНет
			);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Возврат ЗаписьТокена.Токен;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// ========================================================
	// ТОКЕН ОТСУТСТВУЕТ ИЛИ СТАРШЕ 10 ЧАСОВ
	// ПОЛУЧАЕМ НОВЫЙ
	// ========================================================
	НовыйТокен = ПолучитьТокенЧЗ(ДокументОбъект);
	Если ПустаяСтрока(НовыйТокен) Тогда
		ВызватьИсключение "ЧЗ не вернул токен";
	КонецЕсли;
	ЗаписатьТокенЧЗ(Пользователь, Организация, НовыйТокен);
	Возврат НовыйТокен;
КонецФункции
// ========================================================
// ЗАПИСЬ ТОКЕНА В РЕГИСТР
// ========================================================

Процедура ЗаписатьТокенЧЗ(Пользователь,Организация,Токен) Экспорт
    Сообщить("ШАГ 1: ЗаписатьТокенЧЗ вызвана");

	УдалитьУстаревшиеТокеныЧЗ();

	Сообщить("ШАГ 2: вернулись из удаления");
	
	НаборЗаписей = РегистрыСведений.SM_API_ЧЗ_Токен.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Запись = НаборЗаписей.Добавить();
	
	Запись.Пользователь = Пользователь;
	Запись.Организация = Организация;
	Запись.Токен = Токен;
	Запись.ДатаПолучения = ТекущаяДата();
	
	НаборЗаписей.Записать();
КонецПроцедуры

Процедура УдалитьУстаревшиеТокеныЧЗ() Экспорт

	Сообщить("Очистка старых токенов ЧЗ: начало");

	ГраницаАктуальности = ТекущаяДата() - 10 * 60 * 60;
	КоличествоУдалено = 0;

	// Находим все записи старше 10 часов.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Токены.Пользователь КАК Пользователь,
	|	Токены.Организация КАК Организация,
	|	Токены.ДатаПолучения КАК ДатаПолучения
	|ИЗ
	|	РегистрСведений.SM_API_ЧЗ_Токен КАК Токены
	|ГДЕ
	|	Токены.ДатаПолучения < &Граница";

	Запрос.УстановитьПараметр("Граница", ГраницаАктуальности);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		МенеджерЗаписи =
			РегистрыСведений.SM_API_ЧЗ_Токен.СоздатьМенеджерЗаписи();

		МенеджерЗаписи.Пользователь = Выборка.Пользователь;
		МенеджерЗаписи.Организация = Выборка.Организация;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран()
			И МенеджерЗаписи.ДатаПолучения < ГраницаАктуальности Тогда

			МенеджерЗаписи.Удалить();
			КоличествоУдалено = КоличествоУдалено + 1;

		КонецЕсли;

	КонецЦикла;

	Сообщить("Очистка завершена. Удалено записей: "
		+ Строка(КоличествоУдалено));

КонецПроцедуры
// ========================================================
// ПОЛУЧЕНИЕ НОВОГО ТОКЕНА ЧЗ
// ========================================================

Функция ПолучитьТокенЧЗ(ДокументОбъект) Экспорт
// ========================================================
// ПОЛУЧАЕМ ИНН ОРГАНИЗАЦИИ
// ========================================================
ИНН = ДокументОбъект.Организация.ИНН;
ИНН = СтрЗаменить(ИНН, " ", "");
ИНН = СтрЗаменить(ИНН, Символ(160), ""); 
Если ПустаяСтрока(ИНН) Тогда
	ВызватьИсключение("У организации не заполнен ИНН");
КонецЕсли;
// ========================================================
// ПОЛУЧАЕМ ОТПЕЧАТОК СЕРТИФИКАТА
// ========================================================
ОтпечатокСертификата = ПолучитьОтпечатокСертификата();
Если ПустаяСтрока(ОтпечатокСертификата) Тогда
	ВызватьИсключение("Не найден сертификат для подписи");
КонецЕсли;
// ========================================================
// ПОЛУЧЕНИЕ КЛЮЧА ЧЗ
// ========================================================
Сервер = "markirovka.crpt.ru";
SSL = Новый ЗащищенноеСоединениеOpenSSL();
Соединение = Новый HTTPСоединение(Сервер,443,,,,15,SSL);
ЗапросКлюч = Новый HTTPЗапрос("/api/v3/true-api/auth/key");
ОтветКлюч = Соединение.Получить(ЗапросКлюч);
Если ОтветКлюч.КодСостояния <> 200 Тогда
	ВызватьИсключение("Ошибка получения ключа ЧЗ: "+ ОтветКлюч.ПолучитьТелоКакСтроку());
КонецЕсли;
ЧтениеJSON = Новый ЧтениеJSON;
ЧтениеJSON.УстановитьСтроку(ОтветКлюч.ПолучитьТелоКакСтроку());
ДанныеСервера = ПрочитатьJSON(ЧтениеJSON);
ЧтениеJSON.Закрыть();
UUID = ДанныеСервера.uuid;
ДанныеДляПодписи = ДанныеСервера.data;
// ========================================================
// ПОДПИСЬ СЕРТИФИКАТОМ
// ========================================================
oSigner = Новый COMОбъект("CAdESCOM.CPSigner");
oSignedData = Новый COMОбъект("CAdESCOM.CadesSignedData");
oStore = Новый COMОбъект("CAdESCOM.Store");
oStore.Open(2,"My",0);
СертификатНайден = Ложь;
Для Каждого Сертификат Из oStore.Certificates Цикл
	ТекущийОтпечаток = ВРег(СтрЗаменить(СтрЗаменить(Сертификат.Thumbprint," ",""),Символ(8206),""));
	Если ТекущийОтпечаток = ОтпечатокСертификата Тогда
		oSigner.Certificate = Сертификат;
		СертификатНайден = Истина;
		Прервать;
	КонецЕсли;
КонецЦикла;
oStore.Close();
Если Не СертификатНайден Тогда
	ВызватьИсключение("Сертификат не найден");
КонецЕсли;
oSigner.Options = 1;
oSignedData.Content = ДанныеДляПодписи;
Подпись = oSignedData.SignCades(oSigner,1,Ложь,0);
Подпись = СтрЗаменить(Подпись,Символы.ПС,"");
Подпись = СтрЗаменить(Подпись,Символы.ВК,"");

// ========================================================
// ПОЛУЧЕНИЕ ТОКЕНА
// ========================================================

ЗапросЛогин = Новый HTTPЗапрос("/api/v3/true-api/auth/simpleSignIn?inn="+ ИНН);
ЗапросЛогин.Заголовки.Вставить("Content-Type","application/json");
Тело = Новый Структура;
Тело.Вставить("uuid",UUID);
Тело.Вставить("data",Подпись);
Тело.Вставить("inn",ИНН);
ЗаписьJSON = Новый ЗаписьJSON;
ЗаписьJSON.УстановитьСтроку();
ЗаписатьJSON(ЗаписьJSON,Тело);
ЗапросЛогин.УстановитьТелоИзСтроки(
	ЗаписьJSON.Закрыть(),
	КодировкаТекста.UTF8,
	ИспользованиеByteOrderMark.НеИспользовать);
ОтветЛогин = Соединение.ОтправитьДляОбработки(
	ЗапросЛогин);
Если ОтветЛогин.КодСостояния <> 200 Тогда
	ВызватьИсключение("Ошибка авторизации ЧЗ: "+ ОтветЛогин.ПолучитьТелоКакСтроку());
КонецЕсли;
ЧтениеJSON = Новый ЧтениеJSON;
ЧтениеJSON.УстановитьСтроку(ОтветЛогин.ПолучитьТелоКакСтроку());
Ответ = ПрочитатьJSON(ЧтениеJSON);

ЧтениеJSON.Закрыть();
Токен = Ответ.token;
Сообщить("Новый токен ЧЗ получен. Первые символы: " + Лев(Токен,20));
Возврат Токен;
КонецФункции

Функция ПолучитьТокенЧЗДляОрганизации(Организация,ОтпечатокСертификата) Экспорт
	
	ИНН = Организация.ИНН;
	ИНН = СтрЗаменить(ИНН," ","");
	ИНН = СтрЗаменить(ИНН,Символ(160),"");
	Если ПустаяСтрока(ИНН) Тогда
		ВызватьИсключение "У организации не заполнен ИНН";
	КонецЕсли;
	Если ПустаяСтрока(ОтпечатокСертификата) Тогда
		ВызватьИсключение "Не выбран сертификат для подписи";
	КонецЕсли;
	Сервер = "markirovka.crpt.ru";
	SSL = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый HTTPСоединение(Сервер,443,,,,15,SSL);
	// =====================================================
	// Получаем ключ для авторизации
	// =====================================================
	ЗапросКлюч = Новый HTTPЗапрос("/api/v3/true-api/auth/key");
	ОтветКлюч = Соединение.Получить(ЗапросКлюч);
	Если ОтветКлюч.КодСостояния <> 200 Тогда
		ВызватьИсключение("Ошибка получения ключа ЧЗ: "+ Строка(ОтветКлюч.КодСостояния)+ Символы.ПС+ ОтветКлюч.ПолучитьТелоКакСтроку());
	КонецЕсли;
	ТелоОтвета = ОтветКлюч.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	ДанныеСервера = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Если Не ДанныеСервера.Свойство("uuid") Тогда
		ВызватьИсключение "ЧЗ не вернул uuid";
	КонецЕсли;
	Если Не ДанныеСервера.Свойство("data") Тогда
		ВызватьИсключение "ЧЗ не вернул данные для подписи";
	КонецЕсли;
	UUID = ДанныеСервера.uuid;
	ДанныеДляПодписи = ДанныеСервера.data;
	// =====================================================
	// Находим выбранный сертификат
	// =====================================================
	oSigner = Новый COMОбъект("CAdESCOM.CPSigner");
	oSignedData = Новый COMОбъект("CAdESCOM.CadesSignedData");
	oStore = Новый COMОбъект("CAdESCOM.Store");
	СертификатНайден = Ложь;
	Попытка
		oStore.Open(2,"My",0);
		Для Каждого Сертификат Из oStore.Certificates Цикл
			Если Не Сертификат.HasPrivateKey() Тогда
				Продолжить;
			КонецЕсли;
			ТекущийОтпечаток = ВРег(СтрЗаменить(СтрЗаменить(Сертификат.Thumbprint," ",""),Символ(8206),""));
			Если ТекущийОтпечаток = ОтпечатокСертификата Тогда
				oSigner.Certificate = Сертификат;
				СертификатНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		oStore.Close();
	Исключение
		Попытка
			oStore.Close();
		Исключение
		КонецПопытки;
		ВызватьИсключение("Ошибка работы с хранилищем сертификатов: "+ ОписаниеОшибки());
	КонецПопытки;
	Если Не СертификатНайден Тогда
		ВызватьИсключение "Выбранный сертификат не найден";
	КонецЕсли;
	// =====================================================
	// Подписываем данные
	// =====================================================
	oSigner.Options = 1;
	oSignedData.Content = ДанныеДляПодписи;
	Подпись = oSignedData.SignCades(oSigner,1,Ложь,0);
	Подпись = СтрЗаменить(Подпись,Символы.ПС,"");
	Подпись = СтрЗаменить(Подпись,Символы.ВК,"");
	// =====================================================
	// Авторизация
	// =====================================================
	ЗапросЛогин = Новый HTTPЗапрос("/api/v3/true-api/auth/simpleSignIn?inn="+ ИНН);
	ЗапросЛогин.Заголовки.Вставить("Content-Type","application/json");
	Тело = Новый Структура;
	Тело.Вставить("uuid",UUID);
	Тело.Вставить("data",Подпись);
	Тело.Вставить("inn",ИНН);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON,Тело);
	ТелоJSON = ЗаписьJSON.Закрыть();
	ЗапросЛогин.УстановитьТелоИзСтроки(ТелоJSON,КодировкаТекста.UTF8,ИспользованиеByteOrderMark.НеИспользовать);
	ОтветЛогин = Соединение.ОтправитьДляОбработки(ЗапросЛогин);
	ТелоОтвета = ОтветЛогин.ПолучитьТелоКакСтроку();
	Если ОтветЛогин.КодСостояния <> 200 Тогда
		ВызватьИсключение("Ошибка авторизации ЧЗ: "+ Строка(ОтветЛогин.КодСостояния)+ Символы.ПС+ ТелоОтвета);
	КонецЕсли;
	// =====================================================
	// Получаем токен
	// =====================================================
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Ответ = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Если Не Ответ.Свойство("token") Тогда
		ВызватьИсключение "В ответе ЧЗ отсутствует token";
	КонецЕсли;
	Токен = Ответ.token;
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "ЧЗ вернул пустой токен";
	КонецЕсли;
	Сообщить("Получен токен для "+ Строка(Организация)+ ". Первые символы: "+ Лев(Токен,20));
	Возврат Токен;
КонецФункции

// ========================================================
// ПРОВЕРКА КОДОВ МАРКИРОВКИ
// ========================================================

Функция ПроверитьКодыМаркировки(ДокументОбъект,Токен) Экспорт
	Результат = СоздатьТаблицуРезультатов();
	МассивКодов = Новый Массив;
	Для Каждого СтрокаКода Из ДокументОбъект.КодыМаркировки Цикл
		МассивКодов.Добавить(СтрокаКода.КодМаркировки);
	КонецЦикла;
	// Проверяем криптохвосты
	РезультатКХ = ПроверитьКриптохвосты(МассивКодов,Токен);
	ВалидностьКХ = Новый Соответствие;
	Для Каждого Код Из МассивКодов Цикл
		Если РезультатКХ = Истина Тогда
			ВалидностьКХ.Вставить(Код,Истина);
		Иначе
			ВалидностьКХ.Вставить(Код,РезультатКХ.Найти(Код) = Неопределено);
		КонецЕсли;
	КонецЦикла;
	// Получаем КИ
	МассивКИ = Новый Массив;
	СоответствиеКИ = Новый Соответствие;
	Для Каждого Код Из МассивКодов Цикл
		КИ = ПолучитьКИИзКода(Код);
		МассивКИ.Добавить(КИ);
		СоответствиеКИ.Вставить(КИ,Код);
	КонецЦикла;
	// Получаем информацию ЧЗ
	ДанныеЧЗ = ПолучитьИнформациюОКодах(МассивКИ,Токен);
	// Обрабатываем каждый ответ ЧЗ
	Для Каждого Данные Из ДанныеЧЗ Цикл
		Если Не Данные.Свойство("cisInfo") Тогда
			Продолжить;
		КонецЕсли;
		КИ = "";
		Код = "";
		Если Данные.cisInfo.Свойство("cis") Тогда
			КИ = Данные.cisInfo.cis;
		ИначеЕсли Данные.cisInfo.Свойство("requestedCis") Тогда
			КИ = Данные.cisInfo.requestedCis;
		КонецЕсли;
		Попытка
			Код = СоответствиеКИ[КИ];
		Исключение
			Код = "";
		КонецПопытки;
		Строка = Результат.Добавить();
		Строка.КодМаркировки = Код;
		Строка.КИ = КИ;
		Строка.ВалидностьКХ = ВалидностьКХ[Код];
		// Если ЧЗ вернул ошибку по КМ
		Если Данные.Свойство("errorMessage") Тогда
			Строка.Статус = "Не найден";
			Строка.Результат = Данные.errorMessage;
			Продолжить;
		КонецЕсли;
		// Статус
		Статус = "";
		Если Данные.cisInfo.Свойство("status") Тогда
			Статус = Данные.cisInfo.status;
		КонецЕсли;
		Если Статус = "INTRODUCED" Тогда
			Статус = "В обращении";
		ИначеЕсли Статус = "IN_CIRCULATION" Тогда
			Статус = "В обращении";
		ИначеЕсли Статус = "RETIRED" Тогда
			Статус = "Выбыл";
		ИначеЕсли Статус = "WRITTEN_OFF" Тогда
			Статус = "Списан";
		КонецЕсли;
		Строка.Статус = Статус;
		// Владелец
		Если Данные.cisInfo.Свойство("ownerName") Тогда
			Строка.Владелец = Данные.cisInfo.ownerName;
		КонецЕсли;
		// ИНН владельца
		Если Данные.cisInfo.Свойство("ownerInn") Тогда
			Строка.ИННВладельца = Данные.cisInfo.ownerInn;
		ИначеЕсли Данные.cisInfo.Свойство("ownerINN") Тогда
			Строка.ИННВладельца = Данные.cisInfo.ownerINN;
		КонецЕсли;
		// Товар
		Если Данные.cisInfo.Свойство("productName") Тогда
			Строка.Товар = Данные.cisInfo.productName;
		КонецЕсли;
		// Группа ЧЗ
		Если Данные.cisInfo.Свойство("productGroup") Тогда
			Если Данные.cisInfo.productGroup <> Неопределено Тогда
				Строка.ГруппаЧЗ = Данные.cisInfo.productGroup;
			КонецЕсли;
		КонецЕсли;
		// Категория
		Если Данные.cisInfo.Свойство("category") Тогда
			Если Данные.cisInfo.category <> Неопределено Тогда
				Строка.Категория = Данные.cisInfo.category;
			КонецЕсли;
		КонецЕсли;
		// Упаковка
		Если Данные.cisInfo.Свойство("parent") Тогда
			Если Данные.cisInfo.parent <> Неопределено Тогда
				Строка.Упаковка = Данные.cisInfo.parent;
			КонецЕсли;
		КонецЕсли;
		// Результат проверки
		Если Статус = "Списан" Тогда
			Строка.Результат = "КМ списан";
		ИначеЕсли Статус = "Выбыл" Тогда
			Строка.Результат = "КМ выбыл";
		ИначеЕсли Строка.ВалидностьКХ = Ложь Тогда
			Строка.Результат = "Неверный криптохвост";
		Иначе
			Строка.Результат = "Проверка пройдена";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
// ========================================================
