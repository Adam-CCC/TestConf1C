КонецФункции


// ========================================================
// ПОЛУЧЕНИЕ КИ ИЗ ПОЛНОГО КОДА МАРКИРОВКИ
// ========================================================

Функция ПолучитьКИИзКода(КодМаркировки)
	Код = СтрЗаменить(КодМаркировки,"(01)","01");
	Код = СтрЗаменить(Код,"(21)","21");

	// убираем GS1-разделители только в конце
	Код = СтрЗаменить(Код,Символ(29),"");

	Возврат Код;
КонецФункции


// ========================================================
// ПРОВЕРКА КРИПТОХВОСТОВ ЧЕРЕЗ ЧЗ
// ========================================================

Функция ПроверитьКриптохвосты(МассивПолныхКодов,Токен) Экспорт

	Если МассивПолныхКодов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Ресурс = "/api/v3/true-api/cises/check";

	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("Authorization","Bearer " + Токен);
	Запрос.Заголовки.Вставить("Content-Type","application/json");

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("codes",МассивПолныхКодов);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON,ТелоЗапроса);

	Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(),КодировкаТекста.UTF8,ИспользованиеByteOrderMark.НеИспользовать);
	SSL = Новый ЗащищенноеСоединениеOpenSSL;

	Соединение = Новый HTTPСоединение("markirovka.crpt.ru",443,,,,15,SSL);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение("Ошибка проверки криптохвостов: " + ТелоОтвета);
	КонецЕсли;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Если Результат.result Тогда
		Возврат Истина;
	КонецЕсли;
	НеВалидныеКоды = Новый Массив;
	Если Результат.Свойство("codes") Тогда
		Для Каждого Код Из Результат.codes Цикл
			НеВалидныеКоды.Добавить(Код);
		КонецЦикла;
	КонецЕсли;
	Возврат НеВалидныеКоды;

КонецФункции


// ========================================================
// ПОЛУЧЕНИЕ ИНФОРМАЦИИ ПО КИ ИЗ ЧЗ
// ========================================================

Функция ПолучитьИнформациюОКодах(МассивКИ,Токен) Экспорт
	Ресурс = "/api/v3/true-api/cises/info";
	Запрос = Новый HTTPЗапрос(Ресурс);
	Запрос.Заголовки.Вставить("Authorization","Bearer " + Токен);
	Запрос.Заголовки.Вставить("Content-Type","application/json");
	// Передаем непосредственно массив КИ
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON,МассивКИ);
	ТелоJSON = ЗаписьJSON.Закрыть();
	Запрос.УстановитьТелоИзСтроки(ТелоJSON,КодировкаТекста.UTF8,ИспользованиеByteOrderMark.НеИспользовать);
	SSL = Новый ЗащищенноеСоединениеOpenSSL();
	Соединение = Новый HTTPСоединение("markirovka.crpt.ru",443,,,,15,SSL);
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 404 Тогда
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		ВызватьИсключение("Ошибка получения информации ЧЗ: "+ Строка(Ответ.КодСостояния)+ " "+ ТелоОтвета);
	КонецЕсли;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
	
КонецФункции


// ========================================================
// ВЫВОД РЕЗУЛЬТАТА В ТАБЛИЧНЫЙ ДОКУМЕНТ
// ========================================================

Процедура ВывестиРезультатВТабличныйДокумент(ТаблицаРезультата,ДокументОбъект) Экспорт
	ТабДок = Новый ТабличныйДокумент;
	Строка = 3;
	КолонкаНомер = 1;
	Для Каждого Колонка Из ТаблицаРезультата.Колонки Цикл
		ТабДок.Область(Строка,КолонкаНомер,
			Строка,КолонкаНомер).Текст = Колонка.Имя;
		КолонкаНомер = КолонкаНомер + 1;
	КонецЦикла;
	Строка = Строка + 1;
	Для Каждого Данные Из ТаблицаРезультата Цикл
		КолонкаНомер = 1;
		Для Каждого Поле Из Данные Цикл
			ТабДок.Область(
				Строка,
				КолонкаНомер,
				Строка,
				КолонкаНомер).Текст = Строка(Поле);
			КолонкаНомер = КолонкаНомер + 1;
		КонецЦикла;
		Строка = Строка + 1;
	КонецЦикла;
	Сообщить("Проверка КМ завершена. Строк: " + ТаблицаРезультата.Количество());
	ТабДок.Показать();

КонецПроцедуры


 // ========================================================
//  РАБОТА СО СНИМКОМ ДАННЫХ ПОСТУПЛЕНИЯ ТОВАРОВ
// ========================================================

Функция СформироватьСнимокДанныхЧЗ(ДокументОбъект) Экспорт

	Снимок = "";

	// Состояние табличной части Товары.
	Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
		Снимок = Снимок
			+ "Т:"
			+ Строка(СтрокаТовара.Номенклатура)
			+ "|"
			+ Строка(СтрокаТовара.Количество)
			+ Символы.ПС;
	КонецЦикла;

	// Состояние табличной части ОтсканированныеКМ.
	Для Каждого СтрокаСканирования Из ДокументОбъект.ОтсканированныеКМ Цикл
		Снимок = Снимок
			+ "С:"
			+ Строка(СтрокаСканирования.КодМаркировки)
			+ Символы.ПС;
	КонецЦикла;

	Возврат Снимок;

КонецФункции

Функция ПолучитьСнимокПроверкиЧЗ(ДокументОбъект) Экспорт

	НаборЗаписей = РегистрыСведений.SM_СостояниеПроверкиЧЗ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументОбъект.Ссылка);
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат НаборЗаписей[0].СнимокДанных;

КонецФункции

Процедура ЗаписатьСнимокПроверкиЧЗ(ДокументОбъект) Экспорт

	НаборЗаписей = РегистрыСведений.SM_СостояниеПроверкиЧЗ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументОбъект.Ссылка);
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		ЗаписьРегистра = НаборЗаписей.Добавить();
		ЗаписьРегистра.Документ = ДокументОбъект.Ссылка;
	Иначе
		ЗаписьРегистра = НаборЗаписей[0];
	КонецЕсли;

	ЗаписьРегистра.СнимокДанных = СформироватьСнимокДанныхЧЗ(ДокументОбъект);

	НаборЗаписей.Записать();

КонецПроцедуры

