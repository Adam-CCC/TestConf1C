Процедура СозданиеДокументовКонтактСКлиентом(СтруктураПараметров = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КампанииОтборы.Ссылка.Ссылка КАК Кампания,
		|	Renault_КампанииОтборы.Контрагент КАК Контрагент,
		|	Renault_КампанииОтборы.Автомобиль КАК Автомобиль
		|ИЗ
		|	Справочник.Renault_Кампании.Отборы КАК Renault_КампанииОтборы
		|ГДЕ
		|	Renault_КампанииОтборы.Ссылка.ДатаНачалаАктивности <= &ТекущаяДата
		|	И Renault_КампанииОтборы.Ссылка.ДатаОкончанияАктивности >= &ТекущаяДата
		|	И Renault_КампанииОтборы.Ссылка.ФлРазоваяКампания = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	Renault_КампанииОтборы.Контрагент,
		|	Renault_КампанииОтборы.Автомобиль,
		|	Renault_КампанииОтборы.Ссылка.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Кампания,
		|	Контрагент,
		|	Автомобиль";

	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапросДок = Новый Запрос;
		ЗапросДок.Текст = 
			"ВЫБРАТЬ
			|	Renault_КонтактСКлиентом.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Renault_КонтактСКлиентом КАК Renault_КонтактСКлиентом
			|ГДЕ
			|	Renault_КонтактСКлиентом.Кампания = &Кампания
			|	И Renault_КонтактСКлиентом.Контрагент = &Контрагент
			|	И Renault_КонтактСКлиентом.Автомобиль = &Автомобиль
			|
			|СГРУППИРОВАТЬ ПО
			|	Renault_КонтактСКлиентом.Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	Ссылка";

		ЗапросДок.УстановитьПараметр("Автомобиль", Выборка.Автомобиль);
		ЗапросДок.УстановитьПараметр("Кампания", Выборка.Кампания);
		ЗапросДок.УстановитьПараметр("Контрагент", Выборка.Контрагент);

		ВыборкаДок = ЗапросДок.Выполнить().Выбрать();
		Если ВыборкаДок.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		Телефон="";
		Для СчВидКонт=1 По 3 Цикл
			ЗапросКонтакты = Новый Запрос;
			ЗапросКонтакты.Текст = "
			|ВЫБРАТЬ
			|	КонтактнаяИнформация.Представление КАК Представление
			|ИЗ
			|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.Объект = &Объект
			|	И КонтактнаяИнформация.Тип = &Тип
			|	И КонтактнаяИнформация.Вид = &Вид";
			
			ЗапросКонтакты.УстановитьПараметр("Объект",Выборка.Контрагент);
			Если СчВидКонт=1 Тогда
				ЗапросКонтакты.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
				ЗапросКонтакты.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
			Иначе
				ЗапросКонтакты.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.Телефон);
				Если СчВидКонт=2 Тогда
					ЗапросКонтакты.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
				Иначе
					ЗапросКонтакты.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
				КонецЕсли;
			КонецЕсли;
			ВыборкаКонтакты=ЗапросКонтакты.Выполнить().Выбрать();
			Если ВыборкаКонтакты.Следующий() Тогда
				Если СчВидКонт=1 Тогда
					АдресЭлектроннойПочты=СокрЛП(ВыборкаКонтакты.Представление);
				Иначе
					Телефон=Телефон+?(Телефон="","",", ")+СокрЛП(ВыборкаКонтакты.Представление);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; 
		НовыйКонтакт=Документы.Renault_КонтактСКлиентом.СоздатьДокумент();
		НовыйКонтакт.Дата=ТекущаяДата();
		НовыйКонтакт.Автомобиль=Выборка.Автомобиль;
		НовыйКонтакт.Контрагент=Выборка.Контрагент;
		НовыйКонтакт.Кампания=Выборка.Кампания;
		НовыйКонтакт.Телефон=Телефон;
		НовыйКонтакт.АдресЭлектроннойПочты=АдресЭлектроннойПочты;
		НовыйКонтакт.Записать();
	КонецЦикла;
КонецПроцедуры

// Процедура формирует таблицу со всеми документами, в которых присутствует заданный контрагент.
//
// Параметры:
//  Ограничения – "Структура" - ограничения на формируемую таблицу.
//
// Возвращаемое значение:
//   ТаблицаЗначений - таблица с документами.
// 
Функция Renault_ПолучитьТаблицуДокументовКритерияОтбора(Ограничения=Неопределено) Экспорт
	Если Ограничения=Неопределено Тогда
		Ограничения = Новый Структура;
		Ограничения.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	СтруктураИсключений = Новый Структура("Контрагент,ВидДокументов,ДатаНачала,ДатаОкончания");
	МассивВидовДокументов = Неопределено;
	ДатаНачала            = Неопределено;
	ДатаОкончания         = Неопределено;
	
	Ограничения.Свойство("ВидДокументов",   МассивВидовДокументов);
	Ограничения.Свойство("ДатаНачала",      ДатаНачала);
	Ограничения.Свойство("ДатаОкончания",   ДатаОкончания);

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КритерийОтбораКонтрагенты.Документ КАК Документ,
	|	КритерийОтбораКонтрагенты.Дата КАК Дата,
	|	КритерийОтбораКонтрагенты.ХозОперация КАК ХозОперация,
	|	КритерийОтбораКонтрагенты.СуммаДокумента КАК СуммаДокумента,
	|	КритерийОтбораКонтрагенты.ВалютаДокумента КАК ВалютаДокумента,
	|	КритерийОтбораКонтрагенты.ДанныеКартинки КАК ДанныеКартинки
	|ИЗ (
	|		ВЫБРАТЬ
	|			Контрагенты.Ссылка КАК Документ,
	|			Контрагенты.Ссылка.Дата КАК Дата,
	|			Контрагенты.Ссылка.ХозОперация КАК ХозОперация,
	|			Контрагенты.Ссылка.СуммаДокумента КАК СуммаДокумента,
	|			Контрагенты.Ссылка.ВалютаДокумента КАК ВалютаДокумента,
	|			ВЫБОР
	|				КОГДА Контрагенты.Ссылка.ПометкаУдаления
	|					ТОГДА 3
	|				ИНАЧЕ ВЫБОР
	|						КОГДА Контрагенты.Ссылка.Проведен
	|							ТОГДА 1
	|						ИНАЧЕ 0
	|				КОНЕЦ
	|			КОНЕЦ КАК ДанныеКартинки
	|		ИЗ
	|			КритерийОтбора.Renault_Контрагенты(&Контрагент) КАК Контрагенты
	|";
	
	ТекстУсловий = "";
	// Отбор по интервалу времени
	Если ДатаНачала<>Неопределено Тогда
		ТекстУсловий = ТекстУсловий + ?(ТекстУсловий="", "ГДЕ ", " И ") + "Контрагенты.Ссылка.Дата>=&ДатаНачала";	
	КонецЕсли;
	
	Если ДатаОкончания<>Неопределено Тогда
		ТекстУсловий = ТекстУсловий + ?(ТекстУсловий="", "ГДЕ ", " И ") + " Контрагенты.Ссылка.Дата<=&ДатаОкончания";
	КонецЕсли;
	
	Если НЕ обЗначениеНеЗаполнено(Ограничения) Тогда
		// отбор по значению ограничений
		Для Каждого Ограничение Из Ограничения Цикл
			Если СтруктураИсключений.Свойство(Ограничение.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ обЗначениеНеЗаполнено(Ограничение.Значение) Тогда
				ТекстУсловий = ТекстУсловий + ?(ПустаяСтрока(ТекстУсловий), "ГДЕ ", " И ") + "Контрагенты.Ссылка."+Ограничение.Ключ+"=&"+Ограничение.Ключ;
				Запрос.УстановитьПараметр(Ограничение.Ключ,Ограничение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Отбор по виду документов
	Если (МассивВидовДокументов<>Неопределено) И (МассивВидовДокументов.Количество()<>0) Тогда
		ТекстУсловий = ТекстУсловий + ?(ТекстУсловий="", "ГДЕ (", " И (");
		
		Для Сч=0 По (МассивВидовДокументов.Количество()-1) Цикл  	
			Если Сч<>0 Тогда
				ТекстУсловий = ТекстУсловий + " ИЛИ ";	
			КонецЕсли;
			ТекстУсловий = ТекстУсловий + "Контрагенты.Ссылка ССЫЛКА Документ." + МассивВидовДокументов[Сч];		
		КонецЦикла;	
		
		ТекстУсловий = ТекстУсловий + ")";
	КонецЕсли;
	  	
	ТекстЗапроса = ТекстЗапроса + ТекстУсловий;
	
	ТекстЗапроса = ТекстЗапроса + "
	|) КАК КритерийОтбораКонтрагенты
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Контрагент",      Ограничения.Контрагент);
	Запрос.УстановитьПараметр("ДатаНачала",      ДатаНачала); 	
	Запрос.УстановитьПараметр("ДатаОкончания",   ДатаОкончания);
	
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции // ЗаполнитьТаблицуДокументами() 

//Преобразует строку  в цвет
Функция ПолучитьЦветПоСтроке(вхСтрокаЦвета) Экспорт
	
	Попытка
		МассивОпределение = обРазложитьСтрокуВМассивПодстрок(вхСтрокаЦвета, "@");
		Если МассивОпределение[0] = "web" Тогда
			Возврат WebЦвета[МассивОпределение[1]];
		ИначеЕсли МассивОпределение[0] = "style" Тогда
			Возврат ЦветаСтиля[МассивОпределение[1]];
		ИначеЕсли МассивОпределение[0] = "RGB" Тогда	
			МассивЦвета = обРазложитьСтрокуВМассивПодстрок(МассивОпределение[1], ",");
			ИтоговыйЦвет = Новый Цвет(МассивЦвета[0], МассивЦвета[1], МассивЦвета[2]);
			Возврат ИтоговыйЦвет;
		Иначе 
			Возврат Новый Цвет();
		КонецЕсли;
	Исключение
		Возврат Новый Цвет();
	КонецПопытки;
	
КонецФункции

Функция ЦветВСтроку(вхЦвет) Экспорт
	ТекИмя = Строка(вхЦвет);	
	Если вхЦвет.Вид = ВидЦвета.WebЦвет Тогда
		Начало = Найти(ТекИмя,"(");
		Конец = Найти(ТекИмя,")");
		ТекИмяОриг = Сред(ТекИмя,Начало+1,Конец - Начало - 1);
		Возврат "web@"+ТекИмяОриг;
	ИначеЕсли  вхЦвет.Вид = ВидЦвета.ЭлементСтиля Тогда
		ТаблицаЦветов = ТаблицаЦветовСтиля();
		Поиск = ТаблицаЦветов.Найти(ТекИмя,"ПредставлениеЦвета");
		Если ЗначениеЗаполнено(Поиск) тогда
			Возврат "style@"+Поиск.ИмяЦвета;
		Иначе
			Возврат "RGB@" +ТекИмя;
		КонецЕсли;
		
	Иначе
		Возврат "RGB@"+ТекИмя;
	КонецЕсли;
	
		
	
КонецФункции

