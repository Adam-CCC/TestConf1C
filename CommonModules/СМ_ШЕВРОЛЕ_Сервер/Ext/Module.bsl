Процедура ВыгрузкаНаПорталШевроле(АдресВХ_ЗН,АдресВХ_Работ,Подразделение) Экспорт
	
	Перем ОписаниеОшибки;
	
	ДатаВремяСтрокой = "";
	ДатаВремяСтрокой = СокрЛП(Формат(ТекущаяДата(),"ДЛФ=DT"));
	ДатаВремяСтрокой = СтрЗаменить(ДатаВремяСтрокой,".","_");
	ДатаВремяСтрокой = СтрЗаменить(ДатаВремяСтрокой,":","_");
	ДатаВремяСтрокой = СтрЗаменить(ДатаВремяСтрокой," ","_");
	
	ПутьКЛог = "C:\Program Files\ChevroletServiceDataUploader\log.txt";
	ФайлЛогНаДиске = Новый Файл(ПутьКЛог);                                        
	
	Если Подразделение.Код = "ЦБ000231" Тогда APIKey = "Vv7Cj1yqRFr9w2ek5gG8Gq7971M6TD" //Ростов
	ИначеЕсли Подразделение.Код = "ЦБ000126" Тогда APIKey = "m4Ht7pxiOh2UX01kZIZA4vW7QtqCK6"; //Шахты 
	ИначеЕсли Подразделение.Код = "ЦБ001330" Тогда APIKey = "lnaj3mmtXa1jq3WF3ogI47U2obsZYX"; //Волгодонск
	КонецЕсли;
	
	ПолныйПутьКпрограмме = "C:\Program Files\ChevroletServiceDataUploader\ChevroletServiceDataUploader.exe";		
	ИмяФайлаПрограммыНаДиске = Новый Файл(ПолныйПутьКпрограмме);
	
	Если   ИмяФайлаПрограммыНаДиске.Существует() Тогда
		
		ИмяВременногоФайлаЗН = "C:\Program Files\ChevroletServiceDataUploader\DataToSend\file1.txt";
