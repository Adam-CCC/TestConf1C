		ДвоичныеДанные.Записать(ИмяВременногоФайлаРабот);
		
		ИмяКоманды = """C:\Program Files\ChevroletServiceDataUploader\ChevroletServiceDataUploader.exe"""+" "+ APIKey ;
		
		Попытка
			ОбщиеСервер.ВыполнитьКомандуНаСервере(ИмяКоманды,ОписаниеОшибки);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;	
		
	Иначе			
		
		ОписаниеОшибки = "ОШИБКА! Файл '"+ПолныйПутьКпрограмме+"' не существует.";			
		
	КонецЕсли;
	
	//Бондаренко-- 20201002
	Если ФайлЛогНаДиске.Существует() Тогда
		ТекстПисьма = "";
		Текст = Новый ЧтениеТекста(ПутьКЛог,КодировкаТекста.ANSI,Символы.ПС,    ,  Истина);
		ёё = 0;
		Пока Истина Цикл
			ёё = ёё + 1;
			Если ёё > 10000 Тогда
				Прервать;
			КонецЕсли; 
			Строка = Текст.ПрочитатьСтроку();
			Если Строка = Неопределено Тогда
				мКому = Новый Массив;
				мКому.Добавить("valter_y@sokolmotors.ru");
				мКопии = Новый Массив;
