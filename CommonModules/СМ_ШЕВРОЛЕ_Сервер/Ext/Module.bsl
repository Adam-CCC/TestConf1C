Функция ПолучитьТЗДилеров(Шевроле) Экспорт
	
	ТЗ = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КодыДилеровСрезПоследних.Период,
		|	КодыДилеровСрезПоследних.ПодразделениеКомпании,
		|	КодыДилеровСрезПоследних.Бренд,
		|	КодыДилеровСрезПоследних.КодДилера
		|ИЗ
		|	РегистрСведений.КодыДилеров.СрезПоследних(&Период, ) КАК КодыДилеровСрезПоследних
		|ГДЕ
		|	КодыДилеровСрезПоследних.Бренд = &Бренд";
	
	Запрос.УстановитьПараметр("Бренд", Шевроле);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	ТЗ = Запрос.Выполнить().Выгрузить();  
	
	//ТЗ.ВыбратьСтроку(ТЗ.Количество());
	
	Возврат ТЗ;
 
КонецФункции // ПолучитьТЗДилеров(Бренд)
 

Процедура ВыгрузитьОстаткиНоменклатурыПоШевроле(Параметры = Неопределено)  Экспорт
	
 	ИмяФайла = КаталогВременныхФайлов()+"file3.txt";
 	
	Шевроле = Справочники.Марка.CHEVROLET;
	ТЗ = ПолучитьТЗДилеров(Шевроле);
	
	Если ТЗ.Количество() > 0 Тогда
		Для каждого Элем Из ТЗ Цикл
 			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	&Дилер КАК Дилер,
			|	&КодДилера КАК КодДилера,
			|	ПартииТоваровКомпанииОстатки.Номенклатура.Артикул КАК Артикул,
			|	СУММА(ПартииТоваровКомпанииОстатки.КоличествоОстаток) КАК СвободныйОстаток,
			|	ПартииТоваровКомпанииОстатки.Номенклатура КАК Ссылка,
			|	Цены.РозничнаяЦена КАК РозничнаяЦена
			|ИЗ
			|	РегистрНакопления.ПартииТоваровКомпании.Остатки(&ДатаОтчета, ) КАК ПартииТоваровКомпанииОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
			|			ЦеныСрезПоследних.ТипЦен КАК ТипЦен,
			|			ЦеныСрезПоследних.Цена КАК РозничнаяЦена
			|		ИЗ
			|			РегистрСведений.Цены.СрезПоследних(&ДатаОтчета, ) КАК ЦеныСрезПоследних
			|		ГДЕ
			|			ЦеныСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)) КАК Цены
			|		ПО ПартииТоваровКомпанииОстатки.Номенклатура = Цены.Номенклатура
			|ГДЕ
			|	ПартииТоваровКомпанииОстатки.СкладКомпании.Подразделение В ИЕРАРХИИ(&ГруппаПодразделений)
			|	И ПартииТоваровКомпанииОстатки.Партия.Контрагент = &КелесРус
			|	И Цены.РозничнаяЦена > 0
			|	И ПартииТоваровКомпанииОстатки.КоличествоОстаток > 0
			|
			|СГРУППИРОВАТЬ ПО
			|	ПартииТоваровКомпанииОстатки.Номенклатура.Артикул,
			|	ПартииТоваровКомпанииОстатки.Номенклатура,
			|	Цены.РозничнаяЦена
			|
			|УПОРЯДОЧИТЬ ПО
			|	РозничнаяЦена УБЫВ";
			
