// СОФТФОН

// Функция проверяет использование СофтФона
//
// Параметры:
//	Нет.
//
// Возвращаемое значение:
//	Булево	- Признак использования СофтФона
//
Функция сфпИспользоватьСофтФон() Экспорт
	Возврат (Константы.CRM_ИспользуемыйСофтФон.Получить() = Перечисления.CRM_ИспользуемыйСофтФон.СофтФон2);
КонецФункции // сфпИспользоватьСофтФон()

// Функция проверяет использование СофтФона Проф 1.0 или 2.0
//
// Параметры:
//	Нет.
//
// Возвращаемое значение:
//	Булево	- Признак использования СофтФона
//
Функция сфпИспользоватьСофтФоны() Экспорт
	Возврат ((Константы.CRM_ИспользуемыйСофтФон.Получить() = Перечисления.CRM_ИспользуемыйСофтФон.СофтФон2) 
		ИЛИ (Константы.CRM_ИспользуемыйСофтФон.Получить() = Перечисления.CRM_ИспользуемыйСофтФон.СофтФонПроф));
КонецФункции // сфпИспользоватьСофтФон()

// Функция возвращает структуру параметров сервера
//
// Параметры:
//	Нет.
//
Функция сфпПараметрыСервера() Экспорт 
	Структура = Новый Структура;
	Структура.Вставить("ПрефиксВыходаВМежгород",				Константы.CRM_ПрефиксВыходаНаМежгород.Получить());
	Структура.Вставить("ПрефиксВыходаНаМеждународную",			Константы.CRM_ПрефиксВыходаНаМеждународную.Получить());
	Структура.Вставить("МаксимальнаяДлинаВнутреннихНомеров",	Константы.CRM_МаксимальнаяДлинаВнутреннегоНомера.Получить());
	Структура.Вставить("ПоследниеЦифрыТелефонногоНомера",		Константы.CRM_КоличествоХранимыхЦифрТелефона.Получить());
	Структура.Вставить("КодСтраны",								Константы.CRM_КодСтраны.Получить());
	Структура.Вставить("КодГорода",								Константы.CRM_КодГорода.Получить());
	ПрефиксВыхода = сфпПолучитьЗначениеПоУмолчаниюПользователя("ЛичныйПрефиксВыходаВГород");
	Если ПустаяСтрока(ПрефиксВыхода) Тогда
		Структура.Вставить("ПрефиксВыходаВГород",				Константы.CRM_ПрефиксВыходаВГород.Получить());
	Иначе
		Структура.Вставить("ПрефиксВыходаВГород",				ПрефиксВыхода);
	КонецЕсли;	
	Возврат Структура;
КонецФункции // сфпПараметрыСервера()

// Процедура сохраняет в константах префиксы и настройки, полученные от сервера СофтФона
//
// Параметры:
//	PrefCity				- Строка	- Префикс выхода в город
//	PrefContry				- Строка	- Префикс выхода на межгород
//	PrefWorld				- Строка	- Префикс выхода на международную линию
//	InternalNumMaxLen		- Число		- Максимальное количество цифр во внутреннем номере
//	LastNumberCount			- Число		- Последние цифры телефонного номера 
//	HistoryConnectionString	- Строка	- Строка подключения к БД истории звонков
//
Процедура сфпЗаписатьПараметрыСервера(PrefCity, PrefContry, PrefWorld, InternalNumMaxLen, LastNumberCount, HistoryConnectionString) Экспорт
	Константы.CRM_ПрефиксВыходаВГород.Установить(PrefCity);				
	Константы.CRM_ПрефиксВыходаНаМежгород.Установить(PrefContry);
	Константы.CRM_ПрефиксВыходаНаМеждународную.Установить(PrefWorld);
	Константы.CRM_МаксимальнаяДлинаВнутреннегоНомера.Установить(InternalNumMaxLen);
	Константы.CRM_КоличествоХранимыхЦифрТелефона.Установить(LastNumberCount);
	Константы.сфпСтрокаПодключенияИстории.Установить(HistoryConnectionString);	
КонецПроцедуры // сфпЗаписатьПараметрыСервера()

// Процедура записывает настройку текущего пользователя
//
// Параметры:
//	Настройка	- ПланВидовХарактеристикСсылка	- Настройка
//	Значений	- Произвольный					- Значение настройки
//
Процедура сфпЗаписатьЗначениеНастройки(Настройка, Значение) Экспорт
	Попытка
		ТекущаяНастройка = ПланыВидовХарактеристик.ПраваИНастройки[Настройка];
	Исключение	
		ТекущаяНастройка = Неопределено;
	КонецПопытки;	
	Если ТекущаяНастройка = Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		НаборЗаписей = РегистрыСведений.ПраваИНастройки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Значение				= сфпТекущийПользователь();
		НаборЗаписей.Отбор.Объект.Использование			= Истина;
		НаборЗаписей.Отбор.ПравоНастройка.Значение		= ТекущаяНастройка;
		НаборЗаписей.Отбор.ПравоНастройка.Использование	= Истина;
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		Запись = НаборЗаписей.Добавить();
		Запись.Объект			= сфпТекущийПользователь();
		Запись.ПравоНастройка	= ТекущаяНастройка;
		Запись.Значение			= ТекущаяНастройка.ТипЗначения.ПривестиЗначение(Значение);
		НаборЗаписей.Записать();
	Исключение
	КонецПопытки;	
КонецПроцедуры // сфпЗаписатьЗначениеНастройки()

// Функция возвращает значение по умолчанию для передаваемого пользователя и настройки.
//
// Параметры:
//  Пользователь 	- СправочникСсылка				- Текущий пользователь программы
//	Настройка		- ПланВидовХарактеристикСсылка	- Настройка
//
// Возвращаемое значение:
//	Произвольный	- Значение по умолчанию для настройки.
//
Функция сфпПолучитьЗначениеПоУмолчаниюПользователя(Настройка) Экспорт
	Попытка
		ТекущаяНастройка = ПланыВидовХарактеристик.ПраваИНастройки[Настройка];
	Исключение	
		ТекущаяНастройка = Неопределено;
	КонецПопытки;	
	Если ТекущаяНастройка = Неопределено Тогда Возврат ТекущаяНастройка; КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", сфпТекущийПользователь());
	Запрос.УстановитьПараметр("Настройка"   , ТекущаяНастройка);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РегистрЗначение.Значение
	               |ИЗ
	               |	РегистрСведений.ПраваИНастройки КАК РегистрЗначение
	               |ГДЕ
	               |	РегистрЗначение.Объект = &Пользователь
	               |	И РегистрЗначение.ПравоНастройка = &Настройка";
	Выборка = Запрос.Выполнить().Выбрать();
	ПустоеЗначение = ТекущаяНастройка.ТипЗначения.ПривестиЗначение();
	Если Выборка.Количество() = 0 Тогда
		Возврат ПустоеЗначение;
	ИначеЕсли Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Значение) Тогда
			Возврат Выборка.Значение;
		Иначе
			Возврат ПустоеЗначение;
		КонецЕсли;
	Иначе
		Возврат ПустоеЗначение;
	КонецЕсли;
КонецФункции // сфпПолучитьЗначениеПоУмолчаниюПользователя() 

// Функция возвращает текущего пользователя
