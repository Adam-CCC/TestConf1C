//	Преобразует таблицу значений в массив.
//	Может использоваться для передачи на клиента данных, полученных
//	на сервере в виде таблицы значений в том случае, если таблица
//	значений содержит только такие значения, которые могут
//  быть переданы на клиента
//
//	Полученный массив содержит структуры, каждая из которых повторяет
//	структуру колонок таблицы значений.
//
//	Не рекомендуется использовать для преобразования таблиц значений
//	с большим количеством строк.
//
//	Параметры: ТаблицаЗначений
//	Возвращаемое значение: Массив
//
Функция ТаблицаЗначенийВМассив(ТаблицаЗначений) Экспорт
	
	Массив = Новый Массив();
	СтруктураСтрокой = "";
	НужнаЗапятая = Ложь;
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если НужнаЗапятая Тогда
			СтруктураСтрокой = СтруктураСтрокой + ",";
		КонецЕсли;
		СтруктураСтрокой = СтруктураСтрокой + Колонка.Имя;
		НужнаЗапятая = Истина;
	КонецЦикла;
	Для Каждого Строка Из ТаблицаЗначений Цикл
		НоваяСтрока = Новый Структура(СтруктураСтрокой);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		Массив.Добавить(НоваяСтрока);
	КонецЦикла;
	Возврат Массив;

КонецФункции

// Функция возвращает массив идентификаторов записей телефонного разговора, доступных для прослушивания текущим пользователем
//
// Параметры:
//	ИдентификаторЗвонка	- Число	- Идентификатор звонка
//	ДатаНачало			- Дата	- Дата начала записи
//
// Возвращаемое значение:
//	Массив	- Массив идентификаторов записей телефонного разговора
//
Функция сфпПолучитьСписокЗаписейТелефонногоРазговора(ИдентификаторЗвонка, ДатаНачало) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗвонка",	ИдентификаторЗвонка);
	Запрос.УстановитьПараметр("НачалоЗаписи",			НачалоДня(ДатаНачало));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка,
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи,
	               |	сфпЗаписиТелефонныхПереговоров.НачалоЗаписи,
	               |	сфпЗаписиТелефонныхПереговоров.Пользователь,
	               |	сфпЗаписиТелефонныхПереговоров.НомерВнТелефона,
	               |	сфпЗаписиТелефонныхПереговоров.Контакт,
	               |	сфпЗаписиТелефонныхПереговоров.НомерТелефона,
	               |	сфпЗаписиТелефонныхПереговоров.ПродолжительностьЗаписи,
	               |	сфпЗаписиТелефонныхПереговоров.ИмяЛинии
	               |ИЗ
	               |	РегистрСведений.сфпЗаписиТелефонныхПереговоров КАК сфпЗаписиТелефонныхПереговоров
	               |ГДЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка = &ИдентификаторЗвонка
	               |	И НЕ сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи = ""-1""
	               |	И сфпЗаписиТелефонныхПереговоров.НачалоЗаписи >= &НачалоЗаписи";
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	МассивПользователей = сфпПолучитьМассивПрослушиваемыхПользователей(сфпТекущийПользователь());	
	КоличествоСтрокТаблицы = ТаблицаЗаписей.Количество();
	Для НомерСтроки = 1 По КоличествоСтрокТаблицы Цикл 
		СтрокаТаблицы = ТаблицаЗаписей[КоличествоСтрокТаблицы - НомерСтроки];
		Если МассивПользователей.Найти(СтрокаТаблицы.Пользователь) = Неопределено Тогда
			ТаблицаЗаписей.Удалить(СтрокаТаблицы);
		КонецЕсли;	
	КонецЦикла;	
	Возврат ТаблицаЗначенийВМассив(ТаблицаЗаписей);
КонецФункции // сфпСофтФонПроСервер.ПолучитьСписокЗаписейТелефонногоРазговора()

// Функция формирует структуру отбора
//
// Параметры:
//	сфпПользователь		- СправочникСсылка	- Пользователь
//	сфпКонтакт			- СправочникСсылка	- Контакт
//	сфпНомерВнТелефона	- Строка			- Номер внутреннего телефона
//	сфпНомерТелефона	- Строка			- Номер внешнего телефона
//
// Возвращаемое значение:
//	Структура	- Структура отбора
//
Функция сфпСформироватьСтруктуруОтбора(сфпПользователь, сфпКонтакт, сфпНомерВнТелефона, сфпНомерТелефона)
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Пользователь",	сфпПользователь);
	СтруктураОтбора.Вставить("Контакт",			сфпКонтакт);
	СтруктураОтбора.Вставить("НомерВнТелефона",	сфпНомерВнТелефона);
	СтруктураОтбора.Вставить("НомерТелефона",	сфпНомерТелефона);
	Возврат СтруктураОтбора;
КонецФункции // сфпСформироватьСтруктуруОтбора()

// Функция формируем массив возможных отборов
//
// Параметры:
//	сфпПользователь		- СправочникСсылка	- Пользователь
//	сфпКонтакт			- СправочникСсылка	- Контакт
//	сфпНомерВнТелефона	- Строка			- Номер внутреннего телефона
//	сфпНомерТелефона	- Строка			- Номер внешнего телефона
//
// Возвращаемое значение:
//	Массив	- Массив отборов
//
Функция сфпСформироватьМассивОтборов(сфпПользователь, сфпКонтакт, сфпНомерВнТелефона, сфпНомерТелефона)
	МассивОтборов = Новый Массив;
	МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, "", ""));														// 1 0 0 0
	Если ЗначениеЗаполнено(сфпКонтакт) Тогда
		МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, сфпКонтакт, "", ""));													// 1 1 0 0
		МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), сфпКонтакт, "", ""));							// 0 1 0 0
		Если ЗначениеЗаполнено(сфпНомерВнТелефона) Тогда
			МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, сфпКонтакт, сфпНомерВнТелефона, ""));								// 1 1 1 0
			МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, сфпНомерВнТелефона, ""));								// 1 0 1 0
			МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), сфпКонтакт, сфпНомерВнТелефона, ""));		// 0 1 1 0
			МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, сфпНомерВнТелефона, ""));		// 0 0 1 0
			Если ЗначениеЗаполнено(сфпНомерТелефона) Тогда
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, сфпКонтакт, сфпНомерВнТелефона, сфпНомерТелефона));								// 1 1 1 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, сфпНомерВнТелефона, сфпНомерТелефона));							// 1 0 1 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), сфпКонтакт, сфпНомерВнТелефона, сфпНомерТелефона));		// 0 1 1 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, сфпНомерВнТелефона, сфпНомерТелефона));	// 0 0 1 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, сфпКонтакт, "", сфпНомерТелефона));												// 1 1 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, "", сфпНомерТелефона));											// 1 0 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), сфпКонтакт, "", сфпНомерТелефона));						// 0 1 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, "", сфпНомерТелефона));					// 0 0 0 1
			КонецЕсли;
		Иначе	
			Если ЗначениеЗаполнено(сфпНомерТелефона) Тогда
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, сфпКонтакт, "", сфпНомерТелефона));								// 1 1 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, "", сфпНомерТелефона));							// 1 0 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), сфпКонтакт, "", сфпНомерТелефона));		// 0 1 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, "", сфпНомерТелефона));	// 0 0 0 1
			КонецЕсли;
		КонецЕсли;
	Иначе	
		Если ЗначениеЗаполнено(сфпНомерВнТелефона) Тогда
			МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, сфпНомерВнТелефона, ""));								// 1 0 1 0
			МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, сфпНомерВнТелефона, ""));		// 0 0 1 0
			Если ЗначениеЗаполнено(сфпНомерТелефона) Тогда
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, сфпНомерВнТелефона, сфпНомерТелефона));							// 1 0 1 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, сфпНомерВнТелефона, сфпНомерТелефона));	// 0 0 1 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, "", сфпНомерТелефона));											// 1 0 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, "", сфпНомерТелефона));					// 0 0 0 1
			КонецЕсли;
		Иначе	
			Если ЗначениеЗаполнено(сфпНомерТелефона) Тогда
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(сфпПользователь, Неопределено, "", сфпНомерТелефона));							// 1 0 0 1
				МассивОтборов.Добавить(сфпСформироватьСтруктуруОтбора(Справочники.Пользователи.ПустаяСсылка(), Неопределено, "", сфпНомерТелефона));	// 0 0 0 1
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат МассивОтборов;
КонецФункции // сфпСформироватьСтруктуруОтбора()

// Функция определяет записывается ли телефонный разговор
//
// Параметры:
//	сфпКонтакт			- СправочникСсылка	- Контакт
//	сфпНомерВнТелефона	- Строка			- Номер внутреннего телефона
//	сфпНомерТелефона	- Строка			- Номер внешнего телефона
//
// Возвращаемое значение:
//	Булево	- Признак необходимости записи разговора
//
Функция сфпТелефонныйРазговорЗаписывается(сфпКонтакт = Неопределено, сфпНомерВнТелефона = "", сфпНомерТелефона = "") Экспорт
	// Преобразуем номера телефона в формату номеров в регистре
	Если ЗначениеЗаполнено(сфпНомерВнТелефона) Тогда
		сфпНомерВнТелефона = Прав(сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(сфпНомерВнТелефона), Константы.CRM_МаксимальнаяДлинаВнутреннегоНомера.Получить());
	КонецЕсли;
	Если ЗначениеЗаполнено(сфпНомерТелефона) Тогда
		сфпНомерТелефона = Прав(сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(сфпНомерТелефона), Константы.CRM_КоличествоХранимыхЦифрТелефона.Получить());
	КонецЕсли;	
	сфпПользователь	= сфпТекущийПользователь();
	МассивОтборов = сфпСформироватьМассивОтборов(сфпПользователь, сфпКонтакт, сфпНомерВнТелефона, сфпНомерТелефона);	
	НаборЗаписей = РегистрыСведений.сфпПравилаЗаписиТелефонныхПереговоров.СоздатьНаборЗаписей();
	// Проверяем на соответствие какому-нибудь отбору
	Для Каждого ОтборМассива Из МассивОтборов Цикл
		Если ЗначениеЗаполнено(ОтборМассива.Пользователь) Тогда
			НаборЗаписей.Отбор.Пользователь.Использование 	= Истина;
			НаборЗаписей.Отбор.Пользователь.Значение      	= ОтборМассива.Пользователь;
		Иначе	
			НаборЗаписей.Отбор.Пользователь.Использование 	= Ложь;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ОтборМассива.Контакт) Тогда
			НаборЗаписей.Отбор.Контакт.Использование 	= Истина;
			НаборЗаписей.Отбор.Контакт.Значение      	= ОтборМассива.Контакт;
		Иначе	
			НаборЗаписей.Отбор.Контакт.Использование 	= Ложь;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ОтборМассива.НомерВнТелефона) Тогда
			НаборЗаписей.Отбор.НомерВнТелефона.Использование 	= Истина;
			НаборЗаписей.Отбор.НомерВнТелефона.Значение      	= ОтборМассива.НомерВнТелефона;
		Иначе	
			НаборЗаписей.Отбор.НомерВнТелефона.Использование 	= Ложь;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ОтборМассива.НомерТелефона) Тогда
			НаборЗаписей.Отбор.НомерТелефона.Использование 	= Истина;
			НаборЗаписей.Отбор.НомерТелефона.Значение      	= ОтборМассива.НомерТелефона;
		Иначе	
			НаборЗаписей.Отбор.НомерТелефона.Использование 	= Ложь;
		КонецЕсли;	
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			Возврат Истина;
		КонецЕсли;	
	КонецЦикла;	
	Возврат Ложь;
КонецФункции // сфпТелефонныйРазговорЗаписывается()	

// Процедура добавляет в регистр запись о разговоре
//
// Параметры:
//	СтруктураЗвонка	- Структура	- Структура звонка
//
Процедура сфпДобавитьЗаписьРазговораВРегистр(СтруктураЗвонка) Экспорт
	ТекПользователь = сфпТекущийПользователь();
	НоваяЗапись = РегистрыСведений.сфпЗаписиТелефонныхПереговоров.СоздатьМенеджерЗаписи();
	НоваяЗапись.ИдентификаторЗвонка = СтруктураЗвонка.hCall;
	НоваяЗапись.ИдентификаторЗаписи	= "-1";
	НоваяЗапись.Пользователь		= ТекПользователь;
	НоваяЗапись.НомерВнТелефона		= СтруктураЗвонка.LineID;
	НоваяЗапись.НачалоЗаписи		= сфпТекущаяДата();
	НоваяЗапись.Контакт				= СтруктураЗвонка.Контакт;
	НоваяЗапись.НомерТелефона		= СтруктураЗвонка.НомерТелефона;
	НоваяЗапись.ИмяЛинии			= СтруктураЗвонка.LineName;
	Попытка
		НоваяЗапись.Записать(Истина);
	Исключение
	КонецПопытки;	
КонецПроцедуры

// Процедура обновляет запись о разговоре в регистре
//
// Параметры:
//	СтруктураЗвонка	- Структура	- Структура звонка
//
Процедура сфпОбновитьЗаписьРазговораВРегистре(СтруктураЗвонка) Экспорт
	ТекПользователь = сфпТекущийПользователь();
	НоваяЗапись = РегистрыСведений.сфпЗаписиТелефонныхПереговоров.СоздатьМенеджерЗаписи();
	НоваяЗапись.ИдентификаторЗвонка = СтруктураЗвонка.hCall;
	НоваяЗапись.ИдентификаторЗаписи	= "-1";
	НоваяЗапись.Прочитать();
	Если НоваяЗапись.Выбран() Тогда
		НоваяЗапись.ИдентификаторЗаписи	= СтруктураЗвонка.RecordID;
		НоваяЗапись.НачалоЗаписи		= СтруктураЗвонка.TimeStart;
		Попытка
			НоваяЗапись.Записать(Истина);
		Исключение
		КонецПопытки;	
	КонецЕсли;
КонецПроцедуры
	
// Процедура обновляет продолжительность разговора в регистре
//
// Параметры:
//	СтруктураЗвонка	- Структура	- Структура звонка
//
Процедура сфпЗаписатьПродолжительностьРазговора(СтруктураЗвонка) Экспорт
	НоваяЗапись = РегистрыСведений.сфпЗаписиТелефонныхПереговоров.СоздатьМенеджерЗаписи();
	НоваяЗапись.ИдентификаторЗвонка = СтруктураЗвонка.hCall;
	НоваяЗапись.ИдентификаторЗаписи	= СтруктураЗвонка.RecordID;
	НоваяЗапись.Прочитать();
	Если НоваяЗапись.Выбран() Тогда
		Если НЕ (НоваяЗапись.ПродолжительностьЗаписи = (СтруктураЗвонка.DurationTalk / 1000)) Тогда
			НоваяЗапись.ПродолжительностьЗаписи	= (СтруктураЗвонка.DurationTalk / 1000);
			Попытка
				НоваяЗапись.Записать(Истина);
			Исключение
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция получает идентификатор звонка по идентификатору записи разговора
//
// Параметры:
//	ИдентификаторЗаписи	- Строка	- Идентификатор записи разговора
//
// Возвращаемое значение:
// 	Число	- Идентификатор звонка
//
Функция сфпПолучитьИдентификаторЗвонка(ИдентификаторЗаписи) Экспорт
	Если ИдентификаторЗаписи = "-1" Тогда Возврат 0; КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка
	               |ИЗ
	               |	РегистрСведений.сфпЗаписиТелефонныхПереговоров КАК сфпЗаписиТелефонныхПереговоров
	               |ГДЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи = &ИдентификаторЗаписи";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторЗвонка;
	КонецЕсли;	
	Возврат 0;
КонецФункции // сфпПолучитьИдентификаторЗвонка()	

// Функция получает время начала разговора по идентификатору звонка
//
// Параметры:
//	ИдентификаторЗвонка	- Число	- Идентификатор звонка
//
Функция сфпПолучитьВремяНачалаРазговора(ИдентификаторЗвонка) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторЗвонка",	ИдентификаторЗвонка);
	Запрос.УстановитьПараметр("НачалоДня", 				сфпТекущаяДата() - 86400);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпЗаписиТелефонныхПереговоров.НачалоЗаписи КАК ВремяНачалаЗвонка
	               |ИЗ
	               |	РегистрСведений.сфпЗаписиТелефонныхПереговоров КАК сфпЗаписиТелефонныхПереговоров
	               |ГДЕ
	               |	сфпЗаписиТелефонныхПереговоров.ИдентификаторЗвонка = &ИдентификаторЗвонка
	               |	И сфпЗаписиТелефонныхПереговоров.ИдентификаторЗаписи = ""-1""
	               |	И сфпЗаписиТелефонныхПереговоров.НачалоЗаписи >= &НачалоДня";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВремяНачалаЗвонка;
	Иначе	
		Возврат сфпТекущаяДата();
	КонецЕсли;	
КонецФункции // сфпПолучитьВремяНачалаРазговора()	

// Процедура удаляет запись разговора в регистре
//
// Параметры:
//	ИдентификаторЗвонка	- Число		- Идентификатор звонка
//	ИдентификаторЗаписи	- Строка	- Идентификатор записи разговора
//
Процедура сфпУдалитьЗаписьРазговораВРегистре(ИдентификаторЗвонка, ИдентификаторЗаписи) Экспорт
	НаборЗаписей = РегистрыСведений.сфпЗаписиТелефонныхПереговоров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторЗвонка.Установить(ИдентификаторЗвонка);
	НаборЗаписей.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	Попытка
		НаборЗаписей.Записать();
	Исключение
	КонецПопытки;	
КонецПроцедуры // сфпУдалитьЗаписьРазговораВРегистре()

