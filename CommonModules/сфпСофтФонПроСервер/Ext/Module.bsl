// Функция изменяет внутренний номер пользователя
//
// Параметры:
//	НомерЛинии	- Строка	- Номер линии
//
// Возвращаемое значение:
//	Булево	- Признак изменения внутреннего номера пользователя
//
Функция сфпЗаписатьНомерТекущемуПользователю(НомерЛинии) Экспорт
	НомерИзменен = Ложь;
	// Записываем новый номер только, если он не пустой
	Если НЕ ПустаяСтрока(НомерЛинии) Тогда
		ТекПользователь = сфпТекущийПользователь();
		Если НЕ (ТекПользователь.сфпТекущийВнутреннийНомер = НомерЛинии) Тогда
			ОбъектПользователь = ТекПользователь.ПолучитьОбъект();
			ОбъектПользователь.сфпТекущийВнутреннийНомер = НомерЛинии;
			Попытка
				ОбъектПользователь.Записать();
				НомерИзменен = Истина;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Возврат НомерИзменен;
КонецФункции // сфпЗаписатьНомерТекущемуПользователю()

// Функция возвращает список маршрутизации
//
// Параметры:
//	Объект			- СправочникСсылка	- Владелец контактной информации
//	Пользователь	- СправочникСсылка	- Пользователь для переключения звонков
//
// Возвращаемое значение:
//	Строка	- Строка маршрутизации
//
Функция сфпПолучитьСписокМаршрутизации(Объект = Неопределено, Пользователь = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпНомераТелефоновДляПоиска.Объект КАК Контакт,
	               |	сфпНомераТелефоновДляПоиска.Пользователь.сфпТекущийВнутреннийНомер КАК НомерВнТелефона,
	               |	сфпНомераТелефоновДляПоиска.Представление
	               |ИЗ
	               |	РегистрСведений.сфпНомераТелефоновДляПоиска КАК сфпНомераТелефоновДляПоиска";
	Если ЗначениеЗаполнено(Объект) Тогда				   
		Запрос.Текст = Запрос.Текст + "
	               |ГДЕ
	               |	НЕ сфпНомераТелефоновДляПоиска.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	               |	И сфпНомераТелефоновДляПоиска.Объект = &Объект";
	ИначеЕсли ЗначениеЗаполнено(Пользователь) Тогда				   
		Запрос.Текст = Запрос.Текст + "
	               |ГДЕ
	               |	сфпНомераТелефоновДляПоиска.Пользователь = &Пользователь";
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	СписокСтрока = "";
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.НомерВнТелефона) Тогда Продолжить; КонецЕсли;
		СтруктураНомера = сфпЗаполнитьСтруктуруПолейПоПредставлениюТелефон(Выборка.Представление);
		НомерТелефона = СтрЗаменить(СтруктураНомера.КодСтраны, "+", "") + СтруктураНомера.КодГорода + СтруктураНомера.НомерТелефона;
		Если ПустаяСтрока(НомерТелефона) Тогда Продолжить; КонецЕсли;
		СписокСтрока = СписокСтрока + НомерТелефона + "=" + СокрЛП(Выборка.НомерВнТелефона) + ";";
	КонецЦикла;
	Возврат СписокСтрока;
КонецФункции // сфпПолучитьСписокМаршрутизации()

// Процедура меняет пользователя для переключения у выбранного объекта
//
// Параметры:
//	Объект			- СправочникСсылка	- Объект, у которого меняется пользователь для переключения звонков
//	Пользователь	- СправочникСсылка	- Пользователь для переключения звонков
//
Процедура сфпИзменитьТаблицуМаршрутизации(Объект, Пользователь) Экспорт
	НаборМаршрутизации = РегистрыСведений.сфпНомераТелефоновДляПоиска.СоздатьНаборЗаписей();
	НаборМаршрутизации.Отбор.Объект.Установить(Объект);
	НаборМаршрутизации.Прочитать();
	Для Каждого СтрокаНабора Из НаборМаршрутизации Цикл
		СтрокаНабора.Пользователь = Пользователь;
	КонецЦикла;	
	НаборМаршрутизации.Записать();
КонецПроцедуры // сфпИзменитьТаблицуМаршрутизации()

// Функция возвращает признак наличия взаимодействий по пользователю
//
// Параметры:
//	Ссылка	- СправочникСсылка	- Клиент, для которого определяются взаимодейтсвия
//
// Возвращаемое значение:
//	Булево	- Признак наличия определенного количества взаимодействий
//
Функция сфпЕстьВзаимодействияПоПользователю(Ссылка) Экспорт
	КоличествоВзаимодействий = Константы.сфпКоличествоВзаимодействийДляМаршрутизации.Получить();
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контакт", сфпПолучитьКонтактноеЛицоИлиПартнера(Ссылка));	   
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.Событие") Тогда
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Строка(КоличествоВзаимодействий) + "
		        |	Событие.Автор,
		        |	Событие.Ссылка
		        |ИЗ
		        |	Документ.Событие КАК Событие
		        |ГДЕ
		        |	(Событие.Контрагент = &Контакт
		        |			ИЛИ Событие.КонтактноеЛицо = &Контакт)
		        |	И НЕ Событие.ПометкаУдаления
		        |
		        |УПОРЯДОЧИТЬ ПО
		        |	Событие.Дата УБЫВ";
	КонецЕсли;
	Запрос.Текст = Текст;
	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	Если ТЗ.Количество() < КоличествоВзаимодействий Тогда
		Возврат Ложь;
	КонецЕсли;
	ТЗ.Свернуть("Автор");
	Если (ТЗ.Количество() = 1) И (ТЗ[0].Автор = Ссылка.Автор) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции // сфпЕстьВзаимодействияПоПользователю() 

// Процедура изменяет пользователя для переключения звонков
//
// Параметры:
//	Контакт			- СправочникСсылка	- Клиент, звонки которого переключаются
//	Пользователь	- СправочникСсылка	- Пользователь, на котрого переключаются звонки
//
Процедура сфпИзменитьПользователяДляПереключенияЗвонков(Контакт, Пользователь) Экспорт
	Если НЕ (Контакт.сфпПользовательДляПереключенияЗвонков = Пользователь) Тогда
		Объект = Контакт.ПолучитьОбъект();
		Объект.сфпПользовательДляПереключенияЗвонков = Пользователь;
		Попытка
			Объект.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры // сфпИзменитьПользователяДляПереключенияЗвонков()

