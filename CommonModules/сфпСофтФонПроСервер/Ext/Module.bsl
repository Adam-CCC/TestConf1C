// АДРЕСНАЯ КНИГА

// Процедура формирует и сохраняет файл адресной книги для загрузки в сервер СофтФона
//
// Параметры:
//	ИмяФайла			- Строка	- Имя файла на диске для сохранения адресной книги
//	ИмяАдреснойКниги	- Строка	- Имя адресной книги
//
Процедура сфпСохранитьАдреснуюКнигуВФайл(ИмяФайла, ИмяАдреснойКниги) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	сфпНомераТелефоновДляПоиска.Объект,
	               |	сфпНомераТелефоновДляПоиска.Вид,
	               |	сфпНомераТелефоновДляПоиска.Представление
	               |ИЗ
	               |	РегистрСведений.сфпНомераТелефоновДляПоиска КАК сфпНомераТелефоновДляПоиска
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	сфпНомераТелефоновДляПоиска.Объект,
	               |	сфпНомераТелефоновДляПоиска.Вид";
	Выборка = Запрос.Выполнить().Выбрать();
	ФайлАдресов = Новый ТекстовыйДокумент; 
	Пока Выборка.Следующий() Цикл
		СтрокаКниги = """" + СтрЗаменить(Выборка.Объект.Наименование, """", "'") + """,{" + Выборка.Объект.УникальныйИдентификатор() + "},""" 
			+ ИмяАдреснойКниги + """,""" + Выборка.Вид.Наименование + """," 
			+ сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(Выборка.Представление) + ","
			+ СтрЗаменить(сфпПолучитьАватарКонтакта(Выборка.Объект), Символы.ПС, "");
		ФайлАдресов.ДобавитьСтроку(СтрокаКниги);
	КонецЦикла;
	Попытка
		ФайлАдресов.Записать(ИмяФайла,  КодировкаТекста.Системная); 
	Исключение
	КонецПопытки;	
КонецПроцедуры	// сфпСохранитьАдреснуюКнигуВФайл()
