Функция СоздатьПотенциальногоКонтрагентаПоРабочемуЛисту(Знач РабочийЛист, Знач ДатаСоздания) Экспорт
	
	//Функция более не используется
	
	//Первоначальная инициализация
	СсылкаНаПотенциальногоКонтрагента = Справочники.CRM_ПотенциальныеКонтрагенты.ПустаяСсылка();
	
	// Комментарий 
	//Дата создания - 23.04.2013 9:51:29; Автор - Администратор информационной базы
	//
	//Для начала получим данные из рабочего листа.
	//
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_РабочиеЛисты.Удалить_ФИО,
	|	Renault_РабочиеЛисты.Клиент,
	|	Renault_РабочиеЛисты.Удалить_Телефон,
	|	Renault_РабочиеЛисты.Удалить_Email
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.IDK = &ИДК"
	);
	Запрос.УстановитьПараметр("ИДК", Число(РабочийЛист));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		
		// Комментарий 
		//Дата создания - 23.04.2013 10:28:35; Автор - Администратор информационной базы
		//
		// Блок проверок заполненности данных
		//
		Если ЗначениеЗаполнено(Выборка.Клиент) тогда
			Возврат Выборка.Клиент;
		КонецЕсли;
		
		ФИО = СокрЛП(Выборка.ФИО);
		Если НЕ ЗначениеЗаполнено(ФИО) тогда 
			ФИО = "Потенциальный клиент по РЛ №" + Строка(РабочийЛист);
		КонецЕсли;
		ФИОСтарое = ФИО;
		
		//Нужно разделить ФИО на отдельные поля. Это нужно для поиска.
		// Комментарий 
		//Дата создания - 23.04.2013 10:40:07; Автор - Администратор информационной базы
		//
		// Все проверки прошли, начинаем создание
		//
		
		Фамилия = "";
		Имя = "";
		Отчество = "";
		
		Если НЕ СтрДлина(ФИО) = 0 тогда
			ПозицияПробела = Найти(ФИО, " ");
		Иначе
			ПозицияПробела = 0;
		КонецЕсли;
		Если НЕ ПозицияПробела = 0 Тогда
			
			Фамилия = СокрЛП(Лев(ФИО, ПозицияПробела));
			ФИО = СокрЛП(СтрЗаменить(ФИО, Фамилия, ""));
			
		КонецЕсли;
		
		Если НЕ СтрДлина(ФИО) = 0 тогда
			ПозицияПробела = Найти(ФИО, " ");
		Иначе
			ПозицияПробела = 0;
		КонецЕсли;
		Если НЕ ПозицияПробела = 0 Тогда
			
			Имя = СокрЛП(Лев(ФИО, ПозицияПробела));
			ФИО = СокрЛП(СтрЗаменить(ФИО, Имя, ""));
			
		КонецЕсли;
		
		Если НЕ СтрДлина(ФИО) = 0 тогда
			ПозицияПробела = Найти(ФИО, " ");
		Иначе
			ПозицияПробела = 0;
		КонецЕсли;
		Если НЕ ПозицияПробела = 0 Тогда
			
			Отчество = СокрЛП(Лев(ФИО, ПозицияПробела));
			ФИО = СокрЛП(СтрЗаменить(ФИО, Отчество, ""));
			
		КонецЕсли;
		
		//Проверим Заполненность фамилии, если пустая, значит пробелов не нашли - 
		// копируем все ФИО
		
		Фамилия = ?(ЗначениеЗаполнено(Фамилия), Фамилия, ФИО);
		
		НачатьТранзакцию();
		
		ПотенциальныйКонтрагентОбъект = Справочники.CRM_ПотенциальныеКонтрагенты.СоздатьЭлемент();
		
		ФИО = Фамилия + " " + Имя + " " + Отчество;
		ПотенциальныйКонтрагентОбъект.Наименование	 = СокрЛП(ФИО);
		ПотенциальныйКонтрагентОбъект.Наименование	 = ФИОСтарое;
		
		ПотенциальныйКонтрагентОбъект.Фамилия		 = Фамилия;
		ПотенциальныйКонтрагентОбъект.Имя			 = Имя;
		ПотенциальныйКонтрагентОбъект.Отчество		 = Отчество;
		ПотенциальныйКонтрагентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
		ПотенциальныйКонтрагентОбъект.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
		
		ПотенциальныйКонтрагентОбъект.Записать();
		
		СсылкаНаПотенциальногоКонтрагента = ПотенциальныйКонтрагентОбъект.Ссылка;
		
		//Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		//Менеджер.Объект = СсылкаНаПотенциальногоКонтрагента;
		//Менеджер.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		//Менеджер.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
		//Если ЗначениеЗаполнено(Выборка.Телефон) Тогда
		//	Менеджер.Представление = Выборка.Телефон;
		//	Менеджер.Записать(Истина);
		//Иначе
		//	Менеджер.Удалить();
		//КонецЕсли;
		//
		//Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		//Менеджер.Объект = СсылкаНаПотенциальногоКонтрагента;
		//Менеджер.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		//Менеджер.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний;
		//Если ЗначениеЗаполнено(Выборка.Email) Тогда
		//	Менеджер.Представление = Выборка.Email;
		//	Менеджер.Записать(Истина);
		//Иначе
		//	Менеджер.Удалить();
		//КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
	Возврат СсылкаНаПотенциальногоКонтрагента;
	
КонецФункции // СоздатьПотенциальногоКонтрагентаПоРабочемуЛисту(РабочийЛист, ДатаСоздания)

Функция СоздатьПотенциальногоКонтрагентаПоТрафику(Знач ТрафикID) Экспорт
	
	СсылкаНаПотенциальногоКонтрагента = Справочники.CRM_ПотенциальныеКонтрагенты.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_Трафик.Клиент,
	               |	Renault_Трафик.Представление,
	               |	Renault_Трафик.ПервичныйИнтерес,
	               |	Renault_Трафик.ИсточникИнформации,
	               |	Renault_Трафик.ТипТрафика
	               |ИЗ
	               |	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	               |ГДЕ
	               |	Renault_Трафик.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ТрафикID);
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.Клиент) тогда
			Возврат Выборка.Клиент;
		КонецЕсли;
		
		//Получим реквизиты трафика
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CRM_ЗначенияРеквизитовТрафика.РеквизитТрафика,
		               |	CRM_ЗначенияРеквизитовТрафика.ЗначениеРеквизита
		               |ИЗ
		               |	РегистрСведений.CRM_ЗначенияРеквизитовТрафика КАК CRM_ЗначенияРеквизитовТрафика
		               |ГДЕ
		               |	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика = &ИдентификаторТрафика";
		Запрос.УстановитьПараметр("ИдентификаторТрафика", ТрафикID);
		ТаблицаРеквизитов = Запрос.Выполнить().Выгрузить();
		
		СтрокаПол = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Пол);
		Если СтрокаПол = Неопределено Тогда
			Пол = Неопределено;
		Иначе
			Пол = СтрокаПол.ЗначениеРеквизита;
		КонецЕсли;
		
		СтрокаТелефон = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Телефон);
		Если СтрокаТелефон = Неопределено Тогда
			Телефон = Неопределено;
		Иначе
			Телефон = СтрокаТелефон.ЗначениеРеквизита;
		КонецЕсли;
		
		КлиентОбъект = Справочники.CRM_ПотенциальныеКонтрагенты.СоздатьЭлемент();
		
		ФИО = СокрЛП(Выборка.Представление);
		Если Не ЗначениеЗаполнено(ФИО) Тогда
			ФИО = "Не заполнено";
		Иначе
			//Попробуем разбить на Фамилию - Имя - Отчество
			Фамилия = "";
			Имя = "";
			Отчество = "";
			РазбитьФИО(ФИО, Фамилия, Имя, Отчество);			
		КонецЕсли;
		
		КлиентОбъект.Наименование = ФИО;
		КлиентОбъект.НаименованиеПолное = ФИО;
		КлиентОбъект.Фамилия = Фамилия;
		КлиентОбъект.Имя = Имя;
		КлиентОбъект.Отчество = Отчество;
		КлиентОбъект.Пол = Пол;
		КлиентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
		КлиентОбъект.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
		
		КлиентОбъект.Записать();
		
		//Телефон
		Если ЗначениеЗаполнено(Телефон) Тогда
			//Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			//Запись.Объект = КлиентОбъект.Ссылка;
			//Запись.ЗначениеПоУмолчанию = Истина;
			//Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			//Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
			//Запись.Представление = Телефон;
			//Запись.Записать(Истина);
			Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойТелефонКлиента(Телефон, КлиентОбъект.Ссылка);
		КонецЕсли;
		
		//Прочие клиентские данные
		ЗаписьКлиентскиеДанные = РегистрыСведений.CRM_КлиентскиеДанные.СоздатьМенеджерЗаписи();
		ЗаписьКлиентскиеДанные.Клиент = КлиентОбъект.Ссылка;
		ЗаписьКлиентскиеДанные.ДатаСоздания = ТекущаяДата();
		ЗаписьКлиентскиеДанные.ИсточникИнформации = Выборка.ИсточникИнформации;
		ЗаписьКлиентскиеДанные.Записать();
		
		Возврат КлиентОбъект.Ссылка;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьРуководителяОтделаПродаж(Организация) Экспорт
	
	СтруктураОтбора = Новый Структура("Организация,Объект", Организация, Перечисления.ВидыОбъектовСведений.Руководитель);
	СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее( , СтруктураОтбора);
	Возврат СтруктураСведений.Значение;
	
КонецФункции

Функция ПолучитьДокумент(Клиент, Документ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Клиент);
	Запрос.УстановитьПараметр("ВидДокумента", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПодтверждающиеДокументы.Ссылка
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Владелец
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = &ВидДокумента
	|	И ПодтверждающиеДокументы.Текущий";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ПодтверждающиеДокументы.ПустаяСсылка();
		
КонецФункции

Функция ПолучитьОписаниеДокумента(Клиент, Документ) Экспорт
	
	ДокСсылка = ПолучитьДокумент(Клиент, Документ);
	Если ЗначениеЗаполнено(ДокСсылка) Тогда
		Док = ДокСсылка.ПолучитьОбъект();
		СтрокаВыдачи = "";
		Если ЗначениеЗаполнено(Док.ДатаВыдачи) Тогда
			Если Документ = Перечисления.ВидыДокументов.Доверенность
						ИЛИ Документ = Перечисления.ВидыДокументов.Лицензия 
						ИЛИ Документ = Перечисления.ВидыДокументов.Справка Тогда
				СтрокаВыдачи = " выдана " + Формат(Док.ДатаВыдачи,"ДФ=dd.MM.yy")
			ИначеЕсли Документ = Перечисления.ВидыДокументов.Удостоверение 
						ИЛИ Документ = Перечисления.ВидыДокументов.Свидетельство Тогда
				СтрокаВыдачи = " выдано " + Формат(Док.ДатаВыдачи,"ДФ=dd.MM.yy")
			Иначе	
				СтрокаВыдачи = " выдан " + Формат(Док.ДатаВыдачи,"ДФ=dd.MM.yy") + ?(ПустаяСтрока(Док.КемВыдан),""," " + Док.КемВыдан)
			КонецЕсли;
		КонецЕсли;
		Возврат СокрЛП(Док.Серия)+" № "+СокрЛП(Док.Номер) + СтрокаВыдачи;
	Иначе
		Возврат ""
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьМаркуRenault() Экспорт
	
	Возврат Справочники.CRM_МаркаАвтомобиля.Renault;
	
