// Функция определяет и проверяет фискальный регистратор.
//
// Параметры:
//  ФУ - В эту переменную будет возвращено выбранное фискальное устройство.
//
// Возвращаемое значение:
//  Булево - Истина, если фискальное устройство выбрано.
//
Функция ПолучитьПроверитьПараметрыДляПробитияЧека(ФУ, УчитыватьККТ = Ложь) Экспорт
	
	Если УчитыватьККТ = Истина Тогда
		МассивВидовТО = Новый Массив();
		МассивВидовТО.Добавить(Перечисления.Renault_ВидыТорговогоОборудования.ФискальныйРегистратор);
		МассивВидовТО.Добавить(Перечисления.Renault_ВидыТорговогоОборудования.ККТ);
		ФУ = ПолучитьЭлементТО(МассивВидовТО,
	   		"Необходимо выбрать фискальное устройство", "Фискальное устройство не подключено!");
	Иначе
		ФУ = ПолучитьЭлементТО(Перечисления.Renault_ВидыТорговогоОборудования.ФискальныйРегистратор,
	   		"Необходимо выбрать фискальный регистратор", "Фискальный регистратор не подключен!");
	КонецЕсли;

	Возврат ЗначениеЗаполнено(ФУ);

КонецФункции // ПолучитьПроверитьПараметрыДляПробитияЧека()


