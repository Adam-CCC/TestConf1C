
Процедура Renault_PDI_ПриПроведении_ПоступленияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЭтоPDI = Ложь Тогда
		Возврат;
	КонецЕсли;
			
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИзменениеЦен.Ссылка
	|ИЗ
	|	Документ.ИзменениеЦен КАК ИзменениеЦен
	|ГДЕ
	|	ИзменениеЦен.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ИзмЦенОб = Выборка.Ссылка.ПолучитьОбъект();
		
	Иначе
		
		ИзмЦенОб = Документы.ИзменениеЦен.СоздатьДокумент();
		ИзмЦенОб.ДокументОснование = Источник.Ссылка;
		
	КонецЕсли;
	
	ИзмЦенОб.ЗаполнитьСвойстваНаОсновании(Источник.Ссылка);
	ИзмЦенОб.ОбработкаЗаполнения(Источник.Ссылка);
	ИзмЦенОб.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);	
	
КонецПроцедуры

Процедура Renault_PDI_РазблокироватьАвтоRF(VIN, Дата) Экспорт
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЭтоPDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросИД = "Select ID_AUTO from [Buddha].[Reservation].[dbo].[rf_auto] where VIN = '%1'";
	ЗапросИД = СтрЗаменить(ЗапросИД, "%1", VIN);
	
	ТаблицаРезультатИД = Renault_ВыполнениеЗапросовReservation.ВыполнитьФункцию(ЗапросИД);
	Если ТаблицаРезультатИД.Количество() = 0 Тогда
		ВызватьИсключение "В RF не найдена машина с VIN " + VIN;
	КонецЕсли;
	
	ИдМашины = ТаблицаРезультатИД[0].ID_AUTO;
	
	ЗапросПроцедура = 
		"exec [Buddha].[Reservation].[dbo].[RF_V3_Auto_AccessoryReady] 'PDI', %1, '%2', ''";
		
	ЗапросПроцедура = СтрЗаменить(ЗапросПроцедура, "%1", Формат(ИдМашины, "ЧРГ=; ЧГ="));
	ЗапросПроцедура = СтрЗаменить(ЗапросПроцедура, "%2", Формат(Дата, "ДФ=yyyyMMdd"));
	
	Renault_ВыполнениеЗапросовReservation.ВыполнитьПроцедуру(ЗапросПроцедура);

КонецПроцедуры

Процедура Renault_PDI_ВыгрузитьЗаказНарядRF(ЗаказНаряд)
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЭтоPDI = Ложь Тогда
		Возврат;
	КонецЕсли;

	ЗапросИД = "Select ID_AUTO from [Buddha].[Reservation].[dbo].[rf_auto] where VIN = '%1'";
	ЗапросИД = СтрЗаменить(ЗапросИД, "%1", ЗаказНаряд.Автомобиль.VIN);
	
	ТаблицаРезультатИД = Renault_ВыполнениеЗапросовReservation.ВыполнитьФункцию(ЗапросИД);
	Если ТаблицаРезультатИД.Количество() = 0 Тогда
		ВызватьИсключение "В RF не найдена машина с VIN " + ЗаказНаряд.Автомобиль.VIN;
	КонецЕсли;
	
	ИдМашины = ТаблицаРезультатИД[0].ID_AUTO;
	
	ТекстЗапроса = 
		"INSERT INTO [buddha].[RESERVATION].[dbo].[RF_AUTO_ACCESSORIES_DETAILS]
	   		|([ID_AUTO]
	   		|,[VIN]
	   		|,[REFERENCE]
	   		|,[PRICE_LABOUR]
	   		|,[PRICE_PART]
	   		|,[PRICE_PART_ZN]
	   		|,[DATE_BILL]
	   		|,[BILL_NUMBER]
			|,[DATE_ANNULATION]
			|,[CONTRACTOR_NAME]
			|,[CONTRACTOR_INN]
			|,[CONTRACTOR_KPP]
			|,[REQUIRE_BILL_NUMBER]
			|,[REQUIRE_BILL_DATE])
	 	|VALUES
	       |(%1 --<ID_AUTO, bigint,>
	       |,'%2' --<VIN, varchar(20),>
	       |,'%3' --<REFERENCE, varchar(20),>
	       |,%4 --<PRICE_LABOUR, numeric(18,2),>
	       |,%5 --<PRICE_PART, numeric(18,2),>
	       |,%6 --<PRICE_PART_ZN, numeric(18,2),>
	       |,'%7' --<DATE_BILL, date,>
	       |,%8 --<BILL_NUMBER, varchar(100),>
		   |,%9 --DATE_ANNULATION
		   |,#10
		   |,#11
		   |,#12
		   |,#13
		   |,#14)";
	
	Выборка = РегистрыНакопления.Продажи.ВыбратьПоРегистратору(ЗаказНаряд);
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Авторабота) Тогда
			ТекстЗапроса1 = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстЗапроса,
				Формат(ИдМашины, "ЧРД=.; ЧГ="),
				ЗаказНаряд.Автомобиль.VIN,
				Выборка.Авторабота.Артикул,
				Формат(Выборка.Сумма,"ЧРД=.; ЧГ="),
				0,
				0,
				Формат(ЗаказНаряд.ДатаЗакрытия,"ДФ=yyyyMMdd"),
				Формат(ЗаказНаряд.Номер,"ЧРД=.; ЧГ=") ,
				"null");
				
			ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#10", "'name'");	
			ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#11", "'inn'");
			ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#12", "'kpp'");		
			ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#13", "null");
			ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#14", "null");
			
		//ИначеЕсли ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
		//	ТекстЗапроса1 = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		//		ТекстЗапроса,
		//		Формат(ИдМашины, "ЧГ="),
		//		ЗаказНаряд.Автомобиль.VIN,
		//		Выборка.Номенклатура.Артикул,
		//		0,
		//		Формат(Выборка.Сумма, "ЧРД=.; ЧГ="),
		//		Формат(Выборка.Себестоимость, "ЧРД=.; ЧГ="),
		//		Формат(ЗаказНаряд.ДатаЗакрытия,"ДФ=yyyyMMdd"),
		//		Формат(ЗаказНаряд.Номер, "ЧРД=.; ЧГ="),
		//		"null");
		//		
		//	ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#10", "inn");
		//	ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#11", "kpp");
		//	
		//	Запрос = Новый Запрос;
		//	
		//	ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#12", "null");
		//	ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#13", "null");	
				
		КонецЕсли;
		
		Renault_ВыполнениеЗапросовReservation.ВыполнитьПроцедуру(ТекстЗапроса1);
			
	КонецЦикла;
	
	// получим партии
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПартииТоваровКомпании.Номенклатура.Артикул КАК Артикул,
	|	ПартииТоваровКомпании.Номенклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ПартииТоваровКомпании.Номенклатура,
	|	ПартииТоваровКомпании.Количество,
	|	ПартииТоваровКомпании.Сумма,
	|	ПартииТоваровКомпании.Партия КАК Партия
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании КАК ПартииТоваровКомпании
	|ГДЕ
	|	ПартииТоваровКомпании.ДокументПродажи = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЗаказНаряд);
	ПартииНоменклатуры = Запрос.Выполнить().Выгрузить();	
	
	Для Каждого СтрокаТовары ИЗ ПартииНоменклатуры Цикл
				
		ТекстЗапроса1 = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ТекстЗапроса,
			Формат(ИдМашины, "ЧГ="),
			ЗаказНаряд.Автомобиль.VIN,
			СтрокаТовары.Номенклатура.Артикул,
			0,
			Формат(СтрокаТовары.Сумма, "ЧРД=.; ЧГ="),
			Формат(СтрокаТовары.Сумма, "ЧРД=.; ЧГ="),
			Формат(ЗаказНаряд.ДатаЗакрытия,"ДФ=yyyyMMdd"),
			Формат(ЗаказНаряд.Номер, "ЧРД=.; ЧГ="),
			"null");
			
		ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#10", "'name'");	
		ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#11", "'inn'");
		ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#12", "'kpp'");
		
		Запрос = Новый Запрос;
		
		ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#13", "'" + СтрокаТовары.Партия.ВхДокНомер + "'");
		ТекстЗапроса1 = СтрЗаменить(ТекстЗапроса1, "#14", "'" + Формат(СтрокаТовары.Партия.ВхДокДата,"ДФ=yyyyMMdd") + "'");
		
		Renault_ВыполнениеЗапросовReservation.ВыполнитьПроцедуру(ТекстЗапроса1);
			
	КонецЦикла;

	
КонецПроцедуры

Процедура Renault_PDI_ПриПроведенииЗаказНарядаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЭтоPDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда	
		РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.ДобавитьЗапись(Источник.Ссылка);
	Иначе
		РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.УдалитьЗапись(Источник.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура Renault_PDI_ВыгрузкаЗаказНарядов(Параметр1 = Неопределено) Экспорт
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЭтоPDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказНаряд = РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.ПолучитьОчереднуюЗапись();
	Если ЗаказНаряд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Renault_PDI_РазблокироватьАвтоRF(ЗаказНаряд.Автомобиль.VIN, ЗаказНаряд.ДатаЗакрытия);		
	Renault_PDI_ВыгрузитьЗаказНарядRF(ЗаказНаряд);
	
	РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.УстановитьДатуОтправки(ЗаказНаряд, ТекущаяДата());
	
КонецПроцедуры

Процедура Renault_PDI_ПриОтменеПроведенияЗаказНарядаОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЭтоPDI = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.УдалитьЗапись(Источник.Ссылка);
	
	ТекстЗапроса = 
		"Update [buddha].[RESERVATION].[dbo].[RF_AUTO_ACCESSORIES_DETAILS] 
		| set DATE_ANNULATION = '%1'
		| where VIN = '%2' and BILL_NUMBER = '%3'";
		
	ТекстЗапроса = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ТекстЗапроса, 
		Формат(ТекущаяДата(), "ДФ=yyyyMMdd"),
		Источник.Автомобиль.VIN,
		Источник.Номер);
		
	Renault_ВыполнениеЗапросовReservation.ВыполнитьПроцедуру(ТекстЗапроса);
		
	
КонецПроцедуры
