Функция СписокПолейЗапроса(Знач ТекстЗапроса)
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса,",",Символы.ПС);
	ТекстЗапроса=СтрЗаменить(ТекстЗапроса," ",Символы.ПС);
	Массив=Новый Массив;
	Для Н=1 По СтрЧислоСтрок(ТекстЗапроса) Цикл
		Стр=СтрПолучитьСтроку(ТекстЗапроса,Н);
		Если Стр="" Тогда Продолжить КонецЕсли;
		Если Врег(Стр)="ВЫБРАТЬ" Тогда Продолжить КонецЕсли;
		Если Врег(Стр)="КАК" Тогда Продолжить КонецЕсли;
		Если Врег(Стр)="ПЕРВЫЕ" Тогда Продолжить КонецЕсли;
		ЭтоЧисло=Ложь; Попытка ы=Число(Лев(Стр,1)); ЭтоЧисло=Истина Исключение КонецПопытки; 
		Если Число(Лев(Стр,1)) Тогда Продолжить КонецЕсли;
		Если Врег(Стр)="ИЗ" Тогда Прервать КонецЕсли;
		Если Врег(Стр)="ПОМЕСТИТЬ" Тогда Прервать КонецЕсли;
		Если Массив.Найти(Стр)=Неопределено Тогда Массив.Добавить(Стр) КонецЕсли
	КонецЦикла;
	Возврат Массив
КонецФункции	
Функция СтруктураЗапроса(ТекстЗапроса)
	Структура=Новый Структура;
	
	Стр=Врег(ТекстЗапроса);
	Стр=СтрЗаменить(Стр,Символы.ПС," ");
	
	ПозУсловия=Найти(Стр," ГДЕ ");
	Если ПозУсловия>0 Тогда
		СтрУсловий=СокрЛП(Сред(Стр,ПозУсловия+5));
		Структура.Вставить("Условия",СтрУсловий);
		Стр=Лев(Стр,ПозУсловия-1);
	КонецЕсли;	
	
	ПозИЗ=Найти(Стр," ИЗ ");
	Стр=Сред(Стр,ПозИЗ+4);
	СтрИсточник=СокрЛП(?(ПозУсловия=0,Стр,Лев(Стр,ПозУсловия-1)));
	Структура.Вставить("ИсточникДанных",СтрИсточник);
	
	Возврат Структура
КонецФункции	

