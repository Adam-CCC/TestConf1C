//внешний вызов выгрузки по источникам
Функция ВыгрузкаВыполнена(Источники,Перезапись=Ложь) Экспорт //Источники - Выборка с полем ссылки или массив Ссылок
	СоответствиеСсылок=Новый Соответствие;
	НомерПакета=ТекущаяДата();
	Для Каждого Источник Из Источники Цикл
		Попытка //у источника может не быть ссылки (РегистрСведений)
			Если СоответствиеСсылок.Получить(Источник.Ссылка)<>Неопределено Тогда Продолжить КонецЕсли; //Ссылка уже загружена
		Исключение КонецПопытки; 
		
		Если ТипЗнч(Источник)=Тип("ВнешнийИсточникДанныхТаблицаСсылка.Renault_ПередачаДанныхВСторонниеСистемы.ОбъектыМД") Тогда 
		//явно указанный ВнешнийИсточникДанных	
			Если СтруктураМетаданных(Источник.Имя).Тип="РегистрСведений" Тогда
				//РегистрСведений
				внСсылка=ПолучитьВнешнююСсылкуРегистраСведений(Источник,НомерПакета);
				Если внСсылка=Неопределено Тогда Возврат Ложь КонецЕсли;
				Если Не ЗаписатьВнешниеДанныеРегистраСведений(Источник,Неопределено,внСсылка,НомерПакета,СоответствиеСсылок,Перезапись) Тогда Возврат Ложь КонецЕсли;
			Иначе //Объектный тип (Справочник, Док... )
				Запрос=Новый Запрос("Выбрать Ссылка Из "+Источник.Имя);
				Выборка=Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					Если ПолучитьВнешнееЗначение(Выборка.Ссылка,НомерПакета,СоответствиеСсылок,Перезапись)=Неопределено Тогда Возврат Ложь КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
			
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(Источник.Метаданные()) Тогда
		//РегистрыСведений
		
			ИмяМД=СсылкаВМетаданныеСтрокой(Источник);
			ОбъектМД=ОбъектМД(ИмяМД);
		
			внСсылка=ПолучитьВнешнююСсылкуРегистраСведений(ОбъектМД,НомерПакета);
			Если внСсылка=Неопределено Тогда Возврат Ложь КонецЕсли;
			Если Не ЗаписатьВнешниеДанныеРегистраСведений(ОбъектМД,Источник,внСсылка,НомерПакета,СоответствиеСсылок,Перезапись) Тогда Возврат Ложь КонецЕсли;
		
		Иначе //Объектный тип (Справочник, Док... )
			Если ПолучитьВнешнееЗначение(Источник.Ссылка,НомерПакета,СоответствиеСсылок,Перезапись)=Неопределено Тогда Возврат Ложь КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	//установка актуального пакета к загрузке
	ТекБаза=ТекущаяБазаДанных().ПолучитьОбъект();
	ТекБаза.Пакет=НомерПакета;
	ТекБаза.Записать();
	
	Возврат Истина
КонецФункции

Функция ПримитивныйТип(Значение1С) //возвращает примитивные типы Иначе - Неопределено
	Тип=ТипЗнч(Значение1С);
	Если Тип=Тип("Булево") Тогда Возврат Строка(Значение1С)
	ИначеЕсли Тип=Тип("Строка") Тогда Возврат СокрЛП(Значение1С)
	ИначеЕсли Тип=Тип("Число") Тогда Возврат Формат(Значение1С,"ЧРД=.; ЧГ=0")
	ИначеЕсли Тип=Тип("Дата") Тогда Возврат Формат(Значение1С,"ДЛФ=DT")
	ИначеЕсли Тип=Тип("ВидСчета") Тогда Если Значение1С=ВидСчета.АктивноПассивный Тогда Возврат "ВидСчета.АктивноПассивный" Иначе Возврат Строка(Значение1С) КонецЕсли
	ИначеЕсли Значение1С=Неопределено Тогда Возврат NULL
	ИначеЕсли Значение1С=NULL Тогда Возврат NULL
	ИначеЕсли СсылкаПустая(Значение1С)=Истина Тогда Возврат NULL 	
	ИначеЕсли Найти(Тип,"(точка маршрута)")>0 Тогда Возврат Значение1С.Имя		
	ИначеЕсли Найти(Строка(Значение1С),"<Объект не найден>")>0 Тогда Сообщить("Не выгружен "+Значение1С+" типа <"+ТипЗначенияВМетаданныеСтрокой(Тип)+">",СтатусСообщения.Внимание); Возврат NULL
	КонецЕсли;
КонецФункции	
Функция ПолучитьВнешнееЗначение(Значение1С,НомерПакета,СоответствиеСсылок,Перезапись) //создает и возвращает Внешнюю Ссылку
	
	//примитивные типы
	зн=ПримитивныйТип(Значение1С); Если зн<>Неопределено Тогда Возврат зн КонецЕсли;
	
	//ссылочные типы
	знСсылки=СоответствиеСсылок.Получить(Значение1С); Если знСсылки<>Неопределено Тогда Возврат знСсылки КонецЕсли; //вернем выгруженное ранее
	
	ИмяМД=СсылкаВМетаданныеСтрокой(Значение1С); //Если ИмяМД=Неопределено Тогда ТекстОшибки="Выгрузка объектов ("+Строка(МД)+") не предусмотрена"; Возврат КонецЕсли;
	Если Найти(ИмяМД,"Перечисление.")>0 Тогда Возврат ИмяМД КонецЕсли; //исключение для перечислений
	ОбъектМД=ОбъектМД(ИмяМД);
	Если ОбъектМД=Неопределено Тогда Сообщить("Не выгружен <"+ИмяМД+"> т.к. не определены внешние метаданные",СтатусСообщения.Внимание); Возврат Неопределено КонецЕсли; //ситуация когда объект передан для выгрузки а метаданные не описаны
	
	////вычислить по правилу Ссылки
	//Если ОбъектМД.Правило<>NULL Тогда
	//	Отказ=Ложь; ТекстОшибки="";
	//	Правило=Справочники.Renault_Правила.ПолучитьСсылку(ОбъектМД.Правило);
	//	ДанныеСсылки=Новый Структура("Значение1С,ОбъектМД,НомерПакета,Перезапись",Значение1С,ОбъектМД,НомерПакета,Перезапись);
	//	внСсылка=ВычислитьПоПравилу(ДанныеСсылки,Правило,ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.Ссылки.ПустаяСсылка(),ТекстОшибки,Отказ);
	//	СоответствиеСсылок.Вставить(Значение1С,внСсылка); //кешируем выгруженные ссылки
	//	Если Отказ Тогда
	//		Сообщить("Ошибка вычисления правила <"+Правило+">"+Символы.ПС+Символы.Таб+ТекстОшибки,СтатусСообщения.Внимание);
	//		Возврат Ложь
	//	Иначе Возврат внСсылка КонецЕсли	
	//КонецЕсли;	
	
	//получить данные ссылки
	спРеквизиты=РеквизитыОбъекта(ИмяМД);
	ДанныеСсылки=ПолучитьДанныеСсылки1С(Значение1С,ОбъектМД,ИмяМД,спРеквизиты)[0];
	
	//найти внешнюю ссылку или создать если ее еще нет
	ТребуетсяЗапись=Истина;
	внСсылка=ПолучитьВнешнююСсылку(ОбъектМД,ДанныеСсылки,Значение1С,ТребуетсяЗапись,НомерПакета,Перезапись);
	СоответствиеСсылок.Вставить(Значение1С,внСсылка);
	Если Не ТребуетсяЗапись Тогда Возврат внСсылка КонецЕсли;
	
	ИмяВнТаблХранения=ИмяВнешнейТаблицы(ИмяМД);
	
	//перед записью реквизитов выполняем удаление (удаляются и реквизиты и табличные части)
	Если Не ОчиститьВнешниеРеквизиты(внСсылка.Ссылка,ИмяВнТаблХранения) Тогда Возврат Неопределено КонецЕсли;
	
	//записать реквизиты внешнего объекта
	Если Не ЗаписатьВнешниеРеквизиты(ДанныеСсылки,внСсылка,ИмяВнТаблХранения,спРеквизиты,0,НомерПакета,СоответствиеСсылок,Перезапись) Тогда Возврат Неопределено КонецЕсли; 
	
	//записать табличные части внешнего объекта
	Для Каждого ТЧ Из ТабличныеЧастиОбъекта(ИмяМД) Цикл
		спРеквизиты=РеквизитыОбъекта(ТЧ.Имя);
		НомерСтроки=0;
		ОбъектМДТЧ=ОбъектМД(ТЧ.Имя);
		Если ОбъектМДТЧ=Неопределено Тогда Сообщить("Не выгружена табличная часть <"+ТЧ.Имя+"> т.к. не определены внешние метаданные",СтатусСообщения.Внимание); Возврат Неопределено КонецЕсли; //ситуация когда объект передан для выгрузки а метаданные не описаны		
		Для Каждого ДанныеСтрокиТЧ Из ПолучитьДанныеСсылки1С(Значение1С,ОбъектМДТЧ,ТЧ.Имя,спРеквизиты) Цикл
			НомерСтроки=НомерСтроки+1;
			Если Не ЗаписатьВнешниеРеквизиты(ДанныеСтрокиТЧ,внСсылка,ИмяВнТаблХранения,спРеквизиты,НомерСтроки,НомерПакета,СоответствиеСсылок,Перезапись) Тогда Возврат Неопределено КонецЕсли; 
		КонецЦикла;	
	КонецЦикла;
	
	//программная запись по правилам (совместно или вместо описания реквизитов)
	Если ОбъектМД.Правило<>NULL Тогда
		Отказ=Ложь; ТекстОшибки="";
		Правило=Справочники.Renault_Правила.ПолучитьСсылку(ОбъектМД.Правило);
		Возврат ВычислитьПоПравилу( Новый Структура("Значение1С,ОбъектМД",Значение1С,ОбъектМД) ,Правило,внСсылка,ТекстОшибки,Отказ);
	КонецЕсли;
		
	Возврат внСсылка
КонецФункции
Функция ПолучитьДанныеСсылки1С(Значение1С,ОбъектМД,ИмяМД,спРеквизиты)
	
	//определим основной текст запроса для выборки данных ссылки 
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Значение1С);
	Запрос.УстановитьПараметр("ОбъектМД",ОбъектМД);
	
	//предопределенные реквизиты
	СпПредопределенныхРеквизитов=СписокПредопределенныхРеквизитов(ИмяМД,Истина);
	
	//финальный список реквизитов = СпПредопределенныхРеквизитов + спРеквизиты
	ПолныйСпРекв=СпПредопределенныхРеквизитов.ВыгрузитьЗначения();
	Для Каждого ЭлРекв Из спРеквизиты Цикл
		Если ПолныйСпРекв.Найти(ЭлРекв.Имя)=Неопределено Тогда ПолныйСпРекв.Добавить(ЭлРекв.Имя) КонецЕсли;
	КонецЦикла;
	
	ПолныйСпРекв.Добавить("&ОбъектМД ОбъектМД"); //обязательное поле
	
	////вычисляем произвольный поиск по правилу Ссылки
	//ПроизвольныйПоиск=NULL;
	//Если ОбъектМД.Правило<>NULL Тогда
	//	Отказ=Ложь; ТекстОшибки="";
	//	Правило=Справочники.Renault_Правила.ПолучитьСсылку(ОбъектМД.Правило);
	//	ПроизвольныйПоиск=ВычислитьПоПравилу( Новый Структура("Значение1С,ОбъектМД",Значение1С,ОбъектМД) ,Правило,ПроизвольныйПоиск,ТекстОшибки,Отказ);
	//	// кешировать правила нет необходимости, т.к. кешируются сами объекты - результат вычисления
	//	//Если Отказ Тогда
	//	//	Сообщить("Ошибка вычисления правила <"+Правило+">"+Символы.ПС+Символы.Таб+ТекстОшибки,СтатусСообщения.Внимание);
	//	//	Возврат Ложь
	//	//Иначе Возврат внСсылка КонецЕсли	
	//КонецЕсли;
	//ПолныйСпРекв.Добавить("&ПроизвольныйПоиск ПроизвольныйПоиск"); //обязательное поле
	//Запрос.УстановитьПараметр("ПроизвольныйПоиск",ПроизвольныйПоиск);
	
	СтрРеквизиты=МассивВСтроку(ПолныйСпРекв,","+Символы.ПС+Символы.Таб);
	
	Если ПустаяСтрока(ОбъектМД.ТекстЗапроса) Тогда 
		Запрос.Текст="Выбрать "+Символы.ПС+Символы.Таб+СтрРеквизиты+Символы.ПС+"ИЗ "+ИмяМД+Символы.ПС+"ГДЕ Ссылка=&Ссылка"
	Иначе
		СтруктураЗапроса=СтруктураЗапроса(ОбъектМД.ТекстЗапроса);
		Запрос.Текст="Выбрать "+Символы.ПС+Символы.Таб+СтрРеквизиты+Символы.ПС+"ИЗ "+СтруктураЗапроса.ИсточникДанных+?(СтруктураЗапроса.Свойство("Условия")," ГДЕ "+СтруктураЗапроса.Условия,"");
	КонецЕсли;	
		
	Возврат Запрос.Выполнить().Выгрузить()
КонецФункции	
Функция ПолучитьВнешнююСсылку(ОбъектМД,ДанныеСсылки,Значение1С,ТребуетсяЗапись,НомерПакета,Перезапись) //ищет или создает новую внешнюю ссылку
	//не фатальная ошибка - вернем NULL, фатальная ошибка - вернем Неопределено
//	Если ДанныеСсылки.ОбъектМД=NULL  Тогда Сообщить("Не определены метаданные "+СсылкаВМетаданныеСтрокой(Значение1С)+" для ссылки "+Значение1С); Возврат NULL КонецЕсли;

	Попытка _=Значение1С.Проведен; ЕстьПроведение=Истина Исключение ЕстьПроведение=Ложь КонецПопытки; //проводится ли объект?

	UUID=Значение1С.УникальныйИдентификатор();
	Запрос=Новый Запрос("Выбрать * Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки ГДЕ UUID=&UUID И ОбъектМД=&ОбъектМД");
	Запрос.УстановитьПараметр("UUID",UUID);
	Запрос.УстановитьПараметр("ОбъектМД",ОбъектМД);
	СсылкаВн=Запрос.Выполнить().Выбрать();
	Если СсылкаВн.Следующий() Тогда
		Если НЕ Перезапись Тогда //проверка версии объекта. если она не изменилась - вернем объект
			Если ЕстьПроведение Тогда
				Если ДанныеСсылки.ВерсияДанных=СсылкаВн.Версия И ДанныеСсылки.ПометкаУдаления=СсылкаВн.ПометкаУдаления И ДанныеСсылки.Проведен=СсылкаВн.Проведен Тогда ТребуетсяЗапись=Ложь; Возврат СсылкаВн.Ссылка КонецЕсли;
			Иначе
				Если ДанныеСсылки.ВерсияДанных=СсылкаВн.Версия И ДанныеСсылки.ПометкаУдаления=СсылкаВн.ПометкаУдаления Тогда ТребуетсяЗапись=Ложь; Возврат СсылкаВн.Ссылка КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		внСсылка=СсылкаВн.Ссылка.ПолучитьОбъект();
	Иначе
		внСсылка=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.Ссылки.СоздатьОбъект();
		внСсылка.UUID=UUID;
	КонецЕсли;
	
	//записать внешнюю ссылку
	Попытка 
		внСсылка.Версия=ДанныеСсылки.ВерсияДанных;
		внСсылка.ПометкаУдаления=ДанныеСсылки.ПометкаУдаления;
		внСсылка.Проведен=?(ЕстьПроведение,Значение1С.Проведен,Ложь);
		Попытка внСсылка.ЭтоГруппа=Значение1С.ЭтоГруппа Исключение внСсылка.ЭтоГруппа=Ложь КонецПопытки;
		//внСсылка.Проведен=?(ВидыЗаписей.Документ=ВидЗаписи,Значение1С.Проведен,Ложь); //ДанныеСсылки.Проведен;
		//внСсылка.ЭтоГруппа=?(ВидыЗаписей.Справочник=ВидЗаписи,Значение1С.ЭтоГруппа,Ложь); //ДанныеСсылки.ЭтоГруппа;
		внСсылка.Представление=ДанныеСсылки.Представление;
		внСсылка.Пакет=НомерПакета;
		
		внСсылка.ОбъектМД=ДанныеСсылки.ОбъектМД;
		//внСсылка.ПроизвольныйПоиск=ДанныеСсылки.ПроизвольныйПоиск;
		
		внСсылка.Записать();
	Исключение
		Сообщить("Не удалось создать внешнюю ссылку для <"+Значение1С+">. "+ОписаниеОшибки());
		Возврат Неопределено
	КонецПопытки;
	
	Возврат внСсылка.Ссылка	
КонецФункции

Функция ПолучитьВнешнююСсылкуРегистраСведений(ОбъектМД,НомерПакета)
	Запрос=Новый Запрос("Выбрать Первые 1 Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки ГДЕ ОбъектМД=&ОбъектМД");	
	Запрос.УстановитьПараметр("ОбъектМД",ОбъектМД);
	Результат=Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		внСсылка=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.Ссылки.СоздатьОбъект();
		внСсылка.UUID=Новый УникальныйИдентификатор;
	Иначе
		Выборка=Результат.Выбрать();
		Выборка.Следующий();
		внСсылка=Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	//нет возможности проверить версию, выгружаем все
	Попытка 
		внСсылка.Версия=1;
		внСсылка.ПометкаУдаления=Ложь;
		внСсылка.Проведен=Ложь;
		внСсылка.ЭтоГруппа=Ложь;
		внСсылка.Представление=ОбъектМД.Имя;
		внСсылка.Пакет=НомерПакета;
		внСсылка.ОбъектМД=ОбъектМД;
		внСсылка.Записать();
	Исключение
		Сообщить("Не удалось создать внешнюю ссылку для <"+ОбъектМД+">. "+ОписаниеОшибки());
		Возврат Неопределено
	КонецПопытки;
	
	Возврат внСсылка.Ссылка	
КонецФункции	
Функция НайтиВнешнееЗначение(ОбъектМД,Значение1С,СоответствиеСсылок) //ищет по UUID но не создает - возвращает Внешнюю Ссылку
	//примитивные типы
	зн=ПримитивныйТип(Значение1С); Если зн<>Неопределено Тогда Возврат зн КонецЕсли;
	
	//ссылочные типы
	знСсылки=СоответствиеСсылок.Получить(Значение1С); Если знСсылки<>Неопределено Тогда Возврат знСсылки КонецЕсли; //вернем выгруженное ранее

	UUID=Значение1С.УникальныйИдентификатор();
	Запрос=Новый Запрос("Выбрать Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки ГДЕ UUID=&UUID И ОбъектМД=&ОбъектМД");
	Запрос.УстановитьПараметр("UUID",UUID);
	Запрос.УстановитьПараметр("ОбъектМД",ОбъектМД);
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка
КонецФункции	
Функция ЗаписатьВнешниеДанныеРегистраСведений(ОбъектМД,НаборЗаписей=Неопределено,внСсылка,НомерПакета,СоответствиеСсылок,Перезапись)
	//НаборЗаписей - набор записей регистра и требуется записать только их. Если отсутствует - выгружаем все записи
	
	ИмяВнТаблХранения=ИмяВнешнейТаблицы(ОбъектМД.Имя);
	спРеквизиты=РеквизитыОбъекта(ОбъектМД.Имя);
	
	//убрать все записи регистра выгруженные ранее
	Если НаборЗаписей=Неопределено Тогда
		Если Перезапись И Не ОчиститьВнешниеРеквизиты(внСсылка,ИмяВнТаблХранения) Тогда Возврат Ложь КонецЕсли;
		//полная выгрузка регистра
		МассивРекв=Новый Массив; Для Каждого Рекв Из спРеквизиты Цикл МассивРекв.Добавить(Рекв.Имя) КонецЦикла; 
		Запрос=Новый Запрос("Выбрать "+МассивВСтроку(МассивРекв,",")+" Из "+ОбъектМД.Имя);
		Выборка=Запрос.Выполнить().Выбрать();
		НомерСтроки=0;
		Пока Выборка.Следующий() Цикл
			НомерСтроки=НомерСтроки+1;
			Если Не ЗаписатьВнешниеРеквизиты(Выборка,внСсылка,ИмяВнТаблХранения,спРеквизиты,НомерСтроки,НомерПакета,СоответствиеСсылок,Перезапись) Тогда Возврат Ложь КонецЕсли;
		КонецЦикла;	
		
	Иначе
		Если НаборЗаписей.Количество()=0 Тогда
			//очистка записей по отбору
			Отбор=Новый Структура;
			Для Каждого Эл Из НаборЗаписей.Отбор Цикл
				//знРеквизита=ПолучитьВнешнееЗначение(Эл.Значение,НомерПакета,СоответствиеСсылок,Перезапись);
				знРеквизита=НайтиВнешнееЗначение(ОбъектМД,Эл.Значение,СоответствиеСсылок);
				Если знРеквизита=Неопределено Тогда Возврат Истина КонецЕсли; //пытались удалить а значения и так нет
				Отбор.Вставить(Эл.Имя,знРеквизита);
			КонецЦикла;	
			Если Не ОчиститьВнешниеРеквизиты(внСсылка,ИмяВнТаблХранения,Отбор) Тогда Возврат Ложь КонецЕсли;
		Иначе 
			//создание записей
			
			//продолжаем дописывать от максимального номера строки
			Запрос=Новый Запрос("Выбрать Максимум(НомерСтроки) МаксНомерСтроки Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица."+ИмяВнТаблХранения+" ГДЕ СсылкаНаОбъект=&СсылкаНаОбъект");
			Запрос.УстановитьПараметр("СсылкаНаОбъект",внСсылка);
			НомерСтроки=Запрос.Выполнить().Выгрузить().Итог("МаксНомерСтроки");
			Для Каждого Запись Из НаборЗаписей Цикл
				НомерСтроки=НомерСтроки+1;
				Если Не ЗаписатьВнешниеРеквизиты(Запись,внСсылка,ИмяВнТаблХранения,спРеквизиты,НомерСтроки,НомерПакета,СоответствиеСсылок,Перезапись) Тогда Возврат Ложь КонецЕсли;
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
	
	//программная запись по правилам (совместно или вместо описания реквизитов)
	Если ОбъектМД.Правило<>NULL Тогда
		Отказ=Ложь; ТекстОшибки="";
		Правило=Справочники.Renault_Правила.ПолучитьСсылку(ОбъектМД.Правило);
		Возврат ВычислитьПоПравилу( Новый Структура("НаборЗаписей,ОбъектМД",НаборЗаписей,ОбъектМД) ,Правило,внСсылка,ТекстОшибки,Отказ);
	КонецЕсли;
	
	Возврат Истина
КонецФункции	

Функция УстановитьНеАктуальностьВерсииСсылки(внСсылка)
	Объект=внСсылка.ПолучитьОбъект();
	Объект.Версия=0;
	Попытка	Объект.Записать() Исключение Возврат Ложь КонецПопытки;
	Возврат Истина
КонецФункции	
Функция СсылкаПустая(Ссылка) Попытка Возврат Ссылка.Пустая() Исключение Возврат Неопределено КонецПопытки КонецФункции

Функция ОчиститьВнешниеРеквизиты(внСсылка,ИмяВнТаблХранения,Отбор=Неопределено)
	Попытка 
		Если Отбор=Неопределено Тогда
			Записи=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы[ИмяВнТаблХранения].СоздатьНаборЗаписей();
			Записи.Отбор.СсылкаНаОбъект.ВидСравнения=ВидСравнения.Равно;
			Записи.Отбор.СсылкаНаОбъект.Значение=внСсылка;
			Записи.Отбор.СсылкаНаОбъект.Использование=Истина;
			Записи.Прочитать();
			Записи.Очистить();
			Записи.Записать(Истина);
		Иначе
			//надо найти номера строк где набор реквизитов равен отбору и удалить такие строки
			Индекс=0;
			Запрос=Новый Запрос;
			Запрос.УстановитьПараметр("СсылкаНаОбъект",внСсылка);
			Запрос.Текст="
			|Выбрать Различные ЗП.НомерСтроки 
			|ИЗ ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица."+ИмяВнТаблХранения+" ЗП";
			Для Каждого Эл Из Отбор Цикл 
				СтрИндекс=Формат(Индекс,"ЧН=0; ЧГ=0");
				Запрос.УстановитьПараметр("Реквизит"+СтрИндекс,Эл.Ключ);
				Запрос.УстановитьПараметр("Значение"+СтрИндекс,Эл.Значение);
				Если ТипЗнч(Эл.Значение)=Тип("Строка") Тогда
					УсловиеЗначения="Подстрока(Значение,0,"+СтрДлина(Эл.Значение)+")=&Значение"+СтрИндекс+" И ЗначениеСсылка=Значение(ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки.ПустаяСсылка)";
				Иначе
					УсловиеЗначения="Значение Есть NULL И ЗначениеСсылка=&Значение"+СтрИндекс;
				КонецЕсли;	
				Запрос.Текст=Запрос.Текст+"
				|Внутреннее Соединение(
				|	Выбрать НомерСтроки
				|		ИЗ ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица."+ИмяВнТаблХранения+"
				|		ГДЕ СсылкаНаОбъект=&СсылкаНаОбъект И Реквизит.Имя=&Реквизит"+СтрИндекс+" И "+УсловиеЗначения+"
				|)ЗП"+СтрИндекс+"
				|По ЗП.НомерСтроки=ЗП"+СтрИндекс+".НомерСтроки";
				Индекс=Индекс+1;
			КонецЦикла;	
			Запрос.Текст=Запрос.Текст+"
			|ГДЕ СсылкаНаОбъект=&СсылкаНаОбъект
			|";
			Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
				Записи=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы[ИмяВнТаблХранения].СоздатьНаборЗаписей();
				Записи.Отбор.СсылкаНаОбъект.ВидСравнения=ВидСравнения.Равно;
				Записи.Отбор.СсылкаНаОбъект.Значение=внСсылка;
				Записи.Отбор.СсылкаНаОбъект.Использование=Истина;
				Записи.Отбор.НомерСтроки.ВидСравнения=ВидСравнения.Равно;
				Записи.Отбор.НомерСтроки.Значение=Стр.НомерСтроки;
				Записи.Отбор.НомерСтроки.Использование=Истина;
				Записи.Прочитать();
				Записи.Очистить();
				Записи.Записать(Истина);
			КонецЦикла;	
			
		КонецЕсли;	
	Исключение
		Сообщить("Реквизиты ссылки <"+внСсылка+"> не удалось очистить. "+ОписаниеОшибки());
		Возврат Ложь
	КонецПопытки;	
	Возврат Истина
КонецФункции	
Функция ЗаписатьВнешниеРеквизиты(Данные,внСсылка,ИмяВнТаблХранения,спРеквизиты,НомерСтроки,НомерПакета,СоответствиеСсылок,Перезапись)
	Для Каждого Реквизит Из спРеквизиты Цикл
		знРеквизита1С=Данные[Реквизит.Имя];
		
		//вычислить по правилу Реквизита
		Если Реквизит.Правило<>NULL Тогда
			Отказ=Ложь; ТекстОшибки="";
			Правило=Справочники.Renault_Правила.ПолучитьСсылку(Реквизит.Правило);
			знРеквизита1С=ВычислитьПоПравилу(Новый Структура("Данные,спРеквизиты",Данные,спРеквизиты),Правило,знРеквизита1С,ТекстОшибки,Отказ);
			Если Отказ Тогда
				Сообщить("Ошибка вычисления правила <"+Правило+">"+Символы.ПС+Символы.Таб+ТекстОшибки,СтатусСообщения.Внимание);
				Возврат Ложь	
			КонецЕсли;	
		КонецЕсли;	
		
		Если Не ЗаписатьВнешнийРеквизит(знРеквизита1С,Реквизит,внСсылка,ИмяВнТаблХранения,НомерСтроки,НомерПакета,СоответствиеСсылок,Перезапись) Тогда 
			//если не удалось записать реквизит то внешняя ссылка не соответствует версии...
			УстановитьНеАктуальностьВерсииСсылки(внСсылка);
			Возврат Ложь
		КонецЕсли
	КонецЦикла;
	Возврат Истина
КонецФункции
Функция ЗаписатьВнешнийРеквизит(знРеквизита1С,Реквизит,внСсылка,ИмяВнТаблХранения,НомерСтроки,НомерПакета,СоответствиеСсылок,Перезапись)
	Попытка
		Запись=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы[ИмяВнТаблХранения].СоздатьМенеджерЗаписи();
		Запись.СсылкаНаОбъект=внСсылка;
		Запись.Реквизит=Реквизит;
		Запись.НомерСтроки=НомерСтроки;
		знРеквизита=ПолучитьВнешнееЗначение(знРеквизита1С,НомерПакета,СоответствиеСсылок,Перезапись);
		Если знРеквизита=Неопределено Тогда 
			ВызватьИсключение "" //сообщение об ошибке уже выдано
		ИначеЕсли знРеквизита=NULL Тогда
			Запись.Значение=NULL;
			Запись.ЗначениеСсылка=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.Ссылки.ПустаяСсылка();
		Иначе
			Если ТипЗнч(знРеквизита)=Тип("Строка") Тогда
				Запись.Значение=знРеквизита;
				Запись.ЗначениеСсылка=ВнешниеИсточникиДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблицы.Ссылки.ПустаяСсылка();
			Иначе
				Запись.Значение=NULL;
				Запись.ЗначениеСсылка=знРеквизита;
			КонецЕсли
		КонецЕсли;
		Запись.Записать(Истина); //при "Записать(Истина)" вероятно надо указывать значения всех полей, иначе 1С не переваривает
	Исключение
		Сообщить("Реквизит <"+Реквизит+"> внешней ссылки <"+внСсылка+"> не записан. "+ОписаниеОшибки());
		Возврат Ложь
	КонецПопытки;	
	Возврат Истина
КонецФункции

//----функции загрузки---
//*************************************************************
//внешний вызов загрузки по номеру последнего пакета
Функция ЗагрузкаВыполнена(НомерПоследнегоЗагруженногоПакета,НомерПоследнегоВыгруженногоПакета,БазаДанных,ТекстОшибки,Отказ,Перезапись=Ложь) Экспорт
	СоответствиеСсылок=Новый Соответствие;
	МаксНомерПакета='00010101';
	Для Каждого ДанныеВнСсылки Из ДанныеКЗагрузке(НомерПоследнегоЗагруженногоПакета,НомерПоследнегоВыгруженногоПакета,БазаДанных) Цикл //таблица ссылок (Внешних данных) без реквизитов + Конвертация к ним без реквизитов
		Если ПолучитьЗначение1С(ДанныеВнСсылки,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)<>Неопределено Тогда
			МаксНомерПакета=Макс(МаксНомерПакета,ДанныеВнСсылки.ЗначениеСсылка.Пакет);
		КонецЕсли;	
	КонецЦикла;	
	
	//запоминаем последний загруженный пакет
	Если МаксНомерПакета>'00010101' И Не Отказ Тогда Константы.Renault_НомерЗагруженногоПакета.Установить(МаксНомерПакета) КонецЕсли;	
	Возврат НЕ Отказ
КонецФункции	
Функция ПолучитьЗначение1С(внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись) //определение ссылки 1С по внДанные
	
	//примитивные типы (приходит как рекурсивный вызов из реквизитов ссылки)
	Если Не ПустаяСтрока(внДанные.Значение) Тогда Возврат ПреобразованиеПримитивногоТипа(внДанные,ТекстОшибки,Отказ) КонецЕсли; 
	
	//иначе ссылочный тип
	ВнСсылка=внДанные.ЗначениеСсылка;
	Если ВнСсылка.Пустая() Тогда Возврат NULL КонецЕсли;
	Если ВнСсылка.Версия="0" Тогда Сообщить("Ссылка <"+ВнСсылка.Представление+"> не загружена, возникли проблемы при выгрузке",СтатусСообщения.Важное); Возврат Неопределено КонецЕсли;
	Если внДанные.Конвертация=NULL Тогда Возврат Неопределено КонецЕсли; //ошибкой не является если не определена загрузка для выгруженного объекта
	
	//ссылка загружена ранее - вернем ее
	Ссылка1С=СоответствиеСсылок.Получить(ВнСсылка); Если Ссылка1С<>Неопределено Тогда Возврат Ссылка1С КонецЕсли; 
	
	//РегистраСведений
	Если Найти(ВнСсылка.ОбъектМД.Имя,"РегистрСведений.")>0 Тогда Возврат ЗагрузитьРегистрСведений(внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись) КонецЕсли;
	
	//Объектные типы
	внДанные.Реквизиты=РеквизитыВнешнегоОбъекта(ВнСсылка); //внешние реквизиты объекта
	
	//программный поиск ссылки
	ПравилоПоиска=Правило(внДанные,"Поиска");
	Если НЕ ПравилоПоиска.Пустая() Тогда 
		Объект1С=ВычислитьПоПравилу(внДанные,ПравилоПоиска,Неопределено,ТекстОшибки,Отказ); //программный поиск ссылки
		//Объект1С=ВычислитьПоПравилу(внДанные,Правило(внДанные),Ссылка1С,ТекстОшибки,Отказ); //программная постобработка
		Если Объект1С=Неопределено Тогда Возврат Неопределено КонецЕсли;
		Ссылка1С=Объект1С.Ссылка;
		
	Иначе //поиск  или создание
		
		//ПоляПоиска=внДанные.Реквизиты.НайтиСтроки(Новый Структура("Поиск",Истина));
		ПоляПоиска=внДанные.Реквизиты.НайтиСтроки(Новый Структура("Поиск,ИмяТЧ",Истина,внДанные.Конвертация.Наименование));
		Объект1С=?(ПоляПоиска.Количество()=0,
			//ПоискПоUUID(ВнСсылка.ОбъектМД.Имя,ВнСсылка.UUID,ВнСсылка.ЭтоГруппа), //поиск по уникальному идентификатору
			//ПоискПоПолям(ВнСсылка.ОбъектМД.Имя,ПоляПоиска,ВнСсылка.ЭтоГруппа,СоответствиеСсылок,Перезапись) //поиск по заданным полям
			ПоискПоUUID(внДанные.Конвертация.Наименование,ВнСсылка.UUID,ВнСсылка.ЭтоГруппа), //поиск по уникальному идентификатору
			ПоискПоПолям(внДанные.Конвертация.Наименование,ПоляПоиска,ВнСсылка.ЭтоГруппа,СоответствиеСсылок,Перезапись) //поиск по заданным полям
		);
		Если Объект1С=Неопределено Тогда Возврат Неопределено КонецЕсли;
		
		//определим ссылку для Объект1С
		Если Объект1С.ЭтоНовый() Тогда
			Если внДанные.ТолькоЧтение Тогда //блокировка записи 
				Ссылка1С=Неопределено //вернем Неопределено, т.к. ссылка нет
			Иначе
				Ссылка1С=Объект1С.ПолучитьСсылкуНового() //вернем будущую ссылку
			КонецЕсли;	
		Иначе
			Ссылка1С=Объект1С.Ссылка
		КонецЕсли;	
	КонецЕсли;
	
	СоответствиеСсылок.Вставить(ВнСсылка,Ссылка1С); //запомним в кэш ** ссылка запоминается на этапе создания а не после записи, иначе возможны зацикливания
	Если внДанные.ТолькоЧтение или (внДанные.ТипЗаписиВнОбъекта="Реквизит" И внДанные.ТолькоЧтениеРеквизит) Тогда Возврат Ссылка1С КонецЕсли; //объект не может быть переписан, вернем как есть
	Если Не Перезапись И Объект1С.Renault_ВерсияВнешнихДанных=ВнСсылка.Версия Тогда Возврат Объект1С.Ссылка КонецЕсли; //если версия не изменилась...	

	//значит объект 1С изменился, требуется перезаписать его реквизиты
	ЗапрещенныйВидИспользования=ЗапрещенныйВидИспользования(Объект1С,внДанные.Конвертация.Наименование); //для справочников не все реквизиты есть у группы и элемента
	ОчисткаОбъекта1С(Объект1С,ЗапрещенныйВидИспользования); //очистим реквизиты и ТЧ
	
	//записать реквизиты
	//данные внешних реквизитов упорядочены по имени метаданного (табличные части сгруппированы) и номеру строки ТЧ
	мдОбъекта1С=Объект1С.Метаданные();
	
	ВиртуальныеТаблицы=Новый ТаблицаЗначений;  //Виртуальные таблицы с именем ИмяМД + Массив строк + правила поиска и конвертации
	ВиртуальныеТаблицы.Колонки.Добавить("Имя");
	ВиртуальныеТаблицы.Колонки.Добавить("ПравилоПоиска");
	ВиртуальныеТаблицы.Колонки.Добавить("Правило");
	ВиртуальныеТаблицы.Колонки.Добавить("ТолькоЧтение");
	ВиртуальныеТаблицы.Колонки.Добавить("Строки");
	
	//сохраним временные переменные, используются для передачи комплексной инфо. по объекту в процедуру записи виртуальных таблиц
	Объект1С.ДополнительныеСвойства.Вставить("ДанныеСсылки",внДанные); //ссылка типа Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки
	//Объект1С.ДополнительныеСвойства.Вставить("Реквизиты",внДанные.Реквизиты); //структура ключ - имя реквизита
	Объект1С.ДополнительныеСвойства.Вставить("Метаданные",мдОбъекта1С); //метаданные созданной ссылки в 1С
	
	нСтроки=0;	
	Для Каждого ДанныеВнРекв Из внДанные.Реквизиты Цикл
		//*(описано в СКД) Если ДанныеВнРекв.КонвертацияРеквизит=NULL Тогда Продолжить КонецЕсли; //ошибкой не является если не определена загрузка для выгруженного реквизита
		
		//имя табличной части если это реквизит ТЧ
		Если ДанныеВнРекв.НомерСтроки>0 Тогда 
			ИмяТЧ=СтруктураМетаданных(ДанныеВнРекв.ИмяТЧ).Таблица;
			Если ИмяТЧ=Неопределено Тогда 
				//новая виртуальная таблица
				СтрВиртТаб=ВиртуальныеТаблицы.Найти(ДанныеВнРекв.ИмяТЧ,"Имя");
				Если СтрВиртТаб=Неопределено Тогда
					СтрВиртТаб=ВиртуальныеТаблицы.Добавить();
					СтрВиртТаб.Имя=ДанныеВнРекв.ИмяТЧ;
					СтрВиртТаб.ПравилоПоиска=ДанныеВнРекв.ПравилоПоискаТЧ;
					СтрВиртТаб.Правило=ДанныеВнРекв.ПравилоТЧ;
					СтрВиртТаб.ТолькоЧтение=ДанныеВнРекв.ТолькоЧтениеТЧ;
					СтрВиртТаб.Строки=Новый Массив;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
		//пропустим лишние реквизиты. Для Справочника - не все реквизиты есть у группы и элемента
		Если ЗапрещенныйВидИспользования<>"" Тогда 
			Если ДанныеВнРекв.НомерСтроки=0 Тогда
				Если мдОбъекта1С.Реквизиты.Найти(ДанныеВнРекв.Реквизит)<>Неопределено И мдОбъекта1С.Реквизиты[ДанныеВнРекв.Реквизит].Использование=ЗапрещенныйВидИспользования Тогда Продолжить КонецЕсли;
			Иначе
				Если ИмяТЧ<>Неопределено И мдОбъекта1С.ТабличныеЧасти[ИмяТЧ].Использование=ЗапрещенныйВидИспользования Тогда Продолжить КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		
		ЗначениеВнешнейСсылки=ПолучитьЗначение1С(ДанныеВнРекв,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись); //рекурсия установит Отказ, ошибка может быть критической...
		Если ЗначениеВнешнейСсылки=Неопределено или ЗначениеВнешнейСсылки=NULL Тогда Продолжить КонецЕсли; //но не найденный реквизит пока не проблема
		
		Если ДанныеВнРекв.НомерСтроки=0 Тогда //шапка
			Объект1С[ДанныеВнРекв.Реквизит]=ЗначениеВнешнейСсылки	
		ИначеЕсли ИмяТЧ<>Неопределено Тогда //табличная часть
			Если нСтроки<>ДанныеВнРекв.НомерСтроки Тогда 
				ТекСтрока=Объект1С[ИмяТЧ].Добавить();
				нСтроки=ДанныеВнРекв.НомерСтроки;
			КонецЕсли;
			ТекСтрока[ДанныеВнРекв.Реквизит]=ЗначениеВнешнейСсылки;
		ИначеЕсли ИмяТЧ=Неопределено Тогда //виртуальная таблица	
			Если нСтроки<>ДанныеВнРекв.НомерСтроки Тогда
				ТекСтрокаВТ=Новый Структура;
				СтрВиртТаб.Строки.Добавить(ТекСтрокаВТ);
				нСтроки=ДанныеВнРекв.НомерСтроки;
			КонецЕсли;
			ТекСтрокаВТ.Вставить(ДанныеВнРекв.Реквизит,ЗначениеВнешнейСсылки);
		КонецЕсли;
		
	КонецЦикла;
	
	Объект1С.ДополнительныеСвойства.Вставить("ВиртуальныеТаблицы",ВиртуальныеТаблицы);
	Если Не Отказ Тогда ЗаписатьВиртуальныеТаблицы(Объект1С,ТекстОшибки,Отказ) КонецЕсли; //запись виртуальных таблиц
	Если Не Отказ Тогда Объект1С=ВычислитьПоПравилу(внДанные,Правило(внДанные),Объект1С,ТекстОшибки,Отказ) КонецЕсли; //правило постобработки
		
	//запись объекта
	Попытка
		//если ошибок не случилось то версия объекта обновляется
		Если Не Отказ Тогда Объект1С.Renault_ВерсияВнешнихДанных=ВнСсылка.Версия КонецЕсли;	
		Если Найти(внДанные.Конвертация.Наименование,"Документ.")>0 Тогда
			Объект1С.Записать(?(ВнСсылка.Проведен,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.ОтменаПроведения),РежимПроведенияДокумента.Неоперативный);
		Иначе
			Объект1С.Записать();	
		КонецЕсли;
		Объект1С.УстановитьПометкуУдаления(ВнСсылка.ПометкаУдаления);
	Исключение
		Отказ=Истина; //критическая ошибка
		ТекстОшибки=ТекстОшибки+?(ТекстОшибки="","",Символы.ПС)+"Ссылка "+Строка(ВнСсылка.UUID)+" типа <"+ВнСсылка.ОбъектМД.Имя+"> -> <"+внДанные.Конвертация.Наименование+"> не записана."+Символы.ПС+Символы.Таб+ОписаниеОшибки();
		Возврат Неопределено
	КонецПопытки;
	
	Возврат Объект1С.Ссылка
КонецФункции

Функция ЗагрузитьРегистрСведений(внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)
	Если внДанные.Конвертация.ТолькоЧтение Тогда Возврат Истина КонецЕсли;
	СтрМД=СтруктураМетаданных(внДанные.ИмяМД,Истина); 
	Если СтрМД=Неопределено Тогда Возврат Неопределено КонецЕсли;
	
	Записи=СтрМД.Менеджер.СоздатьНаборЗаписей();
	
	//конвертация реквизитов
	Запрос=Новый Запрос("Выбрать ВнешнийРеквизит,Реквизит,Правило,ПравилоПоиска,ТолькоЧтение,Поиск Из Справочник.Renault_КонвертацияДанных.Реквизиты ГДЕ Ссылка=&Конвертация И Ссылка.Активно И Активно");
	Запрос.УстановитьПараметр("Конвертация",внДанные.Конвертация);
	внДанные.Реквизиты=Запрос.Выполнить().Выгрузить();
	
	//данные внешней базы
	ИмяВнТаблХранения=ИмяВнешнейТаблицы(внДанные.Конвертация.ВнешниеМетаданные.Имя);
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("СсылкаНаОбъект",внДанные.ЗначениеСсылка);
	Поля="";
	Источники="";
	Итоги="";
	Индекс=0;
	Для Каждого СтрРеквизит Из внДанные.Реквизиты Цикл
		СтрИндекс=Формат(Индекс,"ЧН=0; ЧГ=0");
		
		Поля=Поля+?(Поля="","",",")+"
		|	Реквизит"+СтрИндекс+".Реквизит Реквизит"+СтрИндекс+",
		|	Реквизит"+СтрИндекс+".Значение Значение"+СтрИндекс+",
		|	Реквизит"+СтрИндекс+".ЗначениеСсылка ЗначениеСсылка"+СтрИндекс+",
		|	Выбор Когда Реквизит"+СтрИндекс+".ЗначениеСсылка Есть NULL ИЛИ Реквизит"+СтрИндекс+".ЗначениеСсылка=Значение(ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.Ссылки.ПустаяСсылка) 
		|		Тогда Подстрока(Реквизит"+СтрИндекс+".Значение,0,100) 
		|		Иначе Реквизит"+СтрИндекс+".ЗначениеСсылка 
		|	Конец Группа"+СтрИндекс;
		
		Источники=Источники+"
		|Левое Соединение(
		|	ВЫБРАТЬ
		|		НомерСтроки,
		|		Реквизит,
		|		Значение,
		|		ЗначениеСсылка
		|	ИЗ ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица."+ИмяВнТаблХранения+"
		|	ГДЕ	СсылкаНаОбъект=&СсылкаНаОбъект И Реквизит=&Реквизит"+СтрИндекс+"
		|)Реквизит"+СтрИндекс+" По ЗП.НомерСтроки=Реквизит"+СтрИндекс+".НомерСтроки 
		|";
		Запрос.УстановитьПараметр("Реквизит"+СтрИндекс,СтрРеквизит.ВнешнийРеквизит);
		
		//группировки
		Если СтрРеквизит.Поиск Тогда Итоги=Итоги+?(Итоги="","",", ")+"Группа"+СтрИндекс КонецЕсли;	
		
		Индекс=Индекс+1;
	КонецЦикла;	
	
	Запрос.Текст="
	|Выбрать "+Поля+"
	|ИЗ(Выбрать Различные НомерСтроки Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица."+ИмяВнТаблХранения+" ГДЕ СсылкаНаОбъект=&СсылкаНаОбъект)ЗП
	|"+Источники;
	//|Итоги По "+Итоги;
	//|Упорядочить По "+Итоги;
	
	Если внДанные.ПравилоПоиска.Пустая() Тогда //запись НабораЗаписей с отбором по группировкам запроса		
		Запрос.Текст=Запрос.Текст+"
		|Итоги По "+Итоги;
		Измерения=внДанные.Реквизиты.НайтиСтроки(Новый Структура("Поиск",Истина));
		Если ЗагрузитьНаборЗаписейРегистраСведений(0,Измерения,Запрос.Выполнить(),Записи,внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)=Неопределено Тогда Возврат Неопределено КонецЕсли; 
	Иначе //запись НабораЗаписей программным отбором
		Если ВычислитьПоПравилу(внДанные,внДанные.ПравилоПоиска,Записи,ТекстОшибки,Отказ)=Неопределено Тогда Возврат Неопределено КонецЕсли; //программный отбор набора данных
		Записи.Прочитать();
		Записи.Очистить();
		Выборка=Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл //детальные записи выборки
			Если ЗагрузитьЗапистьРегистраСведений(Выборка,Записи,внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)=Неопределено Тогда Возврат Неопределено КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецФункции
Функция ЗагрузитьНаборЗаписейРегистраСведений(НомерГруппировки,Измерения,РезультатЗапроса,Записи,внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)
	ВыборкаГр=РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаГр.Следующий() Цикл
		Если ВыборкаГр.ТипЗаписи()<>ТипЗаписиЗапроса.ДетальнаяЗапись Тогда
			
			//отбор набора записей
			//СтрИндекс=Формат(НомерГруппировки,"ЧН=0; ЧГ=0");
			Измерение=Измерения[НомерГруппировки];
			
			//получим первую детальную запись
			Выборка=ВыборкаГр.Выбрать();
			Выборка.Следующий();
			Пока Выборка.ТипЗаписи()<>ТипЗаписиЗапроса.ДетальнаяЗапись Цикл Выборка.Следующий() КонецЦикла;	
			
			Значение=ПолучитьЗначение1С_РеквизитРегистраСведений(Выборка,НомерГруппировки,Измерение,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись); Если Значение=Неопределено Тогда Возврат Неопределено КонецЕсли;
			Записи.Отбор[Измерение.Реквизит].ВидСравнения=ВидСравнения.Равно;
			Записи.Отбор[Измерение.Реквизит].Значение=Значение;
			Записи.Отбор[Измерение.Реквизит].Использование=Истина;
			
			Если ЗагрузитьНаборЗаписейРегистраСведений(НомерГруппировки+1,Измерения,ВыборкаГр,Записи,внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)=Неопределено Тогда Возврат Неопределено КонецЕсли; 
		Иначе
		//детальные записи выборки
			Записи.Прочитать();
			Записи.Очистить();
			Если ЗагрузитьЗапистьРегистраСведений(ВыборкаГр,Записи,внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)=Неопределено Тогда Возврат Неопределено КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	Возврат Истина
КонецФункции
Функция ЗагрузитьЗапистьРегистраСведений(Выборка,Записи,внДанные,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)
	Выборка.Сбросить();
	Пока Выборка.Следующий() Цикл
		Запись=Записи.Добавить();
		Индекс=0;
		Для Каждого СтрРеквизит Из внДанные.Реквизиты Цикл
			Если Записи.Отбор.Найти(СтрРеквизит.Реквизит)=Неопределено Тогда
				Значение=ПолучитьЗначение1С_РеквизитРегистраСведений(Выборка,Индекс,СтрРеквизит,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись); Если Значение=Неопределено Тогда Возврат Неопределено КонецЕсли;
				Запись[СтрРеквизит.Реквизит]=Значение;
			Иначе
				Запись[СтрРеквизит.Реквизит]=Записи.Отбор[СтрРеквизит.Реквизит].Значение	
			КонецЕсли;	
			Индекс=Индекс+1;
		КонецЦикла;
	КонецЦикла;
	Возврат ЗаписатьНаборЗаписейРегистраСведений(внДанные,Записи,ТекстОшибки,Отказ)
КонецФункции	
Функция ЗаписатьНаборЗаписейРегистраСведений(внДанные,Записи,ТекстОшибки,Отказ)
	Если ВычислитьПоПравилу(внДанные,внДанные.Правило,Записи,ТекстОшибки,Отказ)=Неопределено Тогда Возврат Неопределено КонецЕсли; //постобработка
	Попытка
		Записи.Записать(Истина);
		Возврат Истина
	Исключение
		Отказ=Истина;
		ТекстОшибки=ТекстОшибки+?(ТекстОшибки="","",Символы.ПС+Символы.Таб)+"Не записан набор записей <"+внДанные.ИмяМД+">"+Символы.ПС+Символы.Таб+ОписаниеОшибки();
		Возврат Неопределено
	КонецПопытки
КонецФункции	
Функция ПолучитьЗначение1С_РеквизитРегистраСведений(Выборка,НомерРеквизита,Измерение,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)
	СтрИндекс=Формат(НомерРеквизита,"ЧН=0; ЧГ=0");
	Значение=Выборка["Значение"+СтрИндекс];
	Если Не ПустаяСтрока(Значение) Тогда
	//примитивные типы
		ДанныеВнСсылки=Новый Структура("Значение,ВнешнийТип,ПравилоПоискаРеквизит,ПравилоРеквизит",Значение,Измерение.ВнешнийРеквизит.Тип,Измерение.ПравилоПоиска,Измерение.Правило);
		Возврат ПолучитьЗначение1С(ДанныеВнСсылки,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись);
	Иначе
	//объектные типы	
		ДанныеВнСсылки=СсылкаВнешнегоОбъекта(Выборка["ЗначениеСсылка"+СтрИндекс]);
		Если ДанныеВнСсылки.Количество()=0 Тогда Возврат NULL
		Иначе Возврат ПолучитьЗначение1С(ДанныеВнСсылки[0],СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись)
		КонецЕсли;	
	КонецЕсли;
КонецФункции	

Функция ПреобразованиеПримитивногоТипа(внДанные,ТекстОшибки,Отказ)
	Если внДанные.ВнешнийТип="Строка" Тогда Значение=внДанные.Значение
	ИначеЕсли внДанные.ВнешнийТип="Число" Тогда Значение=Число(внДанные.Значение)
	ИначеЕсли внДанные.ВнешнийТип="Булево" Тогда Значение=Булево(внДанные.Значение)
	ИначеЕсли внДанные.ВнешнийТип="Дата" Тогда Значение=Дата(внДанные.Значение)
	Иначе
		Попытка Значение=Вычислить(внДанные.Значение) 
		Исключение Значение=внДанные.Значение КонецПопытки
	КонецЕсли;
	
	Значение=ВычислитьПоПравилу(внДанные,внДанные.ПравилоПоискаРеквизит,Значение,ТекстОшибки,Отказ); //программный поиск ссылки
	Возврат ВычислитьПоПравилу(внДанные,внДанные.ПравилоРеквизит,Значение,ТекстОшибки,Отказ); //программная постобработка
КонецФункции	
Функция Правило(Данные,ТипПравила="") //выбор приоритетного правила (переопределение). ТипПравила="Поиска"/""
	Если Данные.ТипЗаписиВнОбъекта="Реквизит" Тогда
		Если Не Данные["Правило"+ТипПравила+"Реквизит"].Пустая() Тогда Возврат Данные["Правило"+ТипПравила+"Реквизит"] //в первую очередь поиск по реквизиту
		Иначе Возврат Данные["Правило"+ТипПравила] //иначе поиск по текущему типу объекта
		КонецЕсли	
	Иначе
		Возврат Данные["Правило"+ТипПравила]
	КонецЕсли;	
КонецФункции	
Функция ВыполнитьСКД(Схема,Параметры) //Внешние данные + Конвертация
	КомпоновщикМакета=Новый КомпоновщикМакетаКомпоновкиДанных;
	Настройки=Схема.НастройкиПоУмолчанию;
	Для Н=0 По Параметры.Количество()-1 Цикл Настройки.ПараметрыДанных.Элементы[Н].Значение=Параметры[Н] КонецЦикла;
	Макет=КомпоновщикМакета.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки=Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет,,,Истина);
	ПроцессорВывода=Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Возврат ПроцессорВывода.Вывести(ПроцессорКомпоновки,Истина)
КонецФункции	
Функция ДанныеКЗагрузке(НомерПоследнегоЗагруженногоПакета,НомерПоследнегоВыгруженногоПакета,БазаДанных) //таблица ссылок к загрузке + Конвертация данных к ним
	//выбираем пакеты в диапазоне от >НомерПоследнегоЗагруженногоПакета до <=НомерПоследнегоВыгруженногоПакета 
