Функция ВычислитьПоПравилу(ДанныеВнСсылки,Правило,Значение,ТекстОшибки,Отказ)//программный поиск ссылки по правилам конвертации
//в переменной "Значение" передано значение определенное по правилу - в случае программной постобработки, в нее же и надо поместить результат
	//Правило=ДанныеВнСсылки.Правило;
	Если Не ЗначениеЗаполнено(Правило) Тогда Возврат Значение
	ИначеЕсли Найти(Строка(Правило),"<Объект не найден>")>0 Тогда 
		Отказ=Истина;
		Сообщить("Удалено ссылка на правило <"+Правило+"> для значения <"+Значение+">",СтатусСообщения.Внимание);
		Возврат Неопределено 
	КонецЕсли;
	Попытка
		ЗначениеПравила=Справочники.Renault_Правила.ПолучитьЗначение(Правило);
		Если Правило.ВидПравила=Перечисления.Renault_ВидыПравил.Формула Тогда
			Возврат Вычислить(ЗначениеПравила)
		ИначеЕсли Правило.ВидПравила=Перечисления.Renault_ВидыПравил.Программа Тогда
			Выполнить(ЗначениеПравила); // в результате должна быть переопределена переменная
			Возврат Значение
		Иначе Возврат ЗначениеПравила //примитивный или ссылочный тип правила	
		КонецЕсли;
	Исключение
		Отказ=Истина; //критическая ошибка
		ТекстОшибки=ТекстОшибки+?(ТекстОшибки="","",Символы.ПС+Символы.Таб)+"Ссылка не определена по правилу <"+Правило+">"+Символы.ПС+Символы.Таб+ОписаниеОшибки();
		Возврат Неопределено
	КонецПопытки;	
КонецФункции	
Функция ПоискПоUUID(ИмяМД,UUID,ЭтоГруппа) //поиск и создание объекта 1С по UUID
	СтрМД=СтруктураМетаданных(ИмяМД,Истина); 
	Если СтрМД=Неопределено Тогда Возврат Неопределено КонецЕсли;
	//Стр=СтрЗаменить(ИмяМД,".",Символы.ПС);
	//СтрМД=Новый Структура("Тип,Вид",СтрПолучитьСтроку(Стр,1),СтрПолучитьСтроку(Стр,2));
	//
	//СоставМетаданных=СоставМетаданных();
	//Если СоставМетаданных.Свойство(СтрМД.Тип)=Неопределено Тогда
	//	Сообщить("Не определен менеджер объекта <"+ИмяМД+">",СтатусСообщения.Внимание); 
	//	Возврат Неопределено
	//КонецЕсли;	
	//Менеджер=СоставМетаданных[СтрМД.Тип][СтрМД.Вид];
	
	ВнутренняяСсылка=СтрМД.Менеджер.ПолучитьСсылку(UUID);
	ВнутреннийОбъект=ВнутренняяСсылка.ПолучитьОбъект();
	Если ВнутреннийОбъект=Неопределено Тогда
	//Если Лев(ВнутренняяСсылка,18)="<Объект не найден>" Тогда
		ВнутреннийОбъект=СоздатьНовыйОбъект(СтрМД.Тип,СтрМД.Менеджер,ЭтоГруппа);
		Если ВнутреннийОбъект=Неопределено Тогда Возврат Неопределено КонецЕсли;
		ВнутреннийОбъект.УстановитьСсылкуНового(ВнутренняяСсылка);
	КонецЕсли;
	Возврат ВнутреннийОбъект
КонецФункции
Функция ПоискПоПолям(ИмяМД,ПоляПоиска,ЭтоГруппа,СоответствиеСсылок,Перезапись) //поиск и создание объекта 1С по UUID
	СтрМД=СтруктураМетаданных(ИмяМД,Истина); 
	Если СтрМД=Неопределено Тогда Возврат Неопределено КонецЕсли;
	
	Построитель=Новый ПостроительЗапроса("Выбрать Первые 1 Ссылка Из "+ИмяМД);
	Построитель.ЗаполнитьНастройки();
	
	Для Каждого СтрПоле Из ПоляПоиска Цикл
		ТекстОшибки="";
		Отказ=Ложь;
		Значение=ПолучитьЗначение1С(СтрПоле,СоответствиеСсылок,ТекстОшибки,Отказ,Перезапись);
		Если Отказ Тогда 
			Сообщить("Не определено поле <"+СтрПоле.Реквизит+"> для поиска Ссылки типа <"+ИмяМД+">:"+Символы.ПС+Символы.Таб+ТекстОшибки,СтатусСообщения.Внимание); 
			Возврат Неопределено 
		КонецЕсли;
		//отбор построителя
		Отбор=Построитель.Отбор.Добавить("Ссылка."+СтрПоле.Реквизит,СтрПоле.Реквизит);
		Отбор.ВидСравнения=ВидСравнения.Равно;
		Отбор.Значение=Значение;
		Отбор.Использование=Истина;
	КонецЦикла;
	
	Построитель.Выполнить();
	Если Построитель.Результат.Пустой() Тогда 
		//Возврат СтрМД.Менеджер.ПустаяСсылка()
		Возврат СоздатьНовыйОбъект(СтрМД.Тип,СтрМД.Менеджер,ЭтоГруппа); //создать новый 
		//Для Каждого Отбор Из Построитель.Отбор Цикл Объект[СтрПоле.Реквизит]=Отбор.Значение КонецЦикла; //заполнить поля поиска - это лишнее т.к. они все равно перетрутся последующим заполнением полей
	Иначе
		Выборка=Построитель.Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка.ПолучитьОбъект()
	КонецЕсли;
	
КонецФункции	
Функция СоздатьНовыйОбъект(Тип,Менеджер,ЭтоГруппа)
	Если Тип="Справочник" Тогда Возврат ?(ЭтоГруппа,Менеджер.СоздатьГруппу(),Менеджер.СоздатьЭлемент())
	ИначеЕсли Тип="Документ" Тогда Возврат Менеджер.СоздатьДокумент()
	ИначеЕсли Тип="ПланВидовХарактеристик" Тогда Возврат Менеджер.СоздатьЭлемент()
	ИначеЕсли Тип="ПланСчетов" Тогда Возврат Менеджер.СоздатьСчет()
	ИначеЕсли Тип="ПланВидовРасчета" Тогда Возврат Менеджер.СоздатьВидРасчета()
	ИначеЕсли Тип="БизнесПроцесс" Тогда Возврат Менеджер.СоздатьБизнесПроцесс()
	ИначеЕсли Тип="Задача" Тогда Возврат Менеджер.СоздатьЗадачу()
	ИначеЕсли Тип="ПланОбмена" Тогда Возврат Менеджер.СоздатьУзел()
	Иначе Сообщить("Для типа метаданных <"+Тип+"> не определен метод создания нового. Обратитесь к разработчику.",СтатусСообщения.Внимание); Возврат Неопределено КонецЕсли
КонецФункции	
Процедура ОчисткаОбъекта1С(Объект1С,ЗапрещенныйВидИспользования)
	Если Не Объект1С.ЭтоНовый() Тогда
		МетаданныеОбъекта=Объект1С.Метаданные();
		Для каждого МД Из МетаданныеОбъекта.Реквизиты Цикл
			Если ЗапрещенныйВидИспользования<>"" И МД.Использование=ЗапрещенныйВидИспользования Тогда Продолжить КонецЕсли;
			Объект1С[МД.Имя]="" 
		КонецЦикла;
		Для каждого МДТЧ Из МетаданныеОбъекта.ТабличныеЧасти Цикл
			Если ЗапрещенныйВидИспользования<>"" И МДТЧ.Использование=ЗапрещенныйВидИспользования Тогда Продолжить КонецЕсли;
			Объект1С[МДТЧ.Имя].Очистить()
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
Функция ЗапрещенныйВидИспользования(Объект1С,ИмяМД) //для справочника не все реквизиты есть у группы и элемента
	Если Найти(ИмяМД,"Справочник.")>0 Тогда 
		Возврат ?(Объект1С.ЭтоГруппа,Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента,Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы)
	Иначе Возврат "" КонецЕсли
КонецФункции

Функция ЗаписатьВиртуальныеТаблицы(Объект1С,ТекстОшибки,Отказ) //запись виртуальных таблиц для Объект1С
	//где:
	//Объект1С - Созданная внутренняя ссылка по данным ДанныеСсылки
	//Объект1С.ДополнительныеСвойства.ВиртуальныеТаблицы - ТаблицаЗначений с описанием виртуальных таблиц
	//Объект1С.ДополнительныеСвойства.ДанныеСсылки - данные внешней ссылки (по СКД)
	//Объект1С.ДополнительныеСвойства.ДанныеРеквизитовСсылки - таблица реквизитов внешнего объекта + Конвертация (по СКД)
	
	Для Каждого ВиртТабл Из Объект1С.ДополнительныеСвойства.ВиртуальныеТаблицы Цикл
		Если ВиртТабл.ТолькоЧтение Тогда Продолжить КонецЕсли;
		ИмяМД=ВиртТабл.Имя;
		Если Найти(ИмяМД,"РегистрСведений.")>0 Тогда
			Менеджер=Вычислить(СтрЗаменить(ИмяМД,"РегистрСведений.","РегистрыСведений."));
			
			Если ВиртТабл.ПравилоПоиска.Пустая() Тогда 
			//построчная запись регистра
				Для Каждого Строка Из ВиртТабл.Строки Цикл
					Запись=Менеджер.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(Запись,Строка);
					Запись=ВычислитьПоПравилу(Объект1С,ВиртТабл.Правило,Запись,ТекстОшибки,Отказ); //постобработка
					Если Отказ Тогда Прервать КонецЕсли;					
					Попытка Запись.Записать()
					Исключение 
						Отказ=Истина;
						ТекстОшибки=ТекстОшибки+?(ТекстОшибки="","",Символы.ПС+Символы.Таб+"Ошибка записи <"+ИмяМД+">:"+Символы.ПС+Символы.Таб+ОписаниеОшибки());
					КонецПопытки;	
				КонецЦикла;
				
			Иначе
			//пакетная запись регистра - набором записей
				//обязательно установить отбор, иначе можно стереть все записи регистра. Пример: НаборЗаписей.Отбор.Объект.Установить(Ссылка)
				НаборЗаписей=ВычислитьПоПравилу(Объект1С,ВиртТабл.ПравилоПоиска,Менеджер.СоздатьНаборЗаписей(),ТекстОшибки,Отказ); //поиск в данном случае - отбор по регистру
				Если Отказ Тогда Сообщить("Ошибка отбора набора записей <"+ИмяМД+">",СтатусСообщения.Внимание); Продолжить КонецЕсли;
				Для Каждого Строка Из ВиртТабл.Строки Цикл ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(),Строка) КонецЦикла;
				НаборЗаписей=ВычислитьПоПравилу(Объект1С,ВиртТабл.Правило,НаборЗаписей,ТекстОшибки,Отказ); //постобработка
				Если Отказ Тогда Сообщить("Ошибка записи набора записей <"+ИмяМД+">",СтатусСообщения.Внимание) Иначе НаборЗаписей.Записать() КонецЕсли;
			КонецЕсли;	

		Иначе
			Отказ=Истина;
			ТекстОшибки=ТекстОшибки+?(ТекстОшибки="","",Символы.ПС+Символы.Таб+"Не задан алгоритм конвертиции для виртуальной таблицы <"+ИмяМД+">");
		КонецЕсли;	
	КонецЦикла;
	//Возврат Не Отказ
КонецФункции	

Процедура Renault_ВыгрузкаДанныхVOC(Парам = Неопределено) Экспорт
	
	ОбработкаВыгрузки = Обработки.Renault_ВыгрузкаВVOC.Создать();
	Настройки = Константы.Renault_НастройкиВыгрузкиVOC.Получить().Получить();
	ЗаполнитьЗначенияСвойств(ОбработкаВыгрузки,Настройки);
	Для каждого Эл из Настройки Цикл
		Если ТипЗнч(Эл.Значение) = Тип("ТаблицаЗначений") Тогда
			ОбработкаВыгрузки[Эл.Ключ].Загрузить(Эл.Значение);
		КонецЕсли;
	КонецЦикла;
	
	
	#Если НЕ Клиент Тогда
		//выгружаем данные за предыдущую неделю
		ОбработкаВыгрузки.КонецПериода = НачалоНедели(ТекущаяДата())-1;
		ОбработкаВыгрузки.НачалоПериода = НачалоНедели(ОбработкаВыгрузки.КонецПериода);		
	#КонецЕсли
	ОбработкаВыгрузки.ВыгрузитьЗаказНаряды();
	 
	ТаблицаДанных = ОбработкаВыгрузки.РезультатПоЗаказНарядам.Выгрузить();
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ТаблицаДанных.Колонки.Удалить("ЗаказНаряд");
	ТаблицаДанных.Колонки.Удалить("Организация");
	ВременныйФайл = ПолучитьИмяВременногоФайла("xls");
 	ОбработкаВыгрузки.ВыгрузитьЗаказНарядыВФаил(ВременныйФайл,ТаблицаДанных);	
	Данные = Новый ДвоичныеДанные(ВременныйФайл);
	
	ДанныеКОтправке = Новый ХранилищеЗначения(Данные);
	
	ВебСервис = ПолучитьВебСервисВыгрузкиVOC();
	
	BIR = Константы.Renault_BIR_db.Получить();
	
	ТипОтчета = "Заказ-наряды";
	
	Ответ = ВебСервис.UploadVocReport(BIR,ОбработкаВыгрузки.Логин,ОбработкаВыгрузки.Пароль,ДанныеКОтправке,ТипОтчета);
	#Если Клиент Тогда
		Сообщить(Ответ);
	#Иначе	
		Если Ответ <> "Успешно загружен!" Тогда
			ЗаписьЖурналаРегистрации("Регламентное задание Renault_ВыгрузкаДанныхVOC" , УровеньЖурналаРегистрации.Ошибка,,,""+ Ответ);
		КонецЕсли;
	#КонецЕсли
		
КонецПроцедуры

Функция СформироватьТелоЗапроса(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

Функция ПолучитьВебСервисВыгрузкиVOC()
	
		
	Перем ВебСервис;
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	Адрес = Настройки.АдресWsGate+"ws/RenaultReports.1cws?wsdl";
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	ОпределениеСервиса = Новый WSОпределения(Адрес, ЛогинWS, ПарольWS);
	
	Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
		Выполнить("ВебСервис=Новый WSПрокси(ОпределениеСервиса,""http://renault-nissan.com/schema/RenaultReports"",""Renault_Reports"",""Renault_ReportsSoap12"",60)");
	Иначе
		Выполнить("ВебСервис=Новый WSПрокси(ОпределениеСервиса,""http://renault-nissan.com/schema/RenaultReports"",""Renault_Reports"",""Renault_ReportsSoap12"",,60)");
	КонецЕсли;	
	
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Возврат ВебСервис;
	
КонецФункции
