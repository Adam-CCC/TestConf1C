Функция СтруктураМетаданных(ИмяМД,Менеджер=Ложь) Экспорт
	Попытка
		Стр=СтрЗаменить(ИмяМД,".",Символы.ПС);
		Тип=СтрПолучитьСтроку(Стр,1);
		ТипМД=СоставМетаданных()[Тип];
		Вид=СтрПолучитьСтроку(Стр,2);
		ИмяТЧ=СтрПолучитьСтроку(Стр,3);
		СтруктураМД=Новый Структура("Тип,ТипМД,Вид,Таблица",Тип,ТипМД,Вид,Неопределено);
		Если ИмяТЧ<>"" Тогда СтруктураМД.Вставить("Таблица",ИмяТЧ) КонецЕсли;
		Если Менеджер Тогда 
			ТипМ=Вычислить(ТипМД);
			СтруктураМД.Вставить("Менеджер",ТипМ[Вид]) КонецЕсли;
		Возврат СтруктураМД
	Исключение
		Сообщить("Не определены метаданные <"+ИмяМД+"> в составе метаданных для обмена",СтатусСообщения.Внимание);
		Возврат Неопределено
	КонецПопытки
КонецФункции	
Функция МетаданныеИзСтроки(ИмяМД) Экспорт
	СтруктураМД=СтруктураМетаданных(ИмяМД);
	Таблица=?(СтруктураМД.Таблица=Неопределено,"",".ТабличныеЧасти."+СтруктураМД.Таблица);
	Попытка Возврат Вычислить("Метаданные."+СтруктураМД.ТипМД+"."+СтруктураМД.Вид+Таблица) Исключение Возврат Неопределено КонецПопытки;	
КонецФункции	
Функция СсылкаВМетаданныеСтрокой(Ссылка) Экспорт
	МД=Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если МД=Неопределено Тогда Возврат Неопределено КонецЕсли;
	СтрокаТип=МД.ПолноеИмя();
	Если Найти(СтрокаТип,"Перечисление.")>0 Тогда
		Значение=МД.ЗначенияПеречисления[Перечисления[МД.Имя].Индекс(Ссылка)];
		Возврат "Перечисление."+МД.Имя+"."+Значение.Имя
	КонецЕсли;
	Возврат СтрокаТип
КонецФункции
Функция ТипЗначенияВМетаданныеСтрокой(Тип) Экспорт МД=Метаданные.НайтиПоТипу(Тип); Если МД=Неопределено Тогда Возврат Неопределено Иначе Возврат МД.ПолноеИмя() КонецЕсли КонецФункции
Функция ИмяВнешнейТаблицы(ИмяМД) Если Найти(ИмяМД,"Документ.")>0 Тогда Возврат "Документы" Иначе Возврат "Справочники" КонецЕсли КонецФункции //что не документ то справочник
Функция ОбъектМД(ИмяМД)
	Запрос=Новый Запрос("Выбрать Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.ОбъектыМД Где БазаДанных.ИдентификаторБазы=&ИдентификаторБазы И Имя=&ИмяМД И Активно");
	Запрос.УстановитьПараметр("ИмяМД",ИмяМД);
	Запрос.УстановитьПараметр("ИдентификаторБазы",ИдентификаторБазы());
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка
КонецФункции	
Функция РеквизитыОбъекта(ИмяМД)
	Запрос=Новый Запрос("Выбрать Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.РеквизитыМД Где ОбъектМД.БазаДанных.ИдентификаторБазы=&ИдентификаторБазы И ОбъектМД.Имя=&ИмяМД И Активно");
	Запрос.УстановитьПараметр("ИмяМД",ИмяМД);
	Запрос.УстановитьПараметр("ИдентификаторБазы",ИдентификаторБазы());
	Результат=Запрос.Выполнить();
	Если Результат.Пустой() Тогда Возврат Новый Массив КонецЕсли;
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка")
КонецФункции
Функция ТабличныеЧастиОбъекта(ИмяМД)
	Запрос=Новый Запрос("Выбрать Ссылка Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.ОбъектыМД Где БазаДанных.ИдентификаторБазы=&ИдентификаторБазы И Имя Подобно &ИмяМД И Активно");
	Запрос.УстановитьПараметр("ИмяМД",ИмяМД+".%");
	Запрос.УстановитьПараметр("ИдентификаторБазы",ИдентификаторБазы());
	Результат=Запрос.Выполнить();
	Если Результат.Пустой() Тогда Возврат Новый Массив КонецЕсли;
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка")
КонецФункции	
Функция СтруктураРеквизитовОбъектаМД(ОбъектМД) Экспорт //Структура реквизитов  (ИмяРеквизита + ТипЗначения)
	Перем ТекстЗапросаПоМД;
	ЕстьОшибки=Ложь;
	
	Если ТипЗнч(ОбъектМД)=Тип("Строка") Тогда //для метаданных строкой
		МД=МетаданныеИзСтроки(ОбъектМД);
		Если МД=Неопределено Тогда 
			Сообщить("Метаданные <"+ОбъектМД+"> не определены",СтатусСообщения.Внимание); 
			Возврат Ложь 
		КонецЕсли;
		
		Реквизиты=СписокПредопределенныхРеквизитов(ОбъектМД);
		Для Каждого Реквизит Из МД.Реквизиты Цикл Реквизиты.Добавить(Реквизит.Имя) КонецЦикла;
		
		ТекстЗапросаПоМД="Выбрать Первые 1 "+МассивВСтроку(Реквизиты,","+Символы.ПС+Символы.Таб)+" Из "+ОбъектМД;
		
	ИначеЕсли ПустаяСтрока(ОбъектМД.ТекстЗапроса) Тогда
	//по метаданным
	
		МД=Renault_ПередачаДанныхВСторонниеСистемы.МетаданныеИзСтроки(ОбъектМД.Имя);
		Если МД=Неопределено Тогда 
			Сообщить("Метаданные <"+ОбъектМД.Имя+"> не определены",СтатусСообщения.Внимание); 
			Возврат Ложь 
		КонецЕсли;
		
		//список реквизитов записанных во ВнешнийИсточникДанных
		Запрос=Новый Запрос("Выбрать Имя Из ВнешнийИсточникДанных.Renault_ПередачаДанныхВСторонниеСистемы.Таблица.РеквизитыМД Где ОбъектМД.БазаДанных.ИдентификаторБазы=&ИдентификаторБазы И Активно И ОбъектМД=&ОбъектМД");
		Запрос.УстановитьПараметр("ОбъектМД",ОбъектМД.Ссылка);
		Запрос.УстановитьПараметр("ИдентификаторБазы",ИдентификаторБазы());
		Реквизиты=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Имя");
		
		//Если Реквизиты.Количество()=0 Тогда //если реквизиты не записаны то обязательные реквизиты
		//	Реквизиты=СписокПредопределенныхРеквизитов(ОбъектМД.Имя);
			Если Реквизиты.Количество()=0 Тогда Возврат Новый Структура	КонецЕсли; //если нет обязательных то это табличная часть
		//КонецЕсли;
		
		//проверяем рекувизиты
		Для Каждого Реквизит Из Реквизиты Цикл
			Если МД.Реквизиты.Найти(Реквизит)=Неопределено И СписокПредопределенныхРеквизитов(ОбъектМД.Имя).НайтиПоЗначению(Реквизит)=Неопределено Тогда
				ЕстьОшибки=Истина;
				Сообщить("Не найден реквизит <"+Реквизит+">",СтатусСообщения.Внимание);
			КонецЕсли;
		КонецЦикла;	
		ТекстЗапросаПоМД="Выбрать Первые 1 "+МассивВСтроку(Реквизиты,","+Символы.ПС+Символы.Таб)+" Из "+ОбъектМД.Имя;
	Иначе
	//по запросу
		ТекстЗапросаПоМД="Выбрать Первые 1"+Символы.ПС+Сред(СокрЛП(ОбъектМД.ТекстЗапроса),8);
	КонецЕсли;	
	
	Попытка
		СтрМетаданных=Новый Структура;		
		Запрос=Новый Запрос(ТекстЗапросаПоМД);
		Запрос.УстановитьПараметр("Ссылка",NULL); //предопределенный параметр
		Для Каждого Кол Из Запрос.Выполнить().Выгрузить().Колонки Цикл СтрМетаданных.Вставить(Кол.Имя,Кол.ТипЗначения) КонецЦикла;	
	Исключение
		Сообщить("Ошибка определения структуры реквизитов объекта <"+ОбъектМД+">. "+ОписаниеОшибки(),СтатусСообщения.Внимание);
		Возврат Ложь
	КонецПопытки;	
	
	Возврат ?(ЕстьОшибки,Ложь,СтрМетаданных)
КонецФункции	
Функция СписокПредопределенныхРеквизитов(ИмяМД,ДляЧтения=Ложь) Экспорт //предопределенные реквизиты объектов
	Сп=Новый СписокЗначений;
	МД=МетаданныеИзСтроки(ИмяМД);
	Если МД<>Неопределено Тогда
		СтруктураМД=СтруктураМетаданных(ИмяМД);
		//ВидЗаписи=ВидыЗаписей();
		Если СтруктураМД.Таблица=Неопределено Тогда
			
			Если ДляЧтения Тогда 
				Сп.Добавить("Ссылка");
				Сп.Добавить("Представление");
				Сп.Добавить("ПометкаУдаления");
				Сп.Добавить("ВерсияДанных");
			КонецЕсли;
			
			//Если Найти(ИмяМД,"Справочник.")>0 Тогда
			Если СтруктураМД.Тип="Справочник" Тогда
				Если МД.ДлинаКода>0 Тогда Сп.Добавить("Код") КонецЕсли;
				Если МД.ДлинаНаименования>0 Тогда Сп.Добавить("Наименование") КонецЕсли;
				Если МД.Владельцы.Количество()>0 Тогда Сп.Добавить("Владелец") КонецЕсли;
				Если МД.Иерархический Тогда 
					Сп.Добавить("Родитель");
					Если ДляЧтения И МД.ВидИерархии=Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда Сп.Добавить("ЭтоГруппа") КонецЕсли;
				КонецЕсли;
				Если ДляЧтения Тогда Сп.Добавить("Предопределенный") КонецЕсли;
				
			//ИначеЕсли Найти(ИмяМД,"Документ.")>0 Тогда
			ИначеЕсли СтруктураМД.Тип="Документ" Тогда
				Если МД.ДлинаНомера>0 Тогда Сп.Добавить("Номер") КонецЕсли;
				Сп.Добавить("Дата");
				Если ДляЧтения Тогда Сп.Добавить("Проведен") КонецЕсли;
				
			//ИначеЕсли Найти(ИмяМД,"БизнесПроцесс.")>0 Тогда
			ИначеЕсли СтруктураМД.Тип="БизнесПроцесс" Тогда
				Если МД.ДлинаНомера>0 Тогда Сп.Добавить("Номер") КонецЕсли;
				Сп.Добавить("Дата");
				Сп.Добавить("Завершен");
				Сп.Добавить("ВедущаяЗадача");
				Сп.Добавить("Стартован");
				
			//ИначеЕсли Найти(ИмяМД,"Задача.")>0 Тогда
			ИначеЕсли СтруктураМД.Тип="Задача" Тогда
				Если МД.ДлинаНомера>0 Тогда Сп.Добавить("Номер") КонецЕсли;
				Если МД.ДлинаНаименования>0 Тогда Сп.Добавить("Наименование") КонецЕсли;
				Сп.Добавить("Дата");
				Сп.Добавить("Выполнена");
				Если Метаданные.БизнесПроцессы.Количество()>0 Тогда
					Сп.Добавить("БизнесПроцесс");
					Сп.Добавить("ТочкаМаршрута");
				КонецЕсли;	
				
			//ИначеЕсли Найти(ИмяМД,"ПланСчетов.")>0 Тогда
			ИначеЕсли СтруктураМД.Тип="ПланСчетов" Тогда
				Сп.Добавить("Родитель");
				Если МД.ДлинаКода>0 Тогда Сп.Добавить("Код") КонецЕсли;
				Если МД.ДлинаНаименования>0 Тогда Сп.Добавить("Наименование") КонецЕсли;
				Сп.Добавить("Вид");
				Сп.Добавить("Забалансовый");
				
			//ИначеЕсли Найти(ИмяМД,"ПланОбмена.")>0 Тогда
			ИначеЕсли СтруктураМД.Тип="ПланОбмена" Тогда
				Если МД.ДлинаКода>0 Тогда Сп.Добавить("Код") КонецЕсли;
				Если МД.ДлинаНаименования>0 Тогда Сп.Добавить("Наименование") КонецЕсли;
				Сп.Добавить("НомерОтправленного");
				Сп.Добавить("НомерПринятого");
				Если ДляЧтения Тогда Сп.Добавить("ЭтотУзел") КонецЕсли;
				
			//ИначеЕсли Найти(ИмяМД,"ПланВидовХарактеристик.")>0 Тогда
			ИначеЕсли СтруктураМД.Тип="ПланВидовХарактеристик" Тогда
				Если МД.ДлинаКода>0 Тогда Сп.Добавить("Код") КонецЕсли;
				Если МД.ДлинаНаименования>0 Тогда Сп.Добавить("Наименование") КонецЕсли;
				Если ДляЧтения Тогда
					Сп.Добавить("ТипЗначения");
					Сп.Добавить("Предопределенный");
				КонецЕсли;
				
			//ИначеЕсли Найти(ИмяМД,"РегистрСведений.")>0 Тогда
			ИначеЕсли СтруктураМД.Тип="РегистрСведений" Тогда
				Если МД.ПериодичностьРегистраСведений<>Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда Сп.Добавить("Период") КонецЕсли;
				Если МД.РежимЗаписи=Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда Сп.Добавить("Регистратор") КонецЕсли;
				Для Каждого Измерение Из МД.Измерения Цикл Сп.Добавить(Измерение.Имя) КонецЦикла;
				Для Каждого Ресурс Из МД.Ресурсы Цикл Сп.Добавить(Ресурс.Имя) КонецЦикла;
				//Для Каждого Реквизит Из МД.Реквизиты Цикл Сп.Добавить(Реквизит.Имя) КонецЦикла;
				
			//ИначеЕсли Найти(ИмяМД,"WSСсылка.")>0 Тогда
			//ИначеЕсли Найти(ИмяМД,"WebСервис.")>0 Тогда
			//ИначеЕсли Найти(ИмяМД,"ВнешнийИсточникДанных.")>0 Тогда
			//ИначеЕсли Найти(ИмяМД,"Константа.")>0 Тогда
			//ИначеЕсли Найти(ИмяМД,"Обработка.")>0 Тогда
			//ИначеЕсли Найти(ИмяМД,"Перечисление.")>0 Тогда
			//ИначеЕсли Найти(ИмяМД,"ПланВидовРасчета.")>0 Тогда
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	Возврат Сп
КонецФункции
