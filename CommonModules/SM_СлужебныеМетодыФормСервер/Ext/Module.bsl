Функция ПолучитьЦенуПозицииПартии(Партия,Номенклатура) Экспорт 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Цены.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.Цены КАК Цены
		|ГДЕ
		|	Цены.Регистратор = &Регистратор
		|	И Цены.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура"	, Номенклатура);
	Запрос.УстановитьПараметр("Регистратор"		, Партия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда   
		Возврат 0;
	Иначе
		Возврат РезультатЗапроса.Выгрузить()[0].Цена;
	КонецЕсли;
КонецФункции