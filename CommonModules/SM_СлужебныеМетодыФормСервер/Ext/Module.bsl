
Функция ПроверитьТабличнуюЧастьТовары(ТаблицаЗначенийТовары) Экспорт
	ПараметрыПроверки	= ПолучитьСтруктуруПараметровПроверки();
	Товары				= ТаблицаЗначенийТовары;
	
	Для Каждого СтрокаТовара Из Товары Цикл
		Номенклатура = СтрокаТовара.Номенклатура; 
		
		Если Не (ЭтоМаркированнаяНоменклатура(Номенклатура) И ЭтоМоторноеМасло(Номенклатура)) Тогда
			Продолжить;	
		КонецЕсли;   
		
		ИндексСтроки = Товары.Индекс(СтрокаТовара);
		
		Если СтрокаТовара.ЕдиницаИзмерения <> Номенклатура.ОсновнаяЕдиницаИзмерения Тогда
			ПараметрыПроверки.ЕстьОшибки = Истина;
			ПараметрыПроверки.НомераСтрокСОшибкамиЕдиниц.Добавить(ИндексСтроки);
		КонецЕсли;
		
		ПараметрыРасчета = РассчитатьПараметрыСтроки(СтрокаТовара);  
		
		Если Не ПараметрыРасчета.РасчетВерен Тогда
			ПараметрыПроверки.ЕстьОшибки = Истина;
			ПараметрыПроверки.ОшибкиРасчетаСуммы.Вставить(ИндексСтроки, ПараметрыРасчета);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ПараметрыПроверки;	
КонецФункции

Функция ПолучитьСтруктуруПараметровПроверки()	
	Возврат Новый Структура("ЕстьОшибки,НомераСтрокСОшибкамиЕдиниц,ОшибкиРасчетаСуммы", 
							 Ложь,Новый Массив,Новый Соответствие);	
КонецФункции	

Функция ПолучитьСтруктуруСтроки() Экспорт 
	Возврат Новый Структура("Количество,Коэффициент,Цена,Сумма");
КонецФункции

Функция РассчитатьПараметрыСтроки(СтрокаТовара)
	Количество		= СтрокаТовара.Количество;
	Коэффициент 	= СтрокаТовара.Коэффициент;
	Цена			= СтрокаТовара.Цена;
	СуммаСтроки		= СтрокаТовара.Сумма;
	Произведение	= Количество * Коэффициент * Цена;
	РасчетЦены		= Окр(СтрокаТовара.Сумма / (СтрокаТовара.Количество * СтрокаТовара.коэффициент),2);
	РасчетВерен		= (Цена = РасчетЦены);
	
	Возврат Новый Структура("Цена,РасчетЦены,РасчетВерен", 
							 Цена,РасчетЦены,РасчетВерен);	
КонецФункции  

