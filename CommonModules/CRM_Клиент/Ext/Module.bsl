
// Функция "расщепляет" строку на подстроки, используя заданный 
//		разделитель. Разделитель может иметь любую длину. 
//		Если в качестве разделителя задан пробел, рядом стоящие пробелы 
//		считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//		игнорируются.
//		Например, 
//		РазложитьСтрокуВМассивПодстрок(",ку,,,му", ",") возвратит массив значений из пяти элементов, 
//		три из которых - пустые строки, а 
//		РазложитьСтрокуВМассивПодстрок(" ку   му", " ") возвратит массив значений из двух элементов
//
//	Параметры: 
//		Стр - 			строка, которую необходимо разложить на подстроки. 
//						Параметр передается по значению.
//		Разделитель - 	строка-разделитель, по умолчанию - запятая.
//
//
//	Возвращаемое значение:
//		массив значений, элементы которого - подстроки
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",") Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // глРазложить

// Функция раскладывает Наименование в массив из трех элементов
//
// Параметры
//  ФИО  - строка - наименование
//
// Возвращаемое значение:
//   Массив   - массив из трех элементов, Фамилия, Имя, Отчество
//
Функция ПолучитьМассивФИО(ФИО) Экспорт

	МассивФИО = Новый Массив;
	МассивФИО.Добавить("");
	МассивФИО.Добавить("");
	МассивФИО.Добавить("");
	
	МассивПодсток = РазложитьСтрокуВМассивПодстрок(ФИО, " ");
	Для Индекс = 0 По МассивПодсток.ВГраница() Цикл
		Если Индекс < 3 Тогда
			МассивФИО[Индекс] = МассивПодсток[Индекс];
		Иначе
			МассивФИО[2] = МассивФИО[2] + " " + МассивПодсток[Индекс];
		КонецЕсли;
	КонецЦикла;

	Возврат МассивФИО;
	
КонецФункции // ПолучитьМассивФИО()

// Функция дополняет строку до указаной длины определенным символов
//
// Параметры:
//	Стр		- Строка	- Строка
//	Длина	- Число		- Длина строки
//	Чем		- Строка	- Символ для добавления
//
// Возвращаемое значение:
//	Строка	- Строка, дополненная до указанной длины
//
Функция ДополнитьСтроку(Знач Стр, Длина, Чем = " ") Экспорт
	
	СимволовДополнить = Длина - СтрДлина(Стр);
	Добавок = "";
	Для Н = 1 По СимволовДополнить Цикл
		Добавок = Добавок + Чем;
	КонецЦикла;
	Возврат Добавок + Стр;
	
КонецФункции

Процедура ПечатьДоверенностиНаТестДрайв(ПараметрКоманды) Экспорт
	
	Если НЕ Renault_УправлениеПечатьюКлиент.ПроверитьДокументыПроведены(ПараметрКоманды) Тогда
		Возврат
	КонецЕсли;
	
	ИмяМакета = "ПФ_DOC_Доверенность";
	МакетИДанныеОбъекта = Renault_УправлениеПечатьюВызовСервера.ПолучитьМакетыИДанныеОбъектов("Документ.CRM_ЗаписьНаТестДрайв", ИмяМакета, ПараметрКоманды);
	
	ТипМакета = МакетИДанныеОбъекта.Макеты.ТипыМакетов[ИмяМакета];
	Области = МакетИДанныеОбъекта.Макеты.ОписаниеОбластей;
	Для Каждого ДокументСсылка Из ПараметрКоманды Цикл
		ДвоичныеДанныеМакетов = МакетИДанныеОбъекта.Макеты.ДвоичныеДанныеМакетов;
		ДанныеОбъекта = МакетИДанныеОбъекта.Данные[ДокументСсылка][ИмяМакета];
		Попытка
			Макет = Renault_УправлениеПечатьюКлиент.ИнициализироватьМакет(ДвоичныеДанныеМакетов[ИмяМакета], ТипМакета);
			ПечатнаяФорма = Renault_УправлениеПечатьюКлиент.ИнициализироватьПечатнуюФорму(ТипМакета, Макет.НастройкиСтраницыМакета, Макет);
			Область = Renault_УправлениеПечатьюКлиент.ПолучитьОбласть(Макет, Области[ИмяМакета]["Заголовок"]);
			Renault_УправлениеПечатьюКлиент.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
			Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(ПечатнаяФорма);
		Исключение
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИнформацияОбОшибке().Описание);
			Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(ПечатнаяФорма);
			Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);
			Возврат;
		КонецПопытки;
		Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(ПечатнаяФорма, Ложь);
		Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьНезаполненныеДанные(ДанныеОбъекта) 
	
	Для Каждого Данные Из ДанныеОбъекта Цикл
		Если НЕ ЗначениеЗаполнено(Данные.Значение) Тогда
			Возврат Истина
		КонецЕсли
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция ТипМакета(ИмяОбъектаМетаданныхМакета)
	
	ТипыМакетов = Новый Массив;
	ТипыМакетов.Добавить("MXL");
	ТипыМакетов.Добавить("DOC");
	ТипыМакетов.Добавить("ODT");
	
	Для Каждого ТипМакета Из ТипыМакетов Цикл
		Позиция = Найти(ИмяОбъектаМетаданныхМакета, "ПФ_" + ТипМакета);
		Если Позиция > 0 Тогда
			Возврат ТипМакета;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьСписокМакетов(ИмяМенеджераПечати, ВнешниеМакеты)
	
	СписокМакетов = Новый СписокЗначений;
	//Определим метаданныеОбъекта
	докМетаданные = Метаданные.НайтиПоПолномуИмени(ИмяМенеджераПечати);
	Если докМетаданные <> Неопределено Тогда
		Для Каждого ОбъектМетаданныхМакет Из докМетаданные.Макеты Цикл
			//Заполняем стандартные встренные шаблоны;
			ТекТипМакета  = ТипМакета(ОбъектМетаданныхМакет.Имя); 
			Если ТекТипМакета = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СписокМакетов.Добавить(ОбъектМетаданныхМакет.Имя, ОбъектМетаданныхМакет.Синоним);
			СтандартныйМакет = ВнешниеМакеты.Добавить();
			СтандартныйМакет.Имя = ОбъектМетаданныхМакет.Имя;
			СтандартныйМакет.ТипМакета = ТекТипМакета;
			
			СтандартныйМакет.Предопределенный = Истина;
			
		КонецЦикла;
	КонецЕсли;
	
	// пользовательские макеты
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПользовательскиеМакетыПечати.ИмяМакета,
	               |	ПользовательскиеМакетыПечати.Макет,
	               |	ПользовательскиеМакетыПечати.ТипМакета
	               |ИЗ
	               |	РегистрСведений.Renault_ПользовательскиеМакетыПечати КАК ПользовательскиеМакетыПечати
	               |ГДЕ
	               |	ПользовательскиеМакетыПечати.Объект = &Объект
	               |	И ПользовательскиеМакетыПечати.Использование = ИСТИНА";
				   
	Запрос.УстановитьПараметр("Объект", ИмяМенеджераПечати);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Для Каждого ОписаниеМакета Из Выгрузка Цикл
		выбЭлемент = СписокМакетов.НайтиПоЗначению(ОписаниеМакета.ИмяМакета); 
		Если выбЭлемент = Неопределено Тогда
			// не нашли - добавим
			СписокМакетов.Добавить(ОписаниеМакета.ИмяМакета, ОписаниеМакета.ИмяМакета); 
		КонецЕсли;
		Отбор = Новый Структура;
		Отбор.Вставить("Имя", ОписаниеМакета.ИмяМакета); 
		НайденныеМакеты = ВнешниеМакеты.НайтиСтроки(Отбор);
		Если НайденныеМакеты.Количество()=0 Тогда
			ВнешнийМакет = ВнешниеМакеты.Добавить();
			ВнешнийМакет.Имя = ОписаниеМакета.ИмяМакета;
			ВнешнийМакет.ТипМакета = ОписаниеМакета.ТипМакета;
			ВнешнийМакет.Макет = ОписаниеМакета.Макет;
			ВнешнийМакет.Предопределенный = Ложь;
		Иначе
			Для Каждого текОписание Из НайденныеМакеты Цикл
				текОписание.Макет = ОписаниеМакета.Макет;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИмяМенеджераПечати = "Документ.CRM_ЗаписьНаВыдачу" Тогда
		СписокМакетов.Добавить("Инструкция по выдаче");
		Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA тогда
			СписокМакетов.Добавить("МакетАктПриемаПередачиАвтомобиля","Акт приема-передачи автомобиля");
			СписокМакетов.Добавить("МакетГарантийногоТалона","Гарантийный талон автомобиля");
		КонецЕсли;
	КонецЕсли;
	ВнешниеМакеты.Свернуть("Имя, ТипМакета, Макет, Предопределенный",);
	
	СписокМакетов.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	
	Возврат СписокМакетов;
	
КонецФункции

Функция ОплатаПоДоговоруНеВыполнена(Договор) Экспорт
	
	Если ТипЗнч(Договор) = Тип("ДокументСсылка.Renault_Договор") Тогда
		ДилерскийЦентр = Договор.ДилерскийЦентр;
		Если ТипЗнч(Договор.Клиент)=Тип("СправочникСсылка.Контрагенты") Тогда
			ДоговорВзаиморасчетов = ?(Договор.ЗаказНаАвтомобиль.Пустая(),CRM_Сервер.DMS_ПолучитьОсновнойДоговорКонтрагента(Договор.Клиент),Договор.ЗаказНаАвтомобиль.ДоговорВзаиморасчетов);
		Иначе	
			ДоговорВзаиморасчетов = ?(Договор.ЗаказНаАвтомобиль.Пустая(),Договор.DMS_ДоговорВзаиморасчетов,Договор.ЗаказНаАвтомобиль.ДоговорВзаиморасчетов);
		КонецЕсли;
		Клиент = Договор.Клиент;
	ИначеЕсли ТипЗнч(Договор) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда
		ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		ДоговорВзаиморасчетов = Договор;
		Клиент = Договор.Владелец;
	КонецЕсли;
	
	Если НЕ ДилерскийЦентр.Продажи_ОграничиватьПечатьАктаПриемкиПередачиБезОплаты Тогда
		Возврат Ложь;
	КонецЕсли;		
	
	ЗапросОплата = Новый Запрос;
	ЗапросОплата.Текст = 
		"ВЫБРАТЬ
		|	ВзаиморасчетыКомпанииОстаткиИОбороты.Контрагент КАК Контрагент,
		|	ВзаиморасчетыКомпанииОстаткиИОбороты.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
		|	ВзаиморасчетыКомпанииОстаткиИОбороты.СуммаРасход КАК СуммаОплаты,
		|	ВзаиморасчетыКомпанииОстаткиИОбороты.СуммаКонечныйОстаток КАК ОстатокОплаты,
		|	ВзаиморасчетыКомпанииОстаткиИОбороты.СуммаПриход КАК СуммаДолга
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыКомпании.ОстаткиИОбороты(
		|			,
		|			,
		|			,
		|			,
		|			Контрагент = &Клиент И ДоговорВзаиморасчетов = &ДоговорВзаиморасчетов) КАК ВзаиморасчетыКомпанииОстаткиИОбороты";	
		
	ЗапросОплата.УстановитьПараметр("Клиент", Клиент);	
	ЗапросОплата.УстановитьПараметр("ДоговорВзаиморасчетов", ДоговорВзаиморасчетов);	
	
	Выборка = ЗапросОплата.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.СуммаДолга = Выборка.СуммаОплаты Тогда
			Возврат Ложь;
		Иначе
			Предупреждение("Оплата по договору внесена не полностью!"+Символы.ПС+"Печать акта недоступна до полной оплаты!");
			Возврат Истина;
		КонецЕсли;
	Иначе 
		Предупреждение("Оплата по договору не внесена!" + Символы.ПС + "Печать акта недоступна до полной оплаты!");
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Процедура ПечатьДокументаВыборФормы(ПараметрКоманды, ИмяМенеджераПечати) Экспорт
	
	ВнешниеМакеты = Новый ТаблицаЗначений;
	ВнешниеМакеты.Колонки.Добавить("Имя");
	ВнешниеМакеты.Колонки.Добавить("ТипМакета");
	ВнешниеМакеты.Колонки.Добавить("Макет");
	ВнешниеМакеты.Колонки.Добавить("Предопределенный");
	
	СписокМакетов = ПолучитьСписокМакетов(ИмяМенеджераПечати, ВнешниеМакеты);
	
	СписокМакетовПродвинутогоПакета = Новый СписокЗначений;
	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Если ПараметрКоманды.Количество()>0 Тогда
			Если ТипЗнч(ПараметрКоманды[0]) = Тип("ДокументСсылка.Renault_Договор") Тогда
				ПродвинутыйПакетПечатныхФорм = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ПродвинутыйПакетПечатныхФормПокупкиПродажи;
				Если ПродвинутыйПакетПечатныхФорм Тогда	
					Если ПараметрКоманды[0].Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
	                    СписокМакетов.Добавить("МакетСпецификация", "Спецификация");
						СписокМакетов.Добавить("МакетНаправлениеВКассу", "Направление в кассу");
						СписокМакетовПродвинутогоПакета.Добавить("МакетСпецификация", "Спецификация");
						СписокМакетовПродвинутогоПакета.Добавить("МакетНаправлениеВКассу", "Направление в кассу");
						Если ЗначениеЗаполнено(ПараметрКоманды[0].СтатусОкончательныхДокументов) Тогда			
							СписокМакетов.Добавить("МакетОсновногоДоговора", "Договор купли-продажи");			
							СписокМакетов.Добавить("МакетДоверенностьГИБДД", "Доверенность ГИБДД");
							СписокМакетов.Добавить("МакетСогласиеНаОбработкуПерсональныхДанных", "Обработка персональных данных");
							СписокМакетов.Добавить("МакетАктПриемаПередачиАвтомобиля", "Акт приема передачи автомобиля");
							СписокМакетов.Добавить("МакетАктПриемаПередачиНаУтилизацию", "Акт приема передачи на утилизацию");
							СписокМакетовПродвинутогоПакета.Добавить("МакетОсновногоДоговора", "Договор купли-продажи");			
							СписокМакетовПродвинутогоПакета.Добавить("МакетДоверенностьГИБДД", "Доверенность ГИБДД");
							СписокМакетовПродвинутогоПакета.Добавить("МакетСогласиеНаОбработкуПерсональныхДанных", "Обработка персональных данных");
							СписокМакетовПродвинутогоПакета.Добавить("МакетАктПриемаПередачиАвтомобиля", "Акт приема передачи автомобиля");
							СписокМакетовПродвинутогоПакета.Добавить("МакетАктПриемаПередачиНаУтилизацию", "Акт приема передачи на утилизацию");
							Если ПараметрКоманды[0].СуммаКредита<>0 Тогда
								СписокМакетов.Добавить("МакетГарантийноеПисьмо", "Гарантийное письмо ");
								СписокМакетовПродвинутогоПакета.Добавить("МакетГарантийноеПисьмо", "Гарантийное письмо ");
							КонецЕсли;
							
							#Если ТолстыйКлиентОбычноеПриложение Тогда
								ТипАвтомобиля = Документы.Renault_Договор.ОпределитьВидАвтомобиля(ПараметрКоманды[0].СоставДоговора[0].Автомобиль);
								
								Если ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.Комиссия Тогда
									СписокМакетов.Добавить("МакетОтчетКомиссионера", "Отчет комиссионера");
									СписокМакетовПродвинутогоПакета.Добавить("МакетОтчетКомиссионера", "Отчет комиссионера");					
								ИначеЕсли ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.Агентский Тогда
									СписокМакетов.Добавить("МакетОтчетАгента", "Отчет агента");
									СписокМакетовПродвинутогоПакета.Добавить("МакетОтчетАгента", "Отчет агента");						
								КонецЕсли;					
							#КонецЕсли
						
						КонецЕсли;	 
						СписокМакетов.Добавить("МакетПредварительногоДоговора", "Предварительный договор купли-продажи"); 		
		                СписокМакетовПродвинутогоПакета.Добавить("МакетПредварительногоДоговора", "Предварительный договор купли-продажи"); 			
					ИначеЕсли ПараметрКоманды[0].Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда						
						СписокМакетовПродвинутогоПакета.Добавить("МакетАктПриемаПередачиАвтомобиля", "Акт приема передачи автомобиля");						
						СписокМакетовПродвинутогоПакета.Добавить("МакетДоговорКорп", "Договор купли-продажи");
						СписокМакетов.Добавить("МакетАктПриемаПередачиАвтомобиля", "Акт приема передачи автомобиля");						
						СписокМакетов.Добавить("МакетДоговорКорп", "Договор купли-продажи");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// НАЧАЛО DMSCOR-1446 05.09.2019
	Если СписокМакетов.Количество() = 0 Тогда
		Сообщить("Не настроены печатные формы", СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	// КОНЕЦ DMSCOR-1446 05.09.2019
	
	ВыбЭлемент = СписокМакетов.ВыбратьЭлемент("Выберите печатную форму:");
	Если ВыбЭлемент = Неопределено Тогда 
	    Возврат;
	КонецЕсли; 
	
	Если ИмяМенеджераПечати = "Документ.Renault_Договор TCM 15m+" 
		ИЛИ	ИмяМенеджераПечати = "Документ.Renault_Договор" Тогда
		
		Если СписокМакетовПродвинутогоПакета.НайтиПоЗначению(ВыбЭлемент.Значение)<>Неопределено Тогда	
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				Документы.Renault_Договор.ПечатьПродвинутогоПакета(ВыбЭлемент.Значение, ПараметрКоманды[0]);
			#Иначе
				Сообщить("Необходимо доработать функцию печати для управляемого приложения");
			#КонецЕсли
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	ИмяМакета = ВыбЭлемент.Значение;
	Отбор = Новый Структура;
	Отбор.Вставить("Имя", ИмяМакета); 
	Если ИмяМакета = "Инструкция по выдаче" тогда
		Оповестить("Печатать инструкцию по выдаче");
		Возврат;
	ИначеЕсли ИмяМакета = "ПФ_MXL_СертификатКонтроля" тогда
		Оповестить("Печатать Сертификат контроля");
		Возврат;
	ИначеЕсли (ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA 
		И ИмяМенеджераПечати = "Документ.CRM_ЗаписьНаВыдачу") Тогда
		Если ПараметрКоманды[0].Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан Тогда
			Если ИмяМакета = "МакетАктПриемаПередачиАвтомобиля" Тогда
				Документы.Renault_Договор.ПечатьПродвинутогоПакета("МакетАктПриемаПередачиАвтомобиля", ПараметрКоманды[0].ДоговорНаПродажуАвтомобиля);
			ИначеЕсли ИмяМакета = "МакетГарантийногоТалона" Тогда
				Ответ = "";
				Задачи.DMS_ЗаявкаНаСогласование.ПечатьГарантийногоТалона(Ответ,ПараметрКоманды[0]);
				Если ТипЗнч(Ответ)<>Тип("ДвоичныеДанные") Тогда Сообщить("Ошибка печати"); Возврат КонецЕсли;
				ИмяВременногоФайла=ПолучитьИмяВременногоФайла(".pdf");
				Ответ.Записать(ИмяВременногоФайла);
				ЗапуститьПриложение(ИмяВременногоФайла);
			КонецЕсли;
			Возврат;
		Иначе
			Сообщить("Автомобиль нужно сначала выдать клиенту");
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	НайденныеМакеты = ВнешниеМакеты.НайтиСтроки(Отбор);
	Если НайденныеМакеты.Количество()>0 Тогда
		Если ИмяМакета = "Табличка выдачи" тогда
			ЗаписатьИсториюПечати(ИмяМакета,ПараметрКоманды[0].IDK,ПараметрКоманды[0].Клиент);
		КонецЕсли;
				
		ТекОписание = НайденныеМакеты[0];
		ТипМакета = ТекОписание.ТипМакета;
	
		Если ТекОписание.Предопределенный Тогда
			ИмяМакетаДляПолученияДанных = ТекОписание.Имя;
		Иначе
			ИмяМакетаДляПолученияДанных = "Прочее";
		КонецЕсли;
		
		Если ТипЗнч(ТекОписание.Макет)=Тип("ХранилищеЗначения") Тогда
			ВнешнийМакет = ТекОписание.Макет.Получить();
		Иначе
			ВнешнийМакет = Неопределено;    
		КонецЕсли;
		
		Если ИмяМенеджераПечати = "Документ.Renault_Договор TCM 15m+" Тогда
			ИмяМенеджераПечати = "Документ.Renault_Договор";
		КонецЕсли;
		
		Если ИмяМенеджераПечати = "Документ.Renault_Договор" 
			И Найти(нрег(ТекОписание.Имя),"акт ")>0
			И ОплатаПоДоговоруНеВыполнена(ПараметрКоманды[0]) Тогда
			
			Предупреждение("Оплата по договору не выполнена! Печать Акта приемки-передачи недоступна");
			Возврат;
		КонецЕсли;
		
		МакетИДанныеОбъекта =  Renault_УправлениеПечатьюВызовСервера.ПолучитьМакетыИДанныеОбъектов(ИмяМенеджераПечати, ИмяМакетаДляПолученияДанных, ПараметрКоманды);
		
		Для Каждого ДокументСсылка Из ПараметрКоманды Цикл
			ДвоичныеДанныеМакетов = МакетИДанныеОбъекта.Макеты.ДвоичныеДанныеМакетов;
	        ДанныеОбъекта = МакетИДанныеОбъекта.Данные[ДокументСсылка][ИмяМакетаДляПолученияДанных];
			Попытка
				Макет = Renault_УправлениеПечатьюКлиент.ИнициализироватьМакет(?(ВнешнийМакет=Неопределено, ДвоичныеДанныеМакетов[ИмяМакетаДляПолученияДанных], ВнешнийМакет), ТипМакета);
				Если ВРег(ТипМакета) ="MXL" Тогда
					Попытка
						Макет.Вставить("Объект", ДокументСсылка);
						Renault_УправлениеПечатью.ЗаполнитьТабличныйДокумент(Макет.ТабДок,ДанныеОбъекта);
						ПечатнаяФорма = Renault_УправлениеПечатьюКлиент.ИнициализироватьПечатнуюФорму(ТипМакета,ДокументСсылка,Макет);
						Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(ПечатнаяФорма);	
					Исключение
						Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИнформацияОбОшибке().Описание);
					КонецПопытки;
				ИначеЕсли ВРег(ТипМакета) ="DOC" Тогда 
					Попытка
						ОписаниеОбласти = Новый Структура;
						ОписаниеОбласти.Вставить("ТипОбласти", "Общая");
						ОписаниеОбласти.Вставить("ИмяОбласти", "Заголовок");
						
						ОписаниеОбластиВерхКолонтитул = Новый Структура;
						ОписаниеОбластиВерхКолонтитул.Вставить("ТипОбласти", "ВерхнийКолонтитул");
						ОписаниеОбластиВерхКолонтитул.Вставить("ИмяОбласти", "ВК");
						
						ОписаниеОбластиНижКолонтитул = Новый Структура;
						ОписаниеОбластиНижКолонтитул.Вставить("ТипОбласти", "НижнийКолонтитул");
						ОписаниеОбластиНижКолонтитул.Вставить("ИмяОбласти", "НК");
						
						Области = МакетИДанныеОбъекта.Макеты.ОписаниеОбластей;
						
						ПечатнаяФорма = Renault_УправлениеПечатьюКлиент.ИнициализироватьПечатнуюФорму(ТипМакета,ДокументСсылка,Макет);
						
						Область = Renault_УправлениеПечатьюКлиент.ПолучитьОбласть(Макет, ОписаниеОбласти);
						ДанныеОбъектаОдноПоле = Новый Структура;
						Renault_УправлениеПечатьюКлиент.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъектаОдноПоле, Ложь);
						
						Renault_УправлениеПечатьюКлиент.АктивироватьДокумент(ПечатнаяФорма);
						//Печать документа
						ПечатнаяФорма = Renault_УправлениеПечатьюКлиент.ИнициализироватьПечатнуюФорму(ТипМакета, Макет.НастройкиСтраницыМакета, Макет);
						Область = Renault_УправлениеПечатьюКлиент.ПолучитьОбласть(Макет, ОписаниеОбласти);
						ОбластьВерхКолонтитул = Renault_УправлениеПечатьюКлиент.ПолучитьОбласть(Макет, ОписаниеОбластиВерхКолонтитул);
						ОбластьНижКолонтитул = Renault_УправлениеПечатьюКлиент.ПолучитьОбласть(Макет, ОписаниеОбластиНижКолонтитул);
						Renault_УправлениеПечатьюКлиент.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, ОбластьВерхКолонтитул, ДанныеОбъектаОдноПоле, Ложь);
						Renault_УправлениеПечатьюКлиент.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
						Renault_УправлениеПечатьюКлиент.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, ОбластьНижКолонтитул, ДанныеОбъектаОдноПоле, Ложь);
						Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(ПечатнаяФорма);
					Исключение
						Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИнформацияОбОшибке().Описание);
						Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(ПечатнаяФорма);
						Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);
						Возврат;
					КонецПопытки;
					Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(ПечатнаяФорма, Ложь);
					Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);
					
				ИначеЕсли ВРег(ТипМакета) ="DOCX" Тогда 
					ДанныеЗаполненногоФайла = Renault_АвтозаполнениеШаблоновФайловКлиентСервер.ЗаполнитьФайлMSWordПоДвоичнымДанным(
					ВРег(ТипМакета), ДанныеОбъекта, Макет.ПечатнаяФорма);
					ИмяВременногоФайла = ПолучитьИмяВременногоФайла("docx");
					ДанныеЗаполненногоФайла.Записать(ИмяВременногоФайла);
					//При открытии документа ориентируемся на настройку "Запрет редактирования выходных печатных форм" в правах пользователя.
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	ПраваИНастройки.Значение
					|ИЗ
					|	РегистрСведений.ПраваИНастройки КАК ПраваИНастройки
					|ГДЕ
					|	ПраваИНастройки.Объект = &Объект
					|	И ПраваИНастройки.ПравоНастройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПраваИНастройки.ЗащитаПечатныхФорм)";
					
					Запрос.УстановитьПараметр("Объект", ПараметрыСеанса.Пользователь);
					ВыборкаНастроек = Запрос.Выполнить().Выбрать();
					
					Если ВыборкаНастроек.Следующий() Тогда
						Если ВыборкаНастроек.Значение = Истина Тогда // открываем документ только для чтения.
							Попытка 
								Word = Новый COMОбъект("Word.Application");
								Word.Documents.Add(ИмяВременногоФайла);
								ГСЧ = Новый ГенераторСлучайныхЧисел();
								Word.Application.ActiveDocument.Protect(2,ИСТИНА,Строка(ГСЧ.СлучайноеЧисло(0, 10000)),Ложь,ИСТИНА);//устанавливаем случайный пароль на редактрование 
								Word.Visible = Истина;
								Сообщить(Word.WordBasic.MsgBox("Документ открыт только для чтения!",));
								ОчиститьСообщения();
								//Закрытие окна сообщений
								WshShell = Новый COMObject("WScript.Shell");
								WshShell.SendKeys("^+z");   //имитируем нажатие Ctr+Shift+Z
								WshShell.SendKeys("^+я");   //для случая, если текущей является русская раскладка клавиатуры
							Исключение // на случай ошибки по непредвиденным причинам.
								Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИнформацияОбОшибке().Описание);
								ЗапуститьПриложение(ИмяВременногоФайла);
							КонецПопытки;
						Иначе // открываем документ с возможностью редактирования.
							ЗапуститьПриложение(ИмяВременногоФайла);
						КонецЕсли;
					Иначе 
						ЗапуститьПриложение(ИмяВременногоФайла);
					КонецЕсли;
					
				ИначеЕсли ВРег(ТипМакета) ="ODT" Тогда 
					ДанныеЗаполненногоФайла = Renault_АвтозаполнениеШаблоновФайловКлиентСервер.ЗаполнитьФайлOpenOfficeWriter(
					Макет.ПечатнаяФорма, ВРег(ТипМакета), ДанныеОбъекта);
					ИмяВременногоФайла = ПолучитьИмяВременногоФайла(НРег(ТипМакета));
					ДанныеЗаполненногоФайла.Записать(ИмяВременногоФайла);
					ЗапуститьПриложение(ИмяВременногоФайла);
				КонецЕсли;
				
			Исключение
				Информация = ИнформацияОбОшибке();
				ЗаписьЖурналаРегистрации("Печать документа", УровеньЖурналаРегистрации.Ошибка, , ПодробноеПредставлениеОшибки(Информация));
				Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при печати:" + Информация.Описание);
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьИсториюПечати(ИмяМакета,РабочийЛист,Клиент)
	
	Менеджер = РегистрыСведений.DMS_ИсторияПечати.СоздатьМенеджерЗаписи();
	Менеджер.Период = ТекущаяДата();
	Менеджер.ПечатнаяФорма = ИмяМакета;
	Менеджер.Клиент = Клиент;
	Менеджер.РабочийЛист = РабочийЛист;
	Менеджер.Сотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
	Менеджер.Записать();
	
КонецПроцедуры	

//Блинков
Процедура СфОпЛид (ID = "") Экспорт
	
	Если ID = "" Тогда
		Возврат;
	КонецЕсли;
	СсылкаДокументЛид = Документы.Renault_Лид.ПолучитьСсылку(Новый УникальныйИдентификатор(ID));  //DMSREN-719
	Если ЗначениеЗаполнено(СсылкаДокументЛид) Тогда
		Если СсылкаДокументЛид.ТрафикОбработан = Ложь Тогда
			Парам = Новый Структура;
			Парам.Вставить("ID", СсылкаДокументЛид.ТрафикИД);
			Оповещение = Новый ОписаниеОповещения("ОткрытьПросрачиваемыйЛид",CRM_Клиент,Парам);
			ПоказатьОповещениеПользователя("Лид будет просрочен через "+СсылкаДокументЛид.ДилерскийЦентр.ПредДоИстеченияЛида+" мин.",Оповещение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОткрытьПросрачиваемыйЛид (ДопПараметры) Экспорт 
				Оповестить("ОткрытьЛид",ДопПараметры);
				ОткрытьФорму("Обработка.Renault_АРМ_ContactCenter.Форма",ДопПараметры,,Ложь);
КонецПроцедуры
