//регламентное задание по загрузке отчетов РН Банка
Функция РегЗадание_ЗагрузкаОтчетовРНБанка() Экспорт
	
	ВебСервис = WebService("Reports");
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	
	Запрос = Новый Запрос("
	|Выбрать
	|	BIRs.BIR,
	|	Рег.id
	|Из(Выбрать Подстрока(BIR,5,8) BIR Из Справочник.CRM_ДилерскиеЦентры ГДЕ НЕ ПометкаУдаления) BIRs
	|Левое Соединение РегистрСведений.Renault_RNB_Reports Рег По BIRs.BIR=Рег.BIR
	|");
	Парам = Сериализатор.ЗаписатьXDTO(Запрос.Выполнить().Выгрузить()); //параметр для передачи
	Таб = СериализаторXDTO.ПрочитатьXDTO(ВебСервис.getFiles(Парам)); //ответ сервера
	
	Если ТипЗнч(Таб) <> Тип("ТаблицаЗначений") Тогда
		Сообщить("Не удалось получить данные", СтатусСообщения.Внимание);
		Возврат Ложь;
	КонецЕсли;
	
	Если Таб.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	//складываем в РегистрыСведений.Renault_RNB_Reports
	Записи = РегистрыСведений.Renault_RNB_Reports.СоздатьНаборЗаписей();
	Для Каждого Стр Из Таб Цикл
		ЗаполнитьЗначенияСвойств(Записи.Добавить(), Стр);
	КонецЦикла;
	Записи.Записать(Истина);
	
	Возврат Истина;
	
КонецФункции


