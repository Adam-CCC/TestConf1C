
Функция WebService(ИмяСервиса)
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	АдресWS = Настройки.КЦАдресСервера;
	WSОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/" + ИмяСервиса + ".ws?wsdl", СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	ВебСервис = Новый WSПрокси(WSОпределение, "http://renault.ru", "RNB_" + ИмяСервиса, "RNB_" + ИмяСервиса + "Soap");
	ВебСервис.Пользователь = СокрЛП(ЛогинWS);
	ВебСервис.Пароль = СокрЛП(ПарольWS);
	
	Возврат ВебСервис;
	
КонецФункции

//регламентное задание по загрузке кредитных предложений РН Банка
функция РегЗадание_ЗагрузкаКредитныхПредложенийРНБанка(Парам = Неопределено, Интерактивно = Ложь) Экспорт
	
	//ВебСервис=WebService("Credit");
	
	//передадим на сервер идентификаторы имеющихся актуальных кредитных предложений
	Запрос = Новый Запрос("Выбрать id,ДатаПакета,НомерПакета Из Справочник.Renault_КредитныеПредложения ГДЕ id<>"""" И ДатаОкончанияПредложения>&ТекДата");
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	IDs = Запрос.Выполнить().Выгрузить();
	
	BIRs = DMS_ОбщиеПовторныеФункции.BIRs(); //БИРы дилера
	
	Данные = Новый Структура("IDs,BIRs", IDs, BIRs);
	Ответ = "";
	Если НЕ DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),"DictionaryHTTP","RNB_Serv.CreditTarifs",DMS_DataExchange.newPackage(Данные),Ответ) Тогда
		
		Если Интерактивно Тогда
			Сообщить(Ответ,СтатусСообщения.Внимание);
		Иначе
			ЗаписьЖурналаРегистрации("RNB_Serv.CreditTarifs",УровеньЖурналаРегистрации.Ошибка,,,Ответ);
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Попытка
		//Справочник.Renault_КатегорииКредитныхСервисов
		Для Каждого Стр Из Ответ.КатегорииКредитныхСервисов Цикл
			Спр=Справочники.Renault_КатегорииКредитныхСервисов.НайтиПоРеквизиту("id",Стр.id);
			СпрОбъект=?(Спр.Пустая(),Справочники.Renault_КатегорииКредитныхСервисов.СоздатьЭлемент(),Спр.ПолучитьОбъект());
			Если СпрОбъект.Наименование=Стр.Наименование Тогда Продолжить КонецЕсли;
			ЗаполнитьЗначенияСвойств(СпрОбъект,Стр);
			СпрОбъект.Записать();
		КонецЦикла;	
		
		//Справочник.ТипыКредитныхСервисов
		Для Каждого Стр Из Ответ.ТипыКредитныхСервисов Цикл
			Спр=Справочники.Renault_ТипыКредитныхСервисов.НайтиПоРеквизиту("id",Стр.id);
			СпрОбъект=?(Спр.Пустая(),Справочники.Renault_ТипыКредитныхСервисов.СоздатьЭлемент(),Спр.ПолучитьОбъект());
			Если СпрОбъект.Наименование=Стр.Наименование Тогда Продолжить КонецЕсли;
			ЗаполнитьЗначенияСвойств(СпрОбъект,Стр);
			СпрОбъект.КатегорияСервиса=Справочники.Renault_КатегорииКредитныхСервисов.НайтиПоРеквизиту("id",Стр.КатегорияСервиса_id);
			СпрОбъект.Записать();
		КонецЦикла;

		//Справочник.КредитныеСервисы
		Для Каждого Стр Из Ответ.КредитныеСервисы Цикл
			Спр=Справочники.Renault_КредитныеСервисы.НайтиПоРеквизиту("id",Стр.id);
			СпрОбъект=?(Спр.Пустая(),Справочники.Renault_КредитныеСервисы.СоздатьЭлемент(),Спр.ПолучитьОбъект());
			//Если СпрОбъект.Наименование=Стр.Наименование Тогда Продолжить КонецЕсли; перепишем на всякий случай
			ЗаполнитьЗначенияСвойств(СпрОбъект,Стр);
			СпрОбъект.ТипСервиса=Справочники.Renault_ТипыКредитныхСервисов.НайтиПоРеквизиту("id",Стр.ТипСервиса_id);
			СпрОбъект.СрокДействия=Стр.СрокДействия;
			СпрОбъект.СтоимостьСервиса.Очистить();
			//ТЧ.СтоимостьСервиса
			Для Каждого СтрТЧ Из Ответ.КредитныеСервисы_СтоимостьСервиса.НайтиСтроки(Новый Структура("КредитныеСервисы_id",Стр.id)) Цикл
				СтрТЧОбъекта=СпрОбъект.СтоимостьСервиса.Добавить();
				ЗаполнитьЗначенияСвойств(СтрТЧОбъекта,СтрТЧ);
				СтрТЧОбъекта.Модель=Справочники.Модели.НайтиПоРеквизиту("Артикул",СтрТЧ.Модель_Артикул);
			КонецЦикла;	
			СпрОбъект.Записать();
		КонецЦикла;
		
		//Справочник.Renault_КредитныеПредложения
		Для Каждого Стр Из Ответ.КредитныеПредложения Цикл
			Спр=Справочники.Renault_КредитныеПредложения.НайтиПоРеквизиту("id",Стр.id);
			СпрОбъект=?(Спр.Пустая(),Справочники.Renault_КредитныеПредложения.СоздатьЭлемент(),Спр.ПолучитьОбъект());
			//Если СпрОбъект.Наименование=Стр.Наименование Тогда Продолжить КонецЕсли; перепишем на всякий случай
			ЗаполнитьЗначенияСвойств(СпрОбъект,Стр);
			СпрОбъект.Владелец=Справочники.Renault_КредитныеПредложения.РНБанк();
			
			//ТЧ.КредитныеСтавки
			СпрОбъект.КредитныеСтавки.Очистить();
			Для Каждого СтрТЧ Из Ответ.КредитныеПредложения_КредитныеСтавки.НайтиСтроки(Новый Структура("КредитныеПредложения_id",Стр.id)) Цикл
				ЗаполнитьЗначенияСвойств(СпрОбъект.КредитныеСтавки.Добавить(),СтрТЧ);
			КонецЦикла;
			
			//ТЧ.ДоступныеВариантыКомплектации
			СпрОбъект.ДоступныеВариантыКомплектации.Очистить();
			Для Каждого СтрТЧ Из Ответ.КредитныеПредложения_ДоступныеВариантыКомплектации.НайтиСтроки(Новый Структура("КредитныеПредложения_id",Стр.id)) Цикл
				Строка=СпрОбъект.ДоступныеВариантыКомплектации.Добавить();
				Строка.ВариантКомплектации=Справочники.ВариантыКомплектации.НайтиПоРеквизиту("Артикул",СтрТЧ.ВариантКомплектации_Артикул);
				Строка.UserCar=СтрТЧ.UserCar;
			КонецЦикла;
			
			//ТЧ.ДоступныеСервисы
			СпрОбъект.ДоступныеСервисы.Очистить();
			Для Каждого СтрТЧ Из Ответ.КредитныеПредложения_ДоступныеСервисы.НайтиСтроки(Новый Структура("КредитныеПредложения_id",Стр.id)) Цикл
				СпрОбъект.ДоступныеСервисы.Добавить().Сервис=Справочники.Renault_КредитныеСервисы.НайтиПоРеквизиту("id",СтрТЧ.Сервис_id);
			КонецЦикла;
			
			//ТЧ.ОбязательныеСервисы
			СпрОбъект.ОбязательныеСервисы.Очистить();
			Для Каждого СтрТЧ Из Ответ.КредитныеПредложения_ОбязательныеСервисы.НайтиСтроки(Новый Структура("КредитныеПредложения_id", Стр.id)) Цикл
				СпрОбъект.ОбязательныеСервисы.Добавить().ТипСервиса = Справочники.Renault_ТипыКредитныхСервисов.НайтиПоРеквизиту("id", СтрТЧ.ТипСервиса_id);
			КонецЦикла;
			
			//ТЧ.СервисыПоУмолчанию
			СпрОбъект.СервисыПоУмолчанию.Очистить();
			Для Каждого СтрТЧ Из Ответ.КредитныеПредложения_СервисыПоУмолчанию.НайтиСтроки(Новый Структура("КредитныеПредложения_id", Стр.id)) Цикл
				СпрОбъект.СервисыПоУмолчанию.Добавить().ТипСервиса = Справочники.Renault_ТипыКредитныхСервисов.НайтиПоРеквизиту("id", СтрТЧ.ТипСервиса_id);
			КонецЦикла;
			
			СпрОбъект.Записать();
		КонецЦикла;
		
		Если Интерактивно Тогда
			Сообщить("Загрузка выполнена успешно. Получено "+Ответ.КредитныеПредложения.Количество()+" позиций");
		КонецЕсли;
		
		Если Не Интерактивно Тогда
			РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
			ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ЗагрузкаКредитныхПредложенийРНБанка"),
			ТекущаяДатаСеанса());
		КонецЕсли;
		
		Возврат Истина;
		
	Исключение
		
		Если Интерактивно Тогда
			Сообщить(ОписаниеОшибки(),СтатусСообщения.Внимание);
		Иначе
			ЗаписьЖурналаРегистрации("RNB_Serv.CreditTarifs",УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

//регламентное задание по загрузке фининсовых услуг РН Банка
Функция РегЗадание_ЗагрузкаФинансовыхУслугРНБанка(Парам=Неопределено,Интерактивно=Ложь) Экспорт
	
	Перем Ответ;
	
	//Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьHTTPСервисы Тогда	//http service
		Если НЕ DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),"DictionaryHTTP","RNB_Serv.FinanceServices",,Ответ) Тогда 
			Если Интерактивно Тогда
				Сообщить(Ответ,СтатусСообщения.Внимание);
			Иначе
				ЗаписьЖурналаРегистрации("RNB_Serv.FinanceServices",УровеньЖурналаРегистрации.Ошибка,,,Ответ);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
	//Иначе //WEB service
	//	Ответ=СериализаторXDTO.ПрочитатьXDTO(WebService("FinancialServices").getServices()); //таблица значений из веб-сервиса
	//КонецЕсли;	
	
	//запись в справочник
	Попытка
		
		Для Каждого Стр Из Ответ Цикл
	 //поля "UUID,Наименование,ПоставщикУслуги,ВидУслуги,ФиксированнаяЧастьТарифа,ПроцентнаяЧастьТарифа,НачалоПериодаДействия,ОкончаниеПериодаДействия,Модели,ПометкаУдаления",
			
			Ссылка = Справочники.DMS_ФинансовыеУслуги.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.UUID));
			Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
				Объект = Справочники.DMS_ФинансовыеУслуги.СоздатьЭлемент();
				Объект.УстановитьСсылкуНового(Ссылка);
			Иначе
				Объект = Ссылка.ПолучитьОбъект();
				//очистить реквизиты
				Для Каждого Рекв Из Метаданные.Справочники.DMS_ФинансовыеУслуги.Реквизиты Цикл
					Объект[Рекв.Имя] = "";
				КонецЦикла;
				Объект.Модели.Очистить();
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Объект,Стр);
			//Объект.Владелец=Справочники.DMS_ПоставщикиФинансовыхУслуг[Стр.ПоставщикУслуги];
			Объект.Владелец = Справочники.Renault_КредитныеПредложения.РНБанк();
			Объект.ВидУслуги = Справочники.DMS_ВидыФинансовыхУслуг[Стр.ВидУслуги]; //ВидУслуги(ЗначениеИзСтрокиВнутр(Стр.ВидУслуги));
			
			//модели
			Для Каждого АртикулМодели Из ЗначениеИзСтрокиВнутр(Стр.Модели) Цикл
				Запрос=Новый Запрос("Выбрать Ссылка Из Справочник.Модели ГДЕ НЕ ПометкаУдаления И Артикул=&Артикул");
				Запрос.УстановитьПараметр("Артикул",АртикулМодели);
				Выборка=Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Объект.Модели.Добавить().Модель = Выборка.Ссылка;
				КонецЕсли;
			КонецЦикла;
			
			Объект.UsedCar = Стр.UsedCar;
			Объект.ПометкаУдаления = Стр.ПометкаУдаления;
			Объект.Активна = Истина;
			Объект.Записать();
			
		КонецЦикла;
		
		Если Интерактивно Тогда
			Сообщить("Загрузка выполнена успешно. Получено "+Ответ.Количество()+" позиций");
		КонецЕсли;
		
		Возврат Истина;
		
	Исключение
		
		Если Интерактивно Тогда
			Сообщить(ОписаниеОшибки(),СтатусСообщения.Внимание);
		Иначе
			ЗаписьЖурналаРегистрации("RNB_Serv.FinanceService",УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
		КонецЕсли;
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

