Процедура СформироватьВыпискиЭПТС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭлектронноеПисьмо.Ссылка КАК ЭлПисьмо,
		|	ЭлектронноеПисьмо.Дата,
		|	ЭлектронноеПисьмо.ОтправительПредставление,
		|	ЭлектронноеПисьмо.Тема,
		|	ЭлектронноеПисьмо.Обработано
		|ИЗ
		|	Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
		|ГДЕ
		|	ЭлектронноеПисьмо.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЭлектронноеПисьмо.ОтправительПредставление ПОДОБНО &ОтправительПредставление
		|	И ЭлектронноеПисьмо.Тема ПОДОБНО &Тема
		|	И ЭлектронноеПисьмо.Обработано = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДата())-864000);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ОтправительПредставление", "%%"+"no-reply@zspd-sep.elpts.ru"+"%%");
	Запрос.УстановитьПараметр("Тема", "%%"+"Выписка из электронного паспорта ТС (шасси ТС)"+"%%");
	
	Состав = Запрос.Выполнить().Выгрузить();
	
	Если Состав.Количество() > 0 Тогда
		ОбработатьПисьма(Состав);
	КонецЕсли; 
    
КонецПроцедуры

Процедура ОбработатьПисьма(Состав) Экспорт
	
	Для каждого Стр Из Состав Цикл
		
 		Если Не Стр.ЭлПисьмо.ЕстьВложения Тогда
		    Продолжить;
		КонецЕсли;
		
		Если Стр.ЭлПисьмо.ПрикрепленныеФайлы.Количество() <> 1 Тогда
		    Продолжить;
		КонецЕсли;
		
		ИмяФайла =  Стр.ЭлПисьмо.ПрикрепленныеФайлы[0].Имя;
		Файл     =  Стр.ЭлПисьмо.ПрикрепленныеФайлы[0].Файл;
		
		ТолькоИмяФайла = Сред(ИмяФайла,1,СтрДлина(ИмяФайла)-4);
 		ТолькоРасширениеФайла = Прав(ИмяФайла,4);
		
		ТолькоИмяФайла = Прав(СтрЗаменить(ТолькоИмяФайла,".","_"),37);
		ИмяФайла = ""+ТолькоИмяФайла+ТолькоРасширениеФайла;
		
		ВИН = "";
		//Бондаренко++ 20201223
		Если Найти(ИмяФайла,"Vypiska iz elektronnogo pasporta Identifikacionnyj nomer") > 0 Тогда
			ВИН = СокрЛП(СтрЗаменить(ИмяФайла,"Vypiska iz elektronnogo pasporta Identifikacionnyj nomer","")); 
			ВИН = Сред(ВИН,1,Найти(ВИН," za")-1);
		КонецЕсли; 
		//Бондаренко-- 20201223
 			
		ТемаПисьма = СокрЛП(Стр.ЭлПисьмо.Тема);
		ДатаПисьмаСтрокой = Прав(СокрЛП(Стр.ЭлПисьмо.Тема),16);
		
		Год    = Сред(ДатаПисьмаСтрокой,  7, 4);
		Месяц  = Сред(ДатаПисьмаСтрокой,  4, 2);
		День   = Сред(ДатаПисьмаСтрокой,  1, 2);
		Час    = Сред(ДатаПисьмаСтрокой, 12, 2);
		Минута = Сред(ДатаПисьмаСтрокой, 15, 2);
		
		ДатаПисьма = Дата(Год, Месяц, День, Час, Минута, 0 );
		
		ТекстПисьма = СокрЛП(Стр.ЭлПисьмо.ТекстПисьма);
		ТекстПисьма = Сред(ТекстПисьма,СтрНайти(ТекстПисьма," № ")+ 3);
		НомерЭПТС   = Сред(ТекстПисьма,1,СтрНайти(ТекстПисьма,".")-1);
		
		//Бондаренко++ 20201223
		Если Врег(Прав(ИмяФайла,4)) <> ".PDF" Тогда
		    ИмяФайла = ВРЕГ(СокрЛП(ИмяФайла))+".PDF";
		КонецЕсли; 
		//Бондаренко-- 20201223		
		
		Успешно = Ложь;
  		Успешно = ОбработатьТекПисьмо(ВИН,ДатаПисьма,НомерЭПТС,ИмяФайла,Файл);
		Если Успешно Тогда
		    ЭлПисьмоОбъект = Стр.ЭлПисьмо.ПолучитьОбъект();
			ЭлПисьмоОбъект.Обработано = Истина;
			Попытка
				ЭлПисьмоОбъект.Записать();
 			Исключение
				//			
			КонецПопытки; 
 		КонецЕсли; 
 		
 	КонецЦикла;
	
КонецПроцедуры

Функция ОбработатьТекПисьмо(ВИН,ДатаПисьма,НомерЭПТС,ИмяФайла,Файл) Экспорт
	
	ТекДок = Справочники.ПодтверждающиеДокументы.ПустаяСсылка();
	
	Если обЗначениеНеЗаполнено(ВИН) Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Ссылка,
		|	ПодтверждающиеДокументы.ВидПодтверждающегоДокумента,
		|	ПодтверждающиеДокументы.Номер,
		|	ПодтверждающиеДокументы.Устаревший
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ВыпискаИзЭлектронногоПаспорта)
		|	И ПодтверждающиеДокументы.Номер = &Номер
		|	И ПодтверждающиеДокументы.Устаревший = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Номер", НомерЭПТС);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Если ТЗ.Количество() > 0 Тогда
			ТекДок = ТЗ[0].Ссылка;
		КонецЕсли;
		
	Иначе	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автомобили.Ссылка КАК Авто,
		|	Автомобили.VIN
		|ИЗ
		|	Справочник.Автомобили КАК Автомобили
		|ГДЕ
		|	Автомобили.VIN = &VIN";
		
		Запрос.УстановитьПараметр("VIN",ВИН);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Если ТЗ.Количество() <> 1 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ТекАвто = ТЗ[0].Авто;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Владелец,
		|	ПодтверждающиеДокументы.ВидПодтверждающегоДокумента,
		|	ПодтверждающиеДокументы.Номер,
		|	ПодтверждающиеДокументы.ДатаВыдачи,
		|	ПодтверждающиеДокументы.Ссылка,
		|	ПодтверждающиеДокументы.Комментарий,
		|	ПодтверждающиеДокументы.Устаревший
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.Владелец = &Владелец
		|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ВыпискаИзЭлектронногоПаспорта)
		|	И ПодтверждающиеДокументы.Номер = &Номер
		|	И ПодтверждающиеДокументы.ДатаВыдачи = &ДатаВыдачи
		|	И ПодтверждающиеДокументы.Комментарий ПОДОБНО &Комментарий
		|	И ПодтверждающиеДокументы.Устаревший = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Владелец", ТекАвто);
		Запрос.УстановитьПараметр("ДатаВыдачи", НачалоДня(ДатаПисьма));
		Запрос.УстановитьПараметр("Номер", НомерЭПТС);
		Запрос.УстановитьПараметр("Комментарий", "%%"+ДатаПисьма+"%%");
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Если ТЗ.Количество() = 0 Тогда
			ТекДок = Справочники.ПодтверждающиеДокументы.СоздатьЭлемент();
			ТекДок.Владелец = ТекАвто;
			ТекДок.ВидПодтверждающегоДокумента = Перечисления.ВидыДокументов.ВыпискаИзЭлектронногоПаспорта;
			ТекДок.Дата = ДатаПисьма;
			ТекДок.ДатаВыдачи = ДатаПисьма;
			ТекДок.Номер = НомерЭПТС;
			ТекДок.Наименование = "Выписка из электронного паспорта № "+НомерЭПТС+" выдана "+Формат(ДатаПисьма,"ДЛФ=D");
			ТекДок.Комментарий  = ДатаПисьма;
			Попытка
				ТекДок.Записать();
			Исключение
				Возврат Ложь;
			КонецПопытки;
		Иначе	
			ТекДок = ТЗ[0].Ссылка;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если обЗначениеНеЗаполнено(ТекДок)  Тогда
 		Возврат Ложь;
 	КонецЕсли; 
	
  	Попытка
		рфСохранитьФайлНаДиске(Файл,""+КаталогВременныхФайлов()+ИмяФайла, , "ДА");
 	Исключение
 		Возврат Ложь;
 	КонецПопытки; 
 	
 	
  	ТекОб = ТекДок;
	ПолноеИмяФайла = ""+КаталогВременныхФайлов()+ИмяФайла;
	
	ПользовательскоеИмяФайла = Сред(ИмяФайла,1,СтрДлина(ИмяФайла)-4);
		
 	БылиОшибки=Ложь;
	
	АдресВХранилище = "ОШИБКА";
	
	Попытка
 		АдресВХранилище = ЗаписатьНовуюКартинку(ПользовательскоеИмяФайла,ПолноеИмяФайла,ТекОб);
 	Исключение
 		Возврат Ложь;
	КонецПопытки;
 
	Возврат Истина;
 
КонецФункции // ОбработатьТекПисьмо(ВИН,ДатаПисьма,НомерЭПТС,ИмяФайла,Файл);

 Функция ЗаписатьНовуюКартинку(Название,ТекИФ,ТекОб) Экспорт
	
	ОтносительныйПутьСошибкой = "Ошибочный путь";
	
	ДатаСнимка = ТекущаяДата(); 
 	
	КаталогВременныхФайлов = ТекИФ;
	МояКартинка  = Новый ХранилищеЗначения(Новый ДвоичныеДанные(КаталогВременныхФайлов));
	
	МояКартинка =    МояКартинка;
	
	ПарамКаталога = Новый Массив;

	НаименБезСпецСимволов = УбратьЗапрещенные(Название);
 	
	ТекРасширение = "."+Врег(рфПолучитьРасширениеФайла(ТекИФ));
	
  	ПарамКаталога.Добавить(НаименБезСпецСимволов+"-"+СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(Формат(ДатаСнимка,"ДЛФ=DT")),":","_"),".","_")," ","_")+ТекРасширение);
	ПарамКаталога.Добавить(ТекОб);
	ПарамКаталога.Добавить("");
	ПарамКаталога.Добавить(ДатаСнимка);
	ПарамКаталога.Добавить("");
	ПарамКаталога.Добавить("");
	ПарамКаталога.Добавить("");
	ПарамКаталога.Добавить("");
	ПарамКаталога.Добавить("");
	ПарамКаталога.Добавить("");
	
  	ОписаниеОшибки = "";                                                                                 
	//Бондаренко++ 20220323
 	//ПолноеИмяФайла = ОбщиеСервер.СкопироватьНаСервер("Файлы",МояКартинка,ТекРасширение,ОписаниеОшибки);
	ПолноеИмяФайла = СМ_ФайловоеХранилище.СкопироватьНаСервер("Файлы",МояКартинка,ТекРасширение,ОписаниеОшибки);
	//Бондаренко++ 20220323
	Если ОписаниеОшибки <> "" Тогда
		//Сообщить(ОписаниеОшибки,СтатусСообщения.ОченьВажное);
	КонецЕсли; 
 	ИмяФайла = ПарамКаталога[0]; 
	
	ПриставкаИБ = Константы.ПрефиксБазы.Получить();
	Идентификатор = ПриставкаИБ+СтрЗаменить(ТекущаяУниверсальнаяДатаВМиллисекундах(),Символы.НПП,"");
	
	ИмяФайлаВстроки  = обРазложитьСтрокуВМассивПодстрок(ПолноеИмяФайла,"\");
 	МаксЗначениеИндекса = ИмяФайлаВстроки.Количество()-1;
	
	Попытка
		Идентификатор = СокрЛП(ВРЕГ(ИмяФайлаВстроки[МаксЗначениеИндекса]));
		Идентификатор = СтрЗаменить(Идентификатор,ТекРасширение,"");
	Исключение
		//
	КонецПопытки;
 	
	РазмерФайла =  ПарамКаталога[4];
	ДатаСохранения = ДатаСнимка;
	НазваниеФайла = ПарамКаталога[1];
	Картинка = ПарамКаталога[7];
	
	Если ТекРасширение = ".BMP"  Или
		 ТекРасширение = ".DIB"  Или
		 ТекРасширение = ".RLE"  Или
		 ТекРасширение = ".JPG"  Или
		 ТекРасширение = ".JPEG" Или
		 ТекРасширение = ".TIF"  Или
		 ТекРасширение = ".GIF"  Или
		 ТекРасширение = ".PNG"  Или
		 ТекРасширение = ".ICO"  Или
		 ТекРасширение = ".WMF"  Или
		 ТекРасширение = ".RMF"  Тогда
		ЭтоКартинка = Истина;
	Иначе	
		ЭтоКартинка = Ложь;
	КонецЕсли;	
	
  	ИмяФайла = ПолноеИмяФайла;
 	ОтносительныйПуть = СтрЗаменить(ПолноеИмяФайла,Константы.ПустьКХранилищюСканов.Получить()+"\"+СокрЛП(ОбщиеСервер.ПолучитьИмяИБ())+"\","");
  	Расширение =  ТекРасширение;
 	
	НаборКФ = РегистрыСведений.КартинкиИФайлы.СоздатьНаборЗаписей();
	НаборКФ.Отбор.Объект.Установить(ТекОб.Ссылка);
	НаборКФ.Отбор.Идентификатор.Установить(Идентификатор);
	
	НаборКФ.Прочитать();
	
	НовыйКФ = НаборКФ.Добавить();
	НовыйКФ.Объект =  ТекОб.Ссылка;
	НовыйКФ.Идентификатор = Идентификатор;
	
	НовыйКФ.ИмяФайла = СтрЗаменить(ИмяФайла,"""","");
	НовыйКФ.ДатаСохранения = ДатаСохранения;
	НовыйКФ.РазмерФайла = РазмерФайла;
	НовыйКФ.Комментарий = "Загружена автоматически "+ТекущаяДата();
	НовыйКФ.Картинка = ЭтоКартинка;
	НовыйКФ.НазваниеФайла = СтрЗаменить(НаименБезСпецСимволов,"""","");
	НовыйКФ.ОтносительныйПуть = ОтносительныйПуть;
	НовыйКФ.Расширение = Расширение;
	Если ТипЗнч(ТекОб) = Тип("СправочникСсылка.Сотрудники") Тогда
   		НовыйКФ.Основной = Истина;
		НовыйКФ.Данные = МояКартинка;
		НовыйКФ.ДанныеВоВнешнемФайле = Ложь;
    Иначе
	   НовыйКФ.Основной = Ложь;
	   НовыйКФ.Данные = "";
	   НовыйКФ.ДанныеВоВнешнемФайле = Истина;
   КонецЕсли;
   
   НовыйКФ.Отметка = Ложь;
   
   Попытка
   		НаборКФ.Записать();
   Исключение
   	    Возврат ОтносительныйПутьСошибкой;
   КонецПопытки; 
    
   Возврат ОтносительныйПуть;
	
КонецФункции
 
Функция УбратьЗапрещенные(Название) Экспорт

	НазваниеОтПользователя = Строка(Название);
	НаименБезСпецСимволов = СтрЗаменить(НазваниеОтПользователя,"""","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"/","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"\","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"~","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"`","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"!","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"@","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"#","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"№","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,";","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"$","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"%","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"^","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"&","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"*","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"(","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,")","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"_","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"+","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"|","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"{+","");
	НазваниеОтПользователя = СтрЗаменить(НазваниеОтПользователя,"}","");
