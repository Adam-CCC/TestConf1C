Функция ПоказатьВремТаб(МенеджерВремТаб,ИмяВремтаб ="",Порядок = "") Экспорт

Запрос = Новый Запрос;
Запрос.МенеджерВременныхТаблиц = МенеджерВремТаб;
Запрос.Текст =
"ВЫБРАТЬ
| *
|ИЗ
| ВремТаб КАК ВремТаб
|
|УПОРЯДОЧИТЬ ПО Порядок";

Запрос.Текст = СтрЗаменить(Запрос.Текст,"ВремТаб",ИмяВремтаб); 
Если Порядок = "" тогда 
    Запрос.Текст = СтрЗаменить(Запрос.Текст,"УПОРЯДОЧИТЬ ПО Порядок","");
Иначе 
    Запрос.Текст = СтрЗаменить(Запрос.Текст,"Порядок",Порядок);
КонецЕсли; 

ТЗ = Запрос.Выполнить().Выгрузить(); 

Возврат ТЗ; 

КонецФункции

Функция ВыполнитьЗапрос(НуженРезультат, Текст, МенеджерВременныхТаблиц = Неопределено, VINАвтомобиля = "", МассивСкладовДилера, BIR_Distri, ПоказыватьЗарезервированные, ПоказыватьЗакрепленныеЗаКлиентом, ПоказыватьВыданныеАвтомобили, ПоказыватьНеДляПродажи, МодельАвтомобиля = "", ВерсияАвтомобиля = "", ЦветАвтомобиля = "", ПоказыватьДоговоры = Истина, ДоговорНаАвансСсылка = Неопределено, ДатаНеПоказыватьВыданныеАвтомобили = Неопределено, РежимПодтверждения = Ложь, СтруктураОтбора = Неопределено)
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ТекущаяДата",		 				ТекущаяДата());
	Запрос.УстановитьПараметр("VIN", 				 				VINАвтомобиля);
	Запрос.УстановитьПараметр("МассивСкладовДилера", 				МассивСкладовДилера);
	Запрос.УстановитьПараметр("BIR", 								CRM_Сервер.РазложитьСтрокуВМассивПодстрок(BIR_Distri, ","));
	Запрос.УстановитьПараметр("ТекущийСотрудник", 					ПараметрыСеанса.Пользователь.Сотрудник);
	Запрос.УстановитьПараметр("РежимПодтверждения", 				РежимПодтверждения);
	Запрос.УстановитьПараметр("ДатаНеПоказыватьВыданныеАвтомобили", ?(ДатаНеПоказыватьВыданныеАвтомобили = Неопределено,Дата('00010101'),ДатаНеПоказыватьВыданныеАвтомобили));
	Запрос.УстановитьПараметр("УчитыватьРеализацииКакВыдачи", 		Не Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.Автосклад_НеУчитыватьРеализацииКакВыдачи);
	Запрос.УстановитьПараметр("ИспользоватьТиповойДО",		 		 Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьТиповойУчетДО);
	
	ТипПрисоединенияИзНоменклатурыИРабот = Ложь;	
	Если ЗначениеЗаполнено(ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр) Тогда
		Если ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.ТипПривязкиДоповКАвтомобилям = Перечисления.Renault_ТипыУчетаДополнительногоОборудования.ИзНоменклатурыИРабот Тогда
			ТипПрисоединенияИзНоменклатурыИРабот = Истина;
	    КонецЕсли;
	КонецЕсли;
    Запрос.УстановитьПараметр("ТипПрисоединенияИзНоменклатурыИРабот",ТипПрисоединенияИзНоменклатурыИРабот);	
		
	СтруктураОтбора = ?(СтруктураОтбора = Неопределено, Renault_РаботаСПравамиПользователя.ПолучитьСтруктуруНастроекАвтосклад(), СтруктураОтбора);
	Для Каждого Эл Из СтруктураОтбора Цикл Запрос.УстановитьПараметр(Эл.Ключ, Эл.Значение) КонецЦикла;
	
	Если ЗначениеЗаполнено(МодельАвтомобиля) Тогда
		Запрос.УстановитьПараметр("Модель", МодельАвтомобиля);
	Иначе
		Запрос.УстановитьПараметр("Модель", Справочники.Модели.ПустаяСсылка());
	КонецЕсли;
	
	// начало добавление Зеленчук
	ВерсияАвтомобиляМассив = ТипЗнч(ВерсияАвтомобиля) = Тип("Массив");
	// окончание добавление Зеленчук

	Если ТипЗнч(ВерсияАвтомобиля) = Тип("Массив") Тогда
		Запрос.УстановитьПараметр("Версия", ВерсияАвтомобиля);
	Иначе
		Если
			ЗначениеЗаполнено(ВерсияАвтомобиля) Тогда
			Запрос.УстановитьПараметр("Версия", ВерсияАвтомобиля);
		Иначе
			Запрос.УстановитьПараметр("Версия", Справочники.ВариантыКомплектации.ПустаяСсылка());
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЦветАвтомобиля) Тогда
		Запрос.УстановитьПараметр("Цвет", ЦветАвтомобиля);
	Иначе
		Запрос.УстановитьПараметр("Цвет", Справочники.Цвета.ПустаяСсылка());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДоговорНаАвансСсылка) И Не ЗначениеЗаполнено(VINАвтомобиля) Тогда
		Запрос.УстановитьПараметр("ДоговорНаАвансСсылка", ДоговорНаАвансСсылка);
	Иначе
		Запрос.УстановитьПараметр("ДоговорНаАвансСсылка", Документы.Renault_Договор.ПустаяСсылка());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПоказыватьЗарезервированные", 	  ПоказыватьЗарезервированные);
	Запрос.УстановитьПараметр("ПоказыватьЗакрепленныеЗаКлиентом", ПоказыватьЗакрепленныеЗаКлиентом);
	Запрос.УстановитьПараметр("ПоказыватьВыданныеАвтомобили", 	  ПоказыватьВыданныеАвтомобили);
	Запрос.УстановитьПараметр("ПоказыватьНеДляПродажи", 		  ПоказыватьНеДляПродажи);
	Запрос.УстановитьПараметр("ПоказыватьДоговоры", 			  ПоказыватьДоговоры);
	
	Запрос.Текст = Текст;
	
	Результат = Запрос.Выполнить();
	
