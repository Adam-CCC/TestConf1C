		Отказ = Истина;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИсточникДанных) Тогда
		 ИсточникДанных = Перечисления.Renault_ИсточникДанныхЗаявкиНаКорпоративнуюСкидку.Дилер;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка",ДокументСсылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.НомерСтроки,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ВИН,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Автомобиль КАК Автомобиль,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ПроцентСкидки,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ЦенаPVC,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ЦенаFlotte,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.СуммаСкидки,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.МаржаПроцент,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.МаржаСумма,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.УчастиеДилера,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.МаржаПроцентRenault,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.УчастиеRenault,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ЦенаФактура,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ЦенаPVR,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ПроцентДилера,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.ПроцентРено,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.МаржаДилераПроцент,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.Клиент,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.ТипЗаявки,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.Статус,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.Автор,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.Кузовостроитель,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.ЛизинговаяКомпания,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.Адрес,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.ДатаОтправки,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.ТипОтгрузки,
		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка.Дата
		|ИЗ
		|	Документ.Renault_ЗаявкаНаКорпоративнуюСкидку.ТаблицаВИН КАК Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН
