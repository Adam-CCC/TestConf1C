		|	Renault_ЗаявкаНаКорпоративнуюСкидкуТаблицаВИН.Ссылка = &ДокументСсылка";
		
	ТаблицаVIN = Запрос.Выполнить().Выгрузить();
		
	НаборЗаписи = РегистрыСведений.Renault_ЗаявкиНаКорпоративнуюСкидку.СоздатьНаборЗаписей();   
			
	НаборЗаписи.Отбор.Заявка.Установить(ДокументСсылка);
	НаборЗаписи.Отбор.ИсточникДанных.Установить(ИсточникДанных);
		
	Для Каждого СтрокаТаб из ТаблицаVIN Цикл
		СтрокаНабора = НаборЗаписи.Добавить();
		СтрокаНабора.Заявка = ДокументСсылка;
		СтрокаНабора.ИсточникДанных = ИсточникДанных;
		ЗаполнитьЗначенияСвойств(СтрокаНабора,СтрокаТаб);
	КонецЦикла;
		
	НаборЗаписи.Записать();	
		
КонецПроцедуры

Процедура ПересчитатьСтоимостьАвтомобиляПоДопам(ЗаявкаНаСервис) Экспорт
	
	Менеджер = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
	Менеджер.VIN = ЗаявкаНаСервис.VIN;
	Менеджер.Прочитать();
	Если Менеджер.Выбран() Тогда
		
		СтруктураДанных = ПолучитьСтоимостьНоменклатурыИРаботДополнительногоОборудования(ЗаявкаНаСервис.Автомобиль, ЗаявкаНаСервис.ДилерскийЦентр);
		Менеджер.ЦенаПродажиАвтомобиля = Менеджер.ЦенаКлиентская+СтруктураДанных.СуммаДопОборудование+СтруктураДанных.СуммаРабот;
		Менеджер.Записать();
	
	КонецЕсли;

КонецПроцедуры

Процедура Renault_ИсторияСостоянияОбъектовПриЗаписи(Источник, Отказ) Экспорт
     	
	Если Источник.ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Запрос = Новый Запрос("Выбрать Первые 1 Период,Состояние Из РегистрСведений.Renault_ИсторияСостоянияОбъектов ГДЕ Объект=&Объект Упорядочить По Период Убыв");
	Запрос.УстановитьПараметр("Объект", Источник.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Состояние = Источник.Состояние Тогда Возврат КонецЕсли;
		//предыдущее состояние - устанавливаем длительность
		Рег = РегистрыСведений.Renault_ИсторияСостоянияОбъектов.СоздатьМенеджерЗаписи();
		Рег.Период = Выборка.Период;
		Рег.Объект = Источник.Ссылка;
		Рег.Состояние = Выборка.Состояние;
		Рег.Прочитать();
		Рег.Длительность = ТекущаяДата()-Выборка.Период;
		Рег.Период = Выборка.Период;
		Рег.Объект = Источник.Ссылка;
		Рег.Состояние = Выборка.Состояние;
		Рег.Записать(Истина);
	КонецЕсли;
	
	//новое состояние - пока без длительности
	Если Не Источник.Состояние.Пустая() Тогда
		Рег = РегистрыСведений.Renault_ИсторияСостоянияОбъектов.СоздатьМенеджерЗаписи();
		Рег.Период = ТекущаяДата();
		Рег.Объект = Источник.Ссылка;
		Рег.Состояние = Источник.Состояние;
		Рег.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтоимостьНоменклатурыИРаботДополнительногоОборудования(Автомобиль, ДилерскийЦентр) Экспорт
	
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьТиповойУчетДО Тогда			
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СУММА(ЗаказНаряд.СуммаНоменклатурыДокумента) КАК СуммаДопОборудование,
		               |	СУММА(ЗаказНаряд.СуммаРаботДокумента) КАК СуммаРабот,
		               |	ЗаказНаряд.Автомобиль КАК Автомобиль
		               |ИЗ
		               |	Документ.ЗаказНаряд КАК ЗаказНаряд
		               |ГДЕ
		               |	ЗаказНаряд.Автомобиль = &Автомобиль
		               |	И ЗаказНаряд.ВидРемонта = &ВидРемонта
		               |	И ЗаказНаряд.Состояние В (&Состояние)
		               |	И НЕ ЗаказНаряд.ПометкаУдаления
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ЗаказНаряд.Автомобиль";
	Иначе			
		Запрос = Новый Запрос;        
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(Renault_CRM_ЗаявкаНаСервис.СуммаРаботВсего) КАК СуммаРабот,
		|	СУММА(Renault_CRM_ЗаявкаНаСервис.СуммаЗапчастиВсего) КАК СуммаДопОборудование,
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль КАК Автомобиль
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль = &Автомобиль
		|	И Renault_CRM_ЗаявкаНаСервис.СтатусПодготовкиКПродаже = Значение(Перечисление.Renault_СтатусыЗаявкиНаПрепродажнуюПодготовку.Выполнена)
		|	И Renault_CRM_ЗаявкаНаСервис.ВидРемонта = &ВидРемонта
		|	И Renault_CRM_ЗаявкаНаСервис.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	Renault_CRM_ЗаявкаНаСервис.Автомобиль";
	КонецЕсли;

	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ВидРемонта", Справочники.ВидыРемонта.КомплектацияАвтомобиля);
	Состояние = Новый СписокЗначений;
	Состояние.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Выполнен);
	Состояние.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	Запрос.УстановитьПараметр("Состояние", Состояние);	

	Если ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		ТипПрисоединения = ДилерскийЦентр.ТипПривязкиДоповКАвтомобилям;
	Иначе
		ТипПрисоединения = Перечисления.Renault_ТипыУчетаДополнительногоОборудования.ТолькоИзНоменклатуры;
	КонецЕсли;
	
	СтруктураДанных = Новый Структура;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		СтруктураДанных.Вставить("СуммаДопОборудование",Выборка.СуммаДопОборудование);
		СтруктураДанных.Вставить("СуммаРабот",?(ТипПрисоединения = Перечисления.Renault_ТипыУчетаДополнительногоОборудования.ИзНоменклатурыИРабот,Выборка.СуммаРабот,0));
	Иначе
		СтруктураДанных.Вставить("СуммаДопОборудование",0);
		СтруктураДанных.Вставить("СуммаРабот",0);
	КонецЕсли;
	
	Возврат СтруктураДанных;

КонецФункции

Функция DMS_ПолучитьОсновнойДоговорКонтрагента(Контрагент) Экспорт
	
	Ответ = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Если Метаданные.Справочники.Контрагенты.Реквизиты.Найти("ОсновнойДоговорВзаиморасчетов") = Неопределено
		И Метаданные.Справочники.ДоговорыВзаиморасчетов.Реквизиты.Найти("Основной") <> Неопределено Тогда // Для новой АА
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыВзаиморасчетов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
		|ГДЕ
		|	ДоговорыВзаиморасчетов.Основной = ИСТИНА
		|	И ДоговорыВзаиморасчетов.Владелец = &Владелец";
		Запрос.УстановитьПараметр("Владелец", Контрагент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ответ = Выборка.Ссылка;
		КонецЕсли;
	ИначеЕсли Метаданные.Справочники.Контрагенты.Реквизиты.Найти("ОсновнойДоговорВзаиморасчетов") <> Неопределено Тогда// Для старой АА
		Ответ = Контрагент.ОсновнойДоговорВзаиморасчетов;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

#Область ПроверкаПовторнойВыдачиАвтомобилей

Функция ПолучитьТаблицуВыданныхАвтомобилей(IDK, МассивVIN, ПроверятьЗапланировано) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_СобытияПоРабочимЛистам.Ссылка,
	|	CRM_СобытияПоРабочимЛистам.IDK,
	|	CRM_СобытияПоРабочимЛистам.Объект.VIN КАК VIN,
	|	CRM_СобытияПоРабочимЛистам.Объект.Статус КАК Статус,
	|	CRM_СобытияПоРабочимЛистам.Дата
	|ИЗ
	|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	|ГДЕ
	|	CRM_СобытияПоРабочимЛистам.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.Выдача)
	|	И CRM_СобытияПоРабочимЛистам.Объект.Статус В(&МассивСтатусов)
	|	И CRM_СобытияПоРабочимЛистам.IDK = &IDK
	|	И CRM_СобытияПоРабочимЛистам.Объект.VIN В(&МассивVIN)
	|	И CRM_СобытияПоРабочимЛистам.КомментарийЗакрытия <> ""Выдача отменена""";
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан);
	Если ПроверятьЗапланировано Тогда
		МассивСтатусов.Добавить(Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик);
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("IDK", IDK);
	Запрос.УстановитьПараметр("МассивVIN", МассивVIN);
	Запрос.УстановитьПараметр("МассивСтатусов", МассивСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьВыданныеАвтомобили(IDK, МассивVIN, ПроверятьЗапланировано = Ложь, ТекстСообщения = "") Экспорт

	Результат = Ложь;
	
	ТаблицаВыданныхАвтомобилей = ПолучитьТаблицуВыданныхАвтомобилей(IDK, МассивVIN, ПроверятьЗапланировано);
	
	Если ТаблицаВыданныхАвтомобилей.Количество() > 0 Тогда
		Результат = Истина;
		
		МассивСообщений = Новый Массив;
		Для каждого СтрокаТаблицы Из ТаблицаВыданныхАвтомобилей Цикл
			ЭлементСообщения = "VIN: " + СтрокаТаблицы.VIN + "   |   Статус: " + СтрокаТаблицы.Статус + "   |   Дата: " + СтрокаТаблицы.Дата;
			МассивСообщений.Добавить(ЭлементСообщения);
		КонецЦикла; 
		ТекстСообщения = СтрСоединить(МассивСообщений, Символы.ПС);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ЕстьВыданныеАвтомобили(IDK, МассивVIN)

Функция ПолучитьАктуальноеСобытиеВыдачи (СсылкаНаВыдачу = Неопределено) Экспорт
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Результат = Неопределено;
	Если СсылкаНаВыдачу = Неопределено Тогда
		Возврат (Результат);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_СобытияПоРабочимЛистам.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|ГДЕ
		|	CRM_СобытияПоРабочимЛистам.Объект = &Объект
		|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
		|	И CRM_СобытияПоРабочимЛистам.ДатаНапоминания = &Дата";
	
	Запрос.УстановитьПараметр("Объект", СсылкаНаВыдачу);
	Запрос.УстановитьПараметр("Дата", СсылкаНаВыдачу.ДатаНачала);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	 
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
    Возврат(Результат);
	
КонецФункции

#КонецОбласти	// ПроверкаПовторнойВыдачиАвтомобилей