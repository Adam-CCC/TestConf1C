	ДокОбращение.Примечание = ЗаявкаОбъект.Примечание;
	Если ЗначениеЗаполнено(ЗаявкаОбъект.ДоговорНаПродажуАвтомобиля) Тогда
		ДокОбращение.IDK = ЗаявкаОбъект.ДоговорНаПродажуАвтомобиля.РабочийЛист;
	КонецЕсли;
	ДокОбращение.Внутренний = ИСТИНА;
	ДокОбращение.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный;
	ДокОбращение.ПроверенВICM = ИСТИНА;
	ДокОбращение.ВидОбращения = ЗаявкаОбъект.ВидОбращения;
	ДокОбращение.Автомобиль = ЗаявкаОбъект.Автомобиль;
	ДокОбращение.Клиент = ЗаявкаОбъект.Клиент;
	ДокОбращение.Жалоба = Ложь;
	ДокОбращение.ОбращениеОбработано = ЛОЖЬ;
	ДокОбращение.Записать();
	
	Возврат ДокОбращение.Ссылка;
	
