Процедура DMS_CRM_ЗаписьНаВыдачуПередЗаписьюПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	//Формирование оповещений о назначенных этапах выдачи автомобиля     	
	Если Источник.ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.ДилерскийЦентр) Тогда
		Отказ = Истина;
		Сообщить("Не заполнен дилерский центр");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Источник.ДилерскийЦентр.НастройкаЭтаповВыдачи) Тогда
		Отказ = Истина;
		Сообщить("Не настроены этапы выдачи дилерского центра");
		Возврат;
	КонецЕсли;
	
	
	Если Источник.ЭтоНовый() тогда
		СсылкаНового = Документы.CRM_ЗаписьНаВыдачу.ПолучитьСсылку(Новый УникальныйИдентификатор);
		Источник.УстановитьСсылкуНового(СсылкаНового);
		УИД = Строка(СсылкаНового.УникальныйИдентификатор());
	Иначе
		УИД = Строка(Источник.Ссылка.УникальныйИдентификатор());
	КонецЕсли;	
	//при смене статуса на "Запланирован"
	Если Источник.Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик
		И Источник.Ссылка.Статус <> Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик Тогда
		
		
		//соберем запланированные этапы, относящиеся к заявке
		
		ЭтапыВыдачи = Новый ТаблицаЗначений;
		ЭтапыВыдачи.Колонки.Добавить("Этап",Новый ОписаниеТипов("СправочникСсылка.Renault_ЭтапыВыдачи"));
		
		Если ЗначениеЗаполнено(Источник.ДоговорНаПродажуАвтомобиля) тогда
			Договор = Источник.ДоговорНаПродажуАвтомобиля;
		иначе
			Договор = Документы.Renault_Договор.ПустаяСсылка();
		КонецЕсли;
		
		Для каждого стрЭтап из Источник.ДилерскийЦентр.НастройкаЭтаповВыдачи.Этапы цикл
			Этап = стрЭтап.Этап;
			Для Каждого СтрДог из Договор.СоставДоговора Цикл
				Если (Этап.ПокупкаВТрейдИн = Истина и СтрДог.ПокупкаВТрейдИн = Ложь)
					ИЛИ (Этап.ПокупкаВКредит = Истина и СтрДог.ПокупкаВКредит = Ложь)
					ИЛИ (Этап.ПокупкаПоУтилизации = Истина и СтрДог.ПокупкаПоУтилизации = Ложь) Тогда
					Продолжить;
				КонецЕсли;
				Если Этап.ПокупкаПродленнойГарантии = Истина 
					И (Договор = Документы.Renault_Договор.ПустаяСсылка() 
					ИЛИ СтрДог.ПокупкаПродленнойГарантии = Ложь) Тогда
					Продолжить;
				КонецЕсли;
				Если Этап.ПокупкаСтраховки = Истина 
					И (Договор = Документы.Renault_Договор.ПустаяСсылка()  
					ИЛИ СтрДог.ПокупкаСтраховки = Ложь) Тогда
					Продолжить;
				КонецЕсли;
				НовЭтап = ЭтапыВыдачи.Добавить();
				НовЭтап.Этап = Этап;
			КонецЦикла;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаЭтапов.Этап
		|ПОМЕСТИТЬ ТаблицаЭтапов
		|ИЗ
		|	&ТаблицаЭтапов КАК ТаблицаЭтапов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Renault_ПраваИНастройкиПользователейПродажи_ЭтапыВыдачи.Этап КАК Этап,
		|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки,
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь,
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник КАК Сотрудник
		|ИЗ
		|	Справочник.Renault_ПраваИНастройкиПользователей.Продажи_ЭтапыВыдачи КАК Renault_ПраваИНастройкиПользователейПродажи_ЭтапыВыдачи
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|		ПО Renault_ПраваИНастройкиПользователейПродажи_ЭтапыВыдачи.Ссылка = Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки
		|ГДЕ
		|	Renault_ПраваИНастройкиПользователейПродажи_ЭтапыВыдачи.Этап В
		|			(ВЫБРАТЬ
		|				ТЗ.Этап
		|			ИЗ
		|				ТаблицаЭтапов КАК ТЗ)
		|	И Renault_ПраваИНастройкиПользователейПродажи_ЭтапыВыдачи.Ссылка.Продажи_ВсеЭтапыВыдачи = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТаблицаЭтапов.Этап,
		|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки,
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь,
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПраваИНастройкиПользователей КАК Renault_ПраваИНастройкиПользователей
		|		ПО Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки = Renault_ПраваИНастройкиПользователей.Ссылка,
		|	ТаблицаЭтапов КАК ТаблицаЭтапов
		|ГДЕ
		|	Renault_ПраваИНастройкиПользователей.Продажи_ВсеЭтапыВыдачи = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	Этап";
		Запрос.УстановитьПараметр("ТаблицаЭтапов",ЭтапыВыдачи);	
		Выборка = Запрос.Выполнить().Выбрать();
		
		
		ДатаСобытия = ТекущаяДата();
		ДатаСобытияРег = ТекущаяДата();
		Пока Выборка.Следующий() Цикл
			
			//формируются оповещения о запланированных этапах выдачи авто
			ДатаСобытияРег = ДатаСобытияРег + 1;
			Набор = РегистрыСведений.Renault_СообщенияСотрудникам.СоздатьНаборЗаписей();
			Набор.Отбор.УИД.Установить(УИД);
			Набор.Отбор.ВидСообщения.Установить(Справочники.Renault_ВидСообщения.НазначениеЭтапаВыдачиАвто);
			Набор.Отбор.Получатель.Установить(Выборка.Пользователь);
			Набор.Отбор.ДатаСобытия.Установить(ДатаСобытияРег);
			
			Запись = Набор.Добавить();
			Запись.УИД = УИД;
			Запись.ВидСообщения = Справочники.Renault_ВидСообщения.НазначениеЭтапаВыдачиАвто;
			Запись.Получатель = Выборка.Пользователь;
			Запись.ДатаСобытия = ДатаСобытияРег;
			Запись.ТекстСообщения = ""+Выборка.Этап;
			Запись.ВыполнитьОдному = Истина;
			Набор.Записать();
			
			Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			Напоминание.Отправитель = "Система";
			Напоминание.Адресаты.Добавить().Сотрудник = Выборка.Сотрудник;
			Напоминание.ДатаОтправки = ДатаСобытия;
			Напоминание.Комментарий = ""+Выборка.Этап;
			Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.НазначениеЭтапаВыдачиАвто;
			Напоминание.ПоказыватьС = ДатаСобытия;
			Напоминание.ПоказыватьПо = ДатаСобытия+900;
			Напоминание.Наименование = "Назначение этапа выдачи";
			Напоминание.Сообщение = "Вам назначен этап выдачи авто: " +Выборка.Этап;
			Напоминание.ИдентификаторОбъекта = УИД;
			Напоминание.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Renault_ПриЗаписиАвтомобиляПриЗаписи(Источник, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.SEDRE_ORDER
		|ИЗ
		|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
		|ГДЕ
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN = &VIN";
		
	Запрос.УстановитьПараметр("VIN", Источник.VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.SEDRE_ORDER) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗапросДистри = Новый Запрос;
		ЗапросДистри.Текст = 
			"ВЫБРАТЬ
			|	Renault_ИнформацияПоЗаявкамDistri.Автомобиль,
			|	Renault_ИнформацияПоЗаявкамDistri.ИдентификаторСтрокиДоговора,
			|	Renault_ИнформацияПоЗаявкамDistri.НомерКлиентскойЗаявки,
			|	Renault_ИнформацияПоЗаявкамDistri.ПродажаВнесена,
			|	Renault_ИнформацияПоЗаявкамDistri.НомерОрдера,
			|	Renault_ИнформацияПоЗаявкамDistri.Заявка
			|ИЗ
			|	РегистрСведений.Renault_ИнформацияПоЗаявкамDistri КАК Renault_ИнформацияПоЗаявкамDistri
			|ГДЕ
			|	Renault_ИнформацияПоЗаявкамDistri.НомерОрдера = &НомерОрдера";
			
		ЗапросДистри.УстановитьПараметр("НомерОрдера", Выборка.SEDRE_ORDER);
		ВыборкаДистри = ЗапросДистри.Выполнить().Выбрать();
		Пока ВыборкаДистри.Следующий() Цикл
			МенеджерРегистра = РегистрыСведений.Renault_ИнформацияПоЗаявкамDistri.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерРегистра, ВыборкаДистри);
			МенеджерРегистра.Автомобиль = Источник.Ссылка;
			МенеджерРегистра.Записать();
		КонецЦикла;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ДоговорСоставДоговора.Идентификатор
		|ИЗ
		|	Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
		|ГДЕ
		|	Renault_ДоговорСоставДоговора.Автомобиль = &Автомобиль";
	Запрос.УстановитьПараметр("Автомобиль", Источник.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗапросДистри = Новый Запрос;
		ЗапросДистри.Текст = 
			"ВЫБРАТЬ
			|	Renault_ИнформацияПоЗаявкамDistri.Автомобиль,
			|	Renault_ИнформацияПоЗаявкамDistri.ИдентификаторСтрокиДоговора,
			|	Renault_ИнформацияПоЗаявкамDistri.НомерКлиентскойЗаявки,
			|	Renault_ИнформацияПоЗаявкамDistri.ПродажаВнесена,
			|	Renault_ИнформацияПоЗаявкамDistri.НомерОрдера,
			|	Renault_ИнформацияПоЗаявкамDistri.Заявка
			|ИЗ
			|	РегистрСведений.Renault_ИнформацияПоЗаявкамDistri КАК Renault_ИнформацияПоЗаявкамDistri
			|ГДЕ
			|	Renault_ИнформацияПоЗаявкамDistri.ИдентификаторСтрокиДоговора = &ИдентификаторСтрокиДоговора";
			
		ЗапросДистри.УстановитьПараметр("ИдентификаторСтрокиДоговора", Выборка.Идентификатор);
		ВыборкаДистри = ЗапросДистри.Выполнить().Выбрать();
		Пока ВыборкаДистри.Следующий() Цикл
			МенеджерРегистра = РегистрыСведений.Renault_ИнформацияПоЗаявкамDistri.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МенеджерРегистра, ВыборкаДистри);
			МенеджерРегистра.Автомобиль = Источник.Ссылка;
			МенеджерРегистра.Записать();
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

