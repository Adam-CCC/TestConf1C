Процедура РазбитьФИО(Знач ФИО, Фамилия, Имя, Отчество) Экспорт
	
	ФИО = СокрЛП(ФИО);
	Если СтрДлина(ФИО) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//Фамилия
	ПозицияПробела = Найти(ФИО, " ");
	Фамилия = СокрЛП(Лев(ФИО, ПозицияПробела));
	ФИО = СокрЛП(Сред(ФИО, ПозицияПробела));
	
	//Имя, Отчество
	ПозицияПробела = Найти(ФИО, " ");
	Имя = СокрЛП(Лев(ФИО, ПозицияПробела));
	Отчество = СокрЛП(Сред(ФИО, ПозицияПробела));
	
КонецПроцедуры

Процедура Renault_CRM_ЗаписьКонтактнойИнформацииПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Renault_CRM_ЗаписьКонтактнойИнформацииПриУдалении(Источник, Отказ, Замещение);
	
КонецПроцедуры

Процедура Renault_CRM_ЗаписьКонтактнойИнформацииПриУдалении(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление КАК Телефон,
	|	КонтактнаяИнформация.Объект КАК Клиент,
	|	КонтактнаяИнформация.Тип
	|ПОМЕСТИТЬ Телефоны
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтактнаяИнформация.Объект = &Клиент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление КАК Емаил,
	|	КонтактнаяИнформация.Объект КАК Клиент,
	|	КонтактнаяИнформация.Тип
	|ПОМЕСТИТЬ Емаилы
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтактнаяИнформация.Объект = &Клиент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_РабочиеЛисты.IDK,
	|	Renault_РабочиеЛисты.Клиент,
	|	ВЫБОР
	|		КОГДА Емаилы.Емаил ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Емаил,
	|	ВЫБОР
	|		КОГДА Телефоны.Телефон ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Телефон,
	|	ВЫБОР
	|		КОГДА Емаилы.Емаил ЕСТЬ NULL 
	|				И Телефоны.Телефон ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Контакты
	|ПОМЕСТИТЬ РабочиеЛисты
	|ИЗ
	// Трояновский К.Е. 15.08.2019 16:31:10 {	
	//|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
	// Трояновский К.Е. 15.08.2019 16:31:10 }
	|		ЛЕВОЕ СОЕДИНЕНИЕ Емаилы КАК Емаилы
	|		ПО Renault_РабочиеЛисты.Клиент = Емаилы.Клиент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Телефоны КАК Телефоны
	|		ПО Renault_РабочиеЛисты.Клиент = Телефоны.Клиент
	|ГДЕ
	|	Renault_РабочиеЛисты.Клиент = &Клиент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочиеЛисты.IDK,
	|	CRM_ВоронкаПродаж.ДатаВыполнения
	|ПОМЕСТИТЬ ВоронкаТелефон
	|ИЗ
	|	РабочиеЛисты КАК РабочиеЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
	|		ПО РабочиеЛисты.IDK = CRM_ВоронкаПродаж.IDK
	|ГДЕ
	|	CRM_ВоронкаПродаж.ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.НаличиеТелефона)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочиеЛисты.IDK,
	|	CRM_ВоронкаПродаж.ДатаВыполнения
	|ПОМЕСТИТЬ ВоронкаЕмаил
	|ИЗ
	|	РабочиеЛисты КАК РабочиеЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
	|		ПО РабочиеЛисты.IDK = CRM_ВоронкаПродаж.IDK
	|ГДЕ
	|	CRM_ВоронкаПродаж.ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.НаличиеEmail)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочиеЛисты.IDK,
	|	CRM_ВоронкаПродаж.ДатаВыполнения
	|ПОМЕСТИТЬ ВоронкаКонтакты
	|ИЗ
	|	РабочиеЛисты КАК РабочиеЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
	|		ПО РабочиеЛисты.IDK = CRM_ВоронкаПродаж.IDK
	|ГДЕ
	|	CRM_ВоронкаПродаж.ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.НаличиеКонтактов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочиеЛисты.IDK,
	|	ВЫБОР
	|		КОГДА ВоронкаЕмаил.ДатаВыполнения ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьВоронкаЕмаил,
	|	ВЫБОР
	|		КОГДА ВоронкаКонтакты.ДатаВыполнения ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьВоронкаКонтакты,
	|	ВЫБОР
	|		КОГДА ВоронкаТелефон.ДатаВыполнения ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьВоронкаТелефон,
	|	РабочиеЛисты.Емаил,
	|	РабочиеЛисты.Телефон,
	|	РабочиеЛисты.Контакты,
	|	РабочиеЛисты.Клиент
	|ИЗ
	|	РабочиеЛисты КАК РабочиеЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВоронкаЕмаил КАК ВоронкаЕмаил
	|		ПО РабочиеЛисты.IDK = ВоронкаЕмаил.IDK
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВоронкаКонтакты КАК ВоронкаКонтакты
	|		ПО РабочиеЛисты.IDK = ВоронкаКонтакты.IDK
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВоронкаТелефон КАК ВоронкаТелефон
	|		ПО РабочиеЛисты.IDK = ВоронкаТелефон.IDK";
	Запрос.УстановитьПараметр("Клиент",Источник.Отбор.Объект.Значение);
	Результат  = Запрос.Выполнить().Выгрузить();
	Для Каждого РЛ Из Результат Цикл
		Если Не (РЛ.Телефон = РЛ.ЕстьВоронкаТелефон) и Не Рл.Телефон Тогда
			Renault_CRM.Воронка_НаличиеТелефона_Снять(РЛ.IDK, РЛ.Клиент);
			Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.НаличиеТелефона, РЛ.IDK);
		ИначеЕсли Не (РЛ.Телефон = РЛ.ЕстьВоронкаТелефон) и  Рл.Телефон Тогда
			Renault_CRM.Воронка_НаличиеТелефона_Установить(РЛ.IDK, РЛ.Клиент);
			Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеТелефона, РЛ.IDK);
		КонецЕсли;
		
		Если Не (РЛ.Емаил = РЛ.ЕстьВоронкаЕмаил) и Не Рл.Емаил Тогда
			Renault_CRM.Воронка_НаличиеEmail_Снять(РЛ.IDK, РЛ.Клиент);
			Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.НаличиеEmail, РЛ.IDK);
			
		ИначеЕсли Не (РЛ.Емаил = РЛ.ЕстьВоронкаЕмаил) и  Рл.Емаил Тогда
			Renault_CRM.Воронка_НаличиеEmail_Установить(РЛ.IDK, РЛ.Клиент);
			Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеEmail, РЛ.IDK);
			
		КонецЕсли;
		
		Если Не (РЛ.Контакты = РЛ.ЕстьВоронкаКонтакты) и Не Рл.Контакты Тогда
			Renault_CRM.Воронка_НаличиеКонтактов_Снять(РЛ.IDK, РЛ.Клиент);
			Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.НаличиеКонтактов, РЛ.IDK);
			
		ИначеЕсли Не (РЛ.Контакты = РЛ.ЕстьВоронкаКонтакты) и  Рл.Контакты Тогда
			Renault_CRM.Воронка_НаличиеКонтактов_Установить(РЛ.IDK, РЛ.Клиент);
			Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеКонтактов, РЛ.IDK);
			
		КонецЕсли;
		
	КонецЦикла;
	// #Если НаКлиенте Тогда
	// 	Оповестить("ОбновитьВоронкуТелефон");
	//	Оповестить("ОбновитьВоронкуЕмаил");
	//#КонецЕсли
КонецПроцедуры

Функция Renault_CRM_СкорректироватьТелефонПриЗаписи(Телефон) Экспорт
	
	РазрешенныеСимволы = "0123456789+";
	
	рСтрока = "";
	Для Номер=1 по СтрДлина(Телефон) Цикл
		нСимвол = Сред(СокрЛП(Телефон), Номер,1);
		Если Найти(РазрешенныеСимволы, нСимвол) <> 0 Тогда
			рСтрока = рСтрока + нСимвол;
		КонецЕсли;
	КонецЦикла;
	
	Возврат рСтрока;
	
КонецФункции

// Функция "расщепляет" строку на подстроки, используя заданный 
//		разделитель. Разделитель может иметь любую длину. 
//		Если в качестве разделителя задан пробел, рядом стоящие пробелы 
//		считаются одним разделителем, а ведущие и хвостовые пробелы параметра Стр
//		игнорируются.
//		Например, 
//		РазложитьСтрокуВМассивПодстрок(",ку,,,му", ",") возвратит массив значений из пяти элементов, 
//		три из которых - пустые строки, а 
//		РазложитьСтрокуВМассивПодстрок(" ку   му", " ") возвратит массив значений из двух элементов
//
//	Параметры: 
//		Стр - 			строка, которую необходимо разложить на подстроки. 
//						Параметр передается по значению.
//		Разделитель - 	строка-разделитель, по умолчанию - запятая.
//
//
//	Возвращаемое значение:
//		массив значений, элементы которого - подстроки
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Стр, Разделитель = ",") Экспорт
	
	МассивСтрок = Новый Массив();
	Если Разделитель = " " Тогда
		Стр = СокрЛП(Стр);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = СокрЛ(Сред(Стр,Поз));
		КонецЦикла;
	Иначе
		ДлинаРазделителя = СтрДлина(Разделитель);
		Пока 1=1 Цикл
			Поз = Найти(Стр,Разделитель);
			Если Поз=0 Тогда
				МассивСтрок.Добавить(Стр);
				Возврат МассивСтрок;
			КонецЕсли;
			МассивСтрок.Добавить(Лев(Стр,Поз-1));
			Стр = Сред(Стр,Поз+ДлинаРазделителя);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // глРазложить

