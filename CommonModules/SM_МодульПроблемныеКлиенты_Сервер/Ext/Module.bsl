Процедура ЗапуститьФоновоеЗадание(Источник,ПоследниеЗаписи) Экспорт
	Параметры = Новый Массив();
	Параметры.Добавить(Источник.Ссылка);
	Параметры.Добавить(ПоследниеЗаписи);
	ФоновоеЗадание = ФоновыеЗадания.Выполнить("SM_МодульПроблемныеКлиенты_Сервер.СоздатьЗаписиНаСогласованиеИсключений",Параметры,"SM_ПроблемныеДокументы","SM_ПроблемныеДокументы");
КонецПроцедуры 


Процедура SM_ТестСервера() Экспорт
	ДокументЗаказНаряд = Документы.ЗаказНаряд.НайтиПоНомеру("ATТРС04904");
	Объект = ДокументЗаказНаряд.ПолучитьОбъект();
	Объект.Записать(РежимЗаписиДокумента.Проведение);     
КонецПроцедуры   

