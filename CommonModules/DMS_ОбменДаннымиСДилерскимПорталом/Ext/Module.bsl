
//Регламентное задание "Обмен данными с Дилерским порталом"
Процедура ВыполнитьОбменДанными(Параметр1 = Неопределено) Экспорт
	
	 ВыгрузкаЗаявокНаАвтомобили();
	 
	 ЗагрузкаСообщенийОбмена();
	 
	 ЗагрузитьСпрПричинНеВозможностиВыдачи();
	 
	 ЗагрузитьДанныеПлатногоХранения ();
	 
	 РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	 ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ОбменДаннымиСДилерскимПорталом"),
	 ТекущаяДатаСеанса());
КонецПроцедуры
 
Функция ПолучитьПланОбмена()
		
	Выборка = ПланыОбмена.Renault_CRM.Выбрать();
	ЭтаБаза = ПланыОбмена.Renault_CRM.ЭтотУзел();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> ЭтаБаза Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

