//Выгрузка заявок на автомобили в дилерский портал, с последующей отправкой в DistriNet
Процедура ВыгрузкаЗаявокНаАвтомобили() Экспорт
	
	Попытка 
		
		ПланОбмена = ПолучитьПланОбмена();
		
		Если ЗначениеЗаполнено(ПланОбмена) тогда
			ВыполнитьОтправкуЗаявокНаАвтомобили(ПланОбмена);
			ВыполнитьОтправкуЗаявокНаОтгрузку(ПланОбмена);

		Иначе
			Renault_Открытый.СообщитьПользователю("Выгрузка отменена, не удалось определить план обмена",,"Регламентное задание ""Выгрузка заявок на автомобили""");
		КонецЕсли;
		
	Исключение
		
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
		"Регламентное задание ""Выгрузка заявок на Дилерский портал""",
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Инфо));
		ВызватьИсключение;
	КонецПопытки;          
	
КонецПроцедуры

Процедура ВыполнитьОтправкуЗаявокНаАвтомобили(ПланОбмена)
	
	ВебСервис = ПолучитьПрокси();
	Сериализатор = Новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
	
	РезультатВыполнения = Новый Структура();
	Server = СтрокаСоединенияИнформационнойБазы();
	BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	
	//Получим ссылки на все изменения
	ФильтрВыборки = Новый Массив;
	ФильтрВыборки.Добавить(Метаданные.Документы.DMS_ЗаявкаНаАвтомобиль);
	Выборка = ПланыОбмена.ВыбратьИзменения(ПланОбмена, 2, ФильтрВыборки);
	
	//Посчитаем количество изменений
	ОбщееКоличество = 0;
	Пока Выборка.Следующий() Цикл
		ОбщееКоличество = ОбщееКоличество + 1;
	КонецЦикла;
	Выборка.Сбросить();
	
	//Заполним таблицы первоначальной информацией из плана обмена
	Счетчик = 0; ВсегоПередано = 0;
	Пока Выборка.Следующий() Цикл
		
		Если Счетчик = 0 Тогда
		
			//Инициализируем таблицы
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	DMS_ЗаявкаНаАвтомобиль.Ссылка,
			|	ЛОЖЬ КАК УдаленнаяЗапись
			|ИЗ
			|	Документ.DMS_ЗаявкаНаАвтомобиль КАК DMS_ЗаявкаНаАвтомобиль";
			ТаблицаЗаявкаНаАвтомобиль = Запрос.Выполнить().Выгрузить();
			ТаблицаЗаявкаНаАвтомобиль.Очистить();
			ТаблицаЗаявкаНаАвтомобиль_ДляУдаленияРегистрации = ТаблицаЗаявкаНаАвтомобиль.Скопировать();
			
		КонецЕсли;
		
		ЭлементИзмененныхДанных = Выборка.Получить();
		
		//формируем общую таблицу для отправки
		Если ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("ДокументСсылка.DMS_ЗаявкаНаАвтомобиль") Тогда
			Стр = ТаблицаЗаявкаНаАвтомобиль.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
			Если ТипЗнч(ЭлементИзмененныхДанных) =  Тип("УдалениеОбъекта") Тогда
				Стр.УдаленнаяЗапись = Истина;
			Иначе
				Стр.УдаленнаяЗапись = Ложь;
			КонецЕсли;
			Стр = ТаблицаЗаявкаНаАвтомобиль_ДляУдаленияРегистрации.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
		КонецЕсли;

		
		Счетчик = Счетчик + 1;
		ВсегоПередано = ВсегоПередано + 1;
		
		Если Счетчик = 1000 ИЛИ ВсегоПередано = ОбщееКоличество Тогда
			
			ОтправитьТаблицуЗаявкаНаАвтомобиль(ТаблицаЗаявкаНаАвтомобиль, BIR, ВебСервис, ПланОбмена, Server);
			
			Счетчик = 0;
			
		КонецЕсли;
		
	КонецЦикла;                      
		
КонецПроцедуры // ВыполнитьОтправкуДанныхВЦентраль()

Процедура ВыполнитьОтправкуЗаявокНаОтгрузку(ПланОбмена)
	
	ВебСервис = ПолучитьПрокси();
	Сериализатор = Новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
	
	РезультатВыполнения = Новый Структура();
	Server = СтрокаСоединенияИнформационнойБазы();
	BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	
	//Получим ссылки на все изменения
	ФильтрВыборки = Новый Массив;
	ФильтрВыборки.Добавить(Метаданные.Документы.DMS_ЗаявкаНаОтгрузку);
	Выборка = ПланыОбмена.ВыбратьИзменения(ПланОбмена, 2, ФильтрВыборки);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_ЗаявкаНаОтгрузку.Ссылка
		|ИЗ
		|	Документ.DMS_ЗаявкаНаОтгрузку КАК DMS_ЗаявкаНаОтгрузку
		|ГДЕ
		|	DMS_ЗаявкаНаОтгрузку.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Период = Новый СтандартныйПериод;
	Период.Вариант = ВариантСтандартногоПериода.Месяц;
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	Выборка = Запрос.Выполнить().Выбрать();
	
	//Посчитаем количество изменений
	ОбщееКоличество = 0;
	Пока Выборка.Следующий() Цикл
		ОбщееКоличество = ОбщееКоличество + 1;
	КонецЦикла;
	Выборка.Сбросить();
	
	//Заполним таблицы первоначальной информацией из плана обмена
	Счетчик = 0; ВсегоПередано = 0;
	Пока Выборка.Следующий() Цикл
		
		Если Счетчик = 0 Тогда
		
			//Инициализируем таблицы
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ первые 1
			|	DMS_ЗаявкаНаОтгрузку.Ссылка,
			|	ЛОЖЬ КАК УдаленнаяЗапись
			|ИЗ
			|	Документ.DMS_ЗаявкаНаОтгрузку КАК DMS_ЗаявкаНаОтгрузку";
			ТаблицаЗаявкаНаОтгрузку = Запрос.Выполнить().Выгрузить();
			ТаблицаЗаявкаНаОтгрузку.Очистить();
			ТаблицаЗаявкаНаОтгрузку_ДляУдаленияРегистрации = ТаблицаЗаявкаНаОтгрузку.Скопировать();
			
		КонецЕсли;
		
		ЭлементИзмененныхДанных = Выборка.Ссылка.ПолучитьОбъект();
		
		//формируем общую таблицу для отправки
		Если ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("ДокументСсылка.DMS_ЗаявкаНаОтгрузку") Тогда
			Стр = ТаблицаЗаявкаНаОтгрузку.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
			Если ТипЗнч(ЭлементИзмененныхДанных) =  Тип("УдалениеОбъекта") Тогда
				Стр.УдаленнаяЗапись = Истина;
			Иначе
				Стр.УдаленнаяЗапись = Ложь;
			КонецЕсли;
		КонецЕсли;

		
		Счетчик = Счетчик + 1;
		ВсегоПередано = ВсегоПередано + 1;
		
		Если Счетчик = 1000 ИЛИ ВсегоПередано = ОбщееКоличество Тогда
			
			ОтправитьТаблицуЗаявкаНаОтгрузку(ТаблицаЗаявкаНаОтгрузку, BIR, ВебСервис, ПланОбмена, Server);
			
			Счетчик = 0;
			
		КонецЕсли;
		
	КонецЦикла;                      
		
КонецПроцедуры

Процедура ОтправитьТаблицуЗаявкаНаОтгрузку(ТаблицаДанных, BIR, ВебСервис, ПланОбмена, Server)
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Ссылка,
	|	Таблица.УдаленнаяЗапись
	|ПОМЕСТИТЬ Врем
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&BIR КАК BIR,
	|	Врем.УдаленнаяЗапись КАК УдаленнаяЗапись,
	|	DMS_ЗаявкаНаОтгрузку.ПометкаУдаления КАК ПометкаУдаления,
	|	DMS_ЗаявкаНаОтгрузку.Номер,
	|	DMS_ЗаявкаНаОтгрузку.Дата,
	|	DMS_ЗаявкаНаОтгрузку.ДатаОтгрузки,
	|	DMS_ЗаявкаНаОтгрузку.VIN,
	|	DMS_ЗаявкаНаОтгрузку.ТочкаОтгрузки,
	|	DMS_ЗаявкаНаОтгрузку.АдресОтгрузки
	|ИЗ
	|	Врем КАК Врем
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.DMS_ЗаявкаНаОтгрузку КАК DMS_ЗаявкаНаОтгрузку
	|		ПО (DMS_ЗаявкаНаОтгрузку.Ссылка = Врем.Ссылка)";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДанных);
	Запрос.УстановитьПараметр("BIR", BIR);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ТаблицаРезультатыОбработки = Запрос.Выполнить().Выгрузить();

	
	Фабрика = ВебСервис.ФабрикаXDTO;
	Сериализатор = Новый СериализаторXDTO(Фабрика);
	Результат = Сериализатор.ЗаписатьXDTO(ТаблицаРезультатыОбработки);
	ДанныеОтправлены = ВебСервис.SetData("SetOrderOnShip", Результат, Server);
	
	Если ДанныеОтправлены = Истина Тогда
		Для Каждого КлючевыеПоля из ТаблицаДанных Цикл
			ПланыОбмена.УдалитьРегистрациюИзменений(ПланОбмена, КлючевыеПоля.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

