	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.DMS_АрхивРасчетовМинДатыПоставки КАК DMS_АрхивРасчетовМинДатыПоставки
	|		ПО DMS_ЗаявкаНаАвтомобиль.Ссылка = DMS_АрхивРасчетовМинДатыПоставки.ЗаявкаНаАвтомобиль
	|			И DMS_ЗаявкаНаАвтомобиль.VIN = DMS_АрхивРасчетовМинДатыПоставки.VIN
	|ГДЕ
	|	DMS_ЗаявкаНаАвтомобиль.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыВызоваСервера.Ссылка);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	ТаблицаРезультатыОбработки = Запрос.Выполнить().Выгрузить();

	ВебСервис = ПолучитьПрокси();
	Server = СтрокаСоединенияИнформационнойБазы();
	Фабрика = ВебСервис.ФабрикаXDTO;
	
	ТаблицаРезультатыОбработки.Колонки.Добавить("UID", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UID", 40);
	ТаблицаРезультатыОбработки.Колонки.Добавить("КлиентUID", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UID", 40);
	ТаблицаРезультатыОбработки.Колонки.Добавить("Пользователь");
	ТаблицаРезультатыОбработки.Колонки.Добавить("ДЦUID", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UID", 40);
	ТаблицаРезультатыОбработки.Колонки.Добавить("ДилерскийЦентрНаименование");
	ТаблицаРезультатыОбработки.Колонки.Добавить("ДилерскийЦентрBIR");

	Для Каждого СтрокаТЗ ИЗ ТаблицаРезультатыОбработки Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Ссылка) Тогда
			СтрокаТЗ.UID = Строка(СтрокаТЗ.Ссылка.УникальныйИдентификатор());
		КонецЕсли; 

		Если ЗначениеЗаполнено(СтрокаТЗ.ДилерскийЦентр) Тогда
			СтрокаТЗ.ДЦUID = Строка(СтрокаТЗ.ДилерскийЦентр.УникальныйИдентификатор());
			СтрокаТЗ.ДилерскийЦентрНаименование =  СтрокаТЗ.ДилерскийЦентр.Наименование;
			СтрокаТЗ.ДилерскийЦентрBIR = СтрокаТЗ.ДилерскийЦентр.BIR;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЗ.Клиент) Тогда
			СтрокаТЗ.КлиентUID = Строка(СтрокаТЗ.Клиент.УникальныйИдентификатор());
		КонецЕсли;
		СтрокаТЗ.Пользователь = ВебСервис.Пользователь;
	КонецЦикла;
	ТаблицаРезультатыОбработки.Колонки.Удалить("Ссылка");
	ТаблицаРезультатыОбработки.Колонки.Удалить("Клиент");
	ТаблицаРезультатыОбработки.Колонки.Удалить("ДилерскийЦентр");
		
	Сериализатор = Новый СериализаторXDTO(Фабрика);
	Результат = Сериализатор.ЗаписатьXDTO(ТаблицаРезультатыОбработки);
	ДанныеОтправлены = ВебСервис.PutOrderOnAuto(Результат, Server);
	
	сОтвет = Сериализатор.ПрочитатьXDTO(ДанныеОтправлены);
	ПоместитьВоВременноеХранилище(сОтвет, АдресХранилища);
КонецПроцедуры

