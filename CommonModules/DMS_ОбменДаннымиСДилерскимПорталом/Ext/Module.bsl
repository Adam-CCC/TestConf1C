// Формирование даты желаемой поставки
Функция РассчитатьМинимальныйСрокПоставкиНаДилерскомПортале(VIN, BIR, КорпКлиен = Ложь, КодМодели = "", ВозвратПараметровРасчета = Ложь) Экспорт
	
	Попытка
		ВебСервис       = ПолучитьПрокси();
		ПолученныйОтвет = ВебСервис.GetDeliveryDateNew(VIN, BIR, КорпКлиен, КодМодели, ВозвратПараметровРасчета); 
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		ПолученнаяДата = Сериализатор.ПрочитатьXDTO(ПолученныйОтвет);

		Если ТипЗнч(ПолученнаяДата) = Тип("Дата") Тогда
			ПараметрыРасчета = Новый Структура;
			ПараметрыРасчета.Вставить("МинимальнаяДатаПоставки", ПолученнаяДата);
			
		ИначеЕсли ТипЗнч(ПолученнаяДата) = Тип("Структура") Тогда
			ПараметрыРасчета = ПолученнаяДата;
		Иначе
			ПараметрыРасчета = Новый Структура;
			ПараметрыРасчета.Вставить("МинимальнаяДатаПоставки", Дата(1,1,1));
		КонецЕсли;
	Исключение
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("МинимальнаяДатаПоставки", Дата(1,1,1));			
	КонецПопытки;
	
	Возврат ПараметрыРасчета; 
	
КонецФункции

// ВАЖНО! 
// Во избежание появления заявок на автомобиль с некорректной датой желаемой поставки,
// алгоритм расчета "Минимальной даты поставки" в текущей конфигурации "ДМС", 
// должен строго совпадать с алгоритмом расчета в конфигурации "Дилерский портал".
// Если меняется алгоритм расчета в одной конфигурации, то изменения обязательно необходимо внести и в другую конфигурацию.
//
&НаСервере
Функция РассчитатьМинимальныйСрокПоставки(VIN, Счет, КорпКлиен = Ложь, КодМодели = "", ВозвратПараметровРасчета = Ложь) Экспорт
	
	BIR = Прав(Счет, 4);
	
	СрокНаСкладе    = 7 + ?(КорпКлиен, 3, 0);
	СрокПодготовки  = ?(КорпКлиен, 10, 5);
	СрокДоставки    = 1;
	ДопСрок         = 0;
	ТекстДопСрок    = "";
	ДатаОтсчета     = Дата(1,1,1);
	НазваниеДаты    = "";
	ОписаниеРасчета = "";
	
	МинимальнаяДатаПоставки = Дата(1,1,1);
		
	Если ЗначениеЗаполнено(VIN) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_MADPREV,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.SKLAD,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.MODEL,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_RECU,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_PLAN,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_FACT,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.ID_RECEIVER,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.GTD,
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.IS_TRANSFER
		|ИЗ
		|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
		|ГДЕ
		|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN = &VIN";
		
		Запрос.УстановитьПараметр("VIN", VIN);
		
		ВыборкаСклад = Запрос.Выполнить().Выбрать();
		ВыборкаСклад.Следующий();

		Если ВыборкаСклад.SKLAD = "PDI" И (ВыборкаСклад.MODEL = "79H" ИЛИ ВыборкаСклад.MODEL = "J1C" ИЛИ ВыборкаСклад.MODEL = "HAH") Тогда
			ДопСрок = 2; 
			ТекстДопСрок = " + " + ДопСрок + " дн. для склада PDI";
		КонецЕсли;			
		
		Если НЕ ЗначениеЗаполнено(ВыборкаСклад.SKLAD) или ВыборкаСклад.SKLAD = "VAZ"  Тогда
			СрокДоставки = ПолучитьСрокДоставки(BIR, ВыборкаСклад.MODEL);
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	МАКСИМУМ(ВложенныйЗапрос.СрокДоставкиПоТочке) КАК СрокДоставкиПоТочке,
			|	МАКСИМУМ(ВложенныйЗапрос.СрокДоставкиБезТочки) КАК СрокДоставкиБезТочки
			|ИЗ
			|	(ВЫБРАТЬ
			|		ЕСТЬNULL(МИНИМУМ(АдресаРазгрузкиДилеров.СрокДоставки), 0) КАК СрокДоставкиПоТочке,
			|		NULL КАК СрокДоставкиБезТочки
			|	ИЗ
			|		РегистрСведений.DMS_АдресаРазгрузкиДилеров КАК АдресаРазгрузкиДилеров
			|	ГДЕ
			|		ПОДСТРОКА(АдресаРазгрузкиДилеров.BIR, 5, 4) = &BIR
			|		И АдресаРазгрузкиДилеров.SKLAD_CODE = &SKLAD
			|		И АдресаРазгрузкиДилеров.idТочка = &ID_RECEIVER
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		NULL,
			|		ЕСТЬNULL(МИНИМУМ(АдресаРазгрузкиДилеров.СрокДоставки), 0)
			|	ИЗ
			|		РегистрСведений.DMS_АдресаРазгрузкиДилеров КАК АдресаРазгрузкиДилеров
			|	ГДЕ
			|		ПОДСТРОКА(АдресаРазгрузкиДилеров.BIR, 5, 4) = &BIR
			|		И АдресаРазгрузкиДилеров.SKLAD_CODE = &SKLAD) КАК ВложенныйЗапрос";
			
			Запрос.УстановитьПараметр("BIR", BIR);
			Запрос.УстановитьПараметр("SKLAD", ВыборкаСклад.SKLAD);
			Запрос.УстановитьПараметр("ID_RECEIVER", ВыборкаСклад.ID_RECEIVER);
			
			РезультатЗапроса = Запрос.Выполнить();
			Выборка = РезультатЗапроса.Выбрать();
			
			Если Выборка.Следующий() Тогда
				СрокДоставки = ?(Выборка.СрокДоставкиПоТочке = 0, Выборка.СрокДоставкиБезТочки, Выборка.СрокДоставкиПоТочке);
			КонецЕсли;
		КонецЕсли;
		
		ИмпортБезГТД   = ПолучитьСтатусАМ(ВыборкаСклад);
		СрокНаСкладе   = ?(ИмпортБезГТД, 10, 7) + ?(КорпКлиен, 3, 0);
		СрокДоставки   = ?(ЗначениеЗаполнено(СрокДоставки),СрокДоставки,0);
		
		// Обрабатываем полученные данные и формируем даты
		DATE_PLAN = ВыборкаСклад.DATE_PLAN;
		Если DATE_PLAN = "" Тогда
			DATE_PLAN = ДАта(1,1,1);
		ИначеЕсли ТипЗнч(ВыборкаСклад.DATE_PLAN) = Тип("Строка")  Тогда
			DATE_PLAN = ПолучитьДатуИзСтроки(ВыборкаСклад.DATE_PLAN);
		КонецЕсли;
		
		DATE_RECU = ВыборкаСклад.DATE_RECU;
		Если DATE_RECU = "" Тогда
			DATE_RECU = ДАта(1,1,1);
		ИначеЕсли ТипЗнч(ВыборкаСклад.DATE_RECU) = Тип("Строка")  Тогда
			DATE_RECU = ПолучитьДатуИзСтроки(ВыборкаСклад.DATE_RECU);
		КонецЕсли;
		
		DATE_MADPREV = ВыборкаСклад.DATE_MADPREV;
		Если DATE_MADPREV = "" Тогда
			DATE_MADPREV = ДАта(1,1,1);
		ИначеЕсли ТипЗнч(ВыборкаСклад.DATE_MADPREV) = Тип("Строка") Тогда
			DATE_MADPREV = ПолучитьДатуИзСтроки(ВыборкаСклад.DATE_MADPREV);
		КонецЕсли;
		
		DATE_FACT = ВыборкаСклад.DATE_FACT;
		Если DATE_FACT = "" Тогда
			DATE_FACT = ДАта(1,1,1);
		ИначеЕсли ТипЗнч(ВыборкаСклад.DATE_FACT) = Тип("Строка") Тогда
			DATE_FACT = ПолучитьДатуИзСтроки(ВыборкаСклад.DATE_FACT);
		КонецЕсли;
		
		// Расчет по производственному календарю, т.е. только по рабочим дням
		Если ЗначениеЗаполнено(DATE_FACT) Тогда
			DATE_FACT_ПоКалендарю = ДатаПоКалендарю(DATE_FACT, СрокДоставки + СрокПодготовки);
						
			Если ТекущаяДата() >= DATE_FACT_ПоКалендарю Тогда
				МинимальнаяДатаПоставки = ДатаПоКалендарю(ТекущаяДата(), СрокПодготовки);
				ДатаОтсчета     = ТекущаяДата();
				НазваниеДаты    = "DATE_FACT";
				ОписаниеРасчета = "Дата отсчета + Срок подгодовки";
			Иначе
				МинимальнаяДатаПоставки = ДатаПоКалендарю(DATE_FACT, СрокДоставки + СрокПодготовки);
				ДатаОтсчета     = DATE_FACT;
				НазваниеДаты    = "DATE_FACT";
				ОписаниеРасчета = "Дата отсчета + Срок доставки + Срок подготовки";
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(DATE_RECU) И ЗначениеЗаполнено(DATE_PLAN) Тогда
			Попытка
				ДопТрансфер = ?(ВыборкаСклад.IS_TRANSFER, СрокНаСкладе + 3, 0);
			Исключение	
				ДопТрансфер = 0;
			КонецПопытки;

			МинимальнаяДатаПоставки = ДатаПоКалендарю(DATE_PLAN, СрокДоставки + СрокПодготовки + ДопТрансфер + ДопСрок);
			ДатаОтсчета     = DATE_PLAN;
			НазваниеДаты    = "DATE_PLAN";
			ОписаниеРасчета = "Дата отсчета + Срок доставки + Срок подгодовки" + ?(ДопТрансфер > 0, " + (Срок на складе + 3 дня)", "") + ТекстДопСрок;
			
		ИначеЕсли ЗначениеЗаполнено(DATE_RECU) И ЗначениеЗаполнено(ВыборкаСклад.SKLAD) Тогда
			ДатаОтсчета     = ТекущаяДата();
			МинимальнаяДатаПоставки = ДатаПоКалендарю(ДатаОтсчета, СрокНаСкладе + СрокДоставки + СрокПодготовки + ДопСрок);
			НазваниеДаты    = "Текущая дата";
			ОписаниеРасчета = "Дата отсчета + Срок на складе + Срок доставки + Срок подготовки" + ТекстДопСрок;
			
		ИначеЕсли ЗначениеЗаполнено(DATE_MADPREV) Тогда
			МинимальнаяДатаПоставки = ДатаПоКалендарю(DATE_MADPREV, СрокНаСкладе + СрокДоставки + СрокПодготовки);
			ДатаОтсчета     = DATE_MADPREV;
			НазваниеДаты    = "DATE_MADPREV";
			ОписаниеРасчета = "Дата отсчета + Срок на складе + Срок доставки + Срок подготовки";
			
		Иначе
			МинимальнаяДатаПоставки = Дата(1,1,1);
		КонецЕсли;
		
	Иначе
		РДПередачи = Дата(1,1,1);
		КолвоДней = 0;
		НеделяМесяца = Цел(День(ТекущаяДата()) / 7);
		НеделяМесяца = ?(НеделяМесяца = 0, 1, НеделяМесяца);
		
		СрокДоставкиПередачи = ПолучитьСрокДоставки(BIR, КодМодели); 
		
		// Определяем 15 число текущего или следующего месяца
		Если НеделяМесяца = 1 ИЛИ НеделяМесяца = 2 Тогда
			РДПередачи = Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), 15);                   
		ИначеЕсли НеделяМесяца = 3 ИЛИ НеделяМесяца = 4 Тогда
			РДПередачи = ДобавитьМесяц(Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), 15), 1); 
		КонецЕсли;
		
		// Варианты определения даты начала передачи автомобиля, исходя из кода модели
		// Старый вариант, оставлено для истории:
		//Если (КодМодели = "KQ2" ИЛИ КодМодели = "MAU" ИЛИ КодМодели = "MRO" 
		//	ИЛИ КодМодели = "TWZ" ИЛИ КодМодели = "67F" ИЛИ КодМодели = "67P") Тогда 
		//	КолвоДней = (62 + 35 + 7 + ?(КорпКлиент, 14, 5) + СрокДоставкиПередачи) * 86400;
		//	МинимальнаяДатаПоставки = РДПередачи + КолвоДней;
		//	
		//ИначеЕсли КодМодели = "ZGH" Тогда
		//	КолвоДней =(62 + 70 + 7 + ?(КорпКлиент, 14, 5) + СрокДоставкиПередачи) * 86400;
		//	МинимальнаяДатаПоставки = РДПередачи + КолвоДней;
		//	
		//Иначе
		//	КолвоДней = (93 + 7 + ?(КорпКлиент, 7, 5) + СрокДоставкиПередачи) * 86400;
		//	МинимальнаяДатаПоставки = РДПередачи + КолвоДней;
		//КонецЕсли;
		
		// Новый вариант
		КолвоДней = (45 + ?(КорпКлиен, 14, 5) + СрокДоставкиПередачи + 7) * 86400;
		МинимальнаяДатаПоставки = РДПередачи + КолвоДней;

	КонецЕсли;
	
	// Временный код, для того чтобы всегда была заполнена минимальная дата поставки
	Если МинимальнаяДатаПоставки = Дата(1,1,1) Тогда
		ДатаОтсчета     = ДобавитьМесяц(ТекущаяДата(), 2);
		МинимальнаяДатаПоставки = ДатаПоКалендарю(ДатаОтсчета, СрокНаСкладе + СрокДоставки + СрокПодготовки + ДопСрок);
		НазваниеДаты    = "Текущая дата + 2 месяца";
		ОписаниеРасчета = "Дата отсчета + Срок на складе + Срок доставки + Срок подготовки" + ТекстДопСрок;
	КонецЕсли;		

	Если ВозвратПараметровРасчета Тогда
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("VIN",                     VIN);
		ПараметрыРасчета.Вставить("ДатаОтсчета",             ДатаОтсчета);
		ПараметрыРасчета.Вставить("НазваниеДаты",            НазваниеДаты);
		ПараметрыРасчета.Вставить("СрокДоставки",            СрокДоставки);
		ПараметрыРасчета.Вставить("СрокНаСкладе",            СрокНаСкладе);
		ПараметрыРасчета.Вставить("СрокПодготовки",          СрокПодготовки);
		ПараметрыРасчета.Вставить("ОписаниеРасчета",         ОписаниеРасчета);
		ПараметрыРасчета.Вставить("МинимальнаяДатаПоставки", МинимальнаяДатаПоставки);
		ПараметрыРасчета.Вставить("ЛокальноВДМС",            Истина);
		
		Возврат ПараметрыРасчета;					
	КонецЕсли;
	
	Возврат МинимальнаяДатаПоставки;
	
КонецФункции 

&НаСервере
Функция ПолучитьСтатусАМ(ВыборкаСклад)
	
	Если (ВыборкаСклад.MODEL ="67F" 
		или ВыборкаСклад.MODEL  = "67P"
			или ВыборкаСклад.MODEL ="ZGH"
				или ВыборкаСклад.MODEL ="TWZ"
					или ВыборкаСклад.MODEL ="MAU") и Не ЗначениеЗаполнено(ВыборкаСклад.GTD) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Возвращает дату, которая отличается указанной даты ДатаОт на количество дней,
// входящих в указанный график или производственный календарь ГрафикРаботы.
//
// Параметры:
//	 ГрафикРаботы	- СправочникСсылка.Календари, СправочникСсылка.ПроизводственныеКалендари - график или 
//                    производственный календарь, который необходимо использовать для расчета даты.
//	 ДатаОт			- Дата - дата, от которой нужно рассчитать количество дней.
//	 КоличествоДней	- Число - количество дней, на которые нужно увеличить дату начала.
//	 ВызыватьИсключение - Булево - если Истина, вызвать исключение в случае незаполненного графика.
//
// Возвращаемое значение:
//	 Дата, Неопределено - дата, увеличенная на количество дней, входящих в график.
//	                      Если выбранный график не заполнен, и ВызыватьИсключение = Ложь, возвращается Неопределено.
//
&НаСервере
Функция ДатаПоКалендарю(Знач ДатаОт, Знач КоличествоДней, ВызыватьИсключение = Истина) Экспорт
	
	ДатаОт = НачалоДня(ДатаОт);
	
	Если КоличествоДней = 0 Тогда
		Возврат ДатаОт;
	КонецЕсли;
	
	МассивДней = Новый Массив;
	МассивДней.Добавить(КоличествоДней);
	
	МассивДат = ДатыПоКалендарю(ДатаОт, МассивДней, , ВызыватьИсключение);
	
	Возврат ?(МассивДат <> Неопределено И МассивДат.Количество() > 0, МассивДат[0], Неопределено);
	
КонецФункции // ДатаПоКалендарю()

// Возвращает количество дней для доставки
//
// Параметры:
//  BIR_ID		 - Строка	 - BIR дилера
//  КодМоделиП	 - Строка	 - Код модели
// 
// Возвращаемое значение:
//  Число - Количество дней доставки
//
&НаСервере
Функция ПолучитьСрокДоставки(BIR_ID, КодМоделиП) Экспорт
		
	Если КодМоделиП = "46L" ИЛИ КодМоделиП =  "46B" ТОГДА
		ПараметрПоискаСклад = "TLT";
	ИначеЕсли КодМоделиП = "79H" ИЛИ КодМоделиП = "HAH" ИЛИ КодМоделиП = "J1C" ТОГДА
		ПараметрПоискаСклад = "CLE";
	Иначе
		ПараметрПоискаСклад = "PLP";
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	АдресаРазгрузкиДилеров.СрокДоставки КАК СрокДоставки
		|ИЗ
		|	РегистрСведений.DMS_АдресаРазгрузкиДилеров КАК АдресаРазгрузкиДилеров
		|ГДЕ
		|	ПОДСТРОКА(АдресаРазгрузкиДилеров.BIR, 5, 4) = &BIR
		|	И АдресаРазгрузкиДилеров.SKLAD_CODE = &SKLAD_CODE
		|
		|УПОРЯДОЧИТЬ ПО
		|	АдресаРазгрузкиДилеров.idТочка";
	
	Запрос.УстановитьПараметр("BIR",        BIR_ID);
	Запрос.УстановитьПараметр("SKLAD_CODE", ПараметрПоискаСклад);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.СрокДоставки;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции // ПолучитьСрокДоставки()

// Возвращает даты, которые отличаются от указанной даты ДатаОт на количество дней,
// входящих в указанный график ГрафикРаботы.
//
// Параметры:
//	 ГрафикРаботы	- СправочникСсылка.Календари, СправочникСсылка.ПроизводственныеКалендари - график или 
//                    производственный календарь, который необходимо использовать для расчета дат.
//	 ДатаОт			- Дата - дата, от которой нужно рассчитать количество дней.
//	 МассивДней		- Массив - количество дней (Число), на которые нужно увеличить дату начала.
//	 РассчитыватьСледующуюДатуОтПредыдущей	- Булево - нужно ли рассчитывать следующую дату от предыдущей или
//											           все даты рассчитываются от переданной даты.
//	 ВызыватьИсключение - Булево - если Истина, вызвать исключение в случае незаполненного графика.
//
// Возвращаемое значение:
//	 Неопределено, Массив - массив дат, увеличенных на количество дней, входящих в график,
//	                        Если график ГрафикРаботы не заполнен, и ВызыватьИсключение = Ложь, возвращается Неопределено.
//
&НаСервере
Функция ДатыПоКалендарю(Знач ДатаОт, Знач МассивДней, Знач РассчитыватьСледующуюДатуОтПредыдущей = Ложь, ВызыватьИсключение = Истина) Экспорт
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СоздатьВТПриращениеДней(МенеджерВременныхТаблиц, МассивДней, РассчитыватьСледующуюДатуОтПредыдущей);
	
	// Алгоритм работает следующим образом:
	// Получаем все дни календаря, следующие после даты отсчета.
	// Для каждого из таких дней рассчитываем количество дней, включенных в график с даты отсчета.
	// Отбираем рассчитанное таким образом количество по таблице приращения дней.
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	// По производственному календарю.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КалендарныеГрафики.ДатаКалендаря КАК ДатаГрафика
	|ПОМЕСТИТЬ ВТПоследующиеДатыГрафика
	|ИЗ
	|	РегистрСведений.DMS_ПроизводственныйКалендарь КАК КалендарныеГрафики
	|ГДЕ
	|	КалендарныеГрафики.ДатаКалендаря >= &ДатаОт
	|	И КалендарныеГрафики.ВидДня В (ЗНАЧЕНИЕ(Перечисление.DMS_ВидыДнейПроизводственногоКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.DMS_ВидыДнейПроизводственногоКалендаря.Предпраздничный))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоследующиеДатыГрафика.ДатаГрафика,
	|	КОЛИЧЕСТВО(КалендарныеГрафики.ДатаГрафика) - 1 КАК КоличествоДнейВключенныхВГрафик
	|ПОМЕСТИТЬ ВТПоследующиеДатыГрафикаСКоличествомДней
	|ИЗ
	|	ВТПоследующиеДатыГрафика КАК ПоследующиеДатыГрафика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследующиеДатыГрафика КАК КалендарныеГрафики
	|		ПО (КалендарныеГрафики.ДатаГрафика <= ПоследующиеДатыГрафика.ДатаГрафика)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоследующиеДатыГрафика.ДатаГрафика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриращениеДней.ИндексСтроки,
	|	ЕСТЬNULL(ПоследующиеДни.ДатаГрафика, НЕОПРЕДЕЛЕНО) КАК ДатаПоКалендарю
	|ИЗ
	|	ВТПриращениеДней КАК ПриращениеДней
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоследующиеДатыГрафикаСКоличествомДней КАК ПоследующиеДни
	|		ПО ПриращениеДней.КоличествоДней = ПоследующиеДни.КоличествоДнейВключенныхВГрафик
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриращениеДней.ИндексСтроки";
	
	Запрос.УстановитьПараметр("ДатаОт", НачалоДня(ДатаОт));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МассивДат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивДат.Добавить(Выборка.ДатаПоКалендарю);
	КонецЦикла;
	
	Возврат МассивДат;
	
КонецФункции // ДатыПоКалендарю()

// Создает временную таблицу ВТПриращениеДней, в которой для каждого элемента из МассивДней 
// формируется строка с индексом элемента и значением - количеством дней.
// 
// Параметры:
//	- МенеджерВременныхТаблиц,
//	- МассивДней - массив, количество дней,
//	- РассчитыватьСледующуюДатуОтПредыдущей - необязательный, по умолчанию Ложь.
//
&НаСервере
Процедура СоздатьВТПриращениеДней(МенеджерВременныхТаблиц, Знач МассивДней, Знач РассчитыватьСледующуюДатуОтПредыдущей = Ложь) Экспорт
	
	ПриращениеДней = Новый ТаблицаЗначений;
	ПриращениеДней.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
	ПриращениеДней.Колонки.Добавить("КоличествоДней", Новый ОписаниеТипов("Число"));
	
	КоличествоДней = 0;
	НомерСтроки = 0;
	Для Каждого СтрокаДней Из МассивДней Цикл
		КоличествоДней = КоличествоДней + СтрокаДней;
		
		Строка = ПриращениеДней.Добавить();
		Строка.ИндексСтроки			= НомерСтроки;
		Если РассчитыватьСледующуюДатуОтПредыдущей Тогда
			Строка.КоличествоДней	= КоличествоДней;
		Иначе
			Строка.КоличествоДней	= СтрокаДней;
		КонецЕсли;
			
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриращениеДней.ИндексСтроки,
	|	ПриращениеДней.КоличествоДней
	|ПОМЕСТИТЬ ВТПриращениеДней
	|ИЗ
	|	&ПриращениеДней КАК ПриращениеДней";
	
	Запрос.УстановитьПараметр("ПриращениеДней",	ПриращениеДней);
	
	Запрос.Выполнить();
	
КонецПроцедуры // СоздатьВТПриращениеДней()

// Конвертирует строку в дату
//
// Параметры:
//  СтрокаДата	 - Строка	 - Строка с датой
// 
// Возвращаемое значение:
//  Дата - Сконвертированная дата
//
&НаСервере
Функция ПолучитьДатуИзСтроки(СтрокаДата)
	
	ЧастиСтроки1 = Renault_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаДата, " ");
	ЧастиСтроки2 = Renault_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЧастиСтроки1[0], "/");
	Если ЧастиСтроки2.Количество() < 3 Тогда
		ЧастиСтроки2 = Renault_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЧастиСтроки1[0], ".");
	КонецЕсли;

	Если Число(ЧастиСтроки2[1])<=12 Тогда
		ДатаВозврат = Дата(ЧастиСтроки2[2], ЧастиСтроки2[1], ЧастиСтроки2[0]);
	Иначе
		ДатаВозврат = Дата(ЧастиСтроки2[2], ЧастиСтроки2[0], ЧастиСтроки2[1]);
	КонецЕсли;
	
	Возврат ДатаВозврат;
	
КонецФункции // ПолучитьДатуИзСтроки()

// Загружает производственный календарь из дилерского портала
//
// Параметры:
//  Год	 - Число	 - Год календаря
//
Процедура ЗагрузитьДанныеПроизводственногоКалендаря(Год) Экспорт
	
	ВебСервер = ПолучитьПрокси();
	МассивБир = Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.ПолучитьМассивБирДляПолученияДанных();
	ТЗXDTO = ВебСервер.GetCalendar(Год);
	
	ТаблицаДанных = СериализаторXDTO.ПрочитатьXDTO(ТЗXDTO);
	
	НаборЗаписей = РегистрыСведений.DMS_ПроизводственныйКалендарь.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Год.Установить(Год);
	
	НаборЗаписейПеренесенные = РегистрыСведений.DMS_ПеренесенныеРабочиеДни.СоздатьНаборЗаписей();
	НаборЗаписейПеренесенные.Отбор.Год.Установить(Год);
	НаборЗаписейПеренесенные.Записать();
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Год = Год;
		НоваяЗапись.ДатаКалендаря = СтрокаТаблицы.Дата;

		Если СтрокаТаблицы.ВидДня = 1 Тогда
			НоваяЗапись.ВидДня = Перечисления.DMS_ВидыДнейПроизводственногоКалендаря.Рабочий;
		ИначеЕсли СтрокаТаблицы.ВидДня = 2 Тогда
			НоваяЗапись.ВидДня = Перечисления.DMS_ВидыДнейПроизводственногоКалендаря.Суббота;
		ИначеЕсли СтрокаТаблицы.ВидДня = 3 Тогда
			НоваяЗапись.ВидДня = Перечисления.DMS_ВидыДнейПроизводственногоКалендаря.Воскресенье;
		ИначеЕсли СтрокаТаблицы.ВидДня = 4 Тогда
			НоваяЗапись.ВидДня = Перечисления.DMS_ВидыДнейПроизводственногоКалендаря.Предпраздничный;
		ИначеЕсли СтрокаТаблицы.ВидДня = 5 Тогда
			НоваяЗапись.ВидДня = Перечисления.DMS_ВидыДнейПроизводственногоКалендаря.Праздник;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаПереноса) Тогда
			
			Если СтрокаТаблицы.ВидДня = 2 
					ИЛИ СтрокаТаблицы.ВидДня = 3
					ИЛИ СтрокаТаблицы.ВидДня = 5 Тогда
					
				НайденнаяСтрока = ТаблицаДанных.Найти(СтрокаТаблицы.ДатаПереноса, "Дата");
				
				Если НайденнаяСтрока <> Неопределено 
						И НайденнаяСтрока.ВидДня = 1 Тогда
					
					МенеджерЗаписиПереносы = РегистрыСведений.DMS_ПеренесенныеРабочиеДни.СоздатьМенеджерЗаписи();	
					МенеджерЗаписиПереносы.Год 			= Год;
					МенеджерЗаписиПереносы.РабочийДень 	= НайденнаяСтрока.Дата;
					МенеджерЗаписиПереносы.ВыходнойДень = СтрокаТаблицы.Дата;
					МенеджерЗаписиПереносы.Записать();
					
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры // ЗагрузитьДанныеПроизводственногоКалендаря()

Функция ОпределитьТолькоФамилию(КлиентФамилия)
	
	Фамилия = СокрЛП(КлиентФамилия);
	
	Пробел = Найти(Фамилия, " ");
	
	Если Пробел Тогда
		Фамилия = Лев(Фамилия, Пробел - 1);
	КонецЕсли;
	
	Возврат Фамилия;
	
КонецФункции
