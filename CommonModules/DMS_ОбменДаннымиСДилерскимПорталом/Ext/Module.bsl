	|	DMS_ЗаявкаНаАвтомобиль.КоммерческаяАкция4.Код КАК КоммерческаяАкция4Код,
	|	DMS_ЗаявкаНаАвтомобиль.КоммерческаяАкция5.Код КАК КоммерческаяАкция5Код,
	|	DMS_ЗаявкаНаАвтомобиль.ВариантСалона.Артикул КАК ВариантСалонаАртикул,
	|	ПРЕДСТАВЛЕНИЕ(DMS_ЗаявкаНаАвтомобиль.ТипАвтомобиля),
	|	DMS_ЗаявкаНаАвтомобиль.СпособОплаты.Наименование,
	|	DMS_ЗаявкаНаАвтомобиль.ТипЗаявки.Наименование,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.Наименование,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.НаименованиеПолное,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.Фамилия,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.Имя,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.Отчество,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.ОсновнойТелефон,
	|	ПРЕДСТАВЛЕНИЕ(DMS_ЗаявкаНаАвтомобиль.Клиент.ВидКонтрагента),
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.ДатаРождения,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент.ИНН,
	|	ПРЕДСТАВЛЕНИЕ(DMS_ЗаявкаНаАвтомобиль.Клиент.ФормаСобственности),
	|	DMS_ЗаявкаНаАвтомобиль.Модель.Наименование,
	|	DMS_ЗаявкаНаАвтомобиль.ВариантСалона.Наименование,
	|	DMS_ЗаявкаНаАвтомобиль.Версия.Наименование,
	|	DMS_ЗаявкаНаАвтомобиль.Версия.НаименованиеПолное,
	|	КонтактнаяИнформация.Представление КАК КлиентЕмаил,
	|	DMS_ЗаявкаНаАвтомобиль.Клиент,
	|	ПРЕДСТАВЛЕНИЕ(DMS_ЗаявкаНаАвтомобиль.Клиент.Пол) КАК КлиентПол,
	|	ПодтверждающиеДокументы.Серия КАК ПаспортСерия,
	|	ПодтверждающиеДокументы.Номер КАК ПаспортНомер,
	|	ПодтверждающиеДокументы.ДатаВыдачи КАК ПаспортДатаВыдачи,
	|	DMS_ЗаявкаНаАвтомобиль.ДилерскийЦентр,
	|	DMS_ЗаявкаНаАвтомобиль.ЦентрализованныйКонтракт,
	|	DMS_ЗаявкаНаАвтомобиль.РегистрируемВКорпПортале
	|ИЗ
	|	Врем КАК Врем
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.DMS_ЗаявкаНаАвтомобиль КАК DMS_ЗаявкаНаАвтомобиль
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|			ПО DMS_ЗаявкаНаАвтомобиль.Клиент = КонтактнаяИнформация.Объект
	|				И (КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА)
	|				И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК АдресКлиентаОсновной
	|			ПО (DMS_ЗаявкаНаАвтомобиль.Клиент = КонтактнаяИнформация.Объект)
	|				И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|				И (КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА)
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				КонтактнаяИнформация.Объект КАК Объект,
	|				МАКСИМУМ(КонтактнаяИнформация.Представление) КАК Представление
	|			ИЗ
	|				РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|			ГДЕ
	|				КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Объект В (ВЫБРАТЬ
    |                          	Врем.Ссылка.Клиент
    |                          ИЗ
    |                          	Врем КАК Врем)
	|			
	|			СГРУППИРОВАТЬ ПО
	|				КонтактнаяИнформация.Объект) КАК АдресКлиента
	|			ПО DMS_ЗаявкаНаАвтомобиль.Клиент = АдресКлиента.Объект
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|			ПО DMS_ЗаявкаНаАвтомобиль.Клиент = ПодтверждающиеДокументы.Владелец
	|				И (ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт))
	|				И (ПодтверждающиеДокументы.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ПодтверждающиеДокументы.ДатаОкончания > &ТекущаяДата
	|					ИЛИ ПодтверждающиеДокументы.Текущий = ИСТИНА)
	|		ПО (DMS_ЗаявкаНаАвтомобиль.Ссылка = Врем.Ссылка)";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДанных);
	Запрос.УстановитьПараметр("BIR", BIR);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	ТаблицаРезультатыОбработки = Запрос.Выполнить().Выгрузить();

	
	Фабрика = ВебСервис.ФабрикаXDTO;
	
	ТаблицаРезультатыОбработки.Колонки.Добавить("UID", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UID", 40);
	ТаблицаРезультатыОбработки.Колонки.Добавить("КлиентUID", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UID", 40);
	ТаблицаРезультатыОбработки.Колонки.Добавить("Пользователь");
	ТаблицаРезультатыОбработки.Колонки.Добавить("ДЦUID", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)), "UID", 40);
	ТаблицаРезультатыОбработки.Колонки.Добавить("ДилерскийЦентрНаименование");
	ТаблицаРезультатыОбработки.Колонки.Добавить("ДилерскийЦентрBIR");

	// КовалевЕС от 31.01.20 {
	// Добавлено для переноса параметров расчета минимальной даты поставки
	// Сделано не через запрос, т.к. он по ни понятным причинам не открывается в консоли.	
	ТаблицаРезультатыОбработки.Колонки.Добавить("ДатаОтсчета",     Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаРезультатыОбработки.Колонки.Добавить("НазваниеДаты",    Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(150)));
	ТаблицаРезультатыОбработки.Колонки.Добавить("СрокДоставки",    Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	ТаблицаРезультатыОбработки.Колонки.Добавить("СрокНаСкладе",    Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	ТаблицаРезультатыОбработки.Колонки.Добавить("СрокПодготовки",  Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)));
	ТаблицаРезультатыОбработки.Колонки.Добавить("ОписаниеРасчета", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(200)));
	ТаблицаРезультатыОбработки.Колонки.Добавить("МинимальнаяДатаПоставки", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаРезультатыОбработки.Колонки.Добавить("ЛокальноВДМС",    Новый ОписаниеТипов("Булево"));
	// КовалевЕС от 31.01.20 } 
	
	Для Каждого СтрокаТЗ ИЗ ТаблицаРезультатыОбработки Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Ссылка) Тогда
			СтрокаТЗ.UID = Строка(СтрокаТЗ.Ссылка.УникальныйИдентификатор());
		КонецЕсли; 

		Если ЗначениеЗаполнено(СтрокаТЗ.ДилерскийЦентр) Тогда
			СтрокаТЗ.ДЦUID = Строка(СтрокаТЗ.ДилерскийЦентр.УникальныйИдентификатор());
			СтрокаТЗ.ДилерскийЦентрНаименование =  СтрокаТЗ.ДилерскийЦентр.Наименование;
			СтрокаТЗ.ДилерскийЦентрBIR = СтрокаТЗ.ДилерскийЦентр.BIR;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТЗ.Клиент) Тогда
			СтрокаТЗ.КлиентUID = Строка(СтрокаТЗ.Клиент.УникальныйИдентификатор());
		КонецЕсли;
		СтрокаТЗ.Пользователь = ВебСервис.Пользователь;
		
		// КовалевЕС от 31.01.20 {
		// Добавлено для переноса параметров расчета минимальной даты поставки
		// Сделано не через запрос, т.к. он по ни понятным причинам не открывается в консоли.
		Если ЗначениеЗаполнено(СтрокаТЗ.Ссылка) Тогда
			ПараметрыРасчета = РегистрыСведений.DMS_АрхивРасчетовМинДатыПоставки.ПолучитьПараметрыРасчетаМинДатыПоставки(СтрокаТЗ.Ссылка, СтрокаТЗ.VIN);
			
			Если ПараметрыРасчета <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТЗ, ПараметрыРасчета,, "VIN");
			КонецЕсли;
 		КонецЕсли;
		// КовалевЕС от 31.01.20 } 
	КонецЦикла;
	
	ТаблицаРезультатыОбработки.Колонки.Удалить("Ссылка");
	ТаблицаРезультатыОбработки.Колонки.Удалить("Клиент");
	ТаблицаРезультатыОбработки.Колонки.Удалить("ДилерскийЦентр");
	
	Сериализатор = Новый СериализаторXDTO(Фабрика);
	Результат = Сериализатор.ЗаписатьXDTO(ТаблицаРезультатыОбработки);
	ДанныеОтправлены = ВебСервис.SetData("SetOrderOnAuto", Результат, Server);
	
	Если ДанныеОтправлены = Истина Тогда
		Для Каждого КлючевыеПоля из ТаблицаДанных Цикл
			ПланыОбмена.УдалитьРегистрациюИзменений(ПланОбмена, КлючевыеПоля.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьАдресаДоставки (Параметр1 = Неопределено) Экспорт
	
	Попытка 
		
		Сервер = СтрокаСоединенияИнформационнойБазы();
		ВебСервис = ПолучитьПрокси();
		ВыборкаДилеров = Справочники.CRM_ДилерскиеЦентры.Выбрать();
		
		Пока ВыборкаДилеров.Следующий() Цикл
			
			ПакетXDTO = ВебСервис.GetAdressOnShip(Лев(ВыборкаДилеров.BIR,8),Сервер);
			ТаблицаДанных = СериализаторXDTO.ПрочитатьXDTO(ПакетXDTO);
			Если ТаблицаДанных.Количество() > 0 Тогда
				Набор = РегистрыСведений.DMS_АдресаРазгрузкиДилеров.СоздатьНаборЗаписей();
				Набор.Отбор.BIR.Установить(Лев(ВыборкаДилеров.BIR,8));
				Набор.Загрузить(ТаблицаДанных);
				Набор.Записать();
			КонецЕсли;
		КонецЦикла;
		РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
		ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ЗагрузитьАдресаДоставки"),
		ТекущаяДатаСеанса());
	Исключение
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьСпрПричинНеВозможностиВыдачи () Экспорт 
	
	Попытка 
		
		Сервер = СтрокаСоединенияИнформационнойБазы();
		ВебСервис = ПолучитьПрокси();
			
			ПакетXDTO = ВебСервис.GetDicshNotIssuing();
			ТаблицаДанных = СериализаторXDTO.ПрочитатьXDTO(ПакетXDTO);
			Для Каждого СтрТЗ из ТаблицаДанных Цикл 
				
				СпрПричин = Справочники.Renault_ПричиныНеВыдачи.НайтиПоРеквизиту("ЦентралныйКод", СтрТЗ.UID);
				Если СпрПричин = Справочники.Renault_ПричиныНеВыдачи.ПустаяСсылка() Тогда
					СпрОбъект = Справочники.Renault_ПричиныНеВыдачи.СоздатьЭлемент();
					СпрОбъект.ЦентралныйКод = СтрТЗ.UID;
					СпрОбъект.УстановитьНовыйКод();
				Иначе
					СпрОбъект = СпрПричин.ПолучитьОбъект();
				КонецЕсли;

				СпрОбъект.Активный = СтрТЗ.Активный;
				СпрОбъект.Наименование = СтрТЗ.Наименование;
				СпрОбъект.Длительность = СтрТЗ.ДниНаУстранения;
				СпрОбъект.Записать();
			КонецЦикла;
		Исключение
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьДанныеПлатногоХранения () Экспорт
	
	ДатаАкуальности = Константы.Renault_ДатаАктуальностиДанныхПлатногоХраненияАвто.Получить();
	
	ВебСервер = ПолучитьПрокси ();
	МассивБир = Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.ПолучитьМассивБирДляПолученияДанных();
	ТЗXDTO = ВебСервер.GetPayVins (СериализаторXDTO.ЗаписатьXDTO(МассивБир), ДатаАкуальности);
	
	ТЗДанных = СериализаторXDTO.ПрочитатьXDTO(ТЗXDTO);
		
	Для Каждого СтрТЗ из ТЗДанных Цикл
		
		МенеджерЗаписей = РегистрыСведений.Renault_ПлатноеХранениеАвтоНаСкладе.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписей, СтрТЗ);
		МенеджерЗаписей.Записать();	
		
	КонецЦикла;
	
	Константы.Renault_ДатаАктуальностиДанныхПлатногоХраненияАвто.Установить(НачалоДня(ТекущаяДата()));
КонецПроцедуры
//+++ DMS

Процедура ЗагрузкаСообщенийОбмена() Экспорт
	
	Попытка 
		
		Сервер = СтрокаСоединенияИнформационнойБазы();
		ВебСервис = ПолучитьПроксиСОтбором();
		ВыборкаДилеров = Справочники.CRM_ДилерскиеЦентры.Выбрать();
		
		Пока ВыборкаДилеров.Следующий() Цикл
			
			//Получим номера документов "Заявка на автомобиль" для получения с портала
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CRM_СобытияПоРабочимЛистамАвтомобилиДляВыдачи.VIN
			               |ПОМЕСТИТЬ втВыдачи
			               |ИЗ
			               |	Документ.CRM_СобытияПоРабочимЛистам.АвтомобилиДляВыдачи КАК CRM_СобытияПоРабочимЛистамАвтомобилиДляВыдачи
			               |ГДЕ
			               |	CRM_СобытияПоРабочимЛистамАвтомобилиДляВыдачи.Ссылка.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.Выдача)
			               |	И CRM_СобытияПоРабочимЛистамАвтомобилиДляВыдачи.Ссылка.ЗавершеноУспешно = ИСТИНА
			               |	И CRM_СобытияПоРабочимЛистамАвтомобилиДляВыдачи.Ссылка.ПометкаУдаления = ЛОЖЬ
			               |	И CRM_СобытияПоРабочимЛистамАвтомобилиДляВыдачи.Ссылка.Дата >= ДАТАВРЕМЯ(2019, 1, 1)
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	DMS_ЗаявкаНаАвтомобиль.Номер
			               |ИЗ
			               |	Документ.DMS_ЗаявкаНаАвтомобиль КАК DMS_ЗаявкаНаАвтомобиль
			               |ГДЕ
			               |	DMS_ЗаявкаНаАвтомобиль.BIR ПОДОБНО ""%"" + &BIR + ""%""
			               |	И DMS_ЗаявкаНаАвтомобиль.Дата >= ДАТАВРЕМЯ(2019, 1, 1)
			               |	И НЕ DMS_ЗаявкаНаАвтомобиль.VIN В
			               |				(ВЫБРАТЬ
			               |					втВыдачи.VIN
			               |				ИЗ
			               |					втВыдачи КАК втВыдачи)";
			Запрос.УстановитьПараметр("BIR", Лев(ВыборкаДилеров.BIR,8));
			НомераДокументов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номер");
			
			НомераДокументовДляОтправки = СериализаторXDTO.ЗаписатьXDTO(НомераДокументов);
			
			ПакетXDTO = ВебСервис.GetDataFromPortalToDealer(Лев(ВыборкаДилеров.BIR,8),Сервер, НомераДокументовДляОтправки);
			//ПакетXDTO = ВебСервис.GetDataFromPortalToDealer(Лев(ВыборкаДилеров.BIR,8),Сервер);
			ТаблицаДанных = СериализаторXDTO.ПрочитатьXDTO(ПакетXDTO);
			Если ТаблицаДанных.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			МассивОбработанных = Новый Массив;
			Для Каждого СтрокаЗаявки из ТаблицаДанных Цикл
				UpdateOrderOnAuto (СтрокаЗаявки);
				МассивОбработанных.Добавить(СтрокаЗаявки.DPUID);
			КонецЦикла;
			
			МассивОбработанных = СериализаторXDTO.ЗаписатьXDTO(МассивОбработанных);
			
			ВебСервис.ConfirmProcessingOrder(МассивОбработанных);
		КонецЦикла;
	Исключение 
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
		"Загрузка сообщений обмена",
		УровеньЖурналаРегистрации.Ошибка,Метаданные.РегламентныеЗадания.DMS_ОбменДаннымиСДилерскимПорталом,,
		ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;


КонецПроцедуры

Процедура ОбработатьОдноСообщение(ДанныеСообщения)
	
	ДвоичныеДанныеФайла = ДанныеСообщения.Данные.Получить();
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	ЧтениеXML.Прочитать();
	ЧтениеXML.Прочитать(); // пропуск тэга Message
	Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		ТипXDTO = ФабрикаXDTO.Тип(ДанныеСообщения.ПространствоИменДанных, ЧтениеXML.Имя);
		ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
		СтрокаДляВыполнения = ДанныеСообщения.ИмяКомандыОбработки + "(ОбъектXDTO);";
		Выполнить(СтрокаДляВыполнения);
	КонецЦикла;
	ЧтениеXML.Закрыть();
	УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

//обновление заявки на автомобиль 
Процедура UpdateOrderOnAuto(СтрЗаявки)
	
	//Закометим по заявке DMSREN-861
	// НАЧАЛО DMSCOR-1678 13.02.2020
	//Если ЗначениеЗаполнено(СтрЗаявки.eshopid) тогда
	//	ЗаписьЖурналаРегистрации("Загрузка и обновление заявок на автомобиль с дилерского портала",УровеньЖурналаРегистрации.Ошибка,,,"Заявки из Онлайн Щоурум не создаются в базе: " + СтрЗаявки.eshopid);
	//	Возврат;
	//КонецЕсли;
	// КОНЕЦ DMSCOR-1678 13.02.2020
	
	Если ЗначениеЗаполнено(СтрЗаявки.UID) тогда
		Заявка = Документы.DMS_ЗаявкаНаАвтомобиль.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗаявки.UID)).ПолучитьОбъект();
		Если Заявка <> Неопределено тогда 
			//обновим заявку
			ОбновитьЗаявку(Заявка,СтрЗаявки);
		Иначе 
			//если заявка не найдена по УИД	
			ЗаписьЖурналаРегистрации("Загрузка и обновление заявок на автомобиль с дилерского портала",УровеньЖурналаРегистрации.Ошибка,,,"Не найдена заявка на автомобиль по ГУИД: " + СтрЗаявки.UID);
		КонецЕсли;		
	Иначе//если УИД дилера на заполнен - заявка изначально создана на портале.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_ЗаявкаНаАвтомобиль.Ссылка
		|ИЗ
		|	Документ.DMS_ЗаявкаНаАвтомобиль КАК DMS_ЗаявкаНаАвтомобиль
		|ГДЕ
		|	DMS_ЗаявкаНаАвтомобиль.UID = &UID";
		
		Запрос.УстановитьПараметр("UID", СтрЗаявки.DPUID);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Заявка = Выборка.Ссылка.ПолучитьОбъект();	
			ОбновитьЗаявку(Заявка,СтрЗаявки);
		Иначе
			//Автомобиль = Справочники.Автомобили.НайтиПоРеквизиту("VIN",СтрЗаявки.VIN);
			//Если ЗначениеЗаполнено(Автомобиль) тогда //загружаем заявку только если найден автомобиль по VIN.
				Заявка = Документы.DMS_ЗаявкаНаАвтомобиль.СоздатьДокумент();
				ОбновитьЗаявку(Заявка,СтрЗаявки);
			//КонецЕсли;
		КонецЕсли;;
	КонецЕсли;
	
КонецПроцедуры	

//загрузка заявки на отгрузку 
Процедура SetOrderOnShip(ОбъектXDTO)
	
	ТаблицаЗаявок = СериализаторXDTO.ПрочитатьXDTO(ОбъектXDTO);
	
	Для каждого СтрЗаявки из ТаблицаЗаявок Цикл
		ЗаявкаСсылка = Документы.DMS_ЗаявкаНаОтгрузку.НайтиПоРеквизиту("VIN", СтрЗаявки.VIN);
		Если ЗаявкаСсылка = Документы.DMS_ЗаявкаНаОтгрузку.ПустаяСсылка() Тогда
			Заявка 	= Документы.DMS_ЗаявкаНаОтгрузку.СоздатьДокумент();
		Иначе
			Заявка = ЗаявкаСсылка.ПолучитьОбъект();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Заявка,СтрЗаявки,,"Номер");
		Заявка.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
		Заявка.ОбменДанными.Загрузка = Истина;
		Заявка.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура SetAdressOnShip(ОбъектXDTO)
	
	ТаблицаАдресов = СериализаторXDTO.ПрочитатьXDTO(ОбъектXDTO);
	Для каждого СтрТаб из ТаблицаАдресов Цикл
		Запись = РегистрыСведений.DMS_АдресаРазгрузкиДилеров.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись,СтрТаб);
		Запись.Записать();
	КонецЦикла;
	
КонецПроцедуры	

Процедура ОбновитьЗаявку(Заявка,СтрЗаявки)
	
		ЦветСалона = Справочники.DMS_ЦветаСалона.НайтиПоРеквизиту("Артикул",СтрЗаявки.ЦветСалонаАртикул);
		Если ЦветСалона = Справочники.DMS_ЦветаСалона.ПустаяСсылка() и ЗначениеЗаполнено(СтрЗаявки.ЦветСалонаАртикул) тогда
			НовыйЦветСалона = Справочники.DMS_ЦветаСалона.СоздатьЭлемент();
			НовыйЦветСалона.Артикул = СтрЗаявки.ЦветСалонаАртикул;
			НовыйЦветСалона.Наименование = СтрЗаявки.ЦветСалонаАртикул;
			НовыйЦветСалона.Записать();
			ЦветСалона = НовыйЦветСалона.Ссылка;
		КонецЕсли;
		
		Цвет = Справочники.Цвета.НайтиПоРеквизиту("Артикул",СтрЗаявки.ЦветАртикул);
		Если Цвет = Справочники.Цвета.ПустаяСсылка() и ЗначениеЗаполнено(СтрЗаявки.ЦветНаименование) тогда
				НовыйЦвет = Справочники.Цвета.СоздатьЭлемент();
				НовыйЦвет.Артикул = СтрЗаявки.ЦветАртикул;
				НовыйЦвет.Наименование = СтрЗаявки.ЦветНаименование;
				НовыйЦвет.Записать();
				Цвет = НовыйЦвет.Ссылка;
		КонецЕсли;
		
		Модель = Справочники.Модели.НайтиПоРеквизиту("Артикул",СтрЗаявки.МодельАртикул);
		Если Модель = Справочники.Модели.ПустаяСсылка()  и ЗначениеЗаполнено(СтрЗаявки.МодельНаименование)тогда
			НоваяМодель = Справочники.Модели.СоздатьЭлемент();
			НоваяМодель.Артикул = СтрЗаявки.МодельАртикул;
			НоваяМодель.Наименование = СтрЗаявки.МодельНаименование;
			НоваяМодель.ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
			НоваяМодель.Записать();
			Модель = НоваяМодель.Ссылка;
		КонецЕсли;
		
		ВариантКомплектации = Справочники.ВариантыКомплектации.НайтиПоРеквизиту("Артикул",СтрЗаявки.ВерсияАртикул,,Модель);  // DMSREN-785
		Если ВариантКомплектации = Справочники.ВариантыКомплектации.ПустаяСсылка() и ЗначениеЗаполнено(СтрЗаявки.ВерсияНаименование)тогда
			НовыйВариант = Справочники.ВариантыКомплектации.СоздатьЭлемент();
			НовыйВариант.Артикул = СтрЗаявки.ВерсияАртикул;
			НовыйВариант.Наименование = СтрЗаявки.ВерсияНаименование;
			НовыйВариант.НаименованиеПолное = СтрЗаявки.ВерсияНаименованиеПолное;
			НовыйВариант.Владелец = Модель;
			НовыйВариант.ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
			НовыйВариант.Записать();
			ВариантКомплектации = НовыйВариант.Ссылка;
		КонецЕсли;
		
		ВариантСалона = Справочники.DMS_ВариантыСалона.НайтиПоРеквизиту("Артикул",СтрЗаявки.ВариантСалонаАртикул);
		Если ВариантСалона = Справочники.DMS_ВариантыСалона.ПустаяСсылка() и ЗначениеЗаполнено(СтрЗаявки.ВариантСалонаНаименование) тогда
			НовыйВариант = Справочники.DMS_ВариантыСалона.СоздатьЭлемент();
			НовыйВариант.Артикул = СтрЗаявки.ВариантСалонаАртикул;
			НовыйВариант.Наименование = СтрЗаявки.ВариантСалонаНаименование;
			НовыйВариант.Записать();
			ВариантыСалона = НовыйВариант.Ссылка;
		КонецЕсли;
				
		ЗаполнитьЗначенияСвойств(Заявка,СтрЗаявки,,"Номер");
		Заявка.НомерDMS  =  СтрЗаявки.Номер;
		Заявка.UID = СтрЗаявки.DPUID;
		Заявка.Модель = Модель;
		Заявка.Цвет = Цвет;
		Заявка.ЦветСалона = ЦветСалона;
		Заявка.Версия = ВариантКомплектации;
		Заявка.ВариантСалона = ВариантСалона;
		Заявка.КоммерческаяАкция1 = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду(СтрЗаявки.КоммерческаяАкция1Код);
		Заявка.КоммерческаяАкция2 = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду(СтрЗаявки.КоммерческаяАкция2Код);
		Заявка.КоммерческаяАкция3 = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду(СтрЗаявки.КоммерческаяАкция3Код);
		Заявка.КоммерческаяАкция4 = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду(СтрЗаявки.КоммерческаяАкция4Код);
		Заявка.КоммерческаяАкция5 = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду(СтрЗаявки.КоммерческаяАкция5Код);
		Заявка.ТипЗаявки = Справочники.DMS_ТипыЗаявки.НайтиПоНаименованию(СтрЗаявки.ТипЗаявки);
		
		Если НЕ ЗначениеЗаполнено(Заявка.Клиент) Тогда
			Заявка.Клиент = СоздатьОбновитьКлиента(СтрЗаявки);
		КонецЕсли;
		
		// НАЧАЛО DMSCOR-1601 18.12.2019
		Если НЕ ЗначениеЗаполнено(Заявка.Клиент) Тогда
			ЗаписьЖурналаРегистрации(
			"Загрузка сообщений обмена",
			УровеньЖурналаРегистрации.Ошибка,Метаданные.РегламентныеЗадания.DMS_ОбменДаннымиСДилерскимПорталом,,
			"Нет данных по клиенту в заявке на автомобиль по VIN " + СтрЗаявки.VIN + Символы.ПС + "Данные по заявке не были обновлены. Проверьте данные на дилерском портале");
			Возврат;
		КонецЕсли;
		// КОНЕЦ DMSCOR-1601 18.12.2019
		
		Заявка.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;  // не регистрируем для обмена.
		
		Если Заявка.Аннулирована ИЛИ СтрЗаявки.УдаленнаяЗапись ИЛИ Заявка.ПометкаУдаления Тогда
			Заявка.ПометкаУдаления = Истина;
			Заявка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Иначе
			Заявка.ПометкаУдаления = Ложь; //DMSCOR-1601
			Заявка.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
КонецПроцедуры

Функция СоздатьОбновитьКлиента(СтрЗаявки)
	
	ГруппаКлиентовДП = Справочники.Контрагенты.НайтиПоНаименованию("Клиенты с Дилерского портала",Истина);
	Если НЕ ЗначениеЗаполнено(ГруппаКлиентовДП) Тогда
		НовГруппа = Справочники.Контрагенты.СоздатьГруппу();
		НовГруппа.Наименование = "Клиенты с Дилерского портала";
		НовГруппа.Записать();
		ГруппаКлиентовДП = НовГруппа.Ссылка;
	КонецЕсли;
		
	//пропробуем найти клиента по договору купли-продажи
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ДоговорСоставДоговора.Ссылка.КлиентДоговора КАК Клиент
		|ИЗ
		|	Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
		|ГДЕ
		|	Renault_ДоговорСоставДоговора.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN", СтрЗаявки.VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Клиент;
	КонецЕсли;
	
	//пропробуем найти клиента по ИНН/ФИО
	Если СтрЗаявки.КлиентФормаСобственностиПредставление = "Юридическое лицо" Тогда
		ВидКлиента = Перечисления.ФормыСобственности.ЮридическоеЛицо;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Клиент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН";
		
		Запрос.УстановитьПараметр("ИНН",СтрЗаявки.КлиентИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Клиент;
		КонецЕсли;
	Иначе
		ВидКлиента = Перечисления.ФормыСобственности.ЧастноеЛицо;	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Клиент
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Фамилия = &Фамилия
		|	И Контрагенты.Имя = &Имя
		|	И Контрагенты.Отчество = &Отчество";
		
		Запрос.УстановитьПараметр("Фамилия",СтрЗаявки.КлиентФамилия);
		Запрос.УстановитьПараметр("Имя",СтрЗаявки.КлиентИмя);
		Запрос.УстановитьПараметр("Отчество",СтрЗаявки.КлиентОтчество);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Клиент;
		ИначеЕсли ЗначениеЗаполнено(СтрЗаявки.КлиентТелефон) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КонтактнаяИнформация.Объект
			|ИЗ
			|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
			|	И КонтактнаяИнформация.Представление = &Телефон
			|	И ТИПЗНАЧЕНИЯ(КонтактнаяИнформация.Объект) = ТИП(Справочник.Контрагенты)";
			
			Запрос.УстановитьПараметр("Телефон", СтрЗаявки.КлиентТелефон);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Объект;	
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	
	
	// НАЧАЛО DMSCOR-1601 18.12.2019
	Если НЕ ЗначениеЗаполнено(СтрЗаявки.КлиентНаименование) И НЕ ЗначениеЗаполнено(СтрЗаявки.КлиентНаименованиеПолное) И НЕ ЗначениеЗаполнено(СтрЗаявки.КлиентИНН)
		И НЕ ЗначениеЗаполнено(СтрЗаявки.КлиентФамилия) И НЕ ЗначениеЗаполнено(СтрЗаявки.КлиентИмя) И НЕ ЗначениеЗаполнено(СтрЗаявки.КлиентОтчество) Тогда
			
		Возврат Справочники.Контрагенты.ПустаяСсылка();
		
	КонецЕсли;
	// КОНЕЦ DMSCOR-1601 18.12.2019
	
	КлиентФамилия = ОпределитьТолькоФамилию(СтрЗаявки.КлиентФамилия);
	
	КлиентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КлиентОбъект.Родитель = ГруппаКлиентовДП;
	КлиентОбъект.ИНН = СтрЗаявки.КлиентИНН;
	КлиентОбъект.Наименование = СокрЛП(КлиентФамилия) + " " + СокрЛП(СтрЗаявки.КлиентИмя) + " " + СокрЛП(СтрЗаявки.КлиентОтчество); //DMSREN-447 //СтрЗаявки.КлиентНаименование;
	КлиентОбъект.НаименованиеПолное = 
		?(ЗначениеЗаполнено(СтрЗаявки.КлиентНаименованиеПолное),
			СтрЗаявки.КлиентНаименованиеПолное,
			СтрЗаявки.КлиентНаименование);
	КлиентОбъект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Спрашивать;
	КлиентОбъект.Фамилия = СокрЛП(КлиентФамилия);
	КлиентОбъект.Имя = СокрЛП(СтрЗаявки.КлиентИмя);
	КлиентОбъект.Отчество = СокрЛП(СтрЗаявки.КлиентОтчество);
	КлиентОбъект.ФормаСобственности = ВидКлиента;
	КлиентОбъект.УстановитьНовыйКод();
	
	Если СтрЗаявки.КлиентПол = "Мужской" тогда
		КлиентОбъект.Пол = Перечисления.ПолФизическихЛиц.Мужской;
	ИначеЕсли СтрЗаявки.КлиентПол = "Женский" тогда
		КлиентОбъект.Пол = Перечисления.ПолФизическихЛиц.Женский;	
	Иначе
		КлиентОбъект.Пол = Перечисления.ПолФизическихЛиц.НеУказан;
	КонецЕсли;
	КлиентОбъект.ДатаРождения = СтрЗаявки.КлиентДатаРождения;
	
	КлиентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
	
	КлиентОбъект.Записать();
	
	Клиент = КлиентОбъект.Ссылка;
	
	Попытка
		ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.НайтиПоРеквизиту("BIR", СтрЗаявки.BIR);
	Исключение
		ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка();
	КонецПопытки;
	
	//запишем контактную информацию
	Если Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		Если ЗначениеЗаполнено(СтрЗаявки.КлиентАдрес) Тогда
			Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресФактический;
			Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
			Запись.Объект = Клиент;
			Запись.Представление = СтрЗаявки.КлиентАдрес;
			Запись.Записать();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрЗаявки.КлиентТелефон) Тогда
			Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
			Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Запись.Объект = Клиент;
			Запись.Представление = СтрЗаявки.КлиентТелефон;
			
			// Крайнев МА [DMSCOR-972] 09.01.2018 +++
			СтруктураТелефона = Renault_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруТелефонаПоПолям(Запись.Представление, ДилерскийЦентр);

			Если Не ЗначениеЗаполнено(Запись.Поле1) Тогда								
				Запись.Поле1 = СтруктураТелефона.Поле1
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Запись.Поле2) Тогда
				Запись.Поле2 = СтруктураТелефона.Поле2;
				Запись.Поле3 = СтруктураТелефона.Поле3;
			КонецЕсли;
			// Крайнев МА ---
			
			Запись.Записать();
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(СтрЗаявки.КлиентАдрес) Тогда
			Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЮридический;
			Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
			Запись.Объект = Клиент;
			Запись.Представление = СтрЗаявки.КлиентАдрес;
			Запись.Записать();
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрЗаявки.КлиентТелефон) Тогда
			Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий;
			Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Запись.Объект = Клиент;
			Запись.Представление = СтрЗаявки.КлиентТелефон;
			
			// Крайнев МА [DMSCOR-972] 09.01.2018 +++
			СтруктураТелефона = Renault_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруТелефонаПоПолям(Запись.Представление, ДилерскийЦентр);

			Если Не ЗначениеЗаполнено(Запись.Поле1) Тогда								
				Запись.Поле1 = СтруктураТелефона.Поле1
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Запись.Поле2) Тогда
				Запись.Поле2 = СтруктураТелефона.Поле2;
				Запись.Поле3 = СтруктураТелефона.Поле3;
			КонецЕсли;
			// Крайнев МА ---
			
			Запись.Записать();
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрЗаявки.КлиентEmail) Тогда
		Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий;
		Запись.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		Запись.Объект = Клиент;
		Запись.Представление = СтрЗаявки.КлиентEmail;
		Запись.Записать();
	КонецЕсли;
	
	Возврат Клиент;
	
КонецФункции

Функция ВернутьСписокДоступныхКоммерческихАкций(VIN) Экспорт
	Попытка 
		СписокАкций = Новый СписокЗначений;
		ВебСервис = ПолучитьПрокси();
		ТаблицаРезультат = СериализаторXDTO.ПрочитатьXDTO(ВебСервис.GetCommCampagin(VIN));
		
		Для каждого Стр из ТаблицаРезультат Цикл
			Акция = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду(Стр.Код);
			Если Акция = Справочники.DMS_КоммерческиеАкции.ПустаяСсылка() тогда
				НовЭл = Справочники.DMS_КоммерческиеАкции.СоздатьЭлемент();
				ЗаполнитьЗначенияСвойств(НовЭл,Стр);
				НовЭл.Записать();
				Акция = НовЭл.Ссылка;
			КонецЕсли;			
			СписокАкций.Добавить(Акция);
		КонецЦикла;
		
		Акция = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду("0000");
		Если Акция = Справочники.DMS_КоммерческиеАкции.ПустаяСсылка() тогда
				НовЭл = Справочники.DMS_КоммерческиеАкции.СоздатьЭлемент();
				НовЭл.Код = "0000";
				НовЭл.Наименование = "Без коммерч. акции";
				НовЭл.Записать();
				Акция = НовЭл.Ссылка;
		КонецЕсли;	
			
		Если СписокАкций.НайтиПоЗначению(Акция) = Неопределено Тогда
			СписокАкций.Добавить(Акция);
		КонецЕсли;
		
	Исключение
		
		#Если Клиент Тогда	
			Сообщить("Не удалось получить список доступных коммерческий акции для VIN. " + ОписаниеОшибки()); 
		#Иначе
			ТекстОшибки = "При получении данных для VIN "+ VIN +  " возникла ошибка: "+ ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("Ошибка получения доступных коммерческий акции",УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки); 	
		#КонецЕсли
	КонецПопытки;
	Возврат СписокАкций;
КонецФункции

