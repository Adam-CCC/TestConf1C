		Подразделение = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000247"); // Транзит ООО Рассвет
		ЛогинОператора = "??????????";
		ЛогинИПГ = "??????????";
	Иначе
		Возврат;
