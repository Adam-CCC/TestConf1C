// Воронка продаж для CRM АвтоВАЗ

Процедура ОтправитьТрафикДляАвтоВАЗ()
	ТекущаяДата = ТекущаяДата();
	ТекущаяДатаСтрокой = Формат(ТекущаяДата, "ДЛФ=Д");
	
	ЭлПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();	 
	АдресЭлПочты = "IN1@pss.vaz.ru";
	СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
	СтрокаПолучатели.АдресЭлектроннойПочты = АдресЭлПочты;
	СтрокаПолучатели.Представление = АдресЭлПочты;
	СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
    ЭлПисьмо.ПолучателиПредставление = АдресЭлПочты;
	
	ЭлПисьмо.Тема = "Трафик по ООО Транзит на " + Формат(ТекущаяДата, "ДЛФ=ДД");
	ЭлПисьмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.Альфа;	
	ЭлПисьмо.ОтправительПредставление = "Альфа-Авто <" + ЭлПисьмо.УчетнаяЗапись.АдресЭлектроннойПочты + ">";
	ЭлПисьмо.Организация =   ПараметрыСеанса.Пользователь.Организация;
	ЭлПисьмо.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;
	ЭлПисьмо.Автор   = ПараметрыСеанса.Пользователь;	
	ЭлПисьмо.ГруппаПисем = Справочники.ГруппыПисемЭлектроннойПочты.НайтиПоНаименованию("Исходящие");
	ЭлПисьмо.Важность = Перечисления.Важность.Средняя;
	ЭлПисьмо.ДатаОтправления = ТекущаяДата;
	ЭлПисьмо.Дата = ТекущаяДата;
	ЭлПисьмо.ХозОперация = Справочники.ХозОперации.ЭлектронноеПисьмо;
	ЭлПисьмо.ФорматТекста = Перечисления.ФорматТекста.ПростойТекст;
	
	Организация = Справочники.Организации.НайтиПоКоду("ЦБ000014"); // ООО Транзит
	ГруппаМоделей = Справочники.Модели.НайтиПоКоду("ЦБ00004134"); // ВАЗ(Lada)
	Если обЗначениеНеЗаполнено(Организация) Или обЗначениеНеЗаполнено(ГруппаМоделей) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ТекущаяДата));			   
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата));			   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ГруппаМоделей", ГруппаМоделей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК СпособОбращения,
	               |	РегистрацияЗвонковИКонтактов.Подразделение КАК Подразделение,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 9
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с9до10,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 10
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с10до11,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 11
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с11до12,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 12
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с12до13,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 13
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с13до14,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 14
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с14до15,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 15
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с15до16,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 16
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с16до17,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 17
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с17до18,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 18
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с18до19,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 19
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с19до20,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЧАС(РегистрацияЗвонковИКонтактов.ДатаВремя) = 20
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК с20до21
	               |ИЗ
	               |	РегистрСведений.РегистрацияЗвонковИКонтактов КАК РегистрацияЗвонковИКонтактов
	               |ГДЕ
	               |	РегистрацияЗвонковИКонтактов.ДатаДень МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И РегистрацияЗвонковИКонтактов.Организация = &Организация
	               |	И РегистрацияЗвонковИКонтактов.Модель В ИЕРАРХИИ(&ГруппаМоделей)
	               |	И (РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
	               |			ИЛИ РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ,
	               |	РегистрацияЗвонковИКонтактов.Подразделение";
				   
	Трафик = Запрос.Выполнить().Выгрузить();
	ЗаголовокСтроки = СокрЛП(Организация.ИНН) + ";" + СокрЛП(Организация.Наименование);
	ВолгодонскЛада = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000189");
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();   
	Запись = Новый ЗаписьТекста(ИмяВременногоФайла, "windows-1251");
	Для Каждого СтрокаТрафика Из Трафик Цикл
		НомерФилиала = "0";
		Если ЗначениеЗаполнено(ВолгодонскЛада) 
			И (СтрокаТрафика.Подразделение = ВолгодонскЛада Или СтрокаТрафика.Подразделение.ПринадлежитЭлементу(ВолгодонскЛада)) Тогда
			НомерФилиала = "1";
		КонецЕсли;
		СтрокаФайла = ЗаголовокСтроки + ";" + НомерФилиала;
		СтрокаФайла = СтрокаФайла + ";" + ТекущаяДатаСтрокой;
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.СпособОбращения);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с9до10);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с10до11);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с11до12);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с12до13);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с13до14);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с14до15);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с15до16);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с16до17);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с17до18);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с18до19);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с19до20);
		СтрокаФайла = СтрокаФайла + ";" + Строка(СтрокаТрафика.с20до21);		
		Запись.ЗаписатьСтроку(СтрокаФайла);
	КонецЦикла;		
	Запись.Закрыть();
	
	ФайлВложение = ЭлПисьмо.ПрикрепленныеФайлы.Добавить();
	ДвДанныеВложения = Новый ДвоичныеДанные(ИмяВременногоФайла);	
	ФайлВложение.Файл = Новый ХранилищеЗначения(ДвДанныеВложения);
	ФайлВложение.Имя = "traffic.csv";
	ВременныйФайл = Новый Файл(ИмяВременногоФайла);
	ФайлВложение.Размер = ВременныйФайл.Размер();
	
	ЭлПисьмо.ЕстьВложения = Истина;
	ЭлПисьмо.Записать();
	УдалитьФайлы(ИмяВременногоФайла);	
	
	СтруктураРежимовОбмена = Новый Структура("Получить, Отправить", Ложь, Истина);
	СоединениеСПочтовымСервером = эпПодключитьсяКПочтовомуСерверу(ЭлПисьмо.УчетнаяЗапись, СтруктураРежимовОбмена);
	Если СоединениеСПочтовымСервером <> Неопределено Тогда
		Если Не эпОтправитьПисьмо(ЭлПисьмо.ЭтотОбъект, СоединениеСПочтовымСервером) Тогда
			//ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаАвтомобилиБУСтарыеЗапасы", 
			//        УровеньЖурналаРегистрации.Ошибка, , , "Не удалось отправить письмо!"); 
		КонецЕсли;	
		эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
	КонецЕсли;		
КонецПроцедуры

Процедура ОтправитьВоронкуДляАвтоВАЗ()
	ТекущаяДата = ТекущаяДата();
	ТекущаяДатаСтрокой = Формат(ТекущаяДата, "ДЛФ=Д");
	
	ЭлПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();	 
	АдресЭлПочты = "IN1@pss.vaz.ru";
	СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
	СтрокаПолучатели.АдресЭлектроннойПочты = АдресЭлПочты;
	СтрокаПолучатели.Представление = АдресЭлПочты;
	СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
    ЭлПисьмо.ПолучателиПредставление = АдресЭлПочты;
	
	ЭлПисьмо.Тема = "Воронка продаж по ООО Транзит на " + Формат(ТекущаяДата, "ДЛФ=ДД");
	ЭлПисьмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.Альфа;	
	ЭлПисьмо.ОтправительПредставление = "Альфа-Авто <" + ЭлПисьмо.УчетнаяЗапись.АдресЭлектроннойПочты + ">";
	ЭлПисьмо.Организация =   ПараметрыСеанса.Пользователь.Организация;
	ЭлПисьмо.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;
	ЭлПисьмо.Автор   = ПараметрыСеанса.Пользователь;	
	ЭлПисьмо.ГруппаПисем = Справочники.ГруппыПисемЭлектроннойПочты.НайтиПоНаименованию("Исходящие");
	ЭлПисьмо.Важность = Перечисления.Важность.Средняя;
	ЭлПисьмо.ДатаОтправления = ТекущаяДата;
	ЭлПисьмо.Дата = ТекущаяДата;
	ЭлПисьмо.ХозОперация = Справочники.ХозОперации.ЭлектронноеПисьмо;
	ЭлПисьмо.ФорматТекста = Перечисления.ФорматТекста.ПростойТекст;
	
	Организация = Справочники.Организации.НайтиПоКоду("ЦБ000014"); // ООО Транзит
	ГруппаМоделей = Справочники.Модели.НайтиПоКоду("ЦБ00004134"); // ВАЗ(Lada)
	Если обЗначениеНеЗаполнено(Организация) Или обЗначениеНеЗаполнено(ГруппаМоделей) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ТекущаяДата));			   
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата));			   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ГруппаМоделей", ГруппаМоделей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РегистрацияЗвонковИКонтактов.Подразделение КАК Подразделение,
	               |	РегистрацияЗвонковИКонтактов.Автор.Сотрудник.Наименование КАК Сотрудник,
	               |	РегистрацияЗвонковИКонтактов.Автор.Сотрудник.Должность.Наименование КАК Должность,
	               |	СУММА(ВЫБОР
	               |			КОГДА РегистрацияЗвонковИКонтактов.РабочийЛист ЕСТЬ NULL
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) КАК СозданоРабочихЛистов,
	               |	СУММА(ВЫБОР
	               |			КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК ЗарегистрированоЗвонков,
	               |	СУММА(ВЫБОР
	               |			КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
	               |					И РегистрацияЗвонковИКонтактов.ПредставлениеТелефона <> """"
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КонтактовСоЗвонков,
	               |	СУММА(ВЫБОР
	               |			КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК ЗарегистрированоВизитов,
	               |	СУММА(ВЫБОР
	               |			КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)
	               |					И РегистрацияЗвонковИКонтактов.ПредставлениеТелефона <> """"
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КонтактовСВизитов,
	               |	СУММА(ВЫБОР
	               |			КОГДА РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЭлектронноеПисьмо)
	               |					ИЛИ РегистрацияЗвонковИКонтактов.ВидКонтакта = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЗаявкаССайта)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК ЗарегистрированоИнтернетОбращений,
	               |	СУММА(0) КАК ВизитовПоРабочимЛистам,
	               |	СУММА(0) КАК ЗаписейНаТестДрайв,
	               |	СУММА(0) КАК ВыданныхАвтомобилей,
	               |	СУММА(0) КАК ПросроченныхСобытий,
	               |	СУММА(0) КАК ОтказовОтАвтомобиля,
	               |	СУММА(0) КАК РабочихЛистовИнтерес,
	               |	СУММА(0) КАК РабочихЛистовСделка
	               |ПОМЕСТИТЬ Трафик
	               |ИЗ
	               |	РегистрСведений.РегистрацияЗвонковИКонтактов КАК РегистрацияЗвонковИКонтактов
	               |ГДЕ
	               |	РегистрацияЗвонковИКонтактов.ДатаДень МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И РегистрацияЗвонковИКонтактов.Организация = &Организация
	               |	И РегистрацияЗвонковИКонтактов.Модель В ИЕРАРХИИ(&ГруппаМоделей)
	               |
