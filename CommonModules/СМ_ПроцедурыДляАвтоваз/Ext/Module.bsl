	СписокВидовРемонта.Добавить(Справочники.ВидыРемонта.ГарантияПроизводителяЛКП);
	СписокВидовРемонта.Добавить(Справочники.ВидыРемонта.ТехническоеОбслуживание);
	СписокВидовРемонта.Добавить(Справочники.ВидыРемонта.ТО_ноль);
	
	URIПространства_pas = "urn:itcauto.ru:PSSSActSend:1.0.0"; 
	URIПространства_cat = "urn:itcauto.ru:CommonAggregateTypes:1.0.0"; 
	URIПространства_xsi = "http://www.w3.org/2001/XMLSchema-instance"; 
	
	ДокументDOM = Новый ДокументDOM(URIПространства_pas, "pas:PSSSActSend");
	ДокументDOM.ВерсияXML = "1.0";	 
	КореньDOM = ДокументDOM.ЭлементДокумента;
	
	//КореньDOM.УстановитьСоответствиеПространстваИмен("pas", URIПространства_pas);
	КореньDOM.УстановитьСоответствиеПространстваИмен("cat", URIПространства_cat);
	КореньDOM.УстановитьСоответствиеПространстваИмен("xsi", URIПространства_xsi);
    КореньDOM.УстановитьАтрибут(URIПространства_xsi, "xsi:schemaLocation", "urn:itcauto.ru:PSSSActSend:1.0.0 01_PSSS_ActSend.xsd");

	////////////////////////////////////////////////
	// Заголовок сообщения pas:MessageInfo
	ЭлементDOM = ДокументDOM.СоздатьЭлемент(URIПространства_pas, "pas:MessageInfo");
	
	ДочернийЭлементDOM = ДокументDOM.СоздатьЭлемент(URIПространства_cat, "cat:MessageID");	
	ДочернийЭлементDOM.ТекстовоеСодержимое = XMLСтрока(Новый УникальныйИдентификатор());
	ЭлементDOM.ДобавитьДочерний(ДочернийЭлементDOM);
	
	ДочернийЭлементDOM = ДокументDOM.СоздатьЭлемент(URIПространства_cat, "cat:PSSSCode");	
	ДочернийЭлементDOM.ТекстовоеСодержимое = XMLСтрока(КодДилера);
	ЭлементDOM.ДобавитьДочерний(ДочернийЭлементDOM);
	
	ДочернийЭлементDOM = ДокументDOM.СоздатьЭлемент(URIПространства_cat, "cat:MessageDateTime");	
	ДочернийЭлементDOM.ТекстовоеСодержимое = XMLСтрока(Формат(ТекущаяДата(), "ДФ=""гггг-ММ-дд'T'ЧЧ:мм:сс"""));
	ЭлементDOM.ДобавитьДочерний(ДочернийЭлементDOM);
	
	ДочернийЭлементDOM = ДокументDOM.СоздатьЭлемент(URIПространства_cat, "cat:MessageTypeCode");	
	ДочернийЭлементDOM.ТекстовоеСодержимое = "AGO";
	ЭлементDOM.ДобавитьДочерний(ДочернийЭлементDOM);
	
	КореньDOM.ДобавитьДочерний(ЭлементDOM); // pas:MessageInfo

	////////////////////////////////////////////////
