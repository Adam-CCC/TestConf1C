// По имени команды сохранения/восстановления настройки дин. списка возвращает имя элемента управления, при помощи которого визуализируется динамический список и имя реквизита формы типа ДинамическийСписок
// При создании формы задаем названия команд в виде "СохранениеНастроек_[ИмяЭлементаУправления]_[ИмяРеквизита]".
// Ограничение: имя элемента управления и имя реквизита не должны содержать символ "_"
Процедура РазобратьИмяКоманды( пИмяКоманды, рИмяЭлементаУправление, рИмяРеквизита )
	
	// ИмяРеквизита и ИмяЭлементаУправления не должны содержать символ "_"
	ИмяКомандыМассив = Renault_унсКлиентСервер.СтрокаМассив(пИмяКоманды, "_");
	рИмяЭлементаУправление = ИмяКомандыМассив[1];
	рИмяРеквизита = ИмяКомандыМассив[2];
	
КонецПроцедуры	//РазобратьИмяКоманды

Процедура ЗапомнитьОткрытиеНастройки( пФорма, пКлючОбъекта, пИмяРеквизитаДинамическийСписок, пНастройкаСсылка )
	
	ОткрытыеНастройки = пФорма.ОткрытыеНастройкиДинСписков;
	
	// удаляем из массива открытых настроек предыдущую открытую настройку обрабатываемого списка
	Для Инд = -(ОткрытыеНастройки.Количество()-1) По 0 Цикл
		ОткрытаяНастройка = ОткрытыеНастройки[-Инд].Значение;
		Если ОткрытаяНастройка.КлючОбъекта = пКлючОбъекта Тогда
			ОткрытыеНастройки.Удалить(-Инд);
		КонецЕсли;
	КонецЦикла;
	
	// добавляем в открытые настройки нашу пНастройка
	СтруктураНастройки = Новый Структура("
	|КлючОбъекта,
	|ИмяРеквизитаДинамическийСписок,
	|НастройкаСсылка",
	пКлючОбъекта,
	пИмяРеквизитаДинамическийСписок,
	пНастройкаСсылка);
	ОткрытыеНастройки.Добавить( СтруктураНастройки );
	
КонецПроцедуры	//ЗапомнитьОткрытиеНастройки

