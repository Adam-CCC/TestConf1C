// открывает диалог сохранения настройки
Процедура СохранитьНастройку(КоллекцияКолонок, КлючОбъекта) Экспорт
	
	ФормаСохраненияНастройки = ПолучитьФорму("Справочник.Renault_НастройкиСписков.Форма.СохранениеНастройки", Новый Структура("КлючОбъекта", КлючОбъекта), Неопределено);
	
	РезультатВыбора = ФормаСохраненияНастройки.ОткрытьМодально();
	
	Если ЗначениеЗаполнено(РезультатВыбора) Тогда		
		СтруктураНастроекДляСохранения = ПолучитьНастройки(КоллекцияКолонок);
		НастройкаСсылка = Renault_унсСервер.СохранитьНастройку(РезультатВыбора, СтруктураНастроекДляСохранения);
	КонецЕсли;
	
КонецПроцедуры	//СохранитьНастройку

// открывает диалог восстановления настройки
Процедура ВосстановитьНастройку(КоллекцияКолонок, КлючОбъекта) Экспорт
	
	ФормаВосстановленияНастройки = ПолучитьФорму("Справочник.Renault_НастройкиСписков.Форма.ВосстановлениеНастройки", Новый Структура("КлючОбъекта", КлючОбъекта), Неопределено);
	                                                                                                                                                        
	НастройкаСсылка = ФормаВосстановленияНастройки.ОткрытьМодально();
	
	Если ЗначениеЗаполнено(НастройкаСсылка) Тогда
		Настройка = Renault_унсСервер.ПолучитьНастройку(НастройкаСсылка);
		УстановитьНастройки(КоллекцияКолонок, Настройка);
	КонецЕсли;
	
КонецПроцедуры	//ВосстановитьНастройку

Процедура УстановитьНастройки(КоллекцияКолонок, НастройкиКолонок) Экспорт
                                                                               
	Если НастройкиКолонок<>Неопределено Тогда
		
		СтарыйВариант = Ложь;
		//В старом варианте настроект этих колонок не было
		Если НастройкиКолонок.Колонки.Найти("Положение") = Неопределено Тогда
			НастройкиКолонок.Колонки.Добавить("Положение");				
			НастройкиКолонок.Колонки.Добавить("ИзменениеРазмера");			
			СтарыйВариант = Истина;
		КонецЕсли;
		
		Для каждого СтрокаНастроек Из НастройкиКолонок Цикл
			Попытка
		        ОбрабатываемаяКолонка = КоллекцияКолонок[СтрокаНастроек.ИмяКолонки];
		        ТекущаяПозицияКолонки = КоллекцияКолонок.Индекс(ОбрабатываемаяКолонка);
		        КоллекцияКолонок.Сдвинуть(ТекущаяПозицияКолонки,СтрокаНастроек.Позиция-ТекущаяПозицияКолонки);
		        ОбрабатываемаяКолонка.Видимость = СтрокаНастроек.Видимость;
		        ОбрабатываемаяКолонка.Ширина = СтрокаНастроек.Ширина;				
				Если СтарыйВариант Тогда
					ОбрабатываемаяКолонка.Положение = ПоложениеКолонки.НоваяКолонка;
					ОбрабатываемаяКолонка.ИзменениеРазмера = ИзменениеРазмераКолонки.Изменять;
				Иначе
					Если ЗначениеЗаполнено(СтрокаНастроек.Положение) Тогда
						Если СтрокаНастроек.Положение = 0 Тогда
							ОбрабатываемаяКолонка.Положение = ПоложениеКолонки.НоваяКолонка;
						ИначеЕсли СтрокаНастроек.Положение = 1 Тогда
							ОбрабатываемаяКолонка.Положение = ПоложениеКолонки.ВТойЖеКолонке;
						ИначеЕсли СтрокаНастроек.Положение = 2 Тогда
							ОбрабатываемаяКолонка.Положение = ПоложениеКолонки.НаСледующейСтроке;
						КонецЕсли;
					Иначе
						ОбрабатываемаяКолонка.Положение = ПоложениеКолонки.НоваяКолонка;
					КонецЕсли;
					Если ЗначениеЗаполнено(СтрокаНастроек.ИзменениеРазмера) Тогда
						Если СтрокаНастроек.ИзменениеРазмера = Истина Тогда
							ОбрабатываемаяКолонка.ИзменениеРазмера = ИзменениеРазмераКолонки.Изменять;
						Иначе
							ОбрабатываемаяКолонка.ИзменениеРазмера = ИзменениеРазмераКолонки.НеИзменять;
						КонецЕсли;
					Иначе
						ОбрабатываемаяКолонка.ИзменениеРазмера = ИзменениеРазмераКолонки.Изменять;
					КонецЕсли;
				КонецЕсли;
			Исключение
				//Нет такой колонки
			КонецПопытки;
	    КонецЦикла; 
    КонецЕсли; 

КонецПроцедуры

// восстанавливает настройки с признаком ИспользоватьПриОткрытии
Процедура ПриОткрытииФормы(КоллекцияКолонок, КлючОбъекта) Экспорт
	
	ОсновнаяНастройка = Renault_унсСервер.ПолучитьОсновнуюНастройку(КлючОбъекта);
	
	Если ЗначениеЗаполнено(ОсновнаяНастройка) Тогда
		УстановитьНастройки(КоллекцияКолонок, ОсновнаяНастройка.ЗначениеНастройки);
	КонецЕсли;		         
	
КонецПроцедуры	//ПриОткрытииФормы
