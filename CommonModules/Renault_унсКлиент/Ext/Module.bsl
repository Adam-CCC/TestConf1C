
Функция ПолучитьНастройки(КоллекцияКолонок)
	
	НастройкиКолонок = Новый ТаблицаЗначений;
    НастройкиКолонок.Колонки.Добавить("ИмяКолонки");
    НастройкиКолонок.Колонки.Добавить("Позиция");
    НастройкиКолонок.Колонки.Добавить("Видимость");
    НастройкиКолонок.Колонки.Добавить("Ширина");
	НастройкиКолонок.Колонки.Добавить("Положение");
	НастройкиКолонок.Колонки.Добавить("ИзменениеРазмера");
	НастройкиКолонок.Колонки.Добавить("ВысотаЯчейки");
    
    Для каждого СохраняемаяКолонка Из КоллекцияКолонок Цикл        
	    СтрокаНастройки = НастройкиКолонок.Добавить();
	    СтрокаНастройки.ИмяКолонки = СохраняемаяКолонка.Имя;
	    СтрокаНастройки.Позиция = КоллекцияКолонок.Индекс(СохраняемаяКолонка);
	    СтрокаНастройки.Видимость = СохраняемаяКолонка.Видимость;
	    СтрокаНастройки.Ширина = СохраняемаяКолонка.Ширина;
		СтрокаНастройки.ВысотаЯчейки = СохраняемаяКолонка.ВысотаЯчейки;
		
		//СтрокаНастройки.ИзменениеРазмера = СохраняемаяКолонка.ИзменениеРазмера;
		СтрокаНастройки.ИзменениеРазмера = (СохраняемаяКолонка.ИзменениеРазмера = ИзменениеРазмераКолонки.Изменять);
		   
		//СтрокаНастройки.Положение = СохраняемаяКолонка.Положение;
		Если СохраняемаяКолонка.Положение = ПоложениеКолонки.НоваяКолонка Тогда
			СтрокаНастройки.Положение = 0;
		ИначеЕсли СохраняемаяКолонка.Положение = ПоложениеКолонки.ВТойЖеКолонке Тогда
			СтрокаНастройки.Положение = 1;
		ИначеЕсли СохраняемаяКолонка.Положение = ПоложениеКолонки.НаСледующейСтроке Тогда
			СтрокаНастройки.Положение = 2;
		КонецЕсли;
		
    КонецЦикла; 
	
	Возврат НастройкиКолонок;
	
КонецФункции	//ПолучитьНастройки

Процедура ДобавитьЭлементОтбораКомпоновкиДанныхВКоллекцию( пКоллекцияЭлементовОтбора, пДобавляемыйЭлементОтбора )
	
	Если ТипЗнч(пДобавляемыйЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		ДобавленнаяГруппа = пКоллекцияЭлементовОтбора.Добавить( Тип("ГруппаЭлементовОтбораКомпоновкиДанных") );
		ЭлементыДобавляемойГруппыОтбора = пДобавляемыйЭлементОтбора.Элементы;
		ЗаполнитьЗначенияСвойств( ДобавленнаяГруппа, пДобавляемыйЭлементОтбора );
		Для каждого ЭлементГруппы Из ЭлементыДобавляемойГруппыОтбора Цикл
			ДобавитьЭлементОтбораКомпоновкиДанныхВКоллекцию( ДобавленнаяГруппа.Элементы, ЭлементГруппы );
		КонецЦикла;
	Иначе  // добавляем элемент отбора 
		ДобавленныйЭлемент = пКоллекцияЭлементовОтбора.Добавить( Тип("ЭлементОтбораКомпоновкиДанных") );
		ЗаполнитьЗначенияСвойств( ДобавленныйЭлемент, пДобавляемыйЭлементОтбора );
	КонецЕсли;

КонецПроцедуры	//ДобавитьЭлементОтбораКомпоновкиДанных

