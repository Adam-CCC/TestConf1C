		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(Renault_СписанияВнутреннихЗаказовПокупателя.ЗаказПокупателя) КАК ЗаказПокупателя,
		|	Renault_СписанияВнутреннихЗаказовПокупателя.СписаниеТоваров
		|ПОМЕСТИТЬ ВТ_ЗаказыПокупателя
		|ИЗ
		|	РегистрСведений.Renault_СписанияВнутреннихЗаказовПокупателя КАК Renault_СписанияВнутреннихЗаказовПокупателя
		|ГДЕ
		|	Renault_СписанияВнутреннихЗаказовПокупателя.СписаниеТоваров = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	Renault_СписанияВнутреннихЗаказовПокупателя.СписаниеТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТабЧастьТовары.Номенклатура,
		|	ВТ_ТабЧастьТовары.ХарактеристикаНоменклатуры,
		|	ВТ_ТабЧастьТовары.Количество,
		|	ВТ_ТабЧастьТовары.СкладКомпании,
		|	ВТ_ЗаказыПокупателя.ЗаказПокупателя,
		|	ВТ_ТабЧастьТовары.Дата
		|ПОМЕСТИТЬ ВТ_ДанныеДляСписания
		|ИЗ
		|	ВТ_ЗаказыПокупателя КАК ВТ_ЗаказыПокупателя
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТабЧастьТовары КАК ВТ_ТабЧастьТовары
		|		ПО ВТ_ЗаказыПокупателя.СписаниеТоваров = ВТ_ТабЧастьТовары.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказыПокупателейОстатки.Контрагент,
		|	ВЫБОР
		|		КОГДА ЗаказыПокупателейОстатки.Заказ ССЫЛКА Документ.ЗаказПокупателя
		|			ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказПокупателя).Ссылка
		|	КОНЕЦ КАК Заказ,
		|	ЗаказыПокупателейОстатки.Номенклатура,
		|	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
		|	ЗаказыПокупателейОстатки.СкладКомпании,
		|	ЗаказыПокупателейОстатки.ЗаказаноОстаток КАК Заказано,
		|	ЗаказыПокупателейОстатки.РезервОстаток КАК Резерв,
		|	ЗаказыПокупателейОстатки.РезервСвободныйОстаток КАК РезервСвободный,
		|	ЗаказыПокупателейОстатки.СуммаОстаток КАК Сумма,
		|	ЗаказыПокупателейОстатки.СуммаУпрОстаток КАК СуммаУпр
		|ПОМЕСТИТЬ ВТ_ОстаткиПоЗаказам
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей.Остатки(
		|			&МоментВремени,
		|			(Номенклатура, ХарактеристикаНоменклатуры, СкладКомпании, Заказ) В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					ВТ_ДанныеДляСписания.Номенклатура,
		|					ВТ_ДанныеДляСписания.ХарактеристикаНоменклатуры,
		|					ВТ_ДанныеДляСписания.СкладКомпании,
		|					ВТ_ДанныеДляСписания.ЗаказПокупателя
		|				ИЗ
		|					ВТ_ДанныеДляСписания КАК ВТ_ДанныеДляСписания)) КАК ЗаказыПокупателейОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОстаткиПоЗаказам.Контрагент КАК Контрагент,
		|	ВТ_ОстаткиПоЗаказам.Заказ КАК Заказ,
		|	ВТ_ОстаткиПоЗаказам.Номенклатура КАК Номенклатура,
		|	ВТ_ОстаткиПоЗаказам.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВТ_ОстаткиПоЗаказам.СкладКомпании КАК СкладКомпании,
		|	ВЫБОР
		|		КОГДА ВТ_ОстаткиПоЗаказам.Резерв > ВТ_ДанныеДляСписания.Количество
		|			ТОГДА ВТ_ДанныеДляСписания.Количество
		|		ИНАЧЕ ВТ_ОстаткиПоЗаказам.Заказано
		|	КОНЕЦ КАК Заказано,
		|	ВЫБОР
		|		КОГДА ВТ_ОстаткиПоЗаказам.Резерв > ВТ_ДанныеДляСписания.Количество
		|			ТОГДА ВТ_ДанныеДляСписания.Количество
		|		ИНАЧЕ ВТ_ОстаткиПоЗаказам.Резерв
		|	КОНЕЦ КАК Резерв,
		|	ВЫБОР
		|		КОГДА ВТ_ОстаткиПоЗаказам.РезервСвободный > ВТ_ДанныеДляСписания.Количество
		|			ТОГДА ВТ_ДанныеДляСписания.Количество
		|		ИНАЧЕ ВТ_ОстаткиПоЗаказам.РезервСвободный
		|	КОНЕЦ КАК РезервСвободный,
		|	ВЫБОР
		|		КОГДА ВТ_ОстаткиПоЗаказам.Заказано = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_ОстаткиПоЗаказам.Сумма * ВЫБОР
		|				КОГДА ВТ_ОстаткиПоЗаказам.Резерв > ВТ_ДанныеДляСписания.Количество
		|					ТОГДА ВТ_ДанныеДляСписания.Количество
		|				ИНАЧЕ ВТ_ОстаткиПоЗаказам.Заказано
		|			КОНЕЦ / ВТ_ОстаткиПоЗаказам.Заказано
		|	КОНЕЦ КАК Сумма,
		|	ВЫБОР
		|		КОГДА ВТ_ОстаткиПоЗаказам.Заказано = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВТ_ОстаткиПоЗаказам.СуммаУпр * ВЫБОР
		|				КОГДА ВТ_ОстаткиПоЗаказам.Резерв > ВТ_ДанныеДляСписания.Количество
		|					ТОГДА ВТ_ДанныеДляСписания.Количество
		|				ИНАЧЕ ВТ_ОстаткиПоЗаказам.Заказано
		|			КОНЕЦ / ВТ_ОстаткиПоЗаказам.Заказано
		|	КОНЕЦ КАК СуммаУпр,
		|	ЗНАЧЕНИЕ(Справочник.ХозОперации.ЗакрытиеЗаказовПокупателей) КАК ХозОперация,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЗаказов.ЗакрытиеЗаказа) КАК ВидОперации,
		|	ВТ_ДанныеДляСписания.Дата КАК Период
		|ИЗ
		|	ВТ_ДанныеДляСписания КАК ВТ_ДанныеДляСписания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстаткиПоЗаказам КАК ВТ_ОстаткиПоЗаказам
		|		ПО ВТ_ДанныеДляСписания.Номенклатура = ВТ_ОстаткиПоЗаказам.Номенклатура
		|			И ВТ_ДанныеДляСписания.ХарактеристикаНоменклатуры = ВТ_ОстаткиПоЗаказам.ХарактеристикаНоменклатуры
		|			И ВТ_ДанныеДляСписания.СкладКомпании = ВТ_ОстаткиПоЗаказам.СкладКомпании
		|			И ВТ_ДанныеДляСписания.ЗаказПокупателя = ВТ_ОстаткиПоЗаказам.Заказ"; 	
	Запрос.УстановитьПараметр("МоментВремени", ИсточникОбъект.МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", ИсточникОбъект.Ссылка);  	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Движения = ИсточникОбъект.Движения;
		Движения.ЗаказыПокупателей.Записывать = Истина;
		Движения.ЗаказыПокупателей.Очистить();
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Движение = Движения.ЗаказыПокупателей.ДобавитьРасход();
			ЗаполнитьЗначенияСвойств(Движение, Выборка); 
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры
