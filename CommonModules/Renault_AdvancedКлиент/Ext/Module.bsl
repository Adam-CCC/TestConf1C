Функция ПолучитьКомплектациюРаботы(Авторабота, ТипКомплектации) Экспорт
	Если ТипКомплектации = "Работы" Тогда
		ДопУсловие = "Справочник.Автоработы";
		ДопНазвание = "Работа";
	ИначеЕсли ТипКомплектации = "Запчасти" Тогда
		ДопУсловие = "Справочник.Номенклатура";
		ДопНазвание = "Запчасть";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвязанныеРаботы.СвязаннаяРабота КАК " + ДопНазвание + ",
		|	СвязанныеРаботы.Количество
		|ИЗ
		|	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
		|ГДЕ
		|	СвязанныеРаботы.Авторабота = &Авторабота
		|	И СвязанныеРаботы.СвязаннаяРабота ССЫЛКА " + ДопУсловие + ""; 	
	Запрос.УстановитьПараметр("Авторабота", Авторабота); 	
	Результат = Запрос.Выполнить();
	
	ТабСвязанных = Результат.Выгрузить();
	
	Возврат ТабСвязанных;
КонецФункции

