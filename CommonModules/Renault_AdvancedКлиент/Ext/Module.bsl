Функция ПолучитьРеквизитыДоговора(ДоговорКонтрагента) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.Автодоговор,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ИндивидуальныеУсловияПоНаборам,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ОтправкаДокументов,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ПечатьПодтвержденияУщерба,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ПечатьСтраховщик,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ПродажаСтраховогоПолиса,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ВедениеВзаиморасчетов,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ВестиПоДокументамРасчетовСКонтрагентом,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ВидАгентскогоДоговора,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ВидВзаиморасчетов,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ВидУсловийДоговора,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ДержатьРезервБезОплатыОграниченноеВремя,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ДопустимоеЧислоДнейЗадолженности,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.КонтролироватьДенежныеСредстваКомитента,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.КонтролироватьСуммуЗадолженности,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.КонтролироватьЧислоДнейЗадолженности,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.НаименованиеДляСчетаФактурыНаАванс,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ОбособленныйУчетТоваровПоЗаказамПокупателей,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ОсновнаяСтатьяДвиженияДенежныхСредств,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.Гарантийный,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.Страховой,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ТипЦенСклад,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ПорядокРегистрацииСчетовФактурНаАвансПоДоговору,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.РасчетыВУсловныхЕдиницах,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.РеализацияНаЭкспорт,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.СпособРасчетаКомиссионногоВознаграждения,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ТипЦен,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.УчетАгентскогоНДС,
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ЧислоДнейРезерваБезОплаты
		|ИЗ
		|	РегистрСведений.Renault_Advanced_РеквизитыДоговоровКонтрагентов КАК Renault_Advanced_РеквизитыДоговоровКонтрагентов
		|ГДЕ
		|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ДоговорКонтрагента = &ДоговорКонтрагента";	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента); 	
	Результат = Запрос.Выполнить();
	
	Выборка = Неопределено;
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();		
		Выборка.Следующий();
	КонецЕсли;
	
	Возврат Выборка;	
КонецФункции

Процедура ЗаписатьРеквизитыДоговора(ФормаДоговора, Договор) Экспорт
	Если ФормаДоговора <> Неопределено И ЗначениеЗаполнено(Договор) Тогда
		Если ФормаДоговора.СправочникОбъект.Ссылка = Договор Тогда
			Запись = РегистрыСведений.Renault_Advanced_РеквизитыДоговоровКонтрагентов.СоздатьМенеджерЗаписи();
			Запись.ДоговорКонтрагента = Договор;
			ЗаполнитьЗначенияСвойств(Запись, ФормаДоговора);
			
			Запись.Записать();			
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьСписокПоляВыбора(ПолеВыбора, Список) Экспорт 
	ПрошлоеЗначение = ПолеВыбора.Значение;
	ПолеВыбора.СписокВыбора = Список;
	Если ЗначениеЗаполнено(ПрошлоеЗначение) Тогда
		Если  Список.НайтиПоЗначению(ПрошлоеЗначение) <> Неопределено Тогда
			Если НЕ ПолеВыбора.Значение = ПрошлоеЗначение Тогда
				ПолеВыбора.Значение = ПрошлоеЗначение;
			КонецЕсли;
		Иначе
			ПолеВыбора.Значение = Неопределено;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

//Используется для: ЗаказНаряд, ДоговорВзаиморасчетов
Функция ПолучитьРеквизитОбъекта(СсылкаНаОбъект, ИмяРеквизита) Экспорт
	ЗначениеРеквизита = Неопределено;
	
	ЭтоРеквизитОбъекта = Истина;
	
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		ЭтоРеквизитОбъекта = Ложь;
	КонецЕсли;

	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказНаряд") Тогда		
		Если ЭтоРеквизитОбъекта Тогда
			ТекстЗапроса = 
				"ВЫБРАТЬ
				|	ЗаказНарядДок." + ИмяРеквизита + " КАК " + ИмяРеквизита + "
				|ИЗ
				|	Документ.ЗаказНаряд КАК ЗаказНарядДок
				|ГДЕ
				|	ЗаказНарядДок.Ссылка = &СсылкаНаОбъект";
		КонецЕсли;		 
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда
		Если ЭтоРеквизитОбъекта Тогда
			ТекстЗапроса = 
				"ВЫБРАТЬ
				|	ДоговорыВзаиморасчетов." + ИмяРеквизита + " КАК " + ИмяРеквизита + "
				|ИЗ
				|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
				|ГДЕ
				|	ДоговорыВзаиморасчетов.Ссылка = &СсылкаНаОбъект";
		Иначе
			ТекстЗапроса = 
				"ВЫБРАТЬ
				|	Renault_Advanced_РеквизитыДоговоровКонтрагентов." + ИмяРеквизита + " КАК " + ИмяРеквизита + "
				|ИЗ
				|	РегистрСведений.Renault_Advanced_РеквизитыДоговоровКонтрагентов КАК Renault_Advanced_РеквизитыДоговоровКонтрагентов
				|ГДЕ
				|	Renault_Advanced_РеквизитыДоговоровКонтрагентов.ДоговорКонтрагента = &СсылкаНаОбъект";			
		КонецЕсли;		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СсылкаНаОбъект", СсылкаНаОбъект);		
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();			
		Выборка.Следующий();
		
		ЗначениеРеквизита = Выборка[ИмяРеквизита];			
	Иначе
		Если Не ЭтоРеквизитОбъекта Тогда
			Если ТипЗнч(СсылкаНаОбъект) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда
				ЗначениеРеквизита = Метаданные.РегистрыСведений.Renault_Advanced_РеквизитыДоговоровКонтрагентов.Ресурсы.Найти(ИмяРеквизита).Тип.ПривестиЗначение(); 
			ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
				ЗначениеРеквизита = Метаданные.Документы.ЗаказНаряд.Реквизиты.Найти(ИмяРеквизита).Тип.ПривестиЗначение(); 
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеРеквизита;	
КонецФункции
