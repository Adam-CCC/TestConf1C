// Процедуры регламентных заданий

// Рассылка СМС напоминаний о записи на ремонт
Процедура НапоминанияОЗаписиНаРемонт(Параметры = Неопределено) Экспорт
	ДатаНачала = НачалоДня(ТекущаяДата() + 86400); // на завтра
	ДатаОкончания = КонецДня(ДатаНачала);
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("ПланРемонта", Справочники.ХозОперации.ПланРемонта);
	Запрос.УстановитьПараметр("Отклонено", Перечисления.СостоянияЗаявкиНаРемонт.Отклонено);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаявкаНаРемонт.ДатаНачала КАК ДатаНачала,
	|	ЗаявкаНаРемонт.Заказчик КАК Заказчик,
	|	ЗаявкаНаРемонт.ПредставлениеТелефона КАК Телефон,
	|	ЗаявкаНаРемонт.Ссылка КАК Ссылка,
	|	ЗаявкаНаРемонт.ПодразделениеКомпании КАК Подразделение,
	|	ЗаявкаНаРемонт.Автомобиль КАК Автомобиль,
	|	ЗаявкаНаРемонт.Организация.Наименование КАК Организация,
	|	ЗаявкаНаРемонт.ПодразделениеКомпании.ДилерскийЦентр.Наименование КАК ДилерскийЦентр
	|ИЗ
	|	Документ.ЗаявкаНаРемонт КАК ЗаявкаНаРемонт
	|ГДЕ
	|	ЗаявкаНаРемонт.ДатаНачала МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ЗаявкаНаРемонт.Состояние <> &Отклонено
	|	И ЗаявкаНаРемонт.Проведен";
	
	Результат = Запрос.Выполнить().Выгрузить();
	Для Каждого Заявка Из Результат Цикл
		ТекстСМС = "";
		Если ЗначениеЗаполнено(Заявка.Заказчик) Тогда
			Если ТипЗнч(Заявка.Заказчик) = Тип("СправочникСсылка.Контрагенты") Тогда
				Если Заявка.Заказчик.НашаФирма Тогда
					Продолжить;
				ИначеЕсли Заявка.Заказчик.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
					ТекстСМС = Заявка.Заказчик.Имя + " " + Заявка.Заказчик.Отчество + ", ";
				Иначе
					ТекстСМС = Заявка.Заказчик.Наименование + ", ";
				КонецЕсли;
				
			Иначе
				ТекстСМС = СокрЛП(Заявка.Заказчик) + ", ";
			КонецЕсли;
		КонецЕсли;
		
		ТекстСМС = ТекстСМС + "Напоминаем, Вы записаны в сервисный центр " + Заявка.ДилерскийЦентр + " ";
		ТекстСМС = ТекстСМС + Формат(Заявка.ДатаНачала, "ДФ='дд.ММ.гггг ЧЧ:мм'");
		
		ТекущееПодразделение = Заявка.Подразделение;
		Пока Не ТекущееПодразделение.Пустая() Цикл
			ПодразделениеАдрес = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
			Если обЗначениеНеЗаполнено(ПодразделениеАдрес) Тогда
				ПодразделениеАдрес = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
			КонецЕсли;
			Если ЗначениеЗаполнено(ПодразделениеАдрес) Тогда
				ТекстСМС = ТекстСМС + ". Адрес: " + ПодразделениеАдрес;
				Прервать;
			Иначе
				ТекущееПодразделение = ТекущееПодразделение.Родитель;
				Продолжить;
			КонецЕсли;
		КонецЦикла;

		ТекущееПодразделение = Заявка.Подразделение;
		Пока Не ТекущееПодразделение.Пустая() Цикл
			ПодразделениеТелефон = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
			Если обЗначениеНеЗаполнено(ПодразделениеТелефон) Тогда
				ПодразделениеТелефон = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
			КонецЕсли;
			Если ЗначениеЗаполнено(ПодразделениеТелефон) Тогда
				ТекстСМС = ТекстСМС + ", Тел: " + ПодразделениеТелефон;
				Прервать;
			Иначе
				ТекущееПодразделение = ТекущееПодразделение.Родитель;
				Продолжить;
			КонецЕсли;
		КонецЦикла;	  
		ТекстСМС = ТекстСМС + ". Ждём Вас! ";
		ТекстСМС = ТекстСМС + "Напоминаем, что официальный дилер " + Заявка.Организация + ", ";
		ТекстСМС = ТекстСМС + "не производит то с запасными частями и расходными материалами, приобретенными вами у сторонних поставщиков";
		
		СМСОтправлено = ОтправитьСМС(Заявка.Ссылка, ТекстСМС);		
	КонецЦикла;	
КонецПроцедуры

// Получение статусов СМС с портала Билйан
Процедура РегламентноеЗаданиеПроверкаСМСБилайн (Параметры = Неопределено) Экспорт
	ДатаОкончания = НачалоДня(ТекущаяДата()); // запускать после полуночи
	ДатаНачала = ДатаОкончания - 864000;
	смсКоммуникаторБилайн.ПолучитьСтатусыЗаПериод(ДатаНачала, ДатаОкончания);
КонецПроцедуры

Процедура РассылкаСМССоколмоторс(Параметры = Неопределено) Экспорт
	ЗапросДоставка = Новый Запрос;
	ЗапросДоставка.Текст = 
	"ВЫБРАТЬ
	|	смсСостоянияСообщений.Сообщение КАК ДокументСсылка,
	|	смсСостоянияСообщений.НомерСтрокиДокумента,
	|	смсСообщениеПолучатели.НомерТелефона КАК НомерПолучателя,
	|	смсСообщениеПолучатели.ТекстСообщения КАК ТекстСообщения,
	|	смсСостоянияСообщений.GUID,
	|	0 КАК КодОшибки,
	|	смсСостоянияСообщений.sms_id
	|ИЗ
	|	РегистрСведений.смсСостоянияСообщений КАК смсСостоянияСообщений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.SMS.Получатели КАК смсСообщениеПолучатели
	|		ПО смсСостоянияСообщений.Сообщение = смсСообщениеПолучатели.Ссылка
	|			И смсСостоянияСообщений.НомерСтрокиДокумента = смсСообщениеПолучатели.НомерСтроки
	|ГДЕ
	|	смсСостоянияСообщений.Статус = ЗНАЧЕНИЕ(Перечисление.смсСостоянияСообщений.Доставка)
	|ИТОГИ ПО
	|	ДокументСсылка";
	
	РезультатДоставка = ЗапросДоставка.Выполнить();
	Если РезультатДоставка.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
    ВыборкаДокументы = РезультатДоставка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокументы.Следующий() Цикл
		смсКоммуникаторБилайн.ОтправкаСообщенийДокумента(ВыборкаДокументы.ДокументСсылка, Ложь);
	КонецЦикла;	
КонецПроцедуры

