//// Процедуры / функции для отправки СМС
////////////////////////////////////////////////

Функция ОтправитьСМС(ДокументОснование, ТекстСМС) Экспорт
	Если обЗначениеНеЗаполнено(ДокументОснование) Тогда
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: не задан документ основание!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТекстСМС) Тогда
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: не заполнен текст сообщения!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(ТекстСМС) > 480 Тогда
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: Длина сообщения превышает 480 символов!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;
	
	НовыйОбъектСМС = Документы.SMS.СоздатьДокумент();
	НовыйОбъектСМС.Заполнить(ДокументОснование);
	НовыйОбъектСМС.ТекстСообщения = ТекстСМС;
	Для Каждого Получатель Из НовыйОбъектСМС.Получатели Цикл
		ТелефонЦифрами = Прав(ОставитьТолькоЦифры(Получатель.НомерТелефона), 10);
		Если СтрДлина(ТелефонЦифрами) <> 10 Или Лев(ТелефонЦифрами, 1) <> "9" Тогда
			#Если Клиент Тогда
			Сообщить("Не удалось отправить СМС: номер " + Получатель.НомерТелефона + 
					" не является номером сотового телефона!", СтатусСообщения.Важное);
			#КонецЕсли
			Возврат Ложь;
		КонецЕсли;
		Получатель.ТекстСообщения = ТекстСМС;
	КонецЦикла;
	НовыйОбъектСМС.Записать();
	
	СтрокаОшибки = НовыйОбъектСМС.ОтправитьSMS();
	Если ПустаяСтрока(СтрокаОшибки) Тогда
		НовыйОбъектСМС.Записать();
		Возврат Истина;
	Иначе
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: " + СтрокаОшибки, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

Функция ОтправитьСМСПоНомеру(Кому, НомерТелефона, ТекстСМС) Экспорт
	ТелефонЦифрами = Прав(ОставитьТолькоЦифры(НомерТелефона), 10);
	Если СтрДлина(ТелефонЦифрами) <> 10 Или Лев(ТелефонЦифрами, 1) <> "9" Тогда		
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: " + НомерТелефона + 
				" не является номером сотового телефона!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТекстСМС) Тогда
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: не заполнен текст сообщения!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(ТекстСМС) > 480 Тогда
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: Длина сообщения превышает 480 символов!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;

	НовыйОбъектСМС = Документы.SMS.СоздатьДокумент();
	ДокументОснование = Документы.РабочийЛист.ПустаяСсылка();
	НовыйОбъектСМС.Заполнить(ДокументОснование);
	НовыйОбъектСМС.Организация = ПараметрыСеанса.Организация;
	НовыйОбъектСМС.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
	НовыйОбъектСМС.ДокументОснование = ДокументОснование;
	НовыйОбъектСМС.ТекстСообщения = ТекстСМС;
	Для Каждого Получатель Из НовыйОбъектСМС.Получатели Цикл
		Получатель.Контрагент = Кому;
		Получатель.НомерТелефона = НомерТелефона;
		Получатель.ТекстСообщения = ТекстСМС;
	КонецЦикла;
	НовыйОбъектСМС.Записать();
	
	СтрокаОшибки = НовыйОбъектСМС.ОтправитьSMS();
	Если ПустаяСтрока(СтрокаОшибки) Тогда
		НовыйОбъектСМС.Записать();
		Возврат Истина;
	Иначе
		#Если Клиент Тогда
		Сообщить("Не удалось отправить СМС: " + СтрокаОшибки, СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

Функция ТелефонЦифрами(Объект)
	НаборЗаписейКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписейКИ.Отбор.Объект.Значение = Объект;
	НаборЗаписейКИ.Отбор.Объект.Использование = Истина;
	НаборЗаписейКИ.Отбор.Тип.Значение = Перечисления.ТипыКонтактнойИнформации.Телефон;
	НаборЗаписейКИ.Отбор.Тип.Использование = Истина;
	НаборЗаписейКИ.Прочитать();
	Представление = "";
	СтруктураТелефон = Новый Структура();
	СтруктураТелефон.Вставить("Представление", Представление);
	СтруктураТелефон.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	Для каждого Запись Из НаборЗаписейКИ Цикл
		Если ПустаяСтрока(Запись.Поле1) Тогда
			Представление = Запись.Поле2 + Запись.Поле3;
		Иначе
			Представление = Запись.Поле1 + Запись.Поле2 + Запись.Поле3;
			Представление = Сред(Представление, 2);
		КонецЕсли;
		Если обЗначениеНеЗаполнено(Представление) Тогда
			Для сч = 1 По СтрДлина(Запись.Представление) Цикл
				СимволИзНомера = Сред(Запись.Представление, сч, 1);
				Если СтрНайти("1234567890", СимволИзНомера) > 0 Тогда
					Представление = Представление + СимволИзНомера;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтруктураТелефон.Вставить("Представление", Представление);
		СтруктураТелефон.Вставить("Вид", Запись.Вид);
		
		Если Запись.ЗначениеПоУмолчанию Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтруктураТелефон;
КонецФункции

Функция ПолучитьПредставлениеКИДляСМС(Объект, ЗначениеКИ) Экспорт
	Представление = "";
	
	НаборЗаписейКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписейКИ.Отбор.Объект.Значение      = Объект;
	НаборЗаписейКИ.Отбор.Объект.Использование = Истина;
	Если ТипЗнч(ЗначениеКИ) = Тип("СправочникСсылка.ВидыКонтактнойИнформации") Тогда
		НаборЗаписейКИ.Отбор.Вид.Значение = ЗначениеКИ;
		НаборЗаписейКИ.Отбор.Вид.Использование = Истина;
		НаборЗаписейКИ.Прочитать();
		Для Каждого ЗаписьКИ Из НаборЗаписейКИ Цикл
			Если ЗаписьКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
				Если ЗначениеЗаполнено(ЗаписьКИ.Поле3) Тогда
					Представление = ЗаписьКИ.Поле3 + ", " + ЗаписьКИ.Поле5;
				ИначеЕсли ЗначениеЗаполнено(ЗаписьКИ.Поле4) Тогда
					Представление = ЗаписьКИ.Поле4;
				КонецЕсли;
				Если ЗначениеЗаполнено(ЗаписьКИ.Поле6) Тогда
					Представление = Представление + ", " + ЗаписьКИ.Поле6;
				КонецЕсли;
				Если ЗначениеЗаполнено(ЗаписьКИ.Поле7) Тогда
					Представление = Представление + ", " + ЗаписьКИ.Поле7;
				КонецЕсли;			
				
			ИначеЕсли ЗаписьКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
				Если ЗначениеЗаполнено(ЗаписьКИ.Поле1) Тогда
					Представление = ЗаписьКИ.Поле1;
				КонецЕсли;
				Если ЗначениеЗаполнено(ЗаписьКИ.Поле2) Тогда
					Представление = Представление + " (" + ЗаписьКИ.Поле2 + ")";
				КонецЕсли;
				Если ЗначениеЗаполнено(ЗаписьКИ.Поле3) И СтрДлина(ЗаписьКИ.Поле3) > 5 Тогда
					Телефон = Лев(ЗаписьКИ.Поле3, 3);
					ТелефонВспом = Сред(ЗаписьКИ.Поле3, 4);
					Телефон = Телефон + "-" + Лев(ТелефонВспом, 2) + "-" + Сред(ТелефонВспом, 3);
					Представление = Представление + " " + Телефон;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(Представление) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	
	Возврат Представление;
КонецФункции

//Функция возвращает номер телефона в котором присутствуют только символы цифр
Функция ОставитьТолькоЦифры(НомерТелефона) Экспорт
	ТолькоЦифрыНомера = "";
	Для сч = 1 По СтрДлина(НомерТелефона) Цикл
		СимволИзНомера = Сред(НомерТелефона, сч, 1);
		Если СтрНайти("1234567890", СимволИзНомера) > 0 Тогда
			ТолькоЦифрыНомера = ТолькоЦифрыНомера + СимволИзНомера;
		КонецЕсли;
	КонецЦикла;
	Возврат ТолькоЦифрыНомера;
КонецФункции


