//Проверяем по названию колонки  нужно ли получать УИД для значения в ней
Функция ЭтоКолонкаДляУИД(ИмяКолонки)
	
	Если ТипЗнч(ИмяКолонки) = Тип("Строка") Тогда
		
		Поиск = Найти(ИмяКолонки, "Ссылка");
		Возврат ?(Поиск > 0 , Истина, Ложь);
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

//Получаем имя колонки куда надо записать УИД
Функция ИмяДляКолонкиУИД(ИмяКолонкиИсточника)
	
	Если ТипЗнч(ИмяКолонкиИсточника) = Тип("Строка") Тогда
		
		Ответ = "UID" + СтрЗаменить(ИмяКолонкиИсточника, "Ссылка", "");
		Возврат Ответ;
		
	Иначе
		
		Возврат "UID";
		
	КонецЕсли;
	
КонецФункции

//Добавим нужные колонки,заполним их УИДами,удалим колонки с ссылками 
Процедура ДополнитьТаблицуДанныхУИДами(ТаблицаДанных)Экспорт
	
	//Определим колонки с ссылочными данными (в названии содержится ссылка)
	
	КолонкиДляУид = Новый Массив();
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
		
		Если ЭтоКолонкаДляУИД(Колонка.Имя) тогда
			
			КолонкиДляУид.Добавить(Колонка.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Добавляем колонки для идентификаторов
	
	Для Каждого КолонкаВУИД Из КолонкиДляУид Цикл
		
		ТаблицаДанных.Колонки.Добавить(ИмяДляКолонкиУИД(КолонкаВУИД),Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(40)));
		
	КонецЦикла;
	
	//Заполним колонки с идентификаторами данными
	
	Для Каждого Тек Из ТаблицаДанных Цикл
		
		Для Каждого КолонкаВУИД из КолонкиДляУид Цикл
			
			Если ЗначениеЗаполнено(Тек[КолонкаВУИД]) Тогда
				
				Тек[ИмяДляКолонкиУИД(КолонкаВУИД)] = Тек[КолонкаВУИД].Ссылка.УникальныйИдентификатор();
				
			Иначе
				
				//Тек[ИмяДляКолонкиУИД(КолонкаВУИД)] ="-1";
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//Удалим старые колонки с ссылочными данными
	
	Для каждого КолонкаВУИД Из КолонкиДляУид Цикл
		
		ТаблицаДанных.Колонки.Удалить(КолонкаВУИД);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ИнициализироватьТаблицуДоговоров()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_Договор.Ссылка,
		|	ЛОЖЬ КАК УдаленнаяЗапись
		|ИЗ
		|	Документ.Renault_Договор КАК Renault_Договор";
	Таблица = Запрос.Выполнить().Выгрузить();			   
	Таблица.Очистить();
	Возврат Таблица;
	
КонецФункции

Функция ИнициализироватьТаблицуРезервов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_РезервированиеАвтомобилей.Ссылка,
		|	ЛОЖЬ КАК УдаленнаяЗапись
		|ИЗ
		|	Документ.Renault_РезервированиеАвтомобилей КАК Renault_РезервированиеАвтомобилей";
	Таблица = Запрос.Выполнить().Выгрузить();			   
	Таблица.Очистить();
	Возврат Таблица;
	
КонецФункции

Функция ИнициализироватьТаблицуВыдачи()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRM_ЗаписьНаВыдачу.Ссылка,
		|	ЛОЖЬ КАК УдаленнаяЗапись
		|ИЗ
		|	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу";
	Таблица = Запрос.Выполнить().Выгрузить();			   
	Таблица.Очистить();
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьЭлементВТаблицуДляОтправки(ЭлементИзмененныхДанных, БылоИзменениеОстатков,
			ТаблицаДоговоры, 				ТаблицаДоговоры_ДляУдаленияРегистрации,
			ТаблицаРезервы,					ТаблицаРезервы_ДляУдаленияРегистрации,
			ТаблицаВыдачи,					ТаблицаВыдачи_ДляУдаленияРегистрации)
			
	Если ТипЗнч(ЭлементИзмененныхДанных) =  Тип("УдалениеОбъекта") Тогда
		
		Если ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("ДокументСсылка.Renault_Договор") Тогда
			ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаДоговоры, ТаблицаДоговоры_ДляУдаленияРегистрации);			
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("ДокументСсылка.Renault_РезервированиеАвтомобилей") Тогда
			ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаРезервы, ТаблицаРезервы_ДляУдаленияРегистрации);			
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных.Ссылка) = Тип("ДокументСсылка.CRM_ЗаписьНаВыдачу") Тогда
			ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаВыдачи, ТаблицаВыдачи_ДляУдаленияРегистрации);			
		КонецЕсли;
				
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("ДокументОбъект.Renault_Договор") Тогда		
		ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаДоговоры, ТаблицаДоговоры_ДляУдаленияРегистрации);	
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("ДокументОбъект.Renault_РезервированиеАвтомобилей") Тогда		
		ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаРезервы, ТаблицаРезервы_ДляУдаленияРегистрации);	
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("ДокументОбъект.CRM_ЗаписьНаВыдачу") Тогда		
		ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, ТаблицаВыдачи, ТаблицаВыдачи_ДляУдаленияРегистрации);	
	ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) =  Тип("РегистрНакопленияНаборЗаписей.ОстаткиАвтомобилей") Тогда
		БылоИзменениеОстатков = Истина;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУдалениеСсылочногоТипа(ЭлементИзмененныхДанных, Таблица, Таблица_ДляУдаленияРегистрации)
	
	Стр = Таблица.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	Стр.УдаленнаяЗапись = Истина;
	
	Стр = Таблица_ДляУдаленияРегистрации.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	
КонецПроцедуры

Процедура ДобавитьИзменениеСсылочногоТипа(ЭлементИзмененныхДанных, Таблица, Таблица_ДляУдаленияРегистрации)
	
	Стр = Таблица.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	Стр.УдаленнаяЗапись = Ложь;
	
	Стр = Таблица_ДляУдаленияРегистрации.Добавить();
	Стр.Ссылка = ЭлементИзмененныхДанных.Ссылка;
	
КонецПроцедуры