Процедура Обменяться() Экспорт
	
	ПланОбмена = ПолучитьПланОбмена();
	
	Если ЗначениеЗаполнено(ПланОбмена) тогда
		ВыполнитьОтправкуДанных(ПланОбмена);
	Иначе
		Renault_Открытый.СообщитьПользователю("Формирование отменено, не удалось определить план обмена");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПланОбмена()
		
	Выборка = ПланыОбмена.Renault_ОбменВПределахДилера.Выбрать();
	ЭтаБаза = ПланыОбмена.Renault_ОбменВПределахДилера.ЭтотУзел();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> ЭтаБаза Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

Функция ПолучитьПрокси()
	
	Адрес = "http://gate.rnlt.ru/renault-ws-gate/ws/DealerExchange.1cws?wsdl";
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	ОпределениеСервиса = Новый WSОпределения(Адрес, ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(
		ОпределениеСервиса, 
		"http://renault.ru/WSGate/DealerExchange", 
		"Renault_DealerExchange",
		"Renault_DealerExchangeSoap",
		3600);
	ВебСервис.Пользователь	 = ЛогинWS;
	ВебСервис.Пароль		 = ПарольWS;
	
	Возврат ВебСервис;
	                         
КонецФункции

Процедура ВыполнитьОтправкуДанных(ПланОбмена) Экспорт
	
	ВебСервис = ПолучитьПрокси();
	
	Сериализатор = Новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
	
	Server = СтрокаСоединенияИнформационнойБазы();
	BIR = Константы.Renault_BIR_db.Получить();

	Выборка = ПланыОбмена.ВыбратьИзменения(ПланОбмена, 2);
	
	//Посчитаем количество изменений
	ОбщееКоличество = 0;
	Пока Выборка.Следующий() Цикл
		ОбщееКоличество = ОбщееКоличество + 1;
	КонецЦикла;
	Выборка.Сбросить();
	
	//Заполним таблицы первоначальной информацией из плана обмена
	Счетчик = 0; ВсегоПередано = 0;
	БылоИзменениеОстатков = Ложь;
	Пока Выборка.Следующий() Цикл
		
		Если Счетчик = 0 Тогда
			ТаблицаДоговоры = ИнициализироватьТаблицуДоговоров();
			ТаблицаДоговоры_ДляУдаленияРегистрации = ТаблицаДоговоры.Скопировать();
			
			ТаблицаРезервы = ИнициализироватьТаблицуРезервов();
			ТаблицаРезервы_ДляУдаленияРегистрации = ТаблицаРезервы.Скопировать();
			
			ТаблицаВыдачи = ИнициализироватьТаблицуВыдачи();
			ТаблицаВыдачи_ДляУдаленияРегистрации = ТаблицаВыдачи.Скопировать();
		КонецЕсли;
		
		ЭлементИзмененныхДанных = Выборка.Получить();
		ДобавитьЭлементВТаблицуДляОтправки(ЭлементИзмененныхДанных, БылоИзменениеОстатков, 
			ТаблицаДоговоры, 				ТаблицаДоговоры_ДляУдаленияРегистрации,
			ТаблицаРезервы,					ТаблицаРезервы_ДляУдаленияРегистрации,
			ТаблицаВыдачи,					ТаблицаВыдачи_ДляУдаленияРегистрации);
		
		Счетчик = Счетчик + 1;
		ВсегоПередано = ВсегоПередано + 1;
		
		Если Счетчик = 10000 ИЛИ ВсегоПередано = ОбщееКоличество Тогда
			
			//Дозаполним таблицы информацией из базы
			ЗаполнитьТаблицуДоговоры(ТаблицаДоговоры, BIR);
			ЗаполнитьТаблицуРезервы(ТаблицаРезервы, BIR);
			ЗаполнитьТаблицуВыдачи(ТаблицаВыдачи, BIR);
			
			ОтправитьТаблицу("SetContracts", ТаблицаДоговоры, ТаблицаДоговоры_ДляУдаленияРегистрации, ВебСервис, Сериализатор, Server, BIR, ПланОбмена);
			ОтправитьТаблицу("ЗагрузитьРезервы", ТаблицаРезервы, ТаблицаРезервы_ДляУдаленияРегистрации, ВебСервис, Сериализатор, Server, BIR, ПланОбмена);
			ОтправитьТаблицу("ЗагрузитьВыдачи", ТаблицаВыдачи, ТаблицаВыдачи_ДляУдаленияРегистрации, ВебСервис, Сериализатор, Server, BIR, ПланОбмена);
			Если ВсегоПередано = ОбщееКоличество Тогда
				ОтправитьТаблицуОстатков(ВебСервис, Сериализатор, Server, BIR, ПланОбмена, БылоИзменениеОстатков);
			КонецЕсли;
			
			Счетчик = 0;
			
		КонецЕсли;
		
	КонецЦикла;                      
		
КонецПроцедуры

Процедура ОтправитьТаблицу(Команда, Таблица, Таблица_ДляУдаленияРегистрации, ВебСервис, Сериализатор, Server, BIR, ПланОбмена)
	
	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
			
	СериализованнаяТаблица = Сериализатор.ЗаписатьXDTO(Таблица);
	ДанныеОтправлены = ВебСервис.SetDataFromDealerToServer(Команда, СериализованнаяТаблица, Server);
	
	Если ДанныеОтправлены Тогда
		ОтменитьРегистрациюСправочника(Таблица_ДляУдаленияРегистрации, ПланОбмена);
	КонецЕсли;
					
КонецПроцедуры

Процедура ОтправитьТаблицуОстатков(ВебСервис, Сериализатор, Server, BIR, ПланОбмена, БылоИзменениеОстатков)
	
	Если Не БылоИзменениеОстатков Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&BIR КАК ИдентификаторИБ,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.VIN КАК VIN,
		|	ОстаткиАвтомобилейОстатки.СкладКомпании.Наименование КАК Склад
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки";
	Запрос.УстановитьПараметр("BIR", BIR);
	Таблица = Запрос.Выполнить().Выгрузить();
	ДополнитьТаблицуДанныхУИДами(Таблица);
			
	СериализованнаяТаблица = Сериализатор.ЗаписатьXDTO(Таблица);
	ДанныеОтправлены = ВебСервис.SetDataFromDealerToServer("ЗагрузитьОстатки", СериализованнаяТаблица, Server);
	
	Если ДанныеОтправлены Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(ПланОбмена, Метаданные.РегистрыНакопления.ОстаткиАвтомобилей);
	КонецЕсли;
					
КонецПроцедуры

Процедура ОтменитьРегистрациюСправочника(ТаблицаОписание, ПланОбмена)

	Для Каждого КлючевыеПоля из ТаблицаОписание Цикл
		
		ПланыОбмена.УдалитьРегистрациюИзменений(ПланОбмена, КлючевыеПоля.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуДоговоры(ТаблицаДоговоры, BIR)
	
	Если ТаблицаДоговоры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Данные.Ссылка,
		|	Данные.УдаленнаяЗапись
		|ПОМЕСТИТЬ ВтДанные
		|ИЗ
		|	&Таблица КАК Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&BIR КАК ИдентификаторИБ,
		|	Renault_Договор.Дата,
		|	Renault_Договор.ПометкаУдаления,
		|	Данные.Ссылка,
		|	Renault_Договор.ДилерскийЦентр.Наименование КАК ДилерскийЦентр,
		|	Данные.УдаленнаяЗапись КАК УдаленнаяЗапись,
		|	Renault_Договор.СоставДоговора.(
		|		VIN
		|	),
		|	Renault_Договор.РабочийЛист,
		|	Renault_Договор.Проведен,
		|	ВЫБОР
		|		КОГДА (Renault_Договор.СтатусПредварительныхДокументов = &СтатусРезерва
		|				ИЛИ Renault_Договор.СтатусОкончательныхДокументов = &СтатусРезерва)
		|				И Renault_Договор.СтатусДоговора <> ЗНАЧЕНИЕ(Перечисление.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Расторгнут)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Резерв,
		|	""Контракт"" КАК Тип_,
		|	Renault_Договор.Менеджер.Наименование КАК Менеджер
		|ИЗ
		|	ВтДанные КАК Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Договор КАК Renault_Договор
		|		ПО Данные.Ссылка = Renault_Договор.Ссылка";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДоговоры);
	Запрос.УстановитьПараметр("BIR", BIR);
	Запрос.УстановитьПараметр("СтатусРезерва", Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан);
	ТаблицаДоговоры = Запрос.Выполнить().Выгрузить();
	ДополнитьТаблицуДанныхУИДами(ТаблицаДоговоры);
	
КонецПроцедуры

