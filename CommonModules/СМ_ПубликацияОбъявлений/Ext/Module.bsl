Функция ДописатьОпции(ВариантКомплектации,XML_Полный,ЭтоАвито);

	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ОпцииВариантовКомплектации.Опция КАК Опция,
	             |	ОпцииВариантовКомплектации.Опция.Наименование КАК ОпцияНаименование,
	             |	ОпцииВариантовКомплектации.Количество КАК Количество,
	             |	ОпцииВариантовКомплектации.Опция.ОпцияАвтоРу КАК ОпцияАвтоРу,
	             |	ОпцииВариантовКомплектации.Опция.ОпцияАвито КАК ОпцияАвито,
	             |	ОпцииВариантовКомплектации.Опция.ОпцияАвито.Родитель КАК ОпцияАвитоРодитель
	             |ИЗ
	             |	РегистрСведений.ОпцииВариантовКомплектации КАК ОпцииВариантовКомплектации
	             |ГДЕ
	             |	ОпцииВариантовКомплектации.ВариантКомплектации = &ВариантКомплектации
	             |	И (ОпцииВариантовКомплектации.ВидВключения = 2
	             |			ИЛИ ОпцииВариантовКомплектации.ВидВключения = 1)
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ОпцияНаименование";
	Запрос.УстановитьПараметр("ВариантКомплектации",ВариантКомплектации);
	
	тзОпции=Запрос.Выполнить().Выгрузить();
	
	СписокОпцийАвтоРу = "";
	
	Для каждого Стр Из тзОпции Цикл 
		Если ЭтоАвито Тогда
			Если обЗначениеНеЗаполнено(Стр.ОпцияАвито) Тогда
				Продолжить;
			КонецЕсли; 
			Если обЗначениеНеЗаполнено(Стр.ОпцияАвитоРодитель) Тогда
				Продолжить;
			КонецЕсли; 
			opc_str = СокрЛП(Стр.ОпцияАвито);
			//Бондаренко++ 20230613
			name_opc_str = СтрЗаменить(СокрЛП(Стр.ОпцияАвитоРодитель)," ","");
			//Бондаренко-- 20230613
			XML_Полный.ЗаписатьНачалоЭлемента(""+name_opc_str);      XML_Полный.ЗаписатьТекст(opc_str);             XML_Полный.ЗаписатьКонецЭлемента();
		Иначе
			Если обЗначениеНеЗаполнено(Стр.ОпцияАвтоРу) Тогда
				Продолжить;
			КонецЕсли; 
 			opc_str = СокрЛП(Стр.ОпцияАвтоРу);
			Если СписокОпцийАвтоРу <> "" Тогда
				СписокОпцийАвтоРу = СписокОпцийАвтоРу+", "+opc_str;
 			Иначе
				СписокОпцийАвтоРу = opc_str;			
			КонецЕсли;
 		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЭтоАвито Тогда
 		XML_Полный.ЗаписатьНачалоЭлемента("extras");      XML_Полный.ЗаписатьТекст(opc_str);             XML_Полный.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
КонецФункции // ДописатьОпции(ВарКомпл,XML_Полный,ЭтоАвито)
