Функция ПолучитьМестоположенияАвто(ТекАвто) Экспорт
	
	ТаблицаАвто = ПолучитьТаблицуАвто();
	
	Доступность_ = Истина;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Автомобиль",ТекАвто);
	НайденныеСтроки = ТаблицаАвто.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Доступность_ = НайденныеСтроки[0].Доступность;	
	КонецЕсли;
	
	Возврат Доступность_;
	
КонецФункции // ПолучитьМестоположенияАвто(ТекАвто)

Функция ПолучитьВнешнийНомерЗаказа(Автомобиль) Экспорт
	
	ВнешнийНомерЗаказа_ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.КоличествоОстаток,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику.ВнешнийНомерЗаказа КАК ВнешнийНомерЗаказа
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикамНаАвтомобили.Остатки КАК ЗаказыПоставщикамНаАвтомобилиОстатки
	|ГДЕ
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.КоличествоОстаток > 0
	|	И ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВнешнийНомерЗаказа_ = ВыборкаДетальныеЗаписи.ВнешнийНомерЗаказа;
	КонецЦикла;
	
	Возврат ВнешнийНомерЗаказа_;
	
КонецФункции // ПолучитьВнешнийНомерЗаказа()

Функция ПолучитьПодразделениеАвто(ТекАвто) Экспорт
	
	ТаблицаАвто = ПолучитьТаблицуАвто();
	
	Подразделение_ = Справочники.ПодразделенияКомпании.ПустаяСсылка();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Автомобиль",ТекАвто);
	НайденныеСтроки = ТаблицаАвто.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Подразделение_ = НайденныеСтроки[0].Подразделение;	
	КонецЕсли;
	
	Возврат Подразделение_;
	
КонецФункции // ПолучитьПодразделениеАвто(ТекАвто)
