	XML_Полный.ЗаписатьНачалоЭлемента("Address");             XML_Полный.ЗаписатьТекст(АдресОтделаПродаж);                       XML_Полный.ЗаписатьКонецЭлемента();
	
	//Бондаренко++ 20220714
	//ТекстКлассифайда = СокрЛП(ТекАвто.ТекстКлассифайда);
	ТекстКлассифайда = СМ_ВыгрузкаОбъявленийОПродажеАвто.СМГ_СправочникВернутьЗначениеРеквизита("ТекстКлассифайда",ТекАвто.ПолучитьОбъект());
	//Бондаренко-- 20220714
	
	Если обЗначениеНеЗаполнено(ТекстКлассифайда) Тогда
		ТекПодразделение = ПолучитьПодразделениеАвто(ТекАвто);
		Если Не обЗначениеНеЗаполнено(ТекПодразделение) Тогда
			ТекстКлассифайда = СокрЛП(ТекПодразделение.ТекстКлассифайда);
			Если обЗначениеНеЗаполнено(ТекстКлассифайда) Тогда
				Попытка ТекстКлассифайда = СокрЛП(ТекПодразделение.Родитель.ТекстКлассифайда); Исключение	КонецПопытки;  
				Если обЗначениеНеЗаполнено(ТекстКлассифайда) Тогда
					Попытка ТекстКлассифайда = СокрЛП(ТекПодразделение.Родитель.Родитель.ТекстКлассифайда); Исключение	КонецПопытки;  
				КонецЕсли; 		
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли; 
	XML_Полный.ЗаписатьНачалоЭлемента("Description");         XML_Полный.ЗаписатьТекст(ТекстКлассифайда);                        XML_Полный.ЗаписатьКонецЭлемента();	 //Description
	
	XML_Полный.ЗаписатьНачалоЭлемента("Category");            XML_Полный.ЗаписатьТекст("Автомобили");                            XML_Полный.ЗаписатьКонецЭлемента();	 //Category
	XML_Полный.ЗаписатьНачалоЭлемента("CarType");             XML_Полный.ЗаписатьТекст("Новые");                                 XML_Полный.ЗаписатьКонецЭлемента();	 //CarType
	
	ПолнаяЦенаПродажи = 0.00;
	ПарОтбора = Новый Структура();
	ПарОтбора.Вставить("Автомобиль",ТекАвто);
	ПарОтбора.Вставить("ТипЦен",Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	ЦенаАвто = РегистрыСведений.ЦеныАвтомобилей.ПолучитьПоследнее(ТекущаяДата(),ПарОтбора).Цена;
	ПолнаяЦенаПродажи = ЦенаАвто+ТекАвто.СтоимостьДопОборудования;
	
	//Бондаренко++ 20231219 
	Если  ТекАвто.СтоимостьДопОборудованияМаркетинг <> 0 Тогда
		ПолнаяЦенаПродажи = ЦенаАвто+ТекАвто.СтоимостьДопОборудованияМаркетинг;
 	КонецЕсли;
	//Бондаренко-- 20231219 
	
	XML_Полный.ЗаписатьНачалоЭлемента("Price");          XML_Полный.ЗаписатьТекст(СтрЗаменить(ПолнаяЦенаПродажи,Символы.НПП,""));  XML_Полный.ЗаписатьКонецЭлемента();		 			
	
	//Бондаренко++ 20250221
 	СуммаОбычныхСкидок  = 0;
 	СуммаМаркетинговыхСкидок = 0;
	
