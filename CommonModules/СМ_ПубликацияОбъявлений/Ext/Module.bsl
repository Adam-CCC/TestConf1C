	//XML_Полный.ЗаписатьНачалоЭлемента("Contact");   XML_Полный.ЗаписатьТекст("Ростов-на-Дону, Шолохова, 235 Телефоны: +7(863)222-84-97"); XML_Полный.ЗаписатьКонецЭлемента();
