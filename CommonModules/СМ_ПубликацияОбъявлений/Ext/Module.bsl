Функция ПолучитьТаблицуЛичногоКабинетаДромИзЗапроса(HTTPRequest) Экспорт
	
	КодЛичногоКабинета = HTTPRequest.ПараметрыURL["UnitCode"];
	
	Запрос = Новый Запрос;
	Запрос.Текст =	"ВЫБРАТЬ
	|	СМ_ЛичныеКабинеты_ДромМарки.Ссылка.Код КАК КодЛичногоКабинета,
	|	СМ_ЛичныеКабинеты_ДромМарки.Ссылка.Ссылка КАК ЛичныйКабинет,
	|	СМ_ЛичныеКабинеты_ДромМарки.Марка,
	|	СМ_ЛичныеКабинеты_ДромМарки.ПредставлениеТелефона,
	|	СМ_ЛичныеКабинеты_ДромПодразделения.Подразделение,
	|	СМ_ЛичныеКабинеты_ДромМарки.Адрес
	|ИЗ
	|	Справочник.СМ_ЛичныеКабинеты_Дром.Марки КАК СМ_ЛичныеКабинеты_ДромМарки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СМ_ЛичныеКабинеты_ДромПодразделения.Ссылка КАК Ссылка,
	|			СМ_ЛичныеКабинеты_ДромПодразделения.ИдентификаторМарки КАК ИдентификаторМарки,
	|			СМ_ЛичныеКабинеты_ДромПодразделения.Подразделение КАК Подразделение
	|		ИЗ
	|			Справочник.СМ_ЛичныеКабинеты_Дром.Подразделения КАК СМ_ЛичныеКабинеты_ДромПодразделения) КАК СМ_ЛичныеКабинеты_ДромПодразделения
	|		ПО СМ_ЛичныеКабинеты_ДромМарки.Ссылка = СМ_ЛичныеКабинеты_ДромПодразделения.Ссылка
	|			И СМ_ЛичныеКабинеты_ДромМарки.ИдентификаторМарки = СМ_ЛичныеКабинеты_ДромПодразделения.ИдентификаторМарки
	|ГДЕ
	|	СМ_ЛичныеКабинеты_ДромМарки.Ссылка.Код = &КодЛичногоКабинета";
	
	Запрос.УстановитьПараметр("КодЛичногоКабинета", КодЛичногоКабинета);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;
	
КонецФункции  // ПолучитьТаблицуЛичногоКабинетаДромИзЗапроса(HTTPRequest) 

