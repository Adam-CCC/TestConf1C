Функция ПолучитьТаблицуОстатков(СписокНеликвида,СписокВыгружатьНаСайтОбъявлений,СписокДЦ)

	СписокТиповСклада = Новый СписокЗначений;
	СписокТиповСклада.Добавить(Перечисления.ТипыСкладов.Витрина);
	СписокТиповСклада.Добавить(Перечисления.ТипыСкладов.ЗапЧасти);
	СписокТиповСклада.Добавить(Перечисления.ТипыСкладов.Хозяйстенный);
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура,
		|	СУММА(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток) КАК КоличествоОстаток,
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение.ДилерскийЦентр КАК ДилерскийЦентр,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Наименование КАК НоменклатураНаименование
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки КАК ОстаткиТоваровКомпанииОстатки
		|ГДЕ
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение.ДилерскийЦентр В (&СписокДилерскихЦентров)
		|			И ОстаткиТоваровКомпанииОстатки.СкладКомпании.ТипСклада В (&СписокТиповСклада)
		|			И (ОстаткиТоваровКомпанииОстатки.Номенклатура В (&СписокНеликвида)
		|				ИЛИ ОстаткиТоваровКомпанииОстатки.Номенклатура В (&СписокВыгружатьНаСайтОбъявлений))
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура,
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение.ДилерскийЦентр,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	НоменклатураНаименование";
	
	Запрос.УстановитьПараметр("СписокДилерскихЦентров", СписокДЦ);
  	Запрос.УстановитьПараметр("СписокТиповСклада", СписокТиповСклада);          
	Запрос.УстановитьПараметр("СписокНеликвида", СписокНеликвида);
