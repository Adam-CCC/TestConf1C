Функция ПолучитьXMLОбъявленийLegoCarLk(HTTPRequest,FlagHTTPService) Экспорт
	
	ТаблицаАвто = ПолучитьТаблицуАвто();
	
  	Если FlagHTTPService Тогда
		ТаблицаДляВыгрузки = ПолучитьТаблицуЛичногоКабинетаЛегоКарИзЗапроса(HTTPRequest.ПараметрыURL["UnitCode"]);
	Иначе	
		ТаблицаДляВыгрузки = ПолучитьТаблицуЛичногоКабинетаЛегоКарИзЗапроса(Прав(HTTPRequest,9));
	КонецЕсли;
 	

 	СписокАвто = ПолучитьСписокАвтоОстатковИзаказов(ТаблицаДляВыгрузки);

 	
	XML_Полный=Новый ЗаписьXML();
	XML_Полный.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8","1.0",false));
	XML_Полный.ЗаписатьОбъявлениеXML();
	
	XML_Полный.ЗаписатьНачалоЭлемента("auto-catalog");
	XML_Полный.ЗаписатьНачалоЭлемента("offers");
	//XML_Полный.ЗаписатьАтрибут("formatVersion","3");
	//XML_Полный.ЗаписатьАтрибут("target","LegoCar.ru"); 
	

 	Если СписокАвто.Количество() > 0 Тогда
		Для каждого Эл Из СписокАвто Цикл
			
			ТекАвто = Эл.Значение; 
			
 		 	Если НЕ АвтомобильНовый(ТекАвто) Тогда
  				Продолжить;
			КонецЕсли;             
			
 			Если НЕ ТекАвто.ВыгружатьАвтомобильНаСайт Тогда
				Продолжить;	
			КонецЕсли; 
  	 			
 			ПодразделениеАвто = "";
			ПодразделениеАвто = НайтиПодрАвто(ТекАвто,ТаблицаАвто);
 			
			Если обЗначениеНеЗаполнено(ПодразделениеАвто) Тогда
				АдресОП   = ПолучитьАдресОтделаПродаж(ТаблицаДляВыгрузки,ТекАвто.Модель.Марка);
				ТелефонОП = ПолучитьТелефонОтделаПродаж(ТаблицаДляВыгрузки,ТекАвто.Модель.Марка);
			Иначе
				АдресОП   = ПолучитьАдресОтделаПродажПодразделения(ТаблицаДляВыгрузки,ТекАвто.Модель.Марка,ПодразделениеАвто);
				ТелефонОП = ПолучитьТелефонОтделаПродажПодразделения(ТаблицаДляВыгрузки,ТекАвто.Модель.Марка,ПодразделениеАвто);
			КонецЕсли;
 			Если обЗначениеНеЗаполнено(АдресОП) ИЛИ обЗначениеНеЗаполнено(ТелефонОП) Тогда
				Продолжить;
			КонецЕсли;
    			
			Если FlagHTTPService Тогда
 				ЗаполнитьОбъявлениеЛегоКарЛегковой(ТекАвто,HTTPRequest.БазовыйURL,АдресОП,ТелефонОП, XML_Полный); 

			Иначе
				ЗаполнитьОбъявлениеЛегоКарЛегковой(ТекАвто,Сред(HTTPRequest,1,СтрДлина(HTTPRequest)-21),АдресОП,ТелефонОП, XML_Полный); 
 			КонецЕсли;
			
		КонецЦикла;             
	КонецЕсли;
	
	XML_Полный.ЗаписатьКонецЭлемента();     //offers
	XML_Полный.ЗаписатьКонецЭлемента();     //auto-catalog 
 	XMLТекст = XML_Полный.Закрыть();
	Возврат XMLТекст;
	
КонецФункции // ПолучитьXMLОбъявленийLegoCarLk(HTTPRequest,FlagHTTPService)

