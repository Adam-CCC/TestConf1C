Функция ОпределитьВидАвто(ТекАвто) Экспорт 
	
	ВидАвто = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АвтомобилиСрезПоследних.Автомобиль,
	|	АвтомобилиСрезПоследних.ВидЗначения,
	|	АвтомобилиСрезПоследних.Значение
	|ИЗ
	|	РегистрСведений.Автомобили.СрезПоследних(&ДатаЗапроса, ) КАК АвтомобилиСрезПоследних
	|ГДЕ
	|	АвтомобилиСрезПоследних.Автомобиль = &Автомобиль
	|	И АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения";
	
	Запрос.УстановитьПараметр("Автомобиль", ТекАвто);
	Запрос.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля);
	Запрос.УстановитьПараметр("ДатаЗапроса",ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВидАвто = ВыборкаДетальныеЗаписи.Значение;		
	КонецЦикла;
	
	Возврат ВидАвто;
	
КонецФункции // ОпределитьВидАвто(ТекАвто)

Функция НайтиСТС(Авто) Экспорт
	
	НомерСТС = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Ссылка,
	|	ПодтверждающиеДокументы.ПометкаУдаления,
	|	ПодтверждающиеДокументы.ВидПодтверждающегоДокумента,
	|	ПодтверждающиеДокументы.Номер,
	|	ПодтверждающиеДокументы.Серия,
	|	ПодтверждающиеДокументы.Устаревший,
	|	ПодтверждающиеДокументы.Владелец
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Владелец
	|	И НЕ ПодтверждающиеДокументы.Устаревший
	|	И НЕ ПодтверждающиеДокументы.ПометкаУдаления
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = &ВидПодтверждающегоДокумента";
	
	Запрос.УстановитьПараметр("ВидПодтверждающегоДокумента",Перечисления.ВидыДокументов.Свидетельство);
	Запрос.УстановитьПараметр("Владелец", Авто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НомерСТС = СокрЛП(СтрЗаменить(ВыборкаДетальныеЗаписи.Серия," ",""))+СокрЛП(ВыборкаДетальныеЗаписи.Номер);
	КонецЦикла;
	
	Возврат НомерСТС;
	
КонецФункции // НайтиСТС(Авто)

Функция ПолучитьТаблицуСкидок(СписокАвто) Экспорт        
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Автомобили.Ссылка,
	|	Автомобили.СкидаПриПокупкеВТрейдИн,
	|	Автомобили.СкидкаМаксимальная,
	|	Автомобили.СкидкаПриПокупкеВКредит,
	|	Автомобили.СкидкаПриСтраховании,
	|	Автомобили.СпециальнаяЦена,
	|	Автомобили.VIN
	|ИЗ
	|	Справочник.Автомобили КАК Автомобили
	|ГДЕ
	|	(Автомобили.СкидкаПриСтраховании <> 0
	|			ИЛИ Автомобили.СкидкаПриПокупкеВКредит <> 0
	|			ИЛИ Автомобили.СкидкаМаксимальная <> 0
	|			ИЛИ Автомобили.СкидаПриПокупкеВТрейдИн <> 0
	|			ИЛИ Автомобили.СпециальнаяЦена <> 0)
	|	И Автомобили.Ссылка В(&СписокАвто)";
	
	Запрос.УстановитьПараметр("СписокАвто",СписокАвто);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
