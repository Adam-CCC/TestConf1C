//Бондаренко++ 20220315
Функция ПолучитьСписокМарокИзЗапроса(HTTPRequest) Экспорт
	
	сзБренды = Неопределено;
	
	СтрокаБрендов = HTTPRequest.ПараметрыЗапроса.Получить("brand");
	
	Если СтрокаБрендов <> Неопределено  Тогда
		
		сзБренды = Новый СписокЗначений;
		сзБренды.ЗагрузитьЗначения(обМояРазложитьСтрокуВМассивПодстрок(СтрокаБрендов,","));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Марка.Ссылка КАК Марка,
		|	Марка.Наименование
		|ИЗ
		|	Справочник.Марка КАК Марка
		|ГДЕ
		|	Марка.Наименование В (&СписокНаименованийБрендов)";
		
		Запрос.УстановитьПараметр("СписокНаименованийБрендов", сзБренды);
		
		сзБренды.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Марка"));
		
	КонецЕсли;
	
	Возврат сзБренды;
	
КонецФункции  
