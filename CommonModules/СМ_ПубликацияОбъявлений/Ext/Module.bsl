Функция ПолучитьТаблицуЛичногоКабинетаЗапчастиАвитоИзЗапроса(КодЛичногоКабинета) Экспорт
	
  	Запрос = Новый Запрос;
	Запрос.Текст =	"ВЫБРАТЬ
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.Ссылка.Ссылка,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.Ссылка.Код,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.ГруппаПодразделенийКомпании,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.ПредставлениеТелефона,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.Адрес,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.ГруппаПодразделенийКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.Ссылка.МинимальнаяЦена,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.Ссылка.ТипЦен,
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.Ссылка.ПроцентНаценкиСкидки
	              	|ИЗ
	              	|	Справочник.СМ_ЛичныеКабинеты_Авито_Запчасти.Подразделения КАК СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения
	              	|ГДЕ
	              	|	СМ_ЛичныеКабинеты_Авито_ЗапчастиПодразделения.Ссылка.Код = &КодЛичногоКабинета";
	
	Запрос.УстановитьПараметр("КодЛичногоКабинета", КодЛичногоКабинета);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;
	
