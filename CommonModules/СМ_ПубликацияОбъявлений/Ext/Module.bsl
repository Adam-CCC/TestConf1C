	Исключение
	КонецПопытки;
	
	Если СуммаОбычныхСкидок > СуммаМаркетинговыхСкидок Тогда
		Если НЕ обЗначениеНезаполнено(ТекАвто.СкидкаПриСтраховании) Тогда
			XML_Полный.ЗаписатьНачалоЭлемента("InsuranceDiscount");  XML_Полный.ЗаписатьТекст(СокрЛП(СтрЗаменить(ТекАвто.СкидкаПриСтраховании,Символы.НПП,"")));         XML_Полный.ЗаписатьКонецЭлемента();  
