	Запрос.УстановитьПараметр("СписокМарок",СписокМарок);
	
	ТаблицаИсточник = Запрос.Выполнить().Выгрузить(); 
	
	Если ТаблицаИсточник.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
			Если СокрЛП(СтрокаТаблицыИсточник.VIN) <> "" Тогда
				НайденнаяСтрока = ТЗ.Найти(СтрокаТаблицыИсточник.VIN, "VIN");
			Иначе	
				НайденнаяСтрока = ТЗ.Найти(СтрокаТаблицыИсточник.ВнешнийНомерЗаказа, "ВнешнийНомерЗаказа");
			КонецЕсли;
			Если НайденнаяСтрока = Неопределено Тогда
				НовСтрока = ТЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТаблицыИсточник);
				//Бондаренко++ 20230714
				Если ( СтрокаТаблицыИсточник.Марка = Справочники.Марка.CHANGAN ) И ( СтрокаТаблицыИсточник.ЗаказПоставщикуНаАвто.СтатусАвтомобиля <> Справочники.СтатусыАвтомобилей.Фейк ) Тогда
					НовСтрока.МестоАвто = "В наличии";
				КонецЕсли;
				//Бондаренко-- 20230714
				//Бондаренко++ 20230823
				Если СтрокаТаблицыИсточник.Марка = Справочники.Марка.CHERY Тогда
					НовСтрока.МестоАвто = "В наличии";
				КонецЕсли;
				//Бондаренко-- 20230823
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТЗ;
	
