Функция ПолучитьСписокНеликвида()
 	
	Запрос = Новый Запрос;
	
	Запрос.Текст =	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	              	|	УценкаТоваров.Номенклатура КАК НоменклатураУценки,
