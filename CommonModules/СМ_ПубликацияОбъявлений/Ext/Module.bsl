Функция ПолучитьТаблицуЛичногоКабинетаАвтоРуИзЗапроса(HTTPRequest) Экспорт
	
	КодЛичногоКабинета = HTTPRequest.ПараметрыURL["UnitCode"];
	
	Запрос = Новый Запрос;
	Запрос.Текст =	"ВЫБРАТЬ
	              	|	СМ_ЛичныеКабинеты_АвтоРуМарки.Ссылка.Код КАК КодЛичногоКабинета,
	              	|	СМ_ЛичныеКабинеты_АвтоРуМарки.Ссылка.Ссылка КАК ЛичныйКабинет,
	              	|	СМ_ЛичныеКабинеты_АвтоРуМарки.Марка,
	              	|	СМ_ЛичныеКабинеты_АвтоРуМарки.ПредставлениеТелефона,
	              	|	СМ_ЛичныеКабинеты_АвтоРуПодразделения.Подразделение,
	              	|	СМ_ЛичныеКабинеты_АвтоРуМарки.Адрес
	              	|ИЗ
	              	|	Справочник.СМ_ЛичныеКабинеты_АвтоРу.Марки КАК СМ_ЛичныеКабинеты_АвтоРуМарки
	              	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	              	|			СМ_ЛичныеКабинеты_АвтоРуПодразделения.Ссылка КАК Ссылка,
	              	|			СМ_ЛичныеКабинеты_АвтоРуПодразделения.ИдентификаторМарки КАК ИдентификаторМарки,
	              	|			СМ_ЛичныеКабинеты_АвтоРуПодразделения.Подразделение КАК Подразделение
	              	|		ИЗ
	              	|			Справочник.СМ_ЛичныеКабинеты_АвтоРу.Подразделения КАК СМ_ЛичныеКабинеты_АвтоРуПодразделения) КАК СМ_ЛичныеКабинеты_АвтоРуПодразделения
	              	|		ПО СМ_ЛичныеКабинеты_АвтоРуМарки.Ссылка = СМ_ЛичныеКабинеты_АвтоРуПодразделения.Ссылка
	              	|			И СМ_ЛичныеКабинеты_АвтоРуМарки.ИдентификаторМарки = СМ_ЛичныеКабинеты_АвтоРуПодразделения.ИдентификаторМарки
	              	|ГДЕ
	              	|	СМ_ЛичныеКабинеты_АвтоРуМарки.Ссылка.Код = &КодЛичногоКабинета";
	
	Запрос.УстановитьПараметр("КодЛичногоКабинета", КодЛичногоКабинета);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;
	
