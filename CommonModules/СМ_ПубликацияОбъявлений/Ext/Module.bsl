Функция ПолучитьМинимальнуюЦенуЗапчастей(ТаблицаДляВыгрузки,ТекДЦ)

	МинЦена = "";
	
	Отбор = Новый Структура();
 	Отбор.Вставить("ДилерскийЦентр",ТекДЦ);
	Строки = ТаблицаДляВыгрузки.НайтиСтроки(Отбор);
	
	Если Строки.Количество() > 0 Тогда
	    МинЦена = Строки[0].МинимальнаяЦена;
	КонецЕсли;
	
	Возврат МинЦена;
 	
КонецФункции // ПолучитьМинимальнуюЦенуЗапчастей(ТаблицаДляВыгрузки,ТекДЦ)
