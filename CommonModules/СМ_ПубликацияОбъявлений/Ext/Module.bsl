Функция ПолучитьТелефонОтделаПродажПодразделения(ТаблицаВыгрузки,Марка,Подразделение) Экспорт
	
	Телефон_ = "";
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Марка",Марка);
	ПараметрыОтбора.Вставить("Подразделение",Подразделение);
	
	НайденныеСтроки = ТаблицаВыгрузки.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		Телефон_ = СтрЗаменить(НайденныеСтроки[0].ПредставлениеТелефона,", ","");	
	Иначе
		ПараметрыОтбора.Вставить("Подразделение",Подразделение.Родитель);
		НайденныеСтроки = ТаблицаВыгрузки.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			Телефон_ = СтрЗаменить(НайденныеСтроки[0].ПредставлениеТелефона,", ","");	
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Телефон_;
	
