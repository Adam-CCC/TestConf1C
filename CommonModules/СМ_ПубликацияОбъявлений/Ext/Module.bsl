Функция ПолучитьXMLОбъявленийAvitoZapLk(HTTPRequest) Экспорт
	
	СписокНеликвида = ПолучитьСписокНеликвида();
	//Бондаренко++ 20231028
	СписокВыгружатьНаСайтОбъявлений = ПолучитьСписокВыгружатьНаСайтОбъявлений();
	//Бондаренко-- 20231028
	
	СписокДЦ = Новый СписокЗначений;
 	ТаблицаДляВыгрузки = ПолучитьТаблицуЛичногоКабинетаЗапчастиАвитоИзЗапроса(HTTPRequest.ПараметрыURL["UnitCode"]);
   	СписокДЦ.ЗагрузитьЗначения(ТаблицаДляВыгрузки.ВыгрузитьКолонку("ДилерскийЦентр"));
	
	ТаблицаОстатков = ПолучитьТаблицуОстатков(СписокНеликвида,СписокВыгружатьНаСайтОбъявлений,СписокДЦ);
	
	XML_Полный=Новый ЗаписьXML();
	XML_Полный.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8","1.0",false));
	XML_Полный.ЗаписатьОбъявлениеXML();
	
	XML_Полный.ЗаписатьНачалоЭлемента("Ads");
	XML_Полный.ЗаписатьАтрибут("formatVersion","3");
	XML_Полный.ЗаписатьАтрибут("target","Avito.ru"); 
	
	//Бондаренко++ 20220628
	Если ТаблицаОстатков.Количество() > 0 Тогда
		
		Для каждого Эл Из ТаблицаОстатков Цикл
			
			ТекНом = Эл.Номенклатура;
			ТекДЦ = Эл.ДилерскийЦентр;
  			
		    АдресОП   = ПолучитьАдресОтделаПродажЗапчастей(ТаблицаДляВыгрузки,ТекДЦ);
			ТелефонОП = ПолучитьТелефонОтделаПродажЗапчастей(ТаблицаДляВыгрузки,ТекДЦ); 
			
			МинимальнаяЦенаЗапчастей = 0;
			МинимальнаяЦенаЗапчастей = ПолучитьМинимальнуюЦенуЗапчастей(ТаблицаДляВыгрузки,ТекДЦ);
			
			//Бондаренко++ 20231028
			ТипЦенЗапчастей = ПолучитьТипЦенЗапчастей(ТаблицаДляВыгрузки,ТекДЦ);
			ПроцентСкидкиНаценкиЗапчастей = ПолучитьПроцентНаценкиСкидкиЗапчастей(ТаблицаДляВыгрузки,ТекДЦ);
			//Бондаренко-- 20231028
			
			Если обЗначениеНеЗаполнено(АдресОП) ИЛИ обЗначениеНеЗаполнено(ТелефонОП) Тогда
				Продолжить;
			КонецЕсли;
			
			//Бондаренко++ 20231028
			Если МинимальнаяЦенаЗапчастей > 0 Тогда
				
				ЦенаПродажи = 0; 
				
				Если СписокНеликвида.НайтиПоЗначению(ТекНом) <> Неопределено Тогда
 					ОтборЦен = Новый Структура(); 
					ОтборЦен.Вставить("ТипЦен",Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
					ОтборЦен.Вставить("Номенклатура",ТекНом);	
					ТецЦена = РегистрыСведений.Цены.ПолучитьПоследнее(ТекущаяДата(),ОтборЦен);
					ЦенаПродажи = ТецЦена.Цена;
				Иначе
 					ОтборЦен = Новый Структура(); 
					ОтборЦен.Вставить("ТипЦен",ТипЦенЗапчастей);
					ОтборЦен.Вставить("Номенклатура",ТекНом);	
					ТецЦена = РегистрыСведений.Цены.ПолучитьПоследнее(ТекущаяДата(),ОтборЦен) ;
					ЦенаПродажи = ТецЦена.Цена*(100+ПроцентСкидкиНаценкиЗапчастей)/100;
				КонецЕсли;
				
 				Если ЦенаПродажи < МинимальнаяЦенаЗапчастей Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			//Бондаренко-- 20231028
			
			ЗаполнитьОбъявлениеНаЗапчасть(ЦенаПродажи,ТекНом,HTTPRequest,АдресОП,ТелефонОП, XML_Полный); 
			
		КонецЦикла;             
	КонецЕсли;
	//Бондаренко-- 20220628 
  	
	XML_Полный.ЗаписатьКонецЭлемента();     //Ads
	XMLТекст = XML_Полный.Закрыть();
	Возврат XMLТекст;
	
