Функция ПолучитьСписокМарокАвто(Подр) Экспорт
	
	СЗ = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпанииМаркиАвтомобилей.Ссылка,
