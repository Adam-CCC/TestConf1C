	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику.ПодразделениеКомпании.ДилерскийЦентр КАК ДилерскийЦентр,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.МодельАвтоРу.МаркаАвтоРу КАК МаркаАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.МодельАвтоРу КАК МодельАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.МодификацияАвтоРу КАК МодификацияАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.КомплектацияАвтоРу КАК КомплектацияАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СпециальнаяЦена КАК СпециальнаяЦена,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидкаПриПокупкеВКредит КАК СкидкаПриПокупкеВКредит,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидкаПриСтраховании КАК СкидкаПриСтраховании,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидаПриПокупкеВТрейдИн КАК СкидаПриПокупкеВТрейдИн,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидкаМаксимальная КАК СкидкаМаксимальная,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Цвет.ЦветАвтоРу КАК ЦветАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Цвет.ОкраскаМеталлик КАК ОкраскаМеталлик,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.Руль КАК Руль,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.КоличествоДверей КАК КоличествоДверей,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.КатегорияТС,
	|	ПробегиАвто.Значение КАК Пробег,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Состояние КАК Состояние,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.КоличествоВладельцевПоПТС КАК КоличествоВладельцев,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.ТипКузова.ТипКузоваАвтоРу КАК ТипКузоваВариантаКомплектации,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.ТипКузова.ТипКузоваАвтоРу КАК ТипКузоваМодели,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Цвет.Артикул,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.Артикул,
	|	""На заказ"" КАК Доступность,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику КАК ЗаказПоставщикуНаАвто,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику.ВнешнийНомерЗаказа КАК ВнешнийНомерЗаказа,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.Марка КАК Марка,
	|	""В пути"" КАК МестоАвто
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикамНаАвтомобили.Остатки КАК ЗаказыПоставщикамНаАвтомобилиОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЦеныАвтомобилейСрезПоследних.Цена КАК Цена,
	|			ЦеныАвтомобилейСрезПоследних.Автомобиль КАК Автомобиль,
	|			ЦеныАвтомобилейСрезПоследних.ВариантКомплектации КАК ВариантКомплектации,
	|			ЦеныАвтомобилейСрезПоследних.ТипЦен КАК ТипЦен
	|		ИЗ
	|			РегистрСведений.ЦеныАвтомобилей.СрезПоследних КАК ЦеныАвтомобилейСрезПоследних
	|		ГДЕ
	|			ЦеныАвтомобилейСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)) КАК ЦенаАвто
	|		ПО ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль = ЦенаАвто.Автомобиль
	|			И ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации = ЦенаАвто.Автомобиль.ВариантКомплектации
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
	|			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
	|			АвтомобилиСрезПоследних.Значение КАК Значение
	|		ИЗ
	|			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	|		ГДЕ
	|			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля)) КАК ХарАвто
	|		ПО ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль = ХарАвто.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
	|			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
	|			АвтомобилиСрезПоследних.Значение КАК Значение
	|		ИЗ
	|			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	|		ГДЕ
	|			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Пробег)) КАК ПробегиАвто
	|		ПО ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль = ПробегиАвто.Автомобиль
	|ГДЕ
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.КоличествоОстаток > 0
	|	И (ХарАвто.Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.Новый)
	|			ИЛИ ХарАвто.Значение ЕСТЬ NULL)
	|	И ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику.ПодразделениеКомпании В(&СписокПодразделений)
	|	И ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.КатегорияТС = ЗНАЧЕНИЕ(Справочник.КатегорииТранспортныхСредств.АвтомобилиЛегковые)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль,
	|	ХарАвто.Значение,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику.ПодразделениеКомпании.ДилерскийЦентр,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.МодельАвтоРу.МаркаАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.МодельАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.МодификацияАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СпециальнаяЦена,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидкаПриПокупкеВКредит,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидкаПриСтраховании,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидаПриПокупкеВТрейдИн,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.СкидкаМаксимальная,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.КомплектацияАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Цвет.ЦветАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Цвет.ОкраскаМеталлик,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.Руль,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.КоличествоДверей,
	|	ПробегиАвто.Значение,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Состояние,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.КоличествоВладельцевПоПТС,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.ТипКузова.ТипКузоваАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику.ПодразделениеКомпании,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.ТипКузова.ТипКузоваАвтоРу,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Цвет.Артикул,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.ВариантКомплектации.Артикул,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.КатегорияТС,
	|	ЦенаАвто.Цена + ЦенаАвто.Автомобиль.СтоимостьДопОборудования,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.VIN,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.ЗаказПоставщику.ВнешнийНомерЗаказа,
	|	ЗаказыПоставщикамНаАвтомобилиОстатки.Автомобиль.Модель.Марка
	|
	|УПОРЯДОЧИТЬ ПО
	|	VIN";
	
	Запрос.УстановитьПараметр("СписокПодразделений",СписокПодразделений);
	
	ТаблицаИсточник = Запрос.Выполнить().Выгрузить(); 
	
	Если ТаблицаИсточник.Количество() > 0 Тогда
		Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл 
			НайденнаяСтрока = ТЗ.Найти(СтрокаТаблицыИсточник.VIN, "VIN");
			Если НайденнаяСтрока = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), СтрокаТаблицыИсточник);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТЗ;
	
КонецФункции // ДополнитьТаблицуЗаказамиПоставщику(ТЗ,СписокПодр)()
