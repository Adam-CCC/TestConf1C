Функция ПолучитьСписокАвтоОстатковИзаказов(ТаблицаВыгрузкиПолная) Экспорт
	
	СписокАвто = Новый СписокЗначений;
	ТаблицаАвто = ПолучитьТаблицуАвто();
	
	СписокМарок = Новый СписокЗначений();
	ТаблицаМарок = ТаблицаВыгрузкиПолная.Скопировать();
	ТаблицаМарок.Свернуть("Марка","");
	СписокМарок.ЗагрузитьЗначения(ТаблицаМарок.ВыгрузитьКолонку("Марка"));	
	
	Если СписокМарок.Количество() > 0 Тогда
		Для каждого ЭлСпискаМарок Из СписокМарок Цикл
			ТекМарка = ЭлСпискаМарок.Значение;
			ПараметрыОтбора = Новый Структура("Марка",ТекМарка);
			ТаблицаВыгрузки = ТаблицаВыгрузкиПолная.Скопировать(ПараметрыОтбора);	
			СписокПодразделений = ПолучитьИтоговыйСписокПодразделений(ТаблицаВыгрузки);
			Для каждого Стр Из ТаблицаАвто Цикл
				Если Стр.Автомобиль.Модель.Марка <> ТекМарка Тогда
					Продолжить;				
				КонецЕсли;
				Если СписокПодразделений.НайтиПоЗначению(Стр.Подразделение) = Неопределено  Тогда
					Продолжить;				
				КонецЕсли;
				Если СписокАвто.НайтиПоЗначению(Стр.Автомобиль) <> Неопределено Тогда
					Продолжить;				                                                                    	
				КонецЕсли;
				СписокАвто.Добавить(Стр.Автомобиль);
			КонецЦикла;
		КонецЦикла;	 
	КонецЕсли; 
	
	Возврат СписокАвто;
	
КонецФункции // СписокАвтоОстатковИзаказов(ТаблицаВыгрузкиПолная)

Процедура ЗаполнитьОбъявлениеАвитоЛегковой(ТекАвто,HTTPRequestБазовыйURL,АдресОтделаПродаж,ТелефонОтделаПродаж,СпецусловияКредита,АксессуарыВПодарок,БыстроеОформление,XML_Полный) Экспорт
	
