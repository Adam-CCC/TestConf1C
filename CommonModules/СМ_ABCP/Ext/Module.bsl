Функция НайтиСоздатьЗаказПокупателя(Идент) Экспорт
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Комментарий,
		|	ЗаказПокупателя.Ссылка,
		|	ЗаказПокупателя.Дата,
		|	ЗаказПокупателя.ПометкаУдаления,
		|	ЗаказПокупателя.UIDсайта
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.ПометкаУдаления = ЛОЖЬ
		|	И ЗаказПокупателя.UIDсайта = &Идент";
	
 	Запрос.УстановитьПараметр("Идент",Идент);
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		#Если Клиент Тогда 
		Сообщить("Найден документ "+ВыборкаДетальныеЗаписи.Ссылка+" c UIDсайта = "+Идент);
		#КонецЕсли
		Возврат ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	
	НовДок = Документы.ЗаказПокупателя.СоздатьДокумент();
	
	НовДок.UIDсайта = Идент;
	
	НовДок.Дата = ТекущаяДата();
	НовДок.Автор = ПараметрыСеанса.Пользователь;
	НовДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций;
	НовДок.КурсДокумента = 1.0;
	НовДок.КурсВалютыУпр = 1.0;
	НовДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	НовДок.ДатаСоздания = ТекущаяДата();
	НовДок.Комментарий = Идент+" , создан обработкой пользователем '"+ПараметрыСеанса.Пользователь+"' "+Формат(ТекущаяДата(),"ДЛФ=DDT");
	НовДок.Контрагент=Справочники.Контрагенты.ОсновнойПокупатель;
	
	НовДок.ДоговорВзаиморасчетов=НайтиСоздатьДоговор(Справочники.Контрагенты.ОсновнойПокупатель,ПараметрыСеанса.ПодразделениеКомпании.Организация,ПараметрыСеанса.ПодразделениеКомпании);
	
	НовДок.ТипЗаказа=Справочники.ТипыЗаказов.КлиентскийЗаказ;
	НовДок.Заказчик=Справочники.Контрагенты.ОсновнойПокупатель;
	НовДок.ТипЦен=Справочники.ТипыЦен.ОптоваяЦена;
	НовДок.ХозОперация=Справочники.ХозОперации.ЗаказПокупателя;
	НовДок.СрокПоставки=ТекущаяДата()+5*24*3600;
	НовДок.ВидОплаты=Перечисления.ВидыОплаты.БезналичныйРасчет;
	НовДок.СкладКомпании=Справочники.СкладыКомпании.НайтиПоКоду("ЦБ000359");
 		
 	НовДок.ПодразделениеКомпании = Справочники.СкладыКомпании.НайтиПоКоду("ЦБ000359").Подразделение;
	НовДок.Организация = Справочники.СкладыКомпании.НайтиПоКоду("ЦБ000359").Подразделение.Организация;
	НовДок.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
 	
	 // Попытка
	 //   НовДок.Записать();
	 //	Сообщить("Записан новый документ "+НовДок);
	 //Исключение
	 //	Сообщить("ОШИБКА! Не удалось записать новый документ ЗаказПокупателя с UIDсайта = "+Идент,СтатусСообщения.ОченьВажное);	
	 //	НовДок = Документы.ЗаказПокупателя.ПустаяСсылка();
	 //КонецПопытки; 
	
	Возврат НовДок;
 
КонецФункции // НайтиСоздатьЗаказПокупателя()

Функция НайтиСоздатьДоговор(ТекКонтрагент,ТекОрганизация,ТекПодразделение) Экспорт
	
	НовДог = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыВзаиморасчетов.Ссылка,
	               |	ДоговорыВзаиморасчетов.Владелец,
	               |	ДоговорыВзаиморасчетов.Организация,
	               |	ДоговорыВзаиморасчетов.ВидДоговора
	               |ИЗ
	               |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	               |ГДЕ
	               |	ДоговорыВзаиморасчетов.Владелец = &Владелец
	               |	И ДоговорыВзаиморасчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Продажа)
	               |	И ДоговорыВзаиморасчетов.Организация = &Организация
	               |	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
	               |	И ДоговорыВзаиморасчетов.ЭтоГруппа = ЛОЖЬ";
	 
	Запрос.УстановитьПараметр("Владелец",ТекКонтрагент);
 	Запрос.УстановитьПараметр("Организация",ТекОрганизация);
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовДог = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	НовДог.УстановитьНовыйКод();
	НовДог.ТипДоговора = Перечисления.ТипыДоговоров.Договор;
 	НовДог.ВидДоговора=Перечисления.ВидыДоговоров.Продажа;
	НовДог.Владелец = ТекКонтрагент;
	НовДог.Организация = ТекОрганизация;
	НовДог.Подразделение = ТекПодразделение;
	НовДог.Владелец = ТекКонтрагент;
	НовДог.ДатаНачала = ТекущаяДата();
 	НовДог.Наименование = СокрЛП(НовДог.ВидДоговора)+" от "+Формат(НовДог.ДатаНачала,"ДЛФ=D"); 
	НовДог.Автор = ПараметрыСеанса.Пользователь;
	НовДог.ДатаСоздания = ТекущаяДата();
	НовДог.ВидОплаты = Перечисления.ВидыОплаты.ПроизвольнаяОплата;
	НовДог.Комментарий = "Договор создан обработкой пользователем: "+ПараметрыСеанса.Пользователь+" "+Формат(ТекущаяДата(),"ДЛФ=DDT");
