
// Централизованные акции

Процедура Renault_ЗагрузкаЦентрализованныхАкций(Параметр1 = Неопределено) Экспорт
	
	//ОбработкаОбъект = Обработки.Renault_ЗагрузкаЦентрализованныхАкций.Создать();
	//ОбработкаОбъект.ПолучитьОбновления();
	ПолучитьОбновления_Акции();
	
КонецПроцедуры

Процедура ПолучитьОбновления_Акции() Экспорт
	
	ВебСервис = ПолучитьВебСервис_Акции();
	
	ИдентификаторИБ = Константы.Renault_BIR_db.Получить();
	Если НЕ ЗначениеЗаполнено(ИдентификаторИБ) Тогда
		Возврат;
	КонецЕсли;
	СтрокаБИРов = "";
	ВыборкаДЦ = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	Пока ВыборкаДЦ.Следующий() Цикл
		Если ВыборкаДЦ.BIR <> "" И ВыборкаДЦ.ПометкаУдаления = Ложь Тогда
			СтрокаБИРов = СтрокаБИРов + ВыборкаДЦ.BIR + ";";
		КонецЕсли;
	КонецЦикла;
	Если Прав(СтрокаБИРов, 1) = ";" Тогда
		СтрокаБИРов = Лев(СтрокаБИРов, СтрДлина(СтрокаБИРов)-1);
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("BaseID", ИдентификаторИБ);
	СтруктураПараметров.Вставить("BIRArr", СтрокаБИРов);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураПараметров);
	СтрокаЗапроса = ЗаписьJSON.Закрыть();
	
	Настройки = Renault_ОбщиеФункцииСервер.ПолучитьНастройкиПодключенияПоБренду(ПараметрыСеанса.DMS_Бренд);
	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса);
	HTTPЗапрос.АдресРесурса = Настройки.Адрес2 + "/hs/Actions/Changes";
	ЗащищенноеСоединениеOpenSSL = ?(Настройки.Настройки.ИспользоватьЗащищенноеСоединение,Новый ЗащищенноеСоединениеOpenSSL,Неопределено);
	Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,ЗащищенноеСоединениеOpenSSL);
                
	ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	Тело = ОтветHTTP.ПолучитьТелоКакСтроку();
	Если ОтветHTTP.КодСостояния = 200 Тогда			
		ТаблицаДанных = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзJSON(Тело);
	Иначе
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаДанных ИЗ ТаблицаДанных Цикл
		
		Поиск = Справочники.Renault_ЦентрализованныеАкции.НайтиПоРеквизиту("ЦентральныйИдентификатор", СтрокаДанных.СсылкаИдентификатор);
		
		// если изменена имеющаяся акция
		Если ЗначениеЗаполнено(Поиск) Тогда
			Запись = РегистрыСведений.CRM_НовостиДилеров.СоздатьМенеджерЗаписи();
			Запись.ДилерскийЦентр = Поиск.ДилерскийЦентр;
			Запись.ДатаНачалаПоказа = ТекущаяДата();
			Запись.ДатаОкончанияПоказа = ДобавитьМесяц(Запись.ДатаНачалаПоказа, 1);
			СтрокаИзменений = "";
			Для Каждого СтрокаМодели ИЗ СтрокаДанных.Модели Цикл
				ИскомаяСтрока = Поиск.Модели.Найти(СтрокаМодели.УИД, "ЦентральныйУИД");
				Если ИскомаяСтрока <> Неопределено Тогда
					Если ИскомаяСтрока.СтоимостьВсего <> СтрокаМодели.СтоимостьВсего Тогда
						СтрокаИзменений = СтрокаИзменений + "<P> По модели " + ИскомаяСтрока.Модель + " изменена стоимость. Новая стоимость: " + СтрокаМодели.СтоимостьВсего + "</P>";
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			ТекстНовости = "<HTML> <HEAD> </HEAD> <BODY> В акцию " + Поиск.Наименование + " внесены изменения";
			Если СтрокаИзменений <> "" Тогда
				ТекстНовости = ТекстНовости + СтрокаИзменений;
			КонецЕсли;
			ТекстНовости = ТекстНовости + "</BODY></HTML>";
			Запись.ЗаголовокНовости = "Централизованные акции: " + Поиск.Наименование;
			Запись.ТекстНовости = ТекстНовости;
			Запись.ДоступнаСервису = Истина;
			Запись.ИдентификаторНовости = Новый УникальныйИдентификатор;
			Запись.Записать();
			
		// если добавлена новая акция
		Иначе
			Запись = РегистрыСведений.CRM_НовостиДилеров.СоздатьМенеджерЗаписи();
			Запись.ДатаНачалаПоказа = ТекущаяДата();
			Запись.ДатаОкончанияПоказа = ДобавитьМесяц(Запись.ДатаНачалаПоказа, 1);
			Запись.ЗаголовокНовости = "Централизованные акции:" + СтрокаДанных.Наименование;
			Запись.ТекстНовости = "<HTML> <HEAD> </HEAD> <BODY> Добавлена новая акция</BODY></HTML>";
			Запись.ДоступнаСервису = Истина;
			Запись.ИдентификаторНовости = Новый УникальныйИдентификатор;
			Запись.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписатьДанныеВБазу(ТаблицаДанных);
	
КонецПроцедуры

Процедура ЗаписатьДанныеВБазу(ТаблицаДанных)
	
	ВыборкаДЦ = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	
	Пока ВыборкаДЦ.Следующий() Цикл
		
		Для Каждого Строка ИЗ ТаблицаДанных Цикл
			
			Если Строка.BIR <> ВыборкаДЦ.BIR Тогда
				Продолжить;
			КонецЕсли;
			
			Отбор = Новый Структура;
			Отбор.Вставить("ЦентральныйИдентификатор", Строка.СсылкаИдентификатор);
			//Отбор.Вставить("ДилерскийЦентр", ВыборкаДЦ.Ссылка);
			ВыборкаСпр = Справочники.Renault_ЦентрализованныеАкции.Выбрать(, ВыборкаДЦ.Ссылка, Отбор);
			Если ВыборкаСпр.Следующий() Тогда
				СпрОбъект = ВыборкаСпр.ПолучитьОбъект();
			Иначе
				СпрОбъект = Справочники.Renault_ЦентрализованныеАкции.СоздатьЭлемент();
				СпрОбъект.Владелец = ВыборкаДЦ.Ссылка;
				СпрОбъект.ДилерскийЦентр = ВыборкаДЦ.Ссылка;
				СпрОбъект.ЦентральныйИдентификатор = Строка.СсылкаИдентификатор;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СпрОбъект, Строка);
			Если ЗначениеЗаполнено(Строка.ТипАкции) Тогда
				СпрОбъект.ТипАкции = Перечисления.Renault_ТипыЦентрализованныхАкций[Строка.ТипАкции];
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВнешняяТаб.КомпенсацияДилеру,
			|	ВнешняяТаб.МодельАртикул,
			|	ВнешняяТаб.СкидкаВПроцентах,
			|	ВнешняяТаб.СкидкаВРублях,
			|	ВнешняяТаб.СтоимостьВсего,
			|	ВнешняяТаб.СтоимостьЗЧВсего,
			|	ВнешняяТаб.УИД,
			|	ВнешняяТаб.Примечание
			|ПОМЕСТИТЬ Врем
			|ИЗ &ВнешняяТаб КАК ВнешняяТаб
			|;
			|ВЫБРАТЬ
			|	Врем.КомпенсацияДилеру,
			|	Врем.МодельАртикул,
			|	Врем.СкидкаВПроцентах,
			|	Врем.СкидкаВРублях,
			|	Врем.СтоимостьВсего,
			|	Врем.СтоимостьЗЧВсего,
			|	Врем.УИД КАК ЦентральныйУИД,
			|	Врем.Примечание,
			|	Модели.УИД
			|ИЗ Врем КАК Врем
			|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ЦентрализованныеАкции.Модели КАК Модели
			|	ПО Модели.ЦентральныйУИД = Врем.УИД
			|	И Модели.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("ВнешняяТаб", Строка.Модели);
			Запрос.УстановитьПараметр("Ссылка", СпрОбъект.Ссылка);
			Результат = Запрос.Выполнить().Выгрузить();
			СпрОбъект.Модели.Очистить();
			Отбор = Новый Структура;
			Отбор.Вставить("ЭтоРаботаДилера", Истина);
			РаботыДилера = СпрОбъект.Работы.Выгрузить(Отбор);
			СпрОбъект.Работы.Очистить();
			СпрОбъект.ВариантыКомплектации.Очистить();
			СпрОбъект.Номенклатура.Очистить();
			
			Для Каждого СтрокаМодели ИЗ Результат Цикл
				НоваяСтрокаМодель = СпрОбъект.Модели.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаМодель, СтрокаМодели);
				//НоваяСтрока.ЦентральныйУИД = СтрокаМодели.УИД;
				Если НоваяСтрокаМодель.УИД = "" Тогда
					НоваяСтрокаМодель.УИД = Новый УникальныйИдентификатор();
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаМодели.МодельАртикул) Тогда
					НоваяСтрокаМодель.Модель = Справочники.Модели.НайтиПоРеквизиту("Артикул", СтрокаМодели.МодельАртикул);
				КонецЕсли;
				//Если ЗначениеЗаполнено(СтрокаМодели.ВариантКомплектацииАртикул) Тогда
				//	НоваяСтрокаМодель.ВариантКомплектации = Справочники.ВариантыКомплектации.НайтиПоРеквизиту("Артикул", СтрокаМодели.ВариантКомплектацииАртикул);
				//КонецЕсли;
				//Если ЗначениеЗаполнено(СтрокаМодели.ТипДвигателя) Тогда
				//	НоваяСтрокаМодель.ТипДвигателя = Справочники.ТипыДвигателей.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаМодели.ТипДвигателя));
				//КонецЕсли;
				СтоимостьВсегоРаботы = 0;
				СтоимостьВсегоЗЧ = 0;
				Отбор = Новый Структура();
				Отбор.Вставить("УИД", НоваяСтрокаМодель.ЦентральныйУИД);
				МассивСтрок = Строка.Работы.НайтиСтроки(Отбор);
				Для Каждого СтрокаРаботы ИЗ МассивСтрок Цикл
					НоваяСтрока = СпрОбъект.Работы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаботы);
					НоваяСтрока.Работа = Справочники.Автоработы.НайтиПоРеквизиту("Артикул", СтрокаРаботы.Работа);
					НоваяСтрока.УИД = НоваяСтрокаМодель.УИД;
					СтоимостьВсегоРаботы = СтоимостьВсегоРаботы + НоваяСтрока.СтоимостьРаботы;
				КонецЦикла;
				Отбор = Новый Структура();
				Отбор.Вставить("УИД", НоваяСтрокаМодель.УИД);
				МассивСтрок = РаботыДилера.НайтиСтроки(Отбор);
				Для Каждого СтрокаРаботы ИЗ МассивСтрок Цикл
					НоваяСтрока = СпрОбъект.Работы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаботы);
					//НоваяСтрока.Работа = Справочники.Автоработы.НайтиПоРеквизиту("Артикул", СтрокаРаботы.Работа);
					НоваяСтрока.УИД = НоваяСтрокаМодель.УИД;
					Если НЕ СпрОбъект.СтоимостьВключаетРаботы Тогда
						СтоимостьВсегоРаботы = СтоимостьВсегоРаботы + НоваяСтрока.СтоимостьРаботы;
					КонецЕсли;
				КонецЦикла;
				Отбор = Новый Структура();
				Отбор.Вставить("УИД", НоваяСтрокаМодель.ЦентральныйУИД);
				МассивСтрок = Строка.Номенклатура.НайтиСтроки(Отбор);
				Для Каждого СтрокаНоменклатура ИЗ МассивСтрок Цикл
					НоваяСтрока = СпрОбъект.Номенклатура.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНоменклатура);
					НоваяСтрока.Реферанс = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", СтрокаНоменклатура.РеферансАртикул);
					НоваяСтрока.Артикул = СтрокаНоменклатура.РеферансАртикул;
					НоваяСтрока.УИД = НоваяСтрокаМодель.УИД;
					СтоимостьВсегоЗЧ = СтоимостьВсегоЗЧ + НоваяСтрока.Стоимость;
				КонецЦикла;
				МассивСтрок = Строка.ВариантыКомплектации.НайтиСтроки(Отбор);
				Для Каждого СтрокаВариант ИЗ МассивСтрок Цикл
					НоваяСтрока = СпрОбъект.ВариантыКомплектации.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВариант);
					НоваяСтрока.ВариантКомплектации = Справочники.ВариантыКомплектации.НайтиПоРеквизиту("Артикул", СтрокаВариант.ВариантКомплектацииАртикул);
					Если ЗначениеЗаполнено(СтрокаВариант.ТипДвигателя) Тогда
						НоваяСтрока.ТипДвигателя = Справочники.ТипыДвигателей.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаВариант.ТипДвигателя));
					КонецЕсли;
					НоваяСтрока.УИД = НоваяСтрокаМодель.УИД;
				КонецЦикла;
				НоваяСтрокаМодель.СтоимостьВсего = СтоимостьВсегоРаботы + СтоимостьВсегоЗЧ;
			КонецЦикла;
			СпрОбъект.Записать();
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВебСервис_Акции()
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	АдресWS	 = Настройки.АдресWsGate;
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	
	АдресWS = СтрЗаменить(АдресWS, "ws/Actions.ws?wsdl", "");
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/Actions.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/actions", 
							   "Renault_Actions", "Renault_ActionsSoap12");
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	Возврат ВебСервис;
	
КонецФункции

// Новости дилеров

Процедура Renault_ЗагрузкаНовостей(Параметр1 = Неопределено) Экспорт
	
	ОбработкаОбъект = Обработки.Renault_РаботаСНовостямиДилеров.Создать();
	ОбработкаОбъект.ОбработкаНаСервере();
	
	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ЗагрузкаНовостей"),
	ТекущаяДатаСеанса());

КонецПроцедуры

// Кредитные предложения

Процедура Renault_ЗагрузкаКредитныхПредложений_old(Параметр1 = Неопределено) Экспорт
	РНБанк=Справочники.Renault_КредитныеПредложения.РНБанк();
	
	ВебСервис = ПолучитьВебСервис_RenaultCredit();
	
	СтрокаБИР = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_ДилерскиеЦентры.BIR
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	|ГДЕ
	|	CRM_ДилерскиеЦентры.ПометкаУдаления = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.BIR) Тогда
			СтрокаБИР = СтрокаБИР + Выборка.BIR + ";";
		КонецЕсли;
	КонецЦикла;
	
	Если Прав(СтрокаБИР, 1) = ";" Тогда
		СтрокаБИР = Лев(СтрокаБИР, СтрДлина(СтрокаБИР)-1);
	КонецЕсли;
	
	Данные = ВебСервис.GetCreditTarifs(СтрокаБИР);
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	Сериализатор = Новый СериализаторXDTO(СервисФабрика);
	Результат = Сериализатор.ПрочитатьXDTO(Данные);
	
	ТаблицаТипыСервисов = Результат.Найти("ТаблицаТипыСервисов", "Имя").Значение;
	Для Каждого СтрокаТипСервиса ИЗ ТаблицаТипыСервисов Цикл
		НоваяСсылка = Справочники.CRM_ТипыКредитныхСервисов.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТипСервиса.СервисТипИдентификатор));
		Если НоваяСсылка.ПолучитьОбъект() = Неопределено Тогда
			НовОбъект = Справочники.CRM_ТипыКредитныхСервисов.СоздатьЭлемент();
			НовОбъект.УстановитьСсылкуНового(НоваяСсылка);
			ЗаполнитьЗначенияСвойств(НовОбъект, СтрокаТипСервиса);
			НовОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
