Функция ПолучитьВебСервис_RenaultCredit()
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	
	АдресWS = Настройки.КЦАдресСервера;
	СообщениеОбОшибке = "";
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/RenaultCredit.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/RenaultCredit", 
								"Renault_Credit", "Renault_CreditSoap12",300);
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	Возврат ВебСервис;
	
КонецФункции

// статусы СМС

Процедура Renault_СтатусыСМС(Параметр1 = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_SMS.MessageID КАК ИдентификаторСообщения
	|ИЗ
	|	РегистрСведений.Renault_SMS КАК Renault_SMS
	|ГДЕ
	|	Renault_SMS.Статус = &Статус";
	Запрос.УстановитьПараметр("Статус", Перечисления.Renault_СтатусыСМС.ОтправленоНаГейт);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ВебСервис = ПолучитьВебСервисКЦ();
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	Сериализатор = Новый СериализаторXDTO(СервисФабрика);
	Параметры = Сериализатор.ЗаписатьXDTO(Результат);
	Ответ = ВебСервис.GetSMSStatus(Параметры);
	ТаблицаКВозврату = Сериализатор.ПрочитатьXDTO(Ответ);
	Для Каждого Строка ИЗ ТаблицаКВозврату Цикл
		//Сообщить("ИД:" + Строка.ИдентификаторСообщения + " Статус:" + Строка.Статус);
		Запись = РегистрыСведений.Renault_SMS.СоздатьМенеджерЗаписи();
		Запись.MessageID = Строка.ИдентификаторСообщения;
		Запись.Прочитать();
		Запись.MessageID = Строка.ИдентификаторСообщения;
		Запись.Статус = ПредопределенноеЗначение("Перечисление.Renault_СтатусыСМС." + Строка.Статус);
		Запись.Записать();
	КонецЦикла;
	
КонецПроцедуры

