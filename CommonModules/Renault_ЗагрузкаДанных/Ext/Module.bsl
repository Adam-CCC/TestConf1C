Процедура Renault_ПолучениеПараметровАвторегистрации(Параметр1 = Неопределено) Экспорт
	
	Если НЕ Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьHTTPСервисы Тогда
		
		ВебСервис = ПолучитьВебСервисАвторегистрации();
		
		ПараметрыАвторегистрацииXDTO = ВебСервис.GetRegistrationParams();
		Сериализатор = Новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
		ПараметрыАвторегистрации = Сериализатор.ПрочитатьXDTO(ПараметрыАвторегистрацииXDTO);
		
	Иначе
		
		ПараметрыАвторегистрации = Неопределено;
		СтруктураЗапроса = Новый Структура;
		Если Не DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"DMS_ВебСервисы.pingМетод",DMS_DataExchange.newPackage(СтруктураЗапроса),ПараметрыАвторегистрации) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого СтрокаПараметров ИЗ ПараметрыАвторегистрации Цикл
		Если СтрокаПараметров.Поток = "Сервис" Тогда
			Узел = ПолучитьПланОбмена_Сервис();
			МассивДанных = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(СтрокаПараметров.Данные, ";");
			Для Каждого Данные ИЗ МассивДанных Цикл
				МетОбъект = Метаданные.НайтиПоПолномуИмени(Данные);
				Если МетОбъект <> Неопределено Тогда
					ПланыОбмена.ЗарегистрироватьИзменения(Узел, МетОбъект);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли СтрокаПараметров.Поток = "Продажи" Тогда
			Узел = ПолучитьПланОбмена_Продажи();
			МассивДанных = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(СтрокаПараметров.Данные, ";");
			Для Каждого Данные ИЗ МассивДанных Цикл
				МетОбъект = Метаданные.НайтиПоПолномуИмени(Данные);
				Если МетОбъект <> Неопределено Тогда
					ПланыОбмена.ЗарегистрироватьИзменения(Узел, МетОбъект);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ПолучениеПараметровАвторегистрации"),
	ТекущаяДатаСеанса());
	
КонецПроцедуры

Функция ПолучитьПланОбмена_Сервис()
		
	Выборка = ПланыОбмена.Renault_Автосервис.Выбрать();
	ЭтаБаза = ПланыОбмена.Renault_Автосервис.ЭтотУзел();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> ЭтаБаза Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
