	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/AutoRegistration.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/DealerAutoRegistration", 
							   "Renault_DealerAutoRegistration", "Renault_DealerAutoRegistrationSoap12",300);
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	Возврат ВебСервис;
	
КонецФункции

// Программы лояльности

// точка входа регламентного задания загрузки "Централизованных" Программ лояльности
Процедура Renault_ЗагрузкаЦентрализованныхПрограммЛояльности(Параметр1 = Неопределено) Экспорт
	
	Настройки = Renault_ОбщиеФункцииСервер.ПолучитьНастройкиПодключенияПоБренду(ПараметрыСеанса.DMS_Бренд);

	HTTPЗапрос = Новый HTTPЗапрос();
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	HTTPЗапрос.АдресРесурса = Настройки.Адрес2 + "/hs/Loyalty/Programs";
	ЗащищенноеСоединениеOpenSSL = ?(Настройки.Настройки.ИспользоватьЗащищенноеСоединение,Новый ЗащищенноеСоединениеOpenSSL,Неопределено);
	Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,ЗащищенноеСоединениеOpenSSL);
                
	ОтветHTTP = Соединение.Получить(HTTPЗапрос);
                
	Тело = ОтветHTTP.ПолучитьТелоКакСтроку();
	Если ОтветHTTP.КодСостояния = 200 Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Тело);
		
		ПараметрыЗапроса = ПрочитатьJSON(ЧтениеJSON);
		Данные = Base64Значение(ПараметрыЗапроса);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("XML");
		Данные.Записать(ИмяВременногоФайла);
		
		ТаблицаДанных = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзХML(ИмяВременногоФайла);	
	Иначе
		ЗаписьЖурналаРегистрации(
			"Загрузка программ лояльности",
			УровеньЖурналаРегистрации.Ошибка,,,
			Тело);	
	КонецЕсли;
	
	Для Каждого СтрокаПрограммы ИЗ ТаблицаДанных Цикл
		
		ИДПрограммы = Новый УникальныйИдентификатор(СтрокаПрограммы.UID);
		Ссылка = Справочники.Renault_ПрограммыЛояльности.ПолучитьСсылку(ИДПрограммы);
		
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда // Если это новая программа
			
			НоваяПрограмма = Справочники.Renault_ПрограммыЛояльности.СоздатьЭлемент();
			НоваяПрограмма.УстановитьСсылкуНового(Ссылка);
			ЗаполнитьЗначенияСвойств(НоваяПрограмма, СтрокаПрограммы, , "Код");
			Для Каждого СтрокаЗЧ ИЗ СтрокаПрограммы.ИсключенияЗапчасти Цикл
				НоваяЗЧ = НоваяПрограмма.ИсключенияЗапчасти.Добавить();
				НоваяЗЧ.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаЗЧ.НоменклатураСсылка));
				НоваяЗЧ.ПрограммаЛояльности = Справочники.Renault_ПрограммыЛояльности.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаЗЧ.ПрограммаСсылка));
			КонецЦикла;
			Для Каждого СтрокаРабота ИЗ СтрокаПрограммы.ИсключенияРаботы Цикл
				НоваяРабота = НоваяПрограмма.ИсключенияРаботы.Добавить();
				НоваяРабота.Авторабота = Справочники.Автоработы.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаРабота.АвтоработаСсылка));
				НоваяРабота.ПрограммаЛояльности = Справочники.Renault_ПрограммыЛояльности.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаРабота.ПрограммаСсылка));
			КонецЦикла;
			НоваяПрограмма.Загруженная = Истина;
			НоваяПрограмма.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВебСервисЛояльности()
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	
	АдресWS = Настройки.АдресWsGate;
	СообщениеОбОшибке = "";
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/Loyalty.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/RenaultLoyalty", 
							   "Renault_Loyalty", "Renault_LoyaltySoap12",300);
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	Возврат ВебСервис;
	
КонецФункции

Процедура ОбновитьСоответствияКодовКомплекаРабот(ТаблицаСоответствий)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.Артикул,
	               |	ТЗ.КодРабот
	               |ПОМЕСТИТЬ ТЗ
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Renault_СоответствиеАртикуловКодамРабот.Ссылка,
	               |	ТЗ.Артикул,
	               |	ТЗ.КодРабот,
	               |	ВЫБОР
	               |		КОГДА Renault_СоответствиеАртикуловКодамРабот.КодРабот ЕСТЬ NULL
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Создавать
	               |ИЗ
	               |	ТЗ КАК ТЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_СоответствиеАртикуловКодамРабот КАК Renault_СоответствиеАртикуловКодамРабот
	               |		ПО ТЗ.Артикул = Renault_СоответствиеАртикуловКодамРабот.Артикул";
	ЗАпрос.УстановитьПараметр("ТЗ",ТаблицаСоответствий);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл
		Если Выборка.Создавать тогда
			Об = Справочники.Renault_СоответствиеАртикуловКодамРабот.СоздатьЭлемент();			
			Об.Артикул = Выборка.Артикул;
		Иначе
			Об = Выборка.Ссылка.ПолучитьОбъект();
		КонецЕсли;	
		Об.КодРабот = Выборка.КодРабот;
		Об.Записать();
	КонецЦикла;	
КонецПроцедуры	

Процедура Renault_ЗагрузкаКомплексСервисов(Знач СтруктураПараметров) Экспорт	
	
	Попытка	
	ПолныйОбмен = Ложь;
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		Если НЕ СтруктураПараметров.Свойство("ПолныйОбмен",ПолныйОбмен) Тогда
			ПолныйОбмен = Ложь;
		КонецЕсли;
	КонецЕсли;

	Настройки = Renault_ОбщиеФункцииСервер.ПолучитьНастройкиПодключенияПоБренду(ПараметрыСеанса.DMS_Бренд);
	
	Если Настройки.Настройки.ИспользоватьHTTPСервисы Тогда
		HTTPЗапрос = Новый HTTPЗапрос();
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		HTTPЗапрос.АдресРесурса = 
		Настройки.Адрес2 + "/hs/AutoworkPrices/AdditionalOffers";
		ЗащищенноеСоединениеOpenSSL = ?(Настройки.Настройки.ИспользоватьЗащищенноеСоединение,Новый ЗащищенноеСоединениеOpenSSL,Неопределено);
		Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,ЗащищенноеСоединениеOpenSSL);
		ОтветHTTP = Соединение.Получить(HTTPЗапрос); 
		ТабДопПредложения = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());
	Иначе 
		ВебСервис =  ПолучитьПроксиАвторабот();
		ТабДопПредложения_XDTO = ВебСервис.GetAdditionalOffers();
		ТабДопПредложения = СериализаторXDTO.ПрочитатьXDTO(ТабДопПредложения_XDTO);
	КонецЕсли;	
	ЗаполнитьДополнительныеПредложения(ТабДопПредложения);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КомплексСервисыАвторабот.Артикул,
		|	Renault_КомплексСервисыАвторабот.ДатаИзменения,
		|	Renault_КомплексСервисыАвторабот.Ссылка
		|ИЗ
		|	Справочник.Renault_КомплексСервисыАвторабот КАК Renault_КомплексСервисыАвторабот
		|ГДЕ
		|	Renault_КомплексСервисыАвторабот.ЭтоГруппа = ЛОЖЬ
		|	И Renault_КомплексСервисыАвторабот.ПометкаУдаления = ЛОЖЬ";
	
	КомплексСервисы = Запрос.Выполнить().Выгрузить();
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПредложенияКомплексСервисов.ДатаИзменения,
		|	Renault_ПредложенияКомплексСервисов.Код,
		|	Renault_ПредложенияКомплексСервисов.Ссылка
		|ИЗ
		|	Справочник.Renault_ПредложенияКомплексСервисов КАК Renault_ПредложенияКомплексСервисов
		|ГДЕ
		|	Renault_ПредложенияКомплексСервисов.ЭтоГруппа = ЛОЖЬ
		|	И Renault_ПредложенияКомплексСервисов.ПометкаУдаления = ЛОЖЬ";
	
	ПредложенияДилера = Запрос.Выполнить().Выгрузить();
	
	Если ПолныйОбмен Тогда
		КомплексСервисы.ЗаполнитьЗначения(ТекущаяДата(),"ДатаИзменения");
		ПредложенияДилера.ЗаполнитьЗначения(ТекущаяДата(),"ДатаИзменения");
		Для каждого стрКС из КомплексСервисы Цикл
			КС = стрКС.Ссылка.ПолучитьОбъект();
			КС.ПометкаУдаления = Истина;
			КС.ДатаИзменения = ТекущаяДата() - 60*60*24*3;
			КС.Записать();
		КонецЦикла;
		Для каждого стрПд из ПредложенияДилера Цикл
			ПД = стрПд.Ссылка.ПолучитьОбъект();
			ПД.ДатаИзменения = ТекущаяДата() - 60*60*24*3;
			ПД.ПометкаУдаления = Истина;
			ПД.Записать();
		КонецЦикла;
	КонецЕсли;
	
	КомплексСервисы.Колонки.Удалить("Ссылка");
	ПредложенияДилера.Колонки.Удалить("Ссылка");

	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Комплексы",КомплексСервисы);
	СтруктураДанных.Вставить("Предложения",ПредложенияДилера);
	
	Если Настройки.Настройки.ИспользоватьHTTPСервисы Тогда
		ТелоЗапроса = ПолучитьСтрокуJSONИзXDTO(СериализаторXDTO.ЗаписатьXDTO(СтруктураДанных));
		HTTPЗапрос = Новый HTTPЗапрос();
		HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
		HTTPЗапрос.АдресРесурса = 
		Настройки.Адрес2 + "/hs/AutoworkPrices/ServiceComplexes";
		ЗащищенноеСоединениеOpenSSL = ?(Настройки.Настройки.ИспользоватьЗащищенноеСоединение,Новый ЗащищенноеСоединениеOpenSSL,Неопределено);
		Соединение = Новый HTTPСоединение(Настройки.Адрес1,,Настройки.ЛогинWS,Настройки.ПарольWS,,,ЗащищенноеСоединениеOpenSSL);
		ОтветHTTP = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		СтруктураОтвет = Renault_ОбщиеФункцииСервер.ПолучитьЗначениеИзJSON(ОтветHTTP.ПолучитьТелоКакСтроку());  	
	Иначе
		СтруктураДанныхXDTO = СериализаторXDTO.ЗаписатьXDTO(СтруктураДанных);
		ОтветXDTO = ВебСервис.GetServiceComplexes(СтруктураДанныхXDTO);
		СтруктураОтвет = СериализаторXDTO.ПрочитатьXDTO(ОтветXDTO);  	
	КонецЕсли;
	
	Если СтруктураОтвет.Свойство("ТаблицаСоответствийКодовРабот") тогда
		ОбновитьСоответствияКодовКомплекаРабот(ЗначениеИзСтрокиВнутр(СтруктураОтвет.ТаблицаСоответствийКодовРабот));
	КонецЕсли;	
	
	//Создание и заполнение авторабот
	DMS_Renault = Справочники.Автоработы.НайтиПоНаименованию("DMS Renault",,Справочники.Автоработы.ПустаяСсылка());
	Если НЕ ЗначениеЗаполнено(DMS_Renault) Тогда
		НоваяАвторабота = Справочники.Автоработы.СоздатьГруппу();
		НоваяАвторабота.Наименование = "DMS Renault"; 
		НоваяАвторабота.УстановитьНовыйКод();
		НоваяАвторабота.Записать();
		DMS_Renault = НоваяАвторабота.Ссылка;
	КонецЕсли;	
	
	ГруппаАвторабот = Справочники.Автоработы.НайтиПоНаименованию("Комплекс-Сервисы",,DMS_Renault);
	Если НЕ ЗначениеЗаполнено(ГруппаАвторабот) Тогда
		нгр = Справочники.Автоработы.СоздатьГруппу();
		нгр.ОбменДанными.Загрузка = Истина;
		нгр.Наименование = "Комплекс-Сервисы";
		нгр.УстановитьНовыйКод();
		нгр.Родитель = DMS_Renault;
		нгр.Записать();
		ГруппаАвторабот = нгр.Ссылка;
	КонецЕсли;   
	
	СтрокиРабот = ЗначениеИзСтрокиВнутр(СтруктураОтвет.ТаблицаАвторабот).Строки;
	ЗагрузкаДереваРабот(СтрокиРабот,Справочники.Автоработы.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	Номенклатура.Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = Ложь
	|	И Номенклатура.ПометкаУдаления = Ложь";
	ТЗЗапчасти = Запрос.Выполнить().Выгрузить();
	Для каждого СтрЗЧ из ТЗЗапчасти Цикл
		СтрЗЧ.Артикул = СокрЛП(СтрЗЧ.Артикул);
	КонецЦикла;
	ТЗЗапчасти.Индексы.Добавить("Артикул");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КритерииАвтомобилей.Ссылка,
	|	КритерииАвтомобилей.КодОбъекта,
	|	КритерииАвтомобилей.КодКритерия,
	|	КритерииАвтомобилей.ОписаниеКритерия,
	|	КритерииАвтомобилей.ОписаниеЗначенияКритерия
	|ИЗ
	|	Справочник.Renault_КритерииАвтомобилей КАК КритерииАвтомобилей";
	ТаблицаКритериевАвто = Запрос.Выполнить().Выгрузить();
	ТаблицаКритериевАвто.Индексы.Добавить("КодОбъекта");
	ТаблицаКритериевАвто.Индексы.Добавить("КодКритерия");

	Параметры = Новый Структура;
	Параметры.Вставить("ТаблицаКритериев",ЗначениеИзСтрокиВнутр(СтруктураОтвет.ТаблицаКритериев).Строки);
	Параметры.Вставить("ГруппаАвторабот",ГруппаАвторабот);
	Параметры.Вставить("ТаблицаСостава",ЗначениеИзСтрокиВнутр(СтруктураОтвет.ТаблицаСостава));
	Параметры.Вставить("ТаблицаЗапчастей",ТЗЗапчасти);
	Параметры.Вставить("ТаблицаКритериевАвто",ТаблицаКритериевАвто);
	ЗагрузкаКомплексов(Параметры);

	ЗагрузкаПредложений(ЗначениеИзСтрокиВнутр(СтруктураОтвет.ТаблицаПредложений));

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КомплексСервисыАвторабот.Ссылка
		|ИЗ
		|	Справочник.Renault_КомплексСервисыАвторабот КАК Renault_КомплексСервисыАвторабот
		|ГДЕ
		|	Renault_КомплексСервисыАвторабот.ПометкаУдаления = ИСТИНА
		|	И Renault_КомплексСервисыАвторабот.ДатаИзменения < &ДатаИзменения";

	Запрос.УстановитьПараметр("ДатаИзменения", ТекущаяДата() - 60*60*24*2);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 Эл = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		 Эл.Удалить();
	 КонецЦикла;
		 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПредложенияКомплексСервисов.Ссылка
		|ИЗ
		|	Справочник.Renault_ПредложенияКомплексСервисов КАК Renault_ПредложенияКомплексСервисов
		|ГДЕ
		|	Renault_ПредложенияКомплексСервисов.ПометкаУдаления = ИСТИНА
		|	И Renault_ПредложенияКомплексСервисов.ДатаИзменения < &ДатаИзменения";

	Запрос.УстановитьПараметр("ДатаИзменения", ТекущаяДата() - 60*60*24*2);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 Эл = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		 Эл.Удалить();
	КонецЦикла;

	Исключение 
		Ошибка = ОписаниеОшибки(); 
		ВызватьИсключение Ошибка;
	КонецПопытки;

	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ЗагрузкаКомплексСервисов"),
	ТекущаяДатаСеанса());

КонецПроцедуры

Функция ПолучитьСтрокуJSONИзXDTO(ОбъектXDTO) Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("Message");
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO);

	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();
	ДвоичныеДанныеСообщения = Новый ДвоичныеДанные(ИмяВременногоФайла);

	СтрокаДанные = Base64Строка(ДвоичныеДанныеСообщения);

	УдалитьФайлы(ИмяВременногоФайла);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтрокаДанные);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();		
	
	Возврат СтрокаДляОтвета;
	
КонецФункции

Функция ПолучитьПроксиАвторабот()
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	Адрес = Настройки.АдресWsGate;
	ОпределениеСервиса = Новый WSОпределения(СокрЛП(Адрес) + "ws/Renault_AutoworkPrices.1cws?wsdl", ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(
	ОпределениеСервиса, 
	"http://renault-nissan.com/schema/Renault_AutoworkPrices", 
