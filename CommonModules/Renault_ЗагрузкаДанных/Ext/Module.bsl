	"Renault_AutoworkPricesSoap12",
	3600);
	ВебСервис.Пользователь  = ЛогинWS;
	ВебСервис.Пароль   = ПарольWS;

	Возврат ВебСервис;
	
КонецФункции

Процедура ЗаполнитьДополнительныеПредложения(ТабДопПредложения)
	Запрос = Новый Запрос;
	Запрос.Текст =  
	"ВЫБРАТЬ
	|	Таб.ДополнительноеПредложениеКод КАК ДополнительноеПредложениеКод,
	|	Таб.ДополнительноеПредложение КАК ДополнительноеПредложение
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Таб КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_ДополнительныеПредложения.Ссылка КАК ДополнительноеПердложениеСсылка,
	|	Renault_ДополнительныеПредложения.КодДополнительныеПредложенияDictionary КАК КодДополнительныеПредложенияDictionary
	|ПОМЕСТИТЬ ДопПредлДанные
	|ИЗ
	|	Справочник.Renault_ДополнительныеПредложения КАК Renault_ДополнительныеПредложения
	|ГДЕ
	|	Renault_ДополнительныеПредложения.КодДополнительныеПредложенияDictionary В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТ.ДополнительноеПредложениеКод
	|			ИЗ
	|				ВТ КАК ВТ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КодДополнительныеПредложенияDictionary
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ДополнительноеПредложениеКод КАК Код,
	|	ВТ.ДополнительноеПредложение КАК Наименование,
	|	ДопПредлДанные.ДополнительноеПердложениеСсылка КАК Ссылка
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДопПредлДанные КАК ДопПредлДанные
	|		ПО ВТ.ДополнительноеПредложениеКод = ДопПредлДанные.КодДополнительныеПредложенияDictionary";
	Запрос.УстановитьПараметр("Таб", ТабДопПредложения);	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
	    Возврат;	
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка = NULL Тогда
			ЭлДопПредложение = Справочники.Renault_ДополнительныеПредложения.СоздатьЭлемент();
		Иначе
			ЭлДопПредложение = Выборка.Ссылка.ПолучитьОбъект();			
		КонецЕсли;
		
		ЭлДопПредложение.КодДополнительныеПредложенияDictionary = Выборка.Код;
		ЭлДопПредложение.Наименование = Выборка.Наименование;
		ЭлДопПредложение.Записать();
	КонецЦикла; 		
КонецПроцедуры

Процедура ЗагрузкаДереваРабот(Строки, Родитель = Неопределено)
	
	Для Каждого Строка из Строки Цикл		
		Если НЕ ЗначениеЗаполнено(Строка.Наименование) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Строка.ЭтоГруппа Тогда
			Ссылка = Справочники.Автоработы.НайтиПоНаименованию(Строка.Наименование,Истина,Родитель);
		Иначе
			Ссылка = Справочники.Автоработы.НайтиПоРеквизиту("Артикул",Строка.Код, Родитель);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Если Строка.ЭтоГруппа Тогда
				НоваяАвторабота = Справочники.Автоработы.СоздатьГруппу();
			Иначе
				НоваяАвторабота = Справочники.Автоработы.СоздатьЭлемент();
				НоваяАвторабота.Заполнить(Неопределено);
				НоваяАвторабота.Номенклатура = Справочники.Номенклатура.Авторабота;
			КонецЕсли;
			НоваяАвторабота.УстановитьНовыйКод();
		Иначе
			НоваяАвторабота = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		Записывать = Ложь;
		Если ЗначениеЗаполнено(НоваяАвторабота.ВерсияДанных) Тогда //Объект найден. Если название/артикул не менялись, то перезаписывать не будем
			Если НоваяАвторабота.ПометкаУдаления Тогда
				НоваяАвторабота.УстановитьПометкуУдаления(Ложь); // снимем пометку если была установлена
			КонецЕсли;
			Если НоваяАвторабота.Наименование <> Строка.Наименование
				ИЛИ НоваяАвторабота.Артикул <> Строка.Код Тогда
				Записывать = Истина;
			КонецЕсли;
		Иначе //Создается новый объект в базе
			Записывать = Истина;
		КонецЕсли;
		Если Записывать Тогда
			НоваяАвторабота.Артикул = Строка.Код;
			НоваяАвторабота.ОбменДанными.Загрузка = Истина;
			НоваяАвторабота.Наименование = Строка.Наименование;
			НоваяАвторабота.Родитель = Родитель; 
			НоваяАвторабота.Записать();
		КонецЕсли;
		Ссылка = НоваяАвторабота.Ссылка;
		
		ЗагрузкаДереваРабот(Строка.Строки, Ссылка);
		
	КонецЦикла;  
	
КонецПроцедуры

Процедура ЗагрузкаКомплексов(Параметры)//(Строки, Родитель, ГруппаАвторабот, ЗаполняемКритерии, ТаблицаСостава, ТаблицаЗапчастей)
	
	Для Каждого Строка из Параметры.ТаблицаКритериев Цикл		
		Если НЕ ЗначениеЗаполнено(Строка.Наименование) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если НЕ Строка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		Группа = Справочники.Renault_КомплексСервисыАвторабот.НайтиПоНаименованию(Строка.Наименование, Истина, Справочники.Renault_КомплексСервисыАвторабот.ПустаяСсылка());
		
		Если Не ЗначениеЗаполнено(Группа) Тогда	//Необходимо создать новый элемент или группу			
			НовыйКомплекс = Справочники.Renault_КомплексСервисыАвторабот.СоздатьГруппу();
			НовыйКомплекс.Наименование = Строка.Наименование;	
			НовыйКомплекс.Артикул = Строка.Артикул;
			НовыйКомплекс.ОбменДанными.Загрузка = Истина;
			НовыйКомплекс.УстановитьНовыйКод();
			НовыйКомплекс.Записать();
			Группа = НовыйКомплекс.Ссылка; 
		КонецЕсли;
		
		Для Каждого СтрокаГруппы из Строка.Строки Цикл
			Если СтрокаГруппы.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;
			
			КомплексСсылка = Справочники.Renault_КомплексСервисыАвторабот.НайтиПоРеквизиту("Артикул",СтрокаГруппы.Артикул, Группа);
			Если ЗначениеЗаполнено(КомплексСсылка) Тогда
				Комплекс = КомплексСсылка.ПолучитьОбъект();
				Комплекс.ПометкаУдаления = СтрокаГруппы.ПометкаУдаления;
			Иначе
				Комплекс = Справочники.Renault_КомплексСервисыАвторабот.СоздатьЭлемент();
				Комплекс.УстановитьНовыйКод();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Комплекс,СтрокаГруппы);
			Комплекс.Родитель = Группа;
			Если Комплекс.Авторабота.Артикул <> СтрокаГруппы.АвтоработаАртикул Тогда
				Авторабота = Справочники.Автоработы.НайтиПоРеквизиту("Артикул",СтрокаГруппы.АвтоработаАртикул,Параметры.ГруппаАвторабот);
				Если Авторабота.Пустая() Тогда
					НоваяРабота = Справочники.Автоработы.СоздатьЭлемент();
					НоваяРабота.Родитель = Параметры.ГруппаАвторабот;
					НоваяРабота.Артикул  = СтрокаГруппы.АвтоработаАртикул;
					НоваяРабота.Наименование = СтрокаГруппы.Наименование;
					НоваяРабота.Заполнить(Неопределено);
					НоваяРабота.Номенклатура = Справочники.Номенклатура.Авторабота;
					НоваяРабота.УстановитьНовыйКод(); // DMSREN-774 
					НоваяРабота.Записать();
					Авторабота = НоваяРабота.Ссылка;
				КонецЕсли;
				Комплекс.Авторабота = Авторабота;
			КонецЕсли;
			
			Комплекс.ОбменДанными.Загрузка = Истина;
			Комплекс.КритерииКомплекса.Очистить();
			Для Каждого Строка из СтрокаГруппы.Строки Цикл		
				НовСтр = Комплекс.КритерииКомплекса.Добавить();
				НовСтр.Критерий = НайтиСоздатьКритерий(Строка, Параметры.ТаблицаКритериевАвто);			
			КонецЦикла;
			//Заполняем состав 
			СтрокиСоставаКС = Параметры.ТаблицаСостава.Скопировать(Новый Структура("АртикулКомплекса",Комплекс.Артикул));	
			Комплекс.СоставКомплекса.Очистить();
			Для Каждого Стр из СтрокиСоставаКС Цикл	
				Если ЗначениеЗаполнено(СокрЛП(Стр.АртикулЗапчасти)) Тогда
					НовСостав =  Комплекс.СоставКомплекса.Добавить();
					НовСостав.Артикул = СокрЛП(Стр.АртикулЗапчасти);
					Запчасть = Параметры.ТаблицаЗапчастей.Найти(НовСостав.Артикул,"Артикул");
					Если Запчасть <> Неопределено Тогда
						НовСостав.Номенклатура = Запчасть.Ссылка;
					Иначе
						НовСостав.Номенклатура = Renault_ЗапчастиСервер.ПолучитьНоменклатуруПоКаталогу(Стр.АртикулЗапчасти, Истина);
						Если ЗначениеЗаполнено(НовСостав.Номенклатура) Тогда
							СтрЗч = Параметры.ТаблицаЗапчастей.Добавить();
							СтрЗч.Артикул = Стр.АртикулЗапчасти;
							СтрЗч.Ссылка = НовСостав.Номенклатура;
						КонецЕсли;
					КонецЕсли;
					НовСостав.Количество = Стр.Количество;
					НовСостав.Кратность = Стр.Кратность;
					НовСостав.ЦенаPCL = Стр.ЦенаPCL;
					НовСостав.ЦенаPNC = Стр.ЦенаPNC;
					// { DMSREN-382 Болдарев Д.Е. от 10.03.2020  
					НовСостав.УчетМаслаВБочках = Стр.УчетМаслаВБочках;
					// } DMSREN-382 Болдарев Д.Е. от 10.03.2020. 
				КонецЕсли;
			КонецЦикла;
			Комплекс.Записать();
			
		КонецЦикла;  
	КонецЦикла; 		

КонецПроцедуры

Процедура ЗагрузкаПредложений(ТаблицаПредложений)
	
	Для каждого Строка из ТаблицаПредложений.Строки Цикл //перебор групп
		Ссылка = Справочники.Renault_ПредложенияКомплексСервисов.НайтиПоКоду(Строка.УсловияПредложенияКСКод);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			 НоваяГруппаПредложения = Ссылка.ПолучитьОбъект();
			 НоваяГруппаПредложения.Наименование = Строка.УсловияПредложенияКСНаименование;
			 НоваяГруппаПредложения.Код = Строка.УсловияПредложенияКСКод;
			 НоваяГруппаПредложения.ПорядковыйНомер = Строка.ПорядковыйНомер;
			 НоваяГруппаПредложения.Записать();
			 ГруппаПредложения = Ссылка;
		Иначе	//ЗначениеЗаполнено(Ссылка) Тогда
			 НоваяГруппаПредложения = Справочники.Renault_ПредложенияКомплексСервисов.СоздатьГруппу();
			 НоваяГруппаПредложения.Наименование = Строка.УсловияПредложенияКСНаименование;
			 НоваяГруппаПредложения.Код = Строка.УсловияПредложенияКСКод;
			 НоваяГруппаПредложения.ПорядковыйНомер = Строка.ПорядковыйНомер;
			 НоваяГруппаПредложения.Записать();
			 ГруппаПредложения = НоваяГруппаПредложения.Ссылка;
		КонецЕсли;	
		
		Для каждого Стр из Строка.Строки Цикл //перебор предложений группы
			ПредложениеСсылка = Справочники.Renault_ПредложенияКомплексСервисов.НайтиПоКоду(Стр.УсловияПредложенияКСКод);
			Если ЗначениеЗаполнено(ПредложениеСсылка) Тогда
				Предложение = ПредложениеСсылка.ПолучитьОбъект();
				Предложение.ПометкаУдаления = Стр.ПометкаУдаления;
			Иначе	//ЗначениеЗаполнено(Ссылка) Тогда
				Предложение = Справочники.Renault_ПредложенияКомплексСервисов.СоздатьЭлемент();
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(Предложение,стр);
			Предложение.Родитель = ГруппаПредложения;
			Предложение.Наименование = Стр.УсловияПредложенияКСНаименование;
			Предложение.ДополнительныеПредложения = Справочники.Renault_ДополнительныеПредложения.НайтиПоРеквизиту("КодДополнительныеПредложенияDictionary",Стр.ДополнительныеПредложенияКод);
			Предложение.Код = Стр.УсловияПредложенияКСКод;
			Предложение.Записать();
		КонецЦикла;
		
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСоздатьКритерий(Строка, ТаблицаКритериевАвто)

	МассивСтрок = ТаблицаКритериевАвто.НайтиСтроки(Новый Структура("КодОбъекта,КодКритерия",Строка.КодОбъекта,Строка.КодКритерия));
	Если МассивСтрок.Количество()>0 Тогда
		//Если Выборка.Следующий() Тогда
		СтрокаМассива = МассивСтрок[0];
		Критерий = СтрокаМассива.Ссылка;
		Если СтрокаМассива.ОписаниеКритерия <> Строка.ОписаниеКритерия или СтрокаМассива.ОписаниеЗначенияКритерия <> Строка.ОписаниеЗначенияКритерия Тогда
			Эл = Критерий.ПолучитьОбъект();
			Эл.ОписаниеКритерия = Строка.ОписаниеКритерия;
			Эл.ОписаниеЗначенияКритерия = Строка.ОписаниеЗначенияКритерия;
			Эл.Записать();
		КонецЕсли;
	Иначе
		НовыйКритерий = Справочники.Renault_КритерииАвтомобилей.СоздатьЭлемент();
		НовыйКритерий.УстановитьНовыйКод();
		НовыйКритерий.КодОбъекта = Строка.КодОбъекта;
		НовыйКритерий.КодКритерия = Строка.КодКритерия;
		НовыйКритерий.ОписаниеКритерия = Строка.ОписаниеКритерия;
		НовыйКритерий.ОписаниеЗначенияКритерия = Строка.ОписаниеЗначенияКритерия;
		
		Если НЕ ЗначениеЗаполнено(Строка.ОписаниеЗначенияКритерия) Тогда
			НовыйКритерий.ОписаниеЗначенияКритерия = Строка.КодКритерия;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.ОписаниеКритерия) Тогда
			НовыйКритерий.ОписаниеКритерия = Строка.КодОбъекта;
		КонецЕсли;
		НовыйКритерий.Наименование = НовыйКритерий.ОписаниеКритерия+ " - "+ НовыйКритерий.ОписаниеЗначенияКритерия;
		НовыйКритерий.Записать();
		
		НовКрит = ТаблицаКритериевАвто.Добавить();
		ЗаполнитьЗначенияСвойств(НовКрит,НовыйКритерий);
		Критерий =  НовыйКритерий.Ссылка;
		
	КонецЕсли;
	
	Возврат Критерий;
	
КонецФункции	

Процедура ОбойтиУровеньДерева(Строки, ТаблицаЗаписанныхАвторабот, Родитель, НовыйДопРеквизиты, ПолныйОбмен)
	Для Каждого Строка из Строки Цикл		
		Если НЕ ЗначениеЗаполнено(Строка.Наименование) Тогда
			Продолжить;
		КонецЕсли; 
		
		Стр = ТаблицаЗаписанныхАвторабот.Найти(Строка.Артикул, "Артикул");
		
		Если Стр = Неопределено Тогда

			Если НЕ Строка.ЭтоГруппа Тогда
				Ссылка = Справочники.Автоработы.НайтиПоРеквизиту("Артикул", Строка.Артикул,Родитель);
			Иначе
				Ссылка = Справочники.Автоработы.НайтиПоНаименованию(Строка.Наименование, Истина, Родитель);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Ссылка) Тогда				
				Если Строка.ЭтоГруппа Тогда
					НоваяАвторабота = Справочники.Автоработы.СоздатьГруппу();
				Иначе
					НоваяАвторабота = Справочники.Автоработы.СоздатьЭлемент();
					НоваяАвторабота.Артикул = Строка.Артикул;	
					НоваяАвторабота.Заполнить(Неопределено);
					НоваяАвторабота.Номенклатура = Справочники.Номенклатура.Авторабота;
				КонецЕсли;
				НоваяАвторабота.ОбменДанными.Загрузка = Истина;
				НоваяАвторабота.УстановитьНовыйКод();
				НоваяАвторабота.Наименование = Строка.Наименование;				
				НоваяАвторабота.Родитель = Родитель; 
				НоваяАвторабота.Записать();
				Ссылка = НоваяАвторабота.Ссылка; 				
			КонецЕсли;
			
			Если Не Строка.ЭтоГруппа Тогда  				
				НовыйДопРеквизиты.Добавить(Строка.Артикул); 			
			КонецЕсли;			
		Иначе
			Ссылка = Стр.Авторабота;
			Если ПолныйОбмен Тогда
				НовыйДопРеквизиты.Добавить(Строка.Артикул); 
			КонецЕсли;
		КонецЕсли;
		
		ОбойтиУровеньДерева(Строка.Строки, ТаблицаЗаписанныхАвторабот, Ссылка, НовыйДопРеквизиты, ПолныйОбмен);		
	КонецЦикла;  	
КонецПроцедуры

Процедура ЗаполнитьРегистрАвтоработыЦены(ДатаЗаписи, ТабАвтоработы, ПолныйОбмен)
	Запрос = Новый Запрос;
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	таб.АвтоработаАртикул,
	|	таб.ИтогоНЧ,
	|	таб.СтоимостьНормоЧасаСНДС1,
	|	таб.СтоимостьНормоЧасаСНДС2,
	|	таб.Цена1ТЗ,
	|	таб.Цена2ТЗ
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&таб КАК таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(Автоработы.Ссылка) КАК Авторабота,
	|	Автоработы.Артикул КАК Артикул
	|ПОМЕСТИТЬ АвтоработыДанные
	|ИЗ
	|	Справочник.Автоработы КАК Автоработы
	|ГДЕ
	|	Автоработы.Артикул В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТ.АвтоработаАртикул
	|			ИЗ
	|				ВТ КАК ВТ)
	|	И НЕ Автоработы.ЭтоГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	Автоработы.Артикул
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ.ИтогоНЧ) КАК ИтогоНЧ,
	|	МАКСИМУМ(ВТ.СтоимостьНормоЧасаСНДС1) КАК СтоимостьНормоЧасаСНДС1,
	|	МАКСИМУМ(ВТ.СтоимостьНормоЧасаСНДС2) КАК СтоимостьНормоЧасаСНДС2,
	|	МАКСИМУМ(ВТ.Цена1ТЗ) КАК Цена1ТЗ,
	|	МАКСИМУМ(ВТ.Цена2ТЗ) КАК Цена2ТЗ,
	|	АвтоработыДанные.Авторабота,
	|	МАКСИМУМ(&Период) КАК Период,
	|	АвтоработыДанные.Авторабота.ВремяВыполнения КАК ВремяВыполнения
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АвтоработыДанные КАК АвтоработыДанные
	|		ПО ВТ.АвтоработаАртикул = АвтоработыДанные.Артикул
	|
	|СГРУППИРОВАТЬ ПО
	|	АвтоработыДанные.Авторабота,
	|	АвтоработыДанные.Авторабота.ВремяВыполнения";

	Запрос.УстановитьПараметр("таб", ТабАвтоработы);
	Запрос.УстановитьПараметр("Период", НачалоДня(ДатаЗаписи));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	    Возврат;	
	КонецЕсли;
	
	ВыгрузкаДляНабора = РезультатЗапроса.Выгрузить();
	
	Для каждого стр Из ВыгрузкаДляНабора Цикл
	    Если стр.ВремяВыполнения = 0 Тогда
		    АвтоработаОбъект = стр.Авторабота.ПолучитьОбъект();
			АвтоработаОбъект.ОбменДанными.Загрузка = истина;
			АвтоработаОбъект.ВремяВыполнения = стр.ИтогоНЧ;
		    АвтоработаОбъект.Записать();
		КонецЕсли;	
	КонецЦикла;
	
	Если ПолныйОбмен Тогда
		наборЗаписей = РегистрыСведений.Renault_АвтоработыЦены.СоздатьНаборЗаписей();
		наборЗаписей.Прочитать();
		наборЗаписей.Очистить();
		наборЗаписей.Записать();
	КонецЕсли;
	

	наборЗаписей = РегистрыСведений.Renault_АвтоработыЦены.СоздатьНаборЗаписей();
	наборЗаписей.Отбор.Период.Установить(НачалоДня(ДатаЗаписи));
	наборЗаписей.Загрузить(ВыгрузкаДляНабора);
	Попытка
	    наборЗаписей.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("Renault_ЗагрузкаДанных.ЗаполнитьРегистрАвтоработыЦены",УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьРегистрАвтоработыЦеныЗапчасти(ДатаЗаписи, ТабАвтоработыЗапчасти, ПолныйОбмен)
	
	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	таб.АвтоработаАртикул,
	|	таб.PCL,
	|	таб.PNC,
	|	таб.ЗапчастьАртикул,
	|	таб.ЗапчастьПредставление,
	|	ВЫБОР
	|		КОГДА таб.Количество = 0
	|			ТОГДА 1
	|		ИНАЧЕ таб.Количество
	|	КОНЕЦ КАК Количество
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&таб КАК таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(Автоработы.Ссылка) КАК Авторабота,
	|	Автоработы.Артикул КАК АвтоработаАртикул
	|ПОМЕСТИТЬ АвтоработыДанные
	|ИЗ
	|	Справочник.Автоработы КАК Автоработы
	|ГДЕ
	|	Автоработы.Артикул В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТ.АвтоработаАртикул
	|			ИЗ
	|				ВТ КАК ВТ)
	|	И НЕ Автоработы.ЭтоГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	Автоработы.Артикул
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Автоработы.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Номенклатура.Ссылка) КАК Запчасть,
	|	ВТ.ЗапчастьАртикул,
	|	ВТ.ЗапчастьПредставление
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТ.ЗапчастьАртикул = Номенклатура.Артикул
	|			И (ВТ.ЗапчастьАртикул <> """")
	|ГДЕ
	|	Номенклатура.Ссылка ЕСТЬ NULL 
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ЗапчастьАртикул,
	|	ВТ.ЗапчастьПредставление";

	Запрос.УстановитьПараметр("таб", ТабАвтоработыЗапчасти);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда  		
		Номенклатура = Справочники.Номенклатура;
		RENAULT_DMS = Справочники.Номенклатура.НайтиПоНаименованию("RENAULT_DMS");
		КомплексыРабот = Справочники.Номенклатура.НайтиПоНаименованию("Комплексы работ",,RENAULT_DMS);
		Если не ЗначениеЗаполнено(КомплексыРабот) Тогда
			нгр = Номенклатура.СоздатьГруппу();
			нгр.ОбменДанными.Загрузка = Истина;
			нгр.Наименование = "Комплексы работ";
			нгр.Родитель = RENAULT_DMS;
			нгр.Записать();
			КомплексыРабот = нгр.Ссылка;
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл 			
			НовЭл = Номенклатура.СоздатьЭлемент();		 
			НовЭл.ОбменДанными.Загрузка = Истина;
			НовЭл.Наименование = Выборка.ЗапчастьПредставление;
			НовЭл.Артикул = Выборка.ЗапчастьАртикул;
			НовЭл.Родитель = КомплексыРабот; 
			НовЭл.Записать();				
		КонецЦикла;  		
	КонецЕсли;	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ.PCL,
	|	ВТ.PNC,
	|	ВТ.Количество,
	|	АвтоработыДанные.Авторабота,
	|	&Период,
	|	МАКСИМУМ(Номенклатура.Ссылка) КАК Запчасть
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АвтоработыДанные КАК АвтоработыДанные
	|		ПО ВТ.АвтоработаАртикул = АвтоработыДанные.АвтоработаАртикул
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТ.ЗапчастьАртикул = Номенклатура.Артикул
	|			И (Номенклатура.Артикул <> """")
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.PCL,
	|	ВТ.PNC,
	|	ВТ.Количество,
	|	АвтоработыДанные.Авторабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Количество,
	|	АвтоработыДанные.Авторабота,
	|	Номенклатура.Ссылка КАК Запчасть
	|ПОМЕСТИТЬ СвзанныеРаботы
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АвтоработыДанные КАК АвтоработыДанные
	|		ПО ВТ.АвтоработаАртикул = АвтоработыДанные.АвтоработаАртикул
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТ.ЗапчастьАртикул = Номенклатура.Артикул
	|			И (Номенклатура.Артикул <> """")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвзанныеРаботы.Авторабота,
	|	СвзанныеРаботы.Запчасть КАК СвязаннаяРабота,
	|	СвзанныеРаботы.Количество
	|ИЗ
	|	СвзанныеРаботы КАК СвзанныеРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
	|		ПО СвзанныеРаботы.Авторабота = СвязанныеРаботы.Авторабота
	|			И СвзанныеРаботы.Запчасть = СвязанныеРаботы.СвязаннаяРабота
	|ГДЕ
	|	СвязанныеРаботы.Авторабота ЕСТЬ NULL 
	|
	|СГРУППИРОВАТЬ ПО
	|	СвзанныеРаботы.Авторабота,
	|	СвзанныеРаботы.Запчасть,
	|	СвзанныеРаботы.Количество";
	
	Запрос.УстановитьПараметр("Период", НачалоДня(ДатаЗаписи));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатЗапроса[0].Пустой() Тогда
	    Возврат;	
	КонецЕсли;
	
	Если ПолныйОбмен Тогда
		наборЗаписей = РегистрыСведений.Renault_АвтоработыЦеныЗапчастей.СоздатьНаборЗаписей();
		наборЗаписей.Прочитать();
		наборЗаписей.Очистить();
		наборЗаписей.Записать();
	КонецЕсли;

	
	наборЗаписей = РегистрыСведений.Renault_АвтоработыЦеныЗапчастей.СоздатьНаборЗаписей();
	наборЗаписей.Отбор.Период.Установить(НачалоДня(ДатаЗаписи));
	наборЗаписей.Загрузить(РезультатЗапроса[0].Выгрузить());
	Попытка
	    наборЗаписей.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("Renault_ЗагрузкаДанных.ЗаполнитьРегистрАвтоработыЦеныЗапчасти",УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
	КонецПопытки;
	
	наборЗаписей = РегистрыСведений.СвязанныеРаботы.СоздатьНаборЗаписей();
	наборЗаписей.Загрузить(РезультатЗапроса[2].Выгрузить());
	Попытка
	    наборЗаписей.Записать(Ложь);
	Исключение
	    ЗаписьЖурналаРегистрации("Renault_ЗагрузкаДанных.ЗаполнитьРегистрАвтоработыЦеныЗапчасти",УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ОбновитьКритерий(КритерийСсылка,СтрокаКритерииАвтомобилей)
						
	Если КритерийСсылка.Наименование <> СтрокаКритерииАвтомобилей.КритерииАвтомобилей
		ИЛИ КритерийСсылка.КодОбъекта <> СтрокаКритерииАвтомобилей.КодОбъекта
		ИЛИ КритерийСсылка.КодКритерия <> СтрокаКритерииАвтомобилей.КодКритерия
		ИЛИ КритерийСсылка.ОписаниеКритерия <> СтрокаКритерииАвтомобилей.ОписаниеКритерия
		ИЛИ КритерийСсылка.ОписаниеЗначенияКритерия <> СтрокаКритерииАвтомобилей.ОписаниеЗначенияКритерия
		ИЛИ КритерийСсылка.ДопАртикул <> СтрокаКритерииАвтомобилей.ДопАртикул Тогда
		
		ЭлКритерийАвтомобиля = КритерийСсылка.ПолучитьОбъект();
		ЭлКритерийАвтомобиля.Наименование = СтрокаКритерииАвтомобилей.КритерииАвтомобилей;
		ЭлКритерийАвтомобиля.КодОбъекта = СтрокаКритерииАвтомобилей.КодОбъекта;
		ЭлКритерийАвтомобиля.КодКритерия = СтрокаКритерииАвтомобилей.КодКритерия;
		ЭлКритерийАвтомобиля.ОписаниеКритерия = СтрокаКритерииАвтомобилей.ОписаниеКритерия;
		ЭлКритерийАвтомобиля.ОписаниеЗначенияКритерия = СтрокаКритерииАвтомобилей.ОписаниеЗначенияКритерия;
		ЭлКритерийАвтомобиля.ДопАртикул = СтрокаКритерииАвтомобилей.ДопАртикул;
		ЭлКритерийАвтомобиля.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиКритерий(КодОбъекта, КодКритерия)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КритерииАвтомобилей.Ссылка
		|ИЗ
		|	Справочник.Renault_КритерииАвтомобилей КАК Renault_КритерииАвтомобилей
		|ГДЕ
		|	Renault_КритерииАвтомобилей.КодОбъекта = &КодОбъекта
		|	И Renault_КритерииАвтомобилей.КодКритерия = &КодКритерия";
	
	Запрос.УстановитьПараметр("КодКритерия", КодКритерия);
	Запрос.УстановитьПараметр("КодОбъекта", КодОбъекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	 	Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// загрузка номенклатуры и цен из Dictionary
Процедура DMS_ЗагрузкаНоменклатурыЦен(Параметр = Неопределено,Интерактивно=Ложь,ВариантПолученияДанных="update") Экспорт
	
	Ответ="";
	ИмяФункции="Renault_Открытый.ПолучитьНоменклатуру";
	МассивМД=Новый Массив;
	МассивМД.Добавить("Номенклатура");
	МассивМД.Добавить("Цены");
	
	ВыборкаДилеров = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	Пока ВыборкаДилеров.Следующий() Цикл
		Если ВыборкаДилеров.ПометкаУдаления Тогда Продолжить; КонецЕсли;
		BIR = ВыборкаДилеров.BIR;
		Бренд = ВыборкаДилеров.Бренд.Наименование;
		//передача данных DMS->Dictionary      			
		Package=DMS_DataExchange.newPackage(Новый Структура("ВариантПолученияДанных,МассивМД,ПолныйBIR",ВариантПолученияДанных,МассивМД,BIR));
		Если НЕ DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),"DictionaryHTTP",ИмяФункции,Package,Ответ) Тогда 
			Если Интерактивно Тогда 
			Сообщить(Ответ,СтатусСообщения.Внимание) Иначе 
				ЗаписьЖурналаРегистрации(ИмяФункции,УровеньЖурналаРегистрации.Ошибка,,,Ответ) 
			КонецЕсли;
			Ошибка=Истина;
			Продолжить //Возврат Ложь 
		КонецЕсли;
		ОсновнаяГруппа = Справочники.Номенклатура.НайтиПоНаименованию("Номенклатура "+Бренд,Истина);
		Если ОсновнаяГруппа.Пустая() Тогда
			ОсновнаяГруппаОбъект = Справочники.Номенклатура.СоздатьГруппу();
			ОсновнаяГруппаОбъект.Наименование = "Номенклатура "+Бренд;
			ОсновнаяГруппаОбъект.Записать();
			ОсновнаяГруппа = ОсновнаяГруппаОбъект.Ссылка;
		КонецЕсли;
		
		//обработать ответ Dictionary
		Валюта = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		НомерПакета=Ответ.НомерПакета;
		Для Каждого Стр Из Ответ.Данные.Номенклатура Цикл
			
			Родитель = Справочники.Номенклатура.НайтиПоНаименованию(Стр.РодительНаименование,Истина,ОсновнаяГруппа);
			Если Родитель.Пустая() Тогда
				РодительОбъект = Справочники.Номенклатура.СоздатьГруппу();
				РодительОбъект.Наименование = Стр.РодительНаименование;
				РодительОбъект.Родитель = ОсновнаяГруппа;
				РодительОбъект.Записать();
				Родитель = РодительОбъект.Ссылка;
			КонецЕсли;
			
			//поиск ссылки
			Запрос=Новый Запрос("Выбрать Ссылка Из Справочник.Номенклатура ГДЕ Артикул=&Артикул");
			Запрос.УстановитьПараметр("Артикул",Стр.Артикул);
			Выборка=Запрос.Выполнить().Выбрать();
			СпрОбъект=?(Выборка.Следующий(),Выборка.Ссылка.ПолучитьОбъект(),Справочники.Номенклатура.СоздатьЭлемент());
			ЗаполнитьЗначенияСвойств(СпрОбъект,Стр);
			СпрОбъект.Родитель = Родитель;
			//дополнительные поля
			СпрОбъект.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.шт;	
			СпрОбъект.ТипНоменклатуры = Справочники.ТипыНоменклатуры.Штучный;
			СпрОбъект.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Товар;
			СпрОбъект.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
			СпрОбъект.ВалютаУчета = Валюта;
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
			
			//постобработка - связанные данные
			СсылкаЕИ =Справочники.ЕдиницыИзмерения.НайтиПоНаименованию("шт",Истина,,СпрОбъект.Ссылка);
			Если СсылкаЕИ.Пустая() Тогда
				ОбъектЕИ=Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
				ОбъектЕИ.ЕдиницаПоКлассификатору = Справочники.КлассификаторЕдиницИзмерения.шт;
				ОбъектЕИ.Коэффициент = 1;
				ОбъектЕИ.Владелец=СпрОбъект.Ссылка;
				ОбъектЕИ.Наименование="шт";
				ОбъектЕИ.ОбменДанными.Загрузка = Истина;
				ОбъектЕИ.Записать();
				СпрОбъект.ОсновнаяЕдиницаИзмерения = ОбъектЕИ.Ссылка;
				СпрОбъект.ОбменДанными.Загрузка = Истина;
				СпрОбъект.Записать();
			КонецЕсли;
			
		КонецЦикла;
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Артикулы.Артикул КАК Артикул
		|ПОМЕСТИТЬ Артикулы
		|ИЗ
		|	&Артикулы КАК Артикулы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Артикулы.Артикул КАК Артикул,
		|	Номенклатура.Ссылка КАК Номенклатура
		|ИЗ
		|	Артикулы КАК Артикулы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
		|		ПО Артикулы.Артикул = Номенклатура.Артикул";
		
		Запрос.УстановитьПараметр("Артикулы",Ответ.Данные.Цены);
		ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
		ТаблицаНоменклатуры.Индексы.Добавить("Артикул");
		//Загрузка цен номенклатуры 
		ТипЦены = Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
		Если Ответ.Данные.Цены.Количество() > 0 Тогда
			//В регистр
			Набор = РегистрыСведений.Renault_ТарифЦен.СоздатьНаборЗаписей();
			Для Каждого Стр Из Ответ.Данные.Цены Цикл
				Запись = Набор.Добавить();
				Запись.Артикул = Стр.Артикул; 
				Запись.ТипЦены = ТипЦены;
				Запись.ДатаТарифа = Стр.ДатаТарифа;
				Запись.Цена = Стр.Цена;
				Запись.КодВалюты = "RUB";
			КонецЦикла;
			Если Набор.Количество() > 0 Тогда
				Набор.Записать();
			КонецЕсли;
			
			//в документ
			Док = Документы.ИзменениеЦен.СоздатьДокумент();
			Док.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
			Док.ВалютаДокумента = Валюта;
			Док.КурсДокумента = 1;
			Док.БазовыйТипЦен = ТипЦены;
			Если Док.ТипЦен.ЦенаВключаетНДС Тогда
				Множитель = 1 + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка/100;
				//Множитель = 1.18;
			Иначе
				Множитель = 1;
			КонецЕсли;
			Док.Организация = ВыборкаДилеров.Организация;
			Док.Автор = ПараметрыСеанса.Пользователь;
			Док.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
			Док.ХозОперация = Справочники.ХозОперации.УстановкаЦенКомпании;
			Док.ПодразделениеКомпанииПолучатель = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
			Док.ОбработкаРеквизита("ТипЦен");
			Для Каждого Стр Из Ответ.Данные.Цены Цикл
				Док.Дата = Стр.ДатаТарифа;
				ДокСтр = Док.Товары.Добавить();
				ДокСтр.Номенклатура = ТаблицаНоменклатуры.Найти(Стр.Артикул,"Артикул").Номенклатура;
				Док.ОбработкаРеквизита("Товары.Номенклатура", ДокСтр);
				ДокСтр.Цена = Стр.Цена * Множитель;
				Док.ОбработкаРеквизита("Товары.Цена", ДокСтр); 
			КонецЦикла;
			Док.ОбменДанными.Загрузка = Истина;
			Док.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;     
		
		//удалить регистрацию объектов
		Ответ="";
		ИмяФункции="Renault_Открытый.ЗафиксироватьУспешнуюОтправкуПакетаНоменклатуры";
		Package=DMS_DataExchange.newPackage(Новый Структура("МассивМД,ПолныйBIR,Бренд",МассивМД,BIR,Бренд));
		Если НЕ DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),"DictionaryHTTP",ИмяФункции,Package,Ответ) Тогда
			Если Интерактивно Тогда 
				Сообщить(Ответ,СтатусСообщения.Внимание) 
			Иначе 
				ЗаписьЖурналаРегистрации(ИмяФункции,УровеньЖурналаРегистрации.Ошибка,,,Ответ) 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры




