
Процедура ОтправитьЗаявкуНаКлиента(КорпКлиентСсылка) Экспорт
	
	Прокси = RenaultFlotte_ОбщегоНазначения.ПолучитьПрокси();
	Данные = СформироватьСтруктуруДляПередачиКлиента(Прокси, КорпКлиентСсылка);
	Сервер = СтрокаСоединенияИнформационнойБазы();
	Прокси.PutClientRequestStructure(Данные, Сервер);
	
	Если Не РегистрыСведений.RenaultFlotte_ИсторияКомментариев.НайтиКомментарийПоОбъекту(
		КорпКлиентСсылка.ИдЗаявки,
		"Создана заявка на регистрацию") Тогда
		
		РегистрыСведений.RenaultFlotte_ИсторияКомментариев.ДобавитьКомментарий(
			КорпКлиентСсылка.ИдЗаявки,
			"Создана заявка на регистрацию",
			ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр);
			
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьПакетДляПередачиКлиента(Прокси, КлиентСсылка)
	
	КлиентОбъект = КлиентСсылка.ПолучитьОбъект();
	
	XDTOКлиент = СоздатьОбъектXDTO(Прокси, "CorporateClient");
	Наименование = ПривестиНаименованиеВТребуемыйВид(КлиентОбъект.Наименование);
	XDTOКлиент.name = Наименование;
	XDTOКлиент.fullName = КлиентОбъект.Контрагент.НаименованиеПолное;
	XDTOКлиент.inn = КлиентОбъект.Контрагент.ИНН;
	XDTOКлиент.idReference = КлиентСсылка.УникальныйИдентификатор();
	Настройки = Renault_РаботаСПравамиПользователя.ПолучитьСписокПрав(КлиентОбъект.Автор);
	XDTOКлиент.idDealerCentre = Настройки.ДилерскийЦентр.УникальныйИдентификатор();
	XDTOКлиент.BIR = Настройки.ДилерскийЦентр.BIR;

	XDTOКлиент.idRequest = Неопределено;
	
	Если ЗначениеЗаполнено(КлиентСсылка.ИдЗаявки) Тогда
		XDTOКлиент.idRequest = КлиентСсылка.ИдЗаявки;
	КонецЕсли;
	
	Если КлиентОбъект.Автопарк.Количество() > 0 Тогда
		
		Для Каждого СтрокаАвтопарк из КлиентОбъект.Автопарк Цикл
			XDTOАвтопарк = СоздатьОбъектXDTO(Прокси, "CarInAutoPark");
			XDTOАвтопарк.marka = СтрокаАвтопарк.Марка;
			XDTOАвтопарк.model = СтрокаАвтопарк.Модель;
			XDTOАвтопарк.kolvo = СтрокаАвтопарк.Количество;
			XDTOКлиент.autopark.Добавить(XDTOАвтопарк);
		КонецЦикла;
		
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Значение      = КлиентСсылка.Контрагент.Ссылка;
	НаборЗаписей.Отбор.Объект.Использование = Истина;
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		Для Каждого СтрокаНабораЗаписей из НаборЗаписей Цикл
			XDTOКонтактнаяИнформация = СоздатьОбъектXDTO(Прокси,"Contact");
			XDTOКонтактнаяИнформация.type = Строка(СтрокаНабораЗаписей.Тип);
			XDTOКонтактнаяИнформация.vid = СтрокаНабораЗаписей.Вид.Наименование;
			XDTOКонтактнаяИнформация.presentation = СтрокаНабораЗаписей.Представление;
			XDTOКлиент.contactInformation.Добавить(XDTOКонтактнаяИнформация);
		КонецЦикла;
	КонецЕсли;
	НаборЗаписей = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка,
	|	Контрагенты.Наименование,
	|	ЕСТЬNULL(Контрагенты.Должность.Наименование, """") КАК ДолжностьНаименование
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ВедушийКонтрагент = &ВедушийКонтрагент
	|	И Контрагенты.ВидОтношений = &ВидОтношений";
	Запрос.УстановитьПараметр("ВедушийКонтрагент", КлиентСсылка.Контрагент);
	Запрос.УстановитьПараметр("ВидОтношений", Справочники.ВидыВзаимоотношений.КонтактноеЛицо);
	
	Результат = Запрос.Выполнить();
	
	Если не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			XDTOКонтактноеЛицо = СоздатьОбъектXDTO(Прокси,"ContactPerson");
			XDTOКонтактноеЛицо.idReference = Выборка.Ссылка.УникальныйИдентификатор();
			XDTOКонтактноеЛицо.name = Выборка.Наименование;
			XDTOКонтактноеЛицо.position = Выборка.ДолжностьНаименование;
			НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Значение      = Выборка.Ссылка;
			НаборЗаписей.Отбор.Объект.Использование = Истина;
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				Для Каждого СтрокаНабораЗаписей из НаборЗаписей Цикл
					XDTOКонтактнаяИнформация = СоздатьОбъектXDTO(Прокси,"Contact");
					XDTOКонтактнаяИнформация.type = Строка(СтрокаНабораЗаписей.Тип);
					XDTOКонтактнаяИнформация.vid = СтрокаНабораЗаписей.Вид.Наименование;
					XDTOКонтактнаяИнформация.presentation = СтрокаНабораЗаписей.Представление;
					XDTOКонтактноеЛицо.contactInformation.Добавить(XDTOКонтактнаяИнформация);
				КонецЦикла;
			КонецЕсли;
			НаборЗаписей = Неопределено;
			XDTOКлиент.contactPersons.Добавить(XDTOКонтактноеЛицо);
		КонецЦикла;
	КонецЕсли;
	
	Если КлиентОбъект.СферыДеятельности.Количество() > 0 Тогда
		
		Для Каждого СтрокаСферыДеятельности из КлиентОбъект.СферыДеятельности Цикл
			XDTOСфераДеятельности = СоздатьОбъектXDTO(Прокси,"ActionSphere");
			XDTOСфераДеятельности.idReference = СтрокаСферыДеятельности.СфераДеятельности.УникальныйИдентификатор();
			XDTOКлиент.actionSpheres.Добавить(XDTOСфераДеятельности);
		КонецЦикла;
		
	КонецЕсли;
	
	Данные = ПолучитьДанныеДляПередачи(Прокси, XDTOКлиент);
	Возврат Данные;
	
КонецФункции

Функция ПривестиНаименованиеВТребуемыйВид(Знач Наименование) Экспорт
	
	Наименование = ВРег(Наименование);
	Наименование = СтрЗаменить(Наименование,"ООО","");
	Наименование = СтрЗаменить(Наименование,"ПАО","");
	Наименование = СтрЗаменить(Наименование,"ЗАО","");
	Наименование = СтрЗаменить(Наименование,"ТОО","");
	Наименование = СтрЗаменить(Наименование,"ИП","");
	Наименование = СтрЗаменить(Наименование,"АО","");
	Наименование = СтрЗаменить(Наименование,"""","");
	Возврат СокрЛП(Наименование);
	
КонецФункции

Функция ПолучитьДанныеДляПередачи(Прокси, ВходящиеДанные)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("Message");
	Прокси.ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ВходящиеДанные);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();
	ДвоичныеДанныеСообщения = Новый ДвоичныеДанные(ИмяВременногоФайла);
	ХранилищеЗначенияФайла = Новый ХранилищеЗначения(ДвоичныеДанныеСообщения, Новый СжатиеДанных(9));
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат ХранилищеЗначенияФайла;
	
КонецФункции

Функция СоздатьОбъектXDTO(Прокси, ТипОбъекта)
	
	Фабрика = Прокси.ФабрикаXDTO;
	Объект = Фабрика.Создать(
		Фабрика.Тип(
			"http://renault.ru/FlotteCentral", 
			ТипОбъекта));
	Возврат Объект;
	
КонецФункции

Процедура Renault_КорпоративныйКлиентПередЗаписьюПередЗаписью(Источник, Отказ) Экспорт
     	
	Если Источник.ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Источник.ДополнительныеСвойства.Вставить("Состояние", Источник.Ссылка.Состояние);
	
КонецПроцедуры

Процедура Renault_КорпоративныйКлиентПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
     	
	Если Источник.ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если Источник.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.НаСогласовании
		или Источник.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.Согласован Тогда
		
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Источник.Ссылка);
		ФоновыеЗадания.Выполнить("RenaultFlotte_ОтправкаЗагрузкаКлиентов.ОтправитьЗаявкуНаКлиента", МассивПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьКорпоративныхКлиентов() Экспорт
	Попытка	
		УстановитьПривилегированныйРежим(Истина);
		
		Прокси = RenaultFlotte_ОбщегоНазначения.ПолучитьПрокси();
		
		Выборка = Справочники.CRM_ДилерскиеЦентры.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ОбъектXDTO = Прокси.GetClientCenter(Выборка.Ссылка.УникальныйИдентификатор());
			Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
			ТаблицаДанных = Сериализатор.ПрочитатьXDTO(ОбъектXDTO);
			
			МассивОбработанных = Новый Массив;
			
			Для Каждого Пакет из ТаблицаДанных Цикл
				ОбработатьПакет (Пакет, Прокси);
				МассивОбработанных.Добавить(Пакет.МоментВремени);
			КонецЦикла;
			
			МассивОбработанныхОбъектXDTO = Сериализатор.ЗаписатьXDTO(МассивОбработанных);
			
			Прокси.ConfirmProcessingClient(МассивОбработанныхОбъектXDTO, Выборка.Ссылка.УникальныйИдентификатор(), Выборка.BIR);
			
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
		"КорпЗагрузкаДанных.ЗагрузитьКорпоративныхКлиентов",
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Инфо));
	КонецПопытки;
КонецПроцедуры

Процедура ОбработатьПакет(ДанныеСообщения, Прокси)
	
	ДвоичныеДанныеФайла = ДанныеСообщения.Данные.Получить();
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	ЧтениеXML.Прочитать();
	ЧтениеXML.Прочитать(); // пропуск тэга Message
	Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		ТипXDTO = Прокси.ФабрикаXDTO.Тип(ДанныеСообщения.ПространствоИменДанных, ЧтениеXML.Имя);
		ОбъектXDTO = Прокси.ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
		СтрокаДляВыполнения = ДанныеСообщения.ИмяКомандыОбработки + "(ОбъектXDTO);";
		Выполнить(СтрокаДляВыполнения);
	КонецЦикла;
	ЧтениеXML.Закрыть();
	УдалитьФайлы(ИмяВременногоФайла);

КонецПроцедуры

Процедура ЗагрузитьКорпоративногоКлиента(ОбъектXDTO)
	
	//Создание-обновление данных клиента
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ИНН", ОбъектXDTO.inn);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КонтрагентОбъект = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонецЕсли;
	Если КонтрагентОбъект.ЭтоНовый() Тогда
		КлиентОбъект = Справочники.Renault_КорпоративныеКлиенты.СоздатьЭлемент();
	иначе
		КлиентСсылка = Справочники.Renault_КорпоративныеКлиенты.НайтиПоРеквизиту("Контрагент", КонтрагентОбъект.Ссылка);
		Если КлиентСсылка <> Справочники.Renault_КорпоративныеКлиенты.ПустаяСсылка() Тогда
			КлиентОбъект = КлиентСсылка.ПолучитьОбъект();
		Иначе
			КлиентОбъект = Справочники.Renault_КорпоративныеКлиенты.СоздатьЭлемент();
		КонецЕсли;
	КонецЕсли;
	Если КлиентОбъект.ЭтоНовый() Тогда
		СсылкаКлиента = Справочники.Renault_КорпоративныеКлиенты.ПолучитьСсылку(ОбъектXDTO.idReference);
		КлиентОбъект.УстановитьСсылкуНового(СсылкаКлиента);
	КонецЕсли;
	
	Если ОбъектXDTO.autopark.Количество() > 0 Тогда 
		КлиентОбъект.Автопарк.Очистить();
	КонецЕсли;
	
	Если ОбъектXDTO.actionSpheres.Количество() > 0 Тогда 
		КлиентОбъект.СферыДеятельности.Очистить();
	КонецЕсли;
	
	КлиентОбъект.Наименование = ОбъектXDTO.name;
	КлиентОбъект.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.НаСогласовании;
	КлиентОбъект.ИдЗаявки = ОбъектXDTO.idRequest;
	КонтрагентОбъект.Наименование = ОбъектXDTO.name;
	КонтрагентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
	КонтрагентОбъект.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;
	КонтрагентОбъект.НаименованиеПолное = ОбъектXDTO.fullName;
	КонтрагентОбъект.ИНН = ОбъектXDTO.inn;
	
	Для Каждого СтрокаАвтопарка из ОбъектXDTO.autopark Цикл
		СтрокаАвтопаркаКлиента = КлиентОбъект.Автопарк.Добавить();
		СтрокаАвтопаркаКлиента.Марка = СтрокаАвтопарка.marka;
		СтрокаАвтопаркаКлиента.Модель = СтрокаАвтопарка.model;
		СтрокаАвтопаркаКлиента.Количество = СтрокаАвтопарка.kolvo;
	КонецЦикла;
	
	Для Каждого СтрокаСфераДеятельности из ОбъектXDTO.actionSpheres Цикл
		СтрокаСфераДеятельностиКлиента = КлиентОбъект.СферыДеятельности.Добавить();
		СтрокаСфераДеятельностиКлиента.СфераДеятельности = Справочники.Renault_СферыДеятельностиКлиентов.ПолучитьСсылку(СтрокаСфераДеятельности.idReference);
	КонецЦикла;
	Попытка
		КонтрагентОбъект.Записать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	КлиентОбъект.Контрагент = КонтрагентОбъект.Ссылка;
	КлиентОбъект.ОбменДанными.Загрузка = Истина;
	
	Попытка
		КлиентОбъект.Записать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьСтатусыЗаявок() Экспорт
	Попытка	
		УстановитьПривилегированныйРежим(Истина);
		
		Прокси = RenaultFlotte_ОбщегоНазначения.ПолучитьПрокси();
		Выборка = Справочники.CRM_ДилерскиеЦентры.Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбъектXDTO = Прокси.GetClientStatus(Выборка.Ссылка.УникальныйИдентификатор(), Выборка.BIR);
			Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
			ТаблицаДанных = Сериализатор.ПрочитатьXDTO(ОбъектXDTO);
			МассивОбработанных = Новый Массив;
			Для Каждого Пакет из ТаблицаДанных Цикл
				ДвоичныеДанныеФайла = Пакет.Данные.Получить();
				ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
				ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
				ЧтениеXML = Новый ЧтениеXML;
				ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
				ЧтениеXML.Прочитать();
				ЧтениеXML.Прочитать(); // пропуск тэга Message
				Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
					ТипXDTO = Прокси.ФабрикаXDTO.Тип(Пакет.ПространствоИменДанных, ЧтениеXML.Имя);
					ОбъектXDTO = Прокси.ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO); 
					Отказ = ЗагрузитьСтатусЗаявки(ОбъектXDTO);
				КонецЦикла;
				ЧтениеXML.Закрыть();
				УдалитьФайлы(ИмяВременногоФайла);
				Если Не Отказ Тогда
					МассивОбработанных.Добавить(Пакет.МоментВремени);
				КонецЕсли;
			КонецЦикла;
			МассивОбработанныхОбъектXDTO = Сериализатор.ЗаписатьXDTO(МассивОбработанных);
			Прокси.ConfirmProcessingClient(МассивОбработанныхОбъектXDTO, Выборка.Ссылка.УникальныйИдентификатор(), Выборка.BIR);
		КонецЦикла;
	Исключение
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
		"КорпЗагрузкаДанных.ЗагрузитьСтатусыЗаявок",
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Инфо));
		ВызватьИсключение;
	КонецПопытки;	
КонецПроцедуры

Функция ЗагрузитьСтатусЗаявки(ОбъектXDTO)
	
	КорпКлиент = Справочники.Renault_КорпоративныеКлиенты.НайтиПоРеквизиту("ИдЗаявки", ОбъектXDTO.idRequest);
	Если КорпКлиент = Справочники.Renault_КорпоративныеКлиенты.ПустаяСсылка() Тогда
		Возврат Истина;
	КонецЕсли;
	КорпКлиентОбъект = КорпКлиент.ПолучитьОбъект();
	Если ОбъектXDTO.isConfirned Тогда
		Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.Согласован;
	Иначе
		Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.НеСогласован;
	КонецЕсли;
	КорпКлиентОбъект.Состояние = Состояние;
	КорпКлиентОбъект.Идентификатор = ОбъектXDTO.idNumberClient;
	КорпКлиентОбъект.Записать();
	
	Renault_СообщенияПользователям.ПослатьСообщениеПользователю(
		Справочники.Renault_ВидСообщения.Корп_ИзменениеСтатусаЗаявкиНаКлиента,
		КорпКлиентОбъект.Менеджер,
		"Статус корп. клиента " + КорпКлиентОбъект.Наименование + " изменился на """ + Состояние + """");
	
	Возврат Ложь;
	
КонецФункции

Процедура RenaultFlotte_ОбщаяЗагрузкаВыгрузка(Параметр1 = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	RenaultFlotte_ОтправкаЗагрузкаЗаявокНаКорпСкидку.ОтправитьЗаявкиНаСогласование();
	RenaultFlotte_ОтправкаЗагрузкаЗаявокНаКорпСкидку.ЗагрузитьЗаявкиНаСкидку();
	RenaultFlotte_ОтправкаЗагрузкаКлиентов.ЗагрузитьКорпоративныхКлиентов();
	RenaultFlotte_ОтправкаЗагрузкаЗаявокНаКорпСкидку.ЗагрузитьСтатусыVIN();
	RenaultFlotte_ОтправкаЗагрузкаКлиентов.ЗагрузитьСтатусыЗаявок();
	RenaultFlotte_ОтправкаЗагрузкаЗаявокНаКорпСкидку.ЗагрузитьТаблицуКорпСкидок();
	RenaultFlotte_ЗагрузкаСправочников.RenaultFlotte_ЗагрузкаСправочников();
	RenaultFlotte_ОтправкаЗагрузкаКомментариев.RenaultFlotte_ОбменКомментариями();
	
КонецПроцедуры 

//Функция упаковывает данные клиента в структуру
//замена функции СформироватьПакетДляПередачиКлиента
Функция СформироватьСтруктуруДляПередачиКлиента(Прокси, КлиентСсылка)
	
	КлиентОбъект = КлиентСсылка.ПолучитьОбъект();
	
	ТаблКлиента = Новый Структура;
		
	Наименование = ПривестиНаименованиеВТребуемыйВид(КлиентОбъект.Наименование);
	ТаблКлиента.Вставить("name",		Наименование);
	ТаблКлиента.Вставить("fullName",	КлиентОбъект.Контрагент.НаименованиеПолное);
	ТаблКлиента.Вставить("inn",			КлиентОбъект.Контрагент.ИНН);
	ТаблКлиента.Вставить("idReference",	КлиентСсылка.УникальныйИдентификатор());
	
	Настройки = Renault_РаботаСПравамиПользователя.ПолучитьСписокПрав(КлиентОбъект.Автор);
	ТаблКлиента.Вставить("idDealerCentre",	Настройки.ДилерскийЦентр.УникальныйИдентификатор());
	ТаблКлиента.Вставить("BIR",	            Настройки.ДилерскийЦентр.BIR);
	ТаблКлиента.Вставить("PersInfo",		КлиентОбъект.ПерсДанные);
	ТаблКлиента.Вставить("advertisement",	КлиентОбъект.РассылкаРекламныхМатериалов);
	ТаблКлиента.Вставить("CorpPortal",		КлиентОбъект.РегистрацияНаКорпоративномПортале);
	
	Если ЗначениеЗаполнено(КлиентСсылка.ИдЗаявки) Тогда
		ТаблКлиента.Вставить("idRequest", КлиентСсылка.ИдЗаявки);
	КонецЕсли;
	
	Если КлиентОбъект.Автопарк.Количество() > 0 Тогда
		
		ТаблАвтопарк = Новый ТаблицаЗначений;
		ТаблАвтопарк.Колонки.Добавить("marka",);
		ТаблАвтопарк.Колонки.Добавить("model",);
		ТаблАвтопарк.Колонки.Добавить("kolvo",);
		
		Для Каждого СтрокаАвтопарк из КлиентОбъект.Автопарк Цикл
			СтрокаТаблАвтопарк = ТаблАвтопарк.Добавить();
			СтрокаТаблАвтопарк.marka = СтрокаАвтопарк.Марка.Наименование;
			СтрокаТаблАвтопарк.model = СтрокаАвтопарк.Модель;
			СтрокаТаблАвтопарк.kolvo = СтрокаАвтопарк.Количество;
		КонецЦикла;
		
		ТаблКлиента.Вставить("autopark", Новый ХранилищеЗначения(ТаблАвтопарк));
		
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Значение      = КлиентСсылка.Контрагент.Ссылка;
	НаборЗаписей.Отбор.Объект.Использование = Истина;
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		
		ТаблКонтакты = Новый ТаблицаЗначений;
		ТаблКонтакты.Колонки.Добавить("type",);
		ТаблКонтакты.Колонки.Добавить("vid",);
		ТаблКонтакты.Колонки.Добавить("presentation",);
		
		Для Каждого СтрокаНабораЗаписей из НаборЗаписей Цикл
			СтрокаКонтактнаяИнформация = ТаблКонтакты.Добавить();
			СтрокаКонтактнаяИнформация.type = Строка(СтрокаНабораЗаписей.Тип);
			СтрокаКонтактнаяИнформация.vid = СтрокаНабораЗаписей.Вид.Наименование;
			СтрокаКонтактнаяИнформация.presentation = СтрокаНабораЗаписей.Представление;
		КонецЦикла;
		
		ТаблКлиента.Вставить("contactInformation", Новый ХранилищеЗначения(ТаблКонтакты));
		
	КонецЕсли;
	
	НаборЗаписей = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка,
	|	Контрагенты.Наименование,
	|	ЕСТЬNULL(Контрагенты.Должность.Наименование, """") КАК ДолжностьНаименование
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ВедушийКонтрагент = &ВедушийКонтрагент
	|	И Контрагенты.ВидОтношений = &ВидОтношений";
	Запрос.УстановитьПараметр("ВедушийКонтрагент", КлиентСсылка.Контрагент);
	Запрос.УстановитьПараметр("ВидОтношений", Справочники.ВидыВзаимоотношений.КонтактноеЛицо);
	
	Результат = Запрос.Выполнить();
	
	Если не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		ТаблКонтактноеЛицо = Новый ТаблицаЗначений;
		ТаблКонтактноеЛицо.Колонки.Добавить("idReference",);
		ТаблКонтактноеЛицо.Колонки.Добавить("name",);
		ТаблКонтактноеЛицо.Колонки.Добавить("position",);
		ТаблКонтактноеЛицо.Колонки.Добавить("contactInformation",);
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаКонтактноеЛицо = ТаблКонтактноеЛицо.Добавить();
			СтрокаКонтактноеЛицо.idReference = Выборка.Ссылка.УникальныйИдентификатор();
			СтрокаКонтактноеЛицо.name = Выборка.Наименование;
			СтрокаКонтактноеЛицо.position = Выборка.ДолжностьНаименование;
			НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Значение      = Выборка.Ссылка;
			НаборЗаписей.Отбор.Объект.Использование = Истина;
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				
				ТаблКонтактноеЛицоКонтакт = Новый ТаблицаЗначений;
				ТаблКонтактноеЛицоКонтакт.Колонки.Добавить("type",);
				ТаблКонтактноеЛицоКонтакт.Колонки.Добавить("vid",);
				ТаблКонтактноеЛицоКонтакт.Колонки.Добавить("presentation",);
				
				Для Каждого СтрокаНабораЗаписей из НаборЗаписей Цикл
					СтрокаКонтактноеЛицоКонтакт = ТаблКонтактноеЛицоКонтакт.Добавить();
					СтрокаКонтактноеЛицоКонтакт.type = Строка(СтрокаНабораЗаписей.Тип);
					СтрокаКонтактноеЛицоКонтакт.vid = СтрокаНабораЗаписей.Вид.Наименование;
					СтрокаКонтактноеЛицоКонтакт.presentation = СтрокаНабораЗаписей.Представление;
				КонецЦикла;
				
				СтрокаКонтактноеЛицо.contactInformation = Новый ХранилищеЗначения(ТаблКонтактноеЛицоКонтакт);
				
			КонецЕсли;
			
			НаборЗаписей = Неопределено;
			
		КонецЦикла;
		
		ТаблКлиента.Вставить("contactPersons", Новый ХранилищеЗначения(ТаблКонтактноеЛицо));
		
	КонецЕсли;
	
	Если КлиентОбъект.СферыДеятельности.Количество() > 0 Тогда
		
		ТаблСферыДеятельности = Новый ТаблицаЗначений;
		ТаблСферыДеятельности.Колонки.Добавить("idReference",);
		
		Для Каждого СтрокаСферыДеятельности из КлиентОбъект.СферыДеятельности Цикл
			СтрокаТабСфераДеятельности = ТаблСферыДеятельности.Добавить();
			СтрокаТабСфераДеятельности.idReference = СтрокаСферыДеятельности.СфераДеятельности.УникальныйИдентификатор();
		КонецЦикла;
		
		ТаблКлиента.Вставить("actionSpheres", Новый ХранилищеЗначения(ТаблСферыДеятельности));
		
	КонецЕсли;
	
	Данные = ПолучитьДанныеДляПередачи(Прокси, СериализаторXDTO.ЗаписатьXDTO(ТаблКлиента));
	Возврат Данные;
	
КонецФункции

//замена процедуры ЗагрузитьКорпоративногоКлиента
Процедура ЗагрузитьКорпоративногоКлиентаСтруктура(ОбъектXDTO)
	
	Табл = СериализаторXDTO.ПрочитатьXDTO(ОбъектXDTO);
	
	//Создание-обновление данных клиента
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН
		|	И Контрагенты.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ИНН", Табл.inn);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КонтрагентОбъект = Выборка.Ссылка.ПолучитьОбъект();
	Иначе
		КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонецЕсли;
	Если КонтрагентОбъект.ЭтоНовый() Тогда
		КлиентОбъект = Справочники.Renault_КорпоративныеКлиенты.СоздатьЭлемент();
	иначе
		КлиентСсылка = Справочники.Renault_КорпоративныеКлиенты.НайтиПоРеквизиту("Контрагент", КонтрагентОбъект.Ссылка);
		Если КлиентСсылка <> Справочники.Renault_КорпоративныеКлиенты.ПустаяСсылка() Тогда
			КлиентОбъект = КлиентСсылка.ПолучитьОбъект();
		Иначе
			КлиентОбъект = Справочники.Renault_КорпоративныеКлиенты.СоздатьЭлемент();
		КонецЕсли;
	КонецЕсли;
	Если КлиентОбъект.ЭтоНовый() Тогда
		СсылкаКлиента = Справочники.Renault_КорпоративныеКлиенты.ПолучитьСсылку(Табл.idReference);
		КлиентОбъект.УстановитьСсылкуНового(СсылкаКлиента);
	КонецЕсли;
	
	autopark = Табл.autopark.Получить();
	
	Если autopark.Количество() > 0 Тогда 
		КлиентОбъект.Автопарк.Очистить();
	КонецЕсли;
	
	actionSpheres = Табл.actionSpheres.Получить();
	
	Если actionSpheres.Количество() > 0 Тогда 
		КлиентОбъект.СферыДеятельности.Очистить();
	КонецЕсли;
	
	КлиентОбъект.Наименование = Табл.name;
	КлиентОбъект.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.НаСогласовании;
	КлиентОбъект.ИдЗаявки = Табл.idRequest;
	КонтрагентОбъект.Наименование = Табл.name;
	КонтрагентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
	КонтрагентОбъект.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;
	КонтрагентОбъект.НаименованиеПолное = Табл.fullName;
	КонтрагентОбъект.ИНН = Табл.inn;
	
	Для Каждого СтрокаАвтопарка из autopark Цикл
		СтрокаАвтопаркаКлиента = КлиентОбъект.Автопарк.Добавить();
		СтрокаАвтопаркаКлиента.Марка = СтрокаАвтопарка.marka;
		СтрокаАвтопаркаКлиента.Модель = СтрокаАвтопарка.model;
		СтрокаАвтопаркаКлиента.Количество = СтрокаАвтопарка.kolvo;
	КонецЦикла;
	
	Для Каждого СтрокаСфераДеятельности из actionSpheres Цикл
		СтрокаСфераДеятельностиКлиента = КлиентОбъект.СферыДеятельности.Добавить(); 
		СтрокаСфераДеятельностиКлиента.СфераДеятельности = Справочники.Renault_СферыДеятельностиКлиентов.ПолучитьСсылку(СтрокаСфераДеятельности.idReference);
	КонецЦикла;
	Попытка
		КонтрагентОбъект.Записать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	КлиентОбъект.Контрагент = КонтрагентОбъект.Ссылка;
	
	КлиентОбъект.ОбменДанными.Загрузка = Истина;
	
	Попытка
		КлиентОбъект.Записать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ПоискКонтрагентаВDictionary(ИНН) Экспорт
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	Прокси = RenaultFlotte_ПолучитьПрокси();
	
	ДанныеКлиента = Прокси.GetCorpClientFromDictionary(ИНН);
	
	Возврат СериализаторXDTO.ПрочитатьXDTO(ДанныеКлиента);
	
КонецФункции

Функция RenaultFlotte_ПолучитьПрокси()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	
	АдресWS = Настройки.КЦАдресСервера;
	
	СообщениеОбОшибке = "";
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/Flotte.1cws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(
		ВСОпределение, 
		"http://renault.ru/FlotteCentral", 
		"Renault_Flotte", 
		"Renault_FlotteSoap12", 
		3600);
		
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	Возврат ВебСервис;
	
КонецФункции



