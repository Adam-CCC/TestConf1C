
Функция _ABC(Класс)
    Если Класс = Перечисления.Renault_ABCКлассификация.AКласс Тогда
        Возврат "A";
    ИначеЕсли Класс = Перечисления.Renault_ABCКлассификация.BКласс Тогда
        Возврат "B";
    ИначеЕсли Класс = Перечисления.Renault_ABCКлассификация.CКласс Тогда
        Возврат "C";
    ИначеЕсли Класс = Перечисления.Renault_ABCКлассификация.DКласс Тогда
        Возврат "D";
    Иначе
        Возврат "N";
    КонецЕсли;
КонецФункции

Функция _XYZ(Класс)
    Если Класс = Перечисления.Renault_XYZКлассификация.XКласс Тогда
        Возврат "X";
    ИначеЕсли Класс = Перечисления.Renault_XYZКлассификация.YКласс Тогда
        Возврат "Y";
    ИначеЕсли Класс = Перечисления.Renault_XYZКлассификация.ZКласс Тогда
        Возврат "Z";
    Иначе
        Возврат "N";
    КонецЕсли;
КонецФункции


Функция ПолучитьПредставлениеКлассификации(
            ABCКласс=Неопределено,
            XYZКласс=Неопределено,
            ЧастотнаяГруппа=Неопределено,
            ЦеноваяГруппа=Неопределено,
            СтатусНоменклатуры=Неопределено) Экспорт

    СтрокаПредставления = "" +
            _ABC(ABCКласс)                                              + "-" +
            _XYZ(XYZКласс)                                              + "-" +
            ?(ТипЗнч(ЧастотнаяГруппа) = Тип("Число"), ЧастотнаяГруппа, "_") + "-" +
            ?(ТипЗнч(ЦеноваяГруппа) = Тип("Число"), ЦеноваяГруппа, "_")     +
            ?(ЗначениеЗаполнено(СтатусНоменклатуры), "-" + СтатусНоменклатуры, "");
    Возврат СтрокаПредставления;

КонецФункции


Функция ОткрытьНоменклатуру(НоменклатураСсылка) Экспорт

    Если Не Renault_ЗапчастиСервер.ЭтоНоменклатураРено(НоменклатураСсылка) Тогда
        ОткрытьЗначение(НоменклатураСсылка);
    Иначе
        Менеджер = РегистрыСведений.Renault_КаталогРеферансов.СоздатьМенеджерЗаписи();
        Менеджер.Артикул = НоменклатураСсылка.Артикул;
        Менеджер.Прочитать();
        Форма = РегистрыСведений.Renault_КаталогРеферансов.ПолучитьФорму("ФормаПросмотра");
        Форма.РегистрСведенийМенеджерЗаписи = Менеджер;
        Форма.Открыть();
    КонецЕсли;

КонецФункции
