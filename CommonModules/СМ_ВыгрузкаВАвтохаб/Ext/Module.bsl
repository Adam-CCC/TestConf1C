//// Процедуры / функции для выгрузки данных по перемещению автомобиля:
//// смена кабинета дилера (локации) в Автохаб
///////////////////////////////////////////////////////////////////////

Функция ДанныеПеремещения(СтрокаАвтомобиль, НомерКабинетаПолучателя)
	стТело = Новый Структура();
	стТело.Вставить("reason", "moved");
	стДилер = Новый Структура();
	стДилер.Вставить("id", НомерКабинетаПолучателя);
	стТело.Вставить("copyDealer", стДилер);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТело);
	Исключение
		Сообщить("Не удалось записать JSON-данные для принятия ТС на склад Автохаб!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции
	
Функция ВыгрузитьПеремещение(ПеремещениеОбъект)
	Если ПеремещениеОбъект.ХозОперация = Справочники.ХозОперации.ПеремещениеАвтомобилей Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтохаб.НайтиПоКоду("ПеремещениеСоколМоторс");
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПодразделениеОтправитель = ПеремещениеОбъект.ПодразделениеКомпании;
	ПодразделениеРодитель = ПодразделениеОтправитель.Родитель;
	Если ПодразделениеРодитель = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
		НомерКабинетаОтправителя = ПодразделениеОтправитель.НомерКабинетаАвтохаб;
	Иначе
		НомерКабинетаОтправителя = ПодразделениеРодитель.НомерКабинетаАвтохаб;
	КонецЕсли;
	
	ПодразделениеПолучатель = ПеремещениеОбъект.СкладПолучатель.Подразделение;
	ПодразделениеРодитель = ПодразделениеПолучатель.Родитель;
	Если ПодразделениеРодитель = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
		НомерКабинетаПолучателя = ПодразделениеПолучатель.НомерКабинетаАвтохаб;
	Иначе
		НомерКабинетаПолучателя = ПодразделениеРодитель.НомерКабинетаАвтохаб;
	КонецЕсли;
	Если НомерКабинетаПолучателя = 0 Тогда
		Возврат Истина;
	ИначеЕсли НомерКабинетаПолучателя = НомерКабинетаОтправителя Тогда
		Возврат Истина;
	КонецЕсли;
	
	НеБылоОшибок = Истина;
	Для Каждого СтрокаАвто Из ПеремещениеОбъект.Автомобили Цикл
		ВидАвтомобиля = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения
		(СтрокаАвто.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля);
		Если обЗначениеНеЗаполнено(ВидАвтомобиля) Тогда
			Продолжить;
		КонецЕсли;
		Если Не (ВидАвтомобиля = Перечисления.ВидАвтомобиля.АвтомобильСПробегом 
			Или ВидАвтомобиля = Перечисления.ВидАвтомобиля.ТестовыйАвтомобиль
			Или ВидАвтомобиля = Перечисления.ВидАвтомобиля.ПодменныйАвтомобиль) Тогда
			Продолжить;
		КонецЕсли;
		
		мзОбъявление = РегистрыСведений.ОбъявленияНаАвтохаб.СоздатьМенеджерЗаписи();
		мзОбъявление.Автомобиль = СтрокаАвто.Автомобиль;
		мзОбъявление.Прочитать();
		Если Не мзОбъявление.Выбран() Тогда
			Продолжить;
			
		ИначеЕсли обЗначениеНеЗаполнено(мзОбъявление.vehicle_id) Тогда
			Продолжить;
			
		ИначеЕсли мзОбъявление.Перемещение = ПеремещениеОбъект.Ссылка Тогда
			Продолжить;
			
		ИначеЕсли мзОбъявление.Перемещение.Дата > ПеремещениеОбъект.Дата Тогда
			Продолжить;
		КонецЕсли;
		
		АдресРесурса = "/partners-api/vehicles/" + Формат(мзОбъявление.vehicle_id, "ЧГ=0,0") + "/close";
		ТелоЗапроса = ДанныеПеремещения(СтрокаАвто, НомерКабинетаПолучателя);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			стРезультат = ВыгрузитьОбъект(УзелОбмена, АдресРесурса, ТелоЗапроса, Строка(ПеремещениеОбъект));
			Если стРезультат = Неопределено Тогда
				НеБылоОшибок = Ложь;
				Продолжить;
				
			ИначеЕсли стРезультат.status = "success" Тогда
				vehicle_id = стРезультат.data.copiedToVehicle.id;
				Если ЗначениеЗаполнено(vehicle_id) И мзОбъявление.vehicle_id <> vehicle_id Тогда
					мзОбъявление.Перемещение = ПеремещениеОбъект.Ссылка;
					мзОбъявление.vehicle_id = vehicle_id;
					мзОбъявление.Записать();
				КонецЕсли;
			Иначе
				НеБылоОшибок = Ложь;
			КонецЕсли;
			
		Иначе
			НеБылоОшибок = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НеБылоОшибок;
КонецФункции

Процедура СменаКабинетаДилера(УзелОбмена)
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
