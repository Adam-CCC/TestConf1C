Функция ВыгрузитьВАвтохаб(ДокументОбъект) Экспорт
	Если Не ЭтоРабочаяБаза() Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоступлениеАвтомобилей") Тогда
		Возврат ВыгрузитьПоступление(ДокументОбъект);
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЗаказНаряд") Тогда
		Возврат ВыгрузитьЗатратыПрП(ДокументОбъект);
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПеремещениеАвтомобилей") Тогда
		Возврат ВыгрузитьПеремещение(ДокументОбъект);
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РеализацияАвтомобилей") Тогда
		Возврат ВыгрузитьРеализацию(ДокументОбъект);
		
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

Функция ПолучитьРРЦ(VIN) Экспорт
	УзелОбмена = ПланыОбмена.ОбменСАвтохаб.НайтиПоКоду("РеализацияСоколМоторс");
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);	
	ЗапросHTTP.АдресРесурса = "/partners-api/vehicles/active";
	
	стОтвет = Новый Структура("status, message, price");
	стЗапрос = Новый Структура();
	стЗапрос.Вставить("limit", 10);
	
	мФильтры = Новый Массив();
	стФильтр = Новый Структура();
	стФильтр.Вставить("fields", "vin");
	стФильтр.Вставить("type", "equal");
	мЗначения = Новый Массив();
	мЗначения.Добавить(VIN);
	стФильтр.Вставить("value", мЗначения);
	мФильтры.Добавить(стФильтр);
	стЗапрос.Вставить("filters", мФильтры);
	
	мЗначенияПорядок = Новый Массив();
	мЗначенияПорядок.Добавить("-id");
	стЗапрос.Вставить("orders", мЗначенияПорядок);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапрос);
	Исключение
		стОтвет.status = "error";
		стОтвет.message = "Не удалось создать json для запроса РРЦ на Автохаб!";
		Возврат стОтвет;
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);
	
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	
	Попытка
		стОтветСервера = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		стОтвет.status = "error";
		стОтвет.message = "Загрузка РРЦ с Автохаб для VIN = " + VIN + ": ОШИБКА чтения json!";
		Возврат стОтвет;
	КонецПопытки;

	Если ТипЗнч(стОтветСервера) <> Тип("Структура") Или Не стОтветСервера.Свойство("status") Тогда
		стОтвет.status = "error";
		стОтвет.message = "Загрузка РРЦ с Автохаб для VIN = " + VIN + ": неверная структура json в теле ответа сервера!";
		Возврат стОтвет;
	КонецЕсли;
	
	Если стОтветСервера.status = "error" Тогда
		стОтвет.status = "error";
		стОтвет.message = "Загрузка РРЦ с Автохаб для VIN = " + VIN + ", ответ сервера: " + стОтветСервера.message;
		Возврат стОтвет;
	КонецЕсли;
	
	Если Не стОтветСервера.Свойство("data") Или Не стОтветСервера.data.Свойство("vehicles") Тогда
		стОтвет.status = "error";
		стОтвет.message = "Загрузка РРЦ с Автохаб для VIN = " + VIN + ": данные отсутствуют в теле ответа сервера!";
		Возврат стОтвет;
	КонецЕсли;
	
	мДанныеАвто = стОтветСервера.data.vehicles;
	Если ТипЗнч(мДанныеАвто) <> Тип("Массив") Или мДанныеАвто.Количество() = 0 Тогда
		стОтвет.status = "error";
		стОтвет.message = "Загрузка РРЦ с Автохаб для VIN = " + VIN + ": автомобиль отсутствует на складе.";
		Возврат стОтвет;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(мДанныеАвто[0].price) Тогда
		стОтвет.status = "error";
		стОтвет.message = "Загрузка РРЦ с Автохаб для VIN = " + VIN + ": цена продажи не указана!";
	Иначе
		стОтвет.status = "success";
		стОтвет.price = мДанныеАвто[0].price;
	КонецЕсли;
	
	Возврат стОтвет;
КонецФункции

