Процедура РегистрацияЗаказНаряда(ЗаказНаряд)	
	ЗаказНарядЗакрыт = ЗаказНаряд.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт;
	Модель = ЗаказНаряд.Автомобиль.Модель;
	
	Марка = Модель.Марка;
	ЭтоУАЗ = Марка = Справочники.Марка.UAZ; 
	ЭтоФорд = Марка = Справочники.Марка.FORD;
	ЭтоGeely = Марка = Справочники.Марка.GEELY Или Марка = Справочники.Марка.BELGEE;
	ЭтоФиат = Марка = Справочники.Марка.FIAT;
	ЭтоДжип = Марка = Справочники.Марка.JEEP;
	ЭтоExeed = Марка = Справочники.Марка.EXEED;
	
	ЭтоКорандоГамма = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000174"); // Корандо Шахты ООО Гамма
	ЭтоРентаКарАвтолига = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000121"); // Рента Кар ООО Автолига
	ЭтоГаммаМоторсШахты = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001292"); // Гамма Моторс ООО Шахты Джили
	ЭтоГаммаМоторсРостов = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001300"); // Гамма Моторс ООО Шолохова Джили
	ЭтоАтлантГамма = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000032"); // Атлант Моторс ООО Гамма
	ЭтоАтлантПойменная = ЗаказНаряд.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000235"); // Атлант Моторс ООО Пойменная
	
	Если ЭтоФорд И ЭтоРентаКарАвтолига Тогда
		Если Модель.Код = "ЦБ00005706" Тогда // FORD ГЕРМЕС
			Возврат;
		КонецЕсли;
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("РентаКарФордППО");
		
	ИначеЕсли ЭтоФиат И ЭтоАтлантГамма Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантФиатППО");
		
	ИначеЕсли ЭтоДжип И ЭтоАтлантГамма Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("АтлантДжипППО");
		
	ИначеЕсли ЭтоExeed И ЭтоАтлантПойменная Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ПойменнаяЭксидППО");
		
	ИначеЕсли ЭтоУАЗ И ЭтоКорандоГамма Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("КорандоУАЗППО");
		
	ИначеЕсли ЗаказНарядЗакрыт И ЭтоGeely И ЭтоГаммаМоторсШахты Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаШахтыДжилиППО");
		
	ИначеЕсли ЗаказНарядЗакрыт И ЭтоGeely И ЭтоГаммаМоторсРостов Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтодилер.НайтиПоКоду("ГаммаРостовДжилиППО");
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда	
		Возврат;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(ЗаказНаряд.Диспетчер) Тогда
		#Если Клиент Тогда
		Сообщить("В заказ-наряде не указан мастер-приёмщик. Выгрузка на портал Автодилер невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	мзИдентификаторыDSF = РегистрыСведений.УАЗDSFИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDSF.ОбъектАльфаАвто = Модель;
	мзИдентификаторыDSF.Прочитать();
	Если Не мзИдентификаторыDSF.Выбран() Тогда
		#Если Клиент Тогда
		Сообщить("С порталом Автодилер не синхронизирована модель " + Модель
		+ ". Выгрузка заказ-наряда на портал Автодилер невозможна!!!", СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	ВидРемонта = ЗаказНаряд.ВидРемонта;
	Если ВидРемонта.Код = "00000142" Тогда // Приобретение авто с пробегом
		Возврат;
	КонецЕсли;
	
	мзИдентификаторыDNM = РегистрыСведений.УАЗDNMИдентификаторы.СоздатьМенеджерЗаписи();
	мзИдентификаторыDNM.ВидРемонта = ВидРемонта;
	мзИдентификаторыDNM.Прочитать();
	Если Не мзИдентификаторыDNM.Выбран() Тогда		
		#Если Клиент Тогда
		Сообщить("Заказ-наряды с видом ремонта "
		+ ВидРемонта + " на портал Автодилер не выгружаются.", СтатусСообщения.Информация);
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(УзелОбмена, ЗаказНаряд);		
КонецПроцедуры


//// Общие процедуры / функции для выгрузки данных на портал Автохаб
/////////////////////////////////////////////////////////////////////

Функция ТелефонЦифрами(Объект)
	НаборЗаписейКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписейКИ.Отбор.Объект.Значение = Объект;
	НаборЗаписейКИ.Отбор.Объект.Использование = Истина;
	НаборЗаписейКИ.Отбор.Тип.Значение = Перечисления.ТипыКонтактнойИнформации.Телефон;
	НаборЗаписейКИ.Отбор.Тип.Использование = Истина;
	НаборЗаписейКИ.Прочитать();
	Представление = "";
	СтруктураТелефон = Новый Структура();
	СтруктураТелефон.Вставить("Представление", Представление);
	СтруктураТелефон.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	
	Для каждого Запись Из НаборЗаписейКИ Цикл
		Если ПустаяСтрока(Запись.Поле1) Тогда
			Представление = Запись.Поле2 + Запись.Поле3;
		Иначе
			Представление = Запись.Поле1 + Запись.Поле2 + Запись.Поле3;
			Представление = Сред(Представление, 2);
		КонецЕсли;
		Если обЗначениеНеЗаполнено(Представление) Тогда
			Представление = Запись.Представление;
		КонецЕсли;
		
		ТелефонТолькоЦифры = "";
		СимволовВПредставлении = СтрДлина(Представление);
		Если СимволовВПредставлении > 0 Тогда
			Для сч = 1 По СимволовВПредставлении Цикл
				СимволИзНомера = Сред(Представление, сч, 1);
				Если СтрНайти("1234567890", СимволИзНомера) > 0 Тогда
					ТелефонТолькоЦифры = ТелефонТолькоЦифры + СимволИзНомера;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
			
		СтруктураТелефон.Вставить("Представление", ТелефонТолькоЦифры);
		СтруктураТелефон.Вставить("Вид", Запись.Вид);
		
		Если Запись.ЗначениеПоУмолчанию Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтруктураТелефон;
КонецФункции

Функция ЭлПочтаКорректна(ЭлПочта)
	Если Не ЗначениеЗаполнено(ЭлПочта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(ЭлПочта, " ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДлинаАдреса = СтрДлина(ЭлПочта);
	Если ДлинаАдреса < 6 Тогда
		Возврат Ложь;
	КонецЕсли;	
	ЭлПочтаНР = НРег(ЭлПочта);
	Для сч = 1 По ДлинаАдреса Цикл
		СимволИзАдреса = Сред(ЭлПочтаНР, сч, 1);
		Если СтрНайти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", СимволИзАдреса) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Позиция1 = Найти(ЭлПочта, "@");
	Если Позиция1 < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Позиция2 = Найти(Сред(ЭлПочта, Позиция1), ".");
	Возврат Позиция2 > 2;
КонецФункции

Функция ПолучитьСоединениеHTTP(УзелОбмена)
	Таймаут = 120;
	SSL = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаWindows(), Новый СертификатыУдостоверяющихЦентровWindows());
	Возврат Новый HTTPСоединение(УзелОбмена.Хост, , , , , Таймаут, SSL);
КонецФункции

Функция ПолучитьЗапросHTTP(УзелОбмена)
	ЗаголовкиHTTP = Новый Соответствие;
	ЗаголовкиHTTP.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаголовкиHTTP.Вставить("Accept", "application/json");
	ЗаголовкиHTTP.Вставить("Connection", "Keep-Alive");
	ЗаголовкиHTTP.Вставить("Authorization", "Basic " + УзелОбмена.Токен);
	
	ЗапросHTTP = Новый HTTPЗапрос();
	ЗапросHTTP.Заголовки = ЗаголовкиHTTP;
	Возврат ЗапросHTTP;
КонецФункции

Функция ПолучитьИдентификатор(Объект)
	Если ТипЗнч(Объект) = Тип("Массив") Тогда
		Если Объект.Количество() > 0 Тогда
			стОбъект = Объект[0];		
		Иначе
			Возврат 0;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("Структура") Тогда
		стОбъект = Объект;
		
	Иначе
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(стОбъект) = Тип("Структура") И стОбъект.Свойство("id") Тогда
		Возврат стОбъект.id;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ОбновитьОбъект(УзелОбмена, АдресРесурса, ТелоЗапроса)	
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	
	ЗапросHTTP.АдресРесурса = АдресРесурса;
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	НТТРОтвет = НТТР.Записать(ЗапросHTTP);
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.Системная);
	
	Если НТТРОтвет.КодСостояния >= 300 Тогда
		#Если Клиент Тогда
		Сообщить("Обновление объекта Автохаб " + АдресРесурса + ":" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + json_decode(ТелоОтвета), СтатусСообщения.Важное);
		#КонецЕсли
	КонецЕсли;
	
	Возврат НТТРОтвет.КодСостояния;	
КонецФункции

Функция ВыгрузитьОбъект(УзелОбмена, АдресРесурса, ТелоЗапроса, СтрокаОбъект)
	НТТР = ПолучитьСоединениеHTTP(УзелОбмена);
	ЗапросHTTP = ПолучитьЗапросHTTP(УзелОбмена);
	
	ЗапросHTTP.АдресРесурса = АдресРесурса;
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);		
	НТТРОтвет = НТТР.ОтправитьДляОбработки(ЗапросHTTP);
	
	ТелоОтвета = НТТРОтвет.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Попытка
		стОтвет = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		#Если Клиент Тогда
		Сообщить("Выгрузка в Автохаб объекта " + СтрокаОбъект + ":" + Символы.ПС 
		+ "Ошибка чтения json!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(стОтвет) <> Тип("Структура") Или Не стОтвет.Свойство("status") Тогда
		#Если Клиент Тогда
		Сообщить("Выгрузка в Автохаб объекта " + СтрокаОбъект + ":" + Символы.ПС 
		+ "Неверный тип json в теле ответа!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Неопределено;
	КонецЕсли;
	
	Если стОтвет.status = "error" Тогда
		#Если Клиент Тогда	
		Сообщить("ОШИБКА при выгрузке в Автохаб объекта " + СтрокаОбъект + ":" + Символы.ПС 
		+ "Код состояния: " + НТТРОтвет.КодСостояния  + Символы.ПС 
		+ "Тело ответа: " + json_decode(ТелоОтвета), СтатусСообщения.Важное);
		#КонецЕсли
	КонецЕсли;
	
	Возврат стОтвет;
КонецФункции

Функция ВИерархии(Элемент, Группа)
	Если ТипЗнч(Группа) <> ТипЗнч(Элемент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Группа = Элемент Или Элемент.ПринадлежитЭлементу(Группа);
КонецФункции

Функция СтоимостьПредпродажнойПодготовки(мзОбъявление)
	Если обЗначениеНеЗаполнено(мзОбъявление.Поступление) Тогда
		Возврат 0;
	КонецЕсли;
	
	ЗапросСтоимостьПП = Новый Запрос();
	ЗапросСтоимостьПП.УстановитьПараметр("Автомобиль", мзОбъявление.Автомобиль);
	ЗапросСтоимостьПП.УстановитьПараметр("Закрыт", Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	ЗапросСтоимостьПП.УстановитьПараметр("ДатаПоступления", мзОбъявление.Поступление.Дата);
	мРемонтыПрП = Новый Массив();
	мРемонтыПрП.Добавить(Справочники.ВидыРемонта.РемонтБуАвтомобиля);
	мРемонтыПрП.Добавить(Справочники.ВидыРемонта.ПредпродажнаяПодготовка);
	ЗапросСтоимостьПП.УстановитьПараметр("РемонтыПрП", мРемонтыПрП);
	ЗапросСтоимостьПП.Текст =
	"ВЫБРАТЬ
	|	СУММА(ЗаказНаряд.СуммаДокумента) КАК СтоимостьПрП
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Автомобиль = &Автомобиль
	|	И ЗаказНаряд.Состояние = &Закрыт
	|	И ЗаказНаряд.ДатаЗакрытия > &ДатаПоступления
	|	И ЗаказНаряд.ВидРемонта В(&РемонтыПрП)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказНаряд.Автомобиль";
	
	РезультатЗапроса = ЗапросСтоимостьПП.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	Иначе
		ВыборкаСтоимостьПП = РезультатЗапроса.Выбрать();
		Если ВыборкаСтоимостьПП.Следующий() Тогда
			Возврат ВыборкаСтоимостьПП.СтоимостьПрП;
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция json_decode(unicode_escape_sequence)
	ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(unicode_escape_sequence);
    стДанные = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();

    ЗаписьJSON = Новый ЗаписьJSON;
    //ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, стДанные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ЭтоРабочаяБаза()
	СтрокаСоединения = НРег(СтрокаСоединенияИнформационнойБазы());
	Возврат Найти(СтрокаСоединения, "1cserver") > 0 И Найти(СтрокаСоединения, "alfaauto") > 0;
КонецФункции

//// Процедуры / функции для выгрузки данных по поступлению автомобиля:
//// принятие ТС на склад и вывод в продажу
///////////////////////////////////////////////////////////////////////

Функция ДанныеПоступления(СтрокаАвтомобиль)
	стЗапись = Новый Структура();
	стЗапись.Вставить("appraisalPurchaseCost", СтрокаАвтомобиль.СуммаВсего);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стЗапись);
	Исключение
		Сообщить("Не удалось записать JSON-данные для принятия ТС на склад Автохаб!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции
	
Функция ВыгрузитьПоступление(ПоступлениеОбъект)
	Если ПоступлениеОбъект.Контрагент.НашаФирма Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ПоступлениеОбъект.ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилей
		Или ПоступлениеОбъект.ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилейКомиссия Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтохаб.НайтиПоКоду("ПубликацияСоколМоторс");
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	НеБылоОшибок = Истина;
	Для Каждого СтрокаАвто Из ПоступлениеОбъект.Автомобили Цикл
		Если Не СтрокаАвто.АвтомобильБУ Тогда
			Продолжить;
		КонецЕсли;
		
		мзОбъявление = РегистрыСведений.ОбъявленияНаАвтохаб.СоздатьМенеджерЗаписи();
		мзОбъявление.Автомобиль = СтрокаАвто.Автомобиль;
		мзОбъявление.Прочитать();
		Если Не мзОбъявление.Выбран() Тогда
			Продолжить;
		ИначеЕсли обЗначениеНеЗаполнено(мзОбъявление.appraisal_id) Тогда
			Продолжить;
		ИначеЕсли мзОбъявление.Поступление = ПоступлениеОбъект.Ссылка Тогда
			Продолжить;
		ИначеЕсли мзОбъявление.Поступление.Дата > ПоступлениеОбъект.Дата Тогда
			Продолжить;
		ИначеЕсли мзОбъявление.Реализация.Дата > ПоступлениеОбъект.Дата Тогда
			Продолжить;
		КонецЕсли;
		
		Если мзОбъявление.ОсмотрПроведен Тогда
			АдресРесурса = "/partners-api/appraisals/" + Формат(мзОбъявление.appraisal_id, "ЧГ=0,0") + "/accept";
			ТелоЗапроса = ДанныеПоступления(СтрокаАвто);
			Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
				стРезультат = ВыгрузитьОбъект(УзелОбмена, АдресРесурса, ТелоЗапроса, Строка(ПоступлениеОбъект));
				Если стРезультат = Неопределено Тогда
					НеБылоОшибок = Ложь;
					Продолжить;
					
				ИначеЕсли стРезультат.status = "success" Тогда
					vehicle_id = стРезультат.data.vehicle.id;
					Если ЗначениеЗаполнено(vehicle_id) Тогда
						мзОбъявление.Поступление = ПоступлениеОбъект.Ссылка;
						мзОбъявление.vehicle_id = vehicle_id;
						мзОбъявление.Записать();
					КонецЕсли;
					
				ИначеЕсли стРезультат.status = "error" Тогда
					НеБылоОшибок = Ложь;
					Сообщить("Не удалось перевести автомобиль на склад в Автохаб: " + стРезультат.message, СтатусСообщения.Внимание);
				
				Иначе
					НеБылоОшибок = Ложь;
				КонецЕсли;
				
			Иначе
				НеБылоОшибок = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НеБылоОшибок;
КонецФункции

Процедура ПринятиеТСНаСклад(УзелОбмена)
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    ПоступлениеОбъект = ВыборкаИзменений.Получить();
		car_id = ВыгрузитьПоступление(ПоступлениеОбъект);
		Если car_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ПоступлениеОбъект);
			Продолжить;
		ИначеЕсли car_id = 0 Тогда
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

//// Процедуры / функции для выгрузки данных по предпродажной подготовку (ПрП) автомобиля:
//// затраты на предпродажную подготовку автомобиля
///////////////////////////////////////////////////////////////////////

Функция ДанныеПоПрП(мзОбъявление)
	ЗатратыНаППП = СтоимостьПредпродажнойПодготовки(мзОбъявление);
	стЗапись = Новый Структура();
	стЗапись.Вставить("preSalePreparationCost", ЗатратыНаППП);
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("vehicle", стЗапись);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
		Сообщить("Не удалось записать JSON-данные для принятия ТС на склад Автохаб!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции
	
Функция ВыгрузитьЗатратыПрП(ЗаказНарядОбъект)
	Если ЗаказНарядОбъект.ВидРемонта = Справочники.ВидыРемонта.РемонтБуАвтомобиля
		Или ЗаказНарядОбъект.ВидРемонта = Справочники.ВидыРемонта.ПредпродажнаяПодготовка Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтохаб.НайтиПоКоду("ЗатратыПрПСоколМоторс");
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	НеБылоОшибок = Истина;
	мзОбъявление = РегистрыСведений.ОбъявленияНаАвтохаб.СоздатьМенеджерЗаписи();
	мзОбъявление.Автомобиль = ЗаказНарядОбъект.Автомобиль;
	мзОбъявление.Прочитать();
	Если Не мзОбъявление.Выбран() Тогда
		Возврат Истина;
	ИначеЕсли обЗначениеНеЗаполнено(мзОбъявление.vehicle_id) Тогда
		Возврат Истина;
	КонецЕсли;
	
	АдресРесурса = "/partners-api/vehicles/" + Формат(мзОбъявление.vehicle_id, "ЧГ=0,0");
	ТелоЗапроса = ДанныеПоПрП(мзОбъявление);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		КодСостояния = ОбновитьОбъект(УзелОбмена, АдресРесурса, ТелоЗапроса);
		Если КодСостояния >= 300 Тогда
			НеБылоОшибок = Ложь;
		КонецЕсли;
		
	Иначе
		НеБылоОшибок = Ложь;
	КонецЕсли;
	
	Возврат НеБылоОшибок;
КонецФункции

