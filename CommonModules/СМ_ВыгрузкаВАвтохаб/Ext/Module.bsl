Процедура ЗагрузитьОбъявленияКлассифайдов(Параметры = Неопределено) Экспорт
	УзелОбмена = ПланыОбмена.ОбменСАвтохаб.НайтиПоКоду("ПубликацияСоколМоторс");
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда
		Сообщить("Не удалось найти Узел обмена <ПубликацияСоколМоторс>!", СтатусСообщения.Внимание);
		Возврат;
	Иначе
		АдресРесурса = "/partners-api/buyout/actual-market";
	КонецЕсли;
	
	стТелоЗапроса = Новый Структура();
	стТелоЗапроса.Вставить("limit", 100);
	Смещение = 0;
	стТелоЗапроса.Вставить("offset", Смещение);
	стТелоЗапроса.Вставить("orders", "+saleStartedAt");

	стФильтры = Новый Структура();
	ДатаНачала = ТекущаяДата() - 3600;
	//ДатаНачала = ТекущаяДата() - 43200; //// УБРАТЬ !!!!!
	стФильтры.Вставить("minSaleStartedAt", Формат(ДатаНачала, "ДФ=""гггг-ММ-ддTЧЧ:мм:сс"""));
	
	стГеоФильтр = Новый Структура();
	стГеоФильтр.Вставить("geoType", "region");
	мЗначения = Новый Массив();
	мЗначения.Добавить(62);
	стГеоФильтр.Вставить("regions", мЗначения);
	стФильтры.Вставить("geoFilter", стГеоФильтр);
	
	мЗначения = Новый Массив();
	мЗначения.Добавить("avito");
	стФильтры.Вставить("publishedOnSites", мЗначения);
	
	стФильтры.Вставить("sellerType", "PRIVATE");
	стФильтры.Вставить("ownerCountTo", 7);
	стФильтры.Вставить("rubPriceTo", 3200000);
	стФильтры.Вставить("rubPriceFrom", 500000);
	стФильтры.Вставить("steeringWheel", "left");
	стФильтры.Вставить("isBroken", Ложь);
	стТелоЗапроса.Вставить("actualMarketFilter", стФильтры);
	
	КоличествоОбъявлений = ЗагрузитьОбъявления(УзелОбмена, АдресРесурса, стТелоЗапроса);
	Если КоличествоОбъявлений < 100 Тогда
		Возврат;
	КонецЕсли;
	
	НомерЗапроса = 1;
	Пока КоличествоОбъявлений = 100 Цикл
		НомерЗапроса = НомерЗапроса + 1;
		Смещение = Смещение + 100;
		стТелоЗапроса.offset = Смещение;
		КоличествоОбъявлений = ЗагрузитьОбъявления(УзелОбмена, АдресРесурса, стТелоЗапроса);
		//ЭлементыФормы.тСтатус.Заголовок = "Запрос " + НомерЗапроса + ", автомобилей: " + ТаблицаАвтомобилей.Количество();
	КонецЦикла;
КонецПроцедуры

Функция ЗагрузитьОбъявления(УзелОбмена, АдресРесурса, стТелоЗапроса)
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТелоЗапроса);
	Исключение
		Сообщить("Не удалось записать JSON-данные для тела запроса на Автохаб!", СтатусСообщения.Внимание);
		Возврат 0;
	КонецПопытки;
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		стРезультат = ВыгрузитьОбъект(УзелОбмена, АдресРесурса, ТелоЗапроса, "Список объявлений классифайдов");
		Если стРезультат = Неопределено Тогда
			Сообщить("Некорректный ответ портала Автохаб!", СтатусСообщения.Внимание);
			Возврат 0;
			
		ИначеЕсли стРезультат.status = "success" Тогда
			мОбъявления = стРезультат.data.sales;
			Если ТипЗнч(мОбъявления) <> Тип("Массив") Или мОбъявления.Количество() = 0 Тогда
				Сообщить("На портале Автохаб нет подходящих объявлений!", СтатусСообщения.Внимание);
				Возврат 0;
			КонецЕсли;
	
		Иначе
			Возврат 0;
		КонецЕсли;
		
	Иначе
		Сообщить("Пустое тело запроса на Автохаб!", СтатусСообщения.Внимание);
		Возврат 0;
	КонецЕсли;
	
	ствТипПродавца = Новый Соответствие();
	ствТипПродавца.Вставить("PRIVATE", "Частник");
	ствТипПродавца.Вставить("COMMERCIAL", "Салон");
	ствТипПродавца.Вставить("RESELLER", "Перекуп");
	
	ствТипКузова = Новый Соответствие();
	ствТипКузова.Вставить("cabriolet", "Кабриолет");
	ствТипКузова.Вставить("coupe", "Купе");
	ствТипКузова.Вставить("hatchback", "Хэтчбек");
	ствТипКузова.Вставить("long", "Лимузин");
	ствТипКузова.Вставить("minivan", "Минивэн");
	ствТипКузова.Вставить("pickup", "Пикап");
	ствТипКузова.Вставить("roadster", "Родстер");
	ствТипКузова.Вставить("sedan", "Седан");
	ствТипКузова.Вставить("suv", "Внедорожник");
	ствТипКузова.Вставить("van", "Фургон");
	ствТипКузова.Вставить("universal", "Универсал");
	ствТипКузова.Вставить("minibus", "Микроавтобус");
	ствТипКузова.Вставить("cargo_van", "Промтоварный фургон");
	ствТипКузова.Вставить("isothermal", "Изотермический фургон");
	ствТипКузова.Вставить("compactvan", "Компактвэн");
	ствТипКузова.Вставить("fastback", "Фастбек");
	ствТипКузова.Вставить("liftback", "Лифтбек");
	ствТипКузова.Вставить("microvan", "Микровэн");
	ствТипКузова.Вставить("phaeton", "Фаэтон");
	ствТипКузова.Вставить("speedster", "Спидстер");
	ствТипКузова.Вставить("targa", "Тарга");
	
	ствТипТрансмиссии = Новый Соответствие();
	ствТипТрансмиссии.Вставить("automatic", "Автоматическая");
	ствТипТрансмиссии.Вставить("manual", "Ручная");
	ствТипТрансмиссии.Вставить("robotized", "Робот");
	ствТипТрансмиссии.Вставить("variator", "Вариатор");
	
	ствТипДВС = Новый Соответствие();
	ствТипДВС.Вставить("petrol", "Бензин");
	ствТипДВС.Вставить("diesel", "Дизель");
	ствТипДВС.Вставить("electric", "Электро");
	ствТипДВС.Вставить("hybrid", "Гибрид");
	ствТипДВС.Вставить("petrol_and_gas", "Бензин/Газ");
	
	Для Каждого стОбъявление Из мОбъявления Цикл
		//стАвито = Неопределено;
		//Если Не стОбъявление.Свойство("avito", стАвито) Или обЗначениеНеЗаполнено(стАвито)  Тогда
		//	Продолжить;
		//КонецЕсли;
		//Если стОбъявление.lastRubPrice > 3200000 Или стОбъявление.lastRubPrice < 500000 Тогда
		//	Продолжить;
		//КонецЕсли;
		//Если стОбъявление.ownerCount > 7 Тогда
		//	Продолжить;
		//КонецЕсли;
		
		мзНовоеОбъявление = РегистрыСведений.ОбъявленияКлассифайдов.СоздатьМенеджерЗаписи();
		мзНовоеОбъявление.IDОбъявления = стОбъявление.id;
		
		СтрокаДатаВремя = стОбъявление.saleStartedAt;
		СтрокаДатаВремя = Лев(СтрокаДатаВремя, 19);
		СтрокаДата = Лев(СтрокаДатаВремя, 10);
		СтрокаДата = СтрЗаменить(СтрокаДата, "-", "");
		СтрокаВремя = Прав(СтрокаДатаВремя, 8);
		СтрокаВремя = СтрЗаменить(СтрокаВремя, ":", "");
		СтрокаДатаВремя = СтрокаДата + СтрокаВремя;
		Попытка
			мзНовоеОбъявление.ДатаОбъявления = Дата(СтрокаДатаВремя);
		Исключение
			мзНовоеОбъявление.ДатаОбъявления = ТекущаяДата();
		КонецПопытки;
		
		мзНовоеОбъявление.Марка = стОбъявление.brand.name;
		мзНовоеОбъявление.Модель =  стОбъявление.model.name;
		мзНовоеОбъявление.ГодВыпуска = стОбъявление.year;
		мзНовоеОбъявление.Пробег = стОбъявление.kmDistance;
		мзНовоеОбъявление.Владельцев = стОбъявление.ownerCount;
		мзНовоеОбъявление.Руль = стОбъявление.steeringWheel;
		
		ТипПродавца = ствТипПродавца[стОбъявление.sellerType];
		Если ЗначениеЗаполнено(ТипПродавца) Тогда
			мзНовоеОбъявление.Продавец = ТипПродавца;
		Иначе
			мзНовоеОбъявление.Продавец = "Другое";
		КонецЕсли;
		
		ТипДВС = ствТипДВС[стОбъявление.engineType];
		Если ЗначениеЗаполнено(ТипДВС) Тогда
			мзНовоеОбъявление.ТипДВС = ТипДВС;
		Иначе
			мзНовоеОбъявление.ТипДВС = "Другое";
		КонецЕсли;
		
		ТипКузова = ствТипКузова[стОбъявление.bodyType];
		Если ЗначениеЗаполнено(ТипКузова) Тогда
			мзНовоеОбъявление.ТипКузова = ТипКузова;
		Иначе
			мзНовоеОбъявление.ТипКузова = "Грузовик";
		КонецЕсли;
		
		ТипТрансмиссии = ствТипТрансмиссии[стОбъявление.gearboxType];
		Если ЗначениеЗаполнено(ТипТрансмиссии) Тогда
			мзНовоеОбъявление.ТипТрансмиссии = ТипТрансмиссии;
		Иначе
			мзНовоеОбъявление.ТипТрансмиссии = "Другое";
		КонецЕсли;
		
		мзНовоеОбъявление.ОбъемДВС = стОбъявление.engineVolume;
		мзНовоеОбъявление.Мощность =  стОбъявление.enginePower;
		мзНовоеОбъявление.ТипПривода = стОбъявление.driveType;
	
		Если стОбъявление.autotekaFeedStatus = 1 Тогда
			мзНовоеОбъявление.СтатусАвтотека = "Зеленый";
		ИначеЕсли стОбъявление.autotekaFeedStatus = 2 Тогда
			мзНовоеОбъявление.СтатусАвтотека = "Желтый";
		ИначеЕсли стОбъявление.autotekaFeedStatus = 3 Тогда
			мзНовоеОбъявление.СтатусАвтотека = "Красный";
		КонецЕсли;
		
