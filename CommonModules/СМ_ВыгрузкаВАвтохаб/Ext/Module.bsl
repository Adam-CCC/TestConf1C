/////////////////////////////////////////////////////////////////////

Функция ДанныеРеализации(СтрокаАвтомобиль, ДатаСтрокой, СкидкаДополнительная)
	стТело = Новый Структура();
	стТело.Вставить("reason", "sold");
	стТело.Вставить("salePrice", СтрокаАвтомобиль.СуммаВсего + СкидкаДополнительная);
	стТело.Вставить("completionDate", ДатаСтрокой);
	
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(ЗаписьJSON, стТело);
	Исключение
		Сообщить("Не удалось записать JSON-данные для принятия ТС на склад Автохаб!", СтатусСообщения.Внимание);
		Возврат "";
	КонецПопытки;
	
	ТелоЗапроса = ЗаписьJSON.Закрыть();
	Возврат ТелоЗапроса;
КонецФункции
	
Функция ВыгрузитьРеализацию(РеализацияОбъект)
	Если РеализацияОбъект.Контрагент.НашаФирма Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если РеализацияОбъект.ХозОперация = Справочники.ХозОперации.РеализацияАвтомобилей Тогда
		УзелОбмена = ПланыОбмена.ОбменСАвтохаб.НайтиПоКоду("РеализацияСоколМоторс");
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(УзелОбмена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДатаСтрокой = Формат(РеализацияОбъект.Дата, "ДФ=""гггг-ММ-дд""");
	
	НеБылоОшибок = Истина;
	Для Каждого СтрокаАвто Из РеализацияОбъект.Автомобили Цикл
		ВидАвтомобиля = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения
		(СтрокаАвто.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля);
		Если обЗначениеНеЗаполнено(ВидАвтомобиля) Тогда
			Продолжить;
		КонецЕсли;
		Если Не (ВидАвтомобиля = Перечисления.ВидАвтомобиля.АвтомобильСПробегом 
			Или ВидАвтомобиля = Перечисления.ВидАвтомобиля.ТестовыйАвтомобиль
			Или ВидАвтомобиля = Перечисления.ВидАвтомобиля.ПодменныйАвтомобиль) Тогда
			Продолжить;
		КонецЕсли;
		
		мзОбъявление = РегистрыСведений.ОбъявленияНаАвтохаб.СоздатьМенеджерЗаписи();
		мзОбъявление.Автомобиль = СтрокаАвто.Автомобиль;
		мзОбъявление.Прочитать();
		Если Не мзОбъявление.Выбран() Тогда
			Продолжить;
			
		ИначеЕсли обЗначениеНеЗаполнено(мзОбъявление.vehicle_id) Тогда
			Продолжить;
			
		ИначеЕсли мзОбъявление.Реализация = РеализацияОбъект.Ссылка Тогда
			Продолжить;
			
		ИначеЕсли мзОбъявление.Реализация.Дата > РеализацияОбъект.Дата Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаказСсылка = РеализацияОбъект.ДокументОснование;
		Если ЗначениеЗаполнено(ЗаказСсылка) И ТипЗнч(ЗаказСсылка) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
			РабочийЛистСсылка = ЗаказСсылка.ДокументОснование;
			Если ЗначениеЗаполнено(РабочийЛистСсылка) И ТипЗнч(РабочийЛистСсылка) = Тип("ДокументСсылка.РабочийЛист") Тогда
				СкидкаДополнительная = РабочийЛистСсылка.СкидкаДополнительная;
			Иначе
				СкидкаДополнительная = 0;
			КонецЕсли;
			
		Иначе
			СкидкаДополнительная = 0;
		КонецЕсли;
		
		АдресРесурса = "/partners-api/vehicles/" + Формат(мзОбъявление.vehicle_id, "ЧГ=0,0") + "/close";
		ТелоЗапроса = ДанныеРеализации(СтрокаАвто, ДатаСтрокой, СкидкаДополнительная);
		Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
			стРезультат = ВыгрузитьОбъект(УзелОбмена, АдресРесурса, ТелоЗапроса, Строка(РеализацияОбъект));
			Если стРезультат = Неопределено Тогда
				НеБылоОшибок = Ложь;
				Продолжить;
				
			ИначеЕсли стРезультат.status = "success" Тогда
				мзОбъявление.Реализация = РеализацияОбъект.Ссылка;
				мзОбъявление.Записать();
			Иначе
				НеБылоОшибок = Ложь;
			КонецЕсли;
			
		Иначе
			НеБылоОшибок = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НеБылоОшибок;
КонецФункции

Процедура ПереводОбъявленияВАрхив(УзелОбмена)
  	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	ЗаписьСообщения.НачатьЗапись(Запись, УзелОбмена);
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	Пока ВыборкаИзменений.Следующий() Цикл
	    ПеремещениеОбъект = ВыборкаИзменений.Получить();
		car_id = ВыгрузитьПеремещение(ПеремещениеОбъект);
		Если car_id = -422 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, ПеремещениеОбъект);
			Продолжить;
		ИначеЕсли car_id = 0 Тогда
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	ЗаписьСообщения.ЗакончитьЗапись();
	СтрокаСообщения = Запись.Закрыть();		
КонецПроцедуры

