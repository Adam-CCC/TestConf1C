
Процедура обОтправитьЗапросВWA(MessageID, DealerID, MessageType, ActionType) Экспорт
	
	//Прокси = WSСсылки.MessageTest.СоздатьWSПрокси("http://wa.dms.webservice/", "Message", "MessageSoap");        	
	Прокси = WSСсылки.Message.СоздатьWSПрокси("http://wa.dms.webservice/", "Message", "MessageSoap");        	
	ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить("http://wa.dms.webservice/MessageReceiveRequest").Получить("MessageReceiveRequest");
	ТипWSПараметраMessageRecieve = Прокси.ФабрикаXDTO.Пакеты.Получить("http://wa.dms.webservice/MessageReceiveRequest").Получить("MessageReceive");
	ТипWSПараметраTH = Прокси.ФабрикаXDTO.Пакеты.Получить("http://wa.dms.webservice/MessageReceiveRequest").Получить("TransactionHeader");
    		
	TransactionHeader  = Прокси.ФабрикаXDTO.Создать(ТипWSПараметраTH);   
	TransactionHeader.DealerID = DealerID;
	Если ЗначениеЗаполнено(ПараметрыСеанса.Пользователь.Сотрудник) Тогда
		TransactionHeader.RequestPollingToken = ПараметрыСеанса.Пользователь.Сотрудник.Код;
	Иначе
		TransactionHeader.RequestPollingToken = "";
	КонецЕсли;
	TransactionHeader.TransactionDateTimeUTC = ТекущаяДата();
	TransactionHeader.TransactionDateTimeLocal = ТекущаяДата();
	
	MessageReceive	   = Прокси.ФабрикаXDTO.Создать(ТипWSПараметраMessageRecieve);   
	MessageReceive.MessageID = MessageID;
	MessageReceive.MessageType = MessageType;
	MessageReceive.ActionType = ActionType;

	WSПараметр	   = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);   
	WSПараметр.TransactionHeader = TransactionHeader;
	WSПараметр.MessageReceive = MessageReceive;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();     
	Прокси.ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, WSПараметр, , , , НазначениеТипаXML.Явное);
	СтрокаXML = ЗаписьXML.Закрыть();
	
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.УстановитьТекст(СтрокаXML);
	ТекстДок.УдалитьСтроку(1);
	ТекстДок.УдалитьСтроку(1);
	ТекстДок.УдалитьСтроку(ТекстДок.КоличествоСтрок());
	
    urlAddress = Прокси.ТочкаПодключения.Местоположение;
    hostName=обПолучитьИмяХоста(Прокси.ТочкаПодключения.Местоположение);
    xmlHttp = New COMОбъект("MSXML2.xmlHttp");
    xmlHttp.OPEN ("POST", urlAddress, 0);
    xmlHttp.setRequestHeader ("User-Agent", "1C+Enterprise/8.2");
    xmlHttp.setRequestHeader ("Host", hostName);
    xmlHttp.setRequestHeader ("SOAPAction", "http://wa.dms.webservice/MessageReceive");
    xmlHttp.setRequestHeader ("Content-type", "text/xml; charset=utf-8");
    xmlHttp.setRequestHeader ("Content-Length", "length");
    DOC = Новый COMОбъект("Msxml2.DOMDocument");
    
   	DOC.loadXML("<soap12:Envelope xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:soap12=""http://www.w3.org/2003/05/soap-envelope"">
   |<soap12:Body>
   |    <MessageReceiveRequest xmlns=""http://wa.dms.webservice/MessageReceiveRequest"">
   |      "+ТекстДок.ПолучитьТекст()+"
   |   </MessageReceiveRequest>
   |</soap12:Body>
   |</soap12:Envelope>");   

    попытка
    	xmlHttp.SEND(DOC);
    исключение
    	Сообщить("Ошибка при отправке "+ОписаниеОшибки());
    конецпопытки;          

    Если xmlHttp.statusText="OK" Тогда       
    	чтениеХМЛ = Новый ЧтениеXML;
		//СтрокаОтвет = СокрЛП(xmlHttp.responseText);
    	чтениеХМЛ.УстановитьСтроку(СокрЛП(xmlHttp.responseText));
    	//хдто = Фабрика.ПрочитатьXML(чтениеХМЛ); 
    КонецЕсли;		    

КонецПроцедуры

Функция обGetCustomer(ПространствоИмен, CustomerData, СправочникСсылка, Тип) Экспорт
	CustomerData.CustomerInfoType = Тип;
	CustomerData.DMSCustomerNo = СправочникСсылка.Код;
	CustomerData.FullName = СправочникСсылка.Наименование;
	CustomerData.CardNo = "";
	CustomerData.CustomerLegalType = ?(СправочникСсылка.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо, "1", "2");
	
	Если CustomerData.CustomerLegalType = "1" Тогда
		CustomerData.Email = киПолучитьПредставлениеКИ(СправочникСсылка, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
		CustomerData.FirstName = обПолучитьИмя(СправочникСсылка.Имя);
		CustomerData.MiddleName = обПолучитьОтчество(СправочникСсылка.Отчество);
		CustomerData.LastName = обПолучитьФамилия(СправочникСсылка.Фамилия);
		CustomerData.Gender = ?(СправочникСсылка.Пол = Перечисления.ПолФизическихЛиц.Мужской, "1", "2");
		CustomerData.Salutation = ?(СправочникСсылка.Пол = Перечисления.ПолФизическихЛиц.Мужской, "г-н", "г-жа");
	Иначе
		CustomerData.Email = киПолучитьПредставлениеКИ(СправочникСсылка, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
		CustomerData.FirstName = обПолучитьИмя(СправочникСсылка.Наименование);
		CustomerData.MiddleName = обПолучитьОтчество(СправочникСсылка.Наименование);
		CustomerData.LastName = обПолучитьФамилия(СправочникСсылка.Наименование);
		CustomerData.Gender = "1";
		CustomerData.Salutation = "г-н";
	КонецЕсли;
			
	CustomerAdressesType = ФабрикаXDTO.Тип(ПространствоИмен, "ArrayOfAddress");
	CustomerAdresses = ФабрикаXDTO.Создать(CustomerAdressesType);

	ЗапросАдрес = Новый Запрос();
	ЗапросАдрес.Текст = "ВЫБРАТЬ
	               |	КонтактнаяИнформация.Объект,
	               |	КонтактнаяИнформация.Вид,
	               |	КонтактнаяИнформация.Поле1,
	               |	КонтактнаяИнформация.Поле2,
	               |	КонтактнаяИнформация.Поле3,
	               |	КонтактнаяИнформация.Поле4,
	               |	КонтактнаяИнформация.Поле5,
	               |	КонтактнаяИнформация.Поле6,
	               |	КонтактнаяИнформация.Поле7,
	               |	КонтактнаяИнформация.Поле8,
	               |	КонтактнаяИнформация.Поле9,
	               |	КонтактнаяИнформация.Представление
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Тип = &Адрес
	               |	И КонтактнаяИнформация.Объект = &КонтрагентСсылка";
				   
	ЗапросАдрес.Параметры.Вставить("Адрес", Перечисления.ТипыКонтактнойИнформации.Адрес);
	ЗапросАдрес.Параметры.Вставить("КонтрагентСсылка", СправочникСсылка);
	Выб = ЗапросАдрес.Выполнить().Выбрать();
	НетЮрАдреса = Истина;
	Пока Выб.Следующий() Цикл                          			
		AddressType = ФабрикаXDTO.Тип(ПространствоИмен, "Address");
		AddressData = ФабрикаXDTO.Создать(AddressType);
		Если Выб.Вид = Справочники.ВидыКонтактнойИнформации.АдресЮридический Тогда
			AddressData.AddressType = "1"; // “1” – адрес по прописке	
			НетЮрАдреса = Ложь;
		ИначеЕсли Выб.Вид = Справочники.ВидыКонтактнойИнформации.АдресФактический Тогда
			AddressData.AddressType = "2"; // “2” – фактический адрес
		ИначеЕсли Выб.Вид = Справочники.ВидыКонтактнойИнформации.АдресПочтовый Тогда
			AddressData.AddressType = "3"; // “3” – почтовый адрес
		Иначе
			Продолжить;
		КонецЕсли;          				
		AddressData.FullAddress = Выб.Представление; 
        AddressData.ZipCode = Выб.Поле1;
        AddressData.Region = Выб.Поле2; 
        AddressData.District = Выб.Поле3; 
		AddressData.City = Выб.Поле4; 
		AddressData.Locality = Выб.Поле5; 
		AddressData.Street = Выб.Поле6; 
		AddressData.House = Выб.Поле7; 
        AddressData.Housing = Выб.Поле8; 
		AddressData.Flat = Выб.Поле9;  					            			
		CustomerAdresses.Address.Добавить(AddressData);
	КонецЦикла;
	
	Если CustomerAdresses.Address.Количество() > 0 И НетЮрАдреса Тогда
		AddressType = ФабрикаXDTO.Тип(ПространствоИмен, "Address");
		AddressData = ФабрикаXDTO.Создать(AddressType);
		AddressData.AddressType = "1"; // “1” – адрес по прописке	
		AddressData.FullAddress = CustomerAdresses.Address[0].FullAddress; 
        AddressData.ZipCode = CustomerAdresses.Address[0].ZipCode;
        AddressData.Region = CustomerAdresses.Address[0].Region; 
        AddressData.District = CustomerAdresses.Address[0].District; 
		AddressData.City = CustomerAdresses.Address[0].City; 
		AddressData.Locality = CustomerAdresses.Address[0].Locality; 
		AddressData.Street = CustomerAdresses.Address[0].Street; 
		AddressData.House = CustomerAdresses.Address[0].House; 
        AddressData.Housing = CustomerAdresses.Address[0].Housing; 
		AddressData.Flat = CustomerAdresses.Address[0].Flat;
		CustomerAdresses.Address.Добавить(AddressData);
	КонецЕсли;
	CustomerData.Addresses = CustomerAdresses;		
			
	CustomerContactsType = ФабрикаXDTO.Тип(ПространствоИмен, "ArrayOfContact");
	CustomerContacts = ФабрикаXDTO.Создать(CustomerContactsType);
	
	ЗапросТелефон = Новый Запрос();
	ЗапросТелефон.Параметры.Вставить("КонтрагентСсылка", СправочникСсылка);
	ЗапросТелефон.Параметры.Вставить("Телефон", Перечисления.ТипыКонтактнойИнформации.Телефон);
	ЗапросТелефон.Текст = "ВЫБРАТЬ
	               |	КонтактнаяИнформация.Объект,
	               |	КонтактнаяИнформация.Вид,
	               |	КонтактнаяИнформация.Представление
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Тип = &Телефон
	               |	И КонтактнаяИнформация.Объект = &КонтрагентСсылка";
				   
	Выб = ЗапросТелефон.Выполнить().Выбрать();
	НетМобильногоТелефона = Истина;
	Пока Выб.Следующий() Цикл                          			
		ContactType = ФабрикаXDTO.Тип(ПространствоИмен, "Contact");
		ContactData = ФабрикаXDTO.Создать(ContactType);
		
		Если Выб.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонДомашний Тогда
			ContactData.ContactType = "1"; // “1” – домашний телефон	
		ИначеЕсли Выб.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый И НетМобильногоТелефона Тогда
			ContactData.ContactType = "2"; // “2” – мобильный телефон
			НетМобильногоТелефона = Ложь;
		ИначеЕсли Выб.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный И НетМобильногоТелефона Тогда
			ContactData.ContactType = "2"; // “2” – мобильный телефон
			НетМобильногоТелефона = Ложь;
		ИначеЕсли Выб.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий Тогда
			ContactData.ContactType = "3"; // “3” – рабочий телефон
		Иначе
			Продолжить;
		КонецЕсли;

		ContactData.ContactValue = ПредставлениеТелефонаДляWA(СправочникСсылка, Выб.Вид);
								
		СогласенДо = СправочникСсылка._г_ДатаОкончанияСогласия;
		ContactData.ContactMethodYN = ?(СправочникСсылка.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да И СогласенДо>ТекущаяДата(),"Y","N");
		CustomerContacts.Contact.Добавить(ContactData);
	КонецЦикла;
    CustomerData.Contacts = CustomerContacts;		
			
	SpecialMessageType = ФабрикаXDTO.Тип(ПространствоИмен, "SpecialMessage");
	SpecialMessage = ФабрикаXDTO.Создать(SpecialMessageType);
    SpecialMessage.Message = СправочникСсылка.Комментарий;
    CustomerData.SpecialMessage = SpecialMessage;
	
	CorporateInfosType = ФабрикаXDTO.Тип(ПространствоИмен, "ArrayOfCorporateInfo");
	CorporateInfos = ФабрикаXDTO.Создать(CorporateInfosType);
	
	ЗапросКонтактныеЛица = Новый Запрос; // NEW PHASE 4
	ЗапросКонтактныеЛица.УстановитьПараметр("Ведущий", СправочникСсылка); 
	ЗапросКонтактныеЛица.Текст = "ВЫБРАТЬ
	                             |	Контрагенты.Ссылка КАК Контрагент,
	                             |	Контрагенты.Код,
	                             |	Контрагенты.Наименование
	                             |ИЗ
	                             |	Справочник.Контрагенты КАК Контрагенты
	                             |ГДЕ
	                             |	Контрагенты.ВедушийКонтрагент = &Ведущий
	                             |	И Контрагенты.ПометкаУдаления = ЛОЖЬ
	                             |
	                             |СГРУППИРОВАТЬ ПО
	                             |	Контрагенты.Ссылка"; 
	
	ЗапросПодтвДокументы = Новый Запрос; // NEW PHASE 4
	ЗапросПодтвДокументы.УстановитьПараметр("Доверенность", Перечисления.ВидыДокументов.Доверенность); 
	ЗапросПодтвДокументы.Текст = "ВЫБРАТЬ
	                             |	ПодтверждающиеДокументы.Номер КАК НомерДоверенности,
	                             |	ПодтверждающиеДокументы.ДатаВыдачи КАК ДатаВыдачи
	                             |ИЗ
	                             |	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	                             |ГДЕ
	                             |	ПодтверждающиеДокументы.Владелец = &КонтактноеЛицо
	                             |	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = &Доверенность
	                             |	И ПодтверждающиеДокументы.Устаревший = ЛОЖЬ
	                             |
	                             |УПОРЯДОЧИТЬ ПО
	                             |	ДатаВыдачи УБЫВ"; 
	
	КонтактныеЛицаКонтрагента = ЗапросКонтактныеЛица.Выполнить().Выбрать(); 
	Пока КонтактныеЛицаКонтрагента.Следующий() Цикл
		CorporateInfoType = ФабрикаXDTO.Тип(ПространствоИмен, "CorporateInfo");
		CorporateInfo = ФабрикаXDTO.Создать(CorporateInfoType);
		
		CorporateInfo.CorporateInfoName = "ContactPersonID";
		CorporateInfo.CorporateInfoValue = КонтактныеЛицаКонтрагента.Код;
		CorporateInfos.CorporateInfo.Добавить(CorporateInfo);
		
		CorporateInfo = ФабрикаXDTO.Создать(CorporateInfoType); 
		CorporateInfo.CorporateInfoName = "ContactPerson";
		CorporateInfo.CorporateInfoValue = КонтактныеЛицаКонтрагента.Наименование;
		CorporateInfos.CorporateInfo.Добавить(CorporateInfo);
		
		ЗапросТелефон.Параметры.Вставить("КонтрагентСсылка", КонтактныеЛицаКонтрагента.Контрагент);
		Выб = ЗапросТелефон.Выполнить().Выбрать();
		Пока Выб.Следующий() Цикл                          							
			CorporateInfo = ФабрикаXDTO.Создать(CorporateInfoType); 
			CorporateInfo.CorporateInfoName = "ContactNumber";			
			CorporateInfo.CorporateInfoValue = ПредставлениеТелефонаДляWA(КонтактныеЛицаКонтрагента.Контрагент, Выб.Вид);
			CorporateInfos.CorporateInfo.Добавить(CorporateInfo);
			Если Выб.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;						
		
		ЗапросПодтвДокументы.Параметры.Вставить("КонтактноеЛицо", КонтактныеЛицаКонтрагента.Контрагент);
		Выб = ЗапросПодтвДокументы.Выполнить().Выбрать(); // NEW PHASE 4
		Если Выб.Следующий() Тогда
			CorporateInfo = ФабрикаXDTO.Создать(CorporateInfoType); 
			CorporateInfo.CorporateInfoName = "PowerOfAttorney";  
			CorporateInfo.CorporateInfoValue = Выб.НомерДоверенности;
			CorporateInfos.CorporateInfo.Добавить(CorporateInfo);

			CorporateInfo = ФабрикаXDTO.Создать(CorporateInfoType); 
			CorporateInfo.CorporateInfoName = "DatePowerOfAttorney";  
			CorporateInfo.CorporateInfoValue = Выб.ДатаВыдачи; 
		Иначе
			CorporateInfo = ФабрикаXDTO.Создать(CorporateInfoType); 
			CorporateInfo.CorporateInfoName = "PowerOfAttorney";  
			CorporateInfo.CorporateInfoValue = "";
			CorporateInfos.CorporateInfo.Добавить(CorporateInfo);

			CorporateInfo = ФабрикаXDTO.Создать(CorporateInfoType); 
			CorporateInfo.CorporateInfoName = "DatePowerOfAttorney";  
			CorporateInfo.CorporateInfoValue = ""; 
		КонецЕсли;	
		CorporateInfos.CorporateInfo.Добавить(CorporateInfo);			
	КонецЦикла; 		
	CustomerData.CorporateInfos = CorporateInfos; 

    Возврат CustomerData;
КонецФункции

Функция обGetVehicle(ПространствоИмен, VehicleData, АвтомобильСсылка) Экспорт
	АвтомобильОбъект = АвтомобильСсылка.ПолучитьОбъект();

	VehicleData.DMSVehicleNo = АвтомобильСсылка.Код; 
	VehicleData.VIN = АвтомобильСсылка.VIN; 
	VehicleData.StockNumber = ""; 
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтомобильСсылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ТекущаяДата());
	Если обЗначениеНеЗаполнено(ГосНомер) Тогда
		VehicleData.LicensePlateNo = ""; 
	Иначе
		VehicleData.LicensePlateNo = ГосНомер; 	
	КонецЕсли;

	VehicleData.Make = ""; 
	VehicleData.ModelCode = АвтомобильСсылка.Модель.Код; 
	VehicleData.ModelName = АвтомобильСсылка.Модель.Наименование; 
	VehicleData.ModelYear = ?(обЗначениеНеЗаполнено(АвтомобильСсылка.ВариантКомплектации.ГодКомплектации),Формат(АвтомобильСсылка.ГодВыпуска,"ДФ=yyyy"),Формат(АвтомобильСсылка.ВариантКомплектации.ГодКомплектации,"ДФ=YYYY"));    
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтомобильСсылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
	Если обЗначениеНеЗаполнено(Пробег) Тогда
		VehicleData.LastMileage = ""; 
	Иначе
		VehicleData.LastMileage = кмсфпУбратьИзНомераТелефонаВсеБуквы(Строка(Пробег)); 	
	КонецЕсли;

	VehicleData.Color = АвтомобильСсылка.Цвет.ЦветПоГИБДД;
	КлассификацияWA = АвтомобильСсылка.Модель.НаименованиеWA;
	Если ЗначениеЗаполнено(КлассификацияWA) Тогда
		VehicleData.VehicleType = КлассификацияWA;
	Иначе
