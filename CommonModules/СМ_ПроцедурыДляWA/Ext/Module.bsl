Функция обПолучитьВозвратWAError(ПространствоИмен,Источник,ВозвращаемоеЗначение,Код,ТаблицаОшибок,КодОбъекта=Неопределено) Экспорт 
	ResultMessageDataType = ФабрикаXDTO.Тип(ПространствоИмен, "ResultMessage");
	ResultMessageData = ФабрикаXDTO.Создать(ResultMessageDataType); 	
	TransactionHeaderDataType = ФабрикаXDTO.Тип(ПространствоИмен, "TransactionHeader");
	TransactionHeaderData = ФабрикаXDTO.Создать(TransactionHeaderDataType);
	TransactionHeaderData = Источник.TransactionHeader;      
	ResultMessageData.Code = Код;
	Если Код = "-1" Тогда
		ResultMessageData.Message = "fail"; 
	ИначеЕсли Код = "0" Тогда
    	ResultMessageData.Message = "No data found"; 
	Иначе
    	ResultMessageData.Message = ?(КодОбъекта=Неопределено,"Success",КодОбъекта);	
	КонецЕсли;	
	Если Код = "-1" Тогда
		ArrayOfErrorDataType = ФабрикаXDTO.Тип(ПространствоИмен, "ArrayOfError");
		ArrayOfErrorData = ФабрикаXDTO.Создать(ArrayOfErrorDataType);
		Для Каждого Строка Из ТаблицаОшибок Цикл
			ErrorDataType = ФабрикаXDTO.Тип(ПространствоИмен, "Error");
			ErrorData = ФабрикаXDTO.Создать(ErrorDataType); 			
			ErrorData.Code = Строка.Код;
			ErrorData.Message = Строка.ТекстОшибки;     		
			ArrayOfErrorData.Error.Добавить(ErrorData);  
		КонецЦикла;
		ВозвращаемоеЗначение.Errors = ArrayOfErrorData; 
	КонецЕсли;
	ВозвращаемоеЗначение.ResultMessage = ResultMessageData;  	
	ВозвращаемоеЗначение.TransactionHeader = TransactionHeaderData;  
	Возврат ВозвращаемоеЗначение;
КонецФункции

