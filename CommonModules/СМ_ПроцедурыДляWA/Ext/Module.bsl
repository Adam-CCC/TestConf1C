Функция ПредставлениеТелефонаДляWA(ОбъектСсылка, ВидТелефона) Экспорт
	Представление = "";	
	НаборЗаписейКИ = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписейКИ.Отбор.Объект.Значение      = ОбъектСсылка;
	НаборЗаписейКИ.Отбор.Объект.Использование = Истина;
	НаборЗаписейКИ.Отбор.Вид.Значение      = ВидТелефона;
	НаборЗаписейКИ.Отбор.Вид.Использование = Истина;
	НаборЗаписейКИ.Прочитать();
	Если НаборЗаписейКИ.Количество() > 0  Тогда
		КодГорода = НаборЗаписейКИ[0].Поле2;
		Если СтрДлина(КодГорода) = 3 Тогда
			Телефон = НаборЗаписейКИ[0].Поле3;
			Если СтрДлина(Телефон) = 7 Тогда
				Представление = "+7 (" + КодГорода + ") " + Телефон;
			Иначе
				Возврат Представление;
			КонецЕсли;
		Иначе
			Возврат Представление;
		КонецЕсли;		
	КонецЕсли;	
	Возврат Представление;
КонецФункции

Функция ПолучитьСтруктуруФИО(Знач Контрагент) Экспорт 
	
	Контрагент  =  СтрЗаменить(Сокрлп(Контрагент) , " " , Символы.ПС); 
	СтруктураФио = Новый Структура; 
	СтруктураФио.Вставить("Фамилия" , СтрПолучитьСтроку(Контрагент , 1)); 
	СтруктураФио.Вставить("Имя" , СтрПолучитьСтроку(Контрагент , 2 ));
	
	Если СтрЧислоСтрок( Контрагент ) = 3 Тогда 
		СтруктураФио.Вставить("Отчество" , СтрПолучитьСтроку( Контрагент , 3 ) ); 
	Иначе
		СтруктураФио.Вставить("Отчество", "");	
	КонецЕсли;
	
	Возврат СтруктураФио; 

	
КонецФункции

Функция ПолучитьФИОСокр(Знач Контрагент) Экспорт 
	
	СтруктураФИО = ПолучитьСтруктуруФИО(Контрагент); 
	Возврат СтруктураФИО.Фамилия + " " + Лев( СтруктураФИО.Имя , 1 )  + "."  + ?(ЗначениеЗаполнено(СтруктураФИО.Отчество) , Лев(СтруктураФИО.Отчество , 1 ) + "." , ""  );
		
КонецФункции
 
Функция ПолучитьСтруктуруНастроекWA(ТипНастройки, Объект = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Текст = "ВЫБРАТЬ
	               |	WA_Настройки.Значение
	               |ИЗ
	               |	РегистрСведений.WA_Настройки КАК WA_Настройки
	               |ГДЕ
	               |	WA_Настройки.ТипНастройки = &ТипНастройки
				   |	И WA_Настройки.Объект = &Объект";
	Если НЕ Объект = Неопределено Тогда			   
		Запрос.УстановитьПараметр("Объект", Объект);
	Иначе
		Текст = СтрЗаменить(Текст,"И WA_Настройки.Объект = &Объект","");
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипНастройки",ТипНастройки);
	Запрос.Текст = Текст;
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Если ТипНастройки = Перечисления.WA_ТипыНастроек.WA_КаталогЗапчастей ИЛИ ТипНастройки = Перечисления.WA_ТипыНастроек.WA_СкладОстатков 
			ИЛИ ТипНастройки = Перечисления.WA_ТипыНастроек.WA_ПодразделениеСервиса ИЛИ ТипНастройки = Перечисления.WA_ТипыНастроек.WA_Дистрибьютор
			ИЛИ ТипНастройки = Перечисления.WA_ТипыНастроек.WA_ОрганизацияДилера ИЛИ ТипНастройки = Перечисления.WA_ТипыНастроек.WA_КаталогСлесарныхРабот Тогда
			Массив = Новый Массив;
			Пока Выборка.Следующий() Цикл
				Массив.Добавить(Выборка.Значение);
			КонецЦикла;
			Возврат Массив;
		Иначе
			Выборка.Следующий();
			Возврат Выборка.Значение;
		КонецЕсли;

	Иначе
			Если ТипЗнч(Объект) = Тип("СправочникСсылка.ВидыРемонта") Тогда Возврат "12"
			Иначе
			Возврат Неопределено;
			КонецЕсли;
	КонецЕсли;
		
КонецФункции