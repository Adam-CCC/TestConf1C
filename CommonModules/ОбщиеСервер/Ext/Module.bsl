Функция УбратьЗапрещенныеСимволыВИменифайла (Имя) Экспорт 
	Имя = СтрЗаменить(Имя,"*",""); 
	Имя = СтрЗаменить(Имя,"|",""); 
	Имя = СтрЗаменить(Имя,"\",""); 
	Имя = СтрЗаменить(Имя,":",""); 
	Имя = СтрЗаменить(Имя,"""",""); 
	Имя = СтрЗаменить(Имя,"<",""); 
	Имя = СтрЗаменить(Имя,">",""); 
	Имя = СтрЗаменить(Имя,"?",""); 
	Имя = СтрЗаменить(Имя,"/",""); 
	Имя = СтрЗаменить(Имя,".",""); 
	
	Возврат Имя;
КонецФункции	

Процедура УдалитьФайлИзХранилища(АдресВременногоХранилища) Экспорт
	Попытка  
		УдалитьФайлы(АдресВременногоХранилища);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;	
КонецПроцедуры

Процедура ВыполнитьКомандуНаСервере(ИмяКоманды,ОписаниеОшибки) Экспорт
	Попытка
		ЗапуститьПриложение(ИмяКоманды,,Истина);
	Исключение	
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;	
КонецПроцедуры

Функция ПолучитьРасширениеФайла(ИмяФайла) Экспорт
	
	ПозицияПоследнейТочки = 0;
	РасширениеФайла = ИмяФайла;
	
	Пока 1 = 1 Цикл
		
		ПозицияПоследнейТочки = Найти(РасширениеФайла, ".");
		
		Если ПозицияПоследнейТочки = 0 Тогда
			
			Прервать;
			
		Иначе
			
			РасширениеФайла = Сред(РасширениеФайла, ПозицияПоследнейТочки + 1)
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ?(РасширениеФайла = ИмяФайла, "", РасширениеФайла);
	
КонецФункции 

Функция ПолучитьОбрезанноеФото (Путь)  Экспорт 
	Расшир = ПолучитьРасширениеФайла(Путь);
	ИмяБезРасшир = СтрЗаменить(Путь,Расшир,"");
	
	Возврат ИмяБезРасшир + "_thumb"+Расшир;
	
	
КонецФункции	
