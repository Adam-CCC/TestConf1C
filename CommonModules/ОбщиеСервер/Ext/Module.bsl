Функция ПолучитьИмяИБ() Экспорт
	ИмяИБ = "";
	СтрокаСоединения = СокрЛП(Врег(СтрокаСоединенияИнформационнойБазы()));
	Если Найти(СтрокаСоединения,"REF") > 0  Тогда
		ПодстрокиСтрокиСоединения  = обРазложитьСтрокуВМассивПодстрок(СтрокаСоединения,";");
		Попытка
			ИмяИБ = СокрЛП(ВРЕГ(ПодстрокиСтрокиСоединения[1]));
		Исключение
			//
		КонецПопытки;	
		ИмяИБ = СтрЗаменить(ИмяИБ,"REF=","");
		ИмяИБ = СтрЗаменить(ИмяИБ,"""","");
	Иначе	
		ПодстрокиСтрокиСоединения  = обРазложитьСтрокуВМассивПодстрок(СтрокаСоединения,"\");
		МаксЗначениеИндекса = ПодстрокиСтрокиСоединения.Количество()-1;
		Попытка
			ИмяИБ = СокрЛП(ВРЕГ(ПодстрокиСтрокиСоединения[МаксЗначениеИндекса]));
		Исключение
			//
		КонецПопытки;	
	КонецЕсли; 
	ИмяИБ = СтрЗаменить(ИмяИБ,"""","");
	
	Возврат ИмяИБ;
	
КонецФункции // ПолучитьИмяИБ()

Функция СкопироватьНаСервер(Категория,МояКартинка,Расширение,ОписаниеОшибки) Экспорт 
	
	ДвоичныеДанные = МояКартинка.Получить();
	// ТекНомер = 0;
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	//|	НомерФайловВХранилищеСрезПоследних.Номер КАК Номер
	//|ИЗ
	//|	РегистрСведений.НомерФайловВХранилище.СрезПоследних(&ДатаТек, ) КАК НомерФайловВХранилищеСрезПоследних
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	Номер УБЫВ";
	//Запрос.УстановитьПараметр("ДатаТек",ТекущаяДата());			   
	//Результат = Запрос.Выполнить().Выбрать();
	//
	//Если Результат.Следующий() тогда
	//	ТекНомер = Результат.Номер + 1;
	//Иначе
	//	ТекНомер = 1;
	//КонецЕсли;
	
	ТекНомер = Строка(Новый УникальныйИдентификатор());
	
	Хранилише = Константы.ПустьКХранилищюСканов.Получить();
	ПутьПром = Категория;
	ИмяПапки = Формат(ТекущаяДата(),"ДФ=yyyy-MM");
	ИмяТекИБ = ПолучитьИмяИБ();
	ПолныйПуть = Хранилише+"\"+ИмяТекИБ+"\"+ПутьПром+"\"+ИмяПапки;
	КаталогНаДиске = Новый Файл(ПолныйПуть);
	Если  НЕ КаталогНаДиске.Существует() Тогда
		СоздатьКаталог(КаталогНаДиске.ПолноеИмя);
	КонецЕсли;	
	
	ИмяфайлаДляКопирования=Константы.ПрефиксБазы.Получить()+ТекНомер+Расширение;
	ИмяФайла = КаталогНаДиске.ПолноеИмя+"\"+ИмяфайлаДляКопирования;
	Если ПустаяСтрока(ИмяФайла) Тогда Возврат Неопределено; КонецЕсли;
	Попытка
		ДвоичныеДанные.Записать(ИмяФайла);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
	
	Если Найти(",.BMP,.DIB,.RLE,.JPG,.JPEG,.TIF,.GIF,.PNG,.ICO,.WMF,.EMF,", "," + Врег(Расширение) + ",") > 0 Тогда
		
		ПолныйПутьКпрограмме = "C:\Program Files\ImageMagick\convert.exe";		
		ИмяФайлаПрограммыНаДиске = Новый Файл(ПолныйПутьКпрограмме);
		
		Если   ИмяФайлаПрограммыНаДиске.Существует() Тогда
			
			ИмяФайлаМиниатюры = КаталогНаДиске.ПолноеИмя+"\"+Константы.ПрефиксБазы.Получить()+ТекНомер+"_thumb"+Расширение;
			
			ИмяФайлаUTF = КаталогВременныхФайлов()+"tmpfile"+СокрЛП(СтрЗаменить(ТекущаяУниверсальнаяДатаВМиллисекундах(),Символы.НПП,""))+".jpg"; 
			КопироватьФайл(ИмяФайла,ИмяФайлаUTF);
			
			ИмяКоманды = """C:\Program Files\ImageMagick\convert.exe"""+" """+ИмяФайлаUTF+""" -thumbnail 250x200 "+ИмяФайлаМиниатюры;
			
			Попытка
				ОбщиеСервер.ВыполнитьКомандуНаСервере(ИмяКоманды,ОписаниеОшибки);
				УдалитьФайлы(ИмяФайлаUTF);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;	
			
		Иначе			
			ОписаниеОшибки = "ОШИБКА! Файл '"+ПолныйПутьКпрограмме+"' не существует.";			
		КонецЕсли; 
		
	КонецЕсли; 
	
	// Попытка
	//	МенеджерЗаписи = РегистрыСведений.НомерФайловВХранилище.СоздатьМенеджерЗаписи(); 
	//	МенеджерЗаписи.Период   = ТекущаяДата(); 
	//	МенеджерЗаписи.НомерИ = ТекНомер; 
	//	МенеджерЗаписи.Номер = ТекНомер; 
	//	МенеджерЗаписи.Записать(); 
	//Исключение
	//КонецПопытки;
	
	Возврат   ИмяФайла;
КонецФункции //СкопироватьНаСервер()	

Функция НайтиКорень(Элем) Экспорт 
	Если НЕ ЗначениеЗаполнено(Элем.Родитель) Тогда
		Возврат Элем;
	Иначе
		Возврат НайтиКорень(Элем.Родитель);
	КонецЕсли;
КонецФункции
 
