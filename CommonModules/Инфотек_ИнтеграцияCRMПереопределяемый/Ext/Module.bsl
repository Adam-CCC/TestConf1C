// Функция получения синонима из перечисления  
//                           
// Параметры:
//  Значение - Строка - Значение перечисления.
//
// Возвращаемое значение:
//  Синоним перечисления 
//  
Функция ИмяЗначенияПеречисления(Значение) Экспорт
      
      ОбъектМетаданных = Значение.Метаданные();
      
      ИндексЗначения = Перечисления[ОбъектМетаданных.Имя].Индекс(Значение);
      
      Возврат ОбъектМетаданных.ЗначенияПеречисления[ИндексЗначения].Синоним;
      
КонецФункции

// Функция получения бренда (марки) автомобиля, который был сопоставлен с CRM или DNM системой  
//                           
// Параметры:
//  Модель - СправочникСсылка.Модели - Модель автомобиля, для которой необходимо получить бренд.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Бренд - Значение марки или каталога справочника модели (зависит от настроек, сделанных пользователем при задании параметров подключения
//  и сопоставлении справочной информации).  
//  
Функция ПолучитьБренд(Модель,НастройкаПодключения) Экспорт
	
	Бренд = Неопределено;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инфотек_СоответствиеОбъектов.Объект
	|ИЗ
	|	РегистрСведений.Инфотек_СоответствиеОбъектов КАК Инфотек_СоответствиеОбъектов
	|ГДЕ
	|	Инфотек_СоответствиеОбъектов.ВидОбъекта = &ВидОбъекта
	|	И Инфотек_СоответствиеОбъектов.НастройкаПодключения = &НастройкаПодключения";
	Запрос.УстановитьПараметр("ВидОбъекта",ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Бренд);	
	Запрос.УстановитьПараметр("НастройкаПодключения",НастройкаПодключения);	
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() цикл
		Если ЗначениеЗаполнено(Модель) И Модель.ПолучитьОбъект() <> Неопределено Тогда 
			Если Модель.ПринадлежитЭлементу(Результат.Объект) Тогда
				Бренд = Результат.Объект;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Бренд;
	
КонецФункции

// Функция получения контактной информации объекта  
//                           
// Параметры:
//  ОбъектКлиент - СправочникСсылка - Объект для получения контактной информации.
//  ТипКИ        - ПеречисленияСсылка.ТипыКонтактнойИнформации - тип контактной информации.
//  ВидКИ        - СправочникСсылка.ВидыКонтактнойИнформации - вид контактной информации.
//
// Возвращаемое значение:
//  Результат - Строка представления контактной информации  
//  
Функция ПолучитьКИ(ОбъектКлиент,ТипКИ,ВидКИ="") Экспорт
	
	Запрос = новый Запрос();
	Запрос.УстановитьПараметр("парКлиент",ОбъектКлиент);
	Запрос.УстановитьПараметр("парТипКИ",ТипКИ);
	Запрос.УстановитьПараметр("парВидКИ",ВидКИ);	
	Запрос.Текст = "Выбрать *
	|из РегистрСведений.КонтактнаяИнформация как КИ
	|Где Объект = &парКлиент
	|  и Тип    = &парТипКИ
	|  "+?(ЗначениеЗаполнено(ВидКИ),"и Вид = &парВидКИ","")+"
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Возврат Результат;
	
КонецФункции

// Функция получения паспортных данных контрагента  
//                           
// Параметры:
//  ОбъектКлиент - СправочникСсылка.Контрагенты - Объект для получения паспортных данных.
//
// Возвращаемое значение:
//  Выборка - Паспортные данные контрагента  
//  
Функция ПолучитьПаспортныеДанные(ОбъектКлиент) Экспорт
	
	Запрос = новый Запрос();
	Запрос.УстановитьПараметр("парКлиент",ОбъектКлиент);
	Запрос.Текст = "Выбрать *
	|Из справочник.ПодтверждающиеДокументы
	|Где Владелец=&парКлиент
	|  и не ПометкаУдаления
	|  и ВидПодтверждающегоДокумента = Значение(Перечисление.ВидыДокументов.Паспорт)";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Функция получениядополнительных характеристик автомобиля  
//                           
// Параметры:
//  ОбъектАвто  - СправочникСсылка.Автомобиль - Объект для получения характеристик.
//  ВидЗначения - ПеречислениеСсылка.ДополнительнаяИнформацияАвтомобилей - Вид необходимой характеристики.
//
// Возвращаемое значение:
//  Выборка - значения характеристик автомобиля  
//  
Функция ПолучитьИнфоПоАвто(ОбъектАвто,ВидЗначения,Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос();
	Если ЗначениеЗаполнено(Дата) Тогда	
		Запрос.УстановитьПараметр("парДата",Дата);
	Иначе
		Запрос.УстановитьПараметр("парДата",ТекущаяДата());
	КонецЕсли;
	Запрос.УстановитьПараметр("парВидЗначения",ВидЗначения);
	Запрос.УстановитьПараметр("парАвто",ОбъектАвто);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АвтомобилиСрезПоследних.Период,
	|	АвтомобилиСрезПоследних.Автомобиль,
	|	АвтомобилиСрезПоследних.ВидЗначения,
	|	АвтомобилиСрезПоследних.Значение
	|ИЗ
	|	РегистрСведений.Автомобили.СрезПоследних(
	|			&парДата,
	|			ВидЗначения = &парВидЗначения
	|				И Автомобиль = &парАвто) КАК АвтомобилиСрезПоследних";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Функция получения контактных лиц контрагента  
//                           
// Параметры:
//  ОбъектКлиент - СправочникСсылка.Контрагенты - Объект для получения контактных лиц.
//
// Возвращаемое значение:
//  Выборка - Контактные лица контрагента  
//  
Функция ПолучитьКЛ(ОбъектКлиент) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("парКлиент",ОбъектКлиент);		
	Запрос.Текст =  
	"ВЫБРАТЬ
	|	КЛ.Ведомый КАК КонтактноеЛицо,
	|	КЛ.Ведомый.Наименование КАК Наименование,
	|	КИ.Представление КАК ТелефонКЛ
	|ИЗ
	|	РегистрСведений.КонтактныеЛицаКонтрагентов КАК КЛ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КИ
	|		ПО (КИ.Объект = КЛ.Ведомый)
	|			И (КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|ГДЕ
	|	КЛ.Ведущий = &парКлиент";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

// Функция убирает лишние символы из строки, оставляет только цифры 
//                           
// Параметры:
//  СтрокаТелефон - Строка - для преобразования данных.
//
// Возвращаемое значение:
//  ТелефонЧислами - Преобразованная строка.  
//  
Функция ПолучитьТелефонЦифрами(СтрокаТелефон) Экспорт
	
	ТелефонЧислами = "";
	
	ДлинаТелефона = СтрДлина(СтрокаТелефон);
	Для НомерСимвола = 1 По ДлинаТелефона Цикл
		ТекСимвол = Сред(СтрокаТелефон,НомерСимвола,1);
		Если Найти("0123456789",ТекСимвол) > 0 Тогда
			ТелефонЧислами = ТелефонЧислами + ТекСимвол;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТелефонЧислами;
	
КонецФункции

// Функция поиска контрагента в 1С по номеру телефона 
//                           
// Параметры:
//  НомерТелефона - Строка - для поиска.
//
// Возвращаемое значение:
//  Контрагент - Ссылка на элемент справочника контрагенты.  
//  
Функция НайтиПоНомеруТелефона(НомерТелефона) Экспорт
	
	ТелефонДляПоиска = НомерТелефона;
	ТелефонДляПоиска = ПолучитьТелефонЦифрами(ТелефонДляПоиска);
	Если Лев(ТелефонДляПоиска,1) = "7" или Лев(ТелефонДляПоиска,1)="8" Тогда
		ТелефонДляПоиска = Сред(ТелефонДляПоиска,2);
	КонецЕсли;
	Контрагент    = Справочники.Контрагенты.ПустаяСсылка();	
	
	Запрос = новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КИ.Объект КАК Объект,
	|	КИ.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КИ.Объект ССЫЛКА Справочник.Контрагенты
	|	И ВЫБОР
	|			КОГДА КИ.Поле1 <> """"
	|					И КИ.Поле2 <> """"
	|					И КИ.Поле3 <> """"
	|				ТОГДА """" + КИ.Поле1 + КИ.Поле2 + КИ.Поле3 ПОДОБНО &Телефон
	|			ИНАЧЕ КИ.Представление ПОДОБНО &Телефон
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("Телефон", "%" + ТелефонДляПоиска + "%");

	Результат = запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Контрагент = Результат.Объект;
		прервать;
	КонецЦикла;
	
	Возврат Контрагент;		
	
КонецФункции

// Функция поиска контрагента в 1С по номеру телефона И ФИО 
//                           
// Параметры:
//  НомерТелефона - Строка - для поиска. 
//  Наименование - Строка - для поиска по ФИО.
//
// Возвращаемое значение:
//  Контрагент - Ссылка на элемент справочника контрагенты.  
//  
Функция НайтиПоНомеруТелефонаФИО(НомерТелефона,Наименование) Экспорт
	
	ТелефонДляПоиска = НомерТелефона;
	ТелефонДляПоиска = ПолучитьТелефонЦифрами(ТелефонДляПоиска);
	Если Лев(ТелефонДляПоиска,1) = "7" или Лев(ТелефонДляПоиска,1)="8" Тогда
		ТелефонДляПоиска = Сред(ТелефонДляПоиска,2);
	КонецЕсли;
	Контрагент    = Справочники.Контрагенты.ПустаяСсылка();	
	
	Запрос = новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КИ.Объект КАК Объект,
	|	КИ.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КИ.Объект ССЫЛКА Справочник.Контрагенты
	|	И ВЫБОР
	|			КОГДА КИ.Поле1 <> """"
	|					И КИ.Поле2 <> """"
	|					И КИ.Поле3 <> """"
	|				ТОГДА """" + КИ.Поле1 + КИ.Поле2 + КИ.Поле3 ПОДОБНО &Телефон
	|			ИНАЧЕ КИ.Представление ПОДОБНО &Телефон
	|		КОНЕЦ
	|	И КИ.Объект.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Телефон", "%" + ТелефонДляПоиска + "%");
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Результат = запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Контрагент = Результат.Объект;
		прервать;
	КонецЦикла;
	
	Возврат Контрагент;		
	
КонецФункции

// Функция поиска контрагента в 1С по ФИО и дате рождения 
//                           
// Параметры:
//  ФИО          - Строка - для поиска по наименованию.
//  ДатаРождения - Строка - для поиска по дате рождения.
//
// Возвращаемое значение:
//  Контрагент - Ссылка на элемент справочника контрагенты.  
//  
Функция НайтиПоФИОДатеРождения(ФИО, ДатаРождения) Экспорт
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ДатаРождения = Инфотек_ОбщиеПроцедуры.ПреобразоватьСтрокуВДату(ДатаРождения);
	Если обЗначениеНеЗаполнено(ДатаРождения) Тогда
		Возврат Контрагент;
	КонецЕсли;
	
	Запрос = новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И Контрагенты.ДатаРождения = &ДатаРождения";
	Запрос.УстановитьПараметр("ДатаРождения", ДатаРождения);
	Запрос.УстановитьПараметр("Наименование", СокрЛП(ФИО));
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Контрагент = Результат.Ссылка;
		Прервать;
	КонецЦикла;
	
	Возврат Контрагент;	
КонецФункции

// Функция получения кода перечисления 
//                           
// Параметры:
//  Значение     - Строка - Значение перечисления.
//  Перечисление - Строка - Наименование перечисления.
//
// Возвращаемое значение:
//  Код элемента перечисления.  
// 
Функция ПолучитьКодПеречисления(Значение, Перечисление)
	
	// так как у перечисления нет кода. то придумаем его сами
	ЕСли Перечисление = "СостояниеЗаказНаряда" Тогда
		Если Значение = Перечисления[Перечисление].Закрыт Тогда
			ВозВрат 1;
		иначеЕсли Значение = Перечисления[Перечисление].Заявка Тогда
			ВозВрат 2;
		иначеЕсли Значение = Перечисления[Перечисление].ВРаботе Тогда
			ВозВрат 3;
		иначеЕсли Значение = Перечисления[Перечисление].Согласование Тогда
			ВозВрат 4;
		иначеЕсли Значение = Перечисления[Перечисление].Выполнен Тогда
			ВозВрат 5;
		иначеЕсли Значение = Перечисления[Перечисление].Стоянка Тогда
			ВозВрат 6;
		иначеЕсли Значение = Перечисления[Перечисление].Ожидание Тогда
			ВозВрат 7;
		Иначе 
			ВозВрат 0;
		КонецЕсли;	
	Иначе 
		ВозВрат 0;
	КонецЕсли;
	
КонецФункции

// Функция поиска автомобиля по реквизитам из структуры обращения CRM 
//                           
// Параметры:
//  СтруктураАвто - Структура - Структура реквизитов автомобиля из CRM.
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключенияDNM - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  Автомобиль.  
// 
Функция НайтиАвтомобильПоСтруктуре(СтруктураАвто,НастройкаПодключения) Экспорт
	
	VIN = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.vin);
	ГосНомер = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.reg_number);    
	ИдМодели = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.model_id);   
	СтруктураМодель = СтруктураАвто.model;
    Автомобиль = Неопределено;   
	
	Если ЗначениеЗаполнено(VIN) ИЛИ ЗначениеЗаполнено(ГосНомер) Тогда
		ЗапросАвто = новый Запрос();
		ЗапросАвто.УстановитьПараметр("парДатаЗаписи",ТекущаяДата());
		ЗапросАвто.Текст = 
		"ВЫБРАТЬ
		|	Авто.Ссылка КАК Ссылка,
		|	Авто.VIN КАК VIN,
		|	РС.Значение КАК ГосНомер
		|ИЗ
		|	Справочник.Автомобили КАК Авто
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних(&парДатаЗаписи, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК РС
		|		ПО (РС.Автомобиль = Авто.Ссылка)
		|ГДЕ
		|	НЕ Авто.ПометкаУдаления
		|	И НЕ Авто.ЭтоГруппа
		|	И Авто.VIN ПОДОБНО ""%"" + &VIN + ""%""
		|	И РС.Значение ПОДОБНО ""%"" + &ГосНомер + ""%""";
		ЗапросАвто.УстановитьПараметр("VIN","%" + VIN + "%");
		ЗапросАвто.УстановитьПараметр("ГосНомер","%" + ГосНомер + "%");
		РезАвто = ЗапросАвто.Выполнить().Выбрать();
		Пока РезАвто.Следующий() Цикл
			Автомобиль = РезАвто.Ссылка;
			Прервать;
		КонецЦикла;		
	КонецЕсли;   
	
	Если Автомобиль = Неопределено Тогда
    	Автомобиль = Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураАвто.brand.name) + " " + Инфотек_ОбщиеПроцедуры.УбратьКавычки(СтруктураМодель.name) + " " + VIN + " " + ГосНомер;
    КонецЕсли; 

	Возврат Автомобиль;
	
КонецФункции

// Функция, получения ссылки на корень дерева документов
//
// Параметр:
//	ДокументКорень         - ДокументСсылка - Переданный документ
//	ТаблицаКонтроляПовтора - Переданный массив документов
//	ОписаниеТиповДок       -  Описание типов документов.
//
// Возвращаемое значение:
//	ДокументСсылка - Корень документа.
//
Функция НайтиПервыйДокументЦепочкиПодчиненности(ДокументКорень,ТаблицаКонтроляПовтора,ОписаниеТиповДокументов) Экспорт
	
	ЗначениеРеквизита = Неопределено;
	ВидДокумента = ДокументКорень.Метаданные().Имя;
	
	// Обход реквизитов в поисках подходящего корня
	Для Каждого Реквизит Из Метаданные.Документы[ВидДокумента].Реквизиты Цикл
		ЗначениеРеквизита = ДокументКорень[Реквизит.Имя];
		
		Если ПроверкаПодчиненияРеквизиту(ДокументКорень,ЗначениеРеквизита,ТаблицаКонтроляПовтора,ОписаниеТиповДокументов) Тогда
			ТаблицаКонтроляПовтора.Добавить(ЗначениеРеквизита);
			Возврат НайтиПервыйДокументЦепочкиПодчиненности(ЗначениеРеквизита,ТаблицаКонтроляПовтора,ОписаниеТиповДокументов);
		КонецЕсли;
		
	КонецЦикла;
	
	// Если в реквизитах ничего не было найдено, обходим реквизиты табличных частей
	// Перебираем все ТЧ.
	Для Каждого ТЧ Из Метаданные.Документы[ВидДокумента].ТабличныеЧасти Цикл
		
		// Перебираем все строки ТЧ
		Для ИндексСтроки = 0 По ДокументКорень[ТЧ.Имя].Количество()-1 Цикл
			
			// Перебираем все реквизиты строки
			Для Каждого РеквизитТЧ Из ТЧ.Реквизиты Цикл
				
				ИмяРеквизитТЧ = Метаданные.Документы[ВидДокумента].ТабличныеЧасти[ТЧ.Имя].Реквизиты[РеквизитТЧ.Имя];
				ЗначениеРеквизита = ДокументКорень[ТЧ.Имя][ИндексСтроки][ИмяРеквизитТЧ.Имя];
				
				Если ПроверкаПодчиненияРеквизиту(ДокументКорень,ЗначениеРеквизита,ТаблицаКонтроляПовтора,ОписаниеТиповДокументов) Тогда
					ТаблицаКонтроляПовтора.Добавить(ЗначениеРеквизита);
					Возврат НайтиПервыйДокументЦепочкиПодчиненности(ЗначениеРеквизита,ТаблицаКонтроляПовтора,ОписаниеТиповДокументов);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ДокументКорень;
	
КонецФункции

// Функция проверяет, может ли документ являться подчиненным реквизиту
//
// Параметр:
//	ДокументСсылка         - ДокументСсылка - Переданный документ
//	ЗнРеквизит             - Реквизит       - Переданный реквизит
//	ТаблицаКонтроляПовтора - Переданный массив документов.
//
// Возвращаемое значение:
//	Булево         - Результат проверки.
//
Функция ПроверкаПодчиненияРеквизиту(ДокументСсылка,Основание,ТаблицаКонтроляПовтора,ОписаниеТиповДокументов)
	
	Если (Основание <> Неопределено) И (ОписаниеТиповДокументов.СодержитТип(ТипЗнч(Основание))) Тогда
		
		Если (Основание<>Документы[Основание.Метаданные().Имя].ПустаяСсылка()) И (Основание<>ДокументСсылка) Тогда
			
			// проверка на дубль
			Если НЕ (ТаблицаКонтроляПовтора.Найти(Основание) = Неопределено) Тогда
				Возврат Ложь;
			КонецЕсли;
			
			// Проверка, что текущий документ может быть подчиненным для предполагаемого корня.
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПодчиненныеДокументы.Ссылка КАК Документ
			|ИЗ
			|	КритерийОтбора.ПодчиненныеДокументы(&Основание) КАК ПодчиненныеДокументы
			|ГДЕ
			|	ПодчиненныеДокументы.Ссылка = &ДокументСсылка";
			Запрос.УстановитьПараметр("Основание",Основание);
			Запрос.УстановитьПараметр("ДокументСсылка",ДокументСсылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Количество() > 0 Тогда
				Возврат Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции // ПолучитьКореньДокумента()

// Функция получения рабочих листов по документу отдела продаж  
//                           
// Параметры:
//  Документ - ДокументСсылка - Ссылка на документ в иерархии которого необходимо найти рабочий лист.
//
// Возвращаемое значение:
//  МассивРабочихЛистов - массив документов рабочий лист.  
//  
Функция ПолучитьРабочиеЛистыПоДокументу(Документ) Экспорт
	
	МассивРабочихЛистов = Новый Массив;
	
	ТаблицаКонтроляПовтора = Новый Массив;
	
	ОписаниеТиповДокументов = Документы.ТипВсеСсылки();
	ТаблицаКонтроляПовтора.Добавить(Документ);		
	// Найти корень дерева
	ДокументКорень = НайтиПервыйДокументЦепочкиПодчиненности(Документ, ТаблицаКонтроляПовтора, ОписаниеТиповДокументов);		
	
	ТаблицаСвязанныхДокументов = Новый ТаблицаЗначений;
	ТаблицаСвязанныхДокументов.Колонки.Добавить("Ссылка");
	НоваяСтрока = ТаблицаСвязанныхДокументов.Добавить();
	НоваяСтрока.Ссылка = ДокументКорень;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвязанныхДокументов Цикл
		МассивСвязанныхДокументов = КритерииОтбора.ПодчиненныеДокументы.Найти(СтрокаТаблицы.Ссылка);			
		Для Каждого ЭлементКоллекции Из МассивСвязанныхДокументов Цикл
			РезультатПоиска = ТаблицаСвязанныхДокументов.Найти(ЭлементКоллекции);
			Если РезультатПоиска = НеОпределено Тогда
				НоваяСтрока = ТаблицаСвязанныхДокументов.Добавить();
				НоваяСтрока.Ссылка = ЭлементКоллекции.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвязанныхДокументов Цикл
		Если ТипЗнч(СтрокаТаблицы.Ссылка) = Тип("ДокументСсылка.РабочийЛист") Тогда
			МассивРабочихЛистов.Добавить(СтрокаТаблицы.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
		Если МассивРабочихЛистов.Количество() = 0 Тогда
			МассивРабочихЛистов.Добавить(Документ.РабочийЛист);
		КонецЕсли;
	КонецЕсли;       
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РеализацияАвтомобилей") Тогда
		Если ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
			Если МассивРабочихЛистов.Количество() = 0 Тогда
				МассивРабочихЛистов.Добавить(Документ.ДокументОснование.РабочийЛист);
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	

	Возврат МассивРабочихЛистов
		
КонецФункции

// Функция получения рабочих листов выкупа по документу отдела продаж  
//                           
// Параметры:
//  Документ - ДокументСсылка - Ссылка на документ в иерархии которого необходимо найти рабочий лист.
//
// Возвращаемое значение:
//  МассивРабочихЛистов - массив документов рабочий лист.  
//  
Функция ПолучитьРабочиеЛистыВыкупаПоДокументу(Документ) Экспорт
	
	МассивРабочихЛистов = Новый Массив;
	
	ТаблицаКонтроляПовтора = Новый Массив;
	
	ОписаниеТиповДокументов = Документы.ТипВсеСсылки();
	ТаблицаКонтроляПовтора.Добавить(Документ);		
	// Найти корень дерева
	ДокументКорень = НайтиПервыйДокументЦепочкиПодчиненности(Документ, ТаблицаКонтроляПовтора, ОписаниеТиповДокументов);		
	
	ТаблицаСвязанныхДокументов = Новый ТаблицаЗначений;
	ТаблицаСвязанныхДокументов.Колонки.Добавить("Ссылка");
	НоваяСтрока = ТаблицаСвязанныхДокументов.Добавить();
	НоваяСтрока.Ссылка = ДокументКорень;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвязанныхДокументов Цикл
		МассивСвязанныхДокументов = КритерииОтбора.ПодчиненныеДокументы.Найти(СтрокаТаблицы.Ссылка);			
		Для Каждого ЭлементКоллекции Из МассивСвязанныхДокументов Цикл
			РезультатПоиска = ТаблицаСвязанныхДокументов.Найти(ЭлементКоллекции);
			Если РезультатПоиска = НеОпределено Тогда
				НоваяСтрока = ТаблицаСвязанныхДокументов.Добавить();
				НоваяСтрока.Ссылка = ЭлементКоллекции.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
		
	Для Каждого СтрокаТаблицы Из ТаблицаСвязанныхДокументов Цикл
		Если ТипЗнч(СтрокаТаблицы.Ссылка) = Тип("ДокументСсылка.аа_РабочийЛистТрейдИн") Тогда
			МассивРабочихЛистов.Добавить(СтрокаТаблицы.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат МассивРабочихЛистов
		
КонецФункции

