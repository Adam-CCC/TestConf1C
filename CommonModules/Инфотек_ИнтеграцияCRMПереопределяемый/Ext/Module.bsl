// Процедуры и функции сбора данных по складу автомобилей

// Функция формирования структуры реквизитов места хранения на складе для передачи в CRM  
//                           
// Параметры:
//  СтруктураСклада      - Структура - Структура места хранения в CRM
//  Документ             - ДокументСсылка - Ссылка на документ поступление/перемещение автомобилей.
//  ID_Автомобиля        - Строка - Идентификатор автомобиля на складе в CRM
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключения - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  СтруктураОбъекта - Структура реквизитов места хранения автомобиля.
// 
Функция ПолучитьОписаниеМестаХраненияСклада(СтруктураСклада,Документ,ID_Автомобиля,НастройкаПодключения) Экспорт
	
	СтруктураОбъекта = Новый Структура;
	
	СтруктураОбъекта.Вставить("Идентификатор",ID_Автомобиля);
	СтруктураОбъекта.Вставить("ИдентификаторСклада",СтруктураСклада.id);
	СтруктураОбъекта.Вставить("Дата",Формат(Документ.Дата,"ДФ=dd.MM.yyyy"));	
	
	Возврат СтруктураОбъекта;
	
КонецФункции

// Функция формирования структуры реквизитов статуса на складе для передачи в CRM  
//                           
// Параметры:
//  Документ             - ДокументСсылка - Ссылка на документ поступление/перемещение автомобилей.
//  ID_Автомобиля        - Строка - Идентификатор автомобиля на складе в CRM
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключения - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  СтруктураОбъекта - Структура реквизитов статуса автомобиля на складе.
// 
Функция ПолучитьОписаниеСтатусаАвтомобиляНаСкладе(Документ,ID_Автомобиля,НастройкаПодключения) Экспорт
	
	СтруктураОбъекта = Новый Структура;
	
	СтруктураОбъекта.Вставить("Идентификатор",ID_Автомобиля);
	Если Документ.ПометкаУдаления = Истина Тогда
		СтруктураОбъекта.Вставить("Статус",6);    
	Иначе
		СтруктураОбъекта.Вставить("Статус",1);    
	КонецЕсли;	
	СтруктураОбъекта.Вставить("Дата",Формат(Документ.Дата,"ДФ=dd.MM.yyyy"));	
	
	Возврат СтруктураОбъекта;
	
КонецФункции

// Функция формирования структуры реквизитов дополнительного оборудования автомобиля на складе для передачи в CRM  
//                           
// Параметры:
//  ДокЗаказНаряд        - ДокументСсылка.ЗаказНаряд - Ссылка на документ заказ наряд.
//  ID_Автомобиля        - Строка - Идентификатор автомобиля на складе в CRM
//  НастройкаПодключения - СправочникСсылка.Инфотек_НастройкиПодключения - Ссылка на настройку подключения для получения параметров авторизации.
//
// Возвращаемое значение:
//  СтруктураОбъекта - Структура реквизитов дополнительного оборудования автомобиля.
// 
Функция ПолучитьОписаниеДополнительногоОборудованияАвтомобиля(ДокЗаказНаряд,ID_Автомобиля,НастройкаПодключения) Экспорт
	
	СтруктураОбъекта = Новый Структура;
	
	СтруктураОбъекта.Вставить("ЗаказНаряд",ДокЗаказНаряд);
	СтруктураОбъекта.Вставить("Автомобиль",ДокЗаказНаряд.Автомобиль);
	СтруктураОбъекта.Вставить("Идентификатор",ID_Автомобиля);
	СтрокаДополнительныхРабот = "";
	Для Каждого СтрокаРабот ИЗ ДокЗаказНаряд.Работы Цикл
		СтрокаДополнительныхРабот = СтрокаДополнительныхРабот + СтрокаРабот.Работа.Наименование + "; "
	КонецЦикла;
	Если ЗначениеЗаполнено(СтрокаДополнительныхРабот) Тогда
		СтрокаДополнительныхРабот = "Автоработы: " + СтрокаДополнительныхРабот;
	КонецЕсли;
	СтрокаДополнительногоОборудования = "";
	Для Каждого СтрокаТовара ИЗ ДокЗаказНаряд.Товары Цикл
		СтрокаДополнительногоОборудования = СтрокаДополнительногоОборудования + СтрокаТовара.Номенклатура.Наименование + "; "
	КонецЦикла;
	Если ЗначениеЗаполнено(СтрокаДополнительногоОборудования) Тогда
		СтрокаДополнительногоОборудования = "Запчасти: " + СтрокаДополнительногоОборудования;
	КонецЕсли;
    СтрокаДопов = "Заказ наряд № " + ДокЗаказНаряд.Номер + "; " + СтрокаДополнительныхРабот + СтрокаДополнительногоОборудования;  
	СтруктураОбъекта.Вставить("СтрокаДополнительногоОборудования",СтрокаДопов);
	СтруктураОбъекта.Вставить("СуммаДополнительногоОборудования",ДокЗаказНаряд.СуммаДокумента);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Продажи.Себестоимость, 0) КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ДокЗаказНаряд);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Себестоимость = 0;
		Количество = 0;
		Пока Выборка.Следующий() Цикл
			Себестоимость = Себестоимость + Выборка.Себестоимость;
		КонецЦикла;
		СтруктураОбъекта.Вставить("СебестоимостьДополнительногоОборудования",Себестоимость);
	КонецЕсли;
	
	Возврат СтруктураОбъекта;
	
КонецФункции
