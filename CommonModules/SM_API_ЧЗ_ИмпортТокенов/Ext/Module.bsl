Процедура ВыполнитьИмпортТокенов(Параметры = Неопределено) Экспорт

	ПутьКФайлу = "\\1cserver\tokens\tokens.csv";

	ФайлИмпорта = Новый Файл(ПутьКФайлу);

	Если НЕ ФайлИмпорта.Существует() Тогда
		ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Файл не найден: " + ПутьКФайлу);
		Возврат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(ПутьКФайлу,КодировкаТекста.UTF8);
	Исключение
		ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось открыть файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	НомерСтроки = 0;
	КоличествоЗаписей = 0;
	КоличествоОшибок = 0;
	КоличествоПустыхСтрок = 0;
	КоличествоОрганизаций = 0;

	Пользователь = Справочники.Пользователи.НайтиПоНаименованию("Романов Дмитрий Юрьевич");

	Если Пользователь.Пустая() Тогда
		Чтение.Закрыть();
		ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Пользователь Романов Дмитрий Юрьевич не найден");
		Возврат;
	КонецЕсли;

	Пока Истина Цикл
		Попытка
			СтрокаФайла = Чтение.ПрочитатьСтроку();
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Ошибка чтения файла: " + ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;

		Если НомерСтроки = 1 Тогда
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(СтрокаФайла)) Тогда
			КоличествоПустыхСтрок = КоличествоПустыхСтрок + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			Поля = СтрРазделить(СтрокаФайла,";");

			Если Поля.Количество() <> 4 Тогда
				ВызватьИсключение "Ожидаются поля: Организация;ИНН;ДатаВремя;Токен. Получено полей: " + Строка(Поля.Количество());
			КонецЕсли;

			НаименованиеОрганизации = СокрЛП(СтрЗаменить(Поля[0],"""",""));
			ИНН = СокрЛП(СтрЗаменить(Поля[1],"""",""));
			СтрокаДаты = СокрЛП(СтрЗаменить(Поля[2],"""",""));
			Токен = СокрЛП(СтрЗаменить(Поля[3],"""",""));

			Если ПустаяСтрока(НаименованиеОрганизации)
				Или ПустаяСтрока(ИНН)
				Или ПустаяСтрока(СтрокаДаты)
				Или ПустаяСтрока(Токен) Тогда
				ВызватьИсключение "В строке есть незаполненные поля";
			КонецЕсли;

			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 2
				|	Организации.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Организации КАК Организации
				|ГДЕ
				|	Организации.ИНН ПОДОБНО &ИНН
				|	И НЕ Организации.ПометкаУдаления";

			Запрос.УстановитьПараметр("ИНН",Лев(ИНН,10) + "%");
			Выборка = Запрос.Выполнить().Выбрать();

			Если НЕ Выборка.Следующий() Тогда
				ВызватьИсключение "Организация с ИНН " + ИНН + " не найдена";
			КонецЕсли;

			Организация = Выборка.Ссылка;

			Если Выборка.Следующий() Тогда
				ВызватьИсключение "Найдено несколько организаций с ИНН " + ИНН;
			КонецЕсли;

			КоличествоОрганизаций = КоличествоОрганизаций + 1;

			МассивКомпонентовДаты = СтрРазделить(СтрокаДаты," ");

			Если МассивКомпонентовДаты.Количество() <> 2 Тогда
				ВызватьИсключение "Неверный формат даты: " + СтрокаДаты;
			КонецЕсли;

			МассивКомпонентовКалендаря = СтрРазделить(МассивКомпонентовДаты[0],"-");
			МассивКомпонентовВремени = СтрРазделить(МассивКомпонентовДаты[1],":");

			Если МассивКомпонентовКалендаря.Количество() <> 3
				Или МассивКомпонентовВремени.Количество() <> 3 Тогда
				ВызватьИсключение "Неверный формат даты: " + СтрокаДаты;
			КонецЕсли;

			ДатаПолучения = Дата(
				Число(МассивКомпонентовКалендаря[0]),
				Число(МассивКомпонентовКалендаря[1]),
				Число(МассивКомпонентовКалендаря[2]),
				Число(МассивКомпонентовВремени[0]),
				Число(МассивКомпонентовВремени[1]),
				Число(МассивКомпонентовВремени[2]));

			ЗаписьРегистра = РегистрыСведений.SM_API_ЧЗ_Токен.СоздатьМенеджерЗаписи();
			ЗаписьРегистра.Пользователь = Пользователь;
			ЗаписьРегистра.Организация = Организация;
			ЗаписьРегистра.Токен = Токен;
			ЗаписьРегистра.ДатаПолучения = ДатаПолучения;
			ЗаписьРегистра.Записать();

			КоличествоЗаписей = КоличествоЗаписей + 1;

		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Строка " + Строка(НомерСтроки) + ". " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Попытка
		Чтение.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Ошибка закрытия файла: " + ОписаниеОшибки());
	КонецПопытки;

	ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Информация,,,"Импорт завершён. Записано: " + Строка(КоличествоЗаписей) + "; ошибок: " + Строка(КоличествоОшибок));

КонецПроцедуры





	