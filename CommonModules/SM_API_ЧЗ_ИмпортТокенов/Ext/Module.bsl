Процедура ВыполнитьИмпортТокенов() Экспорт

	ПутьКФайлу = "C:\ОбменЧЗ\Токены.csv";

	ФайлИмпорта = Новый Файл(ПутьКФайлу);
	Если НЕ ФайлИмпорта.Существует() Тогда
		ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Файл не найден: " + ПутьКФайлу);
		Возврат;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьКФайлу,КодировкаТекста.UTF8);
	Исключение
		ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Не удалось открыть файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	НомерСтроки = 0;
	КоличествоЗаписей = 0;
	КоличествоОшибок = 0;
	Пока Истина Цикл
		Попытка
			СтрокаФайла = Чтение.ПрочитатьСтроку();
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Ошибка чтения файла: " + ОписаниеОшибки());
			Прервать;
		КонецПопытки;
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
		// Первая строка содержит заголовки.
		Если НомерСтроки = 1 Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СокрЛП(СтрокаФайла)) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Поля = СтрРазделить(СтрокаФайла, ";");
			Если Поля.Количество() <> 4 Тогда
				ВызватьИсключение
					"Ожидаются ровно 4 поля: ФИО;ИНН;Токен;ДатаПолучения";
			КонецЕсли;
			ФИО = СокрЛП(Поля[0]);
			ИНН = СокрЛП(Поля[1]);
			Токен = СокрЛП(Поля[2]);
			СтрокаДаты = СокрЛП(Поля[3]);
			Если ПустаяСтрока(ФИО)
				Или ПустаяСтрока(ИНН)
				Или ПустаяСтрока(Токен)
				Или ПустаяСтрока(СтрокаДаты) Тогда
				ВызватьИсключение
					"В строке есть незаполненные поля";
			КонецЕсли;
			// Поиск организации по ИНН.
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 2
				|	Организации.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Организации КАК Организации
				|ГДЕ
				|	Организации.ИНН = &ИНН
				|	И НЕ Организации.ПометкаУдаления";

			Запрос.УстановитьПараметр("ИНН", ИНН);
			Выборка = Запрос.Выполнить().Выбрать();
			Если НЕ Выборка.Следующий() Тогда
				ВызватьИсключение
					"Организация с ИНН " + ИНН + " не найдена";
			КонецЕсли;
			Организация = Выборка.Ссылка;
			Если Выборка.Следующий() Тогда
				ВызватьИсключение
					"Найдено несколько организаций с ИНН " + ИНН;
			КонецЕсли;
			Пользователь =Справочники.Пользователи.НайтиПоНаименованию(ФИО,Истина);
			Если Пользователь.Пустая() Тогда
				ВызватьИсключение
					"Пользователь не найден: " + ФИО;
			КонецЕсли;

			ЧастиДаты = СтрРазделить(СтрокаДаты, " ");
			Если ЧастиДаты.Количество() <> 2 Тогда
				ВызватьИсключение
					"Неверный формат даты: " + СтрокаДаты;
			КонецЕсли;
			ЧастиКалендаря = СтрРазделить(ЧастиДаты[0], ".");
			ЧастиВремени = СтрРазделить(ЧастиДаты[1], ":");
			Если ЧастиКалендаря.Количество() <> 3
				Или ЧастиВремени.Количество() <> 3 Тогда
				ВызватьИсключение
					"Неверный формат даты: " + СтрокаДаты;
			КонецЕсли;
			ДатаПолучения = Дата(
				Число(ЧастиКалендаря[2]),
				Число(ЧастиКалендаря[1]),
				Число(ЧастиКалендаря[0]),
				Число(ЧастиВремени[0]),
				Число(ЧастиВремени[1]),
				Число(ЧастиВремени[2]));
			// Обновление записи по измерениям
			// Пользователь + Организация.
			ЗаписьРегистра =РегистрыСведений.SM_API_ЧЗ_Токен.СоздатьМенеджерЗаписи();
			ЗаписьРегистра.Пользователь = Пользователь;
			ЗаписьРегистра.Организация = Организация;
			ЗаписьРегистра.Токен = Токен;
			ЗаписьРегистра.ДатаПолучения = ДатаПолучения;
			ЗаписьРегистра.Записать();
			КоличествоЗаписей = КоличествоЗаписей + 1;
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Ошибка,,,"Строка " + Строка(НомерСтроки)+ ". " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Попытка
		Чтение.Закрыть();
	Исключение
	КонецПопытки;
	ЗаписьЖурналаРегистрации("SM_API_ЧЗ_ИмпортТокенов",УровеньЖурналаРегистрации.Информация,,,"Импорт завершён. Записано: "+ Строка(КоличествоЗаписей)+ "; ошибок: "+ Строка(КоличествоОшибок));
КонецПроцедуры