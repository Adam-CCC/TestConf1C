Процедура ВыгрузитьЗНпоЧери(Параметры = Неопределено) Экспорт
	
	РаботыЗН = Новый ТаблицаЗначений;
	РаботыЗН.Колонки.Добавить("Номер");
	РаботыЗН.Колонки.Добавить("ТипПозиции");
	РаботыЗН.Колонки.Добавить("НомерПозиции");
	РаботыЗН.Колонки.Добавить("КодПозиции");
	РаботыЗН.Колонки.Добавить("НомерЗаказЗапчасти");
	РаботыЗН.Колонки.Добавить("НаименованиеПозиции");
	РаботыЗН.Колонки.Добавить("Количество");
	РаботыЗН.Колонки.Добавить("ИтоговаяСтоимость");
	РаботыЗН.Колонки.Добавить("РасширениеЗН");
	РаботыЗН.Колонки.Добавить("Вналичии");
	РаботыЗН.Колонки.Добавить("Ссылка");
	РаботыЗН.Колонки.Добавить("ТипРемонта");
	
	Дилер = Справочники.Организации.НайтиПоРеквизиту("ИНН","6168069282");
	КодДилера = "6125600";
	
	ГдеСоздавать = КаталогВременныхФайлов();
	ИмяФайла = ГдеСоздавать+"file1.txt";
	ИмяФайлаСРаботами = ГдеСоздавать+"file2.txt";
	
	//=========================== 1 часть ===
	
	ТехническоеОбслуживание            = Справочники.ВидыРемонта.ТехническоеОбслуживание;
	КоммерческийРемонт                 = Справочники.ВидыРемонта.КоммерческийРемонт;     
	ТехническоеОбслуживаниеБесплатное  = Справочники.ВидыРемонта.ТехническоеОбслуживаниеБесплатное;
	ГарантияПроизводителя              = Справочники.ВидыРемонта.ГарантияПроизводителя;
	//Бондаренко++ 20230607
	ТОнольПлатный                      = Справочники.ВидыРемонта.ТО_нольПлатный;
	//Бондаренко-- 20230607
	//Бондаренко++ 20230706
	ТОнольБесплатный                   = Справочники.ВидыРемонта.ТО_ноль;
	//Бондаренко-- 20230706
	
	СзВидРемонта = Новый СписокЗначений;
	СзВидРемонта.Добавить(ТехническоеОбслуживание);
	СзВидРемонта.Добавить(КоммерческийРемонт);
	СзВидРемонта.Добавить(ТехническоеОбслуживаниеБесплатное);
	СзВидРемонта.Добавить(ГарантияПроизводителя);
	//Бондаренко++ 20230607
	СзВидРемонта.Добавить(ТОнольПлатный);
	//Бондаренко-- 20230607
	//Бондаренко++ 20230706
	СзВидРемонта.Добавить(ТОнольБесплатный);
	//Бондаренко-- 20230706               
	
	Запрос = Новый Запрос;
	
	Если ТипЗНЧ(Параметры) <> Тип("ДокументСсылка.ЗаказНаряд") Тогда  
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНарядРаботы.Ссылка,
		|	ЗаказНарядРаботы.Ссылка.Дата КАК Дата,
		|	ЗаказНарядРаботы.Ссылка.Организация,
		|	ЗаказНарядРаботы.Ссылка.Проведен,
		|	ЗаказНарядРаботы.НомерСтроки КАК НомерПозиции,
		|	ЗаказНарядРаботы.Работа КАК НаименованиеПозиции,
		|	""РАБОТА"" КАК ТипПозиции,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЗаказНарядРаботы.Работа.Артикул, """") = """"
		|			ТОГДА ЗаказНарядРаботы.Работа.Код
		|		ИНАЧЕ ЗаказНарядРаботы.Работа.Артикул
		|	КОНЕЦ КАК КодПозиции,
		|	ЗаказНарядРаботы.Количество * ЗаказНарядРаботы.Коэффициент КАК Количество,
		|	ЗаказНарядРаботы.СуммаВсего КАК ИтоговаяСтоимость,
		|	""НЕТ"" КАК РасширениеЗН,
		|	""ДА"" КАК Вналичии,
		|	ЗаказНарядРаботы.Ссылка.Номер КАК Номер,
		|	ЗаказНарядРаботы.Ссылка.Состояние,
		|	ЗаказНарядРаботы.Ссылка.ВидРемонта,
		|	ЗаказНарядРаботы.Ссылка.ВидРемонта.Наименование КАК ТипРемонта,
		|	ЗаказНарядРаботы.Ссылка.Пробег КАК Пробег
		|ИЗ
		|	Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
		|ГДЕ
		|	ЗаказНарядРаботы.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЗаказНарядРаботы.Ссылка.Проведен = ИСТИНА
		|	И ЗаказНарядРаботы.Ссылка.Организация = &Организация
		|	И ЗаказНарядРаботы.Ссылка.Автомобиль.Модель.Марка = &Марка
		|	И ЗаказНарядРаботы.Ссылка.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
		|	И ЗаказНарядРаботы.Ссылка.ВидРемонта В(&СзВидРемонта)
		|	И ЗаказНарядРаботы.Ссылка.Пробег > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказНарядТовары.Ссылка,
		|	ЗаказНарядТовары.Ссылка.Дата,
		|	ЗаказНарядТовары.Ссылка.Организация,
		|	ЗаказНарядТовары.Ссылка.Проведен,
		|	ЗаказНарядТовары.НомерСтроки,
		|	ЗаказНарядТовары.Номенклатура,
		|	""ДЕТАЛЬ"",
