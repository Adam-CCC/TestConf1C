		Строка.ФлагТелефон+ ";"+		
		Строка.ФлагЕмэйл+ ";"+		
		Строка.ФлагСмс+ ";"+		
		
		Сред(Строка.ДатаОбращения,1,10) + ";"+
		Строка.ПричинаОбращения + ";"+
		
		Строка.Рекомендации + ";"+		
		
		Сред(Строка.ДатаСозданияЗН,1,10) + ";"+
		Сред(Строка.ДатаНачалаРабот,1,10) + ";"+
		Сред(Строка.ДатаОкончанияРабот,1,10) + ";"+
		Сред(Строка.ДатаЗакрытия,1,10) + ";"+
		Строка.ТипРемонта+ ";"+
		Строка.ТО + ";"+
		Строка.СервиснаяКомпания + ";"+
		Строка.ДобраяВоля + ";"+
		Строка.СлесарныйРемонт + ";"+
		Строка.КузовнойРемонт + ";"+
		Строка.Акция + ";"+
		
		Строка.УстановкаДО + ";"+
		Строка.ПредпродажнаяПодготовка + ";"+		
		
		Строка.КодМастерОткрыл + ";"+		
		Строка.КодМастерРаботал + ";"+		
		Строка.КодМастерЗакрыл + ";"+		
		Строка.ТипДокумента + ";"+		
		Строка.Мойка + ";"+		
		Строка.Диагностика); 
	КонецЦикла;
	
	
	Попытка
		ТекстЗН.Записать(ИмяФайла); 
	Исключение
		//Сообщить("ОШИБКА! Не удалось записать файл с заголовками заказ-нарядов "+ИмяФайлаСработами);	
	КонецПопытки; 
	
	ТекстСРаботами = Новый ТекстовыйДокумент;
	ТекстСРаботами.ДобавитьСтроку("Номер заказ-наряда;Тип позиции;Номер позиции;Код позиции;номера заказа з/ч;Наименование позиции;Количество;Итоговая стоимость;Расширение заказ-наряда;В наличии");
	Для каждого Строка Из РаботыЗН Цикл
		ТекстСРаботами.ДобавитьСтроку(Строка.Номер + ";"+
		Строка.ТипПозиции + ";"+
		Строка.НомерПозиции + ";"+
