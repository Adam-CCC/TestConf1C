Функция НайтиЭлементСправочникаСМ_ЧериЭксид_Настройки(Марка,ПодразделениеКомпании) Экспорт
	
	Ссылка_ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СМ_ЧериЭксид_НастройкиПодразделения.Ссылка.Ссылка КАК Ссылка,
	|	СМ_ЧериЭксид_НастройкиПодразделения.Ссылка.Марка КАК Марка,
	|	СМ_ЧериЭксид_НастройкиПодразделения.ПодразделениеКомпании КАК ПодразделениеКомпании
	|ИЗ
	|	Справочник.СМ_ЧериЭксид_Настройки.Подразделения КАК СМ_ЧериЭксид_НастройкиПодразделения
	|ГДЕ
	|	СМ_ЧериЭксид_НастройкиПодразделения.Ссылка.Марка = &Марка
	|	И СМ_ЧериЭксид_НастройкиПодразделения.ПодразделениеКомпании = &ПодразделениеКомпании";
	
	Запрос.УстановитьПараметр("Марка", Марка);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Ссылка_ = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Ссылка_;
	
КонецФункции // НайтиЭлементСправочникаСМ_ЧериЭксид_Настройки()
//Бондаренко-- 20241009
