			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.РезервРасход, "ЧН=0; ЧГ=0")))			     + ";" +
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.РезервКонечныйОстаток, "ЧН=0; ЧГ=0")))	     + ";" +
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.СуммаНачальныйОстаток, "ЧН=0; ЧГ=0")))	     + ";" +
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.СуммаПриход, "ЧН=0; ЧГ=0")))				 + ";" +
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.СуммаРасход, "ЧН=0; ЧГ=0")))				 + ";" +
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.СуммаКонечныйОстаток, "ЧН=0; ЧГ=0")))	     + ";" +
			ФорматироватьДляCSV(СокрЛП(ВыборкаДетальныеЗаписи.Движ_Ост))			 				  	   		 + ";" + 			
			ФорматироватьДляCSV(СокрЛП(ВыборкаДетальныеЗаписи.КолПрих_КолРасх))			 		 		 		 + ";" + 			
			ФорматироватьДляCSV(СокрЛП(ВыборкаДетальныеЗаписи.РезПрих_РезРасх));                                                                     				
			ТекстовыйФайл.ДобавитьСтроку(СтрокаПорция);			
		КонецЦикла;		 
		
		Попытка
			ТекстовыйФайл.Записать(ГдеСоздавать + ИмяФайла);
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки; 
				
		ЗапросУничтожить1.Выполнить();	
		ЗапросУничтожить2.Выполнить();				
		
		Дата = Дата + 86400;   
	КонецЦикла;   
	
	УдалитьФайлы(ГдеСоздавать, МаскаФайла + ".csv"); 
	ОбъединитьФайлы(ГдеСоздавать + "Temp_" + МаскаФайла + "*", ГдеСоздавать + МаскаФайла + ".csv");
	УдалитьФайлы(ГдеСоздавать, "Temp_" + МаскаФайла + "_*");
КонецПроцедуры
