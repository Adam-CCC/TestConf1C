Функция ЭтоАкция(ТекЗН) Экспорт
	
	Флаг_это_Акция = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНарядРаботы.Ссылка,
	|	ЗаказНарядРаботы.Работа,
	|	ЗаказНарядРаботы.Работа.ТипРабот
	|ИЗ
	|	Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
	|ГДЕ
	|	ЗаказНарядРаботы.Ссылка = &Ссылка
	|	И ЗаказНарядРаботы.Работа.ТипРабот = &ТипРабот";
	
	Запрос.УстановитьПараметр("Ссылка", ТекЗН);
	Запрос.УстановитьПараметр("ТипРабот", Перечисления.ТипыРабот.Акция);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Флаг_это_Акция = Истина;
	КонецЦикла; 
	
	Возврат Флаг_это_Акция;
	
КонецФункции // ЭтоАкция(ТекЗН)
