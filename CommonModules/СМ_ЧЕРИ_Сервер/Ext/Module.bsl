		СтрЗаменить(Строка.ИтоговаяСтоимость,Символы.НПП,"") + ";"+
		Строка.РасширениеЗН + ";"+
		Строка.Вналичии); 
	КонецЦикла;
	Попытка
		ТекстСРаботами.Записать(ИмяФайлаСработами); 
	Исключение
		//Сообщить("ОШИБКА! Не удалось записать файл с работами заказ-нарядов");	
	КонецПопытки; 
	
	//=========================== 3 часть ===
	
	Если Состав.Количество()+РаботыЗН.Количество() > 0 Тогда
		
		ДвоичныеДанныеЗН=Новый ДвоичныеДанные(ИмяФайла);
