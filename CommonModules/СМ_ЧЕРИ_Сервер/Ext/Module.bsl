Процедура ВыгрузитьОстаткиНоменклатурыПоЧери(Параметры = Неопределено) Экспорт
	
	Выборка = Справочники.СМ_ЧериЭксид_Настройки.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекОбъект = Выборка.ПолучитьОбъект(); 
		
		Если ТекОбъект.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекОбъект.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Дилер = ТекОбъект.Дилер;
		Если обЗначениеНеЗаполнено(Дилер) Тогда
			Продолжить;		
		КонецЕсли;
		
		КодДилера = ТекОбъект.КодДилера;
		Если ПустаяСтрока(КодДилера) Тогда
			Продолжить;		
		КонецЕсли;
		
		КлючАпи = ТекОбъект.КлючАПИ;		
		Если ПустаяСтрока(КлючАпи) Тогда
			Продолжить;		
		КонецЕсли;
		
		СписокПодразделений = Новый СписокЗначений;
		Если ТекОбъект.Подразделения.Количество() > 0 Тогда
			СписокПодразделений = ПолучитьСписокПодразделений(ТекОбъект);
		КонецЕсли;
		Если СписокПодразделений.Количество() = 0 Тогда
			Продолжить;			
		КонецЕсли;
		
		СписокСкладов = Новый СписокЗначений;
		Если ТекОбъект.Склады.Количество() > 0 Тогда
			СписокСкладов = ПолучитьСписокСкладов(ТекОбъект);
		КонецЕсли;
		
		СписокПроизводителей = Новый СписокЗначений;
		Если ТекОбъект.Производители.Количество() > 0 Тогда
			СписокПроизводителей = ПолучитьСписокПроизводителей(ТекОбъект);
		КонецЕсли;
		Если СписокПроизводителей.Количество() = 0 Тогда
			Продолжить;			
		КонецЕсли;
		
		Марка = ТекОбъект.Марка;
		
		ВыгрузитьОстаткиНоменклатурыДилераЧериИлиЭксид(Дилер,КодДилера,КлючАпи,СписокПодразделений,СписокСкладов,СписокПроизводителей,Марка); 
		
		Для Счетчик=1 По 10000000 Цикл
			Счетчик = Счетчик + 1;					
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры 

Функция ПолучитьСписокПодразделений(ТекОбъект) Экспорт
	
	ИтогСпПодр = Новый СписокЗначений;
	
	Для каждого ТекПодр Из ТекОбъект.Подразделения Цикл
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&Подразделение)
		|	И ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Подразделение",ТекПодр.ПодразделениеКомпании);
		
		ТекСпПодр = Новый СписокЗначений;
		
		ТекСпПодр.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		
		Для каждого НовПодр Из ТекСпПодр Цикл
			Если ИтогСпПодр.НайтиПоЗначению(НовПодр.Значение) = Неопределено Тогда
				ИтогСпПодр.Добавить(НовПодр.Значение);
			КонецЕсли;		
		КонецЦикла;
		
	КонецЦикла;	 
	
	Возврат ИтогСпПодр;
	
КонецФункции // ПолучитьСписокПодразделений(ТекОбъект) 

//Бондаренко++ 20231011
Функция ПолучитьСписокСкладов(ТекОбъект) Экспорт
	
	ИтСпСкладов = Новый СписокЗначений;
	
	ИтСпСкладов.ЗагрузитьЗначения(ТекОбъект.Склады.Выгрузить().ВыгрузитьКолонку("Склад"));
	
	Возврат ИтСпСкладов;
	
КонецФункции // ПолучитьСписокСкладов(ТекОбъект) 

Функция ПолучитьСписокПроизводителей(ТекОбъект) Экспорт
	
	ИтСпПроизводителей = Новый СписокЗначений;
	
	ИтСпПроизводителей.ЗагрузитьЗначения(ТекОбъект.Производители.Выгрузить().ВыгрузитьКолонку("Производитель"));
	
	Возврат ИтСпПроизводителей;
	
КонецФункции // ПолучитьСписокСкладов(ТекОбъект)
