Процедура ВыгрузитьЗНуниверсальная(Параметры = Неопределено) Экспорт
	
	Выборка = Справочники.СМ_ЧериЭксид_Настройки.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекОбъект = Выборка.ПолучитьОбъект(); 
		
		Если ТекОбъект.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекОбъект.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Дилер = ТекОбъект.Дилер;
		Если обЗначениеНеЗаполнено(Дилер) Тогда
			Продолжить;		
		КонецЕсли;
		
		КодДилера = ТекОбъект.КодДилера;
		Если ПустаяСтрока(КодДилера) Тогда
			Продолжить;		
		КонецЕсли;
		
		КлючАпи = ТекОбъект.КлючАПИ;		
		Если ПустаяСтрока(КлючАпи) Тогда
			Продолжить;		
		КонецЕсли;
		
		СписокПодразделений = Новый СписокЗначений;
		Если ТекОбъект.Подразделения.Количество() > 0 Тогда
			СписокПодразделений = ПолучитьСписокПодразделений(ТекОбъект);
		КонецЕсли;
		Если СписокПодразделений.Количество() = 0 Тогда
			Продолжить;			
		КонецЕсли;
		
		СписокСкладов = Новый СписокЗначений;
		Если ТекОбъект.Склады.Количество() > 0 Тогда
			СписокСкладов = ПолучитьСписокСкладов(ТекОбъект);
		КонецЕсли;
		
		СписокПроизводителей = Новый СписокЗначений;
		Если ТекОбъект.Производители.Количество() > 0 Тогда
			СписокПроизводителей = ПолучитьСписокПроизводителей(ТекОбъект);
		КонецЕсли;
		Если СписокПроизводителей.Количество() = 0 Тогда
			Продолжить;			
		КонецЕсли;
		
		Марка = ТекОбъект.Марка;
		
		ВыгрузитьЗНпоМарке(ТекОбъект); 
		
		Для Счетчик=1 По 10000000 Цикл
			Счетчик = Счетчик + 1;					
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры //ВыгрузитьЗНуниверсальная((Параметры = Неопределено) Экспорт
