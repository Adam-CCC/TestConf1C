			ФорматироватьДляCSV(СокрЛП(ВыборкаДетальныеЗаписи.Склад))			 						  		 + ";" + 				
			ФорматироватьДляCSV(СокрЛП(ВыборкаДетальныеЗаписи.Контрагент))			 					  		 + ";" + 
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.ДокументДата, "ДЛФ=DT")))			  		 + ";" + 
