Процедура ВыгрузитьОстаткиНоменклатурыДилераЧериИлиЭксид(Дилер,КодДилера,КлючАпи,СписокПодразделений,СписокСкладов,СписокПроизводителей,Марка) Экспорт
	
	ГдеСоздавать = КаталогВременныхФайлов();
	ИмяФайла = ГдеСоздавать+"file3.txt";
	//СМГ_Сообщить(ИмяФайла);
	
	Запрос = Новый Запрос; 
	
	Если СписокСкладов.Количество() > 0 Тогда
		Запрос.Текст =	"ВЫБРАТЬ
		|	&Дилер КАК Дилер,
		|	&КодДилера КАК КодДилера,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул КАК Артикул,
		|	СУММА(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток) КАК СвободныйОстаток,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Ссылка,
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&ДатаОтчета, ) КАК ОстаткиТоваровКомпанииОстатки
		|ГДЕ
		|	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток > 0
		|	И ОстаткиТоваровКомпанииОстатки.Номенклатура.Производитель В(&СписокПроизводителей)
		|	И ОстаткиТоваровКомпанииОстатки.СкладКомпании В(&СписокСкладов)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул,
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании";
		Запрос.УстановитьПараметр("СписокСкладов", СписокСкладов); 
	Иначе	
		Запрос.Текст = 	"ВЫБРАТЬ
		|	&Дилер КАК Дилер,
		|	&КодДилера КАК КодДилера,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул КАК Артикул,
		|	СУММА(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток) КАК СвободныйОстаток,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура КАК Ссылка,
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&ДатаОтчета, ) КАК ОстаткиТоваровКомпанииОстатки
		|ГДЕ
		|	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток > 0
		|	И ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение В(&СписокПодразделений)
		|	И ОстаткиТоваровКомпанииОстатки.Номенклатура.Производитель В(&СписокПроизводителей)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул,
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании";
		Запрос.УстановитьПараметр("СписокПодразделений",СписокПодразделений);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дилер", Дилер);
	Запрос.УстановитьПараметр("КодДилера", КодДилера);
	Запрос.УстановитьПараметр("ДатаОтчета", КонецДня(ТекущаяДата()  -  86400));   //Минус  1 день
	Запрос.УстановитьПараметр("СписокПроизводителей", СписокПроизводителей);
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	//Бондаренко++ 20240118
	ТаблицаОстатков.Свернуть("Дилер,КодДилера,Артикул,Ссылка","СвободныйОстаток");
	//Бондаренко-- 20240118
	
	//===================================
	СписокНоменклатуры = Новый СписокЗначений;
	СписокНоменклатуры.ЗагрузитьЗначения(ТаблицаОстатков.ВыгрузитьКолонку("Ссылка"));
	
	Запрос1 = Новый Запрос;
	Запрос1.Текст = 
	"ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура,
	|	МАКСИМУМ(ЦеныСрезПоследних.Цена) КАК Цена,
	|	ЦеныСрезПоследних.ТипЦен
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.ТипЦен = &ТипЦенПродажи
	|	И ЦеныСрезПоследних.Номенклатура В(&СписокНоменклатуры)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныСрезПоследних.Номенклатура,
	|	ЦеныСрезПоследних.ТипЦен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура,
	|	МАКСИМУМ(ЦеныСрезПоследних.Цена),
	|	ЦеныСрезПоследних.ТипЦен
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.ТипЦен = &ТипЦенЗакупки
	|	И ЦеныСрезПоследних.Номенклатура В(&СписокНоменклатуры)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныСрезПоследних.Номенклатура,
	|	ЦеныСрезПоследних.ТипЦен";
	
	Запрос1.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	Запрос1.УстановитьПараметр("ТипЦенПродажи", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	Запрос1.УстановитьПараметр("ТипЦенЗакупки", Справочники.ТипыЦен.ОсновнойТипЦенЗакупки);
	
	ТаблЦен = Запрос1.Выполнить().Выгрузить();
	
	//ТаблЦен.ВыбратьСтроку();
	
	//=========================
	
	ТекстЗН = Новый ТекстовыйДокумент; 
	
	Для каждого Строка Из ТаблицаОстатков Цикл
		
		ПарОтбора = Новый Структура();
		ПарОтбора.Вставить("Номенклатура",Строка.Ссылка);
		СтрокаЦен = ТаблЦен.НайтиСтроки(ПарОтбора);
		
		Если СтрокаЦен.Количество() > 0 Тогда
			Цена = СтрЗаменить(СтрокаЦен[0].Цена,Символы.НПП,"");
		Иначе	
			Цена = 0;
		КонецЕсли;
		
		ТекстЗН.ДобавитьСтроку(""+СтрЗаменить(Строка.Дилер,"""","'") + ";"+
		Строка.КодДилера + ";"+
		Строка.Артикул + ";"+
		Строка.СвободныйОстаток + ";"+
		СокрЛП(Цена));
		
	КонецЦикла;
	
	Попытка
		ТекстЗН.Записать(ИмяФайла); 
	Исключение
		//Сообщить("ОШИБКА! Не удалось записать файл с заголовками заказ-нарядов "+ИмяФайлаСработами);	
	КонецПопытки; 
	
	Если ТаблицаОстатков.Количество()  > 0 Тогда
		ДвоичныеДанныеЗН=Новый ДвоичныеДанные(ИмяФайла);
		АдресВХ_Остатки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЗН);
		ВыгрузкаОстатковНоменклатурыИЦенНаПорталЧери(АдресВХ_Остатки,КлючАпи,Марка);	
	КонецЕсли; 
	
КонецПроцедуры //ВыгрузитьОстаткиНоменклатурыДилераЧериИлиЭксид(Дилер,КодДилера,КлючАпи,СписокПодразделений,СписокСкладов,СписокПроизводителей,Марка)
