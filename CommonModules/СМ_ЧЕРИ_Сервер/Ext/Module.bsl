// Вспомогательная функция для корректирования данных для CSV
Функция ФорматироватьДляCSV(Значение) Экспорт
	//Иванченко 20260213 ++    
	//СтрокаЗначения = Строка(СтрокаДока);
	//НайденоОсобыхСимволов = Ложь;
	//
	//// Проверка на наличие опасных символов
	//НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, ";") > 0);
	//НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, Символ(34)) > 0);   // "
	//НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, Символы.ПС) > 0);   // \n
	//НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, Символы.ВК) > 0);   // \r
	//
	//Если НайденоОсобыхСимволов Тогда
	//    // Экранирование кавычек (удвоение)
	//    СтрокаЗначения = СтрЗаменить(СтрокаЗначения, """", """""");
	//    // Обрамление в двойные кавычки
	//    Возврат """" + СтрокаЗначения + """";
	//Иначе
	//    Возврат СтрокаЗначения;
	//КонецЕсли;
	
	//Форматирование вывода
	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		СтрокаЗначения = СокрЛП(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		СтрокаЗначения = СокрЛП(Формат(Значение, "БЛ=Нет; БИ=Да")); 
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		СтрокаЗначения = СокрЛП(Формат(Значение, "ЧРД=,; ЧН=0; ЧГ=0; ЧО=1"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		СтрокаЗначения = СокрЛП(?(Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-") = "-", "", Формат(Значение, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-")));	
	КонецЕсли;
	
	НайденоОсобыхСимволов = Ложь;
	
	// Проверка на наличие опасных символов
	НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, ";") > 0);
	НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, Символ(34)) > 0); // " 
	НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, Символ(160)) > 0); // неразрывный пробел
	НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, Символы.ПС) > 0);   // \n
	НайденоОсобыхСимволов = НайденоОсобыхСимволов Или (СтрНайти(СтрокаЗначения, Символы.ВК) > 0);   // \r
	
	Если НайденоОсобыхСимволов Тогда
		// Экранирование кавычек (удвоение)
		СтрокаЗначения = СтрЗаменить(СтрокаЗначения, """", """""");
		// Обрамление в двойные кавычки
		Возврат """" + СтрокаЗначения + """";
	Иначе
		Возврат СтрокаЗначения;
	КонецЕсли;
	//Иванченко 20260213 ++    	
КонецФункции
