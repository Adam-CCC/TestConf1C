	|						ТОГДА ""Приход по резерву""
	|					ИНАЧЕ ""Расход по резерву""
	|				КОНЕЦ
	|	КОНЕЦ КАК РезПрих_РезРасх,
	|	АВТОНОМЕРЗАПИСИ() КАК Индекс
	|ПОМЕСТИТЬ ВТ_Результат
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.ОстаткиИОбороты(
	|			НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ),
	|			КОНЕЦПЕРИОДА(&Дата, ДЕНЬ),
	|			Регистратор,
	|			,
	|			НЕ Номенклатура.ПометкаУдаления
	|				И НЕ СкладКомпании.ПометкаУдаления) КАК ОстаткиТоваровКомпанииОстаткиИОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
	|		ПО ОстаткиТоваровКомпанииОстаткиИОбороты.Период = ВТ_Цены.Дата
	|			И ОстаткиТоваровКомпанииОстаткиИОбороты.Регистратор = ВТ_Цены.Документ
	|			И ОстаткиТоваровКомпанииОстаткиИОбороты.Номенклатура = ВТ_Цены.Номенклатура
	|			И ОстаткиТоваровКомпанииОстаткиИОбороты.СкладКомпании = ВТ_Цены.Склад
	|ГДЕ
	|	ОстаткиТоваровКомпанииОстаткиИОбороты.Период <> НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Индекс"; 
		
	// Количество записей 
	ЗапросКЗ = Новый Запрос;
	ЗапросКЗ.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;   
	ЗапросКЗ.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
