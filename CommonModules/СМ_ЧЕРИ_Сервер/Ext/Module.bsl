КонецПроцедуры // ВыгрузитьЗНпоМарке(Параметры = Неопределено) Экспорт

Процедура ВыгрузкаНаПорталМарки(АдресВХ_ЗН,АдресВХ_Работ,КлючАПИ,Марка) Экспорт
	
	Перем ОписаниеОшибки;
	
	ПутьКЛог = "C:\Program Files\CheryServiceDataUploader\log.txt";
	ФайлЛогНаДиске = Новый Файл(ПутьКЛог);
	
	//Бондаренко++ 20240206
	Если Марка = Справочники.Марка.KAIYI ИЛИ Марка = Справочники.Марка.BAIC Тогда
		ПолныйПутьКпрограмме = "C:\Program Files\CheryServiceDataUploader\AvtotorServiceDataUploader.exe";		 
	Иначе
		ПолныйПутьКпрограмме = "C:\Program Files\CheryServiceDataUploader\CheryServiceDataUploader.exe";		
	КонецЕсли;
	//Бондаренко-- 20240206
	
	ИмяФайлаПрограммыНаДиске = Новый Файл(ПолныйПутьКпрограмме);
	
	Если   ИмяФайлаПрограммыНаДиске.Существует() Тогда
		
		ИмяВременногоФайлаЗН = "C:\Program Files\CheryServiceDataUploader\DataToSend\file1.txt";
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХ_ЗН);
		ДвоичныеДанные.Записать(ИмяВременногоФайлаЗН);
		
		ИмяВременногоФайлаРабот = "C:\Program Files\CheryServiceDataUploader\DataToSend\file2.txt";
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХ_Работ);
		ДвоичныеДанные.Записать(ИмяВременногоФайлаРабот);
		
		//Бондаренко++ 20250207
		Если Марка = Справочники.Марка.JAC Тогда
			ИмяКоманды = """C:\Program Files\CheryServiceDataUploader\JacServiceDataUploader.exe"""+" "+СокрЛП(КлючАПИ);
		ИначеЕсли Марка = Справочники.Марка.KAIYI ИЛИ Марка = Справочники.Марка.BAIC Тогда
			ИмяКоманды = """C:\Program Files\CheryServiceDataUploader\AvtotorServiceDataUploader.exe"""+" "+СокрЛП(КлючАПИ);
		Иначе
			ИмяКоманды = """C:\Program Files\CheryServiceDataUploader\CheryServiceDataUploader.exe"""+" "+СокрЛП(КлючАПИ); 
		КонецЕсли;
		//Бондаренко++ 20250206
		
		Попытка
			ОбщиеСервер.ВыполнитьКомандуНаСервере(ИмяКоманды,ОписаниеОшибки);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;	
		
	Иначе			
		
		ОписаниеОшибки = "ОШИБКА! Файл '"+ПолныйПутьКпрограмме+"' не существует.";			
		
	КонецЕсли;
	
КонецПроцедуры //ВыгрузкаНаПорталМарки(АдресВХ_ЗН,АдресВХ_Работ,КодAPI) Экспорт
