	|	ВТ_Результат.ДокументНомер КАК ДокументНомер,
	|	ВТ_Результат.ДокументВид КАК ДокументВид,
	|	ВТ_Результат.Откуда КАК Откуда,
	|	ВТ_Результат.Куда КАК Куда,
	|	ВТ_Результат.ДокументВнутренний КАК ДокументВнутренний,
	|	ВТ_Результат.Группа1 КАК Группа1,
	|	ВТ_Результат.Группа2 КАК Группа2,
	|	ВТ_Результат.Группа3 КАК Группа3,
	|	ВТ_Результат.Группа4 КАК Группа4,
	|	ВТ_Результат.Группа5 КАК Группа5,
	|	ВТ_Результат.Группа6 КАК Группа6,
	|	ВТ_Результат.Номенклатура КАК Номенклатура,
	|	ВТ_Результат.Неликвид КАК Неликвид,
