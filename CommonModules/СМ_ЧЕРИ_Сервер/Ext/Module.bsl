		АдресВХ_Работ = ПоместитьВоВременноеХранилище(ДвоичныеДанныеРабот);
		
		ВыгрузкаНаПорталМарки(АдресВХ_ЗН,АдресВХ_Работ,КлючАПИ,Марка);	
		
