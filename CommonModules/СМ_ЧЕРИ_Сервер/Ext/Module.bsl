			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.КоличествоРасход, "ЧН=0; ЧГ=0")))		     + ";" +
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.КоличествоКонечныйОстаток, "ЧН=0; ЧГ=0")))  + ";" +
			ФорматироватьДляCSV(СокрЛП(Формат(ВыборкаДетальныеЗаписи.РезервНачальныйОстаток, "ЧН=0; ЧГ=0")))	 + ";" +
