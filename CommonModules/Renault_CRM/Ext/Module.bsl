//Статистика ОК
Процедура Воронка_ПосещениеАвтосалона__Снять(IDK) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ВоронкаПродаж.IDK,
	               |	CRM_ВоронкаПродаж.ЭтапПродаж,
	               |	CRM_ВоронкаПродаж.ДатаВыполнения,
	               |	CRM_ВоронкаПродаж.Объект
	               |ИЗ
	               |	РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
	               |ГДЕ
	               |	CRM_ВоронкаПродаж.IDK = &IDK
	               |	И CRM_ВоронкаПродаж.ЭтапПродаж = &ЭтапПродаж";
	Запрос.УстановитьПараметр("IDK", IDK);
	Запрос.УстановитьПараметр("ЭтапПродаж", Справочники.CRM_ЭтапыПродаж.ПосещениеАвтосалона);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

