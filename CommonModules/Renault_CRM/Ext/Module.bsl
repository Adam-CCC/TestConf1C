Функция СоздатьРабочийЛистПоТрафику(ID, Менеджер = Неопределено) Экспорт

	ТекущийРЛ = НайтиРабочийЛистПоТрафику(ID);
	Если (ТекущийРЛ = Неопределено) Тогда

		Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ID);
		Если Запись <> Неопределено Тогда

			//Отметим трафик как обработанный
			Запись.Обработан = Истина;
			Запись.Записать();

			Если Запись.ТипТрафика <> Справочники.CRM_ТипТрафика.ЛидRenault Тогда

				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	CRM_ЗначенияРеквизитовТрафика.РеквизитТрафика,
				|	CRM_ЗначенияРеквизитовТрафика.ЗначениеРеквизита
				|ИЗ
				|	РегистрСведений.CRM_ЗначенияРеквизитовТрафика КАК CRM_ЗначенияРеквизитовТрафика
				|ГДЕ
				|	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика = &ИдентификаторТрафика";
				Запрос.УстановитьПараметр("ИдентификаторТрафика", ID);
				ТаблицаРеквизитов = Запрос.Выполнить().Выгрузить();

			Иначе

				Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Запись.Клиент);
				Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Запись.Клиент);
				ТаблицаРеквизитов = Новый ТаблицаЗначений;
				ТаблицаРеквизитов.Колонки.Добавить("РеквизитТрафика", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.CRM_РеквизитыТрафика"));
				ТаблицаРеквизитов.Колонки.Добавить("ЗначениеРеквизита", Новый ОписаниеТипов("Строка"));
				Если ЗначениеЗаполнено(Телефон) Тогда 
					СтрокаТЗ = ТаблицаРеквизитов.Добавить();
					СтрокаТЗ.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Телефон;
					СтрокаТЗ.ЗначениеРеквизита = Телефон;
				КонецЕсли;
				Если ЗначениеЗаполнено(Email) Тогда 
					СтрокаТЗ = ТаблицаРеквизитов.Добавить();
					СтрокаТЗ.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Email;
					СтрокаТЗ.ЗначениеРеквизита = Email;
				КонецЕсли;

			КонецЕсли;

			СтрокаПол = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Пол);
			Если СтрокаПол = Неопределено Тогда
				Пол = Неопределено;
			Иначе
				Пол = СтрокаПол.ЗначениеРеквизита;
			КонецЕсли;
			
			СтрокаТелефон = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Телефон);
			Если СтрокаТелефон = Неопределено Тогда
				Телефон = Неопределено;
			Иначе
				Телефон = СтрокаТелефон.ЗначениеРеквизита;
			КонецЕсли;
			
			СтрокаEmail = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Email);
			Если СтрокаEmail = Неопределено Тогда
				Email = Неопределено;
			Иначе
				Email = СтрокаEmail.ЗначениеРеквизита; 
			КонецЕсли;
			
			//Создание рабочего листа
			СледующийИДК = Renault_CRM.ПолучитьНомерСледующегоРабочегоЛиста();
			ЗаписьРЛ = РегистрыСведений.Renault_РабочиеЛисты.СоздатьМенеджерЗаписи();
			//ЗаписьРЛ.Период = ТекущаяДата();
			ЗаписьРЛ.ID = СокрЛП(Новый УникальныйИдентификатор);
			ЗаписьРЛ.IDK = СледующийИДК;
			ЗаписьРЛ.ДатаID = ТекущаяДата();
			ЗаписьРЛ.Отдел = Запись.Отдел;
			ЗаписьРЛ.ДилерскийЦентр = Запись.ДилерскийЦентр;
			ЗаписьРЛ.МодельАвтомобиля = Запись.ПервичныйИнтерес.Модель;
			ЗаписьРЛ.ПервичныйИнтересМодель = Запись.ПервичныйИнтерес;
			ЗаписьРЛ.ТипТрафика = Запись.ТипТрафика;
			ЗаписьРЛ.IDТрафика = Запись.Идентификатор;
			Если Не ЗначениеЗаполнено(Менеджер) Тогда
				ЗаписьРЛ.Сотрудник = Запись.Менеджер;
			Иначе
				ЗаписьРЛ.Сотрудник = Менеджер;
			КонецЕсли;
			
			РезультатПроверкиРЛСуществует = Renault_CRM.ПроверитьНаличиеРабочегоЛиста(СледующийИДК);
			
			Если НЕ РезультатПроверкиРЛСуществует Тогда
				
				ЗаписьРЛ.Записать();
				
				//Действия после записи РЛ
				
				//Добавим комментарий Администратора
				Если ЗначениеЗаполнено(Запись.Комментарий) Тогда
					ЗК             		= РегистрыСведений.CRM_Комментарии.СоздатьМенеджерЗаписи();
					ЗК.Дата        		= ТекущаяДата();
					ЗК.IDK         		= СледующийИДК;
					ЗК.Идентификатор 	= СокрЛП(Новый УникальныйИдентификатор);
					ЗК.ТекстКомментария = СокрЛП(Запись.Комментарий);
					ЗК.Автор	   		= Запись.Администратор;
					Зк.Записать();
				КонецЕсли;
				
				//Создадим потенциального клиента
				Клиент = CRM_Сервер.СоздатьПотенциальногоКонтрагентаПоТрафику(Запись.Идентификатор);
				
				//Сохраним потенциального контрагента в рабочем листе
				ЗаписьРЛ.Клиент = Клиент;
				ЗаписьРЛ.Записать();
				
				//Сохраним потенциального контрагента в трафике
				Запись.Клиент = Клиент;
				Запись.Записать();
				
				//Если это посещение, необходимо отметить соответствующий этап продаж воронки
				Если Запись.ТипТрафика = Справочники.CRM_ТипТрафика.ПосещениеАвтосалона Тогда
					Renault_CRM.Воронка_ПосещениеАвтосалона_УстановитьСнять(ЗаписьРЛ.IDK);
					Renault_CRM.Статистика_УстановитьСнять(Справочники.CRM_ЭтапыПродаж.ПосещениеАвтосалона, ЗаписьРЛ.IDK);
				КонецЕсли;
				
				//Если есть телефон клиента - отметим выполнение этапа продаж, 
				//т.к. при создании клиента этого не произойдет (нет IDK)
				Если ЗначениеЗаполнено(Телефон) Тогда
					Renault_CRM.Воронка_НаличиеТелефона_Установить(СледующийИДК, Неопределено);
					Renault_CRM.Воронка_НаличиеКонтактов_Установить(СледующийИДК, Неопределено);
					Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеТелефона, СледующийИДК);
					Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеКонтактов, СледующийИДК);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Email) Тогда
					Renault_CRM.Воронка_НаличиеEmail_Установить(СледующийИДК, Неопределено);
					Renault_CRM.Воронка_НаличиеКонтактов_Установить(СледующийИДК, Неопределено);
					Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеEmail, СледующийИДК);
					Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеКонтактов, СледующийИДК);
				КонецЕсли;
				
				Возврат ЗаписьРЛ;
				
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Возврат ТекущийРЛ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьПользователяПоСотруднику(Сотрудник) Экспорт
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Пользователи.Ссылка
	               |ИЗ
	               |	Справочник.Пользователи КАК Пользователи
	               |ГДЕ
	               |	Пользователи.Сотрудник = &Сотрудник";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСтатусыСотрудников(МассивСотрудников) Экспорт
	
	//Получим таблицу со статусами занятости
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(CRM_СтатусыЗанятостиСотрудниковСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.CRM_ЗанятостьСотрудника.Свободен)) КАК ЗанятостьСотрудника,
	               |	ЕСТЬNULL(CRM_СтатусыЗанятостиСотрудниковСрезПоследних.ПричинаЗанятости, НЕОПРЕДЕЛЕНО) КАК ПричинаЗнаятостиСотрудника,
	               |	Пользователи.Ссылка КАК Пользователь,
	               |	Пользователи.Код КАК ПользовательИмя,
	               |	ЛОЖЬ КАК АктивностьПользователя,
	               |	Сотрудники.Ссылка КАК Сотрудник,
	               |	CRM_СтатусыЗанятостиСотрудниковСрезПоследних.ПримерноеВремяОкончания
	               |ИЗ
	               |	Справочник.Сотрудники КАК Сотрудники
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СтатусыЗанятостиСотрудников.СрезПоследних КАК CRM_СтатусыЗанятостиСотрудниковСрезПоследних
	               |		ПО (CRM_СтатусыЗанятостиСотрудниковСрезПоследних.Сотрудник = Сотрудники.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	               |		ПО Сотрудники.Ссылка = Пользователи.Сотрудник
	               |ГДЕ
	               |	Сотрудники.Ссылка В(&МассивСотрудников)";
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);			   
	ТаблицаСтатусыСотрудников = Запрос.Выполнить().Выгрузить();
		
	//Заполним активность пользователей бд в таблице
	
	СоединенияИнформационнойБазы = ПолучитьСоединенияИнформационнойБазы();
	
	ТаблицаСтатусыСотрудников.Колонки.Добавить("ПользовательИмяБезПробелов");
	Для Каждого Строка Из ТаблицаСтатусыСотрудников Цикл
