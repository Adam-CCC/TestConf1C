	|	ОформленныеВыдачи.ОформленаВыдача,
	|	УтвержденныеРезервы.УтвержденРезерв,
	|	УтвержденныеРезервы.ДатаСнятияСРезерва,
	|	ЗаконтрактованныеАвтомобили.АвтомобильЗаконтрактован,
	|	ДополнительнаяИнформация.НеДляПродажи,
	|	ЗаявкиНаРезерв.ЗаявленРезерв,
	|	ТаблицаАвтомобилей.Модель,
	|	ТаблицаАвтомобилей.Версия,
	|	ТаблицаАвтомобилей.ЦветНаименование,
	|	ТаблицаАвтомобилей.Блокировка,
	|	УчетПродажОстатков.ОформленаРеализация
	|ИЗ
	|	ТаблицаАвтомобилей КАК ТаблицаАвтомобилей
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетПродажОстатков КАК УчетПродажОстатков
	|		ПО ТаблицаАвтомобилей.Автомобиль = УчетПродажОстатков.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОформленныеВыдачи КАК ОформленныеВыдачи
	|		ПО ТаблицаАвтомобилей.Автомобиль = ОформленныеВыдачи.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ УтвержденныеРезервы КАК УтвержденныеРезервы
	|		ПО ТаблицаАвтомобилей.Автомобиль = УтвержденныеРезервы.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаконтрактованныеАвтомобили КАК ЗаконтрактованныеАвтомобили
	|		ПО ТаблицаАвтомобилей.Автомобиль = ЗаконтрактованныеАвтомобили.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДополнительнаяИнформация КАК ДополнительнаяИнформация
	|		ПО ТаблицаАвтомобилей.Автомобиль = ДополнительнаяИнформация.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаявкиНаРезерв КАК ЗаявкиНаРезерв
	|		ПО ТаблицаАвтомобилей.Автомобиль = ЗаявкиНаРезерв.Автомобиль
	|ГДЕ
	|	(НЕ ОформленныеВыдачи.ОформленаВыдача
	|			ИЛИ ОформленныеВыдачи.ОформленаВыдача ЕСТЬ NULL )
	|	И (НЕ УтвержденныеРезервы.УтвержденРезерв
	|			ИЛИ УтвержденныеРезервы.УтвержденРезерв ЕСТЬ NULL )
	|	И (НЕ ДополнительнаяИнформация.НеДляПродажи
	|			ИЛИ ДополнительнаяИнформация.НеДляПродажи ЕСТЬ NULL )
	|	И (НЕ ЗаявкиНаРезерв.ЗаявленРезерв
	|			ИЛИ ЗаявкиНаРезерв.ЗаявленРезерв ЕСТЬ NULL )
	|	И (НЕ ЗаконтрактованныеАвтомобили.АвтомобильЗаконтрактован
	|			ИЛИ ЗаконтрактованныеАвтомобили.АвтомобильЗаконтрактован ЕСТЬ NULL )";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("МассивСкладовДилера", ДилерскийЦентр.СкладыДилера.ВыгрузитьКолонку("Склад"));
	
	ТЗРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗРезультат;
КонецФункции

Функция СоздатьНовыйТрафикОнлайнКонсультант(ОписаниеТаблица) Экспорт
	
	Описание = ОписаниеТаблица[0];
	ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(ЗаписьТрафик, Описание);
	ЗаписьТрафик.Период = ТекущаяДата();
	Идентификатор = Новый УникальныйИдентификатор();
	ЗаписьТрафик.Идентификатор = Идентификатор;
	ЗаписьТрафик.Обработан = Ложь;
	ЗаписьТрафик.Записать();
	Если (Описание.Клиент = Справочники.CRM_ПотенциальныеКонтрагенты.ПустаяСсылка())Или (Описание.Клиент = Неопределено) Тогда
		ЗаписьТрафик.Клиент = CRM_Сервер.СоздатьПотенциальногоКонтрагентаПоТрафику(ЗаписьТрафик.Идентификатор);
		ЗаписьТрафик.Записать();
	КонецЕсли;
	
	//Создадим типизированные колонки в ТЗ
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	CRM_ЗначенияРеквизитовТрафика.РеквизитТрафика КАК РеквизитТрафика,
	                      |	CRM_ЗначенияРеквизитовТрафика.ЗначениеРеквизита КАК ЗначениеРеквизита,
	                      |	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика
	                      |ИЗ
	                      |	РегистрСведений.CRM_ЗначенияРеквизитовТрафика КАК CRM_ЗначенияРеквизитовТрафика
	                      |ГДЕ
	                      |	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика ЕСТЬ NULL");
	РеквизитыТрафика = Запрос.Выполнить().Выгрузить();
	//Удалим "лишние записи" на всякий случай
	РеквизитыТрафика.Очистить();
	
	//Заполним реквизиты трафика
	
	//Логин клиента из онлайнконсультанта
	НовоеСвойство = РеквизитыТрафика.Добавить();
	НовоеСвойство.ИдентификаторТрафика = Идентификатор;
	НовоеСвойство.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.ОнлайнКонсультантЛогинКлиента;
	НовоеСвойство.ЗначениеРеквизита = Описание.ЛогинКлиента;

	//Запись в регистр
	НЗ = РегистрыСведений.CRM_ЗначенияРеквизитовТрафика.СоздатьНаборЗаписей();
	НЗ.Отбор.ИдентификаторТрафика.Установить(Идентификатор);
	НЗ.Прочитать();
	НЗ.Загрузить(РеквизитыТрафика);
	Нз.Записать();
	
	Возврат ЗаписьТрафик;
	
КонецФункции

Функция СформироватьСтруктуруОписанияТрафика() Экспорт
	
	 Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 0
	                       |	*
	                       |ИЗ
	                       |	РегистрСведений.Renault_Трафик КАК Renault_Трафик");
	ОписаниеТрафика = Запрос.Выполнить().Выгрузить();
	ОписаниеТрафика.Колонки.Добавить("Пол");
	ОписаниеТрафика.Колонки.Добавить("Телефон");					   
	ОписаниеТрафика.Колонки.Добавить("ЛогинКлиента");
	Возврат ОписаниеТрафика;
	
КонецФункции

Функция НайтиРабочийЛистПоТрафику(ИдентификаторТрафика) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ *
	                      |ИЗ
	                      |	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	                      |ГДЕ
	                      |	Renault_РабочиеЛисты.IDТрафика = &IDТрафика
	                      |	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ");
	Запрос.УстановитьПараметр("IDТрафика", ИдентификаторТрафика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		 Менеджер = РегистрыСведений.Renault_РабочиеЛисты.СоздатьМенеджерЗаписи();
		 ЗаполнитьЗначенияСвойств(Менеджер, Выборка);
		 Менеджер.Прочитать();
		 Если Менеджер.Выбран() Тогда
			 Возврат Менеджер;
		 Иначе
			 Возврат Неопределено;
		 КонецЕсли;
	 Иначе
		 Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

