Функция ПолучитьТекущийТарифНаАвтомобили(ДатаТарифа = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаТарифа) Тогда
		ДатаТарифа = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Renault_ТарифыНаАвтомобили.Ссылка
	               |ИЗ
	               |	Справочник.Renault_ТарифыНаАвтомобили КАК Renault_ТарифыНаАвтомобили
	               |ГДЕ
	               |	(Renault_ТарифыНаАвтомобили.Активен = ИСТИНА
	               |				И Renault_ТарифыНаАвтомобили.ОкончаниеДействия >= &ДатаТарифа
	               |			ИЛИ Renault_ТарифыНаАвтомобили.ОкончаниеДействия = &ПустаяДата)
	               |	И Renault_ТарифыНаАвтомобили.НачалоДействия <= &ДатаТарифа
	               |	И Renault_ТарифыНаАвтомобили.Активен = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Renault_ТарифыНаАвтомобили.НачалоДействия УБЫВ";
	Запрос.УстановитьПараметр("ДатаТарифа", ДатаТарифа);
	Запрос.УстановитьПараметр("ПустаяДата", Дата('00010101'));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Renault_ТарифыНаАвтомобили.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

