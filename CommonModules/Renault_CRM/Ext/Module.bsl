//</Функция>
//</Автодок>
//</xml>
//@-
Функция ПолучитьСписокБрендМарок() Экспорт
	
	//Первоначальная инициализация
	СписокМарок = Новый СписокЗначений;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	МаркаАвтомобиля.Ссылка
	|ИЗ
	|	Справочник.CRM_МаркаАвтомобиля КАК МаркаАвтомобиля
	|ГДЕ
	|	И МаркаАвтомобиля.ПометкаУдаления = ЛОЖЬ");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокМарок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокМарок;
	
КонецФункции // ПолучитьСписокБрендМарок()

