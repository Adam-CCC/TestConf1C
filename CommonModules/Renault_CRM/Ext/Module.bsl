Процедура Статистика_Установить(Этап, IDK, Ссылка = Неопределено, НомерЗаписи = 0, Дата = Неопределено, Модель = Неопределено, ДилерскийЦентр = Неопределено) Экспорт
	
	Запись = РегистрыСведений.Renault_СтатистикаВыполненияЭтаповПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = IDK;	
	Запись.ЭтапПродаж = Этап;
	Если Не ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		Запись.ДилерскийЦентр = ПолучитьДилерскийЦентрПоРабочемуЛисту(IDK);	
	Иначе
		Запись.ДилерскийЦентр = ДилерскийЦентр;
	КонецЕсли;
	Запись.Модель = Модель;
	Запись.Объект = Ссылка;
	Запись.НомерЗаписи = НомерЗаписи;
	Если ЗначениеЗаполнено(Дата) Тогда
		Запись.ДатаВыполнения = Дата;
	Иначе
		Запись.ДатаВыполнения = ТекущаяДата();
	КонецЕсли;
	Запись.Записать();
	
