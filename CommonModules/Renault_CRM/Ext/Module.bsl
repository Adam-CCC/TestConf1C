Функция ПолучитьОтделСотрудника(Сотрудник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел КАК Отдел
	               |ИЗ
	               |	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	               |ГДЕ
	               |	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник = &Сотрудник";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Отдел;
	Иначе
		Возврат Справочники.CRM_Отделы.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

////@+ Функция ПолучитьНомерСледующегоРабочегоЛиста()
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции="Экспорт"
//         ИнструкцииПрепроцессору=""
//         ДатаCоздания="16.04.2013 12:59:54" Автор="Окипний Андрей Евгеньевич">
// <Имя>ПолучитьНомерСледующегоРабочегоЛиста()</Имя>
//
// <Описание>
//  Получает последний номер из регистра Renault_РабочиеЛисты
// </Описание>
//
// </Параметры>
//  <!-- Без параметров -->
//
//  <Результат>
//  	<ИмяРезультата>СледующийИДК</ИмяРезультата>
//  	<ТипРезультата><!-- Укажите тип возвращаемого параметра --></ТипРезультата>
//  	<ОписаниеРезультата><!-- описание результата -->
//                 <!-- продолжение описания результата --></ОписаниеРезультата>
//  </Результат>
//</Функция>
//</Автодок>
//</xml>
//@-
Функция ПолучитьНомерСледующегоРабочегоЛиста() Экспорт
	
	//Первоначальная инициализация
	дц = ПолучитьДилерскийЦентрПользователя();
	
	Если дц.ИспользоватьПрефиксРЛ Тогда
		префикс = дц.ПрефиксРЛ;
		
		префиксНач = префикс * 1000000;
		префиксКон = (префикс + 1) * 1000000;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	CRMTrafic.IDK КАК IDK
			|ИЗ
			|	РегистрСведений.Renault_РабочиеЛисты КАК CRMTrafic
			|ГДЕ
			|	CRMTrafic.IDK >= &префиксНач
			|	И CRMTrafic.IDK < &префиксКон
			|
			|УПОРЯДОЧИТЬ ПО
			|	IDK УБЫВ";
			
		Запрос.УстановитьПараметр("префиксНач", префиксНач);
		Запрос.УстановитьПараметр("префиксКон", префиксКон);
		
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			СледующийИДК = ВыборкаДетальныеЗаписи.IDK +1;		
		Иначе
			СледующийИДК = префиксНач;
		КонецЕсли;;
		      		
	Иначе
		//Первоначальная инициализация
		СледующийИДК = 1; //нумерация с нуля не правильна
		
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	CRMTrafic.IDK КАК IDK
		                      |ИЗ
							  |	РегистрСведений.Renault_РабочиеЛисты КАК CRMTrafic
		                      |ГДЕ
		                      |	CRMTrafic.IDK < 1000000
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	IDK УБЫВ
		                      |АВТОУПОРЯДОЧИВАНИЕ");
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() тогда
			СледующийИДК = Выборка.IDK+1;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат СледующийИДК;
	
КонецФункции // ПолучитьНомерСледующегоРабочегоЛиста()

////@+ Функция ПроверитьНаличиеРабочегоЛиста(СледующийИДК)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции="Экспорт"
//         ИнструкцииПрепроцессору=""
//         ДатаCоздания="16.04.2013 13:12:52" Автор="Окипний Андрей Евгеньевич">
// <Имя>ПроверитьНаличиеРабочегоЛиста(СледующийИДК)</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>СледующийИДК</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//
//  <Результат>
//  	<ИмяРезультата>РезультатПроверкиРЛСуществует</ИмяРезультата>
//  	<ТипРезультата><!-- Укажите тип результата --></ТипРезультата>
//  	<ОписаниеРезультата><!-- описание результата -->
//                 <!-- продолжение описания результата --></ОписаниеРезультата>
//  </Результат>
//</Функция>
//</Автодок>
//</xml>
//@-
Функция ПроверитьНаличиеРабочегоЛиста(СледующийИДК) Экспорт
	
	//Первоначальная инициализация
	РезультатПроверкиРЛСуществует = неопределено;
	
	//Проверим следущий номер рабочего листа
	ЗапросПроверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	CRMTrafic.IDK КАК IDK,
	|	CRMTrafic.ДатаID КАК ДатаID
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК CRMTrafic
	|ГДЕ
	|	CRMTrafic.ДатаID МЕЖДУ &Нач И &Кон
	|	И CRMTrafic.IDK = &СледующийИДК
	|
	|УПОРЯДОЧИТЬ ПО
	|	IDK УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ");
	ЗапросПроверка.УстановитьПараметр("Нач",НачалоДня(ТекущаяДата()));
	ЗапросПроверка.УстановитьПараметр("Кон",КонецДня(ТекущаяДата()));
	ЗапросПроверка.УстановитьПараметр("СледующийИДК",СледующийИДК);
	
	Выборка = ЗапросПроверка.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		РезультатПроверкиРЛСуществует = Истина;
	Иначе
		РезультатПроверкиРЛСуществует = Ложь;
	КонецЕсли;
	
	Возврат РезультатПроверкиРЛСуществует;
	
КонецФункции // ПроверитьНаличиеРабочегоЛиста(СледующийИДК)

