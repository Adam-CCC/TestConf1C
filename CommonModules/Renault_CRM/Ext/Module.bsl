////@+ Функция ПолучитьДеревоКомментариев(ТаблицаКомментариев)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции="Экспорт"
//         ИнструкцииПрепроцессору=""
//         ДатаCоздания="16.05.2013 12:26:17" Автор="Окипний Андрей Евгеньевич">
// <Имя>ПолучитьДеревоКомментариев(ТаблицаКомментариев)</Имя>
//
// <Описание>
//  Формирует древовидную структуру комментариев
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>ТаблицаКомментариев</ИмяПараметра>
//  	<ТипПараметра>ТаблицаЗначений</ТипПараметра>
//  	<ОписаниеПараметра>Таблица - результат запроса по регистру CRM_Комментарии</ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//
//  <Результат>
//  	<ИмяРезультата>ДеревоКомментариев</ИмяРезультата>
//  	<ТипРезультата>ДеревоЗначений</ТипРезультата>
//  	<ОписаниеРезультата>ДеревоЗначений в котором комментарии сгруппированны по родителям</ОписаниеРезультата>
//  </Результат>
//</Функция>
//</Автодок>
//</xml>
//@-
Функция ПолучитьДеревоКомментариев(ТаблицаКомментариев) Экспорт
	
	//Первоначальная инициализация
	ДеревоКомментариев = Новый ДеревоЗначений;
	
	Для каждого Колонка из ТаблицаКомментариев.Колонки Цикл
		ДеревоКомментариев.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Для каждого строкаВыборки из ТаблицаКомментариев Цикл
		
		Если ЗначениеЗаполнено(СтрокаВыборки.ИдентификаторРодителя) тогда
			СтрокаРодителя = ДеревоКомментариев.Строки.Найти(СтрокаВыборки.ИдентификаторРодителя, "Идентификатор", Истина);
			
			Если СтрокаРодителя = Неопределено тогда
				НС = ДеревоКомментариев.Строки.Добавить();
				НС.Идентификатор = СтрокаВыборки.ИдентификаторРодителя;
				СтрокаРодителя = НС;
			КонецЕсли;
			
			НС = СтрокаРодителя.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НС, СтрокаВыборки);
			
		Иначе //пустой идентификатор
			СтрокаРодителя = ДеревоКомментариев.Строки.Найти(СтрокаВыборки.Идентификатор, "Идентификатор", Истина);
			
			Если СтрокаРодителя = Неопределено тогда
				НС = ДеревоКомментариев.Строки.Добавить();
				СтрокаРодителя = НС;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаРодителя, СтрокаВыборки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДеревоКомментариев;
	
КонецФункции // ПолучитьДеревоКомментариев(ТаблицаКомментариев)

////@+ Процедура ВывестиКомментарийРекурсивно(Таб, МакетКомментариев, КорневойКомментарий, УровеньВложения)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры="Экспорт"
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="16.05.2013 12:39:17" Автор="Окипний Андрей Евгеньевич">
// <Имя>ВывестиКомментарийРекурсивно(Таб, МакетКомментариев, КорневойКомментарий, УровеньВложения)</Имя>
//
// <Описание>
//  Рекурсивная процедура, выводящая комментарии в древовидном виде
// </Описание>
// <Параметры>
//  <Параметр> 
//  <ИмяПараметра>Таб</ИмяПараметра>
//  	<ТипПараметра>Табличный документ</ТипПараметра>
//  	<ОписаниеПараметра>В этот документ производится вывод макета комментариев</ОписаниеПараметра>
//  </Параметр>
//  <Параметр> 
//  <ИмяПараметра>МакетКомментариев</ИмяПараметра>
//  	<ТипПараметра>Макет</ТипПараметра>
//  	<ОписаниеПараметра>В этом макете хранится структура комментариев</ОписаниеПараметра>
//  </Параметр>
//  <Параметр>
//  <ИмяПараметра>КорневойКомментарий</ИмяПараметра>
//  	<ТипПараметра>СтрокаДереваЗначений</ТипПараметра>
//  	<ОписаниеПараметра>Данные коммментария</ОписаниеПараметра>
//  </Параметр>
//  <Параметр>
//  <ИмяПараметра>УровеньВложения</ИмяПараметра>
//  	<ТипПараметра>Число</ТипПараметра>
//  	<ОписаниеПараметра>Уровень комментария </ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//</Процедура>
//</Автодок>
//</xml>
//@-
Процедура ВывестиКомментарийРекурсивно(Таб, МакетКомментариев, КорневойКомментарий, УровеньВложения) Экспорт
	
	ОбластьМакета = МакетКомментариев.ПолучитьОбласть("Коммент_новый|КомментарийВерт");
	ОбластьМакета.Параметры.Заполнить(КорневойКомментарий);
	
	ОбластьОтступ = МакетКомментариев.ПолучитьОбласть("Коммент_новый|Отступ");
	
	ЕстьОтступ = Ложь;
	ВыводОтступаЕсть = Ложь;
	Если УровеньВложения > 1 тогда //Нужно вывести Отступ
		
		Для Сч = 2 по УровеньВложения Цикл
			ЕстьОтступ = Истина;
			Если ВыводОтступаЕсть тогда
				Таб.Присоединить(ОбластьОтступ, УровеньВложения);
			Иначе
				Таб.Вывести(ОбластьОтступ, УровеньВложения);
				ВыводОтступаЕсть = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ВыводОтступаЕсть тогда
			Таб.Присоединить(ОбластьМакета, УровеньВложения);
		Иначе
			Таб.Вывести(ОбластьМакета, УровеньВложения);
		КонецЕсли;
	Иначе
		Таб.Вывести(ОбластьМакета, УровеньВложения);
	КонецЕсли;
	
	
	
	УровеньВложенияПодчиненный = УровеньВложения + 1;
	Для Каждого строкаПодчиненныйКомментарий из КорневойКомментарий.Строки Цикл
		ВывестиКомментарийРекурсивно(Таб, МакетКомментариев, строкаПодчиненныйКомментарий, УровеньВложенияПодчиненный);
	КонецЦикла;
	
КонецПроцедуры // ВывестиКомментарийРекурсивно(Таб, МакетКомментариев, КорневойКомментарий, УровеньВложения)

Функция ПолучитьЗаписьТрафикаПоID(ID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ *
	               |ИЗ
	               |	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	               |ГДЕ
	               |	Renault_Трафик.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ID);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Запись = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Возврат Запись;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЗаписьЗадачиПоIDТрафика(ID) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ЗадачиПоТрафику.Период,
	               |	CRM_ЗадачиПоТрафику.ИдентификаторЗадачи,
	               |	CRM_ЗадачиПоТрафику.ТипЗадачи,
	               |	CRM_ЗадачиПоТрафику.Менеджер,
	               |	CRM_ЗадачиПоТрафику.ИдентификаторТрафика,
	               |	CRM_ЗадачиПоТрафику.Комментарий,
	               |	CRM_ЗадачиПоТрафику.Телефон,
	               |	CRM_ЗадачиПоТрафику.Обработано,
	               |	CRM_ЗадачиПоТрафику.Представление,
	               |	CRM_ЗадачиПоТрафику.Автор,
	               |	CRM_ЗадачиПоТрафику.КомментарийПриЗакрытии,
	               |	CRM_ЗадачиПоТрафику.ДатаВремяЗавершения
	               |ИЗ
	               |	РегистрСведений.CRM_ЗадачиПоТрафику КАК CRM_ЗадачиПоТрафику
	               |ГДЕ
	               |	CRM_ЗадачиПоТрафику.ИдентификаторТрафика = &ID";
	Запрос.УстановитьПараметр("ID", ID);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Запись = РегистрыСведений.CRM_ЗадачиПоТрафику.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Возврат Запись;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

