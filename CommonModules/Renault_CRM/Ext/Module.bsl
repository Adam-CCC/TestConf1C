////@+ Функция ПолучитьСписокОтделовЦентра()
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции="Экспорт"
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="15.04.2013 12:51:12" Автор="Окипний Андрей Евгеньевич">
// <Имя>ПолучитьСписокОтделовЦентра()</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
