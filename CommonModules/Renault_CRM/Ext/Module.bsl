
////@+ Функция ПолучитьСписокСотрудниковПоОтделу(Отдел)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции="Экспорт"
//         ИнструкцииПрепроцессору=""
//         ДатаCоздания="15.04.2013 13:31:24" Автор="Окипний Андрей Евгеньевич">
// <Имя>ПолучитьСписокСотрудниковПоОтделу(Отдел)</Имя>
//
// <Описание>
//  Получает список сотрудников, по указанному отделу
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>Отдел</ИмяПараметра>
//  	<ТипПараметра>СправочникСсылка.CRM_Отделы</ТипПараметра>
//  	<ОписаниеПараметра>Отдел, по которому необходимо получить список сотрудников</ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//
//  <Результат>
//  	<ИмяРезультата>СписокВыбора</ИмяРезультата>
//  	<ТипРезультата>СписокЗначений</ТипРезультата>
//  	<ОписаниеРезультата>Список значений, в котором содержаться сотрудники для выбора в списке</ОписаниеРезультата>
//  </Результат>
//</Функция>
//</Автодок>
//</xml>
//@-
Функция ПолучитьСписокСотрудниковПоОтделу(Отдел) Экспорт
	
	//Первоначальная инициализация
	СписокВыбора = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			CRM_ОтделыПодразделения.Подразделение КАК Подразделение
	|		ИЗ
	|			Справочник.CRM_Отделы.Подразделения КАК CRM_ОтделыПодразделения
	|		ГДЕ
	|			CRM_ОтделыПодразделения.Ссылка = &Отдел) КАК ПодразделенияОтдела
	|		ПО Сотрудники.Подразделение = ПодразделенияОтдела.Подразделение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			CRM_ОтделыДолжности.Должность КАК Должность
	|		ИЗ
	|			Справочник.CRM_Отделы.Должности КАК CRM_ОтделыДолжности
	|		ГДЕ
	|			CRM_ОтделыДолжности.Ссылка = &Отдел
	|			И CRM_ОтделыДолжности.Должность.ПометкаУдаления = ЛОЖЬ
	|			И CRM_ОтделыДолжности.ВыбиратьВСписки = ИСТИНА) КАК ДолжностиОтдела
	|		ПО Сотрудники.Должность = ДолжностиОтдела.Должность
	|ГДЕ
	|	Сотрудники.ФлагУволен = ЛОЖЬ
	|	И Сотрудники.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Отдел",Отдел);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции // ПолучитьСписокСотрудниковПоОтделу(Отдел)

