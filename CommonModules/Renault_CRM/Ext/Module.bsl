Функция	ПолучитьПредставлениеСотрудниковСоСтатусами(Список, ТаблицаСтатусы, ДилерскийЦентр) Экспорт
		
	Для Каждого Стр Из Список Цикл
		
		СтрокаСтатусы = ТаблицаСтатусы.Найти(Стр.Значение);
		
		Если СтрокаСтатусы <> Неопределено Тогда
			
			Если СтрокаСтатусы.АктивностьПользователя Тогда
				Активность = "Online";
				Если СтрокаСтатусы.ЗанятостьСотрудника = Перечисления.CRM_ЗанятостьСотрудника.Свободен Тогда
					Занятость = "Свободен";					
				Иначе
					Занятость = СтрокаСтатусы.ПричинаЗнаятостиСотрудника;
				КонецЕсли;
				
				Если ДилерскийЦентр.ИспользуетАвтосервис Тогда
					Если ЗначениеЗаполнено(СтрокаСтатусы.ПримерноеВремяОкончания) Тогда						
						Если СтрокаСтатусы.ПримерноеВремяОкончания > ТекущаяДата() Тогда							
							ОсвободитсяЧерез = (СтрокаСтатусы.ПримерноеВремяОкончания - ТекущаяДата())/60;						
							ЗаголовокКнопки = "(" + Активность + " / " + Занятость + ")" + Символы.ПС +  "Освободится через: " + Формат(ОсвободитсяЧерез, "ЧЦ=2; ЧДЦ=0") + " мин.";							
						Иначе							
							ЗаголовокКнопки = "(" + Активность + " / " + Занятость + ")" + Символы.ПС + "Операция задерживается.";							
						КонецЕсли;						
					Иначе						
						ЗаголовокКнопки = "(" + Активность + " / " + Занятость + ")";						
					КонецЕсли;					
				Иначе				
					ЗаголовокКнопки = "(" + Активность + " / " + Занятость + ")";				
				КонецЕсли;
				
			Иначе
				Активность = "Offline";
				ЗаголовокКнопки = "(" + Активность + ")";
			КонецЕсли;
			
			Стр.Представление = ""+Стр.Значение+" "+ЗаголовокКнопки;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат Список;
	
КонецФункции

Процедура Renault_CRM_СкорректироватьТелефонПоФорматуПриЗаписи(СтрокаИсточника)
	
	Телефон = CRM_Сервер.Renault_CRM_СкорректироватьТелефонПриЗаписи(СтрокаИсточника.Представление);
	
	Если Найти(Телефон, "+") Тогда
		Позиция = 2;
	Иначе
		Позиция = 1;
	КонецЕсли;
	
	Код = "+7";
	
	КодГорода = Сред(Телефон, Позиция + 1, 3);
	ТелефонБезКодов = Сред(Телефон, Позиция + 4, 7);
	
	Представление = Код + "(" + КодГорода + ")" + ТелефонБезКодов;
	Поле5 = Код + КодГорода + ТелефонБезКодов;
	
	СтрокаИсточника.Поле1 = Код;
	СтрокаИсточника.Поле2 = КодГорода;
	СтрокаИсточника.Поле3 = ТелефонБезКодов;
	СтрокаИсточника.Поле5 = Поле5;
	СтрокаИсточника.Представление = Представление;
		
КонецПроцедуры

#Область РаботаСДокументомРабочийЛист

// Возвращает рабочий лист по связанному IDK
//
// Параметры:
//  СвязаныйIDK	 - Строка	 - Значение связанного IDK
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_РабочийЛист - Связанный рабочий лист
//
Функция докПолучитьСвязанныйРабочийЛист(СвязаныйIDK) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочийЛист.Ссылка
	|ИЗ
	|	Документ.Renault_РабочийЛист КАК Renault_РабочийЛист
	|ГДЕ
	|	Renault_РабочийЛист.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", СвязаныйIDK);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ПолучитьСвязанныйРабочийЛист()

// Записывает реквизит IDK в рабочий лист
//
// Параметры:
//  РабочийЛистСсылка	 - ДокументСсылка.Renault_РабочийЛист	 - Ссылка на рабочий лист
//  IDK					 - Строка								 - IDK, записываемый в рабочий лист
//
Процедура докЗаписатьСвязанныйIDKРабочегоЛиста(РабочийЛистСсылка, IDK) Экспорт
	
	ДокументОбъект = РабочийЛистСсылка.ПолучитьОбъект();
	ДокументОбъект.СвязаныйIDK = IDK;
	ДокументОбъект.Записать();
	
КонецПроцедуры // ЗаписатьIDKРабочегоЛиста()

// Функция - Создать рабочий лист по трафику
//
// Параметры:
//  ID		 - Строка	 						- ID рабочего листа
//  Менеджер - СправочникСсылка.Сотрудники	 	- Сотрудник рабочего листа
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_РабочийЛист - Ссылка на созданный рабочий лист
//
Функция докСоздатьРабочийЛистПоТрафику(ID, Менеджер = Неопределено, ТипРабочегоЛиста = Неопределено) Экспорт

	ТекущийРЛ = докНайтиРабочийЛистПоТрафику(ID);
	Если (ТекущийРЛ = Неопределено) Тогда

		Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ID);
		Если Запись <> Неопределено Тогда

			//Отметим трафик как обработанный
			Запись.Обработан = Истина;
			Запись.Записать();

			Если Запись.ТипТрафика <> Справочники.CRM_ТипТрафика.ЛидRenault Тогда

				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				|	CRM_ЗначенияРеквизитовТрафика.РеквизитТрафика,
				|	CRM_ЗначенияРеквизитовТрафика.ЗначениеРеквизита
				|ИЗ
				|	РегистрСведений.CRM_ЗначенияРеквизитовТрафика КАК CRM_ЗначенияРеквизитовТрафика
				|ГДЕ
				|	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика = &ИдентификаторТрафика";
				Запрос.УстановитьПараметр("ИдентификаторТрафика", ID);
				ТаблицаРеквизитов = Запрос.Выполнить().Выгрузить();

			Иначе

				Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Запись.Клиент);
				Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Запись.Клиент);
				ТаблицаРеквизитов = Новый ТаблицаЗначений;
				ТаблицаРеквизитов.Колонки.Добавить("РеквизитТрафика", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.CRM_РеквизитыТрафика"));
				ТаблицаРеквизитов.Колонки.Добавить("ЗначениеРеквизита", Новый ОписаниеТипов("Строка"));
				Если ЗначениеЗаполнено(Телефон) Тогда 
					СтрокаТЗ = ТаблицаРеквизитов.Добавить();
					СтрокаТЗ.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Телефон;
					СтрокаТЗ.ЗначениеРеквизита = Телефон;
				КонецЕсли;
				Если ЗначениеЗаполнено(Email) Тогда 
					СтрокаТЗ = ТаблицаРеквизитов.Добавить();
					СтрокаТЗ.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Email;
					СтрокаТЗ.ЗначениеРеквизита = Email;
				КонецЕсли;

			КонецЕсли;

			СтрокаПол = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Пол);
			Если СтрокаПол = Неопределено Тогда
				Пол = Неопределено;
			Иначе
				Пол = СтрокаПол.ЗначениеРеквизита;
			КонецЕсли;
			
			СтрокаТелефон = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Телефон);
			Если СтрокаТелефон = Неопределено Тогда
				Телефон = Неопределено;
			Иначе
				Телефон = СтрокаТелефон.ЗначениеРеквизита;
			КонецЕсли;
			
			СтрокаEmail = ТаблицаРеквизитов.Найти(ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Email);
			Если СтрокаEmail = Неопределено Тогда
				Email = Неопределено;
			Иначе
				Email = СтрокаEmail.ЗначениеРеквизита; 
			КонецЕсли;
			
			//Создание рабочего листа
			СледующийИДК = докПолучитьНомерСледующегоРабочегоЛиста(Запись.ДилерскийЦентр);
			ЗаписьРЛ = Документы.Renault_РабочийЛист.СоздатьДокумент();
			ЗаписьРЛ.Дата = ТекущаяДата();
			ЗаписьРЛ.ID = СокрЛП(Новый УникальныйИдентификатор);
			ЗаписьРЛ.IDK = СледующийИДК;
			ЗаписьРЛ.ДатаID = ТекущаяДата();
			ЗаписьРЛ.Отдел = Запись.Отдел;
			ЗаписьРЛ.ДилерскийЦентр = Запись.ДилерскийЦентр;
			ЗаписьРЛ.МодельАвтомобиля = Запись.ПервичныйИнтерес.Модель;
			ЗаписьРЛ.ПервичныйИнтересМодель = Запись.ПервичныйИнтерес;
			ЗаписьРЛ.ТипТрафика = Запись.ТипТрафика;
			ЗаписьРЛ.IDТрафика = Запись.Идентификатор;
			Если Не ЗначениеЗаполнено(Менеджер) Тогда
				ЗаписьРЛ.Сотрудник = Запись.Менеджер;
			Иначе
				ЗаписьРЛ.Сотрудник = Менеджер;
			КонецЕсли;
			ЗаписьРЛ.ТипРабочегоЛиста = ТипРабочегоЛиста;
			
			РезультатПроверкиРЛСуществует = докПроверитьНаличиеРабочегоЛиста(СледующийИДК);
			
			Если РезультатПроверкиРЛСуществует Тогда
				
				Возврат докПолучитьЗаписьРЛПоIDK(СледующийИДК);
				
			Иначе
				
				ЗаписьРЛ.Записать();
				
				//Действия после записи РЛ
				
				//Добавим комментарий Администратора
				Если ЗначениеЗаполнено(Запись.Комментарий) Тогда
					ЗК             		= РегистрыСведений.CRM_Комментарии.СоздатьМенеджерЗаписи();
					ЗК.Дата        		= ТекущаяДата();
					ЗК.IDK         		= СледующийИДК;
					ЗК.Идентификатор 	= СокрЛП(Новый УникальныйИдентификатор);
					ЗК.ТекстКомментария = СокрЛП(Запись.Комментарий);
					ЗК.Автор	   		= Запись.Администратор;
					Зк.Записать();
				КонецЕсли;
				
				//Создадим потенциального клиента
				Клиент = CRM_Сервер.СоздатьПотенциальногоКонтрагентаПоТрафику(Запись.Идентификатор);
				
				//Сохраним потенциального контрагента в рабочем листе
				ЗаписьРЛ.Клиент = Клиент;
				ЗаписьРЛ.Записать();
				
				//Сохраним город из трафика
				ЗаписьКлиентскиеДанные = РегистрыСведений.CRM_КлиентскиеДанные.СоздатьМенеджерЗаписи();
				ЗаписьКлиентскиеДанные.Клиент = Клиент;
				ЗаписьКлиентскиеДанные.Прочитать();
				
				Если ЗаписьКлиентскиеДанные.Город = "" Тогда 
					ЗаписьКлиентскиеДанные.Город = Запись.Город;
					ЗаписьКлиентскиеДанные.Записать();
				КонецЕсли;
				
				//Сохраним потенциального контрагента в трафике
				Запись.Клиент = Клиент;
				Запись.Записать();
				
				//Если это посещение, необходимо отметить соответствующий этап продаж воронки
				Если Запись.ТипТрафика = Справочники.CRM_ТипТрафика.ПосещениеАвтосалона Тогда
					Renault_CRM.Воронка_ПосещениеАвтосалона_УстановитьСнять(ЗаписьРЛ.IDK);
					Renault_CRM.Статистика_УстановитьСнять(Справочники.CRM_ЭтапыПродаж.ПосещениеАвтосалона, ЗаписьРЛ.IDK);
				КонецЕсли;
				
				//Если есть телефон клиента - отметим выполнение этапа продаж, 
				//т.к. при создании клиента этого не произойдет (нет IDK)
				Если ЗначениеЗаполнено(Телефон) Тогда
					Renault_CRM.Воронка_НаличиеТелефона_Установить(СледующийИДК, Неопределено);
					Renault_CRM.Воронка_НаличиеКонтактов_Установить(СледующийИДК, Неопределено);
					Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеТелефона, СледующийИДК);
					Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеКонтактов, СледующийИДК);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Email) Тогда
					Renault_CRM.Воронка_НаличиеEmail_Установить(СледующийИДК, Неопределено);
					Renault_CRM.Воронка_НаличиеКонтактов_Установить(СледующийИДК, Неопределено);
					Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеEmail, СледующийИДК);
					Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.НаличиеКонтактов, СледующийИДК);
				КонецЕсли;
				
				Возврат ЗаписьРЛ.Ссылка;
				
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Возврат ТекущийРЛ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // СоздатьРабочийЛистПоТрафику()

// Возвращает существующий рабочий лист по ID трафика
//
// Параметры:
//  ИдентификаторТрафика - Строка	 - ID трафика
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_РабочийЛист, Неопределено - Ссылка на найденный рабочий лист
//
Функция докНайтиРабочийЛистПоТрафику(ИдентификаторТрафика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочийЛист.Ссылка
	|ИЗ
	|	Документ.Renault_РабочийЛист КАК Renault_РабочийЛист
	|ГДЕ
	|	Renault_РабочийЛист.IDТрафика = &IDТрафика
	|	И Renault_РабочийЛист.ЛистЗакрыт = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("IDТрафика", ИдентификаторТрафика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	 Иначе
		 Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // НайтиРабочийЛистПоТрафику()

// Возвращает номер следующего рабочего листа
// 
// Возвращаемое значение:
//  Строка - номер следующего рабочего листа
//
Функция докПолучитьНомерСледующегоРабочегоЛиста(дц = Неопределено) Экспорт
	
	// { DMSREN-629 Болдарев Д.Е. от 17.03.2020  
	Если дц = Неопределено Тогда
		//Первоначальная инициализация
		дц = Renault_CRM.ПолучитьДилерскийЦентрПользователя();	
	КонецЕсли; 
	// } DMSREN-629 Болдарев Д.Е. от 17.03.2020. 
	
	Если дц.ИспользоватьПрефиксРЛ Тогда
		префикс = дц.ПрефиксРЛ;
		
		префиксНач = префикс * 1000000;
		префиксКон = (префикс + 1) * 1000000;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRMTrafic.IDK КАК IDK
		|ИЗ
		|	Документ.Renault_РабочийЛист КАК CRMTrafic
		|ГДЕ
		|	CRMTrafic.IDK >= &префиксНач
		|	И CRMTrafic.IDK < &префиксКон
		|
		|УПОРЯДОЧИТЬ ПО
		|	IDK УБЫВ";
			
		Запрос.УстановитьПараметр("префиксНач", префиксНач);
		Запрос.УстановитьПараметр("префиксКон", префиксКон);
		
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			СледующийИДК = ВыборкаДетальныеЗаписи.IDK +1;		
		Иначе
			СледующийИДК = префиксНач + 1;
		КонецЕсли;;
		      		
	Иначе
		//Первоначальная инициализация
		СледующийИДК = 1; //нумерация с нуля не правильна
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRMTrafic.IDK КАК IDK
		|ИЗ
		|	Документ.Renault_РабочийЛист КАК CRMTrafic
		|ГДЕ
		|	CRMTrafic.IDK < 1000000
		|
		|УПОРЯДОЧИТЬ ПО
		|	IDK УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() тогда
			СледующийИДК = Выборка.IDK+1;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат СледующийИДК;
	
КонецФункции // докПолучитьНомерСледующегоРабочегоЛиста()

// Проверяет есть ли в базе рабочий лист по IDK
//
// Параметры:
//  СледующийИДК - Число	 - IDK для поиска
// 
// Возвращаемое значение:
//  Булево - Рабочий лист существует
//
Функция докПроверитьНаличиеРабочегоЛиста(СледующийИДК) Экспорт
	
	//Первоначальная инициализация
	РезультатПроверкиРЛСуществует = неопределено;
	
	//Проверим следущий номер рабочего листа
	ЗапросПроверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                              |	CRMTrafic.IDK КАК IDK,
	                              |	CRMTrafic.ДатаID КАК ДатаID
	                              |ИЗ
	                              |	Документ.Renault_РабочийЛист КАК CRMTrafic
	                              |ГДЕ
	                              |	CRMTrafic.ДатаID МЕЖДУ &Нач И &Кон
	                              |	И CRMTrafic.IDK = &СледующийИДК
	                              |
	                              |УПОРЯДОЧИТЬ ПО
	                              |	IDK УБЫВ
	                              |АВТОУПОРЯДОЧИВАНИЕ");
	ЗапросПроверка.УстановитьПараметр("Нач",НачалоДня(ТекущаяДата()));
	ЗапросПроверка.УстановитьПараметр("Кон",КонецДня(ТекущаяДата()));
	ЗапросПроверка.УстановитьПараметр("СледующийИДК",СледующийИДК);
	
	Выборка = ЗапросПроверка.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		РезультатПроверкиРЛСуществует = Истина;
	Иначе
		РезультатПроверкиРЛСуществует = Ложь;
	КонецЕсли;
	
	Возврат РезультатПроверкиРЛСуществует;
	
КонецФункции // ПроверитьНаличиеРабочегоЛиста(СледующийИДК)

// Получает существующий рабочий лист по IDK
//
// Параметры:
//  IDK	 - Число	 - IDK рабочего листа
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_РабочийЛист, Неопределено - Найденный рабочий лист
//
Функция докПолучитьЗаписьРЛПоIDK(IDK) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_РабочиеЛисты.Ссылка
	               |ИЗ
	               |	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
	               |ГДЕ
	               |	Renault_РабочиеЛисты.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", IDK);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // докПолучитьЗаписьРЛПоIDK()

#Если НаКлиенте Тогда
	
// Открывает форму документа "Renault_РабочийЛист"
//
// Параметры:
//  НомерРЛ	 - Число	 - IDK рабочего листа
//
Процедура докОткрытьФормуРЛ(НомерРЛ) Экспорт
	
	ДокументСсылка = Renault_CRM.докПолучитьЗаписьРЛПоIDK(НомерРЛ);	
	
	Если ДокументСсылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = ДокументСсылка.ПолучитьФорму();
	Форма.Открыть();
	
КонецПроцедуры // докОткрытьФормуРЛ()
	
#КонецЕсли

#КонецОбласти
