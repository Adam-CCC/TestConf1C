//Заменяем одного клиента на другого если нужно в контретном  объекте
Процедура ЗаменитьКлиентаНаКлиента(КлиентУдаляемый, Клиент, ОбъектыДляЗамены = Неопределено, ПомечатьНаУдаление = Истина)  Экспорт
	
	Попытка
		
		//КлиентОбъект = Клиент;
		ЗаполнитьНедостающиеРеквизиты(Клиент, КлиентУдаляемый);
		//Клиент = КлиентОбъект.Ссылка;
		//Если заменяем везде 
		Если ОбъектыДляЗамены = Неопределено Тогда
			ИскомыйОбъектСуществует(КлиентУдаляемый, Клиент, Ложь, ПомечатьНаУдаление);
		//Иначе только в списке объектов
		Иначе
			Для Каждого Ссылка ИЗ ОбъектыДляЗамены Цикл
				Если  ЭтоДокумент(Ссылка) Тогда
					Попытка 
						Запись = Ссылка.ПолучитьОбъект();
						ПроверитьИЗаполнитьРеквизиты(Запись.Метаданные().Реквизиты, Запись, КлиентУдаляемый, Клиент);
						Для Каждого ТабЧасть из Запись.Метаданные().ТабличныеЧасти цикл
							ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть,Запись, КлиентУдаляемый, Клиент);
						КонецЦикла;
						Если Запись.Проведен Тогда
							Попытка
								Запись.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
							Исключение
								Запись.Записать(РежимЗаписиДокумента.Запись);
							КонецПопытки;
						Иначе
							Запись.Записать(РежимЗаписиДокумента.Запись);
						КонецЕсли;
						
					Исключение
						//Сообщить(ОписаниеОшибки());
					КонецПопытки;
				ИначеЕсли  ЭтоСправочник(Ссылка) тогда
					
					Попытка 
						Запись = Ссылка.ПолучитьОбъект();
						ПроверитьИЗаполнитьРеквизиты(Запись.Метаданные().Реквизиты, Запись, КлиентУдаляемый, Клиент);
						Для Каждого ТабЧасть из Запись.Метаданные().ТабличныеЧасти цикл
							ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть, Запись, КлиентУдаляемый, Клиент);
						КонецЦикла;
						Запись.Записать();
						
					Исключение
						//Сообщить(ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	Исключение
		
	КонецПопытки;
КонецПроцедуры

//Проверка существования рабочего листа с задданым идк
Функция РлСуществует(РЛДубликаты, IDK, Клиент =  Неопределено, Телефон = "") Экспорт
	
	Ответ = Ложь;
	РЛДубликаты = Новый Массив();
	Попытка
		Если Не(Клиент = Неопределено) Тогда
			Запрос = Новый Запрос();
			ТекстЗапроса = "";
			ТекстЗапроса ="ВЫБРАТЬ РАЗЛИЧНЫЕ
			              |	Renault_РабочиеЛисты.IDK КАК НомерРЛ,
			              |	Renault_РабочиеЛисты.Клиент КАК Наименование,
			              |	Renault_РабочиеЛисты.Сотрудник КАК Менеджер,
			              |	Renault_РабочиеЛисты.ДатаID КАК ДатаСоздания,
			              |	&Телефон
			              |ИЗ
			              |	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
			              |ГДЕ
			              |	Renault_РабочиеЛисты.IDK <> &Идк
			              |	И Renault_РабочиеЛисты.Клиент = &Клиент
			              |	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ";
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Клиент",Клиент);
			Запрос.УстановитьПараметр("Период",ТекущаяДата());
            Запрос.УстановитьПараметр("Телефон",Телефон);
            Запрос.УстановитьПараметр("Идк", IDK);
			
			Результат = Запрос.Выполнить();
			Если Результат.Пустой() Тогда
				Ответ =  Ложь;
			Иначе
				Ответ =  Истина;
				Выгрузка = Результат.Выгрузить();
				Для Каждого ТекВыгрузка ИЗ Выгрузка Цикл
					Если РЛДубликаты.Найти(ТекВыгрузка) = Неопределено Тогда
						РЛДубликаты.Добавить(ТекВыгрузка);
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
				
	Исключение
		Опис = ОписаниеОшибки();
		Ответ = ложь;
	КонецПопытки;
	Возврат Ответ;
	
КонецФункции

 //аналагично замене клиента на клиента только для массива клиентов(КлиентыУдаляемые)
 Процедура ЗаменитьКлиентовНаКлиента(КлиентыУдаляемые, Клиент, ПомечатьНаУдаление = Истина) Экспорт
	 
