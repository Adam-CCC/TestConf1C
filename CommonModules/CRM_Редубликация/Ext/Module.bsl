
// Замена объектов на другой во всех местах, где имеются ссылки на заменяемый объект. 
// ИскомыйОбъект  - Объект который заменяем(Либо ссылка ибо массив ссылок на объекты)
//ОбъектНаЗамену - Объект который должны поставить на место ИскомыхОбъектов
//РежимТолькоПроверки  - Если истина  то функция только подтверждает наличие ссылок на искомые объекты
//ПомечатьНаУдаление - Если истина то замененые объекты помечаются на удаление
Функция ИскомыйОбъектСуществует(ИскомыйОбъект, ОбъектНаЗамену = Неопределено, РежимТолькоПроверки = Истина, ПомечатьНаУдаление = Истина) Экспорт
	
	Ответ = Ложь;
	//Если Есть что искать тогда
	Если ЗначениеЗаполнено(ИскомыйОбъект) Тогда
		МассивИскомыхСсылок = ИскомыйОбъект;
		//Создадим если необходимо массив с ссылками на искомые объекты
		Если Не (ТипЗнч(ИскомыйОбъект) = Тип ("Массив")) Тогда
			МассивИскомыхСсылок = новый Массив();
			МассивИскомыхСсылок.Добавить(ИскомыйОбъект);
		КонецЕсли;
		//Таблица ссылок на объекты где есть ссылки на искомые объекты
		ТаблицаСсылок = новый Массив;
		Если МассивИскомыхСсылок.Количество() > 0 Тогда
			ТаблицаСсылок = НайтиПоСсылкам(МассивИскомыхСсылок);
		КонецЕсли;
		ВсегоОб = ТаблицаСсылок.Количество();
		//Если не нужно заменять объекты
		Если  РежимТолькоПроверки  тогда
			Если ВсегоОб > 0 Тогда
				Ответ = истина;
			конецесли;
			//Иначе если есть на что заменять
		ИначеЕсли	НЕ(ОбъектНаЗамену =  Неопределено) Тогда
			Для Каждого ТекНайденныйОбъект Из ТаблицаСсылок Цикл
				//Для каждого найденного объекта в зависимости от принадлежности к группе метаданных 
				//выполняем Проверку и заполнение реквизитов где содржится искомый объект на объект замены
				Если ЭтоРегистрСведений(ТекНайденныйОбъект.метаданные) Тогда
					Запись = Неопределено;
					Итог = ПолучитьЗаписьИзРегистра(ТекНайденныйОбъект.Метаданные, ТекНайденныйОбъект.Данные, Запись);
					Если Итог тогда
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.Метаданные.Ресурсы, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.метаданные.Реквизиты, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.метаданные.Измерения, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						Попытка 
							Запись.Записать();
							
						Исключение
							Сообщить(ОписаниеОшибки());
						Конецпопытки;
					КонецЕсли;
									
				ИначеЕсли  ЭтоДокумент(ТекНайденныйОбъект.Метаданные)  Тогда
					Попытка 
						Запись = ТекНайденныйОбъект.Данные.ПолучитьОбъект();
						Запись.ОбменДанными.Загрузка = Истина;
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.Метаданные.Реквизиты, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						Для Каждого ТабЧасть из ТекНайденныйОбъект.Метаданные.ТабличныеЧасти цикл
							ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						КонецЦикла;
						Если Запись.Проведен Тогда
							Попытка
								Запись.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
							Исключение
								Запись.Записать(РежимЗаписиДокумента.Запись);
							КонецПопытки;
						Иначе
							Запись.Записать(РежимЗаписиДокумента.Запись);
						КонецЕсли;
						
						Запись.Записать();
						
					Исключение
						//Сообщить(ОписаниеОшибки());
					КонецПопытки;
					
					
				ИначеЕсли  ЭтоСправочник(ТекНайденныйОбъект.Метаданные) тогда
					
					Попытка 
						Запись = ТекНайденныйОбъект.Данные.ПолучитьОбъект();
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.Метаданные.Реквизиты, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						Для Каждого ТабЧасть из ТекНайденныйОбъект.Метаданные.ТабличныеЧасти цикл
							ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						КонецЦикла;
						Запись.Записать();
						
					Исключение
						//Сообщить(ОписаниеОшибки());
					КонецПопытки;
					
				КонецЕсли;
			КонецЦикла;
			//Если надо помечаем на удаление объекты
			Если ПомечатьНаУдаление Тогда
				Для Каждого ОбъектСсылка ИЗ МассивИскомыхСсылок Цикл
					Если Не(ОбъектСсылка.ПометкаУдаления)Тогда
						Попытка
							ТекОбъект  = ОбъектСсылка.ПолучитьОбъект();
							ТекОбъект.ПометкаУдаления = Истина;
							ТекОбъект.Записать();
						Исключение
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	
	Возврат Ответ;
	
Конецфункции

//Находит  изменяет все ссылки в реквизитах на ИскомыйОбъект в объекте запись на ОбъектНаЗамену ,КоллекцияРекв - метаданные записи
Процедура ПроверитьИЗаполнитьРеквизиты(КоллекцияРекв, Запись, ИскомыйОбъект, ОбъектНаЗамену)
	
	Для Каждого Реквизит Из КоллекцияРекв Цикл
		
		Если ТипЗнч(ИскомыйОбъект) = Тип("Массив") Тогда
			Для Каждого ИскОб из ИскомыйОбъект Цикл
				
				Если Реквизит.Тип.СодержитТип( типЗнч(ИскОб))Тогда
					Если Запись[Реквизит.Имя] = ИскОб Тогда
						Если Не(ОбъектНаЗамену = Неопределено) Тогда 
							Если Реквизит.Тип.СодержитТип( типЗнч(ОбъектНаЗамену.Ссылка))Тогда
								//Реквизит.Тип.привестиЗначение(ОбъектНаЗамену.Ссылка)
								//Запись[Реквизит.Имя] = ОбъектНаЗамену.Ссылка;
								Запись[Реквизит.Имя] = Реквизит.Тип.ПривестиЗначение(ОбъектНаЗамену.Ссылка);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;				
			КонецЦикла;			
		Иначе
			Если Реквизит.Тип.СодержитТип(типЗнч(ИскомыйОбъект))Тогда
				Если Запись[Реквизит.Имя] = ИскомыйОбъект Тогда
					Если Не(ОбъектНаЗамену = Неопределено) Тогда 
						Если Реквизит.Тип.СодержитТип( типЗнч(ОбъектНаЗамену.Ссылка))Тогда
							Запись[Реквизит.Имя] = Реквизит.Тип.ПривестиЗначение(ОбъектНаЗамену.Ссылка);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьИЗаполнитьВладельца(Запись, ИскомыйОбъект, ОбъектНаЗамену)
		
	Если Запись.Владелец = ИскомыйОбъект Тогда
		Запись.Владелец = ОбъектНаЗамену;
	КонецЕсли;
	
КонецПроцедуры

//Находит  изменяет все ссылки в реквизитах Табличной части на ИскомыйОбъект в объекте запись на ОбъектНаЗамену ,
//МетаТЧ - метаданные табличной части
Процедура ПроверитьИЗаполнитьРеквизитыТЧ(МетаТЧ, Запись, ИскомыйОбъект, ОбъектНаЗамену)
	
	Для Каждого СтрТЧ из Запись[МетаТЧ.Имя] Цикл
		ПроверитьИЗаполнитьРеквизиты(МетаТЧ.Реквизиты, СтрТЧ, ИскомыйОбъект, ОбъектНаЗамену);
	КонецЦикла;
	
КонецПроцедуры

//Получает запись регистра по ключу записи
Функция ПолучитьЗаписьИзРегистра(ДанныеПоРегистру, КлючЗаписи, Запись)
	
	Ответ = Ложь;
	Если ЗначениеЗаполнено(КлючЗаписи) И (Не КлючЗаписи.Пустой()) Тогда
		Если ПроверитьРегистрНаНезависимость(ДанныеПоРегистру) Тогда
			Запись = РегистрыСведений[ДанныеПоРегистру.Имя].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, КлючЗаписи);
			Попытка
				Запись.Прочитать();
				Ответ = Истина;
			Исключение
				Запись = Неопределено;
				Ответ = Ложь;
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

//Проверяет регистр является ли он Независимым
Функция ПроверитьРегистрНаНезависимость(МетДанные)
	
	Ответ = Ложь;
	Попытка
		Если (МетДанные.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый) Тогда
			Ответ = Истина;
		КонецЕсли;
	Исключение
		Ответ = Ложь;
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
	
КонецФункции

//Ищет и заменяет всех клиентов с одинаковыми номерами(или емаилами)
Процедура ПоискИЗаменаИдентичныхКлиентов (КлиентНаПроверку = Неопределено, Телефон="", ЕМаил="")  экспорт
	Запрос = Новый Запрос;
	МассивСсылок = Новый Массив();
	//если КлиентНАПроверку заполнен исключаем его из выбора в запросе
	Если (КлиентНаПроверку = Неопределено) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Представление ПОДОБНО &Представление";
	Иначе
		Запрос.УстановитьПараметр("Ссылка", КлиентНаПроверку.Ссылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект <> &Ссылка
		|	И КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Представление ПОДОБНО &Представление";
		
		
	КонецЕсли;
	//Заполняем необходимым образом параметры запроса и выполняем заполнения массива ссылок результатами выполнения запроса
	Если ЗначениеЗаполнено(Телефон) Тогда
		Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
		Запрос.УстановитьПараметр("Представление", Телефон);
		
		Выгрузка = Запрос.Выполнить().Выгрузить();
		Для Каждого Запись  ИЗ выгрузка Цикл
			Если  ДобавлятьСсылкуНаКлиента(КлиентНаПроверку,Запись.Объект) тогда
				МассивСсылок.Добавить(Запись.Объект);
			конецесли;
			
		конеццикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЕМаил) Тогда
		Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		Запрос.УстановитьПараметр("Представление", ЕМаил);
		
		Выгрузка = Запрос.Выполнить().Выгрузить();
		Для Каждого Запись  ИЗ выгрузка Цикл
			Если  ДобавлятьСсылкуНаКлиента(КлиентНаПроверку,Запись.Объект) Тогда
				МассивСсылок.Добавить(Запись.Объект);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	Удалить = Неопределено;
	ЗаменитьНа  = Неопределено;
	ПеребратьСсылки(КлиентНаПроверку,МассивСсылок,Удалить,ЗаменитьНа);
	Если НЕ( ЗаменитьНа = Неопределено) Тогда
		Для Каждого Найденные ИЗ Удалить Цикл
			ЗаполнитьНедостающиеРеквизиты(ЗаменитьНа,Найденные);
		КонецЦикла;
		
		ИскомыйОбъектСуществует(Удалить,ЗаменитьНа,Ложь);			
	КонецЕсли;
	
КонецПроцедуры

//Нужно ли заменять основного клиента из всех
Функция ДобавлятьСсылкуНаКлиента(КлиентПроверка,Запись)
	Ответ = Ложь;
	Если ТипЗнч( КлиентПроверка)=Тип("СправочникСсылка.Контрагенты") Тогда
		Если ТипЗнч(Запись) = Тип("СправочникСсылка.Контрагенты")  тогда
			Ответ = Истина;
		КонецЕсли;
		
	Иначе
		Ответ = Истина;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

//Перебрать все ссылки и выбрать главного клиента из всех найденных с одинаковой контактной информацией
Процедура ПеребратьСсылки(Проверка,МасСсылок,ОбъектыКУдалению,ОсновнойКлиент )
	Если Проверка = Неопределено Тогда 
		ОсновнойКлиент = Неопределено;
		ОбъектыКУдалению = Новый массив;
		Если МасСсылок.Количество()> 0 Тогда
			ТекКлиент = МасСсылок[0];
			Для Каждого Ссылк ИЗ МасСсылок Цикл
				Если НЕ (ТекКлиент = Ссылк) Тогда
					Если  (НЕ (ТипЗнч(ТекКлиент)=Тип("СправочникСсылка.Контрагенты"))) И (ТипЗнч(Ссылк)=Тип("СправочникСсылка.Контрагенты")) Тогда
						ОбъектыКУдалению.Добавить(ТекКлиент);
						ТекКлиент = Ссылк;
					Иначе
						ОбъектыКУдалению.Добавить(Ссылк);
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
			ОсновнойКлиент = ТекКлиент;
		КонецЕсли;
	Иначе
		ОбъектыКУдалению = Новый массив;
		Если МасСсылок.Количество()> 0 Тогда
			Для Каждого Ссылк ИЗ МасСсылок Цикл
				Если НЕ (Проверка = Ссылк) Тогда
					Если  (НЕ (ТипЗнч(Проверка)=Тип("СправочникСсылка.Контрагенты"))) И (ТипЗнч(Ссылк)=Тип("СправочникСсылка.Контрагенты")) Тогда
						//ОбъектыКУдалению.Добавить(Ссылк);
						Проверка = Ссылк;
					Иначе
						ОбъектыКУдалению.Добавить(Ссылк);
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
			ОсновнойКлиент = Проверка;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//Заполнить незаполненые реквизиты в объекте  из Удаляемогообъекта если надо по структуре сопастовления реквизитво между объектами
Процедура ЗаполнитьНедостающиеРеквизиты(Объект, УдаляемыйОбъект, СтруктураСопоставления = Неопределено, СохранятьОбъект = Истина) Экспорт
	
	МетОбъекта = Объект.Метаданные();
	МетУдаляемогоОбъекта = УдаляемыйОбъект.Метаданные();
	МассивРеквизитов = Новый Массив();
	ИскатьСоответсвия = Ложь;
	БылИзменен = Ложь;
	
	Если НЕ (СтруктураСопоставления = неопределено) Тогда
		////Если МассивСопоставления.Количество()> 0 Тогда
		ИскатьСоответсвия = Истина;
		//КонецЕсли;
	КонецЕсли;
	
	Для Каждого Реквизит ИЗ МетОбъекта.Реквизиты Цикл
		Если НЕ ЗначениеЗаполнено(Объект[Реквизит.Имя]) Тогда
			МассивРеквизитов.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит ИЗ МассивРеквизитов Цикл
		ИскомоеИмя = Реквизит;
		Если ИскатьСоответсвия Тогда
			Соответствие = "";
			Если СтруктураСопоставления.Свойство(Реквизит, Соответствие) = Истина Тогда
				ИскомоеИмя = Соответствие;
			КонецЕсли;
			
		КонецЕсли;
		Если НЕ(МетУдаляемогоОбъекта.Реквизиты.Найти(ИскомоеИмя) = Неопределено) Тогда
			Если ЗначениеЗаполнено(УдаляемыйОбъект[ИскомоеИмя])Тогда
				Объект[Реквизит] = УдаляемыйОбъект[ИскомоеИмя];
				БылИзменен = Истина;
			КонецЕсли;
			
		КонецЕсли;		
	КонецЦикла;
	
	Если ТипЗнч(Объект) = Тип("СправочникОбъект.Контрагенты") Тогда
		Если Не ЗначениеЗаполнено(Объект.ВидКонтрагента) Тогда
			Объект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.СогласиеНаОбработкуПерсональныхДанных) Тогда
			Объект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Спрашивать;
		КонецЕсли;
	КонецЕсли;
	
	Если БылИзменен и СохранятьОбъект Тогда
		Объект.УстановитьНовыйКод();
		Объект.Записать();
	КонецЕсли;
	
КонецПроцедуры

