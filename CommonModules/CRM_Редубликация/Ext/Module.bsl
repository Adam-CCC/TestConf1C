Процедура ПроизвестиЗаменуКлиентов(КлиентЗаменитьКого, КлиентЗаменитьНаКого, ВключитьОбъектыМассив = Неопределено, ИсключитьОбъектыМассив = Неопределено, Отказ = Ложь) Экспорт
	
	ПомечатьНаУдаление = Истина;
	
	Если ЗначениеЗаполнено(ВключитьОбъектыМассив) Тогда
		//Выполним замену только в указанных объектах
		//...
	КонецЕсли;
		
	Если Не ЗначениеЗаполнено(ИсключитьОбъектыМассив) Тогда
		ИсключитьОбъектыМассив = Новый Массив;
	КонецЕсли;
		
	ТаблицаСсылокОбъектовДляЗамены = НайтиСсылкиНаОбъект(КлиентЗаменитьКого);
	Если ТаблицаСсылокОбъектовДляЗамены.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого СтрокаСсылкаНаОбъектДляЗамены Из ТаблицаСсылокОбъектовДляЗамены Цикл
		
		Если ЭтоСправочник(СтрокаСсылкаНаОбъектДляЗамены.Метаданные) Тогда
			Если ИсключитьОбъектыМассив.Найти(СтрокаСсылкаНаОбъектДляЗамены.Данные.Ссылка) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ПроизвестиЗаменуСсылкиВОбъекте(КлиентЗаменитьКого, КлиентЗаменитьНаКого, СтрокаСсылкаНаОбъектДляЗамены, Отказ);
		
		// проведем поиск дублей основных контактов у нового клиента
		Если СтрокаСсылкаНаОбъектДляЗамены.Метаданные = Метаданные.РегистрыСведений.КонтактнаяИнформация Тогда
			
			Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(КлиентЗаменитьНаКого);
			Набор.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Телефон);
			Набор.Прочитать();
			Если Набор.Количество() > 1 Тогда
				Первый = Истина;
				Для Каждого Запись ИЗ Набор Цикл
					Если Запись.ЗначениеПоУмолчанию Тогда
						Если НЕ Первый Тогда
							Запись.ЗначениеПоУмолчанию = Ложь;
						КонецЕсли;
						Первый = Ложь;
					КонецЕсли;
				КонецЦикла;
				Набор.Записать();
			КонецЕсли;
			
			Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить(КлиентЗаменитьНаКого);
			Набор.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
			Набор.Прочитать();
			Если Набор.Количество() > 1 Тогда
				Первый = Истина;
				Для Каждого Запись ИЗ Набор Цикл
					Если Запись.ЗначениеПоУмолчанию Тогда
						Если НЕ Первый Тогда
							Запись.ЗначениеПоУмолчанию = Ложь;
						КонецЕсли;
						Первый = Ложь;
					КонецЕсли;
				КонецЦикла;
				Набор.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
				
	//Если надо помечаем на удаление объекты, которые заменяли
	Если ПомечатьНаУдаление Тогда
		
		Попытка
			ТекОбъект = КлиентЗаменитьКого.ПолучитьОбъект();
			ТекОбъект.ПометкаУдаления = Истина;
			ТекОбъект.Записать();
		Исключение
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		
	КонецЕсли;	
		
КонецПроцедуры

Функция НайтиСсылкиНаОбъект(СсылкаДляПоиска)
	
	//Приведем к массиву
	Если Не (ТипЗнч(СсылкаДляПоиска) = Тип ("Массив")) Тогда
		МассивИскомыхСсылок = Новый Массив();
		МассивИскомыхСсылок.Добавить(СсылкаДляПоиска);
	КонецЕсли;
	
	//Таблица ссылок на объекты где есть ссылки на искомые объекты
	ТаблицаСсылок = новый Массив;
	Если МассивИскомыхСсылок.Количество() > 0 Тогда
		МассивСсылок = НайтиПоСсылкам(МассивИскомыхСсылок);
	КонецЕсли;
	
	Возврат МассивСсылок;
		
КонецФункции

Процедура ПроизвестиЗаменуСсылкиВОбъекте(СсылкаЗаменитьКого, СсылкаЗаменитьНаКого, СтрокаСсылкаЗаменитьГде, Отказ = Ложь)
	
	Если ЭтоРегистрСведений(СтрокаСсылкаЗаменитьГде.Метаданные) Тогда
		
		Запись = Неопределено;
		УспешноПрочитано = ПолучитьЗаписьИзРегистра(СтрокаСсылкаЗаменитьГде.Метаданные, СтрокаСсылкаЗаменитьГде.Данные, Запись);
		Если УспешноПрочитано тогда
			
			ПроверитьИЗаполнитьРеквизиты(СтрокаСсылкаЗаменитьГде.Метаданные.Ресурсы, Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			ПроверитьИЗаполнитьРеквизиты(СтрокаСсылкаЗаменитьГде.Метаданные.Реквизиты, Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			ПроверитьИЗаполнитьРеквизиты(СтрокаСсылкаЗаменитьГде.Метаданные.Измерения, Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			Попытка 
				Запись.Записать();				
			Исключение
				Отказ = Истина;
				Возврат;
			Конецпопытки;
			
		КонецЕсли;
						
	ИначеЕсли ЭтоДокумент(СтрокаСсылкаЗаменитьГде.Метаданные) Тогда
		
		Попытка
		
			Запись = СтрокаСсылкаЗаменитьГде.Данные.ПолучитьОбъект();
			Запись.ОбменДанными.Загрузка = Истина;
			ПроверитьИЗаполнитьРеквизиты(СтрокаСсылкаЗаменитьГде.Метаданные.Реквизиты, Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			Для Каждого ТабЧасть из СтрокаСсылкаЗаменитьГде.Метаданные.ТабличныеЧасти цикл
				ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть, Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			КонецЦикла;
			
			Если Запись.Проведен Тогда
				Попытка
					Запись.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
				Исключение
					Запись.Записать(РежимЗаписиДокумента.Запись);
				КонецПопытки;
			Иначе
				Запись.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
		Исключение
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		
		
	ИначеЕсли ЭтоСправочник(СтрокаСсылкаЗаменитьГде.Метаданные) тогда
		
		Попытка 
			
			Запись = СтрокаСсылкаЗаменитьГде.Данные.ПолучитьОбъект();
			ПроверитьИЗаполнитьРеквизиты(СтрокаСсылкаЗаменитьГде.Метаданные.Реквизиты, Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			ПроверитьИЗаполнитьВладельца(Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			Для Каждого ТабЧасть Из СтрокаСсылкаЗаменитьГде.Метаданные.ТабличныеЧасти цикл
				ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть, Запись, СсылкаЗаменитьКого, СсылкаЗаменитьНаКого);
			КонецЦикла;
			Запись.Записать();
			
		Исключение
			Отказ = Истина;
			Возврат;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры
	
Функция НайтиСоздатьДоговорВзаиморасчетов(КонтрагентСсылка, Договор, ОдинаковыйНомер = Ложь) Экспорт
	
	Если ЗначениеЗаполнено(Договор.Организация) Тогда 
		
		ТекОрганизация  = Договор.Организация
		
	Иначе
		
		Если ЗначениеЗаполнено(ПараметрыСеанса.Организация) Тогда
			
			ТекОрганизация = ПараметрыСеанса.Организация;
			
		ИначеЕсли ЗначениеЗаполнено(ПараметрыСеанса.ПодразделениеКомпании) И ЗначениеЗаполнено(ПараметрыСеанса.ПодразделениеКомпании.Организация) Тогда
			
			ТекОрганизация = ПараметрыСеанса.ПодразделениеКомпании.Организация;
			
		ИначеЕсли ЗначениеЗаполнено(Справочники.ПодразделенияКомпании.ОсновноеПодразделение.Организация) Тогда
			
			ТекОрганизация = Справочники.ПодразделенияКомпании.ОсновноеПодразделение.Организация;
			
		Иначе
			
			ТекОрганизация = Справочники.Организации.ОсновнаяОрганизация;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВидДоговора = Перечисления.ВидыДоговоров.Продажа;
	Запрос = Новый Запрос("ВЫБРАТЬ
			                   |	ДоговорыВзаиморасчетов.Ссылка
			                   |ИЗ
			                   |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
			                   |ГДЕ
			                   |	ДоговорыВзаиморасчетов.Владелец = &Владелец
			                   |	И ДоговорыВзаиморасчетов.Организация = &Организация
			                   |	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора");
	Если ОдинаковыйНомер Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "	И ДоговорыВзаиморасчетов.НомерДоговора = &НомерДоговора";
		Запрос.УстановитьПараметр("НомерДоговора", Договор.НомерДоговора);
	КонецЕсли;
							   
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);			   
	Запрос.УстановитьПараметр("Владелец", КонтрагентСсылка);
	Запрос.УстановитьПараметр("Организация", ТекОрганизация);
	Результат = Запрос.Выполнить();
			
	Если Результат.Пустой() Тогда
		
		ДогОбъект = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		
		ДогОбъект.Владелец = КонтрагентСсылка;
		ДогОбъект.Организация = ТекОрганизация;
		ДогОбъект.ВидДоговора = Перечисления.ВидыДоговоров.Продажа;
		ДогОбъект.УстановитьНовыйКод();
		ДогОбъект.Подразделение = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
		ДогОбъект.ВидОплаты = Перечисления.ВидыОплаты.БезналичныйРасчет;
		ДогОбъект.ДатаНачала = НачалоГода(ТекущаяДата());
		ДогОбъект.ВалютаВзаиморасчетов = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
		ДогОбъект.Наименование = "Договор №" + ДогОбъект.Код + " с " + КонтрагентСсылка.Наименование;
		Если Метаданные.Справочники["ДоговорыВзаиморасчетов"].Реквизиты.Найти("ДляАвтосалона") <> Неопределено Тогда
			ДогОбъект.ДляАвтосалона = Истина;
		КонецЕсли;

		Если Метаданные.Справочники["ДоговорыВзаиморасчетов"].Реквизиты.Найти("ТипДоговора") <> Неопределено Тогда
  			ДогОбъект.ТипДоговора = Перечисления.ТипыДоговоров.Договор;
		КонецЕсли;
		
		Если ОдинаковыйНомер Тогда
			
			ДогОбъект.НомерДоговора = Договор.НомерДоговора;
			
		КонецЕсли;
		
		Если  Лев(СокрЛП(Метаданные.Версия), 1) = "4" Тогда
			
			ДогОбъект.СпособЗакрытияСделок = Перечисления.СпособЗакрытияСделок.ПоРасчетнымДокументам;
			
		КонецЕсли;
		ДогОбъект.ЕдиницаИзмеренияАвтоработВПечатныхФормах = обПраво("ЕдиницаИзмеренияАвтоработВПечатныхФормах"); // DMSREN-1228
		ДогОбъект.Записать();
		ДогСсылка = ДогОбъект.Ссылка;
		
	Иначе
		
		Выгрузка = Результат.Выгрузить();
		ДогСсылка = Выгрузка[0].Ссылка;
		
	КонецЕсли;
			
	Возврат  ДогСсылка;
	
КонецФункции
