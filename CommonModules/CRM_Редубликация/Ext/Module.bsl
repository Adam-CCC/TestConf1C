// Игорь Морозов 20.07.2018
Функция РазобратьНаименованиеПоФИО(НаименованиеКлиента) Экспорт
	
	ПромНаименование = НаименованиеКлиента;
	Рез = Новый Структура("Фамилия,Имя,Отчество","","","");
	Для Сч = 1 по 3 цикл
		НомерПробела = СтрНайти(ПромНаименование," ");
		Если НомерПробела = 0 тогда
			Если Сч = 1 тогда
				Рез.Фамилия = ПромНаименование;				
			ИначеЕсли Сч = 2 тогда
				Рез.Имя = ПромНаименование;				
			ИначеЕсли Сч = 3 тогда
				Рез.Отчество = ПромНаименование;				
			Иначе
				Возврат Рез;
			КонецЕСли;	
			Возврат Рез;
		Иначе
			Если Сч = 1 тогда
				Рез.Фамилия = Сред(ПромНаименование,1,НомерПробела-1);
			ИначеЕсли Сч = 2 тогда
				Рез.Имя = Сред(ПромНаименование,1,НомерПробела-1);
			ИначеЕсли Сч = 3 тогда
				Рез.Отчество = Сред(ПромНаименование,1,НомерПробела-1);
			КонецЕСли;	
			ПромНаименование = Сред(ПромНаименование,НомерПробела+1);
		КонецЕсли;	
	КонецЦикла;	
	Возврат Рез;	
КонецФункции	
// Игорь Морозов 20.07.2018>>

Функция СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(Клиент, Договор = Неопределено) Экспорт
	
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	Если ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		КаталогСозданияКонтрагентов = ДилерскийЦентр.КаталогСозданияКонтрагентов;
	Иначе
		КаталогСозданияКонтрагентов = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Клиент;
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	
	ЗаполнитьЗначенияСвойств(Контрагент, Клиент,, "Владелец, Родитель, Код"); 
	Контрагент.СогласиеНаПолучениеSMS = Клиент.СогласенНаКоммуникацию;
	// Игорь Морозов 20.07.2018
	//ЗаполнитьЗначенияСвойств(Контрагент, Клиент,"Фамилия, Имя ,Отчество"); 
	
	Если Не ЗначениеЗаполнено(Контрагент.Фамилия) и 
		Не ЗначениеЗаполнено(Контрагент.Имя) и 
		Не ЗначениеЗаполнено(Контрагент.Отчество) тогда
		ФИОКонтрагента = РазобратьНаименованиеПоФИО(Клиент.Наименование);
		ЗаполнитьЗначенияСвойств(Контрагент,ФИОКонтрагента);
	КонецЕсли;
	// Игорь Морозов 20.07.2018>>
	
	
	
	Контрагент.Родитель = КаталогСозданияКонтрагентов;
	
	//Дозаполним обязательные поля, если они не заполнены
	Контрагент.УстановитьНовыйКод();	
	
	Если Не ЗначениеЗаполнено(Контрагент.ВидКонтрагента) Тогда
		Контрагент.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контрагент.СогласиеНаОбработкуПерсональныхДанных) Тогда
		Контрагент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Спрашивать;
	КонецЕсли;
	
	Если не ЗначениеЗаполнено(Контрагент.ФормаСобственности) Тогда
		Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
	КонецЕсли;
	
	//поиск телефона клиента и перенос его в основной телефон контрагента
	Контрагент.ОсновнойТелефон = "_";
	Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Клиент);
	Набор.Прочитать();
	ТЗ = Набор.Выгрузить();
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		Если СтрокаТЗ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Контрагент.ОсновнойТелефон = СтрокаТЗ.Представление;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Контрагент.Записать();
	
	КлиентОб = Клиент.ПолучитьОбъект();
	КлиентОб.Контрагент = Контрагент.Ссылка;
	КлиентОб.Записать();
	
	//Если Договор <> Неопределено Тогда
	//	СоздатьДоговорКонтрагентаПокупателя(Контрагент.Ссылка,Договор);
	//КонецЕсли;
	
	// Переносим контактную информацию потенциального клиента
	Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(Клиент);
	Набор.Прочитать();
	ТЗ = Набор.Выгрузить();
	
	Набор.Отбор.Объект.Установить(Контрагент.Ссылка);
	Набор.Загрузить(ТЗ);
	Для Каждого Строка Из Набор Цикл
		Строка.Объект = Контрагент.Ссылка;
	КонецЦикла;
	Набор.Записать();
	
	//Изменим клиента в рабочем листе
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_РабочиеЛисты.Ссылка
	               |ИЗ
	               |	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
	               |ГДЕ
	               |	Renault_РабочиеЛисты.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьРЛ = Выборка.Ссылка.ПолучитьОбъект();
		Если ЗаписьРЛ <> Неопределено Тогда
			ЗаписьРЛ.Клиент = Контрагент.Ссылка;
			ЗаписьРЛ.Записать();
		КонецЕсли;
	КонецЦикла;

	//Изменим клиента в трафике
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_Трафик.Идентификатор
	               |ИЗ
	               |	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	               |ГДЕ
	               |	Renault_Трафик.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьТрафик = Renault_CRM.ПолучитьЗаписьТрафикаПоID(Выборка.Идентификатор);
		Если ЗаписьТрафик <> Неопределено Тогда
			ЗаписьТрафик.Клиент = Контрагент.Ссылка;
			ЗаписьТрафик.Записать();
		КонецЕсли;
	КонецЦикла;
	
	//Козлов Е.А. Начало 10.11.2016
	//Переносим данные подтверждающих документов 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Ссылка
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.Владелец = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Ссылка
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.Владелец = &ПотенциальныйКонтрагент
		|	И НЕ ПодтверждающиеДокументы.ПометкаУдаления"; 	
	Запрос.УстановитьПараметр("ПотенциальныйКонтрагент", Клиент);
	Запрос.УстановитьПараметр("Контрагент", Контрагент.Ссылка);	

	Результат = Запрос.ВыполнитьПакет();
	
	Если Результат[0].Пустой() Тогда
		Если НЕ Результат[1].Пустой() Тогда
			Выборка = Результат[1].Выбрать();

			Пока Выборка.Следующий() Цикл
				НовыйПодтДок = Выборка.Ссылка.Скопировать();
				НовыйПодтДок.Владелец = Контрагент.Ссылка;
				Если НЕ ЗначениеЗаполнено(НовыйПодтДок.Организация) Тогда
					НовыйПодтДок.Организация = ПараметрыСеанса.Организация;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(НовыйПодтДок.ВалютаДокумента) Тогда
					НовыйПодтДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить(); 
				КонецЕсли;
				НовыйПодтДок.Номер = Выборка.Ссылка.Номер;
				НовыйПодтДок.УстановитьНовыйКод();
				НовыйПодтДок.Записать();
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	//Козлов Е.А. Конец
	
	// Устанавливаем связь потенциального клиента с созданным контрагентом
	КлиентОбъект = Клиент.ПолучитьОбъект();
	КлиентОбъект.Контрагент = Контрагент.Ссылка;
	КлиентОбъект.Записать();
	
	ДокументСогласие = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ВернутьСогласиеПоКлиенту(Клиент);
	Если ЗначениеЗаполнено(ДокументСогласие) тогда
		ДокументОбъект = ДокументСогласие.получитьобъект();
		//КлиентОбъект.СогласиеНаПолучениеSMS = ДокументОбъект.
		ДокументОбъект.ФизическоеЛицо = Контрагент.Ссылка;
		ДокументОбъект.Записать();
	КонецЕсли;
	
	
	Возврат Контрагент.Ссылка;
		
КонецФункции

