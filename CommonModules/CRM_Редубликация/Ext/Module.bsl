//ищет существует ли номер и у кого он существует возврашается в КлиентыДубликаты
Функция НомерСуществует(Номер, КлиентыДубликаты, КлиентыИсключения = Неопределено) Экспорт
	// pu02028 #ИЗМ000001
	
	Если Номер = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Ответ = Ложь;
	КлиентыДубликаты = Новый Массив();
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "";
	Если КлиентыИсключения = неопределено Тогда
		ТекстЗапроса ="ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект,
		|	КонтактнаяИнформация.Представление КАК Телефон
		|ПОМЕСТИТЬ Вт
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Представление ПОДОБНО &Телефон";
	Иначе
		Если ТипЗнч(КлиентыИсключения) = Тип("Массив") Тогда
			ТекстЗапроса ="ВЫБРАТЬ
			|	КонтактнаяИнформация.Объект,
			|	КонтактнаяИнформация.Представление КАК Телефон
			|ПОМЕСТИТЬ Вт
			|ИЗ
			|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.Тип = &Тип
			|	И КонтактнаяИнформация.Представление ПОДОБНО &Телефон
			|	И НЕ (КонтактнаяИнформация.Объект В(&Объект))";
			
		иначе
			ТекстЗапроса ="ВЫБРАТЬ
			              |	КонтактнаяИнформация.Объект,
			              |	КонтактнаяИнформация.Представление КАК Телефон
			              |ПОМЕСТИТЬ Вт
			              |ИЗ
			              |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
			              |ГДЕ
			              |	КонтактнаяИнформация.Тип = &Тип
			              |	И ВЫБОР
			              |			КОГДА КонтактнаяИнформация.Поле1 <> """"
			              |					И КонтактнаяИнформация.Поле2 <> """"
			              |					И КонтактнаяИнформация.Поле3 <> """"
			              |				ТОГДА КонтактнаяИнформация.Поле1 + КонтактнаяИнформация.Поле2 + КонтактнаяИнформация.Поле3 ПОДОБНО &Телефон
			              |			ИНАЧЕ КонтактнаяИнформация.Представление ПОДОБНО &Телефон
			              |		КОНЕЦ
			              |	И НЕ КонтактнаяИнформация.Объект = &Объект";
		КонецЕсли;
		Запрос.УстановитьПараметр("Объект", КлиентыИсключения);
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса +
	";
	|
	|ВЫБРАТЬ
	|	Вт.Объект,
	|	Вт.Телефон,
	|	EMail.Представление КАК EMail,
	|	ВЫБОР КОГДА Вт.Объект ССЫЛКА Справочник.Контрагенты ТОГДА
	|		Контрагенты.ДатаРегистрации ИНАЧЕ CRM_КлиентскиеДанные.ДатаСоздания КОНЕЦ КАК ДатаСоздания
	|ИЗ Вт КАК Вт
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.КонтактнаяИнформация КАК EMail
	|	ПО EMail.Объект = Вт.Объект
	|	И EMail.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И EMail.ЗначениеПоУмолчанию = Истина
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанные
	|ПО
	|	CRM_КлиентскиеДанные.Клиент = Вт.Объект
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|ПО Контрагенты.Ссылка = Вт.Объект
	|УПОРЯДОЧИТЬ ПО
	|	ПОДСТРОКА(Вт.Телефон, 1, 30)";
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Телефон", "%" + Номер + "%");
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Ответ =  Ложь;
	Иначе
		Ответ =  Истина;
		Выгрузка = Результат.Выгрузить();
		Для Каждого ТекВыгрузка ИЗ Выгрузка Цикл
			Струк = Новый Структура();
			Струк.Вставить("Ссылка", ТекВыгрузка.Объект);
			Струк.Вставить("Телефон", ТекВыгрузка.Телефон);
			Струк.Вставить("EMail", ТекВыгрузка.EMail);
			Струк.Вставить("ДатаСоздания", ТекВыгрузка.ДатаСоздания);
			КлиентыДубликаты.Добавить(Струк);
		КонецЦикла;
		
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

