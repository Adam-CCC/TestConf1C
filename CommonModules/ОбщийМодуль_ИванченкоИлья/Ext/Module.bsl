Процедура ОбработкаПроверкиПочты() Экспорт
    // 1. Параметры почтового сервера
    ПараметрыПочты = Новый Структура;
    ПараметрыПочты.Вставить("Сервер", "imap.yandex.ru");
    ПараметрыПочты.Вставить("Порт", 993);
    ПараметрыПочты.Вставить("Пользователь", "ваша_почта@домен.ru");
    ПараметрыПочты.Вставить("Пароль", "ваш_пароль");
    ПараметрыПочты.Вставить("ИспользоватьSSL", Истина);
    ПараметрыПочты.Вставить("Протокол", "IMAP");
    
    // 2. Подключаемся к почтовому серверу
    Попытка
        Почта = Новый Почта;
        Почта.Подключить(ПараметрыПочты);
        
        // 3. Получаем список новых писем
        Почта.ВыбратьПисьма();
        КоличествоПисем = Почта.КоличествоПисем();
        
        Если КоличествоПисем = 0 Тогда
            Почта.Отключить();
            Возврат;
        КонецЕсли;
        
        // 4. Обрабатываем каждое письмо
        Для i = 1 По КоличествоПисем Цикл
            Письмо = Почта.ПолучитьПисьмо(i);
            ОбработатьВложенияПисьма(Письмо);
            
            // 5. Помечаем письмо как прочитанное (опционально)
            // Почта.ПометитьПисьмоПрочитанным(i);
        КонецЦикла;
        
        Почта.Отключить();
        
    Исключение
        ЗаписьЖурналаРегистрации("ОшибкаПодключенияПочты", 
            УровеньЖурналаРегистрации.Ошибка,,
            "Ошибка подключения к почте: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

