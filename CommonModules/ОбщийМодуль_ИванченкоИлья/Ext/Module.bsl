	|	КомплектацияАвтомобиляТовары.Номенклатура КАК Номенклатура,
	|	КомплектацияАвтомобиляТовары.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	КомплектацияАвтомобиляТовары.Сумма КАК СуммаТовары,
	|	КомплектацияАвтомобиляТовары.Количество КАК КоличествоТовары,
	|	КомплектацияАвтомобиляТовары.Коэффициент КАК Коэффициент,
	|	КомплектацияАвтомобиляТовары.Количество * КомплектацияАвтомобиляТовары.Коэффициент КАК КоличествоБазовое,
	|	АВТОНОМЕРЗАПИСИ() КАК Индекс
	|ПОМЕСТИТЬ ВТ_Рез
	|ИЗ
	|	Документ.КомплектацияАвтомобиля.Товары КАК КомплектацияАвтомобиляТовары
	|ГДЕ
	|	КомплектацияАвтомобиляТовары.Ссылка.Проведен
	|	И КомплектацияАвтомобиляТовары.Ссылка.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	|	И КомплектацияАвтомобиляТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ТекДата
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Индекс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Рез.КомплектацияАвтомобиляДата КАК КомплектацияАвтомобиляДата,
	|	ВТ_Рез.КомплектацияАвтомобиляНомер КАК КомплектацияАвтомобиляНомер,
	|	ВТ_Рез.ДилерскийЦентр КАК ДилерскийЦентр,
	|	ВТ_Рез.Номенклатура КАК Номенклатура,
	|	ВТ_Рез.НоменклатураАртикул КАК НоменклатураАртикул,
	|	ВТ_Рез.СуммаТовары КАК СуммаТовары,
	|	ВТ_Рез.КоличествоТовары КАК КоличествоТовары,
	|	ВТ_Рез.Коэффициент КАК Коэффициент,
	|	ВТ_Рез.КоличествоБазовое КАК КоличествоБазовое,
	|	ВТ_Рез.Индекс КАК Индекс
	|ИЗ
	|	ВТ_Рез КАК ВТ_Рез
	|
	|УПОРЯДОЧИТЬ ПО
	|	КомплектацияАвтомобиляДата";    
	
	Если МассивФайлов.Количество() = 0 Тогда
		Запрос.УстановитьПараметр("ДатаНачала", '20240101');   
		Текст = "";   		
	Иначе
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДата() - 86400)); 		
		ЧтениеТекста = Новый ЧтениеТекста;
		ЧтениеТекста.Открыть("\\1cserver\powerbi\service\komplekt.csv");
		Текст = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();				
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТекДата", КонецДня(ТекущаяДата() - 86400));   
	Выборка = Запрос.Выполнить().Выбрать();    
	Счетчик = 0;  
	ВременныйТекстовыйДокумент = Новый ТекстовыйДокумент;
	ВременныйТекстовыйДокумент.УстановитьТекст(Текст);	
	Сообщить("Всего записей: " + Выборка.Количество());
	
	Пока Выборка.Следующий() Цикл 
		
		Если Счетчик % 10000 = 0 Тогда
			Сообщить(Счетчик);
		КонецЕсли;
		
		СтрокаВыгрузки = 							
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Формат(Выборка.КомплектацияАвтомобиляДата, "ДЛФ=DT"))) + ";" + 	  
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Выборка.КомплектацияАвтомобиляНомер))	   				 + ";" +
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Выборка.ДилерскийЦентр))	   							 + ";" +	
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Выборка.Номенклатура))	   							 + ";" +	
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Выборка.НоменклатураАртикул))	  						 + ";" +	
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Формат(Выборка.СуммаТовары, "ЧН=0")))	  				 + ";" +
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Формат(Выборка.КоличествоТовары, "ЧН=0")))	  		 + ";" +	
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Формат(Выборка.Коэффициент, "ЧН=0")))	  				 + ";" +	
		СМ_ЧЕРИ_Сервер.ФорматироватьДляCSV(СокрЛП(Формат(Выборка.КоличествоБазовое, "ЧН=0")));		
		ВременныйТекстовыйДокумент.ДобавитьСтроку(СтрокаВыгрузки);
		Счетчик = Счетчик + 1;
	КонецЦикла;  
	
	Попытка
		ВременныйТекстовыйДокумент.Записать(ГдеСоздавать + МаскаФайла);
		Сообщить("Файл остатков успешно выгружен: " + ГдеСоздавать + МаскаФайла); 
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить("Не удалось записать файл: " + ГдеСоздавать + МаскаФайла + Символы.ПС + ТекстОшибки);
	КонецПопытки; 
	
