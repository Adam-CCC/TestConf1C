Процедура КаждыйДень() Экспорт		
	Запрос = Новый Запрос;
	Запрос.Текст = 		
	"ВЫБРАТЬ
	|	СМГ_РабочиеДниМастеровПриемщиков.Сервис КАК Сервис,
	|	СУММА(СМГ_РабочиеДниМастеровПриемщиков.КоличествоРабочихДней) КАК КоличествоРабочихДней
	|ПОМЕСТИТЬ ВТ_НачМес
	|ИЗ
	|	РегистрСведений.СМГ_РабочиеДниМастеровПриемщиков КАК СМГ_РабочиеДниМастеровПриемщиков
	|ГДЕ
	|	СМГ_РабочиеДниМастеровПриемщиков.Период = &НачалоМесяца
	|
	|СГРУППИРОВАТЬ ПО
	|	СМГ_РабочиеДниМастеровПриемщиков.Сервис
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СервисыПодразделения.Подразделение КАК Подразделение,
	|	СМГ_План_Выработки_Сотрудников_По_СервисамПланы_Сервисов.Сервис КАК Сервис,
	|	СМГ_План_Выработки_Сотрудников_По_СервисамПланы_Сервисов.План КАК План
	|ПОМЕСТИТЬ ВТ_Док
	|ИЗ
	|	Документ.СМГ_План_Выработки_Сотрудников_По_Сервисам.Планы_Сервисов КАК СМГ_План_Выработки_Сотрудников_По_СервисамПланы_Сервисов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сервисы.Подразделения КАК СервисыПодразделения
	|		ПО СМГ_План_Выработки_Сотрудников_По_СервисамПланы_Сервисов.Сервис = СервисыПодразделения.Ссылка
	|ГДЕ
	|	СМГ_План_Выработки_Сотрудников_По_СервисамПланы_Сервисов.Ссылка.ДатаНачалаМесяца = &НачалоМесяца
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	ВТ_Док.Сервис КАК Сервис,
	|	ВТ_Док.План КАК План
	|ПОМЕСТИТЬ ВТ_Сотрудники
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Док КАК ВТ_Док
	|		ПО (ВЫБОР
	|				КОГДА Сотрудники.Подразделение = ВТ_Док.Подразделение
	|					ТОГДА Сотрудники.Подразделение
	|				ИНАЧЕ Сотрудники.Подразделение.Родитель
	|			КОНЕЦ = ВТ_Док.Подразделение)
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|	И НЕ Сотрудники.ФлагУволен
	|	И Сотрудники.Должность = &Должность
	|	И Сотрудники.ДатаПриема <= &ТекДата
	|	И Сотрудники.Подразделение В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВТ_Док.Подразделение КАК Ссылка
	|			ИЗ
	|				ВТ_Док КАК ВТ_Док)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Сотрудники.Сотрудник КАК Сотрудник,
	|	ВТ_Сотрудники.Сервис КАК Сервис,
	|	ВТ_Сотрудники.План КАК План,
	|	КОЛИЧЕСТВО(ГрафикРаботКалендарный.Дата) КАК КоличествоРД
	|ПОМЕСТИТЬ ВТ_РДКалендарьТекДата
	|ИЗ
	|	ВТ_Сотрудники КАК ВТ_Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
	|		ПО ВТ_Сотрудники.Сотрудник.ГрафикРаботы = ГрафикРаботКалендарный.График
	|ГДЕ
	|	ГрафикРаботКалендарный.Дата МЕЖДУ &ТекДата И &КонецМесяца
	|	И ГрафикРаботКалендарный.ВидДня = &ВидДня
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Сотрудники.Сотрудник,
	|	ВТ_Сотрудники.Сервис,
	|	ВТ_Сотрудники.План
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РДКалендарьТекДата.Сотрудник КАК Сотрудник,
	|	ВТ_РДКалендарьТекДата.Сервис КАК Сервис,
	|	ГрафикРаботКалендарный.ВидДня КАК ВидДня
	|ПОМЕСТИТЬ ВТ_ВидДняТекДата
	|ИЗ
	|	ВТ_РДКалендарьТекДата КАК ВТ_РДКалендарьТекДата
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикРаботКалендарный КАК ГрафикРаботКалендарный
	|		ПО ВТ_РДКалендарьТекДата.Сотрудник.ГрафикРаботы = ГрафикРаботКалендарный.График
	|ГДЕ
	|	ГрафикРаботКалендарный.Дата = &ТекДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Сотрудники.Сотрудник КАК Сотрудник,
	|	ВТ_Сотрудники.Сервис КАК Сервис,
	|	ЕСТЬNULL(ВТ_РДКалендарьТекДата.КоличествоРД, РАЗНОСТЬДАТ(&ТекДата, &КонецМесяца, ДЕНЬ) + 1) КАК КоличествоРД,
	|	ЕСТЬNULL(ВТ_ВидДняТекДата.ВидДня, ЗНАЧЕНИЕ(Перечисление.ВидДня.Рабочий)) КАК ВидДня,
	|	ВТ_Сотрудники.План КАК План
	|ПОМЕСТИТЬ ВТ_ВидКолРДСотрудникиТекДата
	|ИЗ
	|	ВТ_Сотрудники КАК ВТ_Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РДКалендарьТекДата КАК ВТ_РДКалендарьТекДата
	|		ПО ВТ_Сотрудники.Сотрудник = ВТ_РДКалендарьТекДата.Сотрудник
	|			И ВТ_Сотрудники.Сервис = ВТ_РДКалендарьТекДата.Сервис
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВидДняТекДата КАК ВТ_ВидДняТекДата
	|		ПО ВТ_Сотрудники.Сотрудник = ВТ_ВидДняТекДата.Сотрудник
	|			И ВТ_Сотрудники.Сервис = ВТ_ВидДняТекДата.Сервис
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Сотрудники.Сотрудник КАК Сотрудник,
	|	ВТ_Сотрудники.Сервис КАК Сервис,
	|	ВТ_ВидКолРДСотрудникиТекДата.КоличествоРД КАК КоличествоРД,
	|	ВЫБОР
	|		КОГДА ВТ_ВидКолРДСотрудникиТекДата.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидДня.Рабочий)
	|			ТОГДА (ВТ_Сотрудники.План - ВТ_Сотрудники.План / ВТ_НачМес.КоличествоРабочихДней * (ВТ_НачМес.КоличествоРабочихДней - ВТ_ВидКолРДСотрудникиТекДата.КоличествоРД)) / ВТ_ВидКолРДСотрудникиТекДата.КоличествоРД
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ИндивидуальныйПлан
	|ИЗ
	|	ВТ_ВидКолРДСотрудникиТекДата КАК ВТ_ВидКолРДСотрудникиТекДата
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Сотрудники КАК ВТ_Сотрудники
	|		ПО ВТ_ВидКолРДСотрудникиТекДата.Сотрудник = ВТ_Сотрудники.Сотрудник
	|			И ВТ_ВидКолРДСотрудникиТекДата.Сервис = ВТ_Сотрудники.Сервис
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НачМес КАК ВТ_НачМес
	|		ПО ВТ_ВидКолРДСотрудникиТекДата.Сервис = ВТ_НачМес.Сервис";		
	
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ТекущаяДата()));  
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(ТекущаяДата())); 
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата()); 
	Запрос.УстановитьПараметр("Должность", Справочники.Должности.МастерПриемщик);
	Запрос.УстановитьПараметр("ВидДня", Перечисления.ВидДня.Рабочий);
	
	ВыгрузкаЗапроса = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = РегистрыСведений.СМГ_РабочиеДниМастеровПриемщиков.СоздатьНаборЗаписей(); 	
	
	Для каждого Строка Из ВыгрузкаЗапроса Цикл
		Новая_Запись 					   = НаборЗаписей.Добавить();
		Новая_Запись.Период 			   = ТекущаяДата();
		Новая_Запись.Сервис 			   = Строка.Сервис; 		
		Новая_Запись.Сотрудник 			   = Строка.Сотрудник;
		Новая_Запись.КоличествоРабочихДней = Строка.КоличествоРД;	
		Новая_Запись.ИндивидуальныйПлан	   = Строка.ИндивидуальныйПлан; 
	КонецЦикла;	
	
	НаборЗаписей.Записать(Ложь);  
	
КонецПроцедуры

//Галактионов ++ 27032025
Процедура РассылкаУволенныхСотрудников() Экспорт 
	
	Таблица = РегистрыСведений.СМГ_УволенныеСотрудникиСегодня.ПолучитьСписокНаВыгрузкуСегодня(ТекущаяДата());
	
	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	Таблица.Колонки.Добавить("GoogleАккаунт",Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ОсновнаяПочта",Новый ОписаниеТипов("Строка"));  
	
	МассивСоСтроками = Новый Массив; 
	СписокДолжностей = МассивДолжностей();
	
	Для Каждого Строка Из Таблица Цикл
		
		ПоискПоДолжности = СписокДолжностей.Найти(Строка.Сотрудник.Должность);
		
		Если ПоискПоДолжности = Неопределено Тогда
			МассивСоСтроками.Добавить(Строка);
			Продолжить;
		КонецЕсли;
		
		СтрокаГуглАккаунт   = киПолучитьПредставлениеКИ(Строка.Сотрудник,Справочники.ВидыКонтактнойИнформации.GoogleАккаунт);
		СтрокаОсновнаяПочта = киПолучитьПредставлениеКИ(Строка.Сотрудник,Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
		
		Если Не ЗначениеЗаполнено(СтрокаГуглАккаунт) И Не ЗначениеЗаполнено(СтрокаОсновнаяПочта)Тогда
			МассивСоСтроками.Добавить(Строка);
			Продолжить;
		Иначе
			Строка.GoogleАккаунт = СтрокаГуглАккаунт;
			Строка.ОсновнаяПочта = СтрокаОсновнаяПочта;
		КонецЕсли;				
	КонецЦикла; 
	
	Для Каждого Строка Из МассивСоСтроками Цикл	
		Таблица.Удалить(Строка)	
	КонецЦикла;
	
	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	ИтоговыйТекст = "Уволенные сотрудники сегодня (с Google аккаунтом и основной почтой):" + Символы.ПС;
	
	Для Каждого Строка Из Таблица Цикл	
		ИтоговыйТекст = ИтоговыйТекст + Строка.Сотрудник  
		+ Символы.ПС + "(Google) - " + ?(ЗначениеЗаполнено(Строка.GoogleАккаунт),Строка.GoogleАккаунт,"Нет") 
		+ Символы.ПС + "(Основная почта) - " + ?(ЗначениеЗаполнено(Строка.ОсновнаяПочта),Строка.ОсновнаяПочта,"Нет") + Символы.ПС;	
	КонецЦикла;
	
	ПолеВвода1 = ИтоговыйТекст;
	
	ПочтыДляОтправки = Новый Массив;
	ПочтыДляОтправки.Добавить("belikov_i@sokolmotors.ru");
	ПочтыДляОтправки.Добавить("seraya_t@sokolmotors.ru");
	ПочтыДляОтправки.Добавить("romanov_d@sokolmotors.ru");
	ПочтыДляОтправки.Добавить("galaktionov_vs@sokolmotors.ru");
	
	Тема = "Уволенные сотрудники " + Формат(ТекущаяДата(),"ДФ=дд.ММ.гггг"); 
	
	г_Функции.СоздатьИОтпраитьЭлПисьмо(ПочтыДляОтправки,"",Тема,ИтоговыйТекст,Документы.ЗаказНаряд.ПустаяСсылка());
	
КонецПроцедуры

Функция МассивДолжностей()
	
	Массив = Новый Массив;    
	
	Должности = Справочники.Должности; 
	
	Массив.Добавить(Должности.АдминистраторТорговогоЗала);
	Массив.Добавить(Должности.МенеджерОтделаПродажАвтомобилей);
	Массив.Добавить(Должности.МенеджерОтделаПродажАвтомобилейСПробегом);
	Массив.Добавить(Должности.РуководительОтделаПродажАвтомобилей);
	Массив.Добавить(Должности.РуководительОтделаПродажАвтомобилейСПробегом);
	
	Возврат Массив; 
	
КонецФункции
