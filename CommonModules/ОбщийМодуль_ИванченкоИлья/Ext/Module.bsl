    // Аналогично процедуре из Варианта 1,
    // но используем методы объекта Почта
    
    Если Письмо.КоличествоВложений = 0 Тогда
        Возврат;
    КонецЕсли;
    
    ПутьДляСохранения = "C:\1C\ВходящиеПисьма\";
    
    Для i = 1 По Письмо.КоличествоВложений Цикл
        Вложение = Письмо.ПолучитьВложение(i);
        
        ИмяФайла = Вложение.ИмяФайла;
        Если Прав(НРег(ИмяФайла), 5) <> ".xlsx" Тогда
            Продолжить;
        КонецЕсли;
        
        // ... сохранение и обработка файла
        // аналогично коду из Варианта 1
        
	КонецЦикла;
	
    КонецПроцедуры
