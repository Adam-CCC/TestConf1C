Функция ПолучитьТаблицуРабот(Заявка) Экспорт
	
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить("УникальныйИдентификатор");
	МассивТипов.Добавить("Неопределено");
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("CODE",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));   // Артикул работы
	ТаблицаДанных.Колонки.Добавить("NAME",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("ID_COMPANY",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));//Наименование
	ТаблицаДанных.Колонки.Добавить("ID_PARENT",Новый ОписаниеТипов(МассивТипов));     //  ссылка на родителя
	
	Для каждого Стр из Заявка.Работы Цикл
		
		ДобавитьРаботуВТаблицу(ТаблицаДанных,Стр.Работа, Заявка.ДилерскийЦентр);
		
	КонецЦикла;
	
	ТаблицаДанных.Свернуть("ID,CODE,NAME,ID_PARENT,ID_COMPANY");
	
	Возврат ТаблицаДанных;
	
