Функция ПолучитьПоследнююДатуИнтервьюVOC(BIR) Экспорт
	
	Рез = Дата(2015,12,1,0,0,0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	Renault_VOCКомментарииКлиента.ДатаОпроса КАК МаксДата
	               |ИЗ
	               |	РегистрСведений.Renault_VOCКомментарииКлиента КАК Renault_VOCКомментарииКлиента
	               |ГДЕ
	               |	Renault_VOCКомментарииКлиента.BIR = &BIR
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Renault_VOCКомментарииКлиента.ДатаОпроса УБЫВ";
	Запрос.УстановитьПараметр("BIR",BIR);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез = Выборка.МаксДата;
