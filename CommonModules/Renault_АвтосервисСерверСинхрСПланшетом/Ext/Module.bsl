Функция ПолучитьТаблицуЧастыхРабот(Приемка, Заявка);
	
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "";
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_КодировкиТО.АртикулРаботы КАК Артикул
	|ПОМЕСТИТЬ ТО
	|ИЗ
	|	РегистрСведений.Renault_КодировкиТО КАК Renault_КодировкиТО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 50
	|	Renault_ЧастоИспользуемыеРаботы.Авторабота КАК Авторабота,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Renault_ЧастоИспользуемыеРаботы.Авторабота.Комментарий КАК СТРОКА(100)), """") КАК Description,
	|	ЕСТЬNULL(Renault_ЧастоИспользуемыеРаботы.Авторабота.Наименование, """") КАК Name,
	|	СУММА(1) КАК КОЛИЧЕСТВО,
	|	СУММА(0) КАК Цена,
	|	МАКСИМУМ(ЕСТЬNULL(АвтоработыНормыВремени.ВремяВыполнения, Renault_ЧастоИспользуемыеРаботы.Авторабота.ВремяВыполнения)) КАК ВремяВыполнения
	|ИЗ
	|	РегистрНакопления.Renault_ЧастоИспользуемыеРаботы КАК Renault_ЧастоИспользуемыеРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТО КАК ТО
	|		ПО (ТО.Артикул = Renault_ЧастоИспользуемыеРаботы.Авторабота.Артикул)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Автоработы.НормыВремени КАК АвтоработыНормыВремени
	|		ПО Renault_ЧастоИспользуемыеРаботы.Авторабота = АвтоработыНормыВремени.Ссылка
	|			И Renault_ЧастоИспользуемыеРаботы.Модель = АвтоработыНормыВремени.Модель
	|ГДЕ
	|	Renault_ЧастоИспользуемыеРаботы.Модель = &Модель
	|	И ЕСТЬNULL(Renault_ЧастоИспользуемыеРаботы.Авторабота.Наименование, """") <> """"
	|	И НЕ Renault_ЧастоИспользуемыеРаботы.Авторабота В (&Исключаемые)
	|	И ТО.Артикул ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА &Пробег > 1
	|				ТОГДА Renault_ЧастоИспользуемыеРаботы.Пробег МЕЖДУ &Пробег - 5000 И &Пробег + 5000
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ГодВыпуска > 1
	|				ТОГДА Renault_ЧастоИспользуемыеРаботы.ГодВыпуска МЕЖДУ &ГодВыпуска - 1 И &ГодВыпуска + 1
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Renault_ЧастоИспользуемыеРаботы.Авторабота,
	|	ВЫРАЗИТЬ(Renault_ЧастоИспользуемыеРаботы.Авторабота.Комментарий КАК СТРОКА(100)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Renault_ЧастоИспользуемыеРаботы.Авторабота.Комментарий КАК СТРОКА(100)), """"),
	|	ЕСТЬNULL(Renault_ЧастоИспользуемыеРаботы.Авторабота.Наименование, """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	КОЛИЧЕСТВО УБЫВ";
	
	ТГодВыпуска = Год(Заявка.Автомобиль.ГодВыпуска);
	ТПробег = Renault_АвтосервисОбщий.Renault_ПолучитьПробег(Заявка.Автомобиль);
	
	Запрос.УстановитьПараметр("Пробег", ТПробег);
	Запрос.УстановитьПараметр("ГодВыпуска", ТГодВыпуска);
	Запрос.УстановитьПараметр("Модель", Заявка.Автомобиль.Модель);
	Запрос.УстановитьПараметр("Исключаемые", Заявка.Работы);
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаДанных.Колонки.Добавить("GUID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_WORK",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("OperationID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("Price",);
	ТаблицаДанных.Колонки.Добавить("ID_COMPANY");
	ТаблицаДанных.Колонки.Добавить("IS_ACTIVE");
	
	
	Для каждого стр из ТаблицаДанных Цикл
		Попытка
			Цена = стр.ВремяВыполнения * Приемка.ДилерскийЦентр.Автосервис_Нормочас.Цена;
		Исключение
			Цена = Приемка.ДилерскийЦентр.Автосервис_Нормочас.Цена;	
		КонецПопытки;
		
		стр.Price 		= Формат(Цена, "ЧДЦ=2; ЧРД=.; ЧГ=0");
		Если Цена=0 Тогда
			стр.Price = "0";
		КонецЕсли;
		стр.GUID 		= Новый УникальныйИдентификатор();
		стр.ID_WORK 	= стр.Авторабота.УникальныйИдентификатор();
		стр.OperationID = Приемка.УникальныйИдентификатор();
		стр.IS_ACTIVE 	= 1;
		стр.ID_COMPANY  = Приемка.ДилерскийЦентр.УникальныйИдентификатор();
	КонецЦикла;
	
	ТаблицаДанных.Колонки.Удалить("Авторабота");
	ТаблицаДанных.Колонки.Удалить("ВремяВыполнения");
	ТаблицаДанных.Колонки.Удалить("КОЛИЧЕСТВО");
	ТаблицаДанных.Колонки.Удалить("Цена");


	
	Возврат ТаблицаДанных;
	
КонецФункции



