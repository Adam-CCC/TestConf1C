Функция ПолучитьЦенуНоменклатурыТОП(Номенклатура,Заявка)  Экспорт
	
	Цены = Неопределено;
	Запрос = Новый Запрос();

	Если ЗначениеЗаполнено(Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен) И 
			Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен = Истина 
			  И значениеЗаполнено(Заявка.ЗаказНаряд) и ЗначениеЗаполнено(Заявка.ЗаказНаряд.ПодразделениеКомпании) Тогда
			  
		Запрос.Текст = "ВЫБРАТЬ
	               |	ЦеныСрезПоследних.Цена
	               |ИЗ
	               |	РегистрСведений.Цены.СрезПоследних(&ТекущаяДата, ) КАК ЦеныСрезПоследних
	               |ГДЕ
	               |	ЦеныСрезПоследних.ТипЦен = &ТипЦен
	               |	И ЦеныСрезПоследних.Номенклатура = &Номенклатура
	               |	И ВЫБОР
	               |			КОГДА &УчитыватьПодразделение
	               |				ТОГДА ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпании
	               |						ИЛИ ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпанииРодитель
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
		Запрос.УстановитьПараметр("ТипЦен", Заявка.ТипЦен);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("УчитыватьПодразделение", Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен);
		Запрос.УстановитьПараметр("ПодразделениеКомпании", Заявка.ЗаказНаряд.ПодразделениеКомпании);
		Запрос.УстановитьПараметр("ПодразделениеКомпанииРодитель", Заявка.ЗаказНаряд.ПодразделениеКомпании.Родитель);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		
		Цены = Запрос.Выполнить().Выгрузить();
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЦеныСрезПоследних.Цена
		               |ИЗ
		               |	РегистрСведений.Цены.СрезПоследних(&ТекущаяДата, ) КАК ЦеныСрезПоследних
		               |ГДЕ
		               |	ЦеныСрезПоследних.ТипЦен = &ТипЦен
		               |	И ЦеныСрезПоследних.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("ТипЦен", Заявка.ТипЦен);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		
		Цены = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Цены) Тогда
		Возврат Цены[0].Цена;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// ----------------------------------------------------------------------------------------
Функция ПолучитьСписокЗапчастейТОП(Заявка)  Экспорт
	
	тРезультат = Неопределено;
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТипЦен", Заявка.ТипЦен);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Модель", Заявка.Автомобиль.Модель);

	Если ЗначениеЗаполнено(Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен) И 
			Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен = Истина 
			  И значениеЗаполнено(Заявка.ЗаказНаряд) и ЗначениеЗаполнено(Заявка.ЗаказНаряд.ПодразделениеКомпании) Тогда
			  
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 50
		               |	Renault_ЧастоИспользуемыеЗапчасти.Номенклатура,
		               |	МИНИМУМ(Renault_ЧастоИспользуемыеЗапчасти.Количество) КАК МинКолво,
		               |	СУММА(1) КАК КОЛИЧЕСТВО,
		               |	СУММА(0) КАК Цена
		               |ПОМЕСТИТЬ т1
		               |ИЗ
		               |	РегистрНакопления.Renault_ЧастоИспользуемыеЗапчасти КАК Renault_ЧастоИспользуемыеЗапчасти
		               |ГДЕ
		               |	Renault_ЧастоИспользуемыеЗапчасти.Модель = &Модель
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	Renault_ЧастоИспользуемыеЗапчасти.Номенклатура
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	КОЛИЧЕСТВО УБЫВ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЦеныСрезПоследних.Номенклатура,
		               |	МАКСИМУМ(ЦеныСрезПоследних.Цена) КАК Цена
		               |ПОМЕСТИТЬ т2
		               |ИЗ
		               |	РегистрСведений.Цены.СрезПоследних(
		               |			&ТекущаяДата,
		               |			Номенклатура В
		               |					(ВЫБРАТЬ
		               |						т1.Номенклатура
		               |					ИЗ
		               |						т1 КАК т1)
		               |				И ТипЦен = &ТипЦен
		               |				И ВЫБОР
		               |					КОГДА &УчитыватьПодразделение
		               |						ТОГДА ПодразделениеКомпании = &ПодразделениеКомпании
		               |								ИЛИ ПодразделениеКомпании = &ПодразделениеКомпанииРодитель
		               |					ИНАЧЕ ИСТИНА
		               |				КОНЕЦ) КАК ЦеныСрезПоследних
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ЦеныСрезПоследних.Номенклатура
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	т1.Номенклатура,
		               |	т1.МинКолво,
		               |	т1.КОЛИЧЕСТВО,
		               |	ЕСТЬNULL(т2.Цена, 0) КАК Цена
		               |ИЗ
		               |	т1 КАК т1
		               |		ЛЕВОЕ СОЕДИНЕНИЕ т2 КАК т2
		               |		ПО (т2.Номенклатура = т1.Номенклатура)";
		   

		Запрос.УстановитьПараметр("УчитыватьПодразделение", Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен);
		Запрос.УстановитьПараметр("ПодразделениеКомпании", Заявка.ЗаказНаряд.ПодразделениеКомпании);
		Запрос.УстановитьПараметр("ПодразделениеКомпанииРодитель", Заявка.ЗаказНаряд.ПодразделениеКомпании.Родитель);
		
		
	Иначе
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 50
		               |	Renault_ЧастоИспользуемыеЗапчасти.Номенклатура,
		               |	МИНИМУМ(Renault_ЧастоИспользуемыеЗапчасти.Количество) КАК МинКолво,
		               |	СУММА(1) КАК КОЛИЧЕСТВО,
		               |	СУММА(0) КАК Цена
		               |ПОМЕСТИТЬ т1
		               |ИЗ
		               |	РегистрНакопления.Renault_ЧастоИспользуемыеЗапчасти КАК Renault_ЧастоИспользуемыеЗапчасти
		               |ГДЕ
		               |	Renault_ЧастоИспользуемыеЗапчасти.Модель = &Модель
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	Renault_ЧастоИспользуемыеЗапчасти.Номенклатура
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	КОЛИЧЕСТВО УБЫВ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЦеныСрезПоследних.Номенклатура,
		               |	МАКСИМУМ(ЦеныСрезПоследних.Цена) КАК Цена
		               |ПОМЕСТИТЬ т2
		               |ИЗ
		               |	РегистрСведений.Цены.СрезПоследних(
		               |			&ТекущаяДата,
		               |			Номенклатура В
		               |					(ВЫБРАТЬ
		               |						т1.Номенклатура
		               |					ИЗ
		               |						т1 КАК т1)
		               |				И ТипЦен = &ТипЦен) КАК ЦеныСрезПоследних
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ЦеныСрезПоследних.Номенклатура
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	т1.Номенклатура,
		               |	т1.МинКолво,
		               |	т1.КОЛИЧЕСТВО,
		               |	ЕСТЬNULL(т2.Цена, 0) КАК Цена
		               |ИЗ
		               |	т1 КАК т1
		               |		ЛЕВОЕ СОЕДИНЕНИЕ т2 КАК т2
		               |		ПО т1.Номенклатура = т2.Номенклатура";
				
	КонецЕсли;
	
	тРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат тРезультат;
	
КонецФункции

