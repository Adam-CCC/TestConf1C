Функция ПолучитьВебСервисПоПланшету() Экспорт
	
	НастройкаБренда = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	АдресWS	 = НастройкаБренда.АдресWsGate;
	ЛогинWS	 = НастройкаБренда.ЛогинДоступаКВебСервисам;
	ПарольWS = НастройкаБренда.ПарольДоступаКВебСервисам;
	
	//00180 Для бренда ЛАДА используется отдельный Гейт и отдельная прокси-база для планшета DMS Central
	Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
		АдресWS	 = НастройкаБренда.АдресWsCentral;
		ЛогинWS	 = НастройкаБренда.ЛогинWSCentral;
		ПарольWS = НастройкаБренда.ПарольWsCentral;
	КонецЕсли;
	//конец 00180
	
	//удалим определение документа wsdl - его добавляем автоматически
	Адрес = АдресWS +"ws/RenaultTab_v2.ws";
	Адрес = СтрЗаменить(Адрес, "?wsdl", "");
	
	Если Renault_ОбщегоНазначенияПовтИсп.Renault_Это83() Тогда
		
		ВЫПОЛНИТЬ("ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + ""?wsdl"",СокрЛП(ЛогинWS), СокрЛП(ПарольWS),,15)");
		
	Иначе
		
		ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
		СокрЛП(ЛогинWS), СокрЛП(ПарольWS),15);
		
	КонецЕсли;
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/RenaultTab_v2",ВСОпределение.Сервисы[0].Имя,ВСОпределение.Сервисы[0].ТочкиПодключения[0].Имя);     
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	Возврат ВебСервис;
	
КонецФункции

Функция ВыполнитьХранимуюПроцедуру (BIR,ВебСервис, сТаблицДанных, Команда) 
	
	Если сТаблицДанных.Количество()>0 Тогда
		
		СерТаблица = СериализаторXDTO.ЗаписатьXDTO(сТаблицДанных);
		сКлючевыеПоля = СериализаторXDTO.ЗаписатьXDTO(ПолучитьСтруктуруПолей(Команда));
		Итог = ВебСервис.CommandToSQL(BIR,СерТаблица, Команда, сКлючевыеПоля);
		
		Возврат Итог;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСтруктуруПолей (Команда)
	сПолей = Новый Структура;
	Если Команда = "dbo.RF_R_PRC_USERS_SYNC" Тогда
		
		сПолей.Вставить("DATA", "USER_TABLE_TYPE");
		
		
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_CLIENTS_SYNC" Тогда
		
		сПолей.Вставить("DATA", "CLIENT_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_WORKS_LIST_SYNC" Тогда
		
		сПолей.Вставить("DATA", "WORKS_LIST_ADD_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_PARTS_LIST_SYNC" Тогда
		
		сПолей.Вставить("DATA", "PARTS_LIST_TABLE_TYPE");		
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_COMPANY_SYNC" Тогда
		
		сПолей.Вставить("DATA", "COMPANY_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_DICTIONARIES_SYNC" Тогда
		
		сПолей.Вставить("BRANDS", "BRANDS_TABLE_TYPE");
		сПолей.Вставить("COLORS", "COLORS_TABLE_TYPE");
		сПолей.Вставить("ENGINES", "ENGINES_TABLE_TYPE");
		сПолей.Вставить("TRANSMISSIONS", "TRANSMISSIONS_TABLE_TYPE");
		сПолей.Вставить("PHASES", "PHASES_TABLE_TYPE");
		сПолей.Вставить("WHEEL_DRIVES", "WHEEL_DRIVES_TABLE_TYPE");
		сПолей.Вставить("PURCHASE_ORDER_TYPES", "PURCHASE_ORDER_TYPES_TABLE_TYPE");
		сПолей.Вставить("OPERATION_RECOMMENDATION_PRIORITY", "OPERATION_RECOMMENDATION_PRIORITY_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_MODEL_VERSION_SYNC" Тогда
		
		сПолей.Вставить("DATA_MODELS", "MODELS_TABLE_TYPE");
		сПолей.Вставить("DATA_VERSIONS", "VERSIONS_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_VEHICLES_SYNC" Тогда
		
		сПолей.Вставить("DATA", "VEHICLES_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_OPERATIONS_SYNC" Тогда
		
		сПолей.Вставить("DATA", "OPERATIONS_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_EMPLOYEE_SYNC" Тогда
		
		сПолей.Вставить("DATA", "EMPLOYEE_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_PURCHASE_ORDERS_SYNC" Тогда	
		сПолей.Вставить("DATA", 	  "PURCHASE_ORDER_TABLE_TYPE");
		сПолей.Вставить("DATA_PARTS", "PURCHASE_ORDER_PARTS_TABLE_TYPE");
		сПолей.Вставить("DATA_WORKS", "PURCHASE_ORDER_WORKS_TABLE_TYPE");
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_WORKS_SYNC" Тогда	
		сПолей.Вставить("DATA", 	  "WORKS_TABLE_TYPE");
		сПолей.Вставить("DATA_RATES", "WORK_RATES_TABLE_TYPE");
		сПолей.Вставить("DATA_PRICES","WORK_RATE_PRICES_TABLE_TYPE");
		сПолей.Вставить("DATA_APPLY", "WORK_APPLICABILITIES_TABLE_TYPE");
	ИначеЕсли Команда = "dbo.RF_R_PRC_PARTS_SYNC" Тогда	
		сПолей.Вставить("DATA", 	  "PARTS_TABLE_TYPE");
		сПолей.Вставить("DATA_PRICES","PART_PRICES_TABLE_TYPE");
		сПолей.Вставить("DATA_APPLY", "PART_APPLICABILITIES_TABLE_TYPE");
	ИначеЕсли Команда = "dbo.RF_R_PRC_OPERATION_RECOMMENDATIONS_SYNC" Тогда
		сПолей.Вставить("DATA", 	  "OPERATION_RECOMMENDATIONS_TABLE_TYPE");	
		
	ИначеЕсли Команда = "dbo.RF_R_PRC_PersonalOffers_SYNC" Тогда
		сПолей.Вставить("DATA", 	  "PersonalOffers_TABLE_TYPE");	
	//  новый тип	
	ИначеЕсли Команда = "dbo.RF_R_PRC_PersonalOffers_ORDERS_SYNC" Тогда
		сПолей.Вставить("DATA", 	  "PURCHASE_ORDER_PERSONAL_OFFERS_TABLE_TYPE");	
	
	ИначеЕсли Команда = "dbo.RF_R_PRC_VEHICLES__PROPERTIES_SYNC" Тогда
		сПолей.Вставить("DATA", 	  "VEHICLES_PROPERITIES_TABLE_TYPE");	
	ИначеЕсли Команда = "dbo.RF_R_TBL_OPERATION_OFFERS_SYNC" Тогда
		сПолей.Вставить("DATA", 	  "OPERATION_OFFERS_TYPE");	
	ИначеЕсли Команда = "dbo.RF_R_PRC_SYNC_BVM_TABLET" Тогда
		сПолей.Вставить("AUTOS", 	  "RF_R_TYPE_AUTO");	
		сПолей.Вставить("IS_INPUT",   "BIT");	
	КонецЕсли;
	
	
	Возврат сПолей;
	
КонецФункции

