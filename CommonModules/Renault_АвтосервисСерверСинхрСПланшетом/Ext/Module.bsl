Процедура ВыгрузитьЗаявкиНаСервисВПланшет(BIR, ВебСервис,СсылкаНаПриемку) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК Заявка
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
	|		ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ПриемкаАвтомобиля.Обращение
	|ГДЕ
	|	Renault_CRM_ПриемкаАвтомобиля.Ссылка = &СсылкаНаПриемку";
	
	Запрос.УстановитьПараметр("СсылкаНаПриемку", СсылкаНаПриемку);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ВыгрузитьРаботыИДеталиВПланшет(BIR, ВебСервис,Выборка.Заявка);
		
		ВыгрузитьЧастоИспользуемыеРаботы(BIR, ВебСервис,Выборка.Заявка,СсылкаНаПриемку);
		
		сТаблицОтправки = Новый Структура;
		сТаблицОтправки.Вставить("DATA",ПолучитьТаблицуШапкиЗаявкиНаСервис(Выборка.Заявка,СсылкаНаПриемку));
		сТаблицОтправки.Вставить("DATA_PARTS",ПолучитьТаблицуДеталейЗаявкиНаСервис(Выборка.Заявка));
		сТаблицОтправки.Вставить("DATA_WORKS",ПолучитьТаблицуРаботЗаявкиНаСервис(Выборка.Заявка));
		
		ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_PURCHASE_ORDERS_SYNC");
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьСправочникиВПланшет(ВебСервис,ДЦ = Неопределено) Экспорт
	
	ВыгрузитьМастеровПриемщиковВПланшет(ДЦ.BIR, ВебСервис);
	
	сТаблицОтправки = Новый Структура();
	сТаблицОтправки.Вставить("DATA_MODELS",ПолучитьТаблицуМоделей());
	сТаблицОтправки.Вставить("DATA_VERSIONS", ПолучитьТаблицуВерсий());
	ВыполнитьХранимуюПроцедуру(ДЦ.BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_MODEL_VERSION_SYNC");	
	
	сТаблицОтправки = Новый Структура("BRANDS,COLORS,ENGINES,TRANSMISSIONS,PHASES,WHEEL_DRIVES,PURCHASE_ORDER_TYPES");
	Если ДЦ = Неопределено Тогда //Выгружаем по всем дилерским центрам
		ВыборкаДЦ = Справочники.CRM_ДилерскиеЦентры.Выбрать();
		Пока ВыборкаДЦ.Следующий() Цикл
			ДЦ = ВыборкаДЦ.Ссылка;
			Если НЕ ДЦ.Автосервис_ИспользуетсяПланшет_v2 Тогда
				Продолжить;
			КонецЕсли;
			сТаблицОтправки.Вставить("BRANDS",ПолучитьТаблицуБрендов(ДЦ)); //@BRANDS BRANDS_TABLE_TYPE
			сТаблицОтправки.Вставить("COLORS",ПолучитьТаблицуЦветов(ДЦ));	 //@COLORS COLORS_TABLE_TYPE 
			сТаблицОтправки.Вставить("ENGINES",ПолучитьТаблицуДвигателей(ДЦ));	//@ENGINES ENGINES_TABLE_TYPE 
			сТаблицОтправки.Вставить("TRANSMISSIONS",ПолучитьТаблицуТрансмиссий(ДЦ));//@TRANSMISSIONS TRANSMISSIONS_TABLE_TYPE 
			сТаблицОтправки.Вставить("PHASES",ПолучитьТаблицуФаз(ДЦ)); //@PHASES PHASES_TABLE_TYPE 
			сТаблицОтправки.Вставить("WHEEL_DRIVES",ПолучитьТаблицуПриводовАвто(ДЦ)); //@WHEEL_DRIVES WHEEL_DRIVES_TABLE_TYPE
			сТаблицОтправки.Вставить("PURCHASE_ORDER_TYPES",ПолучитьТаблицуВидовРемонта(ДЦ)); //@PURCHASE_ORDER_TYPES PURCHASE_ORDER_TYPES_TABLE_TYPE
			сТаблицОтправки.Вставить("OPERATION_RECOMMENDATION_PRIORITY",Новый ТаблицаЗначений);
			ВыполнитьХранимуюПроцедуру(ДЦ.BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_DICTIONARIES_SYNC");
		КонецЦикла;
	Иначе // Выгружаем по одному дилеру
		сТаблицОтправки.Вставить("BRANDS",ПолучитьТаблицуБрендов(ДЦ)); //@BRANDS BRANDS_TABLE_TYPE
		сТаблицОтправки.Вставить("COLORS",ПолучитьТаблицуЦветов(ДЦ));	 //@COLORS COLORS_TABLE_TYPE READONLY,
		сТаблицОтправки.Вставить("ENGINES",ПолучитьТаблицуДвигателей(ДЦ));	//@ENGINES ENGINES_TABLE_TYPE READONLY,
		сТаблицОтправки.Вставить("TRANSMISSIONS",ПолучитьТаблицуТрансмиссий(ДЦ));//@TRANSMISSIONS TRANSMISSIONS_TABLE_TYPE 
		сТаблицОтправки.Вставить("PHASES",ПолучитьТаблицуФаз(ДЦ)); //@PHASES PHASES_TABLE_TYPE 
		сТаблицОтправки.Вставить("WHEEL_DRIVES",ПолучитьТаблицуПриводовАвто(ДЦ)); //@WHEEL_DRIVES WHEEL_DRIVES_TABLE_TYPE
		сТаблицОтправки.Вставить("PURCHASE_ORDER_TYPES",ПолучитьТаблицуВидовРемонта(ДЦ)); //@PURCHASE_ORDER_TYPES PURCHASE_ORDER_TYPES_TABLE_TYPE
		сТаблицОтправки.Вставить("OPERATION_RECOMMENDATION_PRIORITY", Новый ТаблицаЗначений);
		ВыполнитьХранимуюПроцедуру(ДЦ.BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_DICTIONARIES_SYNC");	
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьДатуСледующегоТО(Автомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ВыполнениеТОСрезПоследних.ДатаПлан
		|ИЗ
		|	РегистрСведений.Renault_ВыполнениеТО.СрезПоследних(
		|			,
		|			Автомобиль = &Автомобиль
		|				И ДатаФакт = ДАТАВРЕМЯ(1, 1, 1)) КАК Renault_ВыполнениеТОСрезПоследних";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ДатаПлан;
	КонецЦикла;
	
	Возврат Дата(1,1,1);

КонецФункции

Процедура ВыгрузитьОднуПриемкуВПланшет(ВебСервис,СсылкаНаПриемку)
	
	BIR = СсылкаНаПриемку.ДилерскийЦентр.BIR;
	
	ТаблицаДанных = Новый ТаблицаЗначений;	
	ТаблицаДанных.Колонки.Добавить("OperationID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ClientID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ClientID_Additional",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("Date",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("Automobile");
	ТаблицаДанных.Колонки.Добавить("Reason");
	ТаблицаДанных.Колонки.Добавить("Comments");
	ТаблицаДанных.Колонки.Добавить("StartTime",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("EndTime",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("Status",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(1)));
	ТаблицаДанных.Колонки.Добавить("EmployeeID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("CompanyID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_VEHICLE",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("TEMPORARY_SOLUTION");
	ТаблицаДанных.Колонки.Добавить("DATE_DELIVERY",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("CLIENT_STATE");
	ТаблицаДанных.Колонки.Добавить("DISCOUNT_CARD_NUMBER");
	ТаблицаДанных.Колонки.Добавить("DATE_NEXT_SERVICE");//,Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));

	
	СтрокаТз = ТаблицаДанных.Добавить();
	СтрокаТз.OperationID = СсылкаНаПриемку.УникальныйИдентификатор();
	СтрокаТз.ClientID = СсылкаНаПриемку.Клиент.УникальныйИдентификатор();
	
	ВладелецАвто = Renault_АвтосервисОбщий.Renault_ПолучитьВладельцаАвто(СсылкаНаПриемку.Автомобиль);
	//+/Блинков//В рамках заявки DMSREN-721
	Если ТипЗнч(ВладелецАвто) = Тип("Строка") Тогда 
		  ВладелецАвто = Неопределено;
	КонецЕсли;
    //-/Блинков//В рамках заявки DMSREN-721
	Если ВладелецАвто <> Неопределено и ВладелецАвто <> СсылкаНаПриемку.Клиент Тогда
		СтрокаТз.ClientID_Additional = ВладелецАвто.УникальныйИдентификатор();
		ВыгрузитьКлиентаВПланшет(BIR, ВебСервис,ВладелецАвто);
	Иначе
		СтрокаТз.ClientID_Additional = СсылкаНаПриемку.Клиент.УникальныйИдентификатор();
	КонецЕсли;
	
	
	СтрокаТз.Date = СсылкаНаПриемку.Дата;
	СтрокаТз.Automobile = ЛЕВ(СсылкаНаПриемку.Автомобиль.Наименование,50);
	СтрокаТз.Reason = СтрЗаменить(СсылкаНаПриемку.Обращение.Примечание, "\", "/");
	СтрокаТз.Comments =  СтрЗаменить(СсылкаНаПриемку.Примечание, "\", "/");
	СтрокаТз.StartTime = СсылкаНаПриемку.ВремяНачала;
	СтрокаТз.EndTime = СсылкаНаПриемку.ВремяОкончания;
	Если НЕ ЗначениеЗаполнено(СтрокаТз.StartTime) Тогда
		СтрокаТз.StartTime = СсылкаНаПриемку.Дата;
	КонецЕсли;                               		
	Если НЕ ЗначениеЗаполнено(СтрокаТз.EndTime) Тогда
		СтрокаТз.EndTime = СсылкаНаПриемку.Дата;
	КонецЕсли;
	
	СтрокаТз.Status = СсылкаНаПриемку.Состояние.ID;
	СтрокаТз.EmployeeID = СсылкаНаПриемку.Машиноместо.УникальныйИдентификатор();
	СтрокаТз.CompanyID = СсылкаНаПриемку.ДилерскийЦентр.УникальныйИдентификатор();
	СтрокаТз.ID_VEHICLE = СсылкаНаПриемку.Автомобиль.УникальныйИдентификатор();
	СтрокаТз.TEMPORARY_SOLUTION = "";
	СтрокаТз.DATE_DELIVERY = "";
	СтрокаТз.CLIENT_STATE = "";
	СтрокаТз.DISCOUNT_CARD_NUMBER = СокрЛП(Справочники.Renault_КартыЛояльности.НайтиПоРеквизиту("Контрагент",СсылкаНаПриемку.Клиент).Код);
	СтрокаТз.DATE_NEXT_SERVICE = Формат(ПолучитьДатуСледующегоТО(СсылкаНаПриемку.Автомобиль),"ДФ=yyyy-MM-dd");	

	
	сТаблицаОпераций = Новый Структура;
	сТаблицаОпераций.Вставить("DATA",ТаблицаДанных);
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицаОпераций,"dbo.RF_R_PRC_OPERATIONS_SYNC"); //ВыполнитьХранимуюПроцедуру_локально("dbo.RF_R_PRC_OPERATIONS_SYNC",сТаблицаОпераций)
	
	//Выгрузка пробега автомобиля
	СтруктПробег = Новый Структура;
	СтруктПробег.Вставить("Параметр","Пробег");
	СтруктПробег.Вставить("BIR",BIR);
	СтруктПробег.Вставить("Значение",Renault_АвтосервисОбщий.Renault_ПолучитьПробег(СсылкаНаПриемку.Автомобиль));
	СтруктПробег.Вставить("УИДПриемки",Строка(СсылкаНаПриемку.УникальныйИдентификатор()));
	ВебСервис.SetParam(СериализаторXDTO.ЗаписатьXDTO(СтруктПробег));
	
	ТаблицаДанныхИстории = Новый ТаблицаЗначений;
	ТаблицаДанныхИстории.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанныхИстории.Колонки.Добавить("ID_OPERATION",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанныхИстории.Колонки.Добавить("ID_OFFER",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанныхИстории.Колонки.Добавить("DATE_EXECUTION",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(Renault_КомплексСервисыАвторабот.Ссылка) КАК Комплекс,
	|	Renault_КомплексСервисыАвторабот.Авторабота,
	|	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка.Дата
	|ИЗ
	|	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис.Работы КАК Renault_CRM_ЗаявкаНаСервисРаботы
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_КомплексСервисыАвторабот КАК Renault_КомплексСервисыАвторабот
	|			ПО Renault_CRM_ЗаявкаНаСервисРаботы.Работа = Renault_КомплексСервисыАвторабот.Авторабота
	|		ПО Renault_CRM_ПриемкаАвтомобиля.Обращение = Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка.Обращение
	|ГДЕ
	|	НЕ Renault_КомплексСервисыАвторабот.Ссылка ЕСТЬ NULL 
	|	И Renault_CRM_ПриемкаАвтомобиля.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Renault_КомплексСервисыАвторабот.Авторабота,
	|	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка.Дата";
	Запрос.УстановитьПараметр("Ссылка",СсылкаНаПриемку);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Нов = ТаблицаДанныхИстории.Добавить();
		Нов.ID = Новый УникальныйИдентификатор;
		Нов.ID_OPERATION = СсылкаНаПриемку.УникальныйИдентификатор();
		Нов.ID_OFFER =  Новый УникальныйИдентификатор(Выборка.Комплекс.УИД);
		Нов.DATE_EXECUTION = Выборка.Дата;
	КонецЦикла;
	
	сТаблицаОпераций = Новый Структура;
	сТаблицаОпераций.Вставить("DATA",ТаблицаДанныхИстории);
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицаОпераций,"dbo.RF_R_TBL_OPERATION_OFFERS_SYNC");
	
	//Выгрузка рекомендованных работ по приемке
	
	ТаблицаДанных = Новый ТаблицаЗначений;	
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_OPERATION",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
	ТаблицаДанных.Колонки.Добавить("ID_PRIORITY",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(1)));
	ТаблицаДанных.Колонки.Добавить("DESCRIPTION",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(400)));
	ТаблицаДанных.Колонки.Добавить("DETERIORATION_PERCENT",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(5,2)));
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_СертификатКонтроля.Ссылка КАК СертификатКонтроля
	|ИЗ
	|	Документ.Renault_СертификатКонтроля КАК Renault_СертификатКонтроля
	|ГДЕ
	|	Renault_СертификатКонтроля.Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение", СсылкаНаПриемку.Обращение);
	ВыборкаСертификаты = Запрос.Выполнить().Выбрать();
	Если ВыборкаСертификаты.Следующий() Тогда
		
		// выведем работы по сертификату
		РаботыИзРегистра = ПолучитьРаботыИзРегистра(ВыборкаСертификаты.СертификатКонтроля);
		
		Для Каждого Стр ИЗ РаботыИзРегистра Цикл
			
			Если НЕ ЗначениеЗаполнено(стр.Работа) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			СтрокаТЗ = ТаблицаДанных.Добавить();
			СтрокаТЗ.ID = Новый УникальныйИдентификатор;
			
			Если ТипЗнч(Стр.Работа) = Тип("СправочникСсылка.Автоработы") Тогда
				СтрокаТЗ.DESCRIPTION  = стр.Работа.Наименование;
			иначе
				СтрокаТЗ.DESCRIPTION  = Строка(стр.Работа);
			КонецЕсли;
			
			СтрокаТЗ.ID_OPERATION = Строка(СсылкаНаПриемку.УникальныйИдентификатор());
			СтрокаТЗ.ID_PRIORITY  = ?(стр.Цвет = Перечисления.Renault_ЦветаСертификатаКонтроля.Красный,1,3);
			СтрокаТЗ.DETERIORATION_PERCENT = Стр.ПроцентИзноса;
			
		КонецЦикла;
		
		сТаблицаОпераций = Новый Структура;
		сТаблицаОпераций.Вставить("DATA",ТаблицаДанных);
		ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицаОпераций,"dbo.RF_R_PRC_OPERATION_RECOMMENDATIONS_SYNC");
	КонецЕсли;
	
	МенеджерЗаписей = РегистрыСведений.Renault_ОтправкаПриемкиВПланшет.СоздатьМенеджерЗаписи();
	МенеджерЗаписей.Приемка = СсылкаНаПриемку;
	МенеджерЗаписей.Отправлена = Истина;
	МенеджерЗаписей.ТекстОшибки = "";
	МенеджерЗаписей.Записать();
	
КонецПроцедуры

Функция ПолучитьРаботыИзРегистра(Сертификат) Экспорт
	
	ВыборкаРег = РегистрыСведений.Renault_ПоврежденияАвтомобилей.ВыбратьПоРегистратору(Сертификат);
	РаботыДокумента = Новый Массив;
	Пока ВыборкаРег.Следующий() Цикл
		РаботыДокумента.Добавить(ВыборкаРег.Работа);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Работа,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.РаботаАктуальна,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Важность,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Автомобиль,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.Цвет,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.РекомендуемаяДатаВыполнения,
	               |	Renault_ПоврежденияАвтомобилейСрезПоследних.ПроцентИзноса
	               |ИЗ
	               |	РегистрСведений.Renault_ПоврежденияАвтомобилей.СрезПоследних(
	               |			&Период,
	               |			РаботаАктуальна = ИСТИНА
	               |				И Автомобиль = &Автомобиль) КАК Renault_ПоврежденияАвтомобилейСрезПоследних";
	
	Запрос.УстановитьПараметр("Ссылка", Сертификат);
	Запрос.УстановитьПараметр("РаботыДокумента", РаботыДокумента);
	Запрос.УстановитьПараметр("Автомобиль", Сертификат.Автомобиль);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ВыгрузитьПриемкуВПланшет(СсылкаНаПриемку, Интерактивно = Ложь) Экспорт
	
	Попытка 
		BIR = СсылкаНаПриемку.ДилерскийЦентр.BIR;
		ВебСервис = ПолучитьВебСервисПоПланшету();
		
		ВыгрузитьКлиентаВПланшет(BIR, ВебСервис,СсылкаНаПриемку.Клиент);
		
		ВыгрузитьАвтомобильВПланшет(BIR, ВебСервис,СсылкаНаПриемку.Автомобиль, СсылкаНаПриемку.ДилерскийЦентр);
		
		ВыгрузитьМашиноместоВПланшет(BIR, ВебСервис,СсылкаНаПриемку.Машиноместо);
		
		ВыгрузитьМастеровПриемщиковВПланшет(BIR, ВебСервис,СсылкаНаПриемку.Машиноместо);

		ВыгрузитьОднуПриемкуВПланшет(ВебСервис,СсылкаНаПриемку);
		
		ВыгрузитьЗаявкиНаСервисВПланшет(BIR, ВебСервис,СсылкаНаПриемку);
		
		
		//Выгрузим 2 последних заявок на сервис для истории
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК Заявка,
		|	Renault_CRM_ПриемкаАвтомобиля.Ссылка КАК Приемка
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		|		ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ПриемкаАвтомобиля.Обращение
		|ГДЕ
		|	Renault_CRM_ПриемкаАвтомобиля.Ссылка <> &СсылкаНаПриемку
		|	И Renault_CRM_ЗаявкаНаСервис.Автомобиль = &Автомобиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Renault_CRM_ЗаявкаНаСервис.Дата УБЫВ";
		
		Запрос.УстановитьПараметр("СсылкаНаПриемку", СсылкаНаПриемку);
		Запрос.УстановитьПараметр("Автомобиль", СсылкаНаПриемку.Автомобиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		СписокВыгруженныхПриемок = Новый СписокЗначений;
		
		Пока Выборка.Следующий() Цикл
			
			ВыгрузитьРаботыИДеталиВПланшет(BIR, ВебСервис,Выборка.Заявка);
			Если СписокВыгруженныхПриемок.НайтиПоЗначению(Выборка.Приемка) = Неопределено Тогда
				ВыгрузитьОднуПриемкуВПланшет(ВебСервис,Выборка.Приемка);
				СписокВыгруженныхПриемок.Добавить(Выборка.Приемка);
			КонецЕсли;
			
			сТаблицОтправки = Новый Структура;
			сТаблицОтправки.Вставить("DATA",ПолучитьТаблицуШапкиЗаявкиНаСервис(Выборка.Заявка,Выборка.Приемка));
			сТаблицОтправки.Вставить("DATA_PARTS",ПолучитьТаблицуДеталейЗаявкиНаСервис(Выборка.Заявка));
			сТаблицОтправки.Вставить("DATA_WORKS",ПолучитьТаблицуРаботЗаявкиНаСервис(Выборка.Заявка));
			
			ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_PURCHASE_ORDERS_SYNC");
			
		КонецЦикла;
		
		// часто используемые работы и запчасти для расширения заказ-наряда (топ30)
		ВыгрузитьЧастоИспользуемыеРаботыТОП(BIR, ВебСервис, СсылкаНаПриемку);
		
	Исключение
		
		Ошибка = ОписаниеОшибки();
		МенеджерЗаписей = РегистрыСведений.Renault_ОтправкаПриемкиВПланшет.СоздатьМенеджерЗаписи();
		МенеджерЗаписей.Приемка = СсылкаНаПриемку;
		МенеджерЗаписей.Отправлена = Ложь;
		МенеджерЗаписей.ТекстОшибки = Ошибка;
		Попытка
			МенеджерЗаписей.Записать();
		Исключение
			Если Интерактивно Тогда
				Сообщить(ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
		Если Интерактивно Тогда
			Сообщить("" + Ошибка);
		Иначе
			ЗаписьЖурналаРегистрации("Renault_АвтосервисСерверСинхрСПланшетом.ВыгрузитьПриемкуВПланшет",УровеньЖурналаРегистрации.Ошибка,СсылкаНаПриемку.Метаданные(),СсылкаНаПриемку,Ошибка);
		КонецЕсли;
		
		
	КонецПопытки;
	
	
КонецПроцедуры

Процедура ВыгрузитьОтменуПриемкиВПланшет(СсылкаНаПриемку) Экспорт
	
	ВебСервис = ПолучитьВебСервисПоПланшету();
	BIR = СсылкаНаПриемку.ДилерскийЦентр.BIR;
	ТаблицаДанных = Новый ТаблицаЗначений;	
	ТаблицаДанных.Колонки.Добавить("OperationID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ClientID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ClientID_Additional",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("Date",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("Automobile");
	ТаблицаДанных.Колонки.Добавить("Reason");
	ТаблицаДанных.Колонки.Добавить("Comments");
	ТаблицаДанных.Колонки.Добавить("StartTime",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("EndTime",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("Status",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(1)));
	ТаблицаДанных.Колонки.Добавить("EmployeeID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("CompanyID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_VEHICLE",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("TEMPORARY_SOLUTION");
	ТаблицаДанных.Колонки.Добавить("DATE_DELIVERY",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("CLIENT_STATE");
	ТаблицаДанных.Колонки.Добавить("DISCOUNT_CARD_NUMBER");
	
	СтрокаТз = ТаблицаДанных.Добавить();
	СтрокаТз.OperationID = СсылкаНаПриемку.УникальныйИдентификатор();
	СтрокаТз.ClientID = СсылкаНаПриемку.Клиент.УникальныйИдентификатор();
	
	ВладелецАвто = Renault_АвтосервисОбщий.Renault_ПолучитьВладельцаАвто(СсылкаНаПриемку.Автомобиль);
	//+/Блинков//В рамках заявки DMSREN-721
	Если ТипЗнч(ВладелецАвто) = Тип("Строка") Тогда 
		  ВладелецАвто = ?(ЗначениеЗаполнено(ВладелецАвто),ВладелецАвто,Неопределено);
	КонецЕсли;
    //-/Блинков//В рамках заявки DMSREN-721
	Если ВладелецАвто <> Неопределено и ВладелецАвто <> СсылкаНаПриемку.Клиент Тогда
		СтрокаТз.ClientID_Additional = ВладелецАвто.УникальныйИдентификатор();
	Иначе
		СтрокаТз.ClientID_Additional = СсылкаНаПриемку.Клиент.УникальныйИдентификатор();
	КонецЕсли;
	
	
	СтрокаТз.Date = СсылкаНаПриемку.Дата;
	СтрокаТз.Automobile = СсылкаНаПриемку.Автомобиль.Наименование;
	СтрокаТз.Reason = СсылкаНаПриемку.Обращение.ВидОбращения.Наименование;
	СтрокаТз.Comments = СсылкаНаПриемку.Примечание;
	СтрокаТз.StartTime = Дата(2001,1,1);
	СтрокаТз.EndTime =  Дата(2001,1,1);
	СтрокаТз.Status = СсылкаНаПриемку.Состояние.ID;
	СтрокаТз.EmployeeID = СсылкаНаПриемку.Машиноместо.УникальныйИдентификатор();
	СтрокаТз.CompanyID = СсылкаНаПриемку.ДилерскийЦентр.УникальныйИдентификатор();
	СтрокаТз.ID_VEHICLE = СсылкаНаПриемку.Автомобиль.УникальныйИдентификатор();
	СтрокаТз.TEMPORARY_SOLUTION = "";
	СтрокаТз.DATE_DELIVERY = "";
	СтрокаТз.CLIENT_STATE = "";
	СтрокаТз.DISCOUNT_CARD_NUMBER = СокрЛП(Справочники.Renault_КартыЛояльности.НайтиПоРеквизиту("Контрагент",СсылкаНаПриемку.Клиент).Код);
	сТаблицаОпераций = Новый Структура;
	сТаблицаОпераций.Вставить("DATA",ТаблицаДанных);
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицаОпераций,"dbo.RF_R_PRC_OPERATIONS_SYNC");
	
	
КонецПроцедуры

Функция ПолучитьКартинкиПоврежденийПоЗаявкеВ1с(СсылкаНаЗаявку) Экспорт
	
		
	КартинкиЗаявки = Новый Массив();

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КартинкиИФайлы.Идентификатор КАК КодЭлемента,
		|	Renault_КартинкиИФайлы.Данные КАК Картинка
		|ИЗ
		|	РегистрСведений.Renault_КартинкиИФайлы КАК Renault_КартинкиИФайлы
		|ГДЕ
		|	Renault_КартинкиИФайлы.Картинка = Истина
		|	И Renault_КартинкиИФайлы.Объект = &Объект";
	
	Запрос.УстановитьПараметр("Объект",СсылкаНаЗаявку);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекКартинка = Новый Картинка(ВыборкаДетальныеЗаписи.Картинка.Получить());
		КартинкаКВозврату = Новый структура();
		КартинкаКВозврату.Вставить("Картинка", ТекКартинка);
		КартинкаКВозврату.Вставить("КодЭлемента", ВыборкаДетальныеЗаписи.КодЭлемента);
		КартинкиЗаявки.Добавить(КартинкаКВозврату);
	КонецЦикла;
	
	Возврат КартинкиЗаявки;
	
КонецФункции

//Выгрузка Данных Из 1с

Функция ЗагрузитьКомплексыИзПланшета(BIR,ВебСервис,СсылкаНаПриемку)
	
	Заявка = Документы.Renault_CRM_ЗаявкаНаСервис.НайтиПоРеквизиту("Обращение", СсылкаНаПриемку.Обращение);
	Если ЗначениеЗаполнено(Заявка) Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ID_OPERATION", Строка(СсылкаНаПриемку.Ссылка.УникальныйИдентификатор()));
		ВыбранныеПредложенияНаПланшете = ПолучитьТаблицуСОтборомПоПараметрам(BIR, "dbo.OPERATION_OFFERS_1C()", Отбор, Ложь, Новый Структура(), ВебСервис);
		Если ВыбранныеПредложенияНаПланшете.Количество() > 0 Тогда
			ЗаявкаДок = Заявка.ПолучитьОбъект();
			Для каждого Стр из ВыбранныеПредложенияНаПланшете Цикл
				Комплекс = Справочники.Renault_КомплексСервисыАвторабот.НайтиПоРеквизиту("Артикул",Стр.Code);
				Если Заявка.Работы.Найти(Комплекс.Авторабота) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ВыбранныйКС = Новый ТаблицаЗначений;
				ВыбранныйКС.Колонки.Добавить("Работа");
				ВыбранныйКС.Колонки.Добавить("Номенклатура");
				ВыбранныйКС.Колонки.Добавить("Нормочас");
				ВыбранныйКС.Колонки.Добавить("Цена");
				ВыбранныйКС.Колонки.Добавить("Количество");
				ВыбранныйКС.Колонки.Добавить("ДлительностьЗН");
				ВыбранныйКС.Колонки.Добавить("Длительность");
				ВыбранныйКС.Колонки.Добавить("Стоимость");
				
				ВыбранныйКС = Обработки.Renault_ПодборКомплексСервисов.Создать().ЗаполнитьСоставПоКомплексу(Комплекс,ВыбранныйКС); 
				
				Если ТипЗнч(ВыбранныйКС) = Тип("ТаблицаЗначений") И ВыбранныйКС.Количество()>0 Тогда
					Для каждого стр из ВыбранныйКС Цикл
						Если ЗначениеЗаполнено(стр.Работа) Тогда
							НоваяСтрока = ЗаявкаДок.Работы.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
							НоваяСтрока.Сумма = Стр.Стоимость;
							НоваяСтрока.IDРаботы = Строка(Стр.Работа.УникальныйИдентификатор());
							НоваяСтрока.Нормочас = СсылкаНаПриемку.ДилерскийЦентр.Автосервис_Нормочас;
						ИначеЕсли ЗначениеЗаполнено(стр.Номенклатура) Тогда
							НоваяСтрока = ЗаявкаДок.Товары.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
							НоваяСтрока.Сумма = Стр.Стоимость;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			КонецЦикла;
			ЗаявкаДок.Записать();
			
			Если ЗначениеЗаполнено(ЗаявкаДок.ЗаказНаряд) Тогда
				Renault_АвтосервисОбщий.Reanult_ОбновитьСформироватьЗаказНаряд(ЗаявкаДок.ЗаказНаряд, ЗаявкаДок.Ссылка, Ложь);
			Иначе
				ЗаказНаряд = Renault_АвтосервисОбщий.Reanult_ОбновитьСформироватьЗаказНаряд(Неопределено, ЗаявкаДок.Ссылка, Ложь);
				Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
					ЗаявкаДок.ЗаказНаряд = ЗаказНаряд.Ссылка;
					ЗаявкаДок.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции	
	
