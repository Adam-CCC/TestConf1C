		Повреждение = Справочники.Renault_Автосервис_Повреждения.Разбита;		
	ИначеЕсли DefectID = 30 Тогда	
		Повреждение = Справочники.Renault_Автосервис_Повреждения.СильноеЗагрязнение;
	ИначеЕсли DefectID = 31 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.СколОкраска;
	ИначеЕсли DefectID = 32 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.Спущена;
	ИначеЕсли DefectID = 34 Тогда	
		Повреждение = Справочники.Renault_Автосервис_Повреждения.УтечкаЖидкости;
	ИначеЕсли DefectID = 35 Тогда	
		Повреждение = Справочники.Renault_Автосервис_Повреждения.УтечкаЖидкостиГУР;
	ИначеЕсли DefectID = 36 Тогда	
		Повреждение = Справочники.Renault_Автосервис_Повреждения.УтечкаЖидкостиСтеклоомывателя;
	ИначеЕсли DefectID = 37 Тогда	
		Повреждение = Справочники.Renault_Автосервис_Повреждения.УтечкаТормознойЖидкости;
	ИначеЕсли DefectID = 39 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.ЦарапинаПолировка;
	ИначеЕсли DefectID = 42 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.Протечка;
	ИначеЕсли DefectID = 44 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.НеРаботаетВентилятор;
	ИначеЕсли DefectID = 45 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.УтечкаОхлаждающейЖидкости;
	ИначеЕсли DefectID = 46 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.ТребуетсяЗамена;
	ИначеЕсли DefectID = 47 Тогда
		Повреждение = Справочники.Renault_Автосервис_Повреждения.КритическийИзнос;
		
	КонецЕсли;
	
	Возврат Повреждение;
	
КонецФункции

Функция ПолучитьПоврежденияСПланшета(BIR,ВебСервис,СсылкаНаПриемку)
	

	
	ОтборЗапроса = Новый Структура();

	ОтборЗапроса.Вставить("OperationID", Строка(СсылкаНаПриемку.Ссылка.УникальныйИдентификатор()));
	ПоляКаста = Новый Структура();
	ПоляКаста.Вставить("Comment", "8000");
	ПоляКаста.Вставить("Value", "8000");
	ДанныеПоПовреждениям = ПолучитьТаблицуСОтборомПоПараметрам(BIR, "dbo.GET_DAMAGES_OPERATION_1C()", ОтборЗапроса, Истина, ПоляКаста, ВебСервис);
	Если ТипЗнч(ДанныеПоПовреждениям) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение ДанныеПоПовреждениям;
	ИначеЕсли ДанныеПоПовреждениям.Количество()>0 Тогда
		Набор = РегистрыСведений.Renault_ПоврежденияКузова.СоздатьНаборЗаписей();
		Набор.Отбор.Автомобиль.Установить(СсылкаНаПриемку.Автомобиль);
		Набор.Отбор.Обращение.Установить(СсылкаНаПриемку.Обращение);
		Набор.Записать();
	КонецЕсли;
	
	ЗоныПовреждений = ПолучитьСоответствияКодовЭлементовЗонПовреждений();

	ТекДата = ТекущаяДата();
	
	Для Каждого Данное Из ДанныеПоПовреждениям Цикл
				
		Мен = РегистрыСведений.Renault_ПоврежденияКузова.СоздатьМенеджерЗаписи();
		Мен.Автомобиль = СсылкаНаПриемку.Автомобиль;
		Мен.Обращение = СсылкаНаПриемку.Обращение;
		Мен.Комментарий = Данное.Comment;
		Мен.Период = ТекДата;
		Мен.СтепеньПовреждения = Справочники.Renault_Автосервис_СтепениПовреждения.НайтиПоРеквизиту("УИД",Данное.DamageDegree);
		Мен.ТребуетсяРемонт = Данное.IsNeedRepair; 
		Мен.ПриемкаИзПланшета = Истина; // Беседин 16.02.22 заЯвка 1089
		Значение = Данное.Value;
		Если Данное.ElementID <> 0 Тогда
			ЗонаПовреждения = ЗоныПовреждений.Получить(Данное.ElementID);
			Если ЗонаПовреждения = Неопределено Тогда
				Сообщить("Не найдена зона повреждения " + Данное.ElementID + " комментарий " + Данное.Comment); 
				Продолжить;
			КонецЕсли;
			
			Мен.Повреждение = ОпределитьПовреждение(Данное.DefectID);
			
		Иначе
			ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.ПустаяСсылка(); 
			Если Данное.DefectID = 27 Тогда // пробег
				Если Данное.Value <> Неопределено И Данное.Value <> "" Тогда
					Попытка
						Пробег = Число(Данное.Value);
						Если Пробег <> 0 Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СсылкаНаПриемку.Автомобиль,Пробег,Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, НачалоДня(ТекущаяДата()));
							Данное.Value = Пробег;
							Мен.Значение = Пробег;
							Мен.Повреждение = Справочники.Renault_Автосервис_Повреждения.ПоказаниеОдометра;
							ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.ПоказаниеОдометра; 
						Иначе
							Продолжить;
						КонецЕсли;
					Исключение
						Сообщить(ОписаниеОшибки());	
						Продолжить;
					КонецПопытки;
				КонецЕсли;
			ИначеЕсли Данное.DefectID = 28 Тогда // наличие ошибок
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.НаличиеОшибок; 
			ИначеЕсли Данное.DefectID = 29 Тогда //уровень топлива
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.УровеньТоплива; 
				Мен.Повреждение =  Справочники.Renault_Автосервис_Повреждения.УровеньТоплива;
				Мен.Значение = Данное.Value;
			ИначеЕсли Данное.DefectID = 30 Тогда // Работа внутренних осветительных приборов
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.СветильникВСалоне;
				Мен.Повреждение = Данное.Value;
			ИначеЕсли Данное.DefectID = 31 Тогда // Работа поворотников и фар, аварийных сигналов
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.РаботаПоворотниковФар;
			ИначеЕсли Данное.DefectID = 32 Тогда // Система стеклоподъемников
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.СистемаСтеклоподъемников;
			ИначеЕсли Данное.DefectID = 33 Тогда //Система кондиционирования 
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.СистемаКондиционирования;
			ИначеЕсли Данное.DefectID = 34 Тогда //Аудиосистема 
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.Аудиосистема;
			ИначеЕсли Данное.DefectID = 35 Тогда //Ход педалей
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.ХодПедалей;
			ИначеЕсли Данное.DefectID = 36 Тогда //Рулевое управление 
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.РулевоеУправление;
			ИначеЕсли Данное.DefectID = 37 Тогда //Состояние зеркала заднего вида
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.ЗеркалоЗаднегоВида;
			ИначеЕсли Данное.DefectID = 38 Тогда //Стеклоотчистители и омыватели
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.СтеклоотчистителиОмыватели;
			ИначеЕсли Данное.DefectID = 39 Тогда //Общее состояние панели и внутренней отделки
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.состояниеПанелиОтделки;
			ИначеЕсли Данное.DefectID = 40 Тогда //Наличие ковров
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.НаличиеКовров;
			ИначеЕсли Данное.DefectID = 41 Тогда //Дополнительный комментарий
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.ДополнительныйКомментарий;
			ИначеЕсли Данное.DefectID = 47 Тогда //Дата следующего ТО
				ЗаписатьДатуСледующегоТО(СсылкаНаПриемку.Автомобиль, Данное.Value); 
				Продолжить;
			ИначеЕсли Данное.DefectID = 48 Тогда //Необходимо прохождение ГТО
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.НеобходимоПрохождениеГТО;
				Значение = ?(Данное.Value = "on","Да","Нет");
			ИначеЕсли Данное.DefectID = 49 Тогда //Навигационная система
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.НавигационнаяСистема;
				Значение = Данное.Value;	
			ИначеЕсли Данное.DefectID = 50 Тогда //Подогрев сидений
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.ПодогревСидений;
				Значение = Данное.Value;	
			Иначе
				ЗонаПовреждения = Справочники.Renault_ЗоныПоврежденийАвто.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
			
		Мен.Значение = Значение;
		Мен.ЗонаПовреждения = ЗонаПовреждения; 
		Мен.Записать();		
		
	КонецЦикла;
	
КонецФункции

Процедура ЗаписатьДатуСледующегоТО(Автомобиль,ДатаТО)
	
		
	Попытка 
		Если СтрДлина(ДатаТО) <> 10 Тогда
			Возврат;
		КонецЕсли;
		Год = Число(Лев(ДатаТО,4)); 
		Месяц = Число(Сред("2018-10-01",6,2));
		День = Число(Прав(ДатаТО,2)); 
		ДатаСледующегоТО = Дата(Год,Месяц,День);
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ДатаСледующегоТО < ТекущаяДата() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТО = РегистрыСведений.Renault_ВыполнениеТО.ПолучитьПоследнее(,Новый Структура("Автомобиль",Автомобиль));
	
	Если СтруктураТО.ДатаПлан = ДатаСледующегоТО Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ВыполнениеТОСрезПоследних.Автомобиль,
		|	МАКСИМУМ(Renault_ВыполнениеТОСрезПоследних.Период) КАК Период
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	РегистрСведений.Renault_ВыполнениеТО.СрезПоследних(, Автомобиль = &Автомобиль) КАК Renault_ВыполнениеТОСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	Renault_ВыполнениеТОСрезПоследних.Автомобиль
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Renault_ВыполнениеТОСрезПоследних.Автомобиль,
		|	Renault_ВыполнениеТОСрезПоследних.Период КАК Период,
		|	Renault_ВыполнениеТОСрезПоследних.ВидТО,
		|	Renault_ВыполнениеТОСрезПоследних.СкоростьПробега,
		|	Renault_ВыполнениеТОСрезПоследних.ДатаПлан,
		|	Renault_ВыполнениеТОСрезПоследних.ДатаФакт,
		|	Renault_ВыполнениеТОСрезПоследних.ПланПробег,
		|	Renault_ВыполнениеТОСрезПоследних.ЗаказНаряд
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ВыполнениеТО.СрезПоследних(, Автомобиль = &Автомобиль) КАК Renault_ВыполнениеТОСрезПоследних
		|		ПО (Renault_ВыполнениеТОСрезПоследних.Период = ВТ.Период)
		|			И (Renault_ВыполнениеТОСрезПоследних.Автомобиль = ВТ.Автомобиль)";
	
	Запрос.УстановитьПараметр("Автомобиль",Автомобиль);

	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Менеджер = РегистрыСведений.Renault_ВыполнениеТО.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Менеджер,ВыборкаДетальныеЗаписи);
		Менеджер.Период = ТекущаяДата();
		Менеджер.ДатаПлан = ДатаСледующегоТО;
		Менеджер.Записать();	
	КонецЦикла;
	
	
	

КонецПроцедуры

Функция ПолучениеДанныхПоКлиентуСПланшета(BIR,ВебСервис,СсылкаНаПриемку)
		
		
		// запишем логин MyRenault
		ЛогинMyRenault = "";
		Отбор = Новый Структура();
		Отбор.Вставить("ClientID", Строка(СсылкаНаПриемку.Клиент.УникальныйИдентификатор()));
		ДанныеПоКлиенту = ПолучитьТаблицуСОтборомПоПараметрам(BIR, "dbo.Client", Отбор, Ложь, Новый Структура(), ВебСервис);
		Если ТипЗнч(ДанныеПоКлиенту) = Тип("Строка") Тогда
			ВызватьИсключение ДанныеПоКлиенту;
		КонецЕсли;
		
		Клиент = СсылкаНаПриемку.Клиент;
		
		
		Если ДанныеПоКлиенту.Количество() <> 0 Тогда 
			
			ЛогинMyRenault = ДанныеПоКлиенту[0].MyRenault;
			Если Клиент.Фамилия	<> ДанныеПоКлиенту[0].Surname 
				ИЛИ Клиент.Имя	<> ДанныеПоКлиенту[0].FirstName 
				ИЛИ Клиент.Отчество	<> ДанныеПоКлиенту[0].Patronymic 
				ИЛИ Клиент.ДатаРождения	<> ДанныеПоКлиенту[0].DateBirth 
				ИЛИ Клиент.ИНН	<> ДанныеПоКлиенту[0].INN
				ИЛИ Клиент.ОсновнойТелефон <> ДанныеПоКлиенту[0].Phone Тогда
				
				КлиентОб = Клиент.ПолучитьОбъект();
				КлиентОб.Фамилия 	  = ДанныеПоКлиенту[0].Surname;
				КлиентОб.Имя	 	  = ДанныеПоКлиенту[0].FirstName;
				КлиентОб.Отчество 	  = ДанныеПоКлиенту[0].Patronymic;
				КлиентОб.ДатаРождения = ДанныеПоКлиенту[0].DateBirth;
				КлиентОб.ИНН		  = ДанныеПоКлиенту[0].INN;
				КлиентОб.ОсновнойТелефон = ДанныеПоКлиенту[0].Phone;
				КлиентОб.Записать();
			КонецЕсли;
			
			
			Если ЗначениеЗаполнено(ДанныеПоКлиенту[0].Phone) Тогда
				Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Клиент);
				Если Телефон <> ДанныеПоКлиенту[0].Phone Тогда
					Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
					Менеджер.Объект = Клиент;
					Менеджер.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
					Менеджер.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
					Менеджер.Представление = ДанныеПоКлиенту[0].Phone;
					Менеджер.Записать();
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеПоКлиенту[0].Email) Тогда
				ЭлектронныйАдрес = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Клиент);
				
				Если ЭлектронныйАдрес <> ДанныеПоКлиенту[0].Email Тогда
					Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
					Менеджер.Объект = Клиент;
					Менеджер.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний;
					Менеджер.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
					Менеджер.Представление = ДанныеПоКлиенту[0].Email;
					Менеджер.Записать();
				КонецЕсли;
			КонецЕсли;
			
			
			Если ЗначениеЗаполнено(ДанныеПоКлиенту[0].ADDRESS) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	КонтактнаяИнформация.Поле4,
				|	КонтактнаяИнформация.Представление
				|ИЗ
				|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
				|ГДЕ
				|	КонтактнаяИнформация.Объект = &Ссылка
				|	И КонтактнаяИнформация.Вид = &Вид";
				
				Запрос.УстановитьПараметр("Ссылка",Клиент);
				Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресФактический);
				
				Адрес = "";
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Адрес = Выборка.Представление;
				КонецЕсли;
				
				Если Адрес <> ДанныеПоКлиенту[0].ADDRESS Тогда
					Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
					Менеджер.Объект = Клиент;
					Менеджер.Вид = Справочники.ВидыКонтактнойИнформации.АдресФактический;
					Менеджер.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
					Менеджер.Представление = ДанныеПоКлиенту[0].ADDRESS;
					Менеджер.Записать();
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		
		Если ЛогинMyRenault <> "" Тогда
			Запись = РегистрыСведений.Renault_ПользователиMyRenault.СоздатьМенеджерЗаписи();
			Запись.Период = ТекущаяДата();
			Запись.Контрагент = СсылкаНаПриемку.Клиент;
			Запись.ЛогинMyRenault = ЛогинMyRenault;
			Запись.ЕстьРегистрация = Истина;
			Запись.Записать();
		КонецЕсли;
		
		
КонецФункции	
	
Функция ПолучениеАкцийСПланшета(BIR,ВебСервис,СсылкаНаПриемку)
		
		// получим акции
		МассивАкций = Новый Массив(); 
		Отбор = Новый Структура();
		Отбор.Вставить("OperationID", Строка(СсылкаНаПриемку.Ссылка.УникальныйИдентификатор()));
		ДанныеПоВыбраннымАкциям = ПолучитьТаблицуСОтборомПоПараметрам(BIR, "dbo.Offer1c", Отбор, Ложь, Новый Структура(), ВебСервис);
		Если ТипЗнч(ДанныеПоВыбраннымАкциям) = Тип("Строка") Тогда
			ВызватьИсключение ДанныеПоВыбраннымАкциям;
		КонецЕсли;
		Для Каждого Тек Из ДанныеПоВыбраннымАкциям Цикл
			
			Отбор = Новый Структура();
			Отбор.Вставить("УИД", Тек.OfferGUID);
			Поиск = НайтиВБазеСсылкуПоОтбору("Справочник.Renault_АкцииИСкидки", Отбор);
			Если ЗначениеЗаполнено(Поиск) Тогда
				
				ПоискАкции = Неопределено;
				Если ЗначениеЗаполнено(СсылкаНаПриемку.Обращение)Тогда
					ПоискАкции = СсылкаНаПриемку.Обращение.ВыбранныеАкции.найти(Поиск, "Акция");
				КонецЕсли;
				Если ПоискАкции = Неопределено Тогда
					ПоискАкции = СсылкаНаПриемку.ВыбранныеАкции.найти(Поиск, "Акция");
				КонецЕсли;
				
				Если ПоискАкции = Неопределено Тогда
					
					МассивАкций.Добавить(Поиск.Ссылка);
					
				КонецЕсли;
				
			Иначе
				
				Отбор = Новый Структура();
				Отбор.Вставить("УИД", Тек.OfferGUID);
				Поиск = НайтиВБазеСсылкуПоОтбору("Справочник.Renault_ЦентрализованныеАкции.Модели", Отбор);
				
				Если ЗначениеЗаполнено(Поиск) Тогда
					
					ПоискАкции = Неопределено;
					Если ЗначениеЗаполнено(СсылкаНаПриемку.Обращение)Тогда
						ПоискАкции = СсылкаНаПриемку.Обращение.ВыбранныеАкции.найти(Поиск, "Акция");
					КонецЕсли;
					Если ПоискАкции = Неопределено Тогда
						ПоискАкции = СсылкаНаПриемку.ВыбранныеАкции.найти(Поиск, "Акция");
					КонецЕсли;
					Если ПоискАкции = Неопределено Тогда
						МассивАкций.Добавить(Поиск.Ссылка);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат МассивАкций;
		
КонецФункции	

Функция ПолучитьПримечениеСПланшета(BIR,ВебСервис,СсылкаНаПриемку)
	
	
	// получим примечание
	Отбор = Новый Структура();
	Отбор.Вставить("OperationID", Строка(СсылкаНаПриемку.Ссылка.УникальныйИдентификатор()));
	
	ПоляКаста = Новый Структура();
	ПоляКаста.Вставить("Reason", "8000");

	ДанныеПоОперациям = ПолучитьТаблицуСОтборомПоПараметрам(BIR, "dbo.Operation", Отбор, Истина, ПоляКаста , ВебСервис);
	Если ТипЗнч(ДанныеПоОперациям) = Тип("Строка") Тогда
		ВызватьИсключение ДанныеПоОперациям;
	КонецЕсли;
	
	Если ДанныеПоОперациям.Количество() <> 0 Тогда 
		Обращение = СсылкаНаПриемку.Обращение.ПолучитьОбъект();
		Обращение.Примечание = ДанныеПоОперациям[0].Reason;
		Обращение.Записать();
	КонецЕсли;
	
КонецФункции

Функция ВыполнитьЧтениеПриемкиИзпланшета(СсылкаНаПриемку) Экспорт

	
	ВебСервис = ПолучитьВебСервисПоПланшету();	
	BIR = СсылкаНаПриемку.ДилерскийЦентр.BIR; 
	
	ПолучитьПримечениеСПланшета(BIR,ВебСервис,СсылкаНаПриемку);
	
	ЗагрузитьКомплексыИзПланшета(BIR,ВебСервис,СсылкаНаПриемку);		
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("VIN",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
	СтрАвто = ТаблицаДанных.Добавить();
	СтрАвто.VIN = СсылкаНаПриемку.Автомобиль.VIN;
	сТаблицОтправки = Новый Структура;
	сТаблицОтправки.Вставить("AUTOS",ТаблицаДанных);
	сТаблицОтправки.Вставить("IS_INPUT",0);
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_SYNC_BVM_TABLET");
	
	ПолучитьПоврежденияСПланшета(BIR,ВебСервис,СсылкаНаПриемку);
	
	
	ЗагрузитьКартинки(ВебСервис,СсылкаНаПриемку);
	
	РезультатОтвет = Новый Структура();
	
	ПолучениеДанныхПоКлиентуСПланшета(BIR,ВебСервис,СсылкаНаПриемку);
	
	
	ЗагрузитьИзмененияЗаказНаряда(BIR,ВебСервис,СсылкаНаПриемку);

	//МассивАкций = ПолучениеАкцийСПланшета(BIR,ВебСервис,СсылкаНаПриемку);
	//РезультатОтвет.Вставить("МассивАкций", МассивАкций);
	
	Возврат РезультатОтвет;
	
	
КонецФункции

Процедура ЗагрузитьКартинки(ВебСервис,СсылкаНаПриемку)
	
	Если ВебСервис = Неопределено Тогда 
		ВебСервис = ПолучитьВебСервисПоПланшету();
	КонецЕсли;
	
	УИДПриемки = Строка(СсылкаНаПриемку.УникальныйИдентификатор());
	Ответ = ВебСервис.GetImages(УИДПриемки);

	Если ТипЗнч(Ответ) = Тип("Строка") Тогда
		Сообщить(Ответ);
	Иначе
		ТаблицаКартинок = СериализаторXDTO.ПрочитатьXDTO(Ответ);
		Для Каждого ОписаниеКартинки Из ТаблицаКартинок Цикл
			Если ОписаниеКартинки.Данные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МенеджерЗаписи = РегистрыСведений.Renault_КартинкиИФайлы.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Объект = СсылкаНаПриемку;
			МенеджерЗаписи.Идентификатор = ?(ЗначениеЗаполнено(ОписаниеКартинки.ElementID),ОписаниеКартинки.ElementID,"0");
			МенеджерЗаписи.Наименование = ОписаниеКартинки.IMAGE_NAME;
			МенеджерЗаписи.ИмяФайла = ОписаниеКартинки.IMAGE_NAME;
			МенеджерЗаписи.Данные = ОписаниеКартинки.Данные;
			МенеджерЗаписи.Картинка = Истина;
			МенеджерЗаписи.ДатаСохранения = ТекущаяДата();			
			МенеджерЗаписи.Комментарий = "Фото загружено с планшета";     
			МенеджерЗаписи.Записать();
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		ОтветУдаления = ВебСервис.DeleteImages(УИДПриемки);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьТаблицуСОтборомПоПараметрам(BIR, ИмяТаблицы, СтруктураОтбора, Каст = Ложь, ПоляКаст = Неопределено, ВебСервис = Неопределено)
	
	
	Если ВебСервис = Неопределено Тогда
		ВебСервис = ПолучитьВебСервисПоПланшету();
	КонецЕсли;
	//Сериализатор = новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
	СерСтрук = СериализаторXDTO.ЗаписатьXDTO(СтруктураОтбора);
	ПоляКаст = ?(Полякаст = Неопределено, Новый Структура("Имяц", "Имяц"), ПоляКаст);
	СерПоля = СериализаторXDTO.ЗаписатьXDTO(ПоляКаст);
	Итог = ВебСервис.GetSelectionTableSQL(BIR, ИмяТаблицы, СерСтрук, Каст, СерПоля);
	
	Если Итог = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Таблица = СериализаторXDTO.ПрочитатьXDTO(Итог);
	Возврат Таблица;
	
КонецФункции

Функция НайтиВБазеСсылкуПоОтбору(ИмяОбъекта, СтруктураОтбора)
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ "+Символы.ПС+" ИсточникПоиска.Ссылка КАК Ссылка"+Символы.ПС +" ИЗ "+ Символы.ПС+" "+ ИмяОбъекта+" КАК ИсточникПоиска";
	ЭтоПервоеУсловие = Истина;
	Для Каждого Условие Из СтруктураОтбора Цикл
		Если ЭтоПервоеУсловие Тогда
			ЭтоПервоеУсловие = Ложь;
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + " ГДЕ " + Символы.ПС;
		Иначе
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И ";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + " ИсточникПоиска." + Условие.Ключ + " = &" + Условие.Ключ;
		Запрос.УстановитьПараметр(Условие.Ключ, Условие.Значение);
	КонецЦикла;
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

