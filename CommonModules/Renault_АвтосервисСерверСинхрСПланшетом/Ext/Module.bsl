// Функции выгрузки в планшет
Процедура ВыгрузитьДилерскиеЦентрыВПланшет(Знач ДЦ = Неопределено) Экспорт
	
	ВебСервис = ПолучитьВебСервисПоПланшету();	
	сТаблицОтправки = Новый Структура;
	сТаблицОтправки.Вставить("DATA",ПолучитьТаблицуДЦ(ДЦ));
	ВыполнитьХранимуюПроцедуру(ДЦ.BIR,ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_COMPANY_SYNC");
	ВыгрузитьСправочникиВПланшет(ВебСервис,ДЦ);
	
КонецПроцедуры

Процедура ВыгрузитьМастеровПриемщиковВПланшет(BIR = Неопределено, ВебСервис = Неопределено, Сотрудник = Неопределено) Экспорт
	
	сТаблицОтправки = Новый Структура;
	сТаблицОтправки.Вставить("DATA",ПолучитьТаблицуПользователей(Сотрудник));
	
	Если ВебСервис = Неопределено Тогда
		ВебСервис = ПолучитьВебСервисПоПланшету();
	КонецЕсли;
	
	
	Если BIR = Неопределено Тогда
		BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	КонецЕсли;
	
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_USERS_SYNC");
	
КонецПроцедуры

Процедура ВыгрузитьАвтомобильВПланшет(BIR, ВебСервис,Автомобиль,ДЦ) Экспорт
	
	Если ВебСервис = Неопределено Тогда
		ВебСервис = ПолучитьВебСервисПоПланшету();
	КонецЕсли;                            
	
	сТаблицОтправки = Новый Структура("BRANDS,COLORS,ENGINES,TRANSMISSIONS,PHASES,WHEEL_DRIVES,PURCHASE_ORDER_TYPES");
	сТаблицОтправки.Вставить("BRANDS",ПолучитьТаблицуБрендов(ДЦ,Автомобиль)); //@BRANDS BRANDS_TABLE_TYPE
	Попытка  // постоянная ошибка у Тринити на обращении к цвету
		сТаблицОтправки.Вставить("COLORS",ПолучитьТаблицуЦветов(ДЦ,Автомобиль.Цвет));	 //@COLORS COLORS_TABLE_TYPE 
	Исключение
	КонецПопытки;
	сТаблицОтправки.Вставить("ENGINES",ПолучитьТаблицуДвигателей(ДЦ,Автомобиль.ТипДвигателя));	//@ENGINES ENGINES_TABLE_TYPE 
	сТаблицОтправки.Вставить("TRANSMISSIONS",ПолучитьТаблицуТрансмиссий(ДЦ,Автомобиль.ТипКПП));//@TRANSMISSIONS TRANSMISSIONS_TABLE_TYPE 
	сТаблицОтправки.Вставить("PHASES",ПолучитьТаблицуФаз(ДЦ,Автомобиль)); //@PHASES PHASES_TABLE_TYPE 
	сТаблицОтправки.Вставить("WHEEL_DRIVES",ПолучитьТаблицуПриводовАвто(ДЦ,Автомобиль)); //@WHEEL_DRIVES WHEEL_DRIVES_TABLE_TYPE
	сТаблицОтправки.Вставить("PURCHASE_ORDER_TYPES",ПолучитьТаблицуВидовРемонта(ДЦ)); //@PURCHASE_ORDER_TYPES PURCHASE_ORDER_TYPES_TABLE_TYPE
	сТаблицОтправки.Вставить("OPERATION_RECOMMENDATION_PRIORITY",Новый ТаблицаЗначений);
	ВыполнитьХранимуюПроцедуру(ДЦ.BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_DICTIONARIES_SYNC");

	сТаблицОтправки = Новый Структура();
	сТаблицОтправки.Вставить("DATA_MODELS",ПолучитьТаблицуМоделей(Автомобиль.Модель));
	сТаблицОтправки.Вставить("DATA_VERSIONS", ПолучитьТаблицуВерсий(Автомобиль.ВариантКомплектации));
	ВыполнитьХранимуюПроцедуру(ДЦ.BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_MODEL_VERSION_SYNC");	
	//
	сТаблицОтправки = Новый Структура;
	сТаблицОтправки.Вставить("DATA",ПолучитьТаблицуАвтомобилей(Автомобиль));
	
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_VEHICLES_SYNC");

	сТаблицОтправки = Новый Структура;
	сТаблицОтправки.Вставить("DATA",ПолучитьТаблицуКритериевАвтомобиля(Автомобиль));
	
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_VEHICLES__PROPERTIES_SYNC");
	
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("VIN",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
	СтрАвто = ТаблицаДанных.Добавить();
	СтрАвто.VIN = Автомобиль.VIN;
	сТаблицОтправки = Новый Структура;
	сТаблицОтправки.Вставить("AUTOS",ТаблицаДанных);
	сТаблицОтправки.Вставить("IS_INPUT",1);
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_SYNC_BVM_TABLET");


КонецПроцедуры

