	ТаблицаДанных.Колонки.Добавить("ADDITIONAL_INSURANCE_DATE_START",Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ADDITIONAL_INSURANCE_DATE_END",Новый ОписаниеТипов("Дата"));
	
	ТаблицаДанных.Колонки.Добавить("IS_GARANTEE",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(1)));
	ТаблицаДанных.Колонки.Добавить("IS_EXTRA_GARANTEE",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(1)));
	ТаблицаДанных.Колонки.Добавить("IS_SARA",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(1)));
	ТаблицаДанных.Колонки.Добавить("DATE_SALE",Новый ОписаниеТипов("Дата"));
	
	//Автомобиль = Справочники.Автомобили.ПустаяСсылка();
	СтрокаТз=ТаблицаДанных.Добавить();		
	СтрокаТз.ID = Автомобиль.УникальныйИдентификатор();
	СтрокаТз.VIN = Автомобиль.VIN;
	СтрокаТз.ID_MODEL = Автомобиль.Модель.УникальныйИдентификатор();
	СтрокаТз.ID_PHASE = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Ссылка
	|ИЗ
	|	Справочник.CRM_МаркаАвтомобиля.МоделиАвтомобилей КАК CRM_МаркаАвтомобиляМоделиАвтомобилей
	|ГДЕ
	|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Модель = &Модель";
	Запрос.УстановитьПараметр("Модель",Автомобиль.Модель);
	Выборка =  Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтрокаТз.ID_BRAND = Выборка.Ссылка.УникальныйИдентификатор();
	Иначе
		СтрокаТз.ID_BRAND = "";	
	КонецЕсли;
	
	СтрокаТз.ID_COLOR = Автомобиль.Цвет.УникальныйИдентификатор();
	СтрокаТз.ID_TRANSMISSION = Автомобиль.ТипКПП.УникальныйИдентификатор();
	СтрокаТз.ID_ENGINE = Автомобиль.ТипДвигателя.УникальныйИдентификатор();
	СтрокаТз.YEAR_MANUFACTURING = Строка(Формат(Год(Автомобиль.ГодВыпуска),"ЧГ="));
	СтрокаТз.ID_VERSION = Автомобиль.ВариантКомплектации.УникальныйИдентификатор();
	СтрокаТз.PLATE = Renault_АвтосервисОбщий.Renault_ПолучитьГосНомер(Автомобиль);
	ТзДопРеквизиты = РегистрыСведений.Renault_АвтомобилиДопРеквизиты.ПолучитьКритерииПоАвтомобилю(Автомобиль);
	Если ТзДопРеквизиты.Количество()>0 Тогда
		СтрДоп =  ТзДопРеквизиты.Получить(0);
		СтрокаТз.INTERIOR_FILTER = ?(СтрДоп.СалонныйФильтр,1,0);
		СтрокаТз.POWER_STEERING = ?(СтрДоп.ГУР,1,0);
		СтрокаТз.ID_PHASE = ?(ЗначениеЗаполнено(СтрДоп.Фаза),СтрДоп.Фаза.УникальныйИдентификатор(),Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
		СтрокаТз.AIR_CONDITIONING = ?(СтрДоп.AC,1,0);
		СтрокаТз.ABS = ?(СтрДоп.ABS,1,0);
		
		Если СтрДоп.ТипПривода = Перечисления.Renault_ПриводАвтомобиля.Полный Тогда
			СтрокаТз.ID_WHEEL_DRIVER = Новый УникальныйИдентификатор(Сред(ЗначениеВСтрокуВнутр(Перечисления.Renault_ПриводАвтомобиля),6,35)+"1");
		ИначеЕсли СтрДоп.ТипПривода = Перечисления.Renault_ПриводАвтомобиля.Передний Тогда
			СтрокаТз.ID_WHEEL_DRIVER = Новый УникальныйИдентификатор(Сред(ЗначениеВСтрокуВнутр(Перечисления.Renault_ПриводАвтомобиля),6,35)+"2");
		ИначеЕсли СтрДоп.ТипПривода = Перечисления.Renault_ПриводАвтомобиля.Задний Тогда
			СтрокаТз.ID_WHEEL_DRIVER = Новый УникальныйИдентификатор(Сред(ЗначениеВСтрокуВнутр(Перечисления.Renault_ПриводАвтомобиля),6,35)+"3");
		Иначе
			СтрокаТз.ID_WHEEL_DRIVER = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		КонецЕсли;
		
		СтрокаТз.COMPULSORY_INSURANCE_DATE_START = СтрДоп.ДатаНачалаОСАГО;
		СтрокаТз.COMPULSORY_INSURANCE_DATE_END = СтрДоп.ДатаОкончанияОСАГО;
		СтрокаТз.ADDITIONAL_INSURANCE_DATE_START = СтрДоп.ДатаНачалаКАСКО;
		СтрокаТз.ADDITIONAL_INSURANCE_DATE_END = СтрДоп.ДатаОкончанияКАСКО;
		
	КонецЕсли;	
	
	ДопИнфо = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
	ДопИнфо.Автомобиль = Автомобиль;
	ДопИнфо.Прочитать();
	Если ДопИнфо.Выбран() Тогда
		СтрокаТз.IS_GARANTEE = ?(ДопИнфо.Гарантия,1,0);
		СтрокаТз.IS_EXTRA_GARANTEE =  ?(ДопИнфо.ПродленнаяГарантия,1,0);
		СтрокаТз.IS_SARA = ?(ДопИнфо.SARA,1,0);
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_КритерииАвтомобиля.КодКритерия
	|ИЗ
	|	РегистрСведений.Renault_КритерииАвтомобиля КАК Renault_КритерииАвтомобиля
	|ГДЕ
	|	Renault_КритерииАвтомобиля.Автомобиль = &Автомобиль
	|	И Renault_КритерииАвтомобиля.КодОбъекта = ""1000DDEL""";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	ДатаПродажи = Дата(1,1,1);	
	ВыборкаДЗ = Запрос.Выполнить().Выбрать();
	Если ВыборкаДЗ.Следующий() Тогда
		Если СтрДлина(ВыборкаДЗ.КодКритерия) = 10 Тогда
			Год = Прав(ВыборкаДЗ.КодКритерия,4);
			День = Лев(ВыборкаДЗ.КодКритерия,2);
			Месяц =  Сред(ВыборкаДЗ.КодКритерия,4,2);
			ДатаПродажи = Дата(Год,Месяц,День);
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТз.DATE_SALE = ДатаПродажи;
	
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьТаблицуКритериевАвтомобиля(Автомобиль) 
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_VEHICLE",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("OBJECT_CODE",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(256)));
	ТаблицаДанных.Колонки.Добавить("CRITERIA_CODE",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(256)));
	ТаблицаДанных.Колонки.Добавить("CRITERIA_DESCRIPTION",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(4000)));
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_КритерииАвтомобиля.КодОбъекта,
	|	Renault_КритерииАвтомобиля.КодКритерия,
	|	Renault_КритерииАвтомобиля.ОписаниеКритерия
	|ИЗ
	|	РегистрСведений.Renault_КритерииАвтомобиля КАК Renault_КритерииАвтомобиля
	|ГДЕ
	|	Renault_КритерииАвтомобиля.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКритериев = РезультатЗапроса.Выбрать();
		
	Если ВыборкаКритериев.Количество() = 0 Тогда 
		ОбработкаBVM = Обработки.Renault_ПолучениеДанныхИзBVM_WS.Создать();
		ОбработкаBVM.ПолучениеДанныхИзBVM(Автомобиль.VIN);
		ОбработкаBVM.ОбновитьИнформациюПоАвтомобилюИзBVM(Автомобиль);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаКритериев = РезультатЗапроса.Выбрать();
	КонецЕсли;
        			
	Пока ВыборкаКритериев.Следующий() Цикл
		НовСтр = ТаблицаДанных.Добавить();
		НовСтр.ID = Новый УникальныйИдентификатор;
		НовСтр.ID_VEHICLE = Автомобиль.УникальныйИдентификатор();
		НовСтр.OBJECT_CODE = ВыборкаКритериев.КодОбъекта;
		НовСтр.CRITERIA_CODE = ВыборкаКритериев.КодКритерия;
		НовСтр.CRITERIA_DESCRIPTION = ВыборкаКритериев.ОписаниеКритерия;	
	КонецЦикла;
	
	СтрКондиционер = ТаблицаДанных.Найти("046","OBJECT_CODE");
	Если СтрКондиционер <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтрКондиционер.CRITERIA_CODE) Тогда
			СтрКритФильтр = ТаблицаДанных.Найти("412","OBJECT_CODE");	
			Если СтрКритФильтр = Неопределено Тогда
				СтрКритФильтр = ТаблицаДанных.Добавить();
				СтрКритФильтр.ID = Новый УникальныйИдентификатор;
				СтрКритФильтр.ID_VEHICLE = Автомобиль.УникальныйИдентификатор();
				СтрКритФильтр.OBJECT_CODE =  "412";
				СтрКритФильтр.CRITERIA_DESCRIPTION = "Салонный фильтр";
			КонецЕсли;
			
			Если ЛЕВ(СтрКондиционер.CRITERIA_CODE,2) = "CA" Тогда
				СтрКритФильтр.CRITERIA_CODE = "FIPOU";
			Иначе
				СтрКритФильтр.CRITERIA_CODE = "SFIPOU";
			КонецЕсли;
			
			Если СтрКондиционер.CRITERIA_CODE <> "CHOREC" 
				И СтрКондиционер.CRITERIA_CODE <> "CAREG" Тогда
				СтрКондиционер.CRITERIA_CODE = ЛЕВ(СтрКондиционер.CRITERIA_CODE,2);
			КонецЕсли;		
		КонецЕсли;
		
		
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции



Функция ПолучитьТаблицуШапкиЗаявкиНаСервис(Заявка,Приемка)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_OPERATION",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("Date",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("ID_PURCHASE_ORDER_TYPE",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("TOTAL_AMOUNT",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));
	ТаблицаДанных.Колонки.Добавить("INVOICE_NUMBER",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));
	ТаблицаДанных.Колонки.Добавить("INVOICE_DATE",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаДанных.Колонки.Добавить("ID_DISCOUNT_RATE",Новый ОписаниеТипов("ОписаниеТипов"));
	
	сТабДанных = ТаблицаДанных.Добавить();
	сТабДанных.ID 					  = Заявка.УникальныйИдентификатор();
	сТабДанных.ID_OPERATION 		  = Приемка.УникальныйИдентификатор();
	сТабДанных.Date 				  = Заявка.Дата;
	сТабДанных.ID_PURCHASE_ORDER_TYPE = Заявка.ВидРемонта.УникальныйИдентификатор();
	сТабДанных.TOTAL_AMOUNT 		  = Формат(Заявка.Товары.Итог("Сумма") + Заявка.Работы.Итог("Сумма"),"ЧДЦ=2; ЧРД=.; ЧРГ=' '; ЧГ=0");
	Если сТабДанных.TOTAL_AMOUNT = "" Тогда
		сТабДанных.TOTAL_AMOUNT = "0";
	КонецЕсли;
	сТабДанных.INVOICE_NUMBER  		  = "";
	сТабДанных.INVOICE_DATE  		  = "";
	сТабДанных.ID_DISCOUNT_RATE 	  = "";
	
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьТаблицуДеталейЗаявкиНаСервис(Заявка)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("CODE",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));
	ТаблицаДанных.Колонки.Добавить("NAME",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(500)));
	ТаблицаДанных.Колонки.Добавить("UNIT",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(10)));
	ТаблицаДанных.Колонки.Добавить("QUANTITY",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,3)));	
	ТаблицаДанных.Колонки.Добавить("PRICE",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));
	ТаблицаДанных.Колонки.Добавить("ID_PUCHASE_ORDER",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_PART",Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	Для каждого Стр из Заявка.Товары Цикл
		сТабДанных = ТаблицаДанных.Добавить();
		сТабДанных.ID 				= Новый УникальныйИдентификатор();
		сТабДанных.CODE 		    = Стр.Номенклатура.Артикул;
		сТабДанных.NAME 			= Стр.Номенклатура.Наименование;
		сТабДанных.UNIT 			= Строка(Стр.Номенклатура.ОсновнаяЕдиницаИзмерения);
		сТабДанных.QUANTITY 		= Стр.Количество;
		сТабДанных.PRICE  		    = Формат(Стр.Цена, "ЧДЦ=2; ЧРД=.; ЧГ=0");
		Если сТабДанных.PRICE="" Тогда
			сТабДанных.PRICE="0";
		КонецЕсли;
		сТабДанных.ID_PUCHASE_ORDER = Заявка.УникальныйИдентификатор();
		сТабДанных.ID_PART 	  		= Стр.Номенклатура.УникальныйИдентификатор();
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
	
КонецФункции

Функция ПолучитьТаблицуРаботЗаявкиНаСервис(Заявка)
	
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("CODE",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));   // Артикул работы
	ТаблицаДанных.Колонки.Добавить("NAME",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));   //Наименование
	ТаблицаДанных.Колонки.Добавить("QUANTITY",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,3))); // Количество
	ТаблицаДанных.Колонки.Добавить("PRICE",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));  //Цена
	ТаблицаДанных.Колонки.Добавить("PRICE_KS",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));  //Цена
	ТаблицаДанных.Колонки.Добавить("ID_PUCHASE_ORDER",Новый ОписаниеТипов("УникальныйИдентификатор"));  // Ссылка на ордер
	ТаблицаДанных.Колонки.Добавить("ID_WORK",Новый ОписаниеТипов("УникальныйИдентификатор"));     //  Ссылка на з/ч из таблицы WORKS
	
	Для каждого Стр из Заявка.Работы Цикл
		сТабДанных = ТаблицаДанных.Добавить();
		сТабДанных.ID 				= Новый УникальныйИдентификатор();
		сТабДанных.CODE 		    = Стр.Работа.Артикул;
		сТабДанных.NAME 			= Стр.Работа.Наименование;
		
		// на планшете общая сумма рассчитывается исходя из Цена*Количество=Сумма, без учета коэффициентов
		//ЦенаДляПланшета = Стр.Цена;
		//Если Стр.Длительность>0 Тогда
		//	ЦенаДляПланшета = ОКР(Стр.Сумма/Стр.Длительность,2);
		//КонецЕсли;
		//  последняя версия - выгружаем в цену стоимость, количество = 1
		ЦенаДляПланшета = Стр.Сумма;
		

		сТабДанных.QUANTITY 		= 1;
		сТабДанных.PRICE  		    = Формат(ЦенаДляПланшета, "ЧДЦ=2; ЧРД=.; ЧГ=0");
		Если  сТабДанных.PRICE = "" Тогда
			сТабДанных.PRICE = "0";
		КонецЕсли;
		сТабДанных.PRICE_KS		    = Формат(Стр.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0");
		Если  сТабДанных.PRICE_KS = "" Тогда
			сТабДанных.PRICE_KS = "0";
		КонецЕсли;
		сТабДанных.ID_PUCHASE_ORDER = Заявка.УникальныйИдентификатор();
