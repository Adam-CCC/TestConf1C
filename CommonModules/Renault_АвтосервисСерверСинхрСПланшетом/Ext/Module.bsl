// ----------------------------------------------------------------------------------------
Функция ПолучитьТаблицуЧастыхРаботТОП(Приемка, Заявка)  ЭКСПОРТ
	
	Запрос = Новый Запрос;
	Запрос.Текст = "";
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_КодировкиТО.АртикулРаботы КАК Артикул
	|ПОМЕСТИТЬ ТО
	|ИЗ
	|	РегистрСведений.Renault_КодировкиТО КАК Renault_КодировкиТО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 50
	|	Renault_ЧастоИспользуемыеРаботы.Авторабота КАК Авторабота,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Renault_ЧастоИспользуемыеРаботы.Авторабота.Комментарий КАК СТРОКА(100)), """") КАК Description,
	|	ЕСТЬNULL(Renault_ЧастоИспользуемыеРаботы.Авторабота.Наименование, """") КАК NAME,
	|	СУММА(1) КАК КОЛИЧЕСТВО,   Сумма(0) КАК Цена,   Сумма(0) КАК ЦенаНормЧаса,
	|	МАКСИМУМ(ЕСТЬNULL(ЕСТЬNULL(АвтоработыНормыВремени.ВремяВыполнения, Renault_ЧастоИспользуемыеРаботы.Авторабота.ВремяВыполнения),0)) КАК ВремяВыполнения
	|ИЗ
	|	РегистрНакопления.Renault_ЧастоИспользуемыеРаботы КАК Renault_ЧастоИспользуемыеРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТО КАК ТО
	|		ПО (ТО.Артикул = Renault_ЧастоИспользуемыеРаботы.Авторабота.Артикул)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Автоработы.НормыВремени КАК АвтоработыНормыВремени
	|		ПО Renault_ЧастоИспользуемыеРаботы.Авторабота = АвтоработыНормыВремени.Ссылка
	|			И Renault_ЧастоИспользуемыеРаботы.Модель = АвтоработыНормыВремени.Модель
	|ГДЕ
	|	Renault_ЧастоИспользуемыеРаботы.Модель = &Модель
	|	И ЕСТЬNULL(Renault_ЧастоИспользуемыеРаботы.Авторабота.Наименование, """") <> """"
	|	И НЕ Renault_ЧастоИспользуемыеРаботы.Авторабота В (&Исключаемые)
	|	И ТО.Артикул ЕСТЬ NULL
	|	И ВЫБОР
	|			КОГДА &Пробег > 1
	|				ТОГДА Renault_ЧастоИспользуемыеРаботы.Пробег МЕЖДУ &Пробег - 5000 И &Пробег + 5000
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ГодВыпуска > 1
	|				ТОГДА Renault_ЧастоИспользуемыеРаботы.ГодВыпуска МЕЖДУ &ГодВыпуска - 1 И &ГодВыпуска + 1
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	Renault_ЧастоИспользуемыеРаботы.Авторабота,
	|	ВЫРАЗИТЬ(Renault_ЧастоИспользуемыеРаботы.Авторабота.Комментарий КАК СТРОКА(100)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Renault_ЧастоИспользуемыеРаботы.Авторабота.Комментарий КАК СТРОКА(100)), """"),
	|	ЕСТЬNULL(Renault_ЧастоИспользуемыеРаботы.Авторабота.Наименование, """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	КОЛИЧЕСТВО УБЫВ";
	
	ТГодВыпуска = Год(Заявка.Автомобиль.ГодВыпуска);
	ТПробег = Renault_АвтосервисОбщий.Renault_ПолучитьПробег(Заявка.Автомобиль);
	
	Запрос.УстановитьПараметр("Пробег", ТПробег);
	Запрос.УстановитьПараметр("ГодВыпуска", ТГодВыпуска);
	Запрос.УстановитьПараметр("Модель", Заявка.Автомобиль.Модель);
	Запрос.УстановитьПараметр("Исключаемые", Заявка.Работы);
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаДанных.Колонки.Добавить("GUID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("ID_WORK",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("OperationID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("Price",);
	ТаблицаДанных.Колонки.Добавить("ID_COMPANY");
	ТаблицаДанных.Колонки.Добавить("IS_ACTIVE");
	
	
	Для каждого стр из ТаблицаДанных Цикл
		
		
		
		
		ЦенаНормЧаса =  Приемка.ДилерскийЦентр.Автосервис_Нормочас.Цена;
		Цена = ПолучитьЦенуРаботы(стр.Авторабота, Заявка);
		Если Цена = 0 Тогда
			Попытка
				Цена = окр(стр.ВремяВыполнения * Приемка.ДилерскийЦентр.Автосервис_Нормочас.Цена,2);
			Исключение
				Цена = Приемка.ДилерскийЦентр.Автосервис_Нормочас.Цена;	
			КонецПопытки;
		КонецЕсли;
		Коэфф = ПолучитьКоэффициентСложностиРаботы(стр.Авторабота);
		Если Коэфф>0 Тогда
			Цена = Окр(Цена*Коэфф,2);
			ЦенаНормЧаса = Окр(ЦенаНормЧаса*Коэфф,2);
 
		КонецЕсли;
		табСвязРабот = Новый ТаблицаЗначений;
		табСвязРабот = ПолучитьЦеныСвязанныхРабот(стр.Авторабота, Заявка) ;
		Если табСвязРабот.Количество()>0 Тогда
			Для Каждого стр1 из табСвязРабот Цикл
				Цена = Цена + стр1.Цена * стр1.Количество;
			КонецЦикла;
			стр.NAME = "Комплекс " + стр.NAME; 
		КонецЕсли;	
		
		
		стр.Цена = Цена;
		стр.ЦенаНормЧаса = ЦенаНормЧаса;

		стр.Price 		= Формат(Цена, "ЧДЦ=2; ЧРД=.; ЧГ=0");
		стр.GUID 		= Новый УникальныйИдентификатор();
		стр.ID_WORK 	= стр.Авторабота.УникальныйИдентификатор();
		стр.OperationID = Приемка.УникальныйИдентификатор();
		стр.IS_ACTIVE 	= 1;
		стр.ID_COMPANY  = Приемка.ДилерскийЦентр.УникальныйИдентификатор();
	КонецЦикла;
	
		
	Возврат ТаблицаДанных;
	
КонецФункции

// ----------------------------------------
Функция ПолучитьКоэффициентСложностиРаботы(Авторабота, ВидРемонта = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(ВидРемонта) Тогда
		
		Гарантия = РегистрыСведений.Renault_ВидыРемонтаДопРеквизиты.ПолучитьГарантиюЗавода(ВидРемонта);
		
		Если Гарантия = Истина Тогда
			
			Возврат 1;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Коэффициент = 1;
	
	Если НЕ ЗначениеЗаполнено(Авторабота.Артикул) Тогда
		Возврат Коэффициент;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Справочник.Коэффициент
	|ИЗ
	|	РегистрСведений.OPERACODE_НормыРабот.СрезПоследних(&Период, КодПоКаталогу = &Артикул) КАК OPERACODE_НормыРаботСрезПоследних
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_КоэффициентыСложностиРабот КАК Справочник
	|ПО Справочник.СложностьРабот = OPERACODE_НормыРаботСрезПоследних.СложностьРабот";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Артикул", Авторабота.Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Коэффициент = Выборка.Коэффициент;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Коэффициент) Тогда
		
		Возврат Коэффициент;
		
	Иначе
		
		Возврат 1;
		
	КонецЕсли;
	
КонецФункции

// ----------------------------------------------------------------------------------------
Функция ПолучитьЦеныСвязанныхРабот(Авторабота, Заявка) Экспорт
	
	Рез = Новый ТаблицаЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	СвязанныеРаботы.Авторабота,
	               |	ВЫБОР
	               |		КОГДА СвязанныеРаботы.СвязаннаяРабота ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Запчасть,
	               |	СвязанныеРаботы.СвязаннаяРабота КАК Номенклатура,
	               |	СвязанныеРаботы.Модель, 0 КАК Цена, 
				   |	СвязанныеРаботы.ВариантКомплектации,
	               |	СвязанныеРаботы.Количество
	               |ИЗ
	               |	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
	               |ГДЕ
	               |	СвязанныеРаботы.Авторабота = &Авторабота
	               |	И (СвязанныеРаботы.Модель = &Модель
	               |			ИЛИ СвязанныеРаботы.Модель = ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка))
	               |	И (СвязанныеРаботы.ВариантКомплектации = &ВариантКомплектации
	               |			ИЛИ СвязанныеРаботы.ВариантКомплектации = ЗНАЧЕНИЕ(Справочник.ВариантыКомплектации.ПустаяСсылка))";
	
	Запрос.УстановитьПараметр("Авторабота", Авторабота);
	Запрос.УстановитьПараметр("Модель",  Заявка.Автомобиль.Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", Заявка.Автомобиль.ВариантКомплектации);
	
	Рез = Запрос.Выполнить().Выгрузить();
	Для Каждого стр1 из Рез Цикл
		Если не ЗначениеЗаполнено(стр1.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если стр1.Запчасть Тогда
			стр1.Цена =   ПолучитьЦенуНоменклатурыТОП(стр1.Номенклатура,Заявка);
			
		Иначе
			стр1.Цена = ПолучитьЦенуРаботы(стр1.Номенклатура, Заявка);
			стр1.Количество = 1;
			Если стр1.Цена = 0 Тогда
				Попытка
					стр1.Цена = стр1.Номенклатура.ВремяВыполнения * Заявка.ДилерскийЦентр.Автосервис_Нормочас.Цена;
				Исключение
					стр1.Цена = Заявка.ДилерскийЦентр.Автосервис_Нормочас.Цена;	
				КонецПопытки;
				
			КонецЕсли;
			Коэфф = ПолучитьКоэффициентСложностиРаботы(стр1.Номенклатура);
			Если Коэфф>0 Тогда
				стр1.Цена = Окр(стр1.Цена*Коэфф,2);
	 
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
				
	
	Возврат Рез;	
КонецФункции

