//Обязательные
//IPN
//Не обязательные
//PASSWORD, DISPLAY_NAME, ID_COMPANY
Функция ПолучитьТаблицуПользователей(Сотрудник = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_Автосервис_НастройкиСотрудниковПланшет.Логин КАК IPN,
	|	Renault_Автосервис_НастройкиСотрудниковПланшет.Пароль КАК PASSWORD,
	|	Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник.Наименование КАК DISPLAY_NAME,
	|	Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник.Ссылка КАК Ссылка,
	|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ДилерскийЦентр.Ссылка КАК ДЦ
	|ИЗ
	|	РегистрСведений.Renault_Автосервис_НастройкиСотрудниковПланшет КАК Renault_Автосервис_НастройкиСотрудниковПланшет
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	|		ПО Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник = Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник
	|ГДЕ
	|   (&ВсеСотрудники ИЛИ Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник = &Сотрудник)
	|	И Renault_Автосервис_НастройкиСотрудниковПланшет.Логин <> """"
	|	И Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ДилерскийЦентр <> ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
	Запрос.УстановитьПараметр("ВсеСотрудники", Сотрудник = Неопределено);
	
	ТаблицаМастеров = Запрос.Выполнить().Выгрузить();
	ТаблицаМастеров.Колонки.Добавить("ID_COMPANY", Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаМастеров.Колонки.Добавить("EMPLOYEE_ID_1C", Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	Для Каждого Зап Из ТаблицаМастеров Цикл
		Зап.ID_COMPANY = Зап.ДЦ.Уникальныйидентификатор();
		Зап.EMPLOYEE_ID_1C = Зап.Ссылка.УникальныйИдентификатор(); 
	КонецЦикла;
	
	ТаблицаМастеров.Колонки.Удалить("Ссылка");
	ТаблицаМастеров.Колонки.Удалить("ДЦ");
	Возврат ТаблицаМастеров;
	
КонецФункции

//Обязательные
//ClientID, FullName, ID_CLIENT_TYPE
//Не обязательные
//Surname, FirstName, Patronymic, MyRenault, Phone, PhoneAdditional, Email, DateBirth, Sex, INN, ADDRESS
Функция ПолучитьТаблицуКлиентов(Ссылка) 
	
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК FullName,
		|	ВЫБОР
		|		КОГДА Контрагенты.ФормаСобственности = ЗНАЧЕНИЕ(перечисление.ФормыСобственности.юридическоелицо)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ID_CLIENT_TYPE,
		|	Контрагенты.Фамилия КАК Surname,
		|	Контрагенты.Имя КАК FirstName,
		|	Контрагенты.Отчество КАК Patronymic,
		|	ЕСТЬNULL(Renault_ПользователиMyRenault.ЛогинMyRenault, """") КАК MyRenault,
		|	Контрагенты.ИНН КАК INN,
		|	ВЫРАЗИТЬ(ЮрАдрес.Представление КАК СТРОКА(255)) КАК ADDRESS,
		|	Контрагенты.ДатаРождения КАК DateBirth
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиMyRenault КАК Renault_ПользователиMyRenault
		|		ПО (Renault_ПользователиMyRenault.Контрагент = Контрагенты.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ЮрАдрес
		|		ПО Контрагенты.Ссылка = ЮрАдрес.Объект
		|			И (ЮрАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
		|ГДЕ
		|	Контрагенты.Ссылка = &Ссылка";
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	CRM_ПотенциальныеКонтрагенты.Ссылка КАК Ссылка,
		|	CRM_ПотенциальныеКонтрагенты.Наименование КАК FullName,
		|	ВЫБОР
		|		КОГДА CRM_ПотенциальныеКонтрагенты.ФормаСобственности = ЗНАЧЕНИЕ(перечисление.ФормыСобственности.юридическоелицо)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ID_CLIENT_TYPE,
		|	CRM_ПотенциальныеКонтрагенты.Фамилия КАК Surname,
		|	CRM_ПотенциальныеКонтрагенты.Имя КАК FirstName,
		|	CRM_ПотенциальныеКонтрагенты.Отчество КАК Patronymic,
		|	ЕСТЬNULL(Renault_ПользователиMyRenault.ЛогинMyRenault, """") КАК MyRenault,
		|	CRM_ПотенциальныеКонтрагенты.ИНН КАК INN,
		|	ВЫРАЗИТЬ(ЮрАдрес.Представление КАК СТРОКА(255)) КАК ADDRESS,
		|	CRM_ПотенциальныеКонтрагенты.ДатаРождения КАК DateBirth
		|ИЗ
		|	Справочник.CRM_ПотенциальныеКонтрагенты КАК CRM_ПотенциальныеКонтрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиMyRenault КАК Renault_ПользователиMyRenault
		|		ПО (Renault_ПользователиMyRenault.Контрагент = CRM_ПотенциальныеКонтрагенты.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ЮрАдрес
		|		ПО CRM_ПотенциальныеКонтрагенты.Ссылка = ЮрАдрес.Объект
		|			И (ЮрАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
		|ГДЕ
		|	CRM_ПотенциальныеКонтрагенты.Ссылка = &Ссылка";
		
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Renault_CRM_ПриемкаАвтомобиля.Клиент.Ссылка КАК Ссылка,
		|	Renault_CRM_ПриемкаАвтомобиля.Клиент.Наименование КАК FullName,
		|	ВЫБОР
		|		КОГДА Renault_CRM_ПриемкаАвтомобиля.Клиент.ФормаСобственности = ЗНАЧЕНИЕ(перечисление.ФормыСобственности.юридическоелицо)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ID_CLIENT_TYPE,
		|	Renault_CRM_ПриемкаАвтомобиля.Клиент.Фамилия КАК Surname,
		|	Renault_CRM_ПриемкаАвтомобиля.Клиент.Имя КАК FirstName,
		|	Renault_CRM_ПриемкаАвтомобиля.Клиент.Отчество КАК Patronymic,
		|	ЕСТЬNULL(Renault_ПользователиMyRenault.ЛогинMyRenault, """") КАК MyRenault,
		|	Renault_CRM_ПриемкаАвтомобиля.Клиент.ИНН КАК INN,
		|	ВЫРАЗИТЬ(ЮрАдрес.Представление КАК СТРОКА(255)) КАК ADDRESS,
		|	Renault_CRM_ПриемкаАвтомобиля.Клиент.ДатаРождения КАК DateBirth
		|ИЗ
		|	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиMyRenault КАК Renault_ПользователиMyRenault
		|		ПО (Renault_ПользователиMyRenault.Контрагент = Renault_CRM_ПриемкаАвтомобиля.Клиент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ЮрАдрес
		|		ПО Renault_CRM_ПриемкаАвтомобиля.Клиент = ЮрАдрес.Объект
		|			И (ЮрАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
		|ГДЕ
		|	Renault_CRM_ПриемкаАвтомобиля.Ссылка = &Ссылка";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаДанных.Колонки.Добавить("ClientID", Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("Phone", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("PhoneAdditional", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("Email", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	//ТаблицаДанных.Колонки.Добавить("DateBirth", Новый ОписаниеТипов("Дата",,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТаблицаДанных.Колонки.Добавить("Sex", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	
	Для Каждого Строка Из ТаблицаДанных Цикл
		
		Строка.Surname = ЛЕВ(СтрЗаменить(Строка.Surname, """", ""), 50);
		Строка.FirstName = ЛЕВ(СтрЗаменить(Строка.FirstName, """", ""),50);
		Строка.Patronymic = ЛЕВ(СтрЗаменить(Строка.Patronymic, """", ""), 50);
		Строка.FullName = ЛЕВ(СтрЗаменить(Строка.FullName, """", ""), 150);
		Строка.ClientID = Строка.Ссылка.УникальныйИдентификатор();
		Строка.Phone = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Строка.Ссылка);
		Строка.Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Строка.Ссылка);
		
		//Строка.DateBirth = Формат(Строка.ДатаРождения,"ДФ=yyyy-MM-dd");
		Если СтрДлина(Строка.MyRenault)>3 тогда
			Строка.MyRenault = "1";
		Иначе
			Строка.MyRenault = "0";
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаДанных.Колонки.Удалить("Ссылка");
	//ТаблицаДанных.Колонки.Удалить("ДатаРождения");
	
	Возврат ТаблицаДанных;
	
КонецФункции

