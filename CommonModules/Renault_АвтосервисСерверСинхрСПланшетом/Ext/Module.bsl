//Обязательные
//ID, NAME, ID_COMPANY
Функция ПолучитьТаблицуБрендов(ДЦ,Автомобиль = Неопределено)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("NAME", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("ID_COMPANY",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	
	УИД_МаркиАвто = "";
	ИмяМаркиАвто = "";
	Если Автомобиль = Неопределено Тогда
		Выборка = Справочники.CRM_МаркаАвтомобиля.Выбрать();
		Пока Выборка.Следующий() Цикл 
			Если Выборка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			СтрокаТЗ = ТаблицаДанных.Добавить();
			СтрокаТЗ.ID = Выборка.Ссылка.УникальныйИдентификатор();
			СтрокаТЗ.NAME = Выборка.Наименование;
			СтрокаТЗ.ID_COMPANY = Строка(ДЦ.Ссылка.УникальныйИдентификатор());
		КонецЦикла;
		
		СтрокаТЗ = ТаблицаДанных.Добавить();
		СтрокаТЗ.ID = "";
		СтрокаТЗ.NAME = "Бренд не указан";
		СтрокаТЗ.ID_COMPANY = Строка(ДЦ.Ссылка.УникальныйИдентификатор());
		
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Ссылка,
		|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Ссылка.Наименование КАК Наименование
		|ИЗ
		|	Справочник.CRM_МаркаАвтомобиля.МоделиАвтомобилей КАК CRM_МаркаАвтомобиляМоделиАвтомобилей
		|ГДЕ
		|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Модель = &Модель";
		Запрос.УстановитьПараметр("Модель",Автомобиль.Модель);
		Выборка =  Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтрокаТЗ = ТаблицаДанных.Добавить();
			СтрокаТЗ.ID = Выборка.Ссылка.УникальныйИдентификатор();
			СтрокаТЗ.NAME = Выборка.Наименование;
			СтрокаТЗ.ID_COMPANY = Строка(ДЦ.Ссылка.УникальныйИдентификатор());
		Иначе
			СтрокаТЗ = ТаблицаДанных.Добавить();
			СтрокаТЗ.ID = "";
			СтрокаТЗ.NAME = "Бренд не указан";
			СтрокаТЗ.ID_COMPANY = Строка(ДЦ.Ссылка.УникальныйИдентификатор());
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаДанных.Свернуть("ID,NAME,ID_COMPANY");
	
	Возврат ТаблицаДанных;
	
КонецФункции

