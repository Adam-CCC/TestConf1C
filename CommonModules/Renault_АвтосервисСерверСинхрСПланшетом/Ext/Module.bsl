	Команда = "[dbo].[DMS_VOC_GETCOMMENTS] '" + СокрЛП(BIR) + "'," 
		+ Формат(Год(ДатаНач),"ЧГ=0") + "," + Формат(Месяц(ДатаНач),"ЧГ=0") + "," + Формат(День(ДатаНач),"ЧГ=0");
	
	Итог = ВебСервис.CommandToSQLwRet(BIR,Команда);
	Таблица = СериализаторXDTO.ПрочитатьXDTO(Итог);
	
