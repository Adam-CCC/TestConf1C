Функция ВернутьТекстЗапросаДляПланшета(cТаблицДанных,Command) Экспорт
	
	Параметры = ПолучитьСтруктуруПолей(Command);
	ЗапросКБазе = "";
	СтрокаПараметров = "";
	ЭтоПервДанные = Истина;
	Для Каждого Параметр ИЗ Параметры Цикл
		
		ТаблицаДанных = cТаблицДанных[Параметр.Ключ];
		Если ТипЗнч(ТаблицаДанных) = Тип("ТаблицаЗначений") И ТаблицаДанных.Количество()>0 Тогда
			ЗапросКБазе = ЗапросКБазе + Символы.ПС + "DECLARE @"+Параметр.Ключ+" " + Параметр.Значение+ Символы.ПС+ "INSERT @"+Параметр.Ключ;
		Иначе
			ЗапросКБазе = ЗапросКБазе + Символы.ПС + "DECLARE @"+Параметр.Ключ+" " + Параметр.Значение;
			Продолжить;
		КонецЕсли;
				//Если ЭтоПервДанные Тогда
		//	ЭтоПервДанные = Ложь;
		//Иначе
		//	ЗапросКБазе =ЗапросКБазе+", "+Символы.ПС;
		//КонецЕсли;
		ЗапросКБазе = ЗапросКБазе + " (";
		ЭтоПервКолонка = истина;
		Для Каждого Кол Из ТаблицаДанных.Колонки Цикл
			Если ЭтоПервКолонка Тогда
				ЭтоПервКолонка = Ложь;
			Иначе
				ЗапросКБазе = ЗапросКБазе + ", ";
			КонецЕсли;
			ЗапросКБазе =ЗапросКБазе + Кол.Имя;
		КонецЦикла;
		ЗапросКБазе= ЗапросКБазе+") "+Символы.ПС+"VALUES ";
		ЭтоПервДанные = Истина;
		Для Каждого Данные Из ТаблицаДанных Цикл
			Если ЭтоПервДанные Тогда
				ЭтоПервДанные = Ложь;
			Иначе
				ЗапросКБазе =ЗапросКБазе+", "+Символы.ПС;
			КонецЕсли;
			ЗапросКБазе = ЗапросКБазе + "(";
			ЭтоПервКолонка = истина;
			Для Каждого Кол Из ТаблицаДанных.Колонки Цикл
				Если ЭтоПервКолонка Тогда
					ЭтоПервКолонка = Ложь;
				Иначе
					ЗапросКБазе = ЗапросКБазе + ", ";
				КонецЕсли;
				СтрокаВставки = Данные[Кол.Имя];
				Если ТипЗнч(СтрокаВставки) =  Тип("Строка") Тогда
					СтрокаВставки = ДанныеВЗапрос(СтрокаВставки,3);
				ИначеЕсли  ТипЗнч(СтрокаВставки) =  Тип("Число") Тогда
					СтрокаВставки = ДанныеВЗапрос(СтрЗаменить(СтрокаВставки,Символы.НПП,""),0);
				ИначеЕсли  ТипЗнч(СтрокаВставки) =  Тип("Дата") Тогда
					СтрокаВставки = ДанныеВЗапрос(СтрЗаменить(СтрокаВставки,Символы.НПП,""),1);
				ИначеЕсли  ТипЗнч(СтрокаВставки) =  Тип("Булево") Тогда
					СтрокаВставки = ДанныеВЗапрос(СтрЗаменить(СтрокаВставки,Символы.НПП,""),4);
				ИначеЕсли ТипЗнч(СтрокаВставки) = Тип("УникальныйИдентификатор") Тогда
					СтрокаВставки = "CONVERT(uniqueidentifier,"+ДанныеВЗапрос(Строка(СтрокаВставки),2)+")";
				ИначеЕсли ТипЗнч(СтрокаВставки) = Тип("Неопределено") Тогда
					СтрокаВставки = ДанныеВЗапрос(Строка(СтрокаВставки),5);
				Иначе
					СтрокаВставки = ДанныеВЗапрос(Строка(СтрокаВставки),2);
				КонецЕсли;
				
				ЗапросКБазе = ЗапросКБазе + СтрокаВставки;		
				
			КонецЦикла; 
			ЗапросКБазе = ЗапросКБазе +")"
		КонецЦикла;
	КонецЦикла;
	ЗапросКБазе = ЗапросКБазе +Символы.ПС + "EXEC " + Command +Символы.ПС;
	ЭтоПервПараметр = Истина;
	для Каждого Параметр из Параметры Цикл
		Если ЭтоПервПараметр Тогда
			ЭтоПервПараметр = Ложь;
		Иначе
			ЗапросКБазе =ЗапросКБазе+", "+Символы.ПС;
		КонецЕсли;
		ЗапросКБазе = ЗапросКБазе + "@"+Параметр.Ключ+" = @"+Параметр.Ключ;
	КонецЦикла;
	//Подключение.Execute(ЗапросКБазе);
	
	Возврат ЗапросКБазе;
	
КонецФункции

Функция ДанныеВЗапрос(ТекЗначение, ТипЗ = 0) Экспорт
	
	Если ТипЗ = 1 тогда //Дата , либо нулл
		Если Год(ТекЗначение) = 1 Тогда
			Возврат "NULL";
		Иначе
			Возврат "'" + Формат(Дата(ТекЗначение), "ДФ=""гггг-ММ-дд ЧЧ:мм:сс.000""") + "'";
		КонецЕсли;
	ИначеЕсли ТипЗ = 2 Тогда //Строка Либо Нул вместо пустой
		Если СтрДлина(ТекЗначение) = 0 Тогда
			Возврат "NULL";
		Иначе
			Возврат "'" + ТекЗначение + "'"; 
		КонецЕсли;
	ИначеЕсли ТипЗ = 3 Тогда //Строка 
		Возврат "'" + ТекЗначение + "'"; 
	ИначеЕсли ТипЗ = 4 Тогда //Булево
		Если ТекЗначение = Истина Тогда
			Возврат "'" + "True" + "'";
		Иначе
			Возврат "'" + "False" + "'";
		КонецЕсли;
	ИначеЕсли ТипЗ = 0 Тогда //Число
		Возврат СтрЗаменить(ТекЗначение,",",".");
		
	ИначеЕсли ТипЗ = 5 Тогда //Неопределено
		Возврат "Null";
	Иначе
		Возврат ТекЗначение;
	КонецЕсли;
	
КонецФункции

// Регламентное задание для повторной отправки приемок автомобилей на планшет
Процедура ВыгрузкаПриемокНаПланшет(ПараметрРегЗадания = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ОтправкаПриемкиВПланшет.Приемка,
		|	Renault_ОтправкаПриемкиВПланшет.КоличествоПопытокОтправки
		|ИЗ
		|	РегистрСведений.Renault_ОтправкаПриемкиВПланшет КАК Renault_ОтправкаПриемкиВПланшет
		|ГДЕ
		|	Renault_ОтправкаПриемкиВПланшет.Отправлена = ЛОЖЬ
		|	И Renault_ОтправкаПриемкиВПланшет.КоличествоПопытокОтправки < 5";
		
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВебСервис = ПолучитьВебСервисПоПланшету();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Попытка 
			ВыгрузитьОднуПриемкуВПланшет(ВебСервис,Выборка.Приемка);
		Исключение
			МенеджерЗаписей = РегистрыСведений.Renault_ОтправкаПриемкиВПланшет.СоздатьМенеджерЗаписи();
			МенеджерЗаписей.Приемка = Выборка.Приемка;
			МенеджерЗаписей.Отправлена = Ложь;
			МенеджерЗаписей.ТекстОшибки = ОписаниеОшибки();
			МенеджерЗаписей.КоличествоПопытокОтправки = Выборка.КоличествоПопытокОтправки + 1;
			МенеджерЗаписей.Записать();
		КонецПопытки;	
	КонецЦикла;	
	
КонецПроцедуры

