Функция ПолучитьЦенуРаботы(Авторабота, Заявка)
	
	Попытка
		
		Свойство = обПолучитьЗначениеСвойства(Авторабота, ПланыВидовХарактеристик.СвойстваОбъектов._ПризнакКомплекса);
		Если НЕ Свойство Тогда
			
			Возврат 0;
			
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;
	
	РаботаСсылка = Авторабота.Ссылка; 				 
	ДлитРаб = 0;
	Если РаботаСсылка.НормыВремени.Количество() = 0 Тогда
	 	ДлитРаб= РаботаСсылка.ВремяВыполнения;
	Иначе
		СтрокиТЧ = РаботаСсылка.НормыВремени.НайтиСтроки(Новый Структура("Модель,ВариантКомплектации",Заявка.Автомобиль.Модель,Заявка.Автомобиль.ВариантКомплектации));
		Если СтрокиТЧ.Количество() = 0 Тогда
			ДлитРаб = РаботаСсылка.ВремяВыполнения;
		Иначе
			ДлитРаб = СтрокиТЧ.Получить(0).ВремяВыполнения;
		КонецЕсли;
	КонецЕсли;
	Если ДлитРаб>0 и значениезаполнено(Заявка.ДилерскийЦентр) и значениезаполнено(Заявка.ДилерскийЦентр.Автосервис_Нормочас) Тогда
		Нормочас = Заявка.ДилерскийЦентр.Автосервис_Нормочас;
		Возврат Окр(ДлитРаб*Нормочас.Цена,2);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	

		
		Запрос.Текст = "ВЫБРАТЬ
		|	ЦеныАвтоработСрезПоследних.Период,
		|	ЦеныАвтоработСрезПоследних.Регистратор,
		|	ЦеныАвтоработСрезПоследних.НомерСтроки,
		|	ЦеныАвтоработСрезПоследних.Активность,
		|	ЦеныАвтоработСрезПоследних.ТипЦен,
		|	ЦеныАвтоработСрезПоследних.Авторабота,
		|	ЦеныАвтоработСрезПоследних.Модель,
		|	ЦеныАвтоработСрезПоследних.ДоговорВзаиморасчетов,
		|	ЦеныАвтоработСрезПоследних.Цех,
		|	ЦеныАвтоработСрезПоследних.ВидРемонта,
		|	ЦеныАвтоработСрезПоследних.Нормочас,
		|	ЦеныАвтоработСрезПоследних.Валюта,
		|	ЦеныАвтоработСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныАвторабот.СрезПоследних(
		|			,
		|			ВидРемонта = &ВидРемонта
		|				И Модель = &Модель
		|				И Авторабота = &Авторабота) КАК ЦеныАвтоработСрезПоследних";
		
		Запрос.УстановитьПараметр("Авторабота", Авторабота);
		Запрос.УстановитьПараметр("Модель",  Заявка.Автомобиль.Модель);
		Запрос.УстановитьПараметр("ВидРемонта", Заявка.ВидРемонта);
		
		Цены = Запрос.Выполнить().Выгрузить();
		
		Если Цены.Количество() > 0 Тогда
			
			Возврат Цены[0].Цена;
			
		Иначе
			
			Запрос.Текст = "ВЫБРАТЬ
			|	ЦеныАвтоработСрезПоследних.Период,
			|	ЦеныАвтоработСрезПоследних.Регистратор,
			|	ЦеныАвтоработСрезПоследних.НомерСтроки,
			|	ЦеныАвтоработСрезПоследних.Активность,
			|	ЦеныАвтоработСрезПоследних.ТипЦен,
			|	ЦеныАвтоработСрезПоследних.Авторабота,
			|	ЦеныАвтоработСрезПоследних.Модель,
			|	ЦеныАвтоработСрезПоследних.ДоговорВзаиморасчетов,
			|	ЦеныАвтоработСрезПоследних.Цех,
			|	ЦеныАвтоработСрезПоследних.ВидРемонта,
			|	ЦеныАвтоработСрезПоследних.Нормочас,
			|	ЦеныАвтоработСрезПоследних.Валюта,
			|	ЦеныАвтоработСрезПоследних.Цена
			|ИЗ
			|	РегистрСведений.ЦеныАвторабот.СрезПоследних(
			|			,
			|			ВидРемонта = &ВидРемонта
			|				И Авторабота = &Авторабота) КАК ЦеныАвтоработСрезПоследних";
			
			Цены = Запрос.Выполнить().Выгрузить();
			
			Если Цены.Количество() > 0 Тогда
				
				Возврат Цены[0].Цена;
				
			Иначе
				
				Запрос.Текст = "ВЫБРАТЬ
				|	ЦеныАвтоработСрезПоследних.ТипЦен,
				|	ЦеныАвтоработСрезПоследних.Авторабота,
				|	ЦеныАвтоработСрезПоследних.Нормочас,
				|	ЦеныАвтоработСрезПоследних.Цена
				|ИЗ
				|	РегистрСведений.ЦеныАвторабот.СрезПоследних(, Авторабота = &Авторабота) КАК ЦеныАвтоработСрезПоследних";
				
				Цены = Запрос.Выполнить().Выгрузить();
				
				Если Цены.Количество() > 0 Тогда
					
					Возврат Цены[0].Цена;
					
				Иначе
					
					Возврат 0;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	
	Цены = Запрос.Выполнить().Выгрузить();
	
	Если ЗначениеЗаполнено(Цены) Тогда
		
		Возврат Цены[0].Цена;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
	
КонецФункции


