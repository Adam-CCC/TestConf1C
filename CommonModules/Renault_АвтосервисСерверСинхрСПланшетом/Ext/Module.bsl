	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АвтомобилиСрезПоследних.Автомобиль,
	               |	АвтомобилиСрезПоследних.Период
	               |ИЗ
	               |	РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	               |ГДЕ
	               |	АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)
	               |	И АвтомобилиСрезПоследних.Автомобиль.VIN = &VIN";
	Запрос.УстановитьПараметр("VIN",ВРЕГ(VIN));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество()>0 Тогда
		Рез = Истина;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

Функция ОчиститьКавычкиVOC(стр1,симвКав="""") Экспорт
	с1 = стр1;
	Если Лев(с1,1)=симвКав и стрДлина(с1)>1 Тогда
		c1 = Прав(с1,СтрДлина(с1)-1);
	КонецЕсли;
	
	Если Прав(с1,1)=симвКав и стрДлина(с1)>1 Тогда
		c1 = Лев(с1,СтрДлина(с1)-1);
	КонецЕсли;

	Возврат с1;		
	
КонецФункции

Процедура ПолучитьПоследниеЗаписиVOC() Экспорт
	
	выбДЦ = справочники.CRM_ДилерскиеЦентры.Выбрать();
	Пока выбДЦ.Следующий() Цикл
		Если выбДЦ.ПометкаУдаления или значениезаполнено(выбДЦ.BIR)=Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ПослДата = ПолучитьПоследнююДатуИнтервьюVOC(выбДЦ.BIR);
		Попытка
			т1 = ВебСервисПолучитьТаблицуVOC(выбДЦ.BIR,ПослДата);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Для каждого с1 из т1 Цикл
			Попытка
				// записываем комментарии VOC только если VIN уже есть в базе
				Если АвтомобильVOCсуществуетвбазе(ОчиститьКавычкиVOC(с1["VEH_VIN"])) Тогда
					 новЗапись = РегистрыСведений.Renault_VOCКомментарииКлиента.СоздатьМенеджерЗаписи();
					 новЗапись.VIN = ОчиститьКавычкиVOC(с1["VEH_VIN"]);
					 новЗапись.ДатаОпроса = с1["INTERVIEW_DATE"];
					 новЗапись.ДатаЗаказНаряда = с1["WORKORDER_DATE"];
					 новЗапись.КодОпроса = ОчиститьКавычкиVOC(с1["INTERVIEW_CODE"]);
					 новЗапись.ВолнаОпроса = ОчиститьКавычкиVOC(с1["WAVE"]);
					 новЗапись.КодДилера = ОчиститьКавычкиVOC(с1["DEALER_BIR"]);
					 новЗапись.BIR = ОчиститьКавычкиVOC(с1["DEALER_BIR"]);
					 новЗапись.Комментарий = ОчиститьКавычкиVOC(с1["CommentText"]);
					 новЗапись.ДатаПоследнегоПоказа = Дата(1,1,1,0,0,0);
					 новЗапись.СчетчикПоказов = 0;
					 новЗапись.Записать();
				КонецЕсли;
			Исключение
			КонецПопытки;	 
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПоследниеТриКомментарияVOC(BIR,VIN) Экспорт
	
	Рез = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 3
	               |	Renault_VOCКомментарииКлиента.ДатаЗаказНаряда,
	               |	Renault_VOCКомментарииКлиента.VIN,
	               |	Renault_VOCКомментарииКлиента.ДатаОпроса,
	               |	Renault_VOCКомментарииКлиента.КодОпроса,
	               |	Renault_VOCКомментарииКлиента.ВолнаОпроса,
	               |	Renault_VOCКомментарииКлиента.КодДилера,
	               |	Renault_VOCКомментарииКлиента.BIR,
	               |	Renault_VOCКомментарииКлиента.Комментарий,
	               |	Renault_VOCКомментарииКлиента.ДатаПоследнегоПоказа,
	               |	Renault_VOCКомментарииКлиента.СчетчикПоказов
	               |ИЗ
	               |	РегистрСведений.Renault_VOCКомментарииКлиента КАК Renault_VOCКомментарииКлиента
	               |ГДЕ
	               |	Renault_VOCКомментарииКлиента.BIR = &BIR
	               |	И Renault_VOCКомментарииКлиента.VIN = &VIN
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Renault_VOCКомментарииКлиента.ДатаЗаказНаряда УБЫВ";
	
	Запрос.УстановитьПараметр("BIR",Лев(СокрЛП(BIR),8));
	Запрос.УстановитьПараметр("VIN",VIN);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез = Рез + Формат(Выборка.ДатаЗаказНаряда,"ДФ=""дд.ММ.гггг""") + " - " + Выборка.Комментарий + Символы.ПС + Символы.ПС;
	КонецЦикла;
	Возврат Рез;
		
КонецФункции

Функция ПолучитьВебСервисПоVOC2() Экспорт
	АдресWS	 = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].АдресWsCentral;
	ЛогинWS	 = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЛогинWSCentral;
	ПарольWS = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ПарольWsCentral;
	
	//удалим определение документа wsdl - его добавляем автоматически
	Адрес = АдресWS +"ws/RenaultPDRTab.1cws";
	Адрес = СтрЗаменить(Адрес, "?wsdl", "");
	
	Если Renault_ОбщегоНазначенияПовтИсп.Renault_Это83() Тогда
		
		ВЫПОЛНИТЬ("ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + ""?wsdl"", СокрЛП(ЛогинWS), СокрЛП(ПарольWS),,15)");
		

		
	Иначе
		
		ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
		СокрЛП(ЛогинWS), СокрЛП(ПарольWS),15);
		
	КонецЕсли;
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/RenaultPDRTab",ВСОпределение.Сервисы[0].Имя,ВСОпределение.Сервисы[0].ТочкиПодключения[0].Имя);     
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	Возврат ВебСервис;
	
	
	
КонецФункции

Функция ВебСервисПолучитьТаблицуVOCЗаМесяц(BIR,ДатаНачМесяца) Экспорт 
	
	Таблица = Новый ТаблицаЗначений;
	
	ВебСервис = ПолучитьВебСервисПоVOC2();
	сОтбора = Новый Структура;
	сОтбора.Вставить("DEALER_BIR", BIR); 
	сОтбора.Вставить("BeginMonth", НачалоМесяца(ДатаНачМесяца)); 
	ТаблицаVOC = ВебСервис.GetStock(BIR, "dbo.view_DMS_VOC_GET_COMMENTS", СериализаторXDTO.ЗаписатьXDTO(сОтбора), Истина, СериализаторXDTO.ЗаписатьXDTO(Новый Структура()));
	Таблица = СериализаторXDTO.ПрочитатьXDTO(ТаблицаVOC);
	
	Возврат Таблица;
 	
КонецФункции

Функция ВебСервисПолучитьТаблицуПоBIR(BIR) Экспорт 
	
	Таблица = Новый ТаблицаЗначений;
	
	ВебСервис = ПолучитьВебСервисПоVOC2();
	сОтбора = Новый Структура;
	сОтбора.Вставить("DEALER_BIR", BIR); 
	
	ТаблицаVOC = ВебСервис.GetStock(BIR, "dbo.view_DMS_VOC_BIR_Range", СериализаторXDTO.ЗаписатьXDTO(сОтбора), Истина, СериализаторXDTO.ЗаписатьXDTO(Новый Структура()));
	Таблица = СериализаторXDTO.ПрочитатьXDTO(ТаблицаVOC);
	
	Возврат Таблица;
 	
КонецФункции


Процедура ПолучитьПоследниеЗаписиVOC2(Параметр1 = Неопределено) Экспорт
	
	выбДЦ = справочники.CRM_ДилерскиеЦентры.Выбрать();
	Пока выбДЦ.Следующий() Цикл
		Если выбДЦ.ПометкаУдаления или значениезаполнено(выбДЦ.BIR)=Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			тМинМакс = ВебСервисПолучитьТаблицуПоBIR(Лев(СокрЛП(выбДЦ.BIR),8));
		Исключение
			Продолжить;
		КонецПопытки;
		
		ПослДата = ПолучитьПоследнююДатуИнтервьюVOC(Лев(СокрЛП(выбДЦ.BIR),8));

		датаМинVOC = ПослДата;
		датаМаксVOC = ТекущаяДата();
		
		Если тМинМакс<>Неопределено Тогда
			Если тМинМакс.Количество()>0 Тогда 
				// получаем мин и макс даты интервью с сервера
				Попытка
					датаМинVOC = Дата(тМинМакс[0].FirstDate);
					датаМаксVOC = Дата(тМинМакс[0].LastDate);
				Исключение
					//  приходят некорректные мин макс даты
					Продолжить;
				КонецПопытки;
			Иначе
				//  по Биру нет данных VOC вообще
				Продолжить;
			КонецЕсли;
		Иначе
			Продолжить;

		КонецЕсли;
			
				
		ДатаМесЗагрузки = ПослДата;
		Если  датаМинVOC>ДатаМесЗагрузки Тогда
			ДатаМесЗагрузки = датаМинVOC;
		КонецЕсли;
		ДатаМесЗагрузки = НачалоМесяца(ДатаМесЗагрузки);
		датаМаксVOC = КонецМесяца(датаМаксVOC);
		
		Пока ДатаМесЗагрузки<=датаМаксVOC Цикл
		
			Попытка
				т1 = ВебСервисПолучитьТаблицуVOCЗаМесяц(Лев(СокрЛП(выбДЦ.BIR),8),ДатаМесЗагрузки);
			Исключение
				ДатаМесЗагрузки=датаМаксVOC+1;
				Продолжить;
			КонецПопытки;
			следМесяц = ДатаМесЗагрузки;
			Для каждого с1 из т1 Цикл
				Попытка
					// записываем комментарии VOC только если VIN уже есть в базе
					Если АвтомобильVOCсуществуетвбазе(ОчиститьКавычкиVOC(с1["VEH_VIN"])) Тогда
						 новЗапись = РегистрыСведений.Renault_VOCКомментарииКлиента.СоздатьМенеджерЗаписи();
						 новЗапись.VIN = ОчиститьКавычкиVOC(с1["VEH_VIN"]);
						 новЗапись.ДатаОпроса = с1["INTERVIEW_DATE"];
						 новЗапись.ДатаЗаказНаряда = с1["WORKORDER_DATE"];
						 новЗапись.КодОпроса = ОчиститьКавычкиVOC(с1["INTERVIEW_CODE"]);
						 новЗапись.ВолнаОпроса = ОчиститьКавычкиVOC(с1["WAVE"]);
						 новЗапись.КодДилера = ОчиститьКавычкиVOC(с1["DEALER_BIR"]);
						 новЗапись.BIR = ОчиститьКавычкиVOC(с1["DEALER_BIR"]);
						 новЗапись.Комментарий = ОчиститьКавычкиVOC(с1["CommentText"]);
						 новЗапись.ДатаПоследнегоПоказа = Дата(1,1,1,0,0,0);
						 новЗапись.СчетчикПоказов = 0;
						 новЗапись.Записать();
					КонецЕсли;
					
				Исключение
					ДатаМесЗагрузки=датаМаксVOC+1;
					Продолжить;
				КонецПопытки;
				Попытка 
					следМесяц = Дата(с1["NEXTMONTH"]);
				Исключение
					следМесяц = NULL;
				КонецПопытки;
			КонецЦикла;
			Если следМесяц = NULL Тогда
				ДатаМесЗагрузки=НачалоМесяца(ДобавитьМесяц(ДатаМесЗагрузки,1));
			Иначе
				ДатаМесЗагрузки=НачалоМесяца(следМесяц);
			КонецЕсли;
			
		КонецЦикла;  //  получение таблицы за месяц		
	КонецЦикла;
	
	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ПолучитьПоследниеЗаписиVOC"),
	ТекущаяДатаСеанса());
	
КонецПроцедуры


Процедура СинхронизацияСлотовОнлайнЗаписи(Параметр1 = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ДилерскиеЦентры.Ссылка //,
	               |	//CRM_ДилерскиеЦентры.Наименование
	               |ИЗ
	               |	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	               |ГДЕ
	               |	CRM_ДилерскиеЦентры.Бренд = &Бренд";
		
	Запрос.УстановитьПараметр("Бренд", Справочники.CRM_МаркаАвтомобиля.RENAULT);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если не ЗначениеЗаполнено(Выборка.Ссылка["DMD"]) Или СтрДлина(сокрлп(Выборка.Ссылка["DMD"]))<>8 Тогда
			Продолжить;
		КонецЕсли;
	
		Обработка = Обработки.Renault_ПланированиеОнлайнЗаписиСервис.Создать();
		Обработка.ДилерскийЦентр = Выборка.Ссылка;
		Обработка.BIRDMD = сокрлп(Выборка.Ссылка["DMD"]);
		КодОшибки=0;
		Обработка.ЗагрузитьсСервераНаСервере(КодОшибки);
		Если КодОшибки<>0 Тогда
			Обработка = Неопределено;
			Продолжить;
		КонецЕсли;
		Для каждого таймслот из Обработка.КалендариСервис Цикл
			Рез = Обработка.СинхронизироватьРезервПоСлотуКалендаря(таймслот.ГУИДзаписи);
		КонецЦикла;
		Обработка.ОсвободитьРезервыНаДниМеньшеНачалаЗаписи();
		Обработка = Неопределено;
	КонецЦикла;
	
	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ОбновитьДанныеОнлайнЗаписи"),
	ТекущаяДатаСеанса());
	
КонецПроцедуры

