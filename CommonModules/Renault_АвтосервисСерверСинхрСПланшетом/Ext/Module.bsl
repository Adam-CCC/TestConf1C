Функция ПолучитьТаблицуФаз(ДЦ,Автомобиль = Неопределено) 
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаДанных.Колонки.Добавить("NAME",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	ТаблицаДанных.Колонки.Добавить("ID_COMPANY",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_АвтомобилиДопРеквизиты.Фаза
	|ИЗ
	|	РегистрСведений.Renault_АвтомобилиДопРеквизиты КАК Renault_АвтомобилиДопРеквизиты
	|ГДЕ
	|	(&НеОтбиратьПоАвто
	|			ИЛИ Renault_АвтомобилиДопРеквизиты.Автомобиль = &Автомобиль)";
	
	Запрос.УстановитьПараметр("НеОтбиратьПоАвто", Автомобиль = Неопределено);
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	Результат = Запрос.Выполнить();
	Если не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Фаза.пустая() Тогда 
				Продолжить;
			КонецЕсли;
