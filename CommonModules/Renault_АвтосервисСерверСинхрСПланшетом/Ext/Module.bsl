	ТаблицаМашиноместо = Новый ТаблицаЗначений;
	ТаблицаМашиноместо.Колонки.Добавить("EmployeeID",Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаМашиноместо.Колонки.Добавить("FullName",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	стрДанных = ТаблицаМашиноместо.Добавить();
	стрДанных.EmployeeID = Машиноместо.УникальныйИдентификатор();
	стрДанных.FullName   = Машиноместо.Наименование;
	
	сТаблицОтправки = Новый Структура;
	сТаблицОтправки.Вставить("DATA",ТаблицаМашиноместо);
	
	ВыполнитьХранимуюПроцедуру(BIR, ВебСервис,сТаблицОтправки,"dbo.RF_R_PRC_EMPLOYEE_SYNC");
	
КонецПроцедуры	

