Функция ПолучитьТаблицуСвязаннойНоменклатурыТОП(Заявка,ТаблицаТОПРабот) Экспорт
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	т1.Авторабота КАК Авторабота
	               |ПОМЕСТИТЬ таб2
	               |ИЗ
	               |	&Автоработы КАК т1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СвязанныеРаботы.Авторабота,
	               |	СвязанныеРаботы.СвязаннаяРабота КАК Номенклатура,
	               |	СвязанныеРаботы.Модель,
	               |	СвязанныеРаботы.ВариантКомплектации,
	               |	СвязанныеРаботы.Количество,
	               |	ЕСТЬNULL(т1.Цена, 0) КАК Цена
	               |ИЗ
	               |	РегистрСведений.СвязанныеРаботы КАК СвязанныеРаботы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ таб2 КАК таб2
	               |		ПО СвязанныеРаботы.Авторабота = таб2.Авторабота
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
	               |			ЦеныСрезПоследних.Цена КАК Цена
	               |		ИЗ
	               |			РегистрСведений.Цены.СрезПоследних(&ТекущаяДата, ) КАК ЦеныСрезПоследних
	               |		ГДЕ
	               |			ЦеныСрезПоследних.ТипЦен = &ТипЦен
	               |			И ВЫБОР
	               |					КОГДА &УчитыватьПодразделение
	               |						ТОГДА ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпании
	               |								ИЛИ ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпанииРодитель
	               |					ИНАЧЕ ИСТИНА
	               |				КОНЕЦ) КАК т1
	               |		ПО (СвязанныеРаботы.СвязаннаяРабота ССЫЛКА Справочник.Номенклатура)
	               |			И (т1.Номенклатура = СвязанныеРаботы.СвязаннаяРабота)
	               |ГДЕ
	               |	СвязанныеРаботы.СвязаннаяРабота ССЫЛКА Справочник.Номенклатура";
	 Запрос.УстановитьПараметр("Автоработы", ТаблицаТОПРабот);
	Запрос.УстановитьПараметр("ТипЦен", Заявка.ТипЦен);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Если ЗначениеЗаполнено(Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен) И 
			Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен = Истина 
			  И значениеЗаполнено(Заявка.ЗаказНаряд) и ЗначениеЗаполнено(Заявка.ЗаказНаряд.ПодразделениеКомпании) Тогда
			  
		Запрос.УстановитьПараметр("УчитыватьПодразделение", Заявка.ДилерскийЦентр.Автосервис_УчитыватьПодразделениеВТипеЦен);
		Запрос.УстановитьПараметр("ПодразделениеКомпании", Заявка.ЗаказНаряд.ПодразделениеКомпании);
		Запрос.УстановитьПараметр("ПодразделениеКомпанииРодитель", Заявка.ЗаказНаряд.ПодразделениеКомпании.Родитель);
	  
			  
	Иначе
	    Запрос.УстановитьПараметр("УчитыватьПодразделение", ЛОЖЬ);
		Запрос.УстановитьПараметр("ПодразделениеКомпании", Справочники.ПодразделенияКомпании.ПустаяСсылка());
		Запрос.УстановитьПараметр("ПодразделениеКомпанииРодитель", Справочники.ПодразделенияКомпании.ПустаяСсылка());

	КонецЕсли;
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаДанных;	
КонецФункции

