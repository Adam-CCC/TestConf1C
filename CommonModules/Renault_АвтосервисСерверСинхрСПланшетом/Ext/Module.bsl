				СтрокаТз.ID_COMPANY = Строка(ДЦ.Ссылка.УникальныйИдентификатор());
				СтрокаТз.ID = Новый УникальныйИдентификатор(Сред(ЗначениеВСтрокуВнутр(Перечисления.Renault_ПриводАвтомобиля),6,35)+"3");
			Иначе
				СтрокаТЗ = ТаблицаДанных.Добавить();
				СтрокаТЗ.ID = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
