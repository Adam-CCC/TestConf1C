Функция ПолучитьИспользованиеПланшета_Подробно(ИДДилера, ДатаНачала, ДатаОкончания, ИсполнительИД) Экспорт
	
	Попытка
		
		ВебСервис = ПолучитьВебСервисПоПланшету();
		Сериал = новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
		Итог = ВебСервис.GetTabletUsage_Details(Строка(ИДДилера),ДатаНачала,ДатаОкончания,ИсполнительИД);
		Таблица = Сериал.ПрочитатьXDTO(Итог);
		Если Таблица.Колонки.Количество() = 0 Тогда
			Таблица.Колонки.Добавить("FullName");
			Таблица.Колонки.Добавить("OperationID");
			Таблица.Колонки.Добавить("StartTime");
			Таблица.Колонки.Добавить("EndTime");
			Таблица.Колонки.Добавить("TabletAll");
			Таблица.Колонки.Добавить("TabletWithResult");
		КонецЕсли;
		Таблица.Колонки.Добавить("Приемка");
		Таблица.Колонки.Добавить("Заявка");
		Таблица.Колонки.Добавить("ЗН");
		Для Каждого Стр ИЗ Таблица Цикл
			Если ЗначениеЗаполнено(Стр.OperationID) Тогда
				Стр.Приемка = Документы.Renault_CRM_ПриемкаАвтомобиля.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.OperationID));
			КонецЕсли;
			Если ЗначениеЗаполнено(Стр.ORDER_ID) Тогда
				Заявка = Документы.Renault_CRM_ЗаявкаНаСервис.ПолучитьСсылку(Новый УникальныйИдентификатор(Стр.ORDER_ID));
				Стр.Заявка = Заявка.Номер;
				Стр.ЗН = Заявка.ЗаказНаряд.Номер;
			КонецЕсли;
		КонецЦикла;
		Возврат Таблица;
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
		Возврат Новый ТаблицаЗначений();
		
	КонецПопытки;
	
КонецФункции



