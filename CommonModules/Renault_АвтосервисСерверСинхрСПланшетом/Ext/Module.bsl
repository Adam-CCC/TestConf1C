Функция ЗагрузитьИзмененияЗаказНаряда(BIR,ВебСервис,СсылкаНаПриемку) экспорт
	
		Заявка = Документы.Renault_CRM_ЗаявкаНаСервис.НайтиПоРеквизиту("Обращение", СсылкаНаПриемку.Обращение);
		
		Если НЕ ЗначениеЗаполнено(Заявка) Тогда
			Возврат Истина;
		КонецЕсли;
		
		Отбор = Новый Структура();
		Отбор.Вставить("ID_PUCHASE_ORDER", Строка(Заявка.Ссылка.УникальныйИдентификатор()));
		РаботыНаПланшете = ПолучитьТаблицуСОтборомПоПараметрам(BIR, "dbo.PURCHASE_ORDER_WORKS", Отбор, Ложь, Новый Структура(), ВебСервис);
		
		Отбор = Новый Структура();
		Отбор.Вставить("ID_PUCHASE_ORDER", Строка(Заявка.Ссылка.УникальныйИдентификатор()));
		ЗапчастиНаПланшете = ПолучитьТаблицуСОтборомПоПараметрам(BIR, "dbo.PURCHASE_ORDER_PARTS", Отбор, Ложь, Новый Структура(), ВебСервис);

		
		ЗаявкаДок = Заявка.ПолучитьОбъект();
		Для каждого Стр из РаботыНаПланшете Цикл
			РаботаСсылка =  Справочники.Автоработы.ПолучитьСсылку(Новый УникальныйИдентификатор(ОчиститьID(стр.ID_WORK)));
			Если не значениезаполнено(РаботаСсылка) Тогда
				Продолжить;
			КонецЕсли;
			Если ЗаявкаДок.Работы.Найти(РаботаСсылка,"Работа")=Неопределено Тогда
				 НоваяСтрока = ЗаявкаДок.Работы.Добавить();
				 НоваяСтрока.Работа = РаботаСсылка;
				 НоваяСтрока.IDРаботы = Строка(РаботаСсылка.УникальныйИдентификатор());
				 НоваяСтрока.Нормочас = СсылкаНаПриемку.ДилерскийЦентр.Автосервис_Нормочас;
				 НоваяСтрока.Коэффициент = ПолучитьКоэффициентСложностиРаботы(РаботаСсылка) ;
				 ДлитРаб = 0;
				 Если РаботаСсылка.НормыВремени.Количество() = 0 Тогда
				 	ДлитРаб= РаботаСсылка.ВремяВыполнения;
				 Иначе
					СтрокиТЧ = РаботаСсылка.НормыВремени.НайтиСтроки(Новый Структура("Модель,ВариантКомплектации",Заявка.Автомобиль.Модель,Заявка.Автомобиль.ВариантКомплектации));
					Если СтрокиТЧ.Количество() = 0 Тогда
						ДлитРаб = РаботаСсылка.ВремяВыполнения;
					Иначе
						ДлитРаб = СтрокиТЧ.Получить(0).ВремяВыполнения;
					КонецЕсли;
				КонецЕсли;
				НоваяСтрока.Длительность = ДлитРаб;
				НоваяСтрока.ДлительностьЗН = ДлитРаб;
				 
				 				 
				 табСвязРабот = Новый ТаблицаЗначений;
				 табСвязРабот = ПолучитьЦеныСвязанныхРабот(РаботаСсылка, Заявка) ;
				 
				 Если табСвязРабот.Количество()>0 Тогда
					 //  Это комплекс
					НоваяСтрока.Цена  = ПолучитьЦенуРаботы(РаботаСсылка,Заявка);
					Если НоваяСтрока.Цена = 0 Тогда
						Попытка
							НоваяСтрока.Цена = РаботаСсылка.ВремяВыполнения * Заявка.ДилерскийЦентр.Автосервис_Нормочас.Цена;
						Исключение
							НоваяСтрока.Цена = Заявка.ДилерскийЦентр.Автосервис_Нормочас.Цена;	
						КонецПопытки;
					КонецЕсли;
					
			 		Если НоваяСтрока.Коэффициент>0 Тогда
						НоваяСтрока.Сумма = НоваяСтрока.Цена*НоваяСтрока.Коэффициент;
					Иначе
						
						НоваяСтрока.Сумма = НоваяСтрока.Цена;
					КонецЕсли;

				   	Для Каждого стр1 из табСвязРабот Цикл
						
						Если стр1.Запчасть Тогда
							НоваяСтрока1 = ЗаявкаДок.Товары.Добавить();
							НоваяСтрока1.Количество =  стр1.Количество;
							НоваяСтрока1.Номенклатура = стр1.Номенклатура;
							НоваяСтрока1.Сумма = стр1.Цена*стр1.Количество ;
							НоваяСтрока1.Цена = стр1.Цена;
						Иначе
							НоваяСтрока1 = ЗаявкаДок.Работы.Добавить();
							НоваяСтрока1.Работа = стр1.Номенклатура;
							НоваяСтрока1.IDРаботы = Строка(стр1.Номенклатура.УникальныйИдентификатор());
				 			НоваяСтрока1.Нормочас = СсылкаНаПриемку.ДилерскийЦентр.Автосервис_Нормочас;
							НоваяСтрока1.Коэффициент = ПолучитьКоэффициентСложностиРаботы(стр1.Номенклатура) ;	
							
							НоваяСтрока1.Цена  = стр1.Цена;
			 				НоваяСтрока1.Длительность  = стр1.Авторабота.ВремяВыполнения;	
							НоваяСтрока1.Сумма = окр(стр1.Цена*НоваяСтрока1.Коэффициент,2) ;


						КонецЕсли;
				 								
				 	КонецЦикла;
					
				 Иначе
					// это обычная работа
					
					НоваяСтрока.Сумма = Стр.PRICE;
					Если ДлитРаб>0 Тогда
				 		НоваяСтрока.Цена  = ОКР(НоваяСтрока.Сумма/ДлитРаб,2);
					Иначе
						НоваяСтрока.Цена  = НоваяСтрока.Сумма;
					КонецЕсли;
					Если НоваяСтрока.Коэффициент>0 Тогда 
						НоваяСтрока.Цена  = ОКР(НоваяСтрока.Цена/НоваяСтрока.Коэффициент,2);
					КонецЕсли;
					
				 	
					Если НоваяСтрока.Цена=0 Тогда
						
						НоваяСтрока.Цена = ПолучитьЦенуРаботы(РаботаСсылка,Заявка);
						Если НоваяСтрока.Цена = 0 Тогда
							Попытка
								НоваяСтрока.Цена = РаботаСсылка.ВремяВыполнения * Заявка.ДилерскийЦентр.Автосервис_Нормочас.Цена;
							Исключение
								НоваяСтрока.Цена = Заявка.ДилерскийЦентр.Автосервис_Нормочас.Цена;	
							КонецПопытки;
						КонецЕсли;
						Если НоваяСтрока.Коэффициент>0 Тогда
							НоваяСтрока.Сумма = НоваяСтрока.Цена*НоваяСтрока.Коэффициент;
						Иначе
							
							НоваяСтрока.Сумма = НоваяСтрока.Цена;
						КонецЕсли;

					КонецЕсли;						
										
					
					
				 КонецЕсли;	

						 
				 
			КонецЕсли;
		КонецЦикла;
		
		Для каждого Стр из ЗапчастиНаПланшете Цикл
			РаботаСсылка =  Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ОчиститьID(стр.ID_PART)));
			Если не значениезаполнено(РаботаСсылка) Тогда
				Продолжить;
			КонецЕсли;
			Если ЗаявкаДок.Товары.Найти(РаботаСсылка,"Номенклатура")=Неопределено Тогда
				НоваяСтрока = ЗаявкаДок.Товары.Добавить();
				НоваяСтрока.Количество = Стр.QUANTITY;
				НоваяСтрока.Номенклатура = РаботаСсылка;
				НоваяСтрока.Сумма = Стр.PRICE*НоваяСтрока.Количество ;
				НоваяСтрока.Цена = Стр.PRICE;
				Если НоваяСтрока.Цена=0 Тогда
					НоваяСтрока.Цена = ПолучитьЦенуНоменклатурыТОП(РаботаСсылка,Заявка);
					НоваяСтрока.Сумма = НоваяСтрока.Цена*НоваяСтрока.Количество;
				КонецЕсли;						
				Если НоваяСтрока.Количество=0 Тогда
					НоваяСтрока.Количество = 1;
					НоваяСтрока.Сумма = НоваяСтрока.Цена*НоваяСтрока.Количество;
				КонецЕсли;				
				
			КонецЕсли;
		КонецЦикла;

		
		ЗаявкаДок.Записать();
			
			//Если ЗначениеЗаполнено(ЗаявкаДок.ЗаказНаряд) Тогда
			//	Renault_АвтосервисОбщий.Reanult_ОбновитьСформироватьЗаказНаряд(ЗаявкаДок.ЗаказНаряд, ЗаявкаДок.Ссылка, Ложь);
			//Иначе
			//	ЗаказНаряд = Renault_АвтосервисОбщий.Reanult_ОбновитьСформироватьЗаказНаряд(Неопределено, ЗаявкаДок.Ссылка, Ложь);
			//	Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
			//		ЗаявкаДок.ЗаказНаряд = ЗаказНаряд.Ссылка;
			//		ЗаявкаДок.Записать();
			//	КонецЕсли;
			//КонецЕсли;
