Функция ПолучитьСписокПрав(Пользователь) Экспорт
	
	Зап = Новый Запрос("ВЫБРАТЬ
	                   |	*
	                   |ИЗ
	                   |	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПраваИНастройкиПользователей КАК Renault_ПраваИНастройкиПользователей
	                   |		ПО Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки = Renault_ПраваИНастройкиПользователей.Ссылка
	                   |ГДЕ
	                   |	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь");
	Зап.УстановитьПараметр("Пользователь", Пользователь);
	Шаблоны = Зап.Выполнить().Выгрузить();
	
	Ответ = Новый Структура();
	Для Каждого Колонка Из Шаблоны.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		Если Колонка.ТипЗначения.СодержитТип(Тип("ТаблицаЗначений")) Тогда
			//Таблицу значений хранить в параметрах сеанса нельзя
			//Если ИмяКолонки = "Автосклад_ДоступныеДилерскиеЦентры" Тогда				
			//	Ответ.Вставить(ИмяКолонки, Шаблоны[0][ИмяКолонки].ВыгрузитьКолонку("ДилерскийЦентр"));
			//ИначеЕсли ИмяКолонки = "Автосклад_ДоступныеСчета" Тогда				
			//	Ответ.Вставить(ИмяКолонки, Шаблоны[0][ИмяКолонки].ВыгрузитьКолонку("Счет"));
			//ИначеЕсли ИмяКолонки = "Автосклад_ДоступныеСклады" Тогда				
			//	Ответ.Вставить(ИмяКолонки, Шаблоны[0][ИмяКолонки].ВыгрузитьКолонку("Склад"));
			//КонецЕсли;
		ИначеЕсли Колонка.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			МассивЗнач = Шаблоны.ВыгрузитьКолонку(ИмяКолонки);                           
			Если МассивЗнач.Найти(Истина) = Неопределено Тогда
				Ответ.Вставить(ИмяКолонки, Ложь);
			Иначе
				Ответ.Вставить(ИмяКолонки, Истина);
			КонецЕсли;
		Иначе
			Если Шаблоны.Количество() > 0 Тогда
				Ответ.Вставить(ИмяКолонки, Шаблоны[0][ИмяКолонки]);
			Иначе
				Ответ.Вставить(ИмяКолонки, Неопределено);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Релиз = Метаданные.Версия;
	Поиск = Найти(Релиз, ".");
	Версия = "";
	Если Поиск > 1 Тогда
		Версия = Лев(Релиз, Поиск -1);
	КонецЕсли;
	Ответ.Вставить("ВерсияАльфаАвто", Версия);
	Ответ.Вставить("РелизАльфаАвто", Релиз);
	
	Возврат Новый ФиксированнаяСтруктура(Ответ);
	
КонецФункции

