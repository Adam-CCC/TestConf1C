Функция ЕстьПравоКорпПродажи(Пользователь) экспорт
	
	Зап = Новый Запрос;
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
		Зап.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.РазрешитьРаботуСАРМКорпоративныхПродаж, ЛОЖЬ) КАК РазрешитьРаботуСАРМКорпоративныхПродаж,
		|	ЕСТЬNULL(Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.РазрешитьРасботуСАРМРуководителяКП, ЛОЖЬ) КАК РазрешитьРасботуСАРМРуководителяКП
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
	Иначе
		Зап.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.РазрешитьРаботуСАРМКорпоративныхПродаж, ЛОЖЬ) КАК РазрешитьРаботуСАРМКорпоративныхПродаж,
		|	ЕСТЬNULL(Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.РазрешитьРасботуСАРМРуководителяКП, ЛОЖЬ) КАК РазрешитьРасботуСАРМРуководителяКП
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник = &Пользователь";
	КонецЕсли;
	
	Зап.УстановитьПараметр("Пользователь", Пользователь);
	Шаблоны = Зап.Выполнить().Выбрать();
	ЕстьПраво = Ложь;
	Пока Шаблоны.Следующий() Цикл
		Если Шаблоны.РазрешитьРаботуСАРМКорпоративныхПродаж Или Шаблоны.РазрешитьРасботуСАРМРуководителяКП Тогда
			ЕстьПраво = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьПраво;
	
КонецФункции

