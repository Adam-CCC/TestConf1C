Функция ПолучитьПравоРено(Пользователь, Право) Экспорт
	
	Итог = Ложь;
	Если Право = "РазрешитьРаботуСАРМРесепшн" Тогда
		Итог = ЕстьПравоИспользоватьАрмРесепшена(Пользователь);
	ИначеЕсли Право = "РазрешитьРаботуСАРММенеджера" Тогда
		Итог = ЕстьПравоИспользоватьАрмМенеджера(Пользователь);
	ИначеЕсли Право = "РазрешитьРаботуСАРМРуководителя" Тогда
		Итог = ЕстьПравоИспользоватьАрмРОП(Пользователь);
	ИначеЕсли Право = "ПравоНаПодтверждениеДокументаТестДрайв" Тогда
		Итог = ЕстьПравоНаПодтверждениеДокументаТестДрайв(Пользователь);
	ИначеЕсли Право = "ОтделПоУмолчанию" Тогда
		Итог = ОтделПоУмолчанию(Пользователь);
	ИначеЕсли Право = "ДилерскийЦентрПоУмолчанию" Тогда
		Итог = ДилерскийЦентрПоУмолчанию(Пользователь);
	ИначеЕсли Право = "ЗапускатьПриСтартеАРМРесепшн" Тогда
		Итог = ЗапускатьПриСтартеАрмРесепшен(Пользователь);
	ИначеЕсли Право = "ЗапускатьПриСтартеАРММенеджера" Тогда
		Итог = ЗапускатьПриСтартеАрмМенеджера(Пользователь);
	ИначеЕсли Право = "ЗапускатьПриСтартеАРМРуководителя" Тогда
		Итог = ЗапускатьПриСтартеАрмРОП(Пользователь);
	ИначеЕсли Право = "РазрешитьРаботуСПанельюСообщений" Тогда
		Итог = ЕстьПравоИспользоватьПанельСообщений(Пользователь);
	ИначеЕсли Право = "ЗапускатьПриСтартеПанельСообщений" Тогда
		Итог = ЗапускатьПриСтартеПанельСообщений(Пользователь);
	Иначе
		Итог = Ложь;
	КонецЕсли;
	Возврат Итог;
	
КонецФункции

Функция ПолучитьСтруктуруНастроекАвтосклад(Пользователь=Неопределено) Экспорт
	Ответ=Новый Структура;
	Ответ.Вставить("ИспользоватьОтборПоДилерскимЦентрам", Ложь);
	Ответ.Вставить("ИспользоватьОтборПоСчетам", Ложь);
	Ответ.Вставить("ИспользоватьОтборПоСкладам", Ложь);
	Ответ.Вставить("ИспользоватьОтборПоАдресамОтгрузкиАвтоВПроизводстве", Ложь);
	Ответ.Вставить("ДоступныеДилерскиеЦентры", Неопределено);
	Ответ.Вставить("ДоступныеСчета", Неопределено);
	Ответ.Вставить("ДоступныеСклады", Неопределено);
	Ответ.Вставить("ДоступныеАдресаОтгрузки", Неопределено);
	Ответ.Вставить("ТипЦен", Справочники.ТипыЦен.ПустаяСсылка());
	Если Пользователь=Неопределено Тогда Возврат Ответ КонецЕсли;
	
	Запрос=Новый Запрос("Выбрать ПраваИНастройки Из РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек ГДЕ Пользователь=&Пользователь");
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ответ.Вставить("ИспользоватьОтборПоДилерскимЦентрам", Выборка.ПраваИНастройки.Автосклад_ИспользоватьОтборПоДилерскимЦентрам);
		Ответ.Вставить("ИспользоватьОтборПоАдресамОтгрузкиАвтоВПроизводстве", Выборка.ПраваИНастройки.Автосклад_ИспользоватьОтборПоАдресамОтгрузкиАвтоВПроизводстве); //DMSCOR-1475
		Ответ.Вставить("ИспользоватьОтборПоСчетам", Выборка.ПраваИНастройки.Автосклад_ИспользоватьОтборПоСчетам);
		Ответ.Вставить("ИспользоватьОтборПоСкладам", Выборка.ПраваИНастройки.Автосклад_ИспользоватьОтборПоСкладам);
		Ответ.Вставить("ДоступныеДилерскиеЦентры", Выборка.ПраваИНастройки.Автосклад_ДоступныеДилерскиеЦентры.ВыгрузитьКолонку("ДилерскийЦентр"));
		Ответ.Вставить("ДоступныеСчета", Выборка.ПраваИНастройки.Автосклад_ДоступныеСчета.ВыгрузитьКолонку("Счет"));
		Ответ.Вставить("ДоступныеСклады", Выборка.ПраваИНастройки.Автосклад_ДоступныеСклады.ВыгрузитьКолонку("Склад"));
		Ответ.Вставить("ТипЦен", Выборка.ПраваИНастройки.ДилерскийЦентр.ТипЦенПродажи);
		Ответ.Вставить("ДоступныеАдресаОтгрузки", Выборка.ПраваИНастройки.Автосклад_ДоступныеАдресаОтгрузок.ВыгрузитьКолонку("АдресОтгрузки"));
	КонецЕсли;	
	Возврат Ответ	
КонецФункции

Функция ПолучитьТипЦенКП(ДилерскийЦентр = неопределено) Экспорт
	
	Если Не (ДилерскийЦентр = неопределено) Тогда
		Если (ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка()) Тогда
			Возврат Константы.CRM_ТипЦенКП.Получить();
		Иначе
			Если ДилерскийЦентр.ТипЦенКП = Справочники.ТипыЦен.ПустаяСсылка() Тогда
				Возврат Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
			Иначе
				Возврат ДилерскийЦентр.ТипЦенКП;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Возврат Константы.CRM_ТипЦенКП.Получить();
	КонецЕсли;
	
