Функция ПолучитьСписокСкладов() Экспорт

	МассивНаименованийСкладов = Новый Массив;

	МассивНаименованийСкладов.Добавить("Престиж Моторс ООО (Вавилова 59К) Зап части Основной CHERY");
	МассивНаименованийСкладов.Добавить("Автоком-Дон ООО (Гамма) Зап части");
	МассивНаименованийСкладов.Добавить("Атлант Моторс ООО (Гамма) Зап части");
	МассивНаименованийСкладов.Добавить("Гамма Моторс ООО (Гамма) Зап части");
	МассивНаименованийСкладов.Добавить("Корандо Шахты ООО (Гамма) Зап части");
	МассивНаименованийСкладов.Добавить("Престиж Моторс ООО (Гамма) Зап части");
	МассивНаименованийСкладов.Добавить("Рента Кар ООО (Гамма) Зап части");
	МассивНаименованийСкладов.Добавить("Рента Кар ООО (Шолохова 237) Зап части BAIC");
	МассивНаименованийСкладов.Добавить("Престиж Моторс ООО (Шолохова 235) Зап части CHERY");
	МассивНаименованийСкладов.Добавить("Рента Кар ООО (Шолохова 237) Зап части KAIYI");
	МассивНаименованийСкладов.Добавить("Атлант Моторс ООО (Шолохова 237) Зап части JAC");
	МассивНаименованийСкладов.Добавить("Атлант Моторс ООО (Шолохова 237) Зап части CHANGAN");

	МассивСкладов = Новый Массив;

	Для Каждого НаименованиеСклада Из МассивНаименованийСкладов Цикл

		Склад = Справочники.СкладыКомпании.НайтиПоНаименованию(НаименованиеСклада, Истина);

		Если Склад.Пустая() Тогда
			ВызватьИсключение "Не найден склад: " + НаименованиеСклада;
		КонецЕсли;

		МассивСкладов.Добавить(Склад);

	КонецЦикла;

	Возврат МассивСкладов;

КонецФункции

Функция СформироватьИтоговыеДанные() Экспорт

	МассивСкладов = ПолучитьСписокСкладов();

	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Номенклатура");
	ТаблицаРезультата.Колонки.Добавить("Производитель");
	ТаблицаРезультата.Колонки.Добавить("Артикул");
	ТаблицаРезультата.Колонки.Добавить("Наличие");
	ТаблицаРезультата.Колонки.Добавить("ОптоваяЦена");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склады", МассивСкладов);
	Запрос.УстановитьПараметр("Коэффициент", 5);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток) КАК Наличие
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|	И Остатки.СкладКомпании В (&Склады)
	|	И НЕ Остатки.Номенклатура.ТипНоменклатуры.ВедетсяМаркировка
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Партии.Номенклатура КАК Номенклатура,
	|	СУММА(Партии.СуммаОстаток) КАК СП,
	|	СУММА(Партии.КоличествоОстаток) КАК КП
	|ПОМЕСТИТЬ ВТПартии
	|ИЗ
	|	РегистрНакопления.ПартииТоваровКомпании.Остатки КАК Партии
	|ГДЕ
	|	Партии.СкладКомпании В (&Склады)
	|
	|СГРУППИРОВАТЬ ПО
	|	Партии.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Номенклатура.Производитель КАК Производитель,
	|	Остатки.Номенклатура.Артикул КАК Артикул,
	|	Остатки.Наличие КАК Наличие,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Партии.КП, 0) > 0
	|			ТОГДА (Партии.СП / Партии.КП) * (1 + &Коэффициент / 100)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОптоваяЦена
	|ИЗ
	|	ВТОстатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПартии КАК Партии
	|		ПО Остатки.Номенклатура = Партии.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Номенклатура";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = ТаблицаРезультата.Добавить();

		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Производитель = Выборка.Производитель;
		НоваяСтрока.Артикул = Выборка.Артикул;
		НоваяСтрока.Наличие = Выборка.Наличие;
		НоваяСтрока.ОптоваяЦена = Выборка.ОптоваяЦена;

	КонецЦикла;

	Возврат ТаблицаРезультата;

КонецФункции

Функция СформироватьExcelОтчета(ТаблицаДанных) Экспорт

	ТабДок = Новый ТабличныйДокумент;

	ТабДок.Область(1, 1).Текст = "Производитель";
	ТабДок.Область(1, 2).Текст = "Наименование номенклатуры";
	ТабДок.Область(1, 3).Текст = "Артикул";
	ТабДок.Область(1, 4).Текст = "Оптовая цена";
	ТабДок.Область(1, 5).Текст = "Наличие";

	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");

	НомерСтроки = 2;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		ТабДок.Область(НомерСтроки, 1).Текст = Строка(СтрокаДанных.Производитель);
		ТабДок.Область(НомерСтроки, 2).Текст = Строка(СтрокаДанных.Номенклатура);
		ТабДок.Область(НомерСтроки, 3).Текст = Строка(СтрокаДанных.Артикул);

		ЯчейкаЦены = ТабДок.Область(НомерСтроки, 4);
		ЯчейкаЦены.СодержитЗначение = Истина;
		ЯчейкаЦены.ТипЗначения = ОписаниеТипаЧисло;
		ЯчейкаЦены.Значение = СтрокаДанных.ОптоваяЦена;
		ЯчейкаЦены.Формат = "ЧДЦ=2";

		ТабДок.Область(НомерСтроки, 5).Текст = Формат(СтрокаДанных.Наличие, "ЧДЦ=0");

		НомерСтроки = НомерСтроки + 1;

	КонецЦикла;

	ТабДок.Область(1, 1, 1, 5).Шрифт = Новый Шрифт(, , Истина);
	ТабДок.Область(1, 1, НомерСтроки - 1, 1).ШиринаКолонки = 25;
	ТабДок.Область(1, 2, НомерСтроки - 1, 2).ШиринаКолонки = 50;
	ТабДок.Область(1, 3, НомерСтроки - 1, 3).ШиринаКолонки = 20;
	ТабДок.Область(1, 4, НомерСтроки - 1, 4).ШиринаКолонки = 18;
	ТабДок.Область(1, 5, НомерСтроки - 1, 5).ШиринаКолонки = 15;

	ПутьКФайлу = ПолучитьИмяВременногоФайла("xlsx");

	ТабДок.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);

	Возврат ПутьКФайлу;

КонецФункции

Процедура ОтправитьОтчетПоПочте(ПутьКФайлу) Экспорт

	СоединениеСПочтовымСервером = Неопределено;

	Попытка

		ФайлОтчета = Новый Файл(ПутьКФайлу);

		Если Не ФайлОтчета.Существует() Тогда
			ВызватьИсключение "Не найден файл для отправки: " + ПутьКФайлу;
		КонецЕсли;

		ЭлПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();

		// Первый получатель
		АдресПочты1 = "supplier@as61.ru";

		СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
		СтрокаПолучатели.АдресЭлектроннойПочты = АдресПочты1;
		СтрокаПолучатели.Представление = АдресПочты1;
		СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;

		// Второй получатель
		АдресПочты2 = "melnikov_vv@pridecars.ru";

		СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
		СтрокаПолучатели.АдресЭлектроннойПочты = АдресПочты2;
		СтрокаПолучатели.Представление = АдресПочты2;
		СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;

		ЭлПисьмо.ПолучателиПредставление = АдресПочты1 + "; " + АдресПочты2;

		// Добавление Excel-файла
		ДвДанные = Новый ДвоичныеДанные(ПутьКФайлу);

		ФайлВложение = ЭлПисьмо.ПрикрепленныеФайлы.Добавить();
		ФайлВложение.Файл = Новый ХранилищеЗначения(ДвДанные);
		ФайлВложение.Размер = ФайлОтчета.Размер();
		ФайлВложение.Имя = "ОтчетПоПрайсу.xlsx";

		ЭлПисьмо.ЕстьВложения = Истина;

		ЭлПисьмо.ТекстПисьма = "Во вложении отчет по прайсу.";
		ЭлПисьмо.Тема = "Отчет по прайсу";

		ЭлПисьмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.Альфа;
		ЭлПисьмо.Организация = ПараметрыСеанса.Пользователь.Организация;
		ЭлПисьмо.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;
		ЭлПисьмо.Автор = ПараметрыСеанса.Пользователь;

		СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
		СтрокаСоединения = СтрЗаменить(СтрокаСоединения, ";", Символы.ПС);

		Если Найти(ВРег(СтрокаСоединения), "FILE=") = 1 Тогда
			ИмяИБ = СтрПолучитьСтроку(СтрокаСоединения, 1);
		Иначе
			ИмяИБ = СтрПолучитьСтроку(СтрокаСоединения, 2);
		КонецЕсли;

		Если Не ПустаяСтрока(ИмяИБ) Тогда
			ИмяИБ = Сред(ИмяИБ, Найти(ИмяИБ, """") + 1);
		КонецЕсли;

		ЭлПисьмо.ОтправительПредставление = "Альфа-Авто" + " (" + Лев(ИмяИБ, СтрДлина(ИмяИБ) - 1) + ") <1c@sokolmotors.ru>";

		ЭлПисьмо.ГруппаПисем = Справочники.ГруппыПисемЭлектроннойПочты.НайтиПоНаименованию("Исходящие");
		ЭлПисьмо.Важность = Перечисления.Важность.Средняя;
		ЭлПисьмо.ДатаОтправления = ТекущаяДата();
		ЭлПисьмо.Дата = ТекущаяДата();
		ЭлПисьмо.ХозОперация = Справочники.ХозОперации.ЭлектронноеПисьмо;
		ЭлПисьмо.ФорматТекста = Перечисления.ФорматТекста.ПростойТекст;

		ЭлПисьмо.Записать();

		СтруктураРежимовОбмена = Новый Структура("Получить, Отправить", Ложь, Истина);

		СоединениеСПочтовымСервером = эпПодключитьсяКПочтовомуСерверу(
			ЭлПисьмо.УчетнаяЗапись,
			СтруктураРежимовОбмена);

		РезультатОтправки = эпОтправитьПисьмо(
			ЭлПисьмо.ЭтотОбъект,
			СоединениеСПочтовымСервером);

		эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
		СоединениеСПочтовымСервером = Неопределено;

	Исключение

		Если СоединениеСПочтовымСервером <> Неопределено Тогда
			Попытка
				эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
			Исключение
			КонецПопытки;
		КонецЕсли;

		ЗаписьЖурналаРегистрации(
			"SM_АвтоОтчетОстатков",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Процедура СформироватьИОтправитьОтчет() Экспорт

	Попытка

		// 1. Получаем итоговые данные по остаткам
		ТаблицаДанных = СформироватьИтоговыеДанные();

		Если ТаблицаДанных.Количество() = 0 Тогда
			ВызватьИсключение "Отчет не сформирован: нет данных по остаткам.";
		КонецЕсли;

		// 2. Формируем Excel-файл
		ПутьКФайлу = СформироватьExcelОтчета(ТаблицаДанных);

		// 3. Отправляем отчет получателям
		ОтправитьОтчетПоПочте(ПутьКФайлу);

	Исключение

		ЗаписьЖурналаРегистрации(
			"SM_АвтоОтчетОстатков",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка формирования или отправки отчета: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры