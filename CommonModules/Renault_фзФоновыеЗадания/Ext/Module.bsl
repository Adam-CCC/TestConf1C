// ОСНОВНЫЕ ПРОЦЕДУРЫ, РЕАЛИЗУЮЩИЕ АЛГОРИТМЫ РЕГЛАМЕНТНЫХ И ФОНОВЫХ ЗАДАНИЙ

// Выполняет допроведение документов по партионным регистрам
//
// Параметры:
//	СтруктураПараметров - Структура - Структура параметров
//
Процедура НапоминаниеПроСнятиеРезервов(СтруктураПараметров = Неопределено) Экспорт
	
	//приводим параметры к корректности
	Если ТипЗнч(СтруктураПараметров) <> Тип("Структура") Тогда
		СтруктураПараметров = Новый Структура;
	КонецЕсли;
	
	ЗаказыПокупателей = Неопределено;	
	СтруктураПараметров.Свойство("НапоминаниеЗаказыПокупателей", ЗаказыПокупателей);
	
	Если ЗаказыПокупателей<>Неопределено И ЗаказыПокупателей Тогда
		Обработки.АвтоматическоеСнятиеРезервов.СформироватьНапоминанияПроСнятиеРезервов();
	КонецЕсли;
	
КонецПроцедуры 

// Выполняет допроведение документов по партионным регистрам
//
// Параметры:
//	СтруктураПараметров - Структура - Структура параметров
//
Процедура АвтоматическоеСнятиеРезервов(СтруктураПараметров = Неопределено) Экспорт
	
	//приводим параметры к корректности
	Если ТипЗнч(СтруктураПараметров) <> Тип("Структура") Тогда
		СтруктураПараметров = Новый Структура;
	КонецЕсли;
	Если НЕ СтруктураПараметров.Свойство("ФормированиеНапоминаний") Тогда
		СтруктураПараметров.Вставить("ФормированиеНапоминаний", Ложь);
	Иначе	
		СтруктураПараметров.Вставить("ФормированиеНапоминаний", Истина);
	КонецЕсли;

	Обработки.Renault_АвтоматическоеСнятиеРезервовЗаказыПокупателей.ВыполнитьАвтоматическоеСнятиеРезервов(СтруктураПараметров);
	
КонецПроцедуры // ДопроведениеПоПартиям()

Процедура Renault_ОбновлениеРекламаций(СтруктураПараметров = Неопределено) Экспорт

	Renault_РекламацииСервер.ОбновитьСтатусыРекламаций();

	РегистрыСведений.DMS_МониторингРегламентныхЗаданий.ЗавершениеЗадания(
	ПредопределенноеЗначение("Справочник.DMS_НастройкаРегламентныхЗаданий.ОбновлениеРекламаций"),
	ТекущаяДатаСеанса());
КонецПроцедуры

