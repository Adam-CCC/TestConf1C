		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбращениеВАвтоСервис</dataPath>
			<field>ОбращениеВАвтоСервис</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Обращение в авто сервис</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>Contacting car service</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПриемкаАвтомобиля</dataPath>
			<field>ПриемкаАвтомобиля</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Приемка автомобиля</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>vehicle Acceptance</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК ОбращениеВАвтоСервис,
	Контрагенты.Ссылка КАК Контрагент,
	Renault_CRM_ОбращениеВАвтоСервис.Автомобиль
ПОМЕСТИТЬ ВТ_Обращение
ИЗ
	Справочник.Контрагенты КАК Контрагенты
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		ПО Контрагенты.Ссылка = Renault_CRM_ОбращениеВАвтоСервис.Клиент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Обращение.Контрагент КАК Контрагент,
	ВТ_Обращение.ОбращениеВАвтоСервис КАК ОбращениеВАвтоСервис,
	ВТ_Обращение.Автомобиль КАК Автомобиль,
	Renault_CRM_ВыдачаАвтомобиля.Ссылка КАК ВыдачаАвтомобиля,
	Renault_CRM_ПриемкаАвтомобиля.Ссылка КАК ПриемкаАвтомобиля,
	Renault_CRM_ПриемкаАвтомобиля.ВремяНачала,
	Renault_CRM_ВыдачаАвтомобиля.ВремяОкончания
ИЗ
	ВТ_Обращение КАК ВТ_Обращение
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
		ПО ВТ_Обращение.Контрагент = Renault_CRM_ВыдачаАвтомобиля.Клиент
			И ВТ_Обращение.Автомобиль = Renault_CRM_ВыдачаАвтомобиля.Автомобиль
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		ПО ВТ_Обращение.Автомобиль = Renault_CRM_ПриемкаАвтомобиля.Автомобиль
			И ВТ_Обращение.Контрагент = Renault_CRM_ПриемкаАвтомобиля.Клиент
ГДЕ
	(Renault_CRM_ВыдачаАвтомобиля.Ссылка ЕСТЬ NULL 
			ИЛИ Renault_CRM_ВыдачаАвтомобиля.ВремяОкончания &lt;= &amp;ВремяКон)
	И (Renault_CRM_ПриемкаАвтомобиля.Ссылка ЕСТЬ NULL 
			ИЛИ Renault_CRM_ПриемкаАвтомобиля.ВремяНачала &gt;= &amp;ВремяНач)
;

////////////////////////////////////////////////////////////////////////////////
УНИЧТОЖИТЬ ВТ_Обращение</query>
	</dataSet>
	<parameter>
		<name>ВремяКон</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Время кон</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>game time</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
	<parameter>
