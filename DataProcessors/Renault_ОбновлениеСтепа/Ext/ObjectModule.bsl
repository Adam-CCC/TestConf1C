//Процедура ВыполнитьДействияПриИзмененииВерсииCRM()
//Выполняет пошагово заданные действия в зависимости от версии CRM
//
Процедура ВыполнитьДействияПриИзмененииВерсииCRM()
	
	ВерсияCRM_Старая = Константы.CRM_Версия_Renault.Получить();
	ВерсияCRM_Новая = "1.1.9";
	
	Если ВерсияCRM_Старая <> ВерсияCRM_Новая Тогда
		
		Если ВерсияCRM_Новая = "0.9.14" Тогда
			
			Обработка = Обработки.Renault_ПереносНастроек.Создать();
			Обработка.НачатьПеренос();
			
		ИначеЕсли ВерсияCRM_Новая = "0.9.15" Тогда
						
			//Ничего не делаем
			
		ИначеЕсли ВерсияCRM_Новая = "1.1.0" Тогда
			
			//Ничего не делаем
			
		ИначеЕсли ВерсияCRM_Новая = "1.1.2" Тогда
			
			//Ничего не делаем
			
		ИначеЕсли ВерсияCRM_Новая = "1.1.2" Тогда
			
			//Ничего не делаем
			
		ИначеЕсли ВерсияCRM_Новая = "1.1.3" Тогда
			
			//Ничего не делаем
			
		ИначеЕсли ВерсияCRM_Новая = "1.2.2" Тогда
			
			//Ничего не делаем
			
		КонецЕсли;
		
		Константы.CRM_Версия_Renault.Установить(ВерсияCRM_Новая);
		
		//Временно
		Если ВерсияCRM_Старая = "0.9.12" ИЛИ ВерсияCRM_Старая = "0.9.13" ИЛИ ВерсияCRM_Старая = "0.9.14" Тогда		
			ВыполнитьКорректировкуРегистраКонтактнойИнформации();
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьТипыТрафикаВДЦ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	CRM_ДилерскиеЦентрыНастройкиРегистрацииТрафика.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры.НастройкиРегистрацииТрафика КАК CRM_ДилерскиеЦентрыНастройкиРегистрацииТрафика
	|ГДЕ
	|	CRM_ДилерскиеЦентрыНастройкиРегистрацииТрафика.ТипТрафика В (&МассивТипов)";
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Справочники.CRM_ТипТрафика.ЛидRenault);
	МассивТипов.Добавить(Справочники.CRM_ТипТрафика.Email);
	Запрос.УстановитьПараметр("МассивТипов", МассивТипов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДЦОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрокаТипыТрафика ИЗ ДЦОбъект.НастройкиРегистрацииТрафика Цикл
			Если СтрокаТипыТрафика.ТипТрафика = Справочники.CRM_ТипТрафика.ЛидRenault Тогда
				СтрокаТипыТрафика.ТипТрафика = Справочники.CRM_ТипТрафика.ЛидДилера;
			ИначеЕсли СтрокаТипыТрафика.ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
				СтрокаТипыТрафика.ТипТрафика = Справочники.CRM_ТипТрафика.EmailДилера;
			КонецЕсли;
		КонецЦикла;
		ДЦОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

