Процедура ПроверитьУзлыПлановОбмена() Экспорт
	
	Если Метаданные.ПланыОбмена.Найти("Renault_CRM") <> Неопределено Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Renault_CRM.Ссылка) КАК Количество
		|ИЗ
		|	ПланОбмена.Renault_CRM КАК Renault_CRM");
		КоличествоУзлов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Количество");
		
		Если КоличествоУзлов[0] < 2 тогда //Еще не создавали новые узлы
			ВыборкаПлановCRM = ПланыОбмена.Renault_CRM.Выбрать();
			
			Пока ВыборкаПлановCRM.Следующий() Цикл
				ПланОбъект = ВыборкаПлановCRM.ПолучитьОбъект();
				
				Если НЕ ЗначениеЗаполнено(ПланОбъект.Код) тогда
					
					//Это узел, который создается автоматически в качестве главного
					ПланОбъект.УстановитьНовыйКод();
					ПланОбъект.Наименование = "Эта база - В ОБМЕНЕ НЕ ИСПОЛЬЗОВАТЬ";
					ПланОбъект.Записать();
					
				КонецЕсли;
				
			КонецЦикла;
			
			//Теперь нужно создать новый узел, в котором будем собирать данные для отправки
			ПланОбъект = ПланыОбмена.Renault_CRM.СоздатьУзел();
			ПланОбъект.Наименование = "Автофрамос";
			ПланОбъект.УстановитьНовыйКод();
			ПланОбъект.Записать();
			Константы.Renault_ПланОбменаCRMПоУмолчанию.Установить(ПланОбъект.Ссылка);
			//Теперь выполним регистрацию объектов
			ПланыОбмена.ЗарегистрироватьИзменения(ПланОбъект.Ссылка);
		Иначе
			Если Не ЗначениеЗаполнено(Константы.Renault_ПланОбменаCRMПоУмолчанию.Получить()) Тогда
				ВыборкаПлановCRM = ПланыОбмена.Renault_CRM.Выбрать();
				
				Пока  ВыборкаПлановCRM.Следующий() Цикл
					Если Не( ВыборкаПлановCRM.Наименование = "Эта база - В ОБМЕНЕ НЕ ИСПОЛЬЗОВАТЬ") Тогда
						Константы.Renault_ПланОбменаCRMПоУмолчанию.Установить(ВыборкаПлановCRM.Ссылка);
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
