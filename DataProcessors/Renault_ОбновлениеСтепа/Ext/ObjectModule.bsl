// Процедура выполняет приведение регистра сведений "Контактная информация" к виду - 
// один клиент:один телефон по умолчанию, одна почта по умолчанию
// эти значения в дальнейшем используются во всех местах
Процедура ВыполнитьКорректировкуРегистраКонтактнойИнформации()
	
	Сообщить("Пожалуйста, подождите. Выполняются операции, связанные с обновлением программы.");
	
	// получим контрагентов и потенциальных контрагентов
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Клиент
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Потенциальные.Ссылка
	|ИЗ
	|	Справочник.CRM_ПотенциальныеКонтрагенты КАК Потенциальные";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	КоличествоОбщее = Выборка.Количество();
	Процент = Окр(КоличествоОбщее/100);
	НомерПроцента = 1;
	НомерКонтрагента = 0;
	
	// по каждому клиенту обработаем наборы КИ
	Пока Выборка.Следующий() Цикл
		
		///////Телефоны
		Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Выборка.Клиент);
		Набор.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Телефон);
		Набор.Прочитать();
		Набор.ОбменДанными.Загрузка = Истина;
		Если Набор.Количество() Тогда // есть телефоны
			
			ЕстьОсновнойТелефон = Ложь;
			ЗаписьОсновнойСотовый = Неопределено;
			ЗаписьСотовый = Неопределено;
			КоличествоОсновныхТелефонов = 0;
			
			Для Каждого Запись ИЗ Набор Цикл
				Если Запись.ЗначениеПоУмолчанию Тогда
					КоличествоОсновныхТелефонов = КоличествоОсновныхТелефонов + 1;
					Если Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый Тогда
						ЗаписьОсновнойСотовый = Запись;
					КонецЕсли;
				КонецЕсли;
				Если Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый Тогда
					ЗаписьСотовый = Запись;
				КонецЕсли;
			КонецЦикла;
			
			Если КоличествоОсновныхТелефонов = 1 Тогда
				
				// все ок, ничего не трогаем
				
			ИначеЕсли КоличествоОсновныхТелефонов > 1 Тогда
				
				Если ЗаписьОсновнойСотовый <> Неопределено Тогда
					Для Каждого Запись ИЗ Набор Цикл
						Если Запись.ЗначениеПоУмолчанию И Запись <> ЗаписьОсновнойСотовый Тогда
							Запись.ЗначениеПоУмолчанию = Ложь;
						КонецЕсли;
					КонецЦикла;
				Иначе //нет основого сотового, берем первый, у остальных снимаем признак
					ЕстьОсновнойТелефон = Ложь;
					Для Каждого Запись ИЗ Набор Цикл
						Если НЕ ЕстьОсновнойТелефон Тогда
							Если Запись.ЗначениеПоУмолчанию Тогда
								ЕстьОсновнойТелефон = Истина;
							КонецЕсли;
						Иначе // уже есть один основной
							Запись.ЗначениеПоУмолчанию = Ложь;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли КоличествоОсновныхТелефонов = 0 Тогда
				
				Если ЗаписьСотовый <> Неопределено Тогда
					ЗаписьСотовый.ЗначениеПоУмолчанию = Истина;
				Иначе
					Набор[0].ЗначениеПоУмолчанию = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			Набор.Записать();
			
		КонецЕсли;
		
		///////Почта
		Набор = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(Выборка.Клиент);
		Набор.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		Набор.Прочитать();
		Набор.ОбменДанными.Загрузка = Истина;

		Если Набор.Количество() Тогда // есть почта
			
			ЕстьОсновнойEmail = Ложь;
			ЗаписьОсновнойEmail = Неопределено;
			ЗаписьEmail = Неопределено;
			КоличествоОсновныхEmail = 0;
			
			Для Каждого Запись ИЗ Набор Цикл
				Если Запись.ЗначениеПоУмолчанию Тогда
					КоличествоОсновныхEmail = КоличествоОсновныхEmail + 1;
					Если Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний Тогда
						ЗаписьОсновнойEmail = Запись;
					КонецЕсли;
				КонецЕсли;
				Если Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний Тогда
					ЗаписьEmail = Запись;
				КонецЕсли;
			КонецЦикла;
			
			Если КоличествоОсновныхEmail = 1 Тогда
				
				// все ок, ничего не трогаем
				
			ИначеЕсли КоличествоОсновныхEmail > 1 Тогда
				
				Если ЗаписьОсновнойEmail <> Неопределено Тогда
					Для Каждого Запись ИЗ Набор Цикл
						Если Запись.ЗначениеПоУмолчанию И Запись <> ЗаписьОсновнойEmail Тогда
							Запись.ЗначениеПоУмолчанию = Ложь;
						КонецЕсли;
					КонецЦикла;
				Иначе //нет основой почты, берем первый, у остальных снимаем признак
					ЕстьОсновнойEmail = Ложь;
					Для Каждого Запись ИЗ Набор Цикл
						Если НЕ ЕстьОсновнойEmail Тогда
							Если Запись.ЗначениеПоУмолчанию Тогда
								ЕстьОсновнойEmail = Истина;
							КонецЕсли;
						Иначе // уже есть один основной
							Запись.ЗначениеПоУмолчанию = Ложь;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли КоличествоОсновныхEmail = 0 Тогда
				
				Если ЗаписьEmail <> Неопределено Тогда
					ЗаписьEmail.ЗначениеПоУмолчанию = Истина;
				Иначе
					Набор[0].ЗначениеПоУмолчанию = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			Набор.Записать();
			
		КонецЕсли;
		
		//НомерКонтрагента = НомерКонтрагента + 1;
		//Если НомерКонтрагента = Процент*НомерПроцента Тогда
		//	Сообщить("Обработано " + НомерПроцента + "%");
		//	НомерПроцента = НомерПроцента + 1;
		//ИначеЕсли НомерКонтрагента = КоличествоОбщее Тогда
