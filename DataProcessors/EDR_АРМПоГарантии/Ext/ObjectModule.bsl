	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПаттерныЗН КАК ПаттерныЗН
	|		ПО Инциденты.ЗаказНаряд = ПаттерныЗН.ЗаказНаряд
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТребоватьПричину КАК ВТТребоватьПричину
	|		ПО Инциденты.ИдентификаторИнцидента = ВТТребоватьПричину.ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТТребоватьПричину
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Инциденты"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	ФормаПрогресса.ЗначениеИндикатора = 4;
