Функция ПолучитьСписокТоваровПоИнвойсу(Инвойс)
	
	ЗаказНаряд = Инвойс.Ссылка;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	EDR_Invoices.Invoice КАК Счет,
	|	EDR_Interventions.Intervention,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.Номенклатура
	|		ИНАЧЕ EDR_ТоварыДоп.DiversCode.Наименование
	|	КОНЕЦ КАК Номенклатура,
	|	&Invoice,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.Номенклатура.Артикул
	|		ИНАЧЕ EDR_ТоварыДоп.DiversCode.Код
	|	КОНЕЦ КАК Код,
	|	EDR_Interventions.GUID КАК GUID_События
	|ИЗ
	|	РегистрСведений.EDR_ТоварыДоп КАК EDR_ТоварыДоп
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	|				ПО EDR_СоответствияИнвойсов.Invoice = EDR_Invoices.GUID
	|			ПО (EDR_СоответствияИнвойсов.Intervention = EDR_Interventions.GUID)
	|		ПО EDR_ТоварыДоп.GUID_Инцидента = EDR_Interventions.GUID
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
	|		ПО EDR_ТоварыДоп.Номенклатура = ЗаказНарядТовары.Номенклатура
	|			И EDR_ТоварыДоп.ЗаказНаряд = ЗаказНарядТовары.Ссылка
	|ГДЕ
	|	EDR_ТоварыДоп.ЗаказНаряд = &Ссылка
	|	И EDR_СоответствияИнвойсов.Invoice = &Invoice"
	);
	Запрос.УстановитьПараметр("Ссылка", ЗаказНаряд);
	Запрос.УстановитьПараметр("Invoice",Инвойс.GUID_Инвойса);
	
	ТабТоваров = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабТоваров;
КонецФункции

Функция ПолучитьСписокРаботПоИнвойсу(Инвойс)
	
	ЗаказНаряд = Инвойс.Ссылка;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	EDR_Invoices.Invoice КАК Счет,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядРаботы.Работа
	|		ИНАЧЕ EDR_РаботыДоп.DiversCode.Наименование
	|	КОНЕЦ КАК Работа,
	|	EDR_Interventions.GUID КАК GUID_События,
	|	&Invoice,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядРаботы.Работа.Артикул
	|		ИНАЧЕ EDR_РаботыДоп.DiversCode.Код
	|	КОНЕЦ КАК Код
	|ИЗ
	|	РегистрСведений.EDR_РаботыДоп КАК EDR_РаботыДоп
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
	|		ПО (ЗаказНарядРаботы.ИдентификаторРаботы = EDR_РаботыДоп.GUID_Работы)
	|			И (ЗаказНарядРаботы.Ссылка = EDR_РаботыДоп.ЗаказНаряд)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	|				ПО EDR_СоответствияИнвойсов.Invoice = EDR_Invoices.GUID
	|			ПО (EDR_СоответствияИнвойсов.Intervention = EDR_Interventions.GUID)
	|		ПО EDR_РаботыДоп.GUID_Инцидента = EDR_Interventions.GUID
	|ГДЕ
	|	EDR_РаботыДоп.ЗаказНаряд = &Ссылка
	|	И EDR_СоответствияИнвойсов.Invoice = &Invoice
	|
	|СГРУППИРОВАТЬ ПО
	|	EDR_Interventions.GUID,
	|	EDR_Invoices.Invoice,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядРаботы.Работа.Артикул
	|		ИНАЧЕ EDR_РаботыДоп.DiversCode.Код
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядРаботы.Работа
	|		ИНАЧЕ EDR_РаботыДоп.DiversCode.Наименование
	|	КОНЕЦ"
	);
	Запрос.УстановитьПараметр("Ссылка", ЗаказНаряд);
	Запрос.УстановитьПараметр("Invoice",Инвойс.GUID_Инвойса);
	
	ТабРабот = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРабот;
КонецФункции

