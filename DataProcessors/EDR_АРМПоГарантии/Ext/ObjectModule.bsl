	|	EDR_Interventions.НомерСФ,
	|	EDR_Interventions.ДатаСФ,
	|	EDR_Interventions.ПробегПриУстановке,
	|	EDR_Interventions.ОписаниеОперации,
	|	EDR_Interventions.ОписаниеЖалобы,
	|	EDR_Interventions.КомментарийОперации,
	|	EDR_Interventions.РезультатДиагностики,
	|	EDR_Interventions.НомерСогласования
	|ИЗ
	|	РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|ГДЕ
	|	EDR_Interventions.ЗаказНаряд В(&ЗаказНаряды)"
	);
