////@+ Процедура ЗаполнитьТаблицы()
// Дата создания - 14.06.2012 15:34:39; 
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура производит выборку информации из регистров 
//  и заполняет табличные части АРМа
//
// Параметры
//  Без параметров
//@-
Процедура ЗаполнитьТаблицы() Экспорт
		
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	EDR_ЗаказНаряды.ЗаказНаряд КАК ЗаказНаряд,
	|	EDR_ЗаказНаряды.ОтправленВСистему_GCM КАК Отправлен,
	|	EDR_ЗаказНаряды.OTS,
	|	EDR_ЗаказНаряды.ДатаОткрытия КАК ДатаОткрытия,
	|	EDR_ЗаказНаряды.ДатаЗакрытия КАК ДатаЗакрытия,
	|	EDR_ЗаказНаряды.ЗаказНаряд.Автомобиль КАК Автомобиль,
	|	EDR_ЗаказНаряды.СемействоАвтомобиля КАК СемействоАвтомобиля,
	|	EDR_ЗаказНаряды.ПробегАвтомобиля,
	|	EDR_ЗаказНаряды.РангАвторабот,
	|	EDR_ЗаказНаряды.ЗаказНаряд.СуммаДокумента КАК СуммаДокумента,
	|	EDR_ЗаказНаряды.ГотовностьКОтправке,
	|	EDR_ЗаказНаряды.ПовторнаяОтправка,
	|	Renault_ВидыРемонтаДопРеквизиты.EDR_ЛКМ КАК ЛКМ
	|ИЗ
	|	РегистрСведений.EDR_ЗаказНаряды КАК EDR_ЗаказНаряды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ВидыРемонтаДопРеквизиты КАК Renault_ВидыРемонтаДопРеквизиты
	|		ПО EDR_ЗаказНаряды.ЗаказНаряд.ВидРемонта = Renault_ВидыРемонтаДопРеквизиты.ВидРемонта
	|ГДЕ
	|	EDR_ЗаказНаряды.ЗаказНаряд.Организация В(&Организация)
	|	И EDR_ЗаказНаряды.ДатаЗакрытия МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И EDR_ЗаказНаряды.Гарантия = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказНаряд,
	|	ДатаОткрытия,
	|	ДатаЗакрытия"
	);
	
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ДатаНачала",ПериодВыборки.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",ПериодВыборки.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ТаблицаЗаказов.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НС = ТаблицаЗаказов.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
		
	КонецЦикла;
	
	//Теперь получаем список заказ нарядов
	МассивЗаказов = ТаблицаЗаказов.ВыгрузитьКолонку("ЗаказНаряд");
	
	//По этому массиву получаем таблицы 
	//ТоварыДоп:
	ЗаполнитьТоварыПоОтбору(МассивЗаказов);
	
	//РаботыДоп:
	ЗаполнитьРаботыПоОтбору(МассивЗаказов);
	
	//Счета (Инвойсы):
	ЗаполнитьСчетаПоОтбору(МассивЗаказов);
	
	//Соответствия:
	ЗаполнитьСоответствияПоОтбору(МассивЗаказов);

	//Формируем таблицу параметров по видам расходов
	ОбновитьТаблицуПараметровВидовРасходов();

	//Инциденты:
	ЗаполнитьИнцидентыПоОтбору(МассивЗаказов);
	
		
	
КонецПроцедуры // ЗаполнитьТаблицы()

