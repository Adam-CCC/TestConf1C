	ФормаПрогресса.НадписьСостоянияПрогрессора = "Подготовка таблицы для результатов проверки";
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	EDR_ЗаказНаряды.ЗаказНаряд,
	|	EDR_Invoices.Invoice как Заявка,
	|	EDR_Interventions.Intervention как Инцидент,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(50)) КАК Объект,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(255)) КАК ОписаниеОшибки
	|ИЗ
	|	РегистрСведений.EDR_ЗаказНаряды КАК EDR_ЗаказНаряды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	|		ПО EDR_ЗаказНаряды.ЗаказНаряд = EDR_Invoices.ЗаказНаряд
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|		ПО EDR_ЗаказНаряды.ЗаказНаряд = EDR_Interventions.ЗаказНаряд
	|ГДЕ
	|	EDR_ЗаказНаряды.ЗаказНаряд.Проведен = ЛОЖЬ"
	;
	
	Запрос.Текст = ТекстЗапроса;
	
	ТаблицаОшибок = Запрос.Выполнить().Выгрузить();
	ТаблицаОшибок.Очистить();
	
	ТаблицаОшибокРаботыТовары = ТаблицаОшибок.СкопироватьКолонки();
	
	/////////////////////////////////
	//	Начинаем проверки
	
	ФормаПрогресса.ЗначениеИндикатора = 6;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка даты релиза/кода валют по ISO/производителей.";
	
	////$+ Комментарий 
	// Дата создания - 02.07.2012 13:36:46;
	// Автор - Окипний Андрей Евгеньевич
	//
	//Проверяем заполнение даты релиза - это константа. если пустая - ошибка
	//
	//$-
	ДатаРелиза = Константы.EDR_ДатаРелиза.Получить();
	Если НЕ ЗначениеЗаполнено(ДатаРелиза) тогда
		НС = ТаблицаОшибок.Добавить();
		НС.ЗаказНаряд	  = "-";
		НС.Заявка		  = "-";
		НС.Инцидент		  = "-";
		НС.Объект		  = "Константа ""Дата релиза""";
		НС.ОписаниеОшибки = "Не заполнена константа Дата релиза.";
	КонецЕсли;
	
	ПроверитьВалюты(МВТ, ТаблицаОшибок);
	
	ПроверитьПробег(МВТ, ТаблицаОшибок);
	
	ПроверитьПроизводителей(МВТ, ТаблицаОшибок);
	
	//Проверяем необходимость указания номера согласования
	ФормаПрогресса.ЗначениеИндикатора = 7;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка наличия номеров согласований.";
	
	ПроверитьНомераСогласования(МВТ, ТаблицаОшибок);
	
	// Комментарий 
	//Дата создания - 10.04.2012 10:32:20; Автор - Окипний Андрей Евгеньевич
	//Проверяем корректность заполнения жалоб клиента и комментариев
