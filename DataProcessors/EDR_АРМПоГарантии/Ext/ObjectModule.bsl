	|		ПО ПаттерныРаспределения.ЗаказНаряд = ПаттерныЗН.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Распределения"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	ФормаПрогресса.ЗначениеИндикатора = 3;
