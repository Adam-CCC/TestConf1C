////@+ Процедура ПроверитьНоменклатуруИАвтоработыНаСоответствие(МВТ, ТаблицаОшибок)
// Дата создания - 14.06.2012 10:31:45;
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура проверяет номенклатуру и автоработы на наличие записей в регистрах 
//  OPERACODE и Tariff_PR. 
//
// Параметры
//  Парам1 МВТ  - Менеджер временных таблиц - Содержит менеджер временных таблиц
//
//  Парам2 ТаблицаОшибок  - Типизированная таблица значений- в этой таблице
//                 собирается список всех выявленных в ходе проверки ошибок заполнения
//@-
Процедура ПроверитьНоменклатуруИАвтоработыНаСоответствие(МВТ, ТаблицаОшибок, ТаблицаОшибокРаботыТовары) 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ПаттерныНоменклатуры.ИдентификаторИнцидента,
	               |	ПаттерныНоменклатуры.Номенклатура,
	               |	ПаттерныНоменклатуры.Артикул,
	               |	ПаттерныНоменклатуры.DiversCode
	               |ПОМЕСТИТЬ ВремТЗТолькоНоменклатура
	               |ИЗ
	               |	ПаттерныНоменклатуры КАК ПаттерныНоменклатуры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	               |		ПО ПаттерныНоменклатуры.Номенклатура = спрНоменклатура.Ссылка
	               |ГДЕ
	               |	ПаттерныНоменклатуры.Удален = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВремТЗТолькоНоменклатура.ИдентификаторИнцидента,
	               |	ВремТЗТолькоНоменклатура.Номенклатура,
	               |	ВремТЗТолькоНоменклатура.Артикул,
	               |	ВЫБОР
	               |		КОГДА TariffPR_НоменклатураСрезПоследних.Реферанс ЕСТЬ NULL 
	               |				И EDR_DiversCode.Ссылка ЕСТЬ NULL 
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Реферанс_НЕ_Renault,
	               |	EDR_DiversCode.Ссылка КАК DiversCode
	               |ПОМЕСТИТЬ ВремТЗНоменклатура
	               |ИЗ
	               |	ВремТЗТолькоНоменклатура КАК ВремТЗТолькоНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_TariffPR_Номенклатура.СрезПоследних(&ТекДата, ) КАК TariffPR_НоменклатураСрезПоследних
	               |		ПО ВремТЗТолькоНоменклатура.Артикул = TariffPR_НоменклатураСрезПоследних.Реферанс
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.EDR_DiversCode КАК EDR_DiversCode
	               |		ПО ВремТЗТолькоНоменклатура.DiversCode = EDR_DiversCode.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВремТЗТолькоНоменклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПаттерныРабот.ИдентификаторИнцидента,
	               |	ПаттерныРабот.Работа,
	               |	ПаттерныРабот.Артикул
	               |ПОМЕСТИТЬ ВремТЗТолькоАвтоработыРаботы
	               |ИЗ
	               |	ПаттерныРабот КАК ПаттерныРабот
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Автоработы КАК Автоработы
	               |		ПО ПаттерныРабот.Работа = Автоработы.Ссылка
	               |ГДЕ
	               |	ПаттерныРабот.Удален = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВремТЗТолькоАвтоработыРаботы.ИдентификаторИнцидента,
	               |	ВремТЗТолькоАвтоработыРаботы.Работа,
	               |	ВремТЗТолькоАвтоработыРаботы.Артикул,
	               |	ВЫБОР
	               |		КОГДА OPERACODE_НормыРаботСрезПоследних.КодПоКаталогу ЕСТЬ NULL 
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Реферанс_НЕ_Renault
	               |ПОМЕСТИТЬ ВремТЗРабота
	               |ИЗ
	               |	ВремТЗТолькоАвтоработыРаботы КАК ВремТЗТолькоАвтоработыРаботы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.OPERACODE_НормыРабот.СрезПоследних(&ТекДата, ) КАК OPERACODE_НормыРаботСрезПоследних
	               |		ПО ВремТЗТолькоАвтоработыРаботы.Артикул = OPERACODE_НормыРаботСрезПоследних.КодПоКаталогу
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВремТЗТолькоАвтоработыРаботы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВремТЗНоменклатура.Номенклатура КАК НоменклатураРабота,
	               |	ВремТЗНоменклатура.Артикул,
	               |	ВремТЗНоменклатура.ИдентификаторИнцидента
	               |ПОМЕСТИТЬ ВремТЗНоменклатураРабота
	               |ИЗ
	               |	ВремТЗНоменклатура КАК ВремТЗНоменклатура
	               |ГДЕ
	               |	ВремТЗНоменклатура.Реферанс_НЕ_Renault = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВремТЗРабота.Работа,
	               |	ВремТЗРабота.Артикул,
	               |	ВремТЗРабота.ИдентификаторИнцидента
	               |ИЗ
	               |	ВремТЗРабота КАК ВремТЗРабота
	               |ГДЕ
	               |	ВремТЗРабота.Реферанс_НЕ_Renault = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВремТЗНоменклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВремТЗРабота
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПаттерныИнцидентов.ЗаказНаряд,
	               |	"" - "" КАК Заявка,
	               |	ПаттерныИнцидентов.Инцидент,
	               |	ВЫБОР
	               |		КОГДА ВремТЗНоменклатураРабота.НоменклатураРабота ССЫЛКА Справочник.Автоработы
	               |			ТОГДА ""Работа  - № по каталогу ["" + ВремТЗНоменклатураРабота.Артикул + ""]""
	               |		ИНАЧЕ ""Номенклатура - реферанс ["" + ВремТЗНоменклатураРабота.Артикул + ""]""
	               |	КОНЕЦ КАК Объект,
	               |	ВЫБОР
	               |		КОГДА ВремТЗНоменклатураРабота.НоменклатураРабота ССЫЛКА Справочник.Автоработы
	               |			ТОГДА ""Работа Не акцептована RENAULT. Или не загружена в OPERACODE""
	               |		ИНАЧЕ ""Номенклатура Не акцептована RENAULT. Или не загружена в Tarif PR""
	               |	КОНЕЦ КАК ОписаниеОшибки
	               |ИЗ
	               |	ПаттерныИнцидентов КАК ПаттерныИнцидентов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТЗНоменклатураРабота КАК ВремТЗНоменклатураРабота
	               |		ПО ПаттерныИнцидентов.ИдентификаторИнцидента = ВремТЗНоменклатураРабота.ИдентификаторИнцидента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |УНИЧТОЖИТЬ ВремТЗНоменклатураРабота"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок, ТаблицаОшибокРаботыТовары);
	
КонецПроцедуры // ПроверитьНоменклатуруИАвтоработыНаСоответствие(МВТ, ТаблицаОшибок)

////@+ Процедура ПроверитьПричиныОбращения(МВТ, ТаблицаОшибок)
// Дата создания - 14.06.2012 14:08:26;
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура проверяет установку флагов "Причина обращения". Для каждого инцидента должен быть установлен только 
//  один флажок.
//
// Параметры
//  Парам1 МВТ  - Менеджер временных таблиц - Содержит менеджер временных таблиц
//
//  Парам2 ТаблицаОшибок  - Типизированная таблица значений- в этой таблице
//                 собирается список всех выявленных в ходе проверки ошибок заполнения
//@-
Процедура ПроверитьПричиныОбращения(МВТ, ТаблицаОшибок)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ПаттерныНоменклатуры.Номенклатура КАК НоменклатураРабота,
	|	ПаттерныНоменклатуры.ИдентификаторИнцидента
	|ПОМЕСТИТЬ ВремТЗТоварыРаботы
	|ИЗ
	|	ПаттерныНоменклатуры КАК ПаттерныНоменклатуры
	|ГДЕ
	|	ПаттерныНоменклатуры.ПричинаОбращения = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПаттерныРабот.Работа,
	|	ПаттерныРабот.ИдентификаторИнцидента
	|ИЗ
	|	ПаттерныРабот КАК ПаттерныРабот
	|ГДЕ
	|	ПаттерныРабот.ПричинаОбращения = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаттерныИнцидентов.Инцидент,
	|	ПаттерныИнцидентов.ИдентификаторИнцидента,
	|	ПаттерныИнцидентов.ЗаказНаряд,
	|	КОЛИЧЕСТВО(ВремТЗТоварыРаботы.НоменклатураРабота) КАК НоменклатураРабота
	|ПОМЕСТИТЬ ТЗПосчитаныхПричин
	|ИЗ
	|	ПаттерныИнцидентов КАК ПаттерныИнцидентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТЗТоварыРаботы КАК ВремТЗТоварыРаботы
	|		ПО ПаттерныИнцидентов.ИдентификаторИнцидента = ВремТЗТоварыРаботы.ИдентификаторИнцидента
	|ГДЕ
	|	ПаттерныИнцидентов.ТребоватьПричину = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ПаттерныИнцидентов.Инцидент,
	|	ПаттерныИнцидентов.ИдентификаторИнцидента,
	|	ПаттерныИнцидентов.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремТЗТоварыРаботы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЗПосчитаныхПричин.ЗаказНаряд,
	|	""-"" КАК Заявка,
	|	ТЗПосчитаныхПричин.Инцидент,
	|	""Причина обращения"" КАК Объект,
	|	ВЫБОР
	|		КОГДА ТЗПосчитаныхПричин.НоменклатураРабота > 1
	|			ТОГДА ""больше""
	|		КОГДА ТЗПосчитаныхПричин.НоменклатураРабота < 1
	|			ТОГДА ""меньше""
	|		ИНАЧЕ ""норма""
	|	КОНЕЦ КАК Отклонение
	|ПОМЕСТИТЬ РасчетПоказателей
	|ИЗ
	|	ТЗПосчитаныхПричин КАК ТЗПосчитаныхПричин
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТЗПосчитаныхПричин
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетПоказателей.ЗаказНаряд,
	|	РасчетПоказателей.Заявка,
	|	РасчетПоказателей.Инцидент,
	|	РасчетПоказателей.Объект,
	|	ВЫБОР
	|		КОГДА РасчетПоказателей.Отклонение = ""меньше""
	|			ТОГДА ""У инцидента не указана причина обращения. Причина обращения обязательна.""
	|		КОГДА РасчетПоказателей.Отклонение = ""больше""
	|			ТОГДА ""У инцидента две или более причин обращения. Возможна только одна причина обращения.""
	|	КОНЕЦ КАК ОписаниеОшибки
	|ИЗ
	|	РасчетПоказателей КАК РасчетПоказателей
	|ГДЕ
	|	РасчетПоказателей.Отклонение <> ""норма""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ РасчетПоказателей"
	;
	
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьПричиныОбращения(МВТ, ТаблицаОшибок)

////@+ Процедура СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок)
// Дата создания - 14.06.2012 15:10:20;
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура просто получает объект Запрос, выполняет его и перебирает результат
//  предназначена для простого рефакторинга. Очень много однотипного кода в проверках.
//
// Параметры
//  Парам1 Запрос  - Запрос - сконфигурированный объект "Запрос"
//  осталось только его выполнить и перебрать результат
//  Парам2 ТаблицаОшибок  - Типизированная таблица значений- в этой таблице
//                 собирается список всех выявленных в ходе проверки ошибок заполнения
//@-
Процедура СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок, ТаблицаОшибокРаботыТовары = Неопределено)
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НС = ТаблицаОшибок.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
		
		Если ТаблицаОшибокРаботыТовары <> Неопределено Тогда
			НС = ТаблицаОшибокРаботыТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Выборка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок)

///////////////////////////////////////////////////////
//			Процедуры только на стороне клиента
	
//Из - за возможности распределения инцидентов по нескольким счетам
//принимаем, что, если параметр в одном из счетов разрешен, а в другом 
//запрещен, значит запрещен для обоих счетов. Кроме полей комментариев и кодов
//
Функция ПолучитьПараметр_Булево_ExpenceCode(ИдентификаторЗаказа = Неопределено, ИдентификаторСчета = Неопределено, ИдентификаторИнцидента = Неопределено, Параметр) Экспорт
	
	Отбор = Новый Структура;
	
	Если ЗначениеЗаполнено(ИдентификаторЗаказа) тогда
		
		Отбор.Вставить("ИдентификаторЗаказа", ИдентификаторЗаказа);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторСчета) тогда
		
		Отбор.Вставить("ИдентификаторСчета", ИдентификаторСчета);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторИнцидента) тогда
		
		Отбор.Вставить("ИдентификаторИнцидента", ИдентификаторИнцидента);
		
	КонецЕсли;
	
	ТекСтроки = ТаблицаПараметровВидовРасходов.НайтиСтроки(Отбор);
	
	Если ЗначениеЗаполнено(ИдентификаторЗаказа) тогда //Для заказа возвращаем истину, если Истина есть хоть в одной строке.
		Если ТекСтроки.Количество() > 1 тогда
			
			Для каждого ТекСтрока из ТекСтроки Цикл
				ТекЗначение = ТекСтрока[Параметр];
				
				//Если значение хоть раз принимает значение Истина
				//Возвращаем Истина
				Если ТекЗначение тогда  
					
					Возврат ТекЗначение;
					
				КонецЕсли;
				
			КонецЦикла;
			
			//Если все еще тут, значит в цикле истину не нашли возвращаем последнее знвачение
			Возврат ТекЗначение;
		
		ИначеЕсли ТекСтроки.Количество() = 0 тогда //Если строки еще нет - возвращаем ложь
			
			Возврат ложь;
			
		Иначе
			
			ТекСтрока = ТекСтроки[0];
			Возврат ТекСтрока[Параметр];
			
		КонецЕсли;
		
	Иначе //Для счета и инцидента наоборот, возвращаем ложь, если ложь есть хоть в одной строке
		
		//Несколько строк может быть только с несколькими счетами
		Если ТекСтроки.Количество() > 1 тогда
			
			Для каждого ТекСтрока из ТекСтроки Цикл
				ТекЗначение = ТекСтрока[Параметр];
				
				//Если значение хоть раз принимает значение ложь
				//Возвращаем ложь
				Если НЕ ТекЗначение тогда  
					
					Возврат ТекЗначение;
					
				КонецЕсли;
				
			КонецЦикла;
			
			//Если все еще тут, значит в цикле ложь не нашли возвращаем последнее знвачение
			Возврат ТекЗначение;
			
		ИначеЕсли ТекСтроки.Количество() = 0 тогда //Если строки еще нет - возвращаем ложь
			
			Возврат ложь;
			
		Иначе
			
			ТекСтрока = ТекСтроки[0];
			Возврат ТекСтрока[Параметр];
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДеревоЗаказНарядовДляОтправки(СписокЗаказов, ЭтаФорма) Экспорт
	Перем ТабТоваров;
	Перем ТабРабот;

	
	ДатаЗакрытияОТ = ПериодВыборки.ДатаНачала;
	ДатаЗакрытияПО = ПериодВыборки.ДатаОкончания;
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	Макет = ПолучитьМакет("ГрафическоеПредставление");
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	EDR_ЗаказНаряды.ЗаказНаряд КАК Ссылка,
	|	EDR_ЗаказНаряды.ОтправленВСистему_GCM,
	|	EDR_ЗаказНаряды.OTS КАК OTS,
	|	EDR_ЗаказНаряды.Гарантия КАК Гарантия,
	|	EDR_Invoices.Invoice КАК Invoice,
	|	EDR_Invoices.ДатаИнвойса КАК ДатаИнвойса,
	|	EDR_Invoices.Категория КАК Категория,
	|	EDR_Interventions.Intervention КАК Intervention,
	|	EDR_СоответствияИнвойсов.Процент КАК Процент,
	|	EDR_Interventions.RC_code КАК RC_code,
	|	EDR_Interventions.Function_Code КАК Function_Code,
	|	EDR_Invoices.Expense_code КАК Expense_code,
	|	EDR_Interventions.OTS_number КАК OTS_number,
	|	EDR_Invoices.GUID КАК GUID_Инвойса,
	|	EDR_Interventions.GUID КАК GUID_События,
	|	EDR_ЗаказНаряды.ДатаОткрытия КАК ДатаОткрытия,
	|	EDR_ЗаказНаряды.ДатаЗакрытия КАК ДатаЗакрытия,
	|	EDR_ЗаказНаряды.РангАвторабот КАК РангАвторабот,
	|	EDR_ЗаказНаряды.ПробегАвтомобиля КАК ПробегАвтомобиля,
	|	EDR_Interventions.ОписаниеОперации,
	|	EDR_Interventions.ОписаниеЖалобы,
	|	EDR_Interventions.КомментарийОперации,
	|	EDR_Interventions.РезультатДиагностики
	|ИЗ
	|	РегистрСведений.EDR_ЗаказНаряды КАК EDR_ЗаказНаряды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|				ПО EDR_СоответствияИнвойсов.Intervention = EDR_Interventions.GUID
	|			ПО EDR_Invoices.ЗаказНаряд = EDR_СоответствияИнвойсов.ЗаказНаряд
	|				И EDR_Invoices.GUID = EDR_СоответствияИнвойсов.Invoice
	|		ПО EDR_ЗаказНаряды.ЗаказНаряд = EDR_Invoices.ЗаказНаряд
	|ГДЕ
	|	EDR_ЗаказНаряды.ЗаказНаряд.Организация = &Организация
	|	И EDR_ЗаказНаряды.ДатаЗакрытия МЕЖДУ &ДатаЗакрытияОТ И &ДатаЗакрытияПО
	|	И EDR_ЗаказНаряды.ЗаказНаряд В(&СписокЗаказов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Invoice,
	|	Intervention
	|ИТОГИ
	|	МАКСИМУМ(OTS),
	|	МАКСИМУМ(Гарантия),
	|	МАКСИМУМ(ДатаИнвойса),
	|	МАКСИМУМ(Категория),
	|	СУММА(Процент),
	|	МАКСИМУМ(RC_code),
	|	МАКСИМУМ(Function_Code),
	|	МАКСИМУМ(Expense_code),
	|	МАКСИМУМ(OTS_number),
	|	МАКСИМУМ(GUID_Инвойса),
	|	МАКСИМУМ(GUID_События),
	|	МАКСИМУМ(ДатаОткрытия),
	|	МАКСИМУМ(ДатаЗакрытия),
	|	МАКСИМУМ(РангАвторабот),
	|	МАКСИМУМ(ПробегАвтомобиля)
	|ПО
	|	Ссылка,
	|	Invoice";

	Запрос.УстановитьПараметр("ДатаЗакрытияОТ", ДатаЗакрытияОТ);
	Запрос.УстановитьПараметр("ДатаЗакрытияПО", ДатаЗакрытияПО);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СписокЗаказов", СписокЗаказов);

	Результат = Запрос.Выполнить();

	ОбластьШапка	   = Макет.ПолучитьОбласть("ШапкаОтчета");
	ОбластьЗаказов	   = Макет.ПолучитьОбласть("СтрокаЗаказНаряд");
	ОбластьСчетов	   = Макет.ПолучитьОбласть("СтрокаИнвойс");
	ОбластьИнцидентов  = Макет.ПолучитьОбласть("СтрокаИнцидент");
	ОбластьОписание    = Макет.ПолучитьОбласть("СтрокаОписаниеОперации");
	ОбластьКомментарий = Макет.ПолучитьОбласть("СтрокаКомментарий");
	ОбластьЖалоба	   = Макет.ПолучитьОбласть("СтрокаЖалоба");
	ОбластьДиагностика = Макет.ПолучитьОбласть("СтрокаДиагностика");
	ОбластьРабот = Макет.ПолучитьОбласть("СтрокаРабота");
	ОбластьДеталей = Макет.ПолучитьОбласть("СтрокаДеталь");

	ТекКлюч = Строка(Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy"));
	ПечатнаяФормаДокументов = ПолучитьОбщуюФорму("ПечатнаяФормаДокументов",ЭтаФорма,ТекКлюч);
	
	ТабДок = ПечатнаяФормаДокументов.ЭлементыФормы.ТабличныйДокумент;
	ТабДок.Очистить();
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.НачатьАвтогруппировкуСтрок();

	ВыборкаЗН = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаЗН.Следующий() Цикл
		
		ЗН = Строка(ВыборкаЗН.Ссылка) + ". модель: " + ВыборкаЗН.Ссылка.Автомобиль.Модель + ", VIN: " + ВыборкаЗН.Ссылка.Автомобиль.VIN;
		ОбластьЗаказов.Параметры.СтрокаЗаказНаряд = ЗН;
		ОбластьЗаказов.Параметры.ЗаказНаряд = ВыборкаЗН.Ссылка;
		
		ТабДок.Вывести(ОбластьЗаказов, ВыборкаЗН.Уровень());

		ВыборкаСчет = ВыборкаЗН.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаСчет.Следующий() Цикл
			Счет = "Счет № " + ВыборкаСчет.Invoice + " от "+Формат(ВыборкаСчет.ДатаИнвойса, "ДФ=dd.MM.yyyy") + ". Категория: " + ВыборкаСчет.Категория;
			ОбластьСчетов.Параметры.Инвойс = Счет;
			ТабДок.Вывести(ОбластьСчетов, ВыборкаСчет.Уровень());

			//Нужно получить работы
			ТабРабот = ПолучитьСписокРаботПоИнвойсу(ВыборкаСчет);
			
			//Нужно получить детали
			ТабТоваров = ПолучитьСписокТоваровПоИнвойсу(ВыборкаСчет);
			
			ВыборкаСобытия = ВыборкаСчет.Выбрать();

			Пока ВыборкаСобытия.Следующий() Цикл
				Инцидент = "Инцидент """ + ВыборкаСобытия.Intervention + """. Вид расходов: " + ?(ЗначениеЗаполнено(ВыборкаСобытия.Expense_code),ВыборкаСобытия.Expense_code, "0")
						+ " Функ. код: " + ВыборкаСобытия.Function_Code + " Процент: " + ВыборкаСобытия.Процент;
				ОбластьИнцидентов.Параметры.Инцидент = Инцидент;
				ТабДок.Вывести(ОбластьИнцидентов, ВыборкаСобытия.Уровень());
				
				//Описание операции
				//количество строк не ограниченно,
				Если ЗначениеЗаполнено(ВыборкаСобытия.ОписаниеОперации) тогда
					ТекстОписания = Строка(ВыборкаСобытия.ОписаниеОперации); // через преобразование в строку - для отвязки от Дерева Значений.
					ТекстОписания = СтрЗаменить(ТекстОписания, Символы.ПС, " ");
					ФорматированноеОписание = EDR_ОбщийМодуль.СформироватьТекстКомментария(ТекстОписания, 200);
					
					КоличествоСтрок = ФорматированноеОписание.КоличествоСтрок();
					Для Сч = 1 по КоличествоСтрок Цикл
						ТекОписание = ФорматированноеОписание.ПолучитьСтроку(Сч);
						Если НЕ ЗначениеЗаполнено(ТекОписание) тогда Продолжить; КонецЕсли;
						Описание = "Описание (" + Сч +"):";
						ОбластьОписание.Параметры.Описание = Описание;
						 ОбластьОписание.Параметры.ТекстОписания = ТекОписание;
						ТабДок.Вывести(ОбластьОписание, ВыборкаСобытия.Уровень()+2);
					КонецЦикла;
				КонецЕсли;
				
				//Комментарии к операции
				//количество строк не ограниченно,
				Если ЗначениеЗаполнено(ВыборкаСобытия.КомментарийОперации) тогда
					ТекстКомментария = Строка(ВыборкаСобытия.КомментарийОперации); // через преобразование в строку - для отвязки от Дерева Значений.
					ТекстКомментария = СтрЗаменить(ТекстКомментария, Символы.ПС, " ");
					ФорматированныйКомментарий = EDR_ОбщийМодуль.СформироватьТекстКомментария(ТекстКомментария, 120);
					
					КоличествоСтрок = ФорматированныйКомментарий.КоличествоСтрок();
					Для Сч = 1 по КоличествоСтрок Цикл
						ТекКомм = ФорматированныйКомментарий.ПолучитьСтроку(Сч);
						Если НЕ ЗначениеЗаполнено(ТекКомм) тогда Продолжить; КонецЕсли;
						Комментарий = "Комментарий (" + Сч + "):";
						ОбластьКомментарий.Параметры.Комментарий = Комментарий;
						ОбластьКомментарий.Параметры.ТекстКомментария = ТекКомм;
						ТабДок.Вывести(ОбластьКомментарий, ВыборкаСобытия.Уровень()+2);
					КонецЦикла;
				КонецЕсли;
				
				////Теперь формируем строку 030 Жалоба клиента. она только одна, длина 80 символов
				Если ЗначениеЗаполнено(ВыборкаСобытия.ОписаниеЖалобы) тогда
					ОбластьЖалоба.Параметры.ТекстЖалобы = ВыборкаСобытия.ОписаниеЖалобы;
					ТабДок.Вывести(ОбластьЖалоба, ВыборкаСобытия.Уровень()+2);
				КонецЕсли;
				
				//Теперь Результат диагностики строка 040
				Если ЗначениеЗаполнено(ВыборкаСобытия.РезультатДиагностики) тогда
					ОбластьДиагностика.Параметры.ТекстДиагностики = ВыборкаСобытия.РезультатДиагностики;
					ТабДок.Вывести(ОбластьДиагностика, ВыборкаСобытия.Уровень()+2);
				КонецЕсли;
				
				//Подготовка таблиц с товарами и работами
				Отбор = Новый Структура("GUID_События",ВыборкаСобытия.GUID_События);
				РаботыСобытия = ТабРабот.Скопировать(Отбор);
				ТоварыСобытия = ТабТоваров.Скопировать(Отбор);
				
				Для каждого стрРабота из РаботыСобытия Цикл
					Работа = "Работа: " + стрРабота.Работа+" код: " + стрРабота.Код;
					
					ОбластьРабот.Параметры.Работа = Работа;
					ОбластьРабот.Параметры.РабСсылка = стрРабота.Работа;
					
					ТабДок.Вывести(ОбластьРабот, ВыборкаСобытия.Уровень()+1);
				КонецЦикла;
				
				Для каждого стрДеталь из ТоварыСобытия Цикл
					Деталь = "Деталь: " + стрДеталь.Номенклатура+" код: " + стрДеталь.Код;
					
					ОбластьДеталей.Параметры.Деталь = Деталь;
					ОбластьДеталей.Параметры.ДетСсылка = стрДеталь.Номенклатура;
					
					ТабДок.Вывести(ОбластьДеталей, ВыборкаСобытия.Уровень()+1);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку = Ложь;
	
	ПечатнаяФормаДокументов.ОбъектПредставление = "Структура распределения счетов и инцидентов по Заказ-Нарядам";
	ПечатнаяФормаДокументов.Открыть();
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

КонецФункции

////@+ Процедура ВывестиОшибки()
//Дата создания - 11.04.2012 11:57:43; Автор - Окипний Андрей Евгеньевич
// 
//
// Описание процедуры
//  Процедура передает таблицу ошибок в построитель отчета
//  и визуализирует её
//
// Параметры
//
// Без параметров
//@-
Процедура ВывестиОшибки() Экспорт

	Построитель = Новый ПостроительОтчета;
	
	//Устанавливаем источник данных
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаОшибок);
	
	//Заполняем настройки по умолчанию
	Построитель.ЗаполнитьНастройки();
	
	//Устанавливаем расшифровки
	Построитель.ЗаполнениеРасшифровки = ВидЗаполненияРасшифровкиПостроителяОтчета.ЗначенияГруппировок;
	
	//Устанавливаем заголовок
	Построитель.ТекстЗаголовка = "Выявленные ошибки";
	
	//Добавляем представление колонок
	Построитель.ВыбранныеПоля[0].Представление = "Заказ наряд";
	Построитель.ВыбранныеПоля[4].Представление = "Описание ошибки";
	
	//Выполняем отбор
	Построитель.Выполнить();
	
	
	//Устанавливаем оформление по умолчанию
	Renault_Открытый.УстановитьМакетПостроителя(Построитель);
	
	//Получаем форму для ошибок
	ФормаОтчета = ПолучитьФорму("Отчет");
	Построитель.Вывести(ФормаОтчета.ЭлементыФормы.ПолеТабличногоДокумента);
	
	ФормаОтчета.Открыть();
	
КонецПроцедуры // ВывестиОшибки()

