	//
	ФормаПрогресса.ЗначениеИндикатора = 16;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка количество причин обращения по инцидентам";
	
	ПроверитьПричиныОбращения(МВТ, ТаблицаОшибок);
	
	ФормаПрогресса.ЗначениеИндикатора = 20;
	
	Если ТаблицаОшибок.Количество() > 0 тогда //Есть ошибки
		
		ВсеНормально = Ложь;
		
		Если ТаблицаОшибокРаботыТовары.Количество() = ТаблицаОшибок.Количество() Тогда
			ЭтоОшибкиРаботыТовары = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ФормаПрогресса.Закрыть();
	
	//Удаляем все временные таблицы
	МВТ = Неопределено;
	
	Возврат ВсеНормально;
	
КонецФункции

////@+ Процедура ПроверитьВалюты(МВТ, ТаблицаОшибок)
// Дата создания - 02.07.2012 13:45:55;
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура проверяет заполненность реквизита КодВалютыПоISO
//
// Параметры
//  Парам1 МВТ  - Менеджер временных таблиц - МВТ с временными таблицами АРМа
//
//  Парам2 ТаблицаОшибок  - Типизированная таблица значений- в этой таблице
//                 собирается список всех выявленных в ходе проверки ошибок заполнения
//@-
Процедура ПроверитьВалюты(МВТ, ТаблицаОшибок) 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ПаттерныЗН.ЗаказНаряд.ВалютаДокумента КАК Валюта
	|ПОМЕСТИТЬ ОшибкиВалюты
	|ИЗ
	|	ПаттерныЗН КАК ПаттерныЗН
	|ГДЕ
	|	""RUB"" = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""-"" КАК ЗаказНаряд,
	|	""-"" КАК Заявка,
	|	""-"" КАК Инцидент,
	|	""Валюта "" + ОшибкиВалюты.Валюта.Наименование КАК Объект,
	|	""Не заполнен код валюты по ISO"" КАК ОписаниеОшибки
	|ИЗ
	|	ОшибкиВалюты КАК ОшибкиВалюты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиВалюты"
	;
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьВалюты(МВТ, ТаблицаОшибок)


////@+ Процедура ПроверитьПроизводителей(МВТ, ТаблицаОшибок)
// Дата создания - 02.07.2012 14:17:01;
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура получает список заказов в которых у автомобилей нет производителя
//
// Параметры
//  Парам1 МВТ  - Менеджер временных таблиц - Содержит менеджер временных таблиц
//                 
//  Парам2 ТаблицаОшибок  - Типизированная таблица значений- в этой таблице
//                 собирается список всех выявленных в ходе проверки ошибок заполнения
//@-
Процедура ПроверитьПроизводителей(МВТ, ТаблицаОшибок) 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ПаттерныЗН.ЗаказНаряд,
	|	ПаттерныЗН.ЗаказНаряд.Автомобиль КАК Автомобиль
	|ПОМЕСТИТЬ ВТПроизводители
	|ИЗ
	|	ПаттерныЗН КАК ПаттерныЗН
	|ГДЕ
	|	ПаттерныЗН.ЗаказНаряд.Автомобиль.Модель.Производитель = ЗНАЧЕНИЕ(Справочник.Производители.ПустаяСсылка)
	//Добавлена проверка на Марку MO 2015.01.12
	| И ПаттерныЗН.ЗаказНаряд.Автомобиль.Модель НЕ В (&МоделиМарки)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПаттерныЗН.ЗаказНаряд.Автомобиль,
	|	ПаттерныЗН.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПроизводители.ЗаказНаряд,
	|	""-"" КАК Заявка,
	|	""-"" КАК Инцидент,
	|	ВТПроизводители.Автомобиль КАК Объект,
	|	""У модели автомобиля не указан производитель"" КАК ОписаниеОшибки
	|ИЗ
	|	ВТПроизводители КАК ВТПроизводители
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТПроизводители"
	;
	
	//Добавлена проверка на Марку MO 2015.01.12
	Запрос.УстановитьПараметр("МоделиМарки", Справочники.CRM_МаркаАвтомобиля.RENAULT.МоделиАвтомобилей.ВыгрузитьКолонку("Модель"));	
	
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьПроизводителей(МВТ, ТаблицаОшибок)

Процедура ПроверитьНомераСогласования(МВТ, ТаблицаОшибок)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПаттерныЗН.ЗаказНаряд КАК ЗаказНаряд,
	|	ПаттерныЗН.ТребоватьСогласование
	|ПОМЕСТИТЬ Заказы
	|ИЗ
	|	ПаттерныЗН КАК ПаттерныЗН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
