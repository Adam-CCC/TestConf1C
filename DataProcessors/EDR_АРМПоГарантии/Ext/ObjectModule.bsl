////@+ Процедура ЗаполнитьСоответствияПоОтбору(ЗаказНаряды)
// Дата создания - 14.06.2012 15:41:52;
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура производит отбор записей соответствий заявок и инцидентов по списку заказ-нарядов
//
// Параметры
//  Парам1 ЗаказНаряды  - Массив - Массив ссылок на заказ - наряды 
//
//@-
Процедура ЗаполнитьСоответствияПоОтбору(ЗаказНаряды)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	EDR_СоответствияИнвойсов.ЗаказНаряд,
	|	EDR_СоответствияИнвойсов.Intervention КАК ИдентификаторИнцидента,
	|	EDR_СоответствияИнвойсов.Invoice КАК ИдентификаторСчета,
	|	EDR_Invoices.Invoice КАК Счет,
	|	EDR_Invoices.Категория,
	|	EDR_Invoices.Expense_code КАК ВидРасходов,
	|	EDR_Interventions.Intervention КАК Инцидент,
	|	EDR_СоответствияИнвойсов.Процент,
	|	EDR_СоответствияИнвойсов.GUID КАК Идентификатор
	|ИЗ
	|	РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	|		ПО EDR_СоответствияИнвойсов.Invoice = EDR_Invoices.GUID
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|		ПО EDR_СоответствияИнвойсов.Intervention = EDR_Interventions.GUID
	|ГДЕ
	|	EDR_СоответствияИнвойсов.ЗаказНаряд В(&ЗаказНаряды)"
	);
	Запрос.УстановитьПараметр("ЗаказНаряды", ЗаказНаряды);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаСоответствий.Очистить();
	Пока Выборка.Следующий() Цикл
		НС = ТаблицаСоответствий.Добавить(); 
		ЗаполнитьЗначенияСвойств(НС, Выборка);
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторСчета",Выборка.ИдентификаторСчета);
		
		НайденныеСчета = ТаблицаСчетов.НайтиСтроки(Отбор);
		Если НайденныеСчета.Количество() тогда 	
			НС.Категория = НайденныеСчета[0].Категория;
			НС.ВидРасходов = НайденныеСчета[0].ВидРасходов;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьСоответствияПоОтбору(ЗаказНаряды)

////@+ Процедура ОбновитьТаблицуПараметровВидовРасходов()Экспорт
// Дата создания - 14.06.2012 15:42:22; 
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура производит формирование таблицы с параметрами 
//  кода статьи расходов с привязкой к каждому инциденту.
//  По этой таблице в дальнейшем настраивается логика обязательности колонок
//
// Параметры
//  Без параметров
//@-
Процедура ОбновитьТаблицуПараметровВидовРасходов() Экспорт
	
	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	//Счета в МВТ
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСчетов.ЗаказНаряд,
	|	ТаблицаСчетов.ИдентификаторСчета,
	|	ТаблицаСчетов.ВидРасходов
	|ПОМЕСТИТЬ ТаблицаСчетов
	|ИЗ
	|	&ТаблицаСчетов КАК ТаблицаСчетов"
	;
	Запрос.УстановитьПараметр("ТаблицаСчетов", ТаблицаСчетов);
	Запрос.Выполнить();
	
	//Соответствия в МВТ
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСоответствий.ЗаказНаряд,
	|	ТаблицаСоответствий.ИдентификаторСчета,
	|	ТаблицаСоответствий.ИдентификаторИнцидента
	|ПОМЕСТИТЬ ТаблицаСоответствий
	|ИЗ
	|	&ТаблицаСоответствий КАК ТаблицаСоответствий"
	;
	Запрос.УстановитьПараметр("ТаблицаСоответствий", ТаблицаСоответствий);
	Запрос.Выполнить();
	
	//В запросе заглушены проверки Control_Comm#
	//по требованию гарантийного департамента
	//Для всех видов расходов, кроме 91 OTS, комментарий обязателен!
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСчетов.ЗаказНаряд КАК ИдентификаторЗаказа,
	|	ТаблицаСчетов.ИдентификаторСчета,
	|	ТаблицаСоответствий.ИдентификаторИнцидента,
	|	ТаблицаСчетов.ВидРасходов,
	|	ТаблицаСчетов.ВидРасходов.Type КАК Type,
	|	ТаблицаСчетов.ВидРасходов.MinAgeDay КАК MinAgeDay,
	|	ТаблицаСчетов.ВидРасходов.MaxAgeDay КАК MaxAgeDay,
	|	ТаблицаСчетов.ВидРасходов.Control_TAPV КАК Control_TAPV,
	|	ТаблицаСчетов.ВидРасходов.Control_NewV КАК Control_NewV,
	|	ТаблицаСчетов.ВидРасходов.Control_EC КАК Control_EC,
	|	ТаблицаСчетов.ВидРасходов.Control_Part КАК Control_Part,
	|	ТаблицаСчетов.ВидРасходов.Control_MD КАК Control_MD,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Control_Comm1,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Control_Comm2,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Control_Comm3,
	|	ТаблицаСчетов.ВидРасходов.Control_Indicator КАК Control_Indicator,
	|	ТаблицаСчетов.ВидРасходов.Control_DiverPart КАК Control_DiverPart,
	|	ТаблицаСчетов.ВидРасходов.Control_DiverOper КАК Control_DiverOper,
	|	ТаблицаСчетов.ВидРасходов.Control_CustomerReq КАК Control_CustomerReq
	|ИЗ
	|	ТаблицаСчетов КАК ТаблицаСчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаСоответствий КАК ТаблицаСоответствий
	|		ПО ТаблицаСчетов.ЗаказНаряд = ТаблицаСоответствий.ЗаказНаряд
	|			И ТаблицаСчетов.ИдентификаторСчета = ТаблицаСоответствий.ИдентификаторСчета
	|ГДЕ
	|	ТаблицаСчетов.ВидРасходов <> ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаСоответствий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаСчетов"
	;
	ТаблицаПараметровВидовРасходов = Запрос.Выполнить().Выгрузить();
	
	//Уничтожаем менеджер
	МВТ = Неопределено; 
	//
КонецПроцедуры // ОбновитьТаблицуПараметровВидовРасходов()

////@+ Функция ПолучитьСледующийНомерСчета(ТекущийЗаказ)
// Дата создания - 14.06.2012 15:45:07;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// <Вставить описание>
//
// Параметры
//  Парам1 ТекущийЗаказ  - ДокументСсылка.ЗаказНаряд - Ссылка на заказ наряд
//
// Возвращаемое значение
//  НомерДокумента  - Строка(6) - Номер документа для заявки 
//  пять цифр от номера ЗН + один символ литерал
//  Пример 00010A, 00010B ...
//
//@-
Функция ПолучитьСледующийНомерСчета(ТекущийЗаказ) Экспорт
	
	Отбор = Новый Структура("ЗаказНаряд", ТекущийЗаказ);
	
	СчетаЗаказа = ТаблицаСчетов.НайтиСтроки(Отбор);
	
	ПаттернСозданныхСчетов = "";
	
	СвободныеЛитералы = Строка(ПаттернЛитераловНомеров);
	
	Для каждого ТекСчет из СчетаЗаказа Цикл
		СвободныеЛитералы = СтрЗаменить(СвободныеЛитералы, Прав(ТекСчет.Счет, 1),"");
	КонецЦикла;
	
	ТекущийЛитерал = Лев(СвободныеЛитералы, 1);
	
	НомерДокумента = "" + EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(ТекущийЗаказ) + ТекущийЛитерал;
	
	Возврат НомерДокумента;
	
КонецФункции //ПолучитьСледующийНомерСчета(ТекущийЗаказ)

////@+ Функция ПолучитьСледующийНомерИнцидента(ТекущийЗаказ)
// Дата создания - 14.06.2012 15:48:34;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// По текущему ЗН функция выбирает первый свободный литерал для инцидента
// инциденты маркируются 1 символом английского алфавита. По алфавиту.
//
// Параметры
//  Парам1 ТекущийЗаказ  - ДокументСсылка.ЗаказНаряд - Ссылка на ЗН для которого создаем инцидент
//
// Возвращаемое значение
//  ТекущийЛитерал  - Строка(1) - Свободный номер Инцидента
//
//@-
Функция ПолучитьСледующийНомерИнцидента(ТекущийЗаказ) Экспорт
	
	//Первоначальная инициализация
	ТекущийЛитерал = неопределено;
		
	Отбор = Новый Структура("ЗаказНаряд", ТекущийЗаказ);
	
	ИнцидентыЗаказа = ТаблицаИнцидентов.НайтиСтроки(Отбор);
	
	СвободныеЛитералы = Строка(ПаттернЛитераловНомеров);
	
	Для каждого ТекИнцидент из ИнцидентыЗаказа Цикл
		
		СвободныеЛитералы = СтрЗаменить(СвободныеЛитералы, ТекИнцидент.Инцидент, "");
		
	КонецЦикла;
	
	ТекущийЛитерал = Лев(СвободныеЛитералы, 1);
	
	Возврат ТекущийЛитерал;
	
КонецФункции // ПолучитьСледующийНомерИнцидента(ТекущийЗаказ)

Функция ДополнитьТаблицуСоответствийКатегорий(Категория) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	EDR_КатегорииСчетовВидыРасходов.Ссылка КАК Категория,
	|	EDR_КатегорииСчетовВидыРасходов.Ссылка.Наименование,
