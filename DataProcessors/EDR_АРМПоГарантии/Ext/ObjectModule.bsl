	|		ИНАЧЕ ЗаказНарядРаботы.Работа
	|	КОНЕЦ КАК Работа,
	|	ВЫБОР
	|		КОГДА EDR_Interventions.Intervention ЕСТЬ NULL 
	|			ТОГДА ""-""
	|		ИНАЧЕ EDR_Interventions.Intervention
	|	КОНЕЦ КАК Инцидент,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.Количество
	|		ИНАЧЕ ЗаказНарядРаботы.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_РаботыДоп.Коэффициент = 0
	|							ИЛИ EDR_РаботыДоп.Коэффициент ЕСТЬ NULL 
	|						ТОГДА 1
	|					ИНАЧЕ EDR_РаботыДоп.Коэффициент
	|				КОНЕЦ
	|		ИНАЧЕ ЗаказНарядРаботы.Коэффициент
	|	КОНЕЦ КАК Коэффициент,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СуммаСкидки
	|		ИНАЧЕ ЗаказНарядРаботы.СуммаСкидки
	|	КОНЕЦ КАК СуммаСкидки,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СуммаНДС
	|		ИНАЧЕ ЗаказНарядРаботы.СуммаНДС
	|	КОНЕЦ КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СуммаВсего
	|		ИНАЧЕ ЗаказНарядРаботы.СуммаВсего
	|	КОНЕЦ КАК СуммаВсего,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.Нормочас
	|		ИНАЧЕ ЗаказНарядРаботы.Нормочас
	|	КОНЕЦ КАК Нормочас,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.Сумма
	|		ИНАЧЕ ЗаказНарядРаботы.Сумма
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА EDR_Interventions.Intervention ЕСТЬ NULL 
	|			ТОГДА """"
	|		ИНАЧЕ EDR_РаботыДоп.GUID_Инцидента
	|	КОНЕЦ КАК ИдентификаторИнцидента,
	|	EDR_РаботыДоп.GUID_Работы КАК ИдентификаторРаботы,
	|	EDR_РаботыДоп.ПричинаОбращения,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_РаботыДоп.АртикулНестандартнойОперации = """"
	|						ТОГДА EDR_РаботыДоп.DiversCode.Код
	|					ИНАЧЕ EDR_РаботыДоп.АртикулНестандартнойОперации
	|				КОНЕЦ
	|		ИНАЧЕ ЗаказНарядРаботы.Работа.Артикул
	|	КОНЕЦ КАК Артикул,
	|	EDR_РаботыДоп.РаботаПоЛКМ,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СтавкаНДС
	|		ИНАЧЕ ЗаказНарядРаботы.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	EDR_РаботыДоп.СтрокаИзЗаказНаряда,
	|	EDR_РаботыДоп.DiversCode,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.АртикулНестандартнойОперации = """"
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НеСтандартнаяОперация,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.Цена = 0
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	|						ТОГДА ЗаказНарядРаботы.Цена
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ EDR_РаботыДоп.Цена
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрСведений.EDR_РаботыДоп КАК EDR_РаботыДоп
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|		ПО EDR_РаботыДоп.GUID_Инцидента = EDR_Interventions.GUID
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
	|		ПО EDR_РаботыДоп.ЗаказНаряд = ЗаказНарядРаботы.Ссылка
	|			И EDR_РаботыДоп.GUID_Работы = ЗаказНарядРаботы.ИдентификаторРаботы
	|ГДЕ
	|	EDR_РаботыДоп.ЗаказНаряд В(&ЗаказНаряды)"
	);
	Запрос.УстановитьПараметр("ЗаказНаряды", ЗаказНаряды);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаРабот.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НС = ТаблицаРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Выборка);
		
	КонецЦикла;
	
КонецПроцедуры //ЗаполнитьРаботыПоОтбору(ЗаказНаряды)

////@+ Процедура ЗаполнитьСчетаПоОтбору(ЗаказНаряды)
// Дата создания - 14.06.2012 15:40:05;
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура производит отбор счетов(заявок) по списку заказ-нарядов
//
// Параметры
//  Парам1 ЗаказНаряды  - Массив - Массив ссылок на заказ - наряды 
//
//@-
Процедура ЗаполнитьСчетаПоОтбору(ЗаказНаряды)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	EDR_Invoices.ЗаказНаряд,
