	|ПОМЕСТИТЬ Инциденты
	|ИЗ
	|	&Инциденты КАК Инциденты
	|ГДЕ
	|	Инциденты.Удален = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаттерныРаспределения.ИдентификаторИнцидента,
	|	ПаттерныРаспределения.ВидРасходов.Control_Indicator КАК ТребоватьПричину,
	|	ПаттерныРаспределения.ВидРасходов
	|ПОМЕСТИТЬ ВТТребоватьПричину
	|ИЗ
	|	ПаттерныРаспределения КАК ПаттерныРаспределения
	|ГДЕ
	|	(ПаттерныРаспределения.ВидРасходов.Control_Indicator = ИСТИНА
	|			ИЛИ ПаттерныРаспределения.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Инциденты.ЗаказНаряд,
	|	Инциденты.Инцидент,
	|	Инциденты.ИдентификаторИнцидента,
	|	Инциденты.КодОщущенияКлиента,
	|	Инциденты.ФункциональныйКод,
	|	Инциденты.НомерСогласования,
	|	Инциденты.ОтзывнаяНота,
	|	Инциденты.НомерСФ,
	|	Инциденты.ДатаСФ,
	|	Инциденты.ПробегПриУстановке,
	|	Инциденты.ОписаниеОперации,
	|	Инциденты.ОписаниеЖалобы,
	|	Инциденты.КомментарийОперации,
	|	ВЫБОР
	|		КОГДА ВТТребоватьПричину.ТребоватьПричину = ИСТИНА
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребоватьПричину,
	|	ВЫБОР
	|		КОГДА ВТТребоватьПричину.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ТребоватьЖалобуКомментарий,
	|	ВТТребоватьПричину.ВидРасходов
	|ПОМЕСТИТЬ ПаттерныИнцидентов
	|ИЗ
