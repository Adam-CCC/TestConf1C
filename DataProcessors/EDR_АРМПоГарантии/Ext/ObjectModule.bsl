////@+ Процедура ПроверитьЗаполнениеПолейИнцидентов(МВТ, ТаблицаОшибок)
// Дата создания - 10.04.2012 10:36:40
// Автор - Окипний Андрей Евгеньевич
// 
//
// Описание процедуры
//  Проверяет заполнение полей инцидентов:
//  OTS - может быть пустым
//  Функциональный код - указывается всегда
//  Код ощущения клиента - может быть пустым. 
//               Зависит от категории заявки и кода видов расходов
//
// Параметры
//  Парам1 МВТ  - Менеджер временных таблиц - Содержит менеджер временных таблиц
//                 
//  Парам2 ТаблицаОшибок  - Типизированная таблица значений- в этой таблице
//                 собирается список всех выявленных в ходе проверки ошибок заполнения
//@-
Процедура ПроверитьЗаполнениеПолейИнцидентов(МВТ, ТаблицаОшибок) 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	// Комментарий 
	//Дата создания - 10.04.2012 10:41:41; Автор - Окипний Андрей Евгеньевич
	//Выполним поиск пустых комментариев и жалоб клиента
	//Всю проверку сделаем одним пакетным запросом. 
	//
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВремИнциденты.ИдентификаторИнцидента,
	|	ВремИнциденты.ЗаказНаряд,
	|	ВремИнциденты.Инцидент,
	|	ВремИнциденты.КодОщущенияКлиента,
	|	ВремИнциденты.ФункциональныйКод,
	|	ВремИнциденты.ОтзывнаяНота
	|ПОМЕСТИТЬ ВремТЗ_OTS_ФК_КОК
	|ИЗ
	|	ВремИнциденты КАК ВремИнциденты
	|ГДЕ
	|	ВремИнциденты.ВидРасходов <> &ВидРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТЗ_OTS_ФК_КОК.ЗаказНаряд,
	|	ВремТЗ_OTS_ФК_КОК.Инцидент,
	|	""-"" КАК Заявка,
	|	""Функциональный код"" КАК Объект,
	|	""Не заполнен функциональный код"" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиФК
	|ИЗ
	|	ВремТЗ_OTS_ФК_КОК КАК ВремТЗ_OTS_ФК_КОК
	|ГДЕ
	|	ВремТЗ_OTS_ФК_КОК.ФункциональныйКод = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаряды.ЗаказНаряд
	|ПОМЕСТИТЬ Заказы_с_OTS
	|ИЗ
	|	ПаттерныЗН КАК ЗаказНаряды
	|ГДЕ
	|	ЗаказНаряды.OTS = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТЗ_OTS_ФК_КОК.ЗаказНаряд,
	|	ВремТЗ_OTS_ФК_КОК.Инцидент,
	|	""-"" КАК Заявка,
	|	""Отзывная нота"" КАК Объект,
	|	""Не указана отзывная компания"" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиOTS
	|ИЗ
	|	ВремТЗ_OTS_ФК_КОК КАК ВремТЗ_OTS_ФК_КОК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заказы_с_OTS КАК Заказы_с_OTS
	|		ПО ВремТЗ_OTS_ФК_КОК.ЗаказНаряд = Заказы_с_OTS.ЗаказНаряд
	|ГДЕ
	|	ВремТЗ_OTS_ФК_КОК.ОтзывнаяНота = ЗНАЧЕНИЕ(Справочник.СервисныеКампании.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Заказы_с_OTS
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПроверкиКОК.ИдентификаторИнцидента
	|ПОМЕСТИТЬ ТаблицаПроверкиКОК
	|ИЗ
	|	&ТаблицаПроверкиКОК КАК ТаблицаПроверкиКОК
	|ГДЕ
	|	ТаблицаПроверкиКОК.Control_EC = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТЗ_OTS_ФК_КОК.ЗаказНаряд,
	|	ВремТЗ_OTS_ФК_КОК.Инцидент,
	|	""-"" КАК Заявка,
	|	""Код ощущения/жалобы клиента"" КАК Объект,
	|	""Не заполнено поле """"Код ощущения\жалобы клиента"""""" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиКОК
	|ИЗ
	|	ВремТЗ_OTS_ФК_КОК КАК ВремТЗ_OTS_ФК_КОК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПроверкиКОК КАК ТаблицаПроверкиКОК
	|		ПО ВремТЗ_OTS_ФК_КОК.ИдентификаторИнцидента = ТаблицаПроверкиКОК.ИдентификаторИнцидента
	|ГДЕ
	|	ВремТЗ_OTS_ФК_КОК.КодОщущенияКлиента = ЗНАЧЕНИЕ(Справочник.EDR_КодыОщущенийКлиента.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаПроверкиКОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОшибкиФК.ЗаказНаряд,
	|	ОшибкиФК.Инцидент,
	|	ОшибкиФК.Заявка,
	|	ОшибкиФК.Объект,
	|	ОшибкиФК.ОписаниеОшибки
	|ИЗ
	|	ОшибкиФК КАК ОшибкиФК
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОшибкиOTS.ЗаказНаряд,
	|	ОшибкиOTS.Инцидент,
	|	ОшибкиOTS.Заявка,
	|	ОшибкиOTS.Объект,
	|	ОшибкиOTS.ОписаниеОшибки
	|ИЗ
	|	ОшибкиOTS КАК ОшибкиOTS
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОшибкиКОК.ЗаказНаряд,
	|	ОшибкиКОК.Инцидент,
	|	ОшибкиКОК.Заявка,
	|	ОшибкиКОК.Объект,
	|	ОшибкиКОК.ОписаниеОшибки
	|ИЗ
	|	ОшибкиКОК КАК ОшибкиКОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиOTS
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиКОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиФК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремТЗ_OTS_ФК_КОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремИнциденты"
	;

	Запрос.УстановитьПараметр("ТаблицаПроверкиКОК", ТаблицаПараметровВидовРасходов);
	Запрос.УстановитьПараметр("ВидРасходов", Справочники.EDR_ВидыРасходов.Ex91);
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьЗаполнениеПолейИнцидентов(МВТ, ТаблицаОшибок)

