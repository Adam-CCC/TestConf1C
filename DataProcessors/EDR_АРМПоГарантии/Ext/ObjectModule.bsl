////@+ Процедура РасчитатьЛКМ()
// Дата создания - 29.06.2012 10:06:08; 
// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Производит поиск заказов с ЛКМ и расчитывает для них количество возмещаемого ЛКМ.
//
// Параметры
//  Без параметров
//@-
Процедура РасчитатьЛКМ() Экспорт
	
	//Нужно добавить строки по расчету ЛКМ
	Отбор = Новый Структура("ЛКМ", Истина);
	ЗаказыСЛКМ = ТаблицаЗаказов.Выгрузить(Отбор);
		
	//Есть заказы, тогда нужно добавить строки с краской
	Если ЗаказыСЛКМ.Количество() > 0 Тогда
		
		Для каждого стрЗаказа из ЗаказыСЛКМ Цикл
			
			
			//получим стоимость окраски
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Renault_ВидыРемонтаДопРеквизиты.ЦенаЛКМ
			|ИЗ
			|	РегистрСведений.Renault_ВидыРемонтаДопРеквизиты КАК Renault_ВидыРемонтаДопРеквизиты
			|ГДЕ
			|	Renault_ВидыРемонтаДопРеквизиты.ВидРемонта = &ВидРемонта";
			
			
			Запрос.УстановитьПараметр("ВидРемонта", стрЗаказа.ЗаказНаряд.ВидРемонта);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				Если ЗначениеЗаполнено(Выборка.ЦенаЛКМ) Тогда
					
					ЦенаКраски = Выборка.ЦенаЛКМ;
					
				Иначе 
					
					ЦенаКраски = 490;
					
				КонецЕсли;
				
			Иначе
				
				ЦенаКраски = 490;
					
			КонецЕсли;

			
			// Комментарий 
			//Дата создания - 13.06.2012 16:47:48; Автор - Окипний Андрей Евгеньевич
			//Необходимо отобрать все работы из заказа и проверить их на малярные работы 
			//по регистру OPERACODE
			//Все малярные работы отметим галочками
			Запрос = Новый Запрос;
			ТекстЗапроса = "ВЫБРАТЬ
			|	ТаблицаРабот.ИдентификаторРаботы,
			|	ТаблицаРабот.ЗаказНаряд,
			|	ТаблицаРабот.Работа
			|ПОМЕСТИТЬ ТЗРабот
			|ИЗ
			|	&ТаблицаРабот КАК ТаблицаРабот
			|ГДЕ
			|	ТаблицаРабот.ЗаказНаряд = &ЗаказНаряд
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТЗРабот.ИдентификаторРаботы,
			|	ТЗРабот.ЗаказНаряд,
			|	ТЗРабот.Работа,
			|	Автоработы.Артикул
			|ПОМЕСТИТЬ ВремТЗ
			|ИЗ
			|	ТЗРабот КАК ТЗРабот
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Автоработы КАК Автоработы
			|		ПО ТЗРабот.Работа = Автоработы.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ТЗРабот
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВремТЗ.ИдентификаторРаботы,
			|	ВремТЗ.Работа
			|ИЗ
			|	РегистрСведений.OPERACODE_НормыРабот.СрезПоследних(&ТекДата, ВидРабот = ЗНАЧЕНИЕ(Перечисление.OPERACODE_ВидыРабот.P)) КАК OPERACODE_НормыРаботСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТЗ КАК ВремТЗ
			|		ПО OPERACODE_НормыРаботСрезПоследних.КодПоКаталогу = ВремТЗ.Артикул
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ВремТЗ"
			;
			
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
			Запрос.УстановитьПараметр("ЗаказНаряд",стрЗаказа.ЗаказНаряд);
			Запрос.УстановитьПараметр("ТаблицаРабот",ТаблицаРабот);
			ТЗМалярныхРабот = Запрос.Выполнить().Выгрузить();
			
			Для каждого стрТаблицы Из ТЗМалярныхРабот Цикл
			
				НайденнаяРабота = ТаблицаРабот.Найти(стрТаблицы.ИдентификаторРаботы, "ИдентификаторРаботы");
				
				Если НЕ НайденнаяРабота = Неопределено тогда // такого случая быть не должно. но проверку все равно ставим
					
					НайденнаяРабота.РаботаПоЛКМ = Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
			//отберем строки работ для расчета ЛКМ
			//Расчет количества ЛКМ расчитывается по формуле
			//Количество ЛКМ = сумма длительности всех работ по окраске
			//Стоимость ЛКМ = сумма стоимостей всех работ по ЛКМ * на коэффициент (1,78)
			Отбор = Новый Структура("ЗаказНаряд", стрЗаказа.ЗаказНаряд);
			Отбор.Вставить("РаботаПоЛКМ", Истина);
			
			СтрокиРаботЛКМ = ТаблицаРабот.Выгрузить(Отбор);
			
			//Работ может не быть - забыли отметить
			Если СтрокиРаботЛКМ.Количество() > 0 тогда
				
				//Проверяем количество Инцидентов //должен быть только один
				//т.е. все работы по окраске выполнялись одним инцидентом.
				//К этому же инциденту приписываем краску.
				ВР_Инцидент = СтрокиРаботЛКМ.Скопировать();
				ВР_Инцидент.Свернуть("ИдентификаторИнцидента,Инцидент");
				
				Если ВР_Инцидент.Количество() > 1 Тогда
					Сообщить("По Заказ-наряду " + стрЗаказа.ЗаказНаряд.Номер + " от " + стрЗаказа.ЗаказНаряд.Дата + Символы.ПС
					+"Работы для расчета количества ЛКМ распределены на несколько инцидентов." + Символы.ПС +"Запись изменений прервана.");
					//прерываем выполнение записи
					Возврат;
				КонецЕсли;
				
				ВР_НДС = СтрокиРаботЛКМ.Скопировать();
				ВР_НДС.Свернуть("СтавкаНДС");
				
				Если ВР_НДС.Количество() > 1 Тогда
					Сообщить("По Заказ-наряду " + стрЗаказа.ЗаказНаряд.Номер + " от " + стрЗаказа.ЗаказНаряд.Дата + Символы.ПС
					+"Работы для расчета количества ЛКМ распределены на несколько ставок НДС." + Символы.ПС +"Запись изменений прервана.");
					//прерываем выполнение записи
					Возврат;
				КонецЕсли;
				
				СтрокиРаботЛКМ.Колонки.Добавить("Длительность");
				Для каждого стрРабота из СтрокиРаботЛКМ Цикл
					стрРабота.Длительность = стрРабота.Количество * стрРабота.Коэффициент;
				КонецЦикла;
				
				КоличествоКраски = СтрокиРаботЛКМ.Итог("Длительность");
				
				СтавкаЧ = ВР_НДС[0].СтавкаНДС.Ставка;
				
				//СтоимостьКраски  = СтрокиРаботЛКМ.Итог("СуммаВсего") * 1.78;
				СтоимостьКраски = КоличествоКраски * ЦенаКраски * (1 + СтавкаЧ/100);
				НДСКраски		 = КоличествоКраски * ЦенаКраски * СтавкаЧ/100;
				
				//ЦенаКраски		 = (СтоимостьКраски - НДСКраски) / КоличествоКраски;
				
				//Добавляем строку с краской в ТаблицаТоваров, если её еще нет.
				Отбор = Новый Структура("ЗаказНаряд", стрЗаказа.ЗаказНаряд);
				Отбор.Вставить("Артикул","IP");
				
				СтрокиСКраской = ТаблицаТоваров.НайтиСтроки(Отбор);
				
				//Если строка уже существует продолжаем.
				Если СтрокиСКраской.Количество() > 0 тогда //эти строки нужно пометить на удаление
					
					Краска = СтрокиСКраской[0];
					
				Иначе
					
					Краска = ТаблицаТоваров.Добавить();
					
				КонецЕсли;
				
				
				Краска.ЗаказНаряд			  = стрЗаказа.ЗаказНаряд;
				Краска.ИдентификаторИнцидента = ВР_Инцидент[0].ИдентификаторИнцидента;
				Краска.Инцидент				  = ВР_Инцидент[0].Инцидент;
				Краска.ИдентификаторТовара	  = Строка(Новый УникальныйИдентификатор());
				Краска.Артикул				  = Справочники.EDR_DiversCode.IP.Код;
				Краска.DiversCode			  = Справочники.EDR_DiversCode.IP;
				Краска.Номенклатура			  = Справочники.EDR_DiversCode.IP.Наименование;
				Краска.Количество			  = КоличествоКраски;
				Краска.СуммаВсего			  = СтоимостьКраски;
				Краска.СтавкаНДС			  = ВР_НДС[0].СтавкаНДС;
				//Краска.СуммаНДС				  = НДСКраски;
				Краска.Цена					  = ЦенаКраски;
				
			Иначе
				Сообщить("По Заказ-наряду " + стрЗаказа.ЗаказНаряд.Номер + " от " + стрЗаказа.ЗаказНаряд.Дата + Символы.ПС
						+"Не указаны работы для расчета количества ЛКМ." + Символы.ПС +"Запись изменений прервана.");
				//прерываем выполнение записи
				Возврат;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // РасчитатьЛКМ()

/////////////////////////////////////////////////////////////////
//Процедуры проверок и интерактивной настройки системы

//Делаем проверку по использованию Инцидента
Функция ПроверитьИспользованиеИнцидента(ИдентификаторИнцидента) Экспорт
	
	СтруктураРезультата = Новый Структура;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	//Таблицы в Менеджер
	//Товары
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаТоваров",ТаблицаТоваров);
	Запрос.Выполнить();
	
	//Работы
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТРаботы
	|ИЗ
	|	&ТаблицаРабот КАК ТаблицаРабот";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаРабот",ТаблицаРабот);
	Запрос.Выполнить();

	//Соответствия
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТСоответствия
	|ИЗ
	|	&ТаблицаСоответствий КАК ТаблицаСоответствий";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаСоответствий",ТаблицаСоответствий);
	Запрос.Выполнить();
	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТТовары.ИдентификаторТовара,
	|	ВТТовары.Номенклатура,
	|	ВТТовары.ИдентификаторИнцидента
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|ГДЕ
	|	ВТТовары.ИдентификаторИнцидента = &ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТТовары";
	Запрос.УстановитьПараметр("ИдентификаторИнцидента",ИдентификаторИнцидента);
	ВремТовары = Запрос.Выполнить().Выгрузить();
	СтруктураРезультата.Вставить("Товары",ВремТовары);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТРаботы.ИдентификаторРаботы,
	|	ВТРаботы.Работа,
	|	ВТРаботы.ИдентификаторИнцидента
	|ИЗ
	|	ВТРаботы КАК ВТРаботы
	|ГДЕ
	|	ВТРаботы.ИдентификаторИнцидента = &ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТРаботы";
	Запрос.УстановитьПараметр("ИдентификаторИнцидента",ИдентификаторИнцидента);
	ВремРаботы = Запрос.Выполнить().Выгрузить();
	СтруктураРезультата.Вставить("Работы",ВремРаботы);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТСоответствия.Идентификатор,
	|	ВТСоответствия.ИдентификаторИнцидента
	|ИЗ
	|	ВТСоответствия КАК ВТСоответствия
	|ГДЕ
	|	ВТСоответствия.ИдентификаторИнцидента = &ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСоответствия";
	Запрос.УстановитьПараметр("ИдентификаторИнцидента",ИдентификаторИнцидента);
	ВремСоответствия = Запрос.Выполнить().Выгрузить();
	СтруктураРезультата.Вставить("Соответствия",ВремСоответствия);
	
	Если ВремТовары.Количество() > 0 
	 или ВремРаботы.Количество() > 0 
	 или ВремСоответствия.Количество() > 0 тогда
		СтруктураРезультата.Вставить("ЕстьИспользование", Истина);
	Иначе
		СтруктураРезультата.Вставить("ЕстьИспользование", Ложь);
	КонецЕсли;
	
	Возврат СтруктураРезультата;
КонецФункции

//Делаем проверку по использованию Инцидента
Функция ПроверитьИспользованиеСчета(ИдентификаторСчета) Экспорт
	
	СтруктураРезультата = Новый Структура;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	//Таблицы в Менеджер
	//Соответствия
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТСоответствия
	|ИЗ
	|	&ТаблицаСоответствий КАК ТаблицаСоответствий";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаСоответствий",ТаблицаСоответствий);
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТСоответствия.Идентификатор,
	|	ВТСоответствия.ИдентификаторСчета
	|ИЗ
	|	ВТСоответствия КАК ВТСоответствия
	|ГДЕ
	|	ВТСоответствия.ИдентификаторСчета = &ИдентификаторСчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСоответствия";
	Запрос.УстановитьПараметр("ИдентификаторСчета",ИдентификаторСчета);
	ВремСоответствия = Запрос.Выполнить().Выгрузить();
	СтруктураРезультата.Вставить("Соответствия",ВремСоответствия);
	
	Если ВремСоответствия.Количество() > 0 тогда
		СтруктураРезультата.Вставить("ЕстьИспользование", Истина);
	Иначе
		СтруктураРезультата.Вставить("ЕстьИспользование", Ложь);
	КонецЕсли;
	
	Возврат СтруктураРезультата;
КонецФункции

//Процедуры Записи изменений в регистры
Процедура ЗаписьИзмененийПоСчетам()
	
	//нужно отработать номер заявки при повторной отправке.
	ОтборПовторнаяОтправка = Новый Структура("ПовторнаяОтправка", Истина);
	ТЗПовторнаяОтправка = ТаблицаЗаказов.Выгрузить(ОтборПовторнаяОтправка);
	
	Для Каждого стрЗаказНаряд из ТЗПовторнаяОтправка Цикл
		
		//Пройдемся по заявкам
		ОтборЗаявок = Новый Структура;
		ОтборЗаявок.Вставить("Удален", Ложь);
		ОтборЗаявок.Вставить("ЗаказНаряд",стрЗаказНаряд.ЗаказНаряд);
		
		НайденныеЗаявки = ТаблицаСчетов.НайтиСтроки(ОтборЗаявок);
		
		Для Каждого Заявка из НайденныеЗаявки Цикл
			
			НомерЗаявкиПаттерн = EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(стрЗаказНаряд.ЗаказНаряд);
			НовыйНомер = Прав(НомерЗаявкиПаттерн, 4) + "P";
			
			Заявка.Счет = СтрЗаменить(Заявка.Счет, НомерЗаявкиПаттерн, НовыйНомер);
			
		КонецЦикла;
	КонецЦикла;
	//Измененные строки
	Отбор = Новый Структура("Удален", Ложь);
	ВремТЗ = ТаблицаСчетов.НайтиСтроки(Отбор);

	Для Каждого СтрокаТЗ из ВремТЗ Цикл
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЗаказНаряд",СтрокаТЗ.ЗаказНаряд);
		СтруктураПараметров.Вставить("Invoice",СтрокаТЗ.Счет);
		СтруктураПараметров.Вставить("GUID",СтрокаТЗ.ИдентификаторСчета);
		СтруктураПараметров.Вставить("Категория",СтрокаТЗ.Категория);
		СтруктураПараметров.Вставить("ДатаИнвойса",СтрокаТЗ.ДатаИнвойса);
		СтруктураПараметров.Вставить("Expense_code",СтрокаТЗ.ВидРасходов);
		СтруктураПараметров.Вставить("СчетФактура",СтрокаТЗ.СчетФактура);
		
		РегистрыСведений.EDR_Invoices.ОбновитьИнвойс(СтруктураПараметров);
		
	КонецЦикла;
	
	//Удаленные строки
	Отбор = Новый Структура("Удален", Истина);
	ВремТЗ = ТаблицаСчетов.НайтиСтроки(Отбор);

	Для Каждого СтрокаТЗ из ВремТЗ Цикл
		РегистрыСведений.EDR_Invoices.УдалитьИнвойс(СтрокаТЗ.ИдентификаторСчета);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписьИзмененийПоИнцидентам()
	
	//Измененные строки
	Отбор = Новый Структура("Удален", Ложь);
	ВремТЗ = ТаблицаИнцидентов.НайтиСтроки(Отбор);
	
	Для каждого СтрокаТЗ из ВремТЗ Цикл
		Если СтрокаТЗ.Удален тогда Продолжить; КонецЕсли;
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЗаказНаряд", СтрокаТЗ.ЗаказНаряд);
		СтруктураПараметров.Вставить("GUID", СтрокаТЗ.ИдентификаторИнцидента);
		СтруктураПараметров.Вставить("Intervention", СтрокаТЗ.Инцидент);
		СтруктураПараметров.Вставить("RC_code", СтрокаТЗ.КодОщущенияКлиента);
		СтруктураПараметров.Вставить("Function_Code", СтрокаТЗ.ФункциональныйКод);
		СтруктураПараметров.Вставить("OTS_number", СтрокаТЗ.ОтзывнаяНота);
		СтруктураПараметров.Вставить("НомерСогласования", СтрокаТЗ.НомерСогласования);
		СтруктураПараметров.Вставить("НомерСФ", СтрокаТЗ.НомерСФ);
		СтруктураПараметров.Вставить("ДатаСФ", СтрокаТЗ.ДатаСФ);
		СтруктураПараметров.Вставить("ПробегПриУстановке", СтрокаТЗ.ПробегПриУстановке);
		СтруктураПараметров.Вставить("ОписаниеОперации", СтрокаТЗ.ОписаниеОперации);
		СтруктураПараметров.Вставить("ОписаниеЖалобы", СокрЛП(СтрокаТЗ.ОписаниеЖалобы));
		СтруктураПараметров.Вставить("КомментарийОперации", СтрокаТЗ.КомментарийОперации);
		СтруктураПараметров.Вставить("РезультатДиагностики", СтрокаТЗ.РезультатДиагностики);
		
		РегистрыСведений.EDR_Interventions.ОбновитьИнцидент(СтруктураПараметров);
		
	КонецЦикла;
	
	//Теперь Удаляем удаленные
	Отбор = Новый Структура("Удален", Истина);
	ВремТЗ = ТаблицаИнцидентов.НайтиСтроки(Отбор);
	Для каждого СтрокаТЗ Из ВремТЗ Цикл
		
		РегистрыСведений.EDR_Interventions.УдалитьИнцидент(СтрокаТЗ.ИдентификаторИнцидента);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписьИзмененийПоТоварам()
	
	Для каждого стрТЗ из ТаблицаЗаказов Цикл
		
		Отбор = Новый Структура("ЗаказНаряд",СтрТЗ.ЗаказНаряд);
		//записываем только не помеченные на удаление
		Отбор.Вставить("Удален", ложь);
		
		ТЗТоваров = ТаблицаТоваров.Выгрузить(Отбор); //Тут нужно работать с таблицей значений
		
		ТЗТоваров.Колонки.ИдентификаторТовара.Имя = "GUID_Товара";
		ТЗТоваров.Колонки.ИдентификаторИнцидента.Имя = "GUID_Инцидента";
		ТЗТоваров.Колонки.НеВключатьВСчет.Имя = "NotInvoiced";
		
		РегистрыСведений.EDR_ТоварыДоп.ОбновитьТовары(ТЗТоваров, СтрТЗ.ЗаказНаряд);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписьИзмененийПоРаботам()
	
	Для каждого стрТЗ из ТаблицаЗаказов Цикл
		
		Отбор = Новый Структура("ЗаказНаряд",СтрТЗ.ЗаказНаряд);
		
		//записываем только не помеченные на удаление
		Отбор.Вставить("Удален", ложь);
		
		ТЗРабот = ТаблицаРабот.Выгрузить(Отбор); //Тут нужно работать с таблицей значений
		
		ТЗРабот.Колонки.ИдентификаторРаботы.Имя = "GUID_Работы";
		ТЗРабот.Колонки.ИдентификаторИнцидента.Имя = "GUID_Инцидента";
		
		ТЗРабот.Колонки.Добавить("АртикулНестандартнойОперации");
		ТЗРабот.Колонки.Добавить("НаименованиеНеСтандартнойОперации");
		
		Для Каждого СтрокаТЗ из ТЗРабот Цикл
			
			СтрокаТЗ.АртикулНестандартнойОперации = ?(СтрокаТЗ.НеСтандартнаяОперация,СтрокаТЗ.Артикул,"");
			СтрокаТЗ.НаименованиеНеСтандартнойОперации = ?(СтрокаТЗ.НеСтандартнаяОперация,СтрокаТЗ.Работа,"");
			
		КонецЦикла;
		
		РегистрыСведений.EDR_РаботыДоп.ОбновитьРаботы(ТЗРабот, СтрТЗ.ЗаказНаряд);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписьИзмененийПоСоответствиям()
	
	//Измененные строки
	Отбор = Новый Структура("Удален", Ложь);
	ВремТЗ = ТаблицаСоответствий.Выгрузить(Отбор);
	ВремТЗ.Колонки.Удалить("НомерСтроки");
	ВремТЗ.Колонки.Удалить("Удален");
	
	ВремТЗ.Колонки.Идентификатор.Имя = "GUID";
	ВремТЗ.Колонки.ИдентификаторИнцидента.Имя = "intervention";
	ВремТЗ.Колонки.ИдентификаторСчета.Имя = "Invoice";
	
	Колонки = ВремТЗ.Колонки;
	Для каждого стрТЗ из ВремТЗ Цикл
		СтруктураПараметров = Новый Структура;
		Для каждого Колонка из Колонки Цикл
			СтруктураПараметров.Вставить(Колонка.Имя,СтрТЗ[Колонка.Имя]);
		КонецЦикла;
		РегистрыСведений.EDR_СоответствияИнвойсов.ОбновитьСоответствие(СтруктураПараметров);
		
	КонецЦикла;
	
	//Удаленные строки
	Отбор = Новый Структура("Удален", Истина);
	ВремТЗ = ТаблицаСоответствий.Выгрузить(Отбор);
	
	Для каждого СтрокаТЗ из ВремТЗ Цикл 
		РегистрыСведений.EDR_СоответствияИнвойсов.УдалитьСоответствие(СтрокаТЗ.Идентификатор);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписьИзмененийПоЗаказНарядам()
	
	Для каждого СтрокаТЗ из ТаблицаЗаказов Цикл
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЗаказНаряд",СтрокаТЗ.ЗаказНаряд);
		СтруктураПараметров.Вставить("ПробегАвтомобиля",СтрокаТЗ.ПробегАвтомобиля);
		СтруктураПараметров.Вставить("ДатаЗакрытия",СтрокаТЗ.ДатаЗакрытия);
		СтруктураПараметров.Вставить("OTS",СтрокаТЗ.OTS);
		СтруктураПараметров.Вставить("Гарантия",Истина); //Тут только гарантия
		СтруктураПараметров.Вставить("ДатаОткрытия",СтрокаТЗ.ДатаОткрытия);
		СтруктураПараметров.Вставить("ОтправленВСистему_GCM",СтрокаТЗ.Отправлен);
		СтруктураПараметров.Вставить("СемействоАвтомобиля",СтрокаТЗ.СемействоАвтомобиля);
		СтруктураПараметров.Вставить("РангАвторабот",СтрокаТЗ.РангАвторабот);
		СтруктураПараметров.Вставить("ГотовностьКОтправке",СтрокаТЗ.ГотовностьКОтправке);
		СтруктураПараметров.Вставить("ПовторнаяОтправка",СтрокаТЗ.ПовторнаяОтправка);
		
		РегистрыСведений.EDR_ЗаказНаряды.ОбновиитьЗаказНарядВРегистре(СтруктураПараметров);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СохранитьИзмененияВРегистры() Экспорт
	//Все изменения регистров должны производиться одним пакетом.
	//Либо все, либо ничего, иначе будет разрушена целостность.
	
	НачатьТранзакцию();
	Попытка
		ЗаписьИзмененийПоСчетам();
		ЗаписьИзмененийПоИнцидентам();
		ЗаписьИзмененийПоРаботам();
		ЗаписьИзмененийПоТоварам();
		ЗаписьИзмененийПоСоответствиям();
		ЗаписьИзмененийПоЗаказНарядам();
		Результат = Истина;
		//Ошибок нет - фиксируем транзакцию
		ЗафиксироватьТранзакцию();
	Исключение
		
		Сообщить(ОписаниеОшибки());
		//Были ошибки - транзакцию отменяем.
		
		ОтменитьТранзакцию();
		Результат = Ложь;
	КонецПопытки;
	
	ЗаполнитьТаблицы();
	
	Возврат Результат;
	
КонецФункции

