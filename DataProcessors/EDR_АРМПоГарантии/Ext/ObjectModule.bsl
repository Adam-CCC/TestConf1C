	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка заполнения жалоб клиента и комментариев.";
	
	ПроверитьПустыеКомментарии(МВТ, ТаблицаОшибок);
	
	// Комментарий 
	//Дата создания - 10.04.2012 10:32:20; Автор - Окипний Андрей Евгеньевич
	//Проверка корректности заполнения полей Функциональный код, код ощущения
	//и OTS
	
	ФормаПрогресса.ЗначениеИндикатора = 9;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка заполнения полей Функциональный код," + 
												 Символы.ПС + "код ощущения и OTS.";
	ПроверитьЗаполнениеПолейИнцидентов(МВТ, ТаблицаОшибок);
	
	// Комментарий 
	//Дата создания - 10.04.2012 13:08:17; Автор - Окипний Андрей Евгеньевич
	//Проверка полей "Категория заявок"
	//
	ФормаПрогресса.ЗначениеИндикатора = 10;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка заполнения полей ""Категория"" для заявок.";
	
	ПроверитьЗаполнениеКатегорииЗаявок(МВТ, ТаблицаОшибок);
	
	//Комментарий 
	//Дата создания - 11.04.2012 10:53:05; Автор - Окипний Андрей Евгеньевич
	//Проверка полей "Вид расходов"
	//
	ФормаПрогресса.ЗначениеИндикатора = 11;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка заполнения полей ""Вид расходов"" для заявок.";
	
	ПроверитьЗаполнениеКодСтатьиРасходовЗаявок(МВТ, ТаблицаОшибок);
	
	// Комментарий 
	//Дата создания - 11.04.2012 11:23:46; Автор - Окипний Андрей Евгеньевич
	//Теперь проверим все ли заявки имеют инциденты
	//
	ФормаПрогресса.ЗначениеИндикатора = 12;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Поиск пустых заявок";
	
	ПроверитьПустыеЗаявки(МВТ, ТаблицаОшибок);
	
	// Комментарий 
	//Дата создания - 11.04.2012 11:40:06; Автор - Окипний Андрей Евгеньевич
	//Теперь обратная операция, будем искать не привязанные инциденты
	//
	ФормаПрогресса.ЗначениеИндикатора = 13;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Поиск ""потерянных"" инцидентов";
	
	ПроверитьПотерянныеИнциденты(МВТ, ТаблицаОшибок);
	
	// Комментарий 
	//Дата создания - 13.06.2012 16:35:09; Автор - Окипний Андрей Евгеньевич
	//Проверка правильности заполнения вида расходов - 19
	//
	ФормаПрогресса.ЗначениеИндикатора = 14;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка кода статьи расходов 19";
	
	ПроверитьКодРасходов_19(МВТ, ТаблицаОшибок);
	
	// Комментарий 
	//Дата создания - 14.06.2012 10:26:22; Автор - Окипний Андрей Евгеньевич
	//Проверка Номенклатуры и работ на принадлежность Renault.
	//Для этого делаем проверку работ и номенклатуры по регистрам Tarif PR и OPERACODE
	//
	
	ФормаПрогресса.ЗначениеИндикатора = 15;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Проверка номенклатуры и авторабот по каталогам RENAULT";
	
	ПроверитьНоменклатуруИАвтоработыНаСоответствие(МВТ, ТаблицаОшибок, ТаблицаОшибокРаботыТовары);
	
	
	// Комментарий 
	//Дата создания - 14.06.2012 15:05:55; Автор - Окипний Андрей Евгеньевич
	//Проверка количества установленных причин обращения. для каждого инцидента возможна только одна
