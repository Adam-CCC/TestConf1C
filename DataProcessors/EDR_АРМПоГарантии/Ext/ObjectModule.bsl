//	проверка на корректность введенных данных.

Функция ПроверитьНаКорректность(ЭтоОшибкиРаботыТовары = Ложь) Экспорт
	
	ВсеНормально = Истина;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	ФормаПрогресса = ПолучитьОбщуюФорму("DMS_ФормаПроцессаОбщая");
	ФормаПрогресса.МаксимальноеЗначение = 20;
	
	ФормаПрогресса.Открыть();
	
	ФормаПрогресса.СтрокаСостоянияПрогрессора = "Проверка данных на корректность.";
	
	//Для начала собираем паттерн заказ-нарядов. Какие просрочены а какие нет.
	//Паралельно добавляем поле нужно согласование или нет.
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("ЗаказНаряды", ТаблицаЗаказов);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Заявки", ТаблицаСчетов);
	Запрос.УстановитьПараметр("Инциденты", ТаблицаИнцидентов);
	Запрос.УстановитьПараметр("СоответсвияСчетов", ТаблицаСоответствий);
	Запрос.УстановитьПараметр("ТабНоменклатура", ТаблицаТоваров);
	Запрос.УстановитьПараметр("Работы", ТаблицаРабот);
	
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Формирование паттерна Заказ-нарядов";

	//Отбираем только те заказы, которые готовы к отправке или повторно отправляются
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗаказНаряды.ЗаказНаряд,
	|	ЗаказНаряды.OTS,
	|	ЗаказНаряды.ГотовностьКОтправке,
	|	ЗаказНаряды.ПовторнаяОтправка,
	|	ЗаказНаряды.Отправлен,
	|	ЗаказНаряды.ДатаОткрытия,
	|	ЗаказНаряды.СемействоАвтомобиля,
	|	ЗаказНаряды.ЛКМ,
	|	ЗаказНаряды.ПробегАвтомобиля,
	|	ВЫБОР
	|		КОГДА ЗаказНаряды.Отправлен = ИСТИНА
	|				И ЗаказНаряды.ПовторнаяОтправка = ИСТИНА
	|			ТОГДА ИСТИНА
	|		КОГДА ЗаказНаряды.Отправлен = ИСТИНА
	|				И ЗаказНаряды.ПовторнаяОтправка = ЛОЖЬ
	|			ТОГДА ЛОЖЬ
	|		КОГДА ЗаказНаряды.Отправлен = ЛОЖЬ
	|				И ЗаказНаряды.ПовторнаяОтправка = ЛОЖЬ
	|				И ЗаказНаряды.ГотовностьКОтправке = ИСТИНА
	|			ТОГДА ИСТИНА
	|	КОНЕЦ КАК ПризнакОтбора
	|ПОМЕСТИТЬ ЗаказНаряды
	|ИЗ
	|	&ЗаказНаряды КАК ЗаказНаряды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаряды.ЗаказНаряд,
	|	ЗаказНаряды.OTS,
	|	ЗаказНаряды.ГотовностьКОтправке,
	|	ЗаказНаряды.ПовторнаяОтправка,
	|	ЗаказНаряды.Отправлен,
	|	ЗаказНаряды.ДатаОткрытия,
	|	ЗаказНаряды.СемействоАвтомобиля,
	|	ЗаказНаряды.ЛКМ,
	|	ЗаказНаряды.ПробегАвтомобиля,
	|	&ТекущаяДата,
	|	ВЫБОР
	|		КОГДА ЗаказНаряды.ПовторнаяОтправка
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ВЫБОР
	|				КОГДА РАЗНОСТЬДАТ(&ТекущаяДата, ЗаказНаряды.ДатаОткрытия, ДЕНЬ) < 30
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ
	|	КОНЕЦ КАК ТребоватьСогласование
	|ПОМЕСТИТЬ ПаттерныЗН
	|ИЗ
	|	ЗаказНаряды КАК ЗаказНаряды
	|ГДЕ
	|	ЗаказНаряды.ПризнакОтбора = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ЗаказНаряды"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	ФормаПрогресса.ЗначениеИндикатора = 1;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Формирование паттерна Заявок";
	
	//Получаем паттерн Заявок в менеджер ВТ
	ТекстЗапроса = "ВЫБРАТЬ
	|	Заявки.ЗаказНаряд,
	|	Заявки.Счет,
	|	Заявки.ИдентификаторСчета,
	|	Заявки.Категория,
	|	Заявки.ДатаИнвойса,
	|	Заявки.ВидРасходов,
	|	Заявки.Удален,
	|	Заявки.СчетФактура
	|ПОМЕСТИТЬ Заявки
	|ИЗ
	|	&Заявки КАК Заявки
	|ГДЕ
	|	Заявки.Удален = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Заявки.ЗаказНаряд КАК ЗаказНаряд,
	|	Заявки.Счет,
	|	Заявки.ИдентификаторСчета,
	|	Заявки.Категория,
	|	Заявки.ДатаИнвойса,
	|	Заявки.ВидРасходов,
	|	Заявки.Удален,
	|	Заявки.СчетФактура
	|ПОМЕСТИТЬ ПаттерныЗаявок
	|ИЗ
	|	Заявки КАК Заявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПаттерныЗН КАК ПаттерныЗН
	|		ПО Заявки.ЗаказНаряд = ПаттерныЗН.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Заявки"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	ФормаПрогресса.ЗначениеИндикатора = 2;
	ФормаПрогресса.НадписьСостоянияПрогрессора = "Формирование паттерна Распределения инцидентов по заявкам";
	
	//Получаем паттерн соответсвий в менеджер ВТ
	//Из соответсвия потом получим какие инциденты нам нужны.
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СоответсвияСчетов.ЗаказНаряд,
	|	СоответсвияСчетов.ИдентификаторСчета,
	|	СоответсвияСчетов.ИдентификаторИнцидента,
	|	СоответсвияСчетов.Процент,
	|	СоответсвияСчетов.ВидРасходов,
	|	СоответсвияСчетов.Категория
	|ПОМЕСТИТЬ Распределения
	|ИЗ
	|	&СоответсвияСчетов КАК СоответсвияСчетов
	|ГДЕ
	|	СоответсвияСчетов.Удален = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаттерныРаспределения.ЗаказНаряд,
	|	ПаттерныРаспределения.ИдентификаторСчета,
