Перем ИсточникДанных Экспорт;
Перем ADOСоединение;
Перем ADOНаборДанныхТарифы;
Перем ADOКоманда;

Перем СоединениеУстановлено Экспорт;

Перем Таблица Экспорт;
Перем Идентификатор Экспорт;
Перем ДатаЗагрузки Экспорт;

Перем АдресDSN;

Перем СтруктураПараметров;

Функция ПолучитьАдресDSN(ПутьКФайлу)
	
	Результат = Ложь;
	
	МакетDSN = ПолучитьМакет("МакетDSN");
	ТекстDSN = МакетDSN.ПолучитьТекст();
	
	ТекстDSN = СтрЗаменить(ТекстDSN, "DefaultDir=", "DefaultDir="+ПутьКФайлу);
	ТекстDSN = СтрЗаменить(ТекстDSN, "DBQ=", "DBQ="+СокрЛП(ИсточникДанных));
	
	ИмяФайлаDSN = ПолучитьИмяВременногоФайла("dsn");
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстDSN);
	
	ТекстовыйДокумент.Записать(ИмяФайлаDSN, КодировкаТекста.ANSI);
	
	ВремФайл = Новый Файл(ИмяФайлаDSN);
	
	Если ВремФайл.Существует() тогда
		АдресDSN = ВремФайл.ПолноеИмя;
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПолучитьАдресDSN(ПутьКФайлу)()

Функция УстановитьСоединение() Экспорт
	
	//На всякий случай проверим наличие источника
	Если НЕ ЗначениеЗаполнено(ИсточникДанных) тогда 
		
		Renault_Открытый.СообщитьПользователю("Не выбран файл - источник"+ Символы.ПС+"Продолжение не возможно");
		
		Возврат ложь;
		
	КонецЕсли;
	
	ФайлБазы = Новый Файл(ИсточникДанных);
	ПутьКФайлу = ФайлБазы.Путь;
	
	Если НЕ ПолучитьАдресDSN(ПутьКФайлу) тогда
		Возврат ложь;
	КонецЕсли;
	
	Попытка
		
		СтруктураПараметров.Вставить("ДатаФайлаНовый", Дата(ФайлБазы.ПолучитьВремяИзменения()));
		
		ADOСоединение = Новый COMОбъект("ADODB.Connection");
		ADOСоединение.Open("Provider=MSDASQL.1;
		|Persist Security Info=False;
		|Extended Properties=""DBQ="+СокрЛП(ИсточникДанных)+";
		|DefaultDir="+ПутьКФайлу+";
		|Driver={Microsoft Access Driver (*.mdb)};
		|DriverId=25;FIL=MS Access;
		|FILEDSN=" + АдресDSN + ";
		|MaxBufferSize=2048;
		|MaxScanRows=8;
		|PageTimeout=5;
		|SafeTransactions=0;
		|Threads=3;
		|UID=admin;
		|UserCommitSync=Yes;"";
		|Initial Catalog=" + СокрЛП(СтрЗаменить(НРег(ИсточникДанных),".mdb",""))
		);
		
		//ТекстЗапроса = "SELECT TOP 50000 * FROM [Tariff_Dealers]"; //Запрос ограничен 50000 записями. при публикации нужно будет убрать
		ТекстЗапроса = "SELECT * FROM [Tariff_Dealers]"; //Запрос НЕ ограничен записями.
		
		ADOНаборДанныхТарифы = Новый COMОбъект("ADODB.RecordSet");
		ADOНаборДанныхТарифы.Open(ТекстЗапроса, ADOСоединение);
		
		ADOКоманда = Новый COMОбъект("ADODB.Command");
		ADOКоманда.ActiveConnection = ADOСоединение;
		
		СоединениеУстановлено = Истина;
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
		СоединениеУстановлено = ложь;
	КонецПопытки;
	
	Возврат СоединениеУстановлено;
	
КонецФункции

Процедура СчитатьДанные() Экспорт
	
	Таблица.Очистить();
	
	///////////////////////////////////////////////
	КоличествоПолей = ADOНаборДанныхТарифы.Fields.Count - 1;
	
	Сч = 0;
	Пока ADOНаборДанныхТарифы.EOF = false Цикл
		Сч = Сч + 1;
		НоваяСтрока = Таблица.Добавить();
		Для ПолеСч = 0 по КоличествоПолей Цикл
			Поле = ADOНаборДанныхТарифы.Fields.item(ПолеСч);
			ИмяПоля = СтрЗаменить(Поле.name," ","_");
			ИмяПоля = СтрЗаменить(ИмяПоля,"__","_"); //Может быть и такая ситуация
			
			// Комментарий 
			//Дата создания - 08.11.2012 11:37:20; Автор - Окипний Андрей Евгеньевич
			//В файл добавлено новое поле, что вызывает исключение
			//Дабы избежать в дальнейшем таких проблем загоним заполнение поля в попытку
			Попытка
				НоваяСтрока[ИмяПоля] = Поле.Value;
			Исключение КонецПопытки;
			
		КонецЦикла;
		
		ADOНаборДанныхТарифы.MoveNext();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗакрытьСоединения() Экспорт
	
	ADOНаборДанныхТарифы = Неопределено;
	ADOКоманда = Неопределено;
	
	ADOСоединение.Close();
	
	ADOСоединение = Неопределено;
	
	Попытка
		
		УдалитьФайлы(АдресDSN);
		
	Исключение КонецПопытки;
	
КонецПроцедуры

СоединениеУстановлено = ложь;
Идентификатор = Формат(ТекущаяДата(),"ДФ=yyyyMMdd");
ДатаЗагрузки = НачалоДня(ТекущаяДата());

СтруктураПараметров = Новый Структура;

СтруктураПараметров.Вставить("Идентификатор", Идентификатор);
СтруктураПараметров.Вставить("ДатаЗагрузки", ДатаЗагрузки);

АдресDSN = "";