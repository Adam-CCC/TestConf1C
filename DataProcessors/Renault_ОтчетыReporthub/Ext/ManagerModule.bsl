
Функция ПолучитьОстатки(ДатаОстатков, МассивСкладов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", ДатаОстатков);
	Запрос.УстановитьПараметр("Склады", МассивСкладов);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиТоваровКомпанииОбороты.Номенклатура,
	|	МАКСИМУМ(ОстаткиТоваровКомпанииОбороты.Период) КАК ПоследнийПриход
	|ПОМЕСТИТЬ ПоследнееПоступление
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Обороты(, &Дата, День, СкладКомпании В (&Склады)) КАК ОстаткиТоваровКомпанииОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваровКомпанииОбороты.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул = """"
	|			ТОГДА ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.Номенклатура.Код КАК СТРОКА(25))
	|		ИНАЧЕ ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул КАК СТРОКА(25))
	|	КОНЕЦ КАК Артикул,
	|	ВЫРАЗИТЬ(ОстаткиТоваровКомпанииОстатки.Номенклатура.Наименование КАК СТРОКА(255)) КАК Наименование,
	|	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Количество,
	|	ЕСТЬNULL(ЗаказыПоставщикамОстатки.ЗаказаноОстаток, 0) КАК Заказано,
	|	ПоследнееПоступление.ПоследнийПриход
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&Дата, СкладКомпании В (&Склады)) КАК ОстаткиТоваровКомпанииОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки(&Дата, ) КАК ЗаказыПоставщикамОстатки
	|		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = ЗаказыПоставщикамОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПоследнееПоступление КАК ПоследнееПоступление
	|		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = ПоследнееПоступление.Номенклатура";
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции