Функция ПолучитьИнвойсЧанган(Авто)
	
	ИнвойсРассчетный_ = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РассчетныйИнвойсСрезПоследних.Автомобиль КАК Автомобиль,
		|	РассчетныйИнвойсСрезПоследних.ИнвойсРассчетный КАК ИнвойсРассчетный
		|ИЗ
		|	РегистрСведений.РассчетныйИнвойс.СрезПоследних КАК РассчетныйИнвойсСрезПоследних
		|ГДЕ
		|	РассчетныйИнвойсСрезПоследних.Автомобиль = &Авто";
	
	Запрос.УстановитьПараметр("Авто", Авто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ИнвойсРассчетный_ = ВыборкаДетальныеЗаписи.ИнвойсРассчетный;
	КонецЦикла;
	
	Возврат ИнвойсРассчетный_;
 
КонецФункции // ПолучитьИнвойсЧанган(Авто) 

Функция ОпределитьБесплатныйПериод(Авто,ТЗ_ТаблицаПериодовБесплатногоХранения)
	
	НайдБесплПериод = 0;
	
	ПарОтбора = Новый Структура();
	ПарОтбора.Вставить("Автомобиль",Авто);
	НайдСтроки = ТЗ_ТаблицаПериодовБесплатногоХранения.НайтиСтроки(ПарОтбора);
	
	Если НайдСтроки.Количество() > 0 Тогда
	   	НайдБесплПериод = НайдСтроки[0].КоличествоДнейПоМодели;
		Если обЗначениеНеЗаполнено(НайдБесплПериод) Тогда
			НайдБесплПериод = НайдСтроки[0].КоличествоДнейПоМарке;
		КонецЕсли;	
	 КонецЕсли;
	
	Возврат НайдБесплПериод;

КонецФункции // ОпределитьРРЦ()
