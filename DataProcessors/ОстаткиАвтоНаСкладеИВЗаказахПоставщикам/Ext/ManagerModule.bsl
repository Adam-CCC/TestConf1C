	               |	Автомобили.Ссылка КАК Автомобиль,
	               |	Автомобили.Модель КАК Модель,
	               |	Автомобили.Модель.Марка КАК Марка,
	               |	ЗапросПоМодели.Модель КАК МодельЗапросаПоМодели,
	               |	ЗапросПоМодели.КоличествоДнейПоМодели КАК КоличествоДнейПоМодели,
	               |	ЗапросПоМарке.Марка КАК МаркаЗапросаПоМарке,
	               |	ЗапросПоМарке.КоличествоДнейПоМарке КАК КоличествоДнейПоМарке,
	               |	Автомобили.VIN КАК АвтомобильVIN
	               |ИЗ
	               |	Справочник.Автомобили КАК Автомобили
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ПродолжительностьБесплатногоХраненияАвто.Модель КАК Модель,
	               |			ПродолжительностьБесплатногоХраненияАвто.КоличествоДней КАК КоличествоДнейПоМодели
	               |		ИЗ
	               |			РегистрСведений.ПродолжительностьБесплатногоХраненияАвто КАК ПродолжительностьБесплатногоХраненияАвто
	               |		ГДЕ
	               |			ПродолжительностьБесплатногоХраненияАвто.Марка <> ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)) КАК ЗапросПоМодели
	               |		ПО Автомобили.Модель = ЗапросПоМодели.Модель
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ПродолжительностьБесплатногоХраненияАвто.Марка КАК Марка,
	               |			ПродолжительностьБесплатногоХраненияАвто.КоличествоДней КАК КоличествоДнейПоМарке
	               |		ИЗ
	               |			РегистрСведений.ПродолжительностьБесплатногоХраненияАвто КАК ПродолжительностьБесплатногоХраненияАвто
	               |		ГДЕ
	               |			ПродолжительностьБесплатногоХраненияАвто.Модель = ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)) КАК ЗапросПоМарке
	               |		ПО Автомобили.Модель.Марка = ЗапросПоМарке.Марка
	               |ГДЕ
	               |	Автомобили.Ссылка В(&СпАвто)
	               |	И (ЗапросПоМарке.КоличествоДнейПоМарке > 0
	               |			ИЛИ ЗапросПоМодели.КоличествоДнейПоМодели > 0)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	АвтомобильVIN";
  	
  	Запрос.УстановитьПараметр("СпАвто", СпАвто);
 	
	ТЗ_ = Запрос.Выполнить().Выгрузить(); 
	
	//ТЗ_.ВыбратьСтроку(ТЗ_.Количество());
	
	Возврат ТЗ_;

