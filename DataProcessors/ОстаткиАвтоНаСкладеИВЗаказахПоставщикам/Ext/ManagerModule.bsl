Функция ПолучитьТаблицуПереходВСобственность(ТЗ)
	
	ТЗ_итог = Новый ТаблицаЗначений;
	
	СпАвтомобиль = ТЗ.ВыгрузитьКолонку("Автомобиль");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
	               |	ОстаткиАвтомобилейОстатки.СкладКомпании КАК СкладКомпании,
	               |	ОстаткиАвтомобилейОстатки.СтатусПартии КАК СтатусПартии,
	               |	ОстаткиАвтомобилейОстатки.Партия КАК Партия,
	               |	ОстаткиАвтомобилейОстатки.ГТД КАК ГТД,
	               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.КоличествоОстаток, 0) КАК Количество,
	               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаОстаток, 0) КАК Сумма,
	               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаУпрОстаток, 0) КАК СуммаУпр,
	               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаНДСОстаток, 0) КАК СуммаНДС
	               |ПОМЕСТИТЬ ПартияАвто
	               |ИЗ
	               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&Момент, Автомобиль В (&СпАвтомобиль)) КАК ОстаткиАвтомобилейОстатки
	               |
	               |ДЛЯ ИЗМЕНЕНИЯ
	               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Организация,
	               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.ХозОперация КАК ХозОперация,
	               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата,
	               |	ПоступлениеАвтомобилейАвтомобили.Автомобиль
	               |ИЗ
	               |	ПартияАвто КАК ПартияАвто
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	               |		ПО ПартияАвто.Партия.Ссылка = ПоступлениеАвтомобилейАвтомобили.Ссылка
	               |ГДЕ
	               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.ХозОперация = &ХозОперацияПереходВСобственностьАвтомобилей";
		
		Запрос.УстановитьПараметр("Момент",ТекущаяДата());
		Запрос.УстановитьПараметр("СпАвтомобиль",СпАвтомобиль);
		Запрос.УстановитьПараметр("ХозОперацияПереходВСобственностьАвтомобилей",Справочники.ХозОперации.ПереходВСобственностьАвтомобилей);
 		
		ТЗ_итог = Запрос.Выполнить().Выгрузить();      
		
		Возврат ТЗ_итог;

КонецФункции // ПолучитьТаблицуПереходВСобственность(ТЗ)
