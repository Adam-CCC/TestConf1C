											ДатаНачалаПлатногоХранения = Стр.Автомобиль.ДатаФинансирования + БесплПериодВДнях*86400;  
											Если НачалоДня(ДатаНачалаПлатногоХранения) > НачалоДня(ТекущаяДата()) Тогда
												Стр.ОбщаяСтоимостьХранения = 0;
												Если РольДоступна("СМ_Разработчик1С") Тогда
													СМГ_Сообщить("Обнулили стоимость хранения для "+Стр.Автомобиль+" т.к. ДатаНачалаПлатногоХранения "+ДатаНачалаПлатногоХранения);	
												КонецЕсли;
											Иначе
 												ДнейОплачиваемогоХранения= Цел( ( НачалоДня(ТекущаяДата()) - НачалоДня(Стр.ДатаФинансирования) ) / 86400 );
												Если ДнейОплачиваемогоХранения > 0 Тогда                           
													Если Стр.СрокХранения > 0 Тогда
														Если ДнейОплачиваемогоХранения < Стр.СрокХранения Тогда                           
															Если РольДоступна("СМ_Разработчик1С") Тогда
 																СМГ_Сообщить("Срок хранения уменьшается "+Стр.Автомобиль+" с "+Стр.СрокХранения+" до "+ ДнейОплачиваемогоХранения);		
															КонецЕсли;
															Стр.СрокХранения = ДнейОплачиваемогоХранения;
															Стр.ОбщаяСтоимостьХранения = Стр.СтоимостьСуточногоХранения * Стр.СрокХранения;
														КонецЕсли;
													КонецЕсли;	
 												КонецЕсли;
 											КонецЕсли;
 										КонецЕсли;
 								КонецЕсли;
 							КонецЕсли;
							//Бондаренко-- 20250412
 						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				//Бондаренко-- 20240118
			КонецЕсли;
		КонецЕсли;
		
		//Бондаренко++ 20240907
 		Если Стр.Марка = Справочники.Марка.CHANGAN Тогда
			Если Стр.ВидАвтомобиля = Перечисления.ВидАвтомобиля.Новый Тогда
				ИнвойсЧанган = 0;
				ИнвойсЧанган = ПолучитьИнвойсЧанган(Стр.Автомобиль);				
				Если ИнвойсЧанган > 0 Тогда
					Стр.Инвойс = ИнвойсЧанган;
 				КонецЕсли;
			КонецЕсли;
 		КонецЕсли;
 		//Бондаренко-- 20240907
		
		//Бондаренко++ 20230628
		//Стр.ОплаченПоставщику = Стр.Автомобиль.Оплачен;
		//Бондаренко-- 20230628
   		
	КонецЦикла; 
	
	Состав.Сортировать("СрокХранения Убыв");
	
	Возврат Состав;
	
КонецФункции 

