Функция ПолучитьТаблицуОпцийПроизводителя(ТЗ)
 
 	//СМГ_Сообщить("Начата: "+ТекущаяДата());
	
	СпАвтомобиль = ТЗ.ВыгрузитьКолонку("Автомобиль");
 	
	СоставОпций = Новый ТаблицаЗначений;
	СоставОпций.Колонки.Добавить("Автомобиль");
	СоставОпций.Колонки.Добавить("СтрокаОпций");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвтомобилиОпцииПроизводителя.Ссылка КАК Автомобиль,
		|	АвтомобилиОпцииПроизводителя.Опция.Наименование КАК СтрокаОпций
		|ИЗ
		|	Справочник.Автомобили.ОпцииПроизводителя КАК АвтомобилиОпцииПроизводителя
		|ГДЕ
		|	АвтомобилиОпцииПроизводителя.Ссылка В (&СпАвтомобиль)";
	
	Запрос.УстановитьПараметр("СпАвтомобиль",СпАвтомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПарОтбора = Новый Структура;
		ПарОтбора.Вставить("Автомобиль",ВыборкаДетальныеЗаписи.Автомобиль);
		НайдСтроки = СоставОпций.НайтиСтроки(ПарОтбора);
		Если НайдСтроки.Количество() = 0 Тогда
		    НовСтр = СоставОпций.Добавить();
			НовСтр.Автомобиль = ВыборкаДетальныеЗаписи.Автомобиль;
			НовСтр.СтрокаОпций = ВыборкаДетальныеЗаписи.СтрокаОпций;
 		Иначе
			НайдСтроки[0].Автомобиль = ВыборкаДетальныеЗаписи.Автомобиль;		
			НайдСтроки[0].СтрокаОпций = НайдСтроки[0].СтрокаОпций+";"+ВыборкаДетальныеЗаписи.СтрокаОпций;			
 		КонецЕсли;
	КонецЦикла;
	
	Возврат СоставОпций;

	//СМГ_Сообщить("Завершена: "+ТекущаяДата());
 
КонецФункции // ПолучитьТаблицуОпцийПроизводителя(ТЗ)
