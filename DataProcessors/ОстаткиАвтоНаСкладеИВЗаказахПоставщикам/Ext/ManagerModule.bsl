Функция ПолучитьТаблицуКорректировокПоступленияАвто(СпАвто)
	
	ТЗ = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;  

  	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиАвтомобилей.Автомобиль КАК Автомобиль,
		|	ОстаткиАвтомобилей.КоличествоОстаток,
		|	КорректировкиПоступления.СуммаРазница,
		|	КорректировкиПоступления.Ссылка,
		|	КорректировкиПоступления.Дата
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилей
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КорректировкаПоступленияАвтомобилейАвтомобили.Ссылка КАК Ссылка,
		|			КорректировкаПоступленияАвтомобилейАвтомобили.Ссылка.Дата КАК Дата,
		|			КорректировкаПоступленияАвтомобилейАвтомобили.Ссылка.Проведен КАК Проведен,
		|			КорректировкаПоступленияАвтомобилейАвтомобили.СуммаРазница КАК СуммаРазница,
		|			КорректировкаПоступленияАвтомобилейАвтомобили.Автомобиль КАК Автомобиль
		|		ИЗ
		|			Документ.КорректировкаПоступленияАвтомобилей.Автомобили КАК КорректировкаПоступленияАвтомобилейАвтомобили
		|		ГДЕ
		|			КорректировкаПоступленияАвтомобилейАвтомобили.Ссылка.Проведен) КАК КорректировкиПоступления
		|		ПО ОстаткиАвтомобилей.Автомобиль = КорректировкиПоступления.Автомобиль
		|ГДЕ
		|	ОстаткиАвтомобилей.КоличествоОстаток > 0
		|	И ОстаткиАвтомобилей.Автомобиль В(&СпАвто)
		|	И КорректировкиПоступления.СуммаРазница <> 0"; 
  	
	Запрос.УстановитьПараметр("СпАвто", СпАвто);    
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;                                               
	
