Функция ОпределитьДатуВыдачиПТС(Авто,ТЗ_ПТС)
	
	НайдДата = Неопределено;
	
	ПарОтбора = Новый Структура();
	ПарОтбора.Вставить("Автомобиль",Авто);                    
