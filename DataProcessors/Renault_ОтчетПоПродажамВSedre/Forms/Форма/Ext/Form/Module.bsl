&НаКлиенте
Перем мВыбраныСсылки; 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.ПрошлыйМесяц);
	СписокПродаж.Параметры.УстановитьЗначениеПараметра("НачалоПериода", Период.ДатаНачала);
	СписокПродаж.Параметры.УстановитьЗначениеПараметра("КонецПериода", Период.ДатаОкончания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Период) Тогда
		СписокПродаж.Параметры.УстановитьЗначениеПараметра("НачалоПериода", Период.ДатаНачала);
		СписокПродаж.Параметры.УстановитьЗначениеПараметра("КонецПериода", Период.ДатаОкончания);
	Иначе
		СписокПродаж.Параметры.УстановитьЗначениеПараметра("НачалоПериода", Дата(1,1,2));
		СписокПродаж.Параметры.УстановитьЗначениеПараметра("КонецПериода", Дата(3000,1,1));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПродажВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.СписокПродаж.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СписокПродажКорпКлиент" Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.КорпКлиент) Тогда
			//@++ Васильев ВА
			Форма = ПолучитьФорму("Справочник.Renault_КорпоративныеКлиенты.Форма.Renault_ФормаКорпоративногоКлиента");
			//@++
			Форма.Ключ = ТекущиеДанные.КорпКлиент.Контрагент;
			Форма.СферыДеятельности = ТекущиеДанные.КорпКлиент.СферыДеятельности.Выгрузить();
			Форма.Автопарк = ТекущиеДанные.КорпКлиент.Автопарк.Выгрузить();
			Форма.Открыть();
		Иначе
			РабочийЛист =  ПолучитьРабочийЛистПоVIN(ТекущиеДанные.VIN);
			КорпКлиент = ПолучитьКорпКлиентаИзРабочегоЛиста(РабочийЛист);
			Если ЗначениеЗаполнено(КорпКлиент) Тогда
				//@++ Васильев ВА
				Форма = ПолучитьФорму("Справочник.Renault_КорпоративныеКлиенты.Форма.Renault_ФормаКорпоративногоКлиента");
				//@++
				Форма.Ключ = КорпКлиент.Контрагент;
				Форма.СферыДеятельности = КорпКлиент.СферыДеятельности.Выгрузить();
				Форма.Автопарк = КорпКлиент.Автопарк.Выгрузить();
				Форма.Открыть();
			Иначе
				Предупреждение("Корпоративный клиент не найден. ");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Поле.Имя = "СписокПродажЗаявка" Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.Заявка) Тогда
			ОткрытьЗаявкуНаСкидку(ТекущиеДанные);	
		Иначе
			СоздатьЗаявкуНаСкидку(ТекущиеДанные);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "СписокПродажСтатус" Тогда
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные.Статус) Тогда
			СоздатьЗаявкуНаСкидку(ТекущиеДанные);
		ИначеЕсли ТекущиеДанные.Статус = ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКорпСкидок.Черновик") Тогда
			ОткрытьЗаявкуНаСкидку(ТекущиеДанные);
		Иначе
			ОткрытьФормуВИН(ТекущиеДанные)
		КонецЕсли;		
	ИначеЕсли Поле.Имя = "СписокПродажVIN" Тогда
		ИДК = ПолучитьРабочийЛистПоVIN(ТекущиеДанные.VIN);
		Если ЗначениеЗаполнено(ИДК) Тогда
			Renault_CRM.ОткрытьФормуРЛ(ИДК);
		Иначе
			Предупреждение("Рабочий лист по VIN не найден");			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаявкуНаСкидку(ТекущиеДанные)
	
	сПараметры = Новый Структура;
	сПараметры.Вставить("Ключ", ТекущиеДанные.Заявка);
	ОткрытьФорму("Документ.Renault_ЗаявкаНаКорпоративнуюСкидку.Форма.ФормаДокумента",сПараметры);	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаСкидку(ТекущиеДанные)
	
	ФормаНового = ПолучитьФорму("Документ.Renault_ЗаявкаНаКорпоративнуюСкидку.Форма.ФормаДокумента");
	ДанныеФормы = ФормаНового.Объект;	
	мВыбраныСсылки = ПолучитьВыделеныеСтроки();	
	СоздатьЗаявкуНаСервере(ДанныеФормы, мВыбраныСсылки);
	КопироватьДанныеФормы(ДанныеФормы, ФормаНового.Объект); 
	ФормаНового.Объект.ТипЗаявки = ПредопределенноеЗначение("Перечисление.Renault_ТипыЗаявокНаКорпоротивнуюСкидку.ВозмещениеСкидки");			
	РабочийЛист =  ПолучитьРабочийЛистПоVIN(ТекущиеДанные.VIN);
	КорпКлиент = ПолучитьКорпКлиентаИзРабочегоЛиста(РабочийЛист);
	Если ЗначениеЗаполнено(КорпКлиент) Тогда
		ФормаНового.Объект.Клиент = КорпКлиент;
	КонецЕсли;
	ФормаНового.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВИН(ТекущиеДанные)
	
	сПараметров = Новый Структура;
	сПараметров.Вставить("Заявка", ТекущиеДанные.Заявка);
	сПараметров.Вставить("Автомобиль", ТекущиеДанные.Автомобиль);
	сПараметров.Вставить("Статус", ТекущиеДанные.Статус);
	ОткрытьФорму("Обработка.Renault_АРМ_КорпоративныеСкидки.Форма.ФормаVIN",сПараметров,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте 
Функция  ПолучитьВыделеныеСтроки ()
	
	мВыбраныСсылки = Новый Массив;
	Для Каждого ВыделеннаяСтрока из Элементы.СписокПродаж.ВыделенныеСтроки Цикл
		мВыбраныСсылки.Добавить(Элементы.СписокПродаж.ДанныеСтроки(ВыделеннаяСтрока));
	КонецЦикла;

	Возврат мВыбраныСсылки;
	
КонецФункции

&НаСервере
Процедура СоздатьЗаявкуНаСервере (ДанныеФормы, мВыбраныСсылки)
	
	ТЗЗарезервированных = Новый ТаблицаЗначений;
	ТЗЗарезервированных.Колонки.Добавить("VIN",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(17)));
	ТЗЗарезервированных.Колонки.Добавить("Автомобиль",Новый ОписаниеТипов("СправочникСсылка.Автомобили"));
	
	Для Каждого СтрокаМассива из мВыбраныСсылки Цикл 
		Если Не ЗначениеЗаполнено(СтрокаМассива.Статус) Тогда 
			СтрокаТЗ = ТЗЗарезервированных.Добавить();
			СтрокаТЗ.VIN = СтрокаМассива.VIN;
			СтрокаТЗ.Автомобиль = СтрокаМассива.Автомобиль;
		КонецЕсли;
	КонецЦикла;
	
	ЗаявкаНаСкидку = Документы.Renault_ЗаявкаНаКорпоративнуюСкидку.СоздатьДокумент();
	ЗаявкаНаСкидку.Дата = ТекущаяДата();
	ЗаявкаНаСкидку.УстановитьНовыйНомер();
	ЗаявкаНаСкидку.Клиент = Клиент;
	ЗаявкаНаСкидку.ТипЗаявки = Перечисления.Renault_ТипыЗаявокНаКорпоротивнуюСкидку.ВозмещениеСкидки;
	ЗаявкаНаСкидку.ТипОтгрузки = Перечисления.Renault_ТипыОтгрузокНаКорпоративнуюСкидку.Отгрузка;
	ЗаявкаНаСкидку.Статус = Перечисления.Renault_СостоянияСогласованияКорпСкидок.Черновик;
	ЗаявкаНаСкидку.Автор = ПараметрыСеанса.Пользователь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.VIN,
	|	Таблица.Автомобиль
	|ПОМЕСТИТЬ ВТ_Автомобилей
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Автомобилей.VIN КАК ВИН,
	|	ВТ_Автомобилей.Автомобиль,
	|	ЕСТЬNULL(CRM_СостояниеАвтомобилейПроизводителя_v2.ЦенаПродажиБаза + CRM_СостояниеАвтомобилейПроизводителя_v2.ЦенаПродажиОпции, 0) КАК ЦенаPVC,
	|	ЕСТЬNULL(CRM_СостояниеАвтомобилейПроизводителя_v2.DEALER_PRICE_BASE + CRM_СостояниеАвтомобилейПроизводителя_v2.DEALER_PRICE_OPTION, 0) КАК ЦенаPVR
	|ИЗ
	|	ВТ_Автомобилей КАК ВТ_Автомобилей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|		ПО ВТ_Автомобилей.VIN = CRM_СостояниеАвтомобилейПроизводителя_v2.VIN";
	Запрос.УстановитьПараметр("Таблица", ТЗЗарезервированных);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество () > 0 Тогда
		ЗаявкаНаСкидку.ТаблицаВИН.Загрузить(Результат); 
	КонецЕсли;
	Приемник = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.Renault_ЗаявкаНаКорпоративнуюСкидку")); 
	ЗаполнитьЗначенияСвойств(Приемник, ЗаявкаНаСкидку); 
	Приемник.ТаблицаВИН.Загрузить(ЗаявкаНаСкидку.ТаблицаВИН.Выгрузить()); 
	ЗначениеВДанныеФормы(Приемник, ДанныеФормы);
	мВыбраныСсылки = Новый Массив;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПродажПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.СписокПродаж.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Клиент = ПредопределенноеЗначение("Справочник.Renault_КорпоративныеКлиенты.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	Клиент = ТекущиеДанные.КорпКлиент;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция  ПолучитьРабочийЛистПоVIN(VIN)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.РабочийЛист
		|ИЗ
		|	РегистрСведений.Renault_ЗаконтрактованныеАвтомобили.СрезПоследних(
		|			,
		|			VIN = &vin
		|				И ДатаСнятияРезерва = ДАТАВРЕМЯ(1, 1, 1)) КАК Renault_ЗаконтрактованныеАвтомобилиСрезПоследних";
	Запрос.УстановитьПараметр("VIN", VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РабочийЛист;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКорпКлиентаИзРабочегоЛиста(РабочийЛист)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_КорпоративныеКлиенты.Ссылка
		|ИЗ
		|	Справочник.Renault_КорпоративныеКлиенты КАК Renault_КорпоративныеКлиенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|			ПО Контрагенты.Ссылка = Renault_РабочиеЛисты.Клиент
		|		ПО Renault_КорпоративныеКлиенты.Контрагент = Контрагенты.Ссылка
		|ГДЕ
		|	Renault_РабочиеЛисты.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", РабочийЛист);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;	
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не Renault_РаботаСПравамиПользователя.ЕстьПравоОткрытияОтчетапродаж(ПараметрыСеанса.Пользователь,"Renault_ОтчетПоПродажамВSedre") тогда
		Сообщить("Недостаточно прав доступа.");
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
КонецПроцедуры
