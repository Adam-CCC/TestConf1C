
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Ответ = Неопределено;
		
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("БИР", Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.ПолучитьМассивБирДляПолученияДанных());
	
	Если DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"DMS_CommercialActions.ПолучитьСписокРасчетовДляБИР",DMS_DataExchange.newPackage(ПараметрыЗапроса),Ответ) Тогда
		
		Для Каждого Строка из Ответ Цикл
			НайденныеСтроки = ПериодыРасчета.НайтиСтроки(Новый Структура("ДатаРасчета", Строка.ADATE));
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = ПериодыРасчета.Добавить();
				НоваяСтрока.ДатаРасчета = Строка.ADATE;
				НоваяСтрока.Период = Формат(НоваяСтрока.ДатаРасчета, "ДФ=MM.yyyy");
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодыРасчетаПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ПоказатьСписокОтчетов", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСписокОтчетов() Экспорт
	
	Ответ = Неопределено;
	ТекущиеДанные = Элементы.ПериодыРасчета.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РассчитанныеОтчеты.Очистить();
	
	Ответ = Неопределено;
		
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("БИР", Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.ПолучитьМассивБирДляПолученияДанных());
	
	Если DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"DMS_CommercialActions.ПолучитьСписокРасчетовДляБИР",DMS_DataExchange.newPackage(ПараметрыЗапроса),Ответ) Тогда
		
		Для Каждого Строка из Ответ Цикл
			Если Строка.ADATE <> ТекущиеДанные.ДатаРасчета Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = РассчитанныеОтчеты.Добавить();
			НоваяСтрока.ИД = Строка.RECID;
			НоваяСтрока.BIR = Строка.BIR;
			НоваяСтрока.Название = Строка.ACTION_NAME;
			НоваяСтрока.REPORT_NO = Строка.REPORT_NO;
			НоваяСтрока.INN = Строка.INN;
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция РассчитанныеОтчетыВыборНаСервере(ИД)
	
	Ответ = Неопределено;
	ПараметрыЗапроса = Новый Структура();
	//ПараметрыЗапроса.Вставить("БИР", ПолучитьМассивБирДляПолученияДанных());
	ПараметрыЗапроса.Вставить("ID", ИД);
	Если DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"DMS_CommercialActions.ПолучитьОтчет",DMS_DataExchange.newPackage(ПараметрыЗапроса),Ответ) Тогда
		Возврат Ответ;	
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Процедура РассчитанныеОтчетыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Ответ = Неопределено;
	ТекущиеДанные = Элементы.РассчитанныеОтчеты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Массив = РассчитанныеОтчетыВыборНаСервере(ТекущиеДанные.ИД);
	Для Каждого ЭлементМассива Из Массив Цикл
		ИмяФайла = ПолучитьИмяВременногоФайла(ЭлементМассива.TYPE_DOC);
		ЭлементМассива.CONTENT_DOC.Записать(ИмяФайла);
		ЗапуститьПриложение(ИмяФайла,, Истина);
		УдалитьФайлы(ИмяФайла);
	КонецЦикла;
	
КонецПроцедуры
