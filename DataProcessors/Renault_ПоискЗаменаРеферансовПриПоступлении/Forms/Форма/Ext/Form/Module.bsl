&НаКлиенте
Перем СтрокаДоИзменения;
&НаКлиенте
Перем КолвоКзаменеПоЗаказу;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗакрыватьПриЗакрытииВладельца = Истина;
	
	Если ЗначениеЗаполнено(Параметры.Поступление) Тогда
		Объект.Поступление = Параметры.Поступление;
		Элементы.НадписьДокументПоступления.Заголовок = Объект.Поступление;
		ОбновитьТаблицуНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицу(Команда)
	Если Замены.ПолучитьЭлементы().Количество() > 0 И Вопрос("Таблица будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда Возврат; КонецЕсли;
	ОбновитьТаблицуНаСервере();
	
	РазвернутьДерево();
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Дерево = РеквизитФормыВЗначение("Замены");
	
	Ответ = ОбработкаОбъект.ОбновитьДанные(Дерево);
	ЗначениеВРеквизитФормы(Ответ.Дерево, "Замены");
	Если ЗначениеЗаполнено(Ответ.Информация) Тогда Сообщить(Ответ.Информация) КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Заменить(Команда)
	Ответ = ЗаменитьНаСервере();
	
	ОчиститьСообщения(); // различная информация при проведении документов
	Если ЗначениеЗаполнено(Ответ.Информация) Тогда Сообщить(Ответ.Информация) КонецЕсли;
	
	Если Ответ.ВсеОК Тогда
		Оповестить("ОбновитьДанныеДокумента"); 
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаменитьНаСервере()
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Ответ = ОбработкаОбъект.Заменить(РеквизитФормыВЗначение("Замены"));
	
	Возврат Ответ;
КонецФункции

&НаКлиенте
Процедура РазвернутьДерево()
	Для каждого СтрокаДерева Из Замены.ПолучитьЭлементы() Цикл Элементы.Замены.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Истина) КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НадписьДокументПоступленияНажатие(Элемент)
	
	Поступление = ОткрытьФормуМодально("Документ.ПоступлениеТоваров.ФормаВыбора");
	Если Поступление <> Неопределено Тогда
		Объект.Поступление = Поступление;
		Элементы.НадписьДокументПоступления.Заголовок = Объект.Поступление;
		ОбновитьТаблицу(Элементы.кнОбновить);
		РазвернутьДерево();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСнятьОтметки(Команда)
	ПризнакУстановить = (Команда.Имя = "ОтметитьВсе");
	УстановитьПризнакЗаменитьРекурсия(Замены.ПолучитьЭлементы(), ПризнакУстановить);
КонецПроцедуры

&НаКлиенте
Процедура ЗаменыЗаменитьПриИзменении(Элемент)
	СтрокаДерева = Элементы.Замены.ТекущиеДанные;
	УстановитьПризнакЗаменитьРекурсия(СтрокаДерева.ПолучитьЭлементы(), СтрокаДерева.Заменить);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакЗаменитьРекурсия(СтрокиДерева, ПризнакУстановить)

	Если СтрокиДерева.Количество() = 0 Тогда Возврат; КонецЕсли;	
	
	Для каждого СтрокаДерева Из СтрокиДерева Цикл
		СтрокаДерева.Заменить = ПризнакУстановить;
		УстановитьПризнакЗаменитьРекурсия(СтрокаДерева.ПолучитьЭлементы(), ПризнакУстановить);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ЗаменыЗаказ" Тогда 
		СтандартнаяОбработка = Ложь; 
		ОткрытьЗначение(Замены.НайтиПоИдентификатору(ВыбраннаяСтрока).ЗаказПоставщику)
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаменыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗаменыПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗаменыКоличествоЗаменитьПриИзменении(Элемент)
	ТекСтрока = Элементы.Замены.ТекущиеДанные;
	СтрокаРодитель = ТекСтрока.ПолучитьРодителя();
	
	// Получим колво распределенно на другие заказы
	общКолвоКЗамене = 0;
	Для каждого СтрокаДерева0 Из СтрокаРодитель.ПолучитьЭлементы() Цикл
		Если СтрокаДерева0 = ТекСтрока Тогда
			Продолжить;
		КонецЕсли;
		
		общКолвоКЗамене = общКолвоКЗамене + СтрокаДерева0.КоличествоЗаменить;
	КонецЦикла;
	
	КолвоНераспределено = СтрокаРодитель.Количество;
	КолвоПоЗаказу = ПолучитьКоличествоКЗамене(ТекСтрока.Номенклатура, ТекСтрока.ЗаказПоставщику);
	
	// Проверки
	Отказ = Ложь;
	Если общКолвоКЗамене + ТекСтрока.КоличествоЗаменить > КолвоНераспределено Тогда
		Сообщить("Количество к замене " + Формат(общКолвоКЗамене+ТекСтрока.КоличествоЗаменить, "ЧЦ=15; ЧДЦ=3") + " превышает количество (нераспределено) из поступления " + Формат(КолвоНераспределено, "ЧЦ=15; ЧДЦ=3"));
		Отказ = Истина;
	КонецЕсли;
	
	Если КолвоПоЗаказу > ТекСтрока.Количество Тогда
		Сообщить("Доступно к распределению по заказу: " + Формат(ТекСтрока.Количество, "ЧЦ=15; ЧДЦ=3") + " превышение на : " + Формат((КолвоПоЗаказу - ТекСтрока.Количество), "ЧЦ=15; ЧДЦ=3"));	
		Отказ = Истина;
	КонецЕсли;
	
	// Проверки не пройдены, устанавливаем кол-во в прежнее значение
	Если Отказ Тогда ТекСтрока.КоличествоЗаменить = СтрокаДоИзменения.КолвоКЗамене; Возврат; КонецЕсли;
	
	СтрокаРодитель.КоличествоЗаменить = 0;
	Для каждого СтрокаДерева Из СтрокаРодитель.ПолучитьЭлементы() Цикл
		СтрокаРодитель.КоличествоЗаменить = СтрокаРодитель.КоличествоЗаменить + СтрокаДерева.КоличествоЗаменить;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКоличествоКЗамене(Номенклатура, Заказ)
	КолвоКзаменеПоЗаказу = 0;
	ОбойтиДеревоРекурсия(Замены.ПолучитьЭлементы(), Номенклатура, Заказ, "КоличествоЗаменить");
	
	Возврат КолвоКзаменеПоЗаказу;
КонецФункции // ПолучитьКоличествоКЗамене()

&НаКлиенте
Процедура ОбойтиДеревоРекурсия(СтрокиДерева, Номенклатура, Заказ, ИмяРеквизита)

	Если СтрокиДерева.Количество() = 0 Тогда Возврат; КонецЕсли;	
	
	Для каждого СтрокаДерева Из СтрокиДерева Цикл
		Если ИмяРеквизита = "КоличествоЗаменить" 
			И СтрокаДерева.Номенклатура = Номенклатура И СтрокаДерева.ЗаказПоставщику = Заказ Тогда
		
			КолвоКзаменеПоЗаказу = КолвоКзаменеПоЗаказу + СтрокаДерева.КоличествоЗаменить;
		КонецЕсли;
		
		ОбойтиДеревоРекурсия(СтрокаДерева.ПолучитьЭлементы(), Номенклатура, Заказ, ИмяРеквизита);
	КонецЦикла;

КонецПроцедуры // ОбойтиДеревоРекурсия()

&НаКлиенте
Процедура ЗаменыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекСтрока = Элементы.Замены.ТекущиеДанные;
	
	СтрокаДоИзменения = Новый Структура;
	СтрокаДоИзменения.Вставить("КолвоКЗамене", ТекСтрока.КоличествоЗаменить);
КонецПроцедуры

&НаКлиенте
Процедура ЗаменыПриАктивизацииСтроки(Элемент)
	ТекСтрока = Элементы.Замены.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда Возврат; КонецЕсли;
	Элементы.ЗаменыКоличествоЗаменить.ТолькоПросмотр = ТекСтрока.ПолучитьРодителя() = Неопределено;
КонецПроцедуры




