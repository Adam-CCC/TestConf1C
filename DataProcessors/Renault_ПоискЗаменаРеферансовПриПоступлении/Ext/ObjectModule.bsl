Функция ЗаменитьНоменклатуруВЗаказеПоставщику(Выборка, КолвоЗаменить)
	
	// Пересчитываемы реквизиты при делении строк
	РеквизитыЗаказ = Новый Структура("Сумма, СуммаНДС, СуммаВсего");
	
	обЗаказПоставщику = ИзмДок.Найти(Выборка.ЗаказПоставщику, "ДокументСсылка").Документ;
	
	обЗаказПоставщику.Товары.Свернуть(ПолучитьКолонкиГруппировок(обЗаказПоставщику.Ссылка, "Товары", Новый Структура("Коэффициент,Цена"), Новый Структура("ПримечаниеНоменклатура")), 
									  ПолучитьКолонкиСуммирования(обЗаказПоставщику.Ссылка, "Товары",, Новый Структура("Коэффициент,Цена, Распределено")));
	
	// 1. Заменяем в ТЧ "РаспределениеЗаказа"
	
	обЗаказПоставщику.РаспределениеЗаказа.Свернуть(ПолучитьКолонкиГруппировок(обЗаказПоставщику.Ссылка, "РаспределениеЗаказа", Новый Структура("Коэффициент,Цена")), 
									  			   ПолучитьКолонкиСуммирования(обЗаказПоставщику.Ссылка, "РаспределениеЗаказа",, Новый Структура("Коэффициент,Цена")));
	
	Строки = обЗаказПоставщику.РаспределениеЗаказа.НайтиСтроки(Новый Структура("Номенклатура, ЗаказПокупателя", Выборка.Номенклатура, Выборка.ЗаказПокупателя));
	ОсталосьЗаменить = КолвоЗаменить;
	КолвоЗаменено = 0;
	Для каждого СтрокаТовары Из Строки Цикл 
		Если СтрокаТовары.Количество = 0 Тогда Продолжить; КонецЕсли;
		
		Если ОсталосьЗаменить = 0 Тогда Прервать; КонецЕсли;
		
		ВозможноЗаменить = СтрокаТовары.Количество;
		Если СтрокаТовары.Количество = ОсталосьЗаменить Тогда
			ИзменитьНоменклатуруВСтрокеЗаказаПоставщику(СтрокаТовары, Выборка, "РаспределениеЗаказа");
			КолвоЗаменено = КолвоЗаменено + ОсталосьЗаменить;
			ОсталосьЗаменить = 0;
		ИначеЕсли СтрокаТовары.Количество > ОсталосьЗаменить Тогда	
			// Нужно разбить строку	
			
			НоваяСтрока = обЗаказПоставщику.РаспределениеЗаказа.Добавить();
			НоваяСтрока.Количество = ОсталосьЗаменить;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары,, "Количество");
			
			ИзменитьНоменклатуруВСтрокеЗаказаПоставщику(НоваяСтрока, Выборка, "РаспределениеЗаказа");
			
			СтрокаТовары.Количество = СтрокаТовары.Количество - ОсталосьЗаменить;
			
			КолвоЗаменено = КолвоЗаменено + ОсталосьЗаменить;
			ОсталосьЗаменить = 0;
		ИначеЕсли СтрокаТовары.Количество > 0 И СтрокаТовары.Распределено < ОсталосьЗаменить Тогда	
			ИзменитьНоменклатуруВСтрокеЗаказаПоставщику(СтрокаТовары, Выборка, "РаспределениеЗаказа");
			КолвоЗаменено = КолвоЗаменено + ВозможноЗаменить;
			ОсталосьЗаменить = ОсталосьЗаменить - ВозможноЗаменить;
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	обЗаказПоставщику.РаспределениеЗаказа.Свернуть(ПолучитьКолонкиГруппировок(обЗаказПоставщику.Ссылка, "РаспределениеЗаказа", Новый Структура("Коэффициент,Цена"), Новый Структура("ПримечаниеНоменклатура")), 
									  			   ПолучитьКолонкиСуммирования(обЗаказПоставщику.Ссылка, "РаспределениеЗаказа",, Новый Структура("Коэффициент,Цена")));
	
	Массив = Новый Массив;
	Массив.Добавить(Выборка.Номенклатура);
	Массив.Добавить(Выборка.НоменклатураИсточник);
	ПерезаполнитьКолвоРаспределеноТЧТовары_ЗаказПоставщику(обЗаказПоставщику, Массив);
	
	// 2. Заменяем в ТЧ "Товары"		
	
	Строки = обЗаказПоставщику.Товары.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Номенклатура));
	ОсталосьЗаменить = КолвоЗаменено;
	ТоварВТЧ = обЗаказПоставщику.Товары.Найти(Выборка.Номенклатура, "Номенклатура") <> Неопределено;
	Для каждого СтрокаТовары Из Строки Цикл 
		Если ОсталосьЗаменить = 0 Тогда Прервать; КонецЕсли;
		
		ВозможноЗаменить = СтрокаТовары.Количество - СтрокаТовары.Распределено;
		Если ВозможноЗаменить = ОсталосьЗаменить Тогда           
			Если СтрокаТовары.Распределено > 0 Тогда ВывестиСтрокуРаспределено(обЗаказПоставщику, СтрокаТовары, РеквизитыЗаказ) КонецЕсли;
			ИзменитьНоменклатуруВСтрокеЗаказаПоставщику(СтрокаТовары, Выборка, "Товары");
			СтрокаТовары.Распределено = ?(ТоварВТЧ, 0, ОсталосьЗаменить);
			ОсталосьЗаменить = 0;
		ИначеЕсли ВозможноЗаменить > ОсталосьЗаменить Тогда	
			// Нужно разбить строку	
			
						
			НоваяСтрока = обЗаказПоставщику.Товары.Добавить();
			НоваяСтрока.Количество = ОсталосьЗаменить;
			НоваяСтрока.Распределено = ?(ТоварВТЧ, 0, ОсталосьЗаменить); // количество "распределено" уже заполнено на этапе 1

			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары,, "Количество, Распределено");
			
			ИзменитьНоменклатуруВСтрокеЗаказаПоставщику(НоваяСтрока, Выборка, "Товары");
			
			КоэфИзм = СтрокаТовары.Количество / (СтрокаТовары.Количество - ОсталосьЗаменить);
			ПересчитатьСуммыПоКоэффициенту(РеквизитыЗаказ, СтрокаТовары, НоваяСтрока, КоэфИзм);
			СтрокаТовары.Количество = СтрокаТовары.Количество - ОсталосьЗаменить;
			
			ОсталосьЗаменить = 0;
		ИначеЕсли ВозможноЗаменить > 0 И ВозможноЗаменить < ОсталосьЗаменить Тогда	
			Если СтрокаТовары.Распределено > 0 Тогда ВывестиСтрокуРаспределено(обЗаказПоставщику, СтрокаТовары, РеквизитыЗаказ) КонецЕсли;
			ИзменитьНоменклатуруВСтрокеЗаказаПоставщику(СтрокаТовары, Выборка, "Товары");
			СтрокаТовары.Распределено = ?(ТоварВТЧ, 0, СтрокаТовары.Количество);
			ОсталосьЗаменить = ОсталосьЗаменить - ВозможноЗаменить;
		Иначе
			Продолжить;	
		КонецЕсли;
	КонецЦикла;
	
	обЗаказПоставщику.Товары.Свернуть(ПолучитьКолонкиГруппировок(обЗаказПоставщику.Ссылка, "Товары", Новый Структура("Коэффициент,Цена")), 
									  ПолучитьКолонкиСуммирования(обЗаказПоставщику.Ссылка, "Товары",, Новый Структура("Коэффициент,Цена")));
	
	ПерезаполнитьКолвоРаспределеноТЧТовары_ЗаказПоставщику(обЗаказПоставщику);
									  
	Строка = ИзмДок.Найти(Выборка.ЗаказПоставщику, "ДокументСсылка");
	Строка.Документ = обЗаказПоставщику;
	
КонецФункции

Процедура ПерезаполнитьКолвоРаспределеноТЧТовары_ЗаказПоставщику(обЗаказПоставщику, СписокНоменклатуры = Неопределено)

	Если СписокНоменклатуры = Неопределено Тогда СписокНоменклатуры = обЗаказПоставщику.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"); КонецЕсли;
	
	Для каждого Номенклатура Из СписокНоменклатуры Цикл
		
		// 1. Получим общее количество распределенное по номенклатуре
		// Перед тем как вносим колво распределено - свернули ТЧ товары по номенклатуре
		КолвоРаспределено = 0;
		Строки = обЗаказПоставщику.РаспределениеЗаказа.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
		Для каждого СтрокаТЧ Из Строки Цикл КолвоРаспределено = КолвоРаспределено + СтрокаТЧ.Количество КонецЦикла;
		
		Строки = обЗаказПоставщику.Товары.НайтиСтроки(Новый Структура("Номенклатура", Номенклатура));
		Для каждого СтрокаТЧ Из Строки Цикл СтрокаТЧ.Распределено = КолвоРаспределено КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ИзменитьНоменклатуруВСтрокеЗаказаПокупателя(СтрокаТовары, СтрокаДанных, СкладКомпании)
	СтрокаТовары.Номенклатура     = СтрокаДанных.НоменклатураИсточник;
	СтрокаТовары.ЕдиницаИзмерения = СтрокаДанных.ЕдиницаИзмерения;
	СтрокаТовары.Коэффициент      =	СтрокаДанных.ЕдиницаИзмерения.Коэффициент;
	СтрокаТовары.Производитель 	  =	СтрокаДанных.НоменклатураИсточник.Производитель;
	СтрокаТовары.Ячейка           = СтрокаДанных.НоменклатураИсточник.ПолучитьОбъект().ПолучитьЯчейкуХранения(СкладКомпании);
	СтрокаТовары.ХарактеристикаНоменклатуры     = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
КонецПроцедуры

Процедура ИзменитьНоменклатуруВСтрокеЗаказНаряде(СтрокаТовары, СтрокаДанных)

	СтрокаТовары.Номенклатура     = СтрокаДанных.НоменклатураИсточник;
	СтрокаТовары.ЕдиницаИзмерения = СтрокаДанных.ЕдиницаИзмерения;
	СтрокаТовары.Коэффициент      =	СтрокаДанных.ЕдиницаИзмерения.Коэффициент;
	СтрокаТовары.ХарактеристикаНоменклатуры     = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

КонецПроцедуры

Процедура ИзменитьНоменклатуруВСтрокеЗаказаПоставщику(СтрокаТовары, СтрокаДанных, ИмяТЧ)
	СтрокаТовары.Номенклатура     = СтрокаДанных.НоменклатураИсточник;
	СтрокаТовары.ЕдиницаИзмерения = СтрокаДанных.ЕдиницаИзмерения;
	СтрокаТовары.Коэффициент      =	СтрокаДанных.ЕдиницаИзмерения.Коэффициент;
	СтрокаТовары.ХарактеристикаНоменклатуры     = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
КонецПроцедуры

// Выводит количество (распределено) в отдельную строку
Функция ВывестиСтрокуРаспределено(обЗаказПоставщика, СтрокаИсходная, РеквизитыЗаказ)

	// Выносим количество распределено в отдельную строку
	СтрокаРаспределено = обЗаказПоставщика.Товары.Добавить();
	СтрокаРаспределено.Количество = СтрокаИсходная.Распределено;
	ЗаполнитьЗначенияСвойств(СтрокаРаспределено, СтрокаИсходная,, "Количество");
	
	КоэфИзм = СтрокаИсходная.Количество / (СтрокаИсходная.Количество - СтрокаИсходная.Распределено);
	ПересчитатьСуммыПоКоэффициенту(РеквизитыЗаказ, СтрокаИсходная, СтрокаРаспределено, КоэфИзм);
	СтрокаИсходная.Количество = СтрокаИсходная.Количество - СтрокаИсходная.Распределено;
	СтрокаИсходная.Распределено = 0;

	Возврат СтрокаРаспределено;
	
КонецФункции

// Выводит количество (резерв) в отдельную строку
Процедура ВывестиСтрокуСРезервом(обЗаказПокупателя, СтрокаИсходная, РеквизитыЗаказ)

	// Выносим количество с резервом в отдельную строку
	СтрокаРезерв = обЗаказПокупателя.Товары.Добавить();
	СтрокаРезерв.Количество = СтрокаРезерв.Резерв;
	ЗаполнитьЗначенияСвойств(СтрокаРезерв, СтрокаИсходная,, "Количество");
	
	КоэфИзм = СтрокаИсходная.Количество / (СтрокаИсходная.Количество - СтрокаИсходная.Резерв);
	ПересчитатьСуммыПоКоэффициенту(РеквизитыЗаказ, СтрокаИсходная, СтрокаРезерв, КоэфИзм);
	СтрокаИсходная.Количество = СтрокаИсходная.Количество - СтрокаИсходная.Резерв;
	СтрокаИсходная.Резерв = 0;
	СтрокаИсходная.ИдентификаторСтроки = Новый УникальныйИдентификатор;

КонецПроцедуры

Процедура ПересчитатьСуммыПоКоэффициенту(СтруктураРеквизитов, ИсходнаяСтрока, НоваяСтрока, Коэффициент)

	// Пересчитываем суммы
	Для каждого КлючЗначение Из СтруктураРеквизитов Цикл
		ИмяРеквизита = КлючЗначение.Ключ;
		ИсходнаяСтрока[ИмяРеквизита] = ИсходнаяСтрока[ИмяРеквизита] / Коэффициент;
		НоваяСтрока[ИмяРеквизита] = НоваяСтрока[ИмяРеквизита] - ИсходнаяСтрока[ИмяРеквизита];
	КонецЦикла;
	
КонецПроцедуры

Функция ДеревоВТЗ(ДЗ)

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("НоменклатураИсточник", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Для каждого Колонка Из ДЗ.Колонки Цикл
		ТЗ.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;

	ДеревоВТЗ_Рекурсия(ДЗ.Строки, ТЗ);

	Возврат ТЗ;
	
КонецФункции

Процедура ДеревоВТЗ_Рекурсия(СтрокиДЗ, ТЗ)

	Если СтрокиДЗ.Количество() = 0 Тогда Возврат; КонецЕсли;

	Для каждого СтрокаДЗ Из СтрокиДЗ Цикл
		Если СтрокаДЗ.Строки.Количество() = 0 Тогда 
			НС_ТЗ = ТЗ.Добавить();
			НС_ТЗ.НоменклатураИсточник = СтрокаДЗ.Родитель.Номенклатура;
			НС_ТЗ.ЕдиницаИзмерения = СтрокаДЗ.Родитель.ЕдиницаИзмерения;
			ЗаполнитьЗначенияСвойств(НС_ТЗ, СтрокаДЗ,, "ЕдиницаИзмерения"); 
		КонецЕсли;	
		
	    ДеревоВТЗ_Рекурсия(СтрокаДЗ.Строки, ТЗ);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКолонкиГруппировок(Ссылка, ИмяТЧ, ИслючениеДобавить = Неопределено, ИключениеИсключить = Неопределено)

	// Выбираем все реквизиты ТЧ, кроме числовых
	
	Если ИслючениеДобавить = Неопределено Тогда ИслючениеДобавить = Новый Структура; КонецЕсли;
	Если ИключениеИсключить = Неопределено Тогда ИключениеИсключить = Новый Структура; КонецЕсли;
	
	КолонкиГруппировок = "";
	Для каждого Реквизит Из Ссылка.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты Цикл

		Если ИключениеИсключить.Свойство(Реквизит.Имя) Тогда Продолжить; КонецЕсли; // игнорируем в любом случае
		Если ИслючениеДобавить.Свойство(Реквизит.Имя) Тогда ЭтоИсключение = Истина; Иначе ЭтоИсключение = Ложь; КонецЕсли; // добавляем в любом случае
		Если Не ЭтоИсключение И Реквизит.Тип.СодержитТип(Тип("Число")) И Реквизит.Тип.Типы().Количество() = 1 Тогда Продолжить; КонецЕсли;
		
		КолонкиГруппировок = ?(ПустаяСтрока(КолонкиГруппировок), Реквизит.Имя, КолонкиГруппировок + ", " + Реквизит.Имя);
	КонецЦикла;

	Возврат КолонкиГруппировок;
	
КонецФункции // ПолучитьКолонкиГруппировок()

Функция ПолучитьКолонкиСуммирования(Ссылка, ИмяТЧ, ИслючениеДобавить = Неопределено, ИключениеИсключить = Неопределено)

	// Выбираем все числовые реквизиты ТЧ
	
	Если ИслючениеДобавить = Неопределено Тогда ИслючениеДобавить = Новый Структура; КонецЕсли;
	Если ИключениеИсключить = Неопределено Тогда ИключениеИсключить = Новый Структура; КонецЕсли;
	
	КолонкиГруппировок = "";
	Для каждого Реквизит Из Ссылка.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты Цикл
		
		Если ИключениеИсключить.Свойство(Реквизит.Имя) Тогда Продолжить; КонецЕсли; // игнорируем в любом случае
		Если ИслючениеДобавить.Свойство(Реквизит.Имя) Тогда ЭтоИсключение = Истина; Иначе ЭтоИсключение = Ложь; КонецЕсли; // добавляем в любом случае
		Если Не ЭтоИсключение И Реквизит.Тип.Типы().Количество() > 1 Тогда Продолжить; КонецЕсли; // не выбираем составные типы
		Если Не ЭтоИсключение И Не Реквизит.Тип.СодержитТип(Тип("Число")) Тогда Продолжить; КонецЕсли;
		
		КолонкиГруппировок = ?(ПустаяСтрока(КолонкиГруппировок), Реквизит.Имя, КолонкиГруппировок + ", " + Реквизит.Имя);
	КонецЦикла;

	Возврат КолонкиГруппировок;

КонецФункции // ПолучитьКолонкиСуммирования()

