#Если Клиент Тогда

////////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ ОБЪЕКТА

Перем Права						Экспорт;	// Переменная объекта - ссылка на коллекцию прав, настроек и переменных окружения
Перем Рарус_Компонента			Экспорт;	// Локальная ссылка на внешнюю компоненту типового решения
Перем ИмяДрайвераPDFПринтера	Экспорт;	// Имя драйвера PDF принтера
Перем ИмяPDFПринтера			Экспорт;	// Имя принтера PDF печати
Перем ТаймаутОжиданияПечати		Экспорт;	// Устанавливает значение временного интервала (в миллисекундах), в течение которого будет ожидаться окончание процесса формирования PDF файла. Если за время ТаймаутОжиданияПечати файл не появиться, то вызов завершится ошибкой.


////////////////////////////////////////////////////////////////////////////////
// ПАРАМЕТРЫ ДРАЙВЕРА PDF-ПРИНТЕРА

// Основные
Перем ПропуститьСохранитьКак;				// BypassSaveAs			// 0 = отображать диалог "Сохранить как ..." после спулинга, 1 = не отображать диалог.
Перем ИмяPDFФайла;							// OutputFile			// Имя выходного PDF-файла. Также можно использовать форматную конструкцию вида "%{n}d", для того чтобы задавать автоматически каждому "выходящему" PDF-файлу собственное уникальное имя. К примеру: abc%d.pdf -> abc1.pdf, abc2.pdf ...;	abc%03d.pdf -> abc001.pdf, abc002.pdf ...
Перем НомерПервогоФайла			Экспорт;	// StartAt(REG_DWORD)	// Номер, с которого начинается нумерация файлов в случае использования предложения "%{n}d"

// Ключи для работы с защитой PDF
Перем УстановитьЗащиту			Экспорт;	// AddSecurity			// 1 = создать закодированный PDF файл, 0 = не добавлять функции защиты в PDF файл.
Перем УровеньЗащиты				Экспорт;	// Level				// 1 = 128-bit кодирование, 0 = 40-bit кодирование.
Перем ПарольПользователя		Экспорт;	// userPassword			// Пароль используется для открытия документа.
Перем ГлавныйПароль				Экспорт;	// masterPassword		// Пароль на изменение прав и паролей пользователя (Use the key above to set Password required to change permissions and passwords).

// Права
Перем ЗапретПечати				Экспорт;	// noPrinting			// 1 = запрещает пользователю печатать документ.
Перем ЗапретРедактирования		Экспорт;	// noModifyContents		// 1 = запрещает пользователю создавать поля форм, точно также, как запрещает вносить любые другие изменения.
Перем ЗапретИзменятьКомментарий	Экспорт;	// noModifyAnnotations	// 1 = запрещает пользователю добавлять или изменять комментарии или поля форм.
Перем ЗапретКопированияТекста	Экспорт;	// noCopy				// 1 = запрещает пользователю копировать текст и рисунки.

// Фоновая картинка (водяные знаки)
// В качестве фона можно использовать любые PDF файлы с одной или двумя страницами
// and then print other content on top of it to create an overlaid PDF document.
// Если используется файл фона с двумя страницами, то вторая будет печататься для всех листов кроме первого.
Перем ДобавитьФон				Экспорт;	// AddBackground		// 1 = добавить фон, 0 = не добавлять фон.
Перем ИмяФайлаФона				Экспорт;	// BackgroundFile		// Файл фона. Необходимо указать полное имя файла.
Перем ФонТолькоНаПервойСтранице	Экспорт;	// FirstPageOnly		// 1 = напечатать фон только на первой странице документа. 0 = на каждой.

// Следующий ключ используется для "склеивания" потока в уже существующий PDF файл
// Драйвер при каждом вызове уменьшает значение данного счетчика пока оно не станет равным 0.
// Можно установить ключ CombinePDFs в значение числа PDF файлов которые необходимо объединить.
Перем ДописатьВСуществующийФайл	Экспорт;	// CombinePDFs(REG_DWORD)// 0 = Существующий файл перезаписывается, 1 (>1) = дописывает поток в конец уже существующего файла.

// Следующие ключи реестра позволяют программно установить свойства создаваемого PDF документа
Перем Автор						Экспорт;	// Author				//
Перем Заголовок					Экспорт;	// Title				//
Перем Тема						Экспорт;	// Subject				//
Перем КлючевыеСлова				Экспорт;	// Keywords				//
Перем Создатель					Экспорт;	// Creator				//
Перем Изготовитель				Экспорт;	// Producer				//


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ МЕТОДОВ ОБЪЕКТА

// Функция перебирает все локальные принтеры и возвращает номер (индекс) PDF принтера
Функция ПолучитьИндексPDFПринтера()
	Если Рарус_Компонента=Неопределено Тогда
		Возврат -1;
	КонецЕсли; 
	
	Состояние("Поиск PDF-принтера ...");
	
	ИндексPDFПринтера = -1;
	Для Индекс = 0 По Рарус_Компонента.ПолучитьКоличествоПринтеров()-1 Цикл
		Имя		= Рарус_Компонента.ПолучитьИмяПринтера(Индекс);
		Драйвер	= Рарус_Компонента.ПолучитьДрайверПринтера(Индекс);
		
		Если Рарус_Компонента.ПолучитьДрайверПринтера(Индекс) = ИмяДрайвераPDFПринтера Тогда
			ИндексPDFПринтера = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИндексPDFПринтера;
КонецФункции

// Функция подготавливает и устанавливает параметры для PDF драйвера
Функция УстановитьПараметрыПечати(Индекс)
	Состояние("Установка параметров PDF-принтера ...");
	
	// Создаем список параметров принтера
	СписокПараметровПечати = Новый Структура();
	СписокПараметровПечати.Вставить("BypassSaveAs",			ПропуститьСохранитьКак);
	СписокПараметровПечати.Вставить("OutputFile",			ИмяPDFФайла);
	СписокПараметровПечати.Вставить("StartAt",				НомерПервогоФайла);
	СписокПараметровПечати.Вставить("AddSecurity",			УстановитьЗащиту);
	СписокПараметровПечати.Вставить("Level",				УровеньЗащиты);
	СписокПараметровПечати.Вставить("userPassword",			ПарольПользователя);
	СписокПараметровПечати.Вставить("masterPassword",		ГлавныйПароль);
	СписокПараметровПечати.Вставить("noPrinting",			ЗапретПечати);
	СписокПараметровПечати.Вставить("noModifyContents",		ЗапретРедактирования);
	СписокПараметровПечати.Вставить("noModifyAnnotations",	ЗапретИзменятьКомментарий);
	СписокПараметровПечати.Вставить("noCopy",				ЗапретКопированияТекста);
	СписокПараметровПечати.Вставить("AddBackground",		ДобавитьФон);
	СписокПараметровПечати.Вставить("BackgroundFile",		ИмяФайлаФона);
	СписокПараметровПечати.Вставить("FirstPageOnly",		ФонТолькоНаПервойСтранице);
	СписокПараметровПечати.Вставить("Author",				Автор);
	СписокПараметровПечати.Вставить("Title",				Заголовок);
	СписокПараметровПечати.Вставить("Subject",				Тема);
	СписокПараметровПечати.Вставить("Keywords",				КлючевыеСлова);
	СписокПараметровПечати.Вставить("Creator",				Создатель);
	СписокПараметровПечати.Вставить("Producer",				Изготовитель);
	
	// Приступим к составлению строки параметров
	Параметры = "";
	Для Каждого ТекПараметр Из СписокПараметровПечати Цикл
		Если ТекПараметр.Значение <> Неопределено Тогда
			Параметры = Параметры + ";" + ТекПараметр.Ключ + "=" + СокрЛП(Строка(ТекПараметр.Значение));
		КонецЕсли;
	КонецЦикла;
	Параметры = Сред(Параметры, 2);
	
	// Произведем установку параметров в реестр
	Попытка
		Рарус_Компонента.УстановитьПараметрыПечати(Индекс, Параметры);
		Возврат ИСТИНА;
	Исключение
		Возврат ЛОЖЬ;
	КонецПопытки;
КонецФункции

// Функция печатает табличный документ на указанном принтере
Функция Печать(ТабДокумент, ИндексPDFПринтера)
	Состояние("Идет печать на PDF-принтере ...");
	Результат = ИСТИНА;
	
	Попытка
		// Создадим новый табличный документ и полностью скопируем в него содержимое из исходного
		// (а также все необходимые настройки)
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ЗаполнитьЗначенияСвойств(ТабличныйДокумент, ТабДокумент, "КодЯзыкаМакета,ОбластьПечати,КоличествоЭкземпляров,ОриентацияСтраницы,АвтоМасштаб,ПолеСверху,ПолеСлева,ПолеСнизу,ПолеСправа,РазмерКолонтитулаСверху,РазмерКолонтитулаСнизу,ФиксированныйФон,ФоноваяКартинка,ЧерноБелыйПросмотр,ПовторятьПриПечатиКолонки,ПовторятьПриПечатиСтроки");
		ТабличныйДокумент.МасштабПечати			= ?(ТабДокумент.МасштабПечати			= Неопределено,  100, ТабДокумент.МасштабПечати);
		ТабличныйДокумент.РазборПоКопиям		= ?(ТабДокумент.РазборПоКопиям			= Неопределено, ЛОЖЬ, ТабДокумент.РазборПоКопиям);
		ТабличныйДокумент.ЧерноБелаяПечать		= ?(ТабДокумент.ЧерноБелаяПечать		= Неопределено, ЛОЖЬ, ТабДокумент.ЧерноБелаяПечать);
		ТабличныйДокумент.ЭкземпляровНаСтранице	= ?(ТабДокумент.ЭкземпляровНаСтранице	= Неопределено,    0, ТабДокумент.ЭкземпляровНаСтранице);
		ТабличныйДокумент.Вывести(ТабДокумент);
		
		// Печатаем
		ТабличныйДокумент.ИмяПринтера = Рарус_Компонента.ПолучитьИмяПринтера(ИндексPDFПринтера);
		ТабличныйДокумент.Напечатать(ИСТИНА);
		
		// Нужно дождаться окончания формирования PDF файла
		PDFФайл = Новый Файл(ИмяPDFФайла);
		ДатаОкончания = ТекущаяДата() + ТаймаутОжиданияПечати;
		Пока НЕ (PDFФайл.Существует()ИЛИ(ТекущаяДата() >= ДатаОкончания)) Цикл
			// Ждем пока файл не станет доступным
		КонецЦикла;
		Результат = PDFФайл.Существует();
	Исключение
		Результат = ЛОЖЬ;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции // Печать()


////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДОПОЛНИТЕЛЬНЫХ МЕТОДОВ ОБЪЕКТА

// Функция проверяет корректность переданного имени файла. Если каталог файла не существует, то функция
// создает его, если указанный файл уже существует, то функция удаляет его.
Функция ПроверитьПутьКФайлу(ИмяФайла) Экспорт
	Файл = Новый Файл(ИмяФайла);
	Если Файл.Существует() Тогда
		// Если файл существует, то его необходимо удалить перед началом работы PDF принтера
		Попытка
			Файл.УстановитьТолькоЧтение(ЛОЖЬ);
			УдалитьФайлы(Файл.ПолноеИмя);
		Исключение
			Возврат ЛОЖЬ;
		КонецПопытки;
	Иначе
		// Если файл не существует, то необходимо чтобы существовал каталог печати
		Каталог	= Новый Файл(Файл.Путь);
		Если НЕ Каталог.Существует() Тогда
			Попытка
				СоздатьКаталог(Каталог.ПолноеИмя);
			Исключение
				Возврат ЛОЖЬ;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// Если добрались до этой точке, то значит все в порядке
	Возврат ИСТИНА;
КонецФункции

// Открывает мастера установки драйвера PDF принтера
Процедура УстановитьДрайверPDFПринтера() Экспорт
	ФормаМастера = ПолучитьФорму("Форма");
	
	// Откроем форму мастера установки драйвера PDF принтера
	Если ФормаМастера.Открыта() Тогда
		ФормаМастера.Активизировать();
	Иначе
		ФормаМастера.Открыть();
	КонецЕсли;
КонецПроцедуры

// Функция преобразует табличный документ в PDF-документ
Функция СохранитьКакPDF(ТабДокумент, ИмяФайла) Экспорт
	// Проверим, существует ли переданный нам файл
	Если НЕ ПроверитьПутьКФайлу(ИмяФайла) Тогда
		ТекстПредупреждения = "Недостаточно прав для сохранения в указанную директорию."+Символы.ПС+"Обратитесь к администратору сети.";
		Предупреждение(ТекстПредупреждения, обПраво("ТаймаутДиалогов", Права), "Отказ в доступе");
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	// Установим некоторые параметры печати
	ПропуститьСохранитьКак	= 1;
	ИмяPDFФайла				= ИмяФайла;
	
	// Найдем подходящий для нас PDF принтер
	ИндексPDFПринтера = ПолучитьИндексPDFПринтера();
	
	// Если принтер не найден или параметры не были установлены, то необходимо проинформировать
	// пользователя об этом и помочь ему с установкой
	Если (ИндексPDFПринтера < 0)ИЛИ(НЕ УстановитьПараметрыПечати(ИндексPDFПринтера)) Тогда
		ТекстВопроса = "На данном компьютере не обнаружен PDF-принтер! Формирование PDF-документа без PDF-принтера невозможно."+Символы.ПС+"Хотите установить драйвер PDF-принтера сейчас?";
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, обПраво("ТаймаутДиалогов", Права), КодВозвратаДиалога.Нет, "ВНИМАНИЕ") = КодВозвратаДиалога.Да Тогда
			УстановитьДрайверPDFПринтера();
		КонецЕсли;
		
		// В любом случае продолжение печати не возможно, т.к. необходимо перезапустить 1С
		Возврат ЛОЖЬ;
	КонецЕсли;
	
	// Непосредственно печать
	Результат = Печать(ТабДокумент, ИндексPDFПринтера);
	
	// Убираем за собой. Удалим все параметры установленные нами в процессе формирования PDF-документа
	Если Рарус_Компонента<>Неопределено Тогда
		Рарус_Компонента.ОчиститьПараметрыПечати();
	КонецЕсли; 
	
	// Если мы дошли до этой точки, значит все хорошо
	Возврат Результат;
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ИСПОЛНЯЕМАЯ ЧАСТЬ МОДУЛЯ

ИмяДрайвераPDFПринтера		= "CUSTPDF Writer";
ИмяPDFПринтера				= "1C PDF-Export";
ТаймаутОжиданияПечати		= 60;

// сохранение ссылки на коллекцию прав, настроек и окружения
Права = глПрава;
Рарус_Компонента = глРарус_Компонента;

////////////////////////////////////////////////////////////////////////////////
// ИНИЦИАЛИЗАЦИЯ ПАРАМЕТРОВ ДРАЙВЕРА PDF ПРИНТЕРА
ПропуститьСохранитьКак		= 1;
ИмяPDFФайла					= КаталогВременныхФайлов() + "~tempOutputFile%03d.pdf";
НомерПервогоФайла			= 0;

УстановитьЗащиту			= 1;
УровеньЗащиты				= 1;
ЗапретПечати				= 0;
ЗапретРедактирования		= 1;
ЗапретИзменятьКомментарий	= 1;
ЗапретКопированияТекста		= 1;

#КонецЕсли