Процедура ПроверкаЗначенийСтроки(НоваяСтрока,RegExp) Экспорт
	
	Если ПустаяСтрока(НоваяСтрока.ФИОКлиента) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ФИОКлиента";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НоваяСтрока.ТипКлиента) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ТипКлиента";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НоваяСтрока.VIN) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле VIN";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.Бригада) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Бригада";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.ДатаЗакрытия) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ДатаЗакрытия";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.КодРаботы) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле КодРаботы";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.Модель) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Модель";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.НомерЗаказНаряда) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле НомерЗаказНаряда";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.Согласие) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Согласие";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НоваяСтрока.Телефон) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Телефон";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
		
	Если ПустаяСтрока(НоваяСтрока.ТипРаботы) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ТипРаботы";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;

	Если НоваяСтрока.ТипКлиента = "физическое лицо" Тогда	
		ФИОДляПроверки = СтрЗаменить(НоваяСтрока.ФИОКлиента, " ","");
		Длина = СтрДлина(ФИОДляПроверки);
		Сч = 1;	
		Пока Сч<=Длина Цикл	
			КодСимволаСтроки =КодСимвола(ФИОДляПроверки,Сч);
			Если КодСимволаСтроки<1040 
				И КодСимволаСтроки<>45 //- 
				И КодСимволаСтроки<>1025 //Ё
				ИЛИ КодСимволаСтроки>1103 
				И КодСимволаСтроки<>1105 Тогда //ё
				НоваяСтрока.ОписаниеОшибки = "Поле ФИО заполнено некорректно";
				НоваяСтрока.ОшибкаСтроки = Истина;
				Возврат;
			КонецЕсли;	
			Сч = Сч+1;
		КонецЦикла;
	КонецЕсли;


	//проверяем длину VIN
	Если СтрДлина(НоваяСтрока.VIN)<17 Тогда
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;
		
		Если Найти(НоваяСтрока.VIN, "O")<>0 Тогда
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;
		
		Если Найти(НоваяСтрока.VIN, "i")<>0 Тогда
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;

		RegExp.Pattern = "\b([0-9A-Za-z]){17}\b"; //шаблон проверки 17 лат. букв и цифр
		Если НЕ RegExp.Test(НоваяСтрока.VIN) Тогда  
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;

		RegExp.Pattern = "\b\d{11}\b"; //шаблон проверки 11 знч только цифры
		Если НЕ RegExp.Test(НоваяСтрока.Телефон) Тогда 
			НоваяСтрока.ОписаниеОшибки = "Поле Телефон заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;		
		
		Если ЗначениеЗаполнено(НоваяСтрока.Email) Тогда
			RegExp.Pattern = ".+@.+\..+"; //шаблон проверки лат. буквы, цифры, наличие @ и .
			Если НЕ RegExp.Test(НоваяСтрока.Email) Тогда  
				НоваяСтрока.ОписаниеОшибки = "Поле Email заполнено некорректно";
				НоваяСтрока.ОшибкаСтроки = Истина;
				Возврат;
			КонецЕсли;				
		КонецЕсли;
		
		НоваяСтрока.ОшибкаСтроки = Ложь;
		НоваяСтрока.ОписаниеОшибки = "";
		
КонецПроцедуры

Процедура ПроверкаЗначенийСтрокиПродажи(НоваяСтрока,RegExp,ТипКлиентаПоРегиструСостоянияАвто="",ТипКлиентаПоРеализации="") Экспорт
	
	Если ПустаяСтрока(НоваяСтрока.ФИОКлиента) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ФИОКлиента";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НоваяСтрока.ТипКлиента) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ТипКлиента";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;

	Если (НоваяСтрока.ТипКлиента = "малый корпоративный клиент" ИЛИ НоваяСтрока.ТипКлиента = "крупный корпоративный клиент") Тогда
		Если СтрДлина(НоваяСтрока.ИНН) = 10 Тогда
			RegExp.Pattern = "\b\d{10}\b"; //шаблон проверки 10 знч только цифры
		ИначеЕсли СтрДлина(НоваяСтрока.ИНН) = 12 Тогда			
			RegExp.Pattern = "\b\d{12}\b"; //шаблон проверки 12 знч только цифры
		Иначе		
			НоваяСтрока.ОписаниеОшибки = "Не корректно заполнен ИНН";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;			
		Если НЕ RegExp.Test(НоваяСтрока.ИНН) Тогда 
			НоваяСтрока.ОписаниеОшибки = "Не корректно заполнен ИНН";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
 
	Если ПустаяСтрока(НоваяСтрока.VIN) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле VIN";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.Продавец) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Продавец";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.ДатаРождения) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ДатаРождения";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.АдресКлиента) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле АдресКлиента";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.Модель) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Модель";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.ДатаЗанесенияПродажиВDistri) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ДатаЗанесенияПродажиВDistri";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НоваяСтрока.Согласие) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Согласие";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(НоваяСтрока.Телефон) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле Телефон";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;
		
	Если ПустаяСтрока(НоваяСтрока.ФактическаяДатаВыдачиАвто) Тогда
		НоваяСтрока.ОписаниеОшибки = "Не заполнено поле ФактическаяДатаВыдачиАвто";
		НоваяСтрока.ОшибкаСтроки = Истина;
		Возврат;
	КонецЕсли;

	Если НоваяСтрока.ТипКлиента = "физическое лицо" Тогда	
		ФИОДляПроверки = СтрЗаменить(НоваяСтрока.ФИОКлиента, " ","");
		Длина = СтрДлина(ФИОДляПроверки);
		Сч = 1;	
		Пока Сч<=Длина Цикл	
			КодСимволаСтроки =КодСимвола(ФИОДляПроверки,Сч);
			Если КодСимволаСтроки<1040 
				И КодСимволаСтроки<>45 //- 
				И КодСимволаСтроки<>1025 //Ё
				ИЛИ КодСимволаСтроки>1103 
				И КодСимволаСтроки<>1105 Тогда //ё
				НоваяСтрока.ОписаниеОшибки = "Поле ФИО заполнено некорректно";
				НоваяСтрока.ОшибкаСтроки = Истина;
				Возврат;
			КонецЕсли;	
			Сч = Сч+1;
		КонецЦикла;
	КонецЕсли;


	//проверяем длину VIN
	Если СтрДлина(НоваяСтрока.VIN)<17 Тогда
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;
		
		Если Найти(НоваяСтрока.VIN, "O")<>0 Тогда
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;
		
		Если Найти(НоваяСтрока.VIN, "i")<>0 Тогда
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;

		RegExp.Pattern = "\b([0-9A-Za-z]){17}\b"; //шаблон проверки 17 лат. букв и цифр
		Если НЕ RegExp.Test(НоваяСтрока.VIN) Тогда  
			НоваяСтрока.ОписаниеОшибки = "Поле VIN заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;

		RegExp.Pattern = "\b\d{11}\b"; //шаблон проверки 11 знч только цифры
		Если НЕ RegExp.Test(НоваяСтрока.Телефон) Тогда 
			НоваяСтрока.ОписаниеОшибки = "Поле Телефон заполнено некорректно";
			НоваяСтрока.ОшибкаСтроки = Истина;
			Возврат;
		КонецЕсли;		
		
		Если ЗначениеЗаполнено(НоваяСтрока.Email) Тогда
			RegExp.Pattern = ".+@.+\..+"; //шаблон проверки лат. буквы, цифры, наличие @ и .
			Если НЕ RegExp.Test(НоваяСтрока.Email) Тогда  
				НоваяСтрока.ОписаниеОшибки = "Поле Email заполнено некорректно";
				НоваяСтрока.ОшибкаСтроки = Истина;
				Возврат;
			КонецЕсли;				
		КонецЕсли;
		
		если ТипКлиентаПоРегиструСостоянияАвто = 1 и ТипКлиентаПоРеализации = "малый корпоративный клиент"
			ИЛИ ТипКлиентаПоРегиструСостоянияАвто = 2 и ТипКлиентаПоРеализации = "физическое лицо"
			ИЛИ ТипКлиентаПоРегиструСостоянияАвто = 3 и ТипКлиентаПоРеализации = "физическое лицо"
			ИЛИ ТипКлиентаПоРегиструСостоянияАвто = 4 и ТипКлиентаПоРеализации = "физическое лицо"
			ИЛИ ТипКлиентаПоРегиструСостоянияАвто = 5 и ТипКлиентаПоРеализации = "малый корпоративный клиент"
			ИЛИ ТипКлиентаПоРегиструСостоянияАвто = 6 и ТипКлиентаПоРеализации = "физическое лицо" тогда
				НоваяСтрока.ОписаниеОшибки = "Расхождение типа клиента в distri.net и документе реализации";
				НоваяСтрока.ОшибкаСтроки = Истина;
				возврат;
		КонецЕсли;
		
		НоваяСтрока.ОшибкаСтроки = Ложь;
		НоваяСтрока.ОписаниеОшибки = "";
		
КонецПроцедуры

Процедура ВыгрузитьЗаказНаряды() Экспорт
	
	ТаблицаСоответствийВидовРемонта = ПолучитьТаблицуСоответствийВидовРемонта();
	Если ТаблицаСоответствийВидовРемонта = Неопределено Тогда
		#Если Клиент Тогда
			Предупреждение("Соответствия видов ремонта заполнены не полностью");
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	Для Каждого  Стр из ТаблицаСоответствийВидовРемонта Цикл
		Если Стр.ТипРаботVOC = "" Тогда
			#Если Клиент Тогда
				Предупреждение("Соответствия видов ремонта заполнены не полностью");
			#КонецЕсли
			Возврат;
		КонецЕсли;
	КонецЦикла;
	

	//ТаблицаВнутреннихКонтрагентовДилера = ПолучитьТаблицуВнутреннихКонтрагентовДилера();
	//Если ТаблицаВнутреннихКонтрагентовДилера = Неопределено Тогда
	//	#Если Клиент Тогда
	//		Предупреждение("Не указаны внутренние контрагенты дилера!");
	//	#КонецЕсли
	//	Возврат;
	//КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Если ЭтоКонфигурацияDMS Тогда
		Запрос.Текст = ПолучитьОбщийТекстЗапросаDMS();
	Иначе
		Запрос.Текст = ПолучитьОбщийТекстЗапросаАльфаАвто();
	КонецЕсли;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ТабМотрио", ПолучитьТаблицуАртикуловМотрио());
	Запрос.УстановитьПараметр("ТабСвечи", ПолучитьТаблицуАртикуловСвечей());
	Запрос.УстановитьПараметр("ОтборПодразделений", ОтборПодразделений);
	Запрос.УстановитьПараметр("Подразделения", СписокПодразделений.ВыгрузитьКолонку("Подразделение"));
	Запрос.УстановитьПараметр("СписокОрганизаций",СписокОрганизаций.ВыгрузитьКолонку("Организация"));
	Запрос.УстановитьПараметр("ТаблицаСоответствийВидовРемонта",ТаблицаСоответствийВидовРемонта);
	//Запрос.УстановитьПараметр("ТаблицаВнутреннихКонтрагентовДилера", ТаблицаВнутреннихКонтрагентовДилера);
	Запрос.УстановитьПараметр("ПереключательКонтакты",ПереключательКонтакты);
	Запрос.УстановитьПараметр("ВыгружатьНулевыеЗН", ВыгружатьНулевыеЗН);
	Запрос.УстановитьПараметр("ВыгружатьВыполненныеЗН",ВыгружатьВыполненныеЗН);
	Запрос.УстановитьПараметр("ДнейНаОплатуЗН", 0);
	Запрос.УстановитьПараметр("ПереключательСогласие", ПереключательСогласие);
	
	РезультатПоЗаказНарядам.Очистить();

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Сообщить("Нет данных по заказ-нарядам");
		Возврат;
	КонецЕсли;
	
	СоответствияМоделей = ПолучитьСоответствияМоделейПоVIN();
	
	Запрос.Текст = ПолучитьТекстЗапросаПоРаботам();
	ТаблицаАвтоработЗН = Запрос.Выполнить().Выгрузить();
	ТаблицаАвтоработЗН.Индексы.Добавить("ЗаказНаряд");
		
	RegExp = Новый COMОбъект("VBScript.RegExp");// создаем объект для работы с регулярными выражениями
	RegExp.MultiLine = Ложь;  // истина — текст многострочный, ложь — одна строка
	RegExp.Global = Истина;     // истина — поиск по всей строке, ложь — до первого совпадения
	RegExp.IgnoreCase = Истина; // истина — игнорировать регистр строки при поиске
	
	Параметры = Новый Структура;
	Параметры.Вставить("ТаблицаАвтоработМакета",ПолучитьТаблицуАвтоработМакета());
	Параметры.Вставить("ТаблицаАвтоработDialogys",ПолучитьТаблицуАвтоработDialogys());
	Параметры.Вставить("ТаблицаАвтоработЗН",ТаблицаАвтоработЗН);
	
	ЗаполнитьТаблицуСоответствийКодовРабот(Параметры);
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = РезультатПоЗаказНарядам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если ЗначениеЗаполнено(Выборка.Сертификат) тогда 
			Структура = ДатаИРекоминдация(Выборка.Сертификат,Выборка.ДатаЗакрытия);
			Если Структура.Дата = "" тогда
				НоваяСтрока.ДатаКонтактаСКлиентом = Дата(1,1,1,0,0,0);
				Если ДопИсточникРекомендации =1 тогда
					НоваяСтрока.РекомендованныеРаботы = Выборка.ЗаказНаряд.Рекомендации; 
				Иначе
					НоваяСтрока.РекомендованныеРаботы = Выборка.ЗаказНаряд.Комментарий;
				КонецЕсли;
			Иначе	
				НоваяСтрока.ДатаКонтактаСКлиентом = Структура.Дата;
				НоваяСтрока.РекомендованныеРаботы = Структура.Наименование
			КонецЕсли;
		Иначе
			НоваяСтрока.ДатаКонтактаСКлиентом = Дата(1,1,1,0,0,0);
			Если ДопИсточникРекомендации =1 тогда
				НоваяСтрока.РекомендованныеРаботы = Выборка.ЗаказНаряд.Рекомендации; 
			Иначе
				НоваяСтрока.РекомендованныеРаботы = Выборка.ЗаказНаряд.Комментарий;
			КонецЕсли;
		КонецЕсли;
		
		
		
		Если Лев(СокрЛ(ВРег(НоваяСтрока.VIN)), 3) = "X7L" ИЛИ Лев(СокрЛ(ВРег(НоваяСтрока.VIN)), 3) = "VF1"
			ИЛИ Лев(СокрЛ(ВРег(НоваяСтрока.VIN)), 3) = "VF3" Тогда
			ЗаполнитьМодельПоVIN(НоваяСтрока,СоответствияМоделей)
		Иначе
			НоваяСтрока.Модель = "Другое"
		КонецЕсли;
		
		НоваяСтрока.ФИОКлиента = СОКРЛП(Выборка.ФИОКлиента);
		Параметры.Вставить("НоваяСтрока",НоваяСтрока);
		Параметры.Вставить("Выборка",Выборка);
		//ОпределитьТипКодРаботы(Параметры);
		
		ОпределитьТипКодРаботы_Новый(Параметры);		
		//ЗаполнитьРекомендованныеРаботы(НоваяСтрока,Выборка);
		//убираем в телефоне лишние символы
		НоваяСтрока.Телефон = ПодготовитьТелефон(Выборка.Телефон);
		НоваяСтрока.Email = ПодготовитьEmail(НоваяСтрока.Email);
		ПроверкаЗначенийСтроки(НоваяСтрока,RegExp);

	КонецЦикла;	
	
КонецПроцедуры

Процедура ВыгрузитьПродажи() Экспорт
	
