	РезультатПоПродажам.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Сообщить("Нет данных по продажам");
		Возврат;
	КонецЕсли;
	
	СоответствияМоделей = ПолучитьСоответствияМоделейПоVIN();
	
		
	RegExp = Новый COMОбъект("VBScript.RegExp");// создаем объект для работы с регулярными выражениями
	RegExp.MultiLine = Ложь;  // истина — текст многострочный, ложь — одна строка
	RegExp.Global = Истина;     // истина — поиск по всей строке, ложь — до первого совпадения
	RegExp.IgnoreCase = Истина; // истина — игнорировать регистр строки при поиске
	
		//Для Каждого Стр Из Результат Цикл
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = РезультатПоПродажам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);	
		//ЗаполнитьМодельПоVIN(НоваяСтрока,СоответствияМоделей);
		НоваяСтрока.ФИОКлиента = СОКРЛП(Выборка.ФИОКлиента);
		//убираем в телефоне лишние символы
		НоваяСтрока.Телефон = ПодготовитьТелефон(Выборка.Телефон);
		НоваяСтрока.Email = ПодготовитьEmail(НоваяСтрока.Email);
		НоваяСтрока.ГородКлиента = ВыделитьГородИзАдреса(НоваяСтрока.АдресКлиента, Выборка.КлиентСсылка);
		ПроверкаЗначенийСтрокиПродажи(НоваяСтрока,RegExp,Выборка.ТипКлиентаПоРегиструСостоянияАвто,Выборка.ТипКлиентаПоРеализации);

	КонецЦикла;	

КонецПроцедуры

Функция ВыделитьГородИзАдреса(АдресКлиента, Клиент = Неопределено) Экспорт
	
	ГородКлиента = "";
	
	Если ЗначениеЗаполнено(Клиент) Тогда
		ГородКлиента = ПолучитьГородКлиента(Клиент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГородКлиента) Тогда
		Возврат ГородКлиента;
	КонецЕсли;
	
	ВключатьОбласть = Истина;
	
	ПозицияНачалаНазванияНаселенногоПункта = Найти(нрег(АдресКлиента),"г.");
	
	ПрефиксНаселенногоПункта = "г. ";
	Если ПозицияНачалаНазванияНаселенногоПункта = 0 Тогда
		ПозицияНачалаНазванияНаселенногоПункта = Найти(нрег(АдресКлиента),"с.");
		ПрефиксНаселенногоПункта = "с. ";
	Иначе
		ВключатьОбласть = Ложь;
	КонецЕсли;	
	
	Если ПозицияНачалаНазванияНаселенногоПункта = 0 Тогда
		ПозицияНачалаНазванияНаселенногоПункта = Найти(нрег(АдресКлиента),"пгт.");
		ПрефиксНаселенногоПункта = "пгт. ";
	КонецЕсли;	
	
	Если ПозицияНачалаНазванияНаселенногоПункта = 0 Тогда
		ПозицияНачалаНазванияНаселенногоПункта = Найти(нрег(АдресКлиента),"п.");
		ПрефиксНаселенногоПункта = "п. ";
	КонецЕсли;	
	
	Если ПозицияНачалаНазванияНаселенногоПункта = 0 Тогда
		ПозицияНачалаНазванияНаселенногоПункта = Найти(нрег(АдресКлиента),"село ");
		ПрефиксНаселенногоПункта = "село ";
	КонецЕсли;
	
	Если ПозицияНачалаНазванияНаселенногоПункта = 0 Тогда
		ПозицияНачалаНазванияНаселенногоПункта = Найти(нрег(АдресКлиента),"д.");
		Если ПозицияНачалаНазванияНаселенногоПункта > СтрДлина(АдресКлиента)-12 Тогда  //исключим номер дома 
			Возврат "";
		КонецЕсли;
		ПрефиксНаселенногоПункта = "д. ";
	КонецЕсли;	
	
	Если  ПозицияНачалаНазванияНаселенногоПункта = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	АдресБезОбласти = СокрЛП(Прав(АдресКлиента,СтрДлина(АдресКлиента) - ПозицияНачалаНазванияНаселенногоПункта-1));
	ПозицияКонцаНазванияНаселенногоПункта = Макс(Найти(АдресБезОбласти,","),Найти(АдресБезОбласти," "));
	Если ПозицияКонцаНазванияНаселенногоПункта>0 Тогда
		АдресБезУлицы = ПрефиксНаселенногоПункта + Лев(АдресБезОбласти,ПозицияКонцаНазванияНаселенногоПункта-1);
		Если ВключатьОбласть Тогда
			АдресБезУлицы = Лев(АдресКлиента,ПозицияНачалаНазванияНаселенногоПункта-1) + АдресБезУлицы;
		КонецЕсли;
	Иначе
		АдресБезУлицы = ПрефиксНаселенногоПункта + АдресБезОбласти;
		Если ВключатьОбласть Тогда
			АдресБезУлицы = Лев(АдресКлиента,ПозицияНачалаНазванияНаселенногоПункта-1) + АдресБезУлицы;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат АдресБезУлицы;

КонецФункции

Процедура ВыгрузитьЗаказНарядыВФаил(ИмяФайла = "", ТаблицаДанных = Неопределено) Экспорт
	
	Если РезультатПоЗаказНарядам.Количество() = 0 Тогда
		Сообщить("Сначала сформируйте таблицу заказ-нарядов");
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура;
	Поиск.Вставить("ОшибкаСтроки", Истина);
	
	//СтрокиСОшибками = РезультатПоЗаказНарядам.НайтиСтроки(Поиск);
	//
	//Если СтрокиСОшибками.Количество()>0 Тогда
	//	Сообщить("Существуют строки с ошибками, выгрузка отменена");
	//	Возврат;
	//КонецЕсли;	
	
	ТабДок = Новый Табличныйдокумент; 
	Макет = ПолучитьМакет("МакетЗаказНаряды");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	// { DMSREN-668 Болдарев Д.Е. от 25.03.2020  
	
	Организация = Неопределено;
	//Если ПереключательДЦ = 1 И СписокОрганизаций.Количество() > 0 Тогда
	//	ТаблицаОрг = СписокОрганизаций.Выгрузить(,"Организация");
	//ИначеЕсли ПереключательДЦ = 0 и СписокОрганизаций.Количество() > 0 Тогда 
	//	ТаблицаОрг = СписокОрганизаций.Выгрузить(,"ДилерскийЦентр");
	//КонецЕсли;
	Если ПереключательДЦ = 1 Тогда
		ТаблицаОрг = СписокОрганизаций.Выгрузить(,"Организация");
	ИначеЕсли ПереключательДЦ = 0 Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.Организации"));
		ТаблицаОрг = Новый ТаблицаЗначений();
		ТаблицаОрг.Колонки.Добавить("Организация",Новый ОписаниеТипов(МассивТипов));
		Для Каждого Стр Из СписокОрганизаций Цикл 
			НоваяСтрока = ТаблицаОрг.Добавить();
			НоваяСтрока.Организация = Стр.ДилерскийЦентр.Организация;
		КонецЦикла;	
	КонецЕсли;
		
	// } DMSREN-668 Болдарев Д.Е. от 25.03.2020. 
	
	
	
	Запрос = Новый Запрос;
	
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	КонтактнаяИнформация.Поле4 КАК Город,
	//               |	КонтактнаяИнформация.Объект как Организация
	//               |ИЗ
	//               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	//               |ГДЕ
	//               |	КонтактнаяИнформация.Объект В(&Объект)
	//               |	И КонтактнаяИнформация.Тип = &Тип
	//               |	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Организации.Организация КАК Организация
	               |ПОМЕСТИТЬ ВтОрганизации
	               |ИЗ
	               |	&ТаблицаОрг КАК Организации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонтактнаяИнформация.Поле4 КАК Город,
	               |	КонтактнаяИнформация.Объект
	               |ПОМЕСТИТЬ ГородВт
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Тип = &Тип
	               |	И КонтактнаяИнформация.Вид = &Вид
	               |	И КонтактнаяИнформация.Объект В
	               |			(ВЫБРАТЬ
	               |				ВтОрганизации.Организация
	               |			ИЗ
	               |				ВтОрганизации КАК ВтОрганизации)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВтОрганизации.Организация,
	               |	ЕСТЬNULL(ГородВт.Город, """") КАК Город
	               |ИЗ
	               |	ВтОрганизации КАК ВтОрганизации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ГородВт КАК ГородВт
	               |		ПО ВтОрганизации.Организация = ГородВт.Объект";
	
	//Запрос.УстановитьПараметр("Объект", Организация);		
	Запрос.УстановитьПараметр("ТаблицаОрг", ТаблицаОрг);		
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	
	АдресаОрганизаций = Запрос.Выполнить();
	Выборка = АдресаОрганизаций.Выбрать();
	ДиллерШапка = "";
	Пока Выборка.Следующий() Цикл 
		ДиллерШапка = ДиллерШапка + Выборка.Организация.НаименованиеПолное + Выборка.Город + "; ";		
	КонецЦикла;
	
	
	ОбластьШапка.Параметры.Дилер        	= ДиллерШапка;
	ОбластьШапка.Параметры.НачалоПериода 	= Формат(НачалоПериода,"ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.КонецПериода  	= Формат(КонецПериода,"ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.КодCATI  	 	= КодCATI;
	ТабДок.Вывести(ОбластьШапка);
	
	Если ТаблицаДанных = Неопределено Тогда
		Для Каждого Стр Из РезультатПоЗаказНарядам Цикл
			Если Стр.ОшибкаСтроки Тогда
				ОбластьСтроки = Макет.ПолучитьОбласть("СтрокиОшибка");
			Иначе
				ОбластьСтроки = Макет.ПолучитьОбласть("Строки");
			КонецЕсли;
			ОбластьСтроки.Параметры.Заполнить(Стр);
			ТабДок.Вывести(ОбластьСтроки);
		КонецЦикла;
	Иначе 
		Для Каждого Стр Из ТаблицаДанных Цикл
			Если Стр.ОшибкаСтроки Тогда
				ОбластьСтроки = Макет.ПолучитьОбласть("СтрокиОшибка");
			Иначе
				ОбластьСтроки = Макет.ПолучитьОбласть("Строки");
			КонецЕсли;
			ОбластьСтроки.Параметры.Заполнить(Стр);
			ТабДок.Вывести(ОбластьСтроки);
		КонецЦикла;
	КонецЕсли;

	Если ИмяФайла = "" Тогда
		#Если Клиент Тогда
			ДиалогФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			ДиалогФайла.Фильтр = "Файл Excel (*.xls)|*.xls";
			Если ДиалогФайла.Выбрать() Тогда
				ТабДок.Записать(ДиалогФайла.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLS);
			КонецЕсли;
		#КонецЕсли
	Иначе
		ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLS);	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьГородКлиента(Клиент) 
	
	ГородКлиента = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Поле2,
	|	КонтактнаяИнформация.Поле4,
	|	КонтактнаяИнформация.Поле5
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = &Тип
	|	И КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА";
	Запрос.УстановитьПараметр("Объект", Клиент);
    Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Поле5) Тогда
			ГородКлиента = Выборка.Поле5;
		ИначеЕсли ЗначениеЗаполнено(Выборка.Поле4) Тогда
			ГородКлиента = Выборка.Поле4;
		ИначеЕсли ЗначениеЗаполнено(Выборка.Поле2) Тогда
			ГородКлиента = Выборка.Поле2;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ГородКлиента;
	
КонецФункции

Функция ДатаИРекоминдация(Сертификат,ДатаЗакрытия)
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	Renault_СертификатКонтроляРаботы.РекомендуемаяДатаВыполнения КАК РекомендуемаяДатаВыполнения,
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(Renault_СертификатКонтроляРаботы.Работа) = ТИП(справочник.автоработы)
	                |			ТОГДА ПРЕДСТАВЛЕНИЕ(Renault_СертификатКонтроляРаботы.Работа.НаименованиеПолное)
	                |		ИНАЧЕ ВЫРАЗИТЬ(Renault_СертификатКонтроляРаботы.Работа КАК СТРОКА(100))
	                |	КОНЕЦ КАК Наименование
	                |ИЗ
	                |	Документ.Renault_СертификатКонтроля.Работы КАК Renault_СертификатКонтроляРаботы
	                |ГДЕ
	                |	Renault_СертификатКонтроляРаботы.РаботаАктуальна = ИСТИНА
	                |	И Renault_СертификатКонтроляРаботы.Ссылка = &Ссылка
	                |	И Renault_СертификатКонтроляРаботы.РекомендуемаяДатаВыполнения > &ДатаПлан
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	Renault_ВыполнениеТОСрезПервых.ДатаПлан,
	                |	ПРЕДСТАВЛЕНИЕ(Renault_ВыполнениеТОСрезПервых.ВидТО)
	                |ИЗ
	                |	РегистрСведений.Renault_ВыполнениеТО.СрезПервых КАК Renault_ВыполнениеТОСрезПервых
	                |ГДЕ
	                |	Renault_ВыполнениеТОСрезПервых.ДатаПлан > &ДатаПлан
	                |	И Renault_ВыполнениеТОСрезПервых.Автомобиль = &Автомобиль
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	РекомендуемаяДатаВыполнения";
	Запрос.УстановитьПараметр("Ссылка",Сертификат);
	Запрос.УстановитьПараметр("ДатаПлан",ДатаЗакрытия);
	Запрос.УстановитьПараметр("Автомобиль",Сертификат.Автомобиль);
	Таб = Запрос.Выполнить().Выгрузить();
	Структура = новый Структура;
	Если Таб.Количество()>0 Тогда
		Структура.Вставить("Дата",Таб[0].РекомендуемаяДатаВыполнения);
		Структура.Вставить("Наименование",Таб[0].Наименование);
	Иначе
		Структура.Вставить("Дата","");
		Структура.Вставить("Наименование","");
	КонецЕсли;
	
	
	Возврат Структура;		
	
КонецФункции

