	               |				КОНЕЦ) КАК ДлительностьРабот
	               |		ИЗ
	               |			ВсеЗаказНаряды КАК ВТВсеЗаказНарядыРено
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
	               |				ПО ВТВсеЗаказНарядыРено.ЗаказНаряд = ЗаказНарядРаботы.Ссылка
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТВсеЗаказНарядыРено.ЗаказНаряд) КАК СуммаДлительностьРабот
	               |		ПО ВТВсеЗаказНарядыРено.ЗаказНаряд = СуммаДлительностьРабот.ЗаказНаряд
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТВсеЗаказНарядыРено.ЗаказНаряд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТЗаказНаряды.ЗаказНаряд,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(ТабМотрио.Артикул, 0) = 0
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) КАК ЕстьМОТРИО,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(ТабСвечи.Артикул, 0) = 0
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) КАК ЕстьСвечи,
	               |	СУММА(ЗаказНарядТовары.СуммаВсего) КАК СуммаЗЧ
	               |ПОМЕСТИТЬ МотриоИСвечи
	               |ИЗ
	               |	Работы КАК ВТЗаказНаряды
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ТабСвечи КАК ТабСвечи
