Функция ЗаполнитьТаблицуСоответствийКодовРабот(Параметры)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_СоответствиеАртикуловКодамРабот.КодРабот,
	               |	Renault_СоответствиеАртикуловКодамРабот.Артикул,
	               |	1 КАК Приритет
	               |ИЗ
	               |	Справочник.Renault_СоответствиеАртикуловКодамРабот КАК Renault_СоответствиеАртикуловКодамРабот
	               |ГДЕ
	               |	НЕ Renault_СоответствиеАртикуловКодамРабот.ПометкаУдаления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_КомплексСервисыАвторабот.КодРабот,
	               |	Renault_КомплексСервисыАвторабот.Артикул,
	               |	0
	               |ИЗ
	               |	Справочник.Renault_КомплексСервисыАвторабот КАК Renault_КомплексСервисыАвторабот
	               |ГДЕ
	               |	НЕ Renault_КомплексСервисыАвторабот.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Приритет";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Параметры.Вставить("ТаблицаСоответствийКодовРабот",Таблица);
КонецФункции	

Процедура ОпределитьТипКодРаботы(Параметры) Экспорт
	
	НоваяСтрока = Параметры.НоваяСтрока;
	ТипРаботыЗН = Строка(Параметры.Выборка.ТипРаботы);
	НоваяСтрока.ТипРаботы = ТипРаботыЗН;
	
	ТаблицаАвтоработМакета = Параметры.ТаблицаАвтоработМакета;
	ТаблицаАвтоработDialogys = Параметры.ТаблицаАвтоработDialogys;
	ТаблицаАвтоработЗН = Параметры.ТаблицаАвтоработЗН;
	
	СтрокиРаботыЗН = ТаблицаАвтоработЗН.НайтиСтроки(Новый Структура("ЗаказНаряд",Параметры.Выборка.ЗаказНаряд));
	
	Для каждого Стр из СтрокиРаботыЗН Цикл //анализируем все работы из заказ-наряда.
		
		Артикул = СокрЛП(Стр.Артикул);
		
		Если Параметры.Выборка.ЕстьМОТРИО = 1 Тогда //Сначала ищем МОТРИО
			//Ищем совпадение по 5-ти первым символам артикула автоработы.
			Отбор = Новый Структура("Артикул,Мотрио",Лев(Артикул,5),Строка(Параметры.Выборка.ЕстьМОТРИО));
			СтрокиТЗ = ТаблицаАвтоработМакета.НайтиСтроки(Отбор);
			Если СтрокиТЗ.Количество()>0 Тогда
				СтрТЗ = СтрокиТЗ[0];
				Если СтрТЗ.ТипРаботы = ТипРаботыЗН Тогда 
					НоваяСтрока.КодРаботы = СтрТЗ.КодРаботы;
					НоваяСтрока.ТипРаботы = СтрТЗ.ТипРаботы;
					Прервать; //Нашли работу с самым высоким приоритетом - сразу выходим из цикла
				Иначе 
					Продолжить; 
				КонецЕсли;  //Если тип работы в заказ-наряде отличается от типа в макете, то не подходит.
			КонецЕсли;
		КонецЕсли;
		
		Если Артикул = "GTC001" Тогда //Проведение ГТО
			НоваяСтрока.КодРаботы = "37";
			НоваяСтрока.Приоритет = 6;
			НоваяСтрока.ТипРаботы = "Другое"; 
			Продолжить;
		ИначеЕсли Лев(Артикул,5) = "TM001" Тогда
			Если НоваяСтрока.Приоритет > 7 Тогда
				НоваяСтрока.КодРаботы = "600";
				НоваяСтрока.Приоритет = 7;
				НоваяСтрока.ТипРаботы = "Обслуживание";
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		//Ищем работу среди ТО
		Если Лев(Артикул,2) = "TM" Тогда//ИЛИ Лев(Артикул,2) = "CS" Тогда
			Если Параметры.Выборка.Пробег = 0 Тогда //ТО без указания пробега, будем искать по части артикула ("ТМ" + 3 Символа)
				АртикулПоиска = Лев(Артикул,5);//?(Лев(Артикул,2) = "CS", "TM"+Сред(Артикул,3,3), Лев(Артикул,5));
				Отбор = Новый Структура("Артикул, Свечи", АртикулПоиска,Строка(Параметры.Выборка.ЕстьСвечи)); //выберем работы по артикулу и признаку наличия Свечей в ЗН
				СтрокиТЗ = ТаблицаАвтоработМакета.НайтиСтроки(Отбор);
				Если СтрокиТЗ.Количество()>0 Тогда
					СтрТЗ = СтрокиТЗ[0];
					Если СтрТЗ.Приоритет < НоваяСтрока.Приоритет Тогда
						НоваяСтрока.КодРаботы = СтрТЗ.КодРаботы;
						НоваяСтрока.Приоритет = СтрТЗ.Приоритет;
						НоваяСтрока.ТипРаботы = СтрТЗ.ТипРаботы;
					КонецЕсли;
				КонецЕсли;
			Иначе //ТО Ищем по указанному пробегу
				Отбор = Новый Структура("Свечи",Строка(Параметры.Выборка.ЕстьСвечи)); //выберем работы по признаку наличия Свечей в ЗН
				СтрокиТЗ = ТаблицаАвтоработМакета.НайтиСтроки(Отбор);
				Пробег = Параметры.Выборка.Пробег;
				Для Каждого СтрТЗ из СтрокиТЗ Цикл
					Если Пробег>=Число(СтрТЗ.ПробегОт) И Пробег<=Число(СтрТЗ.ПробегДо) Тогда //Подберем работу по пробегу из ЗН
						Если СтрТЗ.Приоритет < НоваяСтрока.Приоритет Тогда
							НоваяСтрока.КодРаботы = СтрТЗ.КодРаботы;
							НоваяСтрока.Приоритет = СтрТЗ.Приоритет;
							НоваяСтрока.ТипРаботы = СтрТЗ.ТипРаботы;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		//Ищем совпадение по 5-ти первым символам артикула автоработы, без мотрио
		Отбор = Новый Структура("Артикул,Мотрио",Лев(Артикул,5),"0");
		СтрокиТЗ = ТаблицаАвтоработМакета.НайтиСтроки(Отбор);
		Если СтрокиТЗ.Количество()>0 Тогда
			СтрТЗ = СтрокиТЗ[0];
			Если СтрТЗ.Приоритет < НоваяСтрока.Приоритет Тогда
				НоваяСтрока.КодРаботы = СтрТЗ.КодРаботы;
				НоваяСтрока.Приоритет = СтрТЗ.Приоритет;
				НоваяСтрока.ТипРаботы = СтрТЗ.ТипРаботы;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		//Если Артикул = "AC1" Тогда 
		Если НоваяСтрока.Приоритет > 73 и ТипРаботыЗН = "Установка аксессуаров" Тогда
			НоваяСтрока.КодРаботы = "34";
			НоваяСтрока.Приоритет = 73;
			НоваяСтрока.ТипРаботы = "Установка аксессуаров";
			//Продолжить;
		КонецЕсли;
		
		//КонецЕсли;

		
		//поиск любой кодировки из справочника Диалоджис
		Отбор = Новый Структура("Артикул",Артикул);
		СтрокиТЗ = ТаблицаАвтоработDialogys.НайтиСтроки(Отбор);
		
		Если СтрокиТЗ.Количество()>0 Тогда
			Если НоваяСтрока.Приоритет > 79  Тогда
	 			НоваяСтрока.КодРаботы = "32"; 
				НоваяСтрока.ТипРаботы = "Механический ремонт";
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
			
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КодРаботы) И ТипРаботыЗН = "Кузовной ремонт" Тогда 
			Если ЗначениеЗаполнено(Параметры.Выборка.ИНН) Тогда
				НоваяСтрока.КодРаботы = "33-01";
			Иначе
				НоваяСтрока.КодРаботы = "33-03";
			КонецЕсли;
			НоваяСтрока.ТипРаботы = "Кузовной ремонт";
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(НоваяСтрока.КодРаботы) Тогда
		Если ТипРаботыЗН = "Механический ремонт" Тогда
	 		НоваяСтрока.КодРаботы = "32"; 
			НоваяСтрока.ТипРаботы = "Механический ремонт";
		Иначе
		//неопределившаяся кодировка
		НоваяСтрока.КодРаботы = "36";
		НоваяСтрока.ТипРаботы = "Другое";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьТипКодРаботы_Новый(Параметры) Экспорт
	ТаблицаСоответствий = Параметры.ТаблицаСоответствийКодовРабот;
	НоваяСтрока = Параметры.НоваяСтрока;
	ТипРаботыЗН = Строка(Параметры.Выборка.ТипРаботы);
	НоваяСтрока.ТипРаботы = ТипРаботыЗН;
	
	ТаблицаАвтоработDialogys = Параметры.ТаблицаАвтоработDialogys;
	ТаблицаАвтоработЗН = Параметры.ТаблицаАвтоработЗН;
	
	СтрокиРаботыЗН = ТаблицаАвтоработЗН.НайтиСтроки(Новый Структура("ЗаказНаряд",Параметры.Выборка.ЗаказНаряд));
	ТЧ = ТаблицаАвтоработЗН.Скопировать(СтрокиРаботыЗН);
	ТЧ.Сортировать("Сумма УБЫВ");
	
	Для каждого Стр из ТЧ Цикл //анализируем все работы из заказ-наряда.
		
		Артикул = СокрЛП(Стр.Артикул);
		АртикулПоиска = Лев(Артикул,5);
		
		НайденныеСтроки = ТаблицаСоответствий.НайтиСтроки(Новый Структура("Артикул",Артикул));
		Если НайденныеСтроки.Количество()>0 И НайденныеСтроки[0].КодРабот <> "" Тогда
			НоваяСтрока.КодРаботы = НайденныеСтроки[0].КодРабот;
			Возврат;
		КонецЕСли;
		Если НайденныеСтроки.Количество()=0 тогда
			НайденныеСтроки = ТаблицаСоответствий.НайтиСтроки(Новый Структура("Артикул",АртикулПоиска));
			Если НайденныеСтроки.Количество()>0 И НайденныеСтроки[0].КодРабот <> "" Тогда
				НоваяСтрока.КодРаботы = НайденныеСтроки[0].КодРабот;
				Возврат;
			ИначеЕсли Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.КузовнойРемонт
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.ГарантияКузовнойЦех тогда
				НоваяСтрока.КодРаботы  = "33-04";	
			ИначеЕсли Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.СлесарныйРемонт
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.РегулярноеТО 
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.РегулярноеТОИСлесарныйРемонт 
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.Мойка 
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.ДополнительноеОборудование 
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.ГарантияСлесарныйРемонт 
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.ВнутреннийРемонт
					ИЛИ Параметры.Выборка.ТипРаботы = Перечисления.Renault_КлассификацияВидовРемонта.СервисныеПродукты Тогда
				НоваяСтрока.КодРаботы  = "32";	
			КонецЕСли;	
		КонецЕСли;	
	КонецЦикла;
КонецПроцедуры


Процедура ЗаполнитьРекомендованныеРаботы(НоваяСтрока,Выборка) Экспорт
	
	// Трояновский К.Е. 20.08.2019 16:16:17 {
	// DMSREN-230
	
	////DMSCOR-364: заполнять рекомендациями и по типу работ "Другое"
	//Если 
	//	//(НоваяСтрока.ТипРаботы = "Механический ремонт"
	//	//+
	//	//ИЛИ НоваяСтрока.ТипРаботы = "Другое"
	//	//
	//	//ИЛИ НоваяСтрока.ТипРаботы = "Обслуживание" 
	//	//ИЛИ	НоваяСтрока.ТипРаботы = "Установка аксессуаров") И 
	//	//-
	//	НЕ НоваяСтрока.ТипКлиента = "внутренний заезд"  Тогда
	// Трояновский К.Е. 20.08.2019 16:16:17 }
	
	// НАЧАЛО DMSCOR-1481 27.09.2019
	ЗаполнитьПоЗН = Истина;
	Если ЭтоКонфигурацияDMS И ЗначениеЗаполнено(Выборка.Сертификат) И Выборка.Сертификат.Работы.Количество()>0 Тогда
		
		ТЗРабот = Выборка.Сертификат.Работы.Выгрузить();
		ТЗРабот.Сортировать("РекомендуемаяДатаВыполнения возр");
		ЕстьРаботы = Ложь;
		Для каждого стр из ТЗРабот Цикл
			Если стр.РаботаАктуальна Тогда
				НоваяСтрока.РекомендованныеРаботы = НоваяСтрока.РекомендованныеРаботы + "; " + Стр.Работа;
				НоваяСтрока.ДатаКонтактаСКлиентом = Стр.РекомендуемаяДатаВыполнения;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьРаботы Тогда
			НоваяСтрока.РекомендованныеРаботы = Прав(НоваяСтрока.РекомендованныеРаботы,СтрДлина(НоваяСтрока.РекомендованныеРаботы)-2);
			ЗаполнитьПоЗН = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗаполнитьПоЗН Тогда
		
		НоваяСтрока.ДатаКонтактаСКлиентом = Выборка.ДатаЗакрытия + 60*60*24*90;
		Если ДопИсточникРекомендации = 0 Тогда
			НоваяСтрока.РекомендованныеРаботы = Выборка.Комментарий;
		Иначе
			НоваяСтрока.РекомендованныеРаботы = Выборка.Рекомендации;
		КонецЕсли;
		
		Если ПустаяСтрока(СокрЛП(НоваяСтрока.РекомендованныеРаботы)) Тогда
			НоваяСтрока.ДатаКонтактаСКлиентом = Дата(1,1,1);
		КонецЕсли;
		
	КонецЕсли;
	// КОНЕЦ DMSCOR-1481 27.09.2019
		
	// Трояновский К.Е. 20.08.2019 16:17:11 {
	// DMSREN-230
	//КонецЕсли;
	// Трояновский К.Е. 20.08.2019 16:17:11 }

