Функция ПолучитьТаблицуАвтоработМакета() Экспорт
	
	Макет = ПолучитьМакет("Автоработы");
				
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область("Область1"));
	ПостроительЗапроса.Выполнить();
	Таблица = ПостроительЗапроса.Результат.Выгрузить(); 
	Таблица.Колонки.Добавить("Приоритет",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	Таблица.Индексы.Добавить("Артикул");
	Таблица.Индексы.Добавить("ТипРаботы");
	Для каждого стр из Таблица Цикл
		стр.Приоритет = Число(Стр.ПриоритетСтр);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьТаблицуАвтоработDialogys() Экспорт
	Если ЭтоКонфигурацияDMS	Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СоставАвторабот.Авторабота.Артикул КАК Артикул
		|ИЗ
		|	Справочник.DMS_РесурсныеСпецификации.СоставАвторабот КАК СоставАвторабот
		|ГДЕ
		|	СоставАвторабот.Ссылка.ПометкаУдаления = ЛОЖЬ";
		
		Таблица = Запрос.Выполнить().Выгрузить();
		Таблица.Индексы.Добавить("Артикул");
		
	Иначе
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("Артикул");
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

