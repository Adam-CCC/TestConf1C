	               |				ИНАЧЕ ВсеЗаказНаряды.Контрагент = КонтактнаяИнфЭлПочта.Объект
	               |			КОНЕЦ)
	               |ГДЕ
	               |	(&ВыгружатьНулевыеЗН
	               |			ИЛИ ЕСТЬNULL(Работы.СуммаРабот, 0) + ЕСТЬNULL(МотриоИСвечи.СуммаЗЧ, 0) > 0)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаЗакрытия";
				   
				   
	Если Метаданные.Справочники.Найти("Сотрудники") <> Неопределено 
		И Метаданные.Справочники.Сотрудники.Реквизиты.Найти("Псевдоним") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"ВсеЗаказНаряды.Мастер.Наименование","ВЫБОР КОГДА ВсеЗаказНаряды.Мастер.Псевдоним = """" ТОГДА ВсеЗаказНаряды.Мастер.Наименование ИНАЧЕ ВсеЗаказНаряды.Мастер.Псевдоним КОНЕЦ");
	КонецЕсли;

	Возврат Запрос.Текст;
		
