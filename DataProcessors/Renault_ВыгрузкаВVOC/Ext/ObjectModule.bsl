Функция	ПодготовитьТелефон(ТелефонВыборка) Экспорт
	
	Телефон = СтрЗаменить(ТелефонВыборка,"(","");
	Телефон = СтрЗаменить(Телефон,")","");
	Телефон = СтрЗаменить(Телефон,"+","");
	Телефон = СтрЗаменить(Телефон," ","");
	Возврат СтрЗаменить(Телефон,"-","");
	
