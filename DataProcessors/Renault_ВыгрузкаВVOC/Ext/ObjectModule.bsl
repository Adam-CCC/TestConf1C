Процедура ЗаполнитьМодельПоVIN(НоваяСтрока,Модели) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НоваяСтрока.VIN) Тогда
		Возврат;
	КонецЕсли;
	
	КодМодели = Сред(НоваяСтрока.VIN,5,2);
	Если Лев(КодМодели,1) = "M" Тогда
		КодМодели = "M";
	КонецЕсли;   	
	ТипКузова = Сред(НоваяСтрока.VIN,4,1);
	КодИзготовителя = Лев(НоваяСтрока.VIN,3);
	OTTC = Сред(НоваяСтрока.VIN,4,6);
	Модель = Модели.Получить(КодМодели);
	Если Модель <> Неопределено Тогда
		Если КодМодели = "M" 
			ИЛИ КодМодели = "SR" 
			ИЛИ КодМодели = "T1"
			ИЛИ КодМодели = "W0"
			ИЛИ КодМодели = "Z1" Тогда
			  Модель = Модель.Получить(ТипКузова);
			  // --- DMSREN-1125
			  если ТипКузова = "H" тогда
				  Модель = ПолучитьВерсиюДастера(OTTC);
			  КонецЕсли;
			  // DMSREN-1125 ---
		ИначеЕсли КодМодели = "ZA" 
			ИЛИ КодМодели = "ZB"
			ИЛИ КодМодели = "ZL" Тогда
			Модель = Модель.Получить(КодИзготовителя);		
		КонецЕсли;
	КонецЕсли;
	
	Если Модель <> Неопределено Тогда 
		НоваяСтрока.Модель = Модель;
	КонецЕсли;
	
КонецПроцедуры 

Функция ПолучитьТаблицуАртикуловМотрио() Экспорт
		
	Макет = ПолучитьМакет("MOTRIO");
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область("Область1"));
	ПостроительЗапроса.Выполнить();
	Возврат ПостроительЗапроса.Результат.Выгрузить();
	
