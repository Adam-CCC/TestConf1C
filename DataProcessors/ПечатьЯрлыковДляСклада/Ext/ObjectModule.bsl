Процедура ПечатьЯрлыков(НомерВар) Экспорт
	Если СекцииДляПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
   	Если НомерВар=1 Тогда
		МакетЯрлыка = ПолучитьМакет("МакетЯрлыка");
	Иначе	
 		МакетЯрлыка = ПолучитьМакет("Макет");
 	КонецЕсли; 
	 
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;

	СтрокаДляВывода = Неопределено;
	
	Сч_Столб = 0;
	Сч = 1;
	
	Для Каждого СтрокаСекции Из СекцииДляПечати Цикл
		//СтрокаДляВывода = Новый ТабличныйДокумент;
		//СтрокаДляВывода.ПолеСверху = 0;
		//СтрокаДляВывода.ПолеСнизу = 0;
		//СтрокаДляВывода.ПолеСлева = 0;
		//СтрокаДляВывода.ПолеСправа = 0;
		
