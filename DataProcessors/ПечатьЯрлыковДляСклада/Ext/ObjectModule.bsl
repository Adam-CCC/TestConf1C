Функция НайтиШтрихКод(Ячейка) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЯчейкиХранения.Ссылка,
	               |	ШтрихКоды.ШтрихКод
	               |ИЗ
	               |	Справочник.ЯчейкиХранения КАК ЯчейкиХранения
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШтрихКоды КАК ШтрихКоды
	               |		ПО (ШтрихКоды.Объект = ЯчейкиХранения.Ссылка)
	               |ГДЕ
	               //|	ЯчейкиХранения.Владелец = &Владелец	И 
				   |ЯчейкиХранения.ПометкаУдаления = ЛОЖЬ
	               |	И ЯчейкиХранения.Ссылка = &Ссылка";
				   
				  // Запрос.УстановитьПараметр("Владелец",Склад);
				   Запрос.УстановитьПараметр("Ссылка",Ячейка);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() цикл
  		Возврат Результат.ШтрихКод;
	КонецЦикла;	
	
	Возврат "";
	
КонецФункции
