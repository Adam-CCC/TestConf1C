	ИначеЕсли Не ОшибкаПолученияДанных Тогда
		ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);   
		ПодключитьОбработчикОжидания("ВыполнениеДлительнойОперацииПочта", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания)
	ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.ТекущийИнтервал * ПараметрыОбработчикаОжидания.КоэффициентУвеличенияИнтервала;
	Если ПараметрыОбработчикаОжидания.ТекущийИнтервал > ПараметрыОбработчикаОжидания.МаксимальныйИнтервал Тогда
		ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.МаксимальныйИнтервал;
	КонецЕсли; 		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(Знач ИдентификаторЗадания, ОшибкаПолученияДанных)
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	ОшибкаПолученияДанных = Ложь;
	Если Задание <> Неопределено
		И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПоказатьПолныйТекстОшибки = Ложь;
	Если Задание = Неопределено Тогда
		ОшибкаПолученияДанных = Истина;
	Иначе
		Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			ОшибкаПолученияДанных = Истина;
		ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;	 	
КонецФункции

&НаКлиенте
Процедура ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации)
	Если ТипЗнч(ФормаДлительнойОперации) = Тип("УправляемаяФорма") Тогда
		Если ФормаДлительнойОперации.Открыта() Тогда
			ФормаДлительнойОперации.Закрыть();
		КонецЕсли;
	КонецЕсли;
	ФормаДлительнойОперации = Неопределено;  	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания)
	
	ПараметрыОбработчикаОжидания = Новый Структура(
		"МинимальныйИнтервал,МаксимальныйИнтервал,ТекущийИнтервал,КоэффициентУвеличенияИнтервала", 1, 15, 1, 1.4);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОнлайн()
	Если ПраваПользователя.РаботаетОнлайнКонсультант Тогда  		
		Если СтатусОператора = Ложь Тогда		
			ОбновитьСтатусОператора(); 
			ПодключитьОбработчикОжидания("ОбновитьСтатусОператора", 180);
			
			Элементы.кнПодключитьОнлайн.ЦветФона = ЦветАктив;
			Элементы.кнПодключитьОнлайн.Картинка = БиблиотекаКартинок.Renault_Confirm_Square;
			Элементы.кнПодключитьОнлайн.Заголовок = "Отключить";
			
			СтатусОператора = Истина;			
		Иначе  			
			ОтключитьОбработчикОжидания("ОбновитьСтатусОператора");
			
			Отбор = Новый Структура;
			Отбор.Вставить("ВидимостьОбщий", Истина);
			Отбор.Вставить("ТипТрафика", ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант"));
			МассивСтрок = НастройкиКонтактЦентра.НайтиСтроки(Отбор);
			
			Для Каждого ЭлементМассива ИЗ МассивСтрок Цикл
				BIR = Renault_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементМассива.ДилерскийЦентр, "BIR");
				Если ЗначениеЗаполнено(BIR) Тогда
					Renault_ОнлайнКонсультант.ОтключитьКонсультантаВебСервис(BIR);
				КонецЕсли;
			КонецЦикла;
			ОбновитьСтатусСотрудника(ПредопределенноеЗначение("Перечисление.Renault_КонтактЦентр_СтатусыСотрудников.offline"));
			
			Элементы.кнПодключитьОнлайн.Заголовок = "Подключить";
			Элементы.кнПодключитьОнлайн.ЦветФона = ЦветСерый;
			Элементы.кнПодключитьОнлайн.Картинка = БиблиотекаКартинок.Renault_Square_NEw; 
			
			СтатусОператора = Ложь; 			
		КонецЕсли;		
	КонецЕсли;  
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусОператора() Экспорт	
	Для Каждого Элемент ИЗ МассивBIR Цикл
		Renault_ОнлайнКонсультант.ПодключитьКонсультантаВебСервис(Элемент);
	КонецЦикла; 	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод()
	ПараметрыФормы = Новый Структура("Дата1, Дата2", ОтборПериод.ДатаНачала, ОтборПериод.ДатаОкончания);
	ОпОповещения = Новый ОписаниеОповещения("УстановкаДанныхПериода", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.Renault_ВыборПериода", ПараметрыФормы, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура УстановкаДанныхПериода(ДанныеПериода, ДополнительныеПараменты) Экспорт
	Если ДанныеПериода = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ОтборПериод.ДатаНачала = ДанныеПериода.Дата1;
	ОтборПериод.ДатаОкончания = ДанныеПериода.Дата2; 
	
	ОбновитьСписокТрафика();
	ОбновитьЧат();
	СформироватьЗаголовокФормы();
	НачальноеОтображаениеЧатаИДанныхКлиента();
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьУведомления()
	ПоказыватьУведомления = НЕ ПоказыватьУведомления;
	
	Если ПоказыватьУведомления Тогда
		Элементы.кнПоказыватьУведомления.ЦветФона = ЦветАктив;
		Элементы.кнПоказыватьУведомления.Картинка = БиблиотекаКартинок.Renault_Confirm_Square;
	Иначе
		Элементы.кнПоказыватьУведомления.ЦветФона = ЦветСерый;
		Элементы.кнПоказыватьУведомления.Картинка = БиблиотекаКартинок.Renault_Square_NEw;
	КонецЕсли;
КонецПроцедуры

