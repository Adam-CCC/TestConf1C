&НаКлиенте
Процедура СформироватьИсторию()
	ИсторияТекст = "";
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault")
		ИЛИ ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
		ИсторияТекст = СформироватьТекстПоляИсторияТекст(ВыбранныйТрафикID, НаименованиеОператора);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьТекстПоляИсторияТекст(ИД, НаименованиеОператора)
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	
	ТекстПоля = ЗаполнитьШапкуПоляЧата(ОбработкаОК);
	Табл = ОбработкаОК.ПолучитьИсториюПоЛиду(ИД);
	ПредыдущаяДатаСообщения = Дата(1,1,1,0,0,0);
	ПредыдущийВывод = "-1";
	НачатаТаблица = Ложь;
	
	Для Каждого Выборка Из Табл Цикл  		
		Если Выборка.ВидСообщения = 1 Тогда
			//Сообщение отправил клиент
			СтрокаЧата = СформироватьСтрокуШтмлСообщенияЛиды(ОбработкаОК, ПредыдущаяДатаСообщения, ПредыдущийВывод, НачатаТаблица, Выборка, Ложь, НаименованиеОператора);
		Иначе	//Сообщение отправил оператор
			СтрокаЧата = СформироватьСтрокуШтмлСообщенияЛиды(ОбработкаОК, ПредыдущаяДатаСообщения, ПредыдущийВывод, НачатаТаблица, Выборка, Истина, НаименованиеОператора);
		КонецЕсли;
		ТекстПоля = ТекстПоля + СтрокаЧата;
	КонецЦикла;
	
	Если НачатаТаблица Тогда
		ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/TABLE", 2);
	КонецЕсли;
	
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/BODY", 1);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/HTML", 0);
	
	Возврат ТекстПоля;	
КонецФункции

&НаКлиенте
Процедура ОтправитьОтветПисьмоНажатие()
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
		Если ЗначениеЗаполнено(ОтветПисьмо) Тогда
			ОтправкаУспешна = Ложь;
			
			ДанныеОФайлах = Новый Массив;
			Для Каждого Вложение ИЗ Вложения Цикл
				Файл = Новый Файл(Вложение.ИмяФайлаНаКомпьютере);
				Расширение = Сред(Файл.Расширение, 2);
				Данные = Новый ДвоичныеДанные(Вложение.ИмяФайлаНаКомпьютере);
				
				ДанныеОФайлахСтрока = Новый Структура("Данные, Расширение", Данные, Расширение);
				ДанныеОФайлах.Добавить(ДанныеОФайлахСтрока);
			КонецЦикла;
			
			ОтправкаУспешна = ПолучитьЗначениеОтправкиПочта(ДанныеОФайлах, ВыбранныйТрафикID, ОтветПисьмо, ЯщикОтправки);		
			
			Если ОтправкаУспешна Тогда
				Элементы.НадписьОтветПисьмо.Заголовок = "Ответ: Ответ отправлен";
			Иначе
				Предупреждение("Не удалось отправить сообщение");
				Возврат;
			КонецЕсли;
			
			ЗаписатьОтветВТрафик(ВыбранныйТрафикID, ОтветПисьмо, ОтправкаУспешна);
			
			ОтветПисьмо = "";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеОтправкиПочта(ДанныеОФайлах, Ид, ОтветПисьмо, ЯщикОтправки)
	ТаблицаВложений = Новый ТаблицаЗначений;
	ТаблицаВложений.Колонки.Добавить("Данные");
	ТаблицаВложений.Колонки.Добавить("Расширение");
	Для Каждого СтрокаДанныеОФайлах ИЗ ДанныеОФайлах Цикл
		НоваяСтрокаВложения = ТаблицаВложений.Добавить();
		НоваяСтрокаВложения.Данные = СтрокаДанныеОФайлах.Данные;
		НоваяСтрокаВложения.Расширение = СтрокаДанныеОФайлах.Расширение;
	КонецЦикла;
	
	ОтправкаУспешна = Renault_ОнлайнКонсультант.ОтправитьПисьмоКлиентуОКВебСервис(ОтветПисьмо, Ид, ТаблицаВложений, ЯщикОтправки);

	Возврат ОтправкаУспешна;
КонецФункции

&НаКлиенте
Процедура ЗакрытьТрафикПисьмо()
	Если НЕ ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID) Тогда 		
		ОпОповещения = Новый ОписаниеОповещения("ЗакрытьТрафикПисьмоЗавершение", ЭтаФорма);
		ОткрытьФорму("Справочник.Renault_РезультатОбработки.Форма.ФормаВыбораУпр",, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе		
		ЗакрытьТрафик(ВыбранныйТрафикID, ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.ОтветОтправлен"), ТипВыбранногоТрафика);
		
		НачальноеОтображаениеЧатаИДанныхКлиента();
	КонецЕсли;
	
	ОбновитьСписокТрафика(); 
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьТрафикПисьмоЗавершение(ВыбранноеЗначение, ДопПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.ОтветОтправлен") Тогда
		Если НЕ ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID) Тогда
			Сообщить("Необходим ответ на лид/письмо");
			Возврат;
		КонецЕсли;
	ИначеЕсли ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.ПомеченКакСпам") Тогда
		Если НЕ ЗначениеЗаполнено(Email) Тогда
			Сообщить("У клиента отсутсвует электронная почта");
			Возврат;
		КонецЕсли;
		
		ЗаписатьЗаблокированныйТрафик(ВыбранныйТрафикID, Email);
	КонецЕсли;
	
	ЗакрытьТрафик(ВыбранныйТрафикID, ВыбранноеЗначение, ТипВыбранногоТрафика);
	
	НачальноеОтображаениеЧатаИДанныхКлиента();
	
	ОбновитьСписокТрафика();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРабочийЛистПисьмо()
	Если НЕ ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID) Тогда
		Сообщить("Создание рабочего листа возможно только после отправки ответа");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Менеджер) Тогда
		Сообщить("Создание рабочего листа возможно после выбора менеджера");
		Возврат;
	КонецЕсли;
	
	Если РабочийЛистСуществует(ВыбранныйТрафикID) Тогда
		Сообщить("По данному трафику уже существует рабочий лист");
		Возврат;
	КонецЕсли;
	
	РЛ = Renault_КонтактЦентр_Общий.СоздатьРабочийЛистПоТрафику(ВыбранныйТрафикID);
	Если Не(РЛ = Неопределено) Тогда 
		Форм = РЛ.ПолучитьФорму("ФормаЗаписи", , "ФормаЗаписи" + Строка(РЛ.IDK));
		Если Форм.Открыта() Тогда
			Форм.Активизировать();
		Иначе
			Форм.Открыть();
		КонецЕсли;
		
		ЗакрытьТрафик(ВыбранныйТрафикID, ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.СозданРабочийЛист"), ТипВыбранногоТрафика);
		
		НачальноеОтображаениеЧатаИДанныхКлиента();
		
		ОбновитьСписокТрафика();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьВложениеНажатие()
	ДанныеДляЗаполнения = Новый Массив();
	
	Для Каждого Стр Из Вложения Цикл
		ДанныеДляЗаполнения.Добавить(Стр.ИмяФайлаНаКомпьютере);	
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("ДанныеДляЗаполнения", ДанныеДляЗаполнения);
	ОпОповещения = Новый ОписаниеОповещения("ПрикрепитьВложениеНажатиеЗавершение", ЭтаФорма);
	ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаВложенийУпр", ПараметрыФормы, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьВложениеНажатиеЗавершение(ДанныеОВложениях, ДопНастройки) Экспорт
	Если ДанныеОВложениях = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Вложения.Очистить();
	
	Для Каждого Эл Из ДанныеОВложениях Цикл
		Стр = Вложения.Добавить();
		Стр.ИмяФайлаНаКомпьютере = Эл; 
	КонецЦикла;	
	
	Если Вложения.Количество() <> 0 Тогда
		Элементы.НадписьПисьмоИнфо.Видимость = Истина;
	Иначе
		Элементы.НадписьПисьмоИнфо.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПисьмоПоШаблону()
	ОпОповещения = Новый ОписаниеОповещения("ЗаполнитьПисьмоПоШаблонуЗавершение", ЭтаФорма);
	ОткрытьФорму("Справочник.Renault_ШаблоныОтветов.Форма.ФормаВыбораУпр",, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПисьмоПоШаблонуЗавершение(ВыбранноеЗначение, ДопПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault") Тогда
		ОтветЛиду = ЗаполнитьПоШаблону(ВыбранноеЗначение.ШаблонОтвета);
		ТемаПисьма = ВыбранноеЗначение.ШаблонЗаголовка;
	ИначеЕсли ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
		ОтветПисьмо = ЗаполнитьПоШаблону(ВыбранноеЗначение.ШаблонОтвета);
		ТемаПисьма = ВыбранноеЗначение.ШаблонЗаголовка;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЛид()
	ДанныеДляСохранения = Новый Структура();
	ДанныеДляСохранения.Вставить("ВыбранныйТрафикID", ВыбранныйТрафикID);
	ДанныеДляСохранения.Вставить("ЛидVIN", ЛидVIN);
	ДанныеДляСохранения.Вставить("ЛидМодель", ЛидМодель);
	ДанныеДляСохранения.Вставить("ЛидПробег", ЛидПробег);
	ДанныеДляСохранения.Вставить("ЛидТипДвигателя", ЛидТипДвигателя);
	ДанныеДляСохранения.Вставить("Комментарий", Комментарий);
	ДанныеДляСохранения.Вставить("ЛидИсточник", ЛидИсточник);
	ДанныеДляСохранения.Вставить("ЛидАдрес", ЛидАдрес);
	ДанныеДляСохранения.Вставить("ЛидГород", ЛидГород);
	ДанныеДляСохранения.Вставить("ЛидСообщение", ЛидСообщение);

	СохранитьЛидСервер(ДанныеДляСохранения);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьЛидСервер(ДанныеДляСохранения)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_Лид.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Renault_Лид КАК Renault_Лид
	|ГДЕ
	|	Renault_Лид.Проведен
	|	И Renault_Лид.ТрафикИД = &ИД";
	Запрос.УстановитьПараметр("ИД", ДанныеДляСохранения.ВыбранныйТрафикID);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектДок.VIN = ДанныеДляСохранения.ЛидVIN;
		ОбъектДок.Модель = ДанныеДляСохранения.ЛидМодель;
		ОбъектДок.Пробег = ДанныеДляСохранения.ЛидПробег;
		ОбъектДок.Мотор = ДанныеДляСохранения.ЛидТипДвигателя;
		ОбъектДок.Комментарий = ДанныеДляСохранения.Комментарий;
		ОбъектДок.ИсточникИнформации = ДанныеДляСохранения.ЛидИсточник;
		ОбъектДок.Адрес = ДанныеДляСохранения.ЛидАдрес;
		ОбъектДок.Город = ДанныеДляСохранения.ЛидГород;
		ОбъектДок.Сообщение = ДанныеДляСохранения.ЛидСообщение;
		ОбъектДок.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОтветЛида()
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault") Тогда
		Если ЗначениеЗаполнено(ОтветЛиду) Тогда
			ОтправкаУспешна = Ложь;
			ЕмаилКлиента = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(ВыбранныйКлиент);
			Если ЗначениеЗаполнено(ЕмаилКлиента) Тогда
				Попытка
					ДанныеОФайлах = Новый Массив;
					Для Каждого Вложение ИЗ Вложения Цикл
						Файл = Новый Файл(Вложение.ИмяФайлаНаКомпьютере);
						Расширение = Сред(Файл.Расширение, 2);
						Данные = Новый ДвоичныеДанные(Вложение.ИмяФайлаНаКомпьютере);
						
						ДанныеОФайлахСтрока = Новый Структура("Данные, Расширение", Данные, Расширение);
						ДанныеОФайлах.Добавить(ДанныеОФайлахСтрока);
					КонецЦикла;

					ОтправкаУспешна = ПолучитьЗначениеОтправки(ДанныеОФайлах, ВыбранныйТрафикID, ОтветЛиду, ЕмаилКлиента, ТемаПисьма, ЯщикОтправки); 					
				Исключение
					ОтправкаУспешна = ПраваПользователя.РазрешитьФиктивнуюОтправку;
				КонецПопытки;
				
				Если ОтправкаУспешна Тогда
					Элементы.НадписьОтветОтправлен.Заголовок = "Ответ: Ответ отправлен";
				Иначе
					Предупреждение("Не удалось отправить сообщение!");
					Возврат;
				КонецЕсли;
				
				ЗаписатьОтветВТрафик(ВыбранныйТрафикID, ОтветЛиду, ?(ПраваПользователя.РазрешитьФиктивнуюОтправку, Истина, ОтправкаУспешна));
				
				Если ОтправкаУспешна Тогда
					ОтветЛиду = "";
				КонецЕсли;
				
				ОбновитьСписокТрафика();
				
				ОбновитьЧат(); 
			Иначе
				Предупреждение("Не указан потчтовый адрес клиента!");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеОтправки(ДанныеОФайлах, Ид, ОтветЛиду, ЕмаилКлиента, ТемаПисьма, ЯщикОтправки)
	ТаблицаВложений = Новый ТаблицаЗначений;
	ТаблицаВложений.Колонки.Добавить("Данные");
	ТаблицаВложений.Колонки.Добавить("Расширение");
	Для Каждого СтрокаДанныеОФайлах ИЗ ДанныеОФайлах Цикл
		НоваяСтрокаВложения = ТаблицаВложений.Добавить();
		НоваяСтрокаВложения.Данные = СтрокаДанныеОФайлах.Данные;
		НоваяСтрокаВложения.Расширение = СтрокаДанныеОФайлах.Расширение;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_Лид.НомерЛида КАК НомерЛида,
	               |	Renault_Лид.ДилерскийЦентр.Бир_ЛМТ КАК Бир_ЛМТ
	               |ИЗ
	               |	Документ.Renault_Лид КАК Renault_Лид
	               |ГДЕ
	               |	Renault_Лид.ТрафикИД = &ТрафикИД";
				   Запрос.УстановитьПараметр("ТрафикИД", Ид);
	Результат = Запрос.Выполнить();
	
	ДопПараметры = Новый Структура;
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ДопПараметры.Вставить("НомерЛида", Выборка.НомерЛида);
		ДопПараметры.Вставить("BIR_LMT", Выборка.Бир_ЛМТ);
	Иначе
		ДопПараметры.Вставить("НомерЛида", "");
		ДопПараметры.Вставить("BIR_LMT", "");
	КонецЕсли;
	
	ДопПараметры.Вставить("Сотрудник", Строка(ПараметрыСеанса.Пользователь.Сотрудник));
	
	ОтправкаУспешна = Renault_ОнлайнКонсультант.ОтправитьОтветНаЛидВебСервис(ОтветЛиду, Ид, ЕмаилКлиента, ТемаПисьма, ТаблицаВложений, ДопПараметры, ЯщикОтправки.АдресПочтовогоЯщика);
	
	Возврат ОтправкаУспешна;
КонецФункции

&НаКлиенте
Процедура ОтправитьОтветЛидаПоТелефону()
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault") Тогда
		Если ЗначениеЗаполнено(ОтветЛиду) Тогда
			ЗаписатьОтветВТрафик(ВыбранныйТрафикID, ОтветЛиду, Истина, 5);      
			
			ОтветЛиду = "";
			
			ОбновитьСписокТрафика();
			
			ОбновитьЧат();
		КонецЕсли;
	КонецЕсли; 	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьОтветВТрафик(Ид, Текст, ОбработкаТрафика = Истина, вхВидСообщения = 2)
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	ОбработкаОК.ЗаписатьОтветВТрафик(Ид, Текст, ОбработкаТрафика, вхВидСообщения);
	ОбработкаОК.ОтметитьТрафикЛМТПочтаОтвеченным(Ид);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЛид()
	ОпОповещения = Новый ОписаниеОповещения("ЗаполнитьЛидЗавершение", ЭтаФорма);
	ОткрытьФорму("Справочник.Renault_ШаблоныОтветов.Форма.ФормаВыбораУпр",, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЛидЗавершение(ВыбранноеЗначение, ДопПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault") Тогда
		ОтветЛиду = ЗаполнитьПоШаблону(ВыбранноеЗначение.ШаблонОтвета);  
		ТемаПисьма = ВыбранноеЗначение.ШаблонЗаголовка;
	ИначеЕсли ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
		ОтветПисьмо = ЗаполнитьПоШаблону(ВыбранноеЗначение.ШаблонОтвета);
		ТемаПисьма = ВыбранноеЗначение.ШаблонЗаголовка;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПоШаблону(СтрокаШаблона)
	ПараметрыШаблона = ПолучитьЗначенияПараметров();   
	Ответ = СтрокаШаблона;
	
	Для Каждого Пар из ПараметрыШаблона Цикл
		Ответ = СтрЗаменить(Ответ, Пар.Представление, Пар.Значение);
	КонецЦикла;
	
	Возврат Ответ;
КонецФункции

&НаКлиенте
Функция ПолучитьЗначенияПараметров()
	
	ПараметрыШаблона = Новый СписокЗначений();
	Если ЗначениеЗаполнено(Клиент) Тогда
		ПараметрыШаблона.Добавить(Клиент.Наименование, "{Клиент}");
	Иначе
		ПараметрыШаблона.Добавить("клиент", "{Клиент}");
	КонецЕсли;
	
	ДЦ = Renault_КонтактЦентр_Общий.ПолучитьДилерскийЦентрПользователя();
	ДЦРеквизиты = Renault_ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДЦ, "Организация, Наименование");
	
	Если ЗначениеЗаполнено(ДЦ) Тогда
		ПараметрыШаблона.Добавить(ДЦРеквизиты.Наименование, "{Дилер}");
		Если ЗначениеЗаполнено(ДЦРеквизиты.Организация) Тогда
			Мен = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Мен.Вид = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресФактический");
			Мен.Тип = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес");
			Мен.Объект = ДЦРеквизиты.Организация;
			Мен.Прочитать();
			Если Мен.Выбран() Тогда
				ПараметрыШаблона.Добавить(Мен.Поле4, "{Город}");
			Иначе
				ПараметрыШаблона.Добавить(" ", "{Город}");
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		ПараметрыШаблона.Добавить(" ", "{Дилер}");
		ПараметрыШаблона.Добавить(" ", "{Город}");
	КонецЕсли;
	
	МенеджерНаименование = Renault_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Менеджер, "Наименование");
	Сотрудник = Renault_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыСеанса.Пользователь, "Сотрудник");
	СотрудникНаименование = Renault_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Наименование");

	Если ЗначениеЗаполнено(Менеджер) ИЛИ ЗначениеЗаполнено(Сотрудник) Тогда
		ПараметрыШаблона.Добавить(?(ЗначениеЗаполнено(Менеджер), МенеджерНаименование, СотрудникНаименование), "{Менеджер}");
		ПараметрыШаблона.Добавить(Renault_КонтактЦентр_Общий.ПолучитьТелефонКлиент(?(ЗначениеЗаполнено(Менеджер), Менеджер, Сотрудник)), "{Телефон}");
		ПараметрыШаблона.Добавить(Renault_КонтактЦентр_Общий.ПолучитьЕмаилКлиент(?(ЗначениеЗаполнено(Менеджер), Менеджер, Сотрудник)), "{Телефон}");
	Иначе
		ПараметрыШаблона.Добавить(" ", "{Менеджер}");
		ПараметрыШаблона.Добавить(" ", "{Телефон}");
		ПараметрыШаблона.Добавить(" ", "{Емаил}");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛидМодель) Тогда
		ПараметрыШаблона.Добавить(ЛидМодель, "{Модель}");
	Иначе
		ПараметрыШаблона.Добавить(" ", "{Модель}");
	КонецЕсли;
	
	Возврат ПараметрыШаблона; 	
КонецФункции

&НаКлиенте
Процедура ВложенияНажатие()
	ДанныеДляЗаполнения = Новый Массив();
	
	Для Каждого Стр Из Вложения Цикл
		ДанныеДляЗаполнения.Добавить(Стр.ИмяФайлаНаКомпьютере);	
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("ДанныеДляЗаполнения", ДанныеДляЗаполнения);
	ОпОповещения = Новый ОписаниеОповещения("ВложенияНажатиеЗавершение", ЭтаФорма);
	ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаВложенийУпр", ПараметрыФормы, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ВложенияНажатиеЗавершение(ДанныеОВложениях, ДопПараметры) Экспорт
	Если ДанныеОВложениях = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Вложения.Очистить();
	
	Для Каждого Эл Из ДанныеОВложениях Цикл
		Стр = Вложения.Добавить();
		Стр.ИмяФайлаНаКомпьютере = Эл; 
	КонецЦикла;	
	
	Если Вложения.Количество() <> 0 Тогда
		Элементы.НадписьЛидИнфо.Видимость = Истина;
	Иначе
		Элементы.НадписьЛидИнфо.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьТрафикЛид()
	 Если НЕ ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID) Тогда   		
		ОпОповещения = Новый ОписаниеОповещения("ЗакрытьТрафикЛидЗавершение", ЭтаФорма);
		ОткрытьФорму("Справочник.Renault_РезультатОбработки.Форма.ФормаВыбораУпр",, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе  		
		ЗакрытьТрафик(ВыбранныйТрафикID, ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.ОтветОтправлен"), ТипВыбранногоТрафика);
		
		НачальноеОтображаениеЧатаИДанныхКлиента();
		
		ОбновитьСписокТрафика();
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьТрафикЛидЗавершение(ВыбранноеЗначение, ДопПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.ОтветОтправлен") Тогда
		Если НЕ ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID) Тогда
			Сообщить("Необходим ответ на лид/письмо");
			Возврат; 
		КонецЕсли;
	ИначеЕсли ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.ПомеченКакСпам") Тогда
		Если НЕ ЗначениеЗаполнено(Email) Тогда
			Сообщить("У клиента отсутсвует электронная почта");
			Возврат;
		КонецЕсли;
		
		ЗаписатьЗаблокированныйТрафик(ВыбранныйТрафикID, Email);
	КонецЕсли; 	
	
	ЗакрытьТрафик(ВыбранныйТрафикID, ВыбранноеЗначение, ТипВыбранногоТрафика);
	
	НачальноеОтображаениеЧатаИДанныхКлиента();	

	ОбновитьСписокТрафика();  
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьЗаблокированныйТрафик(ВыбранныйТрафикID, Email)
	Мен = РегистрыСведений.Renault_ЗаблокированныйТрафик.СоздатьМенеджерЗаписи();
	Мен.Идентификатор = Новый УникальныйИдентификатор;
	Мен.IDТрафика = ВыбранныйТрафикID;
	Мен.ЭлектронныйАдрес = Email;
	Мен.ПризнакБлокировки = 1;
	Мен.Записать();	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРабочийЛистЛид()
	Если НЕ ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID) Тогда   //!1
		Сообщить("Создание рабочего листа возможно только после отправки ответа");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Менеджер) Тогда
		Сообщить("Создание рабочего листа возможно после выбора менеджера"); Возврат;
	КонецЕсли;
	
	Если РабочийЛистСуществует(ВыбранныйТрафикID) Тогда
		Сообщить("По данному трафику уже существует рабочий лист");
		Возврат;
	КонецЕсли;
	
	РЛ = Renault_КонтактЦентр_Общий.СоздатьРабочийЛистПоТрафику(ВыбранныйТрафикID);
	Если НЕ (РЛ = Неопределено) Тогда 
		Форм = РЛ.ПолучитьФорму("ФормаЗаписи", , "ФормаЗаписи" + Строка(РЛ.IDK));
		Если Форм.Открыта() Тогда
			Форм.Активизировать();
		Иначе
			Форм.Открыть();
		КонецЕсли;	
		          
		ЗакрытьТрафик(ВыбранныйТрафикID, ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.СозданРабочийЛист"), ТипВыбранногоТрафика);
		
		НачальноеОтображаениеЧатаИДанныхКлиента();
		
		ОбновитьСписокТрафика();
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID)
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	Возврат ОбработкаОК.ТрафикЛМТПочтаОтвеченный(ВыбранныйТрафикID);
КонецФункции

&НаКлиенте
Процедура СохранитьОтветНаЛидНажатие()
	СохранитьОтветНаЛид(ВыбранныйТрафикID, ОтветЛиду);	
КонецПроцедуры

