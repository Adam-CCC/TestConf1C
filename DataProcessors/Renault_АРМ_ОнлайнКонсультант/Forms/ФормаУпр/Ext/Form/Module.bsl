&НаКлиенте
Перем МассивBIR, ФормаДлительнойОперации,
ПеретаскиваемаяСтрока;

/////////////////////////////////////////////////////////////////////События формы///////////////////////////////////////////////////////////////////
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЕстьПравоАдминистратора = Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмКонтактЦентрАдминистратор(ПараметрыСеанса.Пользователь);
	ЕстьПравоМенеджера = Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмКонтактЦентрМенеджер(ПараметрыСеанса.Пользователь);
	Отказ = НЕ (Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмКонтактЦентр(ПараметрыСеанса.Пользователь) И
			(ЕстьПравоАдминистратора ИЛИ ЕстьПравоМенеджера));
	Бренд = ПараметрыСеанса.DMS_Бренд;
	
	Если Бренд <> Справочники.CRM_МаркаАвтомобиля.RENAULT Тогда
		Элементы.кнОткрытьMyRenault.Видимость = Ложь;
		Элементы.кнОткрытьMyRenaultАтрибутыПисьма.Видимость = Ложь;
		Элементы.кнОткрытьMyRenaultЛид.Видимость = Ложь;
    КонецЕсли;
	
	БрендНаименование = Бренд.Наименование;
	Если БрендНаименование <> "" Тогда
		Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[БрендНаименование];
	Иначе
		Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных.RENAULT;
	КонецЕсли;
	
	ПарольWS = Настройки.ПарольДоступаКВебСервисам;
	ЛогинWS = Настройки.ЛогинДоступаКВебСервисам;
	
	ОтборПериод.ДатаНачала = НачалоДня(ТекущаяДата());
	ОтборПериод.ДатаОкончания = КонецДня(ТекущаяДата()); 
	
	Если Отказ тогда
		Сообщить("Пользователь не может работать с онлайн консультантом");
	иначе
		ПараметрыОК = Renault_ОнлайнКонсультант.ПолучитьНастройкиОнлайнКонсультант(Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь));
		Если (ПараметрыОК = Неопределено) ИЛИ 
			(ПараметрыОК  = Справочники.Renault_НастройкиОнлайнКонсультанта.ПустаяСсылка())Тогда
			Отказ = Истина;
			Сообщить("Нет настроек подключения к ОнлайнКонсультанту");
		КонецЕсли;
	КонецЕсли;
	
	//Порядок элементов списка должен соответствовать порядку кнопок в подразделе "грКнопкиМеню"
	ПунктыМеню.Добавить("ЧатОбщение");
	ПунктыМеню.Добавить("АтрибутыТрафика");
	ПунктыМеню.Добавить("ЛидРено");
	ПунктыМеню.Добавить("АтрибутыЛида");  	
	ПунктыМеню.Добавить("Письмо");
	ПунктыМеню.Добавить("АтрибутыПисьма");
	ПунктыМеню.Добавить("История");
	ПунктыМеню.Добавить("РабочиеЛисты");
	
	ТекущаяЗакладкаМеню = 0;
	
	ТаблицаСтатусыОформление();
	ТаблицаТрафикаОформление();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НачальноеОформлениеФормы();
	
	СтатусОператора = Ложь;
	
	Если ЕстьПравоАдминистратора Тогда
		ВыборТрафика = 1; 
	Иначе
		Элементы.кнОтобразитьОткрытыйТрафик.Видимость = Ложь;
		ВыборТрафика = 2;
	КонецЕсли;
	
	ПраваПользователя = ПараметрыСеанса.Renault_ПраваПользователя;
	// Изменение системы прав
	НастройкиКонтактЦентра = ПраваПользователя.ПраваИНастройки.КонтактЦентр.Выгрузить();
	
	// Настройка отображения списка
	СтруктураНастроекСписка = Новый Структура;
	ОтображаемыеТипыТрафика = Новый Структура;
	ОтображаемыеТипыТрафика.Вставить("ПоказыватьОК", Истина);
	ОтображаемыеТипыТрафика.Вставить("ПоказыватьПочту", Истина);
	ОтображаемыеТипыТрафика.Вставить("ПоказыватьЛиды", Истина);
	СтруктураНастроекСписка.Вставить("ОтображаемыеТипыТрафика", ОтображаемыеТипыТрафика);
	СтруктураНастроекСписка.Вставить("ВыводитьВсеНеобработанные", Истина);
	
	ПоказыватьУведомления = Ложь;
	ПоказыватьУведомления();
	ДатаПоследнегоСообшения = Неопределено;
	ИдетОбновлениеСпискаТрафика = Ложь;
	
	МассивBIR = Новый Массив;
	НастройкиПодключенияКОнлайнКонсультанту = Renault_ОнлайнКонсультант.ПолучитьПараметрыПоУмолчанию(Renault_КонтактЦентр_Общий.ПолучитьДилерскийЦентрПользователя());
	НастройкиОтправки = Renault_КонтактЦентр_Общий.ПолучитьНастройкиОтправкиКП(ПараметрыСеанса.Пользователь.Сотрудник);
	РассылкаУчетнаяЗапись = НастройкиОтправки.УчетнаяЗапись;
	
	Если ЗначениеЗаполнено(ПараметрыОК.ИмяОператора) Тогда
		НаименованиеОператора = ПараметрыОК.ИмяОператора;
	Иначе
		НаименованиеОператора = "Renault contact center";
	КонецЕсли;
	
	Если Объект.РежимРаботыОбработки = ПредопределенноеЗначение("Перечисление.Renault_ОнлайнКонсультант_РежимыРаботы.ЧатСКлиентом") Тогда
		ВыборТрафика = 2;
		Элементы.кнУстановитьОтделПродаж.Видимость = Ложь;
		Элементы.ТаблицаСтатусы.Видимость = Ложь;
	КонецЕсли;
	
	Если ПраваПользователя.РаботаетОнлайнКонсультант Тогда		
		Отбор = Новый Структура;
		Отбор.Вставить("ВидимостьОбщий", Истина);
		Отбор.Вставить("ТипТрафика", ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант"));
		МассивСтрок = НастройкиКонтактЦентра.НайтиСтроки(Отбор);
		
		Для Каждого Элемент ИЗ МассивСтрок Цикл
			BIR = Renault_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.ДилерскийЦентр, "BIR");
			Если ЗначениеЗаполнено(BIR) Тогда
				МассивBIR.Добавить(BIR);
			КонецЕсли;
		КонецЦикла;
		
		ПодключитьКонсультант(); 
		МодульОбъектаЗаполнитьНастройкиПодключения(); 
		
		ОбновитьСтатусСотрудника(ПредопределенноеЗначение("Перечисление.Renault_КонтактЦентр_СтатусыСотрудников.online"));		
	КонецЕсли; 
	
	КартинкаЛИД = БиблиотекаКартинок.Renault_lead;
	КартинкаПисьмо = БиблиотекаКартинок.Renault_mail_lead;
	КартинкаЧат = БиблиотекаКартинок.Renault_chat_lead;  
	
	ОтборОтдел = Renault_КонтактЦентр_Общий.ПолучитьОтделАвтосалона();
	ОбновитьСписокСотрудников(ОтборОтдел);
	ОбновитьСписокТрафика();
	ОтметитьТекущийВидТрафика(); 
	ОбновитьЧат(); 
	ПодключитьОбработчикОжидания("ОбновитьСписокТрафика", 5);
	
	//Позиционирование на нужной строке
	Если ЗначениеЗаполнено(Объект.вхИдТрафика) Тогда
		ПредСтрТрафика = ТаблицаТрафика.Найти(Объект.вхИдТрафика, "Идентификатор");
		Если ЗначениеЗаполнено(ПредСтрТрафика) Тогда
			Элементы.ТаблицаТрафика.ТекущаяСтрока = ПредСтрТрафика;
			ТипВыбранногоТрафика = ПредСтрТрафика.ТипТрафика;
			ТекущийДЦ = ПредСтрТрафика.ДилерскийЦентр;
			ВыбранныйКлиент = ПредСтрТрафика.Клиент;
		КонецЕсли;
		ВыбранныйТрафикID = Объект.вхИдТрафика;
		ТаблицаКлиентовВыбор(Неопределено, Неопределено, "", Неопределено);  
	КонецЕсли;
	
	ТаблицаПеренаправленногоТрафика = Новый ТаблицаЗначений;
	ТаблицаПеренаправленногоТрафика.Колонки.Добавить("ИдентификаторТрафика", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(40)));
	ТаблицаПеренаправленногоТрафика.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	
	Вложения = Новый ТаблицаЗначений;
	Вложения.Колонки.Добавить("ИмяФайлаНаКомпьютере");
	
	Если Переключатель = 0 Тогда
		Элементы.кнОтправитьОтветЛида.Видимость = Истина;
		Элементы.кнОтправитьОтветЛидаПоТелефону.Видимость = Ложь;
	Иначе
		Элементы.кнОтправитьОтветЛида.Видимость = Ложь;
		Элементы.кнОтправитьОтветЛидаПоТелефону.Видимость = Истина;
	Конецесли;    	
		
	УправлениеМеню();
	СформироватьЗаголовокФормы();
КонецПроцедуры   

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если ПраваПользователя.РаботаетОнлайнКонсультант Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ВидимостьОбщий", Истина);
		Отбор.Вставить("ТипТрафика", ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант"));
		МассивСтрок = НастройкиКонтактЦентра.НайтиСтроки(Отбор);
		
		Для Каждого Элемент ИЗ МассивСтрок Цикл
			BIR = Renault_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.ДилерскийЦентр, "BIR");
			Если ЗначениеЗаполнено(BIR) Тогда
				Попытка
					Renault_ОнлайнКонсультант.ОтключитьКонсультантаВебСервис(BIR);
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		ОбновитьСтатусСотрудника(ПредопределенноеЗначение("Перечисление.Renault_КонтактЦентр_СтатусыСотрудников.offline"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьЧатОнлайнКонсультанта" Тогда
		ОбновитьЧат();
	КонецЕсли;
КонецПроцедуры

//////////////////////////////////////////////////////////////////////Команды Формы///////////////////////////////////////////////////////////////
&НаКлиенте
Процедура НажатиеКнопкиШапки(Команда)
	ИмяТекущийЭлемент = ТекущийЭлемент.Имя;
	
	Если ИмяТекущийЭлемент = "кнУстановитьОтделПродаж" Тогда
		ВыбратьОтделПродаж(); 		
	ИначеЕсли ИмяТекущийЭлемент = "кнОткрытьНастройки" Тогда
		ОткрытьНастройки();	
	ИначеЕсли ИмяТекущийЭлемент = "кнПоказыватьУведомления" Тогда
		ПоказыватьУведомления();
	ИначеЕсли ИмяТекущийЭлемент = "кнПериодОтбора" Тогда
		ВыбратьПериод();
	ИначеЕсли ИмяТекущийЭлемент = "кнПодключитьОнлайн" Тогда
		ПодключитьОнлайн();
	ИначеЕсли ИмяТекущийЭлемент = "кнОбновитьСписокТрафика" Тогда
		кнОбновитьСписокТрафика();	
	ИначеЕсли ИмяТекущийЭлемент = "кнБлокировки" Тогда
		ОткрытьБлокировки();
	КонецЕсли; 
КонецПроцедуры  

&НаКлиенте
Процедура НажатиеКнопкиМенюСредняяЧасть(Команда)
	ПунктыМенюКоличество = ПунктыМеню.Количество();
	Для Н = 0 По ПунктыМенюКоличество - 1 Цикл
		Если Найти(ТекущийЭлемент.Имя, ПунктыМеню[Н].Значение) > 0 Тогда 
			ТекущаяЗакладкаМеню = Н;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если ТекущаяЗакладкаМеню = 6 Тогда
		СформироватьИсторию();
	КонецЕсли;
	
	УправлениеМеню(); 
КонецПроцедуры

&НаКлиенте
Процедура НажатиеКнопкиСредняяЧасть(Команда)
	ИмяТекущийЭлемент = ТекущийЭлемент.Имя;
	
	Если ИмяТекущийЭлемент = "кнЗаполнитьЧат" Тогда
		ЗаполнитьЧат();
	ИначеЕсли ИмяТекущийЭлемент = "кнОтправитьВЧат" Тогда
		ОтправитьВЧат();
	ИначеЕсли ИмяТекущийЭлемент = "кнСоздатьРабочийЛист" Тогда
		СоздатьРабочийЛист();
	ИначеЕсли ИмяТекущийЭлемент = "кнЗавершитьРазговор" Тогда
		ЗавершитьРазговор();
	ИначеЕсли ИмяТекущийЭлемент = "кнЧатМенеджер" ИЛИ
		ИмяТекущийЭлемент = "кнЛидМенеджер" ИЛИ 
		ИмяТекущийЭлемент = "кнПисьмоМенеджер" Тогда
		НазначитьНаМенеджера();
	ИначеЕсли ИмяТекущийЭлемент = "кнНеВозвращатьТрафик" Тогда
		НеВозвращатьТрафикНажатие();
	ИначеЕсли ИмяТекущийЭлемент = "кнОткрытьMyRenault" ИЛИ
		ИмяТекущийЭлемент = "кнОткрытьMyRenaultЛид" ИЛИ
		ИмяТекущийЭлемент = "кнОткрытьMyRenaultАтрибутыПисьма" Тогда
		РегистрацияВMyRenault(); 
	ИначеЕсли ИмяТекущийЭлемент = "кнСохранить" Тогда
		СохранитьОтветНаЛидНажатие(); 	
	ИначеЕсли ИмяТекущийЭлемент = "кнСоздатьРЛ" Тогда
		СоздатьРабочийЛистЛид();
	ИначеЕсли ИмяТекущийЭлемент = "кнЗакрытьТрафик" Тогда
		ЗакрытьТрафикЛид();
	ИначеЕсли ИмяТекущийЭлемент = "кнВложения" Тогда
		ВложенияНажатие();
	ИначеЕсли ИмяТекущийЭлемент = "кнЗаполнить" Тогда
		ЗаполнитьЛид(); 
	ИначеЕсли ИмяТекущийЭлемент = "кнОтправитьОтветЛидаПоТелефону" Тогда
	    ОтправитьОтветЛидаПоТелефону();
	ИначеЕсли ИмяТекущийЭлемент = "кнОтправитьОтветЛида" Тогда
		ОтправитьОтветЛида();
	ИначеЕсли ИмяТекущийЭлемент = "кнСохранитьЛид" Тогда
	    СохранитьЛид();
	ИначеЕсли ИмяТекущийЭлемент = "кнЗаполнитьПисьмоПоШаблону" Тогда
	    ЗаполнитьПисьмоПоШаблону();
	ИначеЕсли ИмяТекущийЭлемент = "кнПрикрепитьВложение" Тогда
		ПрикрепитьВложениеНажатие();
	ИначеЕсли ИмяТекущийЭлемент = "кнСоздатьРЛПисьмо" Тогда
	    СоздатьРабочийЛистПисьмо();
	ИначеЕсли ИмяТекущийЭлемент = "кнЗакрытьТрафикПисьмо" Тогда
	    ЗакрытьТрафикПисьмо();
	ИначеЕсли ИмяТекущийЭлемент = "кнОтправитьОтветПисьмо" Тогда
	    ОтправитьОтветПисьмоНажатие();		
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура НажатиеКнопкиДобавитьНапоминание(Команда)
	ТекСтрока = Элементы.ТаблицаТрафика.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ПараметрыФормы = Новый Структура("Наименование, Идентификатор",
			"Напоминание в онлайн консультант", ТекСтрока.Идентификатор);
		
		ОткрытьФорму("Обработка.Renault_СозданиеБыстрогоНапоминания.Форма.ФормаСообщенияУпр", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НажатиеКнопкиОтобразитьЗакрытыйТрафик(Команда)
	ОтобразитьЗакрытыйТрафик();
КонецПроцедуры

&НаКлиенте
Процедура НажатиеКнопкиОтобразитьОткрытыйТрафик(Команда)
	ОтобразитьОткрытыйТрафик();
КонецПроцедуры

&НаКлиенте
Процедура НажатиеКнопкиОтобразитьОткрытыйТрафикМенеджеров(Команда)
	ОтобразитьОткрытыйТрафикМенеджеров();
КонецПроцедуры

////////////////////////////////////////////////////////////////////События элементов формы///////////////////////////////////
&НаКлиенте
Процедура ТаблицаСтатусыПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ПеретаскиваемаяСтрока = Строка;  
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТрафикаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ТаблицаТрафика.Количество() > 0 Тогда 		
		Если Элементы.ТаблицаТрафика.ТекущиеДанные <> Неопределено Тогда			
			//Выделили конкретную строку
			Объект.ИдПользователя = Элементы.ТаблицаТрафика.ТекущиеДанные.id_user;
			Клиент = Элементы.ТаблицаТрафика.ТекущиеДанные.Клиент;
			ВыбранныйТрафикID = Элементы.ТаблицаТрафика.ТекущиеДанные.Идентификатор;
			ТипВыбранногоТрафика = Элементы.ТаблицаТрафика.ТекущиеДанные.ТипТрафика;
			ТекущийДЦ = Элементы.ТаблицаТрафика.ТекущиеДанные.ДилерскийЦентр;
			ВыбранныйКлиент = Элементы.ТаблицаТрафика.ТекущиеДанные.Клиент; 			
		Иначе 			
			//Ничего не выделили, возьмем первую (теоретически, такого не может быть)
			Объект.ИдПользователя = ТаблицаТрафика[0].id_user;
			Клиент = ТаблицаТрафика[0].Клиент;
			ВыбранныйТрафикID = ТаблицаТрафика[0].Идентификатор;
			ТипВыбранногоТрафика = ТаблицаТрафика[0].ТипТрафика;
			ТекущийДЦ = ТаблицаТрафика[0].ДилерскийЦентр;
			ВыбранныйКлиент =  ТаблицаТрафика[0].Клиент;    			
		КонецЕсли;
		
		ОбновитьСписокТрафика();  		
		ПрочитатьДанныеКлиента();
		ОбновитьЧат();
		
		Вложения.Очистить();
		
		Элементы.НадписьПисьмоИнфо.Видимость = Ложь;
		Элементы.НадписьЛидИнфо.Видимость = Ложь;  
		
		Элементы.грЛеваяКолонка.Доступность = Истина;
	КонецЕсли; 
КонецПроцедуры

