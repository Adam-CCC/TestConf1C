КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьСтатусСотрудника(Статус) Экспорт
	ТекДата = ТекущаяДата();
	ТекСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
	
	Набор = РегистрыСведений.Renault_КонтактЦентр_СтатусыСотрудников.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(ТекДата);
	Набор.Отбор.Сотрудник.Установить(ТекСотрудник);
	Набор.Очистить();
	
	Запись = Набор.Добавить();
	Запись.Период = ТекДата;
	Запись.Сотрудник = ТекСотрудник;
	Запись.Статус = Статус;
	Набор.Записать();  	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокТрафика() Экспорт
	ТекСтрокаТрафика = Элементы.ТаблицаТрафика.ТекущиеДанные;
	Если ТекСтрокаТрафика <> Неопределено Тогда
		ТекИдТрафика = ТекСтрокаТрафика.Идентификатор;
	Иначе
		ТекИдТрафика = Неопределено;
	КонецЕсли;
	//Обновление списка трафика
	
	ДанныеНКЦ = Новый Массив();
	КолонкиНастройкиКонтактЦентра = НастройкиКонтактЦентра.Колонки;
	Для Каждого Эл Из НастройкиКонтактЦентра Цикл
		СтрокаДанныхНКЦ = Новый Структура();
		Для Каждого Стр Из КолонкиНастройкиКонтактЦентра Цикл
			СтрИмя = Стр.Имя;
			СтрокаДанныхНКЦ.Вставить(СтрИмя, Эл[СтрИмя]); 			
		КонецЦикла;
		
		ДанныеНКЦ.Добавить(СтрокаДанныхНКЦ);
	КонецЦикла;
	
	Если ВыборТрафика = 1 Тогда		
		ДатаОбновления = ТекущаяДата();   
		ДанныеТрафика = ПолучитьТаблицуОткрытогоТрафика(СтруктураНастроекСписка, ДанныеНКЦ, ПраваПользователя,  НачалоДня(ОтборПериод.ДатаНачала), КонецДня(ОтборПериод.ДатаОкончания));
		
		ТаблицаТрафика.Очистить();
		Для Каждого Эл Из ДанныеТрафика Цикл
			Стр = ТаблицаТрафика.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, Эл);
		КонецЦикла;
		
		ПроставитьКартинкиТаблицаТрафик();
		
		//Покажем сообщение, если нужно
		Если ПоказыватьУведомления И ТаблицаТрафика.Количество() > 0 Тогда  			
			ДатаПоследнегоСообщенияВТаблице = ПолучитьДатуПоследнегоСообщения(ДанныеТрафика);  		
			
			Если ДатаПоследнегоСообщения <> Неопределено И ДатаПоследнегоСообщенияВТаблице > ДатаПоследнегоСообщения Тогда
				ПоказатьУведомлениеОНовомСообщении();  
			КонецЕсли;
			ДатаПоследнегоСообщения = ДатаПоследнегоСообщенияВТаблице; 
		КонецЕсли;  		
	ИначеЕсли ВыборТрафика = 2 Тогда
		ДатаОбновления = ТекущаяДата();  
		ДанныеТрафика = ПолучитьТаблицуОткрытогоТрафикаПоМенеджерам(СтруктураНастроекСписка, ДанныеНКЦ, ПраваПользователя, НачалоДня(ОтборПериод.ДатаНачала), КонецДня(ОтборПериод.ДатаОкончания), Истина);
		
		ТаблицаТрафика.Очистить();
		Для Каждого Эл Из ДанныеТрафика Цикл
			Стр = ТаблицаТрафика.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, Эл);
		КонецЦикла;
		
		ПроставитьКартинкиТаблицаТрафик();
	Иначе		
		ДанныеТрафика = ПолучитьТаблицуЗакрытогоТрафика(СтруктураНастроекСписка, ДанныеНКЦ, ПраваПользователя, НачалоДня(ОтборПериод.ДатаНачала), КонецДня(ОтборПериод.ДатаОкончания), ЕстьПравоАдминистратора, ЕстьПравоМенеджера);
		
		ТаблицаТрафика.Очистить();
		Для Каждого Эл Из ДанныеТрафика Цикл
			Стр = ТаблицаТрафика.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, Эл);
		КонецЦикла;
		
		ПроставитьКартинкиТаблицаТрафик();
	КонецЕсли;
	
	ОбновитьЗаголовокКнопокТрафика(); 
	
	//Восстановим фокус на выделенной до обновления строке	
	Строки = ТаблицаТрафика.НайтиСтроки(Новый Структура("Идентификатор", ТекИдТрафика));	
	Если Строки.Количество() > 0 Тогда
		ПредСтрТрафика = Строки[0];   		
		Элементы.ТаблицаТрафика.ТекущаяСтрока = ПредСтрТрафика.ПолучитьИдентификатор();
	КонецЕсли;
	Элементы.ТаблицаТрафикаРезультатОбработки.Видимость = ВыборТрафика = 0; 	
КонецПроцедуры  

&НаКлиенте
Функция ПолучитьДатуПоследнегоСообщения(ДанныеТрафика)  	
	ДатаПС = ДанныеТрафика[0].Время;
	
	Для Каждого Эл Из ДанныеТрафика Цикл
		ДатаПС = Макс(Эл.Время, ДатаПС);
	КонецЦикла;
		
	Возврат  ДатаПС;   	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТаблицуОткрытогоТрафика(СтруктураНастроекСписка, ДанныеНКЦ, ПраваПользователя, НачалоПериода, КонецПериода, ПоказатьТрафикПоМенеджерам = Ложь)
	ТабДанныеНКЦ = Новый ТаблицаЗначений;
	СтрокаДанныеНКЦ = ДанныеНКЦ[0];
	
	Для Каждого Эл Из СтрокаДанныеНКЦ Цикл
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(Эл.Значение));
		ОпТипов = Новый ОписаниеТипов(МассивТипов);
		ТабДанныеНКЦ.Колонки.Добавить(Эл.Ключ, ОпТипов);	
	КонецЦикла;
	
	Для Каждого Эл Из ДанныеНКЦ Цикл
		Стр = ТабДанныеНКЦ.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла;
	
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	ТабТрафика = ОбработкаОК.ПолучитьТаблицуОткрытогоТрафика(, СтруктураНастроекСписка, ТабДанныеНКЦ, ПраваПользователя, НачалоПериода, КонецПериода, ПоказатьТрафикПоМенеджерам);
	
	ДанныеТрафика = Новый Массив();
	КолонкиТабТрафика = ТабТрафика.Колонки;
	Для Каждого Эл Из ТабТрафика Цикл
		СтрокаДанныхТрафика = Новый Структура();
		Для Каждого Стр Из КолонкиТабТрафика Цикл
			СтрИмя = Стр.Имя;
			СтрокаДанныхТрафика.Вставить(СтрИмя, Эл[СтрИмя]); 			
		КонецЦикла;
		
		ДанныеТрафика.Добавить(СтрокаДанныхТрафика);
	КонецЦикла;
	
	Возврат ДанныеТрафика; 	
КонецФункции

&НаКлиенте
Процедура ПоказатьУведомлениеОНовомСообщении()
	Если глРарус_Компонента <> Неопределено Тогда
		Тема = обОбрезатьСтроку(Формат(ТекущаяДата(),"ДФ='дд.ММ.гг ЧЧ:мм'"), 62, "…");
		ТелоСообщения = обОбрезатьСтроку("Получены новые сообщения Online-consultant",88,"…") + " <BR>";
		глРарус_Компонента.ПоказатьБаннер(Тема, ТелоСообщения, "Необходимо ответить как можно скорее! :)", 3, 0, Ложь, "Баннер", Истина);
	КонецЕсли; 	
КонецПроцедуры

