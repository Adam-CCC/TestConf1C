&НаСервере
Процедура ДобавитьОформлениеТаблицаСтатусы(ЦветФона, Статус)
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;
	
	ОформлениеУО = ЭлементУсловногоОформления.Оформление;
	ОтборУО = ЭлементУсловногоОформления.Отбор;
	ОформляемыеПоляУО = ЭлементУсловногоОформления.Поля;
	
	ОформлениеУО.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	
	ЭлементОтбора = ОтборУО.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаСтатусы.Статус");	
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Статус;
	ЭлементОтбора.Использование  = Истина; 	
	
	ОформляемоеПоле = ОформляемыеПоляУО.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСтатусыСтатус"); 	
КонецПроцедуры

&НаСервере
Процедура ТаблицаТрафикаОформление()
	ЦветФонаОбработан = Новый Цвет(230, 230, 230);
	ЦветФонаОнлайн = Новый Цвет(0, 255, 0);
	ЦветФонаЛидПросрочка = Новый Цвет(255, 130, 100);

	ШрифтЕстьНовыеСообщения = Новый Шрифт(Элементы.ТаблицаТрафика.Шрифт, , , Истина);
	                   
	ДобавитьОформлениеТаблицаТрафик("Шрифт", ШрифтЕстьНовыеСообщения, Новый Структура("ЕстьНовыеСообщения",  Истина), Ложь); 
	ДобавитьОформлениеТаблицаТрафик("ЦветФона", ЦветФонаОбработан, Новый Структура("ЕстьНовыеСообщения, Обработан",  Ложь, Истина), Ложь); 
	ДобавитьОформлениеТаблицаТрафик("ЦветФона", ЦветФонаОнлайн, Новый Структура("ПользовательОнлайн, Обработан",  Истина, Ложь), Истина); 
	ДобавитьОформлениеТаблицаТрафик("ЦветФона", ЦветФонаЛидПросрочка, Новый Структура("ТипТрафика, Обработан, ОбработатьДО", ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault"), Ложь, ТекущаяДата()), Ложь); 
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеТаблицаТрафик(ПараметрОформления, ЗначениеПараметраОформления, Отборы, ТолькоДляЯчейки)
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;
	
	ОформлениеУО = ЭлементУсловногоОформления.Оформление;
	ОтборУО = ЭлементУсловногоОформления.Отбор;
	ОформляемыеПоляУО = ЭлементУсловногоОформления.Поля;
	
	ОформлениеУО.УстановитьЗначениеПараметра(ПараметрОформления, ЗначениеПараметраОформления);
	
	Для Каждого Отбор Из Отборы Цикл 		
		ЭлементОтбора = ОтборУО.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаТрафика." + Отбор.Ключ);
		Если Отбор.Ключ = "ОбработатьДО" Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		Иначе
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		ЭлементОтбора.ПравоеЗначение = Отбор.Значение;
		ЭлементОтбора.Использование  = Истина;
	КонецЦикла;
	
	Если ТолькоДляЯчейки Тогда
		ОформляемоеПоле = ОформляемыеПоляУО.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаТрафикаПользовательОнлайн");  
	Иначе
		ПодЭлТаблицаТрафика = Элементы.ТаблицаТрафика.ПодчиненныеЭлементы;
		Для Каждого Эл Из ПодЭлТаблицаТрафика Цикл
			ЭлИмя = Эл.Имя;
			ОформляемоеПоле = ОформляемыеПоляУО.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ЭлИмя);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьКартинкиТаблицаТрафик()
	ТипТрафикаEmail = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email");
	ТипТрафикаЛид = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault");
	ТипТрафикаOnlineКонсультант = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант");
	
	Для Каждого Эл Из ТаблицаТрафика Цикл
		Если Эл.ТипТрафика = ТипТрафикаEmail Тогда
			Эл.ТипТрафикаКартинка = КартинкаПисьмо;
		ИначеЕсли Эл.ТипТрафика = ТипТрафикаЛид Тогда
			Эл.ТипТрафикаКартинка = КартинкаЛИД; 			
		ИначеЕсли Эл.ТипТрафика = ТипТрафикаOnlineКонсультант Тогда
			Эл.ТипТрафикаКартинка = КартинкаЧат;
		КонецЕсли;   		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НачальноеОтображаениеЧатаИДанныхКлиента()
	ТекущаяЗакладкаМеню = 0;
	
	ПодчиненныеЭлементыГрКнопкиМеню = Элементы.грКнопкиМеню.ПодчиненныеЭлементы;
	Для Каждого Эл Из ПодчиненныеЭлементыГрКнопкиМеню Цикл
		Если Эл.Имя = "кнРабочиеЛисты" Тогда
			Эл.Видимость = Ложь;
		Иначе
			Эл.Видимость = Истина;
		КонецЕсли;		
	КонецЦикла;
	
	ПодчиненныеЭлементыгрЛеваяКолонкаОсновноеТело = Элементы.грЛеваяКолонкаОсновноеТело.ПодчиненныеЭлементы;
	Для Каждого Эл Из ПодчиненныеЭлементыгрЛеваяКолонкаОсновноеТело Цикл
		Если Эл.Имя = "грЧатОбщение" Тогда
			Эл.Видимость = Истина;
		Иначе
			Эл.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

	ПолеЧата = "";
	ПолеВводаТекстСообщения = "";
	Если НеВозвращатьТрафик Тогда
		НеВозвращатьТрафикНажатие();
	КонецЕсли;	
	
	ТЗРабочиеЛисты.Очистить();
	
	Вложения.Очистить();
		
	Элементы.НадписьПисьмоИнфо.Видимость = Ложь;
	Элементы.НадписьЛидИнфо.Видимость = Ложь;
	
	Взаимодействия.Очистить();
	
	Элементы.ПолеКартинкиВыдача.Доступность = Ложь;
	Элементы.ПолеЕстьРабочийЛист.Доступность = Ложь;	
	Элементы.НадписьФИО.Заголовок = "<ФИО не указано>";   	
	Элементы.НадписьМодельАвтомобиля.Заголовок = "  <Автомобиль неизвестен>";
	
	Объект.ИдПользователя = "";
	Клиент = "";
	ВыбранныйТрафикID = "";
	ТипВыбранногоТрафика = "";
	ТекущийДЦ = "";
	ВыбранныйКлиент = ""; 
	
	ИсторияТекст = "";

	Элементы.грЛеваяКолонка.Доступность = Ложь;	
	
	УправлениеМеню();
КонецПроцедуры

