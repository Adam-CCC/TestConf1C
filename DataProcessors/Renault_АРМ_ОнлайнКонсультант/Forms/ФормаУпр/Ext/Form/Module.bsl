&НаКлиенте
Процедура ЗаполнитьЧатЗавершение(ВыбранноеЗначение, ДопПараметры)  Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеВводаТекстСообщения = ВыбранноеЗначение.ШаблонОтвета;		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьСообщениеВременно(ИД, Текст, ИдПользователя)
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	ОбработкаОК.ЗаписатьСообщениеВременно(ИД, Текст, ИдПользователя);
	
	ПолеВводаТекстСообщения = "";
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИД);
	Если Запись <> Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Запись.Администратор) Тогда
			Запись.Администратор = ПараметрыСеанса.Пользователь.Сотрудник;
		КонецЕсли;
		Запись.Обработан = Истина;
		Запись.Записать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НазначитьТрафикНаМенеджера(ПараметрыПеретаскивания, Строка)
	Если ЗначениеЗаполнено(Строка) Тогда
		Если Строка.ЗанятостьСотрудника = ПредопределенноеЗначение("Перечисление.CRM_ЗанятостьСотрудника.Занят") Тогда
			Сообщить("Менеджер занят и не может принять трафик! Попробуйте перенаправить на другого.");
		Иначе
			НазначитьТрафикНаМенеджераСервер(ПараметрыПеретаскивания.Значение.Идентификатор, Строка.Сотрудник, Отдел);
			
			ОбновитьСписокТрафика();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура НазначитьТрафикНаМенеджераСервер(Идентификатор, Сотрудник, Отдел)
	ЗаписьТрафик = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(Идентификатор);
	ЗаписьТрафик.Менеджер = Сотрудник;			
	Отдел = Renault_CRM.ПолучитьОтделСотрудника(ЗаписьТрафик.Менеджер);
	ЗаписьТрафик.Отдел = Отдел;			
	ЗаписьТрафик.Записать();	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьБлокировки()
	ОткрытьФорму("РегистрСведений.Renault_ЗаблокированныйТрафик.Форма.ФормаСпискаУпр",,ЭтаФорма);	
КонецПроцедуры

&НаКлиенте
Процедура кнОбновитьСписокТрафика()
	НачальноеОтображаениеЧатаИДанныхКлиента();
	
	ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
	
	мПараметры = Новый Массив;
	мПараметры.Добавить(" ");
	Задание = ФоновыеЗадания.Выполнить("Renault_ОнлайнКонсультант.Renault_КонтактЦентр_LMT", мПараметры); 	
	УникальныйИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Ответ = ЗаданиеВыполнено(УникальныйИдентификаторЗадания, ОшибкаПолученияДанных); 
	Если ОшибкаПолученияДанных Тогда
		Если ФормаДлительнойОперации <> Неопределено И ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = УникальныйИдентификаторЗадания Тогда
			ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаОшибкиПолученияДанных");
	КонецЕсли;
	
	Если Ответ <> Неопределено и Ответ = Истина Тогда
		ОбновитьСписокТрафика();
		ОбновитьЧат();
		ПрочитатьДанныеКлиента(); 		
	ИначеЕсли НЕ ОшибкаПолученияДанных Тогда 
		ПодключитьОбработчикОжидания("ВыполнениеДлительнойОперацииLMT", 1, Истина);
		ФормаДлительнойОперации = ОткрытьФормуДлительнойОперации(ЭтаФорма, УникальныйИдентификаторЗадания, "LMT");
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Функция ОткрытьФормуДлительнойОперации(Знач ВладелецФормы, Знач ИдентификаторЗадания, ЗаголовокФормы)
	ФормаДлительнойОперации = ПолучитьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ДлительнаяОперация");
	Если ФормаДлительнойОперации.Открыта() Тогда
		ФормаДлительнойОперации = ОткрытьФорму(
			"Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ДлительнаяОперация",
			Новый Структура("ИдентификаторЗадания, ЗаголовокФормы", ИдентификаторЗадания, ЗаголовокФормы), 
			ВладелецФормы);
	Иначе
		ФормаДлительнойОперации.ВладелецФормы        = ВладелецФормы;
		ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания;
		ФормаДлительнойОперации.ЗаголовокФормы		 = ЗаголовокФормы;
		ФормаДлительнойОперации.Открыть();
	КонецЕсли;
	
	Возврат ФормаДлительнойОперации; 	
КонецФункции

&НаКлиенте
Процедура ВыполнениеДлительнойОперацииLMT()
	Ответ = ЗаданиеВыполнено(УникальныйИдентификаторЗадания, ОшибкаПолученияДанных);
	Если ОшибкаПолученияДанных Тогда
		Если ФормаДлительнойОперации <> Неопределено И ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = УникальныйИдентификаторЗадания Тогда
			ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаОшибкиПолученияДанных");
	КонецЕсли;
	
	Если Ответ <> Неопределено и Ответ = Истина Тогда
		Если ФормаДлительнойОперации <> Неопределено И ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = УникальныйИдентификаторЗадания Тогда
			ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		мПараметры = Новый Массив;
		мПараметры.Добавить(" ");
		Задание = ФоновыеЗадания.Выполнить("Renault_ОнлайнКонсультант.Renault_КонтактЦентр_Почта", мПараметры);
		УникальныйИдентификаторЗадания = Задание.УникальныйИдентификатор;
		Ответ = ЗаданиеВыполнено(УникальныйИдентификаторЗадания, ОшибкаПолученияДанных);
		Если ОшибкаПолученияДанных Тогда
			Если ФормаДлительнойОперации <> Неопределено И ФормаДлительнойОперации.Открыта() 
				И ФормаДлительнойОперации.ИдентификаторЗадания = УникальныйИдентификаторЗадания Тогда
				ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			КонецЕсли;
			ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаОшибкиПолученияДанных");
		КонецЕсли;
		
		Если Ответ <> Неопределено и Ответ = Истина Тогда
			ОбновитьСписокТрафика();
			ОбновитьЧат();
			ПрочитатьДанныеКлиента();
		ИначеЕсли не ОшибкаПолученияДанных Тогда
			ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);   
			ПодключитьОбработчикОжидания("ВыполнениеДлительнойОперацииПочта", ПараметрыОбработчика.ТекущийИнтервал, Истина);
			ФормаДлительнойОперации = ОткрытьФормуДлительнойОперации(ЭтаФорма, УникальныйИдентификаторЗадания, "почты");
		КонецЕсли;
	ИначеЕсли Не ОшибкаПолученияДанных Тогда
		ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ВыполнениеДлительнойОперацииLMT", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;  	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнениеДлительнойОперацииПочта()
	Ответ = ЗаданиеВыполнено(УникальныйИдентификаторЗадания, ОшибкаПолученияДанных);
	Если ОшибкаПолученияДанных Тогда
		Если ФормаДлительнойОперации <> Неопределено И ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = УникальныйИдентификаторЗадания Тогда
			ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаОшибкиПолученияДанных");
	КонецЕсли;
	
	Если Ответ <> Неопределено и Ответ = Истина Тогда
		Если ФормаДлительнойОперации <> Неопределено И ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = УникальныйИдентификаторЗадания Тогда
			ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОбновитьСписокТрафика();
		ОбновитьЧат();
