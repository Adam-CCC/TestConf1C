&НаСервереБезКонтекста
Функция РабочийЛистСуществует(ВыбранныйТрафикID)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_РабочиеЛисты.ID
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.IDТрафика = &ИдТрафика";
	Запрос.УстановитьПараметр("ИдТрафика", ВыбранныйТрафикID);
	
	Возврат Запрос.Выполнить().Выбрать().Количество() > 0;    	
КонецФункции

&НаКлиенте
Процедура ОтправитьВЧат()
	Текст = ПолеВводаТекстСообщения;
	Если ЗначениеЗаполнено(Текст) Тогда
		Попытка
			СтандартнаяОбработка = Ложь;
			
			Renault_ОнлайнКонсультант.ОтправитьСообщениеКлиентуОКВебСервис(Текст, Объект.ИдПользователя, ТекущаяДата(), ТекущийДЦ);
			
			ЗаписатьСообщениеВременно(ВыбранныйТрафикID, Текст, Объект.ИдПользователя);
		Исключение
			Предупреждение("Не удалось отправить сообщение");
		КонецПопытки;
	КонецЕсли;
	
	ТекущийЭлемент = Элементы.ПолеВводаТекстСообщения;   
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЧат()
