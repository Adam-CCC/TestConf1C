КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТаблицуЗакрытогоТрафика(СтруктураНастроекСписка = Неопределено, ДанныеНКЦ = Неопределено, ПраваПользователя, НачалоПериода, КонецПериода, ЕстьПравоАдминистратора = Ложь, ЕстьПравоМенеджера = Ложь)
	ТабДанныеНКЦ = Новый ТаблицаЗначений;
	СтрокаДанныеНКЦ = ДанныеНКЦ[0];
	
	Для Каждого Эл Из СтрокаДанныеНКЦ Цикл
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(Эл.Значение));
		ОпТипов = Новый ОписаниеТипов(МассивТипов);
		ТабДанныеНКЦ.Колонки.Добавить(Эл.Ключ, ОпТипов);	
	КонецЦикла;
	
	Для Каждого Эл Из ДанныеНКЦ Цикл
		Стр = ТабДанныеНКЦ.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла;
	
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	ТабТрафика = ОбработкаОК.ПолучитьТаблицуЗакрытогоТрафика(СтруктураНастроекСписка, ТабДанныеНКЦ, ПраваПользователя, НачалоПериода, КонецПериода, ЕстьПравоАдминистратора, ЕстьПравоМенеджера);
	
	ДанныеТрафика = Новый Массив();
	КолонкиТабТрафика = ТабТрафика.Колонки;
	Для Каждого Эл Из ТабТрафика Цикл
		СтрокаДанныхТрафика = Новый Структура();
		Для Каждого Стр Из КолонкиТабТрафика Цикл
			СтрИмя = Стр.Имя;
			СтрокаДанныхТрафика.Вставить(СтрИмя, Эл[СтрИмя]); 			
		КонецЦикла;
		
		ДанныеТрафика.Добавить(СтрокаДанныхТрафика);
	КонецЦикла;
	
	Возврат ДанныеТрафика; 		
КонецФункции

&НаКлиенте
Процедура ОбновитьЗаголовокКнопокТрафика()
	КолТрафика = ТаблицаТрафика.Количество();
	Если ВыборТрафика = 1 Тогда
		Элементы.КнОтобразитьОткрытыйТрафик.Заголовок = "("+КолТрафика+")";
		Элементы.КнОтобразитьЗакрытыйТрафик.Заголовок = "";
		Элементы.КнОтобразитьОткрытыйТрафикМенеджеров.Заголовок = "";
	ИначеЕсли ВыборТрафика = 2 Тогда
		Элементы.КнОтобразитьОткрытыйТрафик.Заголовок = "";
		Элементы.КнОтобразитьЗакрытыйТрафик.Заголовок = "";
		Элементы.КнОтобразитьОткрытыйТрафикМенеджеров.Заголовок = "("+КолТрафика+")";
	Иначе
		Элементы.КнОтобразитьОткрытыйТрафик.Заголовок = "";
		Элементы.КнОтобразитьЗакрытыйТрафик.Заголовок = "("+КолТрафика+")";
		Элементы.КнОтобразитьОткрытыйТрафикМенеджеров.Заголовок = "";
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьТекущийВидТрафика()
	Если ВыборТрафика = 1 Тогда
		Элементы.КнОтобразитьОткрытыйТрафик.ЦветФона = ЦветАктив;
		Элементы.КнОтобразитьЗакрытыйТрафик.ЦветФона = ЦветСерый;
		Элементы.КнОтобразитьОткрытыйТрафикМенеджеров.ЦветФона = ЦветСерый;
	ИначеЕсли ВыборТрафика = 0 Тогда
		Элементы.КнОтобразитьОткрытыйТрафик.ЦветФона = ЦветСерый;
		Элементы.КнОтобразитьЗакрытыйТрафик.ЦветФона = ЦветАктив;
		Элементы.КнОтобразитьОткрытыйТрафикМенеджеров.ЦветФона = ЦветСерый;
	ИначеЕсли ВыборТрафика = 2 Тогда
		Элементы.КнОтобразитьОткрытыйТрафик.ЦветФона = ЦветСерый;
		Элементы.КнОтобразитьЗакрытыйТрафик.ЦветФона = ЦветСерый;
		Элементы.КнОтобразитьОткрытыйТрафикМенеджеров.ЦветФона = ЦветАктив;
	КонецЕсли;  	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЧат()
	Если ЗначениеЗаполнено(ВыбранныйТрафикID) Тогда
		ОбновитьДоступностьКнопок(); 
		ОбновитьОкноОбработкиТрафика(); 
		УправлениеМеню();  		
	КонецЕсли;   	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьКнопок()
	Отбор = Новый Структура;
	Отбор.Вставить("ТипТрафика", ТипВыбранногоТрафика);
	Отбор.Вставить("ДилерскийЦентр", ТекущийДЦ);
	МассивСтрок = НастройкиКонтактЦентра.НайтиСтроки(Отбор);
	Если МассивСтрок.Количество() <> 0 Тогда
		СозданиеРЛ = МассивСтрок[0].СозданиеРЛ;
		ПереводТрафика = МассивСтрок[0].ПереводТрафика;
	Иначе
		СозданиеРЛ = Истина;
		ПереводТрафика = Истина;
	КонецЕсли;
	
	ЭтоМойТрафик = Ложь;
	СтрокиТрафика = ТаблицаТрафика.НайтиСтроки(Новый Структура("Идентификатор", ВыбранныйТрафикID));
	Если СтрокиТрафика.Количество() > 0 Тогда
		ЭтоМойТрафик = СтрокиТрафика[0].Менеджер = Renault_ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыСеанса.Пользователь, "Сотрудник");
	КонецЕсли;
		
	Элементы.кнЗавершитьРазговор.Доступность 				= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнЗакрытьТрафик.Доступность 					= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнЗакрытьТрафикПисьмо.Доступность 				= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнСоздатьРабочийЛист.Видимость 				= СозданиеРЛ;
	Элементы.кнСоздатьРЛПисьмо.Видимость 					= СозданиеРЛ;
	Элементы.кнСоздатьРабочийЛист.Доступность 				= СозданиеРЛ И ((ВыборТрафика = 1) ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик));
	Элементы.кнСоздатьРЛПисьмо.Доступность 					= СозданиеРЛ И ((ВыборТрафика = 1) ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик));
	Элементы.кнСоздатьРЛ.Видимость							= СозданиеРЛ И ((ВыборТрафика = 1) ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик));
	Элементы.кнЧатМенеджер.Видимость						= ПраваПользователя.ПраваИНастройки.ПраваКЦАдминистратор И ПереводТрафика;
	Элементы.кнНеВозвращатьТрафик.Видимость					= (ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик)) И ПереводТрафика;
	Элементы.кнЛидМенеджер.Видимость						= ПраваПользователя.ПраваИНастройки.ПраваКЦАдминистратор И ПереводТрафика;
	Элементы.кнПисьмоМенеджер.Видимость 					= ПраваПользователя.ПраваИНастройки.ПраваКЦАдминистратор И ПереводТрафика;
	Элементы.кнЗаполнить.Доступность						= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.ПолеВводаТекстСообщения.Доступность 			= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.ОтветПисьмо.Доступность 						= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнЗаполнитьЧат.Доступность 					= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнЗаполнитьПисьмоПоШаблону.Доступность 		= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнОтправитьВЧат.Доступность 					= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнОтправитьОтветЛида.Доступность 				= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнОтправитьОтветЛидаПоТелефону.Доступность 	= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнОтправитьОтветПисьмо.Доступность 			= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнСохранить.Доступность 						= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
	Элементы.кнСохранитьЛид.Доступность 					= ВыборТрафика = 1 ИЛИ (ВыборТрафика = 2 И ЭтоМойТрафик);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОкноОбработкиТрафика()
	Если Не ЗначениеЗаполнено(ВыбранныйТрафикID) Тогда
		ПолеЧата = "";
		ЧатЛида = "";
		Возврат;
	КонецЕсли;
	
	НастройкаВидимостиСтраницЧата(); 
	
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault") Тогда
		НаименованиеКлиента = "";
		
		ДанныеДляЛида = Новый Структура();
		СформироватьЗакладкуДляЛида(ВыбранныйТрафикID, НаименованиеКлиента, ДанныеДляЛида, НаименованиеОператора);		
		
		ДанныеДляЛида.Свойство("ЛидVIN", ЛидVIN);
		ДанныеДляЛида.Свойство("ЛидМодель", ЛидМодель);
		ДанныеДляЛида.Свойство("ЛидПробег", ЛидПробег);
		ДанныеДляЛида.Свойство("ЛидТипДвигателя", ЛидТипДвигателя);
		ДанныеДляЛида.Свойство("ЛидОбъемДвигателя", ЛидОбъемДвигателя);
		ДанныеДляЛида.Свойство("ЛидИсточник", ЛидИсточник);
		ДанныеДляЛида.Свойство("ЛидАдрес", ЛидАдрес);
		ДанныеДляЛида.Свойство("ЛидГород", ЛидГород);
		ДанныеДляЛида.Свойство("ЛидСообщение", ЛидСообщение);
		ДанныеДляЛида.Свойство("ЧатЛида", ЧатЛида);
		ДанныеДляЛида.Свойство("КатегорияЛида", КатегорияЛида);
		ДанныеДляЛида.Свойство("ТипЛида", ТипЛида);
		ДанныеДляЛида.Свойство("ТемаПисьма", ТемаПисьма);

		ИспользуетсяНесколькоЯщиков = Ложь;
		ДанныеДляЛида.Свойство("ИспользуетсяНесколькоЯщиков", ИспользуетсяНесколькоЯщиков);
		Если ЗначениеЗаполнено(ИспользуетсяНесколькоЯщиков) Тогда
			Элементы.ЯщикОтправки.Видимость = ИспользуетсяНесколькоЯщиков;
			
			Если ИспользуетсяНесколькоЯщиков Тогда
				ДанныеДляЛида.Свойство("ОсновнойЯщик", ЯщикОтправки);			
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОтветЛиду) Тогда
			Элементы.НадписьОтветОтправлен.Заголовок = "Ответ: Ответ отправлен";
		Иначе
			Элементы.НадписьОтветОтправлен.Заголовок = "Ответ:";
		КонецЕсли; 
		
	ИначеЕсли ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
		ДанныеДляЗакладкиПисьма = СформироватьЗакладкуДляПисьма(ВыбранныйТрафикID);  
		
		ДанныеТрафикаПисьма = ДанныеДляЗакладкиПисьма.ДанныеТрафикаПисьма;
		ИспользуетсяНесколькоЯщиков = ДанныеДляЗакладкиПисьма.ИспользуетсяНесколькоЯщиков;
		ОсновнойЯщик = ДанныеДляЗакладкиПисьма.ОсновнойЯщик;
		ЕстьТрафик = ДанныеДляЗакладкиПисьма.ЕстьТрафик;
 
		ПолеHTMLДокументаПисьмо = "";
		ПолеТекстовогоДокументаПисьмо = "";

		Если ЕстьТрафик Тогда
			ЭтаФорма.Клиент = ДанныеТрафикаПисьма.Клиент;
			ЭтаФорма.ТемаПисьма = ДанныеТрафикаПисьма.ТемаПисьма;
			ЭтаФорма.Email = ДанныеТрафикаПисьма.Email;  
			
			Если ДанныеТрафикаПисьма.ФорматТекста = ПредопределенноеЗначение("Перечисление.ФорматТекста.HTML") Тогда
				Элементы.ПолеHTMLДокументаПисьмо.Видимость = Истина;
				Элементы.ПолеТекстовогоДокументаПисьмо.Видимость = Ложь; 
				ТекстПисьма = ДанныеТрафикаПисьма.ТекстПисьма;
				Если СтрЧислоВхождений(ТекстПисьма, "<html>") > 0 Тогда
					ПолеHTMLДокументаПисьмо = ТекстПисьма;
				Иначе
					ПолеHTMLДокументаПисьмо = "<html><body>" + ТекстПисьма + "</body></html>";
				КонецЕсли;
			Иначе
				Элементы.ПолеHTMLДокументаПисьмо.Видимость = Ложь;
				Элементы.ПолеТекстовогоДокументаПисьмо.Видимость = Истина;
				ПолеТекстовогоДокументаПисьмо = ДанныеТрафикаПисьма.ТекстПисьма;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеТрафикаПисьма.BIR) Тогда
				Элементы.ЯщикОтправки.Видимость = ИспользуетсяНесколькоЯщиков;
				Если ИспользуетсяНесколькоЯщиков Тогда
					ЯщикОтправки = ОсновнойЯщик;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
	Иначе
		НаименованиеКлиента = "";
		ТекстПоля = СформироватьТекстПоляЧата(НаименованиеКлиента, ВыбранныйТрафикID, ДатаОбновления, НаименованиеОператора); 
		ПолеЧата = ТекстПоля;
		Renault_ОнлайнКонсультант.ОтметитьСообытияОНовомСообщенииВчатОбработаными(ВыбранныйТрафикID);
		СформироватьЗаголовокФормы(НаименованиеКлиента);		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВидимостиСтраницЧата()
	ПодчиненныеЭлементыГрКнопкиМеню = Элементы.грКнопкиМеню.ПодчиненныеЭлементы;
	Для Каждого Эл Из ПодчиненныеЭлементыГрКнопкиМеню Цикл
		Эл.Видимость = Ложь;
	КонецЦикла;
	
	ПодчиненныеЭлементыгрЛеваяКолонкаОсновноеТело = Элементы.грЛеваяКолонкаОсновноеТело.ПодчиненныеЭлементы;
	Для Каждого Эл Из ПодчиненныеЭлементыгрЛеваяКолонкаОсновноеТело Цикл
		Эл.Видимость = Ложь;
	КонецЦикла;
	
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault") Тогда
		ТекущаяЗакладкаМеню = 2;
		Элементы.кнЛидРено.Видимость = Истина;
		Элементы.грЛидРено.Видимость = Истина;
		Элементы.кнАтрибутыЛида.Видимость = Истина;		
		Элементы.кнИстория.Видимость = ИсторияСуществует();
	ИначеЕсли ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
		ТекущаяЗакладкаМеню = 4;
		Элементы.кнПисьмо.Видимость = Истина;
		Элементы.грПисьмо.Видимость = Истина;
		Элементы.кнАтрибутыПисьма.Видимость = Истина;
		Элементы.кнИстория.Видимость = ИсторияСуществует();
	ИначеЕсли ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант") Тогда
		ТекущаяЗакладкаМеню = 0;
		Элементы.кнЧатОбщение.Видимость	= Истина;
		Элементы.грЧатОбщение.Видимость = Истина;
		Элементы.кнАтрибутыТрафика.Видимость = Истина;
	КонецЕсли;  	           	
	
	Элементы.кнРабочиеЛисты.Видимость = ТЗРабочиеЛисты.Количество() > 0;
КонецПроцедуры

&НаКлиенте
Функция ИсторияСуществует()
	Возврат Истина; ///Нужно доработать
КонецФункции

&НаСервереБезКонтекста
Процедура СформироватьЗакладкуДляЛида(ВыбранныйТрафикID, НаименованиеКлиента, ДанныеДляЛида, НаименованиеОператора)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_Трафик.ДилерскийЦентр.BIR КАК BIR,
	|	ПРЕДСТАВЛЕНИЕ(Renault_Лид.ВидУслуги) КАК Тема,
	|	ПРЕДСТАВЛЕНИЕ(Renault_Лид.ВидУслуги.Классификация) КАК Тип,
	|	ПРЕДСТАВЛЕНИЕ(Renault_Лид.ВидУслуги.Тип) КАК ПодТип,
	|	Renault_Лид.Модель КАК ЛидМодель,
	|	Renault_Лид.Мотор КАК ЛидТипДвигателя,
	|	Renault_Лид.ОбъемДвигателя КАК ЛидОбъемДвигателя,
	|	Renault_Лид.VIN КАК ЛидVIN,
	|	Renault_Лид.Пробег КАК ЛидПробег,
	|	Renault_Лид.ИсточникИнформации КАК ЛидИсточник,
	|	Renault_Лид.Адрес КАК ЛидАдрес,
	|	Renault_Лид.Город КАК ЛидГород,
	|	Renault_Лид.Сообщение КАК ЛидСообщение
	|ИЗ
	|	Документ.Renault_Лид КАК Renault_Лид
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|		ПО Renault_Лид.ТрафикИД = Renault_Трафик.Идентификатор
	|ГДЕ
	|	Renault_Трафик.Идентификатор = &ИдТрафика";
	Запрос.УстановитьПараметр("ИдТрафика", ВыбранныйТрафикID);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	ОбработкаОК.ОтметитьТрафикЛМТПоказанным(ВыбранныйТрафикID);   
	
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Тип)Тогда
			ДанныеДляЛида.Вставить("КатегорияЛида", Выборка.ПодТип);
			ДанныеДляЛида.Вставить("ТипЛида", Выборка.Тип);
			ДанныеДляЛида.Вставить("ТемаПисьма",Выборка.Тип);
		КонецЕсли;

		ТекстПоляЧата = СформироватьТекстПоляЧатаЛиды(ОбработкаОК, ВыбранныйТрафикID, НаименованиеОператора); 		
		
		ДанныеДляЛида.Вставить("ЧатЛида", ТекстПоляЧата);
		ДанныеДляЛида.Вставить("ЛидVIN", Выборка.ЛидVIN);
		ДанныеДляЛида.Вставить("ЛидМодель", Выборка.ЛидМодель);
		ДанныеДляЛида.Вставить("ЛидПробег", Выборка.ЛидПробег);
		ДанныеДляЛида.Вставить("ЛидТипДвигателя", Выборка.ЛидТипДвигателя);
		ДанныеДляЛида.Вставить("ЛидОбъемДвигателя", Выборка.ЛидОбъемДвигателя);
		ДанныеДляЛида.Вставить("ЛидИсточник", Выборка.ЛидИсточник);
		ДанныеДляЛида.Вставить("ЛидАдрес", Выборка.ЛидАдрес);
		ДанныеДляЛида.Вставить("ЛидГород", Выборка.ЛидГород);
		ДанныеДляЛида.Вставить("ЛидСообщение", Выборка.ЛидСообщение);  
		
		Если ЗначениеЗаполнено(Выборка.BIR) Тогда
			ИспользуетсяНесколькоЯщиков = Renault_ОнлайнКонсультант.ИспользуетсяНесколькоЯщиковПоBIR(Выборка.BIR);
			ДанныеДляЛида.Вставить("ИспользуетсяНесколькоЯщиков",ИспользуетсяНесколькоЯщиков);  

			Если ИспользуетсяНесколькоЯщиков Тогда
				ОсновнойЯщик = Справочники.Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.ПолучитьОсновнойЯщикДляЛидов(Выборка.BIR);
				ДанныеДляЛида.Вставить("ОсновнойЯщик",ОсновнойЯщик); 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьТекстПоляЧатаЛиды(ОбработкаОК, ВыбранныйТрафикID, НаименованиеОператора)
	ТекстПоля = ЗаполнитьШапкуПоляЧата(ОбработкаОК);   
	Табл = ОбработкаОК.ПолучитьИсториюЛидов(ВыбранныйТрафикID); 
	ПредыдущаяДатаСообщения = Дата(1,1,1,0,0,0);
	ПредыдущийВывод = "-1";
	НачатаТаблица = Ложь;
	Для Каждого Выборка Из Табл Цикл		
		Если Выборка.ВидСообщения = 1 Тогда
			//Сообщение отправил клиент
			СтрокаЧата = СформироватьСтрокуШтмлСообщенияЛиды(ОбработкаОК, ПредыдущаяДатаСообщения, ПредыдущийВывод, НачатаТаблица, Выборка, Ложь, НаименованиеОператора);
		Иначе			//Сообщение отправил оператор
			СтрокаЧата = СформироватьСтрокуШтмлСообщенияЛиды(ОбработкаОК, ПредыдущаяДатаСообщения, ПредыдущийВывод, НачатаТаблица, Выборка, Ложь, НаименованиеОператора);
		КонецЕсли;
		ТекстПоля = ТекстПоля + СтрокаЧата;
	КонецЦикла;
	Если НачатаТаблица Тогда
		ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/TABLE", 2);
	КонецЕсли;
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/BODY", 1);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/HTML", 0);
	
	Возврат ТекстПоля;   	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьШапкуПоляЧата(ОбработкаОК)
	ТекстПоля = "";
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "HTML");
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "HEAD",1);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "META",2, ОбработкаОК.СтруктураПараметровМета("utf-8"));
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "STYLE  type=text/css",2);
	ТекстПоля = ТекстПоля + Символы.ПС + ОбработкаОК.ОписаниеКласса("DateText", "COLOR: #000000; FONT-SIZE: 12px", 3);
	ТекстПоля = ТекстПоля + Символы.ПС + ОбработкаОК.ОписаниеКласса("IsFor", "COLOR: #000000; FONT-SIZE: 14px", 3);
	ТекстПоля = ТекстПоля + Символы.ПС + ОбработкаОК.ОписаниеКласса("IsFrom", "COLOR: #000000; FONT-SIZE: 14px", 3);
	ТекстПоля = ТекстПоля + Символы.ПС + ОбработкаОК.ОписаниеКласса("UserNick", "COLOR: #000000; FONT-SIZE: 14px; FONT-WEIGHT: 700", 3);
	ТекстПоля = ТекстПоля + Символы.ПС + ОбработкаОК.ОписаниеКласса("BodyStyle", "background-color: #F2F2F2", 3);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/STYLE type=text/css", 2);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/HEAD", 1);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "script", 1);
	ТекстПоля = ТекстПоля + Символы.ПС + ОбработкаОК.ОписаниеФункции("scrollBottom()", "document.body.scrollTop = document.body.scrollHeight", 2);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/script", 1);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "BODY", 1, ОбработкаОК.СтруктураПараметровТелаДокумента("BodyStyle", """scrollBottom()"""));
	
	Возврат ТекстПоля;    	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьСтрокуШтмлСообщенияЛиды(ОбработкаОК, ПредДатаСообщения, ПредВывод, НачатаТаблица, Сообщение, ЭтоСообщениеОператора = Ложь, НаименованиеОператора)
	СсылкаНаКартинкуОнлайнКонсультанта = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.Renault_chat_lead);

	ТекстКВозврату = "";
	ПредыдущийГод = Год(ПредДатаСообщения);
	ПредыдущийМесяц = Месяц(ПредДатаСообщения);
	ПредыдущийДень = День(ПредДатаСообщения);
	ТекущийГод = Год(Сообщение.ДатаСообщения);
	ТекущийМесяц = Месяц(Сообщение.ДатаСообщения);
	ТекущийДень = День(Сообщение.ДатаСообщения);
	ЭтоНовыйДеньСоощений = НЕ((ПредыдущийДень = ТекущийДень) И (ПредыдущийМесяц = ТекущийМесяц) И (ПредыдущийГод = ТекущийГод));
	Если ЭтоНовыйДеньСоощений Тогда
		Если НачатаТаблица Тогда
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "HR", 2);
			НачатаТаблица = Ложь;
		КонецЕсли;
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TABLE", 2, ОбработкаОК.СтруктураПараметровТаблицы("100%"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("", "", "DateText"), Формат(Сообщение.ДатаСообщения, "ДФ=""дд.ММ.гг"""), Истина);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
		ПредДатаСообщения = Сообщение.ДатаСообщения;
	КонецЕсли;
	ИмяОтправителя = Сообщение.Отправитель;
	Если Не ЗначениеЗаполнено(ИмяОтправителя) Тогда
		ИмяОтправителя = НаименованиеОператора;
	КонецЕсли;
	имяКласса = "IsFor";
	
	ПродолжитьВыводСообщения = (ПредВывод = ИмяОтправителя) И (НЕ ЭтоНовыйДеньСоощений);
	Если Не ПродолжитьВыводСообщения Тогда
		Если НачатаТаблица Тогда
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
		КонецЕсли;
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TABLE", 2, ОбработкаОК.СтруктураПараметровТаблицы("100%"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("25"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "IMG", 6, ОбработкаОК.СтруктураПараметровКартинки(СсылкаНаКартинкуОнлайнКонсультанта, "24", "24"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TD", 5);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("", "", "UserNick"), " > " + ИмяОтправителя + " ", Истина);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TABLE", 2, ОбработкаОК.СтруктураПараметровТаблицы("100%"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TBODY", 3);
		НачатаТаблица = Истина;
		ПредВывод = ИмяОтправителя;
	КонецЕсли;
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TR", 4);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("45", "", "DateText", "right", "top"),
					Формат(Сообщение.ДатаСообщения, "ДФ=""ЧЧ:мм:сс"""), Истина);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("5", "", "UserNick", "right", "top"), ">", Истина);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("", "", ИмяКласса), Сообщение.Тип+" "+ Сообщение.ПодТип +" "+Сообщение.Сообщение, Истина);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TR", 4);
	
	Возврат ТекстКВозврату; 	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьЗакладкуДляПисьма(ИД)
	ДанныеДляЗакладкиПисьма = Новый Структура("ДанныеТрафикаПисьма, ЕстьТрафик, ИспользуетсяНесколькоЯщиков, ОсновнойЯщик");
	ДанныеТрафикаПисьма = Новый Структура("Клиент, BIR, ДатаСообщения, ТемаПисьма, ТекстПисьма, ФорматТекста, ВидСообщения, Email, УчетнаяЗаписьПисьмо");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_Трафик.Клиент КАК Клиент,
	|	Renault_Трафик.ДилерскийЦентр.BIR КАК BIR,
	|	Renault_ТрафикПисьма.ДатаПоступления КАК ДатаСообщения,
	|	Renault_ТрафикПисьма.ТемаПисьма КАК ТемаПисьма,
	|	Renault_ТрафикПисьма.ТекстПисьма КАК ТекстПисьма,
	|	Renault_ТрафикПисьма.ФорматТекста КАК ФорматТекста,
	|	1 КАК ВидСообщения,
	|	Renault_ТрафикПисьма.ПочтаКлиента КАК Email,
	|	Renault_ТрафикПисьма.УчетнаяЗапись КАК УчетнаяЗаписьПисьмо
	|ИЗ
	|	РегистрСведений.Renault_ТрафикПисьма КАК Renault_ТрафикПисьма
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|		ПО Renault_ТрафикПисьма.ИдТрафика = Renault_Трафик.Идентификатор
	|ГДЕ
	|	Renault_ТрафикПисьма.ИдТрафика = &ИдТрафика
	|УПОРЯДОЧИТЬ ПО
	|	Renault_ТрафикПисьма.ДатаПоступления УБЫВ";
	Запрос.УстановитьПараметр("ИдТрафика", ИД);
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(ДанныеТрафикаПисьма, Выборка); 		
	КонецЕсли;  
	
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	ОбработкаОК.ОтметитьТрафикПисьмаПоказанным(ИД);
	
	ИспользуетсяНесколькоЯщиков = Ложь;
	ОсновнойЯщик = Неопределено;
	Если Выборка.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(Выборка.BIR) Тогда
			ИспользуетсяНесколькоЯщиков = Renault_ОнлайнКонсультант.ИспользуетсяНесколькоЯщиковПоBIR(Выборка.BIR);
			Если ИспользуетсяНесколькоЯщиков Тогда
				ОсновнойЯщик = Справочники.Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.ПолучитьОсновнойЯщикДляПочты(Выборка.BIR);
			КонецЕсли;
		КонецЕсли; 	
	КонецЕсли;
	
	ДанныеДляЗакладкиПисьма.Вставить("ДанныеТрафикаПисьма", ДанныеТрафикаПисьма);
	ДанныеДляЗакладкиПисьма.Вставить("ЕстьТрафик", Выборка.Количество() > 0); 
	ДанныеДляЗакладкиПисьма.Вставить("ИспользуетсяНесколькоЯщиков", ИспользуетсяНесколькоЯщиков);
	ДанныеДляЗакладкиПисьма.Вставить("ОсновнойЯщик", ОсновнойЯщик);
	
	Возврат ДанныеДляЗакладкиПисьма;  	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьТекстПоляЧата(НаименованиеКлиента, ВыбранныйТрафикID, ДатаОбновления, НаименованиеОператора)
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();
	
	ТекстПоля = ЗаполнитьШапкуПоляЧата(ОбработкаОК);    
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ОК_Сообщения.id_mess,
	|	Renault_ОК_Сообщения.is_for КАК Кому,
	|	Renault_ОК_Сообщения.is_from КАК ОтКого,
	|	Renault_ОК_Сообщения.wr_date КАК ДатаСообщения,
	|	Renault_ОК_Сообщения.id_user КАК ИдПользователя,
	|	Renault_ОК_Сообщения.Клиент,
	|	Renault_ОК_Сообщения.Клиент КАК НаименованиеКлиента,
	|	Renault_ОК_Сообщения.IDТрафика,
	|	Renault_ОК_Сообщения.Обработано,
	|	Renault_ОК_Сообщения.messages КАК Сообщение,
	|	Renault_ОК_Сообщения.Внутренний,
	|	Renault_ОК_Сообщения.ИмяПользователя
	|ИЗ
	|	РегистрСведений.Renault_ОК_Сообщения КАК Renault_ОК_Сообщения
	|ГДЕ
	|	Renault_ОК_Сообщения.IDТрафика = &IDТрафика
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_ОК_Сообщения.wr_date";
	Запрос.УстановитьПараметр("IDТрафика", ВыбранныйТрафикID);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОбработкаОК.ОтметитьТрафикПоказаннымДо(ДатаОбновления, ВыбранныйТрафикID);
	
	ПредыдущаяДатаСообщения = Дата(1,1,1,0,0,0);
	ПредыдущийВывод = "-1";
	НачатаТаблица = Ложь;
	Пока Выборка.Следующий() Цикл
		НаименованиеКлиента = Выборка.НаименованиеКлиента;
		Если Выборка.ОтКого = 1 Тогда
			//Сообщение отправил клиент
			СтрокаЧата = СформироватьСтрокуШтмлСообщения(ОбработкаОК, ПредыдущаяДатаСообщения, ПредыдущийВывод, НачатаТаблица, Выборка, Ложь, НаименованиеОператора);
		Иначе
			//Сообщение отправил оператор
			СтрокаЧата = СформироватьСтрокуШтмлСообщения(ОбработкаОК, ПредыдущаяДатаСообщения, ПредыдущийВывод, НачатаТаблица, Выборка, Истина, НаименованиеОператора);
		КонецЕсли;
		ТекстПоля = ТекстПоля + СтрокаЧата;
	КонецЦикла;
	Если НачатаТаблица Тогда
		ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/TABLE", 2);
	КонецЕсли;
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/BODY", 1);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстПоля, "/HTML", 0);
	
	Возврат ТекстПоля;	
КонецФункции

&НаКлиенте
Процедура ТаблицаКлиентовВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)
	Если ТаблицаТрафика.Количество()>0 Тогда 
		
		Если Элементы.ТаблицаТрафика.ТекущиеДанные <> Неопределено Тогда
			
			//Выделили конкретную строку
			Объект.ИдПользователя = Элементы.ТаблицаТрафика.ТекущиеДанные.id_user;
			Клиент = Элементы.ТаблицаТрафика.ТекущиеДанные.Клиент;
			ВыбранныйТрафикID = Элементы.ТаблицаТрафика.ТекущиеДанные.Идентификатор;
			ТипВыбранногоТрафика = Элементы.ТаблицаТрафика.ТекущиеДанные.ТипТрафика;
			ТекущийДЦ = Элементы.ТаблицаТрафика.ТекущиеДанные.ДилерскийЦентр;
			ВыбранныйКлиент = Элементы.ТаблицаТрафика.ТекущиеДанные.Клиент;
			
		Иначе
			
			//Ничего не выделили, возьмем первую (теоретически, такого не может быть)
			Объект.ИдПользователя = ТаблицаТрафика[0].id_user;
			Клиент = ТаблицаТрафика[0].Клиент;
			ВыбранныйТрафикID = ТаблицаТрафика[0].Идентификатор;
			ТипВыбранногоТрафика = ТаблицаТрафика[0].ТипТрафика;
			ТекущийДЦ = ТаблицаТрафика[0].ДилерскийЦентр;
			ВыбранныйКлиент =  ТаблицаТрафика[0].Клиент; 			
		КонецЕсли;
		
		ОбновитьСписокТрафика();  
		ОбновитьЧат();
		ПрочитатьДанныеКлиента(); 
		
		Вложения.Очистить();
		
		Элементы.НадписьПисьмоИнфо.Видимость = Ложь;
		Элементы.НадписьЛидИнфо.Видимость = Ложь; 		
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьДанныеКлиента()
	ДанныеПоКлиенту = ПолучитьДанныеПоКлиенту(ВыбранныйТрафикID, ТипВыбранногоТрафика);
	ОбщиеДанные = ДанныеПоКлиенту.ОбщиеДанные;
	ДанныеТрафика = ДанныеПоКлиенту.ДанныеТрафика;
	ДанныеПоВзаимодействиям = ДанныеПоКлиенту.ДанныеПоВзаимодействиям;
	ДанныеПоРабочимЛистам = ДанныеПоКлиенту.ДанныеПоРабочимЛистам; 
	
	ДанныеТрафика.Свойство("Отдел", Отдел);
	ДанныеТрафика.Свойство("Менеджер", Менеджер);
	ДанныеТрафика.Свойство("Клиент", Клиент);
	ДанныеТрафика.Свойство("ПервичныйПовторный", ПервичныйПовторный);
	ДанныеТрафика.Свойство("Комментарий", Комментарий);
	ДанныеТрафика.Свойство("ПервичныйИнтерес", ПервичныйИнтерес);
	ДанныеТрафика.Свойство("ИсточникИнформации", ИсточникИнформации);
	ДанныеТрафика.Свойство("Наименование", Наименование);
	ДанныеТрафика.Свойство("БылаВыдача", БылаВыдача);  
	МодельАвтомобиля = Неопределено;
	ДанныеТрафика.Свойство("МодельАвтомобиля", МодельАвтомобиля); 
	
	Элементы.ПолеКартинкиВыдача.Доступность = БылаВыдача;
	Если ЗначениеЗаполнено(Наименование) Тогда
		Элементы.НадписьФИО.Заголовок = Наименование;
	Иначе
		Элементы.НадписьФИО.Заголовок = "<ФИО не указано>";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МодельАвтомобиля) Тогда
		Элементы.НадписьМодельАвтомобиля.Заголовок = "  " + МодельАвтомобиля;  		
	Иначе
		Элементы.НадписьМодельАвтомобиля.Заголовок = "  <Автомобиль неизвестен>";
	КонецЕсли;
	
	Взаимодействия.Очистить();
	Для Каждого Эл Из ДанныеПоВзаимодействиям Цикл
		Стр = Взаимодействия.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла;
	
	ОбщиеДанные.Свойство("ОтветЛиду", ОтветЛиду);
	ОбщиеДанные.Свойство("Телефон", Телефон);
	ОбщиеДанные.Свойство("Email", Email);	

	ТЗРабочиеЛисты.Очистить();
	Элементы.ПолеЕстьРабочийЛист.Доступность = Ложь;

	Для Каждого Эл Из ДанныеПоРабочимЛистам Цикл
		Стр = ТЗРабочиеЛисты.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла;
	
	Элементы.ПолеЕстьРабочийЛист.Доступность = ТЗРабочиеЛисты.Количество() > 0;
	Элементы.кнРабочиеЛисты.Видимость = ТЗРабочиеЛисты.Количество() > 0;   	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПоКлиенту(ВыбранныйТрафикID, ТипВыбранногоТрафика)
	ОбщиеДанные = Новый Структура();
	ДанныеТрафика = Новый Структура();
	ДанныеПоВзаимодействиям = Новый Массив();
	ДанныеПоРабочимЛистам = Новый Массив(); 	
	
	//Прочитаем новые данные клиента
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_Трафик.Период,
	|	Renault_Трафик.Идентификатор,
	|	Renault_Трафик.ТипТрафика,
	|	Renault_Трафик.Обработан,
	|	Renault_Трафик.Отдел,   
	|	Renault_Трафик.Менеджер,     
	|	Renault_Трафик.Администратор,
	|	Renault_Трафик.Клиент,   
	|	Renault_Трафик.ПервичныйПовторный,   
	|	Renault_Трафик.ДилерскийЦентр,
	|	Renault_Трафик.Представление,
	|	Renault_Трафик.Комментарий,      
	|	Renault_Трафик.ПервичныйИнтерес,  
	|	Renault_Трафик.ИсточникИнформации,  
	|	Renault_Трафик.Клиент.Наименование КАК Наименование, 
	|	Renault_Трафик.Клиент.Пол,
	|	Renault_Трафик.Клиент.Ссылка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(CRM_ВоронкаПродаж.ЭтапПродаж, ИСТИНА) = ИСТИНА
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК БылаВыдача,
	|	Renault_РабочиеЛисты.МодельАвтомобиля
	|ИЗ
	|	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
	|			ПО Renault_РабочиеЛисты.IDK = CRM_ВоронкаПродаж.IDK
	|				И (CRM_ВоронкаПродаж.ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.ВыдачаАвтомобиля))
	|		ПО Renault_Трафик.Клиент = Renault_РабочиеЛисты.Клиент
	|ГДЕ
	|	Renault_Трафик.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", ВыбранныйТрафикID);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеТрафика.Вставить("Отдел", Выборка.Отдел);
		ДанныеТрафика.Вставить("Менеджер", Выборка.Менеджер);
		ДанныеТрафика.Вставить("Клиент", Выборка.Клиент);
		ДанныеТрафика.Вставить("ПервичныйПовторный", Выборка.ПервичныйПовторный);
		ДанныеТрафика.Вставить("Комментарий", Выборка.Комментарий);
		ДанныеТрафика.Вставить("ПервичныйИнтерес", Выборка.ПервичныйИнтерес);
		ДанныеТрафика.Вставить("ИсточникИнформации", Выборка.ИсточникИнформации);
		ДанныеТрафика.Вставить("Наименование", Выборка.Наименование); 
		ДанныеТрафика.Вставить("БылаВыдача", Выборка.БылаВыдача);
		ДанныеТрафика.Вставить("МодельАвтомобиля", Выборка.МодельАвтомобиля);
	КонецЕсли;    	
	
	//Прочитаем события
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_СобытияПоРабочимЛистам.ВидСобытия КАК Событие,
	|	CRM_СобытияПоРабочимЛистам.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	|		ПО Renault_РабочиеЛисты.IDK = CRM_СобытияПоРабочимЛистам.IDK
	|ГДЕ
	|	CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
	|	И Renault_РабочиеЛисты.Клиент = &Клиент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Запрос.УстановитьПараметр("Клиент", Выборка.Клиент);
	ТабВзаимодействия = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр Из ТабВзаимодействия Цикл
		СтрокаВзаимодействия = Новый Структура("Событие, Дата");
		ЗаполнитьЗначенияСвойств(СтрокаВзаимодействия, Стр);
		
		ДанныеПоВзаимодействиям.Добавить(СтрокаВзаимодействия);
	КонецЦикла; 	
	
	ОтветЛиду = НайтиСохраненныйОтвет(ВыбранныйТрафикID);	
	ОбщиеДанные.Вставить("ОтветЛиду", ОтветЛиду);
	
	//Если ТипВыбранногоТрафика <> Справочники.CRM_ТипТрафика.Email Тогда //Закоментировал, так как не ясно для чего это
		Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Выборка.Клиент);
		ОбщиеДанные.Вставить("Телефон", Телефон);
	//КонецЕсли;
	//Если ТипВыбранногоТрафика <> Справочники.CRM_ТипТрафика.Email Тогда //Закоментировал, так как не ясно для чего это
		Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Выборка.Клиент);
		ОбщиеДанные.Вставить("Email", Email);
	//КонецЕсли;
	
	ТЗКлиенты = НайтиКлиентов(Телефон, Email);
	
	Если ТЗКлиенты.Количество() > 0 Тогда  		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ТЗКлиенты ИЗ &ТЗКлиенты КАК ТЗКлиенты";
		Запрос.УстановитьПараметр("ТЗКлиенты", ТЗКлиенты);
		Запрос.Выполнить();
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РабочиеЛисты.ID,
		|	Renault_РабочиеЛисты.Клиент,
		|	Renault_РабочиеЛисты.Сотрудник,
		|	Renault_РабочиеЛисты.ЛистЗакрыт,
		|	ТЗКлиенты.Почта,
		|	ТЗКлиенты.Телефон,
		|	Renault_РабочиеЛисты.ДатаID КАК Дата,
		|	Renault_РабочиеЛисты.IDK
		|ИЗ
		|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗКлиенты КАК ТЗКлиенты
		|		ПО Renault_РабочиеЛисты.Клиент.Ссылка = ТЗКлиенты.Ссылка";
	Иначе		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РабочиеЛисты.ID,
		|	Renault_РабочиеЛисты.Клиент,
		|	Renault_РабочиеЛисты.Сотрудник,
		|	Renault_РабочиеЛисты.ЛистЗакрыт,
		|	"""" КАК Почта,
		|	"""" КАК Телефон,
		|	Renault_РабочиеЛисты.ДатаID КАК Дата,
		|	Renault_РабочиеЛисты.IDK
		|ИЗ
		|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|ГДЕ Renault_РабочиеЛисты.Клиент.Ссылка = &Клиент";
		Запрос.УстановитьПараметр("Клиент", Выборка.Клиент);  		 		
	КонецЕсли;
	ТабРабочиеЛисты = Запрос.Выполнить().Выгрузить();  	
	
	Для Каждого Эл Из ТабРабочиеЛисты Цикл
		СтрокаРЛ = Новый Структура("ID, Клиент, Сотрудник, ЛистЗакрыт, Почта, Телефон, Дата, IDK");
		ЗаполнитьЗначенияСвойств(СтрокаРЛ, Эл);
		
		ДанныеПоРабочимЛистам.Добавить(СтрокаРЛ);
	КонецЦикла; 
	
	ДанныеПоКлиенту = Новый Структура("ОбщиеДанные, ДанныеТрафика, ДанныеПоВзаимодействиям, ДанныеПоРабочимЛистам",
		ОбщиеДанные, ДанныеТрафика, ДанныеПоВзаимодействиям, ДанныеПоРабочимЛистам);
	
	Возврат ДанныеПоКлиенту; 
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСохраненныйОтвет(ВыбранныйТрафикID)
	ОбработкаОК = Обработки.Renault_АРМ_ОнлайнКонсультант.Создать();   	
	ОтветЛиду = ОбработкаОК.ЗагрузитьСохраненныйОтвет(ВыбранныйТрафикID);
	
	Возврат ОтветЛиду;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиКлиентов(Телефон, Почта)
	
	Запрос = Новый Запрос;
	ТЗКлиенты = Новый ТаблицаЗначений;
	Телефон = СокрЛП(Телефон);
	Почта = СокрЛП(Почта);
	Если СтрДлина(Телефон) < 6 Тогда Телефон = ""; КонецЕсли;
	Если СтрДлина(Почта) < 6 Тогда Почта = ""; КонецЕсли;
	Если Телефон = "" И Почта = "" Тогда Возврат ТЗКлиенты; КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КИПочта.Ссылка,
	|	КИПочта.Почта КАК Почта,
	|	"""" КАК Телефон
	|ПОМЕСТИТЬ КИ
	|ИЗ
	|	(ВЫБРАТЬ
	|		КИ_Почта.Объект.Ссылка КАК Ссылка,
	|		ВЫРАЗИТЬ(КИ_Почта.Представление КАК СТРОКА(100)) КАК Почта
	|	ИЗ
	|		РегистрСведений.КонтактнаяИнформация КАК КИ_Почта
	|	ГДЕ
	|		КИ_Почта.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|		И (ВЫРАЗИТЬ(КИ_Почта.Представление КАК СТРОКА(100))) = &Почта
	|		И НЕ &Почта = """") КАК КИПочта
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КИТелефон.Ссылка,
	|	"""",
	|	КИТелефон.Телефон
	|ИЗ
	|	(ВЫБРАТЬ
	|		КИ_Телефон.Объект.Ссылка КАК Ссылка,
	|		ВЫРАЗИТЬ(КИ_Телефон.Представление КАК СТРОКА(100)) КАК Телефон,
	|		"""" КАК Почта
	|	ИЗ
	|		РегистрСведений.КонтактнаяИнформация КАК КИ_Телефон
	|	ГДЕ
	|		КИ_Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|		И (ВЫРАЗИТЬ(КИ_Телефон.Представление КАК СТРОКА(100))) = &Телефон
	|		И НЕ &Телефон = """") КАК КИТелефон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КИ.Ссылка,
	|	МАКСИМУМ(КИ.Почта) КАК Почта,
	|	МАКСИМУМ(КИ.Телефон) КАК Телефон
	|ИЗ
	|	КИ КАК КИ
	|
	|СГРУППИРОВАТЬ ПО
	|	КИ.Ссылка";
	Запрос.УстановитьПараметр("Почта", Почта);
	Запрос.УстановитьПараметр("Телефон", Телефон);
	ТЗКлиенты = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗКлиенты;
	
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьСтрокуШтмлСообщения(ОбработкаОК, ПредДатаСообщения, ПредВывод, НачатаТаблица, Сообщение, ЭтоСообщениеОператора = Ложь, НаименованиеОператора)
	СсылкаНаКартинкуОнлайнКонсультанта = ПоместитьВоВременноеХранилище(БиблиотекаКартинок.Renault_OnlineCons_Grey);

	ТекстКВозврату = "";
	ПредыдущийГод = Год(ПредДатаСообщения);
	ПредыдущийМесяц = Месяц(ПредДатаСообщения);
	ПредыдущийДень = День(ПредДатаСообщения);
	ТекущийГод = Год(Сообщение.ДатаСообщения);
	ТекущийМесяц = Месяц(Сообщение.ДатаСообщения);
	ТекущийДень = День(Сообщение.ДатаСообщения);
	ЭтоНовыйДеньСоощений = НЕ((ПредыдущийДень = ТекущийДень) И (ПредыдущийМесяц = ТекущийМесяц) И (ПредыдущийГод = ТекущийГод));
	Если ЭтоНовыйДеньСоощений Тогда
		Если НачатаТаблица Тогда
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "HR", 2);
			НачатаТаблица = Ложь;
		КонецЕсли;
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TABLE", 2, ОбработкаОК.СтруктураПараметровТаблицы("100%"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("", "", "DateText"), Формат(Сообщение.ДатаСообщения,"ДФ=""дд.ММ.гг"""), Истина);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
		ПредДатаСообщения = Сообщение.ДатаСообщения;
	КонецЕсли;
	ИмяОтправителя = Сообщение.ИмяПользователя;
	имяКласса = "IsFor";
	Если ЭтоСообщениеОператора Тогда
		ИмяОтправителя = НаименованиеОператора;
		ИмяКласса ="IsFrom";
	КонецЕсли;
	ПродолжитьВыводСообщения = (ПредВывод = ИмяОтправителя) И (НЕ ЭтоНовыйДеньСоощений);
	Если Не ПродолжитьВыводСообщения Тогда
		Если НачатаТаблица Тогда
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
			ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
		КонецЕсли;
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TABLE", 2, ОбработкаОК.СтруктураПараметровТаблицы("100%"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("25"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "IMG", 6, ОбработкаОК.СтруктураПараметровКартинки(СсылкаНаКартинкуОнлайнКонсультанта,"24", "24"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TD", 5);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("","","UserNick"), " > "+ИмяОтправителя+" ", Истина);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TR", 4);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TBODY", 3);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TABLE", 2);
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TABLE", 2, ОбработкаОК.СтруктураПараметровТаблицы("100%"));
		ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TBODY", 3);
		НачатаТаблица = Истина;
		ПредВывод = ИмяОтправителя;
	КонецЕсли;
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TR", 4);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("45", "", "DateText", "right", "top"),
	Формат(Сообщение.ДатаСообщения,"ДФ=""ЧЧ:мм:сс"""), Истина);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("5", "", "UserNick", "right", "top"), ">", Истина);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "TD", 5, ОбработкаОК.СтруктураПараметровЯчейки("", "" ,ИмяКласса), Сообщение.Сообщение, Истина);
	ОбработкаОК.ДобавитьТэгШтмл(ТекстКВозврату, "/TR", 4);
	Возврат ТекстКВозврату;
	
КонецФункции

