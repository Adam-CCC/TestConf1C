&НаКлиенте
Процедура НазначитьНаМенеджера()
	Если НЕ (ВыбранныйТрафикID = Неопределено) Тогда    		
		Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант") Тогда
			Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ВыбранныйТрафикID);

			ПараметрыФормы = Новый Структура("ДилерскийЦентр, ВидСообщения", Запись.ДилерскийЦентр, ПредопределенноеЗначение("Справочник.Renault_ВидСообщения.ОК_НовоеСообщение"));
			ОпОповещения = Новый ОписаниеОповещения("НазначитьНаМенеджераЗавершение", ЭтаФорма);
			ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаВыбораСотрудникаУпр", ПараметрыФормы, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ИначеЕсли ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault")
			ИЛИ ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
			Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ВыбранныйТрафикID);
		
			Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault") Тогда
				ВидСообщения = ПредопределенноеЗначение("Справочник.Renault_ВидСообщения.КЦ_НовыйЛид");
			Иначе
				ВидСообщения = ПредопределенноеЗначение("Справочник.Renault_ВидСообщения.КЦ_НовоеПисьмо");
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("ДилерскийЦентр, ВидСообщения", Запись.ДилерскийЦентр, ВидСообщения);
			ОпОповещения = Новый ОписаниеОповещения("НазначитьНаМенеджераЗавершение", ЭтаФорма);
			ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма.ФормаВыбораСотрудникаУпр", ПараметрыФормы, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли; 		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьНаМенеджераЗавершение(ВыбранныйМенеджер, ДопПараметры) Экспорт
	Если ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант") Тогда   
		Если НЕ (ВыбранныйМенеджер = Неопределено ИЛИ
			ВыбранныйМенеджер = ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка")) Тогда  			 
			
			Менеджер = ВыбранныйМенеджер;
			Отдел = Renault_CRM.ПолучитьОтделСотрудника(Менеджер); 
			
			НазначитьНаМенеджераЗавершениеСерверOnlineКонсультант(Отдел, ВыбранныйТрафикID, ВыбранныйМенеджер, Телефон);
			
			Если НеВозвращатьТрафик = Ложь Тогда
				НоваяСтрока = ТаблицаПеренаправленногоТрафика.Добавить();
				НоваяСтрока.ИдентификаторТрафика = ВыбранныйТрафикID;
				НоваяСтрока.Дата = ТекущаяДата();
			КонецЕсли;
			
			ОбновитьЧат();
			ОбновитьСписокТрафика();
			ПрочитатьДанныеКлиента();
		КонецЕсли;
		
		Если НеВозвращатьТрафик = Истина Тогда
			НеВозвращатьТрафикНажатие();
		КонецЕсли; 	
	ИначеЕсли ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.ЛидRenault")
			ИЛИ ТипВыбранногоТрафика = ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.Email") Тогда
		Если Не (ВыбранныйМенеджер = Неопределено ИЛИ ВыбранныйМенеджер = Справочники.Сотрудники.ПустаяСсылка()) тогда
			Менеджер = ВыбранныйМенеджер;
			Отдел = Renault_CRM.ПолучитьОтделСотрудника(Менеджер);
			
			НазначитьНаМенеджераЗавершениеСерверЛидRenaultИлиEmail(Отдел, ВыбранныйТрафикID, ВыбранныйМенеджер, Телефон);

			ОбновитьЧат();
			ОбновитьСписокТрафика();
			ПрочитатьДанныеКлиента();  
		КонецЕсли; 		
	КонецЕсли;    	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура НазначитьНаМенеджераЗавершениеСерверOnlineКонсультант(Отдел, ВыбранныйТрафикID, ВыбранныйМенеджер, Телефон)
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ВыбранныйТрафикID);
	Запись.Отдел = Отдел;
	Запись.Менеджер = ВыбранныйМенеджер;
	Запись.Записать();
	
	МенНовСообщ = РегистрыСведений.Renault_ОК_НовыйНеПросмотренныйТрафик.СоздатьМенеджерЗаписи();
	МенНовСообщ.Период = ТекущаяДата();
	МенНовСообщ.Идентификатор = Запись.Идентификатор;
	МенНовСообщ.Записать();		
		
	// Если назначаем на менеджера по сервису, то создадим обращение в сервис.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел
	|ИЗ
	|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	|ГДЕ
	|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник = &Сотрудник
	|	И Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел.КлассификацияRenault = &ОтделСервиса";
	Запрос.УстановитьПараметр("Сотрудник", ВыбранныйМенеджер);
	Запрос.УстановитьПараметр("ОтделСервиса", Перечисления.CRM_КлассификацияОтделов.ОтделСервиса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 			
		Поиск = Документы.Renault_CRM_ОбращениеВАвтоСервис.НайтиПоРеквизиту("ИдентификаторТрафика", ВыбранныйТрафикID);
		Если НЕ ЗначениеЗаполнено(Поиск) Тогда
			Документ = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
		Иначе
			Документ = Поиск.ПолучитьОбъект();
		КонецЕсли;
		
		Документ.Дата = ТекущаяДата();
		Документ.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.СРешепшен;
		Документ.ДилерскийЦентр = Запись.ДилерскийЦентр;
		Документ.Менеджер = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", ВыбранныйМенеджер);
		Документ.Клиент = Запись.Клиент;
		Документ.Примечание = "Из контакт-центра";
		Документ.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный;
		Документ.ОбращениеОбработано = Ложь; 			
		Документ.ИдентификаторТрафика = ВыбранныйТрафикID;
		
		Попытка
			Документ.ТелефонПримечание = Телефон;
		Исключение
			Документ.Примечание = Документ.Примечание + " Телефон клиента: " + Телефон;
		КонецПопытки;
		
		Документ.Записать(); 			
	КонецЕсли; 	
КонецПроцедуры

