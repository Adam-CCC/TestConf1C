	Форма = ОткрытьФорму("Справочник.CRM_Отделы.Форма.ФормаВыбораУпр",, ЭтаФорма,,,, ОпОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте 
Процедура ВыбратьОтделЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	ОтборОтдел = РезультатВыбора; 
	Если Не ЗначениеЗаполнено(ОтборОтдел) тогда
		ОтборОтдел = Renault_КонтактЦентр_Общий.ПолучитьОтделАвтосалона();
	КонецЕсли;
	СформироватьЗаголовокФормы();
	
	ОбновитьСписокСотрудников(ОтборОтдел);		
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьСписокСотрудников(ОтделДляСписка) Экспорт
	СписокСотрудников = ПолучитьСписокСотрудников(ОтделДляСписка);
	
	ТаблицаСтатусы.Очистить();
	Для Каждого Эл Из СписокСотрудников Цикл
		Стр = ТаблицаСтатусы.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла; 	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокСотрудников(ОтделДляСписка = Неопределено)
	ОтделПродаж = ОтделДляСписка;
	Если ОтделПродаж = Неопределено Тогда
		ОтделПродаж = Renault_КонтактЦентр_Общий.ПолучитьОтделАвтосалона();
	КонецЕсли;
	ТаблицаСотрудников = Renault_РаботаСПравамиПользователя.ПолучитьТаблицуСсылокНаСотрудниковПоОтделу(ОтделПродаж);
	МассивСотрудников = ТаблицаСотрудников.ВыгрузитьКолонку("Ссылка");
	ТаблицаСтатусы = Renault_КонтактЦентр_Общий.ПолучитьСтатусыСотрудников(МассивСотрудников);
	
	СписокСотрудников = Новый Массив;
	Для Каждого Стр Из ТаблицаСтатусы Цикл
		СтрокаСотрудников = Новый Структура("Сотрудник, ЗанятостьСотрудника, Статус");
		ЗаполнитьЗначенияСвойств(СтрокаСотрудников, Стр);
		СтрокаСотрудников.Вставить("Статус", ?(Стр.АктивностьПользователя, "Online", "Offline"));
		
		СписокСотрудников.Добавить(СтрокаСотрудников);
	КонецЦикла; 
	
	Возврат СписокСотрудников; 
КонецФункции

&НаКлиенте
Процедура СформироватьЗаголовокФормы(НаименованиеКлиента = "")
	ТекстЗаголовка = ?(ЗначениеЗаполнено(ОтборОтдел), "Отдел: " + Строка(ОтборОтдел) + " ", "");
	ТекстЗаголовка = ТекстЗаголовка + ?(ЗначениеЗаполнено(НаименованиеКлиента), "Клиент: " + НаименованиеКлиента + " ", "");
	ТекстПериод = "Период: ";
	Если НЕ ЗначениеЗаполнено(ОтборПериод.ДатаНачала) И
		НЕ ЗначениеЗаполнено(ОтборПериод.ДатаОкончания) Тогда
		ТекстПериод = ТекстПериод + "За всё время ";
	ИначеЕсли НачалоДня(ОтборПериод.ДатаНачала) = НачалоДня(ОтборПериод.ДатаОкончания) И
		 НачалоДня(ОтборПериод.ДатаНачала) = НачалоДня(ТекущаяДата()) Тогда
		ТекстПериод = ТекстПериод + "За сегодня "; 
	Иначе
		Если ЗначениеЗаполнено(ОтборПериод.ДатаНачала) Тогда
			ТекстПериод = ТекстПериод + "С " + Формат(ОтборПериод.ДатаНачала, "ДФ=dd.MM.yyyy") + " ";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОтборПериод.ДатаОкончания) Тогда
			ТекстПериод = ТекстПериод + "По " + Формат(ОтборПериод.ДатаОкончания, "ДФ=dd.MM.yyyy") + " ";
		КонецЕсли;
	КонецЕсли;  	
	ТекстЗаголовка = ТекстЗаголовка + ТекстПериод;
	
	ЭтаФорма.Заголовок = ТекстЗаголовка;	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеМеню()
	ПунктыМенюКоличество = ПунктыМеню.Количество();
	Для Н = 0 По ПунктыМенюКоличество - 1 Цикл 
		Эл = Элементы.Найти("гр" + ПунктыМеню[Н]);
		Если Эл = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Эл.Видимость = Н = ТекущаяЗакладкаМеню;
	КонецЦикла;	
	
	ЭлементыКнопокМеню = Элементы.грКнопкиМеню.ПодчиненныеЭлементы; 
	КоличествоКнопокМеню = ЭлементыКнопокМеню.Количество();
	Для Н = 1 По КоличествоКнопокМеню Цикл
		Эл = ЭлементыКнопокМеню[Н - 1];
		Если НЕ Эл.Видимость Тогда
			Продолжить;
		КонецЕсли;
		ЭтоТекущаяЗакладка = Сред(Эл.Имя,3) = ПунктыМеню[ТекущаяЗакладкаМеню].Значение;
		Эл.ЦветФона = ?(ЭтоТекущаяЗакладка, ЦветАктив, ЦветПассив);  
		Эл.ЦветРамки= ?(ЭтоТекущаяЗакладка, ЦветАктив, ЦветПассив);
	КонецЦикла; 	
КонецПроцедуры	

&НаКлиенте
Процедура НачальноеОформлениеФормы()
	Парам = Renault_ОбщиеФункции.МультибрендПараметрыОформления();
	ЦветАктив = Вычислить(Парам.ОсновнойЦвет);
	ЦветПассив = Вычислить(Парам.ДопЦвет2);
	ЦветСерый = Вычислить(Парам.ДопЦвет1);

	МассивАктив = Новый Массив;
	МассивАктив.Добавить(Элементы.кнОбновитьСписокТрафика);
	МассивАктив.Добавить(Элементы.кнПериодОтбора);
	МассивАктив.Добавить(Элементы.кнОткрытьНастройки);  
	МассивАктив.Добавить(Элементы.Переключатель);
	МассивАктив.Добавить(Элементы.Logo);
	
	МассивПассив = Новый Массив;
	МассивПассив.Добавить(Элементы.кнУстановитьОтделПродаж);
	МассивПассив.Добавить(Элементы.кнОтобразитьОткрытыйТрафик);
	МассивПассив.Добавить(Элементы.кнОтобразитьЗакрытыйТрафик);
	МассивПассив.Добавить(Элементы.кнОтобразитьОткрытыйТрафикМенеджеров);
	МассивПассив.Добавить(Элементы.кнПоказыватьУведомления);
	МассивПассив.Добавить(Элементы.кнПодключитьОнлайн);
	МассивПассив.Добавить(Элементы.кнБлокировки);

	Renault_ОбщиеФункции.МультибрендОсновноеОформление(МассивАктив, МассивПассив);	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьКонсультант()
	Задержка = ПараметрыОК.ЗадержкаОбновленияЧата;
	Если ЗначениеЗаполнено(Задержка) Тогда
		Если Задержка > 0 Тогда
			ПодключитьОбработчикОжидания("Renault_OK_НаличиеНовыхСообщенийЛок", Задержка);  
		Иначе
			ТолькоОбновлятьТрафик = Истина;
			ПодключитьОбработчикОжидания("Renault_OK_НаличиеНовыхСообщенийЛок", 2); 
		КонецЕсли;
	КонецЕсли;  	
КонецПроцедуры

&НаКлиенте
Процедура Renault_OK_НаличиеНовыхСообщенийЛок() Экспорт
	ОбновитьСписокСотрудников(ОтборОтдел);	  		
КонецПроцедуры
	
&НаСервере
Процедура МодульОбъектаЗаполнитьНастройкиПодключения()
	ОбъектФормы = РеквизитФормыВЗначение("Объект");
	ОбъектФормы.МодульОбъектаЗаполнитьНастройкиПодключения();
