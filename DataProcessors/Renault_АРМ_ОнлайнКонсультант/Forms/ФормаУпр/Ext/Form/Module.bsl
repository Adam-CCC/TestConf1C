&НаКлиенте
Процедура ЗавершитьРазговорЗавершение(ВыбранноеЗначение, ДопПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗакрытьТрафик(ВыбранныйТрафикID, ВыбранноеЗначение, ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант"));
	
	НачальноеОтображаениеЧатаИДанныхКлиента();
	
	ОбновитьСписокТрафика();	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРабочийЛист()
	Если НЕ ЗначениеЗаполнено(Менеджер) Тогда
		Сообщить("Создание рабочего листа возможно после выбора менеджера");
		Возврат;
	КонецЕсли;
	
	Если РабочийЛистСуществует(ВыбранныйТрафикID) Тогда 
		Сообщить("По данному трафику уже существует рабочий лист");
		Возврат;
	КонецЕсли;
	
	РЛ = Renault_КонтактЦентр_Общий.СоздатьРабочийЛистПоТрафику(ВыбранныйТрафикID);
	Если Не(РЛ = Неопределено) Тогда 
		Форм = РЛ.ПолучитьФорму("ФормаЗаписи", , "ФормаЗаписи" + Строка(РЛ.IDK));
		Если Форм.Открыта() Тогда
			Форм.Активизировать();
		Иначе
			Форм.Открыть();
		КонецЕсли;
		
		ЗакрытьТрафик(ВыбранныйТрафикID, ПредопределенноеЗначение("Справочник.Renault_РезультатОбработки.СозданРабочийЛист"), ПредопределенноеЗначение("Справочник.CRM_ТипТрафика.OnlineКонсультант"));
		
		НачальноеОтображаениеЧатаИДанныхКлиента();
		
		ОбновитьСписокТрафика();
	КонецЕсли;
КонецПроцедуры

