		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Попытка
				ДокСсылка = Выборка.Ссылка.ПолучитьОбъект();
				ДокСсылка.ТрафикОбработан = Истина;
				ДокСсылка.РезультатОбработки = ПричинаЗакрытия;
				ДокСсылка.Записать();
				Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИдТрафика);
				//Запись.Обработан = Истина;
				Запись.Закрытый = Истина;
				Запись.Записать();
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли ТипТрафика = Справочники.CRM_ТипТрафика.OnlineКонсультант Тогда
		Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИдТрафика);
		//Запись.Обработан = Истина;
		Если ЗначениеЗаполнено(ПричинаЗакрытия) Тогда
			Запись.Комментарий = Строка(ПричинаЗакрытия.Наименование);
		КонецЕсли;
		Запись.Закрытый = Истина;
		Запись.Записать();
		
		Renault_ОнлайнКонсультант.ЗакрытьСоединениеСКлиентом();
		
	ИначеЕсли ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
		Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИдТрафика);
		//Запись.Обработан = Истина;
		Запись.Закрытый = Истина;
		Запись.Записать();
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ *
		|ИЗ РегистрСведений.Renault_ТрафикПисьма КАК Renault_ТрафикПисьма
		|ГДЕ
		|	Renault_ТрафикПисьма.ИдТрафика = &ID";
		Запрос.УстановитьПараметр("ID", ИдТрафика);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Запись = РегистрыСведений.Renault_ТрафикПисьма.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.РезультатОбработки = ПричинаЗакрытия;
			Запись.Записать();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтметитьТрафикПоказаннымДо(ДатаОбновления, ИдТрафика) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_ОК_НовыйНеПросмотренныйТрафик.Период,
	|	Renault_ОК_НовыйНеПросмотренныйТрафик.Идентификатор
	|ИЗ
	|	РегистрСведений.Renault_ОК_НовыйНеПросмотренныйТрафик КАК Renault_ОК_НовыйНеПросмотренныйТрафик
	|ГДЕ
	|	Renault_ОК_НовыйНеПросмотренныйТрафик.Период <= &Период
	|	И Renault_ОК_НовыйНеПросмотренныйТрафик.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Период", ДатаОбновления);
	Запрос.УстановитьПараметр("Идентификатор", ИдТрафика);
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого Запись из Таблица Цикл
		Попытка
			Менеджер = РегистрыСведений.Renault_ОК_НовыйНеПросмотренныйТрафик.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Менеджер, Запись);
			Менеджер.Прочитать();
			Если Менеджер.Выбран() тогда
				Менеджер.Удалить();
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОК_Сообщения.id_mess
	|ИЗ РегистрСведений.Renault_ОК_Сообщения КАК ОК_Сообщения
	|ГДЕ
	|	ОК_Сообщения.IDТрафика = &Идентификатор
	|	И ГОД(ДатаВремяПрочтения) = 1";
	Запрос.УстановитьПараметр("Идентификатор", ИдТрафика);
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого Запись из Таблица Цикл
		Попытка
			Менеджер = РегистрыСведений.Renault_ОК_Сообщения.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Менеджер, Запись);
			Менеджер.Прочитать();
			Если Менеджер.Выбран() Тогда
				Менеджер.ДатаВремяПрочтения = ТекущаяДата();
				Менеджер.Записать();
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

