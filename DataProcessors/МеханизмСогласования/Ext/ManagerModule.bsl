Процедура ОтобразитьТекущееДеревоСогласований(УникальныйИдентификатор,ДеревоСогласований) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SM_СогласованиеДокументов.Документ КАК Документ,
		|	SM_ЭтапСогласования.НомерЭтапа КАК НомерЭтапа,
		|	SM_ЭтапСогласования.ТекущийСтатус КАК ТекущийСтатус,
		|	SM_СогласующиеЭтап.Согласующий КАК Согласующий,
		|	SM_СогласующиеЭтап.Ответ КАК Ответ,
		|	SM_СогласующиеЭтап.Причина КАК Причина
		|ИЗ
		|	РегистрСведений.SM_СогласованиеДокументов КАК SM_СогласованиеДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SM_ЭтапСогласования КАК SM_ЭтапСогласования
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.SM_СогласующиеЭтап КАК SM_СогласующиеЭтап
		|			ПО SM_ЭтапСогласования.УникальныйИдентификатор = SM_СогласующиеЭтап.УникальныйИдентификатор
		|				И SM_ЭтапСогласования.НомерЭтапа = SM_СогласующиеЭтап.НомерЭтапа
		|		ПО SM_СогласованиеДокументов.УникальныйИдентификатор = SM_ЭтапСогласования.УникальныйИдентификатор
		|ГДЕ
		|	SM_СогласованиеДокументов.УникальныйИдентификатор = &УникальныйИдентификатор
		|ИТОГИ ПО
		|	Документ,
		|	НомерЭтапа";
	Запрос.УстановитьПараметр("УникальныйИдентификатор",УникальныйИдентификатор);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	СформироватьТекущееДеревоСогласований(РезультатЗапроса,ДеревоСогласований);
КонецПроцедуры

Процедура СформироватьТекущееДеревоСогласований(РезультатЗапроса,ДеревоСогласований)
	Для Каждого СтрокаПервогоУровня Из РезультатЗапроса.Строки Цикл
		СтрокаСогласования = ДеревоСогласований.Строки.Добавить();
		СтрокаСогласования.ОбъектСогласования = СтрокаПервогоУровня.Документ;
		//СтрокаСогласования.СтатусОтвет        = СтрокаПервогоУровня.ТекущийСтатус;
		Для Каждого СтрокаВторогоУровня Из СтрокаПервогоУровня.Строки Цикл 
			СтрокаСогласования.СтатусОтвет        = (СтрокаВторогоУровня.ТекущийСтатус);
			СтрокаЭтапа = СтрокаСогласования.Строки.Добавить();
			СтрокаЭтапа.ОбъектСогласования = СтрШаблон("Номер этапа: %1",СтрокаВторогоУровня.НомерЭтапа);
			//СтрокаЭтапа.СтатусОтвет        = СтрокаВторогоУровня.ТекущийСтатус;
			Для Каждого СтрокаТретьегоУровня Из СтрокаВторогоУровня.Строки Цикл 
				СтрокаЭтапа.СтатусОтвет        = Строка(СтрокаТретьегоУровня.ТекущийСтатус);
				СтрокаСогласуюший = СтрокаЭтапа.Строки.Добавить();
				СтрокаСогласуюший.ОбъектСогласования = СтрокаТретьегоУровня.Согласующий;
				СтрокаСогласуюший.СтатусОтвет        = СтрокаТретьегоУровня.Ответ;
				СтрокаСогласуюший.Причина			 = СтрокаТретьегоУровня.Причина;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры