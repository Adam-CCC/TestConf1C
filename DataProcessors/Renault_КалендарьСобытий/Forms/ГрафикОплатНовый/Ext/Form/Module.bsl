Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) Если ИмяСобытия="ОбновитьСобытия" Тогда ОбновитьКалендарь() КонецЕсли КонецПроцедуры

&НаКлиенте
Процедура кнПриличныйИнтерфейс(Команда)
	Элементы.ГруппаШапкаФормы.Видимость=Истина;
	Элементы.ПаненьКнопок.Видимость=Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ИнтервалСлотаПриИзменении(Элемент) 
	Соответствие=Новый Соответствие;
	Соответствие.Вставить(1,5);
	Соответствие.Вставить(2,10);
	Соответствие.Вставить(3,15);
	Соответствие.Вставить(4,20);
	Соответствие.Вставить(5,30);
	Соответствие.Вставить(6,60);
	Календарь.ИнтервалСлота=Соответствие.Получить(Интервал);
	ЗаголовокИнтервала();
	ОбновитьHTML();
	ОбновитьПланировщик();
КонецПроцедуры
Процедура ЗаголовокИнтервала() Элементы.Интервал.Заголовок="Интервал "+Календарь.ИнтервалСлота+" мин." КонецПроцедуры

&НаСервере
Процедура ОбновитьПланировщик()
	
	Планировщик.ТекущиеПериодыОтображения.Очистить();
	
	ДатаНачала = Календарь.НачалоПериода;
	
	Пока ДатаНачала < Календарь.ОкончаниеПериода Цикл
		Планировщик.ТекущиеПериодыОтображения.Добавить(ДатаНачала + Календарь.ПервыйЧас*60*60, ДатаНачала + Календарь.ОкончаниеРабочегоВремени*60*60);
		ДатаНачала = ДатаНачала + 86400;
	КонецЦикла;
	
	ТекстЗадачи="
		|Выбрать
		|	События.Номер Номер,
		|   События.Комментарий,
		|	События.КомментарийЗакрытия,
		|	ЕстьNULL(Подстрока(РЛ.Клиент.НаименованиеПолное,0,100),"""") Клиент,
		|	ЕстьNULL(ВЫРАЗИТЬ (Контакты.Представление КАК СТРОКА(40)),"""") Телефон,
		|	События.ДатаНапоминания Начало,
		|	Выбор Когда События.Длительность=0 Тогда ДобавитьКДате(События.ДатаНапоминания,Минута,&ИнтервалСлота) Иначе ДобавитьКДате(События.ДатаНапоминания,Минута,Длительность) Конец Окончание,
		|	Выбор Когда События.ДатаЗакрытия=ДатаВремя(1,1,1) Тогда Ложь Иначе Истина Конец Завершено,
		|	События.ВидСобытия,
		|   События.ЦветФона,
		|   События.ЦветТекста
		|ИЗ Документ.CRM_СобытияПоРабочимЛистам События
		|Левое Соединение РегистрСведений.Renault_РабочиеЛисты РЛ 
		|	Левое Соединение РегистрСведений.КонтактнаяИнформация Контакты ПО РЛ.Клиент=Контакты.Объект И Контакты.Тип=ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон) И Контакты.ЗначениеПоУмолчанию=Истина
		|По События.IDK=РЛ.IDK 
		|ГДЕ События.Проведен И События.ДатаНапоминания Между &Дата1 И &Дата2 И События.ВидСобытия В(&ВидыСобытий)"
		+?(Календарь.Сотрудник.Пустая(),"",
		" И События.Сотрудник=&Сотрудник ");
	
	Запрос=Новый Запрос(ТекстЗадачи);
	Запрос.УстановитьПараметр("Дата1", Календарь.НачалоПериода);
	Запрос.УстановитьПараметр("Дата2", Календарь.ОкончаниеПериода);
	Запрос.УстановитьПараметр("ИнтервалСлота", Календарь.ИнтервалСлота);
	Запрос.УстановитьПараметр("ВидыСобытий", РазрешенныеВидыСобытий(Календарь.ВидыСобытий.ВыгрузитьЗначения()));
	Запрос.УстановитьПараметр("Сотрудник", Календарь.Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ВыведеноСобытий = 0;
	
	Планировщик.Элементы.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		лЭлемент = Планировщик.Элементы.Добавить(Выборка.Начало, Выборка.Окончание);
		лЭлемент.Текст = ПредставлениеСобытия(Выборка);
		лЭлемент.Значение = Выборка.Номер;
		лЭлемент.ЦветФона = Цвет(Выборка, "ЦветФона");
		лЭлемент.ЦветТекста = Цвет(Выборка, "ЦветТекста");
		
		ВыведеноСобытий = ВыведеноСобытий + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция Цвет(Выборка,ТипЦвета)
	
	Если Выборка.Завершено Тогда 
		Возврат ?(ТипЦвета = "ЦветФона", Новый Цвет(124,124,124), Новый Цвет(0,0,0)); 
	КонецЕсли;
	
	ОписаниеЦвета = ?(СокрЛП(Выборка[ТипЦвета]) = "", Выборка.ВидСобытия[ТипЦвета], Выборка[ТипЦвета]);
	МассивЦвета = РазложитьСтрокуВМассив(ОписаниеЦвета);
	Возврат Новый Цвет(МассивЦвета[0], МассивЦвета[1], МассивЦвета[2]);
	
КонецФункции

&НаСервере
Функция РазложитьСтрокуВМассив(ОписаниеЦвета)
	
	ОписаниеЦвета = СокрЛП(ОписаниеЦвета);
	МассивЦвета = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ОписаниеЦвета) Тогда
		МассивЦвета.Добавить(0);
		МассивЦвета.Добавить(0);
		МассивЦвета.Добавить(0);
		Возврат МассивЦвета;
	КонецЕсли;
	
	Позиция = Найти(ОписаниеЦвета, ",");
	Цифра = Лев(ОписаниеЦвета, Позиция - 1);
	МассивЦвета.Добавить(Число(Цифра));
	
	ОписаниеЦвета = Сред(ОписаниеЦвета, Позиция + 1, СтрДлина(ОписаниеЦвета) - Позиция);
	
	Позиция = Найти(ОписаниеЦвета, ",");
	Цифра = Лев(ОписаниеЦвета, Позиция - 1);
	МассивЦвета.Добавить(Число(Цифра));
	
	ОписаниеЦвета = Сред(ОписаниеЦвета, Позиция + 1, СтрДлина(ОписаниеЦвета) - Позиция);
	
	МассивЦвета.Добавить(Число(ОписаниеЦвета));
	
	Возврат МассивЦвета;
	
КонецФункции

&НаКлиенте
Процедура ПланировщикПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТипСобытия = "";
	
	НачалоСобытия = Начало;
	ОкончаниеСобытия = Конец;
	
	//вид события определяем по первому элемента списка видов события календаря
	ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
	Для Каждого Эл Из ЭтаФорма.Календарь.ВидыСобытий Цикл
		Если ТипЗнч(Эл.Значение) = Тип("СправочникСсылка.CRM_ВидыСобытий") Тогда
			ВидСобытия = Эл.Значение;
			Прервать
		КонецЕсли;	
	КонецЦикла;
	
	Если ТипСобытия = "ОФУ" Тогда
		
		ЗначенияЗаполнения=Новый Структура("Дата,ДатаЗакрытия,ВидСобытия,ОбластьПрименения", НачалоСобытия, ОкончаниеСобытия, ВидСобытия, Перечисления.Renault_ОбластиПрименения.ОФУ);
		ОткрытьФорму("Задача.Renault_События.ФормаОбъекта", ЗначенияЗаполнения, ЭтаФорма);
		
	Иначе
		
		Док = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
		Док.ВидСобытия = ВидСобытия;
		Док.IDK        = IDK;
		Док.ДатаНапоминания = НачалоСобытия;
		Док.Длительность = Окр((ОкончаниеСобытия-НачалоСобытия)/60, 0);
		Док.ПолучитьФорму("ФормаСозданияСобытия",ЭтаФорма,1).Открыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПередНачаломБыстрогоРедактирования(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.Планировщик.ВыделенныеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Док = Документы.CRM_СобытияПоРабочимЛистам.НайтиПоНомеру(Элементы.Планировщик.ВыделенныеЭлементы[0].Значение);
	Док.ПолучитьФорму("ФормаЗавершенияСобытия", ЭтаФорма).Открыть();
		
КонецПроцедуры

&НаСервере
Функция РазрешенныеВидыСобытий(МассивВсехСобытий) Экспорт 
	
	//МассивВсехСобытий - может содержать Справочники.CRM_ВидыСобытий,Перечисление.Renault_ОбластиПрименения
	События=ВыбратьСобытияИзОбластейПрименений(МассивВсехСобытий);
	
	МассивРазрешенных=Справочники.CRM_ВидыСобытий.РазрешенныеСобытия("Просмотр");
	Если События.Количество()=0 Тогда Возврат МассивРазрешенных КонецЕсли;
	
	МассивСобытий=Новый Массив;
	Для Каждого Событие Из События Цикл
		Если МассивРазрешенных.Найти(Событие)<>Неопределено Тогда
			МассивСобытий.Добавить(Событие)
		КонецЕсли;	
	КонецЦикла;	
	Возврат МассивСобытий
КонецФункции	

&НаСервере
Функция ВыбратьСобытияИзОбластейПрименений(Массив)
	События=Новый Массив;
	Для Каждого Эл Из Массив Цикл
		Если ТипЗнч(Эл)=Тип("СправочникСсылка.CRM_ВидыСобытий") Тогда
			События.Добавить(Эл)
		ИначеЕсли ТипЗнч(Эл)=Тип("ПеречислениеСсылка.Renault_ОбластиПрименения") Тогда
			Для Каждого ВидСобытия Из Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластиПрименения(Эл,"Просмотр") Цикл
				События.Добавить(ВидСобытия)
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
	Возврат События
КонецФункции

&НаСервере
Функция ПредставлениеСобытия(Выборка)
	
	Стр = СокрЛП(Выборка.Комментарий);
	
	Если НЕ ПустаяСтрока(Выборка.КомментарийЗакрытия) Тогда 
		Стр = Стр + Символы.ПС + СокрЛП(Выборка.КомментарийЗакрытия); 
	КонецЕсли;
	
	Если Выборка.Клиент <> "" Тогда 
		Стр = Стр + Символы.ПС + Выборка.Клиент; 
	КонецЕсли;
	
	Если Выборка.Телефон <> "" Тогда
		Стр = Стр + " (" + Выборка.Телефон + ")" ;
	КонецЕсли;
	
	Возврат Стр;
	
КонецФункции

&НаКлиенте
Процедура ПланировщикПриИзменении(Элемент)
	
	ВсегоСобытий = Планировщик.Элементы.Количество();
	Номер = 1;
	
	Для Каждого Строка Из Планировщик.Элементы Цикл
		
		Состояние("Проверка событий", Номер / ВсегоСобытий);
		
		ПроверитьИзменитьСобытие(Строка.Значение, Строка.Начало, Строка.Конец);
		
		Номер = Номер + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзменитьСобытие(НомерДокумента, ВремяНачало, ВремяКонец)
	
	Док = Документы.CRM_СобытияПоРабочимЛистам.НайтиПоНомеру(НомерДокумента);
	
	Если Док.ДатаНапоминания <> ВремяНачало Тогда
		
		лДок = Док.ПолучитьОбъект();
		лДок.ДатаНапоминания = ВремяНачало;
		
		Попытка
			лДок.Записать();
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры
