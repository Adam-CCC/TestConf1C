
Процедура ЗапуститьАРМАвтосервис(Параметры = Неопределено, КомандаОткрытия = Неопределено)Экспорт
	
	ДилерскийЦентрПользователя = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Если Не ЗначениеЗаполнено(ДилерскийЦентрПользователя) Тогда
		#Если Клиент Тогда
			Предупреждение("Для пользователя не задан дилерский центр!");
		#конецЕсли
		Возврат;
	КонецЕсли;
	
	Если ДилерскийЦентрПользователя.Автосервис_ИспользуетсяВерсия4 Тогда
	    ОткрытьФорму("Обработка.CRM_АРМ_АвтоСервис_4.Форма", , , "1");
	//ИначеЕсли ДилерскийЦентрПользователя.Автосервис_ИспользуетсяНоваяВерсияВ2 = Истина Тогда
	//    ОткрытьФорму("Обработка.CRM_АРМ_АвтоСервис_3.Форма",,,"1");
	ИначеЕсли ДилерскийЦентрПользователя.Автосервис_ИспользуетсяНоваяВерсия = Истина Тогда
		ОткрытьФорму("Обработка.CRM_АРМ_АвтоСервис_2.Форма",,,"1");
	Иначе
		Обработка = Обработки.CRM_АРМ_АвтоСервис.Создать();
		Форма = Обработка.ПолучитьФорму("Форма");
		Если ЗначениеЗаполнено(Параметры) Тогда
			ЗаполнитьЗначенияСвойств(Форма, Параметры);
		КонецЕсли;
		
		Если НЕ Форма.Открыта() Тогда
			Форма.Открыть();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ЗапуститьАРМАвтосервисМеханик(Параметры = Неопределено, КомандаОткрытия = Неопределено) Экспорт
	
	ДилерскийЦентрПользователя = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Если Не ЗначениеЗаполнено(ДилерскийЦентрПользователя) Тогда
		
		#Если Клиент Тогда
			
			Предупреждение("Для пользователя не задан дилерский центр!");
			
		#конецЕсли
		
		Возврат;
		
	КонецЕсли;
	
	Если ДилерскийЦентрПользователя.Автосервис_ИспользуетсяНоваяВерсия = Истина Тогда
		
		Обработка = Обработки.CRM_АРМ_АвтоСервис_2.Создать();
		
	Иначе
		
		Обработка = Обработки.CRM_АРМ_АвтоСервис.Создать();
		
	КонецЕсли;
	
	Форма = Обработка.ПолучитьФорму("ФормаИзмененияСтатусаРабот");
	
	Если ЗначениеЗаполнено(Параметры) Тогда
		
		ЗаполнитьЗначенияСвойств(Форма, Параметры);
		
	КонецЕсли;
	
	Если НЕ Форма.Открыта() Тогда
		
		Форма.Открыть();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВнешнийЗапрос(Обращение, Клиент, Автомобиль, ФормаАвтосервис2 = Неопределено, ПланируемНаДату = Неопределено) Экспорт
	
	ДилерскийЦентрПользователя = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Если Не ЗначениеЗаполнено(ДилерскийЦентрПользователя) Тогда
		
		#Если Клиент Тогда
			
			Предупреждение("Для пользователя не задан дилерский центр!");
			
		#конецЕсли
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если ДилерскийЦентрПользователя.Автосервис_ИспользуетсяВерсия4 Тогда
		
		Форма = ПолучитьФорму("Обработка.CRM_АРМ_АвтоСервис_4.Форма");
		
		Если НЕ Форма.Открыта() Тогда
			Форма.Открыть();
		КонецЕсли; 
		
		Форма.ТекущееОбращение = Обращение;
		
		Если ЗначениеЗаполнено(ПланируемНаДату) Тогда
			Форма.ТекущийРабочийДень = ПланируемНаДату;
			Форма.СформироватьГрафик();
		КонецЕсли;
		
		Форма.РедактированиеОбращения(Обращение, Ложь);
		
		Возврат Обращение;
		
	ИначеЕсли ДилерскийЦентрПользователя.Автосервис_ИспользуетсяНоваяВерсия = Истина Тогда
		//Козлов Е.А. Начало 11.05.2016
		Если ФормаАвтосервис2 = Неопределено Тогда
			Обработка = Обработки.CRM_АРМ_АвтоСервис_2.Создать();
			Форма = Обработка.ПолучитьФорму("Форма");
		Иначе
			Форма = ФормаАвтосервис2;	
		КонецЕсли;		
		//Обработка = Обработки.CRM_АРМ_АвтоСервис_2.Создать();
		//Форма = Обработка.ПолучитьФорму("Форма");
		//Козлов Е.А. Конец
	Иначе
		
		Обработка = Обработки.CRM_АРМ_АвтоСервис.Создать();
		Форма = Обработка.ПолучитьФорму("Форма");
		
	КонецЕсли;
	
	Форма.ТекущееОбращение = Обращение;
	Форма.ТекущееОбращениеРед = Обращение;
	
	Если ЗначениеЗаполнено(ПланируемНаДату) Тогда
		
		Форма.ТекущийРабочийДень = ПланируемНаДату;
		
	КонецЕсли;
	
	Форма.ВнешнийЗапрос(Обращение, Клиент, Автомобиль);
	
	//Козлов Е.А. Начало 11.05.2016
	//Если Форма.Открыта() Тогда
	//		
	//	Форма.Закрыть();
	//	
	//	Форма = Обработка.ПолучитьФорму("Форма");
	//		
	//Иначе
	//		
	//КонецЕсли;
	//	
	//Возврат Форма.ОткрытьМодально();

	Если ФормаАвтосервис2 = Неопределено Тогда
		
		Если Форма.Открыта() Тогда
			
			Форма.Закрыть();
			
			Форма = Обработка.ПолучитьФорму("Форма");
			
		Иначе
			
		КонецЕсли;
		
		Возврат Форма.ОткрытьМодально();
	Иначе
		
		Возврат Обращение;
	КонецЕсли;
	//Козлов Е.А. Конец
КонецФункции

Процедура ОткрытьФормуСпискаЗаказНарядов() Экспорт
	
	Форма = Документы.ЗаказНаряд.ПолучитьФормуСписка();
	
	Форма.Открыть();
	
КонецПроцедуры