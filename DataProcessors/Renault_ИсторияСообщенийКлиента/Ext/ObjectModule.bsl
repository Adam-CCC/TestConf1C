Функция ОписаниеКласса (ИмяКласса,Параметры,УровеньТэга = 0) Экспорт
	Ответ ="";
	Если (УровеньТэга >= 0) И (УровеньТэга <=8)Тогда 
		Для ит = 0 по УровеньТэга Цикл
			Ответ=Ответ+Символы.Таб;
		КонецЦикла;
	КонецЕсли;
    Ответ =Ответ+ "."+ИмяКласса+" {"+Символы.ПС+Параметры+Символы.ПС+"}";
	Возврат Ответ;
КонецФункции

Функция ОписаниеФункции (ИмяФункции, Параметры, УровеньТэга = 0) Экспорт
	Ответ ="";
	Если (УровеньТэга >= 0) И (УровеньТэга <=8)Тогда 
		Для ит = 0 по УровеньТэга Цикл
			Ответ=Ответ+Символы.Таб;
		КонецЦикла;
	КонецЕсли;
    Ответ =Ответ+ "function "+ИмяФункции+" {"+Символы.ПС+Параметры+Символы.ПС+"}";
	Возврат Ответ;
КонецФункции


Функция ПривестиКТипу(Реквизит, Значение) Экспорт
	Мета = Метаданные();
	рекв = Мета.Реквизиты[Реквизит];
	Возврат Рекв.Тип.ПривестиЗначение(Значение);
КонецФункции
