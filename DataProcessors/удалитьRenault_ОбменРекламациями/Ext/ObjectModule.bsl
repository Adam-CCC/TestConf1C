Процедура ДополнитьДанныеПеречислений(стрВыборки, РекламацияXDTO)
	
	ИндексЗначения = Перечисления.SAPPR_ВидЗаказаПоставщику.Индекс(стрВыборки.Рекламация.ТипЗаказа);
	РекламацияXDTO.ТипЗаказа = Метаданные.Перечисления.SAPPR_ВидЗаказаПоставщику.ЗначенияПеречисления[ИндексЗначения].Имя;
	
	ИндексЗначения = Перечисления.Renault_РекламацииСтатусы.Индекс(стрВыборки.Рекламация.ТекущийСтатус);
	РекламацияXDTO.ТекущийСтатус = Метаданные.Перечисления.Renault_РекламацииСтатусы.ЗначенияПеречисления[ИндексЗначения].Имя;
	
	ИндексЗначения = Перечисления.Renault_РекламацииВиды.Индекс(стрВыборки.Рекламация.ВидРекламации);
	РекламацияXDTO.ВидРекламации = Метаданные.Перечисления.Renault_РекламацииВиды.ЗначенияПеречисления[ИндексЗначения].Имя;
	
КонецПроцедуры // ДополнитьДанныеПеречислений(стрВыборки, РекламацияXDTO)

////@+ Процедура ДополнитьДанныеСправочников(стрВыборки, РекламацияXDTO)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="31.07.2013 9:37:00" Автор="Окипний Андрей Евгеньевич">
// <Имя>ДополнитьДанныеСправочников(стрВыборки, РекламацияXDTO) </Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
// <Параметры>
//  <Параметр> 
//  <ИмяПараметра>стрВыборки</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
//  <Параметр>
//  <ИмяПараметра>РекламацияXDTO</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//</Процедура>
//</Автодок>
//</xml>
//@-
Процедура ДополнитьДанныеСправочников(стрВыборки, РекламацияXDTO) 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	Номенклатура.НаименованиеИностранное,
	|	Номенклатура.Наименование,
	|	Номенклатура.НаименованиеПолное,
	|	Номенклатура.Артикул,
	|	Номенклатура.БазоваяЕдиницаИзмерения.Код КАК БазоваяЕдиницаКод,
	|	Номенклатура.ТипНоменклатуры КАК ТипНоменклатурыСсылка,
	|	Номенклатура.ВидНоменклатуры КАК ВидНоменклатурыСсылка,
	|	Номенклатура.Производитель КАК ПроизводительСсылка,
	|	ВЫБОР
	|		КОГДА Номенклатура.Производитель.СтранаПроисхождения ЕСТЬ NULL 
	|			ТОГДА """"
	|		ИНАЧЕ Номенклатура.Производитель.СтранаПроисхождения.Наименование
	|	КОНЕЦ КАК СтранаПроисхождения
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка"
	;
	
	//Номенклатура
	Если ЗначениеЗаполнено(стрВыборки.Рекламация.Номенклатура) тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Ссылка", стрВыборки.Рекламация.Номенклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Выборка.Следующий();
		
		НоменклатураXDTO = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ЭлементНоменклатура"));
		ЗаполнитьЗначенияСвойств(НоменклатураXDTO, Выборка);
		
		ИндексЗначения = Перечисления.ВидыНоменклатуры.Индекс(Выборка.ВидНоменклатурыСсылка);
		НоменклатураXDTO.ВидНоменклатуры = Метаданные.Перечисления.ВидыНоменклатуры.ЗначенияПеречисления[ИндексЗначения].Имя;
		
		
		//ТипНоменклатуры
		//+
		ТипНоменклатурыXDTO = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ЭлементТипНоменклатуры"));
		ЗаполнитьЗначенияСвойств(ТипНоменклатурыXDTO, Выборка.ТипНоменклатурыСсылка, ,"ВидНоменклатуры");
		
		ТипНоменклатурыXDTO.ОсновнаяБазоваяЕдиницаИзмеренияКод = Выборка.ТипНоменклатурыСсылка.ОсновнаяБазоваяЕдиницаИзмерения.Код;
		
		ИндексЗначения = Перечисления.ВидыНоменклатуры.Индекс(Выборка.ТипНоменклатурыСсылка.ВидНоменклатуры);
		ТипНоменклатурыXDTO.ВидНоменклатуры = Метаданные.Перечисления.ВидыНоменклатуры.ЗначенияПеречисления[ИндексЗначения].Имя;
		//-
		//////////////////////
		
		НоменклатураXDTO.ТипНоменклатуры = ТипНоменклатурыXDTO;
		
	КонецЕсли;
	
	РекламацияXDTO.Номенклатура = НоменклатураXDTO;
	
	НоменклатураXDTO	 = Неопределено;
	ТипНоменклатурыXDTO	 = Неопределено;
	
	//НоменклатураПлан
	Если ЗначениеЗаполнено(стрВыборки.Рекламация.НоменклатураПлан) тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Ссылка", стрВыборки.Рекламация.НоменклатураПлан);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Выборка.Следующий();
		
		НоменклатураXDTO = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ЭлементНоменклатура"));
		ЗаполнитьЗначенияСвойств(НоменклатураXDTO, Выборка);
		
		
		ИндексЗначения = Перечисления.ВидыНоменклатуры.Индекс(Выборка.ВидНоменклатурыСсылка);
		НоменклатураXDTO.ВидНоменклатуры = Метаданные.Перечисления.ВидыНоменклатуры.ЗначенияПеречисления[ИндексЗначения].Имя;
		
		
		//ТипНоменклатуры
		//+
		ТипНоменклатурыXDTO = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ЭлементТипНоменклатуры"));
		ЗаполнитьЗначенияСвойств(ТипНоменклатурыXDTO, Выборка.ТипНоменклатурыСсылка, ,"ВидНоменклатуры");
		
		ТипНоменклатурыXDTO.ОсновнаяБазоваяЕдиницаИзмеренияКод = Выборка.ТипНоменклатурыСсылка.ОсновнаяБазоваяЕдиницаИзмерения.Код;
		
		ИндексЗначения = Перечисления.ВидыНоменклатуры.Индекс(Выборка.ТипНоменклатурыСсылка.ВидНоменклатуры);
		ТипНоменклатурыXDTO.ВидНоменклатуры = Метаданные.Перечисления.ВидыНоменклатуры.ЗначенияПеречисления[ИндексЗначения].Имя;
		//-
		//////////////////////
		НоменклатураXDTO.ТипНоменклатуры = ТипНоменклатурыXDTO;
		
	КонецЕсли;
	
	РекламацияXDTO.НоменклатураПлан = НоменклатураXDTO;
	
	НоменклатураXDTO	 = Неопределено;
	ТипНоменклатурыXDTO	 = Неопределено;
	
КонецПроцедуры // ДополнитьДанныеСправочников(стрВыборки, РекламацияXDTO)

////@+ Процедура ДобавитьФотографии(стрВыборки, РекламацияXDTO)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="31.07.2013 11:02:50" Автор="Окипний Андрей Евгеньевич">
