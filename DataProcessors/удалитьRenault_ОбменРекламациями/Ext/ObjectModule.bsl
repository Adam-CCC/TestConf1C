Процедура ПолучитьИзмененныеИзПланаОбмена(Получатель, НомерСообщения)
	
	МассивРекламаций = Новый Массив;
	
	//Получаем данные из плана обмена
	Выборка = ПланыОбмена.ВыбратьИзменения(Получатель, НомерСообщения);
	
	//Пробежимся по выборке и распределим данные по массивам
	Пока Выборка.Следующий() Цикл
		
		Данные = Выборка.Получить();
		
		МассивРекламаций.Добавить(Данные.Ссылка);
		
	КонецЦикла;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Рекламация.Ссылка КАК Рекламация,
	               |	Рекламация.Номер КАК НомерДокДилера,
	               |	Рекламация.Дата КАК ДатаДокДилера,
	               |	Рекламация.Автор.Наименование КАК АвторДилера,
	               |	Рекламация.АктОПоврежденииСТК,
	               |	Рекламация.ВалютаДокумента.Код КАК ВалютаДокумента,
	               |	Рекламация.ГосНомерАвтомобиля,
	               |	Рекламация.ДатаАктаСТК,
	               |	Рекламация.ДатаДокВх,
	               |	Рекламация.ДатаПолученияГруза,
	               |	Рекламация.ДатаСФВх,
	               |	Рекламация.ДатаТТН,
	               |	Рекламация.Количество,
	               |	Рекламация.КоличествоМестЗафактурованно,
	               |	Рекламация.КоличествоМестПовреждено,
	               |	Рекламация.КоличествоМестПолучено,
	               |	Рекламация.КоличествоНоменклатурыЗафактурованно,
	               |	Рекламация.КоличествоПлан,
	               |	Рекламация.Комментарии,
	               |	Рекламация.КомментарийДилера,
	               |	&BIR КАК BIR_Грузополучателя,
	               |	Рекламация.КурсДокумента,
	               |	Рекламация.МаркаАвтомобиля,
	               |	Рекламация.НаличиеСборочнойКарты,
	               |	Рекламация.Номенклатура.Ссылка КАК НоменклатураСсылка,
	               |	Рекламация.НоменклатураПлан.Ссылка КАК НоменклатураПланСсылка,
	               |	Рекламация.НомерАктаСТК,
	               |	Рекламация.НомерДокВх,
	               |	Рекламация.НомерКоробки,
	               |	Рекламация.НомерМеста,
	               |	Рекламация.НомерСФвх,
	               |	Рекламация.НомерТТН,
	               |	Рекламация.ПредложениеИнициатора.Наименование КАК ПредложениеИнициатора,
	               |	Рекламация.ПричинаРекламации.Код КАК ПричинаРекламации,
	               |	Рекламация.Решение.Наименование КАК Решение,
	               |	Рекламация.СкладПолучатель.Наименование КАК СкладПолучатель,
	               |	Рекламация.СкладПолучатель.Renault_SiteNr КАК НомерПунктаДоставки,
	               |	Рекламация.Сумма,
	               |	Рекламация.СуммаПлан,
	               |	Рекламация.ТранспортнаяКомпания,
	               |	Рекламация.ФИОВодителя,
	               |	Рекламация.Цена,
	               |	Рекламация.ЦенаПлан,
	               |	Рекламация.ЕдИзмерения.Ссылка КАК ЕдИзмеренияСсылка,
	               |	Рекламация.ЕдИзмеренияПлан.Ссылка КАК ЕдИзмеренияПланСсылка,
	               |	Рекламация.СтавкаНДС.Ставка КАК СтавкаНДС,
	               |	Рекламация.СтавкаНДСПлан.Ставка КАК СтавкаНДСПлан,
	               |	Рекламация.СуммаНДС,
	               |	Рекламация.СуммаНДСПлан,
	               |	Рекламация.КонтрагентГрузоотправитель.ИНН КАК ИННОрганизации
	               |ИЗ
	               |	Документ.Renault_Рекламация КАК Рекламация
	               |ГДЕ
	               |	Рекламация.Ссылка В(&МассивРекламаций)
	               |	И НЕ Рекламация.ТекущийСтатус = ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииСтатусы.Draft)
	               |	И Рекламация.ПометкаУдаления = ЛОЖЬ"
	;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивРекламаций", МассивРекламаций);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("BIR", BIR);
	
	Запрос.Текст = ТекстЗапроса;
	
	ВыборкаРекламаций = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

Процедура ВыполнитьЗагрузкуСправочников()
	
	//удалим определение документа wsdl - его добавляем автоматически
	Адрес = АдресWS +"ws/reclamations.ws";
	
	ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/datatable", 
							   "Рекламации","РекламацииSoap12",600);
	
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	
	СправочникиXDTO = ВебСервис.getnci();
	
	РешенияПоРекламации		 = СправочникиXDTO.РешенияПоРекламации;
	ПредложенияПоРекламации	 = СправочникиXDTO.ПредложенияПоРекламации;
	ПричиныРекламации		 = СправочникиXDTO.ПричиныРекламации;
	
	ЗагрузитьПричиныРекламации(ПричиныРекламации);
	ЗагрузитьПредложенияПоРекламациям(ПредложенияПоРекламации);
	ЗагрузитьРешенияПоРекламациям(РешенияПоРекламации);
	
КонецПроцедуры

Процедура ВыполнитьЗагрузкуДокументов()
	
	Адрес = АдресWS +"ws/reclamations.ws";
	
	ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/datatable", 
							   "Рекламации","РекламацииSoap12",600);
	
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	СписокДокументовЦентра = ВебСервис.getreclamations(BIR);
	
	Если НЕ СписокДокументовЦентра = неопределено тогда
		
		ОбновитьДокументы(СписокДокументовЦентра);
		
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////

Функция ЗагрузитьПричиныРекламации(СписокПричин)
	
	Для каждого Причина Из СписокПричин.Причина Цикл
		
		НаименованиеПричины = Причина.Наименование;
		
		ЭлементПричина = Справочники.Renault_ПричиныРекламации.НайтиПоНаименованию(НаименованиеПричины);
		
		Если ЭлементПричина = Справочники.Renault_ПричиныРекламации.ПустаяСсылка() тогда
			ЭлементПричина = Справочники.Renault_ПричиныРекламации.СоздатьЭлемент();
			ЭтоНовый = Истина;
		Иначе
			ЭлементПричина = ЭлементПричина.ПолучитьОбъект();
			ЭтоНовый = Ложь;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭлементПричина, Причина);
		
		Если ЭтоНовый Тогда
			Если НЕ ЭлементПричина.ПометкаУдаления тогда
				ЭлементПричина.Записать();
			КонецЕсли;
		иначе
			ЭлементПричина.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ЗагрузитьПредложенияПоРекламациям(СписокПредложений)
	
	Для каждого Предложение Из СписокПредложений.Предложение Цикл
		
		НаименованиеПредложения = Предложение.Наименование;
		
		ЭлементПредложение = Справочники.Renault_ПредложенияПоРекламациям.НайтиПоНаименованию(НаименованиеПредложения);
		
		Если ЭлементПредложение = Справочники.Renault_ПредложенияПоРекламациям.ПустаяСсылка() тогда
			ЭлементПредложение = Справочники.Renault_ПредложенияПоРекламациям.СоздатьЭлемент();
			ЭтоНовый = Истина;
		Иначе
			ЭлементПредложение = ЭлементПредложение.ПолучитьОбъект();
			ЭтоНовый = Ложь;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭлементПредложение, Предложение);
		
		Если ЭтоНовый Тогда
			Если НЕ ЭлементПредложение.ПометкаУдаления тогда
				ЭлементПредложение.Записать();
			КонецЕсли;
		иначе
			ЭлементПредложение.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ЗагрузитьРешенияПоРекламациям(СписокРешений)
	
	Для каждого Решение Из СписокРешений.Решение Цикл
		
		НаименованиеРешения = Решение.Наименование;
		
		ЭлементРешение = Справочники.Renault_РешенияПоРекламациям.НайтиПоНаименованию(НаименованиеРешения);
		
		Если ЭлементРешение = Справочники.Renault_РешенияПоРекламациям.ПустаяСсылка() тогда
			ЭлементРешение = Справочники.Renault_РешенияПоРекламациям.СоздатьЭлемент();
			ЭтоНовый = Истина;
		Иначе
			ЭлементРешение = ЭлементРешение.ПолучитьОбъект();
			ЭтоНовый = Ложь;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ЭлементРешение, Решение);
		
		Если ЭтоНовый Тогда
			Если НЕ ЭлементРешение.ПометкаУдаления тогда
				ЭлементРешение.Записать();
			КонецЕсли;
		иначе
			ЭлементРешение.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

////@+ Процедура ОбновитьДокументы(СписокДокументов)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="02.08.2013 12:51:46" Автор="Окипний Андрей Евгеньевич">
// <Имя>ОбновитьДокументы(СписокДокументов)</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>СписокДокументов</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//</Процедура>
//</Автодок>
//</xml>
//@-
Процедура ОбновитьДокументы(СписокДокументов)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	Рекламация.Ссылка,
	|	Рекламация.Номер КАК НомерДокДилера
	|ИЗ
	|	Документ.Renault_Рекламация КАК Рекламация"
	);
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	Для Каждого РекламацияXDTO из СписокДокументов.Рекламация Цикл
		
		НС = ТаблицаДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НС, РекламацияXDTO);
		
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТаблицаДокументов.НомерДокДилера,
	|	ТаблицаДокументов.Ссылка
	|ПОМЕСТИТЬ ВрТЗ
	|ИЗ
	|	&ТаблицаДокументов КАК ТаблицаДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТЗ.НомерДокДилера,
	|	Рекламация.Ссылка
	|ИЗ
	|	ВрТЗ КАК ВрТЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_Рекламация КАК Рекламация
	|		ПО ВрТЗ.НомерДокДилера = Рекламация.Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВрТЗ"
	);
	Запрос.УстановитьПараметр("ТаблицаДокументов", ТаблицаДокументов);
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	
	Для каждого РекламацияXDTO из СписокДокументов.Рекламация Цикл
		
		РекламацияСтр = ТаблицаДокументов.Найти(РекламацияXDTO.НомерДокДилера, "НомерДокДилера");
		
		Если НЕ рекламацияСтр = Неопределено тогда
			
			РекламацияДок = РекламацияСтр.Ссылка.ПолучитьОбъект();
			
			//Временно
			Если Ложь тогда
				РекламацияДок = Документы.Renault_Рекламация.СоздатьДокумент();
			КонецЕсли;
			
			РекламацияДок.НомерДокЦентра = РекламацияXDTO.НомерДокЦентра;
			РекламацияДок.Комментарии = РекламацияXDTO.КомментарийЦентра;
			РекламацияДок.Решение = Справочники.Renault_РешенияПоРекламациям.НайтиПоНаименованию(РекламацияXDTO.Решение);
			РекламацияДок.ОписаниеРешения = РекламацияДок.Решение.Описание;
			
			РекламацияДок.ТекущийСтатус = Перечисления.Renault_РекламацииСтатусы[РекламацияXDTO.ТекущийСтатус];
			
			Если НЕ РекламацияДок.ПометкаУдаления тогда
				РекламацияДок.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				РекламацияДок.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ОбновитьДокументы(СписокДокументов)

Процедура ВыполнитьВыгрузкуРекламаций()
	
	ИмяФайлаВрем = ПолучитьИмяВременногоФайла("xml");
	
	//Получение узла обмена
	Узел = ПланОбмена;
	
	Запись_XML = Новый ЗаписьXML;
	Запись_XML.ОткрытьФайл(ИмяФайлаВрем);
	
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(Запись_XML, Узел);
	
	//Получим данные из плана обмена
	ПолучитьИзмененныеИзПланаОбмена(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	
	//Если документов нет, тогда и формировать не нужно.
	Если ВыборкаРекламаций.Количество() = 0 тогда
		
		//Выгружать нечего, просто возвращаемся
		Возврат;
		
	КонецЕсли;
	
	//Получение фабрики XDTO пакета
	Адрес = АдресWS +"ws/reclamations.ws";
	
	ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/datatable", 
							   "Рекламации","РекламацииSoap12",600);
	
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	
	СписокДокументов = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","СписокРекламаций_Inn"));
	
	Для Каждого стрВыборки из ВыборкаРекламаций Цикл
		
		//Подготовка данных. Выгрузка данных типа Null не возможна.
		Для Каждого Колонка из ВыборкаРекламаций.Колонки Цикл
			Если стрВыборки[Колонка.Имя] = Null тогда
				стрВыборки[Колонка.Имя] = "";
			КонецЕсли;
		КонецЦикла;
		
		РекламацияXDTO = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ДокументРекламация_Inn"));
		
		ЗаполнитьЗначенияСвойств(РекламацияXDTO, стрВыборки);
		
		//Добиваем справочники и перечисления.
		//Перечисления
		ДополнитьДанныеПеречислений(стрВыборки, РекламацияXDTO);
		
		//Справочники
		ДополнитьДанныеСправочников(стрВыборки, РекламацияXDTO);
		
		//Формирование списка фотографий.
		ДобавитьФотографии(стрВыборки, РекламацияXDTO);
		
		СписокДокументов.Рекламация.Добавить(РекламацияXDTO);
		
	КонецЦикла;
	
	Если СписокДокументов.Рекламация.Количество() > 0 тогда
		
		ВыгрузкаУспешна = ВебСервис.setreclamations(BIR, СписокДокументов);
		
		//Проставляем признак отправленных документов
		ПроставитьОтправлено();
		
	КонецЕсли;
	
КонецПроцедуры

///////////////////////////////////////////
//			Дополнительно

Процедура ПроставитьОтправлено()
	
	Для каждого Документ из ВыборкаРекламаций Цикл
		
		Если Документ.Renault_Рекламация.ТекущийСтатус = Перечисления.Renault_РекламацииСтатусы.ReadyToSent тогда
			
			ДокОбъект = Документ.Renault_Рекламация.ПолучитьОбъект();
			ДокОбъект.ТекущийСтатус = Перечисления.Renault_РекламацииСтатусы.Sent;
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

////@+ Процедура ДополнитьДанныеПеречислений(стрВыборки, РекламацияXDTO)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
