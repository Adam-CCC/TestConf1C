//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
// <Параметры>
//  <Параметр> 
//  <ИмяПараметра>стрВыборки</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
//  <Параметр>
//  <ИмяПараметра>РекламацияXDTO</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//</Процедура>
//</Автодок>
//</xml>
//@-
Процедура ДобавитьФотографии(стрВыборки, РекламацияXDTO)
	
	ТЧФотографииXDTO = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ФотографииРекламации"));
	
	Запрос = новый Запрос(
	"ВЫБРАТЬ
	|	КартинкиИФайлы.Идентификатор,
	|	КартинкиИФайлы.ИмяФайла,
	|	КартинкиИФайлы.ДатаСохранения,
	|	КартинкиИФайлы.Комментарий,
	|	КартинкиИФайлы.Данные КАК ХранилищеДанных
	|ИЗ
	|	РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы
	|ГДЕ
	|	КартинкиИФайлы.Объект = &Рекламация"
	);
	Запрос.УстановитьПараметр("Рекламация", стрВыборки.Рекламация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ФотографияXDTO = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","СтрокаФотография"));
		ЗаполнитьЗначенияСвойств(ФотографияXDTO, Выборка);
		
		ДДанные = Выборка.ХранилищеДанных.Получить();
		ФотографияXDTO.БинарныеДанные = ДДанные;
		
		ТЧФотографииXDTO.Фотография.Добавить(ФотографияXDTO);
		
	КонецЦикла;
	
	РекламацияXDTO.ТЧФотографии = ТЧФотографииXDTO;
	
КонецПроцедуры // ДобавитьФотографии(стрВыборки, РекламацияXDTO)

