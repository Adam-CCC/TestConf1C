Функция ОбъектВJSONстроку(объект) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	тНастройкиСериализации = Новый НастройкиСериализацииJSON;
    тНастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	тНастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением;
	ЗаписатьJSON(ЗаписьJSON, объект ,тНастройкиСериализации);
	стр = ЗаписьJSON.Закрыть();
	Возврат стр;
КонецФункции	


Функция ПолучитьВебСервисПоVOC2() Экспорт
	АдресWS	 = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].АдресWsCentral;
	ЛогинWS	 = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЛогинWSCentral;
	ПарольWS = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ПарольWsCentral;
	
	//удалим определение документа wsdl - его добавляем автоматически
	Адрес = АдресWS +"ws/RenaultPDRTab.1cws";
	Адрес = СтрЗаменить(Адрес, "?wsdl", "");
	
	Если Renault_ОбщегоНазначенияПовтИсп.Renault_Это83() Тогда
		
		ВЫПОЛНИТЬ("ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + ""?wsdl"", СокрЛП(ЛогинWS), СокрЛП(ПарольWS),,15)");
		

		
	Иначе
		
		ВСОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
		СокрЛП(ЛогинWS), СокрЛП(ПарольWS),15);
		
	КонецЕсли;
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/RenaultPDRTab",ВСОпределение.Сервисы[0].Имя,ВСОпределение.Сервисы[0].ТочкиПодключения[0].Имя);     
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	Возврат ВебСервис;
	
	
	
КонецФункции


Функция ВебСервисПолучитьНастройки() Экспорт 
	
	СтрокаНастроек = "";
	Токен = "tst-tst-tst";
	СтрРазд = "--";
	
	о1 = ЭтотОбъект;
	Если Не ЗначениеЗаполнено(о1.BIRDMD) Или не значениезаполнено(о1.ДилерскийЦентр) Тогда
		Возврат СтрокаНастроек;
	КонецЕсли;
	
	Таблица = Новый ТаблицаЗначений;
	
	ВебСервис = ПолучитьВебСервисПоVOC2();
	сОтбора = Новый Структура;
	dmdguid = о1.BIRDMD + СтрРазд + Токен + СтрРазд + Строка(о1.ДилерскийЦентр.УникальныйИдентификатор());
	сОтбора.Вставить("dmdguid", dmdguid); 
	
	ТаблицаVOC = ВебСервис.GetStock(dmdguid, "dbo.view_DMS_ONQUOT_SETTINGS", СериализаторXDTO.ЗаписатьXDTO(сОтбора), Истина, СериализаторXDTO.ЗаписатьXDTO(Новый Структура()));
	Таблица = СериализаторXDTO.ПрочитатьXDTO(ТаблицаVOC);
	
	Если Таблица<>Неопределено Тогда
		Если Таблица.Количество()>0 Тогда 
				// получаем мин и макс даты интервью с сервера
				Попытка
					СтрокаНастроек = Таблица[0]["jsonsettings"];
				Исключение
					
				КонецПопытки;
			Иначе
				//  по Биру нет данных вообще
			КонецЕсли;
		Иначе

		КонецЕсли;

 	  Возврат СтрокаНастроек;
КонецФункции




//! &НаСервереБезКонтекста	
Функция СоздатьПростой(ВремяНачала,ВремяОкончания,ДилерскийЦентр,Машиноместо,КодОшибки=0,Причина="РЕЗЕРВ ОНЛАЙН-ЗАПИСИ") Экспорт
	// ----  параметры 
	//ВремяНачала = Дата(2018,3,23,19,15,0);
	//ВремяОкончания = Дата(2018,3,23,19,59,59);
	//ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.НайтиПоНаименованию("Дилерский ЦентрПланшет");	
	//Машиноместо = Справочники.Цеха.НайтиПоНаименованию("цех Рено");
	//Причина = "РЕЗЕРВ ОНЛАЙН-ЗАПИСИ";
	// ----- 
	Рез = Неопределено;
	КодОшибки = 0;
	
    Отказ = Ложь;
	ЗапланироватьКолбасу(ВремяНачала, ВремяОкончания, Машиноместо, ДилерскийЦентр, Отказ);
	Если Отказ = Истина Тогда
		КодОшибки = 1;
		Возврат Рез;
	КонецЕсли;

	НачатьТранзакцию();
	НовыйДок = Документы.Renault_CRM_АвтосервисПростой.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДата();
	НовыйДок.ДилерскийЦентр = ДилерскийЦентр;
	НовыйДок.ВремяНачала = ВремяНачала;
	НовыйДок.ВремяОкончания = ВремяОкончания;
	НовыйДок.Цех = Машиноместо;
	НовыйДок.КодВидаПростоя=1;
	НовыйДок.ПричинаПростоя = Причина;
	Попытка 
		НовыйДок.Записать();
	Исключение
		ОтменитьТранзакцию();
		КодОшибки = 2;
		Возврат Неопределено;
	КонецПопытки;
	Рез = НовыйДок.Ссылка;
	
	Запись = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьМенеджерЗаписи();
	Запись.ДилерскийЦентр = ДилерскийЦентр;
	Запись.Период = ТекущаяДата();
	Запись.ВремяНачала = ВремяНачала;
	Запись.ВремяОкончания = ВремяОкончания;
	Запись.Цех = Машиноместо;
	Запись.ЭтапРабот = 1;
	Запись.Длительность = (Запись.ВремяОкончания - Запись.ВремяНачала) / 3600;
	Запись.РабочийДокумент = НовыйДок.Ссылка;
	Попытка
		Запись.Записать();
	Исключение
		ОтменитьТранзакцию();
		КодОшибки = 3;
		Возврат Неопределено;
	КонецПопытки;
	
	Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
	Запись.ДилерскийЦентр = ДилерскийЦентр;
	Запись.Период = ТекущаяДата();
	Запись.РабочийДокумент = НовыйДок.Ссылка;
	//Запись.ДатаВремяИзменения = ТекущаяДата();
	Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПростой;
	Запись.Цех = Машиноместо;
	Запись.ЭтапРабот = 1;
	Попытка
		Запись.Записать();
	Исключение
		ОтменитьТранзакцию();
		КодОшибки = 4;
		Возврат Неопределено;
	КонецПопытки;
	
	Попытка	
		ЗафиксироватьТранзакцию();
	Исключение
		КодОшибки = 5;
		Возврат Неопределено;
	КонецПопытки;

	Возврат Рез;
	
КонецФункции


//! &НаСервереБезКонтекста	
Процедура ЗапланироватьКолбасу(ВремяНачала, ВремяОкончания, Машиноместо, ДилерскийЦентр, Отказ)  Экспорт
	
	//Если НачалоРабочегоДня < НачалоДня(ТекущаяДата()) Тогда
	//	Отказ = Истина;
	//	Возврат;
	//КонецЕсли;
	
	НачалоРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ДилерскийЦентр, ВремяНачала);
	КонецРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ВремяНачала);	
	
	//Область = ЭлементыФормы.ПолеТабличногоДокумента.ВыделенныеОбласти[0].Имя;
	//Разделитель = Найти(Область, ":");
	//НачальнаяЯчейка = Лев(Область, Разделитель-1);
	//КонечнаяЯчейка = Прав(Область, СтрДлина(Область)-Разделитель);
	//ПерваяКолонка = Прав(НачальнаяЯчейка, СтрДлина(НачальнаяЯчейка)-Найти(НачальнаяЯчейка, "C"));
	//ПоследняяКолонка = Прав(КонечнаяЯчейка, СтрДлина(КонечнаяЯчейка)-Найти(КонечнаяЯчейка, "C"));
	//ВремяНачала = НачалоРабочегоДня + (ШагПланирования * 60) * (ПерваяКолонка-3);
	//ВремяОкончания = НачалоРабочегоДня + (ШагПланирования * 60) * (ПоследняяКолонка-2);
	//ПерваяСтрока = Сред(НачальнаяЯчейка, 2, Найти(НачальнаяЯчейка, "C")-2);
	//Машиноместо = ЭлементыФормы.ПолеТабличногоДокумента.Область("R" + ПерваяСтрока + "C1").Расшифровка;
	
	Если ВремяНачала < ТекущаяДата() Тогда
		//Сообщить("Нельзя назначить на прошлое время!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисПланРабот.Обращение КАК Обращение,
	|	Renault_АвтосервисПланРабот.РабочийДокумент КАК РабочийДокумент,
	|	Renault_АвтосервисПланРабот.Цех КАК Цех,
	|	Renault_АвтосервисПланРабот.ЭтапРабот КАК ЭтапРабот,
	|	Renault_АвтосервисПланРабот.ВремяНачала КАК ВремяНачала,
	|	Renault_АвтосервисПланРабот.ВремяОкончания КАК ВремяОкончания,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала КАК ВремяНачалаПлан,
	|	Renault_АвтосервисПланОперативныйСрезПоследних.ВремяОкончания КАК ВремяОкончанияПлан,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.ВремяНачала КАК ВремяНачалаФакт,
	|	Renault_АвтосервисФактОперативныйСрезПоследних.ВремяОкончания КАК ВремяОкончанияФакт,
	|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	|		ПО (Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение = Renault_АвтосервисПланРабот.Обращение)
	|			И (Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент = Renault_АвтосервисПланРабот.РабочийДокумент)
	|			И (Renault_АвтосервисСтатусыРаботСрезПоследних.ЭтапРабот = Renault_АвтосервисПланРабот.ЭтапРабот)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланОперативный.СрезПоследних КАК Renault_АвтосервисПланОперативныйСрезПоследних
	|		ПО (Renault_АвтосервисПланОперативныйСрезПоследних.Обращение = Renault_АвтосервисПланРабот.Обращение)
	|			И (Renault_АвтосервисПланОперативныйСрезПоследних.РабочийДокумент = Renault_АвтосервисПланРабот.РабочийДокумент)
	|			И (Renault_АвтосервисПланОперативныйСрезПоследних.ЭтапРабот = Renault_АвтосервисПланРабот.ЭтапРабот)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисФактОперативный КАК Renault_АвтосервисФактОперативныйСрезПоследних
	|		ПО (Renault_АвтосервисФактОперативныйСрезПоследних.Обращение = Renault_АвтосервисПланРабот.Обращение)
	|			И (Renault_АвтосервисФактОперативныйСрезПоследних.РабочийДокумент = Renault_АвтосервисПланРабот.РабочийДокумент)
	|			И (Renault_АвтосервисФактОперативныйСрезПоследних.ЭтапРабот = Renault_АвтосервисПланРабот.ЭтапРабот)
	|			И (Renault_АвтосервисФактОперативныйСрезПоследних.ВремяНачала >= &НачалоРабочегоДня)
	|ГДЕ
	|	Renault_АвтосервисПланРабот.Цех = &Цех
	|	И ВЫБОР
	|			КОГДА Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала ЕСТЬ NULL 
	|				ТОГДА ((Renault_АвтосервисПланРабот.ВремяНачала >= &НачалоСобытия
	|						И Renault_АвтосервисПланРабот.ВремяНачала <= &КонецСобытия)
	|					ИЛИ (Renault_АвтосервисПланРабот.ВремяОкончания >= &НачалоСобытия
	|						И Renault_АвтосервисПланРабот.ВремяОкончания <= &КонецСобытия)
	|					или
	|					(  &НачалоСобытия >= Renault_АвтосервисПланРабот.ВремяНачала И &НачалоСобытия < Renault_АвтосервисПланРабот.ВремяОкончания)
	|					  ИЛИ
	|					  (  &КонецСобытия > Renault_АвтосервисПланРабот.ВремяНачала И &КонецСобытия <= Renault_АвтосервисПланРабот.ВремяОкончания)
	|					 ИЛИ
	|					  (  &НачалоСобытия <= Renault_АвтосервисПланРабот.ВремяНачала И &КонецСобытия >= Renault_АвтосервисПланРабот.ВремяОкончания)
	|					)
	|							И НЕ Renault_АвтосервисПланРабот.ВремяНачала ЕСТЬ NULL 
	|							И НЕ Renault_АвтосервисПланРабот.ВремяОкончания ЕСТЬ NULL 
	|			ИНАЧЕ Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала >= &НачалоСобытия
	|						И Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала <= &КонецСобытия
	|					ИЛИ Renault_АвтосервисПланОперативныйСрезПоследних.ВремяОкончания >= &НачалоСобытия
	|						И Renault_АвтосервисПланОперативныйСрезПоследних.ВремяОкончания <= &КонецСобытия
	|						И НЕ Renault_АвтосервисПланОперативныйСрезПоследних.ВремяНачала ЕСТЬ NULL 
	|						И НЕ Renault_АвтосервисПланОперативныйСрезПоследних.ВремяОкончания ЕСТЬ NULL 
	|		КОНЕЦ
	|	И НЕ Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы = &Выполнена";
	
	Запрос.УстановитьПараметр("Выполнена", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	Запрос.УстановитьПараметр("НачалоСобытия", ВремяНачала);
	Запрос.УстановитьПараметр("НачалоРабочегоДня", НачалоРабочегоДня);
	Запрос.УстановитьПараметр("КонецСобытия", ВремяОкончания);
	Запрос.УстановитьПараметр("Цех", Машиноместо);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		//Сообщить("Нельзя тут планировать!!!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры



Процедура НайтиСвободногоПриемщика(ДилерскийЦентр, ДатаНач) 
	
	ДлитПриемки = ?(ЗначениеЗаполнено(ДилерскийЦентр.ДлительностьПриемки),ДилерскийЦентр.ДлительностьПриемки,15);
	ДлитВыдачи = ?(ЗначениеЗаполнено(ДилерскийЦентр.ДлительностьВыдачи),ДилерскийЦентр.ДлительностьВыдачи,15);
	
	
	сообщить("Работающие:");
	//документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент()
	ДатаКон = ДатаНач + ДлитПриемки*60;
	т1 = Renault_АвтосервисПланированиеПовтИспользования.Renault_ПолучитьИсполнителейЗаПериод(ДатаНач,ДатаКон);
	Для каждого с1 из т1 цикл
		сообщить(с1.Сотрудник);
	Конеццикла;

	ТаблицаЗанятости = Новый ТаблицаЗначений;
	ТекущийРабочийДень = НачалоДня(ДатаНач);
	НачалоРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень);
	КонецРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень);
	ВыделятьСебя = Ложь;
	ТолькоРаботающие = Ложь;
	ОтборМашиноместо = Неопределено;
	ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.МастерПриемщик;
	т2 = Renault_АвтосервисПланирование.ПолучитьТаблицуМашиномест(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, 
	ВыделятьСебя, ТолькоРаботающие, ОтборМашиноместо, ОтборВидМашиноместа, ПараметрыСеанса.Пользователь.Сотрудник, ТаблицаЗанятости);
	
	сообщить("Вообще все:");

	Для каждого с2 из т2 цикл
		Отказ = Ложь;
		ЗапланироватьКолбасу(ДатаНач, ДатаКон, с2.Машиноместо, ДилерскийЦентр, Отказ);
				
		сообщить(строка(с2.Машиноместо) + " : " + строка(не Отказ));
	Конеццикла;

	
	Сообщить("...тест");
	
	// ТЗГрафик = Renault_АвтосервисОбщий.Renault_ПолучитьИсполнителейЗаПериод(НачалоРабочегоДня, КонецРабочегоДня, Машиноместо, Неопределено);
КонецПроцедуры


//! &НаСервереБезКонтекста	
Функция ПриемщикРаботаетПоГрафикуВПериод( ДатаНач, ДатаКон, Приемщик)  Экспорт  // булево
	Рез = Ложь;
	т1 = Renault_АвтосервисПланированиеПовтИспользования.Renault_ПолучитьИсполнителейЗаПериод(ДатаНач,ДатаКон,Приемщик);
	Если т1.Количество()>0 Тогда
		Рез = Истина;
	КонецЕсли;
	Возврат Рез;
КонецФункции


//! &НаСервереБезКонтекста	
Функция ПолучитьМассивСвободныхПриемщиков(ДилерскийЦентр, ДатаНач, ДатаКон)  Экспорт
	
	Рез = Новый Массив;
	//  возвращаем работающих, если есть
	Рез1 = Новый Массив;
	
	ТаблицаЗанятости = Новый ТаблицаЗначений;
	ТекущийРабочийДень = НачалоДня(ДатаНач);
	НачалоРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень);
	КонецРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень);
	ВыделятьСебя = Ложь;
	ТолькоРаботающие = Ложь;
	ОтборМашиноместо = Неопределено;
	ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.МастерПриемщик;
	т2 = Renault_АвтосервисПланирование.ПолучитьТаблицуМашиномест(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, 
	ВыделятьСебя, ТолькоРаботающие, ОтборМашиноместо, ОтборВидМашиноместа, ПараметрыСеанса.Пользователь.Сотрудник, ТаблицаЗанятости);
	
	// так находим вообще всех приемщиков

	Для каждого с2 из т2 цикл
		Отказ = Ложь;
		ЗапланироватьКолбасу(ДатаНач, ДатаКон, с2.Машиноместо, ДилерскийЦентр, Отказ);
		Если Отказ = Ложь Тогда
			Рез.Добавить(с2.Машиноместо);
			Если ПриемщикРаботаетПоГрафикуВПериод( ДатаНач, ДатаКон, с2.Машиноместо) Тогда
				Рез1.Добавить(с2.Машиноместо);
			КонецЕсли;

		КонецЕсли;	
	Конеццикла;

	Если Рез1.Количество()>0 Тогда
		Возврат Рез1;
	Иначе
		Возврат Рез;
	КонецЕсли;
	
	// ТЗГрафик = Renault_АвтосервисОбщий.Renault_ПолучитьИсполнителейЗаПериод(НачалоРабочегоДня, КонецРабочегоДня, Машиноместо, Неопределено);
КонецФункции


//! &НаСервереБезКонтекста	
Функция ПолучитьСвободногоМастераПриемщика(ДилерскийЦентр, ДатаНач, ДатаКон)  Экспорт
	
	РезМастер = Неопределено;
	
	Гсч = Новый ГенераторСлучайныхЧисел();
	Рез = Новый Массив;
	//  возвращаем работающих, если есть
	
		
	ТаблицаЗанятости = Новый ТаблицаЗначений;
	ТекущийРабочийДень = НачалоДня(ДатаНач);
	НачалоРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень);
	КонецРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень);
	ВыделятьСебя = Ложь;
	ТолькоРаботающие = Ложь;
	ОтборМашиноместо = Неопределено;
	ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.МастерПриемщик;
	// так находим вообще всех приемщиков
	т2 = Renault_АвтосервисПланирование.ПолучитьТаблицуМашиномест(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, 
	ВыделятьСебя, ТолькоРаботающие, ОтборМашиноместо, ОтборВидМашиноместа, ПараметрыСеанса.Пользователь.Сотрудник, ТаблицаЗанятости);
	
	
	Рез1 = Новый Массив;
	
	Для каждого с2 из т2 цикл
		Отказ = Ложь;
		ЗапланироватьКолбасу(ДатаНач, ДатаКон, с2.Машиноместо, ДилерскийЦентр, Отказ);
		Если Отказ = Ложь Тогда
			Рез.Добавить(с2.Машиноместо);
			Если ПриемщикРаботаетПоГрафикуВПериод( ДатаНач, ДатаКон, с2.Машиноместо) Тогда
				Рез1.Добавить(с2.Машиноместо);
			КонецЕсли;
		КонецЕсли;	
	Конеццикла;
	
	Если Рез1.Количество()>0 Тогда
		НомерПриемщика = Гсч.СлучайноеЧисло(0,Рез1.Количество()-1);
		РезМастер = Рез1[НомерПриемщика];
	Иначе
		Если Рез.Количество()>0 Тогда
			НомерПриемщика = Гсч.СлучайноеЧисло(0,Рез.Количество()-1);
			РезМастер = Рез[НомерПриемщика];
		КонецЕсли;

	КонецЕсли;

		
	Возврат РезМастер;
	
	// ТЗГрафик = Renault_АвтосервисОбщий.Renault_ПолучитьИсполнителейЗаПериод(НачалоРабочегоДня, КонецРабочегоДня, Машиноместо, Неопределено);
КонецФункции






//! &НаСервереБезКонтекста
