	с.Вставить("ГУИДзаписи",ГУИДзаписи);
	с.Вставить("ДатаНачала",Дата(1,1,1,0,0,0));
	с.Вставить("ДатаОкончания",Дата(1,1,1,0,0,0));
	с.Вставить("ЦехГУИД","");
	с.Вставить("ДилерскийЦентр",Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка());
	с.Вставить("Цех",Справочники.Цеха.ПустаяСсылка());
	с.Вставить("СтатусРезерва",0);
	с.Вставить("ЗагруженНаСервер",Ложь);
	с.Вставить("ДняГуид","");
	с.Вставить("BIRDMD","");
	с.Вставить("ДокументГрафикаСервиса",Неопределено);
	с.Вставить("ИнформацияОЗаписи","");
	с.Вставить("ДатаСинхр",Дата(1,1,1,0,0,0));
	с.Вставить("БрониГУИД","");
	с.Вставить("ОбращениеНаСервис",Неопределено);
	с.Вставить("VIN","");
	с.Вставить("ЗаказНаряд",Неопределено);
	с.Вставить("ЛокСтатус",0);
	с.Вставить("ДокументГрафикаПриемка",Неопределено);
	с.Вставить("ДокументГрафикаВыдача",Неопределено);
	с.Вставить("КодОшибки",0);
	Возврат с;
	
	
КонецФункции


//! &НаСервереБезКонтекста	
Функция СохранитьСлотЛокально(СтруктСлот,СписокСвойств="") Экспорт
	Набор = РегистрыСведений.Renault_СлотыОнлайнЗаписи.СоздатьНаборЗаписей();
	Набор.Отбор.ГУИДзаписи.Установить(СтруктСлот.ГУИДзаписи);
	Набор.Прочитать();
	Если Набор.Количество() > 0 Тогда
		Если СписокСвойств="" Тогда 
			ЗаполнитьЗначенияСвойств(Набор[0],СтруктСлот);	
		Иначе
			ЗаполнитьЗначенияСвойств(Набор[0],СтруктСлот,СписокСвойств);	
		КонецЕсли;
	Иначе
		НоваяЗапись = Набор.Добавить(); 
		Если СписокСвойств="" Тогда 
			ЗаполнитьЗначенияСвойств(НоваяЗапись,СтруктСлот);				
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяЗапись,СтруктСлот,СписокСвойств);	
		КонецЕсли;

	КонецЕсли;
	Попытка
		Набор.Записать();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;
КонецФункции


//! &НаСервереБезКонтекста	
Функция ПрочитатьСлотЛокально(СтруктСлот) Экспорт
	Рез = Ложь;
	Слот = ПрочитатьСлотЛокальноПоГУИД(СтруктСлот.ГУИДзаписи);
	Если Слот.ГУИДзаписи = СтруктСлот.ГУИДзаписи Тогда
		  ЗаполнитьЗначенияСвойств(СтруктСлот,Слот);
		  Рез = Истина;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

//! &НаСервереБезКонтекста	
Функция ПрочитатьСлотЛокальноПоГУИД(ГУИДзаписи) Экспорт
	СтруктСлот = ВернутьСтруктуруГУИДЗаписи();
	Набор = РегистрыСведений.Renault_СлотыОнлайнЗаписи.СоздатьНаборЗаписей();
	Набор.Отбор.ГУИДзаписи.Установить(ГУИДзаписи);
	Набор.Прочитать();
	Если Набор.Количество() > 0 Тогда
	  ЗаполнитьЗначенияСвойств(СтруктСлот,Набор[0]);	
      
	КонецЕсли;
	Возврат СтруктСлот;

КонецФункции



