			Рез.ДатаНач = Дата(ответ1.tsdateyear,ответ1.tsdatemonth,ответ1.tsdateday, ответ1.timestarth,0,0);
			Рез.ДатаКон = Дата(ответ1.tsdateyear, ответ1.tsdatemonth, ответ1.tsdateday, ответ1.timeendh,0,0);
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Запись на : " + Формат(Рез.ДатаНач,"ДФ=""дд.ММ.гггг ЧЧ:мм""") +  Символы.ПС + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + Рез.ФИО + Символы.ПС + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Перезвонить клиенту: " + ?(Рез.НужноПозвонить,"ДА","нет") +  Символы.ПС+ Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Тел: " + ответ1.telephone +  Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Email: " + ответ1.email +  Символы.ПС +  Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Модель: " + ответ1.ModelDesc.ModelCode +  Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Версия: " + ответ1.ModelDesc.VersionCode +  Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Двигатель: " + ответ1.ModelDesc.EngineType+" " + ответ1.ModelDesc.FuelType+  Символы.ПС;
			
			//Рез.ПолнаяСтрока = Рез.ПолнаяСтрока +  ответ1.ModelDesc.ModelCode+" "+ответ1.ModelDesc.VersionCode+" "+ответ1.ModelDesc.EngineType+" " + ответ1.ModelDesc.FuelType + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "VIN: "+ответ1.VIN + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Пробег: "+ ответ1.odometer + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Кондиционер: "+?(СокрЛП(ответ1.ModelDesc.AirConditioner)="yes","да","нет") + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "ABS: "+?(СокрЛП(ответ1.ModelDesc.ABS)="yes","да","нет") + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "ГУР: "+?(СокрЛП(ответ1.ModelDesc.PowerSteering)="yes","да","нет") + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Салонный фильтр: "+?(СокрЛП(ответ1.ModelDesc.CabinFilter)="yes","да","нет") + Символы.ПС +  Символы.ПС;
					
			Если ответ1.ComplexCodeList<>Неопределено и  ответ1.ComplexCodeList.Количество()>0 Тогда
				Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Комплекс сервисы:" + Символы.ПС;
	  
				Для и1 = 0 По ответ1.ComplexCodeList.Количество() - 1 Цикл
					Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + ответ1.ComplexCodeList[и1] + Символы.ПС;
				КонецЦикла;
			КонецЕсли;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + Символы.ПС + "Комментарии:" + Символы.ПС;
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + ответ1.comments + Символы.ПС;
		исключение
			Рез.КодОшибки=12;
			Рез.ТекстОшибки="Ошибка обработки структуры информации о записи на тайм-слот!";
			Возврат Рез;
		конецпопытки;
	ИначеЕсли Ответ.КодСостояния=403 Тогда
		Рез.КодОшибки=2;
		Рез.ТекстОшибки=СообщениеНеАвторизован;
	Иначе
		Рез.КодОшибки=3;
		Рез.ТекстОшибки=СообщениеНетСвязи;	
	КонецЕсли;
	
	Возврат Рез;
КонецФункции


Функция УстановитьДанныеОРезервеВОбращение(гуидслота, гуидрезерва) Экспорт
	Рез = 0;
	ГУИДЗаписи = гуидслота;
	// находим слот в обработке  ----------------------
	СтруктСлотВОбработке = ПолучитьСтруктИзКалендариСервис(ГУИДЗаписи);
	Если СтруктСлотВОбработке=Неопределено Тогда
		Рез = -10;   //  гуида записи нет в ТЧ обработки
		// Возврат Рез;
	КонецЕсли;		
	
	// находим слот в ДМС -------------------------------------------
	СтруктСлот = Неопределено;	
	СлотНашелсяВДМС = СлотСуществуетЛокальноПоГУИД(ГУИДзаписи);
	Если СлотНашелсяВДМС Тогда
		СтруктСлот = ПрочитатьСлотЛокальноПоГУИД(ГУИДзаписи);
	Иначе
		Рез = 2;   //  слота нет в ДМС, должен быть сначала создан!
		Возврат Рез;
	КонецЕсли;
		
	// проверяем, сохранился ли локально слот с гуидом записи, есть ли резервы
	ЗапроситьДанныеРезерва = Ложь;
	Если СтруктСлотВОбработке=Неопределено Тогда	
		ЗапроситьДанныеРезерва = Истина;
			
	Иначе
		// статусрезерва = 0 - слот выделен дилером, 1 = есть запись на сервис, 3 = была отмена записи.
		
		Если (СтруктСлот.СтатусРезерва=0 И СтруктСлотВОбработке.СтатусРезерва>0) ИЛИ  
					(ТипНеопределеноИлиПростой(СтруктСлот.ДокументГрафикаСервиса) и СтруктСлотВОбработке.СтатусРезерва>0) ИЛИ
					(СтруктСлот.СтатусРезерва=1 И СтруктСлотВОбработке.СтатусРезерва=3) Тогда
			
			ЗапроситьДанныеРезерва = Истина;

		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗапроситьДанныеРезерва Тогда
		ДанныеРезерва =  ПолучитьДанныеОЗаписи(гуидслота,гуидрезерва);
		Если ДанныеРезерва.КодОшибки<>0 Тогда
			 Рез = 3;   //  ошибка получения информации о резерве
			 Возврат Рез;
		КонецЕсли;
		
		Если (СтруктСлот.СтатусРезерва=0 И ДанныеРезерва.Статус>0) 
			  ИЛИ (ТипНеопределеноИлиПростой(СтруктСлот.ДокументГрафикаСервиса) и ДанныеРезерва.Статус>0)  Тогда
			СтруктСлот.СтатусРезерва = ДанныеРезерва.Статус;
			СтруктСлот.ИнформацияОЗаписи = ДанныеРезерва.ОтветТекст;
	        СтруктСлот.ДатаСинхр = ТекущаяДата();
			СтруктСлот.БрониГУИД = гуидрезерва;
			СтруктСлот.VIN = ДанныеРезерва.VIN;
			СтруктСлот.ЗагруженНаСервер = Истина;

			Рез = СоздатьДокументыНаСервис(СтруктСлот, ДанныеРезерва.ПолнаяСтрока, ДанныеРезерва.КлиентФамилия, 
								ДанныеРезерва.КлиентИмя, ДанныеРезерва.КлиентОтчество, ДанныеРезерва.Телефон, 
								ДанныеРезерва.VIN, ДанныеРезерва.ОписаниеАвтоКратк, 
								ДанныеРезерва.ОписаниеАвтоПолное, ДанныеРезерва.емэйл);
			Рез = Рез*1000;   //  чтобы был понятен код ошибки
					
		Иначеесли СтруктСлот.СтатусРезерва=1 И ДанныеРезерва.Статус=3 Тогда
			// обработать отмену 
			СтруктСлот.СтатусРезерва = ДанныеРезерва.Статус;
			СтруктСлот.ИнформацияОЗаписи = ДанныеРезерва.ОтветТекст;
	        СтруктСлот.ДатаСинхр = ТекущаяДата();
			СтруктСлот.БрониГУИД = гуидрезерва;
			СтруктСлот.VIN = ДанныеРезерва.VIN;
			СтруктСлот.ЗагруженНаСервер = Истина;
			
			Рез = СохранитьСлотЛокально(СтруктСлот);
			Рез = Рез*100;   //  чтобы был понятен код ошибки
			Попытка
				Документ = СтруктСлот.ОбращениеНаСервис.ПолучитьОбъект();
				Документ.Примечание = "ОТМЕНА ОНЛАЙН-ЗАПИСИ : " + Документ.Примечание;
				Документ.Записать();
			Исключение
			КонецПопытки;
		Иначе
			Рез = 1;  //  Уже был создан ранее, не синхронизируем

		КонецЕсли;		
	Иначе 
		Рез = 1;  //  Уже был создан ранее, не синхронизируем
	КонецЕсли;
	Возврат Рез;
КонецФункции


Функция СинхронизироватьРезервПоСлотуКалендаря(ГУИДзаписи)  Экспорт  
	// слот из календари сервис считается приоритетным. сверяем данные с сохраненным слотом в регистре сведений
	//  обновляем регистр сведений, если не сходится 
	// возвращает 0 если все ок
	Рез = 0;
	МинДатаРезерва = НачалоДня(ТекущаяДата()) + (ЭтотОбъект.МинДнейДоНачала)*24*3600;

	СтруктСлотОбработка = ПолучитьСтруктИзКалендариСервис(ГУИДЗаписи);
	Если СтруктСлотОбработка=Неопределено Тогда
		Рез = -10;   //  гуида записи нет в ТЧ обработки
		Возврат Рез;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтруктСлотОбработка.цех) или (ЗначениеЗаполнено(СтруктСлотОбработка.цех) И СтруктСлотОбработка.цех.получитьобъект()=неопределено) Тогда
		// не нашелся цех
		Рез = -12;
	    Возврат Рез;
	КонецЕсли;

	СлотНашелсяВДМС = СлотСуществуетЛокальноПоГУИД(ГУИДзаписи);
	
	Если СтруктСлотОбработка.СтатусРезерва=0 Тогда	
	    //  Резерва еще нет, скорее всего это только что созданный таймслот
		НадоСоздатьНовыеРезервы = Ложь;
		Если СлотНашелсяВДМС Тогда
			// у нас есть слот, синхронизируем "загружен на сервер" если надо
			СтруктСлот = ПрочитатьСлотЛокальноПоГУИД(ГУИДзаписи);
			Если СтруктСлотОбработка.ЗагруженНаСервер=Истина и СтруктСлот.ЗагруженНаСервер=Ложь Тогда
				СтруктСлот.ЗагруженНаСервер=Истина;
				СтруктСлот.ДатаСинхр = ТекущаяДата();
				Если не СохранитьСлотЛокально(СтруктСлот) Тогда
					Рез = -11;     //  слот не записался в регистр в ДМС
					Возврат Рез;
				КонецЕсли;
			КонецЕсли;
			//  если по каким-то причинам нет резервов, пытаемся их создать
			НадоСоздатьНовыеРезервы = НЕ ВСлотеЕстьРезервы(СтруктСлот);
		Иначе 
	    	// слота по каким-то причинам нет надо заново создать резервы
	    	НадоСоздатьНовыеРезервы = Истина;
		КонецЕсли;
		// если надо создаем новые резервы, но только если они позже миндатырезерва
		Если НадоСоздатьНовыеРезервы и СтруктСлотОбработка.ДатаНачала>=МинДатаРезерва Тогда
			Рез = СоздатьРезервПоСлотуКалендаря(ГУИДзаписи);
			Если НЕ (Рез=1 или Рез=2 или Рез=3) Тогда
				Рез = Рез*100;
				Возврат Рез;
			КонецЕсли;
	    КонецЕсли;

	Иначе
	    //  ЕСТЬ резерв онлайн-записи или отмена резерва
		// проверяем создан ли ранее резерв
		Рез = СоздатьРезервПоСлотуКалендаря(ГУИДзаписи);
		Рез = УстановитьДанныеОРезервеВОбращение(СтруктСлотОбработка.ГУИДзаписи,СтруктСлотОбработка.БрониГУИД);
		Если Рез=0 Тогда
			// Сообщить("Для записи на сервис на " + стр1.ДатаНачала + " создано обращение на сервис!");
		ИначеЕсли Рез=1 Тогда
			// Сообщить("Для записи на сервис на " + стр1.ДатаНачала + " обращение на сервис создано ранее!");
			Рез=0;
		Иначе 
			// Сообщить("Для записи на сервис на " + стр1.ДатаНачала + " ОШИБКА создания обращения на сервис! Код:"+Строка(Рез));
			//  возвращаем последний код ошибки
		КонецЕсли;

	КонецЕсли;
	
	
	Возврат Рез;
КонецФункции


