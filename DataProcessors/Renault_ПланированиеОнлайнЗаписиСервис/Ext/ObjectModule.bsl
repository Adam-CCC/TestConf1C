Функция ПолучитьСтруктИзКалендариСервис(ГУИДЗаписи, КодОшибки=0) Экспорт
	Рез = Неопределено;
	
	Отбор1 = Новый Структура;
	Отбор1.Вставить("ГУИДЗаписи", ГУИДЗаписи);
	СтрокиКалендариСервис = ЭтотОбъект.КалендариСервис.НайтиСтроки(Отбор1);
	Если СтрокиКалендариСервис.Количество()=0  Тогда
		КодОшибки=1;
	ИначеЕсли СтрокиКалендариСервис.Количество()>1  Тогда
		КодОшибки=2;
	ИначеЕсли СтрокиКалендариСервис.Количество()=1  Тогда
		СтрКалендариСервис = СтрокиКалендариСервис[0];
		
		Рез = ВернутьСтруктуруГУИДЗаписи(ГУИДзаписи);
		Рез.ГУИДзаписи = СтрКалендариСервис.ГУИДзаписи;
		Рез.ДатаНачала = СтрКалендариСервис.ДатаНачала;
		Рез.ДатаОкончания = СтрКалендариСервис.ДатаОкончания;
		Рез.ЦехГУИД = СтрКалендариСервис.ЦехГУИД;
		Рез.ДилерскийЦентр = ЭтотОбъект.ДилерскийЦентр;
		Рез.Цех = Справочники.Цеха.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрКалендариСервис.ЦехГУИД));	
		Рез.СтатусРезерва = СтрКалендариСервис.СтатусРезерва;
		Рез.ЗагруженНаСервер = СтрКалендариСервис.ЗагруженНаСервер;
		Рез.ДняГуид = СтрКалендариСервис.ДняГуид;
		Рез.BIRDMD = ЭтотОбъект.BIRDMD;
		Рез.БрониГУИД = СтрКалендариСервис.БрониГУИД;
	
	КонецЕсли;

		
	Возврат Рез;
КонецФункции

Функция ВСлотеЕстьРезервы(СтруктСлот) Экспорт
	//  проверка что в структуре слота есть резервы
	Рез = Ложь;
	Если СтруктСлот.ДокументГрафикаСервиса<>Неопределено И СтруктСлот.ДокументГрафикаПриемка<>Неопределено 
					и СтруктСлот.ДокументГрафикаВыдача<>Неопределено Тогда
		Рез = Истина;
	КонецЕсли;		
	Возврат Рез;
КонецФункции


Функция УдалитьРезервыСДатыПоДату(ДатаНач, ДатаКон, КодОшибки=0) Экспорт
	РезКод = 1;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_СлотыОнлайнЗаписи.ГУИДзаписи,
	               |	Renault_СлотыОнлайнЗаписи.ДилерскийЦентр,
	               |	Renault_СлотыОнлайнЗаписи.ДатаНачала,
	               |	Renault_СлотыОнлайнЗаписи.ДатаОкончания,
	               |	Renault_СлотыОнлайнЗаписи.СтатусРезерва
	               |ИЗ
	               |	РегистрСведений.Renault_СлотыОнлайнЗаписи КАК Renault_СлотыОнлайнЗаписи
	               |ГДЕ
	               |	Renault_СлотыОнлайнЗаписи.ДатаНачала >= &ДатаНач
	               |	И Renault_СлотыОнлайнЗаписи.ДатаНачала <= &ДатаКон
	               |	И Renault_СлотыОнлайнЗаписи.ДилерскийЦентр = &ДилерскийЦентр
	               |	И Renault_СлотыОнлайнЗаписи.СтатусРезерва = 0";
	Запрос.УстановитьПараметр("ДатаНач",ДатаНач);
	Запрос.УстановитьПараметр("ДатаКон",ДатаКон);
	Запрос.УстановитьПараметр("ДилерскийЦентр",ЭтотОбъект.ДилерскийЦентр);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		удален = УдалитьСлотПоГУИД(Выборка.ГУИДзаписи);
	КонецЦикла;
	
	
	Возврат РезКод;
КонецФункции

