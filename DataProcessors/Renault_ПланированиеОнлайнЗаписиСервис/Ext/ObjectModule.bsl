	рез = УдалитьРезервыСДатыПоДату( НачалоДня(ТекущаяДата()) , МинДатаРезерва);

	
КонецПроцедуры


Функция СоздатьРезервПоСлотуКалендаря(ГУИДзаписи,ОписаниеОшибок="")  Экспорт
	Рез = 0;
	
	СлотНашелсяВДМС = СлотСуществуетЛокальноПоГУИД(ГУИДзаписи);
	
	Если СлотНашелсяВДМС Тогда
		СтруктСлот = ПрочитатьСлотЛокальноПоГУИД(ГУИДзаписи);
		Если ВСлотеЕстьРезервы(СтруктСлот) Тогда
			Рез = 2;   //  слот нашелся в ДМС по ГУИД, по нему есть сохраненные резервы  (не проверяем соответствие времени здесь)
			Возврат Рез;
		КонецЕсли;
	Иначе
		СтруктСлот = ПолучитьСтруктИзКалендариСервис(ГУИДЗаписи);
		Если СтруктСлот=Неопределено Тогда
			Рез = -10;   //  гуида записи нет в ТЧ обработки
			Возврат Рез;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтруктСлот.цех) или (ЗначениеЗаполнено(СтруктСлот.цех) И СтруктСлот.цех.получитьобъект()=неопределено) Тогда
			// не нашелся цех
			Рез = -12;
			ОписаниеОшибок = "Для слота задан некорректный цех!";
		    Возврат Рез;

		КонецЕсли;
		СтруктСлот.ДатаСинхр=ТекущаяДата();
		Если не СохранитьСлотЛокально(СтруктСлот) Тогда
			Рез = -11;     //  слот не записался в регистр в ДМС
			ОписаниеОшибок = "Ошибка локального сохранения слота в базе!";

			Возврат Рез;
		КонецЕсли;		
	КонецЕсли;
	КодОшибки=0;
	ОписаниеОшибок="";
	РезервСоздан = СоздатьРезервДляСлота(СтруктСлот, ОписаниеОшибок, КодОшибки);
	Если РезервСоздан Тогда
		Рез = 1;     //  новый слот, сохранен и созданы резервы
		Если СлотНашелсяВДМС Тогда
			Рез = 3;     //  слот нашелся в ДМС по ГУИД, по нему созданы новые резервы
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

