		Возврат Рез;

	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(НастройкиСоед,Рез);

		
	Возврат Рез;
КонецФункции


Процедура ЗагрузитьсСервераНаСервере(КодОшибки=0,ТекстСообщения="") Экспорт 
	
	КодОшибки=0;
	ТекстОшибки = "";
	
	ЭтотОбъект.МинДнейДоНачала = ПолучитьМинСдвигДнейССервера(КодОшибки,ТекстОшибки);
	Если КодОшибки<>0 Тогда
		КодОшибки=КодОшибки*10;
		ТекстСообщения = ТекстОшибки;
		Возврат;
	КонецЕсли;	
	
	АдрСрв=ПолучитьКоннекты();
	Если АдрСрв.СтрокаОшибок<>"" Тогда
		КодОшибки=1;
		ТекстСообщения = АдрСрв.СтрокаОшибок;
		Возврат;
	КонецЕсли;
	
	Если АдрСрв.НуженSSL Тогда
		Попытка 
			HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт,,,,,АдрСрв.SSL);
		Исключение
			ТекстСообщения = "Ошибка установки связи с сервером!";
			КодОшибки =2;
			Возврат;

		КонецПопытки;
	Иначе
		HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт);
	КонецЕсли;

	дцгуид = СокрЛП(СТРОКА(ЭтотОбъект.ДилерскийЦентр.УникальныйИдентификатор()));
	HTTPЗапрос = Новый HTTPЗапрос("/dmsrequesttimeslotslist/"+СокрЛП(ЭтотОбъект.BIRDMD)+"/"+дцгуид); 
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");
	СтрокаДляЗапроса = "{}";
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаДляЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		//Сообщить("Выбранный дилерский центр пока не подключен к работе с онлайн-записью через DMS. Обратитесь в поддержку DMS.");
		ТекстСообщения = "Ошибка установки связи с сервером!";
		КодОшибки = 3;
		Возврат;
	КонецПопытки;
	

	//Сообщить("Код результата: " + Ответ.КодСостояния);
	//Сообщить("Ответ: " + Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	                           
	
	Если Ответ.КодСостояния=200 Тогда
		// Успешно загружено
		МинДата = Дата(2100,1,1,0,0,0);
		МаксДата = Дата(1,1,1,0,0,0);
		ЭтотОбъект.КалендариСервис.Очистить();
		ЭтотОбъект.ЦехаПланирования.Очистить();
		чт1 = Новый ЧтениеJSON();
		чт1.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		ответ1 = ПрочитатьJSON(чт1);
		чт1.Закрыть();
		Если ответ1.Slots=Неопределено Тогда
			ТекстСообщения = "На сервере нет загруженных таймслотов!";
			// Сообщить("На сервере нет загруженных таймслотов!");
			// ОбновитьHTML();
			КодОшибки = 4;

			Возврат;
		КонецЕсли;
		ЭтотОбъект.ШаблонЗаполнения.Очистить();
		Для и1=0 по 6 Цикл
			ншаб1 = ЭтотОбъект.ШаблонЗаполнения.Добавить();
			ншаб1.ДеньВключенВГрафик = Ложь;
		КонецЦикла;
		
		Для и1 = 0 По ответ1.Slots.Количество() - 1 Цикл
			// ищем даты
			ДатаНач = Дата(ответ1.Slots[и1].tsdateyear,
							ответ1.Slots[и1].tsdatemonth,
							ответ1.Slots[и1].tsdateday, 
							ответ1.Slots[и1].timestarth,0,0);
							
			ДатаКон = Дата(ответ1.Slots[и1].tsdateyear,
							ответ1.Slots[и1].tsdatemonth,
							ответ1.Slots[и1].tsdateday, 
							ответ1.Slots[и1].timeendh,0,0);							
			
			Если НачалоДня(ДатаНач)<НачалоДня(ТекущаяДата()) Тогда
				Продолжить;
			КонецЕсли;
			Если НачалоДня(ДатаНач)<МинДата Тогда
				МинДата = НачалоДня(ДатаНач);
			КонецЕсли;
			Если НачалоДня(ДатаНач)>МаксДата Тогда
				МаксДата = НачалоДня(ДатаНач);
			КонецЕсли;
			
			//  добавляем цеха, если надо			
			Отбор = Новый Структура;
			Отбор.Вставить("ЦехГУИД", ответ1.Slots[и1].workpostid);
			ЕстьЦеха =  ЭтотОбъект.ЦехаПланирования.НайтиСтроки(Отбор);
			Если ЕстьЦеха.Количество()=0 Тогда
				НовыйGUID = Новый УникальныйИдентификатор(ответ1.Slots[и1].workpostid);
				СсылкаЦех = Справочники.Цеха.ПолучитьСсылку(НовыйGUID);		
				ДобЦех =  ЭтотОбъект.ЦехаПланирования.Добавить();
				ДобЦех.Цех =  СсылкаЦех;
				ДобЦех.ЦехГУИД = ответ1.Slots[и1].workpostid;
			КонецЕсли;
						
			н1 =  ЭтотОбъект.КалендариСервис.Добавить();
			н1.ГУИДзаписи =  ответ1.Slots[и1].timeslotid;
			н1.ДатаНачала =  ДатаНач;
			н1.ДатаОкончания = ДатаКон;
			н1.БрониГУИД =  ответ1.Slots[и1].reservationid;
			н1.ЦехГУИД =  ответ1.Slots[и1].workpostid;
			н1.ДняГуид =  НайтиДняГуид(ДатаНач);
			н1.ЗагруженНаСервер =  Истина;
			н1.СтатусРезерва =  ответ1.Slots[и1].reservationstatus;
			//  формируем шаблон
			// только первые 7 дней
			Первые7 = 3600*24*7;
			если НачалоДня(ДатаНач)-МинДата < Первые7 Тогда
				шНомерДня = ДеньНедели(ДатаНач);
				шВремяНач =  Дата(1,1,1,ответ1.Slots[и1].timestarth,0,0);
				шВремяКон =  Дата(1,1,1,ответ1.Slots[и1].timeendh,0,0);
				Отбор = Новый Структура;
				Отбор.Вставить("НомерДня", шНомерДня);
				Отбор.Вставить("ВремяНачала", шВремяНач);
				ЕстьШаблон = ЭтотОбъект.РасписаниеРаботы.НайтиСтроки(Отбор);
				Если ЕстьШаблон.количество()=0 Тогда
					НоваяСтрока = ЭтотОбъект.РасписаниеРаботы.Добавить();
					НоваяСтрока.НомерДня = шНомерДня;
					НоваяСтрока.ВремяНачала = шВремяНач;
					НоваяСтрока.ВремяОкончания  = шВремяКон;
					НоваяСтрока.ГУИД  =  Новый УникальныйИдентификатор();
					
					//СтрокаШаблона = ЭтотОбъект.ШаблонЗаполнения.НайтиПоИдентификатору(шНомерДня-1);
					СтрокаШаблона = ЭтотОбъект.ШаблонЗаполнения[шНомерДня-1];
					СтрокаШаблона.ДеньВключенВГрафик = Истина; // расписание заполнено
					//СтрокаШаблона.ПредставлениеРасписания = ПредставлениеРасписанияДня(ЭтаФорма, шНомерДня);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если МинДата <> Дата(2100,1,1,0,0,0) и 	МаксДата <> Дата(1,1,1,0,0,0) Тогда
			ЭтотОбъект.ДатаНачалаПланирования = МинДата;
			ЭтотОбъект.ДатаОкончанияПланирования = МаксДата;
			ТекстСообщения = "Слоты загружены по: " + Формат(МаксДата,"ДФ=""дд.ММ.гггг""");
			
			//ЭтаФорма.Заголовок = "График тайм слотов. " + ЭтотОбъект.СообщениеОкончаниеПланирования;
			//ИинциализоратьСтрунуцуРезультат();
			//Элементы.Страницы.ТекущаяСтраница = Элементы.РезультатЗаполненияСтраница;
			//Элементы.Страницы.ПодчиненныеЭлементы.НастройкаЗаполненияСтраница.Видимость = Ложь;
		Иначе
			ТекстСообщения = "На сервере нет загруженных таймслотов!";
			КодОшибки = 5;
			//// ОбновитьHTML();
		КонецЕсли;

	ИначеЕсли Ответ.КодСостояния=403 Тогда
		КодОшибки=403;
		ТекстОшибки=СообщениеНеАвторизован;	
		ТекстСообщения = СообщениеНеАвторизован;
	Иначе 
		ТекстСообщения = СообщениеНетСвязи;
		КодОшибки = 6;
	КонецЕсли;

КонецПроцедуры

Функция НайтиДняГуид(ДатаНач) Экспорт 
	Рез = Новый УникальныйИдентификатор();
	ДтПоиск = НачалоДня(ДатаНач);
	Для каждого стр1 из ЭтотОбъект.КалендариСервис Цикл
		Если НачалоДня(стр1.ДатаНачала)= ДтПоиск и стр1.ДняГуид<>"" Тогда
			Рез = стр1.ДняГуид;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Рез;
КонецФункции


Функция ПолучитьМинСдвигДнейССервера(КодОшибки=0,ТекстОшибки="") Экспорт
	Рез = 2;
	КодОшибки=0;
	ТекстОшибки="";
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	бирдмд = СокрЛП(ЭтотОбъект.BIRDMD);
	дцгуид = СокрЛП(СТРОКА(ЭтотОбъект.ДилерскийЦентр.УникальныйИдентификатор()));
	юзер = "unknownunknown";
	юзергуид = "0000";
	Попытка
		юзер = СокрЛП(Строка(ПараметрыСеанса.Пользователь));
		юзергуид = СокрЛП(Строка(ПараметрыСеанса.Пользователь.УникальныйИдентификатор()));
	Исключение
	КонецПопытки;
		
	АдрСрв=ПолучитьКоннекты();	
	Если АдрСрв.СтрокаОшибок<>"" Тогда
		КодОшибки=4;
		ТекстОшибки=АдрСрв.СтрокаОшибок;
		Возврат Рез;
	КонецЕсли;

	СтруктОтправки = Новый Структура;
	СтруктОтправки.Вставить("token",АдрСрв.ЛокальныйТокен);
	СтруктОтправки.Вставить("userguid",юзергуид);
	СтруктОтправки.Вставить("username",юзер);
	
	тНастройкиСериализации = Новый НастройкиСериализацииJSON;
    тНастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	тНастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением;
	
	ЗаписатьJSON(ЗаписьJSON, СтруктОтправки,тНастройкиСериализации);
	
	СтрокаДляЗапроса = ЗаписьJSON.Закрыть();
	
	//сообщить(СтрокаДляЗапроса);
	// "/dmsdeletetimeslot/{birdmd}/{dcguid}/{tsuuid}"
	
	
	Если АдрСрв.НуженSSL Тогда
		HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт,,,,,АдрСрв.SSL);
	Иначе
		HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт);
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос("/dmsgetdaysoffset/"+бирдмд+"/"+дцгуид); 
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаДляЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	//  СообщениеНетСвязи СообщениеНеАвторизован
	
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		КодОшибки=1;
		ТекстОшибки=СообщениеНетСвязи;
		Возврат Рез;
	КонецПопытки;
	
	// Сообщить("Код результата: " + Ответ.КодСостояния);
	// Сообщить("Ответ: " + Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	
	
	Если Ответ.КодСостояния=200 Тогда
		чт1 = Новый ЧтениеJSON();
		чт1.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		ответ1 = ПрочитатьJSON(чт1);
		чт1.Закрыть();
		Если ответ1.daysoffset<>Неопределено Тогда
			Рез = ответ1.daysoffset; 
			
		КонецЕсли;
	ИначеЕсли Ответ.КодСостояния=403 Тогда
		КодОшибки=2;
		ТекстОшибки=СообщениеНеАвторизован;
	Иначе
		КодОшибки=3;
		ТекстОшибки=СообщениеНетСвязи;
	КонецЕсли;	
	
	
	Возврат Рез;
КонецФункции


