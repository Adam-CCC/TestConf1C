	|	ВЫБОР КОГДА ТЗ_Календать.ЗагруженНаСервер ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК НеЗагрНаСервер,
	|	ВЫБОР КОГДА ТЗ_Календать.СтатусРезерва=1 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК СлотЗабронирован,
	|	ВЫБОР КОГДА ТЗ_Календать.СтатусРезерва=3 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК СлотОтменен,
	|	ВЫБОР КОГДА ТЗ_Календать.СтатусРезерва=0 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК СлотДоступен,
	|	ТЗ_Календать.ДняГуид
	|ПОМЕСТИТЬ ВТ_Календарь
	|ИЗ
	|	&ТЗ_Календать КАК ТЗ_Календать
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Календарь.ДатаНачала,
	|	ВТ_Календарь.ДатаОкончания,
	|	КОЛИЧЕСТВО(ВТ_Календарь.ЦехГУИД) КАК Цех, МАКСИМУМ(ВТ_Календарь.СтатусРезерва) Как МаксСтатус,
	|	Сумма(ВТ_Календарь.ЗагрНаСервер) КАК ЗагрНаСервер, Сумма(ВТ_Календарь.НеЗагрНаСервер) КАК НеЗагрНаСервер, 
	|	Сумма(ВТ_Календарь.СлотЗабронирован) КАК СлотЗабронирован, Сумма(ВТ_Календарь.СлотОтменен) КАК СлотОтменен, 
	|	Сумма(ВТ_Календарь.СлотДоступен) КАК СлотДоступен,
	|	ВТ_Календарь.ДняГуид
	|ИЗ
	|	ВТ_Календарь КАК ВТ_Календарь
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Календарь.ДатаНачала,
	|	ВТ_Календарь.ДатаОкончания,
	|	ВТ_Календарь.ДняГуид";
	Запрос.УстановитьПараметр("ТЗ_Календать", КалендариСервис);
	Выборка = запрос.Выполнить().Выбрать();
	Стр="";
	пока Выборка.Следующий() Цикл
		Стр=Стр+?(Стр="","",",")+"{
		|id:'"+Выборка.ДняГуид+"'
		|,title:'"+СтрокаHTML(ПредставлениеСобытия(Выборка))+"'
		|,allDay: false
		|,start: '"+Формат(Выборка.ДатаНачала, "ДФ='yyyy-MM-dd HH:mm:ss'")+"'
		|,end: '"+Формат(Выборка.ДатаОкончания, "ДФ='yyyy-MM-dd HH:mm:ss'")+"'
		//|,editable: "+?(ТолькоЧтение,"false","true")+"
		|,color: '"+ЦветОнлайнЗаписи(Выборка.МаксСтатус,Выборка.ЗагрНаСервер, Выборка.НеЗагрНаСервер) +"'
		//|,textColor: '"+Цвет(Выборка,"ЦветТекста")+"'
		|,imgsrc: ''
		|}";
	КонецЦикла;
	Возврат "events:["+Стр+"]"
КонецФункции                                                                                                

Функция ЦветОнлайнЗаписи(МаксСтатус, ЗагрНаСервер, НеЗагрНаСервер) 
	// ?(Выборка.МаксСтатус=0,"rgb(65,147,198)","rgb(40,117,8)")
	Рез =  "rgb(65,147,198)";
	
	Если МаксСтатус=0 Тогда
		//  свободный таймслот доступен для записи на сервере, закоммичен дилером
		Рез =  "rgb(65,147,198)";   //  голубой
		Если НеЗагрНаСервер>0 Тогда
			Рез = "rgb(209, 209, 209)";
		КонецЕсли;
		
	ИначеЕсли МаксСтатус=1 Тогда
		//  есть слоты с записью
		Рез =  "rgb(40,117,8)";  // зеленый

	ИначеЕсли  МаксСтатус>1 Тогда
		// есть слоты с отменой
		Рез =  "rgb(244, 66, 66)"; // красный
		
	КонецЕсли;
	
	Возврат Рез;
КонецФункции	
	

