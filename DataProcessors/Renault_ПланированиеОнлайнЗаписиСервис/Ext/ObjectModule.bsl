//! &НаСервереБезКонтекста	
Функция УдалитьПростойРезервыПоГУИД(ГУИДзаписи) Экспорт
	Набор = РегистрыСведений.Renault_СлотыОнлайнЗаписи.СоздатьНаборЗаписей();
	Набор.Отбор.ГУИДзаписи.Установить(ГУИДзаписи);
	Набор.Прочитать();
	Если Набор.Количество() > 0 Тогда
		НачатьТранзакцию();
		Попытка
			Ссылка = Набор[0].ДокументГрафикаСервиса;
			Если  ТипЗнч(Ссылка) = Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой") Тогда
				Объект = Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.Удалить();
				КонецЕсли;
				Набор[0].ДокументГрафикаСервиса = Неопределено;
			КонецЕсли;
			Ссылка = Набор[0].ДокументГрафикаПриемка;
			Если  ТипЗнч(Ссылка) = Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой") Тогда
				Объект = Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.Удалить();
				КонецЕсли;
				Набор[0].ДокументГрафикаПриемка = Неопределено;
			КонецЕсли;
			Ссылка = Набор[0].ДокументГрафикаВыдача;
			Если  ТипЗнч(Ссылка) = Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой") Тогда
				Объект = Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.Удалить();
				КонецЕсли;
				Набор[0].ДокументГрафикаВыдача = Неопределено;
			КонецЕсли;
			Набор.Записать();
			
		Исключение 
			ОтменитьТранзакцию();
			Возврат Ложь;	
		КонецПопытки;
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
	Возврат Истина;
КонецФункции


//! &НаСервереБезКонтекста	
Функция ТипНеопределеноИлиПростой(Ссылка) Экспорт
	Возврат Ссылка=Неопределено или ТипЗнч(Ссылка)=Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой"); 
КонецФункции

//! &НаСервереБезКонтекста	
Функция УдалитьСлотПоГУИД(ГУИДзаписи) Экспорт
	//  не проверяет на наличие записи на слот
	слот = ПрочитатьСлотЛокальноПоГУИД(ГУИДзаписи);
	Если слот.ГУИДзаписи = ГУИДзаписи Тогда
		Ссылка = слот.ДокументГрафикаПриемка;
		Если  ТипНеопределеноИлиПростой(слот.ДокументГрафикаПриемка) И ТипНеопределеноИлиПростой(слот.ДокументГрафикаСервиса) И  ТипНеопределеноИлиПростой(слот.ДокументГрафикаВыдача) Тогда
			Если УдалитьПростойРезервыПоГУИД(ГУИДзаписи) Тогда
				Запись = РегистрыСведений.Renault_СлотыОнлайнЗаписи.СоздатьМенеджерЗаписи();
				Запись.ГУИДзаписи = ГУИДзаписи;	
				Запись.Прочитать();
				Если Запись.Выбран() Тогда
					Попытка		
						Запись.Удалить();
					Исключение
						Возврат Ложь;
					КонецПопытки;
						
				КонецЕсли;						
			Иначе
				Возврат Ложь;
			КонецЕсли;	
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	Возврат Истина;
КонецФункции

                                                 

//! &НаСервереБезКонтекста
Функция СоздатьРезервДляСлота(СтруктСлот, ОписаниеОшибок="", КодОшибки=0) Экспорт
	Рез = Истина;
	ОписаниеОшибок="";
	КодОшибки=0;
	
	//сообщить(ЗначениеВСтрокуВнутр( СтруктСлот));
	ДлитПриемки = ?(ЗначениеЗаполнено(СтруктСлот.ДилерскийЦентр.ДлительностьПриемки),СтруктСлот.ДилерскийЦентр.ДлительностьПриемки,15);
	ДлитВыдачи = ?(ЗначениеЗаполнено(СтруктСлот.ДилерскийЦентр.ДлительностьВыдачи),СтруктСлот.ДилерскийЦентр.ДлительностьВыдачи,15);
	
	ДлитСлота = СтруктСлот.ДатаОкончания - СтруктСлот.ДатаНачала;
	Если  (ДлитПриемки*60+ДлитВыдачи*60)+60 > ДлитСлота Тогда
		ОписаниеОшибок="Длительность приемки и выдачи превышает длительность слота!";
		КодОшибки = 1;
		Возврат Ложь;
	КонецЕсли;
	 
	Если Не ЗначениеЗаполнено(СтруктСлот.Цех) или (ЗначениеЗаполнено(СтруктСлот.цех) И СтруктСлот.цех.получитьобъект()=неопределено)  Тогда
		ОписаниеОшибок="Не определен цех!";
		КодОшибки = 1000;
		Возврат Ложь;
	КонецЕсли;
	
	ПриемкаВремяНач = СтруктСлот.ДатаНачала;
	ПриемкаВремяКон = ПриемкаВремяНач + ДлитПриемки*60 - 1;
	ВыдачаВремяНач = СтруктСлот.ДатаОкончания - ДлитВыдачи*60;
	ВыдачаВремяКон = СтруктСлот.ДатаОкончания - 1;
	ЦехВремяНач = ПриемкаВремяКон + 1;
	ЦехВремяКон = ВыдачаВремяНач - 1 ;
	
	//  ищем приемщика
	МастерПриемка = ПолучитьСвободногоМастераПриемщика(СтруктСлот.ДилерскийЦентр,ПриемкаВремяНач, ПриемкаВремяКон);
	Если МастерПриемка = Неопределено Тогда
		ОписаниеОшибок="Нет свободных приемщиков для тайм-слота!";
		КодОшибки = 2;
		Возврат Ложь;
	КонецЕсли;
	// ищем мастера на выдачу
	МастерВыдача = Неопределено;
	Отказ = Ложь;
	ЗапланироватьКолбасу(ВыдачаВремяНач, ВыдачаВремяКон, МастерПриемка, СтруктСлот.ДилерскийЦентр, Отказ);
	Если Отказ = Ложь Тогда
		МастерВыдача = МастерПриемка;
	Иначе
		МастерВыдача = ПолучитьСвободногоМастераПриемщика(СтруктСлот.ДилерскийЦентр,ВыдачаВремяНач, ВыдачаВремяКон);
	КонецЕсли;	
	Если МастерВыдача = Неопределено Тогда
		ОписаниеОшибок="Нет свободных мастеров-приемщиков на выдачу для тайм-слота!";
		КодОшибки = 3;
		Возврат Ложь;
	КонецЕсли;
	// проверяем доступность цех и создаем резерв цеха
	
	КодОшибкиСозд=0;
	Если СтруктСлот.ДокументГрафикаСервиса=Неопределено Тогда
		СтруктСлот.ДокументГрафикаСервиса = СоздатьПростой(ЦехВремяНач,ЦехВремяКон,СтруктСлот.ДилерскийЦентр,СтруктСлот.Цех,КодОшибкиСозд);
		Если КодОшибкиСозд=1 Тогда
			ОписаниеОшибок="Нет свободного времени в цехе для тайм-слота!";
			КодОшибки = 4;
			Возврат Ложь;

		ИначеЕсли КодОшибкиСозд<>0 Тогда
			ОписаниеОшибок="Ошибка создания брони цеха для тайм-слота!";
			КодОшибки = 5+КодОшибкиСозд*10;
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	// резерв мастера-приемщика
	КодОшибкиСозд=0;
	Если СтруктСлот.ДокументГрафикаПриемка=Неопределено Тогда
		 СтруктСлот.ДокументГрафикаПриемка=СоздатьПростой(ПриемкаВремяНач,ПриемкаВремяКон,СтруктСлот.ДилерскийЦентр,МастерПриемка,КодОшибкиСозд);
		Если КодОшибкиСозд=1 Тогда
			ОписаниеОшибок="Нет свободных мастеров-приемщиков на приемку для тайм-слота!";
			КодОшибки = 6;
			Возврат Ложь;

		ИначеЕсли КодОшибкиСозд<>0 Тогда
			ОписаниеОшибок="Ошибка создания брони приемки для тайм-слота!";
			КодОшибки = 7+КодОшибкиСозд*10;
			Возврат Ложь;
		КонецЕсли;

	КонецЕсли;
	// резерв мастера-выдача
	КодОшибкиСозд=0;
	Если СтруктСлот.ДокументГрафикаВыдача=Неопределено Тогда
		 СтруктСлот.ДокументГрафикаВыдача=СоздатьПростой(ВыдачаВремяНач,ВыдачаВремяКон,СтруктСлот.ДилерскийЦентр,МастерВыдача,КодОшибкиСозд);
		Если КодОшибкиСозд=1 Тогда
			ОписаниеОшибок="Нет свободных мастеров-приемщиков на выдачу для тайм-слота!";
			КодОшибки = 8;
			Возврат Ложь;

		ИначеЕсли КодОшибкиСозд<>0 Тогда
			ОписаниеОшибок="Ошибка создания брони выдачи для тайм-слота!";
			КодОшибки = 9+КодОшибкиСозд*10;
			Возврат Ложь;
		КонецЕсли;

	КонецЕсли;

	// пишем слот ???
	Рез = СохранитьСлотЛокально(СтруктСлот,"ДокументГрафикаСервиса,ДокументГрафикаПриемка,ДокументГрафикаВыдача");
	Если Рез=Ложь Тогда
		ОписаниеОшибок="Ошибка записи слота!";
		КодОшибки = 10;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции


//! &НаСервереБезКонтекста
Функция НайтиМодельРено(ОписаниеАвтоКратк="") Экспорт
	 Возврат Справочники.Модели.ПустаяСсылка();
	
КонецФункции


//! &НаСервереБезКонтекста
Функция СоздатьДокументыНаСервис(СтруктСлот, Примечание, КлиентФамилия, КлиентИмя, КлиентОтчество, Телефон, VIN, ОписаниеАвтоКратк="", ОписаниеАвтоПолное="", емэйл="") Экспорт
	// возвращает код ошибки
	
	КодОшибки = 0;
	//  клиент и автомобиль
	ТекущийАвтомобиль = Справочники.Автомобили.ПустаяСсылка();
	КлиентСсылка = Справочники.Контрагенты.ПустаяСсылка();
	флагСоздаватьКлиента = Ложь;
	
	Если ЗначениеЗаполнено(VIN) и СтрДлина(VIN)>16 Тогда
		ТекущийАвтомобиль =  Renault_ОбщегоНазначения.НайтиАвтоПоVIN(VIN);
	КонецЕсли;
	
	Если ТекущийАвтомобиль = Справочники.Автомобили.ПустаяСсылка() Тогда
		
		НовыйАвтомобиль = Справочники.Renault_ЧерновикиАвтомобилей.СоздатьЭлемент();
		НовыйАвтомобиль.Хозяин =  КлиентФамилия + " " + КлиентИмя + " " + КлиентОтчество ;
		НовыйАвтомобиль.Модель = НайтиМодельРено(ОписаниеАвтоКратк);
		//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда 					
			НовыйАвтомобиль.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;
			НовыйАвтомобиль.ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();					
		//Иначе 					
		//	НовыйАвтомобиль.ВалютаУчета = Справочники.Валюты.НайтиПоКоду("643");					
		//КонецЕсли;  
						
		НовыйАвтомобиль.VIN = VIN;
		НовыйАвтомобиль.Наименование = ОписаниеАвтоКратк + " " + VIN ;
		НовыйАвтомобиль.НаименованиеПолное = ОписаниеАвтоПолное + " " + VIN ;
		НовыйАвтомобиль.ПроизвольноеОписание = ОписаниеАвтоПолное + " " + VIN + " (ОНЛАЙН-ЗАПИСЬ)";

		Попытка					
			НовыйАвтомобиль.Записать();				
		Исключение  
			КодОшибки = 14;
			Возврат КодОшибки;
		КонецПопытки;
		ТекущийАвтомобиль = НовыйАвтомобиль.Ссылка;		
		//---------------
		флагСоздаватьКлиента = Истина;
		
				
	Иначе	
		КлиентСсылка = Renault_АвтосервисОбщий.Renault_ПолучитьВладельцаАвто(ТекущийАвтомобиль);
		Если КлиентСсылка=Неопределено Тогда
			флагСоздаватьКлиента = Истина;
		ИначеЕсли ТипЗнч(КлиентСсылка)<>Тип("СправочникСсылка.Контрагенты") Тогда
			флагСоздаватьКлиента = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если КлиентСсылка = Справочники.Контрагенты.ПустаяСсылка() Тогда
		флагСоздаватьКлиента = Истина;
	КонецЕсли;
	
	Если флагСоздаватьКлиента = Истина Тогда
		Нов = Справочники.CRM_ПотенциальныеКонтрагенты.СоздатьЭлемент();
		Нов.Наименование =  КлиентФамилия + " " + КлиентИмя + " " + КлиентОтчество;
		Нов.НаименованиеПолное =  КлиентФамилия + " " + КлиентИмя + " " + КлиентОтчество;
		Нов.СогласиеНаОбработкуПерсональныхДанных = перечисления.ВариантыОтветов.Да;
		Нов.ВидОтношений = Справочники.ВидыВзаимоотношений.КонтактноеЛицо;
		Нов.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
		Нов.ФормаСобственности = перечисления.ФормыСобственности.ЧастноеЛицо;
		Попытка		
			Нов.Записать();
		Исключение  
			КодОшибки = 15;
			Возврат КодОшибки;
		КонецПопытки;
		
		Попытка	
			Если  ЗначениеЗаполнено(емэйл) Тогда
				Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойEmailКлиента(емэйл,Нов.Ссылка);
			КонецЕсли;
			Если ЗначениеЗаполнено(Телефон) Тогда
				Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойТелефонКлиента(Телефон,нов.Ссылка);
			КонецЕсли;
		Исключение  
			КодОшибки = 16;
			Возврат КодОшибки;
		КонецПопытки;
		
		КлиентСсылка = Нов.Ссылка;

		
	КонецЕсли;
	
	НачатьТранзакцию();
	//  Обращение в автосервис
	Документ = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
	Документ.Дата = ТекущаяДата();
	Документ.ДилерскийЦентр = СтруктСлот.ДилерскийЦентр;
	Если СтруктСлот.СтатусРезерва = 3 Тогда
		Документ.Примечание = "ОТМЕНА ОНЛАЙН-ЗАПИСИ : " + Примечание;
	Иначе
		Документ.Примечание = "ОНЛАЙН-ЗАПИСЬ : " + Примечание;
	КонецЕсли;
	Документ.Менеджер = ПараметрыСеанса.Пользователь;
	Документ.Автор = ПараметрыСеанса.Пользователь;

	//Документ.Клиент = КлиентФамилия + " " + КлиентИмя + " " + КлиентОтчество ;
	Документ.Клиент = КлиентСсылка ;
	
	//  -- определение автомобиля если есть VIN
	//  Владелец = Renault_АвтосервисОбщий.Renault_ПолучитьВладельцаАвто(ТекущийАвтомобиль);
	//  Renault_ОбщегоНазначения.НайтиАвтоПоVIN(VIN)
	///  пытаемся найти по VIN
	
	
	
	Документ.Автомобиль = ТекущийАвтомобиль;
	Документ.ТелефонПримечание = Телефон;
	Попытка
		Документ.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис["ОнлайнЗапись"];	
	Исключение
		Документ.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.ЗаписьНаСлВизит;	
	КонецПопытки;
	Документ.ОбращениеОбработано = Истина;
	Документ.ОтменилЗапись = ЛОЖЬ;
	Документ.ПроверенВICM = ЛОЖЬ;	
	Документ.Жалоба = ЛОЖЬ;
	Документ.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный;  //  как определять повторный?
	Документ.Внутренний = ЛОЖЬ;
	
	Попытка 
		Документ.Записать();
	Исключение
		 
		КодОшибки = 1;
		ОтменитьТранзакцию();
		Возврат КодОшибки;
	КонецПопытки;
	
	ОбращениеСсылка = Документ.Ссылка;
	// определение времени
	
	ДлитПриемки = ?(ЗначениеЗаполнено(СтруктСлот.ДилерскийЦентр.ДлительностьПриемки),СтруктСлот.ДилерскийЦентр.ДлительностьПриемки,15);
	ДлитВыдачи = ?(ЗначениеЗаполнено(СтруктСлот.ДилерскийЦентр.ДлительностьВыдачи),СтруктСлот.ДилерскийЦентр.ДлительностьВыдачи,15);
	
	ДлитСлота = СтруктСлот.ДатаОкончания - СтруктСлот.ДатаНачала;
	Если  (ДлитПриемки*60+ДлитВыдачи*60)+60 > ДлитСлота Тогда
	//	ОписаниеОшибок="Длительность приемки и выдачи превышает длительность слота!";
	//	КодОшибки = 1;
	//	Возврат Ложь;
	    ДлитПриемки = 15;
		ДлитВыдачи = 15;
	КонецЕсли;

	ПриемкаВремяНач = СтруктСлот.ДатаНачала;
	ПриемкаВремяКон = ПриемкаВремяНач + ДлитПриемки*60 - 1;
	ВыдачаВремяНач = СтруктСлот.ДатаОкончания - ДлитВыдачи*60;
	ВыдачаВремяКон = СтруктСлот.ДатаОкончания - 1;
	ЦехВремяНач = ПриемкаВремяКон + 1;
	ЦехВремяКон = ВыдачаВремяНач - 1 ;
	
	МастерПриемка = Неопределено;
	МастерВыдача = Неопределено;
	
	Если ЗначениеЗаполнено(СтруктСлот.ДокументГрафикаПриемка) И  ТипЗнч(СтруктСлот.ДокументГрафикаПриемка)=Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой") Тогда
		Если  ТипЗнч(СтруктСлот.ДокументГрафикаПриемка.Цех)=Тип("СправочникСсылка.Сотрудники") Тогда
			Если ПриемщикРаботаетПоГрафикуВПериод( ПриемкаВремяНач,  ПриемкаВремяКон, СтруктСлот.ДокументГрафикаПриемка.Цех) Тогда
				 МастерПриемка = СтруктСлот.ДокументГрафикаПриемка.Цех;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если МастерПриемка = Неопределено Тогда
		МастерПриемка = ПолучитьСвободногоМастераПриемщика(СтруктСлот.ДилерскийЦентр, ПриемкаВремяНач, ПриемкаВремяКон); 
	КонецЕсли;
	
	Отказ = Ложь;
	ЗапланироватьКолбасу(ВыдачаВремяНач, ВыдачаВремяКон, МастерПриемка, СтруктСлот.ДилерскийЦентр, Отказ);
	Если Отказ = Ложь Тогда
		МастерВыдача = МастерПриемка;
	Иначе
		МастерВыдача = ПолучитьСвободногоМастераПриемщика(СтруктСлот.ДилерскийЦентр,ВыдачаВремяНач, ВыдачаВремяКон);
	КонецЕсли;
	Если МастерВыдача = Неопределено Тогда
		Если ЗначениеЗаполнено(СтруктСлот.ДокументГрафикаВыдача) И  ТипЗнч(СтруктСлот.ДокументГрафикаВыдача)=Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой") Тогда
			Если  ТипЗнч(СтруктСлот.ДокументГрафикаВыдача.Цех)=Тип("СправочникСсылка.Сотрудники") И ЗначениеЗаполнено(СтруктСлот.ДокументГрафикаВыдача.Цех) Тогда
				МастерВыдача = СтруктСлот.ДокументГрафикаВыдача.Цех;
			
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// ----------
	//   Создание заявки на сервис
	// --------
	ДокОбъект = Документы.Renault_CRM_ЗаявкаНаСервис.СоздатьДокумент();
	ДокОбъект.ДилерскийЦентр = СтруктСлот.ДилерскийЦентр;
	//ДокОбъект.ОбработкаЗаполнения(Неопределено);
	ДокОбъект.Дата = ТекущаяДата();
	ДокОбъект.Клиент =КлиентСсылка;
	ДокОбъект.Автомобиль = ОбращениеСсылка.Автомобиль;
	ДокОбъект.Обращение = ОбращениеСсылка;
	ДокОбъект.ВремяНачала = ЦехВремяНач;
	ДокОбъект.ВремяОкончания =  ЦехВремяКон;
	
	//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
		ДокОбъект.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка;
	//Иначе
	//	ДокОбъект.Состояние = Перечисления.СостояниеЗаказНаряда.Заявка;
	//КонецЕсли;
	
	IDЭтапа = Новый УникальныйИдентификатор();
	IDРаботы = Новый УникальныйИдентификатор();
	
	
	Этап = ДокОбъект.Этапы.Добавить();
	Этап.IDЭтапа = IDЭтапа;
	Этап.Этап = "Этап 1";
	Этап.Цех = СтруктСлот.Цех;
	Этап.ДлительностьЭтапаПлан = (ЦехВремяКон-ЦехВремяНач)/3600;
	Этап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована;
	Этап.НачалоЭтапа =ЦехВремяНач;
	Этап.КонецЭтапа = ЦехВремяКон;
	
	Состав = ДокОбъект.СоставЭтапа.Добавить();
	Состав.IDЭтапа = IDЭтапа;
	Состав.Работа = Справочники.Автоработы.ПустаяСсылка();
	Состав.IDРаботы = IDРаботы;
	
	Работа =  ДокОбъект.Работы.Добавить();
	Работа.IDРаботы = IDРаботы;
	Работа.Длительность = (ЦехВремяКон-ЦехВремяНач)/3600;
 
	
	Попытка 
		ДокОбъект.Записать();
	Исключение
		КодОшибки = 2;
		ОтменитьТранзакцию();
		Возврат КодОшибки;
	КонецПопытки;
	
	ЗаявкаСсылка = ДокОбъект.Ссылка;
	
	// план работ
	Запись = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьМенеджерЗаписи();
	Запись.Обращение = ОбращениеСсылка;
	Запись.РабочийДокумент = ЗаявкаСсылка;
	Запись.ДилерскийЦентр = СтруктСлот.ДилерскийЦентр;
	Запись.Длительность = (ЦехВремяКон-ЦехВремяНач)/3600;
	Запись.ВремяНачала = ЦехВремяНач;
	Запись.ВремяОкончания = ЦехВремяКон;
	Запись.ЭтапРабот = IDЭтапа;
	Запись.Цех =СтруктСлот.Цех;
		
	Попытка 
		Запись.Записать();
	Исключение
		КодОшибки = 3;
		ОтменитьТранзакцию();
		Возврат КодОшибки;
	КонецПопытки;
	//   АвтосервисПланОперативный
	ЗаписьПлана = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(ЗаписьПлана, Запись);
	ЗаписьПлана.Период = ТекущаяДата();
	Попытка 
		ЗаписьПлана.Записать();	
	Исключение
		КодОшибки = 4;
		ОтменитьТранзакцию();
		Возврат КодОшибки;
	КонецПопытки;
	//  статус работы
	ЗаписьСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
	ЗаписьСтатуса.РабочийДокумент = ЗаявкаСсылка;
	ЗаписьСтатуса.Период = ТекущаяДата();
	ЗаписьСтатуса.Обращение = ОбращениеСсылка;
	ЗаписьСтатуса.ДилерскийЦентр = СтруктСлот.ДилерскийЦентр;
	ЗаписьСтатуса.ЭтапРабот = IDЭтапа;
	ЗаписьСтатуса.Цех = СтруктСлот.Цех;
	ЗаписьСтатуса.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована;
	
	Попытка 
		ЗаписьСтатуса.Записать();
	Исключение
		КодОшибки = 5;
		ОтменитьТранзакцию();
		Возврат КодОшибки;
	КонецПопытки;

	//  приемка
	НовыйДокумент = Документы.Renault_CRM_ПриемкаАвтомобиля.СоздатьДокумент();
	НовыйДокумент.Интерактивная = Ложь;
	НовыйДокумент.ДилерскийЦентр = СтруктСлот.ДилерскийЦентр;
	НовыйДокумент.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
	НовыйДокумент.Обращение = ОбращениеСсылка;
	НовыйДокумент.Клиент = КлиентСсылка;
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Автор = ПараметрыСеанса.Пользователь;
	НовыйДокумент.Автомобиль = ОбращениеСсылка.Автомобиль;
	НовыйДокумент.Машиноместо = МастерПриемка;
	НовыйДокумент.ВремяНачала = ПриемкаВремяНач;
	НовыйДокумент.ВремяОкончания = ПриемкаВремяКон;
	Попытка
		НовыйДокумент.Записать();
	Исключение
		КодОшибки = 6;
		ОтменитьТранзакцию();
		Возврат КодОшибки;
	КонецПопытки;
	
	ПриемкаСсылка = НовыйДокумент.Ссылка;
	// планирование приемки
	Набор = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
