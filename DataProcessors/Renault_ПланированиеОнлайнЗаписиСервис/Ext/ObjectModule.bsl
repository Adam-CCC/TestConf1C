Функция ПредставлениеСобытия(Выборка)
	
	//Стр=СокрЛП("-"+Формат(Выборка.ДатаОкончания,"ДФ=HH:mm")+ " постов:" + Выборка.цех);
	
	Стр=СокрЛП("-"+Формат(Выборка.ДатаОкончания,"ДФ=HH:mm"));
	
	Если (Выборка.СлотЗабронирован+Выборка.СлотОтменен)>0 Тогда
		Стр = Стр + " постов:" + СокрЛП(Выборка.цех);
	Иначе 
		Стр = Стр + " постов:" + СокрЛП(Выборка.цех);
		//Если Выборка.СлотЗабронирован>0 Тогда
			
			
			
	КонецЕсли;
	
	Возврат Стр;
	
