&НаКлиенте
Процедура ДатаКалендаряВыбор(Элемент, ВыбраннаяДата=Ложь) 
	ВладелецФормы.Календарь.ДатаКалендаря=Дата;
	ВладелецФормы.УстановитьПериод();
	ВладелецФормы.ОбновитьКалендарь();
	Закрыть();
