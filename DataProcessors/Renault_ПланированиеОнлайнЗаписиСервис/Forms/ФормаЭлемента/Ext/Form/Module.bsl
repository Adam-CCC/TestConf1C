				СтрокаТЗ.ДняГуид = ТекДняГУИД;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	КалендарьДня.Очистить();
	ТекДняГУИД = Неопределено;
	ОбновитьHTML();
