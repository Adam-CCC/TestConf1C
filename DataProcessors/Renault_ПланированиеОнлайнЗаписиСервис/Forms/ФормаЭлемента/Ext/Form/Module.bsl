&НаСервере
Функция ЦехаПланированияЦехНачалоВыбораНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ДилерскиеЦентрыАвтосервисЦеха.Цех 
	               |ИЗ
	               |	Справочник.CRM_ДилерскиеЦентры.АвтосервисЦеха КАК CRM_ДилерскиеЦентрыАвтосервисЦеха
	               |ГДЕ
	               |	CRM_ДилерскиеЦентрыАвтосервисЦеха.Ссылка = &Ссылка";
	
	Если ЗначениеЗаполнено(Объект.ДилерскийЦентр) Тогда
		дц1 = Объект.ДилерскийЦентр;
	Иначе 
		дц1 = справочники.CRM_ДилерскиеЦентры.ПустаяСсылка();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", дц1 );
		
	РезультатЗапроса = Запрос.Выполнить();
	
	
	Список = Новый СписокЗначений;	
	Список.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Цех"));
	Возврат Список;

КонецФункции

