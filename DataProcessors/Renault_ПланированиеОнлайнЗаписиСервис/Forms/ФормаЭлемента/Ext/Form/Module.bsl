&НаКлиенте
Процедура ВопросПередУдалениемСлота(Результат, пар) Экспорт
	
	
	Отбор = Новый Структура;
	Отбор.Вставить("ГУИДзаписи", пар.ГУИДзаписи);
	ТекСтроки = КалендарьДня.НайтиСтроки(Отбор);
	Если ТекСтроки.Количество()=0 Тогда
		// что-то пошло не так
		Возврат;
	КонецЕсли;
	ТекСтр = ТекСтроки[0];
	
	Если Результат = КодВозвратаДиалога.Да Тогда
    	
		Если  ТекСтр.СтатусРезерва=1 или ТекСтр.СтатусРезерва=3 Тогда
			 ПоказатьПредупреждение(,НСтр("ru = 'Нельзя удалить зарезервированный тайм-слот!'"));
			 ТекСтр.Флажок = Истина;
		Иначе
			//  пытаемся удалить таймслот
			//сообщить("Удалить: " +  пар.ГУИДзаписи);
			СообщениеОбОшибке = "";
			Рез = УдалитьОдинТаймСлот(пар.ГУИДзаписи, СообщениеОбОшибке);
			Если Рез=Истина Тогда
				удален = УдалитьРезервыСлотаПоГУИД(пар.ГУИДзаписи);
				Для каждого стр1 из ТекСтроки Цикл
					КалендарьДня.Удалить(стр1);
				КонецЦикла;
				//ОбновитьHTML();				
			КонецЕсли;
		КонецЕсли;
			
			
	Иначе
		ТекСтр.Флажок = Истина;
	КонецЕсли;
        
КонецПроцедуры


