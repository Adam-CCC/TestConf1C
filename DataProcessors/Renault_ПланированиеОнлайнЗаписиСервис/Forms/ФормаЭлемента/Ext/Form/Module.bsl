			тс1 = Объект.КалендариСервис.НайтиСтроки(Отбор);
			Если тс1.количество()=0 Тогда
				СтрокаТЗ = Объект.КалендариСервис.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЗ, СтрКалендарьДня);
