Функция НайтиПоследнийЗагруженныйДеньЛок()
	//  находит последний день, когда данные были загружены на сервер по локальным данным
	Рез = Дата(1,1,1,0,0,0);

	Для каждого стр1 из Объект.КалендариСервис Цикл
		Если НачалоДня(стр1.ДатаНачала)> Рез и стр1.ЗагруженНаСервер=Истина Тогда
			Рез = НачалоДня(стр1.ДатаНачала);
