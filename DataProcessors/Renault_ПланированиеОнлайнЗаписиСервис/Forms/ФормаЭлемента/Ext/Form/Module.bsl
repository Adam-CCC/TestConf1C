&НаСервереБезКонтекста
Функция ДилерскийЦентрНачалоВыбораНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ДилерскиеЦентры.Ссылка //,
	               |	//CRM_ДилерскиеЦентры.Наименование
	               |ИЗ
	               |	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	               |ГДЕ
	               |	CRM_ДилерскиеЦентры.Бренд = &Бренд";
		
	Запрос.УстановитьПараметр("Бренд", Справочники.CRM_МаркаАвтомобиля.RENAULT);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	
	Список = Новый СписокЗначений;	
	Список.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Возврат Список;
КонецФункции

