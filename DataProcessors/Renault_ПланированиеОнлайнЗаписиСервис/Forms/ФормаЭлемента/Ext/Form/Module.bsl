Процедура ЗагрузитьсСервера(Команда)
	//ЗагрузитьсСервераНаСервере();
	ТекстСообщения="";

	ДилерскийЦентрПриИзмененииНаСервере(ТекстСообщения);
	ЭтаФорма.ОтобразитьИзменениеДанных(Объект.МинДнейДоНачала,ВидИзмененияДанных.Изменение);
