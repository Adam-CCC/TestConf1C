Функция НайтиДняГуид(ДатаНач)
	Рез = Новый УникальныйИдентификатор();
	ДтПоиск = НачалоДня(ДатаНач);
	Для каждого стр1 из Объект.КалендариСервис Цикл
		Если НачалоДня(стр1.ДатаНачала)= ДтПоиск и стр1.ДняГуид<>"" Тогда
			Рез = стр1.ДняГуид;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Рез;
КонецФункции


