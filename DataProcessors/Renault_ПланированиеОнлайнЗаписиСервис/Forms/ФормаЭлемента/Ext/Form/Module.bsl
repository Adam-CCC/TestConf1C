&НаКлиенте 
Функция ПолучитьПараметрыСобытияИзДокумента(ДокументHTML)
	
	//Имена событий:
	//	"select" - "создание нового"
	//	"eventClick" - "выбор существующего"
	//	"eventDrop" - "перемещение"
	//	"eventResize" - "изменение размера"
	//	"eventOnContextMenu" - "правая кнопка"
	//	"onViewChange" - "изменение вида календаря"
	
	ПустоеСобытие = Новый Структура("Имя,Параметры","","");
	
	
	Попытка
		ИмяСобытия = ДокументHTML.defaultView.eval("eventName");
		Количество = ДокументHTML.defaultView.eval("eventCount");
	Исключение
		ИмяСобытия = "";
		Количество = 0;
	КонецПопытки;
	
	// ----  new for WebKit
	вебкит = ложь;
	Если НЕ ЗначениеЗаполнено(ИмяСобытия) Тогда
		Попытка
			ИмяСобытия = ДокументHTML.defaultView.eventName;
			Количество = ДокументHTML.defaultView.eventCount;
			вебкит = истина;
		Исключение
			ИмяСобытия = "";
			Количество = 0;
		КонецПопытки;

	КонецЕсли;
	// -----
	
	Если НЕ ЗначениеЗаполнено(ИмяСобытия) Тогда
		Возврат ПустоеСобытие;
	КонецЕсли;
	
	// Из COMОбъекта переводим в массив
	ПараметрыСобытия = Новый Массив;
	Для Индекс = 1 По Количество Цикл
		Если вебкит Тогда
			ПараметрыСобытия.Добавить( ДокументHTML.defaultView.getEventParam(Формат(Индекс-1,"ЧН=0;ЧГ=")));
		Иначе
			ПараметрыСобытия.Добавить( ДокументHTML.defaultView.eval("getEventParam("+Формат(Индекс-1,"ЧН=0;ЧГ=")+")") );
		КонецЕсли;
	КонецЦикла;
	
	ОчиститьПараметрыСобытияИзДокумента(ДокументHTML);
	
	Событие = Новый Структура("Имя,Параметры", ИмяСобытия, ПараметрыСобытия);
	Если ИмяСобытия = "select" И Количество = 3 Тогда
		Возврат Событие;
	ИначеЕсли ИмяСобытия = "eventClick" И Количество = 1 Тогда
		Возврат Событие;
	ИначеЕсли ИмяСобытия = "eventDrop" И Количество = 4 Тогда
		Возврат Событие;
	ИначеЕсли ИмяСобытия = "eventResize" И Количество = 3 Тогда
		Возврат Событие;
	ИначеЕсли ИмяСобытия = "eventOnContextMenu" И Количество = 2 Тогда
		Возврат Событие;
	ИначеЕсли ИмяСобытия = "onViewChange" И Количество = 2 Тогда
		Возврат Событие;
	Иначе
		Возврат ПустоеСобытие;
	КонецЕсли;
	
КонецФункции

