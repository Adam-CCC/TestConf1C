	Отбор.Вставить("ДняГуид", ТекДняГУИД);
	Отбор.Вставить("ЗагруженНаСервер", Ложь);
	м_Дня = Объект.КалендариСервис.НайтиСтроки(Отбор);
	
	Для Каждого стрДня из м_Дня Цикл
		Объект.КалендариСервис.Удалить(стрДня);
