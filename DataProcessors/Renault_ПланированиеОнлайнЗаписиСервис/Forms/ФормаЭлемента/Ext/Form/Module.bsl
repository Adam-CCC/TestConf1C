&НаСервере
Процедура ВыгрузитьТаймСлоты()
	// Вставить содержимое обработчика.
	
	//МинДатаРезерва = НачалоДня(ТекущаяДата()) + (Объект.МинДнейДоНачала+1)*24*3600;
	
		
	МассивТаймСлотов = Новый Массив;
	Для каждого таймслот из Объект.КалендариСервис Цикл
		Если таймслот.ЗагруженНаСервер = Истина Тогда
			//  не загружаем уже загруженные
			Продолжить;
		КонецЕсли;
		
		ОписаниеОшибок="";
		Рез = РеквизитФормыВЗначение("Объект").СоздатьРезервПоСлотуКалендаря(таймслот.ГУИДзаписи,ОписаниеОшибок);
		ЦехСтр = Строка(Справочники.Цеха.ПолучитьСсылку(Новый УникальныйИдентификатор(таймслот.ЦехГУИД)));
		Если Рез=1 Тогда
			 СообщитьПользователюСерв("Слот для " + ЦехСтр + " время " + Формат(таймслот.ДатаНачала,"ДФ=""дд.ММ.гггг ЧЧ:мм""") + " зарезервирован!"); 
		ИначеЕсли 	Рез=2 Тогда
			 СообщитьПользователюСерв("Слот для " + ЦехСтр + " время " + Формат(таймслот.ДатаНачала,"ДФ=""дд.ММ.гггг ЧЧ:мм""") + " уже был зарезервирован ранее");
		ИначеЕсли 	Рез=3 Тогда
			 СообщитьПользователюСерв("Слот для " + ЦехСтр + " время " + Формат(таймслот.ДатаНачала,"ДФ=""дд.ММ.гггг ЧЧ:мм""") + " был в ДМС, резервы созданы");
		Иначе 
			 СообщитьПользователюСерв("Слот для " + ЦехСтр + " время " + Формат(таймслот.ДатаНачала,"ДФ=""дд.ММ.гггг ЧЧ:мм""") + " не может быть создан по причине: "+ ОписаниеОшибок + " код ошибки: "+Строка(Рез));
			 
			 //  не загружаем те слоты, где в ДМС не удалось создать резервы в графике сервиса
			 Продолжить;
		КонецЕсли;

		стр1 = Новый Структура;
		стр1.Вставить("timeslotid",Строка(таймслот.ГУИДзаписи));
		//стр1.Вставить("tsdate",таймслот.ДатаНачала);
		стр1.Вставить("timestart",таймслот.ДатаНачала);
		//стр1.Вставить("timeend",таймслот.);
		стр1.Вставить("workpostid",Строка(таймслот.ЦехГУИД));
		//стр1.Вставить("reservationid",);
		стр1.Вставить("commitbydealer",1);
		//стр1.Вставить("BIR",Объект.BIRDMD);
		//стр1.Вставить("createdate",);
		//стр1.Вставить("reservationstatus",);
		стр1.Вставить("tsdateyear",Год(таймслот.ДатаНачала));
		стр1.Вставить("tsdatemonth",Месяц(таймслот.ДатаНачала));
		стр1.Вставить("tsdateday",День(таймслот.ДатаНачала));
		стр1.Вставить("timestarth",Час(таймслот.ДатаНачала));
		стр1.Вставить("timeendh",Час(таймслот.ДатаОкончания));
		МассивТаймСлотов.Добавить(стр1);

	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	СтруктОтправки = Новый Структура;
	АдрСрв=ПолучитьКоннекты(); 
	Если АдрСрв.СтрокаОшибок<>"" Тогда
		//КодОшибки=1;
		СообщитьПользователюСерв(АдрСрв.СтрокаОшибок);
		Возврат;
	КонецЕсли;


	СтруктОтправки.Вставить("token",АдрСрв.ЛокальныйТокен);
	СтруктОтправки.Вставить("BIR",СокрЛП(Объект.BIRDMD));
	СтруктОтправки.Вставить("dealercenterid",СТРОКА(Объект.ДилерскийЦентр.УникальныйИдентификатор()));


	СтруктОтправки.Вставить("data",МассивТаймСлотов);
	
	тНастройкиСериализации = Новый НастройкиСериализацииJSON;
    тНастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	тНастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением;
	
	ЗаписатьJSON(ЗаписьJSON, СтруктОтправки,тНастройкиСериализации);
	
	СтрокаДляЗапроса = ЗаписьJSON.Закрыть();
	
	//сообщить(СтрокаДляЗапроса);
	
	Если АдрСрв.НуженSSL Тогда
		Попытка 
			HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт,,,,,АдрСрв.SSL);
		Исключение
			СообщитьПользователюСерв("Ошибка установки связи с сервером!");
			//КодОшибки =2;
			Возврат;

		КонецПопытки;
	Иначе
		HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт);
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос("/committimeslotlist/"+СокрЛП(Объект.BIRDMD)); 
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаДляЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		//Сообщить("Выбранный дилерский центр пока не подключен к работе с онлайн-записью через DMS. Обратитесь в поддержку DMS.");
		ТекстСообщения = "Ошибка установки связи с сервером!";
		//КодОшибки = 3;
		Возврат;
	КонецПопытки;


	// Сообщить("Код результата: " + Ответ.КодСостояния);
	// Сообщить("Ответ: " + Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Если Ответ.КодСостояния=200 Тогда
		// Успешно загружено
		Для каждого таймслот из Объект.КалендариСервис Цикл
		    таймслот.ЗагруженНаСервер = Истина;
		КонецЦикла;
		СообщитьПользователюСерв("График успешно загружен на сервер!");
	Иначе 
		СообщитьПользователюСерв("Ошибка загрузки графика на сервер!");

	КонецЕсли;
		
КонецПроцедуры


&НаСервере
Процедура ЗагрузитьсСервераНаСервере(ТекстСообщения="")
