&НаСервере 
Функция СформироватьПредставлениеДня (Параметры)
	//ТЗ_Дня = Новый ТаблицаЗначений;
	//тз_Дня.Колонки.Добавить("ГУИДзаписи", новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки("40")));
	//тз_Дня.Колонки.Добавить("ЦехГУИД", новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки("40")));
	//тз_Дня.Колонки.Добавить("ДняГуид", новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки("40")));
	//тз_Дня.Колонки.Добавить("ГУИДзаписи", новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки("40")));
	ТекДняГУИД = Неопределено;
	
	Если Параметры.Количество()=1 Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ДняГуид", Параметры[0]);
		ТЗ_Дня = Объект.КалендариСервис.НайтиСтроки(Отбор);
		ДатаДня = ТЗ_Дня[0].ДатаНачала;
		ТекДняГУИД = Параметры[0];

	ИначеЕсли Параметры.Количество()=3 Тогда
		ДатаДня = НачалоДня(Дата(Параметры[0]));
		ТекДняГУИД = Параметры[0];
		Для Каждого д1 из Объект.КалендариСервис Цикл
			Если НачалоДня(д1.ДатаНачала)=ДатаДня Тогда
				ТекДняГУИД = д1.ДняГуид;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	ТекДняНачало = НачалоДня(ДатаДня);
	
	Если ДеньСодержитЗагруженныеТаймСлоты(ТекДняГУИД) Тогда
		// -----------------------------------------------------
		//  слоты данного дня загружены на сервер, отобразить
		
		Отбор = Новый Структура;
		Отбор.Вставить("ДняГуид", ТекДняГУИД);
		м_Дня = Объект.КалендариСервис.НайтиСтроки(Отбор);
		Для Каждого дн из м_Дня Цикл
			СтрКалендаряДня = КалендарьДня.Добавить();
			ЗаполнитьЗначенияСвойств(СтрКалендаряДня, дн);
			СтрКалендаряДня.Цех = Справочники[ОпределитьНаименованиеСправочника("Цеха")].ПолучитьСсылку(Новый УникальныйИдентификатор(дн.ЦехГУИД));	
			СтрКалендаряДня.Флажок = Истина;
						
			Если дн.СтатусРезерва = 1 Тогда
				СтрКалендаряДня.СтатусРезерваСтрока = "ЗАПИСЬ";
			ИначеЕсли  дн.СтатусРезерва = 3 Тогда
				СтрКалендаряДня.СтатусРезерваСтрока = "ОТМЕНА ЗАПИСИ";
			Иначе
				СтрКалендаряДня.СтатусРезерваСтрока = "-";	
			КонецЕсли;
			
			Если дн.СтатусРезерва = 1 или  дн.СтатусРезерва = 3  Тогда
				Бронь = ПолучитьДанныеОЗаписи(СтрКалендаряДня.ГУИДзаписи,СтрКалендаряДня.БрониГУИД);
				СтрКалендаряДня.ИнформацияЗаписи = Бронь.ПолнаяСтрока;
				СтрКалендаряДня.ИнформацияКратко = Бронь.ФИО + " " + Бронь.Машина;
			КонецЕсли;

		КонецЦикла;
		
		//  --- оформление таблицы календарьдня -----
		// ================================================================
		//  -- зарезервированные слоты
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		// условия при которых будет выполнено оформление
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение     = Новый ПолеКомпоновкиДанных("КалендарьДня.СтатусРезерва");
		ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение    = 1;
		ЭлементОтбора.Использование     = Истина;
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",WebЦвета.БледноЗеленый );      //  зеленый  WebЦвета.БледноЗеленый
		// какие поля (колонки) оформлять
		ПолеОформления      = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("КалендарьДня");
		ПолеОформления.Использование = Истина; 
		ЭлементОформления.Использование = Истина;
		// ================================================================
		//  -- слоты с отменой резерва
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		// условия при которых будет выполнено оформление
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение     = Новый ПолеКомпоновкиДанных("КалендарьДня.СтатусРезерва");
		ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение    = 3;
		ЭлементОтбора.Использование     = Истина;
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(247, 119, 84));   //  красный
		// какие поля (колонки) оформлять
		ПолеОформления      = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("КалендарьДня");
		ПолеОформления.Использование = Истина; 
		ЭлементОформления.Использование = Истина;	
		// ================================================================

		//  -- конец оформления
		
	Иначе
		// -----------------------------------------------------
		// слоты данного дня еще не загружены на сервер, идет работа по расписанию
		Отбор = Новый Структура;
		Отбор.Вставить("НомерДня", ДеньНедели(ДатаДня));
		СписокСлотов = Объект.РасписаниеРаботы.НайтиСтроки(Отбор);
		Для Каждого СтрСписокСлотов из СписокСлотов Цикл 
			Для Каждого стрЦех из Объект.ЦехаПланирования Цикл
				Если не ЗначениеЗаполнено(стрЦех.ЦехГУИД) или не ЗначениеЗаполнено(стрЦех.Цех) Тогда
						Продолжить;
				КонецЕсли;
				ГУИДзаписи = Новый УникальныйИдентификатор();
				ЦехГУИД = стрЦех.ЦехГУИД;
				
				ДатаНачала =Дата (Формат(НачалоДня(ДатаДня), "ДФ=yyyyMMdd")+ Прав("00"+Час(СтрСписокСлотов.ВремяНачала),2)+Прав("00"+Минута(СтрСписокСлотов.ВремяНачала),2));
				ДатаОкончания = Дата (Формат(НачалоДня(ДатаДня), "ДФ=yyyyMMdd")+ Прав("00"+Час(СтрСписокСлотов.ВремяОкончания),2)+Прав("00"+Минута(СтрСписокСлотов.ВремяОкончания),2));
				Отбор = Новый Структура;
				Отбор.Вставить("ДняГуид", ТекДняГУИД);
				Отбор.Вставить("ДатаНачала", ДатаНачала);
				Отбор.Вставить("ЦехГУИД", ЦехГУИД);
				м_Дня = Объект.КалендариСервис.НайтиСтроки(Отбор);
				Если м_Дня.Количество() = 0 Тогда
					СтрКалендариСервис = КалендарьДня.Добавить();
					СтрКалендариСервис.ГУИДзаписи = Новый УникальныйИдентификатор();
					СтрКалендариСервис.ЦехГУИД = ЦехГУИД;
					СтрКалендариСервис.Цех = стрЦех.Цех;
					СтрКалендариСервис.ДатаНачала = ДатаНачала;
					СтрКалендариСервис.ДатаОкончания = ДатаОкончания;
				Иначе
					СтрКалендариСервис = КалендарьДня.Добавить();
					ЗаполнитьЗначенияСвойств(СтрКалендариСервис, м_Дня[0]);
					СтрКалендариСервис.Флажок = Истина;
					отбор = новый Структура;
					Отбор.Вставить("ЦехГУИД" ,м_Дня[0].ЦехГУИД);
					м_Цеха = Объект.ЦехаПланирования.НайтиСтроки(отбор);
					Если м_Цеха <> Неопределено Тогда
						СтрКалендариСервис.Цех = м_Цеха[0].Цех;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецФункции


&НаСервере
Функция ДеньСодержитЗагруженныеТаймСлоты(ДняГУИД) Экспорт
	Рез = Ложь;
	Отбор = Новый Структура;
	Отбор.Вставить("ДняГуид", ДняГУИД);
	Отбор.Вставить("ЗагруженНаСервер", Истина);
	м_Дня = Объект.КалендариСервис.НайтиСтроки(Отбор);	
	Если м_Дня.Количество() <> 0 Тогда
		Рез = Истина;
	КонецЕсли;
	Возврат Рез;
КонецФункции

&НаКлиенте
Процедура ПланировщикВыборЗавершение(Результат, ДопПараметры) Экспорт
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДопПараметры.Свойство("Форма") Тогда
		Возврат;
	ИначеЕсли НЕ ТипЗнч(ДопПараметры.Форма) = Тип("УправляемаяФорма") Тогда
		Возврат;
	ИначеЕсли НЕ ДопПараметры.Форма.ИмяФормы = "Обработка.ПланировщикИнтерфейс.Форма.Форма" Тогда
