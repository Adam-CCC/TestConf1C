Функция ПолучитьДанныеОЗаписи(гуидслота,гуидзаписи)
	Рез = Новый Структура; // -- 
	Рез.Вставить("ОтветТекст","");
	Рез.Вставить("Статус",0);
	Рез.Вставить("КодСостояния",0);
	Рез.Вставить("ФИО","");
	Рез.Вставить("Машина","");
	Рез.Вставить("VIN","");
	Рез.Вставить("НужноПозвонить",ложь);
	Рез.Вставить("ПолнаяСтрока","");
	Рез.Вставить("гуидслота",гуидслота);
	Рез.Вставить("гуидзаписи",гуидзаписи);
	Рез.Вставить("ДатаНач",Дата(1,1,1,0,0,0));
	Рез.Вставить("ДатаКон",Дата(1,1,1,0,0,0));
    АдрСрв=ПолучитьКоннекты();
	
	Если АдрСрв.НуженSSL Тогда
		Попытка 
			HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт,,,,,АдрСрв.SSL);
		Исключение
			//ТекстСообщения = "Ошибка установки связи с сервером!";
			//КодОшибки =2;
			Возврат Рез;

		КонецПопытки;
	Иначе
		HTTPСоединение = Новый HTTPСоединение(АдрСрв.АдресСервера,АдрСрв.АдресСервераПорт);
	КонецЕсли;

	HTTPЗапрос = Новый HTTPЗапрос("/dmsrequestreservationinfo/"+СокрЛП(Объект.BIRDMD)+"/"
					+СТРОКА(Объект.ДилерскийЦентр.УникальныйИдентификатор())+"/"
					 +гуидслота +"/" + гуидзаписи ); 
	HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json");
	СтрокаДляЗапроса = "{}";
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаДляЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		//ТекстСообщения = "Ошибка установки связи с сервером!";
		//КодОшибки = 3;
		Возврат Рез;
	КонецПопытки;

	
	//Сообщить("Код результата: " + Ответ.КодСостояния);
	//Сообщить("Ответ: " + Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Рез.КодСостояния = Ответ.КодСостояния;
	Если Ответ.КодСостояния=200 Тогда
		// Успешно загружено
		МинДата = Дата(2100,1,1,0,0,0);
		МаксДата = Дата(1,1,1,0,0,0);
		чт1 = Новый ЧтениеJSON();
		отвстрока = Ответ.ПолучитьТелоКакСтроку("UTF-8"); 
		чт1.УстановитьСтроку(отвстрока);
		ответ1 = ПрочитатьJSON(чт1);
		чт1.Закрыть();
		Рез.ОтветТекст = отвстрока;
		
		Если ответ1.reservationstatus=Неопределено Тогда
			//СообщитьПользователюСерв("На сервере нет загруженных таймслотов!");
			Возврат Рез;
		КонецЕсли;
		Рез.Статус = ответ1.reservationstatus;
		Рез.ФИО = ответ1.lastname+" "+ответ1.firstname+" "+ответ1.middlename;
		Рез.Машина = ответ1.ModelDesc.ModelCode+" "+ответ1.ModelDesc.EngineType+" "+ответ1.VIN;
		Рез.VIN = ответ1.VIN;
		Если СокрЛП(ответ1.contactclient)="yes" Тогда
			Рез.НужноПозвонить = Истина;
		КонецЕсли;
		Рез.ДатаНач = Дата(ответ1.tsdateyear,ответ1.tsdatemonth,ответ1.tsdateday, ответ1.timestarth,0,0);
		Рез.ДатаКон = Дата(ответ1.tsdateyear, ответ1.tsdatemonth, ответ1.tsdateday, ответ1.timeendh,0,0);
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Запись на : " + Формат(Рез.ДатаНач,"ДФ=""дд.ММ.гггг ЧЧ:мм""") +  Символы.ПС + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + Рез.ФИО + Символы.ПС + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Перезвонить клиенту: " + ?(Рез.НужноПозвонить,"ДА","нет") +  Символы.ПС+ Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Тел: " + ответ1.telephone +  Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Email: " + ответ1.email +  Символы.ПС +  Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Модель: " + ответ1.ModelDesc.ModelCode +  Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Версия: " + ответ1.ModelDesc.VersionCode +  Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Двигатель: " + ответ1.ModelDesc.EngineType+" " + ответ1.ModelDesc.FuelType+  Символы.ПС;
		
		//Рез.ПолнаяСтрока = Рез.ПолнаяСтрока +  ответ1.ModelDesc.ModelCode+" "+ответ1.ModelDesc.VersionCode+" "+ответ1.ModelDesc.EngineType+" " + ответ1.ModelDesc.FuelType + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "VIN: "+ответ1.VIN + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Пробег: "+ ответ1.odometer + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Кондиционер: "+?(СокрЛП(ответ1.ModelDesc.AirConditioner)="yes","да","нет") + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "ABS: "+?(СокрЛП(ответ1.ModelDesc.ABS)="yes","да","нет") + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "ГУР: "+?(СокрЛП(ответ1.ModelDesc.PowerSteering)="yes","да","нет") + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Салонный фильтр: "+?(СокрЛП(ответ1.ModelDesc.CabinFilter)="yes","да","нет") + Символы.ПС +  Символы.ПС;
				
		Если ответ1.ComplexCodeList<>Неопределено и  ответ1.ComplexCodeList.Количество()>0 Тогда
			Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + "Комплекс сервисы:" + Символы.ПС;
  
			Для и1 = 0 По ответ1.ComplexCodeList.Количество() - 1 Цикл
				Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + ответ1.ComplexCodeList[и1] + Символы.ПС;
			КонецЦикла;
		КонецЕсли;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + Символы.ПС + "Комментарии:" + Символы.ПС;
		Рез.ПолнаяСтрока = Рез.ПолнаяСтрока + ответ1.comments + Символы.ПС;
		
	КонецЕсли;
	
	Возврат Рез;
КонецФункции



