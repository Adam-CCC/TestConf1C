&НаКлиенте
Процедура РезультатЗаполнения(Команда)
	Если Не ЗначениеЗаполнено(Объект.ДатаОкончанияПланирования) Тогда
		// Если дата окончания не указана, то заполняем до конца года.
		Объект.ДатаОкончанияПланирования = КонецМесяца(Объект.ДатаНачалаПланирования);
	КонецЕсли;
	Если Объект.ДатаОкончанияПланирования<Объект.ДатаНачалаПланирования Тогда
		Объект.ДатаОкончанияПланирования = КонецМесяца(Объект.ДатаНачалаПланирования);
	КонецЕсли;		
	
	Если Объект.ЦехаПланирования.Количество()=0 Тогда
		СообщитьПользователю("Необходимо заполнить цеха планирования!");
		Возврат;
	КонецЕсли;		
	
	Для Каждого Цех из Объект.ЦехаПланирования Цикл
		Если Не значениезаполнено(Цех.Цех) Тогда
			СообщитьПользователю("В списке цехов планирования не может быть пустых значений!");
			Возврат;	
		КонецЕсли;
	КонецЦикла;
	
	ДлинаСуток = 24 * 3600;
	ОтступСуток = ДлинаСуток*Объект.МинДнейДоНачала;
	Если Не ЗначениеЗаполнено(Объект.ДатаНачалаПланирования) 
				ИЛИ Объект.ДатаНачалаПланирования<НачалоДня(ТекущаяДата()+ОтступСуток) Тогда
		Объект.ДатаНачалаПланирования = НачалоДня(ТекущаяДата()+ОтступСуток);
	КонецЕсли;
	
	МаксЗагруженныйДень = НайтиПоследнийЗагруженныйДеньЛок();
	Если МаксЗагруженныйДень> Объект.ДатаНачалаПланирования Тогда
		
		Объект.ДатаНачалаПланирования = МаксЗагруженныйДень+ДлинаСуток;
		Если Объект.ДатаОкончанияПланирования <= Объект.ДатаНачалаПланирования Тогда
			Объект.ДатаОкончанияПланирования = Объект.ДатаНачалаПланирования + ДлинаСуток;
		КонецЕсли;
		СообщитьПользователю("На сервере уже есть загруженные слоты. Заполнение по расписанию доступно с даты: " + Формат(МаксЗагруженныйДень+ДлинаСуток,"ДФ=""дд.ММ.гггг"""));
		Возврат;
	КонецЕсли;

	
	ЭтаФорма.Заголовок = "График тайм слотов. " + Объект.СообщениеОкончаниеПланирования;
	
	ЗаполнитьПоШаблонуНаСервере();
	ИинциализоратьСтрунуцуРезультат();
	Элементы.Страницы.ПодчиненныеЭлементы.НастройкаЗаполненияСтраница.Видимость = Ложь;
	Элементы.Страницы.ТекущаяСтраница = Элементы.РезультатЗаполненияСтраница;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоШаблонуНаСервере()
	ДлинаСуток = 24 * 3600;
	
	ДатаДня = Объект.ДатаНачалаПланирования;
	МаксЗагруженныйДень = НайтиПоследнийЗагруженныйДеньЛок();
	Если МаксЗагруженныйДень> ДатаДня Тогда
		Объект.ДатаНачалаПланирования = МаксЗагруженныйДень+ДлинаСуток;
		Если Объект.ДатаОкончанияПланирования <= Объект.ДатаНачалаПланирования Тогда
			Объект.ДатаОкончанияПланирования = Объект.ДатаНачалаПланирования + ДлинаСуток;
		КонецЕсли;
	КонецЕсли;
	
	Пока ДатаДня <= Объект.ДатаОкончанияПланирования Цикл
		НомерДня = ДеньНедели(ДатаДня);
		СтрокаДня = Объект.ШаблонЗаполнения[НомерДня - 1];
		Если СтрокаДня.ДеньВключенВГрафик Тогда
			//ДняГУИД = Новый УникальныйИдентификатор();
			ДняГУИД = НайтиДняГуид(ДатаДня);

			Отбор = Новый Структура;
			Отбор.Вставить("НомерДня", НомерДня);
			СписокСлотов = Объект.РасписаниеРаботы.НайтиСтроки(Отбор);
			Для Каждого СтрСписокСлотов из СписокСлотов Цикл 
				
				Для Каждого стрЦех из Объект.ЦехаПланирования Цикл
					Если не ЗначениеЗаполнено(стрЦех.ЦехГУИД) или не ЗначениеЗаполнено(стрЦех.Цех) Тогда
						Продолжить;
					КонецЕсли;
					дтНачала = Дата (Формат(НачалоДня(ДатаДня), "ДФ=yyyyMMdd")+ Прав("00"+Час(СтрСписокСлотов.ВремяНачала),2)+Прав("00"+Минута(СтрСписокСлотов.ВремяНачала),2));
					// если слот уже есть, не перезаписывать его
					Отбор1 = Новый Структура;
					Отбор1.Вставить("ЦехГУИД", стрЦех.ЦехГУИД);
					Отбор1.Вставить("ДатаНачала", дтНачала);
					УжеЕсть = Объект.КалендариСервис.НайтиСтроки(Отбор1);
					Если УжеЕсть.Количество()=0  Тогда
						// ------
						СтрКалендариСервис = Объект.КалендариСервис.Добавить();
						СтрКалендариСервис.ГУИДзаписи = Новый УникальныйИдентификатор();
						СтрКалендариСервис.ЦехГУИД = стрЦех.ЦехГУИД;
						СтрКалендариСервис.ДняГуид = ДняГУИД;
						СтрКалендариСервис.ДатаНачала =дтНачала;
						СтрКалендариСервис.ДатаОкончания = Дата (Формат(НачалоДня(ДатаДня), "ДФ=yyyyMMdd")+ Прав("00"+Час(СтрСписокСлотов.ВремяОкончания),2)+Прав("00"+Минута(СтрСписокСлотов.ВремяОкончания),2));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		ДатаДня = ДатаДня + ДлинаСуток;
	КонецЦикла;
КонецПроцедуры

