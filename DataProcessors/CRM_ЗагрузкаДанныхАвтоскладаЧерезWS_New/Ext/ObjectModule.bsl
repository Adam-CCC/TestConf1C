Функция ВСтрокеЕстьПакетОпций(вхАртикулы, АртикулПакета)
	МассивАртикулов = обРазложитьСтрокуВМассивПодстрок(АртикулПакета," ");
	МассивСтроки = обРазложитьСтрокуВМассивПодстрок(вхАртикулы," ");

	ЕстьПакет = Истина;	
	Для Каждого ТекАрт Из МассивАртикулов Цикл
		Если МассивСтроки.Найти(ТекАрт) = Неопределено Тогда
			ЕстьПакет =  Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьПакет;
КонецФункции

Функция УбратьИзСтрокиПакетОпций(вхАртикулы, АртикулПакета)
	МассивАртикулов = обРазложитьСтрокуВМассивПодстрок(АртикулПакета," ");
	МассивСтроки = обРазложитьСтрокуВМассивПодстрок(вхАртикулы," ");
	Для Каждого ТекАрт Из МассивАртикулов Цикл
		Индекс = МассивСтроки.Найти(ТекАрт);
		Если  Не (Индекс= Неопределено) Тогда
			МассивСтроки.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	Ответ ="";
	этоПерв = Истина;
	Для Каждого ТекАрт  из МассивСтроки Цикл
		Если этоПерв Тогда
			этоПерв = Ложь;
		Иначе
			Ответ=Ответ+" ";
		КонецЕсли;
		Ответ=Ответ+ТекАрт;
	КонецЦикла;
	Возврат Ответ;
	
КонецФункции

