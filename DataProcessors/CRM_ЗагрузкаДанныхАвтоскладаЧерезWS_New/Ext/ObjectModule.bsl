Процедура ЭкспАвтомобильПриИзменении(ДогОб) Экспорт
	
	Если ЗначениеЗаполнено(ДогОб.Автомобиль)Тогда
		
		ДогОб.VIN = ДогОб.Автомобиль.VIN;
		ЗаписьСостояниеАвтомобилейПроизводителя = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
		ЗаписьСостояниеАвтомобилейПроизводителя.VIN =ДогОб.VIN;
		ЗаписьСостояниеАвтомобилейПроизводителя.Прочитать();
		
		Если ЗаписьСостояниеАвтомобилейПроизводителя.Выбран() Тогда
		
			ДогОб.Модель = ЗаписьСостояниеАвтомобилейПроизводителя.Модель;
			ДогОб.Версия = ЗаписьСостояниеАвтомобилейПроизводителя.Версия;
			ДогОб.Цвет = ЗаписьСостояниеАвтомобилейПроизводителя.Цвет;
			
		Иначе
			
			ДогОб.Модель = ДогОб.Автомобиль.Модель;
			ДогОб.Версия = ДогОб.Автомобиль.ВариантКомплектации;
			ДогОб.Цвет = ДогОб.Автомобиль.Цвет;
			
		КонецЕсли;
		
		ОбновитьСписокДополнительныхОпций(ДогОб);
		//ОбновитьСписокДополнительныхОпцийДилера(ДогОб);
				
		Если ЗаписьСостояниеАвтомобилейПроизводителя.Выбран() Тогда
			
			МассивПодстрок = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(ЗаписьСостояниеАвтомобилейПроизводителя.OPTIONS, " ");
			
			Для Каждого Стр Из ДогОб.ДопОпции Цикл
				
				Если МассивПодстрок.Найти(СокрЛП(Стр.Код)) <> Неопределено Тогда
					Стр.Выбран = Истина;
				Иначе
					Стр.Выбран = Ложь;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
		
	ДогОб.ПТС = ЗаписьСостояниеАвтомобилейПроизводителя.PTS_SERIE + " " + ЗаписьСостояниеАвтомобилейПроизводителя.PTS_NUM;
	ДогОб.МаркаМодельПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ModelTS;
	ДогОб.ТипПТС = ЗаписьСостояниеАвтомобилейПроизводителя.TypeTS;
	ДогОб.КатегорияПТС = ЗаписьСостояниеАвтомобилейПроизводителя.CategTS;
	ДогОб.ГодИзготовленияПТС = ЗаписьСостояниеАвтомобилейПроизводителя.YEAR;
	ДогОб.НомерДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ENGINE_NUM;
	ДогОб.НомерШассиПТС = ЗаписьСостояниеАвтомобилейПроизводителя.Shassi;
	ДогОб.НомерКузоваПТС = ЗаписьСостояниеАвтомобилейПроизводителя.Kuzov;
	ДогОб.ЦветКузоваПТС = ЗаписьСостояниеАвтомобилейПроизводителя.COLOR_PTS;
	ДогОб.РазрешеннаяМаксимальнаяМассаПТС = ЗаписьСостояниеАвтомобилейПроизводителя.MaxMass;
	ДогОб.МассаБезНагрузкиПТС = ЗаписьСостояниеАвтомобилейПроизводителя.MinMass;
	ДогОб.МощностьДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.PowerLS;
	ДогОб.РабочийОбъемДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.VolumeEngine;
	ДогОб.ТипДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.TypeEngine;
	ДогОб.ЭкологическийКлассДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.EcoClass;
	ДогОб.ОрганизацияИзготовительПТС = ЗаписьСостояниеАвтомобилейПроизводителя.NaimProiz;
	ДогОб.ОдобрениеТипаТСПТС = ЗаписьСостояниеАвтомобилейПроизводителя.APPROV_STRING; 		
	ДогОб.ДатаПТС = ЗаписьСостояниеАвтомобилейПроизводителя.DATE_PTS;
	ДогОб.МодельДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ENGINE_MODEL;
КонецПроцедуры

Процедура ОбновитьСписокДополнительныхОпций(ДогОб)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", ПолучитьИдентификаторВерсии(ДогОб));
	Запрос.УстановитьПараметр("УжеВыбрано", ДогОб.ДопОпции.Выгрузить());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УжеВыбрано.Выбран,
	|	УжеВыбрано.Опция
	|ПОМЕСТИТЬ ВТ_УжеВыбрано
	|ИЗ
	|	&УжеВыбрано КАК УжеВыбрано
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	АОС_Опции.ОпцияСпр,
	|	АОС_Опции.ЦенаКлиентская,
	|	АОС_Опции.КодОпции
	|ПОМЕСТИТЬ ВТ_Опции
	|ИЗ
	|	РегистрСведений.AOC_Опции КАК АОС_Опции
	|ГДЕ
	|	АОС_Опции.Базовая = ЛОЖЬ
	|	И АОС_Опции.Идентификатор = &Идентификатор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Опции.ОпцияСпр КАК Опция,
	|	ВТ_Опции.ЦенаКлиентская КАК Цена,
	|	ЕСТЬNULL(ВТ_УжеВыбрано.Выбран, ЛОЖЬ) КАК Выбран,
	|	ВТ_Опции.КодОпции КАК Код
	|ИЗ
	|	ВТ_Опции КАК ВТ_Опции
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УжеВыбрано КАК ВТ_УжеВыбрано
	|		ПО ВТ_Опции.ОпцияСпр = ВТ_УжеВыбрано.Опция";
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ДогОб.ДопОпции.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

Функция ПолучитьИдентификаторВерсии(ДогОб)
	
	Если Не ЗначениеЗаполнено(ДогОб.Модель) И Не ЗначениеЗаполнено(ДогОб.Версия) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	AOC_КомплектацииСрезПоследних.Идентификатор
	|ИЗ
	|	РегистрСведений.AOC_Комплектации.СрезПоследних(&ДатаДоговора, ) КАК AOC_КомплектацииСрезПоследних
	|ГДЕ
	|	AOC_КомплектацииСрезПоследних.МодельСпр = &Модель
	|	И AOC_КомплектацииСрезПоследних.ВариантКомплектацииСпр = &Версия";
	Запрос.УстановитьПараметр("ДатаДоговора", ДогОб.Дата);
	Запрос.УстановитьПараметр("Модель", ДогОб.Модель);
	Запрос.УстановитьПараметр("Версия", ДогОб.Версия);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Идентификатор;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

