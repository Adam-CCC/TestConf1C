
Перем СтоимостьДоставкиПоУмолчанию;

Процедура ОбработкаНаСервере() Экспорт
	
	ПолучитьДанные();
	
КонецПроцедуры // ОбработкаНаСервере()

Процедура ПолучитьДанные() Экспорт
	
	МожноПисать = Ложь;
	
	АдресWS	 = Константы.Renault_АдресWebСервисов.Получить();
	ЛогинWS	 = Константы.Renault_ЛогинВебСервиса.Получить();
	ПарольWS = Константы.Renault_ПарольВебСервиса.Получить();
	
	
	//удалим определение документа wsdl - его добавляем автоматически
	АдресWS = СтрЗаменить(АдресWS, "ws/storeexchange.1cws?wsdl", "");
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/storeexchange.1cws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/storeeschange", 
							   "storeexchange", "storeexchangeSoap12", 6000);
	
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	
	ИдентификаторДилера = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных(); 
	МассивБирДляПолученияДанных = ПолучитьМассивБирДляПолученияДанных();
	СтрокаBIR = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(
		МассивБирДляПолученияДанных, ";"); 
	Сериализатор = Новый СериализаторXDTO(СервисФабрика);
	ТаблицаДанныхОбАвтомобиляхПроизводителяXDTO = ВебСервис.GetData(СтрокаBIR);
	Если ТаблицаДанныхОбАвтомобиляхПроизводителяXDTO = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Получим стоимость доставки
	//Плохо Доделать
	//Дилерских центров может быть несколько
	ДилерскийЦентрВыборка = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	Если ДилерскийЦентрВыборка.Следующий() Тогда
		СтоимостьДоставкиПоУмолчанию = ДилерскийЦентрВыборка.СтоимостьДоставкиПоУмолчанию;
	Иначе
		СтоимостьДоставкиПоУмолчанию = 0;
	КонецЕсли;
	
	ТаблицаДанныхОбАвтомобиляхПроизводителя = Сериализатор.ПрочитатьXDTO(ТаблицаДанныхОбАвтомобиляхПроизводителяXDTO);
    МассивVIN = ТаблицаДанныхОбАвтомобиляхПроизводителя.ВыгрузитьКолонку("VIN");
	ЗагрузитьДанныеВИБ(ТаблицаДанныхОбАвтомобиляхПроизводителя);
	ПровестиКорректирующиеДокументы(МассивVIN);
	СнятьРезервы(МассивVIN);
	ДополнитьАвтомобилямиПодписанныеДКП();
	ВебСервис.RegOperation(ИдентификаторДилера);
	
КонецПроцедуры // ПолучитьДанные()

Процедура ПровестиКорректирующиеДокументы(МассивVIN)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_РучнаяКорректировкаДанныхСклада.Ссылка
	               |ИЗ
	               |	Документ.Renault_РучнаяКорректировкаДанныхСклада КАК Renault_РучнаяКорректировкаДанныхСклада
	               |ГДЕ
	               |	Renault_РучнаяКорректировкаДанныхСклада.Проведен = ИСТИНА
	               |	И Renault_РучнаяКорректировкаДанныхСклада.VIN В(&VIN)";
	Запрос.УстановитьПараметр("VIN", МассивVIN); 
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СнятьРезервы(МассивVIN)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_УтвержденныеРезервы.Регистратор
	               |ИЗ
	               |	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
	               |ГДЕ
	               |	НАЧАЛОПЕРИОДА(Renault_УтвержденныеРезервы.ДатаСнятияСРезерва, ДЕНЬ) < НАЧАЛОПЕРИОДА(&ТекДата, ДЕНЬ)
	               |	И Renault_УтвержденныеРезервы.VIN В(&VIN)";
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("VIN", МассивVIN);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Регистратор.ПолучитьОбъект();
		ДокОбъект.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервСнят;
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
КонецПроцедуры

Функция РазобратьРезультат(СервисФабрика, Результат)
	
	СтрокаДанныхАвтомобилейПроизводителя = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/avtoinfo", "СтрокаДанныхАвтомобилейПроизводителя"));
	СвойстваЗаписи = СтрокаДанныхАвтомобилейПроизводителя.Свойства();
	
	ТаблицаДанныхОбАвтомобиляхПроизводителя = Новый ТаблицаЗначений;
	Для каждого ЗначениеСвойстваЗаписи Из СвойстваЗаписи Цикл
		
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить(ЗначениеСвойстваЗаписи.Имя);
		
	КонецЦикла;
	
	СтрокиДанныхАвтомобилейПроизводителя = Результат.СтрокиДанныхАвтомобилейПроизводителя;
	
	Для каждого СтрокаДанных Из СтрокиДанныхАвтомобилейПроизводителя Цикл
		
		НовСтрока = ТаблицаДанныхОбАвтомобиляхПроизводителя.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаДанных);
		//Если Год(НовСтрока.DATE_MADC) = 1900 Тогда
		//	НовСтрока.DATE_MADC = Дата('00010101');
		//КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДанныхОбАвтомобиляхПроизводителя;
	
КонецФункции

Процедура ЗагрузитьДанныеВИБ(ТаблицаДанныхОбАвтомобиляхПроизводителя)
	
	//Добавим колонки
	
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("Model_Full") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("Model_Full");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("Автомобиль") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("Автомобиль");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("Модель") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("Модель");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("Версия") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("Версия");
	КонецЕсли;
    Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("Цвет") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("Цвет");
	КонецЕсли;
    Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("Статус") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("Статус");
	КонецЕсли;	
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаПродажиБаза") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаПродажиБаза");
	КонецЕсли;	
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаПродажиОпции") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаПродажиОпции");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаПродажиДопОборудования") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаПродажиДопОборудования");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("СебестоимостьДопОборудования") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("СебестоимостьДопОборудования");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаПродажиАвтомобиля") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаПродажиАвтомобиля");
	КонецЕсли;	
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаЗакупкиБаза") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаЗакупкиБаза");
	КонецЕсли;	
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаЗакупкиОпции") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаЗакупкиОпции");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаЗакупкиАвтомобиля") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаЗакупкиАвтомобиля");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаПродажиДоставка") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаПродажиДоставка");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ТипАвтомобиля") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ТипАвтомобиля");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаКлиентская") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаКлиентская");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦенаДилерская") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦенаДилерская");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("НаименованияОпций") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("НаименованияОпций");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("ЦветМеталлик") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("ЦветМеталлик");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("БлокировкаАФМ") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("БлокировкаАФМ");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("СебестоимостьПоТН") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("СебестоимостьПоТН");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("НаУдаление") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("НаУдаление");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("НаДобавление") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("НаДобавление");
	КонецЕсли;
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Найти("Скрывать") = Неопределено Тогда
		ТаблицаДанныхОбАвтомобиляхПроизводителя.Колонки.Добавить("Скрывать");
	КонецЕсли;
	
	//Получим таблицы опций для парсинга
	ТаблицаПакетовОпций = ПолучитьТаблицуСоставныхОпций();
	ТаблицаОтдельныхОпций = ПолучитьТаблицуОтдельныхОпций();
	
	//Дополняем данные по а/м
	Для Каждого ДанныеПоАвто ИЗ ТаблицаДанныхОбАвтомобиляхПроизводителя Цикл
		ЗаполнитьНедостающиеДанные(ДанныеПоАвто, ТаблицаПакетовОпций, ТаблицаОтдельныхОпций);
 	КонецЦикла;

	//Если таблица пустая, дальше делать ничего не надо
	Если ТаблицаДанныхОбАвтомобиляхПроизводителя.Количество() = 0 Тогда 		
		Возврат;		
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаДанныхОбАвтомобиляхПроизводителя Цикл
		МенеджерЗаписиРегистра = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
		МенеджерЗаписиРегистра.VIN = Строка.VIN;
		МенеджерЗаписиРегистра.Прочитать();
		Если Строка.УдалитьСтроку Тогда	
			Если МенеджерЗаписиРегистра.Выбран() Тогда
				МенеджерЗаписиРегистра.Скрывать = Ложь;
				МенеджерЗаписиРегистра.НаУдаление = Истина;
				МенеджерЗаписиРегистра.Записать();
				Если Не ЕстьПроведеннаяРучнаяКорректировка(Строка.VIN, 1) И
					Не  ЕстьПроведеннаяРучнаяКорректировка(Строка.VIN, 0) Тогда 
					ДобавитьВЖурналЗаписьОбУдалении(Строка.VIN);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(МенеджерЗаписиРегистра, Строка);
			Если Не МенеджерЗаписиРегистра.Выбран() Тогда
				МенеджерЗаписиРегистра.Скрывать = Истина;
				МенеджерЗаписиРегистра.НаДобавление = Истина;
				Если Не ЕстьПроведеннаяРучнаяКорректировка(Строка.VIN, 2) Тогда 
					ДобавитьВЖурналЗаписьОДобавлении(Строка.VIN);
				КонецЕсли;
			КонецЕсли;
			МенеджерЗаписиРегистра.Записать();
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Процедура ДобавитьВЖурналЗаписьОДобавлении(VIN)
	
	Запись = РегистрыСведений.Renault_ИзмененияАвтосклад.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДата();
	Запись.VIN = VIN;
	Запись.ОписаниеИзменений = "Добавлено";
	Запись.Записать();	
	
КонецПроцедуры

Процедура ДобавитьВЖурналЗаписьОбУдалении(VIN)
	
	Запись = РегистрыСведений.Renault_ИзмененияАвтосклад.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДата();
	Запись.VIN = VIN;
	Запись.ОписаниеИзменений = "Удалено";
	Запись.Записать();
	
КонецПроцедуры

Функция ЕстьПроведеннаяРучнаяКорректировка(VIN, РежимРаботы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РучнаяКорректировкаДанныхСклада.VIN
		|ИЗ
		|	Документ.Renault_РучнаяКорректировкаДанныхСклада КАК Renault_РучнаяКорректировкаДанныхСклада
		|ГДЕ
		|	Renault_РучнаяКорректировкаДанныхСклада.Проведен = ИСТИНА
		|	И Renault_РучнаяКорректировкаДанныхСклада.РежимРаботы = &РежимРаботы
		|	И Renault_РучнаяКорректировкаДанныхСклада.VIN = &VIN";	
	 Запрос.УстановитьПараметр("РежимРаботы", РежимРаботы);
	 Запрос.УстановитьПараметр("VIN", VIN);
	 РезультатЗапроса = Запрос.Выполнить();
	 Возврат Не РезультатЗапроса.Пустой();
	 
КонецФункции

Процедура ЗагрузитьВИБСтрокуДанных(СтрокаДанных)
	
	Если ЗначениеЗаполнено(СтрокаДанных.VIN) Тогда 
		
		НаборЗаписей = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.VIN.Установить(СокрЛП(СтрокаДанных.VIN));
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		НовЗапись = НаборЗаписей.Добавить();
		
		НовЗапись.VIN = СокрЛП(СтрокаДанных.VIN);
		НовЗапись.Модель = Справочники.Модели.НайтиПоРеквизиту("Артикул", СокрЛП(СтрокаДанных.КодМодели));
		
		Если ЗначениеЗаполнено(НовЗапись.Модель) Тогда 
			НовЗапись.Версия = Справочники.ВариантыКомплектации.НайтиПоРеквизиту("Артикул", СокрЛП(СтрокаДанных.Версия),, НовЗапись.Модель);
		КонецЕсли;
		
		НовЗапись.Цвет = Справочники.Цвета.НайтиПоРеквизиту("Артикул", СокрЛП(СтрокаДанных.КодЦвета));
		НовЗапись.ГодВыпуска = СокрЛП(СтрокаДанных.ГодВыпуска);
		НовЗапись.СоставОпций = СтрокаДанных.СоставОпций;
		НовЗапись.НомерПТС = СтрокаДанных.НомерПТС;
		НовЗапись.ДатаПроизводства = СтрокаДанных.ДатаПроизводства;
		НовЗапись.КоличествоДнейНаСкладе = СтрокаДанных.КоличествоДнейНаСкладе;
		НовЗапись.ДатаОтгрузкиАФМ = СтрокаДанных.ФактическаяДатаОтгрузки;
		НовЗапись.Статус = ПолучитьСтатусАвтомобиляПроизводителяПоСтроке(СтрокаДанных.Статус);
		                              
		НовЗапись.Автомобиль = НайтиСоздатьАвтомобильПоВину(СтрокаДанных.VIN, НовЗапись, СтрокаДанных);
		
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Функция ПолучитьСтатусАвтомобиляПроизводителяПоСтроке(СтрокаСтатуса)
	
	Если ЗначениеЗаполнено(СтрокаСтатуса) Тогда 
		
		Если НРег(СтрокаСтатуса) = "впроизводстве" Тогда 
			Возврат Перечисления.CRM_СтатусыАвтомобилей.ВПроизводстве;
		ИначеЕсли НРег(СтрокаСтатуса) = "впути" Тогда 
			Возврат Перечисления.CRM_СтатусыАвтомобилей.ВПути;
		ИначеЕсли НРег(СтрокаСтатуса) = "выданклиенту" Тогда 
			Возврат Перечисления.CRM_СтатусыАвтомобилей.ВыданКлиенту;
		ИначеЕсли НРег(СтрокаСтатуса) = "доставлендилеру" Тогда 
			Возврат Перечисления.CRM_СтатусыАвтомобилей.ДоставленДилеру;
		ИначеЕсли НРег(СтрокаСтатуса) = "клиентскаязаявка" Тогда 
			Возврат Перечисления.CRM_СтатусыАвтомобилей.КлиентскаяЗаявка;
		ИначеЕсли НРег(СтрокаСтатуса) = "наскладеафм" Тогда 
			Возврат Перечисления.CRM_СтатусыАвтомобилей.НаСкладеАФМ;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьАртикулМодели(СтрокаТаблицы)
	Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Model_Full) Тогда
		СтрокаТаблицы.Model_Full = СтрокаТаблицы.MODEL+СтрокаТаблицы.FG_PROJET+СтрокаТаблицы.FG_PHASE;
	КонецЕсли;
КонецПроцедуры

Функция НайтиСоздатьАвтомобильПоВину_v2(VIN, ДанныеПоАвтомобилю)
	
	ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	ВерсияАльфаАвто = Renault_CRM.ВерсияАльфаАвто();
		
	Если ВерсияАльфаАвто = "5" Тогда		
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автомобили.Ссылка,
		|	Автомобили.Модель,
		|	Автомобили.Цвет,
		|	Автомобили.ВариантКомплектации
		|ИЗ
		|	Справочник.Автомобили КАК Автомобили
		|ГДЕ
		|	(Автомобили.VIN = &VIN
		|			ИЛИ Автомобили.ОригинальныйVIN = &VIN)";
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автомобили.Ссылка,
		|	Автомобили.Модель,
		|	Автомобили.Цвет,
		|	Автомобили.ВариантКомплектации
		|ИЗ
		|	Справочник.Автомобили КАК Автомобили
		|ГДЕ
		|	Автомобили.VIN = &VIN";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("VIN", VIN);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда //Такой автомобиль уже создан в системе
		
		НовыйАвтомобиль = Выборка.Ссылка;
		Модель = Выборка.Модель;
		ВариантКомплектации = Выборка.ВариантКомплектации;
		Цвет = Выборка.Цвет;
		
		//Если заполнены не все свойства - заполним их и запишем карточку
		ЗаписатьОбъект = Ложь;
		Если Не ЗначениеЗаполнено(Выборка.Модель) Тогда
			Модель = ДанныеПоАвтомобилю.Модель;
			ЗаписатьОбъект = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.ВариантКомплектации) Тогда
			ВариантКомплектации = ДанныеПоАвтомобилю.Версия;
			ЗаписатьОбъект = Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Выборка.Цвет) Тогда
			Цвет = ДанныеПоАвтомобилю.Цвет;
			ЗаписатьОбъект = Истина;
		КонецЕсли;
		Если ЗаписатьОбъект Тогда			
			Попытка
				АвтоОбъект = НовыйАвтомобиль.ПолучитьОбъект();
				АвтоОбъект.Модель = Модель;
				АвтоОбъект.ВариантКомплектации = ВариантКомплектации;
				
				Если ВерсияАльфаАвто = "5" Тогда		
					Если Не ЗначениеЗаполнено(АвтоОбъект.ВключатьВПрайсЛист) Тогда
						АвтоОбъект.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;
					КонецЕсли;									
				КонецЕсли;
								
				Если Не ЗначениеЗаполнено(АвтоОбъект.ВалютаУчета) Тогда
					АвтоОбъект.ВалютаУчета = ВалютаУчета;
				КонецЕсли;	
				
				АвтоОбъект.Цвет = Цвет;
				Если Не ЗначениеЗаполнено(АвтоОбъект.Код) Тогда
					АвтоОбъект.УстановитьНовыйКод();
				КонецЕсли;
				//Если Не ЗначениеЗаполнено(АвтоОбъект.ЦветКод) Тогда
				//	АвтоОбъект.ЦветКод = "Не заполнено";
				//КонецЕсли;
				АвтоОбъект.Записать();
			Исключение
				//Сообщить(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		Возврат НовыйАвтомобиль;
		
	Иначе
		
		ТекМодель = ДанныеПоАвтомобилю.Модель;		
		ТекЦвет = ДанныеПоАвтомобилю.Цвет;
		ТекВерсия = ДанныеПоАвтомобилю.Версия;
		
		Если Не ПустаяСсылка(ТекМодель) Тогда
			
			//Создадим новый автомобиль
			НовыйАвтомобиль = Справочники.Автомобили.СоздатьЭлемент();
			НовыйАвтомобиль.VIN = VIN;
			НовыйАвтомобиль.Модель = ТекМодель;
			НовыйАвтомобиль.ВариантКомплектации = ТекВерсия;
			НовыйАвтомобиль.Цвет = ТекЦвет;
			//Если Не ЗначениеЗаполнено(НовыйАвтомобиль.ЦветКод) Тогда
			//	НовыйАвтомобиль.ЦветКод = "Не заполнено";
			//КонецЕсли;
			
			НовыйАвтомобиль.ВалютаУчета = ВалютаУчета;			
			
			Если ВерсияАльфаАвто = "5" Тогда		
				Если Не ЗначениеЗаполнено(НовыйАвтомобиль.ВключатьВПрайсЛист) Тогда
					НовыйАвтомобиль.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;
				КонецЕсли;					
			Иначе
				Если Не ЗначениеЗаполнено(НовыйАвтомобиль.Код) Тогда
					НовыйАвтомобиль.УстановитьНовыйКод();
				КонецЕсли;
			КонецЕсли;

			//НовыйАвтомобиль.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;			
			
			//Сгенерируем наименование автомобиля
			//доделать - настройки наименования автомобиля для разных дилеров
			НовыйАвтомобиль.Наименование = "Автомобиль Renault " + ТекМодель + ", " + ТекЦвет + ", VIN: " + VIN;
			//НовыйАвтомобиль.НаименованиеПолное = НовыйАвтомобиль.Наименование;
			
			//доделать - заполнять дополнительные поля
			//НовыйАвтомобиль.ГодВыпуска = ДанныеПоАвтомобилю.ГодВыпуска;
			//НовыйАвтомобиль.НомерДвигателя = СтроковыеДанные.НомерДвигателя;
				
			Попытка
				НовыйАвтомобиль.Записать();
				Возврат НовыйАвтомобиль.Ссылка;
			Исключение
				//Сообщить(ОписаниеОшибки());
				сфСообщитьОбОшибке(ОписаниеОшибки());
				Возврат Справочники.Автомобили.ПустаяСсылка();
			КонецПопытки;
		Иначе	
			Возврат Справочники.Автомобили.ПустаяСсылка();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Справочники.Автомобили.ПустаяСсылка();
	
КонецФункции

Функция НайтиМодель(ДанныеПоМодели, Модель = Неопределено, Версия = Неопределено)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
                           |	Модели.Ссылка
                           |ИЗ
                           |	Справочник.Модели КАК Модели
                           |ГДЕ
                           |	Модели.Артикул = &ДанныеПоМодели");
	Запрос.УстановитьПараметр("ДанныеПоМодели",ДанныеПоМодели);
	Итог = Запрос.Выполнить();
	Если Итог.Пустой() Тогда
		//Найдем по коротким кодам модели и версии
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВариантыКомплектации.Владелец.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ВариантыКомплектации КАК ВариантыКомплектации
		               |ГДЕ
		               |	ПОДСТРОКА(ВариантыКомплектации.Владелец.Артикул, 0, 3) = &КодМодели
		               |	И ВариантыКомплектации.Артикул = &КодКомплектации";
		Запрос.УстановитьПараметр("КодМодели", Модель);
		Запрос.УстановитьПараметр("КодКомплектации", Версия);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			Возврат Выборка.Ссылка;
		Иначе
			//Найдем по короткому коду модели без учета версии
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	AOC_Комплектации.МодельСпр КАК Ссылка
			               |ИЗ
			               |	РегистрСведений.AOC_Комплектации КАК AOC_Комплектации
			               |ГДЕ
			               |	ПОДСТРОКА(AOC_Комплектации.КодМодели, 0, 3) = &КодМодели";
			Запрос.УстановитьПараметр("КодМодели", Модель);			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда 
				Возврат Выборка.Ссылка;
			Иначе
				Возврат Справочники.Модели.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТаблицаМодель = Итог.Выгрузить();
		Возврат ТаблицаМодель[0].Ссылка;
	КонецЕсли;
		
КонецФункции

Функция НайтиЦвет(Артикул)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Цвета.Ссылка
	                      |ИЗ
	                      |	Справочник.Цвета КАК Цвета
	                      |ГДЕ
	                      |	Цвета.Артикул = &Артикул");
	Запрос.УстановитьПараметр("Артикул",Артикул);
	Итог = Запрос.Выполнить();
	Если Итог.Пустой() Тогда
		Возврат Справочники.Цвета.ПустаяСсылка();
	Иначе
		Ответ = Итог.Выгрузить();
		Возврат Ответ[0].Ссылка;
	КонецЕсли;
		
КонецФункции

Функция НайтиВерсию(КодКомплектации, Модель)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВариантыКомплектации.Ссылка
	                      |ИЗ
	                      |	Справочник.ВариантыКомплектации КАК ВариантыКомплектации
	                      |ГДЕ
	                      |	ВариантыКомплектации.Владелец = &МодельСпр
	                      |	И ВариантыКомплектации.Артикул = &КодКомплектации");
	Запрос.УстановитьПараметр("КодКомплектации", КодКомплектации);
	Запрос.УстановитьПараметр("МодельСпр", Модель);
	Итог = Запрос.Выполнить();
	Если Итог.Пустой() Тогда
		Возврат Справочники.ВариантыКомплектации.ПустаяСсылка();
	Иначе
		Ответ = Итог.Выгрузить();
		Возврат Ответ[0].Ссылка;
	КонецЕсли;
		
КонецФункции

