Функция НайтиСоздатьАвтомобильПоВину(VIN, ДанныеПоАвтомобилю, СтроковыеДанные)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Автомобили.Ссылка
	|ИЗ
	|	Справочник.Автомобили КАК Автомобили
	|ГДЕ
	|	Автомобили.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN", VIN);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		НовыйАвтомобиль = Выборка.Ссылка;
	Иначе 
		НовыйАвтомобиль = Справочники.Автомобили.СоздатьЭлемент();
		НовыйАвтомобиль.VIN = VIN;
		НовыйАвтомобиль.Наименование = "" + ДанныеПоАвтомобилю.Модель + ", " + ДанныеПоАвтомобилю.Цвет + ", VIN: " + VIN;
		НовыйАвтомобиль.Модель = ДанныеПоАвтомобилю.Модель;
		НовыйАвтомобиль.ВариантКомплектации = ДанныеПоАвтомобилю.Версия;
		НовыйАвтомобиль.ГодВыпуска = ДанныеПоАвтомобилю.ГодВыпуска;
		НовыйАвтомобиль.НомерДвигателя = СтроковыеДанные.НомерДвигателя;
		НовыйАвтомобиль.Цвет = ДанныеПоАвтомобилю.Цвет;
		НовыйАвтомобиль.ЦветКод = СтроковыеДанные.КодЦвета;
		НовыйАвтомобиль.УстановитьНовыйКод();
		Попытка
			НовыйАвтомобиль.Записать();
		Исключение
			сфСообщитьОбОшибке(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Возврат НовыйАвтомобиль.Ссылка;
	
КонецФункции

Функция НайтиАвтомобильПоВину(VIN)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Автомобили.Ссылка
	|ИЗ
	|	Справочник.Автомобили КАК Автомобили
	|ГДЕ
	|	Автомобили.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN", VIN);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат  Выборка.Ссылка;
	Иначе 
		Возврат Справочники.Автомобили.ПустаяСсылка();
	КонецЕсли;
	
	
	
КонецФункции

Процедура ЗаполнитьНедостающиеДанные(ДанныеПоАвто,ТаблицаПакетов,ТаблицаОтдельных)
	
	//Не все автомобили нужно грузить, пропустим ненужные
	Если Не ЗначениеЗаполнено(ДанныеПоАвто.DATE_MADPREV) И Не ЗначениеЗаполнено(ДанныеПоАвто.SEDRE_ORDER) И ДанныеПоАвто.AUTO_STATUS = "В производстве" Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеПоАвто.YEAR) И Число(ДанныеПоАвто.YEAR) < 2011 И Число(ДанныеПоАвто.YEAR) <> 1900 Тогда
		Возврат;
	КонецЕсли;
	
	//Данные по автомобилю
	Ключ = ДанныеПоАвто.VIN ;
	ЗаполнитьАртикулМодели(ДанныеПоАвто);
	ДанныеПоАвто.Модель = НайтиМодель(ДанныеПоАвто.Model_Full, ДанныеПоАвто.MODEL, ДанныеПоАвто.VERSION);
	ДанныеПоАвто.Цвет = НайтиЦвет(ДанныеПоАвто.COLOR);
	ДанныеПоАвто.Версия = НайтиВерсию(ДанныеПоАвто.VERSION, ДанныеПоАвто.Модель);
	ДанныеПоАвто.Автомобиль = НайтиСоздатьАвтомобильПоВину_v2(Ключ,ДанныеПоАвто);	
	ДанныеПоАвто.Статус =  НайтиСтатус(ДанныеПоАвто);	
	Если ЗначениеЗаполнено(ДанныеПоАвто.DATE_MADC_RECU) И Год(Дата(ДанныеПоАвто.DATE_MADC_RECU)) = 1900 Тогда //Плохо
		ДанныеПоАвто.DATE_MADC_RECU = Дата('00010101');
		ДанныеПоАвто.DATE_MADC = Дата('00010101');
	КонецЕсли;
	
	//Определим стоимость доставки а/м
	СтоимостьДоставки = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ЕСТЬNULL(ЕСТЬNULL(ПоВерсиям.СтоимостьДоставки, ПоМоделям.СтоимостьДоставки), 0) КАК СтоимостьДоставки
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Renault_СтоимостьДоставкиАвтомобилей.СтоимостьДоставки КАК СтоимостьДоставки
	               |	ИЗ
	               |		РегистрСведений.Renault_СтоимостьДоставкиАвтомобилей КАК Renault_СтоимостьДоставкиАвтомобилей
	               |	ГДЕ
	               |		Renault_СтоимостьДоставкиАвтомобилей.Версия = &Версия) КАК ПоВерсиям
	               |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Renault_СтоимостьДоставкиАвтомобилей.СтоимостьДоставки КАК СтоимостьДоставки
	               |		ИЗ
	               |			РегистрСведений.Renault_СтоимостьДоставкиАвтомобилей КАК Renault_СтоимостьДоставкиАвтомобилей
	               |		ГДЕ
	               |			Renault_СтоимостьДоставкиАвтомобилей.Модель = &Модель) КАК ПоМоделям
	               |		ПО (ИСТИНА)";				   
	Запрос.УстановитьПараметр("Версия", ДанныеПоАвто.Версия);
	Запрос.УстановитьПараметр("Модель", ДанныеПоАвто.Модель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтоимостьДоставки = Выборка.СтоимостьДоставки;
	КонецЕсли;
	Если СтоимостьДоставки = 0 ИЛИ Не ЗначениеЗаполнено(СтоимостьДоставки) Тогда
		СтоимостьДоставки = СтоимостьДоставкиПоУмолчанию;
	КонецЕсли;
	
	//Поля изменений заполним по умолчанию
	ДанныеПоАвто.НаУдаление = Ложь;
	ДанныеПоАвто.НаДобавление = Ложь;
	ДанныеПоАвто.Скрывать = Ложь;
	
	//Год не везде заполнен, дозаполним
	Если Не ЗначениеЗаполнено(ДанныеПоАвто.YEAR) ИЛИ ДанныеПоАвто.YEAR = 1900 Тогда
		Если ЗначениеЗаполнено(ДанныеПоАвто.DATE_MADC_RECU) Тогда
			ДанныеПоАвто.YEAR = Год(ДанныеПоАвто.DATE_MADC_RECU);  
		ИначеЕсли ЗначениеЗаполнено(ДанныеПоАвто.DATE_MADPREV) Тогда
			ДанныеПоАвто.YEAR = Год(ДанныеПоАвто.DATE_MADPREV);  
		Иначе
			ДанныеПоАвто.YEAR = "";  
		КонецЕсли;
	КонецЕсли;
	
	//Поля булево передаются строками, преобразуем
	Если ДанныеПоАвто.COLOR_METALLIC = "1" Тогда
		ДанныеПоАвто.ЦветМеталлик = Истина;
	Иначе
		ДанныеПоАвто.ЦветМеталлик = Ложь;
	КонецЕсли;
	
	Если ДанныеПоАвто.IS_BLOCKED = "1" Тогда
		ДанныеПоАвто.БлокировкаАФМ = Истина;
	Иначе
		ДанныеПоАвто.БлокировкаАФМ = Ложь;
	КонецЕсли;
	
	//Заполним тип автомобиля
	Если ДанныеПоАвто.FACTURE_TYPE_RU = "Продажа VND (фактура)" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.VND;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Подменные автомобили" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.Подменный;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Демонстрационные автомобили" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.Демонстрационный;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Факторинг" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Консигнация+Факторинг" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Факторинг по прил. 11" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Консигнация" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Продажа в кредит по прил. 11" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Продажа в кредит (кузовостроители)" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	ИначеЕсли ДанныеПоАвто.FACTURE_TYPE_RU = "Продажа в кредит по прил. 1" Тогда
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	Иначе
		ДанныеПоАвто.ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.НаПродажу;
	КонецЕсли;
	
	//Предрасчет цен
	ЦенаПродажиОпции = 0;
	ЦенаПродажиДопОборудования = 0;
	ЦенаЗакупкиОпции = 0;
	ЦенаПродажиБаза = 0;
	ЦенаЗакупкиБаза = 0;
	Идентификатор = "";
	
	//База
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕстьNULL(AOC_КомплектацииСрезПоследнихПродажи.ЦенаКлиентская,0) КАК ЦенаКлиентская,
	               |	AOC_КомплектацииСрезПоследнихПродажи.Идентификатор,
	               |	ЕстьNULL(AOC_КомплектацииСрезПоследнихЗакупки.ЦенаДилерская,0) КАК ЦенаДилерская
	               |ИЗ
	               |	РегистрСведений.AOC_Комплектации.СрезПоследних(
	               |			&Период,
	               |			МодельСпр = &Модель
	               |				И ВариантКомплектацииСпр = &Версия) КАК AOC_КомплектацииСрезПоследнихПродажи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.AOC_Комплектации.СрезПоследних(
	               |				&ПериодЗакупки,
	               |				МодельСпр = &Модель
	               |					И ВариантКомплектацииСпр = &Версия) КАК AOC_КомплектацииСрезПоследнихЗакупки
	               |		ПО (ИСТИНА)";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Если ЗначениеЗаполнено(ДанныеПоАвто.DATE_FACT) Тогда
		ПериодЗакупки = ДанныеПоАвто.DATE_FACT;
	Иначе
		ПериодЗакупки = ТекущаяДата();
	КонецЕсли;
	Запрос.УстановитьПараметр("ПериодЗакупки", ПериодЗакупки);
	Запрос.УстановитьПараметр("Модель", ДанныеПоАвто.Модель);
	Запрос.УстановитьПараметр("Версия", ДанныеПоАвто.Версия);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЦенаПродажиБаза = Выборка.ЦенаКлиентская;
		ЦенаЗакупкиБаза = Выборка.ЦенаДилерская*1.18;
		Идентификатор = Выборка.Идентификатор;
	Иначе
		//Сообщить("нет цены");
	КонецЕсли;
	
	ОпцииАвто = новый массив();
	Если ЗначениеЗаполнено(ДанныеПоАвто.OPTIONS) Тогда
		АртикулыОпций  = ДанныеПоАвто.OPTIONS;
		Отбор = Новый Структура();
		Отбор.Вставить("Идентификатор",Идентификатор);
		//ТабПакетовМашина = ТаблицаПакетов.НайтиСтроки(Отбор); 
		//ТабОтдельныхМашина = ТаблицаОтдельных.НайтиСтроки(Отбор);
		ОпцииАвто = МассивОпцийПоСтроке(АртикулыОпций,ТаблицаПакетов,ТаблицаОтдельных,Отбор);
		
	КонецЕсли;

	/////////
	//Опции
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		//МассивОпц = Новый Массив();
		//Для Каждого Опц Из ОпцииАвто Цикл
		//	МассивОпц.Добавить(СокрЛП(Опц.Артикул));
		//КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЕСТЬNULL(AOC_ОпцииСрезПоследних.ЦенаКлиентская, 0) КАК Цена,
		               |	ЕСТЬNULL(AOC_ОпцииСрезПоследних.ЦенаДилерская, 0) КАК ЦенаДилерская,
		               |	AOC_ОпцииСрезПоследних.ОпцияСпр КАК Опция,
		               |	AOC_ОпцииСрезПоследних.КодОпции КАК Код,
		               |	AOC_ОпцииСрезПоследних.НаименованиеОпции КАК Наименование,
		               |	&VIN
		               |ИЗ
		               |	РегистрСведений.AOC_Опции.СрезПоследних(
		               |			&Период,
		               |			Идентификатор = &Идентификатор
		               |				И ОпцияСпр В (&МассивОпций)) КАК AOC_ОпцииСрезПоследних";
		Запрос.УстановитьПараметр("Период", ТекущаяДата());
		Запрос.УстановитьПараметр("VIN", ДанныеПоАвто.VIN);
		Запрос.УстановитьПараметр("МассивОпций", ОпцииАвто);
		Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ЦенаЗакупкиОпции = 0;
		ЦенаПродажиОпции = 0;
		
		
		//Удалим запись опций по вину	
		Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Renault_ОпцииАвтомобилей.VIN,
	                      |	Renault_ОпцииАвтомобилей.Опция
	                      |ИЗ
	                      |	РегистрСведений.Renault_ОпцииАвтомобилей КАК Renault_ОпцииАвтомобилей
	                      |ГДЕ
	                      |	Renault_ОпцииАвтомобилей.VIN = &VIN");
		Запрос.УстановитьПараметр("VIN", ДанныеПоАвто.VIN);
		Таблица = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекЗапись Из Таблица Цикл
			Мен = РегистрыСведений.Renault_ОпцииАвтомобилей.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Мен,ТекЗапись);
			Мен.Прочитать();
			Если Мен.Выбран() Тогда
				Мен.Удалить();
			КонецЕсли;				
		КонецЦикла;
		
		КонкатинацияНаименованийОпций = "";
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.Цена) Тогда
				ЦенаПродажиОпции = ЦенаПродажиОпции + Выборка.Цена;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ЦенаДилерская) Тогда
				ЦенаЗакупкиОпции = ЦенаЗакупкиОпции + Выборка.ЦенаДилерская;
			КонецЕсли;
			
			//Обновим запись опций по вину
			Мен = РегистрыСведений.Renault_ОпцииАвтомобилей.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Мен, Выборка);
	        Мен.Записать();
			
			//Козлов Е.А. Начало 07.07.2016 //обновим (добавим) записи опции варианта комплектации
			ВариантКомплектации = ДанныеПоАвто.Автомобиль.ВариантКомплектации;
			ЗаписьОВК = РегистрыСведений.ОпцииВариантовКомплектации.СоздатьМенеджерЗаписи();
			ЗаписьОВК.ВариантКомплектации = ВариантКомплектации;
			ЗаписьОВК.Опция = Выборка.Опция;
			ЗаписьОВК.Количество = 1;
			ЗаписьОВК.ЦенаЗакупки = Выборка.ЦенаДилерская;
			ЗаписьОВК.ВидВключения = 2;
			ЗаписьОВК.Записать(Истина);
			//Козлов Е.А. Конец
			
			//Получим конкатинацию наименований
			КонкатинацияНаименованийОпций = КонкатинацияНаименованийОпций + Выборка.Наименование + " ";
			
		КонецЦикла;
		
		КонкатинацияНаименованийОпций = СокрЛП(КонкатинацияНаименованийОпций);

	КонецЕсли;
	
	ДанныеПоАвто.ЦенаПродажиОпции = ЦенаПродажиОпции;	
	ДанныеПоАвто.ЦенаПродажиБаза = ЦенаПродажиБаза;
	ДанныеПоАвто.НаименованияОпций = КонкатинацияНаименованийОпций;
	
	//Доп оборудование
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(КомплектацияАвтомобилей.Сумма) КАК СуммаЗакупки,
	|	СУММА(ЦеныСрезПоследних.Цена) КАК СуммаПродажи
	|ИЗ
	|	РегистрНакопления.КомплектацияАвтомобилей КАК КомплектацияАвтомобилей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|		ПО КомплектацияАвтомобилей.Номенклатура = ЦеныСрезПоследних.Номенклатура
	|ГДЕ
	|	КомплектацияАвтомобилей.Автомобиль = &Автомобиль
	|	И (КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ВводОстатковАвтомобилей
	|			ИЛИ КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ЗаказНаряд
	|			ИЛИ КомплектацияАвтомобилей.Регистратор ССЫЛКА Документ.ИнвентаризацияАвтомобилей)
	|	И КомплектацияАвтомобилей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|ИМЕЮЩИЕ
	|	СУММА(КомплектацияАвтомобилей.Количество) <> 0";
	Запрос.УстановитьПараметр("Автомобиль", ДанныеПоАвто.Автомобиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЦенаПродажиДопОборудования = Выборка.СуммаПродажи;
		СебестоимостьДопОборудования = Выборка.СуммаЗакупки;
		Если Не ЗначениеЗаполнено(ЦенаПродажиДопОборудования) Тогда
			ЦенаПродажиДопОборудования = 0;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СебестоимостьДопОборудования) Тогда
			СебестоимостьДопОборудования = 0;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеПоАвто.ЦенаПродажиДопОборудования = ЦенаПродажиДопОборудования;
	ДанныеПоАвто.СебестоимостьДопОборудования = СебестоимостьДопОборудования;
	
	//Итоги
	
	ДанныеПоАвто.ЦенаПродажиАвтомобиля = ЦенаПродажиОпции + ЦенаПродажиБаза + СтоимостьДоставки + ЦенаПродажиДопОборудования;
	ДанныеПоАвто.ЦенаКлиентская = ЦенаПродажиБаза + ЦенаПродажиОпции + СтоимостьДоставки;
	
	//Стоимость доставки 
	ДанныеПоАвто.ЦенаПродажиДоставка = СтоимостьДоставки;	
	
	//Стоимость закупки
	Если ЗначениеЗаполнено(ДанныеПоАвто.DEALER_PRICE_OPTION)Тогда
		ДанныеПоАвто.ЦенаЗакупкиОпции = ДанныеПоАвто.DEALER_PRICE_OPTION;
	Иначе
		ДанныеПоАвто.ЦенаЗакупкиОпции = ЦенаЗакупкиОпции;
    КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеПоАвто.DEALER_PRICE_BASE)Тогда
		ДанныеПоАвто.ЦенаЗакупкиБаза = ДанныеПоАвто.DEALER_PRICE_BASE;
	Иначе
		ДанныеПоАвто.ЦенаЗакупкиБаза= ЦенаЗакупкиБаза;
    КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеПоАвто.DEALER_PRICE_FULL)Тогда
		ДанныеПоАвто.ЦенаЗакупкиАвтомобиля = ДанныеПоАвто.DEALER_PRICE_FULL;
		ДанныеПоАвто.ЦенаДилерская = ДанныеПоАвто.DEALER_PRICE_FULL;
		ДанныеПоАвто.СебестоимостьПоТН = ДанныеПоАвто.DEALER_PRICE_FULL;
	Иначе
		ДанныеПоАвто.ЦенаЗакупкиАвтомобиля = ЦенаЗакупкиОпции + ЦенаЗакупкиБаза;
		ДанныеПоАвто.ЦенаДилерская = ЦенаЗакупкиОпции + ЦенаЗакупкиБаза;
    КонецЕсли;
	
КонецПроцедуры

Функция НайтиСтатус(ДанныеПоАвто)
	//Статус автомобиля (в производстве, в транспорте до АФМ, на складе AFM, отправлен дилеру, на складе дилера)	
	Если ДанныеПоАвто.AUTO_STATUS = "В производстве" Тогда
		Возврат Перечисления.CRM_СтатусыАвтомобилей.ВПроизводстве;
	ИначеЕсли ДанныеПоАвто.AUTO_STATUS = "В транспорте до АФМ" Тогда
		Возврат Перечисления.CRM_СтатусыАвтомобилей.ВПути;
	ИначеЕсли ДанныеПоАвто.AUTO_STATUS = "Отправлен дилеру" Тогда
		Возврат Перечисления.CRM_СтатусыАвтомобилей.ВПутиКДилеру;
	ИначеЕсли ДанныеПоАвто.AUTO_STATUS = "На складе дилера" Тогда
		Возврат Перечисления.CRM_СтатусыАвтомобилей.ВПутиКДилеру;
	//ИначеЕсли ДанныеПоАвто.AUTO_STATUS = "в производстве" Тогда
	//	Возврат Перечисления.CRM_СтатусыАвтомобилей.ЗаказВПроизводство;
	ИначеЕсли ДанныеПоАвто.AUTO_STATUS = "На складе AFM" Тогда
		Возврат Перечисления.CRM_СтатусыАвтомобилей.НаСкладеАФМ;
	Иначе
		Возврат Перечисления.CRM_СтатусыАвтомобилей.ПустаяСсылка();
	КонецЕсли;	
	
КонецФункции

