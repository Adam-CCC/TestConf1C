функция МассивОпцийПоСтроке(Знач ВхАртикулы,ТаблицаПакетов,ТаблицаОтдельных,Отб)
	МассивОпций = Новый Массив();
	ТабПакетов = ТаблицаПакетов.НайтиСтроки(Отб);
	//Для Каждого АртикулПакета Из ТаблицаПакетов Цикл
	Для Каждого АртикулПакета Из ТабПакетов Цикл

		Если ВСтрокеЕстьПакетОпций(ВхАртикулы,АртикулПакета.Артикул) Тогда
			ВхАртикулы = УбратьИзСтрокиПакетОпций(ВхАртикулы,АртикулПакета.Артикул);
			МассивОпций.Добавить(АртикулПакета.Ссылка);
		КонецЕсли;
	КонецЦикла;
	МассивСтроки = обРазложитьСтрокуВМассивПодстрок(вхАртикулы," ");
	Для Каждого ТекАрт Из МассивСтроки Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("Идентификатор",Отб.Идентификатор);
		Отбор.Вставить("Артикул",ТекАрт);
		Табл = ТаблицаОтдельных.НайтиСтроки(Отбор);
		//Индекс = ТаблицаОтдельных.Найти(ТекАрт,"Артикул");
		//Если  Не (Индекс= Неопределено) Тогда
			////МассивСтроки.Удалить(Индекс.Артикул);
			//МассивОпций.Добавить(Индекс.Ссылка);

		Если Табл.Количество()>0 Тогда
			//МассивСтроки.Удалить(Индекс.Артикул);
			МассивОпций.Добавить(Табл[0].Ссылка);
	
		КонецЕсли;
	КонецЦикла;
	Возврат МассивОпций;
	
