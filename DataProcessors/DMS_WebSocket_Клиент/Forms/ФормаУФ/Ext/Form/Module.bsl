#Область ОтправкаСообщений

&НаКлиенте
Процедура ОтправитьСообщение(Команда)
	//ОтправитьСообщениеНаСервере();
	
	СтруктураСообщения = Новый Структура;
	СтруктураСообщения.Вставить("from", ПсевдонимНаСервере);
	СтруктураСообщения.Вставить("to", destination);
	СтруктураСообщения.Вставить("type", "");
	СтруктураСообщения.Вставить("message", "");


	Очередь = РегистрыСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки.СоздатьМенеджерЗаписи();
	ПодготовитьСтруктуруСообщения(СтруктураСообщения);
	ЗаполнитьЗначенияСвойств(Очередь, СтруктураСообщения);
	Очередь.ДатаСообщения = ТекущаяДата();
	Очередь.ИД = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Очередь.full = Новый ХранилищеЗначения(СтруктураСообщения);
	Очередь.Записать();

	//DMS_WebSocketСервер.ДобавитьСообщениеВОчередьСообщений(ПсевдонимНаСервере, destination, type, message);
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьСтруктуруСообщения(СтруктураСообщения)

	Если Метод =  "GetAvailableSlots" Тогда 
			
	ИначеЕсли Метод = "ReserveSlot" Тогда 
		ReserveSlotСтруктура(СтруктураСообщения);		
	ИначеЕсли Метод = "ApprovedReserveSlot" Тогда 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ReserveSlotСтруктура(СтруктураСообщения)
	
	СтруктураData = Новый Структура;
	
	СтруктураМодели = Новый Структура;
	СтруктураМодели.Вставить("VIN","");
	СтруктураМодели.Вставить("ModelCode",Модель);
	СтруктураМодели.Вставить("VersionCode","");
	СтруктураМодели.Вставить("FuelType","");
	СтруктураМодели.Вставить("EngineType","");
	СтруктураМодели.Вставить("AirConditioner",Истина);
	СтруктураМодели.Вставить("ABS",Истина);
	СтруктураМодели.Вставить("PowerSteering",Истина);
	СтруктураМодели.Вставить("CabinFilter",Истина);
	
	МассивКС=Новый Массив;
	МассивКС.Добавить(Новый Структура("ComplexPrice,ComplexName,ComplexID",10000,"Кс_Тест",КомплексСервис));
	
	МассивКСКоды=Новый Массив;
	МассивКСКоды.Добавить(КомплексСервис);
	
	СтруктураData.Вставить("SlotID",ЗаписьНаСлот);
	СтруктураData.Вставить("StartTime",ЗаписатьДатуJSON(ВремяНачала,ФорматДатыJSON.ISO,ВариантЗаписиДатыJSON.УниверсальнаяДата));
	СтруктураData.Вставить("FirstName",Имя);
	СтруктураData.Вставить("MiddleName",Отчество);
	СтруктураData.Вставить("LastName",Фамилия);
	СтруктураData.Вставить("Telephone",Телефон);
	СтруктураData.Вставить("Email","");
	СтруктураData.Вставить("Comment","");
	СтруктураData.Вставить("ContactClient",Истина);
	СтруктураData.Вставить("PersDataAgree",Истина);
	СтруктураData.Вставить("Odometer",1000);
	
	СтруктураData.Вставить("ModelDesc",СтруктураМодели);
	СтруктураData.Вставить("ComplexList",МассивКС);
	СтруктураData.Вставить("ComplexCodeList",МассивКСКоды);
	
	СтруктураСообщения.Вставить("Data",СтруктураData);

КонецПроцедуры




