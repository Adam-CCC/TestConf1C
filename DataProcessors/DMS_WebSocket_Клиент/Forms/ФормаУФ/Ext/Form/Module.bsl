Процедура ОчиститьЛогСообщенийФЗ(Команда)
	ЛогСообщенийФЗ = "";
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьЛогСообщенийФЗНаСервере(ЛогСообщенийФЗ)
	Перем МассивФЗ;
	
	Если DMS_WebSocketСервер.ЕстьАктивныеФоновыеЗадания(МассивФЗ) Тогда
		Для каждого ФоновоеЗадание Из МассивФЗ Цикл
			МассивСообщений = ФоновоеЗадание.ПолучитьСообщенияПользователю(Истина);
			Для каждого Сообщение Из МассивСообщений Цикл
				ЛогСообщенийФЗ = ЛогСообщенийФЗ + Символы.ПС + Сообщение.Текст;
			КонецЦикла; 
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЛогСообщенийФЗ(Команда)
	ОбновитьЛогСообщенийФЗНаСервере(ЛогСообщенийФЗ);
КонецПроцедуры

&НаКлиенте
Процедура СообщенияНЗВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	НаборЗаписей = РегистрыСведений.DMS_WebSocket_Сообщения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИД.Установить(ВыбраннаяСтрока.ИД);
	НаборЗаписей.Отбор.ДатаСообщения.Установить(ВыбраннаяСтрока.ДатаСообщения);
	НаборЗаписей.Отбор.name.Установить(ВыбраннаяСтрока.name);
	НаборЗаписей.Отбор.to.Установить(ВыбраннаяСтрока.to);
	НаборЗаписей.Прочитать();
	Для Каждого Запись Из НаборЗаписей Цикл 
		СтруктураДанных = Запись.full.Получить();

	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчередьСообщенийНЗВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	НаборЗаписей = РегистрыСведений.DMS_WebSocket_ОчередьСообщенийДляОтправки.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИД.Установить(ВыбраннаяСтрока.ИД);
	НаборЗаписей.Отбор.ДатаСообщения.Установить(ВыбраннаяСтрока.ДатаСообщения);
	НаборЗаписей.Отбор.name.Установить(ВыбраннаяСтрока.name);
	НаборЗаписей.Отбор.to.Установить(ВыбраннаяСтрока.to);
	НаборЗаписей.Прочитать();
	Для Каждого Запись Из НаборЗаписей Цикл 
		СтруктураДанных = Запись.full.Получить();
		Запись = новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, СтруктураДанных);
		
		ЛогСообщенийФЗ = Запись.Закрыть();	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.Метод.СписокВыбора.Добавить("GetAvailableSlots","GetAvailableSlots");
	Элементы.Метод.СписокВыбора.Добавить("ReserveSlot","ReserveSlot");
	Элементы.Метод.СписокВыбора.Добавить("ApprovedReserveSlot","ApprovedReserveSlot");
КонецПроцедуры

&НаКлиенте
Процедура СообщенияНЗ1ПриАктивизацииСтроки(Элемент)
	ВыбраннаяСтрока = Элементы.СообщенияНЗ1.ТекущиеДанные;
	НаборЗаписей = РегистрыСведений.DMS_WebSocket_Сообщения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИД.Установить(ВыбраннаяСтрока.ИД);
	НаборЗаписей.Отбор.ДатаСообщения.Установить(ВыбраннаяСтрока.ДатаСообщения);
	НаборЗаписей.Отбор.name.Установить(ВыбраннаяСтрока.name);
	НаборЗаписей.Отбор.to.Установить(ВыбраннаяСтрока.to);
	НаборЗаписей.Прочитать();
	Для Каждого Запись Из НаборЗаписей Цикл 
		СтруктураДанных = Запись.full.Получить();
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON,СтруктураДанных,Новый НастройкиСериализацииJSON);
	Ответ = ЗаписьJSON.Закрыть();

	
КонецПроцедуры

