&НаКлиенте
Процедура ОткрытьФормуКЗ(Команда)
	
	Структура = Новый Структура;
	ПараметрыВызова = Новый Структура;
	ЭлементыОтбора = Новый Структура("VIN","X7LHSRHGN60065324");
	ПараметрыВызова = Новый Структура("ЗначенияЗаполнения", ЭлементыОтбора);
	Структура.Вставить("form","Документ.DMS_КлиентскиеЗаявки.Форма.ФормаДокумента");	
	Структура.Вставить("params",ПараметрыВызова);	
    ОкноПервогоБраузера.postOnWeb(СериализоватьВСтрокуJSON(Структура));
КонецПроцедуры

&НаКлиенте
Функция СериализоватьВСтрокуJSON(Данные) Экспорт
	
	Запись = новый ЗаписьJSON;
    Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	
	Возврат Запись.Закрыть();
 
КонецФункции

&НаКлиенте
функция ДесериализоватьСтрокуJSON(СтрокаJSON) Экспорт
	
	Чтение = новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	
	Результат = ПрочитатьJSON(Чтение);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьДанныеКЗ(ГУИД)
	
	Соединение = Новый HTTPСоединение("84.201.169.9", 8080,"Администратор",""); 
    Запрос = Новый HTTPЗапрос("/zenin_webdms_dev/odata/standard.odata/Document_DMS_КлиентскиеЗаявки(Ref_Key=guid'a7615727-f372-11ea-80d3-d383ef98ae60')?$format=json");
    Результат = Соединение.Получить(Запрос);
	JSON = Результат.ПолучитьТелоКакСтроку();
	
КонецПроцедуры

