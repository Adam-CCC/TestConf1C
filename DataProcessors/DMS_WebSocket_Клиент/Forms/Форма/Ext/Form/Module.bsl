&НаКлиенте
Процедура ПолеБраузераДокументСформирован(Элемент)
	// Исключение обработки дубля события "ДокументСформирован"
	Если НЕ ПервыйБраузерЗагрузкаОбработана Тогда
		ПервыйБраузерЗагрузкаОбработана = Истина;
		
		// Сохранение элементов document и window в переменных формы,
		// для последующего быстрого доступа к элементам и функциям.
		ДокументПервогоБраузера = Элемент.Документ;
		ОкноПервогоБраузера 	= ДокументПервогоБраузера.parentWindow;
		Если ОкноПервогоБраузера = Неопределено Тогда
			ОкноПервогоБраузера = ДокументПервогоБраузера.defaultView;	
		КонецЕсли;
		
		ОкноПервогоБраузера.externalForm = ЭтаФорма;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеБраузераПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	ИмяОперации = ДанныеСобытия.Element.id;
	ДанныеОперации = ДанныеСобытия.Element.innerText;
	Если Не ЗначениеЗаполнено(ИмяОперации) Тогда //не наше событие
		Возврат;                       
	КонецЕсли;
	
	ПолучитьДанныеКЗ(ДанныеОперации);
	
КонецПроцедуры

