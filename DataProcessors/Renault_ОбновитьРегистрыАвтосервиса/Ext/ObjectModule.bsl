			//ЗаполнитьЗначенияСвойств(СтруктураЗаписиРегистра,ВыборкаДанных);
			//СтруктураЗаписиРегистра.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена;
			// изменим регистр сведений АРМ_АВтосервис
			
			НаборЗаписей = РегистрыСведений.DMS_АРМ_Автосервис.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ДилерскийЦентр.Установить(ВыборкаДанных.ДилерскийЦентр);
			НаборЗаписей.Отбор.РабочийПериод.Установить(ВыборкаДанных.РабочийПериод);
			НаборЗаписей.Отбор.Обращение.Установить(ВыборкаДанных.Обращение);
			НаборЗаписей.Отбор.ЭтапРабот.Установить(ВыборкаДанных.ЭтапРабот);
			НаборЗаписей.Отбор.РабочийДокумент.Установить(ВыборкаДанных.РабочийДокумент);
			НаборЗаписей.Прочитать();	
			Если НаборЗаписей.Количество()= 1 Тогда
				запись = НаборЗаписей[0];
				Запись.Статус = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена; //Справочники.Renault_СтатусыАвторабот.РаботаЗакончена
				НаборЗаписей.Записать(Истина);
			КонецЕсли;
		КонецЕсли; 
