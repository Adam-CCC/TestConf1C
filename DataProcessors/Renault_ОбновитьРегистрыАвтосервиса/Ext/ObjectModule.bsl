Процедура ОчиститьИзбыточныеДанные()
	
	ВыборкаДЦ = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	
	МожноПриступать = Истина;
	
	Пока ВыборкаДЦ.Следующий() Цикл
		
		ТекущийКонецРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ВыборкаДц.Ссылка, ТекущаяДата());
		
		Если ЗначениеЗаполнено(ТекущийКонецРабочегоДня) И ТекущийКонецРабочегоДня + 180 < ТекущаяДата() Тогда
			
		Иначе
			
			МожноПриступать = Ложь;
			Возврат;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Если МожноПриступать Тогда
		
		ОчиститьПланОперативный();
		
		УдалитьРегистры();
		
	КонецЕсли;	
		
КонецПроцедуры

Процедура ОчиститьПланОперативный()
	
	Запрос = Новый Запрос ("ВЫБРАТЬ
	         |	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы,
	         |	Renault_АвтосервисСтатусыРаботСрезПоследних.Обращение,
	         |	Renault_АвтосервисСтатусыРаботСрезПоследних.РабочийДокумент
	         |ИЗ
	         |	РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних КАК Renault_АвтосервисСтатусыРаботСрезПоследних
	         |ГДЕ
	         |	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы = &СтатусРаботы");
			 
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		
		Набор = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		Набор.Отбор.РабочийДокумент.Значение = Выборка.РабочийДокумент;
		Набор.Отбор.РабочийДокумент.Использование = Истина;
		
		Набор.Прочитать();
		
		Набор.Очистить();
		
		Набор.Записать();
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура УдалитьПустыеСтатусы()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.Renault_АвтосервисСтатусыРабот КАК Renault_АвтосервисСтатусыРабот
	               |ГДЕ
	               |	Renault_АвтосервисСтатусыРабот.СтатусРаботы = &СтатусРаботы";
				   
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
					
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		
		Запись.Прочитать();
		
		Если Запись.Выбран() Тогда
			
			Запись.Удалить();
			
			Сообщить(Строка(Выборка.Рабочийдокумент) + " " + Строка(Выборка.ЭтапРабот) + " " + Строка(Выборка.СтатусРаботы) + " удален.");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура НайтиИУдалитьЛишниеСтатусы(РабочийДокумент, Этап)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	РегистрСведений.Renault_АвтосервисСтатусыРабот КАК Renault_АвтосервисСтатусыРабот
	               |ГДЕ
	               |	Renault_АвтосервисСтатусыРабот.СтатусРаботы <> &СтатусРаботы
	               |	И Renault_АвтосервисСтатусыРабот.РабочийДокумент = &РабочийДокумент
	               |	И Renault_АвтосервисСтатусыРабот.ЭтапРабот = &ЭтапРабот
	               |	И Renault_АвтосервисСтатусыРабот.СтатусРаботы <> &Запланирована";
				   
	Запрос.УстановитьПараметр("РабочийДокумент", РабочийДокумент);
	Запрос.УстановитьПараметр("ЭтапРабот", Этап);
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	Запрос.УстановитьПараметр("Запланирована", Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
					
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		
		Запись.Прочитать();
		
		Если Запись.Выбран() Тогда
			
			Запись.Удалить();
			
			Сообщить(Строка(Выборка.Рабочийдокумент) + " " + Строка(Выборка.ЭтапРабот) + " " + Строка(Выборка.СтатусРаботы) + " удален.");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьРегистры()
	
	УдалитьПустыеСтатусы();
		
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_АвтосервисСтатусыРабот.СтатусРаботы,
	               |	Renault_АвтосервисСтатусыРабот.ЭтапРабот,
	               |	Renault_АвтосервисСтатусыРабот.РабочийДокумент
	               |ИЗ
	               |	РегистрСведений.Renault_АвтосервисСтатусыРабот КАК Renault_АвтосервисСтатусыРабот
	               |ГДЕ
	               |	Renault_АвтосервисСтатусыРабот.СтатусРаботы = &СтатусРаботы
	               |	И Renault_АвтосервисСтатусыРабот.Период < &Период";
				   
				   
	Запрос.УстановитьПараметр("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДата()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		 НайтиИУдалитьЛишниеСтатусы(Выборка.РабочийДокумент, Выборка.ЭтапРабот);
		
	КонецЦикла;
	
КонецПроцедуры







 
 