
Процедура ОбработкаНаСервере() Экспорт
	
	Renault_Лицензирование.ПроверитьНаличиеЛицензий();
	
	ОбновитьРегистрыАвтосервиса();
	// БурковскийМЕ от 18.37.19 {
	Обновить_DMS_АРМ_АВтосервис();
	// БурковскийМЕ от 18.37.19 }
	
	ОчиститьИзбыточныеДанные();
	
КонецПроцедуры

Процедура ОбновитьРегистрыАвтосервиса() Экспорт
	
	Период 			= ТекущаяДатаСеанса();
	ШагПланирования	= 60;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГрафикРаботАвтосервиса.Ссылка КАК ДилерскийЦентр,
		|	ГрафикРаботАвтосервиса.НачалоРабочегоДня КАК НачалоРабочегоДня,
		|	ГрафикРаботАвтосервиса.КонецРабочегоДня КАК КонецРабочегоДня
		|ПОМЕСТИТЬ ГрафикиРаботДилерскихЦентров
		|ИЗ
		|	Справочник.CRM_ДилерскиеЦентры.АвтосервисГрафикРабот КАК ГрафикРаботАвтосервиса
		|ГДЕ
		|	ГрафикРаботАвтосервиса.ДеньНедели = ДЕНЬНЕДЕЛИ(&Период)
		|	И НЕ ГрафикРаботАвтосервиса.Ссылка.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПланРаботАвтосервиса.ДилерскийЦентр КАК ДилерскийЦентр,
		|	ГрафикиРаботДилерскихЦентров.НачалоРабочегоДня КАК НачалоРабочегоДня,
		|	ГрафикиРаботДилерскихЦентров.КонецРабочегоДня КАК КонецРабочегоДня,
		|	ПланРаботАвтосервиса.РабочийДокумент КАК РабочийДокумент,
		|	ПланРаботАвтосервиса.Цех КАК Цех,
		|	ПланРаботАвтосервиса.ЭтапРабот КАК ЭтапРабот,
		|	ПланРаботАвтосервиса.ВремяНачала КАК ВремяНачала,
		|	ПланРаботАвтосервиса.ВремяОкончания КАК ВремяОкончания,
		|	ПланРаботАвтосервиса.Длительность КАК Длительность,
		|	СтатусыРаботАвтосервиса.СтатусРаботы КАК СтатусРаботы,
		|	ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), ЧАС, ЧАС(ГрафикиРаботДилерскихЦентров.НачалоРабочегоДня)), МИНУТА, МИНУТА(ГрафикиРаботДилерскихЦентров.НачалоРабочегоДня)) КАК НачалоРабочегоДняДЦ,
		|	ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Период, ДЕНЬ), ЧАС, ЧАС(ГрафикиРаботДилерскихЦентров.КонецРабочегоДня)), МИНУТА, МИНУТА(ГрафикиРаботДилерскихЦентров.КонецРабочегоДня)) КАК КонецРабочегоДняДЦ,
		|	&Период КАК Период,
		|	ЕСТЬNULL(ПланРаботАвтосервиса.РабочийДокумент.Обращение, ЗНАЧЕНИЕ(Документ.Renault_CRM_ОбращениеВАвтоСервис.ПустаяСсылка)) КАК ОбращениеРабочийДокумент,
		|	ПланРаботАвтосервиса.ДилерскийЦентр.Автосервис_ИгнорироватьНезакрытуюВыдачу КАК ИгнорироватьНезакрытуюВыдачу,
		|	ПланРаботАвтосервиса.ДилерскийЦентр.Автосервис_НеДвигатьПросроченныеРаботы КАК НеДвигатьПросроченныеРаботы,
		|	ПланРаботАвтосервиса.ДилерскийЦентр.ДлительностьВыдачи КАК ДлительностьВыдачи,
		|	ПланРаботАвтосервиса.ДилерскийЦентр.Автосервис_ЗавершатьВыдачуЧерез КАК ЗавершатьВыдачуЧерез,
		|	ПланРаботАвтосервиса.ДилерскийЦентр.ДлительностьПриемки КАК ДлительностьПриемки,
		|	ПланРаботАвтосервиса.ДилерскийЦентр.Автосервис_ЗавершатьПриемкуЧерез КАК ЗавершатьПриемкуЧерез,
		|	ПланРаботАвтосервиса.Обращение КАК Обращение
		|ПОМЕСТИТЬ ТаблицаДанных
		|ИЗ
		|	РегистрСведений.Renault_АвтосервисПланРабот КАК ПланРаботАвтосервиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ГрафикиРаботДилерскихЦентров КАК ГрафикиРаботДилерскихЦентров
		|		ПО ПланРаботАвтосервиса.ДилерскийЦентр = ГрафикиРаботДилерскихЦентров.ДилерскийЦентр
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних(&Период, ) КАК СтатусыРаботАвтосервиса
		|		ПО ПланРаботАвтосервиса.ДилерскийЦентр = СтатусыРаботАвтосервиса.ДилерскийЦентр
		|			И ПланРаботАвтосервиса.РабочийДокумент = СтатусыРаботАвтосервиса.РабочийДокумент
		|			И ПланРаботАвтосервиса.Цех = СтатусыРаботАвтосервиса.Цех
		|			И ПланРаботАвтосервиса.ЭтапРабот = СтатусыРаботАвтосервиса.ЭтапРабот
		|			И (НЕ СтатусыРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_ЗаявкаНаПодменныйАвто)
		|			И (НЕ СтатусыРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПростой)
		|			И (НЕ СтатусыРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисОбед)
		|			И (НЕ СтатусыРаботАвтосервиса.РабочийДокумент ССЫЛКА Документ.Renault_CRM_АвтосервисПрочаяЗанятость)
		|			И ПланРаботАвтосервиса.Обращение = СтатусыРаботАвтосервиса.Обращение
		|			И (ЕСТЬNULL(СтатусыРаботАвтосервиса.СтатусРаботы, ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.пустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаЗакончена))
		|			И (ЕСТЬNULL(СтатусыРаботАвтосервиса.СтатусРаботы, ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.пустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.ПустаяСсылка))
		|			И (ЕСТЬNULL(СтатусыРаботАвтосервиса.СтатусРаботы, ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.пустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаОбед))
		|			И (ЕСТЬNULL(СтатусыРаботАвтосервиса.СтатусРаботы, ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.пустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаПростой))
		|			И (ЕСТЬNULL(СтатусыРаботАвтосервиса.СтатусРаботы, ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.пустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаПрочаяЗанятость))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланОперативный.СрезПоследних(&Период, ) КАК ОперативныйПланАвтосервиса
		|		ПО ПланРаботАвтосервиса.ДилерскийЦентр = ОперативныйПланАвтосервиса.ДилерскийЦентр
		|			И ПланРаботАвтосервиса.Обращение = ОперативныйПланАвтосервиса.Обращение
		|			И ПланРаботАвтосервиса.РабочийДокумент = ОперативныйПланАвтосервиса.РабочийДокумент
		|			И ПланРаботАвтосервиса.ЭтапРабот = ОперативныйПланАвтосервиса.ЭтапРабот
		|			И ПланРаботАвтосервиса.Цех = ОперативныйПланАвтосервиса.Цех
		|ГДЕ
		|	ЕСТЬNULL(ОперативныйПланАвтосервиса.ВремяНачала, ПланРаботАвтосервиса.ВремяНачала) <= &Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВЫБОР
		|			КОГДА ФактОперативныйАвтосервис.ВремяОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА РАЗНОСТЬДАТ(ФактОперативныйАвтосервис.ВремяНачала, &Период, СЕКУНДА)
		|			ИНАЧЕ РАЗНОСТЬДАТ(ФактОперативныйАвтосервис.ВремяНачала, ФактОперативныйАвтосервис.ВремяОкончания, СЕКУНДА)
		|		КОНЕЦ) КАК ФактВремени,
		|	ТаблицаДанных.ДилерскийЦентр КАК ДилерскийЦентр,
		|	ТаблицаДанных.РабочийДокумент КАК РабочийДокумент,
		|	ТаблицаДанных.Цех КАК Цех,
		|	ТаблицаДанных.ЭтапРабот КАК ЭтапРабот,
		|	ТаблицаДанных.Обращение КАК Обращение
		|ПОМЕСТИТЬ ФактическоеВремя
		|ИЗ
		|	ТаблицаДанных КАК ТаблицаДанных
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисФактОперативный КАК ФактОперативныйАвтосервис
		|		ПО ТаблицаДанных.ДилерскийЦентр = ФактОперативныйАвтосервис.ДилерскийЦентр
		|			И ТаблицаДанных.РабочийДокумент = ФактОперативныйАвтосервис.РабочийДокумент
		|			И ТаблицаДанных.ЭтапРабот = ФактОперативныйАвтосервис.ЭтапРабот
		|			И ТаблицаДанных.Цех = ФактОперативныйАвтосервис.Цех
		|			И ТаблицаДанных.Обращение = ФактОперативныйАвтосервис.Обращение
		|			И (ТаблицаДанных.Период <= ТаблицаДанных.КонецРабочегоДняДЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаДанных.ДилерскийЦентр,
		|	ТаблицаДанных.РабочийДокумент,
		|	ТаблицаДанных.Цех,
		|	ТаблицаДанных.ЭтапРабот,
		|	ТаблицаДанных.Обращение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанных.ДилерскийЦентр,
		|	ТаблицаДанных.РабочийДокумент,
		|	ТаблицаДанных.Цех,
		|	ТаблицаДанных.ЭтапРабот,
		|	ТаблицаДанных.Обращение,
		|	ТаблицаДанных.СтатусРаботы,
		|	ТаблицаДанных.НачалоРабочегоДня,
		|	ТаблицаДанных.КонецРабочегоДня,
		|	ТаблицаДанных.ВремяНачала,
		|	ТаблицаДанных.ВремяОкончания,
		|	ТаблицаДанных.Длительность,
		|	ТаблицаДанных.НачалоРабочегоДняДЦ,
		|	ТаблицаДанных.КонецРабочегоДняДЦ,
		|	ТаблицаДанных.Период,
		|	ТаблицаДанных.ОбращениеРабочийДокумент,
		|	ТаблицаДанных.ИгнорироватьНезакрытуюВыдачу,
		|	ТаблицаДанных.НеДвигатьПросроченныеРаботы,
		|	ТаблицаДанных.ДлительностьВыдачи КАК ДлительностьВыдачи,
		|	ТаблицаДанных.ЗавершатьВыдачуЧерез КАК ЗавершатьВыдачуЧерез,
		|	ТаблицаДанных.ДлительностьПриемки КАК ДлительностьПриемки,
		|	ТаблицаДанных.ЗавершатьПриемкуЧерез КАК ЗавершатьПриемкуЧерез,
		|	ЕСТЬNULL(ФактическоеВремя.ФактВремени, 0) КАК ФактВремени
		|ИЗ
		|	ТаблицаДанных КАК ТаблицаДанных
		|		ЛЕВОЕ СОЕДИНЕНИЕ ФактическоеВремя КАК ФактическоеВремя
		|		ПО ТаблицаДанных.ДилерскийЦентр = ФактическоеВремя.ДилерскийЦентр
		|			И ТаблицаДанных.РабочийДокумент = ФактическоеВремя.РабочийДокумент
		|			И ТаблицаДанных.Цех = ФактическоеВремя.Цех
		|			И ТаблицаДанных.ЭтапРабот = ФактическоеВремя.ЭтапРабот
		|			И ТаблицаДанных.Обращение = ФактическоеВремя.Обращение";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДанных.Следующий() Цикл
		
		Если ВыборкаДанных.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована Тогда
			
			СтруктураЗаписиРегистра = Новый Структура("Период,ДилерскийЦентр,Обращение,РабочийДокумент,Цех,ЭтапРабот,СтатусРаботы");
			ЗаполнитьЗначенияСвойств(СтруктураЗаписиРегистра,ВыборкаДанных);
			СтруктураЗаписиРегистра.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена;
			
			ДобавитьЗаписьВРегистрСведений(СтруктураЗаписиРегистра,"Renault_АвтосервисСтатусыРабот");	
			
		КонецЕсли; 
		
		ЗаписатьНезаконченнуюРаботу(ВыборкаДанных,ШагПланирования);
		
	КонецЦикла;
	
	ОбработатьСтатусы(ШагПланирования);
	
	ЗавершитьРаботыБезПлана();
	
КонецПроцедуры

