// Добавляет одну запись в регистр сведений по переданным значениям структуры.
//
// Параметры:
//  СтруктураЗаписи - Структура - структура, по значениям которой необходимо создать набор записей и заполнить этот
//                                набор.
//  ИмяРегистра     - Строка - имя регистра сведений, в который необходимо добавить запись.
// 
Процедура ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, Знач ИмяРегистра, СтруктураОтбора = Неопределено, Загрузка = Ложь) Экспорт
	
	Если СтруктураОтбора = Неопределено Тогда
		НаборЗаписей = СоздатьНаборЗаписейРегистраСведений(СтруктураЗаписи, ИмяРегистра);
	Иначе 
		НаборЗаписей = СоздатьНаборЗаписейРегистраСведений(СтруктураОтбора, ИмяРегистра);
	КонецЕсли; 

	// Добавляем только одну запись в новый набор записей.
	НоваяЗапись = НаборЗаписей.Добавить();
	
	// Заполняем значения свойств записи из переданной структуры.
	ЗаполнитьЗначенияСвойств(НоваяЗапись, СтруктураЗаписи);
	
	НаборЗаписей.ОбменДанными.Загрузка = Загрузка;
	
	// записываем набор записей
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Создает набор записей регистра сведений по переданным значениям структуры. Добавляет одну запись в набор.
//
// Параметры:
//  СтруктураЗаписи - Структура - структура по значениям которой необходимо создать набор записей и заполнить этот
//                                набор.
//  ИмяРегистра     - Строка - имя регистра сведений.
// 
Функция СоздатьНаборЗаписейРегистраСведений(СтруктураЗаписи, ИмяРегистра) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
										  
	// Создаем набор записей регистра.
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	
	Если МетаданныеРегистра.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда		
		НаборЗаписей.Отбор["Период"].Установить(СтруктураЗаписи["Период"]);
	КонецЕсли; 
	
	// Устанавливаем отбор по измерениям регистра.
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		
		// Если задано значение в структуре, то отбор устанавливаем.
		Если СтруктураЗаписи.Свойство(Измерение.Имя) Тогда
			НаборЗаписей.Отбор[Измерение.Имя].Установить(СтруктураЗаписи[Измерение.Имя]);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НаборЗаписей;
	
КонецФункции

Процедура ЗаписатьНезаконченнуюРаботу(ВыборкаДанных,ШагПланирования)
	
	Если ВыборкаДанных.Период > ВыборкаДанных.КонецРабочегоДняДЦ Тогда
		ЗаписатьНачатуюНезавершеннуюРаботу(ВыборкаДанных);
	Иначе 
		
		ФактВремени = ВыборкаДанных.ФактВремени;
		
		ТипРабочегоДокумента = ТипЗнч(ВыборкаДанных.РабочийДокумент);
		
		Если ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
			
			Если ФактВремени/60 >= ВыборкаДанных.ДлительностьВыдачи + ВыборкаДанных.ЗавершатьВыдачуЧерез Тогда
				ЗаписатьНачатуюНезавершеннуюРаботу(ВыборкаДанных);
			КонецЕсли;                              
			
		ИначеЕсли ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") Тогда
			
			Если ФактВремени/60 >= ВыборкаДанных.ДлительностьПриемки + ВыборкаДанных.ЗавершатьПриемкуЧерез Тогда
				ЗаписатьНачатуюНезавершеннуюРаботу(ВыборкаДанных);
			КонецЕсли;
			
		КонецЕсли;	
		
		//нужно проверить, возможно из-за этого проблема в РЗ
		Если ВыборкаДанных.НеДвигатьПросроченныеРаботы 
			И ВыборкаДанных.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена Тогда
			
			Возврат;
			
		КонецЕсли;
		
		ЗаписатьОперативныйПланПоНезавершеннойРаботе(ВыборкаДанных,ФактВремени,ШагПланирования);			
		
	КонецЕсли; 
	
КонецПроцедуры   

Процедура ЗаписатьОперативныйПланПоНезавершеннойРаботе(ВыборкаДанных,ФактВремени,ШагПланирования)

	СтруктураЗаписиРегистра = Новый Структура("Период,ДилерскийЦентр,Обращение,РабочийДокумент,Цех,ЭтапРабот");	
	
	ЗаполнитьЗначенияСвойств(СтруктураЗаписиРегистра,ВыборкаДанных);
	
	СтруктураЗаписиРегистра.Вставить("ВремяНачала", ВыборкаДанных.Период);	
	
	ТекущийКонецРабочегоДня = ВыборкаДанных.КонецРабочегоДняДЦ; // конец текущего раб.дня
	
	ИнтервалМеждуРабочимиДнями = Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ВыборкаДанных.ДилерскийЦентр, (ВыборкаДанных.Период + 86400)) - ВыборкаДанных.КонецРабочегоДняДЦ; // Интервал между концом текущего и началом следующего раб.дня
	
	Длительность = ВыборкаДанных.Длительность*3600 - ФактВремени;
	
	СтруктураЗаписиРегистра.Вставить("ВремяОкончания", ВыборкаДанных.Период + Длительность);	
	
	ПерезаписатьВремяОкончания = Истина;
	
	Индекс = 1;
	
	Пока СтруктураЗаписиРегистра.ВремяОкончания > ТекущийКонецРабочегоДня Цикл
		
		ПерезаписатьВремяОкончания = Ложь;
		
		СтруктураЗаписиРегистра.ВремяОкончания = СтруктураЗаписиРегистра.ВремяОкончания + ИнтервалМеждуРабочимиДнями;
		
		ТекущийКонецРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ВыборкаДанных.ДилерскийЦентр, (ВыборкаДанных.Период + Индекс*86400)); // Конец следующего раб.дня
		
		ИнтервалМеждуРабочимиДнями = Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ВыборкаДанных.ДилерскийЦентр, (ВыборкаДанных.Период + (Индекс+1)*86400)) - ТекущийКонецРабочегоДня;
		
		Индекс = Индекс + 1;
		
	КонецЦикла; 
	
	Если ПерезаписатьВремяОкончания Тогда
		
		Если Длительность < 0 Тогда
			СтруктураЗаписиРегистра.ВремяОкончания = ВыборкаДанных.Период + ШагПланирования;
		Иначе
			СтруктураЗаписиРегистра.ВремяОкончания = ВыборкаДанных.Период + Длительность;
		КонецЕсли;
		
	КонецЕсли; 
	
	СтруктураЗаписиРегистра.Вставить("Длительность", Длительность/3600);
	
	ДобавитьЗаписьВРегистрСведений(СтруктураЗаписиРегистра,"Renault_АвтосервисПланОперативный");
	
КонецПроцедуры

Процедура ЗаписатьНачатуюНезавершеннуюРаботу(ВыборкаДанных)

	СтруктураЗаписиРегистра = Новый Структура("Период,ДилерскийЦентр,Обращение,РабочийДокумент,Цех,ЭтапРабот");	
	
	ЗаполнитьЗначенияСвойств(СтруктураЗаписиРегистра,ВыборкаДанных);
	
	СтруктураЗаписиРегистра.Вставить("ДатаВремяИзменения",ВыборкаДанных.Период);
	
	ТипРабочегоДокумента = ТипЗнч(ВыборкаДанных.РабочийДокумент);
	
	Если ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") Тогда
		
		СтруктураЗаписиРегистра.Вставить("СтатусРаботы",Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
		
		РабочийДокументОбъект = ВыборкаДанных.РабочийДокумент.ПолучитьОбъект();
		РабочийДокументОбъект.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен;
		
		Попытка
			
			Если РабочийДокументОбъект.Проведен Тогда
				РабочийДокументОбъект.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
			Иначе 
				РабочийДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли; 
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Запись документа: "+СокрЛП(ВыборкаДанных.РабочийДокумент),УровеньЖурналаРегистрации.Ошибка,,ВыборкаДанных.РабочийДокумент,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));;
			
			ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Возврат;
			
		КонецПопытки;
		
	ИначеЕсли ВыборкаДанных.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаНачата 
		И ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда 
		
		СтруктураЗаписиРегистра.Вставить("СтатусРаботы",Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
		
		РабочийДокументОбъект = ВыборкаДанных.РабочийДокумент.ПолучитьОбъект();
		РабочийДокументОбъект.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен;
		
		Попытка
			
			Если РабочийДокументОбъект.Проведен Тогда
				РабочийДокументОбъект.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
			Иначе 
				РабочийДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли; 
			
		Исключение
			
			ЗаписьЖурналаРегистрации("Запись документа: "+СокрЛП(ВыборкаДанных.РабочийДокумент),УровеньЖурналаРегистрации.Ошибка,,ВыборкаДанных.РабочийДокумент,ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));;
			
			ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Возврат;
			
		КонецПопытки;
		
	ИначеЕсли ТипРабочегоДокумента = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаПодменныйАвто") Тогда
		
		СтруктураЗаписиРегистра.Вставить("СтатусРаботы", ВыборкаДанных.СтатусРаботы);
		
	ИначеЕсли ЗначениеЗаполнено(ВыборкаДанных.ОбращениеРабочийДокумент) Тогда
		
		Если ВыборкаДанных.ИгнорироватьНезакрытуюВыдачу Тогда
			
			СтруктураЗаписиРегистра.Вставить("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
			
		Иначе 
			
			ВыдачаАвтомобиля = ПолучитьВыдачуАвтомобиляПоОбращению(ВыборкаДанных.ОбращениеРабочийДокумент);
			
			Если ЗначениеЗаполнено(ВыдачаАвтомобиля) Тогда
				СтруктураЗаписиРегистра.Вставить("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаЗакончена);
			Иначе 
				СтруктураЗаписиРегистра.Вставить("СтатусРаботы", Справочники.Renault_СтатусыАвторабот.РаботаПауза);
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если СтруктураЗаписиРегистра.Свойство("СтатусРаботы") Тогда
		ДобавитьЗаписьВРегистрСведений(СтруктураЗаписиРегистра,"Renault_АвтосервисСтатусыРабот");
	КонецЕсли; 
	
КонецПроцедуры

Функция ПолучитьВыдачуАвтомобиляПоОбращению(Обращение)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВыдачаАвтомобиля.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК ВыдачаАвтомобиля
		|ГДЕ
		|	ВыдачаАвтомобиля.Обращение = &Обращение
		|	И НЕ ВыдачаАвтомобиля.ПометкаУдаления
		|	И ВыдачаАвтомобиля.Состояние = ЗНАЧЕНИЕ(Справочник.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыдачаАвтомобиля = Документы.Renault_CRM_ВыдачаАвтомобиля.ПустаяСсылка();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ВыдачаАвтомобиля = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли; 
	
	Возврат ВыдачаАвтомобиля;
	
КонецФункции // ПолучитьВыдачуАвтомобиляПоОбращению()
 
Процедура ОбработатьСтатусы(ШагПланирования)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АвтосервисСтатусыРабот.Период КАК Период,
		|	АвтосервисСтатусыРабот.ДилерскийЦентр КАК ДилерскийЦентр,
		|	АвтосервисСтатусыРабот.Цех КАК Цех,
		|	АвтосервисСтатусыРабот.РабочийДокумент КАК РабочийДокумент,
		|	АвтосервисСтатусыРабот.ДатаВремяИзменения КАК ДатаВремяИзменения,
		|	АвтосервисСтатусыРабот.СтатусРаботы КАК СтатусРаботы,
		|	АвтосервисСтатусыРабот.Обращение КАК Обращение,
		|	АвтосервисСтатусыРабот.ЭтапРабот КАК ЭтапРабот,
		|	ЕСТЬNULL(АвтосервисФактОперативный.ВремяОкончания, ДАТАВРЕМЯ(1, 1, 1)) КАК ВремяОкончания,
		|	&Период КАК ТекущийПериод
		|ИЗ
		|	РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних(&Период, ) КАК АвтосервисСтатусыРабот
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисФактОперативный.СрезПоследних(&Период, ) КАК АвтосервисФактОперативный
		|		ПО (АвтосервисФактОперативный.РабочийДокумент = АвтосервисСтатусыРабот.РабочийДокумент)
		|			И (АвтосервисФактОперативный.ЭтапРабот = АвтосервисСтатусыРабот.ЭтапРабот)
		|			И (АвтосервисСтатусыРабот.Цех <> НЕОПРЕДЕЛЕНО)
		|			И (АвтосервисСтатусыРабот.Цех <> ЗНАЧЕНИЕ(Справочник.Renault_CRM_Мойки.пустаяСсылка))
		|			И (АвтосервисСтатусыРабот.Цех <> ЗНАЧЕНИЕ(Справочник.Renault_CRM_ПодменныеАвто.пустаяСсылка))
		|			И (АвтосервисСтатусыРабот.Цех <> ЗНАЧЕНИЕ(Справочник.Сотрудники.пустаяСсылка))
		|			И (АвтосервисСтатусыРабот.Цех <> ЗНАЧЕНИЕ(Справочник.Цеха.пустаяСсылка))
		|ГДЕ
		|	АвтосервисСтатусыРабот.СтатусРаботы = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыАвторабот.РаботаНачата)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДанных = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДанных.Следующий() Цикл
		ЗаписатьФактОперативный(ВыборкаДанных, ШагПланирования);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьФактОперативный(ВыборкаДанных,ШагПланирования)
	
	//Если Макс(ВыборкаДанных.ВремяОкончания, ВыборкаДанных.ТекущийПериод) - Мин(ВыборкаДанных.ВремяОкончания, ВыборкаДанных.ТекущийПериод) < ШагПланирования Тогда
		
		Набор = РегистрыСведений.Renault_АвтосервисФактОперативный.СоздатьНаборЗаписей();
		Набор.Отбор.Обращение.Установить(ВыборкаДанных.Обращение);
		Набор.Отбор.РабочийДокумент.Установить(ВыборкаДанных.РабочийДокумент);
		Набор.Отбор.Цех.Установить(ВыборкаДанных.Цех);
		Набор.Отбор.ЭтапРабот.Установить(ВыборкаДанных.ЭтапРабот);
		Набор.Прочитать();
		
		Если Набор.Количество()>0 Тогда
			Для Каждого Запись ИЗ Набор Цикл
				
				Если Запись.ВремяОкончания = ВыборкаДанных.ВремяОкончания Тогда
					Запись.Период = ВыборкаДанных.ТекущийПериод;
					Запись.ВремяОкончания = ВыборкаДанных.ТекущийПериод + ШагПланирования;
				КонецЕсли;
				
			КонецЦикла;
			
			Набор.Записать();
			
		Иначе
					
			Запись = РегистрыСведений.Renault_АвтосервисФактОперативный.СоздатьМенеджерЗаписи();
			Запись.ДилерскийЦентр 	= ВыборкаДанных.ДилерскийЦентр;
			Запись.РабочийДокумент 	= ВыборкаДанных.РабочийДокумент;
			Запись.Цех 				= ВыборкаДанных.Цех;
			Запись.ВремяНачала 		= ВыборкаДанных.ТекущийПериод;
			Запись.Период 			= ВыборкаДанных.ТекущийПериод;
			Запись.ВремяОкончания 	= ВыборкаДанных.ТекущийПериод + ШагПланирования;
			Запись.ЭтапРабот 		= ВыборкаДанных.ЭтапРабот;
			Запись.Обращение 		= ВыборкаДанных.Обращение;
			Запись.Записать();
			
		КонецЕсли;
	
КонецПроцедуры

