				КонецЕсли;
				query.WriteText("New"+Кол.Имя, 0);
			КонецЦикла;
			query.WriteText(") "+Символы.ПС, 0);
			ЭтоПервоеКлючПоле = Истина;
			Для Каждого сКлючевоеПоле из мКлючевоеПоле Цикл
				Если ЭтоПервоеКлючПоле Тогда
					ЭтоПервоеКлючПоле = ложь;
					query.WriteText("ON ", 0);
				Иначе
					query.WriteText("and ", );
				КонецЕсли;
				query.WriteText(" Target."+сКлючевоеПоле+" = Source.New"+сКлючевоеПоле+" "+Символы.ПС, 0);
