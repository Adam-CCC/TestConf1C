        ТаблицаДанных.Колонки.Добавить("ItemId",             Новый ОписаниеТипов("Строка"));
        ТаблицаДанных.Колонки.Добавить("QuantityAvailable",  Новый ОписаниеТипов("Строка"));
        ТаблицаДанных.Колонки.Добавить("SubstitutionItemId", Новый ОписаниеТипов("Строка"));
        ТаблицаДанных.Колонки.Добавить("UnitPrice",          Новый ОписаниеТипов("Строка"));
        ТаблицаДанных.Колонки.Добавить("DiscountCode",       Новый ОписаниеТипов("Строка"));

        Основной = Новый Запрос;
        Основной.Текст = "ВЫБРАТЬ
                         |  ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК QuantityAvailable,
                         |  ПОДСТРОКА(ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул, 1, 10) КАК ItemId,
                         |  ПОДСТРОКА(Renault_НастройкиОбменаССайтом.DMD, 1, 8) КАК BIR,
                         |  ЕСТЬNULL(Renault_ТарифЦен.Цена, 0) КАК UnitPrice,
                         |  ПОДСТРОКА(Renault_ЗаменыРеферансов.АртикулЗамены, 1, 10) КАК SubstitutionItemId,
                         |  ЕСТЬNULL(Renault_КаталогРеферансов.КодСкидки, """") КАК DiscountCode
                         |ПОМЕСТИТЬ ВТ_Остатки
                         |ИЗ
                         |  РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
                         |          ,
                         |          СкладКомпании В
                         |              (ВЫБРАТЬ РАЗЛИЧНЫЕ
                         |                  Renault_НастройкиОбменаССайтом.Склад
                         |              ИЗ
                         |                  РегистрСведений.Renault_НастройкиОбменаССайтом КАК Renault_НастройкиОбменаССайтом
                         |              ГДЕ
                         |                  Renault_НастройкиОбменаССайтом.ДилерскийЦентр = &ДилерскийЦентр)) КАК ОстаткиТоваровКомпанииОстатки
                         |      ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
                         |      ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = Renault_КаталогРеферансов.Номенклатура
                         |      ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_НастройкиОбменаССайтом КАК Renault_НастройкиОбменаССайтом
                         |      ПО ОстаткиТоваровКомпанииОстатки.СкладКомпании = Renault_НастройкиОбменаССайтом.Склад
                         |      ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ЗаменыРеферансов КАК Renault_ЗаменыРеферансов
                         |      ПО (&ТекущаяДата >= Renault_ЗаменыРеферансов.ДатаНачала
                         |              ИЛИ Renault_ЗаменыРеферансов.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
                         |          И (&ТекущаяДата <= Renault_ЗаменыРеферансов.ДатаЗавершения
                         |              ИЛИ Renault_ЗаменыРеферансов.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1))
                         |          И (Renault_ЗаменыРеферансов.АртикулЗамены В
                         |              (ВЫБРАТЬ ПЕРВЫЕ 1
                         |                  Таб.АртикулЗамены
                         |              ИЗ
                         |                  РегистрСведений.Renault_ЗаменыРеферансов КАК Таб
                         |              ГДЕ
                         |                  Таб.АртикулНоменклатуры = ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул))
                         |      ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ТарифЦен КАК Renault_ТарифЦен
                         |      ПО ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул = Renault_ТарифЦен.Артикул
                         |          И (Renault_ТарифЦен.ТипЦены = &ТипЦены)
