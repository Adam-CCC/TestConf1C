                         |  ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ОстаткиТоваровКомпанииОстатки.РезервОстаток > 0
                         |;
                         |
                         |////////////////////////////////////////////////////////////////////////////////
                         |ВЫБРАТЬ
                         |  ВТ_Остатки.BIR,
                         |  ВТ_Остатки.ItemId КАК ItemId,
                         |  СУММА(ВТ_Остатки.QuantityAvailable) КАК QuantityAvailable,
                         |  СРЕДНЕЕ(ВТ_Остатки.UnitPrice) КАК UnitPrice,
                         |  ВТ_Остатки.SubstitutionItemId КАК SubstitutionItemId,
                         |  ВТ_Остатки.DiscountCode КАК DiscountCode
                         |ИЗ
                         |  ВТ_Остатки КАК ВТ_Остатки
                         |
                         |СГРУППИРОВАТЬ ПО
                         |  ВТ_Остатки.BIR,
                         |  ВТ_Остатки.ItemId,
                         |  ВТ_Остатки.SubstitutionItemId,
                         |  ВТ_Остатки.DiscountCode";

        Основной.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр.Ссылка);
        Основной.УстановитьПараметр("ТипЦены",        Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.ТипЦенRParts);
        Основной.УстановитьПараметр("ТекущаяДата",    ТекущаяДата());
        Выборка = Основной.Выполнить().Выбрать();

        Пока Выборка.Следующий() Цикл

            СтрокаТЗ = ТаблицаДанных.Добавить();
            СтрокаТЗ.BIR                = Выборка.BIR;
            СтрокаТЗ.SubstitutionItemId = Выборка.SubstitutionItemId;
            СтрокаТЗ.ItemId             = Выборка.ItemId;
            СтрокаТЗ.QuantityAvailable  = Формат(Окр(Выборка.QuantityAvailable), "ЧРД=.; ЧН=0; ЧГ=0");
            СтрокаТЗ.UnitPrice          = Формат(Выборка.UnitPrice, "ЧРД=.; ЧН=0; ЧГ=0");
            СтрокаТЗ.DiscountCode       = Выборка.DiscountCode;

        КонецЦикла;

        мКлючевоеПоле = Новый Массив;
        мКлючевоеПоле.Добавить("BIR");   
        мКлючевоеПоле.Добавить("ItemId"); 
        ВыполнитьDeleteInsertВSQL(ТаблицаДанных, "dbo.A2A_DATA", Справочники.Renault_НастройкиПодключенияКSQL.ТаблицаА2А);

    КонецЦикла;


    // Выгрузка контрагентов /////////////////////////////////////////////////////
    ТаблицаДанных = Новый ТаблицаЗначений;
    ТаблицаДанных.Колонки.Добавить("ID",       Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("Discount", Новый ОписаниеТипов("Строка"));

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
    Запрос.Текст = "ВЫБРАТЬ
                   |    Renault_ОптовыеПокупателиЗапЧастей.Код КАК ID,
                   |    ЕСТЬNULL(Renault_СкидкиОптовыеПокупателиСрезПоследних.Процент, 0) КАК Discount
                   |ИЗ
                   |    Справочник.Renault_ОптовыеПокупателиЗапЧастей КАК Renault_ОптовыеПокупателиЗапЧастей
                   |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_СкидкиОптовыеПокупатели КАК Renault_СкидкиОптовыеПокупателиСрезПоследних
                   |        ПО Renault_ОптовыеПокупателиЗапЧастей.ГруппаКонтрагента = Renault_СкидкиОптовыеПокупателиСрезПоследних.ГруппаКонтрагента";

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
        Стр = ТаблицаДанных.Добавить();
        Стр.ID = Выборка.ID;
        Стр.Discount = Формат(Выборка.Discount, "ЧРД=.; ЧН=0; ЧГ=0");
    КонецЦикла;

    мКлючевоеПоле = Новый Массив;
    мКлючевоеПоле.Добавить("ID");

    ВыполнитьMergeВSQL(ТаблицаДанных, "dbo.A2A_CUSTOMERS", мКлючевоеПоле, Справочники.Renault_НастройкиПодключенияКSQL.ТаблицаА2А);


    // Выгрузка контрагентов /////////////////////////////////////////////////////
    ТаблицаДанных = Новый ТаблицаЗначений;
    ТаблицаДанных.Колонки.Добавить("Code",      Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("NDiscount", Новый ОписаниеТипов("Строка"));
    ТаблицаДанных.Колонки.Добавить("UDiscount", Новый ОписаниеТипов("Строка"));

    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
    Запрос.Текст = "ВЫБРАТЬ
                   |    Renault_СкидкиОптовыеРеферансы.КодСкидки КАК Code,
                   |    Renault_СкидкиОптовыеРеферансы.ПроцентСкладской КАК NDiscount,
                   |    Renault_СкидкиОптовыеРеферансы.ПроцентСрочный КАК UDiscount
                   |ИЗ
                   |    РегистрСведений.Renault_СкидкиОптовыеРеферансы КАК Renault_СкидкиОптовыеРеферансы";

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
        Стр = ТаблицаДанных.Добавить();
        Стр.Code = Выборка.Code;
        Стр.NDiscount = Формат(Выборка.NDiscount, "ЧРД=.; ЧН=0; ЧГ=0");
        Стр.UDiscount = Формат(Выборка.UDiscount, "ЧРД=.; ЧН=0; ЧГ=0");
    КонецЦикла;

    мКлючевоеПоле = Новый Массив;
    мКлючевоеПоле.Добавить("Code");

    ВыполнитьMergeВSQL(ТаблицаДанных, "dbo.A2A_DISCOUNTS", мКлючевоеПоле, Справочники.Renault_НастройкиПодключенияКSQL.ТаблицаА2А);

КонецПроцедуры

Функция ПолучитьСтрокуСоединения(Настройки) 

    СтрокаПодключения = "DRIVER="+Настройки.Драйвер +"; SERVER=" + Настройки.АдресСервера+"; DATABASE="+Настройки.БазаДанных+"; Uid="+Настройки.Логин+ "; Pwd="+ Настройки.Пароль+";";

    Возврат СтрокаПодключения; 

КонецФункции

Функция ВыполнитьMergeВSQL(ТаблицаДанных, ИмяТаблицы, мКлючевоеПоле, Параметры)
	Попытка
		Если ТаблицаДанных.Количество()>0 Тогда
			СтрокаПодключения  = ПолучитьСтрокуСоединения(Параметры);
			Ответ = Истина;
			Подключение = Новый COMОбъект("ADODB.Connection");
			query = Новый COMОбъект("ADODB.Stream");
						
			Попытка
				Подключение.open(СтрокаПодключения);
			Исключение
				Инфа = ИнформацияОбОшибке();
				ТекстСообщения = ""+ТекущаяДата()+" Connection error: "+ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("error merge to sql", УровеньЖурналаРегистрации.Ошибка, ,,ТекстСообщения);
