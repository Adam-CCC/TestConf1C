Функция ВыполнитьDeleteInsertВSQL(ТаблицаДанных, ИмяТаблицы, Параметры)
	
	Попытка
		Если ТаблицаДанных.Количество() > 0 Тогда
			
			СтрокаПодключения  = ПолучитьСтрокуСоединения(Параметры);
			Ответ = Истина;
			Подключение = Новый COMОбъект("ADODB.Connection");
			query       = Новый COMОбъект("ADODB.Stream");
						
			Попытка
				Подключение.open(СтрокаПодключения);
			Исключение
				Инфа = ИнформацияОбОшибке();
				ТекстСообщения = ""+ТекущаяДата()+" Connection error: "+ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("error insert to sql", УровеньЖурналаРегистрации.Ошибка, ,,ТекстСообщения);
				Ответ = Ложь;			
			КонецПопытки;
			
			query.Open();
			
			// Удаляем старые данные из таблицы
			query.WriteText("DELETE FROM " + Параметры.БазаДанных + "." + ИмяТаблицы + ";" + Символы.ПС, 0);
			
			ЭтоПерв = Истина;
			
			query.WriteText("INSERT INTO " + Параметры.БазаДанных + "." + ИмяТаблицы + "(", 0);
			
			// Заполняем колонки
			ЭтоПервКолонка = Истина;
			Для Каждого Кол Из ТаблицаДанных.Колонки Цикл
				Если ЭтоПервКолонка Тогда
					ЭтоПервКолонка = Ложь;
				Иначе
					query.WriteText(", ", 0);
				КонецЕсли;
				query.WriteText(Кол.Имя, 0);
			КонецЦикла;
			query.WriteText(") " + Символы.ПС, 0);
			
			query.WriteText("VALUES " + Символы.ПС, 0);
			
			// Заполняем значения
			
			Счетчик = 0;
			ЭтоПервДанные = Истина;
			Для Каждого Данные Из ТаблицаДанных Цикл
				Счетчик = Счетчик + 1;
				Если ЭтоПервДанные Тогда
					ЭтоПервДанные = Ложь;
				Иначе
					query.WriteText(", " + Символы.ПС, 0);
				КонецЕсли;
				query.WriteText("(", 0);
				ЭтоПервКолонка = истина;
				Для Каждого Кол Из ТаблицаДанных.Колонки Цикл
					Если ЭтоПервКолонка Тогда
						ЭтоПервКолонка = Ложь;
					Иначе
						query.WriteText(", ", 0);
					КонецЕсли;
					СтрокаВставки = Данные[Кол.Имя];
					Если ТипЗнч(СтрокаВставки) =  Тип("Строка") Тогда
						СтрокаВставки = ДанныеВЗапрос(СтрокаВставки,3);
					ИначеЕсли  ТипЗнч(СтрокаВставки) =  Тип("Число") Тогда
						СтрокаВставки = ДанныеВЗапрос(СтрЗаменить(СтрокаВставки,Символы.НПП,""),0);
					ИначеЕсли  ТипЗнч(СтрокаВставки) =  Тип("Дата") Тогда
						СтрокаВставки = ДанныеВЗапрос(СтрокаВставки,1);
					ИначеЕсли  ТипЗнч(СтрокаВставки) =  Тип("Булево") Тогда
						СтрокаВставки = ДанныеВЗапрос(СтрокаВставки,4);
                    Иначе
						СтрокаВставки = ДанныеВЗапрос(Строка(СтрокаВставки),2);
                    КонецЕсли;
                    					
					query.WriteText(СтрокаВставки, 0);		
								
				КонецЦикла;
				query.WriteText(")", 0);
				
				Если Счетчик = 999 Тогда // Лимит в тысячу
					
					query.WriteText(";" + Символы.ПС, 0);
					
					query.WriteText("INSERT INTO " + Параметры.БазаДанных + "." + ИмяТаблицы + "(", 0);
					
					// Заполняем колонки
					ЭтоПервКолонка = Истина;
					Для Каждого Кол Из ТаблицаДанных.Колонки Цикл
						Если ЭтоПервКолонка Тогда
							ЭтоПервКолонка = Ложь;
						Иначе
							query.WriteText(", ", 0);
						КонецЕсли;
						query.WriteText(Кол.Имя, 0);
					КонецЦикла;
					query.WriteText(") " + Символы.ПС, 0);
					
					query.WriteText("VALUES " + Символы.ПС, 0);
					
					Счетчик = 0;
					ЭтоПервДанные = Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Попытка
				query.Position = 0;
				Подключение.Execute(query.readText());
				Возврат Истина; 
			Исключение
				Инф = ИнформацияОбОшибке();
				ТекстСообщения = ""+ТекущаяДата()+" Connection error: "+ОписаниеОшибки()+ символы.ПС;
				ЗаписьЖурналаРегистрации("error insert to sql", УровеньЖурналаРегистрации.Ошибка, ,,ТекстСообщения);
				Возврат Ложь;
			КонецПопытки;
			Возврат Ложь;
		КонецЕсли;	
	Исключение
		Инф = ИнформацияОбОшибке();
		ТекстСообщения = ""+ТекущаяДата()+" Connection error: "+ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("error insert to sql", УровеньЖурналаРегистрации.Ошибка, ,,ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции


Функция ДанныеВЗапрос(ТекЗначение, ТипЗ = 0)
	Если ТипЗ = 1 тогда //Дата , либо нулл
		Если Год(ТекЗначение) = 1 Тогда
			Возврат "NULL";
		Иначе
			Возврат "'" + Формат(ТекЗначение, "ДФ=""гггг-ММ-дд ЧЧ:мм:сс.000""") + "'";
		КонецЕсли;
	ИначеЕсли ТипЗ = 2 Тогда //Строка Либо Нул вместо пустой
		Если СтрДлина(ТекЗначение) = 0 Тогда
			Возврат "NULL";
		Иначе
			Возврат "'" + ТекЗначение + "'"; 
		КонецЕсли;
	ИначеЕсли ТипЗ = 3 Тогда //Строка 
		Возврат "'" + ТекЗначение + "'"; 
	ИначеЕсли ТипЗ = 4 Тогда //Булево
		Если ТекЗначение = Истина Тогда
			Возврат "'" + "ИСТИНА" + "'";
		Иначе
			Возврат "'" + "ЛОЖЬ" + "'";
		КонецЕсли;
	Иначе
		Возврат ТекЗначение;
	КонецЕсли;
	
КонецФункции


Функция ПолучитьЛог() Экспорт

    Параметры = Справочники.Renault_НастройкиПодключенияКSQL.ТаблицаА2А;

    СтрокаПодключения  = ПолучитьСтрокуСоединения(Параметры);
    Ответ = Истина;
    Подключение = Новый COMОбъект("ADODB.Connection");

    Попытка
        Подключение.open(СтрокаПодключения);
    Исключение
        Инфа = ИнформацияОбОшибке();
        ТекстСообщения = "" + ТекущаяДата() + " Connection error: " + ОписаниеОшибки();
        ЗаписьЖурналаРегистрации("error insert to sql", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
        Ответ = Ложь;
    КонецПопытки;

    Кол = ?(ЗначениеЗаполнено(ЭтотОбъект.КоличествоЗаписей), ЭтотОбъект.КоличествоЗаписей, 10);

    Результат = Подключение.Execute("SELECT TOP " + Формат(Кол, "ЧГ=") + " * FROM A2A_SERVICE_LOG ORDER BY [CURRENT_DATE] DESC");

    ТекДок = Новый ТекстовыйДокумент;

    Пока Результат.EOF() = 0 Цикл
        ТекДок.ДобавитьСтроку(""   + Результат.Fields.Item(0).Value +
                              ", " + Результат.Fields.Item(1).Value +
                              ", " + Результат.Fields.Item(2).Value +
                              ", " + Результат.Fields.Item(3).Value +
                              ", " + Результат.Fields.Item(4).Value +
                              ", " + Результат.Fields.Item(5).Value);
        Результат.MoveNext();
    КонецЦикла;

    ТекДок.Показать();

КонецФункции

