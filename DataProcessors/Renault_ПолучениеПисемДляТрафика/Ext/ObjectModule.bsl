

// Возвращает исправленную строку
Функция ИсправитьСтроку(ИсходнаяСтрока)
    Если ИсходнаяСтрока = "" Тогда
        Возврат "";
	КонецЕсли;
	Результат = ИсходнаяСтрока;
    Пока Истина Цикл
        Позиция = НайтиНедопустимыеСимволыXML(Результат);        
        Если Позиция = 0 Тогда
            Прервать;
        КонецЕсли;
        Результат = Сред(Результат,1, Позиция-1)+Сред(Результат, Позиция+1); 
    КонецЦикла;
    
    Результат = СтрЗаменить(Результат, Символ(13) + Символ(10), Символы.ПС);
    Результат = СтрЗаменить(Результат, Символ(182), Символы.ПС);
    Возврат Результат;
КонецФункции

Функция ПолучитьПочтуИзСтроки(Клиент)
	Позиция1 = Найти(Клиент,"<");
	Позиция2 = Найти(Клиент,">");
	ИскомаяПочта = Сред(Клиент, Позиция1+1, Позиция2-Позиция1-1);
    Возврат ?(Найти(ИскомаяПочта,"@")>0, ИскомаяПочта, 0);
КонецФункции

// Заполнение таблицы письмами почтового клиента
Функция ЗаполнениеТаблицаОбработки(Таблица) Экспорт
	Таблица.Очистить();
	LastLoadDate = ?(Константы.Renault_Mail4Traffic_LastReadDate.Получить()=Дата("00010101"), Дата("20010101"),Константы.Renault_Mail4Traffic_LastReadDate.Получить());
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронноеПисьмо.ИдентификаторПисьма,
	               |	ЭлектронноеПисьмо.УчетнаяЗапись КАК УчетнаяЗапись,
	               |	ЭлектронноеПисьмо.УчетнаяЗапись.Renault_ДилерскийЦентр КАК ДилерскийЦентр,
	               |	ЭлектронноеПисьмо.УчетнаяЗапись.Renault_ИсточникИнформации КАК ИсточникИнформации,
	               |	ЭлектронноеПисьмо.Тема КАК ТемаПисьма,
	               |	ЭлектронноеПисьмо.ТекстПисьма,
	               |	ЭлектронноеПисьмо.ДатаПолучения,
	               |	ЭлектронноеПисьмо.ОтправительПредставление КАК Отправитель
	               |ИЗ
	               |	Документ.ЭлектронноеПисьмо КАК ЭлектронноеПисьмо
				   |ГДЕ
				   |	ЭлектронноеПисьмо.УчетнаяЗапись.Renault_НеИспользоватьТрафик = ЛОЖЬ
				   |	И ЭлектронноеПисьмо.ПометкаУдаления = ЛОЖЬ
				   |	И ЭлектронноеПисьмо.ДатаПолучения > &ДатаЧтения
				   |	И ЭлектронноеПисьмо.СтатусПисьма = ЗНАЧЕНИЕ(Перечисление.СтатусыСообщений.Входящее)";
	Запрос.УстановитьПараметр("ДатаЧтения",LastLoadDate);			   
	ТаблицаПисем = Запрос.Выполнить().Выгрузить();
	Для Каждого Письмо из ТаблицаПисем Цикл 
			ТекСтрока = Таблица.Добавить();
			ТекСтрока.УчетнаяЗапись = Письмо.УчетнаяЗапись;
			ТекСтрока.ИДПисьма = Письмо.ИдентификаторПисьма;
			ТекСтрока.ТемаПисьма = Письмо.ТемаПисьма;
			ТекСтрока.ТекстПисьма = ИсправитьСтроку(Письмо.ТекстПисьма);		
			ТекСтрока.ДилерскийЦентр = Письмо.ДилерскийЦентр;
			ТекСтрока.ИсточникИнформации = Письмо.ИсточникИнформации;
			ТекСтрока.ДатаПоступления = Письмо.ДатаПолучения;
			Если ТипЗнч(Письмо.Отправитель) = Тип("Строка") Тогда
				ТекСтрока.Отправитель = Сред(Письмо.Отправитель, Найти(Письмо.Отправитель, ":")+1);
				ТекСтрока.ПочтаКлиента = ПолучитьПочтуИзСтроки(Письмо.Отправитель);
			Иначе
				ТекСтрока.Отправитель = Сред(Письмо.Отправитель.Адрес, Найти(Письмо.Отправитель.Адрес, ":")+1);
				ТекСтрока.ПочтаКлиента = Письмо.Отправитель.Адрес;
			КонецЕсли;
	КонецЦикла;	
	Возврат Истина;
КонецФункции

Функция НайтиСоздатьКлиента(Наименование, емэйл, телефон="")
	СоздаватьКлиента = Истина;
	Если ЗначениеЗаполнено(емэйл) Тогда

		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	КонтактнаяИнформация.Объект
		                      |ИЗ
		                      |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		                      |ГДЕ
		                      |	КонтактнаяИнформация.Представление ПОДОБНО &Представление
		                      |	И КонтактнаяИнформация.Тип = &Тип
		                      |	И КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА");
			
		Запрос.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		Запрос.УстановитьПараметр("Представление",емэйл);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СоздаватьКлиента = Ложь;
			Возврат Выборка.Объект;
		КонецЕсли;
	КонецЕсли;
	Если СоздаватьКлиента и ЗначениеЗаполнено(Телефон) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	КонтактнаяИнформация.Объект
		                      |ИЗ
		                      |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		                      |ГДЕ
		                      |	КонтактнаяИнформация.Представление ПОДОБНО &Представление
		                      |	И КонтактнаяИнформация.Тип = &Тип
		                      |	И КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА");
			
		Запрос.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.Телефон);
		Запрос.УстановитьПараметр("Представление",Телефон);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СоздаватьКлиента = Ложь;
			Возврат Выборка.Объект;
		КонецЕсли;

	КонецЕсли;

	Если СоздаватьКлиента Тогда
		Нов = Справочники.CRM_ПотенциальныеКонтрагенты.СоздатьЭлемент();
		Нов.Наименование = Наименование;
		Нов.НаименованиеПолное = Наименование;
		Нов.СогласиеНаОбработкуПерсональныхДанных = перечисления.ВариантыОтветов.Да;
		Нов.ВидОтношений = Справочники.ВидыВзаимоотношений.КонтактноеЛицо;
		Нов.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
		Нов.Записать();
		Если  ЗначениеЗаполнено(емэйл) Тогда
			Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойEmailКлиента(емэйл,Нов.Ссылка);
		КонецЕсли;
		Если ЗначениеЗаполнено(телефон) Тогда
			Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойТелефонКлиента(телефон,нов.Ссылка);
		КонецЕсли;
		Возврат Нов.Ссылка;
	КонецЕсли; 
КонецФункции

Функция ТрафикПисьмаСуществует(Ид)
	Запрос = Новый запрос("ВЫБРАТЬ
	                      |	Renault_ТрафикПисьма.ИдентификаторПисьма
	                      |ИЗ
	                      |	РегистрСведений.Renault_ТрафикПисьма КАК Renault_ТрафикПисьма
	                      |ГДЕ
	                      |	Renault_ТрафикПисьма.ИдентификаторПисьма = &ид");
	Запрос.УстановитьПараметр("ид",Ид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

// Сохранение указанных писем
Процедура ОбработкаИмпортВыполнить(Таблица) Экспорт
	Для Каждого ТекСтрока Из Таблица Цикл
		Если НЕ ТекСтрока.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если Не ТрафикПисьмаСуществует(ТекСтрока.ИДПисьма) Тогда
			Трафик = СоздатьТрафикПисьма(ТекСтрока);
			Мен = РегистрыСведений.Renault_ТрафикПисьма.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Мен,ТекСтрока); 
			Мен.ИдТрафика = Трафик.Идентификатор;
			Мен.ИдентификаторПисьма = ТекСтрока.ИДПисьма;
			Мен.ТрафикПросмотрен = Ложь;
			Попытка
				Мен.Записать();
			Исключение
			КонецПопытки;			
		КонецЕсли;      	
	КонецЦикла;
	Константы.Renault_Mail4Traffic_LastReadDate.Установить(ТекущаяДата());
КонецПроцедуры

Функция СоздатьТрафикПисьма(Письмо)
	ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
	//ЗаполнитьЗначенияСвойств(ЗаписьТрафик,Описание);
	ЗаписьТрафик.ДилерскийЦентр = Письмо.ДилерскийЦентр;
	Идентификатор = Новый УникальныйИдентификатор();
	ЗаписьТрафик.Идентификатор = Идентификатор; 
	Если обЗначениеНеЗаполнено(Письмо.ДатаПоступления) Тогда ЗаписьТрафик.Период = ТекущаяДата();
	Иначе ЗаписьТрафик.Период = Письмо.ДатаПоступления;
	КонецЕсли;
	ЗаписьТрафик.ТипТрафика = Справочники.CRM_ТипТрафика.Email;
	ЗаписьТрафик.ИсточникИнформации = Письмо.ИсточникИнформации;
	ЗаписьТрафик.Клиент = НайтиСоздатьКлиента(Письмо.Отправитель,);                              
//	ЗаписьТрафик.Комментарий = "Тип лида"""+Описание.TYPE_LEAD +""", категория лида """+ Описание.SOUS_TYPE_LEAD +Символы.ПС+ """,Сообщение клиента - """+Описание.INT_COMMENTAIRE+""""+Символы.ПС;
//	ЗаписьТрафик.ПервичныйИнтерес = НайтиСоздатьПервичныйИнтерес(Описание.VEH_MDL,Описание.VEH_VIN);
	ЗаписьТрафик.Обработан = Ложь;
	ЗаписьТрафик.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный;
	ЗаписьТрафик.Записать();
	
	Возврат ЗаписьТрафик;
КонецФункции;
