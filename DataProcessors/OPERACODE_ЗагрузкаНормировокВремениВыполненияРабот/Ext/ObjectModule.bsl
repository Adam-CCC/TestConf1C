СоответствиеМесяцев.Вставить("JANV",1);
СоответствиеМесяцев.Вставить("FEVR",2);
СоответствиеМесяцев.Вставить("MARS",3);
СоответствиеМесяцев.Вставить("AVRI",4);
СоответствиеМесяцев.Вставить("MAI ",5);
СоответствиеМесяцев.Вставить("JUIN",6);
СоответствиеМесяцев.Вставить("JUIL",7);
СоответствиеМесяцев.Вставить("AOUT",8);
СоответствиеМесяцев.Вставить("SEPT",9);
СоответствиеМесяцев.Вставить("OCTO",10);
СоответствиеМесяцев.Вставить("NOVE",11);
