&НаКлиенте
Процедура ВидКалендаря(Команда)
	Если Команда.Имя="День" Тогда Календарь.ВидКалендаря=1 //день
	ИначеЕсли Команда.Имя="Неделя" Тогда Календарь.ВидКалендаря=2 //неделя
	ИначеЕсли Команда.Имя="Месяц" Тогда Календарь.ВидКалендаря=3 //месяц
	//Иначе Календарь.ВидКалендаря=4 // повестка дня
	КонецЕсли;
	ДоступностьЭлементов();
	УстановитьПериод();
	ОбновитьКалендарь();
КонецПроцедуры
Функция ДоступностьЭлементов()
	ЦветНеАктивно=Новый Цвет(231,231,231);
	//ЦветАктивно=Новый Цвет(255,207,0);
	ЦветАктивно=Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ОсновнойЦвет);
	//ЦветРамки=Новый Цвет(156,166,178);
	
	//Элементы.кнТолькоСвои.ЦветФона=?(Календарь.Сотрудник.Пустая(),ЦветНеАктивно,ЦветАктивно);
	//Элементы.кнТолькоСвои.ЦветРамки=?(Календарь.Сотрудник.Пустая(),ЦветРамки,ЦветАктивно);
	
	Элементы.кнДень.ЦветФона=ЦветНеАктивно;
	Элементы.кнНеделя.ЦветФона=ЦветНеАктивно;
	Элементы.кнМесяц.ЦветФона=ЦветНеАктивно;
	Элементы.кнДень.ЦветРамки=ЦветНеАктивно; //ЦветРамки;
	Элементы.кнНеделя.ЦветРамки=ЦветНеАктивно; //ЦветРамки;
	Элементы.кнМесяц.ЦветРамки=ЦветНеАктивно; //ЦветРамки;
	
	Если Календарь.ВидКалендаря=1 Тогда
		Элементы.кнДень.ЦветФона=ЦветАктивно;
		Элементы.кнДень.ЦветРамки=ЦветАктивно;
	ИначеЕсли Календарь.ВидКалендаря=2 Тогда
		Элементы.кнНеделя.ЦветФона=ЦветАктивно;
		Элементы.кнНеделя.ЦветРамки=ЦветАктивно;
	ИначеЕсли Календарь.ВидКалендаря=3 Тогда
		Элементы.кнМесяц.ЦветФона=ЦветАктивно;
		Элементы.кнМесяц.ЦветРамки=ЦветАктивно;
	//ИначеЕсли Календарь.ВидКалендаря=4 Тогда
	//	Элементы.ПовесткаДня.Доступность=Ложь;
	КонецЕсли;
КонецФункции	

&НаКлиенте
Процедура кнВыбратьПериод(Команда) ОткрытьФорму("Обработка.Renault_КалендарьСобытий.Форма.ВыборДаты",Новый Структура("Дата",Календарь.ДатаКалендаря),ЭтаФорма) КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКалендарь(Команда=Ложь) Экспорт ОбновитьHTML() КонецПроцедуры
Процедура ОбновитьHTML() КалендарьHTML=РеквизитФормыВЗначение("Календарь").ПолучитьHTML() КонецПроцедуры

Процедура УстановитьПериод()
	Обработки.Renault_КалендарьСобытий.УстановитьПериод(Календарь);
	Обработки.Renault_КалендарьСобытий.УстановитьИнтервалРабочегоВремени(Календарь);
	//ЗаголовокСтраницы();
КонецПроцедуры	

&НаКлиенте
Процедура ИнтервалСлотаПриИзменении(Элемент) 
	Соответствие=Новый Соответствие;
	Соответствие.Вставить(1,5);
	Соответствие.Вставить(2,10);
	Соответствие.Вставить(3,15);
	Соответствие.Вставить(4,20);
	Соответствие.Вставить(5,30);
	Соответствие.Вставить(6,60);
	Календарь.ИнтервалСлота=Соответствие.Получить(Интервал);
	ЗаголовокИнтервала();
	ОбновитьHTML();
КонецПроцедуры
Процедура ЗаголовокИнтервала() Элементы.Интервал.Заголовок="Интервал "+Календарь.ИнтервалСлота+" мин." КонецПроцедуры

&НаКлиенте
Процедура спСобытияПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка) Обработки.Renault_КалендарьСобытий.ОбработкаСобытия(Элемент.Документ,ЭтаФорма) КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) 
	Если ИмяСобытия="ОбновитьСобытия" Тогда ОбновитьКалендарь() 
	ИначеЕсли ИмяСобытия="ОбновитьСписок" Тогда 
		ИмяСписка=ИмяСписка();
		Если Элементы.Найти(ИмяСписка)<>Неопределено Тогда Элементы[ИмяСписка].Обновить() КонецЕсли;
	КонецЕсли 
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоВидуСобытийКалендаря(Варианты,Парам1) Экспорт
	Если Варианты<>Неопределено Тогда
		Календарь.ВидыСобытий.ЗагрузитьЗначения(Варианты);
		Календарь.Сотрудник=?(Варианты.Найти("ТолькоСвои")=Неопределено,"",Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник);
		ОбновитьКалендарь();
	КонецЕсли;	
КонецПроцедуры
//#КонецОбласти

//#Область Функции
Функция ДобавитьТрафик(ID)
	Если ID=Неопределено Тогда Возврат null КонецЕсли;
	
	ЗаписьТрафик=Renault_CRM.ПолучитьЗаписьТрафикаПоID(ID);
	//Переведем в первичный, зачем не известно...
	Если ЗаписьТрафик.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный Тогда 
		ЗаписьТрафик.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный;
	КонецЕсли;
	ЗаписьТрафик.Менеджер=Renault_ОбщиеФункцииСервер.ТекущийПользователь();
	ЗаписьТрафик.Записать();
	
	Запись=Renault_CRM.СоздатьРабочийЛистПоТрафику(ID, Renault_ОбщиеФункцииСервер.ТекущийПользователь());
	ЗаписьЗадача = Renault_CRM.ПолучитьЗаписьЗадачиПоIDТрафика(ID);
	//Если есть задача по трафику - закроем ее
	Если ЗаписьЗадача <> Неопределено Тогда
		ЗаписьЗадача.Обработано = Истина;
		ЗаписьЗадача.ДатаВремяЗавершения = ТекущаяДата();
		ЗаписьЗадача.КомментарийПриЗакрытии = "Создан рабочий лист №"+Формат(Запись.IDK,"ЧГ=0");
		ЗаписьЗадача.Записать();
	КонецЕсли;
	
	Ключ=Новый Структура("ID,IDK,Отдел,Подразделение,ДилерскийЦентр");
	ЗаполнитьЗначенияСвойств(Ключ,Запись);
	Возврат Ключ
КонецФункции	

//пока не понятно зачем обновлять список, это дурное наследство
Процедура ОбновитьПослеПоискаКилента(ДанныеПоКлиенту, ДополнительныеПараметры) Экспорт Если ДанныеПоКлиенту<>Неопределено Тогда Элементы[ИмяСписка()].Обновить() КонецЕсли КонецПроцедуры

&НаКлиенте
Процедура кнЗанятость(Команда) 
	Причина=""; 
	Если МенеджерЗанят() Тогда УстановитьЗанятость(Ложь) 
	ИначеЕсли ВвестиСтроку(Причина,"Причина занятости") Тогда УстановитьЗанятость(Истина,Причина)
	Иначе Возврат
	КонецЕсли;
	УправлениеМеню();
КонецПроцедуры
Функция МенеджерЗанят() 
	Рег=РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СрезПоследних(,Новый Структура("Сотрудник",Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник));
	Возврат ?(Рег.Количество()=0,Ложь,?(Рег[0].Статус=Перечисления.CRM_ЗанятостьСотрудника.Занят,Истина,Ложь))
КонецФункции	
Процедура УстановитьЗанятость(Занят,ПричинаЗанятости="")
	Запись=РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СоздатьМенеджерЗаписи();
	Запись.Период=ТекущаяДата();
	Запись.Сотрудник=Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник;
	Запись.Статус=?(Занят,Перечисления.CRM_ЗанятостьСотрудника.Занят,Перечисления.CRM_ЗанятостьСотрудника.Свободен);
	Запись.ПричинаЗанятости=ПричинаЗанятости;
	Запись.Записать();
КонецПроцедуры	
