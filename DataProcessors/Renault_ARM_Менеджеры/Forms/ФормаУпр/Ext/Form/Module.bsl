Процедура УстановитьПараметрыСписков()
	
	Сп=Новый Массив;
	Сп.Добавить(спСобытия);
	Сп.Добавить(спТрафик);
	Сп.Добавить(спРабочиеЛисты);
	//Сп.Добавить(спЗапросыНаЗакрытие);
	
	//период
	Для Каждого Список Из Сп Цикл
		Эл=Список.Параметры.Элементы.Найти("Дата1");
		Эл.Значение=?(Дата1='00010101','20000101',Дата1);
		Эл.Использование=Истина;
		
		Эл=Список.Параметры.Элементы.Найти("Дата2");
		Эл.Значение=?(Дата2='00010101',КонецГода(ТекущаяДата()),КонецДня(Дата2));
		Эл.Использование=Истина;
	КонецЦикла;	
	
	Эл=спСобытия.Параметры.Элементы.Найти("ТекДата"); Эл.Значение=ТекущаяДата(); Эл.Использование=Истина;
	Эл=спТрафик.Параметры.Элементы.Найти("Менеджер"); Эл.Значение=Renault_ОбщиеФункцииСервер.ТекущийПользователь(); Эл.Использование=Истина;
	Эл=спТрафик.Параметры.Элементы.Найти("РежимОтбора"); Эл.Использование=Истина; Эл.Значение=ТекущийРежимТрафика;
	Эл=спРабочиеЛисты.Параметры.Элементы.Найти("ТекПользователь"); Эл.Использование=Истина; Эл.Значение=Renault_ОбщиеФункцииСервер.ТекущийПользователь();
	
КонецПроцедуры	

