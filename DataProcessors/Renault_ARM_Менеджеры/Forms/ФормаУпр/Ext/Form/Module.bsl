&НаКлиенте
Процедура НажатиеКнМеню(Элемент) 
	Для Н=0 По ПунктыМеню.Количество()-1 Цикл
		Если Найти(ТекущийЭлемент.Имя,ПунктыМеню[Н].Значение)>0 Тогда ТекущаяЗакладкаМеню=Н; Прервать КонецЕсли;	
	КонецЦикла;
	УправлениеМеню();
КонецПроцедуры
&НаКлиенте
Процедура УправлениеМеню()
	//скрыть или показать пункты меню в зависимости от набора прав
	Для Каждого Эл Из Элементы.кнМеню.ПодчиненныеЭлементы Цикл Эл.Видимость=ПунктыМеню.НайтиПоЗначению(Сред(Эл.Имя,3))<>Неопределено КонецЦикла;	
	
	//скрыть показать списки
	Для Н=0 По ПунктыМеню.Количество()-1 Цикл 
		Эл=Элементы.Найти("сп"+ПунктыМеню[Н]);
		Если Эл=Неопределено Тогда Продолжить КонецЕсли;
		Эл.Видимость=Н=ТекущаяЗакладкаМеню;
	КонецЦикла;	
	
	//цвета кнопок меню
	ПарамОфр=Renault_ОбщиеФункции.МультибрендПараметрыОформления();
	//Вкл=Новый Цвет(255,207,0);
	Вкл=Вычислить(ПарамОфр.ОсновнойЦвет);
	//Выкл=Вычислить(ПарамОфр.ДопЦвет1);
	//ВыклСерый=Вычислить(ПарамОфр.ДопЦвет1);
	Выкл=Новый Цвет(189,195,206);
	ВыклСерый=Новый Цвет(231,231,231);
	
	Для Н=1 По Элементы.кнМеню.ПодчиненныеЭлементы.Количество() Цикл
		Эл=Элементы.кнМеню.ПодчиненныеЭлементы[Н-1];
		Если НЕ Эл.Видимость Тогда Продолжить КонецЕсли;
		ЭтоТекущаяЗакладка=Сред(Эл.Имя,3)=ПунктыМеню[ТекущаяЗакладкаМеню].Значение;
		Эл.ЦветФона=?(ЭтоТекущаяЗакладка,Вкл,Выкл);  //?(Н=ТекущаяЗакладкаМеню,Вкл,Выкл);
		Эл.ЦветРамки=?(ЭтоТекущаяЗакладка,Вкл,Выкл);
	КонецЦикла;
	
	//Элементы.кнПоискКлиента.Видимость=Истина;
	ИмяЗакладки=ИмяЗакладки();
	Если ИмяЗакладки="События" Тогда
		Элементы.кнСпТрафик.Видимость=Ложь;
		Элементы.кнДобавить.Видимость=Истина;
		Элементы.кнКалендаря.Видимость=Ложь;
	ИначеЕсли ИмяЗакладки="Календарь" Тогда
		Если КалендарьHTML="" Тогда ОбновитьКалендарь() КонецЕсли; //загрузка графика (HTML) при первом включении
		Элементы.кнСпТрафик.Видимость=Ложь;
		Элементы.кнДобавить.Видимость=Ложь;
		Элементы.кнКалендаря.Видимость=Истина;
	ИначеЕсли ИмяЗакладки="Трафик" Тогда
		Элементы.кнСпТрафик.Видимость=Истина;
		Элементы.кнДобавить.Видимость=Истина;
		Элементы.кнКалендаря.Видимость=Ложь;
	ИначеЕсли ИмяЗакладки="РабочиеЛисты" Тогда
		Элементы.кнСпТрафик.Видимость=Ложь;
		Элементы.кнДобавить.Видимость=Истина;
		Элементы.кнКалендаря.Видимость=Ложь;
	ИначеЕсли ИмяЗакладки="ЗаявкиНаПодбор" Тогда
		Элементы.кнСпТрафик.Видимость=Ложь;
		Элементы.кнДобавить.Видимость=Ложь;
		Элементы.кнКалендаря.Видимость=Ложь;
	//Иначе
	//	Элементы.кнСпТрафик.Видимость=Ложь;
	//	Элементы.кнДобавить.Видимость=Ложь;
	КонецЕсли;
	
	//кнопки трафика
	Для Каждого Эл Из Элементы.кнСпТрафик.ПодчиненныеЭлементы Цикл
		Эл.ЦветРамки=?(Эл.Имя=ТекущийРежимТрафика,Вкл,ВыклСерый);
		Эл.ЦветФона=?(Эл.Имя=ТекущийРежимТрафика,Вкл,ВыклСерый);
	КонецЦикла;
	
	//кн.Занятость
	Занят=МенеджерЗанят();
	Элементы.кнЗанятость.ЦветРамки=?(Занят,Вкл,ВыклСерый);
	Элементы.кнЗанятость.ЦветФона=?(Занят,Вкл,ВыклСерый);
	Элементы.кнЗанятость.Картинка=?(Занят,БиблиотекаКартинок.Renault_Confirm_Square,БиблиотекаКартинок.Renault_Square_NEw);
	Элементы.кнЗанятость.Заголовок=?(Занят,"Менеджер занят","Менеджер свободен");
	
КонецПроцедуры	

&НаКлиенте
Процедура НажатиеКнМенюСписка(Элемент)
	ИмяПунктаМеню=ИмяЗакладки();
	ИмяСписка=ИмяСписка();
	
	Если ТекущийЭлемент.Имя="кнОбновить" Тогда //это действие по умолчанию всегда
	ИначеЕсли ТекущийЭлемент.Имя="кнОтбор" Тогда
		
	//	Если ИмяПунктаМеню="Отчеты" Тогда
	//		Renault_ОбщиеФункции.ОткрытьКомпоновщикНастроек(ЭтаФорма,КомпоновщикНастроекОтчета,"ОтборОтчета")
	//	Иначе //динамические списки
	//		
	//		Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
	//			Сообщить("Функционал не доступен",СтатусСообщения.Информация);
	//			Возврат
	//		КонецЕсли;	

	    Если ИмяПунктаМеню="Календарь" Тогда 
			
			МассивТекСобытий=Календарь.ВидыСобытий.ВыгрузитьЗначения();
			Массив=Новый Массив;
			Массив.Добавить(Перечисления.Renault_ОбластиПрименения.Общие);
			Массив.Добавить(Перечисления.Renault_ОбластиПрименения.ОФУ);
			МассивРазрешенных=Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластямПрименения(Массив,"Просмотр");
			
			ВариантыОтбора=Справочники.CRM_ВидыСобытий.СписокВидовСобытий(МассивРазрешенных,МассивТекСобытий);
			ВариантыОтбора.СортироватьПоПредставлению();
			ВариантыОтбора.Вставить(0,"ТолькоСвои","Только свои",НЕ Календарь.Сотрудник.Пустая(),БиблиотекаКартинок.Renault_Client_New);
			
			Парам=Новый Структура;
			Парам.Вставить("Список",ВариантыОтбора);
			Парам.Вставить("Заголовок","Отбор по видам событий");
			Парам.Вставить("МножественныйВыбор",Истина);
			//Парам.Вставить("КоличествоЭлементовВСтроке",4);
			Парам.Вставить("ШиринаЭлемента",17);
			Парам.Вставить("ВысотаЭлемента",2);
			Оповещение=Новый ОписаниеОповещения("ОтборПоВидуСобытийКалендаря",ЭтаФорма);
			ОткрытьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
			
		Иначе
			Источник=?(ИмяПунктаМеню="Трафик",ПолучитьИсточникНаСервере(ИмяСписка),ПолучитьПроизвольныйИсточникНаСервере(ИмяСписка));
			Renault_ОбщиеФункции.ОткрытьФормуОтбора(ЭтаФорма,Источник,ЭтаФорма[ИмяСписка].КомпоновщикНастроек,"ОтборСписка",ИмяСписка,,Истина)
		КонецЕсли;	
		
	ИначеЕсли ТекущийЭлемент.Имя="кнПериод" Тогда	
		
		Если ИмяПунктаМеню="Календарь" Тогда кнВыбратьПериод(Элемент)
		Иначе
			Оповещение=Новый ОписаниеОповещения("ЗадатьПериод",ЭтаФорма,ИмяСписка);
			Стр=ОткрытьФорму("ОбщаяФорма.Renault_ВыборПериода",Новый Структура("Дата1,Дата2",Дата1,Дата2),ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
		КонецЕсли	
		
	ИначеЕсли ТекущийЭлемент.Имя="кнДобавить" Тогда
		
		Оповещение=Новый ОписаниеОповещения("ОбновитьСписокАсинхронно",ЭтаФорма,ИмяСписка);
		
		Если ИмяПунктаМеню="События" Тогда 
			Массив=Новый Массив;
			Массив.Добавить(Перечисления.Renault_ОбластиПрименения.Продажи);
			Массив.Добавить(Перечисления.Renault_ОбластиПрименения.Сервис);
			Массив.Добавить(Перечисления.Renault_ОбластиПрименения.Общие);
			Парам=Новый Структура("ОбластиПрименения",Массив);
			ОткрытьФорму("Задача.Renault_События.ФормаОбъекта",Парам,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
		ИначеЕсли ИмяПунктаМеню="Трафик" Тогда
			Если Элементы[ИмяСписка].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
			СтруктураКлючРЛ=ДобавитьТрафик(Элементы[ИмяСписка].ТекущаяСтрока.Идентификатор);
			
			//не ясно сможет ли второй вариант работать на тонком клиенте, но 1й точно не работает
			//Ключ=РегистрыСведений.Renault_РабочиеЛисты.СоздатьКлючЗаписи(СтруктураКлючРЛ);
			Массив=Новый Массив;
			Массив.Добавить(СтруктураКлючРЛ);
			Ключ=Новый("РегистрСведенийКлючЗаписи.Renault_РабочиеЛисты",Массив);
			
			ОткрытьФорму("РегистрСведений.Renault_РабочиеЛисты.Форма.ФормаЗаписиУПР",Новый Структура("Ключ",Ключ),ЭтаФорма,УникальныйИдентификатор);
			Элементы.спТрафик.Обновить();

		ИначеЕсли ИмяПунктаМеню="РабочиеЛисты" Тогда ОткрытьФорму("РегистрСведений.Renault_РабочиеЛисты.Форма.ФормаЗаписиУПР",,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
		Иначе Сообщить("Действие кнопки еще не настроено")
			//ИмяОбъекта=ЭтаФорма[ИмяСписка].ОсновнаяТаблица;
			//ОткрытьФорму(ИмяОбъекта+".ФормаОбъекта",,ЭтаФорма,УникальныйИдентификатор);
		КонецЕсли;	
		
	ИначеЕсли ТекущийЭлемент.Имя="кнПоискКлиента" Тогда
		Парам=Новый Структура("ДилерскийЦентр,Отдел,Менеджер",ДилерскийЦентр,Отдел,Renault_ОбщиеФункцииСервер.ТекущийПользователь());
		ОткрытьФорму("Обработка.Renault_ARM_Менеджеры.Форма.ФормаПоискКлиента",Парам,ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ОбновитьПослеПоискаКилента", ЭтаФорма));
		
	Иначе 
		Сообщить("Действие кнопки еще не настроено"); Возврат
	КонецЕсли;
	
	//обновление списка - при любом действии кнопок списка
	Если ИмяПунктаМеню="Календарь" Тогда ОбновитьКалендарь()
	//ИначеЕсли ИмяПунктаМеню="Диаграммы" Тогда ОтчетДиаграмма()
	Иначе 
		Элементы[ИмяСписка].Обновить() 
	КонецЕсли;
	
КонецПроцедуры

