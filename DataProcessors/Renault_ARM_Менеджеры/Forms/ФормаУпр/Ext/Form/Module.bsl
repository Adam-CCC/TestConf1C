&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверка на доступ к работе с АРМ
	Если НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмМенеджера(Renault_ОбщиеФункцииСервер.ТекущийПользователь()) тогда
		Сообщить("У вас нет прав на запуск АРМ");
		Отказ=Истина;
		Возврат
	КонецЕсли;
	
	//доступность закладок может регламентироваться правами или контекстом, - соответстенно формируем список, или передаем
	Если Параметры.Свойство("ПунктыМеню") Тогда
		ПунктыМеню=Параметры.ПунктыМеню
	Иначе
		ПунктыМеню.Добавить("События");
		ПунктыМеню.Добавить("Календарь");
		ПунктыМеню.Добавить("Трафик");
		ПунктыМеню.Добавить("РабочиеЛисты");
		ПунктыМеню.Добавить("ЗаявкиНаПодбор");
	КонецЕсли;	
	ТекущаяЗакладкаМеню=0;
	ТекущийРежимТрафика=Элементы.кнСпТрафик.ПодчиненныеЭлементы[0].Имя;
	
	Дата1=НачалоМесяца(ТекущаяДата());
	Дата2=ТекущаяДата();
	УстановитьЗаголовок();

	ДилерскийЦентр=Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(Renault_ОбщиеФункцииСервер.ТекущийПользователь());
	Отдел=Renault_CRM.ПолучитьОтделАвтосалона();
	
	УстановитьПараметрыСписков();
	УстановитьОтбор();
	
	//+календарь
	//Календарь.Сотрудник=Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник; - все сотрудники
	Календарь.ВидКалендаря=2;
	
	Интервал=5;
	Календарь.ИнтервалСлота=30;
	ЗаголовокИнтервала();
	Календарь.ТочностьПланирования=Календарь.ИнтервалСлота;
	
	Календарь.ОтображатьВыходные=Истина;
	Календарь.ДатаКалендаря=ТекущаяДата();
	УстановитьПериод();
	Календарь.ПервыйЧас=Календарь.НачалоРабочегоВремени;
	Календарь.РежимПодбора=Ложь;
	Календарь.ТолькоЧтение=Ложь;
	
	Массив=Новый Массив; 
	Массив.Добавить(Перечисления.Renault_ОбластиПрименения.Продажи);
	Массив.Добавить(Перечисления.Renault_ОбластиПрименения.Общие);
	Календарь.ВидыСобытий.ЗагрузитьЗначения(Массив);
	ДоступностьЭлементов();
	//-календарь
	
КонецПроцедуры

