		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОстаткиАвтомобилейОбороты.Автомобиль КАК Автомобиль,
	ОстаткиАвтомобилейОбороты.СуммаПриход,
	ОстаткиАвтомобилейОбороты.Партия.Дата КАК ДатаВыкупа,
	ОстаткиАвтомобилейОбороты.Партия,
	ОстаткиАвтомобилейОбороты.СкладКомпании
ПОМЕСТИТЬ ОбротыАвто
ИЗ
	РегистрНакопления.ОстаткиАвтомобилей.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			,
			СкладКомпании В
				(ВЫБРАТЬ
					Renault_РеквизитыСкладовКомпании.СкладКомпании
				ИЗ
					РегистрСведений.Renault_РеквизитыСкладовКомпании КАК Renault_РеквизитыСкладовКомпании
				ГДЕ
					Renault_РеквизитыСкладовКомпании.СкладПодержанныхАвто = ИСТИНА
					И Renault_РеквизитыСкладовКомпании.СкладКомпании В (&amp;МассивСкладовДилера))) КАК ОстаткиАвтомобилейОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОбротыАвто.Автомобиль,
	ОбротыАвто.СуммаПриход,
	ОбротыАвто.ДатаВыкупа,
	ВЫБОР
		КОГДА ЕСТЬNULL(ПродажиАвтомобилейОбороты.СуммаОборот, 0) = 0
			ТОГДА ЦеныАвтомобилей.Цена
		ИНАЧЕ ПродажиАвтомобилейОбороты.СуммаОборот
	КОНЕЦ КАК ЦенаПродажи,
	ВЫБОР
		КОГДА ЕСТЬNULL(ПродажиАвтомобилейОбороты.ДокументПродажи.Дата, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА РАЗНОСТЬДАТ(ОбротыАвто.ДатаВыкупа, &amp;ТекущаяДата, ДЕНЬ)
		ИНАЧЕ РАЗНОСТЬДАТ(ОбротыАвто.ДатаВыкупа, ПродажиАвтомобилейОбороты.ДокументПродажи.Дата, ДЕНЬ)
	КОНЕЦ КАК ДнейНаСкладе,
	isnull(ЗаявкиНаТрейдИн.ЗатратыДиагностика,0) + isnull(ЗаявкиНаТрейдИн.ЗатратыОсмотрМашины,0) как ЗатратыНаВостановление
ИЗ
	ОбротыАвто КАК ОбротыАвто
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн КАК ЗаявкиНаТрейдИн
		ПО ОбротыАвто.Автомобиль = ЗаявкиНаТрейдИн.Автомобиль
			И (ЗаявкиНаТрейдИн.Статус = ЗНАЧЕНИЕ(Перечисление.Renault_CRM_СтатусЗаявокТрейдИн.ОформлениеЗавершено))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПродажиАвтомобилей.Обороты КАК ПродажиАвтомобилейОбороты
		ПО ОбротыАвто.Автомобиль = ПродажиАвтомобилейОбороты.Автомобиль
			И ОбротыАвто.СкладКомпании = ПродажиАвтомобилейОбороты.СкладКомпании
			И ОбротыАвто.Партия = ПродажиАвтомобилейОбороты.Партия
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныАвтомобилей.СрезПоследних(, ТипЦен = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)) КАК ЦеныАвтомобилей
		ПО ОбротыАвто.Автомобиль = ЦеныАвтомобилей.Автомобиль	</query>
