// ЭКСПОРТИРУЕМЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ ИНТЕГРАЦИИ С БАЗОЙ ДАННЫХ

// Дополнить данные телефонных номеров для мастера создания автоматического клиента
//  или контактного лица
Процедура ДополнитьДанныеНезарегистрированногоКонтрагента(ДанныеНезарегистрированногоКонтрагента) Экспорт
	Возврат;	
КонецПроцедуры

// Выполняем подключение Софтфона, вызов функции располагается в модуле приложения
//  в процедуре ПриСтартеСистемы
Функция ПодключитьСофтФон() Экспорт
	
	РезультатПодключенияСофтФона = Ложь;
	/////////////////////////////////////////////////////////////////////////
	// Инициализация
	Если ДопМодули = Неопределено Тогда
		ИнициализироватьОсновныеДопМодули();
		// Получим сохраненные ранее значения настроек панели
	КонецЕсли;
	// Сохраненная ранее история звонков
	ЗаполнитьТаблицуИсторииЗвонков(ТекущаяДата()); 
	мОбработкаДанных.ВосстановитьОсновныеНастройки();
	/////////////////////////////////////////////////////////////////////////
	// Можно использовать софт фон
	Если ИспользоватьСофтФон() Тогда

		// Если форма уже определена, то вызовем ее
		Если БезИнтеграционныйРежим ИЛИ ГлобальныеПеременные.глИспользоватьПанельТелефонии Тогда
			Если Компонент=Неопределено Тогда
				ПодключитьВК();
			КонецЕсли;	
			
			// Если форма уже определена, то вызовем ее
			Если ФормаТелефон = Неопределено Тогда
				ФормаТелефон = ЭтотОбъект.ПолучитьФорму("ФормаПанели");
			КонецЕсли;
			
			Если ФормаТелефон.Открыта() Тогда 
            	// не активизируем
			Иначе ФормаТелефон.Открыть();
			КонецЕсли;
			РезультатПодключенияСофтФона = Истина;
		Иначе
			// Если флаг изменился, то принудительно закроем форму
			Если ФормаТелефон <> Неопределено 
				И ФормаТелефон.Открыта() 
				Тогда ФормаТелефон.Закрыть(); КонецЕсли;
			// Отключение СофтФона, результат отработки процедуры истина
			РезультатПодключенияСофтФона = Истина;
		КонецЕсли;
	Иначе
		// Если флаг изменился, то принудительно закроем форму
		Если НЕ ФормаТелефон = Неопределено Тогда
			Если ФормаТелефон.Открыта() Тогда ФормаТелефон.Закрыть(); КонецЕсли;
			// Отключение СофтФона, результат отработки процедуры истина
			РезультатПодключенияСофтФона = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатПодключенияСофтФона;
КонецФункции

// Функция определяет используется ли СофтФон в системе и для текущего пользователя
//
Функция ИспользоватьСофтФон() Экспорт
    // проверка параметров запуска
	Если КонтрольПервогоЗапуска() = Ложь Тогда
		Возврат Ложь;
	КонецЕсли; 

	ГлобальныеПеременные.Вставить("глИспользоватьПанельТелефонии", мОбщийМодуль.ИспользоватьПанельТелефонии(БезИнтеграционныйРежим));
	Возврат ГлобальныеПеременные.глИспользоватьПанельТелефонии;
КонецФункции

// Проверка параметров запуска
// Старт помощника настройки
Функция КонтрольПервогоЗапуска()

	Если РаботаВозможна = Ложь Тогда
		// на случай, если проверка уже происходила ранее в этом сеансе работы
		//
		Возврат РаботаВозможна;	
	КонецЕсли; 
	
	ПервыйЗапускТекП = мОбработкаДанных.ПолучитьНастройкиИзХранилища("MIKO","SIP_ЭтоПервыйЗапуск"+БезИнтеграционныйРежим,,ИмяПользователя());
	Если ПервыйЗапускТекП <> "НЕТ" Тогда
		Если НЕ РольДоступна("ПолныеПрава") Тогда
			// со стартовым помощником при первом запуске может работать только
			// пользователь с полными правами
			РаботаВозможна = Ложь;
			Возврат РаботаВозможна;		
		КонецЕсли; 
		
		Форма = ПолучитьФорму("ЛицензионноеСоглашение"); 
		Если Форма.Открыта() Тогда
			Возврат Ложь;		
		КонецЕсли; 
		Результат = Форма.ОткрытьМодально();
		Если Результат = Истина Тогда
			мОбработкаДанных.СохранитьНастройкиВХранилище("MIKO","SIP_ЭтоПервыйЗапуск"+БезИнтеграционныйРежим, "НЕТ",,ИмяПользователя());
			Если НЕ БезИнтеграционныйРежим 
				И НЕ мОбщийМодуль.ПервыйЗапускВозможен() Тогда
				РаботаВозможна = Истина;
				Возврат РаботаВозможна;
			КонецЕсли; 
		Иначе
			Если НЕ ФормаТелефон = Неопределено Тогда
				ФормаТелефон.Закрыть();
			КонецЕсли;
			ОтключитьВК();
			РаботаВозможна = Ложь;
			Возврат РаботаВозможна;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции // КонтрольПервогоЗапуска()
 
// Процедура вызывается из карточек тех объектов, к которым можно вводить
//  контактную информацию, изменяет текущую запись регистра и вызывает 
//  обработку заполнения телефона, Идентификатор и Номер телефона передается из документа
//  в виде строки параметров СтрокаПараметров, а так же внутренний или внешний это номер
Процедура СоздатьНомерКИ(ТекущаяСтрока, ОбъектКИ, ФормаВладелец, СтрокаПараметров) Экспорт 
	Если НЕ ЗначениеЗаполнено(СтрокаПараметров) Тогда
		Возврат;
	КонецЕсли; 
	// Проверим может ли пользователь работать с СофтФоном
	ФормаДобавленияКИ = ЭтотОбъект.ПолучитьФорму("ДобавлениеНомераКИ", ФормаВладелец, СтрокаПараметров);
	
	// дозаполняем поля формы
	ДанныеЗаполнения = мОбщийМодуль.ПолучитьДанныеЗаполненияСоздатьНомерКИ(ОбъектКИ);
	ЗаполнитьЗначенияСвойств(ФормаДобавленияКИ, ДанныеЗаполнения);
	
	ФормаДобавленияКИ.ОткрытьМодально();
	
	Если ФормаВладелец = Неопределено Тогда
		ЗаполнитьТаблицуИсторииЗвонков(ФормаТелефон.ЭлементыФормы.ПолеКалендаряИсторииЗвонков.Значение);
	КонецЕсли; 
КонецПроцедуры

// Процедура вызывается из карточек тех объектов, у которых необходимо набрать номер
// 
Процедура НабратьНомерКИ(ТекущаяСтрока) Экспорт
	// Проверим может ли пользователь работать с СофтФоном
	Если мОбработкаДанных = Неопределено
		 И НЕ ТекущаяСтрока = Неопределено
		 И НЕ мОбработкаДанных.РаботаССофтФономРазрешена(Истина, ГлобальныеПеременные.глИспользоватьПанельТелефонии, мПользователь) Тогда 
		Возврат; 
	КонецЕсли;
	
	Если ТекущаяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
		СтруктураТелефона = мОбработкаДанных.СформироватьСтруктуруНомераИзПолей(ТекущаяСтрока);
		Если ЗначениеЗаполнено(СтруктураТелефона.Представление) Тогда
			НабранныйКонтакт = мОбработкаДанных.ПреобразоватьКонтактВСтруктуру(ТекущаяСтрока.Объект, ТекущаяСтрока.Поле1, ТекущаяСтрока.Поле2, ТекущаяСтрока.Поле3, ТекущаяСтрока.Поле4);
			НабираемыйНомер	 = ПреобразоватьНомерСУчетомПрефиксов(СтруктураТелефона,Ложь);
			Если ЗначениеЗаполнено(ТекущаяСтрока.Поле4) Тогда
				ЗапланированныйДонабор.Вставить(НабираемыйНомер, ТекущаяСтрока.Поле4);
			КонецЕсли;	
			НабратьНомер(НабираемыйНомер);
		КонецЕсли;	
		
	КонецЕсли;
КонецПроцедуры

// Процедура выдает пользователю на экран список телефонных номеров
//   объектов, переданных в СписокОбъектов. И по выбранному выполняем дозвон
Процедура ПозвонитьВыбравТелефон(СписокОбъектов) Экспорт
	
	СписокТелефонов = Новый СписокЗначений;
	
	Для каждого ТекущийОбъект Из СписокОбъектов Цикл
		мОбщийМодуль.ПолучитьСписокТелефоновСофтФон(ТекущийОбъект.Значение, СписокТелефонов);
	КонецЦикла;
	
	КоличествоНайденныхНомеров = СписокТелефонов.Количество();
	Если КоличествоНайденныхНомеров = 0 Тогда
		Возврат;
		// как минимум две записи (одна корневая)
	ИначеЕсли КоличествоНайденныхНомеров = 2 Тогда 
		ЭлементСписка = СписокТелефонов[1];
	Иначе
		ЭлементСписка = СписокТелефонов.ВыбратьЭлемент("Выберите телефон");
	КонецЕсли;
	
	Если ЭлементСписка = Неопределено Тогда Возврат; КонецЕсли;
	
	ТелефонныйНомер = ЭлементСписка.Значение;
	Если ТелефонныйНомер.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	НабранныйКонтакт = мОбработкаДанных.ПреобразоватьКонтактВСтруктуру(ТелефонныйНомер.Объект, ТелефонныйНомер.КодСтраны, ТелефонныйНомер.КодГорода, ТелефонныйНомер.НомерТелефона, ТелефонныйНомер.Внутренний);
	НабираемыйНомер	 = ПреобразоватьНомерСУчетомПрефиксов(ТелефонныйНомер,Ложь);
	Если ЗначениеЗаполнено(ТелефонныйНомер.Внутренний) Тогда
		ЗапланированныйДонабор.Вставить(НабираемыйНомер, ТелефонныйНомер.Внутренний);
	КонецЕсли;	
	НабратьНомер(НабираемыйНомер);
	
КонецПроцедуры

