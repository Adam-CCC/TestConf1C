// ФУНКЦИИ И ПРОЦЕДУРЫ ОТПРАВКИ КОММАНД SIP серверу

// Инициализируем исходящий звонок
//
Функция НабратьНомер(НомерАбонента) Экспорт
	Рез = Ложь;
	
	Если Компонент = Неопределено
		ИЛИ ФормаТелефон = Неопределено
		ИЛИ НЕ ТипЗнч(НомерАбонента) = Тип("Строка")
		ИЛИ НЕ ЗначениеЗаполнено(НомерАбонента) Тогда
		
		Возврат Рез;
	КонецЕсли; 
	
	
	Если НаборНомераРазрешен
		 И ЗначениеЗаполнено(НомерАбонента) Тогда
		// временный запрет набора
		параметрНабора = НомерАбонента;
		мОбработкаДанных.ЗапретитьНаборНомера(параметрНабора);
	Иначе
		Возврат Рез;
	КонецЕсли;

	
	Если НЕ ФормаТелефон.Открыта() Тогда
		ФормаТелефон.Открыть();
	Иначе
		ФормаТелефон.Активизировать();
	КонецЕсли;
	
	Результат="";
	Попытка
		Компонент.Dial("sip:" + НомерАбонента + "@" + Хост);
		Сообщить("SIP софтфон для 1С: Был выполнен набор номера: " + НомерАбонента + " ...");
		Рез = Истина;
	Исключение
		Сообщить("SIP софтфон для 1С: Не удалось выполнить набор номера: " + НомерАбонента + " ...");
		СообщитьОтладочнуюИнформацию("SIP софтфон для 1С:", "Ошибка при инициализации звонка на номер "+НомерАбонента);
	КонецПопытки;	
	
	Возврат Рез;
КонецФункции

// Отрабатывем требование пользователя принять вызов, это может быть прием вызова на гарнитуру или включение громкой связи,
// возможно автоматическое снятие трубки в программе софтфон.
//
Процедура ОтветНаЗвонок(ТекущийЗвонок) Экспорт
	Если ТекущийЗвонок = Неопределено
		 ИЛИ Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Попытка
	    Компонент.Answer(ТекущийЗвонок.Канал);
		// для умных телефонов, тут следует описать команды для перевода звонка например на гарнитуру
		Сообщить("SIP софтфон для 1С: Отвечаем на звонок: " + ТекущийЗвонок.CallerID);	
	Исключение
		Сообщить("SIP софтфон для 1С: Не удалось ответить на звонок ...");
		СообщитьОтладочнуюИнформацию("SIP софтфон для 1С: ", "Ошибка при ответе на звонок: " + ОписаниеОшибки());
	КонецПопытки; 
КонецПроцедуры	

// Разрываем соединение для канала в выбранной строке
//
Процедура ОтбойЗвонка(ТекущийЗвонок) Экспорт
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Результат = "";
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При попытке положить трубку ","Компонент не подключен");
		Возврат;
	КонецЕсли; 
	
	Попытка
        Компонент.Hangup(ТекущийЗвонок.Канал);
		Сообщить("SIP софтфон для 1С: Отбиваем звонок: "+ТекущийЗвонок.CallerID);
	Исключение
		СообщитьОтладочнуюИнформацию("SIP софтфон для 1С: ", "Исключение отбоя " + ОписаниеОшибки());
	КонецПопытки; 
	
КонецПроцедуры

// Для текущего звонка осуществляет перевод звонка в зависимости от соотояния,
// если для выбранной строки оператор уже общается с клиентом то будет использоваться 
// консультативный перевод, иначе звонок переадресуется безконсультативно.
//
Процедура ПереводЗвонка(ТекущийЗвонок,НомерПеревода) Экспорт
	Если НЕ ЗначениеЗаполнено(ТекущийЗвонок) Тогда
		Возврат;
	КонецЕсли; 
	ТекущийЗвонок.КПереадресации 	  = Истина;
	ТекущийЗвонок.НомерКПереадресации = НомерПеревода;
	
	Если ТекущийЗвонок.СейчасРазговаривают Тогда
		УдержаниеЗвонка(ТекущийЗвонок);
		НабратьНомер(НомерПеревода);                              
	Иначе
		ОтветНаЗвонок(ТекущийЗвонок);
	КонецЕсли; 
КонецПроцедуры	

// Инициирование "Слепого" перевода звонка из текущей строки.
//
Процедура БезКонсультативныйПеревод(ТекущийЗвонок,НомерКудаПереводимЗвонокAtxfer)
	
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	ИначеЕсли Компонент = Неопределено Тогда
		Сообщить("SIP софтфон для 1С: Компонент не подключен");
		Возврат;
	КонецЕсли; 
	
	Попытка
		Компонент.Transfer(ТекущийЗвонок.Канал, "sip:" + НомерКудаПереводимЗвонокAtxfer + "@" + Хост);
		Сообщить("SIP софтфон для 1С: Перевод звонка на номер " + НомерКудаПереводимЗвонокAtxfer);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение при переводе звонка на номер " + НомерКудаПереводимЗвонокAtxfer,"");
	КонецПопытки; 
КонецПроцедуры	

// Перевод с консультацией оператора
// 
Процедура КонсультативныйПеревод(ID_Звонка1, ID_Звонка2) Экспорт
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При попытке положить трубку ","Компонент не подключен");
		Возврат;
	КонецЕсли; 
	Попытка	
		Компонент.AttendedTransfer(ID_Звонка1, ID_Звонка2);	
	Исключение
		// линия 1
	КонецПопытки; 
КонецПроцедуры
 
// Текущий канал из выбранной строки ставится на удержание.
//
Процедура УдержаниеЗвонка(ТекущийЗвонок) Экспорт
	
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	ИначеЕсли Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("Удержание ","Компонент не подключен");
		Возврат;
	КонецЕсли;

	Попытка
		Если НЕ ТекущийЗвонок.Удержание Тогда
	        Компонент.Hold(ТекущийЗвонок.Канал);
			Сообщить("SIP софтфон для 1С: Ставим на удержание звонок "+ТекущийЗвонок.CallerID);
			ТекущийЗвонок.Удержание = Истина;
		Иначе	
	        Компонент.Resume(ТекущийЗвонок.Канал);
			Сообщить("SIP софтфон для 1С: Снимаем звонок с удержания "+ТекущийЗвонок.CallerID);
			ТекущийЗвонок.Удержание = Ложь;
		КонецЕсли; 
	Исключение
		СообщитьОтладочнуюИнформацию("SIP софтфон для 1С: ", "Исключение при установке вызова на удержание: " + ИнформацияОбОшибке());
	КонецПопытки; 
КонецПроцедуры	

// Отправка тонального сигнала
// 
Процедура ОтправитьDTMF(Знач ID_Звонка, Знач Номер) Экспорт
	Если Компонент = Неопределено Тогда
	 	Возврат;	
	КонецЕсли;
	
	Если ТипЗнч(ID_Звонка)<>Тип("Строка") ИЛИ ТипЗнч(Номер)<>Тип("Строка") Тогда
		Возврат;
	КонецЕсли; 
	
	Если ПустаяСтрока(ID_Звонка) ИЛИ ПустаяСтрока(Номер) Тогда
		Возврат;	
	КонецЕсли; 
	Попытка
		Компонент.Input(ID_Звонка, Номер);	
	Исключение
	КонецПопытки; 
КонецПроцедуры
 
