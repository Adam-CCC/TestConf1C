// ПРОЦЕДУРЫ И ФУНКЦИИ ИНИЦИАЛИЗАЦИИ КОМПОНЕНТЫ

// Подключаем компоненту связи из макета и логинимся под менеджером астериска
//
Процедура ПодключитьВК() Экспорт
	Если НЕ НеобходимыеПараметрыАвторизацииЗаполнены() Тогда
		Сообщить("SIP софтфон для 1С: Не указаны параметры авторизации на сервере телефонии. Панель не будет подключена.");
		мОбработкаДанных.ОткрытьФормуНастроек();
		Возврат;
	КонецЕсли; 
	ИнициализироватьВК();
	
	Компонент.usesG711Only 			= usesG711Only;
	Компонент.detectsVoiceActivity 	= detectsVoiceActivity;
	Компонент.AllowStopStartMusic	= AllowStopStartMusic;
	Компонент.ReregistrationTime 	= ReregistrationTime;
	Компонент.useICE 				= useICE;
	Компонент.useDNSSRV 			= useDNSSRV;
	Компонент.STUNserver 			= STUNserver + ?(ЗначениеЗаполнено(STUNserver) И ЗначениеЗаполнено(STUNPort),":"+Формат(STUNPort, "ЧДЦ=0; ЧГ="),"");
	Компонент.SIPProxy 				= SIPProxy + ?(ЗначениеЗаполнено(SIPProxy) И ЗначениеЗаполнено(SIPProxyPort),":"+Формат(SIPProxyPort, "ЧДЦ=0; ЧГ="),"");
	Компонент.OutboundProxy 		= OutboundProxy + ?(ЗначениеЗаполнено(OutboundProxy) И ЗначениеЗаполнено(OutboundProxyPort),":"+Формат(OutboundProxyPort, "ЧДЦ=0; ЧГ="),"");

	Компонент.HaspLicenseServer 	= HaspLicenseServer;
	
	Если ЗначениеЗаполнено(LicenseХост) И ЗначениеЗаполнено(LicenseПорт) И ЗначениеЗаполнено(LicenseЛогин) И ЗначениеЗаполнено(LicenseПароль) Тогда
		Попытка
			Компонент.SetMIKOLicenseMode(LicenseХост, LicenseПорт, LicenseЛогин, LicenseПароль);
		Исключение
			СообщитьОтладочнуюИнформацию("Исключение при подключении к серверу лицензирования МИКО ", ИнформацияОбОшибке());
		КонецПопытки; 
	КонецЕсли; 
	Состояние("Контроль налиция лицензий ""SIP софтфон для 1С""...");
	
	ИнициализацияПанели();
	Если НЕ КлючЗащитыДоступен() Тогда
		Сообщить("Нет свободных лицензиц на ""SIP софтфон для 1С"".", СтатусСообщения.ОченьВажное);
		РаботаВозможна = Ложь;
		Возврат;
	КонецЕсли; 
	Состояние("SIP софтфон для 1С: Попытка подключения к АТС...");
	Попытка
		Компонент.Connect(МенеджерЛогин, МенеджерПароль, Хост + ":" + Формат(ПортSIP, "ЧДЦ=0; ЧГ="));
		СообщитьОтладочнуюИнформацию("Произведена попытка соединения с АТС!","");
	Исключение
		Компонент = Неопределено;
		СообщитьОтладочнуюИнформацию("Исключение при подключении к АТС компоненты MIKO_SIP ", ИнформацияОбОшибке());
	КонецПопытки; 
	
	Состояние("SIP софтфон для 1С: Выполняется инициализация звуковых устройств...");
	ПодключитьАудиоУстройства();
	
	Если Компонент = Неопределено Тогда 
		Оповестить("ОбновитьОтображениеФорм");
		Возврат;
	КонецЕсли;
	// подменим компонент типовой конфигурации
	РарусСофтФонЛайтКомпонента = "МИКО софтфон вместо Рарус софтфон лайт"; 
КонецПроцедуры	

// Создание объекта ВК
// 
Процедура ИнициализироватьВК()

	Попытка                                                                   
		СсылкаНаАрхив = ПоместитьВоВременноеХранилище(ЭтотОбъект.ПолучитьМакет("SIP_AddInWindows32_64"), Новый УникальныйИдентификатор);
		Если ПодключитьВнешнююКомпоненту(СсылкаНаАрхив, "Компонента", ТипВнешнейКомпоненты.Native) Тогда
			Компонент = Новый("AddIn.Компонента.MIKO_SIP");
		Иначе
			СообщитьОтладочнуюИнформацию("Не удалось подключить внешнюю компоненту MIKO_SIP ","");
		КонецЕсли;
	Исключение
		Компонент = Неопределено;
		СообщитьОтладочнуюИнформацию("Исключение при инициализации компоненты MIKO_SIP ", ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры
 
// Отключаем компоненту связи
//
Процедура ОтключитьВК() Экспорт
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	// очищаем таблицы
	Звонки.Очистить();
	Сотрудники.Очистить();
	SIP_ТаблицаКлючей = Неопределено;	
	Попытка
		Состояние("SIP софтфон для 1С: Отключение от АТС.");
		Компонент.Disconnect();
		Компонент.Close();
		Состояние("SIP софтфон для 1С: Отключение от АТС произведено успешно!");
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение при завершении сеанса работы с сервером телефонии!", ИнформацияОбОшибке());
	КонецПопытки; 
	ПодключенКСерверуТелефонии = Ложь;
	Компонент = Неопределено;
	Оповестить("ОбновитьОтображениеФорм");
КонецПроцедуры

Процедура Переподключить() Экспорт
	ОтключитьВК();
	ПодключитьСофтФон();
КонецПроцедуры
 
