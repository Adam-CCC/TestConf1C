// Инициализация ключевых переменных модуля объекта обработки
//
Процедура ИнициализироватьВспомагательныеПеременные()

	ПодключенКСерверуТелефонии 	= Ложь;
	НаборНомераРазрешен 		= Истина;
	// Определяем структуру внутреннего или внешнего звонка
	ТипВнутреннийВнешнийЗвонок = Новый Структура();
	ТипВнутреннийВнешнийЗвонок.Вставить("Внешний",	    0);
	ТипВнутреннийВнешнийЗвонок.Вставить("Внутренний",	1);

	СостояниеЭкстеншена 		= Новый Структура();
	СостояниеЭкстеншена.Вставить("Недоступен",0);
	СостояниеЭкстеншена.Вставить("Свободен",1);
	СостояниеЭкстеншена.Вставить("Разговаривает",2);
	СостояниеЭкстеншена.Вставить("Звонит",3);

	// Сохраненная ранее история звонков
	ЗапланированныйДонабор = Новый Соответствие();
	БезИнтеграционныйРежим = Ложь;
	ПолеКалендаряИсторииЗвонков = ТекущаяДата();
	КлючУникальности = Прав(Новый УникальныйИдентификатор,5);
		
	ЗагрузитьКодыГородов();
	
	БезИнтеграционныйРежим = (Метаданные.Обработки.Найти("МИКО_SIP_Softfon_For_1С") = Неопределено);
	
	ЕстьДокументСобытие = НЕ Метаданные.Документы.Найти("Событие") = Неопределено;
	ВСобытииЕстьUID 	= ЕстьДокументСобытие И (НЕ Метаданные.Документы.Событие.Реквизиты.Найти("CRM_GUIDЗвонка") = Неопределено);
КонецПроцедуры

Процедура ИнициализироватьОсновныеДопМодули() Экспорт
	// общий для всех модуль
	мОбработкаДанных = ЭтотОбъект.ПолучитьФорму("мОбработкаДанных");
	
	// Этап 1: подключаем первичные доп модули
	ИмяОбщегоМодуля = ПолучитьИмяОбщегоМодуля();
	Если ИмяОбщегоМодуля = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Попытка
		мОбщийМодуль 	 = ЭтотОбъект.ПолучитьФорму(ИмяОбщегоМодуля);
	    мПользователь 	 = мОбщийМодуль.ПолучитьТекущегоПользователя();
	Исключение
		// ошибка не должна случиться!
		Возврат;
	КонецПопытки; 
	// первоначальное заполнение глобальных переменных	
	ГлобальныеПеременные = мОбщийМодуль.ПолучитьГлобальныеПеременные();
	ГлобальныеПеременные.Вставить("глИспользоватьПанельТелефонии", БезИнтеграционныйРежим);	

КонецПроцедуры
Функция ПолучитьИмяОбщегоМодуля() Экспорт
	ИмяМодуля = Неопределено; 
	
	тмпИмяКонфигурации = мОбработкаДанных.ПолучитьНастройкиИзХранилища("MIKO","ИмяКонфигурации",,ИмяПользователя());
	ИмяТекущейКонфигурации = ?(ЗначениеЗаполнено(тмпИмяКонфигурации),тмпИмяКонфигурации,Метаданные.Имя); 
	ВерсияК = Метаданные.Версия;
	
	Если ИмяТекущейКонфигурации = "Автоматизация_1СФранчайзи"
		ИЛИ ИмяТекущейКонфигурации = "УправлениеТорговлей_CRMПроф"
		ИЛИ ИмяТекущейКонфигурации = "CRM"
		ИЛИ ЭтоCRMКонфигурация() Тогда
		ИмяМодуля = "мОбщийМодуль_CRM";
	ИначеЕсли (ИмяТекущейКонфигурации = "УправлениеТорговлей" И Лев(ВерсияК, 4) = "10.3")
		ИЛИ ИмяТекущейКонфигурации = "УправлениеПроизводственнымПредприятием"
		ИЛИ ИмяТекущейКонфигурации = "КомплекснаяАвтоматизация"
		ИЛИ ИмяТекущейКонфигурации = "УправлениеТорговымПредприятиемДляУкраины" 
		ИЛИ (ИмяТекущейКонфигурации = "УправлениеТорговлейДляУкраины" И Лев(ВерсияК, 3) = "2.3") 
		ИЛИ ИмяТекущейКонфигурации = "УправлениеПроизводственнымПредприятиемДляУкраины" Тогда
		ИмяМодуля = "мОбщийМодуль_УТ10_3";
	ИначеЕсли ИмяТекущейКонфигурации = "БухгалтерияПредприятия"
		ИЛИ ИмяТекущейКонфигурации = "БухгалтерияДляУкраины" Тогда
		ИмяМодуля = "мОбщийМодуль_БП2_0";
	КонецЕсли;
	
	Возврат ИмяМодуля;
КонецФункции // ПолучитьИмяОбщегоМодуля()
Функция ЭтоCRMКонфигурация() Экспорт
