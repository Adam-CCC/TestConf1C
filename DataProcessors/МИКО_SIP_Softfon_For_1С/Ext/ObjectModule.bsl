// Работа со списками аудио устройств
//
Функция ПолучитьСпиокАудиоУстройств() Экспорт
	Если Компонент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СписокУстройств = Неопределено;
	Если НЕ РазобратьXML_Devices(СписокУстройств) Тогда
		СообщитьОтладочнуюИнформацию("SIP софтфон для 1С:", "Не удалось получить список аудиоустройст!");	
	КонецЕсли; 
	Возврат СписокУстройств;
КонецФункции

// Для BLF клавиш / состояния
// 
Процедура ПодписатьсяНаОтслеживаниеСостояний()
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	НомераДляSubsribe = "";
	// 1. Перебор номеров из списка пользователей 
	Для каждого ТекущийСотрудник Из Сотрудники Цикл
		Если Не ЗначениеЗаполнено(ТекущийСотрудник.ВнутреннийНомер) Тогда
			Продолжить;
		КонецЕсли;		
		НомераДляSubsribe = НомераДляSubsribe + "" + ?(НомераДляSubsribe = "", "", ",") + ТекущийСотрудник.ВнутреннийНомер;
	КонецЦикла;  
	// 2. Перебор номеров для BLF
	Для каждого ТекущийНомер Из ПанельBLF Цикл
		Если Не ЗначениеЗаполнено(ТекущийНомер.Номер) Тогда
			Продолжить;
		КонецЕсли;		
		НомераДляSubsribe = НомераДляSubsribe + "" + ?(НомераДляSubsribe = "", "", ",") + ТекущийНомер.Номер;
	КонецЦикла;  
	
	Попытка
		Компонент.PresenceSubsribe(НомераДляSubsribe);
	Исключение
		СообщитьОтладочнуюИнформацию("SIP софтфон для 1С", "Нет возможности отследить состояния телефонов пользователей.");
	КонецПопытки; 
КонецПроцедуры

// Производит формирование имен путей к файлам записей / создает необходимые каталоги
// 
Процедура ПодготовитьНачатьЗаписьРазговора(Звонок)
	Если НЕ ЗначениеЗаполнено(КаталогДляХраненияЗаписей) Тогда
		Возврат;	
	КонецЕсли; 
	Звонок.ИмяВременногоФайла = ПолучитьИмяВременногоФайла("wav");
	КаталогДляЗаписи = КаталогДляХраненияЗаписей + Формат(Звонок.Когда, "ДФ=\yyyy\MM\dd\");
	СоздатьКаталог(КаталогДляЗаписи);
	
	Звонок.ИмяФайлаЗаписи = "" + КаталогДляЗаписи + Формат(Звонок.Когда, "ДФ=yyyyMMyy_HHmmss") + ?(Звонок.ВходящийЗвонок,"_in_","_out_")+МенеджерЛогин + "_" + Звонок.CallerID + ".wav";
    НачатьЗаписьРазговора(Звонок.Канал, Звонок.ИмяВременногоФайла);
КонецПроцедуры
// Начинает запись разговора                                      
//
Процедура НачатьЗаписьРазговора(Канал, ПутьКФайлу)                
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
    
	Если ТипЗнч(Канал)<>Тип("Строка") ИЛИ ТипЗнч(ПутьКФайлу)<>Тип("Строка") Тогда
		Возврат;
	КонецЕсли; 
	
	Если ПустаяСтрока(Канал) ИЛИ ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат;	
	КонецЕсли; 
	Попытка
	  	Компонент.StartRecordingCalltoWav(Канал, ПутьКФайлу);
	Исключение
	КонецПопытки; 	
КонецПроцедуры

// Производит перемещение файла с записью разговора / удаляет временные файлы
// 
Процедура ЗавершенитьЗаписьРазговора(Звонок)
  	Если НЕ ЗначениеЗаполнено(Звонок.ИмяВременногоФайла) ИЛИ НЕ ЗначениеЗаполнено(Звонок.ИмяФайлаЗаписи) Тогда
		Возврат;	
	КонецЕсли;  	
	
	Попытка
	    КопироватьФайл(Звонок.ИмяВременногоФайла, Звонок.ИмяФайлаЗаписи);
		УдалитьФайлы(Звонок.ИмяВременногоФайла);
	Исключение
	КонецПопытки; 
КонецПроцедуры

