// Является ли ОС Ubuntu
// проверка 
&НаКлиенте
Функция ЭтоUbuntu() Экспорт
	СисИнфо = Новый СистемнаяИнформация;
	ВерсияОС = НРег(СисИнфо.ВерсияОС);
	ЭтоUbuntu = Найти(ВерсияОС, "ubuntu")>0;
	
	Возврат ЭтоUbuntu;
КонецФункции // ЭтоUbuntu()

////////////////////////////////////////////////
// Лицензии. Система защиты.

// Проверка наличия лицензии на исползовании SIP компонента
// 
Функция КлючЗащитыДоступен() Экспорт
    Если ЭтоUbuntu() Тогда
		Возврат Истина;	
	КонецЕсли; 
	
	Если Компонент = Неопределено Тогда
		ИнициализироватьВК();
	КонецЕсли;
	Если Компонент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
    ПолучитьСведенияОЛицензированииSIP();
	
	Если SIP_ТипЛицензии = "perpetual"
		 ИЛИ ( ТипЗнч(SIP_ОстатокДнейЛицензии) = Тип("Число") И SIP_ОстатокДнейЛицензии > 0) Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции // ПроверитьНаличиеКлючаЗащиты()
 
// Получить информацию о ключах HASP доступных текущей панели
//
Процедура ПолучитьСведенияОЛицензированииSIP() 
	Если Компонент = Неопределено Тогда
		ИнициализироватьВК();
	КонецЕсли;
	
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если SIP_ТаблицаКлючей = Неопределено Тогда
		SIP_ТаблицаКлючей = ПолучитьТаблицуКлючейЗащиты();
	КонецЕсли; 
	Если SIP_ТаблицаКлючей = Неопределено Тогда
	 	Возврат;
	КонецЕсли; 
	Если Отладка = Истина Тогда
		ТекстЛицензий = "---------------- SIP ----------------------" + Символы.ПС;
		Для каждого СтрокаКлюча Из SIP_ТаблицаКлючей Цикл
			ТекстЛицензий = ТекстЛицензий + ?(ТекстЛицензий="","",Символы.ПС) 
							+ "id - " + СтрокаКлюча.id + ", " + СтрокаКлюча.type + ", тип - " 
							+ СтрокаКлюча.license_type + ", дней - " + СтрокаКлюча.count_days;
		КонецЦикла;
		ТекстЛицензий = ТекстЛицензий + Символы.ПС + "--------------------------------------" + Символы.ПС;
		СообщитьОтладочнуюИнформацию("Ключи защиты:", ТекстЛицензий);	
	КонецЕсли; 
	
	Если SIP_ТаблицаКлючей = Неопределено Тогда
		SIP_ОстатокДнейЛицензии = 0; SIP_ТипЛицензии = ""; SIP_РегистрационныйНомер = "";
		Возврат
	КонецЕсли;
	
	Ключ_perpetual = SIP_ТаблицаКлючей.Найти("perpetual", "license_type");
	Если НЕ Ключ_perpetual = Неопределено Тогда
		SIP_ОстатокДнейЛицензии = 0;
		SIP_ТипЛицензии			= Ключ_perpetual.license_type;
		SIP_РегистрационныйНомер= Ключ_perpetual.id;
		Возврат;
	КонецЕсли;
	
	ВсегоДнейОсталось = SIP_ТаблицаКлючей.Итог("count_days");
	Если ВсегоДнейОсталось < 0 Тогда
		SIP_ОстатокДнейЛицензии = ВсегоДнейОсталось; 
		SIP_ТипЛицензии = ""; SIP_РегистрационныйНомер = "";
		Возврат
	КонецЕсли; 
	
	Для каждого Ключ_trial Из SIP_ТаблицаКлючей Цикл
		Если НЕ Ключ_trial.license_type = "trial" ИЛИ Ключ_trial.count_days  <= 0 Тогда
			Продолжить;
		КонецЕсли; 	

		SIP_ОстатокДнейЛицензии = Ключ_trial.count_days;
		SIP_ТипЛицензии			= Ключ_trial.license_type;
		SIP_РегистрационныйНомер= Ключ_trial.id;
		Возврат;
	КонецЦикла;
	
	Оповестить("ОбновитьОтображениеФорм");
КонецПроцедуры

// Получить информацию о ключах HASP доступных текущей панели
// Параметры
//   Нет
// Возвращаемое значение
//   Неопределено - если не вышло соедениться с драйвером защиты или если компонент не инирциализирован
//   ТаблицаКлючей- тип ТаблицаЗначений, колнки id (тип - строка),license_type (тип - строка),count_days (тип - число) 
Функция ПолучитьТаблицуКлючейЗащиты() Экспорт
	Если Компонент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ТаблицаКлючей = Новый ТаблицаЗначений;
	ТаблицаКлючей.Колонки.Добавить("id");
	ТаблицаКлючей.Колонки.Добавить("feature_id");
	ТаблицаКлючей.Колонки.Добавить("license_type");
	ТаблицаКлючей.Колонки.Добавить("count_days");
	ТаблицаКлючей.Колонки.Добавить("type");
	
	ТекстЛицензий = ""; Результат="";
	Попытка	
		Результат = Компонент.GetHASPInfo();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	// 1. Производим парсинг - перечень страниц
	ЧтениеHTML 	 	= Новый ЧтениеHTML;	
	ПостроительDOM 	= Новый ПостроительDOM; 
	Попытка
		ЧтениеHTML.УстановитьСтроку(Результат);
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеHTML);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	// Получить перечень страниц
	ЭлементыUl = ДокументDOM.ПолучитьЭлементыПоИмени("hasp");
	ВсегоДнейОсталось = 0;
	Для каждого ТекЭлемент_hasp Из ЭлементыUl Цикл
		//<?xml version="1.0" encoding="UTF-8" ?>
		//<hasp_info>
		//  <license_manager>
		//	<hostname>VCENTER</hostname>
		//	<ip>172.16.32.6</ip>
		//	<osname>Microsoft Windows Server 2003</osname>
		//	<hasp id="13542686473463621" type="HASP-SL-AdminMode">
		//	  <feature id="2">
		//		<license>
		//		  <license_type>perpetual</license_type>
		//		</license>
		//	  </feature>
		//	</hasp>
		//  </license_manager>
		//</hasp_info>
		// тип лицензии
		АтрибутType = ТекЭлемент_hasp.Атрибуты.ПолучитьИменованныйЭлемент("type");
		АктивацияType = ?(АтрибутType = Неопределено,"",АтрибутType.Значение);
		id = ТекЭлемент_hasp.Идентификатор;
		
		Элементы_feature = ТекЭлемент_hasp.ПолучитьЭлементыПоИмени("feature");
		Для каждого ТекЭлементUl Из Элементы_feature Цикл
			feature_id = ТекЭлементUl.Идентификатор;
			
			// <license_type>trial</license_type>
			эл_license_type = ТекЭлементUl.ПолучитьЭлементыПоИмени("license_type");
			license_type = ?(эл_license_type.Количество()=0,"",эл_license_type[0].ТекстовоеСодержимое);
			Если license_type = "perpetual" Тогда
			 	ОстатокДнейЛицензии = 0;
				ВсегоДнейОсталось = 999;
			Иначе	
				// <time_start>1339865123</time_start>
				эл_time_start = ТекЭлементUl.ПолучитьЭлементыПоИмени("time_start");
				time_start = ?(эл_time_start.Количество()=0,"",эл_time_start[0].ТекстовоеСодержимое);
				time_start = ?(НРег(time_start) = "uninitialized","0",time_start);
				//		  <total_time>2592000</total_time>
				эл_total_time = ТекЭлементUl.ПолучитьЭлементыПоИмени("total_time");
				total_time = ?(эл_total_time.Количество()=0,"",эл_total_time[0].ТекстовоеСодержимое);
				Попытка
					ТекущееВремяВФорматеUnix 	= МестноеВремя(Текущаядата())-'19700101';
					ВремяОКончанияДействияКлюча	= ?(time_start="0",ТекущееВремяВФорматеUnix,Число(time_start)) + Число(total_time);
					
					ОстатокДнейЛицензии 		= Цел((ВремяОКончанияДействияКлюча-ТекущееВремяВФорматеUnix)/86400);
					ВсегоДнейОсталось = ВсегоДнейОсталось + ОстатокДнейЛицензии;
				Исключение
					ОстатокДнейЛицензии = 0;
					Продолжить;
				КонецПопытки; 
				ОстатокДнейЛицензии = ?(ОстатокДнейЛицензии<=0, 0, ОстатокДнейЛицензии);
			КонецЕсли; 
			
			СтрокаКлюча = ТаблицаКлючей.Добавить();
			СтрокаКлюча.id 			= id;
			СтрокаКлюча.license_type= license_type; 
			СтрокаКлюча.count_days 	= ОстатокДнейЛицензии;
			СтрокаКлюча.type 		= АктивацияType;
			СтрокаКлюча.feature_id  = feature_id;
		КонецЦикла	
	КонецЦикла;
	
	Возврат ТаблицаКлючей;
КонецФункции

// Отправка статистической информации в МИКО
// 
Процедура SendMetrikaStat(other = "")
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("SendMetrika", "Компонент не подключен");
		Возврат;
	КонецЕсли;
	
	HaspKeyID = "" + SIP_ТипЛицензии +"_№"+SIP_РегистрационныйНомер;
	Сис = Новый СистемнаяИнформация;
	СтрПлатформа 			= Сис.ВерсияПриложения;
	СтрКонфигурация 		= Метаданные.Имя;
	СтрРежимЗапуска 		= Метаданные.ОсновнойРежимЗапуска;
	СтрТипПлатформы 		= Сис.ТипПлатформы;
	СтрВерсияОС     		= Сис.ВерсияОС;
	СтрВерсияКонфигурации 	= Метаданные.Версия;
	
	ДанныеСтатистики = Новый Соответствие;
	ДанныеСтатистики.Вставить("haspkey",		HaspKeyID);
	ДанныеСтатистики.Вставить("platform1c",		СтрПлатформа);
	ДанныеСтатистики.Вставить("SoftPhone",		"MIKO Lab SoftPhone");
	ДанныеСтатистики.Вставить("config1c",		СтрКонфигурация);
	ДанныеСтатистики.Вставить("config1cVer",	СтрКонфигурация+СтрВерсияКонфигурации);
	ДанныеСтатистики.Вставить("DefaultRunMode",	СтрРежимЗапуска);
	ДанныеСтатистики.Вставить("PlatformType",	СтрТипПлатформы);
	ДанныеСтатистики.Вставить("OSVersion",		СтрВерсияОС);
	ДанныеСтатистики.Вставить("other",			other);
	ДанныеСтатистики.Вставить("SIPMode",	 	"SIP_SoftPhone_1C");
	
	Данные = "";
	Для каждого ТекПараметр Из ДанныеСтатистики Цикл
		Если ЗначениеЗаполнено(ТекПараметр.Значение) Тогда
			Данные = Данные + """"+ТекПараметр.Ключ+""":"""+ТекПараметр.Значение+""",";
		КонецЕсли; 
	КонецЦикла; 
	Данные = Лев(Данные, СтрДлина(Данные) - 1);
	Данные = мОбработкаДанных.URLEncode(Данные);
	Попытка
		Компонент.SendMetrika(Данные);
	Исключение
		СообщитьОтладочнуюИнформацию("SendMetrika", ИнформацияОбОшибке());
	КонецПопытки; 
	
КонецПроцедуры

