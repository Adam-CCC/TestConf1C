// ПРОЦЕДУРЫ И ФУНКЦИИ ОБРАБАТЫВАЮЩИЕ СОБЫТИЯ КОМПОНЕНТЫ

// Обработка внешнего события нашей компоненты SIP из главного модуля
//
Процедура ОбработкаВнешнегоСобытия_SIP(Источник, Событие, Данные) Экспорт
	
	СообщитьОтладочнуюИнформацию("SIP софтфон для 1С: Внешнее событие: [" + Событие + "] " ,Данные);
	// регистр не имеет значения, приводим все к нижнему 
	Событие = Нрег(Событие);
	
	Если Событие = "connection" Тогда
		ОбновитьСостояниеПодключения(Данные);
	ИначеЕсли событие = "message" Тогда
		ОбработатьОшибку(Данные);
	ИначеЕсли Событие = "call" Тогда
		ОбновитьСписокВызовов(Данные);
	ИначеЕсли Событие = "presence" Тогда
		onPresence(Данные);	
	ИначеЕсли Событие = "hasp_error" Тогда
		Если SIP_ТипЛицензии = "perpetual" Тогда
			// тут что то не то, драйвер не смог захватить лицензию
			SIP_РегистрационныйНомер = "";
		КонецЕсли; 
		SIP_ТипЛицензии = "trial";
		SIP_ОстатокДнейЛицензии = 0;
		Сообщить(НСтр("ru = '""Система защиты: " + Данные + "'"), СтатусСообщения.ОченьВажное);	
	Иначе
		Оповестить(Событие, Данные, ФормаТелефон);
	КонецЕсли;
КонецПроцедуры // ОбработкаВнешнегоСобытия_SIP

// Обработка оповещений о статусах пользователей
// [Presence]  <presence uri='sip:104@devsip228.ru:5060' status='Ready' />
// [Presence]  <presence uri='sip:104@devsip228.ru:5060' status='On the phone' />
// [Presence]  <presence uri='sip:104@devsip228.ru:5060' status='Ready' />
// [Presence]  <presence uri='sip:101@devsip228.ru:5060' status='Ringing' />
Процедура onPresence(Данные)

	ЧтениеXML = ПолучитьЧтениеXML(Данные);
	Если НЕ ЧтениеXML = Неопределено И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "presence" Тогда
		Результат_Соединение = Новый Структура("Номер,Статус");
		
		стр_status = ЧтениеXML.ЗначениеАтрибута("status");
		Если стр_status = "Ready" Тогда
			status = СостояниеЭкстеншена.Свободен;
		ИначеЕсли стр_status = "On the phone" Тогда	
			status = СостояниеЭкстеншена.Разговаривает;
		ИначеЕсли стр_status = "Not online" Тогда 
			status = СостояниеЭкстеншена.Недоступен;
		ИначеЕсли стр_status = "Ringing" Тогда 
			status = СостояниеЭкстеншена.Звонит;
		Иначе
			Возврат;
		КонецЕсли; 
		uri = ЧтениеXML.ЗначениеАтрибута("uri");
		ПозТоч = Найти(uri, ":");
		ПозСоб = Найти(uri, "@");
		Если ПозТоч>0 И ПозСоб>0 Тогда
			Номер = Сред(uri,ПозТоч+1, ПозСоб - ПозТоч-1);
		Иначе
			Возврат;
		КонецЕсли; 
		
		Для каждого ТекСотрудник Из Сотрудники Цикл
			Если НЕ ЗначениеЗаполнено(ТекСотрудник.ВнутреннийНомер)
				 ИЛИ НЕ ТекСотрудник.ВнутреннийНомер = Номер Тогда
				Продолжить;
			КонецЕсли; 
			ТекСотрудник.Состояние = status;
		КонецЦикла;
		
		Для каждого Линия Из ПанельBLF Цикл
		   	Если НЕ ЗначениеЗаполнено(Линия.Номер)
				 ИЛИ НЕ Линия.Номер = Номер Тогда
		     	Продолжить;
		  	КонецЕсли; 
			Линия.Состояние = status;
		КонецЦикла; 
	КонецЕсли;
КонецПроцедуры
 
// Обновляет состояние сетевого подключения.
//
//  НовоеСостояние [Строка]   Текст в формате XML. Определяет состояние
//                            подключения. Коды состояния соответсвуют кодам SIP
//                            протокола. Используются коды 200 для подтверждения
//                            запроса на подключения и коды 401,403 для отклония
//                            запроса.
//
Процедура ОбновитьСостояниеПодключения(НовоеСостояние)
	SIP_ОписаниеОшибки = "";
	
	Соединение = Неопределено;
	РазобратьXML_Connection(НовоеСостояние, Соединение);
	
	Если Соединение.Код = "200" Тогда
		Состояние("SIP софтфон для 1С: подключен к " + МенеджерЛогин + "@" + Хост);
		ПервыйЗапуск = НЕ (ПодключенКСерверуТелефонии = Истина);
		ПодключенКСерверуТелефонии = Истина;
		SendMetrikaStat("");
		//
		ПодписатьсяНаОтслеживаниеСостояний();
	ИначеЕсли Соединение.Состояние = "Connecting" Тогда
		Состояние("SIP софтфон для 1С: Подключение к серверу SIP телефонии...");
		ПодключенКСерверуТелефонии = ?(ПодключенКСерверуТелефонии = Неопределено, Ложь, ПодключенКСерверуТелефонии);
	Иначе
		ПодключенКСерверуТелефонии = Ложь;
		Если Соединение.Код = "401" Или Соединение.Код = "403" Тогда
			SIP_ОписаниеОшибки 	  = "Неверный логин/пароль. Код ошибки SIP - " + Соединение.Код + ".";
			
			мОбработкаДанных.ОткрытьФормуНастроек();	
		ИначеЕсли Соединение.Состояние = "Disconnected" Тогда
			SIP_ОписаниеОшибки = "Отключен";
		Иначе
			мОбработкаДанных.ОткрытьФормуНастроек();	
			SIP_ОписаниеОшибки = "Хост не доступен! Код ошибки SIP - " + Соединение.Код + ".";
		КонецЕсли;
		ОтключитьВК();
	КонецЕсли;
	
	Оповестить("ОбновитьОтображениеФорм");
КонецПроцедуры // ОбновитьСостояниеПодключения()

// Обрабатыает сообщение об ошибке.
//
//  НовоеСостояние [Строка]   Текст в формате XML. Содержит информацию об
//                            ошибке.
//
Процедура ОбработатьОшибку(НовоеСостояние)
	Если Найти(НовоеСостояние, "Не удается найти аудио устройство")>0
		 ИЛИ Найти(НовоеСостояние, "Не найден микрофон")>0 Тогда
		Предупреждение("" + СокрЛП(НовоеСостояние) + ". Работа софтфона невозможна!",10,"SIP софтфон для 1С:");
		// работа без аудио устройств невозможна, потому отключим ВК
		ОтключитьВК();
	КонецЕсли; 
	СообщитьОтладочнуюИнформацию("Message", НовоеСостояние);	
КонецПроцедуры // ОбработатьОшибку()

// Проводит предварительну обработку информации о вызове. Преобразует информацию
// из формата XML в структуру и обновляет список вызовов.
//
//  НовоеСостояние [Строка]   Текст в формате XML. Содержит информацию о вызове.
//
Процедура ОбновитьСписокВызовов(НовоеСостояние)
	Вызов = Новый Структура("НомерЛинии,Статус,НомерТелефона,Абонент,Входящий,КПереадресации", "","","","","");
	РазобратьXML_Call(НовоеСостояние, Вызов);
    // номер абонента приходит в формате "sip:04@176.34.180.51"
	НомерАбонента = Сред(Вызов.НомерТелефона, 5, Найти(Вызов.НомерТелефона, "@") - 5);
	МассивЗвонков =	Звонки.НайтиСтроки(Новый Структура("CallerID, Канал",НомерАбонента, Вызов.НомерЛинии));
	
	// событие, начало вызова
	Если Вызов.Статус = "ringing" Или Вызов.Статус = "calling" Тогда
		Если МассивЗвонков.Количество() = 0 Тогда
			Оповестить("НовыйЗвонок",НомерАбонента,ЭтотОбъект);
			
			СтрочкаЗвонка =	Звонки.Добавить();
			СтрочкаЗвонка.Удержание	= Ложь;
			UID = Новый УникальныйИдентификатор;
			Если ЕстьДокументСобытие Тогда
				СсылкаСобытие = Документы.Событие.ПолучитьСсылку(UID);
				СтрочкаЗвонка.ИдентификаторЗвонка = СсылкаСобытие;
			Иначе
				СтрочкаЗвонка.ИдентификаторЗвонка = UID;
			КонецЕсли; 
		ИначеЕсли МассивЗвонков.Количество() = 1 Тогда
			СтрочкаЗвонка = МассивЗвонков[0];
		Иначе                                             
			СообщитьОтладочнуюИнформацию("Исключительная ситуация:", " Дубль строки звонка!");
			Возврат;
		КонецЕсли; 
		
		НомерИзменился = (СтрочкаЗвонка.CallerID<>НомерАбонента);
		
		СтрочкаЗвонка.CallerID			  	= НомерАбонента;
		СтрочкаЗвонка.НомерТелефона			  	= НомерАбонента;
		СтрочкаЗвонка.Канал			  		= Вызов.НомерЛинии;
		СтрочкаЗвонка.ВходящийЗвонок 	 	= (Вызов.Входящий=Истина);
		СтрочкаЗвонка.КПереадресации 		= Вызов.КПереадресации;
		Если НомерИзменился Тогда
			ОпределитьКонтрагентаКонтактногоЛицаПоНомеру(СтрочкаЗвонка);		
		КонецЕсли; 
		
		Оповестить("ОбновитьОтображениеПанелиЗвонков");
		Возврат;
	КонецЕсли;
	
	// событие, соединения двух абонентов
	Если Вызов.Статус = "current" Тогда
		Если НЕ МассивЗвонков.Количество() = 1 Тогда
			Возврат;
		Иначе		
			
			СтрочкаЗвонка = МассивЗвонков[0];
			// Это событие может прийти несколько раз для одного и того же звонка
			// к примеру, когда мы ставим вызов на удержание
			СтрочкаЗвонка.Когда = ?(НЕ ЗначениеЗаполнено(СтрочкаЗвонка.Когда),ТекущаяДата(), СтрочкаЗвонка.Когда);
			// проверим, возможно это подготовка к "слепой" переадресации
			Если СтрочкаЗвонка.КПереадресации Тогда
			  	БезКонсультативныйПеревод(СтрочкаЗвонка,СтрочкаЗвонка.НомерКПереадресации);
			КонецЕсли; 
			СтрочкаЗвонка.СейчасРазговаривают = Истина;
			// + ЗАПИСЬ
			ПодготовитьНачатьЗаписьРазговора(СтрочкаЗвонка);
			// ЗАПИСЬ - / 
			Если ОткрыватьСобытиеПриЗвонке 
				 И ОпределитьВнутреннийВнешнийЗвонок(СтрочкаЗвонка.CallerID) = ТипВнутреннийВнешнийЗвонок.Внешний Тогда
				ОткрытьСоздатьСобытие(Неопределено,СтрочкаЗвонка);
			КонецЕсли; 
		КонецЕсли; 
	ИначеЕсли Вызов.Статус = "finished" Тогда

		Если МассивЗвонков.Количество() > 0 Тогда
			СтрочкаЗвонка = МассивЗвонков[0];
			// + ЗАПИСЬ 
			ЗавершенитьЗаписьРазговора(СтрочкаЗвонка);
			// ЗАПИСЬ - / 
			Если СтрочкаЗвонка.КПереадресации Тогда
				Отбор = Новый Структура("КПереадресации,НомерКПереадресации,Удержание", Истина, СтрочкаЗвонка.CallerID, Истина);  
				ВызовыКПереадресации = Звонки.НайтиСтроки(Отбор);                   
			    Если ВызовыКПереадресации.Количество()>0 Тогда
					ВызовНаУдержании = ВызовыКПереадресации[0];
					// этот вызов снимаем с удержания
					// переадресация не завершена
					// абонент не готов принять вызов
					УдержаниеЗвонка(ВызовНаУдержании);
					ВызовНаУдержании.КПереадресации = Ложь;
					ВызовНаУдержании.НомерКПереадресации = "";
				КонецЕсли;
			КонецЕсли; 
			// ------------------------------------------------------------------------------------------------------------------------------------
			// сохраним историю звонков в настройках пользователя
			// в настройках хранится вся история
			нИстория = мОбработкаДанных.ПолучитьНастройкиИзХранилища("MIKO","ИсторияЗвонков",,ИмяПользователя()); 
			Если НЕ ТипЗнч(нИстория) = Тип("ТаблицаЗначений") Тогда
				нИстория = ИсторияЗвонков.Выгрузить();
			КонецЕсли; 
			нСтрИстория = нИстория.Вставить(0);
			нСтрИстория.ВходящийЗвонок 		  = (СтрочкаЗвонка.ВходящийЗвонок = Истина);
			нСтрИстория.ИдентификаторЗвонка   = СтрочкаЗвонка.ИдентификаторЗвонка;
			нСтрИстория.Когда                 = ?(ЗначениеЗаполнено(СтрочкаЗвонка.Когда),СтрочкаЗвонка.Когда, ТекущаяДата());
			нСтрИстория.Контрагент            = СтрочкаЗвонка.Контрагент;
			нСтрИстория.КонтактноеЛицо        = СтрочкаЗвонка.КонтактноеЛицо;
			нСтрИстория.НомерТелефона         = СтрочкаЗвонка.CallerID;
			нСтрИстория.СекундДлился          = ТекущаяДата() - нСтрИстория.Когда;
			нСтрИстория.ПропущенныйЗвонок     = (нСтрИстория.ВходящийЗвонок) 
												 И (НЕ СтрочкаЗвонка.СейчасРазговаривают ИЛИ СтрочкаЗвонка.Длительность = 0);
												 
			мОбработкаДанных.СохранитьНастройкиВХранилище("MIKO","ИсторияЗвонков", нИстория,,ИмяПользователя());
			// ------------------------------------------------------------------------------------------------------------------------------------
			
			// добавим запись в таблицу истории на форму
			// на форме отображается история только по выбранной дате
			Если ПолеКалендаряИсторииЗвонков = НачалоДня(нСтрИстория.Когда) Тогда
				СтрокаИстории = ИсторияЗвонков.Вставить(0);
				ЗаполнитьЗначенияСвойств(СтрокаИстории, нСтрИстория);
			КонецЕсли; 
			
			Звонки.Удалить(СтрочкаЗвонка);
			Оповестить("ОбновитьОтображениеПанелиЗвонков");
		КонецЕсли; 	
	КонецЕсли;
	
КонецПроцедуры // ОбновитьСписокВызовов()

// Производит разбор XML текста содержащего состояние подключения.
//
// Пример текста:
//  	<connection
//  		state='Connected'
//			code='200'
//		/>
//
//  xmlText              [Строка]      Текст в формате XML.
//  Результат_Соединение [Структура]   Возвращаемый параметр. Содержит
//                                     преобразованную из XML информацию.
//
Процедура РазобратьXML_Connection(xmlText, Результат_Соединение)
	
	ЧтениеXML = ПолучитьЧтениеXML(xmlText);
	Если НЕ ЧтениеXML = Неопределено
		 И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
		 И ЧтениеXML.Имя = "connection" Тогда
		Результат_Соединение = Новый Структура;
		Результат_Соединение.Вставить("Состояние",	ЧтениеXML.ЗначениеАтрибута("state"));
		Результат_Соединение.Вставить("Код",		ЧтениеXML.ЗначениеАтрибута("code"));
	КонецЕсли;
	
КонецПроцедуры // РазобратьXML_Connection()

// Производит разбор XML текста содержащего информацию о голосовой почте.
//
// Пример текста:
//  	<voicemail
//  		hasNew='2'
//  		msgWaitng='1'
//  		msgTotal='11'
//  	/>
//
//  xmlText              [Строка]      Текст в формате XML.
//  Результат_Оповещение [Структура]   Возвращаемый параметр. Содержит
//                                     преобразованную из XML информацию.
//
Процедура РазобратьXML_VoicemailMessages(xmlText, Результат_Оповещение)
	
	ЧтениеXML = ПолучитьЧтениеXML(xmlText);
	Если НЕ ЧтениеXML = Неопределено
		 И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
		 И ЧтениеXML.Имя = "voicemailMessages" Тогда
		 
		Результат_Оповещение = Новый Структура;
		Результат_Оповещение.Вставить("НовыхСообщений", ЧтениеXML.ЗначениеАтрибута("newMsgs"));	
	КонецЕсли;
	
КонецПроцедуры // РазобратьXML_VoicemailMessages()

// Производит разбор XML текста содержащего информацию о вызове.
//
// Пример текста:
//  	<call
//  		id='1'
//  		number='74993332211'
//  		name='Ivanov Sergey'
//  		status='ringing'
//  		incoming='1'
//  		started='20120517183055'
//  		duration='00:00'
//  	/>
//
//  xmlText         [Строка]      Текст в формате XML.
//  Результат_Вызов [Структура]   Возвращаемый параметр. Содержит
//                                преобразованную из XML информацию.
//
Процедура РазобратьXML_Call(xmlText, Результат_Вызов)
	
	ЧтениеXML = ПолучитьЧтениеXML(xmlText);
	Если НЕ ЧтениеXML = Неопределено
		 И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
		 И ЧтениеXML.Имя = "call" Тогда
		 
		Результат_Вызов.Вставить("НомерЛинии",		  ЧтениеXML.ЗначениеАтрибута("id"));
		Результат_Вызов.Вставить("Статус",			  ЧтениеXML.ЗначениеАтрибута("status"));
		Результат_Вызов.Вставить("НомерТелефона",	  ЧтениеXML.ЗначениеАтрибута("number"));
		Результат_Вызов.Вставить("Абонент",			  ЧтениеXML.ЗначениеАтрибута("name"));
		Результат_Вызов.Вставить("Входящий",		  ЧтениеXML.ЗначениеАтрибута("incoming") = "1");
		Результат_Вызов.Вставить("КПереадресации", Ложь);
		Если Результат_Вызов.Входящий = Ложь Тогда
			// проверим, может быть есть вызовы, ожидающие переадресации
			НомерТелефона = Результат_Вызов.НомерТелефона;
			НомерТелефона = Сред(НомерТелефона, 5, Найти(НомерТелефона, "@") - 5);
			Отбор = Новый Структура("КПереадресации,НомерКПереадресации", Истина, НомерТелефона);  
			ВызовыКПереадресации = Звонки.НайтиСтроки(Отбор);                   
		    Если ВызовыКПереадресации.Количество()>0 Тогда
				Результат_Вызов.Вставить("КПереадресации", Истина);
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры // РазобратьXML_Call()

// Производит разбор XML текста содержащего список устройств.
//
// Пример текста:
//  	<call
//  		id='1'
//  		number='74993332211'
//  		name='Ivanov Sergey'
//  		status='ringing'
//  		incoming='1'
//  		started='20120517183055'
//  		duration='00:00'
//  	/>
//
//  xmlText         [Строка]      Текст в формате XML.
//  Результат_Вызов [Структура]   Возвращаемый параметр. Содержит
//                                преобразованную из XML информацию.
//
Функция РазобратьXML_Devices(Результат_Устройства)
	Попытка
		xmlText = Компонент.ListSoundDevices();
	Исключение
	    Возврат Ложь;
	КонецПопытки; 
	
	Если xmlText = Неопределено Тогда
	 	Возврат Ложь;
	КонецЕсли; 
	
	ЕстьМикрофон = Ложь;
	ЕстьНаушники = Ложь;
	
	ЧтениеXML = ПолучитьЧтениеXML(xmlText);
	Если НЕ ЧтениеXML = Неопределено
		 И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
		 И ЧтениеXML.Имя = "list" Тогда
		 
		Результат_Устройства = Новый Массив;
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "item" Тогда
				Если ЧтениеXML.ЗначениеАтрибута("name") = "default" Тогда
				 	Продолжить;
				КонецЕсли; 
				
				Если ЧтениеXML.ЗначениеАтрибута("type") = "output" Тогда
					ЕстьНаушники = Истина;
					Если НЕ ЗначениеЗаполнено(АудиоВыход) Тогда
					 	АудиоВыход = ЧтениеXML.ЗначениеАтрибута("name");
					КонецЕсли; 
					Если НЕ ЗначениеЗаполнено(АудиоЗвук) Тогда
					 	АудиоЗвук = ЧтениеXML.ЗначениеАтрибута("name");
					КонецЕсли;
					
				ИначеЕсли ЧтениеXML.ЗначениеАтрибута("type") = "input" Тогда 	
					ЕстьМикрофон = Истина;
					Если НЕ ЗначениеЗаполнено(АудиоВход) Тогда
					 	АудиоВход = ЧтениеXML.ЗначениеАтрибута("name");
					КонецЕсли; 
				Иначе
					Продолжить;
				КонецЕсли; 
				Устройство = Новый Структура;
				Устройство.Вставить("Тип",		ЧтениеXML.ЗначениеАтрибута("type"));
				Устройство.Вставить("Название",	ЧтениеXML.ЗначениеАтрибута("name"));
				Результат_Устройства.Добавить(Устройство);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат (ЕстьМикрофон И ЕстьНаушники);
КонецФункции // РазобратьXML_Devices()

// Парсим переданную строку данных как XML 
// Параметры 
//		Данные - тип.Строка - Данные полученные от компоненты, в виде XML струтктуры
//
Функция ПолучитьЧтениеXML(СтрокаХМЛ)
	Попытка
		ЧтениеХМЛ = Новый ЧтениеXML;
		ЧтениеХМЛ.УстановитьСтроку(СтрокаХМЛ);
		Если ЧтениеХМЛ.Прочитать() Тогда
			Возврат ЧтениеХМЛ;
		КонецЕсли;
	Исключение
	КонецПопытки;
	СообщитьОтладочнуюИнформацию("Невозможно разобрать данные XML. ",СтрокаХМЛ);
	Возврат Неопределено;
КонецФункции // ПолучитьЧтениеXML()

