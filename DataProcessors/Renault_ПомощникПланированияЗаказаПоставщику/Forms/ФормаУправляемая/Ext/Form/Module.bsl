	|		ПО Renault_ЗначенияТочкиЗаказаСрезПоследних.Номенклатура = Renault_СтатусыНоменклатурыСрезПоследних.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_XYZКлассификацияНоменклатуры.СрезПоследних КАК Renault_XYZКлассификацияНоменклатурыСрезПоследних
	|		ПО Renault_ЗначенияТочкиЗаказаСрезПоследних.Номенклатура = Renault_XYZКлассификацияНоменклатурыСрезПоследних.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ABCКлассификацияНоменклатуры.СрезПоследних КАК Renault_ABCКлассификацияНоменклатурыСрезПоследних
	|		ПО Renault_ЗначенияТочкиЗаказаСрезПоследних.Номенклатура = Renault_ABCКлассификацияНоменклатурыСрезПоследних.Номенклатура";
	
	Запрос.УстановитьПараметр("ГруппаАнализа", Объект.ГруппаАнализа);
    Запрос.УстановитьПараметр("Скл", Объект.ГруппаАнализа);
	Запрос.УстановитьПараметр("ТекущаяДата", ДатаОбработки);
	Запрос.УстановитьПараметр("ПериодЗаказа", Объект.ПериодЗаказа);
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	

	
	Товары = Объект.Товары;
	Пока Выборка.Следующий() Цикл
		
		Нстр = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Нстр, Выборка);		
		Нстр.КЗаказу = ?(Выборка.Заказывать, Выборка.Заказ, 0); 
		Нстр.СтоимостьЗаказа = Нстр.КЗаказу*Нстр.ЦенаPNC;
		
		ОтобразитьОтклонениеПродаж(Выборка.СредниеПродажи, Выборка.ПродажиВТекущемМесяце, Выборка.Сигма, Нстр.ПродажиВТекущемМесяцеКартинка);
		Для сч=1 По 11 Цикл
			ОтобразитьОтклонениеПродаж(Выборка.СредниеПродажи, Выборка["ПродажиВТекущемМесяце"+сч], Выборка.Сигма, Выборка["ПродажиВТекущемМесяце"+сч+ "Картинка"]);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтобразитьОтклонениеПродаж(СредниеПродажи, ПродажиВМесяце, Сигма, Картинка)
	
	если  СредниеПродажи > ПродажиВМесяце Тогда 
		Отклонение = СредниеПродажи - ПродажиВМесяце;
		Если Отклонение > 1.5*Сигма Тогда
			Картинка = 5;			
		ИначеЕсли Отклонение > 0.5*Сигма Тогда
			Картинка = 1;
		Иначе 	
			Картинка = 0;
		КонецЕсли;
	иначе
		Отклонение = ПродажиВМесяце - СредниеПродажи;
		Если Отклонение > 1.5*Сигма Тогда
			Картинка = 8;			
		ИначеЕсли Отклонение > 0.5*Сигма Тогда
			Картинка = 4;
		Иначе 	
			Картинка = 0
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры 
