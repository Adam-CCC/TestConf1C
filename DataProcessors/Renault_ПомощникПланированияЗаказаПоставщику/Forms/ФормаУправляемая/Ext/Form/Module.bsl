
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ДатаОбработки = ТекущаяДата();
	
	Для сч = 1 По 11 Цикл
		Элементы["ТоварыПродажиВПредыдущемМесяце" + сч].Заголовок = "Продажи за " + Формат(ДобавитьМесяц(ДатаОбработки, -сч),"ДФ=MMMM");    	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_СоставГруппАнализаСкладов.Склад
	|ПОМЕСТИТЬ ВТ_Склады
	|ИЗ
	|	РегистрСведений.Renault_СоставГруппАнализаСкладов КАК Renault_СоставГруппАнализаСкладов
	|ГДЕ
	|	Renault_СоставГруппАнализаСкладов.ГруппаАнализа = &ГруппаАнализа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиОбороты.Период,
	|	ПродажиОбороты.Номенклатура,
	|	ПродажиОбороты.КоличествоОборот КАК Показатель
	|ПОМЕСТИТЬ ВТ_Продажи
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(
	|			ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, МЕСЯЦ), ГОД, -1),
	|			,
	|			Месяц,
	|			&ГруппаАнализа = ЗНАЧЕНИЕ(Справочник.Renault_ГруппыАнализаСкладов.ПустаяСсылка)
	|				ИЛИ СкладКомпании В
	|					(ВЫБРАТЬ
	|						Таб.Склад
	|					ИЗ
	|						ВТ_Склады КАК Таб)
	|				ИЛИ СкладКомпании.СкладКомпании В
	|					(ВЫБРАТЬ
	|						Таб.Склад
	|					ИЗ
	|						ВТ_Склады КАК Таб)) КАК ПродажиОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Продажи.Номенклатура,
	|	ВТ_Продажи.Показатель
	|ПОМЕСТИТЬ ПродажиВТекущемМесяце
	|ИЗ
	|	ВТ_Продажи КАК ВТ_Продажи
	|ГДЕ
	|	ВТ_Продажи.Период = НАЧАЛОПЕРИОДА(&ТекущаяДата, МЕСЯЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Продажи.Номенклатура,
	|	ВТ_Продажи.Показатель
	|ПОМЕСТИТЬ ПродажиВПредыдущемМесяце1
	|ИЗ
	|	ВТ_Продажи КАК ВТ_Продажи
	|ГДЕ
	|	ВТ_Продажи.Период = ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, МЕСЯЦ), МЕСЯЦ, -1)
	|;
