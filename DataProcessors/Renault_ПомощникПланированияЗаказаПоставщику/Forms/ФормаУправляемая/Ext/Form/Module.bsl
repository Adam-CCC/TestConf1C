	|ГДЕ
	|	ВТ_Продажи.Период = ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, МЕСЯЦ), МЕСЯЦ, -9)
	|;
	|
