
Функция СкопироватьРЛ(IDK = 0, ДатаНачала = '00010101', ДатаОкончания = '00010101') Экспорт
	
	НачатьТранзакцию();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РабочиеЛисты.ID КАК ID,
		|	Renault_РабочиеЛисты.IDK КАК IDK,
		|	Renault_РабочиеЛисты.Отдел КАК Отдел,
		|	Renault_РабочиеЛисты.Подразделение КАК Подразделение,
		|	Renault_РабочиеЛисты.ДилерскийЦентр КАК ДилерскийЦентр,
		|	Renault_РабочиеЛисты.VINАвтомобилей КАК VINАвтомобилей,
		|	Renault_РабочиеЛисты.Важность КАК Важность,
		|	Renault_РабочиеЛисты.ДатаID КАК ДатаID,
		|	Renault_РабочиеЛисты.ЗапросНаЗакрытие КАК ЗапросНаЗакрытие,
		|	Renault_РабочиеЛисты.Клиент КАК Клиент,
		|	Renault_РабочиеЛисты.КомментарийЗакрытия КАК КомментарийЗакрытия,
		|	Renault_РабочиеЛисты.Комплектация КАК Комплектация,
		|	Renault_РабочиеЛисты.ЛистЗакрыт КАК ЛистЗакрыт,
		|	Renault_РабочиеЛисты.МаркаАвтомобиля КАК МаркаАвтомобиля,
		|	Renault_РабочиеЛисты.МодельАвтомобиля КАК МодельАвтомобиля,
		|	Renault_РабочиеЛисты.ПервичныйИнтересМодель КАК ПервичныйИнтересМодель,
		|	Renault_РабочиеЛисты.ПричинаЗакрытия КАК ПричинаЗакрытия,
		|	Renault_РабочиеЛисты.Сотрудник КАК Сотрудник,
		|	Renault_РабочиеЛисты.Цвет КАК Цвет,
		|	Renault_РабочиеЛисты.АвторЗакрытия КАК АвторЗакрытия,
		|	Renault_РабочиеЛисты.ТипТрафика КАК ТипТрафика,
		|	Renault_РабочиеЛисты.ЖелаемаяДатаДоставки КАК ЖелаемаяДатаДоставки,
		|	Renault_РабочиеЛисты.ТипКлиента КАК ТипКлиента,
		|	Renault_РабочиеЛисты.ДатаЗапросаНаЗакрытие КАК ДатаЗапросаНаЗакрытие,
		|	Renault_РабочиеЛисты.ТипРабочегоЛиста КАК ТипРабочегоЛиста,
		|	Renault_РабочиеЛисты.СвязаныйIDK КАК СвязаныйIDK,
		|	Renault_РабочиеЛисты.ПродажаБУ КАК ПродажаБУ,
		|	Renault_РабочиеЛисты.АвтомобильБУ КАК АвтомобильБУ,
		|	Renault_РабочиеЛисты.ТипПродажиВыкупа КАК ТипПродажиВыкупа,
		|	Renault_РабочиеЛисты.Гарантия КАК Гарантия,
		|	Renault_РабочиеЛисты.СрокГарантии КАК СрокГарантии,
		|	Renault_РабочиеЛисты.КомментарийАвтомобиль КАК КомментарийАвтомобиль,
		|	Renault_РабочиеЛисты.IDТрафика КАК IDТрафика,
		|	Renault_РабочиеЛисты.IDCRM КАК IDCRM
		|ИЗ
		|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_РабочийЛист КАК Renault_РабочийЛист
		|		ПО Renault_РабочийЛист.ID = Renault_РабочиеЛисты.ID
		|		И Renault_РабочийЛист.IDK = Renault_РабочиеЛисты.IDK
		|		И Renault_РабочийЛист.Отдел = Renault_РабочиеЛисты.Отдел
		|		И Renault_РабочийЛист.Подразделение = Renault_РабочиеЛисты.Подразделение
		|		И Renault_РабочийЛист.ДилерскийЦентр = Renault_РабочиеЛисты.ДилерскийЦентр
		|ГДЕ
		|	ВЫБОР КОГДА &IDK <> 0 ТОГДА Renault_РабочиеЛисты.IDK = &IDK ИНАЧЕ ИСТИНА КОНЕЦ
		|	И ВЫБОР КОГДА &ДатаНачала <> &ПустаяДата ТОГДА Renault_РабочиеЛисты.ДатаID >= &ДатаНачала ИНАЧЕ ИСТИНА КОНЕЦ
		|	И ВЫБОР КОГДА &ДатаОкончания <> &ПустаяДата ТОГДА Renault_РабочиеЛисты.ДатаID < &ДатаОкончания ИНАЧЕ ИСТИНА КОНЕЦ
		|	И Renault_РабочийЛист.Ссылка ЕСТЬ NULL";
	Запрос.УстановитьПараметр("IDK", IDK);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Сч=0;
	КоличествоЗаписей = РезультатЗапроса.Количество();
	ЕстьОшибка = Ложь;
	ТекДата = ТекущаяДата();
	
	Для каждого Стр Из РезультатЗапроса Цикл
		
		Сч=Сч+1;
		
		НаборЗаписей = РегистрыСведений.Renault_РабочиеЛисты.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ID.Установить(Стр.ID);
		НаборЗаписей.Отбор.IDK.Установить(Стр.IDK);
		НаборЗаписей.Отбор.Отдел.Установить(Стр.Отдел);
		НаборЗаписей.Отбор.Подразделение.Установить(Стр.Подразделение);
		НаборЗаписей.Отбор.ДилерскийЦентр.Установить(Стр.ДилерскийЦентр);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
		
			Док = Документы.Renault_РабочийЛист.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(Док, Запись);
			Док.Дата = Запись.ДатаID;
			Док.УстановитьНовыйНомер();
			
			Попытка
				Док.Записать(РежимЗаписиДокумента.Запись);
				Сообщить("Обработано " + Сч + " из " + КоличествоЗаписей);
			Исключение
				ЕстьОшибка = Истина;
				Инфо = ИнформацияОбОшибке();
				Подробно = ПодробноеПредставлениеОшибки(Инфо);
				Сообщить(Подробно);
			КонецПопытки;
			
			Если ЕстьОшибка Тогда
				ОтменитьТранзакцию();
				Возврат Ложь;
			КонецЕсли; 
			
		КонецЦикла;
		
		//НаборЗаписей.Очистить();
		//НаборЗаписей.Записать();
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции