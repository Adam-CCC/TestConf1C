//в параметрах (перем. "Список") можно передать готовый список значений 
//	либо (перем. "ПарамерыСписка") можно передать Структура(ИмяСправочника,ТекущийЭлемент="",Родитель="")/Структура(ИмяПеречисления,ТекущийЭлемент)
//можно позволить множественный выбор
//можно ограничивать размеры кнопок
//можно ограничивать количество кнопок в строке
//можно разделить на группы - параметр "Иерархия"
//и прочее... смотрите код

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПарамОфр= Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления();
	ЦветАктивный=Вычислить(ПарамОфр.ОсновнойЦвет);
	ЦветПасс=Вычислить(ПарамОфр.ДопЦвет1);
	//ЦветТекста=Вычислить(ПарамОфр.ЦветТекста);
	
	//удаление всех настроек сделанных ранее... не работает
	//ХранилищеСистемныхНастроек.Удалить("Обработка.DMS_Диалог.Форма.ДиалогВыбораСписка/НастройкиФормы");
	
	Иерархия=?(Параметры.Свойство("Иерархия"),Истина,Ложь);
	
	Если Параметры.Свойство("Список") Тогда СпЗн=СписокВыбора(Параметры.Список)
	ИначеЕсли Параметры.Свойство("ПарамерыСписка") Тогда //переопределен список значений
		СтрСписка=Параметры.ПарамерыСписка;
		Если СтрСписка.Свойство("ИмяСправочника") Тогда
			ОтборПоГруппе=?(СтрСписка.Свойство("Родитель"),СтрСписка.Родитель,"");
			текЭлемент=?(СтрСписка.Свойство("ТекущийЭлемент"),СтрСписка.ТекущийЭлемент,"");
			СпЗн=СписокВыбораПоСправочнику(СтрСписка.ИмяСправочника,текЭлемент,ОтборПоГруппе);
		ИначеЕсли СтрСписка.Свойство("ИмяПеречисления") Тогда
			СпЗн=СписокВыбораПоПеречислению(СтрСписка.ИмяПеречисления,СтрСписка.ТекущийЭлемент);
			Иерархия=Ложь; //затычка
		КонецЕсли;	
	КонецЕсли; 
	
	Если Параметры.Свойство("МножественныйВыбор") Тогда МножественныйВыбор=Параметры.МножественныйВыбор КонецЕсли;
	Элементы.грМножественныйВыбор.Видимость=МножественныйВыбор;
	Если Параметры.Свойство("Заголовок") Тогда Заголовок=Параметры.Заголовок КонецЕсли;
	Если Параметры.Свойство("КоличествоЭлементовВСтроке") Тогда КоличествоЭлементовВСтроке=Параметры.КоличествоЭлементовВСтроке
	Иначе
		КоличествоЭлементовВСтроке=Мин(7,Sqrt(СпЗн.Количество()/2*3));
	КонецЕсли;
	
	ШиринаЭлемента=?(Параметры.Свойство("ШиринаЭлемента"),Параметры.ШиринаЭлемента,9);
	ВысотаЭлемента=?(Параметры.Свойство("ВысотаЭлемента"),Параметры.ВысотаЭлемента,2);
	
	Если КоличествоЭлементовВСтроке=0 Тогда КоличествоЭлементовВСтроке=4 КонецЕсли;
	
	Если НЕ МножественныйВыбор Тогда Элементы.грКнопки.Видимость=Ложь КонецЕсли; //Если НЕ МножественныйВыбор Тогда грКнопки.Видимость=Ложь КонецЕсли;
	
	НКонтейнера=0;
	НЭлемента=0;
	Если Иерархия Тогда
		НСтр=0;
		Для Каждого Эл Из СпЗн Цикл
			Контейнер=Элементы.Добавить("КонтГр"+Формат(НСтр,"ЧН=0;ЧГ=0"),Тип("ГруппаФормы"),Элементы.грЭлементы);
			Контейнер.Вид=ВидГруппыФормы.ОбычнаяГруппа;
			Контейнер.Отображение=ОтображениеОбычнойГруппы.ОбычноеВыделение;
			Контейнер.ОтображатьЗаголовок=Истина;
			Контейнер.Заголовок=Эл.Представление;
			Контейнер.ЦветТекстаЗаголовка=ЦветаСтиля.ЦветТекстаФормы;
			Контейнер.ЦветФона=Новый Цвет(240,240,240);
			Контейнер.Группировка=ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			Контейнер.РастягиватьПоГоризонтали=Истина;
			СформироватьКнопкиСписка(Эл.Значение,Контейнер,НКонтейнера,НЭлемента);
			НСтр=НСтр+1;
		КонецЦикла;	
	Иначе
		СформироватьКнопкиСписка(СпЗн,Элементы.грЭлементы,НКонтейнера,НЭлемента)
	КонецЕсли;	
	
КонецПроцедуры

Процедура СформироватьКнопкиСписка(СпЗн,Корень,НКонтейнера,НЭлемента)
	НКол=0;
	Для Каждого Эл Из СпЗн Цикл
		
		Если НКол=0 или НКол>КоличествоЭлементовВСтроке-1 Тогда
			НКол=0;
			Контейнер=Элементы.Добавить("Конт"+Формат(НКонтейнера,"ЧН=0;ЧГ=0"),Тип("ГруппаФормы"),Корень);
			Контейнер.Вид=ВидГруппыФормы.ОбычнаяГруппа;
			Контейнер.Отображение=ОтображениеОбычнойГруппы.Нет;
			Контейнер.ОтображатьЗаголовок=Ложь;
			Контейнер.Группировка=ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			Контейнер.РастягиватьПоГоризонтали=Истина;
			//Контейнер.ШиринаПодчиненныхЭлементов=ШиринаПодчиненныхЭлементовФормы.Одинаковая;
			НСтрок=НСтрок+1;
		КонецЕсли;
		
		ТекстКнопки=?(Эл.Представление="",Эл.Значение,Эл.Представление);
		
		ИмяКнопки="Зн"+Формат(НЭлемента,"ЧН=0;ЧГ=0");
	 	КомандаФормы=Команды.Добавить(ИмяКнопки);
	    КомандаФормы.Действие="НажатиеКнопки";
		КомандаФормы.Подсказка=ТекстКнопки;
		
		Кнопка=Элементы.Добавить(ИмяКнопки,Тип("КнопкаФормы"),Контейнер);
		Кнопка.Заголовок=ТекстЗаголовкаКнопки(ТекстКнопки,ВысотаЭлемента,ШиринаЭлемента);
		Кнопка.ИмяКоманды=ИмяКнопки;
		//Кнопка.ЦветТекста=ЦветТекста;
		Кнопка.Картинка=Эл.Картинка;
		Кнопка.Высота=ВысотаЭлемента;
		Кнопка.Ширина=ШиринаЭлемента;
		Кнопка.Отображение=ОтображениеКнопки.КартинкаИТекст;
		
		Если Эл.Пометка Тогда
			Кнопка.ЦветФона=ЦветАктивный;
			//Кнопка.ЦветРамки=ЦветАктивный;
			//Кнопка.Шрифт=Новый Шрифт(,,Истина);
		Иначе
			Кнопка.ЦветФона=ЦветПасс;
			//Кнопка.ЦветРамки=ЦветРамки;//Цвет;
		КонецЕсли;	
		
		НКонтейнера=НКонтейнера+1;
		НКол=НКол+1;
		НЭлемента=НЭлемента+1;
	КонецЦикла;
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//размеры формы
	Ширина=?(КоличествоЭлементовВСтроке=0,СтрДлина(Заголовок),КоличествоЭлементовВСтроке*ШиринаЭлемента);
	Высота=?(НСтрок=0,5,НСтрок*ВысотаЭлемента+2+НСтрок*0.5+?(МножественныйВыбор,1,0));
	ЗакрыватьПриЗакрытииВладельца=Истина;
	ОтображениеОбсуждений=ОтображениеОбсужденийФормы.НеОтображать;
	//ШиринаПодчиненныхЭлементов=ШиринаПодчиненныхЭлементовФормы.Одинаковая;
	Если Высота>40 Тогда ВертикальнаяПрокрутка=ВертикальнаяПрокруткаФормы.Использовать КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НажатиеКнопки(Команда)
	
	//переключение активности
	ЭлементСп=ЭлементСпискаПоИмениКнопки(Команда.Имя);
	
	Если НЕ МножественныйВыбор Тогда Закрыть(ЭлементСп.Значение); Возврат КонецЕсли; //выбор
	
	ЭлементСп.Пометка=НЕ ЭлементСп.Пометка;
	Если ЭлементСп.Пометка Тогда
		Элементы[Команда.Имя].ЦветФона=ЦветАктивный;
		//Элементы[Команда.Имя].ЦветРамки=ЦветАктивный;
		//Элементы[Команда.Имя].Шрифт=Новый Шрифт(,,Истина);
	Иначе
		Элементы[Команда.Имя].ЦветФона=ЦветПасс;
		//Элементы[Команда.Имя].ЦветРамки=ЦветРамки;//Цвет;
		//Элементы[Команда.Имя].Шрифт=Новый Шрифт;
	КонецЕсли;	
	
	//отключение остальных кнопок
	Если Не МножественныйВыбор Тогда
		Для Каждого Контейнер Из Элементы.грЭлементы.ПодчиненныеЭлементы Цикл
			Для Каждого Кнопка Из Контейнер.ПодчиненныеЭлементы Цикл
				Если Кнопка.Имя=Команда.Имя Тогда Продолжить КонецЕсли;
				Кнопка.ЦветФона=ЦветПасс;
				//Кнопка.ЦветРамки=ЦветРамки;//Цвет;
				//Кнопка.Шрифт=Новый Шрифт;
				СпЗн[ЭлементСпискаПоИмениКнопки(Кнопка.Имя)].Пометка=Ложь
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ЭлементСпискаПоИмениКнопки(Имя)
	Индекс=Число(Сред(Имя,3));
	Если Иерархия Тогда
		Инд=0;
		Для Н=0 По СпЗн.Количество()-1 Цикл
			ПодчСписок=СпЗн[Н].Значение;
			Если Инд+ПодчСписок.Количество()-1>=Индекс Тогда Возврат ПодчСписок[Индекс-Инд]
			Иначе Инд=Инд+ПодчСписок.Количество()	
			КонецЕсли
		КонецЦикла;
	Иначе
		Возврат СпЗн[Индекс]
	КонецЕсли;	
КонецФункции	

&НаКлиенте
Процедура кнОК(Команда)
	Массив=Новый Массив;
	Если Иерархия Тогда
		Для Каждого Эл Из СпЗн Цикл
			Для Каждого ПодчЭл Из Эл.Значение Цикл
				Если ПодчЭл.Пометка Тогда Массив.Добавить(ПодчЭл.Значение) КонецЕсли
			КонецЦикла	
		КонецЦикла;
	Иначе
		Для Каждого Эл Из СпЗн Цикл
			Если Эл.Пометка Тогда Массив.Добавить(Эл.Значение) КонецЕсли
		КонецЦикла;
	КонецЕсли;	
	Закрыть(Массив)
КонецПроцедуры

&НаКлиенте
Процедура кнВКЛ(Команда) ВклВыкл(Истина) КонецПроцедуры
&НаКлиенте
Процедура кнВЫКЛ(Команда) ВклВыкл(Ложь) КонецПроцедуры
Процедура ВклВыкл(Вкл)
	НЭлемента=0;
	Для Каждого Эл Из СпЗн Цикл
		Если Иерархия Тогда 
			Для Каждого ПодчЭл Из Эл.Значение Цикл
				ПодчЭл.Пометка=Вкл;
				ИмяКнопки="Зн"+Формат(НЭлемента,"ЧН=0;ЧГ=0");
				Элементы[ИмяКнопки].ЦветФона=?(ПодчЭл.Пометка,ЦветАктивный,ЦветПасс);
				НЭлемента=НЭлемента+1;
			КонецЦикла;	
		Иначе
			Эл.Пометка=Вкл;
			ИмяКнопки="Зн"+Формат(НЭлемента,"ЧН=0;ЧГ=0");
			Элементы[ИмяКнопки].ЦветФона=?(Эл.Пометка,ЦветАктивный,ЦветПасс);
			НЭлемента=НЭлемента+1;
		КонецЕсли;	
	КонецЦикла;		
КонецПроцедуры	

Функция СписокВыбора(спЗначений)
	Если Иерархия Тогда
		Сп=Новый СписокЗначений;
		
		Табл=Новый ТаблицаЗначений;
		Табл.Колонки.Добавить("Значение");
		Табл.Колонки.Добавить("Представление");
		Табл.Колонки.Добавить("Пометка");
		Табл.Колонки.Добавить("Картинка");
		Табл.Колонки.Добавить("Родитель");
		Для Каждого Эл Из спЗначений Цикл Стр=Табл.Добавить(); ЗаполнитьЗначенияСвойств(Стр,Эл); Стр.Родитель=Эл.Значение.Родитель КонецЦикла;
		
		ТабРодители=Табл.Скопировать(,"Родитель");
		ТабРодители.Свернуть("Родитель");
		Для Каждого Родитель Из ТабРодители.ВыгрузитьКолонку("Родитель") Цикл
			спЭл=Новый СписокЗначений;
			Для Каждого Эл Из Табл.НайтиСтроки(Новый Структура("Родитель",Родитель)) Цикл
				спЭл.Добавить(Эл.Значение,Эл.Представление,Эл.Пометка,Эл.Картинка);
			КонецЦикла;
			Сп.Добавить(спЭл,Строка(Родитель));
		КонецЦикла;	
		
		Возврат Сп
	Иначе Возврат спЗначений КонецЕсли 
КонецФункции	
Функция СписокВыбораПоСправочнику(ИмяСправочника,ТекущаяСсылка="",ОтборПоГруппе="")
	Сп=Новый СписокЗначений;
	ПолеСортировки=?(Метаданные.Справочники[ИмяСправочника].ДлинаНаименования>0,"Наименование","");
	
	Если ИмяСправочника="DMS_ВидыСобытий" Тогда
		ПолеСортировки="Порядок"
	Иначе
		ПолеСортировки=?(ПолеСортировки="" И Метаданные.Справочники[ИмяСправочника].Реквизиты.Количество()>0,Метаданные.Справочники[ИмяСправочника].Реквизиты[0].Имя,"Код");	
	КонецЕсли;	
	
	Если Иерархия Тогда
		ОтборГруппы=?(ОтборПоГруппе="",""," И Родитель В Иерархии(&Группа)");
		Запрос=Новый Запрос("Выбрать Ссылка,Родитель Из Справочник."+ИмяСправочника+" Где НЕ ЭтоГруппа"+ОтборГруппы+" И НЕ ПометкаУдаления Упорядочить По "+ПолеСортировки+" Итоги По Родитель");
		Запрос.УстановитьПараметр("Группа",ОтборПоГруппе);
		ВыборкаРодитель=Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Родитель");
		Пока ВыборкаРодитель.Следующий() Цикл
			спЭлементы=Новый СписокЗначений;
			Выборка=ВыборкаРодитель.Выбрать();
			Пока Выборка.Следующий() Цикл
				спЭлементы.Добавить(Выборка.Ссылка,""+Выборка.Ссылка,?(ТекущаяСсылка=Выборка.Ссылка,Истина,Ложь))
			КонецЦикла;	
			Сп.Добавить(спЭлементы,Строка(ВыборкаРодитель.Родитель));
		КонецЦикла;
	Иначе
		Запрос=Новый Запрос("Выбрать Ссылка Из Справочник."+ИмяСправочника+" Где НЕ ЭтоГруппа И НЕ ПометкаУдаления Упорядочить По "+ПолеСортировки);
		Для Каждого Эл Из Запрос.Выполнить().Выгрузить() Цикл Сп.Добавить(Эл.Ссылка,""+Эл.Ссылка,?(ТекущаяСсылка=Эл.Ссылка,Истина,Ложь)) КонецЦикла;
	КонецЕсли;	
	Возврат Сп
КонецФункции	
Функция СписокВыбораПоПеречислению(ИмяПеречисления,ТекущаяСсылка="")
	Сп=Новый СписокЗначений;
	Запрос=Новый Запрос("Выбрать Ссылка Из Перечисление."+ИмяПеречисления+" Упорядочить По Порядок");
	Для Каждого Эл Из Запрос.Выполнить().Выгрузить() Цикл Сп.Добавить(Эл.Ссылка,""+Эл.Ссылка,?(ТекущаяСсылка=Эл.Ссылка,Истина,Ложь)) КонецЦикла;
	Возврат Сп
КонецФункции	

//перенос текста
Функция ТекстЗаголовкаКнопки(ТекстКнопки,ВысотаЭлемента,ШиринаЭлемента)
	ДлинаСтр=СтрДлина(ТекстКнопки);
	Если ДлинаСтр<=ШиринаЭлемента Тогда Возврат ТекстКнопки КонецЕсли;
	
	//1. тупая функция переноса
	//СрДлинаСтр=Окр(ДлинаСтр/ВысотаЭлемента);
	//Для Н=1 По ВысотаЭлемента-1 Цикл
	//	Поз=СрДлинаСтр*Н;
	//	ТекстКнопки=Лев(ТекстКнопки,Поз)+Символы.ПС+Прав(ТекстКнопки,Поз)
	//КонецЦикла;	
	
	////2. перенос по словам
	//МассивСлов=СтрРазделить(ТекстКнопки," ",Ложь);
	//ТекстКнопки="";
	//Пока МассивСлов.Количество()>0 Цикл
	//	ТекстКнопки=ТекстКнопки+?(ТекстКнопки="","",Символы.ПС)+НаборСлов(МассивСлов,ШиринаЭлемента)
	//КонецЦикла;
	
	//3. перенос по слогам в будущем...
	
	//4. Концепция: переносим только первую строку, остальные переносятся автоматически
	ПерваяСтр="";
	МассивСлов=СтрРазделить(ТекстКнопки," ",Ложь);
	//ТекЭл=0;
	Для Каждого Стр Из МассивСлов Цикл
		ВариантПервойСтроки=ПерваяСтр+?(ПерваяСтр="","",Символы.НПП)+Стр;
		Если СтрДлина(ВариантПервойСтроки)>ШиринаЭлемента Тогда
