&НаСервере
Функция ВывестиРазделительВремени(ТабДок, ПромежуточныйИнтервалПланирования)
	
	//Выведем разделитель времени
	Если НачалоРабочегоДня < ТекущаяДата() И НЕ КонецРабочегоДня < ТекущаяДата() Тогда
		
		ОтступТекущееВремяЧас = Цел((ТекущаяДата() - НачалоРабочегоДня)/(3600)) * (60 / ШагПланирования) + 2;
		ОбластьИзменения = ТабДок.Область(1, ОтступТекущееВремяЧас, 1, ОтступТекущееВремяЧас + (60 / ШагПланирования));
		ОбластьИзменения.ЦветФона = Новый Цвет(255, 162, 123);
		
		ОтступТекущееВремяПромежуточный = Цел((ТекущаяДата() - НачалоРабочегоДня)/(ПромежуточныйИнтервалПланирования * 60)) * (ПромежуточныйИнтервалПланирования / ШагПланирования) + 2;
		ОбластьИзменения = ТабДок.Область(2, ОтступТекущееВремяПромежуточный, 2, ОтступТекущееВремяПромежуточный + (ПромежуточныйИнтервалПланирования / ШагПланирования));
		ОбластьИзменения.ЦветФона = Новый Цвет(255, 162, 123);
		
		ОтступТекущееВремя = Цел((ТекущаяДата() - НачалоРабочегоДня)/(ШагПланирования * 60)) + 3;
		ОбластьИзменения = ТабДок.Область(3, ОтступТекущееВремя, ТаблицаМашиномест.Количество()*3+2, ОтступТекущееВремя);
		ОбластьИзменения.ЦветФона = Новый Цвет(255, 162, 123);
		//ОбластьИзменения.ЦветРамки = СтруктураЦветов.КрасныйЦвет;
		//ОбластьИзменения.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
		//ОбластьИзменения.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		//ОбластьИзменения.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		//ОбластьИзменения.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		
		Возврат ОбластьИзменения;
		
	КонецЕсли;
	//...
	
КонецФункции

&НаСервереБезКонтекста
Функция Renault_СтруктураВТЗ(Структр) 
	
	
	ТЗ = Новый ТаблицаЗначений;
	
	
	ТЗ.Колонки.Добавить("Значение");
	
	
	ТЗ.Колонки.Добавить("Описание");
	
	
	Для Каждого ТекЭлем из Структр Цикл
		
		
		НовСтр=ТЗ.Добавить();
		
		
		НовСтр.Значение = ТекЭлем.Ключ;
		
		
		НовСтр.Описание = ТекЭлем.Значение; 
		
		
	КонецЦикла;
	
	
	Возврат ТЗ;
	
	
КонецФункции 

