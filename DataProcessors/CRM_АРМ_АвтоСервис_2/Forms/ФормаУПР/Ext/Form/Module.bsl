		АвтосервисНачалоРабочегоДня = СтрокаГрафика.НачалоРабочегоДня;
		АвтосервисКонецРабочегоДня = СтрокаГрафика.КонецРабочегоДня;
	Иначе
		АвтосервисНачалоРабочегоДня = '00010101080000';
		АвтосервисКонецРабочегоДня = '00010101220000';
	КонецЕсли;

	НачалоРабочегоДня = НачалоДня(ТекущаяДата()) + 3600 * Час(АвтосервисНачалоРабочегоДня) + 60 * Минута(АвтосервисНачалоРабочегоДня) + Секунда(АвтосервисНачалоРабочегоДня);
	КонецРабочегоДня = НачалоДня(ТекущаяДата()) + 3600 * Час(АвтосервисКонецРабочегоДня) + 60 * Минута(АвтосервисКонецРабочегоДня) + Секунда(АвтосервисКонецРабочегоДня);

	ШагПланирования = ?(Элементы.пвШагСетки.ТекстРедактирования="",0,Число(Элементы.пвШагСетки.ТекстРедактирования));
		
