		НадписьОжидание.Ширина = 190;
		НадписьОжидание.Верх = 170;
		НадписьОжидание.Высота = 20;
		НадписьОжидание.Заголовок = "Идет формирование графика";
	КонецЕсли;
	
	Если Элементы.Найти("КартинкаОжидание") = Неопределено Тогда
		КартинкаОжидание = Элементы.Добавить(Тип("ПолеКартинки"), "КартинкаОжидание", Истина, Элементы.Найти("ПанельОжидание"));
		КартинкаОжидание.Ширина = 190;
		КартинкаОжидание.Высота = 190;
		КартинкаОжидание.Картинка = Элементы.КартинкаОжиданиеПрототип.Картинка;
		КартинкаОжидание.РазмерКартинки = РазмерКартинки.АвтоРазмер;
	КонецЕсли;
	
	ЦентрироватьПанельПоЦентру("ПанельОжидание", "ПанельГрафик");
	
Конецпроцедуры

&НаКлиенте
Процедура КнопкаПоказатьАрхив(Команда)
	
	ПоказыватьАрхив = НЕ ПоказыватьАрхив;
	
	Если ПоказыватьАрхив Тогда
		Элементы.КнопкаПоказатьАрхив.Заголовок = "Факт";
	Иначе
		Элементы.КнопкаПоказатьАрхив.Заголовок = "Архив";
	КонецЕсли;
	
	СформироватьГрафикСОжиданием();

КонецПроцедуры

&НаКлиенте
Процедура КомандаОтображатьНеработающих(Команда)
	
	ТолькоРаботающие = НЕ ТолькоРаботающие;
	
	Если ТолькоРаботающие Тогда
		
		Элементы.ОтображатьНеработающих.Заголовок = "Отобразить всех";
		
	Иначе
		
		Элементы.ОтображатьНеработающих.Заголовок = "Только работающие";
		
	КонецЕсли;
	
	СформироватьГрафикСОжиданием();
	
	Если РежимСозданияОбращения = Истина Тогда
		
		//ОтрисоватьКнопкиМастеровПриемщиков();
		ОтрисоватьКнопкиМастеровПостов();
		
		ОбновитьДанныеПоСвободномуВремени(ТекущийЗаказНаряд.ОбщаяДлительность);
		ОбновитьДанныеПоСвободномуВремени(ТекущийЗаказНаряд.ОбщаяДлительность, Истина);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЦентрироватьПанельПоЦентру(ИмяПанели, ИмяПанелиРодитель)
	
	ПанельСдвиг = Элементы.Найти(ИмяПанели);
	ПанельРодитель = Элементы.Найти(ИмяПанелиРодитель);
	
	Если ПанельСдвиг = Неопределено ИЛИ ПанельРодитель = Неопределено Тогда
		
		Возврат;		
		
	КонецЕсли;
	
	ПанельСдвиг.Лево = (ПанельРодитель.Ширина - ПанельСдвиг.Ширина)/2;
	
	
Конецпроцедуры

