&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Дата1=НачалоМесяца(ТекущаяДата());
	Дата2=ТекущаяДата();
	УстановитьЗаголовок();

	ДилерскийЦентр=Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	Отдел=Renault_CRM.ПолучитьОтделАвтосалона();
	
	// Проверка на доступ к работе с АРМ
	Если НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмМенеджера(ПараметрыСеанса.Пользователь) тогда
		Сообщить("У вас нет прав на запуск АРМ");
		Отказ=Истина;
		Возврат
	КонецЕсли;
	
	//доступность закладок может регламентироваться правами, - соответстенно формируем список
	ПунктыМеню.Добавить("ГрафикЗаписи");
	ПунктыМеню.Добавить("СтраницаЖурналОбращений");
	ПунктыМеню.Добавить("Обращения");
	ПунктыМеню.Добавить("Докомплектация");
	ПунктыМеню.Добавить("МоиЗадачи");
	
	ТекущаяЗакладкаМеню=1;
	УстановитьПараметрыСписков();
	УстановитьОтбор();
	
	//ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СтруктураПрочихНастроек = ПолучитьПрочиеНастройки(ПараметрыСеанса.Пользователь);
    СтруктураЦветов         = ПолучитьСтруктуруЦветов(ПараметрыСеанса.Пользователь);
    СтруктураВысот          = ПолучитьСтруктуруВысот(ПараметрыСеанса.Пользователь);

	ТаблицаЗакраска = Новый ТаблицаЗначений();
	ТаблицаЗакраска.Колонки.Добавить("Цвет");
	ТаблицаЗакраска.Колонки.Добавить("Обращение", Документы.ТипВсеСсылки());
	ТаблицаЗакраска.Колонки.Добавить("РабочийДокумент");
	ТаблицаЗакраска.Колонки.Добавить("Цех");
	ТаблицаЗакраска.Колонки.Добавить("ВремяНачала");
	ТаблицаЗакраска.Колонки.Добавить("ВремяОкончания");
	ТаблицаЗакраска.Колонки.Добавить("Узор");
	ТаблицаЗакраска.Колонки.Добавить("Клиент");
	ТаблицаЗакраска.Колонки.Добавить("ЭтапРабот");
	ТаблицаЗакраска.Колонки.Добавить("ВремяНачалаРег");
	ТаблицаЗакраска.Колонки.Добавить("ВремяОкончанияРег");
	ТаблицаЗакраска.Колонки.Добавить("Статус");
	ТаблицаЗакраска.Колонки.Добавить("ТипПаузы");
	ТаблицаЗакраска.Индексы.Добавить("Обращение, РабочийДокумент, Цех");	

