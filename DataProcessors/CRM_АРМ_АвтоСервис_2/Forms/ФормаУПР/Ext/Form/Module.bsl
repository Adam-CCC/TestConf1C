&НаСервере
Процедура ЗаполнитьЗагрузкуНаМесяц(МастерПланирования = Ложь)
	
	Текущий_НачалоРабочегоДня = НачалоРабочегоДня;
	Текущий_КонецРабочегоДня = КонецРабочегоДня;
	Текущий_ТекущийРабочийДень = ТекущийРабочийДень;
	ТаблицаМашиноместТекДень = ТаблицаМашиномест;
	
	НачалоПериода = НачалоДня(ТекущийРабочийДень);
	КонецПериода = КонецДня(НачалоПериода + 12 * 24 * 60 * 60);
	
	Значения = Новый ТаблицаЗначений;
	МаксимальнаяТочка = 0;
	
	Значения =  Renault_АвтосервисПланирование.ПолучитьТаблицуЗанятостиИМаксимальнуюТочку(МаксимальнаяТочка, 
	ТекущийРабочийДень, ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, ВыделятьСебя,
	ТолькоРаботающие,ОтборМашиноместо,ОтборВидМашиноместа,ПараметрыСеанса.Пользователь.Сотрудник);
	
	НачалоРабочегоДня = Текущий_НачалоРабочегоДня;
	КонецРабочегоДня = Текущий_КонецРабочегоДня;
	ТекущийРабочийДень = Текущий_ТекущийРабочийДень;
	ТаблицаМашиномест = ТаблицаМашиноместТекДень;
	
	//МаксимальнаяТочка = ДилерскийЦентр.АвтосервисЦеха.Количество() * (КонецРабочегоДня - НачалоРабочегоДня)/3600;
	
	Если МастерПланирования Тогда
		
		Диаграмма = Элементы.ЗагрузкаНаМесяцМастер;
		Диаграмма.Рамка = Элементы.ПанельМастерПриемщикВерх.Рамка;
		Диаграмма.ЦветРамки = WebЦвета.Черный;
		
	Иначе
		
		Диаграмма = Элементы.ЗагрузкаНаМесяц;
		
	КонецЕсли;
	
	Диаграмма.Очистить();
	Диаграмма.МаксимальноеЗначение = МаксимальнаяТочка;
	//Диаграмма.ВидПодписей = ВидПодписейКДиаграмме.;
	
	Если МастерПланирования Тогда
		
		СерияЗагрузка = Диаграмма.Серии.Добавить("");
		СерияЗагрузка.Цвет = новый Цвет(255,182,0);
		
	Иначе
		
		СерияЗагрузка = Диаграмма.Серии.Добавить("Загрузка с " + Формат(НачалоПериода, "ДФ=дд.ММММ") + " по " + Формат(КонецПериода, "ДФ=дд.ММММ"));
		СерияЗагрузка.Цвет = новый Цвет(255,182,0);
		
	КонецЕсли;
	
	Индекс = НачалоПериода;
	
	Пока Индекс <= КонецПериода Цикл
		
		Поиск = Значения.Найти(Индекс, "ДеньМесяца");
		
		Если Поиск = Неопределено Тогда
			
			Значение = 0;
			
		Иначе
			
			Значение = Поиск.Длительность;
			
		КонецЕсли;
		
		Значение = 100* Значение/?(МаксимальнаяТочка <> 0, МаксимальнаяТочка, 1);
		
		НоваяТочка = Диаграмма.Точки.Добавить(Строка(СписокДнейНеделиСокр[ДеньНедели(Индекс)-1])+ " " + Формат(Индекс, "ДФ=dd.MM.yy"));
		Диаграмма.УстановитьЗначение(НоваяТочка, СерияЗагрузка, Значение, Строка(Значение));
		
		Индекс = Индекс+24*60*60;
		
	КонецЦикла;
	
	//Диаграмма.ВидПодписей = ВидПодписейКДиаграмме.Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура СпрятатьПанельОжидания()
	
	Поиск = Элементы.Найти("ПанельОжидание");
	
	Если Поиск <> Неопределено Тогда
		
		Элементы.Удалить(Поиск);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗакраситьОбласть(ТабДок, НомерПоста, ВремяНачала, ВремяОкончания, Цвет, Обращение = Неопределено, Узор = Неопределено, РабДокумент = Неопределено, Этап = Неопределено, Предварительно = Ложь, ТипПаузы = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ВремяНачала) ИЛИ НЕ ЗначениеЗаполнено(ВремяОкончания) Тогда
		Возврат;
	КонецЕсли;
	ЧасНачала = Час(ВремяНачала);
	МинутаНачала = Минута(ВремяНачала);
	
	ЧасОкончания = Час(ВремяОкончания);
	МинутаОкончания = Минута(ВремяОкончания);
	
	РазницаНачал = Час(НачалоРабочегоДня);
	РазницаМинут = Минута(НачалоРабочегоДня);
	
	//временно
	ИндексСтроки = 4 + (НомерПоста - 1) * 3;
	ИндексКолонкиНачала = 3 + (ЧасНачала - РазницаНачал)*(60/ШагПланирования) + Окр((МинутаНачала - РазницаМинут)/ШагПланирования);
	ИндексКолонкиОкончания = 2 + (ЧасОкончания - РазницаНачал)*(60/ШагПланирования) + Окр((МинутаОкончания - РазницаМинут)/ШагПланирования);
	
	Если ИндексКолонкиНачала < 3 Тогда
		
		ИндексКолонкиНачала = 3;
		
	КонецЕсли;
	
	Если ИндексКолонкиОкончания < 3 Тогда
		
		ИндексКолонкиОкончания = 3;
		
	КонецЕсли;
	
	Если ИндексКолонкиНачала > ИндексКолонкиОкончания Тогда
		
		ИндексКолонкиНачала = ИндексКолонкиОкончания;
		
	КонецЕсли;
	
	ОбластьИзменения = ТабДок.Область(ИндексСтроки, ИндексКолонкиНачала, ИндексСтроки + 1, ИндексКолонкиОкончания);
	ОбластьИзменения.АвтоВысотаСтроки = ЛОЖЬ;
	
	ОбластьИзменения.Объединить();
	
	Если ТекущееОбращение = Обращение Тогда
		
		ОбластьИзменения.ЦветРамки = СтруктураЦветов.КрасныйЦвет;
		
	КонецЕсли;
	
	ОбластьИзменения.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	ОбластьИзменения.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	ОбластьИзменения.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	ОбластьИзменения.ГраницаСлева = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	ОбластьИзменения.АвтоВысотаСтроки = ЛОЖЬ;
	
	Если ЗначениеЗаполнено(Обращение) Тогда
		
		Если ТипЗнч(Обращение) = Тип("ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис") Тогда
			
			СпецСимвол = "";
			СписокРабот = "";
			ПримечаниеНаКолбасе = Обращение.Примечание;
			НадписьНаКолбасе = "";
			
			Если ЗначениеЗаполнено(РабДокумент) Тогда
				
				Если ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
					
					СпецСимвол = "█"; 
					
				ИначеЕсли ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") Тогда
					
					СпецСимвол = "►";
					
				ИначеЕсли ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаСервис") Тогда
					
					СпецСимвол = "◙";
					
					Если ЗначениеЗаполнено(Этап) Тогда
						
						ЗапросЭтап = Новый Запрос();
						ЗапросЭтап.Текст = "ВЫБРАТЬ
						|	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.Работа
						|ИЗ
						|	Документ.Renault_CRM_ЗаявкаНаСервис.СоставЭтапа КАК Renault_CRM_ЗаявкаНаСервисСоставЭтапа
						|ГДЕ
						|	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDЭтапа = &IDЭтапа";
						
						ЗапросЭтап.УстановитьПараметр("IDЭтапа", Этап);
						
						Выборка = ЗапросЭтап.Выполнить().Выбрать();
						
						Пока Выборка.Следующий() Цикл
							
							НадписьНаКолбасе = НадписьНаКолбасе + "; " + Строка(Выборка.Работа);
							
						КонецЦикла;
						
						Если ЗначениеЗаполнено(ТипПаузы) Тогда
							
							НадписьНаКолбасе = "Приостановлено: " + Строка(ТипПаузы) + " "
							+ Строка(НадписьНаКолбасе);
							
						КонецЕсли;
						
					КонецЕсли;
					
				ИначеЕсли ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаМойку") Тогда
					
					СпецСимвол = "◊";
					
				КонецЕсли;
				
			КонецЕсли;
			
			Косяк = ЛОЖЬ;
			
			ОбластьИзменения.Расшифровка = Обращение;
			
			ГосНомерАвто = Renault_АвтосервисОбщий.Renault_ПолучитьГосНомер(Обращение.Автомобиль);
			
			Если ЗначениеЗаполнено(Обращение.Автомобиль) Тогда
			
				Если ЗначениеЗаполнено(ГосНомерАвто) Тогда
					
					ОбластьИзменения.Текст = СпецСимвол + " " + ВРег(Строка(Строка(ГосНомерАвто)) + " " + ВРег(Строка(Строка(Обращение.Автомобиль.Ссылка.Модель))) + " " + Строка(Обращение.Клиент)) + " " + НадписьНаКолбасе + " " + ПримечаниеНаКолбасе;
					
				Иначе
					
					ОбластьИзменения.Текст = СпецСимвол + " " + ВРег(Строка(Строка(Обращение.Автомобиль.Ссылка.Модель)) +  " " + Строка(Обращение.Клиент)) + " " + НадписьНаКолбасе + " " + ПримечаниеНаКолбасе;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОбластьИзменения.АвтоВысотаСтроки = ЛОЖЬ;
			ОбластьИзменения.Узор = ТипУзораТабличногоДокумента.Узор15;
			
			ОбычныйШрифт = ОбластьИзменения.Шрифт;
			ШрифтЖалобы = Новый Шрифт(ОбластьИзменения.Шрифт.Имя,ОбластьИзменения.Шрифт.Размер, ИСТИНА,ИСТИНА);
			
			Если Обращение.Жалоба Тогда
				
				ОбластьИзменения.Шрифт = ШрифтЖалобы;
				
			Иначе
				
				ОбластьИзменения.Шрифт = ОбычныйШрифт;
				
			КонецЕсли;
			
			Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
			//Рисунок.Картинка = Новый Картинка(БиблиотекаКартинок.CRM_ПустоеИзображение32.ПолучитьДвоичныеДанные(), Истина);
			//Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
			Рисунок.Текст = ОбластьИзменения.Текст;
			
			Если ТекущееОбращение = Обращение Тогда
				
				Рисунок.ЦветЛинии = СтруктураЦветов.КрасныйЦвет;
				Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 3);
				
			Иначе
				
				Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1);
				
			КонецЕсли;
			
			
			Рисунок.ЦветФона = Цвет;
			Расшифровочка = Новый Структура;
			Расшифровочка.Вставить("Ссылка", РабДокумент);
			Расшифровочка.Вставить("Длительность", (ВремяОкончания - ВремяНачала) / 3600);
			Если ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаСервис") Тогда
				Расшифровочка.Вставить("ВидСобытия", Перечисления.CRM_ВидыСобытийАвтоСервиса.ЗаявкаНаСервис);
			ИначеЕсли ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") Тогда
				Расшифровочка.Вставить("ВидСобытия", Перечисления.CRM_ВидыСобытийАвтоСервиса.ПриемкаАвто);
			ИначеЕсли ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
				Расшифровочка.Вставить("ВидСобытия", Перечисления.CRM_ВидыСобытийАвтоСервиса.ВыдачаАвто);
			ИначеЕсли ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаМойку") Тогда
				Расшифровочка.Вставить("ВидСобытия", Перечисления.CRM_ВидыСобытийАвтоСервиса.МойкаАвто);
			КонецЕсли;
			Расшифровочка.Вставить("ВремяНачала", ВремяНачала);
			Расшифровочка.Вставить("ВремяОкончания", ВремяОкончания);
			Расшифровочка.Вставить("НомерПоста", НомерПоста);
			Расшифровочка.Вставить("Владелец", "ТабличноеПолеСобытияКлиента");
			//Козлов Е.А. Начало 20.06.2016
			Расшифровочка.Вставить("Этап", Этап); 
			//Козлов Е.А. Конец
			//Расшифровочка.Добавить(РабДокумент);
			Рисунок.Расшифровка = Расшифровочка;
			Рисунок.Расположить(ОбластьИзменения);
			
		ИначеЕсли ТипЗнч(Обращение) = Тип("ДокументСсылка.Renault_CRM_АвтосервисОбед") Тогда
			
			ОбластьИзменения.Расшифровка = Обращение;
			ОбластьИзменения.Текст = "Обед";
			Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
			Рисунок.Картинка = БиблиотекаКартинок.Renault_Lunch_BW;
			Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
			Рисунок.Расшифровка = Обращение;
			Рисунок.Расположить(ОбластьИзменения);
			
		ИначеЕсли ТипЗнч(Обращение) = Тип("ДокументСсылка.Renault_CRM_АвтосервисПростой") Тогда
			
			ОбластьИзменения.Расшифровка = Обращение;
			ОбластьИзменения.Текст = "Простой: " + Строка(Обращение.ПричинаПростоя);
			Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
			Рисунок.Картинка = БиблиотекаКартинок.Renault_Pause;
			Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
			Рисунок.Расшифровка = Обращение;
			Рисунок.Расположить(ОбластьИзменения);
			
		ИначеЕсли ТипЗнч(Обращение) = Тип("ДокументСсылка.Renault_CRM_АвтосервисПрочаяЗанятость") Тогда
			
			ОбластьИзменения.Расшифровка = Обращение;
			ОбластьИзменения.Текст = "Прочая занятость: " + Строка(Обращение.ВидЗанятости);
			ОбластьИзменения.АвтоВысотаСтроки = ЛОЖЬ;
			
			Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
			Рисунок.Картинка = БиблиотекаКартинок.Renault_OtherWork;
			Рисунок.РазмерКартинки = РазмерКартинки.Пропорционально;
			Рисунок.Расшифровка = Обращение;
			Рисунок.Расположить(ОбластьИзменения);
			
		Иначе
			
			
		КонецЕсли;
	//Козлов Е.А. Начало 23.05.2016
	Иначе
		Если ТипЗнч(РабДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаПодменныйАвто") Тогда
			ОбластьИзменения.Текст = "Заявка на подменный авто. " +  " " + Строка(РабДокумент.Клиент);
			ОбластьИзменения.АвтоВысотаСтроки = ЛОЖЬ;
			ОбластьИзменения.Узор = ТипУзораТабличногоДокумента.Узор15;
			
			Рисунок = ТабДок.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Текст);
			Рисунок.Текст = ОбластьИзменения.Текст;
			Рисунок.ЦветФона = Цвет;
			Рисунок.Линия = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Пунктир, 2);
			
			Расшифровочка = Новый Структура;
			Расшифровочка.Вставить("Ссылка", РабДокумент);
			Расшифровочка.Вставить("Длительность", (ВремяОкончания - ВремяНачала) / 3600);
			Расшифровочка.Вставить("ВидСобытия", Перечисления.CRM_ВидыСобытийАвтоСервиса.ПодменныйАвто);
			Расшифровочка.Вставить("ВремяНачала", ВремяНачала);
			Расшифровочка.Вставить("ВремяОкончания", ВремяОкончания);
			Расшифровочка.Вставить("НомерПоста", НомерПоста);
			Расшифровочка.Вставить("Владелец", "ТабличноеПолеСобытияКлиента");
			
			Рисунок.Расшифровка = Расшифровочка;
			Рисунок.Расположить(ОбластьИзменения);
		КонецЕсли;				

	//Козлов Е.А. Конец
		
	КонецЕсли;
	//Сейчас я меняю параметры области, но может быть, удобнее присваивать этой области часть макета
	
	Если Косяк = Истина Тогда
		
		Цвет = WebЦвета.ТемноГрифельноСерый;
		ОбластьИзменения.Текст = "ВНИМАНИЕ! АВТОМОБИЛЬ УДАЛЕН ИЗ БД!";
		
	КонецЕсли;
	
	ОбластьИзменения.ЦветФона = Цвет;
	
	Если ЗначениеЗаполнено(Узор) Тогда
		ОбластьИзменения.Узор = УЗор;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНакладки(Начало, Конец, Цех, РабочийДокумент, ЭтапРабот, ГенерироватьСообщения = ИСТИНА) Экспорт
	
	Если ПроверятьНакладкиМастерПланирования = Ложь Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	//Проверка по всем работам в этом цеху	
	Возврат Renault_АвтосервисПланирование.ПроверитьНакладки(Начало, Конец, Цех, РабочийДокумент, ЭтапРабот, ДилерскийЦентр, ГенерироватьСообщения);
	
