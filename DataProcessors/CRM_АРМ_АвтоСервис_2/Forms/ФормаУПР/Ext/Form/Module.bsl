&НаКлиенте
Процедура СформироватьГрафикСОжиданием()
		
	Элементы.ПолеТабличногоДокумента.Видимость = Ложь;
	
	ВывестиПанельОжидания();
	
	ТаблицаМашиномест = ПолучитьТаблицуМашиномест();
	
	Если ДилерскийЦентр.Автосервис_АсинхронноеОбновлениеГрафика Тогда	
		ПолучитьДанныеПоГрафикуВФоне(ПоказыватьАрхив);	
	Иначе
		СформироватьГрафик();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуМашиномест()
	
	Возврат Renault_АвтосервисПланирование.ПолучитьТаблицуМашиномест(ДилерскийЦентр, НачалоРабочегоДня, КонецРабочегоДня, 
	ВыделятьСебя, ТолькоРаботающие, ОтборМашиноместо, ОтборВидМашиноместа, ПараметрыСеанса.Пользователь.Сотрудник, ТаблицаЗанятости);
	
КонецФункции

&НаСервереБезКонтекста
Функция ВернутьПользователяПоУмолчанию()
	Возврат ПараметрыСеанса.Пользователь;
КонецФункции
&НаКлиенте
Процедура ПолучитьДанныеПоГрафикуВФоне(ПросмотрАрхива = Ложь)
	
	ПараметрыВызоваСервера = Новый Структура;
	ПараметрыВызоваСервера.Вставить("ПросмотрАрхива",ПросмотрАрхива);
	ПараметрыВызоваСервера.Вставить("ДилерскийЦентр",ДилерскийЦентр);
	ПараметрыВызоваСервера.Вставить("НачалоРабочегоДня", НачалоРабочегоДня);
	ПараметрыВызоваСервера.Вставить("КонецРабочегоДня",КонецРабочегоДня);
	ПараметрыВызоваСервера.Вставить("ШагПланирования", ШагПланирования);
	ПараметрыВызоваСервера.Вставить("ТаблицаМашиномест",ТаблицаМашиномест);
	ПараметрыВызоваСервера.Вставить("НаправлениеЗакраскиЛевоПраво", НаправлениеЗакраскиЛевоПраво);
	ПараметрыВызоваСервера.Вставить("ПросмотрЦветовДругихПользователей",СтруктураПрочихНастроек.ПросмотрЦветовДругихПользователей);
	ПараметрыВызоваСервера.Вставить("ПользовательПоУмолчанию", ВернутьПользователяПоУмолчанию());
	
	РезультатПолученияДопИнформации = ВыполнитьЗапрос(ПараметрыВызоваСервера);
	Если РезультатПолученияДопИнформации.ФоновоеЗадание Тогда
		Renault_ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", 1, Истина);
		ФормаДлительнойОперации = Renault_ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);
	Иначе
		СформироватьГрафик();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьЗапрос(ПараметрыВызоваСервера)
	
	УникальныйИдентификатор = Новый УникальныйИдентификатор;
			
	РезультатФоновогоЗадания = Renault_ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"Renault_АвтосервисПланирование.ПолучитьТаблицуЗакраскиВФоне", ПараметрыВызоваСервера);
	
	Результат = Новый Структура;
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		Результат.Вставить("ФоновоеЗадание", Ложь);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	Иначе 
		Результат.Вставить("ФоновоеЗадание", Истина);
		Результат.Вставить("ФоновоеЗаданиеИдентификатор", РезультатФоновогоЗадания.ИдентификаторЗадания);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	КонецЕсли;
	Возврат Результат;
КонецФункции
&НаСервере
Функция ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень)
	
	Возврат Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень, Ложь)
	
КонецФункции


&НаКлиенте
Процедура СформироватьГрафик()
	
	Если ДилерскийЦентр.Автосервис_АсинхронноеОбновлениеГрафика Тогда
		ТаблицаЗакраскаВрем = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);		
	КонецЕсли;
	
	СписокЯчеек_Высота = Новый СписокЗначений;
	СписокЯчеек_Высота_Индекс = 0;
	СписокЯчеек_Ширина = Новый СписокЗначений;
	СписокЯчеек_Ширина_Индекс = 0;
	
	//Перенес на сервер
	////В эту таблицу все и запишем
	//ТаблицаЗакраска = Новый ТаблицаЗначений();
	//ТаблицаЗакраска.Колонки.Добавить("Цвет");
	//ТаблицаЗакраска.Колонки.Добавить("Обращение", Документы.ТипВсеСсылки());
	//ТаблицаЗакраска.Колонки.Добавить("РабочийДокумент");
	//ТаблицаЗакраска.Колонки.Добавить("Цех");
	//ТаблицаЗакраска.Колонки.Добавить("ВремяНачала");
	//ТаблицаЗакраска.Колонки.Добавить("ВремяОкончания");
	//ТаблицаЗакраска.Колонки.Добавить("Узор");
	//ТаблицаЗакраска.Колонки.Добавить("Клиент");
	//ТаблицаЗакраска.Колонки.Добавить("ЭтапРабот");
	//ТаблицаЗакраска.Колонки.Добавить("ВремяНачалаРег");
	//ТаблицаЗакраска.Колонки.Добавить("ВремяОкончанияРег");
	//ТаблицаЗакраска.Колонки.Добавить("Статус");
	//ТаблицаЗакраска.Колонки.Добавить("ТипПаузы");
	//ТаблицаЗакраска.Индексы.Добавить("Обращение, РабочийДокумент, Цех");	

	//Подготовка формы
	ПолеТабличногоДокумента.Очистить();
	ПолеТабличногоДокумента.ОтображатьЗаголовки = Ложь;
	ПолеТабличногоДокумента.ТолькоПросмотр = Истина;
	ПолеТабличногоДокумента.АвтоМасштаб = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущийРабочийДень)) Тогда
		Предупреждение("На данный день недели не назначен график работы!");
		Возврат;
	КонецЕсли;
	
	//Вывод шапки
	ОбластьШапка = ПолеТабличногоДокумента.ПолучитьОбласть("ШапкаВерх|Цеха");
	ПолеТабличногоДокумента.Вывести(ОбластьШапка);
	
	СписокЯчеек_Высота.Добавить(ОбластьШапка.Область("R1C2").ВысотаСтроки);
	СписокЯчеек_Ширина.Добавить(ОбластьШапка.Область("R1C1").ШиринаКолонки);
	СписокЯчеек_Ширина.Добавить(ОбластьШапка.Область("R1C2").ШиринаКолонки);
	
	//присоединим колонки рабочего дня
	ЧасНачалаДня = Час(НачалоРабочегоДня);
	МинутаНачалаДня = Минута(НачалоРабочегоДня);
	ЧасОкончанияДня = Час(КонецРабочегоДня);
	МинутаОкончанияДня = Минута(КонецРабочегоДня);
	ШаговПланирования = (КонецРабочегоДня - НачалоРабочегоДня) / (ШагПланирования * 60);
	
	ИндексПервойКолонкиЧаса = 1;
	Для ИндексИнтервалаПланирования = 1 ПО ШаговПланирования Цикл
		ОбластьШапкаШаг = ПолеТабличногоДокумента.ПолучитьОбласть("ШапкаВерх|Шаг");
		ТекущийЧасГрафика = Час(НачалоРабочегоДня + ИндексИнтервалаПланирования * ШагПланирования * 60);
		ОбластьШапкаШаг.Параметры.Час = ТекущийЧасГрафика;
		ПолеТабличногоДокумента.Присоединить(ОбластьШапкаШаг);
		
		СписокЯчеек_Ширина.Добавить(ОбластьШапкаШаг.Область("R1C1").ШиринаКолонки);
		
		Если Минута(НачалоРабочегоДня + ИндексИнтервалаПланирования * ШагПланирования * 60) = 0
			ИЛИ ИндексИнтервалаПланирования = ШаговПланирования Тогда
			ЭтоНовыйЧас = Истина;
			ОбластьЧас = ПолеТабличногоДокумента.Область("R1C" + Строка(ИндексПервойКолонкиЧаса + 2) + ":R1C" + Строка(ИндексИнтервалаПланирования + 2));
			ОбластьЧас.Объединить();
			ИндексПервойКолонкиЧаса = ИндексИнтервалаПланирования + 1;
		КонецЕсли;
	КонецЦикла;
	
	ОбластьШапка = ПолеТабличногоДокумента.ПолучитьОбласть("ШапкаНиз|Цеха");
	ПолеТабличногоДокумента.Вывести(ОбластьШапка);
	
	СписокЯчеек_Высота.Добавить(ОбластьШапка.Область("R1C2").ВысотаСтроки);
	
	ПолеТабличногоДокумента.Область(1,1,2,2).Объединить();
	
	//присоединим колонки рабочего дня
	
	//Пока топорно, упираясь на фиксированные шаги зададим промежуточные интервалы
	Если ШагПланирования = 5 Тогда
		ПромежуточныйИнтервалПланирования = 15;
	ИначеЕсли ШагПланирования = 6 Тогда
		ПромежуточныйИнтервалПланирования = 30;
	ИначеЕсли ШагПланирования = 10 Тогда
		ПромежуточныйИнтервалПланирования = 20;
	ИначеЕсли ШагПланирования = 12 Тогда
		ПромежуточныйИнтервалПланирования = 60;
	ИначеЕсли ШагПланирования = 15 Тогда
		ПромежуточныйИнтервалПланирования = 30;
	КонецЕсли;
	
	ИндексПервойКолонкиИнтервала = 1;
	Для ИндексИнтервалаПланирования = 1 ПО ШаговПланирования Цикл
		ОбластьШапкаШаг = ПолеТабличногоДокумента.ПолучитьОбласть("ШапкаНиз|Шаг");
		СтрокаПромежуточногоИнтервала = ":" + Строка(Цел(Минута(НачалоРабочегоДня + ИндексИнтервалаПланирования * ШагПланирования * 60) / ПромежуточныйИнтервалПланирования) * ПромежуточныйИнтервалПланирования);
		СтрокаПромежуточногоИнтервала = ?(СтрокаПромежуточногоИнтервала = ":0", ":00", СтрокаПромежуточногоИнтервала);
		ОбластьШапкаШаг.Параметры.ПромежуточныйШагПланирования = СтрокаПромежуточногоИнтервала;
		ПолеТабличногоДокумента.Присоединить(ОбластьШапкаШаг);
		Если Окр((Минута(НачалоРабочегоДня + ИндексИнтервалаПланирования * ШагПланирования * 60) / ПромежуточныйИнтервалПланирования)) = 
			(Минута(НачалоРабочегоДня + ИндексИнтервалаПланирования * ШагПланирования * 60) / ПромежуточныйИнтервалПланирования)
			ИЛИ ИндексИнтервалаПланирования = ШаговПланирования Тогда
			ЭтоНовыйИнтервал = Истина;
			ОбластьИнтервал = ПолеТабличногоДокумента.Область("R2C" + Строка(ИндексПервойКолонкиИнтервала + 2) + ":R2C" + Строка(ИндексИнтервалаПланирования + 2));
			ОбластьИнтервал.Объединить();
			ИндексПервойКолонкиИнтервала = ИндексИнтервалаПланирования + 1;
		КонецЕсли;
	КонецЦикла;
	
	//Получим список машиномест	
	КоличествоМашиномест = ТаблицаМашиномест.Количество();
	
	РазницаВремени = Час(КонецРабочегоДня) - Час(НачалоРабочегоДня);
	РазницаВремениСекунд = КонецРабочегоДня - НачалоРабочегоДня;
	//Выведем сетку по машиноместам
	Для Каждого Строка Из ТаблицаМашиномест Цикл
		Отб = Новый Структура();
		Отб.Вставить("Цех",Строка.Машиноместо);
		ОбщаяЗанятость= 0;
		Поиск = ТаблицаЗанятости.НайтиСтроки(Отб);
		Для Каждого Оп Из Поиск Цикл
			ОбщаяЗанятость = ОбщаяЗанятость + Оп.Длительность; 	
		КонецЦикла;

		Если Строка.ТЗ.Количество()>0 И Строка.ТЗ.Колонки.Найти("ДопДлительностьРабочегоДня") <> Неопределено Тогда
			ДлительностьРабочегоДня = Строка.ТЗ[0].ДопДлительностьРабочегоДня;
			РазницаВремениСекунд = ?(ДлительностьРабочегоДня = 0, РазницаВремениСекунд, ДлительностьРабочегоДня);
			РазницаВремени = РазницаВремениСекунд/60/60;			
			Свободно = РазницаВремениСекунд - ОбщаяЗанятость*3600;
			СвободныхЧасов = Цел(Свободно/3600);
			СвободныхМинут = Окр((Свободно - СвободныхЧасов*3600)/60, 0);
		Иначе
			
			РазницаВремени = Час(КонецРабочегоДня) - Час(НачалоРабочегоДня);
			РазницаВремениСекунд = КонецРабочегоДня - НачалоРабочегоДня;
			ДлительностьРабочегоДня = РазницаВремениСекунд;
			Свободно = РазницаВремениСекунд - ОбщаяЗанятость*3600;
			СвободныхЧасов = Цел(Свободно/3600);
			СвободныхМинут = Окр((Свободно - СвободныхЧасов*3600)/60, 0);
		КонецЕсли;
		
		Если Строка.ВидМашиноместа = 1 Тогда
			
			ОбластьСтрока = ПолеТабличногоДокумента.ПолучитьОбласть("СтрокаМойка|Цеха");
			
			ОбластьСтрока.Область("R2C1").ЦветФона = СтруктураЦветов.ЦветФонаМойка;
			ОбластьСтрока.Область("R2C1").ВысотаСтроки = СтруктураВысот.ВысотаСтрокиМойка;
			ОбластьСтрока.Параметры.ПараметрыРабочейТочки = Строка(Окр(ОбщаяЗанятость * 100 / РазницаВремени, 2)) + " %, " + Строка(СвободныхЧасов) + "ч. " + Строка(СвободныхМинут) + "мин." + " " + Строка.КоличествоОбращений + "авто.";
			ОбластьСтрока.Параметры.РабочаяТочка = Строка.Машиноместо;
			
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R1C2").ВысотаСтроки);
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R2C2").ВысотаСтроки);
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R3C2").ВысотаСтроки);
			
			ПолеТабличногоДокумента.Вывести(ОбластьСтрока);
			
			ИндексПервойКолонкиИнтервала = 1;
			Для ИндексИнтервалаПланирования = 1 ПО ШаговПланирования Цикл
				ОбластьСтрокаШаг = ПолеТабличногоДокумента.ПолучитьОбласть("СтрокаМойка|Шаг");
				Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2)
					= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2 Тогда
					
					ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = СтруктураЦветов.ЦветФонаМойкаПланирование;
					
				Иначе
					ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = Новый Цвет(255, 255, 255);
				КонецЕсли;
				ПолеТабличногоДокумента.Присоединить(ОбластьСтрокаШаг);
			КонецЦикла;
			
		ИначеЕсли Строка.ВидМашиноместа = 2 Тогда
			
			ОбластьСтрока = ПолеТабличногоДокумента.ПолучитьОбласть("СтрокаРемонт|Цеха");
			
			ОбластьСтрока.Область("R2C1").ЦветФона = СтруктураЦветов.ЦветФонаРемонт;
			ОбластьСтрока.Область("R2C1").ВысотаСтроки = СтруктураВысот.ВысотаСтрокиЦех;
			ОбластьСтрока.Параметры.ПараметрыРабочейТочки  = Строка(Окр(ОбщаяЗанятость * 100 / РазницаВремени, 2)) + " %, " + Строка(СвободныхЧасов) + "ч. " + Строка(СвободныхМинут) + "мин." + " " + Строка.КоличествоОбращений + "авто.";
			ОбластьСтрока.Параметры.РабочаяТочка = Строка.Машиноместо;
			
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R1C2").ВысотаСтроки);
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R2C2").ВысотаСтроки);
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R3C2").ВысотаСтроки);
			
			
			ПолеТабличногоДокумента.Вывести(ОбластьСтрока);
			
			ИндексПервойКолонкиИнтервала = 1;
			// - 10%
			ОбластьСтрокаШаг = ПолеТабличногоДокумента.ПолучитьОбласть("СтрокаРемонт|Шаг");
			Для ИндексИнтервалаПланирования = 1 ПО ШаговПланирования Цикл
				Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2)
					= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2 Тогда
					ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = СтруктураЦветов.ЦветФонаРемонтПланирование;
				Иначе
					ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = Новый Цвет(242, 245, 190);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Строка.ЦветФонаСтроки) Тогда
					
					ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = Renault_Открытый.ПолучитьЦветПоСтроке(Строка.ЦветФонаСтроки);
					
				КонецЕсли;
				
				ПолеТабличногоДокумента.Присоединить(ОбластьСтрокаШаг);
			КонецЦикла;
			
			Если ТолькоРаботающие И НЕ ДилерскийЦентр.Автосервис_НеИспользоватьГрафикЦехов Тогда
				
				НачалоРабот = НачалоРабочегоДня;
				Для Каждого СтрокаГрафика ИЗ Строка.ТЗ Цикл
					Если СтрокаГрафика.НачалоРаботы > НачалоРабот Тогда
						ПолеТабличногоДокумента.Область("R" + Строка(2+(Строка.НомерПоста-1)*3+2) + "C" + Строка((НачалоРабот - НачалоРабочегоДня)/(ШагПланирования*60)+3) + ":R" + Строка(2+(Строка.НомерПоста-1)*3+3) + "C" + Строка(ОКР((СтрокаГрафика.НачалоРаботы - НачалоРабочегоДня)/(ШагПланирования*60)+2,0))).Узор = ТипУзораТабличногоДокумента.Узор9;
					КонецЕсли;
					НачалоРабот = СтрокаГрафика.КонецРаботы;
				КонецЦикла;
				
				Если НачалоРабот < НачалоРабочегоДня Тогда
					
					НачалоРабот = НачалоРабочегоДня;
					
				КонецЕсли;
				
				Если НачалоРабот < КонецРабочегоДня Тогда
					ПолеТабличногоДокумента.Область("R" + Строка(2+(Строка.НомерПоста-1)*3+2) + "C" + Строка((НачалоРабот - НачалоРабочегоДня)/(ШагПланирования*60)+3) + ":R" + Строка(2+(Строка.НомерПоста-1)*3+3) + "C" + Строка((КонецРабочегоДня - НачалоРабочегоДня)/(ШагПланирования*60)+2)).Узор = ТипУзораТабличногоДокумента.Узор9;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли Строка.ВидМашиноместа = 0 Тогда
			
			ВремяПриемкиИВыдачи = ДлительностьПоУмолчаниюПриемкаОбычная + ДлительностьПоУмолчаниюВыдача;
			СтрокаКоличествоАвто =  Строка(Строка.КоличествоОбращений) +"/"+Строка(ДлительностьРабочегоДня / ВремяПриемкиИВыдачи) + " авто.";
			
			ОбластьСтрока = ПолеТабличногоДокумента.ПолучитьОбласть("СтрокаМастер|Цеха");
			ОбластьСтрока.Область("R2C1").ЦветФона = СтруктураЦветов.ЦветФонаМастера;
			ОбластьСтрока.Область("R2C1").ВысотаСтроки = СтруктураВысот.ВысотаСтрокиМастера;
			
			ОбластьСтрока.Параметры.ПараметрыРабочейТочки  = Строка(Окр(ОбщаяЗанятость * 100 / РазницаВремени, 2)) + " %, " + Строка(СвободныхЧасов) + "ч. " + Строка(СвободныхМинут) + "мин." + " " + СтрокаКоличествоАвто;
			ОбластьСтрока.Параметры.РабочаяТочка = Строка.Машиноместо;
			
			Занятость = (Окр(ОбщаяЗанятость * 100 / РазницаВремени, 2));
			
			Если Занятость >= 0 И Занятость <= 25 Тогда
				
				ЦветДи = Новый Цвет(154, 205, 50);
				
			ИначеЕсли Занятость >= 25 И Занятость <= 50 Тогда
				
				ЦветДи = Новый Цвет(34, 139, 34);
				
			ИначеЕсли Занятость >= 50 И Занятость <= 75 Тогда
				
				ЦветДи = Новый Цвет(255, 207, 0);
				
			ИначеЕсли Занятость >= 75 И Занятость <= 90 Тогда
				
				ЦветДи = Новый Цвет(255, 160, 122);
				
			ИначеЕсли Занятость >= 90 И Занятость <= 100 Тогда
				
				ЦветДи = Новый Цвет(139, 0, 0);
				
				
			ИначеЕсли Занятость > 100 Тогда
				
				ЦветДи = Новый Цвет(128, 0, 0);
				
			КонецЕсли;
			
			Диаграмма = ОбластьСтрока.Области.ГистограммаМастер.Объект;
			Диаграмма.Очистить();
			
			Диаграмма.АвтомаксимальноеЗначение = Ложь;
			Диаграмма.МаксимальноеЗначение = 100;
			
			Диаграмма.КоличествоСерий = 1; 
    		Диаграмма.КоличествоТочек = 1; 
			
			Диаграмма.Точки[0].Значение = 0;
			Диаграмма.Точки[0].Цвет = ЦветДи;
			
			Диаграмма.Серии[0].Значение = 0;
			Диаграмма.Серии[0].Цвет = ЦветДи;
			
			Диаграмма.УстановитьЗначение(0, 0, Занятость);
			
			
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R1C2").ВысотаСтроки);
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R2C2").ВысотаСтроки);
			СписокЯчеек_Высота.Добавить(ОбластьСтрока.Область("R3C2").ВысотаСтроки);			
			
			ПолеТабличногоДокумента.Вывести(ОбластьСтрока);
			
			ИндексПервойКолонкиИнтервала = 1;
			Для ИндексИнтервалаПланирования = 1 ПО ШаговПланирования Цикл
				ОбластьСтрокаШаг = ПолеТабличногоДокумента.ПолучитьОбласть("СтрокаМастер|Шаг");
				
				Если ДилерскийЦентр.ИспользоватьДополнительныеПараметрыСменыАвтосервиса Тогда
					СерединаИнтервала=НачалоРабочегоДня+(ИндексИнтервалаПланирования-1)*ШагПланирования*60+ШагПланирования/2*60;
					НачИнтервала=('00010101'+(ЧасНачалаДня*3600+МинутаНачалаДня*60))+(ИндексИнтервалаПланирования-1)*ШагПланирования*60;
					КонИнтервала=НачИнтервала+ШагПланирования*60;
					//текщий рабочий интервал
					ЕстьИнтервал=Ложь;
					Для Каждого СтрИнт Из Строка.ТЗ Цикл
						Если СтрИнт.НачалоРаботы<=СерединаИнтервала И СтрИнт.КонецРаботы>=СерединаИнтервала Тогда
							Для Каждого СтрДопИнт Из СтрИнт.ДопПарамСмены Цикл
								
								//определим меньший интервал и проверим его вхождение в больший
								Если ШагПланирования*60<СтрДопИнт.ВремяОкончания-СтрДопИнт.ВремяНачала Тогда
									Середина=НачИнтервала+ШагПланирования/2*60;
									Если СтрДопИнт.ВремяНачала<=Середина И СтрДопИнт.ВремяОкончания>=Середина Тогда
										ЕстьИнтервал=Истина;
										Прервать
									КонецЕсли;	
								Иначе
									Середина=СтрДопИнт.ВремяНачала+(СтрДопИнт.ВремяОкончания-СтрДопИнт.ВремяНачала)/2;
									Если НачИнтервала<=Середина И КонИнтервала>=Середина Тогда
										ЕстьИнтервал=Истина;
										Прервать
									КонецЕсли;	
								КонецЕсли;
								
							КонецЦикла;	
							Прервать
						КонецЕсли;	
					КонецЦикла;	
					
					Если ЕстьИнтервал Тогда
						ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона=СтруктураЦветов.ЦветФонаДополнительныхПараметровСменыАвтосервиса;//Новый Цвет(201,230,246);	
					Иначе
						Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2)
							= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2 Тогда
							ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = СтруктураЦветов.ЦветФонаМастераПланирование;
						Иначе
							ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = Новый Цвет(255, 255, 255);
						КонецЕсли;
					КонецЕсли;
					
				Иначе //без учета отметок регистра сведений Renault_ДополнительныеПараметрыСменыАвтосервиса
					
					Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2)
						= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-1) * ШагПланирования * 60) / 2 Тогда
						ОбластьСтрокаШаг.Область("R2C1:R3C1").ЦветФона = СтруктураЦветов.ЦветФонаМастераПланирование;
