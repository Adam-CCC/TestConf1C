	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ШагПланирования) Тогда
		ШагПланирования = СтруктураДЦ.АвтосервисШагПланирования;
	КонецЕсли;

	НаправлениеЗакраскиЛевоПраво = НЕ СтруктураПрочихНастроек.ОбратноеНаправлениеЗакраски;

	ТекущийРабочийДень = ТекущаяДата();

	ДлительностьПоУмолчаниюМойка = 600;
	
	Если НЕ ЗначениеЗаполнено(СтруктураДЦ.ДлительностьПриемки) Тогда	
		ДлительностьПоУмолчаниюПриемкаОбычная = 1200;	
	Иначе		
		ДлительностьПоУмолчаниюПриемкаОбычная = СтруктураДЦ.ДлительностьПриемки*60;		
	КонецЕсли;
	
	ДлительностьПоУмолчаниюПриемка = ДлительностьПоУмолчаниюПриемкаОбычная;
		
	Если НЕ ЗначениеЗаполнено(СтруктураДЦ.Автосервис_ДлительностьПрямойПриемки) Тогда
