&НаСервере
Процедура ОбновитьДанныеПоСвободномуВремени(Длительность, Предварительно = ЛОЖЬ)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Исключать", Истина);
	
	МассивПриемщиковПодИсключение = ТаблицаСоответствияМастеровПриемщиков.НайтиСтроки(Отбор);
	МассивПостовПодИсключение = ТаблицаСоответствияПостов.НайтиСтроки(Отбор);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Исключать", Ложь);
	
	МассивПриемщиков = ТаблицаСоответствияМастеровПриемщиков.НайтиСтроки(Отбор);
	МассивПостов = ТаблицаСоответствияПостов.НайтиСтроки(Отбор);
	
	//Если Предварительно = Истина Тогда
	Для Каждого Строка ИЗ ТаблицаСвободногоВремениПредварительная Цикл
		УдалитьЗакраскуОбласти(Строка.ВыделенныеОбласти, Строка.Цех);
		Строка.ВыделенныеОбласти = "";
	КонецЦикла;
	ТаблицаСвободногоВремениПредварительная.Очистить();
	//Иначе
	Для Каждого Строка ИЗ ТаблицаСвободногоВремени Цикл
		УдалитьЗакраскуОбласти(Строка.ВыделенныеОбласти, Строка.Цех);
		Строка.ВыделенныеОбласти = "";
	КонецЦикла;
	ТаблицаСвободногоВремени.Очистить();
	//КонецЕсли;
	
	//ТаблицаСвободногоВремени_Общая = ПолучитьДоступноеВремяДляПланирования(ТекущийЗаказНаряд.ОбщаяДлительность, МассивПриемщиков, МассивПостов);
	ТаблицаСвободногоВремени_Общая = ПолучитьСвободныеВременаНаПостах(Длительность, МассивПриемщиков, МассивПостов);
	
	ТаблицаСвободногоВремени_Общая.Сортировать("ВремяНачала Возр");
	
	Для Каждого Строка ИЗ ТаблицаСвободногоВремени_Общая Цикл
		Для Каждого ЭлементМассива ИЗ МассивПостов Цикл
			Если ЭлементМассива.Значение = Строка.Цех Тогда
				//Если Предварительно = Истина Тогда
				НоваяСтрока = ТаблицаСвободногоВремениПредварительная.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				//Иначе
				НоваяСтрока = ТаблицаСвободногоВремени.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				//КонецЕсли;
				//ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//ОбновитьОптимальноеВремя();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСвободныеВременаНаПостах(Длительность, СписокПриемщиков, СписокПостов, ВремяНачалаПланирования = Неопределено)
	
	НужнаПриемкаВыдача = ВидОбращения.БезПриемкиИВыдачи;
	
	ТаблицаСвободноеВремя = Новый ТаблицаЗначений;
	ТаблицаСвободноеВремя.Колонки.Добавить("ВремяНачала");
	ТаблицаСвободноеВремя.Колонки.Добавить("ВремяОкончания");
	ТаблицаСвободноеВремя.Колонки.Добавить("Цех");
	ТаблицаСвободноеВремя.Колонки.Добавить("ЦехПредставление");
	ТаблицаСвободноеВремя.Колонки.Добавить("ВыделенныеОбласти");
	ТаблицаСвободноеВремя.Колонки.Добавить("СвободноВсего");
	
	ТаблицаСвободноеВремя.Индексы.Добавить("Цех, ВремяНачала, ВремяОкончания, ВыделенныеОбласти");
	
	Если НачалоДня(НачалоРабочегоДня) < НачалоДня(ТекущаяДата()) Тогда
		Возврат ТаблицаСвободноеВремя;
	КонецЕсли;
	
	РазрывВПриемкахВыдачах = ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60;
	РазрывНаПостах = ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
	
	МаксимальноеВремяНачалаПриемки = '00010101';
	ДопустимаяДлительность = ДилерскийЦентр.Автосервис_МаксимальнаяДлительностьРаботПослеОкончанияПриема;
	Если ЗначениеЗаполнено(ДилерскийЦентр.Автосервис_ЧасовНедоступныхДляПриема) Тогда
		// Если длительность работы превышает допустимую после окончания приема,
		// то надо сократить время окончания свободного для планирования периода
		Если (Число(Длительность) > ДопустимаяДлительность ИЛИ ДопустимаяДлительность = 0) И Число(Длительность) + (ДлительностьПоУмолчаниюПриемка + ДлительностьПоУмолчаниюВыдача) / 3600 < ДилерскийЦентр.Автосервис_ЧасовНедоступныхДляПриема Тогда
			МаксимальноеВремяНачалаПриемки = КонецРабочегоДня - ДилерскийЦентр.Автосервис_ЧасовНедоступныхДляПриема * 3600;
		КонецЕсли;
		
		//Если ДилерскийЦентр.Автосервис_ЧасовНедоступныхДляПриема <ПолучитьИнтервальнуюДлительностьКолбасы(Длительность) + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюПриемка) + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюВыдача);
		
	КонецЕсли;
	
	ВремяСледующееЗаТекущим = НачалоРабочегоДня;
	
	Если ЖелаемоеВремяНачала <> Неопределено И ЗначениеЗаполнено(ЖелаемоеВремяНачала) 
		И НачалоДня(НачалоРабочегоДня) + ЧАС(ЖелаемоеВремяНачала)*3600 + Минута(ЖелаемоеВремяНачала) * 60 > ТекущаяДата()  Тогда
		
		ВремяСледующееЗаТекущим = НачалоДня(НачалоРабочегоДня)  + ЧАС(ЖелаемоеВремяНачала)*3600 + Минута(ЖелаемоеВремяНачала) * 60;
		
	КонецЕсли;
	
	Пока ВремяСледующееЗаТекущим <= ТекущаяДата() + ШагПланирования * 60 Цикл
		ВремяСледующееЗаТекущим = ВремяСледующееЗаТекущим + ШагПланирования * 60;
	КонецЦикла;
	
	ДлительностьПоУмолчаниюПриемка_Интервальная = 0;
	ДлительностьПоУмолчаниюВыдача_Интервальная = 0;
	//ДлительностьПоУмолчаниюПриемка_Интервальная = ДлительностьПоУмолчаниюПриемка / (ШагПланирования * 60);
	//Если Цел(ДлительностьПоУмолчаниюПриемка_Интервальная) <> ДлительностьПоУмолчаниюПриемка_Интервальная Тогда
	//	ДлительностьПоУмолчаниюПриемка_Интервальная = Цел(ДлительностьПоУмолчаниюПриемка_Интервальная) + 1;
	//КонецЕсли;
	//
	//ДлительностьПоУмолчаниюВыдача_Интервальная = ДлительностьПоУмолчаниюВыдача / (ШагПланирования * 60);
	//Если Цел(ДлительностьПоУмолчаниюВыдача_Интервальная) <> ДлительностьПоУмолчаниюВыдача_Интервальная Тогда
	//	ДлительностьПоУмолчаниюВыдача_Интервальная = Цел(ДлительностьПоУмолчаниюВыдача_Интервальная) + 1;
	//КонецЕсли;
	
	СписокЦехов = Новый СписокЗначений;
	СписокЦехов.ТипЗначения = Новый ОписаниеТипов("Число");
	
	Список_Мастера = Новый СписокЗначений;
	Список_Мастера.ТипЗначения = Новый ОписаниеТипов("Число");
	
	Список_Цеха = Новый СписокЗначений;
	Список_Цеха.ТипЗначения = Новый ОписаниеТипов("Число");
	
	ТаблицаЗакраска_Временная = ТаблицаЗакраска.Скопировать();
	
	Если НачалоРабочегоДня > ВремяСледующееЗаТекущим Тогда
		ВремяНачалаПланирования = НачалоРабочегоДня;
	Иначе
		ВремяНачалаПланирования = ВремяСледующееЗаТекущим;
	КонецЕсли;
	
	СписокЗнач = Новый СписокЗначений;
	СписокЗнач.ЗагрузитьЗначения(СписокПостов);
	ВсеПосты = СписокЗнач.ВыгрузитьЗначения();
	
	Для Каждого Приемщик ИЗ СписокПриемщиков Цикл
		
		ВсеПосты.Добавить(Приемщик);
		
	КонецЦикла;
	
	//ВсеПосты = ТаблицаЗакраска_Временная.Скопировать();
	////ВсеПосты.Свернуть("Цех");
	
	ТаблицаЗакраска_Временная.Сортировать("ВремяНачала Возр");
	
	//Нкжно получить длительности	
	Для Каждого Пост ИЗ ВсеПосты Цикл
		
		// вставлено
		// получение ВремяНачалаПланирования для каждого поста
		Если НачалоРабочегоДня > ВремяСледующееЗаТекущим Тогда
			ВремяНачалаПланирования = НачалоРабочегоДня;
		Иначе
			ВремяНачалаПланирования = ВремяСледующееЗаТекущим;
		КонецЕсли;
		//вставлено
		
		Отбор = Новый Структура;
		Отбор.Вставить("Цех", Пост.Значение);
		
		СтрокиТаблицы = ТаблицаЗакраска_Временная.НайтиСтроки(Отбор);
		
		ВремяОкончанияПопытка = Неопределено;
		
		ВсегоСтрок = СтрокиТаблицы.Количество();
		
		Индекс = 0;
		
		ЦехСтрока = ТаблицаМашиномест.Найти(Пост.Значение, "НомерПоста");
		
		Если ЦехСтрока = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		// Вставим проверку по графику работ
		Если  ТолькоРаботающие Тогда
			ТабГрафик = ЦехСтрока.ТЗ;
			
			Если ТабГрафик = Неопределено ТОгда
				
				Продолжить;
				
			КонецЕсли;
			
			Если ТабГрафик.Количество() = 0 Тогда
				Продолжить;
			Иначе
				МассивДат = ТабГрафик.ВыгрузитьКолонку("НачалоРабочегоВремени");
				НаименьшееВремя = МассивДат[0];
				Для Каждого Элемент ИЗ МассивДат Цикл
					Если Элемент < НаименьшееВремя Тогда
						НаименьшееВремя = Элемент;
					КонецЕсли;
				КонецЦикла;
				МассивДат = ТабГрафик.ВыгрузитьКолонку("КонецРабочегоВремени");
				НаибольшееВремя = МассивДат[0];
				Для Каждого Элемент ИЗ МассивДат Цикл
					Если Элемент > НаибольшееВремя Тогда
						НаибольшееВремя = Элемент;
					КонецЕсли;
				КонецЦикла;
				ВремяНачалаПоГрафику = ТабГрафик[0].Дата + (НаименьшееВремя - '00010101');
				ВремяНачалаПланирования = Макс(ВремяНачалаПланирования, ВремяНачалаПоГрафику);
				ВремяОкончанияПоГрафику = ТабГрафик[0].Дата + (НаибольшееВремя - '00010101');
				Если ВремяНачалаПланирования >= ВремяОкончанияПоГрафику Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			ВремяНачалаПоГрафику = НачалоРабочегоДня;
			
			Если ЗначениеЗаполнено(МаксимальноеВремяНачалаПриемки) Тогда
				ВремяНач = (МаксимальноеВремяНачалаПриемки - ТекущийРабочийДень) / (ШагПланирования * 60);
				Если Цел(ВремяНач) <> ВремяНач Тогда
					ВремяНач = (Цел(ВремяНач) + 1) * (ШагПланирования * 60);
				Иначе
					ВремяНач = МаксимальноеВремяНачалаПриемки;
				КонецЕсли;
				ВремяОкончанияПоГрафику = ВремяНач + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюПриемка) + ПолучитьИнтервальнуюДлительностьКолбасы(Число(Длительность) * 3600) + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюВыдача);
			Иначе
				ВремяОкончанияПоГрафику = КонецРабочегоДня;
			КонецЕсли;
			
		КонецЕсли;
		
		ВремяНачалаПлан = ВремяНачалаПланирования;
		
		Если ТипЗнч(ЦехСтрока.Машиноместо) = Тип("СправочникСсылка.Сотрудники") Тогда
			
			ДлительностьДляПланирования = ДлительностьПоУмолчаниюПриемка;
			
			НужнаПриемка = Ложь;
			
		ИначеЕсли ТипЗнч(ЦехСтрока.Машиноместо) = Тип("СправочникСсылка.Цеха") Тогда
			
			ДлительностьДляПланирования = Длительность*60*60;
			
			Если НужнаПриемкаВыдача = Истина Тогда
				
				НужнаПриемка = Истина;
				
			Иначе
				
				НужнаПриемка = Ложь;
				
			КонецЕсли;
			
			//ВремяНачалаПлан = ВремяНачалаПланирования + ДлительностьПоУмолчаниюПриемка_Интервальная * ШагПланирования * 60;
			//ВремяНачалаПлан = ВремяНачалаПланирования + ДлительностьПоУмолчаниюПриемка;
			
		КонецЕсли;
		
		Если ВсегоСтрок = 0 Тогда
			
			НоваяСтрока = ТаблицаСвободноеВремя.Добавить();
			
			НоваяСтрока.ВремяНачала = ВремяНачалаПлан;
			НоваяСтрока.ВремяОкончания = ВремяОкончанияПоГрафику;
			НоваяСтрока.ЦехПредставление = ЦехСтрока.Машиноместо;
			НоваяСтрока.Цех = ЦехСтрока.НомерПоста;
			
			Продолжить;
			
		КонецЕсли;
		
		Пока Индекс <= ВсегоСтрок Цикл
			
			Если Индекс = 0 И ВсегоСтрок > 1 Тогда
				
				Если СтрокиТаблицы[Индекс].ВремяНачала > ВремяНачалаПлан + ДлительностьДляПланирования  Тогда
					
					НоваяСтрока = ТаблицаСвободноеВремя.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиТаблицы[Индекс]);
					
					НоваяСтрока.ВремяНачала = ВремяНачалаПлан;
					ИнтервальноеВремяОконания = (СтрокиТаблицы[Индекс].ВремяНачала - НачалоРабочегоДня) / (ШагПланирования * 60);
					Если Цел(ИнтервальноеВремяОконания) < ИнтервальноеВремяОконания Тогда
						ИнтервальноеВремяОконания = ИнтервальноеВремяОконания + 1;
					КонецЕсли;
					НоваяСтрока.ВремяОкончания = НачалоРабочегоДня + ИнтервальноеВремяОконания * ШагПланирования * 60;
					//НоваяСтрока.ВремяОкончания = СтрокиТаблицы[Индекс].ВремяНачала;
					НоваяСтрока.ЦехПредставление = ЦехСтрока.Машиноместо;
					
				КонецЕсли;
				
			ИначеЕсли Индекс = 0 И ВсегоСтрок = 1 Тогда
				
				Если СтрокиТаблицы[Индекс].ВремяНачала > ВремяНачалаПлан + ДлительностьДляПланирования + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюПриемка) Тогда
					
					НоваяСтрока = ТаблицаСвободноеВремя.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиТаблицы[Индекс]);
					
					НоваяСтрока.ВремяНачала = ВремяНачалаПлан;
					ИнтервальноеВремяОконания = (СтрокиТаблицы[Индекс].ВремяНачала - НачалоРабочегоДня) / (ШагПланирования * 60);
					Если Цел(ИнтервальноеВремяОконания) < ИнтервальноеВремяОконания Тогда
						ИнтервальноеВремяОконания = ИнтервальноеВремяОконания + 1;
					КонецЕсли;
					
					НоваяСтрока.ВремяОкончания = НачалоРабочегоДня + ИнтервальноеВремяОконания * ШагПланирования * 60 - ?(НужнаПриемка = Истина, ПолучитьИнтервальнуюДлительностьКолбасы(РазрывНаПостах), ПолучитьИнтервальнуюДлительностьКолбасы(РазрывВПриемкахВыдачах));
					//НоваяСтрока.ВремяОкончания = СтрокиТаблицы[Индекс].ВремяНачала;
					НоваяСтрока.ЦехПредставление = ЦехСтрока.Машиноместо;
					
				КонецЕсли;
				
				Если СтрокиТаблицы[Индекс].ВремяОкончания + ДлительностьДляПланирования < ВремяОкончанияПоГрафику - ДлительностьПоУмолчаниюВыдача Тогда
					
					НоваяСтрока = ТаблицаСвободноеВремя.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиТаблицы[Индекс]);
					
					ИнтерваловСНачалаДня = (СтрокиТаблицы[Индекс].ВремяОкончания - НачалоРабочегоДня) / (ШагПланирования * 60);
					Если Цел(ИнтерваловСНачалаДня) <> ИнтерваловСНачалаДня Тогда
						ИнтерваловСначалаДня = Цел(ИнтерваловСНачалаДня) + 1;
					КонецЕсли;
					ИнтервальноеВремяОконания = НачалоРабочегоДня + ИнтерваловСНачалаДня * ШагПланирования *60;
					
					Если НужнаПриемка Тогда
						НоваяСтрока.ВремяНачала = Макс(ИнтервальноеВремяОконания + РазрывНаПостах, ВремяНачалаПланирования);// + ДлительностьПоУмолчаниюПриемка_Интервальная * ШагПланирования * 60);
					Иначе
						НоваяСтрока.ВремяНачала = Макс(ИнтервальноеВремяОконания + РазрывВПриемкахВыдачах, ВремяНачалаПланирования);
					КонецЕсли;
					НоваяСтрока.ВремяОкончания = ВремяОкончанияПоГрафику;// + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюВыдача);
					НоваяСтрока.ЦехПредставление = ЦехСтрока.Машиноместо;
					
				КонецЕсли;
				
			ИначеЕсли Индекс < ВсегоСтрок Тогда
				
				Если СтрокиТаблицы[Индекс-1].ВремяОкончания + ДлительностьДляПланирования < СтрокиТаблицы[Индекс].ВремяНачала
					И (СтрокиТаблицы[Индекс-1].ВремяОкончания >= ВремяНачалаПланирования ИЛИ СтрокиТаблицы[Индекс].ВремяНачала >= ВремяНачалаПланирования) Тогда
					
					НоваяСтрока = ТаблицаСвободноеВремя.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиТаблицы[Индекс]);
					
					//НоваяСтрока.ВремяНачала = Макс(СтрокиТаблицы[Индекс-1].ВремяОкончания + РазрывВПриемкахВыдачах, ВремяНачалаПланирования + ДлительностьПоУмолчаниюПриемка_Интервальная * ШагПланирования * 60);
					Если НЕ НужнаПриемка Тогда
						НоваяСтрока.ВремяНачала = Макс(СтрокиТаблицы[Индекс-1].ВремяОкончания + РазрывВПриемкахВыдачах, ВремяНачалаПланирования);
					Иначе
						НоваяСтрока.ВремяНачала = Макс(СтрокиТаблицы[Индекс-1].ВремяОкончания, ВремяНачалаПланирования + ДлительностьПоУмолчаниюПриемка_Интервальная * ШагПланирования * 60);
					КонецЕсли;
					НоваяСтрока.ВремяОкончания = СтрокиТаблицы[Индекс].ВремяНачала - РазрывВПриемкахВыдачах;
					НоваяСтрока.ЦехПредставление = ЦехСтрока.Машиноместо;
					
				КонецЕсли;
				
				//Это последняя строка
				//ИначеЕсли Индекс = ВсегоСтрок Тогда
			ИначеЕсли Индекс = ВсегоСтрок И ВсегоСтрок <> 1 Тогда
				
				Если СтрокиТаблицы[Индекс-1].ВремяОкончания + ДлительностьДляПланирования < ВремяОкончанияПоГрафику Тогда
					
					НоваяСтрока = ТаблицаСвободноеВремя.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокиТаблицы[Индекс-1]);
					
					//Если СтрокиТаблицы[Индекс-1].ВремяОкончания < ВремяНачалаПлан Тогда
					//	
					//	НоваяСтрока.ВремяНачала = ВремяНачалаПлан;
					//	
					//Иначе
					//
					Если НЕ НужнаПриемка Тогда
						НоваяСтрока.ВремяНачала = Макс(СтрокиТаблицы[Индекс-1].ВремяОкончания + РазрывВПриемкахВыдачах, ВремяНачалаПланирования);
					Иначе
						НоваяСтрока.ВремяНачала = Макс(СтрокиТаблицы[Индекс-1].ВремяОкончания, ВремяНачалаПланирования + ДлительностьПоУмолчаниюПриемка_Интервальная * ШагПланирования * 60);
					КонецЕсли;
					
					//КонецЕсли;
					
					НоваяСтрока.ВремяОкончания = ВремяОкончанияПоГрафику;
					НоваяСтрока.ЦехПредставление = ЦехСтрока.Машиноместо;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Индекс = Индекс + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого Строка из ТаблицаСвободноеВремя Цикл
		
		СтрокаПоста = ТаблицаМашиномест.Найти(Строка.Цех, "НомерПоста");
		Если СтрокаПоста <> Неопределено Тогда
			Если ТипЗнч(СтрокаПоста.Машиноместо) = Тип("СправочникСсылка.Цеха") Тогда
				ВремяНачалаДоОбработки = Строка.ВремяНачала;
				ВремяОкончанияДоОбработки = Строка.ВремяОкончания;
				Для Каждого СтрокаПоискаПриемщика ИЗ ТаблицаСвободноеВремя Цикл
					СтрокаПриемщика = ТаблицаМашиномест.Найти(СтрокаПоискаПриемщика.Цех, "НомерПоста");
					Если ТипЗнч(СтрокаПриемщика.Машиноместо) = Тип("СправочникСсылка.Сотрудники") Тогда
						Если СтрокаПоискаПриемщика.ВремяНачала + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюПриемка) <= ВремяНачалаДоОбработки Тогда
							Строка.ВремяНачала = Строка.ВремяНачала - ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюПриемка);
							Прервать;
						КонецЕсли;
						Если СтрокаПоискаПриемщика.ВремяОкончания - ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюВыдача) >= ВремяОкончанияДоОбработки Тогда
							Строка.ВремяОкончания = Строка.ВремяОкончания + ПолучитьИнтервальнуюДлительностьКолбасы(ДлительностьПоУмолчаниюВыдача);
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				// если не нашли свободных приемщиков
				Если Строка.ВремяНачала = ВремяНачалаДоОбработки Тогда
					МинимальноеВремяПриема = КонецРабочегоДня;
					Для Каждого СтрокаПоискаПриемщика ИЗ ТаблицаСвободноеВремя Цикл
						СтрокаПриемщика = ТаблицаМашиномест.Найти(СтрокаПоискаПриемщика.Цех, "НомерПоста");
						Если ТипЗнч(СтрокаПриемщика.Машиноместо) = Тип("СправочникСсылка.Сотрудники") Тогда
							Если СтрокаПоискаПриемщика.ВремяНачала < МинимальноеВремяПриема Тогда
								МинимальноеВремяПриема = СтрокаПоискаПриемщика.ВремяНачала;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					Строка.ВремяНачала = МинимальноеВремяПриема;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Строка из ТаблицаСвободноеВремя Цикл
		
		Строка.СвободноВсего = (Строка.ВремяОкончания - Строка.ВремяНачала)/3600; 
		
	КонецЦикла;
	
	Возврат ТаблицаСвободноеВремя;
	
КонецФункции


&НаСервере
Процедура УдалитьЗакраскуОбласти(Область, Цех)
	
	ПолеГрафик = Элементы.ПолеТабличногоДокумента;
	Макет = Обработки.CRM_АРМ_АвтоСервис_2.ПолучитьМакет("Макет");
	ОбластьМастер = Макет.ПолучитьОбласть("Шаг|СтрокаМастер").Область("R2C1:R3C1");
	ОбластьРемонт = Макет.ПолучитьОбласть("Шаг|СтрокаРемонт").Область("R2C1:R3C1");
	
	ВыделенныеОбласти = Область;
	Пока ВыделенныеОбласти <> "" Цикл
		
		Разделитель = Найти(ВыделенныеОбласти, ";");
		Если Разделитель <> 0 Тогда
			ИмяОбласти = Лев(ВыделенныеОбласти, Разделитель-1);
			ВыделенныеОбласти = Сред(ВыделенныеОбласти, Разделитель+1);
		Иначе
			ИмяОбласти = ВыделенныеОбласти;
			ВыделенныеОбласти = "";
		КонецЕсли;
		
		ПолеГрафик.Область(ИмяОбласти).Разъединить();
		
		Разделитель = Найти(ИмяОбласти, ":");
		Позиция = Найти(ИмяОбласти, "C");
		ИндексСтроки = Число(Сред(ИмяОбласти, 2, Позиция-2));
		Машиноместо = ПолеГрафик.Область("R" + ИндексСтроки + "C2").Расшифровка;
		Если Разделитель <> 0 Тогда
			КолонкаНачало = Число(Сред(ИмяОбласти, Позиция + 1, Разделитель - Позиция - 1));
			ИмяОбласти = Сред(ИмяОбласти, Разделитель + 1);
			Позиция = Найти(ИмяОбласти, "C");
			КолонкаКонец = Число(Сред(ИмяОбласти, Позиция + 1));
		Иначе
			КолонкаНачало = Число(Сред(ИмяОбласти, Позиция + 1));
			КолонкаКонец = Число(Сред(ИмяОбласти, Позиция + 1));
		КонецЕсли;
		
		Если ТаблицаМашиномест.Найти(Цех) = Неопределено Тогда
			
			Возврат;
			
		КонецЕсли;
		
		//Если ТаблицаМашиномест.Найти(Цех).ВидМашиноместа = 0 Тогда
		Если ТипЗнч(Машиноместо) = Тип("СправочникСсылка.Сотрудники") Тогда
			
			Для ИндексИнтервалаПланирования = КолонкаНачало ПО КолонкаКонец Цикл
				
				Ячейка = "R" + Формат(ИндексСтроки, "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=") + ":R" + Формат((ИндексСтроки + 1), "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=");
				
				ПолеГрафик.Область(Ячейка).Очистить();
				
				Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-3) * ШагПланирования * 60) / 2)
					= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-3) * ШагПланирования * 60) / 2 Тогда
					
					ПолеГрафик.ВставитьОбласть(ОбластьМастер, ПолеГрафик.Область(Ячейка));
					ПолеГрафик.Область(Ячейка).ЦветФона = СтруктураЦветов.ЦветФонаМастераПланирование;
					
				Иначе
					ПолеГрафик.ВставитьОбласть(ОбластьМастер, ПолеГрафик.Область(Ячейка));
					ПолеГрафик.Область(Ячейка).ЦветФона = Новый Цвет(255, 255, 255);
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ТаблицаМашиномест.Найти(Цех).ВидМашиноместа = 1 Тогда
			
			Для ИндексИнтервалаПланирования = КолонкаНачало ПО КолонкаКонец Цикл
				
				Ячейка = "R" + Формат(ИндексСтроки, "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=") + ":R" + Формат((ИндексСтроки + 1), "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=");
				
				ПолеГрафик.Область(Ячейка).Очистить();
				
				Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-2) * ШагПланирования * 60) / 2)
					= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-2) * ШагПланирования * 60) / 2 Тогда
					
					ПолеГрафик.Область(Ячейка).ЦветФона = СтруктураЦветов.ЦветФонаМойкаПланирование;
					
				Иначе
					ПолеГрафик.Область(Ячейка).ЦветФона = Новый Цвет(255, 255, 255);
				КонецЕсли;
				
			КонецЦикла;
			
			//ИначеЕсли ТаблицаМашиномест.Найти(Цех).ВидМашиноместа = 2 Тогда
		ИначеЕсли ТипЗнч(Машиноместо) = Тип("СправочникСсылка.Цеха") Тогда
			
			Для ИндексИнтервалаПланирования = КолонкаНачало ПО КолонкаКонец Цикл
				
				Ячейка = "R" + Формат(ИндексСтроки, "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=") + ":R" + Формат((ИндексСтроки + 1), "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=");
				
				ПолеГрафик.Область(Ячейка).Очистить();
				
				Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-3) * ШагПланирования * 60) / 2)
					= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-3) * ШагПланирования * 60) / 2 Тогда
					
					ПолеГрафик.ВставитьОбласть(ОбластьРемонт, ПолеГрафик.Область(Ячейка));
					ПолеГрафик.Область(Ячейка).ЦветФона = СтруктураЦветов.ЦветФонаРемонтПланирование;
					
				Иначе
					ПолеГрафик.ВставитьОбласть(ОбластьРемонт, ПолеГрафик.Область(Ячейка));
					ПолеГрафик.Область(Ячейка).ЦветФона = Новый Цвет(242, 245, 190);
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ТаблицаМашиномест.Найти(Цех).ВидМашиноместа = 4 Тогда
			
			Для ИндексИнтервалаПланирования = КолонкаНачало ПО КолонкаКонец Цикл
				
				Ячейка = "R" + Формат(ИндексСтроки, "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=") + ":R" + Формат((ИндексСтроки + 1), "ЧГ=") + "C" + Формат(ИндексИнтервалаПланирования, "ЧГ=");
								
				ПолеГрафик.Область(Ячейка).Очистить();
				
				Если Цел(Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-2) * ШагПланирования * 60) / 2)
					= Час(НачалоРабочегоДня + (ИндексИнтервалаПланирования-2) * ШагПланирования * 60) / 2 Тогда
					
					ПолеГрафик.Область(Ячейка).ЦветФона = Новый Цвет(245, 245, 245);
					
				Иначе
					ПолеГрафик.Область(Ячейка).ЦветФона = Новый Цвет(255, 255, 255);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура КнопкаПоказыватьВыделениеПоКлиентуНажатие(Команда)
	
	Если ВыделятьПоКлиенту Тогда
		ВыделятьПоКлиенту = Ложь;
		Элементы.КнопкаПоказыватьВыделениеПоКлиентуНажатие.Заголовок = "Выделить по клиенту";
	Иначе
		ВыделятьПоКлиенту = Истина;
		Элементы.КнопкаПоказыватьВыделениеПоКлиентуНажатие.Заголовок = "Снять выделение";
	КонецЕсли;
	СформироватьГрафикСОжиданием();

КонецПроцедуры


// Параметр - "Длительность". Указывает длительность интервала в секундах
&НаСервере
Функция ПолучитьИнтервальнуюДлительностьКолбасы(Длительность)
	
	Если Цел(Длительность / (ШагПланирования * 60)) = Длительность / (ШагПланирования * 60) Тогда
		Возврат Длительность;
	Иначе
		Возврат (Цел(Длительность / (ШагПланирования * 60)) + 1) * (ШагПланирования * 60);
	КонецЕсли;
	
КонецФункции
	

