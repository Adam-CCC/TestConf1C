&НаСервере
Функция ПолучитьЗаписьНастроекПользователя(ВхПользователь = Неопределено)Экспорт
	
	Запись = РегистрыСведений.Renault_ПользовательскиеНастройки.СоздатьМенеджерЗаписи();
	Если Не ВхПользователь = Неопределено тогда
		Запись.Пользователь = ВхПользователь;
		Запись.Прочитать();
	КонецЕсли;
	Возврат Запись;
	
КонецФункции

&НаСервере
Функция ПолучитьПрочиеНастройки(Пользователь = Неопределено) Экспорт
	
	СтруктураПрочихНастроек = Новый Структура;
	
	Если Не(Пользователь = Неопределено) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Renault_ПользовательскиеНастройки.ПросмотрЦветовДругихПользователей,
		               |	Renault_ПользовательскиеНастройки.ОбратноеНаправлениеЗакраски
		               |ИЗ
		               |	РегистрСведений.Renault_ПользовательскиеНастройки КАК Renault_ПользовательскиеНастройки
		               |ГДЕ
		               |	Renault_ПользовательскиеНастройки.Пользователь.Ссылка = &Пользователь";
					   
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Выгрузка = Запрос.Выполнить().Выгрузить();
		Если Выгрузка.Количество() = 0 Тогда
			Запрос.УстановитьПараметр("Пользователь", Справочники.Пользователи.ПустаяСсылка());
			Выгрузка = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
        Если Выгрузка.Количество()> 0 Тогда
			
			Мен = Выгрузка[0];
			Для Каждого Кол Из Выгрузка.Колонки ЦИкл
				СтруктураПрочихНастроек.Вставить(Кол.Имя, Мен[Кол.Имя]);
			КонецЦикла;
			
		Иначе
			
			СтруктураПрочихНастроек.Вставить("ПросмотрЦветовДругихПользователей", Ложь);
			СтруктураПрочихНастроек.Вставить("ОбратноеНаправлениеЗакраски", Ложь);
		
		КонецЕсли;

		
	Иначе
	
		СтруктураПрочихНастроек.Вставить("ПросмотрЦветовДругихПользователей", Ложь);
		СтруктураПрочихНастроек.Вставить("ОбратноеНаправлениеЗакраски", Ложь);
		
	КонецЕсли;
	
	Возврат СтруктураПрочихНастроек;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруВысот(Пользователь = Неопределено) Экспорт
	
	СтруктураВысот = Новый Структура;
	
	Если Не(Пользователь = Неопределено) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Renault_ПользовательскиеНастройки.ВысотаСтрокиМастера,
		               |	Renault_ПользовательскиеНастройки.ВысотаСтрокиЦех,
		               |	Renault_ПользовательскиеНастройки.ВысотаСтрокиМойка,
		               |	Renault_ПользовательскиеНастройки.ВысотаСтрокиПодменка
		               |ИЗ
		               |	РегистрСведений.Renault_ПользовательскиеНастройки КАК Renault_ПользовательскиеНастройки
		               |ГДЕ
		               |	Renault_ПользовательскиеНастройки.Пользователь.Ссылка = &Пользователь";
					   
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		Выгрузка = Запрос.Выполнить().Выгрузить();
		Если Выгрузка.Количество() = 0 Тогда
			Запрос.УстановитьПараметр("Пользователь", Справочники.Пользователи.ПустаяСсылка());
			Выгрузка = Запрос.Выполнить().Выгрузить();
		КонецЕсли;
        Если Выгрузка.Количество()> 0 Тогда
			
			Мен = Выгрузка[0];
			Для Каждого Кол Из Выгрузка.Колонки ЦИкл
				СтруктураВысот.Вставить(Кол.Имя, Мен[Кол.Имя]);
			КонецЦикла;
			
		Иначе
			
			СтруктураВысот.Вставить("ВысотаСтрокиМастера", 12);
			СтруктураВысот.Вставить("ВысотаСтрокиЦех", 20);
			СтруктураВысот.Вставить("ВысотаСтрокиМойка", 12);
			СтруктураВысот.Вставить("ВысотаСтрокиПодменка", 12);
		
		КонецЕсли;

		
	Иначе
	
		СтруктураВысот.Вставить("ВысотаСтрокиМастера", 12);
		СтруктураВысот.Вставить("ВысотаСтрокиЦех", 20);
		СтруктураВысот.Вставить("ВысотаСтрокиМойка", 12);
		СтруктураВысот.Вставить("ВысотаСтрокиПодменка", 12);
		
	КонецЕсли;
	
	Возврат СтруктураВысот;
		
КонецФункции

&НаСервере
Функция ВернутьСтрокуГрафикаРаботДилера();
	
	СтрокаГрафика = ДилерскийЦентр.АвтосервисГрафикРабот.Найти(ДеньНедели(ТекущаяДата()), "ДеньНедели");
	
	Если СтрокаГрафика = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Новый Структура("НачалоРабочегоДня,КонецРабочегоДня",СтрокаГрафика.НачалоРабочегоДня,СтрокаГрафика.КонецРабочегоДня);
	КонецЕсли;
 
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруДЦ(ДилерскийЦентр) Экспорт
	
	СтруктураДЦ = Новый Структура;
	СтруктураДЦ.Вставить("АвтосервисШагПланирования",ДилерскийЦентр.АвтосервисШагПланирования);
	СтруктураДЦ.Вставить("ДлительностьПриемки",ДилерскийЦентр.ДлительностьПриемки);
	СтруктураДЦ.Вставить("Автосервис_ДлительностьПрямойПриемки",ДилерскийЦентр.Автосервис_ДлительностьПрямойПриемки);
	СтруктураДЦ.Вставить("ДлительностьВыдачи",ДилерскийЦентр.ДлительностьВыдачи);
	
	Возврат СтруктураДЦ;
	
КонецФункции


