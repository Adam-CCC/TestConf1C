&НаСервере
Процедура НастройкаЦветовНаСервере()
	
	Запись = ПолучитьЗаписьНастроекПользователя(ПараметрыСеанса.Пользователь);
	Форм = РегистрыСведений.Renault_ПользовательскиеНастройки.ПолучитьФорму("ФормаЗаписиУпр");
	Если Запись.Выбран() Тогда
		КлючЗаписи = Новый Структура();
		КлючЗаписи.Вставить("Пользователь", Запись.Пользователь);
		МассивКлюча = Новый Массив;
		МассивКлюча.Добавить(КлючЗаписи);  //Дата("00010101000000"), Неопределено
		
		КлючЗаписиРегистра = Новый("РегистрСведенийКлючЗаписи.Renault_ПользовательскиеНастройки"
		, МассивКлюча);
		Отбор = Новый Структура("Ключ", КлючЗаписиРегистра);
		//Временно закоментировал
		//ОткрытьФормуМодально("РегистрСведений.Renault_ПользовательскиеНастройки.Форма.ФормаЗаписиУпр", Отбор);
	Иначе
		форм.Запись.Пользователь = ПараметрыСеанса.Пользователь;
		//Временно закоментировал
		//Форм.ОткрытьМодально();
	КонецЕсли;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СтруктураЦветов = ОбработкаОбъект.ПолучитьСтруктуруЦветов(ПараметрыСеанса.Пользователь);
	СтруктураВысот = ОбработкаОбъект.ПолучитьСтруктуруВысот(ПараметрыСеанса.Пользователь);
	СтруктураПрочихНастроек = ОбработкаОбъект.ПолучитьПрочиеНастройки(ПараметрыСеанса.Пользователь);
	
КонецПроцедуры

