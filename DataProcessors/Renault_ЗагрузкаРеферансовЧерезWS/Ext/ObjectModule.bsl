Перем Форма Экспорт;

Функция ПолучитьВебСервис() Экспорт
	
	ДанныеПодключения = Справочники.Renault_ПараметрыПодключенияКСервисам.ПолучитьПараметрыПодключенияПоСсылке(
		Справочники.Renault_ПараметрыПодключенияКСервисам.WSGate,
		"ReclamationsData.ws");
	Адрес = ДанныеПодключения.Адрес;
	ЛогинWS = ДанныеПодключения.Логин;
	ПарольWS = ДанныеПодключения.Пароль;
	
	WSОпределение = Новый WSОпределения(
		СокрЛП(Адрес),
		СокрЛП(ЛогинWS),
		СокрЛП(ПарольWS));
	ВебСервис = Новый WSПрокси(
		WSОпределение, 
		"http://renault-nissan.com/schema/nomen", 
		"Renault_ReclamationsData", 
		"Renault_ReclamationsDataSoap", 
		3600);
	ВебСервис.Пользователь = СокрЛП(ЛогинWS);
	ВебСервис.Пароль = СокрЛП(ПарольWS);
	Возврат ВебСервис;
	
КонецФункции

Процедура ОбработкаНаСервере() Экспорт
	
	ПолучитьДанные();
	
КонецПроцедуры // ОбработкаНаСервере()

Функция ПолучитьМассивБирДляПолученияДанных()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	CRM_ДилерскиеЦентры.BIR
	               |ИЗ
	               |	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры";
	МассивБИР = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("BIR");
	Возврат МассивБИР;
	
КонецФункции

Функция ЗарегистрироватьИзменения() Экспорт
	
	ВебСервис = ПолучитьВебСервис();
	
	НомерСообщения = Константы.Renault_НомерСообщения.Получить();
	ИдентификаторДилера = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	УдалениеУспешно = ВебСервис.DelMSG(ИдентификаторДилера, Константы.Renault_НомерСообщения.Получить());
	Если УдалениеУспешно Тогда
		Константы.Renault_НомерСообщения.Установить(Константы.Renault_НомерСообщения.Получить()+1);
		//Сообщить("Удалили регистрацию, новый номер "+Константы.Renault_НомерСообщения.Получить());
	Иначе
		//Сообщить("Бир не зарегистрирован");
	КонецЕсли;
	НомерСообщения = Константы.Renault_НомерСообщения.Получить();
	
КонецФункции

Процедура ПолучитьДанные() Экспорт

    Возврат; //Временно не пользуемся загрузкой

    ВебСервис = ПолучитьВебСервис();

    ИдентификаторДилера = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
    ТаблицаДанныхXDTO = ВебСервис.Get(ИдентификаторДилера, НомерСообщения, 0);
    Сериализатор = Новый СериализаторXDTO(ВебСервис.ФабрикаXDTO);
    ТаблицаДанных = Сериализатор.ПрочитатьXDTO(ТаблицаДанныхXDTO);

    Если ТаблицаДанных.Количество() > 0 Тогда
        ЗаписьВРегистры(ТаблицаДанных);
        //Сообщить("Успешно забрали и записали " + ТаблицаДанных.str.Количество() + " записей");
    Иначе
        //Сообщить("Нет изменений в ЦИБ");
    КонецЕсли;

    ЗарегистрироватьИзменения();

КонецПроцедуры // ПолучитьДанные()

Процедура ЗаписьВРегистры(ТаблицаДанных)
	ТаблицаЦен = Новый ТаблицаЗначений;
	ТаблицаЦен.Колонки.Добавить("Артикул");
	ТаблицаЦен.Колонки.Добавить("ТипЦены");
	ТаблицаЦен.Колонки.Добавить("Цена");
	ТаблицаЦен.Колонки.Добавить("ДатаНачала");
	
	Для каждого СтрокаРезультата из ТаблицаДанных Цикл
		Если СтрокаРезультата.ТипДанных = "Номенклатура" Тогда
			 ДобавитьКаталогРеферансы(СтрокаРезультата);
		ИначеЕсли СтрокаРезультата.ТипДанных = "ЦеныНаРеферансы" Тогда
			 ДобавитьТарифЦен(СтрокаРезультата, ТаблицаЦен);
		ИначеЕсли СтрокаРезультата.ТипДанных = "ЗаменыНоменклатуры" Тогда
			 ДобавитьЗаменыРеферансов(СтрокаРезультата);
		ИначеЕсли СтрокаРезультата.ТипДанных = "Комментарий" Тогда
			 ДобавитьКомментарий (СтрокаРезультата);
		 ИначеЕсли СтрокаРезультата.ТипДанных = "Скидки" Тогда
			 ДобаыитьСкидкиНаРеферансы (СтрокаРезультата);
		КонецЕсли;
	КонецЦикла;
	ОбработатьТаблицуЦен(ТаблицаЦен);
КонецПроцедуры

Процедура ДобаыитьСкидкиНаРеферансы (СтрокаРезультата)
	Менеджер = РегистрыСведений.Renault_СкидкиОптовыеРеферансы.СоздатьМенеджерЗаписи();
	Менеджер.КодСкидки = СтрокаРезультата.ТипСкидкиКод;
	Менеджер.ПроцентСкладской = СтрокаРезультата.СкидкаСкладской;
	Менеджер.ПроцентСрочный = СтрокаРезультата.СкидкаСрочный;
	Менеджер.Записать();
КонецПроцедуры

Процедура ОбработатьТаблицуЦен (ТаблицаЦен)
	
	Для Каждого СтрокаТЗ из ТаблицаЦен Цикл
		МенеджерЗаписи = РегистрыСведений.Renault_ТарифЦен.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Артикул = СтрокаТЗ.Артикул;
		МенеджерЗаписи.ТипЦены = СтрокаТЗ.ТипЦены;
		МенеджерЗаписи.Прочитать();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаТЗ);
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
	ТаблицаЦенPCL = ТаблицаЦен.Скопировать(Новый Структура("ТипЦены", Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.ТипЦенPCL));
	ТаблицаЦенPNCСкладская = ТаблицаЦен.Скопировать(Новый Структура("ТипЦены", Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.ТипЦенPNC));
	ТаблицаЦенPNCСрочная = ТаблицаЦен.Скопировать(Новый Структура("ТипЦены", Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.ТипЦенPNCU));
	
	Если ТаблицаЦенPCL.Количество() > 0 Тогда
		СоздатьПереоценкуНоменклатуры (ТаблицаЦенPCL, Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.ТипЦенPCL);
	КонецЕсли;
	Если ТаблицаЦенPNCСкладская.Количество() > 0 Тогда
		СоздатьПереоценкуНоменклатуры (ТаблицаЦенPNCСкладская, Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.ТипЦенPNC);
	КонецЕсли;
	Если ТаблицаЦенPNCСрочная.Количество() > 0 Тогда
		СоздатьПереоценкуНоменклатуры (ТаблицаЦенPNCСрочная, Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.ТипЦенPNCU);
	КонецЕсли;
КонецПроцедуры

Процедура СоздатьПереоценкуНоменклатуры (ТаблицаЦен, ТипЦены)
	перем Период, ИзменениеЦенОбъект;
	ТаблицаЦен.Сортировать("ДатаНачала");
	Для Каждого СтрокаТЗ из ТаблицаЦен Цикл
		Если Период <> СтрокаТЗ.ДатаНачала Тогда
			Период = СтрокаТЗ.ДатаНачала;
			Если ИзменениеЦенОбъект <> Неопределено Тогда
				Если ИзменениеЦенОбъект.Товары.Количество() > 0 Тогда
					Попытка 
						ИзменениеЦенОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Исключение
						ИзменениеЦенОбъект.Записать(РежимЗаписиДокумента.Запись);
					КонецПопытки; 
				КонецЕсли;
			КонецЕсли;
			ИзменениеЦенОбъект = Документы.ИзменениеЦен.СоздатьДокумент();
			ИзменениеЦенОбъект.ХозОперация = Справочники.ХозОперации.УстановкаЦенКонтрагента;
			ИзменениеЦенОбъект.ТипЦен = ТипЦены;
			ИзменениеЦенОбъект.Контрагент = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.ОсновнойПоставщик;
			ИзменениеЦенОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
			ИзменениеЦенОбъект.Организация = ПараметрыСеанса.Организация;
			ИзменениеЦенОбъект.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
			ИзменениеЦенОбъект.ПодразделениеКомпанииПолучатель = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
			ИзменениеЦенОбъект.ДатаНачалаДействия = Период; 
			ИзменениеЦенОбъект.Дата = Период;
			ИзменениеЦенОбъект.Автор = ПараметрыСеанса.Пользователь;
			ИзменениеЦенОбъект.КурсДокумента = 1; 
			ИзменениеЦенОбъект.УстановитьНовыйНомер();
			
		КонецЕсли;
		Номенклатура = НайтиНоменклатуру(СтрокаТЗ.Артикул);
		Если Номенклатура = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТЧ = ИзменениеЦенОбъект.Товары.Добавить();
		СтрокаТЧ.Номенклатура = Номенклатура;
		СтрокаТЧ.Цена = СтрокаТЗ.Цена;
		СтрокаТЧ.ЕдиницаИзмерения = СтрокаТЧ.Номенклатура.ОсновнаяЕдиницаИзмерения;
		СтрокаТЧ.Коэффициент = 1;
	КонецЦикла;
	Если ИзменениеЦенОбъект <> Неопределено и ИзменениеЦенОбъект.ЭтоНовый() Тогда
		Если ИзменениеЦенОбъект.Товары.Количество() > 0 Тогда
			Попытка 
				ИзменениеЦенОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ИзменениеЦенОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКаталогРеферансы(СтрокаРезультата)
	Если Не ЗначениеЗаполнено(СтрокаРезультата.АртикулНоменклатура) Тогда
		Возврат;
	КонецЕсли;
	
	//Сегмент = Справочники.Renault_Сегменты.ПустаяСсылка();
	ТекущаяДата = ТекущаяДата();
	Родитель = Справочники.Renault_НастройкиПодсистемыЗапчасти.ЭтаБаза.КаталогRenault;
	ГруппаСегмент = Родитель;
	Если ЗначениеЗаполнено(СтрокаРезультата.СегментСсылка) Тогда
		ГруппаСегмент = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаРезультата.СегментСсылка));
		ГруппаСегментОбъект = ГруппаСегмент.ПолучитьОбъект();
		Если ГруппаСегментОбъект = Неопределено Тогда
			ГруппаСегментОбъект = Справочники.Номенклатура.СоздатьГруппу();
			ГруппаСегментОбъект.УстановитьСсылкуНового(ГруппаСегмент);
			ЗаполнитьЗначенияСвойств(ГруппаСегментОбъект, Родитель,"ТипНоменклатуры,ВидНоменклатуры,СтавкаНДС,ВалютаУчета");
			ГруппаСегментОбъект.Наименование = СтрокаРезультата.СегментКод + "_" + СтрокаРезультата.СегментНаименование;
			ГруппаСегментОбъект.Родитель = Родитель;
			ГруппаСегментОбъект.УстановитьНовыйКод();
			ГруппаСегментОбъект.Записать();
		КонецЕсли;
		Сегмент = Справочники.Renault_Сегменты.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаРезультата.СегментСсылка));
		СегментОбъект = Сегмент.ПолучитьОбъект();
		Если СегментОбъект = Неопределено Тогда
			СегментОбъект = Справочники.Renault_Сегменты.СоздатьЭлемент();
			СегментОбъект.УстановитьСсылкуНового(Сегмент);
			СегментОбъект.Наименование = СтрокаРезультата.СегментНаименование;
			СегментОбъект.Код = СтрокаРезультата.СегментКод;
			Попытка
				СегментОбъект.Записать();
			Исключение
			КонецПопытки;
		Иначе
			СегментОбъект.Наименование = СтрокаРезультата.СегментНаименование;
			СегментОбъект.Код = СтрокаРезультата.СегментКод;
			Попытка
				СегментОбъект.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	НоменклатураСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",СтрокаРезультата.АртикулНоменклатура); 
	Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
		НоменклатураОбъект.Наименование = ?(СтрокаРезультата.АртикулЗамена= "",СтрокаРезультата.АртикулНоменклатура,СтрокаРезультата.АртикулЗамена);
		НоменклатураОбъект.НаименованиеИностранное = ?(СтрокаРезультата.АртикулЗамена= "",СтрокаРезультата.АртикулНоменклатура,СтрокаРезультата.АртикулЗамена);
		НоменклатураОбъект.НаименованиеПолное = ?(СтрокаРезультата.АртикулЗамена= "",СтрокаРезультата.АртикулНоменклатура,СтрокаРезультата.АртикулЗамена);
		НоменклатураОбъект.Артикул = СтрокаРезультата.АртикулНоменклатура;
		НоменклатураОбъект.ТипНоменклатуры = Родитель.ТипНоменклатуры;
		НоменклатураОбъект.ВидНоменклатуры = Родитель.ВидНоменклатуры;
		НоменклатураОбъект.БазоваяЕдиницаИзмерения = Родитель.ТипНоменклатуры.ОсновнаяБазоваяЕдиницаИзмерения;
		НоменклатураОбъект.СтавкаНДС = Родитель.СтавкаНДС;
		Если НоменклатураОбъект.ТипНоменклатуры.ИспользованиеЕдиницИзмерения = 2 Тогда
			ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(ЕдиницаИзмерения,
								Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Родитель.ТипНоменклатуры.ОсновнаяБазоваяЕдиницаИзмерения.Наименование,,,Родитель.ТипНоменклатуры));
			ЕдиницаИзмерения.Владелец = НоменклатураСсылка;
			ЕдиницаИзмерения.УстановитьНовыйКод();
			ЕдиницаИзмерения.Записать();
		Иначе
			ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию(Родитель.ТипНоменклатуры.ОсновнаяБазоваяЕдиницаИзмерения.Наименование,,,Родитель.ТипНоменклатуры);
		КонецЕсли;
		НоменклатураОбъект.ОсновнаяЕдиницаИзмерения = ЕдиницаИзмерения;
		НоменклатураОбъект.ВалютаУчета = Родитель.ВалютаУчета;
		НоменклатураОбъект.Родитель = ГруппаСегмент;
		НоменклатураОбъект.УстановитьНовыйКод();
	Иначе
		НоменклатураОбъект = НоменклатураСсылка.ПолучитьОбъект();
	КонецЕсли;
	НоменклатураОбъект.КратностьПоставок = СтрокаРезультата.КратностьЗаказа;
	НоменклатураОбъект.ЗапретЗакупки = СтрокаРезультата.ЗапретЗакупки;
	Попытка
		НоменклатураОбъект.ОбменДанными.Загрузка = Истина;
		НоменклатураОбъект.Записать();   
	Исключение
		Возврат;
	КонецПопытки;
	Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		НоменклатураСсылка = НоменклатураОбъект.Ссылка;
	КонецЕсли;
	
	НовЗаписьСрез = РегистрыСведений.Renault_КаталогРеферансов.СоздатьМенеджерЗаписи();
		
	НовЗаписьСрез.Номенклатура = НоменклатураСсылка;
	НовЗаписьСрез.Артикул = СтрокаРезультата.АртикулНоменклатура;
	НовЗаписьСрез.Прочитать();
	
	Если НЕ НовЗаписьСрез.Выбран() Тогда
		НовЗаписьСрез.Номенклатура = НоменклатураСсылка;
		НовЗаписьСрез.Артикул = СтрокаРезультата.АртикулНоменклатура;
	КонецЕсли;
	
	НовЗаписьСрез.КратностьПоставок = СтрокаРезультата.КратностьЗаказа;
	НовЗаписьСрез.ЗапретЗакупки = СтрокаРезультата.ЗапретЗакупки;
	НовЗаписьСрез.НаличиеВSAPе = СтрокаРезультата.НаличиеВSAP;
	НовЗаписьСрез.ТехСемья = СтрокаРезультата.ТехСемья;
	НовЗаписьСрез.Артикул = СтрокаРезультата.АртикулНоменклатура;
	НовЗаписьСрез.Наименование = СтрокаРезультата.АртикулЗамена;
	НовЗаписьСрез.Нетто = СтрокаРезультата.ВесНетто;
	НовЗаписьСрез.Брутто = СтрокаРезультата.ВесБрутто;
	НовЗаписьСрез.Объем = СтрокаРезультата.Объем;
	НовЗаписьСрез.Сегмент = Сегмент;
	НовЗаписьСрез.КодСкидки = СтрокаРезультата.ТипСкидкиКод;
	НовЗаписьСрез.Габариты = СтрокаРезультата.Размер;
	НовЗаписьСрез.ПрямаяПоставка		= СтрокаРезультата.ПрямаяПоставка;
	НовЗаписьСрез.КодоваяЗапчасть		= СтрокаРезультата.КодоваяЗапчасть;
	НовЗаписьСрез.PVI					= ?(ЗначениеЗаполнено(СтрокаРезультата.PVI),Перечисления.Renault_ТипыPVI[СтрокаРезультата.PVI],
												Перечисления.Renault_ТипыPVI.ПустаяСсылка());

	НовЗаписьСрез.Записать();
	
	ДляУдаленияКомментов = РегистрыСведений.Renault_КомментарииРеферансов.СоздатьНаборЗаписей();
	
	ДляУдаленияКомментов.Отбор.Номенклатура.Установить(НоменклатураСсылка);
	ДляУдаленияКомментов.Записать();
	
КонецПроцедуры

Процедура СохранитьВРегистреИстории (СтрокаЗаписи, ИмяРегистра)
	
	СтрокаИстории = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(СтрокаИстории, СтрокаЗаписи);
	СтрокаИстории.Период = ТекущаяДата();
	СтрокаИстории.Записать();
	
КонецПроцедуры

Процедура ДобавитьКомментарий(СтрокаРезультата)
	
	НоменклатураСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",СтрокаРезультата.АртикулНоменклатура); 
	Если НоменклатураСсылка <> Справочники.Номенклатура.ПустаяСсылка() Тогда
		НовЗапись				= РегистрыСведений.Renault_КомментарииРеферансов.СоздатьМенеджерЗаписи();
		НовЗапись.Номенклатура = НоменклатураСсылка;
		НовЗапись.Комментарий	= СтрокаРезультата.АртикулЗамена;
		НовЗапись.Прочитать();
		НовЗапись.Номенклатура = НоменклатураСсылка;
		НовЗапись.Артикул		= СтрокаРезультата.АртикулНоменклатура;
		НовЗапись.Комментарий	= СтрокаРезультата.АртикулЗамена;
		НовЗапись.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЗаменыРеферансов(СтрокаРезультата)
	
	ТекущаяДата = ТекущаяДата();
	Если СтрокаРезультата.УдалитьСтроку = Истина Тогда
		ДляУдаленияЗамены = РегистрыСведений.Renault_ЗаменыРеферансов.СоздатьМенеджерЗаписи();
		ДляУдаленияЗамены.АртикулНоменклатуры = СтрокаРезультата.АртикулНоменклатура;
		ДляУдаленияЗамены.АртикулЗамены = СтрокаРезультата.АртикулЗамена;
		ДляУдаленияЗамены.Прочитать();
		ДляУдаленияЗамены.Удалить();
		ДляУдаление = РегистрыСведений.Замены.СоздатьМенеджерЗаписи();
		ДляУдаление.Артикул = СтрокаРезультата.АртикулНоменклатура;
		ДляУдаление.АртикулЗамены = СтрокаРезультата.АртикулЗамена;
		ДляУдаление.Прочитать();
		ДляУдаление.Удалить();
	Иначе
		НовЗаписьСрез = РегистрыСведений.Renault_ЗаменыРеферансов.СоздатьМенеджерЗаписи();
		НовЗаписьСрез.АртикулНоменклатуры		= СтрокаРезультата.АртикулНоменклатура;
		НовЗаписьСрез.АртикулЗамены             = СтрокаРезультата.АртикулЗамена;
		НовЗаписьСрез.Прочитать();
		// TODO: Убрать ошметки от удаления сохранения истории
		ЗаполнитьЗначенияСвойств(НовЗаписьСрез, СтрокаРезультата);
		НовЗаписьСрез.АртикулНоменклатуры		= СтрокаРезультата.АртикулНоменклатура;
		НовЗаписьСрез.АртикулЗамены             = СтрокаРезультата.АртикулЗамена;
		НовЗаписьСрез.ДатаНачала				= ТекущаяДата;
		НовЗаписьСрез.Записать();
		ЗаписьЗамены = РегистрыСведений.Замены.СоздатьМенеджерЗаписи();
		ЗаписьЗамены.Артикул = СтрокаРезультата.АртикулНоменклатура;
		ЗаписьЗамены.АртикулЗамены = СтрокаРезультата.АртикулЗамена;
		ЗаписьЗамены.ДатаЗамены = ТекущаяДата;
		ЗаписьЗамены.ДатаОбновления = ТекущаяДата;
		ЗаписьЗамены.Количество = 1;
		ЗаписьЗамены.ЗапретИзменения = Истина;  
		ЗаписьЗамены.ДатаЗавершения = СтрокаРезультата.ДатаЗавершения;
		ЗаписьЗамены.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьТарифЦен(СтрокаРезультата, ТаблицаЦен)

	Прайс = НайтиПрайсПоЦене(СтрокаРезультата.ТипЦены);
	Если СтрокаРезультата.УдалитьСтроку = Неопределено ИЛИ СтрокаРезультата.УдалитьСтроку = Ложь Тогда
		СтрокаТЗ = ТаблицаЦен.Добавить();
		СтрокаТЗ.Артикул = СтрокаРезультата.АртикулНоменклатура;
		СтрокаТЗ.ТипЦены = Прайс;
		СтрокаТЗ.Цена = СтрокаРезультата.Цена;
		СтрокаТЗ.ДатаНачала = СтрокаРезультата.ДатаНачала;
	Иначе
		МенеджерТарифа = РегистрыСведений.Renault_ТарифЦен.СоздатьМенеджерЗаписи();
		МенеджерТарифа.Артикул = СтрокаРезультата.АртикулНоменклатура;
		МенеджерТарифа.ТипЦены = Прайс;
		МенеджерТарифа.Прочитать();
		МенеджерТарифа.Удалить();
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиНоменклатуру(Артикул)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Renault_КаталогРеферансов.Номенклатура 
	                      |ИЗ
	                      |	РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
	                      |ГДЕ
	                      |	Renault_КаталогРеферансов.Артикул = &Артикул");
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Номенклатура; 
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция НайтиПрайсПоЦене(ИмяТипаЦены)
	
	Если ИмяТипаЦены = "PCL" Тогда Возврат PCLПродажа; КонецЕсли;
	Если ИмяТипаЦены = "PNCStore" Тогда Возврат PNCЗакупСкладская; КонецЕсли;
	Если ИмяТипаЦены = "PNCQuick" Тогда Возврат PNCЗакупСрочная; КонецЕсли;
	Возврат Неопределено;
	
КонецФункции


