    Таблица = Renault_ЗапчастиСервер.ПолучитьПолныйТарифССервера(BIR);

    Если ЗаписыватьНаборами Тогда

        НаборЗаписей = РегистрыСведений.Renault_ТарифЦен.СоздатьНаборЗаписей();
