Процедура Статус(Текст="", Процент=0)
    Если Форма = Неопределено Тогда Возврат КонецЕсли;
    #Если Клиент Тогда
        Форма.Статус(Текст, Процент);
    #КонецЕсли
КонецПроцедуры

Функция ПолучитьPVI(PVI)

    Если PVI = "PVI" Тогда
        Возврат Перечисления.Renault_ТипыPVI.PVI;
    ИначеЕсли PVI = "Не PVI" Тогда
        Возврат Перечисления.Renault_ТипыPVI.НеPVI;
    Иначе
        Возврат Перечисления.Renault_ТипыPVI.ПустаяСсылка();
    КонецЕсли;

КонецФункции

Функция ПолучитьТипЦены(ИмяТипаЦены)

    Имя = НРег(ИмяТипаЦены);
    Если      Имя = "pcl"           Тогда Возврат PCLПродажа;
    ИначеЕсли Имя = "pnc складская" Тогда Возврат PNCЗакупСкладская;
    ИначеЕсли Имя = "pnc срочная"   Тогда Возврат PNCЗакупСрочная;
    Иначе Возврат Справочники.ТипыЦен.ПустаяСсылка(); КонецЕсли;

КонецФункции


// КАТАЛОГ

Процедура ЗагрузитьКаталог() Экспорт

    Статус("Получаем каталог с сервера");

    Таблица = Renault_ЗапчастиСервер.ПолучитьПолныйКаталогССервера();

    Если ЗаписыватьНаборами Тогда

        НаборЗаписей = РегистрыСведений.Renault_КаталогРеферансов.СоздатьНаборЗаписей();
        Счетчик = 0;
        ГлобальныйСчетчик = 0;
        ВсегоЗаписей = Таблица.Количество();

        Статус("Читаем данные");

        Для Каждого Реф Из Таблица Цикл

            #Если Клиент Тогда
                ОбработкаПрерыванияПользователя();
            #КонецЕсли


            Счетчик = Счетчик + 1;
            ГлобальныйСчетчик = ГлобальныйСчетчик + 1;
            Статус(,100 * ГлобальныйСчетчик / ВсегоЗаписей);

            Если Не ЗначениеЗаполнено(Реф.Артикул) Тогда
                Продолжить;
            КонецЕсли;

            Стр = НаборЗаписей.Добавить();
            ЗаполнитьЗначенияСвойств(Стр, Реф);
            Стр.PVI           = ПолучитьPVI(Реф.PVI);
            Стр.Сегмент       = Справочники.Renault_Сегменты.НайтиПоКоду(Реф.Сегмент);
            Стр.Номенклатура  = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Стр.Артикул);
            Стр.ПолныйАртикул = Прав("0000000000" + СокрЛП(Стр.Артикул), 10);

            Если Счетчик >= КоличествоОбъектов Тогда
                Статус("Записываем данные", 100 * ГлобальныйСчетчик / ВсегоЗаписей);
                НаборЗаписей.Записать(Ложь);
                НаборЗаписей = РегистрыСведений.Renault_КаталогРеферансов.СоздатьНаборЗаписей();
                Счетчик = 0;
                Статус("Читаем данные", 100 * ГлобальныйСчетчик / ВсегоЗаписей);
            КонецЕсли;

        КонецЦикла;

        Статус("Записываем данные", 100 * ГлобальныйСчетчик / ВсегоЗаписей);
        НаборЗаписей.Записать(Ложь);

    Иначе

        ГлобальныйСчетчик = 0;
        ВсегоЗаписей = Таблица.Количество();

        Статус("Записываем данные");

        Для Каждого Реф Из Таблица Цикл

            #Если Клиент Тогда
                ОбработкаПрерыванияПользователя();
            #КонецЕсли


            ГлобальныйСчетчик = ГлобальныйСчетчик + 1;
            Статус(,100 * ГлобальныйСчетчик / ВсегоЗаписей);

            Если Не ЗначениеЗаполнено(Реф.Артикул) Тогда
                Продолжить;
            КонецЕсли;

            Стр = РегистрыСведений.Renault_КаталогРеферансов.СоздатьМенеджерЗаписи();
            ЗаполнитьЗначенияСвойств(Стр, Реф);
            Стр.PVI           = ПолучитьPVI(Реф.PVI);
            Стр.Сегмент       = Справочники.Renault_Сегменты.НайтиПоКоду(Реф.Сегмент);
            Стр.Номенклатура  = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Стр.Артикул);
            Стр.ПолныйАртикул = Прав("0000000000" + СокрЛП(Стр.Артикул), 10);

            Стр.Записать(Истина);

        КонецЦикла;

    КонецЕсли;

    Статус("Каталог загружен", 100);

КонецПроцедуры

Процедура ОбновитьКаталог(Интервал) Экспорт

    Статус("Получаем изменения каталог с сервера");

    Таблица = Renault_ЗапчастиСервер.ПолучитьИзмененияКаталогаССервера(Интервал);

    ГлобальныйСчетчик = 0;
    ВсегоЗаписей = Таблица.Количество();

    Статус("Записываем данные");

    Для Каждого Реф Из Таблица Цикл

        #Если Клиент Тогда
            ОбработкаПрерыванияПользователя();
        #КонецЕсли

        ГлобальныйСчетчик = ГлобальныйСчетчик + 1;
        Статус(,100 * ГлобальныйСчетчик / ВсегоЗаписей);

        Если Не ЗначениеЗаполнено(Реф.Артикул) Тогда
            Продолжить;
        КонецЕсли;

        Стр = РегистрыСведений.Renault_КаталогРеферансов.СоздатьМенеджерЗаписи();
        ЗаполнитьЗначенияСвойств(Стр, Реф);
        Стр.PVI          = ПолучитьPVI(Реф.PVI);
        Стр.Сегмент      = Справочники.Renault_Сегменты.НайтиПоКоду(Реф.Сегмент);
        Стр.Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Стр.Артикул);

        Стр.Записать(Истина);

    КонецЦикла;

    Статус("Изменения каталога загружены", 100);

КонецПроцедуры

Процедура ОчиститьКаталог() Экспорт

    Статус("Очистка каталога", 50);

    Каталог = РегистрыСведений.Renault_КаталогРеферансов.СоздатьНаборЗаписей();
    Каталог.Записать();

    Статус("Каталог очищен", 100);

КонецПроцедуры


Процедура ЗагрузитьСегменты() Экспорт

    Статус("Получаем каталог с сервера");

    ВебСервис = ЭтотОбъект.ПолучитьВебСервис();
    Хранилище = ВебСервис.GetSegments();

    Статус("Обрабатываем полученный файл");

    ДвДанные = Хранилище.Получить();
    ИмяФайла = ПолучитьИмяВременногоФайла(".xml");
    ДвДанные.Записать(ИмяФайла);

    ЧтениеXML = Новый ЧтениеXML;
    ЧтениеXML.ОткрытьФайл(ИмяФайла);

    Статус("Читаем файл");

    Пока ЧтениеXML.Прочитать() Цикл

        Если ЧтениеXML.Имя = "Сегменты" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

            ЧтениеXML.Прочитать();
            Рез = ПрочитатьXML(ЧтениеXML);
            Таблица = Рез.Получить();

            ГлобальныйСчетчик = 0;
            ВсегоЗаписей = Таблица.Количество();

            Статус("Читаем данные");

            Для Каждого Сег Из Таблица Цикл

                #Если Клиент Тогда
                    ОбработкаПрерыванияПользователя();
                #КонецЕсли

                Сегмент = Справочники.Renault_Сегменты.НайтиПоКоду(Сег.Код);

                Если Не ЗначениеЗаполнено(Сегмент) Тогда // Создаем новый
                    Сегмент = Справочники.Renault_Сегменты.СоздатьЭлемент();
                    Сегмент.Код = Сег.Код;
                Иначе
                    Сегмент = Сегмент.ПолучитьОбъект();
                КонецЕсли;

                Сегмент.Наименование = Сег.Наименование;

                ГлобальныйСчетчик = ГлобальныйСчетчик + 1;
                Статус(,100 * ГлобальныйСчетчик / ВсегоЗаписей);

                Статус("Записываем данные", 100 * ГлобальныйСчетчик / ВсегоЗаписей);
                Сегмент.Записать();

                Статус("Читаем данные", 100 * ГлобальныйСчетчик / ВсегоЗаписей);

            КонецЦикла;

        КонецЕсли;

    КонецЦикла;

    ЧтениеXML.Закрыть();

    Статус("Очищаем временные файлы", 100);

    УдалитьФайлы(ИмяФайла);

    Статус("Сегменты обновлены", 100);
    
КонецПроцедуры


