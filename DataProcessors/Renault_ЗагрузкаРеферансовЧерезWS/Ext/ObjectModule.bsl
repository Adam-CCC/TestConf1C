    Запрос="ВЫБРАТЬ
           |    ТЗ.Артикул КАК Артикул,
           |    ТЗ.Статус КАК Статус
           |ПОМЕСТИТЬ ТЗ
           |ИЗ
           |    &ТЗ КАК ТЗ
           |;
           |
           |////////////////////////////////////////////////////////////////////////////////
           |ВЫБРАТЬ
           |    &Период КАК Период,
           |    ЕСТЬNULL(Рег.Номенклатура, Записи.Номенклатура) КАК Номенклатура,
           |    ВЫБОР
           |        КОГДА ЕСТЬNULL(Рег.НеОбновлять, ЛОЖЬ)
           |            ТОГДА Рег.Статус
           |        ИНАЧЕ Записи.Статус
           |    КОНЕЦ КАК Статус,
           |    ЕСТЬNULL(Рег.НеОбновлять, ЛОЖЬ) КАК НеОбновлять
           |ИЗ
           |    РегистрСведений.Renault_СтатусыНоменклатуры.СрезПоследних(, ) КАК Рег
           |        ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |            Ном.Ссылка КАК Номенклатура,
           |            Ст.Ссылка КАК Статус
           |        ИЗ
           |            ТЗ КАК ТЗ
           |                ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
           |                ПО ТЗ.Артикул = Ном.Артикул
           |                ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_СтатусыНоменклатуры КАК Ст
           |                ПО ТЗ.Статус = Ст.Ссылка.Код) КАК Записи
           |        ПО Рег.Номенклатура = Записи.Номенклатура";
    Запрос = Новый Запрос(Запрос);
    //Запрос.УстановитьПараметр("ТЗ", ПолучитьСтатусыНоменклатурыССервера());
    Запрос.УстановитьПараметр("Период", ТекущаяДата());
    Записи = РегистрыСведений.Renault_СтатусыНоменклатуры.СоздатьНаборЗаписей();
    Записи.Загрузить(Запрос.Выполнить().Выгрузить());
    Записи.Записать();

    Статус("Статусы номенклатуры загружены");

КонецПроцедуры


