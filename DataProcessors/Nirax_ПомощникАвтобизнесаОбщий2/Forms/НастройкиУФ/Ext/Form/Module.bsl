&НаКлиенте
Процедура СохранитьНастройкиВФайл(Команда)
	Список=ФормированиеСпискаСохраненияНаСервере();
	Оповещение=Новый ОписаниеОповещения("СохранениеНастройкиВыборФайла",ЭтаФорма);
	ПараметрыФормы=Новый Структура("СписокЗначений,Групповой,ТекущаяСтрока,Заголовок",
	Список,Истина,0,"Сохранить настройки");
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
	ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура СохранениеНастройкиВыборФайла(Список,Доп) Экспорт
	Если Список=Неопределено тогда Возврат; КонецЕсли;
	//Список[0].Представление="Все (онлайн-поставищики заменяются)";
	Инд=Список.Количество()-1;
	Если Список[0].Пометка Тогда 
		Список.Удалить(Инд);	// проценки отмеченные удаляем
	Иначе
		//Если отмечены проценки все - проценки отмеченные удаляем
		Если Список[Инд-1].Пометка Тогда 
			Список.Удалить(Инд);
			Инд=Инд-1;
		КонецЕсли;
		//Удаляем не отмеченные позиции сохранения
		Пока Инд>0 Цикл
			Если Не Список[Инд].Пометка Тогда Список.Удалить(Инд);КонецЕсли;
			Инд=Инд-1;
		КонецЦикла;
		Если Список.Количество()<2 Тогда Возврат;КонецЕсли;	//Не отмечена ни одна позиция
	КонецЕсли;
	Список.ЗаполнитьПометки(Ложь);
	
	Оповещение=Новый ОписаниеОповещения("СохранениеНастроекВФайл",ЭтаФорма,Список);
	Диалог = Новый ДиалогВыбораФайла (РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Файлы настроек отчетов *.rep1c|*.rep1c";
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура СохранениеНастроекВФайл(Файлы,Список) Экспорт
	Если Файлы=Неопределено Тогда Возврат;КонецЕсли;
	ТекстовыйФайл=СохранениеНастроекНаСервере(Список);
	Если ТекстовыйФайл = Неопределено Тогда
		Сообщить("Нет данных для сохранения");
	Иначе
		Попытка
		    ТекстовыйФайл.Записать(Файлы[0]);
		Исключение
	    	Сообщить("Ошибка при сохранении файла настроек: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция СохранениеНастроекНаСервере(Список)
	ИндексПроценки=0;
	Инд=Список.Количество()-1;
	Пока Инд>0 Цикл
		Стр=Список[Инд];
		Если ТипЗнч(Стр.Значение)=Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Стр.Значение,Объект);
			Стр.Значение=ЗначениеВСтрокуВнутр(Стр.Значение);
		ИначеЕсли Стр.Представление="Онлайн-поставщиков отмеченных" И ИндексПроценки>0 Тогда
			Список.Удалить(Стр);
		ИначеЕсли Стр.Значение="ПриходСтруктура" Тогда
			Попытка
				Отбор = Новый Структура("Пользователь, КлючОбъекта");
				Отбор.Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
				Отбор.КлючОбъекта = "ПомощникАвтобизнеса";
				Значение=Новый СписокЗначений;
				ВыборкаХранилища = ХранилищеОбщихНастроек.Выбрать(Отбор);
				Пока ВыборкаХранилища.Следующий() Цикл
					Если Найти(ВыборкаХранилища.КлючНастроек, "ПриходСтруктура_") > 0 Тогда
					   Значение.Добавить(ВыборкаХранилища.Настройки,ВыборкаХранилища.КлючНастроек);
				    КонецЕсли;
				КонецЦикла;
				Если Значение.Количество()>0 Тогда
					Стр.Значение=ЗначениеВСтрокуВнутр(Значение);
				Иначе
					Список.Удалить(Стр);
				КонецЕсли;
		    Исключение
		        Список.Удалить(Стр);
			КонецПопытки;
		ИначеЕсли Лев(Стр.Представление,18)= "Онлайн-поставщиков" Тогда
			Значение=ТабПроценки.Выгрузить();
			Если Значение.Количество()=0 Тогда 
				Список.Удалить(Стр); 
			ИначеЕсли Стр.Представление="Онлайн-поставщиков всех" Тогда
				ИндексПроценки=Инд;
				Стр.Представление="Онлайн-поставщиков заменить";
				Стр.Значение=ЗначениеВСтрокуВнутр(Значение);
			ИначеЕсли Стр.Представление="Онлайн-поставщиков отмеченных" Тогда
				Вкл=0;
				ИндПроц=Значение.Количество()-1;
				Пока ИндПроц >= 0 Цикл
					Проц=Значение[ИндПроц];
					Если Не Проц.Вкл Тогда 
						Значение.Удалить(Проц);
					Иначе
						Вкл=Вкл+1;
					КонецЕсли;
					ИндПроц=ИндПроц-1;
				КонецЦикла;
				Если Вкл=0 Тогда 
					Список.Удалить(Стр);
				Иначе
					Стр.Значение=ЗначениеВСтрокуВнутр(Значение);
					ИндексПроценки=Инд;
					Стр.Представление="Онлайн-поставщиков заменить";
				КонецЕсли;
			КонецЕсли;
		Иначе
			Стр.Значение=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса",Стр.Значение,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
			Если Стр.Значение=Неопределено или ?(ТипЗнч(Стр.Значение)=Тип("ДеревоЗначений"),Ложь,Стр.Значение.Количество()=0) Тогда 
				Список.Удалить(Стр);
			Иначе		
				Стр.Значение=ЗначениеВСтрокуВнутр(Стр.Значение);
			КонецЕсли;
		КонецЕсли;
		Инд=Инд-1;
	КонецЦикла;
	Если Список.Количество()<2 Тогда
		Сообщить("Нет данных для сохранения");
		Возврат Неопределено;
	ИначеЕсли Список.Количество()=2 Тогда
		Список.Удалить(Список[0]);
	ИначеЕсли ИндексПроценки>0 Тогда
		Список[0].Представление="Все (онлайн-поставищики заменяются)";
	КонецЕсли;
	Если ИндексПроценки>0 Тогда Список.Добавить(ИндексПроценки, "Онлайн-поставщиков добавить"); КонецЕсли;
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.УстановитьТекст(ЗначениеВСтрокуВнутр(Список));
	Список.Очистить();  // Чтобы не передавались на клиент данные из списка
	Возврат ТекстовыйФайл;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьНастройкиИзФайла(Команда)
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьНастройкиВыборИзФайла",ЭтаФорма);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Файлы настроек отчетов *.rep1c|*.rep1c";
    Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиВыборИзФайла(Файлы,Доп) Экспорт
	Если Файлы=Неопределено Тогда Возврат;КонецЕсли;
    ТекстовыйФайл = Новый ТекстовыйДокумент;
	ОО=Новый ОписаниеОповещения("ЗагрузитьНастройкиИзФайлаЧтение",ЭтаФорма,
	Новый Структура("ТекстовыйФайл,ПользователиПА",ТекстовыйФайл,Доп));
    ТекстовыйФайл.НачатьЧтение(ОО,Файлы[0]);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиИзФайлаЧтение(Данные) Экспорт
	Доп=Неопределено;
	Список=ЗагрузитьНастройкиИзФайлаНаСервере(Данные.ТекстовыйФайл.ПолучитьТекст(),Доп);
	Если Список=Неопределено Тогда
		//Загрузили Настройки в старом формате
		Если Доп=Неопределено Тогда
			ЭтаФорма.Закрыть();
		КонецЕсли;
	Иначе
		Оповещение=Новый ОписаниеОповещения("ЗагрузитьИзФайлаВосстановить",ЭтаФорма, Данные.ПользователиПА);
		ПараметрыФормы=Новый Структура("СписокЗначений,Групповой,ТекущаяСтрока,Заголовок",
		Список,Истина,0,"Загрузить настройки");
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
		ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаВосстановить(Список,ПользователиПА) Экспорт
	Если Список=Неопределено Тогда Возврат;
	ИначеЕСли ПользователиПА<>Неопределено Тогда
		ДоступЗагрузкаНастроекИзФайлаНаСервере(Список,ПользователиПА);
		Возврат;
	КонецЕсли;
	Обновить=ЗагрузкаНастроекИзФайлаНаСервере(Список);
	Если Обновить.Свойство("ЕстьСкрытые") ТОгда
		Страницы=ЭтаФорма.ВладелецФормы.Элементы;
		ВОбъект=ЭтаФорма.ВладелецФормы.Объект;
		
		ВОбъект.ИспользоватьБазуКроссов=Объект.ИспользоватьБазуКроссов;
		Страницы.СтраницаПоискПоАртикулу.Видимость=Объект.ИспользоватьБазуКроссов;
		
		ВОбъект.ИспользоватьПрайсЛист=Объект.ИспользоватьПрайсЛист;
		Страницы.СтраницаПоискПоПрайсу.Видимость=Объект.ИспользоватьПрайсЛист;
		
		ВОбъект.ИспользоватьПроценкуОнлайнПоставщиков=Объект.ИспользоватьПроценкуОнлайнПоставщиков;
		Страницы.ПоискЕмекс.Видимость=Объект.ИспользоватьПроценкуОнлайнПоставщиков;
		
		ВОбъект.ИспользоватьПоискПоАвтомобилю=Объект.ИспользоватьПоискПоАвтомобилю;
		Страницы.Стр3.Видимость=Объект.ИспользоватьПоискПоАвтомобилю;
		
		ВОбъект.ИспользоватьЗаказПоставщику=Объект.ИспользоватьЗаказПоставщику;
		Страницы.Группа10.Видимость=Объект.ИспользоватьЗаказПоставщику;

		УстановитьТекущуюСтраницу();
		ОбновитьВидимостьПодсказок();
	ИначеЕсли Обновить.Свойство("УровниЦен") ТОгда
		Мас=Обновить.УровниЦен;
		Рекв=ЭтаФорма.ВладелецФормы;
		Рекв.Элементы.УровеньЦен.СписокВыбора.ЗагрузитьЗначения(Мас);
		Рекв.Элементы.УровеньЦенЕмекс.СписокВыбора.ЗагрузитьЗначения(Мас);
		Если Мас.Найти(Рекв.Объект.УровеньЦен)=Неопределено Тогда Рекв.Объект.УровеньЦен="Закупочная";КонецЕсли;
		Если Мас.Найти(Рекв.Объект.УровеньЦенЕмекс)=Неопределено Тогда Рекв.Объект.УровеньЦенЕмекс="Закупочная";КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ЗагрузитьНастройкиИзФайлаНаСервере(ТекстовыйФайл,Доп)
	Список=ЗначениеИзСтрокиВнутр(ТекстовыйФайл);
	Если ТипЗнч(Список)=Тип("СписокЗначений") Тогда
		Возврат Список;
	ИначеЕсли Доп=Неопределено Тогда
		Обработка=РеквизитФормыВЗначение("Объект");
		Обработка.ЗагрузитьНастройкиИзФайлаБыл(Список);
		Данные = Новый Структура(
		"АналогиЕстьВ1С,АртикулОчищать,БанковскийСчетДляЗаявки,БезАналогов,БезПрименяемости,ВидНоменклатуры,
	    |ВКорзину,ВыбиратьГруппу,ВыводитьАналоги,ВыводитьНаличие,Группировать,ЗаказПокупателя,ЗаписьШтрихкода,
	    |ЗапрашиватьКоличество,ЗапрашиватьСкидку,ЗапрашиватьЦену,ИспользоватьПроценкуОнлайнПоставщиков,
	    |ИспользоватьЦены,КассаККМ,КонтрольОстатков,НДСПоУмолчанию,ОбщийПоиск,ОрганизацияДляЗаявки,
		|ОтборПроизводители,ПутьКВременнойПапке,РеализацияТоваров,Склад,СортироватьТолькоПоЦенам,ПроводитьДокументы,
		|СчетФактура,ТипЦен,ЦеноваяГруппа,ШаблонНаименования,ШаблонНаименованияП,ШаблонНомераДляПоиска,
		|РеквизитНомераДляПоиска,ИспользоватьСинонимы,ЗапрашиватьГруппуНоменклатуры,ПоискПоОчищенному,ГруппаНоменклатуры,
		|ПоказатьЗамерПроизводительностиПоиска,БазоваяЕдиницаИзмерения, ТипЦенЗакупка, ИспользоватьБазуКроссов, 
		|ИспользоватьПрайсЛист, ИспользоватьПоискПоАвтомобилю,
		|ОтключитьПодсказкиВидеоИнструкций,ИспользоватьЗаказПоставщику,СортировкаОнлайнПоставщики, СортировкаОнлайнПоставщикиНаправление,
		|ЗаполнятьЗаказПриДобавленииВОнлайнКорзину,ЗапретитьРедактированиеЦенВКорзине,ИспользоватьСжатиеДанных,ЗаказВКомментарий,СборАналитики");
			
		ЗаполнитьЗначенияСвойств(Данные,ЗначениеИзСтрокиВнутр(ТекстовыйФайл.ПолучитьТекст()));
		ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","ОбъектMySQL",Данные,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
		Возврат Неопределено;
	Иначе
		Сообщить("Старый формат данных сохранения.Для загрузки настроек другим пользователям сохраняйте данные в новом формате.");
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ЗагрузкаНастроекИзФайлаНаСервере(Список)
	Имена=Новый СписокЗначений;
	Имена.Добавить("Уровней цен","УровниЦен");
	Имена.Добавить("Прайс-листов","НастройкаЗагрузки");
	Имена.Добавить("Синонимы","Синонимы");
	Имена.Добавить("Онлайн-поставщиков заменить","Проценки",);	
	ЕстьПроценки=Ложь;
	ЕстьОбщие=Ложь;
	Обновить=Новый Структура;
	Для Каждого Стр из Список Цикл
		Если Не Стр.Пометка Тогда Продолжить;
		ИначеЕсли Стр.Представление="Все (онлайн-поставищики заменяются)" или Стр.Представление="Все" Тогда 
			Список.ЗаполнитьПометки(Истина);
			Продолжить;
		ИначеЕСли Стр.Представление="Онлайн-поставщиков добавить" И ЕстьПроценки Тогда
			Продолжить;
		КонецЕсли;
		ЕСли ТипЗнч(Стр.Значение)=Тип("Число") Тогда
			Значение=ЗначениеИзСтрокиВнутр(Список[Список.Индекс(Стр)-1].Значение);
		Иначе
			Значение=ЗначениеИзСтрокиВнутр(Стр.Значение);
		КонецЕсли;
		СтрТип=ТипЗнч(Значение);
		
		Если СтрТип = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Объект,Значение);
			ЕстьОбщие=Истина;
			Если Стр.Представление="Скрытых элементов" Тогда 
				Обновить.Вставить("ЕстьСкрытые",Истина); 
			КонецЕсли; 
		ИначеЕсли СтрТип = Тип("СписокЗначений") Тогда
			Для Каждого Эл из Значение Цикл
				ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса",Эл.Представление,Эл.Значение,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
			КонецЦикла;	
		ИначеЕсли Лев(Стр.Представление,18)="Онлайн-поставщиков" Тогда
			Если ЕстьПроценки Тогда Продолжить;КонецЕсли;
			ЕстьПроценки=Истина;
			Если Стр.Представление="Онлайн-поставщиков заменить" Тогда
				ТабПроценки.Очистить();
			КонецЕсли;
			СкладыВТаблицу(Значение); 
			Для каждого эл из Значение Цикл
				Нов=ТабПроценки.Добавить();
				ЗаполнитьЗначенияСвойств(Нов,эл,,"Склады");
				Если ПустаяСтрока(Нов.Источник) Тогда Нов.Источник="API";КонецЕсли;
				Нов.Склады.Загрузить(Эл.Склады);
			КонецЦикла;
			ЗаписатьПроценкиНаСервере();
			//ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Проценки",ТабПроценки.Выгрузить(),,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
		ИначеЕсли СтрТип = Тип("ТаблицаЗначений") Тогда
			Имя=Имена.НайтиПоЗначению(Стр.Представление);
			ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса",Имя.Представление,Значение,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
			Если Имя.Представление="УровниЦен" Тогда
				Обработка=РеквизитФормыВЗначение("Объект");
				Мас=Обработка.ВыгрузитьУровниЦен();
				Обновить.Вставить("УровниЦен",Мас);
			КонецЕсли;
		ИначеЕсли СтрТип = Тип("ДеревоЗначений") Тогда
			Имя=Имена.НайтиПоЗначению(Стр.Представление);
			ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса",Имя.Представление,Значение,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
			Обработка=РеквизитФормыВЗначение("Объект");
			Мас=Обработка.ВыгрузитьУровниЦен();
			Обновить.Вставить("УровниЦен",Мас);
		КонецЕсли;
	КонецЦикла;
	Если ЕстьОбщие Тогда
		Обработка = РеквизитФормыВЗначение("Объект");
		Обработка.СохранитьНастройкиВХранилище("ОсновныеНастройки");
	КонецЕсли;
	Возврат Обновить;
КонецФункции

&НаКлиенте
Процедура ВыбратьПроценки(Команда)
	Если ДанныеПроценкиИзменены Тогда
		ТабПроценкиПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
	ПараметрыФормы=Новый Структура("ТабПроценки", ТабПроценки);
	Оповещение=Новый ОписаниеОповещения("ВыборПроценокНаКлиенте",ЭтаФорма);
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаЗагрузкиПроценокУФ",ПараметрыФормы,ЭтаФорма,,,,Оповещение);
	
	ТабПроценкиПриАктивизацииСтроки(Неопределено);
	ПроценкиИзменены=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыборПроценокНаКлиенте(Результат,Параметры) Экспорт
	ВыборПроценокНаСервере(Результат);
КонецПроцедуры	

&НаСервере
Процедура ВыборПроценокНаСервере(Результат)
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаВыбора Из Результат Цикл
		Если НЕ СтрокаВыбора.Загружать Тогда
			Продолжить;
		КонецЕсли;
		
		//Проверим на уже добавленную такуж же проценку
		НомерПроценки = 0;
		СтрНомерПроценки = "";
		Пока ТабПроценки.НайтиСтроки(Новый Структура("НаименованиеСайт", СтрокаВыбора.Сайт+СтрНомерПроценки)).Количество() > 0 Цикл
			НомерПроценки = НомерПроценки + 1;
			СтрНомерПроценки = " "+Строка(НомерПроценки);
		КонецЦикла;
		
		ТСтр=ТабПроценки.Добавить();
		ТСтр.Сайт=СтрокаВыбора.Сайт;
		ТСтр.Источник="API";
		ТСтр.НаименованиеСайт=СтрокаВыбора.Сайт+СтрНомерПроценки;
		ТСтр.Вкл = Ложь;
		Стр=СтрокаВыбора.Данные;
		ТСтр.Помощь=Стр.Помощь;
		ТСтр.Авторизация=Новый Структура();
		Для Каждого Эл Из Стр.Авторизация Цикл
			Если Не ТСтр.Авторизация.Свойство(Эл.Ключ) Тогда
				ТСтр.Авторизация.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		ТСтр.Фильтры=Новый Структура();
		Для Каждого Эл Из Стр.Фильтры Цикл
			Если Не ТСтр.Фильтры.Свойство(Эл.Ключ) Тогда
				ТСтр.Фильтры.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		ТСтр.Методы=Новый Структура();
		Для Каждого Эл Из Стр.Методы Цикл
			Если Не ТСтр.Методы.Свойство(Эл.Ключ) Тогда
				ТСтр.Методы.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры	

