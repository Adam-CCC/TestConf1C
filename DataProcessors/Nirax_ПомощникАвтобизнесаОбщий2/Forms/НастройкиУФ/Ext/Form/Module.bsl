	Иначе
		Элементы.ЗначениеТребуетсяОтветить.ЦветТекста = Новый Цвет(0,0,0);
	КонецЕсли;

	Элементы.IPКлиента.Заголовок = Обработка.ПолучитьIPКлиента();	

