Процедура ДоступыАдминПриИзменении(Элемент)
	ТекДан=Элементы.Доступы.ТекущиеДанные;
	Если ТекДан.Админ Тогда
		ТекДан.Основные=Истина;
		ТекДан.БезОграничений=Истина;
