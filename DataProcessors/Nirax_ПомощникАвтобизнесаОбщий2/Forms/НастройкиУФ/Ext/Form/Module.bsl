&НаКлиенте
Процедура ОбновитьЛичныйКабинет()
	Если ЗначениеЗаполнено(Объект.СрокПодпискиТП) Тогда   //выкуплен ПА
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.Заголовок = "Выкуплен";
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.ЦветТекста = Новый Цвет(0,128,0); 
		
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.Заголовок = Формат(Объект.СрокПодпискиТП, "ДЛФ=ДД");
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.ЦветТекста = ОпределитьЦветДляЗаголовка(Объект.СрокПодпискиТП);
	ИначеЕсли ЗначениеЗаполнено(Объект.СрокПодпискиПА) Тогда  //аренда ПА
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.Заголовок = Формат(Объект.СрокПодпискиПА, "ДЛФ=ДД");
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.ЦветТекста = ОпределитьЦветДляЗаголовка(Объект.СрокПодпискиПА);
		
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.Заголовок = "Включена";
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.ЦветТекста = Новый Цвет(0,128,0);	
	ИначеЕсли Объект.ДемоРежим Тогда //режим Демо
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.Заголовок = "Демо";
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.ЦветТекста = Новый Цвет(0,0,0); 
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.Заголовок = "Не подключена";
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.ЦветТекста = Новый Цвет(0,0,0); 		
	Иначе //купили только ПА 
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.Заголовок = "Выкуплен";
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиПА.ЦветТекста = Новый Цвет(0,128,0); 
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.Заголовок = "Не подключена";
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиТП.ЦветТекста = Новый Цвет(0,0,0); 		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СрокПодпискиБК) Тогда   //аренда БК
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиБК.Заголовок = Формат(Объект.СрокПодпискиБК, "ДЛФ=ДД");
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиБК.ЦветТекста = ОпределитьЦветДляЗаголовка(Объект.СрокПодпискиБК);
	Иначе
		ЭтаФорма.Элементы.ЗначениеСрокПодпискиБК.Заголовок = "Не подключена";
	КонецЕсли;	
	
	ОбновитьЛичныйКабинетНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЛичныйКабинетНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");	
	Рез = Обработка.ПолучитьДанныеПоТехПоддержке();
	Элементы.ЗначениеЗаявокВРаботе.Заголовок = Рез.КолЗаявок;
	Элементы.ЗначениеТребуетсяОтветить.Заголовок = Рез.КолОтветить;
