&НаСервере    //!!!
Процедура ЗаписатьПроценкиНаСервере()
	Проценки=ТабПроценки.Выгрузить(Новый Массив);
	Проценки.Колонки.Добавить("Склады",НОвый ОписаниеТипов("ТаблицаЗначений"));
	Для Каждого Стр из ТабПроценки Цикл
		Нов=Проценки.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Стр);
		Нов.Склады=Стр.Склады.Выгрузить();
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Проценки",Проценки,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
Конецпроцедуры

&НаКлиенте
Процедура ТабПроценкиПриАктивизацииСтроки(Элемент)

	Если ДанныеПроценкиИзменены Тогда
		//Изменение значений структуры данных
		СвойстваД=Новый Структура;
		Для Каждого Элем Из ДанныеПроценки Цикл
			Попытка
				СвойстваД.Вставить(Элем.Ключ,Элем.Значение);
			Исключение
			КонецПопытки;
		КонецЦикла;
		ТекПроценка.Авторизация = СвойстваД;
		ДанныеПроценкиИзменены=Ложь;
	КонецЕсли;
	
	Если СкладыПроценкиИзменены Тогда
		ТекПроценка.Склады.Очистить();
		Для Каждого стр Из СкладыПроценки цикл
			ЗаполнитьЗначенияСвойств(ТекПроценка.Склады.Добавить(),Стр);
		КонецЦикла;
		СкладыПроценкиИзменены=Ложь;
	КонецЕсли;
	
	Если ТекПроценка=Элементы.Проценки.ТекущиеДанные Тогда Возврат; КонецЕсли;
	
	ДанныеПроценки.Очистить();
	ТекПроценка=Элементы.Проценки.ТекущиеДанные;
	Если ТекПроценка=Неопределено Тогда
		СкладыПроценки.Очистить();
		Элементы.Группа31.Доступность=Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.Группа31.Доступность=Истина;
	Если ТекПроценка.Авторизация=Неопределено Тогда
		ТекПроценка.Авторизация=Новый Структура;
	КонецЕсли;
	Если ТекПроценка.Источник="API" Тогда
		Наименования=Новый Структура("АдресДоставки,СпособДоставки,СпособОплаты,КомментарийКЗаказу,АдресСамовывоза,ДатаОтгрузки,СоздаватьЗаказ",
		"Адрес доставки","Способ доставки","Способ оплаты","Комментарий к заказу","Адрес самовывоза" ,"Дата отгрузки","Создавать заказ");
		Для каждого Элем из ТекПроценка.Авторизация Цикл
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ=Элем.Ключ;
			Нов.Наименование=?(Наименования.Свойство(Нов.Ключ),Наименования[Нов.Ключ],Нов.Ключ);
			Нов.Значение=Элем.Значение;
		КонецЦикла;
		Помощь=ТекПроценка.Помощь;
		Методы="";	
		Для каждого Метод из ТекПроценка.Методы Цикл
			Если Метод.Значение="1" Тогда
				Методы=Методы+Метод.Ключ+"; ";
			КонецЕсли;
		КонецЦикла;	
		Элементы.ДанныеПроценки.ТолькоПросмотр=Ложь;
		Элементы.ДанныеПроценкиПрайс.Видимость=Ложь;
	Иначе
		СвойстваД=ТекПроценка.Авторизация;
		Нов=ДанныеПроценки.Добавить();
		Нов.Ключ="dateFrom";Нов.Значение=СвойстваД.dateFrom;Нов.Наименование="Дата прайс-листа";
		Нов=ДанныеПроценки.Добавить();
		Нов.Ключ="dateDownload";Нов.Значение=СвойстваД.dateDownload;Нов.Наименование="Дата последней загрузки";
		Если ТекПроценка.Источник<>"FILE" Тогда
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="dateLastCheck";Нов.Значение=СвойстваД.dateLastCheck;Нов.Наименование="Дата последнего опроса";
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="validity";Нов.Значение=СвойстваД.validity;Нов.Наименование="Срок действия прайс-листа, час (до опроса)";
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="period";Нов.Значение=СвойстваД.period;Нов.Наименование="Частота опроса, час";
		КонецЕсли;
		Элементы.ДанныеПроценки.ТолькоПросмотр=Истина;
		Помощь="";
		Методы="";
		Элементы.ДанныеПроценкиПрайс.Видимость=Истина;
		
	КонецЕсли;
		
	//Если ТекПроценка.Источник="API" Тогда
	//ИначеЕсли ТекПроценка.Источник="FILE" Тогда
	//	Помощь="";
	//ИначеЕсли ТекПроценка.Источник="EMAIL" Тогда
	//	Помощь="";
	//КонецЕсли;
	
	СкладыПроценки.Очистить();
	Для Каждого Стр Из ТекПроценка.Склады Цикл
		ЗаполнитьЗначенияСвойств(СкладыПроценки.Добавить(),Стр);
	КонецЦикла;
	
КонецПроцедуры

