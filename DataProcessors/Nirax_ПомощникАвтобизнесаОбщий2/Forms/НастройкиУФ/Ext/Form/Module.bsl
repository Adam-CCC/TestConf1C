&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Метаданные.Константы.Найти("ИспользоватьСоглашенияСКлиентами")<>Неопределено Тогда
		Если Константы.ИспользоватьСоглашенияСКлиентами.Получить() Тогда
			Элементы.ТиповоеСоглашение.Видимость=Метаданные.Справочники.Найти("СоглашенияСКлиентами")<>Неопределено;
			
			ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.СоглашенияСКлиентами"); 
			Элементы.ТиповоеСоглашение.ОграничениеТипа = ОписаниеТипа;
		КонецЕсли;
	КонецЕсли;
	
	// Список выбора для РеквизитНомераДляПоиска
	Если Метаданные.Справочники.Найти("Номенклатура")<>Неопределено Тогда
		Реквизиты=Метаданные.Справочники.Номенклатура.Реквизиты;
		Если Реквизиты.Найти("Артикул")<>Неопределено Тогда 
			Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("Артикул",Реквизиты.Артикул.Синоним);
		КонецЕсли;
		Если Реквизиты.Найти("АртикулДляПоиска")<>Неопределено Тогда 
			Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("АртикулДляПоиска",Реквизиты.АртикулДляПоиска.Синоним);
		КонецЕсли;
		Если Реквизиты.Найти("ор_НомерПоКаталогу")<>Неопределено Тогда 
			Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("ор_НомерПоКаталогу",Реквизиты.ор_НомерПоКаталогу.Синоним);
		КонецЕсли;
		Если Реквизиты.Найти("НомерПоКаталогу")<>Неопределено Тогда 
			Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("НомерПоКаталогу",Реквизиты.НомерПоКаталогу.Синоним);
		КонецЕсли;
		Если Реквизиты.Найти("Вес")=Неопределено Тогда
			Элементы.НеОбнВес.Видимость=Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Страница") Тогда
		Если Параметры.Страница="ТехПоддержка" Тогда
			Элементы.Группа21.ТекущаяСтраница = Элементы.Группа21.ПодчиненныеЭлементы.ТехПоддержка;
		КонецЕсли;
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("Номенклатура") <> Неопределено Тогда
		Объект.ЕстьНоменклатура = ИСтина;
	Иначе
		Объект.ЕстьНоменклатура = Ложь;
		ЗаполнитьНачальныеНастройкиДляПустойБазы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачальныеНастройкиДляПустойБазы()
	//уберем лишние элементы для пустой базы
	//Основные настройки
	Элементы.ПараметрыПодключения.Видимость = Ложь;
	Элементы.ОчиститьБаза.Видимость = Ложь;
	Элементы.ГруппаЗначенияНоменклатуры.Видимость = Ложь;
	Элементы.ТипЦенЗакупка.Доступность = Ложь;
	Элементы.ТипЦен.Доступность = Ложь;
	Элементы.Группа19_Синонимы.Доступность=Ложь;
	//Элементы.Группа22.Доступность=Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВладелецФормы.ФормыПАВставить("НастройкиУФ",ЭтаФорма);
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца=Истина;
	ВладелецОбъект = ЭтаФорма.ВладелецФормы.Объект;
	Попытка
	   ЗаполнитьЗначенияСвойств(Объект,ВладелецОбъект,,
	   "ЗаказыКлиентов,ЗаявкаНаОформление,ЗаявкаПоставщику,ОчищеннаяТаблица,УточнениеПоиска,РезультатПоискаОнлайн, 
	   |МоиЗаявки,МоиЗаявкиКомментарии,ААОткрытиеОбработки,ОбучающиеСтатьи"); //зк()
    Исключение
	   Сообщить(ОписаниеОшибки());
   КонецПопытки;
    
	// Проценки начальные значения
	КодыПрайсов = ЗагрузитьТабПроценки();
	Если КодыПрайсов<>"" Тогда
		// Запрос на обновление данных о прайсах
		Запрос="{""action"":""getPrices"",""idPrices"":"""+Сред(КодыПрайсов,3)+""",""schema"":""pricelists""}";
		ЭтаФорма.ВладелецФормы.СендерОтправить(Запрос); // см.ОбновитьПрайсы
	КонецЕсли;
	
	ДанныеПроценкиИзменены=Ложь; ПроценкиИзменены=Ложь; СкладыПроценкиИзменены=Ложь;
	Элементы.Помощь.ТолькоПросмотр=Истина;
	// ограничения на доступность элементов формы
	Элементы.ВидНоменклатуры.Видимость=Объект.ВидНоменклатуры<>Неопределено;
	Если Строка(ТипЗнч(Объект.ВидНоменклатуры))="Категория номенклатуры" Тогда
		Элементы.ВидНоменклатуры.Заголовок="Категория номенклатуры";
	КонецЕсли;
	Элементы.ЦеноваяГруппа.Видимость=Объект.ЦеноваяГруппа<>Неопределено;
	Элементы.Группа31.Доступность=Элементы.Проценки.ТекущиеДанные<>Неопределено;
	
	РеквизитНомераДляПоискаПриИзменении(Неопределено);
	//-
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + ": Помощник автобизнеса " + Объект.Версия;
	    
	ОбновитьВидимостьПодсказок();  //Глухов 290618
	ОбновитьЛичныйКабинет();
	Группа21ПриСменеСтраницы(Элементы.Группа21,Элементы.Группа21.ТекущаяСтраница);
	Доступ=ПолучитьДоступНаСервере();
	Попытка
		Если Не Доступ.Админ Тогда
			Элементы.Администрирование.Доступность=Ложь;
			Если Не Доступ.Поставщики Тогда 
				Элементы.Группа22.Доступность=Ложь;
			КонецЕсли;
			Если Не Доступ.Основные Тогда
				Элементы.Группа23.Доступность=Ложь;
			ИначеЕсли Не Доступ.БезОграничений Тогда
				Элементы.ГруппаПараметрыПодключения.Доступность=Ложь;
				Элементы.УровниЦен.Доступность=Ложь;
				Элементы.ЗапретитьРедактированиеЦенВКорзине.Доступность=Ложь;
				Элементы.ЗаказВКомментарий.Доступность=Ложь;
				Элементы.ВсеЗаявкиПоставщику.Доступность=Ложь;
				Элементы.ГруппаЗначенияНоменклатуры.Доступность=Ложь;
				Элементы.СендерОтладка.Доступность=Ложь;
			КонецЕсли;
		КонецЕсли;
	Исключение 
	Конецпопытки;
	
	Если ВладелецФормы.Объект.ПоУмолчанию.Количество()>0 Тогда
		Для Каждого Стр Из ВладелецФормы.Объект.ПоУмолчанию Цикл
			Нов=ПоУмолчанию.Добавить();
			Нов.Имя=Стр.Ключ;
			Нов.Наименование=Стр.Значение.Наименование;
			Нов.Значение=Стр.Значение.Значение;
		КонецЦикла;
	Иначе
		Элементы.ГруппаПоУмолчанию.Видимость=Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если (Объект.РежимМодальности И ПроценкиИзменены)Тогда
		Если Вопрос("Данные настроек были изменены, сохранить изменения?",РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда
			СохранитьНастройки(Неопределено);
		КонецЕсли;
	КонецЕсли;
		
	//Перезапись объекта с изменениями в основную форму
	Попытка
		ВладелецОбъект = ЭтаФорма.ВладелецФормы.Объект;
		ЗаполнитьЗначенияСвойств(ВладелецОбъект,Объект,,
		"ЗаявкаНаОформление,ЗаявкаПоставщику,ОчищеннаяТаблица,УточнениеПоиска,РезультатПоискаОнлайн,МоиЗаявки,МоиЗаявкиКомментарии,ОбучающиеСтатьи,ЗаказыКлиентов");//зк()
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ЗагрузитьТабПроценки()
	Обоработка = РеквизитФормыВЗначение("Объект");
	Обоработка.ОбновитьДанныеПоОнлайнПоставщикам();
	Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	//Если ТипЗнч(Проценки)<>Тип("ТаблицаЗначений") ТОгда
	//	Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);    
	//КонецЕсли;
	Если ТипЗнч(Проценки)<>Тип("ТаблицаЗначений") ТОгда
		Проценки=Новый ТаблицаЗначений; 
	КонецЕсли;
	
	//Загрузка данных проценок
	ПКолонки=Проценки.Колонки;
	Если ПКолонки.Найти("Вкл")=Неопределено Тогда ПКолонки.Добавить("Вкл",Новый ОписаниеТипов("Булево"));КонецЕсли;
	Если ПКолонки.Найти("Сайт")=Неопределено Тогда ПКолонки.Добавить("Сайт",Новый ОписаниеТипов("Строка"));КонецЕсли;
	Если ПКолонки.Найти("Поставщик")=Неопределено Тогда 
		Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено Тогда
			ПКолонки.Добавить("Поставщик",Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		Иначе
			ПКолонки.Добавить("Поставщик",Новый ОписаниеТипов("Строка"));
		КонецЕсли;
	КонецЕсли;
	Если ПКолонки.Найти("Помощь")=Неопределено Тогда ПКолонки.Добавить("Помощь",Новый ОписаниеТипов("Строка"));КонецЕсли;
	Если ПКолонки.Найти("Проверка")=Неопределено Тогда ПКолонки.Добавить("Проверка",Новый ОписаниеТипов("Булево"));КонецЕсли;
	Если ПКолонки.Найти("Авторизация")=Неопределено Тогда ПКолонки.Добавить("Авторизация");КонецЕсли;
	Если ПКолонки.Найти("Фильтры")=Неопределено Тогда ПКолонки.Добавить("Фильтры");КонецЕсли;
	Если ПКолонки.Найти("Методы")=Неопределено Тогда ПКолонки.Добавить("Методы");КонецЕсли;
	Если ПКолонки.Найти("ОтПоставщика")=Неопределено Тогда ПКолонки.Добавить("ОтПоставщика",Новый ОписаниеТипов("Строка"));КонецЕсли;
	Если ПКолонки.Найти("СрокПлюс")=Неопределено Тогда ПКолонки.Добавить("СрокПлюс",Новый ОписаниеТипов("Число"));КонецЕсли;
	Если ПКолонки.Найти("Источник")=Неопределено Тогда ПКолонки.Добавить("Источник",Новый ОписаниеТипов("Строка"));КонецЕсли;
	СкладыВТаблицу(Проценки);
	// Добавляем информацию из прайс-листов
	КодыПрайсов="";
	ПустыеПрайсы=Новый Массив;
	
	Проценки.ЗаполнитьЗначения(Ложь,"Проверка");     //)
	Для каждого Запись из Проценки Цикл
		Запись.Сайт = НРЕГ(Запись.Сайт);	
		Если Пустаястрока(Запись.Источник) Тогда 
			Запись.Источник="API";
		ИначеЕсли Запись.Источник<>"API" Тогда
			Если ПустаяСтрока(Запись.Сайт) Тогда
				ПустыеПрайсы.Вставить(0,Запись);
			Иначе
				КодыПрайсов=КодыПрайсов+", "+Сред(Запись.Сайт,3);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из ПустыеПрайсы Цикл
		Проценки.Удалить(Стр);
	КонецЦикла;
	
	Если ПКолонки.Найти("НаименованиеСайт")=Неопределено Тогда 
		ПКолонки.Добавить("НаименованиеСайт",Новый ОписаниеТипов("Строка"));
		Для каждого Запись Из Проценки Цикл
			Запись.НаименованиеСайт = Запись.Сайт;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Проценки) Тогда
		//ТабПроценки.Загрузить(Проценки);
		Для Каждого Стр Из Проценки Цикл
			Нов=ТабПроценки.Добавить();
			ЗаполнитьЗначенияСвойств(Нов,Стр,,"Склады");
			Нов.Склады.Загрузить(Стр.Склады);
		КонецЦикла;
	КонецЕсли;
	Возврат КодыПрайсов;
КонецФункции

&НаСервере
Процедура СкладыВТаблицу(Таблица)
	Колонки=Таблица.Колонки;
	кСклады=Колонки.Найти("Склады");
	Если кСклады=Неопределено Тогда 
		Колонки.Добавить("Склады",Новый ОписаниеТипов("ТаблицаЗначений"));
	ИначеЕсли ТипЗнч(кСклады)<>Тип("ТаблицаЗначений") Тогда
		кСклады.Имя="СкладыПроценки";
		Колонки.Добавить("Склады",Новый ОписаниеТипов("ТаблицаЗначений"));
		Склады0=Новый ТаблицаЗначений;
		Склады0.Колонки.Добавить("Пометка",Новый ОписаниеТипов("Булево"),"Вкл");
		Склады0.Колонки.Добавить("Значение",Новый ОписаниеТипов("Строка"),"Склад");
		Склады0.Колонки.Добавить("СрокПлюс",Новый ОписаниеТипов("Число"),"Срок+");
		Склады0.Колонки.Добавить("Комментарий",Новый ОписаниеТипов("Строка"));
		
		Для Каждого Стр Из Таблица Цикл
			Стр.Склады=Склады0.СкопироватьКолонки();
			Если Стр.СкладыПроценки.Количество()>0 Тогда
				Если ТипЗнч(Стр.СкладыПроценки)=Тип("СписокЗначений") Тогда
					Для Каждого тСклад из Стр.СкладыПроценки Цикл
						ЗаполнитьЗначенияСвойств(Стр.Склады.Добавить(),тСклад,"Пометка,Значение")
					КонецЦикла;
				ИначеЕсли ТипЗнч(Стр.СкладыПроценки)=Тип("ТаблицаЗначений") Тогда
					Для Каждого тСклад из Стр.СкладыПроценки Цикл
						ЗаполнитьЗначенияСвойств(Стр.Склады.Добавить(),тСклад);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Колонки.Удалить(кСклады);
	КонецЕсли;
КонецПроцедуры

&НаСервере  //!!!
Процедура СохранитьНастройкиНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.СохранитьНастройкиВХранилище("ОсновныеНастройки");
КонецПроцедуры

&НаКлиенте   //!!!
Процедура СохранитьНастройки(Команда)
	//Сохраниение проценок
	//Если ПроценкиИзменены Тогда
		СохранитьПроценки(Команда);
	//КонецЕсли;
	Если Доступы.Количество()>0 Тогда
		Отбор=Доступы.НайтиСтроки(Новый Структура("ДоступИзменен",Истина));
		ЕСли Отбор.Количество()>0 Тогда
			Массив=Новый Массив;
			Для каждого стр из Отбор Цикл
				Массив.Добавить(Новый Структура("Имя,Админ,Основные,БезОграничений,Поставщики,Аналитика,Комментарий",
				Стр.Имя,Стр.Админ,Стр.Основные,Стр.БезОграничений,Стр.Поставщики,Стр.Аналитика,Стр.Комментарий));
			КонецЦикла;
			СохранитьДоступыНаСервере(Массив);
		КонецЕсли;
	КонецЕсли;
	Если ПоУмолчаниюИзменены Тогда
		СохранитьПоУмолчанию();
	КонецЕсли;
	
	//Сохранение настроек
	СохранитьНастройкиНаСервере();
	ЭтаФорма.Закрыть();
КонецПроцедуры

