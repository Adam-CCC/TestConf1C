&НаСервереБезКонтекста
Процедура ДоступУдалитьНаСервере(Имя)
	УстановитьПривилегированныйРежим(Истина);
	Отбор=Новый Структура("КлючОбъекта, Пользователь","ПомощникАвтобизнеса",Имя);
	Выбор=ХранилищеОбщихНастроек.Выбрать(Отбор);
	Список=Новый СписокЗначений;
	Пока Выбор.Следующий() Цикл
		ХранилищеОбщихНастроек.Удалить("ПомощникАвтобизнеса",Выбор.КлючНастроек,Выбор.Пользователь);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ДоступУдалить(Команда)
	ТекДан = Элементы.Доступы.ТекущиеДанные;
	Если ТекДан<>Неопределено Тогда
		ОО=Новый ОписаниеОповещения("ДоступУдалитьОтвет",ЭтаФорма, ТекДан.Имя);
		ПоказатьВопрос(ОО,"Внимание!!! Все данные пользователя "+ТекДан.Имя+" будут удалены из помощника автобизнеса. Продолжить?",
		РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДоступУдалитьОтвет(Ответ, Имя) Экспорт
	Если Ответ<>КодВозвратаДиалога.Да Тогда Возврат;КонецЕсли;
	ДоступУдалитьНаСервере(Имя);
	Доступы.Удалить(Элементы.Доступы.ТекущиеДанные);	
КонецПроцедуры

&НаКлиенте
Процедура ДоступЗагрузитьНастройкиИзФайла(Команда)
	Отбор=Доступы.НайтиСтроки(Новый Структура("Выбор",Истина));
	Доп=Новый Массив;
	Если Отбор.Количество()=0 Тогда 
		ТекДан=Элементы.Доступы.ТекущиеДанные;
		Если ТекДан=Неопределено Тогда Возврат;
		ИначеЕсли ТекДан.Имя=Объект.ПользовательИмя Тогда 
			Сообщить("Загрузка своих настроек производится на вкладках <Основные настройки>-<Основные>");
			Возврат;
		КонецЕсли;
		Доп.Добавить(ТекДан.Имя);
	Иначе
		Для Каждого Стр Из Отбор Цикл
			ЕСли Стр.Имя=Объект.ПользовательИмя Тогда 
				Сообщить("Загрузка своих настроек производится на вкладках <Основные настройки>-<Основные>");
			Иначе
				Доп.Добавить(Стр.Имя);
			КонецЕсли;
		КонецЦикла;
		Если Доп.Количество()=0 Тогда Возврат;КонецЕсли;
	КонецЕсли;
	ОО=Новый ОписаниеОповещения("ДоступЗагрузитьНастройкиизФайлаОтвет",ЭтаФорма,Доп);
	ПоказатьВопрос(ОО,"Загрузка настроек для "+?(Доп.Количество()>1, Строка(Доп.Количество())+" пользователей",
	"пользователя "+Доп[0])+Символы.ПС+"Внимание!!! Для загрузки основных настроек эти пользователи"
	+Символы.ПС+"должны выйти из Помощника автобизнеса. Продолжить?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступЗагрузитьНастройкиИзФайлаОтвет(Ответ,Доп) Экспорт
	Если Ответ<>КодВозвратаДиалога.Да Тогда Возврат;КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьНастройкиВыборИзФайла",ЭтаФорма,Доп);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Файлы настроек отчетов *.rep1c|*.rep1c";
    Диалог.Показать(Оповещение);
КонецПроцедуры

&НаСервере
Процедура ДоступЗагрузкаНастроекИзФайлаНаСервере(Список,ПользователиПА)
	Имена=Новый СписокЗначений;
	Имена.Добавить("Уровней цен","УровниЦен");
	Имена.Добавить("Прайс-листов","НастройкаЗагрузки");
	Имена.Добавить("Синонимы","Синонимы");
	Имена.Добавить("Онлайн-поставщиков заменить","Проценки",);	
	Общие=Новый Массив;
	ЕстьПроценки=Ложь;
	ЕстьОбщие=Ложь;
	Для Каждого Стр из Список Цикл
		Если Не Стр.Пометка Тогда Продолжить;
		ИначеЕсли Стр.Представление="Все (онлайн-поставищики заменяются)" или Стр.Представление="Все" Тогда 
			Список.ЗаполнитьПометки(Истина);
			Продолжить;
		ИначеЕСли Стр.Представление="Онлайн-поставщиков добавить" И ЕстьПроценки Тогда
			Продолжить;
		КонецЕсли;
		ЕСли ТипЗнч(Стр.Значение)=Тип("Число") Тогда
			Значение=ЗначениеИзСтрокиВнутр(Список[Список.Индекс(Стр)-1].Значение);
		Иначе
			Значение=ЗначениеИзСтрокиВнутр(Стр.Значение);
		КонецЕсли;
		СтрТип=ТипЗнч(Значение);
		
		Если СтрТип = Тип("Структура") Тогда
			Общие.Добавить(Значение);
			ЕстьОбщие=Истина;
		ИначеЕсли СтрТип = Тип("СписокЗначений") Тогда
			Для Каждого Эл из Значение Цикл
				ДоступСохранитьВХранилищеНастройки(Эл.Представление,Эл.Значение,ПользователиПА);
			КонецЦикла;	
		ИначеЕсли Лев(Стр.Представление,18)="Онлайн-поставщиков" Тогда
			Если ЕстьПроценки Тогда Продолжить;КонецЕсли;
			ЕстьПроценки=Истина;
			Если Стр.Представление="Онлайн-поставщиков заменить" Тогда
				ДоступСохранитьВХранилищеНастройки("Проценки",Значение,ПользователиПА);
			Иначе
				ДоступСохранитьВХранилищеНастройки("ПроценкиДобавить",Значение,ПользователиПА);
			КонецЕсли;
		ИначеЕсли СтрТип = Тип("ТаблицаЗначений") Тогда
			Имя=Имена.НайтиПоЗначению(Стр.Представление);
			ДоступСохранитьВХранилищеНастройки(Имя.Представление,Значение,ПользователиПА);
		ИначеЕсли СтрТип = Тип("ДеревоЗначений") Тогда
			Имя=Имена.НайтиПоЗначению(Стр.Представление);
			ДоступСохранитьВХранилищеНастройки(Имя.Представление,Значение,ПользователиПА);
		КонецЕсли;
	КонецЦикла;
	Если ЕстьОбщие Тогда
		ДоступСохранитьВХранилищеНастройки("ОбъектMySQL",Общие,ПользователиПА);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДоступСохранитьВХранилищеНастройки(Ключ,Значение,ПользователиПА)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Для Каждого Стр Из ПользователиПА Цикл
			ЕСли Ключ="ОбъектMySQL" Тогда
				Если Значение.Количество()=0 Тогда Возврат;КонецЕсли;
				Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса", "ОбъектMySQL",,Стр);
				Если ТипЗнч(Данные)<>Тип("Структура") Тогда
					// На всякий случай. Теоретически данные должны быть определены
					Данные = Новый Структура(
					"АналогиЕстьВ1С,АртикулОчищать,БанковскийСчетДляЗаявки,БезАналогов,БезПрименяемости,ВидНоменклатуры,
					|ВКорзину,ВыбиратьГруппу,ВыводитьАналоги,ВыводитьНаличие,Группировать,ЗаказПокупателя,ЗаписьШтрихкода,
					|ЗапрашиватьКоличество,ЗапрашиватьСкидку,ЗапрашиватьЦену,ИспользоватьПроценкуОнлайнПоставщиков,
					|ИспользоватьЦены,КассаККМ,КонтрольОстатков,НДСПоУмолчанию,ОбщийПоиск,ОрганизацияДляЗаявки,
					|ОтборПроизводители,ПутьКВременнойПапке,РеализацияТоваров,Склад,СортироватьТолькоПоЦенам,ПроводитьДокументы,
					|СчетФактура,ТипЦен,ЦеноваяГруппа,ШаблонНаименования,ШаблонНаименованияП,ШаблонНомераДляПоиска,
					|РеквизитНомераДляПоиска,ИспользоватьСинонимы,ЗапрашиватьГруппуНоменклатуры,ПоискПоОчищенному,ГруппаНоменклатуры,
					|ПоказатьЗамерПроизводительностиПоиска,БазоваяЕдиницаИзмерения, ТипЦенЗакупка, ИспользоватьБазуКроссов, 
					|ИспользоватьПрайсЛист, ИспользоватьПоискПоАвтомобилю,
					|ОтключитьПодсказкиВидеоИнструкций,ИспользоватьЗаказПоставщику,СортировкаОнлайнПоставщики, СортировкаОнлайнПоставщикиНаправление,
					|ЗаполнятьЗаказПриДобавленииВОнлайнКорзину,ЗапретитьРедактированиеЦенВКорзине,ИспользоватьСжатиеДанных,ЗаказВКомментарий,СборАналитики");
				КонецЕсли;
				Для Каждого Структ из Значение Цикл
					ЗаполнитьЗначенияСвойств(Данные, Структ);
				КонецЦикла;
				ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","ОбъектMySQL",Данные,,Стр);
			ИначеЕсли Ключ="ПроценкиДобавить" Тогда
				Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса", "Проценки",,Стр);
				Для каждого эл из Значение Цикл
					ЗаполнитьЗначенияСвойств(Данные.Добавить(),эл);
				КонецЦикла;
				ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Проценки",Данные,,Стр);
			Иначе
				ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса",Ключ,Значение,,Стр);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Ошибки при загрузке настроек: "+ОписаниеОшибки());
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


#КонецОбласти

#Область СкладыПроценки

&НаКлиенте
Процедура СкладыПриИзменении(Элемент)
	СкладыПроценкиИзменены=Истина;
	ПроценкиИзменены=Истина;
КонецПроцедуры

&НаКлиенте
Процедура СкладыУстановитьФлажки(Команда)
	Флаг=Команда.Имя="СкладыУстановитьФлажки";
	Для каждого Стр Из СкладыПроценки Цикл
		Инд=Стр.ПолучитьИдентификатор();
		Если Элементы.СкладыПроценки.ПроверитьСтроку(Инд)=Истина Тогда
			  Стр.Пометка = Флаг;
		КонецЕсли; 
	КонецЦикла; 
	СкладыПроценкиИзменены=Истина;
	ПроценкиИзменены=Истина;
КонецПроцедуры

#КонецОбласти

#Область ПоУмолчанию

&НаКлиенте
Процедура ПоУмолчаниюЗначениеПриИзменении(Элемент)
	ПоУмолчаниюИзменены=Истина;
КонецПроцедуры

