&НаСервере 
Функция СоединениеССерверомБыла()
	
	Попытка
		Если Объект.Конфигурация = "УправлениеТорговлей 11.0" Тогда
			Соединение = Новый FTPСоединение("109.188.66.72/", , "ut11", "11155");
			СписокФайлов = Соединение.НайтиФайлы("prof/version.txt");
		ИначеЕсли Объект.Конфигурация = "УправлениеТорговлей 11.1.2" Тогда
			Соединение = Новый FTPСоединение("109.188.66.72/", , "", "");
			СписокФайлов = Соединение.НайтиФайлы("version.txt");
		ИначеЕсли Объект.Конфигурация = "УправлениеТорговлей 11.1.4" Тогда
			Соединение = Новый FTPСоединение("109.188.66.72/", , "", "");
			СписокФайлов = Соединение.НайтиФайлы("version.txt");
		ИначеЕсли Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" Тогда
			Соединение = Новый FTPСоединение("109.188.66.72", 21, "rma", "54321", , Истина);
			СписокФайлов = Соединение.НайтиФайлы("prof/version.txt");
		КонецЕсли;	
		Если ЗначениеЗаполнено(СписокФайлов) Тогда
			Соединение.Получить(СписокФайлов[0].ПолноеИмя, КаталогВременныхФайлов() + "\NiraxVersionInfo.txt");
			Стр = "";
			Текст = Новый ЧтениеТекста();
			Текст.Открыть(КаталогВременныхФайлов() + "\NiraxVersionInfo.txt");
			Стр = Текст.ПрочитатьСтроку();	
		КонецЕсли;
		Текст.Закрыть();
		УдалитьФайлы(КаталогВременныхФайлов() + "\NiraxVersionInfo.txt");
		Возврат Стр;
	Исключение
	  Сообщить(ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
			
КонецФункции

