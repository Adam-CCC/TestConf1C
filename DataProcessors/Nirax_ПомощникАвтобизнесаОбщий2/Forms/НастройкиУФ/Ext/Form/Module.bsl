		ПоказатьПредупреждение(,"Операция завершена!", 0, "1С: Помощник автобизнеса");		
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПрайс(Команда)
	ОО=Новый ОписаниеОповещения("ОчиститьПрайсОтвет",ЭтаФорма);
	ПоказатьВопрос(ОО,"Очистить артикулы прайс-листов от незначащих симвлов?", РежимДиалогаВопрос.ДаНет, 0);
КонецПроцедуры

&НаСервере 
Процедура ОчиститьПрайсНаСервере()
	Попытка
		Эксель = Новый COMОбъект("Excel.Application"); 
		Эксель.Displayalerts = 0;
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
		
	НастройкаЗагрузки=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","НастройкаЗагрузки",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
		
	Для каждого СтрокаТаб Из НастройкаЗагрузки Цикл
	
		Книга = Эксель.WorkBooks.Open(СокрЛП(СтрокаТаб.ПутьКФайлу));                                      
		Лист = Книга.WorkSheets(1).UsedRange;
		
		Попытка
		    ЧислоКолонка = Число(СтрокаТаб.Артикул);
		Исключение
			ЧислоКолонка = 0;
		КонецПопытки;
		
		Для К = 1 По Лист.Rows.Count Цикл
			//СтрокаТаб.Артикул
			Лист.Cells(К, ЧислоКолонка ).Value = Строка(ПодготовитьНомер(СокрЛП(Лист.Cells(К, ЧислоКолонка).Value)));
			Лист.Cells(К, ЧислоКолонка).NumberFormat = "@";			
		КонецЦикла;
			
		Попытка 		
			Книга.Save();
		Исключение
		КонецПопытки;
				
	КонецЦикла;
		
	Эксель.Application.Quit();
		
КонецПроцедуры

