&НаКлиенте
Процедура ОчиститьБазаОтвет(Ответ,Доп) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьАртикулыНаСервере();
		ПоказатьПредупреждение(,"Операция завершена!", 0, "1С: Помощник автобизнеса");
	КонецЕсли;
Конецпроцедуры

&НаКлиенте
Процедура ОчиститьБаза(Команда)
	ОО=Новый ОписаниеОповещения("ОчиститьБазаОтвет",ЭтаФорма);
	ПоказатьВопрос(ОО,"ПРЕДУПРЕЖДЕНИЕ: Перед началом очистки сделайте ОБЯЗАТЕЛЬЛЬНО копию текущей базы. Очистить артикулы номенклатуры от незначащих символов?", РежимДиалогаВопрос.ДаНет, 0);
КонецПроцедуры

&НаСервере
Процедура ОчиститьАртикулыНаСервере()
	
    Выборка = Справочники.Номенклатура.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.ЭтоГруппа Тогда
			СправочникОбъект = Выборка.ПолучитьОбъект();
			СправочникОбъект.Артикул = ПодготовитьНомер(СокрЛП(СправочникОбъект.Артикул));
			Попытка
			    СправочникОбъект.Записать();
			Исключение
				Сообщить("Номенклатура " + СправочникОбъект.Наименование + " не обработана! " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла; 
		
КонецПроцедуры
	
&НаКлиентеНаСервереБезКонтекста	
Функция ПодготовитьНомер(СтрНомер)
		
	СтрНомер=СокрЛП(строка(СтрНомер));
	СтрНомер=Стрзаменить(СтрНомер,символы.НПП,"");
	СтрНомер=Стрзаменить(СтрНомер,",","");
	СтрНомер=Стрзаменить(СтрНомер,")","");
	СтрНомер=Стрзаменить(СтрНомер,"(","");
	СтрНомер=Стрзаменить(СтрНомер,"-","");
	СтрНомер=Стрзаменить(СтрНомер,".","");
	СтрНомер=Стрзаменить(СтрНомер," ","");
	СтрНомер=Стрзаменить(СтрНомер,"_",""); // Символ подчеркивания является значимым
	СтрНомер=Стрзаменить(СтрНомер,"-","");
	СтрНомер=Стрзаменить(СтрНомер,"""","");
	СтрНомер=Стрзаменить(СтрНомер,"'","");
	СтрНомер=Стрзаменить(СтрНомер,":","");
	СтрНомер=Стрзаменить(СтрНомер,";","");
	СтрНомер=Стрзаменить(СтрНомер,"/","");
	СтрНомер=Стрзаменить(СтрНомер,"|","");
	СтрНомер=Стрзаменить(СтрНомер,"\","");
	СтрНомер=Стрзаменить(СтрНомер,"!","");
	СтрНомер=Стрзаменить(СтрНомер,"#","");
	СтрНомер=Стрзаменить(СтрНомер,"№","");
	СтрНомер=Стрзаменить(СтрНомер,"?","");
	СтрНомер=Стрзаменить(СтрНомер,"*","");
	Возврат ВРЕГ(СтрНомер);
	
Конецфункции

