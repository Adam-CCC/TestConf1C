&НаКлиенте
Процедура Проверка(Команда)
	// Записать последние изменения
	Если ТекПроценка=Неопределено Тогда Возврат;КонецЕсли; 
	Если ТекПроценка.Источник<>"API" Тогда 
		Ошибка=ПроверкаПрайс(ТекПроценка);	
		Если Ошибка="" Тогда
			ТекПроценка.Проверка=Истина;	
		Иначе
			Сообщить(Ошибка);
			ТекПроценка.Проверка=Ложь;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ДанныеПроценкиИзменены=Истина Тогда
		//Изменение значений структуры данных
		СвойстваД=Новый Структура;
		Для Каждого Элем Из ДанныеПроценки Цикл
			СвойстваД.Вставить(Элем.Ключ,Элем.Значение);
		КонецЦикла;
		ТекПроценка.Авторизация = СвойстваД;
	КонецЕсли;
	ОтветОтПоставщика = "";
	Ошибки=ПроверкаНаСервере(Новый Структура("Сайт,Авторизация,Методы",ТекПроценка.Сайт,ТекПроценка.Авторизация,ТекПроценка.Методы), ОтветОтПоставщика);
	Если Ошибки="" Тогда 
		ТекПроценка.Проверка=Истина;
	Иначе
		Попытка
			ПоказатьПредупреждение(,"Ошибки при подключении: "+Ошибки); 
		Исключение
			Сообщить("Ошибки при подключении: "+Ошибки); 
		Конецпопытки;
		ТекПроценка.Проверка=Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтветОтПоставщика) Тогда
		ТекПроценка.ОтПоставщика = ОтветОтПоставщика;
		Элементы.Группа31.ТекущаяСтраница = Элементы.СтраницаОтПоставщика;
	КонецЕсли;
КонецПроцедуры

