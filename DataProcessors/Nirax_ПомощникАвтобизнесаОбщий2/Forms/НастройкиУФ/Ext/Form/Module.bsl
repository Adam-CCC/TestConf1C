&НаСервереБезКонтекста
Функция ЗагрузитьИзХранилищаПА(КлючНастроек)
	Возврат ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса",КлючНастроек,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьВХранилищеПА(КлючНастроек,Значение)
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса",КлючНастроек,Значение,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьГруппы(Команда)
	Группы=ЗагрузитьИзХранилищаПА("ГруппыПоставщиков");
	ЭлементыГрупп=Новый СписокЗначений;
	Для Каждого Стр Из ТабПроценки Цикл
		//Если Стр.Вкл Тогда
			ЭлементыГрупп.Добавить(Стр.НаименованиеСайт);
		//КонецЕсли;
	КонецЦикла;
	ОО=Новый ОписаниеОповещения("ЗаписатьГруппыПоставщиков",ЭтаФорма);
	ОткрытьФорму("ВнешняяОбработка.Nirax_ПомощникАвтобизнесаОбщий.Форма.ГруппыУФ",
	Новый Структура("Группы,ЭлементыГрупп,Заголовок,ЗаголовокГруппы",
	Группы,ЭлементыГрупп,"Группы поставщиков","Поставщики"),ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,ОО,
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьГруппыПоставщиков(Группы,Доп=Неопределено) Экспорт
	Если Группы=Неопределено Тогда Возврат; КонецЕсли;
	СохранитьВХранилищеПА("ГруппыПоставщиков",Группы);
	Список=ВладелецФормы.Элементы.ГруппаПоставщиков.СписокВыбора;
	Список.Очистить();
	//Список.Добавить(""," ");
	Для Каждого Стр из Группы Цикл
		Список.Добавить(Стр.Представление);
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИспользоватьСинонимыПриИзмененииНаСервере()
		Выб=ХранилищеОбщихНастроек.Выбрать(Новый Структура("КлючОбъекта, КлючНастроек, Пользователь",
		"ПомощникАвтобизнеса","Синонимы",ПользователиИнформационнойБазы.ТекущийПользователь().Имя));
		Возврат Выб.Следующий();
КонецФункции

&НаКлиенте
Процедура ИспользоватьСинонимыПриИзменении(Элемент)
	Если Объект.ИспользоватьСинонимы=Истина Тогда
		Если Не ИспользоватьСинонимыПриИзмененииНаСервере() Тогда
			Объект.ИспользоватьСинонимы=Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоставщика(Команда)
	Список=Новый СписокЗначений;
	Список.Добавить("API");
	Список.Добавить("PRICE");
	ОО=Новый ОписаниеОповещения("ДобавлениеПоставщика",ЭтаФорма,Список);
	Список.ПоказатьВыборЭлемента(ОО,"Выберите источник данных");
КонецПроцедуры
	
&НаКлиенте
Процедура ДобавлениеПоставщика(Источник,Доп=Неопределено) Экспорт
	Если Источник=Неопределено Тогда Возврат;КонецЕсли;
	
	Если Источник.Значение="API" ТОгда
		Текст=ПолучитьПоставщиковAPI();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Проценки = ПрочитатьJSON(ЧтениеJSON, Ложь);
		Если Проценки=Неопределено тогда возврат;КонецЕсли;
		
		Список=Новый СписокЗначений;
		Для Каждого Стр из Проценки Цикл
			Список.Добавить(Стр,Стр.Сайт);
		КонецЦикла;
		Список.СортироватьПоПредставлению();
		ОО=Новый ОписаниеОповещения("ДобавлениеПоставщикаAPI",Этаформа);
		Список.ПоказатьВыборЭлемента(ОО,"Выберите сайт Поставщика");
	Иначе
		Запрос="{""action"":""getUser"", ""schema"":""pricelists""}";
		ЭтаФорма.ВладелецФормы.СендерОтправить(Запрос);	// см. ВыбратьПрайсДляДобавления
	КонецЕсли;
	
КонецПроцедуры


&НаСервере	
Функция ПолучитьПоставщиковAPI()
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьСписокПроценок();
КонецФункции
	
&НаКлиенте
Процедура ДобавлениеПоставщикаAPI(Данные,Доп=Неопределено) Экспорт
	Если Данные=Неопределено Тогда возврат;КонецЕсли;
	Стр=Данные.Значение;
	// Определим наименование
	НомерПроценки = 0;
	СтрНомерПроценки = "";
	Пока ТабПроценки.НайтиСтроки(Новый Структура("НаименованиеСайт", Стр.Сайт+СтрНомерПроценки)).Количество() > 0 Цикл
		НомерПроценки = НомерПроценки + 1;
		СтрНомерПроценки = " "+Строка(НомерПроценки);
	КонецЦикла;
	ТСтр=ТабПроценки.Добавить();
	ТСтр.Сайт=Стр.Сайт;
	ТСтр.Источник="API";
	ТСтр.НаименованиеСайт=ПолучитьНаименование(Стр.Сайт); //+СтрНомерПроценки;
	ТСтр.Вкл = Ложь;
	//Стр=СтрокаВыбора.Данные;
	ТСтр.Помощь=Стр.Помощь;
	ТСтр.Авторизация=Новый Структура();
	Для Каждого Эл Из Стр.Авторизация Цикл
		Если Не ТСтр.Авторизация.Свойство(Эл.Ключ) Тогда
			ТСтр.Авторизация.Вставить(Эл.Ключ,Эл.Значение);
		КонецЕсли;
	КонецЦикла;
	ТСтр.Фильтры=Новый Структура();
	Для Каждого Эл Из Стр.Фильтры Цикл
		Если Не ТСтр.Фильтры.Свойство(Эл.Ключ) Тогда
			ТСтр.Фильтры.Вставить(Эл.Ключ,Эл.Значение);
		КонецЕсли;
	КонецЦикла;
	ТСтр.Методы=Новый Структура();
	Для Каждого Эл Из Стр.Методы Цикл
		Если Не ТСтр.Методы.Свойство(Эл.Ключ) Тогда
			ТСтр.Методы.Вставить(Эл.Ключ,Эл.Значение);
		КонецЕсли;
	КонецЦикла;
	Элементы.Проценки.ТекущаяСтрока=ТСтр.ПолучитьИдентификатор();
КонецПроцедуры	

&НаКлиенте
Процедура ПроценкиНаименованиеСайтОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Если ПустаяСтрока(Текст) Тогда
		ТекДан.Вкл=Ложь;
	Иначе
		Строки=ТабПроценки.НайтиСтроки(Новый Структура("НаименованиеСайт",Текст));
		Если Строки.Количество()>1 или (Строки.Количество()=1 И Строки[0]<>ТекДан) Тогда
			Значение=ПолучитьНаименование(Текст,ТекДан);
			ДанныеВыбора=Новый СписокЗначений;
			ДанныеВыбора.Добавить(Значение);
			СтандартнаяОбработка=Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНаименование(Текст,ТекСтр=Неопределено)
	// Выделяем номер проценки
	Кол=СтрДлина(Текст);
	СтрНомерПроценки = "";
	Разделитель=" ";
	Для Поз=1 по Кол Цикл
		Символ=Сред(Текст,Кол-Поз+1,1);
		Если Символ>="0" и Символ<="9" Тогда
			СтрНомерПроценки=Символ+СтрНомерПроценки;
		Иначе
			ИмяПроценки=Лев(Текст,Кол-Поз+1);
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если СтрНомерПроценки="" Тогда
		НомерПроценки=0;
	Иначе
		НомерПроценки=Число(СтрНомерПроценки);
		Разделитель="";
	КонецЕсли;
	
	Пока Истина Цикл
		Строки=ТабПроценки.НайтиСтроки(Новый Структура("НаименованиеСайт", ИмяПроценки+СтрНомерПроценки));
		Если Строки.Количество()=0 ИЛИ (Строки.Количество()=1 И Строки[0]=ТекСтр) Тогда
			Прервать;
		КонецЕсли;
		НомерПроценки = НомерПроценки + 1;
		СтрНомерПроценки = Разделитель+Формат(НомерПроценки,"ЧН=");
	КонецЦикла;
	Возврат ИмяПроценки+СтрНомерПроценки;
	
КонецФункции	

// Обновляет данные о прайсах, полученные из сендера
&НаКлиенте
Процедура ОбновитьПрайсы(Данные) Экспорт
	Для Каждого ТекСтр из Данные Цикл
		Строки=ТабПроценки.НайтиСтроки(Новый Структура("Сайт","id"+Формат(ТекСтр.idPrice,"ЧЦ=6;ЧВН=;ЧГ=")));
		Если Строки.Количество()>0 Тогда
			Стр=Строки[0];
			Стр.Авторизация.Очистить();
			Стр.Авторизация.Вставить("dateFrom",ТекСтр.dateFrom);
			Стр.Авторизация.Вставить("dateDownload",ТекСтр.dateDownload);
			Стр.Авторизация.Вставить("dateLastCheck",ТекСтр.dateLastCheck);
			Стр.Авторизация.Вставить("validity",ТекСтр.validity);
			Стр.Авторизация.Вставить("period",ТекСтр.period);
			Стр.Авторизация.Вставить("settings",ТекСтр.settings);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Формирует список прайсов для добавления из данных запроса
&НаКлиенте
Процедура ВыбратьПрайсДляДобавления(Данные) Экспорт
	Список=Новый СписокЗначений;
	Список.Добавить("FILE","FILE - Новый постащик");
	Список.Добавить("EMAIL","EMAIL - Новый Поставщик");
	Для Каждого Стр Из Данные Цикл
		Если ТабПроценки.НайтиСтроки(Новый Структура("Сайт","id"+Формат(Стр.idPrice,"ЧЦ=6;ЧВН=;ЧГ="))).Количество()=0  Тогда
			Список.Добавить(Стр,Стр.source+" - "+Стр.supplier);
		КонецЕсли;
	КонецЦикла;
	ОО=Новый ОписаниеОповещения("ВыбранПрайсДляДобавления",ЭтаФорма);
	Список.ПоказатьВыборЭлемента(ОО,"Выберите прайс поставщика");
КонецПроцедуры

&НаКлиенте
Процедура ВыбранПрайсДляДобавления(Стр, Доп=Неопределено) Экспорт
	Если Стр=Неопределено тогда возврат;КонецЕсли;
	Стр=Стр.Значение;
	Если ТипЗнч(Стр)=Тип("Строка") тогда
		Нов=ТабПроценки.Добавить();
		Нов.Источник=Стр;
		Нов.НаименованиеСайт=ПолучитьНаименование("Поставщик");
		Нов.Методы=Новый структура("Поиск,Корзина","1","1");
		Нов.Фильтры=Новый Структура;
		Нов.Авторизация=Новый Структура("dateFrom,dateDownload,dateLastCheck,validity,period,settings",
		Неопределено, Неопределено, Неопределено,24,0);
		Если Стр="FILE" Тогда
			Нов.Авторизация.settings="{""ФайлШаблон"":"""",""ZipАрхив"":false}";
		ИначеЕсли Стр="EMAIL" Тогда
			Нов.Авторизация.settings="{""Отправитель"":"""",""Получатель"":"""",""ПочтовыйЯщик"":"""",""Тема"":"""",""Вложение"":"""",""ZipАрхив"":false}";
			//Нов.Авторизация.settings=Новый Структура("Отправитель,Получатель,ПарольПолучателя,ПочтовыйЯщик,Тема,Вложение,ФорматДанных,ZipАрхив","","","","","","","",Ложь);
		КонецЕсли;
		
		Запрос=Новый Структура("action,schema,index,supplier,source,validity,period,settings",
		"add","pricelists",ТабПроценки.Индекс(Нов),Нов.НаименованиеСайт,Нов.Источник,
		Нов.Авторизация.validity,Нов.Авторизация.period,Нов.Авторизация.settings);
		ЭтаФорма.ВладелецФормы.СендерОтправить(Запрос);  // ПрайсДобавлен
		Элементы.Проценки.ТекущаяСтрока=Нов.ПолучитьИдентификатор();
	Иначе
		Нов=ТабПроценки.Добавить();
		Нов.Источник=Стр.source;
		Нов.НаименованиеСайт=ПолучитьНаименование(Стр.supplier);
		Нов.Сайт="id"+Формат(Стр.idPrice,"ЧЦ=6;ЧВН=;ЧГ=");
		Нов.Методы=Новый структура("Поиск,Корзина","1","1");
		Нов.Фильтры=Новый Структура;
		Нов.Авторизация=Новый Структура("dateFrom,dateDownload,dateLastCheck,validity,period,settings",
		Стр.dateFrom,Стр.dateDownload,Стр.dateLastCheck,Стр.validity,Стр.period,Стр.settings);
		Элементы.Проценки.ТекущаяСтрока=Нов.ПолучитьИдентификатор();
		ЗаписатьПроценкиНаСервере();
		ПроценкиИзменены=Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрайсДобавлен(data) Экспорт
	ТабПроценки[data.index].Сайт="id"+Формат(data.idPrice,"ЧЦ=6;ЧВН=;ЧГ=");
	ТабПроценки[data.index].НаименованиеСайт=data.supplier;
	ЗаписатьПроценкиНаСервере();
	ПроценкиИзменены=Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДаты(Команда)
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Запрос=Новый Структура("action,schema,idPrice","getPrice","pricelists",Сред(ТекДан.Сайт,3));
	ВладелецФормы.СендерОтправить(Запрос); // ОбновлениеДат
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеДат(Данные) Экспорт
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Сайт="id"+Формат(Данные.idPrice,"ЧЦ=6;ЧГ=;ЧВН=");
	Если ТекДан.Сайт=Сайт Тогда
		Авторизация=ТекДан.Авторизация;
		Авторизация.Очистить();
		Авторизация.Вставить("dateFrom",Данные.dateFrom);
		Авторизация.Вставить("dateDownload",Данные.dateDownload);
		Авторизация.Вставить("dateLastCheck",Данные.dateLastCheck);
		Авторизация.Вставить("validity",Данные.validity);
		Авторизация.Вставить("period",Данные.period);
		Авторизация.Вставить("settings",Данные.settings);
		ДанныеПроценки.Очистить();
		Нов=ДанныеПроценки.Добавить();
		Нов.Ключ="dateFrom";Нов.Значение=Авторизация.dateFrom;Нов.Наименование="Дата прайс-листа";
		Нов=ДанныеПроценки.Добавить();
		Нов.Ключ="dateDownload";Нов.Значение=Авторизация.dateDownload;Нов.Наименование="Дата последней загрузки";
		Если ТекПроценка.Источник<>"FILE" Тогда
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="dateLastCheck";Нов.Значение=Авторизация.dateLastCheck;Нов.Наименование="Дата последнего опроса";
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="validity";Нов.Значение=Авторизация.validity;Нов.Наименование="Срок действия прайс-листа, час (до опроса)";
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="period";Нов.Значение=Авторизация.period;Нов.Наименование="Частота опроса, час";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверкаПрайс(ТекДан)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекДан.Авторизация.settings);
	Рез = ПрочитатьJSON(ЧтениеJSON,Ложь);
	ЧтениеJSON.Закрыть();
	Ошибка=?(Рез.НачальнаяСтрока = 0,"Начальная строка не должна быть равна нулю."+Символы.ПС,"")+
	?(Рез.КолАртикул = 0,"Номер колонки Артикул не должен быть равен нулю."+Символы.ПС,"")+
	?(Рез.КолПроизводитель = 0 И ПустаяСтрока(Рез.Производитель) ,"Не определена колонка производителя и его наименование."+Символы.ПС,"")+
	?(Рез.КолНаименование = 0,"Номер колонки Наименование не должен быть равен нулю."+Символы.ПС,"")+
	?(Рез.КолЦена = 0,"Номер колонки Цена не должен быть равен нулю."+Символы.ПС,"");
	
	Если ТекДан.Источник="EMAIL" тогда	
		Ошибка=?(Рез.Получатель = "","Не определен получатель."+Символы.ПС,"")+
		?(Рез.Отправитель = "","Не определен отправитель."+Символы.ПС,"")+
		?(Рез.ПочтовыйЯщик = "","Не определен почтовый ящик."+Символы.ПС,"")+
		?(Рез.Вложение = "","Не определен шаблон имени файла вложения."+Символы.ПС,"")+Ошибка;
	ИначеЕсли Рез.ФайлШаблон = "" Тогда 
		Ошибка="Не определено имя файла."+Символы.ПС+Ошибка;
	КонецЕсли;	
	Возврат Ошибка;
КонецФункции

&НаКлиенте
Процедура ЗагрузитьПрайс(Команда)
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Если ТекДан=Неопределено тогда Возврат; КонецЕсли;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекДан.Авторизация.settings);
	Рез = ПрочитатьJSON(ЧтениеJSON,Ложь);
	ЧтениеJSON.Закрыть();
	Если Не Рез.Свойство("НачальнаяСтрока") Тогда
		Сообщить("Не определены настройки для загрузки прайс-листа");
		Возврат;
	КонецЕсли;
	Ошибка=?(Рез.НачальнаяСтрока = 0,"Начальная строка не должна быть равна нулю."+Символы.ПС,"")+
	?(Рез.КолАртикул = 0,"Номер колонки Артикул не должен быть равен нулю."+Символы.ПС,"")+
	?(Рез.КолПроизводитель = 0 И ПустаяСтрока(Рез.Производитель) ,"Не определена колонка производителя и его наименование."+Символы.ПС,"")+
	?(Рез.КолНаименование = 0,"Номер колонки Наименование не должен быть равен нулю."+Символы.ПС,"")+
	?(Рез.КолЦена = 0,"Номер колонки Цена не должен быть равен нулю."+Символы.ПС,"");
	
	Если ТекДан.Источник="EMAIL" тогда	
		Ошибка=?(Рез.Получатель = "","Не определен получатель."+Символы.ПС,"")+
		?(Рез.Отправитель = "","Не определен отправитель."+Символы.ПС,"")+
		?(Рез.ПочтовыйЯщик = "","Не определен почтовый ящик."+Символы.ПС,"")+
		?(Рез.Вложение = "","Не определен шаблон имени файла вложения."+Символы.ПС,"")+Ошибка;
	ИначеЕсли Рез.ФайлШаблон = "" Тогда 
		Ошибка="Не определено имя файла."+Символы.ПС+Ошибка;
	КонецЕсли;	
	
	Если Ошибка<>"" Тогда 
		ПоказатьПредупреждение(,Ошибка);
		Возврат;
	КонецЕсли;
	
	Если ТекДан.Источник="EMAIL" тогда
		Запрос="{""action"":""loadPrice"",""idPrice"":"""+Сред(ТекДан.Сайт,3)+""",""schema"":""price""}";
		ВладелецФормы.СендерОтправить(Запрос); // ПрайсОбновлен
		Сообщить("Запрос на загрузку отправлен на сервер");
	Иначе
		Запрос="{""action"":""clearPrice"",""idPrice"":"""+Сред(ТекДан.Сайт,3)+""",""schema"":""price"",""noReply"":true}";
		ВладелецФормы.СендерОтправить(Запрос);
		
		zp=Новый Структура("Excel,ExcelЛист,Группы,Групп,dateFrom,dateDownload,idPrice,cols,Н1,Н0,Колонки, Начало");
		zp.Начало=ТекущаяДата();
		zp.cols = "article,manufacturer,description,price";
		zp.Колонки=Новый Массив;
		zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив",Неопределено,Рез.КолАртикул,Ложь));
		zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив",
		?(ПустаяСтрока(Рез.Производитель),Неопределено,Рез.Производитель),Рез.КолПроизводитель,Ложь));
		zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив",Неопределено,Рез.КолНаименование,Ложь));
		zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив",Неопределено,Рез.КолЦена,Истина));
		Если Рез.КолНаличие>0 Тогда 
			zp.cols=zp.cols+",inStock";
			zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив","0",Рез.КолНаличие,Истина));
		КонецЕсли;
		Если Рез.КолСрокДоставки>0 Тогда
			zp.cols=zp.cols+",deliveryTime";
			zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив","999",Рез.КолСрокДоставки,Истина));
		КонецЕсли;
		Если Рез.КолКратность>0 Тогда 
			zp.cols=zp.cols+",multiple";
			zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив","1",Рез.КолКратность,Истина));
		КонецЕсли;
		Если Рез.КолМинПартия>0 Тогда 
			zp.cols=zp.cols+",minBatch";
			zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив","1",Рез.КолМинПартия,Истина));
		КонецЕсли;
		Если Рез.КолКодТовара>0 Тогда 
			zp.cols=zp.cols+",productCode";
			zp.Колонки.Добавить(Новый Структура("ПоУмолчанию,Номер,ЭтоЧисло,Массив","",Рез.КолКодТовара,Ложь));
		КонецЕсли;
		zp.cols=zp.cols+",searchCode";
		zp.idPrice=Сред(ТекДан.Сайт,3);
		
		Файл=Новый Файл(Рез.ФайлШаблон);
		Если Не Файл.Существует() Тогда
			Сообщить("Файл "+Рез.ФайлШаблон+" не существует");
			Возврат;
		КонецЕсли;
		zp.dateFrom=Файл.ПолучитьВремяИзменения();
		zp.dateDownload=ТекущаяДата();
		
		Попытка	   
			zp.Excel = Новый COMОбъект("Excel.Application");
			zp.Excel.WorkBooks.Open(Рез.ФайлШаблон);	
			zp.ExcelЛист = zp.Excel.Sheets(Рез.НомерЛиста);	   
			zp.ExcelЛист.Activate();
		Исключение	   
			Сообщить("Ошибка при открытии файла Excel. "+ОписаниеОшибки()); 
			Возврат;
		КонецПопытки;
	
		Состояние("Чтение данных из документа Excel ...");
		Попытка
			//xlLastCell = 11;   	
			//ActiveCell = zp.Excel.ActiveCell.SpecialCells(xlLastCell);   
			//Строк = ActiveCell.Row;
			Строк = zp.Excel.ActiveSheet.UsedRange.Rows.Count;
			zp.Н0=Рез.НачальнаяСтрока;
			zp.Н1=Строк%200;
			zp.Групп=(Строк-zp.Н1)/200;
			Если zp.Н1<=zp.Н0 Тогда 
				zp.Н1=zp.Н1+200-zp.Н0;
				zp.Групп=zp.Групп-1;
			Иначе
			КонецЕсли;
			zp.Группы=0;
			ПодключитьОбработчикОжидания("ЗагрузитьГруппу", 0.1, Истина);
		Исключение
			Сообщить(ОписаниеОшибки());
		Конецпопытки;
	КонецЕсли;
Конецпроцедуры
				
&НаКлиенте
Процедура ЗагрузитьГруппу() Экспорт		
	Состояние("Загружено "+Цел(zp.Группы*100/(zp.Групп+1))+"%");
	Попытка					
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ПроверятьСтруктуру = Ложь;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("action");
		ЗаписьJSON.ЗаписатьЗначение("addPrice");
		ЗаписьJSON.ЗаписатьИмяСвойства("schema");
		ЗаписьJSON.ЗаписатьЗначение("price");
		ЗаписьJSON.ЗаписатьИмяСвойства("idPrice");
		ЗаписьJSON.ЗаписатьЗначение(zp.idPrice);
		Если zp.Группы<>zp.Групп Тогда 
			ЗаписьJSON.ЗаписатьИмяСвойства("noReply");
			ЗаписьJSON.ЗаписатьЗначение(1);
		Иначе
			ЗаписьJSON.ЗаписатьИмяСвойства("dateFrom");
			ЗаписьJSON.ЗаписатьЗначение(Формат(zp.dateFrom,"ДФ=гггг-ММ-дд ЧЧ:мм:сс"));
			ЗаписьJSON.ЗаписатьИмяСвойства("dateDownload");
			ЗаписьJSON.ЗаписатьЗначение(Формат(zp.dateDownload,"ДФ=гггг-ММ-дд ЧЧ:мм:сс"));
		КонецЕсли;
		ЗаписьJSON.ЗаписатьИмяСвойства("cols");
		ЗаписьJSON.ЗаписатьЗначение(zp.cols);
		ЗаписьJSON.ЗаписатьИмяСвойства("data");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		ЕстьЗаписи=Ложь;
		
		// Читаем данные в Массивы
		Для Каждого Кол Из zp.Колонки Цикл
			Если Кол.Номер=0 Тогда
				Кол.Массив=Новый Массив;
				Для Инд = 0 По zp.Н1-zp.Н0 Цикл Кол.Массив.Добавить(Кол.ПоУмолчанию);КонецЦикла;
			Иначе
				Область = zp.ExcelЛист.Range(zp.ExcelЛист.Cells(zp.Н0,Кол.Номер), zp.ExcelЛист.Cells(zp.Н1,Кол.Номер));
				Кол.Массив = Область.Value.Выгрузить()[0];
			КонецЕсли;
		КонецЦикла;
		
		// Формируем значения для запроса
		Для Инд = 0 По zp.Н1-zp.Н0 Цикл 
			value="";
			Для Каждого Кол из zp.Колонки Цикл
				Текст=Кол.Массив[Инд];
				Если ПустаяСтрока(Текст) Тогда
					Если Кол.ПоУмолчанию=Неопределено Тогда 
						value="";
						Прервать;
					Иначе
						Текст=Кол.ПоУмолчанию;
					КонецЕсли;
				ИначеЕсли Кол.ЭтоЧисло Тогда
					Попытка
						Число=Число(Текст); 
					Исключение
						Попытка
							Текст=СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.НПП, "")," ", ""),",",".");
							Число=Число(Текст); 
						Исключение
							Число=ПолучитьЧисло(Текст,Кол.ПоУмолчанию);
							Если Число=Неопределено Тогда 
								value="";
								Прервать;
							//ИначеЕсли ТипЗнч(Текст)=Тип("Число") Тогда
							КонецЕсли;
						Конецпопытки;
					КонецПопытки;
					Текст=Формат(Число,"ЧГ=;ЧН=");
				Иначе
					Текст=СтрЗаменить(СтрЗаменить(Текст,"\","\\"),"'","''");
					Если Кол=zp.Колонки[0] Тогда
						КодПоиска=ПодготовитьНомер(Текст);
					КонецЕсли;
				КонецЕсли;
				value=value+"'"+Текст+"',";
			КонецЦикла;
			Если value<>"" Тогда
				ЗаписьJSON.ЗаписатьЗначение(value+"'"+КодПоиска+"'");
				ЕстьЗаписи=Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьЗаписи или zp.Группы=zp.Групп Тогда
			ЗаписьJSON.ЗаписатьКонецМассива();
			ЗаписьJSON.ЗаписатьКонецОбъекта();
			ВладелецФормы.СендерОтправить(ЗаписьJSON.Закрыть());
		КонецЕсли;
		Если zp.Группы<zp.Групп Тогда
		    zp.Н0=zp.Н1+1;
		    zp.Н1=zp.Н1+200;
			zp.Группы=zp.Группы+1;
			ПодключитьОбработчикОжидания("ЗагрузитьГруппу", 0.1, Истина);
		Иначе
			Состояние();
		    zp.Excel.DisplayAlerts = 0;
		    zp.Excel.Quit();
		    zp.Excel.DisplayAlerts = 1;
			zp.Excel = Неопределено;
			Сообщить("Строк: "+zp.Н1+", Время: "+(ТекущаяДата()-zp.Начало)+" сек.");
		КонецЕсли
	Исключение
		Сообщить(ОписаниеОшибки());
		Состояние();
	    zp.Excel.DisplayAlerts = 0;
	    zp.Excel.Quit();
	    zp.Excel.DisplayAlerts = 1;
		zp.Excel = Неопределено;
	КонецПопытки;	
КонецПроцедуры		

&НаКлиенте
Функция ПолучитьЧисло(Данные,Ноль=0) Экспорт
	Если ТипЗнч(Данные)=Тип("Число") Тогда Возврат Данные;КонецЕсли; 
	Если ПустаяСтрока(Данные) Тогда Возврат Ноль;КонецЕсли; 
	Попытка 
		Данные=СтрЗаменить(СтрЗаменить(СтрЗаменить(Данные, Символы.НПП, "")," ", ""),",",".");
		Возврат Число(Данные); 
	Исключение
		Симв=Лев(Данные,1);
		//Числа = (Симв>="0" И Симв <= "9") ИЛИ Симв="-" или Симв="+";
		Нач=0; Длина=0; ТочкиНет=Истина; Знак="";
		Кол = СтрДлина(Данные);
		Для Поз=1 по Кол Цикл
			Симв=Сред(Данные,Поз,1);
			Число = (Симв>="0" И Симв <= "9"); 
			Если Не Число Тогда
				Если Длина=0 и (Симв="-" или Симв="+") Тогда
					Знак=Симв;
				ИначеЕсли Длина>0 И ТочкиНет И Симв="." Тогда
					ТочкиНет=Ложь;
					Длина=Длина+1;
				ИначеЕсли Длина>0 Тогда
					Длина=Поз-Нач;
					Прервать;
				КонецЕсли;
			Иначе
				Если Длина=0 Тогда
					Нач=Поз;
				КонецЕсли;
				Длина=Длина+1;
			КонецЕсли;
		КонецЦикла;
		Если Длина=0 Тогда
			Возврат Ноль;
		Иначе
			Возврат Число(Знак+Сред(Данные,Нач,Длина));
		КонецЕсли;
	Конецпопытки
КонецФункции

&НаКлиенте
Процедура ОткрытьПрайс(Команда)
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Если ТекДан<>Неопределено Тогда
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ПрайсУФ",
		Новый Структура("Наименование,Код",ТекДан.НаименованиеСайт,ТекДан.Сайт),
		ЭтаФорма.ВладелецФормы,"ПрайсУФ");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЗагрузки(Команда)
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Если ТекДан<>Неопределено Тогда
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ПрайсНастройкаУФ", 
		Новый Структура("НаименованиеСайт,Источник,Сайт,Авторизация",ТекДан.НаименованиеСайт,ТекДан.Источник,ТекДан.Сайт,ТекДан.Авторизация),
		ЭтаФорма.ВладелецФормы,"ПрайсНастройкаУФ");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПрайсУдалять(Код)
	Попытка
	УстановитьПривилегированныйРежим(Истина);
    Если ПривилегированныйРежим()=Истина Тогда
		Удалять=Истина;
		Отбор = Новый Структура("КлючНастроек, КлючОбъекта","Проценки","ПомощникАвтобизнеса");
		Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
		Пока Выборка.Следующий() Цикл
			Если Выборка.Пользователь<>Объект.ПользовательИмя Тогда
				Таб=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,Выборка.Пользователь);
				Если ТипЗнч(Таб)=Тип("ТаблицаЗначений") И Таб.Найти(Код,"Сайт")<>Неопределено Тогда
					Удалять=Ложь;
					Прервать;
				КонецЕсли;
		    КонецЕсли;
		КонецЦикла;
		УстановитьПривилегированныйРежим(Ложь);
	Иначе
		Удалять=Ложь;
	КонецЕсли;
    Исключение
		Удалять=Ложь;
	КонецПопытки;
	Возврат Удалять;
КонецФункции

&НаКлиенте
Процедура ПроценкиПередУдалением(Элемент, Отказ)
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Если ТекДан.Источник<>"API" Тогда
		Если ПрайсУдалять(ТекДан.Сайт) Тогда
			Запрос="{""action"":""del"",""idPrice"":"""+сред(ТекДан.Сайт,3)+""",""schema"":""pricelists""}";
			ЭтаФорма.ВладелецФормы.СендерОтправить(Запрос);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрайсОбновлен(Рез) Экспорт
	ТекДан=Элементы.Проценки.ТекущиеДанные;
	Код="id"+Формат(Рез.idPrice,"ЧЦ=6;ЧВН=;ЧГ=");
	Если ТекДан.Сайт<>Код Тогда
		Строки=ТабПроценки.НайтиСтроки("Сайт",Код);
		Если Строки.Количество()=0 Тогда 
			Сообщить("Не найден прайс с кодом "+Код);
			Возврат;
		КонецЕсли;
		Тек=Строки[0];
	Иначе
		Тек=ТекДан;
	КонецЕсли;
	
	Если Рез.Свойство("settings") И ТипЗнч(Рез.settings)=Тип("Структура") Тогда
		ЗаписьJSON=Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет,,,,,,,,Истина));
		ЗаписатьJSON(ЗаписьJSON,Рез.settings);
		Рез.settings=ЗаписьJSON.Закрыть();
	КонецЕсли;
	
	Если Рез.action="update" тогда
		ЗаполнитьЗначенияСвойств(Тек.Авторизация,Рез,"validity,period,settings");
	ИначеЕсли Рез.action="loadPrice" или Рез.action="addPrice" Тогда
		ЗаполнитьЗначенияСвойств(Тек.Авторизация,Рез,"dateFrom,dateDownload");
		Сообщить("Обновлен прайс id"+Формат(Рез.idPrice,"ЧЦ=6;ЧВН=;ЧГ="));
	Иначе		
		ЗаполнитьЗначенияСвойств(Тек.Авторизация,Рез,"dateFrom,dateDownload,dateLastCheck,validity,period,settings");
	КонецЕсли;
	Если ТекДан=Тек Тогда
		СвойстваД=Тек.Авторизация;
		ДанныеПроценки.Очистить();
		Нов=ДанныеПроценки.Добавить();
		Нов.Ключ="dateFrom";Нов.Значение=СвойстваД.dateFrom;Нов.Наименование="Дата прайс-листа";
		Нов=ДанныеПроценки.Добавить();
		Нов.Ключ="dateDownload";Нов.Значение=СвойстваД.dateDownload;Нов.Наименование="Дата последней загрузки";
		Если ТекДан.Источник<>"FILE" Тогда
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="dateLastCheck";Нов.Значение=СвойстваД.dateLastCheck;Нов.Наименование="Дата последнего опроса";
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="validity";Нов.Значение=СвойстваД.validity;Нов.Наименование="Срок действия прайс-листа, час (до опроса)";
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ="period";Нов.Значение=СвойстваД.period;Нов.Наименование="Частота опроса, час";
		КонецЕсли;
	КонецЕсли;
Конецпроцедуры

