&НаСервере
Процедура ОбновитьСписокВидовЗаявок()
	Обработка=РеквизитФормыВЗначение("Объект");
	
	Элементы.ВидЗаявки.СписокВыбора.Очистить();
	Элементы.Фильтр_ВидыЗаявок.СписокВыбора.Очистить();
	ТЗ_ВидыЗаявок = Обработка.ПолучитьСписокВидовЗаявок();
	Для каждого Запись ИЗ ТЗ_ВидыЗаявок Цикл
		Элементы.ВидЗаявки.СписокВыбора.Добавить(Запись.idtask_types,Запись.name);
		Элементы.Фильтр_ВидыЗаявок.СписокВыбора.Добавить(Запись.idtask_types,Запись.name);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокСтатусов()
	Обработка=РеквизитФормыВЗначение("Объект");
	
	Элементы.Фильтр_СтатусыЗаявок.СписокВыбора.Очистить();
	ТЗ_Статусы = Обработка.ПолучитьСписокСтатусовЗаявок();
	Для каждого Запись ИЗ ТЗ_Статусы Цикл
		Элементы.Фильтр_СтатусыЗаявок.СписокВыбора.Добавить(Запись.idtask_statuses,Запись.name);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокЗаявокНаКлиенте()
	ОбновитьСписокЗаявок();
	Если Элементы.МоиЗаявки.ТекущиеДанные <> Неопределено Тогда
		ПолучитьКомментарииИУстановитьНаПослений(Элементы.МоиЗаявки.ТекущиеДанные.Номер);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЗаявок()
	Обработка=РеквизитФормыВЗначение("Объект");
	
	Объект.МоиЗаявки.Очистить();
	ТЗ = Обработка.ПолучитьСписокЗаявок();
	Если ТЗ <> Неопределено Тогда
		Для каждого Запись из ТЗ Цикл
			Эл = Объект.МоиЗаявки.Добавить();
			Эл.Номер = Запись.idTasks;
			Эл.Статус = Элементы.Фильтр_СтатусыЗаявок.СписокВыбора.НайтиПоЗначению(Запись.status);
			//Эл.Статус = Элементы.Фильтр_СтатусыЗаявок.СписокВыбора.Получить(Число(Запись.status)-1);
			Эл.Вид = Элементы.Фильтр_ВидыЗаявок.СписокВыбора.Получить(Число(Запись.type)-1);
			Эл.Наименование = Запись.name;
			Эл.Описание = Запись.description;
			Эл.Дата = Дата(СтрЗаменить(СтрЗаменить(СтрЗаменить(Запись.date,"-",""),":","")," ",""));
			Эл.idСтатус = Число(Запись.status);
		КонецЦикла;
		Объект.МоиЗаявки.Сортировать("Дата Убыв, Номер Убыв");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокСтатей()
	Обработка=РеквизитФормыВЗначение("Объект");
	
	Объект.ОбучающиеСтатьи.Очистить();
	ТЗ = Обработка.ПолучитьСписокСтатей();
	Если ТЗ <> Неопределено Тогда
		Для каждого Запись из ТЗ Цикл
			Эл = Объект.ОбучающиеСтатьи.Добавить();
			Эл.Номер = Запись.idArticle;
			Эл.Описание = Запись.description;
			Эл.VK = Запись.vk;
			Эл.Youtube = Запись.youtube;
		КонецЦикла;
		Объект.ОбучающиеСтатьи.Сортировать("Номер");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Группа21ПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если Элемент.ТекущаяСтраница.Имя = "ТехПоддержка" Тогда
		ОбновитьСписокВидовЗаявок();
		ОбновитьСписокСтатусов();
		ОбновитьСписокЗаявок();
	ИначеЕсли Элемент.ТекущаяСтраница.Имя = "ЛичныйКабинет" Тогда
		ОбновитьЛичныйКабинет();
	ИначеЕсли Элемент.ТекущаяСтраница.Имя = "Администрирование" и Доступы.Количество()=0 Тогда
		ЗаполнитьДоступы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Фильтр_СтатусыЗаявокПриИзменении(Элемент)
	Если Элемент.ВыделенныйТекст = Неопределено ИЛИ Элемент.ВыделенныйТекст = "" Тогда
		Элементы.МоиЗаявки.ОтборСтрок = Новый ФиксированнаяСтруктура();
	Иначе
		Элементы.МоиЗаявки.ОтборСтрок = Новый ФиксированнаяСтруктура("Статус",Элемент.ВыделенныйТекст);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Фильтр_ВидыЗаявокПриИзменении(Элемент)
	Если Элемент.ВыделенныйТекст = Неопределено ИЛИ Элемент.ВыделенныйТекст = "" Тогда
		Элементы.МоиЗаявки.ОтборСтрок = Новый ФиксированнаяСтруктура();
	Иначе
		Элементы.МоиЗаявки.ОтборСтрок = Новый ФиксированнаяСтруктура("Вид",Элемент.ВыделенныйТекст);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МоиЗаявкиПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		МоиЗаявки_ОписаниеЗаявки = Элемент.ТекущиеДанные.Описание;
		ПолучитьКомментарииИУстановитьНаПослений(Элемент.ТекущиеДанные.Номер);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьКомментарииИУстановитьНаПослений(НомерЗаявки)
	ПолучитьКомментарииПоЗаявкеНаСервере(НомерЗаявки);
	Если Объект.МоиЗаявкиКомментарии.Количество() > 0 Тогда
		Элементы.МоиЗаявкиКомментарии.ТекущаяСтрока = Объект.МоиЗаявкиКомментарии[Объект.МоиЗаявкиКомментарии.Количество()-1].ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПолучитьКомментарииПоЗаявкеНаСервере(Элемент)
	Обработка=РеквизитФормыВЗначение("Объект");	
	Обработка.ПолучитьКомментарииПоЗаявке(Элемент);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомментарий(Команда)
	Если (Элементы.МоиЗаявки.ТекущиеДанные.idСтатус = 4) или (Элементы.МоиЗаявки.ТекущиеДанные.idСтатус = 5) Тогда
		Сообщить("В закрытую заявку добавлять комментарии запрещено. Необходимо создать новую заявку в тех.поддержку");
		Возврат;
	КонецЕсли;
	
	Оповещение=Новый ОписаниеОповещения("ОбработкаРасшифровкиДобавленияКомментария",ЭтаФорма);
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ДобавлениеКомментарияУФ",,ЭтаФорма,,,,Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРасшифровкиДобавленияКомментария(Комментарий, ПараметрДляОповещения) Экспорт
	Если Комментарий=Неопределено Тогда Возврат; КонецЕсли;
	Если ЗначениеЗаполнено(Комментарий) Тогда
		КомментарийПоЗаявке = Новый Структура("НомерЗаявки,Комментарий",
			Элементы.МоиЗаявки.ТекущиеДанные.Номер,Комментарий);	
			
		ОтправитьКомментарийПоЗаявкеСервер(КомментарийПоЗаявке);
		
		//Если Элементы.МоиЗаявки.ТекущиеДанные.Статус = "Есть ответ" Тогда 
			ИзменитьСтатусЗаявкиНаСервере(Элементы.МоиЗаявки.ТекущиеДанные.Номер, 2);
			Элементы.МоиЗаявки.ТекущиеДанные.Статус = Элементы.Фильтр_СтатусыЗаявок.СписокВыбора.Получить(1);
		//КонецЕсли;	
		
		ПолучитьКомментарииИУстановитьНаПослений(Элементы.МоиЗаявки.ТекущиеДанные.Номер);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОтправитьКомментарийПоЗаявкеСервер(Элемент)
	Обработка=РеквизитФормыВЗначение("Объект");	
	Обработка.ОтправитьКомментарийПоЗаявкеНаСервер(Элемент);	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСтатусЗаявкиНаСервере(НомерЗаявки, НомерСтатуса)
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.ИзменитьСтатусЗаявки(НомерЗаявки, НомерСтатуса);	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗаявку(Команда)
	Заявка = Новый Структура("Наименование,ВидЗаявки,Описание",НазваниеЗаявки,Число(ВидЗаявки),ОписаниеЗаявки);
	Успешно = ОтправитьЗаявкуСервер(Заявка);
	Если Успешно = Истина Тогда
		НазваниеЗаявки = "";
		ОписаниеЗаявки = "";
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ОтправитьЗаявкуСервер(Заявка)
	Обработка=РеквизитФормыВЗначение("Объект");
	Успешно = Обработка.ОтправитьЗаявкуНаСервере(Заявка);
	Возврат Успешно;		
КонецФункции

&НаКлиенте
Процедура Группа_ТехПоддержкаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если Элемент.ТекущаяСтраница.Имя = "Группа_МоиЗаявки" Тогда
		ОбновитьСписокЗаявок();
	ИначеЕсли Элемент.ТекущаяСтраница.Имя = "Группа_ОтправитьЗаявку" Тогда
		Если Не ЗначениеЗаполнено(ВидЗаявки) Тогда
			ВидЗаявки = Элементы.ВидЗаявки.СписокВыбора.Получить(0).Значение; 
		КонецЕсли;
	ИначеЕсли Элемент.ТекущаяСтраница.Имя = "Группа_ОбучающиеСтатьи" Тогда
		ОбновитьСписокСтатей();		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбучающиеСтатьиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если (Поле.Имя = "VK") или (Поле.Имя = "Youtube") Тогда
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные[Поле.Имя]) Тогда
			ЗапуститьПриложение("http://"+Элемент.ТекущиеДанные[Поле.Имя]);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьРедактированиеЦенВКорзинеПриИзменении(Элемент)
	ЭтаФорма.ВладелецФормы.Элементы.ЗаявкаНаОформлениеЦена.Доступность = НЕ Объект.ЗапретитьРедактированиеЦенВКорзине;	
КонецПроцедуры

