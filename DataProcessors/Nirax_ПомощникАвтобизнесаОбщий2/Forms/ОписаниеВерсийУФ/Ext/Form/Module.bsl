&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Данные = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Версии",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	НеОтображать=Не Данные.Информировать;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца=Истина;
	Лимит=10; Смещение=0; СимволыФ="*";Лист=1;
	Элементы.Назад.Доступность=Ложь;
	ЗаполнитьЗначенияСвойств(Объект,ВладелецФормы.Объект,"КодСеанса,ПАЛогин,СтрокаПодключенияКроссов");
	Доступ=ПроверитьДоступКОбновлениямНаСервере();
	
	Запрос=Новый Структура("action,idSession","sessionData", Объект.КодСеанса);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Истина Тогда
		idSoftware=Ответ.idSoftware;
		Элементы.нПоследняяВерсия.Заголовок=Ответ.newVersion;
		Элементы.нТекущаяВерсия.Заголовок=Ответ.softwareVersion;
		//ЭтаФорма.Заголовок = "NIRAX: Помощник автобизнеса " + Ответ.softwareVersion;
		Если Доступ Тогда
			Элементы.СсылкаНаСкачивание.Заголовок		=	Ответ.link;
		Иначе
			Элементы.СсылкаНаСкачивание.Заголовок		=	"нет доступа";
			Элементы.СсылкаНаСкачивание.Видимость		=	Истина;
			Элементы.СкопироватьВБуферОбмена.Видимость	=	Ложь;
			Элементы.КнопкаСсылкаНаСкачивание.Видимость	=	Ложь;
		КонецЕсли;
		ПрочитатьОбновления();
	Иначе
		Отказ=Истина;
		Сообщить(Ответ.comment);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДоступКОбновлениямНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПроверитьДоступКОбновлениям();
КонецФункции

&НаКлиенте
Процедура Декорация1Нажатие(Элемент)
	ЗапуститьПриложение("https://nirax.ru/products/auto_assistant");
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаСкачиваниеНажатие(Элемент)
	Если Элементы.СсылкаНаСкачивание.Заголовок<>"нет доступа" Тогда
		ЗапуститьПриложение(Элементы.СсылкаНаСкачивание.Заголовок);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьВБуферОбмена(Команда)
	Если Элементы.СсылкаНаСкачивание.Заголовок<>"нет доступа" Тогда
		СсылкаНаСкачиваниеТекст = Новый COMОбъект("htmlfile");
		СсылкаНаСкачиваниеТекст.ParentWindow.ClipboardData.Setdata("Text", Элементы.СсылкаНаСкачивание.Заголовок);
		Сообщить("Ссылка на скачивание скопирована в буфер обмена");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ФорматироватьТекст(Текст,ФДок=Неопределено)
	Если ТипЗнч(ФДок)<>Тип("ФорматированныйДокумент") Тогда
		ФДок = Новый ФорматированныйДокумент;
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда Возврат ФДок;КонецЕсли;
	Строк=СтрЧислоСтрок(Текст);
	//МСтрок=СтрРазделить(Текст, Символы.ПС, Истина);
	ПерваяСтрока=Истина;
	//Для Каждого Стр из МСтрок Цикл
	Для Инд=1 по Строк Цикл
		Стр=СтрПолучитьСтроку(Текст,Инд);
		Если ПерваяСтрока Тогда ПерваяСтрока=Ложь;
		Иначе Фдок.Добавить(Символы.ПС,ТИП("ПереводСтрокиФорматированногоДокумента"));
		КонецЕсли;
			
		Если Лев(Стр,1)=СимволыФ Тогда 
			Стр=Сред(Стр,2);
			ЖирСтр=Истина;
		Иначе	
			ЖирСтр=Ложь;
		КонецЕсли;
		
		ФСтроки=СтрЗаменить(Стр,СимволыФ,Символы.ПС);
		ФСтрок=СтрЧислоСтрок(ФСтроки);
		//МФстроки=СтрРазделить(Стр,СимволыФ,Истина);
		//МФСтрок=МФСтроки.Количество();
		Если ФСтрок=1 Тогда
			СДок=ФДок.Добавить(Стр,ТИП("ТекстФорматированногоДокумента"));
			Если ЖирСтр Тогда
				СДок.Шрифт=Новый Шрифт(,,Истина);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Тс=1; Жир=Ложь;Кур=Ложь;
		Пока Тс<=ФСтрок Цикл
        	ФСтр=СтрПолучитьСтроку(ФСтроки,Тс); 
			Если ФСтр="" Тогда
				// Признак жирного текста
				Если (Тс+1)<=ФСтрок и СтрПолучитьСтроку(ФСтроки,Тс+1)="" Тогда
					// Жирный и курсив
					Жир=Не Жир; 
					Тс=Тс+1;
				Иначе
					Жир=Не Жир;
					Кур=не Кур;
				КонецЕсли;
			Иначе 
				СДок=ФДок.Добавить(ФСтр,ТИП("ТекстФорматированногоДокумента"));
				СДок.Шрифт=Новый Шрифт(,,ЖирСтр или Жир,Кур);
				Кур=не Кур;
			КонецЕсли;
			Тс=Тс+1;
		КонецЦикла;
	КонецЦикла;		
	Возврат ФДок;
КонецФункции

&НаКлиенте
Процедура ПрочитатьОбновления(Кнопка=Неопределено)
	Запрос=Новый Структура("idSession,action,idSoftware,order,api,limit,offset",
	Объект.КодСеанса,"softwareVersions",idSoftware,"idSoftwareVersion desc","LicenseManagement",Лимит,Смещение);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Истина Тогда
		Описание=Новый ФорматированныйДокумент;
		Для Каждого Стр Из Ответ.data Цикл
			Фстр=Описание.Добавить("Версия: "+ Стр.version+" от "+Прав(Стр.dateChange,2)+"."+Сред(Стр.dateChange,6,2)+"."+Лев(Стр.dateChange,4));
			ФСтр.ЦветТекста = Новый Цвет(23,80,150);
			ФСтр.Шрифт = Новый Шрифт(,,20,Истина,Истина);
			Описание.Добавить(,Тип("ПереводСтрокиФорматированногоДокумента"));
			ФорматироватьТекст(Стр.description,Описание);
			Описание.Добавить(,Тип("ПереводСтрокиФорматированногоДокумента"));
			Описание.Добавить(,Тип("ПереводСтрокиФорматированногоДокумента"));
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
		
&НаСервере
Функция ВыполнитьЗапрос(ПараметрыЗапроса)
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ВыполнитьЗапрос(ПараметрыЗапроса);
КонецФункции

&НаСервереБезКонтекста
Процедура НеОтображатьПриИзмененииНаСервере(Информировать)
	Данные = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Версии",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	Данные.Информировать=Информировать;
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Версии",Данные,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
КонецПроцедуры

&НаКлиенте
Процедура НеОтображатьПриИзменении(Элемент)
	НеОтображатьПриИзмененииНаСервере(Не НеОтображать);
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	Лист=Лист-1;
	ЛистПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	Лист=Лист+1;
	ЛистПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура ЛистПриИзменении(Элемент=Неопределено)
	Если Лист=0 Тогда Лист=1;КонецЕсли;
	Элементы.Назад.Доступность=Лист<>1;
	Смещение=Лимит*(Лист-1);
	ПрочитатьОбновления();
КонецПроцедуры

		
		
		