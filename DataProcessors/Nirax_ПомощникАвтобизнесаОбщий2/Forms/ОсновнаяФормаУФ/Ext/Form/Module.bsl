&НаКлиенте
Процедура ОформитьЧекККМ(Команда)
	
	СформироватьЧек = Истина;
	ТекстОшибки = "";
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Объект.КонтрагентДляЗаявки=ТекДан.Контрагент;
	Объект.СкладДляЗаявки=?(ЗначениеЗаполнено(ТекДан.Склад),ТекДан.Склад,Объект.Склад);
	Ошибки="";
	Если Не ЗначениеЗаполнено(Объект.ОрганизацияДляЗаявки) Тогда Ошибки=Ошибки+", организация";КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СкладДляЗаявки) Тогда Ошибки=Ошибки+", склад";КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КассаККМ) Тогда Ошибки=Ошибки+", касса ККМ";КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ТипЦен) и Лев(Объект.Конфигурация,7)<>"Розница" Тогда 
		Ошибки=Ошибки+", тип цен";
	КонецЕсли;
	Если Ошибки<>"" Тогда
		Сообщить("Отсутствует заполнение реквизитов в заказе и/настройка:"+Сред(Ошибки,2));
		Возврат;
	КонецЕсли;
	
	Если Объект.ЗаявкаНаОформление.Количество()=0 Тогда
		Сообщить("Список товара пуст");
		возврат;
	КонецЕсли;
	
	ОтборВыбран=Новый Структура("Выбран",Истина);
    Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(ОтборВыбран);
	ВыбранКолво=Строки.Количество();
	Если Объект.ЗаявкаНаОформление.Количество()=ВыбранКолво Тогда ВыбранКолво=0;КонецЕсли;
	 
	Если ВыбранКолво>0 Тогда 
		ОО=Новый ОписаниеОповещения("ОформлениеЧека",ЭтаФорма,ОтборВыбран);
		ПоказатьВопрос(ОО,"Оформить чек выбранных позиций?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ОформлениеЧека(КодВозвратаДиалога.Да,Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОформлениеЧека(Ответ,Отбор) Экспорт
	ЕСли Ответ<>КодВозвратаДиалога.Да Тогда Возврат;КонецЕсли;
	ЧекККМСсылка=ОформитьЧекККМНаСервере(Отбор);
	Если ЗначениеЗаполнено(ЧекККМСсылка) Тогда
		Если Объект.Конфигурация = "УправлениеТорговлей 11.3" ИЛИ Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
			ДСсылка = ПолучитьПродажуПоНомеру(ЧекККМСсылка, ЧекККМСсылка.Дата); 
		   
			СсылкаНаДокумент = ПолучитьПродажуПоНомеру(ЧекККМСсылка.Номер, ТекущаяДата());		  
			ПараметрыФормы = Новый Структура("Ключ", СсылкаНаДокумент);   	      		  			  
			ОткрытьФорму("Документ.ЧекККМ.Форма.ФормаДокументаРМК", ПараметрыФормы );

		Иначе			   
	   
	    	Если Не ПолучитьТипКонфигурацииРозница() Тогда
		    	ПоказатьЗначение(,ЧекККМСсылка.Ссылка);
	    	Иначе		 
			    СсылкаНаДокумент = ПолучитьПродажуПоНомеру(ЧекККМСсылка.Номер, ТекущаяДата());
				ПараметрыФормы = Новый Структура("Ключ", СсылкаНаДокумент);   	      		  			  
			    ОткрытьФорму("Документ.ЧекККМ.ФормаОбъекта", ПараметрыФормы );
			КонецЕсли;		  	   
			
		КонецЕсли;
	  		   
	КонецЕсли;			
   
КонецПроцедуры

&НаСервере
Функция ОформитьЧекККМНаСервере(Отбор)
	//Создадим номенклатуру если она еще не создана
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.КорзинаСоздатьНоменклатуру();
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	
	Попытка
		Если Лев(Объект.Конфигурация,9) = "Автосалон" Тогда
			Чек = Документы.Чек.СоздатьДокумент();
			Чек.УстановитьНовыйНомер();
			//Чек.Автор = ПараметрыСеанса.Пользователь;
			Чек.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
			Чек.Контрагент = Объект.КонтрагентДляЗаявки; 
			Чек.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
			Чек.КурсДокумента = 1;
			Чек.СкладКомпании = Объект.СкладДляЗаявки;
			Чек.ХозОперация = Справочники.ХозОперации.Чек;
			Чек.ДатаСоздания = ТекущаяДата();
			Чек.ТипЦен = Объект.ТипЦен;
			Чек.Автор = ПараметрыСеанса.АвторизованныйПользователь;
		Иначе
			Чек = Документы.ЧекККМ.СоздатьДокумент();
			Попытка
				Чек.ЦенаВключаетНДС = Истина;
			Исключение
				Чек.СуммаВключаетНДС = Истина;
			КонецПопытки;	
		КонецЕсли;
		Чек.Дата = ТекущаяДата();
		Чек.КассаККМ = Объект.КассаККМ;
		Чек.Организация = Объект.ОрганизацияДляЗаявки;
		Чек.СуммаДокумента = СуммаКорзины;		
		
		Если Объект.Конфигурация = "УправлениеТорговлей 11.0" ИЛИ
			Объект.Конфигурация = "УправлениеТорговлей 11.1.2" ИЛИ
			Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
			Попытка	 
				Чек.Склад = Объект.СкладДляЗаявки;
				Чек.Партнер = Объект.КонтрагентДляЗаявки.Партнер;
				Чек.ВидЦены = Объект.ТипЦен;
				Чек.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
				Чек.Кассир = ПараметрыСеанса.ТекущийПользователь;
				Чек.Валюта = Объект.ТипЦен.ВалютаЦены;
				Если НЕ Чек.Метаданные().Реквизиты.Найти("КассоваяСмена") = Неопределено Тогда
					Запрос = Новый Запрос(
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	КассоваяСмена.Номер               КАК НомерКассовойСмены,
					|	КассоваяСмена.Ссылка              КАК КассоваяСмена,
					|	КассоваяСмена.Статус			  КАК СтатусКассовойСмены,
					|	
					|	КассоваяСмена.КассаККМ             КАК КассаККМ,
					|	КассоваяСмена.Валюта               КАК Валюта,
					|	КассоваяСмена.Валюта.Представление КАК ВалютаПредставление,
					|	КассоваяСмена.ВидЦены              КАК ВидЦены,
					|	КассоваяСмена.Организация          КАК Организация,
					|	КассоваяСмена.Кассир               КАК Кассир,
					|	КассоваяСмена.Склад                КАК Склад,
					|	КассоваяСмена.ЦенаВключаетНДС      КАК ЦенаВключаетНДС,
					|	КассоваяСмена.НалогообложениеНДС   КАК НалогообложениеНДС,
					|	
					|	ВЫБОР
					|		КОГДА КассоваяСмена.СтатусКассовойСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ КАК СменаОткрыта,
					|	
					|	ВЫБОР
					|		КОГДА КассоваяСмена.СтатусКассовойСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
					|			ТОГДА КассоваяСмена.НачалоКассовойСмены
					|		ИНАЧЕ КассоваяСмена.ОкончаниеКассовойСмены
					|	КОНЕЦ КАК ДатаИзмененияСтатуса,
					|	
					|	ЕСТЬNULL(ДенежныеСредстваВКассахККМОстатки.СуммаОстаток, 0) КАК НаличностьВКассе
					|	
					|ИЗ
					|	Документ.КассоваяСмена КАК КассоваяСмена
					|	
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКассахККМ.Остатки(, КассаККМ = &КассаККМ) КАК ДенежныеСредстваВКассахККМОстатки
					|		ПО КассоваяСмена.КассаККМ = ДенежныеСредстваВКассахККМОстатки.КассаККМ
					|	
					|ГДЕ
					|	КассоваяСмена.Проведен
					|	И КассоваяСмена.КассаККМ = &КассаККМ
					|
					|УПОРЯДОЧИТЬ ПО
					|	КассоваяСмена.Дата УБЫВ,
					|	КассоваяСмена УБЫВ");
					
					Запрос.Текст =
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	КассоваяСмена.Номер                      КАК НомерКассовойСмены,
					|	КассоваяСмена.Ссылка                     КАК КассоваяСмена,
					|	КассоваяСмена.Статус                     КАК СтатусКассовойСмены,
					|	КассоваяСмена.СтатусРегламентныхОпераций КАК СтатусРегламентныхОпераций,
					|	
					|	КассоваяСмена.Организация          КАК Организация,
					|	КассоваяСмена.КассаККМ             КАК КассаККМ,
					|	КассоваяСмена.ФискальноеУстройство КАК ФискальноеУстройство,
					|	
					|	ВЫБОР
					|		КОГДА КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ КАК СменаОткрыта,
					|	
					|	ВЫБОР
					|		КОГДА КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
					|			ТОГДА КассоваяСмена.НачалоКассовойСмены
					|		ИНАЧЕ КассоваяСмена.ОкончаниеКассовойСмены
					|	КОНЕЦ КАК ДатаИзмененияСтатуса
					|ИЗ
					|	Документ.КассоваяСмена КАК КассоваяСмена
					|ГДЕ
					|	КассоваяСмена.Проведен
					|	И КассоваяСмена.КассаККМ = &КассаККМ
					|
					|УПОРЯДОЧИТЬ ПО
					|	КассоваяСмена.Дата УБЫВ,
					|	КассоваяСмена УБЫВ";					
					
					Запрос.УстановитьПараметр("КассаККМ",Объект.КассаККМ);
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
						Чек.КассоваяСмена = Выборка.КассоваяСмена;
					КонецЕсли;
				КонецЕсли;
			Исключение
				Чек.СтруктурнаяЕдиница = Объект.СкладДляЗаявки;
				Чек.асВидОперации = Перечисления.асВидыОперацийЧекККМ.ЧекККМ;
				Чек.ФормаОплаты = Перечисления.ТипыДенежныхСредств.Наличные;
				Чек.ВидЦен = Объект.ТипЦен;
				Чек.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
				Чек.Автор = ПараметрыСеанса.ТекущийПользователь;
				Чек.ВалютаДокумента = Объект.ТипЦен.ВалютаЦены;
			КонецПопытки;
			
		ИначеЕсли Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" ИЛИ
			Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.0" ИЛИ
			Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.2" ИЛИ 
			Найти(Объект.Конфигурация, "Розница") <> 0  Тогда
			
			Чек.ВидОперации=Перечисления.ВидыОперацийЧекККМ.Продажа;
			Чек.АналитикаХозяйственнойОперации=Справочники.АналитикаХозяйственныхОпераций.РеализацияТоваров;
			Чек.Магазин=объект.КассаККМ.Магазин;
			Чек.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			Чек.Продавец = ПолучитьПродавцаРозницаМА(Чек.Ответственный);
			Если (Метаданные.ОбщиеМодули.Найти("ПодключаемоеОборудованиеРТ") <> Неопределено) Тогда
				Если (Метаданные.Документы.ЧекККМ.Реквизиты.Найти("СистемаНалогообложения") <> Неопределено) Тогда
					Чек.СистемаНалогообложения = Вычислить(
						"ПодключаемоеОборудованиеРТ.ПолучитьСистемуНалогообложения(Чек.Дата, Чек.Организация, Чек.Магазин, Чек.Магазин.СкладПродажи)"
					);
				ИначеЕсли (Метаданные.Документы.ЧекККМ.Реквизиты.Найти("ВидНалога") <> Неопределено) Тогда
					Чек.ВидНалога = Вычислить(
						"ПодключаемоеОборудованиеРТ.ВидНалогаПоОрганизацииИСкладу(Чек.Дата, Чек.Организация, Чек.Магазин.СкладПродажи)"
					);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Лев(Объект.Конфигурация,25) = "УправлениеНебольшойФирмой" Тогда
			Чек.ВидЦен = Объект.ТипЦен;
			Чек.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
			//СостояниеКассовойСмены = Документы.ОтчетОРозничныхПродажах.ПолучитьСостояниеКассовойСмены(Чек.КассаККМ);
			Чек.ЗаполнитьДокументПоКассеККМ(Чек.КассаККМ);
			Чек.Автор = ПараметрыСеанса.ТекущийПользователь; 
			//ЗаполнитьЗначенияСвойств(Чек, СостояниеКассовойСмены);
		КонецЕсли;
		Строки=?(Отбор=Неопределено,Объект.ЗаявкаНаОформление,Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор));
		Для Каждого Строка Из Строки Цикл
			
			Если Лев(Объект.Конфигурация,9) <> "Автосалон" Тогда
				Попытка
					ЧекСтрока = Чек.Товары.Добавить();
					ЧекСтрока.Номенклатура = Строка.Номенклатура;
					ЧекСтрока.ПроцентРучнойСкидки = Строка.Скидка;
					ЧекСтрока.СуммаРучнойСкидки = Строка.Сумма - Строка.СуммаСоСкидкой;
					ЧекСтрока.КоличествоУпаковок = Строка.Количество;
					ЧекСтрока.Количество = Строка.Количество;
					ЧекСтрока.Цена = Строка.Цена;
					ЧекСтрока.Сумма = Строка.СуммаСоСкидкой;
					ЧекСтрока.СтавкаНДС = Строка.СтавкаНДС;
					ЧекСтрока.СуммаНДС = Строка.СуммаНДС;
					Если НЕ Чек.метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("Продавец") = Неопределено Тогда
						ЧекСтрока.Продавец = ПараметрыСеанса.ТекущийПользователь;
					КонецЕсли;
				Исключение
					ЧекСтрока = Чек.Запасы.Добавить();
					
					Если  Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.0" ИЛИ
						Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" ИЛИ
						Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.2" Тогда
						
						Спр = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Строка.Артикул);
						
						Если Спр <> Неопределено Тогда						   
							ЧекСтрока.Номенклатура = Спр;						   
						КонецЕсли;
					Иначе
						ЧекСтрока.Номенклатура 	= Строка.Номенклатура;
					КонецЕсли;					   
					
					ЧекСтрока.ЕдиницаИзмерения	= Строка.Номенклатура.ЕдиницаИзмерения;
					ЧекСтрока.Количество			= Строка.Количество;
					ЧекСтрока.Цена				= Строка.Цена;
					ЧекСтрока.Сумма				= Строка.СуммаСоСкидкой;
					
					Если Лев(Объект.Конфигурация,29) = "УправлениеНебольшойФирмой 1.6" Тогда
						ЧекСтрока.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(Строка.Номенклатура.ВидСтавкиНДС, ТекущаяДатаСеанса());
					Иначе
						ЧекСтрока.СтавкаНДС = Строка.СтавкаНДС;
					КонецЕсли; 	
					
					ЧекСтрока.СуммаНДС			= Строка.СуммаНДС;
					ЧекСтрока.Всего				= Строка.Всего;
				КонецПопытки;
				
				Если Лев(Объект.Конфигурация,29) = "РозницаМагазинАвтозапчастей 2" Тогда
					ЧекСтрока.Склад=объект.Склад;
				КонецЕсли;
			Иначе  //для АА6
				ЧекСтрока = Чек.Товары.Добавить();
				ЧекСтрока.Номенклатура = Строка.Номенклатура;
				ЧекСтрока.ЕдиницаИзмерения = Строка.Номенклатура.ОсновнаяЕдиницаИзмерения;
				ЧекСтрока.Коэффициент = 1;
				ЧекСтрока.ПроцентСкидки = Строка.Скидка;
				ЧекСтрока.СуммаСкидки = Строка.Сумма - Строка.СуммаСоСкидкой;
				ЧекСтрока.Количество = Строка.Количество;
				ЧекСтрока.Цена = Строка.Цена;
				ЧекСтрока.Сумма = Строка.СуммаСоСкидкой;
				ЧекСтрока.СтавкаНДС = Строка.СтавкаНДС;
				ЧекСтрока.СуммаНДС = Строка.СуммаНДС;
				ЧекСтрока.СуммаВсего = Строка.Всего;
				ЧекСтрока.МестоРазмещения = Объект.СкладДляЗаявки;
			КонецЕсли;
			
		КонецЦикла; 
		
		Чек.Записать();
		
		ЧекДанные = Новый Структура;
		ЧекДанные.Вставить("Ссылка", Чек.Ссылка);
		ЧекДанные.Вставить("Номер", Чек.Номер);
		ЧекДанные.Вставить("Дата", Чек.Дата);
		
		Возврат ЧекДанные; //Чек.Ссылка
		
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;	
	
КонецФункции

&НаСервере
Функция ПолучитьПродавцаРозницаМА(ТекПользователь)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", ТекПользователь);
	Запрос.УстановитьПараметр("Магазин", ПараметрыСеанса.ТекущийМагазин);
	Запрос.УстановитьПараметр("Настройка", ПланыВидовХарактеристик.НастройкиПользователей["ОсновнойПродавец"]);	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Значение КАК Значение	
		|ИЗ
		|	РегистрСведений.НастройкиПользователей КАК РегистрЗначениеПрав
		|
		|ГДЕ
		|	Пользователь = &Пользователь
		|	И Магазин    = &Магазин
		|	И Настройка  = &Настройка
		|";
	Выборка = Запрос.Выполнить().Выбрать();	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;	
	Возврат Неопределено;
КонецФункции


&НаСервере
Функция ОформитьЧекРМКНаСервере()
	Попытка  	
		Чек = Документы.ЧекККМ.СоздатьДокумент(); 		
		Чек.Дата = ТекущаяДата();
		Чек.КассаККМ = Объект.КассаККМ;
		Чек.Организация = Объект.ОрганизацияДляЗаявки;
		Чек.СуммаДокумента = СуммаКорзины;
		Попытка
			Чек.ЦенаВключаетНДС = Истина;
		Исключение
		    Чек.СуммаВключаетНДС = Истина;
		КонецПопытки;
				
		Для Каждого Строка Из Объект.ЗаявкаНаОформление Цикл
			Если Строка.Выбран Тогда				
				Попытка
				   ЧекСтрока = Чек.Товары.Добавить();
				   ЧекСтрока.Номенклатура = Строка.Номенклатура;
				   ЧекСтрока.СуммаРучнойСкидки = Строка.Сумма - Строка.СуммаСоСкидкой;
				   ЧекСтрока.КоличествоУпаковок = Строка.Количество;
				   ЧекСтрока.Количество = Строка.Количество;
				   ЧекСтрока.Цена = Строка.Цена;
				   ЧекСтрока.Сумма = Строка.СуммаСоСкидкой;
				   ЧекСтрока.СтавкаНДС = Строка.СтавкаНДС;
				   ЧекСтрока.СуммаНДС = Строка.СуммаНДС;
				   ЧекСтрока.ПроцентРучнойСкидки = Строка.Скидка;
				   
				   Если НЕ Чек.Метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("Продавец") = Неопределено Тогда
					   ЧекСтрока.Продавец = ПараметрыСеанса.ТекущийПользователь;
				   КонецЕсли;
			   Исключение
				   ЧекСтрока = Чек.Запасы.Добавить();				   
				   ЧекСтрока.Номенклатура = Строка.Номенклатура;				   
				   ЧекСтрока.ЕдиницаИзмерения = Строка.Номенклатура.ЕдиницаИзмерения;
				   ЧекСтрока.Количество = Строка.Количество;
				   ЧекСтрока.Цена = Строка.Цена;
				   ЧекСтрока.Сумма = Строка.СуммаСоСкидкой;
				   ЧекСтрока.СтавкаНДС = Строка.СтавкаНДС;
				   ЧекСтрока.СуммаНДС = Строка.СуммаНДС;
				   ЧекСтрока.Всего = Строка.Всего;
			   КонецПопытки;
		   КонецЕсли;
		КонецЦикла; 
		Чек.Записать();
        ЧекДанные = Новый Структура;
        ЧекДанные.Вставить("Ссылка", Чек.Ссылка);
        ЧекДанные.Вставить("Номер", Чек.Номер);
		ЧекДанные.Вставить("Дата", Чек.Дата);
	
		Возврат ЧекДанные; 
	
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;	
	
КонецФункции


&НаКлиенте
Процедура ОчиститьЗаявку(Команда)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если Объект.ЗаявкаНаОформление.Количество()=0 Тогда возврат;КонецЕсли;
	
    СтрокиВыбран=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина));
	ВыбранКолво=СтрокиВыбран.Количество();
	Если Объект.ЗаявкаНаОформление.Количество()=ВыбранКолво Тогда ВыбранКолво=0;КонецЕсли;
	 
	Если ВыбранКолво>0 Тогда 
		ОО=Новый ОписаниеОповещения("ОчисткаЗаявки",ЭтаФорма,СтрокиВыбран);
		ПоказатьВопрос(ОО,"Удалить выбранные записи?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ОО=Новый ОписаниеОповещения("ОчисткаЗаявки",ЭтаФорма,Объект.ЗаявкаНаОформление);
		ПоказатьВопрос(ОО,"Удалить все записи товара?",РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчисткаЗаявки(Ответ,Строки) Экспорт
	Если Ответ<>КодВозвратаДиалога.Да Тогда Возврат;КонецЕсли;
	Колво=Строки.Количество();
	Для инд=1 по колво Цикл
		Стр=Строки[Колво-инд];
		Объект.ЗаявкаНаОформление.Удалить(Стр);
	КонецЦикла;
	ЗаявкаНаОформлениеПослеУдаления(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВКорзинуОнлайн(Команда)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;//зк(
	Если ТекДан=Неопределено Тогда Возврат;КонецЕсли;
	Отбор=Новый Структура("Выбран",Истина);
	Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
	Если Строки.Количество()=0 Тогда
		ПоказатьПредупреждение(,"Нет ни одной отмеченной заявки для переноса в корзину поставщика");
	Иначе
		// Контроль на кратность
		Для Каждого Запись Из Строки Цикл
			Если ТипЗнч(Запись.Кратность) = Тип("Число") И Запись.Кратность<>0 И Запись.Кратность <> 1 Тогда
				Если Запись.Количество/Запись.Кратность <> Цел(Запись.Количество/Запись.Кратность) Тогда
					Сообщить("В строке "+Запись.НомерСтроки+" возникли ошибки при отправке в корзину: Количество товара не соответсвует кратности. Для текущей позиции кратность равна "+Строка(Запись.Кратность));
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		Запросы=ВКорзинуОнлайнНаСервере(Отбор);  //зк)вс(
		Для Каждого Запрос Из Запросы Цикл
			СендерОтправить(Запрос);
		КонецЦикла;                          //вс)
		Элементы.Группа10.Заголовок="Заказанное ("+Строка(Объект.ЗаявкаПоставщику.Количество())+")";
		СохранитьДанныеПоЗаказамПоставщикам(ПользовательКорзины);
		СохранитьДанныеПоКорзине(ПользовательКорзины);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВКорзинуОнлайнНаСервере(Отбор,Выбрать=Ложь) //зк(
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.КорзинаСоздатьНоменклатуру(Отбор);
	ЗначениеВДанныеФормы(Обработка.ЗаявкаНаОформление,Объект.ЗаявкаНаОформление);	

	ЗаявкаПост=Обработка.ЗаявкаПоставщику.ВыгрузитьКолонки(); //вс(
	Обработка.ВКорзинуПроценки(Объект.ЗаявкаНаОформление,ЗаявкаПост,Отбор); //зк)
	Запросы=Новый Массив;
	Для Каждого Стр Из ЗаявкаПост Цикл
		Нов=Объект.ЗаявкаПоставщику.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Стр);
		Нов.КодСтроки=КодНовойСтрокиПользователя(Объект.ЗаявкаПоставщику,ПользовательКорзины);
		Нов.КодВКорзине=Стр.КодВКорзине;
		Если Выбрать Тогда Нов.Выбран=Истина;КонецЕсли;
		Объект.ЗаявкаНаОформление[Стр.КодСтроки].КодЗП=Нов.КодСтроки;
		Объект.ЗаявкаНаОформление[Стр.КодСтроки].Статус=?(ПустаяСтрока(Нов.СтатусПозиции),Нов.СтатусЗаказа,Нов.СтатусПозиции);
		Нов.Пользователь=ПользовательКорзины;
		Стр=СтруктураЗаявкаПоставщику();
		ЗаполнитьЗначенияСвойств(Стр,Нов);
		Строка=СтруктураВСтроку(Стр);
		Запросы.Добавить("{""table"":""ordered"",""action"":""add"",""idData"":"
		+Формат(Нов.КодСтроки,"ЧГ=;ЧН=")+",""data"":"+Строка+"}");
		Если Объект.СборАналитики ТОгда
			Запросы.Добавить(Новый Структура("schema, action, ID, deliveryCount,deliveryDate,ipUser,noReply",
			"analytics","toOrder",Нов.КодВКорзине,Окр(Нов.Количество,0),
			Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""),Объект.IPКлиента,Истина))
		КонецЕсли;
	КонецЦикла;
	Возврат Запросы;
КонецФункции

