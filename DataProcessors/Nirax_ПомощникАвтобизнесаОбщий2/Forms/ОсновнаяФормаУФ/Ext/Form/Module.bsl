&НаСервере
Функция ЗаполнитьДоговорАА6(Организация, Контрагент)
	ДоговорНаПродажу = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст =   "ВЫБРАТЬ
	                 |	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка
	                 |ИЗ
	                 |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	                 |ГДЕ
	                 |	ДоговорыВзаиморасчетов.Организация = &Организация
	                 |	И ДоговорыВзаиморасчетов.ПодразделениеКомпании = &ПодразделениеКомпании
	                 |	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
	                 |	И ДоговорыВзаиморасчетов.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПараметрыСеанса.ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоров.Продажа);
	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока ВЫборка.Следующий() Цикл
		ДоговорНаПродажу = Выборка.Ссылка;
		Прервать;
	КонецЦикла;
	Возврат ДоговорНаПродажу;
КонецФункции

&НаСервере
Функция НайтиЗначениеПартнераПоКонтрагенту(ЗначениеНаименования)
	Если Объект.Конфигурация="УправлениеНебольшойФирмой 1.6" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Спр = Справочники.Контрагенты.НайтиПоНаименованию(ЗначениеНаименования,Истина,);
	Если ЗначениеЗаполнено(Спр.Партнер) Тогда
		Возврат Спр.Партнер;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаявкаНаОформлениеПриИзменении(Элемент)
	ТекДан=Элементы.ЗаявкаНаОформление.ТекущиеДанные;//зк(
	ТекЗак=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если ТекДан<>Неопределено Тогда
		Данные=Новый Структура("Количество,Цена,Сумма,Скидка,СуммаСоСкидкой,СтавкаНДС,СуммаНДС,Всего");
		ЗаполнитьЗначенияСвойств(Данные,ТекДан);
		ЗаявкаНаОформлениеПриИзмененииНаСервере(Данные);
		ЗаполнитьЗначенияСвойств(ТекДан,Данные);
		ТекЗак.Сумма=Объект.ЗаявкаНаОформление.Итог("Всего");     //зк)
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаявкаНаОформлениеПриИзмененииНаСервере(Данные)
	РассчитатьСуммы(Данные);
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкаНаОформлениеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	НовСтр=Элементы.ЗаявкаНаОформление.ТекущиеДанные;
	Если НоваяСтрока Тогда
		НовСтр.Склад=Объект.СкладДляЗаявки;
		НовСтр.СтавкаНДС=Объект.НДСПоУмолчанию;
    	НовСтр.Наименование = ПолучитьПустуюСсылкуНаСервере("Справочник", "Номенклатура");
		НовСтр.Номенклатура = ПолучитьПустуюСсылкуНаСервере("Справочник", "Номенклатура");
		НовСтр.Заказ=Элементы.ЗаказыКлиентов.ТекущиеДанные.Заказ; //зк()
	КонецЕсли;
	Если Элемент.ТекущийЭлемент.Имя = "ЗаявкаНаОформлениеЗаказПокупателя" Тогда
		Если НЕ ЗначениеЗаполнено(НовСтр.ЗаказПокупателя) Тогда
			ЗаказИмя = Объект.Реквизит1С.Заказ;	
			Если ЗаказИмя<>Неопределено Тогда
				МассивТипов=Новый Массив();
				МассивТипов.Добавить(Тип("ДокументСсылка."+ЗаказИмя));
				Элемент.ТекущийЭлемент.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПустуюСсылкуНаСервере(ИмяОбъекта, ИмяРеквизита)
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьПустуюСсылку(ИмяОбъекта, ИмяРеквизита);	
КонецФункции

