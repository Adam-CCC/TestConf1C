&НаКлиенте
Процедура ПоискПоАртикулу(СписокГрупп="") Экспорт
	Если СписокГрупп=Неопределено Тогда СписокГрупп="";КонецЕсли;
	Попытка
		СтрокаОриг = Объект.НомерАртикула;
		СтрокаПоиска = ПодготовитьНомер(СтрокаОриг);
		Если (ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоАртикулу или Объект.ОбщийПоискВрем)
			И Объект.ИспользоватьБазуКроссов Тогда
			ПоискВКроссах(СписокГрупп);
		КонецЕсли;
		
	Если (Объект.ОбщийПоискВрем или ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоПрайсу)
		И Объект.ИспользоватьПрайсЛист Тогда
			//- ПоискПрайсНаКлиенте(СтрокаПоиска,СтрокаОриг);
			ПоискПрайсНаКлиенте_3(СтрокаПоиска,СтрокаОриг);
		КонецЕсли;

		Если ((Объект.ОбщийПоискВрем или ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.ПоискЕмекс) ИЛИ
			(Объект.ОбщийПоискВрем или ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.ГруппаУточнениеПоиска) ) И 
			Объект.ИспользоватьПроценкуОнлайнПоставщиков Тогда	
			Объект.РезультатПоискаОнлайн.Очистить(); 
			ПоискПроценки();
			//УровеньЦенЕмексПриИзмененииНаСервере();
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	УстановитьОтборФильтр();
КонецПроцедуры

