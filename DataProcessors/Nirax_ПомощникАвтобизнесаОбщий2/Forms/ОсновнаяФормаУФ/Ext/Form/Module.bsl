&НаКлиенте
Процедура ОформитьДокументы(Команда)
	Список=Новый СписокЗначений();
	Если Объект.Реквизит1С.Заказ<>Неопределено И ИзменятьКорзину Тогда Список.Добавить("ЗаказПокупателя","Заказ покупателя");КонецЕсли;
	Если Объект.Реквизит1С.ЗаказНаряд<>Неопределено Тогда Список.Добавить("ЗаказНаряд","Заказ-наряд");КонецЕсли;
	Если Объект.Реквизит1С.Реализация<>Неопределено Тогда Список.Добавить("РеализацияТоваров","Реализация товаров");КонецЕсли;
	Если Объект.Реквизит1С.СчетФактураВыданный<>Неопределено Тогда Список.Добавить("СчетФактура","Счет-фактура");КонецЕсли;
	Если Список.Количество()=0 Тогда 
		Сообщить("Нет документов для оформления");
	Иначе	
		ОО=Новый ОписаниеОповещения("ОформитьЗаявку",ЭтаФорма);
		Список.ПоказатьОтметкуЭлементов(ОО,"Выберите документы для оформления");
	КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура ОформитьЗаявку(Команда,Доп=Неопределено) Экспорт
	//зк(
	Объект.ЗаказПокупателя=Ложь;
	Объект.ЗаказНаряд=Ложь;
	Объект.РеализацияТоваров=Ложь;
	Объект.СчетФактура=Ложь;
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если ТекДан=Неопределено или Команда=Неопределено Тогда Возврат;
	ИначеЕсли ТипЗнч(Команда)=Тип("СписокЗначений") Тогда
		НетПометок=Истина;
		Для Каждого Стр Из Команда Цикл
			Если Стр.Пометка Тогда
				Объект[Стр.Значение]=Истина;
				НетПометок=Ложь;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Команда.Имя="ОформитьЗаказПокупателя" Тогда
		Объект.ЗаказПокупателя=Истина;
	ИначеЕсли Команда.Имя="ОформитьЗаказНаряд" Тогда
		Объект.ЗаказНаряд=Истина;
	ИначеЕсли Команда.Имя="ОформитьРеализациюТоваров" Тогда
		Объект.РеализацияТоваров=Истина;
	ИначеЕсли Команда.Имя="ОформитьСчетФактуру" Тогда
		Объект.СчетФактура=Истина;
	КонецЕсли;
		
	Если Объект.ЗаявкаНаОформление.Количество()=0 Тогда
		Сообщить("Список товара пуст");
		возврат;
	КонецЕсли;
	
	Предупреждение=?(Объект.ЗаказПокупателя = Истина И  ЗначениеЗаполнено(ТекДан.ЗаказПокупателя),"Для заявки уже определен "
	+Строка(ТекДан.ЗаказПокупателя)+Символы.ПС,"");
	
	ОтборВыбран=Новый Структура("Выбран",Истина);
    Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(ОтборВыбран);
	ВыбранКолво=Строки.Количество();
	Если Объект.ЗаявкаНаОформление.Количество()=ВыбранКолво Тогда ВыбранКолво=0;КонецЕсли;
	
	Объект.КонтрагентДляЗаявки=ТекДан.Контрагент;
	Объект.Соглашение=?(ТекДан.Соглашение<>Неопределено,ТекДан.Соглашение,
	?(Элементы.ЗаказСоглашение.Видимость=Истина,Элементы.ЗаказСоглашение.ОграничениеТипа.ПривестиЗначение(""),Неопределено));
	Объект.ДоговорДляЗаявки=?(ТекДан.Договор<>Неопределено,ТекДан.Договор,
	?(Элементы.ЗаказДоговор.Видимость=Истина,Элементы.ЗаказДоговор.ОграничениеТипа.ПривестиЗначение(""),Неопределено));
	Объект.СкладДляЗаявки=?(ЗначениеЗаполнено(ТекДан.Склад),ТекДан.Склад,Объект.Склад);
	
	Рез=КонтрольДанныхДляДокументовНаСервере();
	Если Рез<>"" Тогда
		Если Лев(Рез,1)="!" Тогда
			ПоказатьПредупреждение(,"Для оформления документов необходимо в настройках и форме определить следующие данные:"+
			Символы.ПС+Сред(Рез,2));
			Возврат;
		ИначеЕсли ВыбранКолво>0 Тогда
			ОО=Новый ОписаниеОповещения("ОформлениеЗаявки",ЭтаФорма,ОтборВыбран);
			ПоказатьВопрос(ОО,Предупреждение+"Для оформления документов рекомендуется в настройках и форме определить следующие данные:"+
			Символы.ПС+Рез+Символы.ПС+"Оформить документы выбранных позиций?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		Иначе
			ОО=Новый ОписаниеОповещения("ОформлениеЗаявки",ЭтаФорма,Неопределено);
			ПоказатьВопрос(ОО,Предупреждение+"Для оформления документов рекомендуется в настройках и форме определить следующие данные:"+
			Символы.ПС+Рез+Символы.ПС+"Оформить документы?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		КонецЕсли;
	ИначеЕсли ВыбранКолво>0 Тогда 
		ОО=Новый ОписаниеОповещения("ОформлениеЗаявки",ЭтаФорма,ОтборВыбран);
		ПоказатьВопрос(ОО,Предупреждение+"Оформить документы выбранных позиций?",РежимДиалогаВопрос.ДаНет,,
		?(Предупреждение="",КодВозвратаДиалога.Да,КодВозвратаДиалога.Нет));
	ИначеЕсли Предупреждение<>"" Тогда 
		ОО=Новый ОписаниеОповещения("ОформлениеЗаявки",ЭтаФорма,Неопределено);
		ПоказатьВопрос(ОО,Предупреждение+"Оформить документы выбранных позиций?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	Иначе
		ОформлениеЗаявки(КодВозвратаДиалога.Да,Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОформлениеЗаявки(Ответ,Отбор) Экспорт
	ЕСли Ответ<>КодВозвратаДиалога.Да И Ответ<>КодВозвратаДиалога.ОК Тогда Возврат;КонецЕсли;
	МасДок=ОформитьЗаявкуНаСервере(Отбор);
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если МасДок.Количество()>0 Тогда
		// Если документы создавались из строк корзины - они перемещаются в отдельную заявку
		Если ТекДан.Заказ=0 Тогда
			Нов=Объект.ЗаказыКлиентов.Добавить();
			Заказ=НовыйКодТаблицы(Объект.ЗаказыКлиентов,"Заказ");
			ЗаполнитьЗначенияСвойств(Нов,Новый Структура("Заказ,Наименование,Дата,Контрагент,Соглашение,Договор,Склад,ДатаОтгрузки,Статус,Отбор",
			Заказ,Формат(ТекущаяДата(),"ДФ=дд.ММ.гг ЧЧ:мм")+" / "+Строка(ТекДан.Контрагент),ТекущаяДата(),
			ТекДан.Контрагент, ТекДан.Соглашение,ТекДан.Договор, ТекДан.Склад,ТекДан.ДатаОтгрузки,0,Истина));
			
			ИзКорзиныВНовуюЗаявку(Отбор,Заказ);
			Элементы.ЗаказыКлиентов.ТекущаяСтрока=Нов.ПолучитьИдентификатор();
			ТекДан=Нов;
			Нов.Сумма = Объект.ЗаявкаНаОформление.Итог("Всего");
			Строки = Объект.ЗаявкаНаОформление;
		Иначе
			Строки=?(Отбор=Неопределено,Объект.ЗаявкаНаОформление,Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор));
		КонецЕсли;
		
		СохранитьКорзину=Ложь;
		Для Каждого Стр Из МасДок Цикл
			Если Стр.Свойство("Склад") Тогда
				// Реквизит Склад есть только в заказе
				ТекДан.ЗаказПокупателя=Стр.Ключ;
				Для Каждого Строка Из Строки Цикл
					Строка.ЗаказПокупателя=Стр.Ключ;
					Если Объект.СборАналитики Тогда
						СендерОтправить(Новый Структура("schema, action, ID, customerCount,customerPrice,customerDate,ipUser,noReply",
						"analytics","toDocClient",Строка.КодВКорзине,Окр(Строка.Количество,0),Окр(Строка.Цена,0),
						Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""), Объект.IPКлиента,Истина));
					КонецЕсли;
					ЕСли Объект.ЗаказВКомментарий Тогда
						Строка.Комментарий=Строка(Стр.Ключ)+"; "+Строка.Комментарий;
					КонецЕсли;
				КонецЦикла;
				
				
				СохранитьКорзину=Истина;
			ИначеЕсли Объект.ЗаказВКомментарий И Лев(Стр.Ключ,11)="Заказ-наряд" Тогда
				Для Каждого Строка Из Строки Цикл
					Строка.Комментарий=Строка(Стр.Ключ)+"; "+Строка.Комментарий;
				КонецЦикла;
			КонецЕсли;
			Если Ответ=КодВозвратаДиалога.Да  или (Объект.ПроводитьДокументы И Стр.Свойство("Проведен") и Не Стр.Проведен) Тогда
				ОткрытьФорму("Документ."+Стр.Имя+".ФормаОбъекта",Стр);
			КонецЕсли;
		КонецЦикла;
		
		Если СохранитьКорзину и ИзменятьКорзину Тогда
			СохранитьДанныеПоКорзине(ПользовательКорзины);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере      
Процедура ИзКорзиныВНовуюЗаявку(Отбор,Заказ)
	ЕСли Отбор=Неопределено Тогда
		Данные=Объект.ЗаявкаНаОформление.Выгрузить();
		Объект.ЗаявкаНаОформление.Очистить();
		Объект.ЗаказыКлиентов[0].Сумма = 0;
	Иначе
		Строки = Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
		Данные = Объект.ЗаявкаНаОформление.Выгрузить(Строки);
		// Удалим строки
		Колво=Строки.Количество();
		Для инд=1 по колво Цикл
			Строка=Строки[Колво-инд];
			Объект.ЗаявкаНаОформление.Удалить(Строка);
		КонецЦикла;
		Объект.ЗаказыКлиентов[0].Сумма = Объект.ЗаявкаНаОформление.Итог("Всего");
	КонецЕсли;
	Элементы.СтрКорзина.Заголовок="Корзина"+?(Объект.ЗаявкаНаОформление.Количество()=0,"",
	" ("+Объект.ЗаявкаНаОформление.Количество()+")");
	
	// Смена заявки и пополнение строками
	СменитьЗаявку(Заказ);
	Данные.ЗаполнитьЗначения(Заказ,"Заказ");
	Объект.ЗаявкаНаОформление.Загрузить(Данные);
	
КонецПроцедуры

&НаСервере      
Функция КонтрольДанныхДляДокументовНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
