&НаКлиенте
Процедура ЗаявкаПоставщикуСтатусПриИзменении(Элемент)
	СохранитьКорзину=Ложь;
	Стр=Элементы.ЗаявкаПоставщику.ТекущиеДанные;

	СендерОтправить("{""table"":""ordered"", ""action"":""edit"",""status"":"""+Стр.СтатусПозиции
	+""",""idData"":"+Формат(Стр.КодСтроки,"ЧГ=;ЧН=")+",""name"":"""+Стр.Пользователь+"""}");  //",""data"":"+Строка+
	Если ПользовательКорзины=Стр.Пользователь Тогда
		Стрк=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("КодЗП",Стр.КодСтроки));
		Если Стрк.Количество()>0 Тогда
			Стрк[0].Статус=Стр.СтатусПозиции;
			СохранитьКорзину=Истина;
		КонецЕсли;
	КонецЕсли;
	Если СохранитьКорзину И ИзменятьКорзину Тогда
		СохранитьДанныеПоКорзине(ПользовательКорзины);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОбновитьСтатусыЗаявкиНаСервере(Связки)
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ОбновитьСтатусыПроценки(Объект.ЗаявкаПоставщику,Связки);	
КонецФункции

&НаКлиенте
Процедура ОбновитьСтатусыЗаявки(Команда)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если ТекДан=Неопределено тогда Возврат;КонецЕсли;
	Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина));
	Если Строки.Количество()=0 Тогда
		Строки=Объект.ЗаявкаНаОформление;
		Если Строки.Количество()=0 ТОгда Возврат;КонецЕсли;
	    Отмеченных="";
	Иначе
		Отмеченных="выбранных";
	КонецЕсли;
	Связки=Новый Массив;
	Для Каждого Стр из Строки Цикл
		Если Стр.КодЗП<>0 И Не ПустаяСтрока(Стр.КодЗаказа) Тогда
			Связки.Добавить(Новый Структура("Пользователь,КодСтроки",ПользовательКорзины,Стр.КодЗП));
		КонецЕсли;
	КонецЦикла;
	Если Связки.Количество()=0 Тогда
		Сообщить("Среди "+Отмеченных+" строк заявки не найдены строки, отправленные на сайт");
		Возврат;
	КонецЕсли;
	
	КодыСтрок=ОбновитьСтатусыЗаявкиНаСервере(Связки);
	
	Если КодыСтрок.Количество()=0 Тогда Возврат;КонецЕсли;
	
	Для Каждого Значение из КодыСтрок Цикл
		Мстр=Объект.ЗаявкаПоставщику.НайтиСтроки(Значение);
		Если Мстр.Количество()>0 Тогда
			Стр=Мстр[0];
			Статус=?(ПустаяСтрока(Стр.СтатусПозиции),Стр.СтатусЗаказа,Стр.СтатусПозиции);
			СендерОтправить("{""table"":""ordered"", ""action"":""edit"",""status"":"""+Статус
			+""",""idData"":"+Формат(Стр.КодСтроки,"ЧГ=;ЧН=")+",""name"":"""+ПользовательКорзины+"""}"); 
			
			Стрк=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("КодЗП",Стр.КодСтроки));
			Если Стрк.Количество()>0 Тогда Стрк[0].Статус=Статус;КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Пользователи=Новый Соответствие;
	Пользователи.Вставить(ПользовательКорзины);
	СохранитьДанныеПоЗаказамПоставщикам(Пользователи);
	СохранитьДанныеПоКорзине(ПользовательКорзины);

КонецПроцедуры

&НаКлиенте
Процедура ВЗаявку(Команда)
	ТекДан=Элементы.ЗаявкаПоставщику.ТекущиеДанные;
	Если ТекДан=Неопределено тогда Возврат;КонецЕсли;
	Если ТекДан.Пользователь<>ПользовательКорзины Тогда
		Сообщить("Сейчас идет работа с корзиной другого пользователя");
	Иначе
		Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("КодЗП",ТекДан.Кодстроки));
		Если Строки.Количество()=0 Тогда
			КодЗП=ТекДан.Кодстроки;
			Если Не НайтиЗаявку(КодЗП) Тогда
				Сообщить("В корзине этой строки нет");
				Возврат;
			КонецЕсли;
			Строки=Объект.ЗаказыКлиентов.НайтиСтроки(Новый Структура("Заказ",Объект.ТекущийЗК));
			Элементы.ЗаказыКлиентов.ТекущаяСтрока=Строки[0].ПолучитьИдентификатор();
			Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("КодЗП",КодЗП));
		КонецЕсли;
		Строка=Строки[0];
		Элементы.ЗаявкаНаОформление.ТекущаяСтрока=Строка.ПолучитьИдентификатор();
		Элементы.Страницы.ТекущаяСтраница=Элементы.СтрКорзина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКонтрагентДляЗаявкиСоздание(Элемент, СтандартнаяОбработка)	
	Если Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
		ОткрыватьСправочникПартнеров = ИспользоватьПартнеровКакКонтрагентов();
		Если ОткрыватьСправочникПартнеров Тогда
			СтандартнаяОбработка = Ложь;
			
			ПараметрыФормы = Новый Структура;
			Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияФормыВводаПартнера", ЭтаФорма);
			ОткрытьФорму("Справочник.Партнеры.Форма.ПомощникНового", ПараметрыФормы,ЭтаФорма,,,,Оповещение);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ИспользоватьПартнеровКакКонтрагентов()
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровКакКонтрагентов");
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеЗакрытияФормыВводаПартнера(Результат, ДополнительныеПараметры) Экспорт
	ВыполнитьПослеЗакрытияФормыВводаПартнераНаСервере(Результат);
	Если ЗначениеЗаполнено(Объект.КонтрагентДляЗаявки) Тогда
		КонтрагентДляЗаявкиПриИзменении("");
	Конецесли;
