&НаСервере
Функция СтруктураВСтроку(Стр)
	Строка=ЗначениеВСтрокуВнутр(Стр);	
	Попытка
		ДемоКомп = Новый("AddIn.NiraxVK.Image");
		Возврат """"+ДемоКомп.ТекстJson(Строка)+"""";
