&НаКлиенте
Процедура ОтборВКорзинуЛокальноНаСервере()

	Попытка
		ТекДанные = Элементы.РезультатПоискаОнлайн.ТекущиеДанные;		
		
		Если Число(ТекДанные.Наличие) <= 0 И Объект.КонтрольОстатков Тогда
			Попытка
				ПоказатьПредупреждение(,"Не хватает товара на складе");
			Исключение
				Сообщить("Не хватает товара на складе");
			КонецПопытки;          			
			Возврат;               
		КонецЕсли;			
		
		БезПроизводителя=Ложь;
		Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
			ТекНоменклатура = ТекДанные.Номенклатура;
		Иначе
			ТекНоменклатура = ТекДанные.НаименованиеДетали;
			Если Объект.ПоискПоОчищенному и Объект.ОчищеннаяТаблица.Количество() > 0 Тогда
				Масс = Объект.ОчищеннаяТаблица.НайтиСтроки(Новый Структура("Артикул,Производитель",ТекДанные.Артикул,""));
				Если Масс.Количество() > 0 Тогда БезПроизводителя = Истина;КонецЕсли;
			Иначе
				БезПроизводителя = НайтиБезПроизводителя(ТекДанные.Артикул, ТекДанные.КодПроизводителя);
			КонецЕсли;
		КонецЕсли;
		Поставщик=ПоставщикСайта(ТекДанные.Сайт);
		
		Запись2 = Новый Структура(
			"КодТовара, Номенклатура, Наименование, Склад, idСклад, ЦенаПоставки, Сайт, КодПроизводителя, 
			|Производитель, Артикул, Кратность, ДляКорзины, Номенклатура, Наличие, Цена, КодСкидки, СрокДоставки, 
			|СрокДоставкиГарантированный, Наличие, ИсточникИнформации, БезПроизводителя, Поставщик, КодВКорзине, Наличие1С", 
	        ТекДанные.КодТовара, ТекДанные.Номенклатура, ТекНоменклатура, ТекДанные.Склад, 
	        ТекДанные.idСклад, ТекДанные.ЦенаПоставки, ТекДанные.Сайт, ТекДанные.КодПроизводителя,
			ТекДанные.Производитель, ТекДанные.Артикул, ТекДанные.Кратность, ТекДанные.ДляКорзины,
			ТекДанные.Номенклатура, ТекДанные.Наличие, ТекДанные.ЦенаПродажи, ТекДанные.КодСкидки, 
			ТекДанные.СрокДоставки, ТекДанные.СрокДоставкиГарантированный, ТекДанные.Наличие, 
			ТекДанные.ИсточникИнформации, БезПроизводителя, Поставщик, НовыйКодВКорзине(ЭтаФорма.КодПользователя),ТекДанные.Наличие1С);
			
		Если Объект.ЗапрашиватьКоличество или Объект.ЗапрашиватьЦену или Объект.ЗапрашиватьСкидку Тогда
			ПараметрыФормы=Новый Структура("Номенклатура,Производитель,Склад,Остаток,ЦенаПоУмолчанию,КонтрольОстатков,ЗапрашиватьКолво,ЗапрашиватьЦену,ЗапрашиватьСкидку",
			ТекНоменклатура,ТекДанные.Производитель,Объект.ФильтрСкладЕмекс,ТекДанные.Наличие,ТекДанные.ЦенаПродажи,Объект.КонтрольОстатков,Объект.ЗапрашиватьКоличество,Объект.ЗапрашиватьЦену,Объект.ЗапрашиватьСкидку);
			
			Оповещение=Новый ОписаниеОповещения("ДобавитьВЗаявку",ЭтаФорма,Запись2);
			
			ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение);
		Иначе	
			Данные=Новый Структура("Количество,Цена,Скидка,ДляКорзины",1,ТекДанные.ЦенаПродажи,0,ТекДанные.ДляКорзины);
			ДобавитьВЗаявку(Данные,Запись2);
		КонецЕсли;	
			
	Исключение		
		Сообщить(ОписаниеОшибки());		
	КонецПопытки;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиБезПроизводителя(Артикул, КодПроизводителя)
	Метаном = Метаданные.Справочники.Найти("Номенклатура");
	Если Метаном=Неопределено Тогда Возврат Ложь; КонецЕсли;
	метаНом = МетаНом.Реквизиты;
	Имена=Новый Структура("ор_Производитель,асПроизводитель,Производитель,Поставщик,ор_Поставщик");
	Для Каждого Стр Из Имена Цикл
		Если метаНом.Найти(Стр.Ключ)<>Неопределено Тогда
			имяПроизводитель=Стр.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Имена=Новый Структура("ор_НомерПоКаталогу,НомерПоКаталогу,АртикулПроизводителя,Артикул,АртикулДляПоиска");
	Для Каждого Стр Из Имена Цикл
		Если метаНом.Найти(Стр.Ключ)<>Неопределено Тогда
			имяАртикул=Стр.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если метаНом.Найти("АртикулДляПоиска")<>Неопределено Тогда
		имяАртикулДляПоиска="АртикулДляПоиска";
	Иначе
		имяАртикулДляПоиска=имяАртикул;
	КонецЕсли;
	Если ПодготовитьНомер(КодПроизводителя)<>Артикул Тогда
		КодПроизводителя=Артикул;
	КонецЕсли;
	
	Запрос=Новый Запрос(
	   "ВЫБРАТЬ ПЕРВЫЕ 1
	 |	Номенклатура.Ссылка КАК Ссылка
	 |ИЗ
	 |	Справочник.Номенклатура КАК Номенклатура
	 |ГДЕ
	 |	(Номенклатура."+имяАртикулДляПоиска+" = """+Артикул+"""
	 |			ИЛИ Номенклатура."+имяАртикул+" = """+КодПроизводителя+""")
	 |	И Номенклатура."+имяПроизводитель+" = &Производитель"
	);
	Запрос.УстановитьПараметр("Производитель",Справочники.Номенклатура.ПустаяСсылка()[имяПроизводитель]);
	Вып=Запрос.Выполнить();
	Возврат Не Вып.Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПоставщикСайта(Сайт)
	Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	Если Проценки<>Неопределено ТОгда
		Стр=Проценки.Найти(Сайт,"Сайт");
		Если Стр<>Неопределено Тогда Возврат Стр.Поставщик;КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
