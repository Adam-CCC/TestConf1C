&НаСервере
Функция ПолучитьПоставщика(СайтПост)
	Пост = "";
	Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	Сайт=Проценки.Найти(СайтПост,"НаименованиеСайт");
	Если Сайт<>Неопределено ТОгда
		Попытка
		Если ЗначениеЗаполнено(Сайт.Поставщик) ТОгда
			Пост=Сайт.Поставщик;
		КонецЕсли;
		Исключение КонецПопытки;
	КонецЕсли;
	Возврат Пост;
КонецФункции

