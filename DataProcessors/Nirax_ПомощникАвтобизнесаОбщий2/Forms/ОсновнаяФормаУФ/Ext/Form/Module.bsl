&НаКлиенте
Процедура ПоискПрайсНаКлиенте_3(Артикул, АртОриг)
	
	НастройкаЗагрузки = ПолучитьНастройкиЗагрузки();
	Если НастройкаЗагрузки.Количество()=0 Тогда
		Сообщить("Отсутствуют данные - выполните настройку Прайс листов");
	КонецЕсли;
	
	//артПоиск = ?(НЕ ВРЕГ(СокрЛП(АртОриг)) = ВРЕГ(СОКРЛП(Артикул)), Артикул, АртОриг);	
	артПоиск = ВРЕГ(АртОриг);
	Если ПоНаименованию<>1 и Объект.ПоискПоПрайсуОчиститьАртикул Тогда
		артПоиск = ПодготовитьНомер(артПоиск); 
	КонецЕсли;
	Состояние("Производится поиск товара "+?(ПоНаименованию=0,"артикул","наименование")+" которого содержат "
	+?(ПоЧасти,"текст ","фразу """)+ АртОриг+"""");
	ТЗРез = Новый Массив;
		
	Для Каждого СтрТаб из НастройкаЗагрузки Цикл
		
		РасширениеФайла = ПолучитьРасширениеФайлаНаСервере(СокрЛП(СтрТаб.ПутьКФайлу));
		
		ЕстьЭксель = Истина;
		Попытка
			Эксель = Новый COMОбъект("Excel.Application"); 
			Эксель.Displayalerts = 0;
		Исключение
			ЕстьЭксель = Ложь;
		КонецПопытки;
		
		Если (РасширениеФайла = "csv") И (НЕ ЕстьЭксель) Тогда
			ЗагрузитьCSV(СтрТаб, СтрТаб.ПутьКФайлу, ТЗРез, артПоиск);
		Иначе
			СистемнаяИнформация = Новый СистемнаяИнформация;
			Если (СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86) 
				или (СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64) Тогда
				
				Если Не ЕстьЭксель Тогда
					Сообщить("Ошибка при попытке работы с Mirosoft Excel, возможно он не установлен"+Символы.ПС+ОписаниеОшибки());
					Возврат;
				КонецЕсли;
				
				Попытка	
					Книга = Эксель.WorkBooks.Open(СокрЛП(СтрТаб.ПутьКФайлу),0,Истина);
					Если СтрТаб.Лист<>"" Тогда
						Лист = Книга.Worksheets(СтрТаб.Лист)
					Иначе
						Лист = Книга.Worksheets(1);
					КонецЕсли;
					
					Лист.Activate();
					ВсегоСтрок = Лист.Cells(1,1).SpecialCells(11).Row; 
					//ИмяКолонки = Символ(64+СтрТаб.Артикул);
					//КонОбл = ":"+ИмяКолонки+Формат(ВсегоСтрок, "ЧГ=0");
					Если ПоНаименованию=1 Тогда
						Если ТипЗнч(СтрТаб.Наименование) = Тип("Строка") ТОгда
							Поз = Найти(СтрТаб.Наименование,":");
							Если Поз = 0 Тогда
								ИмяКолонки = Символ(64+Число(СтрТаб.Наименование));
							Иначе
								ИмяКолонки = Символ(64+Число(Лев(СтрТаб.Наименование,Поз-1)))
								+":"+Символ(64+Число(Сред(СтрТаб.Наименование,Поз+1)));
							КонецЕсли;
 						Иначе
							ИмяКолонки = Символ(64+СтрТаб.Наименование);
						КонецЕсли;
					Иначе
						Если ТипЗнч(СтрТаб.Артикул) <> Тип("Строка") Тогда
							ИмяКолонки = Символ(64+СтрТаб.Артикул);
						Иначе
							Поз = Найти(СтрТаб.Артикул,":");
							Если Поз = 0 Тогда
								ИмяКолонки = Символ(64+Число(СтрТаб.Артикул));
							Иначе
								ИмяКолонки = Символ(64+Число(Лев(СтрТаб.Артикул,Поз-1)))+":"+Символ(64+Число(Сред(СтрТаб.Артикул,Поз+1)))
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;

					Диапазон = Лист.Columns(ИмяКолонки);
					//Диапазон = Книга.Worksheets(к).UsedRange;					
					Попытка
												
						Найдено = Диапазон.Find(артПоиск);
						
						Если Найдено<>Неопределено Тогда
							мИстина = -1;
						Иначе
							мИстина = 0;
						КонецЕсли;
					Исключение
						мИстина = 0;
					КонецПопытки;	
					
					Если мИстина = -1 Тогда
						АдресПреж = Найдено.Address;
						Пока мИстина = -1 Цикл
							Разбирать=Истина;
							Если ПредставитьВВидеЧисла(СтрТаб.Наименование) <> 0 Тогда
								ПрайсНаименование = СтрЗаменить(СокрЛП(Лист.Cells(Найдено.Row, ПредставитьВВидеЧисла(СтрТаб.Наименование)).Value), Символы.НПП, "");
								Если ПоНаименованию>0 И Не ПоЧасти Тогда
									Разбирать=Найти(" "+ВРЕГ(ПрайсНаименование)+" "," "+артПоиск+" ")>0;
								КонецЕсли;
							Иначе
								ПрайсНаименование = "";
							КонецЕсли;
							Если ПредставитьВВидеЧисла(СтрТаб.Артикул) <> 0 Тогда
								ПрайсАртикул = СтрЗаменить(СокрЛП(Лист.Cells(Найдено.Row, ПредставитьВВидеЧисла(СтрТаб.Артикул)).Value), Символы.НПП, "");
								Если Не ПоНаименованию И Не ПоЧасти Тогда
									Разбирать=Найти(" "+ВРЕГ(ПрайсАртикул)+" "," "+артПоиск+" ")>0;
								КонецЕсли;
							Иначе
								ПрайсАртикул = "";
							КонецЕсли;
							Если Разбирать Тогда
								Если ПредставитьВВидеЧисла(СтрТаб.Производитель) <> 0 Тогда
									ПрайсПроизводитель = СтрЗаменить(СокрЛП(Лист.Cells(Найдено.Row, ПредставитьВВидеЧисла(СтрТаб.Производитель)).Value), Символы.НПП, "");
								Иначе
									ПрайсПроизводитель = "Отсутствует";
								КонецЕсли;
								Если ПредставитьВВидеЧисла(СтрТаб.Цена) <> 0 Тогда
									ПрайсЦена = СтрЗаменить(СокрЛП(Лист.Cells(Найдено.Row, ПредставитьВВидеЧисла(СтрТаб.Цена)).Value), Символы.НПП, "");
								Иначе
									ПрайсЦена = "0";
								КонецЕсли;
								Если ПредставитьВВидеЧисла(СтрТаб.Остаток) <> 0 Тогда
									ПрайсОстаток = ПодготовитьНомер(СокрЛП(Лист.Cells(Найдено.Row, ПредставитьВВидеЧисла(СтрТаб.Остаток)).Value));
								Иначе
									ПрайсОстаток = "0";
								КонецЕсли;
								Если ПредставитьВВидеЧисла(СтрТаб.Время) <> 0 Тогда
									ПрайсВремя = СтрЗаменить(СокрЛП(Лист.Cells(Найдено.Row, ПредставитьВВидеЧисла(СтрТаб.Время)).Value), Символы.НПП, "");
								Иначе
									ПрайсВремя = "";
								КонецЕсли;
								
								ТЗРез.Добавить(Новый Структура("Полное_описание_русский, Поставщик, Артикул, ЦенаПрайс, Остаток, Срок, ПоставщикПрайс",
								ПрайсНаименование, ПрайсПроизводитель, ПрайсАртикул, ПрайсЦена, ПрайсОстаток, ПрайсВремя, СтрТаб.Поставщик));							
							КонецЕсли;
							
							Попытка
								Найдено = Диапазон.FindNext(Найдено);
								Если Найдено<>Неопределено Тогда 
									мИстина = -1;
								Иначе
									мИстина = 0;
								КонецЕсли;
							Исключение
								мИстина = 0;
							КонецПопытки;	
							
							мИстина = ?((мИстина = -1) И (НЕ Найдено.Address = АдресПреж), -1, 0);
						КонецЦикла;	
					КонецЕсли;	
					
					Книга.Close();
				Исключение
					Сообщить("Ошибки при разборе данных прайс-листа:"+Символы.ПС+"Файл: "+СтрТаб.ПутьКфайлу+" лист: "+СтрТаб.Лист+символы.ПС+"Возможно ошибки в настройках или данных.");
					Попытка Книга.Close();Исключение;КонецПопытки;
				КонецПопытки;
			Иначе //читаем средствами xml
				//нужно установить пакет gnumeric
				//apt-get install gnumeric
				//скопировать скрипт convert.sh в каталог программы
				//конвертируем в csv
				#Если НЕ ВебКлиент Тогда
					ПутьКНовомуФайлу = "";
					ПозицияПоследнейТочки = Найти(СтрТаб.ПутьКФайлу, ".");
					ПутьКНовомуФайлу = Лев(СтрТаб.ПутьКФайлу,ПозицияПоследнейТочки)+"csv"; 
					Если ЗначениеЗаполнено(ПутьКНовомуФайлу) Тогда
						ЗапуститьПриложение("/bin/bash "+КаталогПрограммы()+"convert.sh "+СтрТаб.ПутьКФайлу+" "+ПутьКНовомуФайлу,,Истина);
						ЗагрузитьCSV(СтрТаб, ПутьКНовомуФайлу, ТЗРез, артПоиск);
					КонецЕсли;
				#КонецЕсли
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Эксель = Неопределено;
	ПоискПрайсНаСервере(ТЗРез, АртОриг);
	Состояние();
	
КонецПроцедуры


&НаКлиенте
Процедура ЗагрузитьCSV(СтрТаб, ПутьКФайлу, ТЗРез, артПоиск)
	// Чтение файла
	Если Не ПоЧасти Тогда артПоиск=" "+артПоиск+" ";КонецЕсли;
	ЗагружаемыйФайл = Новый ТекстовыйДокумент;
	ЗагружаемыйФайл.Прочитать(СокрЛП(ПутьКФайлу));
	
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если (СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86) 
		или (СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64) Тогда
		Разделитель = ";";
	Иначе
		Разделитель = ",";
	КонецЕсли;
	
	КоличествоСтрок = ЗагружаемыйФайл.КоличествоСтрок();
	Для Строка = 1 По КоличествоСтрок Цикл
		ОбработкаПрерыванияПользователя();
		
		Если ПустаяСтрока(ЗагружаемыйФайл.ПолучитьСтроку(Строка)) Тогда
			Продолжить;
		КонецЕсли;
		
		// Чтение строки из файла тхт / csv
		СтрокаИзФайла = ЗагружаемыйФайл.ПолучитьСтроку(Строка);
		// Разбор строки в массив, используя в качествен символа-разделителя "|"
		МассивСтрок = РазложитьСтрокуВМассивПодстрок2(СтрокаИзФайла, Разделитель);
		
		Попытка
			Если ПоЧасти Тогда
				Если ПоНаименованию=1 Тогда 
					Найдено = Найти(ВРЕГ(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Наименование)-1]),артПоиск)>0;
				Иначе 
					Найдено = Найти(ВРЕГ(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Артикул)-1]), артПоиск) > 0;
				КонецЕсли;
			Иначе
				Если ПоНаименованию=1 Тогда 
					Найдено = Найти(" "+ВРЕГ(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Наименование)-1])+" ",артПоиск)>0;
				Иначе 
					Найдено = Найти(" "+ВРЕГ(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Артикул)-1])+" ", артПоиск) > 0;
				КонецЕсли;
			КонецЕсли;
			Если Найдено Тогда
				Если ПредставитьВВидеЧисла(СтрТаб.Наименование) <> 0 Тогда
					ПрайсНаименование = СтрЗаменить(СокрЛП(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Наименование)-1]), Символы.НПП, "");
				Иначе
					ПрайсНаименование = "";
				КонецЕсли;
				Если ПредставитьВВидеЧисла(СтрТаб.Производитель) <> 0 Тогда
					ПрайсПроизводитель = СтрЗаменить(СокрЛП(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Производитель)-1]), Символы.НПП, "");
				Иначе
					ПрайсПроизводитель = "Отсутствует";
				КонецЕсли;
				Если ПредставитьВВидеЧисла(СтрТаб.Артикул) <> 0 Тогда
					ПрайсАртикул = СтрЗаменить(СокрЛП(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Артикул)-1]), Символы.НПП, "");
				Иначе
					ПрайсАртикул = "";
				КонецЕсли;
				Если ПредставитьВВидеЧисла(СтрТаб.Цена) <> 0 Тогда
					ПрайсЦена = СтрЗаменить(СокрЛП(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Цена)-1]), Символы.НПП, "");
				Иначе
					ПрайсЦена = "";
				КонецЕсли;
				Если ПредставитьВВидеЧисла(СтрТаб.Остаток) <> 0 Тогда
					ПрайсОстаток = ПодготовитьНомер(СокрЛП(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Остаток)-1]));
				Иначе
					ПрайсОстаток = "";
				КонецЕсли;
				Если ПредставитьВВидеЧисла(СтрТаб.Время) <> 0 Тогда
					ПрайсВремя = СтрЗаменить(СокрЛП(МассивСтрок[ПредставитьВВидеЧисла(СтрТаб.Время)-1]), Символы.НПП, "");
				Иначе
					ПрайсВремя = "";
				КонецЕсли;
						
				ТЗРез.Добавить(Новый Структура("Полное_описание_русский, Поставщик, Артикул, ЦенаПрайс, Остаток, Срок, ПоставщикПрайс",
				ПрайсНаименование,ПрайсПроизводитель,ПрайсАртикул,ПрайсЦена,ПрайсОстаток,ПрайсВремя,СтрТаб.Поставщик));					
			КонецЕсли;	
		Исключение
		КонецПопытки;
		
		// Отобразить информацию о ходе выполнения обработки
		Состояние("Обработка строк файла : строка " + Строка + " из " + КоличествоСтрок, Цел((Строка/КоличествоСтрок)*100),,);
	КонецЦикла;
	Состояние();
	//Возврат ТЗРез;
КонецПроцедуры

&НаКлиенте
Функция РазложитьСтрокуВМассивПодстрок2(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено, СокращатьНепечатаемыеСимволы = Ложь) Экспорт
	
	Рез = Новый Массив;
	
	// Для обеспечения обратной совместимости.
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда 
			Если Разделитель = " " Тогда
				Рез.Добавить("");
			КонецЕсли;
			Возврат Рез;
		КонецЕсли;
	КонецЕсли;
	
	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Если СокращатьНепечатаемыеСимволы Тогда
				Рез.Добавить(СокрЛП(Подстрока));
			Иначе
				Рез.Добавить(Подстрока);
			КонецЕсли;
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;
	
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Если СокращатьНепечатаемыеСимволы Тогда
			Рез.Добавить(СокрЛП(Строка));
		Иначе
			Рез.Добавить(Строка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции 

&НаКлиенте
Функция ПредставитьВВидеЧисла(Значение)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		//ЗначениеЧисло = Символ(64+Значение);
		ЗначениеЧисло = Значение;
	Иначе
		Поз = Найти(Значение,":");
		Если Поз = 0 Тогда
			//ЗначениеЧисло = Символ(64+Число(Значение));
			ЗначениеЧисло = Число(Значение);
		Иначе
			//ЗначениеЧисло = Символ(64+Число(Лев(Значение,Поз-1)));
			ЗначениеЧисло = Число(Лев(Значение,Поз-1));
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеЧисло;
КонецФункции

&НаСервере
Процедура ПоискПрайсНаСервере(ТЗРез, АртОриг)
	
	КЧ = Новый КвалификаторыЧисла(10,2);
	КС = Новый КвалификаторыСтроки(500);
	ТипЧ = Новый ОписаниеТипов("Число", КЧ);
	ТипС = Новый ОписаниеТипов("Строка", КС);
	ТипЧС = Новый ОписаниеТипов(ТипЧ,"Строка");
	Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено Тогда
		ТипСпр = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	Иначе
		ТипСпр = Неопределено;
	КонецЕсли;
	
	//Результирующая таблица
	ТЗПрайс = Новый ТаблицаЗначений();	
	ТЗПрайс.Колонки.Добавить("Полное_название_группы", ТипС);
	ТЗПрайс.Колонки.Добавить("Место_установки", ТипС);
	ТЗПрайс.Колонки.Добавить("Входит_в", ТипС);
	ТЗПрайс.Колонки.Добавить("поставщик", ТипС);
	ТЗПрайс.Колонки.Добавить("Артикул", ТипС);
	ТЗПрайс.Колонки.Добавить("ПоставщикЗапчасти", ТипЧ);
	ТЗПрайс.Колонки.Добавить("ART_ID", ТипЧ);
	ТЗПрайс.Колонки.Добавить("МОДЕЛЬ", ТипС);
	ТЗПрайс.Колонки.Добавить("Полное_описание_русский", ТипС);
	ТЗПрайс.Колонки.Добавить("ТипНомера", ТипС);
	ТЗПрайс.Колонки.Добавить("тип", ТипС);
	ТЗПрайс.Колонки.Добавить("номер", ТипС);
	ТЗПрайс.Колонки.Добавить("ПоставщикПрайс", ТипСпр);
	ТЗПрайс.Колонки.Добавить("Остаток", ТипС);
	ТЗПрайс.Колонки.Добавить("ЦенаПрайс", ТипЧ);
	ТЗПрайс.Колонки.Добавить("Срок", ТипЧС);
	ТЗПрайс.Колонки.Добавить("НашАрт", ТипЧ);
	ТЗПрайс.Колонки.Добавить("Источник",ТипЧ);
	ТЗПрайс.Колонки.Добавить("Номенклатура");
	Для Каждого Стр Из ТЗРез Цикл
		Нов=ТЗПрайс.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Стр);
		Если ТипЗнч(Нов.Срок)=Тип("Строка") и Не ПустаяСтрока(Нов.Срок) Тогда
			Попытка
				Нов.Срок=Число(Нов.Срок);
			Исключение
			Конецпопытки;
		КонецЕсли;
	КонецЦикла;
	Обработка=РеквизитФормыВЗначение("Объект");
	ТЗПрайс.Сортировать("поставщик");
	ТекПроизводитель="";
	ТекИсточник=0;
	
	Если Объект.ЕстьНоменклатура Тогда
		ТекНоменклатура=Справочники.Номенклатура.ПустаяСсылка();
		Если Объект.ПоискПоОчищенному И Объект.ОчищеннаяТаблица.Количество() = 0 Тогда 		
			Таб = Обработка.ПолучитьТаблицуНоменклатуры();
			Для Каждого Эл Из Таб Цикл
				Стр = Объект.ОчищеннаяТаблица.Добавить();
				Стр.Артикул = ПодготовитьНомер(Эл.Артикул);
				Стр.Производитель= ПодготовитьНомер(Эл.Производитель);
			    Стр.Номенклатура = Эл.Ссылка;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Для каждого Стр Из ТЗПрайс Цикл
		Если Объект.ЕстьНоменклатура Тогда
			Если Стр.поставщик<>ТекПроизводитель Тогда
				ТекПроизводитель=Стр.поставщик;
				Рез=Обработка.ПолучитьНоменклатуруТовара(Новый Структура("Артикул,Производитель",АртОриг,ТекПроизводитель),Ложь);
				Если Рез=Неопределено Тогда
					ТекИсточник=0;
					ТекНоменклатура=Справочники.Номенклатура.ПустаяСсылка();
				Иначе
					ТекИсточник=1;
					ТекНоменклатура=Рез;
				КонецЕсли;
			КонецЕсли;
			Стр.Номенклатура=ТекНоменклатура;
			Стр.Источник=ТекИсточник;
		//Иначе
		//	Стр.Источник=ТекИсточник;
		КонецЕсли;
	КонецЦикла;
	РезультатПоискаПрайс.Загрузить(ТЗПрайс);
	КолСтр=Обработка.ВыводРезультатаПоискаПрайс(ТЗПрайс,РезультатПрайс);
	Элементы.СтраницаПоискПоПрайсу.Заголовок="по Прайс-листам ("+Строка(КолСтр)+")";
КонецПроцедуры

&НаСервере
Функция ПолучитьНоменклатуруТовараНаСервере(Запись,Создать=Истина);
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьНоменклатуруТовара(Запись,Создать);
КонецФункции

&НаСервере
Процедура ЗаписатьгруппуНоменклатуры(Группа,Номенклатура)
	Об = Номенклатура.ПолучитьОбъект();
	Об.Родитель = Группа;
	Об.Записать();
КонецПроцедуры
	
&НаКлиенте
Процедура ВходВгруппуПрайс(Результат,Отбор) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗаписатьгруппуНоменклатуры(Результат,Отбор.Номенклатура);
	КонецЕсли;
	Номенклатура = Отбор.Номенклатура;
	Расшифровка = Отбор.Расшифровка;
	ПроверкаОтбор = Новый Структура("Номенклатура, Поставщик, Склад", Номенклатура, Расшифровка.Поставщик, Объект.ФильтрСкладПрайс);
	ПроверкаСуществования = Объект.ЗаявкаПоставщику.НайтиСтроки(ПроверкаОтбор);
	Остаток=Число(Расшифровка.Остаток)-?(ПроверкаСуществования.Количество()=0,0,ПроверкаСуществования[0].Количество);
	Если Остаток<=0 И Объект.КонтрольОстатков Тогда
		ТекстОшибки="Для оформления заказа с нулевыми остатками требуется в настройках убрать признак контроля остатков";
		Попытка
			ПоказатьПредупреждение(,ТекстОшибки);
		Исключение
			Сообщить(ТекстОшибки);
		Конецпопытки;
		Возврат;
	КонецЕсли;
	Если Объект.ЗапрашиватьКоличество ИЛИ Объект.ЗапрашиватьЦену ИЛИ Объект.ЗапрашиватьСкидку Тогда
		ПередачаПараметров = Новый Структура(
		"Номенклатура,Производитель,Склад,Остаток,ЦенаПоУмолчанию,КонтрольОстатков,ЗапрашиватьКолво,ЗапрашиватьЦену,ЗапрашиватьСкидку",
		Номенклатура,Расшифровка.Поставщик,Объект.ФильтрСкладПрайс,Остаток,Расшифровка.Цена,Объект.КонтрольОстатков,
		Объект.ЗапрашиватьКоличество, Объект.ЗапрашиватьЦену, Объект.ЗапрашиватьСкидку);
		Оповещение=Новый ОписаниеОповещения("ОбработкаРасшифровкиПрайсНаСервере",ЭтаФорма,Расшифровка);
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПередачаПараметров,ЭтаФорма,Истина,,,Оповещение)
	Иначе
		Данные=Новый Структура("Номенклатура,Производитель,Склад,Количество,Цена,Скидка",
		Номенклатура,Расшифровка.Поставщик,Объект.ФильтрСкладПрайс,1,Расшифровка.Цена,0);
		ОбработкаРасшифровкиПрайсНаСервере(Данные,Расшифровка)
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаРасшифровкиПрайсНаСервере(Данные, Расшифровка) Экспорт
	//Отказ при выборе количества
	Если Данные=Неопределено Тогда Возврат; КонецЕсли;
	
	Данные.Вставить("Поставщик",Расшифровка.Поставщик);
	Данные.Вставить("ЦенаПоставки",Расшифровка.ЦенаПоставщика);
	Данные.Вставить("СрокДоставки",Расшифровка.Срок);
	Данные.Вставить("СрокДоставкиГарантированный",Расшифровка.Срок);
	Данные.Вставить("Производитель",Расшифровка.Производитель);
	Данные.Вставить("Артикул",Расшифровка.Артикул);
	Данные.Вставить("Номенклатура",Расшифровка.Номенклатура);
	Данные.Вставить("Наименование",Расшифровка.Название);
	ДобавитьВЗаявкуНаСервере(Данные,Неопределено);
КонецПроцедуры

