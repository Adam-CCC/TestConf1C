Функция КодНовойСтрокиПользователя(Таблица,Пользователь)
	Строки=Таблица.НайтиСтроки(Новый Структура("Пользователь",Пользователь));
	Колво=Строки.Количество();
	Если Колво=0 Тогда Возврат 1;КонецЕсли;
	
	Массив=Новый СписокЗначений;
	Для Каждого Стр Из Строки Цикл
		Массив.Добавить(Стр.КодСтроки);
	КонецЦикла;
	Массив.СортироватьПоЗначению();
	МаксКод=Массив[Колво-1].Значение;
	Если МаксКод<=2*Колво Тогда
		Возврат МаксКод+1;
	Иначе
		Номер=1;
		Для Каждого Код Из Массив Цикл
			Если Код.Значение>Номер Тогда Прервать;КонецЕсли;
			Номер=Номер+1;
		КонецЦикла;
		Возврат Номер;
	КонецЕсли;			
КонецФункции

