			Стр.УточнениеПометка = Ложь;
			
			НоваяСтрока = Таб.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
			НоваяСтрока.Производитель = Стр.УточнениеПроизводитель;
		КонецЕсли;		
	КонецЦикла;	
		
    Обработка = РеквизитФормыВЗначение("Объект");	
	КолЕмекс = Обработка.ОбработкаТаблицыВыборочногоПоиска(Таб, Объект.ЕмексИскатьСЗаменамиИАналогами);
	ЗначениеВДанныеФормы(Обработка.РезультатПоискаОнлайн,Объект.РезультатПоискаОнлайн);
		
	//Объект.РезультатПоискаОнлайн.Очистить(); // РезультатПоискаЕмекс.Очистить()	   
	//Объект.РезультатПоискаОнлайн.Загрузить(ТЗЕмекс); // РезультатПоискаЕмекс.Загрузить(ТЗЕмекс) 
    //КолЕмекс = Обработка.ВыводРезультатаПоискаЕмекс(ТЗЕмекс, Объект.РезультатПоискаОнлайн, Ложь, Объект.МетодыСортировки); 						
	
	ОнлайнПроценкаЗаполнитьФильтры();
	
	//Если Объект.УточнениеПоиска.Количество() <> 0 Тогда
	//	Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаУточнениеПоиска;
	//КонецЕсли;		
	Элементы.ПоискЕмекс.Заголовок = "по Поставщикам(" + Объект.РезультатПоискаОнлайн.Количество() + ")";
	Элементы.ГруппаУточнениеПоиска.Заголовок = "Уточнение(" + Объект.УточнениеПоиска.Количество() + ")";			
КонецПроцедуры

&НаСервере
Процедура ОнлайнПроценкаЗаполнитьФильтры()
	//Заполним список выбора ФильтрМарка
	Объект.ФильтрМаркаЕмекс="";
	Список=Элементы.ФильтрМаркаЕмекс.СписокВыбора;
	Список.Очистить();
	Если Объект.ОтображатьКолонкуБренд Тогда
		ТабПро=Объект.РезультатПоискаОнлайн.Выгрузить(,"Бренд");
		ТабПро.Свернуть("Бренд");
		ТабПро.Сортировать("Бренд");
		Для Каждого Стр Из ТабПро Цикл
			Список.Добавить(Стр.Бренд,Стр.Бренд);
		КонецЦикла;
	Иначе
		ТабПро=Объект.РезультатПоискаОнлайн.Выгрузить(,"Бренд,Производитель");
		ТабПро.Свернуть("Бренд,Производитель");
		ТабПро.Сортировать("Производитель");
		Для Каждого Стр Из ТабПро Цикл
			Список.Добавить(Стр.Бренд,Стр.Производитель);
		КонецЦикла;
	КонецЕсли;
	//Заполним список выбора ФильтрПоставщик
	ТабПост=Объект.РезультатПоискаОнлайн.Выгрузить(,"Сайт");
	ТабПост.Свернуть("Сайт");
	ТабПост.Сортировать("Сайт");
	Если ТабПост.Количество() >0 Тогда
		НулеваяСтрока = ТабПост.Получить(0);
		Если НулеваяСтрока.Сайт = "" Тогда
			ТабПост.Удалить(НулеваяСтрока);
		КонецЕсли;
	КонецЕсли;
	СписокВыбора=Элементы.ФильтрПоставщикЕмекс.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого Стр Из ТабПост Цикл
		СписокВыбора.Добавить(Стр.Сайт,Стр.Сайт);
	КонецЦикла;
	//Элементы.ФильтрПоставщикЕмекс.СписокВыбора.ЗагрузитьЗначения(ТабПост.ВыгрузитьКолонку("Сайт"));			
КонецПроцедуры

