Конецпроцедуры

&НаКлиенте
Процедура НаСайтПлюс(Команда)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если ТекДан=Неопределено или Команда=Неопределено Тогда Возврат; КонецЕсли;
	
	Отбор=Новый Структура("Выбран",Истина);
    Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
	ВыбранКолво=Строки.Количество();
	Если ВыбранКолво=0 Тогда
		ПоказатьПредупреждение(,"Нет ни одной отмеченной заявки для переноса в корзину поставщика");
		Возврат;
	Иначе
		// Контроль на кратность
		Для Каждого Запись Из Строки Цикл
			Если ТипЗнч(Запись.Кратность) = Тип("Число") И Запись.Кратность<>0 И Запись.Кратность <> 1 Тогда
				Если Запись.Количество/Запись.Кратность <> Цел(Запись.Количество/Запись.Кратность) Тогда
					Сообщить("В строке "+Запись.НомерСтроки+" возникли ошибки при отправке в корзину: Количество товара не соответсвует кратности. Для текущей позиции кратность равна "+Строка(Запись.Кратность));
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Ошибки="";
	Если Найти(Команда.Имя,"ЗаказПокупателя")>0 Тогда
		Если ЗначениеЗаполнено(ТекДан.ЗаказПокупателя) Тогда
			Ошибки="Для заявки уже определен "+Строка(ТекДан.ЗаказПокупателя)+Символы.ПС;
		КонецЕсли;
		Объект.ЗаказПокупателя=Истина;
		Объект.РеализацияТоваров=Ложь;
		Объект.СчетФактура=Ложь;
		Объект.ЗаказНаряд=Ложь;
		Объект.КонтрагентДляЗаявки=ТекДан.Контрагент;
		Объект.Соглашение=?(ТекДан.Соглашение<>Неопределено,ТекДан.Соглашение,
		?(Элементы.ЗаказСоглашение.Видимость=Истина,Элементы.ЗаказСоглашение.ОграничениеТипа.ПривестиЗначение(""),Неопределено));
		Объект.ДоговорДляЗаявки=?(ТекДан.Договор<>Неопределено,ТекДан.Договор,
		?(Элементы.ЗаказДоговор.Видимость=Истина,Элементы.ЗаказДоговор.ОграничениеТипа.ПривестиЗначение(""),Неопределено));
		Объект.СкладДляЗаявки=?(ЗначениеЗаполнено(ТекДан.Склад),ТекДан.Склад,Объект.Склад);
	
		Ошибки=КонтрольДанныхДляДокументовНаСервере()+Ошибки;
		Если Ошибки<>"" Тогда
			Если Лев(Ошибки,1)="!" Тогда
				ПоказатьПредупреждение(,Сред(Ошибки,2));
				Возврат;
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	
	Данные=Новый Структура("КомандаИмя,Отбор,Строки",Команда.Имя,Отбор,Строки);
	Если Ошибки<>"" Тогда
		ОО=Новый ОписаниеОповещения("НаСайтПлюсОтвет",ЭтаФорма,Данные);
		ПоказатьВопрос(ОО,Ошибки+"Продолжить?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	Иначе
		НаСайтПлюсОтвет(КодВозвратаДиалога.Да,Данные);
	КонецЕсли;
		
		
КонецПроцедуры

&НаКлиенте
Процедура НаСайтПлюсОтвет(Ответ,Данные) Экспорт
	Если Ответ<>КодВозвратаДиалога.Да Тогда Возврат;КонецЕсли;
	// Оформление заказов покупателя
	Если Найти(Данные.КомандаИмя,"ЗаказПокупателя")>0 Тогда
		ОформлениеЗаявки(КодВозвратаДиалога.ОК,	Данные.Отбор);
	КонецЕсли;
	
	// Снимаем отметки выбора, если будем формировать Заказы поставщику
	Если Найти(Данные.КомандаИмя,"ЗаказПоставщику")>0 Тогда
		Строки=Объект.ЗаявкаПоставщику.НайтиСтроки(Новый Структура("Выбран",Истина));
		Для Каждого Стр из Строки Цикл
			Стр.Выбран=Ложь;
		КонецЦикла;
		Запросы=ВКорзинуОнлайнНаСервере(Данные.Отбор,Истина);	
	Иначе
		Запросы=ВКорзинуОнлайнНаСервере(Данные.Отбор);	
	КонецЕсли;
 	Для Каждого Запрос Из Запросы Цикл
		СендерОтправить(Запрос);
	КонецЦикла;                          //вс)
	Элементы.Группа10.Заголовок="Заказанное ("+Строка(Объект.ЗаявкаПоставщику.Количество())+")";
	СохранитьДанныеПоЗаказамПоставщикам(ПользовательКорзины);
	СохранитьДанныеПоКорзине(ПользовательКорзины);

	Если Найти(Данные.КомандаИмя,"ЗаказПоставщику")>0 Тогда
		Отбор=Объект.ЗаявкаПоставщику.НайтиСтроки(Новый Структура("Выбран",Истина));
		ОформитьЗаказыОтвет(КодВозвратаДиалога.ОК, Отбор);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФормыПАВставить(Имя,Форма) Экспорт
	ФормыПА.Вставить(Имя,Форма);
КонецПроцедуры

&НаКлиенте
Процедура ФормыПАУдалить(Имя) Экспорт
	ФормыПА.Удалить(Имя);
КонецПроцедуры

&НаКлиенте
Функция ФормыПАОткрыта(Имя) Экспорт
	Возврат ФормыПА.Свойство(Имя) и ФормыПА[Имя].Открыта();
КонецФункции

&НаКлиенте
Функция ФормыПАПолучить(Имя) Экспорт
	Возврат ?(ФормыПА.Свойство(Имя) и ФормыПА[Имя].Открыта(),ФормыПА[Имя],Неопределено);
КонецФункции

