		Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""),Объект.IPКлиента,Истина,
		Запись.Сайт,Запись.Склад,МаксЧисло(Запись.СрокДоставкиГарантированный, Запись.СрокДоставки, 0),
		Строка(Объект.СкладДляЗаявки),Окр(Данные.Количество,0),Окр(Запись.ЦенаПоставки,0),Окр(Данные.Цена,0),Окр(Запись.Наличие1С,0),
		Строка(Объект.ОрганизацияДляЗаявки), Объект.ПользовательИмя));
	КонецЕсли;
	Запись.Удалить("Наличие1С");
