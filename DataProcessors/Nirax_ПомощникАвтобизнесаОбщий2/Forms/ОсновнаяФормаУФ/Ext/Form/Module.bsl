&НаКлиенте
Процедура СендерЗакрытьОповещение(Результат,Параметры,Перезапуск) Экспорт
	Если ПодключаемоеОборудование<>Неопределено И ПодключаемоеОборудование.Свойство("ПараметрыПодключенияПО") Тогда
		Индекс=0;
		Для Каждого Подключение Из ПодключаемоеОборудование.ПараметрыПодключенияПО Цикл
			Если Подключение.Наименование="Сендер" Тогда
				ПодключаемоеОборудование.ПараметрыПодключенияПО.Удалить(Индекс);
				Прервать;
			КонецЕсли;
			Индекс=Индекс+1;
		КонецЦикла;
	КонецЕсли;
	Если Перезапуск=Истина Тогда
		ПодключитьОбработчикОжидания("СендерНачатьВызов", СендерСв.ЖдатьОтвет, Истина);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция UnJSONнаСервере(Текст,ЭтоСтруктура=Истина,ЕстьДатыСсылки=Ложь)
	Перем Результат;
	Если ТипЗнч(Текст)<>Тип("Строка") или ПустаяСтрока(Текст) Тогда Возврат Неопределено;КонецЕсли;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Если ЕстьДатыСсылки Тогда
			Результат = ПрочитатьJSON(ЧтениеJSON,Не ЭтоСтруктура,,,"UnJsonRestServ",ЭтаФорма);
		Иначе
			Результат = ПрочитатьJSON(ЧтениеJSON,Не ЭтоСтруктура);
		КонецЕсли;
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Сообщить(ОписаниеОшибки()+Символы.ПС+"Будет произведено тестирование и попытка восстановленияь значение из JSON");
	КонецПопытки;
	
КонецФункции

&НаСервере
// Функция восстановления дат из JSON
Функция UnJsonRestServ(Свойство, Значение, Доп) Экспорт
	#Если ВебКлиент Тогда 
		Возврат Значение;
	#КонецЕсли
	Если ТипЗнч(Значение)<>Тип("Строка") Тогда Возврат Значение;КонецЕсли; 
	Длина=СтрДлина(Значение);
	Попытка
		Если Лев(Значение,2)<> "@^" Тогда
			Если Длина<>19 И Длина<>20 Тогда Возврат Значение;КонецЕсли;
			Если Сред(Значение,5,1)<>"-" ИЛИ Сред(Значение,8,1)<>"-" ИЛИ Сред(Значение,14,1)<>":" ИЛИ Сред(Значение,17,1)<>":" Тогда
				Возврат Значение;
			КонецЕсли;
			Если Сред(Значение,11,1)<>"T" Тогда
				Возврат ПрочитатьДатуJSON(Лев(Значение,10)+"T"+Сред(Значение,12), ФорматДатыJSON.ISO);
			Иначе
				Возврат ПрочитатьДатуJSON(Значение, ФорматДатыJSON.ISO);
			КонецЕсли;
		ИначеЕсли Сред(Значение,3,1)="^" Тогда Возврат "@^"+Сред(Значение,4);
		ИначеЕсли Длина=16 Тогда
			Возврат Дата(Сред(Значение,3));
		Иначе 
			Возврат Значение;
		КонецЕсли;
	Исключение
		Возврат Значение;
	КонецПопытки;
КонецФункции

