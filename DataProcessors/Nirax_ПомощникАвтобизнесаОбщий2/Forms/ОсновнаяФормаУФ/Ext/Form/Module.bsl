&НаСервере
Процедура ВыполнитьПослеЗакрытияФормыВводаПартнераНаСервере(Результат)
	Если ЗначениеЗаполнено(Результат) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Контрагенты.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.Контрагенты КАК Контрагенты
		               |ГДЕ
		               |	Контрагенты.Партнер = &Партнер";
		Запрос.УстановитьПараметр("Партнер", Результат);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Объект.КонтрагентДляЗаявки = Выборка.Ссылка;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказКонтрагентСоздание(Элемент, СтандартнаяОбработка)
	Если Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
		ОткрыватьСправочникПартнеров = ИспользоватьПартнеровКакКонтрагентов();
		Если ОткрыватьСправочникПартнеров Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура;
			Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияФормыВводаПартнера", ЭтаФорма);
			ОткрытьФорму("Справочник.Партнеры.Форма.ПомощникНового", ПараметрыФормы,ЭтаФорма,,,,Оповещение);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСуммы(ТекущиеДанные) Экспорт
	Попытка
		Если Не ЗначениеЗаполнено(ТекущиеДанные.СтавкаНДС) Тогда
			Ставка=20;
		Иначе
			Ставка=ТекущиеДанные.СтавкаНДС.Ставка;
		КонецЕсли;
	Исключение
		СтавкаНДС=Строка(ТекущиеДанные.СтавкаНДС);
		Если Найти(СтавкаНДС,"20")>0 Тогда
			Ставка=20;
		ИначеЕсли Найти(СтавкаНДС,"18")>0 Тогда
			Ставка=18;
		ИначеЕсли Найти(СтавкаНДС,"10")>0 Тогда	
			Ставка=10;
		Иначе
			Ставка=0;
		КонецЕсли;			
	Конецпопытки;
	
	ТекущиеДанные.Сумма=ТекущиеДанные.Цена*ТекущиеДанные.Количество;
	//Если в текущих данных не определен процент скидки - Сумма со скидкой - не расчитывается
	Попытка
		СкидкаКоэф=?(ТекущиеДанные.Скидка=0,1,1-ТекущиеДанные.Скидка/100);
	    ТекущиеДанные.СуммаСоСкидкой=ТекущиеДанные.Сумма*?(ТекущиеДанные.Скидка=0,1,1-ТекущиеДанные.Скидка/100);
		ТекущиеДанные.СуммаНДС=ТекущиеДанные.СуммаСоСкидкой*(1-1/(1 + Ставка / 100));
		ТекущиеДанные.Всего=ТекущиеДанные.СуммаСоСкидкой;
	Исключение
		ТекущиеДанные.СуммаНДС=ТекущиеДанные.Сумма*(1-1/(1 + Ставка / 100));
		ТекущиеДанные.Всего=ТекущиеДанные.Сумма;
	Конецпопытки;	
	
КонецПроцедуры

&НаСервере
Функция НайтиЗаявку(КодЗП)
	Строка=Неопределено;
	Для Каждого Стр из Объект.ЗаказыКлиентов Цикл
		Если Стр.Заказ = Объект.ТекущийЗК Тогда Продолжить;КонецЕсли;
		Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнесаЗК",Строка(Стр.Заказ),,ПользовательКорзины);
		Если ТипЗнч(Данные)=Тип("ТаблицаЗначений") Тогда
			Строка=Данные.Найти(КодЗП,"КодЗП");
			Если Строка<>Неопределено Тогда 				
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Строка<>Неопределено Тогда 
		СменитьЗаявку(Стр.Заказ);
		Возврат Истина;
	Иначе
		Возврат Ложь;		
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ВДокумент(Команда)
	// Формируем массив наименований возможных документв
    Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина));
	Если Строки.Количество()=0 Тогда
		ПоказатьПредупреждение(,"Нет выбранных строк для переноса");
		Возврат;
	КонецЕсли;
	
	Документы=Новый Массив;
	Если Объект.Реквизит1С.Заказ<>Неопределено Тогда
		Документы.Добавить(Объект.Реквизит1С.Заказ);
	КонецЕсли;
	Документы.Добавить("ЗаказНаряд");
	Документы.Добавить("асЗаказНаряд");
	Документы.Добавить("асЗаявкаНаРемонт");
	Если Объект.Реквизит1С.Реализация<>Неопределено Тогда
		Документы.Добавить(Объект.Реквизит1С.Реализация);
	КонецЕсли;
	Если Объект.Реквизит1С.СчетФактураВыданный<>Неопределено Тогда
		Документы.Добавить(Объект.Реквизит1С.СчетФактураВыданный);
	КонецЕсли;
	
	// Формируем список форм
	ВсеОкна=ПолучитьОкна();
	Формы=Новый СписокЗначений;
	ИменаДокументов=Новый СписокЗначений;
	Инд=0;
	Для Каждого Окна из ВсеОкна Цикл
		ФормыОкна=Окна.Содержимое;
		Для Каждого Форма из ФормыОкна Цикл
			Если Лев(Форма.ИмяФормы,9)="Документ." И Прав(Форма.ИмяФормы,15)=".ФормаДокумента" и Форма.Открыта() Тогда
				ИмяДокумента=Сред(Форма.ИмяФормы,10,СтрДлина(Форма.ИмяФормы)-30);
				Если Документы.Найти(ИмяДокумента)<>Неопределено Тогда
					Формы.Добавить(Форма,,ИмяДокумента=Объект.Реквизит1С.Заказ);
					НаименованиеДокумента=Строка(Форма.Объект.Ссылка);
					Если ПустаяСтрока(НаименованиеДокумента) Тогда
						НаименованиеДокумента=СинонимДокумента(ИмяДокумента)+ " (создание)- без сохранения ссылки";
					КонецЕсли;
					ИменаДокументов.Добавить(Инд,Строка(НаименованиеДокумента));
					Инд=Инд+1;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Формы.Количество()>0 тогда
		ОО=Новый ОписаниеОповещения("ВДокументЗаполнить",ЭтаФорма,Формы);
		ПараметрыФормы=Новый Структура("СписокЗначений,Групповой,ТекущаяСтрока,Заголовок",
			ИменаДокументов,Ложь,0,"Выберите документ для загрузки товара");
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
			ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,ОО,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;		
КонецПроцедуры

&НаСервере
Функция СинонимДокумента(Имя)
	Попытка
		Возврат Метаданные.Документы[Имя].Синоним;
	Исключение
		Возврат Имя;
	Конецпопытки;
КонецФункции

&НаКлиенте
Процедура ВДокументЗаполнить(Документ,Формы) Экспорт
	Если Документ=Неопределено Тогда Возврат;КонецЕсли;
    Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина));
	Форма=Формы[Документ.Значение].Значение;
	ЭтоЗаказ=Формы[Документ.Значение].Пометка;
	ФормаОбъект=Форма.Объект;
	ДокументСсылка=ФормаОбъект.Ссылка;
	// Заполняем данные из текущей заявки
	текДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Объект.СкладДляЗаявки=ТекДан.Склад;
	Объект.ДоговорДляЗаявки=ТекДан.Договор;

	// Проверка на не созданную номенклатуру
	//СрокДоставки=0;
	Для Каждого Стр Из Строки Цикл
		//СрокДоставки=Макс(СрокДоставки,Стр.СрокДоставки,Стр.СрокДоставкиГарантированный); 
		Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			Стр.Номенклатура=СоздатьНоменклатуруВДокумент(Новый Структура("Артикул,НаименованиеДетали,Производитель", Стр.Артикул, Стр.Наименование, Стр.Производитель));
		КонецЕсли;
	КонецЦикла;
	
	ДатаОтгрузки=ТекущаяДата();
	
	имя=ПолучитьМетаданныеТовараНаСервере(ДокументСсылка);
	Если имя.Товары=Неопределено Тогда
		ПоказатьПредупреждение(,"Данный документ не поддерживается, так как не содержит товары");
		Возврат;
	КонецЕсли;
	НомСтр=ФормаОбъект[имя.Товары].Количество();
	СуммаДокумента=0;
	СуммаНДСДокумента=0;
	Для Каждого Стр Из Строки Цикл
		Нов=ФормаОбъект[имя.Товары].Добавить();
		НомСтр=НомСтр+1;
		Если имя.ИдентификаторСтроки Тогда Нов.ИдентификаторСтроки=Новый Уникальныйидентификатор; КонецЕсли;
		Если имя.КодСтроки<>Неопределено Тогда Нов[имя.КодСтроки]=НомСтр;КонецЕсли;
			
		// Заполняем номенклатуру цены, скидки
	    ЗаполнитьЗначенияСвойств(Нов,Стр,"Количество,Номенклатура,СтавкаНДС");
		
		Если имя.Всего Тогда Нов.Всего=Стр.Всего;КонецЕсли;
		Если имя.СуммаНДС Тогда Нов.СуммаНДС=Стр.СуммаНДС;КонецЕсли;
		СуммаДокумента=СуммаДокумента+Стр.Всего;
		СуммаНДСДокумента=СуммаНДСДокумента+Стр.СуммаНДС;
		
		Если имя.Упаковок<>Неопределено Тогда Нов[имя.Упаковок]=Стр.Количество;КонецЕсли;
		Если имя.Коэффициент Тогда Нов.Коэффициент=1;КонецЕсли;
		
		//Если Стр.Скидка<>0 и имя.Скидка<>Неопределено Тогда
		//	Нов[имя.Скидка]=Стр.Скидка;
		//КонецЕсли;
		Количество=?(Стр.Количество=0,1,Стр.Количество);
		Если Имя.НДСВЦене Тогда
			Нов.Сумма=Стр.Сумма-Стр.СуммаНДС;
			//Если Стр.Скидка=0 Тогда
				Нов.Цена=стр.Цена;
				Если имя.ЦенаБезСкидки тогда 
					Нов.ЦенаБезСкидки=Нов.Цена;
					Нов.ВсегоБезСкидки=Стр.Всего;
				КонецЕсли;
			//Иначе
			//	Если имя.ЦенаБезСкидки тогда 
			//		Нов.ЦенаБезСкидки=Стр.Цена;
			//		Нов.ВсегоБезСкидки=Стр.Сумма;
			//		Нов.Цена=Стр.Всего/Количество;
			//	Иначе
			//		Нов.Цена=Стр.Цена;
			//	КонецЕсли;
			//	Если имя.Скидка<>Неопределено Тогда Нов[имя.Скидка]=Стр.Скидка;КонецЕсли;
			//	Если имя.СуммаСкидки<>Неопределено Тогда Нов[имя.СуммаСкидки]=Стр.Сумма-Стр.СуммаСоСкидкой;КонецЕсли;
			//		
			//КонецЕсли;
			Если имя.Сумма Тогда Нов.Сумма=Стр.Всего; КонецЕсли;
		Иначе   // НДС отдельно
			СоСкидкой=Стр.Всего-Стр.СуммаНДС;
			Скидка=0; //СоСкидкой*Стр.Скидка/(100-Стр.Скидка);
			Сумма=СоСкидкой; //+Скидка;
			Цена=Окр(Сумма/Количество,2);
			
			Если имя.ЦенаБезСкидки тогда 
				Нов.ЦенаБезСкидки=Цена;
				Нов.ВсегоБезСкидки=Сумма;
				Нов.Цена=Окр(СоСкидкой/Количество,2);
			Иначе
				Нов.Цена=Цена;
			КонецЕсли;
			//Если Стр.Скидка>0 Тогда
			//	Если имя.Скидка<>Неопределено Тогда Нов[имя.Скидка]=Стр.Скидка;КонецЕсли;
			//	Если имя.СуммаСкидки<>Неопределено Тогда Нов[имя.СуммаСкидки]=Скидка;КонецЕсли;
			//КонецЕсли;
			Если имя.Сумма Тогда Нов.Сумма=Сумма; КонецЕсли;
		КонецЕсли;		
		Если имя.СуммаВсего Тогда Нов.СуммаВсего=Стр.Всего; КонецЕсли;
		Если имя.СуммаСНДС Тогда Нов.СуммаСНДС=Стр.Всего; КонецЕсли;
		
		Если имя.ДатаОтгрузки<>Неопределено Тогда 
			Нов[имя.ДатаОтгрузки]=ДатаОтгрузки+?(ТипЗнч(Стр.СрокДоставки)=Тип("Число"),
			?(ТипЗнч(Стр.СрокДоставкиГарантированный)=Тип("Число"),Макс(Стр.СрокДоставки,Стр.СрокДоставкиГарантированный)*86400,Стр.СрокДоставки),
			?(ТипЗнч(Стр.СрокДоставкиГарантированный)=Тип("Число"),Стр.СрокДоставкиГарантированный,0))*86400;
		КонецЕсли;
		
		Если имя.Заказ<>Неопределено и значениеЗаполнено(Стр.ЗаказПокупателя) Тогда
			Нов[имя.Заказ]=Стр.ЗаказПокупателя;
		КонецЕсли;
		
		Если имя.Поставщик и ЗначениеЗаполнено(Стр.Поставщик) Тогда 
			Нов.Поставщик = Стр.Поставщик;
		КонецЕсли;
		
		ЕСли имя.РеквизитыНоменклатуры.Количество()>0 Тогда
			ЗаполнитьЗначенияСвойствНаСервере(имя.РеквизитыНоменклатуры, Стр.Номенклатура);
			Для Каждого рекв из имя.РеквизитыТоваров Цикл
				Нов[рекв.Значение]=имя.РеквизитыНоменклатуры[рекв.Ключ]
			КонецЦикла;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Нов,имя.Значения);
		
		Если ЭтоЗаказ Тогда 
			Стр.ЗаказПокупателя=ДокументСсылка; 
			Если Объект.ЗаказВКомментарий Тогда
				Стр.Комментарий=Строка(ДокументСсылка)+"; "+Стр.Комментарий;
			КонецЕсли;
		ИначеЕсли Лев(ДокументСсылка,11)="Заказ-наряд" Тогда 
			Стр.Комментарий=Строка(ДокументСсылка)+"; "+Стр.Комментарий;
		КонецЕсли;
				
	КонецЦикла;
	
	Если имя.СуммаДокумента Тогда 
		ФормаОбъект.СуммаДокумента=ФормаОбъект.СуммаДокумента+СуммаДокумента;
	КонецЕсли;
	Если имя.СуммаНоменклатурыДокумента Тогда 
		ФормаОбъект.СуммаНоменклатурыДокумента=ФормаОбъект.СуммаНоменклатурыДокумента+СуммаДокумента;
	КонецЕсли;
	Если имя.СуммаНДСДокумента Тогда 
		ФормаОбъект.СуммаНДСДокумента=ФормаОбъект.СуммаНДСДокумента+СуммаНДСДокумента;
	КонецЕсли;
	
	// Реквизиты формы - структура ключ - имя реквизита, значение Истина - сумма документа, ложь - НДС документа
	РеквизитыСуммыДокумента=Новый Структура("ИтогВсего,СуммаБезСкидки,СуммаВсего,СуммаЗаказано,
	|СуммаЗаказаноСЗалоговойТарой,СуммаКредитаПослеОтгрузки");
	ЗаполнитьЗначенияСвойств(РеквизитыСуммыДокумента,Форма);
	Для Каждого Стр из РеквизитыСуммыДокумента Цикл
		Если Стр.Значение <> Неопределено Тогда 
			Форма[Стр.Ключ]=Форма[Стр.Ключ]+СуммаДокумента;
		КонецЕсли;	
	КонецЦикла;
	
	РеквизитыНДСДокумента=Новый Структура("ИтогСуммаНДС,СуммаНДС,СуммаНДСЗаказано");
	ЗаполнитьЗначенияСвойств(РеквизитыНДСДокумента,Форма);
	Для Каждого Стр из РеквизитыНДСДокумента Цикл
		Если Стр.Значение<>Неопределено Тогда 
			Форма[Стр.Ключ]=Форма[Стр.Ключ]+СуммаНДСДокумента;
		КонецЕсли;	
	КонецЦикла;
	
	Если имя.ЭтапыГрафикаОплаты Тогда
		Попытка
			Если ФормаОбъект.ЭтапыГрафикаОплаты.Количество()>0 Тогда
				Форма.СуммаКОплате=Форма.СуммаКОплате+СуммаДокумента;
				ФормаОбъект.ЭтапыГрафикаОплаты[0].СуммаПлатежа=ФормаОбъект.ЭтапыГрафикаОплаты[0].СуммаПлатежа+СуммаДокумента;
			КонецЕсли;
		Исключение
		Конецпопытки;		
	КонецЕсли;
	
	Форма.Активизировать();

Конецпроцедуры

&НаСервере
Функция ПолучитьМетаданныеТовараНаСервере(Ссылка)
	
	// Определяем структуры для возврата
	имя=Новый структура;
	значения=Новый Структура;
	
	// Определим имя табличной части
	МетаТаб=Ссылка.Метаданные().ТабличныеЧасти.Найти("Товары");
	Если МетаТаб=Неопределено Тогда
		МетаТаб=Ссылка.Метаданные().ТабличныеЧасти.Найти("Запасы");
		Если МетаТаб=Неопределено Тогда 
			имя.Вставить("Товары",Неопределено);
			Возврат имя;
		КонецЕсли;
		имя.Вставить("Товары","Запасы");
	иначе
		имя.Вставить("Товары","Товары");
	КонецЕсли;
	МетаТаб=МетаТаб.Реквизиты;
	
	// Определим договор документа
	МетаДок=Ссылка.Метаданные().Реквизиты;
	имяДоговор=РеквизитИзСписка(Метадок,"Договор,ДоговорКонтрагента,ДоговорВзаиморасчетов");
	Если имяДоговор=Неопределено Тогда
		Договор=Объект.ДоговорДляЗаявки;
		//имяДоговор=?(Договор=Неопределено,Неопределено,Договор.Метаданные().Имя);
	Иначе
		Договор=Ссылка[имяДоговор];
	КонецЕсли;
	
	// Определим НДСВЦене
	имяНДСВЦене=РеквизитИзСписка(МетаДок,"СуммаВключаетНДС,ЦенаВключаетНДС,НДСВключатьВСтоимость");
	имя.Вставить("НДСВЦене",?(имяНДСВЦене=Неопределено,Истина,Ссылка[имяНДСВЦене]));
	
	// Реквизиты
	имя.Вставить("Скидка",РеквизитИзСписка(МетаТаб,"ПроцентСкидки, ПроцентСкидкиНаценки, ПроцентСкидкиСтроки, ПроцентРучнойСкидки"));
	имя.Вставить("РучнаяСкидка",МетаТаб.Найти("РучнаяСкидка")<>Неопределено);
	имя.Вставить("СуммаСкидки",РеквизитИзСписка(МетаТаб,"СуммаСкидки,СуммаСкидкиСтроки,СуммаРучнойСкидки"));
	имя.Вставить("ЦенаБезСкидки",МетаТаб.Найти("ЦенаБезСкидки")<>Неопределено);
	имя.Вставить("Всего",МетаТаб.Найти("Всего")<>Неопределено);
	имя.Вставить("Сумма",МетаТаб.Найти("Сумма")<>Неопределено);
	имя.Вставить("СуммаВсего",МетаТаб.Найти("СуммаВсего")<>Неопределено);
	имя.Вставить("СуммаСНДС",МетаТаб.Найти("СуммаСНДС")<>Неопределено);
	имя.Вставить("СуммаНДС",МетаТаб.Найти("СуммаНДС")<>Неопределено);
	имя.Вставить("Упаковок",РеквизитИзСписка(МетаТаб,"КоличествоУпаковок,КоличествоБазовое"));
	имя.Вставить("Коэффициент",МетаТаб.Найти("Коэффициент")<>Неопределено);
	имя.Вставить("ИдентификаторСтроки",МетаТаб.Найти("ИдентификаторСтроки")<>Неопределено);
	имя.Вставить("КодСтроки",РеквизитИзСписка(МетаТаб,"КлючСтроки,КодСтроки,ор_КодСтроки,МаксимальныйКодСтроки"));
	имя.Вставить("ДатаОтгрузки",РеквизитИзСписка(МетаТаб,"ДатаОтгрузки,СрокПоставки"));
	
	имя.Вставить("СуммаДокумента",МетаДок.Найти("СуммаДокумента")<>Неопределено);
	имя.Вставить("СуммаНоменклатурыДокумента",МетаДок.Найти("СуммаНоменклатурыДокумента")<>Неопределено);
	имя.Вставить("СуммаНДСДокумента",МетаДок.Найти("СуммаНДСДокумента")<>Неопределено);
	//  ЗначениеСкидкиНаценки,СуммаСкидкиНаценки,СуммаСписания,СуммаСписанияБезНДС
	//  СуммаРасчетная, СогласованнаяСумма
	
	РеквизитыНоменклатуры=Новый Структура;
	РеквизитыТоваров=Новый Структура;
	
	ЕСли МетаТаб.Найти("ЕдиницаИзмерения")<>Неопределено Тогда
		рекв=РеквизитИзСписка(Метаданные.Справочники.Номенклатура.Реквизиты,
		"ЕдиницаХраненияОстатков,ОсновнаяЕдиницаИзмерения,ЕдиницаИзмерения");
		Если рекв<>Неопределено Тогда
			РеквизитыНоменклатуры.Вставить(рекв);
			РеквизитыТоваров.Вставить(рекв,"ЕдиницаИзмерения");
		КонецЕсли;	
	КонецЕсли;
	
	ЕСли МетаТаб.Найти("Производитель")<>Неопределено Тогда
		рекв=РеквизитИзСписка(Метаданные.Справочники.Номенклатура.Реквизиты,
		"ор_Производитель,асПроизводитель,Производитель,Поставщик,ор_Поставщик");
		Если рекв<>Неопределено Тогда
			РеквизитыНоменклатуры.Вставить(рекв);
			РеквизитыТоваров.Вставить(рекв,"Производитель");
		КонецЕсли;	
	КонецЕсли;
	
	Если Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
		рекв=РеквизитИзСписка(Метаданные.Справочники.Номенклатура.Реквизиты,"Артикул");
		Если рекв<>Неопределено Тогда
			РеквизитыНоменклатуры.Вставить(рекв);
			РеквизитыТоваров.Вставить(рекв,"Артикул");
		КонецЕсли;	
	КонецЕсли;
	
	имя.Вставить("Поставщик",МетаТаб.Найти("Поставщик")<>Неопределено);
	
	имя.Вставить("РеквизитыНоменклатуры",РеквизитыНоменклатуры);
	имя.Вставить("РеквизитыТоваров",РеквизитыТоваров);
	
	Если МетаТаб.Найти("ВариантОбеспечения")<>Неопределено Тогда
		Значения.Вставить("ВариантОбеспечения",Объект.ПоУмолчанию.ВариантОбеспечения.Значение); //Перечисления.ВариантыОбеспечения.Требуется);
	КонецЕсли;
	Если МетаТаб.Найти("ВидЦены")<>Неопределено Тогда
		Если ЗначениеЗаполнено(Договор) Тогда
			имяТипЦен=РеквизитИзСписка(Договор.Метаданные().Реквизиты,"ТипЦен,ВидЦен,КатегорияЦен,ТипЦенПродажи");
			Если имяТипЦен<>Неопределено Тогда
				ТипЦен=Договор[имяТипЦен];
			КонецЕсли;
		Иначе
			ТипЦен=НЕопределено;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(типЦен) Тогда
			ТипЦен=Объект.ТипЦен;
		КонецЕсли;
		значения.Вставить("ВидЦены",ТипЦен);
	КонецЕсли;
	имяСклад=РеквизитИзСписка(МетаТаб,"Склад,СкладКомпании,Размещение");
	ЕСли имяСклад<>Неопределено тогда
		имя2Склад=РеквизитИзСписка(МетаДок,"Склад,СкладКомпании,СкладГруппа");
		Если имя2Склад=Неопределено Тогда
			Склад=объект.СкладДляЗаявки;
		Иначе
			Склад=ссылка[имя2Склад];
		КонецЕсли;
		значения.Вставить(имяСклад,Склад);
	КонецЕсли;
	Если МетаТаб.Найти("ТипНоменклатурыЗапас")<>Неопределено Тогда
		значения.Вставить("ТипНоменклатурыЗапас",Истина);
	КонецЕсли;
	Если МетаТаб.Найти("Качество")<>Неопределено Тогда
		значения.Вставить("Качество",Справочники.Качество.Новый);
	КонецЕсли;
	Если МетаТаб.Найти("СпособСписанияОстаткаТоваров")<>Неопределено Тогда
		значения.Вставить("СпособСписанияОстаткаТоваров",Перечисления.СпособыСписанияОстаткаТоваров.СоСклада);
	КонецЕсли;
	имя.Вставить("Заказ",РеквизитИзСписка(МетаТаб,"Заказ,ЗаказКлиента,ЗаказПокупателя,ор_ЗаказПокупателя,ИзЗаказаПокупателя"));
	//Если имяЗаказ<>Неопределено Тогда
		//имя2Заказ=РеквизитИзСписка(МетаДок,"Заказ,ЗаказКлиента,ЗаказПокупателя,Сделка,ДокументОснование");
		//Если имя2Заказ<>Неопределено Тогда
		//	значения.Вставить(имяЗаказ,ссылка[имя2Заказ]);
		//КонецЕсли;
	//КонецЕсли;
	
	//Если Ссылка.Метаданные().ТабличныеЧасти.Найти("ЭтапыГрафикаОплаты")<>Неопределено Тогда
	//	имя.Вставить("ЭтапыГрафикаОплаты",Новый Структура("ВариантОплаты,ДатаПлатежа,ПроцентПлатежа",
	//	Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки,ТекущаяДата(),100));
	//КонецЕсли;
	//СуммаЗаказано,СуммаЗаказаноСЗалоговойТарой,СуммаКредитаПослеОтгрузки,СуммаНДСЗаказано
	Имя.Вставить("ЭтапыГрафикаОплаты",Ссылка.Метаданные().ТабличныеЧасти.Найти("ЭтапыГрафикаОплаты")<>Неопределено);
	
	имя.Вставить("Значения",значения);
	// расчет на основании значения: НДСВключатьВСтоимость,СуммаВключаетНДС, ЦенаВключаетНДС
	// ВариантОбеспечения, ВидЦены(ТипЦены),Всего,ДатаОтгрузки,ЕдиницаИзмерения(Номенклатура[ЕИ]),
	// ИдентификаторСтроки, КлючСтроки,КодСтроки,МаксимальныйКодСтроки,
	// Количество, КоличествоУпаковок,Коэффициент, Номенклатура, Поставщик,
	// Производитель,ПроцентРучнойСкидки,ПроцентСкидки, ПроцентСкидкиНаценки,ПроцентСкидкиСтроки ,
	// РучнаяСкидка,Размещение,Склад,СкладКомпании, СтавкаНДС, Сумма, СуммаВсего,СуммаВсего, СуммаСкидкиСтроки
	// СуммаРучнойСкидки, СуммаСкидки, СуммаСНДС,СуммаНДС, ТипНоменклатурыЗапас,
	// ЦенаБезСкидки, Цена, ВсегоБезСкидки,СрокПоставкиВСтроке, Комментарий,
	// Заказ,ЗаказКлиента, ЗаказПокупателя, ор_ЗаказПокупателя, ИзЗаказаПокупателя,
	// Качество,КоличествоБазовое,ор_КодСтроки,СпособСписанияОстаткаТоваров,  

	Возврат имя;
КонецФункции

