&НаСервереБезКонтекста
Функция ПроверитьДоступ(Свойство,Пользователь)
	УстановитьПривилегированныйРежим(Истина);
	Доступ = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Доступ",,Пользователь);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(Доступ=Неопределено,Истина,?(Доступ.Свойство(Свойство),Доступ[Свойство],Истина));
