#Область ОбработчикиКомандЗаказовПоставщику
//     ****** Страница Заказы Поставщику  *****
&НаКлиенте
Процедура ОформитьЗаказы(Команда)
	Отбор=Объект.ЗаявкаПоставщику.НайтиСтроки(Новый Структура("Выбран",Истина));//вс(
	Если Отбор.Количество() > 0 Тогда
		Кол=0;
		Для каждого Запись Из Отбор Цикл
			Если ЗначениеЗаполнено(Запись.ЗаказПоставщику) Тогда Кол=Кол+1;КонецЕсли;
		КонецЦикла;
		Если Кол>0 Тогда
			ОО=Новый ОписаниеОповещения("ОформитьЗаказыОтвет",ЭтаФорма,Отбор);
			ПоказатьВопрос(ОО,"Для "+Строка(Кол)+" номенклатурных единиц уже оформлены заказы поставщику. Продолжить?",
			РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		Иначе
			ОформитьЗаказыОтвет(КодВозвратаДиалога.Да, Отбор);
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"Нет данных для формирования заказов!");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОформитьЗаказыОтвет(Ответ, Отбор) Экспорт
	Если Ответ<>КодВозвратаДиалога.Да и Ответ<>КодВозвратаДиалога.ОК Тогда Возврат;КонецЕсли;
	
	ОформленныеЗаказы=ОформитьЗаказыНаСервере();
	Если ЗначениеЗаполнено(ОформленныеЗаказы) Тогда
		Пользователи1=Новый Соответствие;
		Для Каждого Стр Из Отбор Цикл
			Струк=СтруктураЗаявкаПоставщику();
			ЗаполнитьЗначенияСвойств(Струк,Стр);
			Строка=СтруктураВСтроку(Струк);
			СендерОтправить("{""action"":""edit"",""table"":""ordered"",""name"":"""+Стр.Пользователь
			+""",""idData"":"+Формат(Стр.КодСтроки,"ЧГ=;ЧН=")+",""data"":"+Строка+"}");
			Пользователи1.Вставить(Стр.Пользователь);
			Если Объект.СборАналитики Тогда
				СендерОтправить(Новый Структура("schema, action, ID, supplierCount,supplierPrice,supplierDate,ipUser,noReply",
				"analytics","toDocSupplier",Стр.КодВКорзине,Окр(Стр.Количество,0),Окр(Стр.Цена,0),
				Формат(ТекущаяДата(),"ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""),Объект.IPКлиента,ИСтина));
			КонецЕсли;
			Стр.Выбран=Ложь;
		КонецЦикла;
		СохранитьДанныеПоЗаказамПоставщикам(Пользователи1);
		// Если Ответ=КодВозвратаДиалога.ОК тогда формы документов не открываются
		Для Каждого Значение Из ОформленныеЗаказы Цикл
			Если Ответ=КодВозвратаДиалога.Да или (Объект.ПроводитьДокументы и Не Значение.Пометка) Тогда
				ЗаявкаПост = Значение.Значение;
				ПоказатьЗначение(,ЗаявкаПост);
			КонецЕсли;
		КонецЦикла;
	КонецЕСли;	
	РассчитатьКоличествоЭлементов();
		
КонецПроцедуры

&НаСервере
Функция ОформитьЗаказыНаСервере()
	
	Отбор=Новый Структура("Выбран",Истина);
	ТЗДляОформления = Объект.ЗаявкаПоставщику.Выгрузить(Объект.ЗаявкаПоставщику.НайтиСтроки(Отбор));
	ОформленныеЗаказы=Новый СписокЗначений;
	ТЗВЗаказ = ТЗДляОформления.СкопироватьКолонки();
	Если Лев(Объект.Конфигурация,29) = "РозницаМагазинАвтозапчастей 2" Тогда	
		ТЗДляОформления.Сортировать("Поставщик,Склад");
		ТекущийПоставщик = ТЗДляОформления[0].Поставщик;
		ТекущийСклад=ТЗДляОформления[0].Склад;
		Для каждого Запись Из ТЗДляОформления Цикл
			
			Если (ТекущийПоставщик = Запись.Поставщик) и (Запись.Склад=ТекущийСклад) Тогда
				
				СтрокаВЗаказ = ТЗВЗаказ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
				Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
					СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
				КонецЕСли;
				
			Иначе
				
				Если ТЗВЗаказ.Количество() > 0 Тогда
					СоздатьЗаказПоставщику(ТЗВЗАказ,ОформленныеЗаказы);
				КонецЕСли;
				
				ТекущийПоставщик = Запись.Поставщик;
				ТекущийСклад = Запись.Склад;
				
				ТЗВЗаказ.Очистить();
				СтрокаВЗаказ = ТЗВЗАказ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
				
				Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
					СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
				КонецЕСли;
				
			КонецЕсли; 	
			
		КонецЦикла;
		
		РассчитатьКоличествоЭлементов();	
		
		Возврат ОформленныеЗаказы;
	КонецЕсли;
	
	ТЗДляОформления.Сортировать("Поставщик");
	
	ТекущийПоставщик = ТЗДляОформления[0].Поставщик;
	
	Для каждого Запись Из ТЗДляОформления Цикл
		
		Если ТекущийПоставщик = Запись.Поставщик Тогда
			
			СтрокаВЗаказ = ТЗВЗаказ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
			Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
				СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
			КонецЕСли;
			
		Иначе
			
			Если ТЗВЗаказ.Количество() > 0 Тогда
				СоздатьЗаказПоставщику(ТЗВЗАказ,ОформленныеЗаказы);
			КонецЕСли;
			
			ТекущийПоставщик = Запись.Поставщик;
			ТЗВЗаказ.Очистить();
			СтрокаВЗаказ = ТЗВЗАказ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
			
			Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
				СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
			КонецЕСли;
			
		КонецЕсли; 	
		
	КонецЦикла;
	
	РассчитатьКоличествоЭлементов();	
	
	Возврат ОформленныеЗаказы;
	
КонецФункции

&НаСервере
Процедура СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы)
	
	Попытка
		ЗаказПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();		
		МетаданныеДокумента = ЗаказПоставщику.Метаданные();
		Если МетаданныеДокумента.Реквизиты.Найти("ВариантПриемкиТоваров") <> Неопределено Тогда
		    ЗаказПоставщику.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
			//ЗаказПоставщику.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;
		
		Если МетаданныеДокумента.Реквизиты.Найти("Валюта") <> Неопределено Тогда
			Валюта="Валюта";
		ИначеЕсли ЕстьРеквизит1С(МетаданныеДокумента,"ВалютаДокумента") Тогда
			Валюта="ВалютаДокумента";
		Иначе 
			Валюта=Неопределено;
		КонецЕсли;
		Если Валюта<>Неопределено Тогда
			Если Метаданные.Константы.Найти("ВалютаРегламентированногоУчета")<>Неопределено Тогда
				ЗаказПоставщику[Валюта] = Константы.ВалютаРегламентированногоУчета.Получить();
			ИначеЕсли Метаданные.Константы.Найти("ВалютаРегламентированногоУчетаОрганизаций")<>Неопределено Тогда
				ЗаказПоставщику[Валюта] = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
			ИначеЕсли Метаданные.Константы.Найти("НациональнаяВалюта")<>Неопределено Тогда
				ЗаказПоставщику[Валюта] = Константы.НациональнаяВалюта.Получить();
			КонецЕсли;
		КонецЕсли;
		
		ЗаказПоставщику.Дата = ТекущаяДата();
		
		МаксДней=0;
		Если Объект.Конфигурация = "УправлениеТорговлей 11.0" ИЛИ
			Объект.Конфигурация = "УправлениеТорговлей 11.1" ИЛИ
			Объект.Конфигурация = "УправлениеТорговлей 11.2" ИЛИ
			Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
			Если Документы.ЗаказПоставщику.ПустаяСсылка().Метаданные().Реквизиты.Найти("Менеджер") = Неопределено тогда
				Заказпоставщику.Ответственный = параметрыСеанса.ТекущийПользователь;
			Иначе
				ЗаказПоставщику.Менеджер = ПараметрыСеанса.ТекущийПользователь;
			КонецЕсли;
			Если Документы.ЗаказПоставщику.ПустаяСсылка().Метаданные().Реквизиты.Найти("ХозяйственнаяОперация") = Неопределено тогда
				ЗаказПоставщику.ВидОперации = Перечисления.ВидыОперацийЗаказПоставщику.ЗаказНаЗакупку;
			Иначе
				ЗаказПоставщику.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
			КонецЕсли;
			Если Метаданные.Документы.ЗаказПоставщику.Реквизиты.Найти("ДокументОснование") <> Неопределено Тогда
				ЗаказПоставщику.ДокументОснование = ТЗВЗАказ[0].ЗаказПокупателя;	
			КонецЕсли;				
			
			Попытка
				Если ЗначениеЗаполнено(Метаданные.Документы.ЗаказПоставщику.Реквизиты.СпособДоставки.ЗначениеЗаполнения) Тогда
					ЗаказПоставщику.СпособДоставки=Метаданные.Документы.ЗаказПоставщику.Реквизиты.СпособДоставки.ЗначениеЗаполнения;
				КонецЕсли;	
			Исключение
			Конецпопытки;
			
			Попытка
				ЗаказПоставщику.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
				ЗаказПоставщику.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
				ЗаказПоставщику.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");  //Перечисления.Приоритеты.Средний;
				ЗаказПоставщику.Статус = Перечисления.СтатусыЗаказовПоставщикам.Согласован;		
				ЗаказПоставщику.Валюта = Объект.ТипЦен.ВалютаЦены;
				Если ЗначениеЗаполнено(ТЗВЗАказ[0].Поставщик) Тогда
					ЗаказПоставщику.Партнер = ТЗВЗАказ[0].Поставщик.Партнер;
					ЗаказПоставщику.Контрагент = ТЗВЗАказ[0].Поставщик;
				КонецЕсли;
				ЗаказПоставщику.ДатаСогласования = ТекущаяДата();
			Исключение
				ЗаказПоставщику.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
				ЗаказПоставщику.СостояниеЗаказа = Справочники.СостоянияЗаказовПоставщикам.Открыт;
				Заказпоставщику.ВалютаДокумента = ТЗВЗАказ[0].Поставщик.ДоговорПоУмолчанию.ВалютаРасчетов;
				ЗаказПоставщику.Контрагент = ТЗВЗАказ[0].Поставщик;
				ЗаказПоставщику.ДатаПоступления = ТекущаяДата() 
				+ ?(ТипЗнч(ТЗВЗаказ[0].Срок)=Тип("Число") и ТЗВЗаказ[0].Срок<999, ТЗВЗаказ[0].Срок*24*60*60,0);
				ЗаказПоставщику.Договор = ТЗВЗАказ[0].Поставщик.ДоговорПоУмолчанию;
				Курс = РегистрыСведений.КурсыВалют.СрезПоследних();
				Для Каждого СтрокаКурс Из Курс Цикл
					Если СтрокаКурс.Валюта = Объект.ТипЦен.ВалютаЦены Тогда
						ЗаказПоставщику.Кратность = СтрокаКурс.Кратность;
						ЗаказПоставщику.Курс = СтрокаКурс.Курс;
					КонецЕсли;
				КонецЦикла;
			Конецпопытки;
			РежимЗаписиЗаказа = ?(Объект.ПроводитьДокументы=Истина,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись);
			Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСтатусыЗаказовПоставщикам") Тогда
				ЗаказПоставщику.Статус = Перечисления.СтатусыЗаказовПоставщикам.Закрыт;
			Иначе
				ЗаказПоставщику.Статус = Перечисления.СтатусыЗаказовПоставщикам.Согласован;
			КонецЕсли;
		ИначеЕсли Лев(Объект.Конфигурация,29) = "РозницаМагазинАвтозапчастей 2" Тогда
			ЗаказПоставщику.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			ЗаказПоставщику.Магазин = ТЗВЗАказ[0].Склад.Магазин;
			РежимЗаписиЗаказа = РежимЗаписиДокумента.Запись;
			ЗаказПоставщику.ЗаказПокупателя = ТЗВЗАказ[0].ЗаказПокупателя;
			ЗаказПоставщику.УчитыватьНДС = Истина;
			ЗаказПоставщику.ЦенаВключаетНДС = Истина;
		ИначеЕсли Объект.Конфигурация = "УправлениеНебольшойФирмой 1.6" Тогда
			ЗаказПоставщику.ЗаказПокупателя = ТЗВЗАказ[0].ЗаказПокупателя;
			Запрос=Новый Запрос(
			 "ВЫБРАТЬ
			 |	ОсновныеДоговорыКонтрагента.Договор КАК Договор
			 |ИЗ
			 |	РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
			 |ГДЕ
			 |	ОсновныеДоговорыКонтрагента.Организация = &Организация
			 |	И ОсновныеДоговорыКонтрагента.Контрагент = &Контрагент
			 |	И ОсновныеДоговорыКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПоставщиком)"
			);
			Запрос.УстановитьПараметр("Контрагент",ТЗВЗАказ[0].Поставщик);
			Запрос.УстановитьПараметр("Организация",Объект.ОрганизацияДляЗаявки);			
			Выб=Запрос.Выполнить().Выбрать();
			Если Выб.Следующий() Тогда
				ЗаказПоставщику.Договор=Выб.Договор;
			Иначе
				Запрос=Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
				|ГДЕ
				|	ДоговорыКонтрагентов.Владелец = &Контрагент
				|	И (ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПоставщиком)
				|			ИЛИ ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СПокупателем))
				|	И ДоговорыКонтрагентов.Недействителен = ЛОЖЬ
				|	И (ДоговорыКонтрагентов.СрокДействия >= &ТекущаяДата
				|			ИЛИ ДоговорыКонтрагентов.СрокДействия = ДАТАВРЕМЯ(1, 1, 1))
				|	И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
				|	И ДоговорыКонтрагентов.Организация = &Организация
				|
				|УПОРЯДОЧИТЬ ПО
				|	ДоговорыКонтрагентов.ВидДоговора,
				|	ДоговорыКонтрагентов.ДатаДоговора УБЫВ");
				Запрос.УстановитьПараметр("Контрагент",ТЗВЗАказ[0].Поставщик);
				Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
				Запрос.УстановитьПараметр("Организация",Объект.ОрганизацияДляЗаявки);;			
				Выб=Запрос.Выполнить().Выбрать();
				Если Выб.Следующий() Тогда
					ЗаказПоставщику.Договор=Выб.Ссылка;
				КонецЕсли;
			КонецЕсли;
			Состояние=Справочники.СостоянияЗаказовПоставщикам.НайтиПоНаименованию("В работе");
			Если ЗначениеЗаполнено(Состояние) Тогда
				ЗаказПоставщику.СостояниеЗаказа=Состояние;
			КонецЕсли;
			ЕСли МетаданныеДокумента.Реквизиты.Найти("ВидОперации")<>Неопределено Тогда
				ЗаказПоставщику.ВидОперации=Перечисления.ВидыОперацийЗаказПоставщику.ЗаказНаЗакупку;
			КонецЕсли;
			Если Метаданные.Справочники.СтавкиНДС.Реквизиты.Найти("НеОблагается")<>Неопределено Тогда
				ЗаказПоставщику.НалогообложениеНДС=?(Объект.НДСПоУмолчанию.НеОблагается,Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС,
				Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС);
			Иначе
				ЗаказПоставщику.НалогообложениеНДС=?(Объект.НДСПоУмолчанию.Ставка=0,Перечисления.ТипыНалогообложенияНДС.НеОблагаетсяНДС,
				Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС);
			КонецЕсли;
			ЗаказПоставщику.НДСВключатьВСтоимость=Истина;
		ИначеЕсли Лев(Объект.Конфигурация,9) = "Автосалон" Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =   "ВЫБРАТЬ
			                 |	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка,
			                 |	ДоговорыВзаиморасчетов.ПодразделениеКомпании КАК ПодразделениеКомпании
			                 |ИЗ
			                 |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
			                 |ГДЕ
			                 |	ДоговорыВзаиморасчетов.Организация = &Организация
			                 |	И ДоговорыВзаиморасчетов.ПодразделениеКомпании В ИЕРАРХИИ(&ПодразделениеКомпании)
			                 |	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
			                 |	И ДоговорыВзаиморасчетов.Владелец = &Владелец
			                 |
			                 |УПОРЯДОЧИТЬ ПО
			                 |	ДоговорыВзаиморасчетов.Основной УБЫВ";
			Запрос.УстановитьПараметр("Организация", Объект.ОрганизацияДляЗаявки);
			Запрос.УстановитьПараметр("ПодразделениеКомпании", ПараметрыСеанса.ПодразделениеКомпании);
			Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоров.Покупка);
			Запрос.УстановитьПараметр("Владелец", ТЗВЗАказ[0].Поставщик);
			Выборка = Запрос.Выполнить().Выбрать();
			Если ВЫборка.Следующий() Тогда
				ЗаказПоставщику.ДоговорВзаиморасчетов = Выборка.Ссылка;
				ЗаказПоставщику.ПодразделениеКомпании = Выборка.ПодразделениеКомпании;
			Иначе	
				ЗаказПоставщику.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
			КонецЕсли;
			ЗаказПоставщику.ТипЦен = Объект.ТипЦен;
			ЗаказПоставщику.СрокПоставки = ТекущаяДата() 
			+?(ТипЗнч(ТЗВЗаказ[0].Срок)=Тип("Число") и ТЗВЗаказ[0].Срок<999, ТЗВЗаказ[0].Срок*24*60*60,0);
			ЗаказПоставщику.Автор = ПараметрыСеанса.АвторизованныйПользователь;
			ЗаказПоставщику.ВалютаДокумента = Объект.ТипЦен.ВалютаЦены;
			ЗаказПоставщику.ДатаОперации = ТекущаяДата();
			ЗаказПоставщику.ДатаСоздания = ТекущаяДата();
			ЗаказПоставщику.КурсДокумента = 1;
			ЗаказПоставщику.КурсВалютыУпр = 1;
			ЗаказПоставщику.ХозОперация = Справочники.ХозОперации.ЗаказПоставщику;
		КонецЕсли;
		ЗаказПоставщику.Организация = Объект.ОрганизацияДляЗаявки;
		ЗаказПоставщику.Контрагент = ТЗВЗАказ[0].Поставщик;
		Если НЕ ЗаказПоставщику.Метаданные().Реквизиты.Найти("Партнер") = Неопределено Тогда
			ЗаказПоставщику.Партнер=ЗаказПоставщику.Контрагент.Партнер;
		КонецЕсли;
		Если НЕ Документы.ЗаказПоставщику.ПустаяСсылка().Метаданные().Реквизиты.Найти("Склад") = Неопределено Тогда
			ЗаказПоставщику.Склад = ТЗВЗАказ[0].Склад;
		КонецЕсли;
		Если МетаданныеДокумента.Реквизиты.Найти("ДатаПоступления") <> Неопределено Тогда
			ЗаказПоставщику.ДатаПоступления = ТекущаяДата()
			+ ?(ТипЗнч(ТЗВЗаказ[0].Срок)=Тип("Число") и ТЗВЗаказ[0].Срок<999, ТЗВЗаказ[0].Срок*24*60*60,0);
		КонецЕсли;
		Если Метаданные.ОбщиеМодули.Найти("УчетНДСУП") <> Неопределено Тогда
			ЗаказПоставщику.ЗаполнитьУсловияЗакупокПоУмолчанию(Ложь);
			ЗаказПоставщику.ВариантПриемкиТоваров = ЗаказПоставщику.Договор.ВариантПриемкиТоваров;
			Если НЕ ЗначениеЗаполнено(ЗаказПоставщику.ВариантПриемкиТоваров) Тогда
				ЗаказПоставщику.ВариантПриемкиТоваров = Вычислить("ЗакупкиСервер.ПолучитьВариантПриемкиТоваров(Неопределено, ЗаказПоставщику.Договор)");
			КонецЕсли;
			ЗаказПоставщику.Приоритет = Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию(ЗаказПоставщику.Приоритет);
			ЗаказПоставщику.ПорядокРасчетов = Вычислить("ВзаиморасчетыСервер.ПорядокРасчетовПоДокументу(ЗаказПоставщику)");
			
			//ПараметрыЗаполнения = Документы.ЗаказПоставщику.ПараметрыЗаполненияВидаДеятельностиНДС(ЗаказПоставщику);
			//Выполнить("УчетНДСУП.ЗаполнитьВидДеятельностиНДС(ЗаказПоставщику.ЗакупкаПодДеятельность, ПараметрыЗаполнения)");
			//
			//ПараметрыЗаполнения = Документы.ЗаказПоставщику.ПараметрыЗаполненияНалогообложенияНДСЗакупки(ЗаказПоставщику);
			//Выполнить("УчетНДСУП.ЗаполнитьНалогообложениеНДСЗакупки(ЗаказПоставщику.НалогообложениеНДС, ПараметрыЗаполнения)");
		КонецЕсли;		
		СуммаДокумента=0;
		ТабЧасть=Метаданные.Документы.ЗаказПоставщику.ТабличныеЧасти.Найти("Товары");
		Если ТабЧасть=Неопределено тогда
			ТабЧасть=Метаданные.Документы.ЗаказПоставщику.ТабличныеЧасти.Найти("Запасы");
		КонецЕсли;
		ТабРекв=Табчасть.Реквизиты;
		
		Для каждого Строка Из ТЗВЗаказ Цикл
			Если Лев(Объект.Конфигурация,9) <> "Автосалон" Тогда
			    Попытка
					ЗаказПоставщикуСтрока = ЗаказПоставщику.Товары.Добавить();
					ЗаказПоставщикуСтрока.Номенклатура = Строка.Номенклатура;
					ЗаказПоставщикуСтрока.КоличествоУпаковок = Строка.Количество;
				Исключение
				    ЗаказПоставщикуСтрока = ЗаказПоставщику.Запасы.Добавить();
					ЗаказПоставщикуСтрока.Номенклатура = Строка.Номенклатура;
					//ЗаказПоставщикуСтрока.ДатаПоступления = ТекущаяДата() + ТЗВЗаказ[0].Срок*24*60*60;
				КонецПопытки;
				Если НЕ Лев(Объект.Конфигурация,29) = "РозницаМагазинАвтозапчастей 2" Тогда
					ЗаказПоставщикуСтрока.ДатаПоступления = ТекущаяДата()
					+ ?(ТипЗнч(ТЗВЗаказ[0].Срок)=Тип("Число") и ТЗВЗаказ[0].Срок<999, ТЗВЗаказ[0].Срок*24*60*60,0);
				КонецЕсли;
			Иначе
				ЗаказПоставщикуСтрока = ЗаказПоставщику.Товары.Добавить();
				ЗаказПоставщикуСтрока.Номенклатура = Строка.Номенклатура;
				ЗаказПоставщикуСтрока.ЕдиницаИзмерения = Строка.Номенклатура.ОсновнаяЕдиницаИзмерения;
				ЗаказПоставщикуСтрока.Коэффициент = 1; 
				Если ЗначениеЗаполнено(Строка.ЗаказПокупателя) Тогда
					СтрЗК=Строка.ЗаказПокупателя.Товары.Найти(Строка.Номенклатура,"Номенклатура");
					Если СтрЗК<>Неопределено Тогда
						Распределение=ЗаказПоставщику.РаспределениеЗаказа.Добавить();
						ЗаполнитьЗначенияСвойств(Распределение,ЗаказПоставщикуСтрока);
						ЗаказПоставщикуСтрока.Распределено = Мин(СтрЗК.Количество,Строка.Количество);
						Распределение.Количество = ЗаказПоставщикуСтрока.Распределено;
						Распределение.Цена = Строка.Цена;
						Распределение.ЗаказПокупателя=Строка.ЗаказПокупателя;
						Распределение.ЗаказОтправленПоставщику = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ЗаказПоставщикуСтрока.Количество = Строка.Количество;
			ЗаказПоставщикуСтрока.Цена = Строка.Цена;
			ЗаказПоставщикуСтрока.Сумма = Строка.Сумма;
			ЗаказПоставщикуСтрока.СтавкаНДС = Строка.СтавкаНДС;
			ЗаказПоставщикуСтрока.СуммаНДС = Строка.СуммаНДС;
			Если ТабРекв.Найти("Всего")<>Неопределено Тогда ЗаказПоставщикуСтрока.Всего=Строка.Сумма;КонецЕсли;
			Если ТабРекв.Найти("СуммаВсего")<>Неопределено Тогда ЗаказПоставщикуСтрока.СуммаВсего=Строка.Сумма;КонецЕсли;
			СуммаДокумента=СуммаДокумента + ЗаказПоставщикуСтрока.Сумма;
			Если Объект.Конфигурация = "УправлениеТорговлей 11.0" ИЛИ
				Объект.Конфигурация = "УправлениеТорговлей 11.2" ИЛИ
				Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
				Попытка
					ЗаказПоставщикуСтрока.СуммаСНДС = Строка.Всего;
					ЗаказПоставщикуСтрока.Склад = Строка.Склад;	
				Исключение
				КонецПопытки;
				//Подберем Назначение
				Если ЗначениеЗаполнено(Строка.ЗаказПокупателя) Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	ОбеспечениеЗаказовОстатки.Назначение КАК Назначение,
					               |	ОбеспечениеЗаказовОстатки.ПотребностьОстаток КАК ПотребностьОстаток,
					               |	ОбеспечениеЗаказовОстатки.КЗаказуОстаток КАК КЗаказуОстаток,
					               |	ОбеспечениеЗаказовОстатки.НаличиеПодЗаказОстаток КАК НаличиеПодЗаказОстаток
					               |ИЗ
					               |	РегистрНакопления.ОбеспечениеЗаказов.Остатки КАК ОбеспечениеЗаказовОстатки
					               |ГДЕ
					               |	ОбеспечениеЗаказовОстатки.Номенклатура = &Номенклатура
					               |	И ОбеспечениеЗаказовОстатки.Склад = &Склад
					               |	И ОбеспечениеЗаказовОстатки.Назначение.Заказ = &Заказ";
					Запрос.УстановитьПараметр("Номенклатура", ЗаказПоставщикуСтрока.Номенклатура);
					Запрос.УстановитьПараметр("Склад", ЗаказПоставщикуСтрока.Склад);
					Запрос.УстановитьПараметр("Заказ", Строка.ЗаказПокупателя);
					Выборка = Запрос.Выполнить().Выбрать();
					Пока Выборка.Следующий() Цикл
						ЗаказПоставщикуСтрока.Назначение = Выборка.НАзначение;
						Прервать;
					КонецЦикла;
				КонецЕсли;
			ИначеЕсли Лев(Объект.Конфигурация,29) = "РозницаМагазинАвтозапчастей 2" И НЕ Метаданные.Имя = "Розница" Тогда
				ЗаказПоставщикуСтрока.ор_ЗаказПокупателя=Строка.ЗаказПокупателя;
			ИначеЕсли Объект.Конфигурация = "УправлениеНебольшойФирмой 1.6" Тогда
				ЗаказПоставщикуСтрока.ЕдиницаИзмерения = ЗаказПоставщикуСтрока.Номенклатура.ЕдиницаИзмерения;
				ЗаказПоставщикуСтрока.Всего = ЗаказПоставщикуСтрока.Сумма;
			КонецЕсли;
			Если ТипЗнч(Строка.Срок)=Тип("Число") и Строка.Срок<999 И Строка.Срок>МаксДней Тогда МаксДней=Строка.Срок КонецЕсли;
		КонецЦикла;  		
	    Если Метаданные.Документы.ЗаказПоставщику.Реквизиты.Найти("ЖелаемаяДатаПоступления")<>Неопределено Тогда
			ЗаказПоставщику.ЖелаемаяДатаПоступления = ТекущаяДата()
			+ ?(ТипЗнч(ТЗВЗаказ[0].Срок)=Тип("Число") и ТЗВЗаказ[0].Срок<999, ТЗВЗаказ[0].Срок*24*60*60,0);
		КонецЕсли;
		Если Метаданные.Документы.ЗаказПоставщику.Реквизиты.Найти("СуммаВключаетНДС")<>Неопределено Тогда
			ЗаказПоставщику.СуммаВключаетНДС=Истина;
		КонецЕсли;
		Если Метаданные.Документы.ЗаказПоставщику.Реквизиты.Найти("СуммаДокумента")<>Неопределено Тогда
			ЗаказПоставщику.СуммаДокумента=СуммаДокумента;
		КонецЕсли;
		Если Объект.Конфигурация = "УправлениеТорговлей 11.0" ИЛИ
			Объект.Конфигурация = "УправлениеТорговлей 11.2" ИЛИ
			Объект.Конфигурация = "УправлениеТорговлей 11.4" Тогда
			ЗаказПоставщику.ЗаполнитьЭтапыГрафикаОплаты();
		КонецЕсли;
		Попытка
			ЗаказПоставщику.Записать(?(Объект.ПроводитьДокументы=Истина,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
		Исключение
			Если Объект.ПроводитьДокументы=Истина Тогда
				Ошибка=ОписаниеОшибки();
				ЗаказПоставщику.Записать(РежимЗаписиДокумента.Запись);
				Сообщить("Документ "+Строка(ЗаказПоставщику)+" не проведен из-за ошибки:"+Символы.ПС+Ошибка);
			Иначе
				ВызватьИсключение ОписаниеОшибки();
			КонецЕсли;
		Конецпопытки;
		ОформленныеЗаказы.Добавить(ЗаказПоставщику.Ссылка,,ЗаказПоставщику.Проведен);
		Для каждого ТекЗаказ Из ТЗВЗаказ Цикл
			Объект.ЗаявкаПоставщику.Получить(ТекЗаказ.НомерСтроки-1).ЗаказПоставщику = ЗаказПоставщику.Ссылка;
		КонецЦикла;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗаказы(Команда)
	ЕСли Объект.ПользовательИмя<>ПользовательКорзины Тогда
		Сообщить("Для удаления строк необходимо работать со своей корзиной");
		Возврат;
	КонецЕсли;
	Отбор=Новый Структура("Выбран,Пользователь",Истина,Объект.ПользовательИмя);//вс(
	Массив = Объект.ЗаявкаПоставщику.НайтиСтроки(Отбор);
	Оповещение=Новый ОписаниеОповещения("ОчиститьЗаказыОтвет",ЭтаФорма,Массив);
	Если Массив.Количество()>0 Тогда
		ПоказатьВопрос(Оповещение,"Удалить все выбранные записи ?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	Иначе
		Массив = Объект.ЗаявкаПоставщику.НайтиСтроки(Новый Структура("Пользователь",Объект.ПользовательИмя));
		Если Массив.Количество()>0 Тогда
			ПоказатьВопрос(Оповещение,"Удалить все Ваши записи ?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		Иначе
			ПоказатьПредупреждение(,"В Заявках Поставщику нет записей пользователя "+Объект.ПользовательИмя);
		КонецЕсли;
	КонецЕсли;
Конецпроцедуры

&НаКлиенте
Процедура ОчиститьЗаказыОтвет(Ответ,Массив) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда Возврат;КонецЕсли;
	
	//Для Каждого Стр Из Массив Цикл
	Колво=Массив.Количество();
	Для инд=1 по колво Цикл
		Стр=Массив[Колво-инд];
		// Удаляем ссылку на запись в корзине
		Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("КодЗП",Стр.КодСтроки));
		Если Строки.Количество()>0 Тогда Строки[0].КОдЗП=0;КонецЕсли;
		//Сообщаем об удалении записи
		СендерОтправить("{""action"":""del"",""table"":""ordered"",""idData"":"+Формат(Стр.КодСтроки,"ЧГ=;ЧН=")+"}");
		Объект.ЗаявкаПоставщику.Удалить(Стр);
	КонецЦикла;
	Элементы.Группа10.Заголовок = "Заказанное(" + Объект.ЗаявкаПоставщику.Количество() + ")";
	СохранитьДанныеПоЗаказамПоставщикам();
	СохранитьДанныеПоКорзине(ПользовательКорзины);
	//вс)
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажкиПоставщику(Команда)
	Флаг=Команда.Имя="УстановитьФлажкиПоставщику";
	Для каждого СтрокаТЗ Из Объект.ЗаявкаПоставщику Цикл
		Инд=СтрокаТЗ.ПолучитьИдентификатор();
		Если Элементы.ЗаявкаПоставщику.ПроверитьСтроку(Инд)=Истина Тогда
			Если Флаг = Неопределено Тогда
			  СтрокаТЗ.Выбран = НЕ СтрокаТЗ.Выбран;
			Иначе	
			  СтрокаТЗ.Выбран = Флаг;
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиПоставщикуБезДокумента(Команда)
	Для каждого СтрокаТЗ Из Объект.ЗаявкаПоставщику Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ЗаказПоставщику) Тогда
			СтрокаТЗ.Выбран = Истина;
		Иначе
			СтрокаТЗ.Выбран = Ложь;
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	Если Элементы.ЗаявкаПоставщику.ОтборСтрок=Неопределено или Элементы.ЗаявкаПоставщику.ОтборСтрок.Количество()=0 Тогда
		Диалог = Новый ДиалогРедактированияСтандартногоПериода();
		Диалог.Период = Новый СтандартныйПериод(); //ПериодЗаявокПоставщику;
		ОО=Новый описаниеОповещения("УстановкаПериода",ЭтаФорма);
		Диалог.Показать(ОО);
	Иначе
		Элементы.ЗаявкаПоставщику.ОтборСтрок=Неопределено;
		Элементы.ЗаявкаПоставщикуКнопка9.ЦветФона=Новый Цвет(255, 255, 255);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановкаПериода(НовыйПериод, Доп) Экспорт
	Если НовыйПериод=Неопределено Тогда
		//Элементы.ЗаявкаПоставщику.ОтборСтрок=Неопределено;
		Возврат;
	КонецЕсли;
	//ПериодЗаявокПоставщику=НовыйПериод;
	Для Каждого Стр Из Объект.ЗаявкаПоставщику Цикл
		Стр.ОтборФильтр = Стр.Дата>=НовыйПериод.ДатаНачала И (Стр.Дата<=НовыйПериод.ДатаОкончания или НовыйПериод.ДатаОкончания='00010101');
	КонецЦикла;
	Элементы.ЗаявкаПоставщику.ОтборСтрок = Новый ФиксированнаяСтруктура("ОтборФильтр",Истина);
	Элементы.ЗаявкаПоставщикуКнопка9.ЦветФона=Новый Цвет(200,255,225);
Конецпроцедуры

&НаКлиенте
// Производит контроль наличия Поставщика и оформленных документов
// Документ: "ЗаказПоставщику" или "ПоступлениеТовара"
Процедура ОформитьПоступленияТовара(Команда)
 	Отбор=Объект.ЗаявкаПоставщику.НайтиСтроки(Новый Структура("Выбран",Истина));//вс(
	Если Отбор.Количество() = 0 Тогда
		ПоказатьПредупреждение(,"Нет отмеченных строк для формирования документов!");
		Возврат;
	КонецЕсли;
	Пользователи1=Новый Соответствие;
	Кол=0;НетПост=0;
	Для каждого Стр Из Отбор Цикл
		Если ЗначениеЗаполнено(Стр.ПоступлениеТовара) Тогда Кол=Кол+1;КонецЕсли;
		Если ТипЗнч(Стр.Поставщик)=Тип("Строка") Или Не ЗначениеЗаполнено(Стр.Поставщик) Тогда НетПост=НетПост+1;КонецЕсли;
		Пользователи1.Вставить(Стр.Пользователь);
	КонецЦикла;
	Если Кол>0 ИЛИ НетПост>0 Тогда
		ОО=Новый ОписаниеОповещения("ОформитьДокументыСПоставщиком",ЭтаФорма,Пользователи1);
		ПоказатьВопрос(ОО,?(Кол>0,"Для "+Строка(Кол)+" отмеченных строк уже оформлены документы","")+
		?(НетПост>0, ?(Кол>0, " и в ","В "),"")+?(НетПост>0,Строка(НетПост)+" строк"+?(НетПост=1,"е","ах")
		+" не определен поставщик","")+". Продолжить?",	РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	Иначе
		ОформитьДокументыСПоставщиком(КодВозвратаДиалога.Да,Пользователи1);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОформитьДокументыСПоставщиком(Ответ,Пользователи1) Экспорт
	Если Ответ<>КодВозвратаДиалога.Да Тогда Возврат;КонецЕсли;
	Поступления=ОформитьПоступленияТовараНаСервере();
	Если Поступления.Количество()>0 Тогда
		СохранитьДанныеПоЗаказамПоставщикам(Пользователи1); 
		Для Каждого Значение Из Поступления Цикл
			Поступление = Значение.Значение;
			ПоказатьЗначение(,Поступление);
		КонецЦикла;
	КонецЕсли;
Конецпроцедуры	

