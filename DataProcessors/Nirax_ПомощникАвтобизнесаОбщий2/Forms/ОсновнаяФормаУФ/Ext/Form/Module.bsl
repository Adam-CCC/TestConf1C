&НаКлиенте
Процедура РедактированиеКорзины(Доступ)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Доступ0=?(ТекДан=Неопределено или ТекДан.Заказ=0,Ложь,Доступ);
	НеДоступ = Не Доступ;
	ДоступСвой=ПользовательКорзины=Объект.ПользовательИмя;
	Элементы.ЗаявкаПоставщикуУдалить.Доступность=ДоступСвой;
	Элементы.ОчиститьЗаказы.Доступность=ДоступСвой;
	Элементы.ВключитьРедактирование.Доступность=НеДоступ;
	Элементы.ОтключитьРедактирование.Доступность=Доступ;
	Элементы.ЗаказыКлиентовВниз.Доступность=Доступ;
	Элементы.ЗаказыКлиентовВверх.Доступность=Доступ0;
	Элементы.ОбновитьКорзину.Доступность=НеДоступ;
	Элементы.ЗаказыКлиентовУдалить.Доступность=Доступ;
	Элементы.ОформитьЗаказПокупателя.Доступность=
	?(Доступ,Объект.Реквизит1С.Заказ<>Неопределено,Ложь);
	
	Элементы.ЗаказыКлиентов.ТолькоПросмотр=Не Доступ0;
	Элементы.ЗаказНаименование.ТолькоПросмотр=Не Доступ0;
	Элементы.ЗаказСтатус.ТолькоПросмотр=Не Доступ0;
	Элементы.ЗаказДата.ТолькоПросмотр=Не Доступ0;
	
	Элементы.ЗаявкаНаОформление.ТолькоПросмотр=Не Доступ;
	Элементы.ЗаказКонтрагент.ТолькоПросмотр=Не Доступ;
	Элементы.ЗаказСоглашение.ТолькоПросмотр=Не Доступ;
	Элементы.ЗаказДоговор.ТолькоПросмотр=Не Доступ;
	Элементы.ЗаказСклад.ТолькоПросмотр=Не Доступ;
	Элементы.ЗаказДатаОтгрузки.ТолькоПросмотр=Не Доступ;
	
	Элементы.ПереносЗаказов.Видимость=ПользовательКорзины<>Объект.ПользовательИмя и Доступ=Истина;
	
	Кнопки=Новый Структура("УстановитьФлажки,СнятьФлажки,ЗаявкаНаОформлениеДобавить,
	|ЗаявкаНаОформлениеУдалить,ЗаявкаНаОформлениеОчистить,ВЗаказ,ЗаявкаНаОформлениеВверх,
	|ЗаявкаНаОформлениеВниз,ЗаявкаНаОформлениеКнопка3,ЗаказатьЕмекс");
	Для Каждого Кнопка из Кнопки Цикл
		Элементы[Кнопка.Ключ].Доступность=Доступ;
	КонецЦикла;
	ИзменятьКорзину=Доступ;
КонецПроцедуры

