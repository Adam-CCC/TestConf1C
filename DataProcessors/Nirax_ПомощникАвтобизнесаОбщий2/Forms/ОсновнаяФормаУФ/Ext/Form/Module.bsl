Процедура ВходВгруппуЕмексСервер(Результат,Запись) Экспорт
		
	Если ТипЗнч(Запись) = Тип("СправочникСсылка.Номенклатура") Тогда
	    Спр = Справочники.Номенклатура;
	    СпрСсылка = Спр.НайтиПоНаименованию(СокрЛП(Запись), Истина);
		Если СпрСсылка <> Спр.ПустаяСсылка() Тогда
	        Если ЗначениеЗаполнено(Результат) Тогда
		        Об = СпрСсылка.ПолучитьОбъект();  // Запись.Номенклатура
		        Об.Родитель = Результат;
		        Об.Записать();
	        КонецЕсли;
        КонецЕсли;
	Иначе
		Об = Запись.Номенклатура.ПолучитьОбъект();  // Запись.Номенклатура
		Об.Родитель = Результат;
		Об.Записать();		
	КонецЕсли;
	
