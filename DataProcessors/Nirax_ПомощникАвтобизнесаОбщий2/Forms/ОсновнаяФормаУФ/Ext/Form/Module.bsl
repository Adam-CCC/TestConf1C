	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ОтборЗаказовКлиентовУФ",,ЭтаФорма,"ОтборЗаказовКлиентов",,,ОО,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры	

&НаКлиенте
Процедура ЗаказыКлиентовОтборВыполнить(ОтборИзменен, Парам2=Неопределено) Экспорт
	Если ОтборИзменен<>Истина Тогда Возврат;КонецЕсли;
	Для Каждого Стр Из Объект.ЗаказыКлиентов Цикл
		ЗаказКлиентаУстановитьОтбор(Стр);
	КонецЦикла;
	Элементы.ЗаказыКлиентов.ТекущаяСтрока=Объект.ЗаказыКлиентов[0].ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура ЗаказКлиентаПриИзменении(Элемент)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	ЕСли ТекДан<>Неопределено Тогда 
		ЗаказКлиентаУстановитьОтбор(ТекДан)	
	КонецЕсли;
	ЗаказПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЗаказКлиентаУстановитьОтбор(Стр)
	Если Стр.Заказ=0 Тогда 
		Стр.Отбор=Истина ;
	ИначеЕсли НЕ ЗаказыКлиентовОтбор.Статусы[Стр.Статус].Пометка ТОгда
		Стр.Отбор=Ложь;
	ИначеЕсли ЗначениеЗаполнено(ЗаказыКлиентовОтбор.Контрагент)
		И ЗаказыКлиентовОтбор.Контрагент<>Стр.Контрагент Тогда
		Стр.Отбор=Ложь;
	ИначеЕсли ЗначениеЗаполнено(ЗаказыКлиентовОтбор.ДатаЗаказаС) 
		И ЗаказыКлиентовОтбор.ДатаЗаказаС>Стр.Дата Тогда
		Стр.Отбор=Ложь;
	ИначеЕсли ЗначениеЗаполнено(ЗаказыКлиентовОтбор.ДатаЗаказаПо) 
		И ЗаказыКлиентовОтбор.ДатаЗаказаПо<(Стр.Дата-86400) Тогда
		Стр.Отбор=Ложь;
	ИначеЕсли ЗначениеЗаполнено(ЗаказыКлиентовОтбор.ДатаОтгрузкиС) 
		И ЗаказыКлиентовОтбор.ДатаОтгрузкиС>Стр.Дата Тогда
		Стр.Отбор=Ложь;
	ИначеЕсли ЗначениеЗаполнено(ЗаказыКлиентовОтбор.ДатаОтгрузкиПо) 
		И ЗаказыКлиентовОтбор.ДатаОтгрузкиПо<(Стр.Дата-86400) Тогда
		Стр.Отбор=Ложь;
	Иначе
		Стр.Отбор=Истина;
	КонецЕсли;
КонецПроцедуры
		
&НаКлиенте
Процедура ЗаявкаНаОформлениеКолонки(Команда)
	ЕСли Команда.Имя="ЗаявкаКолонкиВсе" ТОгда
		Шаблон=Новый Структура("ЗаявкаНаОформлениеКодПроизводителя,ЗаявкаНаОформлениеДляКорзины,ЗаявкаНаОформлениеКодВКорзине",ИСтина,Истина,Истина);
		Для Каждого Колонка Из Элементы.ЗаявкаНаОформление.ПодчиненныеЭлементы Цикл
			Колонка.Видимость = НЕ Шаблон.Свойство(Колонка.Имя);
		КонецЦикла
	ИначеЕсли Команда.Имя="ЗаявкаКолонкиИзНастройки" ТОгда
		Шаблон=Новый Структура("Скидка,Склад,СтавкаНДС,Сумма,СуммаВсего,СуммаНДС,СуммаСоСкидкой,Цена,ЦенаПоставки,КодПроизводителя,ДляКорзины,КодВКорзине",
		Объект.БлокироватьКорзинаСкидка,Объект.БлокироватьКорзинаСкладПоставщика,
		Объект.БлокироватьКорзинаСтавкаНДС,Объект.БлокироватьКорзинаСумма,
		Объект.БлокироватьКорзинаСуммаВсего,Объект.БлокироватьКорзинаСуммаНДС,
		Объект.БлокироватьКорзинаСуммаСоСкидкой,Объект.БлокироватьКорзинаЦена,
		Объект.БлокироватьКорзинаЦенаПоставки,Истина,Истина,Истина);
		Для Каждого Колонка Из Элементы.ЗаявкаНаОформление.ПодчиненныеЭлементы Цикл
			Имя=Сред(Колонка.Имя,19);
			Колонка.Видимость = НЕ(Шаблон.Свойство(Имя) И Шаблон[Имя]);
		КонецЦикла
	Иначе
		Шаблон=Новый Структура(?(Команда.Имя="ЗаявкаКолонкиКлиента",
		"Выбран,Производитель,Артикул,Наименование,Количество,Цена,Сумма,Статус,Склад,Комментарий",
		"Выбран,Производитель,Артикул,Наименование,Количество,ЦенаПоставки,Сайт,Статус,Склад,Комментарий,СрокДоставки,СрокДоставкиМакс,Наличие,Поставщик"));
		Для Каждого Колонка Из Элементы.ЗаявкаНаОформление.ПодчиненныеЭлементы Цикл
			Колонка.Видимость = Шаблон.Свойство(Сред(Колонка.Имя,19));    //Убираем "ЗаявкаНаОформление"
		КонецЦикла
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеПоКорзине(Владелец=Неопределено)
	Если Владелец=Неопределено Тогда Владелец=ПользовательКорзины;КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Данные=Объект.ЗаявкаНаОформление.Выгрузить();
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнесаЗК",Строка(Объект.ТекущийЗК),Данные,,Владелец);
	Данные=Объект.ЗаказыКлиентов.Выгрузить();
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","ЗаказыКлиентов",Данные,,Владелец);
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаСервере
// Процедура сохраняет в хранилище текущий заказ клиента (ТекущшийЗК), если он задан положительным числом
// Если число отрицательно то -ТекущшийЗК удаляется из хранилища.
// Если указан Заказ числом - загружает заказ с этим номером из хранилища, меняя номер текущего заказа
// Если Заказ=Истина - Заявка на оформление очищается
//
Процедура СменитьЗаявку(Заказ=Неопределено, Владелец=Неопределено)
	Если Владелец=Неопределено Тогда Владелец=ПользовательКорзины;КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Если ТипЗнч(Объект.ТекущийЗК)=Тип("Число") и ИзменятьКорзину Тогда
		Если Объект.ТекущийЗК < 0 Тогда
			ХранилищеОбщихНастроек.Удалить("ПомощникАвтобизнесаЗК",Строка(0-Объект.ТекущийЗК),Владелец);
		Иначе	
			Данные=Объект.ЗаявкаНаОформление.Выгрузить();
			ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнесаЗК",Строка(Объект.ТекущийЗК),Данные,,Владелец);
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Заказ)=Тип("Число") Тогда
		Объект.ТекущийЗК=Заказ;
		Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнесаЗК",Строка(Заказ),,Владелец);
		Если ТипЗнч(Данные)=Тип("ТаблицаЗначений") Тогда
			Объект.ЗаявкаНаОформление.Загрузить(Данные);
			// Обновляем значения статуса заказа из заказов поставщиков
			Для Каждого Стр Из Объект.ЗаявкаНаОформление Цикл
				Если Стр.КодЗП<>0 И Не ПустаяСтрока(Стр.КодЗаказа) Тогда
					Строки=Объект.ЗаявкаПоставщику.НайтиСтроки(Новый Структура("Пользователь,КодСтроки",ПользовательКорзины,Стр.КодЗП));
					ЕСли Строки.Количество()>0 Тогда 
						Стр.Статус=?(ПустаяСтрока(Строки[0].СтатусПозиции),Строки[0].СтатусЗаказа,Строки[0].СтатусПозиции);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Объект.ЗаявкаНаОформление.Очистить();
		КонецЕсли;
	ИначеЕсли Заказ=Истина Тогда
		Объект.ЗаявкаНаОформление.Очистить();
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

