&НаСервере
Процедура ЗаявкаНаОформлениеНаименованиеПриИзмененииНаСервере()
	ТекСтр=Объект.ЗаявкаНаОформление.НайтиПоИдентификатору(Элементы.ЗаявкаНаОформление.ТекущаяСтрока);
	
	Если ТипЗнч(ТекСтр.Наименование) <> Тип("Строка") Тогда	
		ТекСтр.Номенклатура=ТекСтр.Наименование;
		ТекСтр.Артикул=ТекСтр.Номенклатура.Артикул;
		Если ТекСтр.Номенклатура.Метаданные().Реквизиты.Найти("СтавкаНДС")<>Неопределено Тогда
			ТекСтр.СтавкаНДС=ТекСтр.Номенклатура.СтавкаНДС;
		КонецЕсли;
	
		Обработка=РеквизитФормыВЗначение("Объект");
		
		ПроизводительСвойства=Обработка.ПолучитьПроизводителяНоменклатуры(ТекСтр.Номенклатура);
		Если ПроизводительСвойства<>Неопределено Тогда
			ТекСтр.Производитель=ТекСтр.Номенклатура[ПроизводительСвойства.Реквизит];
		КонецЕсли;
	
		ТекСтр.Цена=Обработка.ПолучитьЦенуНоменклатуры(ТекСтр.Номенклатура,Объект.ТипЦен).Цена;
	КонецЕсли;
	
	Если ТекСтр.Количество=0 Тогда ТекСтр.Количество=1;КонецЕсли;
	
	РассчитатьСуммы(ТекСтр);
	
КонецПроцедуры

