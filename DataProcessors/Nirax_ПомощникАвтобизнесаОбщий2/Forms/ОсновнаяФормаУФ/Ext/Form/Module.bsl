&НаКлиенте
Процедура ДоставкаСрок(Команда)
	ПоДням = Команда.Имя="ДоставкаДней";
	ЕСли Элементы.Страницы.ТекущаяСтраница=Элементы.ПоискЕмекс Тогда
		Элементы.РезультатПоискаОнлайнДатаДоставки.Видимость  = Не ПоДням;
		Элементы.РезультатПоискаОнлайнДатаМакс.Видимость      = Не ПоДням;
		Элементы.РезультатПоискаОнлайнСрокДоставки.Видимость     = ПоДням;
		Элементы.РезультатПоискаОнлайнСрокДоставкиМакс.Видимость = ПоДням;
	Иначе
		Элементы.ЗаявкаНаОформлениеДатаДоставки.Видимость  = Не ПоДням;
		Элементы.ЗаявкаНаОформлениеДатаМакс.Видимость      = Не ПоДням;
		Элементы.ЗаявкаНаОформлениеСрокДоставки.Видимость     = ПоДням;
		Элементы.ЗаявкаНаОформлениеСрокДоставкиМакс.Видимость = ПоДням;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Если Лев(Объект.Конфигурация,19)<>"УправлениеТорговлей" Тогда
		// ДеРегистрация в ПодключаемоеОборудование
		Попытка
			ПодключаемоеОборудование=Неопределено;
			Попытка
				Выполнить("ПодключаемоеОборудование=?(глПодключаемоеОборудование<>Неопределено,глПодключаемоеОборудование,Неопределено)");
			Исключение КонецПопытки;
			Если ПодключаемоеОборудование<>Неопределено  Тогда
				Индекс=ПодключаемоеОборудование.ПараметрыПодключенияПО.Количество()-1;
				Пока Индекс>=0 Цикл
					Подключение=ПодключаемоеОборудование.ПараметрыПодключенияПО[Индекс];
					Если Подключение.Наименование="Сендер" Тогда
						ПодключаемоеОборудование.ПараметрыПодключенияПО.Удалить(Индекс);
					КонецЕсли;
					Индекс=Индекс-1;
				КонецЦикла;
			КонецЕсли;
		Исключение
			Сообщить(ОписаниеОшибки());
			Возврат;
		Конецпопытки;
    КонецЕсли;
	Сендер=Неопределено; СендерАдрес=Неопределено; СендерЗапросы=Неопределено; ВсеЗаявкиПоставщикуБыли=Неопределено; 
	СендерСв=Неопределено; СендерОтладкаБыла=Неопределено; ПодключаемоеОборудование=Неопределено; 
КонецПроцедуры

