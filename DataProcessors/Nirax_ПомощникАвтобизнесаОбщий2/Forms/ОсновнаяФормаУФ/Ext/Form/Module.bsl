		Если МСтр.Количество()>0 тогда 
			МСтр[0].Статус=?(ПустаяСтрока(Строка.СтатусПозиции),Строка.СтатусЗаказа,Строка.СтатусПозиции);
		КонецЕсли;
	КонецЦикла;
