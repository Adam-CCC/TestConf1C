// ***** Поиск в Кроссах
&НаСервере
Процедура ПоискВКроссах(СписокГрупп)
	СтрокаОриг = Объект.НомерАртикула;
	СтрокаПоиска = ПодготовитьНомер(СтрокаОриг);
	Обработка=РеквизитФормыВЗначение("Объект");
	//Вызовем процедуру поиска
	//ТЗКроссов = Обработка.ПоискПоАртикулуВКроссах(СтрокаПоиска, Предикат, СписокГрупп); 		
	ТЗКроссов = Обработка.ПоискПоАртикулуВКроссах(СтрокаПоиска, Предикат, СписокГрупп, ВидПоискаКросс, Объект.АналогиБК);	
	Если Метаданные.Справочники.Найти("Номенклатура") <> Неопределено Тогда
		Обработка.ПоискВ1С(ТЗКроссов, СтрокаОриг,Объект.ПоШаблону);
	Иначе
		ТЗКроссов.Колонки.Добавить("ВБазе", Новый ОписаниеТипов("Число"));
		ТЗКроссов.Колонки.Добавить("ВКроссах", Новый ОписаниеТипов("Число"));
		ТЗКроссов.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка"));
		ТЗКроссов.Колонки.Добавить("ПорядковыйНомер", Новый ОписаниеТипов("Число"));
		Для каждого Запись ИЗ ТЗКроссов Цикл
			Запись.ВБазе = 0;
			Запись.ВКроссах = 1;
		КонецЦикла;
	КонецЕсли;
	РезультатПоискаТЗ.Загрузить(ТЗКроссов);		
		
	//Заполним список выбора ФильтрМарка
    ТабПоставщики = ТЗКроссов.Скопировать(,"поставщик");
    ТабПоставщики.Свернуть("поставщик");
    Элементы.ФильтрМарка.СписокВыбора.ЗагрузитьЗначения(ТабПоставщики.ВыгрузитьКолонку("поставщик"));
    Элементы.ФильтрМарка.СписокВыбора.СортироватьПоЗначению();
	
	КолСтр=Обработка.ВыводРезультатаПоиска(ТЗКроссов,Результат);
	Элементы.СтраницаПоискПоАртикулу.Заголовок="по Базе Кроссов ("+Строка(КолСтр)+")";	
Конецпроцедуры

