&НаКлиенте
Процедура ВЗаказ(Команда)
	// Проверим наличие отмеченных строк
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	ЕСли ТекДан=Неопределено Тогда Возврат;КонецЕсли;
	
	Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина));
	Если Строки.Количество()=0 Тогда 
		ПоказатьПредупреждение(,"Нет выбранных строк для переноса");
		Возврат;
	КонецЕсли;
	
	// Сформируем список значений для выбора
	Список=Новый СписокЗначений;
	Список.Добавить(-1,"Новая заявка");
	Для Каждого Стр Из Объект.ЗаказыКлиентов Цикл
		Если Стр.Заказ<>ТекДан.Заказ Тогда
			Список.Добавить(Стр.Заказ,Стр.Наименование);
		КонецЕсли;
	КонецЦикла;
	ОО = Новый ОписаниеОповещения("ВЗаказВыбран",ЭтаФорма,Строки);
	//Список.ПоказатьВыборЭлемента(ОО,"Выберите заявку");
	ПараметрыФормы=Новый Структура("СписокЗначений,Групповой,ТекущаяСтрока,Заголовок",
	Список,Ложь,0,"Выберите заявку");
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
	ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,, ОО,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ВЗаказВыбран(Элемент,Строки) Экспорт
	Если Элемент=Неопределено Тогда Возврат;КонецЕсли;
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	
	// Данные для перемещения в заказ
	Данные=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина));
	
	Если Элемент.Значение=-1 Тогда
		// Новый заказ
		Элемент.Значение=НовыйКодТаблицы(Объект.ЗаказыКлиентов,"Заказ");
		Стр=Объект.ЗаказыКлиентов.Добавить();
		ЗаполнитьЗначенияСвойств(Стр,Новый Структура("Заказ,Наименование,Дата,Контрагент,Соглашение,Договор,Склад,ДатаОтгрузки,Статус,Отбор",
		Элемент.Значение,Формат(ТекущаяДата(),"ДФ=дд.ММ.гг ЧЧ:мм")+" / "+Строка(ТекДан.Контрагент),ТекущаяДата(),
		ТекДан.Контрагент, ТекДан.Соглашение,ТекДан.Договор, ТекДан.Склад,ТекДан.ДатаОтгрузки,0,Истина));
		
		// Переносим ссылку на заказа покупателя, если он был создан из корзины
		Если ТекДан.Заказ=0 И ЗначениеЗаполнено(ТекДан.ЗаказПокупателя) Тогда 
			Стр.ЗаказПокупателя=ТекДан.ЗаказПокупателя;
			Массив=Новый Массив;
			Массив.Добавить(ТипЗнч(ТекДан.ЗаказПокупателя));
			Описание=Новый ОписаниеТипов(Массив);
			ТекДан.ЗаказПокупателя=Описание.ПривестиЗначение("");
		КонецЕсли;
	Иначе
		Стр=Объект.ЗаказыКлиентов.НайтиСтроки(Новый структура("Заказ",Элемент.Значение));
		Стр=Стр[0];
	КонецЕсли;
	
	// Удалим строки
	Колво=Строки.Количество();
	Для инд=1 по колво Цикл
		Строка=Строки[Колво-инд];
		Объект.ЗаявкаНаОформление.Удалить(Строка);
	КонецЦикла;
	
	ТекДан.Сумма = Объект.ЗаявкаНаОформление.Итог("Всего");
	Если ТекДан.Заказ = 0 Тогда 
		ОбновитьЗаголовокКорзины();
	КонецЕсли;
	// Смена заявки и пополнение строками
	Элементы.ЗаказыКлиентов.ТекущаяСтрока=Стр.ПолучитьИдентификатор();
	СменитьЗаявку(Стр.Заказ);
	Для Каждого Строка Из Данные Цикл
		Нов = Объект.ЗаявкаНаОформление.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Строка);
		Нов.Заказ = Стр.Заказ;
	КонецЦикла;
	Стр.Сумма = Объект.ЗаявкаНаОформление.Итог("Всего");
	Если Стр.Заказ = 0 Тогда 
		ОбновитьЗаголовокКорзины();
	КонецЕсли;
	СохранитьДанныеПоКорзине(ПользовательКорзины);
	Элементы.ЗаказыКлиентов.ТекущаяСтрока=Стр.ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокКорзины()
	Если Объект.ТекущийЗК=0 Тогда
		Колво=Объект.ЗаявкаНаОформление.Количество();
		Элементы.СтрКорзина.Заголовок="Корзина"+?(Колво=0,""," ("+Колво+")");
	КонецЕсли;
Конецпроцедуры

&НаКлиенте
Функция НовыйКодТаблицы(Таблица,Колонка)
	Код = Таблица.Количество();
	Последний = Таблица[Код-1][Колонка];
	Если Последний>=Код тогда Код=Последний+1;КонецЕсли;
	Отбор=Новый Структура(Колонка,Код);
	Пока Истина Цикл
		Если Таблица.НайтиСтроки(Отбор).Количество()=0 Тогда Прервать;КонецЕсли;
		Отбор[Колонка]=Отбор[Колонка]+1;
	КонецЦикла;
	Возврат Отбор[Колонка];
КонецФункции

&НаКлиенте
Процедура ЗаказыКлиентовПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	Если Лев(ВРЕГ(Элемент.ТекущиеДанные.Наименование),7)="КОРЗИНА" Тогда
		Сообщить("Заказ не может именоваться Корзина");
		Отказ=Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказыКлиентовПриАктивизацииСтроки(Элемент)
	ТекСтр=Элементы.ЗаказыКлиентов.ТекущаяСтрока;
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если ТекДан<>Неопределено И ТекДан.Заказ<>Объект.ТекущийЗК Тогда 
		СменитьЗаявку(ТекДан.Заказ);
		ЕСли Не Элементы.ГруппаДокумент.Видимость Тогда Элементы.ГруппаДокумент.Видимость=Истина;КонецЕсли;
		Элементы.ЗаказыКлиентовВверх.Доступность=ТекДан.Заказ<>0 и ИзменятьКорзину;
		Элементы.ЗаказыКлиентов.ТолькоПросмотр=ТекДан.Заказ=0 или Не ИзменятьКорзину;
		Элементы.ЗаказНаименование.ТолькоПросмотр=ТекДан.Заказ=0 или Не ИзменятьКорзину;
		Элементы.ЗаказСтатус.ТолькоПросмотр=ТекДан.Заказ=0 или Не ИзменятьКорзину;
		Элементы.ЗаказДата.ТолькоПросмотр=ТекДан.Заказ=0 или Не ИзменятьКорзину;
		
		Если Элементы.ЗаказСклад.Видимость И Не ЗначениеЗаполнено(ТекДан.Склад) И ТипЗнч(ТекДан.Склад)<>ТипЗнч(Объект.Склад) Тогда 
			ТекДан.Склад=ОпределитьТип(Объект.Склад).ПривестиЗначение("");
		КонецЕсли;
		Если Элементы.ЗаказДоговор.Видимость И Не ЗначениеЗаполнено(ТекДан.Договор) И ТипЗнч(ТекДан.Договор)<>ТипЗнч(Объект.ДоговорДляЗаявки) Тогда 
			ТекДан.Договор=ОпределитьТип(Объект.ДоговорДляЗаявки).ПривестиЗначение("");
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СписокПользователейКорзины(ПользовательНеВключать)
	Отбор=Новый Структура("КлючОбъекта, КлючНастроек","ПомощникАвтобизнеса","Доступ");
	УстановитьПривилегированныйРежим(Истина);
	Выбор=ХранилищеОбщихНастроек.Выбрать(Отбор);
	Список=Новый СписокЗначений;
	Пока Выбор.Следующий() Цикл;
		Если Выбор.Пользователь<>ПользовательНеВключать Тогда
			Список.Добавить(Выбор.Пользователь, Выбор.Пользователь);
		КонецЕсли;
	КонецЦикла;	
	Возврат Список;
КонецФункции

&НаКлиенте
Процедура КорзинаСменитьПользователя(Команда)
	Список=СписокПользователейКорзины(ПользовательКорзины);
	Если Список.Количество()=0 Тогда Возврат;КонецЕсли;
	ОО=Новый ОписаниеОповещения("ПользовательКорзиныВыбран",ЭтаФорма);
	ПараметрыФормы=Новый Структура("СписокЗначений,Групповой,ТекущаяСтрока,Заголовок",
	Список,Ложь,0,"Выберите пользователя");
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
	ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,, ОО,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПользовательКорзиныВыбран(Элемент,Изменять=Неопределено) Экспорт
	Если Элемент=Неопределено тогда Возврат;КонецЕсли;
	Если ИзменятьКорзину Тогда
		СохранитьДанныеПоКорзине(ПользовательКорзины);
	КонецЕсли;
	ПользовательКорзины=?(ТипЗнч(Элемент)=Тип("Строка"),Элемент,Элемент.Значение);
	ИзменятьКорзину = Изменять=Истина;
	РедактированиеКорзины(ИзменятьКорзину);
	Если Изменять = Неопределено Тогда 
		СендерОтправить("{""action"":""cart"",""name"":"""+ПользовательКорзины+""",""edit"":true}");	
	КонецЕсли;	
	ПользовательКорзиныВыбранНаСервере();
	ЗаказыКлиентовОтборВыполнить(Истина);
	ОбновитьЗаголовокКорзины();
	Элементы.ЗаказыКлиентов.ТекущаяСтрока=Объект.ЗаказыКлиентов[0].ПолучитьИдентификатор();
	ЗаказыКлиентовПриАктивизацииСтроки(Неопределено);
КонецПроцедуры

&НаСервере
Процедура ПользовательКорзиныВыбранНаСервере()
	БылЗК=Объект.ТекущийЗК;
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.ЗагрузитьКорзины(ПользовательКорзины);
	ЗначениеВДанныеФормы(Обработка.ЗаказыКлиентов,Объект.ЗаказыКлиентов);	
	ЗначениеВДанныеФормы(Обработка.ЗаявкаНаОформление,Объект.ЗаявкаНаОформление);	
	МСтр=Объект.ЗаказыКлиентов.НайтиСтроки(Новый Структура("Заказ",БылЗК));
	Если МСтр.Количество()=0 Тогда
		БылЗК=0;
	КонецЕсли;
	Объект.ТекущийЗК=Неопределено;
	СменитьЗаявку(БылЗК);
	ЗаполнитьСтатусыВКорзине(ПользовательКорзины);
КонецПроцедуры

