&НаКлиенте
Процедура УстановитьРежимКлиента(Команда)
	
	Объект.РежимКлиента = НЕ Объект.РежимКлиента;
	ОбновитьПометкиМеню(); 
	Если Объект.РежимКлиента Тогда
		Элементы.РезультатПоискаОнлайнЦена.Видимость               	= НЕ Объект.БлокироватьЦенуПокупки;
		Элементы.РезультатПоискаОнлайнЦенаПродажи.Видимость        	= НЕ Объект.БлокироватьЦенуПродажи;
		Элементы.РезультатПоискаОнлайнИсточникИнформации.Видимость 	= НЕ Объект.БлокироватьПоставщика;
		Элементы.РезультатПоискаОнлайнСклад.Видимость 				= НЕ Объект.БлокироватьПроценкаСклад;
		Элементы.РезультатПоискаОнлайнКратность.Видимость			= НЕ Объект.БлокироватьКратность;
		Элементы.РезультатПоискаОнлайнПроцентОтгрузки.Видимость 	= НЕ Объект.БлокироватьПроцентОтгрузки;
		Элементы.РезультатПоискаОнлайнПроизводитель.Видимость		= НЕ Объект.БлокироватьПроизводителя;
		Элементы.РезультатПоискаОнлайнВозврат.Видимость 			= НЕ Объект.БлокироватьВозврат;

	Иначе
		Элементы.РезультатПоискаОнлайнЦена.Видимость             	= Истина;
		Элементы.РезультатПоискаОнлайнЦенаПродажи.Видимость         = Истина;
		Элементы.РезультатПоискаОнлайнИсточникИнформации.Видимость  = Истина;
		Элементы.РезультатПоискаОнлайнСклад.Видимость 				= Истина;
		Элементы.РезультатПоискаОнлайнКратность.Видимость 			= Истина;
		Элементы.РезультатПоискаОнлайнПроцентОтгрузки.Видимость 	= Истина;
		Элементы.РезультатПоискаОнлайнПроизводитель.Видимость		= Истина;
		Элементы.РезультатПоискаОнлайнВозврат.Видимость 			= Истина;
	КонецЕсли;

КонецПроцедуры

