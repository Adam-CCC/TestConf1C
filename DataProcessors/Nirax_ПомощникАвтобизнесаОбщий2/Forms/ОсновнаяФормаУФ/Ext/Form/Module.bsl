		СендерОтправить("{""table"":""ordered"",""action"":""tran"",""all"":"+?(Объект.ВсеЗаявкиПоставщику,"true","false")
		+",""debug"":"+?(Объект.СендерОтладка,"true","false")+"}"); 
		Элементы.КорзинаСменитьПользователя.Доступность=Объект.ВсеЗаявкиПоставщику;
		// Если пользователь работал с чужой корзиной - вернем его в свою корзину
		Если ПользовательКорзины<>Объект.ПользовательИмя и Не Объект.ВсеЗаявкиПоставщику Тогда
			ПользовательКорзиныВыбран(Объект.ПользовательИмя);
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ЗаказатьЕмекс.Доступность = ПользовательКорзины=Объект.ПользовательИмя ИЛИ Объект.ВсеЗаявкиПоставщику;
	Элементы.ЗаявкаНаОформлениеКнопка3.Доступность = Элементы.ЗаказатьЕмекс.Доступность;
	Если ИмяСобытия = "ОбновитьТЗ" Тогда 
         ОбновитьКолонкиСписковНаСервере(ВсеЗаявкиПоставщикуБыли<>Объект.ВсеЗаявкиПоставщику);//вс() 
		 ИзменитьЭлементыФормы();
	КонецЕсли;
