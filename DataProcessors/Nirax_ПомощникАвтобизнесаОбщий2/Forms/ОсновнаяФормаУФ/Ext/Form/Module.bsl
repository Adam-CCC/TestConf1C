// Возвращает максимальное число из Пар1, Пар2 или Умолч если оба не могут быть числами
Функция МаксЧисло(Знач Пар1, Знач Пар2, Знач Умолч)
	Если ТипЗнч(Пар1)<>Тип("Число") Тогда
		Попытка Пар1=Число(Пар1);Исключение Пар1=Неопределено;Конецпопытки;
	КонецЕсли;
	Если ТипЗнч(Пар2)<>Тип("Число") Тогда
		Попытка Пар2=Число(Пар2);
		Исключение Возврат ?(Пар1=Неопределено,Умолч,Пар1)
		Конецпопытки;
	КонецЕсли;
	Возврат ?(Пар1=Неопределено,Пар2,Макс(Пар1,Пар2));
КонецФункции		


&НаСервере
Процедура ДобавитьВЗаявкуНаСервере(Данные,Запись=Неопределено) Экспорт

	Если Данные=Неопределено тогда возврат;КонецЕсли;
	Если Запись=Неопределено Тогда
		ЕстьПоставщик=Данные.Свойство("Поставщик");
	КонецЕсли;
	
	Если Объект.ТекущийЗК<>0 Тогда 
		СменитьЗаявку(0);
		Элементы.ЗаказыКлиентов.ТекущаяСтрока=Объект.ЗаказыКлиентов[0].ПолучитьИдентификатор();
	КонецЕсли;
	Стр=Объект.ЗаявкаНаОформление.Добавить();
	
	Если Запись=Неопределено Тогда    //вызов с вкладки БК и Прайс-листы
		Стр.Склад=Данные.Склад;
		Если Объект.ЕстьНоменклатура И ЗначениеЗаполнено(Данные.Номенклатура) Тогда
			Стр.Артикул=Данные.Номенклатура.Артикул;
		Иначе
			Стр.Артикул=Данные.Артикул;
		КонецЕсли;
		Если ЕстьПоставщик Тогда
			Стр.Поставщик=Данные.Поставщик;
			Стр.Сайт = Данные.Поставщик;
		КонецЕсли;
	Иначе //вызов с вкладки онлайн-проценка
		ЗаполнитьЗначенияСвойств(Стр,Запись);
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Стр,Данные);
	
	Если НЕ Объект.ЕстьНоменклатура Тогда
		Если Запись <> Неопределено Тогда
			Стр.Наименование = Запись.Наименование;
			Стр.Номенклатура = Запись.Наименование;
		Иначе
			Стр.Наименование = Данные.Номенклатура;
			Стр.Номенклатура = Данные.Номенклатура;
		КонецЕсли;
	Иначе
		Если Данные.Свойство("Номенклатура") Тогда
			Если ТипЗнч(Данные.Номенклатура) = Тип("Строка") Тогда
				Стр.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Запись = Неопределено Тогда
		ТекНоменклатура = Данные.Номенклатура;
		Если ЗначениеЗаполнено(Данные.Номенклатура) Тогда
			Стр.Наименование = ТекНоменклатура;
		КонецЕсли;
	Иначе
		ТекНоменклатура = Запись.Номенклатура;	
	КонецЕсли;
	
	Если Объект.ЕстьНоменклатура Тогда
		Если ЗначениеЗаполнено(ТекНоменклатура) Тогда
			Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("СтавкаНДС")<>Неопределено Тогда
				Стр.СтавкаНдс = ТекНоменклатура.СтавкаНДС; 
			ИначеЕсли Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ВидСтавкиНДС")<>Неопределено Тогда
				Если Метаданные.Имя = "Автосервис" Тогда
					Стр.СтавкаНДС=Справочники.СтавкиНДС.СтавкаНДС(ТекНоменклатура.ВидСтавкиНДС, ТекущаяДатаСеанса());
				Иначе			
					Стр.СтавкаНдс = ТекНоменклатура.ВидСтавкиНДС;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.СтавкаНДС) Тогда
			Стр.СтавкаНДС = Объект.НДСПоУмолчанию;
		КонецЕсли;
	Иначе
		Стр.СтавкаНДС = "20%";
	КонецЕсли;
	
	Если Запись=Неопределено И ЕстьПоставщик Тогда
		Если Данные.Свойство("ЦенаПоставки") Тогда  Стр.ЦенаПоставки=Данные.ЦенаПоставки;КонецЕсли;
		Если Данные.Свойство("СрокДоставки") и ТипЗнч(Данные.СрокДоставки)=Тип("Число") 
			и Данные.СрокДоставки<999 и Данные.СрокДоставки>=0 Тогда
			Стр.СрокДоставки=Данные.СрокДоставки;
			Стр.ДатаДоставки=НачалоДня(ТекущаяДата())+Стр.СрокДоставки*86400;
		Иначе
			Стр.СрокДоставки = "—";
		КонецЕсли;
		Если Данные.Свойство("СрокДоставкиГарантированный") и ТипЗнч(Данные.СрокДоставкиГарантированный)=Тип("Число") 
			и Данные.СрокДоставкиГарантированный<999 и Данные.СрокДоставкиГарантированный>=0 Тогда
			Стр.СрокДоставкиГарантированный=Данные.СрокДоставкиГарантированный;
			Стр.ДатаДоставкиМакс=НачалоДня(ТекущаяДата())+Стр.СрокДоставкиГарантированный*86400;
		Иначе
			Стр.СрокДоставкиГарантированный = "—";
		КонецЕсли;
	КонецЕсли;
	
	Если Запись <> Неопределено Тогда
		Если Запись.ИсточникИнформации = "1C" Тогда
			Стр.СрокДоставки = "—"; //0;
			Стр.СрокДоставкиГарантированный = "—"; //0;
		КонецЕсли;
	КонецЕсли;
	
	РассчитатьСуммы(Стр); 
	//зк(
	Объект.ЗаказыКлиентов[Объект.ТекущийЗК].Сумма = Объект.ЗаявкаНаОформление.Итог("Всего");
	Элементы.СтрКорзина.Заголовок="Корзина"+?(Объект.ЗаявкаНаОформление.Количество()=0,"",
	" ("+Объект.ЗаявкаНаОформление.Количество()+")");
	СохранитьДанныеПоКорзине(); //зк)
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаРасшифровкиНаСервере(Расшифровка, Элемент)
	Если Элемент="Результат" Тогда
		ТабДок=Результат;
	ИначеЕсли Элемент="Результат1" Тогда
		ТабДок=Результат1;
	ИначеЕсли Элемент="РезультатПоДереву" Тогда
		ТабДок=РезультатПоДереву;
	ИначеЕсли Элемент="РезультатПоДереву1" Тогда
		ТабДок=РезультатпоДереву1;
	КонецЕсли;
	//Разберемся, что за расшифровка
	Попытка
		Обработка=РеквизитФормыВЗначение("Объект");
		Если Расшифровка.Действие="СледующаяКартинка" Тогда
			Расшифровка.НомерКартинки=Расшифровка.НомерКартинки+1;
			Обработка.ВыводРасшифровки(Расшифровка.Значение, ТабДок, Расшифровка.НомерКартинки); 
		ИначеЕсли Расшифровка.Действие="ПредыдущаяКартинка" Тогда
			Расшифровка.НомерКартинки=Расшифровка.НомерКартинки-1;
			Обработка.ВыводРасшифровки(Расшифровка.Значение, ТабДок, Расшифровка.НомерКартинки); 
			
		ИначеЕсли Расшифровка.Действие = "ДополнитьИнформацию" Тогда
			
			Обработка.ДополнитьИнформацию(Расшифровка.Значение, Расшифровка.Номенклатура);
		ИначеЕсли Расшифровка.Действие = "РасшифровкаПоАртикулу" Тогда
			НомерКартинки=0;
			Если Элемент="Результат" Тогда
				Обработка.ВыводРасшифровки(Расшифровка.Значение, Результат1, НомерКартинки);
				Элементы.Результат.Видимость=Ложь;
				Элементы.Результат1.Видимость=Истина;
			Иначе
				Обработка.ВыводРасшифровки(Расшифровка.Значение, РезультатПоДереву1, НомерКартинки);
				Элементы.РезультатПоДереву.Видимость=Ложь;
				Элементы.РезультатПоДереву1.Видимость=Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

