	СендерСв.Отладка=Объект.СендерОтладка;
	СендерСв.ВсеЗаявки=Объект.ВсеЗаявкиПоставщику;
	СендерОткрыть();//вс()
	// Присваиваем начальные значения реквизитам
	//Если НЕ (Пред1 ИЛИ Пред2 ИЛИ Пред3 Или Пред4 Или Пред5) Тогда Пред1=Истина;КонецЕсли;
	Пред1=Истина;
	ПредПриИзменении(Неопределено);	
	ИзменениеУровняЦенНаСервере();
	УровеньЦенЕмексПриИзмененииНаСервере();
	Объект.ОбщийПоискВрем=Объект.ОбщийПоиск;
