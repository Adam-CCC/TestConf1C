&НаКлиенте
Процедура ПереносЗаказов(Кнопка)
	Если ПользовательКорзины=Объект.ПользовательИмя ИЛИ НЕ ИзменятьКорзину Тогда Возврат;КонецЕсли;
	Массив=Объект.ЗаявкаПоставщику.НайтиСтроки(Новый Структура("Выбран",Истина));
	ЕстьИзменения=Ложь;
	Для Каждого Стр Из Массив Цикл
		Если Стр.Пользователь<>ПользовательКорзины Тогда Продолжить;КонецЕсли;
		КодСтроки=Формат(Стр.КодСтроки,"ЧГ=;ЧН=");
		Стр.КодСтроки=КодНовойСтрокиПользователя(Объект.ЗаявкаПоставщику,Объект.ПользовательИмя);
		Стр.Пользователь=Объект.ПользовательИмя;
		Стр.Выбран=Ложь;
		Стр1=СтруктураЗаявкаПоставщику();
		ЗаполнитьЗначенияСвойств(Стр1,Стр);
		Строка=СтруктураВСтроку(Стр1);
		СендерОтправить("{""table"":""ordered"",""action"":""edit"",""idData"":"+КодСтроки
		+",""data"":"+Строка+",""name"":"""+ПользовательКорзины+"""}");
		ЕстьИзменения=Истина;
	КонецЦикла;
	Если ЕстьИзменения Тогда
		Пользователи1=Новый Соответствие();
		Пользователи1.Вставить(ПользовательКорзины);
		Пользователи1.Вставить(Объект.ПользовательИмя);
		СохранитьДанныеПоЗаказамПоставщикам(Пользователи1);
	КонецЕсли;
КонецПроцедуры

