&НаКлиенте
Процедура РезультатПоискаОнлайнВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.РезультатПоискаОнлайн.ТекущиеДанные;
	
	Если Поле.Имя = "РезультатПоискаОнлайнКорзина" Тогда
		Если ИзменятьКорзину Тогда     
			Попытка
				ОтборВКорзинуЛокальноНаСервере();
			Исключение
			КонецПопытки;
		Иначе
			Сообщить("Корзина в режиме просмотра - переключите ее в режим изменения");
		КонецЕсли;
	Иначе
		Если ТекДанные.Номенклатура <> Неопределено Тогда
			Если Объект.ЕстьНоменклатура И ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
				Ключ = Новый Структура("Ключ", ТекДанные.Номенклатура);			
				Форма = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Ключ);    			
				Форма.Открыть();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РасчетОстатковНоменклатура(НоменклатураСсылка)     //Не Используется
	
	ЭтоОбъект = РеквизитФормыВЗначение("Объект");
	ТекущиеОстатки = ЭтоОбъект.ПА_ПолучитьСвободныйОстаток(НоменклатураСсылка, Справочники.Склады.ПустаяСсылка());
	НайденаКолонка = "";
	Если ТекущиеОстатки.Колонки.Найти("КоличествоОстаток") <> Неопределено Тогда
		НайденаКолонка = "КоличествоОстаток";
	КонецЕсли;
	Если ТекущиеОстатки.Колонки.Найти("ВНаличии") <> Неопределено Тогда
		НайденаКолонка = "ВНаличии";
	КонецЕсли;
	
	Для Каждого Строка Из ТекущиеОстатки Цикл
		Если НайденаКолонка = "КоличествоОстаток" Тогда
			Кво = Строка.КоличествоОстаток; //ВНаличии;  			
		КонецЕсли;
		Если НайденаКолонка = "ВНаличии" Тогда
			Кво = Строка.ВНаличии; //ВНаличии;  			
		КонецЕсли;
		
			Если Кво = Неопределено или ЗначениеЗаполнено(Кво) = Ложь Тогда
				Кво = 0;
			КонецЕсли;						
	КонецЦикла;  							   
	
	Возврат Кво;
	  
КонецФункции

&НаСервере
Процедура ОстаткиТоваровТестБыл()  //Не Используется
	ЭтоОбъект = РеквизитФормыВЗначение("Объект");
	
	ОтборУсловие = Новый Структура("СтрокаСправочника", 1);	
	Таб = Объект.РезультатПоискаОнлайн.Выгрузить(ОтборУсловие, "Номенклатура"); 	
    Таб.Свернуть("Номенклатура");
	
	Для Каждого Стр Из Таб Цикл			
		
		Остаток = 0;			
		ЦенаПродажиРасчетная = 0;
		
		Остаток = РасчетОстатковНоменклатура(Стр.Номенклатура);
		ЦенаПродажиРасчетная = ЭтоОбъект.ПолучитьЦенуНоменклатуры(Стр.Номенклатура, Объект.ТипЦен);
		    			
		Если (Остаток <> 0) ИЛИ (ЦенаПродажиРасчетная <> 0) Тогда				
			
			Для Каждого Строка Из Объект.РезультатПоискаОнлайн Цикл  													
				Если (Строка.Номенклатура = Стр.Номенклатура) И (Строка.СтрокаСправочника = 1) Тогда						
					
					Если (Остаток <> 0) И (Остаток <> Неопределено) Тогда							
						Строка.Наличие1С = Остаток;
					    Строка.НаличиеНаСкладе = Истина;
					КонецЕсли;
					
					Если ЦенаПродажиРасчетная.Цена <> 0 Тогда   						
						Строка.ЦенаПродажи = ЦенаПродажиРасчетная.Цена;
						//Попытка
						//    Строка.ПроцентПрибыли = Окр( ((Строка.ЦенаПродажи - Строка.Цена)/Строка.Цена * 100), 2);
						//Исключение
						//КонецПопытки						
					КонецЕсли;				
					
					
				КонецЕсли;								
			КонецЦикла; 			
			
		КонецЕсли;
			
						
	КонецЦикла;	
	
КонецПроцедуры

