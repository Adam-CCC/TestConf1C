&НаКлиенте
Процедура СендерОткрыт(Результат,Параметры,ДопПараметры) Экспорт
	
КонецПроцедуры

&НаКлиенте
Процедура СендерОтправить(Данные=Неопределено,Инд=0) Экспорт
	Если Данные<>Неопределено Тогда
		СендерЗапросы.Добавить(Данные);
	КонецЕсли;
	
	Если СендерСв.КС<2 Тогда 
		СендерНачатьВызов();
		Возврат;
	КонецЕсли;
	
	Колво=СендерЗапросы.Количество();
	Пока Инд < Колво И СендерЗапросы[Инд].Пометка=Истина Цикл
		Инд=Инд+1;
	КонецЦикла;
	
	Если Колво<=Инд Тогда Возврат;КонецЕсли;
	
	Если СендерСв.Конец < СендерСв.Первый Тогда
		Ожидание=ТекущаяДата()-СендерСв.Начало-СендерСв.Первый;
		Если Объект.СендерОтладка И СендерСв.Макс<Ожидание Тогда 
			СендерСв.Макс=Ожидание;
			Сообщить("Максимальное время ожидания сек."+СендерСв.Макс);
		КонецЕсли; 
		Если Ожидание>СендерСв.Таймаут Тогда
			СендерПроверитьРаботу();
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	
	Стр=СендерЗапросы[Инд];
	Если ТипЗнч(Стр.Значение)=Тип("Строка") Тогда
		Если Найти(Стр.Значение,"""noReply"":")=0 Тогда
			Значение="{""idMess"":"+Формат(Стр.ПолучитьИдентификатор(),"ЧГ=;ЧН=")
			+","+Сред(Стр.Значение,2);
		Иначе
			Значение=Стр.Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Стр.Значение)=Тип("Структура") Тогда
		Если НЕ Стр.Значение.СВойство("noReply") Тогда
			Стр.Значение.Вставить("idMess",Стр.ПолучитьИдентификатор());
		КонецЕсли;
		ЗаписьJSON=Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет,,,,,,,,Истина));
		ЗаписатьJSON(ЗаписьJSON,Стр.Значение);
		Значение=ЗаписьJSON.Закрыть();
		//Значение=ДанныеВJSON(Стр.Значение);
	Иначе
		СендерЗапросы.Удалить(Стр);
		СендерОтправить(Неопределено,Инд);
		Возврат;
	КонецЕсли;
	
	СендерСв.Первый=ТекущаяДата()-СендерСв.Начало;
	ОО = Новый ОписаниеОповещения("СендерОповещение",ЭтаФорма,Инд);
	Сендер.НачатьВызовSendMessage(ОО,Значение);
	//Если Объект.СендерОтладка Тогда
	//	Сообщить("Отправлено: "+?(СтрДлина(Значение)>100,Лев(Значение,100)+"...}",Значение));
	//КонецЕсли;
	Стр.Представление=Формат(ТекущаяДата()-СендерСв.Начало,"ЧГ=;ЧН=");
	Стр.Пометка=Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СендерПроверитьРаботу() Экспорт
	Если СендерСв.Пинг>0 И СендерСв.Живой Тогда
		Если Объект.СендерОтладка Тогда
			Сообщить("Проверка связи восстановлена после "+СендерСв.Пинг+" обращений к серверу");
		КонецЕсли;
		СендерСв.Пинг=0;
		СендерОтправить();
		Возврат;
	ИначеЕсли СендерСв.Пинг > СендерСв.Повторов И Не СендерСв.Живой Тогда	
		Если Объект.СендерОтладка Тогда
			Сообщить("Потеря связи с сервером, производится переподключение");
		КонецЕсли;
		СендерЗапросы.ЗаполнитьПометки(Ложь);
		СендерСв.Пинг=0;
		СендерЗакрыть(Истина);
		Возврат;
	ИначеЕсли СендерСв.Пинг=0 Тогда
		СендерСв.Живой=Ложь;
	КонецЕсли;
	СендерСв.Пинг = СендерСв.Пинг + 1;
	#Если Не ВебКлиент Тогда
		Сендер.Ping();
	#КонецЕсли
	ПодключитьОбработчикОжидания("СендерПроверитьРаботу", СендерСв.ЖдатьОтвет, Истина);
	
Конецпроцедуры

&НаКлиенте
Процедура СендерОповещение(Результат,Параметры,Инд=0) Экспорт
	Если Объект.СендерОтладка Тогда
		Сообщить("Отправлено в "+Формат(ТекущаяДата(),"ДЛФ=В")+": "
		+?(СтрДлина(Параметры[0])>100,СтрЗаменить(Лев(Параметры[0],100),Символы.ПС,"")+"...}",СтрЗаменить(Параметры[0],Символы.ПС,"")));
	КонецЕсли;
	СендерОтправить(Неопределено,Инд+1);
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Если Лев(Источник,16)<>"WebSocketClient_" Тогда Возврат;КонецЕсли;
	Если СендерСв.Источник <> Источник Тогда
		Если СендерСв.Источник<>"" Тогда
			Сообщить("Неизвестный источник подключения: "+Источник+", текущий: "+СендерСв.Источник);
			Возврат;
		ИначеЕсли Событие<>"Open" Тогда
			Сообщить("Событие: "+Событие+", а подключение: "+Источник+" не открыто");
			СендерЗакрыть(Истина);
			Возврат;
		Иначе
			СендерСв.Источник = Источник;
		КонецЕсли;
	КонецЕсли;
	СендерСв.Живой=Истина;
	СендерСв.Конец=ТекущаяДата()-СендерСв.Начало;
	
	Если Объект.СендерОтладка и Событие<>"TextMessage" Тогда
		Сообщить("Событие: "+Событие+", время : "+СендерСв.Конец);
	КонецЕсли;

	Если Событие="TextMessage" или Событие="BinaryMessage" Тогда
		ОО = Новый ОписаниеОповещения("СендерПрочитать",ЭтаФорма);
		Сендер.НачатьВызовGetMessage(ОО);
	ИначеЕсли Событие="Open" Тогда
		Если Лев(Объект.Конфигурация,19)="УправлениеТорговлей" Тогда
			ПодключаемоеОборудование=Неопределено;
		Иначе	
			// Регистрация в ПодключаемоеОборудование
			Попытка
				Выполнить("ПодключаемоеОборудование=?(глПодключаемоеОборудование<>Неопределено,глПодключаемоеОборудование,Неопределено)");
			Исключение
				ПодключаемоеОборудование=Неопределено;
			Конецпопытки;
		КонецЕсли;
		Попытка
			Если ПодключаемоеОборудование<>Неопределено И ПодключаемоеОборудование.Свойство("ПараметрыПодключенияПО") Тогда
				НетПодключения=Истина;
				Для Каждого Подключение Из ПодключаемоеОборудование.ПараметрыПодключенияПО Цикл
					Если Подключение.Наименование="Сендер" Тогда
						Подключение.ИсточникСобытия=Источник;
						НетПодключения=Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НетПодключения Тогда
					ИменаСобытий=Новый Массив;ИменаСобытий.Добавить("TextMessage");ИменаСобытий.Добавить("Ping");
					ИменаСобытий.Добавить("Pong");ИменаСобытий.Добавить("Error");ИменаСобытий.Добавить("BinaryMessage");
					ИменаСобытий.Добавить("Open");ИменаСобытий.Добавить("Close");
					Подключение=Новый Структура("ИсточникСобытия,ИменаСобытий,ОбъектДрайвера,
					|ОбработчикДрайвераМодуль,Параметры,ПараметрыПодключения,
					|ПоТехнологииРарус,Клиенты,Наименование,КоличествоПодключенных,ИДУстройства",
					Источник,ИменаСобытий,"Сендер",
					ЭтаФорма,Неопределено,Неопределено,
					Ложь,Новый Массив,"Сендер",0,"");
					//ПодключениеСсылка=ПолучитьПустуюСсылку("Справочник","ПодключаемоеОборудование");
					//ЕСли ПодключениеСсылка<>Неопределено Тогда Подключение.Вставить("Ссылка",ПодключениеСсылка);КонецЕсли;
					//ТипОборудования=ПолучитьПустуюСсылку("Перечисление","ТипыПодключаемогоОборудования");
					//ЕСли ТипОборудования<>Неопределено Тогда Подключение.Вставить("ТипОборудования",ТипОборудования);КонецЕсли;
					Для каждого Стр Из ЗаполнитьПодключениеНаСервере() Цикл
						Подключение.Вставить(Стр.Ключ,Стр.Значение);
					КонецЦикла;
					ПодключаемоеОборудование.ПараметрыПодключенияПО.Добавить(Подключение);
				КонецЕсли;
			КонецЕсли;
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
		// Идентификация подключения
		СендерСВ.КС=2;
		Попытка
			СендерЗапросы.Вставить(0,"{""idUser"":"+Формат(ЭтаФорма.КодПользователя,"ЧГ=")+",""idSession"":"
			+Формат(Объект.КодСеанса,"ЧГ=")+",""name"":"""+Объект.ПользовательИмя+""",""id1s"":"+Ид1С()+"}");
			СендерЗапросы.Вставить(1,"{""table"":""ordered"",""action"":""tran"",""all"":"
			+?(Объект.ВсеЗаявкиПоставщику,"true","false")+",""debug"":"+?(Объект.СендерОтладка,"true","false")+"}"); //вс)
			// Сообщаем какие прайсы нужно обновлять
			КодыПрайсов=ПрайсыДляОбновления();
			Если Не ПустаяСтрока(КодыПрайсов) Тогда
				СендерЗапросы.Вставить(2,"{""schema"":""price"",""action"":""waitPrices"",""idPrices"":"""+КодыПрайсов+""",""noReply"":true}");
			КонецЕсли;
		Исключение
		Конецпопытки;
	ИначеЕсли Событие="Error" Тогда
		СендерПроверитьРаботу();
		Возврат;
	КонецЕсли;
	
	Если Событие<>"Error" Тогда
		Если СендерЗапросы.Количество()>0 Тогда
			СендерОтправить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПрайсыДляОбновления()
	Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	КодыПрайсов="";
	Если Проценки.Колонки.Найти("Источник")=Неопределено Тогда Возврат КодыПрайсов;КонецЕсли;
	Строки=Проценки.НайтиСтроки(Новый Структура("Вкл, Источник",Истина, "EMAIL"));
	Если Строки.Количество()>0 Тогда
		Для Каждого Стр Из Строки Цикл
			КодыПрайсов=КодыПрайсов+", "+Сред(Стр.Сайт,3);
		КонецЦикла;
		КодыПрайсов=Сред(КодыПрайсов, 3);
	КонецЕсли;
	Возврат КодыПрайсов;
КонецФункции

&НаСервере
Функция ЗаполнитьПодключениеНаСервере()
	Подключение=Новый Структура;
	Если Метаданные.Справочники.Найти("ПодключаемоеОборудование")<>Неопределено Тогда
		Подключение.Вставить("Ссылка",Справочники.ПодключаемоеОборудование.ПустаяСсылка());
	КонецЕсли;
	Если Метаданные.Перечисления.Найти("ТипыПодключаемогоОборудования")<>Неопределено Тогда
		Подключение.Вставить("ТипОборудования",Перечисления.ТипыПодключаемогоОборудования.ПустаяСсылка());
	КонецЕсли;
	Возврат Подключение;
КонецФункции

&НаКлиенте
Функция ВыполнитьКоманду(Команда, ВходныеПараметры, ВыходныеПараметры,
    ОбъектДрайвера, Параметры, ПараметрыПодключения) Экспорт
	ЕСли ВыходныеПараметры=Неопределено Тогда
		ВыходныеПараметры=Новый Массив;
	КонецЕсли;
	Если Команда="ОбработатьСобытие" Тогда
		Возврат ОбработатьСобытие(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВходныеПараметры[0], 
		ВходныеПараметры[1], ВыходныеПараметры);
	ИначеЕсли Команда="ЗавершитьОбработкуСобытия" Тогда	
		Возврат ЗавершитьОбработкуСобытия(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры);	
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ОбработатьСобытие(ОбъектДрайвера, Параметры, ПараметрыПодключения, Событие, Данные, ВыходныеПараметры) Экспорт
	ВыходныеПараметры.Добавить("Сендер");
	ВыходныеПараметры.Добавить(Новый Массив());
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ЗавершитьОбработкуСобытия(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПоддержкаАсинхронногоРежима() Экспорт
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ОтключитьУстройство(ОбъектДрайвера, Параметры, ПараметрыПодключения, ВыходныеПараметры) Экспорт
	ВыходныеПараметры = Новый Массив();
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура СендерПрочитать(Ответ,Параметры,ДопПараметры) Экспорт
	Если Ответ=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Ответ)=Тип("Строка") Тогда 
		Рез=UnJSON(Ответ,Истина,ИСтина);
		
		Если Рез.Свойство("idMess") Тогда
			СтрСЗ=СендерЗапросы.НайтиПоИдентификатору(Рез.idMess);
			Если СтрСЗ <> Неопределено Тогда
				СендерЗапросы.Удалить(СтрСЗ);
			КонецЕсли;
		КонецЕсли;
		
		Если Рез.Свойство("table") Тогда
			ВнешнееСобытиеТаблиц(Рез);
		Иначе
			Если Рез.Свойство("comment") и (Объект.СендерОтладка ИЛИ Рез.result=Ложь) Тогда
				Сообщить(Рез.comment);
			КонецЕсли;
			Если Рез.Свойство("action") Тогда
				Если Рез.action="ident" Тогда
					Если Рез.result=Истина Тогда
						ОбновитьЗаказанное(Неопределено);
						Если Объект.СендерОтладка Тогда
							Сообщить("Заказанное обновлено");
						КонецЕсли;
						Если ПользовательКорзины<>Объект.ПользовательИмя или Не ИзменятьКорзину Тогда
							СендерОтправить("{""action"":""cart"",""name"":"""+ПользовательКорзины+""",""edit"":"
							+?(ИзменятьКорзину,"true","false")+"}");
						КонецЕсли;
					Иначе
						ОО=Новый ОписаниеОповещения("ЗакрытьФорму",ЭтаФорма);
						ПоказатьПредупреждение(ОО,"Пользователь "+Объект.ПользовательИмя+" уже работает с помощником автобизнеса."
						+Символы.ПС+"Работа нескольких пользователей под одним именем запрещена, так как может повлечь потерю данных.");
					КонецЕсли;
				ИначеЕсли Рез.action="cart" Тогда
					Если Объект.СендерОтладка Тогда Сообщить(Ответ);КонецЕсли;
					Если Рез.Свойство("userEdit") Тогда 
						Сообщить("Пользователь "+Рез.userEdit+" работает с корзиной в режиме изменений");
					КонецЕсли;
					Если Рез.result<>Истина Тогда Возврат;КонецЕсли;
					Если Рез.name=ПользовательКорзины Тогда
						Если Рез.edit<>ИзменятьКорзину Тогда
							ИзменятьКорзину=Рез.edit;
							РедактированиеКорзины(ИзменятьКорзину);
							Если ИзменятьКорзину Тогда
								ПользовательКорзиныВыбранНаСервере();
							КонецЕсли	
						Иначе
							Элементы.ПереносЗаказов.Видимость=ПользовательКорзины<>Объект.ПользовательИмя и Рез.edit=Истина;
						КонецЕсли;
					Иначе
						ПользовательКорзиныВыбран(Рез.name,Рез.edit)
						//Сообщить("Не произошло переключение на корзину пользователя "+рез.name);
					КонецЕсли;
				ИначеЕСли Рез.action="isLicense" Тогда
					ДоступКАналитике=ПроверитьДоступ("Аналитика",Объект.ПользовательИмя);
					Если Рез.result=Истина И Объект.СборАналитики=Истина И ДоступКАналитике=Истина Тогда
						ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ОтчетУФ",
						Новый Структура("Отчет,Код","Аналитика",ЭтаФорма.КодПользователя),ЭтаФорма,"ОтчетУФ");	
					Иначе
						ПоказатьПредупреждение(,"Для получения доступа к Аналитике нужно выполнить следущее: "
						+?(Рез.result=Ложь,Символы.ПС+"- обратитесь к менеджеру для получения лицензии;","")
						+?(Объект.СборАналитики<>Истина,Символы.ПС+"- в Настройках: Корзина и Заказанное включите флаг: ""Сбор аналитики""","")
						+?(ДоступКАналитике<>Истина,Символы.ПС+"- в Настройках: Администрирование включите флаг ""Аналитика"".",""));
					КонецЕсли;
				ИначеЕСли Рез.Свойство("schema") И Рез.schema="pricelists" И (Не Рез.Свойство("result") ИЛИ Рез.result=Истина) Тогда
					Если Рез.action="getPrices" Тогда
						ЕСли ФормыПАОткрыта("НастройкиУФ") Тогда
						// Обновляем информацию по прайс-листам
							ФормыПА.НастройкиУФ.ОбновитьПрайсы(Рез.data);
						КонецЕсли;
					ИначеЕсли Рез.action="getPrice" Тогда
						ЕСли ФормыПАОткрыта("НастройкиУФ") Тогда
							// Обновляем информацию по прайс-листу
							ФормыПА.НастройкиУФ.ОбновлениеДат(Рез.data[0]);
						КонецЕсли;
					ИначеЕсли Рез.action="getUser" Тогда
						ЕСли ФормыПАОткрыта("НастройкиУФ") Тогда
							// выбираем прайс для добавления
							ФормыПА.НастройкиУФ.ВыбратьПрайсДляДобавления(Рез.data);
						КонецЕсли;
					ИначеЕсли Рез.action="add" Тогда
						ЕСли ФормыПАОткрыта("НастройкиУФ") Тогда
							// добавляем прайс
							ФормыПА.НастройкиУФ.ПрайсДобавлен(Рез);
						Конецесли;
					ИначеЕсли Рез.action="update" или Рез.action="getPrice" Тогда
						ЕСли ФормыПАОткрыта("НастройкиУФ")Тогда
							// добавляем прайс
							ФормыПА.НастройкиУФ.ПрайсОбновлен(Рез);
						Конецесли;
					КонецЕсли;
				ИначеЕСли Рез.Свойство("schema") И Рез.schema="mail" И (Не Рез.Свойство("result") ИЛИ Рез.result=Истина) Тогда
					Если Рез.action="getUserEmail" Тогда
						ЕСли ФормыПАОткрыта("ПрайсНастройкаУФ") Тогда
							// добавляем прайс
							ФормыПА.ПрайсНастройкаУФ.ПолучениеАдресовПользователя(Рез.data);
						Конецесли;
					ИначеЕсли Рез.action="getMailServer" Тогда
						ЕСли ФормыПАОткрыта("ПочтаНастройкаУФ") Тогда
							// добавляем прайс
							ФормыПА.ПочтаНастройкаУФ.ПолучениеПочтовыхСерверов(Рез.data);
						Конецесли;
					ИначеЕсли Рез.action="getEmail" Тогда
						ЕСли ФормыПАОткрыта("ПочтаНастройкаУФ") Тогда
							// добавляем прайс
							ФормыПА.ПочтаНастройкаУФ.ПолучениеНастроекПочты(Рез);
						Конецесли;
					ИначеЕсли Рез.action="delEmail" Тогда
						ЕСли ФормыПАОткрыта("ПочтаНастройкаУФ") Тогда
							// добавляем прайс
							ФормыПА.ПочтаНастройкаУФ.ПочтаУдалена();
						Конецесли;
					ИначеЕсли Рез.action="saveEmail" Тогда
						ЕСли ФормыПАОткрыта("ПочтаНастройкаУФ") Тогда
							// добавляем прайс
							ФормыПА.ПочтаНастройкаУФ.ПочтаСохранена(Рез.idMail);
						Конецесли;
					КонецЕсли;
				ИначеЕСли Рез.Свойство("schema") И Рез.schema="price" И (Не Рез.Свойство("result") ИЛИ Рез.result=Истина) Тогда
					Если Рез.action="loadPrice" Тогда
						ЕСли ФормыПАОткрыта("НастройкиУФ") Тогда
							// добавляем прайс
							ФормыПА.НастройкиУФ.ПрайсОбновлен(Рез);
						Иначе
							Сообщить("Обновлен прайс id"+Формат(Рез.idPrice,"ЧЦ=6;ЧВН=;ЧГ="));
						Конецесли;
					ИначеЕсли Рез.action="addPrice" Тогда
						ЕСли ФормыПАОткрыта("НастройкиУФ") Тогда
							// добавляем прайс
							ФормыПА.НастройкиУФ.ПрайсОбновлен(Рез);
						Иначе
							Сообщить("Обновлен прайс id"+Формат(Рез.idPrice,"ЧЦ=6;ЧВН=;ЧГ="));
						Конецесли;
					ИначеЕсли Рез.action="getPrice" Тогда
						ЕСли ФормыПАОткрыта("ПрайсУФ") Тогда
							// загружаем прайс
							ФормыПА.ПрайсУФ.Загрузка(Рез.data);
						Конецесли;
							
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;		

	//Вызываем СендерПрочитать ещё раз, т.к. сообщений в очереди может быть несколько
	ОО = Новый ОписаниеОповещения("СендерПрочитать",ЭтаФорма);
	Сендер.НачатьВызовGetMessage(ОО);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытиеТаблиц(Рез)
	Если Рез.table="ordered" Тогда
		Таблица=Объект.ЗаявкаПоставщику;
	ИначеЕсли Рез.table="analytics.primary" Тогда
		ЕСли ФормыПАОткрыта("ОтчетУФ") Тогда	
			ФормыПА.ОтчетУФ.ЗагрузитьТаблицу(Рез.data);
		КонецЕсли;
		Возврат;
	Иначе
		Сообщить("Таблица "+Рез.table+" не определена, данные Sender не обработаны");
		Возврат;
	КонецЕсли;
	СтрТаб=Таблица.НайтиСтроки(Новый Структура("Пользователь,КодСтроки",Рез.name,Рез.idData));
	
	Если Рез.action="edit" И Рез.name=ПользовательКорзины И Рез.Свойство("status") Тогда
		// Изменение статуса в корзине
		МСтрК=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("КодЗП",Рез.idData));
		Если МСтрК.Количество()>0 Тогда
			МСтрК[0].Статус=Рез.status;
			Если Объект.СендерОтладка Тогда
				Сообщить("В корзине "+Рез.name+" измененился статус на "+Рез.status+" в строке с кодом: "+Рез.idData);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если СтрТаб.Количество()>0 Тогда
		Если Рез.action="del" Тогда
			Таблица.Удалить(СтрТаб[0]);
			Если Объект.СендерОтладка Тогда
				Сообщить("Пользователь "+Рез.name+" удалил строку с кодом: "+Рез.idData);
			КонецЕсли;
		ИначеЕсли Рез.action="edit" Тогда
			Если  Рез.Свойство("data") Тогда
				СтрДата=ЗначениеИзСтрокиНаСервере(Рез.data);
				ЗаполнитьЗначенияСвойств(СтрТаб[0],СтрДата);
				//Если Рез.name<>СтрДата.Пользователь ИЛИ Рез.idData<>СтрДата.КодСтроки Тогда
				//	Сообщить("Ошибка действия "+Рез.action+", пользователь "+Рез.name+"<>"+СтрДата.Пользователь
				//	+" или Код "+Рез.idData+"<>"+СтрДата.КодСтроки);
				//КонецЕсли;
			ИначеЕсли Рез.Свойство("status") Тогда
				// Изменение статуса в заказанном
				СтрТаб[0].СтатусПозиции=Рез.status;
            КонецЕсли;
			Если Объект.СендерОтладка Тогда
				Сообщить("Пользователь "+Рез.name+" изменил строку с кодом: "+Рез.idData);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Рез.action="add" или Рез.action="edit" и Рез.Свойство("data") Тогда
		СтрДата=ЗначениеИзСтрокиНаСервере(Рез.data);
		Нов=Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,СтрДата);
		Нов.КодСтроки=Рез.idData;
		Если Объект.СендерОтладка Тогда
			Сообщить("Пользователь "+Нов.Пользователь+" добавил"+?(Рез.action="add","",", а не изменил")+" строку с кодом: "+Нов.КодСтроки);
		КонецЕсли;
	ИначеЕсли Объект.СендерОтладка Тогда
		Сообщить("Пользователь "+Рез.name+" операция "+Рез.action+" не выполнена для кода строки "+Рез.idData);
	КонецЕсли;
	
	Если Рез.table="ordered" Тогда
		Элементы.Группа10.Заголовок="Заказанное ("+Строка(Объект.ЗаявкаПоставщику.Количество())+")";
	КонецЕсли;
КонецПроцедуры

