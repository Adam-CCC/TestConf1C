	Попытка
	#Если ВебКлиент Тогда
		СендерАдрес = ПолучитьАдресМакета("ВебСендер");
	#Иначе
		СендерАдрес = Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Макет.Сендер";
	#КонецЕсли
		//"ПоместитьВоВременноеХранилище(ПолучитьМакет("Компонента"));
		ОО = Новый ОписаниеОповещения("СендерПодключение",ЭтаФорма);
