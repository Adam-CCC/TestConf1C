&НаКлиенте
// Функция преобразует текст в формате JSON в соответствующие объекты (структуры или соответствия и массивы) и их значения
// Параметры:
//    Текст - текст в формате JSON или Объект ЧтениеJSON c открытым объектом (Файл, поток, Поток в памяти, файловый поток)
//    ЭтоСтруктура - Истина - объекты преобразуются в структуры, Ложь - в соответствия
//       умолчание - Истина      
//    ЕстьДатыСсылки - Если истина - тогда переводит даты форматов: гггг-мм-ддТчч:мм:сс[Z] или @^ггггммддччммсс,
//       где вместо T может быть пробел, а если в конце стоит Z - перевод в универсальную дату
//       и ссылки формат: @^ТипОбъекта.ИмяОбъекта?уникальныйИдентификатор, где ТипОбъекта: Справочник,Документ,
//       ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчетов,ПланОбмена,БизнесПроцесс,Задача
//       умолчание - Ложь      
Функция UnJSON(Текст,ЭтоСтруктура=Истина,ЕстьДатыСсылки=Ложь) Экспорт
	Перем Результат;
	Если ТипЗнч(Текст)<>Тип("Строка") или ПустаяСтрока(Текст) Тогда Возврат Неопределено;КонецЕсли;
	Попытка
	#Если ВебКлиент Тогда
		Результат=UnJSONнаСервере(Текст,ЭтоСтруктура,ЕстьДатыСсылки);
	#Иначе
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Если ЕстьДатыСсылки Тогда
			Результат = ПрочитатьJSON(ЧтениеJSON,Не ЭтоСтруктура,,,"UnJsonRest",ЭтаФорма);
		Иначе
			Результат = ПрочитатьJSON(ЧтениеJSON,Не ЭтоСтруктура);
		КонецЕсли;
		ЧтениеJSON.Закрыть();
	#КонецЕсли
	
	Возврат Результат;
	Исключение
		Сообщить(ОписаниеОшибки()+Символы.ПС+"Будет произведено тестирование и попытка восстановленияь значение из JSON");
		//Возврат UnJsonTest(Текст,ЭтоСтруктура);
	КонецПопытки;
	
КонецФункции

