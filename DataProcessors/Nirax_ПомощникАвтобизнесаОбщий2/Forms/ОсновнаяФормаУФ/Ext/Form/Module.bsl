&НаКлиенте
Процедура ЗаказыКлиентовПередУдалением(Элемент, Отказ)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные;
	Если ТекДан<>Неопределено Тогда
		Если ТекДан.Заказ=0 Тогда 
			Отказ=Истина;
		ИначеЕсли Объект.ЗаявкаНаОформление.Количество()=0 Тогда 
			Объект.ТекущийЗК=0-ТекДан.Заказ;
		Иначе
			ОО=Новый ОписаниеОповещения("ЗаказыКлиентовПередУдалениемОтвет",ЭтаФорма,Элемент);
			ПоказатьВопрос(ОО,"Удалить заявку клиента?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
			Отказ=Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
