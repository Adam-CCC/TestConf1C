	//	+"Запуск предыдущих версий может повлечь потерю данных. Продолжить?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
	Если Версии.Информировать=Истина Тогда
		ПодключитьОбработчикОжидания("ПоказатьОбновлениеВерсии", 0.1, Истина);
		//ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ОписаниеВерсийУФ",,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца).Активизировать();
	КонецЕсли;
	Элементы.ОбновлениеВерсии.Видимость = Версии.Текущая<>Версии.Новая;
	
