&НаКлиенте
Процедура ФильтрМаркаЕмексНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	Если Элементы.ФильтрМаркаЕмекс.СписокВыбора.Количество()=0 Тогда Возврат;КонецЕсли;
	Оповещение=Новый ОписаниеОповещения("ФильтрМаркаЕмексУстановитьВыбор",ЭтаФорма);
	ПараметрыФормы=Новый Структура("СписокЗначений,Групповой,ТекущаяСтрока,Заголовок",
	Элементы.ФильтрМаркаЕмекс.СписокВыбора,Истина,0,"Выбор производителей");
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
	ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ФильтрМаркаЕмексУстановитьВыбор(Список, доп) Экспорт
	Если Список=Неопределено тогда Возврат; КонецЕсли;
	Бренды = Новый Массив;
	Строка="";
	Для Каждого Стр Из Список Цикл
		Если Стр.Пометка и Бренды.Найти(Стр.Значение)=Неопределено Тогда
			Бренды.Добавить(Стр.Значение);
			Строка=Строка+Стр.Значение+";";
			Элементы.ФильтрМаркаЕмекс.СписокВыбора[Список.Индекс(Стр)].Пометка=Истина;
		КонецЕсли;
	КонецЦикла;	
	Объект.ФильтрМаркаЕмекс=Строка;
	Элементы.ФильтрМаркаЕмекс.ОбновитьТекстРедактирования();
	УстановитьОтборФильтр();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрМаркаЕмексОчистка(Элемент, СтандартнаяОбработка)
	Объект.ФильтрМаркаЕмекс="";
	Элементы.ФильтрМаркаЕмекс.СписокВыбора.ЗаполнитьПометки(Ложь);
	УстановитьОтборФильтр();
КонецПроцедуры

&НаКлиенте
Процедура УровеньЦенЕмексПриИзменении(Элемент)
	УровеньЦенЕмексПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура УровеньЦенЕмексПриИзмененииНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.НаценкаЦен(Объект.РезультатПоискаОнлайн, Объект.УровеньЦенЕмекс,Новый Структура("Производитель,Поставщик,Покупка,Продажа",
		"Бренд","Сайт","Цена","ЦенаПродажи"));
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборФильтр()
	Для Каждого Стр из Объект.РезультатПоискаОнлайн Цикл
		Стр.ОтборФильтр = (Не ОтборСокращеннаяВыдача или Стр.ОтборСписок) 	// СокращеннаяВыдачаРезультата
		И (Не ОтборНаличиеНаСкладе или Стр.НаличиеНаСкладе)		  	  		// НаличиеНаСкладе
		И (Не ОтборНаличиеУПоставщика или Стр.НаличиеУПоставщика)       	// НаличиеУПоставщика
		И (ПустаяСтрока(Объект.ФильтрПоставщикЕмекс) или Найти(";"+Объект.ФильтрПоставщикЕмекс+";",";"+Стр.ИсточникИнформации+";")>0) 
		//Стр.ИсточникИнформации=Объект.ФильтрПоставщикЕмекс)      // Поставщик
		И (ПустаяСтрока(Объект.ФильтрМаркаЕмекс) или Найти(";"+Объект.ФильтрМаркаЕмекс+";",";"+Стр.Бренд+";")>0); //Бренд
	КонецЦикла;
	Элементы.РезультатПоискаОнлайн.ОтборСтрок=Новый ФиксированнаяСтруктура("ОтборФильтр",Истина);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовСтраницыПоискаПоАвтомобилю

&НаКлиенте
Процедура ТипАвтоПриИзменении(Элемент)
	Если ТипАвто="коду двигателя" Тогда
		Элементы.НомерVIN.Видимость=Ложь;
		Элементы.НайтиПоВин.Видимость=Ложь;
		Элементы.ФильтрМодельАвто.Видимость=Ложь;
		Элементы.ФильтрФирмаАвто.Видимость=Истина;
		Элементы.КодДвигателя.Видимость=Истина;
	ИначеЕсли ТипАвто="VIN номеру" Тогда
		Элементы.ФильтрМодельАвто.Видимость=Ложь;
		Элементы.КодДвигателя.Видимость=Ложь;
		Элементы.ФильтрФирмаАвто.Видимость=Ложь;
		Элементы.НомерVIN.Видимость=Истина;
		Элементы.НайтиПоВин.Видимость=Истина;
		НомерVIN="";
		Элементы.РезультатУзлы.Доступность=Ложь;
		Возврат;
	Иначе
		Элементы.НомерVIN.Видимость=Ложь;
		Элементы.НайтиПоВин.Видимость=Ложь;		
		Элементы.КодДвигателя.Видимость=Ложь;
		Элементы.ФильтрФирмаАвто.Видимость=Истина;
		Элементы.ФильтрМодельАвто.Видимость=Истина;
		Если ТипАвто="" Тогда
			ТипАвто="всем автомобилям";
		КонецЕсли;
	КонецЕсли;
	Элементы.ФильтрФирмаАвто.СписокВыбора.Очистить();
	ФильтрФирмаАвто="";
	КодДвигателя="";
	НомерVIN="";
	Состояние("Производится загрузка списка торговых марок. Пожалуйста подождите.");
	
	//Элементы.ФильтрФирмаАвто.СписокВыбора.ВыбратьЭлемент();
	Элементы.ФильтрМодельАвто.СписокВыбора.Очистить();
	Элементы.ФильтрМодельАвто.Доступность=Ложь;
	Элементы.ЗагрузитьПоМодели.Доступность=Ложь;
	Элементы.РезультатУзлы.Доступность=Истина;

	//Вызовем процедуру вывода марок
	ВыводМарокАвтоНаСервере();
	Состояние();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрФирмаАвтоПриИзменении(Элемент)
	КодДвигателя="";	
	Если ФильтрФирмаАвто="" Тогда	
		Элементы.ФильтрМодельАвто.СписокВыбора.Очистить(); 
		ФильтрМодельАвто = "";
		Элементы.ФильтрМодельАвто.Доступность=Ложь;
		Элементы.ЗагрузитьПоМодели.Доступность=Ложь;
		Состояние("Производится загрузка списка торговых марок.       Ж Д И Т Е . . .");
		ВыводМарокАвтоНаСервере();
	Иначе
		ФильтрМодельАвто="";
		Состояние("Производится загрузка марок автомобилей.        Ж Д И Т Е . . .");
		ВыводОтфильтрованныхМарокАвтоНаСервере();
		Элементы.ФильтрМодельАвто.Доступность=Истина;
	КонецЕсли;
	Состояние();
	
КонецПроцедуры

&НаСервере
Процедура ВыводМарокАвтоНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ВыводМарокАвто(ТипАвто,РезультатУзлы,Элементы.ФильтрФирмаАвто.СписокВыбора,ТЗДляФильтраМарок);
КонецПроцедуры

&НаСервере
Процедура ВыводОтфильтрованныхМарокАвтоНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	МСтрФирма=ТЗДляФильтраМарок.НайтиСтроки(Новый Структура("MFA_BRAND",ФильтрФирмаАвто));
	Если НРЕГ(Лев(ТипАвто,1))="к" Тогда
		Обработка.ВыводОтфильтрованныхМарокАвто(МСтрФирма[0],РезультатУзлы,Элементы.КодДвигателя.СписокВыбора,Истина);
	Иначе
		Обработка.ВыводОтфильтрованныхМарокАвто(МСтрФирма[0],РезультатУзлы,Элементы.ФильтрМодельАвто.СписокВыбора);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КодДвигателяПриИзменении(Элемент)
	Состояние("Производится загрузка комплектаций автомобилей.         Ж Д И Т Е . . .");
	УзлыОбработкаНаСервере(Новый Структура("Действие,Значение", "РасшифровкаДвигателя", КодДвигателя), Неопределено);
	Состояние();
КонецПроцедуры

&НаСервере
Процедура УзлыОбработкаНаСервере( Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	Попытка
		Если Расшифровка.Действие="РасшифровкаМодели" Тогда
			//Запомним таблицу до расшифровки
			Если РезультатУзлы.Область(2,1,2,1).Текст<>"Типы комплектаций:" Тогда
				РезультатМарокДляВозврата.Очистить();
				РезультатМарокДляВозврата.Вывести(РезультатУзлы);
				РезультатМарокДляВозврата.ТекущаяОбласть=Элементы.РезультатУзлы.ТекущаяОбласть;
			КонецЕсли;
			ФильтрМодельАвто=Элементы.РезультатУзлы.ТекущаяОбласть.Текст;
			Обработка = РеквизитФормыВЗначение("Объект");
			Обработка.ВыводТаблицыТипов(Расшифровка.Значение, РезультатУзлы);
		ИначеЕсли Расшифровка.Действие="РасшифровкаБренда" Тогда
			//Запомним таблицу до расшифровки
			ФильтрФирмаАвто=Расшифровка.Значение;
			ФильтрМодельАвто="";
			ВыводОтфильтрованныхМарокАвтоНаСервере();
			Элементы.ФильтрМодельАвто.Доступность=Истина;
		ИначеЕсли Расшифровка.Действие="НазадКМаркам" Тогда
			//вернем таблице исходный марочный вид
			РезультатУзлы.Очистить();
			РезультатУзлы.Вывести(РезультатМарокДляВозврата);
			Элементы.РезультатУзлы.ТекущаяОбласть=РезультатМарокДляВозврата.ТекущаяОбласть;
		ИначеЕсли Расшифровка.Действие="РасшифровкаОписания" Тогда
			Элементы.Группа4.Видимость=Ложь;
			Элементы.Группа5.Видимость=Истина;
			Обработка = РеквизитФормыВЗначение("Объект");
			Обработка.ВыводУзлов(Расшифровка.Значение, РезультатПоДереву, УзловоеДерево);
			ТипАвтоИзТаблицыТипов = Расшифровка.Значение;
			РезультатПоДереву.Очистить();
		ИначеЕсли Расшифровка.Действие="РасшифровкаДвигателя" Тогда
			Если РезультатУзлы.Область(2,1,2,1).Текст<>"Типы комплектаций:" Тогда
				РезультатМарокДляВозврата.Очистить();
				РезультатМарокДляВозврата.Вывести(РезультатУзлы);
				РезультатМарокДляВозврата.ТекущаяОбласть=Элементы.РезультатУзлы.ТекущаяОбласть;
			КонецЕсли;
			Если КодДвигателя<>Расшифровка.Значение Тогда КодДвигателя=Расшифровка.Значение;КонецЕсли;
			Обработка = РеквизитФормыВЗначение("Объект");
			Обработка.ВыводТаблицыТипов(Расшифровка.Значение, РезультатУзлы,Истина);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ФильтрМодельАвтоПриИзменении(Элемент)
	
	Если Элемент.ВыделенныйТекст="" Тогда	
		Состояние("Производится загрузка марок автомобилей.        Ж Д И Т Е . . .");
		ВыводОтфильтрованныхМарокАвтоНаСервере();
		Элементы.ЗагрузитьПоМодели.Доступность=Ложь;
	Иначе
		Состояние("Производится загрузка модели автомобиля.        Ж Д И Т Е . . .");
		ФильтрМодельАвтоПриИзмененииНаСервере();
		Элементы.ЗагрузитьПоМодели.Доступность=Истина;
	КонецЕсли;
	Состояние();
	
КонецПроцедуры

Процедура ФильтрМодельАвтоПриИзмененииНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ВыводОтфильтрованныхМоделейАвто(ФильтрФирмаАвто,ФильтрМодельАвто,РезультатУзлы,ТЗДляФильтраМарок);
	Элементы.РезультатУзлы.ТекущаяОбласть=РезультатУзлы.Область(1,1,1,1);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатУзлыОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	Если Расшифровка=Неопределено тогда
		Если ТипЗнч(Элемент.ТекущаяОбласть)=Тип("РисунокТабличногоДокумента") тогда
			Расшифровка=Элемент.ТекущаяОбласть.Расшифровка;
		иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Если Расшифровка.Действие="ЗагрузитьПоКомплектации" Тогда
		Состояние("Производится загрузка комплектующих автомобиля.  Ж Д И Т Е . . .");
		ПараметрыФормы=Новый Структура("Комплект", Расшифровка.Значение);
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаЗагрузкиУФ",ПараметрыФормы,ЭтаФорма);
	Иначе
		Состояние("Производится загрузка комплектаций автомобилей.         Ж Д И Т Е . . .");
		УзлыОбработкаНаСервере(Расшифровка, СтандартнаяОбработка);
	КонецЕсли;
	Состояние();
	
КонецПроцедуры

&НаКлиенте
Процедура УзловоеДеревоПриАктивизацииСтроки(Элемент)
	
	попытка
		Если Элементы.УзловоеДерево.ТекущиеДанные<>Неопределено И Элементы.УзловоеДерево.ТекущиеДанные.ПолучитьЭлементы().Количество()=0 Тогда
			Если Элемент.ТекущиеДанные.Айди <> ОбработанныйУзелАйди или ОбработанныйУзелАйди="" тогда
				Элементы.РезультатПоДереву1.Видимость=Ложь;
				Элементы.РезультатПоДереву.Видимость=Истина;
				ОбработанныйУзелАйди=Элементы.УзловоеДерево.ТекущиеДанные.Айди;
				Состояние("Производится загрузка данных о комплектующих.     Ж Д И Т Е . . .");
				ПриАктивизацииНаСервере(Число(Элемент.ТекущиеДанные.айди));
				Состояние();
			КонецЕсли;
		КонецЕсли;
	Исключение
		сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере                
Процедура ПриАктивизацииНаСервере(ТекДан) Экспорт
	РезультатПоДереву.Очистить();
	Обработка = РеквизитФормыВЗначение("Объект");
	ТЗРасшифровкаУзлов="";
	Обработка.ВыводРезультатаПоУзлам(ТЗРасшифровкаУзлов, РезультатПоДереву, ТекДан, 
	Элементы.РезультатУзлы.ТекущаяОбласть.Расшифровка.Значение);
КонецПроцедуры

&НаКлиенте
Процедура РезультатПоДеревуОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
КонецПроцедуры

&НаКлиенте
Процедура РезультатПоДереву1ОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
КонецПроцедуры

&НаСервере
Процедура НайтиПоВинНаСервере(Вин)
	//РезультатПоДереву.Очистить();
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ВыводТаблицыТипов(Вин, РезультатУзлы,2);
	Элементы.РезультатУзлы.ТекущаяОбласть=РезультатУзлы.Область(1,1,1,1);
КонецПроцедуры

&НаКлиенте
Процедура НайтиПоВин(Команда)
	НомерVIN=СокрЛП(ВРЕГ(НомерVIN));
	Если СтрДлина(НомерVIN)<>17 Тогда
		ПоказатьПредупреждение(,"VIN номер должен содержать 17 символов, а в наличии "+СтрДлина(НомерVIN));
		Возврат;
	КонецЕсли;
	НайтиПоВинНаСервере(НомерVIN);
	Элементы.РезультатУзлы.Доступность=Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовСтраницыКорзина

// Функция возвращает структуру с ключами "ДоговорПустой" - Пустая ссылка на договор,
// "Текст" - текст запроса без начальной фразы: "ВЫБРАТЬ РАЗРЕШЕННЫЕ [ПЕРВЫЕ 1]"
// Если КонтрагентЗадан   = Истина - тогда в запрос включается отбор по контрагенту
// Если ОрганизацияЗадана = Истина - тогда в запрос включается отбор по организации
// Результат запроса содержит только 1 реквизит: Договор - ссылка на договор.
//
&НаСервереБезКонтекста
Функция СформироватьЗапросДоговора(КонтрагентЗадан, ОрганизацияЗадана)
	Если Метаданные.Справочники.Найти("ДоговорыКонтрагентов") <> Неопределено Тогда
		Мета=Метаданные.Справочники.ДоговорыКонтрагентов;
		Договоры="ДоговорыКонтрагентов";
		ДоговорПустой=Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ИначеЕсли Метаданные.Справочники.Найти("ДоговорыВзаиморасчетов") <> Неопределено Тогда
		Мета=Метаданные.Справочники.ДоговорыВзаиморасчетов;
		Договоры="ДоговорыВзаиморасчетов";
		ДоговорПустой=Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	Иначе Возврат Неопределено; 
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("Контрагент")<>Неопределено Тогда 
		ИмяКонтрагент="Контрагент";
	ИначеЕсли Мета.Владельцы.Содержит(Метаданные.Справочники.Контрагенты) Тогда
		ИмяКонтрагент="Владелец";
	Иначе Возврат "";
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("ВидДоговора")<>Неопределено ТОгда
		ВидДоговора=Новый Структура("Имя, Значение", "ВидДоговора"); 
		Если Метаданные.Перечисления.ВидыДоговоров.ЗначенияПеречисления.Найти("СПокупателем")<>Неопределено Тогда
			ВидДоговора.Значение="ВидыДоговоров.СПокупателем";
		ИначеЕсли Метаданные.Перечисления.ВидыДоговоров.ЗначенияПеречисления.Найти("Продажа")<>Неопределено Тогда
			ВидДоговора.Значение="ВидыДоговоров.Продажа";
		Иначе
			ВидДоговора=Неопределено;
		КонецЕсли;
	ИначеЕсли Мета.Реквизиты.Найти("ТипДоговора")<>Неопределено
		И Метаданные.Перечисления.ТипыДоговоров.ЗначенияПеречисления.Найти("СПокупателем")<>Неопределено Тогда
		ВидДоговора=Новый Структура("Имя, Значение", "ТипДоговора", "ТипыДоговоров.СПокупателем");
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("Дата")<>Неопределено ТОгда
		Дата="Дата";
	ИначеЕсли Мета.Реквизиты.Найти("ДатаДоговора")<>Неопределено ТОгда
		Дата="ДатаДоговора";
	Иначе
		Дата=Неопределено;
	КонецЕсли;
		
	ЕстьОсновной=Метаданные.РегистрыСведений.Найти("ОсновныеДоговорыКонтрагента")<>Неопределено;
	
	Текст="
		|Договоры.Ссылка КАК Договор" + ?(ЕстьОсновной,",
		|	НЕ ОсновныеДоговорыКонтрагента.Договор ЕСТЬ NULL КАК Основной","") + "
		|ИЗ
		|	Справочник."+Договоры+" КАК Договоры" + ?(ЕстьОсновной,"
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДоговорыКонтрагента КАК ОсновныеДоговорыКонтрагента
		|		ПО Договоры.Ссылка = ОсновныеДоговорыКонтрагента.Договор","")+ "
		|ГДЕ "+?(КонтрагентЗадан, "
		|	Договоры."+ИмяКонтрагент+" = &Контрагент","ИСТИНА")+?(ОрганизацияЗадана,"
		|	И Договоры.Организация = &Организация","")+ ?(ВидДоговора=Неопределено,"","
		|	И Договоры."+ВидДоговора.Имя+" = ЗНАЧЕНИЕ(Перечисление."+ВидДоговора.Значение+")")
		+ ?(Мета.Реквизиты.Найти("ДатаКонца")=Неопределено,""," 
		|	И (Договоры.ДатаКонца >= &ТекущаяДата ИЛИ Договоры.ДатаКонца = ДАТАВРЕМЯ(1, 1, 1))")
		+ ?(Мета.Реквизиты.Найти("ДатаОкончанияДействия")=Неопределено,""," 
		|	И (Договоры.ДатаОкончанияДействия >= &ТекущаяДата ИЛИ Договоры.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))")
		+ ?(Дата=Неопределено,"","
	    |УПОРЯДОЧИТЬ ПО " + ?(ЕстьОсновной,"
		|	Основной УБЫВ,","") + "
		|	Договоры."+Дата+" УБЫВ");
		
	Возврат Новый Структура("Текст,ДоговорПустой", Текст,ДоговорПустой); 
КонецФункции

&НаСервереБезКонтекста
Функция ЗаказКонтрагентПриИзмененииНаСервере(Контрагент, Организация)
	Рез=Новый Структура();
	ТелоЗапроса = СформироватьЗапросДоговора(ИСТИНА,ЗначениеЗаполнено(Организация));
	Если ТелоЗапроса= Неопределено тогда Возврат Рез; КонецЕсли;
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 "+ТелоЗапроса.Текст);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Запрос.УстановитьПараметр("Организация",Организация);
	ВЫб=Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() ТОгда
		Рез.Вставить("Договор", Выб.Договор);
	Иначе
		Рез.Вставить("Договор", ТелоЗапроса.ДоговорПустой);
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("СоглашенияСКлиентами")<>Неопределено Тогда
		Запрос=Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СоглашенияСКлиентами.Ссылка КАК Соглашение
			|ИЗ
			|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
			|ГДЕ
			|	СоглашенияСКлиентами.Организация = &Организация
			|	И СоглашенияСКлиентами.Контрагент = &Контрагент
			|
			|УПОРЯДОЧИТЬ ПО
			|	СоглашенияСКлиентами.Дата УБЫВ"
		);
		Запрос.УстановитьПараметр("Контрагент", Контрагент); //ДляЗаявки);	
		Запрос.УстановитьПараметр("Организация",Организация);
		Выб=Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() ТОгда
			Рез.Вставить("Соглашение", Выб.Соглашение);
		Иначе
			Рез.Вставить("Соглашение", Справочники.СоглашенияСКлиентами.ПустаяСсылка());
		КонецЕсли;
	КонецЕсли;	
	Возврат Рез;
КонецФункции

&НаКлиенте
Процедура ЗаказКонтрагентПриИзменении(Элемент)
	Если Элементы.ЗаказДоговор.Видимость = Ложь Тогда Возврат; КонецЕсли;
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные; 
	Если ЗначениеЗаполнено(ТекДан.Контрагент) Тогда
		Рез=ЗаказКонтрагентПриИзмененииНаСервере(ТекДан.Контрагент,Объект.ОрганизацияДляЗаявки);
		Если Рез.Свойство("Соглашение") И Рез.Соглашение.Пустая() Тогда
			Рез.Соглашение = Объект.ТиповоеСоглашение;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекДан,Рез);
	Иначе
		Мас=Новый Массив; Мас.Добавить(ТипЗнч(Объект.ДоговорДляЗаявки));
		Описание=Новый ОписаниеТипов(Мас);
		ТекДан.Договор=Описание.ПривестиЗначение("");
		Если Элементы.ЗаказСоглашение.Видимость Тогда
			ТекДан.Соглашение=Объект.ТиповоеСоглашение;
		КонецЕсли;
	КонецЕсли;
	ЗаказПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентДляЗаявкиПриИзменении(Элемент)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные; 
	ТекДан.Контрагент = Объект.КонтрагентДляЗаявки;
	ЗаказКонтрагентПриИзменении(Элемент);
	Возврат;
	
	ПараметрыВыбора=новый Массив();
	Если (Объект.Конфигурация="УправлениеНебольшойФирмой 1.6") Тогда
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Организация",Объект.ОрганизацияДляЗаявки));
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Контрагент",Объект.КонтрагентДляЗаявки));
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("КонтролироватьВыборДоговора",Истина));
	ИначеЕсли (Лев(Объект.Конфигурация,9) = "Автосалон") Тогда
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Организация",Объект.ОрганизацияДляЗаявки));
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Владелец",Объект.КонтрагентДляЗаявки));
	Иначе
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Организация",Объект.ОрганизацияДляЗаявки));
		Если Лев(Объект.Конфигурация,22)="УправлениеТорговлей 11" ИЛИ Лев(Объект.Конфигурация,33) = "УправлениеТорговлейДляУкраины 3.0" Тогда
			Если ЗначениеЗаполнено(Объект.КонтрагентДляЗаявки) Тогда
				ПартнерДляОтбора = НайтиЗначениеПартнераПоКонтрагенту(Объект.КонтрагентДляЗаявки);
				Если ЗначениеЗАполнено(ПартнерДляОтбора) Тогда
					ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Партнер",ПартнерДляОтбора));
				Иначе
					ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Контрагент",Объект.КонтрагентДляЗаявки));
				КонецЕсли;
			КонецЕсли;
		Иначе
			ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.Контрагент",Объект.КонтрагентДляЗаявки));
		КонецЕсли;
	КонецЕсли;
	Если Элементы.Соглашение.Видимость Тогда
		Если ЗначениеЗаполнено(Объект.ТиповоеСоглашение) Тогда
			Объект.Соглашение = Объект.ТиповоеСоглашение;	
		Иначе
			Элементы.Соглашение.ПараметрыВыбора=Новый ФиксированныйМассив(ПараметрыВыбора);
			Мас=Новый Массив();Мас.Добавить(ТипЗнч(Объект.Соглашение));
			ОТип=Новый ОписаниеТипов(Мас);
			Объект.Соглашение=ОТип.ПривестиЗначение("");
		КонецЕсли;
	КонецЕсли;
	Элементы.ДоговорДляЗаявки.ПараметрыВыбора=Новый ФиксированныйМассив(ПараметрыВыбора);
	Мас=Новый Массив();Мас.Добавить(ТипЗнч(Объект.ДоговорДляЗаявки));
	ОТип=Новый ОписаниеТипов(Мас);
	Объект.ДоговорДляЗаявки=ОТип.ПривестиЗначение("");
	Если (Лев(Объект.Конфигурация,9) = "Автосалон") Тогда
		Объект.ДоговорДляЗаявки = ЗаполнитьДоговорАА6(Объект.ОрганизацияДляЗаявки, Объект.КонтрагентДляЗаявки);		
	КонецЕсли;
	//зк(
	Если ТекДан<>Неопределено Тогда
		ТекДан.Контрагент=Объект.КонтрагентДляЗаявки;
		ТекДан.Соглашение=Объект.Соглашение;
		ТекДан.Договор=Объект.ДоговорДляЗаявки;
	КонецЕсли; 
	ЗаказКлиентаПриИзменении(Элемент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаказДоговорНачалоВыбораНаСервере(ДанныеВыбора, Контрагент, Организация)
	ТелоЗапроса = СформироватьЗапросДоговора(ЗначениеЗаполнено(Контрагент),ЗначениеЗаполнено(Организация));
	Если ТелоЗапроса= Неопределено тогда Возврат; КонецЕсли;
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ "+ТелоЗапроса.Текст);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Запрос.УстановитьПараметр("Организация",Организация);
	ДанныеВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Договор"));
КонецПроцедуры

&НаКлиенте
Процедура ЗаказДоговорНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные; 
	ДанныеВыбора=Новый СписокЗначений;
	ЗаказДоговорНачалоВыбораНаСервере(ДанныеВыбора, ТекДан.Контрагент, Объект.ОрганизацияДляЗаявки);
	Если ДанныеВыбора.Количество()>0 Тогда
		СтандартнаяОбработка=Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказДоговорСозданиеЗаписать(Рез,Рекв) Экспорт
	Если Рекв<>Неопределено И Не Рекв.Объект.Ссылка.Пустая() Тогда
		Элементы.ЗаказыКлиентов.ТекущиеДанные.Договор=Рекв.Объект.Ссылка;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаказДоговорСозданиеНаСервере(Контрагент)
	Если Метаданные.Справочники.Найти("ДоговорыКонтрагентов") <> Неопределено Тогда
		Мета=Метаданные.Справочники.ДоговорыКонтрагентов;
		Договоры="ДоговорыКонтрагентов";
		ДоговорПустой=Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	ИначеЕсли Метаданные.Справочники.Найти("ДоговорыВзаиморасчетов") <> Неопределено Тогда
		Мета=Метаданные.Справочники.ДоговорыВзаиморасчетов;
		Договоры="ДоговорыВзаиморасчетов";
		ДоговорПустой=Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	Иначе Возврат Неопределено; 
	КонецЕсли;
	
	Рекв=Новый Структура("ДоговорПустой,ДоговорИмя",ДоговорПустой,Договоры);
	Если ЕстьРеквизит1С(Мета,"Контрагент") Тогда 
		Рекв.Вставить("Контрагент",Контрагент);
	ИначеЕсли Мета.Владельцы.Содержит(Метаданные.Справочники.Контрагенты) Тогда
		Рекв.Вставить("Владелец",Контрагент);
	Иначе Возврат Неопределено;
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("Партнер")<>Неопределено Тогда 
		Рекв.Вставить("Партнер",Контрагент.Партнер);
	КонецЕсли;
	
	Рекв.Вставить("Наименование",Строка(Контрагент)+" - договор продажи");
	Рекв.Вставить("Организация",Объект.ОрганизацияДляЗаявки);
	
	Если Метаданные.ПараметрыСеанса.Найти("ТекущийПользователь")<>Неопределено Тогда
	   Пользователь = ПараметрыСеанса.ТекущийПользователь;
	ИначеЕсли Метаданные.ПараметрыСеанса.Найти("Пользователь")<>Неопределено Тогда
	    Пользователь=ПараметрыСеанса.Пользователь;
	ИначеЕсли Метаданные.ПараметрыСеанса.Найти("АвторизованныйПользователь")<>Неопределено Тогда
	    Пользователь=ПараметрыСеанса.АвторизованныйПользователь;
	Иначе
		Пользователь=Неопределено;
	КонецЕсли;
	
	Если ЕстьРеквизит1С(Мета,"Автор",Тип("СправочникСсылка.Пользователи")) Тогда
		Рекв.Вставить("Автор",Пользователь);
	КонецЕсли;
	
	Если ЕстьРеквизит1С(Мета,"Менеджер",Тип("СправочникСсылка.Пользователи")) Тогда
		Рекв.Вставить("Менеджер",Пользователь);
	ИначеЕсли Метаданные.Справочники.Найти("Сотрудники")<>Неопределено И 
		ЕстьРеквизит1С(Мета,"Менеджер",Тип("СправочникСсылка.Сотрудники"))И
		Метаданные.Справочники.Пользователи.Реквизиты.Найти("Сотрудник")<>Неопределено Тогда
		Рекв.Вставить("Менеджер",Пользователь.Сотрудник);
	КонецЕсли;
	
	//Подразделение
	Если ЕстьРеквизит1С(Мета,"ПодразделениеКомпании") Тогда
		рПодразделение="ПодразделениеКомпании";
	ИначеЕсли Мета.Реквизиты.Найти("Подразделение")<>Неопределено Тогда
		рПодразделение="Подразделение";
	КонецЕсли;
	Если рПодразделение<>Неопределено Тогда	
		Если Метаданные.ПараметрыСеанса.Найти("ПодразделениеКомпании")<>Неопределено Тогда
			Подразделение=ПараметрыСеанса.ПодразделениеКомпании;
		ИначеЕсли Пользователь<>Неопределено И Пользователь.Метаданные().Реквизиты.Найти("ТекущееПодразделение")<>Неопределено Тогда
			Подразделение=Пользователь.ТекущееПодразделение;
		ИначеЕсли Пользователь<>Неопределено И Пользователь.Метаданные().Реквизиты.Найти("Подразделение")<>Неопределено Тогда
			Подразделение=Пользователь.Подразделение;
		ИначеЕсли Метаданные.Справочники.Найти("СтруктурныеЕдиницы")<>Неопределено Тогда
			Попытка Подразделение=Справочники.СтруктурныеЕдиницы.ОсновноеПодразделение; Исключение Конецпопытки;
		КонецЕсли;
		Если Подразделение <> Неопределено Тогда
			Рекв.Вставить(рПодразделение,Подразделение);
		КонецЕсли;
	КонецЕсли;
	
	//Согласован
	Если Мета.Реквизиты.Найти("Согласован")<>Неопределено Тогда
		Рекв.Вставить("Согласован",Истина);
	КонецЕсли;
	
	//Статус=Перечисления.СтатусыДоговоровКонтрагентов.Действует
	Если Метаданные.Перечисления.Найти("СтатусыДоговоровКонтрагентов")<>Неопределено И ЕстьРеквизит1С(Мета,"Статус",Тип("ПеречислениеСсылка.СтатусыДоговоровКонтрагентов")) Тогда
		Рекв.Вставить("Статус",Перечисления.СтатусыДоговоровКонтрагентов.Действует);
	КонецЕсли;
	
	//ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.РеализацияКлиенту
	Если Метаданные.Перечисления.Найти("ХозяйственныеОперации")<>Неопределено И  ЕстьРеквизит1С(Мета,"ХозяйственнаяОперация",Тип("ПеречислениеСсылка.ХозяйственныеОперации")) Тогда
		Рекв.Вставить("ХозяйственнаяОперация",Перечисления.ХозяйственныеОперации.РеализацияКлиенту);
	КонецЕсли;
	
	//ПорядокРасчетов = Перечисления.ПорядокРасчетов
	Если Метаданные.Перечисления.Найти("ПорядокРасчетов")<>Неопределено И  ЕстьРеквизит1С(Мета,"ПорядокРасчетов",Тип("ПеречислениеСсылка.ПорядокРасчетов")) Тогда
		Рекв.Вставить("ПорядокРасчетов",Перечисления.ПорядокРасчетов.ПоЗаказамНакладным);
	КонецЕсли;
	
	//ДоговорПодписан
	Если Мета.Реквизиты.Найти("ДоговорПодписан")<>Неопределено Тогда
		Рекв.Вставить("ДоговорПодписан",Истина);
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("ВидДоговора")<>Неопределено ТОгда
		//ВидДоговора=Новый Структура("Имя, Значение", "ВидДоговора"); 
		Если Метаданные.Перечисления.ВидыДоговоров.ЗначенияПеречисления.Найти("СПокупателем")<>Неопределено Тогда
			Рекв.Вставить("ВидДоговора",Перечисления.ВидыДоговоров.СПокупателем);
		ИначеЕсли Метаданные.Перечисления.ВидыДоговоров.ЗначенияПеречисления.Найти("Продажа")<>Неопределено Тогда
			Рекв.Вставить("ВидДоговора",Перечисления.ВидыДоговоров.Продажа);
		КонецЕсли;
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("ТипДоговора")<>Неопределено Тогда
		Если Метаданные.Перечисления.ТипыДоговоров.ЗначенияПеречисления.Найти("СПокупателем")<>Неопределено Тогда
			Рекв.Вставить("ТипДоговора", Перечисления.ТипыДоговоров.СПокупателем);
		ИначеЕсли Метаданные.Перечисления.ТипыДоговоров.ЗначенияПеречисления.Найти("Договор")<>Неопределено Тогда
			Рекв.Вставить("ТипДоговора", Перечисления.ТипыДоговоров.Договор);
		КонецЕсли;
	КонецЕсли;
	
		
	Если Мета.Реквизиты.Найти("БанковскийСчет")<>Неопределено и ЗначениеЗаполнено(Объект.БанковскийСчетДляЗаявки) Тогда 
		Рекв.Вставить("БанковскийСчет",Объект.БанковскийСчетДляЗаявки);
	КонецЕсли;
			
	Если Мета.Реквизиты.Найти("Валюта")<>Неопределено Тогда 
		РВалюта="Валюта";
	ИначеЕсли ЕстьРеквизит1С(Мета,"ВалютаВзаиморасчетов") Тогда 
		РВалюта="ВалютаВзаиморасчетов";
	ИначеЕсли ЕстьРеквизит1С(Мета,"ВалютаРасчетов") Тогда 
		РВалюта="ВалютаРасчетов";
	Иначе
		РВалюта=Неопределено;
	КонецЕсли;
	Если РВалюта<>Неопределено Тогда
		ЕСли ЗначениеЗаполнено(Объект.БанковскийСчетДляЗаявки) Тогда
			Если Объект.БанковскийСчетДляЗаявки.Метаданные().Реквизиты.Найти("ВалютаДенежныхСредств")<>Неопределено  Тогда
				Валюта=Объект.БанковскийСчетДляЗаявки.ВалютаДенежныхСредств;
			ИначеЕсли Объект.БанковскийСчетДляЗаявки.Метаданные().Реквизиты.Найти("Валюта")<>Неопределено  Тогда
				Валюта=Объект.БанковскийСчетДляЗаявки.Валюта;
			КонецЕсли;
		КонецЕсли;
		Если Валюта=Неопределено И Метаданные.Справочники.Найти("Валюты")<>Неопределено Тогда
			Если Метаданные.Константы.Найти("ВалютаРегламентированногоУчета") ТОгда
				Валюта=Константы.ВалютаРегламентированногоУчета.Получить();
			ИначеЕсли Метаданные.Константы.Найти("ВалютаРегламентированногоУчетаОрганизаций") ТОгда
				Валюта=Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
			ИначеЕсли Метаданные.Константы.Найти("ВалютаУчета") ТОгда
				Валюта=Константы.ВалютаУчета.Получить();
			КонецЕсли;
		КонецЕсли;
		Если Валюта <> Неопределено тогда
			Рекв.Вставить(РВалюта,Валюта);
		КонецЕсли;
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("ПорядокОплаты")<>Неопределено И Метаданные.Перечисления.Найти("ПорядокОплатыПоСоглашениям")<>Неопределено Тогда
		ВалРегл=Константы.ВалютаРегламентированногоУчета.Получить();
		Если Валюта=ВалРегл Тогда
			Рекв.Вставить("ПорядокОплаты",Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях);
			ОплатаВВалюте=ЛОжь;
		Иначе
			Рекв.Вставить("ПорядокОплаты",Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВВалюте);
			ОплатаВВалюте=Истина;
		КонецЕсли;
		Если Мета.Реквизиты.Найти("БанковскийСчетКонтрагента")<>Неопределено Тогда
			Запрос = Новый Запрос("
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	БанковскиеСчетаКонтрагентов.Ссылка КАК БанковскийСчетКонтрагента
			|ИЗ
			|	Справочник.БанковскиеСчетаКонтрагентов КАК БанковскиеСчетаКонтрагентов
			|ГДЕ
			|	БанковскиеСчетаКонтрагентов.Владелец = &Контрагент
			|	И ((БанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств = &ВалютаРегл И НЕ &ОплатаВВалюте)
			|	ИЛИ (БанковскиеСчетаКонтрагентов.ВалютаДенежныхСредств <> &ВалютаРегл И &ОплатаВВалюте))
			|	И Не БанковскиеСчетаКонтрагентов.ПометкаУдаления
			|");
			
			Запрос.УстановитьПараметр("Контрагент", Контрагент);
			Запрос.УстановитьПараметр("ОплатаВВалюте", ОплатаВВалюте);
			Запрос.УстановитьПараметр("ВалютаРегл", ВалРегл);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				БанковскийСчетКонтрагента = Выборка.БанковскийСчетКонтрагента;
			Иначе
				БанковскийСчетКонтрагента = Справочники.БанковскиеСчетаКонтрагентов.ПустаяСсылка();
			КонецЕсли;
			Рекв.Вставить("БанковскийСчетКонтрагента",БанковскийСчетКонтрагента);
		КонецЕсли;
	КонецЕсли;
	
	ТекДата=ТекущаяДата();
	Если Мета.Реквизиты.Найти("Дата")<>Неопределено ТОгда
		Рекв.Вставить("Дата",ТекДата);
	ИначеЕсли Мета.Реквизиты.Найти("ДатаДоговора")<>Неопределено ТОгда
		Рекв.Вставить("ДатаДоговора",ТекДата);
	КонецЕсли;
	
	Если ЕстьРеквизит1С(Мета,"ДатаСоздания") Тогда
		Рекв.Вставить("ДатаСоздания",ТекДата);
	КонецЕсли;
	
	Если Мета.Реквизиты.Найти("ДатаНачала")<>Неопределено ТОгда
		Рекв.Вставить("ДатаНачала",ТекДата);
	ИначеЕсли Мета.Реквизиты.Найти("ДатаНачалаДействия")<>Неопределено ТОгда
		Рекв.Вставить("ДатаНачалаДействия",ТекДата);
	КонецЕсли;	
	
	Если Мета.Реквизиты.Найти("Основной")<>Неопределено Тогда
		Рекв.Вставить("Основной",Истина);
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("ТипыЦен")<>Неопределено И ЕстьРеквизит1С(Мета,"ТипЦен",Тип("СправочникСсылка.ТипыЦен")) Тогда
		Попытка
			Рекв.Вставить("ТипЦен",Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
		Исключение
		Конецпопытки;
	КонецЕсли;
	
	Возврат Рекв;
КонецФункции

&НаКлиенте
Процедура ЗаказДоговорСоздание(Элемент, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Элементы.ЗаказыКлиентов.ТекущиеДанные.Контрагент) Тогда Возврат; КонецЕсли;
	
	Рекв=ЗаказДоговорСозданиеНаСервере(Элементы.ЗаказыКлиентов.ТекущиеДанные.Контрагент);
	Если Рекв=Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		ПараметрыФормы=Новый Структура("Ключ",Рекв.ДоговорПустой);
		ОО = Новый ОписаниеОповещения("ЗаказДоговорСозданиеЗаписать",ЭтаФорма,Рекв);
		Форма=ОткрытьФорму("Справочник."+Рекв.ДоговорИмя+".ФормаОбъекта",ПараметрыФормы,ЭтаФорма,Истина,,,ОО);
		ЗаполнитьЗначенияСвойств(Форма.Объект,Рекв);
		Рекв.Вставить("Объект",Форма.Объект);
		СтандарнаяОбработка=Ложь;
	Исключение
		Сообщить(ОписаниеОшибки());
	Конецпопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаказСоглашениеНачалоВыбораНаСервере(ДанныеВыбора, Контрагент, Организация)
	Запрос=Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоглашенияСКлиентами.Ссылка КАК Соглашение
		|ИЗ
		|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
		|ГДЕ "+?(ЗначениеЗаполнено(Контрагент),"
		|	(СоглашенияСКлиентами.Контрагент = &Контрагент
		|			ИЛИ СоглашенияСКлиентами.Типовое = ИСТИНА)","
		|	СоглашенияСКлиентами.Типовое = ИСТИНА")+?(ЗначениеЗаполнено(Организация),"
		|	И СоглашенияСКлиентами.Организация = &Организация ","")+"
		|
		|УПОРЯДОЧИТЬ ПО
		|	СоглашенияСКлиентами.Контрагент УБЫВ,
		|	СоглашенияСКлиентами.Дата УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ"
	);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация",Организация);
	ДанныеВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Соглашение"));
КонецПроцедуры

&НаКлиенте
Процедура ЗаказСоглашениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДан=Элементы.ЗаказыКлиентов.ТекущиеДанные; 
	ДанныеВыбора=Новый СписокЗначений;
	ЗаказСоглашениеНачалоВыбораНаСервере(ДанныеВыбора, ТекДан.Контрагент, Объект.ОрганизацияДляЗаявки);
	Если ДанныеВыбора.Количество()>0 Тогда
		СтандартнаяОбработка=Ложь;
	КонецЕсли;
КонецПроцедуры

