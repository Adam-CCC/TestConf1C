&НаКлиенте
Процедура ЗаявкаПоставщикуПередУдалениемОтвет(Ответ,Элемент) Экспорт
	Если ОТвет=КодВозвратаДиалога.Да Тогда
		ТекДан=Элементы.ЗаявкаПоставщику.ТекущиеДанные;
		//Сообщаем другим пользователям об удалении
		СендерОтправить("{""table"":""ordered"",""action"":""del"",""idData"":"
		+Формат(ТекДан.КодСтроки,"ЧГ=;ЧН=")+"}");
		// Убираем ссылку на строку заказа поставщику
		Строки=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("КодЗП",ТекДан.КодСтроки));
		Если Строки.Количество()>0 Тогда
			Строки[0].КодЗП=0;
		КонецЕсли;
		НовСтр=ПолучитьСледующуюСтроку(Объект.ЗаявкаПоставщику,ТекДан);
		Объект.ЗаявкаПоставщику.Удалить(ТекДан);
		Элементы.ЗаявкаПоставщику.ТекущаяСтрока=НовСтр;
		ЗаявкаПоставщикуПослеУдаления(Элемент);
