	ИначеЕсли ТекДан.Пользователь<>Объект.ПользовательИмя Тогда
		Сообщить("Удалять строки другого пользователя запрещено");
	Иначе
		ОО=Новый ОписаниеОповещения("ЗаявкаПоставщикуПередУдалениемОтвет",ЭтаФорма,Элемент);
		ПоказатьВопрос(ОО,"Удалять текущую запись?",РежимДиалогаВопрос.ДаНет,,КодвозвратаДиалога.Нет);
