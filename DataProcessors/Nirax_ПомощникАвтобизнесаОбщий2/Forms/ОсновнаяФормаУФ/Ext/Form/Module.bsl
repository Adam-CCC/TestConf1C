	Попытка
		ОО = Новый ОписаниеОповещения("СендерЗакрытьОповещение",ЭтаФорма,Перезапуск);
		Сендер.НачатьВызовClose(ОО,1001,"Какая-то причина");
	Исключение
	Конецпопытки;
