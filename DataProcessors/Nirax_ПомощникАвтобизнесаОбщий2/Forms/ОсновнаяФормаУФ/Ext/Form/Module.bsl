&НаКлиенте
Процедура КорзинаСоздатьКарточкуТовара(Команда)
	ТекДанные = Элементы.ЗаявкаНаОформление.ТекущиеДанные;	
	Если Объект.ЕстьНоменклатура Тогда
		Если НЕ ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
			НоменклатураСсылка = ДобавитьВКарточкуНоменлатурыНаСервере(ТекДанные.Артикул, ТекДанные.Наименование, ТекДанные.Производитель);				
			Если НоменклатураСсылка <> Неопределено Тогда 			
				//Заполним все позиции в корзине
				Фильтр = Новый Структура("Артикул, Производитель", ТекДанные.Артикул, ТекДанные.Производитель);  
				НайденныеСтроки = Объект.ЗаявкаНаОформление.НайтиСтроки(Фильтр);
				Если НайденныеСтроки <> Неопределено Тогда
					Для каждого Запись Из НайденныеСтроки Цикл
						Запись.Номенклатура = НоменклатураСсылка;
						Запись.Наименование = НоменклатураСсылка;
					КонецЦикла;
				КонецЕсли;
				
				Если Объект.ЗапрашиватьГруппуНоменклатуры Тогда
					ПараметрыФормы = Новый Структура("УникальныйИдентификатор", новый УникальныйИдентификатор);
					Оповещение = Новый ОписаниеОповещения("ВходВгруппу", ЭтаФорма, НоменклатураСсылка);	
					ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",ПараметрыФормы,,,,,Оповещение);
				Иначе
					ПараметрыФормы=Новый Структура("Ключ",НоменклатураСсылка);
					ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",ПараметрыФормы);
				КонецЕсли;   
								
				//Ключ = Новый Структура("Ключ", НоменклатураСсылка);			
				//Форма = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Ключ);    			
				//Форма.Открыть();			
			КонецЕсли;
		Иначе
			Сообщить("Данный товар уже есть в справочнике номенклатуры");
		КонецЕсли;
	Иначе
		Сообщить("В данной конфигурации нет справочника ""Номенклатура""");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КорзинаСоздатьВсеКарточкиТоваров(Команда)
	Если Объект.ЕстьНоменклатура Тогда
		
		ТекЗаказ=Элементы.ЗаказыКлиентов.ТекущиеДанные;
		Если ТекЗаказ<>Неопределено Тогда
			Для каждого ТекДанные Из Объект.ЗаявкаНаОформление Цикл
				Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
					Продолжить;
				КонецЕсли;
				НоменклатураСсылка = ДобавитьВКарточкуНоменлатурыНаСервере(ТекДанные.Артикул, ТекДанные.Наименование, ТекДанные.Производитель);				
				Если НоменклатураСсылка <> Неопределено Тогда 			
					//Заполним все позиции в корзине
					Фильтр = Новый Структура("Артикул, Производитель", ТекДанные.Артикул, ТекДанные.Производитель);  
					НайденныеСтроки = Объект.ЗаявкаНаОформление.НайтиСтроки(Фильтр);
					Если НайденныеСтроки <> Неопределено Тогда
						Для каждого Запись Из НайденныеСтроки Цикл
							Запись.Номенклатура = НоменклатураСсылка;
							Запись.Наименование = НоменклатураСсылка;
						КонецЦикла;
					КонецЕсли;
					
					Если Объект.ЗапрашиватьГруппуНоменклатуры Тогда
						ПараметрыФормы = Новый Структура("УникальныйИдентификатор", новый УникальныйИдентификатор);
						Оповещение = Новый ОписаниеОповещения("ВходВгруппу", ЭтаФорма, НоменклатураСсылка);	
						ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",ПараметрыФормы,,,,,Оповещение);
					Иначе
						ПараметрыФормы=Новый Структура("Ключ",НоменклатураСсылка);
						ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",ПараметрыФормы);
					КонецЕсли;   
									
					//Ключ = Новый Структура("Ключ", НоменклатураСсылка);			
					//Форма = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Ключ);    			
					//Форма.Открыть();			
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Сообщить("В данной конфигурации нет справочника ""Номенклатура""");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкаНаОформлениеНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ТекДан=Элементы.ЗаявкаНаОформление.ТекущиеДанные;
	Оповещение=Новый ОписаниеОповещения("ТоварыНаименованиеВыбор",ЭтаФорма,ТекДан);
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("РежимВыбора",Истина);
	Если ЗначениеЗаполнено(ТекДан.Номенклатура) Тогда
		ПараметрыВыбора.Вставить("ТекущаяСтрока",ТекДан.Номенклатура);
		//ПараметрыВыбора.Вставить("УстановитьПараметрыФункциональныхОпцийФормы",Новый Структура("ТекущаяСтрока",ТекДан.Номенклатура));
	КонецЕсли;
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаименованиеВыбор(Номенклатура,ТекДан) Экспорт
	Если Номенклатура<>Неопределено тогда 
		ТекДан.Номенклатура=Номенклатура;
		ТекДан.Наименование=Строка(Номенклатура);
		ЗаполнитьЗначенияСвойств(ТекДан,ТоварыНаименованиеВыборНаСервере(Номенклатура));
	КонецЕсли;
Конецпроцедуры

&НаСервере
Функция ТоварыНаименованиеВыборНаСервере(Номенклатура)
	ТекДан=Новый Структура();
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("Артикул")<>Неопределено Тогда
		ТекДан.Вставить("Артикул",Номенклатура.Артикул);
	КонецЕсли;
	
	Обработка=РеквизитФормыВЗначение("Объект"); 
	ПроизводительСвойства = Обработка.ПолучитьПроизводителяНоменклатуры(Номенклатура);
	Если ПроизводительСвойства<>Неопределено Тогда
		ТекДан.Вставить("Производитель",Строка(ПроизводительСвойства.Ссылка));
	КонецЕсли;
	Возврат ТекДан;
КонецФункции

