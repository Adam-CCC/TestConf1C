// Функция возвращает идентификатор следующей строки Таблицы 
// после данных строки ТекДан, а если она последняя - то предудущей.
// Используется для установки новой строки при удалении.
// Сначала получаем идентификатор, потом удаляем, потом устанавливаем новую текущую строку
//
Функция ПолучитьСледующуюСтроку(Таблица,ТекДан)
	Инд=Таблица.Индекс(ТекДан);
	Если Инд=Таблица.Количество()-1 Тогда
		Если Инд=0 Тогда Возврат Неопределено; КонецЕсли;
		Инд=Инд-1;
	КонецЕсли;
    Возврат Таблица[Инд].ПолучитьИдентификатор();
КонецФункции

&НаСервере
// Функция проверяет наличие Реквизита в метаданных объета. 
// Дополнительно, при  наличии параметра Тип - проверяется содержит ли Реквизит заданный тип.
// Возвращает Истина или Ложь
//
Функция ЕстьРеквизит1С(МетаОбъект, Реквизит, Тип=Неопределено)
	МетаРеквизит = МетаОбъект.Реквизиты.Найти(Реквизит); 
	Если МетаРеквизит=Неопределено Тогда
		МетаРеквизит = Метаданные.ОбщиеРеквизиты.Найти(Реквизит);
		Если МетаРеквизит=Неопределено Тогда Возврат Ложь;
		Иначе
			ЭлСостава = Метаданные.ОбщиеРеквизиты[Реквизит].Состав.Найти(МетаОбъект);
			Если ЭлСостава=Неопределено или ЭлСостава.Использование<> Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать Тогда Возврат Ложь;КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Тип=Неопределено или МетаРеквизит.Тип.СодержитТип(Тип);
КонецФункции

// Функция возвращает число из строки, удаляя все пробельные символы, начальные и конечные не цифры
// Если Строка не имеет цифр или пустая - возвращается 0.
// Если вместо строки передается число - оно же и возвращается. 
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЧисло(Данные,Ноль=0) Экспорт
	Если ТипЗнч(Данные)=Тип("Число") Тогда Возврат Данные;КонецЕсли; 
	Если ПустаяСтрока(Данные) Тогда Возврат Ноль;КонецЕсли; 
	Попытка 
		Данные=СтрЗаменить(СтрЗаменить(СтрЗаменить(Данные, Символы.НПП, "")," ", ""),",",".");
		Возврат Число(Данные); 
	Исключение
		Симв=Лев(Данные,1);
		//Числа = (Симв>="0" И Симв <= "9") ИЛИ Симв="-" или Симв="+";
		Нач=0; Длина=0; ТочкиНет=Истина; Знак="";
		Кол = СтрДлина(Данные);
		Для Поз=1 по Кол Цикл
			Симв=Сред(Данные,Поз,1);
			Число = (Симв>="0" И Симв <= "9"); 
			Если Не Число Тогда
				Если Длина=0 и (Симв="-" или Симв="+") Тогда
					Знак=Симв;
				ИначеЕсли Длина>0 И ТочкиНет И Симв="." Тогда
					ТочкиНет=Ложь;
					Длина=Длина+1;
				ИначеЕсли Длина>0 Тогда
					Длина=Поз-Нач;
					Прервать;
				КонецЕсли;
			Иначе
				Если Длина=0 Тогда
					Нач=Поз;
				КонецЕсли;
				Длина=Длина+1;
			КонецЕсли;
		КонецЦикла;
		Если Длина=0 Тогда
			Возврат Ноль;
		Иначе
			Возврат Число(Знак+Сред(Данные,Нач,Длина));
		КонецЕсли;
	Конецпопытки
КонецФункции

