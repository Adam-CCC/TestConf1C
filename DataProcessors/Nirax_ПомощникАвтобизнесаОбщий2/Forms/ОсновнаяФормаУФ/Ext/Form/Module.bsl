&НаКлиенте
Процедура УточнениеПоискаУточнениеПометкаПриИзменении(Элемент)

	ТекДанные = Элементы.УточнениеПоиска.ТекущиеДанные;
	тАртикул = ТекДанные.АртикулДляПоиска;
	тБренд = ТекДанные.Бренд;
	тПоставщик = ТекДанные.УточнениеПоставщик;
	Индекс = Объект.УточнениеПоиска.Индекс(ТекДанные)+1;
	Колво=Объект.УточнениеПоиска.Количество();
	Пометка=ТекДанные.УточнениеПометка;
	Пока Индекс<Колво Цикл
		Стр=Объект.УточнениеПоиска[Индекс];
		Если Стр.Бренд<>тБренд или Стр.АртикулДляПоиска<>тАртикул или
			(Объект.УточнятьПоставщика и Стр.УточнениеПоставщик<>тПоставщик) Тогда
			Прервать;
		КонецЕсли;
		Стр.УточнениеПометка=Пометка;
		Индекс=Индекс+1;
	КонецЦикла;       
	
КонецПроцедуры

&НаКлиенте
Процедура УточнятьПоставщикаПриИзменении(Элемент)
	тБренд=Неопределено; тАртикул=Неопределено; тПоставщик=Неопределено;
	тСтр=Неопределено;тБезИмени=Ложь;тПометка=Ложь; 
	Для Каждого стр Из Объект.УточнениеПоиска Цикл
		Если Стр.Бренд<>тБренд или стр.АртикулДляПоиска<>тАртикул 
			или (Объект.УточнятьПоставщика И стр.УточнениеПоставщик<>тПоставщик) Тогда
			Стр.Отображать=Истина;
			тБренд=Стр.Бренд;
			тАртикул=стр.АртикулДляПоиска;
			тПометка=Стр.УточнениеПометка;
			Если Объект.УточнятьПоставщика Тогда
				тПоставщик=стр.УточнениеПоставщик;
			КонецЕсли;
			Если ПустаяСтрока(Стр.УточнениеНазваниеТовара) Тогда 
				БезИмени=Истина;
				тСтр=Стр;
			Иначе
				БезИмени=Ложь;
			КонецЕсли;
		Иначе
			Стр.Отображать=Ложь ;
			Стр.УточнениеПометка=тПометка;
			Если БезИмени и не ПустаяСтрока(Стр.УточнениеНазваниеТовара) Тогда
				тСтр.УточнениеНазваниеТовара=Стр.УточнениеНазваниеТовара;
				БезИмени=Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	Элементы.УточнениеПоиска1УточнениеПоставщик.Видимость=Объект.УточнятьПоставщика;
	Элементы.УточнениеПоиска.Обновить();
КонецПроцедуры

&НаСервере
