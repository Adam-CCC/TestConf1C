&НаСервере
Функция ПолучитьНастройкиЗагрузки()
	НастройкаЗагрузки=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","НастройкаЗагрузки",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	Мас=Новый Массив;
	ЕСли ТипЗнч(НастройкаЗагрузки)<>Тип("ТаблицаЗначений") Тогда
		Возврат Мас;
	КонецЕсли;
	Для Каждого Стр Из НастройкаЗагрузки Цикл
		Если Стр.Вкл Тогда
			Мас.Добавить(Новый Структура("Поставщик,ПутьКФайлу,Лист,Артикул,Наименование,Производитель,Время,Остаток,Цена",
			Стр.Поставщик,Стр.ПутьКФайлу,Стр.Лист,Стр.Артикул,Стр.Наименование,Стр.Производитель,Стр.Время,Стр.Остаток,Стр.Цена));
        КонецЕсли;
	КонецЦикла;
	Возврат Мас;
КонецФункции

&НаКлиенте
Процедура ПоискПрайсНаКлиенте(Артикул,АртОриг)
	Попытка
		Эксель = Новый COMОбъект("Excel.Application"); 
		Эксель.Displayalerts = 0;
	Исключение
		Сообщить("Ошибка при попытке работы с Mirosoft Excel, возможно он не установлен"+Символы.ПС+ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	НастройкаЗагрузки=ПолучитьНастройкиЗагрузки();
	Если НастройкаЗагрузки.Количество()=0 Тогда
		Сообщить("Отсутствуют данные - выполните настройку Прайс листов");
	КонецЕсли;
	ТЗРез=Новый Массив;
	Для Каждого СтрТаб из НастройкаЗагрузки Цикл
		Попытка	
			//сообщить("4512");
			Книга = Эксель.WorkBooks.Open(СокрЛП(СтрТаб.ПутьКФайлу),0,Истина);
			Если СтрТаб.Лист<>"" Тогда
				Лист=Книга.Worksheets(СтрТаб.Лист)
			Иначе
				Лист=Книга.Worksheets(1);
			КонецЕсли;
			Лист.Activate();
			ВсегоСтрок = Лист.Cells(1,1).SpecialCells(11).Row; 
			ИмяКолонки=Символ(64+СтрТаб.Артикул);
			КонОбл=":"+ИмяКолонки+Формат(ВсегоСтрок,"ЧГ=0");
			МасПоиск=Новый Массив;
			МасПоиск.Добавить(АртОриг);
			Если ВРЕГ(СокрЛП(АртОриг))<>ВРЕГ(СОКРЛП(Артикул)) Тогда
				МасПоиск.Добавить(Артикул);
			КонецЕсли;
			Попытка 
				АртЧисло=Число(АртОриг);
				МасПоиск.Добавить(АртЧисло);
			Исключение
			Конецпопытки;
			Для Каждого Искомое из МасПоиск Цикл
				НомерСтроки=1;
				Пока Истина Цикл
					Попытка
	        			Сдвиг=Эксель.WorksheetFunction.Match(Искомое,Лист.Range(ИмяКолонки+Формат(НомерСтроки,"ЧГ=0")+КонОбл),0);
					Исключение
						Сдвиг=Неопределено;
					Конецпопытки;
					//Если не нашли - выходим
					Если ТипЗнч(Сдвиг)<>Тип("Число") Тогда 
						Прервать;
					КонецЕсли;					 
					//Если нашли - вносим данные в таблицу
					НомерСтроки=НомерСтроки+Сдвиг-1;
					ТЗРез.Добавить(Новый Структура("Полное_описание_русский,поставщик,Артикул,ЦенаПрайс,Остаток,Срок,ПоставщикПрайс",
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки,СтрТаб.Наименование).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Производитель).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Артикул).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Цена).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Остаток).Value), Символы.НПП, ""),
					СтрТаб.Время,СтрТаб.Поставщик));
					НомерСтроки=НомерСтроки+1;
					Если НомерСтроки>ВсегоСтрок Тогда Прервать;КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Книга.Close();
		Исключение
			Сообщить("Ошибки при разборе данных прайс-листа:"+Символы.ПС+"Файл: "+СтрТаб.ПутьКфайлу+" лист: "+СтрТаб.Лист+символы.ПС+"Возможно ошибки в настройках или данных.");
			Попытка Книга.Close();Исключение;КонецПопытки;
		КонецПопытки;
	КонецЦикла;
	Эксель=Неопределено;
	ПоискПрайсНаСервере(ТЗРез, АртОриг);
КонецПроцедуры

