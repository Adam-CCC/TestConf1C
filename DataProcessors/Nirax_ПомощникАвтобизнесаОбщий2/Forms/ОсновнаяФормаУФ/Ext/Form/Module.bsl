&НаСервере
Функция ДобавитьВКарточкуНоменлатурыНаСервере(Артикул, НаименованиеДетали, Производитель)
	СтруктураПоиска = Новый Структура("Артикул,НаименованиеДетали,Производитель", Артикул, НаименованиеДетали, Производитель);
	ЭтоОбъект = РеквизитФормыВЗначение("Объект");			
		                                  		
	НоменклатураСсылка = Неопределено;		
	НоменклатураСсылка = ЭтоОбъект.ПолучитьНоменклатуруТовара(СтруктураПоиска, Истина,);
	
	Возврат НоменклатураСсылка;
КонецФункции

&НаКлиенте
Процедура ДобавитьВКарточкуНоменклатуры(Команда)
	
	ТекДанные = Элементы.РезультатПоискаОнлайн.ТекущиеДанные;
	Если ТекДанные=Неопределено Тогда Возврат;КонецЕсли;
	Если ТекДанные.НаличиеВСправочнике = 0 Тогда
		НоменклатураСсылка = ДобавитьВКарточкуНоменлатурыНаСервере(ТекДанные.Артикул, ТекДанные.НаименованиеДетали, ТекДанные.Производитель);				
		Если НоменклатураСсылка <> Неопределено Тогда 			
			Если Объект.ЗапрашиватьГруппуНоменклатуры Тогда
				ПараметрыФормы = Новый Структура("УникальныйИдентификатор", новый УникальныйИдентификатор);
				Оповещение = Новый ОписаниеОповещения("ВходВгруппу", ЭтаФорма, НоменклатураСсылка);	
				ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",ПараметрыФормы,,,,,Оповещение);
			Иначе
				ПараметрыФормы=Новый Структура("Ключ",НоменклатураСсылка);
				ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",ПараметрыФормы);
			КонецЕсли;   
			ТекДанные.Номенклатура = НоменклатураСсылка;
			ТекДанные.НаличиеВСправочнике = 1;

			//Ключ = Новый Структура("Ключ", НоменклатураСсылка);			
			//Форма = ПолучитьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", Ключ);    			
			//Форма.Открыть();			
	    КонецЕсли;
	Иначе
		Сообщить("Данный товар уже есть в справочнике номенклатуры");
	КонецЕсли;
	
КонецПроцедуры

