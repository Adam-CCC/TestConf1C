&НаКлиенте
Перем Сендер,СендерАдрес, СендерЗапросы, ВсеЗаявкиПоставщикуБыли, СендерСв, СендерОтладкаБыла, ПодключаемоеОборудование, ФормыПА;

#Область ОбработчикиСобытийФормы

&НаСервере   
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем Данные;
	Объект.ПользовательИмя=ПользователиИнформационнойБазы.ТекущийПользователь().Имя;//вс(
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ОбъектMySQL",,Объект.ПользовательИмя);//вс)
	Если ТипЗнч(Данные)<>Тип("Структура") Тогда
		Данные=Новый Структура("ИспользоватьБазуКроссов,ИспользоватьПрайсЛист, ИспользоватьПоискПоАвтомобилю,ИспользоватьЗаказПоставщику,МаксСрокПоНаличию,СборАналитики",
		Истина,Истина,Истина,Истина,3,Истина);
	ИначеЕсли Не Данные.Свойство("СборАналитики") Тогда
		Данные.Вставить("СборАналитики",Истина);
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект,Данные);
			
	Объект.КроссПодключен=Найти(Параметры.listSoftware,",CrossAssistant,")>0; 
	Объект.СтрокаПодключенияКроссов=Параметры.urlAPI;
	Объект.КодСеанса=Параметры.idSession;
	ЭтаФорма.КодПользователя=Параметры.idUser;
	Объект.Лицензия=?(Параметры.idLicense=0,"ДЕМО(Функционал ограничен)","ПРОФ.");
	Объект.СрокПодпискиПА = Параметры.СрокПодпискиПА;
	Объект.СрокПодпискиБК = Параметры.СрокПодпискиБК;
	Объект.СрокПодпискиТП = Параметры.СрокПодпискиТП;
	Объект.ДемоРежим = Параметры.ДемоРежим;
	Объект.IPКлиента = Параметры.IPКлиента;
	Объект.СП = ПолучитьАдресСПСервер();
	
	Обработка=РеквизитФормыВЗначение("Объект"); 
	Если Лев(Строка(ТипЗнч(Обработка)),7)="Внешняя" ТОгда
		Объект.ВнешняяОбработка="ВнешняяОбработка";
	Иначе
		Объект.ВнешняяОбработка="Обработка";
	КонецЕсли;
	
	Объект.ПАЛогин = Параметры.CurrentUser;
	
	ЗначениеНастроек = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса", "ФильтрОнлайнСтруктура",,Объект.ПользовательИмя); 	
	Если ТипЗнч(ЗначениеНастроек) = Тип("Соответствие") Тогда		 
		 Объект.ФильтрОнлайнВид = ЗначениеНастроек.Получить("ФильтрОнлайнВид");	 
		 Объект.ФильтрОнлайнКвоСтрок = ЗначениеНастроек.Получить("ФильтрОнлайнКвоСтрок");
		
	КонецЕсли;	
	//зк(
	Обработка.ЗагрузитьКорзины(Объект.ПользовательИмя);
	ЗначениеВДанныеФормы(Обработка.ЗаказыКлиентов,Объект.ЗаказыКлиентов);	
	ЗначениеВДанныеФормы(Обработка.ЗаявкаНаОформление,Объект.ЗаявкаНаОформление);	
	//зк)
	Обработка.ЗагрузитьЗаявкиПоставщику();
	ЗначениеВДанныеФормы(Обработка.ЗаявкаПоставщику,Объект.ЗаявкаПоставщику);
	Элементы.Группа10.Заголовок="Заказанное ("+Строка(Объект.ЗаявкаПоставщику.Количество())+")";
	
	ЗаполнитьСтатусыВКорзине(Объект.ПользовательИмя);

	Мас=Обработка.ВыгрузитьУровниЦен();
	Элементы.УровеньЦен.СписокВыбора.ЗагрузитьЗначения(Мас);
	Элементы.УровеньЦенЕмекс.СписокВыбора.ЗагрузитьЗначения(Мас);
	Если Мас.Найти(Объект.УровеньЦен)=Неопределено Тогда Объект.УровеньЦен="Закупочная";КонецЕсли;
	Если Мас.Найти(Объект.УровеньЦенЕмекс)=Неопределено Тогда Объект.УровеньЦенЕмекс="Закупочная";КонецЕсли;
	
	// Обновим методы у проценок
	Обработка.ОбновитьДанныеПоОнлайнПоставщикам(Истина, Истина);
	
	 Попытка
		#Если ВебКлиент Тогда
			Объект.РежимМодальности=Ложь;
		#Иначе
			Объект.РежимМодальности=Метаданные.РежимИспользованияМодальности=Метаданные.СвойстваОбъектов.РежимИспользованияМодальности.Использовать;
		#КонецЕсли
	Исключение
		Объект.РежимМодальности=Истина;
	КонецПопытки;
	
	Если Метаданные.Справочники.Найти("Номенклатура") <> Неопределено Тогда
		Объект.ЕстьНоменклатура = ИСтина;
	Иначе
		Объект.ЕстьНоменклатура = Ложь;
		ЗаполнитьНачальныеНастройкиДляПустойБазы();
	КонецЕсли;
	
	// Формирование списка групп поставщиков
	ГруппыПоставщиков=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ГруппыПоставщиков",,Объект.ПользовательИмя);
	Если ТипЗнч(ГруппыПоставщиков)<>Тип("СписокЗначений") Тогда ГруппыПоставщиков=Новый СписокЗначений;Конецесли;
	Список=Элементы.ГруппаПоставщиков.СписокВыбора;
	//Список.Добавить(""," ");
	Для Каждого Стр Из ГруппыПоставщиков Цикл
		Список.Добавить(Стр.Представление);
	КонецЦикла;

	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачальныеНастройкиДляПустойБазы()
	//уберем лишние элементы для пустой базы
	//База кроссов
	Объект.ВыводитьАналоги = Ложь;
	Элементы.ВключаяАналоги.Видимость = Ложь;
	Объект.ВыводитьНаличие = Ложь;
	Элементы.ВыводитьНаличие.Видимость = Ложь;
	Объект.ПоШаблону = Ложь;
	Элементы.ПоШаблону.Видимость = Ложь;
	Элементы.ФильтрСклад.Видимость = Ложь;
	Элементы.ТипЦен.Видимость = Ложь;
	//Прайс-листы
	Элементы.ФильтрСкладПрайс.Видимость = Ложь;
	//Проценки
	Элементы.МенюОтборПоНаличиюНаСкладеПредприятия.Видимость = Ложь;
	Элементы.СервисДобавитьВКарточку.Видимость = Ложь;
	//Корзина
	Элементы.ОформитьЗаявку.Видимость = Ложь;
	Элементы.КонтрагентДляЗаявки.Видимость = Ложь;
	Элементы.СкладДляЗаявки.Видимость = Ложь;
	//Заказы поставщикам
	Элементы.ОформитьЗаказы.Видимость = Ложь;
	Элементы.ОформитьДокументыПоступления.Видимость = Ложь;
КонецПроцедуры

&НаСервере
Функция ВыяснитьКонфигурациюНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ВыяснитьКонфигурацию(ЭтаФорма.Элементы);
КонецФункции

&НаСервере
Функция ПолучитьАдресСПСервер()
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьАдресСервераПроценок();
КонецФункции

&НаСервере
Процедура СохранитьЗаявкиНаСервере()
	СохранитьДанныеПоКорзине(ПользовательКорзины);
	СохранитьДанныеПоЗаказамПоставщикам(); //вс()
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.СохранитьНастройкиВХранилище("ОсновныеНастройки");
	Обработка.ПризакрытииОграничения();
КонецПроцедуры

&НаСервере
Процедура ИспользованиеПроценокОнЛайнПоставщиков()
Перем Данные;	

	Данные=Неопределено;
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ОбъектMySQL",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	
	Если НЕ ТипЗнч(Данные)=Тип("Структура") Тогда
  		Объект.ИспользоватьПроценкуОнлайнПоставщиков= ИСТИНА;
		Объект.ИспользоватьБазуКроссов = ИСТИНА;
		Объект.ИспользоватьПрайсЛист = ИСТИНА;
		Объект.ИспользоватьПоискПоАвтомобилю = ИСТИНА;
		Объект.ИспользоватьЗаказПоставщику = ИСТИНА;
			
		Элементы.ПоискЕмекс.Видимость=Объект.ИспользоватьПроценкуОнлайнПоставщиков;
		Элементы.СтраницаПоискПоАртикулу.Видимость = Объект.ИспользоватьБазуКроссов;
		Элементы.СтраницаПоискПоПрайсу.Видимость = Объект.ИспользоватьПрайсЛист;
		Элементы.Стр3.Видимость = Объект.ИспользоватьПоискПоАвтомобилю;
		Элементы.Группа10.Видимость = Объект.ИспользоватьЗаказПоставщику;
		
		Обработка = РеквизитФормыВЗначение("Объект");
		Обработка.СохранитьНастройкиВХранилище("ОсновныеНастройки");
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюСтраницу()
	
    Если ЭтаФорма.Элементы.СтраницаПоискПоАртикулу.Видимость = Истина Тогда
	   ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоАртикулу;
	ИначеЕсли ЭтаФорма.Элементы.СтраницаПоискПоПрайсу.Видимость = Истина Тогда
	   ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоПрайсу;
	ИначеЕсли ЭтаФорма.Элементы.ПоискЕмекс.Видимость = Истина Тогда
	   ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.ПоискЕмекс;	   
	ИначеЕсли ЭтаФорма.Элементы.Стр3.Видимость = Истина Тогда
	   ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.Стр3;
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьВидимостьСрокаПодписки()
	Показывать = Ложь;
	СрокПодписки = "";
	Если ЗначениеЗаполнено(Объект.СрокПодпискиТП) Тогда
		СрокПодписки = Объект.СрокПодпискиТП;
	ИначеЕсли ЗначениеЗаполнено(Объект.СрокПодпискиПА) Тогда
		СрокПодписки = Объект.СрокПодпискиПА;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СрокПодпискиБК) Тогда 
		Если ЗначениеЗаполнено(СрокПодписки)  Тогда
			Если (Объект.СрокПодпискиБК >= НачалоДня(ТекущаяДата())) и (Объект.СрокПодпискиБК < СрокПодписки) Тогда			
				СрокПодписки = Объект.СрокПодпискиБК;
			КонецЕсли;
		Иначе
			СрокПодписки = Объект.СрокПодпискиБК;
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СрокПодписки) Тогда
		Если СрокПодписки-ТекущаяДата()<=20*86400 Тогда
			ЭтаФорма.Элементы.СрокПодписки.Заголовок = "Срок подписки до "+Формат(СрокПодписки, "ДЛФ=Д");
			Показывать = Истина;
			Если СрокПодписки-ТекущаяДата()<=7*86400 Тогда
				ЭтаФорма.Элементы.СрокПодписки.ЦветТекста = Новый Цвет(255,0,0);
			Иначе
				ЭтаФорма.Элементы.СрокПодписки.ЦветТекста = Новый Цвет(28,85,174);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Показывать;
КонецФункции

&НаКлиенте   
Процедура ПриОткрытии(Отказ)
	
    Состояние("Запуск NIRAX: Помощника автобизнеса...", , "Восстанавливаем ранее сохраненные настройки");
	СендерЗапросы=Новый СписокЗначений;
	СендерСв=Новый Структура("Начало,Источник,Живой,Пинг,Повторов,Таймаут,ЖдатьОтвет,КС,Конец,Первый,макс,ВсеЗаявки,Отладка",
    	ТекущаяДата(),"",Истина,0,3,60,10,0,0,0,0,Ложь,Ложь);
	ФормыПА=Новый Структура;     
	
	//Определение конфигурации
	Рез=ВыяснитьКонфигурациюНаСервере();
	ЗаполнитьЗначенияСвойств(Объект,Рез);
	Если Объект.Лицензия="ДЕМО(Функционал ограничен)" Тогда
		Список="Пред0,Пред1,Пред3,Пред4,Пред5,ОбщийПоиск,ВыводитьНаличие,ФильтрМарка,ФильтрСклад,"+
		"УровеньЦен,ФильтрСкладПрайс,ФильтрМаркаЕмекс,ФильтрПоставщикЕмекс,ФильтрСкладЕмекс,ЕмексИскатьСЗаменамиИАналогами,ОтборПоНаличию,УровеньЦенЕмекс,"+
		"КонтрагентДляЗаявки,ДоговорДляЗаявки,СкладДляЗаявки,ОформитьЗаявку,ЧекККМ,ЗаказатьЕмекс,ЗаявкаНаОформление,ЗаказыКлиентов,ОформитьЗаказы,ЗаявкаПоставщику,"+
		"МенюСЗаменамиИАналогами,ПодменюОтбор,МенюРасчетОстатокНаСкладе";
		
		Список=СтрЗаменить(Список,",",Символы.ПС);
		КолСтр=СтрЧислоСтрок(Список);
		Для Инд=1 по КолСтр Цикл
			Стр=СтрПолучитьСтроку(Список,Инд);
			Элементы[Стр].Доступность=Ложь;
		КонецЦикла;		
	КонецЕсли;
	Отказ = Объект.ОтказОт;
	ЭтаФорма.Заголовок = "NIRAX: Помощник автобизнеса " + Объект.Версия
	+ ?(Объект.Лицензия="ДЕМО(Функционал ограничен)" или Объект.КроссПодключен,""," (кроссы ограничены)");
	//Определение доступности реквизитов
	//Убираем элементы формы, данные которых отсутствуют в данной конфигурации
	Элементы.ЗаказПокупателя.Видимость=Рез.ЕстьЗаказ;
	Элементы.РеализацияТоваров.Видимость=Рез.ЕстьРеализация;
	Элементы.СчетФактура.Видимость=Рез.ЕстьСчет;
	Элементы.Соглашение.Видимость=Рез.Свойство("Соглашение");
	Элементы.ДоговорДляЗаявки.Видимость=Объект.ДоговорДляЗаявки<>Неопределено;
	//Элементы.ОформитьЧекККМ.Видимость=Объект.КассаККМ<>Неопределено;//зк()
	
	Элементы.ПоискЕмекс.Видимость=Объект.ИспользоватьПроценкуОнлайнПоставщиков;
	Элементы.СтраницаПоискПоАртикулу.Видимость=Объект.ИспользоватьБазуКроссов;
	Элементы.СтраницаПоискПоПрайсу.Видимость=Объект.ИспользоватьПрайсЛист;
	Элементы.Стр3.Видимость=Объект.ИспользоватьПоискПоАвтомобилю;
	Элементы.Группа10.Видимость=Объект.ИспользоватьЗаказПоставщику; 
	Элементы.ЗаявкаНаОформлениеЦена.Доступность = НЕ Объект.ЗапретитьРедактированиеЦенВКорзине;	
	Элементы.УточнениеПоиска1УточнениеПоставщик.Видимость=Объект.УточнятьПоставщика;
	Элементы.УточнениеПоиска.ОтборСтрок=Новый ФиксированнаяСтруктура("Отображать",Истина);
	//зк(
	ПользовательКорзины=Объект.ПользовательИмя;
	Элементы.ЗаказыКлиентов.ТекущаяСтрока=Объект.ЗаказыКлиентов[0];
	ОбновитьЗаголовокКорзины();
	Если Объект.Соглашение=Неопределено Тогда
		Элементы.ЗаказСоглашение.Видимость=Ложь;
	Иначе
		Элементы.ЗаказСоглашение.ОграничениеТипа=ОпределитьТип(Объект.Соглашение);
	КонецЕсли;
	Если Объект.ДоговорДляЗаявки=Неопределено Тогда
		Элементы.ЗаказДоговор.Видимость=Ложь;
	Иначе
		Элементы.ЗаказДоговор.ОграничениеТипа = ОпределитьТип(Объект.ДоговорДляЗаявки);
	КонецЕсли;
	Если Объект.Склад=Неопределено Тогда
		Элементы.ЗаказСклад.Видимость=Ложь;
	Иначе
		Элементы.ЗаказСклад.ОграничениеТипа = ОпределитьТип(Объект.Склад);
	КонецЕсли;
	ЗаказыКлиентовОтбор=Новый Структура("Статусы,ДатаЗаказаС,ДатаЗаказаПо,ДатаОтгрузкиС,ДатаОтгрузкиПо,Контрагент",
	Новый СписокЗначений(),'00010101','00010101','00010101','00010101',?(Объект.ЕстьНоменклатура,
	ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"),""));
	ЗаказыКлиентовОтбор.Статусы=Элементы.ЗаказСтатус.СписокВыбора.Скопировать();
	ЗаказыКлиентовОтбор.Статусы[0].Пометка=Истина;
	ЗаказыКлиентовОтборВыполнить(Истина);
	Элементы.ЗаказыКлиентов.ОтборСтрок=Новый ФиксированнаяСтруктура("Отбор",Истина);
	
	Элементы.ОформитьЗаказПокупателя.Видимость=Объект.Реквизит1С.Заказ<>Неопределено;
	Элементы.ОформитьЗаказНаряд.Видимость=Объект.Реквизит1С.ЗаказНаряд<>Неопределено;
