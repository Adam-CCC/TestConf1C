#Область ОбработчикиСобытийФормыИЭлементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипДокумента=?(Метаданные.Документы.Найти("ПриобретениеТоваровУслуг") <> Неопределено,"ПриобретениеТоваровУслуг",
	?(Метаданные.Документы.Найти("ПоступлениеТоваровУслуг") <> Неопределено,"ПоступлениеТоваровУслуг",
	?(Метаданные.Документы.Найти("ПоступлениеТоваров") <> Неопределено,"ПоступлениеТоваров",
	?(Метаданные.Документы.Найти("ПриходнаяНакладная") <> Неопределено,"ПриходнаяНакладная",Неопределено))));
	
	Если ТипДокумента=Неопределено Тогда
		Сообщить("В данной конфигурации не найден документ поступления товара");
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки=Обработка.ПоступлениеТовараЗаполнитьНастройки(ЭтаФорма,ЭтаФорма.Элементы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НомерЛиста=1;
	Начальнаястрока=1;
	ВариантПоиска="АртикулПроизводитель";
	ОбновитьНастройки(Неопределено);
	//Элементы.Склад.ОграничениеТипа = ОпределитьТип(Объект.Склад);
	Организация=Объект.ОрганизацияДляЗаявки;
	Склад=Объект.Склад;
	СтавкаНДС=Объект.НДСПоУмолчанию;
	СНДС=ВРЕГ(Строка(СтавкаНДС))<> "БЕЗ НДС";
	ЦенаСНДС=СНДС;СуммаСНДС=СНДС; НДСвЦене=СНДС;
	Элементы.ОбновлятьНоменклатуруИзБК.Доступность=Объект.КроссПодключен;
КонецПроцедуры

&НаКлиенте
Процедура ФайлЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Оповещение=Новый ОписаниеОповещения("ФайлЗагрузкиВыбор",ЭтаФорма);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл";
	Диалог.ПолноеИмяФайла = ""; 
	Диалог.Фильтр = "Файлы Excel (*.xls,*.xlsx, *.csv)|*.xls;*.xlsx;*.csv|XLSX (*.xlsx)|*.xlsx|XLS (*.xls)|*.xls|CSV (*.csv)|*.csv"; 
    Диалог.МножественныйВыбор = Ложь;
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ФайлЗагрузкиВыбор(Файлы, Доп) Экспорт
	Если Файлы=Неопределено или Файлы.Количество()=0 Тогда Возврат;КонецЕсли;
	ПолноеИмяФайла = Файлы[0];
	Строки=СтрЗаменить(ПолноеИмяФайла,"\",Символы.ПС);
	ФайлЗагрузки=СтрПолучитьСтроку(Строки, СтрЧислоСтрок(Строки));
	
	ФайлНаДиске = Новый Файл(ПолноеИмяФайла);
	Если НЕ ФайлНаДиске.Существует() Тогда	   
		Сообщить("Файл не существует!");	   
	КонецЕсли;
	
	Попытка	   
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ПолноеИмяФайла);	
		ExcelЛист = Excel.Sheets(НомерЛиста);	   
		ExcelЛист.Activate();
	Исключение	   
		Сообщить("Ошибка при открытии файла Excel. "+ОписаниеОшибки()); 
		Возврат;
	КонецПопытки;
	
	Если Заказ.ВысотаТаблицы>0 Тогда
		ОчиститьЗаказНаСервере(Заказ);
	КонецЕсли;
	
	Состояние("Чтение данных из документа Excel ...");
	Попытка
		xlLastCell = 11;   	
		ActiveCell = Excel.ActiveCell.SpecialCells(xlLastCell);   
		Строк = ActiveCell.Row;
		
		Если ТолькоКолонки Тогда
			// Анализ возможности формирования приходной накладной
			ПоАртикулу=Найти(ВариантПоиска,"Артикул")>0;
			ПоКолонкеБренд=Найти(ВариантПоиска,"Производитель")>0 И Не ПроизводительВДругих 
			И ВариантПоиска<>"АртикулПроизводительВНаименовании";
			ПоИмени=Найти(ВариантПоиска,"Наименовани")>0;

			Ошибка=?(НачальнаяСтрока = 0,"Начальная строка не должна быть равна нулю."+Символы.ПС,"")+
			?(КолонкаАртикула = 0 И ПоАртикулу,"Номер колонки Артикул не должен быть равен нулю."+Символы.ПС,"")+
			?(КолонкаНаименования = 0 И ПоИмени,"Номер колонки Наименование не должен быть равен нулю."+Символы.ПС,"")+
			?(КолонкаПроизводителя = 0 И ПоКолонкеБренд,"Номер колонки производителя не должен быть равен нулю."+Символы.ПС,"")+
			?(КолонкаКоличества = 0,"Номер колонки количества не должен быть равен нулю."+Символы.ПС,"")+
			?(КолонкаЦена = 0 и КолонкаСумма = 0,"Номер колонки ""Цена"" или ""Сумма"" не должен быть равен нулю."+Символы.ПС,"");
			Если Ошибка<>"" Тогда 
				ПоказатьПредупреждение(,Ошибка);
				Состояние();
				Возврат;
			КонецЕсли;
			МаксСтр=0;
			Колонки=Новый СписокЗначений;
			МаксКол=0;
			//ЗагСтр=?(НачальнаяСтрока>1,"R"+Строка(НачальнаяСтрока-1)+"C","R1C");
			ЗагСтр=?(НачальнаяСтрока>1,НачальнаяСтрока-1,1);
			Если КолонкаНаименования>0 Тогда 
				Колонки.Добавить(КолонкаНаименования); 
				Область=Заказ.Область(ЗагСтр,КолонкаНаименования,ЗагСтр,КолонкаНаименования);
				Если КолонкаНаименования = КолонкаПроизводителя И ПроизводительВДругих Тогда
					Область.Текст="Наименование и производитель";Область.ШиринаКолонки=35;
				Иначе
					Область.Текст="Наименование";Область.ШиринаКолонки=25;
				КонецЕсли;
			КонецЕсли;
			Если КолонкаАртикула>0 Тогда 
				Колонки.Добавить(КолонкаАртикула);
				Область=Заказ.Область(ЗагСтр,КолонкаАртикула,ЗагСтр,КолонкаАртикула);
				Если КолонкаАртикула = КолонкаПроизводителя и ПроизводительВДругих Тогда
					Область.Текст="Артикул и производитель";Область.ШиринаКолонки=25;
				Иначе
					Область.Текст="Артикул";Область.ШиринаКолонки=15;
				КонецЕсли;
			КонецЕсли;
			Если КолонкаПроизводителя>0 и Не ПроизводительВДругих Тогда 
				Колонки.Добавить(КолонкаПроизводителя);
				Область=Заказ.Область(ЗагСтр,КолонкаПроизводителя,ЗагСтр,КолонкаПроизводителя);
				Область.Текст="Производитель";Область.ШиринаКолонки=15;
			КонецЕсли;
			Колонки.Добавить(КолонкаКоличества);
			Область=Заказ.Область(ЗагСтр,КолонкаКоличества,ЗагСтр,КолонкаКоличества);
			Область.Текст="Кол-во"; Область.ШиринаКолонки=6;
			
			Если КолонкаЦена>0 Тогда
				Колонки.Добавить(КолонкаЦена);
				Область=Заказ.Область(ЗагСтр,КолонкаЦена,ЗагСтр,КолонкаЦена);
				Область.Текст="Цена"; Область.ШиринаКолонки=10;
			КонецЕсли;
			Если КолонкаНДС>0 Тогда 
				Колонки.Добавить(КолонкаНДС);
				Область=Заказ.Область(ЗагСтр,КолонкаНДС,ЗагСтр,КолонкаНДС);
				Область.Текст="НДС"; Область.ШиринаКолонки=10;
			КонецЕсли;
			Если КолонкаСумма>0 Тогда 
				Колонки.Добавить(КолонкаСумма);
				область=Заказ.Область(ЗагСтр,КолонкаСумма,ЗагСтр,КолонкаСумма);
				Область.Текст="Сумма"; Область.ШиринаКолонки=10;
			КонецЕсли;
			Если КолонкаКодСтраны>0 Тогда 
				Колонки.Добавить(КолонкаКодСтраны);
				Область=Заказ.Область(ЗагСтр,КолонкаКодСтраны,ЗагСтр,КолонкаКодСтраны);
				Область.Текст="Страна"; Область.ШиринаКолонки=10;
			КонецЕсли;
			Если КолонкаНомерГТД>0 Тогда
				Колонки.Добавить(КолонкаНомерГТД);
				Область=Заказ.Область(ЗагСтр,КолонкаНомерГТД,ЗагСтр,КолонкаНомерГТД);
				Область.Текст="НомерГТД";Область.ШиринаКолонки=23;
			КонецЕсли;
			
			Колонки.СортироватьПоЗначению();
			ТекКол=1;
			Для Каждого Кол Из Колонки Цикл
				Если Кол.Значение > ТекКол Тогда
					Заказ.Область(,ТекКол,,Кол.Значение-1).Видимость=Ложь;
				КонецЕсли;
				ТекКол=Кол.Значение+1;
			КонецЦикла;
			
			Если НачальнаяСтрока>2 Тогда
				Заказ.Область(1,,Начальнаястрока-2).Видимость=ложь;
			КонецЕсли;
				
			Для СтрНом = НачальнаяСтрока По Строк Цикл
				Если (СтрНом-МаксСтр)>50 И МаксСтр>2 Тогда Прервать;КонецЕсли;
				СтрН=Формат(СтрНом,"ЧГ=");
				Для Каждого Кол из Колонки Цикл
					КолНом=Кол.Значение;
					Текст=ExcelЛист.Cells(СтрНом,КолНом).Text;
					Если Не ПустаяСтрока(Текст) Тогда
						МаксСтр=СтрНом;
						Заказ.Область(СтрНом,КолНом,СтрНом,КолНом).Текст = Текст;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
			
		Иначе	
			Колонок = ActiveCell.Column + ActiveCell.Count - 1;
			Для КолНом = 1 По Колонок Цикл
				Заказ.Область("C"+КолНом).ШиринаКолонки=ExcelЛист.Columns(КолНом).ColumnWidth;
			КонецЦикла;
			
			МаксСтр=0;
			Для СтрНом = 1 По Строк Цикл
				Если (СтрНом-МаксСтр)>50 И МаксСтр>2 Тогда Прервать;КонецЕсли;
				СтрН=Формат(СтрНом,"ЧГ=");
				Для КолНом = 1 По Колонок Цикл
					Ячейка="R"+СтрН+"C"+КолНом;
					Текст=ExcelЛист.Cells(СтрНом,КолНом).Text;
					Если Не ПустаяСтрока(Текст) Тогда
						МаксСтр=СтрНом;
						Заказ.Область(Ячейка+":"+Ячейка).Текст = Текст;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	Состояние();
    Excel.DisplayAlerts = 0;
    Excel.Quit();
    Excel.DisplayAlerts = 1;
	Excel = Неопределено;
	НачальнаяСтрокаПриИзменении(Неопределено);
КонецПроцедуры

&НаСервере
Процедура ОчиститьЗаказНаСервере(Заказ)
	Заказ.Очистить();
	Заказ.Область().Видимость=Истина;
	Заказ.ФиксацияСверху=0;
КонецПроцедуры

&НаКлиенте
Процедура НачальнаяСтрокаПриИзменении(Элемент)
	Заказ.ТекущаяОбласть=Заказ.Область(1,1);
	Заказ.ФиксацияСверху=?(НачальнаяСтрока>1,НачальнаяСтрока-1,0);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ТекДан=Элементы.Товары.ТекущиеДанные;
	Оповещение=Новый ОписаниеОповещения("ТоварыНаименованиеВыбор",ЭтаФорма,ТекДан);
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("РежимВыбора",Истина);
	Если ЗначениеЗаполнено(ТекДан.Номенклатура) Тогда
		ПараметрыВыбора.Вставить("ТекущаяСтрока",ТекДан.Номенклатура);
		//ПараметрыВыбора.Вставить("УстановитьПараметрыФункциональныхОпцийФормы",Новый Структура("ТекущаяСтрока",ТекДан.Номенклатура));
	КонецЕсли;
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора",ПараметрыВыбора,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаименованиеВыбор(Номенклатура,ТекДан) Экспорт
	Если Номенклатура<>Неопределено тогда 
		ТекДан.Номенклатура=Номенклатура;
		ТекДан.Наименование=Строка(Номенклатура);
		ЗаполнитьЗначенияСвойств(ТекДан,ТоварыНаименованиеВыборНаСервере(Номенклатура));
		ТоварыПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
Конецпроцедуры

&НаСервере
Функция ТоварыНаименованиеВыборНаСервере(Номенклатура)
	ТекДан=Новый Структура();
	Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("Артикул")<>Неопределено Тогда
		ТекДан.Вставить("Артикул",Номенклатура.Артикул);
	КонецЕсли;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Стр=Обработка.ПолучитьПроизводителяНоменклатуры(Номенклатура);
	Если Стр<>Неопределено и Стр.Свойство("ссылка") Тогда
		ТекДан.Вставить("Производитель",Строка(Стр.Ссылка));
	    ТекДан.Вставить("Бренд",Строка(Стр.Ссылка));
	КонецЕсли;
	
	Возврат ТекДан;
КонецФункции

&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
	Текдан=Элементы.Товары.ТекущиеДанные;
	Если Текдан<>Неопределено Тогда
		Элементы.ТоварыНаименование.КнопкаОткрытия=Не ТекДан.Номенклатура.Пустая();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаименованиеОчистка(Элемент, СтандартнаяОбработка)
	Элементы.Товары.ТекущиеДанные.Номенклатура=ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	ТоварыПриАктивизацииСтроки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНаименованиеОткрытие(Элемент, СтандартнаяОбработка)
	Номенклатура=Элементы.Товары.ТекущиеДанные.Номенклатура;
	Если Не Номенклатура.Пустая() Тогда
		ПараметрыФормы=Новый Структура("Ключ",Номенклатура);
		ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",ПараметрыФормы);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТоварыПроизводительПриИзмененииНаСервере(Производитель)
	Синонимы = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Синонимы",,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
	Если Синонимы<>Неопределено Тогда
		СтрБренд=Синонимы.Найти(Производитель,"Синоним");
	КонецЕсли;
	Возврат ?(СтрБренд<>Неопределено,СтрБренд.Бренд,Производитель);
КонецФункции

&НаКлиенте
Процедура ТоварыПроизводительПриИзменении(Элемент)
    Бренд=ВРЕГ(Элементы.Товары.ТекущиеДанные.Производитель);
	Если Объект.ИспользоватьСинонимы И Не Пустаястрока(Бренд) Тогда
		Бренд=ТоварыПроизводительПриИзмененииНаСервере(Бренд);
	КонецЕсли;
	Элементы.Товары.ТекущиеДанные.Бренд = Бренд;
	Элементы.Товары.ТекущиеДанные.Производитель = Бренд;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ТекДан=Элементы.Товары.ТекущиеДанные;
	ТекДан.Сумма=ТекДан.Количество*ТекДан.Цена;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	Если Настройки.Количество()=0 Тогда
		Сообщить("Нет сохраненных настроек");
	Иначе
		Оповещение=Новый ОписаниеОповещения("ЗагрузкаНастройки",ЭтаФорма);
		ПараметрыФормы=Новый Структура("СписокЗначений,Групповой,ТекущаяСтрока,Заголовок",
		Настройки,Ложь,0,"Загрузить настройки");
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
		ПараметрыФормы,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаНастройки(Строка,Доп) Экспорт
	Если Строка<>Неопределено Тогда
		ИмяНастройки=Строка.Представление;
		ЗаполнитьЗначенияСвойств(ЭтаФорма,Строка.Значение);
		//Элементы.ПроизводительВДругих.Доступность=КолонкаЦена<>0;
		НачальнаяСтрокаПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкиНаСервере(Настройки)
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","ПоступлениеТовара",Настройки,,ПользователиИнформационнойБазы.ТекущийПользователь().Имя);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	Если ПустаяСтрока(ИмяНастройки) и ЗначениеЗаполнено(Контрагент) Тогда
		ИмяНастройки=Строка(Контрагент);
	КонецЕсли;
	Оповещение=Новый ОписаниеОповещения("СохранениеНастройки",ЭтаФорма);
	ПоказатьВводСтроки(Оповещение, ИмяНастройки, "Введите имя настройки", 25);
КонецПроцедуры

&НаКлиенте
Процедура СохранениеНастройки(Строка,Доп) Экспорт
	Если Строка=Неопределено Тогда Возврат;КонецЕсли;
	СтрНастройки=Неопределено;
	Для Каждого Стр Из Настройки Цикл
		Если Стр.Представление=Строка Тогда
			СтрНастройки=Стр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	
	Если СтрНастройки<>Неопределено Тогда
		ЕСли Строка <> ИмяНастройки Тогда
			Оповещение=Новый ОписаниеОповещения("СохранениеНастроек",ЭтаФорма,СтрНастройки);
			ПоказатьВопрос(Оповещение, "Настрока с именем: "+Строка+" уже существует. Перезаписать настройку?",	РежимДиалогаВопрос.ДаНет);
		Иначе
			СохранениеНастроек(КодВозвратаДиалога.Да,СтрНастройки);
		КонецЕсли;
	Иначе
		СтрНастройки=Настройки.Добавить(Неопределено,Строка);
		СохранениеНастроек(КодВозвратаДиалога.Да,СтрНастройки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранениеНастроек(Ответ,СтрНастройки) Экспорт
	Если Ответ=КодВозвратаДиалога.Да Тогда
		СтрНастройки.Значение=Новый Структура("АртикулДоСимвола, БрендПустой, Валюта, ВариантПоиска, ВариантПриемкиТоваров, 
		|ЗакупкаПодДеятельность, ПроизводительВДругих,Контрагент, КолонкаНомерГТД, КолонкаКодСтраны,
		|КолонкаАртикула, КолонкаКоличества, КолонкаНаименования, КолонкаПроизводителя, КолонкаСумма,
		|КолонкаЦена, НачальнаяСтрока, НДСВЦене, НомерЛиста, ОбновлятьНоменклатуруИзБК, Организация,
		|Операция, Подразделение, Склад, СтавкаНДС, ТипНалогообложенияНДС, КолонкаНДС,
		|ЗаменаЧто, ЗаменаНа, ЦенаСНДС, СуммаСНДС, ТолькоКолонки
		|");
		ЗаполнитьЗначенияСвойств(СтрНастройки.Значение, ЭтаФорма);
		СохранитьНастройкиНаСервере(Настройки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверкаДанныхНаСервере(Заказ,Настройка)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	ответ=Обработка.ПоступлениеТовараПроверка(Заказ,Настройка, Товары); 
	Возврат ответ;  
КонецФункции

&НаКлиенте
Процедура ПроверкаДанных(Команда)
	
	// Анализ возможности формирования приходной накладной
	ПоАртикулу=Найти(ВариантПоиска,"Артикул")>0;
	ПоКолонкеБренд=Найти(ВариантПоиска,"Производитель")>0 И Не ПроизводительВДругих 
	И ВариантПоиска<>"АртикулПроизводительВНаименовании";
	ПоИмени=Найти(ВариантПоиска,"Наименовани")>0;

	Ошибка=?(НачальнаяСтрока = 0,"Начальная строка не должна быть равна нулю."+Символы.ПС,"")+
	?(КолонкаАртикула = 0 И ПоАртикулу,"Номер колонки Артикул не должен быть равен нулю."+Символы.ПС,"")+
	?(КолонкаНаименования = 0 И ПоИмени,"Номер колонки Наименование не должен быть равен нулю."+Символы.ПС,"")+
	?(КолонкаПроизводителя = 0 И ПоКолонкеБренд,"Номер колонки производителя не должен быть равен нулю."+Символы.ПС,"")+
	?(КолонкаКоличества = 0,"Номер колонки количества не должен быть равен нулю."+Символы.ПС,"")+
	?(КолонкаЦена = 0 и КолонкаСумма = 0,"Номер колонки ""Цена"" или ""Сумма"" не должен быть равен нулю."+Символы.ПС,"")+
	?(Заказ.ВысотаТаблицы < НачальнаяСтрока,"Нет данных в таблице заказа"+Символы.ПС,"");
	Если Ошибка<>"" Тогда 
		ПоказатьПредупреждение(,Ошибка);
		Возврат;
	КонецЕсли;
   	Настройка=Новый Структура("АртикулДоСимвола, БрендПустой, 
	|ВариантПоиска, ПроизводительВДругих, КолонкаАртикула, КолонкаНомерГТД, КолонкаКодСтраны,
	|КолонкаКоличества, КолонкаНаименования, КолонкаПроизводителя, 
	|КолонкаСумма, КолонкаЦена, НачальнаяСтрока, НомерЛиста, ЗаменаЧто,ЗаменаНа, КолонкаНДС, 
	|СтавкаНДС, НДСВЦене, ЦенаСНДС, СуммаСНДС");
	ЗаполнитьЗначенияСвойств(Настройка, ЭтаФорма);
	Состояние("Выполняется проверка данных. Ждите...");

	Ошибка=ПроверкаДанныхНаСервере(Заказ, Настройка);
	Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаПроверкиДанных;
КонецПроцедуры

&НаСервере
Процедура СоздатьНоменклатуруНаСервере(Настройка)
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПоступлениеТовараСоздатьНоменклатуры(Товары,Настройка)
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНоменклатуру(Команда)
	ЕСли Не ЗначениеЗаполнено(Объект.ГруппаНоменклатуры) ТОгда
		Сообщить("Отсутствует определение группы номенклатуры для нового товара. Перейдите в настройки программы на вкладку - Значения Номенклатуры.");
		Возврат;
	КонецЕсли;
	Настройка=Новый Структура("ВариантПоиска,ОбновлятьНоменклатуруИзБК",ВариантПоиска,ОбновлятьНоменклатуруИзБК);
	СоздатьНоменклатуруНаСервере(Настройка);
КонецПроцедуры

&НаСервере
Функция СоздатьДокументНаСервере(Настройка)
	Обработка = РеквизитФормыВЗначение("Объект");
	МетаДок=Метаданные.Документы[Настройка.ТипДокумента];
	Если Обработка.ЕстьРеквизит1С(МетаДок,"Партнер") Тогда
		СпрПартнер = Справочники.Партнеры.НайтиПоКоду(Настройка.Контрагент.Партнер.Код);
		Настройка.Вставить("Партнер", СпрПартнер);
		Если Обработка.ЕстьРеквизит1С(МетаДок,"Соглашение") 
			И Метаданные.ОбщиеМодули.Найти("ЗакупкиСервер")<>Неопределено Тогда
			Попытка
				УсловияЗакупокПоУмолчанию = Вычислить("ЗакупкиСервер.ПолучитьУсловияЗакупокПоУмолчанию(СпрПартнер, 
				|Новый Структура(""УчитыватьГруппыСкладов,ИсключитьГруппыСкладовДоступныеВЗаказах,ВыбранноеСоглашение"", 
				|Истина, Истина, Справочники.СоглашенияСПоставщиками.ПустаяСсылка()))");
				Если УсловияЗакупокПоУмолчанию <> Неопределено Тогда	
					Если ЗначениеЗаполнено(УсловияЗакупокПоУмолчанию.Соглашение) Тогда
						Настройка.Вставить("Соглашение", УсловияЗакупокПоУмолчанию.Соглашение);
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат Обработка.ПоступлениеТовараСоздатьДокумент(Товары,Настройка);
КонецФункции

&НаКлиенте
Процедура СоздатьДокумент(Команда)
	Ошибки=?(ЗначениеЗаполнено(Контрагент),"","Не определен Контрагент"+Символы.ПС);
	Для Каждого Стр Из Товары Цикл
		Ошибки=Ошибки+?(Не ЗначениеЗаполнено(Стр.Номенклатура),"НПП: "+Стр.НПП+" - не определена номенклатура"+Символы.ПС,
		?(Стр.Количество=0,"НПП: "+Стр.НПП+" - не определено Количество"+Символы.ПС,
		?(Стр.Цена=0,"НПП: "+Стр.НПП+" - не определена Цена"+Символы.ПС,"")));
	КонецЦикла;
	Если Ошибки<>"" Тогда
		ПоказатьПредупреждение(,Ошибки);
		Возврат;
	КонецЕсли;
   	Настройка=Новый Структура("Валюта, ВариантПриемкиТоваров, ЗакупкаПодДеятельность, 
	|Контрагент, НДСВЦене, Организация, Операция, Подразделение,
	|Склад, СтавкаНДС, ТипНалогообложенияНДС,ТипДокумента");
	ЗаполнитьЗначенияСвойств(Настройка, ЭтаФорма);
	Документ=СоздатьДокументНаСервере(Настройка);
	Если Документ<>Неопределено Тогда
		ПолучитьФорму("Документ."+ТипДокумента+".ФормаОбъекта",Новый Структура("Ключ",Документ)).Открыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНастройки(Команда)
	ЗаполнитьЗначенияСвойств(ЭтаФорма.Объект,ЭтаФорма.ВладелецФормы.Объект,
	"КроссПодключен,ОрганизацияДляЗаявки,Склад,БанковскийСчетДляЗаявки,Конфигурация,НДСПоУмолчанию,
	|ГруппаНоменклатуры,ИспользоватьСинонимы,РеквизитНомераДляПоиска,ШаблонНомераДляПоиска,ТипЦенЗакупка,
	|ШаблонНаименования,ШаблонНаименованияП,ВидНоменклатуры,ЦеноваяГруппа,НДСПоУмолчанию,
	|БазоваяЕдиницаИзмерения, АртикулОчищать, СтрокаПодключенияКроссов, КодСеанса,ВнешняяОбработка");
КонецПроцедуры

#КонецОбласти
