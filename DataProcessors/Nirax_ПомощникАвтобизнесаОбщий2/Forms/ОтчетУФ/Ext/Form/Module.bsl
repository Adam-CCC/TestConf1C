&НаКлиенте
// Процедура сохраняет табличный документ в формате HTML под введенным пользователем именем файла
Процедура КомандаСохранитьКакHTML(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок      = "Сохранение веб-страницы";
	Диалог.Фильтр         = "Веб-страница (*.html)|*.html";
	Диалог.ПолноеИмяФайла = ПолучитьНаименованиеОтчета();
	
	Если Диалог.Выбрать() Тогда
		Если НЕ ПустаяСтрока(Диалог.ПолноеИмяФайла) Тогда
			ТабличныйДокумент.Записать(Диалог.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.HTML);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКакPDF(ИмяФайла)
	
	ТабличныйДокумент.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
	
КонецПроцедуры

&НаКлиенте
// Процедура сохраняет табличный документ 
Процедура СохранитьФайл(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок  = "Сохранение файла";
	Диалог.Расширение = "xlsx";
	Диалог.Фильтр = "Excel(*.xlsx)|*.xlsx|Табличный документ(*.mxl)|*.mxl|PDF(*.pdf)|*.pdf|WORD(*.docx)|*.docx|ODS(*.ods)|*.ods|Текстовый(*.txt)|*.txt|WEB(*.html)|*.html";
	Диалог.ПолноеИмяФайла = ПолучитьНаименованиеОтчета();
	ОО = Новый ОписаниеОповещения("СохранениеФайла",ЭтаФорма);
	Диалог.Показать(ОО);
КонецПроцедуры

&НаКлиенте
Процедура СохранениеФайла(Файлы) Экспорт
	Если Файлы=Неопределено Тогда возврат;КонецЕсли;
	ПолноеИмяФайла=Файлы[0];
	Поз=СтрНайти(ПолноеИмяФайла,".",НаправлениеПоиска.СКонца);
	Расширение=ВРег(Сред(ПолноеИмяФайла,Поз+1));
	ТипФайла=ТипФайлаТабличногоДокумента[Расширение];
	ТабличныйДокумент.Записать(ПолноеИмяФайла,ТипФайла);
КонецПроцедуры

