&НаКлиенте
Процедура СформироватьЗапрос()
	Условие="idUser="+Формат(КодПользователя,"ЧГ=");
	Если Период.ДатаНачала>='20200101' Тогда 
		Условие=Условие+" AND date>='"+Формат(Период.ДатаНачала,"ДФ=""гггг-ММ-дд ЧЧ:мм:сс""")+"'";
	КонецЕсли;
	Если Период.ДатаОкончания<>'00010101' Тогда 
		Условие=Условие+" AND date<='"+Формат(Период.ДатаОкончания,"ДФ=""гггг-ММ-дд ЧЧ:мм:сс""")+"'";
	КонецЕсли;
	Запрос=Новый Структура("action, table, select, where, order ", "load", "analytics.primary", 
	"date as Дата, article as Артикул, manufacturer as Производитель, articleName as Номенклатура, 
	|supplierName as Поставщик, supplierStore as СкладПоставщика, deliveryDay as СрокПоставки, 
	|count as Количество, count*priceIn as СуммаПоставки, count*priceOut as СуммаПродажи,count*(priceOut-priceIn) as Прибыль,
	|company as Организация, userName as Менеджер, stockAvailability as Наличие",
	Условие, "manufacturer, article");
	ВладелецФормы.СендерОтправить(Запрос);
	Элементы.Сформировать.Доступность=Ложь;
	Элементы.Сформировать.ЦветФона=Новый Цвет(200,200,200);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьТаблицу(Данные) Экспорт
	Перем Производитель,Артикул;
	Товар=Новый Структура("Номенклатура,Группа","","");
	ТаблицаДанных.Очистить();
	Для Каждого Стр Из Данные Цикл
		Нов=ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Стр);
		Если Артикул<>Стр.Артикул или Производитель<>Стр.Производитель Тогда
			Артикул=Стр.Артикул; Производитель=Стр.Производитель;
			Товар.Номенклатура=Артикул+" "+Стр.Номенклатура+" *"+Производитель;
			//ЗаполнитьТовар(Артикул, Производитель,Товар);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Нов,Товар);
	КонецЦикла;
	Элементы.Сформировать.Доступность=Истина;
	Элементы.Сформировать.ЦветФона=Новый Цвет(255,255,0);
	//СкомпоноватьРезультат(ТабличныйДокумент);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТовар(Артикул, Производитель,Товар)
	Запрос=Новый Запрос(имяРеквизита.Запрос);
	Запрос.УстановитьПараметр("Артикул",Артикул);
	Запрос.УстановитьПараметр("Производитель",Производитель);
	Выб=Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Товар.Номенклатура=Выб.Номенклатура;
		Товар.Группа=?(имяРеквизита.Свойство("Родитель"),Товар.Номенклатура.Родитель,Справочники.Номенклатура.ПустаяСсылка());
	Иначе
		Товар.Группа=Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ЭтаФорма.Заголовок=ПолучитьНаименованиеОтчета();
	СформироватьЗапрос();
	Если Элементы.ТабличныйДокумент.ОтображениеСостояния.Видимость = Ложь Тогда
		УправлениеДиалогом(Истина);
	КонецЕсли;
КонецПроцедуры


