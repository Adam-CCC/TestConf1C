Функция НайтиСоздатьДоговор(ТекКонтрагент,ТекОрганизация,ТекПодразделение)
	
	НовДог = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыВзаиморасчетов.Ссылка,
	               |	ДоговорыВзаиморасчетов.Владелец,
	               |	ДоговорыВзаиморасчетов.Организация,
	               |	ДоговорыВзаиморасчетов.ВидДоговора
	               |ИЗ
	               |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	               |ГДЕ
	               |	ДоговорыВзаиморасчетов.Владелец = &Владелец
	               |	И ДоговорыВзаиморасчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Продажа)
	               |	И ДоговорыВзаиморасчетов.Организация = &Организация";
	 
	Запрос.УстановитьПараметр("Владелец",ТекКонтрагент);
 	Запрос.УстановитьПараметр("Организация",ТекОрганизация);
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовДог = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	НовДог.УстановитьНовыйКод();
	НовДог.ВидДоговора=Перечисления.ВидыДоговоров.Продажа;
	НовДог.Владелец = ТекКонтрагент;
	НовДог.Организация = ТекОрганизация;
	НовДог.Подразделение = ТекПодразделение;
	НовДог.Владелец = ТекКонтрагент;
	НовДог.ДатаНачала = ТекущаяДата();
 	НовДог.Наименование = СокрЛП(НовДог.ВидДоговора)+" от "+Формат(НовДог.ДатаНачала,"ДЛФ=D"); 
	НовДог.Автор = ПараметрыСеанса.Пользователь;
	НовДог.ДатаСоздания = ТекущаяДата();
	НовДог.ВидОплаты = Перечисления.ВидыОплаты.ПроизвольнаяОплата;
	НовДог.Комментарий = "Договор создан обработкой пользователем: "+ПараметрыСеанса.Пользователь+" "+Формат(ТекущаяДата(),"ДЛФ=DDT");
	НовДог.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Попытка
		НовДог.Записать();
		#Если Клиент Тогда 
		Сообщить("Записан новый договор "+НовДог);
		#КонецЕсли
	Исключение
		#Если Клиент Тогда 
		Сообщить("ОШИБКА! Не удалось записать новый договор ЗаказПокупателя ",СтатусСообщения.ОченьВажное);	
		#КонецЕсли
	  //Форма = НовДог.ПолучитьФорму("ФормаЭлемента");
	  //Если Не Форма.Открыта() Тогда
	  //      Форма.Открыть();
	  //КонецЕсли; 
  	КонецПопытки; 
	
	Возврат НовДог.Ссылка;

КонецФункции // НайтиСоздатьДоговор(Справочники.Контрагенты.ОсновнойПокупатель,ПараметрыСеанса.ПодразделениеКомпании.Организация);()

Функция НайтиПравильноеПодразделение(Орг,Подр)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка,
		|	ПодразделенияКомпании.Организация,
		|	ПодразделенияКомпании.Родитель
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Родитель = &Родитель
		|	И ПодразделенияКомпании.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Родитель", Подр);
	Запрос.УстановитьПараметр("Организация", Орг);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Подр
 
КонецФункции // НайтиПравильноеПодразделение()
 
 


