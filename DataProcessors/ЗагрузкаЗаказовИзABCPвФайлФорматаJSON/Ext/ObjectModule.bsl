Функция НайтиСоздатьЗаказПокупателя(Идент)
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Комментарий,
		|	ЗаказПокупателя.Ссылка,
		|	ЗаказПокупателя.Дата,
		|	ЗаказПокупателя.ПометкаУдаления,
		|	ЗаказПокупателя.UIDсайта
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.ПометкаУдаления = ЛОЖЬ
		|	И ЗаказПокупателя.UIDсайта = &Идент";
	
 	Запрос.УстановитьПараметр("Идент",Идент);
	//Запрос.УстановитьПараметр("ДатаНач",НачалоДня(ПериодОбработки.ДатаНачала   ));
	//Запрос.УстановитьПараметр("ДатаКон", КонецДня(ПериодОбработки.ДатаОкончания));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		#Если Клиент Тогда 
		Сообщить("Найден документ "+ВыборкаДетальныеЗаписи.Ссылка+" c UIDсайта = "+Идент);
		#КонецЕсли
		Возврат ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	
	НовДок = Документы.ЗаказПокупателя.СоздатьДокумент();
	
	НовДок.UIDсайта = Идент;
	
	НовДок.Дата = ТекущаяДата();
	НовДок.Автор = ПараметрыСеанса.Пользователь;
	НовДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций;
	НовДок.КурсДокумента = 1.0;
	НовДок.КурсВалютыУпр = 1.0;
	НовДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	НовДок.ДатаСоздания = ТекущаяДата();
