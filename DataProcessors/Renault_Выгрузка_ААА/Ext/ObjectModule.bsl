////@+ Функция СформироватьСтроку112(ЗаказНаряд)
// Дата создания - 31.05.2012 12:19:07;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку с номером 112 - данные о контрагенте ФИО
//
// Параметры
//  Парам1 ЗаказНаряд  - ЗаказНаряд  - ДокументСсылка.ЗаказНаряд - Ссылка на выгружаемый заказ-наряд
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка
//
//@-
Функция СформироватьСтроку112(ЗаказНаряд) 
	
	//Первоначальная инициализация
	ТекСтрока = неопределено;
	
	Контрагент = ЗаказНаряд.Ссылка.Заказчик;
	Если НЕ ЗначениеЗаполнено(Контрагент) тогда 
		Если ЗаказНаряд.OTS тогда
			Возврат ""; 
		ИначеЕсли ЗаказНаряд.Гарантия и НЕ ЗаказНаряд.OTS тогда //Гарантия но не отзывная нота
			Контрагент = ЗаказНаряд.Ссылка.Заказчик;
		КонецЕсли;
	КонецЕсли;
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(ЗаказНаряд);

	ТекСтрока = ТекСтрока + "000000"; //Invoice number issued by the dealer
	ТекСтрока = ТекСтрока + "0";      //Operation Character in repair order
	ТекСтрока = ТекСтрока + "00";     //Rank number of the fixed price in the operation
	ТекСтрока = ТекСтрока + "112";    //Line code
	
	
	ТекСтрока = ТекСтрока + EDR_КешируемыеЗначения.ПолучитьТипВладельца(Контрагент.ФормаСобственности);
	ТекСтрока = ТекСтрока + "P"; //Customer/vehicle relation
	
	/// Над следующими параметрами необходимо поработать еще.
	Если НЕ Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо тогда
		МассивИмени = Renault_ОбщийМодуль.РазложитьСтрокуВСписок(СокрЛП(Контрагент.НаименованиеПолное), " ");
	Иначе
		МассивИмени = Новый Массив;
		МассивИмени.Добавить(СокрЛП(Контрагент.Наименование));
	КонецЕсли;
	
	Попытка
		Если ФормироватьДанныеКлиентов Тогда
			Фамилия = МассивИмени[0];
		Иначе
			Фамилия = " ";
		КонецЕсли;
	Исключение
		Фамилия = " ";
	КонецПопытки;
	
	Попытка
		Если ФормироватьДанныеКлиентов Тогда
			Имя = МассивИмени[1];
		Иначе
			Имя = " ";
		КонецЕсли;
	Исключение
		Имя = " ";
	КонецПопытки;
	
	Попытка
		Если ФормироватьДанныеКлиентов Тогда
			Отчество = МассивИмени[2];
		Иначе
			Отчество = " ";
		КонецЕсли;
	Исключение
		Отчество = " ";
	КонецПопытки;
	
	//Полное наименование
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Фамилия,108); //Customer surname or corporate name
	ТекСтрока = ТекСтрока + "RU"; //Customer language
		                     
	ТекСтрока = ТекСтрока + "          "; //Distinction 1
	ТекСтрока = ТекСтрока + "          "; //Distinction 2
	
	//Second name
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Имя,60);
	
	//First name
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Отчество,25);
	ТекСтрока = ТекСтрока + "          "; //Initials
	ТекСтрока = ТекСтрока + "        "; //Date of birth
	ТекСтрока = ТекСтрока + " "; //Marital status
	ТекСтрока = ТекСтрока + "    "; //Title
	ТекСтрока = ТекСтрока + " "; //Gender
	ТекСтрока = ТекСтрока + "  "; //Individual or company type
	ТекСтрока = ТекСтрока + "        "; //Date of ownership or date of renting or date of use
	ТекСтрока = ТекСтрока + "  "; //Identifier type of renting
	ТекСтрока = ТекСтрока + "  "; //Stop communication mail
	ТекСтрока = ТекСтрока + "  "; //Stop communication e-mail
	ТекСтрока = ТекСтрока + "  "; //Stop communication fax
	ТекСтрока = ТекСтрока + "  "; //Stop communication phone
	ТекСтрока = ТекСтрока + "    "; //Stop communication support 1
	ТекСтрока = ТекСтрока + "    "; //Stop communication support 2
	ТекСтрока = ТекСтрока + "O "; //Customer agreement
	ТекСтрока = ТекСтрока + "E "; //Preferred support type
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;
	
КонецФункции // СформироватьСтроку112(ЗаказНаряд)

////@+ Функция СформироватьСтроку113(ЗаказНаряд)
// Дата создания - 31.05.2012 12:21:54;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку с номером 113 - данные о контрагенте Адрес фактический
//
// Параметры
//  Парам1 ЗаказНаряд  - ДокументСсылка.ЗаказНаряд - Ссылка на выгружаемый заказ-наряд
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) -  Результирующая строка
//
//@-
Функция СформироватьСтроку113(ЗаказНаряд) 
	
	//Первоначальная инициализация
	ТекСтрока = неопределено;
	
	Контрагент = ЗаказНаряд.Ссылка.Заказчик;
	Если НЕ ЗначениеЗаполнено(Контрагент) тогда
		Если ЗаказНаряд.OTS тогда
			Возврат "" 
		ИначеЕсли ЗаказНаряд.Гарантия и НЕ ЗаказНаряд.OTS тогда //Гарантия но не отзывная нота
			Контрагент = ЗаказНаряд.Ссылка.Заказчик;
		КонецЕсли;
	КонецЕсли;

	КонтактнаяИнформация = EDR_КешируемыеЗначения.ПолучитьКонтакты(Контрагент);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
	Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.АдресФактический);
	
	ВыбАдрес = КонтактнаяИнформация.НайтиСтроки(Отбор);

	Если НЕ ВыбАдрес.Количество() = 0 Тогда 
		
		//Формируем начало строки
		ТекСтрока = ПолучитьЗаголовокСтроки(ЗаказНаряд);
		
		ТекСтрока = ТекСтрока + "000000";
		ТекСтрока = ТекСтрока + "0";
		ТекСтрока = ТекСтрока + "00";
		ТекСтрока = ТекСтрока + "113";
		
		Выборка = ВыбАдрес[0];
		
		Если НЕ ФормироватьДанныеКлиентов Тогда
			Выборка.Поле1 = " ";
			Выборка.Поле2 = " ";
			Выборка.Поле3 = " ";
			Выборка.Поле4 = " ";
			Выборка.Поле5 = " ";
			Выборка.Поле6 = " ";
		КонецЕсли;
		
		//Если НЕ ЗначениеЗаполнено(Выборка.Поле6) Тогда
		//	
		//	Возврат "";
		//	
		//КонецЕсли;
		
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле6, 50);//Street name
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("  ", 2);//Province code
		Если ЗначениеЗаполнено(Выборка.Поле1) Тогда
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле1, 9);//Post code
		Иначе
			ТекСтрока = ТекСтрока + ДополнитьСтроку("400000", 9, " ");
		КонецЕсли;
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("RUS", 3);//Country
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("   ", 3);//Road type
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("0", 5, "0");//Street number
		
		Если ЗначениеЗаполнено(Выборка.Поле5) тогда
			
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле2, 35);//Address extension 1
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле3, 35);//Address extension 2
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле4, 35);//Address extension 3
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле5, 35);//City
		Иначе
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("", 35);//Address extension 1
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("", 35);//Address extension 2
			ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("", 35);//Address extension 3
			
			Если НЕ Найти(ВРег(Выборка.Поле2), "МОСК") = 0 
			 или НЕ Найти(ВРег(Выборка.Поле2), "ПЕТЕР") = 0 тогда //Москва и Питер идут не городами, а областями
				ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле2, 35);//City
			Иначе
				ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Поле4, 35);//City
			КонецЕсли;
		КонецЕсли;
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку( , 4);//District code
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку( , 5);//Municipality code
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку( , 9);//Mail rebate code
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку( , 1);//Private Data Inputted Indicator
		
		Пока СтрДлина(ТекСтрока) < 300 Цикл
			ТекСтрока = ТекСтрока + " ";		//Filled up to 300
		КонецЦикла;
		
		КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
		Возврат ТекСтрока;
	КонецЕсли;
	
	Возврат ТекСтрока;
	
КонецФункции // СформироватьСтроку113(ЗаказНаряд)

////@+ Функция СформироватьСтроку114(ЗаказНаряд)
// Дата создания - 31.05.2012 12:24:39;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку с номером 114 - данные о контрагенте email и телефоны
//
// Параметры
//  Парам1 ЗаказНаряд  - ЗаказНаряд  - ДокументСсылка.ЗаказНаряд - Ссылка на выгружаемый заказ-наряд
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка
//
//@-
Функция СформироватьСтроку114(ЗаказНаряд) 
	
	//Первоначальная инициализация
	ТекСтрока = неопределено;
	
	Контрагент = ЗаказНаряд.Ссылка.Контрагент;
	Если НЕ ЗначениеЗаполнено(Контрагент) тогда 
		Если ЗаказНаряд.OTS тогда
			Возврат "" 
		ИначеЕсли ЗаказНаряд.Гарантия и НЕ ЗаказНаряд.OTS тогда //Гарантия но не отзывная нота
			Контрагент = ЗаказНаряд.Ссылка.Заказчик;
		КонецЕсли;
	КонецЕсли;

	КонтактнаяИнформация = EDR_КешируемыеЗначения.ПолучитьКонтакты(Контрагент);
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(ЗаказНаряд);

	ТекСтрока = ТекСтрока + "000000";
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + "00";
	ТекСтрока = ТекСтрока + "114";
	
	////////////////////////////////////////
	// выбираем E-mail
	Отбор = Новый Структура;
	Отбор.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	
	ВыбАдрес = КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если НЕ ВыбАдрес.Количество() = 0 И ФормироватьДанныеКлиентов Тогда
		Выборка = ВыбАдрес[0];
		
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Выборка.Представление ,100);//E-mail
	Иначе
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" " ,100);//E-mail
	КонецЕсли;
	
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" " ,5);	//P.O. Box number		
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" " ,9);	//P.O. Box post code	
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" " ,35);	//P.O. Box city name	
	
	////////////////////////////////////////
	// выбираем телефоны
	Отбор = Новый Структура;
	Отбор.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	
	ВыбАдрес = КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если НЕ ВыбАдрес.Количество() = 0 И ФормироватьДанныеКлиентов Тогда
		Выборка = ВыбАдрес[0];
		
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(
												""+Строка(Выборка.Поле1)+" " +Строка(Выборка.Поле2) ,6); //Dialling code 1
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(Выборка.Поле3) ,15);			 //Phone number 1
	Иначе
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",6);
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",15);
	КонецЕсли;
	
	//Посмотрим наличие второго телефона
	Если ВыбАдрес.Количество() > 1 И ФормироватьДанныеКлиентов Тогда
		Выборка = ВыбАдрес[1];
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(
												""+Строка(Выборка.Поле1)+" " +Строка(Выборка.Поле2) ,6); //Dialling code 2
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(Выборка.Поле3) ,15);			 //Phone number 2
	Иначе
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",6);
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",15);
	КонецЕсли;

	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",6);  //Dialling code 3
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",15); //Phone number 3
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;
	
КонецФункции // СформироватьСтроку114(ЗаказНаряд)

