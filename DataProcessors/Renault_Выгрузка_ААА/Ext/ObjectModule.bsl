	                      |	EDR_Invoices.Invoice КАК Счет,
	                      |	EDR_Interventions.Intervention,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
