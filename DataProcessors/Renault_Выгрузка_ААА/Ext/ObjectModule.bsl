Функция ДополнитьСтроку(вхСтрока, НужнаяДлина, Заполнитель = " ", ОтсекатьСправа = Истина)
	
	Если СтрДлина(вхСтрока)> НужнаяДлина Тогда
		Если ОтсекатьСправа = Истина Тогда
			Возврат Лев(вхСтрока,НужнаяДлина);
		Иначе
			Возврат Прав(вхСтрока,НужнаяДлина);
		КонецЕсли;
	ИначеЕсли СтрДлина(вхСтрока)< НужнаяДлина Тогда
		Ответ = вхСтрока;
		Пока СтрДлина(Ответ)<НужнаяДлина ЦИкл
			Если ОтсекатьСправа = Истина Тогда
				Ответ = Ответ + Заполнитель;
			Иначе
				Ответ = Заполнитель+Ответ;
			КонецЕсли;
		КонецЦикла;
		Возврат Ответ;
	Иначе
		Возврат вхСтрока;
	КонецЕсли;
	
	
	
КонецФункции

Функция ВсегоСуммаРабот(ТЧ)
	
	Ответ = 0 ;
	
	Для Каждого Тек Из ТЧ Цикл
		
		РазницаОкругления = Окр(Тек.Коэффициент,1) - Тек.Коэффициент;
		
		Если РазницаОкругления = 0 Тогда
			
			Ответ =Ответ +  Тек.СуммаВсего_Инвойс;
			
		Иначе
			
			СуммаВсегоИнвойс = Тек.СуммаВсего_Инвойс+РазницаОкругления*Тек.Цена;
			Ответ =Ответ +  СуммаВсегоИнвойс;

		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции


