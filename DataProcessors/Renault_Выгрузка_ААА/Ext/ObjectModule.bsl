	                      |	EDR_РаботыДоп.ПричинаОбращения,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	                      |			ТОГДА ВЫБОР
	                      |					КОГДА EDR_РаботыДоп.АртикулНестандартнойОперации = """"
	                      |						ТОГДА EDR_РаботыДоп.DiversCode.Наименование
	                      |					ИНАЧЕ EDR_РаботыДоп.НаименованиеНеСтандартнойОперации
	                      |				КОНЕЦ
	                      |		ИНАЧЕ ЗаказНарядРаботы.Работа
	                      |	КОНЕЦ,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	                      |			ТОГДА ВЫБОР
	                      |					КОГДА EDR_РаботыДоп.АртикулНестандартнойОперации = """"
	                      |						ТОГДА EDR_РаботыДоп.DiversCode.Код
	                      |					ИНАЧЕ EDR_РаботыДоп.АртикулНестандартнойОперации
	                      |				КОНЕЦ
	                      |		ИНАЧЕ ЗаказНарядРаботы.Работа.Артикул
	                      |	КОНЕЦ,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	                      |			ТОГДА ЗаказНарядРаботы.Цена
	                      |		ИНАЧЕ ЕСТЬNULL(EDR_РаботыДоп.Цена, 0)
	                      |	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	                      |			ТОГДА ЗаказНарядРаботы.СуммаСкидки
	                      |		ИНАЧЕ ЕСТЬNULL(EDR_РаботыДоп.СуммаСкидки, 0)
	                      |	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	                      |			ТОГДА ЗаказНарядРаботы.СуммаНДС
	                      |		ИНАЧЕ ЕСТЬNULL(EDR_РаботыДоп.СуммаНДС, 0)
	                      |	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	                      |			ТОГДА ЗаказНарядРаботы.СуммаВсего
	                      |		ИНАЧЕ ЕСТЬNULL(EDR_РаботыДоп.СуммаВсего, 0)
	                      |	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент,
	                      |	ВЫБОР
	                      |		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	                      |			ТОГДА ЗаказНарядРаботы.Количество * ЗаказНарядРаботы.Коэффициент
	                      |		ИНАЧЕ EDR_РаботыДоп.Количество * ВЫБОР
	                      |				КОГДА EDR_РаботыДоп.Коэффициент = 0
	                      |						ИЛИ EDR_РаботыДоп.Коэффициент ЕСТЬ NULL 
	                      |					ТОГДА 1
	                      |				ИНАЧЕ EDR_РаботыДоп.Коэффициент
	                      |			КОНЕЦ
	                      |	КОНЕЦ"
	);
	Запрос.УстановитьПараметр("Ссылка", ЗаказНаряд);
	Запрос.УстановитьПараметр("Invoice",Инвойс.Строки[0].GUID_Инвойса);
	
	ТаблицаРабот = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

Функция ПолучитьИдентификаторДилера()
	//ИдентификаторДилера = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	ИдентификаторДилера = Renault_ОбщийМодуль.ПолучитьИдентификатор(Организация);
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторДилера) тогда
		
		Renault_Открытый.СообщитьПользователю("У организации"""+Организация.Наименование+""" не заполнено свойство ""Код дилера (BIR3M)""."+Символы.ПС+
					"Заполните соответствующее свойство и повторите выгрузку снова.");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

Функция ПолучитьСчетGCM()
	
	СчетGCM = EDR_ОбщийМодуль.ФорматироватьСтроку(Прав(ИдентификаторДилера, СтрДлина(ИдентификаторДилера) - 3), 9);
	
КонецФункции

Функция ПолучитьЗаголовокСтроки(ЗаказНаряд)
	
	ТекСтрока = "";
	ТекСтрока = ТекСтрока + СчетGCM;
	ТекСтрока = ТекСтрока + EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(ЗаказНаряд.Ссылка, 6);
	
	Возврат ТекСтрока
	
КонецФункции

////@+ Функция СформироватьСтроку000()
// Дата создания - 31.05.2012 12:14:46; 
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку с номером 000 - Заголовочная строка. Наименование Дилера и номер Конфигурации DMS
//
// Параметры
//  Без параметров
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка
//
//@-
Функция СформироватьСтроку000() 
	
	//Первоначальная инициализация
	ТекСтрока = неопределено;
	
	ТекСтрока = "";
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(ИдентификаторДилера,9);	//Warranty account number of the repairing dealer
	ТекСтрока = ТекСтрока + "000000";				//Repair Order number
	ТекСтрока = ТекСтрока + "000000";				//Invoice number issued by the dealer
	ТекСтрока = ТекСтрока + "0";					//Operation Character in repair order
	ТекСтрока = ТекСтрока + "00";					//Rank number of the fixed price in the operation
	ТекСтрока = ТекСтрока + "000";					//Const Line code
	ТекСтрока = ТекСтрока + ВерсияEDR;				//Const Version number of EDR 
	
	//СтрОрганизация = СтрЗаменить(Лев(Организация.Наименование,50), """"," ");
	//Пока СтрДлина(СтрОрганизация) < 50 Цикл
	//	СтрОрганизация = СтрОрганизация + " ";
	//КонецЦикла;
	СтрОрганизация = ДополнитьСтроку(СтрЗаменить(Организация.Наименование,""""," "),50);
	
	ТекСтрока = ТекСтрока + СтрОрганизация;			//DMS (IMS) type identification 
	
	СтрокаВерсии = EDR_КешируемыеЗначения.ПолучитьИдентификатор_DMS();
	
	ТекСтрока = ТекСтрока+СтрокаВерсии;
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);
	
	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	
	Возврат ТекСтрока;
	
КонецФункции // СформироватьСтроку000()

