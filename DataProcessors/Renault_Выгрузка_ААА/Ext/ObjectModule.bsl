////@+ Функция СформироватьСтроку999()
// Дата создания - 08.06.2012 11:50:38; 
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Функция формирует заключительную строку файла.
//
// Параметры
//  Без параметров
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка файла
//
//@-
Функция СформироватьСтроку999() 
	
	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	
	ТекСтрока = "";
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(ИдентификаторДилера,9);	//Warranty account number of the repairing dealer
	ТекСтрока = ТекСтрока + "999999";				//Repair Order number
	ТекСтрока = ТекСтрока + "999999";				//Invoice number issued by the dealer
	ТекСтрока = ТекСтрока + "9";					//Operation Character in repair order
	ТекСтрока = ТекСтрока + "99";					//Rank number of the fixed price in the operation
	ТекСтрока = ТекСтрока + "999";					//Const Line code
	ТекСтрока = ТекСтрока + Формат(КоличествоСтрокВыгружено,"ЧЦ=6; ЧН=; ЧВН=; ЧГ=");	//Number of generated records
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);

	Возврат ТекСтрока;
КонецФункции // СформироватьСтроку999()

