////@+ Функция СформироватьСтроку010(ЗаказНаряд)
// Дата создания - 31.05.2012 11:45:46;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку с номером 010 - Информация по автомобилю.
//
// Параметры
//  Парам1 ЗаказНаряд  - ДокументСсылка.ЗаказНаряд - Ссылка на выгружаемый заказ-наряд
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка
//
//@-
Функция СформироватьСтроку010(ЗаказНаряд) 
	
	//Первоначальная инициализация
	ТекСтрока = неопределено;
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(ЗаказНаряд);

	ТекСтрока = ТекСтрока + "000000";
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + "00";
	ТекСтрока = ТекСтрока + "010";
	
	Автомобиль = ЗаказНаряд.Ссылка.Автомобиль;
	
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ПолучитьVIN(Автомобиль);
	
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ПолучитьTAPV(Автомобиль);
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",7);
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",19);
	ТекСтрока = ТекСтрока + " ";
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(EDR_ОбщийМодуль.ПолучитьНачалоГарантии(Автомобиль),8);
	ТекСтрока = ТекСтрока + EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(ЗаказНаряд.Ссылка, 6);
	ТекСтрока = ТекСтрока + Формат(ЗаказНаряд.ДатаОткрытия,"ДФ=yyyyMMdd");
	
	Попытка
		
		Пробег = ЗаказНаряд.Ссылка.ПробегАвтомобиля;
		
	Исключение
		
		Пробег = 0;
		
	Конецпопытки;
	
	Если НЕ Пробег = 0 тогда
		ТекСтрока = ТекСтрока + Формат(Пробег,"ЧЦ=6; ЧВН=; ЧГ=");
	Иначе
		ТекСтрока = ТекСтрока + ДополнитьСтроку("0",6, "0");
	КонецЕсли;
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",12);//EDR_ОбщийМодуль.ПолучитьГосНомерАвтомобиля(Автомобиль);
	ТекСтрока = ТекСтрока +ДополнитьСтроку(" ",8); //EDR_ОбщийМодуль.ПолучитьДатуРегистрации(Автомобиль);
	
	//Дату первого использования приравниваем к начале гарантии
	Если ЗначениеЗаполнено(Автомобиль.ДатаНачалаГарантии)Тогда
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(EDR_ОбщийМодуль.ПолучитьНачалоГарантии(Автомобиль),8);
	Иначе
		ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",8);

	КонецЕсли;
	
		
	ТекСтрока = ТекСтрока + ДополнитьСтроку(EDR_ОбщийМодуль.ПолучитьКодПроизводителя(Автомобиль),3);
	ТекСтрока = ТекСтрока + ДополнитьСтроку(EDR_ОбщийМодуль.ПолучитьМодельАвтомобиля(Автомобиль),9);
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",15);//"               ";
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",15);//"               ";
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",2);//"  ";
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",2);//"  ";
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",12);//"            ";
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",12);//"            ";
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",12);//"            ";
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",8);//"        ";
	
	ТекСтрока = ТекСтрока + "000000";
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + "1";
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",10);//"          ";
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);

	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;
	
КонецФункции // СформироватьСтроку010(ЗаказНаряд)

