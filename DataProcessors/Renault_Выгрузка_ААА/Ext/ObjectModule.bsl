////@+ Функция ПолучитьДеревоЗаказНарядовДляОтправки()
// Дата создания - 08.06.2012 11:43:29; 
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Функция формирует дерево заказ нарядов (вместе с заявками и инцидентами), которые необходимо отправить.
//
// Параметры
//  Без параметров
//
// Возвращаемое значение
//  ДеревоЗаказНарядов  - ДеревоЗначений - ДеревоЗначений с заказ нарядами к выгрузке.
//                 <продолжение описания параметра>
//@-
Функция ПолучитьДеревоЗаказНарядовДляОтправки(Настройки) 
	Зап = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	OPERACODE_НормыРаботСрезПоследних.Период,
	|	OPERACODE_НормыРаботСрезПоследних.КодПоКаталогу,
	|	OPERACODE_НормыРаботСрезПоследних.Ранг,
	|	OPERACODE_НормыРаботСрезПоследних.Авторабота,
	|	OPERACODE_НормыРаботСрезПоследних.Нормочас,
	|	OPERACODE_НормыРаботСрезПоследних.ВидРабот,
	|	OPERACODE_НормыРаботСрезПоследних.СложностьРабот,
	|	OPERACODE_НормыРаботСрезПоследних.Наименование,
	|	OPERACODE_НормыРаботСрезПоследних.НаименованиеПолное,
	|	OPERACODE_НормыРаботСрезПоследних.ВидНормировки
	|ИЗ
	|	РегистрСведений.OPERACODE_НормыРабот.СрезПоследних КАК OPERACODE_НормыРаботСрезПоследних");
	ТаблицаАртикулов = Зап.Выполнить().Выгрузить();
	//Первоначальная инициализация
	ДеревоЗаказНарядов = неопределено;
	
	//Запрос = Новый Запрос("ВЫБРАТЬ
	//					  |	EDR_ЗаказНаряды.ЗаказНаряд КАК Ссылка,
	//					  |	EDR_ЗаказНаряды.ОтправленВСистему_GCM,
	//					  |	EDR_ЗаказНаряды.OTS КАК OTS,
	//					  |	EDR_ЗаказНаряды.Гарантия КАК Гарантия,
	//					  |	EDR_Invoices.Invoice КАК Invoice,
	//					  |	EDR_Invoices.ДатаИнвойса КАК ДатаИнвойса,
	//					  |	EDR_Invoices.Категория.Код КАК Категория,
	//					  |	EDR_Interventions.Intervention КАК Intervention,
	//					  |	EDR_СоответствияИнвойсов.Процент КАК Процент,
	//					  |	EDR_Interventions.RC_code КАК RC_code,
	//					  |	EDR_Interventions.Function_Code КАК Function_Code,
	//					  |	EDR_Invoices.Expense_code КАК Expense_code,
	//					  |	EDR_Interventions.OTS_number КАК OTS_number,
	//					  |	EDR_Invoices.GUID КАК GUID_Инвойса,
	//					  |	EDR_Interventions.GUID КАК GUID_События,
	//					  |	EDR_ЗаказНаряды.ДатаОткрытия КАК ДатаОткрытия,
	//					  |	EDR_ЗаказНаряды.ДатаЗакрытия КАК ДатаЗакрытия,
	//					  |	EDR_ЗаказНаряды.РангАвторабот КАК РангАвторабот,
	//					  |	EDR_ЗаказНаряды.ПробегАвтомобиля КАК ПробегАвтомобиля,
	//					  |	EDR_Interventions.ОписаниеОперации,
	//					  |	EDR_Interventions.ОписаниеЖалобы,
	//					  |	EDR_Interventions.КомментарийОперации,
	//					  |	EDR_Interventions.РезультатДиагностики,
	//					  |	EDR_ЗаказНаряды.ПовторнаяОтправка,
	//					  |	EDR_Interventions.НомерСогласования,
	//					  |	EDR_Interventions.НомерСФ КАК НомерЗНнаДеталь,
	//					  |	EDR_Interventions.ДатаСФ КАК ДатаЗНнаДеталь,
	//					  |	EDR_Interventions.ПробегПриУстановке КАК ПробегПриУстановкеДетали
	//					  |ИЗ
	//					  |	РегистрСведений.EDR_ЗаказНаряды КАК EDR_ЗаказНаряды
	//					  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	//					  |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	//					  |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	//					  |				ПО EDR_СоответствияИнвойсов.Intervention = EDR_Interventions.GUID
	//					  |			ПО EDR_Invoices.ЗаказНаряд = EDR_СоответствияИнвойсов.ЗаказНаряд
	//					  |				И EDR_Invoices.GUID = EDR_СоответствияИнвойсов.Invoice
	//					  |		ПО EDR_ЗаказНаряды.ЗаказНаряд = EDR_Invoices.ЗаказНаряд
	//					  |ГДЕ
	//					  |	EDR_ЗаказНаряды.ЗаказНаряд.Организация = &Организация
	//					  |	И (EDR_ЗаказНаряды.ОтправленВСистему_GCM = ЛОЖЬ
	//					  |			ИЛИ EDR_ЗаказНаряды.ПовторнаяОтправка = ИСТИНА)
	//					  |	И EDR_ЗаказНаряды.ГотовностьКОтправке = ИСТИНА
	//					  |ИТОГИ
	//					  |	МАКСИМУМ(OTS),
	//					  |	МАКСИМУМ(Гарантия),
	//					  |	МАКСИМУМ(ДатаИнвойса),
	//					  |	МАКСИМУМ(Категория),
	//					  |	СУММА(Процент),
	//					  |	МАКСИМУМ(RC_code),
	//					  |	МАКСИМУМ(Function_Code),
	//					  |	МАКСИМУМ(Expense_code),
	//					  |	МАКСИМУМ(OTS_number),
	//					  |	МАКСИМУМ(GUID_Инвойса),
	//					  |	МАКСИМУМ(GUID_События),
	//					  |	МАКСИМУМ(ДатаОткрытия),
	//					  |	МАКСИМУМ(ДатаЗакрытия),
	//					  |	МАКСИМУМ(РангАвторабот),
	//					  |	МАКСИМУМ(ПробегАвтомобиля)
	//					  |ПО
	//					  |	Ссылка,
	//					  |	Invoice"
	//);
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказНаряд.Ссылка КАК Ссылка,
	|	ЗаказНаряд.ДатаСоздания КАК ДатаОткрытия,";
	
	//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
		
		
	//	Запрос.Текст = Запрос.Текст + Символы.ПС + "ЗаказНаряд.Пробег КАК ПробегАвтомобиля,";
		
	//Иначе
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + "0 КАК ПробегАвтомобиля,";
		
	//КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + Символы.ПС + 
	
	"ВЫБОР
	|		КОГДА ЗаказНаряд.СервиснаяКампания ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК OTS,
	|	ЛОЖЬ КАК Гарантия,
	|	ЗаказНаряд.Товары.(
	|		Ссылка,
	|		НомерСтроки,
	|		Номенклатура,
	|		Количество,
	|		ЕдиницаИзмерения,
	|		Коэффициент,
	|		Цена,
	|		Сумма,
	|		СтавкаНДС,
	|		СуммаНДС КАК СуммаНДС_Инвойс,
	|		ПроцентСкидки,
	|		СуммаСкидки,
	|		ХарактеристикаНоменклатуры,
	|		СуммаВсего КАК СуммаВсего_Инвойс,
	|		СкладКомпании,
	|		СкидкаНаТовар,
	|		ПроцентСкидкиСтроки,
	|		СуммаСкидкиСтроки,
	|		ПримечаниеНоменклатураПечать,
	|		ПримечаниеНоменклатура,
	//|		УправляющийКод
	|	),
	|	ЗаказНаряд.Работы.(
	|		Ссылка,
	|		НомерСтроки,
	|		Работа,
	|		ИдентификаторРаботы,
	|		Количество,
	|		Нормочас,
	|		Коэффициент,
	|		Цена,
	|		Сумма,
	|		СтавкаНДС,
	|		СуммаНДС КАК СуммаНДС_Инвойс,
	|		ПроцентСкидки,
	|		СуммаСкидки,
	|		СуммаВсего КАК СуммаВсего_Инвойс,
	|		СкидкаНаТовар,
	|		ПроцентСкидкиСтроки,
	|		СуммаСкидкиСтроки,
	|		ПримечаниеРаботыПечать,
	|		ПримечаниеРаботы,
	|		Контрагент,
	|		ДоговорВзаиморасчетов,
	//|		ПакетРабот,
	//|		НомерПакета,
	//|		ПакетЗакрыт,
	//|		УправляющийКод
	|	),
	|	ЗаказНаряд.ДатаОкончания,
	|	""1"" КАК Intervention,
	|	ЗаказНаряд.СервиснаяКампания
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_AAA_ВыгруженныеНарядЗаказы КАК Renault_AAA_ВыгруженныеНарядЗаказы
	|		ПО (Renault_AAA_ВыгруженныеНарядЗаказы.Объект = ЗаказНаряд.Ссылка)
	|ГДЕ
	//|	ЗаказНаряд.Организация = &Организация
	//|	ЗаказНаряд.ПодразделениеКомпании В (&Подразделения)
	//|	И ЗаказНаряд.Состояние = &Состояние
	|	ЗаказНаряд.Проведен = ИСТИНА
	|	И ВЫБОР
	|			КОГДА ГОД(&НачДата) = 1
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЗаказНаряд.Дата >= &НачДата
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ГОД(&КонДата) = 1
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЗаказНаряд.Дата <= &КонДата
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Перевыгружать = ИСТИНА
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Renault_AAA_ВыгруженныеНарядЗаказы.ДатаВыгрузки ЕСТЬ NULL 
	|		КОНЕЦ
	|	И ЗаказНаряд.ПометкаУдаления = ЛОЖЬ";
	Если ЗначениеЗаполнено(ПериодСт) Тогда
		Запрос.УстановитьПараметр("НачДата", ПериодСт.ДатаНачала);
		Запрос.УстановитьПараметр("КонДата", ПериодСт.ДатаОкончания);
	Иначе
		Запрос.УстановитьПараметр("НачДата", ТекущаяДата() - Настройки.Автосервис_ААА_ПериодВыгрузки * 86400);
		Запрос.УстановитьПараметр("КонДата", ТекущаяДата());
	КонецЕсли;
	//Запрос.УстановитьПараметр("Состояние",Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	//Запрос.УстановитьПараметр("Организация", Организация);
	//ЗапросПодразделения = Новый Запрос;
	//ЗапросПодразделения.Текст = 
	//"ВЫБРАТЬ
	//|	CRM_ДилерскиеЦентрыПодразделенияОрганизации.Подразделение
	//|ИЗ
	//|	Справочник.CRM_ДилерскиеЦентры.ПодразделенияОрганизации КАК CRM_ДилерскиеЦентрыПодразделенияОрганизации";
	//Результат = ЗапросПодразделения.Выполнить().Выгрузить();
	//Запрос.УстановитьПараметр("Подразделения", Результат.ВыгрузитьКолонку("Подразделение"));
	Запрос.УстановитьПараметр("Перевыгружать",Перевыгружать);
	
	ДеревоЗаказНарядов = Запрос.Выполнить().Выгрузить();
	МассивКУдалению = Новый массив();
	Для Каждого ЗаказНаряд из ДеревоЗаказНарядов Цикл
		Если ЗаказНаряд.Работы.Количество()> 0 Или ЗаказНаряд.Товары.Количество()> 0 Тогда
			Для Каждого Тек Из ЗаказНаряд.Работы ЦИкл
				ТекКоэффициент  = Тек.Коэффициент;
				Тек.Коэффициент = Окр(ТекКоэффициент,1);
				Если Тек.Коэффициент = 0 Тогда
					Тек.Коэффициент = 0.1;
				КонецЕсли;
				//Если Тек.Коэффициент <> ТекКоэффициент Тогда
					Тек.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
					Тек.СуммаВсего_Инвойс = Тек.Коэффициент*Тек.Цена*Тек.Количество ;
					Тек.СуммаНДС_Инвойс = 0;// EDR_КешируемыеЗначения.ПолучитьСуммуНалога(Тек.СуммаВсего_Инвойс,Тек.СтавкаНДС.Ставка);
					
				//КонецЕсли;
				
			КонецЦикла;
			Для Каждого Тек Из ЗаказНаряд.Товары ЦИкл
				ТекКоэффициент  = Тек.Коэффициент;
				ТекКоличество = Тек.Количество;
				Тек.Коэффициент = Окр(ТекКоэффициент,1);
				Тек.Количество = Окр(ТекКоличество,2);
				Если Тек.Количество = 0 Тогда
					Тек.Количество = 0.01;
				КонецЕсли;
				
				//Если Тек.Коэффициент <> ТекКоэффициент Тогда
					Тек.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
					Тек.СуммаВсего_Инвойс = Тек.Коэффициент*Тек.Цена*Тек.Количество;
					Тек.СуммаНДС_Инвойс =0;// EDR_КешируемыеЗначения.ПолучитьСуммуНалога(Тек.СуммаВсего_Инвойс,Тек.СтавкаНДС.Ставка);
					
				//КонецЕсли;
				
			КонецЦикла;
		Иначе
			МассивКУдалению.Вставить(0, ДеревоЗаказНарядов.Индекс(ЗаказНаряд));
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Уд Из МассивКУдалению Цикл
		ДеревоЗаказНарядов.Удалить(Уд);
	КонецЦикла;
	
КонецФункции // ПолучитьДеревоЗаказНарядовДляОтправки()
Функция ПолучитьДеревоЗаказНарядовДляОтправкиГарантия() 
	
	//Первоначальная инициализация
	ДеревоЗаказНарядов = неопределено;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	EDR_ЗаказНаряды.ЗаказНаряд КАК Ссылка,
	                      |	EDR_ЗаказНаряды.ОтправленВСистему_GCM,
	                      |	EDR_ЗаказНаряды.OTS КАК OTS,
	                      |	EDR_ЗаказНаряды.Гарантия КАК Гарантия,
	                      |	EDR_Invoices.Invoice КАК Invoice,
	                      |	EDR_Invoices.ДатаИнвойса КАК ДатаИнвойса,
	                      |	EDR_Invoices.Категория.Код КАК Категория,
	                      |	EDR_Interventions.Intervention КАК Intervention,
	                      |	EDR_СоответствияИнвойсов.Процент КАК Процент,
	                      |	EDR_Interventions.RC_code КАК RC_code,
	                      |	EDR_Interventions.Function_Code КАК Function_Code,
	                      |	EDR_Invoices.Expense_code КАК Expense_code,
	                      |	EDR_Interventions.OTS_number КАК OTS_number,
	                      |	EDR_Invoices.GUID КАК GUID_Инвойса,
	                      |	EDR_Interventions.GUID КАК GUID_События,
	                      |	EDR_ЗаказНаряды.ДатаОткрытия КАК ДатаОткрытия,
	                      |	EDR_ЗаказНаряды.ДатаЗакрытия КАК ДатаЗакрытия,
	                      |	EDR_ЗаказНаряды.РангАвторабот КАК РангАвторабот,
	                      |	EDR_ЗаказНаряды.ПробегАвтомобиля КАК ПробегАвтомобиля,
	                      |	EDR_Interventions.ОписаниеОперации,
	                      |	EDR_Interventions.ОписаниеЖалобы,
	                      |	EDR_Interventions.КомментарийОперации,
	                      |	EDR_Interventions.РезультатДиагностики,
	                      |	EDR_ЗаказНаряды.ПовторнаяОтправка,
	                      |	EDR_Interventions.НомерСогласования,
	                      |	EDR_Interventions.НомерСФ КАК НомерЗНнаДеталь,
	                      |	EDR_Interventions.ДатаСФ КАК ДатаЗНнаДеталь,
	                      |	EDR_Interventions.ПробегПриУстановке КАК ПробегПриУстановкеДетали
	                      |ИЗ
	                      |	РегистрСведений.EDR_ЗаказНаряды КАК EDR_ЗаказНаряды
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	                      |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	                      |				ПО EDR_СоответствияИнвойсов.Intervention = EDR_Interventions.GUID
	                      |			ПО EDR_Invoices.ЗаказНаряд = EDR_СоответствияИнвойсов.ЗаказНаряд
	                      |				И EDR_Invoices.GUID = EDR_СоответствияИнвойсов.Invoice
	                      |		ПО EDR_ЗаказНаряды.ЗаказНаряд = EDR_Invoices.ЗаказНаряд
	                      |ГДЕ
	                      |	EDR_ЗаказНаряды.ЗаказНаряд.Организация = &Организация
	                      |	И (EDR_ЗаказНаряды.ОтправленВСистему_GCM = ЛОЖЬ
	                      |			ИЛИ EDR_ЗаказНаряды.ПовторнаяОтправка = ИСТИНА)
	                      |	И EDR_ЗаказНаряды.ГотовностьКОтправке = ИСТИНА
	                      |ИТОГИ
	                      |	МАКСИМУМ(OTS),
	                      |	МАКСИМУМ(Гарантия),
	                      |	МАКСИМУМ(ДатаИнвойса),
	                      |	МАКСИМУМ(Категория),
	                      |	СУММА(Процент),
	                      |	МАКСИМУМ(RC_code),
	                      |	МАКСИМУМ(Function_Code),
	                      |	МАКСИМУМ(Expense_code),
	                      |	МАКСИМУМ(OTS_number),
	                      |	МАКСИМУМ(GUID_Инвойса),
	                      |	МАКСИМУМ(GUID_События),
	                      |	МАКСИМУМ(ДатаОткрытия),
	                      |	МАКСИМУМ(ДатаЗакрытия),
	                      |	МАКСИМУМ(РангАвторабот),
	                      |	МАКСИМУМ(ПробегАвтомобиля)
	                      |ПО
	                      |	Ссылка,
	                      |	Invoice"
	);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ДеревоЗаказНарядов = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
КонецФункции // ПолучитьДеревоЗаказНарядовДляОтправкиГарантия
	
Процедура ПолучитьСписокТоваровПоИнвойсу(Инвойс)
	
	ЗаказНаряд = Инвойс.Ссылка;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	EDR_DiversCode.Ссылка
	|ПОМЕСТИТЬ КодыЖидкостей
	|ИЗ
	|	Справочник.EDR_DiversCode КАК EDR_DiversCode
	|ГДЕ
	|	(EDR_DiversCode.Ссылка = ЗНАЧЕНИЕ(Справочник.EDR_DiversCode.LU)
	|			ИЛИ EDR_DiversCode.Ссылка = ЗНАЧЕНИЕ(Справочник.EDR_DiversCode.L2)
	|			ИЛИ EDR_DiversCode.Ссылка = ЗНАЧЕНИЕ(Справочник.EDR_DiversCode.L3)
	|			ИЛИ EDR_DiversCode.Ссылка = ЗНАЧЕНИЕ(Справочник.EDR_DiversCode.L4)
	|			ИЛИ EDR_DiversCode.Ссылка = ЗНАЧЕНИЕ(Справочник.EDR_DiversCode.L5)
	|			ИЛИ EDR_DiversCode.Ссылка = ЗНАЧЕНИЕ(Справочник.EDR_DiversCode.L6))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	EDR_Invoices.Invoice КАК Счет,
	|	EDR_Interventions.Intervention,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_ТоварыДоп.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|						ТОГДА EDR_ТоварыДоп.DiversCode.Наименование
	|					ИНАЧЕ EDR_ТоварыДоп.Номенклатура
	|				КОНЕЦ
	|		ИНАЧЕ ЗаказНарядТовары.Номенклатура
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.Количество
	|		ИНАЧЕ EDR_ТоварыДоп.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.Цена
	|		ИНАЧЕ ЕСТЬNULL(EDR_ТоварыДоп.Цена, 0)
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.СтавкаНДС
	|		ИНАЧЕ EDR_ТоварыДоп.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.ПроцентСкидки
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПроцентСкидки,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.ПроцентСкидкиСтроки
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПроцентСкидкиСтроки,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.СуммаСкидки
	|		ИНАЧЕ ЕСТЬNULL(EDR_ТоварыДоп.СуммаСкидки, 0)
	|	КОНЕЦ КАК СуммаСкидки,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.СуммаНДС
	|		ИНАЧЕ ЕСТЬNULL(EDR_ТоварыДоп.СуммаНДС, 0)
	|	КОНЕЦ КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА EDR_ТоварыДоп.СуммаВсего
	|		ИНАЧЕ ЕСТЬNULL(ЗаказНарядТовары.СуммаВсего, 0)
	|	КОНЕЦ КАК СуммаВсего,
	|	EDR_ТоварыДоп.ПричинаОбращения,
	|	EDR_ТоварыДоп.NotInvoiced,
	|	EDR_Interventions.GUID КАК GUID_События,
	|	EDR_СоответствияИнвойсов.Процент,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.Цена
	|		ИНАЧЕ ЕСТЬNULL(EDR_ТоварыДоп.Цена, 0)
	|	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент КАК Цена_Инвойс,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.СуммаСкидки
	|		ИНАЧЕ ЕСТЬNULL(EDR_ТоварыДоп.СуммаСкидки, 0)
	|	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент КАК СуммаСкидки_Инвойс,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.СуммаНДС
	|		ИНАЧЕ ЕСТЬNULL(EDR_ТоварыДоп.СуммаНДС, 0)
	|	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент КАК СуммаНДС_Инвойс,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда
	|			ТОГДА ЗаказНарядТовары.СуммаВсего
	|		ИНАЧЕ ЕСТЬNULL(EDR_ТоварыДоп.СуммаВсего, 0)
	|	КОНЕЦ / 100 * EDR_СоответствияИнвойсов.Процент КАК СуммаВсего_Инвойс,
	|	&Invoice,
	|	ВЫБОР
	|		КОГДА EDR_ТоварыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_ТоварыДоп.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|						ТОГДА EDR_ТоварыДоп.DiversCode.Код
	|					ИНАЧЕ EDR_ТоварыДоп.Номенклатура.Артикул
	|				КОНЕЦ
	|		ИНАЧЕ ЗаказНарядТовары.Номенклатура.Артикул
	|	КОНЕЦ КАК Артикул,
	|	ВЫБОР
	|		КОГДА КодыЖидкостей.Ссылка ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоГСМ
	|ИЗ
	|	РегистрСведений.EDR_ТоварыДоп КАК EDR_ТоварыДоп
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
	|				ПО EDR_СоответствияИнвойсов.Invoice = EDR_Invoices.GUID
	|			ПО (EDR_СоответствияИнвойсов.Intervention = EDR_Interventions.GUID)
	|		ПО EDR_ТоварыДоп.GUID_Инцидента = EDR_Interventions.GUID
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
	|		ПО EDR_ТоварыДоп.GUID_Товара = ЗаказНарядТовары.GUID
	|			И EDR_ТоварыДоп.ЗаказНаряд = ЗаказНарядТовары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ КодыЖидкостей КАК КодыЖидкостей
	|		ПО EDR_ТоварыДоп.DiversCode = КодыЖидкостей.Ссылка
	|ГДЕ
	|	EDR_ТоварыДоп.ЗаказНаряд = &Ссылка
	|	И EDR_СоответствияИнвойсов.Invoice = &Invoice
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КодыЖидкостей"
	);
	Запрос.УстановитьПараметр("Ссылка", ЗаказНаряд);
	Запрос.УстановитьПараметр("Invoice",Инвойс.Строки[0].GUID_Инвойса);
	
	ТаблицаТоваров = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

Процедура ПолучитьСписокРаботПоИнвойсу(Инвойс)
	
