				Отбор = Новый Структура("GUID_События",Событие.GUID_События);
				ТоварыСобытия = ТаблицаТоваров.Скопировать(Отбор);
				РаботыСобытия = ТаблицаРабот.Скопировать(Отбор);
				
				//Выгружаем работы Строка 050
				Для каждого СтрокаЗН из РаботыСобытия Цикл
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Событие", Событие);
					СтруктураПараметров.Вставить("СтрокаРаботы", СтрокаЗН);
					
					Строка050 = СформироватьСтроку050(СтруктураПараметров);
					
					Если ЗначениеЗаполнено(Строка050) тогда
						СтрокаФайла = СтрокаФайла + Строка050 + Символы.ПС;
					КонецЕсли;
					
				КонецЦикла; //Работы
				
				//Выгружаем детали Строка 060
				Для каждого строкаЗН из ТоварыСобытия Цикл
					
					//Если попадается деталь, которая не включена в счет,
					//Пропускаем.
					Если СтрокаЗН.NotInvoiced тогда Продолжить; КонецЕсли;
					
					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Событие", Событие);
					СтруктураПараметров.Вставить("СтрокаДетали", СтрокаЗН);
					
					Строка060 = СформироватьСтроку060(СтруктураПараметров);
					
					Если ЗначениеЗаполнено(Строка060) тогда
						СтрокаФайла = СтрокаФайла + Строка060 + Символы.ПС;
					КонецЕсли;
					
				КонецЦикла; //Запасные части
				
			КонецЦикла; //События
			
		КонецЦикла; //Инвойсы
		
	КонецЦикла; //ЗаказНаряды
	
	//формируем подвал
	Строка999 = СформироватьСтроку999();
	СтрокаФайла = СтрокаФайла + Строка999;
	
		
	ФайлДляСохранения.ДобавитьСтроку(СтрокаФайла);
	
	МассивЗНГарантия = ДеревоЗаказНарядов.Строки.ВыгрузитьКолонку("Ссылка");
	
	//Работаем в транзакции
	НачатьТранзакцию();

	//Сохраняем файл в попытке, вдруг какая ошибка
	Попытка
		
		ФайлДляСохранения.Записать(ПутьКФайлу+ИмяФайла,"windows-1251");
		
		//Запишем новый счетчик
		МЗ = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		МЗ.Объект   = Организация;
		МЗ.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.EDR_НомерФайла;
		МЗ.Прочитать();
		
		//Ошибка от Филиппа
		//МЗ.Объект   = Организация;
		//МЗ.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.EDR_НомерФайла;
		//МЗ.Значение = Число(НомерФайла);
		//МЗ.Записать();
		
		
		
		//К сожалению пакетно изменить не можем, т.к. в наборе записей отбор устанавливается только на равенство.
		Для каждого ЗаказНаряд из МассивЗН Цикл
			Мен = РегистрыСведений.Renault_AAA_ВыгруженныеНарядЗаказы.СоздатьМенеджерЗаписи();
			Мен.ДатаВыгрузки = ТекущаяДата();
			Мен.Объект = ЗаказНаряд;
			Мен.Записать();
		КонецЦикла;
		
		Для каждого ЗаказНаряд из МассивЗНГарантия Цикл
			НЗ = РегистрыСведений.EDR_ЗаказНаряды.ЗаписьЗНСуществует(ЗаказНаряд);
			
			Если НЗ = Неопределено тогда
				
				Renault_Открытый.СообщитьПользователю("Запись для Заказ-наряда в регистре ""EDR Заказ наряды "" не найдена.");
				ОтменитьТранзакцию();
				Возврат неопределено;
				
			КонецЕсли;
			
			Для каждого строка из НЗ цикл
				Строка.ОтправленВСистему_GCM = Истина;
				Строка.ПовторнаяОтправка = Ложь;
			КонецЦикла;
			НЗ.Записать();
		КонецЦикла;
		
		//Если все успешно, фиксируем транзакцию
		ЗафиксироватьТранзакцию();
	Исключение
		
		Renault_Открытый.СообщитьПользователю("Произошла ошибка при сохранении файла." + Символы.ПС + ОписаниеОшибки());
		ОтменитьТранзакцию();
		
	КонецПопытки;
	
КонецФункции // СформироватьФайлEDR()

