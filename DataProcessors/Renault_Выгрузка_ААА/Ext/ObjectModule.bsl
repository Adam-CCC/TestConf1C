////@+ Функция СформироватьСтроку015(Инвойс)
// Дата создания - 31.05.2012 13:13:16;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку с номером 015 - данные об Заявке (Инвойс) Номер и суммы товаров и работ
//
// Параметры
//  Парам1 Инвойс  - Строка дерева значений - Строка из выборки заказ-нарядов с инвойсом
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка
//
//@-
Функция СформироватьСтроку015(Инвойс) 

	//Первоначальная инициализация
	ТекСтрока = неопределено;
	GUID_Инвойса = Инвойс.Ссылка.УникальныйИдентификатор();
	
	//Подготовка таблиц с товарами и работами
	//Отбор = Новый Структура("Invoice",Инвойс.Строки[0].GUID_Инвойса);
	//
	//ВрТовары = ТаблицаТоваров.Скопировать(Отбор);
	//ВрРаботы = ТаблицаРабот.Скопировать(Отбор);
	
	//СтавкаНДС = ?(ТаблицаТоваров.Итог("СуммаНДС_Инвойс") = 0, 0,
	//			Окр(ТаблицаТоваров.Итог("СуммаНДС_Инвойс")/((ТаблицаТоваров.Итог("СуммаВсего_Инвойс")-ТаблицаТоваров.Итог("СуммаНДС_Инвойс"))/100)));

	//Подводим итоги налогов и сумм 
	//Товары
	
	СуммаНДСТовары = ТаблицаТоваров.Итог("СуммаНДС_Инвойс");
	СуммаВсегоТовары = ТаблицаТоваров.Итог("СуммаВсего_Инвойс");//+ТаблицаТоваров.Итог("СуммаСкидки")+ТаблицаТоваров.Итог("СуммаСкидкиСтроки");
	СуммаБезНДСТовары = СуммаВсегоТовары - СуммаНДСТовары;
	
	//Работы
	//ВсегоСуммаПоРаботам = ВсегоСуммаРабот(ТаблицаРабот);
	СуммаНДСРаботы =ТаблицаРабот.Итог("СуммаНДС_Инвойс");//EDR_КешируемыеЗначения.ПолучитьСуммуНалога(ВсегоСуммаПоРаботам,СтавкаНДС);
	СуммаВсегоРаботы =ТаблицаРабот.Итог("СуммаВсего_Инвойс");//+ТаблицаРабот.Итог("СуммаСкидки")+ТаблицаРабот.Итог("СуммаСкидкиСтроки");
	СуммаБезНДСРаботы = СуммаВсегоРаботы - СуммаНДСРаботы;
	
	//Общая
	СуммаНДС = СуммаНДСТовары + СуммаНДСРаботы;
	СуммаВсего = СуммаВсегоТовары + СуммаВсегоРаботы;
	СуммаБезНДС = СуммаБезНДСТовары + СуммаБезНДСРаботы;
	Если Инвойс.Ссылка.ВидРемонта.ТипРемонта = Перечисления.ТипыРемонта.Платный Тогда
		
		ТипИнвойса = "1";	
		
	Иначе
		
		ТипИнвойса = "7";
		
	КонецЕсли;
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(Инвойс.Ссылка);
    НомерДокумента = "" + EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(Инвойс.Ссылка) +ТипИнвойса;
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(НомерДокумента, 6);
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + "00";
	ТекСтрока = ТекСтрока + "015";
	
	ИнвойсКатегория = ТипИнвойса;
	
	//Если Инвойс.OTS Тогда
	//	 ИнвойсКатегория = Справочники.EDR_КатегорииСчетов.RenaultWarranty;
	// Иначе
	//	 ИнвойсКатегория = Справочники.EDR_КатегорииСчетов.ПустаяСсылка(); 
	//КонецЕсли;
	
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(ИнвойсКатегория,1);
	Попытка	
	ТекСтрока = ТекСтрока + Формат(?(ЗначениеЗаполнено(Инвойс.ДатаОкончания), Инвойс.ДатаОкончания, ТекущаяДата()), "ДФ=yyyyMMdd");
	Исключение
	КонецПопытки;
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + "000000";
	
	Попытка
	    Если ЗначениеЗаполнено(Инвойс.Ссылка.ВалютаДокумента.КодВалютыПоISO) Тогда
			ТекСтрока = ТекСтрока + ДополнитьСтроку(Инвойс.Ссылка.ВалютаДокумента.КодВалютыПоISO,3); //Currency code
		Иначе
			ТекСтрока = ТекСтрока + "RUB";
        КонецЕсли;
			
	Исключение
		
		ТекСтрока = ТекСтрока + "RUB";
		
	КонецПопытки;
		
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока +ДополнитьСтроку(СтрЗаменить(СтрЗаменить(Формат(СуммаБезНДС," ЧДЦ=2"),Символы.НПП,""),",",""),15,"0",Ложь); //СтрЗаменить(Формат(СуммаБезНДС,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + ДополнитьСтроку(СтрЗаменить(СтрЗаменить(Формат(СуммаНДС," ЧДЦ=2"),Символы.НПП,""),",",""),15,"0",Ложь);//СтрЗаменить(Формат(СуммаНДС,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+";  //Sign code of invoice total after tax
	ТекСтрока = ТекСтрока +ДополнитьСтроку(СтрЗаменить(СтрЗаменить(Формат(СуммаВсего," ЧДЦ=2"),Символы.НПП,""),",",""),15,"0",Ложь); //СтрЗаменить(Формат(СуммаВсего,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "          ";  //VO number
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",20);  //Invoice number in the DMS (IMS)
	ТекСтрока = ТекСтрока + "      ";
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(" ",20);//Original invoice number in the DMS in case of total credit note
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(Организация.НаименованиеПолное),30);
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);

	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;

КонецФункции // СформироватьСтроку015(Инвойс)

////@+ Функция СформироватьСтроку016(Инвойс)
// Дата создания - 08.06.2012 12:09:03;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку 016 - строка детализации по налогам заявки
//
// Параметры
//  Парам1 Инвойс  - СтрокаДЗ - Строка на инвойс
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка
//
//@-
Функция СформироватьСтроку016(Инвойс) 
	//Подготовка таблиц с товарами и работами
	//Отбор = Новый Структура("Invoice",Инвойс.Строки[0].GUID_Инвойса);
	GUID_Инвойса = Инвойс.Ссылка.УникальныйИдентификатор();

//	ВрТовары = ТаблицаТоваров.Скопировать(Отбор);
//	ВрРаботы = ТаблицаРабот.Скопировать(Отбор);
	
	//Подводим итоги налогов и сумм 
	//Товары
	
	СуммаНДСТовары = ТаблицаТоваров.Итог("СуммаНДС_Инвойс");
	СуммаВсегоТовары = ТаблицаТоваров.Итог("СуммаВсего_Инвойс");//+ТаблицаТоваров.Итог("СуммаСкидки")+ТаблицаТоваров.Итог("СуммаСкидкиСтроки");
	СуммаБезНДСТовары = СуммаВсегоТовары - СуммаНДСТовары;
	
	//Работы
	СуммаНДСРаботы = ТаблицаРабот.Итог("СуммаНДС_Инвойс");
	СуммаВсегоРаботы = ТаблицаРабот.Итог("СуммаВсего_Инвойс");//+ТаблицаРабот.Итог("СуммаСкидки")+ТаблицаРабот.Итог("СуммаСкидкиСтроки");
	СуммаБезНДСРаботы = СуммаВсегоРаботы - СуммаНДСРаботы;
	
	//Общая
	СуммаНДС = СуммаНДСТовары + СуммаНДСРаботы;
	СуммаВсего = СуммаВсегоТовары + СуммаВсегоРаботы;
	СуммаБезНДС = СуммаБезНДСТовары + СуммаБезНДСРаботы;
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(Инвойс.Ссылка);
	НомерДокумента = "" + EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(Инвойс.Ссылка);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(НомерДокумента+ТипИнвойса, 6);
	ТекСтрока = ТекСтрока + "0";
	ТекСтрока = ТекСтрока + "00";
	ТекСтрока = ТекСтрока + "016";
	ТекСтрока = ТекСтрока + ?(СуммаНДС > 0,"1","0"); //Требуется обязательно "Tax code" - Код налога либо 1 либо 0
	
	СтавкаНДС = 0;
	
	Попытка
	
		СтавкаНДС = Окр(СуммаНДС/((СуммаВсего-СуммаНДС)/100));
	
	Исключение
		
	КонецПопытки;
	
	
	ТекСтрока = ТекСтрока +СтрЗаменить(Формат(СтавкаНДС, "ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",",""); 
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(СуммаБезНДС,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(СуммаНДС,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(СуммаВсего,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);

	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;
КонецФункции // СформироватьСтроку016(Инвойс)

////@+ Функция СформироватьСтроку020(Событие)
// Дата создания - 08.06.2012 12:22:56;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Формирует строку с номером 020 - данные о событии (Инциденте)
//
// Параметры
//  Парам1 Событие  - Строка дерева значений - Строка из выборки заказ-нарядов с Инцидентом(событием)
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300) - Результирующая строка
//
//@-
Функция СформироватьСтроку020(Событие) 

	//Подготовка таблиц с товарами и работами
	Отбор = Новый Структура("GUID_События",Строка(Событие.Ссылка.УникальныйИдентификатор()));
	
	ТоварыСобытия = ТаблицаТоваров.Скопировать();
	РаботыСобытия = ТаблицаРабот.Скопировать();
	
	//Подводим итоги налогов и сумм 
	//Товары
	СуммаНДСТовары 	  =ТоварыСобытия.Итог("СуммаНДС_Инвойс");  // СуммаВсего_Инвойс СуммаСкидки СуммаСкидкиСтроки
	СуммаВсегоТовары  = ТоварыСобытия.Итог("СуммаВсего_Инвойс");//+ТоварыСобытия.Итог("СуммаСкидки")+ТоварыСобытия.Итог("СуммаСкидкиСтроки");
	СуммаБезНДСТовары = СуммаВсегоТовары - СуммаНДСТовары;
	
	//Работы
	СуммаНДСРаботы	  =РаботыСобытия.Итог("СуммаНДС_Инвойс");
	СуммаВсегоРаботы  = РаботыСобытия.Итог("СуммаВсего_Инвойс");//+РаботыСобытия.Итог("СуммаСкидки")+РаботыСобытия.Итог("СуммаСкидкиСтроки");
	СуммаБезНДСРаботы = СуммаВсегоРаботы - СуммаНДСРаботы;
	
	//Общая
	СуммаНДС	 = СуммаНДСТовары + СуммаНДСРаботы;
	СуммаВсего	 = СуммаВсегоТовары + СуммаВсегоРаботы;
	СуммаБезНДС	 = СуммаБезНДСТовары + СуммаБезНДСРаботы;
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(Событие.Ссылка);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(Событие.Ссылка) +ТипИнвойса, 6);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(ТипИнвойса, 1);
	ТекСтрока = ТекСтрока + "00"; //Указание ранга авторабот приводит к ошибке.
	ТекСтрока = ТекСтрока + "020";
	
	//Expenditure code
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("   ",3);
	
	//Если Событие.OTS тогда
	//	OTS = Лев(СокрЛП(?(ЗначениеЗаполнено(Событие.СервиснаяКампания),Событие.СервиснаяКампания,"")),4);
	//	ТекСтрока = ТекСтрока + OTS; //Code OTS
	//Иначе 
		ТекСтрока = ТекСтрока + "    "; //Code OTS = Null
	//КонецЕсли;
	
	ТекСтрока = ТекСтрока + "   "; //Supplier's code for faulty part
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("  ",2); //Customer Complaint Code
	
	ТекСтрока = ТекСтрока + "  "; //Fault mode code
	
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("   ",3);
	
	
	//Процент определяется для каждого инцидента по каждому инвойсу.
	//Поэтому процент хранится в регистре соответствий.
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("100",3,"0",Истина);
	
	///!!! С этим показателем нужно разобраться. Куда нить пристроить для ввода пользователем
	//Пока ставлю 1
	ТекСтрока = ТекСтрока + "0"; //Immobilising fault flag
	
	
	ДобавитьИнформациюОЗН_ГарантииНаДеталь(Событие, ТекСтрока);
	
	ТекСтрока = ТекСтрока + "    "; //Team identification
	ТекСтрока = ТекСтрока + "    "; //Mechanic identification
	
	//Этот референс нужно искать в таблице.
	NotInvoicedRef =Неопределено;// ТоварыСобытия.Найти(Истина,"NotInvoiced");
	
	Если НЕ NotInvoicedRef = Неопределено тогда
		
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(NotInvoicedRef.Артикул,10);
		
	Иначе
		
		ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",10); //Reference of the not replaced faulty part 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Событие.Ссылка.ПричинаОбращения) Тогда
	                                                                          
		Причина = СтрЗаменить(Событие.Ссылка.ПричинаОбращения, Символы.ПС, " ");
	
	Иначе
		
		Причина = Строка(ТипИнвойса) + Строка(Прав(Событие.Ссылка.Номер, 5));
		
	КонецЕсли;	
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(Причина,8);  //OPECOD cause not used
	ТекСтрока = ТекСтрока + "1"; 		//Customer Ordered Operation flag
	ТекСтрока = ТекСтрока + "+";
	
	//С товаром нужно работать по особому, поэтому выгружаем в ТЗ и уже с ней работаем
	ВремТЗ = ТоварыСобытия.Скопировать();
	
	//Нужно добавить проверку кодов по жидкостям
	
	//Отбор = Новый Структура("ЭтоГСМ", ложь);
	ТЗМатериалы = ВремТЗ.Скопировать();
	
	СтавкаНДС = 0;
	//?(ТЗМатериалы.Итог("СуммаНДС_Инвойс") = 0, 0,
	//			Окр(ТЗМатериалы.Итог("СуммаНДС_Инвойс")/((ТЗМатериалы.Итог("СуммаВсего_Инвойс")-ТЗМатериалы.Итог("СуммаНДС_Инвойс"))/100)));
	
	//Parts cost charged before tax 
	ТекСтрока = ТекСтрока + ДополнитьСтроку(СтрЗаменить(СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(ТЗМатериалы.Итог("СуммаВсего_Инвойс"),СтавкаНДС)," ЧДЦ=2"),Символы.НПП,""),",",""),15,"0",Ложь);
	//СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(ТЗМатериалы.Итог("СуммаВсего_Инвойс"),СтавкаНДС),"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+";
	//Labor cost charged before tax
	
	ТекСтрока = ТекСтрока + ДополнитьСтроку(СтрЗаменить(СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(ВсегоСуммаРабот(РаботыСобытия),СтавкаНДС)," ЧДЦ=2"),Символы.НПП,""),",",""),15,"0",Ложь);
//СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(РаботыСобытия.Итог("СуммаВсего_Инвойс"),СтавкаНДС),"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	
		//Нужно поискать жидкости
	////если есть выделяем стоимость в отдельную строку
	//Отбор = Новый Структура("ЭтоГСМ", Истина);
	//ТЗЖидкости = ВремТЗ.Скопировать(Отбор);
	////Sign code of LU cost charged before tax
	//ТекСтрока = ТекСтрока + СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(ТЗЖидкости.Итог("СуммаВсего_Инвойс"),СтавкаНДС),"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");  
	//ТекСтрока = ТекСтрока + "+";
	//ТекСтрока = ТекСтрока + "000000000000000";  //Sign code of the fixed price charged before tax
	//
	//ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока+ДополнитьСтроку("0",15,"0");
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока+ДополнитьСтроку("0",15,"0");
    ТекСтрока =ТекСтрока +"+";

	//Total labor time
	ТекСтрока = ТекСтрока + ДополнитьСтроку(СтрЗаменить(СтрЗаменить(Формат(РаботыСобытия.Итог("Коэффициент")," ЧДЦ=1"),Символы.НПП,""),",",""),3,"0",Ложь);
	//СтрЗаменить(Формат(РаботыСобытия.Итог("Количество"),"ЧЦ=3; ЧДЦ=1; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + " ";
	
	//Approval number                       
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",11);//EDR_ОбщийМодуль.ФорматироватьСтроку("           ", 11); //Событие.НомерСогласования

	//Delta mission number / assistant mission number
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",11);// "           ";
	
	ТекСтрока = ТекСтрока +  " "; //Specific Dealer Code (formerly CIR)
	ТекСтрока = ТекСтрока + ДополнитьСтроку(ТипИнвойса,2);// + " "; //Intervention type
	ТекСтрока = ТекСтрока +ДополнитьСтроку(" ",4);// "    ";//NITG code
	ТекСтрока = ТекСтрока +ДополнитьСтроку(" ",4);// "    ";//Standardized team Id
	ТекСтрока = ТекСтрока +ДополнитьСтроку("0",4,"0");// "0000";//Total labor time spent for the intervention
	ТекСтрока = ТекСтрока + ДополнитьСтроку(" ",4);//"    ";//symptom code 
	
	//BIN
	Пока СтрДлина(ТекСтрока) < 17 Цикл
		
		ТекСтрока = ТекСтрока + " ";
		
	КонецЦикла;
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
		
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);

	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;
КонецФункции // СформироватьСтроку020(Событие)

//// Формирует строку № 023 - Описание операции.
////
//// Параметры
////  Событие  - Строка дерева значений - содержит строку ДЗ с данными по инциденту
////  НомерСтроки - Число - Содержит порядковый номер формируемой строки.  Строк 023 может быть сколько угодно.
////						  Так же по этому номеру определяем с кокого символа нужно начинать выборку
////  ТекстОписания - Строка(200) - Текст описания, который нужно вывести
//// Возвращаемое значение:
////   Строка   - Отформатированная строка по правилам EDR
////
Функция СформироватьСтроку023(Событие, НомерСтроки, ТекстОписания)

	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(Событие.Ссылка);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Событие.Ссылка.Номер, 6);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку("А", 1);
	ТекСтрока = ТекСтрока + "00"; //Указзание ранга авторабот приводит к ошибке.
	ТекСтрока = ТекСтрока + "023";
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(НомерСтроки, 3,"0", Истина);
	ТекСтрока = ТекСтрока + ТекстОписания;
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
		
	КонецЦикла;
	
	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	
	Возврат ТекСтрока;
КонецФункции // СформироватьСтроку023()

//////@+ Функция СформироватьСтроку025(Событие, НомерСтроки, ТекстКомментария)
//// Дата создания - 08.06.2012 12:04:56;
//// Автор - Окипний Андрей Евгеньевич
////
//// Описание функции
//// Формирует строку № 025 - Комментарии.
////
//// Параметры
////  Парам1 Событие  - Строка дерева значений - содержит строку ДЗ с данными по инциденту
////
////  Парам2 НомерСтроки  - Число(1) - Порядковый номер строки комментария.
////  их может быть три. Так же по этому номеру определяем с кокого символа нужно начинать выборку
////
////  Парам3 ТекстКомментария  - Строка(120) - Комментарий который нужно вывести
////
////
//// Возвращаемое значение
////  ТекСтрока  - Строка(300)- Результирующая строка
////
////@-
Функция СформироватьСтроку025(Событие, НомерСтроки, ТекстКомментария) 
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(Событие.Ссылка);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Событие.Invoice, 6);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Событие.Intervention, 1);
	ТекСтрока = ТекСтрока + "00"; //Указзание ранга авторабот приводит к ошибке.
	ТекСтрока = ТекСтрока + "025";
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(НомерСтроки, 2, "0", Истина);
	ТекСтрока = ТекСтрока + ТекстКомментария;
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
