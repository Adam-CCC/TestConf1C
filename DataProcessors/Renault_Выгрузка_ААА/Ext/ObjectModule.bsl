////@+ Функция СформироватьСтроку050(Параметры)
// Дата создания - 08.06.2012 11:59:02;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Функция формирует строку 050 - информация о работках заказ - наряда
//
// Параметры
//  Парам1 Параметры  - Соответствие - содержит ссылку на строку детали из ЗН
//  и строку Событие
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300)- Результирующая строка
//
//@-
Функция СформироватьСтроку050(Параметры) 
	
	ЗНСтрокаРаботы = Параметры["СтрокаРаботы"];
	Событие		   = Параметры["Событие"];

	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(Событие.Ссылка);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(Событие.Ссылка) +ТипИнвойса, 6);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(ТипИнвойса,1);
	ТекСтрока = ТекСтрока + "00"; //Указание ранга авторабот приводит к ошибке.
	ТекСтрока = ТекСтрока + "050";
	Поиск =ТаблицаАртикулов.Найти(ЗНСтрокаРаботы.Работа,"Авторабота"); 
	Если ЗначениеЗаполнено(Поиск) Тогда
		ТекСтрока = ТекСтрока + ДополнитьСтроку(Поиск.КодПоКаталогу,8);
	Иначе
		Поиск2 = ТаблицаАртикулов.Найти(ЗНСтрокаРаботы.Работа.Артикул,"КодПоКаталогу");
		Если ЗначениеЗаполнено(Поиск2) Тогда
			ТекСтрока = ТекСтрока + ДополнитьСтроку(Поиск2.КодПоКаталогу,8);
		Иначе
			Если ВОперКОд9 = Истина Тогда
				ТекСтрока = ТекСтрока + ДополнитьСтроку("9999",8);
			Иначе
				Если ЗначениеЗаполнено(ЗНСтрокаРаботы.Работа.Артикул) Тогда
					ТекСтрока = ТекСтрока + ДополнитьСтроку(ЗНСтрокаРаботы.Работа.Артикул,8);
				Иначе
					ТекСтрока = ТекСтрока + ДополнитьСтроку("9999",8);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(?(ЗначениеЗаполнено(Поиск),Поиск.КодПоКаталогу,?(ЗначениеЗаполнено(ЗНСтрокаРаботы.Работа.Артикул),ЗНСтрокаРаботы.Работа.Артикул,"9999"))), 8);//ЗНСтрокаРаботы.Работа.Артикул)), 8);
	
	Если ТипЗнч(ЗНСтрокаРаботы.Работа) = Тип("СправочникСсылка.Автоработы") тогда                   
		
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(ЗНСтрокаРаботы.Работа.Наименование), 35);
		
	Иначе
		
		ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(ЗНСтрокаРаботы.Работа), 35);
		
	КонецЕсли;
	
	ТекСтрока = ТекСтрока + "0";//?(ЗНСтрокаРаботы.ПричинаОбращения = Истина, 1, 0 );
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокаРаботы.Коэффициент*ЗНСтрокаРаботы.Количество,"ЧЦ=3; ЧДЦ=1; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокаРаботы.Цена,"ЧЦ=13; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",",""); //Hourly rate before tax
	ТекСтрока = ТекСтрока + ?(ЗНСтрокаРаботы.СтавкаНДС.Ставка > 0,"1","0"); //Tax code
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокаРаботы.СтавкаНДС.Ставка,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",",""); //VAT rate
	ТекСтрока = ТекСтрока +СтрЗаменить(Формат(0,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",",""); //СтрЗаменить(Формат(ЗНСтрокаРаботы.ПроцентСкидкиСтроки+ЗНСтрокаРаботы.ПроцентСкидки,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+";
	СуммаПоСтроке = ЗНСтрокаРаботы.СуммаВсего_Инвойс;//+ЗНСтрокаРаботы.СуммаСкидки+ЗНСтрокаРаботы.СуммаСкидкиСтроки;
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(СуммаПоСтроке,ЗНСтрокаРаботы.СтавкаНДС.Ставка),"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокаРаботы.СуммаНДС_Инвойс,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	
	
	ТекСтрока = ТекСтрока + "    ";	//1st mechanic id
	ТекСтрока = ТекСтрока + "0000";
	ТекСтрока = ТекСтрока + "    ";	//2st mechanic id
	ТекСтрока = ТекСтрока + "0000";
	ТекСтрока = ТекСтрока + "    ";	//3rd mechanic id
	ТекСтрока = ТекСтрока + "0000";
	ТекСтрока = ТекСтрока + "    ";	//4th mechanic id
	ТекСтрока = ТекСтрока + "0000";
	ТекСтрока = ТекСтрока + "    ";	//5th mechanic id
	ТекСтрока = ТекСтрока + "0000";
		
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);

	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;

КонецФункции // СформироватьСтроку050(Параметры)

////@+ Функция СформироватьСтроку060(Параметры)
// Дата создания - 08.06.2012 11:52:24;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// Функция формирует строку 060 - информация о деталях заказ - наряда
//
// Параметры
//  Парам1 Параметры  - Соответствие - содержит ссылку на строку детали из ЗН
//  и строку Событие
//
// Возвращаемое значение
//  ТекСтрока  - Строка(300)- Результирующая строка
//
//@-
Функция СформироватьСтроку060(Параметры)
	
	ЗНСтрокадетали = Параметры["СтрокаДетали"];
	Событие		   = Параметры["Событие"];
	
	//Формируем начало строки
	ТекСтрока = ПолучитьЗаголовокСтроки(Событие);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(Событие.Ссылка) +ТипИнвойса, 6);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(ТипИнвойса,1);
	ТекСтрока = ТекСтрока + "00";
	ТекСтрока = ТекСтрока + "060";
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(ЗНСтрокадетали.Номенклатура.Артикул), 10);
	ТекСтрока = ТекСтрока + EDR_ОбщийМодуль.ФорматироватьСтроку(Строка(ЗНСтрокадетали.Номенклатура), 17);
	
	ЭтоГСМ = ЛОЖЬ;// ЗНСтрокадетали.ЭтоГСМ;
	
	ТекСтрока = ТекСтрока + "  "; //Прочие товары
	
	ТекСтрока = ТекСтрока + "+";
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокадетали.Количество,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "0";//?(ЗНСтрокадетали.ПричинаОбращения = Истина, 1, 0 );
	ТекСтрока = ТекСтрока + "C"; //CORT : Manufacturer  
	ТекСтрока = ТекСтрока + " "; //CORT : Origin 
	ТекСтрока = ТекСтрока + " "; //CORT : Discount  
	//ТекСтрока = ТекСтрока + ?(ЗНСтрокадетали.СтавкаНДС.Ставка > 0,"1","0"); //CORT : Tax Пока ставим 1
	ТекСтрока = ТекСтрока + "0"; //CORT : без ндс

	ТекСтрока = ТекСтрока + "S"; 
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(ЗНСтрокадетали.Цена, ЗНСтрокадетали.СтавкаНДС.Ставка),"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	//ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокадетали.ПроцентСкидкиСтроки + ЗНСтрокадетали.ПроцентСкидки,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(0,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	

	ТекСтрока = ТекСтрока + "00000"; //Дополнительные налоги - у нас не применяются
	
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокадетали.СтавкаНДС.Ставка,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+"; 
	//ТекСтрока = ТекСтрока + СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(ЗНСтрокадетали.СуммаВсего_Инвойс, ЗНСтрокадетали.СтавкаНДС.Ставка),"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	//ТекСтрока = ТекСтрока + "+"; 
	//ТекСтрока = ТекСтрока + СтрЗаменить(Формат(0,"ЧЦ=5; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	//ТекСтрока = ТекСтрока + "+"; 
	СуммаПоСтроке = ЗНСтрокадетали.СуммаВсего_Инвойс;//+ЗНСтрокадетали.СуммаСкидки+ЗНСтрокадетали.СуммаСкидкиСтроки;
	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(EDR_КешируемыеЗначения.ПолучитьСуммуБезНалога(СуммаПоСтроке, ЗНСтрокадетали.СтавкаНДС.Ставка),"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	ТекСтрока = ТекСтрока + "+"; 

	ТекСтрока = ТекСтрока + СтрЗаменить(Формат(ЗНСтрокадетали.СуммаНДС_инвойс,"ЧЦ=15; ЧДЦ=2; ЧРД=; ЧН=; ЧВН=; ЧГ="), ",","");
	
	
	ТекСтрока = ТекСтрока + " "; //Packaging code
	
	//добавил М.О.
	ТекСтрока = СтрЗаменить(ТекСтрока, Символы.ПС, "");
	
	Пока СтрДлина(ТекСтрока) < 300 Цикл
		ТекСтрока = ТекСтрока + " ";		//Filled up to 300
	КонецЦикла;
	
	ТекСтрока = ВРег(ТекСтрока);

	КоличествоСтрокВыгружено = КоличествоСтрокВыгружено + 1;
	Возврат ТекСтрока;

КонецФункции // СформироватьСтроку060(Параметры)

