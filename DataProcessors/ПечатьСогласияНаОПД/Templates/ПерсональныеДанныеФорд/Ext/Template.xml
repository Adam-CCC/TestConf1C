					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Я, [ФИО], далее - Клиент, зарегистрированный по адресу: [Адрес]
документ, удостоверяющий личность [Паспорт]
</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
