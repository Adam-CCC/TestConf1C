						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>     3.1.1 указать в поле "Согласие на обработку ПД" значение "Да";</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
	<rowsItem>
		<index>13</index>
