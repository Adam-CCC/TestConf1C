Перем Права; // Переменная объекта - ссылка на коллекцию прав, настроек и переменных окружения

Процедура Печать(НаПринтер = Ложь) Экспорт
	Если Не БылаИнициализация И Не ИнициализацияРеквизитов() Тогда
		Возврат;
	КонецЕсли;	
	 
	ТабДокумент = СогдасиеНаОПДУниверс(Новый ТабличныйДокумент(), ДатаСогласия);
	Если ТабДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НаПринтер Тогда
		ТабДокумент.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
		Возврат;
	КонецЕсли;
	
	// Отобразить печатный документ на экране
	КлючУникальности	= Новый УникальныйИдентификатор();
	ФормаПечати			= ПолучитьОбщуюФорму("ПечатнаяФормаДокументов",,КлючУникальности);
	ТабличныйДокумент	= ФормаПечати.ЭлементыФормы.ТабличныйДокумент;
	ТабличныйДокумент.Защита			= обПраво("ЗащитаПечатныхФорм",Права);
	ТабличныйДокумент.ТолькоПросмотр	= обПраво("ОткрытиеПечатныхФормДокументовВРежимеПросмотра",Права);
	// Выведем печатную форму	
	ФормаПечати.ЭлементыФормы.ТабличныйДокумент.Вывести(ТабДокумент);
	ФормаПечати.ЭлементыФормы.ТабличныйДокумент.Автомасштаб = Истина;
	// Заполним необходимые переменные и откроем форму
	ФормаПечати.Объект						= ЭтотОбъект;
	ФормаПечати.ОбъектПредставление			= Строка(ЭтотОбъект);
	ФормаПечати.ДополнительноКПредставлению	= "Согласие на обработку персональных данных";
	ФормаПечати.Открыть();
	
	//Если Контрагент <> ДокументОбъект.Ссылка 
	//	И Контрагент.СогласиеНаОбработкуПерсональныхДанных <> Перечисления.ВариантыОтветов.Да Тогда
	//	КонтрагентОбъект = Контрагент.ПолучитьОбъект();
	//	КонтрагентОбъект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да;
	//	КонтрагентОбъект.СогласиеНаОбработкуПерсональныхДанныхДата = НачалоДня(ТекущаяДата());
	//	КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
	//	КонтрагентОбъект.Записать();
	//КонецЕсли;
КонецПроцедуры // ПечатьСогласиеНаОПД()

Функция СогдасиеНаОПДУниверс(ТабДокумент, ДатаСогласия) Экспорт
	Если  Не БылаИнициализация И Не ИнициализацияРеквизитов() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(ТабДокумент) Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ЭтоДилерХендэ = Организация.Код = "00001   " Или Организация.Код = "ЦБ000027"; // Автоком-Дон ООО или Автоком Шахты ООО
	
	ЭтоАвтопарк = Организация.Код = "ЦБ000008"; // Автопарк ООО
	ЭтоАвтопаркПлюс = Организация.Код = "ЦБ000016"; // Автопарк Плюс ООО
	ЭтоТранзит = Организация.Код = "ЦБ000014"; // Транзит ООО
	ЭтоАтлантМоторс = Организация.Код = "ЦБ000007"; // Атлант Моторс ООО
	ЭтоРентаКар = Организация.Код = "ЦБ000012"; // Рента Кар ООО
	ЭтоПрестижМоторс = Организация.Код = "ЦБ000017"; // Престиж Моторс ООО
	ЭтоГаммаМоторс = Организация.Код = "ЦБ000029"; // Гамма Моторс ООО
	ЭтоКорандоШахты = Организация.Код = "ЦБ000023"; // Корандо Шахты ООО
	
	Марка = Автомобиль.Модель.Марка;
	ДилерскийЦентр = ПараметрыСеанса.ПодразделениеКомпании.ДилерскийЦентр;
	Если ЭтоДилерХендэ Тогда
		Если Марка = Справочники.Марка.HYUNDAI Тогда
			Если ДатаСогласия <= Дата(2020,1,27) Тогда
				Макет = ПолучитьМакет("ПерсональныеДанные");
				Макет.Параметры.ДатаОкончанияСогласия = Формат(Контрагент._г_ДатаОкончанияСогласия,"ДЛФ=DD");
			Иначе	
				Макет = ПолучитьМакет("ПерсональныеДанныеХёндэ");
			КонецЕсли;
			Макет.Параметры.Телефон = ПредставлениеТелефона;
			Макет.Параметры.Email = киПолучитьПредставлениеКИ(Контрагент, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;
		
	ИначеЕсли ЭтоАвтопарк Тогда
		Если Марка = Справочники.Марка.NISSAN Тогда
			Макет = ПолучитьМакет("ПерсональныеДанныеОлимп");
			
		ИначеЕсли Марка = Справочники.Марка.OMODA Или Марка = Справочники.Марка.JAECOO Тогда
			Макет = ПолучитьМакет("ПерсональныеДанныеОмода");
			Макет.Параметры.ДатаРождения = Формат(Контрагент.ДатаРождения, "ДЛФ=ДД");
			Макет.Параметры.Телефон = ПредставлениеТелефона;
			Макет.Параметры.Email = киПолучитьПредставлениеКИ(Контрагент, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
			Модель = Автомобиль.Модель;
			Макет.Параметры.Модель = Модель;
			Макет.Параметры.VIN = Автомобиль.VIN;
			Макет.Параметры.Марка = Модель.Марка;
			
			МестоРождения = "";
			Если ВвестиСтроку(МестоРождения, "Введите место рождения клиента") Тогда
				Макет.Параметры.МестоРождения = МестоРождения;
			Иначе
				Макет.Параметры.МестоРождения = "не указано";
			КонецЕсли;
			Если Марка = Справочники.Марка.OMODA Тогда
				Макет.Параметры.ОрганизацияРуководитель = "ООО «ОНИВС РУС», в лице генерального директора Пугина А.В.";
			Иначе
				Макет.Параметры.ОрганизацияРуководитель = "ООО «ДЖЕЙЛЭНД РУС», в лице генерального директора Пулатова Б. М.";
			КонецЕсли;
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;
		
	ИначеЕсли ЭтоАвтопаркПлюс Тогда
		Если Марка = Справочники.Марка.NISSAN Тогда
			Макет = ПолучитьМакет("ПерсональныеДанныеОлимп");
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;
		
	ИначеЕсли ЭтоАтлантМоторс Тогда
		Если Марка = Справочники.Марка.JEEP Или Марка = Справочники.Марка.FIAT Тогда
			Макет = ПолучитьМакет("ПерсональныеДанныеДжипФиат");
		
		ИначеЕсли Марка = Справочники.Марка.CHANGAN Тогда 
			ТабДокумент = ЧанганСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
		
		ИначеЕсли Марка = Справочники.Марка.EXEED Тогда 
			ТабДокумент = ЧерриСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
			
		ИначеЕсли Марка = Справочники.Марка.JAC Тогда 
			ТабДокумент = ДжакСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
		
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;
		
	ИначеЕсли ЭтоГаммаМоторс Тогда
		Если Марка = Справочники.Марка.GEELY Тогда 
			ТабДокумент = ДжилиСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
			
		ИначеЕсли Марка = Справочники.Марка.BELGEE Тогда 
			ТабДокумент = БелджиСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;		
		
	ИначеЕсли ЭтоПрестижМоторс Тогда
		Если Марка = Справочники.Марка.CHERY Тогда 
			ТабДокумент = ЧерриСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;		
		
	ИначеЕсли ЭтоРентаКар Тогда
		Если Марка = Справочники.Марка.FORD Тогда
			Макет = ПолучитьМакет("ПерсональныеДанныеФорд");
			Макет.Параметры.ЭлПочта = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
		
		ИначеЕсли Марка = Справочники.Марка.UAZ Тогда 
			ТабДокумент = УАЗСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
		
		ИначеЕсли Марка = Справочники.Марка.KAIYI ИЛИ Марка = Справочники.Марка.BAIC Тогда 
			ТабДокумент = ЧерриСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;		
		
	ИначеЕсли ЭтоКорандоШахты Тогда
		Если Марка = Справочники.Марка.UAZ Тогда 
			ТабДокумент = УАЗСогласиеНаОПД(ТабДокумент);
			Возврат ТабДокумент;
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;		
		
	ИначеЕсли ЭтоТранзит Тогда
		Если Марка = Справочники.Марка.LADA_ВАЗ Или Марка = Справочники.Марка.ВИС_АВТО Тогда 
			Макет = ПолучитьМакет("ПерсональныеДанныеЛада");
			Макет.Параметры.Телефон = ПредставлениеТелефона;
			Макет.Параметры.Email = киПолучитьПредставлениеКИ(Контрагент, Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
			Макет.Параметры.ДатаРождения = Формат(Контрагент.ДатаРождения, "ДЛФ=ДД");
			Макет.Параметры.Пол = Контрагент.Пол;
			Макет.Параметры.VIN = Автомобиль.VIN;
			Макет.Параметры.Модель = Автомобиль.Модель;
			Макет.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
			
		Иначе
			ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
			Возврат ТабДокумент;
		КонецЕсли;		
		
	Иначе
		ТабДокумент = ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия);
		Возврат ТабДокумент;
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	Попытка
		ОбластьМакета.Параметры.ФИО = спПолучитьНаименование(Контрагент);
		ОбластьМакета.Параметры.Адрес =  киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
		ПодтверждающийДокумент = спПолучитьПодтверждающийДокументОбъектаПоВиду(Контрагент, Перечисления.ВидыДокументов.Паспорт);
		Если НЕ ПодтверждающийДокумент.Пустая() Тогда
			ОбластьМакета.Параметры.Паспорт = ПодтверждающийДокумент.Наименование;
		КонецЕсли;
	Исключение КонецПопытки;
	
	Попытка
 		ОбластьМакета.Параметры.ФирмаПолноеНаименование = спПолучитьНаименование(Организация);
	Исключение КонецПопытки;
	Попытка
		ОбластьМакета.Параметры.ФирмаАдресЮридический = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Исключение КонецПопытки;
	Попытка
 		ОбластьМакета.Параметры.Телефоны = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Исключение КонецПопытки;
	Попытка
		ОбластьМакета.Параметры.ФирмаАдресФактический = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Исключение КонецПопытки;
	
	Попытка
		ОбластьМакета.Параметры.ДатаПрописью = Формат(ДатаСогласия,"ДЛФ=DD");
	Исключение КонецПопытки;
	
	Попытка
		ОбластьМакета.Параметры.Дата = Формат(ДатаСогласия,"ДФ=dd.MM.yyyy"); 
	Исключение	КонецПопытки;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	//Бондаренко++ 20200131
	ФлагТелематика = Ложь; ФлагАвтоЛинк = Ложь;
	Если ФлагТелематика Тогда
		Если ДилерскийЦентр = Справочники.ДилерскиеЦентры.Дельта Или ДилерскийЦентр = Справочники.ДилерскиеЦентры.ХендэШахты Тогда
	  		Если ДатаСогласия >= Дата(2020,1,28)Тогда
	 			ОбластьМакета = Макет.ПолучитьОбласть("ОТК");
				ОбластьМакета.Параметры.ФИО = спПолучитьНаименование(Контрагент);
 				ОбластьМакета.Параметры.ФирмаПолноеНаименование = спПолучитьНаименование(Организация);
				ОбластьМакета.Параметры.ФирмаАдресФактический = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресФактический);
				ОбластьМакета.Параметры.ДатаПрописью = Формат(ДатаСогласия,"ДЛФ=DD");
 				ТабДокумент.Вывести(ОбластьМакета);	
  			КонецЕсли; 
  		КонецЕсли; 
	КонецЕсли; 
	//Бондаренко-- 20200131
	
	//Бондаренко++ 20201113
	Если ФлагАвтоЛинк Тогда
		Если ДилерскийЦентр = Справочники.ДилерскиеЦентры.Дельта Или ДилерскийЦентр = Справочники.ДилерскиеЦентры.ХендэШахты Тогда
			Если ДатаСогласия >= Дата(2020,11,16) Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ОТК_доп");
				ОбластьМакета.Параметры.ФИО = спПолучитьНаименование(Контрагент);
				ОбластьМакета.Параметры.ДатаПрописью = Формат(ДатаСогласия,"ДЛФ=DD");
				ТабДокумент.Вывести(ОбластьМакета);	
			КонецЕсли; 		
		КонецЕсли; 	
	КонецЕсли; 	
	//Бондаренко-- 20201113
	
	ТабДокумент.Автомасштаб = Истина;
	Возврат ТабДокумент;
КонецФункции

Функция ТиповоеСогласиеНаОПД(ТабДокумент, ДатаСогласия)
	Макет = ПолучитьМакет("СогласиеНаОбработкуПерсональныхДанных");
	
	СтруктураПредставления = Новый Структура(
	"ИНН,КПП,АдресЮридический,ТелефонРабочий",
	"ИНН ","КПП ","Адрес: ","тел.: ");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.КонтрагентНаименование	= Контрагент.НаименованиеПолное;
	ОбластьМакета.Параметры.КонтрагентАдрес			= киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьМакета.Параметры.КонтрагентДокумент		= спПолучитьПодтверждающийДокументОбъектаПоВиду(Контрагент,Перечисления.ВидыДокументов.Паспорт);
	
	СогласиеНаОПДданоОрганизации = Организация;
	Если обЗначениеНеЗаполнено(СогласиеНаОПДданоОрганизации) Тогда
	//Бондаренко-- 20200205	
		ОбластьМакета.Параметры.ОрганизацияНаименование	= спПолучитьПредставление(ПараметрыСеанса.Организация,Новый Структура("Наименование",""));
		ОбластьМакета.Параметры.ОрганизацияАдрес		= спПолучитьПредставление(ПараметрыСеанса.Организация,СтруктураПредставления);
	Иначе
		ОбластьМакета.Параметры.ОрганизацияНаименование	= спПолучитьПредставление(СогласиеНаОПДданоОрганизации,Новый Структура("Наименование",""));
		ОбластьМакета.Параметры.ОрганизацияАдрес		= спПолучитьПредставление(СогласиеНаОПДданоОрганизации,СтруктураПредставления);
	//Бондаренко++ 20200205	
	КонецЕсли;  
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Согласие");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.КонтрагентНаименование = Контрагент.Наименование;
	ОбластьМакета.Параметры.СогласиеДата = Формат(ДатаСогласия, "ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.Автомасштаб = Истина;
	Возврат ТабДокумент;
КонецФункции

Функция ОтзывСогдасияНаОПД(ТабДокумент, ДатаСогласия)
	Макет = ПолучитьМакет("ОтзывСогласияНаОПД");
	
	СтруктураПредставления = Новый Структура(
	"ИНН,КПП,АдресЮридический,ТелефонРабочий",
	"ИНН ","КПП ","Адрес: ","тел.: ");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.КонтрагентНаименование = Контрагент.НаименованиеПолное;
	ОбластьМакета.Параметры.КонтрагентАдрес	= киПолучитьПредставлениеКИ(Контрагент,Справочники.ВидыКонтактнойИнформации.АдресФактический);
	
	КонтрагентДокумент = спПолучитьПодтверждающийДокументОбъектаПоВиду(Контрагент,Перечисления.ВидыДокументов.Паспорт);
	Если ЗначениеЗаполнено(КонтрагентДокумент) Тогда
		ОбластьМакета.Параметры.КонтрагентДокумент = Строка(КонтрагентДокумент) + " " + КонтрагентДокумент.КемВыдан;
	КонецЕсли;	
	
	ОбластьМакета.Параметры.ОрганизацияНаименование	= спПолучитьПредставление(Организация, Новый Структура("Наименование",""));
	ОбластьМакета.Параметры.ОрганизацияАдрес = спПолучитьПредставление(Организация, Новый Структура("АдресЮридический",""));
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	//ОбластьМакета.Параметры.КонтрагентНаименование = Контрагент.Наименование;
	ОбластьМакета.Параметры.СогласиеДата = Формат(ДатаСогласия, "ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.Автомасштаб = Истина;
	Возврат ТабДокумент;
КонецФункции

Функция ИнициализацияРеквизитов(ЭтоОтзыв = Ложь)
	Если обЗначениеНеЗаполнено(ДокументОбъект) Тогда
		Сообщить("В обработку ""Печать согласия на ОПД"" не передан объект!", СтатусСообщения.Важное);
		БылаИнициализация = Ложь;
		Возврат БылаИнициализация;
	КонецЕсли;
	
	Попытка
		ОбъектМетаданных = ДокументОбъект.Метаданные();
	Исключение
		Сообщить("В обработку ""Печать согласия на ОПД"" передан объект некорректного типа!", СтатусСообщения.Важное);
		БылаИнициализация = Ложь;
		Возврат БылаИнициализация;
	КонецПопытки;
	
	Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Если ОбъектМетаданных.Имя = "ЗаказНаряд" Тогда
			Если ЗначениеЗаполнено(ДокументОбъект.Владелец) Тогда
				Контрагент = ДокументОбъект.Владелец;
			Иначе
				Контрагент = ДокументОбъект.Заказчик;
			КонецЕсли;	
			
		ИначеЕсли ОбъектМетаданных.Имя = "ЗаявкаНаРемонт" Тогда
				Контрагент = ДокументОбъект.Заказчик;
			
		ИначеЕсли ОбъектМетаданных.Имя = "РеализацияАвтомобилей" Тогда
			Если ЗначениеЗаполнено(ДокументОбъект.Заказчик) Тогда
				Контрагент = ДокументОбъект.Заказчик;
			Иначе
				Контрагент = ДокументОбъект.Контрагент;
			КонецЕсли;	
			
		ИначеЕсли ОбъектМетаданных.Реквизиты.Найти("Контрагент") = Неопределено Тогда
			Сообщить("У документа " + ОбъектМетаданных.Имя + " нет реквизита Контрагент!", СтатусСообщения.Информация);
			БылаИнициализация = Ложь;
			Возврат БылаИнициализация;
			
		ИначеЕсли обЗначениеНеЗаполнено(ДокументОбъект.Контрагент) Тогда
				Сообщить("У документа " + Строка(ДокументОбъект) + " реквизит Контрагент не заполнен!", СтатусСообщения.Информация);
				БылаИнициализация = Ложь;
				Возврат БылаИнициализация;
					
		Иначе
			Контрагент = ДокументОбъект.Контрагент;
		КонецЕсли;
		
		Если Контрагент.ФормаСобственности <> Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
			БылаИнициализация = Ложь;
			Возврат БылаИнициализация;
		Иначе
			ПредставлениеТелефона = Контрагент.ОсновнойТелефон;			
		КонецЕсли;
		
		Если ОбъектМетаданных.Реквизиты.Найти("Организация") = Неопределено Тогда
			Организация = ПараметрыСеанса.Организация;
		Иначе
			Организация = ДокументОбъект.Организация;		
		КонецЕсли;
		
		Если ОбъектМетаданных.Реквизиты.Найти("Автомобиль") <> Неопределено Тогда
			Автомобиль = ДокументОбъект.Автомобиль;		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("СправочникОбъект.Контрагенты") Тогда
		Если обЗначениеНеЗаполнено(Организация) Тогда
			Сообщить("Не указана организация, для которой распечатывается согласие на ОПД контрагента!", СтатусСообщения.Внимание);
			БылаИнициализация = Ложь;
			Возврат БылаИнициализация;
		КонецЕсли;
		
		Контрагент = ДокументОбъект.Ссылка;
		Если обЗначениеНеЗаполнено(Контрагент) Тогда
			Сообщить("Для распечатки согласия на обработку персональных данных необходимо сохранить контрагента!", СтатусСообщения.Внимание);
			БылаИнициализация = Ложь;
			Возврат БылаИнициализация;
		КонецЕсли;
		ПредставлениеТелефона = ДокументОбъект.ОсновнойТелефон;
		
	Иначе
		Сообщить("В обработку ""Печать согласия на ОПД"" передан объект некорректного типа!", СтатусСообщения.Важное);
		БылаИнициализация = Ложь;
		Возврат БылаИнициализация;
	КонецЕсли;
	
	ЗапросСОПД = Новый Запрос();
	ЗапросСОПД.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросСОПД.УстановитьПараметр("Организация", Организация);
	ЗапросСОПД.Текст =
	"ВЫБРАТЬ
	|	СогласиеНаОПДСрезПоследних.Период,
	|	СогласиеНаОПДСрезПоследних.СогласиеДано
	|ИЗ
	|	РегистрСведений.СогласиеНаОПД.СрезПоследних(
	|			,
	|			Контрагент = &Контрагент
	|				И Организация = &Организация) КАК СогласиеНаОПДСрезПоследних";
	
	Если (ЭтоОтзыв) Тогда
		СогласиеДано = Перечисления.ВариантыОтветов.Нет;
	Иначе
		СогласиеДано = Перечисления.ВариантыОтветов.Да;
	КонецЕсли;
	
	ВыборкаСОПД = ЗапросСОПД.Выполнить().Выбрать();
	Если ВыборкаСОПД.Следующий() И ВыборкаСОПД.СогласиеДано = СогласиеДано Тогда
		ДатаСогласия = ВыборкаСОПД.Период;
		
	Иначе
		ДатаСогласия = НачалоДня(ТекущаяДата());
		мзСогласиеНаОПД = РегистрыСведений.СогласиеНаОПД.СоздатьМенеджерЗаписи();
		мзСогласиеНаОПД.Период = ДатаСогласия;
		мзСогласиеНаОПД.Контрагент = Контрагент;
		мзСогласиеНаОПД.Организация = Организация;
		мзСогласиеНаОПД.СогласиеДано = СогласиеДано;
		мзСогласиеНаОПД.Оператор = ПараметрыСеанса.Пользователь;
		мзСогласиеНаОПД.Записать();
	КонецЕсли;
	
	БылаИнициализация = Истина;
	Возврат БылаИнициализация;
КонецФункции

Процедура ПроверитьСогласиеНаОПД() Экспорт
	Если обЗначениеНеЗаполнено(Контрагент) Или обЗначениеНеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	Если Контрагент.ФормаСобственности <> Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросСОПД = Новый Запрос();
	ЗапросСОПД.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросСОПД.УстановитьПараметр("Организация", Организация);
	ЗапросСОПД.Текст =
	"ВЫБРАТЬ
	|	СогласиеНаОПДСрезПоследних.СогласиеДано
	|ИЗ
	|	РегистрСведений.СогласиеНаОПД.СрезПоследних(
	|			,
	|			Контрагент = &Контрагент
	|				И Организация = &Организация) КАК СогласиеНаОПДСрезПоследних";
	
	ВыборкаСОПД = ЗапросСОПД.Выполнить().Выбрать();
	Если ВыборкаСОПД.Следующий() И ВыборкаСОПД.СогласиеДано = Перечисления.ВариантыОтветов.Да Тогда
		Возврат;
		
	Иначе
		Сообщить("У контрагента " + Строка(Контрагент) + " для " + Строка(Организация) + " необходимо получить согласие на ОПД!", СтатусСообщения.Внимание);
		Сообщить("Файл скана/фото подписанного согласия необходимо поместить в соответствующую строку", СтатусСообщения.Внимание);
		Сообщить("   на вкладке 'Согласия на ОПД' карточки Контрагента!", СтатусСообщения.Внимание);
		Печать();
	КонецЕсли;	
КонецПроцедуры

Процедура ПечатьОтзываСОПД(НаПринтер = Ложь) Экспорт
	Если Не БылаИнициализация И Не ИнициализацияРеквизитов(Истина) Тогда
		Возврат;
	КонецЕсли;	
	 
	ТабДокумент = ОтзывСогдасияНаОПД(Новый ТабличныйДокумент(), ДатаСогласия);
	Если ТабДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НаПринтер Тогда
		ТабДокумент.Напечатать(РежимИспользованияДиалогаПечати.НеИспользовать);
		Возврат;
	КонецЕсли;
	
	// Отобразить печатный документ на экране
	КлючУникальности	= Новый УникальныйИдентификатор();
	ФормаПечати			= ПолучитьОбщуюФорму("ПечатнаяФормаДокументов",,КлючУникальности);
	ТабличныйДокумент	= ФормаПечати.ЭлементыФормы.ТабличныйДокумент;
	ТабличныйДокумент.Защита			= обПраво("ЗащитаПечатныхФорм",Права);
	ТабличныйДокумент.ТолькоПросмотр	= обПраво("ОткрытиеПечатныхФормДокументовВРежимеПросмотра",Права);
	// Выведем печатную форму	
	ФормаПечати.ЭлементыФормы.ТабличныйДокумент.Вывести(ТабДокумент);
	// Заполним необходимые переменные и откроем форму
	ФормаПечати.Объект						= ЭтотОбъект;
	ФормаПечати.ОбъектПредставление			= Строка(ЭтотОбъект);
	ФормаПечати.ДополнительноКПредставлению	= "Отзыв согласия на обработку персональных данных";
	ФормаПечати.Открыть();
КонецПроцедуры

Процедура ПоказатьИнструкциюПоОПД() Экспорт
	ИнструкцияМакет = ПолучитьМакет("ИнструкцияПоОПД");
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.Вывести(ИнструкцияМакет);
	ТабДокумент.ТолькоПросмотр = Истина;
	ТабДокумент.Защита = Истина;
	ТабДокумент.ОтображатьСетку = Ложь;
	ТабДокумент.Показать("Система учета согласий на ОПД контрагентов");
КонецПроцедуры

Функция ЧанганСогласиеНаОПД(ТабДокумент)
	Макет = ПолучитьМакет("СОПД_Чанган");
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Контрагент = спПолучитьНаименование(Контрагент);
	ОбластьМакета.Параметры.АдресКлиента = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	
	//ПодтверждающийДокумент = спПолучитьПодтверждающийДокументОбъектаПоВиду(Контрагент, Перечисления.ВидыДокументов.Паспорт);
	//Если НЕ ПодтверждающийДокумент.Пустая() Тогда
	//	ОбластьМакета.Параметры.Паспорт = ПодтверждающийДокумент.Наименование;
	//КонецЕсли; 
	
	ОбластьМакета.Параметры.ФирмаПолноеНаименование = спПолучитьНаименование(Организация);
    ОбластьМакета.Параметры.ФирмаАдресЮридический = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьМакета.Параметры.Телефон = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	ОбластьМакета.Параметры.Телефон = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если ПустаяСтрока(ОбластьМакета.Параметры.Телефон) Тогда
		ОбластьМакета.Параметры.Телефон = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	Если ПустаяСтрока(ОбластьМакета.Параметры.Телефон) Тогда
		ОбластьМакета.Параметры.Телефон = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	
	ОбластьМакета.Параметры.ЭлПочта = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если ПустаяСтрока(ОбластьМакета.Параметры.ЭлПочта) Тогда
		ОбластьМакета.Параметры.ЭлПочта = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ОбластьМакета.Параметры.МоедльАвто_ВИН = ""+Автомобиль.Модель+", VIN "+ Автомобиль.VIN;
	ОбластьМакета.Параметры.Дата = Формат(ДатаСогласия, "ДФ=dd.MM.yyyy"); 	
	
	ТабДокумент.Вывести(ОбластьМакета);
	ТабДокумент.Автомасштаб = Истина;
 	ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ИспользоватьНастройкиПринтера;
 
	Возврат ТабДокумент;
КонецФункции

