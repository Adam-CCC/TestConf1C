Функция ДжакСогласиеНаОПД(ТабДокумент)
	Макет = ПолучитьМакет("СОПД_Джак"); 
	
	АдресОрганизации = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Если ПустаяСтрока(АдресОрганизации) Тогда
		АдресОрганизации = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
		
	НомерКонтактногоТелефона = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если ПустаяСтрока(НомерКонтактногоТелефона) Тогда
		НомерКонтактногоТелефона = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли; 
	
	Если ПустаяСтрока(НомерКонтактногоТелефона) Тогда
		НомерКонтактногоТелефона = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;  
	
	АдресЭлПочты = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если ПустаяСтрока(АдресЭлПочты) Тогда
		АдресЭлПочты = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли; 

	Адрес = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	
	
	ФИО                = спПолучитьНаименование(Контрагент);
	ОрганизацияИАдрес  = Строка(Организация) + "," + АдресОрганизации;
	ФамилияИмяОтчество = спПолучитьНаименование(Контрагент);
	МодельИВИННомер    = Строка(Автомобиль.Модель) + ", " + Строка(Автомобиль.VIN); 
	
	Парамерты = Новый Структура;
	Парамерты.Вставить("ФИО"                     ,ФИО);
	Парамерты.Вставить("ОрганизацияИАдрес"       ,ОрганизацияИАдрес);
	Парамерты.Вставить("ФамилияИмяОтчество"      ,ФамилияИмяОтчество);
	Парамерты.Вставить("НомерКонтактногоТелефона",НомерКонтактногоТелефона);
	Парамерты.Вставить("АдресЭлПочты"            ,АдресЭлПочты);
	Парамерты.Вставить("Адрес"                   ,Адрес);
	Парамерты.Вставить("МодельИВИННомер"         ,МодельИВИННомер);
	
	ЗаполнитьЗначенияСвойств(Макет.Параметры,Парамерты);
	
	ТабДокумент.Вывести(Макет);
	ТабДокумент.Автомасштаб = Истина;
	
	Возврат ТабДокумент;
КонецФункции

