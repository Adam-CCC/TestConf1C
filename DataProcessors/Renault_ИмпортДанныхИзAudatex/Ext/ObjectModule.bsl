Функция ВернутьОписаниеТиповРеквизита(Реквизит)
	
	Массив = Новый Массив;
	КС = Новый КвалификаторыСтроки(100);
	КД = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);
	КЧ = Новый КвалификаторыЧисла(15,2);
	Массив.Добавить(ТипЗнч(Реквизит));
	Возврат Новый ОписаниеТипов(Массив, Кч, Кс, Кд);
	
КонецФункции // ВернутьТипРеквизита()

Функция ПолучитьОписаниеТиповПЗ()
	
	Массив = Новый Массив;
	Для Каждого МетаданныеОбъектов Из Метаданные.Справочники Цикл
		Массив.Добавить(Тип("СправочникСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.ДОкументы Цикл
		Массив.Добавить(Тип("ДокументСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.Перечисления Цикл
		Массив.Добавить(Тип("ПеречислениеСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла;
	Массив.Добавить(Тип("Строка"));
	Массив.Добавить(Тип("Дата"));
	Массив.Добавить(Тип("Булево"));
	КС = Новый КвалификаторыСтроки(500);
	Возврат Новый ОписаниеТипов(Массив, , КС);
	
КонецФункции // ПОлучитьОписаниеТиповПЗ()

