// Функция осуществляет разбор объекта в дерево значений
//
// Параметры:
//  ОбъектРазбора - объект для разбора
//
// Возвращаемое значение - дерево значений после разбора
//
Функция РазобратьОбъектВДерево(ОбъектРазбора) Экспорт

	Дерево = СоздатьТипизированноеДерево();
	
	Для Каждого Реквизит Из ОбъектРазбора Цикл
		СтрокаДерева = Дерево.Строки.Добавить();
		СтрокаДерева.Реквизит = Реквизит.Имя;
		СтрокаДерева.Синоним = Реквизит.Синоним;
		СтрокаДерева.UIN = Новый УникальныйИдентификатор;
		
		МассивТипов = Новый Массив;
		Для Каждого тип Из Реквизит.Тип.Типы() Цикл
			Если МассивССТипов.Найти(тип) <> Неопределено Тогда
				МассивТипов.Добавить(тип);
			КонецЕсли;
		КонецЦикла;
		
		СтрокаДерева.ТипВыбираемогоЗнч = Реквизит.Тип.Типы()[0];
		СтрокаДерева.ОбъектМД = Неопределено;
		СтрокаДерева.МассивТипов = Реквизит.Тип.Типы();
		
		
		Если ОбъектОбразуетСсылочныйТип(Реквизит) Тогда
			СтрокаДерева.ОбъектМД = Неопределено;
			ОбъектМД = Новый (МассивТипов[0]);
			КоличествоВладельцев = 0;
			Для Каждого Владелец Из ОбъектМД.Метаданные().Владельцы Цикл
				КоличествоВладельцев = КоличествоВладельцев + 1;
			КонецЦикла;
			СтрокаДерева.КоличествоВладельцев = КоличествоВладельцев;
			СтрокаДерева.ОбъектМД = ОбъектМД;
			ДобавитьВеткуРеквизитовВДрево(ОбъектМД, СтрокаДерева, Реквизит);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Дерево;
КонецФункции

// Процедура осуществляет добавление ветки реквизитов в дерево
//
// Параметры:
//  Реквизиты - реквизиты
//  Дерево - дерево
//  объект - объект
//
Процедура ДобавитьВеткуРеквизитовВДрево(Реквизиты, Дерево, объект = неопределено) Экспорт
	
	Если Реквизиты.МетаДанные().Иерархический Тогда
		Массив = Новый массив;
		Массив.Добавить(ТипЗнч(Реквизиты));
		ТипЗнч = Новый ОписаниеТипов(Массив);
		
		СтрокаДерева = Дерево.Строки.Добавить();
		СтрокаДерева.Реквизит = "Родитель";
		СтрокаДерева.Синоним = "Родитель";
		СтрокаДерева.UIN = Новый УникальныйИдентификатор;
		СтрокаДерева.ТипВыбираемогоЗнч = ТипЗнч;
		СтрокаДерева.ОбъектМД = Неопределено;
		СтрокаДерева.МассивТипов = Массив;
	КонецЕсли;
	
	Массив = Новый массив;
	Массив.Добавить(Тип("Строка"));
	ТипЗнч = Новый ОписаниеТипов(Массив, , Новый КвалификаторыСтроки(Реквизиты.метаданные().ДлинаНаименования));
	
	СтрокаДерева = Дерево.Строки.Добавить();
	СтрокаДерева.Реквизит = "Наименование";
	СтрокаДерева.Синоним = "Наименование";
	СтрокаДерева.UIN = Новый УникальныйИдентификатор;
	СтрокаДерева.ТипВыбираемогоЗнч = ТипЗнч;
	СтрокаДерева.ОбъектМД = Неопределено;
	СтрокаДерева.МассивТипов = Массив;
	
	Массив = Новый массив;
	Если ТипЗнч(Реквизиты.метаданные().ТипКода) = Тип("Строка") Тогда
		Массив = Новый массив;
		Массив.Добавить(Тип("Строка"));
		ТипЗнч = Новый ОписаниеТипов(Массив, , Новый КвалификаторыСтроки(Реквизиты.метаданные().ДлинаКода));
	Иначе
		Массив = Новый массив;
		Массив.Добавить(Тип("Число"));
		ТипЗнч = Новый ОписаниеТипов(Массив, , Новый КвалификаторыСтроки(Реквизиты.метаданные().ДлинаКода));
	КонецЕсли;
	
	СтрокаДерева = Дерево.Строки.Добавить();
	СтрокаДерева.Реквизит = "Код";
	СтрокаДерева.Синоним = "Код";
	СтрокаДерева.UIN = Новый УникальныйИдентификатор;
	СтрокаДерева.ТипВыбираемогоЗнч = ТипЗнч;
	СтрокаДерева.ОбъектМД = Неопределено;
	СтрокаДерева.МассивТипов = Массив;
	
	Если Реквизиты.метаданные().Владельцы.Количество() > 0 Тогда
		Массив = Новый массив;
		Массив.Добавить(Тип("Строка"));
		ТипЗнч = Новый ОписаниеТипов(Массив);
		
		СтрокаДерева = Дерево.Строки.Добавить();
		СтрокаДерева.Реквизит = "Владелец";
		СтрокаДерева.Синоним = "Владелец";
		СтрокаДерева.UIN = Новый УникальныйИдентификатор;
		СтрокаДерева.ТипВыбираемогоЗнч = ТипЗнч;
		СтрокаДерева.ОбъектМД = Неопределено;
		СтрокаДерева.МассивТипов = Массив;
	КонецЕсли;

	Для Каждого СубРеквизит Из Реквизиты.метаданные().Реквизиты Цикл
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();
		#КонецЕсли
		СтрокаДерева = Дерево.Строки.Добавить();
		СтрокаДерева.Реквизит = СубРеквизит.Имя;
		СтрокаДерева.Синоним = СубРеквизит.Синоним;
		СтрокаДерева.UIN = Новый УникальныйИдентификатор;
		СтрокаДерева.ТипВыбираемогоЗнч = ТипЗнч(Реквизиты[СубРеквизит.Имя]);
		СтрокаДерева.ОбъектМД = Неопределено;
		
		МассивТипов = Новый Массив;
		Для Каждого тип Из Реквизиты.метаданные().Реквизиты[Субреквизит.Имя].Тип.Типы() Цикл
			Если МассивССТипов.Найти(тип) <> Неопределено Тогда
				МассивТипов.Добавить(тип);
			КонецЕсли;
		КонецЦикла;
		
		СтрокаДерева.МассивТипов = Реквизиты.метаданные().Реквизиты[Субреквизит.Имя].Тип.Типы();
		Если ОбъектОбразуетСсылочныйТип(СубРеквизит) Тогда
			Попытка
				СтрокаДерева.ОбъектМД = Новый (ТипЗнч(Реквизиты[СубРеквизит.Имя]));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция проверяет образует ли объект ссылочный тип
//
// Параметры:
//  ОбъектМД - объект метаданных для проверки
//
// Возвращаемое значение - булево
//
Функция ОбъектОбразуетСсылочныйТип(ОбъектМД) Экспорт
	Если ОбъектМД = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого тип Из ОбъектМД.Тип.Типы() Цикл
		Если МассивССТипов.Найти(тип) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
КонецФункции

Функция ПолучитьМассивСсыылочныхТипов()
	Массив = Новый Массив;
	Для Каждого МетаданныеОбъектов Из Метаданные.Справочники Цикл
		Массив.Добавить(Тип("СправочникСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	
	Возврат Массив;
КонецФункции

Функция ПолучитьОписаниеТиповДляВыбора()
	Массив = Новый Массив;
	Для Каждого МетаданныеОбъектов Из Метаданные.Справочники Цикл
		Массив.Добавить(Тип("СправочникСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.ДОкументы Цикл
		Массив.Добавить(Тип("ДокументСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.ПланыВидовХарактеристик Цикл
		Массив.Добавить(Тип("ПланВидовХарактеристикСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.ПланыСчетов Цикл
		Массив.Добавить(Тип("ПланСчетовСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.ПланыВидовРасчета Цикл
		Массив.Добавить(Тип("ПланВидовРасчетаСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.ПланыОбмена Цикл
		Массив.Добавить(Тип("ПланОбменаСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.БизнесПроцессы Цикл
		Массив.Добавить(Тип("БизнесПроцессСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.Задачи Цикл
		Массив.Добавить(Тип("ЗадачаСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла; 
	Для Каждого МетаданныеОбъектов Из Метаданные.Перечисления Цикл
		Массив.Добавить(Тип("ПеречислениеСсылка."+МетаданныеОбъектов.Имя));
	КонецЦикла;
	Массив.Добавить(Тип("Строка"));
	Массив.Добавить(Тип("Дата"));
	Массив.Добавить(Тип("Булево"));
	КС = Новый КвалификаторыСтроки(500);
	КЧ = Новый КвалификаторыЧисла(15,2, ДопустимыйЗнак.Любой);
	Возврат Новый ОписаниеТипов(Массив, КЧ, КС);
КонецФункции

