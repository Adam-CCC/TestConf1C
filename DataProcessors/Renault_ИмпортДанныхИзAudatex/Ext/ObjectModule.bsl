Функция РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВетки, ПутьКВетке = "", СтруктураКолонок = Неопределено)
	
	ТаблицаВозврата = Новый ТаблицаЗначений;
	Если НЕ СтруктураКолонок = Неопределено Тогда
		Для Каждого Элемент Из СтруктураКолонок Цикл
			ТаблицаВозврата.Колонки.Добавить(Элемент.Ключ, , Элемент.Значение, 25);
		КонецЦикла;
	КонецЕсли;
	
	ВыражениеXPath = ДОМ.СоздатьВыражениеXPath(КореньВетки + ПутьКВетке, Новый РазыменовательПространствИменDOM(ДОМ));
	РезультатXPath = ВыражениеXPath.Вычислить(ДОМ);
	ЭлементDOM = РезультатXPath.ПолучитьСледующий();
	
	РодительскийУзел = Неопределено;
	СтрокаТаблицы = Неопределено;
	
	Пока ЭлементDOM <> Неопределено Цикл
		ИмяКолонки = ЭлементDOM.ИмяУзла;
		Если ТаблицаВозврата.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ТаблицаВозврата.Колонки.Добавить(ИмяКолонки, , ,50);
		КонецЕсли;
		Если ЭлементDOM.РодительскийУзел = РодительскийУзел Тогда
			
			СтрокаТаблицы[ИмяКолонки] = ЭлементDOM.ТекстовоеСодержимое;
		Иначе
			
			РодительскийУзел = ЭлементDOM.РодительскийУзел;
			СтрокаТаблицы = ТаблицаВозврата.Добавить();
			СтрокаТаблицы[ИмяКолонки] = ЭлементDOM.ТекстовоеСодержимое;
		КонецЕсли;
		ЭлементDOM = РезультатXPath.ПолучитьСледующий();
	КонецЦикла;
	
	Возврат ТаблицаВозврата;
	
КонецФункции

//---------------------------------------------------------

Функция ВернутьЗначениеРеквизитаИзСтрокиДерева(ПараметрыКалькуляции, СтрокаДерева, ТекЭлемент, ТекОбъект = Неопределено)
	
	Шапка = ПараметрыКалькуляции.Шапка;
	Детали = ПараметрыКалькуляции.Детали;
	Работы = ПараметрыКалькуляции.Работы;
	
	Тип = СтрокаДерева["Тип"];
	ВхЗначение = СтрокаДерева["Значение"];
	ИмяРеквизита = СтрокаДерева["Реквизит"];
	
	Если НЕ ЗначениеЗаполнено(ВхЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Тип = "Параметр Сеанса" Тогда
		Значение = ПараметрыСеанса[ВхЗначение];
	ИначеЕсли Тип = "Поле Калькуляции" Тогда
		Попытка
			Значение = Вычислить(ВхЗначение);
		Исключение
			ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + ВхЗначение;
		КонецПопытки;
	ИначеЕсли Тип = "Фиксированое Значение" Тогда
		Значение =ВхЗначение;
	ИначеЕсли Тип = "Вычисляемое значение" Тогда
		Попытка
			Значение = Вычислить(ВхЗначение);
		Исключение
			ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + ВхЗначение;
		КонецПопытки;
	КонецЕсли;
	
	ТипРеквизита = ВернутьОписаниеТиповРеквизита(ТекЭлемент[ИмяРеквизита]);
	
	Возврат ТипРеквизита.ПривестиЗначение(Значение);
	
КонецФункции

