// Функция производит поиск или создание указанного контрагента.
// Функция вызывается из схемы импорта.
//
Функция НайтиСоздатьКонтрагента(Знач ПараметрыДела) Экспорт
	
	Результат	= Справочники.Контрагенты.ПустаяСсылка();
	
	Если ПараметрыДела.Свойство("VehicleOwnerLastName") И
		ПараметрыДела.Свойство("VehicleOwnerFirstName") Тогда
		ФамилияКонтрагента	= ?(ЗначениеЗаполнено(ПараметрыДела.VehicleOwnerLastName),ПараметрыДела.VehicleOwnerLastName,"");
		ИмяКонтрагента		= ?(ЗначениеЗаполнено(ПараметрыДела.VehicleOwnerFirstName), ПараметрыДела.VehicleOwnerFirstName, "");
		
		НаименованиеКонтрагента	= СокрЛП(ФамилияКонтрагента+" "+ИмяКонтрагента);
		Если ПустаяСтрока(НаименованиеКонтрагента) Тогда
			Возврат Результат;
		КонецЕсли;
		
		Результат	= Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеКонтрагента, Истина);		
	КонецЕсли;	
	
	Возврат Результат;	
КонецФункции

#Если Клиент Тогда

// Функция предназначена для формирования документа на основании
// данных расчета.
//
// Параметры:
//  СтрокаВозврата - строка возврата
//  ПараметрыДела - параметры дела
//  СтруктураДокумента - структура документа
//  СуществующийДокумент - заполнение данными существующего документа
//  ДокументПриёмник - ссылка на формируемый документ
//  ЗатиратьШапку    - признак затирания шапки
//
// Возвращаемое значение - структура признаков документа
//
Функция СоздатьДокументПоРасчету(СтрокаВозврата, ПараметрыДела, СтруктураДокумента, СуществующийДокумент, ДокументПриёмник, ЗатиратьШапку) Экспорт
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ТипЧисло = Новый ОписаниеТипов(Массив, Новый КвалификаторыЧисла(15, 2));
	Массив.Очистить();
	Массив.Добавить(Тип("Строка"));
	ТипСтрока = Новый ОписаниеТипов(Массив, Новый КвалификаторыСтроки(100));
	Массив.Очистить();
	Массив.Добавить(Тип("Дата"));
	ТипДата = Новый ОписаниеТипов(Массив);
	Массив.Очистить();
	
	Вернём = Новый Структура("ВсёОк, Ошибка, UIN, ДатаРасч, CaseID, TaskID, ВидДок", Ложь, "");
	ДОМ = ВернутьДОМ(СтрокаВозврата);
	Если ДОМ = Неопределено Тогда
		Вернём.Ошибка = "Ошибка прочтения файла импорта...";
		Возврат Вернём;
	КонецЕсли;
	
	КореньВеткиСДатой = "//*[contains(text(), '"+ПараметрыДела.ДатаРасч+"')]/parent::*/parent::*/descendant-or-self::*";
	
	ПутьВеткиПараметров = "/ПарамРасч/*";
	
	ПутьВеткиДеталей = "/Детали/Деталь/*";
	
	ПутьВеткиРабот = "/Работы/Работа/*";
	ПутьВеткиРемонта = "/Работы/Ремонт/*";
	ПутьВеткиДопРабот = "/Работы/ДопРабота/*";
	
	ПутьВеткиПараметровОкрасРабот = "/Окраска/ПарамОкрасРабот/*";
	ПутьВеткиПодготовитОкрасРабот = "/Окраска/ПодготОкрасРаботы/ПодготОкрасРабота/*";
	ПутьВеткиОкрасРабот = "/Окраска/ОкрасРаботы/ОкрасРабота/*";
	
	ПутьВеткиСтоимМат = "/Окраска/СтоимМат";
	
	ПутьВеткиДопКомпонент = "/ДопКомпоненты/*";
	
	Попытка
		
		//////////////////////////////////////////////////////////
		// ПолучениеДанных
		
		// детали
		
		СтруктураТитпов = Новый Структура;
		СтруктураТитпов.Вставить("ТипРемонта", ТипСтрока);
		СтруктураТитпов.Вставить("КодДетали", ТипСтрока);
		СтруктураТитпов.Вставить("НаименованиеДетали", ТипСтрока);
		СтруктураТитпов.Вставить("НомерДетали", ТипСтрока);
		СтруктураТитпов.Вставить("СтоимостьДетали", ТипЧисло);
		
		ТаблицаДеталей = Новый ТаблицаЗначений;
		Для Каждого Элемент Из СтруктураТитпов Цикл
			ТаблицаДеталей.Колонки.Добавить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
		ВремСтруктура = Новый Структура;
		ВремСтруктура.Вставить("ТипРемонта", "ТипРемонта");
		ВремСтруктура.Вставить("КодДетали", "КодДетали");
		ВремСтруктура.Вставить("НаименованиеДетали", "НаимДетали");
		ВремСтруктура.Вставить("НомерДетали", "НомДетали");
		ВремСтруктура.Вставить("СтоимостьДетали", "СтоимДетали");
		ЗаполнитьТаблицу1изТаблицы2ЧерезСтруктуру(ТаблицаДеталей, РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиДеталей), ВремСтруктура);
		
		// работы
		СтруктураТитпов = Новый Структура;
		СтруктураТитпов.Вставить("НомерРаботы", ТипСтрока);
		СтруктураТитпов.Вставить("НаименованиеРаботы", ТипСтрока);
		СтруктураТитпов.Вставить("НаименованиеДетали", ТипСтрока);
		СтруктураТитпов.Вставить("КоличествоРП", ТипЧисло);
		СтруктураТитпов.Вставить("СтоимостьРабот", ТипЧисло);
		
		ТаблицаРабот = Новый ТаблицаЗначений;
		Для Каждого Элемент Из СтруктураТитпов Цикл
			ТаблицаРабот.Колонки.Добавить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
		// работы
		ВремСтруктура = Новый Структура;
		ВремСтруктура.Вставить("НомерРаботы", "НомРаб");
		ВремСтруктура.Вставить("НаименованиеРаботы", "НаимРаб");
		ВремСтруктура.Вставить("КоличествоРП", "КолвоРП");
		ВремСтруктура.Вставить("СтоимостьРабот", "СтоимРаб");
		ЗаполнитьТаблицу1изТаблицы2ЧерезСтруктуру(ТаблицаРабот, РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиРабот), ВремСтруктура);
		
		// ремонт
		ВремСтруктура = Новый Структура;
		ВремСтруктура.Вставить("НомерРаботы", "НомРаб");
		//ВремСтруктура.Вставить("НаименованиеРаботы", "НаимРемонта");
		ВремСтруктура.Вставить("НаименованиеРаботы", "СтрокаВрТбл.НаимРемонта + ?(ПустаяСтрока(СтрокаВрТбл.НаимДетали), """", "" "" + СтрокаВрТбл.НаимДетали)");
		ВремСтруктура.Вставить("НаименованиеДетали", "НаимДетали");
		ВремСтруктура.Вставить("КоличествоРП", "КолвоРП");
		ВремСтруктура.Вставить("СтоимостьРабот", "СтоимРаб");
		ЗаполнитьТаблицу1изТаблицы2ЧерезСтруктуру(ТаблицаРабот, РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиРемонта), ВремСтруктура);
		
		// доп работы
		ВремСтруктура = Новый Структура;
		ВремСтруктура.Вставить("НомерРаботы", "НомРаб");
//		ВремСтруктура.Вставить("НаименованиеРаботы", "НаимРаб");
		ВремСтруктура.Вставить("НаименованиеРаботы", "СтрокаВрТбл.НаимРаб + ?(ПустаяСтрока(СтрокаВрТбл.НаимДетали), """", "" "" + СтрокаВрТбл.НаимДетали)");
		ВремСтруктура.Вставить("КоличествоРП", "КолвоРП");
		ВремСтруктура.Вставить("СтоимостьРабот", "СтоимРаб");
		ЗаполнитьТаблицу1изТаблицы2ЧерезСтруктуру(ТаблицаРабот, РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиДопРабот), ВремСтруктура);
		
		// подготовит окрас работы
		ВремСтруктура = Новый Структура;
		ВремСтруктура.Вставить("НомерРаботы", "НомРаб");
		ВремСтруктура.Вставить("НаименованиеРаботы", "НаимРаб");
		ВремСтруктура.Вставить("КоличествоРП", "КолвоРП");
		ВремСтруктура.Вставить("СтоимостьРабот", "СтоимРаб");
		ЗаполнитьТаблицу1изТаблицы2ЧерезСтруктуру(ТаблицаРабот, РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиПодготовитОкрасРабот), ВремСтруктура);

		// окрас работы
		ВремСтруктура = Новый Структура;
		ВремСтруктура.Вставить("НомерРаботы", "НомРаб");
		ВремСтруктура.Вставить("НаименованиеРаботы", "СтрокаВрТбл.НаимРаб + ?(ПустаяСтрока(СтрокаВрТбл.НаимДетали), """", "" "" + СтрокаВрТбл.НаимДетали)");
		ВремСтруктура.Вставить("НаименованиеДетали", "НаимДетали");
		ВремСтруктура.Вставить("КоличествоРП", "КолвоРП");
		ВремСтруктура.Вставить("СтоимостьРабот", "СтоимРаб");
		ЗаполнитьТаблицу1изТаблицы2ЧерезСтруктуру(ТаблицаРабот, РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиОкрасРабот), ВремСтруктура);
		
		// доп компоненты
		ВремСтруктура = Новый Структура;
		ВремСтруктура.Вставить("НомерРаботы", "КодПозиции");
		ВремСтруктура.Вставить("НаименованиеРаботы", "Описание");
		ВремСтруктура.Вставить("КоличествоРП", "КолвоРП");
		ВремСтруктура.Вставить("СтоимостьРабот", "Стоим");
		ЗаполнитьТаблицу1изТаблицы2ЧерезСтруктуру(ТаблицаРабот, РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиДопКомпонент), ВремСтруктура);

		// парм окрас работ
		ТаблицаПараметровОкрасРабот = РазобратьВеткуВСтрокиТаблицы(ДОМ, КореньВеткиСДатой, ПутьВеткиПараметровОкрасРабот);
		
		// Общая стоимость окрасочных материалов.
		ВыражениеXPath = ДОМ.СоздатьВыражениеXPath(КореньВеткиСДатой + ПутьВеткиСтоимМат, Новый РазыменовательПространствИменDOM(ДОМ));
		РезультатXPath = ВыражениеXPath.Вычислить(ДОМ);
		ЭлементDOM = РезультатXPath.ПолучитьСледующий();
		
		СтоимМат = 0;
		Если ЭлементDOM <> Неопределено Тогда
			Попытка
				СтоимМат = Число(ЭлементDOM.ТекстовоеСодержимое);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		ДОМ = Неопределено;
		ВременнаяТаблица = Неопределено;
		
		Для Каждого СтрокаРабот Из ТаблицаРабот Цикл
			Если СтрокаРабот.НаименованиеДетали = Неопределено Тогда
				СтрокаРабот.НаименованиеДетали = "";
			КонецЕсли;
			Если СтрокаРабот.НомерРаботы = Неопределено Тогда
				СтрокаРабот.НомерРаботы = "";
			КонецЕсли;
		КонецЦикла;
		
		ПКШапка = Новый Структура;
		ПКШапка.Вставить("НомерДела",		 ВернутьВозможноеЗначение(ПараметрыДела, "ClaimNumber"));
		ПКШапка.Вставить("МодельАвтомобиля", ВернутьВозможноеЗначение(ПараметрыДела, "МодельАвтомобиля"));
		ПКШапка.Вставить("VIN",				 ВернутьВозможноеЗначение(ПараметрыДела, "VIN"));
		ПКШапка.Вставить("ДатаРасчета",		 ВернутьВозможноеЗначение(ПараметрыДела, "ДатаРасчета"));
		ПКШапка.Вставить("НаценкаНаДетали",	 ВернутьВозможноеЗначение(ПараметрыДела, "НацНаДетали"));
		ПКШапка.Вставить("ВалютаРасчета",	 ВернутьВозможноеЗначение(ПараметрыДела, "ВалютаРасч"));
		ПКШапка.Вставить("ВалютаИсходная",	 ВернутьВозможноеЗначение(ПараметрыДела, "ВалютаИсх"));
		
		Знч = ВернутьВозможноеЗначение(ПараметрыДела, "ДатаЦен");
		Неопр = Знч = "" ИЛИ Знч = Неопределено;
		ПКШапка.Вставить("ДатаЦен",			 ?(Неопр, '000101010000', Дата(СтрЗаменить(Знч, "-", ""))));
		
		Знч = ВернутьВозможноеЗначение(ПараметрыДела, "РПвЧас");
		Неопр = Знч = "" ИЛИ Знч = Неопределено;
		ПКШапка.Вставить("РПвЧас",			 ?(Неопр, 0, Число(Знч)));
		
		Знч = ВернутьВозможноеЗначение(ПараметрыДела, "Курс");
		Неопр = Знч = "" ИЛИ Знч = Неопределено;
		ПКШапка.Вставить("Курс",			 ?(Неопр, 0, Число(Знч)));
		
		Знч = ВернутьВозможноеЗначение(ПараметрыДела, "НЧРабот");
		Неопр = Знч = "" ИЛИ Знч = Неопределено;
		ПКШапка.Вставить("НЧРабот",			 ?(Неопр, 0, Число(Знч)));
		
		Знч = ВернутьВозможноеЗначение(ПараметрыДела, "НЧОкрас");
		Неопр = Знч = "" ИЛИ Знч = Неопределено;
		ПКШапка.Вставить("НЧОкрас",			 ?(Неопр, 0, Число(Знч)));
		
		ПКДетали = Новый Структура("ТипРемонта, КодДетали, НаименованиеДетали, НомерДетали, СтоимостьДетали, ЦенаРубли, ЦенаЕвро");
		ПКРаботы = Новый Структура("НомерРаботы, НаименованиеРаботы, НаименованиеДетали, КоличествоРП, СтоимостьРабот, ЦенаРубли, ЦенаЕвро");
		ПараметрыКалькуляции = Новый Структура("Шапка, ПКДетали, ПКРаботы, Документ, Детали, Работы, ТаблицаСинхронизации", ПКШапка, ПКДетали, ПКРаботы, СтруктураДокумента.Документ, СтруктураДокумента.Детали, СтруктураДокумента.Работы, СтруктураДокумента.ТаблицаСинхронизации);
		
		Если НЕ ПустаяСтрока(ПараметрыДела.НацНаДетали) Тогда
			НацНаДетали = Число(ПараметрыДела.НацНаДетали);
			Если НацНаДетали > 0 Тогда
				ИтогНаценки = 0;
				Для Каждого строчка Из ТаблицаДеталей Цикл
					ИтогНаценки = ИтогНаценки + Число(строчка.СтоимостьДетали);
				КонецЦикла;
				НаценкаНаМелкиеДетали							= ТаблицаДеталей.Добавить();
				НаценкаНаМелкиеДетали["НаименованиеДетали"]		= "Наценка на мелкие детали";
				НаценкаНаМелкиеДетали["СтоимостьДетали"]		= Окр(ИтогНаценки*НацНаДетали/100,0);
			КонецЕсли;
		КонецЕсли;
		
		Если СтоимМат > 0 Тогда
			//НаценкаНаМелкиеДетали = ТаблицаРабот.Добавить();
			//НаценкаНаМелкиеДетали["НомерРаботы"] = "KN";
			//НаценкаНаМелкиеДетали["НаименованиеРаботы"] = "Общая стоимость окрасочных материалов";
			//НаценкаНаМелкиеДетали["КоличествоРП"] = 0;
			//НаценкаНаМелкиеДетали["СтоимостьРабот"] = СтоимМат;
			
			НаценкаНаМелкиеДетали = ТаблицаДеталей.Добавить();
			НаценкаНаМелкиеДетали["ТипРемонта"] = "E";
			НаценкаНаМелкиеДетали["КодДетали"] = "KN";
			НаценкаНаМелкиеДетали["НаименованиеДетали"] = "Общая стоимость окрасочных материалов";
			НаценкаНаМелкиеДетали["НомерДетали"] = "KN";
			НаценкаНаМелкиеДетали["СтоимостьДетали"] = СтоимМат;
		КонецЕсли;
		
		ЕстьДетали = ТаблицаДеталей.Количество() > 0;
		ЕстьРаботы = ТаблицаРабот.Количество() > 0;
		ЕстьОкраска = ТаблицаПараметровОкрасРабот.Количество() > 0;
		ПараметрыОкрасРабот = ?(ЕстьОкраска, ТаблицаПараметровОкрасРабот[0], 0);
		
		// Заполнение параметров деталей и работ в таблицах
		Если ЕстьДетали Тогда
			ТаблицаДеталей.Колонки.Добавить("ВалРасч", ТипСтрока);
			ТаблицаДеталей.ЗаполнитьЗначения(ПараметрыДела["ВалРасч"], "ВалРасч");
			ТаблицаДеталей.Колонки.Добавить("Курс", ТипЧисло);
			ТаблицаДеталей.ЗаполнитьЗначения(ПараметрыДела["Курс"], "Курс");
		КонецЕсли;
		
		Если ЕстьРаботы Тогда
			ТаблицаРабот.Колонки.Добавить("РПвЧас", ТипЧисло);
			ТаблицаРабот.ЗаполнитьЗначения(ПараметрыДела["РПвЧас"], "РПвЧас");
			ТаблицаРабот.Колонки.Добавить("НЧРабот", ТипЧисло);			
			ТекЗнч			= ВернутьВозможноеЗначение(ПараметрыДела, "НЧРабот");
			Неопр			= ТекЗнч = "" ИЛИ ТекЗнч = Неопределено;
			НормочасыРабот	= ?(Неопр, 0, Число(Знч));			
			ТаблицаРабот.ЗаполнитьЗначения(НормочасыРабот, "НЧРабот");
		КонецЕсли;
			
		Для Каждого СтрокаВхТаблицы Из ТаблицаДеталей Цикл
			ЗаполнитьСтоимость(ПараметрыДела, Число(СтрокаВхТаблицы["СтоимостьДетали"]), ТаблицаДеталей, СтрокаВхТаблицы);
		КонецЦикла;
			
		Для Каждого СтрокаВхТаблицы Из ТаблицаРабот Цикл			
			ЗаполнитьСтоимость(ПараметрыДела, Число(СтрокаВхТаблицы["СтоимостьРабот"]), ТаблицаРабот, СтрокаВхТаблицы);
		КонецЦикла;
		
		УИН = Строка(Новый УникальныйИдентификатор);
		СЧ = "";
		Для х=1 По 36 Цикл
			Симв = Сред(УИН, х, 1);
			Попытка
				СЧ = СЧ + Строка(Число(Симв));
			Исключение
			КонецПопытки;
		КонецЦикла;
		ГСЧ = Новый ГенераторСлучайныхЧисел(Число(СЧ));
		МассивЗарезНомеров = Новый Массив;
		МассивЗарезНомеров.Добавить("KN");
		МассивЗарезНомеров.Добавить("NO NUMBER");
		Для Каждого СтрокаВхТаблицы Из ТаблицаДеталей Цикл
			Если МассивЗарезНомеров.Найти(СтрокаВхТаблицы.НомерДетали) <> Неопределено Тогда
				СтрокаВхТаблицы.НомерДетали = "";
			КонецЕсли;
			Если СтрокаВхТаблицы.НомерДетали = "" Тогда
				
				ИмяВЛоге = СтрокаВхТаблицы.НаименованиеДетали + ВернутьВозможноеЗначение(ПараметрыДела, "МодельАвтомобиля");
			
				ИмяФайла = КаталогИмпорта + "/GoodsTune.tbl";
				ФайлЗначения = Новый Файл(ИмяФайла);
				Лог = ЗначениеИзФайла(ИмяФайла);
				ЗаписьВЛоге = Лог.Найти(ИмяВЛоге, "Имя");
				Если ЗаписьВЛоге = Неопределено Тогда
					НовУИН = Формат(ГСЧ.СлучайноеЧисло(0, 999999999), "ЧЦ=9;ЧГ=9;ЧВН=1");
					СтрокаВхТаблицы.НомерДетали = НовУИН;
					СтрокаЛога = Лог.ДОбавить();
					СтрокаЛога.UIN = НовУИН;
					СтрокаЛога.Имя = ИмяВЛоге;
					ЗначениеВФайл(ИмяФайла, Лог);
				Иначе
					СтрокаВхТаблицы.НомерДетали = ЗаписьВЛоге.UIN;
				КонецЕсли;
			
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаВхТаблицы Из ТаблицаРабот Цикл
			Если МассивЗарезНомеров.Найти(СтрокаВхТаблицы.НомерРаботы) <> Неопределено Тогда
				СтрокаВхТаблицы.НомерРаботы = "";
			КонецЕсли;
			Если СтрокаВхТаблицы.НомерРаботы = "" Тогда
				
				ИмяВЛоге = СтрокаВхТаблицы.НаименованиеРаботы + ВернутьВозможноеЗначение(ПараметрыДела, "МодельАвтомобиля");
			
				ИмяФайла = КаталогИмпорта + "/GoodsTune.tbl";
				ФайлЗначения = Новый Файл(ИмяФайла);
				Лог = ЗначениеИзФайла(ИмяФайла);
				ЗаписьВЛоге = Лог.Найти(ИмяВЛоге, "Имя");
				Если ЗаписьВЛоге = Неопределено Тогда
					НовУИН = Формат(ГСЧ.СлучайноеЧисло(0, 999999999), "ЧЦ=9;ЧГ=9;ЧВН=1");
					СтрокаВхТаблицы.НОмерРаботы = НовУИН;
					СтрокаЛога = Лог.ДОбавить();
					СтрокаЛога.UIN = НовУИН;
					СтрокаЛога.Имя = ИмяВЛоге;
					ЗначениеВФайл(ИмяФайла, Лог);
				Иначе
					СтрокаВхТаблицы.НомерРаботы = ЗаписьВЛоге.UIN;
				КонецЕсли;
			
			КонецЕсли;
		КонецЦикла;
		
		Если Тестирование Тогда
			СтруктураТаблицДляВывода = Новый Структура;
			СтруктураТаблицДляВывода.Вставить("ТаблицаДеталей", ТаблицаДеталей);
			СтруктураТаблицДляВывода.Вставить("ТаблицаРабот", ТаблицаРабот);
			ПоказатьТаблицы(СтруктураТаблицДляВывода);
		КонецЕсли;
		
		//////////////////////////////////////////////////////////
		// СОЗДАНИЕ ДОКУМЕНТА.
		Если СуществующийДокумент = Неопределено Тогда
			Если ДокументПриёмник=Неопределено ИЛИ ДокументПриёмник.Пустая() ИЛИ
				Найти(Строка(ДокументПриёмник), "Объект не найден")>0 Тогда
				
				Док		= Документы[СтруктураДокумента.Документ].СоздатьДокумент();
				Для Каждого Реквизит Из СтруктураДокумента.ДеревоДокумента.Строки Цикл
					Док[Реквизит.Реквизит] = ВернутьРеквизит(Док, Реквизит, ПараметрыКалькуляции,,ПараметрыДела);
				КонецЦикла;
			Иначе
				Если ДокументОбъект<>Неопределено И
					ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
					Док	= ДокументОбъект;
				Иначе
					Док	= ДокументПриёмник.ПолучитьОбъект();
				КонецЕсли;
				
				Если ЗатиратьШапку Тогда
					Для Каждого Реквизит Из СтруктураДокумента.ДеревоДокумента.Строки Цикл
						Док[Реквизит.Реквизит] = ВернутьРеквизит(Док, Реквизит, ПараметрыКалькуляции,,ПараметрыДела);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			Тч		= Док[СтруктураДокумента.Детали];
			Тч.Очистить();
			Тч		= Док[СтруктураДокумента.Работы];
			Тч.Очистить();
		Иначе
			Если ДокументОбъект<>Неопределено И
				ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
				Док	= ДокументОбъект;
			Иначе
				Док	= СуществующийДокумент.ПолучитьОбъект();
			КонецЕсли;			
			
			Если ЗатиратьШапку Тогда
				Для Каждого Реквизит Из СтруктураДокумента.ДеревоДокумента.Строки Цикл
					Док[Реквизит.Реквизит] = ВернутьРеквизит(Док, Реквизит, ПараметрыКалькуляции,,ПараметрыДела);
				КонецЦикла;
			КонецЕсли;			
			
			Тч		= Док[СтруктураДокумента.Детали];
			Тч.Очистить();
			Тч		= Док[СтруктураДокумента.Работы];
			Тч.Очистить();
		КонецЕсли;
		
		///////////////////////////////////////////////////////////
		// ЗАПОЛНЕНИЕ ТАБЛИЧНЫХ ЧАСТЕЙ.
		
		Если ДокументОбъект=Неопределено ИЛИ
			Найти(Строка(ДокументОбъект), "Объект не найден")>0 ИЛИ
			(НЕ ЗначениеЗаполнено(ДокументОбъект.Ссылка)) Тогда
			ФормаДока	= Док.ПолучитьФорму();
		КонецЕсли;
	
		ИсполняемыйКод	= СтруктураДокумента.ВКПЗРС_Детали;
		Если ЕстьДетали Тогда
			Попытка
				Тч = Док[СтруктураДокумента.Детали];
			Исключение
				Вернём.Ошибка = ОписаниеОшибки();
				Сообщение("Не удалось обратиться к табличной части """+СтруктураДокумента.Детали+""". Проверьте схему импорта.", 1);
				Возврат Вернём;
			КонецПопытки;
			Для Каждого СтрокаВхТаблицы Из ТаблицаДеталей Цикл
				СтрокаТЧ = Тч.Добавить();
				Для Каждого Реквизит Из СтруктураДокумента.ДеревоДеталей.Строки Цикл
					СтрокаТЧ[Реквизит.Реквизит] = ВернутьРеквизит(СтрокаТЧ, Реквизит, ПараметрыКалькуляции, СтрокаВхТаблицы);
				КонецЦикла;
				Если НЕ Пустаястрока(ИсполняемыйКод) Тогда
					Попытка
						Выполнить(ИсполняемыйКод);
					Исключение
						Сообщение("Неверно указана строка с кодом, исполняемым после заполнения табличной части 'Детали'", 1);
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			Попытка
				Тч.Свернуть("Номенклатура,ЕдиницаИзмерения,Коэффициент,СтавкаНДС,ХарактеристикаНоменклатуры,СкладКомпании","Количество,Цена,Сумма,СуммаНДС,ПроцентСкидки,СуммаСкидки,СуммаВсего,СуммаСкидкиСтроки");
			Исключение КонецПопытки;
			Для Каждого ТекСтрока Из Тч Цикл                                     
				Попытка
					Док.ОбработкаРеквизита("Товары.СуммаВсего",	ТекСтрока,	ФормаДока);
				Исключение КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		ИсполняемыйКод = СтруктураДокумента.ВКПЗРС_Работы;
		Если ЕстьРаботы Тогда
			Попытка
				Тч = Док[СтруктураДокумента.Работы];
			Исключение
				Вернём.Ошибка = ОписаниеОшибки();
				Сообщение("Не удалось обратиться к табличной части """+СтруктураДокумента.Работы+""". Проверьте схему импорта.", 1);
				Возврат Вернём;
			КонецПопытки;
			Для Каждого СтрокаВхТаблицы Из ТаблицаРабот Цикл
				СтрокаТЧ = Тч.Добавить();
				Для Каждого Реквизит Из СтруктураДокумента.ДеревоРабот.Строки Цикл
					// Процент скидки назначается системой
					Если Реквизит.Реквизит="ПроцентСкидки" Тогда
						Продолжить;	
					КонецЕсли;
					
					СтрокаТЧ[Реквизит.Реквизит] = ВернутьРеквизит(СтрокаТЧ, Реквизит, ПараметрыКалькуляции, СтрокаВхТаблицы);
					
					Если Реквизит.Реквизит="Работа" Тогда
						Попытка
							Док.ОбработкаРеквизита("Работы.Работа",СтрокаТЧ,ФормаДока);
						Исключение КонецПопытки;
					КонецЕсли;					
				КонецЦикла;
								
				Если НЕ Пустаястрока(ИсполняемыйКод) Тогда
					Попытка
						Выполнить(ИсполняемыйКод);
					Исключение
						Сообщение("Неверно указана строка с кодом, исполняемым после заполнения табличной части 'Работы'", 1);
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			Попытка
				Тч.Свернуть("Работа,Нормочас,СтавкаНДС,ПроцентСкидки,ПроцентСкидкиСтроки","Количество,Коэффициент,Цена,Сумма,СуммаНДС,СуммаСкидки,СуммаВсего,СуммаСкидкиСтроки");
			Исключение КонецПопытки;
			Для Каждого ТекСтрока Из Тч Цикл
				ТекСтрока.ИдентификаторРаботы = Новый УникальныйИдентификатор;
				Док.ОбработкаРеквизита("Работы.СуммаВсего",	ТекСтрока,	ФормаДока);
			КонецЦикла;
		КонецЕсли;
		
		///////////////////////////////////////////////////////////
		// ВСЁ ПРОШЛО ХОРОШО, ЗАПИШЕМ И ВЫЙДЕМ.
		
		Если ТипЗнч(Док)=Тип("ДокументОбъект.ЗаказНаряд") И
			ЗначениеЗаполнено(Док.ЗаказЧик) И
			(НЕ ЗначениеЗаполнено(Док.ДоговорВзаиморасчетов)) Тогда
			
			Док.Контрагент				= Док.Заказчик;
			Док.ДоговорВзаиморасчетов	= Док.Заказчик.ОсновнойДоговорВзаиморасчетов;
		КонецЕсли;
		
		Док.ОбменДанными.Загрузка = Истина;
		Если НЕ ЗначениеЗаполнено(Док.Дата) Тогда
			Док.Дата = ТекущаяДата();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Док.Номер) Тогда
			Док.УстановитьНовыйНомер();
		КонецЕсли;
		
		Попытка
			Док.Записать();
		Исключение
			Сообщение(ОписаниеОшибки(),1);
		КонецПопытки;
	
		Док.ОбменДанными.Загрузка = Ложь;
		Если ДокументОбъект=Неопределено ИЛИ
			Найти(Строка(ДокументОбъект), "Объект не найден")>0 ИЛИ
			(НЕ ЗначениеЗаполнено(ДокументОбъект.Ссылка)) Тогда
			ФормаДока.Открыть();
		Иначе
			ФормаДока.Активизировать();
			ФормаДока.Обновить();
			
			Попытка
				дкВывестиЗаголовокСуммаДокумента(ФормаДока);	
			Исключение КонецПопытки;
		КонецЕсли;
		
		Вернём.ВсёОк = Истина;
		Вернём.UIN = Док.Ссылка.УникальныйИдентификатор ();
		Вернём.CaseID = ПараметрыДела.CaseID;
		Вернём.TaskID = ПараметрыДела.TaskID;
		Вернём.ВидДок = ВернутьИмяОбъектаМД(Док);
		Вернём.ДатаРасч = ПараметрыДела.ДатаРасч;
	Исключение
		Вернём.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Вернём;
	
КонецФункции

#КонецЕсли

///////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ ЗАПОЛНЕНИЯ СПРАВОЧНИКОВ И ДОКУМЕНТОВ

///////////////////////////////////////////////////////////
//ВернутьЭлементДляПодстановки. Функция монстр.
//
//   Описание: Возвращает составной элемент метаданных. 
//Нпример, справочник "номенклатура" с подчинёнными справочниками.
Функция ВернутьЭлементДляПодстановки(Объект, Реквизит, ПараметрыКалькуляции, СтрокаВхТаблицы)
	
	ВеткаРеквизита = Реквизит.Строки;
	
	Шапка			= ПараметрыКалькуляции.Шапка;
	Детали			= ПараметрыКалькуляции.Детали;
	Работы			= ПараметрыКалькуляции.Работы;
	
	ТаблицаСинхронизации	= ПараметрыКалькуляции.ТаблицаСинхронизации;
	СтрокаСинх				= ТаблицаСинхронизации.Найти(Реквизит.UIN, "UIN");
	Если СтрокаСинх <> Неопределено Тогда
		Попытка
			ЗнчСинх = ?(СтрокаСинх.Тип = "Фиксированое Значение", СтрокаСинх.Значение, Вычислить(СтрокаСинх.Значение));
		Исключение
			ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + СтрокаСинх.Значение;
		КонецПопытки;
		
		//Если Реквизит.Значение="Автоработы" И
		//	СтрокаСинх.Реквизит="Артикул" И			
		//	ТипЗнч(Работы)=Тип("Структура") И
		//	Работы.Свойство("НаименованиеРаботы") Тогда
		//	
		//	НайденоПоАртикулу		= НайтиСпр(Реквизит.Значение, СтрокаСинх.Реквизит, ЗнчСинх);
		//	НайденоПоНаименованию	= НайтиСпр(Реквизит.Значение, "Наименование", Работы.НаименованиеРаботы);
		//				
		//	// Когда не указан артикул автоработы, то её поиск следует проводить по наименованию
		//	Если (ВРег(СокрЛП(ЗнчСинх))="БН" ИЛИ ЗнчСинх="" ИЛИ ЗнчСинх=Неопределено) Тогда
		//		ЭлементДляПодстановки	= НайденоПоНаименованию;
		//	Иначе
		//		ЭлементДляПодстановки	= НайденоПоАртикулу;
		//	КонецЕсли;
		//	
		//ИначеЕсли Реквизит.Значение="Номенклатура" И
		//	СтрокаСинх.Реквизит="Артикул" И			
		//	ТипЗнч(Детали)=Тип("Структура") И
		//	Детали.Свойство("НаименованиеДетали")Тогда
		//	
		//	НайденоПоАртикулу		= НайтиСпр(Реквизит.Значение, СтрокаСинх.Реквизит, ЗнчСинх);			
		//	НайденоПоНаименованию	= НайтиСпр(Реквизит.Значение, "Наименование", Детали.НаименованиеДетали);
		//	
		//	Если (ВРег(СокрЛП(ЗнчСинх))="ЗАМЕНИТЬ" ИЛИ ЗнчСинх="" ИЛИ ЗнчСинх=Неопределено) Тогда
		//		ЭлементДляПодстановки	= НайденоПоНаименованию;
		//	Иначе
		//		ЭлементДляПодстановки	= НайденоПоАртикулу;
		//	КонецЕсли;
		//	
		//Иначе		
			ЭлементДляПодстановки = НайтиСпр(Реквизит.Значение, СтрокаСинх.Реквизит, ЗнчСинх);
		//КонецЕсли;
	
		Если ЭлементДляПодстановки.Пустая() Тогда
			
			ИмяСпр = Реквизит.Значение;
			ЭлементДляПодстановки = Справочники[ИмяСпр].СоздатьЭлемент();
			
		Иначе
			ЭлементДляПодстановки = ЭлементДляПодстановки.получитьОбъект();
			
		КонецЕсли;
	КонецЕсли;
	Попытка
		Если НЕ СтрокаСинх.Создавать Тогда
			Возврат ЭлементДляПодстановки;
		КонецЕсли;
	Исключение
		// Нет такого реквизита. Старая схема.
	КонецПопытки;
	// Запихаем строки с реквизитами в таблицу,
	// и отсортируем её по убыванию уровня вложенности.
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("Строка");
	ТаблицаРеквизитов.Колонки.Добавить("Значение");
	ТаблицаРеквизитов.Колонки.Добавить("Уровень");
	
	СтрокиРеквизиты = ВеткаРеквизита.НайтиСтроки(Новый Структура("Тип", "Найти / Создать Элемент Справочника"), Истина);
	Для Каждого СтрокаРеквизит Из СтрокиРеквизиты Цикл
		
		Владельцы = Метаданные.Справочники[СтрокаРеквизит.Значение].Владельцы;
		Если Владельцы.Количество() = 0 Тогда
			СтрокаТР = ТаблицаРеквизитов.Добавить();
			СтрокаТР.Строка = СтрокаРеквизит;
			СтрокаТР.Уровень = СтрокаРеквизит.Уровень();
		КонецЕсли;
	КонецЦикла;
	ТаблицаРеквизитов.Сортировать("Уровень убыв");
	
	Для Каждого СтрокаТР Из ТаблицаРеквизитов Цикл
		
		СтрокиДерева = СтрокаТР.Строка.Строки;
		ТекСтрокаРеквзита = СтрокаТР.Строка;

		СтрокаСинх = ТаблицаСинхронизации.Найти(ТекСтрокаРеквзита.UIN, "UIN");
		Если СтрокаСинх = Неопределено Тогда
			ЗнчСинх = Неопределено;
			ИмяРеквизита = "Неопределено";
		Иначе
			Попытка
				ЗнчСинх = ?(СтрокаСинх.Тип = "Фиксированое Значение", СтрокаСинх.Значение, Вычислить(СтрокаСинх.Значение));
			Исключение
				ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + СтрокаСинх.Значение;
			КонецПопытки;
			ИмяРеквизита = СтрокаСинх.Реквизит;
		КонецЕсли;
		СпрРеквизит = НайтиСпр(ТекСтрокаРеквзита.Значение, ИмяРеквизита, ЗнчСинх);
		
		Попытка
			Если НЕ СтрокаСинх.Создавать Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			// Нет такого реквизита. Старая схема.
		КонецПопытки;
		
		Если СпрРеквизит.Пустая() Тогда
			
			ИмяСпр		= ТекСтрокаРеквзита.Значение;
			СпрРеквизит	= Справочники[ИмяСпр].СоздатьЭлемент();
			Попытка
				СпрРеквизит.ОбработкаЗаполнения(Неопределено);
			Исключение КонецПопытки;
			
			Для Каждого СтрокаДерева Из СтрокиДерева Цикл
				Значение = ВернутьЗначениеРеквизитаИзСтрокиДерева(ПараметрыКалькуляции, СтрокаДерева, СпрРеквизит, ЭлементДляПодстановки);
				Если Значение <> Неопределено Тогда
					СпрРеквизит[СтрокаДерева["Реквизит"]] = Значение;
				КонецЕсли;
			КонецЦикла;
			
			СпрРеквизит.УстановитьНовыйКод();
			СпрРеквизит.ОбменДанными.Загрузка = Истина;
			Попытка
				СпрРеквизит.Записать();
			Исключение
				Сообщение(ОписаниеОшибки(),1);
			КонецПопытки;
			
			// Создание Подчинённых справочников...
			ВеткиПодчСпр = СтрокиДерева.НайтиСтроки(Новый Структура("Тип", "Найти / Создать Элемент Справочника"));
			Для Каждого ВеткаПодчСпр Из ВеткиПодчСпр Цикл
				
				СтрокиПодчСпр = ВеткаПодчСпр.Строки;
				СтрокаСинх = ТаблицаСинхронизации.Найти(ВеткаПодчСпр.UIN, "UIN");
				Если СтрокаСинх = Неопределено Тогда
					ЗнчСинх = Неопределено;
					ИмяРеквизита = "Неопределено";
				Иначе
					Попытка
						ЗнчСинх = ?(СтрокаСинх.Тип = "Фиксированое Значение", СтрокаСинх.Значение, Вычислить(СтрокаСинх.Значение));
					Исключение
						ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + СтрокаСинх.Значение;
					КонецПопытки;
					
					ИмяРеквизита = СтрокаСинх.Реквизит;
				КонецЕсли;
				
				Попытка
					ПодчСпр = НайтиСпр(ВеткаПодчСпр.Значение, ИмяРеквизита, ЗнчСинх);
					Если НЕ СтрокаСинх.Создавать Тогда
						Продолжить;
					КонецЕсли;
				Исключение
					// Нет такого реквизита. Старая схема.
				КонецПопытки;
				
				Если ПодчСпр.Пустая() Тогда
					
					ИмяСпр		= ВеткаПодчСпр.Значение;
					ПодчСпр		= Справочники[ИмяСпр].СоздатьЭлемент();
					Попытка
						СпрРеквизит.ОбработкаЗаполнения(Неопределено);
					Исключение КонецПопытки;
			
					Для Каждого СтрокаПодчСпр Из СтрокиПодчСпр Цикл
						Значение = ВернутьЗначениеРеквизитаИзСтрокиДерева(ПараметрыКалькуляции, СтрокаПодчСпр, ПодчСпр, СпрРеквизит);
						Если Значение <> Неопределено Тогда
							ПодчСпр[СтрокаПодчСпр["Реквизит"]] = Значение;
						КонецЕсли;
					КонецЦикла;
					
					ПодчСпр.УстановитьНовыйКод();
					ПодчСпр.ОбменДанными.Загрузка	= Истина;
					ПодчСпр.Записать();
					ПодчСпр.ОбменДанными.Загрузка = Ложь;
				КонецЕсли;
				
				СпрРеквизит[ВеткаПодчСпр["Реквизит"]] = ПодчСпр.Ссылка;
				
			КонецЦикла;
			// Заполнение ссылок в СпрРеквизит...
			СпрРеквизит.ОбменДанными.Загрузка = Истина;
			СпрРеквизит.Записать();
			
		КонецЕсли;
		
		СтрокаТР.Значение = СпрРеквизит.Ссылка;
		
		///////////////////////////////////////////////////////
		// Получено значение. Его надо записать в дерево 
		// на место строки с параметрами поиска/создания, 
		// с тем, чтобы реквизит ветки с меньшим уровнем 
		// заполнился этим значением.
		
		// Получим строки этого уровня:
		СтрокиУровня = СтрокаТР.Строка.Родитель.Строки;
		
		// Дальше очевидно.
		UIN = ТекСтрокаРеквзита.UIN;
		Реквизит = ТекСтрокаРеквзита.Реквизит;
		СтрокиУровня.Удалить(ТекСтрокаРеквзита);
		НовыйРеквизит = СтрокиУровня.Добавить();
		НовыйРеквизит.UIN = UIN;
		НовыйРеквизит.Реквизит = Реквизит;
		НовыйРеквизит.Тип = "Фиксированое Значение";
		НовыйРеквизит.Значение = СпрРеквизит.Ссылка;
		
		// Удалилась вся ветка реквизита вместе с раскрытыми ветками подчинённых справоников.
		// вмсесто неё образовалась строка дерева со значением справочника реквизита, которую 
		// на следующем витке просто запихнёт в соответствующий реквизит.
		
	КонецЦикла;
	
	///////////////////////////////////////////////////////
	// В результате этой комбинации получено дерево со 
	// значениями реквизитов справочника "Номенклатура".
	// Остаётся создать элемент, и заполнить его значениями реквизитов.
	
	Для Каждого СтрокаДерева Из ВеткаРеквизита Цикл
		Значение = ВернутьЗначениеРеквизитаИзСтрокиДерева(ПараметрыКалькуляции, СтрокаДерева, ЭлементДляПодстановки, Объект);
		Если Значение <> Неопределено Тогда
			ЭлементДляПодстановки[СтрокаДерева["Реквизит"]] = Значение;
		КонецЕсли;
	КонецЦикла;
	
	ЭлементДляПодстановки.УстановитьНовыйКод();
	ЭлементДляПодстановки.ОбменДанными.Загрузка = Истина; // на всякий случай, не пойдём в процедуру "ПередЗаписью()"
	ЭлементДляПодстановки.Записать();
	
	// Есть ещё вероятность того, что подч справочник будет в корне возвращаемого элемента
	// Создание Подчинённых справочников...
	ВеткиПодчСпр = ВеткаРеквизита.НайтиСтроки(Новый Структура("Тип", "Найти / Создать Элемент Справочника"));
	Для Каждого ВеткаПодчСпр Из ВеткиПодчСпр Цикл
		
		СтрокиПодчСпр = ВеткаПодчСпр.Строки;
		СтрокаСинх = ТаблицаСинхронизации.Найти(ВеткаПодчСпр.UIN, "UIN");
		Если СтрокаСинх = Неопределено Тогда
			ЗнчСинх = Неопределено;
			ИмяРеквизита = "Неопределено";
		Иначе
			Попытка
				ЗнчСинх = ?(СтрокаСинх.Тип = "Фиксированое Значение", СтрокаСинх.Значение, Вычислить(СтрокаСинх.Значение));
			Исключение
				ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + СтрокаСинх.Значение;
			КонецПопытки;
			ИмяРеквизита = СтрокаСинх.Реквизит;
		КонецЕсли;
		ПодчСпр = НайтиСпр(ВеткаПодчСпр.Значение, ИмяРеквизита, ЗнчСинх);
		
		Попытка
			Если НЕ СтрокаСинх.Создавать Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			// Нет такого реквизита. Старая схема.
		КонецПопытки;
		
		Если ПодчСпр.Пустая() Тогда
			ИмяСпр = ВеткаПодчСпр.Значение;
			ПодчСпр = Справочники[ИмяСпр].СоздатьЭлемент();
			Для Каждого СтрокаПодчСпр Из СтрокиПодчСпр Цикл
				Значение = ВернутьЗначениеРеквизитаИзСтрокиДерева(ПараметрыКалькуляции, СтрокаПодчСпр, ПодчСпр, ЭлементДляПодстановки);
				Если Значение <> Неопределено тогда
					ПодчСпр[СтрокаПодчСпр["Реквизит"]] = Значение;
				КонецЕсли;
			КонецЦикла;
			ПодчСпр.Владелец = ЭлементДляПодстановки.Ссылка;
			ПодчСпр.УстановитьНовыйКод();
			ПодчСпр.ОбменДанными.Загрузка = Истина;
			ПодчСпр.Записать();
		КонецЕсли;
		
		Если ПустаяСтрока(ВеткаПодчСпр["Реквизит"]) Тогда
			Продолжить;
		КонецЕсли;
	
		ЭлементДляПодстановки[ВеткаПодчСпр["Реквизит"]] = ПодчСпр.Ссылка;
	КонецЦикла;

	ЭлементДляПодстановки.ОбменДанными.Загрузка = Истина; // на всякий случай, не пойдём в процедуру "ПередЗаписью()"
	ЭлементДляПодстановки.Записать();
	
	Возврат ЭлементДляПодстановки.Ссылка;
	
КонецФункции // ВернутьЭлементДляПодстановки()

Функция ВернутьРеквизит(ТекЭлемент, Реквизит, ПараметрыКалькуляции, СтрокаВхТаблицы = Неопределено, ПараметрыДела=Неопределено)
	
	Шапка = ПараметрыКалькуляции.Шапка;
	Детали = ПараметрыКалькуляции.ПКДетали;
	Работы = ПараметрыКалькуляции.ПКРаботы;
	Если НЕ СтрокаВхТаблицы = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Детали, СтрокаВхТаблицы);
		ЗаполнитьЗначенияСвойств(Работы, СтрокаВхТаблицы);
	КонецЕсли;
	
	ПК = Новый Структура("Шапка, Детали, Работы, ТаблицаСинхронизации", Шапка, Детали, Работы, ПараметрыКалькуляции.ТаблицаСинхронизации);
	
	ДеревоРеквизита = СоздатьТипизированноеДерево();
	Корень = ДеревоРеквизита.Строки.Добавить();
	ЗаполнитьЗначенияСвойств(Корень, Реквизит);
	ЗаполнитьВеткуСИизДерева(Корень, Реквизит);
	
	Тип = Реквизит.Тип;
	Значение = Реквизит.Значение;
	Если Тип = "Параметр Сеанса" Тогда
		Возврат ПараметрыСеанса[Значение];
	ИначеЕсли Тип = "Поле Калькуляции" Тогда
		Попытка
			Возврат Вычислить(Значение);
		Исключение
			ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + Значение;
		КонецПопытки;
	ИначеЕсли Тип = "Найти / Создать Элемент Справочника" Тогда
		Возврат ВернутьЭлементДляПодстановки(ТекЭлемент, Корень, ПК, СтрокаВхТаблицы);
	ИначеЕсли Тип = "Фиксированое Значение" Тогда
		ТипРеквизита = ВернутьОписаниеТиповРеквизита(ТекЭлемент[Реквизит.Реквизит]);
		Возврат ТипРеквизита.ПривестиЗначение(Значение);
	ИначеЕсли Тип = "Вычисляемое значение" Тогда
		Попытка
			Возврат Вычислить(Значение);
		Исключение
			ВызватьИсключение "Описание:" + ОписаниеОшибки() + "; Вычисляемое значение: " + Значение;
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

