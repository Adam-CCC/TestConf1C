// Процедура заполнения ветки схемы импорта из дерева
//
// Параметры:
//  ВеткаСИ - ветка схемы импорта
//  Дерево - дерево значений
//
Процедура ЗаполнитьВеткуСИизДерева(ВеткаСИ, Дерево) Экспорт

	Строки = Дерево.Строки;
	СтрокиВеткиСИ = ВеткаСИ.Строки;
	Для Каждого Строка Из Строки Цикл
		строкАветкиСИ = СтрокиВеткиСИ.Добавить();
		ЗаполнитьЗначенияСвойств(строкАветкиСИ, Строка);
		Если Строка.Строки.Количество() > 0 Тогда
			ЗаполнитьВеткуСИизДерева(строкАветкиСИ, Строка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПутьСтрокиДерева(СтрСинх)

	ВозврЗнч = Строка(СтрСинх.Реквизит);
	Если СтрСинх.Уровень() > 0 Тогда
		РодитЗнч = ПолучитьПутьСтрокиДерева(СтрСинх.Родитель);
		РодитЗнч = ?(ПустаяСтрока(РодитЗнч), "", РодитЗнч + ".");
		ВозврЗнч = РодитЗнч + ВозврЗнч;
	КонецЕсли;
	Возврат ВозврЗнч;
	
КонецФункции // ПолучитьПутьСтокиДерева(СтрСинх)

Процедура ЗаполнитьТСизДерева(ИмяДерева, СИ, ТС)

	Поддерево = СИ.Строки.Найти(ИмяДерева, "Синоним").Строки;
	СтрокиСинхронизации = Поддерево.НайтиСтроки(Новый Структура("Тип", "Найти / Создать Элемент Справочника"), Истина);
	Для Каждого СтрСинх Из СтрокиСинхронизации Цикл
		СтрокаТабСинх = ТС.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТабСинх, СтрСинх);
		СтрокаТабСинх.Дерево = ИмяДерева;
		СтрокаТабСинх.Поле = ПолучитьПутьСтрокиДерева(СтрСинх);
	КонецЦикла;

КонецПроцедуры

