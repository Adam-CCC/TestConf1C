Функция НайтиСпр(ИмяСпр, имяРеквизитаПоиска, ЗначениеСинхронизации, неопр = Неопределено)
	
	ЭлементСправочника = Справочники[ИмяСпр].СоздатьЭлемент();

	ТипРеквизита = ВернутьОписаниеТиповРеквизита(ЭлементСправочника[имяРеквизитаПоиска]);
	
	ЗначениеПоиска = ТипРеквизита.ПривестиЗначение(ЗначениеСинхронизации);
	Запрос = Новый Запрос;
	ЗапросТекст = "ВЫБРАТЬ
	|	спр.Ссылка
	|ИЗ
	|	Справочник."+ИмяСпр+" КАК спр
	|ГДЕ
	|	спр."+имяРеквизитаПоиска+" = &Парам
	|";
	ЗапросТекст = ЗапросТекст + ?(ЭлементСправочника.метаданные().Иерархический, Символы.ПС+"и спр.ЭтоГруппа = ложь", "");
	Запрос.Текст = ЗапросТекст;
	Запрос.УстановитьПараметр("Парам", ЗначениеПоиска);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники[ИмяСпр].ПустаяСсылка();
	
КонецФункции

Функция СоздатьСпр(Строка)
	
	ИмяСпр = ВернутьИмяОбъектаМД(Строка.Значение);
	Возврат Справочники[ИмяСпр].СоздатьЭлемент();
	
КонецФункции // НайтиСпр()

Функция ВернутьИмяОбъектаМД(Значение)
	
	ОбъектСсылка = Новый(ТипЗнч(Значение));
	Возврат ОбъектСсылка.Метаданные().Имя;
	
КонецФункции

