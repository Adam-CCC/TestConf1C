// Функция осуществляет инициализацию списка заданий
// посредством отправки запроса на сервер
//
// Параметры:
// datefrom - дата начала
// dateto - дата окончания
// tab - фильтр списка дел
//
// Возвращаемое значение - список дел
//
Функция ИнициализацияСписка(datefrom, dateto, tab) Экспорт
	
	Попытка
		Библиотека = Новый COMОбъект("Auda.Saxif");
		
		// Свойство Test может принимать значения «true» и «false». В случае использования
		// тестовых учетных записей следует установить значение в «true». По умолчанию имеет значение «false»
		//Библиотека.Test = "true";
		
		СтрокаВозврата = Библиотека.GetTaskList(login, password, datefrom, dateto, tab);
		Попытка			
			СписокИдентификаторов	= Библиотека.GetCustomerIDList();
		Исключение
			СписокИдентификаторов	= "";
		КонецПопытки;
		Если ВыводитьСообщения И ЗначениеЗаполнено(СписокИдентификаторов) Тогда
			#Если Клиент Тогда
			Сообщить(СписокИдентификаторов);
			#КонецЕсли
		КонецЕсли;					
		
		Если Тестирование Тогда
			ЗаписатьСтрокуXML(СтрокаВозврата, КаталогВременныхФайлов() + Формат(ТекущаяДата(), "ДФ=""гг ММММ дд чч мм""")+ ".xml");
		КонецЕсли;
		
		Библиотека = Неопределено;
		Возврат СтрокаВозврата;
	Исключение
		#Если Клиент Тогда
		Сообщить(ОписаниеОшибки());
		#КонецЕсли
	КонецПопытки;
	Возврат Неопределено;
	
КонецФункции

// Функция проверяет зарегистрирована ли библиотека
//
// Возвращаемое значение - булево
//
Функция БиблиотекаЗарегистрирована() Экспорт
	
	Попытка
		Библиотека = Новый COMОбъект("Auda.Saxif");
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Библиотека = Неопределено;
	Возврат Истина;
	
КонецФункции

// Функция осуществляет инициализацию калькуляции
//
// Параметры:
//  taskid - номер дела
//
// Возвращаемое значение - данные о калькуляции
//
Функция ИнициализацияКалькуляции(taskid) Экспорт
	
	Попытка
		Библиотека = Новый COMОбъект("Auda.Saxif");
		
		// Свойство Test может принимать значения «true» и «false». В случае использования
		// тестовых учетных записей следует установить значение в «true». По умолчанию имеет значение «false»
		//Библиотека.Test = "true";
		
		СтрокаВозврата = Библиотека.GetTaskCalcs(login, password, taskid);
		
		Если Тестирование Тогда
			ЗаписатьСтрокуXML(СтрокаВозврата, КаталогВременныхФайлов() + Формат(ТекущаяДата(), "ДФ=""гг ММММ дд чч мм""")+ ".xml");
		КонецЕсли;
		
		Библиотека = Неопределено;
		Возврат СтрокаВозврата;
	Исключение
		#Если Клиент Тогда
		Сообщить(ОписаниеОшибки());
		#КонецЕсли
	КонецПопытки;
	Возврат Неопределено;
	
КонецФункции

//Разбирает ФИ такой структуры:
//
//<TaskProxyList xmlns="http://www.audatex.com/SAXIF">
// <TaskProxy>
//  <TaskId>D1BE10D4-3E62-EBB3-BE7E-A39A37CFA7ED</TaskId>
//  <CaseId>F5612FCA-1A41-2530-D34D-0EC7A89BE498</CaseId>
//  <ClaimNumber>ftdtrdr</ClaimNumber>
//  <VIN>11111111111111111</VIN>
//  <PlateNumber>FHGGFVGHGHG</PlateNumber>
//  <ManufacturerName>MERCEDES BENZ[R] [03]</ManufacturerName>
//  <ModelName>S-Class (W221/V221) 09/05-  [49]</ModelName>
//  <CreationDate>2009-05-12T14:25:52.000</CreationDate>
// </TaskProxy>
Функция DOMРазборСпискаXML(СтрокаВозврата) Экспорт
	
	ПИ ="xmlns="+Прав("""", 1)+"http://www.audatex.com/SAXIF"+Прав("""", 1);
	ДОМ = ВернутьДОМ(СтрЗаменить(СтрокаВозврата, ПИ, ""));
	
	Если ДОМ = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	СтруктураКолонок = Новый Структура;
	СтруктураКолонок.Вставить("ClaimNumber", "Номер Дела");
	СтруктураКолонок.Вставить("VIN", "VIN");
	СтруктураКолонок.Вставить("PlateNumber", "Гос. Номер Автомобиля");
	СтруктураКолонок.Вставить("VehicleOwnerFirstName", "Имя Владельца");
	СтруктураКолонок.Вставить("VehicleOwnerLastName", "Фамилия Владельца");
	
	СтруктураКолонок.Вставить("TaskID", "Текущий Идентификатор Дела");
	СтруктураКолонок.Вставить("CaseID", "Уникальный Идентификатор Дела");
	СтруктураКолонок.Вставить("ManuFacturerName", "Название Производителя");
	СтруктураКолонок.Вставить("CreationDate", "Дата Создания Дела");
	СтруктураКолонок.Вставить("ModelName", "Модель Автомобиля");
	
	ТаблицаСпискаДел = РазобратьВеткуВСтрокиТаблицы(ДОМ, "//TaskProxy/descendant::*", , СтруктураКолонок);
	
	ТаблицаСпискаДел.Колонки.Вставить(0, "ДатаСозданияДела", , "Дата Создания Дела", 25);
	ТаблицаСпискаДел.Колонки.Вставить(2, "МодельАвтомобиля", , "Модель Автомобиля", 25);
	Для Каждого СтрокаСписка Из ТаблицаСпискаДел Цикл
		СтрокаСписка["ДатаСозданияДела"] = ВычислитьДату(СтрокаСписка["CreationDate"]);
		
		Если НЕ ((СтрокаСписка["ManuFacturerName"] = Неопределено) И (СтрокаСписка["ModelName"] = Неопределено)) Тогда
			
			Модель = СтрокаСписка["ManuFacturerName"] + СтрокаСписка["ModelName"];
			Скобка1 = Найти(Модель, "[");
			Скобка2 = Найти(Модель, "]");
			Пока Скобка1 > 0 Цикл
				ДоСкобки = Лев(Модель, Скобка1-1);
				ПослеСкобки = Прав(Модель, СтрДлина(Модель) - (Скобка2));
				Модель = ДоСкобки + ПослеСкобки;
				Скобка1 = Найти(Модель, "[");
				Скобка2 = Найти(Модель, "]");
			КонецЦикла;
			СтрокаСписка["МодельАвтомобиля"] = Модель;
		Иначе
			СтрокаСписка["МодельАвтомобиля"] = "";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаСпискаДел;
	
КонецФункции

