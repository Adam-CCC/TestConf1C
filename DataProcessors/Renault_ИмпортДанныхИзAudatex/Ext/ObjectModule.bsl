Процедура ЗаполнитьСтоимость(ПараметрыРасчета, Стоимость, ВхТаблица, СтрокаВхТаблицы)

	Если ВхТаблица.Колонки.Найти("ЦенаРубли") = Неопределено Тогда
		ВхТаблица.Колонки.Добавить("ЦенаРубли")
	КонецЕсли;
	Если ВхТаблица.Колонки.Найти("ЦенаЕвро") = Неопределено Тогда
		ВхТаблица.Колонки.Добавить("ЦенаЕвро")
	КонецЕсли;
	Курс = ?(ПараметрыРасчета["Курс"] = "", 0, Число(ПараметрыРасчета["Курс"]));
	ОкрСтоимость = Окр(Стоимость, 2);
	Попытка
		СтрокаВхТаблицы.ЦенаРубли = ?(ВРег(СокрЛП(ПараметрыРасчета["ВалРасч"]))="RUR", ОкрСтоимость, Окр(Стоимость*Курс, 2));
		СтрокаВхТаблицы.ЦенаЕвро = ?(ВРег(СокрЛП(ПараметрыРасчета["ВалРасч"]))="EUR", ОкрСтоимость, Окр(Стоимость/Курс, 2));
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция ВычислитьДату(ДатаСтрокой)
	
	Дата = Лев(СтрЗаменить(ДатаСтрокой, "T", " "), Найти(ДатаСтрокой, ".")-1);
	Дата = СтрЗаменить(Дата, "-", "");
	Дата = СтрЗаменить(Дата, ":", "");
	Дата = СтрЗаменить(Дата, " ", "");
	Если ЗначениеЗаполнено(Дата) Тогда
		Возврат Дата(Дата);
	Иначе
		Возврат Дата(1,1,1);
	КонецЕсли;
	
КонецФункции

