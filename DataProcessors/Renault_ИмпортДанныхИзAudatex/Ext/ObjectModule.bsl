// Функция осуществляет регистрацию библиотеки auda.dll в системе
//
// Параметры:
//  Спредупреждением - флаг вывода предупреждений
//
// Возвращаемое значение - признак регистрации библиотеки
//
Функция ЗарегистрироватьБиблиотеку(Спредупреждением = Ложь) Экспорт
	
	Если БиблиотекаЗарегистрирована() Тогда
		Возврат Истина
	КонецЕсли;
	
	// компонента
	рИмяФайла = КаталогИмпорта + "\" + "AudaReg" + ".ini";
	кИмяФайла = КаталогИмпорта + "\" + "auda" + ".dll";
	кФайл = Новый Файл(кИмяФайла);
	рФайл = Новый Файл(рИмяФайла);
	Если кФайл.Существует() Тогда
		Если НЕ рФайл.Существует() Тогда
			Попытка
				
				//Ком = Новый COMObject("wScript.Shell");
				//Ком.Run("Regsvr32.exe " + кИмяФайла);
				#Если Клиент Тогда
				ЗапуститьПриложение("Regsvr32.exe """ + кИмяФайла + """");
				#Иначе
				Ком		= Новый COMObject("wScript.Shell");
				Ком.Run("""Regsvr32.exe """ + кИмяФайла + """" + """");
				#КонецЕсли
			
				Если Спредупреждением Тогда
					#Если Клиент Тогда
					Предупреждение("Дождитесь окна сообщения о регистрации DLL и нажмите ОК!", 10);
					#КонецЕсли
				КонецЕсли;
				
			Исключение
				Сообщение("Не удалось зарегистрировать компоненту. "+Символы.ПС+"Возможно нет прав, обратитесь за помощью к системному администратору.", 1);
				Возврат Ложь;
			КонецПопытки;
		КонецЕсли;
	Иначе
		Сообщение("Не удалось зарегистрировать компоненту. "+Символы.ПС+"В каталоге импорта отсутствует библиотека 'Auda.dll'", 1);
		Возврат Ложь;
	КонецЕсли;
	
	Зарегистириована = БиблиотекаЗарегистрирована();
	Если Зарегистириована Тогда
		ЗначениеВФайл(рИмяФайла, Истина);
	КонецЕсли;
	
	Возврат Зарегистириована
	
КонецФункции

// Функция проверяет корректность каталога импорта
//
// Возвращаемое значение - булево, каталог корректен
//
Функция ПроверкаКаталогаИмпорта() Экспорт

	Каталог = Новый Файл(КаталогИмпорта);
	Если (НЕ Каталог.Существует()) ИЛИ (НЕ Каталог.ЭтоКаталог()) Тогда
		Сообщение("Некорректно указан каталог обмен """+КаталогИмпорта+"""",1);
		Возврат Ложь;
	КонецЕсли;

	ИмяФайла	= КаталогИмпорта + "/ini.ini";
	ФайлИНИ		= Новый Файл(ИмяФайла);
	Если НЕ ФайлИНИ.Существует() Тогда
		ИНИ		= Новый ТаблицаЗначений();
		ИНИ.Колонки.Добавить("ИмяШаблона");
		ИНИ.Колонки.Добавить("ТекШаблон");
		Для Каждого Шаблон Из ЭтотОбъект.Метаданные().Макеты Цикл
			Если Шаблон.Комментарий = "Шаблон" Тогда
				СтрокаИНИ = ИНИ.Добавить();
				СтрокаИНИ.ИмяШаблона = Шаблон.Имя;
			КонецЕсли;
		КонецЦикла;
		ИНИ.ЗаполнитьЗначения(Ложь, "ТекШаблон");
		ЗначениеВФайл(ИмяФайла, ИНИ);
		
		Если НЕ ФайлИНИ.Существует() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// распаковка шаблонов
	ИНИ	= ЗначениеИзФайла(ИмяФайла);
	Для Каждого Шаблон Из ИНИ Цикл
		шИмяФайла	= КаталогИмпорта + "/" + Шаблон.ИмяШаблона + ".xml";
		шФайл		= Новый Файл(шИмяФайла);
		Если НЕ шФайл.Существует() Тогда
			Попытка
				шДвоичныеДанные = ЭтотОбъект.ПолучитьМакет(Шаблон.ИмяШаблона);
				шДвоичныеДанные.Записать(шИмяФайла);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	// Лог файл
	ИмяФайла	= КаталогИмпорта + "/log.tbl";
	ФайлЛог		= Новый Файл(ИмяФайла);
	Если НЕ ФайлЛог.Существует() Тогда
		Лог	= Новый ТаблицаЗначений();
		Лог.Колонки.Добавить("ВидДок");
		Лог.Колонки.Добавить("UIN");
		Лог.Колонки.Добавить("CaseID");
		Лог.Колонки.Добавить("TaskID");
		Лог.Колонки.Добавить("ДатаРасч");
		ЗначениеВФайл(ИмяФайла, Лог);
	КонецЕсли;

	// Лог файл для синхронизации номенклатуры
	ИмяФайла	= КаталогИмпорта + "/GoodsTune.tbl";
	ФайлЛог		= Новый Файл(ИмяФайла);
	Если НЕ ФайлЛог.Существует() Тогда
		Лог		= Новый ТаблицаЗначений;
		Лог.Колонки.Добавить("Имя");
		Лог.Колонки.Добавить("UIN");
		ЗначениеВФайл(ИмяФайла, Лог);
	КонецЕсли;

	Возврат Истина;
	
КонецФункции // ПроверкаКаталогаИмпорта()

