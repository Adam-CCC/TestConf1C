		Ответ.Вставить("Заявка", ЗаявкаНаСервис5);
		Ответ.Вставить("Нормочас", Нормочас5);
		Ответ.Вставить("ТипЦен", ТипЦен5);
		Ответ.Вставить("ВидРемонта", ВидРемонта5);
