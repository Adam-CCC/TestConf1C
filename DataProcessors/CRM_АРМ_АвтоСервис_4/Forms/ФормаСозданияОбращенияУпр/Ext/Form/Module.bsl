&НаКлиенте
Процедура ДобавитьКомплексСервис(НомерЗаявки)
	
	Если Не ЗначениеЗаполнено(ТекущийАвтомобиль) Тогда 
		ПоказатьПредупреждение(,"Не выбран автомобиль");
		Возврат;
	КонецЕсли;

	ПараметрыЗаявки = ПолучитьПараметрыЗаявки(НомерЗаявки);
	
	ТекВидРемонта = ПараметрыЗаявки.ВидРемонта;
	НормочасРабот = ПараметрыЗаявки.Нормочас;
	ТабАвтоработы = ПараметрыЗаявки.Заявка.Работы;
	ТабЗапчасти = ПараметрыЗаявки.Заявка.Товары;
	
	ФормаВыбора = Обработки.Renault_ПодборКомплексСервисов.ПолучитьФорму();
	
	ФормаВыбора.Автомобиль = ТекущийАвтомобиль;
	
	ВыбранныйКС = ФормаВыбора.ОткрытьМодально();
	Если ТипЗнч(ВыбранныйКС) = Тип("ТаблицаЗначений") И ВыбранныйКС.Количество() > 0 Тогда		
		Для каждого ТекСтрока из ВыбранныйКС Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Работа) Тогда
				НоваяСтрока = ТабАвтоработы.Добавить();
				НоваяСтрока.Коэффициент = ПолучитьКоэффициентСложностиРаботы(ТекСтрока.Работа, ТекВидРемонта);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.Нормочас = НормочасРабот;
				НоваяСтрока.Сумма = ТекСтрока.Стоимость;
				Если НоваяСтрока.Длительность <> 0 Тогда
					НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Длительность;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				НоваяСтрока = ТабЗапчасти.Добавить();
				НоваяСтрока.Артикул = ТекСтрока.Номенклатура.Артикул;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.Сумма = ТекСтрока.Стоимость;
			КонецЕсли;
		КонецЦикла;
		
		ПересчитатьСтоимости();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзDialogys(НомерЗаявки)
	
	ПараметрыЗаявки = ПолучитьПараметрыЗаявки(НомерЗаявки);
	
	мТипЦен = ПараметрыЗаявки.ТипЦен;
	мНормочас = ПараметрыЗаявки.Нормочас;
	
	ПараметрыФормы = Новый Структура("Модель,ТипЦен,Нормочас,Автомобиль", ТекущийАвтомобиль.Модель, мТипЦен, мНормочас, ТекущийАвтомобиль);
	РезультатВыбора = ОткрытьФормуМодально("Справочник.DMS_РесурсныеСпецификации.Форма.ФормаПодбора", ПараметрыФормы, ЭтаФорма);
	
	Если РезультатВыбора <> Неопределено
		И ЭтоАдресВременногоХранилища(РезультатВыбора) Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Автоработы", ПараметрыЗаявки.Заявка.Работы);
		ЗаполнитьАвтоработыИзВременногоХранилища(РезультатВыбора, ДопПараметры);
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзNewDialogys(НомерЗаявки)
	
	ПараметрыЗаявки = ПолучитьПараметрыЗаявки(НомерЗаявки);
	
	ТекВидРемонта 	= ПараметрыЗаявки.ВидРемонта;
	НормочасРабот 	= ПараметрыЗаявки.Нормочас;
	ТабАвтоработы 	= ПараметрыЗаявки.Заявка.Работы;
	ТабЗапчасти 	= ПараметрыЗаявки.Заявка.Товары;
	ТекТипЦен		= ПараметрыЗаявки.ТипЦен;

	ОбращениеСсылка = Неопределено;
	Попытка
		УстановитьТекстВБуферОбмена(ТекущийАвтомобиль.VIN);
	Исключение
	КонецПопытки;
		
	ОбработкаНД = Обработки.Renault_ПодборИзNewDialogys.Создать();	
	ОбработкаНД.VIN = ТекущийАвтомобиль.VIN;
	ОбработкаНД.Автомобиль = ТекущийАвтомобиль;
	ОбработкаНД.Клиент = Клиент;
	ОбработкаНД.НормочасПоУмолчанию = НормочасРабот;
	ОбработкаНД.ОбращениеВАвтосервис = ОбращениеСсылка;
	ОбработкаНД.Автоработы.Очистить();
	ОбработкаНД.Запчасти.Очистить();
	ОбработкаНД.Корзины.Очистить();
	
	СервисДоступен = ОбработкаНД.ПроверитьПодключениеКНовомуДиалоджис();
	Если Не СервисДоступен Тогда
		ТекстВопроса = НСтр(
		"ru = 'В настоящее время сервис прямого подключения к New Dialogys не доступен. VIN скопирован в буфер. 
		|Вставьте VIN в окно New Dialogys для подбора работ и запчастей вручную.'"); 
		Вопрос(ТекстВопроса, РежимДиалогаВопрос.ОК);
	КонецЕсли;		
		
	ФормаВыбора = ОбработкаНД.ПолучитьФорму();
	РезВыбора = ФормаВыбора.ОткрытьМодально();
	Если ТипЗнч(РезВыбора) = Тип("Булево") И РезВыбора = Истина Тогда
		Для каждого ТекСтрока Из ОбработкаНД.Автоработы Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Работа) Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Работа",ТекСтрока.Работа);
				МассивДублей = ТабАвтоработы.НайтиСтроки(Отбор);
				Если МассивДублей.Количество() > 0 Тогда
					Сообщить(Строка(ТекСтрока.Работа) + " уже в списке авторабот.");
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТабАвтоработы.Добавить();				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.Коэффициент = ПолучитьКоэффициентСложностиРаботы(ТекСтрока.Работа, ВидРемонта1);
				НоваяСтрока.Нормочас = НормочасРабот;
				НоваяСтрока.Длительность = НоваяСтрока.ДлительностьЗН;
				НоваяСтрока.СуммаСкидки = 0;
				НоваяСтрока.ПроцентСкидки = 0;
				ПересчитатьСуммыВСтрокеРабот(НоваяСтрока, ?(ЗначениеЗаполнено(ТекСтрока.Нормочас),ТекСтрока.Нормочас,НормочасРабот));	
			КонецЕсли;
		КонецЦикла;
		
		Для каждого ТекСтрока из ОбработкаНД.Запчасти Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура",ТекСтрока.Номенклатура);
				МассивДублей = ТабЗапчасти.НайтиСтроки(Отбор);
				Если МассивДублей.Количество() > 0 Тогда
					Сообщить(Строка(ТекСтрока.Номенклатура) + " уже в списке запасных частей.");
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТабЗапчасти.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.Артикул = ТекСтрока.Номенклатура.Артикул;
				
				Попытка
					Цена = ПолучитьЦену(ТекСтрока.Номенклатура, ТекТипЦен);
					НоваяСтрока.Цена = Цена;
					НоваяСтрока.Сумма = Цена * НоваяСтрока.Количество;
				Исключение
					Сообщить(НСтр("ru = 'Не удалось определить цену для '") + ТекСтрока.Номенклатура);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		ПересчитатьСтоимости();
	
	КонецЕсли;
	
	ОбработкаНД = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаказанныеЗапчасти(НомерЗаявки)
	
	ФормаПодбора = Обработки.CRM_АРМ_АвтоСервис_4.ПолучитьФорму("ФормаПодбораПоЗаказам", ЭтаФорма);
	ЭтоВтораяЗаявка = (НомерЗаявки = 2);
	ЭтоТретьяЗаявка = (НомерЗаявки = 3);
	ЭтоЧетвертаяЗаявка = (НомерЗаявки = 4);
	ЭтоПятаяЗаявка = (НомерЗаявки = 5);
	
	Если ЭтоВтораяЗаявка Тогда 
		ТипЦены	= ТипЦен2;
	ИначеЕсли ЭтоТретьяЗаявка Тогда 
		ТипЦены	= ТипЦен3;
	ИначеЕсли ЭтоЧетвертаяЗаявка Тогда
		ТипЦены	= ТипЦен4;
	ИначеЕсли ЭтоПятаяЗаявка Тогда
		ТипЦены	= ТипЦен5;
	Иначе 
		ТипЦены	= ТипЦен1;
	КонецЕсли;
	
	ФормаПодбора.Контрагент = Клиент;
	ФормаПодбора.ТипЦен = ТипЦены;
	ФормаПодбора.ЭтоВтораяЗаявка = ЭтоВтораяЗаявка;
	ФормаПодбора.ЭтоТретьяЗаявка = ЭтоТретьяЗаявка;
	ФормаПодбора.ЭтоЧетвертаяЗаявка = ЭтоЧетвертаяЗаявка;
	ФормаПодбора.ЭтоПятаяЗаявка = ЭтоПятаяЗаявка;
	ФормаПодбора.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЧастоИспользуемыеЗапчасти(НомерЗаявки)
	
	Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораЧастоИспользуемых");
	Форма.Модель             = ТекущийАвтомобиль.Модель;
	Форма.МножественныйВыбор = Ложь;
	Форма.Номенклатура       = Истина;
	
	Ответ = Форма.ОткрытьМодально(); 
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	Если НомерЗаявки = 1 Тогда
		ЗаявкаНаСервис = ЗаявкаНаСервис1;
		Нормочас = Нормочас1;
		ВидРемонта = ВидРемонта1;
		ТипЦен = ТипЦен1;
	ИначеЕсли НомерЗаявки = 2 Тогда
		ЗаявкаНаСервис = ЗаявкаНаСервис2;
		Нормочас = Нормочас2;
		ВидРемонта = ВидРемонта2;
		ТипЦен = ТипЦен2;
	ИначеЕсли НомерЗаявки = 3 Тогда
		ЗаявкаНаСервис = ЗаявкаНаСервис3;
		Нормочас = Нормочас3;
		ВидРемонта = ВидРемонта3;
		ТипЦен = ТипЦен3;
	ИначеЕсли НомерЗаявки = 4 Тогда
		ЗаявкаНаСервис = ЗаявкаНаСервис4;
		Нормочас = Нормочас4;
		ВидРемонта = ВидРемонта4;
		ТипЦен = ТипЦен4;
	ИначеЕсли НомерЗаявки = 5 Тогда
		ЗаявкаНаСервис = ЗаявкаНаСервис5;
		Нормочас = Нормочас5;
		ВидРемонта = ВидРемонта5;
		ТипЦен = ТипЦен5;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Автоработы",ЗаявкаНаСервис.Работы);
	ДопПараметры.Вставить("Материалы",ЗаявкаНаСервис.Товары);
	ДопПараметры.Вставить("Нормочас",Нормочас);
	ДопПараметры.Вставить("ВидРемонта",ВидРемонта);
	ДопПараметры.Вставить("ТипЦен",ТипЦен);
	Если Ответ.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.Набор Тогда  
		КоличествоНаборов = 0;
		
		Если НЕ ВвестиЧисло(КоличествоНаборов, "Введите количество наборов", 2) Тогда
			КоличествоНаборов = 0;
			Возврат;
		КонецЕсли;
		
		Для Каждого СтрокаНабора ИЗ Ответ.Значение.СоставНабора Цикл
			ДобавитьМатериалВСписок(СтрокаНабора.Номенклатура, КоличествоНаборов * СтрокаНабора.Количество, ДопПараметры);
		КонецЦикла;
	Иначе
		ДобавитьМатериалВСписок(Ответ, 1, ДопПараметры);
	КонецЕсли;
	
	ПересчитатьСтоимости();
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

