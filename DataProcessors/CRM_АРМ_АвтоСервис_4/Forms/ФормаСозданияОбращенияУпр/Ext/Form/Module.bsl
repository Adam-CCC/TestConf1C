		ТекСтрокаД = Элементы.ЗаявкаНаСервис4Работы.ТекущиеДанные;
		Нормочас = Нормочас4;
	ИначеЕсли НомерЗаявки = 5 Тогда
		ТекСтрокаД = Элементы.ЗаявкаНаСервис5Работы.ТекущиеДанные;
		Нормочас = Нормочас5;
	КонецЕсли;
	
	ТекСтрокаД.Длительность = ТекСтрокаД.ДлительностьЗН;
	ПересчитатьСуммыВСтрокеРабот(ТекСтрокаД, Нормочас);
	ПересчитатьСтоимости();
	
