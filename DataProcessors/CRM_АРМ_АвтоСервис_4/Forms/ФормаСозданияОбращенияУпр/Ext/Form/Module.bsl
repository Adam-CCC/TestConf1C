	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьЧастоИспользуемые(НомерЗаявки)
	
	Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораЧастоИспользуемых");
	Форма.Модель             = ТекущийАвтомобиль.Модель;
	Форма.МножественныйВыбор = Ложь;
	Форма.Номенклатура       = Ложь;
	
	Ответ = Форма.ОткрытьМодально();
		
	Если Не ЗначениеЗаполнено(Ответ) Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
	ПараметрыЗаявки = ПолучитьПараметрыЗаявки(НомерЗаявки);
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Автоработы", ПараметрыЗаявки.Заявка.Работы);
	ДопПараметры.Вставить("Материалы", ПараметрыЗаявки.Заявка.Товары);
	ДопПараметры.Вставить("Нормочас", ПараметрыЗаявки.Нормочас);
	ДопПараметры.Вставить("ВидРемонта", ПараметрыЗаявки.ВидРемонта);
	ДопПараметры.Вставить("ТипЦен", ПараметрыЗаявки.ТипЦен);
	ДобавитьАвтоработуВСписок(Ответ, Истина, ДопПараметры); 
	
	ПересчитатьСтоимости();
	
КонецПроцедуры

