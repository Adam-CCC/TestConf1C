&НаКлиенте
Процедура ПервоеОбращение(Команда)
	
	ПервичноеОбращение = Истина;
	ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный;
	
	Форма = Обработки.CRM_АРМ_АвтоСервис_4.ПолучитьФорму("ФормаСозданиеКонтрагента", ЭтаФорма, Новый УникальныйИдентификатор());
	ОтветКлиент = Форма.ОткрытьМодально();
	Если Не ЗначениеЗаполнено(ОтветКлиент) Тогда 
		Возврат;		
	КонецЕсли;
	
	Клиент = ОтветКлиент;
	ЗаполнитьПоКлиенту();
	
КонецПроцедуры

&НаКлиенте
Процедура ПовторноеОбращение(Команда)
	
	ПервичноеОбращение = Ложь;
	ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный;
	
	//ЭлементыФормы.КнопкаПервичное.ЦветФона = Новый Цвет(245, 242, 241);
	//ЭлементыФормы.КнопкаПовторное.ЦветФона = СтруктураЦветов.ЖелтыйЦвет;
	
	Ответ = Неопределено;
	ПоискВключен = (ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить);
	
	Если ПоискВключен И Renault_ОбщегоНазначенияПовтИсп.Renault_Это83() 
		И (ПолнотекстовыйПоиск.ДатаАктуальности() + 3600 >= ТекущаяДата()) Тогда  
		
		ПараметрыФормы = Новый Структура("Клиент, ДилерскийЦентр, Телефон", Клиент, ДилерскийЦентр, Строка(ТелефонКлиента));
		Ответ = ОткрытьФормуМодально("ОбщаяФорма.DMS_ФормаВыбораКонтрагентов", ПараметрыФормы);
	КонецЕсли;	
	
	Если Ответ = Неопределено Тогда	
		Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораКонтрагента");		
		Форма.ОтборФИО = Строка(Клиент);
		Форма.ОтборТелефон = Строка(ТелефонКлиента);
		Форма.ДилерскийЦентр = ДилерскийЦентр;
		Форма.НачальноеЗначениеВыбора = Клиент;
		Ответ = Форма.ОткрытьМодально();
	КонецЕсли; 	
	
	Клиент = Ответ;
	//ТекущийКлиент = Клиент;
	ЗаполнитьПоКлиенту();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоКлиенту()
	
	ОбновитьДокументЗаявкаНаПодменныйАвто("Клиент");
	ОбновитьДокументЗаявкаНаМойку("Клиент");
	ОбновитьТелефонИEmail(Клиент);
	
	Если ВладелецАвтомобиля <> Клиент И НЕ КлиентОтличаетсяОтВладельца Тогда		
		ВладелецАвтомобиля = Клиент;			
		ОбновитьТелефонИEmail(ВладелецАвтомобиля, Истина);		
	КонецЕсли;
	
	ЗаполнитьБонуснуюКарту();
	БонуснаяКартаПриИзменении(Неопределено);
	
	//ЗаполнитьВыборАвто(Клиент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументЗаявкаНаПодменныйАвто(ИмяРеквизита)

	Если ЗначениеЗаполнено(ЗаявкаНаПодменныйАвтоСсылка) Тогда
		Если ИмяРеквизита = "Клиент" И ЗаявкаНаПодменныйАвтоСсылка.Клиент <> Клиент Тогда
			ДокументОбъект = ЗаявкаНаПодменныйАвтоСсылка.ПолучитьОбъект();
			ДокументОбъект.Клиент = Клиент;
			
			Попытка
				ДокументОбъект.Записать();
			Исключение
				СообщениеПользователю = Новый СообщениеПользователю;
				СообщениеПользователю.Текст = НСтр("ru='Не удалось записать документ ""Заявка на подменный авто""'; en = 'ZZZ';  fr = 'ZZZ'; bg = 'ZZZ'") + Символы.ПС + ОписаниеОшибки();
				СообщениеПользователю.Сообщить();
			КонецПопытки;	
			
		ИначеЕсли ИмяРеквизита = "Обращение" И ЗаявкаНаПодменныйАвтоСсылка.Обращение <> ОбращениеСсылка Тогда
			ДокументОбъект = ЗаявкаНаПодменныйАвтоСсылка.ПолучитьОбъект();
			ДокументОбъект.Обращение = ОбращениеСсылка;
			
			Попытка
				ДокументОбъект.Записать();
			Исключение
				СообщениеПользователю = Новый СообщениеПользователю;
				СообщениеПользователю.Текст = НСтр("ru='Не удалось записать документ ""Заявка на подменный авто""'; en = 'ZZZ';  fr = 'ZZZ'; bg = 'ZZZ'") + Символы.ПС + ОписаниеОшибки();
				СообщениеПользователю.Сообщить();
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументЗаявкаНаМойку(ИмяРеквизита)

	Если ЗначениеЗаполнено(ТекущаяМойка) Тогда
		Если ИмяРеквизита = "Клиент" И ТекущаяМойка.Клиент <> Клиент Тогда
			ДокументОбъект = ТекущаяМойка.ПолучитьОбъект();
			ДокументОбъект.Клиент = Клиент;
			
			Попытка
				ДокументОбъект.Записать();
			Исключение
				СообщениеПользователю = Новый СообщениеПользователю;
				СообщениеПользователю.Текст = НСтр("ru='Не удалось записать документ ""Заявка на мойку""'; en = 'ZZZ';  fr = 'ZZZ'; bg = 'ZZZ'") + Символы.ПС + ОписаниеОшибки();
				СообщениеПользователю.Сообщить();
			КонецПопытки;	
			
		ИначеЕсли ИмяРеквизита = "Обращение" И ТекущаяМойка.Обращение <> ОбращениеСсылка Тогда
			ДокументОбъект = ТекущаяМойка.ПолучитьОбъект();
			ДокументОбъект.Обращение = ОбращениеСсылка;
			
			Попытка
				ДокументОбъект.Записать();
			Исключение
				СообщениеПользователю = Новый СообщениеПользователю;
				СообщениеПользователю.Текст = НСтр("ru='Не удалось записать документ ""Заявка на мойку""'; en = 'ZZZ';  fr = 'ZZZ'; bg = 'ZZZ'") + Символы.ПС + ОписаниеОшибки();
				СообщениеПользователю.Сообщить();
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТелефонИEmail(Контрагент, ОбновлятьДанныеПоВладельцу = Ложь)
	
	Если ЗначениеЗаполнено(ДилерскийЦентр) И НЕ ПустаяСтрока(ДилерскийЦентр.ПервыйСимволТелефона) Тогда	
		Если СтрДлина(ДилерскийЦентр.ПервыйСимволТелефона) = 1 Тогда
			Элементы.ТелефонКлиента.Маска = "9(999)9999999";
			Элементы.ТелефонВладельца.Маска = "9(999)9999999";
		Иначе
			Элементы.ТелефонКлиента.Маска = "+9(999)9999999";
			Элементы.ТелефонВладельца.Маска = "+9(999)9999999";
		КонецЕсли;
	Иначе
		// Сбрасываем маску
		Элементы.ТелефонВладельца.Маска = "";
		Элементы.ТелефонКлиента.Маска = "";
	КонецЕсли;
	
	//Если ОбновлятьДанныеПоВладельцу Тогда
		ТелефонВладельца = ПреобразоватьТелефон(Renault_CRM.ПолучитьТелефонКлиент(ВладелецАвтомобиля));
		EmailВладельца = Renault_CRM.ПолучитьЕмаилКлиент(ВладелецАвтомобиля);
	//Иначе
		ТелефонКлиента = ПреобразоватьТелефон(Renault_CRM.ПолучитьТелефонКлиент(Контрагент));
		EmailКлиента = Renault_CRM.ПолучитьЕмаилКлиент(Контрагент);
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьТелефон(Телефон)
	
	Если Телефон = "" Тогда
		Возврат "";
	КонецЕсли;
	
	// Убираем весь мусор
	ТелефонДляПравки = СтрЗаменить(Телефон, " ", "");
	ТелефонДляПравки = СтрЗаменить(ТелефонДляПравки, "(", "");
	ТелефонДляПравки = СтрЗаменить(ТелефонДляПравки, ")", "");
	ТелефонДляПравки = СтрЗаменить(ТелефонДляПравки, "-", "");
	
	МаскаТелефона = "";
	
	Если ЗначениеЗаполнено(ДилерскийЦентр) И НЕ ПустаяСтрока(ДилерскийЦентр.ПервыйСимволТелефона) Тогда
		МаскаТелефона = ДилерскийЦентр.ПервыйСимволТелефона;
		
		Если СтрДлина(ТелефонДляПравки) = 11 Тогда
			Если СтрНайти(ТелефонДляПравки, "(") = 0 Тогда
				ТелефонДляПравки =  "("+Лев(Прав(ТелефонДляПравки, 10),3)+")"+Сред(Прав(ТелефонДляПравки,10),4, 7);
			Иначе
				ТелефонДляПравки = Прав(ТелефонДляПравки, 10);
			КонецЕсли;
		ИначеЕсли СтрДлина(ТелефонДляПравки) = 10 Тогда
			Если СтрНайти(ТелефонДляПравки, "(") = 0 Тогда
				ТелефонДляПравки =  "("+Лев(ТелефонДляПравки,3)+")"+Сред(ТелефонДляПравки,4, 7);
			КонецЕсли;
		КонецЕсли;
		
		//проверим на наличие первого символа
		Если СтрНайти(ЛЕВ(ТелефонДляПравки, СтрДлина(МаскаТелефона)), МаскаТелефона) = 0 Тогда
			Если СтрНайти(ТелефонДляПравки, "(") = 0 Тогда
				ТелефонДляПравки = МаскаТелефона + "("+ЛЕВ(ТелефонДляПравки,3) +")"+ Сред(ТелефонДляПравки, 4);
			Иначе
				ТелефонДляПравки = МаскаТелефона + Сред(ТелефонДляПравки, СтрНайти(ТелефонДляПравки, "("), СтрДлина(ТелефонДляПравки));
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;

	Возврат ТелефонДляПравки;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьВыборАвто(Контрагент)
	
	МассивАвто = ПолучитьАвтомобилиКлиента(Контрагент);
	
	СписокВыбора = Элементы.ТекущийАвтомобиль.СписокВыбора;
	СписокВыбора.ЗагрузитьЗначения(МассивАвто);
	
	Если СписокВыбора.Количество() = 1 Тогда
		ТекущийАвтомобиль = СписокВыбора[0].Значение;
		ОбновитьАвтомобиль();				
	ИначеЕсли СписокВыбора.Количество() > 1 Тогда
		ОткрытьВыборАвто();		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАвтомобилиКлиента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Автомобили.Автомобиль,
	|	Автомобили.Автомобиль.VIN КАК VIN,
	|	Автомобили.Автомобиль.ГодВыпуска КАК ГодВыпуска,
	|	Автомобили.Автомобиль.Модель КАК Модель
	|ИЗ
	|	РегистрСведений.Автомобили КАК Автомобили
	|ГДЕ
	|	Автомобили.Значение = &Контрагент
	|	И Автомобили.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);	
	
	ТаблицаАвтоКлиента = Запрос.Выполнить().Выгрузить();
	МассивАвто = ТаблицаАвтоКлиента.ВыгрузитьКолонку("Автомобиль");
	Возврат МассивАвто;
	
КонецФункции

&НаСервере
Процедура ОбновитьАвтомобиль()
	
	// Настраиваем поле ввода
	КоличествоАвтомобилейВСпискеВыбора = Элементы.ТекущийАвтомобиль.СписокВыбора.Количество();
	Элементы.ТекущийАвтомобиль.КнопкаСпискаВыбора	= КоличествоАвтомобилейВСпискеВыбора > 1;
	Элементы.ТекущийАвтомобиль.КнопкаВыбора		= КоличествоАвтомобилейВСпискеВыбора = 0;
	Элементы.ТекущийАвтомобиль.КнопкаОткрытия 		= ЗначениеЗаполнено(ТекущийАвтомобиль);
	
	Если Не ЗначениеЗаполнено(ТекущийАвтомобиль) Тогда
		ГосНомер	= "";
		ГодВыпуска	= Неопределено;
		ДатаПродажи	= Неопределено;
		Пробег		= 0;
		Двигатель	= Неопределено;
		КПП			= Неопределено;
		Возврат;
	КонецЕсли;
	
	//ТекущийАвтомобиль = Автомобиль;
	
	VIN			= ТекущийАвтомобиль.VIN;
	Модель		= ТекущийАвтомобиль.Модель;
	Цвет		= ТекущийАвтомобиль.Цвет;	
	ГодВыпуска	= ТекущийАвтомобиль.ГодВыпуска;
	ДатаПродажи	= ТекущийАвтомобиль.ДатаНачалаГарантии;
	
	Элементы.ГодВыпуска.СписокВыбора.НайтиПоЗначению(НачалоГода(ГодВыпуска));
		
	Если НЕ ЗначениеЗаполнено(ТекущийАвтомобиль.ТипДвигателя) Тогда
		Если ЗначениеЗаполнено(ТекущийАвтомобиль.ВариантКомплектации) Тогда
			Двигатель = ТекущийАвтомобиль.ВариантКомплектации.ТипДвигателя;
		Иначе
			Двигатель = ТекущийАвтомобиль.ТипДвигателя;
		КонецЕсли;
	Иначе
		Двигатель = ТекущийАвтомобиль.ТипДвигателя;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущийАвтомобиль.ТипКПП) Тогда
		Если ЗначениеЗаполнено(ТекущийАвтомобиль.ВариантКомплектации) Тогда
			КПП	= ТекущийАвтомобиль.ВариантКомплектации.ТипКПП;
		Иначе
			КПП	= ТекущийАвтомобиль.ТипКПП;
		КонецЕсли;
	Иначе
		КПП	 = ТекущийАвтомобиль.ТипКПП;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Двигатель) ИЛИ Не ЗначениеЗаполнено(КПП) Тогда
		Запись = РегистрыСведений.Renault_АвтомобилиДопРеквизиты.СоздатьМенеджерЗаписи();
		Запись.Автомобиль = ТекущийАвтомобиль;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Двигатель = Запись.КодМоделиДвигателя;
			КПП = Запись.КодМоделиКПП;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ТекущийАвтомобиль) = Тип("СправочникСсылка.Renault_ЧерновикиАвтомобилей") Тогда
		ГосНомер = ТекущийАвтомобиль.ГосНомер;
		Пробег = ТекущийАвтомобиль.Пробег;
	Иначе
		ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ТекущийАвтомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
		Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ТекущийАвтомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
	КонецЕсли;			
		
	Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ОтключитьПредыдущийПробегПриЗаписиНовогоОбращенияСервис Тогда
		Пробег = 0;	
	КонецЕсли;	

	Если ЗначениеЗаполнено(ТекущийАвтомобиль.ВариантКомплектации) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОпцииВариантовКомплектации.Опция,
		|	Renault_ОпцииКондиционера.Опция КАК Опция1
		|ИЗ
		|	РегистрСведений.ОпцииВариантовКомплектации КАК ОпцииВариантовКомплектации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ОпцииКондиционера КАК Renault_ОпцииКондиционера
		|		ПО ОпцииВариантовКомплектации.Опция = Renault_ОпцииКондиционера.Опция
		|ГДЕ
		|	ОпцииВариантовКомплектации.ВариантКомплектации = &ВариантКомплектации";		
		Запрос.УстановитьПараметр("ВариантКомплектации", ТекущийАвтомобиль.ВариантКомплектации);		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда			
			ОпцияКондиционера = Выборка.Опция;			
		КонецЕсли;		
	КонецЕсли;
	
	Если ЭтоАвтомобильРено(ТекущийАвтомобиль) И ЗначениеЗаполнено(VIN) Тогда		
		Элементы.ДекорацияBVM.Видимость = Истина;		
	Иначе		
		Элементы.ДекорацияBVM.Видимость = Ложь;	
	КонецЕсли;
	
	ПрочитатьДопРеквизитыАвто();
	//Если ЗначениеЗаполнено(ТекущийАвтомобиль) Тогда
		СписокРекомендации.Параметры.УстановитьЗначениеПараметра("Автомобиль", ТекущийАвтомобиль);
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыборАвто()
		
	Форма = ПолучитьОбщуюФорму("Renault_АвтомобилиКлиента");
	
	Если Элементы.СтраницыКлиентВладелец.ТекущаяСтраница =
		 Элементы.СтраницаКлиент Тогда		
		Форма.Клиент = Клиент;			
	Иначе			
		Форма.Клиент = ВладелецАвтомобиля;			
	КонецЕсли;
	
	ТекущийАвтомобиль = Форма.ОткрытьМодально();	
	ОбновитьАвтомобиль();
	
КонецПроцедуры

&НаСервере
Функция ЭтоАвтомобильРено(Данные)
	
	Модель = Неопределено;
	
	Если ТипЗнч(Данные) = Тип("СправочникСсылка.Модели") Тогда
		
		Модель = Данные;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникСсылка.Автомобили") Тогда
		
		Модель = Данные.Модель;
	ИначеЕсли ТипЗнч(Данные) = Тип("СправочникСсылка.Renault_ЧерновикиАвтомобилей") Тогда
		Модель = Данные.Модель;
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийАвтомобиль.VIN) Тогда
		
		VIN = ВРЕГ(ТекущийАвтомобиль.VIN);
		
		Если Найти(VIN, "X7L") > 0 ИЛИ Найти(VIN, "VF1") > 0
			ИЛИ Найти(VIN, "VF3") > 0 Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Справочники.CRM_МаркаАвтомобиля.RENAULT.МоделиАвтомобилей.Найти(Модель, "Модель")) Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Процедура ПрочитатьДопРеквизитыАвто()
	
	Если ТипЗнч(ТекущийАвтомобиль) = Тип("СправочникСсылка.Renault_ЧерновикиАвтомобилей") Тогда
		
		Гур = ТекущийАвтомобиль.ГУР;
		СалонныйФильтр = ТекущийАвтомобиль.СалонныйФильтр;
		Кондиционер = ТекущийАвтомобиль.AC;
		TAPV = ТекущийАвтомобиль.СемействоАвтомобиля;
		
		Возврат;
		
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_АвтомобилиДопРеквизиты.СемействоАвтомобиля,
	|	Renault_АвтомобилиДопРеквизиты.СалонныйФильтр,
	|	Renault_АвтомобилиДопРеквизиты.ГУР,
	|	Renault_АвтомобилиДопРеквизиты.AC
	|ИЗ
	|	РегистрСведений.Renault_АвтомобилиДопРеквизиты КАК Renault_АвтомобилиДопРеквизиты
	|ГДЕ
	|	Renault_АвтомобилиДопРеквизиты.Автомобиль = &Автомобиль";
	Запрос.УстановитьПараметр("Автомобиль", ТекущийАвтомобиль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Гур = Выборка.ГУР;
		СалонныйФильтр = Выборка.СалонныйФильтр;
		Кондиционер = Выборка.AC;
		TAPV = Выборка.СемействоАвтомобиля;
		
	Иначе
		
		Гур = Ложь;
		СалонныйФильтр = Ложь;
		Кондиционер = Ложь;
		TAPV = Справочники.Renault_СемействаАвтомобилей.ПустаяСсылка();
		
	КонецЕсли;
	
КонецПроцедуры

