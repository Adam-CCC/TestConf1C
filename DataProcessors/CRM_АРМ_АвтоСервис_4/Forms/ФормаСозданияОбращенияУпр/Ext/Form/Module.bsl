	|	Renault_СертификатКонтроляРаботы.РекомендуемаяДатаВыполнения,
	|	Renault_СертификатКонтроляРаботы.РаботаАктуальна,
	|	Renault_СертификатКонтроляРаботы.Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(Renault_СертификатКонтроля.Дата) КАК Дата,
	|		Renault_СертификатКонтроля.Автомобиль КАК Автомобиль
	|	ИЗ
	|		Документ.Renault_СертификатКонтроля КАК Renault_СертификатКонтроля
	|	ГДЕ
	|		Renault_СертификатКонтроля.Проведен
	|		И Renault_СертификатКонтроля.Автомобиль = &Автомобиль
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Renault_СертификатКонтроля.Автомобиль) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_СертификатКонтроля.Работы КАК Renault_СертификатКонтроляРаботы
	|		ПО ВложенныйЗапрос.Дата = Renault_СертификатКонтроляРаботы.Ссылка.Дата
	|			И ВложенныйЗапрос.Автомобиль = Renault_СертификатКонтроляРаботы.Ссылка.Автомобиль
	|ГДЕ
	|	Renault_СертификатКонтроляРаботы.РаботаАктуальна";
	Запрос.УстановитьПараметр("Автомобиль", ТекущийАвтомобиль);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовСтр = ТабАвтоработы.Добавить();
		НовСтр.Работа = Выборка.Работа;
		//ОчиститьБаллыВСтрокеРаботы(НовСтр);
		Попытка
			Длительность = ПолучитьВремяВыполненияРаботы(Выборка.Работа, ТекущийАвтомобиль.Модель);
			НовСтр.Длительность = Длительность;
			НовСтр.ДлительностьЗН = Длительность;
			ПересчитатьСуммыВСтрокеРабот(НовСтр, НормочасРабот);
		Исключение	
		КонецПопытки;	
	КонецЦикла;	
	
	ПересчитатьСтоимости();
	
	
КонецПроцедуры

