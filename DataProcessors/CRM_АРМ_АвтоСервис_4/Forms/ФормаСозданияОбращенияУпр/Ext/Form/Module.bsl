&НаСервере
Процедура ПеренестиРекомендациюВЗаявкуНаСервере(Работа, Заявка)
	
	Об = Заявка.ПолучитьОбъект();
	НовСтр = Об.Работы.Добавить();
	НовСтр.Работа = Работа;
	НовСтр.Длительность = Работа.ВремяВыполнения;
	Об.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиРекомендациюВЗаявку(Команда)
	
	Данные = Элементы.СписокРекомендации.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Данные.РаботаАктуальна = Ложь Тогда
		Возврат;
	КонецЕсли;
	Авторабота = Данные.Работа;
	СписокЗаявок = Новый СписокЗначений;
	Если СчетчикИнцедентов > 0 Тогда
		СписокЗаявок.Добавить(ЗаявкаНаСервис1.Ссылка);
	КонецЕсли;
	Если СчетчикИнцедентов > 1 Тогда
		СписокЗаявок.Добавить(ЗаявкаНаСервис2.Ссылка);
	КонецЕсли;
	Если СчетчикИнцедентов > 2 Тогда
		СписокЗаявок.Добавить(ЗаявкаНаСервис3.Ссылка);
	КонецЕсли;
	Если СчетчикИнцедентов > 3 Тогда
		СписокЗаявок.Добавить(ЗаявкаНаСервис4.Ссылка);
	КонецЕсли;
	Если СчетчикИнцедентов > 4 Тогда
		СписокЗаявок.Добавить(ЗаявкаНаСервис5.Ссылка);
	КонецЕсли;
	Если СписокЗаявок.Количество() > 1 Тогда
	//ОписаниеОповещенияЗакрытия = Новый ОписаниеОповещения
	//ПоказатьВыборИзСписка(, СписокЗаявок);
		ЗаявкаС = ВыбратьИзСписка(СписокЗаявок);
		Если ЗаявкаС = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если ЗаявкаС.Значение = ЗаявкаНаСервис1.Ссылка Тогда
			Заявка = ЗаявкаНаСервис1;
		ИначеЕсли ЗаявкаС.Значение = ЗаявкаНаСервис2.Ссылка Тогда
			Заявка = ЗаявкаНаСервис2;
		ИначеЕсли ЗаявкаС.Значение = ЗаявкаНаСервис3.Ссылка Тогда
			Заявка = ЗаявкаНаСервис3;
		ИначеЕсли ЗаявкаС.Значение = ЗаявкаНаСервис4.Ссылка Тогда
			Заявка = ЗаявкаНаСервис4;
		ИначеЕсли ЗаявкаС.Значение = ЗаявкаНаСервис5.Ссылка Тогда
			Заявка = ЗаявкаНаСервис5;
		КонецЕсли;
	Иначе
		Заявка = ЗаявкаНаСервис1;
	КонецЕсли;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Автоработы",Заявка.Работы);
	ДопПараметры.Вставить("Материалы",Заявка.Товары);
	ДопПараметры.Вставить("Нормочас",Нормочас1);
	ДопПараметры.Вставить("ВидРемонта",ВидРемонта1);
	ДопПараметры.Вставить("ТипЦен",ТипЦен1);
	
	НоваяСтрока = Заявка.Работы.Добавить();
	НоваяСтрока.Работа = Авторабота;
	ДозаполнитьДанныеПоАвтоработе(НоваяСтрока,ДопПараметры);
	
	//ПеренестиРекомендациюВЗаявкуНаСервере(Работа, Заявка);
	
КонецПроцедуры

