&НаСервере
Процедура ЗаполнитьБонуснуюКарту()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка
	|ИЗ Справочник.Renault_КартыЛояльности
	|ГДЕ Контрагент = &Контрагент
	|	И DMS_ТипКарты = &Тип
	|	И Недействительна = Ложь";
	Запрос.УстановитьПараметр("Контрагент", Клиент);
	Запрос.УстановитьПараметр("Тип", Перечисления.DMS_ТипыКартЛояльности.Бонусная);
	Таб = Запрос.Выполнить().Выгрузить();
	Если Таб.Количество() = 1 Тогда
		БонуснаяКарта = Таб[0].Ссылка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БонуснаяКартаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(БонуснаяКарта) Тогда
		ДанныеПоСкидкамИБаллам = Renault_АвтосервисСкидки.ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту(БонуснаяКарта.Контрагент);
		//ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеПоСкидкамИБаллам, "МаксимумПроцентЗапчасти,МаксимумПроцентРаботы,ОстатокБаллов,ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы");
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеПоСкидкамИБаллам, "ОстатокБаллов,ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы");
		ЧужаяКарта = (БонуснаяКарта.Контрагент <> Клиент);
	//Сергеев В.Н. DMSREN-960 //Если карта не указана то данные по бонусам не заполняем	//DMSREN-959 вернул обратно
	Иначе
		ДанныеПоСкидкамИБаллам = Renault_АвтосервисСкидки.ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту(Клиент);
		//ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеПоСкидкамИБаллам, "БонуснаяКарта,МаксимумПроцентЗапчасти,МаксимумПроцентРаботы,ОстатокБаллов,ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы");
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеПоСкидкамИБаллам, "ОстатокБаллов,ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы");
		ЧужаяКарта = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура БонуснаяКартаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("Контрагент,ТипКарты,Заголовок", 
	Клиент, Перечисления.DMS_ТипыКартЛояльности.Бонусная, "Выберите бонусную карту");
	
	ОткрытьФорму("Справочник.Renault_КартыЛояльности.Форма.ФормаВыбораУправляемая", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура БонуснаяКартаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Renault_КартыЛояльности") Тогда
		
		БонуснаяКарта = ВыбранноеЗначение;	
		
		Если ЗначениеЗаполнено(БонуснаяКарта) Тогда
			ДанныеПоСкидкамИБаллам = Renault_АвтосервисСкидки.ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту(БонуснаяКарта.Контрагент);
			//СписокСвойств = "КартаЛояльностиКлиента,МаксимумПроцентЗапчасти,МаксимумПроцентРаботы,ОстатокБаллов,
			//|ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы";
			СписокСвойств = "КартаЛояльностиКлиента,ОстатокБаллов,
			|ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы";
			ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеПоСкидкамИБаллам, СписокСвойств);
			ЧужаяКарта = (БонуснаяКарта.Контрагент <> Клиент);
		Иначе
			ДанныеПоСкидкамИБаллам = Renault_АвтосервисСкидки.ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту(Клиент);
			//СписокСвойств = "КартаЛояльностиКлиента,БонуснаяКарта,МаксимумПроцентЗапчасти,МаксимумПроцентРаботы,ОстатокБаллов,
			//|ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы";
			СписокСвойств = "КартаЛояльностиКлиента,ОстатокБаллов,
			|ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы,МаксимумБалламиЗапчасти,МаксимумБалламиРаботы";
			ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеПоСкидкамИБаллам, СписокСвойств);
			ЧужаяКарта = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

