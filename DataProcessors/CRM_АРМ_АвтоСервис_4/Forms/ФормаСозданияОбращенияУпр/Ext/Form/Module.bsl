&НаКлиенте
Процедура Запланировать(Команда)
	
	НачатьТранзакцию();
	//ЗаписатьОбращение(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МИНИМУМ(ВремяНачала) КАК ВремяНачала
	|ИЗ Документ.Renault_CRM_ЗаявкаНаСервис
	|ГДЕ Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение", ОбращениеСсылка);
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		ВремяНачала = Выб.ВремяНачала;
		//Уменьшим время начала, т.к. потом оно будет увеличено на эту же величину
		//только уменьшим в 2 раза, потому что идет сдвиг идет все равно...
		ВремяНачала = ВремяНачала - ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
	КонецЕсли;
	
	ДанныеОРаботах = Новый Структура;
	ДанныеОРаботах.Вставить("ДилерскийЦентр", ДилерскийЦентр);
	ДанныеОРаботах.Вставить("Обращение", ОбращениеСсылка);
	ДанныеОРаботах.Вставить("Автор", ПараметрыСеанса.Пользователь);
	ДанныеОРаботах.Вставить("Клиент", Клиент);
	ДанныеОРаботах.Вставить("Владелец", ВладелецАвтомобиля);
	ДанныеОРаботах.Вставить("КлиентОтличаетсяОтВладельца", КлиентОтличаетсяОтВладельца);
	//ДанныеОРаботах.Вставить("ПланироватьРаботу", ПланироватьРаботу И ЗаявкаНаСервис1.Работы.Количество() > 0);
	ДанныеОРаботах.Вставить("ПланироватьРаботу", Истина И ЗаявкаНаСервис1.Работы.Количество() > 0);
	//ДанныеОРаботах.Вставить("ПланироватьПриемкуВыдачу", ПланироватьПриемкуВыдачу);
	ДанныеОРаботах.Вставить("ПланироватьПриемкуВыдачу", Истина);
	ДанныеОРаботах.Вставить("НЕСоздаватьПриемкуВыдачу", Истина);
	ДанныеОРаботах.Вставить("Автоработы", ЗаявкаНаСервис1.Работы);
	ДанныеОРаботах.Вставить("Запчасти", ЗаявкаНаСервис1.Товары);
	ДанныеОРаботах.Вставить("ИсполнительЦех", ИсполнительЦех);
	ДанныеОРаботах.Вставить("ВремяНачала", ВремяНачала);
	ДанныеОРаботах.Вставить("ВтораяЗаявка", ЗаявкаНаСервис2.Работы);
	ДанныеОРаботах.Вставить("ТретьяЗаявка", ЗаявкаНаСервис3.Работы);
	ДанныеОРаботах.Вставить("ЧетвертаяЗаявка", ЗаявкаНаСервис4.Работы);
	ДанныеОРаботах.Вставить("ЗапчастиВторая", ЗаявкаНаСервис2.Товары);
	ДанныеОРаботах.Вставить("ЗапчастиТретья", ЗаявкаНаСервис3.Товары);
