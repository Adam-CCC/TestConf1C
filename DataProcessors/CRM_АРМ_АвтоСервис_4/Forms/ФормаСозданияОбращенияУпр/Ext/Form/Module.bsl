
#Область СобытияФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДилерскийЦентр") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "ДилерскийЦентр, Клиент, КонецРабочегоДня, НачалоРабочегоДня,
									|ОбращениеСпланировано, ТекущийАвтомобиль, ТолькоРаботающие, ОбращениеСсылка,
									|ДлительностьВыдачи, ДлительностьПриемки, ИсполнительЦех, ТекущаяЗаявка");
	Иначе
		Возврат;
	КонецЕсли;
	Если Параметры.Свойство("ЗаявкаНаСервис1") Тогда
		ЗначениеВДанныеФормы(Параметры.ЗаявкаНаСервис1, ЗаявкаНаСервис1);
	КонецЕсли;
	Если Параметры.Свойство("ЗаявкаНаСервис2") Тогда
		ЗначениеВДанныеФормы(Параметры.ЗаявкаНаСервис2, ЗаявкаНаСервис2);
	КонецЕсли;
	Если Параметры.Свойство("ЗаявкаНаСервис3") Тогда
		ЗначениеВДанныеФормы(Параметры.ЗаявкаНаСервис3, ЗаявкаНаСервис3);
	КонецЕсли;
	Если Параметры.Свойство("ЗаявкаНаСервис4") Тогда
		ЗначениеВДанныеФормы(Параметры.ЗаявкаНаСервис4, ЗаявкаНаСервис4);
	КонецЕсли;
	Если Параметры.Свойство("ЗаявкаНаСервис5") Тогда
		ЗначениеВДанныеФормы(Параметры.ЗаявкаНаСервис5, ЗаявкаНаСервис5);
	КонецЕсли;
	
	ЗаполнитьАртикулыПоТаблицеМатериалов();
	
	Если ЗначениеЗаполнено(ОбращениеСсылка) Тогда
		ПриемкаСсылка = Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту("Обращение", ОбращениеСсылка);
		ВыдачаСсылка = Документы.Renault_CRM_ВыдачаАвтомобиля.НайтиПоРеквизиту("Обращение", ОбращениеСсылка);
		Примечание = ОбращениеСсылка.Примечание;
		ВидОбращения = ОбращениеСсылка.ВидОбращения;
		ТипТрафика = ПолучитьТипТрафика(ОбращениеСсылка);
		ВладелецАвтомобиля = ЗаявкаНаСервис1.Плательщик;
		КодыОщущенийСписок.ЗагрузитьЗначения(ОбращениеСсылка.КодыОщущенийКлиента.ВыгрузитьКолонку("КодОщущения"));
	КонецЕсли;
	
	ЗаполнитьСпискиВыбора();
	ЗаполнитьДанныеПоПараметрам();
	ПервичноеЗаполнение();
	УстановитьВидимостьЗаявокНаСервис();
	УстановитьМаскуТелефона();
	ЗаполнениеДанныхПоПервойЗаявке();
	Если ЗначениеЗаполнено(Клиент) Тогда
		ЗаполнитьИсториюКлиента();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьАртикулыПоТаблицеМатериалов()
	
	Для Каждого Стр Из ЗаявкаНаСервис1.Товары Цикл 
		Стр.Артикул = Стр.Номенклатура.Артикул;
	КонецЦикла;
	
	Для Каждого Стр Из ЗаявкаНаСервис2.Товары Цикл 
		Стр.Артикул = Стр.Номенклатура.Артикул;
	КонецЦикла;
	
	Для Каждого Стр Из ЗаявкаНаСервис3.Товары Цикл 
		Стр.Артикул = Стр.Номенклатура.Артикул;
	КонецЦикла;
	
	Для Каждого Стр Из ЗаявкаНаСервис4.Товары Цикл 
		Стр.Артикул = Стр.Номенклатура.Артикул;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЭтаФорма.Модифицированность ИЛИ ЗакрытьПринудительно Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Вопрос(НСтр("ru = 'Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьДокументы() Тогда
			ЭтаФорма.Модифицированность = Ложь;
		Иначе
			Отказ = Истина;
		КонецЕсли;
	ИначеЕсли Ответ = КодВозвратаДиалога.Отмена Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьДокументы()
	
	Если ЗаявкаНаСервис1.Работы.Количество() <> 0 ИЛИ ЗаявкаНаСервис1.Товары.Количество() <> 0 Тогда
		Об = ДанныеФормыВЗначение(ЗаявкаНаСервис1, Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаСервис"));
		Об.Обращение = ОбращениеСсылка;
		Об.Записать();
	КонецЕсли;
	Если ЗаявкаНаСервис2.Работы.Количество() <> 0 ИЛИ ЗаявкаНаСервис2.Товары.Количество() <> 0 Тогда
		Об = ДанныеФормыВЗначение(ЗаявкаНаСервис2, Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаСервис"));
		Если НЕ ЗначениеЗаполнено(Об.Дата) Тогда
			Об.Дата = ТекущаяДата();
		КонецЕсли;
		Об.Обращение = ОбращениеСсылка;
		Об.Записать();
	КонецЕсли;
	Если ЗаявкаНаСервис3.Работы.Количество() <> 0 ИЛИ ЗаявкаНаСервис3.Товары.Количество() <> 0 Тогда
		Об = ДанныеФормыВЗначение(ЗаявкаНаСервис3, Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаСервис"));
		Если НЕ ЗначениеЗаполнено(Об.Дата) Тогда
			Об.Дата = ТекущаяДата();
		КонецЕсли;
		Об.Обращение = ОбращениеСсылка;
		Об.Записать();
	КонецЕсли;
	Если ЗаявкаНаСервис4.Работы.Количество() <> 0 ИЛИ ЗаявкаНаСервис4.Товары.Количество() <> 0 Тогда
		Об = ДанныеФормыВЗначение(ЗаявкаНаСервис4, Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаСервис"));
		Если НЕ ЗначениеЗаполнено(Об.Дата) Тогда
			Об.Дата = ТекущаяДата();
		КонецЕсли;
		Об.Обращение = ОбращениеСсылка;
		Об.Записать();
	КонецЕсли;
	Если ЗаявкаНаСервис5.Работы.Количество() <> 0 ИЛИ ЗаявкаНаСервис5.Товары.Количество() <> 0 Тогда
		Об = ДанныеФормыВЗначение(ЗаявкаНаСервис5, Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаСервис"));
		Если НЕ ЗначениеЗаполнено(Об.Дата) Тогда
			Об.Дата = ТекущаяДата();
		КонецЕсли;
		Об.Обращение = ОбращениеСсылка;
		Об.Записать();
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ТекущийАвтомобиль) Тогда
		ОбновитьАвтомобиль();
	Иначе
		ТекущийАвтомобиль = Неопределено;
		Если ЗначениеЗаполнено(Клиент) Тогда 
			ЗаполнитьВыборАвто(Клиент);
		ИначеЕсли ЗначениеЗаполнено(ВладелецАвтомобиля) Тогда
			ЗаполнитьВыборАвто(ВладелецАвтомобиля);
		КонецЕсли;
	КонецЕсли;
	
	СвернутьРазвернутьГруппыИнцидентов(Неопределено);
	Если ЗначениеЗаполнено(ТекущаяЗаявка) Тогда
		Если ТекущаяЗаявка = ЗаявкаНаСервис1.Ссылка Тогда
			Элементы.ГруппаПерваяЗаявка.Показать();
		ИначеЕсли ТекущаяЗаявка = ЗаявкаНаСервис2.Ссылка Тогда
			Элементы.ГруппаВтораяЗаявка.Показать();
		ИначеЕсли ТекущаяЗаявка = ЗаявкаНаСервис3.Ссылка Тогда
			Элементы.ГруппаТретьяЗаявка.Показать();
		ИначеЕсли ТекущаяЗаявка = ЗаявкаНаСервис4.Ссылка Тогда
			Элементы.ГруппаЧетвертаяЗаявка.Показать();
		ИначеЕсли ТекущаяЗаявка = ЗаявкаНаСервис5.Ссылка Тогда
			Элементы.ГруппаПятаяЗаявка.Показать();
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ОбщаяСтраница.ТекущаяСтраница = Элементы.Инциденты;
	
	Статус1 = " Состояние: " + Строка(ЗаявкаНаСервис1.Ссылка.Состояние);
	Элементы.ГруппаПерваяЗаявка.Заголовок = Элементы.ГруппаПерваяЗаявка.Заголовок + Статус1;
	
	Если ЗначениеЗаполнено(ЗаявкаНаСервис2.Ссылка) Тогда
		Статус2 = " Состояние: " + Строка(ЗаявкаНаСервис2.Ссылка.Состояние);
		Элементы.ГруппаВтораяЗаявка.Заголовок = Элементы.ГруппаВтораяЗаявка.Заголовок + Статус2;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаСервис3.Ссылка) Тогда
		Статус3 = " Состояние: " + Строка(ЗаявкаНаСервис3.Ссылка.Состояние);
		Элементы.ГруппаТретьяЗаявка.Заголовок = Элементы.ГруппаТретьяЗаявка.Заголовок + Статус3;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаСервис4.Ссылка) Тогда
		Статус4 = " Состояние: " + Строка(ЗаявкаНаСервис4.Ссылка.Состояние);
		Элементы.ГруппаЧетвертаяЗаявка.Заголовок = Элементы.ГруппаЧетвертаяЗаявка.Заголовок + Статус4;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаСервис5.Ссылка) Тогда
		Статус5 = " Состояние: " + Строка(ЗаявкаНаСервис5.Ссылка.Состояние);
		Элементы.ГруппаПятаяЗаявка.Заголовок = Элементы.ГруппаПятаяЗаявка.Заголовок + Статус5;
	КонецЕсли;
	
	ЗаполнитьПоКлиенту();
	
	WSHShell = Новый COMОбъект("WScript.Shell");
	WSHShell.SendKeys("%{-}{DOWN}{DOWN}{DOWN}{DOWN}{ENTER}");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеДанныхПоПервойЗаявке()
	
	Если ЗначениеЗаполнено(ЗаявкаНаСервис1.Ссылка) Тогда
		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			Клиент = ЗаявкаНаСервис1.Клиент;
		КонецЕсли; 
		
		ВладелецАвтомобиля = ЗаявкаНаСервис1.Плательщик;
		Если ЗначениеЗаполнено(ВладелецАвтомобиля) И ЗначениеЗаполнено(Клиент) И ВладелецАвтомобиля <> Клиент Тогда
			КлиентОтличаетсяОтВладельца = Истина;
		КонецЕсли; 
		
		Если ЗаявкаНаСервис1.ДополнительноеОборудование.Количество() > 0 Тогда
			Элементы.ДополнительноеОборудование.Видимость = Истина;
			//Доделать
			//Для каждого ТекСтрока Из ЗаявкаНаСервис1.ДополнительноеОборудование Цикл
			//	НовСтрока = ТаблицаДопОборудование.Добавить();
			//	ЗаполнитьЗначенияСвойств(НовСтрока, ТекСтрока);
			//КонецЦикла; 
		КонецЕсли; 
	КонецЕсли; 

	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсториюКлиента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КритерийОтбораКонтрагенты.Документ КАК Событие,
	|	КритерийОтбораКонтрагенты.Дата КАК Дата,
	//|	КритерийОтбораКонтрагенты.ХозОперация КАК ХозОперация,
	//|	КритерийОтбораКонтрагенты.СуммаДокумента КАК СуммаДокумента,
	//|	КритерийОтбораКонтрагенты.ВалютаДокумента КАК ВалютаДокумента,
	//|	КритерийОтбораКонтрагенты.ДанныеКартинки КАК ДанныеКартинки,
	|	ВЫБОР
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_CRM_ПриемкаАвтомобиля ТОГДА
	|			""ПриемкаАвтомобиля""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_CRM_ЗаявкаНаСервис ТОГДА
	|			""ЗаявкаНаСервис""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_CRM_ВыдачаАвтомобиля ТОГДА
	|			""ВыдачаАвтомобиля""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_CRM_ОбращениеВАвтоСервис ТОГДА
	|			""ОбращениеВАвтоСервис""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_КонтактСКлиентом ТОГДА
	|			""КонтактСКлиентом""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_СертификатКонтроля ТОГДА
	|			""СертификатКонтроля""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_СтраховойПолис ТОГДА
	|			""СтраховойПолис""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.ЗаказНаряд ТОГДА
	|			""ЗаказНаряд""
	|		КОГДА КритерийОтбораКонтрагенты.Документ ССЫЛКА Документ.Renault_CommunicationCenter_Обзвон ТОГДА
	|			""Обзвон""
	|		ИНАЧЕ ""Прочее""
	|	КОНЕЦ КАК ВидСобытия
	|ИЗ
	|	(ВЫБРАТЬ
	|		Контрагенты.Ссылка КАК Документ,
	|		Контрагенты.Ссылка.Дата КАК Дата,
	|		Контрагенты.Ссылка.ХозОперация КАК ХозОперация,
	|		Контрагенты.Ссылка.СуммаДокумента КАК СуммаДокумента,
	|		Контрагенты.Ссылка.ВалютаДокумента КАК ВалютаДокумента,
	|		ВЫБОР
	|			КОГДА Контрагенты.Ссылка.ПометкаУдаления
	|				ТОГДА 3
	|			ИНАЧЕ ВЫБОР
	|					КОГДА Контрагенты.Ссылка.Проведен
	|						ТОГДА 1
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ КАК ДанныеКартинки
	|	ИЗ
	|		КритерийОтбора.Renault_Контрагенты(&Контрагент) КАК Контрагенты) КАК КритерийОтбораКонтрагенты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|ИТОГИ ПО ВидСобытия";
	Запрос.УстановитьПараметр("Контрагент", Клиент);
	ВыборкаВидыСобытий = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДеревоСобытий = Новый ДеревоЗначений;
	ДеревоСобытий.Колонки.Добавить("Событие");
	ДеревоСобытий.Колонки.Добавить("Дата");
	ДеревоСобытий.Колонки.Добавить("ВидСобытия");
	
	Пока ВыборкаВидыСобытий.Следующий() Цикл
		
		СтрокаВидСобытия = ДеревоСобытий.Строки.Добавить();
		СтрокаВидСобытия.ВидСобытия = ВыборкаВидыСобытий.ВидСобытия;
		
		Выборка = ВыборкаВидыСобытий.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаДерева = СтрокаВидСобытия.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоСобытий, "ИсторияКлиента");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбора()
	
	Выборка = ПолучитьВидыОбращений(); //Справочники.Renault_ВидыОбращенийВАвтосервис.Выбрать(,,Отбор);
	
	Пока Выборка.Следующий() Цикл
		Элементы.ВидОбращения.СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Выборка = Справочники.ВидыРемонта.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Элементы.ВидРемонта1.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.ВидРемонта2.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.ВидРемонта3.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.ВидРемонта4.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.ВидРемонта5.СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Выборка = Справочники.Нормочасы.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Элементы.Нормочас1.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.Нормочас2.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.Нормочас3.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.Нормочас4.СписокВыбора.Добавить(Выборка.Ссылка);
		Элементы.Нормочас5.СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Выборка = Справочники.CRM_ТипТрафика.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Элементы.ТипТрафика.СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	ЗаполнитьСписокГодовВыпуска();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВидыОбращений()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Renault_ВидыОбращенийВАвтосервис.Ссылка
	|ИЗ
	|	Справочник.Renault_ВидыОбращенийВАвтосервис КАК Renault_ВидыОбращенийВАвтосервис
	|ГДЕ
	|	Renault_ВидыОбращенийВАвтосервис.НеОтображать = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_ВидыОбращенийВАвтосервис.Наименование";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

&НаСервере
Функция ПолучитьТипТрафика(Обращение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_ТрафикСрезПоследних.ТипТрафика,
	|	Renault_ТрафикСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.Renault_Трафик.СрезПоследних(, Идентификатор = &Идентификатор) КАК Renault_ТрафикСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("Идентификатор", Обращение.ИдентификаторТрафика);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ТипТрафика;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокГодовВыпуска()
	
	НачальнаяДата = Дата("19890101000000");
	
	КонечнаяДата = НачалоГода(ТекущаяДата());
	
	Пока НачальнаяДата <= КонечнаяДата Цикл		
		Элементы.ГодВыпуска.СписокВыбора.Добавить(НачальнаяДата, Формат(НачалоГода(НачальнаяДата), "ДФ=yyyy"));		
		НачальнаяДата = ДобавитьМесяц(НачальнаяДата, 12);		
	КонецЦикла;
	
	Элементы.ГодВыпуска.СписокВыбора.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	
КонецПроцедуры

