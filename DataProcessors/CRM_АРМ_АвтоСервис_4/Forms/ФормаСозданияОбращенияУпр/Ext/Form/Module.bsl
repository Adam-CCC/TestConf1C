&НаКлиенте
Процедура ДобавитьМатериалВСписок(Номенклатура, Количество = 1, ДопПараметры) 
	
	ТекТаблицаАвторабот  = ДопПараметры.Автоработы;
	ТекТаблицаМатериалов = ДопПараметры.Материалы;
	ТекНормочас			 = ДопПараметры.Нормочас;
	ТекВидРемонта		 = ДопПараметры.ВидРемонта;
	ТекТипЦен			 = ДопПараметры.ТипЦен;
	
	Если ДилерскийЦентр.Автосервис_ГруппироватьТовары = Истина Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура",Номенклатура);
		МассивДублей = ТекТаблицаМатериалов.НайтиСтроки(Отбор);
		
		Если МассивДублей.Количество() > 0 Тогда 	
			СуществующаяСтрока = МассивДублей[0];
			НоваяСтрока = СуществующаяСтрока;
			НоваяСтрока.Количество = СуществующаяСтрока.Количество + Количество;
		Иначе
			НоваяСтрока = ТекТаблицаМатериалов.Добавить();
			НоваяСтрока.Артикул = Номенклатура.Артикул;
			НоваяСтрока.Номенклатура = Номенклатура;
			НоваяСтрока.Количество = Количество;
		КонецЕсли;
		
		НоваяСтрока.Цена = ПолучитьЦену(НоваяСтрока.Номенклатура, ТекТипЦен, ?(ДилерскийЦентр.ТиповойМеханизмРасчетаЦен,Истина,Ложь));
		
		Если ЗначениеЗаполнено(НоваяСтрока.Цена) И ЗначениеЗаполнено(НоваяСтрока.Количество) И ЗначениеЗаполнено(НоваяСтрока.ПроцентСкидки) Тогда
			НоваяСтрока.Сумма   = НоваяСтрока.Цена * НоваяСтрока.Количество * (1 - НоваяСтрока.ПроцентСкидки / 100);
			НоваяСтрока.СуммаСкидки = НоваяСтрока.Цена * НоваяСтрока.Количество * (НоваяСтрока.ПроцентСкидки) / 100;
		Иначе
			НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
		КонецЕсли;
	
	Иначе
		НоваяСтрока = ТекТаблицаМатериалов.Добавить();
		НоваяСтрока.Артикул = Номенклатура.Артикул;
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Количество = Количество;
		НоваяСтрока.Цена = ПолучитьЦену(НоваяСтрока.Номенклатура, ТекТипЦен, ?(ДилерскийЦентр.ТиповойМеханизмРасчетаЦен,Истина,Ложь));
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвтоработыИзВременногоХранилища(АдресХранилища, ДопПараметры)
	
	мТаблицаАвторабот = ПолучитьИзВременногоХранилища(АдресХранилища);	
	
	ТаблицаАвтоработы = ДопПараметры.Автоработы;
	Для каждого ТекущаяСтрока Из мТаблицаАвторабот Цикл
		
		НоваяСтрока = ТаблицаАвтоработы.Добавить();
		
		НоваяСтрока.Работа 	  	   = ТекущаяСтрока.Авторабота;
		НоваяСтрока.Нормочас  	   = ТекущаяСтрока.Нормочас;
		НоваяСтрока.Цена	   	   = ТекущаяСтрока.Цена;
		НоваяСтрока.ДлительностьЗН = ТекущаяСтрока.ВремяВыполнения * ТекущаяСтрока.Количество;
		НоваяСтрока.Длительность   = НоваяСтрока.ДлительностьЗН;
		НоваяСтрока.Коэффициент    = 1;
		НоваяСтрока.Сумма		   = ТекущаяСтрока.Цена * НоваяСтрока.ДлительностьЗН;
		
		//ПересчитатьСтоимостьРаботыСтроки(НоваяСтрока);
		
	КонецЦикла; 
	
	ПересчитатьСтоимости();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьАвтоработуВСписок(Авторабота, ЗаполнятьСвРаботами, ДопПараметры)
	
	ТекТаблицаАвторабот  = ДопПараметры.Автоработы;
	ТекТаблицаМатериалов = ДопПараметры.Материалы;
	ТекНормочас			 = ДопПараметры.Нормочас;
	ТекВидРемонта		 = ДопПараметры.ВидРемонта;
	ТекТипЦен			 = ДопПараметры.ТипЦен;
	
	Если ТипЗнч(Авторабота) = Тип("Строка") Тогда
		Ответ = Справочники.Автоработы.ПолучитьФормуВыбора().ОткрытьМодально(); 	
	ИначеЕсли ТипЗнч(Авторабота) = Тип("СправочникСсылка.Автоработы") Тогда
		Ответ = Авторабота;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат;
	КонецЕсли;
	
	РаботаМойки = ЗначениеЗаполнено(Справочники.Renault_РаботыМойки.НайтиПоРеквизиту("АвтоРабота", Ответ));
	
	НоваяСтрока = ТекТаблицаАвторабот.Добавить();
	НоваяСтрока.Работа = Ответ;
	НоваяСтрока.Длительность = ПолучитьВремяВыполненияРаботы(Ответ, ТекущийАвтомобиль.Модель);
	НоваяСтрока.Коэффициент = ПолучитьКоэффициентСложностиРаботы(НоваяСтрока.Работа, ТекВидРемонта);
	
	ИспользоватьТиповойМеханизмРасчетаЦеныВЗаявке = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьТиповойМеханизмРасчетаЦеныВЗаявке;
	
	Если ИспользоватьТиповойМеханизмРасчетаЦеныВЗаявке Тогда// И НЕ РаботаМойки Тогда //-- Добавил "И НЕ РаботаМойки", почему то, по мойке было просто расчет, может и типовой отработал бы, не проверял.  
		ДанныеЦены = орПолучитьЦенуАвтоработы(ТекТипЦен, Ответ, ТекущийАвтомобиль.Модель, 
		Renault_АвтосервисОбщий.DMS_НайтиСоздатьДоговорНовый(Клиент),
		ДилерскийЦентр.Автосервис_ЦехЗаказНарядПоУмолчанию, 
		ТекВидРемонта, ТекущаяДата() , ТекТипЦен.ВалютаЦены, 1);
		ДанныеЦены.Вставить("ВремяВыполнения", ДанныеЦены.НормаВремени);
		ДанныеЦены.Вставить("Нормочас", ТекНормочас);
	Иначе
		ДанныеЦены = ПолучитьЦенуРаботы(Ответ, ТекВидРемонта);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЦены) И ЗаполнятьСвРаботами Тогда
		
		НоваяСтрока.Сумма = ДанныеЦены.Цена;
		
		Если Не ЗначениеЗаполнено(ДанныеЦены.Нормочас) Тогда
			Если Ответ.ВремяВыполнения > 0 Тогда
				НоваяСтрока.Цена     = НоваяСтрока.Сумма / Ответ.ВремяВыполнения;
				НоваяСтрока.Нормочас = ТекНормочас;
			КонецЕсли;
		Иначе
			НоваяСтрока.Нормочас = ДанныеЦены.Нормочас;
			НоваяСтрока.Цена     = ДанныеЦены.Нормочас.Цена;
			
			Если ИспользоватьТиповойМеханизмРасчетаЦеныВЗаявке Тогда
				НоваяСтрока.Нормочас  = ДанныеЦены.Нормочас; 
				НоваяСтрока.Сумма = ДанныеЦены.Цена * ДанныеЦены.ВремяВыполнения;
			КонецЕсли;
		КонецЕсли;
	Иначе
		НоваяСтрока.Цена = ТекНормочас.Цена;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НоваяСтрока.Нормочас) Тогда
		НоваяСтрока.Нормочас = ТекНормочас;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоваяСтрока.Длительность) И НЕ ЗначениеЗаполнено(НоваяСтрока.Сумма) Тогда
		Если Не ЗначениеЗаполнено(НоваяСтрока.НормоЧас) Тогда
			НоваяСтрока.Цена = ТекНормочас.Цена;
		Иначе
			НоваяСтрока.Цена = НоваяСтрока.НормоЧас.Цена
		КонецЕсли;
		
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Длительность;
	КонецЕсли;
	
	НоваяСтрока.ДлительностьЗН = ПолучитьВремяВыполненияРаботы(Ответ, ТекущийАвтомобиль.Модель);
	
	///++ добавление Зеленчук 20180314. Установка скидки при добавлении работы. По запросу Михаила Молчанова
	//-- Временно скидки убраны
	//Если СкидкаРаботы > 0 И Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].АвтоматическиеСкидкиВЗаявкеНаСервис Тогда			
	//	Если НоваяСтрока.ПроцентСкидки <> СкидкаРаботы Тогда
	//		НоваяСтрока.ПроцентСкидки = СкидкаРаботы;						
	//	КонецЕсли;			
	//КонецЕсли;
	
	Если РаботаМойки Тогда //-- почему то, по мойке было так, может и следующий вариант был бы норм. не проверял.
		НоваяСтрока.Сумма = НоваяСтрока.Сумма * НоваяСтрока.Коэффициент; 
	Иначе
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.ДлительностьЗН * НоваяСтрока.Коэффициент * (100 - НоваяСтрока.ПроцентСкидки) / 100;
	КонецЕсли;
	
	НоваяСтрока.СуммаСкидки = НоваяСтрока.Цена * НоваяСтрока.ДлительностьЗН * НоваяСтрока.Коэффициент * (НоваяСтрока.ПроцентСкидки) / 100;
	//НоваяСтрока.Сумма = НоваяСтрока.Сумма * НоваяСтрока.Коэффициент;
	//-- добавление Зеленчук 20180314. Установка скидки при добавлении работы. По запросу Михаила Молчанова
	
	Повтор = ПроверитьПовторениеРабот(ТекущийАвтомобиль, Ответ, Клиент); 
	
	Попытка
		Свойство = обПолучитьЗначениеСвойства(Ответ, ПланыВидовХарактеристик.СвойстваОбъектов._ПризнакКомплекса);
		
		Если Свойство Тогда
			Если ДилерскийЦентр.Автосервис_ИспользуетсяВерсия4 = Истина ТОГДА
				Форма = Обработки.CRM_АРМ_АвтоСервис_4.Создать().ПолучитьФорму("ФормаПриемникСвязанныхРабот");  
			Иначе
				Форма = Обработки.CRM_АРМ_АвтоСервис_2.Создать().ПолучитьФорму("ФормаПриемникСвязанныхРабот");
			КонецЕсли;
			
			Форма.ОбработкаОбъект = ПолучитьОбъектПустогоЗаказНаряда(ТекущийАвтомобиль,Клиент); 
			ФормаВыбора = Обработки.ПодборРабот.ПолучитьФорму("ФормаПодбораСвязанныхРабот", Форма);
			ФормаВыбора.ЗапускИзАРМ = Истина;
			ФормаВыбора.НачальноеЗначениеВыбора = Ответ;
			ФормаВыбора.РежимВыбора = Истина;
			ФормаВыбора.ОткрытьМодально();
			
			ДопРаботы = Форма.Работы;
			
			Если ДопРаботы.Количество() > 0 Тогда
				Для Каждого Работа из ДопРаботы Цикл
					НоваяСтрока = ТекТаблицаАвторабот.Добавить();
					НоваяСтрока.Работа = Работа.Работа;
					
					ДанныеЦены = ПолучитьЦенуРаботы(Работа.Работа, ТекВидРемонта);
					
					ТекСтоимость = ДанныеЦены.Цена;
					
					НоваяСтрока.Сумма = ТекСтоимость;
					НоваяСтрока.Нормочас = ДанныеЦены.Нормочас;
					
					Если НЕ ЗначениеЗаполнено(НоваяСтрока.Нормочас) Тогда
						НоваяСтрока.Цена = ТекСтоимость/Работа.Работа.ВремяВыполнения;
					Иначе
						НоваяСтрока.Цена = НоваяСтрока.Нормочас.Цена;
					КонецЕсли;
					
					НоваяСтрока.Длительность = Работа.Работа.ВремяВыполнения;
					новаяСтрока.ДлительностьЗН = Работа.Работа.ВремяВыполнения;
					
					Повтор = ПроверитьПовторениеРабот(ТекущийАвтомобиль, Работа.Работа, Клиент); 
				КонецЦикла;
				
			КонецЕсли;
			
			ДопТовары = Форма.Товары;
			
			Если ДопТовары.Количество() > 0 Тогда
				Для Каждого Товар из ДопТовары Цикл
					Если ДилерскийЦентр.Автосервис_ГруппироватьТовары = Истина Тогда
						СуществующаяСтрока = ТекТаблицаМатериалов.Найти(Товар.Номенклатура, "Номенклатура");
						
						Если ЗначениеЗаполнено(СуществующаяСтрока) Тогда
							НоваяСтрока = СуществующаяСтрока;
							НоваяСтрока.Количество = СуществующаяСтрока.Количество + Товар.Количество;
						Иначе
							НоваяСтрока = ТекТаблицаМатериалов.Добавить(); 
							НоваяСтрока.Артикул = Товар.Номенклатура.Артикул;
							НоваяСтрока.Номенклатура = Товар.Номенклатура;
							НоваяСтрока.Количество = Товар.Количество;
						КонецЕсли;
						
						НоваяСтрока.Скидка = 0;
						НоваяСтрока.Цена = ПолучитьЦену(Товар.Номенклатура, ТекТипЦен);
						НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество * (1 - НоваяСтрока.ПроцентСкидки / 100);
					Иначе
						НоваяСтрока = ТекТаблицаМатериалов.Добавить(); 
						НоваяСтрока.Артикул = Товар.Номенклатура.Артикул;
						НоваяСтрока.Номенклатура = Товар.Номенклатура;
						НоваяСтрока.Количество = Товар.Количество;
						НоваяСтрока.Скидка = 0;
						НоваяСтрока.Цена = ПолучитьЦену(Товар.Номенклатура, ТекТипЦен);
						НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество * (1 - НоваяСтрока.ПроцентСкидки / 100);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
	Исключение
		//Сообщить(ОписаниеОшибки());
		//возврат;
	КонецПопытки;
	
	Если ЗаполнятьСвРаботами Тогда
		СвязаныеРаботы = РегистрыСведений.СвязанныеРаботы.СоздатьНаборЗаписей();
		СвязаныеРаботы.Отбор.Авторабота.Значение = Ответ.Ссылка;
		СвязаныеРаботы.Отбор.Авторабота.Использование = Истина;
		
		СвязаныеРаботы.Прочитать();
		
		Если НЕ ЗначениеЗаполнено(СвязаныеРаботы) Тогда
			Возврат;
		КонецЕсли;
		
		//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
		Если ДилерскийЦентр.Автосервис_ИспользуетсяВерсия4 = Истина ТОГДА
			Форма = Обработки.CRM_АРМ_АвтоСервис_4.ПолучитьФорму("ФормаПриемникСвязанныхРабот"); 
		Иначе
			Форма = Обработки.CRM_АРМ_АвтоСервис_2.ПолучитьФорму("ФормаПриемникСвязанныхРабот");
		КонецЕсли;				
		//Иначе
		//	Форма = Обработки.CRM_АРМ_АвтоСервис_2.ПолучитьФорму("ФормаПриемникСвязанныхРабот_AA4");
		//КонецЕсли;
		
		Форма.ОбработкаОбъект = ПолучитьОбъектПустогоЗаказНаряда(ТекущийАвтомобиль,Клиент);  
		ФормаВыбора = Обработки.ПодборРабот.ПолучитьФорму("ФормаПодбораСвязанныхРабот",Форма); 
		
		//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
		ФормаВыбора.ЗапускИзАРМ = Истина;
		//КонецЕсли;
		
		ФормаВыбора.НачальноеЗначениеВыбора=Ответ;
		ФормаВыбора.РежимВыбора=Истина;
		
		Попытка
			ФормаВыбора.КодРено = Истина;
		Исключение
		КонецПопытки;
		
		Попытка
			ФормаВыбора.ЗапрашиватьКоличество = ЛОЖЬ;
		Исключение
		КонецПопытки;
		
		ФормаВыбора.ОткрытьМодально();
		
		ДопРаботы = Форма.Работы;
		
		Если ДопРаботы.Количество() > 0 Тогда
			Для Каждого Работа из ДопРаботы Цикл
				НоваяСтрока = ТекТаблицаАвторабот.Добавить();
				НоваяСтрока.Работа = Работа.Работа;
				
				ДанныеЦены = ПолучитьЦенуРаботы(Работа.Работа, ТекВидРемонта);
				ВремяВыполнения = ПолучитьВремяВыполненияРаботы(Работа.Работа, ТекущийАвтомобиль.Модель);
				НоваяСтрока.Коэффициент = ПолучитьКоэффициентСложностиРаботы(НоваяСтрока.Работа, ТекВидРемонта);
				
				Если ЗначениеЗаполнено(ДанныеЦены) Тогда
					НоваяСтрока.Сумма = ДанныеЦены.Цена;
					
					Если ЗначениеЗаполнено(ДанныеЦены.Нормочас) Тогда
						НоваяСтрока.Нормочас = ДанныеЦены.Нормочас;
						Новаястрока.Цена = ДанныеЦены.Нормочас.Цена;
					Иначе
						НоваяСтрока.Нормочас = ТекНормочас;
						НоваяСтрока.Цена = НоваяСтрока.Сумма/ВремяВыполнения;
					КонецЕсли;
					
					НоваяСтрока.Цена = ДанныеЦены.Нормочас.Цена;
				КонецЕсли;
				
				НоваяСтрока.Длительность = ВремяВыполнения;
				НоваяСтрока.ДлительностьЗН = ВремяВыполнения;
				
				Повтор = ПроверитьПовторениеРабот(ТекущийАвтомобиль,  Работа.Работа, Клиент); 
			КонецЦикла;
		КонецЕсли;
		
		ДопТовары = Форма.Товары;
		
		Если ДопТовары.Количество() > 0 Тогда
			Для Каждого Товар из ДопТовары Цикл
				Если ДилерскийЦентр.Автосервис_ГруппироватьТовары = Истина Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Номенклатура",Товар.Номенклатура);
					МассивДублей = ТекТаблицаМатериалов.НайтиСтроки(Отбор);
					
					Если МассивДублей.Количество()>0 Тогда
						СуществующаяСтрока = МассивДублей[0];
						НоваяСтрока = СуществующаяСтрока;
						НоваяСтрока.Количество = СуществующаяСтрока.Количество + Товар.Количество;
					Иначе
						НоваяСтрока = ТекТаблицаМатериалов.Добавить();
						НоваяСтрока.Артикул = Товар.Номенклатура.Артикул;
						НоваяСтрока.Номенклатура = Товар.Номенклатура;
						НоваяСтрока.Количество = Товар.Количество;
					КонецЕсли;
					
					НоваяСтрока.Скидка = 0;
					НоваяСтрока.Цена = ПолучитьЦену(Товар.Номенклатура, ТекТипЦен);
					НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество * (1 - НоваяСтрока.ПроцентСкидки / 100);
				Иначе
					НоваяСтрока = ТекТаблицаМатериалов.Добавить();
					НоваяСтрока.Артикул = Товар.Номенклатура.Артикул;
					НоваяСтрока.Номенклатура = Товар.Номенклатура;
					НоваяСтрока.Количество = Товар.Количество;
					НоваяСтрока.Скидка = 0;
					НоваяСтрока.Цена = ПолучитьЦену(Товар.Номенклатура, ТекТипЦен);
					НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество * (1 - НоваяСтрока.ПроцентСкидки / 100);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если Повтор <> Неопределено Тогда
		//Если Повтор Тогда
		//	Вопрос("Внимание! Обнаружено повторение недавно выполненных работ!" + Символы.ПС + Ответ, РежимДиалогаВопрос.ОК);
		//КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВремяВыполненияРаботы(Авторабота, Модель)
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	АвтоработыНормыВремени.ВремяВыполнения
	|ИЗ
	|	Справочник.Автоработы.НормыВремени КАК АвтоработыНормыВремени
	|ГДЕ
	|	АвтоработыНормыВремени.Ссылка = &Авторабота
	|	И АвтоработыНормыВремени.Модель = &Модель";
	
	Запрос.УстановитьПараметр("Авторабота", Авторабота);
	Запрос.УстановитьПараметр("Модель", Модель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВремяВыполнения;
	Иначе
		Возврат Авторабота.ВремяВыполнения;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеИзменениеВидРемонтаОбщая(Результат,ДопПараметры) Экспорт 
	
	Если Результат <> КодВозвратаДиалога.Да Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[ДопПараметры.Нормочас] = ПолучитьНормочасПоВидуРемонта(ДопПараметры.ВидРемонта,ТекущийАвтомобиль.Модель);
	Выполнить(ДопПараметры.ПроцедураИзменения);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНормочасПоВидуРемонта(ВидРемонта,Модель)
	
	Нормочас = Неопределено;

	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	|	ЦеныАвтоработСрезПоследних.Нормочас КАК Нормочас
	|ИЗ
	|	РегистрСведений.ЦеныАвторабот.СрезПоследних КАК ЦеныАвтоработСрезПоследних
	|ГДЕ
	|	ЦеныАвтоработСрезПоследних.Модель = &Модель
	|	И ЦеныАвтоработСрезПоследних.ВидРемонта = &ВидРемонта";
	
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ВидРемонта", ВидРемонта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Нормочас = Выборка.Нормочас;
	Иначе
		Поиск = РегистрыСведений.ЦеныАвторабот.СрезПоследних().Найти(ВидРемонта, "ВидРемонта");
		Если Поиск <> Неопределено Тогда
			Если ЗначениеЗаполнено(Поиск.Нормочас) Тогда
				Нормочас = Поиск.Нормочас;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Нормочас;
	
КонецФункции

&НаКлиенте
Процедура УстановитьНормочасВРаботах(ТаблицаРаботы, НормочасРаботы)
	
	Для Каждого ТекСтрока Из ТаблицаРаботы Цикл	
		ПересчитатьСуммыВСтрокеРабот(ТекСтрока, НормочасРаботы);	
	КонецЦикла;
	
	ПересчитатьСтоимости();
	
КонецПроцедуры 

&НаКлиенте
Процедура ПересчитатьСуммыВСтрокеРабот(СтрокаТаблицы, НормочасРаботы)
	
	//Сергеев В.Н. DMSREN-959
	Если ЗначениеЗаполнено(НормочасРаботы) И Не СтрокаТаблицы.ЭтоКомплексСервис Тогда	 
		СтрокаТаблицы.Цена = НормочасРаботы.Цена;
		СтрокаТаблицы.Нормочас = НормочасРаботы;		
	КонецЕсли;
	
	СтоимостьБезСкидок = СтрокаТаблицы.Цена * СтрокаТаблицы.ДлительностьЗН * СтрокаТаблицы.Коэффициент;
	СтрокаТаблицы.Сумма = СтоимостьБезСкидок * (100 - СтрокаТаблицы.ПроцентСкидки) / 100;
	СтрокаТаблицы.СуммаСкидки = СтоимостьБезСкидок * (СтрокаТаблицы.ПроцентСкидки) / 100;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоэффициентСложностиРаботы(Авторабота, ВидРемонта = Неопределено)
	
	Если ЗначениеЗаполнено(ВидРемонта) Тогда
		
		Гарантия = РегистрыСведений.Renault_ВидыРемонтаДопРеквизиты.ПолучитьГарантиюЗавода(ВидРемонта);
		
		Если Гарантия = Истина Тогда
			
			Возврат 1;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Коэффициент = 1;
	
	Если НЕ ЗначениеЗаполнено(Авторабота.Артикул) Тогда
		Возврат Коэффициент;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Справочник.Коэффициент
	|ИЗ
	|	РегистрСведений.OPERACODE_НормыРабот.СрезПоследних(&Период, КодПоКаталогу = &Артикул) КАК OPERACODE_НормыРаботСрезПоследних
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_КоэффициентыСложностиРабот КАК Справочник
	|ПО Справочник.СложностьРабот = OPERACODE_НормыРаботСрезПоследних.СложностьРабот";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Артикул", Авторабота.Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Коэффициент = Выборка.Коэффициент;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Коэффициент) Тогда
		
		Возврат Коэффициент;
		
	Иначе
		
		Возврат 1;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ДозаполнитьДанныеПоАвтоработе(ТекущиеДанные, ДопПараметры)
	
	ТекТаблицаАвторабот 	= ДопПараметры.Автоработы;
	ТекТаблицаМатериалов	= ДопПараметры.Материалы;
	ТекНормочас				= ДопПараметры.Нормочас;
	ТекВидРемонта			= ДопПараметры.ВидРемонта;
	ТекТипЦен				= ДопПараметры.ТипЦен;
	
	
	ТекущиеДанные.Длительность		= ПолучитьВремяВыполненияРаботы(ТекущиеДанные.Работа, ТекущийАвтомобиль.Модель);
	ТекущиеДанные.ДлительностьЗН	= ТекущиеДанные.Длительность;
	ТекущиеДанные.Коэффициент		= ПолучитьКоэффициентСложностиРаботы(ТекущиеДанные.Работа, ТекВидРемонта);
	
	ДанныеЦены = ПолучитьЦенуРаботы(ТекущиеДанные.Работа, ТекВидРемонта);
	
	
	Если ЗначениеЗаполнено(ДанныеЦены) Тогда
		ТекущиеДанные.Нормочас = ТекНормочас;//ДанныеЦены.Нормочас;
		Если ЗначениеЗаполнено(ТекущиеДанные.Нормочас) Тогда
			ТекущиеДанные.Цена = ТекущиеДанные.Нормочас.Цена;
		Иначе
			ТекущиеДанные.Цена = ТекНормочас.Цена;		
		КонецЕсли;
		ПересчитатьСуммыВСтрокеРабот(ТекущиеДанные, ТекущиеДанные.Нормочас)
	Иначе
		// Считаем по выбранному нормочасу
		ПересчитатьСуммыВСтрокеРабот(ТекущиеДанные, ТекНормочас);
	КонецЕсли;	
	
	ЗаполнитьСвязаннымиРаботами(ТекущиеДанные,ТекТаблицаАвторабот,ТекТаблицаМатериалов,ТекНормочас,ТекВидРемонта,ТекТипЦен);	
	ПересчитатьСтоимости();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСвязаннымиРаботами(ТекущиеДанные,ТекТаблицаАвторабот,ТекТаблицаМатериалов,ТекНормочас,ТекВидРемонта,ТекТипЦен)
	
	Форма 								= Обработки.CRM_АРМ_АвтоСервис_4.ПолучитьФорму("ФормаПриемникСвязанныхРабот");
	Форма.ОбработкаОбъект				= Документы.ЗаказНаряд.СоздатьДокумент();
	ФормаВыбора							= Обработки.ПодборРабот.ПолучитьФорму("ФормаПодбораСвязанныхРабот", Форма);
	ФормаВыбора.ЗапускИзАРМ				= Истина;
	ФормаВыбора.НачальноеЗначениеВыбора = ТекущиеДанные.Работа;
	ФормаВыбора.РежимВыбора				= Истина;
	ФормаВыбора.ОткрытьМодально();
	
	ДопРаботы = Форма.Работы;	
	Для Каждого ТекСтрокаРабота Из ДопРаботы Цикл
		НоваяСтрока = ТекТаблицаАвторабот.Добавить();
		НоваяСтрока.Работа = ТекСтрокаРабота.Работа;	
		НоваяСтрока.Длительность = ТекСтрокаРабота.Работа.ВремяВыполнения;
		НоваяСтрока.ДлительностьЗН = НоваяСтрока.Длительность;
		
		ДанныеЦены = ПолучитьЦенуРаботы(ТекСтрокаРабота.Работа, ТекВидРемонта);
		Если ДанныеЦены <> Неопределено Тогда
			НоваяСтрока.Сумма = ДанныеЦены.Цена;
			НоваяСтрока.Нормочас = ДанныеЦены.Нормочас;
			Если ЗначениеЗаполнено(ДанныеЦены.Нормочас) Тогда	
				НоваяСтрока.Цена = ДанныеЦены.Нормочас.Цена;
			Иначе
				НоваяСтрока.Цена = НоваяСтрока.Сумма/НоваяСтрока.Работа.ВремяВыполнения;		
			КонецЕсли;
		Иначе
			// Считаем по выбранному нормочасу
			ПересчитатьСуммыВСтрокеРабот(ТекущиеДанные, ТекНормочас);
		КонецЕсли;		
	КонецЦикла;
	
	ДопТовары = Форма.Товары;
	Для Каждого Товар из ДопТовары Цикл
		НоваяСтрока = Неопределено;
		
		Если ДилерскийЦентр.Автосервис_ГруппироватьТовары = Истина Тогда
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура",Товар.Номенклатура);
			СуществующаяСтрока = ТекТаблицаМатериалов.НайтиСтроки(Отбор);
			Если СуществующаяСтрока.Количество() <> 0 Тогда	
				НоваяСтрока = СуществующаяСтрока[0];
				НоваяСтрока.Количество = СуществующаяСтрока.Количество + Товар.Количество;	
			КонецЕсли;
		КонецЕсли;	
			
		Если НоваяСтрока = Неопределено Тогда
			НоваяСтрока = ТекТаблицаМатериалов.Добавить();
			НоваяСтрока.Номенклатура = Товар.Номенклатура;
			НоваяСтрока.Количество = Товар.Количество;
		КонецЕсли;	
		
		НоваяСтрока.Скидка = 0;
		НоваяСтрока.Цена = ПолучитьЦену(Товар.Номенклатура, ТекТипЦен);
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество * (1 - НоваяСтрока.ПроцентСкидки / 100);
	КонецЦикла;

	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦену(Номенклатура, ТекущийТипЦен, ОсновнойМеханизм = Ложь)
	
	Если ОсновнойМеханизм Тогда
		Возврат обПолучитьЦену(ТекущийТипЦен, Номенклатура,,,,,,,ПараметрыСеанса.ПодразделениеКомпании);
	КонецЕсли;
	
	ДилерскийЦентрОтбор = ДилерскийЦентр;
	
	Если НЕ ЗначениеЗаполнено(ДилерскийЦентрОтбор) Тогда
		ДилерскийЦентрОтбор = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	КонецЕсли;
	
	УчитыватьПодразделение = ДилерскийЦентрОтбор.Автосервис_УчитыватьПодразделениеВТипеЦен;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних(&ТекущаяДата, ) КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.ТипЦен = &ТипЦен
	|	И ЦеныСрезПоследних.Номенклатура = &Номенклатура
	|	И ВЫБОР
	|			КОГДА &УчитыватьПодразделение
	|				ТОГДА ЦеныСрезПоследних.ПодразделениеКомпании = &ПодразделениеКомпании
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("ТипЦен", ТекущийТипЦен);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("УчитыватьПодразделение", УчитыватьПодразделение);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПараметрыСеанса.ПодразделениеКомпании);	
	Цены = Запрос.Выполнить().Выгрузить();
	
	Если Цены.Количество() > 0 Тогда
		
		Возврат Цены[0].Цена;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьЦенуРаботы(Авторабота, ВидРемонта)
	
	Попытка
		Свойство = обПолучитьЗначениеСвойства(Авторабота, ПланыВидовХарактеристик.СвойстваОбъектов._ПризнакКомплекса);
		
		Если НЕ Свойство Тогда
			Возврат Неопределено;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныАвтоработСрезПоследних.Период,
	|	ЦеныАвтоработСрезПоследних.Регистратор,
	|	ЦеныАвтоработСрезПоследних.НомерСтроки,
	|	ЦеныАвтоработСрезПоследних.Активность,
	|	ЦеныАвтоработСрезПоследних.ТипЦен,
	|	ЦеныАвтоработСрезПоследних.Авторабота,
	|	ЦеныАвтоработСрезПоследних.Модель,
	|	ЦеныАвтоработСрезПоследних.ДоговорВзаиморасчетов,
	|	ЦеныАвтоработСрезПоследних.Цех,
	|	ЦеныАвтоработСрезПоследних.ВидРемонта,
	|	ЦеныАвтоработСрезПоследних.Нормочас,
	|	ЦеныАвтоработСрезПоследних.Валюта,
	|	ЦеныАвтоработСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныАвторабот.СрезПоследних(
	|			,
	|			ВидРемонта = &ВидРемонта
	|				И Модель = &Модель
	|				И Авторабота = &Авторабота) КАК ЦеныАвтоработСрезПоследних";	
	Запрос.УстановитьПараметр("Авторабота", Авторабота);
	Запрос.УстановитьПараметр("Модель", ТекущийАвтомобиль.Модель);
	Запрос.УстановитьПараметр("ВидРемонта", ВидРемонта);	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Цена",Выборка.Цена);
		СтруктураДанных.Вставить("Нормочас",Выборка.Нормочас);
		Возврат СтруктураДанных;		
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныАвтоработСрезПоследних.Период,
		|	ЦеныАвтоработСрезПоследних.Регистратор,
		|	ЦеныАвтоработСрезПоследних.НомерСтроки,
		|	ЦеныАвтоработСрезПоследних.Активность,
		|	ЦеныАвтоработСрезПоследних.ТипЦен,
		|	ЦеныАвтоработСрезПоследних.Авторабота,
		|	ЦеныАвтоработСрезПоследних.Модель,
		|	ЦеныАвтоработСрезПоследних.ДоговорВзаиморасчетов,
		|	ЦеныАвтоработСрезПоследних.Цех,
		|	ЦеныАвтоработСрезПоследних.ВидРемонта,
		|	ЦеныАвтоработСрезПоследних.Нормочас,
		|	ЦеныАвтоработСрезПоследних.Валюта,
		|	ЦеныАвтоработСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныАвторабот.СрезПоследних(
		|			,
		|			ВидРемонта = &ВидРемонта
		|				И Авторабота = &Авторабота) КАК ЦеныАвтоработСрезПоследних";		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Цена",Выборка.Цена);
			СтруктураДанных.Вставить("Нормочас",Выборка.Нормочас);
			Возврат СтруктураДанных;		
		Иначе
			
			Запрос.Текст = "ВЫБРАТЬ
			|	ЦеныАвтоработСрезПоследних.ТипЦен,
			|	ЦеныАвтоработСрезПоследних.Авторабота,
			|	ЦеныАвтоработСрезПоследних.Нормочас,
			|	ЦеныАвтоработСрезПоследних.Цена
			|ИЗ
			|	РегистрСведений.ЦеныАвторабот.СрезПоследних(, Авторабота = &Авторабота) КАК ЦеныАвтоработСрезПоследних";			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("Цена",Выборка.Цена);
				СтруктураДанных.Вставить("Нормочас",Выборка.Нормочас);
				Возврат СтруктураДанных;		
			Иначе				
				Возврат Неопределено;
			КонецЕсли;			
		КонецЕсли;		
	КонецЕсли;	
	
КонецФункции

