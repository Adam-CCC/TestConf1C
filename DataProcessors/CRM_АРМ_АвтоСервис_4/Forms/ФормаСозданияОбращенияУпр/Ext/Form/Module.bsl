Процедура УстановитьМаскуТелефона()
	ПервыйСимвол = ДилерскийЦентр.ПервыйСимволТелефона;
	Если СтрДлина(ПервыйСимвол) = 1 Тогда
		Элементы.ТелефонКлиента.Маска = "9(999)9999999";
		Элементы.ТелефонВладельца.Маска = "9(999)9999999";
	Иначе
		Элементы.ТелефонКлиента.Маска = "+9(999)9999999";
		Элементы.ТелефонВладельца.Маска = "+9(999)9999999";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИнцедент(Команда)
	
	СчетчикИнцедентов = СчетчикИнцедентов + 1;
	Если СчетчикИнцедентов = 2 Тогда
		Элементы.ГруппаВтораяЗаявка.Видимость = Истина;
		Элементы.ГруппаВтораяЗаявка.Показать();
	ИначеЕсли СчетчикИнцедентов = 3 Тогда
		Элементы.ГруппаТретьяЗаявка.Видимость = Истина;
		Элементы.ГруппаТретьяЗаявка.Показать();
	ИначеЕсли СчетчикИнцедентов = 4 Тогда
		Элементы.ГруппаЧетвертаяЗаявка.Видимость = Истина;
		Элементы.ГруппаЧетвертаяЗаявка.Показать();
	ИначеЕсли СчетчикИнцедентов = 5 Тогда
		Элементы.ГруппаПятаяЗаявка.Видимость = Истина;
		Элементы.ГруппаПятаяЗаявка.Показать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИнцидент(Команда)
	
	МассивКУдалению = Новый СписокЗначений;
	Если Элементы.ГруппаВтораяЗаявка.Видимость = Истина И НЕ ЗначениеЗаполнено(ЗаявкаНаСервис2.Ссылка) Тогда
		МассивКУдалению.Добавить("Вторая заявка");
	КонецЕсли;
	Если Элементы.ГруппаТретьяЗаявка.Видимость = Истина И НЕ ЗначениеЗаполнено(ЗаявкаНаСервис3.Ссылка) Тогда
		МассивКУдалению.Добавить("Третья заявка");
	КонецЕсли;
	Если Элементы.ГруппаЧетвертаяЗаявка.Видимость = Истина И НЕ ЗначениеЗаполнено(ЗаявкаНаСервис4.Ссылка) Тогда
		МассивКУдалению.Добавить("Четвертая заявка");
	КонецЕсли;
	Если Элементы.ГруппаПятаяЗаявка.Видимость = Истина И НЕ ЗначениеЗаполнено(ЗаявкаНаСервис5.Ссылка) Тогда
		МассивКУдалению.Добавить("Пятая заявка");
	КонецЕсли;
	Если МассивКУдалению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Выбор = ВыбратьИзСписка(МассивКУдалению);
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьНаСервере(Выбор.Значение);
	
	Если Элементы.ГруппаПятаяЗаявка.Видимость = Истина Тогда
		Элементы.ГруппаПятаяЗаявка.Видимость = Ложь;
	ИначеЕсли Элементы.ГруппаЧетвертаяЗаявка.Видимость = Истина Тогда
		Элементы.ГруппаЧетвертаяЗаявка.Видимость = Ложь;
	ИначеЕсли Элементы.ГруппаТретьяЗаявка.Видимость = Истина Тогда
		Элементы.ГруппаТретьяЗаявка.Видимость = Ложь;
	ИначеЕсли Элементы.ГруппаВтораяЗаявка.Видимость = Истина Тогда
		Элементы.ГруппаВтораяЗаявка.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&наСервере
Процедура УдалитьНаСервере(Значение)
	
	Если Значение = "Вторая заявка" Тогда
		ЗаявкаНаСервис2.Работы.Загрузить(ЗаявкаНаСервис3.Работы.Выгрузить());
		ЗаявкаНаСервис2.Товары.Загрузить(ЗаявкаНаСервис3.Товары.Выгрузить());
		ЗаявкаНаСервис3.Работы.Загрузить(ЗаявкаНаСервис4.Работы.Выгрузить());
		ЗаявкаНаСервис3.Товары.Загрузить(ЗаявкаНаСервис4.Товары.Выгрузить());
		ЗаявкаНаСервис4.Работы.Загрузить(ЗаявкаНаСервис5.Работы.Выгрузить());
		ЗаявкаНаСервис4.Товары.Загрузить(ЗаявкаНаСервис5.Товары.Выгрузить());
		ЗаявкаНаСервис5.Работы.Очистить();
		ЗаявкаНаСервис5.Товары.Очистить();
	ИначеЕсли Значение = "Третья заявка" Тогда
		ЗаявкаНаСервис3.Работы.Загрузить(ЗаявкаНаСервис4.Работы.Выгрузить());
		ЗаявкаНаСервис3.Товары.Загрузить(ЗаявкаНаСервис4.Товары.Выгрузить());
		ЗаявкаНаСервис4.Работы.Загрузить(ЗаявкаНаСервис5.Работы.Выгрузить());
		ЗаявкаНаСервис4.Товары.Загрузить(ЗаявкаНаСервис5.Товары.Выгрузить());
		ЗаявкаНаСервис5.Работы.Очистить();
		ЗаявкаНаСервис5.Товары.Очистить();
	ИначеЕсли Значение = "Четвертая заявка" Тогда
		ЗаявкаНаСервис4.Работы.Загрузить(ЗаявкаНаСервис5.Работы.Выгрузить());
		ЗаявкаНаСервис4.Товары.Загрузить(ЗаявкаНаСервис5.Товары.Выгрузить());
		ЗаявкаНаСервис5.Работы.Очистить();
		ЗаявкаНаСервис5.Товары.Очистить();
	ИначеЕсли Значение = "Пятая заявка" Тогда
		ЗаявкаНаСервис5.Работы.Очистить();
		ЗаявкаНаСервис5.Товары.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьРазвернутьГруппыИнцидентов(Команда)

	Если ГруппыСвернуты Тогда 
		Элементы.ГруппаПерваяЗаявка.Показать();
		Элементы.ГруппаВтораяЗаявка.Показать();
		Элементы.ГруппаТретьяЗаявка.Показать();
		Элементы.ГруппаЧетвертаяЗаявка.Показать();
		Элементы.ГруппаПятаяЗаявка.Показать();
		Элементы.СвернутьРазвернутьГруппыИнцидентов.Заголовок = "Свернуть заявки";
		ГруппыСвернуты = Ложь;
	Иначе 
		Элементы.ГруппаПерваяЗаявка.Скрыть();
		Элементы.ГруппаВтораяЗаявка.Скрыть();
		Элементы.ГруппаТретьяЗаявка.Скрыть();
		Элементы.ГруппаЧетвертаяЗаявка.Скрыть();
		Элементы.ГруппаПятаяЗаявка.Скрыть();
		Элементы.СвернутьРазвернутьГруппыИнцидентов.Заголовок = "Развернуть заявки";
		ГруппыСвернуты = Истина;
	КонецЕсли;
	
