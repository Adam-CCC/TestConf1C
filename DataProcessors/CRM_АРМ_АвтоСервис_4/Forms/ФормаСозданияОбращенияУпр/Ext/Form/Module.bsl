		ВидРемонта = ВидРемонта3;
	ИначеЕсли НомерЗаявки = 4 Тогда
		ЗаявкаНаСервис = ЗаявкаНаСервис4;
		ВидРемонта = ВидРемонта4;
	ИначеЕсли НомерЗаявки = 5 Тогда
		ЗаявкаНаСервис = ЗаявкаНаСервис5;
		ВидРемонта = ВидРемонта5;
	КонецЕсли;
	
	Для Каждого ТекСтрока ИЗ ЗаявкаНаСервис.Работы Цикл		
		ТекСтрока.Коэффициент = ПолучитьКоэффициентСложностиРаботы(ТекСтрока.Работа, ВидРемонта);		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ВидРемонта) Тогда
		ТекстВопроса = НСтр("ru='Установить нормочас по умолчанию для выбранного вида ремонта?'");
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВидРемонта",ВидРемонта);
		ДопПараметры.Вставить("Работы",ЗаявкаНаСервис.Работы);
		Если НомерЗаявки = 1 Тогда
			ДопПараметры.Вставить("Нормочас","Нормочас1");
			ДопПараметры.Вставить("ПроцедураИзменения","НормочасПриИзменении(1)");
		ИначеЕсли НомерЗаявки = 2 Тогда
			ДопПараметры.Вставить("Нормочас","Нормочас2");
			ДопПараметры.Вставить("ПроцедураИзменения","НормочасПриИзменении(2)");
		ИначеЕсли НомерЗаявки = 3 Тогда
			ДопПараметры.Вставить("Нормочас","Нормочас3");
			ДопПараметры.Вставить("ПроцедураИзменения","НормочасПриИзменении(3)");
		ИначеЕсли НомерЗаявки = 4 Тогда
			ДопПараметры.Вставить("Нормочас","Нормочас4");
			ДопПараметры.Вставить("ПроцедураИзменения","НормочасПриИзменении(4)");
		ИначеЕсли НомерЗаявки = 5 Тогда
			ДопПараметры.Вставить("Нормочас","Нормочас5");
			ДопПараметры.Вставить("ПроцедураИзменения","НормочасПриИзменении(5)");
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ЗавершениеИзменениеВидРемонтаОбщая",ЭтаФорма,ДопПараметры);
		ПоказатьВопрос(Оповещение,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
