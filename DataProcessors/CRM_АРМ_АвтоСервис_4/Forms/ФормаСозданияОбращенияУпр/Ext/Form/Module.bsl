Процедура СохранитьЗаявки()
	
	Если ЗаявкаНаСервис1.Работы.Количество()>0 Тогда 
		ЗаявкаНаСервис1Объект = РеквизитФормыВЗначение("ЗаявкаНаСервис1");
		ЗаявкаНаСервис1Объект.Записать();
	КонецЕсли;
	
	Если ЗаявкаНаСервис2.Работы.Количество()>0 Тогда 
		ЗаявкаНаСервис2Объект = РеквизитФормыВЗначение("ЗаявкаНаСервис2");
		Если ЗначениеЗаполнено(ЗаявкаНаСервис2Объект.Дата) Тогда 
			ЗаявкаНаСервис2Объект.Записать();
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаявкаНаСервис3.Работы.Количество()>0 Тогда 
		ЗаявкаНаСервис3Объект = РеквизитФормыВЗначение("ЗаявкаНаСервис3");
		Если ЗначениеЗаполнено(ЗаявкаНаСервис3Объект.Дата) Тогда 
			ЗаявкаНаСервис3Объект.Записать();
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаявкаНаСервис4.Работы.Количество()>0 Тогда 
		ЗаявкаНаСервис4Объект = РеквизитФормыВЗначение("ЗаявкаНаСервис4");
		Если ЗначениеЗаполнено(ЗаявкаНаСервис4.Дата) Тогда 
			ЗаявкаНаСервис4.Записать();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


