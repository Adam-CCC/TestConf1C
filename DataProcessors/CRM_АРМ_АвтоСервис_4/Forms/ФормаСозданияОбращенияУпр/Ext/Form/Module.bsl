Функция ПроверитьПовторениеРабот(Автомобиль, Авторабота, Клиент)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисВыполненныеРаботыСрезПоследних.Клиент.Ссылка,
	|	Renault_АвтосервисВыполненныеРаботыСрезПоследних.OPERACODE,
	|	Renault_АвтосервисВыполненныеРаботыСрезПоследних.Авторабота.Ссылка,
	|	Renault_АвтосервисВыполненныеРаботыСрезПоследних.Автомобиль.VIN,";
	
	//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "5" Тогда
		
		Запрос.Текст = Запрос.Текст + Символы.ПС +
		"Renault_АвтосервисВыполненныеРаботыСрезПоследних.ЗаказНаряд.ДатаЗакрытия КАК ДатаЗакрытия";
		
	//Иначе
	//	
	//	Запрос.Текст = Запрос.Текст + Символы.ПС +
	//	"Renault_АвтосервисВыполненныеРаботыСрезПоследних.ЗаказНаряд.ДатаОкончания КАК ДатаЗакрытия";
	//	
	//КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + Символы.ПС + 
	"ИЗ
	|	РегистрСведений.Renault_АвтосервисВыполненныеРаботы.СрезПоследних КАК Renault_АвтосервисВыполненныеРаботыСрезПоследних
	|ГДЕ
	|	Renault_АвтосервисВыполненныеРаботыСрезПоследних.Клиент = &Клиент
	|	И Renault_АвтосервисВыполненныеРаботыСрезПоследних.Авторабота = &Авторабота
	|	И Renault_АвтосервисВыполненныеРаботыСрезПоследних.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("Авторабота", Авторабота);
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПериодПовтора = ДилерскийЦентр.ПериодПовторногоОбращения;
	
	Если НЕ ЗначениеЗаполнено(ПериодПовтора) Тогда
		
		Если ПериодПовтора = 0 Тогда
			
			ПериодПовтора = 14;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Выборка.Следующий() Тогда
		
		Если (ТекущаяДата() - Выборка.ДатаЗакрытия) < ПериодПовтора*24*60*60 Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

