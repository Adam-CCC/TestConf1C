&НаКлиенте
Процедура ПроверкаОбращенияНаПотенциальныхКлиентаИАвто(Обращение, Отказ)
	КонтрагентКлиент = Неопределено;
	АвтомобильНовый = Неопределено;
	КонтрагентВладелецАвто = Неопределено;
	
	НачатьТранзакцию();
	
	Попытка 
		Если ТипЗнч(Обращение.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
			
			ВопросПользователю = Вопрос("В заявке потенциальный клиент. Создать клиента?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			
			Если ВопросПользователю = КодВозвратаДиалога.Да Тогда
				ПотенциальныйКлиент = Обращение.Клиент;

				КонтрагентКлиент = CRM_Редубликация.СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(ПотенциальныйКлиент);
								
				Если НЕ ЗначениеЗаполнено(КонтрагентКлиент) Тогда
					Отказ = Истина;
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
				
				СоздатьДоговорВзаиморасчетовДляКонтрагента(КонтрагентКлиент);

				Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
				Запись.Клиент = ПотенциальныйКлиент;
				Запись.Записать();				
			Иначе
				Отказ = Истина;
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли; 
		КонецЕсли;
		
		Если ТипЗнч(Обращение.ВладелецАвтомобиля) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") И
			Обращение.ВладелецАвтомобиля <> Обращение.Клиент Тогда
			
			ВопросПользователю = Вопрос("В заявке владелец автомобиля отличается от клиента и является потенциальным контрагентом. Создать владельца авто?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			
			Если ВопросПользователю = КодВозвратаДиалога.Да Тогда
				ПотенциальныйВладелецАвто = Обращение.ВладелецАвтомобиля;

				КонтрагентВладелецАвто = CRM_Редубликация.СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(ПотенциальныйВладелецАвто);
				
				Если НЕ ЗначениеЗаполнено(КонтрагентВладелецАвто) Тогда
					Отказ = Истина;
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли;
				
				СоздатьДоговорВзаиморасчетовДляКонтрагента(КонтрагентВладелецАвто);
				
				Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
				Запись.Клиент = ПотенциальныйВладелецАвто;
				Запись.Записать();				
			Иначе
				Отказ = Истина;
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли; 
		КонецЕсли;
		
		Если ТипЗнч(Обращение.Автомобиль) = Тип("СправочникСсылка.Renault_ЧерновикиАвтомобилей") Тогда
			
			ВопросПользователю = Вопрос("В заявке черновик автомобиля. Создать автомобиль?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			
			Если ВопросПользователю = КодВозвратаДиалога.Да Тогда
				ЧерновикАвтомобиль = Обращение.Автомобиль;
				
				Если НЕ ЗначениеЗаполнено(Обращение.ВладелецАвтомобиля) ИЛИ Обращение.ВладелецАвтомобиля = Обращение.Клиент Тогда
					АвтомобильНовый = СоздатьАвтомобильИзЧерновика(ЧерновикАвтомобиль, КонтрагентКлиент);
				Иначе
					АвтомобильНовый = СоздатьАвтомобильИзЧерновика(ЧерновикАвтомобиль, КонтрагентВладелецАвто);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(АвтомобильНовый) Тогда
					Отказ = Истина;
					ОтменитьТранзакцию();
					Возврат;
				КонецЕсли; 				
			Иначе
				Отказ = Истина;
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли; 
		КонецЕсли;
		
		ТекстАвто = "";
		ТекстКонтрагент = "";
		ТекстВладелецАвто = "";
		Если КонтрагентКлиент <> Неопределено ИЛИ АвтомобильНовый <> Неопределено ИЛИ КонтрагентВладелецАвто <> Неопределено Тогда
			ПерезаписатьХозяина = Ложь;
			
			Если ЗначениеЗаполнено(КонтрагентКлиент) Тогда					
				КонтрагентДляЗамены = КонтрагентКлиент;
				ТекстКонтрагент = "Создан контрагент - " + КонтрагентКлиент.Наименование + ".";
				ПерезаписатьХозяина = Истина;
			Иначе
				КонтрагентДляЗамены = Обращение.Клиент;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(КонтрагентВладелецАвто) Тогда					
				ВладелецАвтоДляЗамены = КонтрагентВладелецАвто;
				ТекстВладелецАвто = "Создан владелец авто - " + КонтрагентВладелецАвто.Наименование + ".";
				ПерезаписатьХозяина = Истина;
			Иначе
				ВладелецАвтоДляЗамены = Обращение.ВладелецАвтомобиля;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(АвтомобильНовый) Тогда					
				АвтомобильДляЗамены = АвтомобильНовый;
				ТекстАвто = "Создан автомобиль - " + АвтомобильНовый.Наименование + ".";
				ПерезаписатьХозяина = Ложь;
			Иначе
				АвтомобильДляЗамены = Обращение.Автомобиль;
			КонецЕсли;
			
			ПереводДанныхСПотенциальныхАвтоИКонтрагентаНаРеальных(Обращение,				 
				АвтомобильДляЗамены, КонтрагентДляЗамены, ВладелецАвтоДляЗамены);
				
			Если ПерезаписатьХозяина Тогда
				ВладелецДляПерезаписи = ?(ЗначениеЗаполнено(ВладелецАвтоДляЗамены), ВладелецАвтоДляЗамены, КонтрагентДляЗамены);
				Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(АвтомобильДляЗамены, ВладелецДляПерезаписи, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин, НачалоДня(ТекущаяДата()));
			КонецЕсли;		

		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ТекстВладелецАвто) Тогда
			Сообщить(ТекстВладелецАвто);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстКонтрагент) Тогда
			Сообщить(ТекстКонтрагент);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстАвто) Тогда
			Сообщить(ТекстАвто);
		КонецЕсли;	
	Исключение
		Отказ = Истина;
		ОтменитьТранзакцию();
		Возврат;
	КонецПопытки;
	
	ЗафиксироватьТранзакцию(); 
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговорВзаиморасчетовДляКонтрагента(КонтрагентСсылка)
	
	Если ЗначениеЗаполнено(ПараметрыСеанса.Организация) Тогда
		ТекОрганизация = ПараметрыСеанса.Организация;
	ИначеЕсли ЗначениеЗаполнено(ПараметрыСеанса.ПодразделениеКомпании) И ЗначениеЗаполнено(ПараметрыСеанса.ПодразделениеКомпании.Организация) Тогда
		ТекОрганизация = ПараметрыСеанса.ПодразделениеКомпании.Организация;
	ИначеЕсли ЗначениеЗаполнено(Справочники.ПодразделенияКомпании.ОсновноеПодразделение.Организация) Тогда
		ТекОрганизация = Справочники.ПодразделенияКомпании.ОсновноеПодразделение.Организация;
	Иначе
		ТекОрганизация = Справочники.Организации.ОсновнаяОрганизация;
	КонецЕсли;		
	
	ВидДоговора = Перечисления.ВидыДоговоров.Продажа;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
			                   |	ДоговорыВзаиморасчетов.Ссылка
			                   |ИЗ
			                   |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
			                   |ГДЕ
			                   |	ДоговорыВзаиморасчетов.Владелец = &Владелец
			                   |	И ДоговорыВзаиморасчетов.Организация = &Организация
			                   |	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора");
							   
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("Владелец", КонтрагентСсылка);
	Запрос.УстановитьПараметр("Организация", ТекОрганизация);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ДогОбъект = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		//ДогОбъект.ОбработкаЗаполнения(Неопределено);
		ДогОбъект.Владелец = КонтрагентСсылка;
		ДогОбъект.Организация = ТекОрганизация;
		ДогОбъект.ВидДоговора = ВидДоговора;
		ДогОбъект.УстановитьНовыйКод();
		ДогОбъект.Подразделение = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
		ДогОбъект.ВидОплаты = Перечисления.ВидыОплаты.БезналичныйРасчет;
		ДогОбъект.ДатаНачала = НачалоГода(ТекущаяДата());
		ДогОбъект.ТипЦенПродажи = Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
		
		ВалютаВзаиморасчетов = обПраво("ОсновнаяВалютаВзаиморасчетов",глПрава,,ДогОбъект.Подразделение);
		Если ВалютаВзаиморасчетов.Пустая() Тогда
			ДогОбъект.ВалютаВзаиморасчетов = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
		Иначе
			ДогОбъект.ВалютаВзаиморасчетов = ВалютаВзаиморасчетов;
		КонецЕсли; 
		
		ДогОбъект.Наименование = "Договор №" + ДогОбъект.Код + " с " + КонтрагентСсылка.Наименование;		
		ДогОбъект.ДляАвтосервиса = Истина;
		ДогОбъект.ТипДоговора = Перечисления.ТипыДоговоров.Договор;
		ДогОбъект.АвтоЗакрытиеСделок=обПраво("АвтоЗакрытиеСделок",глПрава,,ТекОрганизация);
		ДогОбъект.ЕдиницаИзмеренияАвтоработВПечатныхФормах = обПраво("ЕдиницаИзмеренияАвтоработВПечатныхФормах"); // DMSREN-1228
		ДогОбъект.Записать();
		
		ДогСсылка = ДогОбъект.Ссылка;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		ДогСсылка = Выборка.Ссылка;
	КонецЕсли;	
	
	КонтрагентОбъект = КонтрагентСсылка.ПолучитьОбъект();
	КонтрагентОбъект.ОсновнойДоговорВзаиморасчетов = ДогСсылка;
	КонтрагентОбъект.Записать(); 
КонецПроцедуры

Процедура ПереводДанныхСПотенциальныхАвтоИКонтрагентаНаРеальных(Обращение, НовыйАвтомобиль, НовыйКлиент, НовыйВладелецАвто)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК Документ
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаСервис.Обращение = &Обращение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Renault_CRM_ЗаявкаНаМойку.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаМойку.Обращение = &Обращение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Renault_CRM_ПриемкаАвтомобиля.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		|ГДЕ
		|	Renault_CRM_ПриемкаАвтомобиля.Обращение = &Обращение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Renault_CRM_ВыдачаАвтомобиля.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
		|ГДЕ
		|	Renault_CRM_ВыдачаАвтомобиля.Обращение = &Обращение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Renault_CRM_ЗаявкаНаПодменныйАвто.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаПодменныйАвто КАК Renault_CRM_ЗаявкаНаПодменныйАвто
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаПодменныйАвто.Обращение = &Обращение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		|ГДЕ
		|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка.Документ.ПолучитьОбъект();
			ДокументОбъект.Клиент = НовыйКлиент;
			ДокументОбъект.Автомобиль = НовыйАвтомобиль;
			Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис") Тогда
				ДокументОбъект.ВладелецАвтомобиля = НовыйВладелецАвто;
			ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") Тогда 
				ДокументОбъект.ВладалецАвтомобиля = НовыйВладелецАвто;
			КонецЕсли;
			ДокументОбъект.Записать();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьАвтомобильИзЧерновика(ЧерновикАвтомобиль, ВладелецНовогоАвто)
	
	НачалоДняДата = НачалоДня(ТекущаяДата());
	
	НовыйЭлемент = Справочники.Автомобили.СоздатьЭлемент();
	НовыйЭлемент.VIN = ЧерновикАвтомобиль.VIN;
	НовыйЭлемент.Модель = ЧерновикАвтомобиль.Модель;
	НовыйЭлемент.ГодВыпуска = ЧерновикАвтомобиль.ГодВыпуска;
	НовыйЭлемент.НаименованиеПолное = ЧерновикАвтомобиль.НаименованиеПолное;
	НовыйЭлемент.Наименование = ЧерновикАвтомобиль.Наименование;
	НовыйЭлемент.Цвет = ЧерновикАвтомобиль.Цвет;
	НовыйЭлемент.ВариантКомплектации = ЧерновикАвтомобиль.ВариантКомплектации;
	НовыйЭлемент.ДатаНачалаГарантии = ЧерновикАвтомобиль.ДатаНачалаГарантии;
	НовыйЭлемент.ТипДвигателя = ЧерновикАвтомобиль.ТипДвигателя;
	НовыйЭлемент.ТипКПП = ЧерновикАвтомобиль.ТипКПП;
	НовыйЭлемент.ВключатьВПрайсЛист = ЧерновикАвтомобиль.ВключатьВПрайсЛист;
	НовыйЭлемент.ВалютаУчета = ЧерновикАвтомобиль.ВалютаУчета;
	НовыйЭлемент.УстановитьНовыйКод(); 
	НовыйЭлемент.ОбменДанными.Загрузка = Истина; 
	НовыйЭлемент.Записать();
	
	ЧерновикАвтомобильОбъект = ЧерновикАвтомобиль.ПолучитьОбъект();
	ЧерновикАвтомобильОбъект.Автомобиль = НовыйЭлемент.Ссылка;
	ЧерновикАвтомобильОбъект.Записать();
	
	Если ЗначениеЗаполнено(ЧерновикАвтомобиль.Пробег) Тогда	
		Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(НовыйЭлемент.Ссылка, ЧерновикАвтомобиль.Пробег, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, НачалоДняДата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЧерновикАвтомобиль.ГосНомер) Тогда
		Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(НовыйЭлемент.Ссылка, ЧерновикАвтомобиль.ГосНомер, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, НачалоДняДата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЧерновикАвтомобиль.Хозяин) И ТипЗнч(ЧерновикАвтомобиль.Хозяин) = Тип("СправочникСсылка.Контрагенты") Тогда
		Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(НовыйЭлемент.Ссылка, ЧерновикАвтомобиль.Хозяин, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин, НачалоДняДата);
	Иначе
		Если ЗначениеЗаполнено(ВладелецНовогоАвто) И ЗначениеЗаполнено(ЧерновикАвтомобиль.Хозяин) И
			ВладелецНовогоАвто.Наименование = ЧерновикАвтомобиль.Хозяин.Наименование Тогда
			Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(НовыйЭлемент.Ссылка, ВладелецНовогоАвто, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин, НачалоДняДата);
		КонецЕсли;
	КонецЕсли;	
	
	Запись = РегистрыСведений.Renault_АвтомобилиДопРеквизиты.СоздатьМенеджерЗаписи();
	Запись.Автомобиль = НовыйЭлемент.Ссылка;
	Запись.AC = ЧерновикАвтомобиль.AC;
	Запись.ГУР = ЧерновикАвтомобиль.ГУР;
	Запись.СалонныйФильтр = ЧерновикАвтомобиль.СалонныйФильтр;
	Запись.СемействоАвтомобиля = ЧерновикАвтомобиль.СемействоАвтомобиля;
	Запись.Записать(); 
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

#Область СкидкиБаллы

&НаКлиенте
Процедура СписатьБаллыОбщая1ПриИзменении(Элемент)
	
	Если Элемент.Имя = "СписатьБаллыОбщая1" Тогда
		ТЧРаботы = ЗаявкаНаСервис1.Работы;
		ТЧТовары = ЗаявкаНаСервис1.Товары;
		Нормочас = Нормочас1;
		СписатьБаллыОбщая = СписатьБаллыОбщая1;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая2" Тогда
		ТЧРаботы = ЗаявкаНаСервис2.Работы;
		ТЧТовары = ЗаявкаНаСервис2.Товары;
		Нормочас = Нормочас2;
		СписатьБаллыОбщая = СписатьБаллыОбщая2;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая3" Тогда
		ТЧРаботы = ЗаявкаНаСервис3.Работы;
		ТЧТовары = ЗаявкаНаСервис3.Товары;
		Нормочас = Нормочас3;
		СписатьБаллыОбщая = СписатьБаллыОбщая3;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая4" Тогда
		ТЧРаботы = ЗаявкаНаСервис4.Работы;
		ТЧТовары = ЗаявкаНаСервис4.Товары;
		Нормочас = Нормочас4;
		СписатьБаллыОбщая = СписатьБаллыОбщая4;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая5" Тогда
		ТЧРаботы = ЗаявкаНаСервис5.Работы;
		ТЧТовары = ЗаявкаНаСервис5.Товары;
		Нормочас = Нормочас5;
		СписатьБаллыОбщая = СписатьБаллыОбщая5;
	КонецЕсли;
	
	ОчиститьБаллыВТаблицеРаботы(ТЧРаботы, Нормочас);
	ОчиститьБаллыВТаблицеЗапчасти(ТЧТовары);
	
	ВсегоСписываем = СписатьБаллыОбщая1 + СписатьБаллыОбщая2 + СписатьБаллыОбщая3 + СписатьБаллыОбщая4 + СписатьБаллыОбщая5;
	ОстальныеСписываем = ВсегоСписываем - СписатьБаллыОбщая;
	Если ВсегоСписываем > ОстатокБаллов Тогда
		Предупреждение(НСтр("ru = 'Остаток баллов составляет: '") + Формат(ОстатокБаллов,"ЧЦ=10; ЧДЦ=2; ЧН=0; ЧГ="));
		СписатьБаллыОбщая = ОстатокБаллов - ОстальныеСписываем;
	КонецЕсли;
	
	Если Элемент.Имя = "СписатьБаллыОбщая1" Тогда
		СписатьБаллыОбщая1 = СписатьБаллыОбщая;
		Если СписатьБаллыОбщая1 = 0 Тогда
			СписатьБаллыЗапчасти1 = 0;
			СписатьБаллыРаботы1   = 0;
		Иначе
			РаспределитьПропорциональноБаллыПоЗаявке(1);
		КонецЕсли;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая2" Тогда
		СписатьБаллыОбщая2 = СписатьБаллыОбщая;
		Если СписатьБаллыОбщая2 = 0 Тогда
			СписатьБаллыЗапчасти2 = 0;
			СписатьБаллыРаботы2   = 0;
		Иначе
			РаспределитьПропорциональноБаллыПоЗаявке(2);
		КонецЕсли;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая3" Тогда
		СписатьБаллыОбщая3 = СписатьБаллыОбщая;
		Если СписатьБаллыОбщая3 = 0 Тогда
			СписатьБаллыЗапчасти3 = 0;
			СписатьБаллыРаботы3   = 0;
		Иначе
			РаспределитьПропорциональноБаллыПоЗаявке(3);
		КонецЕсли;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая4" Тогда
		СписатьБаллыОбщая4 = СписатьБаллыОбщая;
		Если СписатьБаллыОбщая = 0 Тогда
			СписатьБаллыЗапчасти4 = 0;
			СписатьБаллыРаботы4   = 0;
		Иначе
			РаспределитьПропорциональноБаллыПоЗаявке(4);
		КонецЕсли;
	ИначеЕсли Элемент.Имя = "СписатьБаллыОбщая5" Тогда
		СписатьБаллыОбщая5 = СписатьБаллыОбщая;
		Если СписатьБаллыОбщая5 = 0 Тогда
			СписатьБаллыЗапчасти5 = 0;
			СписатьБаллыРаботы5   = 0;
		Иначе
			РаспределитьПропорциональноБаллыПоЗаявке(5);
		КонецЕсли;
	КонецЕсли;
		
	ПересчитатьСтоимости();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьБаллыВТаблицеРаботы(ТаблицаРаботы, НормочасРаботы)
	
	Для каждого ТекСтрока Из ТаблицаРаботы Цикл
		ТекСтрока.DMS_СуммаБонусныхБаллов = 0;
		ПересчитатьСуммыВСтрокеРабот(ТекСтрока, НормочасРаботы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьБаллыВТаблицеЗапчасти(ТабЗапчасти)
	
	Для каждого ТекСтрока Из ТабЗапчасти Цикл
		ТекСтрока.DMS_СуммаБонусныхБаллов = 0;
		ПересчитатьСуммыВСтрокеМатериалов(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыВСтрокеМатериалов(СтрокаТаблицы)
	
	СтрокаТаблицы.Сумма			= СтрокаТаблицы.Цена * СтрокаТаблицы.Количество * (1 - СтрокаТаблицы.ПроцентСкидки / 100);
	СтрокаТаблицы.СуммаСкидки	= СтрокаТаблицы.Цена * СтрокаТаблицы.Количество * (СтрокаТаблицы.ПроцентСкидки) / 100;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПропорциональноБаллыПоЗаявке(НомерЗаявки)
	
	Если НомерЗаявки = 1 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти1;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы1;
		СписатьБаллыОбщая	 = СписатьБаллыОбщая1;
		ТаблицаРаботы		 = ЗаявкаНаСервис1.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис1.Товары;
	ИначеЕсли НомерЗаявки = 2 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти2;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы2;
		СписатьБаллыОбщая	 = СписатьБаллыОбщая2;
		ТаблицаРаботы		 = ЗаявкаНаСервис2.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис2.Товары;
	ИначеЕсли НомерЗаявки = 3 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти3;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы3;
		СписатьБаллыОбщая	 = СписатьБаллыОбщая3;
		ТаблицаРаботы		 = ЗаявкаНаСервис3.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис3.Товары;
	ИначеЕсли НомерЗаявки = 4 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти4;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы4;
		СписатьБаллыОбщая	 = СписатьБаллыОбщая4;
		ТаблицаРаботы		 = ЗаявкаНаСервис4.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис4.Товары;
	Иначе
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти5;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы5;
		СписатьБаллыОбщая	 = СписатьБаллыОбщая5;
		ТаблицаРаботы		 = ЗаявкаНаСервис5.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис5.Товары;
	КонецЕсли;
	
	мСтоимостьЗЧ_Итого		= ТаблицаЗапчасти.Итог("Сумма");
	мСтоимостьРабот_Итого	= ТаблицаРаботы.Итог("Сумма");
	мОбщаяСтоимость			= мСтоимостьЗЧ_Итого + мСтоимостьРабот_Итого;
	
	Если мСтоимостьЗЧ_Итого = мОбщаяСтоимость Тогда
		
		мПроцентЗЧ 	  = 1;
		мПроцентРабот = 0;
		
	ИначеЕсли мСтоимостьРабот_Итого = мОбщаяСтоимость Тогда
		
		мПроцентЗЧ 	  = 0;
		мПроцентРабот = 1;
		
	Иначе 
		
		мПроцентЗЧ 	   = ?(мОбщаяСтоимость > 0, Окр(мСтоимостьЗЧ_Итого / мОбщаяСтоимость, 2), 0);
		мПроцентРабот  = 1 - мПроцентЗЧ; 
		
	КонецЕсли; 
	
	СписатьБаллыЗапчасти = Окр(СписатьБаллыОбщая * мПроцентЗЧ);
	СписатьБаллыРаботы	 = Окр(СписатьБаллыОбщая * мПроцентРабот);
	
	Разница = СписатьБаллыОбщая - (СписатьБаллыЗапчасти + СписатьБаллыРаботы);
	
	Если Разница <> 0 Тогда
		
		Если СписатьБаллыРаботы <> 0 Тогда
			СписатьБаллыРаботы = СписатьБаллыРаботы + Разница;
		КонецЕсли;
		
		Если СписатьБаллыЗапчасти <> 0 Тогда
			СписатьБаллыЗапчасти = СписатьБаллыЗапчасти + Разница;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если СписатьБаллыРаботы <> 0 Тогда
		
		Превышение = ПревышениеСкидкиПоРаботам(СписатьБаллыРаботы, НомерЗаявки);
		СписатьБаллыРаботы = СписатьБаллыРаботы - Превышение;
		
		Если СписатьБаллыЗапчасти <> 0 Тогда
			СписатьБаллыЗапчасти = СписатьБаллыЗапчасти + Превышение;
			ПревышениеЗЧ = ПревышениеСкидкиПоЗЧ(СписатьБаллыЗапчасти, НомерЗаявки);
			СписатьБаллыЗапчасти = СписатьБаллыЗапчасти - ПревышениеЗЧ;
		КонецЕсли;
		
	ИначеЕсли СписатьБаллыЗапчасти <> 0 Тогда
		
		ПревышениеЗЧ = ПревышениеСкидкиПоЗЧ(СписатьБаллыЗапчасти, НомерЗаявки);
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти - ПревышениеЗЧ;
		
		Если СписатьБаллыРаботы <> 0 Тогда
			СписатьБаллыРаботы = СписатьБаллыРаботы + ПревышениеЗЧ;
			ПревышениеРабот = ПревышениеСкидкиПоРаботам(СписатьБаллыРаботы, НомерЗаявки);
			СписатьБаллыРаботы = СписатьБаллыРаботы - ПревышениеРабот;
		КонецЕсли;
	КонецЕсли;
	
	СписатьБаллыОбщая = СписатьБаллыЗапчасти + СписатьБаллыРаботы;
	
	Если НомерЗаявки = 1 Тогда
		СписатьБаллыЗапчасти1	= СписатьБаллыЗапчасти;
		СписатьБаллыРаботы1		= СписатьБаллыРаботы;
		СписатьБаллыОбщая1	 	= СписатьБаллыОбщая;
	ИначеЕсли НомерЗаявки = 2 Тогда
		СписатьБаллыЗапчасти2	= СписатьБаллыЗапчасти;
		СписатьБаллыРаботы2		= СписатьБаллыРаботы;
		СписатьБаллыОбщая2		= СписатьБаллыОбщая;
	ИначеЕсли НомерЗаявки = 3 Тогда
		СписатьБаллыЗапчасти3	= СписатьБаллыЗапчасти;
		СписатьБаллыРаботы3		= СписатьБаллыРаботы;
		СписатьБаллыОбщая3		= СписатьБаллыОбщая;
	ИначеЕсли НомерЗаявки = 4 Тогда
		СписатьБаллыЗапчасти4	= СписатьБаллыЗапчасти;
		СписатьБаллыРаботы4		= СписатьБаллыРаботы;
		СписатьБаллыОбщая4		= СписатьБаллыОбщая;
	Иначе
		СписатьБаллыЗапчасти5	= СписатьБаллыЗапчасти;
		СписатьБаллыРаботы5		= СписатьБаллыРаботы;
		СписатьБаллыОбщая5		= СписатьБаллыОбщая;
	КонецЕсли;
	
	Если СписатьБаллыРаботы <> 0 Тогда
		СписатьБаллыПоРаботам(НомерЗаявки);
	КонецЕсли;
		
	Если СписатьБаллыЗапчасти <> 0 Тогда
		СписатьБаллыПоЗапчастям(НомерЗаявки);
	КонецЕсли;
	
КонецПроцедуры

Функция ПревышениеСкидкиПоРаботам(мСуммаПроверки, НомерЗаявки)
	
	Если Не ЗначениеЗаполнено(ПрограммаЛояльности) Тогда
		Возврат 0;
	КонецЕсли;
	
	СкидкаПоРаботам = мСуммаПроверки * ПрограммаЛояльности.РаботыКурсБаллов;
	
	Если НомерЗаявки = 1 Тогда
		ПолнаяСтоимостьРабот = ЗаявкаНаСервис1.Работы.Итог("Сумма");
	ИначеЕсли НомерЗаявки = 2 Тогда
		ПолнаяСтоимостьРабот = ЗаявкаНаСервис2.Работы.Итог("Сумма");
	ИначеЕсли НомерЗаявки = 3 Тогда
		ПолнаяСтоимостьРабот = ЗаявкаНаСервис3.Работы.Итог("Сумма");
	ИначеЕсли НомерЗаявки = 4 Тогда
		ПолнаяСтоимостьРабот = ЗаявкаНаСервис4.Работы.Итог("Сумма");
	Иначе
		ПолнаяСтоимостьРабот = ЗаявкаНаСервис5.Работы.Итог("Сумма");
	КонецЕсли;
	
	//ПолнаяСтоимостьРабот = ?(НомерЗаявки = 1, Автоработы.Итог("Сумма"), АвтоработыВторая.Итог("Сумма"));
	
	МаксимумОплата = ПолнаяСтоимостьРабот * (ПрограммаЛояльности.РаботыМаксимумБалловОплатаПроцент / 100);
	
	Если МаксимумОплата = 0 ИЛИ МаксимумОплата > ПрограммаЛояльности.РаботыМаксимумБалловОплата Тогда
		МаксимумОплата = ПрограммаЛояльности.РаботыМаксимумБалловОплата;
	КонецЕсли;
	
	Если СкидкаПоРаботам > МаксимумОплата Тогда
		Превышение = СкидкаПоРаботам - МаксимумОплата;
		Сообщить("Скидка по баллам превышает стоимость работ на " + Формат(Превышение,"ЧЦ=15; ЧДЦ=2"));
		Возврат Окр(Превышение, 2);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПревышениеСкидкиПоЗЧ(мСуммаПроверки, НомерЗаявки)
	
	Если Не ЗначениеЗаполнено(ПрограммаЛояльности) Тогда
		Возврат 0;
	КонецЕсли;
	
	СкидкаПоЗЧ = мСуммаПроверки * ПрограммаЛояльности.ЗапчастиКурсБаллов;
	
	Если НомерЗаявки = 1 Тогда
		ПолнаяСтоимостьЗЧ = ЗаявкаНаСервис1.Товары.Итог("Сумма");
	ИначеЕсли НомерЗаявки = 2 Тогда
		ПолнаяСтоимостьЗЧ = ЗаявкаНаСервис2.Товары.Итог("Сумма");
	ИначеЕсли НомерЗаявки = 3 Тогда
		ПолнаяСтоимостьЗЧ = ЗаявкаНаСервис3.Товары.Итог("Сумма");
	ИначеЕсли НомерЗаявки = 4 Тогда
		ПолнаяСтоимостьЗЧ = ЗаявкаНаСервис4.Товары.Итог("Сумма");
	Иначе
		ПолнаяСтоимостьЗЧ = ЗаявкаНаСервис5.Товары.Итог("Сумма");
	КонецЕсли;
	
	//ПолнаяСтоимостьЗЧ = ?(НомерЗаявки = 1, ТаблицаМатериалы.Итог("Сумма"), ТаблицаМатериалыВторая.Итог("Сумма"));
	
	МаксимумОплата = ПолнаяСтоимостьЗЧ * (ПрограммаЛояльности.ЗапчастиМаксимумБалловОплатаПроцент / 100);
	
	Если МаксимумОплата = 0 ИЛИ МаксимумОплата > ПрограммаЛояльности.ЗапчастиМаксимумБалловОплата Тогда
		МаксимумОплата = ПрограммаЛояльности.ЗапчастиМаксимумБалловОплата;
	КонецЕсли;
	
	Если СкидкаПоЗЧ > МаксимумОплата Тогда
		Превышение = СкидкаПоЗЧ - МаксимумОплата;
		Сообщить("Скидка по баллам превышает стоимость материалов на " + Формат(Превышение,"ЧЦ=15; ЧДЦ=2"));
		Возврат Окр(Превышение, 2);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура СписатьБаллыПоРаботам(НомерЗаявки)
	
	Если (СписатьБаллыРаботы1 + СписатьБаллыРаботы2 + СписатьБаллыРаботы3 + СписатьБаллыРаботы4 + СписатьБаллыРаботы5 > МаксимумБалламиРаботы) Тогда
		
		//Предупреждение(НСтр("ru='Превышен лимит по списанию баллов на автоработы.'"));
		Сообщить(НСтр("ru='Превышен лимит по списанию баллов на автоработы.'"));
		
		Если НомерЗаявки = 1 Тогда
			СписатьБаллыЗапчасти1 = 0;
			СписатьБаллыРаботы1 = МаксимумБалламиРаботы - СписатьБаллыРаботы2 - СписатьБаллыРаботы3 - СписатьБаллыРаботы4 - СписатьБаллыРаботы5;
		ИначеЕсли НомерЗаявки = 2 Тогда
			СписатьБаллыЗапчасти2 = 0;
			СписатьБаллыРаботы2 = МаксимумБалламиРаботы - СписатьБаллыРаботы1 - СписатьБаллыРаботы3 - СписатьБаллыРаботы4 - СписатьБаллыРаботы5;
		ИначеЕсли НомерЗаявки = 3 Тогда
			СписатьБаллыЗапчасти3 = 0;
			СписатьБаллыРаботы3 = МаксимумБалламиРаботы - СписатьБаллыРаботы1 - СписатьБаллыРаботы2 - СписатьБаллыРаботы4 - СписатьБаллыРаботы5;
		ИначеЕсли НомерЗаявки = 4 Тогда
			СписатьБаллыЗапчасти4 = 0;
			СписатьБаллыРаботы4 = МаксимумБалламиРаботы - СписатьБаллыРаботы1 - СписатьБаллыРаботы2 - СписатьБаллыРаботы3 - СписатьБаллыРаботы5;
		Иначе
			СписатьБаллыЗапчасти5 = 0;
			СписатьБаллыРаботы5 = МаксимумБалламиРаботы - СписатьБаллыРаботы1 - СписатьБаллыРаботы2 - СписатьБаллыРаботы3 - СписатьБаллыРаботы4;
		КонецЕсли;
	КонецЕсли;
	
	ОбработатьПревышениеСкидкиПоРаботам(НомерЗаявки);
	
	Если НомерЗаявки = 1 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыРаботы1, 1, Истина);
	ИначеЕсли НомерЗаявки = 2 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыРаботы2, 2, Истина);
	ИначеЕсли НомерЗаявки = 3 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыРаботы3, 3, Истина);
	ИначеЕсли НомерЗаявки = 4 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыРаботы4, 4, Истина);
	Иначе
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыРаботы5, 5, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура СписатьБаллыПоЗапчастям(НомерЗаявки)
	
	Если НомерЗаявки = 1 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти1;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы1;
	ИначеЕсли НомерЗаявки = 2 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти2;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы2;
	ИначеЕсли НомерЗаявки = 3 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти3;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы3;
	ИначеЕсли НомерЗаявки = 4 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти4;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы4;
	Иначе
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти5;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы5;
	КонецЕсли;
	
	Если (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти4 + СписатьБаллыЗапчасти5 > МаксимумБалламиЗапчасти) Тогда
		
		//Предупреждение(НСтр("ru='Превышен лимит по списанию баллов на запчасти.'"));
		Сообщить(НСтр("ru='Превышен лимит по списанию баллов на запчасти.'"));
		
		СписатьБаллыРаботы = 0;
		
		Если НомерЗаявки = 1 Тогда
			СписатьБаллыЗапчасти = МаксимумБалламиЗапчасти - (СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти4 + СписатьБаллыЗапчасти5);
		ИначеЕсли НомерЗаявки = 2 Тогда
			СписатьБаллыЗапчасти = МаксимумБалламиЗапчасти - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти4 + СписатьБаллыЗапчасти5);
		ИначеЕсли НомерЗаявки = 3 Тогда
			СписатьБаллыЗапчасти = МаксимумБалламиЗапчасти - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти4 + СписатьБаллыЗапчасти5);
		ИначеЕсли НомерЗаявки = 4 Тогда
			СписатьБаллыЗапчасти = МаксимумБалламиЗапчасти - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти5);
		Иначе
			СписатьБаллыЗапчасти = МаксимумБалламиЗапчасти - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти4);
		КонецЕсли;
		
		//СписатьБаллыЗапчасти = МаксимумБалламиЗапчасти - ?(НомерЗаявки = 1, СписатьБаллыЗапчасти2, СписатьБаллыЗапчасти1);
		
		Если НомерЗаявки = 1 Тогда
			СписатьБаллыЗапчасти1 = МаксимумБалламиЗапчасти - (СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти4 + СписатьБаллыЗапчасти5);
		ИначеЕсли НомерЗаявки = 2 Тогда
			СписатьБаллыРаботы2 = 0;
			СписатьБаллыЗапчасти2 = МаксимумБалламиРаботы - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти4 + СписатьБаллыЗапчасти5);
		ИначеЕсли НомерЗаявки = 3 Тогда
			СписатьБаллыРаботы3 = 0;
			СписатьБаллыЗапчасти3 = МаксимумБалламиРаботы - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти4 + СписатьБаллыЗапчасти5);
		ИначеЕсли НомерЗаявки = 4 Тогда
			СписатьБаллыРаботы4 = 0;
			СписатьБаллыЗапчасти4 = МаксимумБалламиРаботы - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти5);
		Иначе
			СписатьБаллыРаботы5 = 0;
			СписатьБаллыЗапчасти5 = МаксимумБалламиРаботы - (СписатьБаллыЗапчасти1 + СписатьБаллыЗапчасти2 + СписатьБаллыЗапчасти3 + СписатьБаллыЗапчасти4);
		КонецЕсли;
	КонецЕсли;
	
	ОбработатьПревышениеСкидкиПоЗЧ(НомерЗаявки);
	
	//РассчитатьСуммуСкидкиБонусами(СписатьБаллыЗапчасти);
	
	Если НомерЗаявки = 1 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыЗапчасти1, 1, Ложь);
	ИначеЕсли НомерЗаявки = 2 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыЗапчасти2, 2, Ложь);
	ИначеЕсли НомерЗаявки = 3 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыЗапчасти3, 3, Ложь);
	ИначеЕсли НомерЗаявки = 4 Тогда
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыЗапчасти4, 4, Ложь);
	Иначе
		РассчитатьСуммуСкидкиБонусами(СписатьБаллыЗапчасти5, 5, Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьСуммуСкидкиБонусами(СуммаБаллов, НомерЗаявки, ЭтоРаботы)
	
	Если Не ЗначениеЗаполнено(ПрограммаЛояльности) Тогда
		Возврат;
	КонецЕсли;
	
	Если НомерЗаявки = 1 Тогда
		Заявка = ЗаявкаНаСервис1;
	ИначеЕсли НомерЗаявки = 2 Тогда
		Заявка = ЗаявкаНаСервис2;
	ИначеЕсли НомерЗаявки = 3 Тогда
		Заявка = ЗаявкаНаСервис3;
	ИначеЕсли НомерЗаявки = 4 Тогда
		Заявка = ЗаявкаНаСервис4;
	ИначеЕсли НомерЗаявки = 5 Тогда
		Заявка = ЗаявкаНаСервис5;
	КонецЕсли;
	
	Если ЭтоРаботы Тогда
		ТабличнаяЧасть = Заявка.Работы;
	Иначе
		ТабличнаяЧасть = Заявка.Товары;
	КонецЕсли;
	
	Если ТабличнаяЧасть.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СуммаБалловДляСписания = 0;
	
	Если НЕ ЭтоРаботы Тогда
		СуммаБалловДляСписания	  = ПрограммаЛояльности.ЗапчастиКурсБаллов * СуммаБаллов;
		МаксимальныйПроцентОплаты = ПрограммаЛояльности.ЗапчастиМаксимумБалловОплатаПроцент/100;
	Иначе
		СуммаБалловДляСписания 	  = ПрограммаЛояльности.РаботыКурсБаллов * СуммаБаллов;
		МаксимальныйПроцентОплаты = ПрограммаЛояльности.РаботыМаксимумБалловОплатаПроцент/100;
	КонецЕсли;
	
	ОбщаяСтоимостьПоТаблице = ТабличнаяЧасть.Итог("Сумма");
	
	Для каждого ТекущаяСтрока Из ТабличнаяЧасть Цикл
		
		Если СуммаБалловДляСписания = 0 Тогда
			ТекущаяСтрока.DMS_СуммаБонусныхБаллов = 0;
		Иначе 
			ТекущаяСтрока.DMS_СуммаБонусныхБаллов = ТекущаяСтрока.Сумма / ОбщаяСтоимостьПоТаблице * СуммаБалловДляСписания;
		КонецЕсли;
		
		Если МаксимальныйПроцентОплаты <> 0 Тогда
			
			Если ТекущаяСтрока.Сумма * МаксимальныйПроцентОплаты < ТекущаяСтрока.DMS_СуммаБонусныхБаллов Тогда
				ТекущаяСтрока.DMS_СуммаБонусныхБаллов = ТекущаяСтрока.Сумма * МаксимальныйПроцентОплаты;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТекущаяСтрока.Сумма < ТекущаяСтрока.DMS_СуммаБонусныхБаллов Тогда
			ТекущаяСтрока.DMS_СуммаБонусныхБаллов = ТекущаяСтрока.Сумма;
		КонецЕсли;
		
		ТекущаяСтрока.Сумма = ТекущаяСтрока.Сумма - ТекущаяСтрока.DMS_СуммаБонусныхБаллов;
		
	КонецЦикла; 
	
	Разница = СуммаБалловДляСписания - ТабличнаяЧасть.Итог("DMS_СуммаБонусныхБаллов");
	
	Если Разница = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	РаспределитьРазницу(ТабличнаяЧасть, Разница, МаксимальныйПроцентОплаты);
	
КонецПроцедуры

Процедура ОбработатьПревышениеСкидкиПоРаботам(НомерЗаявки)
	
	Если НЕ ЗначениеЗаполнено(ПрограммаЛояльности) Тогда
		Возврат;
	КонецЕсли;
		
	Если НомерЗаявки = 1 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти1;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы1;
		ТаблицаРаботы		 = ЗаявкаНаСервис1.Работы;
	ИначеЕсли НомерЗаявки = 2 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти2;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы2;
		ТаблицаРаботы 		 = ЗаявкаНаСервис2.Работы;
	ИначеЕсли НомерЗаявки = 3 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти3;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы3;
		ТаблицаРаботы 		 = ЗаявкаНаСервис3.Работы;
	ИначеЕсли НомерЗаявки = 4 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти4;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы4;
		ТаблицаРаботы 		 = ЗаявкаНаСервис4.Работы;
	Иначе
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти5;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы5;
		ТаблицаРаботы 		 = ЗаявкаНаСервис5.Работы;
	КонецЕсли;
	
	СкидкаПоРаботам = СписатьБаллыРаботы * ПрограммаЛояльности.РаботыКурсБаллов;
	ПолнаяСтоимостьРабот = ТаблицаРаботы.Итог("Сумма");
	
	МаксимумОплата = ПолнаяСтоимостьРабот * (ПрограммаЛояльности.РаботыМаксимумБалловОплатаПроцент / 100);
	
	Если МаксимумОплата = 0 ИЛИ МаксимумОплата > ПрограммаЛояльности.РаботыМаксимумБалловОплата Тогда
		
		МаксимумОплата = ПрограммаЛояльности.РаботыМаксимумБалловОплата;
		
	КонецЕсли;
	
	Если СкидкаПоРаботам > МаксимумОплата Тогда
		Сообщить("Скидка по баллам превышает стоимость работ!");
		СписатьБаллыРаботы = МаксимумОплата;
		//СписатьБаллыРаботы = Цел(ПолнаяСтоимостьРабот / ПрограммаЛояльности.РаботыКурсБаллов);
	КонецЕсли;
	
	СписатьБаллыОбщая = СписатьБаллыЗапчасти + СписатьБаллыРаботы; //DMS+
	
КонецПроцедуры

Процедура ОбработатьПревышениеСкидкиПоЗЧ(НомерЗаявки)
	
	Если НЕ ЗначениеЗаполнено(ПрограммаЛояльности) Тогда
		Возврат;
	КонецЕсли;
		
	Если НомерЗаявки = 1 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти1;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы1;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис1.Товары;
	ИначеЕсли НомерЗаявки = 2 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти2;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы2;
		ТаблицаЗапчасти 	 = ЗаявкаНаСервис2.Товары;
	ИначеЕсли НомерЗаявки = 3 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти3;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы3;
		ТаблицаЗапчасти 	 = ЗаявкаНаСервис3.Товары;
	ИначеЕсли НомерЗаявки = 4 Тогда
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти4;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы4;
		ТаблицаЗапчасти 	 = ЗаявкаНаСервис4.Товары;
	Иначе
		СписатьБаллыЗапчасти = СписатьБаллыЗапчасти5;
		СписатьБаллыРаботы	 = СписатьБаллыРаботы5;
		ТаблицаЗапчасти 	 = ЗаявкаНаСервис5.Товары;
	КонецЕсли;
	
	СкидкаПоЗЧ = СписатьБаллыЗапчасти * ПрограммаЛояльности.ЗапчастиКурсБаллов;
	ПолнаяСтоимостьЗЧ = ТаблицаЗапчасти.Итог("Сумма");
	МаксимумОплата = ПолнаяСтоимостьЗЧ * (ПрограммаЛояльности.ЗапчастиМаксимумБалловОплатаПроцент / 100);
	
	Если МаксимумОплата = 0 ИЛИ МаксимумОплата > ПрограммаЛояльности.ЗапчастиМаксимумБалловОплата Тогда
		МаксимумОплата = ПрограммаЛояльности.ЗапчастиМаксимумБалловОплата;
	КонецЕсли;
	
	Если СкидкаПоЗЧ > МаксимумОплата Тогда
		Сообщить("Скидка по баллам превышает стоимость материалов!");
		СписатьБаллыЗапчасти = МаксимумОплата;
		//СписатьБаллыЗапчасти = Цел(ПолнаяСтоимостьЗЧ / ПрограммаЛояльности.ЗапчастиКурсБаллов);
	КонецЕсли;
	
	СписатьБаллыОбщая = СписатьБаллыЗапчасти + СписатьБаллыРаботы; //DMS+
	
КонецПроцедуры

Процедура РаспределитьРазницу(ТабличнаяЧасть, СуммаБалловРазница, МаксимальныйПроцентОплаты)
	
	Для каждого ТекущаяСтрока Из ТабличнаяЧасть Цикл 
		
		Если СуммаБалловРазница = 0 Тогда
			Прервать;
		Иначе
			СуммаБалловКСписанию = ТекущаяСтрока.DMS_СуммаБонусныхБаллов + СуммаБалловРазница;
		КонецЕсли;
		
		Если МаксимальныйПроцентОплаты <> 0 Тогда
			
			Если ТекущаяСтрока.Сумма * МаксимальныйПроцентОплаты < СуммаБалловКСписанию Тогда
				
				мСуммаБалловКСписанию = ТекущаяСтрока.Сумма * МаксимальныйПроцентОплаты;
				
				СуммаБалловРазница = СуммаБалловРазница - (СуммаБалловКСписанию - мСуммаБалловКСписанию);
				
				ТекущаяСтрока.DMS_СуммаБонусныхБаллов = мСуммаБалловКСписанию;
				ТекущаяСтрока.Сумма = ТекущаяСтрока.Сумма - мСуммаБалловКСписанию;
			КонецЕсли;
			
		Иначе
			
			Если ТекущаяСтрока.Сумма >= СуммаБалловКСписанию Тогда
				ТекущаяСтрока.DMS_СуммаБонусныхБаллов = СуммаБалловКСписанию;
				ТекущаяСтрока.Сумма = ТекущаяСтрока.Сумма - СуммаБалловРазница;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьСкидкиПоЗаявке(НомерЗаявки)
	
	Если НомерЗаявки = 1 Тогда
		ТаблицаРаботы		 = ЗаявкаНаСервис1.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис1.Товары;
	ИначеЕсли НомерЗаявки = 2 Тогда
		ТаблицаРаботы 		 = ЗаявкаНаСервис2.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис2.Товары;
	ИначеЕсли НомерЗаявки = 3 Тогда
		ТаблицаРаботы 		 = ЗаявкаНаСервис3.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис3.Товары;
	ИначеЕсли НомерЗаявки = 4 Тогда
		ТаблицаРаботы 		 = ЗаявкаНаСервис4.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис4.Товары;
	Иначе
		ТаблицаРаботы 		 = ЗаявкаНаСервис5.Работы;
		ТаблицаЗапчасти		 = ЗаявкаНаСервис5.Товары;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТаблицаРаботы Цикл
		
		Если ТекСтрока.ЭтоАкция = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ВИсключениях = ПрограммаЛояльности.ИсключенияРаботы.Найти(ТекСтрока.Работа, "Авторабота");
		
		Если ЗначениеЗаполнено(ТекСтрока.Скидка) ИЛИ ЗначениеЗаполнено(ТекСтрока.СуммаСкидки) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВИсключениях) Тогда
			ТекСтрока.ПроцентСкидки = ВИсключениях.ПрограммаЛояльности.РаботыСкидкаВнешняя;
			Сообщить("На номенклатуру " + ВИсключениях.Авторабота + " скидка составляет: " + ТекСтрока.ПроцентСкидки);
		Иначе
			ТекСтрока.ПроцентСкидки = СкидкаРаботы;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.Цена) И ЗначениеЗаполнено(ТекСтрока.ДлительностьЗН) Тогда
			
			ТекСтрока.СуммаСкидки = ТекСтрока.Сумма - ТекСтрока.Сумма * (100 - ТекСтрока.ПроцентСкидки) / 100;
			ТекСтрока.Сумма = ТекСтрока.Сумма * (100 - ТекСтрока.ПроцентСкидки) / 100;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработатьПревышениеСкидкиПоРаботам(НомерЗаявки);
	
	Для Каждого ТекСтрока Из ТаблицаЗапчасти Цикл
		
		Если ТекСтрока.ЭтоАкция = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.Скидка) ИЛИ ЗначениеЗаполнено(ТекСтрока.СуммаСкидки) Тогда
			Продолжить;
		КонецЕсли;
		
		ВИсключениях = ПрограммаЛояльности.ИсключенияЗапчасти.Найти(ТекСтрока.Номенклатура, "Номенклатура");
		
		Если ЗначениеЗаполнено(ВИсключениях) Тогда
			ТекСтрока.ПроцентСкидки = ВИсключениях.ПрограммаЛояльности.ЗапчастиСкидкаВнешняя;
			Сообщить("На номенклатуру " + ВИсключениях.Номенклатура + " скидка составляет: " + ТекСтрока.ПроцентСкидки);
		Иначе
			ТекСтрока.ПроцентСкидки = СкидкаЗапчасти;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.Цена) И ЗначениеЗаполнено(ТекСтрока.Количество) Тогда
			ТекСтрока.СуммаСкидки = ТекСтрока.Сумма - ТекСтрока.Сумма * (100 - ТекСтрока.ПроцентСкидки) / 100;
			ТекСтрока.Сумма = ТекСтрока.Сумма * (100 - ТекСтрока.ПроцентСкидки) / 100;
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработатьПревышениеСкидкиПоЗЧ(НомерЗаявки);
	
	ПересчитатьСтоимости();
	
КонецПроцедуры

Процедура ПересчитатьСтоимости()
	
	СтоимостьРаботВсего				= ЗаявкаНаСервис1.Работы.Итог("Сумма");
	СтоимостьЗЧВсего				= ЗаявкаНаСервис1.Товары.Итог("Сумма");
	СтоимостьЗаявкиВсего			= Строка(СтоимостьРаботВсего + СтоимостьЗЧВсего) + " рублей";
	
	СтоимостьРаботВсегоВторая		= ЗаявкаНаСервис2.Работы.Итог("Сумма");
	СтоимостьЗЧВсегоВторая			= ЗаявкаНаСервис2.Товары.Итог("Сумма");
	СтоимостьЗаявкиВсегоВторая		= Строка(СтоимостьРаботВсегоВторая + СтоимостьЗЧВсегоВторая) + " рублей";
	
	СтоимостьРаботВсегоТретья		= ЗаявкаНаСервис3.Работы.Итог("Сумма");
	СтоимостьЗЧВсегоТретья			= ЗаявкаНаСервис3.Товары.Итог("Сумма");
	СтоимостьЗаявкиВсегоТретья		= Строка(СтоимостьРаботВсегоТретья + СтоимостьЗЧВсегоТретья) + " рублей";
	
	СтоимостьРаботВсегоЧетвертая	= ЗаявкаНаСервис4.Работы.Итог("Сумма");
	СтоимостьЗЧВсегоЧетвертая		= ЗаявкаНаСервис4.Товары.Итог("Сумма");
	СтоимостьЗаявкиВсегоЧетвртая	= Строка(СтоимостьРаботВсегоЧетвертая + СтоимостьЗЧВсегоЧетвертая) + " рублей";
	
	СтоимостьРаботВсегоПятая		= ЗаявкаНаСервис5.Работы.Итог("Сумма");
	СтоимостьЗЧВсегоЧетвертая		= ЗаявкаНаСервис5.Товары.Итог("Сумма");
	СтоимостьЗаявкиВсегоЧетвртая	= Строка(СтоимостьРаботВсегоЧетвертая + СтоимостьЗЧВсегоЧетвертая) + " рублей";
	
КонецПроцедуры

