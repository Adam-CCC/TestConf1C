

&НаКлиенте
Процедура ВремяНачалаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВремяНачала = ВернутьВремяПользования();
	ПересчитатьДлительность();
	ПроверкаКорректностиВводаДаты(ВремяНачала);
КонецПроцедуры

&НаКлиенте
Процедура ВремяОкончанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВремяОкончания = ВернутьВремяПользования();
	ПересчитатьДлительность();
	ПроверкаКорректностиВводаДаты(ВремяОкончания);
КонецПроцедуры

&НаКлиенте
Процедура ВремяНачалаПриИзменении(Элемент)
	ПересчитатьДлительность();
	ПроверкаКорректностиВводаДаты(ВремяНачала);
КонецПроцедуры

&НаКлиенте
Процедура ВремяОкончанияПриИзменении(Элемент)
	ПересчитатьДлительность();
	ПроверкаКорректностиВводаДаты(ВремяОкончания);
КонецПроцедуры   

&НаКлиенте
Функция ВернутьВремяПользования()
	ПараметрыОткрытия = Новый Структура;	
	ТекущаяДата = ТекущаяДата();
	ПараметрыОткрытия.Вставить("ВыборДаты", Истина);
	ПараметрыОткрытия.Вставить("Интервал", ДилерскийЦентр.АвтосервисШагПланирования);
	ПараметрыОткрытия.Вставить("Начало", Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущаяДата));
	ПараметрыОткрытия.Вставить("Конец", Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекущаяДата));
	ПараметрыОткрытия.Вставить("Дата", НачалоДня(ТекущаяДата));

	Время = ОткрытьФормуМодально("ОбщаяФорма.Renault_ФормаВыбораВремени", ПараметрыОткрытия);
	
	Возврат Время;	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДилерскийЦентр") Тогда 
		ДилерскийЦентр = Параметры.ДилерскийЦентр;
	КонецЕсли;
	Если Параметры.Свойство("ВремяНачала") Тогда 
		ВремяНачала = Параметры.ВремяНачала;
	КонецЕсли;
	Если Параметры.Свойство("ВремяОкончания") Тогда 
		ВремяОкончания = Параметры.ВремяОкончания;
	КонецЕсли;
	Если Параметры.Свойство("Длительность") Тогда 
		Длительность = Параметры.Длительность;
	КонецЕсли;
	Если Параметры.Свойство("Машиноместо") Тогда 
		Машиноместо = Параметры.Машиноместо;
	КонецЕсли;
	Если Параметры.Свойство("Примечание") Тогда 
		Примечание = Параметры.Примечание;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьДлительность()
	Если ЗначениеЗаполнено(ВремяНачала) И ЗначениеЗаполнено(ВремяОкончания) И ВремяОкончания > ВремяНачала Тогда
		Длительность = (ВремяОкончания - ВремяНачала)/3600;
	Иначе
		Длительность = 0;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Ок(Команда)
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ВремяНачала",ВремяНачала);
	ПараметрыЗакрытия.Вставить("ВремяОкончания",ВремяОкончания);
	ПараметрыЗакрытия.Вставить("Длительность",Длительность);
	ПараметрыЗакрытия.Вставить("Машиноместо",Машиноместо);
	ПараметрыЗакрытия.Вставить("Примечание",Примечание);
	ПараметрыЗакрытия.Вставить("Очистить",Ложь);
	
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаКорректностиВводаДаты(ИсходнаяДата)
	
	Если Не ЗначениеЗаполнено(ВремяНачала) Или Не ЗначениеЗаполнено(ВремяОкончания) Тогда 
		Возврат;
	КонецЕсли;

	Если ИсходнаяДата>ВремяОкончания Или ИсходнаяДата<ВремяНачала Тогда 
		Сообщить("Выбрана некорректная дата");
		ИсходнаяДата = Неопределено;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗакрыть(Команда)
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("Очистить",Истина);
	ЭтаФорма.Закрыть(ПараметрыЗакрытия);
КонецПроцедуры



