
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//DMS_ОбщиеСервер.МультибрендОсновноеОформление(ЭтаФорма); //мультибренд
	Scheduler = Параметры.Scheduler;
	ПараметрыДанных = ПолучитьИзВременногоХранилища(Scheduler.DynamicData.ПараметрыДанных);
	//resourceName=Groups.ИмяРесурса;
	
	//ПараметрыДанных.Groups.СписокГруппировок.Удалить("Цех");
	//ПараметрыДанных.Groups.СписокГруппировок.Добавить("Цеха", Цеха);
	
	Для Каждого Эл Из ПараметрыДанных.Groups.СписокГруппировок Цикл 
		Элементы.resourceName.СписокВыбора.Добавить(Эл.Ключ,Эл.Значение);
	КонецЦикла;
	
	//Реквизиты=ЭтотОбъект.ПолучитьРеквизиты();
	Для Каждого Эл Из Scheduler Цикл 
		Если Эл.Ключ <> "DynamicData" Тогда 
			ЭтотОбъект[Эл.Ключ] = Эл.Значение; 
		КонецЕсли; 
	КонецЦикла;	
	
	ЦветПриемки 	= Scheduler.DynamicData.Colors.ЦветПриемки;
	ЦветВыдачи		= Scheduler.DynamicData.Colors.ЦветВыдачи;
	ЦветРаботы		= Scheduler.DynamicData.Colors.ЦветРаботы;
	ЦветАктуального	= Scheduler.DynamicData.Colors.ЦветАктуального; 
	ЦветПрошедшего	= Scheduler.DynamicData.Colors.ЦветПрошедшего;
	
	Элементы.editable.Доступность		= Scheduler.DynamicData.ПраваАдминистратора;
	Элементы.eventOverlap.Доступность	= Scheduler.DynamicData.ПраваАдминистратора;
	Элементы.Календарь.Доступность		= Scheduler.DynamicData.ПраваАдминистратора;
	
	ДлительностьПриемки 				= Scheduler.DynamicData.ДлительностьПриемки;
	ДлительностьВыдачи 					= Scheduler.DynamicData.ДлительностьВыдачи;
	ПланироватьВыдачуНаПриемщика 		= Scheduler.DynamicData.ПланироватьВыдачуНаПриемщика;
	Scheduler.DynamicData.updateTimer	= updateTimer;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодОбновленияПриИзменении(Элемент) 
	Если updateTimer > 0 И updateTimer < 5 Тогда 
		updateTimer = 5; 
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПериодОбновленияРегулирование(Элемент, Направление, СтандартнаяОбработка) 
	Если updateTimer = 5 И Направление < 0 Тогда 
		updateTimer = 0; 
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ЦветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Парам = Новый Структура("Заголовок,ТекущийЦвет", Элемент.Заголовок, ЭтаФорма[Элемент.Имя]);
	ОткрытьФорму("Обработка.DMS_Диалог.Форма.ДиалогВыбораЦвета", Парам, ЭтаФорма, УникальныйИдентификатор, , ,
		Новый ОписаниеОповещения("ВыборЦвета", ЭтаФорма, Элемент.Имя));
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЭтаФорма[Элемент.Имя] = Новый Цвет();
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура кнОК(Команда)
	
	Для Каждого Эл Из Scheduler Цикл
		Если Эл.Ключ <> "DynamicData" Тогда 
			Scheduler[Эл.Ключ] = ЭтотОбъект[Эл.Ключ];
		КонецЕсли;
	КонецЦикла;
	
	Scheduler.DynamicData.Colors.ЦветПриемки 			= ЦветПриемки;
	Scheduler.DynamicData.Colors.ЦветРаботы 			= ЦветРаботы;
	Scheduler.DynamicData.Colors.ЦветВыдачи 			= ЦветВыдачи;
	Scheduler.DynamicData.Colors.ЦветАктуального		= ЦветАктуального; 
	Scheduler.DynamicData.Colors.ЦветПрошедшего			= ЦветПрошедшего;
	Scheduler.DynamicData.ТекущаяГруппировка			= resourceName;
	Scheduler.DynamicData.ДлительностьПриемки			= ДлительностьПриемки;
	Scheduler.DynamicData.ДлительностьВыдачи			= ДлительностьВыдачи;
	Scheduler.DynamicData.ПланироватьВыдачуНаПриемщика	= ПланироватьВыдачуНаПриемщика;
	Scheduler.DynamicData.updateTimer					= updateTimer;
	
	Закрыть(Scheduler);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыборЦвета(Цвет,ИмяЭлемента) Экспорт 
	
	Если Цвет=Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[ИмяЭлемента] = Цвет;
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти
 