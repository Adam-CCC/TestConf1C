Функция ПолучитьСтруктуруЦветов(ВхПользователь = Неопределено) Экспорт
	
	СтруктураЦветов = Новый Структура;
	СтруктураЦветов.Вставить("КрасныйЦвет", Новый Цвет(255, 0, 0));
	СтруктураЦветов.Вставить("ЧерныйЦвет", Новый Цвет(0, 0, 0));
	СтруктураЦветов.Вставить("ЖелтыйЦвет", Новый Цвет(255, 255, 0));
	СтруктураЦветов.Вставить("ТемноСерыйЦветФона", Новый Цвет(220, 220, 220));
	СтруктураЦветов.Вставить("ЦветФонаКнопки", Новый Цвет(255, 255, 255));
	СтруктураЦветов.Вставить("ЦветРамки", Новый Цвет(0, 0, 0));
	// Трояновский К.Е. 12.07.2019 10:13:59 {
	СтруктураЦветов.Вставить("ЗеленыйЦвет", Новый Цвет(0, 168, 0));	
	// Трояновский К.Е. 12.07.2019 10:13:59 }
	СтруктураЦветов.Вставить("ОсновнойЦвет", Новый Цвет(255,207,0)); //базовый цвет
	
	Если Не(ВхПользователь = Неопределено) Тогда
		
		Зап = Новый Запрос("ВЫБРАТЬ
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаМастера,
						   |	Renault_ПользовательскиеНастройки.ЦветФонаМастераПланирование,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаМастераЗаявка,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаМастераВработе,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаМойка,
						   |	Renault_ПользовательскиеНастройки.ЦветФонаМойкаПланирование,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаМойкаЗаявка,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаМойкаВРаботе,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаРемонт,
						   |	Renault_ПользовательскиеНастройки.ЦветФонаРемонтПланирование,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаРемонтЗаявка,
		                   |	Renault_ПользовательскиеНастройки.ЦветФонаРемонтВработе,
		                   |	Renault_ПользовательскиеНастройки.ЦветЗапланированнойРаботы,
		                   |	Renault_ПользовательскиеНастройки.ЦветПросроченнойРаботы,
		                   |	Renault_ПользовательскиеНастройки.ЦветАктивнойРаботыПлан,
