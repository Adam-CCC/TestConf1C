Процедура ОкруглитьДлительность(Длительность)
	
	ДлительностьМин = Длительность * 60;
	
	Если ДлительностьМин % 5 <> 0 Тогда 
		Длительность = (Цел(ДлительностьМин/5)+1)*5/60;
	КонецЕсли;

