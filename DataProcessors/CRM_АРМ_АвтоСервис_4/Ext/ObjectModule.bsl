Функция НайтиЗаявкуНаМойку(ОбращениеСсылка, ОбработанныеМойки = Неопределено) Экспорт
	
	Если ОбработанныеМойки = Неопределено Тогда
		ОбработанныеМойки = Новый Массив;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаМойку.Ссылка
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаМойку.Обращение = &Обращение
	|	И НЕ Renault_CRM_ЗаявкаНаМойку.Ссылка В (&ОбработанныеМойки) ";
	Запрос.УстановитьПараметр("Обращение", ОбращениеСсылка);
	Запрос.УстановитьПараметр("ОбработанныеМойки", ОбработанныеМойки);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
