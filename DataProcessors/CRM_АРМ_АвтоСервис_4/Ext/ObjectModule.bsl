Функция АктуальныйАдресКлиента(Клиент) // +++ ВалиховГА 19.10.2021 DMSREN-1301
	
	Если НЕ ЗначениеЗаполнено(Клиент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПочтовыеАдресаКлиента = ПочтовыеАдресаКлиента(Клиент);
	
	Если ПочтовыеАдресаКлиента.Количество() = 0 Тогда
		МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = Клиент;
		МенеджерЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		МенеджерЗаписи.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний;
		
		ОбработкаРедактирования = Обработки.РедактированиеКонтактнойИнформации.Создать();
		ОбработкаРедактирования.РедактированиеБезВладельца = Истина;
		ОбработкаРедактирования.РедактироватьЗапись(МенеджерЗаписи, Истина);
		
		Форма = ОбработкаРедактирования.ПолучитьФорму("ФормаЗаписиАдресаЭП", , "ФормаЗаписиАдресаЭП");
		Форма.ПоложениеОкна = ВариантПоложенияОкна.Центрировать;
		Форма.ОткрытьМодально();
		
		ПочтовыеАдресаКлиента = ПочтовыеАдресаКлиента(Клиент);
	КонецЕсли;
	
	Если ПочтовыеАдресаКлиента.Количество() = 1 Тогда
		ВыбраннаяСтрока = ПочтовыеАдресаКлиента[0];
	ИначеЕсли ПочтовыеАдресаКлиента.Количество() = 0 Тогда
		Предупреждение("Не введены контактные данные");
		Возврат Неопределено;
	Иначе
		ВыбраннаяСтрока = ПочтовыеАдресаКлиента.ВыбратьСтроку("Выберите почтовый адрес");
		Если ВыбраннаяСтрока = Неопределено Тогда
			Предупреждение("Не выбраны контактные данные");
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВыбраннаяСтрока.Представление;
	
КонецФункции

Функция ПочтовыеАдресаКлиента(Клиент) // +++ ВалиховГА 19.10.2021 DMSREN-1301
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ                      
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Комментарий
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контрагент
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)";
	Запрос.УстановитьПараметр("Контрагент", Клиент);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
