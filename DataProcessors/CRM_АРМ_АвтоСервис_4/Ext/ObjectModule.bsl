Процедура ОчиститьПланПоЭтапу(ДокОбъект, Этап)
	
	Если ТипЗнч(Этап) = Тип("Строка") Тогда
		
		IDЭтапа = Этап;
		
	Иначе
		
		IDЭтапа = Этап.IDЭтапа;
		
	КонецЕсли;
	
	ОтборПлана = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьНаборЗаписей();	
	ОтборПлана.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
	ОтборПлана.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборПлана.Прочитать();
	ОтборПлана.Очистить();
	ОтборПлана.Записать();
	
	ОтборПлана = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
	ОтборПлана.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
	ОтборПлана.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборПлана.Прочитать();
	ОтборПлана.Очистить();
	ОтборПлана.Записать();
	
	ОтборСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
	ОтборСтатуса.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
	ОтборСтатуса.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборСтатуса.Прочитать();
	ОтборСтатуса.Очистить();
	ОтборСтатуса.Записать();
	
КонецПроцедуры

Процедура ЗаписатьЭтапВРегистр(ДокОбъект, Этап, Статус) Экспорт
	
	Если ЗначениеЗаполнено(Этап.НачалоЭтапа) И ЗначениеЗаполнено(Этап.КонецЭтапа) И Этап.ДлительностьЭтапаПлан > 0  Тогда
		
		ОчиститьПланПоЭтапу(ДокОбъект, Этап);
		
		Запись = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьМенеджерЗаписи();
		Запись.Обращение = ДокОбъект.Обращение;
		Запись.РабочийДокумент = ДокОбъект.Ссылка;
		Запись.ДилерскийЦентр = ДокОбъект.ДилерскийЦентр;
		Запись.Длительность = Этап.ДлительностьЭтапаПлан;
		Запись.ВремяНачала = Этап.НачалоЭтапа;
		Запись.ВремяОкончания = Этап.КонецЭтапа;
		Запись.ЭтапРабот = Этап.IDЭтапа;
		Запись.Цех = Этап.Цех;
		
		НайденныеСтроки = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", Этап.IDЭтапа));
		Если НайденныеСтроки.Количество() > 0 Тогда
			Запись.id = Новый УникальныйИдентификатор(НайденныеСтроки[0].IDРаботы); 
		КонецЕсли; 
		
		Этап.СтатусЭтапа = Статус;
		
		Запись.Записать();
		
		ЗаписьПлана = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьПлана, Запись);
		ЗаписьПлана.Период = ТекущаяДата();
		ЗаписьПлана.Записать();
		
		ОбновитьСтатусЭтапаВрегистре(ДокОбъект, Этап);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьСтатусЭтапаВрегистре(ДокОбъект, Этап)
	
	ЗаписьСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
	ЗаписьСтатуса.РабочийДокумент = ДокОбъект.Ссылка;
	ЗаписьСтатуса.Период = ТекущаяДата();
	ЗаписьСтатуса.Обращение = ДокОбъект.Обращение;
	ЗаписьСтатуса.ДилерскийЦентр = ДокОбъект.ДилерскийЦентр;
	ЗаписьСтатуса.ЭтапРабот = Этап.IDЭтапа;
	ЗаписьСтатуса.Цех = Этап.Цех;
	ЗаписьСтатуса.СтатусРаботы = Этап.СтатусЭтапа;
	
	Если ЗначениеЗаполнено(ЗаписьСтатуса.СтатусРаботы) Тогда
		
		ЗаписьСтатуса.Записать();
		
	КонецЕсли;
	
	Если Этап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена Тогда
		Набор = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		Набор.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
		Набор.Отбор.Обращение.Установить(ДокОбъект.Обращение);
		Набор.Отбор.ДилерскийЦентр.Установить(ДокОбъект.ДилерскийЦентр);
		Набор.Отбор.ЭтапРабот.Установить(Этап.IDЭтапа);
		Набор.Отбор.Цех.Установить(Этап.Цех);
		//Набор.Отбор.Авторабота.Установить(Этап.СтатусЭтапа);
		Набор.Прочитать();
		Набор.Очистить();
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьПриемкуВыдачуВРегистр(ДокОбъект) Экспорт
	
	// У приемки и выдачи нет этапов, поэтому считаем весь документ одним этапом
	// И везде в конфигурации в качестве этапа ставят 1 вместо идентификатора
	// Поэтому при отрисовке планировщика придется ориентироваться на id работ, который тоже в документе не хранится
	
	ОтборПлана = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьНаборЗаписей();	
	ОтборПлана.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
	ОтборПлана.Записать();
	
	Запись = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьМенеджерЗаписи();		
	Запись.ДилерскийЦентр 	= ДокОбъект.ДилерскийЦентр;
	Запись.Обращение 		= ДокОбъект.Обращение;
	Запись.РабочийДокумент 	= ДокОбъект.Ссылка;
	Запись.Цех 				= ДокОбъект.Машиноместо;
	Запись.ЭтапРабот		= 1;
	Запись.id 				= Новый УникальныйИдентификатор();
	Запись.ВремяНачала 		= ДокОбъект.ВремяНачала;
	Запись.ВремяОкончания 	= ДокОбъект.ВремяОкончания;
	Запись.Длительность		= (Запись.ВремяОкончания - Запись.ВремяНачала) / 3600;
	Запись.versionID 		= 1;	
	Запись.Записать();
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаМойку") Тогда		
		Набор = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
		Набор.Отбор.Обращение.Установить(ДокОбъект.Обращение);
		Набор.Отбор.РабочийДокумент.Установить(ДокОбъект.Ссылка);
		Набор.Прочитать();
		Набор.Очистить();
		
		Запись = Набор.Добавить();		
		Запись.ДилерскийЦентр	= ДокОбъект.ДилерскийЦентр;
		Запись.Обращение		= ДокОбъект.Обращение;
		Запись.РабочийДокумент	= ДокОбъект.Ссылка;
		Запись.Цех				= ДокОбъект.Машиноместо;
		Запись.ЭтапРабот		= 1;
		Запись.Период			= ТекущаяДата();
		Запись.СтатусРаботы		= Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована;
		Набор.Записать();		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСвободныйИнтервал(ДатаПлан, ОбластьПоиска, ДлительностьРабот, ДополнительныеПараметры = Неопределено) Экспорт
	
	СвободныеИнтервалы = ПолучитьТаблицуСвободныхИнтервалов(ДатаПлан, ОбластьПоиска, ДополнительныеПараметры);
	
	// Беседин 12.01.22 заявки 1419-1420
	Если СвободныеИнтервалы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РабочийДень = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр,ДатаПлан);
	// Дополним таблицу длительностью интервалов с учетом перехода на следующий день
	СвободныеИнтервалы.Колонки.Добавить("ДлительностьМногодневного");
	СвободныеИнтервалы.Колонки.Добавить("ОкончаниеМногодневного");
	СвободныеИнтервалы.Колонки.Добавить("ОкончаниеРабот");
	СвободныеИнтервалы.Колонки.Добавить("ТаблицаСегментов");
	СвободныеИнтервалы.ЗагрузитьКолонку(СвободныеИнтервалы.ВыгрузитьКолонку("Длительность"), "ДлительностьМногодневного");
	СвободныеИнтервалы.ЗагрузитьКолонку(СвободныеИнтервалы.ВыгрузитьКолонку("ВремяОкончания"), "ОкончаниеМногодневного");
	СвободныеИнтервалы.ЗагрузитьКолонку(СвободныеИнтервалы.ВыгрузитьКолонку("ВремяНачала"), "ОкончаниеРабот");
	МассивПостов = ДилерскийЦентр.АвтосервисЦеха.НайтиСтроки(Новый Структура("ОнлайнЗапись",Истина));
	Инд = СвободныеИнтервалы.Количество() - 1;
	
	Если ОбластьПоиска = "Цеха" ИЛИ ОбластьПоиска = "Все" Тогда
		// Многодневный интервал имеет смысл только для цехов
	
		//ТекЦех = Неопределено;
		//ДлительностьМногодневного = 0;
		//НачалоМногодневного = Неопределено;
		//ОкончаниеМногодневного = Неопределено;
		//
