#Область Планировщик

// Выполняет планирование нового обращения
//
// Параметры:
//	- ДанныеОРаботах - Структура - все необходимые для планирования данные
//	- РабочийДокумент - ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля, ДокументСсылка.Renault_CRM_ЗаявкаНаСервис -
//		переменная для возврата результата планирования, чтобы выделить вновь созданный документ на планировщике
//
Процедура ЗапланироватьРаботы(ДанныеОРаботах, РабочийДокумент = Неопределено, СозданныеДокументы = Неопределено, ОнлайнЗапись = Ложь, ЕстьНаложение = Ложь, Перепланировать = Истина) Экспорт
	
	ОбращениеОбъект		= ДанныеОРаботах.Обращение.ПолучитьОбъект();
	Если ДанныеОРаботах.Свойство("ДилерскийЦентр") Тогда
		ДилерскийЦентр		= ДанныеОРаботах.ДилерскийЦентр;
	КонецЕсли;
	Клиент				= ОбращениеОбъект.Клиент;
	ВидОбращения		= ОбращениеОбъект.ВидОбращения;
	Примечание			= ОбращениеОбъект.Примечание;
	ТекущийАвтомобиль	= ОбращениеОбъект.Автомобиль;
	Автор				= ДанныеОРаботах.Автор;
	ПервичноеОбращение	= (ОбращениеОбъект.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный);
	ПланироватьРаботу	= ДанныеОРаботах.ПланироватьРаботу;
	ДлительностьПриемки = ДанныеОРаботах.ДлительностьПриемки;
	ДлительностьВыдачи 	= ДанныеОРаботах.ДлительностьВыдачи;
	ПланироватьПриемкуВыдачу = ДанныеОРаботах.ПланироватьПриемкуВыдачу;
	Если ДанныеОРаботах.Свойство("НЕСоздаватьПриемкуВыдачу") Тогда
		НЕСоздаватьПриемкуВыдачу = ДанныеОРаботах.НЕСоздаватьПриемкуВыдачу;
	Иначе
		НЕСоздаватьПриемкуВыдачу = Ложь;
	КонецЕсли;
	Автоработы			= ДанныеОРаботах.Автоработы;
	Запчасти			= ДанныеОРаботах.Запчасти;
	ИсполнительЦех		= ДанныеОРаботах.ИсполнительЦех;
	ВремяНачала			= ДанныеОРаботах.ВремяНачала;
	ОбращениеСсылка		= ОбращениеОбъект.Ссылка;
	ТолькоРаботающие	= ДанныеОРаботах.ТолькоРаботающие;
	Пост = Неопределено;
	Если ДанныеОРаботах.Свойство("ЭтоПерепланировка") Тогда
		ЭтоПерепланировка		= ДанныеОРаботах.ЭтоПерепланировка;
		Если Автоработы.Количество() <> 0 И ЭтоПерепланировка Тогда
			Пост = Автоработы[0].Машиноместо;
		КонецЕсли;
	Иначе
		ЭтоПерепланировка		= Ложь;
	КонецЕсли;
	
	ВтораяЗаявка = Неопределено;
	ДанныеОРаботах.Свойство("ВтораяЗаявка", ВтораяЗаявка);
	ЗапчастиВторая = Неопределено;
	ДанныеОРаботах.Свойство("ЗапчастиВторая", ЗапчастиВторая);
	Заявка2Ссылка = Неопределено;
	ДанныеОРаботах.Свойство("Заявка2Ссылка", Заявка2Ссылка);
	
	ТретьяЗаявка = Неопределено;
	ДанныеОРаботах.Свойство("ТретьяЗаявка", ТретьяЗаявка);
	ЗапчастиТретья = Неопределено;
	ДанныеОРаботах.Свойство("ЗапчастиТретья", ЗапчастиТретья);
	ЧетвертаяЗаявка = Неопределено;
	Заявка3Ссылка = Неопределено;
	ДанныеОРаботах.Свойство("Заявка3Ссылка", Заявка3Ссылка);
	
	ЧетвертаяЗаявка = Неопределено;
	ДанныеОРаботах.Свойство("ЧетвертаяЗаявка", ЧетвертаяЗаявка);
	ЗапчастиЧетвертая = Неопределено;
	ДанныеОРаботах.Свойство("ЗапчастиЧетвертая", ЗапчастиЧетвертая);
	Заявка4Ссылка = Неопределено;
	ДанныеОРаботах.Свойство("Заявка4Ссылка", Заявка4Ссылка);
	
	ПланироватьВыдачуНаПриемщика = Ложь;
	Если ДанныеОРаботах.Свойство("ПланироватьВыдачуНаПриемщика") Тогда
		ПланироватьВыдачуНаПриемщика = ДанныеОРаботах.ПланироватьВыдачуНаПриемщика;
	КонецЕсли; 
	
	СРазбивкойНаЭтапы = Ложь;
	Если ДанныеОРаботах.Свойство("СРазбивкойНаЭтапы")  Тогда
		СРазбивкойНаЭтапы = ДанныеОРаботах.СРазбивкойНаЭтапы;
	КонецЕсли; 
	
	НеПланироватьВторуюЗаявку = Ложь;
	Если ДанныеОРаботах.Свойство("НеПланироватьВторуюЗаявку") Тогда
		НеПланироватьВторуюЗаявку = ДанныеОРаботах.НеПланироватьВторуюЗаявку;
	КонецЕсли; 
	
	НеПланироватьТретьюЗаявку = Ложь;
	Если ДанныеОРаботах.Свойство("НеПланироватьТретьюЗаявку") Тогда
		НеПланироватьТретьюЗаявку = ДанныеОРаботах.НеПланироватьТретьюЗаявку;
	КонецЕсли;
	
	НеПланироватьЧетвертуюЗаявку = Ложь;
	Если ДанныеОРаботах.Свойство("НеПланироватьЧетвертуюЗаявку") Тогда
		НеПланироватьЧетвертуюЗаявку = ДанныеОРаботах.НеПланироватьЧетвертуюЗаявку;
	КонецЕсли; 
	
	ПриемкаСсылка = Неопределено;
	ДанныеОРаботах.Свойство("ПриемкаСсылка", ПриемкаСсылка);
	ВыдачаСсылка = Неопределено;
	ДанныеОРаботах.Свойство("ВыдачаСсылка", ВыдачаСсылка);
	
	СоздаватьПриемуВыдачу = НЕ ВидОбращения.БезПриемкиИВыдачи;
	
	НачатьТранзакцию();
	
	//+++
	//Исправление ошибки когда сделаны доп работы, он делает 2 заявки, 
	//Получим заявку, если она есть и будем ее редактировать, а не создавать повторную
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_CRM_ЗаявкаНаСервис.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаСервис.Обращение = &Обращение
		|	И Renault_CRM_ЗаявкаНаСервис.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Обращение", ДанныеОРаботах.Обращение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Заявка = Неопределено;	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Заявка = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	//---
	
	// Приемка
	Приемка = Неопределено;
	Если СоздаватьПриемуВыдачу И НЕ НЕСоздаватьПриемкуВыдачу Тогда
		
		Если ТипЗнч(ИсполнительЦех) = Тип("СправочникСсылка.Сотрудники") И ЗначениеЗаполнено(ИсполнительЦех) Тогда			
			// Оператор сам выбрал ячейку в планировщике, поэтому создаем приемку принудительно на это время
			СвободныйИнтервал = Новый Структура;
			СвободныйИнтервал.Вставить("Цех", ИсполнительЦех);
			СвободныйИнтервал.Вставить("ВремяНачала", ВремяНачала);
		ИначеЕсли НЕ ПланироватьПриемкуВыдачу Тогда 
			// Приемки не планируются, искать свободный интервал нет смысла, просто создаем документ
			СвободныйИнтервал = Новый Структура;
			СвободныйИнтервал.Вставить("Цех", Справочники.Сотрудники.ПустаяСсылка());
			СвободныйИнтервал.Вставить("ВремяНачала", ВремяНачала - ДлительностьПриемки);
		Иначе
			// Оператор выбрал цех и время работ, значит приемку надо разместить до этой даты на любого свободного сотрудника
			// Причем, учесть интервал между предыдущей приемкой и этой
			Парам = Новый Структура("ТолькоРаботающие", ТолькоРаботающие);
			ВремяНачала = ВремяНачала - ДлительностьПриемки - ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60 * 2;
			СвободныйИнтервал = ПолучитьСвободныйИнтервал(ВремяНачала, "Сотрудники", ДлительностьПриемки, Парам);
			СвободныйИнтервал.ВремяНачала = СвободныйИнтервал.ВремяНачала + ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60;
		КонецЕсли;		
			
		Приемка = Документы.Renault_CRM_ПриемкаАвтомобиля.СоздатьДокумент();
		Приемка.Дата 			= ТекущаяДата();
		Приемка.Клиент 			= Клиент;
		Приемка.VIN 			= ТекущийАвтомобиль.VIN;
		Приемка.Автомобиль 		= ТекущийАвтомобиль;
		Приемка.ВремяНачала 	= СвободныйИнтервал.ВремяНачала;
		Приемка.ВремяОкончания 	= СвободныйИнтервал.ВремяНачала + ДлительностьПриемки * 3600;
		Приемка.Автор 			= Автор;
		Приемка.Обращение 		= ОбращениеСсылка;
		Приемка.Машиноместо		= СвободныйИнтервал.Цех;
		Приемка.ДилерскийЦентр 	= ДилерскийЦентр;
		Приемка.Состояние 		= Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
		Приемка.Примечание 		= Примечание;
		Приемка.ХозОперация 	= Справочники.ХозОперации.ПрочиеДокументы;
		
		Приемка.Записать(РежимЗаписиДокумента.Запись);	
			
		Если ПланироватьПриемкуВыдачу Тогда	
			ЗаписатьПриемкуВыдачуВРегистр(Приемка);		
			ВремяНачала = Приемка.ВремяОкончания;		
			РабочийДокумент = Приемка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// Заявка на работу и вторая заявка (если есть)
		
	// У нас может быть одна или две заявки, поэтому обработаем их в цикле
	РаботыПоЗаявкам = Новый Массив;
	
	ТекущаяЗаявка = Новый Структура();
	ТекущаяЗаявка.Вставить("Работы", Автоработы);
	ТекущаяЗаявка.Вставить("Запчасти", Запчасти);
	ТекущаяЗаявка.Вставить("Планировать", Истина);
	ТекущаяЗаявка.Вставить("ВидРемонта", ДанныеОРаботах.ВидРемонта1);
	ТекущаяЗаявка.Вставить("Нормочас", ДанныеОРаботах.Нормочас1);
	ТекущаяЗаявка.Вставить("ТипЦен", ДанныеОРаботах.ТипЦен1);
	ТекущаяЗаявка.Вставить("ЗаявкаСсылка", ?(Заявка = Неопределено, Неопределено, Заявка.Ссылка));
	РаботыПоЗаявкам.Добавить(ТекущаяЗаявка);
	
	Если ВтораяЗаявка <> Неопределено И ВтораяЗаявка.Количество() > 0
			ИЛИ ЭтоПерепланировка И ЗначениеЗаполнено(Заявка2Ссылка) Тогда
		ТекущаяЗаявка = Новый Структура();
		ТекущаяЗаявка.Вставить("Работы", ВтораяЗаявка);
		ТекущаяЗаявка.Вставить("Запчасти", ЗапчастиВторая);
		ТекущаяЗаявка.Вставить("Планировать", НЕ НеПланироватьВторуюЗаявку);
		ТекущаяЗаявка.Вставить("ВидРемонта", ДанныеОРаботах.ВидРемонта2);
		ТекущаяЗаявка.Вставить("Нормочас", ДанныеОРаботах.Нормочас2);
		ТекущаяЗаявка.Вставить("ТипЦен", ДанныеОРаботах.ТипЦен2);
		ТекущаяЗаявка.Вставить("ЗаявкаСсылка", Заявка2Ссылка);
		РаботыПоЗаявкам.Добавить(ТекущаяЗаявка);
	КонецЕсли;
	
	Если ТретьяЗаявка <> Неопределено И ТретьяЗаявка.Количество() > 0
			ИЛИ ЭтоПерепланировка И ЗначениеЗаполнено(Заявка3Ссылка) Тогда
		ТекущаяЗаявка = Новый Структура();
		ТекущаяЗаявка.Вставить("Работы", ТретьяЗаявка);
		ТекущаяЗаявка.Вставить("Запчасти", ЗапчастиТретья);	
		ТекущаяЗаявка.Вставить("Планировать", НЕ НеПланироватьТретьюЗаявку);
		ТекущаяЗаявка.Вставить("ВидРемонта", ДанныеОРаботах.ВидРемонта3);
		ТекущаяЗаявка.Вставить("Нормочас", ДанныеОРаботах.Нормочас3);
		ТекущаяЗаявка.Вставить("ТипЦен", ДанныеОРаботах.ТипЦен3);
		ТекущаяЗаявка.Вставить("ЗаявкаСсылка", Заявка3Ссылка);
		РаботыПоЗаявкам.Добавить(ТекущаяЗаявка);
	КонецЕсли;
	
	Если ЧетвертаяЗаявка <> Неопределено И ЧетвертаяЗаявка.Количество() > 0
			ИЛИ ЭтоПерепланировка И ЗначениеЗаполнено(Заявка4Ссылка) Тогда
		ТекущаяЗаявка = Новый Структура();
		ТекущаяЗаявка.Вставить("Работы", ЧетвертаяЗаявка);
		ТекущаяЗаявка.Вставить("Запчасти", ЗапчастиЧетвертая);	
		ТекущаяЗаявка.Вставить("Планировать", НЕ НеПланироватьЧетвертуюЗаявку);
		ТекущаяЗаявка.Вставить("ВидРемонта", ДанныеОРаботах.ВидРемонта4);
		ТекущаяЗаявка.Вставить("Нормочас", ДанныеОРаботах.Нормочас4);
		ТекущаяЗаявка.Вставить("ТипЦен", ДанныеОРаботах.ТипЦен4);
		ТекущаяЗаявка.Вставить("ЗаявкаСсылка", Заявка4Ссылка);
		РаботыПоЗаявкам.Добавить(ТекущаяЗаявка);
	КонецЕсли;
	
	ПоследнийПост = Справочники.Цеха.ПустаяСсылка();
	
	Для ИндексПоЗаявкам = 0 По РаботыПоЗаявкам.ВГраница() Цикл
		ТекущаяЗаявка = РаботыПоЗаявкам[ИндексПоЗаявкам];
		ТекущиеАвтоработы = ТекущаяЗаявка.Работы;
		ТекущиеЗапчасти = ТекущаяЗаявка.Запчасти;
		ЗаявкаСсылка = ТекущаяЗаявка.ЗаявкаСсылка;
		
		Если ТекущиеАвтоработы.Количество() = 0 И НЕ ЭтоПерепланировка Тогда
			Продолжить;
		КонецЕсли; 
		//+++
		//Заявка = Документы.Renault_CRM_ЗаявкаНаСервис.СоздатьДокумент();
		//только для первой заявки, для остальных всегда делаем новый док
		Если ИндексПоЗаявкам = 0 ИЛИ ЭтоПерепланировка Тогда 
			Если ЗаявкаСсылка = Неопределено ИЛИ ЗаявкаСсылка = Документы.Renault_CRM_ЗаявкаНаСервис.ПустаяСсылка() Тогда
				Заявка = Документы.Renault_CRM_ЗаявкаНаСервис.СоздатьДокумент();
			Иначе 
				Заявка = ЗаявкаСсылка.ПолучитьОбъект();
				Заявка.Работы.Очистить();
				Заявка.Товары.Очистить();
				Заявка.Этапы.Очистить();
				Заявка.СоставЭтапа.Очистить();
				Заявка.СчетаНаОплату.Очистить();
				//Заявка.ДополнительноеОборудование.Очистить();
				Заявка.ВыполнениеРабот.Очистить();			
			КонецЕсли;
		Иначе 
			Заявка = Документы.Renault_CRM_ЗаявкаНаСервис.СоздатьДокумент();	
		КонецЕсли;
		//---
		ЗаполнитьЗначенияСвойств(Заявка, ТекущаяЗаявка, "ВидРемонта,Нормочас,ТипЦен");
		Если ДанныеОРаботах.КлиентОтличаетсяОтВладельца Тогда
			Заявка.Плательщик = ДанныеОРаботах.Владелец;
		Иначе
			Заявка.КлиентЯвляетсяПлательщиком = Истина;
		КонецЕсли; 
		
		ДлительностьМоек = 0;
		ДлительностьРабот = 0;
	    СтоимостьРабот = 0;
		СуммаСкидкиРабот = 0;
		
		ОбработанныеМойки = Новый Массив;
		
		//DMSREN-974
		РабочийДень = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ВремяНачала);
		//---
		Для Инд = 0 По ТекущиеАвтоработы.Количество() - 1 Цикл	
			СтрокаТаблицы = ТекущиеАвтоработы[Инд]; 
			
			Если СтрокаТаблицы.Работа = Справочники.Автоработы.Приемка 
				ИЛИ СтрокаТаблицы.Работа = Справочники.Автоработы.Выдача Тогда
				Продолжить;
			КонецЕсли;	
			
			Если СтрокаТаблицы.ЭтоМойка Тогда
				// Мойки планируем сразу, поскольку они ссылаются на другой РабочийДокумент
				// Точнее мы и планируем документ ЗаявкаНаМойку, здесь же в ТЧ работы мы оставляем мойки
				// чтобы можно было оформить Заказ-наряд
				ДлительностьМоек = ДлительностьМоек + СтрокаТаблицы.Длительность;
				ЗаявкаНаМойку = НайтиЗаявкуНаМойку(ОбращениеСсылка, ОбработанныеМойки);
				Если ЗаявкаНаМойку <> Неопределено Тогда
					// Поскольку пользователь уже явно выбрал мойку, то ищем свободное время только по этой мойке
					СписокМашиномест = Новый Массив;
					СписокМашиномест.Добавить(ЗаявкаНаМойку.Машиноместо);
					ДопПараметры = Новый Структура("СписокМашиномест,ТолькоРаботающие", СписокМашиномест, ТолькоРаботающие);
					
					Если ПланироватьРаботу Тогда
						ВремяНачала = ВремяНачала + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
						СвободныйИнтервал = ПолучитьСвободныйИнтервал(ВремяНачала, "Мойки", ЗаявкаНаМойку.Длительность, ДопПараметры);
					Иначе
						СвободныйИнтервал = Новый Структура;
						СвободныйИнтервал.Вставить("Цех", ЗаявкаНаМойку.Машиноместо);
						СвободныйИнтервал.Вставить("ВремяНачала", ВремяНачала - ЗаявкаНаМойку.Длительность * 3600); 
					КонецЕсли;
					
					ВремяНачала = СвободныйИнтервал.ВремяНачала;
					РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ВремяНачала);		
					Если СвободныйИнтервал.ВремяНачала > РабочийДень1.ВремяНачала И ПланироватьРаботу
						И СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60 > ВремяНачала Тогда
						ВремяНачала = СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
					КонецЕсли; 
	
					ЗаявкаНаМойкуОбъект = ЗаявкаНаМойку.ПолучитьОбъект();
					ЗаявкаНаМойкуОбъект.ВремяНачала = ВремяНачала;
					ЗаявкаНаМойкуОбъект.ВремяОкончания = ЗаявкаНаМойкуОбъект.ВремяНачала + ЗаявкаНаМойку.Длительность * 3600;
					ЗаявкаНаМойкуОбъект.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
					ЗаявкаНаМойкуОбъект.Записать();
					
					Если ПланироватьРаботу Тогда
						ЗаписатьПриемкуВыдачуВРегистр(ЗаявкаНаМойкуОбъект);	
					КонецЕсли; 
					
					ВремяНачала = ЗаявкаНаМойкуОбъект.ВремяОкончания;
					ОбработанныеМойки.Добавить(ЗаявкаНаМойку);
				КонецЕсли;
			КонецЕсли; 
			
			ДлительностьРабот	= ДлительностьРабот + СтрокаТаблицы.Длительность + (ДилерскийЦентр.Автосервис_ИнтервалНаПостах / 60); //+-/Блинков в рамках заявки DMSREN-724 (При планировании работы к времени самой работы прибавляется интервал на постах)
			СтоимостьРабот		= СтоимостьРабот + СтрокаТаблицы.Сумма;
			СуммаСкидкиРабот	= СуммаСкидкиРабот + СтрокаТаблицы.СуммаСкидки;
			
			НоваяСтрокаРабот	= Заявка.Работы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРабот, СтрокаТаблицы);
			НоваяСтрокаРабот.Сумма = СтрокаТаблицы.Сумма;
		КонецЦикла;
		
		ВремяНачала = ?(ВремяНачала > ТекущаяДата(), ВремяНачала, ТекущаяДата());
	
		Для каждого ТекСтрока Из ТекущиеЗапчасти Цикл
			НоваяСтрока = Заявка.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		
		Если ПланироватьРаботу И ТипЗнч(ИсполнительЦех) = Тип("СправочникСсылка.Цеха") И ЗначениеЗаполнено(ИсполнительЦех) Тогда
			// Явно указали на планировщике пост и время начала
			СвободныйИнтервал = Новый Структура;
			СвободныйИнтервал.Вставить("Цех", ИсполнительЦех);
			СвободныйИнтервал.Вставить("ВремяНачала", ВремяНачала);
			СвободныйИнтервал.Вставить("ВремяНачалаИнтервала", ВремяНачала);
			//Отбор = Новый Структура;
			//Отбор.Вставить("ОнлайнЗапись",Истина);
			//ОнлайнПосты = ДилерскийЦентр.АвтосервисЦеха.НайтиСтроки(Отбор);
			//Для Каждого ОнлайнПост Из ОнлайнПосты Цикл 
			//	Если ОнлайнПост.Цех = ИсполнительЦех Тогда
			//		ОтменитьТранзакцию();
			//		ВызватьИсключение("Выбран пост под онлайн запись. Запись невозможна");
			//		Прервать;
			//	КонецЕсли;
			//КонецЦикла;
			//+++ DMSREN-845
			//Проверим укладывается ли работа до конца дня
			Если ТекущиеАвтоработы.Количество()>0 Тогда 
				РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ВремяНачала);
				Если ВремяНачала + ТекущиеАвтоработы[0].Длительность*3600 + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60>РабочийДень1.ВремяОкончания Тогда 
					ОтменитьТранзакцию();
					ВызватьИсключение("Выберите другое время. Данная работа не укладывается в текущий день");
					Прервать;
				КонецЕсли;
			КонецЕсли;
			//---
		ИначеЕсли ПланироватьРаботу Тогда 
			Парам = Новый Структура("ТолькоРаботающие", ТолькоРаботающие);
			Если ОнлайнЗапись Тогда 
				Парам.Вставить("Онлайн",ОнлайнЗапись);
			КонецЕсли;
			Если НЕ ЭтоПерепланировка Тогда
				
				ВремяНачала = ВремяНачала + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
		
				//DMSREN-913 то что закоменчено это относится к задаче
				Парам.Вставить("ПриоритетЦех", ПоследнийПост);
				СвободныйИнтервал = ПолучитьСвободныйИнтервал(ВремяНачала, "Цеха", ДлительностьРабот - ДлительностьМоек, Парам);
				
				// Беседин 12.01.22 заявки 1419, 1420
				Если НЕ ЗначениеЗаполнено(СвободныйИнтервал) Тогда
					ОтменитьТранзакцию();  // сообщение что не так должно быть в другом месте					
					Возврат;
				КонецЕсли;  // Беседин кон
					
				ПоследнийПост = СвободныйИнтервал.Цех;
				//ДлительностьРаботы = ДлительностьРабот - ДлительностьМоек;
				//ОкруглитьДлительность(ДлительностьРаботы);
				//СвободныйИнтервал = ПолучитьСвободныйИнтервал(ВремяНачала, "Цеха", ДлительностьРаботы, Парам);				
				//---
			Иначе
				//DMSREN-974
				//Если по заявке не укладываемся в текущий день, то переносим работы на следующий
				Если РабочийДень.ВремяОкончания < ВремяНачала + ДлительностьРабот * 3600 Тогда 
					СледРабочийДень = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ВремяНачала+24*60*60);
					ВремяНачала =  СледРабочийДень.ВремяНачала;
				КонецЕсли;
				//
				СвободныйИнтервал = Новый Структура;
				СвободныйИнтервал.Вставить("Цех", Пост);
				СвободныйИнтервал.Вставить("ВремяНачала", ВремяНачала);
				СвободныйИнтервал.Вставить("ВремяНачалаИнтервала", ВремяНачала);
				СвободныйИнтервал.Вставить("КоличествоСегментов", 1);
				СвободныйИнтервал.Вставить("ТаблицаСегментов", Новый ТаблицаЗначений);
			КонецЕсли;
		Иначе
			// Не планируем работу. Только создаем документ
			СвободныйИнтервал = Новый Структура;
			СвободныйИнтервал.Вставить("Цех", Справочники.Цеха.ПустаяСсылка());
			СвободныйИнтервал.Вставить("ВремяНачала", ВремяНачала);
			СвободныйИнтервал.Вставить("ВремяНачалаИнтервала", ВремяНачала);
			СвободныйИнтервал.Вставить("КоличествоСегментов", 1);
			СвободныйИнтервал.Вставить("ТаблицаСегментов", Новый ТаблицаЗначений);
		КонецЕсли; 
		
		ВремяНачала = СвободныйИнтервал.ВремяНачала;
		РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ВремяНачала);		
		Если СвободныйИнтервал.ВремяНачала > РабочийДень1.ВремяНачала И ПланироватьРаботу
			И СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60 > ВремяНачала Тогда
			ВремяНачала = СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
		КонецЕсли;
		
		Заявка.Дата = ТекущаяДата();
		Заявка.ДилерскийЦентр = ДилерскийЦентр;
		Заявка.Автор = Автор;
		Заявка.Клиент = Клиент;
		Заявка.ВремяНачала = ВремяНачала;
		Заявка.ВремяОкончания = Заявка.ВремяНачала + (ДлительностьРабот - ДлительностьМоек) * 3600;
		Заявка.Автомобиль = ТекущийАвтомобиль;
		Заявка.VIN = ТекущийАвтомобиль.VIN;
		Заявка.Обращение = ОбращениеСсылка;
		Заявка.ХозОперация = Справочники.ХозОперации.ПрочиеДокументы;
		Заявка.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка;
		Заявка.СуммаРаботВсего = СтоимостьРабот;
		Заявка.ОбщаяДлительность = ДлительностьРабот;
		Заявка.СуммаСкидкиРаботыВсего = СуммаСкидкиРабот;
		Заявка.СтоимостьВсего = Заявка.Работы.Итог("Сумма") + Заявка.Товары.Итог("Сумма");
			
		ТекВремяНачала = Заявка.ВремяНачала;
		Для Инд = 0 По Заявка.Работы.Количество() - 1 Цикл
			ТекСтрока = Заявка.Работы[Инд]; 
			ТекСтрока.Машиноместо = СвободныйИнтервал.Цех;
			ТекСтрока.ИдентификаторРаботы = Новый УникальныйИдентификатор();
			ТекСтрока.ВремяНачала = ТекВремяНачала;
			//DMSREN-913
			//ОкруглитьДлительность(ТекСтрока.Длительность);
			//---
			ТекСтрока.ВремяОкончания = ТекВремяНачала + ТекСтрока.Длительность * 3600;
			ТекВремяНачала = ТекСтрока.ВремяОкончания;
		КонецЦикла;
		
		Если ПланироватьРаботу И ТекущаяЗаявка.Планировать Тогда
			// Создаем этапы и записываем документ			
			Если СРазбивкойНаЭтапы Тогда
				ВРазныеЭтапы(Заявка, СвободныйИнтервал.Цех, , Перепланировать);
			Иначе
				ВОдинЭтап(Заявка, СвободныйИнтервал.Цех, , Перепланировать);
			КонецЕсли; 
		
			ВремяНачала = Заявка.ВремяОкончания;
		Иначе
			// Создаем один этап и записываем документ, планы в регистр не пишем
			ВОдинЭтап(Заявка, СвободныйИнтервал.Цех, Ложь, Перепланировать);
			Если ТекущаяЗаявка.Планировать Тогда
				ВремяНачала = Заявка.ВремяОкончания;
			КонецЕсли; 
		КонецЕсли; 
		
		Если РабочийДокумент = Неопределено Тогда
			РабочийДокумент = Заявка.Ссылка;
		КонецЕсли; 
	КонецЦикла;
		
	// Выдача
	Выдача = Неопределено;
	Если СоздаватьПриемуВыдачу И Перепланировать Тогда
		
		Если ПланироватьПриемкуВыдачу Тогда
			ДопПараметры = Новый Структура;
			Если ПланироватьВыдачуНаПриемщика Тогда
				СписокМашиномест = Новый Массив;
				СписокМашиномест.Добавить(Приемка.Машиноместо);
				ДопПараметры.Вставить("СписокМашиномест", СписокМашиномест);
			КонецЕсли; 
			ДопПараметры.Вставить("ТолькоРаботающие", ТолькоРаботающие);
			
			ВремяНачала = ВремяНачала + ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60;
			СвободныйИнтервал = ПолучитьСвободныйИнтервал(ВремяНачала, "Сотрудники", ДлительностьВыдачи, ДопПараметры);
			
			// Беседин 12.01.22 заявки 1419, 1420
			Если НЕ ЗначениеЗаполнено(СвободныйИнтервал) Тогда
				ОтменитьТранзакцию();  // сообщение что не так должно быть в другом месте					
				Возврат;
			КонецЕсли;  // Беседин кон
			
			ВремяНачала = СвободныйИнтервал.ВремяНачала;
			РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ВремяНачала);
			Если СвободныйИнтервал.ВремяНачала > РабочийДень1.ВремяНачала 
				И СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60 > ВремяНачала Тогда
				ВремяНачала = СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60;
			КонецЕсли;	
			ТекЦехВыдачи = СвободныйИнтервал.Цех
		Иначе
			ТекЦехВыдачи = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;
		
		Если ВыдачаСсылка = Неопределено Тогда
			Выдача				= Документы.Renault_CRM_ВыдачаАвтомобиля.СоздатьДокумент();
			Выдача.Машиноместо		= ТекЦехВыдачи;
		Иначе
			Выдача				= ВыдачаСсылка.ПолучитьОбъект();
			//Выдача.Машиноместо		= ТекЦехВыдачи; //Уже заполнено
		КонецЕсли;
		Выдача.Дата				= ТекущаяДата();
		Выдача.ДилерскийЦентр	= ДилерскийЦентр;
		Выдача.Автор			= Автор;
		Выдача.Клиент			= Клиент;
		Выдача.ВремяНачала		= ВремяНачала;
		Выдача.ВремяОкончания	= Выдача.ВремяНачала + ДлительностьВыдачи * 3600;
		Выдача.Автомобиль		= ТекущийАвтомобиль;
		Выдача.VIN				= ТекущийАвтомобиль.VIN;
		Выдача.Обращение		= ОбращениеСсылка;
		Выдача.ХозОперация		= Справочники.ХозОперации.ПрочиеДокументы;
		Выдача.Состояние		= Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка;
		Выдача.Примечание		= Примечание;
		Выдача.Записать(РежимЗаписиДокумента.Запись);
		
		Если ПланироватьПриемкуВыдачу Тогда			
			ЗаписатьПриемкуВыдачуВРегистр(Выдача);
		КонецЕсли;	
	КонецЕсли;
	СозданныеДокументы = Новый Структура;
	СозданныеДокументы.Вставить("Приемка",Приемка);
	СозданныеДокументы.Вставить("Заявка", Заявка);
	СозданныеДокументы.Вставить("Выдача",Выдача);
	
	ЗафиксироватьТранзакцию();
	
	ЕстьНаложение = ЕстьНаложениеЭтапов(ОбращениеСсылка);
	
КонецПроцедуры

Функция ЕстьНаложениеЭтапов(Обращение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисПланРабот.Обращение,
	|	Renault_АвтосервисПланРабот.РабочийДокумент,
	|	Renault_АвтосервисПланРабот.ЭтапРабот,
	|	Renault_АвтосервисПланРабот.id,
	|	Renault_АвтосервисПланРабот.ВремяНачала,
	|	Renault_АвтосервисПланРабот.ВремяОкончания,
	|	ВЫБОР
	|		КОГДА Renault_АвтосервисПланРабот1.ВремяНачала >= Renault_АвтосервисПланРабот.ВремяОкончания
	|				И Renault_АвтосервисПланРабот1.ВремяОкончания > Renault_АвтосервисПланРабот.ВремяОкончания
	|			ТОГДА ЛОЖЬ
	|		КОГДА Renault_АвтосервисПланРабот1.ВремяНачала < Renault_АвтосервисПланРабот.ВремяНачала
	|				И Renault_АвтосервисПланРабот1.ВремяОкончания <= Renault_АвтосервисПланРабот.ВремяНачала
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ВремяНачала1
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот1
	//|		ПО Renault_АвтосервисПланРабот.Обращение = Renault_АвтосервисПланРабот1.Обращение
	|		ПО Renault_АвтосервисПланРабот.id <> Renault_АвтосервисПланРабот1.id
	|			И Renault_АвтосервисПланРабот.Цех = Renault_АвтосервисПланРабот1.Цех
	|			И (ВЫБОР
	|				КОГДА Renault_АвтосервисПланРабот1.ВремяНачала >= Renault_АвтосервисПланРабот.ВремяОкончания
	|						И Renault_АвтосервисПланРабот1.ВремяОкончания > Renault_АвтосервисПланРабот.ВремяОкончания
	|					ТОГДА ЛОЖЬ
	|				КОГДА Renault_АвтосервисПланРабот1.ВремяНачала < Renault_АвтосервисПланРабот.ВремяНачала
	|						И Renault_АвтосервисПланРабот1.ВремяОкончания <= Renault_АвтосервисПланРабот.ВремяНачала
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|ГДЕ
	|	Renault_АвтосервисПланРабот.Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Обращение);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Процедура ВОдинЭтап(ДокОбъект, Цех, ЗаписыватьПланВРегистры = Истина, Перепланировать = Истина)
	
	Если Перепланировать Тогда
		Для Каждого СтрокаЭтапа ИЗ ДокОбъект.Этапы Цикл
			ОчиститьПланПоЭтапу(ДокОбъект, СтрокаЭтапа.IDЭтапа);
		КонецЦикла;
	КонецЕсли;
	
	ДокОбъект.Этапы.Очистить();
	ДокОбъект.СоставЭтапа.Очистить();
	
	НовыйЭтап = ДокОбъект.Этапы.Добавить();	
	НовыйЭтап.Этап = "Этап 1";
	НовыйЭтап.IDЭтапа = Новый УникальныйИдентификатор();
	НовыйЭтап.НачалоЭтапа	= ДокОбъект.ВремяНачала;
	НовыйЭтап.КонецЭтапа	= ДокОбъект.ВремяОкончания;
	НовыйЭтап.Цех			= Цех;
	
	ОбщаяДлительность = 0;
	
	Для Инд = 0 По ДокОбъект.Работы.Количество() - 1 Цикл		
		ТекРабота = ДокОбъект.Работы[Инд]; 
		ТекРабота.Машиноместо = Цех;
		ТекДлительность = ТекРабота.ВремяОкончания - ТекРабота.ВремяНачала;
		
		Если НЕ ЗначениеЗаполнено(ТекРабота.IDРаботы) Тогда			
			ТекРабота.IDРаботы = Новый УникальныйИдентификатор();			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекРабота.Длительность) Тогда
			ТекРабота.Длительность = ТекДлительность / 3600;
		КонецЕсли; 
		
		НовыйСостав = ДокОбъект.СоставЭтапа.Добавить();		
		НовыйСостав.IDЭтапа = НовыйЭтап.IDЭтапа;		
		НовыйСостав.Работа = ТекРабота.Работа;
		
		НовыйСостав.IDРаботы = ТекРабота.IDРаботы;
		ОбщаяДлительность = ОбщаяДлительность + ТекДлительность;		
	КонецЦикла;
	
	НовыйЭтап.ДлительностьЭтапаПлан = ОбщаяДлительность / 3600;
	НовыйЭтап.КонецЭтапа = НовыйЭтап.НачалоЭтапа + ОбщаяДлительность;
	ДокОбъект.ВремяОкончания = НовыйЭтап.КонецЭтапа;
	
	ДокОбъект.Записать();
	
	Если ЗаписыватьПланВРегистры И Перепланировать Тогда
		ЗаписатьЭтапВРегистр(ДокОбъект, НовыйЭтап, Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ВРазныеЭтапы(ДокОбъект, Цех, ОчищатьЭтапы = Истина, Перепланировать = Истина) Экспорт
	
	//Для Каждого ТекЭтап Из ДокОбъект.Этапы Цикл		
	//	Если ТекЭтап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаНачата 
	//		ИЛИ ТекЭтап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена
	//		ИЛИ ТекЭтап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаПауза Тогда
	//		
	//		Сообщить(НСтр("ru = 'Для этой заявки разбивка на этапы невозможна!'")); 
	//		Возврат;			
	//	КонецЕсли;		
	//КонецЦикла;
	
	Если ОчищатьЭтапы И Перепланировать Тогда
		Для Каждого ТекЭтап ИЗ ДокОбъект.Этапы Цикл
			ОчиститьПланПоЭтапу(ДокОбъект, ТекЭтап.IDЭтапа);
		КонецЦикла;
		ДокОбъект.Этапы.Очистить();
		ДокОбъект.СоставЭтапа.Очистить();	
	Иначе
		// Удаляем только пустые этапы
		Инд = ДокОбъект.СоставЭтапа.Количество() - 1;
		Пока Инд >= 0 Цикл
			ТекСтрока = ДокОбъект.СоставЭтапа[Инд]; 
			НайденнаяРабота = ДокОбъект.Работы.Найти(ТекСтрока.IDРаботы, "IDРаботы");
			Если НайденнаяРабота = Неопределено Тогда
				ДокОбъект.СоставЭтапа.Удалить(ТекСтрока);
			КонецЕсли; 
			Инд = Инд - 1;
		КонецЦикла; 
		
		Инд = ДокОбъект.Этапы.Количество() - 1;
		Пока Инд >= 0 Цикл
			ТекСтрока = ДокОбъект.Этапы[Инд];
			НайденнаяСтрока = ДокОбъект.СоставЭтапа.Найти(ТекСтрока.IDЭтапа, "IDЭтапа");
			Если НайденнаяСтрока = Неопределено Тогда
				ДокОбъект.Этапы.Удалить(ТекСтрока);
			КонецЕсли; 
			Инд = Инд - 1;
		КонецЦикла; 
	КонецЕсли; 	
	
	РаботыМойки = ПолучитьСписокРаботМойки();	
	ЭтапыМойки = Новый Массив;	
	ПервыйПроход = Истина;
	
	Для Инд = 0 По ДокОбъект.Работы.Количество() - 1 Цикл
		
		ТекРабота = ДокОбъект.Работы[Инд];
		ТекРабота.Машиноместо = Цех;
		
		Если ПервыйПроход Тогда
			ТекВремяНачала = ТекРабота.ВремяНачала;
			ПервыйПроход = Ложь;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ТекРабота.Длительность) Тогда
			ТекРабота.Длительность = (ТекРабота.ВремяОкончания - ТекРабота.ВремяНачала) / 3600;
		КонецЕсли; 
		
		ТекРабота.ВремяНачала = ТекВремяНачала;
		ТекРабота.ВремяОкончания = ТекВремяНачала + ТекРабота.Длительность * 3600;
		
		// Перенос на другой день
		РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ТекРабота.ВремяНачала);
		Если ТекРабота.ВремяОкончания > РабочийДень1.ВремяОкончания Тогда
			Дельта = ТекРабота.ВремяОкончания - РабочийДень1.ВремяОкончания;
			РабочийДень2 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ТекРабота.ВремяНачала + 86400);
			
			ТекРабота.ВремяНачала = РабочийДень2.ВремяНачала;

			ТекРабота.ВремяОкончания = РабочийДень2.ВремяНачала + ТекРабота.Длительность * 3600;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(ТекРабота.IDРаботы) Тогда			
			ТекРабота.IDРаботы = Новый УникальныйИдентификатор();			
		КонецЕсли;
		
		НайденнаяСтрокаСостава = ДокОбъект.СоставЭтапа.Найти(ТекРабота.IDРаботы, "IDРаботы");
		Если НайденнаяСтрокаСостава = Неопределено Тогда
			НовыйЭтап = ДокОбъект.Этапы.Добавить();
			НовыйЭтап.Этап = "Этап " + Формат(ТекРабота.Работа, "ЧГ=0");
			НовыйЭтап.IDЭтапа = Новый УникальныйИдентификатор();
			НовыйЭтап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована;
			
			НовыйСостав = ДокОбъект.СоставЭтапа.Добавить();		
			НовыйСостав.IDЭтапа = НовыйЭтап.IDЭтапа;
			НовыйСостав.IDРаботы = ТекРабота.IDРаботы;
			НовыйСостав.Работа = ТекРабота.Работа;
		Иначе
			НовыйЭтап = ДокОбъект.Этапы.Найти(НайденнаяСтрокаСостава.IDЭтапа, "IDЭтапа");
		КонецЕсли; 		
		
		НовыйЭтап.Цех = ТекРабота.Машиноместо;
		НовыйЭтап.ДлительностьЭтапаПлан = ТекРабота.Длительность;
		НовыйЭтап.ДлительностьЭтапаФакт = ТекРабота.Длительность;
		НовыйЭтап.НачалоЭтапа = ТекРабота.ВремяНачала;
		НовыйЭтап.КонецЭтапа = ТекРабота.ВремяОкончания;		
		
		Если РаботыМойки.Найти(ТекРабота.Работа) <> Неопределено Тогда
			ЭтапыМойки.Добавить(НовыйЭтап.IDЭтапа);
		Иначе
			ТекВремяНачала = ТекРабота.ВремяОкончания + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
		КонецЕсли; 			
	КонецЦикла;
	
	ВыровнятьВремяРаботыВДокументеПоЭтапам(ДокОбъект);
	ДокОбъект.Записать();
	
	Для Каждого ТекЭтап Из ДокОбъект.Этапы Цикл
		
		Если ЭтапыМойки.Найти(ТекЭтап.IDЭтапа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Перепланировать Тогда
			Если Renault_АвтосервисПланирование.ПолучитьСтатусЭтапа(ДокОбъект.Ссылка, ТекЭтап.IDЭтапа) = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована или Renault_АвтосервисПланирование.ПолучитьСтатусЭтапа(ДокОбъект.Ссылка, ТекЭтап.IDЭтапа) = Неопределено  Тогда //+-/Блинков поиск стстуса этапа не по реквизиту тч а по регистру DMSREN-566
				ЗаписатьЭтапВРегистр(ДокОбъект, ТекЭтап, Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована); 
			Иначе
				// Обновляем только план работ
				Запись = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьМенеджерЗаписи();
				Запись.Обращение = ДокОбъект.Обращение;
				Запись.РабочийДокумент = ДокОбъект.Ссылка;
				Запись.ДилерскийЦентр = ДокОбъект.ДилерскийЦентр;
				Запись.Длительность = ТекЭтап.ДлительностьЭтапаПлан;
				Запись.ВремяНачала = ТекЭтап.НачалоЭтапа;
				Запись.ВремяОкончания = ТекЭтап.КонецЭтапа;
				Запись.ЭтапРабот = ТекЭтап.IDЭтапа;
				Запись.Цех = ТекЭтап.Цех;
				
				НайденныеСтроки = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекЭтап.IDЭтапа));
				Если НайденныеСтроки.Количество() > 0 Тогда
					Запись.id = Новый УникальныйИдентификатор(НайденныеСтроки[0].IDРаботы); 
				КонецЕсли; 
				
				Запись.Записать();
			КонецЕсли; 
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

// ВыбранныеЭтапы - СписокЗначений, содержит IDЭтапа
//
Процедура СоединитьЭтапы(ДокОбъект, ВыбранныеЭтапы) Экспорт
	
	БазовыйЭтап = Неопределено;
	ЭтапыКУдалению = Новый Массив;
	РаботыМойки = ПолучитьСписокРаботМойки();
	ЭтапыМойки = Новый Массив;
	
	Для Инд = 0 По ДокОбъект.Этапы.Количество() - 1 Цикл
		ТекЭтап = ДокОбъект.Этапы[Инд]; 
		
		// мойки. их здесь быть не должно, но они есть
		ПропуститьЭтап = Ложь;
		НайденныеСтрокиСоставЭтапа = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекЭтап.IDЭтапа));
		Для каждого ТекСтрокаСоставЭтапа Из НайденныеСтрокиСоставЭтапа Цикл
			НайденнаяРабота = ДокОбъект.Работы.Найти(ТекСтрокаСоставЭтапа.IDРаботы, "IDРаботы");
			Если РаботыМойки.Найти(НайденнаяРабота.Работа) <> Неопределено Тогда
				ПропуститьЭтап = Истина;
				ЭтапыМойки.Добавить(ТекЭтап.IDЭтапа);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ПропуститьЭтап ИЛИ ВыбранныеЭтапы.НайтиПоЗначению(ТекЭтап.IDЭтапа) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если БазовыйЭтап = Неопределено Тогда
			// Считаем этот этап базовым и к нему будем присоединять все остальные
			БазовыйЭтап = ТекЭтап;
			Продолжить;
		КонецЕсли; 
		
		// Увеличиваем длительность базового этапа. Длительность текущего этапа рассчитаем в секундах
		БазовыйЭтап.КонецЭтапа = БазовыйЭтап.КонецЭтапа + ТекЭтап.ДлительностьЭтапаПлан * 3600; // (ТекЭтап.КонецЭтапа - ТекЭтап.НачалоЭтапа);
		БазовыйЭтап.ДлительностьЭтапаПлан = БазовыйЭтап.ДлительностьЭтапаПлан + ТекЭтап.ДлительностьЭтапаПлан; // (БазовыйЭтап.КонецЭтапа - БазовыйЭтап.НачалоЭтапа) / 3600;
		
		// Перенесем текущий этап в тот же цех, что и базовый
		ТекЭтап.Цех = БазовыйЭтап.Цех;
		
		// Перекидываем работы на базовый этап, и в тот же цех
		НайденныеСтрокиСоставЭтапа = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекЭтап.IDЭтапа));
		Для каждого ТекСтрокаСоставЭтапа Из НайденныеСтрокиСоставЭтапа Цикл
			ТекСтрокаСоставЭтапа.IDЭтапа = БазовыйЭтап.IDЭтапа;
			НайденнаяРабота = ДокОбъект.Работы.Найти(ТекСтрокаСоставЭтапа.IDРаботы, "IDРаботы");
			Если НайденнаяРабота <> Неопределено Тогда
				НайденнаяРабота.Машиноместо = БазовыйЭтап.Цех;
			КонецЕсли; 
		КонецЦикла; 
		
		ЭтапыКУдалению.Добавить(ТекЭтап);		 
	КонецЦикла; 
	
	// Удаляем лишние этапы
	Для Каждого ТекЭтап Из ЭтапыКУдалению Цикл
		ОчиститьПланПоЭтапу(ДокОбъект, ТекЭтап);
		ДокОбъект.Этапы.Удалить(ТекЭтап);
	КонецЦикла; 
	
	// Теперь нужно выставить один за одним все этапы, которые правее базового, и в том же цеху
	Если БазовыйЭтап <> Неопределено Тогда
		
		КонецПредыдущегоЭтапа = БазовыйЭтап.КонецЭтапа;
		
		Для Инд = ДокОбъект.Этапы.Индекс(БазовыйЭтап) + 1 По ДокОбъект.Этапы.Количество() - 1 Цикл
			ТекЭтап = ДокОбъект.Этапы[Инд];
			
			Если ТекЭтап.Цех <> БазовыйЭтап.Цех Тогда
				Продолжить;
			КонецЕсли; 
			
			// мойки. их здесь быть не должно, но они есть		
			Если ЭтапыМойки.Найти(ТекЭтап.IDЭтапа) <> Неопределено Тогда
				Продолжить;
			КонецЕсли; 
			
			Если ТекЭтап.НачалоЭтапа <> КонецПредыдущегоЭтапа И ТекЭтап.НачалоЭтапа > БазовыйЭтап.НачалоЭтапа Тогда
				ТекЭтап.НачалоЭтапа = КонецПредыдущегоЭтапа + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
				ТекЭтап.КонецЭтапа = ТекЭтап.НачалоЭтапа + ТекЭтап.ДлительностьЭтапаПлан * 3600; 
				КонецПредыдущегоЭтапа = ТекЭтап.КонецЭтапа;
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
		
	// Выравниваем время работ, чтобы они шли по порядку и совпадали со временем выполнения этапа
	//ТекВремяНачалаЭтапа = ДокОбъект.ВремяНачала; 
	Для ИнексЭтапа = 0 По ДокОбъект.Этапы.Количество() - 1 Цикл
		ТекЭтап = ДокОбъект.Этапы[ИнексЭтапа]; 
		НайденныеСтроки = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекЭтап.IDЭтапа));
			
		КонецПрошлойРаботы = Неопределено;
		Для Инд = 0 По НайденныеСтроки.ВГраница() Цикл
			IDРаботы = НайденныеСтроки[Инд].IDРаботы;
			ТекРабота = ДокОбъект.Работы.Найти(IDРаботы, "IDРаботы");
			Если ТекРабота = Неопределено Тогда
				// При записи документа будут удалены все несуществующие ID
				Продолжить;
			КонецЕсли; 
			
			Если КонецПрошлойРаботы = Неопределено Тогда
				// Первую работу привязываем к началу этапа				
				ТекРабота.ВремяНачала = ТекЭтап.НачалоЭтапа;
				ТекРабота.ВремяОкончания = ТекРабота.ВремяНачала + ТекРабота.Длительность * 3600;
				КонецПрошлойРаботы = ТекРабота.ВремяОкончания;
				Продолжить;
			КонецЕсли; 
			
			ТекРабота.ВремяНачала = КонецПрошлойРаботы;
			ТекРабота.ВремяОкончания = ТекРабота.ВремяНачала + ТекРабота.Длительность * 3600;
			КонецПрошлойРаботы = ТекРабота.ВремяОкончания;
		КонецЦикла; 
	КонецЦикла;
	
	Для каждого ТекЭтап Из ДокОбъект.Этапы Цикл
		
		Если ЭтапыМойки.Найти(ТекЭтап.IDЭтапа) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		ЗаписатьЭтапВРегистр(ДокОбъект, ТекЭтап, Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);
	КонецЦикла; 
	
КонецПроцедуры

Процедура РазбитьЭтап(ДокОбъект, ВыбранныйЭтап) Экспорт
	
	ТекЭтап = ДокОбъект.Этапы.Найти(ВыбранныйЭтап, "IDЭтапа");
	
	Если ТекЭтап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаНачата 
		ИЛИ ТекЭтап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена
		ИЛИ ТекЭтап.СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаПауза Тогда
		
		Сообщить(НСтр("ru = 'Для этого этапа разбивка недоступна!'")); 
		Возврат;			
	КонецЕсли;		
	
	ОчиститьПланПоЭтапу(ДокОбъект, ТекЭтап.IDЭтапа);
	
	НовыеЭтапы = Новый Массив;
	НайденныеСтрокиСоставЭтапа = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекЭтап.IDЭтапа));
	Для каждого ТекСтрокаСоставЭтапа Из НайденныеСтрокиСоставЭтапа Цикл
		ТекСтрокаРаботы = ДокОбъект.Работы.Найти(ТекСтрокаСоставЭтапа.IDРаботы);
		ДокОбъект.СоставЭтапа.Удалить(ТекСтрокаСоставЭтапа);
		
		НовыйЭтап = ДокОбъект.Этапы.Добавить();
		НовыйЭтап.Этап = "Этап " + Формат(ТекСтрокаРаботы.Работа, "ЧГ=0");
		НовыйЭтап.IDЭтапа = Новый УникальныйИдентификатор();		
		НовыйЭтап.Цех = ТекСтрокаРаботы.Машиноместо;
		НовыйЭтап.ДлительностьЭтапаПлан = ТекСтрокаРаботы.Длительность;
		НовыйЭтап.ДлительностьЭтапаФакт = ТекСтрокаРаботы.Длительность;
		НовыйЭтап.НачалоЭтапа = ТекСтрокаРаботы.ВремяНачала;
		НовыйЭтап.КонецЭтапа = ТекСтрокаРаботы.ВремяОкончания;
		НовыеЭтапы.Добавить(НовыйЭтап);
		
		НовыйСостав = ДокОбъект.СоставЭтапа.Добавить();		
		НовыйСостав.IDЭтапа = НовыйЭтап.IDЭтапа;
		НовыйСостав.IDРаботы = ТекСтрокаРаботы.IDРаботы;
		НовыйСостав.Работа = ТекСтрокаРаботы.Работа;
	КонецЦикла;
	
	ДокОбъект.Этапы.Удалить(ТекЭтап);
	ДокОбъект.Этапы.Сортировать("НачалоЭтапа");
	
	Для Каждого ТекЭтап Из НовыеЭтапы Цикл
		ЗаписатьЭтапВРегистр(ДокОбъект, ТекЭтап, Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована); 
	КонецЦикла; 
	
КонецПроцедуры
 
Процедура ПеренестиДокументНаВыбранноеВремя(РабочийДокумент, НовоеВремя, НовыйИсполнительЦех) Экспорт
	
	ДокОбъект = РабочийДокумент.ПолучитьОбъект();
	//Дельта = НовоеВремя - ДокОбъект.ВремяНачала;
	Длительность = ДокОбъект.ВремяОкончания - ДокОбъект.ВремяНачала;
	ДокОбъект.ВремяНачала = НовоеВремя;
	ДокОбъект.ВремяОкончания = ДокОбъект.ВремяНачала + Длительность;
		
	Если ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля")
		ИЛИ ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля")
		ИЛИ ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаМойку") Тогда
		
		ДокОбъект.Машиноместо = НовыйИсполнительЦех;
		ДокОбъект.Записать();
		
		ЗаписатьПриемкуВыдачуВРегистр(ДокОбъект);
	Иначе
		// Заявка на сервис
		РаботыМойки = ПолучитьСписокРаботМойки();
		ПервыйПроход = Истина;
		ТекВремяНачала = НовоеВремя; // ДокОбъект.ВремяНачала;
		Для Инд = 0 По ДокОбъект.Этапы.Количество() - 1 Цикл
			ТекЭтап = ДокОбъект.Этапы[Инд]; 
			
			ТекДлительность = ТекЭтап.КонецЭтапа - ТекЭтап.НачалоЭтапа;
			ТекЭтап.Цех = НовыйИсполнительЦех;
			ТекЭтап.НачалоЭтапа = ТекВремяНачала;
			ТекЭтап.КонецЭтапа  = ТекЭтап.НачалоЭтапа + ТекДлительность;
			ТекЭтап.ДлительностьЭтапаПлан = ТекДлительность / 3600; 
			
			Если ПервыйПроход Тогда
				ДокОбъект.ВремяОкончания = ТекЭтап.КонецЭтапа;
				ПервыйПроход = Ложь;
			Иначе
				ДокОбъект.ВремяОкончания = Макс(ДокОбъект.ВремяОкончания, ТекЭтап.КонецЭтапа);
			КонецЕсли; 
			
			//Пропускаем мойки
			СтрокиСоставаЭтапа = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекЭтап.IDЭтапа));
			Если СтрокиСоставаЭтапа.Количество() = 1 Тогда
				СтрокиРаботы = ДокОбъект.Работы.НайтиСтроки(Новый Структура("IDРаботы", СтрокиСоставаЭтапа[0].IDРаботы));
				Если СтрокиРаботы.Количество() > 0 И РаботыМойки.Найти(СтрокиРаботы[0].Работа) <> Неопределено Тогда
					Продолжить;
				КонецЕсли; 
			КонецЕсли; 
			
			ТекВремяНачала = ТекЭтап.КонецЭтапа + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
			ЗаписатьЭтапВрегистр(ДокОбъект, ТекЭтап, Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);			
		КонецЦикла; 
		
		Для Каждого ТекРабота Из ДокОбъект.Работы Цикл
			ТекРабота.Машиноместо = НовыйИсполнительЦех;
			//ТекРабота.ВремяНачала = ТекРабота.ВремяНачала + Дельта;
			//ТекРабота.ВремяОкончания = ТекРабота.ВремяОкончания + Дельта;
		КонецЦикла;
		
		ДокОбъект.ОбщаяДлительность = (ДокОбъект.ВремяОкончания - ДокОбъект.ВремяНачала) / 3600;
		ДокОбъект.Записать();		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСписокРаботМойки() Экспорт
	
	РаботыМойки = Новый Массив;
	
	Для Каждого ТекСтрока Из ДилерскийЦентр.АвтосервисРаботыМойки Цикл
		РаботыМойки.Добавить(ТекСтрока.Работа.Авторабота);
	КонецЦикла; 
	
	Возврат РаботыМойки;
	
КонецФункции
 
Процедура ПеренестиЭтапНаВыбранноеВремя(РабочийДокумент, IDЭтапа, НовоеВремя, НовыйЦех) Экспорт
	
	РаботыМойки = ПолучитьСписокРаботМойки();
	
	ДокОбъект = РабочийДокумент.ПолучитьОбъект();
	ВыбранныйЭтап = ДокОбъект.Этапы.Найти(IDЭтапа, "IDЭтапа");
	Если ВыбранныйЭтап = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ВыбранныйЭтап.Цех = НовыйЦех;
	//Дельта = НовоеВремя - ВыбранныйЭтап.НачалоЭтапа;	
	ВыбранныйЭтап.НачалоЭтапа = НовоеВремя; //ВыбранныйЭтап.НачалоЭтапа + Дельта;
	ВыбранныйЭтап.КонецЭтапа  = ВыбранныйЭтап.НачалоЭтапа + ВыбранныйЭтап.ДлительностьЭтапаПлан * 3600; //ВыбранныйЭтап.КонецЭтапа + Дельта;
	ЗаписатьЭтапВрегистр(ДокОбъект, ВыбранныйЭтап, Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);	
	
	СтрокиСоставаЭтапа = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ВыбранныйЭтап.IDЭтапа));
	Если СтрокиСоставаЭтапа.Количество() = 1 Тогда
		СтрокиРаботы = ДокОбъект.Работы.НайтиСтроки(Новый Структура("IDРаботы", СтрокиСоставаЭтапа[0].IDРаботы));
		Если СтрокиРаботы.Количество() > 0 Тогда
			ТекСтрокаРабот = СтрокиРаботы[0]; 		
			ТекСтрокаРабот.Машиноместо = ВыбранныйЭтап.Цех;
			ТекСтрокаРабот.ВремяНачала = ВыбранныйЭтап.НачалоЭтапа;
			ТекСтрокаРабот.ВремяОкончания = ВыбранныйЭтап.КонецЭтапа;			
		КонецЕсли; 		
	КонецЕсли;			
	
	МинВремяНачала		= ВыбранныйЭтап.НачалоЭтапа;
	МаксВремяОкончания	= ВыбранныйЭтап.КонецЭтапа;
	
	Для каждого ТекСтрока Из ДокОбъект.Этапы Цикл
		//Пропускаем мойки
		СтрокиСоставаЭтапа = ДокОбъект.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекСтрока.IDЭтапа));
		Если СтрокиСоставаЭтапа.Количество() = 1 Тогда
			СтрокиРаботы = ДокОбъект.Работы.НайтиСтроки(Новый Структура("IDРаботы", СтрокиСоставаЭтапа[0].IDРаботы));
			Если СтрокиРаботы.Количество() > 0 И РаботыМойки.Найти(СтрокиРаботы[0].Работа) <> Неопределено Тогда
				Продолжить;
			КонецЕсли; 
		КонецЕсли; 
			
		МинВремяНачала = Мин(МинВремяНачала, ТекСтрока.НачалоЭтапа);
		МаксВремяОкончания = Макс(МаксВремяОкончания, ТекСтрока.КонецЭтапа);
	КонецЦикла; 
	
	ДокОбъект.ВремяНачала = МинВремяНачала;
	ДокОбъект.ВремяОкончания = МаксВремяОкончания;	
	ДокОбъект.ОбщаяДлительность = (ДокОбъект.ВремяОкончания - ДокОбъект.ВремяНачала) / 3600;
	ДокОбъект.Записать();		
	
КонецПроцедуры

Процедура ВыровнятьВремяРаботыВДокументеПоЭтапам(РабочийДокумент) Экспорт
	
	РаботыМойки = ПолучитьСписокРаботМойки();
	
	ПервыйПроход = Истина;
	
	Для каждого ТекЭтап Из РабочийДокумент.Этапы Цикл		
		//Пропускаем мойки
		СтрокиСоставаЭтапа = РабочийДокумент.СоставЭтапа.НайтиСтроки(Новый Структура("IDЭтапа", ТекЭтап.IDЭтапа));
		Если СтрокиСоставаЭтапа.Количество() = 1 Тогда
			СтрокиРаботы = РабочийДокумент.Работы.НайтиСтроки(Новый Структура("IDРаботы", СтрокиСоставаЭтапа[0].IDРаботы));
			Если СтрокиРаботы.Количество() > 0 И РаботыМойки.Найти(СтрокиРаботы[0].Работа) <> Неопределено Тогда
				Продолжить;
			КонецЕсли; 
		КонецЕсли; 
		
		Если ПервыйПроход Тогда
			РабочийДокумент.ВремяНачала = ТекЭтап.НачалоЭтапа;
			РабочийДокумент.ВремяОкончания = ТекЭтап.КонецЭтапа;
			ПервыйПроход = Ложь;
			Продолжить;
		КонецЕсли; 
		
		РабочийДокумент.ВремяНачала = Мин(ТекЭтап.НачалоЭтапа, РабочийДокумент.ВремяНачала);
		РабочийДокумент.ВремяОкончания = Макс(ТекЭтап.КонецЭтапа, РабочийДокумент.ВремяОкончания);
	КонецЦикла; 
	
	//РабочийДокумент.ОбщаяДлительность = (РабочийДокумент.ВремяОкончания - РабочийДокумент.ВремяНачала) / 3600;
	
КонецПроцедуры
  
Процедура ПерепланироватьСвязанныеДокументы(РабочийДокумент, ПланироватьВыдачуНаПриемщика = Истина, ТолькоРаботающие = Ложь) Экспорт
	
	Если ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ВыдачаАвтомобиля") Тогда
		// Ничего перепланировать не надо
		Возврат;
	КонецЕсли;
	
	//Проверяем наличие связанных документов
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПоСвязаннымДокументам();	
	Запрос.УстановитьПараметр("Обращение", РабочийДокумент.Обращение);
	Запрос.УстановитьПараметр("РабочийДокумент", РабочийДокумент);
	Результат = Запрос.Выполнить();
	ВыборкаРабочийДокумент = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТекДатаНачала = РабочийДокумент.ВремяОкончания;
	
	ВопросЗадан = Ложь;
	
	Если ТипЗнч(РабочийДокумент) = Тип("ДокументСсылка.Renault_CRM_ПриемкаАвтомобиля") Тогда		
		// Сперва перепланируем мойку
		ВыборкаРабочийДокумент.Сбросить();
		Пока ВыборкаРабочийДокумент.НайтиСледующий(2, "Порядок") Цикл
			ТекДлительность = ВыборкаРабочийДокумент.ВремяОкончания - ВыборкаРабочийДокумент.ВремяНачала;
			//ОтборИсключитьСлоты = Новый Массив;
			//ВыборкаСлот = ВыборкаРабочийДокумент.Выбрать();			
			//Пока ВыборкаСлот.Следующий() Цикл			 
			//	ОтборИсключитьСлоты.Добавить(ВыборкаСлот.id);
			//КонецЦикла;
			//Парам = Новый Структура("ОтборИсключитьСлоты", ОтборИсключитьСлоты);
			Парам = Новый Структура;
			Парам.Вставить("ОтборИсключитьОбращение", ВыборкаРабочийДокумент.РабочийДокумент.Обращение);
			Парам.Вставить("ПриоритетЦех", ВыборкаРабочийДокумент.РабочийДокумент.Машиноместо);
			Парам.Вставить("ТолькоРаботающие", ТолькоРаботающие);
			
			ТекДатаНачала = ТекДатаНачала + ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60;
			
			СвободныйИнтервал = ПолучитьСвободныйИнтервал(ТекДатаНачала, "Мойки", текДлительность / 3600, Парам);
			
			ТекДатаНачала = СвободныйИнтервал.ВремяНачала;
			РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ТекДатаНачала);		
			Если СвободныйИнтервал.ВремяНачала > РабочийДень1.ВремяНачала 
				И СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60 > ТекДатаНачала Тогда
				ТекДатаНачала = СвободныйИнтервал.ВремяНачалаИнтервала + ДилерскийЦентр.Автосервис_ИнтервалВПриемкахВыдачах * 60;
			КонецЕсли; 
		
			ПеренестиДокументНаВыбранноеВремя(ВыборкаРабочийДокумент.РабочийДокумент, СвободныйИнтервал.ВремяНачала, СвободныйИнтервал.Цех);
			ТекДатаНачала = ВыборкаРабочийДокумент.РабочийДокумент.ВремяОкончания;
		КонецЦикла;
		
		// Теперь перепланируем работы	
		ВыборкаРабочийДокумент.Сбросить();
		ПоследнееМашиноместо = Неопределено;
		Пока ВыборкаРабочийДокумент.НайтиСледующий(3, "Порядок") Цикл
			
			//+++Ошибка при перепланировании если работы заходят на другой день
			//Правильнее всё таки будет считать длительность каждого этапа
			//Пройдемся по этапам чтобы вычислить "реальную длительность"
				ТекДлительность = 0;
				Для Каждого Этап из ВыборкаРабочийДокумент.РабочийДокумент.Этапы Цикл 
					ТекДлительность = ТекДлительность+(Этап.КонецЭтапа - Этап.НачалоЭтапа)+ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;					
				КонецЦикла;
				ТекДлительность = ТекДлительность-ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;
			//Иначе 	
			//	ТекДлительность = ВыборкаРабочийДокумент.ВремяОкончания - ВыборкаРабочийДокумент.ВремяНачала;
			//КонецЕсли;

			Парам = Новый Структура;
			Парам.Вставить("ОтборИсключитьОбращение", ВыборкаРабочийДокумент.РабочийДокумент.Обращение);
			Если ВыборкаРабочийДокумент.РабочийДокумент.Работы.Количество() > 0 и ПоследнееМашиноместо = Неопределено Тогда
				Парам.Вставить("ПриоритетЦех", ВыборкаРабочийДокумент.РабочийДокумент.Работы[0].Машиноместо);
			Иначе 
				Парам.Вставить("ПриоритетЦех",ПоследнееМашиноместо);
			КонецЕсли; 			
			ТекДатаНачала = ТекДатаНачала + ДилерскийЦентр.Автосервис_ИнтервалНаПостах * 60;			 
			Парам.Вставить("ТолькоРаботающие", ТолькоРаботающие);
			
			СвободныйИнтервал = ПолучитьСвободныйИнтервал(ТекДатаНачала, "Цеха", текДлительность / 3600, Парам);
			Парам.Вставить("ПриоритетЦех",Неопределено);
			СвободныйИнтервалБлижайший = ПолучитьСвободныйИнтервал(ТекДатаНачала, "Цеха", текДлительность / 3600, Парам);
			Если СвободныйИнтервал.Цех <> СвободныйИнтервалБлижайший.Цех  и СвободныйИнтервал.ВремяНачала <> СвободныйИнтервалБлижайший.ВремяНачала Тогда  
				СвободныйИнтервал = СвободныйИнтервалБлижайший;
				Парам.ПриоритетЦех = СвободныйИнтервал.Цех;
			КонецЕсли;
					
			//+++
			//Надо проверить есть ли еще работы в интервале заданном в диллерском центре
			//помоему становится не актуальным, из-за того что теперь он сам распределяет на свободное время и наложиня не должно происходить
			//Пока закоментим
		//	СдвинутьИнтервалНаПостуДоп = Ложь;
		//	Запрос = Новый Запрос;
		//	Запрос.Текст = 
		//	"ВЫБРАТЬ ПЕРВЫЕ 1
		//	|	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка.Обращение КАК Обращение,
		//	|	Renault_CRM_ЗаявкаНаСервисЭтапы.КонецЭтапа КАК ВремяОкончания
		//	|ИЗ
		//	|	Документ.Renault_CRM_ЗаявкаНаСервис.Этапы КАК Renault_CRM_ЗаявкаНаСервисЭтапы
		//	|ГДЕ
		//	|	Renault_CRM_ЗаявкаНаСервисЭтапы.КонецЭтапа МЕЖДУ &ВремяНачала И &ВремяОкончания
		//	|	И Renault_CRM_ЗаявкаНаСервисЭтапы.Цех = &Цех
		//	|
