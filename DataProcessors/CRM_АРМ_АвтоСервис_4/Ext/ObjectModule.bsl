Функция ЭтоПродолжениеРабочегоДня(Время1, Время2)
	
	Если Время2 = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, Время1);
	РабочийДень2 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, Время2);	
	
	Если Время1 = РабочийДень1.ВремяОкончания И Время2 = РабочийДень2.ВремяНачала Тогда
		// Сперва проверим, может это два подряд идущих будних дня
		Если НачалоДня(Время1) + 86400 = НачалоДня(Время2) Тогда
			Возврат Истина;
		КонецЕсли; 
		
		// Получим из календаря следующий рабочий день
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Календарь.ДатаКалендаря КАК ДатаКалендаря
		|ИЗ
		|	РегистрСведений.DMS_ПроизводственныйКалендарь КАК Календарь
		|ГДЕ
		|	Календарь.ДатаКалендаря > &ДатаНачала
		|	И Календарь.ВидДня = ЗНАЧЕНИЕ(Перечисление.DMS_ВидыДнейПроизводственногоКалендаря.Рабочий)";
		Запрос.УстановитьПараметр("ДатаНачала", Время1);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() И Выборка.ДатаКалендаря = НачалоДня(Время2) Тогда
			Возврат Истина;
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат Ложь;
	
КонецФункции
 
Функция ПолучитьТаблицуСвободныхИнтервалов(ДатаВремяНачала, ОбластьПоиска, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли; 
	
	// ДатаОкончания, ДлительностьРабот, ОтборЦех, ОтборСотрудник
	РабочийДень1 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ДатаВремяНачала);
	НачалоРабочегоДня	= Час(РабочийДень1.ВремяНачала);
	КонецРабочегоДня	= Час(РабочийДень1.ВремяОкончания);
	ДатаПланирования	= НачалоДня(ДатаВремяНачала);
		
	// Проверим ДатаОкончания - если не указана, то берем месяц от ДатыНачала
	ДатаОкончания = Неопределено;
	ДополнительныеПараметры.Свойство("ДатаОкончания", ДатаОкончания);
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = КонецДня(ДобавитьМесяц(ДатаВремяНачала, 1));
	КонецЕсли; 
	
	//ДатаОкончания = НачалоДня(ДатаОкончания) + КонецРабочегоДня * 3600;
	РабочийДень2 = ПолучитьНачалоИКонецРабочегоДняДЦ(ДилерскийЦентр, ДатаОкончания);
	ДатаОкончания = РабочийДень2.ВремяОкончания;
	
	ДлительностьРабот = 0;
	Если ДополнительныеПараметры.Свойство("ДлительностьРабот") Тогда
		ДлительностьРабот = ДополнительныеПараметры.ДлительностьРабот;
	КонецЕсли; 
	
	ТолькоРаботающие = Ложь;
	Если НЕ ДополнительныеПараметры.Свойство("ТолькоРаботающие", ТолькоРаботающие) Тогда
		ТолькоРаботающие = Ложь;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСвободныеИнтервалы();
	
	//+++
	//УстановимЦехаПодОнлайнЗапись	
	//Запрос.УстановитьПараметр("ЦехаОнлайнЗапись",ДилерскийЦентр.АвтосервисЦеха.НайтиСтроки(Новый Структура("ОнлайнЗапись",Истина)));
	//---
	
	Запрос.УстановитьПараметр("ДатаПланирования", ДатаПланирования);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("ВремяПланирования", Макс(РабочийДень1.ВремяНачала, ДатаВремяНачала));
	// Переделать на получение времени начала/окончания отдельно для каждого дня.
	// Скорее всего надо передавать в запрос уже готовую таблицу рабочих дней
	Запрос.УстановитьПараметр("НачалоРабочегоДня", НачалоРабочегоДня);
	Запрос.УстановитьПараметр("КонецРабочегоДня", КонецРабочегоДня);
	
	Запрос.УстановитьПараметр("ДлинаИнтервала", ДлительностьРабот);
	Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	
	ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.ПустаяСсылка();
	Если ОбластьПоиска = "Цеха" Тогда
		ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.МашиноместоВЦеху;
	ИначеЕсли ОбластьПоиска = "Сотрудники" Тогда
		ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.МастерПриемщик;
	ИначеЕсли ОбластьПоиска = "Мойки" Тогда
		ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.Мойка;
	ИначеЕсли ОбластьПоиска = "ПодменныйАвто" Тогда
		ОтборВидМашиноместа = Перечисления.CRM_ВидыМашиноместВЦеху.ПодменныйАвтомобиль;
	КонецЕсли; 
	
	СписокМашиномест = Неопределено;
	Если ДополнительныеПараметры.Свойство("СписокМашиномест", СписокМашиномест) Тогда
		ТаблицаМашиномест = ТаблицаМашиноместИзСписка(СписокМашиномест)
	Иначе
		ТаблицаЗанятости = Неопределено;
		ТаблицаМашиномест = Обработки.CRM_АРМ_АвтоСервис_4.ПолучитьТаблицуМашиномест(ДилерскийЦентр, 
			ДатаПланирования, ДатаОкончания, Ложь, ТолькоРаботающие, Неопределено, ОтборВидМашиноместа, 
			ПараметрыСеанса.Пользователь.Сотрудник);	
	КонецЕсли;
		
	//+++
	Запрос.УстановитьПараметр("ОнлайнПосты",ВернутьОнлайнПосты());
	//---
	Запрос.УстановитьПараметр("ТаблицаМашиномест", ТаблицаМашиномест);	
	
	ТаблицаНерабочегоВремени = Неопределено;
	Если НЕ ДополнительныеПараметры.Свойство("ТаблицаНерабочегоВремени", ТаблицаНерабочегоВремени) Тогда
		Если ТолькоРаботающие Тогда
			ТаблицаНерабочегоВремени = Обработки.CRM_АРМ_АвтоСервис_4.ПолучитьТаблицуНерабочегоВремени(ДилерскийЦентр,
				ДатаПланирования, ДатаОкончания, ТаблицаМашиномест);
		Иначе		 
			ТаблицаНерабочегоВремени = Новый ТаблицаЗначений;
			ТаблицаНерабочегоВремени.Колонки.Добавить("Цех", Новый ОписаниеТипов("СправочникСсылка.Цеха,СправочникСсылка.Сотрудники"));
			ТаблицаНерабочегоВремени.Колонки.Добавить("НачалоДня", Новый ОписаниеТипов("Дата"));
			ТаблицаНерабочегоВремени.Колонки.Добавить("КонецДня", Новый ОписаниеТипов("Дата"));
			ТаблицаНерабочегоВремени.Колонки.Добавить("ВремяНачала", Новый ОписаниеТипов("Дата"));
			ТаблицаНерабочегоВремени.Колонки.Добавить("ВремяОкончания", Новый ОписаниеТипов("Дата"));			
		КонецЕсли;
	КонецЕсли; 
	Запрос.УстановитьПараметр("ТаблицаНерабочегоВремени", ТаблицаНерабочегоВремени);
	
	ОтборИсключитьСлоты = Неопределено;
	ДополнительныеПараметры.Свойство("ОтборИсключитьСлоты", ОтборИсключитьСлоты);
	Если ОтборИсключитьСлоты <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИсключитьСлоты", "Renault_АвтосервисПланРабот.id НЕ В(&СписокIDСлотов)");
		Запрос.УстановитьПараметр("СписокIDСлотов", ОтборИсключитьСлоты);
	Иначе
		Запрос.УстановитьПараметр("УсловиеИсключитьСлоты", Истина);
	КонецЕсли; 
	
	ОтборИсключитьОбращение = Неопределено;
	ДополнительныеПараметры.Свойство("ОтборИсключитьОбращение", ОтборИсключитьОбращение);
	Если ОтборИсключитьОбращение <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИсключитьОбращение", "Renault_АвтосервисПланРабот.Обращение <> &ОтборИсключитьОбращение");
		Запрос.УстановитьПараметр("ОтборИсключитьОбращение", ОтборИсключитьОбращение);
	Иначе
		Запрос.УстановитьПараметр("УсловиеИсключитьОбращение", Истина);
	КонецЕсли; 
	
	ПриоритетЦех = Неопределено;
	ДополнительныеПараметры.Свойство("ПриоритетЦех", ПриоритетЦех);
	Если ПриоритетЦех <> Неопределено Тогда
		Запрос.УстановитьПараметр("ПриоритетЦех", ПриоритетЦех);
	Иначе
		Запрос.УстановитьПараметр("ПриоритетЦех", Справочники.Цеха.ПустаяСсылка());
	КонецЕсли; 
	
	// Беседин 12.01.22 заявка 1420     
	МассивРезультатов = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	Если МассивРезультатов.Получить(2).Пустой() Тогда
		Сообщить("Не заполнен производственный календарь!", СтатусСообщения.Внимание);
	КонецЕсли;
	
	ТаблицаИнтервалов = МассивРезультатов.Получить(МассивРезультатов.Количество()-1).Выгрузить();
	//ТаблицаИнтервалов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаИнтервалов;	
	
