// Учитывает возможный перенос работы на следующий день.
// Считает только рабочие часы, отбрасывая время ночью
//
Функция ДлительностьРабочегоВремени(ДилерскийЦентр, ВремяНачала, ВремяОкончания) Экспорт
		
	Если НачалоДня(ВремяНачала) = НачалоДня(ВремяОкончания) Тогда
		// Это слот внутри дня
		РабочихСекунд = ВремяОкончания - ВремяНачала;
	Иначе
		РабочихСекунд = 0;
		ТекДень = НачалоДня(ВремяНачала);
		Пока ТекДень < ВремяОкончания Цикл
			ТекРабочийДень = Renault_АвтосервисПланированиеПовтИспользования.ПолучитьНачалоИКонецРабочегоДняАвтосервиса(ДилерскийЦентр, ТекДень);
			ТекВремяНачала = ?(ВремяНачала < ТекРабочийДень.ВремяНачала, ТекРабочийДень.ВремяНачала, ВремяНачала);
			ТекВремяОкончания = ?(ВремяОкончания > ТекРабочийДень.ВремяОкончания, ТекРабочийДень.ВремяОкончания, ВремяОкончания);
			РабочихСекунд = РабочихСекунд + (ТекВремяОкончания - ТекВремяНачала);
			ТекДень = ТекДень + 86400;
		КонецЦикла; 
	КонецЕсли; 
	
	Возврат РабочихСекунд;
	
КонецФункции

// Функция возвращает время начала и окончания работы сотрудника или цеха
//
// Параметры:
//  Дата  - Дата - Дата на которую будет получено время начала и окончания
//  Объект  - СправочникСсылка.Сотрудник или СправочникСсылка.Цех - Ссылка на объект, 
//                 который необходимо получить время начало работы и окончания
//
// Возвращаемое значение:
//   Структура   - В структуру включены значения начало и окончания рабочего дня
//   //+/Блинков переписан механизм в рамках заявки DMSREN-722
Функция ПолучитьВремяРаботы(График = Неопределено, Дата= Неопределено) Экспорт
РезультатМассив = Новый Массив;
Если График = Неопределено или Дата= Неопределено Тогда
	Возврат (РезультатМассив);
КонецЕсли; 

ГрафикРаботы = РегистрыСведений.ГрафикРаботКалендарный;
НаборГрафикРаботы = ГрафикРаботы.СоздатьНаборЗаписей();
НаборГрафикРаботы.Отбор.Дата.Установить(Дата);
НаборГрафикРаботы.Отбор.График.Установить(График);
НаборГрафикРаботы.Прочитать();
ПустаяДата = '00010101000000';
Для Каждого Запись из НаборГрафикРаботы Цикл 
	Результат = Новый Структура("ВремяНачало,ВремяОкончание,ДатаВыбора,РабочийДень,ВидИнтервала"); 
	Результат.ДатаВыбора  = Запись.Дата;
	Результат.ВремяНачало = ПустаяДата + (Результат.ДатаВыбора - ПустаяДата) + (Запись.НачалоРабочегоВремени - ПустаяДата);
	Результат.ВремяОкончание =  ПустаяДата + (Результат.ДатаВыбора - ПустаяДата) + (Запись.КонецРабочегоВремени - ПустаяДата);
	Результат.ВидИнтервала =  Запись.ВидИнтервала;
	Результат.РабочийДень  = Запись.ВидДня;
	РезультатМассив.Добавить(Результат);
КонецЦикла;
Возврат(РезультатМассив);

КонецФункции // ПолучитьВремяРаботы() //+/Блинков переписан механизм в рамках заявки DMSREN-722

