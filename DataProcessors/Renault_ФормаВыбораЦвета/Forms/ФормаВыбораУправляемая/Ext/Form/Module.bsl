&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("РедактируемыйЦвет") Тогда 
		РедактируемыйЦвет = Параметры.РедактируемыйЦвет;
	Иначе
		РедактируемыйЦвет = Новый Цвет(255, 255, 255);
	КонецЕсли;
	
	МассивАдресов = Новый Массив;
	МассивАдресов.Добавить("ПалитраЦветов");
	МассивАдресов.Добавить("Градиент");
	МассивАдресов.Добавить("КурсорПалитры");
	МассивАдресов.Добавить("КурсорКрестом");
	МассивАдресов.Добавить("ПустаяКартинка10x10");
	
	ЭтотОбъект = РеквизитФормыВЗначение("Объект");
	
	HTML = ЭтотОбъект.ПолучитьМакет("HTML").ПолучитьТекст();
	Ресурсы = ЗначениеИзСтрокиВнутр(ЭтотОбъект.ПолучитьМакет("Ресурсы").ПолучитьТекст());
	ТаблицаWebЦветов = ЗначениеИзСтрокиВнутр(ЭтотОбъект.ПолучитьМакет("ТаблицаWebЦветов").ПолучитьТекст());
	ОтображениеЦветов = ЭтотОбъект.ПолучитьМакет("ОтображениеЦветов").ПолучитьТекст();

	Для Каждого Стр Из МассивАдресов Цикл
		Адрес = ПоместитьВоВременноеХранилище(Новый Картинка(Ресурсы[Стр]));
		HTML = СтрЗаменить(HTML, "%"+Стр+"%", Адрес);
	КонецЦикла;
	
	Палитра = HTML;
	
	Соотв = ТаблицаWebЦветов.Найти(РедактируемыйЦвет, "WebЦвет");
	Если Соотв <> Неопределено Тогда
		РедактируемыйЦвет = Соотв.Цвет;
	КонецЕсли;
	
	R = РедактируемыйЦвет.Красный;
	G = РедактируемыйЦвет.Зеленый;
	B = РедактируемыйЦвет.Синий;
	
КонецПроцедуры


