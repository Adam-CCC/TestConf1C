

&НаКлиенте
Процедура ЦветПоRGB()
	
	color = Элементы.Палитра.Документ.parentWindow.eval("Starter.setRGB(" + Строка(R) + "," + Строка(G) + "," + Строка(B) + ");");
	
	H = color.h;
	S = color.s;
	V = color.v;
	
	HEX = color.hex;
	
	РедактируемыйЦвет = Новый Цвет(R, G, B);
	Элементы.ОтображениеЦветов.Документ.parentWindow.eval("setNewColor(" + Строка(R) + "," + Строка(G) + "," + Строка(B) + ")");
	
КонецПроцедуры


