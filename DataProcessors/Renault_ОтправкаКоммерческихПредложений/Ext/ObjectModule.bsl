Процедура ПодготовитьОбработчик(Обработка)
	
	//Реквизиты которые обязательно есть во всех обработках для работы с WS
	Обработка.АдресWS	 = СокрЛП(АдресСервераWS);
	Обработка.ЛогинWS	 = СокрЛП(ПользовательСервераWS);
	Обработка.ПарольWS	 =  СокрЛП(ПарольСервераWS);
	
КонецПроцедуры // ПодготовитьОбработчик()

АдресСервераWS			 = Константы.Renault_АдресWebСервисов.Получить();
ПользовательСервераWS	 = Константы.Renault_ЛогинВебСервиса.Получить();
ПарольСервераWS			 = Константы.Renault_ПарольВебСервиса.Получить();