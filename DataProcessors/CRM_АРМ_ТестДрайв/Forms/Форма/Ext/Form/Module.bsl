
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = "АРМ Тест-драйв" + " : " + Строка(ПараметрыСеанса.Пользователь);
	Менеджер = ПолучитьТекущегоМенеджера();
	
	//заполнение диаграммы
	ДатаТД = ТекущаяДата();
	ДиаграммаТекстДрайвов.АвтоОпределениеПолногоИнтервала = Ложь;
	ДиаграммаТекстДрайвов.ОбластьПостроения.Право = 1;
	ДиаграммаТекстДрайвов.ОбластьЗаголовка.ПрозрачныйФон = Истина;
	ДиаграммаТекстДрайвов.ОтображатьЛегенду = Ложь;
	Шкала = ДиаграммаТекстДрайвов.ОбластьПостроения.ШкалаВремени.Элементы[0];
	Шкала.Единица = ТипЕдиницыШкалыВремени.Час;
	Шкала.Формат = "ДФ=ЧЧ:мм";
	ОбновитьДанныеДиаграммы();
	
КонецПроцедуры

//Диаграмма тест-драйвов
&НаКлиенте
Процедура ДатаТДПриИзменении(Элемент)
	
	ОбновитьДанныеДиаграммы();
	УстановитьОтборТДПоДате(ДатаТД);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаТДРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДатаТД = ДатаТД + 86400 * Направление;
	ОбновитьДанныеДиаграммы();
	УстановитьОтборТДПоДате(ДатаТД);
	
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
	
	ОбновитьДанныеДиаграммы();
	УстановитьОтборТДПоМенеджеру()
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборТДПоМенеджеру()
	
	ТестДрайвы.Параметры.УстановитьЗначениеПараметра("Менеджер", Менеджер);
	
КонецПроцедуры

&НаКлиенте
Процедура ТестДрайвыПриИзменении(Элемент)
	
	ОбновитьДанныеДиаграммы()
	
КонецПроцедуры

&НаКлиенте
Процедура ДиаграммаГантаВыбор(Элемент, Значения, СтандартнаяОбработка, Дата)
	
	Если НЕ Тип("Массив") = ТипЗнч(Значения) Тогда
		Авто = Неопределено;
		Если Тип("ТочкаДиаграммыГанта") = ТипЗнч(Значения) Тогда
			Авто = Значения.Значение;
		ИначеЕсли Тип("ЗначениеДиаграммыГанта") = ТипЗнч(Значения) Тогда
			Авто = Значения.Точка.Значение;
		КонецЕсли;
		ОткрытьФорму("Документ.CRM_ЗаписьНаТестДрайв.Форма.ФормаДокументаУпр", Новый Структура("ДатаНачала, Автомобиль, Клиент, Менеджер, РабочийЛист, Отдел, Подразделение", Дата, Авто, ТекущийКлиент, Менеджер, ТекущийРабочийЛист, Отдел, Подразделение), ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоДате(Команда)
	
	Элементы.ТестДрайвыОтборПоДате.Пометка = НЕ Элементы.ТестДрайвыОтборПоДате.Пометка;
	УстановитьОтборТДПоДате(ДатаТД)
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборТДПоДате(Дата)

	Период = Элементы.ТестДрайвы.Период;
	
	Период.Вариант				= ВариантСтандартногоПериода.ПроизвольныйПериод;
	Если Элементы.ТестДрайвыОтборПоДате.Пометка Тогда
		Период.ДатаНачала		= НачалоДня(Дата);
		Период.ДатаОкончания	= КонецДня(Дата);
	Иначе
		Период.ДатаНачала		= '00010101';
		Период.ДатаОкончания	= '00010101';
	КонецЕсли;
    Элементы.ТестДрайвы.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусТДПриИзменении(Элемент)
	
	УстановитьОтборПостатусу()
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКлиентТДПриИзменении(Элемент)
	
	ТестДрайвы.Параметры.УстановитьЗначениеПараметра("Наименование" , "%" + ОтборКлиентТД + "%");
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоАктивныеТД(Команда)
	
	Элементы.ТестДрайвыТолькоАктивныеТД.Пометка = НЕ Элементы.ТестДрайвыТолькоАктивныеТД.Пометка;
	УстановитьОтборПостатусу()	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоСтатусу()
	
	ТолькоАктивные = Элементы.ТестДрайвыТолькоАктивныеТД.Пометка;
	Элементы.СтатусТД.ТолькоПросмотр = ТолькоАктивные;
	Если ТолькоАктивные Тогда
		Статусы = новый СписокЗначений;
		Статусы.добавить(ПредопределенноеЗначение("Перечисление.CRM_СтатусыТестДрайва.Запланировано"));
		Статусы.добавить(ПредопределенноеЗначение("Перечисление.CRM_СтатусыТестДрайва.Выполняется"));
		ТестДрайвы.Параметры.УстановитьЗначениеПараметра("СтатусДокумента", Статусы.ВыгрузитьЗначения());
	Иначе
		Статусы = новый СписокЗначений;
		Статусы.добавить(СтатусТД);
		ТестДрайвы.Параметры.УстановитьЗначениеПараметра("СтатусДокумента", Статусы.ВыгрузитьЗначения());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Изменены данные автомобиля" Тогда
		ОбновитьДанныеДиаграммы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьТД(Команда)
	
	ТекущийЭлемент = Элементы.ТестДрайв;
	ОткрытьФорму("Документ.CRM_ЗаписьНаТестДрайв.Форма.ФормаДокументаУпр", Новый Структура("Клиент", Элементы.Клиенты.ТекущиеДанные.Ссылка, "Менеджер", Менеджер, "РабочийЛист", ТекущийРабочийЛист))
	
КонецПроцедуры

&НаКлиенте
Процедура ТестДрайвыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ Копирование Тогда
		Отказ = Истина;
		ОткрытьФорму("Документ.CRM_ЗаписьНаТестДрайв.Форма.ФормаДокументаУпр", Новый Структура("ДатаНачала, Клиент, Менеджер, РабочийЛист", ДатаТД, ТекущийКлиент, Менеджер, ТекущийРабочийЛист), ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокМаршрутов(Команда)
	
	ОткрытьФорму("Справочник.CRM_МаршрутыТестДрайва.Форма.ФормаСпискаУпр", , ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УвеличитьДатуТД(Команда)
	
	ДатаТД = ДатаТД + 86400;
	УстановитьОтборТДПоДате(ДатаТД);
	ОбновитьДанныеДиаграммы();
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшитьДатуТД(Команда)
	
	ДатаТД = ДатаТД - 86400;
	УстановитьОтборТДПоДате(ДатаТД);
	ОбновитьДанныеДиаграммы();
	
КонецПроцедуры

