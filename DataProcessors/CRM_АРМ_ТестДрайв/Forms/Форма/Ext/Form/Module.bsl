&НаСервере
Процедура ОбновитьДанныеДиаграммы()
	
	ДиаграммаТекстДрайвов.Очистить();
	ДиаграммаТекстДрайвов.УстановитьПолныйИнтервал(НачалоДня(ДатаТД) + 6*60*60, КонецДня(ДатаТД));
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Объект КАК Авто
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ИспользоватьДляТестДрайва)
	|	И ЗначенияСвойствОбъектов.Значение = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗначенияСвойствОбъектов.Объект.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	ИндексыТочек = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Точка = ДиаграммаТекстДрайвов.УстановитьТочку(Выборка.Авто);
		ИндексыТочек.Вставить(Выборка.Авто, ДиаграммаТекстДрайвов.Точки.Индекс(Точка));
	КонецЦикла;
	
	Серия = ДиаграммаТекстДрайвов.УстановитьСерию("Тест-драйв");
	
	Запрос.УстановитьПараметр("Дата", ДатаТД);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаписьНаТестДрайв.Ссылка,
	|	ЗаписьНаТестДрайв.Автомобиль,
	|	ЗаписьНаТестДрайв.Клиент,
	|	ЗаписьНаТестДрайв.Начало,
	|	ЗаписьНаТестДрайв.Продолжительность,
	|	ДОБАВИТЬКДАТЕ(ЗаписьНаТестДрайв.Начало, МИНУТА, ЗаписьНаТестДрайв.Продолжительность) КАК Окончание,
	|	ЗаписьНаТестДрайв.ДатаПроведения,
	|	ЗаписьНаТестДрайв.Маршрут.Наименование,
	|	ЗаписьНаТестДрайв.СтатусДокумента
	|ИЗ
	|	Документ.CRM_ЗаписьНаТестДрайв КАК ЗаписьНаТестДрайв
	|ГДЕ
	|	ЗаписьНаТестДрайв.ДатаПроведения МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
	|	И ЗаписьНаТестДрайв.Проведен";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Индекс = ИндексыТочек.Получить(Выборка.Автомобиль);
		Если НЕ Неопределено = Индекс Тогда
			Точка = ДиаграммаТекстДрайвов.Точки.Получить(Индекс);
			Значение = ДиаграммаТекстДрайвов.ПолучитьЗначение(Точка, Серия);
			Интервал = Значение.Добавить();
			Интервал.Текст = Строка(Выборка.Ссылка) + "
			|Клиент: " + Строка(Выборка.Клиент) + "
			|Время: " + Формат(Выборка.Начало,"ДФ=ЧЧ:мм") + " - " + Формат(Выборка.Окончание,"ДФ=ЧЧ:мм") + "
			|Продолжительность: " + Строка(Выборка.Продолжительность) + " мин." + "
			|Маршрут: " + Выборка.МаршрутНаименование;
			Интервал.Начало = Выборка.ДатаПроведения + Час(Выборка.Начало)*3600 + Минута(Выборка.Начало)*60 + 120;
			Интервал.Конец = Выборка.ДатаПроведения + Час(Выборка.Окончание)*3600 + Минута(Выборка.Окончание)*60 - 120;
			Интервал.Расшифровка = Выборка.Ссылка;
			Если Выборка.СтатусДокумента = Перечисления.CRM_СтатусыТестДрайва.Завершено Тогда
				Интервал.Цвет = WebЦвета.Зеленый;
			ИначеЕсли Выборка.СтатусДокумента = Перечисления.CRM_СтатусыТестДрайва.Отменено Тогда 
				Интервал.Цвет = WebЦвета.Серый;
			ИначеЕсли Выборка.СтатусДокумента = Перечисления.CRM_СтатусыТестДрайва.Выполняется Тогда 
				Интервал.Цвет = WebЦвета.Красный;
			ИначеЕсли Выборка.СтатусДокумента = Перечисления.CRM_СтатусыТестДрайва.Запланировано Тогда 
				Интервал.Цвет = WebЦвета.Синий;
			Иначе
				Интервал.Цвет = WebЦвета.Зеленый;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекущегоМенеджера()
	
	ТекПользователь = ПараметрыСеанса.Пользователь;
	ТекМенеджер = ТекПользователь.Сотрудник;
	Возврат ТекМенеджер;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьОтборТДПоМенеджеру();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Оповестить("ОбновитьРабочийЛист");
КонецПроцедуры



