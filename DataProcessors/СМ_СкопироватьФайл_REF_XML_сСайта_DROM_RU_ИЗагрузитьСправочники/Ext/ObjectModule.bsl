Процедура ДромЗагрузкаСправочниковМодуль() Экспорт
	
	ВнутреннийАдресСервера = "https://www.drom.ru/cached_files/autoload/files/ref.xml";
	
	ИмяФайлаНазначение = ПолучитьИмяВременногоФайла("xml");
	ФайлНаДиске = Новый Файл(ИмяФайлаНазначение);
	
	Для Счетчик = 1 По 10 Цикл
		КопироватьФайл(ВнутреннийАдресСервера,ИмяФайлаНазначение);
		Если ФайлНаДиске.Существует() Тогда
			Прервать;
		КонецЕсли;
		Пауза30секунд = 30;
		КонДата = ТекущаяДата() + Пауза30секунд;
		Пока ТекущаяДата() < КонДата Цикл
			//...  
		КонецЦикла;
	КонецЦикла; 
	
	Если НЕ ФайлНаДиске.Существует() Тогда
		#Если НаКлиенте Тогда
			Попытка
				Сообщить("ОШИБКА! Информация с сайта не скопирована в файл: <"+СокрЛП(ИмяФайлаНазначение)+">",СтатусСообщения.ОченьВажное);
			Исключение
				//				
			КонецПопытки;		 
		#КонецЕсли
		Возврат;
	Иначе
		#Если НаКлиенте Тогда
			Попытка
				Сообщить("Информация с сайта скопирована в файл: <"+СокрЛП(ФайлНаДиске.ПолноеИмя)+">");
			Исключение
				//				
			КонецПопытки;		 
		#КонецЕсли
	КонецЕсли; 
	
	ёё = 0;
	
  	ЭтоМарка           = Ложь;
  	ЭтоМодель          = Ложь;	
  	ЭтоГород           = Ложь;	
   	ЭтоНовыйТип        = Ложь;	
	ЭтоТипКузова       = Ложь;
	ЭтоЦвет            = Ложь;
 	ЭтоТипКПП          = Ложь;
 	ЭтоВидДвигателя    = Ложь; 
 	ЭтоГибрид          = Ложь;
 	ЭтоПовреждения     = Ложь; 
	ЭтоГБО             = Ложь;
	ЭтоПривод          = Ложь;
	ЭтоРуль            = Ложь; 
	ЭтоРоссия          = Ложь;
	ЭтоМестонахождения = Ложь;
	ЭтоРынок           = Ложь;
	ЭтоПрограмма       = Ложь;
	ЭтоСкидка          = Ложь;
 	
	ЧтениеXML = Новый ЧтениеXML();
	
	ЧтениеXML.ОткрытьФайл(ИмяФайлаНазначение); 
	
	Счетчик = 0;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Счетчик = Счетчик + 1;
		
		Если ПределСтрок > 0 Тогда
			Если Счетчик > ПределСтрок Тогда
				Прервать;
			КонецЕсли;			                                
		КонецЕсли;
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТекущееИмя = ЧтениеXML.Имя;					
			#Если Клиент Тогда
				Если Отладка Тогда 	СМГ_Сообщить("Начало элемента "+ТекущееИмя); КонецЕсли;
			#КонецЕсли
			Если ТекущееИмя="Mark"             Тогда ЭтоМарка = Истина; 	      Наименование = ""; Артикул = "";	            	                 КонецЕсли;
			Если ТекущееИмя="Model"            Тогда ЭтоМодель = Истина;	      Наименование = ""; Артикул = ""; ДромМарка = "";                   КонецЕсли;
			Если ТекущееИмя="City"             Тогда ЭтоГород = Истина;	          Наименование = ""; Артикул = "";	                 			     КонецЕсли;
			Если ТекущееИмя="NewType"          Тогда ЭтоНовыйТип = Истина;        Наименование = ""; Артикул = "";	                 	    		 КонецЕсли;
 			Если ТекущееИмя="FrameType"        Тогда ЭтоТипКузова = Истина;       Наименование = ""; Артикул = "";	                    			 КонецЕсли;
 			Если ТекущееИмя="Color"            Тогда ЭтоЦвет = Истина;            Наименование = ""; Артикул = "";	                    			 КонецЕсли;
 			Если ТекущееИмя="Transmission"     Тогда ЭтоТипКПП = Истина;          Наименование = ""; Артикул = "";	                    			 КонецЕсли;
 			Если ТекущееИмя="EngineType"       Тогда ЭтоТипКПП = Истина;          Наименование = ""; Артикул = "";	                    			 КонецЕсли;
 			Если ТекущееИмя="HybridType"       Тогда ЭтоГибрид = Истина;          Наименование = ""; Артикул = "";	                    			 КонецЕсли;
 			Если ТекущееИмя="DamagedType"      Тогда ЭтоПовреждения = Истина;     Наименование = ""; Артикул = "";	                    			 КонецЕсли;
			Если ТекущееИмя="sGbo" Тогда 
				Если НЕ ЭтоГБО Тогда
					ЭтоГБО = Истина;          Наименование = ""; Артикул = "";	      			   
  				КонецЕсли;
			КонецЕсли;		                                                                                                                 
			Если ТекущееИмя="DriveType"        Тогда ЭтоПривод = Истина; 	      Наименование = ""; Артикул = "";	                            	 КонецЕсли;
			Если ТекущееИмя="WheelType"        Тогда ЭтоРуль = Истина;            Наименование = ""; Артикул = "";	                     			 КонецЕсли;
			Если ТекущееИмя="HaulRussiaType"   Тогда ЭтоРоссия = Истина;          Наименование = ""; Артикул = "";	    	                         КонецЕсли;
			Если ТекущееИмя="WhereaboutType"   Тогда ЭтоМестонахождения = Истина; Наименование = ""; Артикул = "";              	    	         КонецЕсли;
			Если ТекущееИмя="Market"           Тогда ЭтоРынок = Истина;	          Наименование = ""; Артикул = ""; ДромГород = "";                   КонецЕсли;
			Если ТекущееИмя="CertProgram"      Тогда ЭтоПрограмма = Истина;	      Наименование = ""; Артикул = ""; ДромМарка = ""; ДромПрограмма=""; КонецЕсли;
			Если ТекущееИмя="DiscountType"     Тогда Этоскидка = Истина;          Наименование = ""; Артикул = "";              	    	         КонецЕсли;
		КонецЕсли;                                                                                                                           
		
 		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			ТекущееЗначение = ЧтениеXML.Значение;
			#Если Клиент Тогда
				Если Отладка Тогда 	СМГ_Сообщить("Текущее значение "+ТекущееЗначение);КонецЕсли;	
			#КонецЕсли
			Если ЭтоМарка Тогда
 				Если ТекущееИмя="idMark"              Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sMark"          Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;
			КонецЕсли;
			Если ЭтоМодель Тогда
				Если ТекущееИмя="idModel"             Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sModel"         Тогда Наименование = ТекущееЗначение;			
				ИначеЕсли ТекущееИмя="idMark"         Тогда ДромМарка = Справочники.СМ_ДромМарка.НайтиПоРеквизиту("Артикул",ТекущееЗначение);
				КонецЕсли;
			КонецЕсли;
			Если ЭтоГород Тогда
				Если ТекущееИмя="idCity"               Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sCity"           Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли; 
 			Если ЭтоНовыйТип Тогда
				Если ТекущееИмя="idNewType"            Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sNewType"        Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;
 			Если ЭтоТипКузова Тогда
				Если ТекущееИмя="idFrameType"          Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sFrameType"      Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;		
 			Если ЭтоЦвет Тогда
				Если ТекущееИмя="idColor"              Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sColor"          Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;		
 			Если ЭтоТипКПП Тогда
				Если ТекущееИмя="idTransmission"       Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sTransmission"   Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;
  			Если ЭтоВидДвигателя Тогда
				Если ТекущееИмя="idEngineType"         Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sEngineType"     Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;
  			Если ЭтоГибрид Тогда
				Если ТекущееИмя="idHybridType"         Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sHybridType"     Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;
   			Если ЭтоПовреждения Тогда
				Если ТекущееИмя="idDamagedType"        Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sDamagedType"    Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли; 
   			Если ЭтоГБО Тогда
				Если ТекущееИмя="idGbo"                Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sGbo"            Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли; 
   			Если ЭтоПривод Тогда
				Если ТекущееИмя="idDriveType"          Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sDriveType"      Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли; 
    		Если ЭтоРуль Тогда
				Если ТекущееИмя="idWheelType"          Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sWheelType"      Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;
     		Если ЭтоРоссия Тогда
				Если ТекущееИмя="idHaulRussiaType"     Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sHaulRussiaType" Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли; 
      		Если ЭтоМестонахождения Тогда
				Если ТекущееИмя="Whereabouts"          Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sWhereabouts"    Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли;
			Если ЭтоРынок Тогда
				Если ТекущееИмя="idMarket"             Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sMarket"         Тогда Наименование = ТекущееЗначение;			
				ИначеЕсли ТекущееИмя="idCity"          Тогда ДромГород = Справочники.СМ_ДромГорода.НайтиПоРеквизиту("Артикул",ТекущееЗначение);
				КонецЕсли;
			КонецЕсли;
			Если ЭтоПрограмма Тогда
				Если ТекущееИмя="idCertProgram"        Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sCertProgram"    Тогда Наименование = ТекущееЗначение;			
				ИначеЕсли ТекущееИмя="idMark"          Тогда ДромМарка = Справочники.СМ_ДромМарка.НайтиПоРеквизиту("Артикул",ТекущееЗначение);
				ИначеЕсли ТекущееИмя="infoCertProgram" Тогда ДромПрограмма = ТекущееЗначение;			
				КонецЕсли;
			КонецЕсли;
			Если ЭтоСкидка Тогда
				Если ТекущееИмя="idDiscountType"       Тогда Артикул = ТекущееЗначение; 
				ИначеЕсли ТекущееИмя="sDiscountType"   Тогда Наименование = ТекущееЗначение;			
				КонецЕсли;	
			КонецЕсли; 
		КонецЕсли;	
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ТекущееИмя = ЧтениеXML.Имя;
			#Если Клиент Тогда
				Если Отладка Тогда 	СМГ_Сообщить("Конец элемента "+ТекущееИмя);	КонецЕсли;	
			#КонецЕсли	
			Если ТекущееИмя="Mark" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда
					МаркаДром =  НайтиСоздатьМарку(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = "";	ЭтоМарка = Ложь;
			КонецЕсли;
			Если ТекущееИмя="Model" Тогда
				Если Наименование <> "" И Артикул  <> "" И Не обЗначениеНеЗаполнено(ДромМарка) Тогда
					МодельДром =  НайтиСоздатьМодель(Наименование,Артикул,ДромМарка);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ДромМарка  = Справочники.СМ_ДромМарка.ПустаяСсылка();	ЭтоМодель = Ложь;
			КонецЕсли;
			Если ТекущееИмя="City" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда
					ГородДром =  НайтиСоздатьГород(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоГород = Ложь;
			КонецЕсли;
 			Если ТекущееИмя="NewType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					НовыйТипДром =  НайтиСоздатьНовыйТип(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоНовыйТип = Ложь;
			КонецЕсли;
 			Если ТекущееИмя="FrameType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ТипКузоваДром =  НайтиСоздатьТипКузова(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоТипКузова = Ложь;
			КонецЕсли;
 			Если ТекущееИмя="Color" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ЦветДром =  НайтиСоздатьЦвет(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоЦвет = Ложь;
			КонецЕсли;
 			Если ТекущееИмя="Transmission" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ТипКППДром =  НайтиСоздатьТипКПП(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоТипКПП = Ложь;
			КонецЕсли;
  			Если ТекущееИмя="EngineType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ВидДвигателяДром =  НайтиСоздатьВидДвигателя(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоВидДвигателя = Ложь;
			КонецЕсли;
  			Если ТекущееИмя="HybridType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ГибридДром =  НайтиСоздатьГибрид(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоГибрид = Ложь;
			КонецЕсли;
  			Если ТекущееИмя="DamagedType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ПоврежденияДром =  НайтиСоздатьПовреждения(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоПовреждения = Ложь;
			КонецЕсли;
  			Если ТекущееИмя="sGbo" И ЭтоГБО Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ГБОДром =  НайтиСоздатьГБО(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоГБО = Ложь;
			КонецЕсли;
  			Если ТекущееИмя="DriveType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					ПриводДром =  НайтиСоздатьПривод(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоПривод = Ложь;
			КонецЕсли;
  			Если ТекущееИмя="WheelType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					РульДром =  НайтиСоздатьРуль(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоРуль = Ложь;
			КонецЕсли;
  			Если ТекущееИмя="HaulRussiaType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					РульДром =  НайтиСоздатьРоссия(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоРоссия = Ложь;
			КонецЕсли;
   			Если ТекущееИмя="WhereaboutType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда         
 					МестонахожденияДром =  НайтиСоздатьМестонахождения(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоМестонахождения = Ложь;
			КонецЕсли;
			Если ТекущееИмя="Market" Тогда
				Если Наименование <> "" И Артикул  <> "" И Не обЗначениеНеЗаполнено(ДромГород) Тогда
					РынокДром =  НайтиСоздатьРынок(Наименование,Артикул,ДромГород);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ДромГород  = Справочники.СМ_ДромГорода.ПустаяСсылка(); ЭтоРынок = Ложь; 
			КонецЕсли;
			Если ТекущееИмя="CertProgram" Тогда
				Если Наименование <> "" И Артикул  <> "" И Не обЗначениеНеЗаполнено(ДромМарка) Тогда
					ПрограммаДром =  НайтиСоздатьСертификационнуюПрограмму(Наименование,Артикул,ДромМарка,ДромПрограмма);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ДромМарка  = Справочники.СМ_ДромМарка.ПустаяСсылка(); ЭтоСертификационнаяПрограмма = Ложь; 
			КонецЕсли;
			Если ТекущееИмя="DiscountType" Тогда
				Если Наименование <> "" И Артикул  <> "" Тогда
					СкидкаДром =  НайтиСоздатьТипыСкидок(Наименование,Артикул);
				КонецЕсли;
				Наименование = "";	Артикул = ""; ЭтоСкидка = Ложь; 
			КонецЕсли;

