                   |ИЗ
                   |    ВТ_КПриемкеОтПоставщика КАК ВТ_КПриемкеОтПоставщика
                   |
                   |ОБЪЕДИНИТЬ
                   |
                   |ВЫБРАТЬ
                   |    ВТ_КРазмещению.Документ,
                   |    ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка),
                   |    ВТ_КРазмещению.Статус,
                   |    ЛОЖЬ,
                   |    ЛОЖЬ,
                   |    ВТ_КРазмещению.Количество,
                   |    ВТ_КРазмещению.Документ.Дата
                   |ИЗ
                   |    ВТ_КРазмещению КАК ВТ_КРазмещению
                   |
                   |ОБЪЕДИНИТЬ ВСЕ
                   |
                   |ВЫБРАТЬ
                   |    ВТ_КВозврату.Документ,
                   |    ВТ_КВозврату.ЗаказНаряд,
                   |    ВТ_КВозврату.Статус,
                   |    ВТ_КВозврату.ЭтоРеализация,
                   |    ВТ_КВозврату.ТипЗН,
                   |    ВТ_КВозврату.Количество,
                   |    ВТ_КВозврату.Документ.Дата
                   |ИЗ
                   |    ВТ_КВозврату КАК ВТ_КВозврату
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |    Дата
                   |АВТОУПОРЯДОЧИВАНИЕ";

    Пакет = Запрос.ВыполнитьПакет();
    Кол = Пакет.Количество();

	ДокументыТЗ = Пакет[Кол - 2].Выгрузить();
	ДокументыТЗ.Свернуть("Документ");
	ДокументыМасс = ДокументыТЗ.ВыгрузитьКолонку("Документ");
	
	// Подменяем док. корректировок на поступления
	
	ПоступленияКорректировки = Новый Соответствие;
	
	Для каждого Док Из ДокументыМасс Цикл
	
		Если ТипЗнч(Док) <> Тип("ДокументСсылка.КорректировкаПоступления") Тогда
			Продолжить;
		КонецЕсли;
		
		тДок = Док;
		Сч = 0;
		Пока ТипЗнч(тДок) <> Тип("ДокументСсылка.ПоступлениеТоваров") Цикл
			тДок = тДок.ДокументОснование;
			
			Сч = Сч + 1;
			Если Сч > 50 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ПоступленияКорректировки.Вставить(Док, тДок);
		
	КонецЦикла;
	
	ТоварыТЗ = Пакет[Кол - 2].Выгрузить();
	СписокДокументовТЗ = Пакет[Кол - 1].Выгрузить();	
	
	Для каждого КлючЗначение Из ПоступленияКорректировки Цикл
		
		Отбор = Новый Структура("Документ", КлючЗначение.Ключ);
		
		Для каждого стр Из ТоварыТЗ.НайтиСтроки(Отбор) Цикл
			стр.Документ = КлючЗначение.Значение;
		КонецЦикла;	
			
		Для каждого стр Из СписокДокументовТЗ.НайтиСтроки(Отбор) Цикл
			стр.Документ = КлючЗначение.Значение;
		КонецЦикла;	
		
	КонецЦикла;
	
	ТоварыТЗ.Свернуть("Документ, ЗаказНаряд, Номенклатура, ХарактеристикаНоменклатуры, Артикул, Статус", "Количество");
	СписокДокументовТЗ.Свернуть("Дата, Документ, ЗаказНаряд, Статус, ЭтоРеализация, ТипЗН", "Количество");
	
	// В результате свертки могут появится строки с нулевым или отрицательным количеством
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТоварыТЗ", ТоварыТЗ);
	Запрос.УстановитьПараметр("СписокДокументовТЗ", СписокДокументовТЗ);

    Запрос.Текст = "ВЫБРАТЬ *  ПОМЕСТИТЬ ВТ_Товары ИЗ &ТоварыТЗ КАК ТоварыТЗ ГДЕ ТоварыТЗ.Количество > 0;
					|ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_СписокДокументов ИЗ &СписокДокументовТЗ КАК СписокДокументовТЗ ГДЕ СписокДокументовТЗ.Количество > 0;
					|ВЫБРАТЬ * ИЗ ВТ_Товары; ВЫБРАТЬ * ИЗ ВТ_СписокДокументов";

    Результат = Запрос.ВыполнитьПакет();

    Товары.Загрузить(Результат[2].Выгрузить());
    СписокДокументов.Загрузить(Результат[3].Выгрузить());

КонецПроцедуры

