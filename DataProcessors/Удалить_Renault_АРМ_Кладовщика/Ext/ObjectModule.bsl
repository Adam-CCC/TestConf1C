
Процедура ОбновитьТаблицы() Экспорт
    СписокДокументов.Очистить();
    Товары.Очистить();

    Если Не ЗначениеЗаполнено(СкладКомпании) Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;

    Запрос.УстановитьПараметр("СкладКомпании",         СкладКомпании);
    Запрос.УстановитьПараметр("ПодразделениеКомпании", СкладКомпании.Подразделение);
    Запрос.УстановитьПараметр("ВидСклада",             СкладКомпании.ВидСклада);

    Запрос.Текст = "ВЫБРАТЬ
                   |    ОстаткиТоваровОрдерныйСклад.Регистратор.ДокументОснование КАК ДокументОснование,
                   |    ОстаткиТоваровОрдерныйСклад.Номенклатура,
                   |    ОстаткиТоваровОрдерныйСклад.ХарактеристикаНоменклатуры,
                   |    СУММА(ОстаткиТоваровОрдерныйСклад.Количество) КАК Количество
                   |ПОМЕСТИТЬ ВТ_Перемещено
                   |ИЗ
                   |    РегистрНакопления.ОстаткиТоваровОрдерныйСклад КАК ОстаткиТоваровОрдерныйСклад
                   |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
                   |        ПО ОстаткиТоваровОрдерныйСклад.Регистратор = Корректировка.ДокументОснование
                   |            И (Корректировка.Проведен)
                   |ГДЕ
                   |    (ОстаткиТоваровОрдерныйСклад.Регистратор.ДокументОснование ССЫЛКА Документ.ЗаказВнутренний
                   |            ИЛИ ОстаткиТоваровОрдерныйСклад.Регистратор.ДокументОснование ССЫЛКА Документ.ЗаказПокупателя)
                   |    И Корректировка.Ссылка ЕСТЬ NULL 
                   |
                   |СГРУППИРОВАТЬ ПО
                   |    ОстаткиТоваровОрдерныйСклад.Регистратор.ДокументОснование,
                   |    ОстаткиТоваровОрдерныйСклад.Номенклатура,
                   |    ОстаткиТоваровОрдерныйСклад.ХарактеристикаНоменклатуры
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ЗаказыПокупателейОстатки.Заказ КАК Документ,
                   |    ЗаказыПокупателейОстатки.Заказ.ДокументОснование КАК ДокументОснование,
                   |    ЗаказыПокупателейОстатки.Номенклатура,
                   |    ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
                   |    СУММА(ЗаказыПокупателейОстатки.РезервОстаток) КАК Зарезервировано,
                   |    СУММА(ЕСТЬNULL(ВТ_Перемещено.Количество, 0)) КАК Перемещено
                   |ПОМЕСТИТЬ ВТ_ЗаказыПокупателейПодготовка
                   |ИЗ
                   |    РегистрНакопления.ЗаказыПокупателей.Остатки(, СкладКомпании = &СкладКомпании) КАК ЗаказыПокупателейОстатки
                   |        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Перемещено КАК ВТ_Перемещено
                   |        ПО ЗаказыПокупателейОстатки.Заказ = ВТ_Перемещено.ДокументОснование
                   |            И ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры = ВТ_Перемещено.ХарактеристикаНоменклатуры
                   |            И ЗаказыПокупателейОстатки.Номенклатура = ВТ_Перемещено.Номенклатура
                   |
                   |СГРУППИРОВАТЬ ПО
                   |    ЗаказыПокупателейОстатки.Заказ,
                   |    ЗаказыПокупателейОстатки.Номенклатура,
                   |    ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
                   |    ЗаказыПокупателейОстатки.Заказ.ДокументОснование
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателейПодготовка.Документ,
                   |    ВТ_ЗаказыПокупателейПодготовка.Номенклатура,
                   |    ВТ_ЗаказыПокупателейПодготовка.ХарактеристикаНоменклатуры,
                   |    ВТ_ЗаказыПокупателейПодготовка.Зарезервировано,
                   |    ВТ_ЗаказыПокупателейПодготовка.Перемещено,
                   |    МАКСИМУМ(ВЫБОР
                   |            КОГДА ВТ_ЗаказыПокупателейПодготовка.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
                   |                ТОГДА ВЫРАЗИТЬ(ВТ_ЗаказыПокупателейПодготовка.ДокументОснование КАК Документ.ЗаказНаряд)
                   |            КОГДА НЕ ЗаказНаряд.Ссылка ЕСТЬ NULL 
                   |                ТОГДА ЗаказНаряд.Ссылка
                   |            КОГДА НЕ Renault_CRM_ЗаявкаНаСервисСчетаНаОплату.Ссылка.ЗаказНаряд ЕСТЬ NULL 
                   |                ТОГДА Renault_CRM_ЗаявкаНаСервисСчетаНаОплату.Ссылка.ЗаказНаряд
                   |            ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
                   |        КОНЕЦ) КАК ЗаказНаряд,
                   |    МАКСИМУМ(ВЫБОР
                   |            КОГДА ВТ_ЗаказыПокупателейПодготовка.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
                   |                ТОГДА ЛОЖЬ
                   |            КОГДА НЕ ЗаказНаряд.Ссылка ЕСТЬ NULL 
                   |                ТОГДА ЛОЖЬ
                   |            КОГДА Renault_CRM_ЗаявкаНаСервисСчетаНаОплату.Ссылка ЕСТЬ NULL 
                   |                    И ВТ_ЗаказыПокупателейПодготовка.Документ ССЫЛКА Документ.ЗаказПокупателя
                   |                ТОГДА ИСТИНА
                   |            ИНАЧЕ ЛОЖЬ
                   |        КОНЕЦ) КАК ЭтоРеализация
                   |ПОМЕСТИТЬ ВТ_ЗаказыПокупателейПодготовка2
                   |ИЗ
                   |    ВТ_ЗаказыПокупателейПодготовка КАК ВТ_ЗаказыПокупателейПодготовка
                   |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис.СчетаНаОплату КАК Renault_CRM_ЗаявкаНаСервисСчетаНаОплату
                   |        ПО ВТ_ЗаказыПокупателейПодготовка.ДокументОснование = Renault_CRM_ЗаявкаНаСервисСчетаНаОплату.СчетНаОплату
                   |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряд
                   |        ПО ВТ_ЗаказыПокупателейПодготовка.Документ = ЗаказНаряд.ДокументОснование
                   |
                   |СГРУППИРОВАТЬ ПО
                   |    ВТ_ЗаказыПокупателейПодготовка.Документ,
                   |    ВТ_ЗаказыПокупателейПодготовка.Номенклатура,
                   |    ВТ_ЗаказыПокупателейПодготовка.ХарактеристикаНоменклатуры,
                   |    ВТ_ЗаказыПокупателейПодготовка.Зарезервировано,
                   |    ВТ_ЗаказыПокупателейПодготовка.Перемещено
                   |
                   |ИНДЕКСИРОВАТЬ ПО
                   |    ЗаказНаряд
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателейПодготовка2.Документ,
                   |    ВТ_ЗаказыПокупателейПодготовка2.Номенклатура,
                   |    ВТ_ЗаказыПокупателейПодготовка2.ХарактеристикаНоменклатуры,
                   |    ВТ_ЗаказыПокупателейПодготовка2.Зарезервировано,
                   |    ВТ_ЗаказыПокупателейПодготовка2.Перемещено,
                   |    ВТ_ЗаказыПокупателейПодготовка2.ЗаказНаряд,
                   |    ВТ_ЗаказыПокупателейПодготовка2.ЭтоРеализация КАК ЭтоРеализация,
                   |    ВЫБОР
                   |        КОГДА Renault_ВидыРемонтаДопРеквизиты.ВидРемонта ЕСТЬ NULL 
                   |            ТОГДА ЛОЖЬ
                   |        ИНАЧЕ Renault_ВидыРемонтаДопРеквизиты.ГарантияЗавода
                   |    КОНЕЦ КАК ТипЗН
                   |ПОМЕСТИТЬ ВТ_ЗаказыПокупателей
                   |ИЗ
                   |    ВТ_ЗаказыПокупателейПодготовка2 КАК ВТ_ЗаказыПокупателейПодготовка2
                   |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ВидыРемонтаДопРеквизиты КАК Renault_ВидыРемонтаДопРеквизиты
                   |        ПО ВТ_ЗаказыПокупателейПодготовка2.ЗаказНаряд.ВидРемонта = Renault_ВидыРемонтаДопРеквизиты.ВидРемонта
                   |
                   |ИНДЕКСИРОВАТЬ ПО
                   |    ЭтоРеализация
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ЗаказыПоставщикамОстатки.ЗаказПоставщику КАК Документ,
                   |    ЗаказыПоставщикамОстатки.Номенклатура,
                   |    ЗаказыПоставщикамОстатки.ХарактеристикаНоменклатуры,
                   |    ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК Заказано,
                   |    ""К приемке от поставщика"" КАК Статус
                   |ПОМЕСТИТЬ ВТ_КПриемкеОтПоставщика
                   |ИЗ
                   |    РегистрНакопления.ЗаказыПоставщикам.Остатки(, ЗаказПоставщику.ПодразделениеКомпании = &ПодразделениеКомпании) КАК ЗаказыПоставщикамОстатки
                   |ГДЕ
                   |    ЗаказыПоставщикамОстатки.ЗаказаноОстаток > 0
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателей.Документ,
                   |    ВТ_ЗаказыПокупателей.ЗаказНаряд,
                   |    ВТ_ЗаказыПокупателей.Номенклатура,
                   |    ВТ_ЗаказыПокупателей.ХарактеристикаНоменклатуры,
                   |    ВТ_ЗаказыПокупателей.Зарезервировано - ВТ_ЗаказыПокупателей.Перемещено КАК Количество,
                   |    ""К подбору"" КАК Статус,
                   |    ВТ_ЗаказыПокупателей.ЭтоРеализация,
                   |    ВТ_ЗаказыПокупателей.ТипЗН
                   |ПОМЕСТИТЬ ВТ_КПодбору
                   |ИЗ
                   |    ВТ_ЗаказыПокупателей КАК ВТ_ЗаказыПокупателей
                   |ГДЕ
                   |    (&ВидСклада = ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный)
                   |            ИЛИ &ВидСклада = ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |    И ВТ_ЗаказыПокупателей.Зарезервировано > ВТ_ЗаказыПокупателей.Перемещено
                   |    И НЕ ВТ_ЗаказыПокупателей.ЭтоРеализация
                   |    И НЕ ВТ_ЗаказыПокупателей.Документ ССЫЛКА Документ.ЗаказВнутренний
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателей.Документ,
                   |    ВТ_ЗаказыПокупателей.ЗаказНаряд,
                   |    ВТ_ЗаказыПокупателей.Номенклатура,
                   |    ВТ_ЗаказыПокупателей.ХарактеристикаНоменклатуры,
                   |    ВТ_ЗаказыПокупателей.Зарезервировано - ВТ_ЗаказыПокупателей.Перемещено КАК Количество,
                   |    ""К подбору по реализации"" КАК Статус,
                   |    ВТ_ЗаказыПокупателей.ЭтоРеализация,
                   |    ВТ_ЗаказыПокупателей.ТипЗН
                   |ПОМЕСТИТЬ ВТ_КПодборуРеализация
                   |ИЗ
                   |    ВТ_ЗаказыПокупателей КАК ВТ_ЗаказыПокупателей
                   |ГДЕ
                   |    (&ВидСклада = ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный)
                   |            ИЛИ &ВидСклада = ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |    И ВТ_ЗаказыПокупателей.Зарезервировано > ВТ_ЗаказыПокупателей.Перемещено
                   |    И ВТ_ЗаказыПокупателей.ЭтоРеализация
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателей.Документ,
                   |    ЗНАЧЕНИЕ(Документ.ЗаказНаряд.пустаяссылка) КАК ЗаказНаряд,
                   |    ВТ_ЗаказыПокупателей.Номенклатура,
                   |    ВТ_ЗаказыПокупателей.ХарактеристикаНоменклатуры,
                   |    ВТ_ЗаказыПокупателей.Зарезервировано - ВТ_ЗаказыПокупателей.Перемещено КАК Количество,
                   |    ""К подбору на перемещение"" КАК Статус,
                   |    ЛОЖЬ КАК ЭтоРеализация,
                   |    ВТ_ЗаказыПокупателей.ТипЗН
                   |ПОМЕСТИТЬ ВТ_КПодборуПеремещение
                   |ИЗ
                   |    ВТ_ЗаказыПокупателей КАК ВТ_ЗаказыПокупателей
                   |ГДЕ
                   |    (&ВидСклада = ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный)
                   |            ИЛИ &ВидСклада = ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |    И ВТ_ЗаказыПокупателей.Зарезервировано > ВТ_ЗаказыПокупателей.Перемещено
                   |    И НЕ ВТ_ЗаказыПокупателей.ЭтоРеализация
                   |    И ВТ_ЗаказыПокупателей.Документ ССЫЛКА Документ.ЗаказВнутренний
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателей.Документ,
                   |    ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка) КАК ЗаказНаряд,
                   |    ВТ_ЗаказыПокупателей.Номенклатура,
                   |    ВТ_ЗаказыПокупателей.ХарактеристикаНоменклатуры,
                   |    ВЫБОР
                   |        КОГДА &ВидСклада В (ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный), ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |            ТОГДА ВТ_ЗаказыПокупателей.Перемещено
                   |        ИНАЧЕ ВТ_ЗаказыПокупателей.Зарезервировано
                   |    КОНЕЦ КАК Количество,
                   |    ""К перемещению на другой склад"" КАК Статус,
                   |    ЛОЖЬ КАК ЭтоРеализация,
                   |    ВТ_ЗаказыПокупателей.ТипЗН
                   |ПОМЕСТИТЬ ВТ_КПеремещению
                   |ИЗ
                   |    ВТ_ЗаказыПокупателей КАК ВТ_ЗаказыПокупателей
                   |ГДЕ
                   |    ВЫБОР
                   |            КОГДА &ВидСклада В (ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный), ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |                ТОГДА ВТ_ЗаказыПокупателей.Перемещено
                   |            ИНАЧЕ ВТ_ЗаказыПокупателей.Зарезервировано
                   |        КОНЕЦ > 0
                   |    И НЕ ВТ_ЗаказыПокупателей.ЭтоРеализация
                   |    И ВТ_ЗаказыПокупателей.Документ ССЫЛКА Документ.ЗаказВнутренний
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателей.Документ,
                   |    ВТ_ЗаказыПокупателей.ЗаказНаряд,
                   |    ВТ_ЗаказыПокупателей.Номенклатура,
                   |    ВТ_ЗаказыПокупателей.ХарактеристикаНоменклатуры,
                   |    ВЫБОР
                   |        КОГДА &ВидСклада В (ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный), ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |            ТОГДА ВЫБОР
                   |                    КОГДА ВТ_ЗаказыПокупателей.Перемещено > ВТ_ЗаказыПокупателей.Зарезервировано
                   |                        ТОГДА ВТ_ЗаказыПокупателей.Зарезервировано
                   |                    ИНАЧЕ ВТ_ЗаказыПокупателей.Перемещено
                   |                КОНЕЦ
                   |        ИНАЧЕ ВТ_ЗаказыПокупателей.Зарезервировано
                   |    КОНЕЦ КАК Количество,
                   |    ""К передаче"" КАК Статус,
                   |    ВТ_ЗаказыПокупателей.ЭтоРеализация,
                   |    ВТ_ЗаказыПокупателей.ТипЗН
                   |ПОМЕСТИТЬ ВТ_КПередаче
                   |ИЗ
                   |    ВТ_ЗаказыПокупателей КАК ВТ_ЗаказыПокупателей
                   |ГДЕ
                   |    ВЫБОР
                   |            КОГДА &ВидСклада В (ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный), ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |                ТОГДА ВТ_ЗаказыПокупателей.Перемещено
                   |            ИНАЧЕ ВТ_ЗаказыПокупателей.Зарезервировано
                   |        КОНЕЦ > 0
                   |    И НЕ ВТ_ЗаказыПокупателей.ЭтоРеализация
                   |    И НЕ ВТ_ЗаказыПокупателей.Документ ССЫЛКА Документ.ЗаказВнутренний
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_ЗаказыПокупателей.Документ,
                   |    ВТ_ЗаказыПокупателей.ЗаказНаряд,
                   |    ВТ_ЗаказыПокупателей.Номенклатура,
                   |    ВТ_ЗаказыПокупателей.ХарактеристикаНоменклатуры,
                   |    ВЫБОР
                   |        КОГДА &ВидСклада В (ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный), ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |            ТОГДА ВЫБОР
                   |                    КОГДА ВТ_ЗаказыПокупателей.Перемещено > ВТ_ЗаказыПокупателей.Зарезервировано
                   |                        ТОГДА ВТ_ЗаказыПокупателей.Зарезервировано
                   |                    ИНАЧЕ ВТ_ЗаказыПокупателей.Перемещено
                   |                КОНЕЦ
                   |        ИНАЧЕ ВТ_ЗаказыПокупателей.Зарезервировано
                   |    КОНЕЦ КАК Количество,
                   |    ""К передаче по реализации"" КАК Статус,
                   |    ВТ_ЗаказыПокупателей.ЭтоРеализация,
                   |    ВТ_ЗаказыПокупателей.ТипЗН
                   |ПОМЕСТИТЬ ВТ_КПередачеРеализация
                   |ИЗ
                   |    ВТ_ЗаказыПокупателей КАК ВТ_ЗаказыПокупателей
                   |ГДЕ
                   |    ВЫБОР
                   |            КОГДА &ВидСклада В (ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ордерный), ЗНАЧЕНИЕ(Перечисление.ВидыСкладов.Ячеистый))
                   |                ТОГДА ВТ_ЗаказыПокупателей.Перемещено
                   |            ИНАЧЕ ВТ_ЗаказыПокупателей.Зарезервировано
                   |        КОНЕЦ > 0
                   |    И ВТ_ЗаказыПокупателей.ЭтоРеализация
                   |;
