
&НаКлиенте
Процедура ФиксацияЗвонка(Команда)                
	
	РеквизитыФормы = Новый Структура("ВремяЗвонка,ИнтересКлиента,НазначенВизит,ТекстОтветаПоТелефону",
										"Время звонка", "интерес клиента", "визит назначен ", "текст ответа");	
	
	//проверка обязательных полей
	
	Если НазначенВизит = Истина Тогда
		РеквизитыФормы.Вставить("ЦельВизита", "цель визита");
		РеквизитыФормы.Вставить("ДатаВизита", "дата визита");
	КонецЕсли;
	
	ТекстОтвета = "";	НеЗаполнено = "";
	Для Каждого КлючИЗНачение ИЗ РеквизитыФормы Цикл
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма[КлючИЗНачение.Ключ]) Тогда
			НеЗаполнено  = НеЗаполнено + ?(НеЗаполнено = "", "", ", " + Символы.ПС) + КлючИЗНачение.Значение;
		КонецЕсли;
		ТекстОтвета = ТекстОтвета + ?(ТекстОтвета = "", "", ", ") + СокрЛП(КлючИЗНачение.ЗНачение) + ": " + СокрЛП(ЭтаФорма[КлючИЗНачение.Ключ]);
	КонецЦикла;
	
	Если НеЗаполнено <> "" Тогда
		Сообщить("Имеются незаполненные поля:");
		Сообщить(НеЗаполнено);
		Возврат;
	КОнецЕсли;
		
	ОтправкаУспешна = ОтправитьОтвет();
		
	//
	Закрыть(Новый Структура("Результат, Лид_Ответ", Истина, ТекстОтвета));
	
КонецПроцедуры       

&НаСервере
Функция ОтправитьОтвет()
	
	Возврат Renault_ОнлайнКонсультант.ОтправитьОтветТелефонНаЛидВебСервис(Лид_ТекущийЛид, ТекстОтвета);
	
КонецФункции

