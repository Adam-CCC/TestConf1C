&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
    // заполнение реквизитов со списками
	//Интерес клиента: выбор из списка (Тест-драйв, Покупка а/м, Обслуживание и ремонт автомобиля, 
	//Покупка аксессуаров и запчастей, Запрос информации, Другое)
	ЭтаФорма.Элементы.ИнтересКлиента.СписокВыбора.Очистить();
	ЭтаФорма.Элементы.ИнтересКлиента.СписокВыбора.Добавить("Тест-драйв");
	ЭтаФорма.Элементы.ИнтересКлиента.СписокВыбора.Добавить("Покупка автомобиля");
	ЭтаФорма.Элементы.ИнтересКлиента.СписокВыбора.Добавить("Обслуживание и ремонт автомобиля");
	ЭтаФорма.Элементы.ИнтересКлиента.СписокВыбора.Добавить("Покупка аксессуаров и запчастей");
	ЭтаФорма.Элементы.ИнтересКлиента.СписокВыбора.Добавить("Запрос информации");
	ЭтаФорма.Элементы.ИнтересКлиента.СписокВыбора.Добавить("Другое");
	
	
	//Цель визита: выбор из списка (Тест-драйв, Коммерческое предложение, Ознакомление с автомобилем, 
	//ТО, Обслуживание автомобиля (другое), Кузовной ремонт, Покупка аксессуаров, Покупка запчастей, Другое)
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Очистить();
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Тест-драйв");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Коммерческое предложение");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Ознакомление с автомобилем");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Техобслуживание");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Обслуживание автомобиля (другое)");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Кузовной ремонт");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Покупка аксессуаров");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Покупка запчастей");
	ЭтаФорма.Элементы.ЦельВизита.СписокВыбора.Добавить("Другое");

		
	Если Параметры.Свойство("Лид_ТекущийЛид") Тогда
		Лид_ТекущийЛид = Параметры.Лид_ТекущийЛид;
	КонецЕсли;
	//Элементы.ЗаполнитьПоШаблону.Доступность = ЗначениеЗаполнено(Лид_ТекущийЛид);

	
КонецПроцедуры

