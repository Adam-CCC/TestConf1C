Процедура ОбновитьТаблицу(Отдел)
	
	ТаблицаСотрудников = ПолучитьТаблицуСсылокНаСотрудниковПоОтделу(Отдел);
	МассивСотрудников = ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник");
	ТаблицаСтат = Renault_КонтактЦентр_Общий.ПолучитьСтатусыСотрудников(МассивСотрудников);
	//ТаблицаСтат.Колонки.Добавить("Статус");
	Для Каждого Строка Из ТаблицаСтат Цикл
		СтрокаТаб = ТаблицаСотрудников.Найти(Строка.Сотрудник, "Сотрудник");
		Если Строка.АктивностьПользователя = Ложь Тогда
			СтрокаТаб.Статус = "Offline";
		Иначе
			СтрокаТаб.Статус = "Online";
		КонецЕсли;
	КонецЦикла;
	
	//ЗначениеВРеквизитФормы(ТаблицаСтат, "ТаблицаСтатусы");
	ЗначениеВРеквизитФормы(ТаблицаСотрудников, "ТаблицаСтатусы");
	
КонецПроцедуры

Функция ПолучитьТаблицуСсылокНаСотрудниковПоОтделу(Отдел)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник КАК Сотрудник,
	|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ДилерскийЦентр КАК ДилерскийЦентр,
	|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел КАК Отдел,
	|	""       "" КАК Статус
	|ИЗ
	|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	|ГДЕ
	|	ВЫБОР КОГДА &Отдел = ЗНАЧЕНИЕ(Справочник.CRM_Отделы.ПустаяСсылка) ТОГДА ИСТИНА
	|		ИНАЧЕ Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.Отдел = &Отдел
	|	КОНЕЦ
	|	И НЕ Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И НЕ Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник ЕСТЬ NULL 
	|	И Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник.ФлагУволен = ЛОЖЬ";
	Запрос.УстановитьПараметр("Отдел", Отдел);
	Таблица = Запрос.Выполнить().Выгрузить();
	Возврат Таблица;
	
КонецФункции


