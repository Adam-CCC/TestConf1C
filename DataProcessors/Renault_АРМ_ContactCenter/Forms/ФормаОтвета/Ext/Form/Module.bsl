
&НаСервере
Процедура УстановитьТекстОтвет ()
	
	Ответ_Док.УстановитьHTML(Renault_ОнлайнКонсультант.ПолучитьHTMLИзТекста(Лид_Ответ), Новый Структура());
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Лид_Ответ") Тогда
		Лид_Ответ = Параметры.Лид_Ответ;
		УстановитьТекстОтвет();
	КонецЕсли;
	Если Параметры.Свойство("Лид_ТекущийЛид") Тогда
		Лид_ТекущийЛид = Параметры.Лид_ТекущийЛид;
		Если ЗначениеЗаполнено(Лид_ТекущийЛид.ДилерскийЦентр) Тогда
			ЯщикОтправки = Справочники.Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.ПолучитьОсновнойЯщикДляЛидов(Лид_ТекущийЛид.ДилерскийЦентр.BIR);
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("ИДТрафика") Тогда
		ИДТрафика = Параметры.ИДТрафика;
		ЗаписьТрафик = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
		Если ЗаписьТрафик.ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
			Если ЗначениеЗаполнено(ЗаписьТрафик.ДилерскийЦентр) Тогда
				ЯщикОтправки = Справочники.Renault_ДилерскиеПочтовыеЯщикиНаЦентральномСервере.ПолучитьОсновнойЯщикДляПочты(ЗаписьТрафик.ДилерскийЦентр.BIR);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Клиент_Email") Тогда
		Клиент_Email = Параметры.Клиент_Email;
	КонецЕсли;
	
	//Лид_СписокBIR = Новый СписокЗначений;	
	//Лид_СписокBIR.ЗагрузитьЗначения(КонтактЦентрСервер.ПолучитьМассивBIRLMTПользователя(ПараметрыСеанса.ТекущийПользователь));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВложениеEmail(Команда)
	
	Адрес = "";
	ВыбранныйФайл = "";
	ОбработчикОповещенияОЗакрытии = Новый ОписаниеОповещения("ПомещениеФайлаПриОкончании", ЭтаФорма);
	НачатьПомещениеФайла(ОбработчикОповещенияОЗакрытии, Адрес, ВыбранныйФайл, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПомещениеФайлаПриОкончании(РезультатПомещения, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если РезультатПомещения = Ложь Тогда
		Элементы.НадписьВложения.Заголовок = "";
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Вложения.Добавить();
	НоваяСтрока.Расположение = 4;
	НоваяСтрока.ИмяФайлаНаКомпьютере = Адрес;
	НоваяСтрока.ИмяФайла = ВыбранноеИмяФайла;
	
	Расширение = DMS_ПолучитьРасширениеФайла(ВыбранноеИмяФайла);
	НоваяСтрока.ИндексКартинки = ПолучитьИндексПиктограммыФайла(Расширение);
	ИмяКаталога = "";
	ИмяФайла = "";
	ПолучитьКаталогИИмяФайла(ВыбранноеИмяФайла, ИмяКаталога, ИмяФайла);
	НоваяСтрока.Наименование = ИмяФайла;
	
	Если Вложения.Количество() > 0 Тогда
		ЗаголовокВложения = "Вложения: ";
		Для Каждого СтрокаВложения из Вложения Цикл 
			ЗаголовокВложения = ЗаголовокВложения + СтрокаВложения.Наименование +"; ";
		КонецЦикла;
		Элементы.НадписьВложения.Заголовок = ЗаголовокВложения;
		Элементы.НадписьВложения.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

