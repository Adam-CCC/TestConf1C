&НаСервере
Процедура ВыполнитьЗаменуТеговШаблона(Текст)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТегиДляАвтоЗамены.Тег,
	               |	ТегиДляАвтоЗамены.Реквизит
	               |ИЗ
	               |	Справочник.ТегиДляАвтоЗамены КАК ТегиДляАвтоЗамены
	               |ГДЕ
	               |	ТегиДляАвтоЗамены.Активен
	               |	И (ВЫБОР
	               |				КОГДА &BIRУстановлен
	               |					ТОГДА ТегиДляАвтоЗамены.BIR = &BIR
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ
	               |			ИЛИ ТегиДляАвтоЗамены.Общий)";
	BIRПользователя = РегистрыСведений.НастройкиПользователей.ПолучитьЗначениеНастройки("BIR");
	Если BIRПользователя = Ложь Тогда
		Запрос.УстановитьПараметр("BIRУстановлен", Ложь);
	Иначе 
		Запрос.УстановитьПараметр("BIRУстановлен", Истина);
	КонецЕсли;   
	Запрос.УстановитьПараметр("BIR", BIRПользователя);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл           
		Выполнить(Выборка.Реквизит);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена_Закрыть(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьОтветНаЛидEmail(Команда)
	
	Ответ_Док.ПолучитьHTML(Лид_Ответ, Новый Структура()); 
	НачалоСтиля = Найти(Лид_Ответ, "<style");
	КонецСтиля = Найти(Лид_Ответ, "</style") +8;
	ЧислоСимволов = КонецСтиля - НачалоСтиля;
	СтрСтиля = Сред(Лид_Ответ, НачалоСтиля, ЧислоСимволов);
	Лид_Ответ = СтрЗаменить(Лид_Ответ, СтрСтиля, "");
	Если Не ЗначениеЗаполнено(СокрЛП(Лид_Ответ)) Тогда
		ПоказатьПредупреждение(, "Сообщение обязательно для заполнения");
		Возврат;
	КонецЕсли;
	Ответ = ОтправитьОтветНаЛидНаСервере();
	Если Ответ = "0" ИЛИ Ответ = Истина Тогда 
		сОтвет = Новый Структура;
		сОтвет.Вставить("Результат", Истина);
		сОтвет.Вставить("Лид_Ответ", Лид_Ответ);
		сОтвет.Вставить("Заголовок", Лид_ЗаголовокОтвета);
		Закрыть(сОтвет);
	Иначе
		Если Ответ = "1" Тогда
			ПоказатьПредупреждение(, "Отсутствует настройка почтового сервера, обратитесь в службу поддержки");
		ИначеЕсли Ответ = "2" Тогда
			ПоказатьПредупреждение(, "Невозможно установить соединение с почтовым сервером, обратитесь в службу поддержки");
		ИначеЕсли Ответ = "3" Тогда
			ПоказатьПредупреждение(, "Адрес e-mail не корректен, отправка сообщения невозможна");
		ИначеЕсли Ответ = "4" Тогда
			ПоказатьПредупреждение(, "Невозможно установить соединение с сервером отправки почты, обратитесь в службу поддержки");
		ИначеЕсли Ответ = "6" Тогда
			ПоказатьПредупреждение(, "В тексте письма содержатся изображения. Удалите их, и повторите отправку");
		Иначе
			ПоказатьПредупреждение(, "Отправка сообщения не удалась, обратитесь в службу поддержки");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОтправитьОтветНаЛидНаСервере()
	
	////В зависимости от типа трафика будет выбрана учетная запись электронной почты в гейте
	//ТипТрафика = Строка(Лид_ТекущийЛид.Вид);
	//ТаблицаРезультат = Новый ТаблицаЗначений;
	//ТаблицаРезультат.Колонки.Добавить("ТипТрафика");
	//НоваяСтрока = ТаблицаРезультат.Добавить();
	//НоваяСтрока.ТипТрафика = ТипТрафика;	
	////Сериализатор = Новый СериализаторXDTO(СервисФабрика);
	////ПараметрыСоединения = Сериализатор.ЗаписатьXDTO(ТаблицаРезультат);
	ЭтоПочтовоеСообщение = Ложь;
	НаборТр = РегистрыСведений.Renault_Трафик.СоздатьНаборЗаписей();
	НаборТр.Отбор.Идентификатор.Установить(ИДТрафика);
	НаборТр.Прочитать();
	АдресКлиента = "";
	Если НаборТр.Количество() <> 0 Тогда
		Запись = НаборТр[0];
		Если Запись.ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
			ЭтоПочтовоеСообщение = Истина;
			Клиент = Запись.Клиент;
			АдресКлиента = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Запись.Клиент);
		Конецесли;
	КонецЕсли;
	
	//Подготовим вложения, если есть
	ТаблицаВложений = Новый ТаблицаЗначений;
	ТаблицаВложений.Колонки.Добавить("Данные");
	ТаблицаВложений.Колонки.Добавить("Расширение");
	Для Каждого Вложение ИЗ Вложения Цикл
		Расширение = DMS_ПолучитьРасширениеФайла(Вложение.ИмяФайла);
		Данные = ПолучитьИзВременногоХранилища(Вложение.ИмяФайлаНаКомпьютере);
		НоваяСтрокаВложения = ТаблицаВложений.Добавить();
		НоваяСтрокаВложения.Данные = Данные;
		НоваяСтрокаВложения.Расширение = Расширение;
	КонецЦикла;
	
	//Подготовим данные для отправки
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Тема");
	Результат.Колонки.Добавить("ТекстHTML");
	Результат.Колонки.Добавить("Получатель");
	Результат.Колонки.Добавить("Вложение");
	НоваяСтрока = Результат.Добавить();
	НоваяСтрока.Тема = СокрЛП(Лид_ЗаголовокОтвета + " /#" + Лид_ТекущийЛид.НомерЛида);
	НоваяСтрока.ТекстHTML = Лид_Ответ;
	Если НЕ ЭтоПочтовоеСообщение Тогда
		АдресКлиента = Лид_ТекущийЛид.КлиентАдресЭлектроннойПочты;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Клиент_Email) Тогда
		АдресКлиента = Клиент_Email;
	КонецЕсли;
	
	НоваяСтрока.Получатель = АдресКлиента;
	НоваяСтрока.Вложение = ТаблицаВложений;	
	//ПараметрыПисьма = Сериализатор.ЗаписатьXDTO(Результат);
	
	//ИдентификаторДилера =Лид_ТекущийЛид.BIR;
	
	ТемаПисьма = СокрЛП(Лид_ЗаголовокОтвета + " /#" + ПреобразоватьЧислоВСтроку(Лид_ТекущийЛид.НомерЛида)); //DMSCOR-757
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("НомерЛида", Лид_ТекущийЛид.НомерЛида);
	ДопПараметры.Вставить("Сотрудник", Строка(ПараметрыСеанса.Пользователь.Сотрудник));
	ДопПараметры.Вставить("BIR_LMT", Лид_ТекущийЛид.ДилерскийЦентр.Бир_ЛМТ);
	
	ОтветСервиса = Renault_ОнлайнКонсультант.ОтправитьОтветНаЛидВебСервис(Лид_Ответ, ИДТрафика, АдресКлиента, ТемаПисьма, ТаблицаВложений, ДопПараметры, ЯщикОтправки.АдресПочтовогоЯщика);
	
	Возврат ОтветСервиса;
	//Если ОтправкаУспешна Тогда
	//	Возврат "0";
	//КонецЕсли;
	
КонецФункции

