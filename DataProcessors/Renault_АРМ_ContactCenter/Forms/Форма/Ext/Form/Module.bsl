&НаКлиенте
Процедура ТаблицаРабочиеЛистыВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)

	Если Не(ВыбраннаяСтрока = Неопределено) Тогда
		
		СтандартнаяОбработка = Ложь;
		РЛ = Renault_CRM.докПолучитьЗаписьРЛПоIDK(Элемент.ТекущиеДанные.IDK);
		Форма = РЛ.ПолучитьФорму();
		
		Если Форма.Открыта() тогда
			Форма.Активизировать();
		Иначе
			Форма.Открыть();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЛидыВыбор(Элемент, ВыбраннаяСтрока, Колонка, СтандартнаяОбработка)

	Если Не(ВыбраннаяСтрока = Неопределено) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если Найти(Колонка.Имя, "Лид") Тогда
			
			Если ТипЗнч(Элемент.ТекущиеДанные.Лид) = Тип("Число") Тогда
				РЛ = Renault_CRM.докПолучитьЗаписьРЛПоIDK(Элемент.ТекущиеДанные.Лид);
				Форма = РЛ.ПолучитьФорму();
			Иначе
				Форма = Элемент.ТекущиеДанные.Лид.ПолучитьФорму("ФормаДокумента");
			КонецЕсли;
			
			Если Форма.Открыта() тогда
				Форма.Активизировать();
			Иначе
				Форма.Открыть();
			КонецЕсли;
			
		ИначеЕсли Найти(Колонка.Имя, "Клиент") Тогда
			
			Если Элемент.ТекущиеДанные.Потенциальный Тогда
				Форма = Элемент.ТекущиеДанные.Клиент.ПолучитьФорму("ФормаЭлементаУпр");
			Иначе
				Форма = Элемент.ТекущиеДанные.Клиент.ПолучитьФорму("ФормаЭлемента");
			КонецЕсли;
			
			Если Форма.Открыта() тогда
				Форма.Активизировать();
			Иначе
				Форма.Открыть();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВернутьСворачиваемуюГруппу(Родитель)
	Группа = Элементы.Добавить("ГруппаШапка"+СчетчикСообщений,Тип("ГруппаФормы"),Родитель);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	Группа.ЗаголовокСвернутогоОтображения = "Развернуть";
	Группа.Заголовок = Родитель.Заголовок;
	Группа.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
	Группа.Подсказка = "Развернуть данные клиента"; 
	Шрифт = Новый Шрифт(,);
	Группа.ШрифтЗаголовка = Шрифт;
	
	Возврат Группа;
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОткрытьЛид" Тогда
		Элементы.ГруппаОбработкаСообщений.Видимость = Истина;
		ДобавитьСтраницу(Параметр.ID);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура КлонироватьСтраницу(ИмяШаблона, НомерСтраницы, ВходящиеПараметры)
	ИсходныйШаблон = Элементы.Найти("Сообщение" + ИмяШаблона);
	
	НоваяСтраница = КлонироватьЭлемент(ИсходныйШаблон, СтрЗаменить(ИсходныйШаблон.Имя, ИмяШаблона, НомерСтраницы), ИсходныйШаблон.Родитель, ВходящиеПараметры);
	НоваяСтраница.Видимость = Истина;
	
	Для Каждого ПодчиненныйЭлемент Из ИсходныйШаблон.ПодчиненныеЭлементы Цикл
		КлонироватьПодчиненныеЭлементыРекурсивно(ПодчиненныйЭлемент, ИмяШаблона, НомерСтраницы, ВходящиеПараметры, НоваяСтраница);
	КонецЦикла;
	
	Элементы.ГруппаСообщения.ТекущаяСтраница = НоваяСтраница;
КонецПроцедуры

&НаСервере
Процедура КлонироватьПодчиненныеЭлементыРекурсивно(ИсходныйЭлемент, ИмяШаблона, НомерСтраницы, ВходящиеПараметры, НовыйРодитель)
	НовыйЭлемент = КлонироватьЭлемент(ИсходныйЭлемент, СтрЗаменить(ИсходныйЭлемент.Имя, ИмяШаблона, НомерСтраницы), НовыйРодитель, ВходящиеПараметры);
	
	Если ТипЗнч(ИсходныйЭлемент) = Тип("ГруппаФормы") Или ТипЗнч(ИсходныйЭлемент) = Тип("ТаблицаФормы") Тогда
		Для Каждого ПодчиненныйЭлемент Из ИсходныйЭлемент.ПодчиненныеЭлементы Цикл
			КлонироватьПодчиненныеЭлементыРекурсивно(ПодчиненныйЭлемент, ИмяШаблона, НомерСтраницы, ВходящиеПараметры, НовыйЭлемент);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция КлонироватьЭлемент(ИсходныйЭлемент, НовоеИмя, НовыйРодитель, ВходящиеПараметры)
	ТипЭлемента = ТипЗнч(ИсходныйЭлемент);	
	НовыйЭлемент = Элементы.Добавить(НовоеИмя, ТипЭлемента, НовыйРодитель);
	
	СписокСобытий = Новый Массив;
	
	Если ТипЭлемента = Тип("ГруппаФормы") Тогда
    	НовыйЭлемент.Вид = ИсходныйЭлемент.Вид;
		
		Если ИсходныйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,,"ПутьКДаннымЗаголовка");
		ИначеЕсли ИсходныйЭлемент.Вид = ВидГруппыФормы.Страницы Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,, "ТекущаяСтраница");
			СписокСобытий.Добавить("ПриСменеСтраницы");
		ИначеЕсли ИсходныйЭлемент.Вид = ВидГруппыФормы.Страница Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,, "ПутьКДаннымЗаголовка");
		ИначеЕсли ИсходныйЭлемент.Вид = ВидГруппыФормы.ГруппаКолонок Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,, "ПутьКДаннымШапки");
		Иначе
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент);
		КонецЕсли;
	ИначеЕсли ТипЭлемента = Тип("ПолеФормы") Тогда
		НовыйЭлемент.Вид = ИсходныйЭлемент.Вид;
		
		Если ЗначениеЗаполнено(ИсходныйЭлемент.ПутьКДанным) Тогда
			НовыйЭлемент.ПутьКДанным = ИсходныйЭлемент.ПутьКДанным;
		КонецЕсли;

		Если ИсходныйЭлемент.Вид = ВидПоляФормы.ПолеВвода Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,, "ВыделенныйТекст, СвязьПоТипу, ПутьКДанным");
			ЗаполнитьКоллекциюСвойств(НовыйЭлемент.СписокВыбора, ИсходныйЭлемент.СписокВыбора);
		ИначеЕсли ИсходныйЭлемент.Вид = ВидПоляФормы.ПолеПереключателя Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,, "ПутьКДанным");
			ЗаполнитьКоллекциюСвойств(НовыйЭлемент.СписокВыбора, ИсходныйЭлемент.СписокВыбора);
		ИначеЕсли ИсходныйЭлемент.Вид = ВидПоляФормы.ПолеТекстовогоДокумента Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,,"ВыделенныйТекст, ПутьКДанным");
		ИначеЕсли ИсходныйЭлемент.Вид = ВидПоляФормы.ПолеФорматированногоДокумента Тогда
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,,"ВыделенныйТекст, ПутьКДанным");
		Иначе
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,, "ПутьКДанным");
		КонецЕсли; 
		
		СписокСобытий.Добавить("ПриИзменении");
		СписокСобытий.Добавить("НачалоВыбора");
		СписокСобытий.Добавить("НачалоВыбораИзСписка");
		СписокСобытий.Добавить("Очистка");
		СписокСобытий.Добавить("Регулирование");
		СписокСобытий.Добавить("Открытие");
		СписокСобытий.Добавить("Создание");
		СписокСобытий.Добавить("ОбработкаВыбора");
		СписокСобытий.Добавить("ИзменениеТекстаРедактирования");
		СписокСобытий.Добавить("АвтоПодбор");
		СписокСобытий.Добавить("ОкончаниеВводаТекста");	
	ИначеЕсли ТипЭлемента = Тип("ТаблицаФормы") Тогда
		Если ЗначениеЗаполнено(ИсходныйЭлемент.ПутьКДанным) Тогда
			НовыйЭлемент.ПутьКДанным = ИсходныйЭлемент.ПутьКДанным;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент,, "ПутьКДаннымКартинкиСтроки, ДополнительныеПараметрыСоздания, ЗапросОбновления, ПутьКДанным");

		СписокСобытий.Добавить("ПриИзменении");
		СписокСобытий.Добавить("Выбор");
		СписокСобытий.Добавить("ПриАктивизацииСтроки");
		СписокСобытий.Добавить("ВыборЗначения");
		СписокСобытий.Добавить("ПриАктивизацииПоля");
		СписокСобытий.Добавить("ПриАктивизацииЯчейки");
		СписокСобытий.Добавить("ПередНачаломДобавления");
		СписокСобытий.Добавить("ПередНачаломИзменения");
		СписокСобытий.Добавить("ПередУдалением");
		СписокСобытий.Добавить("ПриНачалеРедактирования");
		СписокСобытий.Добавить("ПередОкончаниемРедактирования");
		СписокСобытий.Добавить("ПриОкончанииРедактирования");
		СписокСобытий.Добавить("ОбработкаВыбора");
		СписокСобытий.Добавить("ПередРазворачиванием");
		СписокСобытий.Добавить("ПередСворачиванием");
		СписокСобытий.Добавить("ПриСменеТекущегоРодителя");
		СписокСобытий.Добавить("ОбработкаЗаписиНового");
		СписокСобытий.Добавить("ОбработкаЗапросаОбновления");
		СписокСобытий.Добавить("НачалоПеретаскивания");
		СписокСобытий.Добавить("ПроверкаПеретаскивания");
		СписокСобытий.Добавить("ОкончаниеПеретаскивания");
		СписокСобытий.Добавить("Перетаскивание");
	ИначеЕсли ТипЭлемента = Тип("КнопкаФормы") Тогда
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент);
	ИначеЕсли ТипЭлемента = Тип("ДекорацияФормы") Тогда
		ЗаполнитьЗначенияСвойств(НовыйЭлемент, ИсходныйЭлемент);
		
		СписокСобытий.Добавить("Нажатие");
		СписокСобытий.Добавить("НачалоПеретаскивания");
		СписокСобытий.Добавить("ПроверкаПеретаскивания");
		СписокСобытий.Добавить("ОкончаниеПеретаскивания");
		СписокСобытий.Добавить("Перетаскивание");
	КонецЕсли;
	
	Если СтрДлина(НовыйЭлемент.Заголовок) - СтрДлина(СтрЗаменить(НовыйЭлемент.Заголовок, "%", "")) = 2 Тогда
		НовыйЭлемент.Заголовок = Вычислить(СтрЗаменить(НовыйЭлемент.Заголовок, "%", ""));
	КонецЕсли;
		
	Для Каждого Событие Из СписокСобытий Цикл
		Попытка
			Обработчик = ИсходныйЭлемент.ПолучитьДействие(Событие);
			
			Если ЗначениеЗаполнено(Обработчик) Тогда
				НовыйЭлемент.УстановитьДействие(Событие, Обработчик);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат НовыйЭлемент;
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьКоллекциюСвойств(КоллекцияПриемник, КоллекцияИсточник) 
    
    Для Каждого Элемент Из КоллекцияИсточник Цикл
        ЗаполнитьЗначенияСвойств(КоллекцияПриемник.Добавить(), Элемент);
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Процедура НайтиСсылкуНаКонфигурациюКлиента()
	СсылкаНаКонфигурациюКлиента = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИсторияПерепискиСКлиентом.Сообщение КАК Сообщение,
		|	ИсторияПерепискиСКлиентом.Период КАК Период
		|ИЗ
		|	РегистрСведений.Renault_ИсторияПерепискиСКлиентом КАК ИсторияПерепискиСКлиентом
		|ГДЕ
		|	ИсторияПерепискиСКлиентом.Объект = &Объект
		|	И НЕ ИсторияПерепискиСКлиентом.ЭтоОтветДилера
		|	И ИсторияПерепискиСКлиентом.Сообщение ПОДОБНО &ТекстСсылки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	Запрос.УстановитьПараметр("ТекстСсылки","%https://ru.co.rplug.renault.com/%");
	Запрос.УстановитьПараметр("Объект",Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИДТрафика));
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	если ВыборкаДетальныеЗаписи.Следующий() тогда
		// Вставить обработку выборки ВыборкаДетальныеЗаписи
		ТекстСсылки = "";
		ПозицияНачалоСсылки = СтрНайти(НРег(ВыборкаДетальныеЗаписи.Сообщение), "https://ru.co.rplug.renault.com/");
		
		Если ПозицияНачалоСсылки > 0 Тогда
			ТекстСсылки = СокрЛП(Сред(ВыборкаДетальныеЗаписи.Сообщение, ПозицияНачалоСсылки));
			
			ТекстСсылки = СтрЗаменить(ТекстСсылки, " ", Символы.ПС);
			ТекстСсылки = СтрЗаменить(ТекстСсылки, Символы.НПП, Символы.ПС);
			ТекстСсылки = СтрПолучитьСтроку(ТекстСсылки, 1);
			
			СсылкаНаКонфигурациюКлиента = ТекстСсылки;
					
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолеСсылкаНаКонфигурациюШаблон2Нажатие(Элемент) // DMSREN-1217
	ЗапуститьПриложение(СсылкаНаКонфигурациюКлиента);
КонецПроцедуры

&НаСервере
Процедура ПрикрепитьКРЛНаСервере()
	
	ЗаписьТрафик = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
		
		Если ЗаписьТрафик <> Неопределено Тогда
							
				Если ЗначениеЗаполнено(ВыбранныйРЛДляПрикрепления) Тогда			
					
					ЗаписьТрафик.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный;
					//Заполнить клиента в трафике
					ЗаписьТрафик.Клиент = ВыбранныйРЛДляПрикрепления.Клиент;
					//Отметить трафик как закрытый
					ЗаписьТрафик.Обработан = Истина;
					//Обновим менеджера (или останется тот же, или перекинется на того, кто в рабочем листе
					ЗаписьТрафик.Менеджер = ВыбранныйРЛДляПрикрепления.Сотрудник;
					// собственно, связь с рабочим листом
					ЗаписьТрафик.РабочийЛист = ВыбранныйРЛДляПрикрепления;
					
					ЗаписьТрафик.Записать();
					СоздатьСобытиеПрикрепленияПовторногоТрафика(ВыбранныйРЛДляПрикрепления.IDK);
					
					Если ЗначениеЗаполнено(Лид) тогда
						ОбъектЛид = Лид.ПолучитьОбъект();
						ОбъектЛид.РабочийЛистПрикрепленый = ВыбранныйРЛДляПрикрепления;
						ОбъектЛид.Записать();
					КонецЕсли;
					
				КонецЕсли;
		КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьКРЛ(Команда)
	
	Если Не ЗначениеЗаполнено(Лид.РабочийЛистПрикрепленый) тогда
		ПрикрепитьКРЛНаСервере();
		Предупреждение("Лид прикреплен к РЛ №" + ВыбранныйРЛДляПрикрепления.IDK);
		ТекСтр = Элементы.ГруппаСообщения.ТекущаяСтраница.Имя;
		ОбновитьДанные(ТекСтр);
	иначе
		Форм = Лид.РабочийЛистПрикрепленый.ПолучитьФорму("ФормаДокумента");
		Форм.Открыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТЗЛШаблон2ПриАктивизацииСтроки(Элемент)
	// { Установим доступность кнопки прикрепления в зависимости от того выбран ли в истории РЛ

	если ЗначениеЗаполнено(Лид.РабочийЛистПрикрепленый) тогда 
		возврат; 
	КонецЕсли;
	ВыбранныйРЛДляПрикрепления = Элемент.ТекущиеДанные.РабочийЛист;
	КнопкаПрикрепленияРЛ = Элементы.Найти(СтрЗаменить(Элемент.Имя,"ТЗЛ","ПрикрепитьКРЛ"));
	если КнопкаПрикрепленияРЛ <> неопределено тогда
			КнопкаПрикрепленияРЛ.Доступность = ЗначениеЗаполнено(ВыбранныйРЛДляПрикрепления);
	КонецЕсли;
	// }
КонецПроцедуры

&НаСервере
Процедура СоздатьСобытиеПрикрепленияПовторногоТрафика(м_РабочийЛист)
	
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Док = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	Док.ОбменДанными.Загрузка = Истина;
	Док.Дата = ТекущаяДата();
	Док.Автор = ПараметрыСеанса.Пользователь;
	Док.Сотрудник = ПараметрыСеанса.Пользователь;
	Док.IDK = м_РабочийЛист;
	Док.ВидСобытия = Справочники.CRM_ВидыСобытий.Прикреплен;
	Док.Комментарий = "Прикреплен лид от " + Лид.ДатаЗаогрузки;
	Док.ДилерскийЦентр = ДилерскийЦентр;
	Док.ЛидПрикрепленный = Лид;
	Док.Обработано = Истина;
	Попытка
		Док.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(Документы.CRM_СобытияПоРабочимЛистам, 
        УровеньЖурналаРегистрации.Ошибка, , ,
        "Ошибка записи документа");
	КонецПопытки;
	
	Запись = РегистрыСведений.Renault_СтатистикаВыполненияЭтаповПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = м_РабочийЛист;
	Запись.ДатаВыполнения = ТекущаяДата();
	Запись.ДилерскийЦентр = ДилерскийЦентр;
	Запись.Записать();
	
КонецПроцедуры



