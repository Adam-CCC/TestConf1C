&НаСервере
Процедура ИсторияПерепискиЗаполнить()
	
	ИсторияПереписки.Очистить();
	Макет = Обработки.Renault_АРМ_ContactCenter.ПолучитьМакет("МакетИсторияПереписки");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИсторияПерепискиСКлиентом.Сообщение,
	|	ИсторияПерепискиСКлиентом.Период КАК Период,
	|	ВЫБОР
	|		КОГДА ИсторияПерепискиСКлиентом.ЭтоОтветДилера
	|			ТОГДА ""Исполнитель""
	|		ИНАЧЕ ""Клиент""
	|	КОНЕЦ КАК Отправитель,
	|	ВЫБОР
	|		КОГДА ИсторияПерепискиСКлиентом.ЭтоОтветДилера
	|			ТОГДА ИсторияПерепискиСКлиентом.ПользовательДилера
	|		ИНАЧЕ ИсторияПерепискиСКлиентом.Объект.Клиент
	|	КОНЕЦ КАК ПользовательДилера,
	|	ВЫБОР КОГДА ИсторияПерепискиСКлиентом.ТипОтветаДилера = ЗНАЧЕНИЕ(Перечисление.Renault_ТипыОтветовДилера.Email) ТОГДА
	|		""(по e-mail)""
	|	КОГДА ИсторияПерепискиСКлиентом.ТипОтветаДилера = ЗНАЧЕНИЕ(Перечисление.Renault_ТипыОтветовДилера.Телефон) ТОГДА
	|		""(по телефону)""
	|	КОНЕЦ КАК ТипОтветаДилера
	|ИЗ
	|	РегистрСведений.Renault_ИсторияПерепискиСКлиентом КАК ИсторияПерепискиСКлиентом
	|ГДЕ
	|	ИсторияПерепискиСКлиентом.Объект = &Объект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("Объект", Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИДТрафика));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Область = Макет.ПолучитьОбласть("Сообщение");
		ЗаполнитьЗначенияСвойств(Область.Параметры, Выборка, , "Отправитель");
		Если Выборка.Отправитель = "Клиент" Тогда
			Область.Параметры.Отправитель = "Клиент";
			Область.Области.Сообщение.ЦветФона = Новый Цвет(255, 237, 159);
		иначе
			Область.Параметры.Отправитель = "Исполнитель: " + Выборка.ПользовательДилера;
			
		КонецЕсли;
		ИсторияПереписки.Вывести(Область);
		
	КонецЦикла;
	
	НайтиСсылкуНаКонфигурациюКлиента();  // DMSREN-1217
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеКлиента(Клиент)
	
	Если ЗначениеЗаполнено(Клиент) Тогда
		Клиент_ФИО = Клиент.Наименование;
		Клиент_Пол = Клиент.Пол;
		Клиент_Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Клиент);
		Клиент_Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Клиент);
		//Клиент_ДР = '00010101';
	Иначе
		Клиент_ФИО = "";
		Клиент_Пол = Перечисления.ПолФизическихЛиц.ПустаяСсылка();
