
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СчетчикСообщений = 0;
	
	ПраваПользователя = ПараметрыСеанса.Renault_ПраваПользователя;
	
	СтруктураНастроекСписка = Новый Структура;
	ОтображаемыеТипыТрафика = Новый Структура;
	ОтображаемыеТипыТрафика.Вставить("ПоказыватьОК", Истина);
	ОтображаемыеТипыТрафика.Вставить("ПоказыватьПочту", Истина);
	ОтображаемыеТипыТрафика.Вставить("ПоказыватьЛиды", Истина);
	СтруктураНастроекСписка.Вставить("ОтображаемыеТипыТрафика", ОтображаемыеТипыТрафика);
	СтруктураНастроекСписка.Вставить("ВыводитьВсеНеобработанные", Истина);
	
	ПоказыватьОК = Истина;
	ПоказыватьПочту = Истина;
	ПоказыватьЛиды = Истина;
	ПоказыватьСертификатыКонтроля = Истина;
	ВыводитьВсеНеобработанные = Истина;
	
	РольПользователя = ПраваПользователя.ПраваИНастройки.КонтактЦентр_РольПользователя;
	ПолныйДоступКLMT = РольДоступна("ПолныеПрава");
	ПериодДанных.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	ОтборДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();;
	ОбновитьТаблицуНаСервере();
	Если РольПользователя = Перечисления.Renault_КонтактЦентр_РолиПользователей.Менеджер Тогда
		Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаТрафикМенеджер;
		Элементы.ГруппаТрафикАдминистратор.Видимость = Ложь;
	Иначе
		Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаТрафикАдминистратор;
		Элементы.ГруппаТрафикМенеджер.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаОбработкаСообщений.Видимость = Ложь;
	
	Элементы.СообщениеШаблон1.Видимость = Ложь;
	Элементы.СообщениеШаблон2.Видимость = Ложь;
	Элементы.СообщениеШаблон3.Видимость = Ложь;
	
	// Если передаем ID, то пытаемся открыть вкладку с выбранным трафиком
	Если Параметры.Свойство("ID") Тогда
		ID = Параметры.ID;
		Если ТипЗнч(ID) = Тип("Строка") Тогда
			Если ЗначениеЗаполнено(ID) Тогда
				Элементы.ГруппаОбработкаСообщений.Видимость = Истина;
				ДобавитьСтраницу(ID);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьДатуАктуальности() Экспорт
	
	ПолучитьДатуАктуальностиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДатуАктуальностиНаСервере()
	
	Набор = РегистрыСведений.Renault_ДатыАктуальностиКонтактЦентр.СоздатьНаборЗаписей();
	Набор.Отбор.ТипТрафика.Установить(Справочники.CRM_ТипТрафика.ЛидRenault);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		ДатаАктуальности = '00010101';
	Иначе
		ДатаАктуальности = Набор[0].ДатаАктуальности;
	КонецЕсли;
	
	ЗадержкаПолучения = ТекущаяДата() - ДатаАктуальности;
	
	ДатаРегЗадания = Константы.Renault_ДатаОбновленияКЦ.Получить();
	
КонецПроцедуры

