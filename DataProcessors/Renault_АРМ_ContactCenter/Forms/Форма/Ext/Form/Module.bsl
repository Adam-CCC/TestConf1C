&НаКлиенте
Процедура ПослеВыбораПричиныЗакрытияПриЗакрытииФормы(Значение, Параметры) Экспорт
	
	Если Значение <> Неопределено Тогда
		ПеренестиЛидВАрхив(Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиЛидВАрхив(Лид_ПричинаЗакрытия)
	
	ЛидСсылка = Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИДТрафика);
	ЛидОбъект = ЛидСсылка.ПолучитьОбъект();
	ЛидОбъект.ТрафикОбработан = Истина;
	ЛидОбъект.ДатаЗакрытия = ТекущаяДата();
	ЛидОбъект.РезультатОбработки = Лид_ПричинаЗакрытия;
	ЛидОбъект.Записать();
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
	Запись.Обработан = Истина;
	Запись.Закрытый = Истина;
	Запись.Записать();
	
	//ОбновитьСостояниеЛида();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияНаСервере()
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Запись.ТипТрафика = Справочники.CRM_ТипТрафика.ЛидRenault Тогда
		Лид = Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИДТрафика);
		Если ЗначениеЗаполнено(Лид) Тогда
			ЛидОбъект = Лид.ПолучитьОбъект();
			ЛидОбъект.ПримечаниеДилера = Лид_ПримечаниеДилера;
			//ЛидОбъект.КлиентФИО = Клиент_ФИО;
			ЛидОбъект.КлиентАдресЭлектроннойПочты = Клиент_Email;
			Клиент = ЛидОбъект.Клиент;
			Если ЗначениеЗаполнено(Клиент) Тогда
				КлиентОб = Клиент.ПолучитьОбъект();
				КлиентОб.Наименование = Клиент_ФИО;
				КлиентОб.Пол = Клиент_Пол;
				КлиентОб.Записать();
			КонецЕсли;
			//ЛидОбъект.кКлиентПол = Клиент_Пол;
			ЛидОбъект.КлиентДеньРождения = Клиент_ДР;
			ЛидОбъект.КлиентМобильныйТелефон = Клиент_Телефон;
			ЛидОбъект.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	
	СохранитьИзмененияНаСервере();
	
КонецПроцедуры

