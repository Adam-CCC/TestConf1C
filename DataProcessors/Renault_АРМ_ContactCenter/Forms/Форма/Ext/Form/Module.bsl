&НаКлиенте
Процедура ПоказыватьЛидыПриИзменении(Элемент)
	
	Если ПоказыватьЛиды = Истина Тогда
		Элементы.ПоказыватьЛидыАдминистратор.ЦветТекстаЗаголовка = Новый Цвет();
		Элементы.ПоказыватьЛиды.ЦветТекстаЗаголовка = Новый Цвет();
		Элементы.ПоказыватьЛидыАдминистратор.ШрифтЗаголовка = Новый Шрифт(, 10);
		Элементы.ПоказыватьЛиды.ШрифтЗаголовка = Новый Шрифт(, 10);
	Иначе
		Элементы.ПоказыватьЛидыАдминистратор.ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
		Элементы.ПоказыватьЛиды.ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
		Элементы.ПоказыватьЛидыАдминистратор.ШрифтЗаголовка = Новый Шрифт(, 10, Истина);
		Элементы.ПоказыватьЛиды.ШрифтЗаголовка = Новый Шрифт(, 10, Истина);
	КонецЕсли;
	
	ОбновитьТаблицуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьОКПриИзменении(Элемент)
	
	Если ПоказыватьОК = Истина Тогда
		Элементы.ПоказыватьОКАдминистратор.ЦветТекстаЗаголовка = Новый Цвет();
		Элементы.ПоказыватьОК.ЦветТекстаЗаголовка = Новый Цвет();
		Элементы.ПоказыватьОКАдминистратор.ШрифтЗаголовка = Новый Шрифт(, 10);
		Элементы.ПоказыватьОК.ШрифтЗаголовка = Новый Шрифт(, 10);
	Иначе
		Элементы.ПоказыватьОКАдминистратор.ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
		Элементы.ПоказыватьОК.ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
		Элементы.ПоказыватьОКАдминистратор.ШрифтЗаголовка = Новый Шрифт(, 10, Истина);
		Элементы.ПоказыватьОК.ШрифтЗаголовка = Новый Шрифт(, 10, Истина);
	КонецЕсли;
	
	ОбновитьТаблицуНаСервере();
	
КонецПроцедуры

&НаКлиенте
