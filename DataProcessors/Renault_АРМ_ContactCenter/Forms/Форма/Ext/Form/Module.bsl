// В качестве параметра возможны:
//		1. строка списка трафика,
//		2. ИД трафика (строка), если вызывается открытие конкретного трафика
&НаСервере
Процедура ДобавитьСтраницу(ТекДанные)
	
	Если ТипЗнч(ТекДанные) = Тип("Строка") Тогда
		Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ТекДанные);
		
		ВходящиеПараметры = Новый Структура;
		ВходящиеПараметры.Вставить("Идентификатор", Запись.Идентификатор);
		ВходящиеПараметры.Вставить("ТипТрафика", Запись.ТипТрафика);
		ВходящиеПараметры.Вставить("Клиент", Запись.Клиент);
	Иначе
		ВходящиеПараметры = Новый Структура;
		ВходящиеПараметры.Вставить("Идентификатор", ТекДанные.Идентификатор);
		ВходящиеПараметры.Вставить("ТипТрафика", ТекДанные.ТипТрафика);
		ВходящиеПараметры.Вставить("Клиент", ТекДанные.Клиент);
	КонецЕсли;
	
	ИдентификаторТрафика = ВходящиеПараметры.Идентификатор;
	ИДТрафика = ИдентификаторТрафика;
	ТипТрафика = ВходящиеПараметры.ТипТрафика;
	
	ТабСоответствий = РеквизитФормыВЗначение("ТаблицаСоответствийТрафикаИСтраниц");
	СтрСоответствия = ТабСоответствий.Найти(ИдентификаторТрафика, "ИдентификаторТрафика");
	Если СтрСоответствия <> Неопределено Тогда
		Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаОбработкаСообщений;
		ИмяСтраницы = СтрСоответствия.ИмяСтраницы;
		Элементы.ГруппаСообщения.ТекущаяСтраница = Элементы[ИмяСтраницы];
		ОбновитьДанные(ИмяСтраницы);
		Возврат;
	КонецЕсли;
	
	НовыйАлгоритмФормированияСтраниц = Истина;
	
	Если НовыйАлгоритмФормированияСтраниц Тогда
		ЕстьЗаполнение = Ложь;
		
		Если ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
			КлонироватьСтраницу("Шаблон1", СчетчикСообщений, ВходящиеПараметры);
			
			//Видимость+доступность кнопок раздела "Ответственный"
			РольПользователя = ПраваПользователя.ПраваИНастройки.КонтактЦентр_РольПользователя;
			Если РольПользователя = Перечисления.Renault_КонтактЦентр_РолиПользователей.Администратор Тогда
				Элементы["КнОтказаться" + СчетчикСообщений].Видимость = Ложь;
				Элементы["КнВзятьСебе" + СчетчикСообщений].Видимость = Ложь;
			ИначеЕсли РольПользователя = Перечисления.Renault_КонтактЦентр_РолиПользователей.Менеджер и не ЗначениеЗаполнено(Лид_Ответственный) Тогда
				Элементы["КнНазначить" + СчетчикСообщений].Видимость = Ложь;
				Элементы["КнОтказаться" + СчетчикСообщений].Видимость = Ложь;
				Элементы["Ответственный" + СчетчикСообщений].Видимость = Ложь;
				Элементы["ОтветитьEmail" + СчетчикСообщений].Доступность = Ложь;
				Элементы["ОтветитьТелефон" + СчетчикСообщений].Доступность = Ложь;
			Иначе
				Элементы["КнВзятьСебе" + СчетчикСообщений].Видимость = Ложь;
				Элементы["КнНазначить" + СчетчикСообщений].Видимость = Ложь;
