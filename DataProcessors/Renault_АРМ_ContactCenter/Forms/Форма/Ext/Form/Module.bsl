&НаКлиенте
Процедура ЗакрытьСтраницу(Команда)
	
	ЗакрытьСтраницуСервер();
	Если Элементы.ГруппаСообщения.ПодчиненныеЭлементы.Количество() = 0 Тогда
		Элементы.ГруппаОбработкаСообщений.Видимость = Ложь;
		Если ЭтоАдминистратор() Тогда
			Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаТрафикАдминистратор;
		Иначе
			Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаТрафикМенеджер;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоАдминистратор()
	
	РольПользователя = ПраваПользователя.ПраваИНастройки.КонтактЦентр_РольПользователя;
	Если РольПользователя = Перечисления.Renault_КонтактЦентр_РолиПользователей.Менеджер Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗакрытьСтраницуСервер()
	
	Элементы.Удалить(Элементы.ГруппаСообщения.ТекущаяСтраница);
	ТабСоответствий = РеквизитФормыВЗначение("ТаблицаСоответствийТрафикаИСтраниц");
	СтрСоответствия = ТабСоответствий.Найти(ИДТрафика, "ИдентификаторТрафика");
	Если СтрСоответствия <> Неопределено Тогда
		ТабСоответствий.Удалить(СтрСоответствия);
		ЗначениеВРеквизитФормы(ТабСоответствий, "ТаблицаСоответствийТрафикаИСтраниц");
	КонецЕсли;
	Если Элементы.ГруппаСообщения.ПодчиненныеЭлементы.Количество() > 3 Тогда
		//Элементы.ГруппаСообщения.ТекущаяСтраница = Элементы.ГруппаСообщения.ПодчиненныеЭлементы[0];
		Элементы.ГруппаСообщения.ТекущаяСтраница = Элементы.ГруппаСообщения.ПодчиненныеЭлементы[Элементы.ГруппаСообщения.ПодчиненныеЭлементы.Количество()-1]; // DMSREN-1293. переходим на последний элемент, а не на первый
		ТекСтр = Элементы.ГруппаСообщения.ТекущаяСтраница.Имя;
		ОбновитьДанные(ТекСтр);
	КонецЕсли;
	
КонецПроцедуры

