			СчетчикСообщений = СчетчикСообщений + 1;
			
			Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаОбработкаСообщений;
			
			ТекСтр = Элементы.ГруппаСообщения.ТекущаяСтраница.Имя;
			ОбновитьДанные(ТекСтр);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//ДанныеКлиента = ПолучитьДанныеКлиента(ВходящиеПараметры.Клиент);
	
	Если ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
