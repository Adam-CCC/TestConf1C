&НаСервере
Процедура НазначитьНаМенеджераНаСервере(ВыбранныйМенеджер, ВыбранныйТрафикID, ЭтоЛид = Истина)
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ВыбранныйТрафикID);
	Запись.Менеджер = ВыбранныйМенеджер;
	Запись.Администратор = ПараметрыСеанса.Пользователь.Сотрудник; // DMSREN-276 17.09.2019
	Запись.Записать();
	
	Если ЭтоЛид Тогда
		Лид = Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ВыбранныйТрафикID);
		
		Если НЕ ЗначениеЗаполнено(Лид) Тогда
			Сообщить("Не найден лид для трафика " + ВыбранныйТрафикID);
		Иначе
			Об = Лид.ПолучитьОбъект();
			Об.Менеджер = ВыбранныйМенеджер;
			Об.Записать();
		КонецЕсли;
	КонецЕсли;
	
	Renault_ОнлайнКонсультант.ПослатьПочтовоеСообщениеПользователю_КЦ(Запись, Запись.Менеджер, "Назначен лид");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтветственногоНаСервере(Ответственный = Неопределено, ЭтоЛид = Истина)
	
	Если ЭтоЛид Тогда
		Лид = Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИДТрафика);
		
		Если Ответственный = Неопределено Тогда
			Ответственный = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;
		//Если ЗначениеЗаполнено(Лид.Ответственный) Тогда
		//	СохранитьИзмененениеОтветственного(Лид);
		//КонецЕсли;
		ЛидОбъект = Лид.ПолучитьОбъект();
		ЛидОбъект.Менеджер = Ответственный;
		ЛидОбъект.Записать();
	КонецЕсли;
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
	Запись.Менеджер = Ответственный;
	Запись.Записать();
	//Лид_Ответственный = Ответственный;
	//КонтактЦентрСервер.РазослатьОповещенияПоПочтеПользователь(Лид, "Назначен лид");
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекСписок()
	
	Ответ = "";
	
	Если Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаТрафикМенеджер Тогда
		
		Если Элементы.ГруппаСтрМенеджер.ТекущаяСтраница = Элементы.ГруппаМойТрафик Тогда
			Ответ = "СписокМойТрафик";
		ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница = Элементы.ГруппаВОбработкеМенеджер Тогда
			Ответ = "СписокВОбработке";
		ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница = Элементы.ГруппаВсеМенеджер Тогда
			Ответ = "СписокМойТрафик";
		КонецЕсли;
		
	ИначеЕсли Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаТрафикАдминистратор Тогда
		
		Если Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница = Элементы.ГруппаВходящие Тогда
			Ответ = "СписокВходящие";
		ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница = Элементы.ГруппаНазначенные Тогда
			Ответ = "СписокНазначенные";
		ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница = Элементы.ГруппаВОбработке Тогда
			//Ответ = "СписокМойТрафик";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

