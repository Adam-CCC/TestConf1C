		Элементы.ПоказыватьПочтуАдминистратор.ШрифтЗаголовка = Новый Шрифт(, 10);
		Элементы.ПоказыватьПочту.ШрифтЗаголовка = Новый Шрифт(, 10);
	Иначе
		Элементы.ПоказыватьПочтуАдминистратор.ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
		Элементы.ПоказыватьПочту.ЦветТекстаЗаголовка = Новый Цвет(255, 0, 0);
		Элементы.ПоказыватьПочтуАдминистратор.ШрифтЗаголовка = Новый Шрифт(, 10, Истина);
		Элементы.ПоказыватьПочту.ШрифтЗаголовка = Новый Шрифт(, 10, Истина);
	КонецЕсли;
	
