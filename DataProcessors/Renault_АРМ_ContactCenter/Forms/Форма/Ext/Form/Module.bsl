&НаКлиенте
Процедура ЗакрытьЛид(Команда)
	
	Если НЕ ТрафикЛМТПочтаОтвеченный(ИДТрафика) Тогда
		ПоказатьПредупреждение( ,"Перез закрытием необходимо обработать лид!");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьРЛПоТрафику() И НЕ ЗначениеЗаполнено(Лид.РабочийЛистПрикрепленый) И Лид_ВидКлассификация.Наименование <> "Сертификат контроля" Тогда
		
		ПараметрыОповещения = Новый Структура;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораСоздаватьРЛ", ЭтаФорма, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещения, "По лиду не создан рабочий лист! Вы уверены, что хотите закрыть лид без создания рабочего листа?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ПараметрыОповещения = Новый Структура();
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПричиныЗакрытияПриЗакрытииФормы", ЭтаФорма, ПараметрыОповещения);
		
		ОткрытьФорму("Справочник.Renault_РезультатОбработки.ФормаВыбора",,ЭтаФорма,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьТрафик(Команда)
	
	Ответ = Вопрос("Вы уверены что хотите закрыть трафик?", РежимДиалогаВопрос.ДаНет, 0);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗакрытьТрафикНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗакрытьТрафикНаСервере()
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
	Запись.Обработан = Истина;
	Запись.Закрытый = Истина;
	Запись.Записать();
	
КонецПроцедуры

&НаСервере
Функция ЕстьРЛПоТрафику()
	
	РЛ = РеквизитФормыВЗначение("Объект").ПолучитьРабочийЛистПоТрафику(ИДТрафика);
	Возврат РЛ <> Неопределено;
	
КонецФункции

&НаСервере
Функция ТрафикЛМТПочтаОтвеченный(ИДТрафика)
	
	ЕстьОтвет = РеквизитФормыВЗначение("Объект").ТрафикЛМТПочтаОтвеченный(ИДТрафика);
