&НаСервере
Процедура УстановитьЗаголовки()
	
	РольПользователя = ПраваПользователя.ПраваИНастройки.КонтактЦентр_РольПользователя;
	Если РольПользователя = Перечисления.Renault_КонтактЦентр_РолиПользователей.Менеджер Тогда
		
		Элементы.ГруппаМойТрафик.Заголовок = "Мой трафик (" + ПросчитатьКоличествоЛидов(СписокМойТрафик) + ")";
		Элементы.ГруппаВОбработкеМенеджер.Заголовок = "В обработке (" + ПросчитатьКоличествоЛидов(СписокВОбработке) + ")";
		Элементы.ГруппаВсеВходящие.Заголовок = "Все свободные (" + ПросчитатьКоличествоЛидов(СписокВсеВходящие) + ")";
		Элементы.ГруппаВсеМенеджер.Заголовок = "Все (" + ПросчитатьКоличествоЛидов(СписокВсе) + ")";
		
	Иначе
		
		Элементы.ГруппаВходящие.Заголовок = "Входящие (" + ПросчитатьКоличествоЛидов(СписокВходящие) + ")";
		Элементы.ГруппаНазначенные.Заголовок = "Назначенные (" + ПросчитатьКоличествоЛидов(СписокНазначенные) + ")";
		Элементы.ГруппаВОбработке.Заголовок = "В обработке (" + ПросчитатьКоличествоЛидов(СписокВОбработкеАдминистратор) + ")";
		Элементы.ГруппаВсе.Заголовок = "Все (" + ПросчитатьКоличествоЛидов(СписокВсеАдминистратор) + ")";
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПросчитатьКоличествоЛидов(Список)
	
	Запрос = Новый Запрос;
	Запрос.Текст = Список.ТекстЗапроса;
	Для Каждого СтрПараметр ИЗ Список.Параметры.Элементы Цикл
		Запрос.УстановитьПараметр(Строка(СтрПараметр.Параметр), СтрПараметр.Значение);
	КонецЦикла;
	Возврат Запрос.Выполнить().Выгрузить().Количество();
	
КонецФункции

