&НаКлиенте
Функция ОткрытьФормуДлительнойОперации(Знач ВладелецФормы, Знач ИдентификаторЗадания, ЗаголовокФормы) 
	
	ФормаДлительнойОперации = ПолучитьФорму("Обработка.Renault_АРМ_ContactCenter.Форма.ДлительнаяОперация", , ЭтаФорма, ИдентификаторЗадания);
	Если ФормаДлительнойОперации.Открыта() Тогда
		ФормаДлительнойОперации = ОткрытьФорму(
			"Обработка.Renault_АРМ_ContactCenter.Форма.ДлительнаяОперация",
			Новый Структура("ИдентификаторЗадания, ЗаголовокФормы", ИдентификаторЗадания, ЗаголовокФормы), 
			ВладелецФормы);
	Иначе
		ФормаДлительнойОперации.ВладелецФормы        = ВладелецФормы;
		ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания;
		ФормаДлительнойОперации.ЗаголовокФормы		 = ЗаголовокФормы;
		ФормаДлительнойОперации.Открыть();
	КонецЕсли;
	
	Возврат ФормаДлительнойОперации;
	
