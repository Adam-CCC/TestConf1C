&НаКлиенте
Процедура ОткрытьЛидКонтекст(Команда)
	
	Если Элементы.ГруппаИсполнители.ТекущаяСтраница.Имя = "ГруппаТрафикМенеджер" Тогда
		Если Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаМойТрафик" Тогда
			ИмяСписка = "СписокМойТрафик";
		ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаВОбработкеМенеджер" Тогда
			ИмяСписка = "СписокВОбработке";
		ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаВсеВходящие" Тогда
			ИмяСписка = "СписокВсеВходящие";
		ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаВсеМенеджер" Тогда
			ИмяСписка = "СписокВсе";
		Иначе
			Возврат;
		КонецЕсли;
	ИначеЕсли Элементы.ГруппаИсполнители.ТекущаяСтраница.Имя = "ГруппаТрафикАдминистратор" Тогда
		Если Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаВходящие" Тогда
			ИмяСписка = "СписокВходящие";
		ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаНазначенные" Тогда
			ИмяСписка = "СписокНазначенные";
		ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаВОбработке" Тогда
			ИмяСписка = "СписокВОбработкеАдминистратор1";
		ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаВсе" Тогда
			ИмяСписка = "СписокВсеАдминистратор1";
		Иначе
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаОбработкаСообщений.Видимость = Истина;
	
	ТекДанные = Элементы[ИмяСписка].ТекущиеДанные;
	ДобавитьСтраницу(ТекДанные);
	
	//ОткрытьЛид(Элементы[ИмяСписка].ТекущиеДанные.Ссылка);
	
КонецПроцедуры

