&НаСервере
Процедура ОбновитьДанные(ТекСтр)
	
	Клиент_ФИО = "";
	Клиент_Пол = "";
	Клиент_Телефон = "";
	Клиент_Email = "";
	Клиент_ДР = '00010101';
	ДатаЗагрузкиЛида = '00010101';
	КритическаяДата = '00010101';
	Лид_Приоритет = "";
	КатегорияЛида = "";
	ИсточникЛида = "";
	ДилерскийЦентр = Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка();
	Лид = Документы.Renault_Лид.ПустаяСсылка();
	Лид_ВидТип = Перечисления.Renault_ТипыЛидов.ПустаяСсылка();
	Лид_ВидКлассификация = Справочники.Renault_КлассификацияЛидов.ПустаяСсылка();
	Лид_ПродПримечание = "";
	Лид_ВЧерномСписке = Ложь;
	Лид_ПримечаниеДилера = "";
	Лид_Ответственный = Справочники.Сотрудники.ПустаяСсылка();
	
	СтрСоответствие = РеквизитФормыВЗначение("ТаблицаСоответствийТрафикаИСтраниц").Найти(ТекСтр, "ИмяСтраницы");
	ИДТрафика = СтрСоответствие.ИдентификаторТрафика;
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
	ДилерскийЦентр = Запись.ДилерскийЦентр;
	
	ТипТрафика = Запись.ТипТрафика;
	
	ПолучитьДанныеКлиента(Запись.Клиент);
	
	Если ТипТрафика = Справочники.CRM_ТипТрафика.ЛидRenault Тогда
		
		Лид = Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИДТрафика);
		ДатаЗагрузкиЛида = Лид.ДатаЗаогрузки;
		КритическаяДата = Лид.КритическаяДата;
		ПримечаниеVIN = Лид.VIN;
		ПримечаниеМодель = Лид.Модель;
		ПримечаниеДвигатель = Лид.Мотор;
		ПримечаниеПробег = Лид.Пробег;
		Лид_Приоритет = Лид.Приоритет;
		КатегорияЛида = Лид.Теги;
		ИсточникЛида = Лид.Канал;
		Лид_ВидТип = Лид.ВидУслуги.Тип;
		Лид_ВидКлассификация = Лид.ВидУслуги.Классификация;
		Лид_ПродПримечание = Лид.ПовторныхЛидов;
		Клиент_ДР = Лид.КлиентДеньРождения;
		Клиент_Email = Лид.КлиентАдресЭлектроннойПочты;
		Клиент_Телефон = Лид.КлиентМобильныйТелефон;
		Лид_ПримечаниеДилера = Лид.ПримечаниеДилера;
		Лид_Ответственный = Лид.Менеджер;
		
		ПродИсторияЗаполнить(Лид.Ссылка, СтрЗаменить(СтрСоответствие.ИмяСтраницы, "Сообщение", ""));
		
		ИсторияПерепискиЗаполнить();
		
		Лид_ВЧерномСписке = ПочтаВЧерномСписке(Лид.КлиентАдресЭлектроннойПочты);
		
	ИначеЕсли ТипТрафика = Справочники.CRM_ТипТрафика.Email Тогда
		
		Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИДТрафика);
		Лид_Ответственный = Запись.Менеджер;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_Трафик.Клиент,
		|	Renault_Трафик.ДилерскийЦентр.BIR КАК BIR,
		|	Renault_ТрафикПисьма.ДатаПоступления КАК ДатаСообщения,
		|	Renault_ТрафикПисьма.ТемаПисьма,
		|	Renault_ТрафикПисьма.ТекстПисьма КАК ТекстПисьма,
		|	Renault_ТрафикПисьма.ФорматТекста КАК ФорматТекста,
		|	Renault_ТрафикПисьма.ПочтаКлиента КАК Email,
		|	Renault_ТрафикПисьма.УчетнаяЗапись КАК УчетнаяЗаписьПисьмо
		|ИЗ
		|	РегистрСведений.Renault_ТрафикПисьма КАК Renault_ТрафикПисьма
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Трафик КАК Renault_Трафик
		|		ПО Renault_ТрафикПисьма.ИдТрафика = Renault_Трафик.Идентификатор
		|ГДЕ
		|	Renault_ТрафикПисьма.ИдТрафика = &ИдТрафика
		|УПОРЯДОЧИТЬ ПО
		|	Renault_ТрафикПисьма.ДатаПоступления УБЫВ";
		Запрос.УстановитьПараметр("ИдТрафика", ИДТрафика);
		Табл = Запрос.Выполнить().Выгрузить();
		
		ИсторияПерепискиЗаполнить();
		
		Если Табл.Количество() > 0 Тогда
			
			Клиент_Email = Табл[0].Email;			
			Макет = Обработки.Renault_АРМ_ContactCenter.ПолучитьМакет("МакетИсторияПереписки");
			
			Область = Макет.ПолучитьОбласть("Сообщение");
			Область.Параметры.Период = Табл[0].ДатаСообщения;
			Область.Параметры.Сообщение = Табл[0].ТекстПисьма;
			ИсторияПереписки.Вывести(Область);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДопЗапрос = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочиеЛисты.ID,
	|	Renault_РабочиеЛисты.Клиент,
	|	Renault_РабочиеЛисты.Сотрудник,
	|	Renault_РабочиеЛисты.ЛистЗакрыт,
	|	"""" КАК Почта,
	|	"""" КАК Телефон,
	|	Renault_РабочиеЛисты.ДатаID КАК Дата,
	|	Renault_РабочиеЛисты.IDK
	|ИЗ
	|	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Запись.Клиент);
	ТаблицаРабочиеЛисты.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Если ЗначениеЗаполнено(СокрЛП(Клиент_Email)) Тогда
		ДопЗапрос = ДопЗапрос + "
		|	ИЛИ КонтактнаяИнформация.Представление ПОДОБНО ""%"" + &EMail + ""%""";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СокрЛП(Клиент_Телефон)) Тогда
		ДопЗапрос = ДопЗапрос + "
		|	ИЛИ КонтактнаяИнформация.Представление ПОДОБНО ""%"" + &Телефон + ""%""";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект КАК Клиент
	|ПОМЕСТИТЬ втКлиенты
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	(КонтактнаяИнформация.Объект.Наименование ПОДОБНО ""%"" + &Наименование + ""%""" + ДопЗапрос + ")
	|	И (КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	|			ИЛИ КонтактнаяИнформация.Объект ССЫЛКА Справочник.CRM_ПотенциальныеКонтрагенты)
	|
	|СГРУППИРОВАТЬ ПО
	|	КонтактнаяИнформация.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Представление
	|ПОМЕСТИТЬ втТелефон
	|ИЗ
	|	втКлиенты КАК втКлиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО втКлиенты.Клиент = КонтактнаяИнформация.Объект
	|ГДЕ
	|	КонтактнаяИнформация.Тип = &ТипТелефон
	|	И КонтактнаяИнформация.ЗначениеПоУмолчанию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Представление
	|ПОМЕСТИТЬ втПочта
	|ИЗ
	|	втКлиенты КАК втКлиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО втКлиенты.Клиент = КонтактнаяИнформация.Объект
	|ГДЕ
	|	КонтактнаяИнформация.Тип = &ТипПочта
	|	И КонтактнаяИнформация.ЗначениеПоУмолчанию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втКлиенты.Клиент,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Renault_РабочиеЛисты.IDK, 0) <> 0
	|			ТОГДА Renault_РабочиеЛисты.IDK
	|		ИНАЧЕ Renault_Лид.Ссылка
	|	КОНЕЦ КАК Лид,
	|	ВЫБОР
	|		КОГДА втКлиенты.Клиент ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Потенциальный,
	|	втТелефон.Представление КАК Телефон,
	|	втПочта.Представление КАК EMail,
	|	Renault_РабочиеЛисты.Ссылка КАК РабочийЛист
	|ПОМЕСТИТЬ втДанные
	|ИЗ
	|	втКлиенты КАК втКлиенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Лид КАК Renault_Лид
	|		ПО втКлиенты.Клиент = Renault_Лид.Клиент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
	|		ПО втКлиенты.Клиент = Renault_РабочиеЛисты.Клиент
	|		ЛЕВОЕ СОЕДИНЕНИЕ втТелефон КАК втТелефон
	|		ПО втКлиенты.Клиент = втТелефон.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПочта КАК втПочта
	|		ПО втКлиенты.Клиент = втПочта.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втДанные.Клиент,
	|	втДанные.Лид,
	|	втДанные.Потенциальный,
	|	втДанные.Телефон,
	|	втДанные.EMail,
	|	втДанные.РабочийЛист
	|ИЗ
	|	втДанные КАК втДанные
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЕСТЬNULL(втДанные.Лид, 0) = 0
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("EMail", СокрЛП(Клиент_Email));
	Запрос.УстановитьПараметр("Телефон", СокрЛП(Клиент_Телефон));
	Запрос.УстановитьПараметр("Наименование", СокрЛП(Клиент_ФИО));
	Запрос.УстановитьПараметр("ТипПочта", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("ТипТелефон", Перечисления.ТипыКонтактнойИнформации.Телефон);
	ТаблицаЛиды.Загрузить(Запрос.Выполнить().Выгрузить());
	                                                          
	// { DMSREN-1217. Управление видимостью ссылки на конфигурацию клиента
	ЭлементСсылкаНаКонфигурацию = Элементы.Найти("ПолеСсылкаНаКонфигурацию" + СтрЗаменить(СтрСоответствие.ИмяСтраницы, "Сообщение", ""));
	Если ЭлементСсылкаНаКонфигурацию <> Неопределено тогда
		ЭлементСсылкаНаКонфигурацию.Видимость = ЗначениеЗаполнено(СсылкаНаКонфигурациюКлиента);		
	КонецЕсли;
	// DMSREN-1217 } 
	// { DMSREN-1178
	ЭлементФормы = Элементы.Найти("ПрикрепитьКРЛ" + СтрЗаменить(СтрСоответствие.ИмяСтраницы, "Сообщение", ""));
	Если ЭлементФормы <> Неопределено И ЗначениеЗаполнено(Лид.РабочийЛистПрикрепленый) тогда
		ЭлементФормы.Заголовок = "Прикреплен к РЛ №" + Лид.РабочийЛистПрикрепленый.IDK;
		ЭлементФормы.Доступность = ИСТИНА;
	КонецЕсли;
	// DMSREN-1178 }
КонецПроцедуры

Функция ПочтаВЧерномСписке(Адрес)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ЗаблокированныйТрафик.IDТрафика
	|ИЗ
	|	РегистрСведений.Renault_ЗаблокированныйТрафик КАК Renault_ЗаблокированныйТрафик
	|ГДЕ
	|	Renault_ЗаблокированныйТрафик.ЭлектронныйАдрес = &ЭлектронныйАдрес";
	Запрос.УстановитьПараметр("ЭлектронныйАдрес", Адрес);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере 
Процедура ПродИсторияЗаполнить(Лид, НомерСообщения)
	
	ПродИстория.Очистить();
	Макет = Обработки.Renault_АРМ_ContactCenter.ПолучитьМакет("МакетПродИстория");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СервиснаяИстория.VIN,
	|	СервиснаяИстория.Модель,
	|	СервиснаяИстория.Версия,
	|	СервиснаяИстория.ДатаЗаписи,
	|	СервиснаяИстория.ОписаниеРабот
	|ПОМЕСТИТЬ Вт_ТЗ
	|ИЗ
	|	РегистрСведений.Renault_СервиснаяИстория КАК СервиснаяИстория
	|ГДЕ
	|	СервиснаяИстория.Лид = &Лид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_ТЗ.Модель КАК Модель,
	|	Вт_ТЗ.ДатаЗаписи КАК Период,
	|	Вт_ТЗ.ОписаниеРабот КАК Сообзщение,
	|	Вт_ТЗ.VIN КАК VIN,
	|	Вт_ТЗ.Версия КАК ВариантКомплектации
	|ИЗ
	|	Вт_ТЗ КАК Вт_ТЗ
	|
	|УПОРЯДОЧИТЬ ПО
	//|	Модель,
	|	Вт_ТЗ.ДатаЗаписи УБЫВ";
	Запрос.УстановитьПараметр("Лид", Лид);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		//Элементы.ГруппаИстория.Видимость = Ложь;
		Элементы["ПродИстория" + НомерСообщения].Видимость = Ложь;
	Иначе
		Выборка = Результат.Выбрать();
		Счетчик = 0;
		Пока Выборка.Следующий() Цикл
			
			Область = Макет.ПолучитьОбласть("Шаблон");
			ЗаполнитьЗначенияСвойств(Область.Параметры, Выборка);
			Область.Параметры.Автомобиль = "" + Выборка.Модель + " " + Выборка.ВариантКомплектации;
			//Если Счетчик%2 = 0 Тогда 
			//	Область.Области.Шаблон.ЦветФона = Новый Цвет(255, 237, 159);
			//КонецЕсли;  
			ПродИстория.Вывести(Область);
			Счетчик = Счетчик +1;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВЧерныйСписок(Команда)
	
	Если НЕ ЗначениеЗаполнено(Клиент_Email) Тогда
		ПоказатьПредупреждение(, "У клиента отсутсвует электронная почта");
		Возврат;
	КонецЕсли;
	
	Лид_ВЧерномСписке = Не Лид_ВЧерномСписке;
	Если Лид_ВЧерномСписке Тогда
		Причина = "";
		ВвестиСтроку(Причина, "Введите причину внесения в черный список");
		ДобавитьВЧерныйСписокНаСервере(Истина, Причина);
		ПоказатьПредупреждение(, "Вы больше не будете получать сообщения с этой электронной почты");
	Иначе
		ДобавитьВЧерныйСписокНаСервере(Ложь);
		ПоказатьПредупреждение(, "Электронная почта исключена из черного списка");
	КонецЕсли;
	//ОбновитьОтображениеЛид();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВЧерныйСписокНаСервере(ВключитьВЧС = Истина, ПричинаБлокировки = "")
	
	Если ВключитьВЧС = Истина Тогда
		Мен = РегистрыСведений.Renault_ЗаблокированныйТрафик.СоздатьМенеджерЗаписи();
		Мен.Идентификатор = Новый УникальныйИдентификатор;
		Мен.IDТрафика = ИДТрафика;
		Мен.ЭлектронныйАдрес = Клиент_Email;
		Мен.ПризнакБлокировки = 1;
		Мен.ПричинаБлокировки = ПричинаБлокировки;
		Мен.Пользователь = ПараметрыСеанса.Пользователь;
		Мен.ДатаБлокировки = ТекущаяДата();
		Мен.Записать();
	Иначе //исключим
		Набор = РегистрыСведений.Renault_ЗаблокированныйТрафик.СоздатьНаборЗаписей();
		Набор.Отбор.IDТрафика.Установить(ИДТрафика);
		Набор.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВзятьСебе(Команда)
	
	ЭтоЛид = СтрНайти(Команда.Имя, "НеЛид") = 0;
	
	Если Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаОбработкаСообщений Тогда
		
		ВзятьСебеНаСервере(ИДТрафика, ЭтоЛид);
		
	Иначе
		
		Если Элементы.ГруппаИсполнители.ТекущаяСтраница.Имя = "ГруппаТрафикМенеджер" Тогда
			Если Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаМойТрафик" Тогда
				ИмяСписка = "СписокМойТрафик";
			ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаВОбработкеМенеджер" Тогда
				ИмяСписка = "СписокВОбработке";
			ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаВсеВходящие" Тогда
				ИмяСписка = "СписокВсеВходящие";
			ИначеЕсли Элементы.ГруппаСтрМенеджер.ТекущаяСтраница.Имя = "ГруппаВсеМенеджер" Тогда
				ИмяСписка = "СписокВсе";
			Иначе
				Возврат;
			КонецЕсли;
		ИначеЕсли Элементы.ГруппаИсполнители.ТекущаяСтраница.Имя = "ГруппаТрафикАдминистратор" Тогда
			Если Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаВходящие" Тогда
				ИмяСписка = "СписокВходящие";
			ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаНазначенные" Тогда
				ИмяСписка = "СписокНазначенные";
			ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаВОбработке" Тогда
				ИмяСписка = "СписокВОбработкеАдминистратор1";
			ИначеЕсли Элементы.ГруппаСтрАдминистратор.ТекущаяСтраница.Имя = "ГруппаВсе" Тогда
				ИмяСписка = "СписокВсеАдминистратор1";
			Иначе
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
		
		ТекДанные = Элементы[ИмяСписка].ТекущиеДанные;
		
		ИдентификаторТрафика = ТекДанные.Идентификатор;
		
		ВзятьСебеНаСервере(ИдентификаторТрафика, ЭтоЛид);
		
		Элементы[ИмяСписка].Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВзятьСебеНаСервере(ИдентификаторТрафика, ЭтоЛид = Истина)
	
	ТекПользователь = ПараметрыСеанса.Пользователь;
	
	Запись = Renault_КонтактЦентр_Общий.ПолучитьЗаписьТрафикаПоID(ИдентификаторТрафика);
	Запись.Менеджер = ТекПользователь.Сотрудник;
	Запись.Записать();
	
	Renault_ОнлайнКонсультант.ПослатьПочтовоеСообщениеПользователю_КЦ(Запись, Запись.Менеджер, "Назначен лид");
	
	Если ЭтоЛид Тогда
		Лид = Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИдентификаторТрафика);
		Об = Лид.ПолучитьОбъект();
		Об.Менеджер = ТекПользователь.Сотрудник;
		Об.Записать();
	КонецЕсли;
	
	Если Элементы.ГруппаИсполнители.ТекущаяСтраница = Элементы.ГруппаОбработкаСообщений Тогда
		
		ТабСоответствий = РеквизитФормыВЗначение("ТаблицаСоответствийТрафикаИСтраниц");
		СтрСоответствия = ТабСоответствий.Найти(ИдентификаторТрафика, "ИдентификаторТрафика");
		Индекс = Число(Сред(СтрСоответствия.ИмяСтраницы, 10));
		
		//ЗаполнитьОтветственногоНаСервере(ТекПользователь, Документы.Renault_Лид.НайтиПоРеквизиту("ТрафикИД", ИДТрафика));
		//Лид_Ответственный = ТекПользователь;
		Элементы["Ответственный" + Индекс].Видимость = Истина;
		Элементы["КнОтказаться" + Индекс].Видимость = Истина;
		Элементы["КнВзятьСебе" + Индекс].Видимость = Ложь;
		Элементы["ОтветитьEmail" + Индекс].Доступность = Истина;
		Элементы["ОтветитьТелефон" + Индекс].Доступность = Истина;
		Лид_Ответственный = ТекПользователь.Сотрудник;
		
	КонецЕсли;
	
КонецПроцедуры

