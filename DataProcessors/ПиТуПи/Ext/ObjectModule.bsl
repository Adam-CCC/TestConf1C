Процедура ОтправитьПисьмо() Экспорт
	
	Сообщить("Формирование и отправка письма");
	
	ПодготовкаФайлаДляОтправки();
	
	НаписатьИОтправитьПисьмо();
	 
КонецПроцедуры

Процедура ПисьмаОтправить() Экспорт
	
	Сообщить("Формирование и отправка писем");
	
	Если ПолучателиПисем.Количество() = 0 Тогда
		Сообщить("ОШИБКА! Не заполнены получатели писем");
		Форма = ЭтотОбъект.ПолучитьФорму("ФормаПолучатели");
		Если Не Форма.Открыта() Тогда
			Форма.Открыть();
		КонецЕсли; 
		Возврат;
 	КонецЕсли; 
 	
	ПодготовкаФайлаДляОтправкиПисем();
	
	НаписатьИОтправитьПисьмаПоСписку();
	 
КонецПроцедуры

Процедура НаписатьИОтправитьПисьмаПоСписку() Экспорт
	
	Сотр =ПараметрыСеанса.Пользователь.Сотрудник;
	
	АдресЭлПочты = НайтиЭлАдрес(Сотр);
	
	Сообщить("Адрес электронной почты : "+АдресЭлПочты+" для "+Сотр);
	
	ЭтоПервый  = Истина;
	мКому = Новый Массив;
	мКопии = Новый Массив;
	
	Для каждого Эл Из ПолучателиПисем Цикл
		АдресЭлПочты = Эл.АдресЭлПочты;
	    Если обЗначениеНеЗаполнено(АдресЭлПочты) Тогда
			Продолжить;
		КонецЕсли;  
		Если ЭтоПервый Тогда
  			мКому.Добавить(АдресЭлПочты);
			ЭтоПервый=Ложь;
 		Иначе	
	 		мКопии.Добавить(АдресЭлПочты);	 
 		КонецЕсли; 
 	КонецЦикла; 
  	
 	СсылкаДляПисьма = "";
 	Суть = "Проверьте просроченные заказы по своему ДЦ. Письмо сформировано: "+ТекущаяДата();
 	ТемаПисьма = Суть;
	
	СоздатьИОтправитьЭлПисьмо(мКому,мКопии,ТемаПисьма,Суть,СсылкаДляПисьма,ИмяФайлаЭксел);
 
КонецПроцедуры

