Функция НайтиЭлАдрес(ВыбСотрудник) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	КИ.Объект КАК Объект,
	|	КИ.Вид КАК Вид,
	|	КИ.Представление КАК Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Объект = &ВыбСотрудник
	|	И КИ.Вид = &ВыбВид";
	
	Запрос.УстановитьПараметр("ВыбСотрудник", ВыбСотрудник);
	Запрос.УстановитьПараметр("ВыбВид", Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Представление;
	КонецЦикла;
	
	Возврат ""; 
	
КонецФункции	

Процедура ПодготовкаФайлаДляОтправкиПисем() Экспорт
	
	Если обЗначениеНеЗаполнено(ДилерскийЦентр) Тогда
		Предупреждение("ОШИБКА! Не заполнен Дилерский Центр. Подготовка файла для письма невозможна");
  		Возврат;
 	КонецЕсли; 
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = ЭтотОбъект.ПолучитьМакет("МакетПечать1");
	// Заголовок
	
	Если ДилерскийЦентр <> Справочники.ДилерскиеЦентры.Общий Тогда
		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.ДилерскийЦентр=ДилерскийЦентр;
		ТабДок.Вывести(Область);
		
		Отбор = Новый Структура;
		Отбор.Вставить("ДилерскийЦентр",ДилерскийЦентр);
		
		Для ёё=1 По 5 Цикл
			
			ТекущийЦвет = "";
			
			Если ёё=1 Тогда
				Выборка = ЭтотОбъект.ТчЗаказы1.НайтиСтроки(Отбор);	
				ТекущийЦвет = "Первая неделя";
			ИначеЕсли ёё=2 Тогда
				Выборка = ЭтотОбъект.ТчЗаказы2.НайтиСтроки(Отбор);	
				ТекущийЦвет = "Вторая неделя";
			ИначеЕсли ёё=3 Тогда
				Выборка = ЭтотОбъект.ТчЗаказы3.НайтиСтроки(Отбор);	
				ТекущийЦвет = "Третья неделя";
			ИначеЕсли ёё=4 Тогда
				Выборка = ЭтотОбъект.ТчЗаказы4.НайтиСтроки(Отбор);	
				ТекущийЦвет = "Четвертая неделя";
			Иначе 
				Выборка = ЭтотОбъект.ТчЗаказы5.НайтиСтроки(Отбор);	
				ТекущийЦвет = "Пятая неделя и более";
			КонецЕсли; 
			
			Если Выборка.Количество() > 0 Тогда
				Область = Макет.ПолучитьОбласть("ЗаголовокЦвета");
				Область.Параметры.ТекущийЦвет=ТекущийЦвет;
				ТабДок.Вывести(Область);
				Область = Макет.ПолучитьОбласть("РеквизитыШапка");
				ТабДок.Вывести(Область);
			КонецЕсли; 
			
			Реквизиты = Макет.ПолучитьОбласть("Реквизиты");
			Для каждого Эл Из Выборка Цикл
				Реквизиты.Параметры.Заполнить(эл);
				ТабДок.Вывести(Реквизиты);
			КонецЦикла;   
			
		КонецЦикла; 
 		
	Иначе	
		
		//Область = Макет.ПолучитьОбласть("Заголовок");
		//Область.Параметры.ДилерскийЦентр=ДилерскийЦентр;
		//ТабДок.Вывести(Область);
		
		СЗ_ДЦ = Новый СписокЗначений;
		
		Для ёё=1 По 5 Цикл
			
			Если ёё=1 Тогда
				ТчЗаказы = ТчЗаказы1;
			ИначеЕсли ёё=2 Тогда
				ТчЗаказы = ТчЗаказы2;
			ИначеЕсли ёё=3 Тогда
				ТчЗаказы = ТчЗаказы3;
			ИначеЕсли ёё=4 Тогда
				ТчЗаказы = ТчЗаказы4;
			ИначеЕсли ёё=5 Тогда
				ТчЗаказы = ТчЗаказы5;
			КонецЕсли; 
			
			Для Каждого Стр из ТчЗаказы Цикл 
				ТекДЦ = Стр.ДилерскийЦентр;
				Если СЗ_ДЦ.НайтиПоЗначению(ТекДЦ) = Неопределено тогда 
					СЗ_ДЦ.Добавить(ТекДЦ); 
				КонецЕсли; 	
			КонецЦикла;	
			
		КонецЦикла;
		
		Сообщить("Размер списка дилерских центров: "+СЗ_ДЦ.Количество());
		
		//   	Для Каждого зн из сз1 цикл 
		//   		если сз2.НайтиПоЗначению(зн.Значение)=неопределено тогда 
		//   			сз2.Добавить(зн.Значение); 
		//   		КонецЕсли 
		//   	КонецЦикла;
		
		Для каждого ТекДЦ  Из СЗ_ДЦ Цикл
			
			Область = Макет.ПолучитьОбласть("Заголовок");
			Область.Параметры.ДилерскийЦентр=ТекДЦ;
			ТабДок.Вывести(Область);
			
			Отбор = Новый Структура;
			Отбор.Вставить("ДилерскийЦентр",ТекДЦ.Значение);
			
			ТабДок.НачатьАвтогруппировкуСтрок();
			
			Для ёё=1 По 5 Цикл
				
				ТекущийЦвет = "";
				
				Если ёё=1 Тогда
					Выборка = ЭтотОбъект.ТчЗаказы1.НайтиСтроки(Отбор);	
					ТекущийЦвет = "Первая неделя";
				ИначеЕсли ёё=2 Тогда
					Выборка = ЭтотОбъект.ТчЗаказы2.НайтиСтроки(Отбор);	
					ТекущийЦвет = "Вторая неделя";
				ИначеЕсли ёё=3 Тогда
					Выборка = ЭтотОбъект.ТчЗаказы3.НайтиСтроки(Отбор);	
					ТекущийЦвет = "Третья неделя";
				ИначеЕсли ёё=4 Тогда
					Выборка = ЭтотОбъект.ТчЗаказы4.НайтиСтроки(Отбор);	
					ТекущийЦвет = "Четвертая неделя";
				Иначе 
					Выборка = ЭтотОбъект.ТчЗаказы5.НайтиСтроки(Отбор);	
					ТекущийЦвет = "Пятая неделя и более";
				КонецЕсли; 
				
				Если Выборка.Количество() > 0 Тогда
					Область = Макет.ПолучитьОбласть("ЗаголовокЦвета");
					Область.Параметры.ТекущийЦвет=ТекущийЦвет;
					ТабДок.Вывести(Область,1,"ДЦ",Ложь);
					Область = Макет.ПолучитьОбласть("РеквизитыШапка");
					ТабДок.Вывести(Область,2,"Шапка",Ложь);
				КонецЕсли; 
				
				Реквизиты = Макет.ПолучитьОбласть("Реквизиты");
				Для каждого Эл Из Выборка Цикл
					Реквизиты.Параметры.Заполнить(эл);
					ТабДок.Вывести(Реквизиты,2,"Заказы",Ложь);
				КонецЦикла;   
				
  			КонецЦикла; //По 5 закдладкам
			
			ТабДок.ЗакончитьАвтогруппировкуСтрок();
			
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЦикла; // По ДЦ
		
 	КонецЕсли; 
 	
	ТабДок.АвтоМасштаб=Истина;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Защита = Ложь;
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.ОтображатьЗаголовки = Ложь;
	Если ДилерскийЦентр <> Справочники.ДилерскиеЦентры.Общий Тогда
		ТабДок.ФиксацияСверху=5;
 	КонецЕсли; 
	 
	ТабДок.Показать("Вот что получилось "+ДилерскийЦентр );
	
	WSS=Новый COMОбъект("WScript.Shell");
	//Сообщить(WSS.SpecialFolders().Item("Desktop"));
	ИмяФайлаЭксел=СокрЛП(WSS.SpecialFolders().Item("Desktop"))+"\"+СокрЛП(ДилерскийЦентр)+".XLSX";
	
	Сообщить("Имя  файла = "+ИмяФайлаЭксел);
 
	ТабДок.Записать(ИмяФайлаЭксел,ТипФайлаТабличногоДокумента.XLSX);


	

КонецПроцедуры
 

