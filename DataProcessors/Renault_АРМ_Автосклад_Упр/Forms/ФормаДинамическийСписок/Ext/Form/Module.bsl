Функция Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей(VINАвтомобиля = "", МассивСкладовДилера, BIR_Distri, ПоказыватьЗарезервированные, ПоказыватьЗакрепленныеЗаКлиентом, ПоказыватьВыданныеАвтомобили, ПоказыватьНеДляПродажи, МодельАвтомобиля = "", ВерсияАвтомобиля = "", ЦветАвтомобиля = "", ПоказыватьДоговоры = Истина, ДоговорНаАвансСсылка = Неопределено, ДатаНеПоказыватьВыданныеАвтомобили = Неопределено, РежимПодтверждения = Ложь, СтруктураОтбора = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИспользоватьТиповойДО = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьТиповойУчетДО;
	
	Renault_Лицензирование.ПроверитьНаличиеЛицензий();
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// начало добавление Зеленчук
	ВерсияАвтомобиляМассив = ТипЗнч(ВерсияАвтомобиля) = Тип("Массив");
	// окончание добавление Зеленчук
	
	Текст = "ВЫБРАТЬ
	        |	СостояниеАвтомобилей.Автомобиль КАК Автомобиль,
	        |	ВЫБОР
	        |		КОГДА СостояниеАвтомобилей.VIN = """"
	        |			ТОГДА ТаблицаАвтомобилей.VIN
	        |		ИНАЧЕ СостояниеАвтомобилей.VIN
	        |	КОНЕЦ КАК VIN,
	        |	ВЫБОР
	        |		КОГДА СостояниеАвтомобилей.Модель = ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
	        |			ТОГДА ТаблицаАвтомобилей.Автомобиль.Модель
	        |		ИНАЧЕ СостояниеАвтомобилей.Модель
	        |	КОНЕЦ КАК Модель,
	        |	ВЫБОР
	        |		КОГДА СостояниеАвтомобилей.Версия = ЗНАЧЕНИЕ(Справочник.ВариантыКомплектации.ПустаяСсылка)
	        |			ТОГДА ТаблицаАвтомобилей.Автомобиль.ВариантКомплектации
	        |		ИНАЧЕ СостояниеАвтомобилей.Версия
	        |	КОНЕЦ КАК Версия,
	        |	ВЫБОР
	        |		КОГДА СостояниеАвтомобилей.Цвет = ЗНАЧЕНИЕ(Справочник.Цвета.ПустаяСсылка)
	        |			ТОГДА ТаблицаАвтомобилей.Автомобиль.Цвет
	        |		ИНАЧЕ СостояниеАвтомобилей.Цвет
	        |	КОНЕЦ КАК Цвет,
	        |	СостояниеАвтомобилей.MODEL КАК МодельАртикул,
	        |	СостояниеАвтомобилей.VERSION КАК ВерсияАртикул,
	        |	СостояниеАвтомобилей.COLOR КАК ЦветАртикул,
	        |	ВЫБОР
	        |		КОГДА ТаблицаАвтомобилей.Автомобиль ЕСТЬ NULL
	        |			ТОГДА ""ТолькоАФМ""
	        |		ИНАЧЕ ""ДилерИАФМ""
	        |	КОНЕЦ КАК ТипПрисутствияВРегистрах,
	        |	ВЫБОР
	        |		КОГДА НЕ ТаблицаАвтомобилей.Автомобиль ЕСТЬ NULL
	        |			ТОГДА ИСТИНА
	        |		ИНАЧЕ ЛОЖЬ
	        |	КОНЕЦ КАК НаОстаткахДилера,
	        |	СостояниеАвтомобилей.CLIENT_TYPE КАК АФМ_ТипКлиентаDistri,
	        |	ЕСТЬNULL(СостояниеАвтомобилей.Статус, ЗНАЧЕНИЕ(Перечисление.CRM_СтатусыАвтомобилей.пустаяСсылка)) КАК АФМ_СтатусАвтомобиля,
	        |	СостояниеАвтомобилей.DATE_PAY КАК АФМ_ДатаОплатыДилеромФакт,
	        |	СостояниеАвтомобилей.OPTIONS КАК АФМ_СоставОпций,
	        |	СостояниеАвтомобилей.YEAR КАК АФМ_ГодВыпуска,
	        |	ВЫБОР
	        |		КОГДА СостояниеАвтомобилей.PTS_NUM = """"
	        |			ТОГДА ЛОЖЬ
	        |		ИНАЧЕ ИСТИНА
