&НаКлиенте
Процедура ОформитьПерепродажу(Команда)
	
	ТекущиеДанные = Элементы.ДемоПодмен.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_ЗаявкаНаАвтомобиль.Ссылка
		|ИЗ
		|	Документ.DMS_ЗаявкаНаАвтомобиль КАК DMS_ЗаявкаНаАвтомобиль
		|ГДЕ
		|	DMS_ЗаявкаНаАвтомобиль.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN", ТекущиеДанные.VIN);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОткрытьЗначение(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗаявкуНаЗамену(Команда)
	
	ТекСтрока = Элементы.ДемоПодмен.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;
		
	АвтомобильНЕДляЗаявки = ТекСтрока.Автомобиль;
	МодельДляЗаявки     = ТекСтрока.Модель;
	ВерсияДляЗаявки     = ТекСтрока.Версия;
	ЦветДляЗаявки       = ТекСтрока.Цвет;
	
	Если Не ЗначениеЗаполнено(МодельДляЗаявки)
		ИЛИ Не ЗначениеЗаполнено(ВерсияДляЗаявки)
		ИЛИ Не ЗначениеЗаполнено(ЦветДляЗаявки) Тогда
		
		ФормаХарактеристик = ПолучитьФорму("ВыборХарактеристикАвтомобиля", , ЭтаФорма);
		ФормаХарактеристик.Модель = МодельДляЗаявки;
		ФормаХарактеристик.Версия = ВерсияДляЗаявки;
		ФормаХарактеристик.Цвет   = ЦветДляЗаявки;
		
		РезультатВыбораХарактеристик = ФормаХарактеристик.ОткрытьМодально();
		
		Если РезультатВыбораХарактеристик <> Неопределено Тогда
			МодельДляЗаявки = РезультатВыбораХарактеристик.Модель;
			ВерсияДляЗаявки	= РезультатВыбораХарактеристик.Версия;
			ЦветДляЗаявки   = РезультатВыбораХарактеристик.Цвет;
		КонецЕсли;
		
	КонецЕсли;
	
	ПоказыватьЗарезервированные      = Ложь;
	ПоказыватьЗакрепленныеЗаКлиентом = Ложь;
	ПоказыватьНеДляПродажи           = Ложь;
	ПоказыватьВыданныеАвтомобили     = Ложь;
	
	мСтруктураОтбораАвтосклад = Renault_РаботаСПравамиПользователя.ПолучитьСтруктуруНастроекАвтосклад(ПараметрыСеанса.Пользователь);
	МассивСкладовДилера = ДилерскийЦентрПользователя.СкладыДилера.ВыгрузитьКолонку("Склад");
	мДатаНеПоказыватьВыданныеАвтомобили = ДилерскийЦентрПользователя.ДатаНеПоказыватьВыданныеАвтомобили;
	
	мСтруктураОтбораАвтосклад.Вставить("ТипЦен",ДилерскийЦентрПользователя.ТипЦенПродажи);
	ТаблицаАвтомобилей = CRM_Сервер.Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей("", МассивСкладовДилера, BIR_Distri, Ложь, Ложь, Ложь, Ложь, МодельДляЗаявки, ВерсияДляЗаявки, ЦветДляЗаявки, Ложь, Неопределено, мДатаНеПоказыватьВыданныеАвтомобили, Ложь, мСтруктураОтбораАвтосклад);
	
	Если ТаблицаАвтомобилей.Количество() > 0 Тогда
		
		ПоискТекущегоАвто = ТаблицаАвтомобилей.НайтиСтроки(Новый Структура("Автомобиль", АвтомобильНЕДляЗаявки));
		Если ПоискТекущегоАвто.Количество() > 0 Тогда
			ТаблицаАвтомобилей.Удалить(ПоискТекущегоАвто[0]);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТаблицаАвтомобилей.Количество() = 0 Тогда
		Сообщить("Нет доступных для продажи автомобилей модели "+МодельДляЗаявки+", версии "+ВерсияДляЗаявки+", цвета "+ ЦветДляЗаявки+"!");
		Возврат;
	КонецЕсли;
	
	ФормаВыборАвто                     = Справочники.Автомобили.ПолучитьФорму("ВыборИзТаблицыЗначений",ЭтаФорма);
	ФормаВыборАвто.ТабличноеПолеВыбора = ТаблицаАвтомобилей;
	
	ВыбранныйАвтоДляЗаявки      = ФормаВыборАвто.ОткрытьМодально();
	
	Если ВыбранныйАвтоДляЗаявки = Неопределено Тогда
		Сообщить("Автомобиль не выбран!");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаявка = Новый Структура();
	ПараметрыЗаявка.Вставить("Дата", ТекущаяДата());
	ПараметрыЗаявка.Вставить("Автор", ПараметрыСеанса.Пользователь);
	
	Если ТекСтрока.ТипЗаявки = "Демо" Тогда
		ПараметрыЗаявка.Вставить("ТипЗаявки", Справочники.DMS_ТипыЗаявки.Демо);
	Иначе 
		ПараметрыЗаявка.Вставить("ТипЗаявки", Справочники.DMS_ТипыЗаявки.Подменный);
	КонецЕсли;
	
	ПараметрыЗаявка.Вставить("VIN",    ВыбранныйАвтоДляЗаявки.VIN);
	ПараметрыЗаявка.Вставить("Версия", ВерсияДляЗаявки);
	ПараметрыЗаявка.Вставить("Модель", МодельДляЗаявки);
	ПараметрыЗаявка.Вставить("Цвет",   ЦветДляЗаявки);
	
	ДЦПользователя = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	
	Если ЗначениеЗаполнено(ДЦПользователя) Тогда
		Дилер = Справочники.Контрагенты.НайтиПоНаименованию(ДЦПользователя.Наименование);
		Если Дилер = Справочники.Контрагенты.ПустаяСсылка() тогда
			Дилер = СоздатьКонтрагентаИзДилера(ДЦПользователя);
		КонецЕсли;
		ПараметрыЗаявка.Вставить("Клиент", Дилер);
		ПараметрыЗаявка.Вставить("Счет",   ДЦПользователя.СчетSedre);
	КонецЕсли;
	
	ОткрытьФорму("Документ.DMS_ЗаявкаНаАвтомобиль.Форма.ФормаДокументаУпр", ПараметрыЗаявка, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СрокЭксплуатацииИстек(Команда)
	
	ЭлементОтбора = ДемоПодмен.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СрокЭксплуатацииИстек");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиВЭксплуатацию(Команда)
	
	ТекСтроки = Элементы.ДемоПодмен.ВыделенныеСтроки;
	Если ТекСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СкладДилера = Справочники.СкладыКомпании.ПустаяСсылка();
	ДокВвод = Неопределено;
	
	Для Каждого Стр Из ТекСтроки Цикл
		
		Если ТипЗнч(Стр.ДокументЭксплуатации) = Тип("ДокументСсылка.ВводВЭксплуатациюАвтомобилей") и ЗначениеЗаполнено(Стр.ДокументЭксплуатации) Тогда
			Сообщить("Автомобиль " + Стр.Автомобиль + " уже введен в эксплуатацию");
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.СкладДилера) Тогда
			Сообщить("Автомобиль остутствует на складах");
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Стр.ДокументЭксплуатации) = Тип("ДокументСсылка.СписаниеАктивов") и ЗначениеЗаполнено(Стр.ДокументЭксплуатации) Тогда
			Сообщить("Автомобиль " + Стр.Автомобиль + " уже был в эксплуатации");
			Продолжить;
		КонецЕсли;
		
		Если Стр.СкладДилера <> СкладДилера Тогда
			
			Если ДокВвод <> Неопределено Тогда
				ПараметрыОткрытия = Новый Структура("Ключ", ДокВвод);
				Результат = ОткрытьФормуМодально("Документ.ВводВЭксплуатациюАвтомобилей.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтаФорма);
			КонецЕсли;
			
			ДокВвод = Документы.ВводВЭксплуатациюАвтомобилей.СоздатьДокумент();
			
			ДокВвод.Заполнить(Неопределено);
			ДокВвод.УстановитьНовыйНомер();
			
			ДокВвод.ХозОперация = Справочники.ХозОперации.ВводВЭксплуатациюАвтомобилей;
			ДокВвод.Организация = ПараметрыСеанса.Организация;
			ДокВвод.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
			ДокВвод.СкладКомпании = Стр.СкладДилера;
			СкладДилера = Стр.СкладДилера;
		КонецЕсли;
		
		НовСтр = ДокВвод.Автомобили.Добавить();
		НовСтр.Автомобиль = Стр.Автомобиль;
		ДокВвод.ОбработкаРеквизита("Автомобили.Автомобиль", НовСтр);
		
		Актив = Справочники.ПрочиеАктивы.НайтиПоНаименованию("Автомобиль " + Стр.Автомобиль.Модель + " " + Стр.Автомобиль.VIN);
		
		Если обЗначениеНеЗаполнено(Актив) Тогда
			// создадим новый элемент прочие активы
			НовыйЭлемент = Справочники.ПрочиеАктивы.СоздатьЭлемент();
			НовыйЭлемент.ВидПрочегоАктива = Перечисления.ВидыПрочихАктивов.ОсновноеСредство;
			НовыйЭлемент.ТипНоменклатуры  = Справочники.ТипыНоменклатуры.Автомобили;
			НовыйЭлемент.УстановитьНовыйКод();
			НовыйЭлемент.ИнвентарныйНомер = НовыйЭлемент.Код;
			НовыйЭлемент.Наименование = "Автомобиль " + Стр.Автомобиль.Модель + " " + Стр.Автомобиль.VIN;
			НовыйЭлемент.Номенклатура = Справочники.Номенклатура.Автомобиль;
			ОсновнойТипЭксплуатации = Справочники.ТипыЭксплуатации.НайтиПоРеквизиту("СпособНачисленияАмортизации", Перечисления.СпособыНачисленияАмортизации.Линейный);
			Если ОсновнойТипЭксплуатации = Справочники.ТипыЭксплуатации.ПустаяСсылка() Тогда
				ОсновнойТипЭксплуатации = Справочники.ТипыЭксплуатации.СоздатьЭлемент();
				ОсновнойТипЭксплуатации.СпособНачисленияАмортизации = Перечисления.СпособыНачисленияАмортизации.Линейный;
				ОсновнойТипЭксплуатации.АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ПерваяГруппа;
				ОсновнойТипЭксплуатации.Наименование = "Линейный";
				ОсновнойТипЭксплуатации.Записать();
			КонецЕсли;
			НовыйЭлемент.ОсновнойТипЭксплуатации = ОсновнойТипЭксплуатации;
			НовыйЭлемент.СрокПолезногоИспользования = НовыйЭлемент.ПолучитьСрокПолезногоИспользования(ОсновнойТипЭксплуатации.АмортизационнаяГруппа);
			НовыйЭлемент.Записать();
			Актив = НовыйЭлемент.Ссылка;
		КонецЕсли;
		
		НовСтр.Актив = Актив;
		ДокВвод.ОбработкаРеквизита("Автомобили.Актив", НовСтр);
		
	КонецЦикла;
	
	Если ДокВвод <> Неопределено Тогда
		ПараметрыОткрытия = Новый Структура("Ключ", ДокВвод);
		Результат = ОткрытьФормуМодально("Документ.ВводВЭксплуатациюАвтомобилей.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиИзЭксплуатации(Команда)
	
	ТекСтроки = Элементы.ДемоПодмен.ВыделенныеСтроки;
	Если ТекСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Основание = Документы.ВводВЭксплуатациюАвтомобилей.ПустаяСсылка();
	ДокВвод = Неопределено;
	
	Для Каждого Стр Из ТекСтроки Цикл
		
		Если ТипЗнч(Стр.ДокументЭксплуатации) = Тип("ДокументСсылка.ВыводИзЭксплуатацииАвтомобилей") и ЗначениеЗаполнено(Стр.ДокументЭксплуатации) Тогда
			Сообщить("Автомобиль " + Стр.Автомобиль + " уже был в эксплуатации");
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Стр.ДокументЭксплуатации) Тогда
			Сообщить("Автомобиль " + Стр.Автомобиль + " не введен в эксплуатацию");
			Продолжить;
		КонецЕсли;
		
		Если Стр.ДокументЭксплуатации <> Основание Тогда
			
			Если ДокВвод <> Неопределено Тогда
				ПараметрыОткрытия = Новый Структура("Ключ", ДокВвод);
				Результат = ОткрытьФормуМодально("Документ.ВыводИзЭксплуатацииАвтомобилей.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтаФорма);
			КонецЕсли;
			
			ДокВвод = Документы.ВыводИзЭксплуатацииАвтомобилей.СоздатьДокумент();
			ДокВвод.ДокументОснование = Стр.ДокументЭксплуатации;
			ДокВвод.Заполнить(Стр.ДокументЭксплуатации);
			ДокВвод.УстановитьНовыйНомер();
			
			ДокВвод.ХозОперация = Справочники.ХозОперации.ВыводИзЭксплуатацииАвтомобилей;
			Основание = Стр.ДокументЭксплуатации;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДокВвод <> Неопределено Тогда
		ПараметрыОткрытия = Новый Структура("Ключ", ДокВвод);
		Результат = ОткрытьФормуМодально("Документ.ВыводИзЭксплуатацииАвтомобилей.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

