&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Клиент") = Истина тогда	
		Объект.Клиент = Параметры.Клиент;
		м_Клиент = Объект.Клиент;
	Если ЗначениеЗаполнено(м_Клиент) тогда
		Элементы.СтранициКлиент.ТекущаяСтраница = Элементы.ЗаполненКлиент;
	Иначе
		Элементы.СтранициКлиент.ТекущаяСтраница = Элементы.НеЗаполненКлиент;
	КонецЕсли;
	
	КонецЕсли;
	
	Если Параметры.Свойство("НомерРабочегоЛиста") = Истина тогда	
		Объект.НомерРабочегоЛиста = Параметры.НомерРабочегоЛиста;
		
	КонецЕсли;
	
	мТекущийМенеджер = ПараметрыСеанса.Пользователь.Сотрудник;
	мТекущийПользователь = ПараметрыСеанса.Пользователь;
	
	мСтруктураОтбораАвтосклад = Renault_РаботаСПравамиПользователя.ПолучитьСтруктуруНастроекАвтосклад(ПараметрыСеанса.Пользователь);
	
	ДилерскийЦентрПользователя = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	
	ЕстьПравоСразуРезервироватьАвтомобиль = ПараметрыСеанса.Renault_ПраваПользователя.РезервироватьАвтомобильБезСогласования;
	ЕстьПравоАдминистрированияАвтосклад = Renault_РаботаСПравамиПользователя.ЕстьПравоАдминистрированияАрмАвтосклад(ПараметрыСеанса.Пользователь);
	
	BIR_Distri = СокрЛП(ДилерскийЦентрПользователя.BIR_Distri);
	
	МассивСкладовДилера = ДилерскийЦентрПользователя.СкладыДилера.ВыгрузитьКолонку("Склад");
	мДатаНеПоказыватьВыданныеАвтомобили = ДилерскийЦентрПользователя.ДатаНеПоказыватьВыданныеАвтомобили;
	ПоказыватьДоговоры = Истина;
	
	мСтруктураОтбораАвтосклад.Вставить("ТипЦен",ДилерскийЦентрПользователя.ТипЦенПродажи);	
	МаксимальноеКоличествоДнейРезерва = Renault_РаботаСПравамиПользователя.МаксимальноеКоличествоДнейРезерва(ПараметрыСеанса.Пользователь);

	VINАвтомобиля ="";
	РежимПодтверждения = Ложь;
	ДатаНеПоказыватьВыданныеАвтомобили = Неопределено;
	
	ВерсияАвтомобиля = "";
	МодельАвтомобиля = "";
	
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",		 				ТекущаяДата());
	Список.Параметры.УстановитьЗначениеПараметра("VIN", 				 				VINАвтомобиля);
	Список.Параметры.УстановитьЗначениеПараметра("МассивСкладовДилера", 				МассивСкладовДилера);
	Список.Параметры.УстановитьЗначениеПараметра("ТекущийСотрудник", 					ПараметрыСеанса.Пользователь.Сотрудник);
	Список.Параметры.УстановитьЗначениеПараметра("РежимПодтверждения", 				РежимПодтверждения);
	Список.Параметры.УстановитьЗначениеПараметра("ДатаНеПоказыватьВыданныеАвтомобили", ?(ДатаНеПоказыватьВыданныеАвтомобили = Неопределено,Дата('00010101'),ДатаНеПоказыватьВыданныеАвтомобили));
	Список.Параметры.УстановитьЗначениеПараметра("УчитыватьРеализацииКакВыдачи", 		Не Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.Автосклад_НеУчитыватьРеализацииКакВыдачи);
	
	Подержанные.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",		 				ТекущаяДата());
	Подержанные.Параметры.УстановитьЗначениеПараметра("VIN", 				 				VINАвтомобиля);
	Подержанные.Параметры.УстановитьЗначениеПараметра("МассивСкладовДилера", 				МассивСкладовДилера);
	Подержанные.Параметры.УстановитьЗначениеПараметра("ТекущийСотрудник", 					ПараметрыСеанса.Пользователь.Сотрудник);
	Подержанные.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗарезервированные", 	  ПоказыватьЗарезервированные);
	Подержанные.Параметры.УстановитьЗначениеПараметра("ДоговорНаАвансСсылка", Документы.Renault_Договор.ПустаяСсылка());
	
	ДемоПодмен.Параметры.УстановитьЗначениеПараметра("VIN", 				 				VINАвтомобиля);
	//ДемоПодмен.Параметры.УстановитьЗначениеПараметра("СрокЭксплуатацииИстек", 				СрокЭксплуатацииИстек);
	ДемоПодмен.Параметры.УстановитьЗначениеПараметра("ПустаяДата", 				'00010101');
	//ДемоПодмен.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",		 				ТекущаяДата());
	
	Заявки.Параметры.УстановитьЗначениеПараметра("VIN", 				 				VINАвтомобиля);
	
	ТипПрисоединенияИзНоменклатурыИРабот = Ложь;
	Если ЗначениеЗаполнено(ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр) Тогда
		Если ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.ТипПривязкиДоповКАвтомобилям = Перечисления.Renault_ТипыУчетаДополнительногоОборудования.ИзНоменклатурыИРабот Тогда
			ТипПрисоединенияИзНоменклатурыИРабот = Истина;
		КонецЕсли;
	КонецЕсли;
	Список.Параметры.УстановитьЗначениеПараметра("ТипПрисоединенияИзНоменклатурыИРабот",ТипПрисоединенияИзНоменклатурыИРабот);	
	
	СтруктураОтбора = ?(СтруктураОтбора = Неопределено, ПолучитьСтруктуруНастроекАвтосклад(), СтруктураОтбора);
	Для Каждого Эл Из СтруктураОтбора Цикл
		Список.Параметры.УстановитьЗначениеПараметра(Эл.Ключ, Эл.Значение);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МодельАвтомобиля) Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Модель", МодельАвтомобиля);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("Модель", Справочники.Модели.ПустаяСсылка());
	КонецЕсли;
	
	// начало добавление Зеленчук
	ВерсияАвтомобиляМассив = ТипЗнч(ВерсияАвтомобиля) = Тип("Массив");
	// окончание добавление Зеленчук
	
	Если ТипЗнч(ВерсияАвтомобиля) = Тип("Массив") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Версия", ВерсияАвтомобиля);
	Иначе
		Если
			ЗначениеЗаполнено(ВерсияАвтомобиля) Тогда
			Список.Параметры.УстановитьЗначениеПараметра("Версия", ВерсияАвтомобиля);
		Иначе
			Список.Параметры.УстановитьЗначениеПараметра("Версия", Справочники.ВариантыКомплектации.ПустаяСсылка());
		КонецЕсли;
	КонецЕсли;
	
	Список.Параметры.УстановитьЗначениеПараметра("Цвет", Справочники.Цвета.ПустаяСсылка());
	Список.Параметры.УстановитьЗначениеПараметра("ДоговорНаАвансСсылка", Документы.Renault_Договор.ПустаяСсылка());
	
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗарезервированные", 	  ПоказыватьЗарезервированные);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗакрепленныеЗаКлиентом", ПоказыватьЗакрепленныеЗаКлиентом);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьВыданныеАвтомобили", 	  ПоказыватьВыданныеАвтомобили);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьНеДляПродажи", 		  ПоказыватьНеДляПродажи);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьДоговоры", 			  ПоказыватьДоговоры);
	Если Не ПравоЦен(мТекущийПользователь) тогда
		
		//Видимость себестоимости
		Элементы.СписокЦенаЗакупкиБаза.Видимость = Ложь;
		Элементы.СписокЦенаЗакупкиОпции.Видимость = Ложь;
		Элементы.СписокЦенаЗакупкиСкидка.Видимость = Ложь;
		Элементы.СписокРасшифровкаСкидкиДилера.Видимость = Ложь;
		Элементы.СписокЦенаЗакупкиАвтомобиля.Видимость = Ложь;
		Элементы.СписокСебестоимостьПоТН.Видимость = Ложь;
		
	КонецЕсли;
	
	//ОпцийДилера
	
	НастройкиБазы = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	Если НастройкиБазы.ИспользоватьТиповойУчетДО = ложь Тогда
		
		ТаблицаОпцийДилера.ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.Автомобиль,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.Оборудование КАК Опция,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.СтоимостьОстаток КАК Сумма,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.СебестоимостьОстаток,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.Renault_УстановленноеОборудованиеАвтомобилей.Остатки(, Автомобиль = &Автомобиль) КАК Renault_УстановленноеОборудованиеАвтомобилейОстатки";
		ТаблицаОпцийДилера.ОсновнаяТаблица = "РегистрНакопления.Renault_УстановленноеОборудованиеАвтомобилей.Остатки";
		
		
		ЗаявкиЗаказНарядыПоКомплектации.ТекстЗапроса = 
			"ВЫБРАТЬ Разрешенные
			|	Renault_CRM_ЗаявкаНаСервис.Ссылка,
			|	Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения КАК ВидРемонта
			|ИЗ
			|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
			|		ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка
			|	ГДЕ
			|	Renault_CRM_ЗаявкаНаСервис.Автомобиль = &Автомобиль 
			|	И Renault_CRM_ЗаявкаНаСервис.Обращение.ВидОбращения.Докомплектация";
		ЗаявкиЗаказНарядыПоКомплектации.ОсновнаяТаблица = "Документ.Renault_CRM_ЗаявкаНаСервис"; 
		
		ЗаявкиЗаказНарядыПоКомплектации1.ТекстЗапроса = 
			"ВЫБРАТЬ Разрешенные
			|	Renault_CRM_ЗаявкаНаСервис.Ссылка,
			|	Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения КАК ВидРемонта
			|ИЗ
			|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
			|		ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка
			|	ГДЕ
			|	Renault_CRM_ЗаявкаНаСервис.Автомобиль = &Автомобиль"; 
			
		ЗаявкиЗаказНарядыПоКомплектации1.ОсновнаяТаблица = "Документ.Renault_CRM_ЗаявкаНаСервис"; 
		
	КонецЕсли;
	
	СформироватьПеремещение();
	ЗаполнитьТекущиеМаршруты();
	
	УстановитьВидимость();
	
КонецПроцедуры

Процедура УстановитьВидимость()
	
	Если ЕстьПравоАдминистрированияАвтосклад Тогда
		Элементы.ТаблицаРезервовАвтомобилей.КоманднаяПанель.Доступность = Истина;
		Элементы.ФормаНеДляПродажи.Доступность = Истина; //Сергеев В.Н. DMSREN-1116
	Иначе //нет права администрирования		
		Элементы.ТаблицаРезервовАвтомобилей.КоманднаяПанель.Доступность = Ложь;
		Элементы.дс_КомментарийРуководителя.ТолькоПросмотр = Истина;
		Элементы.ФормаНеДляПродажи.Доступность = Ложь; //Сергеев В.Н. DMSREN-1116
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруНастроекАвтосклад(Пользователь=Неопределено) Экспорт
	
	Ответ = Новый Структура;
	Ответ.Вставить("ИспользоватьОтборПоДилерскимЦентрам", Ложь);
	Ответ.Вставить("ИспользоватьОтборПоСчетам", Ложь);
	Ответ.Вставить("ИспользоватьОтборПоСкладам", Ложь);
	Ответ.Вставить("ДоступныеДилерскиеЦентры", Неопределено);
	Ответ.Вставить("ДоступныеСчета", Неопределено);
	Ответ.Вставить("ДоступныеСклады", Неопределено);
	Ответ.Вставить("ТипЦен", Справочники.ТипыЦен.ПустаяСсылка());
	Если Пользователь=Неопределено Тогда Возврат Ответ КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки КАК ПраваИНастройки
	|ИЗ
	|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	|ГДЕ
	|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ответ.Вставить("ИспользоватьОтборПоДилерскимЦентрам", Выборка.ПраваИНастройки.Автосклад_ИспользоватьОтборПоДилерскимЦентрам);
		Ответ.Вставить("ИспользоватьОтборПоСчетам", Выборка.ПраваИНастройки.Автосклад_ИспользоватьОтборПоСчетам);
		Ответ.Вставить("ИспользоватьОтборПоСкладам", Выборка.ПраваИНастройки.Автосклад_ИспользоватьОтборПоСкладам);
		Ответ.Вставить("ДоступныеДилерскиеЦентры", Выборка.ПраваИНастройки.Автосклад_ДоступныеДилерскиеЦентры.ВыгрузитьКолонку("ДилерскийЦентр"));
		Ответ.Вставить("ДоступныеСчета", Выборка.ПраваИНастройки.Автосклад_ДоступныеСчета.ВыгрузитьКолонку("Счет"));
		Ответ.Вставить("ДоступныеСклады", Выборка.ПраваИНастройки.Автосклад_ДоступныеСклады.ВыгрузитьКолонку("Склад"));
		Ответ.Вставить("ТипЦен", Выборка.ПраваИНастройки.ДилерскийЦентр.ТипЦенПродажи);
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура КолонкиСебестоимости(Команда)
	
	Если Элементы.СписокЦенаЗакупкиБаза.Видимость = Истина тогда
		
		Элементы.СписокЦенаЗакупкиБаза.Видимость = Ложь;
		Элементы.СписокЦенаЗакупкиОпции.Видимость = Ложь;
		Элементы.СписокЦенаЗакупкиСкидка.Видимость = Ложь;
		Элементы.СписокРасшифровкаСкидкиДилера.Видимость = Ложь;
		Элементы.СписокЦенаЗакупкиАвтомобиля.Видимость = Ложь;
		Элементы.СписокСебестоимостьПоТН.Видимость = Ложь;
				
	Иначе
		
		Элементы.СписокЦенаЗакупкиБаза.Видимость = Истина;
		Элементы.СписокЦенаЗакупкиОпции.Видимость = Истина;
		Элементы.СписокЦенаЗакупкиСкидка.Видимость = Истина;
		Элементы.СписокРасшифровкаСкидкиДилера.Видимость = Истина;
		Элементы.СписокЦенаЗакупкиАвтомобиля.Видимость = Истина;
		Элементы.СписокСебестоимостьПоТН.Видимость = Истина;
				
	КонецЕсли;
	
