	|		ПО Автомобили.VIN = ВСЕОТС.VIN
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВСЕОТС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АвтомобилиСОТС.Ссылка,
	|	АвтомобилиСОТС.VIN,
	|	АвтомобилиСОТС.СервиснаяКампания,
	|	АвтомобилиСрезПоследних.Значение КАК Клиент
	|ИЗ
	|	АвтомобилиСОТС КАК АвтомобилиСОТС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	|		ПО АвтомобилиСОТС.Ссылка = АвтомобилиСрезПоследних.Автомобиль.Ссылка
	|			И (АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин))";
	Запрос.УстановитьПараметр("ТолькоНовые", Истина);
	Запрос.УстановитьПараметр("Клиентские", Истина);
	Запрос.УстановитьПараметр("VIN", Вин);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СписокОтзывныхНот = "";
	Пока Выборка.Следующий() Цикл
		
		СписокОтзывныхНот = СписокОтзывныхНот + 
		СокрЛП(Строка(Выборка.СервиснаяКампания.Код)) + " - " + Строка(Выборка.СервиснаяКампания) + Символы.ПС;
		
	КонецЦикла;
	
	Структура.Вставить("СписокОтзывныхНот",СписокОтзывныхНот);
	
	Возврат Структура;
	
