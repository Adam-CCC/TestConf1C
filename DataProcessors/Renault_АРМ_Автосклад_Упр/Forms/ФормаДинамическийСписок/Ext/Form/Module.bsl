&НаСервере
Функция ПравоЦен(Пользователь)
	
	Зап = Новый Запрос;
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
		Зап.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.РазрешитьПросмотрЦенВАвтоскладе, ЛОЖЬ) КАК РазрешитьПросмотрЦенВАвтоскладе
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
	Иначе
		Зап.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.РазрешитьПросмотрЦенВАвтоскладе, ЛОЖЬ) КАК РазрешитьПросмотрЦенВАвтоскладе
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник = &Пользователь";
	КонецЕсли;
	
	Зап.УстановитьПараметр("Пользователь", Пользователь);
	Шаблоны = Зап.Выполнить().Выбрать();
	ЕстьПраво = Ложь;
	Пока Шаблоны.Следующий() Цикл
		Если Шаблоны.РазрешитьПросмотрЦенВАвтоскладе Тогда
			ЕстьПраво = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьПраво;
	
КонецФункции

&НаКлиенте
Процедура ДемоПодменПриАктивизацииСтроки(Элемент)
	
	Запись = Элементы.ДемоПодмен.ТекущиеДанные;
	Если Запись <> неопределено тогда
		
		Элементы.СтранициОтображения1.ТекущаяСтраница = Элементы.Информация3;
		
		дс_Автомобиль = Элементы.Список.ТекущаяСтрока;
		дс_ТипАвтомобиля = Запись.ТипАвтомобиля;
		
		//Оплаты и пр.
		дс_ДополнительныеЗатратыПоАвто = Запись.ДополнительныеЗатратыПоАвто;
		
		дс_Вин = Запись.VIN;
		
		дс_Модель = Запись.Модель.НаименованиеПолное;
		дс_Версия = Запись.Версия.НаименованиеПолное;
		дс_Цвет = Запись.Цвет.Наименование;
		Дс_СоставОпций = "";
		
		дс_КодМодели = Запись.Модель.Артикул;
		дс_КодВерсии = Запись.Версия.Артикул;
		дс_КодЦвета = Запись.Цвет.Артикул;
		
		Если Запись.ГодВыпуска = 0 Тогда
			дс_ГодВыпуска = "";
		Иначе
			дс_ГодВыпуска = СтрЗаменить(Строка(Запись.ГодВыпуска), Символ(160), "");
			дс_ГодВыпуска = дс_ГодВыпуска + " г.в.";
		КонецЕсли;
		дс_НаименованиеАвтомобиля = дс_Модель + " " + дс_Версия + " " + дс_Цвет + " " + дс_ГодВыпуска;
		
		дс_Комментарий = Запись.Примечание;
		дс_КомментарийРуководителя = Запись.ПримечаниеРОП;
		
		дс_ОплатаАФМСогласована = Запись.ОплатаАФМСогласована;
		дс_ДатаОплатыАФМ = Запись.ПлановаяДатаОплатыАФМ;
		дс_ОплатаАФМОплачено = Запись.АвтоОплаченАФМ;
		дс_ПричинаВыкупа = Запись.ПричинаВыкупа;
		
		дс_ОплатаКлиентАвансВнесен = Запись.КлиентВнесАванс;
		дс_ОплатаКлиентПолностьюОплачено = Запись.КлиентПолностьюОплатилАвто;
		дс_ПлановаяДатаПолнойОплатыКлиентом = Запись.ПлановаяДатаПолнойОплатыКлиентом;
		
		//Даты
		дс_ДатаДСАПланФакт = Запись.ДатаДСАПланФакт;
		дс_ДатаОтгрузки = ?(ЗначениеЗаполнено(Запись.ДатаОтгрузкиПланФакт), Запись.ДатаОтгрузкиПланФакт, Запись.ДатаОтгрузкиОбещ);
		дс_ДатаОтгрузкиПлановая = Запись.ДатаОтгрузкиПлановая;
		дс_ДатаОтгрузкиФактическая = Запись.ДатаОтгрузкиФактическая;
		дс_ДатаОтгрузкиЖелаемая = Запись.ДатаОтгрузкиЖелаемая;
		
		
		///Статусы
		ЗакрепленоЗаКлиентомПоДаннымАФМ = (Запись.ЗакрепленоЗаКлиентомВDistri = Истина);
		ЗакрепленоЗаКлиентом = Запись.УтвержденРезерв ИЛИ Запись.ПодписанДоговорКП;
		ЗакрепленоЗаМенеджером = Запись.УтвержденРезерв;
		ЗаявкаНаРезервМенеджера = Запись.ЗаявленРезерв;
		
		Если ЗакрепленоЗаКлиентом Тогда
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа58;
		ИначеЕсли ЗаявкаНаРезервМенеджера Тогда
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа59;
		ИначеЕсли ЗакрепленоЗаМенеджером Тогда
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа60;
		Иначе
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа61;
		КонецЕсли;
		
		Если Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВПроизводстве тогда
			  Элементы.Группа64.ТекущаяСтраница = Элементы.Группа66;
		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВПути тогда
			   Элементы.Группа64.ТекущаяСтраница = Элементы.Группа67;
		
		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВПутиКДилеру тогда
			     Элементы.Группа64.ТекущаяСтраница = Элементы.Группа69;
		
		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВыданКлиенту тогда
			  Элементы.Группа64.ТекущаяСтраница = Элементы.Группа71;
		
