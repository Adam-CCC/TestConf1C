&НаКлиенте
Процедура ЗаявкиПриАктивизацииСтроки(Элемент)
	
	Запись = Элементы.Заявки.ТекущиеДанные;
	Если Запись <> неопределено тогда
		
		дс_Автомобиль = Элементы.Заявки.ТекущиеДанные.Автомобиль;
		дс_ТипАвтомобиля = Запись.ТипАвтомобиля;
		
		//Оплаты и пр.		
		дс_ДополнительныеЗатратыПоАвто = Запись.ДополнительныеЗатратыПоАвто;
		
		дс_Вин = Запись.VIN;
		
		дс_Модель = Запись.Модель.НаименованиеПолное;
		дс_Версия = Запись.Версия.НаименованиеПолное;
		дс_Цвет = Запись.Цвет1.Наименование;
		Дс_СоставОпций = "";
		
		дс_КодМодели = Запись.Модель.Артикул;
		дс_КодВерсии = Запись.Версия.Артикул;
		дс_КодЦвета = Запись.Цвет1.Артикул;
		
		Если Запись.ГодВыпуска = 0 Тогда
			дс_ГодВыпуска = "";
		Иначе
			дс_ГодВыпуска = СтрЗаменить(Строка(Запись.ГодВыпуска), Символ(160), "");
			дс_ГодВыпуска = дс_ГодВыпуска + " г.в.";
		КонецЕсли;
		дс_НаименованиеАвтомобиля = дс_Модель + " " + дс_Версия + " " + дс_Цвет + " " + дс_ГодВыпуска;
		
		дс_Комментарий = Запись.Примечание;
		дс_КомментарийРуководителя = Запись.ПримечаниеРОП;
		
		дс_ОплатаАФМСогласована = Запись.ОплатаАФМСогласована;
		дс_ДатаОплатыАФМ = Запись.ПлановаяДатаОплатыАФМ;
		дс_ОплатаАФМОплачено = Запись.АвтоОплаченАФМ;
		дс_ПричинаВыкупа = Запись.ПричинаВыкупа;
		
		дс_ОплатаКлиентАвансВнесен = Запись.КлиентВнесАванс;
		дс_ОплатаКлиентПолностьюОплачено = Запись.КлиентПолностьюОплатилАвто;
		дс_ПлановаяДатаПолнойОплатыКлиентом = Запись.ПлановаяДатаПолнойОплатыКлиентом;
		
		//Даты
		дс_ДатаДСАПланФакт = Запись.ДатаДСАПланФакт;
		дс_ДатаОтгрузки = ?(ЗначениеЗаполнено(Запись.ДатаОтгрузкиПланФакт), Запись.ДатаОтгрузкиПланФакт, Запись.ДатаОтгрузкиОбещ);
		дс_ДатаОтгрузкиПлановая = Запись.ДатаОтгрузкиПлановая;
		дс_ДатаОтгрузкиФактическая = Запись.ДатаОтгрузкиФактическая;
		дс_ДатаОтгрузкиЖелаемая = Запись.ДатаОтгрузкиЖелаемая;
		
		///Статусы
		ЗакрепленоЗаКлиентомПоДаннымАФМ = (Запись.ЗакрепленоЗаКлиентомВDistri = Истина);
		ЗакрепленоЗаКлиентом = Запись.УтвержденРезерв ИЛИ Запись.ПодписанДоговорКП;
		ЗакрепленоЗаМенеджером = Запись.УтвержденРезерв;
		ЗаявкаНаРезервМенеджера = Запись.ЗаявленРезерв;
		
		Если ЗакрепленоЗаКлиентом Тогда
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа58;
		ИначеЕсли ЗаявкаНаРезервМенеджера Тогда
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа59;
		ИначеЕсли ЗакрепленоЗаМенеджером Тогда
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа60;
		Иначе
			Элементы.Группа57.ТекущаяСтраница = Элементы.Группа61;
		КонецЕсли;
		
		Если Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВПроизводстве тогда
			  Элементы.Группа64.ТекущаяСтраница = Элементы.Группа66;
		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВПути тогда
			   Элементы.Группа64.ТекущаяСтраница = Элементы.Группа67;

		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВПутиКДилеру тогда
			     Элементы.Группа64.ТекущаяСтраница = Элементы.Группа69;

		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ВыданКлиенту тогда
			  Элементы.Группа64.ТекущаяСтраница = Элементы.Группа71;

		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ДоставленДилеру тогда
			  Элементы.Группа64.ТекущаяСтраница = Элементы.Группа70;

		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.ЗаказВПроизводство тогда
			    Элементы.Группа64.ТекущаяСтраница = Элементы.Группа65;

		ИначеЕсли Запись.СтатусАвтомобиля = перечисления.CRM_СтатусыАвтомобилей.НаСкладеАФМ тогда
			   Элементы.Группа64.ТекущаяСтраница = Элементы.Группа68;
		КонецЕсли;
		
		// страница "Distri.net"	
		дс_НомерКлиентскойЗаявки = Запись.НомерЗаявкиDistri;
		дс_НомерОрдераSedre = Запись.НомерЗаказаDistri;
		дс_ПродажаВнесенаВSedre = Запись.ПродажаВнесенаВDistri;
		//DMSREN-1104++++++++++++++++++++++++++++++++++++++++++++
		Попытка 
			с_НомерКлиентскойЗаявки = Запись.numCl;
			дс_НомерОрдераSedre = Запись.НомерОрдера;
			дс_ПродажаВнесенаВSedre = ЗначениеЗаполнено(Запись.ДатаПродажи);
		Исключение
		КонецПопытки;
		//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
		
		дс_ПричинаИзмененияКЗ = Запись.ПричинаИзмененияКЗ;
		дс_КомментарийИзмененияКЗ = Запись.КомментарийИзмененияКЗ;
		
		//Прочее
		дс_Блокировка = Запись.Блокировка;
		дс_Статус = Запись.СтатусАвтомобиля;
		
		//Обновим отображение на форме
		Если дс_Блокировка = Истина Тогда	
			Элементы.Группа55.ТекущаяСтраница = Элементы.Заблокирован;
		Иначе
			Элементы.Группа55.ТекущаяСтраница = Элементы.НЕЗаблокирован;
		КонецЕсли;
		
        //Автомобиль
		дс_КодРадио = Запись.КодРадио;
		
		Таблици = СписокПриАктивизацииСтрокиНаСервере_БезКонтекста(дс_Вин,дс_Автомобиль,дс_СоставОпций,Запись.Версия,Запись.ГодВыпуска,ДилерскийЦентрПользователя);
	
		ТаблицаОпций.Параметры.УстановитьЗначениеПараметра("Тариф", Таблици.Тариф);
		ТаблицаОпций.Параметры.УстановитьЗначениеПараметра("ВариантКомплектации",Запись.Версия);
		ТаблицаОпций.Параметры.УстановитьЗначениеПараметра("Модель", Запись.модель);		
		ТаблицаОпций.Параметры.УстановитьЗначениеПараметра("Vin", дс_Вин);	
		
		
		ТаблицаОпцийДилера.Параметры.УстановитьЗначениеПараметра("Автомобиль",дс_Автомобиль);
		
		ЗаявкиЗаказНарядыПоКомплектации.Параметры.УстановитьЗначениеПараметра("Автомобиль",дс_Автомобиль);
		
		ТаблицаРезервовАвтомобилей.Параметры.УстановитьЗначениеПараметра("VIN",дс_Вин);
		
		ТаблицаАкцийПроизводителя.Параметры.УстановитьЗначениеПараметра("БезОтбора",Ложь);
		ТаблицаАкцийПроизводителя.Параметры.УстановитьЗначениеПараметра("ДилерскийЦентр",ДилерскийЦентрПользователя); 
		ТаблицаАкцийПроизводителя.Параметры.УстановитьЗначениеПараметра("ВариантКомплектации",Запись.Версия);
		ТаблицаАкцийПроизводителя.Параметры.УстановитьЗначениеПараметра("Модель",Запись.модель);
		ТаблицаАкцийПроизводителя.Параметры.УстановитьЗначениеПараметра("VIN",дс_Вин);
		ТаблицаАкцийПроизводителя.Параметры.УстановитьЗначениеПараметра("Год",Запись.ГодВыпуска);
		ТаблицаАкцийПроизводителя.Параметры.УстановитьЗначениеПараметра("ТекДата",ТекущаяДата());
		
		дс_ПТС_Номер = Таблици.дс_ПТС_Номер;
		дс_ПТС_Дата = Таблици.дс_ПТС_Дата;
		дс_ПТС_Модель = Таблици.дс_ПТС_Модель;
		дс_ПТС_ТипТС = Таблици.дс_ПТС_ТипТС;
		дс_ПТС_КатегорияТС = Таблици.дс_ПТС_КатегорияТС;
