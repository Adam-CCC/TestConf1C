	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьВыданныеАвтомобили", 	  ПоказыватьВыданныеАвтомобили);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьНеДляПродажи", 		  ПоказыватьНеДляПродажи);
	
	НовыйПорядок = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	НовыйПорядок.Поле = Новый ПолеКомпоновкиДанных("Порядок");
	НовыйПорядок.Использование = Истина;
	НовыйПорядок.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	НовыйПорядок.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто;
	
	// +++ ВалиховГА 22.10.2021 DMSREN-1299
	УстановитьОформлениеФильтраСписка("Невыданные");
	// --- ВалиховГА 22.10.2021 DMSREN-1299
	
КонецПроцедуры

&НаКлиенте
Процедура Все(Команда)
	
	ПоказыватьЗарезервированные = Истина;
	ПоказыватьЗакрепленныеЗаКлиентом = Истина;
	ПоказыватьНеДляПродажи = Истина;
	ПоказыватьВыданныеАвтомобили = Истина;
	
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗарезервированные", 	  ПоказыватьЗарезервированные);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗакрепленныеЗаКлиентом", ПоказыватьЗакрепленныеЗаКлиентом);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьВыданныеАвтомобили", 	  ПоказыватьВыданныеАвтомобили);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьНеДляПродажи", 		  ПоказыватьНеДляПродажи);
	
	НовыйПорядок = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	НовыйПорядок.Поле = Новый ПолеКомпоновкиДанных("Порядок");
	НовыйПорядок.Использование = Истина;
	НовыйПорядок.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	НовыйПорядок.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто;
	
	// +++ ВалиховГА 22.10.2021 DMSREN-1299
	УстановитьОформлениеФильтраСписка("Все");
	// --- ВалиховГА 22.10.2021 DMSREN-1299
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФильтровПоСтатусамПриАктивизацииСтроки(Элемент)
	
	ТекущаяТаблица = ИмяТекущейТаблицы();
	Этаформа[ТекущаяТаблица].Отбор.Элементы.Очистить();
	Если ЗначениеЗаполнено(Элементы.ДеревоФильтровПоСтатусам.ТекущиеДанные.ТипОтбора) тогда
		
		ОтборСписка = Элементы.ДеревоФильтровПоСтатусам.ТекущиеДанные.ТипОтбора;
		ЭлементОтбора = Этаформа[ТекущаяТаблица].Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ПравоеЗначение = Элементы.ДеревоФильтровПоСтатусам.ТекущиеДанные.ЗначениеФильтра;
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ОтборСписка);
		Если ТипЗнч(Элементы.ДеревоФильтровПоСтатусам.ТекущиеДанные.ЗначениеФильтра) = Тип("СписокЗначений") Тогда 
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		
		ЭлементОтбора.Использование = Истина;
		
		Если Элементы.ДеревоФильтровПоСтатусам.ТекущиеДанные.ЗначениеФильтра = ПредопределенноеЗначение("Перечисление.CRM_СтатусыАвтомобилей.ВПроизводстве") Тогда
			
			мСтруктураОтбораАвтосклад = Renault_РаботаСПравамиПользователя.ПолучитьСтруктуруНастроекАвтосклад(ПараметрыСеанса.Пользователь);
			
			Если мСтруктураОтбораАвтосклад.ИспользоватьОтборПоАдресамОтгрузкиАвтоВПроизводстве Тогда
				
				СписокДЦ = Новый Массив;
				
				Для Каждого Строка Из мСтруктураОтбораАвтосклад.ДоступныеАдресаОтгрузки Цикл
					СписокДЦ.Добавить(Строка);
				КонецЦикла;
							
				ЭлементОтбора = Этаформа[ТекущаяТаблица].Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ПравоеЗначение = СписокДЦ;
				ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПодтвержденныйАдресОтгрузки");
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				ЭлементОтбора.Использование = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоФильтровПоПриоритетамПриАктивизацииСтроки(Элемент)
	
	ТекущаяТаблица = ИмяТекущейТаблицы();
	Этаформа[ТекущаяТаблица].Отбор.Элементы.Очистить();
	
	Если ЗначениеЗаполнено(Элементы.ДеревоФильтровПоПриоритетам.ТекущиеДанные.ТипОтбора) тогда
		
		ОтборСписка = Элементы.ДеревоФильтровПоПриоритетам.ТекущиеДанные.ТипОтбора;
		ЭлементОтбора = Этаформа[ТекущаяТаблица].Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ПравоеЗначение = Элементы.ДеревоФильтровПоПриоритетам.ТекущиеДанные.ЗначениеФильтра;
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ОтборСписка);
		
		Если ТипЗнч(Элементы.ДеревоФильтровПоПриоритетам.ТекущиеДанные.ЗначениеФильтра) = Тип("СписокЗначений") Тогда 
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		Иначе
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
		
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОтбораПодержанных();
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	МассивТипов.Добавить(Тип("СправочникСсылка.Renault_Used_Автопроизводители"));
	ДеревоФильтровБУ =  РеквизитФормыВЗначение("ДеревоФильтровСПробегом");
	
	Схема = Элементы.Подержанные.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.Подержанные.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТЗ = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Производители = ТЗ.Скопировать(,"ПроизводительКод");
	Производители.Свернуть("ПроизводительКод");
	Производители.Сортировать("ПроизводительКод");
	ГодыВыпуска = ТЗ.Скопировать(,"ГодВыпуска");
	ГодыВыпуска.Свернуть("ГодВыпуска");
	ГодыВыпуска.Сортировать("ГодВыпуска");
	
	НСтрокаМодели = ДеревоФильтровБУ.Строки.Найти("Все производители");
	
	Если НСтрокаМодели = Неопределено тогда
		НСтрокаМодели = ДеревоФильтровБУ.Строки.Добавить();
		НСтрокаМодели.Представление = "Все производители";
		НСтрокаМодели.Пометка = 1;
		НСтрокаМодели.ЗначениеФильтра = Неопределено;
		НСтрокаМодели.ТипОтбора = "ПроизводительКод";
		СписокОтбораПроизводительКод = Новый СписокЗначений;
	КонецЕсли;
	
	Для каждого стрПроизводители из Производители цикл
		Если НСтрокаМодели.Строки.Найти(стрПроизводители.ПроизводительКод) = Неопределено тогда
			НСтрока = НСтрокаМодели.Строки.Добавить();
			НСтрока.Представление = стрПроизводители.ПроизводительКод;
			НСтрока.Пометка = 1;
			НСтрока.ЗначениеФильтра = стрПроизводители.ПроизводительКод;
			НСтрока.ТипОтбора = "ПроизводительКод"; 
			СписокОтбораПроизводительКод.Добавить(стрПроизводители.ПроизводительКод);
		КонецЕсли;
	КонецЦикла;
	
	НСтрокаГоды = ДеревоФильтровБУ.Строки.Найти("Все годы выпуска");
	
	Если НСтрокаГоды = Неопределено тогда
		НСтрокаГоды = ДеревоФильтровБУ.Строки.Добавить();
		НСтрокаГоды.Представление = "Все годы выпуска";
		НСтрокаГоды.Пометка = 1;
		НСтрокаГоды.ЗначениеФильтра = Неопределено;
		НСтрокаГоды.ТипОтбора = "ГодВыпуска";
	КонецЕсли;
	
	СписокОтбораГодВыпуска = Новый СписокЗначений;
	
	Для каждого стрГоды из ГодыВыпуска цикл
		Если НСтрокаГоды.Строки.Найти(стрГоды.ГодВыпуска) = Неопределено тогда
			НСтрока = НСтрокаГоды.Строки.Добавить();
			НСтрока.Представление = стрГоды.ГодВыпуска;
			НСтрока.Пометка = 1;
			НСтрока.ЗначениеФильтра = стрГоды.ГодВыпуска;
			НСтрока.ТипОтбора = "ГодВыпуска";
			СписокОтбораГодВыпуска.Добавить(стрГоды.ГодВыпуска);
		Конецесли;
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДеревоФильтровБУ, "ДеревоФильтровСПробегом");
	
КонецПроцедуры

