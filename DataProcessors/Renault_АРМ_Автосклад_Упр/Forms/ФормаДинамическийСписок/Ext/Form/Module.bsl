&НаКлиенте
Процедура Порядок(Команда)
	
	Для каждого стр из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(стр) = Тип("ПорядокКомпоновкиДанных") тогда
			Для каждого п из стр.Элементы цикл 
				п.поле  = Новый ПолеКомпоновкиДанных("Порядок");
				п.Использование = истина;
				п.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
				Прервать;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОпцийДляКомПредложения(БУ, ВИН, Автомобиль, СоставОпций, Версия, ЗаявкаНаТрейдИнСсылка = Неопределено)
	
	Структура = новый Структура;
	//Опции
	Если БУ="БУ" Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ЗаявкаНаТрейдИнСсылка);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Опции.Опция КАК Опция,
			|	Опции.Опция.Код КАК Код,
			|	Опции.Опция.Наименование КАК ИмяОпции
			|ИЗ
			|	Документ.Renault_ЗаявкаНаТрейдИн.Опции КАК Опции
			|ГДЕ
			|	Опции.Выбрана
			|	И Опции.Ссылка = &Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	Опция
			|АВТОУПОРЯДОЧИВАНИЕ";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Таб = РезультатЗапроса.Выгрузить();
		Структура.Вставить("Опции",Таб);
		
	Иначе
		
		ТаблицаОпцийАвтомобиля = Renault_CRM.ПолучитьТаблицуОпцийПоВин(ВИН);
		МассивОпцийАвтомобиля = ТаблицаОпцийАвтомобиля.ВыгрузитьКолонку("Опция");
		
		Если ЗначениеЗаполнено(СоставОпций) Тогда 
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_ТарифНаОпцииАвтомобилей.Опция.Артикул КАК Код,
			|	Renault_ТарифНаОпцииАвтомобилей.Опция КАК Опция,
			|	Renault_ТарифНаОпцииАвтомобилей.ЦенаКлиентская КАК Сумма,
			|	Renault_ТарифНаОпцииАвтомобилей.НаименованиеОпции КАК ИмяОпции
			|ИЗ
			|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних(
			|			,
			|			Тариф = &Тариф
			|				И Модель = &Модель
			|				И ВариантКомплектации = &ВариантКомплектации) КАК Renault_ТарифНаОпцииАвтомобилей
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ОпцииАвтомобилей КАК Renault_ОпцииАвтомобилей
			|		ПО Renault_ТарифНаОпцииАвтомобилей.Опция = Renault_ОпцииАвтомобилей.Опция
			|ГДЕ
			|	Renault_ОпцииАвтомобилей.VIN = &VIN";
			Запрос.УстановитьПараметр("МассивОпцийАвтомобиля", МассивОпцийАвтомобиля);
			Запрос.УстановитьПараметр("Тариф", Renault_CRM.ПолучитьПоследнийТарифНаАвтомобиль(Версия));
			Запрос.УстановитьПараметр("ВариантКомплектации", Версия);
			Запрос.УстановитьПараметр("Модель", Автомобиль.Модель);
			Запрос.УстановитьПараметр("Vin", Вин);
			Результат = Запрос.Выполнить().Выгрузить();
			Структура.Вставить("Опции", Результат);
			
		Иначе
			
			Структура.Вставить("Опции", Новый ТаблицаЗначений);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	НастройкиБазы = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	Если НастройкиБазы.ИспользоватьТиповойУчетДО Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		|	КомплектацияАвтомобилейОстаткиИОбороты.Автомобиль,
		|	КомплектацияАвтомобилейОстаткиИОбороты.Номенклатура КАК Опция,
		|	СУММА(КомплектацияАвтомобилейОстаткиИОбороты.СуммаПродажиПриход) КАК Сумма,
		|	СУММА(КомплектацияАвтомобилейОстаткиИОбороты.КоличествоПриход) КАК Количество
		|ИЗ
		|	РегистрНакопления.КомплектацияАвтомобилей.ОстаткиИОбороты(, , Регистратор, , Автомобиль = &Автомобиль) КАК КомплектацияАвтомобилейОстаткиИОбороты
		|ГДЕ
		|	КомплектацияАвтомобилейОстаткиИОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|
		|СГРУППИРОВАТЬ ПО
		|	КомплектацияАвтомобилейОстаткиИОбороты.Автомобиль,
		|	КомплектацияАвтомобилейОстаткиИОбороты.Номенклатура";
		
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.Автомобиль,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.Оборудование КАК Опция,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.СтоимостьОстаток КАК Сумма,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.СебестоимостьОстаток,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.Renault_УстановленноеОборудованиеАвтомобилей.Остатки(, Автомобиль = &Автомобиль) КАК Renault_УстановленноеОборудованиеАвтомобилейОстатки";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	Таб  = Запрос.Выполнить().Выгрузить();
	Если Таб.Количество() Тогда
		Структура.Вставить("ДилОпции",Истина);
		Структура.Вставить("ТабДилОпции",Таб);
	Иначе
		Структура.Вставить("ДилОпции",Ложь);
		Структура.Вставить("ТабДилОпции",Таб);
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СписокЦенаПродажи"  тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмРОП(ПараметрыСеанса.Пользователь)
			И НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоАдминистратораАвтосклада(ПараметрыСеанса.Пользователь) Тогда
			
			Сообщить("Для изменения цены необходимы права на АРМ Руководитель ОП или права ""Администратор автосклада""");
			Возврат;
		КонецЕсли;
		
		ЦенаПродажиРОП = Элементы.Список.ТекущиеДанные.ЦенаПродажи;
		
		Если ВвестиЧисло(ЦенаПродажиРОП, "Новая цена продажи", 10, 2) Тогда
			
			Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
			Запись.Автомобиль = Элементы.Список.ТекущиеДанные.Автомобиль;
			Запись.Прочитать();
			Если Не Запись.Выбран() Тогда
				Запись.Период = ТекущаяДата();
				Запись.Автомобиль = Элементы.Список.ТекущиеДанные.Автомобиль;
			КонецЕсли;
			
			Запись.ЦенаФиксирована = Ложь;
			Запись.ЦенаПродажиРОП = ЦенаПродажиРОП;
			Запись.Записать();
			
			Элементы.Список.ТекущиеДанные.ЦенаПродажи = ЦенаПродажиРОП;
			Элементы.Список.Обновить();
		КонецЕсли;
		
	КонецЕсли;
	
	Если (Поле.Имя = "СписокАдресОтгрузки" или Поле.Имя = "СписокДатаОтгрузки") и Элементы.Список.ТекущиеДанные.КартинкаСостоянияАвто = 3 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_PLAN
			|ИЗ
			|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
			|ГДЕ
			|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN = &VIN";
		Запрос.УстановитьПараметр("VIN", Элементы.Список.ТекущиеДанные.VIN);
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Если ЗначениеЗаполнено(Выборка.DATE_PLAN) Тогда
			Предупреждение("Нельзя указать желаемую дату поставки и точку, т.к. а/м уже запланирован к отгрузке");
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Элементы.Список.ТекущиеДанные.ДатаОтгрузки) Тогда
			Предупреждение("Нельзя изменить ранее введенные данные.
				|Обратитесь, пожалуйста, в службу дистрибуции Renault.");
			Возврат;
		КонецЕсли;
		
		ЗаявкаНаОтгрузкуПрошлая = НайтиЗаявкуНаОтгрузку(Элементы.Список.ТекущиеДанные.VIN);
		Если ЗначениеЗаполнено(ЗаявкаНаОтгрузкуПрошлая) Тогда
			Предупреждение("Уже заведена заявка на отгрузку - " + ЗаявкаНаОтгрузкуПрошлая + "!");
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Элементы.Список.ТекущиеДанные.ДатаОтгрузкиОбещ) Тогда
			Предупреждение("Автомобиль уже запланирован к отгрузке");
			Возврат;
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("VIN", Элементы.Список.ТекущиеДанные.VIN);
		ПараметрыФормы.Вставить("BIR", Лев(ДилерскийЦентрПользователя.BIR, 8));
		ПараметрыФормы.Вставить("ОбновлятьТолькоСтроку", Истина);
		ОткрытьФормуМодально("Документ.DMS_ЗаявкаНаОтгрузку.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма);
		
		ЗаявкаНаОтгрузкуСозданная = НайтиЗаявкуНаОтгрузку(Элементы.Список.ТекущиеДанные.VIN);
		Если ЗначениеЗаполнено(ЗаявкаНаОтгрузкуСозданная) Тогда
			ВыбраннаяСтрока.АдресОтгрузки =	ЗаявкаНаОтгрузкуСозданная.АдресОтгрузки;
			ВыбраннаяСтрока.ДатаОтгрузки =	ЗаявкаНаОтгрузкуСозданная.ДатаОтгрузки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЦенаПродажиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмРОП(ПараметрыСеанса.Пользователь)
		И НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоАдминистратораАвтосклада(ПараметрыСеанса.Пользователь) Тогда
		
		Сообщить("Для изменения цены необходимы права на АРМ Руководитель ОП или права ""Администратор автосклада""");
		Возврат;
		
	КонецЕсли;
	
	ЦенаПродажиРОП = Элементы.Список.ТекущиеДанные.ЦенаПродажи;
	
	Если ВвестиЧисло(ЦенаПродажиРОП, "Новая цена продажи", 10, 2) Тогда
		
		Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
		Запись.Автомобиль = Элементы.Список.ТекущиеДанные.Автомобиль;
		Запись.Прочитать();
		Если Не Запись.Выбран() Тогда
			Запись.Период = ТекущаяДата();
			Запись.Автомобиль = Элементы.Список.ТекущиеДанные.Автомобиль;
		КонецЕсли;
		
		Запись.ЦенаФиксирована = Ложь;
		Запись.ЦенаПродажиРОП = ЦенаПродажиРОП;
		Запись.Записать();
		
		Элементы.Список.ТекущиеДанные.ЦенаПродажи = ЦенаПродажиРОП;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиЗаявкуНаОтгрузку(VIN)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_ЗаявкаНаОтгрузку.Ссылка
		|ИЗ
		|	Документ.DMS_ЗаявкаНаОтгрузку КАК DMS_ЗаявкаНаОтгрузку
		|ГДЕ
		|	DMS_ЗаявкаНаОтгрузку.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN", VIN);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Документы.DMS_ЗаявкаНаОтгрузку.ПустаяСсылка();
	
КонецФункции

&НаКлиенте
Процедура Заявка(Команда)
	
	Для каждого стр Из Элементы.Список.ВыделенныеСтроки Цикл
		
		ТД = Элементы.Список.ДанныеСтроки(стр);
		Если ТД.КартинкаСостоянияАвто = 3 тогда
			
			ЭлементыОтбора = Новый Структура;
			ЭлементыОтбора.Вставить("BIR",Лев(ДилерскийЦентрПользователя.BIR, 8));
			ЭлементыОтбора.Вставить("VIN",ТД.VIN);
			ЭлементыОтбора.Вставить("Дата",ТекущаяДата());
			ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЭлементыОтбора);
			ОткрытьФорму("Документ.DMS_ЗаявкаНаОтгрузку.Форма.ФормаДокумента", ПараметрыФормы,ЭтаФорма,Новый УникальныйИдентификатор);
			
		Иначе
			Сообщить("У автомобиля " + ТД.vin+ " не подходит статус");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПеремещение(СкладОтправитель = "",СкладПолучатель = "")
	
	Если СкладОтправитель = "" Тогда
		СкладОтправитель = Справочники.СкладыКомпании.ПустаяСсылка();
	КонецЕсли;
	
	Если СкладПолучатель = "" Тогда
		СкладПолучатель = Справочники.СкладыКомпании.ПустаяСсылка();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПериодПеремещений) Тогда
		ПериодПеремещений.Вариант = ВариантСтандартногоПериода.Сегодня;
	КонецЕсли;
	Перемещение.Параметры.УстановитьЗначениеПараметра("ДатаНачала",ПериодПеремещений.ДатаНачала);
	Перемещение.Параметры.УстановитьЗначениеПараметра("ДатаОкончания",ПериодПеремещений.ДатаОкончания);
	Перемещение.Параметры.УстановитьЗначениеПараметра("VIN","");
	Перемещение.Параметры.УстановитьЗначениеПараметра("СкладОтправитель",СкладОтправитель);
	Перемещение.Параметры.УстановитьЗначениеПараметра("СкладПолучатель",СкладПолучатель);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПеремещенийПриИзменении(Элемент)
	
	ЗаполнитьТекущиеМаршруты();
	СформироватьПеремещение();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблициПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "Потребности" и Элементы.ГруппаЛево.Видимость = Истина Тогда
		Элементы.ГруппаЛево.Видимость = НЕ Элементы.ГруппаЛево.Видимость;
	КонецЕсли;
	
	Если ТекущаяСтраница.Имя <> "Потребности" и Элементы.ГруппаЛево.Видимость = Ложь Тогда
		Элементы.ГруппаЛево.Видимость = НЕ Элементы.ГруппаЛево.Видимость;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформлениеФильтраСписка(ПредставлениеФильтра) // +++ ВалиховГА 22.10.2021 DMSREN-1299
	
	ЦветВыбранногоЭлементаФильтра = Новый Цвет(255,153,0);
	ЦветЭлементаФильтра = Новый Цвет(245, 242, 221);
	
	Для Каждого ИмяЭлемента Из СтрРазделить("ДоступныеДляПродажи,Невыданные,Все", ",") Цикл
		Если ИмяЭлемента = ПредставлениеФильтра Тогда
			Элементы[ИмяЭлемента].ЦветФона = ЦветВыбранногоЭлементаФильтра;
		Иначе
			Элементы[ИмяЭлемента].ЦветФона = ЦветЭлементаФильтра;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // --- ВалиховГА 22.10.2021 DMSREN-1299

