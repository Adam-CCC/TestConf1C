	|ГДЕ
	|	ВыполнениеСервисныхКампаний.СервиснаяКампания <> ЗНАЧЕНИЕ(Справочник.СервисныеКампании.ПустаяСсылка)
	|	И ВыполнениеСервисныхКампаний.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
	|	И Renault_СкрытыеАвтомобилиСОТО.ПричинаСкрытия ЕСТЬ NULL
	|	И  ВыполнениеСервисныхКампаний.VIN = &VIN
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
