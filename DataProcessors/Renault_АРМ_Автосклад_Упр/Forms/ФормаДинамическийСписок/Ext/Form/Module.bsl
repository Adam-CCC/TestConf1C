&НаКлиенте
Процедура Резерв(Команда)
	
	Запись = Элементы.Список.ТекущиеДанные;
	
	ТекущиеДанныеПоРезервам = Элементы.ТаблицаРезервовАвтомобилей.ТекущиеДанные;
	ТекущаяТаблица = "Список";
	
	Если ТекущиеДанныеПоРезервам <> Неопределено Тогда 
		
		Если Команда.Имя = "РезервУтвердить" тогда
			ИзменитьСтатусРезерваПоАвтомобилю(ТекущиеДанныеПоРезервам.ИдентификаторРезерва, Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервУтвержден);
			Запись.ИдентификаторРезерва = ТекущиеДанныеПоРезервам.ИдентификаторРезерва;
			Запись.УтвержденРезерв = Истина;
		ИначеЕсли Команда.Имя = "РезервСнять" тогда
			ИзменитьСтатусРезерваПоАвтомобилю(ТекущиеДанныеПоРезервам.ИдентификаторРезерва, Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервСнят);		
			Запись.ИдентификаторРезерва = Неопределено;
			Запись.УтвержденРезерв = Ложь;
		Иначе
			ИзменитьСтатусРезерваПоАвтомобилю(ТекущиеДанныеПоРезервам.ИдентификаторРезерва, Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервОтклонен);		
			Запись.ИдентификаторРезерва = Неопределено;
			Запись.УтвержденРезерв = Ложь;
		КонецЕсли;
		
		Элементы.Список.Обновить();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДоступныеДляПродажи(Команда)
	
	ПоказыватьЗарезервированные = Ложь;
	ПоказыватьЗакрепленныеЗаКлиентом = Ложь;
	ПоказыватьНеДляПродажи = Ложь;
	ПоказыватьВыданныеАвтомобили = Ложь;
	
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗарезервированные", 	  ПоказыватьЗарезервированные);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьЗакрепленныеЗаКлиентом", ПоказыватьЗакрепленныеЗаКлиентом);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьВыданныеАвтомобили", 	  ПоказыватьВыданныеАвтомобили);
	Список.Параметры.УстановитьЗначениеПараметра("ПоказыватьНеДляПродажи", 		  ПоказыватьНеДляПродажи);
	
	НовыйПорядок = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	НовыйПорядок.Поле = Новый ПолеКомпоновкиДанных("Порядок");
	НовыйПорядок.Использование = Истина;
	НовыйПорядок.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	НовыйПорядок.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто;
	
	// +++ ВалиховГА 22.10.2021 DMSREN-1299
	УстановитьОформлениеФильтраСписка("ДоступныеДляПродажи");
	// --- ВалиховГА 22.10.2021 DMSREN-1299
	
КонецПроцедуры

