Процедура КоманднаяПанельТаблицыДанныхПоСостояниюАвтомобилейДействиеКП(Кнопка)
	
	ИмяТаблицы = ИмяТекущейТаблицы();

	Если Элементы[ИмяТаблицы].ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если Элементы[ИмяТаблицы].Имя = "Заявки" Тогда
		ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
		
		Если ТекущиеДанные.Аннулирована Тогда
			Предупреждение("Заявка аннулирована");
			Возврат;
		КонецЕсли;
		
	ИначеЕсли Элементы[ИмяТаблицы].Имя = "Подержанные" Тогда
		ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	Иначе 
		ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Ознакомлен");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена,"Отмена");		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(м_Клиент) Тогда
		//DMSREN-986
		Если Не ВыбратьКлиента() Тогда 
			Предупреждение("Выбор клиента обязателен для создания коммерческого предложения");
			Возврат;
		КонецЕсли;
		//Предупреждение("Выбор клиента обязателен для создания коммерческого предложения");
		//Возврат;
		//----
	КонецЕсли;
	
	ФормаРабочийСтол = Обработки.CRM_АРМ_Конфигуратор.ПолучитьФорму("Форма");
	ФормаРабочийСтол.ТекущийРабочийЛист = м_РабочийЛист;
	ФормаРабочийСтол.ТекущийКлиент = м_Клиент; 
	БУ ="";
	Если Элементы[ИмяТаблицы].Имя = "Подержанные" Тогда
		БУ="БУ";
		СоставОпций = Неопределено;
		ФормаРабочийСтол.ЭтоТрейдИН = Истина;
		ФормаРабочийСтол.ТипКП = Перечисления.Renault_ТипКП.АвтомобильСПробегом;
		ТекущиеДанные = Элементы.Подержанные.ТекущиеДанные;
		ФормаРабочийСтол.Модель = ТекущиеДанные.Автомобиль.Модель;
		ФормаРабочийСтол.Версия = ТекущиеДанные.Автомобиль.ВариантКомплектации;
		ФормаРабочийСтол.Цвет  =  ТекущиеДанные.Автомобиль.Цвет;
	Иначе
		ФормаРабочийСтол.ТипКП = Перечисления.Renault_ТипКП.НовыйАвтомобиль;
		СоставОпций = ТекущиеДанные.СоставОпций;
	КонецЕсли;
	
	Если НЕ (ТекущиеДанные = Неопределено) Тогда
		ФормаРабочийСтол.Автомобиль = ТекущиеДанные.Автомобиль;
	Иначе
		Возврат;
	КонецЕсли;
	
	// добавим оборудование дилера
	
	Таблицы = ТаблицаОпцийДляКомПредложения(Бу,ТекущиеДанные.VIN,ТекущиеДанные.Автомобиль,СоставОпций,ТекущиеДанные.Версия);
	
	Для Каждого СтрокаОпций ИЗ Таблицы.Опции Цикл
		НоваяСтрока = ФормаРабочийСтол.ВыбранноеОборудование.Добавить();
		НоваяСтрока.Номенклатура = СтрокаОпций.Опция;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.Цена = СтрокаОпций.Сумма;
		НоваяСтрока.Сумма = СтрокаОпций.Сумма;
	КонецЦикла;
	Если Таблицы.ДилОпции Тогда
		ФормаРабочийСтол.ИнтересовалсяОборудованием = Истина;
	КонецЕсли;
	
	ФормаРабочийСтол.Открыть();
	
	//ВазСистем Тарасов 20.11.2020 15:41:59 Инцидент #DMSREN-994
	//{
	//Старый код:
	//ОчиститьКлиента();
	//Новый код:
	//}
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьВыборКлиентаНажатие(Элемент)
	
	ВыбратьКлиента();
	
КонецПроцедуры

&НаКлиенте
Функция ВыбратьКлиента(МенеджерДляВыбора = Неопределено)
	
	//Отобразим форму выбора
	Форма = ПолучитьФорму("Обработка.Renault_АРМ_Автосклад_Упр.Форма.ФормаВыбораКлиента");
	
	Если ЗначениеЗаполнено(МенеджерДляРучнойРегистрации) Тогда
		Форма.МенеджерДляВыбора = МенеджерДляРучнойРегистрации;
	КонецЕсли;
	
	Ответ = Форма.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		м_Клиент = Ответ.Клиент;
		м_РабочийЛист = Ответ.НомерРабочегоЛиста;
		ОбновитьОтображениеНадписьКлиент();
		Возврат Истина;
	Иначе
		м_Клиент = Неопределено;
		м_РабочийЛист = Неопределено;
		
		ОбновитьОтображениеНадписьКлиент();
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(м_Клиент) тогда
		Элементы.СтранициКлиент.ТекущаяСтраница = Элементы.ЗаполненКлиент;
	Иначе
		Элементы.СтранициКлиент.ТекущаяСтраница = Элементы.НеЗаполненКлиент;
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура ОчиститьКлиента()
	
	м_Клиент = Неопределено;
	м_РабочийЛист = Неопределено;
	ОбновитьОтображениеНадписьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеНадписьКлиент()
	
	Если ЗначениеЗаполнено(м_Клиент) тогда
		Элементы.СтранициКлиент.ТекущаяСтраница = Элементы.ЗаполненКлиент;
	Иначе
		Элементы.СтранициКлиент.ТекущаяСтраница = Элементы.НеЗаполненКлиент;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура м_КлиентНажатие(Элемент, СтандартнаяОбработка)
	ВыбратьКлиента();
КонецПроцедуры

&НаКлиенте
Процедура Зарезервировать(Команда)
	
	ДанныеВыделенныхСтрок = Новый Массив;
	
	ИмяТаблицы = ИмяТекущейТаблицы();

	Если Элементы[ИмяТаблицы].имя = "Подержанные" Тогда
		ТекущиеДанные = Элементы.Подержанные.ТекущиеДанные;
		
		// { DMSREN-633 Болдарев Д.Е. от 18.03.2020
		//Строки = Элементы.Подержанные.ВыделенныеСтроки;		
		Для каждого ТекВыделенная Из Элементы.Подержанные.ВыделенныеСтроки Цикл
			ДанныеВыделенныхСтрок.Добавить(Элементы.Подержанные.ДанныеСтроки(ТекВыделенная));
		КонецЦикла; 
		// } DMSREN-633 Болдарев Д.Е. от 18.03.2020.
	Иначе
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		
		// { DMSREN-633 Болдарев Д.Е. от 18.03.2020  
		//Строки = Элементы.Список.ВыделенныеСтроки;		
		Для каждого ТекВыделенная Из Элементы.Список.ВыделенныеСтроки Цикл
			ДанныеВыделенныхСтрок.Добавить(Элементы.Список.ДанныеСтроки(ТекВыделенная));
		КонецЦикла;
		// } DMSREN-633 Болдарев Д.Е. от 18.03.2020. 
		
	КонецЕсли;
	
	Если ТекущиеДанные.НеДляПродажи	Тогда
		Предупреждение("Автомобиль со статусом ""Не для продажи"" не возможно поставить в резерв!");
		Возврат;
	КонецЕсли;

	Если ТекущиеДанные.Отозван Тогда
		ВопросПользователю = Вопрос("По автомобилю есть невыполненные отзывные ноты, всё равно продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Если ВопросПользователю = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(м_Клиент) Тогда
		Если Не ВыбратьКлиента() Тогда
			Предупреждение("Выбор клиента обязателен для создания коммерческого предложения");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеВыделенныхСтрок.Количество() > 0  Тогда
		
		КомментарийКЗаявке = "";
		
		ДнейРезерваПоУмолчанию = ПараметрыСеанса.Renault_ПраваПользователя.Автосклад_КоличествоДнейРезерваПоУмолчанию;
		Если ДнейРезерваПоУмолчанию = 0 Тогда
			ДнейРезерваПоУмолчанию = МаксимальноеКоличествоДнейРезерва;
			Если МаксимальноеКоличествоДнейРезерва = 0 Тогда
				ДнейРезерваПоУмолчанию = 3;
			КонецЕсли;
		КонецЕсли;
		
		ДатаСнятияСРезерва = ТекущаяДата() + ДнейРезерваПоУмолчанию*60*60*24;
		
		Если ВвестиДату(ДатаСнятияСРезерва, "Укажите до какой даты установить резерв") Тогда
			
			Если МаксимальноеКоличествоДнейРезерва <> 0 И ДатаСнятияСРезерва - ТекущаяДата() > МаксимальноеКоличествоДнейРезерва*60*60*24 Тогда
				Предупреждение("Оформление резерва невозможоно. Максимальное число дней резерва для вас - " + Строка(МаксимальноеКоличествоДнейРезерва));
				Возврат;
			КонецЕсли;
			
			Если ВвестиСтроку(КомментарийКЗаявке, "Введите комментарий к заявке на резерв...", , Истина) Тогда 
				
				Если ЗначениеЗаполнено(МенеджерДляРучнойРегистрации) Тогда
					МенеджерРезерва = МенеджерДляРучнойРегистрации;
				Иначе
					МенеджерРезерва = мТекущийМенеджер;
				КонецЕсли;
				
			Иначе
				Возврат;
			КонецЕсли;
			
		Иначе
			Возврат;
		КонецЕсли;
		
		// { DMSREN-633 Болдарев Д.Е. от 18.03.2020  
		//СоздатьЗаявкуНаРезервСтроки(Строки,КомментарийКЗаявке,МенеджерРезерва,ДатаСнятияСРезерва);
		СоздатьЗаявкуНаРезервСтроки(ДанныеВыделенныхСтрок, КомментарийКЗаявке, МенеджерРезерва, ДатаСнятияСРезерва);
		// } DMSREN-633 Болдарев Д.Е. от 18.03.2020. 
		
		ОчиститьКлиента();
		Элементы[ИмяТаблицы].Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаявкуНаРезервСтроки(Строки,КомментарийКЗаявке,МенеджерРезерва,ДатаСнятияСРезерва)
	
	Для Каждого СтрокаТЗ из Строки Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_УтвержденныеРезервы.Регистратор,
		|	Renault_УтвержденныеРезервы.НомерСтроки,
		|	Renault_УтвержденныеРезервы.Активность,
		|	Renault_УтвержденныеРезервы.VIN,
		|	Renault_УтвержденныеРезервы.Автомобиль,
		|	Renault_УтвержденныеРезервы.Менеджер,
		|	Renault_УтвержденныеРезервы.Комментарий,
		|	Renault_УтвержденныеРезервы.Автор,
		|	Renault_УтвержденныеРезервы.Контролер,
		|	Renault_УтвержденныеРезервы.РабочийЛист,
		|	Renault_УтвержденныеРезервы.SedreNum,
		|	Renault_УтвержденныеРезервы.Клиент
		|ИЗ
		|	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
		|ГДЕ
		|	Renault_УтвержденныеРезервы.VIN = &VIN";
		
		Запрос.УстановитьПараметр("VIN", СтрокаТЗ.VIN);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Сообщить("Автомобиль" + Выборка.Автомобиль + " уже находится в резерве");	
			Продолжить;
		КонецЕсли;
		
		ЕстьПравоСразуРезервироватьАвтомобиль = ПараметрыСеанса.Renault_ПраваПользователя.РезервироватьАвтомобильБезСогласования;
		Если ЕстьПравоСразуРезервироватьАвтомобиль Тогда
			// { DMSREN-633 Болдарев Д.Е. от 18.03.2020  
			//СоздатьЗаявкуНаРезерв(СтрокаТЗ, СтрокаТЗ.VIN, МенеджерРезерва, м_Клиент, м_РабочийЛист, КомментарийКЗаявке, ДатаСнятияСРезерва, Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервУтвержден, ПараметрыСеанса.Пользователь);
			СоздатьЗаявкуНаРезерв(СтрокаТЗ.Автомобиль, СтрокаТЗ.VIN, МенеджерРезерва, м_Клиент, м_РабочийЛист, КомментарийКЗаявке, ДатаСнятияСРезерва, Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервУтвержден, ПараметрыСеанса.Пользователь);
			// } DMSREN-633 Болдарев Д.Е. от 18.03.2020. 
			
			//СтрокаТЗ.УтвержденРезерв = Истина;
		Иначе
			// { DMSREN-633 Болдарев Д.Е. от 18.03.2020  
			//СоздатьЗаявкуНаРезерв(СтрокаТЗ, СтрокаТЗ.VIN, МенеджерРезерва, м_Клиент, м_РабочийЛист, КомментарийКЗаявке, ДатаСнятияСРезерва);
			СоздатьЗаявкуНаРезерв(СтрокаТЗ.Автомобиль, СтрокаТЗ.VIN, МенеджерРезерва, м_Клиент, м_РабочийЛист, КомментарийКЗаявке, ДатаСнятияСРезерва);
			// } DMSREN-633 Болдарев Д.Е. от 18.03.2020. 
			
			//ИзменитьСтатусРезерваПоАвтомобилю(ТекущиеДанные.VIN, мТекущийМенеджер, Клиент, НомерРабочегоЛиста, Перечисления.CRM_СтатусыРезервовАвтомобилей.ЗаявкаНаРезерв, КомментарийКЗаявке);		
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


Процедура СоздатьЗаявкуНаРезерв(Автомобиль, VIN, МенеджерРезерва, КлиентРезерва, НомерРабочегоЛистаРезерва, КомментарийКЗаявке, ДатаСнятияСРезерва, СтатусРезерва = Неопределено, Контролер = Неопределено)
	
	НовЗаявка = Документы.Renault_РезервированиеАвтомобилей.СоздатьДокумент();
	
	НовЗаявка.VIN = VIN;
	НовЗаявка.Автомобиль = Автомобиль;
	НовЗаявка.Дата = ТекущаяДата();
	НовЗаявка.Автор = мТекущийПользователь;
	НовЗаявка.Менеджер = МенеджерРезерва;
	НовЗаявка.Клиент = КлиентРезерва;
	НовЗаявка.РабочийЛист = НомерРабочегоЛистаРезерва;
	НовЗаявка.СтатусРезерва = ?(ЗначениеЗаполнено(СтатусРезерва), СтатусРезерва, Перечисления.CRM_СтатусыРезервовАвтомобилей.ЗаявкаНаРезерв);
	НовЗаявка.Комментарий = КомментарийКЗаявке;
	НовЗаявка.ДатаСнятияРезерва = ДатаСнятияСРезерва;
	Если ЗначениеЗаполнено(Контролер) Тогда
		НовЗаявка.Контролер = Контролер;
	КонецЕсли;
	
	НовЗаявка.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура СнятьРезервСАвтомобиля(Автомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_УтвержденныеРезервы.Регистратор
	               |ИЗ
	               |	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
	               |ГДЕ
	               |	Renault_УтвержденныеРезервы.Автомобиль = &Автомобиль
	               |	И (&Менеджер = ""ЕстьПравоАдминистрирования""
	               |			ИЛИ Renault_УтвержденныеРезервы.Менеджер = &Менеджер)";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Если НЕ ЕстьПравоАдминистрированияАвтосклад Тогда
		Запрос.УстановитьПараметр("Менеджер", мТекущийПользователь.Сотрудник);
		//Если нет права администрирования можно снимать только свои резервы
	Иначе
		Запрос.УстановитьПараметр("Менеджер", "ЕстьПравоАдминистрирования");
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Регистратор.ПолучитьОбъект();
		Док.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервСнят;
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Renault_ЗаявкиНаРезервАвтомобиля.Регистратор
	               |ИЗ
	               |	РегистрСведений.Renault_ЗаявкиНаРезервАвтомобиля КАК Renault_ЗаявкиНаРезервАвтомобиля
	               |ГДЕ
	               |	Renault_ЗаявкиНаРезервАвтомобиля.Автомобиль = &Автомобиль
	               |	И (&Менеджер = ""ЕстьПравоАдминистрирования""
	               |			ИЛИ Renault_ЗаявкиНаРезервАвтомобиля.Менеджер = &Менеджер)";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Если НЕ ЕстьПравоАдминистрированияАвтосклад Тогда
		//Если нет права администрирования можно снимать только свои резервы
		Запрос.УстановитьПараметр("Менеджер", мТекущийПользователь.Сотрудник);
	Иначе
		Запрос.УстановитьПараметр("Менеджер", "ЕстьПравоАдминистрирования");
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Док = Выборка.Регистратор.ПолучитьОбъект();
		Док.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервСнят;
		Док.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьРезервНаАвтомобиль(Автомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_УтвержденныеРезервы.Регистратор
	               |ИЗ
	               |	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
	               |ГДЕ
	               |	Renault_УтвержденныеРезервы.Автомобиль = &Автомобиль";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции

&НаКлиенте
Процедура СнятиеСРезерва(Команда)
	
	ИмяТаблицы = ?(Элементы.Таблици.ТекущаяСтраница = Элементы.Список,"Список","Подержанные");  //DMS
	
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда 
		
		СнятьРезервСАвтомобиля(ТекущиеДанные.Автомобиль);
		Если Не ЕстьРезервНаАвтомобиль(ТекущиеДанные.Автомобиль) Тогда
			Элементы[ИмяТаблицы].ТекущиеДанные.ИдентификаторРезерва = Неопределено;
			Элементы[ИмяТаблицы].ТекущиеДанные.УтвержденРезерв = Ложь;
			Элементы[ИмяТаблицы].ТекущиеДанные.ЗаявленРезерв = Ложь;
		КонецЕсли;
		
		Элементы[ИмяТаблицы].Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Договор(Команда)
	
	Если Элементы.Таблици.ТекущаяСтраница = Элементы.Подержанные Тогда
		ИмяТаблицы = "Подержанные";
	ИначеЕсли Элементы.Таблици.ТекущаяСтраница = Элементы.Заявки Тогда
		ИмяТаблицы = "Заявки";
	Иначе ИмяТаблицы = "Список";
	КонецЕсли;
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяТаблицы = "Заявки" Тогда
		
		Если ТекущиеДанные.Аннулирована Тогда
			Предупреждение("Заявка аннулирована");
			Возврат;
		КонецЕсли;
		
	Иначе
		
		НеДляПродажи = ТекущиеДанные.НеДляПродажи;
		
		ЗакрепленЗаКлиентомВDMS = ТекущиеДанные.ЗакрепленЗаКлиентомВDMS;
		
		Если ТекущиеДанные.Отозван Тогда
			Предупреждение("По автомобилю есть невыполненные отзывные ноты");
			Возврат;
		КонецЕсли;
		
		Если НеДляПродажи Тогда
			Предупреждение("Автомобиль недоступен для продажи");
			Возврат;
		КонецЕсли;
		
		Если ЗакрепленЗаКлиентомВDMS Тогда
			Предупреждение("Автомобиль уже закреплен за другим клиентом");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(м_Клиент) Тогда
		Если Не ВыбратьКлиента() Тогда
			Предупреждение("Выбор клиента обязателен для создания договора");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка
	|ИЗ Документ.Renault_Договор.СоставДоговора КАК Состав
	|ГДЕ Состав.Автомобиль = &Автомобиль
	|	И Состав.Ссылка.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Автомобиль", ТекущиеДанные.Автомобиль);
	Запрос.УстановитьПараметр("Клиент", м_Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		//Сообщить("Для данного клиента уже есть договор на выбранный автомобиль");
		//Возврат;
		ДоговорОб = Выборка.Ссылка.ПолучитьОбъект();
		ДоговорОб.ПолучитьФорму().Открыть();
		м_Клиент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	
	//Создадим новый
	Форма = ПолучитьФорму("Документ.Renault_Договор.Форма.ФормаДокумента");
	
	ДоговорОбъектНового = Форма.ДокументОбъект;
	ДоговорОбъектНового.Дата = ТекущаяДата();
	ДоговорОбъектНового.ДатаДоговора = ТекущаяДата();
	ДоговорОбъектНового.РабочийЛист = м_РабочийЛист;
	ДоговорОбъектНового.СтатусДоговора = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик;
	ДоговорОбъектНового.Клиент = м_Клиент;
	ДоговорОбъектНового.ДилерскийЦентр = ДилерскийЦентрПользователя;
	Если ИмяТаблицы = "Список" Тогда
		ДоговорОбъектНового.АвтомобильБу = Истина;
	КонецЕсли;
	
	Стр = ДоговорОбъектНового.СоставДоговора.Добавить();
	Стр.Автомобиль = ТекущиеДанные.Автомобиль;
	Стр.Идентификатор = Новый УникальныйИдентификатор;
	Стр.VIN = ТекущиеДанные.VIN;
	
	Форма.Открыть();
	
	//ВазСистем Тарасов 20.11.2020 15:41:59 Инцидент #DMSREN-994
	//{
	//Старый код:
	//м_Клиент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	//Новый код:
	//}
	
	//ФормаДоговора = ДоговорОбъектНового.ПолучитьФорму();
	//ФормаДоговора.ПерезаполнитьДоговор = Истина;
	//ФормаДоговора.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура НеДляПродажи(Команда)
	
	ИмяТаблицы = ?(Элементы.Таблици.ТекущаяСтраница = Элементы.Новые,"Список","Подержанные");  //DMS
	дс_Автомобиль = Элементы[ИмяТаблицы].ТекущиеДанные.Автомобиль;
	
	Идентификатор = Элементы[ИмяТаблицы].ТекущиеДанные.Идентификатор;
	Если ТипЗнч(Идентификатор) = Тип("ДокументСсылка.Renault_Договор") Тогда
		Попытка
			тАвтомобиль = Идентификатор.СоставДоговора[0].Автомобиль;
		Исключение
			тАвтомобиль = дс_Автомобиль;
		КонецПопытки;
	Иначе
		тАвтомобиль = Идентификатор;
	КонецЕсли;
	НеДляПродажи = НеДляПродажиНаСервере(тАвтомобиль);
	
	Элементы[ИмяТаблицы].ТекущиеДанные.НеДляПродажи = НеДляПродажи;
	Если ИмяТаблицы = "Список" тогда
		Если НеДляПродажи тогда
		Элементы[ИмяТаблицы].ТекущиеДанные.КартинкаРезерв = 3;
	    Иначе
		Элементы[ИмяТаблицы].ТекущиеДанные.КартинкаРезерв = 99999;
	    КонецЕсли;
	ИначеЕсли ИмяТаблицы = "Подержанные" тогда
		Если НеДляПродажи тогда
		Элементы[ИмяТаблицы].ТекущиеДанные.ПодержанныеКартинкаСтатус = 3;
	    Иначе
		Элементы[ИмяТаблицы].ТекущиеДанные.ПодержанныеКартинкаСтатус = 99999;
	    КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НеДляПродажиНаСервере(тАвтомобиль)
	
	ЗаписьДопИнфо = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
	ЗаписьДопИнфо.Автомобиль = тАвтомобиль;
	ЗаписьДопИнфо.Прочитать();
	
	ЗаписьДопИнфо.Автомобиль = тАвтомобиль;
	ЗаписьДопИнфо.НеДляПродажи = Не ЗаписьДопИнфо.НеДляПродажи;
	Попытка
		ЗаписьДопИнфо.Записать();
	Исключение
		Сообщить("Не удалось изменить статус");
	КонецПопытки;
	Возврат ЗаписьДопИнфо.НеДляПродажи;
	
КонецФункции

&НаКлиенте
Функция ИмяТекущейТаблицы()
	
	ИмяТаблици ="";
	
	Если Элементы.Таблици.ТекущаяСтраница = Элементы.Новые тогда
		 ИмяТаблици = "Список";
	ИначеЕсли Элементы.Таблици.ТекущаяСтраница = Элементы.СтраницаПодержанные тогда
		 ИмяТаблици = "Подержанные";
	ИначеЕсли Элементы.Таблици.ТекущаяСтраница = Элементы.СтраницаДемо тогда
		 ИмяТаблици = "ДемоПодмен";
	ИначеЕсли Элементы.Таблици.ТекущаяСтраница = Элементы.Завки тогда
		 ИмяТаблици = "Заявки";
	ИначеЕсли Элементы.Таблици.ТекущаяСтраница = Элементы.Потребности тогда
		 ИмяТаблици = "Перемещение";
	КонецЕсли;
	
	Возврат ИмяТаблици;
	
КонецФункции

&НаКлиенте
Процедура ТТН(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗаголовокПоля", "Введите номер ТТН");
		Если ЗначениеЗаполнено(ТекущиеДанные.НомерТТН) Тогда
			ПараметрыФормы.Вставить("Номер",ТекущиеДанные.НомерТТН);
		КонецЕсли;
		РезультатВвода = ОткрытьФормуМодально("Обработка.Renault_АРМ_Автосклад.Форма.ВводНомераТН", ПараметрыФормы);
		
		Если РезультатВвода = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ТТННомер = РезультатВвода.НомерДокумента;
		ГодТТН = Год(ТекущаяДата());
		Если РезультатВвода.ПрошлыйГод Тогда
			ГодТТН = ГодТТН - 1;
		КонецЕсли;
		//Форма = ПолучитьФорму("Документ.ПоступлениеАвтомобилей.ФормаОбъекта");
		//ДанныеФормы = "";
        // ЗаполнитьДокументНаСервере(ДанныеФормы);
		сПараметры = DMS_ТТН.ТТННаСервере(ТТННомер,ГодТТН,ТекущиеДанные.Vin,ДилерскийЦентрПользователя,мТекущийПользователь);
	
		//Если сПараметры.Автосклад_РазделятьПоступленияПоТТН Тогда 
		         ОткрытьФормуМодально("Обработка.Renault_АРМ_Автосклад.Форма.ФормаПриемаАвтомобиля", сПараметры);
	//							Форма.ОткрытьМодально();
	//	КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////  Процедуры и функции вызываемые П и Ф из кнопок

&НаСервере
Функция ВыполнитьЗапрос(ПараметрыВызоваСервера)
	
	НовыйУникальныйИдентификатор = Новый УникальныйИдентификатор;
	РезультатФоновогоЗадания = Renault_ДлительныеОперации.ЗапуститьВыполнениеВФоне(НовыйУникальныйИдентификатор, 
	"DMS_ОбменДаннымиСДилерскимПорталом.ПолучитьКонфигурациюПоVIN", ПараметрыВызоваСервера);
	Результат = Новый Структура;
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		Результат.Вставить("ФоновоеЗадание", Ложь);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	Иначе 
		Результат.Вставить("ФоновоеЗадание", Истина);
		Результат.Вставить("ФоновоеЗаданиеИдентификатор", РезультатФоновогоЗадания.ИдентификаторЗадания);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции


Функция СоздатьКонтрагентаИзДилера(ДЦ)
	
	НовДилер = Справочники.Контрагенты.СоздатьЭлемент();
	НовДилер.Наименование = ДЦ.Наименование;
	НовДилер.НаименованиеПолное = ДЦ.Наименование;
	НовДилер.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
	НовДилер.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;
	НовДилер.Записать();
	Дилер = НовДилер.Ссылка;
	
	//Адрес
	Если ЗначениеЗаполнено(ДЦ.ОсновнойАдрес) Тогда
		Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЮридический;
		Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		Запись.Объект = Дилер;
		Запись.Представление = ДЦ.ОсновнойАдрес;
		Запись.ЗначениеПоУмолчанию = Истина;
		Запись.Записать();
	КонецЕсли;
	
	//телефон организации
	Если ЗначениеЗаполнено(ДЦ.ОсновнойТелефон) Тогда
		Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонРабочий;
		Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		Запись.Объект = Дилер;
		Запись.Представление = ДЦ.ОсновнойТелефон;
		Запись.Записать();
	КонецЕсли;
	
	//Email
	Если ЗначениеЗаполнено(ДЦ.ОсновнойEmail) Тогда
		Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий;
		Запись.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		Запись.Объект = Дилер;
		Запись.Представление = ДЦ.ОсновнойEmail;
		Запись.ЗначениеПоУмолчанию = Истина;
		Запись.Записать();
	КонецЕсли;
	
	Возврат НовДилер.Ссылка;
	
КонецФункции

////////////////////////////////////////////////  Кнопка Клиентская Заявка

&НаКлиенте
Процедура КлиентскаяЗаявка(Команда)
	
	ПараметрыОбработчика = "";
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
		ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
		ТС = Элементы.Список.ТекущиеДанные;
		ТекущиеПараметрыВыбора = Новый Структура;
		ТекущиеПараметрыВыбора.Вставить("ДЦ", ДЦ);
		ТекущиеПараметрыВыбора.Вставить("ТС", ТС);
		ТекущиеПараметрыВыбора.Вставить("Каманда", "КлиенскаяЗаявка");
		ПараметрыВызоваСервера = Новый Структура;
		ПараметрыВызоваСервера.Вставить("Счет",ДЦ.СчетSedre);
		ПараметрыВызоваСервера.Вставить("VIN", ТС.VIN);
		
		РезультатПолученияДопИнформации = ВыполнитьЗапрос (ПараметрыВызоваСервера);
		
		Если РезультатПолученияДопИнформации.ФоновоеЗадание Тогда
			Renault_ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
			ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", 1, Истина);
			ФормаДлительнойОперации = Renault_ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);
		Иначе
			ОбработатьРезультатВыполненияЗадания(РезультатПолученияДопИнформации, ТекущиеПараметрыВыбора);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

/////////////////////////////////////////////  Кнопка Групповая Клиентская Заявка

&НаКлиенте
Процедура ГрупповаяКлиентскаяЗаявка(Команда)
	
	ПараметрыОбработчика="";	
	МассивСтрок = Новый Массив;
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	Для каждого стр Из Элементы.Список.ВыделенныеСтроки Цикл
		Элементы.Список.ТекущаяСтрока = стр;
		ТД = Элементы.Список.ТекущиеДанные;
		МассивСтрок.Добавить(ТД);
	КонецЦикла;
	Элементы.Список.ТекущаяСтрока = ТекСтрока;
	МассивОтветов = Новый Массив;
	
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	
	Для каждого стр Из МассивСтрок Цикл
