&НаСервере
Процедура ИзменитьСтатусРезерваПоАвтомобилю(ДокументСсылка, СтатусРезерва)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ДокОбъект = ДокументСсылка.ПолучитьОбъект();
	ДокОбъект.СтатусРезерва = СтатусРезерва;
	ДокОбъект.Контролер = ПараметрыСеанса.Пользователь;
	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

