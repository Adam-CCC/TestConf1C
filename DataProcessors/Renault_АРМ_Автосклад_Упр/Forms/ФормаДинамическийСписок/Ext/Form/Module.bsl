	Запрос.УстановитьПараметр("VIN", 				 				VINАвтомобиля);
	Запрос.УстановитьПараметр("МассивСкладовДилера", 				МассивСкладовДилера);
	Запрос.УстановитьПараметр("BIR", 								CRM_Сервер.РазложитьСтрокуВМассивПодстрок(BIR_Distri, ","));
	Запрос.УстановитьПараметр("ТекущийСотрудник", 					ПараметрыСеанса.Пользователь.Сотрудник);
	Запрос.УстановитьПараметр("РежимПодтверждения", 				РежимПодтверждения);
	Запрос.УстановитьПараметр("ДатаНеПоказыватьВыданныеАвтомобили", ?(ДатаНеПоказыватьВыданныеАвтомобили = Неопределено,Дата('00010101'),ДатаНеПоказыватьВыданныеАвтомобили));
	Запрос.УстановитьПараметр("УчитыватьРеализацииКакВыдачи", 		Не Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.Автосклад_НеУчитыватьРеализацииКакВыдачи);
	Запрос.УстановитьПараметр("ИспользоватьТиповойДО",		 		 Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьТиповойУчетДО);
	
	ТипПрисоединенияИзНоменклатурыИРабот = Ложь;	
	Если ЗначениеЗаполнено(ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр) Тогда
		Если ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.ТипПривязкиДоповКАвтомобилям = Перечисления.Renault_ТипыУчетаДополнительногоОборудования.ИзНоменклатурыИРабот Тогда
			ТипПрисоединенияИзНоменклатурыИРабот = Истина;
	    КонецЕсли;
	КонецЕсли;
    Запрос.УстановитьПараметр("ТипПрисоединенияИзНоменклатурыИРабот",ТипПрисоединенияИзНоменклатурыИРабот);	
		
	СтруктураОтбора = ?(СтруктураОтбора = Неопределено, ПолучитьСтруктуруНастроекАвтосклад(), СтруктураОтбора);
	Для Каждого Эл Из СтруктураОтбора Цикл Запрос.УстановитьПараметр(Эл.Ключ, Эл.Значение) КонецЦикла;
	
	Если ЗначениеЗаполнено(МодельАвтомобиля) Тогда
		Запрос.УстановитьПараметр("Модель", МодельАвтомобиля);
	Иначе
		Запрос.УстановитьПараметр("Модель", Справочники.Модели.ПустаяСсылка());
	КонецЕсли;
	
	// начало добавление Зеленчук
	ВерсияАвтомобиляМассив = ТипЗнч(ВерсияАвтомобиля) = Тип("Массив");
	// окончание добавление Зеленчук

	Если ТипЗнч(ВерсияАвтомобиля) = Тип("Массив") Тогда
		Запрос.УстановитьПараметр("Версия", ВерсияАвтомобиля);
	Иначе
		Если
			ЗначениеЗаполнено(ВерсияАвтомобиля) Тогда
			Запрос.УстановитьПараметр("Версия", ВерсияАвтомобиля);
		Иначе
			Запрос.УстановитьПараметр("Версия", Справочники.ВариантыКомплектации.ПустаяСсылка());
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЦветАвтомобиля) Тогда
		Запрос.УстановитьПараметр("Цвет", ЦветАвтомобиля);
	Иначе
		Запрос.УстановитьПараметр("Цвет", Справочники.Цвета.ПустаяСсылка());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДоговорНаАвансСсылка) И Не ЗначениеЗаполнено(VINАвтомобиля) Тогда
		Запрос.УстановитьПараметр("ДоговорНаАвансСсылка", ДоговорНаАвансСсылка);
	Иначе
		Запрос.УстановитьПараметр("ДоговорНаАвансСсылка", Документы.Renault_Договор.ПустаяСсылка());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПоказыватьЗарезервированные", 	  ПоказыватьЗарезервированные);
	Запрос.УстановитьПараметр("ПоказыватьЗакрепленныеЗаКлиентом", ПоказыватьЗакрепленныеЗаКлиентом);
	Запрос.УстановитьПараметр("ПоказыватьВыданныеАвтомобили", 	  ПоказыватьВыданныеАвтомобили);
	Запрос.УстановитьПараметр("ПоказыватьНеДляПродажи", 		  ПоказыватьНеДляПродажи);
	Запрос.УстановитьПараметр("ПоказыватьДоговоры", 			  ПоказыватьДоговоры);
	
	Запрос.Текст = Текст;
	
	Результат = Запрос.Выполнить();
	
	Если НуженРезультат Тогда
		Возврат Результат.Выгрузить();
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура надписьОткрытьКарточкуАвтомобиляНажатие(Элемент)
	
	Если ЗначениеЗаполнено(дс_Автомобиль) Тогда
		дс_Автомобиль.ПолучитьФорму("ФормаЭлемента").Открыть();
	ИначеЕсли ЗначениеЗаполнено(дс_ДоговорКП) Тогда
		дс_ДоговорКП.ПолучитьФорму("ФормаЭлемента").Открыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура надписьОткрытьККПАвтомобиляНажатие(Элемент)
	
	ИмяТаблицы = ИмяТекущейТаблицы();
	
	Если Элементы[ИмяТаблицы].ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ЗначениеЗаполнено(дс_Автомобиль) Тогда
		ДокККП = Документы.DMS_КартаКачестваПоставки.НайтиПоРеквизиту("Автомобиль",дс_Автомобиль);
		Если ДокККП = Документы.DMS_КартаКачестваПоставки.ПустаяСсылка() Тогда
			Если Вопрос("Карта качества поставки не найдена! Хотите создать новую?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				Бу = "";
				Таблицы = ТаблицаОпцийДляКомПредложения(Бу,ТекущиеДанные.VIN,ТекущиеДанные.Автомобиль,ТекущиеДанные.СоставОпций,ТекущиеДанные.Версия);
				Парам = Новый Структура("Автомобиль,ТаблицаОпций,ТаблицаОпцийДилера",дс_Автомобиль,Таблицы.Опции,Таблицы.ТабДилОпции);
				ОткрытьФорму("Документ.DMS_КартаКачестваПоставки.ФормаОбъекта", Парам);
			КонецЕсли;
		Иначе
			ОткрытьЗначение(ДокККП);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьИнформациюПоАМ(Команда)
	
	мОтображатьДополнительнуюИнформацию = НЕ мОтображатьДополнительнуюИнформацию;
	
	ТекСтраница = Элементы.Таблици.ТекущаяСтраница;
	Если ТекСтраница.Имя = "Новые" Тогда
		ПанельИнфо = Элементы.Группа1;
	ИначеЕсли ТекСтраница.Имя = "СтраницаПодержанные" Тогда
		ПанельИнфо = Элементы.Информация2;
	ИначеЕсли ТекСтраница.Имя = "СтраницаДемо" Тогда
		ПанельИнфо = Элементы.Группа232;
	ИначеЕсли ТекСтраница.Имя = "Завки" Тогда
		ПанельИнфо = Элементы.ГруппаИнформацияПоАМ2;
	КонецЕсли;
	
	Если мОтображатьДополнительнуюИнформацию Тогда
		ПанельИнфо.Видимость = Истина;    
		Элементы.СкрытьПоказатьИнформациюПоАМ.Заголовок = "Скрыть информацию по а/м";
	Иначе
		ПанельИнфо.Видимость = Ложь;     
		Элементы.СкрытьПоказатьИнформациюПоАМ.Заголовок = "Показать информацию по а/м";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	мОтображатьДополнительнуюИнформацию = Истина;
	ИнициализироватьФильтры();
	
	// +++ ВалиховГА 22.10.2021 DMSREN-1299
	УстановитьОформлениеФильтраСписка("ДоступныеДляПродажи");
	// --- ВалиховГА 22.10.2021 DMSREN-1299
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФильтры()
	
	// По статусам
	ДеревоФильтровСтатус = РеквизитФормыВЗначение("ДеревоФильтровПоСтатусам");
	ДеревоФильтровСтатус.Строки.Очистить();

	СтрокаВсеСтатусы = ДеревоФильтровСтатус.Строки.Добавить();
	СтрокаВсеСтатусы.Представление = "Все статусы";
	
	ДилерскийЦентрПользователя = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	
	МассивСкладовДилера = ДилерскийЦентрПользователя.СкладыДилера.ВыгрузитьКолонку("Склад");

	Для Каждого ЗначениеСтатуса Из Перечисления.CRM_СтатусыАвтомобилей Цикл 
		
		НовСтрокаСтатуса = СтрокаВсеСтатусы.Строки.Добавить();
		
		НовСтрокаСтатуса.Представление = ЗначениеСтатуса;
		НовСтрокаСтатуса.ЗначениеФильтра = ЗначениеСтатуса;
		НовСтрокаСтатуса.ТипОтбора = "СтатусАвтомобиля";
		
		Если ЗначениеСтатуса = Перечисления.CRM_СтатусыАвтомобилей.ДоставленДилеру Тогда
			//Добавим склады
			//Сначала без склада
			НовСтрокаСклад = НовСтрокаСтатуса.Строки.Добавить();
			НовСтрокаСклад.Представление = "<Склад не указан>";
			НовСтрокаСклад.ЗначениеФильтра = Справочники.СкладыКомпании.ПустаяСсылка();
			НовСтрокаСклад.ТипОтбора = "СкладДилера";
			//Потом все остальные
			Для Каждого СкладДилера Из МассивСкладовДилера Цикл
				НовСтрокаСклад = НовСтрокаСтатуса.Строки.Добавить();
				НовСтрокаСклад.Представление = СкладДилера;
				НовСтрокаСклад.ЗначениеФильтра = СкладДилера;
				НовСтрокаСклад.ТипОтбора = "СкладДилера";
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	НовСтрокаСтатуса = СтрокаВсеСтатусы.Строки.Добавить(); //Для отбора по желтым автомобилям
	НовСтрокаСтатуса.Представление = "Желтые автомобили";
	НовСтрокаСтатуса.ТипОтбора = "КартинкаЖелтыйАвтомобиль";
	НовСтрокаСтатуса.ЗначениеФильтра = Истина;
	
	НовСтрокаСтатуса = СтрокаВсеСтатусы.Строки.Добавить(); //Для отбора по отзывным нотам
	НовСтрокаСтатуса.Представление = "Отзывные ноты";
	НовСтрокаСтатуса.ТипОтбора = "VIN";
	
	СписокVIN = Новый СписокЗначений;
	СписокОТС = Renault_АвтосервисСервер.СписокОТСВСистеме(Истина, Истина);
	
	Для Каждого Строка Из СписокОТС Цикл
		СписокVIN.Добавить(Строка.VIN);
	КонецЦикла;
	НовСтрокаСтатуса.ЗначениеФильтра = СписокVIN;
	
	ЗначениеВРеквизитФормы(ДеревоФильтровСтатус, "ДеревоФильтровПоСтатусам");
	
	ДеревоФильтровМодель = РеквизитФормыВЗначение("ДеревоФильтровПоМоделям");
	ДеревоФильтровМодель.Строки.Очистить();
	
	СтрокаВсеМодели = ДеревоФильтровМодель.Строки.Добавить();
	СтрокаВсеМодели.Представление = "Все модели";
	
	МассивМоделей = ПараметрыСеанса.DMS_Бренд.МоделиАвтомобилейАвтосклад.ВыгрузитьКолонку("Модель");
	
	//Получим все версии по моделям
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ТарифНаКомплектацииАвтомобилей.Модель КАК МодельСсылка,
	               |	Renault_ТарифНаКомплектацииАвтомобилей.ВариантКомплектации КАК ВерсияСсылка,
	               |	ПОДСТРОКА(Renault_ТарифНаКомплектацииАвтомобилей.Модель.НаименованиеПолное, 0, 50) КАК МодельНаименование,
	               |	ПОДСТРОКА(Renault_ТарифНаКомплектацииАвтомобилей.ВариантКомплектации.НаименованиеПолное, 0, 100) КАК ВерсияНаименование
	               |ИЗ
	               |	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних КАК Renault_ТарифНаКомплектацииАвтомобилей
	               |ГДЕ
	               |	Renault_ТарифНаКомплектацииАвтомобилей.Модель В(&МассивМоделей)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	МодельНаименование
	               |ИТОГИ ПО
	               |	МодельСсылка";
	Запрос.УстановитьПараметр("МассивМоделей", МассивМоделей);
	ВыборкаПоМоделям = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоМоделям.Следующий() Цикл 
		
		НовСтрокаМодели	= СтрокаВсеМодели.Строки.Добавить();
		
		НовСтрокаМодели.Представление = ВыборкаПоМоделям.МодельНаименование;
		НовСтрокаМодели.ЗначениеФильтра = ВыборкаПоМоделям.МодельСсылка;
		НовСтрокаМодели.ТипОтбора = "Модель";
		
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДеревоФильтровМодель, "ДеревоФильтровПоМоделям");
	
	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоФильтровКОбработке");
	// К обработке
	ДеревоЗначений.Строки.Очистить();
	
	СтрокаВсе = ДеревоЗначений.Строки.Добавить();
	СтрокаВсе.Представление = "Все";
	СтрокаВсе.ТипОтбора = "Все";

	//отбор по Демо и подменным авто имеет свои особенности и зависит от настройки пользователя
	Если НЕ ПараметрыСеанса.Renault_ПраваПользователя.Ссылка.Автосклад_ОтображатьДемоПодменные Тогда	
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "ДемоПодменный";
		СтрокаКОбработке.ТипОтбора =  "ДемоПодменный";
	КонецЕсли;
	СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
	СтрокаКОбработке.Представление = "Автомобили моих клиентов";
	СтрокаКОбработке.ЗначениеФильтра = мТекущийПользователь.Сотрудник;	
	СтрокаКОбработке.ТипОтбора = "Менеджер";
	
	СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
	СтрокаКОбработке.Представление = "Выделенные мной автомобили";
	СтрокаКОбработке.ЗначениеФильтра = Истина;	
	СтрокаКОбработке.ТипОтбора = "СтрокаВыделена";
	
	СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
	СтрокаКОбработке.Представление = "Мои заявки на резерв";
	СтрокаКОбработке.ЗначениеФильтра = Истина;	
	СтрокаКОбработке.ТипОтбора = "ЗаявкаНаРезервТекСотрудника";
	
	СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
	СтрокаКОбработке.Представление = "Мои резервы";
	СтрокаКОбработке.ЗначениеФильтра = мТекущийПользователь.Сотрудник;	
	СтрокаКОбработке.ТипОтбора = "МенеджерРезерва";
	ЕстьПравоКорпПродажи = Истина; //??
	Если ЕстьПравоКорпПродажи Тогда
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "--------------------------";
		СтрокаКОбработке.ЗначениеФильтра = 0;
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "Резервы под корп. клиентов";
		СтрокаКОбработке.ЗначениеФильтра = Истина;	
		СтрокаКОбработке.ТипОтбора = "КорпКлиентРезерв";
		
	КонецЕсли;
	
	//ЕстьПравоАдминистрированияАвтосклад = истина;//??
	Если ЕстьПравоАдминистрированияАвтосклад Тогда
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "--------------------------";
		СтрокаКОбработке.ЗначениеФильтра = 0;
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "Резервы на рассмотрение";
		СтрокаКОбработке.ЗначениеФильтра = Истина;	
		СтрокаКОбработке.ТипОтбора = "ЗаявленРезерв";
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "Все резервы";
		СтрокаКОбработке.ЗначениеФильтра = Истина;	
		СтрокаКОбработке.ТипОтбора = "УтвержденРезерв";
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "--------------------------";
		СтрокаКОбработке.ЗначениеФильтра = 0;
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "Автомобили с измененной ценой";
		СтрокаКОбработке.ЗначениеФильтра = Истина;	
		СтрокаКОбработке.ТипОтбора = "ЦенаИзменена";
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "Автомобили с фиксированной ценой";
		СтрокаКОбработке.ЗначениеФильтра = Истина;	
		СтрокаКОбработке.ТипОтбора = "ЦенаФиксирована";

		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "Заблокированные производителем автомобили";
		СтрокаКОбработке.ЗначениеФильтра = Истина;
		СтрокаКОбработке.ТипОтбора = "Блокировка";
		
		СтрокаКОбработке = СтрокаВсе.Строки.Добавить();
		СтрокаКОбработке.Представление = "Автомобили не для продажи";
