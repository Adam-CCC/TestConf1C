/////////////////////////////////////////// Кнопка Клиентская Заявка Без VIN
&НаКлиенте
Процедура КлиентскаяЗаявкаБезVIN(Команда)
	
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДилерскийЦентр", ДилерскийЦентр);
	
	ОткрытьФормуМодально("Документ.DMS_ЗаявкаНаАвтомобиль.Форма.ФормаДокументаУпр",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте()
	
	ПараметрыОбработчика="";
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = Renault_ДлительныеОперации.ЗаданиеВыполнено(РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);
	ФормаДлительнойОперации = Renault_ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);
	
	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор Тогда
				Renault_ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		// Нужно ли так делать///////////////
		//РезультатПолученияДопИнформации =  РезультатПолученияДопИнформации;
		///////////////////////////////////
		ОбработатьРезультатВыполненияЗадания(РезультатПолученияДопИнформации,ТекущиеПараметрыВыбора );
		Иначе
		Renault_ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыполненияЗадания (РезультатПолученияДопИнформации, ТекущиеПараметрыВыбора)
	
	сОтвет = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);
	ДЦ = ТекущиеПараметрыВыбора.ДЦ;
	ТС = ТекущиеПараметрыВыбора.ТС; 
	ПараметрыФормы = Новый Структура();
	
	Если ТекущиеПараметрыВыбора.Каманда = "КлиенскаяЗаявка" Тогда
		ПараметрыФормы.Вставить("Договор",ТС.ДоговорКПСсылка);
		ПараметрыФормы.Вставить("ИдентификаторСтрокиДоговора",ТС.ИдентификаторСтрокиДоговора);	
		Если ЗначениеЗаполнено(ТС.Менеджер) Тогда
			ПараметрыФормы.Вставить("Продавец", ТС.Менеджер);
		КонецЕсли;
	ИначеЕсли ТекущиеПараметрыВыбора.Каманда = "Демо" Тогда
		Дилер = Справочники.Контрагенты.НайтиПоНаименованию(ДЦ.Наименование);
		Если Дилер = Справочники.Контрагенты.ПустаяСсылка() тогда
			Дилер = СоздатьКонтрагентаИзДилера(ДЦ);
		КонецЕсли;
		ПараметрыФормы.Вставить("Клиент",Дилер);
		ПараметрыФормы.Вставить("ТипЗаявки",Справочники.DMS_ТипыЗаявки.Демо);
	ИначеЕсли ТекущиеПараметрыВыбора.Каманда = "Подменный" Тогда
		Дилер = Справочники.Контрагенты.НайтиПоНаименованию(ДЦ.Наименование);
		Если Дилер = Справочники.Контрагенты.ПустаяСсылка() тогда
			Дилер = СоздатьКонтрагентаИзДилера(ДЦ);
		КонецЕсли;
		ПараметрыФормы.Вставить("Клиент",Дилер);
		ПараметрыФормы.Вставить("ТипЗаявки",Справочники.DMS_ТипыЗаявки.Подменный);
	КонецЕсли;
	ПараметрыФормы.Вставить("Ответ", сОтвет);
	ПараметрыФормы.Вставить("Счет",ДЦ.СчетSedre);
	ПараметрыФормы.Вставить("VIN",ТС.VIN);
	ПараметрыФормы.Вставить("Автор",ПараметрыСеанса.Пользователь);
	ПараметрыФормы.Вставить("ДилерскийЦентр",ДЦ);
	
	ОткрытьФормуМодально("Документ.DMS_ЗаявкаНаАвтомобиль.Форма.ФормаДокументаУпр",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ВыделитьДляВсехНаСервере(ТекущиеДанные)
	
	Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
	Запись.Автомобиль = ТекущиеДанные.Идентификатор;
	Запись.Прочитать();
	
	Если Запись.Выбран() И Запись.ЦветВыделенияСтрокиДляВсех <> "" Тогда
		Запись.Автомобиль = ТекущиеДанные.Идентификатор;
		Запись.ЦветВыделенияСтрокиДляВсех = "";
		ТекущиеДанные.ЦветВыделенияСтрокиДляВсех = "";
		Запись.Записать();
		Возврат Неопределено;
		
	Иначе
		Запись.Автомобиль = ТекущиеДанные.Идентификатор;
		Запись.ЦветВыделенияСтрокиДляВсех = Renault_Открытый.ЦветВСтроку(Новый Цвет(255,153,0));//Renault_Открытый.ЦветВСтроку(ЦветЖелтый);
		ТекущиеДанные.ЦветВыделенияСтрокиДляВсех = Renault_Открытый.ЦветВСтроку(Новый Цвет(255,153,0));//Renault_Открытый.ЦветВСтроку(ЦветЖелтый);
		Запись.Записать();
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыделитьДляВсех(Команда)
	
	ИмяТаблицы = ?(Элементы.Таблици.ТекущаяСтраница = Элементы.Новые,"Список","Подержанные");  //DMS
	Для каждого стр из Элементы[ИмяТаблицы].ВыделенныеСтроки Цикл
		ТекущиеДанные =Элементы[ИмяТаблицы].ДанныеСтроки(стр);
		ТекАвтомобиль = ТекущиеДанные.Автомобиль;
		
		ЦветВыдел = ВыделитьДляВсехНаСервере(ТекущиеДанные);
		Если ЦветВыдел = Неопределено Тогда
			ТекущиеДанные.ЦветВыделенияСтроки = "";
			ТекущиеДанные.СтрокаВыделена = Ложь;
		Иначе 
			ТекущиеДанные.ЦветВыделенияСтроки = Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ОсновнойЦвет);
			ТекущиеДанные.СтрокаВыделена = Истина;
		КонецЕсли;
	КонецЦикла;
	Элементы[ИмяТаблицы].Обновить();
	
КонецПроцедуры

&НаСервере
Функция  ВыделитьДляСебяНаСервере(ТекущиеДанные)
	
	Запись = РегистрыСведений.CRM_ПользовательскаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
	Запись.Автомобиль = ТекущиеДанные.Идентификатор;
	Запись.Прочитать();
	
	Если Запись.Выбран() И Запись.ЦветВыделенияСтроки <> "" Тогда
		Запись.Автомобиль = ТекущиеДанные.Идентификатор;
		Запись.ЦветВыделенияСтроки = "";
		Запись.Записать();
		Возврат Неопределено;
	Иначе
		Запись.Автомобиль = ТекущиеДанные.Идентификатор;
		Запись.ЦветВыделенияСтроки = Renault_Открытый.ЦветВСтроку(Новый Цвет(255,153,0));
		Запись.Записать();
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыделитьДляСебя(Команда)
	
	ИмяТаблицы = ?(Элементы.Таблици.ТекущаяСтраница = Элементы.Новые,"Список","Подержанные");  //DMS
	Для каждого стр из Элементы[ИмяТаблицы].ВыделенныеСтроки Цикл
		ТекущиеДанные =Элементы[ИмяТаблицы].ДанныеСтроки(стр);
		ЦветВыдел = ВыделитьДляСебяНаСервере(ТекущиеДанные);
		Если ЦветВыдел = Неопределено Тогда
			ТекущиеДанные.ЦветВыделенияСтроки = "";
			ТекущиеДанные.СтрокаВыделена = Ложь;
		Иначе 
			ТекущиеДанные.ЦветВыделенияСтроки = Renault_Открытый.ЦветВСтроку(Новый Цвет(255,153,0));
			ТекущиеДанные.СтрокаВыделена = Истина;
		КонецЕсли;
	КонецЦикла;
	Элементы[ИмяТаблицы].Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура Цвета(Команда)
	
	Форма = ПолучитьФорму("Обработка.Renault_АРМ_Автосклад_Упр.Форма.ФормаВыбораЦвета");
	Форма.ЦветДляСебя = Новый Цвет(255,153,0);
	Форма.ЦветДляВсех = Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ОсновнойЦвет);
	Структура = Форма.ОткрытьМодально();
	Если ЗначениеЗаполнено(Структура) Тогда
		ЦветДляСебя = Структура.ЦветДляСебя;
		ЦветЖелтый = Структура.ЦветДляВсех;
	КонецЕсли;
	ИзменитьЦветВыделения(Структура);
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЦветВыделения(Структура)
	
	Если Структура <> Неопределено тогда
		Для Каждого стр из Этаформа.УсловноеОформление.Элементы Цикл
			Если стр.Отбор.Элементы[0].ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ЦветВыделенияСтроки") Тогда 
				стр.Оформление.Элементы[0].Значение = Структура.ЦветДляСебя;
			ИначеЕсли стр.Отбор.Элементы[0].ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ЦветВыделенияСтрокиДляВсех") Тогда
				стр.Оформление.Элементы[0].Значение = Структура.ЦветДляВсех;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПотребностьПеремещенияНаСервере(ТекущиеДанные)
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ПеремещениеОбъект = Документы.Renault_ПотребностьПеремещения.СоздатьДокумент();
		ПеремещениеОбъект.ДилерскийЦендр = ДилерскийЦентрПользователя;
		ПеремещениеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
		ПеремещениеОбъект.ЖелаемаяДатаПеремещения = ТекущаяДата();
		ПеремещениеОбъект.Дата = ТекущаяДата();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиАвтомобилейОстатки.СкладКомпании КАК СкладКомпании
		|ПОМЕСТИТЬ ВтОстатки
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_МаршрутыПеремещений.Ссылка КАК Маршрут
		|ИЗ
		|	ВтОстатки КАК ВтОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Renault_МаршрутыПеремещений КАК Renault_МаршрутыПеремещений
		|		ПО ВтОстатки.СкладКомпании = Renault_МаршрутыПеремещений.СкладОтправитель
		|			И (НЕ Renault_МаршрутыПеремещений.ПометкаУдаления)";
		
		Запрос.УстановитьПараметр("Автомобиль", ТекущиеДанные.Автомобиль);
		
		Результат = Запрос.Выполнить();
		
		Если Не Результат.Пустой() Тогда
			ПеремещениеОбъект.Маршрут = Результат.Выгрузить()[0].Маршрут;
		КонецЕсли;
		
		АвтоСтрока = ПеремещениеОбъект.Автомобили.Добавить();
		АвтоСтрока.Автомобиль = ТекущиеДанные.Автомобиль;
		//ПеремещениеОбъект.Записать();
		Возврат ПеремещениеОбъект;
		
	Иначе
		
		Возврат "";
		
	Конецесли;
	
КонецФункции

Процедура ЗаполнитьОбновитьТаблицуПеремещений (СтрокаОтбор = Неопределено, VINАвтомобиля = "")
	
	Объект.ТаблицаПотребностей.Очистить();
	
	РезультатЗапросаПоПеремещениям = ПолучитьТаблицуПотребностейПоАвто(СтрокаОтбор, VINАвтомобиля);
	Объект.ТаблицаПотребностей.Загрузить(РезультатЗапросаПоПеремещениям);
	
КонецПроцедуры

Функция ПолучитьТаблицуПотребностейПоАвто(СтрокаОтбор = Неопределено, VINАвтомобиля = "")
	
	Если СтрокаОтбор <> Неопределено и СтрокаОтбор.СкладОтправитель <> "Не выбран" Тогда
		МаршрутЗадан = Истина;
	Иначе
		МаршрутЗадан = Ложь;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Renault_ПланПеремещения.Автомобиль КАК Автомобиль,
	|	Renault_ПланПеремещения.Автомобиль.VIN КАК VIN,
	|	Renault_ПланПеремещения.РабочийЛист КАК РабочийЛист,
	|	Renault_ПланПеремещения.СкладОтправитель КАК СкладОтправитель,
	|	Renault_ПланПеремещения.СкладПолучатель КАК СкладПолучатель,
	|	Renault_ПланПеремещения.Комментарий КАК Комментарий,
	|	Renault_ПланПеремещения.Ответственный КАК Ответственный,
	|	Renault_ПланПеремещения.ПотребностьПеремещения КАК ПотребностьПеремещения,
	|	Renault_ПланПеремещения.ДатаПлан КАК ДатаПлан,
	|	ЕСТЬNULL(ПеремещениеАвтомобилейАвтомобили.Ссылка, ЗНАЧЕНИЕ(Документ.ПеремещениеАвтомобилей.ПустаяСсылка)) КАК Перемещение
	|ПОМЕСТИТЬ ВТПеремещения
	|ИЗ
	|	РегистрСведений.Renault_ПланПеремещения КАК Renault_ПланПеремещения
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПеремещениеАвтомобилей.Автомобили КАК ПеремещениеАвтомобилейАвтомобили
	|		ПО Renault_ПланПеремещения.Автомобиль = ПеремещениеАвтомобилейАвтомобили.Автомобиль
	|			И Renault_ПланПеремещения.СкладОтправитель = ПеремещениеАвтомобилейАвтомобили.Ссылка.СкладКомпании
	|			И Renault_ПланПеремещения.СкладПолучатель = ПеремещениеАвтомобилейАвтомобили.Ссылка.СкладПолучатель
	|			И (ПеремещениеАвтомобилейАвтомобили.Ссылка.Проведен)
	|ГДЕ
	|	Renault_ПланПеремещения.ДатаПлан МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Renault_ПланПеремещения.Перемещено = ЛОЖЬ
	|	И (Renault_ПланПеремещения.Автомобиль.VIN = &VIN
	|			ИЛИ &VIN = """")"
	+?(МаршрутЗадан, 
	" И Renault_ПланПеремещения.СкладОтправитель = &СкладОтправитель
	| И Renault_ПланПеремещения.СкладПолучатель = &СкладПолучатель ","")
	+
	"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПеремещения.Автомобиль,
 	|	ВТПеремещения.VIN,
	|	ВТПеремещения.РабочийЛист,
