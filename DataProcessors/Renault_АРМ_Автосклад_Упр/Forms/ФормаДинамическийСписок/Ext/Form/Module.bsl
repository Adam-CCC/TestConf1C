&НаСервере
Процедура ЗаполнитьТекущиеМаршруты()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	""Не выбран"" КАК СкладОтправитель,
	|	""Не выбран"" КАК СкладПолучатель
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК CRM_ДилерскиеЦентры
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_ПланПеремещения.СкладОтправитель,
	|	Renault_ПланПеремещения.СкладПолучатель
	|ИЗ
	|	РегистрСведений.Renault_ПланПеремещения КАК Renault_ПланПеремещения
	|ГДЕ
	|	Renault_ПланПеремещения.ДатаПлан МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Renault_ПланПеремещения.Перемещено = ЛОЖЬ";
	Запрос.УстановитьПараметр("ДатаНачала", ПериодПеремещений.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодПеремещений.ДатаОкончания);
	
	Маршруты.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТЗ = Маршруты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПотребностьПеремещения(Команда)
	
	ИмяТаблицы = ИмяТекущейТаблицы();
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	ПеремещениеСсылка= ПотребностьПеремещенияНаСервере(ТекущиеДанные);
	Если  ПеремещениеСсылка <> "" тогда
	   ПеремещениеСсылка.ПолучитьФорму("ФормаДокумента").Открыть();
	   ЗаполнитьОбновитьТаблицуПеремещений();
	   ЗаполнитьТекущиеМаршруты();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПеремещениеНаСервере(ТекущиеДанные)
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ПеремещениеОбъект = Документы.ПеремещениеАвтомобилей.СоздатьДокумент();
		ПеремещениеОбъект.СкладКомпании = ТекущиеДанные.СкладОтправитель;
		ПеремещениеОбъект.СкладПолучатель = ТекущиеДанные.СкладПолучатель;
		ПеремещениеОбъект.Дата = ТекущаяДата();
		АвтоСтрока = ПеремещениеОбъект.Автомобили.Добавить();
		АвтоСтрока.Автомобиль = ТекущиеДанные.Автомобиль;
		АвтоСтрока.Количество = 1;
		АвтоСтрока.DMS_Место = ТекущиеДанные.ПарковочноеМесто;
		Возврат ПеремещениеОбъект;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура Перемещение(Команда)
	
	ИмяТаблицы = ИмяТекущейТаблицы();
	ТекущиеДанные = Элементы.Перемещение.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда 
		ПеремещениеСсылка= ПеремещениеНаСервере(ТекущиеДанные);
		Если  ПеремещениеСсылка <> "" тогда
			ПеремещениеСсылка.ПолучитьФорму().Открыть();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельТаблицыДанныхПоСостояниюАвтомобилейДОШоурум(Кнопка)
	
	СоздатьЗаявкуНаУстановкуДО("Шоурум");
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельТаблицыДанныхПоСостояниюАвтомобилейДОПриПокупкеАвтоПоЗН(Кнопка)
	
	СоздатьЗаявкуНаУстановкуДО("ЗН");
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельТаблицыДанныхПоСостояниюАвтомобилейДОПриПокупкеАвтоПоДоговору(Кнопка)
	
	СоздатьЗаявкуНаУстановкуДО("Договор");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаУстановкуДО(Тип = "")
	
	Если Тип = "" Тогда
		Возврат;
	КонецЕсли;

	ИмяТаблицы = ИмяТекущейТаблицы();

	Если Элементы[ИмяТаблицы].ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	доАвтомобиль = Элементы[ИмяТаблицы].ТекущиеДанные.Автомобиль;
	доДоговор = Элементы[ИмяТаблицы].ТекущиеДанные.ДоговорКПСсылка;
	доРабочийЛист = Элементы[ИмяТаблицы].ТекущиеДанные.РабочийЛист;
	доКлиент = Элементы[ИмяТаблицы].ТекущиеДанные.Клиент;
	
	Если Тип = "Шоурум" Тогда
		
		Если Не ЗначениеЗаполнено(доАвтомобиль) Тогда
			Предупреждение("Возможно только для а/м");
			Возврат;
		КонецЕсли;
		
		НоваяЗаявка = CRM_Сервер.СоздатьЗаявкуНаДополнительноеОборудование(доКлиент, доАвтомобиль);	
		НоваяЗаявка.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.ДоВШоуРум;
		НоваяЗаявка.ВидРемонта = Справочники.ВидыРемонта.КомплектацияАвтомобиля;
		НоваяЗаявка.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
		
		ФормаЗаявки = НоваяЗаявка.ПолучитьФорму("ФормаЗаявкиНаДокомлектацию");	
		ФормаЗаявки.Открыть();	
		
	ИначеЕсли Тип = "ЗН" Тогда
		
		Если Не ЗначениеЗаполнено(доАвтомобиль) ИЛИ Не ЗначениеЗаполнено(доДоговор) Тогда
			Предупреждение("Возможно только для законтрактованных а/м");
			Возврат;
		КонецЕсли;
		
		Если доДоговор.СтатусДоговора<>Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан Тогда
			Если доДоговор.СтатусОкончательныхДокументов<>Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан Тогда 
				Если доДоговор.СтатусПредварительныхДокументов<>Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан Тогда 
			        Предупреждение("Возможно только для а/м с наличием подписанного договора");
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		НоваяЗаявка = CRM_Сервер.СоздатьЗаявкуНаДополнительноеОборудование(доКлиент, доАвтомобиль);	
		НоваяЗаявка.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.ДоПриПродажеПоЗаказНаряду;
		НоваяЗаявка.ВидРемонта = Справочники.ВидыРемонта.КомплектацияАвтомобиля;
		НоваяЗаявка.ДоговорНаПродажуАвтомобиля = доДоговор;
		НоваяЗаявка.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
		
		ФормаЗаявки = НоваяЗаявка.ПолучитьФорму("ФормаЗаявкиНаДокомлектацию");	
		ФормаЗаявки.Открыть();
		
	ИначеЕсли Тип = "Договор" Тогда
		
		Если Не ЗначениеЗаполнено(доАвтомобиль) ИЛИ Не ЗначениеЗаполнено(доДоговор) Тогда			
			Предупреждение("Возможно только для законтрактованных а/м");
			Возврат;			
		КонецЕсли;
		

		Если доДоговор.СтатусДоговора<>Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан Тогда
			Если доДоговор.СтатусОкончательныхДокументов<>Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан Тогда 
				Если доДоговор.СтатусПредварительныхДокументов<>Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан Тогда 
			        Предупреждение("Возможно только для а/м с наличием подписанного договора");
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		НоваяЗаявка = CRM_Сервер.СоздатьЗаявкуНаДополнительноеОборудование(доКлиент, доАвтомобиль);
		НоваяЗаявка.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.ДоПриПродажеПоДоговору;
		НоваяЗаявка.ВидРемонта = Справочники.ВидыРемонта.ДополнительноеОборудование;
		НоваяЗаявка.ДоговорНаПродажуАвтомобиля = доДоговор;
		НоваяЗаявка.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
		
		ФормаЗаявки = НоваяЗаявка.ПолучитьФорму("ФормаЗаявкиНаДокомлектацию");
		ФормаЗаявки.Открыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельТаблицыДанныхПоСостояниюАвтомобилейПринятьАвтоНаСклад(Кнопка)
	
	Если ЭтаФорма.Элементы.Список.ТекущиеДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Если ПараметрыСеанса.Renault_ПраваПользователя.Автосклад_ПравоПриемкиАвтоНаСклад Тогда
		ФормаОтметки = Обработки.Renault_АРМ_ВыдачаАвтомобилей.ПолучитьФорму("ФормаОтметкиПриемкиАвто");
		ФормаОтметки.Автомобиль = ЭтаФорма.Элементы.Список.ТекущиеДанные.Автомобиль;
		ФормаОтметки.ОткрытьМодально();
	Иначе
		Предупреждение("Вам недоступно право приемки автомобиля на склад");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПечатьЦенниковБУНаСервере(ТабДок, МассивСтрок)
	
	Макет = Обработки.Renault_АРМ_Автосклад_Упр.ПолучитьМакет("ЦенникПоТрейдИн");
	
	ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
	
	Для Каждого Стр Из МассивСтрок Цикл
		
		ОбластьШапки.Параметры.МаркаМодель = ""+Стр.ПроизводительКод + " "+Стр.Автомобиль.Модель; 
		ОбластьШапки.Параметры.Версия      = Стр.Автомобиль.ВариантКомплектации;
		ОбластьШапки.Параметры.ГодВыпуска  = Формат(Стр.Автомобиль.ГодВыпуска,"ДФ=yyyy");
		ОбластьШапки.Параметры.Пробег      = ""+Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Стр.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег) + "км";
		ОбластьШапки.Параметры.КоличествоВладельцев = Стр.КоличествоВладельцевПоПТС;
		
		ТабДок.Вывести(ОбластьШапки);
		
		ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьСтрока");
		
		тзОпцииАвтомобиля = ПолучитьОпцииАвтомобиля(Стр.Заявка);
		
		Оборудование = "";
		
		Для Каждого Комплектация Из тзОпцииАвтомобиля Цикл
			
			Оборудование = Оборудование+"- "+Комплектация.Опция+Символы.ПС;
			
		КонецЦикла;
		
		ОбластьСтрока.Параметры.Оборудование = Оборудование;
		ТабДок.Вывести(ОбластьСтрока);
		
		КредитноеПредложениеПоУмолчанию = ДанныеКредитногоПредложенияПоУмолчанию(Стр.Автомобиль);
		Подвал = Макет.ПолучитьОбласть("Подвал");
		
		Если ЗначениеЗаполнено(КредитноеПредложениеПоУмолчанию) Тогда
			КредитныеСтавки = КредитноеПредложениеПоУмолчанию.КредитныеСтавки[0];
			Подвал.Параметры.Ставка = ""+КредитныеСтавки.МаркетинговаяСтавка+"% в месяц''";
			Подвал.Параметры.Платеж = Формат((Стр.ОриентировочнаяЦена-Стр.ОриентировочнаяЦена/100*КредитноеПредложениеПоУмолчанию.ПервоначальныйВзносПоУмолчанию)/100*КредитныеСтавки.МаркетинговаяСтавка,"ЧДЦ=")+ " руб./мес.";
			Подвал.Параметры.СрокКредита = ""+КредитноеПредложениеПоУмолчанию.СрокПоУмолчанию +" месяцев";
			Подвал.Параметры.ПервоначальныйВзнос = Формат(Стр.ОриентировочнаяЦена/100*КредитноеПредложениеПоУмолчанию.ПервоначальныйВзносПоУмолчанию,"ЧДЦ=")+ " руб.";
		КонецЕсли;
		
		Подвал.Параметры.Цена = ""+Стр.ОриентировочнаяЦена + " руб.";
		Подвал.Параметры.КонецПериода = Формат(КонецМесяца(ТекущаяДата()),"ДЛФ=D")+"г.";
		
		ТабДок.Вывести(Подвал);
		ТабДок.АвтоМасштаб = Истина; 
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОпцииАвтомобиля(ЗаявкаНаТрейдИнСсылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаНаТрейдИнСсылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Опции.Опция.Наименование КАК Опция
		|ИЗ
		|	Документ.Renault_ЗаявкаНаТрейдИн.Опции КАК Опции
		|ГДЕ
		|	Опции.Выбрана
		|	И Опции.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Опция
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;
	
КонецФункции

&НаСервере
Функция ДанныеКредитногоПредложенияПоУмолчанию(Автомобиль)
	
	КредитноеПредложение = Справочники.Renault_КредитныеПредложения.ОптимальноеКредитноеПредложение("", Автомобиль, Автомобиль.ВариантКомплектации);
	
	Если Не ЗначениеЗаполнено(КредитноеПредложение) Тогда
		КредитноеПредложение = Справочники.Renault_КредитныеПредложения.ОптимальноеКредитноеПредложение("", Автомобиль); 
	КонецЕсли;
		
	Возврат КредитноеПредложение;
	
КонецФункции

&НаКлиенте
Процедура ПечатьЦенниковБУ(Команда)
	
	ТабДок = Новый ТабличныйДокумент;
	МассивСтрок = Новый Массив;
	Для Каждого Стр Из Элементы.Подержанные.ВыделенныеСтроки Цикл
		МассивСтрок.Добавить(Элементы.Подержанные.ДанныеСтроки(стр));
	КонецЦикла;
	
	ПечатьЦенниковБУНаСервере(ТабДок,МассивСтрок);
	ТабДок.Показать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПечаитьЦенниковНаНовые(Команда)
	
	ИмяТаблицы = ИмяТекущейТаблицы();
	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПечатьЦенников = Обработки.Renault_ПечатьЦенников.Создать();
	ПечатьЦенников.Автомобиль = ТекущиеДанные.Автомобиль;
	ПечатьЦенников.ПолучитьФорму(,ЭтаФорма).Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Припарковать(Команда)
	
	ИмяТаблицы = ИмяТекущейТаблицы();
	
	Если ИмяТаблицы = "Список" Тогда
		ТекСтрока = Элементы.Список.ТекущиеДанные;
		Таблица = "Новые"
	ИначеЕсли ИмяТаблицы = "Перемещение" Тогда
		ТекСтрока = Элементы.Перемещение.ТекущиеДанные;
		Таблица = "Перемещение";
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТекСтрока <> Неопределено Тогда
		
		ПараметрыОтбора = Новый Структура;
		
		Если Таблица = "Новые" Тогда
			ПараметрыОтбора.Вставить("Склад", ТекСтрока.СкладДилера);
		Иначе
			Если ЗначениеЗаполнено(ТекСтрока.Перемещение) Тогда
				ПараметрыОтбора.Вставить("Склад", ТекСтрока.СкладПолучатель);
			Иначе
				ПараметрыОтбора.Вставить("Склад", ТекСтрока.СкладОтправитель);
			КонецЕсли;
		КонецЕсли;
		
		Если  ПараметрыОтбора.Склад = Неопределено Тогда
			ОчиститьСообщения();
			Сообщить("Данный автомобиль находится не на складе дилера, невозможно препарковать.");
			Возврат;
		КонецЕсли;
		
		ПараметрыОтбора.Вставить("Автомобиль", ТекСтрока.Автомобиль);
		ПараметрыОтбора.Вставить("ТолькоСвободные",Истина);
		ОткрытьФорму("РегистрСведений.Renault_РазмещениеАвтомобилей.Форма.ФормаВыбораПарковочногоМеста", Новый Структура("ПараметрыОтбора", ПараметрыОтбора));
		
	Иначе
		Сообщить("Выберите строку");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсвободитьМесто(Команда)
	
	ИмяТаблицы = ИмяТекущейТаблицы();
	
	Если ИмяТаблицы = "Список" Тогда
		ТекСтрока = Элементы.Список.ТекущиеДанные;
		Таблица = "Новые"
	ИначеЕсли ИмяТаблицы = "Перемещение" Тогда
		ТекСтрока = Элементы.Перемещение.ТекущиеДанные;
		Таблица = "Перемещение";
	Иначе
		Возврат;
	КонецЕсли;
	Если ТекСтрока <> Неопределено Тогда
		Если НЕ РегистрыСведений.Renault_РазмещениеАвтомобилей.ОсвободитьПарковочноеМесто(ТекСтрока.Автомобиль) Тогда
			Сообщить("Не удалось очистить парковочное место автомобиля " + ТекСтрока.Автомобиль);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Информация(Команда)
	
	ФормаПомощь = Обработки.Renault_АРМ_Автосклад_Упр.ПолучитьФорму("ФормаПомощьУпр");
	ФормаПомощь.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодержанныеПриАктивизацииСтроки(Элемент)
	
	Запись = Элементы.Подержанные.ТекущиеДанные;
	Если Запись <> неопределено Тогда
		
		дс_Автомобиль = Запись.Автомобиль;
		дс_ТипАвтомобиля = Запись.ТипАвтомобиля;
		
		//Оплаты и пр.		
		дс_ДополнительныеЗатратыПоАвто = Запись.ДополнительныеЗатратыПоАвто;
		
		дс_Вин = Запись.VIN;
		
		дс_Модель = Запись.МодельНаименованиеПолное;
		дс_Версия = Запись.ВерсияНаименованиеПолное;
		дс_Цвет = Запись.ЦветНаименование;
		Дс_СоставОпций = "";
		
		дс_КодМодели = Запись.МодельАртикул;
		дс_КодВерсии = Запись.ВерсияАртикул;
		дс_КодЦвета = Запись.ЦветАртикул;
		
		Если Запись.ГодВыпуска = 0 Тогда
			дс_ГодВыпуска = "";
		Иначе
			дс_ГодВыпуска = СтрЗаменить(Строка(Запись.ГодВыпуска), Символ(160), "");
			дс_ГодВыпуска = дс_ГодВыпуска + " г.в.";
		КонецЕсли;
		дс_НаименованиеАвтомобиля = дс_Модель + " " + дс_Версия + " " + дс_Цвет + " " + дс_ГодВыпуска;
		
		дс_Комментарий = Запись.Примечание;
		
		дс_ОплатаАФМСогласована = Запись.ОплатаАФМСогласована;
		дс_ДатаОплатыАФМ = Запись.ПлановаяДатаОплатыАФМ;
		дс_ОплатаАФМОплачено = Запись.АвтоОплаченАФМ;
		дс_ПричинаВыкупа = Запись.ПричинаВыкупа;
		
		дс_ОплатаКлиентАвансВнесен = Запись.КлиентВнесАванс;
		дс_ОплатаКлиентПолностьюОплачено = Запись.КлиентПолностьюОплатилАвто;
		дс_ПлановаяДатаПолнойОплатыКлиентом = Запись.ПлановаяДатаПолнойОплатыКлиентом;
		
		///Статусы
		ЗакрепленоЗаКлиентомПоДаннымАФМ = (Запись.ЗакрепленоЗаКлиентомВDistri = Истина);			
		ЗакрепленоЗаКлиентом = Запись.УтвержденРезерв ИЛИ Запись.ПодписанДоговорКП;		
		ЗакрепленоЗаМенеджером = Запись.УтвержденРезерв;
		ЗаявкаНаРезервМенеджера = Запись.ЗаявленРезерв;
		
		дс_Клиент = Запись.Клиент;
		дс_РабочийЛист = Запись.РабочийЛист;
		дс_ФИОКлиента = "";
		дс_ТелефонКлиента = "";
		дс_EmailКлиента = "";
		дс_ДоговорКП = Запись.ДоговорКПСсылка;
		дс_ИдентификаторСтрокиДоговора = Запись.ИдентификаторСтрокиДоговора;
		
		Если ЗначениеЗаполнено(Запись.Менеджер) Тогда
			Элементы.Группа210.ТекущаяСтраница = Элементы.Группа211;
			ПодержанныеМенеджер = Строка(Запись.Менеджер);
		Иначе
			Элементы.Группа210.ТекущаяСтраница = Элементы.Группа212;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Запись.Клиент) Тогда
			Элементы.Группа207.ТекущаяСтраница = Элементы.Группа208;
		Иначе
			Элементы.Группа207.ТекущаяСтраница = Элементы.Группа209;
		КонецЕсли;
		
		Если ЗаявкаНаРезервМенеджера  Тогда
			Элементы.Группа213.ТекущаяСтраница = Элементы.Группа214;
		ИначеЕсли ЗакрепленоЗаМенеджером Тогда
			Элементы.Группа213.ТекущаяСтраница = Элементы.Группа215;
		Иначе
			Элементы.Группа213.ТекущаяСтраница = Элементы.Группа216;
		КонецЕсли;
		
		// страница "Distri.net"	
		дс_НомерКлиентскойЗаявки = Запись.НомерЗаявкиDistri;
		дс_НомерОрдераSedre = Запись.НомерЗаказаDistri;
		дс_ПродажаВнесенаВSedre = Запись.ПродажаВнесенаВDistri;
		
