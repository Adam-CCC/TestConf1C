		дс_ПТС_НомерКузова = Таблици.дс_ПТС_НомерКузова;
		дс_ПТС_ЦветКузова = Таблици.дс_ПТС_ЦветКузова;
		дс_ПТС_РазрМаксМасса = Таблици.дс_ПТС_РазрМаксМасса;
		дс_ПТС_МассаБезНагрузки = Таблици.дс_ПТС_МассаБезНагрузки;
		дс_ПТС_МощностьДвигателя = Таблици.дс_ПТС_МощностьДвигателя;
		дс_ПТС_ОбъемДвигателя = Таблици.дс_ПТС_ОбъемДвигателя;
		дс_ПТС_ТипДвигателя = Таблици.дс_ПТС_ТипДвигателя;
		дс_ПТС_ЭкКлассДвигателя = Таблици.дс_ПТС_ЭкКлассДвигателя;
		дс_ПТС_Изготовитель = Таблици.дс_ПТС_Изготовитель;
		дс_ПТС_ОдобрениеТипаТС = Таблици.дс_ПТС_ОдобрениеТипаТС; 		
		дс_ПТС_Оттенок = Таблици.дс_ПТС_Оттенок; 
		
        //Транспортировка
		//Данные берем напрямую из регистра, чтобы не хранить их в таблице
		
		дс_ПланДатаОтгрузки = Таблици.дс_ПланДатаОтгрузки;
		дс_ФактДатаОтгрузки = Таблици.дс_ФактДатаОтгрузки;
		дс_Субтранспортер = Таблици.дс_Субтранспортер;
		дс_ТранспортнаяКомпания = Таблици.дс_ТранспортнаяКомпания;
		дс_НазначениеДоставки = Таблици.дс_НазначениеДоставки;
