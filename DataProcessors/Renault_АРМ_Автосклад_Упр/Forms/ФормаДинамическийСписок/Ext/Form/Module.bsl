&НаКлиенте
Процедура ДеревоФильтровКОбработкеПриАктивизацииСтроки(Элемент)
	
	ТекущаяТаблица = ИмяТекущейТаблицы();
	Этаформа[ТекущаяТаблица].Отбор.Элементы.Очистить();
	ОтборСписка = Элементы.ДеревоФильтровКОбработке.ТекущиеДанные.ТипОтбора;
	ЭлементОтбора = Этаформа[ТекущаяТаблица].Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ПравоеЗначение = Элементы.ДеревоФильтровКОбработке.ТекущиеДанные.ЗначениеФильтра;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ОтборСписка);
	Если ТипЗнч(Элементы.ДеревоФильтровКОбработке.ТекущиеДанные.ЗначениеФильтра) = Тип("СписокЗначений") Тогда 
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Иначе
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	КонецЕсли;

	ЭлементОтбора.Использование = Истина;
	Если ОтборСписка = "ДемоПодменный" Тогда 
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДемоПодменный");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Истина;
	ИначеЕсли ОтборСписка = "Менеджер" или ОтборСписка = "МенеджерРезерва" Тогда 
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ОтборСписка);
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ИначеЕсли ОтборСписка = "СтрокаВыделена" Тогда 
		
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЦветВыделенияСтроки");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
	ИначеЕсли ОтборСписка = "ЗаявкаНаРезервТекСотрудника" Тогда 
		
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЗаявкаНаРезервТекСотрудника");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
	ИначеЕсли ОтборСписка = "ДатаПерепродажи" Тогда
			  ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ИначеЕсли ОтборСписка = "ЖелтыеАвтомобили" Тогда
				ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
				Если ТипЗнч(Элементы.ДеревоФильтровКОбработке.ТекущиеДанные.ЗначениеФильтра) = Тип("СписокЗначений") Тогда 
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				КонецЕсли;
		
	ИначеЕсли ОтборСписка = "Все" Тогда
		Этаформа[ТекущаяТаблица].Отбор.Элементы.Очистить();
	КонецЕсли;
	
КонецПроцедуры

