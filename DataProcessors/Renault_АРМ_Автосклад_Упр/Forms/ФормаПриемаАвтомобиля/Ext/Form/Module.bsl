
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТаблицаАвтомобилей") Тогда
		Для Каждого СтрТз из Параметры.ТаблицаАвтомобилей Цикл
			
			СтрСписок = СписокАвтомобилей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрСписок, СтрТз);
			СтрСписок.СмогуВыдат = Истина;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокВыборка ()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПричиныНеВыдачи.Ссылка
	|ИЗ
	|	Справочник.Renault_ПричиныНеВыдачи КАК Renault_ПричиныНеВыдачи
	|ГДЕ
	|	Renault_ПричиныНеВыдачи.Активный";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаКлиенте
Процедура СписокАвтомобилейПричинаНеВыдачиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	мПричинНеВыдачи = ПолучитьСписокВыборка ();
	Элемент.СписокВыбора.Очистить();
	Элемент.СписокВыбора.ЗагрузитьЗначения(мПричинНеВыдачи);
КонецПроцедуры

&НаКлиенте
Процедура СписокАвтомобилейПричинаНеВыдачиПриИзменении(Элемент)
	ТекСтрока = Элементы.СписокАвтомобилей.ТекущиеДанные;
	УстановитьСостояниеКолонокПриИзменении (ТекСтрока, "ПричинаНеВыдачи");
КонецПроцедуры

&НаКлиенте
Процедура СписокАвтомобилейСмогуВыдатПриИзменении(Элемент)
	ТекСтрока = Элементы.СписокАвтомобилей.ТекущиеДанные;
	УстановитьСостояниеКолонокПриИзменении (ТекСтрока, "СмогуВыдат");
КонецПроцедуры

&НаКлиенте
Процедура СписокАвтомобилейПВРПриИзменении(Элемент)
	ТекСтрока = Элементы.СписокАвтомобилей.ТекущиеДанные;
	УстановитьСостояниеКолонокПриИзменении (ТекСтрока, "ПВР");
КонецПроцедуры

&НаКлиенте
Процедура СписокАвтомобилейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СписокАвтомобилейПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСостояниеКолонокПриИзменении (ТекСтрока, КолонкаИзменения)
	Если ЗначениеЗаполнено(ТекСтрока.ПричинаНеВыдачи) и КолонкаИзменения = "ПричинаНеВыдачи" Тогда
		ТекСтрока.СмогуВыдат = Ложь;
		ТекСтрока.ПВР = Ложь;
	ИначеЕсли ТекСтрока.ПВР и КолонкаИзменения = "ПВР" Тогда
		ТекСтрока.СмогуВыдат = Ложь;
		ТекСтрока.ПричинаНеВыдачи = ПредопределенноеЗначение("Справочник.Renault_ПричиныНеВыдачи.ПустаяСсылка");
	ИначеЕсли ТекСтрока.СмогуВыдат и КолонкаИзменения = "СмогуВыдат" Тогда
		ТекСтрока.ПВР = Ложь;
		ТекСтрока.ПричинаНеВыдачи = ПредопределенноеЗначение("Справочник.Renault_ПричиныНеВыдачи.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура СохранитьНаСервере(Ошибка)
	Для Каждого СтрСписка из СписокАвтомобилей Цикл
		
		Если СтрСписка.СмогуВыдат тогда
			Продолжить;
		КонецЕсли;
		другое = Справочники.Renault_ПричиныНеВыдачи.НайтиПоРеквизиту("ЦентралныйКод", "251e9ca4-414e-11e8-9de6-00155d001800");
		
		Если СтрСписка.ПричинаНеВыдачи = другое и Не ЗначениеЗаполнено(СтрСписка.Комментарий) Тогда
			Сообщить("Для VIN "+СтрСписка.VIN+" указана причина невозможности выдачи " + Строка(СтрСписка.ПричинаНеВыдачи) + ", но не комментарий.");
			Ошибка = Истина;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрСписка.ПричинаНеВыдачи) и не ЗначениеЗаполнено(СтрСписка.днейнаустранение) Тогда
			Сообщить("Для VIN "+СтрСписка.VIN+" указана причина невозможности выдачи " + Строка(СтрСписка.ПричинаНеВыдачи) + ", но не количество дней на устранение причины.");
			Ошибка = Истина;
		КонецЕсли;
		
		Если не ЗначениеЗаполнено(СтрСписка.ПричинаНеВыдачи) и не СтрСписка.ПВР Тогда
			Сообщить("Для VIN "+СтрСписка.VIN+" не указана причина невозможности выдачи");
			Ошибка = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если не Ошибка Тогда
		Для Каждого СтрСписка из СписокАвтомобилей Цикл
			Менеджер = РегистрыСведений.Renault_СтатусыВыдачиАвто.СоздатьМенеджерЗаписи();
			Менеджер.vin = СтрСписка.VIN;
			Менеджер.ПричинаНеВыдачи = СтрСписка.ПричинаНеВыдачи;
			Менеджер.ДнейНаУстранение = СтрСписка.днейнаустранение;
			Менеджер.ДатаПриемаАвто = ТекущаяДата();
			Менеджер.ПВР = СтрСписка.ПВР;
			Менеджер.Комментарий = СтрСписка.Комментарий;
			Менеджер.Сотрудник = ПараметрыСеанса.Пользователь;
			Менеджер.Записать();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура Сохранить(Команда)
	Закрыть(Истина);
КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	БылаОшибка = Ложь; 
	СохранитьНаСервере(БылаОшибка);
	Если БылаОшибка Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

