		Строка.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ТекАвто , Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
		Если обЗначениеНеЗаполнено(Строка.ГосНомер) Тогда
			Строка.ГосНомер = "Б/Н";
		КонецЕсли; 
		Строка.Марка = ТекАвто.Модель.Марка;
		Строка.Модель = ТекАвто.Модель;
		Строка.Пробег = ТекЗН.Пробег;
		Если ТекЗаказчик.ФормаСобственности=Перечисления.ФормыСобственности.ЧастноеЛицо ИЛИ ТекЗаказчик.ФормаСобственности=Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
			Строка.ТипВладельца="ФЛ";
		Иначе
			Строка.ТипВладельца="ЮЛ";
		КонецЕсли; 
		Строка.КонтактноеЛицо = ТекЗаказчик;
		Строка.ТелефонКонтактногоЛица = Прав(ТекЗаказчик.ОсновнойТелефон,10);
		Строка.ДатаОбращения = ТекДатаЗН;
		
		Попытка
			Строка.ПричинаОбращения = ТекЗН.Работы[0].Работа;
		Исключение
			Строка.ПричинаОбращения = ТекЗН.ПричинаОбращения;
		КонецПопытки; 
		Строка.ДатаСозданияЗН     = ТекДатаЗН;
		Строка.ДатаНачалаРабот    = ТекДатаЗН;
		Строка.ДатаОкончанияРабот = ТекДатаЗН;
		Строка.ДатаЗакрытия       = ТекДатаЗН;
		
		Строка.ДобраяВоля         = "НЕТ";
		Строка.ТО                 = "НЕТ";
		Строка.СервиснаяКомпания  = "НЕТ";
		Строка.КузовнойРемонт     = "НЕТ";
		Строка.СлесарныйРемонт 	 = "НЕТ";
		Строка.Акция 	         = "НЕТ";
		
		Строка.ТипРемонта="Коммерческий";	
		
		Если ТекЗН.ВидРемонта = ГарантияПроизводителя ИЛИ ТекЗН.ВидРемонта = ГарантияПроизводителяЛКП ИЛИ ТекЗН.ВидРемонта = ГарантияДистрибьютера Тогда
			Строка.ТипРемонта="Гарантийный";	
		КонецЕсли; 
		
	КонецЦикла;
	
	//=========================== 2 часть ===
	
	ТекстЗН = Новый ТекстовыйДокумент; 
	
	ТекстЗН.ДобавитьСтроку( "Дилер;код дилера;Номер заказ-наряда;ФИО владельца;Телефон владельца;VIN номер автомобиля;Гос.номер автомобиля;Марка автомобиля;Модель автомобиля;Пробег (км);Тип владельца;Контактное лицо;Телефон контактного лица;Дата обращения клиента;причина обращения;Дата содания заказ-наряда;Дата начала работ;Дата окончания работ;Дата закрытия заказ-наряда;Тип ремонта;Вид ремонта;;;;;" );
	ТекстЗН.ДобавитьСтроку( ";;;;;;;;;;;;;;;;;;;;ТО;Сервисная кампания;Гудвилл;Слесарный ремонт;Кузовной ремонт;Акция" );
	
	Для каждого Строка Из Состав Цикл
		ТекстЗН.ДобавитьСтроку(Строка.Дилер + ";"+
		Строка.КодДилера + ";"+
		Строка.Номер + ";"+
		Строка.ФИОВладельца + ";"+
		Строка.ТелефонВладельца + ";"+
		Строка.VIN + ";"+
		Строка.ГосНомер + ";"+
		Строка.Марка + ";"+
		Строка.Модель + ";"+
		Строка.Пробег + ";"+
		Строка.ТипВладельца + ";"+
		Строка.КонтактноеЛицо + ";"+
		Строка.ТелефонКонтактногоЛица + ";"+
		Сред(Строка.ДатаОбращения,1,10) + ";"+
		Строка.ПричинаОбращения + ";"+
		Сред(Строка.ДатаСозданияЗН,1,10) + ";"+
		Сред(Строка.ДатаНачалаРабот,1,10) + ";"+
		Сред(Строка.ДатаОкончанияРабот,1,10) + ";"+
		Сред(Строка.ДатаЗакрытия,1,10) + ";"+
		Строка.ТипРемонта+ ";"+
		Строка.ТО + ";"+
		Строка.СервиснаяКомпания + ";"+
		Строка.ДобраяВоля + ";"+
		Строка.СлесарныйРемонт + ";"+
		Строка.КузовнойРемонт + ";"+
		Строка.Акция); 
	КонецЦикла;
	
	Попытка
	   	ТекстЗН.Записать(ИмяФайла); 
 	Исключение
		//Сообщить("ОШИБКА! Не удалось записать файл с заголовками заказ-нарядов "+ИмяФайлаСработами);	
	КонецПопытки; 
 	
	ТекстСРаботами = Новый ТекстовыйДокумент;
	ТекстСРаботами.ДобавитьСтроку("Номер заказ-наряда;Тип позиции;Номер позиции;Код позиции;номера заказа з/ч;Наименование позиции;Количество;Итоговая стоимость;Расширение заказ-наряда;В наличии");
	Для каждого Строка Из РаботыЗН Цикл
		ТекстСРаботами.ДобавитьСтроку(Строка.Номер + ";"+
		Строка.ТипПозиции + ";"+
		Строка.НомерПозиции + ";"+
		Строка.КодПозиции + ";"+
		" " + ";"+
		Строка.НаименованиеПозиции + ";"+
		Строка.Количество + ";"+
		Строка.ИтоговаяСтоимость + ";"+
		Строка.РасширениеЗН + ";"+
		Строка.Вналичии); 
	КонецЦикла;
	Попытка
	   	ТекстСРаботами.Записать(ИмяФайлаСработами); 
 	Исключение
		//Сообщить("ОШИБКА! Не удалось записать файл с работами заказ-нарядов");	
	КонецПопытки; 
 		

	//=========================== 3 часть ===
	
	Если Состав.Количество()+РаботыЗН.Количество() > 0 Тогда
		
		//Режим = РежимДиалогаВопрос.ДаНет;
		//Ответ = Вопрос("Выгружать заказ-наряды на портал CHERY ?", Режим, 5,КодВозвратаДиалога.Нет);
		//
		//Если Ответ = КодВозвратаДиалога.Нет Тогда
		//	
		//	Возврат;
		//	
		//Иначе
			
		ДвоичныеДанныеЗН=Новый ДвоичныеДанные(ИмяФайла);
        АдресВХ_ЗН = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЗН);
			
		ДвоичныеДанныеРабот=Новый ДвоичныеДанные(ИмяФайлаСРаботами);
        АдресВХ_Работ = ПоместитьВоВременноеХранилище(ДвоичныеДанныеРабот);

		СМ_CHERY.ВыгрузкаНаПорталЧери(АдресВХ_ЗН,АдресВХ_Работ);	
			
		//КонецЕсли;
		
  	КонецЕсли; 
  	 
