	|	Дата,
	|	Номер";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДата()-24*3600));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата()-24*3600));
