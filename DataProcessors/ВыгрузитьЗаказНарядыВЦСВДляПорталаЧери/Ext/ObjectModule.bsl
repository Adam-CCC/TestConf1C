	//=========================== 1 часть ===
 	
 	ГарантияПроизводителя          = Справочники.ВидыРемонта.ГарантияПроизводителя;
	ГарантияПроизводителяЛКП       = Справочники.ВидыРемонта.ГарантияПроизводителяЛКП;
	ГарантияДистрибьютера          = Справочники.ВидыРемонта.ГарантияДистирибьютера;

	
	СзВидРемонта = Новый СписокЗначений;
 	СзВидРемонта.Добавить(ГарантияПроизводителя);
	СзВидРемонта.Добавить(ГарантияПроизводителяЛКП);
	СзВидРемонта.Добавить(ГарантияДистрибьютера);
 	
	сч = 0;
	
