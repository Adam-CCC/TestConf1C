Функция ПолучитьСписокАвтоОстатков(СписокПодразделений)
	
	СписокАвто = Новый СписокЗначений;
	ТаблицаАвто = ПолучитьТаблицуАвто();
 	
	СписокПодразделений = ПолучитьПолныйСписокПодразделений(СписокПодразделений);
	
	Для каждого Стр Из ТаблицаАвто Цикл
 		Если СписокПодразделений.НайтиПоЗначению(Стр.Подразделение) = Неопределено  Тогда
			Продолжить;				
		КонецЕсли;
		Если СписокАвто.НайтиПоЗначению(Стр.Автомобиль) <> Неопределено Тогда
			Продолжить;				                                                                    	
		КонецЕсли;
		Если НЕ ЭтоНовыйАвтомобиль(Стр.Автомобиль) Тогда
			Продолжить;				                                                                    					
		КонецЕсли;
		Если Стр.Автомобиль.Модель.Марка <> Справочники.Марка.HYUNDAI Тогда
			Продолжить;				                                                                    								
 		КонецЕсли;
		СписокАвто.Добавить(Стр.Автомобиль);
	КонецЦикла;
	
	Возврат СписокАвто;
	
КонецФункции // СписокАвтоОстатковИзаказов(ТаблицаВыгрузкиПолная)
 
Функция ПолучитьПолныйСписокПодразделений(ИсхСписок)
	
	ПолныйСписокПодразделений = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка,
	|	ПодразделенияКомпании.Родитель.Ссылка
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	(ПодразделенияКомпании.Родитель В (&ИсхСписок)
	|			ИЛИ ПодразделенияКомпании.Ссылка В (&ИсхСписок))";
	
	Запрос.УстановитьПараметр("ИсхСписок", ИсхСписок);
	
	ПолныйСписокПодразделений.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат ПолныйСписокПодразделений;
	
КонецФункции

Функция ПолучитьТаблицуАвто()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиАвтомобилейОстатки.Автомобиль,
	|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение КАК Подразделение
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗначенияСвойствОбъектов.Объект КАК Объект
	|		ИЗ
	|			РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|		ГДЕ
	|			ЗначенияСвойствОбъектов.Объект ССЫЛКА Справочник.Автомобили
	|			И ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ИспользоватьДляТестДрайва)
	|			И ЗначенияСвойствОбъектов.Значение = ИСТИНА) КАК АвтоТестДрайва
	|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = АвтоТестДрайва.Объект
	|ГДЕ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
	|	И АвтоТестДрайва.Объект ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАвтомобилейОстатки.Автомобиль,
	|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение"; 
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;
	
КонецФункции // ПолучитьТаблицуАвто(СписокАвто)

Функция СформироватьСтруктуруАвто(ТекАвто,ЛичныйКабинет)

		СтруктураАвто = Новый Структура;
		СтруктураАвто.Вставить("vin",СокрЛП(ТекАвто.VIN));
  		СтруктураАвто.Вставить("name",СокрЛП(СтрЗаменить(ВРЕГ(ТекАвто.Модель.Наименование),ВРЕГ(ТекАвто.Модель.Марка.Наименование),"")));
 		СтруктураАвто.Вставить("code",СокрЛП(ТекАвто.ВариантКомплектации.Артикул));
		СтруктураАвто.Вставить("codeColor",СокрЛП(ТекАвто.Цвет.Артикул));
		СтруктураАвто.Вставить("codeCover",СокрЛП(ТекАвто.ЦветСалонаАвтомобиля.Артикул));                     //код обивки салона (стока);
 		СтруктураАвто.Вставить("year",СокрЛП(Формат(ТекАвто.ГодВыпуска,"ДФ=yyyy")));
		
		ЦенаАвто = ПолучитьЦенуАвто(ТекАвто);
		
		СтруктураАвто.Вставить("price",  Число(СокрЛП(СтрЗаменить(ЦенаАвто,Символы.НПП,""))));  
        СтруктураАвто.Вставить("special", Число(СокрЛП(СтрЗаменить(ТекАвто.СпециальнаяЦена,Символы.НПП,""))));  
		СтруктураАвто.Вставить("credit", Число(СокрЛП(СтрЗаменить(ЦенаАвто,Символы.НПП,""))));  
        СтруктураАвто.Вставить("discountCredit", Число(СокрЛП(СтрЗаменить(ТекАвто.СкидкаПриПокупкеВКредит,Символы.НПП,""))));  
        СтруктураАвто.Вставить("discountTradein",Число(СокрЛП(СтрЗаменить(ТекАвто.СкидаПриПокупкеВТрейдИн,Символы.НПП,""))));  
		
		ТекстКлассифайда = "";
		ТекстКлассифайда = СМ_ВыгрузкаОбъявленийОПродажеАвто.СМГ_СправочникВернутьЗначениеРеквизита("ТекстКлассифайда",ТекАвто.ПолучитьОбъект());
        СтруктураАвто.Вставить("offer",ТекстКлассифайда);
		
		Если ЕстьЛиПереходВСобственность(ТекАвто) Тогда
			СтруктураАвто.Вставить("pts",1); 
		Иначе	
		    СтруктураАвто.Вставить("pts",0); 
		КонецЕсли; 
        СтруктураАвто.Вставить("stock","авто в наличии"); // пример авто в наличии,
        СтруктураАвто.Вставить("run",0); 
        СтруктураАвто.Вставить("used",0); 
		
 		СтруктураАвто.Вставить("codeDealerCenter",СокрЛП(ЛичныйКабинет.КодДилера));
		
		СтруктураАвто.Вставить("autoru",0);
		СтруктураАвто.Вставить("drom",0);
		СтруктураАвто.Вставить("feed_offer","");  //описание для фидов, текст (Autoru и Drom); 
 		
		Если ТекАвто.ПутьКФото.Количество() > 0 Тогда
 			МассивФото = Новый Массив;
			Для каждого СтрТЧ Из ТекАвто.ПутьКФото Цикл 
	  			МассивФото.Добавить(ПапкаФото+СокрЛП(ТекАвто.УникальныйИдентификатор())+"/"+СтрТЧ.GUID+".jpg");
 			КонецЦикла;                                 
			СтруктураАвто.Вставить("images",МассивФото);
		КонецЕсли;
 		
  		Возврат СтруктураАвто;

КонецФункции // СформироватьСтруктуруАвто(ТекАвто,ЛичныйКабинет)

Функция ВыгрузитьJSON(СписокАвто,ЛичныйКабинет)
	
	МассивДанныхJSON = Новый Массив;
	
	Для каждого Авто Из СписокАвто Цикл
		
		ТекАвто = Авто.Значение;
		
		ВариантКомплектации = СокрЛП(Сред(ТекАвто.ВариантКомплектации.Артикул,1,14));
 		Если СтрДлина(ВариантКомплектации) < 14 Тогда
			СМГ_Сообщить("Пропущен VIN "+СокрЛП(ТекАвто.VIN)+" из-за длины артикула варианта комплектации, которая меньше 14: "+ВариантКомплектации);
			Продолжить;
 		КонецЕсли; 
		
		Если СтрДлина(СокрЛП(ТекАвто.VIN)) = 17 Тогда
			СтруктураДанныхАвто = СформироватьСтруктуруАвто(ТекАвто,ЛичныйКабинет);
			МассивДанныхJSON.Добавить(СтруктураДанныхАвто);
 		КонецЕсли;
		 
 	КонецЦикла; 
  	
	Возврат МассивДанныхJSON;
	
КонецФункции  

Функция ЕстьЛиПереходВСобственность(Авто)

	ЕстьПереходВСобственность = Ложь;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст =	"ВЫБРАТЬ
	              	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль КАК Автомобиль,
	              	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен КАК Проведен,
	              	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.ХозОперация КАК ХозОперация,
	              	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Ссылка КАК Ссылка,
	              	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК Дата,
	              	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль КАК Автомобиль1
	              	|ИЗ
	              	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	              	|ГДЕ
	              	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен = ИСТИНА
	              	|	И ПоступлениеАвтомобилейАвтомобили.Ссылка.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ПереходВСобственностьАвтомобилей)
	              	|	И ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль",Авто);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
 	Если ТЗ.Количество() > 0 Тогда
		ЕстьПереходВСобственность = Истина;	
 	КонецЕсли;

	Возврат ЕстьПереходВСобственность;

КонецФункции // ЕстьпереходВСобственность()
 
Функция ПолучитьЦенуАвто(Автомобиль)
	
	ПолнаяЦенаПродажи = 0.00;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныАвтомобилейСрезПоследних.ТипЦен,
		|	ЦеныАвтомобилейСрезПоследних.Автомобиль,
		|	ЦеныАвтомобилейСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныАвтомобилей.СрезПоследних КАК ЦеныАвтомобилейСрезПоследних
		|ГДЕ
		|	ЦеныАвтомобилейСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)
		|	И ЦеныАвтомобилейСрезПоследних.Автомобиль = &Автомобиль";  
	
	Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПолнаяЦенаПродажи = ВыборкаДетальныеЗаписи.Цена + Автомобиль.СтоимостьДопОборудования;
	КонецЦикла;
	
	Возврат ПолнаяЦенаПродажи;
 
КонецФункции // ПолучитьЦенуАвто(Автомобиль)

Функция ЭтоНовыйАвтомобиль(Автомобиль)
	
	ЭтоНовый = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АвтомобилиСрезПоследних.Автомобиль,
		|	АвтомобилиСрезПоследних.ВидЗначения,
		|	АвтомобилиСрезПоследних.Значение
		|ИЗ
		|	РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|ГДЕ
		|	АвтомобилиСрезПоследних.Автомобиль = &Автомобиль
		|	И АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения
		|	И АвтомобилиСрезПоследних.Значение = &Значение";
	
