////@+ Процедура УстановитьАдресПортСервера()
// Дата создания - 13.04.2012 17:31:52; 
// Автор - Окипний Андрей Евгеньевич
// 
//
// Описание процедуры
//  Устанавливает в компоненте адрес и порт сервера Ap2Ap
//
// Параметры
//  Без параметров
//
//@-
Процедура УстановитьАдресПортСервера()
	
	Результат = Ложь;
	
	Порт = Константы.Renault_Ap2ApПорт.Получить();
	Если НЕ ЗначениеЗаполнено(Порт) тогда
		Порт = 8209;
	КонецЕсли;
	
	Адрес = Константы.Renault_Ap2ApАдресСервера.Получить();
	Если ЗначениеЗаполнено(Адрес) тогда 
		
		// Комментарий 
		//Дата создания - 13.04.2012 17:43:17; Автор - Окипний Андрей Евгеньевич
		//Проверим состояние компоненты, если не все нормально, (State <> 0) перезапустим
		//
		Если WS.State <> 0 тогда
			WS.Close();
		КонецЕсли;
		
		WS.RemoteHost = Адрес;
		WS.RemotePort = Порт;
		
		Результат = Истина;
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьАдресПортСервера()

////@+ Процедура УстановитьСоединение()
// Дата создания - 17.04.2012 11:39:30;
// Автор - Окипний Андрей Евгеньевич
//
// Описание процедуры
//  Процедура производит соединение с сервером A2A по указанным адресу и порту.
//  при этом функция учитывает необходимость переподключения на другой порт
//
// Параметры
//  Без параметров
//
//@-
Процедура УстановитьСоединение()
	
	//Первоначальная инициализация
	Результат = Истина;
	
	////$+ Комментарий 
	//Дата создания - 17.04.2012 11:46:03; Автор - Окипний Андрей Евгеньевич
	//
	// Событие Connect не возвращает результат выполнения. 
	// Нужно проверить реквизит State. И изменить результат
	// в событии Error, если возникнет ошибка.
	//
	//$-
	Если WS.State <> 0 Тогда
		WS.Close();
	КонецЕсли;
		
	WS.Connect();
	
КонецПроцедуры // УстановитьСоединение()

