// Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура производит отправку данных на порт Ap2Ap
//
// Параметры
//  Без параметров
//@-
Процедура ОтправитьДанные() Экспорт
	
	////$+ Комментарий 
	// Дата создания - 31.05.2012 14:16:47;
	// Автор - Окипний Андрей Евгеньевич
	//
	//В этой процедуре нет явной отправки данных.
	//все данные отправляются в обработчике события
	//Connect()
	//
	//$-
	УстановитьАдресПортСервера();
	
	УстановитьСоединение();
	
	ВремОкончанияОжидания = ТекущаяДата() + 5; //Ждем 5 сек. для установки соединения
	Пока ТекущаяДата() <= ВремОкончанияОжидания Цикл КонецЦикла;
	
КонецПроцедуры // ОтправитьДанные()

