////@+ Процедура DataArrival(data)
// Дата создания - 13.04.2012 16:35:37;
// Автор - Окипний Андрей Евгеньевич
// 
//
// Описание процедуры
//  Возникает при окончании получения сообщения. 
//
// Параметры
//  Парам1 bytesTotal  - Число - размер полученных данных в байтах
//@-
Процедура DataArrival(bytesTotal) 

	ТкстСообщения = "";
	ws.GetData(ТкстСообщения);
	
	РезультатЗапроса = РезультатЗапроса + ТкстСообщения;
	
	Если Найти(РезультатЗапроса, "</A2A>") > 0 тогда
		
		ЗаписатьТикет(РезультатЗапроса);
		
	КонецЕсли;

КонецПроцедуры // DataArrival(bytesTotal)

