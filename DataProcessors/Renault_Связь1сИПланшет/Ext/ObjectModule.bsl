Функция ПолучитьТаблицуПоврежденийПоСтроке(вхСтрока)экспорт
	Табл.Очистить();
	//Табл = Новый ТаблицаЗначений();
	//Табл.Колонки.Добавить("ИмяЭлемента");
	//Табл.Колонки.Добавить("Повреждение");
	//Табл.Колонки.Добавить("Комментарий");

	Перв = Найти(вхСтрока,"[");
	Посл = Найти(вхСтрока,"]");
	Если (Перв>0) И (Посл>0) Тогда 
		Разбор = Сред(вхСтрока,Перв+1,Посл-Перв-1);
		МассивСтрок = РазложитьСтрокуВМассив(Разбор,"},{");
		Для Каждого Стр Из МассивСтрок Цикл
			Разб = СтрЗаменить(Стр,"{","");
			Разб = СтрЗаменить(Разб,"}","");
			МассивПарам = РазложитьСтрокуВМассив(Разб,",");
			 
			Нов = Табл.Добавить();
			Для Каждого Парам Из МассивПарам ЦИкл
				МассивОпис =РазложитьСтрокуВМассив(Парам,":");
				Если Найти(МассивОпис[0],"DefectID") Тогда
					Нов.ИмяЭлемента = МассивОпис[1];
				ИначеЕсли Найти(МассивОпис[0],"Comment") Тогда
					Нов.Комментарий = МассивОпис[1];
             	КонецЕсли;
					
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

Функция РазложитьСтрокуВМассив(вхСтрока,Разделитель)
	МассивСтрок = новый Массив();
	ИтоговаяСтрока = вхСтрока;
	Поиск =Найти( ИтоговаяСтрока ,Разделитель);
	Пока Поиск>0 Цикл
		Если Поиск = 1 Тогда
			МассивСтрок.Добавить("");
		Иначе
			Доб = Лев(ИтоговаяСтрока,Поиск -1);
			МассивСтрок.Добавить(Доб);
			ИтоговаяСтрока = Прав(ИтоговаяСтрока,СтрДлина(ИтоговаяСтрока)- СтрДлина(Разделитель)- Поиск+1 );
			Поиск =Найти( ИтоговаяСтрока ,Разделитель);
   		КонецЕсли;
	КонецЦикла;
	МассивСтрок.Добавить(ИтоговаяСтрока);
 	Возврат МассивСтрок;
КонецФункции
