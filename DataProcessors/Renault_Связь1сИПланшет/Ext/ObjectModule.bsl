Процедура ВыполнитьЗаписьВБазуПланшета()Экспорт
	
	Клиенты = ПолучитьКлиентовКВыгрузке();
	ДЦ = ПолучитьВсеДЦКВыгрузке();
	МастераПриемщики = ПолучитьМастеровПриемщиковКВыгрузке();
	Профили = ПолучитьПрофилиКВыгрузке();
	СвязиПрофилей = ПолучитьСвязьСОтрудниковИПрофилей();
	Статусы = ПолучитьСтатусыКВыгрузке();
	//ЗагрузитьПоврежденияВ1с();
	Повреждения = ПолучитьСписокПовреждений();
	гром = 1;
	ВыполнитьMergeВSQL(КЛиенты,"dbo.Client","ClientID");	
	ВыполнитьMergeВSQL(ДЦ,"dbo.Company","CompanyID");
	ВыполнитьMergeВSQL(МастераПриемщики,"dbo.EmployeeData","EmployeeID");
	ВыполнитьMergeВSQL(Профили,"dbo.Profile","ProfileID");
	ОчиститьТаблицуВSQL("dbo.ProfileToEmployee");
	ВыполнитьInsertВSQL(СвязиПрофилей,"dbo.ProfileToEmployee");
	ВыполнитьMergeВSQL(Статусы,"dbo.OperationStatus","UID");
	ВыполнитьMergeВSQL(Повреждения,"dbo.Text","GUID");

	СтатусыИзБазы = ПолучитьТаблицу("dbo.OperationStatus");
	Для Каждого Статус Из СтатусыИзБазы Цикл
		Попытка
		НайденнаяСсылка = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ПолучитьСсылку(Новый УникальныйИдентификатор(Статус.UID));
		Если ЗначениеЗаполнено(НайденнаяСсылка) тогда
			Об = НайденнаяСсылка.ПолучитьОбъект();
			Об.ID = Статус.ID;
			Об.Записать();
		КонецЕсли;
	Исключение
		КонецПопытки;
	КонецЦикла;
	Приемки = ПолучитьПриемкиАвтомобилей();
	ВыполнитьMergeВSQL(Приемки,"dbo.Operation","OperationID");
	
КонецПроцедуры


