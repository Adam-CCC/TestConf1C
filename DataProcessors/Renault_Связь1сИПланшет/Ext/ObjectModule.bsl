Функция ДанныеВЗапрос(ТекЗначение,ТипЗ = 0)Экспорт
	Если ТипЗ = 1 тогда //Дата , либо нулл
		Если Год(ТекЗначение) = 1 Тогда
			Возврат "NULL";
		Иначе
			Возврат "'"+Формат(ТекЗначение,"ДФ=""гггг-ММ-дд""")+"'";
		КонецЕсли;
	ИначеЕсли ТипЗ = 2  Тогда //Строка Либо Нул вместо пустой
		Если СтрДлина(ТекЗначение) = 0 Тогда
			Возврат "NULL";
		Иначе
			Возврат "'"+ТекЗначение+"'"; 
		КонецЕсли;
	ИначеЕсли ТипЗ =3  Тогда //Строка 
		Возврат "'"+ТекЗначение+"'"; 
	ИначеЕсли ТипЗ =4  Тогда //Булево
		Если ТекЗначение = Истина Тогда
			Возврат "ИСТИНА"; 
		Иначе
			Возврат "ЛОЖЬ"; 
		КонецЕсли;
	Иначе
		Возврат ТекЗначение;
	КонецЕсли;
	
КонецФункции   


Функция ПолучитьТаблицу(ИмяТаблицы,Каст = Ложь)
	Параметры = Неопределено;
	СтрокаПодключения  = СформироватьСтрокуСоединенияКБазеПланшет(Параметры);
	Ответ = Истина;
	Подключение = Новый COMОбъект("ADODB.Connection");
 	Попытка
		
		Подключение.open(СтрокаПодключения);
		
	Исключение
		
		Инфа = ИнформацияОбОшибке();
					
		ТекстСообщения = ""+ТекущаяДата()+" Connection error: "+ОписаниеОшибки();
		Ответ = Ложь;			
	КонецПопытки;
	
		
	Записи = Новый COMОбъект("ADODB.RecordSet");
	ЗапросКБазе ="";
	ЗапросКБАзе="SELECT * FROM "+Параметры.БазаДанных+"."+ИмяТаблицы;
	Если Каст Тогда
		ЗапросКБАзе="SELECT *, CAST(Text AS VARCHAR(100))as Text FROM "+Параметры.БазаДанных+"."+ИмяТаблицы;
	КонецЕсли;
	
	Записи = Подключение.Execute(ЗапросКБазе);
	Таблица = новый ТаблицаЗначений();
	КоличествоПолей  = Записи.Fields.Count - 1;
	Для ПолеСч = 0 по КоличествоПолей Цикл 
		
		Если (Таблица.Колонки.Найти(Записи.Fields.item(ПолеСч).name ) =  Неопределено) Тогда
			Таблица.Колонки.Добавить(Записи.Fields.item(ПолеСч).name);
		КонецЕсли;
		
	КонецЦикла;
	Пока Записи.EOF  = ложь Цикл
		НоваяСтрока = Таблица.Добавить();
		 Для ПолеСч = 0 по КоличествоПолей Цикл 
			Поле = Записи.Fields.item(ПолеСч);
			//Если ЭтоПолеТребуетПреобразования(Поле.name) Тогда
				//Если ТипЗнч(Поле.Value) = Тип("Строка") Тогда
				//	НоваяСтрока[Поле.name] = СтрокаSQLВДату(Поле.Value);
				//Иначе
					//НоваяСтрока[Поле.name] = Поле.Value;
				//КонецЕсли;
			//Иначе
			НоваяСтрока[Поле.name] = Поле.Value;
			//КонецЕсли;
		КонецЦикла;
		
				
		Записи.MoveNext();
	Конеццикла;
		 
	 Возврат Таблица;

	
КонецФункции


Процедура ЗагрузитьПоврежденияВ1с() Экспорт
	
	ПоврежденияВр = ПолучитьТаблицу("dbo.Text",Истина);
	ПоврежденияВр.Колонки.TextType.Имя = "TextType_sql";
	ПоврежденияВр.Колонки.Добавить( "TextType");
	Для Каждого Тек Из ПоврежденияВр Цикл
		Тек.TextType = Справочники.Renault_Автосервис_ВидыПовреждений.НайтиПоКоду(Тек.TextType_sql);
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	Renault_Автосервис_СписокПовреждений.ID,
		                      |	Renault_Автосервис_СписокПовреждений.ParentID,
		                      |	Renault_Автосервис_СписокПовреждений.Bookmark,
		                      |	Renault_Автосервис_СписокПовреждений.ИмяЭлементаВ1с,
		                      |	Renault_Автосервис_СписокПовреждений.Text,
		                      |	Renault_Автосервис_СписокПовреждений.TextType,
		                      |	Renault_Автосервис_СписокПовреждений.ПовреждениеВ1с,
		                      |	Renault_Автосервис_СписокПовреждений.GUID
		                      |ИЗ
		                      |	РегистрСведений.Renault_Автосервис_СписокПовреждений КАК Renault_Автосервис_СписокПовреждений
		                      |ГДЕ
		                      |	Renault_Автосервис_СписокПовреждений.GUID = &GUID");
		Запрос.УстановитьПараметр("GUID",Тек.GUID);
		Выборка = Запрос.Выполнить().Выбрать();
		Мен = РегистрыСведений.Renault_Автосервис_СписокПовреждений.СоздатьМенеджерЗаписи();
		Если Выборка.Следующий() тогда
			ЗаполнитьЗначенияСвойств(Мен,Выборка);
			Мен.Прочитать();
			ЗаполнитьЗначенияСвойств(Мен,Тек);
			Мен.Записать(Истина);
		Иначе
			ЗаполнитьЗначенияСвойств(Мен,Тек);
			Мен.GUID = Строка(Новый УникальныйИдентификатор());
			Мен.Записать(Истина);
		КонецЕсли;
		
		
	КонецЦикла;
	//Наб = РегистрыСведений.Renault_Автосервис_СписокПовреждений.СоздатьНаборЗаписей();
	//Наб.Загрузить(ПоврежденияВр);
	//Наб.Записать(Истина);
	
	
	
