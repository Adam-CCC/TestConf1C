Функция ПолучитьСтатусыКВыгрузке()
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Renault_ВидыСостоянийДокументовАвтосервиса.Наименование КАК StatusText,
	                      |	Renault_ВидыСостоянийДокументовАвтосервиса.Status,
	                      |	Renault_ВидыСостоянийДокументовАвтосервиса.Ссылка
	                      |ИЗ
	                      |	Справочник.Renault_ВидыСостоянийДокументовАвтосервиса КАК Renault_ВидыСостоянийДокументовАвтосервиса
	                      |ГДЕ
	                      |	Renault_ВидыСостоянийДокументовАвтосервиса.ID > 0
	                      |	И Renault_ВидыСостоянийДокументовАвтосервиса.ПометкаУдаления = ЛОЖЬ");
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаДанных.Колонки.Добавить("UID",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
	Для Каждого Зап Из ТаблицаДанных Цикл
		Зап.UID = Строка(Зап.Ссылка.Уникальныйидентификатор());
	    
	КонецЦикла;
	ТаблицаДанных.Колонки.Удалить("Ссылка");

	Нов = ТаблицаДанных.Добавить();
	Нов.StatusText ="Без статуса";
	Нов.Status ="Empty";
	Нов.UID = "00000000-0000-0000-0000-000000000000";
	Возврат ТаблицаДанных;
	
КонецФункции


