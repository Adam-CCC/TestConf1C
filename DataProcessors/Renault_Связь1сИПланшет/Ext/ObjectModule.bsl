Функция ПолучитьМастеровПриемщиковКВыгрузке()
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Renault_CRM_ПриемкаАвтомобиля.Машиноместо.Наименование КАК FullName,
	                      |	Renault_CRM_ПриемкаАвтомобиля.Машиноместо.Ссылка КАК Ссылка,
	                      |	Renault_CRM_ПриемкаАвтомобиля.ДилерскийЦентр.Ссылка КАК ДЦ,
	                      |	Renault_Автосервис_НастройкиСотрудниковПланшет.Логин КАК Name,
	                      |	Renault_Автосервис_НастройкиСотрудниковПланшет.Пароль КАК Password
	                      |ИЗ
	                      |	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Автосервис_НастройкиСотрудниковПланшет КАК Renault_Автосервис_НастройкиСотрудниковПланшет
	                      |		ПО Renault_CRM_ПриемкаАвтомобиля.Машиноместо = Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник
	                      |ГДЕ
	                      |	Renault_CRM_ПриемкаАвтомобиля.Состояние В(&Состояния)");
	ДопустимыеСосотояния = ПолучитьДопустимыеСостоянияПриемки();
	Запрос.УстановитьПараметр("Состояния",ДопустимыеСосотояния);
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаДанных.Колонки.Добавить("EmployeeID",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
	ТаблицаДанных.Колонки.Добавить("CompanyID",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));

	Для Каждого Зап Из ТаблицаДанных Цикл
		Зап.EmployeeID = Строка(Зап.Ссылка.Уникальныйидентификатор());
	    Зап.CompanyID = Строка(Зап.ДЦ.Уникальныйидентификатор());
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Renault_Автосервис_СотрудникиИПрофилиПланшет.Сотрудник.Ссылка КАК Ссылка,
	                      |	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки.ДилерскийЦентр.Ссылка КАК ДЦ,
	                      |	Renault_Автосервис_СотрудникиИПрофилиПланшет.Сотрудник.Наименование КАК FullName,
	                      |	Renault_Автосервис_НастройкиСотрудниковПланшет.Логин КАК Login,
	                      |	Renault_Автосервис_НастройкиСотрудниковПланшет.Пароль КАК Password
	                      |ИЗ
	                      |	РегистрСведений.Renault_Автосервис_СотрудникиИПрофилиПланшет КАК Renault_Автосервис_СотрудникиИПрофилиПланшет
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
	                      |		ПО Renault_Автосервис_СотрудникиИПрофилиПланшет.Сотрудник = Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Автосервис_НастройкиСотрудниковПланшет КАК Renault_Автосервис_НастройкиСотрудниковПланшет
	                      |		ПО Renault_Автосервис_СотрудникиИПрофилиПланшет.Сотрудник = Renault_Автосервис_НастройкиСотрудниковПланшет.Сотрудник");
	ТаблицаМастеров = Запрос.Выполнить().Выгрузить();
	Для Каждого Тек Из ТаблицаМастеров Цикл
		Поиск = ТаблицаДанных.Найти(Тек.Ссылка,"Ссылка");
		Если Не ЗначениеЗаполнено(Поиск) Тогда
			Зап =  ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(Зап,Тек);
			Зап.EmployeeID = Строка(Зап.Ссылка.Уникальныйидентификатор());
			Если  ЗначениеЗаполнено(Зап.ДЦ) Тогда
				Зап.CompanyID = Строка(Зап.ДЦ.Уникальныйидентификатор());
			Иначе
				Выборка = Справочники.CRM_ДилерскиеЦентры.Выбрать();
				Если Выборка.Следующий() Тогда
					Зап.CompanyID = Выборка.Ссылка.УникальныйИдентификатор();
				Иначе
					Зап.CompanyID = "00000000-0000-0000-0000-000000000000";
				КонецЕсли;
			КонецЕсли;		
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаДанных.Колонки.Удалить("Ссылка");
	ТаблицаДанных.Колонки.Удалить("ДЦ");
	Возврат ТаблицаДанных;
	
КонецФункции

