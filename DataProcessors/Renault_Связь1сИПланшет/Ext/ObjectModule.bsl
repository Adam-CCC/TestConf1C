Функция ПолучитьКлиентовКВыгрузке()
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	Renault_CRM_ПриемкаАвтомобиля.Клиент.Фамилия КАК Surname,
	                      |	Renault_CRM_ПриемкаАвтомобиля.Клиент.Имя КАК FirstName,
	                      |	Renault_CRM_ПриемкаАвтомобиля.Клиент.Отчество КАК Patronymic,
	                      |	Renault_CRM_ПриемкаАвтомобиля.Клиент.Ссылка КАК Ссылка,
	                      |	Renault_CRM_ПриемкаАвтомобиля.Клиент.Наименование КАК FullName
	                      |ИЗ
	                      |	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
	                      |ГДЕ
	                      |	Renault_CRM_ПриемкаАвтомобиля.Состояние В(&Состояния)");
	ДопустимыеСосотояния = ПолучитьДопустимыеСостоянияПриемки();
	Запрос.УстановитьПараметр("Состояния",ДопустимыеСосотояния);
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	ТаблицаДанных.Колонки.Добавить("ClientID",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(40)));
	Для Каждого Зап Из ТаблицаДанных Цикл
		Зап.ClientID = Строка(Зап.Ссылка.Уникальныйидентификатор());
	КонецЦикла;
	ТаблицаДанных.Колонки.Удалить("Ссылка");
	Возврат ТаблицаДанных;
	
КонецФункции

Функция ПолучитьДопустимыеСостоянияПриемки()
	
	ДопустимыеСосотояния = Новый Массив();
	ДопустимыеСосотояния.Добавить(Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ВРаботе);
	//ДопустимыеСосотояния.Добавить(Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ВыдачаНачата);
	ДопустимыеСосотояния.Добавить(Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка);
	ДопустимыеСосотояния.Добавить(Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.КлиентОжидает);
	ДопустимыеСосотояния.Добавить(Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ПриемкаНачата);
	Возврат ДопустимыеСосотояния;
	
КонецФункции

