		|ГДЕ
		|	Генерация_Авито.Наименование = &Наименование
		|	И Генерация_Авито.Владелец = &Модель
		|	И Генерация_Авито.Артикул = &Артикул";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Запрос.УстановитьПараметр("Модель", Модель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовГенерация = ВыборкаДетальныеЗаписи.Ссылка;
		Возврат НовГенерация;
	КонецЦикла;
	
	Если обЗначениеНеЗаполнено(НовГенерация) Тогда
		
		НовГенерация = Справочники.Генерации_Авито.СоздатьЭлемент();
		НовГенерация.УстановитьНовыйКод("ЦБ");
		НовГенерация.Наименование = Наименование;
 		НовГенерация.Артикул = Артикул;
		НовГенерация.Владелец = Модель; 
		
		Попытка	НовГенерация.Записать(); Исключение КонецПопытки;
		
	КонецЕсли; 
 
	Возврат НовГенерация.Ссылка;

КонецФункции // НайтиИлиСоздатьГенерацию(Наименование,Модель)

