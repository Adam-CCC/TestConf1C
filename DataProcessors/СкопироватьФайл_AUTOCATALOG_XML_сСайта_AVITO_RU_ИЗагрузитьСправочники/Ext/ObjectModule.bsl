Процедура АвитоЗагрузкаСправочниковМодуль() Экспорт
	
	ВнутреннийАдресСервера = "https://autoload.avito.ru/format/Autocatalog.xml";
	
  	ИмяФайлаНазначение = ПолучитьИмяВременногоФайла("xml");
	ФайлНаДиске = Новый Файл(ИмяФайлаНазначение);
	
	Для Счетчик = 1 По 10 Цикл
		КопироватьФайл(ВнутреннийАдресСервера,ИмяФайлаНазначение);
  		Если ФайлНаДиске.Существует() Тогда
 			Прервать;
		КонецЕсли;
		Пауза30секунд = 30;
		КонДата = ТекущаяДата() + Пауза30секунд;
  		Пока ТекущаяДата() < КонДата Цикл
      		//...  
  		КонецЦикла;
 	КонецЦикла; 
	
	Если НЕ ФайлНаДиске.Существует() Тогда
		#Если НаКлиенте Тогда
			Попытка
		       Сообщить("ОШИБКА! Информация с сайта не скопирована в файл: <"+СокрЛП(ИмяФайлаНазначение)+">",СтатусСообщения.ОченьВажное);
 			Исключение
				//				
			КонецПопытки;		 
 		#КонецЕсли
  		Возврат;
	Иначе
		#Если НаКлиенте Тогда
			Попытка
		       Сообщить("Информация с сайта скопирована в файл: <"+СокрЛП(ФайлНаДиске.ПолноеИмя)+">");
 			Исключение
				//				
			КонецПопытки;		 
 		#КонецЕсли
	КонецЕсли;  
	
	ёё = 0;
	
	МаркаАвито         = Справочники.Марка_Авито.ПустаяСсылка();
	МодельАвито        = Справочники.Модели_Авито.ПустаяСсылка();
	ГенерацияАвито     = Справочники.Генерации_Авито.ПустаяСсылка();
	МодификацияАвито   = Справочники.Модели_Авито.ПустаяСсылка();
	КомплектацияАвито  = Справочники.Комплектации_Авито.ПустаяСсылка();
	ТипКузоваАвито     = Справочники.СМ_ТипыКузововАвито.ПустаяСсылка();
	АртикулМарки       = "";
	АртикулМодели      = "";
	АртикулГенерации   = "";
	АртикулМодификации = "";
	АртикулТипаКузова  = "";
 	
	ЧтениеXML = Новый ЧтениеXML();
	
	ЧтениеXML.ОткрытьФайл(ИмяФайлаНазначение);
	
 	Пока ЧтениеXML.Прочитать() Цикл
 		
 		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ТекущееИмя = ЧтениеXML.Имя;
			
			Если ТекущееИмя = "Make" Тогда
				АртикулМарки = ЧтениеXML.ПолучитьАтрибут(0);
 			ИначеЕсли ТекущееИмя = "Model" Тогда
				АртикулМодели = ЧтениеXML.ПолучитьАтрибут(0);
			ИначеЕсли ТекущееИмя = "Generation" Тогда	
				АртикулГенерации = ЧтениеXML.ПолучитьАтрибут(0);
			ИначеЕсли ТекущееИмя = "Modification" Тогда	
				АртикулМодификации = ЧтениеXML.ПолучитьАтрибут(0);
			ИначеЕсли ТекущееИмя = "BodyType" Тогда		
				ТипКузоваАвито = ЧтениеXML.ПолучитьАтрибут(0);
 			КонецЕсли; 
			
			Если ТекущееИмя = "Complectations" Тогда
				Пока ЧтениеXML.Прочитать() Цикл
					Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
						Если ЧтениеXML.Имя = "Complectations"  Тогда
							Прервать;
						КонецЕсли;
						Если ЧтениеXML.Имя = "Complectation"  Тогда
							Продолжить;
						КонецЕсли;
					КонецЕсли;
 					НазваниеКомплектации = ЧтениеXML.ПолучитьАтрибут(1);
					АртикулКомплектации = ЧтениеXML.ПолучитьАтрибут(0);
					//Бондаренко++ 20240627
					Если СокрЛП(НазваниеКомплектации)<> "" Тогда
						Если СокрЛП(АртикулКомплектации)<> "" Тогда
					//Бондаренко-- 20240627			
							КомплектацияАвито = НайтиИлиСоздатьКомплектацию(НазваниеКомплектации,АртикулКомплектации,МодификацияАвито,ГенерацияАвито);	
					//Бондаренко++ 20240627								
					    КонецЕсли;
					КонецЕсли;
  	 				//Бондаренко-- 20240627	 
 				КонецЦикла	
	 		КонецЕсли;
   
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ТекущееЗначение = ЧтениеXML.Значение;
			
			Если ТекущееИмя = "Make" Тогда
 				МаркаАвито = НайтиИлиСоздатьМарку(ТекущееЗначение,АртикулМарки);
 			ИначеЕсли ТекущееИмя = "Model" Тогда
  				МодельАвито = НайтиИлиСоздатьМодель(ТекущееЗначение,АртикулМодели,МаркаАвито);
 			ИначеЕсли ТекущееИмя = "Generation" Тогда
 				ГенерацияАвито = НайтиИлиСоздатьГенерацию(ТекущееЗначение,АртикулГенерации,МодельАвито);
  			ИначеЕсли ТекущееИмя = "Modification" Тогда
 				МодификацияАвито = НайтиИлиСоздатьМодификацию(ТекущееЗначение,АртикулМодификации,МодельАвито,ГенерацияАвито);
			ИначеЕсли ТекущееИмя = "BodyType" Тогда
 				ТипКузоваАвито = НайтиИлиСоздатьТипКузова(ТекущееЗначение,АртикулТипаКузова);
  			КонецЕсли; 
			
   		КонецЕсли;
		
	КонецЦикла;
	
	ЧтениеXML.Закрыть();	

КонецПроцедуры

Функция НайтиИлиСоздатьМарку(Наименование,Артикул) Экспорт
	
	НовМарка = Справочники.Марка_Авито.ПустаяСсылка();
	
	//Бондаренко++ 20240330
	Если СокрЛП(Артикул) <> "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Марка_Авито.Ссылка,
		|	Марка_Авито.Наименование,
		|	Марка_Авито.Артикул
		|ИЗ
		|	Справочник.Марка_Авито КАК Марка_Авито
		|ГДЕ
 		|	Марка_Авито.Артикул = &Артикул";
		
 		Запрос.УстановитьПараметр("Артикул", Артикул);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НовМарка = ВыборкаДетальныеЗаписи.Ссылка;
			Если НовМарка.Наименование <> Наименование Тогда
				НовМарка_ = НовМарка.ПолучитьОбъект();
				НовМарка_.Наименование = Наименование;
				Попытка
				    НовМарка_.Записать();
 				Исключение
					//
				КонецПопытки;
 			КонецЕсли;
			Возврат НовМарка;
		КонецЦикла;
	КонецЕсли;
	//Бондаренко-- 20240330
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Марка_Авито.Ссылка,
		|	Марка_Авито.Наименование,
		|	Марка_Авито.Артикул
		|ИЗ
		|	Справочник.Марка_Авито КАК Марка_Авито
		|ГДЕ
		|	Марка_Авито.Наименование = &Наименование
		|	И Марка_Авито.Артикул = &Артикул";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовМарка = ВыборкаДетальныеЗаписи.Ссылка;
		Возврат НовМарка;
	КонецЦикла;
	
	Если обЗначениеНеЗаполнено(НовМарка) Тогда
		
		НовМарка = Справочники.Марка_Авито.СоздатьЭлемент();
		НовМарка.УстановитьНовыйКод("ЦБ");
		НовМарка.Наименование = Наименование;
		НовМарка.Артикул = Артикул;
		Попытка НовМарка.Записать(); Исключение  КонецПопытки;
		
	КонецЕсли; 
 
	Возврат НовМарка.Ссылка;

КонецФункции // НайтиИлиСоздатьМарку(Наименование) 

