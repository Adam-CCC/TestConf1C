Процедура Выбор() //возврат структуры 
	Стр=Список.НайтиПоИдентификатору(Элементы.Список.ТекущаяСтрока); 
	Закрыть(Новый Структура("Наименование,ИНН,ОГРН,Адрес,ДатаРегистрации",Стр.Наименование,Стр.ИНН,Стр.ОГРН,РазобратьАдрес(Стр.Адрес),Стр.ДатаРегистрации)) 
КонецПроцедуры

//+онлайн сервис
Процедура Поиск(СтрПоиска)
	Список.Очистить();
	//URL="https://focus.kontur.ru/search?query="+КодироватьСтроку(СтрокаПоиска,СпособКодированияСтроки.КодировкаURL,"UTF8")+"&industry="+Индустрия+"&region="+Регион+"&pagenum="+Формат(НомерСтраницы,"ЧГ=0");
	//IE.navigate(URL);
	//Пока IE.readyState<4 Цикл КонецЦикла;
	//Для каждого li Из IE.document.getElementsByTagName("ul").item(6).getElementsByTagName("li") Цикл
	//	Сообщить(li.getElementsByTagName("a").item(0).innerText);
	//КонецЦикла;	
	
	СтрокаПоиска=СтрПоиска; //восстановим  значение
	
	Таймаут=5;
	Попытка
		Соединение=Новый HTTPСоединение("focus.kontur.ru",,,,,Таймаут,Новый ЗащищенноеСоединениеOpenSSL);				
		HTTPЗапрос=Новый HTTPЗапрос("search?query="+СтрПоиска+"&industry="+Индустрия+"&region="+Регион+"&pagenum="+Формат(НомерСтраницы,"ЧГ=0"));	
		HTTPОтвет=Соединение.Получить(HTTPЗапрос);
	Исключение
		Сообщить(ОписаниеОшибки(),СтатусСообщения.Внимание);
		Возврат
	КонецПопытки;
	
	Если Не HTTPОтвет.КодСостояния=302 И (HTTPОтвет.КодСостояния<200 Или HTTPОтвет.КодСостояния>=300) Тогда
		Сообщить(Renault_СтроковыеФункцииКлиентСервер.ИзвлечьТекстИзHTML(HTTPОтвет.ПолучитьТелоКакСтроку()),СтатусСообщения.Внимание);
		Возврат
	КонецЕсли;
	
	ЧтениеHTML=Новый ЧтениеHTML;
	ЧтениеHTML.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
	ПостроительDOM=Новый ПостроительDOM;
	ДокументHTML=ПостроительDOM.Прочитать(ЧтениеHTML);
	ЧтениеHTML.Закрыть();
	
	Попытка 
		СписокЭлементов=ДокументHTML.ПолучитьЭлементыПоИмени("ul")[5].ПолучитьЭлементыПоИмени("li"); //список найденных 
		Если СписокЭлементов[0].ПолучитьЭлементыПоИмени("a").Количество()=0 Тогда Возврат КонецЕсли;  //ничего не нашлось
		Если СписокЭлементов[0].ПолучитьЭлементыПоИмени("p").Количество()=0 Тогда Возврат КонецЕсли; //нет реквизитов
	Исключение Возврат КонецПопытки;
	
	Для Каждого Эл Из СписокЭлементов Цикл
		Реквизиты=Эл.ПолучитьЭлементыПоИмени("p");
		Строка=Список.Добавить();
		Строка.Наименование=Эл.ПолучитьЭлементыПоИмени("a")[0].ТекстовоеСодержимое;
		
		СтрокаИнформации="";
		Для Н=1 По Реквизиты.Количество()-1 Цикл
			Реквизит=Реквизиты[Н];
			Если Реквизит.ИмяКласса="noMargin darkgreen" Тогда
				Строка.Информация=СтрокаИнформации;
				Строка.Адрес=Реквизит.ТекстовоеСодержимое;
				Если Строка.Адрес<>"" Тогда
					Строка.СсылкаАдреса="https://focus.kontur.ru"+Реквизит.ПолучитьЭлементыПоИмени("a")[0].Гиперссылка;
					//Ссылка Google Строка.СсылкаАдреса="https://www.google.ru/maps/place/"+КодироватьСтроку(Реквизит.ТекстовоеСодержимое,СпособКодированияСтроки.КодировкаURL,"UTF8");
					//Ссылка Yandex Строка.СсылкаАдреса="https://yandex.ru/maps/?text="+КодироватьСтроку(Реквизит.ТекстовоеСодержимое,СпособКодированияСтроки.КодировкаURL,"UTF8");
				КонецЕсли;	
					
				Реквизит=Реквизиты[Н+1];
				
				Строка.ИмяИНН="ИНН";
				Строка.ИмяОГРН="ОГРН";
				Строка.ИмяДатаРегистрации="Регистрация";
				
				Если Реквизит.ДочерниеУзлы.Количество()>0 Тогда
					Строка.ИНН=Сред(Реквизит.ДочерниеУзлы[1].ТекстовоеСодержимое,6);
				КонецЕсли;	
				
				Если Реквизит.ДочерниеУзлы.Количество()>2 Тогда
					Подстрока=СокрЛП(Реквизит.ДочерниеУзлы[3].ТекстовоеСодержимое);
					Поз=Найти(Подстрока,Символ(8211));
					Строка.ОГРН=СокрЛП(Сред(Подстрока,7,Поз-8));
					Строка.ДатаРегистрации=ПреобразованиеДаты(СокрЛП(Сред(Подстрока,Поз+1)));
				КонецЕсли;	
				
				Прервать
			Иначе
				СтрокаИнформации=СтрокаИнформации+?(СтрокаИнформации="","",Символы.ПС)+СокрЛП(Реквизит.ТекстовоеСодержимое);
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры
Функция ПреобразованиеДаты(Текст)
	Текст=СтрЗаменить(Текст,".",Символы.ПС);
	Если СтрЧислоСтрок(Текст)<>3 Тогда Возврат "" КонецЕсли;
	Возврат Дата(СтрПолучитьСтроку(Текст,3)+СтрПолучитьСтроку(Текст,2)+СтрПолучитьСтроку(Текст,1))
КонецФункции	
