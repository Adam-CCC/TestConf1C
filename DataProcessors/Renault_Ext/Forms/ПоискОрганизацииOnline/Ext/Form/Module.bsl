Функция РазобратьАдрес(Строка)
	Поз=Найти(Строка,"Филиал:"); Если Поз>0 Тогда Строка=Сред(Строка,Поз+8) КонецЕсли;
	Представление=Строка;
	Индекс=Лев(Строка,6); Строка=Сред(Строка,8);
	
	Область=""; Район=""; Город=""; Улица=""; Дом=""; Строение=""; Корпус=""; Офис="";
	ЕстьОбласть=Ложь; ЕстьРайон=Ложь; ЕстьГород=Ложь; ЕстьУлица=Ложь; ЕстьДом=Ложь; ЕстьКорпус=Ложь; ЕстьСтроение=Ложь;
	
	Строка=СтрЗаменить(Строка,",",Символы.ПС);
	Для Н=1 По СтрЧислоСтрок(Строка) Цикл
		Подстрока=СтрПолучитьСтроку(Строка,Н);
		
		Если Не ЕстьОбласть Тогда СтрОбласть=НайтиОбласть(Подстрока); Если СтрОбласть<>"" Тогда Область=СтрОбласть; ЕстьОбласть=Истина; Продолжить КонецЕсли КонецЕсли;
		Если Не ЕстьРайон Тогда СтрРайон=НайтиРайон(Подстрока); Если СтрРайон<>"" Тогда Район=СтрРайон; ЕстьРайон=Истина; Продолжить КонецЕсли КонецЕсли;	
		Если Не ЕстьГород Тогда СтрГород=НайтиГород(Подстрока); Если СтрГород<>"" Тогда Город=СтрГород; ЕстьГород=Истина; Продолжить КонецЕсли КонецЕсли;
		Если Не ЕстьУлица Тогда СтрУлица=НайтиУлица(Подстрока); Если СтрУлица<>"" Тогда Улица=СтрУлица; ЕстьУлица=Истина; Продолжить КонецЕсли КонецЕсли;
		
		Если Не ЕстьДом Тогда 
			СтрДом=НайтиДом(Подстрока); 
			Если СтрДом<>"" Тогда Дом=СтрДом; 
				ЕстьДом=Истина; 
				Подстрока=СтрЗаменить(Подстрока,СтрДом,""); //продолжить анализ этой строки, но без значения идентифицированного здесь
			КонецЕсли 
		КонецЕсли;
		
		Если Не ЕстьКорпус Тогда СтрКорпус=НайтиКорпус(Подстрока); Если СтрКорпус<>"" Тогда Корпус=СтрКорпус; ЕстьКорпус=Истина; Продолжить КонецЕсли КонецЕсли;
		Если Не ЕстьСтроение Тогда СтрСтроение=НайтиСтроение(Подстрока); Если СтрСтроение<>"" Тогда Строение=СтрСтроение; ЕстьСтроение=Истина; Продолжить КонецЕсли КонецЕсли;
		СтрОфис=НайтиОфис(Подстрока); Если СтрОфис<>"" Тогда Офис=СтрОфис КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Новый Структура("Представление,Индекс,Область,Район,Город,Улица,Дом,Строение,Корпус,Офис",Представление,Индекс,Область,Район,Город,Улица,Дом,Строение,Корпус,Офис)
КонецФункции
