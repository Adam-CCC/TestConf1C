
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СкидкаОбщаяСуммаПриИзменении(Неопределено);
	//@++ Васильев ВА
	ПолучитьСписокСкидокИзВременногоХранилища(КлючТаблицыСпискаСкидок);
	ОбновитьСуммы();
	УстановитьТекстСкидки();
	//@++
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСуммы()
	СуммаАкций = 0;СуммаСкидки = 0;
	Для каждого Стр Из СписокСкидок Цикл
		////Если Стр.ТипСкидки <> СкидкаRenault Тогда
		Если Стр.Документ <> Документы.Renault_ИзменениеСкидокНаАвтомобили.ПустаяСсылка() Тогда
			СуммаСкидки = СуммаСкидки + Стр.СуммаСкидки;
		Иначе	
			СуммаАкций = СуммаАкций + Стр.СуммаСкидки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Ответ = Новый Структура;
	Ответ.Вставить("СуммаСкидки", СуммаСкидки+СуммаАкций);
	Ответ.Вставить("СуммаДоставки", СуммаДоставки);
	Ответ.Вставить("СуммаКонечная", СуммаКонечная);	
	//@++Васильев ВА
	Ответ.Вставить("КлючТаблицыСпискаСкидок", КлючТаблицыСпискаСкидок);
	//@++
	Закрыть(Ответ);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
    Закрыть(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СкидкаОбщаяПроцентПриИзменении(Элемент)
	СуммаСкидки = Окр(СуммаКонфигурации * СкидкаОбщаяПроцент / 100);
	СуммаКонечная = ПолучитьОбщуюСумму();
КонецПроцедуры

&НаКлиенте
Процедура СкидкаОбщаяСуммаПриИзменении(Элемент)
	//Козлов Е.А. Начало 24.01.2017
	СкидкаОбщаяПроцент = ?(ЗначениеЗаполнено(СуммаКонфигурации), 100 * СуммаСкидки / СуммаКонфигурации, 0);
	//СкидкаОбщаяПроцент = СуммаСкидки / СуммаКонфигурации * 100;
	//Козлов Е.А. Конец
	СуммаКонечная = ПолучитьОбщуюСумму();
КонецПроцедуры

&НаКлиенте
Процедура СуммаДоставкиПриИзменении(Элемент)
	СуммаКонечная = ПолучитьОбщуюСумму();
КонецПроцедуры

&НаКлиенте
Процедура СуммаКонечнаяПриИзменении(Элемент)
	
	СуммаВычисленная = СуммаКонечная - СуммаКонфигурации + СуммаСкидки;
	Если СуммаВычисленная >= 0 Тогда
		СуммаДоставки = СуммаВычисленная;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОбщуюСумму()
	
	Возврат СуммаКонфигурации + СуммаДоставки - СуммаСкидки-СуммаАкций;
	
КонецФункции

//@++ Васильев ВА
&НаКлиенте
Процедура СуммаСкидкиНажатие(Элемент)
	
	// НАЧАЛО DMSCOR-1030
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Строки",              ПолучитьМассивСтрокСкидок());	
	ПараметрыФормы.Вставить("ТипСкидки_Renault",   СкидкаRenault);	
	ПараметрыФормы.Вставить("СуммаКонфигурации",   СуммаКонфигурации);
	ПараметрыФормы.Вставить("Автомобиль",          Автомобиль);	
	ПараметрыФормы.Вставить("ВариантКомплектации", Версия);	
	ПараметрыФормы.Вставить("ДилерскийЦентр",      ДилерскийЦентр);	
	ПараметрыФормы.Вставить("ДатаДоговора",        Дата);	
	ПараметрыФормы.Вставить("ЭтоКорпоративныйКлиент", ЭтоКорпоративныйКлиент);	
	
	ОткрытьФорму("Документ.Renault_Договор.Форма.ИзменениеСкидок", ПараметрыФормы, ЭтаФорма);
	// КОНЕЦ  
	
	//ОткрытьФорму("Документ.Renault_Договор.Форма.ИзменениеСкидок",Новый Структура("Строки, ТипСкидки_Renault, СуммаКонфигурации",ПолучитьМассивСтрокСкидок(), СкидкаRenault, СуммаКонфигурации),ЭтаФорма);
	
КонецПроцедуры

&НаСервере 
Процедура ПоместитьСписокСкидокВоВременноеХранилище(КлючТаблицыСпискаСкидок) 
	ОбъектСписокСкидок = РеквизитФормыВЗначение("СписокСкидок");
 	ПоместитьВоВременноеХранилище(ОбъектСписокСкидок, КлючТаблицыСпискаСкидок); 	
КонецПроцедуры 

&НаСервере
Процедура ПолучитьСписокСкидокИзВременногоХранилища(КлючТаблицыСпискаСкидок)
	Если КлючТаблицыСпискаСкидок <> Неопределено Тогда
		Попытка
			ТЗСписокСкидок = ПолучитьИзВременногоХранилища(КлючТаблицыСпискаСкидок);
		Исключение
			Сообщить("Не удалось получить ТЗ по ИД: " + КлючТаблицыСпискаСкидок);
		КонецПопытки;
		Если ТЗСписокСкидок <> неопределено Тогда
			СписокСкидок.Загрузить(ТЗСписокСкидок); 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСтрокСкидок()
	
	ОбъектСписокСкидок = РеквизитФормыВЗначение("СписокСкидок");
	МассивСтрок = Новый Массив;
	Для Каждого Стр Из ОбъектСписокСкидок Цикл
		////Если Стр.ТипСкидки <> СкидкаRenault Тогда
		Если Стр.Документ <> Документы.Renault_ИзменениеСкидокНаАвтомобили.ПустаяСсылка() Тогда
			МассивСтрок.Добавить(Новый Структура("ТипСкидки,ПроцентСкидки,СуммаСкидки,Документ,ДатаНачала,ДатаКонца",
						Стр.ТипСкидки,Стр.ПроцентСкидки,Стр.СуммаСкидки,Стр.Документ,Стр.ДатаНачала,Стр.ДатаКонца));
		КонецЕсли;
	КонецЦикла;	
		
	Возврат МассивСтрок;
	
КонецФункции

&НаКлиенте
Процедура УстановитьТекстСкидки() 
	Элементы.СуммаСкидки.Заголовок=?(СуммаСкидки=0,"Установить скидку",СуммаСкидки);
	Элементы.СуммаКоммАкций.Заголовок=?(СуммаАкций=0,"Редактировать акции",СуммаАкций);
КонецПроцедуры	

&НаКлиенте
Процедура СуммаКоммАкцийНажатие(Элемент)
	
	//мСписок = СуммаКоммАкцийНажатиеНаСервере();
	//
	//ПФ = Новый Структура("Список", мСписок);
	
	мАкции = СуммаКоммАкцийНажатиеНаСервере();
	МассивЗначений = Новый Массив;
	Для Каждого Стр Из мАкции Цикл		
		МассивЗначений.Добавить(Новый Структура("Акция, СуммаСкидки", Стр.Акция, Стр.СуммаСкидки));	
	КонецЦикла;	
	
	ПФ = Новый Структура;
	ПФ.Вставить("МассивЗначений", МассивЗначений);	
	ПФ.Вставить("СуммаАвтомобиляИБазовыхОпций", СуммаКонфигурации);
	ПФ.Вставить("Кредит", Кредит);
	ПФ.Вставить("TradeIn", TradeIn);
	ПФ.Вставить("Утилизация", Утилизация);
	ПФ.Вставить("VIN", Автомобиль.VIN);
	ПФ.Вставить("Модель", Модель);
	ПФ.Вставить("ВариантКомплектации", Версия);
	ПФ.Вставить("ДилерскийЦентр", ДилерскийЦентр);
	ПФ.Вставить("ГодВыпуска", Renault_ОбщегоНазначения.ПолучитьГодВыпуска(Автомобиль));
	ПФ.Вставить("СтоимостьБазы", СуммаКонфигурации);
	Ответ = ОткрытьФормуМодально("Документ.Renault_Договор.Форма.СкидкиRenault", ПФ, ЭтаФорма);
	НоваяСуммаАкций = 0;
	Если Ответ <> Неопределено Тогда
		
		//++ DMSREN-57
		//мСкидки = СписокСкидок.НайтиСтроки(Новый Структура("ТипСкидки", СкидкаRenault));
		//Для Каждого СтрУдаления из мСкидки Цикл
		//	СписокСкидок.Удалить(СтрУдаления);
		//КонецЦикла;
		
		мСкидки = СписокСкидок.НайтиСтроки(Новый Структура("Документ", Документы.Renault_ИзменениеСкидокНаАвтомобили.ПустаяСсылка()));
		Для Каждого СтрУдаления из мСкидки Цикл
			СписокСкидок.Удалить(СтрУдаления);
		КонецЦикла;
		//-- DMSREN-57
		
		Для Каждого Стр Из Ответ Цикл
			НовСкидка = СписокСкидок.Добавить();
			НовСкидка.ТипСкидки = СкидкаRenault;
			НовСкидка.СуммаСкидки = Стр.ЗначениеСкидки;
			ЗаполнитьЗначенияСвойств(НовСкидка, Стр);
			НоваяСуммаАкций = НоваяСуммаАкций + Стр.ЗначениеСкидки;
		КонецЦикла;	

	КонецЕсли;
	
	СуммаАкций = НоваяСуммаАкций;
	СкидкаОбщаяПроцент = ?(ЗначениеЗаполнено(СуммаКонфигурации), 100 * (СуммаСкидки+СуммаАкций) / СуммаКонфигурации, 0);
	//СкидкаОбщаяПроцент = СуммаСкидки / СуммаКонфигурации * 100;
	//Козлов Е.А. Конец 
	СуммаКонечная = ПолучитьОбщуюСумму();
	ПоместитьСписокСкидокВоВременноеХранилище(КлючТаблицыСпискаСкидок);
	ОбновитьСуммы();
	УстановитьТекстСкидки();	
	
КонецПроцедуры

