&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	МассивСтрок =  ВыбранноеЗначение;
	Если (ТипЗНЧ(ИсточникВыбора)  = Тип("УправляемаяФорма") и ИсточникВыбора.ИмяФормы = "Документ.Renault_Договор.Форма.ИзменениеСкидок") тогда
		НоваяСуммаСкидки = 0;
		Если МассивСтрок<>Неопределено Тогда
			Если МассивСтрок <> КодВозвратаДиалога.Отмена Тогда
				//СкидкиКоммерческие = СписокСкидок.НайтиСтроки(Новый Структура("ТипСкидки", СкидкаRenault));
				//СписокСкидок.Очистить();
				мСкидки = СписокСкидок.НайтиСтроки(Новый Структура("Акция", Справочники.DMS_КоммерческиеАкции.ПустаяСсылка()));
				Для Каждого СтрУдаления из мСкидки Цикл
					СписокСкидок.Удалить(СтрУдаления);
				КонецЦикла;
				//Для Каждого Стр Из СкидкиКоммерческие Цикл
				//	НовСкидка = СписокСкидок.Добавить();
				//	ЗаполнитьЗначенияСвойств(НовСкидка, Стр);
				//КонецЦикла;
				
				Для Каждого Стр Из МассивСтрок Цикл
					Если Стр.ТипСкидки.Пустая() Или Стр.СуммаСкидки=0 Тогда Продолжить КонецЕсли;
					НовСкидка = СписокСкидок.Добавить();
					ЗаполнитьЗначенияСвойств(НовСкидка,Стр);
					НоваяСуммаСкидки = НоваяСуммаСкидки + Стр.СуммаСкидки;
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
		СуммаСкидки = НоваяСуммаСкидки;	
		//Козлов Е.А. Начало 24.01.2017
		СкидкаОбщаяПроцент = ?(ЗначениеЗаполнено(СуммаКонфигурации), 100 * (СуммаСкидки+СуммаАкций) / СуммаКонфигурации, 0);
		//СкидкаОбщаяПроцент = СуммаСкидки / СуммаКонфигурации * 100;
		//Козлов Е.А. Конец 
		СуммаКонечная = ПолучитьОбщуюСумму();
		ПоместитьСписокСкидокВоВременноеХранилище(КлючТаблицыСпискаСкидок);
		ОбновитьСуммы();
		УстановитьТекстСкидки();
	КонецЕсли;
КонецПроцедуры
