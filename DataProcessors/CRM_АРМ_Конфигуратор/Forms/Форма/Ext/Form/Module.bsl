&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДЦ=Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	Элементы.ГруппаСтраховка.Видимость=ДЦ.ОтображатьСтраховкуКредитВКП;
	Элементы.ГруппаКредитНовая.Видимость=ДЦ.ОтображатьСтраховкуКредитВКП;
	
	Если ДЦ.ЗапретитьРедактированиеКП Тогда
		ТолькоПросмотр=Истина;
		Элементы.ПерезаписатьКонфигурацию.Доступность=Ложь;
	КонецЕсли;
	
	// начало Зеленчук
	Бренд = ПараметрыСеанса.DMS_Бренд;
	Элементы.ТаблицаЦветаДоплатаЗаЦвет.Видимость = Ложь;
	Если Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
		Элементы.ГруппаПродленнаяГарантия.Видимость = Ложь;
		Элементы.ТаблицаЦветаМеталлик.Видимость = Ложь;
		Элементы.ТаблицаЦветаДоплатаЗаЦвет.Видимость = Истина;
	КонецЕсли;
	ЦенаВыкупа = 0;
	// окончание Зеленчук
	ОбновитьДанныеПрикрепленныхФайлов();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеПрикрепленныхФайлов()
	ПрикрепленныеФайлы.Параметры.УстановитьЗначениеПараметра("Объект", ТекущееКП);
КонецПроцедуры	

&НаСервере
Функция ПолучитьСрокДействия(ДилЦентр)
	
	ЭтоКорпКлиент = Ложь;
	РабочийЛист = ПолучитьРабочийЛист(ТекущийРабочийЛист);
	Если РабочийЛист <> Неопределено 
		И РабочийЛист.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
		
		ЭтоКорпКлиент = Истина;
		
	КонецЕсли;
	
	Если ДилЦентр <> неопределено И ЗначениеЗаполнено(ДилЦентр.СрокДействияКпПоУмолчанию) Тогда
		
		Если Не ЭтоКорпКлиент И ЗначениеЗаполнено(ДилЦентр.СрокДействияКпПоУмолчанию) Тогда
			Ответ = КонецДня(ТекущаяДата()) + ДилЦентр.СрокДействияКпПоУмолчанию*60*60*24;
		ИначеЕсли ЭтоКорпКлиент И ЗначениеЗаполнено(ДилЦентр.СрокДействияКпПоУмолчаниюКОРП) Тогда
			Ответ = КонецДня(ТекущаяДата()) + ДилЦентр.СрокДействияКпПоУмолчаниюКОРП*60*60*24;
		ИначеЕсли ЭтоКорпКлиент Тогда
			Ответ = КонецДня(ТекущаяДата() + 30*24*60*60);
		Иначе
			Ответ = КонецДня(ТекущаяДата());
		КонецЕсли;
		
	Иначе
		
		Если ЭтоКорпКлиент Тогда
			Ответ = КонецДня(ТекущаяДата() + 30*24*60*60);
		Иначе
			Ответ = КонецДня(ТекущаяДата());
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

&НаСервере
Функция ПолучитьРабочийЛист(НомерЛиста)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", НомерЛиста);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции


&НаСервере
Процедура ПриОткрытииСервер()
	
	
	
	ЦветРено = Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ОсновнойЦвет); 
	
	Если ЭтоТрейдИН Тогда
		Элементы.ГруппаБазовыеОпции.Видимость = Ложь;
		Элементы.ГруппаАвтомобиль.Видимость = Ложь;
		Элементы.ОткрытьСклад.Видимость = Ложь;
		Элементы.ГруппаСклад.Видимость = Ложь;
	Иначе
		Элементы.ГруппаТрейдИнАвтомобиль.Видимость = Ложь; 
		Модель = Справочники.Модели.ПустаяСсылка();
		Версия = Справочники.ВариантыКомплектации.ПустаяСсылка();
		Цвет = Справочники.Цвета.ПустаяСсылка();
	КонецЕсли;
	Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
		Элементы.кнЛизинг.Видимость = Ложь;
		Элементы.кнОтказатьсяОтКонсультации.Видимость = Ложь;
		Элементы.кнПередатьВОтдел.Видимость = Ложь;
		Элементы.кнНазначитьИсполнителя.Видимость = Ложь;
	КонецЕсли;
	ТекДилерскийЦентр = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	ТипЦенКП = Renault_РаботаСПравамиПользователя.ПолучитьТипЦенКП(ТекДилерскийЦентр); 
	
	Если Автомобиль.Пустая() Тогда
		ТекущийТариф = Справочники.Renault_ТарифыНаАвтомобили.ПолучитьТарифДляРасчетаЦены();
	Иначе
		ТекущийТариф = Справочники.Renault_ТарифыНаАвтомобили.ПолучитьТарифДляРасчетаЦены(Год(Автомобиль.ГодВыпуска));		
	КонецЕсли;
	
	//РассылкаУчетнаяЗапись = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь).ОсновнаяУчетнаяЗаписьЭлПочты;
	РассылкаТемаСообщения ="Коммерческое предложение";
	СуммаДоставки = ТекДилерскийЦентр.СтоимостьДоставкиПоУмолчанию;
	СрокДействия = ПолучитьСрокДействия(ТекДилерскийЦентр);
	
	ГодВыпуска = Renault_ОбщегоНазначения.ПолучитьГодВыпуска(Автомобиль);	
	Если ГодВыпуска = 0 Тогда
		ГодВыпуска = Год(ТекущаяДата());
	КонецЕсли;
	
	Если ТрейдИнГодВыпуска = 0 Тогда
		ТрейдИнГодВыпуска = Год(ТекущаяДата());
	КонецЕсли;
	
	Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
	
	ПрочитатьДанныеКлиентаСервер();
	ОбновитьСписокМоделей();
	
	//Если ЗначениеЗаполнено(КлючТаблицыСпискаСкидок) Тогда
	//	ПолучитьСписокСкидок(КлючТаблицыСпискаСкидок);
	//КонецЕсли; 
	
	СоставКП.Параметры.УстановитьЗначениеПараметра("Ссылка", ТекущееКП);
	СписокКП.Параметры.УстановитьЗначениеПараметра("РабочийЛист", ТекущийРабочийЛист);
	
	ЗагрузитьЗаявкуНаТрейдИн();
	//Козлов Е.А. Начало 14.07.2016
	ОбновитьДанныеПоПродуктам();
	//Козлов Е.А. Конец 15.07.2016
	
	Если Renault_РаботаСПравамиПользователя.ЗапрашиватьПодтверждениеИзмененийВКП(ПараметрыСеанса.Пользователь) Тогда	
		
		ДействияЭлементовПриИзменении = Новый Соответствие;	
		ДействияЭлементовНачалоВыбора = Новый Соответствие;
		Для каждого Эл Из Элементы Цикл
			Попытка      
				Если НЕ ПустаяСтрока(Эл.ПолучитьДействие("НачалоВыбора"))
					И ТипЗнч(Эл) = Тип("ПолеФормы") Тогда
					ДействияЭлементовНачалоВыбора.Вставить(Эл.Имя, Эл.ПолучитьДействие("НачалоВыбора"));
					Эл.УстановитьДействие("НачалоВыбора","ОбработкаНачалаВыбораДанных");	        
				КонецЕсли;
				Если НЕ ПустаяСтрока(Эл.ПолучитьДействие("ПриАктивизацииСтроки"))
					И ТипЗнч(Эл) = Тип("ТаблицаФормы") Тогда
					//ДействияЭлементов.Вставить(Эл.Имя, Эл.ПолучитьДействие("ПриАктивизацииСтроки"));
					//Эл.УстановитьДействие("ПриАктивизацииСтроки","ОбработкаИзмененияДанных");				
				Иначе	
					Если НЕ ПустаяСтрока(Эл.ПутьКДанным) 
						И Не ЭлементПринадлежитТаблицеФормы(Эл) 
						И Не ТипЗнч(Эл) = Тип("ГруппаФормы") 
						И Не ТипЗнч(Эл) = Тип("КнопкаФормы") 
						И Не ТипЗнч(Эл) = Тип("ДекорацияФормы") Тогда
						ДействияЭлементовПриИзменении.Вставить(Эл.Имя, Эл.ПолучитьДействие("ПриИзменении"));
						Эл.УстановитьДействие("ПриИзменении","ОбработкаПриИзмененииДанных");
					КонецЕсли;
				КонецЕсли;     
			Исключение
			КонецПопытки;
		КонецЦикла;	   	
		АдресХранилищаПриИзменении = ПоместитьВоВременноеХранилище(ДействияЭлементовПриИзменении, Этаформа.УникальныйИдентификатор);	   	
		АдресХранилищаНачалоВыбора = ПоместитьВоВременноеХранилище(ДействияЭлементовНачалоВыбора, Этаформа.УникальныйИдентификатор);
		
	КонецЕсли;
		
КонецПроцедуры

