Процедура ЗаполнитьДанныеПГ()
	
	Если ЗначениеЗаполнено(КредитноеПредложение) Тогда
		Если КредитноеПредложение.БесплатнаяПГ И ЗначениеЗаполнено(КредитноеПредложение.ПродленнаяГарантия) Тогда
			БесплатнаяПГ = Истина;
			Набор = РегистрыСведений.CRM_СтоимостьПродленнойГарантии.СоздатьНаборЗаписей();
			Набор.Отбор.Модель.Установить(Модель);
			Набор.Отбор.ПредложениеПГ.Установить(КредитноеПредложение.ПродленнаяГарантия);
			Набор.Прочитать();
			
			ПродленнаяГарантия = КредитноеПредложение.ПродленнаяГарантия;
			Если Набор.Количество() Тогда
				ГарантияСумма = Набор[0].Сумма;
				Элементы.ДекорацияСубсидияПоПГ.Заголовок = "Субсидия по ПГ: " + Набор[0].Сумма;
				Элементы.ПГВКредит.Видимость = Ложь;
				ГарантияСуммаДляКлиента = Набор[0].Сумма;
			КонецЕсли;
		Иначе
			БесплатнаяПГ = Ложь;
			ГарантияСумма = 0;
			Элементы.ДекорацияСубсидияПоПГ.Заголовок = "";
			Элементы.ПГВКредит.Видимость = Истина;
		КонецЕсли;
	Иначе
		ГарантияСумма = 0;
		Элементы.ДекорацияСубсидияПоПГ.Заголовок = "";
		Элементы.ПГВКредит.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаКарточкуКлиентаНажатие(Элемент)
	
	Форма = ПолучитьФорму("ОбщаяФорма.CRM_ФормаКарточкиКлиента");
	Форма.Клиент = ТекущийКлиент;
	Форма.ЭлементыФормы.ПанельОсновная.ТекущаяСтраница = Форма.ЭлементыФормы.ПанельОсновная.Страницы.СтраницаФинансовыеУслуги;
	Форма.Открыть();
	
КонецПроцедуры

