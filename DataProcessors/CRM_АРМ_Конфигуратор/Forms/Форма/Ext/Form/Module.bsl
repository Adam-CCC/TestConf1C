		Попытка
			
			Профиль = Новый ИнтернетПочтовыйПрофиль;		
			
			Профиль.АдресСервераPOP3   = УчетнаяЗапись.POP3Сервер;
			Профиль.ПортPOP3           = УчетнаяЗапись.ПортPOP3;
			Профиль.АутентификацияPOP3 = эпПреобразоватьВСпособPOP3Аутентификации(УчетнаяЗапись.АутентификацияPOP3);
			Профиль.Пользователь       = УчетнаяЗапись.Логин;
			Профиль.Пароль             = УчетнаяЗапись.Пароль;
			Профиль.ИспользоватьSSLPOP3 = УчетнаяЗапись.ИспользоватьPOPSSL;
			
			Профиль.АдресСервераSMTP   = УчетнаяЗапись.SMTPСервер;
			Профиль.ПортSMTP           = УчетнаяЗапись.ПортSMTP;
			Профиль.АутентификацияSMTP = эпПреобразоватьВСпособSMTPАутентификации(УчетнаяЗапись.АутентификацияSMTP);
			Профиль.ПользовательSMTP   = УчетнаяЗапись.ЛогинSMTP;
			Профиль.ПарольSMTP         = УчетнаяЗапись.ПарольSMTP;
			Профиль.POP3ПередSMTP      = УчетнаяЗапись.POP3ПередSMTP;
			Профиль.ИспользоватьSSLSMTP = УчетнаяЗапись.ИспользоватьSMTPSSL;
			
			Если УчетнаяЗапись.ВремяОжиданияСервера > 0 Тогда
				Профиль.ВремяОжидания = УчетнаяЗапись.ВремяОжиданияСервера;
			КонецЕсли; 
			
			ИнтернетПочта = Новый ИнтернетПочта;  		
			
			Попытка
				ИнтернетПочта.Подключиться(Профиль);
				Письмо =  СоздатьПисьмо(ТемаСообщения, ТекстСообщения, АдресРассылки, УчетнаяЗапись,ПредставлениеОтправителя, МассивПутейКПрикрепляемымФайлам);
				ИнтернетПочта.Послать(Письмо);
			Исключение
				//Сообщить(элРазобратьОшибкуПочтовогоСоединения(), СтатусСообщения.Важное);
				//Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
				//Предупреждение("Произошли ошибки при проверке настроек учетной записи.
				//|Описание ошибки приведено в окне сообщения.");
				Возврат Ложь;
				
			КонецПопытки; 		
			
			//РежимОбмена = Новый Структура();
			//РежимОбмена.Вставить("Получить",Ложь);
			//РежимОбмена.Вставить("Отправить",Истина);
			//ПочтовыйЯщик = эпПодключитьсяКПочтовомуСерверу(УчетнаяЗапись,РежимОбмена);
			//  
			//УчетнаяЗапись= Справочники.УчетныеЗаписиЭлектроннойПочты.СоздатьЭлемент().
			//ПочтовыйЯщик.Послать(Письмо);
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	Возврат истина;
	
КонецФункции

&НаСервере

Функция ВернутьВыгружаемыеФайлы(ТекущееКП)
	Запрос = Новый ЗАпрос;
	ЗАпрос.Текст = "ВЫБРАТЬ
	               |	Renault_КартинкиИФайлы.Наименование,
	               |	Renault_КартинкиИФайлы.ИмяФайла,
	               |	Renault_КартинкиИФайлы.Данные,
	               |	Renault_КартинкиИФайлы.ДанныеВоВнешнемФайле
	               |ИЗ
	               |	РегистрСведений.Renault_КартинкиИФайлы КАК Renault_КартинкиИФайлы
	               |ГДЕ
	               |	Renault_КартинкиИФайлы.Объект = &Объект
	               |	И Renault_КартинкиИФайлы.ВыгружатьПоЭлектроннойПочте";
	Запрос.УстановитьПараметр("Объект",ТекущееКП);
	Выборка = ЗАпрос.Выполнить().Выбрать();
	Рез = Новый Массив;
	Пока Выборка.Следующий() цикл
		СтрокаРез = Новый Структура("Наименование,ИмяФайла,Данные,ДанныеВоВнешнемФайле");
		ЗаполнитьЗначенияСвойств(СтрокаРез,Выборка);
		Рез.Добавить(СтрокаРез);
	КонецЦикла;	
	Возврат Рез;
КонецФункции

&НаКлиенте

Функция ВернутьРасшиерениеИзИмениФайла(ИмяФайла)
	ПозицияТочки = СтрНайти(ИмяФайла,".",НаправлениеПоиска.СКонца);
	Если ПозицияТочки<>0 тогда
		Возврат Сред(ИмяФайла,ПозицияТочки);
	КонецЕсли;
	Возврат "";
КонецФункции	
	
&НаКлиенте
Функция СоздатьПисьмо(Тема, ТекстСообщения, Получатель, Отправитель,ПредставлениеОтправителя, ПутиКФайлам) Экспорт
	Сообщение = новый ИнтернетПочтовоеСообщение;
	//Сообщение.ДатаОтправления =ТекущаяДата();
	Сообщение.Тема = Тема;
	Сообщение.Тексты.Добавить(ТекстСообщения);
	Сообщение.Получатели.Добавить(Получатель);	
	Сообщение.Отправитель.Адрес = Отправитель.АдресЭлектроннойПочты;
	Сообщение.Отправитель.ОтображаемоеИмя =ПредставлениеОтправителя;// "Рассылка комерческих предложений(автомат)";
	Для Каждого ПутьКФайлу Из ПутиКФайлам Цикл
		Сообщение.Вложения.Добавить(ПутьКФайлу,"Комерческое предложение");
	КонецЦикла;
	Рег 	= ВернутьВыгружаемыеФайлы(ТекущееКП);
	Филе 	= Новый Файл;
	Для Каждого ТекФайл из Рег цикл
		ИмяФайла = ПолучитьИмяВременногоФайла(ВернутьРасшиерениеИзИмениФайла(ИмяФайла));
		Если ТекФайл.ДанныеВоВнешнемФайле тогда
			Сообщение.Вложения.Добавить(ИмяФайла,ТекФайл.Наименование);
		Иначе
			Файл = ТекФайл.Данные.Получить();
			Если ТипЗнч(Файл) = Тип("Картинка") Тогда
				Файл.Записать(ИмяФайла);
			ИначеЕсли ТипЗнч(Файл) = Тип("ДвоичныеДанные") Тогда
				Файл.Записать(ИмяФайла);
			Иначе
				ЗначениеВФайл(ИмяФайла, Файл);
			КонецЕсли;
			Сообщение.Вложения.Добавить(ПутьКФайлу,ТекФайл.Наименование);
		КонецЕсли;		
	КонецЦикла;	
	Возврат Сообщение;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьКП(Команда)
	
	//Если ЗначениеЗаполнено(ТекущееКП)И ЗначениеЗаполнено(Email)И ЗначениеЗаполнено(РассылкаУчетнаяЗапись) Тогда
	Если ЗначениеЗаполнено(ТекущееКП) Тогда
		
		МассивПутейКФайламКп = Новый Массив();
		ТабДок = Новый ТабличныйДокумент();
		МассивДок = Новый Массив();
		МассивДок.Добавить(ТекущееКП.Ссылка);
		Документы.CRM_КоммерческоеПредложение.Печать(МассивДок, ТабДок, "ПФ_MXL_КП");
		ИмяФайла = ПолучитьИмяВременногоФайла("PDF");
		ТабДок.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
		МассивПутейКФайламКп.Добавить(ИмяФайла); 
		Адресаты = Новый Массив();
		Адресаты.Добавить(Email);
		ЗаполненныйТекстСообщения = ЗаполнитьТекстЕмаилаПараметрами(РассылкаТекстСоообщения);
		Ответ =	РазослатьСообщение(РассылкаТемаСообщения,ЗаполненныйТекстСообщения,Адресаты,
		РассылкаУчетнаяЗапись,РассылкаПредставление,МассивПутейКФайламКп);
		
		Если Ответ = Истина Тогда
			Предупреждение("Сообщение отправлено");
		Иначе
			Предупреждение("Не удалось отправить сообщение, обратитесь в поддержку");
		КонецЕсли;
		
	Иначе
		Предупреждение("Необходимо сохранить предложение, заполнить email и указать учетную запись электронной почты");	
	КонецЕсли;	
	
КонецПроцедуры

