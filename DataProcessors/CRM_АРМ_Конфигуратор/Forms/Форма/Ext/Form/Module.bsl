&НаСервереБезКонтекста
Функция ПолучитьМенеджераОбслуживания(КлиентКП)
	МенеджерОбслуживания = Справочники.Сотрудники.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочиеЛисты.ДилерскийЦентр.КонтактЛицоОбслуживанияКорпКлиента КАК МенеджерОбслуживания
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.Renault_ТипыКлиентов.КорпоративныйКлиент)
	|	И Renault_РабочиеЛисты.Клиент = &Клиент"; 	
	Запрос.УстановитьПараметр("Клиент", КлиентКП); 	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда	
		Выборка = Результат.Выбрать();		
		Выборка.Следующий();
		
		МенеджерОбслуживания = Выборка.МенеджерОбслуживания;
	КонецЕсли;
	
	Возврат МенеджерОбслуживания;
КонецФункции

