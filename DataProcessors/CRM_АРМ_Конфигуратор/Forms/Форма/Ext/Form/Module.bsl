	Если Не(ЗначениеПустое) И (не(ДокОб = неопределено)) Тогда
		МожноСохранить = Ложь;
		Если НЕ ДокОб.ЭтоНовый() Тогда
			Если Не ДокОб.ВыполненаУспешно Тогда
				МожноСохранить = Истина;
			КонецЕсли;
		Иначе
			МожноСохранить = Истина;
		КонецЕсли;
		Если МожноСохранить тогда
			ДокОб.Версия = Версия;
			ДокОб.Дата = ТекущаяДата();
			ДокОб.Клиент = Метаданные.Документы.Renault_CRM_ЗаявкаНаГарантию.Реквизиты.Клиент.Тип.ПривестиЗначение(ТекущийКлиент);
