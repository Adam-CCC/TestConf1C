			//|					ИЗ
			//|						РегистрСведений.Renault_РеквизитыСкладовКомпании КАК Renault_РеквизитыСкладовКомпании
			//|					ГДЕ
			//|						Renault_РеквизитыСкладовКомпании.СкладПодержанныхАвто = ИСТИНА
			//|						И Renault_РеквизитыСкладовКомпании.СкладКомпании В (&МассивСкладовДилера))
			//|				И Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилей";
			//ДилерскийЦентрПользователя = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
			//МассивСкладовДилера = ДилерскийЦентрПользователя.СкладыДилера.ВыгрузитьКолонку("Склад");
			//Запрос.УстановитьПараметр("МассивСкладовДилера", МассивСкладовДилера);
			//Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
			
