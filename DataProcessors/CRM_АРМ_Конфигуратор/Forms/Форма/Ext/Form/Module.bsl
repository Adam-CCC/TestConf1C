	ОбработкаАктивизацииЦвета();
	//@++
	//ЭтаФорма.Модифицированность = Истина;
	//@--
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаАктивизацииЦвета()
	
	Если НеОбновлятьПриАктивизацииСтроки Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущийЭлемент <> Элементы.ТаблицаЦвета Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ТаблицаЦвета.ТекущиеДанные = Неопределено Тогда
		Цвет = Неопределено;
	ИначеЕсли Цвет = Элементы.ТаблицаЦвета.ТекущиеДанные.Цвет Тогда
		Возврат;
	Иначе
		Цвет = Элементы.ТаблицаЦвета.ТекущиеДанные.Цвет;
	КонецЕсли;
	
	ПроверитьОкраскуМеталлик();
	
	ПодключитьОбработчикОжидания("ОбновитьКартинкуМоделиКлиент", 0.2, Истина);
	
	//VIN = "";	
	//ОбновитьТаблицыСклад();
	
КонецПроцедуры

