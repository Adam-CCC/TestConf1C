Процедура ПечатьКП(Команда)
	// Вставить содержимое обработчика.
	КонфигурацияПерезаписать();
	
	КлючУникальности	= Новый УникальныйИдентификатор();
	ФормаПечати			= ПолучитьОбщуюФорму("ПечатнаяФормаДокументов",,КлючУникальности);
	ТабличныйДокумент	= ФормаПечати.ЭлементыФормы.ТабличныйДокумент;
	ТабличныйДокумент.ПолеСверху = 5;
	ТабличныйДокумент.ПолеСлева = 5;
	ТабличныйДокумент.ПолеСнизу = 5;
	ТабличныйДокумент.ПолеСправа = 0;
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.ПолеСверху = 5;
	ТабДок.ПолеСлева = 5;
	ТабДок.ПолеСнизу = 5;
	ТабДок.ПолеСправа = 0;
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ТекущееКП);
	ПараметрыКонфигурацииОбщие = ПолучитьДанныеПоКонфигурации(МассивОбъектов[0]);
	ТипыАвтомобилей = ПолучитьТипыАвтомобилей(ПараметрыКонфигурацииОбщие);
	
	Документы.CRM_КоммерческоеПредложение.Печать(МассивОбъектов, ТабДок, 0, ТипыАвтомобилей);
	
	ТабличныйДокумент.Вывести(ТабДок);
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ФормаПечати.ИзменятьСпособОтображенияОкна = ИзменениеСпособаОтображенияОкна.Разрешить;
	ФормаПечати.Объект = МассивОбъектов[0];
	ФормаПечати.ОбъектПредставление = Строка(МассивОбъектов[0]);
	ФормаПечати.Открыть()
	
