&НаСервере
Процедура СохранитьДанныеКлиента(ФИО, Телефон, Email)
	
	КлиентОбъект = ТекущийКлиент.ПолучитьОбъект();
	КлиентОбъект.Наименование = ФИО;
	КлиентОбъект.НаименованиеПолное = ФИО;
	КлиентОбъект.Записать();
	
	Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойТелефонКлиента(Телефон, ТекущийКлиент);
	
	Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойEmailКлиента(Email, ТекущийКлиент);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКлиентаСервер()
	
	Телефон = "";
	Email = "";
	ФИО = "";
	
	Если ЗначениеЗаполнено(ТекущийКлиент) Тогда
		
		Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(ТекущийКлиент);		
		Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(ТекущийКлиент);		
		ФИО = ТекущийКлиент.НаименованиеПолное;
		СогласиеНаОбработкуПерсональныхДанных = ТекущийКлиент.СогласиеНаОбработкуПерсональныхДанных;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКП()
	
	НомерКП = "";
	ДатаКП = Неопределено;
	
	Если ЗначениеЗаполнено(ТекущееКП) Тогда
		НомерКП = ТекущееКП.Номер;
		ДатаКП = ТекущееКП.Дата;
		СрокДействия = ТекущееКП.СрокДействия;
		ДатаНачалаПередачиАвто    = ТекущееКП.ДатаНачалаПередачиАвто;
		ДатаОкончанияПередачиАвто = ТекущееКП.ДатаОкончанияПередачиАвто;
		Если ТекущееКП.Состав.Количество()>0 Тогда
			ТекущаяКонфигурация = ТекущееКП.Состав[0].Конфигурация;
		КонецЕсли;
		ИнтересовалсяТрейдИн = ТекущееКП.ИнтересовалсяТрейдИн;
		ИнтересовалсяСтраховкой = ТекущееКП.ИнтересовалсяСтраховкой;
		ИнтересовалсяУтилизацией = ТекущееКП.ИнтересовалсяУтилизацией;
		ТипКП=ТекущееКП.ТипКП;
		//ЗаявкаНаКредит = ТекущееКп.ЗаявкаНаКредит;
		//ЗаявкаНаСтраховку = ТекущееКП.ЗаявкаНаСтраховку;
		ЗаявкаНаГарантию = ТекущееКП.ЗаявкаНаГарантию;
		ИнтересовалсяКредитом = ТекущееКП.ИнтересовалсяКредитом;
		ИнтересовалсяОборудованием = ТекущееКП.ИнтересовалсяОборудованием;
		ЗаявкаНаОборудование = ТекущееКП.ЗаявкаНаОборудование;
		ЗагрузитьЗаявкуНаТрейдИн();
		ЗагрузитьЗаявкуНаКредит();
		ЗагрузитьЗаявкуНаГарантию();
		ЗагрузитьЗаявкуНаОборудование();
		ЗагрузитьЗаявкуНаСтраховку();
		ЗагрузитьСписокСкидок();
	КонецЕсли;
	
КонецПроцедуры


Процедура ЗагрузитьСписокСкидок()	
	УИДКонфигурации = Строка(ТекущаяКонфигурация.УникальныйИдентификатор());
	Отбор = Новый Структура("ИдентификаторКонфигурации", УИДКонфигурации);
	НайденныеСтрокиСкидок = ТекущееКП.СкидкиКонфигурации.НайтиСтроки(Отбор);
	
	Для Каждого Эл Из НайденныеСтрокиСкидок Цикл
		Строка = СписокСкидок.Добавить();
		Строка.ТипСкидки = Эл.ТипСкидки;
		Строка.СуммаСкидки = Эл.СуммаСкидки;
		Строка.Акция = Эл.Акция;	
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Процедура ЗагрузитьЗаявкуНаТрейдИн()
	
	ИнтересовалсяТрейдИн = Ложь;
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("РабочийЛист", ТекущийРабочийЛист);
	//Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
	//Если Выборка.Следующий() Тогда
	//	ЗаявкаНаТрейдИн = Выборка.Ссылка;
	//	ИнтересовалсяТрейдИн = Истина;
	//КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		ТрЗаявка = ЗаявкаНаТрейдИн;
	Иначе
		ТрЗаявка = НайтиЗаявкуТрейдИн();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТрЗаявка) тогда
		
		ЗаявкаНаТрейдИн = ТрЗаявка;
		ИнтересовалсяТрейдИн = Истина;
		
		// начало добавление Зеленчук
		Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн.ЦенаВыкупа) Тогда
			ЦенаВыкупа = ЗаявкаНаТрейдИн.ЦенаВыкупа;
		ИначеЕсли ЗначениеЗаполнено(ЗаявкаНаТрейдИн.ОриентировочнаяЦена) Тогда
			ЦенаВыкупа = ЗаявкаНаТрейдИн.ОриентировочнаяЦена;
		КонецЕсли;
		// окончание добавление Зеленчук
		ТрейдИнСумма = ЦенаВыкупа;
		ТрейдИнМодель = ЗаявкаНаТрейдИн.Автомобиль.Модель;
		ТрейдИнВерсия = ЗаявкаНаТрейдИн.Автомобиль.ВариантКомплектации;
		ТрейдИнМарка = ЗаявкаНаТрейдИн.ПроизводительКод;
		ТрейдИнЦвет =  ЗаявкаНаТрейдИн.Автомобиль.Цвет;
		ТрейдИнГодВыпуска = ЗаявкаНаТрейдИн.ГодВыпуска;
		ТрейдИнПробег = ЗаявкаНаТрейдИн.Пробег;	
		
		// КовалевЕС от 30.05.19 {
		ПолученнаяСуммаТрейдИн = ПолучитьЦенуВыкупленногоАвто(ЗаявкаНаТрейдИн.Автомобиль);
		Если ПолученнаяСуммаТрейдИн <> 0 Тогда
			ТрейдИнСумма = ПолученнаяСуммаТрейдИн;		
		КонецЕсли;	
		// КовалевЕС от 30.05.19 } 
		
	КонецЕсли;
		
	Элементы.ОстальноеТрейдИн.Видимость = ИнтересовалсяТрейдИн;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуВыкупленногоАвто(Автомобиль)

	ЦенаВыкупа = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки
	|ГДЕ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ПоступлениеАвтомобилейАвтомобили.Renault_СуммаЗачет <> 0
	|			ТОГДА ПоступлениеАвтомобилейАвтомобили.Renault_СуммаЗачет
	|		ИНАЧЕ ПоступлениеАвтомобилейАвтомобили.СуммаВсего
	|	КОНЕЦ КАК СуммаВсего
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ПоступлениеАвтомобилейАвтомобили.Автомобиль = ВТОстатки.Автомобиль
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();	
		
		ЦенаВыкупа = Выборка.СуммаВсего;
	КонецЕсли;
	
	Возврат ЦенаВыкупа;
	
КонецФункции

&НаСервере
Функция НайтиЗаявкуТрейдИн()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_РабочиеЛисты.СвязаныйIDK,
	|	Renault_РабочиеЛисты.IDK
	|ИЗ
	|	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
	|ГДЕ
	//|	Renault_РабочиеЛисты.ТипРабочегоЛиста = &ТипРабочегоЛиста
	|	Renault_РабочиеЛисты.СвязаныйIDK = &СвязаныйIDK";
	Запрос.УстановитьПараметр("ТипРабочегоЛиста", Перечисления.Renault_ТипыРабочихЛистов.TradeIn);
	Запрос.УстановитьПараметр("СвязаныйIDK", ТекущийРабочийЛист);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Renault_ЗаявкаНаТрейдИн.Ссылка
		|ИЗ
		|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
		|ГДЕ
		|	Renault_ЗаявкаНаТрейдИн.РабочийЛист = &РабочийЛист
		|	И Renault_ЗаявкаНаТрейдИн.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("РабочийЛист", Выборка.idk);
		Выб = Запрос.Выполнить().Выбрать();
		
		Если Выб.Следующий() Тогда
			
			Возврат Выб.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ОбновитьСписокЦветов(ТекМодель)
	
	Металлик = Ложь;
	Для Каждого Стр Из ВыбранныеНебазовыеОпции Цикл
		Если Стр.Выбран Тогда
			Если Найти(Стр.Опция.Наименование, "металлик")>0 или Найти(Стр.Опция.Наименование, "Металлик")>0 Тогда
				Металлик = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	мИсключаемых = Новый Массив;
	мВыбранных = Новый Массив;
	
	Если ОтборПоЦветам и ЗначениеЗаполнено(ТекНаборЦветов) Тогда
		Для Каждого СтрокаТЗ из ТекНаборЦветов.Цвета Цикл
			Если СтрокаТЗ.Исключаемый Тогда
				мИсключаемых.Добавить(СтрокаТЗ.Цвет);
			Иначе
				мВыбранных.Добавить(СтрокаТЗ.Цвет);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ
	|	&ПустаяСтрока КАК Цвет,
	|	"""" КАК Код,
	|	"""" КАК ЦветНаименование,
	|	ЛОЖЬ КАК Металлик,
	|	0 КАК ДоплатаЗаЦвет
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_ЦветаМоделей.Цвет,
	|	Renault_ЦветаМоделей.Цвет.Артикул,
	|	Renault_ЦветаМоделей.Цвет.Наименование,
	|	ВЫБОР
	|		КОГДА Renault_ЦветаМоделей.Цвет = &Цвет
	|			ТОГДА &Металлик
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	Renault_ЦветаМоделей.ДоплатаЗаЦвет
	|ИЗ
	|	РегистрСведений.Renault_ЦветаМоделей КАК Renault_ЦветаМоделей
	|ГДЕ
	|	Renault_ЦветаМоделей.Модель = &Модель" +
	
	?(мИсключаемых.Количество() = 0,"", " И НЕ Renault_ЦветаМоделей.Цвет В (&ЦветаИсключаемые) ")+   
	?(мВыбранных.Количество() = 0,"", " И Renault_ЦветаМоделей.Цвет В (&ЦветаВыбраны) ")+
	
	" УПОРЯДОЧИТЬ ПО
	|	ЦветНаименование";
	
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ЦветаИсключаемые", мИсключаемых);
	Запрос.УстановитьПараметр("ЦветаВыбраны", мВыбранных);
	Запрос.УстановитьПараметр("ПустаяСтрока", Справочники.Цвета.ПустаяСсылка());
	Запрос.УстановитьПараметр("Цвет", Цвет);
	Запрос.УстановитьПараметр("Металлик", Металлик);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Таблица.Очистить();
	КонецЕсли;
	
	ТаблицаЦвета.Загрузить(Таблица);
	//Цвет = Справочники.Цвета.ПустаяСсылка();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокМоделей()
	
	Бренд = ПараметрыСеанса.DMS_Бренд;
	
	Если ЗначениеЗаполнено(Бренд) Тогда
		МаркаРено = Бренд;
	Иначе
		МаркаРено = CRM_Сервер.ПолучитьМаркуRenault();
	КонецЕсли;
	
	МассивМарок = Новый Массив;
	Если Не МаркаРено.Пустая() Тогда
		Если Не ЗначениеЗаполнено(Автомобиль) Тогда
			МассивМарок = МаркаРено.МоделиАвтомобилейКоммерческоеПредложение.ВыгрузитьКолонку("Модель");
		Иначе
			МассивМарок = МаркаРено.МоделиАвтомобилей.ВыгрузитьКолонку("Модель");
		КонецЕсли;
	КонецЕсли;
	
	Элементы.Модель1.СписокВыбора.ЗагрузитьЗначения(МассивМарок);
	
	Для Каждого Элемент Из МассивМарок Цикл
		Если Не Элемент.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Элемент1 Из Элементы.Модель1.СписокВыбора Цикл
			Если Элемент1.Значение = Элемент Тогда
				Элементы.Модель1.СписокВыбора.Удалить(Элемент1);
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКонфигураций(ТекМодель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&ПустаяСтрока КАК Ссылка
	|ПОМЕСТИТЬ ВТКомплектации
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации
	|ИЗ
	|	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних(
	|			,
	|			Тариф = &Тариф
	|				И Модель = &Модель) КАК Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних
	|ГДЕ
	|	(Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ДоступноКЗаказуВПроизводство = ИСТИНА
	|			ИЛИ НЕ &СкрыватьНедоступныеКЗаказу)
	|	И Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.Модель.ПометкаУдаления = ЛОЖЬ
	|	И Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(
	|			,
	|			СкладКомпании В (&СкладыДилера)
	|				И Автомобиль.Модель = &Модель) КАК ОстаткиАвтомобилейОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ЗаконтрактованныеАвтомобили.СрезПоследних КАК Renault_ЗаконтрактованныеАвтомобилиСрезПоследних
	|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
	|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = Renault_УтвержденныеРезервы.Автомобиль
	|ГДЕ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
	|	И Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Автомобиль ЕСТЬ NULL
	|	И Renault_УтвержденныеРезервы.Автомобиль ЕСТЬ NULL
	|	И НЕ &ТолькоДоступныеКЗаказуВерсии
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Renault_ОстаткиАвтомобилейДругихТочек.Автомобиль.ВариантКомплектации
	|ИЗ
	|	РегистрСведений.Renault_ОстаткиАвтомобилейДругихТочек КАК Renault_ОстаткиАвтомобилейДругихТочек
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ЗаконтрактованныеАвтомобили.СрезПоследних КАК Renault_ЗаконтрактованныеАвтомобилиСрезПоследних
	|		ПО Renault_ОстаткиАвтомобилейДругихТочек.Автомобиль = Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
	|		ПО Renault_ОстаткиАвтомобилейДругихТочек.Автомобиль = Renault_УтвержденныеРезервы.Автомобиль
	|ГДЕ
	|	Renault_ЗаконтрактованныеАвтомобилиСрезПоследних.Автомобиль ЕСТЬ NULL
	|	И Renault_УтвержденныеРезервы.Автомобиль ЕСТЬ NULL
	|	И Renault_ОстаткиАвтомобилейДругихТочек.Автомобиль.Модель = &Модель
	|	И НЕ &ТолькоДоступныеКЗаказуВерсии
	|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	Renault_ДоговорСоставДоговора.Автомобиль.ВариантКомплектации
	//|ИЗ
	//|	РегистрСведений.Renault_ЗаказыВПроизводствоПодКлиентов КАК Renault_ЗаказыВПроизводствоПодКлиентов
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
	//|		ПО Renault_ЗаказыВПроизводствоПодКлиентов.Договор = Renault_ДоговорСоставДоговора.Ссылка
	//|			И Renault_ЗаказыВПроизводствоПодКлиентов.ИдентификаторСтрокиДоговора = Renault_ДоговорСоставДоговора.Идентификатор
	//|ГДЕ
	//|	Renault_ЗаказыВПроизводствоПодКлиентов.Модель = &Модель
	//|	И НЕ Renault_ДоговорСоставДоговора.Автомобиль ЕСТЬ NULL
	//|	И НЕ &ТолькоДоступныеКЗаказуВерсии
	//|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СостояниеАвтомобилей.Автомобиль.ВариантКомплектации
	|ИЗ
	|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК СостояниеАвтомобилей
	|ГДЕ
	|	СостояниеАвтомобилей.Автомобиль <> ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
	|	И СостояниеАвтомобилей.Модель = &Модель
	|	И СостояниеАвтомобилей.Статус = ЗНАЧЕНИЕ(Перечисление.CRM_СтатусыАвтомобилей.ВпутиКДилеру)
	|	И НЕ &ТолькоДоступныеКЗаказуВерсии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТКомплектации.Ссылка КАК Ссылка,
	|	ВТКомплектации.Ссылка.Артикул КАК Код,
	|	ВЫРАЗИТЬ(ВТКомплектации.Ссылка.НаименованиеПолное КАК СТРОКА(150)) КАК Комплектация
	|ИЗ
	|	ВТКомплектации КАК ВТКомплектации
	|ГДЕ
	|	НЕ ВТКомплектации.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Комплектация";
	
	ДЦ =Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	Запрос.УстановитьПараметр("Модель", ТекМодель);
	Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
	Запрос.УстановитьПараметр("СкладыДилера", ДЦ.СкладыДилера.ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("ПустаяСтрока", Справочники.ВариантыКомплектации.ПустаяСсылка());
	Запрос.УстановитьПараметр("СкрыватьНедоступныеКЗаказу", Не ЗначениеЗаполнено(Автомобиль) ИЛИ ТолькоДоступныеКЗаказуВерсии);
	Запрос.УстановитьПараметр("ТолькоДоступныеКЗаказуВерсии",ТолькоДоступныеКЗаказуВерсии);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Таблица.Очистить();
	КонецЕсли;
	
	ТаблицаКомплектации.Загрузить(Таблица);
	
	Если ЗначениеЗаполнено(Версия) Тогда
		Если Версия.Владелец <> ТекМодель Тогда
			Версия = Справочники.ВариантыКомплектации.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

