&НаКлиенте
Процедура ОпцииДилераДобавитьИзСправочника(Команда)
	
	НоваяОпция = Справочники.Номенклатура.ПолучитьФормуВыбора().ОткрытьМодально();
	
	Если ЗначениеЗаполнено(НоваяОпция) И Не НоваяОпция.ЭтоГруппа Тогда
		
		//Проверим наличие данной опции в списке
		Отбор = Новый Структура("Номенклатура", НоваяОпция);
		МассивСтрок = ВыбранноеОборудование.НайтиСтроки(Отбор);
		Если МассивСтрок.Количество() > 0 Тогда
			//Данная строка уже есть в списке, увеличим количество
			НовСтрока = МассивСтрок[0];
			НовСтрока.Количество = НовСтрока.Количество + 1;
		Иначе
			
			//Добавим в список
			НовСтрока = ВыбранноеОборудование.Добавить();
			НовСтрока.Номенклатура = НоваяОпция;
			НовСтрока.Количество = 1;
			
			//Подставим цену //Доделать
			//На текущий момент подставляется чистая цена из регистра, без учета скидок
			//Вопрос автоматических скидок необходимо проработать
			//Renault Е.А. 
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ТипЦен", ТипЦенКП);
			Запрос.УстановитьПараметр("Номенклатура", НоваяОпция);
			Запрос.Текст = "ВЫБРАТЬ
			|	ЦеныСрезПоследних.Цена
			|ИЗ
			|	РегистрСведений.Цены.СрезПоследних(
			|			,
			|			ТипЦен = &ТипЦен
			|				И Номенклатура = &Номенклатура) КАК ЦеныСрезПоследних";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				НовСтрока.Цена = Выборка.Цена;
			КонецЕсли;
			
		КонецЕсли;
		
		//Расчитаем сумму строки
		НовСтрока.Сумма = НовСтрока.Цена * НовСтрока.Количество;
		
		ПересчитатьЦенуАвто();
		
	КонецЕсли;
	
КонецПроцедуры

