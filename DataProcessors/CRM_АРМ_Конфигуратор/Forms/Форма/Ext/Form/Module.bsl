		//Элементы.ДекорацияПроцент.Заголовок = "% (" + Строка(МинимальныйПервоначальныйВзнос) + " - " + Строка(МаксимальныйПервоначальныйВзнос) + " %)";
		
	Иначе
		
		Элементы.ДопустимыеСрокиКредита.Заголовок = "";
		//Элементы.ДекорацияПроцент.Заголовок = "";
		
	КонецЕсли;
	
