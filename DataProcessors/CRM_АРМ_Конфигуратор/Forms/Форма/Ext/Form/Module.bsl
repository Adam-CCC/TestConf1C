&НаСервере 
Функция ПолучитьЗначенияПараметровШаблонаЕмаил()
	
	ПараметрыЕмаил = Новый СписокЗначений();
	Если ЗначениеЗаполнено(ТекущийКлиент) Тогда
		ПараметрыЕмаил.Добавить(ТекущийКлиент.Наименование,"{Клиент}");
	Иначе
		ПараметрыЕмаил.Добавить(" ","{Клиент}");
	КонецЕсли;
	ДЦ =Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	Если ЗначениеЗаполнено(ДЦ) Тогда
		ПараметрыЕмаил.Добавить(ДЦ.Наименование,"{Дилер}");
		Если ЗначениеЗаполнено(Дц.Организация) Тогда
			Мен = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Мен.Вид = Справочники.ВидыКонтактнойИнформации.АдресФактический;
			Мен.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
			Мен.Объект = Дц.Организация;
			Мен.Прочитать();
			Если Мен.Выбран() Тогда
				ПараметрыЕмаил.Добавить(Мен.Поле4,"{Город}");
			Иначе
				ПараметрыЕмаил.Добавить(" ","{Город}");
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	Иначе
		ПараметрыЕмаил.Добавить(" ","{Дилер}");
		ПараметрыЕмаил.Добавить(" ","{Город}");
	КонецЕсли;
	Если ЗначениеЗаполнено(Менеджер)Или ЗначениеЗаполнено(ПараметрыСеанса.Пользователь.Сотрудник) Тогда
		ПараметрыЕмаил.Добавить(?(ЗначениеЗаполнено(Менеджер),Менеджер.Наименование,ПараметрыСеанса.Пользователь.Сотрудник.Наименование),"{Менеджер}");
		ПараметрыЕмаил.Добавить(Renault_CRM.ПолучитьТелефонКлиент(?(ЗначениеЗаполнено(Менеджер),Менеджер,ПараметрыСеанса.Пользователь.Сотрудник)),"{Телефон}");
	Иначе
		ПараметрыЕмаил.Добавить(" ","{Менеджер}");
		ПараметрыЕмаил.Добавить(" ","{Телефон}");
	КонецЕсли;
	Если ЗначениеЗаполнено(Модель) Тогда
		ПараметрыЕмаил.Добавить(Модель.Наименование,"{Модель}");
	Иначе
		ПараметрыЕмаил.Добавить(" ","{Модель}");
	КонецЕсли;
	
	Возврат ПараметрыЕмаил;
	
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьТекстЕмаилаПараметрами(ШаблонТекстаЕмаил)
	ПараметрыЕмаил = ПолучитьЗначенияПараметровШаблонаЕмаил();
	Ответ = ШаблонТекстаЕмаил;
	Для Каждого Пар из ПараметрыЕмаил Цикл
		Ответ = СтрЗаменить(Ответ,Пар.Представление,Пар.Значение);
	КонецЦикла;
	Возврат Ответ;	
	
