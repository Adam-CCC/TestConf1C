&НаСервере
Процедура ОбновитьДанныеКредита()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КредитнаяПрограмма", КредитнаяПрограмма);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_ПараметрыКредитныхПрограмм.МинимальныйСрокКредита,
	|	CRM_ПараметрыКредитныхПрограмм.МаксимальныйСрокКредита,
	|	CRM_ПараметрыКредитныхПрограмм.МинимальныйПервоначальныйВзнос,
	|	CRM_ПараметрыКредитныхПрограмм.МаксимальныйПервоначальныйВзнос,
	|	CRM_ПараметрыКредитныхПрограмм.СтавкаБанка,
	|	CRM_ПараметрыКредитныхПрограмм.МаркетинговаяСтавка
	|ИЗ
	|	РегистрСведений.CRM_ПараметрыКредитныхПрограмм КАК CRM_ПараметрыКредитныхПрограмм
	|ГДЕ
	|	CRM_ПараметрыКредитныхПрограмм.КредитнаяПрограмма = &КредитнаяПрограмма";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		МинимальныйСрокКредита 				= Выборка.МинимальныйСрокКредита;
		МаксимальныйСрокКредита 			= Выборка.МаксимальныйСрокКредита;
		МинимальныйПервоначальныйВзнос 		= Выборка.МинимальныйПервоначальныйВзнос;
		МаксимальныйПервоначальныйВзнос 	= Выборка.МаксимальныйПервоначальныйВзнос;
		СтавкаБанка 						= Выборка.СтавкаБанка;
		МаркетинговаяСтавка 				= Выборка.МаркетинговаяСтавка;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("ГодПроизводства", ГодВыпуска);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(CRM_СтоимостьПродленнойГарантии.ПредложениеПГ, ЗНАЧЕНИЕ(Справочник.CRM_ПредложенияПродленнойГарантии.ПустаяСсылка)) КАК ПГ,
	|	ЕСТЬNULL(CRM_СтоимостьПродленнойГарантии.Сумма, 0) КАК Сумма
	|ИЗ
	|	РегистрСведений.CRM_ПрименениеКредитныхПрограмм КАК CRM_ПрименениеКредитныхПрограмм
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СтоимостьПродленнойГарантии КАК CRM_СтоимостьПродленнойГарантии
	|		ПО CRM_ПрименениеКредитныхПрограмм.ПГВПодарок = CRM_СтоимостьПродленнойГарантии.ПредложениеПГ
	|			И CRM_ПрименениеКредитныхПрограмм.Модель = CRM_СтоимостьПродленнойГарантии.Модель
	|ГДЕ
	|	CRM_ПрименениеКредитныхПрограмм.Модель = &Модель
	|	И CRM_ПрименениеКредитныхПрограмм.Версия = &Версия
	|	И CRM_ПрименениеКредитныхПрограмм.ГодПроизводства = &ГодПроизводства
	|	И CRM_ПрименениеКредитныхПрограмм.КредитнаяПрограмма = &КредитнаяПрограмма";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ГарантияСумма < Выборка.Сумма Тогда
			ПродленнаяГарантия = Выборка.ПГ;
			ГарантияСумма = Выборка.Сумма;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьКредит()
	
	Если ЗначениеЗаполнено(СтавкаБанка) И ЗначениеЗаполнено(СрокКредита) Тогда
		Для Каждого Строка ИЗ ВыбранноеОборудование Цикл
			Строка.СуммаВКредит = РассчитатьПлатеж(СтавкаБанка, Строка.Сумма, СрокКредита);
		КонецЦикла;
	КонецЕсли;
	
	ПервоначальныйВзносСумма = (ПервоначальныйВзносПроцент/100) * (ЦенаВариантаКомплектации + СуммаДоставки + ЦенаДопОпций) - ?(ИнтересовалсяТрейдИн, ТрейдИнСумма, 0);
	Если (ПервоначальныйВзносПроцент/100) * (ЦенаВариантаКомплектации + СуммаДоставки + ЦенаДопОпций) - ?(ИнтересовалсяТрейдИн, ТрейдИнСумма, 0) < 0 Тогда
		Если (ЦенаВариантаКомплектации + СуммаДоставки + ЦенаДопОпций) = 0 Тогда
			
			ПервоначальныйВзносПроцент = 0;
			
		Иначе
			
			ПервоначальныйВзносПроцент = ?(ИнтересовалсяТрейдИн, ТрейдИнСумма, 0) / (ЦенаВариантаКомплектации + СуммаДоставки + ЦенаДопОпций) * 100;
			
		КонецЕсли;
		
	КонецЕсли;
	ПервоначальныйВзносСуммаИтого = ПервоначальныйВзносСумма + ?(ИнтересовалсяТрейдИн, ТрейдИнСумма, 0);
	СуммаКредита = (ЦенаВариантаКомплектации + СуммаДоставки + ЦенаДопОпций + СуммаДопОпцийСумма + ?(ИнтересовалсяТрейдИн, ТрейдИнРефинансирование, 0)) - ПервоначальныйВзносСуммаИтого + (?((КАСКОВКредит И СтраховкаКАСКОВключать И ИнтересовалсяСтраховкой), СтраховкаКАСКОСумма, 0)) + ?(ПГВКредит, ГарантияСумма, 0);
	
	Если ЗначениеЗаполнено(КредитноеПредложение) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МаркетинговаяСтавка,
		|	БанковскаяСтавка СтавкаБанка
		|ИЗ Справочник.Renault_КредитныеПредложения.КредитныеСтавки
		|ГДЕ Ссылка=&Ссылка
		|	И ПервоначальныйВзносОт<=&ПервоначальныйВзносПроцент
		|	И ПервоначальныйВзносДо >= &ПервоначальныйВзносПроцент
		|	И СрокКредитаОт <= &СрокКредита
		|	И СрокКредитаДо >= &СрокКредита";
		Запрос.УстановитьПараметр("Ссылка", КредитноеПредложение);
		Запрос.УстановитьПараметр("ПервоначальныйВзносПроцент", ПервоначальныйВзносПроцент);
		Запрос.УстановитьПараметр("СрокКредита", СрокКредита);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			МаркетинговаяСтавка = Выборка.МаркетинговаяСтавка;
			СтавкаБанка = Выборка.СтавкаБанка;
			
			Если ИспользуетсяРазумноеКАСКО Тогда
				МаркетинговаяСтавка = МаркетинговаяСтавка - КредитноеПредложение.СубсидияПоСтавке;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если СрокКредита <> 0 Тогда
		
		Если СтавкаБанка <> 0 Тогда
			
			//ИсходнаяСуммаКредита = СуммаКредита - ПервоначальныйВзносСумма;
			ЦенаАвтомобиляДляРасчетаСубсидии = ЦенаВариантаКомплектации + СуммаДоставки + ГарантияСумма + СуммаДопОпцийСумма + ЦенаДопОпций + ЦенаОборудования + ЦенаАксессуаров;
			ИсходнаяСуммаКредита = ЦенаАвтомобиляДляРасчетаСубсидии - ПервоначальныйВзносСуммаИтого;
			
			Если МаркетинговаяСтавка = 0 Тогда
				СубсидияПоКредитнойПрограмме = ИсходнаяСуммаКредита * (1-(1/СрокКредита)*(Pow((1+СтавкаБанка/1200), СрокКредита)-1)/((СтавкаБанка/1200)*Pow((1+СтавкаБанка/1200), СрокКредита)));
			Иначе
				СубсидияПоКредитнойПрограмме = ИсходнаяСуммаКредита * (1-(МаркетинговаяСтавка/СтавкаБанка)*Pow(((1+МаркетинговаяСтавка/1200)/(1+СтавкаБанка/1200)),СрокКредита)*((Pow(1+СтавкаБанка/1200, СрокКредита)-1)/(Pow(1+МаркетинговаяСтавка/1200, СрокКредита)-1)));
			КонецЕсли;
			
			ЦенаАвтомобиляПослеСубсидирования = ЦенаАвтомобиляДляРасчетаСубсидии - СубсидияПоКредитнойПрограмме - ГарантияСуммаДляКлиента;
			
			Если ДопОборудованиеВКредит Тогда
				СтоимостьДопОборудованияВКредит = ЦенаДопОпций + ЦенаОборудования + ЦенаАксессуаров;
			Иначе
				СтоимостьДопОборудованияВКредит =  0;
			КонецЕсли;
			
			ЦенаАвтомобиляИтоговая = ЦенаАвтомобиляПослеСубсидирования + СтоимостьДопОборудованияВКредит + ГарантияСумма;
			
			//СуммаКредитаИтоговая = ИсходнаяСуммаКредита + (?(КАСКОВКредит И СтраховкаКАСКОВключать И ИнтересовалсяСтраховкой, СтраховкаКАСКОСумма, 0));
			
			СуммаКредитаПослеСубсидирования = ИсходнаяСуммаКредита - СубсидияПоКредитнойПрограмме - ГарантияСуммаДляКлиента + ГарантияСумма;
			Если ВключитьЗащитуКредита Тогда
				СуммаЗащитыКредита = СуммаКредитаПослеСубсидирования*СтавкаЗащитыКредита/100*СрокКредита + ФиксированнаяЧастьЗащитыКредита*(1+СтавкаЗащитыКредита/100*СрокКредита);
			Иначе
				СуммаЗащитыКредита = 0;
			КонецЕсли;
			СуммаКредита = СуммаКредита + СуммаЗащитыКредита;
			СуммаКредитаИтоговая = СуммаКредитаПослеСубсидирования + СуммаЗащитыКредита;
			
			СуммаКредитаИтоговая = СуммаКредитаИтоговая + (?(КАСКОВКредит И СтраховкаКАСКОВключать И ИнтересовалсяСтраховкой, СтраховкаКАСКОСумма, 0)) + ?(ПГВКредит, ГарантияСумма, 0) + ?(ИнтересовалсяТрейдИн, ТрейдИнРефинансирование, 0);
			
			ЕжемесячныйПлатеж = РассчитатьПлатеж(СтавкаБанка, СуммаКредитаИтоговая, СрокКредита);
			
		Иначе
			
			ЕжемесячныйПлатеж = СуммаКредита / СрокКредита;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СрокКредитаПриИзменении(Элемент)
	
	Проверка = ПроверитьПоПрограмме();
	Если Проверка = Ложь Тогда
		Ответ = ПолучитьДоступныеЗначения(, (СрокКредита*12));
		Если Ответ.Количество() = 0 Тогда
			//ПервоначальныйВзносПроцент = (ПервоначальныйВзносСумма / СуммаКредита) * 100;
			Предупреждение("Значение не подходит по кредитной программе.");
			СрокКредита = КредитноеПредложение.СрокПоУмолчанию / 12;
			НеобходимоСменитьКредитнуюПрограмму = Истина;
		Иначе
			Если Ответ.Количество() = 1 Тогда
				Строка = Ответ[0];
			Иначе
				Строка = Ответ.ВыбратьСтроку("Выберите подходящее условие");
				//СрокКредита = Строка.МаксСрок;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПересчитатьКредит();
	ОбновитьНадписьСубсидии();
	
КонецПроцедуры

&НаКлиенте
Процедура ПервоначальныйВзносПроцентПриИзменении(Элемент)
	
	Проверка = ПроверитьПоПрограмме();
	Если Проверка = Ложь Тогда
		Ответ = ПолучитьДоступныеЗначения(ПервоначальныйВзносПроцент);
		Если Ответ.Количество() = 0 Тогда
			//ПервоначальныйВзносПроцент = (ПервоначальныйВзносСумма / СуммаКредита) * 100;
			Предупреждение("Значение не подходит по кредитной программе.");
			ПервоначальныйВзносПроцент = КредитноеПредложение.ПервоначальныйВзносПоУмолчанию;
			НеобходимоСменитьКредитнуюПрограмму = Истина;
		Иначе
			Если Ответ.Количество() = 1 Тогда
				Строка = Ответ[0];
			Иначе
				Строка = Ответ.ВыбратьСтроку("Выберите подходящее условие");
				СрокКредита = Строка.МаксСрок / 12;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПервоначальныйВзносСумма = СуммаКредита * ПервоначальныйВзносПроцент / 100;
	ПересчитатьКредит();
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПоПрограмме()
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БанковскаяСтавка Ставка_Банк
	|ИЗ Справочник.Renault_КредитныеПредложения.КредитныеСтавки
	|ГДЕ Ссылка=&Ссылка
	|	И СрокКредитаОт <= &СрокКредита
	|	И СрокКредитаДо >= &СрокКредита
	|	И ПервоначальныйВзносОт <= &ПервоначальныйВзносПроцент
	|	И ПервоначальныйВзносДо >= &ПервоначальныйВзносПроцент
	|	И МаркетинговаяСтавка <= &МаркетинговаяСтавка";
	Запрос.УстановитьПараметр("Ссылка", КредитноеПредложение);
	Запрос.УстановитьПараметр("ПервоначальныйВзносПроцент", ПервоначальныйВзносПроцент);
	Запрос.УстановитьПараметр("СрокКредита", СрокКредита);
	Запрос.УстановитьПараметр("МаркетинговаяСтавка", МаркетинговаяСтавка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

