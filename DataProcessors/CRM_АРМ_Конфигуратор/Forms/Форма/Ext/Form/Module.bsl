&НаСервере
Функция ПолучитьСписокЗначенийКомплектов()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ОпцииВариантовКомплектации.Опция,
	|	ОпцииВариантовКомплектации.Количество,
	|	ОпцииВариантовКомплектации.ЦенаЗакупки
	|ИЗ
	|	РегистрСведений.ОпцииВариантовКомплектации КАК ОпцииВариантовКомплектации
	|ГДЕ
	|	ОпцииВариантовКомплектации.ВариантКомплектации = &ВариантКомплектации
	|	И ОпцииВариантовКомплектации.ВидВключения = 0");
	Запрос.УстановитьПараметр("ВариантКомплектации", Версия);
	Таблица = Запрос.Выполнить().Выгрузить();
	//СписокВыбора = Новый СписокЗначений;
	МассивВыбора = Новый Массив;
	
	Для каждого Опция из Таблица Цикл
		ТекЦена = 0;
		Оп = Новый Структура();
		Если ТипЗнч(Опция.Опция) = Тип("СправочникСсылка.Опции") Тогда
			Оп.Вставить("Номенклатура", Строка(Опция.Опция));
			
		Иначе
			Оп.Вставить("Номенклатура", Опция.Опция);
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ТипЦен", ТипЦенКП);
			Запрос.УстановитьПараметр("Номенклатура", Опция.Опция);
			Запрос.Текст = "ВЫБРАТЬ
			|	ЦеныСрезПоследних.Цена
			|ИЗ
			|	РегистрСведений.Цены.СрезПоследних(
			|			,
			|			ТипЦен = &ТипЦен
			|				И Номенклатура = &Номенклатура) КАК ЦеныСрезПоследних";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Оп.Вставить("Цена", Выборка.Цена);
				ТекЦена = Выборка.цена;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Опция.Количество > 1 Тогда
			Оп.Вставить("Количество", Опция.Количество);
			Оп.Вставить("Сумма",Опция.Количество * ТекЦена);
		Иначе
			Оп.Вставить("Количество", 1);
			Оп.Вставить("Сумма", ТекЦена);
		КонецЕсли;
		
		//СписокВыбора.Добавить(Оп, Опция.Опция.Наименование);
		ЭлементВыбора = Новый Структура;
		ЭлементВыбора.Вставить("Ключ", Опция.Опция.Наименование);
		ЭлементВыбора.Вставить("Значение", Оп);
		МассивВыбора.Добавить(ЭлементВыбора);
		
		
	КонецЦикла;
	
	//Возврат СписокВыбора;
	Возврат МассивВыбора;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьпоСписку(Список)
	
	Для каждого Эл из Список Цикл
		Если Эл.Пометка Тогда
			
			Если ТипЗнч(Эл.Значение.Номенклатура) <> Тип("Строка") Тогда
				Состав = Эл.Значение.Номенклатура.СоставНабора;
				Если Состав.Количество() Тогда
					Для Каждого ЭлементНабора ИЗ Состав Цикл
						НовСтрока = ВыбранноеОборудование.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтрока, ЭлементНабора);
						
						Запрос = Новый Запрос;
						Запрос.УстановитьПараметр("ТипЦен", ТипЦенКП);
						Запрос.УстановитьПараметр("Номенклатура", НовСтрока.Номенклатура);
						Запрос.Текст = "ВЫБРАТЬ
						|	ЦеныСрезПоследних.Цена
						|ИЗ
						|	РегистрСведений.Цены.СрезПоследних(
						|			,
						|			ТипЦен = &ТипЦен
						|				И Номенклатура = &Номенклатура) КАК ЦеныСрезПоследних";
						Выборка = Запрос.Выполнить().Выбрать();
						Если Выборка.Следующий() Тогда
							НовСтрока.Цена = Выборка.цена;
							НовСтрока.Сумма = НовСтрока.Цена * НовСтрока.Количество;
						КонецЕсли;
						
					КонецЦикла;
				Иначе
					НовСтрока = ВыбранноеОборудование.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрока, Эл.Значение);
				КонецЕсли;
			Иначе
				НовСтрока = ВыбранноеОборудование.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Эл.Значение);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

