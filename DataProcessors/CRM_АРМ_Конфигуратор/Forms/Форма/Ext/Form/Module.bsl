&НаСервере
Процедура ДобавитьКП(Конфигурация,ТипКП)
	
	Если НЕ ЗначениеЗаполнено(ТекущееКП) Тогда
		ОбКП = Документы.CRM_КоммерческоеПредложение.СоздатьДокумент();
		ОбКП.Дата			= ТекущаяДата();
		ОбКП.СрокДействия   = СрокДействия;
		ОбКП.ДатаНачалаПередачиАвто    = ДатаНачалаПередачиАвто;
		ОбКП.ДатаОкончанияПередачиАвто = ДатаОкончанияПередачиАвто;
		ОбКП.Автор			= ПараметрыСеанса.Пользователь;
		ОбКП.Клиент			= ТекущийКлиент;
		обКП.МенеджерОбслуживания = ПолучитьМенеджераОбслуживания(ТекущийКлиент);
		ОбКП.ТрейдИн 		= ЭтоТрейдИН;
		ОбКП.РабочийЛист	= ТекущийРабочийЛист;
		ОбКП.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		ОбКП.ЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн;
		обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
		ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
		СоздатьНайтиЗаявкуНаОборудование(ОбКП);
		обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
		обКП.ИнтересовалсяОборудованием = ИнтересовалсяОборудованием;
		обКП.ТипКП=ТипКП;
		ОбКП.Renaut_ЦенаРОП = ?(УстановитьРасчетнуюПоЦенеРоп И ЦенаРОП <> 0, ЦенаРОП, 0);
		ОбКП.Записать();
		
		ТекущееКП = ОбКП.Ссылка;
		
	Иначе
		
		ОбКП = ТекущееКП.ПолучитьОбъект();
		
	КонецЕсли;
	
	СтрКонф = ОбКП.Состав.Добавить();
	СтрКонф.Конфигурация = Конфигурация;
	СтрКонф.Сумма = ЦенаИТОГО;
	СтрКонф.СуммаДоставки = СуммаДоставки;
	СтрКонф.СуммаСкидки = СуммаСкидки;
	
	НомерКП = ОбКП.Номер;
	ДатаКП = ОбКП.Дата;
	
	// КовалевЕС от 30.05.19 {
	ОбКП.ВычетПоТрейдИн = ТрейдИнСумма;
	// КовалевЕС от 30.05.19 } 
	
	ОбКП.Сумма = ОбКП.Состав.Итог("Сумма");
	обКП.ЗаявканаТрейдИн = ЗаявкаНаТрейдИн;
	обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
	обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
	ОбКП.интересовалсяСтраховкой = ИнтересовалсяСтраховкой;
	обКП.ИнтересовалсяОборудованием = ИнтересовалсяОборудованием;
	обКП.ИнтересовалсяУтилизацией = ИнтересовалсяУтилизацией;
	
	ТабСкидкиОбКП = ОбКП.СкидкиКонфигурации;	
	
	УИДКонфигурации = Строка(Конфигурация.УникальныйИдентификатор());
	Отбор = Новый Структура("ИдентификаторКонфигурации", УИДКонфигурации);
	НайденныеСтрокиСкидок = ТабСкидкиОбКП.НайтиСтроки(Отбор);
	
	Для Каждого Эл Из НайденныеСтрокиСкидок Цикл
		ТабСкидкиОбКП.Удалить(Эл);	
	КонецЦикла;
	
	Для Каждого Эл Из СписокСкидок Цикл
		Стр = ТабСкидкиОбКП.Добавить();
		Стр.ИдентификаторКонфигурации = УИДКонфигурации;
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла;		
	ОбКП.Renaut_ЦенаРОП = ?(УстановитьРасчетнуюПоЦенеРоп И ЦенаРОП <> 0, ЦенаРОП, 0);
	
	Если ИнтересовалсяСтраховкой Тогда
		
		//Если Не ЗначениеЗаполнено(Возраст) Тогда
		//	Предупреждение("Не заполнен возраст водителя");
		//	Возврат;
		//КонецЕсли;
		//Если Не ЗначениеЗаполнено(СтажВождения) Тогда
		//	Предупреждение("Не заполнен стаж вождения");
		//	Возврат;
		//КонецЕсли;
		//ОбработатьВвозСтраховой();
		СтруктураПолисы = СохранитьСтраховыеПолисы();
		ОбКП.ПолисОСАГО = СтруктураПолисы.ПолисОСАГО;
		ОбКП.ПолисКАСКО = СтруктураПолисы.ПолисКАСКО;
		ОбКП.Возраст = Возраст;
		ОбКП.СтажВождения = СтажВождения;
		
	КонецЕсли;
	
	ОбКП.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

