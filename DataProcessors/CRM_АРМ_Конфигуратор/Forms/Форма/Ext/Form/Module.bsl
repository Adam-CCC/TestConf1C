&НаСервере
Процедура ОбновитьСкидкиПоКонфигурации(Конфигурация)
	Если ЗначениеЗаполнено(Конфигурация) Тогда
		УИДКонфигурации = Строка(Конфигурация.УникальныйИдентификатор());
		Отбор = Новый Структура("ИдентификаторКонфигурации", УИДКонфигурации);
		
		СтрокиСкидок = ТекущееКП.СкидкиКонфигурации.НайтиСтроки(Отбор);
		
		Если СтрокиСкидок.Количество() > 0 Тогда
			СписокСкидок.Очистить();
			Для Каждого Строка Из СтрокиСкидок Цикл
				Стр = СписокСкидок.Добавить();
				ЗаполнитьЗначенияСвойств(Стр, Строка);
			КонецЦикла;			
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСкидкиПоАвтомобилю()
	Перем ПрименятьАкции, мТипСкидки, мТипАвтомобиля, мСкидки, ВидыУсловийПредоставления;
	
	Если ЭтоКорпКлиент Тогда
		Возврат;
	КонецЕсли; 	
	
	тГодВыпуска = Renault_ОбщегоНазначения.ПолучитьГодВыпуска(Автомобиль);	
	Если тГодВыпуска = 0 Тогда
		тГодВыпуска = Год(ТекущаяДата());
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура("ДилерскийЦентр, VIN, Модель, Версия, ГодВыпуска", ТекДилерскийЦентр, VIN, Модель, Версия, тГодВыпуска);
	
	мТипАвтомобиля = Renault_ЗагрузкаКоммерческихАкций.УстановитьТипАвтомобиля(VIN, ТекДилерскийЦентр);
	
	ПолучитьДанныеДляРассчетаСкидок(ПрименятьАкции, мТипСкидки, мТипАвтомобиля, мСкидки, ВидыУсловийПредоставления, ПараметрыРасчета);
	
	Если НЕ ПрименятьАкции ИЛИ НЕ ЗначениеЗаполнено(мТипСкидки) Тогда
		Возврат;
	КонецЕсли;
	
	// Очистка рассчитанных скидок
	Отбор = Новый Структура("ТипСкидки", мТипСкидки);
	Найдено = СписокСкидок.НайтиСтроки(Отбор);  
	
	Если  Найдено.Количество() > 0 Тогда
		Для Каждого Эл Из Найдено Цикл
			СписокСкидок.Удалить(Эл);
		КонецЦикла;
	КонецЕсли; 		
	
	мСкидкиКоличество = мСкидки.Количество();
	СуммаСкидокRenault = 0;
	Для Счетчик = 1 По мСкидкиКоличество Цикл 		
		СтруктураСкидки = мСкидки["КлючСтроки" + Счетчик];  		
		
		Если СтруктураСкидки.ВариантСкидки = "Процент" Тогда
			Продолжить; // уточнить как обрабатывать процентные скидки, от какой суммы считать процент // доработать
		КонецЕсли;
		
		// Проверка соответствия договора условиям предоставления скидки
		ОтказПредоставления = Ложь;
		Для каждого стрУсловие Из СтруктураСкидки.СписокУсловий Цикл
			ПроверитьСоответствиеДоговораУсловиюСкидки(ОтказПредоставления, стрУсловие, ВидыУсловийПредоставления);
			Если ОтказПредоставления Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ОтказПредоставления Тогда
			СуммаСкидокRenault = СуммаСкидокRenault + СтруктураСкидки.ЗначениеСкидки;
		КонецЕсли;				
	КонецЦикла;	
	
	Если СуммаСкидокRenault > 0 Тогда		
		НС = СписокСкидок.Добавить();
		НС.ТипСкидки = мТипСкидки;
		НС.СуммаСкидки = СуммаСкидокRenault;			
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоответствиеДоговораУсловиюСкидки(ОтказПредоставления, стрУсловие, ВидыУсловийПредоставления)
	Если ИнтересовалсяТрейдИн Тогда
		Если стрУсловие.ВидУсловия = ВидыУсловийПредоставления.Утилизация Тогда
			ОтказПредоставления = Истина;
		КонецЕсли;
	ИначеЕсли НЕ ИнтересовалсяТрейдИн И
		стрУсловие.ВидУсловия = ВидыУсловийПредоставления.ТрейдИн Тогда  
		ОтказПредоставления = Истина;
	ИначеЕсли стрУсловие.ВидУсловия = ВидыУсловийПредоставления.Утилизация Тогда
		ОтказПредоставления = Истина;		
	КонецЕсли;		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьДанныеДляРассчетаСкидок(ПрименятьАкции, ТипСкидки, ТипАвтомобиля, Скидки, ВидыУсловийПредоставления, ПараметрыРасчета)
	ДилерскийЦентр = ПараметрыРасчета.ДилерскийЦентр;
	VIN = ПараметрыРасчета.VIN;
	Модель = ПараметрыРасчета.Модель;
	Версия = ПараметрыРасчета.Версия;
	тГодВыпуска = ПараметрыРасчета.ГодВыпуска;
	
	ПрименятьАкции = ДилерскийЦентр.ПрименятьКоммерческиеАкцииRenault И ЗначениеЗаполнено(Модель) И ЗначениеЗаполнено(Версия);
	
	Если НЕ ПрименятьАкции Тогда
		Возврат;
	КонецЕсли;
	
	ТипСкидки = ПолучитьТипСкидки();
	
	Если НЕ ЗначениеЗаполнено(ТипСкидки) Тогда
		Возврат;
	КонецЕсли;	
	
	ВидыУсловийПредоставления = ПолучитьВидыУсловийПредоставленияСкидок(); 	
	
	Скидки = Renault_ЗагрузкаКоммерческихАкций.ПолучитьВсеСкидки(VIN, Модель, Версия, ТипАвтомобиля, тГодВыпуска, ТекущаяДата());
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТипСкидки()
	УстановитьПривилегированныйРежим(Истина);
	
	ТипСкидки = Справочники.ТипыСкидок.НайтиПоКоду("RenltCA");
	
	Если ТипСкидки.Пустая() Тогда		
		ТипСкидкиОб = Справочники.ТипыСкидок.СоздатьЭлемент();	
		ТипСкидкиОб.ОбменДанными.Загрузка = Истина;
		ТипСкидкиОб.Код = "RenltCA";
		ТипСкидкиОб.Наименование = "Скидки по коммерческим акциям Renault";
		
		Попытка
			ТипСкидкиОб.Записать();
			ТипСкидки = ТипСкидкиОб.Ссылка;
		Исключение
			Сообщить("Не удалось автоматически создать тип скидки. Создайте элемент справочника ""Типы скидок и наценок"" с кодом ""RenltCA"" (тип скидки по коммерческим акциям Renault)");
			Возврат ТипСкидки;
		КонецПопытки;		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТипСкидки;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидыУсловийПредоставленияСкидок()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Renault_ВидыУсловийПредоставленияСкидок.ТрейдИн) КАК ТрейдИн,
	|	ЗНАЧЕНИЕ(Перечисление.Renault_ВидыУсловийПредоставленияСкидок.Утилизация) КАК Утилизация";	
	Результат = Запрос.Выполнить(); 	
	Выборка = Результат.Выбрать();	
	Выборка.Следующий();
	
	ВидыУсловийПредоставления = Новый Структура("ТрейдИн, Утилизация");
	ЗаполнитьЗначенияСвойств(ВидыУсловийПредоставления, Выборка);
	
	Возврат ВидыУсловийПредоставления;
КонецФункции 

