		ПересчитатьСтоимость();
		
		ПересчитатьЦенуАвто();
		ОбновитьНадписьЦена();
	КонецЕсли;
	// Клиентская часть
	ОбновитьОтображениеГруппПоЗаявкам();
	
КонецПроцедуры

&НаСервере 
Функция СоздатьНайтиЗаявкуНаКредит()
	
	ЗначениеПустое = Ложь;
	Если ЗначениеЗаполнено(ЗаявкаНаКредит) Тогда
		ДокОб = ЗаявкаНаКредит.Ссылка.ПолучитьОбъект();
	ИначеЕсли  СоздаватьЗаявкуНаКредит Тогда
		ДокОб = Документы.Renault_CRM_ЗаявкаНаКредит.СоздатьДокумент();
		ДокОб.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Черновик;
	Иначе
		ДокОб = Документы.Renault_CRM_ЗаявкаНаКредит.ПустаяСсылка();
		ЗначениеПустое= Истина;
	КонецЕсли;
	
	Если Не(ЗначениеПустое)Или СоздаватьЗаявкуНаКредит Тогда
		МожноСохранить = Ложь;
		Если НЕ ДокОб.ЭтоНовый() Тогда
			Если Не ДокОб.ВыполненаУспешно Тогда
				МожноСохранить = Истина;
			КонецЕсли;
		Иначе
			МожноСохранить = Истина;
		КонецЕсли;
		Если МожноСохранить тогда
			ДокОб.Версия = Версия;
			ДокОб.Дата = ТекущаяДата();
			ДокОб.Клиент = Метаданные.Документы.Renault_CRM_ЗаявкаНаКредит.Реквизиты.Клиент.Тип.ПривестиЗначение( ТекущийКлиент);
			//ДокОб.Комментарий = ТрейдИнКомментарий;
			ДокОб.Модель = Модель;
			ДокОб.РабочийЛист = ТекущийРабочийЛист;
			ДокОб.Сумма = СуммаКредита;
			ДокОб.Цвет = Цвет;
			ДокОб.БанкПредоставляющийКредит = Банк;
			ДокОб.ЕжемесячныйПлатеж = ЕжемесячныйПлатеж;
			ДокОб.ПервоночальныйВзносПроцент = ПервоначальныйВзносПроцент;
			ДокОб.ПервоночальныйВзнос = ПервоначальныйВзносСумма;
			ДокОб.Срок = СрокКредита;
			ДокОб.Ставка = МаркетинговаяСтавка;
			ДокОб.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			ДокОб.КредитноеПредложение = КредитноеПредложение;
			ДокОб.Записать(РежимЗаписиДокумента.Проведение);
			ЗаявкаНаКредит = ДокОб.Ссылка;
			ИнтересовалсяКредитом = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДокОб.Ссылка;
	
КонецФункции

&НаСервере
процедура ЗагрузитьЗаявкуНаКредит()
	
	Если ЗначениеЗаполнено(ЗаявкаНаКредит) тогда
		
		Банк = ЗаявкаНаКредит.БанкПредоставляющийКредит;
		СуммаКредита = ЗаявкаНаКредит.Сумма;
		МаркетинговаяСтавка = ЗаявкаНаКредит.Ставка;
		ЕжемесячныйПлатеж = ЗаявкаНаКредит.ЕжемесячныйПлатеж;
		СрокКредита = ЗаявкаНаКредит.Срок;
		ПервоначальныйВзносСумма = ЗаявкаНаКредит.ПервоночальныйВзнос;
		ПервоначальныйВзносПроцент = ЗаявкаНаКредит.ПервоночальныйВзносПроцент;
		КредитноеПредложение = ЗаявкаНаКредит.КредитноеПредложение;
		
		ИнтересовалсяКредитом = истина;
		
	КонецЕсли;
	
