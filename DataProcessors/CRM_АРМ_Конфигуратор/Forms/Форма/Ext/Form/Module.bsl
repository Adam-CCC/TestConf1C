&НаКлиенте
Процедура УстановкаСкидокНажатие(Команда)
	////Козлов Е.А. Начало 23.01.2017
	//РассчитатьСкидкиПоАвтомобилю();
	////Козлов Е.А. Конец
	ПересчитатьСтоимость();
	
	ФормаСкидок = ПолучитьФорму("Обработка.CRM_АРМ_Конфигуратор.Форма.ФормаУстановкиСкидок");
	СуммаОбщ = 	ЦенаВариантаКомплектации + ЦенаДопОпций - ЦенаВыкупа + ЦенаОборудования + ЦенаАвторабот + СтраховкаОСАГОСумма + СтраховкаКАСКОСумма + ГарантияСумма;
	ФормаСкидок.СуммаКонфигурации = СуммаОбщ;
	ФормаСкидок.СуммаСкидки = СуммаСкидки;
	ФормаСкидок.СуммаДоставки = СуммаДоставки;
	ФормаСкидок.СуммаКонечная = ЦенаИтого;
	ФормаСкидок.Модель = Модель;
	ФормаСкидок.Версия = Версия;
	ФормаСкидок.Автомобиль = Автомобиль;
	ФормаСкидок.ДилерскийЦентр = ТекДилерскийЦентр;
	ФормаСкидок.Кредит = ИнтересовалсяКредитом;
	ФормаСкидок.TradeIn = ИнтересовалсяТрейдИн;
	ФормаСкидок.Утилизация = ИнтересовалсяУтилизацией;
	ЗадачиОФУ=ЗадачиОФУ();
	СуществуетКредит=СоздатьЗадачу_ОФУ_Кредит ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Кредит)).Количество()>0;
	СуществуетЛизинг=СоздатьЗадачу_ОФУ_Лизинг ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Лизинг)).Количество()>0;
	
	Если СуществуетКредит Тогда ФормаСкидок.СпособОплаты = Перечисления.Renault_СпособыОплаты.Кредит
	ИначеЕсли СуществуетЛизинг Тогда ФормаСкидок.СпособОплаты = Перечисления.Renault_СпособыОплаты.Лизинг
	Иначе ФормаСкидок.СпособОплаты = Перечисления.Renault_СпособыОплаты.НаличнаяОплата
	КонецЕсли; 
	
	// НАЧАЛО DMSCOR-1030
	ФормаСкидок.Дата = ДатаКП;
	ФормаСкидок.ЭтоКорпоративныйКлиент = ЭтоКорпКлиент;
	// КОНЕЦ
	//@++ Васильев ВА
	ФормаСкидок.КлючТаблицыСпискаСкидок = ПоместитьСписокСкидокВоВременноеХранилище(); 
	//@++
	Ответ = ФормаСкидок.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Ответ);
		СуммаДоставки = Ответ.СуммаДоставки;
		ЦенаИтого = Ответ.СуммаКонечная;  
		//++Васильев ВА
		ПолучитьСписокСкидок(Ответ.КлючТаблицыСпискаСкидок);
		//@++
	КонецЕсли;
	
	ПересчитатьЦенуАвто();	
	
КонецПроцедуры

