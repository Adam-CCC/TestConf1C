	ТекДанные = Элементы.ВыбранныеАвтоработы.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		
		Если ТекДанные.Количество = 0 Тогда
			ТекДанные.Количество = 1
		КонецЕсли;
		ТекДанные.Сумма = ТекДанные.Количество * ТекДанные.Цена;
		
	КонецЕсли;
	
	ПересчитатьЦенуАвто();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКонфигурациюВКонфигураторКлиент(Конфигурация)
	
	ИндексыСтрок = ЗагрузитьКонфигурациюВКонфигураторСервер(Конфигурация);
	ОбновитьТаблицыПоДаннымРеквизитов(ИндексыСтрок);
	
	ОбновитьТТХИБазовыеОпции();
	ОбновитьКартинкуМодели();
	ПересчитатьЦенуВариантаКомплектации(); //Плохо. Необходимо устанавливать в соответствии с КП!
	
	ОбновитьСпискиОборудованияАксессуаров(); //Дополнительные опции
	ЗагрузитьОпцииИзКонфигурации(ТекущаяКонфигурация);
	ПриИзмененииВерсииАвтоКлиент();
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьКонфигурациюВКонфигураторСервер(Конфигурация)
	
	Если Конфигурация = Неопределено Тогда
		Если ТекущееКП.Состав.Количество() > 0 Тогда
			Конфигурация = ТекущееКП.Состав[0].Конфигурация;			
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	//Козлов Е.А. Начало 20.01.2017
	ОбновитьСкидкиПоКонфигурации(Конфигурация);
	//Козлов Е.А. Конец
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Конфигурация);
	УстановитьЦенуРОП();
	
	ОбновитьСписокКонфигураций(Модель);
	ОбновитьСписокЦветов(Модель);
	
	ИндексыСтрок = ПолучитьИндексыСтрокТаблиц(Модель, Версия, Цвет);
	
	Возврат ИндексыСтрок;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьОпцииИзКонфигурации(Конфигурация)
	
	Для Каждого Стр Из ВыбранныеНебазовыеОпции Цикл
		
		Если НЕ Конфигурация.Опции.Найти(Стр.Опция, "Опция") = Неопределено Тогда
			Стр.Выбран = Истина;
		Иначе
			Стр.Выбран = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ВыбранноеОборудование.Загрузить(Конфигурация.Оборудование.Выгрузить());
	ВыбранныеАвтоработы.Загрузить(Конфигурация.Автоработы.Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКПНажатие(Команда)
	
	Если ЗначениеЗаполнено(Элементы.СписокКП.ТекущаяСтрока) Тогда
		ТекущееКП = Элементы.СписокКП.ТекущаяСтрока;
	Иначе
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКоммерческоеПредложение(ТекущееКП, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицыПоДаннымРеквизитов(ИндексыСтрок)
	
	Если ИндексыСтрок.ИндексМодель <> Неопределено Тогда
		Элементы.ТаблицаМодели.ТекущаяСтрока = ТаблицаМодели[ИндексыСтрок.ИндексМодель].ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ИндексыСтрок.ИндексВерсия <> Неопределено Тогда
		Элементы.ТаблицаКомплектации.ТекущаяСтрока = ТаблицаКомплектации[ИндексыСтрок.ИндексВерсия].ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ИндексыСтрок.ИндексЦвет <> Неопределено Тогда
		Элементы.ТаблицаЦвета.ТекущаяСтрока = ТаблицаЦвета[ИндексыСтрок.ИндексЦвет].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИндексыСтрокТаблиц(Модель, Версия, Цвет)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Модель", Модель);
	Строки = ТаблицаМодели.НайтиСтроки(СтруктураОтбора);
	Если Строки.Количество() > 0 Тогда
		ИндексМодель = ТаблицаМодели.Индекс(Строки[0]);
	Иначе
		ИндексМодель = Неопределено;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ссылка", Версия);
	Строки = ТаблицаКомплектации.НайтиСтроки(СтруктураОтбора);
	Если Строки.Количество() > 0 Тогда
		ИндексВерсия = ТаблицаКомплектации.Индекс(Строки[0]);
	Иначе
		ИндексВерсия = Неопределено;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Цвет", Цвет);
	Строки = ТаблицаЦвета.НайтиСтроки(СтруктураОтбора);
	Если Строки.Количество() > 0 Тогда
		ИндексЦвет = ТаблицаЦвета.Индекс(Строки[0]);
	Иначе
		ИндексЦвет = Неопределено;
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("ИндексМодель", ИндексМодель);
	Ответ.Вставить("ИндексВерсия", ИндексВерсия);
	Ответ.Вставить("ИндексЦвет", ИндексЦвет);
	
	Возврат Ответ;
	
КонецФункции

