Функция ПроверитьСозданныеЗаявкиТрейдИн()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТипОперацииTradeIn", Перечисления.Renault_ТипыОперацийТрейдИн.TradeIn);
	Запрос.УстановитьПараметр("РабочийЛист", ТекущийРабочийЛистПрием);
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_ЗаявкаНаТрейдИн.Ссылка
	|ИЗ
	|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|ГДЕ
	|	НЕ Renault_ЗаявкаНаТрейдИн.ПометкаУдаления
	|	И Renault_ЗаявкаНаТрейдИн.ТипОперацииTradeIn = &ТипОперацииTradeIn
	|	И Renault_ЗаявкаНаТрейдИн.РабочийЛист = &РабочийЛист";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
