&НаКлиенте
Процедура ПересчитатьЦенуАвто()
	
	ЦенаДопОпций = 0;
	Для Каждого ДопОпция Из ВыбранныеНебазовыеОпции Цикл
		ЦенаДопОпций = ЦенаДопОпций + ?(ДопОпция.Выбран, ДопОпция.Цена, 0);
	КонецЦикла;
		
	Если ИнтересовалсяУтилизацией Тогда
		СуммаУтилизации = Renault_ОбщегоНазначения.ПолучитьСуммуСкидкиПоУтилизации(Автомобиль.VIN,Автомобиль.Модель,Автомобиль.ВариантКомплектации,Автомобиль.ГодВыпуска);
	Иначе
		СуммаУтилизации = 0;
	КонецЕсли;
	
	ЦенаОборудования = ВыбранноеОборудование.Итог("Сумма");
	ЦенаАвторабот = ВыбранныеАвтоработы.Итог("Сумма");
	ПересчитатьСкидки();
	ПересчитатьСуммуКредита();
	ЦенаИТОГО = ЦенаВариантаКомплектации + ЦенаДопОпций - ЦенаВыкупа + СуммаДоставки + ЦенаОборудования + ЦенаАвторабот + ?(СтраховкаОСАГОВключать = Истина, СтраховкаОСАГОСумма, 0) + ГарантияСумма + СервисныеКонтрактыСумма + ПомощьНаДорогахСумма - СуммаСкидки - СуммаУтилизации;
	Если Не(ЦенаРОП = 0) Тогда
		Если УстановитьРасчетнуюПоЦенеРоп Тогда
			НаценкаРОП = ЦенаРОП - (ЦенаИТОГО - ЦенаОборудования - ЦенаАвторабот); //временно
			Если НаценкаРОП > 0 Тогда
				СуммаДоставки = СуммаДоставки + НаценкаРОП;
				ЦенаИТОГО = ЦенаВариантаКомплектации + ЦенаДопОпций - ЦенаВыкупа + СуммаДоставки + ЦенаОборудования + ЦенаАвторабот + СтраховкаОСАГОСумма + СтраховкаКАСКОСумма + ГарантияСумма + СервисныеКонтрактыСумма + ПомощьНаДорогахСумма - СуммаСкидки - СуммаУтилизации;
			ИначеЕсли НаценкаРОП < 0 Тогда
				СуммаСкидки = - НаценкаРОП;
				ЦенаИТОГО = ЦенаВариантаКомплектации + ЦенаДопОпций - ЦенаВыкупа + СуммаДоставки + ЦенаОборудования + ЦенаАвторабот + СтраховкаОСАГОСумма + СтраховкаКАСКОСумма + ГарантияСумма + СервисныеКонтрактыСумма + ПомощьНаДорогахСумма - СуммаСкидки - СуммаУтилизации;
			КонецЕсли;
		Иначе
			//Не меняем	
		КонецЕсли;
	КонецЕсли;
	
	ПересчитатьСкидки();
	
	ОбновитьНадписьЦена();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьЦена()
	
	Разделитель = "--------------------------";
	ШиринаРазделителя = СтрДлина(Разделитель); // символов
	
	НадписьЦена = 
	"Комплектация: " + Строка(ЦенаВариантаКомплектации) + Символы.ПС +
	"Опции:        " + Строка(ЦенаДопОпций) + Символы.ПС +
	"Оборудование: " + Строка(ЦенаОборудования) + Символы.ПС +
	//"Автоработы:   " + Строка(ЦенаАвторабот) + Символы.ПС +
	//"Доставка:     " + Строка(СуммаДоставки) + Символы.ПС +
	"Утилизация:   " + Строка(СуммаУтилизации) + Символы.ПС +
	"Трейд-ин:     " + Строка(ЦенаВыкупа) + Символы.ПС +
	"Пр.гарантия:  " + Строка(ГарантияСумма) + Символы.ПС +
	"Помощь на дорогах:  " + Строка(ПомощьНаДорогахСумма) + Символы.ПС +
	"Сервисные контракты:  " + Строка(СервисныеКонтрактыСумма) + Символы.ПС +

	"Страховка:    " + Строка(СтраховкаОСАГОСумма + СтраховкаКАСКОСумма ) + Символы.ПС ;
	//?(СуммаСкидки > 0,	"СКИДКА:       " + Строка(СуммаСкидки) + Символы.ПС, "") +
	//"--------------------------" + Символы.ПС +
	//"ИТОГО:        " + Строка(ЦенаИТОГО) + " р.";
	
	Если СуммаСкидки > 0 Тогда
		Массив = Новый Массив();
		
		Для Каждого ТекСтр Из СписокСкидок Цикл
			ИмяСкидкиСтр = ?(ЗначениеЗаполнено(ТекСтр.Акция), Строка(ТекСтр.Акция),
				?(ЗначениеЗаполнено(ТекСтр.ТипСкидки), Строка(ТекСтр.ТипСкидки), "Скидка")) + ":";
			СуммаСкидкиСтр = " " + Формат(ТекСтр.СуммаСкидки, "ЧДЦ=0; ЧН=0; ЧГ=3,0");
			ДопустимоСимволов = ШиринаРазделителя - СтрДлина(СуммаСкидкиСтр);
			
			Пока Истина Цикл
				Если ДопустимоСимволов < СтрДлина(ИмяСкидкиСтр) Тогда
					Массив.Добавить(Лев(ИмяСкидкиСтр, ШиринаРазделителя));
					ИмяСкидкиСтр = Сред(ИмяСкидкиСтр, ШиринаРазделителя + 1);
				Иначе
					Заполнитель = Лев("                                       ", ДопустимоСимволов - СтрДлина(ИмяСкидкиСтр));					
					Массив.Добавить(СтрШаблон("%1%2%3", ИмяСкидкиСтр, Заполнитель, СуммаСкидкиСтр));
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		НадписьЦена = НадписьЦена + СтрСоединить(Массив, Символы.ПС) + Символы.ПС;
	КонецЕсли;
	
	НадписьЦена = НадписьЦена + Разделитель + Символы.ПС +
	"ИТОГО:        " + Строка(ЦенаИТОГО) + " р.";
	
	НадписьРасчетнаяЦена = "Расчетная цена " + Строка(ЦенаИтого) + " р.";
	НадписьЦенаРуководителя = "Цена руководителя " + Строка(ЦенаРОП) + " р.";
	
	Элементы.ГруппаЦена.Заголовок = НадписьРасчетнаяЦена;
	Элементы.ДекорацияЦенаРОП.Заголовок = НадписьЦенаРуководителя;
	Элементы.ДекорацияЦенаРОП.Видимость = ЗначениеЗаполнено(ЦенаРОП);
	Элементы.УстановитьРасчетнуюПоЦенеРоп.Видимость = ЗначениеЗаполнено(ЦенаРОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуКредита()
	
	Возврат;
	
	СуммаКредита = ЦенаВариантаКомплектации - ЦенаВыкупа + СуммаДоставки;
	Если ДопОборудованиеВКредит Тогда
		СуммаКредита = СуммаКредита + ЦенаДопОпций + ЦенаОборудования + ЦенаАксессуаров;
	КонецЕсли;
	Если ВключитьСтраховкуВКредит Тогда
		СуммаКредита = СуммаКредита + СтраховкаКАСКОСумма;
	КонецЕсли;
	Если ВключитьПродленнуюГарантиюВКредит Тогда
		СуммаКредита = СуммаКредита + ГарантияСумма;
	КонецЕсли;
	Если УчитыватьСкидкуПриРасчетеСуммыКредита Тогда
		СуммаКредита = СуммаКредита - СуммаСкидки;
	КонецЕсли;
	ПересчитатьКредит();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиОборудованияАксессуаров()
	
	Запрос = Новый Запрос;
	
	Если ЭтоТрейдИН Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ОпцииАвтомобилей.Опция КАК Опция,
		|	Renault_ОпцииАвтомобилей.Цена КАК Цена,
		|	Renault_ОпцииАвтомобилей.Код КАК КодОпции,
		|	Renault_ОпцииАвтомобилей.Наименование КАК НаименованиеОпции,
		|	ИСТИНА КАК Выбран
		|ИЗ
		|	РегистрСведений.Renault_ОпцииАвтомобилей КАК Renault_ОпцииАвтомобилей
		|ГДЕ
		|	Renault_ОпцииАвтомобилей.VIN = &VIN";
		Запрос.УстановитьПараметр("VIN", Автомобиль.VIN);
		
	Иначе
		
		Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
		//Андрианова Начало 23.12.2016
		Если НЕ ЗначениеЗаполнено(ТекущаяКонфигурация) Тогда
			СтрокиВыбранные = ВыбранныеНебазовыеОпции.НайтиСтроки(Новый Структура("Выбран", Истина));
			Если СтрокиВыбранные.Количество() > 0 Тогда
				ТЗСтрокиВыбранные = Новый ТаблицаЗначений;
				ТЗСтрокиВыбранные.Колонки.Добавить("Опция", Новый ОписаниеТипов("СправочникСсылка.Опции"));
				ТЗСтрокиВыбранные.Колонки.Добавить("Выбран",Новый ОписаниеТипов("Булево"));
				Для Каждого Стр Из СтрокиВыбранные Цикл
					НовСтрока = ТЗСтрокиВыбранные.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрока,Стр);
				КонецЦикла;
				Запрос.УстановитьПараметр("УжеВыбрано", ТЗСтрокиВыбранные);
			Иначе
				Запрос.УстановитьПараметр("УжеВыбрано", ТекущаяКонфигурация.Опции.Выгрузить());
			КонецЕсли;
		Иначе
			//Андрианова Конец 23.12.2016
			Запрос.УстановитьПараметр("УжеВыбрано", ТекущаяКонфигурация.Опции.Выгрузить());
			//Андрианова Начало 23.12.2016
		КонецЕсли;
		//Андрианова Конец 23.12.2016
		Запрос.УстановитьПараметр("Модель", Модель.Артикул);
		Запрос.УстановитьПараметр("ВариантКомплектации", Версия.Артикул);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Модели.Ссылка
		|ПОМЕСТИТЬ Модели
		|ИЗ
		|	Справочник.Модели КАК Модели
		|ГДЕ
		|	Модели.Артикул = &Модель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВариантыКомплектации.Ссылка
		|ПОМЕСТИТЬ Варианты
		|ИЗ
		|	Справочник.ВариантыКомплектации КАК ВариантыКомплектации
		|ГДЕ
		|	ВариантыКомплектации.Артикул = &ВариантКомплектации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИСТИНА КАК Выбран,
		|	УжеВыбрано.Опция
		|ПОМЕСТИТЬ ВТ_УжеВыбрано
		|ИЗ
		|	&УжеВыбрано КАК УжеВыбрано
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Renault_ТарифНаОпцииАвтомобилей.Опция КАК ОпцияСпр,
		|	Renault_ТарифНаОпцииАвтомобилей.НаименованиеОпции КАК НаименованиеОпции,
		|	Renault_ТарифНаОпцииАвтомобилей.ЦенаКлиентская,
		|	Renault_ТарифНаОпцииАвтомобилей.Опция.Артикул КАК КодОпции
		|ПОМЕСТИТЬ ВТ_Опции
		|ИЗ
		|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних(
		|			,
		|			Тариф = &Тариф
		|				И Базовая = ЛОЖЬ
		|				И Модель В
		|					(ВЫБРАТЬ
		|						Модели.Ссылка
		|					ИЗ
		|						Модели КАК Модели)
		|				И ВариантКомплектации В
		|					(ВЫБРАТЬ
		|						Варианты.Ссылка
		|					ИЗ
		|						Варианты КАК Варианты)) КАК Renault_ТарифНаОпцииАвтомобилей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(ВТ_Опции.ОпцияСпр, ВТ_УжеВыбрано.Опция) КАК Опция,
		|	ЕСТЬNULL(ВТ_Опции.НаименованиеОпции, ПРЕДСТАВЛЕНИЕ(ВТ_УжеВыбрано.Опция)) КАК НаименованиеОпции,
		|	ВТ_Опции.ЦенаКлиентская КАК Цена,
		|	ВТ_Опции.КодОпции КАК КодОпции,
		|	ВЫБОР
		|		КОГДА ВТ_УжеВыбрано.Опция ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Выбран
		|ИЗ
		|	ВТ_УжеВыбрано КАК ВТ_УжеВыбрано
		|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Опции КАК ВТ_Опции
		|		ПО (ВТ_Опции.ОпцияСпр = ВТ_УжеВыбрано.Опция)";
	КонецЕсли;
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	ВыбранныеНебазовыеОпции.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

