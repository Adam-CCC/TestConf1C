			Иначе
				
				Запись.ДилерскийЦентр = ДилерскийЦентр;
				Запись.ДатаВыполнения = ТекущаяДата();
				Запись.Объект = Документы.Renault_ЗаявкаНаТрейдИн.НайтиПоРеквизиту("РабочийЛист", IDK)
				
			КонецЕсли;
			
			ЗаписьРЛ.Записать();
			
			//создание заявки на трейд-ин
			СтруктураОтбора = Новый Структура();
			СтруктураОтбора.Вставить("РабочийЛист", ТекущийРабочийЛист);
			Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
			Если Не Выборка.Следующий() Тогда
				//Если Вопрос("Хотите создать заявку на трейд-ин?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда	
				Существуют = ПроверитьСозданныеЗаявкиТрейдИн();
