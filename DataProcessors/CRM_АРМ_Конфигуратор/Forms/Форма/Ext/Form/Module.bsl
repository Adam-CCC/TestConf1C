&НаСервере
Процедура ОбновитьДанныеПоСтраховке(ЭтоОСАГО, ЭтоКАСКО)
	Если ЭтоОСАГО Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаСтраховку) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_CRM_ЗаявкаНаСтраховку.Сумма,
			|	Renault_CRM_ЗаявкаНаСтраховку.СтраховаяКомпания,
			|	Renault_CRM_ЗаявкаНаСтраховку.ВидСтраховойПрограммы
			|ИЗ
			|	Документ.Renault_CRM_ЗаявкаНаСтраховку.ВариантыСтрахования КАК Renault_CRM_ЗаявкаНаСтраховку
			|ГДЕ
			|	Renault_CRM_ЗаявкаНаСтраховку.Ссылка = &ЗаявкаНаСтраховку
			|	И Renault_CRM_ЗаявкаНаСтраховку.ВидСтраховойПрограммы = ЗНАЧЕНИЕ(Справочник.Удалить_CRM_ВидыСтраховыхПрограмм.Осаго)";		
			Запрос.УстановитьПараметр("ЗаявкаНаСтраховку", ЗаявкаНаСтраховку); 
			Результат = Запрос.Выполнить();
			
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			
			ИнтересовалсяСтраховкой = Истина;
			СтраховкаОСАГОВключать = Истина;
		Иначе
			СтраховкаОСАГОВключать = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоКАСКО Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаСтраховкуКАСКО) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_CRM_ЗаявкаНаСтраховку.Сумма,
			|	Renault_CRM_ЗаявкаНаСтраховку.СтраховаяКомпания
			|ИЗ
			|	Документ.Renault_CRM_ЗаявкаНаСтраховку.ВариантыСтрахования КАК Renault_CRM_ЗаявкаНаСтраховку
			|ГДЕ
			|	Renault_CRM_ЗаявкаНаСтраховку.Ссылка = &ЗаявкаНаСтраховкуКАСКО
			|	И Renault_CRM_ЗаявкаНаСтраховку.ВидСтраховойПрограммы = ЗНАЧЕНИЕ(Справочник.Удалить_CRM_ВидыСтраховыхПрограмм.Каско)";
			Запрос.УстановитьПараметр("ЗаявкаНаСтраховкуКАСКО", ЗаявкаНаСтраховкуКАСКО); 		
			Результат = Запрос.Выполнить();
			
			Выборка = Результат.Выбрать();		
			Выборка.Следующий();
			
			ИнтересовалсяСтраховкой = Истина;
			СтраховкаКАСКОВключать = Истина;
		Иначе
			СтраховкаКАСКОВключать = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ОстальноеСтраховка.Видимость = ИнтересовалсяСтраховкой;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеПоКредиту()
	Если ЗначениеЗаполнено(ЗаявкаНаКредит) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_CRM_ЗаявкаНаКредит.Сумма КАК СуммаКредита,
		|	Renault_CRM_ЗаявкаНаКредит.БанкПредоставляющийКредит КАК Банк,
		|	Renault_CRM_ЗаявкаНаКредит.Ставка КАК СтавкаБанка,
		|	Renault_CRM_ЗаявкаНаКредит.Срок,
		|	Renault_CRM_ЗаявкаНаКредит.ПервоночальныйВзнос,
		|	Renault_CRM_ЗаявкаНаКредит.ЕжемесячныйПлатеж
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаКредит КАК Renault_CRM_ЗаявкаНаКредит
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаКредит.Ссылка = &ЗаявкаНаГарантию";		
		Запрос.УстановитьПараметр("ЗаявкаНаГарантию", ЗаявкаНаКредит); 		
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();		
		Выборка.Следующий();
		
		Банк = Выборка.Банк;
		СтавкаБанка = Выборка.СтавкаБанка;
		СрокКредита = Выборка.Срок;
		ПервоначальныйВзносСумма = Выборка.ПервоночальныйВзнос;
		ЕжемесячныйПлатеж = Выборка.ЕжемесячныйПлатеж;
		СуммаКредита = Выборка.СуммаКредита;
	Иначе
		Банк = Справочники.Банки.ПустаяСсылка();
		СтавкаБанка = 0;
		СрокКредита = 0;
		ПервоначальныйВзносСумма = 0;
		ЕжемесячныйПлатеж = 0;
		СуммаКредита = 0;
	КонецЕсли;
КонецПроцедуры

