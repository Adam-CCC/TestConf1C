Процедура ДобавитьДопОпции()
	
	СтрокиУдалить = Новый Массив;
	//очистим предыдущие обязательные
	Для Каждого Стр Из ВыбранноеОборудование.НайтиСтроки(Новый Структура("Обязательное",Истина)) Цикл
		СтрокиУдалить.Добавить(Стр);
	КонецЦикла;
	
	Пока СтрокиУдалить.Количество() > 0 Цикл
		ВыбранноеОборудование.Удалить(СтрокиУдалить[0]);
		СтрокиУдалить.Удалить(0);
	КонецЦикла;
	
	//добавляем обязательное допоборудование	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ДилерскийЦентр",Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь));
	Запрос.УстановитьПараметр("Модель",Модель);
	Запрос.УстановитьПараметр("Версия",Версия);
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Запрос.Текст="
	|Выбрать
	|	Истина Обязательное,
	|	ДопОборудование Номенклатура,
	|	Количество,
	|	Цена,
	|	Количество*Цена Сумма
	|Из РегистрСведений.Renault_ОбязательноеДопОборудования
	|ГДЕ ДилерскийЦентр=&ДилерскийЦентр И Модель=&Модель И Версия=&Версия 
	|	И ПериодНачало<=&ТекущаяДата
	|	И Выбор Когда ПериодОкончание=ДатаВремя(1,1,1) Тогда Истина Иначе ПериодОкончание>=&ТекущаяДата Конец 
	|";
	//ВыбранноеОборудование.Загрузить(Запрос.Выполнить().Выгрузить());
	Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл ЗаполнитьЗначенияСвойств(ВыбранноеОборудование.Добавить(),Стр) КонецЦикла;
	
	ИнтересовалсяОборудованием=ВыбранноеОборудование.Количество()>0;
	Элементы.ОстальноеДопОборудование.Видимость=ИнтересовалсяОборудованием;
	
КонецПроцедуры

&НаКлиенте
Процедура кнЗадачаОФУ(Команда) 
	Если ТекущийЭлемент.Имя="кнНаличные" или ТекущийЭлемент.Имя="кнКредит" Тогда //нал/кредит - создание задач
		СоздатьЗадачуОФУ(?(ТекущийЭлемент.Имя="кнНаличные",Справочники.CRM_ВидыСобытий.КонсультацияОФУ,Справочники.CRM_ВидыСобытий.Кредит));
	ИначеЕсли ТекущийЭлемент.Имя="кнЛизинг" Тогда
		СоздатьЗадачуОФУ(Справочники.CRM_ВидыСобытий.Лизинг)
	Иначе //остальные кнопки
		
		//многих задач быть не должно..., однако
		ЗадачиОФУ=ЗадачиОФУ();
		ЗадачиНал=ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.КонсультацияОФУ));
		ЗадачиКредит=ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Кредит));
		ЗадачиЛизинг=ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Лизинг));
		
		Если ТекущийЭлемент.Имя="кнНазначитьИсполнителя" Тогда //новый исполнитель
			//Если ЗадачиНал.Количество()=0 И ЗадачиКредит.Количество()=0 Тогда Возврат КонецЕсли;
			Ответ=Renault_ОбщиеФункции.ПолучитьМенеджераОФУ(ЭтаФорма, ?(ЗадачиОФУ.Количество()=0,СотрудникОФУ,ЗадачиОФУ[0].Ссылка.Сотрудник) );
			Если Ответ=Неопределено Тогда Возврат Иначе СотрудникОФУ=Ответ КонецЕсли; //для отложенной записи
			
			Для Каждого Стр Из ЗадачиНал Цикл Задачи.Renault_События.УстановитьАдресацию(Стр.Ссылка,СотрудникОФУ) КонецЦикла;
			Для Каждого Стр Из ЗадачиКредит Цикл Задачи.Renault_События.УстановитьАдресацию(Стр.Ссылка,СотрудникОФУ) КонецЦикла;
			Для Каждого Стр Из ЗадачиЛизинг Цикл Задачи.Renault_События.УстановитьАдресацию(Стр.Ссылка,СотрудникОФУ) КонецЦикла;
			
		ИначеЕсли ТекущийЭлемент.Имя="кнПередатьВОтдел" Тогда //новый исполнитель 
			Ответ=Renault_ОбщиеФункции.ПолучитьОтделОФУ(ЭтаФорма,?(ЗадачиОФУ.Количество()=0,ОтделОФУ,ЗадачиОФУ[0].Ссылка.Отдел));
			Если Ответ=Неопределено Тогда Возврат Иначе ОтделОФУ=Ответ КонецЕсли; //для отложенной записи
			
			Для Каждого Стр Из ЗадачиНал Цикл Задачи.Renault_События.УстановитьАдресацию(Стр.Ссылка,,ОтделОФУ) КонецЦикла;
			Для Каждого Стр Из ЗадачиКредит Цикл Задачи.Renault_События.УстановитьАдресацию(Стр.Ссылка,,ОтделОФУ) КонецЦикла;
			Для каждого Стр Из ЗадачиЛизинг Цикл Задачи.Renault_События.УстановитьАдресацию(Стр.Ссылка,,ОтделОФУ) КонецЦикла;
			
		ИначеЕсли ТекущийЭлемент.Имя="кнОтказатьсяОтКонсультации" Тогда //удалить задачу
			ОтказОтКонсультацииОФУ=Не ОтказОтКонсультацииОФУ;
			Если ОтказОтКонсультацииОФУ Тогда
				СоздатьЗадачу_ОФУ_Наличные=Ложь;
				СоздатьЗадачу_ОФУ_Кредит=Ложь;
				СоздатьЗадачу_ОФУ_Лизинг=Ложь;
			КонецЕсли;	
			
			Для Каждого Стр Из ЗадачиНал Цикл Задачи.Renault_События.УдалитьЗадачу(Стр.Ссылка) КонецЦикла;
			Для Каждого Стр Из ЗадачиКредит Цикл Задачи.Renault_События.УдалитьЗадачу(Стр.Ссылка) КонецЦикла;
			Для каждого Стр Из ЗадачиЛизинг Цикл Задачи.Renault_События.УдалитьЗадачу(Стр.Ссылка) КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	ПерекраситьКнопкиОФУ(ТекущийЭлемент.Имя);
	УправлениеКнопкамиОФУ();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерекраситьКнопкиОФУ(ИмяЭлемента);
	
	Если Элементы[ИмяЭлемента].ЦветФона = ЦветРено Тогда
		Элементы[ИмяЭлемента].ЦветФона = Новый Цвет(212, 212, 212);
	Иначе
		Элементы[ИмяЭлемента].ЦветФона = ЦветРено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗадачуОФУ(ВидЗадачи)	
	
	//Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
	//	Возврат;
	//КонецЕсли;
	
	//если задача существует - открываем
	Задача=Задачи.Renault_События.НайтиЗадачуОФУ(ТекущееКП,ВидЗадачи); 
	
	Если ТекущееКП.Пустая() Тогда //отложенное создание при записи КП
		Если ТекущийЭлемент.Имя="кнНаличные" Тогда 
			СоздатьЗадачу_ОФУ_Наличные=Не СоздатьЗадачу_ОФУ_Наличные;
			СоздатьЗадачу_ОФУ_Кредит=Не СоздатьЗадачу_ОФУ_Наличные;
			СоздатьЗадачу_ОФУ_Лизинг=Не СоздатьЗадачу_ОФУ_Наличные;
		ИначеЕсли ТекущийЭлемент.Имя="кнКредит" Тогда 
			СоздатьЗадачу_ОФУ_Кредит=Не СоздатьЗадачу_ОФУ_Кредит;
			СоздатьЗадачу_ОФУ_Наличные=Не СоздатьЗадачу_ОФУ_Кредит;
			СоздатьЗадачу_ОФУ_Лизинг=Не СоздатьЗадачу_ОФУ_Кредит;
		Иначе //Лизинг
			СоздатьЗадачу_ОФУ_Лизинг=Не СоздатьЗадачу_ОФУ_Лизинг;
			СоздатьЗадачу_ОФУ_Наличные=Не СоздатьЗадачу_ОФУ_Лизинг;
			СоздатьЗадачу_ОФУ_Кредит=Не СоздатьЗадачу_ОФУ_Лизинг;
		КонецЕсли;
	Иначе //иначе создаем новую
		Если Не ЗначениеЗаполнено(Задача) Тогда
			Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
				ОтделОФУ = Renault_CRM.ПолучитьОтделАвтосалона();
			Иначе
				Если Не ЗначениеЗаполнено(ОтделОФУ) Тогда
					ОтделОФУ = Renault_ОбщиеФункции.ПолучитьОтделОФУ(ЭтаФорма);
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(ОтделОФУ) Тогда
				Задачи.Renault_События.СоздатьНовую(ТекущееКП,ВидЗадачи,,,,ОтделОФУ,СотрудникОФУ);
				Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.RENAULT Тогда
					Сообщить("Создана задача ОФУ",СтатусСообщения.Важное);
				КонецЕсли;
			Иначе
				Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.RENAULT Тогда
					Сообщить("Не выбран отдел ОФУ, задача не создана", СтатусСообщения.Важное);
				Иначе
					Сообщить("Не задан отдел продаж для дилерского центра, задача не создана", СтатусСообщения.Важное);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеКнопкамиОФУ()
	
	ЦветКнопкиВоронкиСерый=Новый Цвет(212, 212, 212);
	ЦветСерый=Новый Цвет(156, 166, 178);
	
	ЗадачиОФУ=ЗадачиОФУ();
	СуществуетКонсультацияОФУ=(СоздатьЗадачу_ОФУ_Наличные и ТекущееКП.Пустая())ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.КонсультацияОФУ)).Количество()>0;
	//ВыполненаКонсультацияОФУ=ЗадачиОФУ.НайтиСтроки(Новый Структура("Состояние,ВидСобытия",Справочники.Renault_Состояния.ЗавершеноУспешно,Справочники.CRM_ВидыСобытий.КонсультацияОФУ)).Количество()>0;
	СуществуетКредит=(СоздатьЗадачу_ОФУ_Кредит и ТекущееКП.Пустая()) ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Кредит)).Количество()>0;
	СуществуетЛизинг=(СоздатьЗадачу_ОФУ_Лизинг и ТекущееКП.Пустая()) ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Лизинг)).Количество()>0;
	//ВыполненКредит=ЗадачиОФУ.НайтиСтроки(Новый Структура("Состояние,ВидСобытия",Справочники.Renault_Состояния.ЗавершеноУспешно,Справочники.CRM_ВидыСобытий.Кредит)).Количество()>0;
	
	Если ЗадачиОФУ.Количество()>0 Тогда
		Элементы.ОписаниеЗадачи.Заголовок = "Создана задача ОФУ ("+ЗадачиОФУ[0].Ссылка.Номер+" "+ЗадачиОФУ[0].ВидСобытия+")";		
	ИначеЕсли (СоздатьЗадачу_ОФУ_Наличные или СоздатьЗадачу_ОФУ_Кредит или СоздатьЗадачу_ОФУ_Лизинг) и ТекущееКП.Пустая() Тогда
		Элементы.ОписаниеЗадачи.Заголовок = "Задача ОФУ будет создана после записи ком. предложения";
	Иначе
		Элементы.ОписаниеЗадачи.Заголовок = "Задача ОФУ не создана";
	КонецЕсли;
	Элементы.кнКредит.ЦветФона=?(СуществуетКредит,ЦветРено,ЦветКнопкиВоронкиСерый);
	Элементы.кнКредит.ЦветРамки=?(СуществуетКредит,ЦветРено,ЦветСерый);
	
	Элементы.кнНаличные.ЦветФона=?(СуществуетКонсультацияОФУ,ЦветРено,ЦветКнопкиВоронкиСерый);
	Элементы.кнНаличные.ЦветРамки=?(СуществуетКонсультацияОФУ,ЦветРено,ЦветСерый);
	
	Элементы.кнОтказатьсяОтКонсультации.ЦветФона=?(ОтказОтКонсультацииОФУ,ЦветРено,ЦветКнопкиВоронкиСерый);
	Элементы.кнОтказатьсяОтКонсультации.ЦветРамки=?(ОтказОтКонсультацииОФУ,ЦветРено,ЦветКнопкиВоронкиСерый);
	
	Элементы.кнНаличные.Доступность=Не ОтказОтКонсультацииОФУ;
	Элементы.кнКредит.Доступность=Не ОтказОтКонсультацииОФУ;
	
	Элементы.кнОтказатьсяОтКонсультации.Доступность=ОтказОтКонсультацииОФУ или СуществуетКонсультацияОФУ или СуществуетКредит;
	Элементы.кнПередатьВОтдел.Доступность=НЕ ОтказОтКонсультацииОФУ И (СуществуетКонсультацияОФУ или СуществуетКредит);
	Элементы.кнНазначитьИсполнителя.Доступность=НЕ ОтказОтКонсультацииОФУ И (СуществуетКонсультацияОФУ или СуществуетКредит);
	Элементы.кнОтказатьсяОтКонсультации.ЦветФона = ЦветСерый;
	Элементы.кнНазначитьИсполнителя.ЦветФона = ЦветСерый;
	Элементы.кнПередатьВОтдел.ЦветФона = ЦветСерый;
	
	Если ОтказОтКонсультацииОФУ Тогда
		
		Элементы.кнОтказатьсяОтКонсультации.ЦветФона = ЦветРено;
		
	ИначеЕсли СуществуетКонсультацияОФУ или СуществуетКредит Тогда
		
		Для Каждого Стр Из ЗадачиОФУ Цикл
			
			Если Стр.ВидСобытия = Справочники.CRM_ВидыСобытий.КонсультацияОФУ
				ИЛИ Стр.ВидСобытия = Справочники.CRM_ВидыСобытий.Кредит Тогда
				
				Если ЗначениеЗаполнено(Стр.Ссылка.Сотрудник) Тогда
					Элементы.кнНазначитьИсполнителя.ЦветФона = ЦветРено;
				ИначеЕсли ЗначениеЗаполнено(Стр.Ссылка.Отдел) Тогда
					Элементы.кнПередатьВОтдел.ЦветФона = ЦветРено;
				КонецЕсли;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Элементы.ГруппаКредитНовая.Видимость = СуществуетКредит;
	
	//pu0XXXX+ КорпКлиенты и Кнопка Лизинг
	//Если КорпКлиент тогда вместо кнопки Кредит кнопка Лизинг
	// Трояновский К.Е. 12.08.2019 10:16:39 {
	//Если Renault_CRM.ПолучитьЗаписьРЛПоIDK(ТекущийРабочийЛист).ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
	ЗаписьРЛ = Renault_CRM.докПолучитьЗаписьРЛПоIDK(ТекущийРабочийЛист);
	Если ЗаписьРЛ = Неопределено Тогда
		ЗаписьРЛ = Renault_CRM.ПолучитьЗаписьРЛПоIDK(ТекущийРабочийЛист);
	КонецЕсли;
	Если ЗаписьРЛ.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
	// Трояновский К.Е. 12.08.2019 10:16:39 }
		Элементы.кнКредит.Видимость = Ложь;
		Элементы.кнКредит.Доступность = Ложь;
		Элементы.кнЛизинг.Видимость = Истина;
		Элементы.кнЛизинг.Доступность = Истина;
		//Цвет кнопки Лизинг
		//СуществуетЛизинг = ?(ЕстьЛизингКорпКлиента(), Истина, Ложь);
		Элементы.кнЛизинг.ЦветФона=?(СуществуетЛизинг, ЦветРено, ЦветКнопкиВоронкиСерый);
		Элементы.кнЛизинг.ЦветРамки=?(СуществуетЛизинг, ЦветРено, ЦветСерый);
		//Если покупка в Лизинг, то другие кнопки сделаем недоступными
		Элементы.кнНаличные.Доступность 				= Не СуществуетЛизинг;
		Элементы.кнОтказатьсяОтКонсультации.Доступность = Не СуществуетЛизинг;
		Элементы.кнПередатьВОтдел.Доступность 			= Не СуществуетЛизинг;
		Элементы.кнНазначитьИсполнителя.Доступность 	= Не СуществуетЛизинг;	
	КонецЕсли;
	//pu0XXXX-	
	
КонецПроцедуры

&НаСервере
Функция ЕстьЛизингКорпКлиента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_СтатистикаВыполненияЭтаповПродаж.Объект
	|ИЗ
	|	РегистрСведений.Renault_СтатистикаВыполненияЭтаповПродаж КАК Renault_СтатистикаВыполненияЭтаповПродаж
	|ГДЕ
	|	Renault_СтатистикаВыполненияЭтаповПродаж.IDK = &IDK
	|	И Renault_СтатистикаВыполненияЭтаповПродаж.ЭтапПродаж = &ЭтапПродаж";
	
	Запрос.УстановитьПараметр("IDK", ТекущееКП.РабочийЛист);
	Запрос.УстановитьПараметр("ЭтапПродаж", Справочники.CRM_ЭтапыПродаж.ЗаявкаНаЛизинг);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Возврат ?(ВыборкаДетальныеЗаписи.Следующий(), Истина, Ложь);
	
КонецФункции

Функция ЗадачиОФУ()
	Запрос=Новый Запрос("Выбрать Ссылка,Состояние,ВидСобытия Из Задача.Renault_События ГДЕ НЕ ПометкаУдаления И Объект=&ТекущееКП 
	|И Состояние НЕ В (Значение(Справочник.Renault_Состояния.Отклонено),Значение(Справочник.Renault_Состояния.ОтмененоВыполнение))");
	Запрос.УстановитьПараметр("ТекущееКП",ТекущееКП);
	Возврат Запрос.Выполнить().Выгрузить()
КонецФункции

&НаКлиенте
