//вызывается при всех событиях влияющих на стоимость
Процедура ПересчитатьСтоимость()	
	
	ОбновитьСписокАкций();
	
КонецПроцедуры

Функция ОбновитьСписокАкций()
	//запомним не автоакции
	МассивНеАвтоАкций=Новый Массив;
	Для Каждого Стр Из СписокСкидок Цикл
		Если Не ЗначениеЗаполнено(Стр.Акция) Или Не Стр.Акция.Автовыбор	Тогда МассивНеАвтоАкций.Добавить(Новый Структура("Акция,СуммаСкидки,ТипСкидки,ПроцентСкидки,Документ,ДатаНачала,ДатаКонца",Стр.Акция,Стр.СуммаСкидки,Справочники.ТипыСкидок.НайтиПоКоду("RenltCA"),Стр.ПроцентСкидки,Стр.Документ,Стр.ДатаНачала,Стр.ДатаКонца)); КонецЕсли;
	КонецЦикла;
	
	//добавим автоакции
	Запрос=Новый Запрос("
	|Выбрать
	|	Спр.Ссылка Акция,
	|	Выбор 
	|		Когда ТЧ.Ссылка Есть NULL Тогда 0
	|		Иначе 
	|			Выбор Когда ТЧ.ВариантСкидки=Значение(Перечисление.DMS_ВариантыСкидки.Процент) Тогда &СуммаБазы*ТЧ.ЗначениеСкидки/100 Иначе ТЧ.ЗначениеСкидки Конец 
	|	Конец СуммаСкидки,
	|   &ТипСкидки КАК ТипСкидки
	|ИЗ Справочник.DMS_КоммерческиеАкции Спр
	|Полное Соединение Справочник.DMS_КоммерческиеАкции.Условия ТЧ По Спр.Ссылка=ТЧ.Ссылка
	|ГДЕ Спр.Активность 
	|	И Спр.Автовыбор 
	
	//проверка периода
	|	И НачалоПериода(&ТекДата,День) Между Спр.НачалоДействия И Спр.ОкончаниеДействия //период в шапке
	|	И Выбор //проверка периода в ТЧ
	|		Когда ТЧ.Ссылка Есть NULL Тогда Истина
	|		Иначе ТЧ.НачалоДействия=ДатаВремя(1,1,1,0,0,0) ИЛИ НачалоПериода(&ТекДата,День) Между ТЧ.НачалоДействия И ТЧ.ОкончаниеДействия
	|	Конец	
	
	// проверка на флаги Кредит, TradeIn, Утилизция
	|	И( Спр.ТипАкции=0 
	|		ИЛИ Спр.ТипАкции=1
	//		ИЛИ (Спр.ТипАкции=1 И &Кредит)
	|		ИЛИ (Спр.ТипАкции=2 И &TradeIn)
	|		ИЛИ (Спр.ТипАкции=3 И &Утилизация)
	|	)
	
	//годы
	|	И Спр.Ссылка В(
	|		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции ГДЕ Ссылка НЕ В(Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ГодыВыпуска)		
	|		Объединить
	|		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ГодыВыпуска ГДЕ Год=&Год
	|	)
	
	//дилерские центры
	|	И Спр.Ссылка В(
	|		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции ГДЕ Ссылка НЕ В(Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры)		
	|		Объединить
	|		Выбрать Ссылка Из Справочник.DMS_КоммерческиеАкции.ДилерскиеЦентры ГДЕ ДилерскийЦентр=&ДилерскийЦентр
	|	)	
	
	//все акции Контрагентов но отбор акций Автомобиля
	|	И Выбор 
	|		Когда Спр.ВладелецАкции=Значение(Перечисление.DMS_ВладельцыСервисов.Контрагент) Тогда Истина 
	|		Иначе &БезОтбора ИЛИ ТЧ.Объект=&ВариантКомплектации ИЛИ ТЧ.Объект=&Модель ИЛИ ТЧ.Объект=&VIN
	|	Конец");	
	
	СтоимостьБазовойКомплектации = ЦенаВариантаКомплектации + ЦенаДопОпций - ЦенаВыкупа + ЦенаОборудования + ЦенаАвторабот + СтраховкаОСАГОСумма + СтраховкаКАСКОСумма + ГарантияСумма;
	
	Запрос.УстановитьПараметр("СуммаБазы",СтоимостьБазовойКомплектации);
	Запрос.УстановитьПараметр("АкцияДилера",Ложь);
	Запрос.УстановитьПараметр("БезОтбора",Ложь);
	Запрос.УстановитьПараметр("ДилерскийЦентр",ТекДилерскийЦентр);
	Запрос.УстановитьПараметр("ТипСкидки",Справочники.ТипыСкидок.НайтиПоКоду("RenltCA")); 
	
	Запрос.УстановитьПараметр("ВариантКомплектации",Версия);
	Запрос.УстановитьПараметр("Модель",Модель);
	Запрос.УстановитьПараметр("VIN",VIN);
	Запрос.УстановитьПараметр("Год",ГодВыпуска);	
	
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	Запрос.УстановитьПараметр("Кредит",ИнтересовалсяКредитом);
	Запрос.УстановитьПараметр("TradeIn",ИнтересовалсяТрейдИн);
	Запрос.УстановитьПараметр("Утилизация",ИнтересовалсяУтилизацией);
	
	СписокСкидок.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//добавим не автоакции
	Для Каждого Стр Из МассивНеАвтоАкций Цикл ЗаполнитьЗначенияСвойств(СписокСкидок.Добавить(),Стр) КонецЦикла;	
	
КонецФункции

&НаКлиенте
Процедура ДоступныеАкции(Команда)
	СтоимостьБазовойКомплектации = ЦенаВариантаКомплектации + ЦенаДопОпций - ЦенаВыкупа + ЦенаОборудования + ЦенаАвторабот + СтраховкаОСАГОСумма + СтраховкаКАСКОСумма + ГарантияСумма;
	
	УсловияОтбора  = Новый Структура;		
	УсловияОтбора.Вставить("СуммаБазы",СтоимостьБазовойКомплектации);
	УсловияОтбора.Вставить("ДилерскийЦентр",ТекДилерскийЦентр); 
	
	УсловияОтбора.Вставить("ВариантКомплектации",Версия);
	УсловияОтбора.Вставить("Модель",Модель);
	УсловияОтбора.Вставить("VIN",VIN);
