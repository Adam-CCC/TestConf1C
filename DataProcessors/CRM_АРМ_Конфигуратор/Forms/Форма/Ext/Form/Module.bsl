&НаКлиенте
Процедура ОпцииДилераДобавитьИзДопов(Команда)
	
	//Андрианова Начало 23.11.2016	
	//Ответ = Справочники.Renault_СписокДопов.ПолучитьФормуВыбора().ОткрытьМодально();
	ФормаОтвета = Справочники.Renault_СписокДопов.ПолучитьФормуВыбора();
	ФормаОтвета.Модель = Модель;
	ФормаОтвета.Версия = Версия; 
	Ответ = ФормаОтвета.ОткрытьМодально();
	//Андрианова Конец 23.11.2016
	
	Если ЗначениеЗаполнено(Ответ) Тогда
		
		Для Каждого ВыбранныеДопы Из Ответ Цикл
			
			НовСтрока = ВыбранноеОборудование.Добавить();
			НовСтрока.Номенклатура = ВыбранныеДопы.Ссылка;
			НовСтрока.Количество = 1;
			НовСтрока.Цена = ВыбранныеДопы.Стоимость;
			НовСтрока.Сумма = НовСтрока.Цена * НовСтрока.Количество;
			
			ПересчитатьЦенуАвто();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОткрытьЗаявкуНаТрейдИн(Команда)
	
	
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("РабочийЛист", ТекущийРабочийЛист);
	Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
	Если Не Выборка.Следующий() Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РабочийЛист", ТекущийРабочийЛист);
		ПараметрыФормы.Вставить("Клиент", ТекущийКлиент);
		ПараметрыФормы.Вставить("МенеджерЗаявитель", Менеджер);
		ОткрытьФорму("Документ.Renault_ЗаявкаНаТрейдИн.Форма.ФормаДокументаУпр", ПараметрыФормы);
		
	Иначе
		ЗаявкаНаТрейдИн = Выборка.Ссылка;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ЗаявкаНаТрейдИн); 
		ОткрытьФормуМодально("Документ.Renault_ЗаявкаНаТрейдИн.Форма.ФормаДокументаУпр", ПараметрыФормы);
		ЗагрузитьЗаявкуНаТрейдИн();
		ПересчитатьЦенуАвто();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтраховкаКАСКОПрограммаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ИнтересовалсяКредитом = Истина Тогда
		СтандартнаяОбработка = Ложь;
		СписокЗнач = НайтиДоступныеПрограммыКАСКО();
		Прогр = СписокЗнач.ВыбратьЭлемент();
		Если Прогр <> Неопределено Тогда
			СтраховкаКАСКОПрограмма = Прогр.Значение;
			СтраховкаКАСКОПрограммаПриИзменении(Элемент)
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДоступныеПрограммыКАСКО()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_СтраховыеПрограммы.Ссылка КАК Программа
	|ИЗ
	|	Справочник.CRM_СтраховыеПрограммы КАК CRM_СтраховыеПрограммы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CRM_КредитныеПредложения.ДоступныеСервисы КАК CRM_КредитныеПредложенияДоступныеСервисы
	|	ПО CRM_КредитныеПредложенияДоступныеСервисы.Сервис = CRM_СтраховыеПрограммы.КредитныйСервис
	|ГДЕ CRM_КредитныеПредложенияДоступныеСервисы.Сервис.Наименование ПОДОБНО &Текст
	|	И CRM_КредитныеПредложенияДоступныеСервисы.Ссылка = &Предложение
	|	И CRM_СтраховыеПрограммы.Владелец = &Компания";
	Запрос.УстановитьПараметр("Текст", "%КАСКО%");
	Запрос.УстановитьПараметр("Предложение", КредитноеПредложение);
	Запрос.УстановитьПараметр("Компания", СтраховкаКАСКОКомпания);
	Результат = Запрос.Выполнить().Выгрузить();
	Массив = Результат.ВыгрузитьКолонку("Программа");
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Массив);
	
	Возврат Список;
	
КонецФункции

&НаСервере
Функция ПолучитьДоступныеЗначения(Процент = Неопределено, Срок = Неопределено)
	
	Результат = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ";
	Если Процент = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + 
		"	CRM_КредитныеПредложенияКредитныеСтавки.ПервоначальныйВзносОт КАК МинВзнос,
		|	CRM_КредитныеПредложенияКредитныеСтавки.ПервоначальныйВзносДо КАК МаксВзнос,";
	КонецЕсли;
	Если Срок = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + 
		"	CRM_КредитныеПредложенияКредитныеСтавки.МинимальныйСрокМес КАК МинСрок,
		|	CRM_КредитныеПредложенияКредитныеСтавки.МаксимальныйСрокМес КАК МаксСрок,";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + Символы.ПС + 
	"	CRM_КредитныеПредложенияКредитныеСтавки.Ставка_Банк
	|ИЗ
	|	Справочник.CRM_КредитныеПредложения.КредитныеСтавки КАК CRM_КредитныеПредложенияКредитныеСтавки
	|ГДЕ CRM_КредитныеПредложенияКредитныеСтавки.Ссылка = &Ссылка
	|	И ВЫБОР КОГДА &Срок <> НЕОПРЕДЕЛЕНО ТОГДА
	|		(CRM_КредитныеПредложенияКредитныеСтавки.МинимальныйСрокМес <= &Срок
	|		И CRM_КредитныеПредложенияКредитныеСтавки.МаксимальныйСрокМес >= &Срок)
	|	ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР КОГДА &ПервоначальныйВзносПроцент <> НЕОПРЕДЕЛЕНО ТОГДА
	|		(CRM_КредитныеПредложенияКредитныеСтавки.ПервоначальныйВзносОт <= &ПервоначальныйВзносПроцент
	|		И CRM_КредитныеПредложенияКредитныеСтавки.ПервоначальныйВзносДо >= &ПервоначальныйВзносПроцент)
	|	ИНАЧЕ ИСТИНА
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("Ссылка", КредитноеПредложение);
	Запрос.УстановитьПараметр("ПервоначальныйВзносПроцент", Процент);
	Запрос.УстановитьПараметр("Срок", Срок);
	Результат = Запрос.Выполнить().Выгрузить();
	//Если НЕ Выборка.Следующий() Тогда
	//	Результат = Ложь;
	//КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

