&НаКлиенте
Процедура СкорректироватьИтоговуюСтоимость(Разница) Экспорт
	
	Если (Разница) > 0 Тогда
		СуммаДоставки = СуммаДоставки+разница;
	ИначеЕсли  (Разница) < 0 Тогда
		СуммаСкидки = -Разница; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЦенуРОП()
	
	// [ВОРОБЬЕВ]] 01.03.2017 +++
	Если ЗначениеЗаполнено(ТекущееКП) И ТекущееКП.Renaut_ЦенаРОП <> 0 Тогда
		ЦенаРОП = ТекущееКП.Renaut_ЦенаРОП;
		УстановитьРасчетнуюПоЦенеРоп = Истина;
		
		Возврат;
	КонецЕсли;
	// [[ВОРОБЬЕВ]] --- 
	
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	CRM_ДополнительнаяИнформацияПоАвтомобилям.ЦенаПродажиРОП
		|ИЗ
		|	РегистрСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям КАК CRM_ДополнительнаяИнформацияПоАвтомобилям
		|ГДЕ
		|	CRM_ДополнительнаяИнформацияПоАвтомобилям.Автомобиль = &Автомобиль");
		Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЦенаРОП = Выборка.ЦенаПродажиРОП;
		Иначе
			ЦенаРОП = 0;
		КонецЕсли;
		
	Иначе
		ЦенаРОП = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаПодбор(Команда)
	
	ДокОбъект = СоздатьЗаявкуНаСервере();
	Форма = ДокОбъект.ПолучитьФорму("ФормаДокумента_Менеджер");
	Форма.Открыть();
	
КонецПроцедуры

&НаСервере
Функция СоздатьЗаявкуНаСервере()
	
	// создаем новую заявку
	ЗаявкаДок = Документы.CRM_ЗаявкаНаПодборАвтомобиля.СоздатьДокумент();
	ЗаявкаДок.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
	ЗаявкаДок.Модель = Модель;
	ЗаявкаДок.Комплектация = Версия;
	ЗаявкаДок.Цвет = Цвет;
	ЗаявкаДок.РабочийЛист = ТекущийРабочийЛист;
	ЗаявкаДок.Статус = Перечисления.CRM_СтатусыЗаявокАвтосклад.НеПринятаКРаботе;
	Для Каждого СтрокаДоп ИЗ ВыбранныеНебазовыеОпции Цикл
		Если СтрокаДоп.Выбран Тогда
			НоваяДоп = ЗаявкаДок.ДопОпции.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяДоп, СтрокаДоп);
			НоваяДоп.Количество = 1;
			НоваяДоп.Сумма = НоваяДоп.Цена * НоваяДоп.Количество;
		КонецЕсли;
	КонецЦикла;
	Возврат ЗаявкаДок;
	
КонецФункции

