Процедура ЗаявкаНаКредитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Форма = Документы.Renault_CRM_ЗаявкаНаКредит.ПолучитьФорму("Документ.Renault_CRM_ЗаявкаНаКредит.ФормаВыбора");
	Форма.Отбор.Клиент.ВидСравнения = ВидСравнения.Равно;
	Форма.Отбор.Клиент.Значение = ТекущийКлиент;
	Форма.Отбор.Клиент.Использование = Истина;
	Форма.Отбор.Черновик.ВидСравнения = ВидСравнения.Равно;
	Форма.Отбор.Черновик.Значение = ложь;
	Форма.Отбор.Черновик.Использование= Истина;
	Форма.Отбор.Закрыта.ВидСравнения = ВидСравнения.Равно;
	Форма.Отбор.Закрыта.Значение = ложь;
	Форма.Отбор.Закрыта.Использование = Истина;
	Форма.Отбор.ПометкаУдаления.Значение = Ложь;
	Форма.Отбор.ПометкаУдаления.Использование = Истина;
	Форма.РежимВыбора = истина;
	
	Итог = Форма.ОткрытьМодально();
	ЗаявкаНаКредитВыборСервер(Итог);
	ЗаявкаНаКредитОчисткаСервер();
	СтандартнаяОбработка = Ложь;
	
