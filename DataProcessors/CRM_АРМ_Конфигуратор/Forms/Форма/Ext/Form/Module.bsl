&НаСервере
Процедура ПолучитьСуммуДоставки()
	
	СтоимостьДоставки = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ЕСТЬNULL(ПоВерсиям.СтоимостьДоставки, ПоМоделям.СтоимостьДоставки), 0) КАК СтоимостьДоставки
	|ИЗ
	|	(ВЫБРАТЬ
	|		Renault_СтоимостьДоставкиАвтомобилей.СтоимостьДоставки КАК СтоимостьДоставки
	|	ИЗ
	|		РегистрСведений.Renault_СтоимостьДоставкиАвтомобилей КАК Renault_СтоимостьДоставкиАвтомобилей
	|	ГДЕ
	|		Renault_СтоимостьДоставкиАвтомобилей.Версия = &Версия) КАК ПоВерсиям
	|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Renault_СтоимостьДоставкиАвтомобилей.СтоимостьДоставки КАК СтоимостьДоставки
	|		ИЗ
	|			РегистрСведений.Renault_СтоимостьДоставкиАвтомобилей КАК Renault_СтоимостьДоставкиАвтомобилей
	|		ГДЕ
	|			Renault_СтоимостьДоставкиАвтомобилей.Модель = &Модель) КАК ПоМоделям
	|		ПО (ИСТИНА)";
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("Модель", Модель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтоимостьДоставки = Выборка.СтоимостьДоставки;
	КонецЕсли;
	Если СтоимостьДоставки = 0 ИЛИ Не ЗначениеЗаполнено(СтоимостьДоставки) Тогда
		СтоимостьДоставки = ТекДилерскийЦентр.СтоимостьДоставкиПоУмолчанию;;
	КонецЕсли;
	
	СуммаДоставки = СтоимостьДоставки;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицыСклад()
	
	ТекущийДЦ = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	BIR_Distri = СокрЛП(ТекущийДЦ.BIR_Distri);
	МассивСкладовДилера = ТекущийДЦ.СкладыДилера.ВыгрузитьКолонку("Склад");
	// начало добавление Зеленчук
	МассивВариантовКомплектаций = Новый Массив;
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Для Каждого ТекСтрока Из ТаблицаКомплектации Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Ссылка) Тогда
				МассивВариантовКомплектаций.Добавить(ТекСтрока.Ссылка);
			КонецЕсли;
		КонецЦикла;
	Иначе
		МассивВариантовКомплектаций.Добавить(Версия);
	КонецЕсли;
	// окончание добавление Зеленчук
	// начало изменение Зеленчук
	//ТаблицаСклад.Загрузить(CRM_Сервер.Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей("", МассивСкладовДилера, BIR_Distri, Ложь, Ложь, Ложь, Ложь, Модель, Версия, Цвет, Ложь,, ТекущийДЦ.ДатаНеПоказыватьВыданныеАвтомобили));
	ТаблицаСклад.Загрузить(CRM_Сервер.Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей("", МассивСкладовДилера, BIR_Distri, Ложь, Ложь, Ложь, Ложь, Модель, МассивВариантовКомплектаций, Цвет, Ложь,, ТекущийДЦ.ДатаНеПоказыватьВыданныеАвтомобили));
	// окончание изменение Зеленчук
	ТаблицаСклад.Сортировать("КоличествоДнейНаСкладеДилера Убыв, ПТСПолученДилером Возр");
	
	//Андрианова Начало 26.12.2016
	//если данных по выбранной модели нет, то предупредим пользователя о наличии модели с таким же названием
	Если ТаблицаСклад.Количество() = 0 И ЗначениеЗаполнено(Модель) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Модели.Ссылка
		|ИЗ
		|	Справочник.Модели КАК Модели
		|ГДЕ
		|	Модели.НаименованиеПолное ПОДОБНО &НаименованиеПолное
		|	И Модели.Ссылка <> &Модель";
		
		Запрос.УстановитьПараметр("НаименованиеПолное", Модель.НаименованиеПолное);
		Запрос.УстановитьПараметр("Модель", Модель);
		
		Результат = Запрос.Выполнить();
		
		Если НЕ Результат.Пустой() Тогда
			Если ЗначениеЗаполнено(Версия) Тогда
				Сообщить("В автоскладе нет данных по выбранной комплектации");
			Иначе
				Сообщить("В автоскладе нет данных по выбранной модели"); 
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	//Андрианова Конец 26.12.2016	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТТХИБазовыеОпции()
	
	ТТХ.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Renault_ДопИнформацияПоВерсиям.ОбъемДвигателя КАК ДвигательОбъем,
	|	Renault_ДопИнформацияПоВерсиям.ТипТоплива КАК ДвигательТипТоплива,
	|	Renault_ДопИнформацияПоВерсиям.МощностьЛС КАК ДвигательЛС,
	|	Renault_ДопИнформацияПоВерсиям.МощностьКВТ КАК Двигатель_кВт,
	|	Renault_ДопИнформацияПоВерсиям.СтандартЕвро КАК Двигатель_НормаЕвро,
	|	Renault_ДопИнформацияПоВерсиям.МаксимальнаяМасса КАК МассаMax,
	|	Renault_ДопИнформацияПоВерсиям.МинимальнаяМасса КАК МассаMin
	|ИЗ
	|	РегистрСведений.Renault_ДопИнформацияПоВерсиям КАК Renault_ДопИнформацияПоВерсиям
	|ГДЕ
	|	Renault_ДопИнформацияПоВерсиям.ВариантКомплектации = &Версия";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Объём двигателя";
		Стр.Значение = Выборка.ДвигательОбъем;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Тип топлива";
		Стр.Значение = Выборка.ДвигательТипТоплива;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Мощность (л.с.)";
		Стр.Значение = Выборка.ДвигательЛС;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Мощность (кВт)";
		Стр.Значение = Выборка.Двигатель_кВт;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Норма ЕВРО";
		Стр.Значение = Выборка.Двигатель_НормаЕвро;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Максимальная масса";
		Стр.Значение = Выборка.МассаMax;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Минимальная масса";
		Стр.Значение = Выборка.МассаMin;
	Иначе
		ТекущийИдентификатор = ""
	КонецЕсли;
	
	БазовыеОпции.Параметры.УстановитьЗначениеПараметра("Тариф", ТекущийТариф); 
	БазовыеОпции.Параметры.УстановитьЗначениеПараметра("Модель", Модель);
	БазовыеОпции.Параметры.УстановитьЗначениеПараметра("ВариантКомплектации", Версия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВерсииАвтоКлиент()
	
	ПересчитатьЦенуАвто();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКоммерческоеПредложение(КоммерческоеПредложениеСсылка, ПриОткрытии)
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	ПрочитатьДанныеКП();
	
	Если Не ТекущееКП.Пустая() Тогда
		
		Элементы.СписокКП.ТекущаяСтрока = ТекущееКП;
		ОткрытьСтраницуСоставКП();
		ЗагрузитьКонфигурациюВКонфигураторКлиент(ТекущаяКонфигурация);
		
	КонецЕсли;
	
	ОбновитьЗаголовки();
	ОбновитьВидимостьЭлементов();
	
	//Козлов Е.А. Начало 02.02.2017
	Если Не ПриОткрытии И НЕ ЭтоКорпКлиент Тогда
		//РассчитатьСкидкиПоАвтомобилю();
		ПересчитатьСтоимость();
		СуммаСкидки = СписокСкидок.Итог("СуммаСкидки");
		
		ПересчитатьЦенуАвто();
	КонецЕсли;	
	//Козлов Е.А. Конец
	
	ТекущийЦветСалона = КоммерческоеПредложениеСсылка.ЦветСалона;
	ТекущийВариантСалона = КоммерческоеПредложениеСсылка.ВариантСалона;
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
	ОбновитьДанныеПрикрепленныхФайлов();
	
	СоздаватьЗаявкуНаСтраховку = ИнтересовалсяСтраховкой;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьАвтомобильВКонфигураторКлиент(АвтомобильСсылка)
	
	ТекущийТариф = Renault_CRM.ПолучитьПоследнийТарифНаАвтомобиль(АвтомобильСсылка.ВариантКомплектации);
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	Автомобиль = АвтомобильСсылка;
	если ЗначениеЗаполнено(Автомобиль) Тогда
		vin = Автомобиль.VIN;
	КонецЕсли;
	
	УстановитьЦенуРОП();
	Если не ЭтоТрейдИН Тогда
		
		ИндексыСтрок = ЗагрузитьАвтомобильВКонфигураторСервер(АвтомобильСсылка);
		ОбновитьТаблицыПоДаннымРеквизитов(ИндексыСтрок); 
		
	КонецЕсли;    
	ПересчитатьЦенуВариантаКомплектации(); //Плохо. Необходимо устанавливать в соответствии с авто
	ОбновитьТТХИБазовыеОпции();
	ОбновитьКартинкуМодели();
	
	ОбновитьСпискиОборудованияАксессуаров(); //Дополнительные опции
	ЗагрузитьОпцииИзАвтомобиля(АвтомобильСсылка);
	
	ПриИзмененииВерсииАвтоКлиент();
	
	ОбновитьЗаголовки();
	ОбновитьВидимостьЭлементов();
	ОбновитьРежимРедактирования();
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
	ГодВыпуска = Renault_ОбщегоНазначения.ПолучитьГодВыпуска(Автомобиль);	
	Если ГодВыпуска = 0 Тогда
		ГодВыпуска = Год(ТекущаяДата());
	КонецЕсли;
	
	//Козлов Е.А. Начало 02.02.2017
	Если НЕ ЭтоКорпКлиент Тогда
		//РассчитатьСкидкиПоАвтомобилю();
		ПересчитатьСтоимость();
		СуммаСкидки = СписокСкидок.Итог("СуммаСкидки");
		
		ПересчитатьЦенуАвто();
	КонецЕсли;	
	//Козлов Е.А. Конец
	
	// ++ Ковалев ЕС от 23.08.2018
	ДанныеПередачиСтруктура = ЗаполнитьДатыПередачиАвтомобиляПоVIN(Автомобиль);
	РасчетнаяДатаПередачи     = ДанныеПередачиСтруктура.РасчетнаяДатаПередачи;
	ДатаНачалаПередачиАвто	  = ДанныеПередачиСтруктура.ДатаНачалаПередачиАвто;
	ДатаОкончанияПередачиАвто = ДанныеПередачиСтруктура.ДатаОкончанияПередачиАвто;
	// -- Ковалев ЕС от 23.08.2018
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьАвтомобильВКонфигураторСервер(АвтомобильСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.Модель,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.Версия,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.Цвет,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.OPTIONS,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN
	|ИЗ
	|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|ГДЕ
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль = &Автомобиль";
	Запрос.УстановитьПараметр("Автомобиль", АвтомобильСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	VIN = "";
	Модель = Справочники.Модели.ПустаяСсылка();
	Версия = Справочники.ВариантыКомплектации.ПустаяСсылка();
	Цвет = Справочники.Цвета.ПустаяСсылка();
	
	Если Выборка.Следующий() Тогда
		
		VIN = Выборка.VIN;
		Модель = Выборка.Модель;
		Версия = Выборка.Версия;
		Цвет = Выборка.Цвет;
		
		ОбновитьДОПоАвтомобилю(АвтомобильСсылка);
		
	КонецЕсли;
	
	ОбновитьСписокКонфигураций(Модель);
	ОбновитьСписокЦветов(Модель);
	
	ИндексыСтрок = ПолучитьИндексыСтрокТаблиц(Модель, Версия, Цвет);
	
	Если ИндексыСтрок.ИндексМодель = Неопределено Тогда
		Элементы.ПолеМодель.Видимость = Истина;
	Иначе
		Элементы.ПолеМодель.Видимость = Ложь;
	КонецЕсли;
	
	Если ИндексыСтрок.ИндексВерсия = Неопределено Тогда
		Элементы.ПолеКомплектация.Видимость = Истина;
	Иначе
		Элементы.ПолеКомплектация.Видимость = Ложь;
	КонецЕсли;
	
	Если ИндексыСтрок.ИндексЦвет = Неопределено Тогда
		Элементы.ПолеЦвет.Видимость = Истина;
	Иначе
		Элементы.ПолеЦвет.Видимость = Ложь;
	КонецЕсли;
	
	Возврат ИндексыСтрок;
	
КонецФункции

&НаСервере
Процедура ОбновитьДОПоАвтомобилю(АвтомобильСсылка)
	//Козлов Е.А. Начало 26.01.2017
	НастройкиБазы = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];		
	ТиповойУчетДО = НастройкиБазы.ИспользоватьТиповойУчетДО;
	
	Запрос = Новый Запрос;
	
	Если ТиповойУчетДО Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Опция
		|ПОМЕСТИТЬ ВТ_Опции
		|ИЗ
		|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних КАК Renault_ТарифНаОпцииАвтомобилейСрезПоследних
		|ГДЕ
		|	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.ВариантКомплектации = &ВариантКомплектации
		|	И Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Модель = &Модель
		|	И Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Тариф = &Тариф
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КомплектацияАвтомобилейОстатки.Номенклатура,
		|	КомплектацияАвтомобилейОстатки.КоличествоОстаток КАК Количество,
		|	ЦеныСрезПоследних.Цена,
		|	ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0) * ЕСТЬNULL(КомплектацияАвтомобилейОстатки.КоличествоОстаток, 0) КАК Сумма
		|ИЗ
		|	РегистрНакопления.КомплектацияАвтомобилей.Остатки(
		|			,
		|			Автомобиль.Ссылка = &Автомобиль
		|				И НЕ Номенклатура В
		|						(ВЫБРАТЬ
		|							ВТ_Опции.Опция
		|						ИЗ
		|							ВТ_Опции КАК ВТ_Опции)) КАК КомплектацияАвтомобилейОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(, ТипЦен = &ТипЦен) КАК ЦеныСрезПоследних
		|		ПО КомплектацияАвтомобилейОстатки.Номенклатура = ЦеныСрезПоследних.Номенклатура";
		Запрос.УстановитьПараметр("Модель", АвтомобильСсылка.Модель);
		Запрос.УстановитьПараметр("ВариантКомплектации", АвтомобильСсылка.ВариантКомплектации);
		Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
		//Запрос.УстановитьПараметр("ТипЦен", ТекДилерскийЦентр.ТипЦенПродажиДО);
		Запрос.УстановитьПараметр("ТипЦен", ТекДилерскийЦентр.ТипЦенДО);
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.Оборудование КАК Номенклатура,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА Renault_УстановленноеОборудованиеАвтомобилейОстатки.КоличествоОстаток = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВЫРАЗИТЬ(Renault_УстановленноеОборудованиеАвтомобилейОстатки.СтоимостьОстаток / Renault_УстановленноеОборудованиеАвтомобилейОстатки.КоличествоОстаток КАК ЧИСЛО(15, 2))
		|	КОНЕЦ КАК Цена,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.СтоимостьОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.Renault_УстановленноеОборудованиеАвтомобилей.Остатки(, Автомобиль = &Автомобиль) КАК Renault_УстановленноеОборудованиеАвтомобилейОстатки";
	КонецЕсли;
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Опция
	//|ПОМЕСТИТЬ ВТ_Опции
	//|ИЗ
	//|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних КАК Renault_ТарифНаОпцииАвтомобилейСрезПоследних
	//|ГДЕ
	//|	Renault_ТарифНаОпцииАвтомобилейСрезПоследних.ВариантКомплектации = &ВариантКомплектации
	//|	И Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Модель = &Модель
	//|	И Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Тариф = &Тариф
	//|;
	//|
	//|////////////////////////////////////////////////////////////////////////////////
	//|ВЫБРАТЬ
	//|	КомплектацияАвтомобилейОстатки.Номенклатура,
