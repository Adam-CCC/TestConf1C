	ПараметрыФормы.Вставить("ТрейдИнЦвет",				ТрейдИнЦвет);
	ПараметрыФормы.Вставить("ТрейдИнГодВыпуска",		ТрейдИнГодВыпуска);
	ПараметрыФормы.Вставить("ТрейдИнСумма",				ТрейдИнСумма);
