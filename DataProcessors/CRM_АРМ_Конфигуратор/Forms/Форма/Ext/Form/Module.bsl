&НаКлиенте
Процедура ОбработкаАктивацииКомплектации()
	
	Если НеОбновлятьПриАктивизацииСтроки Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущийЭлемент <> Элементы.ТаблицаКомплектации Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ТаблицаКомплектации.ТекущиеДанные = Неопределено Тогда
		Версия = Неопределено;
	ИначеЕсли Версия = Элементы.ТаблицаКомплектации.ТекущиеДанные.Комплектация Тогда
		Возврат;
	Иначе
		Версия = Элементы.ТаблицаКомплектации.ТекущиеДанные.Ссылка;
	КонецЕсли;
	
	ПриИзмененииВерсииАвто();
	//VIN = "";
	
КонецПроцедуры

