			//	ЗаписьТрафик.Менеджер = СотрудникВыбор;
			//Иначе
			//	ЗаписьТрафик.Отдел = СотрудникВыбор;
			//КонецЕсли;		
			//ЗаписьТрафик.Администратор = Сотрудник;
			//ЗаписьТрафик.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный;
			//ЗаписьТрафик.Представление = Клиент_ФИО;
			//ЗаписьТрафик.Обработан = Истина;
			//ЗаписьТрафик.ДилерскийЦентр = ДилерскийЦентр;
			//ЗаписьТрафик.Клиент = Клиент;	
			//ЗаписьТрафик.Записать();
			
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			// Трояновский К.Е. 12.08.2019 10:47:09 {
			//"ВЫБРАТЬ
			//|	*
			//|ИЗ
			//|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
			//|ГДЕ
			//|	Renault_РабочиеЛисты.СвязаныйIDK = &IDK
			//|	И Renault_РабочиеЛисты.ТипРабочегоЛиста = Значение(Перечисление.Renault_ТипыРабочихЛистов.TradeIn)";
			"ВЫБРАТЬ
			|	Renault_РабочиеЛисты.Ссылка
			|ИЗ
			|	Документ.Renault_РабочийЛист КАК Renault_РабочиеЛисты
			|ГДЕ
			|	Renault_РабочиеЛисты.СвязаныйIDK = &IDK
			|	И Renault_РабочиеЛисты.ТипРабочегоЛиста = Значение(Перечисление.Renault_ТипыРабочихЛистов.TradeIn)";			
			// Трояновский К.Е. 12.08.2019 10:47:09 }
			
			Запрос.УстановитьПараметр("IDK", IDK);
			Выборка = Запрос.Выполнить().Выбрать();
			
