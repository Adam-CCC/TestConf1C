	ПараметрыФормы.Вставить("СрокКредита", СрокКредита);
	ПараметрыФормы.Вставить("СтавкаБанка", СтавкаБанка);
	ПараметрыФормы.Вставить("ЕжемесячныйПлатеж", ЕжемесячныйПлатеж);
