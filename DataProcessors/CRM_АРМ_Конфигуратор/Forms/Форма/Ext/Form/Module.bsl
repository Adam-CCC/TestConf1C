	Если ЗначениеЗаполнено(Действие) Тогда
		Попытка
			Выполнить(Строка(Действие) + "(Элемент, ДанныеВыбора, СтандартнаяОбработка)");     
		Исключение
		КонецПопытки;	
	КонецЕсли;
	
	ОбработкаИзмененияДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияДанных()
	
	
	ЭтаФорма.Модифицированность = Истина;
	
	Если ЗначениеЗаполнено(ТекущееКП) 
		И ТипЗнч(ТекущееКП) =  Тип("ДокументСсылка.CRM_КоммерческоеПредложение") Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Перезаписать?",Режим,0) ;
		Если Ответ = КодВозвратаДиалога.Да Тогда
			КонфигурацияПерезаписать();
		КонецЕсли ;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Массив=Новый Массив;
	
	Массив.Добавить(Элементы.ДекорацияЛоготип);
	Массив.Добавить(Элементы.Закрыть);
	Массив.Добавить(Элементы.ОткрытьСклад);
	Массив.Добавить(Элементы.ПоказатьЗаполненныйТекст);
	
	Renault_ОбщиеФункции.МультибрендОсновноеОформление(Массив);
	
	НастройкиОтправки = Renault_CRM.ПолучитьНастройкиОтправкиКП(ПараметрыСеанса.Пользователь.Сотрудник);
	РассылкаУчетнаяЗапись = НастройкиОтправки.УчетнаяЗапись;
	РассылкаТемаСообщения = НастройкиОтправки.Тема;
	РассылкаТекстСоообщения = НастройкиОтправки.Текст;
	Если ЗначениеЗаполнено( НастройкиОтправки.УчетнаяЗапись) Тогда
		РассылкаПредставление = НастройкиОтправки.УчетнаяЗапись.Наименование;
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	ПриОткрытииСервер();
	
	Если Не ТекущееКП.Пустая() Тогда
		//Загрузим коммерческое предложение при открытии
		ЗагрузитьКоммерческоеПредложение(ТекущееКП, Истина);
		
		//оборудование
		ВыбранноеОборудование.Очистить();
		Для Каждого Стр Из ТекущееКП.Оборудование Цикл
			нСтр=ВыбранноеОборудование.Добавить();
			ЗаполнитьЗначенияСвойств(нСтр,Стр);
			нСтр.Номенклатура=Стр.Оборудование;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТекущееКП.ПолисОСАГО) Тогда
			
			СтраховкаОСАГОВключать = Истина;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекущееКП.ПолисКАСКО) Тогда
			
			СтраховкаКАСКОВключать = Истина;
			
		КонецЕсли;
		Возраст = ТекущееКП.Возраст;
		СтажВождения = ТекущееКП.СтажВождения;
		
		//ОбновитьТаблицыСклад();
		ОбновитьРежимРедактирования();
	ИначеЕсли Не Автомобиль.Пустая() Тогда
		//Загрузим автомобиль при открытии
		ЗагрузитьАвтомобильВКонфигураторКлиент(Автомобиль);
		//ОбновитьТаблицыСклад();
	Иначе	
		//Пустой конфигуратор
		Если НЕ ЭтоКорпКлиент Тогда
			ИнтересовалсяКредитом = Истина;
		Иначе
			ИнтересовалсяКорпЛизингом = Истина;
		КонецЕсли;
		ОбновитьСписокКонфигураций(Модель);
		ОбновитьСписокЦветов(Модель);
		ПриИзмененииВерсииАвто();
		ОбновитьВидимостьЭлементов();
		ОбновитьЗаголовки();
	КонецЕсли;
	
	ПроверитьПервичнуюМодель();
	ЗаполнитьОпцииНаСервере();
	ЗаполнитьДвигателиНаСервере();
	ЗаполнитьКППНаСервере();
	ПодключитьОбработчикОжидания("ОбновитьКартинкуМоделиКлиент", 0.2, Истина);
	ПриИзмененииМоделиАвто();
	
	УстановитьЦенуРОП();
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	ЗаявкаНаКредитОчисткаСервер();
	ЗаявкаНаОборудованиеОчисткаСервер();
	//ЗаявкаНаСтраховкуОчисткаСервер();
	ОбновитьОтображениеГруппПоЗаявкам();
	ПересчитатьЦенуАвто();
	ТипДвигателяОтбор = 1;
	ПредупредитьОбОтсутствииТарифа();
	Если УстановитьРасчетнуюПоЦенеРоп Тогда УстановитьРасчетнуюПоЦенеРопПриИзменении(Элементы.УстановитьРасчетнуюПоЦенеРоп); КонецЕсли;
	
	УправлениеКнопкамиОФУ();
	ЗакрытьФорму = Ложь;
	
	
	
	Если ЗначениеЗаполнено(Версия) Тогда
		Для Каждого Строка Из ТаблицаКомплектации цикл
			Если Строка.Ссылка=Версия Тогда Элементы.ТаблицаКомплектации.ТекущаяСТрока=Строка.ПолучитьИдентификатор(); Прервать КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьТаблицыСалон();
	
	Если ЗначениеЗаполнено(ТекущийВариантСалона) Тогда
		Для Каждого Строка Из Таблица_ВариантыСалона цикл
			Если Строка.Ссылка=ТекущийВариантСалона Тогда Элементы.ТаблицаВариантыСалона.ТекущаяСТрока=Строка.ПолучитьИдентификатор(); Прервать КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийЦветСалона) Тогда
		Для Каждого Строка Из Таблица_ЦветаСалона цикл
			Если Строка.Ссылка=ТекущийЦветСалона Тогда Элементы.ТаблицаЦветаСалона.ТекущаяСТрока=Строка.ПолучитьИдентификатор(); Прервать КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	
	Если ЗначениеЗаполнено(Цвет) Тогда                             
		Для Каждого Строка Из ТаблицаЦвета Цикл
			Если Строка.Цвет=Цвет Тогда Элементы.ТаблицаЦвета.ТекущаяСТрока=Строка.ПолучитьИдентификатор(); Прервать КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ИнтересовалсяУтилизацией И ИнтересовалсяТрейдИн Тогда
		ИнтересовалсяУтилизацией = Ложь;
	КонецЕсли;
	
	Элементы.ИнтересовалсяТрейдИн.Доступность = НЕ ИнтересовалсяУтилизацией;
	
	Элементы.ИнтересовалсяУтилизацией.Доступность = НЕ ИнтересовалсяТрейдИн;	
	
	Если ПоказатьСтраницуОборудования Тогда
		Элементы.ГруппаСтраницыКонфигурирование.ТекущаяСтраница = Элементы.ГруппаСтраницыКонфигурирование.ПодчиненныеЭлементы.ГруппаОпции;
		Элементы.ГруппаПараметрыКонфигурации.ТекущаяСтраница    = Элементы.ГруппаПараметрыКонфигурации.ПодчиненныеЭлементы.ГруппаЗакладкаОборудование;
	КонецЕсли; 
	
	Если СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да Тогда 
		Элементы.ПечатьСогласиеНаОПД.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

