//DMSREN-867 +++
&НаКлиенте
Процедура ПечатьСогласиеНаОПД(Команда)
	Ошибка = Ложь;
	Попытка
		СтруктураПараметровОПД = СофрмироватьПараметрыДляПФ("ПерсональныеДанные");
		МассивФайловОПД = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровОПД,ТекущийКлиент);
		
		Если МассивФайловОПД = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось получить печатную форму");
		Иначе 
			Для каждого Файл Из МассивФайловОПД Цикл
				НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
			КонецЦикла;
		КонецЕсли;
		
		Если ТипЗнч(ТекущийКлиент) = Тип("СправочникСсылка.Контрагенты") Тогда
			Если Не ТекущийКлиент.СогласиеНаПолучениеSMS Тогда 
				Возврат;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ТекущийКлиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда 
			Если Не ТекущийКлиент.СогласенНаКоммуникацию Тогда 
				Возврат;
			КонецЕсли;
		КонецЕсли;

		СтруктураПараметровКоммуникация = СофрмироватьПараметрыДляПФ("Коммуникация");		
		
		Если СтруктураПараметровКоммуникация = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		МассивФайловКоммуникация = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровОПД,ТекущийКлиент);

		Если МассивФайловКоммуникация = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось получить печатную форму");
		Иначе 
			Для каждого Файл Из МассивФайловКоммуникация Цикл
				НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
			КонецЦикла;	
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция СофрмироватьПараметрыДляПФ(ВидСогласия)
	
	СтруктураОбъекта = Новый Структура;
	СтруктураКлиента = Новый Структура;
	СтруктураДокумента = Новый Структура;
	СтруктураАвтомобиля = Новый Структура;
	СтруктураСогласия = Новый Структура;
	СтруктураОтвветсвенный = Новый Структура;
	
	Если ТипЗнч(ТекущийКлиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат ЗаполнитьДанныеПоКонтрагенту(ТекущийКлиент,Автомобиль,ДатаНачалаПередачиАвто,ВидСогласия);
	ИначеЕсли ТипЗнч(ТекущийКлиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда 
		Возврат ЗаполнитьДанныеПоПотенциальномуКлиенту(ВидСогласия);	
	КонецЕсли;

	Возврат СтруктураОбъекта;
	
КонецФункции

