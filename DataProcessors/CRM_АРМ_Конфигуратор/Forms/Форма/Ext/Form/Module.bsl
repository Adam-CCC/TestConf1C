&НаСервере
процедура ЗагрузитьЗаявкуНаСтраховку()
	
	Если ЗначениеЗаполнено(ЗаявкаНаСтраховку) тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_CRM_ЗаявкаНаСтраховку.ВидСтраховойПрограммы,
		//|	Renault_CRM_ЗаявкаНаСтраховку.СтраховаяПрограмма КАК СтраховаяПрограмма,
		|	Renault_CRM_ЗаявкаНаСтраховку.Ссылка.Комментарий КАК Комментарий,
		|	Renault_CRM_ЗаявкаНаСтраховку.Сумма КАК Сумма
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСтраховку КАК Renault_CRM_ЗаявкаНаСтраховку
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаСтраховку.Ссылка = &Ссылка
		//|	И Renault_CRM_ЗаявкаНаСтраховку.ВидСтраховойПрограммы = ЗНАЧЕНИЕ(Справочник.Удалить_CRM_ВидыСтраховыхПрограмм.Каско)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Renault_CRM_ЗаявкаНаСтраховку.ВидСтраховойПрограммы,
		//|	Renault_CRM_ЗаявкаНаСтраховку.СтраховаяПрограмма,
		|	Renault_CRM_ЗаявкаНаСтраховку.Ссылка.Комментарий,
		|	Renault_CRM_ЗаявкаНаСтраховку.Сумма
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСтраховку КАК Renault_CRM_ЗаявкаНаСтраховку
		|ГДЕ
		|	Renault_CRM_ЗаявкаНаСтраховку.Ссылка = &Ссылка
		|	И Renault_CRM_ЗаявкаНаСтраховку.ВидСтраховойПрограммы = ЗНАЧЕНИЕ(Справочник.Удалить_CRM_ВидыСтраховыхПрограмм.Осаго)";
		Запрос.УстановитьПараметр("Ссылка", ЗаявкаНаСтраховку);
		
		Результат = Запрос.Выполнить().Выбрать();
		Пока Результат.Следующий() Цикл
			Если Результат.ВидСтраховойПрограммы = Справочники.CRM_ВидыСтраховыхПрограмм.Осаго Тогда
				СтраховкаОСАГОВключать = Истина;
				//СтраховкаОСАГОПрограмма = Результат.СтраховаяПрограмма;
				СтраховкаОСАГОСумма = Результат.Сумма;
			ИначеЕсли Результат.ВидСтраховойПрограммы = Справочники.CRM_ВидыСтраховыхПрограмм.Каско Тогда
				СтраховкаКАСКОВключать = Истина;
				//СтраховкаКАСКОПрограмма = Результат.СтраховаяПрограмма;
				СтраховкаКАСКОСумма = Результат.Сумма;
			КонецЕсли;
		КонецЦикла;
		СтажВождения = ЗаявкаНаСтраховку.СтажВождения;
		Возраст = ЗаявкаНаСтраховку.ВозрастКлиента;
	КонецЕсли;
	
КонецПроцедуры

Функция СоздатьНайтиЗаявкуНаСтраховку()
	
	ЗначениеПустое = Ложь;
	Если ЗначениеЗаполнено(ЗаявкаНаСтраховку) Тогда
		ДокОб = ЗаявкаНаСтраховку.Ссылка.ПолучитьОбъект();
	ИначеЕсли СоздаватьЗаявкуНаСтраховку Тогда
		ДокОб = Документы.Renault_CRM_ЗаявкаНаСтраховку.СоздатьДокумент();
		ДокОб.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаСтраховку.Черновик;
	Иначе
		ДокОб = Документы.Renault_CRM_ЗаявкаНаСтраховку.ПустаяСсылка();
		ЗначениеПустое = Истина;
	КонецЕсли;
	
	Если Не(ЗначениеПустое)Или ИнтересовалсяСтраховкой Тогда
		МожноСохранить = Ложь;
		Если ТипЗнч(ДокОб) = Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаСтраховку") И НЕ ДокОб.ЭтоНовый() Тогда
			Если ДокОб.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаСтраховку.Черновик Тогда
				МожноСохранить = Истина;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДокОб) = Тип("ДокументОбъект.Renault_CRM_ЗаявкаНаСтраховку") Тогда 
			МожноСохранить = Истина;
		КонецЕсли;
		Если МожноСохранить тогда
			ДокОб.Версия = Версия;
			ДокОб.Комментарий = СтраховкаКомментарий;
			ДокОб.Дата = ТекущаяДата();
			ДокОб.Клиент = Метаданные.Документы.Renault_CRM_ЗаявкаНаСтраховку.Реквизиты.Клиент.Тип.ПривестиЗначение( ТекущийКлиент);
			//ДокОб.Комментарий = ТрейдИнКомментарий;
			ДокОб.Модель = Модель;
			ДокОб.РабочийЛист = ТекущийРабочийЛист;
			ДокОб.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			ДокОб.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаСтраховку.Черновик;
			//ДокОб.Автомобиль = Автомобиль;
			//ДокОб.ЦенаАвтомобиля = ЦенаИТОГО;
			//ДокОб.НадписьЦена = ПолучитьОписаниеЦены ();
			ДокОб.ХозОперация = Справочники.ХозОперации.ПрочиеДокументы;
			//ДокОб.Автор = ПараметрыСеанса.Пользователь;
			//ДокОб.Операция = Перечисления.Renault_ВидыОперацийСтрахования.ПервичныйРасчет;
			ДокОб.ВозрастКлиента = Возраст;
			ДокОб.СтажВождения = СтажВождения;
			Если СтраховкаОСАГОВключать Тогда
				СтрокаТЗ = ДокОб.ВариантыСтрахования.Найти(Перечисления.ВидыСтрахования.ОСАГО);
				Если СтрокаТЗ = Неопределено Тогда
					СтрокаТЗ = ДокОб.ВариантыСтрахования.Добавить();
					СтрокаТЗ.ВидСтраховойПрограммы = Перечисления.ВидыСтрахования.ОСАГО;
				КонецЕсли;
			иначе
				СтрокаТЗ = ДокОб.ВариантыСтрахования.Найти(Перечисления.ВидыСтрахования.ОСАГО);
				Если СтрокаТЗ <> Неопределено Тогда
					ДокОб.ВариантыСтрахования.Удалить(СтрокаТЗ);
				КонецЕсли;
			КонецЕсли;
			Если СтраховкаКАСКОВключать Тогда
				СтрокаТЗ = ДокОб.ВариантыСтрахования.Найти(Перечисления.ВидыСтрахования.КАСКО);
				Если СтрокаТЗ = Неопределено Тогда
					СтрокаТЗ = ДокОб.ВариантыСтрахования.Добавить();
					СтрокаТЗ.ВидСтраховойПрограммы = Перечисления.ВидыСтрахования.КАСКО;
				КонецЕсли;
			иначе
				СтрокаТЗ = ДокОб.ВариантыСтрахования.Найти(Перечисления.ВидыСтрахования.КАСКО);
				Если СтрокаТЗ <> Неопределено Тогда
					ДокОб.ВариантыСтрахования.Удалить(СтрокаТЗ);
				КонецЕсли;
			КонецЕсли;
			
			//Сергеев DMSREN-1084
			//Если СтраховкаОСАГОВключать Тогда
			//	ДокОб.ВидСтраховойПрограммы = Справочники.CRM_ВидыСтраховыхПрограмм.Осаго;
			//КонецЕсли;
			//Если СтраховкаКАСКОВключать Тогда
			//	ДокОб.ВидСтраховойПрограммы = Справочники.CRM_ВидыСтраховыхПрограмм.Каско;
			//КонецЕсли;
			//--------------------
			
			ДокОб.Записать(РежимЗаписиДокумента.Проведение);
			ЗаявкаНаСтраховку = ДокОб.Ссылка;
			
			Запрос = Новый Запрос("Выбрать 1 Из Задача.Renault_События ГДЕ Объект=&Ссылка");
			Запрос.УстановитьПараметр("Ссылка", ДокОб.Ссылка);
			Результат = Запрос.Выполнить();
			Если Результат.Пустой() Тогда
				Задача = Задачи.Renault_События.СоздатьНовую(ДокОб.Ссылка ,Справочники.CRM_ВидыСобытий.Страховка, Строка(ДокОб.Ссылка));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДокОб.Ссылка;
	
КонецФункции

