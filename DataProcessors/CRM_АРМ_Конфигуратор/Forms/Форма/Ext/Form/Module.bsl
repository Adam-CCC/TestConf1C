&НаСервере
Функция ЗаполнитьДатыПередачиАвтомобиляПоVIN(АвтомобильСсылка);
	
	ДНПередачи = Дата(1,1,1);
	ДКПередачи = Дата(1,1,1);

	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("РасчетнаяДатаПередачи",     ДНПередачи);                  
	СтруктураВозврата.Вставить("ДатаНачалаПередачиАвто",    ДНПередачи);  
	СтруктураВозврата.Вставить("ДатаОкончанияПередачиАвто", ДКПередачи);
									
	Если ЗначениеЗаполнено(АвтомобильСсылка) И ЗначениеЗаполнено(АвтомобильСсылка.VIN) Тогда
		Попытка
			// Данные по датам находятся по пути:
			// https://rdwapp.renault.ru/api/v1/dates2/VF1RZG00261314000
			HTTPЗапрос = Новый HTTPЗапрос();
			HTTPЗапрос.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
			HTTPЗапрос.АдресРесурса = "/dates2/" + СокрЛП(АвтомобильСсылка.VIN);
			Соединение = Новый HTTPСоединение("rdw-app.prod.digital-hub.rnlt.ru/api/v1",,,,,,Новый ЗащищенноеСоединениеOpenSSL);
			ОтветHTTP = Соединение.Получить(HTTPЗапрос);
			
			ТелоЗапроса = ОтветHTTP.ПолучитьТелоКакСтроку();
			Если ОтветHTTP.КодСостояния = 200 Тогда
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
				Результат = ПрочитатьJSON(ЧтениеJSON);
				ЧтениеJSON.Закрыть();
				
				Если ТипЗнч(Результат) = Тип("Структура") Тогда
					Если Результат.Свойство("data") Тогда
						Для Каждого СтрокаМ Из Результат.data Цикл
							Если СтрокаМ.Свойство("attributes") Тогда
								//Пример формата даты: 2018-11-28T00:00:00+00:00
								Если СтрокаМ.attributes.Свойство("plandt") Тогда
									ПланДата = ПрочитатьДатуJSON(СтрокаМ.attributes.plandt, ФорматДатыJSON.ISO);
								КонецЕсли;	
								Если СтрокаМ.attributes.Свойство("realdt") Тогда
									РеалДата = ПрочитатьДатуJSON(СтрокаМ.attributes.realdt, ФорматДатыJSON.ISO);
								КонецЕсли;   
								
								//++DMSREN-95
								Если ПланДата <> Дата(1,1,1) И РеалДата <> Дата(1,1,1) Тогда
								//	МаксДата = ?(ПланДата > РеалДата, ПланДата, РеалДата);
								//	МинДата  = ?(ПланДата > РеалДата, РеалДата, ПланДата);
								//	
								//	Если (МаксДата - МинДата) / 86400 > 15 Тогда
								//		ДНПередачи = МаксДата - 15 * 86400;
								//		ДКПередачи = МаксДата;
								//	Иначе
								//		ДНПередачи = МинДата;
								//		ДКПередачи = МаксДата;
								//	КонецЕсли;	
									
									//// КовалевЕС от 04.06.19 { DMSCOR-1319
									//Если ДНПередачи <> Дата(1,1,1) И НачалоДня(ДКПередачи) <= НачалоДня(ТекущаяДата()) Тогда
									//	ДНПередачи = ДНПередачи + 86400 * 3;	
									//	ДКПередачи = ДКПередачи + 86400 * 5;			
									//КонецЕсли;
									//// КовалевЕС от 04.06.19 }
									
									МинДата = Мин(ПланДата, РеалДата);
									МаксДата = Макс(ПланДата,РеалДата);
									
									ПроверяемаяДНПередачи = ТекущаяДата() + 3 * 86400;
									ПроверяемаяДКПередачи = ТекущаяДата() + 5 * 86400;
									
									Если (МаксДата - МинДата) / 86400 > 15 Тогда
										ДНПередачи = МаксДата - 15 * 86400;
										Если ДНПередачи <= ПроверяемаяДНПередачи Тогда
											ДНПередачи = ПроверяемаяДНПередачи;
											ДКПередачи = ?(МаксДата < ПроверяемаяДКПередачи, ПроверяемаяДКПередачи, МаксДата)
										Иначе
											ДНПередачи = ?(МинДата < ТекущаяДата(), ПроверяемаяДНПередачи, ДНПередачи);
											ДКПередачи = МаксДата
										КонецЕсли
									Иначе
										ДНПередачи = МинДата;
										Если ДНПередачи <= КонецДня(ТекущаяДата()) Тогда
											ДНПередачи = ПроверяемаяДНПередачи;
											ДКПередачи = ?(МаксДата < ПроверяемаяДКПередачи, ПроверяемаяДКПередачи, МаксДата)
										Иначе
											ДНПередачи = МинДата;
											ДКПередачи = МаксДата
										КонецЕсли
									КонецЕсли;
									
									СтруктураВозврата.Вставить("РасчетнаяДатаПередачи",     ДНПередачи);                  
									СтруктураВозврата.Вставить("ДатаНачалаПередачиАвто",    ДНПередачи);  
									СтруктураВозврата.Вставить("ДатаОкончанияПередачиАвто", ДКПередачи);
								КонецЕсли;
								//--DMSREN-95
							КонецЕсли;								
						КонецЦикла;
					КонецЕсли;	
				КонецЕсли;				
			КонецЕсли;
		Исключение
			Сообщить("Не удалось получить значения дат передачи автомобиля!" 
			+ Символы.ПС + "По причине: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;	
	
	Возврат СтруктураВозврата;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьДатыПередачиАвтомобиляБезVIN(ДилерЦентСсылка, МодельСсылка, IDКРабочийЛист);
	
	РДПередачи = Дата(1,1,1);
	ДНПередачи = Дата(1,1,1);
	ДКПередачи = Дата(1,1,1);
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("РасчетнаяДатаПередачи",     РДПередачи);                  
	СтруктураВозврата.Вставить("ДатаНачалаПередачиАвто",    ДНПередачи);  
	СтруктураВозврата.Вставить("ДатаОкончанияПередачиАвто", ДКПередачи); 
		
	Если ЗначениеЗаполнено(ДилерЦентСсылка) И ЗначениеЗаполнено(МодельСсылка) Тогда
		
		КодМоделиП   = СокрЛП(МодельСсылка.Артикул);
		НеделяМесяца = Цел(День(ТекущаяДата()) / 7) + 1;
		
		// Трояновский К.Е. 12.08.2019 10:21:30 {
		//РабочийЛистЗапись = Renault_CRM.ПолучитьЗаписьРЛПоIDK(IDКРабочийЛист);
		РабочийЛистЗапись = Renault_CRM.докПолучитьЗаписьРЛПоIDK(IDКРабочийЛист);		
		// Трояновский К.Е. 12.08.2019 10:21:30 }
		КорпКлиент   = ?(РабочийЛистЗапись.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент, Истина, Ложь); 
		
		СрокДоставкиПередачи = ПолучитьСрокДоставки(Лев(ДилерЦентСсылка.BIR, 8), КодМоделиП); 
		
		// Определяем 15 число текущего месяца или следующего
		Если НеделяМесяца = 1 ИЛИ НеделяМесяца = 2 Тогда
			РДПередачи = Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), 15);                   
		ИначеЕсли НеделяМесяца = 3 ИЛИ НеделяМесяца = 4 Тогда
			РДПередачи = ДобавитьМесяц(Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), 15), 1); 
		КонецЕсли;
		
		// Варианты определения даты начала передачи автомобиля, исходя из кода модели
		Если   (КодМоделиП = "KQ2" ИЛИ КодМоделиП = "MAU" ИЛИ КодМоделиП = "MRO" 
			ИЛИ КодМоделиП = "TWZ" ИЛИ КодМоделиП = "67F" ИЛИ КодМоделиП = "67P") Тогда 
			КолвоДней  =  (62 + 35 + 7 + ?(КорпКлиент, 14, 5) + СрокДоставкиПередачи) * 86400;
			ДНПередачи = РДПередачи + КолвоДней;
			
		ИначеЕсли КодМоделиП = "ZGH" Тогда
			КолвоДней  = (62 + 70 + 7 + ?(КорпКлиент, 14, 5) + СрокДоставкиПередачи) * 86400;
			ДНПередачи = РДПередачи + КолвоДней;
			
		Иначе
			КолвоДней  = (93 + 7  + ?(КорпКлиент, 7 , 5) + СрокДоставкиПередачи) * 86400;
			ДНПередачи = РДПередачи + КолвоДней;
		КонецЕсли;	
		
		ДКПередачи = ДНПередачи + 7 * 86400;
		
		СтруктураВозврата.Вставить("РасчетнаяДатаПередачи",     РДПередачи);                  
		СтруктураВозврата.Вставить("ДатаНачалаПередачиАвто",    ДНПередачи);  
		СтруктураВозврата.Вставить("ДатаОкончанияПередачиАвто", ДКПередачи); 
	КонецЕсли;	
	
	Возврат СтруктураВозврата;
	
КонецФункции 
	
&НаСервере
Функция ПолучитьСрокДоставки(BIR_ID, КодМоделиП)
		
	Если КодМоделиП = "46L" ИЛИ КодМоделиП =  "46B" ТОГДА
		ПараметрПоискаСклад = "TLT";
	ИначеЕсли КодМоделиП = "79H" ИЛИ КодМоделиП = "HAH" ТОГДА
		ПараметрПоискаСклад = "CLE";
	Иначе
		ПараметрПоискаСклад = "PLP";
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	DMS_АдресаРазгрузкиДилеров.СрокДоставки
		|ИЗ
		|	РегистрСведений.DMS_АдресаРазгрузкиДилеров КАК DMS_АдресаРазгрузкиДилеров
		|ГДЕ
		|	DMS_АдресаРазгрузкиДилеров.BIR = &BIR
		|	И DMS_АдресаРазгрузкиДилеров.SKLAD_CODE = &SKLAD_CODE
		|
		|УПОРЯДОЧИТЬ ПО
		|	DMS_АдресаРазгрузкиДилеров.idТочка";
	
	Запрос.УстановитьПараметр("BIR",        BIR_ID);
	Запрос.УстановитьПараметр("SKLAD_CODE", ПараметрПоискаСклад);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.СрокДоставки;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ДатаНачалаПередачиАвтоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ИзменитьДатуНачалаПередачи = Истина;
	
	Если ЗначениеЗаполнено(РасчетнаяДатаПередачи) Тогда
		Если ЗначениеЗаполнено(Автомобиль) И ЗначениеЗаполнено(VIN) Тогда
			Если ВыбранноеЗначение < РасчетнаяДатаПередачи Тогда
				Сообщить("Дата начала передачи автомобиля " + Формат(ДатаНачалаПередачиАвто, "ДЛФ=Д")
				+ ", не может быть меньше расчетной даты " + Формат(РасчетнаяДатаПередачи, "ДЛФ=Д") + "!", СтатусСообщения.Внимание);
				ИзменитьДатуНачалаПередачи = Ложь;
			ИначеЕсли ВыбранноеЗначение = РасчетнаяДатаПередачи	Тогда
				ИзменитьДатуНачалаПередачи = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Если ИзменитьДатуНачалаПередачи Тогда
		ДатаНачалаПередачиАвто = ВыбранноеЗначение;
		ДатаОкончанияПередачиАвто = ДатаНачалаПередачиАвто + 86400 * 7;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПередачиАвтоОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ИзменитьДатуНачалаПередачи = Истина;
	
	ДатаСтрокой = Текст;
	ГодСтрокой   = Прав(ДатаСтрокой,4);
	МесяцСтрокой = Сред(ДатаСтрокой,4,2);
	ДеньСтрокой  = Лев(ДатаСтрокой,2);
	
	ВведенноеЗначение = Дата(ГодСтрокой, МесяцСтрокой, ДеньСтрокой);

	Если ЗначениеЗаполнено(РасчетнаяДатаПередачи) Тогда
		Если ЗначениеЗаполнено(Автомобиль) И ЗначениеЗаполнено(VIN) Тогда
			Если ВведенноеЗначение < РасчетнаяДатаПередачи Тогда
				Сообщить("Дата начала передачи автомобиля " + Формат(ДатаНачалаПередачиАвто, "ДЛФ=Д")
				+ ", не может быть меньше расчетной даты " + Формат(РасчетнаяДатаПередачи, "ДЛФ=Д") + "!", СтатусСообщения.Внимание);
				ИзменитьДатуНачалаПередачи = Ложь;
			ИначеЕсли ВведенноеЗначение = РасчетнаяДатаПередачи Тогда
				ИзменитьДатуНачалаПередачи = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Если ИзменитьДатуНачалаПередачи Тогда
		Если Не ЗначениеЗаполнено(ГодСтрокой + МесяцСтрокой + ДеньСтрокой) Тогда
			ДатаНачалаПередачиАвто = Дата(1,1,1);
		Иначе
			ДатаНачалаПередачиАвто = Дата(ГодСтрокой, МесяцСтрокой, ДеньСтрокой);
		КонецЕсли;
		
		ДатаОкончанияПередачиАвто = ДатаНачалаПередачиАвто + 86400 * 7;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПередачиАвтоПриИзменении(Элемент)

	Если ДатаОкончанияПередачиАвто < ДатаНачалаПередачиАвто Тогда
		Сообщить("Дата окончания передачи автомобиля " + Формат(ДатаОкончанияПередачиАвто, "ДЛФ=Д") 
		+ ", не может быть меньше даты начала передачи " + Формат(ДатаНачалаПередачиАвто, "ДЛФ=Д") + "!", СтатусСообщения.Внимание);
		ДатаОкончанияПередачиАвто = ДатаНачалаПередачиАвто;
	КонецЕсли;
	
КонецПроцедуры  
