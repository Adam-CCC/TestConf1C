&НаСервере
Процедура ЗаполнитьСтрокуТЧЗаявкиНаОборудование(НовСтрока, Данные)
	
	НовСтрока.Выбрана = истина;
	Если ТипЗнч(Данные.Номенклатура) = Тип("Строка") Тогда
		Если ТипЗнч(НовСтрока) = Тип("ДокументТабличнаяЧастьСтрока.CRM_ЗаявкаНаДилерскиеОпции.ДопОпции") Тогда
			НовСтрока.ПсевдоОпция = Данные.Номенклатура;
		Иначе
			НовСтрока.ПсевдоАвторабота = Данные.Номенклатура;
		КонецЕсли;
		НовСтрока.ПсевдоСумма = Данные.Сумма;
		НовСтрока.Сумма = НовСтрока.ПсевдоСумма;
		НовСтрока.ПсевдоКоличество = Данные.Количество;
		НовСтрока.Цена = Данные.Цена;
		Если ЗначениеЗаполнено(НовСтрока.ПсевдоКоличество) Тогда
			НовСтрока.Количество = НовСтрока.ПсевдоКоличество;
		Иначе
			НовСтрока.Количество = 1;
		КонецЕсли;
	Иначе
		Если ТипЗнч(НовСтрока) = Тип("ДокументТабличнаяЧастьСтрока.CRM_ЗаявкаНаДилерскиеОпции.ДопОпции") Тогда
			НовСтрока.ПсевдоОпция = Строка(Данные.Номенклатура);
		Иначе
			НовСтрока.ПсевдоАвторабота = Строка(Данные.Номенклатура);
		КонецЕсли;
		НовСтрока.ПсевдоСумма = Данные.Сумма;
		НовСтрока.ПсевдоКоличество = Данные.Количество;
		Если ТипЗнч(НовСтрока) = Тип("ДокументТабличнаяЧастьСтрока.CRM_ЗаявкаНаДилерскиеОпции.ДопОпции") Тогда
			НовСтрока.Опция = Данные.Номенклатура;
		Иначе
			НовСтрока.Авторабота = Данные.Номенклатура;
		КонецЕсли;
		НовСтрока.Цена = Данные.Цена;
		НовСтрока.Сумма = Данные.Сумма;
		НовСтрока.Количество = Данные.Количество;
	КонецЕсли;
	
