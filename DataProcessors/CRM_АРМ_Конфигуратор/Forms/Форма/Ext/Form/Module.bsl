Функция РассчитатьПлатеж(Ставка, ОбъемКредита, Период)
	
	Если Период <> 0 Тогда
		Если Ставка <> 0 Тогда
			Возврат (Ставка/1200*ОбъемКредита*Pow(1+Ставка/1200, Период)) / (Pow(1+Ставка/1200, Период)-1);
		Иначе
			Возврат ОбъемКредита/Период;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура КредитноеПредложениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Форма = ПолучитьФорму("Справочник.CRM_КредитныеПредложения.ФормаВыбора");
	Форма.Модель = Модель;
	Форма.Комплектация = Версия;
	Форма.ДляПовторногоКлиентаБанка = ЭтоПовторныйКлиентБанка;
	Форма.ДляКлиентаCRM = ЭтоКлиентCRM;
	Ответ = Форма.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		КредитноеПредложение = Ответ;
		КредитноеПредложениеПриИзменении(Элемент);
	КонецЕсли;
	
КонецПроцедуры

