&НаКлиенте
Процедура ОбработатьВвозСтраховой ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_Отделы.Ссылка
	|ИЗ
	|	Справочник.CRM_Отделы КАК CRM_Отделы
	|ГДЕ
	|	CRM_Отделы.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОФУ)
	|	И CRM_Отделы.ДилерскийЦентр = &ДилерскийЦентр
	|	И НЕ CRM_Отделы.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДилерскийЦентр", Renault_CRM.ПолучитьДилерскийЦентрПользователя());
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 1 Тогда
		ОтделОФУ = Результат[0].Ссылка;
	ИначеЕсли Результат.Количество() > 1 Тогда
		СписокВыбора = Новый СписокЗначений;
		СписокВыбора.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Ссылка"));
		ФормаВыбора = ПолучитьФорму("Обработка.CRM_АРМ_Конфигуратор.Форма.ФормаВыбораСписка");
		ФормаВыбора.СписокВыбора = СписокВыбора;
		ОтделОФУ = ФормаВыбора.ОткрытьМодально();
	Иначе
		ОтделОФУ = Справочники.CRM_Отделы.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СохранитьСтраховыеПолисы(ПолисОСАГО = неопределено, ПолисКАСКО = неопределено)
	
	СтруктураВозврата = Новый Структура;
	
	Если НЕ ЗначениеЗаполнено(ПолисОСАГО) тогда
		ПолисОСАГО = Документы.Renault_СтраховойПолис.ПустаяСсылка();
	КонецЕсли;
	
	Если СтраховкаОСАГОВключать Тогда
		
		Если ЗначениеЗаполнено(ПолисОСАГО) тогда
			ПолисОСАГООбъект = ПолисОСАГО.ПолучитьОбъект();
		иначе
			ПолисОСАГООбъект = Документы.Renault_СтраховойПолис.СоздатьДокумент();
		КонецЕсли;
		
		ПолисОСАГООбъект.Дата = ТекущаяДата();
		ПолисОСАГООбъект.ВидСтрахования = Справочники.DMS_ВидыФинансовыхУслуг.ОСАГО;
		ПолисОСАГООбъект.Автомобиль = Автомобиль;
		Если ТипЗнч(ТекущийКлиент) = Тип("СправочникСсылка.Контрагенты") и ЗначениеЗаполнено(ТекущийКлиент) тогда
			ПолисОСАГООбъект.Контрагент = ТекущийКлиент;
			ПолисОСАГООбъект.Плательщик = ТекущийКлиент;
		КонецЕсли;
		ПолисОСАГООбъект.Организация = ДЦ.Организация;
		ПолисОСАГООбъект.Записать();
		
		ПолисОСАГО = ПолисОСАГООбъект.Ссылка;
	КонецЕсли;
	
	СтруктураВозврата.Вставить("ПолисОСАГО", ПолисОСАГО.Ссылка);
	
	Если НЕ ЗначениеЗаполнено(ПолисКАСКО) тогда
		ПолисКАСКО = Документы.Renault_СтраховойПолис.ПустаяСсылка();
	КонецЕсли;
	
	Если СтраховкаКАСКОВключать Тогда
		
		Если ЗначениеЗаполнено(ПолисКАСКО) тогда
			ПолисКАСКООбъект = ПолисКАСКО.ПолучитьОбъект();
		иначе
			ПолисКАСКООбъект = Документы.Renault_СтраховойПолис.СоздатьДокумент();
		КонецЕсли;		
		
		ПолисКАСКООбъект.Дата = ТекущаяДата();
		ПолисКАСКООбъект.ВидСтрахования = Справочники.DMS_ВидыФинансовыхУслуг.КАСКО;
		ПолисКАСКООбъект.Автомобиль = Автомобиль;
		Если ТипЗнч(ТекущийКлиент) = Тип("СправочникСсылка.Контрагенты") и ЗначениеЗаполнено(ТекущийКлиент) тогда
			ПолисКАСКООбъект.Контрагент = ТекущийКлиент;
			ПолисКАСКООбъект.Плательщик = ТекущийКлиент;
		КонецЕсли;
		ПолисКАСКООбъект.Организация = ДЦ.Организация;
		ПолисКАСКООбъект.Записать();
		
		ПолисКАСКО = ПолисКАСКООбъект.Ссылка;
	КонецЕсли;
	
	СтруктураВозврата.Вставить("ПолисКАСКО", ПолисКАСКО.Ссылка);
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура СоздатьКПНажатие(Команда)
	
	Если Не ЗначениеЗаполнено(Версия) ИЛИ Не ЗначениеЗаполнено(Цвет) Тогда
		Предупреждение("Не указана версия или цвет автомобиля");
		Возврат;
	КонецЕсли;
	
	ВозможноСохранить = ПроверитьКредитСтраховку();
	Если НЕ ВозможноСохранить Тогда
		Предупреждение("Неверно подобрана кредитная программа");
		Возврат;
	КонецЕсли;
	
	//v+
	ЗадачиОФУ=ЗадачиОФУ();
	СуществуетКонсультацияОФУ=СоздатьЗадачу_ОФУ_Наличные ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.КонсультацияОФУ)).Количество()>0;
	СуществуетКредит=СоздатьЗадачу_ОФУ_Кредит ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Кредит)).Количество()>0;
	СуществуетЛизинг=СоздатьЗадачу_ОФУ_Лизинг ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Лизинг)).Количество()>0;
	Если НЕ ОтказОтКонсультацииОФУ И НЕ СуществуетКонсультацияОФУ И НЕ СуществуетКредит И НЕ СуществуетЛизинг Тогда
		Если Вопрос("Не выбран способ покупки автомобиля, продожить?",РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Нет Тогда
			Возврат
		КонецЕсли;
	КонецЕсли;
	//v-
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	ТекущаяКонфигурация = ЗаписатьКонфигурацию(Истина);
	
	Если ЗначениеЗаполнено(ТекущаяКонфигурация) Тогда
		
		ТекущееКП = Документы.CRM_КоммерческоеПредложение.ПустаяСсылка();
		
		ТипКП=ТипКП();
		// +++ ВалиховГА 21.10.2021 DMSREN-1364
		//ДобавитьКП(ТекущаяКонфигурация,ТипКП);
		Попытка
			ДобавитьКП(ТекущаяКонфигурация,ТипКП);
		Исключение
			Предупреждение("Не удалось провести коммерческое предложение!", 30);
			
			ЗаписьЖурналаРегистрации("Запись ком. предложения при блокировке", УровеньЖурналаРегистрации.Ошибка, , , 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
		// --- ВалиховГА 21.10.2021 DMSREN-1364
		
		Элементы.СписокКП.Обновить();
		Элементы.СписокКП.ТекущаяСтрока = ТекущееКП;
		
		ОткрытьСтраницуСоставКП();
		
		ОбновитьВидимостьЭлементов();
		ОбновитьЗаголовки();
		
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	ЗагрузитьЗаявкуНаСтраховку();
	ОбновитьОтображениеГруппПоЗаявкам();
	
	//v+ 
	ОтложенноеСозданиеЗадачОФУ();
	//v-
	УправлениеКнопкамиОФУ();
	Оповестить("ОбновитьРабочийЛист",,ВладелецФормы);
	
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

