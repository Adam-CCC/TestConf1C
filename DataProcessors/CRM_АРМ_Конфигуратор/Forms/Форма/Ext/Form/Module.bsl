Процедура ЗаписатьВФайл(Файл)
	
	выборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	выборФайла.ПолноеИмяФайла = Файл["ИмяФайла"];
	Если выборФайла.Выбрать() Тогда
		//ИмяФайла = Файл["ИмяФайла"];
		ДанныеФайла = Base64Значение(Файл["ДанныеФайла"]);	
		ДанныеФайла.записать(выборФайла.ПолноеИмяФайла);
	КонецЕсли;
	
	
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеПоКонтрагенту(Контрагент,Автомобиль,ДатаНачалаПередачиАвто,ВидСогласия)
	
	СтруктураОбъекта = Новый Структура;
	СтруктураКлиента = Новый Структура;
	СтруктураДокумента = Новый Структура;
	СтруктураАвтомобиля = Новый Структура;
	СтруктураСогласия = Новый Структура;
	СтруктураОтвветсвенный = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Серия КАК Серия,
		|	ПодтверждающиеДокументы.Номер КАК Номер,
		|	ПодтверждающиеДокументы.ДатаВыдачи КАК ДатаВыдачи,
		|	ПодтверждающиеДокументы.КемВыдан КАК КемВыдан,
		|	ПодтверждающиеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.Владелец = &Контрагент
		|	И ПодтверждающиеДокументы.Текущий = ИСТИНА";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() = 0 Тогда 
		ВызватьИсключение("Нет данных актуального паспорта");
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		СтруктураДокумента.Вставить("passportnumber",Выборка.Номер);
		СтруктураДокумента.Вставить("passportseries",Выборка.Серия);
		СтруктураДокумента.Вставить("passportissued",Выборка.КемВыдан); 
		СтруктураДокумента.Вставить("passportday",День(Выборка.ДатаВыдачи));
		СтруктураДокумента.Вставить("passportmonth",Месяц(Выборка.ДатаВыдачи));
		СтруктураДокумента.Вставить("passportyear",Год(Выборка.ДатаВыдачи));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление КАК Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	Запрос.УстановитьПараметр("Объект", Контрагент);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Почта = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Почта = ВыборкаДетальныеЗаписи.Представление;
	КонецЦикла;

	Адрес = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление КАК Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Тип = &ТипАдрес
		|	И КонтактнаяИнформация.Вид = &ВидАдрес";
	
	Запрос.УстановитьПараметр("ВидАдрес", Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Запрос.УстановитьПараметр("ТипАдрес", Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Адрес = ВыборкаДетальныеЗаписи.Представление;
	КонецЦикла;

	СтруктураКлиента.Вставить("lastname",Контрагент.Фамилия);
	СтруктураКлиента.Вставить("firstname",Контрагент.Имя);
	СтруктураКлиента.Вставить("middlename",Контрагент.Отчество);
	СтруктураКлиента.Вставить("birthday",Контрагент.ДатаРождения);
	СтруктураКлиента.Вставить("gender",?(Контрагент.Пол=Перечисления.ПолФизическихЛиц.НеУказан,"",""+Контрагент.Пол));
	СтруктураКлиента.Вставить("address",Адрес);
	СтруктураКлиента.Вставить("tel",Контрагент.ОсновнойТелефон);
	СтруктураКлиента.Вставить("email",Почта);
	СтруктураКлиента.Вставить("company",?(Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо,Истина,Ложь));
	СтруктураКлиента.Вставить("document",СтруктураДокумента);
	СтруктураОбъекта.Вставить("client",СтруктураКлиента);
	
	СтруктураАвтомобиля.Вставить("mark",""+Модель);
	СтруктураАвтомобиля.Вставить("vin",VIN);
	СтруктураАвтомобиля.Вставить("daybuycar",Дата('00010101'));
	СтруктураОбъекта.Вставить("auto",СтруктураАвтомобиля);
	
	СтруктураСогласия.Вставить("form",ВидСогласия);
	СтруктураСогласия.Вставить("agree",Истина);
	СтруктураОбъекта.Вставить("consent",СтруктураСогласия);
	
	СтруктураОтвветсвенный.Вставить("name",""+ПараметрыСеанса.Пользователь.Сотрудник);
	СтруктураОтвветсвенный.Вставить("from","Форма конфигуратора из КП");
	СтруктураОбъекта.Вставить("responsible",СтруктураОтвветсвенный);
	
	Возврат СтруктураОбъекта;
	
КонецФункции

&НаСервере
Функция ЗаполнитьДанныеПоПотенциальномуКлиенту(ВидСогласия)
	
	СтруктураОбъекта = Новый Структура;
	СтруктураКлиента = Новый Структура;
	СтруктураДокумента = Новый Структура;
	СтруктураАвтомобиля = Новый Структура;
	СтруктураСогласия = Новый Структура;
	СтруктураОтвветсвенный = Новый Структура;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ТекущийКлиент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Поле4,
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Ссылка
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	МобильныйТелефон = "";
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		МобильныйТелефон = Выборка.Представление;
	КонецЕсли;
	
	ЭлектронныйАдрес = "";
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЭлектронныйАдрес = Выборка.Представление;
	КонецЕсли;
	
	Адрес = "";
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Город = Выборка.Поле4;
		Адрес = Выборка.Представление;
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Серия,
	|	ПодтверждающиеДокументы.Номер,
	|	ПодтверждающиеДокументы.ДатаВыдачи,
	|	ПодтверждающиеДокументы.КемВыдан
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Ссылка
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = &Вид";
	
	Запрос.УстановитьПараметр("Вид", Перечисления.ВидыДокументов.Паспорт);
	Выборка = Запрос.Выполнить().Выбрать();
	ПаспортСерия = "";
	ПаспортНомер = "";
	ПаспортКемВыдан = "";
	ПаспортДатаВыдачи = Дата('00010101');

	Если Выборка.Следующий() Тогда
		ПаспортСерия = Выборка.Серия;
		ПаспортНомер = Выборка.Номер;
		ПаспортДатаВыдачи = Выборка.ДатаВыдачи;
		ПаспортКемВыдан = Выборка.КемВыдан;
	КонецЕсли;

	СтруктураДокумента.Вставить("passportnumber",ПаспортСерия);
	СтруктураДокумента.Вставить("passportseries",ПаспортНомер);
	СтруктураДокумента.Вставить("passportissued",ПаспортКемВыдан); 
	СтруктураДокумента.Вставить("passportday",День(ПаспортДатаВыдачи));
	СтруктураДокумента.Вставить("passportmonth",Месяц(ПаспортДатаВыдачи));
	СтруктураДокумента.Вставить("passportyear",Год(ПаспортДатаВыдачи));

	СтруктураКлиента.Вставить("lastname",ТекущийКлиент.Фамилия);
	СтруктураКлиента.Вставить("firstname",ТекущийКлиент.Имя);
	СтруктураКлиента.Вставить("middlename",ТекущийКлиент.Отчество);
	СтруктураКлиента.Вставить("birthday",ТекущийКлиент.ДатаРождения);
	СтруктураКлиента.Вставить("gender",?(ТекущийКлиент.Пол=Перечисления.ПолФизическихЛиц.НеУказан,"",""+ТекущийКлиент.Пол));
	СтруктураКлиента.Вставить("address",Адрес);
	СтруктураКлиента.Вставить("tel",МобильныйТелефон);
	СтруктураКлиента.Вставить("email",ЭлектронныйАдрес);
	СтруктураКлиента.Вставить("company",?(ТекущийКлиент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо,Истина,Ложь));
	СтруктураКлиента.Вставить("document",СтруктураДокумента);
	СтруктураОбъекта.Вставить("client",СтруктураКлиента);

	СтруктураАвтомобиля.Вставить("mark","");
	СтруктураАвтомобиля.Вставить("vin","");
	СтруктураАвтомобиля.Вставить("daybuycar",Дата('00010101'));
	СтруктураОбъекта.Вставить("auto",СтруктураАвтомобиля);
	
	СтруктураСогласия.Вставить("form",ВидСогласия);
	СтруктураСогласия.Вставить("agree",Истина);
	СтруктураОбъекта.Вставить("consent",СтруктураСогласия);
	
	СтруктураОтвветсвенный.Вставить("name",""+ПараметрыСеанса.Пользователь.Сотрудник);
	СтруктураОтвветсвенный.Вставить("from","Форма конфигуратора из КП");
	СтруктураОбъекта.Вставить("responsible",СтруктураОтвветсвенный);
	
	Возврат СтруктураОбъекта;

	
КонецФункции

