	ПараметрыФормы.Вставить("ПродленнаяГарантия",		ПродленнаяГарантия);
	// Доп. продукты DMSREN-1156
	ПараметрыФормы.Вставить("СервисныеКонтрактыСумма",	СервисныеКонтрактыСумма);
	ПараметрыФормы.Вставить("ПомощьНаДорогахСумма",		ПомощьНаДорогахСумма);

	
	
	// Страховка
	//ПараметрыФормы.Вставить("СтраховкаСумма",			СтраховкаОСАГОСумма);
	//ПараметрыФормы.Вставить("СтраховкаВид",				СтраховкаВид);
