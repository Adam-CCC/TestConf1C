				//Запись = РегистрыСведений.Renault_РабочиеЛисты.СоздатьМенеджерЗаписи();
				//ЗаполнитьЗначенияСвойств(Запись, Выборка);
				//Запись.Прочитать();
				//ТекущийРабочийЛистПрием = Запись.IDK;
				Запись = Выборка.Ссылка.ПолучитьОбъект();
				ТекущийРабочийЛистПрием = Выборка.Ссылка.IDK;
				// Трояновский К.Е. 12.08.2019 10:47:55 }
			Иначе
				Идентификатор = Новый УникальныйИдентификатор();
				// Трояновский К.Е. 12.08.2019 10:46:10 {
				//Запись = Renault_CRM.СоздатьРабочийЛистПоТрафику(Строка(ЗаписьРЛ.IDТрафика));
				Запись = Renault_CRM.докСоздатьРабочийЛистПоТрафику(Строка(ЗаписьРЛ.IDТрафика));
				// Трояновский К.Е. 12.08.2019 10:46:10 }
