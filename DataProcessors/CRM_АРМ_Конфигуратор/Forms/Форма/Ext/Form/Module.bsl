&НаСервере
Функция ЭтоПовторныйКлиентБанка()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаКредит.Статус КАК Статус,
	|	Renault_CRM_ЗаявкаНаКредит.Дата КАК ДатаНачала,
	|	Renault_CRM_ЗаявкаНаКредит.Ссылка
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаКредит КАК Renault_CRM_ЗаявкаНаКредит
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаКредит.Клиент = &Клиент
	|	И Renault_CRM_ЗаявкаНаКредит.РабочийЛист <> &ТекущийРабочийЛист";
	Запрос.УстановитьПараметр("Клиент", ТекущийКлиент);
	Запрос.УстановитьПараметр("ТекущийРабочийЛист", ТекущийРабочийЛист);
	Результат = Запрос.Выполнить();
	
