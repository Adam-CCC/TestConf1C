&НаСервере
Процедура ЗаполнитьКППНаСервере()
	
	КППОтбора.Очистить();
	
	ТипКппОтбор = Справочники.ТипыКПП.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Версия) Тогда
		СписокКомплектаций = Новый СписокЗначений;
		СписокКомплектаций.Добавить(Версия);
	Иначе
		СписокКомплектаций = ТаблицаКомплектации.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВариантыКомплектации.ТипКПП КАК ТипКПП
	|ИЗ
	|	Справочник.ВариантыКомплектации КАК ВариантыКомплектации
	|ГДЕ
	|	ВариантыКомплектации.Ссылка В(&Комплектация)
	|	И ВариантыКомплектации.ТипКПП <> ЗНАЧЕНИЕ(Справочник.ТипыКПП.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипКПП";
	
	Запрос.УстановитьПараметр("Комплектация", СписокКомплектаций);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()>0 Тогда
		КППОтбора.Загрузить(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДвигателиНаСервере()
	
	ДвигательОтбора.Очистить();
	ТипДвигателяОтбор = "";
	
	Если ЗначениеЗаполнено(Версия) Тогда
		СписокКомплектаций = Новый СписокЗначений;
		СписокКомплектаций.Добавить(Версия);
	Иначе
		СписокКомплектаций = ТаблицаКомплектации.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_ДопИнформацияПоВерсиям.ТипТоплива КАК Двигатель
	|ИЗ
	|	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних(
	|			,
	|			Тариф = &Тариф) КАК Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопИнформацияПоВерсиям КАК Renault_ДопИнформацияПоВерсиям
	|		ПО Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации = Renault_ДопИнформацияПоВерсиям.ВариантКомплектации
	|		
	//|	РегистрСведений.Renault_ДопИнформацияПоВерсиям КАК Renault_ДопИнформацияПоВерсиям
	|ГДЕ
	|	Renault_ДопИнформацияПоВерсиям.ВариантКомплектации В(&Комплектация)
	|	И НЕ Renault_ДопИнформацияПоВерсиям.ТипТоплива = """"";
	
	Запрос.УстановитьПараметр("Комплектация", СписокКомплектаций);
	Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДвигательОтбора.Загрузить(Результат);
	
	Если ДвигательОтбора.Количество()=1 Тогда
		Элементы.ГруппаДвигатели.Видимость = Ложь;
	Иначе
		Элементы.ГруппаДвигатели.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Модель1ПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Модель) Тогда
		ПроверитьПервичнуюМодель();
		ЗаполнитьОпцииНаСервере();
		ОбновитьСписокКонфигураций(Модель);
		ЗаполнитьДвигателиНаСервере();
		ЗаполнитьКППНаСервере();
		ОбновитьСписокЦветов(Модель);
		ПодключитьОбработчикОжидания("ОбновитьКартинкуМоделиКлиент", 0.2, Истина);
		ПриИзмененииМоделиАвто();
		
		// ++ Ковалев ЕС от 23.08.2018
		ДанныеПередачиСтруктура = ЗаполнитьДатыПередачиАвтомобиляБезVIN(ДЦ, Модель, ТекущийРабочийЛист);
		РасчетнаяДатаПередачи     = ДанныеПередачиСтруктура.РасчетнаяДатаПередачи;
		ДатаНачалаПередачиАвто	  = ДанныеПередачиСтруктура.ДатаНачалаПередачиАвто;
		ДатаОкончанияПередачиАвто = ДанныеПередачиСтруктура.ДатаОкончанияПередачиАвто;
		// -- Ковалев ЕС от 23.08.2018
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПервичнуюМодель ()
	
	ТекРЛ = Renault_CRM.ПолучитьЗаписьРЛПоIDK(ТекущийРабочийЛист);
	Если ТекРЛ <> Неопределено И Модель = ТекРЛ.МодельАвтомобиля Тогда
		ОтборПоЦветам = Истина;
		ТекНаборЦветов = ТекРЛ.Цвет;
	иначе
		ОтборПоЦветам = Ложь;
		ТекНаборЦветов = Справочники.Renault_НаборЦветов.ПустаяСсылка();
	КонецЕсли;
	Если ОтборПоЦветам Тогда 
		Элементы.ТекНаборЦветов.ТолькоПросмотр = Ложь;
	Иначе 
		Элементы.ТекНаборЦветов.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецПроцедуры

