					//ФормаАвто = ПолучитьФорму("РегистрСведений.Renault_РабочиеЛисты.Форма.АвтомобильTradeIN", , ЭтаФорма, ЭтаФорма.КлючУникальности);
					ФормаАвто = ПолучитьФорму("Документ.Renault_РабочийЛист.Форма.АвтомобильTradeIN", , ЭтаФорма, ЭтаФорма.КлючУникальности);
					// Трояновский К.Е. 12.08.2019 10:48:56 }
					ФормаАвто.ПоложениеОкна = ВариантПоложенияОкна.Центрировать;
					ФормаАвто.ДилерскийЦентр = ДилерскийЦентр;
					ФормаАвто.СессияТрейдИн = СессияТрейдИн;
					ФормаАвто.IDK = ТекущийРабочийЛистПрием;
					ФормаАвто.Исполнитель = СотрудникВыбор;
					Ответ = ФормаАвто.ОткрытьМодально();
					Если Ответ <> Неопределено Тогда
						ЗаявкаНаТрейдИн = Ответ;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		Иначе 
			ИнтересовалсяТрейдИн = Ложь;
			Возврат;
		КонецЕсли;
		
	Иначе 
		Если НЕ ЗаявкаНаТрейдИн.Пустая() И Вопрос("Пометить на удаление заявку на трейд-ин?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда	
			ЗаявкаНаТрейдИнОбъект = ЗаявкаНаТрейдИн.ПолучитьОбъект();
			ЗаявкаНаТрейдИнОбъект.УстановитьПометкуУдаления(Истина);
			ИнтересовалсяТрейдИн = Ложь;
			ЦенаВыкупа = 0;
		Иначе
			ИнтересовалсяТрейдИн = Истина;	
		КонецЕсли;	
	КонецЕсли;
	
	Элементы.ИнтересовалсяУтилизацией.Доступность = НЕ ИнтересовалсяТрейдИн;	
	
	ОбновитьОтображениеГруппПоЗаявкам(); //ИнтересовалсяТрейдИн 
	
	Если НЕ ЭтоКорпКлиент Тогда
		//РассчитатьСкидкиПоАвтомобилю();
		ПересчитатьСтоимость();
		СуммаСкидки = СписокСкидок.Итог("СуммаСкидки");
	КонецЕсли;
	
	ПересчитатьСтоимость();
	
	ПересчитатьЦенуАвто();
	ОбновитьНадписьЦена();
	
КонецПроцедуры

