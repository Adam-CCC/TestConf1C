&НаКлиенте
Процедура КонфигурацияПерезаписать(Команда=неопределено)
	
	Если Не ЗначениеЗаполнено(Версия) ИЛИ Не ЗначениеЗаполнено(Цвет) Тогда
		Предупреждение("Не указана версия или цвет автомобиля");
		Возврат;
	КонецЕсли;
	
	Если ИнтересовалсяСтраховкой Тогда
		Если Не ЗначениеЗаполнено(Возраст) Тогда
			Предупреждение("Не заполнен возраст водителя");
			Возврат;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтажВождения) Тогда
			Предупреждение("Не заполнен стаж вождения");
			Возврат;
		КонецЕсли;
		ОбработатьВвозСтраховой();
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	ЗаявкаНаКредит = СоздатьНайтиЗаявкуНаКредит();
	ЗаявкаНаСтраховку = СоздатьНайтиЗаявкуНаСтраховку();
	ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
	
	ТекущаяКонфигурация = ЗаписатьКонфигурацию(Истина);
	
	//v+
	ЗадачиОФУ=ЗадачиОФУ();
	СуществуетКонсультацияОФУ=СоздатьЗадачу_ОФУ_Наличные ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.КонсультацияОФУ)).Количество()>0;
	СуществуетКредит=СоздатьЗадачу_ОФУ_Кредит ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Кредит)).Количество()>0;
	СуществуетЛизинг=СоздатьЗадачу_ОФУ_Лизинг ИЛИ ЗадачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Лизинг)).Количество()>0;
	Если НЕ СуществуетКонсультацияОФУ И НЕ СуществуетКредит И НЕ СуществуетЛизинг Тогда
		Если Вопрос("Не выбран способ покупки автомобиля, продожить?",РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Нет Тогда
			Возврат
		КонецЕсли;	
	КонецЕсли;	
	ОтложенноеСозданиеЗадачОФУ();
	Перезаписать(ТекущаяКонфигурация,ТипКП());
	//v-
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
	Оповестить("ОбновитьРабочийЛист",,ВладелецФормы);
	ОбновитьОтображениеГруппПоЗаявкам();
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура Перезаписать(Конфигурация,ТипКП)
	
	Если НЕ ЗначениеЗаполнено(ТекущееКП) Тогда
		
		ОбКП = Документы.CRM_КоммерческоеПредложение.СоздатьДокумент();
		ОбКП.Дата			= ТекущаяДата();
		ОбКП.Автор			= ПараметрыСеанса.Пользователь;
		ОбКП.СрокДействия	= СрокДействия;
		ОбКП.ДатаНачалаПередачиАвто    = ДатаНачалаПередачиАвто;
		ОбКП.ДатаОкончанияПередачиАвто = ДатаОкончанияПередачиАвто;
		//ОбКП.СрокПоставки	= ТекущаяДата() + 86400 * Константы.CRM_СрокПоставки.Получить();
		ОбКП.Клиент			= ТекущийКлиент;
		ОбКП.РабочийЛист	= ТекущийРабочийЛист;
		ОбКП.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		ОбКП.ЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн;
		обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
		ОбКП.ЗаявкаНаКредит = СоздатьНайтиЗаявкуНаКредит();
		ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
		СоздатьНайтиЗаявкуНаОборудование(ОбКП);
		обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
		обКП.ИнтересовалсяОБорудованием = ИнтересовалсяОборудованием;
		Обкп.ИнтересовалсяСтраховкой = ИнтересовалсяСтраховкой;
		ОбКП.ЗаявкаНаСтраховку = СоздатьНайтиЗаявкуНаСтраховку();
		Обкп.ИнтересовалсяСтраховкой = ИнтересовалсяСтраховкой;
		ОбКП.ТипКП=ТипКП;
		ОбКП.Renaut_ЦенаРОП = ?(УстановитьРасчетнуюПоЦенеРоп И ЦенаРОП <> 0, ЦенаРОП, 0);
		ОбКП.ИнтересовалсяУтилизацией = ИнтересовалсяУтилизацией;
		ОбКП.ВариантСалона = ТекущийВариантСалона;
		ОбКП.ЦветСалона = ТекущийЦветСалона;
		ОбКП.Записать();
		
		ТекущееКП = ОбКП.Ссылка;
		
	Иначе
		
		ОбКП = ТекущееКП.ПолучитьОбъект();
		ОбКП.ТипКП=ТипКП;
		ОбКП.СрокДействия	= СрокДействия;
		ОбКП.ДатаНачалаПередачиАвто    = ДатаНачалаПередачиАвто;
		ОбКП.ДатаОкончанияПередачиАвто = ДатаОкончанияПередачиАвто;
		ОбКП.ЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн;
		обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
		ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
		СоздатьНайтиЗаявкуНаОборудование(ОбКП);
		обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
		ОбКП.ИнтересовалсяОборудованием = ИнтересовалсяОборудованием;
		Обкп.ИнтересовалсяСтраховкой = ИнтересовалсяСтраховкой;
		ОбКП.ИнтересовалсяУтилизацией = ИнтересовалсяУтилизацией;
		ОбКП.Renaut_ЦенаРОП = ?(УстановитьРасчетнуюПоЦенеРоп И ЦенаРОП <> 0, ЦенаРОП, 0);
		ОбКП.ВариантСалона = ТекущийВариантСалона;
		ОбКП.ЦветСалона = ТекущийЦветСалона;
		
		ОбКП.Записать();
		
	КонецЕсли;
	
	СтрКонф = ОбКП.Состав[0];
	СтрКонф.Конфигурация = Конфигурация;
	СтрКонф.Сумма = ЦенаИТОГО;
	СтрКонф.СуммаДоставки = СуммаДоставки;
	СтрКонф.СуммаСкидки = СуммаСкидки;
	
	НомерКП = ОбКП.Номер;
	ДатаКП = ОбКП.Дата;
	
	// КовалевЕС от 30.05.19 {
	ОбКП.ВычетПоТрейдИн = ТрейдИнСумма;
	// КовалевЕС от 30.05.19 } 
	
	ОбКП.Сумма = ОбКП.Состав.Итог("Сумма");
	ОбКП.ЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн;
	ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
	обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
	обКП.ИнтересовалсяОборудованием = ИнтересовалсяОборудованием;
	Обкп.ИнтересовалсяСтраховкой = ИнтересовалсяСтраховкой;
	ТабСкидкиОбКП = ОбКП.СкидкиКонфигурации;	
	
	УИДКонфигурации = Строка(Конфигурация.УникальныйИдентификатор());
	Отбор = Новый Структура("ИдентификаторКонфигурации", УИДКонфигурации);
	НайденныеСтрокиСкидок = ТабСкидкиОбКП.НайтиСтроки(Отбор);
	
	Для Каждого Эл Из НайденныеСтрокиСкидок Цикл
		ТабСкидкиОбКП.Удалить(Эл);	
	КонецЦикла;
	
	СкидкаRenault = Справочники.ТипыСкидок.НайтиПоКоду("RenltCA");
	
	мСкидки = ТабСкидкиОбКП.НайтиСтроки(Новый Структура("ТипСкидки", СкидкаRenault));
		Для Каждого СтрУдаления из мСкидки Цикл
			ТабСкидкиОбКП.Удалить(СтрУдаления);
		КонецЦикла; 
	
	Для Каждого Эл Из СписокСкидок Цикл
		Стр = ТабСкидкиОбКП.Добавить();
		Стр.ИдентификаторКонфигурации = УИДКонфигурации;
		Стр.ТипСкидки = СкидкаRenault;
		ЗаполнитьЗначенияСвойств(Стр, Эл);
	КонецЦикла;
	
	Если ИнтересовалсяСтраховкой Тогда
		
		СтруктураПолисы = СохранитьСтраховыеПолисы(ОбКП.ПолисОСАГО, ОбКП.ПолисКАСКО);
		ОбКП.ПолисОСАГО = СтруктураПолисы.ПолисОСАГО;
		ОбКП.ПолисКАСКО = СтруктураПолисы.ПолисКАСКО;
		ОбКП.Возраст = Возраст;
		ОбКП.СтажВождения = СтажВождения;
		
	КонецЕсли;
	
	ОбКП.Записать(РежимЗаписиДокумента.Проведение);
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

