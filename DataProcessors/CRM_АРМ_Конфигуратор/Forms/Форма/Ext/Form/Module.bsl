&НаКлиенте
Процедура ПроверитьОкраскуМеталлик()
	
	Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
		
		Если Элементы.ТаблицаЦвета.ТекущиеДанные<>Неопределено Тогда
			Артикул = Элементы.ТаблицаЦвета.ТекущиеДанные.Код;
			
			Для Каждого Стр Из ВыбранныеНебазовыеОпции Цикл
				Стр.Выбран = (Стр.КодОпции = Артикул);
			КонецЦикла;
			
			ПересчитатьЦенуАвто();
		КонецЕсли;
	Иначе
		Если Элементы.ТаблицаЦвета.ТекущиеДанные<>Неопределено Тогда
			Металлик = Элементы.ТаблицаЦвета.ТекущиеДанные.Металлик;
			
			Для Каждого Стр Из ВыбранныеНебазовыеОпции Цикл
				Если Найти(Стр.Опция.Наименование, "металлик")>0 или Найти(Стр.Опция.Наименование, "Металлик")>0 Тогда
					Стр.Выбран = Металлик;
				КонецЕсли;
			КонецЦикла;
			
			ПересчитатьЦенуАвто();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

