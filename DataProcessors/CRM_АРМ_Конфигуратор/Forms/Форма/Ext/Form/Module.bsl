&НаКлиенте
Процедура ИнтересовалсяТрейдИнПриИзменении(Элемент)
	
	ЭтаФорма.Модифицированность = Истина;
	
	Если ИнтересовалсяТрейдИн Тогда
		Если НЕ ЗначениеЗаполнено(ТекущийКлиент) Тогда
			Сообщить("Не выбран клиент");
			Возврат;
		КонецЕсли;	
		//создание рабочего листа на прием
		Если Вопрос("Хотите создать заявку на трейд-ин?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда	
			ДилерскийЦентр = ТекДилерскийЦентр;
			Клиент = ТекущийКлиент;
			IDK = ТекущийРабочийЛист;
			ТипТрафика = 	Справочники.CRM_ТипТрафика.ПосещениеАвтосалона;
			Клиент_ФИО = Клиент.НаименованиеПолное;
			
			
			СессияТрейдИн = Renault_РаботаСРабочимиЛистамиПовтИсп.СессияДляТрейдИн();
			
			// Трояновский К.Е. 12.08.2019 10:35:28 {
			//ЗаписьРЛ = Renault_CRM.ПолучитьЗаписьРЛПоIDK(ТекущийРабочийЛист);
			РЛСсылка = Renault_CRM.докПолучитьЗаписьРЛПоIDK(ТекущийРабочийЛист);
			ЗаписьРЛ = РЛСсылка.ПолучитьОбъект();
			// Трояновский К.Е. 12.08.2019 10:35:28 }
			Сотрудник = ЗаписьРЛ.Сотрудник;
			ТекСотрудник = ЗаписьРЛ.Сотрудник;
			Отдел = ЗаписьРЛ.Отдел;
			ТекОтдел = ЗаписьРЛ.Отдел;
			ПервичныйИнтересМодель = ЗаписьРЛ.ПервичныйИнтересМодель;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	CRM_Отделы.Ссылка
			|ИЗ
			|	Справочник.CRM_Отделы КАК CRM_Отделы
			|ГДЕ
			|	CRM_Отделы.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделТрейдИн)
			|	И CRM_Отделы.ДилерскийЦентр = &ДилерскийЦентр
			|	И НЕ CRM_Отделы.ПометкаУдаления";
			Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
			Результат = Запрос.Выполнить();
			
			ОтделТрейдИн = Справочники.CRM_Отделы.ПустаяСсылка();
			
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();		
				Выборка.Следующий();
				
				ОтделТрейдИн = Выборка.Ссылка;				
			КонецЕсли;
			
			Список = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(ОтделТрейдИн);
			Список.Добавить(?(ЗначениеЗаполнено(ОтделТрейдИн), ОтделТрейдИн, Отдел));
			
			ФормаСписка = Обработки.Renault_ARM_Администратор.ПолучитьФорму("ФормаВыбораИзСпискаПлиткой");
			ФормаСписка.Список = Список;
			ФормаСписка.Заголовок = "Выбор менеджера или отдела";
			
			ФормаСписка.ЭтоВыборСотрудника = Истина;
			ФормаСписка.КнопокВСтроке = 2;
			ФормаСписка.ВысотаКнопки = 40;
			Ответ = ФормаСписка.ОткрытьМодально();
			Если ЗначениеЗаполнено(Ответ) Тогда
				СотрудникВыбор = Ответ;
			Иначе
				Сообщить("Необходимо выбрать менеджера или отдел.");
				ИнтересовалсяТрейдИн = Ложь;
				Возврат;
			КонецЕсли;
			
