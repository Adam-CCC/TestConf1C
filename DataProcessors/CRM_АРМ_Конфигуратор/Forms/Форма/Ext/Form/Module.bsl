Процедура СтраховкаКАСКОПрограммаПриИзменении(Элемент)
	
	ИзменитьПрограммуКАСКО();
	ОбновитьНадписьСубсидии();
	Если ИспользуетсяРазумноеКАСКО = Истина Тогда
		Элементы.СуммаКАСКО.Доступность = Ложь;
	Иначе
		Элементы.СуммаКАСКО.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПрограммуКАСКО()
	
	Если СтраховкаКАСКОПрограмма.Владелец = Справочники.CRM_СтраховыеКомпании.НайтиПоКоду("000000001") Тогда
		Если КредитноеПредложение.ПоддерживаетРазумноеКАСКО Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	CRM_КредитныеТарифы.fix_cost,
			|	CRM_КредитныеТарифы.dkp_prcnt_cost,
			|	CRM_КредитныеТарифы.credit_prcnt_cost,
			|	CRM_КредитныеТарифы.fix_grant,
			|	CRM_КредитныеТарифы.dkp_p_grant,
			|	CRM_КредитныеТарифы.credit_sumt_p_grant,
			|	CRM_КредитныеТарифы.mrkt_rate_p_grant
			|ИЗ
			|	РегистрСведений.CRM_КредитныеТарифы КАК CRM_КредитныеТарифы
			|ГДЕ
			|	CRM_КредитныеТарифы.Сервис = &Сервис
			|	И CRM_КредитныеТарифы.Модель = &Модель";
			Запрос.УстановитьПараметр("Сервис", СтраховкаКАСКОПрограмма.КредитныйСервис);
			Запрос.УстановитьПараметр("Модель", Модель);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Коэффициент = Выборка.dkp_prcnt_cost;
				СтраховкаКАСКОСумма = (Коэффициент * СтраховкаКАСКОПрограмма.СрокСтрахования / 100) * (ЦенаВариантаКомплектации + СуммаДоставки + ЦенаДопОпций + СуммаДопОпцийСумма - ГарантияВычет);
			КонецЕсли;
			//СтраховкаКАСКОСумма = (3.5 * СтраховкаКАСКОПрограмма.СрокСтрахования / 100) * (ЦенаВариантаКомплектации + СуммаДоставки + ЦенаДопОпций + СуммаДопОпцийСумма - ГарантияВычет);
			ИспользуетсяРазумноеКАСКО = Истина;
			
		Иначе
			//	СтраховкаКАСКОСумма = 0;
		КонецЕсли;
	Иначе
		СтраховкаКАСКОСумма = 0;
		ИспользуетсяРазумноеКАСКО = Ложь;
	КонецЕсли;
	ПересчитатьКредит();
	
КонецПроцедуры


&НаКлиенте
Процедура ДопОборудованиеВКредитПриИзменении(Элемент)
	
	СуммаДопОпцийСумма = ?(ДопОборудованиеВКредит, ВыбранноеОборудование.Итог("Сумма"), 0);
	СуммаДопОпцийПроцент = (СуммаДопОпцийСумма / (ЦенаИтого - ГарантияВычет)) * 100;
	ПересчитатьКредит();
	
КонецПроцедуры


