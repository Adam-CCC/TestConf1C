	Запрос.УстановитьПараметр("НеОтбиратьПоТопливу",?(ЗначениеЗаполнено(ТипДвигателяОтбор),Ложь,Истина));
	Запрос.УстановитьПараметр("ТипТоплива", ТипДвигателяОтбор);
	
	//Запрос.УстановитьПараметр("НеОтбиратьПоКПП",?(ЗначениеЗаполнено(ТипКппОтбор),Ложь,Истина));
	//Запрос.УстановитьПараметр("ТипКппОтбор",ТипКппОтбор);
	
	//
	МассивТипКппОтбор = Новый Массив;
	Для Каждого Стр Из КППОтбора Цикл		
		Если Стр.Выбрана Тогда
			МассивТипКппОтбор.Добавить(Стр.ТипКПП);
		КонецЕсли;		
	КонецЦикла;	
	Запрос.УстановитьПараметр("ТипКппОтбор",МассивТипКппОтбор);
	Запрос.УстановитьПараметр("НеОтбиратьПоКПП",?(МассивТипКппОтбор.Количество()>0,Ложь,Истина));
	//
	
	Запрос.УстановитьПараметр("НеОтбиратьПООпциям",?(СписокОпцийОтбора.Количество()=0,Истина,Ложь));
	Запрос.УстановитьПараметр("КоличествоОпций",СписокОпцийОтбора.Количество());
	Запрос.УстановитьПараметр("СписокОпцийОтбора",СписокОпцийОтбора);
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
	Запрос.УстановитьПараметр("ПустаяСтрока", Справочники.ВариантыКомплектации.ПустаяСсылка());
	Запрос.УстановитьПараметр("СкрыватьНедоступныеКЗаказу", Не ЗначениеЗаполнено(Автомобиль) ИЛИ ТолькоДоступныеКЗаказуВерсии);
	Запрос.УстановитьПараметр("ТолькоДоступныеКЗаказуВерсии",ТолькоДоступныеКЗаказуВерсии);
	
	ДЦ =Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	Запрос.УстановитьПараметр("СкладыДилера", ДЦ.СкладыДилера.ВыгрузитьКолонку("Склад"));
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Таблица.Очистить();
	Иначе
	КонецЕсли;
	
	ТаблицаКомплектации.Загрузить(Таблица);
	
КонецПроцедуры

