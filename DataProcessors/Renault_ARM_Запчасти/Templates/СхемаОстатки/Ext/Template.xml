				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиТоваровКомпанииОстатки.СкладКомпании КАК Склад,
	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток КАК Остаток,
	ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК Резерв,
	ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение,
	ЕСТЬNULL(ДополнительныеРеквизитыНоменклатурыСрезПоследних.ЗначениеРеквизита, 0) КАК МинОстаток
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&amp;ТекущаяДата, Номенклатура = &amp;Номенклатура) КАК ОстаткиТоваровКомпанииОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеРеквизитыНоменклатуры.СрезПоследних КАК ДополнительныеРеквизитыНоменклатурыСрезПоследних
		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = ДополнительныеРеквизитыНоменклатурыСрезПоследних.Номенклатура
			И ОстаткиТоваровКомпанииОстатки.СкладКомпании.Подразделение = ДополнительныеРеквизитыНоменклатурыСрезПоследних.ПодразделениеКомпании
			И (ДополнительныеРеквизитыНоменклатурыСрезПоследних.ДополнительныйРеквизит = ЗНАЧЕНИЕ(Перечисление.ДополнительныеРеквизитыНоменклатуры.МинимальныйОстаток))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказыПоставщикамОстатки.ЗаказаноОстаток,
	ЗаказыПоставщикамОстатки.ЗаказПоставщику.ПодразделениеКомпании
ПОМЕСТИТЬ ВТ_Заказы
ИЗ
	РегистрНакопления.ЗаказыПоставщикам.Остатки(, Номенклатура = &amp;Номенклатура) КАК ЗаказыПоставщикамОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Остатки.Склад,
	ВТ_Остатки.Остаток,
	ВТ_Остатки.Резерв КАК Резерв,
	ВТ_Заказы.ЗаказаноОстаток КАК Заказано,
	ВТ_Остатки.СкладКомпанииПодразделение КАК СкладПодразделение,
	ВТ_Остатки.МинОстаток
ИЗ
	ВТ_Остатки КАК ВТ_Остатки
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
		ПО ВТ_Остатки.СкладКомпанииПодразделение = ВТ_Заказы.ЗаказПоставщикуПодразделениеКомпании</query>
