	//Стр.СуммаPCL        = Стр.Количество * Стр.PCL;
	//Стр.СуммаPNC        = Стр.Количество * Стр.PNC;
	//Стр.СуммаPNCСрочная = Стр.Количество * Стр.PNCСрочная;

	// [ВОРОБЬЕВ]] 06.02.2017 17:42:10 +++
	 
