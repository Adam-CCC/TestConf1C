&НаКлиенте
Процедура ТаблицаРеферансовПередНачаломИзменения(Элемент, Отказ)
	Если Элемент.ТекущийЭлемент.Имя = "ТаблицаРеферансовКолНовое" или 
			Элемент.ТекущийЭлемент.Имя = "ТаблицаРеферансовКомментарийНовый" Тогда 
		ТекущаяСтрока = Элемент.ТекущиеДанные;
		Если ТекущаяСтрока.Отправлено Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Модифицированность Тогда
		Ответ = Вопрос("Изменения сохранены не будут. Продолжить закрытие?", РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.да Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПовторныйЗапрос(Команда)
	ПовторныйЗапросНаСервере ();
КонецПроцедуры

Процедура ПовторныйЗапросНаСервере ()
	
	ТаблицаРеферансов.Очистить();
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Номенклатура КАК Реферанс,
		|	ЗаказПоставщикуТовары.Количество КАК КолСтарое,
		|	Renault_ИсторияИзмененияЗаказПоставщику.Количество КАК КоличествоНовое,
		|	Renault_ИсторияИзмененияЗаказПоставщику.Состояние КАК Состояние,
		|	Renault_ИсторияИзмененияЗаказПоставщику.Коментарий КАК КомментарийСтарый
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ИсторияИзмененияЗаказПоставщику КАК Renault_ИсторияИзмененияЗаказПоставщику
		|		ПО ЗаказПоставщикуТовары.Ссылка = Renault_ИсторияИзмененияЗаказПоставщику.ЗаказПоставщику
		|			И ЗаказПоставщикуТовары.Номенклатура = Renault_ИсторияИзмененияЗаказПоставщику.Реферанс
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ЗаказПоставщику);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
			Если Выборка.КоличествоНовое <> Null Тогда
				Если Выборка.Состояние = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли; 
			СтрокаТЧ = ТаблицаРеферансов.Добавить();
			СтрокаТЧ.КолНовое = Выборка.КолСтарое;
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
		КонецЦикла;

КонецПроцедуры




