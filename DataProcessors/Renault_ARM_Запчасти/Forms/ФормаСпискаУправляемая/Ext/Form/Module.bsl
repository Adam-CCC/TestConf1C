&НаСервере 
Процедура ВвестиЗаказНаСервере (Основание,ДокОбъект)
	
	Если ЗначениеЗаполнено(Основание.ЗаказПокупателя) Тогда 
		ДокОбъект = Основание.ЗаказПокупателя.ПолучитьОбъект();
		Возврат;
	КонецЕсли;
	
	ДокОбъект.ОбработкаРасчетСкидок = Обработки.РасчетСкидок.Создать();
	
	ДокОбъект.ХозОперация = Справочники.ХозОперации.ЗаказРезервированиеПокупателя;
	
	Настройка = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза;
	
	ДокОбъект.Контрагент                = Основание.Клиент.Контрагент;
	ДокОбъект.ДоговорВзаиморасчетов     = Основание.Клиент.ОсновнойДоговор;
	ДокОбъект.Организация               = Основание.ДилерскийЦентр.Организация;
	
	Если Основание.ДилерскийЦентр.ПодразделенияОрганизации.Количество() Тогда
		ДокОбъект.ПодразделениеКомпании = Основание.ДилерскийЦентр.ПодразделенияОрганизации[0].Подразделение;
	Иначе
		ДокОбъект.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
	КонецЕсли;
	
	ДокОбъект.ТипЦен                    = Настройка.ОптоваяЦена;
	ДокОбъект.СкладКомпании             = Настройка.ОсновнойСкладРеализации;
	ДокОбъект.ПроцентПредоплаты         = 0;
	
	Для Каждого СтрокаТЧЗаявки из Основание.Запчасти Цикл
		
		СтрокаТЧЗаказ = ДокОбъект.Товары.Добавить();
		
        СтрокаТЧЗаказ.Номенклатура        = СтрокаТЧЗаявки.Номенклатура;
        ДокОбъект.ОбработкаРеквизита("Товары.Номенклатура", СтрокаТЧЗаказ);
		
		СтрокаТЧЗаказ.Цена                = СтрокаТЧЗаявки.Цена;
        СтрокаТЧЗаказ.Количество          = СтрокаТЧЗаявки.Количество;
		ДокОбъект.ОбработкаРеквизита("Товары.Количество", СтрокаТЧЗаказ);
		
		СкидкаПромо = СтрокаТЧЗаявки.Промо.Значение;
		Если СтрокаТЧЗаявки.Скидка = "-" Тогда
			СкидкаБарем = СтрокаТЧЗаявки.Коэффициент;
		Иначе
			СкидкаБарем = -1 * СтрокаТЧЗаявки.Коэффициент;
		КонецЕсли;
		ОбщаяСкидка = СкидкаБарем + ((100 - СкидкаБарем) * СкидкаПромо / 100);
		СтрокаТЧЗаказ.СкидкаНаТовар       = Renault_ЗапчастиСкидки.Reanult_НайтиСоздатьТиповуюСкидку();
		СтрокаТЧЗаказ.ПроцентСкидкиСтроки = ОбщаяСкидка;
		
		ДокОбъект.ОбработкаРеквизита("Товары.ПроцентСкидкиСтроки", СтрокаТЧЗаказ);
		ДокОбъект.ОбработкаРеквизита("Товары.СуммаСкидкиСтроки",   СтрокаТЧЗаказ);
        ДокОбъект.ОбработкаРеквизита("Товары.СтавкаНДС",           СтрокаТЧЗаказ);
		
	КонецЦикла;
	
	ДокОбъект.Записать();
	
	ЗаявкаОбъект = Основание.ПолучитьОбъект();
	ЗаявкаОбъект.ЗаказПокупателя = ДокОбъект.Ссылка;
	ЗаявкаОбъект.Записать();
	
КонецПроцедуры

&НаСервере 
