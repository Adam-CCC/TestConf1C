// ОБРАБОТЧИКИ ТАБЛИЦЫ РПартсЗаявки

&НаКлиенте
Процедура РПартсВвестиЗаказ(Команда)

	ТекСтрока = Элементы.ЗаявкиРПартс.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда

		Если РегистрыСведений.Renault_Промоакции.ЕстьПромоакции(
			ТекСтрока.Ссылка.Дата,
			ТекСтрока.Ссылка.Запчасти.ВыгрузитьКолонку("Номенклатура")) Тогда
			Если Вопрос("Для заказа есть активные промоакции, они корректно проставлены? Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекСтрока.Ссылка.ДилерскийЦентр) Тогда
			Предупреждение("Не заполенен дилерский центр");
			ФормаДЦ = ПолучитьФорму("Справочник.CRM_ДилерскиеЦентры.ФормаВыбора");
			ДЦСсылка = ФормаДЦ.Открытьмодально();
			Если ЗначениеЗаполнено(ДЦСсылка) Тогда
				УстаноыитьДЦВЗаявке(ДЦСсылка, ТекСтрока.Ссылка);
			Иначе
				Возврат;
			КонецЕсли;
		КонецЕсли;
		ФормаНовогоДокумента = ПолучитьФорму("Документ.ЗаказПокупателя.ФормаОбъекта");
		ВвестиЗаказНаСервере(ТекСтрока.Ссылка, ФормаНовогоДокумента.ДокументОбъект);
		ФормаНовогоДокумента.Открыть();

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РПартсВвестиЗамену(Команда)
	
	ТекСтрока = Элементы.ЗаявкиРПартс.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		
		Если Не ЗначениеЗаполнено(ТекСтрока.ЗаказПокупателя) Тогда
			Предупреждение("На основании заявки не введен заказ покупателя");
			Возврат;
		КонецЕсли;
		
		Замена = ВвестиЗаменуНаСервере(ТекСтрока.ЗаказПокупателя);
		ФормаНовогоДокумента = ПолучитьФорму(
			"Документ.ЗаменаВЗаказеПокупателя.ФормаОбъекта",
				Новый Структура("Ключ", Замена));
		ФормаНовогоДокумента.Открыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РПартсВвестиРеализацию(Команда)
	
	ТекСтрока = Элементы.ЗаявкиРПартс.ТекущиеДанные;

	Если ТекСтрока <> Неопределено Тогда

		Если Не ЗначениеЗаполнено(ТекСтрока.ЗаказПокупателя) Тогда
			Предупреждение("На основании заявки не введен заказ покупателя");
			Возврат;
		КонецЕсли;
		
		Реализация = ВвестиРеализациюНаСервере(ТекСтрока.ЗаказПокупателя);
		ФормаНовогоДокумента = ПолучитьФорму(
			"Документ.РеализацияТоваров.ФормаОбъекта",
				Новый Структура("Ключ", Реализация));
		ФормаНовогоДокумента.Открыть();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РПартсЗакрытьЗаявку(Команда)
	// Вставить содержимое обработчика.
