&НаКлиенте
Процедура СоздатьДокумент(Команда)
	Перем ТипЗаявки;
	Отказ = Истина;

	Если ВвестиЗначение(ТипЗаявки, "Выберите тип поставки",Новый ОписаниеТипов("СправочникСсылка.ТипыЗаказов")) Тогда
		ФормаДокумента = ПолучитьФорму("ОбщаяФорма.Renault_ФормаДокументаЗаказПоставшику");
		ФормаДокумента.Контрагент = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.ОсновнойПоставщик;
		ФормаДокумента.УчитыватьКратность = Истина;
		ФормаДокумента.ЭлементыФормы.Контрагент.ТолькоПросмотр = Истина;
		ФормаДокумента.ТипЗаказа = ТипЗаявки;
		ФормаДокумента.СрокПоставки = НачалоДня(ТекущаяДата())+ 86400;
		ФормаДокумента.ЭлементыФормы.ТипЗаказа.ТолькоПросмотр = Истина;
		ФормаДокумента.ЭлементыФормы.КоманднаяПанельТовары.Кнопки.Renault.Доступность = Истина;
		Если ТипЗаявки = Справочники.ТипыЗаказов.ZMP2Гарантийный или 
				ТипЗаявки = Справочники.ТипыЗаказов.ZMP2Срочный или 
					ТипЗаявки = Справочники.ТипыЗаказов.ZMP1PVI или 
						ТипЗаявки = Справочники.ТипыЗаказов.ZMP2Кодовые Тогда
			ФормаДокумента.ТипЦен = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.PNCЗакупСрочная;
		ИначеЕсли ТипЗаявки = Справочники.ТипыЗаказов.ZMP4Складской или 
						ТипЗаявки = Справочники.ТипыЗаказов.ZMP9Промо или 
							ТипЗаявки = Справочники.ТипыЗаказов.ZMP4ПрямаяПоставка Тогда
			ФормаДокумента.ТипЦен = Справочники.Renault_ОбщиеНастройкиБазыДанных.ЭтаБаза.PNCЗакупСкладская;
		КонецЕсли;
		ФормаДокумента.Открыть();
	КонецЕсли;
КонецПроцедуры

