
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь; 
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	ВОбработке = ПолучитьСтатусВОбработке (ТекущаяСтрока.Ссылка);
	
	ФормаДокумента = ПолучитьФорму("ОбщаяФорма.Renault_ФормаДокументаЗаказПоставшику");
	ФормаДокумента.ДокументОбъект = ТекущаяСтрока.Ссылка.ПолучитьОБъект();
	Если ВОбработке Тогда
		ФормаДокумента.ТолькоПросмотр = Истина;
	Иначе
		ФормаДокумента.ЭлементыФормы.ТипЗаказа.ТолькоПросмотр = Истина;
		ФормаДокумента.УчитыватьКратность = Истина;
		ФормаДокумента.ЭлементыФормы.Контрагент.ТолькоПросмотр = Истина;
	КонецЕсли;
	ФормаДокумента.ЭлементыФормы.КоманднаяПанельТовары.Кнопки.Renault.Доступность = Истина;
	ФормаДокумента.Открыть();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтатусВОбработке (Заявка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ИсторияВыгрузкиЗаказов.ЗаказПоставщику
	|ИЗ
	|	РегистрСведений.Renault_ИсторияВыгрузкиЗаказов КАК Renault_ИсторияВыгрузкиЗаказов
	|ГДЕ
	|	Renault_ИсторияВыгрузкиЗаказов.ВОбработке
	|	И Renault_ИсторияВыгрузкиЗаказов.ЗаказПоставщику = &ЗаказПоставщику";
	Запрос.УстановитьПараметр("ЗаказПоставщику", Заявка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ИсправитьКоличество(Команда)
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Отказ = ПроверитьДоступность(ТекущаяСтрока.Ссылка);
		Если Не Отказ и (ТекущаяСтрока.ОтправленВСАП или ТекущаяСтрока.ОтправленВРено) Тогда
			сПараметры = Новый Структура;
			сПараметры.Вставить("Заказ", ТекущаяСтрока.Ссылка);
			ОткрытьФорму("Обработка.Renault_ARM_Запчасти.Форма.ФормаРедКоличества",сПараметры);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьДоступность (Заявка)
	
	Если Заявка.ТипЗаказа = Справочники.ТипыЗаказов.ZMP2Срочный
		или Заявка.ТипЗаказа = Справочники.ТипыЗаказов.ZMP2Гарантийный Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ИсторияЗапросовИзменений(Команда)
	ОткрытьФорму("Обработка.Renault_ARM_Запчасти.Форма.ФормаСпискаИзменений");
КонецПроцедуры


&НаСервере
Процедура УстаноыитьДЦВЗаявке(ДЦСсылка, ДокСсылка)
	ДокОбъект = ДокСсылка.ПолучитьОбъект();
	ДокОбъект.ДилерскийЦентр = ДЦСсылка;
	ДокОбъект.Записать();
КонецПроцедуры


