	ДокументыРПартс.Параметры.УстановитьЗначениеПараметра("Заказ", ТекущиеДанные.ЗаказПокупателя);
	ОстаткиРПартс.Параметры.УстановитьЗначениеПараметра("Заказ", ТекущиеДанные.ЗаказПокупателя);
	
	Контрагент = ТекущиеДанные.Клиент.Контрагент;
	
	ЗаявкиРПартсТекущаяСтрока = ТекущиеДанные;
	
КонецПроцедуры

