Перем мРезультат Экспорт;
Перем мМассивКолонок;
Перем мТабличныйДокумент Экспорт;


Функция СформироватьШаблонТД()

    ТабличныйДокумент = Новый ТабличныйДокумент;

    Макет = ПолучитьМакет("Макет");
    
    ОбластьШапка   = Макет.ПолучитьОбласть("Шапка|Префикс");
    ОбластьКолонки = Макет.ПолучитьОбласть("Шапка|Колонка");

    ТабличныйДокумент.Вывести(ОбластьШапка);

    Для Каждого Кол Из мМассивКолонок Цикл
        ОбластьКолонки.Параметры.ИмяКолонки = Кол;
        ТабличныйДокумент.Присоединить(ОбластьКолонки);
    КонецЦикла;

    Возврат ТабличныйДокумент;

КонецФункции

Процедура РазобратьТабличныйДокумент()

    СтрокаНачала  = 2;
    КолонкаНачала = 2;

    мРезультат.Очистить();

    Итерация = 1;
    Пока Истина Цикл
        Стр = мРезультат.Добавить();
        Для К=1 По мМассивКолонок.Количество() Цикл
            х = СтрокаНачала + Итерация - 1;
            у = КолонкаНачала + К - 1;
            Т = мТабличныйДокумент.Область(х,у,х,у).Текст;
            Если К=1 И Не ЗначениеЗаполнено(Т) Тогда
                мРезультат.Удалить(Стр);
                Возврат;
            КонецЕсли;
            Стр[мМассивКолонок[К-1]] = Т;
        КонецЦикла;
        Итерация = Итерация + 1;
    КонецЦикла;

КонецПроцедуры



// Инициализирует колонки обработки и таблицу для заполнения
//
// МассивКолонок - <Массив> - Имена колонок. Должны соответствовать стандартам
//    именования колонок.
//
Процедура Инициализировать(МассивКолонок) Экспорт

    мМассивКолонок = МассивКолонок;

    мРезультат = Новый ТаблицаЗначений;

    Для Каждого Колонка Из МассивКолонок Цикл
        мРезультат.Колонки.Добавить(Колонка);
    КонецЦикла;

КонецПроцедуры


// Открывает модально форму ввода
//
Функция ОткрытьФормуВвода() Экспорт

    // Готовим таблицу
    мТабличныйДокумент = СформироватьШаблонТД();


    Форма = ПолучитьФорму("Форма");
    Форма.ОткрытьМодально();

    РазобратьТабличныйДокумент();

КонецФункции






