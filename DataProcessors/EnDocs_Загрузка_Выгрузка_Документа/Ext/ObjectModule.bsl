Функция Заполнение_Структуры_Счета_От_Поставщика_На_Выгрузку_EnDocs(Счет_От_Поставщика)Экспорт	
	JSON_Структура = Новый Структура;
	JSON_Структура.Вставить("Ext_ID"	,Строка(Счет_От_Поставщика.Ссылка.УникальныйИдентификатор()));
	JSON_Структура.Вставить("DocDate"	,Формат(Счет_От_Поставщика.Дата,"ДФ=dd.MM.yyyy"));
	JSON_Структура.Вставить("DocNumber"	,Счет_От_Поставщика.Номер);
	JSON_Структура.Вставить("DocTypeId"	,14);
	JSON_Структура.Вставить("Source"	,"Входящий");
	JSON_Структура.Вставить("RequestID"	,Строка(Новый УникальныйИдентификатор));
	JSON_Структура.Вставить("Currency"	,"RUB");
	JSON_Структура.Вставить("Operation"  ,"Операция с бумагами");
	JSON_Структура.Вставить("UploadedTo1C"  , 1);
	
	Если Булево(Счет_От_Поставщика.Товары.Итог("СуммаНДС")) Тогда
		JSON_Структура.Вставить("AmountToPay", Счет_От_Поставщика.Товары.Итог("СуммаВсего"));
		JSON_Структура.Вставить("VAT"	, Счет_От_Поставщика.Товары.Итог("СуммаНДС"));
	Иначе
		JSON_Структура.Вставить("AmountWOVAT", Счет_От_Поставщика.Товары.Итог("СуммаВсего"));
	КонецЕсли;
	Контрагент = Счет_От_Поставщика.Контрагент; 
	JSON_Структура.Вставить("Contractor", Новый Структура("Ext_ID,INN,Name,KPP",
	                                                         Строка(Контрагент.УникальныйИдентификатор()),
	                                                         Контрагент.ИНН,
	                                                         Контрагент.НаименованиеПолное,
															 Контрагент.КПП));
	Организация = Счет_От_Поставщика.Организация;														 
	JSON_Структура.Вставить("Organization", Новый Структура("Ext_ID,INN,Name,KPP",
	                                                         Строка(Организация.УникальныйИдентификатор()),
	                                                         Организация.ИНН,
	                                                         Организация.НаименованиеПолное,
															 Организация.КПП));
	Договор = Счет_От_Поставщика.ДоговорВзаиморасчетов;														 
	//JSON_Структура.Вставить("Contract", Новый Структура("Ext_ID,DocNumber,DocDate,Name,Type,ValidityPeriod",
	//                                                         Строка(Договор.УникальныйИдентификатор()),
	//                                                         Договор.НомерДоговора,
	//                                                         Формат(Договор.ДатаНачала,"ДФ=dd.MM.yyyy"),
	//														 Договор.Наименование,
	//                                                         Type_(Контрагент.ВидКонтрагента),
	//                                                         Формат(Договор.ДатаКонца,"ДФ=dd.MM.yyyy")));  
	Возврат JSON_Структура;	
КонецФункции