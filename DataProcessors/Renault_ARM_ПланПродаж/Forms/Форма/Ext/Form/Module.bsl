	|	ВТ_Настройка.ГаммаМоделей ГаммаМоделей,
	|	ВТ_Настройка.Данные Данные,
	|	ВТ_Настройка.Регистратор Регистратор,
	|	ВТ_Настройка.КоличествоRenault КоличествоRenault,
	|	ВТ_Настройка.Количество Количество,
	|	ВТ_Статистика.КоличествоФакт КоличествоФакт
	|ИЗ
	|	ВТ_Настройка КАК ВТ_Настройка
	|		левое СОЕДИНЕНИЕ ВТ_Статистика КАК ВТ_Статистика
	|		ПО //Соединение
	|//ОБЛАСТЬ ИТОГИ";
	
	ТекстИтог = "ИТОГИ СУММА(Количество),СУММА(КоличествоRenault), сумма(КоличествоФакт) ПО ";
	ТекстСоединения = "";
	Для Каждого СтрокаПорядок из Настройка.Порядок Цикл
		ТекстИтог = ТекстИтог  + ?(СтрокаПорядок.НомерСтроки <> Настройка.Порядок.Количество(),СтрокаПорядок.Значение+ ",","");
		ТекстСоединения = ТекстСоединения +" "+"ВТ_Настройка."+СтрокаПорядок.Значение +" = ВТ_Статистика." +СтрокаПорядок.Значение +" и";
	КонецЦикла;
	Текст = СтрЗаменить(Текст,"//Соединение", Лев(ТекстСоединения, СтрДлина(ТекстСоединения)-1));
	Если Настройка.Порядок.Количество() > 1 Тогда 
		Текст = СтрЗаменить(Текст,"//ОБЛАСТЬ ИТОГИ", Лев(ТекстИтог, СтрДлина(ТекстИтог)-1));
	КонецЕсли;
	
	Возврат Текст;
КонецФункции

&НаСервере
Функция  ТекстЗапросаРегистрПлан ()
	Текст = "
	|ВЫБРАТЬ
	|	Renault_ПланПродаж.Регистратор КАК Регистратор,
	|	Renault_ПланПродаж.ДилерскиеЦентры КАК ДилерскиеЦентры,
	|	Renault_ПланПродаж.Отделы КАК Отделы,
	|	Renault_ПланПродаж.Менеджеры КАК Менеджеры,
	|	Renault_ПланПродаж.Модели КАК Модели,
	|	Renault_ПланПродаж.ТипыМоделей КАК ТипыМоделей,
	|	Renault_ПланПродаж.ГаммаМоделей КАК ГаммаМоделей,
	|	Renault_ПланПродаж.Количество КАК Количество,
	|	Renault_ПланПродаж.КоличествоRenault КАК КоличествоRenault,
	|	ВТ_Статистика.КоличествоФакт КоличествоФакт,
	|	""Истина"" КАК Данные
	|ИЗ
	|	РегистрСведений.Renault_ПланПродаж КАК Renault_ПланПродаж
	|		левое СОЕДИНЕНИЕ ВТ_Статистика КАК ВТ_Статистика
	|		ПО //Соединение
	|ГДЕ
	|	Renault_ПланПродаж.ПериодПлан = &ДатаНач
	|	И Renault_ПланПродаж.ТипПериода = &ТипПериода
	//|	И Renault_ПланПродаж.ЭтапПродаж = &Этап1
	|	и Renault_ПланПродаж.Настройка = &Настройка
	|//Итоги";
	ТекстСоединения = "";
	ТекстИтог = "ИТОГИ СУММА(Количество),СУММА(КоличествоRenault), СУММА(КоличествоФакт) ПО ";
	Для Каждого СтрокаПорядок из Настройка.Порядок Цикл
		ТекстИтог = ТекстИтог  + ?(СтрокаПорядок.НомерСтроки <> Настройка.Порядок.Количество(),СтрокаПорядок.Значение+ ",","");
		ТекстСоединения = ТекстСоединения +" "+"Renault_ПланПродаж."+СтрокаПорядок.Значение +" = ВТ_Статистика." +СтрокаПорядок.Значение +" и";
	КонецЦикла;
	Текст = СтрЗаменить(Текст,"//Соединение", Лев(ТекстСоединения, СтрДлина(ТекстСоединения)-1));
	Если Настройка.Порядок.Количество() > 1 Тогда
		Текст = СтрЗаменить(Текст,"//Итоги", Лев(ТекстИтог, СтрДлина(ТекстИтог)-1));
	КонецЕсли;
	
	Возврат Текст;
КонецФункции

&НаСервере 
Функция ТекстЗапросаФактСуммаНаЭтап ()
	
	Текст = 
	"ВЫБРАТЬ
	|	Renault_ФактВыполненияЭтаповПланированияОбороты.ДилерскийЦентр КАК ДилерскиеЦентры,
	|	Renault_ФактВыполненияЭтаповПланированияОбороты.Отдел КАК Отделы,
	|	Renault_ФактВыполненияЭтаповПланированияОбороты.Менеджер КАК Менеджеры,
	|	Renault_ФактВыполненияЭтаповПланированияОбороты.Модель КАК Модели,
	|	Renault_ФактВыполненияЭтаповПланированияОбороты.ПоказательОборот,
	|	Renault_ДопИнформацияГаммаМодели.Гамма КАК ГаммаМоделей,
	|	Renault_ДопИнформацияТипыМодели.ТипМодели КАК ТипыМоделей,
	|	NULL КАК Количество
	|ПОМЕСТИТЬ ВТ_Факт
	|ИЗ
	|	РегистрНакопления.Renault_ФактВыполненияЭтаповПланирования.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			,
	|			ВЫБОР
	|					КОГДА &ЕстьОтборМенеджер = ЛОЖЬ
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Менеджер В (&ОтборМенеджер)
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ЕстьОтборДЦ = ЛОЖЬ
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ДилерскийЦентр В (&ОтборДЦ)
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ЕстьОтборМодели = ЛОЖЬ
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Модель В (&ОтборМодели)
	|				КОНЕЦ
	|				И ВЫБОР
	|					КОГДА &ЕстьОтборОтделы = ЛОЖЬ
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ Отдел В (&ОтборОтделы)
	|				КОНЕЦ
	|				И Этап = &ЭтапВыполнения) КАК Renault_ФактВыполненияЭтаповПланированияОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопИнформацияПоМоделям КАК Renault_ДопИнформацияТипыМодели
	|		ПО Renault_ФактВыполненияЭтаповПланированияОбороты.Модель = Renault_ДопИнформацияТипыМодели.Модель
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопИнформацияПоМоделям КАК Renault_ДопИнформацияГаммаМодели
	|		ПО Renault_ФактВыполненияЭтаповПланированияОбороты.Модель = Renault_ДопИнформацияГаммаМодели.Модель
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ЕстьОтборТипМодели = ЛОЖЬ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Renault_ДопИнформацияТипыМодели.ТипМодели В (&ОтборТипыМоделей)
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьОтборГамма = ЛОЖЬ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Renault_ДопИнформацияГаммаМодели.Гамма В (&ОтборГамма)
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ДилерскиеЦентры,
	|	ВложенныйЗапрос.Отделы,
	|	ВложенныйЗапрос.Менеджеры,
	|	ВложенныйЗапрос.Модели,
	|	NULL,
	|	ДопИнформацияГаммаМодели.Гамма,
	|	ДопИнформацияТипМодели.ТипМодели,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.ЭтапПродаж = &Этап1
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА Renault_СтатистикаВыполненияЭтаповПродаж.Модель ЕСТЬ NULL 
	|					ИЛИ Renault_СтатистикаВыполненияЭтаповПродаж.Модель = ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
	|				ТОГДА ВЫБОР
	|						КОГДА Renault_РабочиеЛисты.ПервичныйИнтересМодель.Модель ЕСТЬ NULL 
	|							ТОГДА ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
	|						ИНАЧЕ Renault_РабочиеЛисты.ПервичныйИнтересМодель.Модель
	|					КОНЕЦ
	|			ИНАЧЕ Renault_СтатистикаВыполненияЭтаповПродаж.Модель
	|		КОНЕЦ КАК Модели,
	|		ВЫБОР
	|			КОГДА Renault_СтатистикаВыполненияЭтаповПродаж.ДилерскийЦентр ЕСТЬ NULL 
	|				ТОГДА ВЫБОР
	|						КОГДА Renault_РабочиеЛисты.ДилерскийЦентр ЕСТЬ NULL 
	|							ТОГДА ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.ПустаяСсылка)
	|						ИНАЧЕ Renault_РабочиеЛисты.ДилерскийЦентр
	|					КОНЕЦ
	|			ИНАЧЕ Renault_СтатистикаВыполненияЭтаповПродаж.ДилерскийЦентр
	|		КОНЕЦ КАК ДилерскиеЦентры,
	|		Renault_СтатистикаВыполненияЭтаповПродаж.ЭтапПродаж КАК ЭтапПродаж,
	|		Renault_РабочиеЛисты.Отдел КАК Отделы,
	|		Renault_РабочиеЛисты.Сотрудник КАК Менеджеры,
	|		Renault_СтатистикаВыполненияЭтаповПродаж.IDK КАК IDK
	|	ИЗ
	|		РегистрСведений.Renault_СтатистикаВыполненияЭтаповПродаж КАК Renault_СтатистикаВыполненияЭтаповПродаж
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				Renault_РабочиеЛисты.IDK КАК IDK,
	|				Renault_РабочиеЛисты.ДилерскийЦентр КАК ДилерскийЦентр,
	|				ВЫБОР
	|					КОГДА Renault_РабочиеЛисты.Сотрудник ЕСТЬ NULL 
	|						ТОГДА Renault_Трафик.Менеджер
	|					ИНАЧЕ Renault_РабочиеЛисты.Сотрудник
	|				КОНЕЦ КАК Сотрудник,
	|				Renault_РабочиеЛисты.ПервичныйИнтересМодель КАК ПервичныйИнтересМодель,
	|				ВЫБОР
	|					КОГДА Renault_РабочиеЛисты.Отдел ЕСТЬ NULL 
	|						ТОГДА Renault_Трафик.Отдел
	|					ИНАЧЕ Renault_РабочиеЛисты.Отдел
	|				КОНЕЦ КАК Отдел
	|			ИЗ
	|				РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|					ПО Renault_РабочиеЛисты.IDТрафика = Renault_Трафик.Идентификатор) КАК Renault_РабочиеЛисты
	|			ПО Renault_СтатистикаВыполненияЭтаповПродаж.IDK = Renault_РабочиеЛисты.IDK
	|	ГДЕ
	|		Renault_СтатистикаВыполненияЭтаповПродаж.ДатаВыполнения >= &ДатаНач
	|		И Renault_СтатистикаВыполненияЭтаповПродаж.ДатаВыполнения <= &ДатаКон
	|		И ВЫБОР
	|				КОГДА &ЕстьОтборМенеджер = ЛОЖЬ
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Renault_РабочиеЛисты.Сотрудник В (&ОтборМенеджер)
	|			КОНЕЦ
	|		И ВЫБОР
	|				КОГДА &ЕстьОтборМодели = ЛОЖЬ
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВЫБОР
	|						КОГДА Renault_СтатистикаВыполненияЭтаповПродаж.Модель ЕСТЬ NULL 
	|								ИЛИ Renault_СтатистикаВыполненияЭтаповПродаж.Модель = ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
	|							ТОГДА ВЫБОР
	|									КОГДА Renault_РабочиеЛисты.ПервичныйИнтересМодель.Модель ЕСТЬ NULL 
	|										ТОГДА ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)
	|									ИНАЧЕ Renault_РабочиеЛисты.ПервичныйИнтересМодель.Модель
	|								КОНЕЦ
	|						ИНАЧЕ Renault_СтатистикаВыполненияЭтаповПродаж.Модель
	|					КОНЕЦ В (&ОтборМодели)
	|			КОНЕЦ
	|		И ВЫБОР
	|				КОГДА &ЕстьОтборДЦ = ЛОЖЬ
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВЫБОР
	|						КОГДА Renault_СтатистикаВыполненияЭтаповПродаж.ДилерскийЦентр ЕСТЬ NULL 
	|							ТОГДА ВЫБОР
	|									КОГДА Renault_РабочиеЛисты.ДилерскийЦентр ЕСТЬ NULL 
	|										ТОГДА ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.ПустаяСсылка)
	|									ИНАЧЕ Renault_РабочиеЛисты.ДилерскийЦентр
	|								КОНЕЦ
	|						ИНАЧЕ Renault_СтатистикаВыполненияЭтаповПродаж.ДилерскийЦентр
	|					КОНЕЦ В (&ОтборДЦ)
	|			КОНЕЦ
	|		И ВЫБОР
	|				КОГДА &ЕстьОтборОтделы = ЛОЖЬ
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Renault_РабочиеЛисты.Отдел В (&ОтборОтделы)
	|			КОНЕЦ
	|		И Renault_СтатистикаВыполненияЭтаповПродаж.ЭтапПродаж = &Этап1) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопИнформацияПоМоделям КАК ДопИнформацияТипМодели
	|		ПО ВложенныйЗапрос.Модели = ДопИнформацияТипМодели.Модель
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопИнформацияПоМоделям КАК ДопИнформацияГаммаМодели
	|		ПО ВложенныйЗапрос.Модели = ДопИнформацияГаммаМодели.Модель
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ЕстьОтборТипМодели = ЛОЖЬ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДопИнформацияТипМодели.ТипМодели В (&ОтборТипыМоделей)
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ЕстьОтборГамма = ЛОЖЬ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ДопИнформацияГаммаМодели.Гамма В (&ОтборГамма)
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_Факт.ПоказательОборот) / СУММА(ВТ_Факт.Количество) как КоличествоФакт,
	|	//Статистика
	|ПОМЕСТИТЬ ВТ_Статистика
	|ИЗ
	|	ВТ_Факт КАК ВТ_Факт
	|
	|СГРУППИРОВАТЬ ПО
	|	//Статистика
	|;";
	
	ТекстСтатистика = "";
	Для Каждого СтрокаПорядок из Настройка.Порядок Цикл
		ТекстСтатистика = ТекстСтатистика +"ВТ_Факт."+ СтрокаПорядок.Значение +",";
	КонецЦикла;
 
	Текст = СтрЗаменить(Текст,"//Статистика", Лев(ТекстСтатистика, СтрДлина(ТекстСтатистика)-1));
	
	Возврат Текст;
КонецФункции

&НаСервере 
Функция  ПолучитьДЗДляПроцентрого ()
	
	Текст = "" +ТекстЗапросаФактКоличественный() + ТекстЗапросаНастройки();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭтапВыполнения", Настройка.ЭтапВыполнения);
	Запрос.УстановитьПараметр("Этап1", Настройка.ЭтапПродаж);
	Запрос.УстановитьПараметр("Этап2", Настройка.ЭтапПродажПроцентный);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	Запрос.УстановитьПараметр("ЕстьОтборДЦ", Настройка.ДилерскиеЦентры);
	Запрос.УстановитьПараметр("ЕстьОтборОтделы", Настройка.Отделы);
	Запрос.УстановитьПараметр("ЕстьОтборМенеджер", Настройка.Менеджеры);
	Запрос.УстановитьПараметр("ЕстьОтборМодели", Настройка.Модели);
	Запрос.УстановитьПараметр("ОтборДЦ", Настройка.СоставДилерскиеЦентры.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборОтделы", Настройка.СоставОтделы.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборМодели", Настройка.СоставМодели.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборМенеджер", Настройка.СоставМенеджеры.ВыгрузитьКолонку("Значение"));   
	Запрос.УстановитьПараметр("Ссылка", Настройка);
	Запрос.УстановитьПараметр("ОтборТипыМоделей", Настройка.СоставТипыМоделей.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборГамма", Настройка.СоставГаммаМоделей.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ЕстьОтборТипМодели", Настройка.ТипыМоделей);
	Запрос.УстановитьПараметр("ЕстьОтборГамма", Настройка.ГаммаМоделей);
	
	Запрос.Текст = Текст;

	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
КонецФункции

&НаСервере
Функция ПолучитьДЗДляКоличественного ()
	
	Текст = "" +ТекстЗапросаФактКоличественный() + ТекстЗапросаНастройки();

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Этап1", Настройка.ЭтапПродаж);
	Запрос.УстановитьПараметр("Этап2", Настройка.ЭтапПродажПроцентный);
	Запрос.УстановитьПараметр("ЭтапВыполнения", Настройка.ЭтапВыполнения);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	Запрос.УстановитьПараметр("ЕстьОтборДЦ", Настройка.ДилерскиеЦентры);
	Запрос.УстановитьПараметр("ЕстьОтборОтделы", Настройка.Отделы);
	Запрос.УстановитьПараметр("ЕстьОтборМенеджер", Настройка.Менеджеры);
	Запрос.УстановитьПараметр("ЕстьОтборМодели", Настройка.Модели);
