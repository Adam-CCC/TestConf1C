
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отказ = Истина;
	
	ТипПериода = Перечисления.Renault_ТипыПериода.Месяц;
	Элементы.СписокЗаписатьИзменения.Доступность = ПараметрыСеанса.Renault_ПраваПользователя.ПравоНаСозданиеПлановПродаж;
	Элементы.Согласовать.Доступность = ПараметрыСеанса.Renault_ПраваПользователя.ПравоНаУтверждениеПлановПродаж и ЗначениеЗаполнено(Настройка);
	
	Ошибка = "";
	ЗаполнитьСписок(Ошибка);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписок(Ошибка)
	
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Ошибка = "Не выбрана настройка";
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Настройка.ТипПлана) Тогда
		Ошибка = "Не задан тип плана для настройки";
		Возврат;
	КонецЕсли;
	
	Если Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Количественный или 
		Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Процентный Тогда
		Текст = "" +ТекстЗапросаФактКоличественный() + ТекстЗапросаРегистрПлан();
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Суммовой Тогда
		Текст = "" + ТекстЗапросаФактСуммовой() + ТекстЗапросаРегистрПлан();
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.СуммовойНаЕдиницу Тогда
		Текст = "" + ТекстЗапросаФактСуммовойНаЕдиницу() + ТекстЗапросаРегистрПлан();
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.СуммаНаЭтапПродажи Тогда
		Текст = "" + ТекстЗапросаФактСуммаНаЭтап() + ТекстЗапросаРегистрПлан();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;

	Запрос.УстановитьПараметр("Этап1", Настройка.ЭтапПродаж);
	Запрос.УстановитьПараметр("Этап2", Настройка.ЭтапПродажПроцентный);
	Запрос.УстановитьПараметр("ЭтапВыполнения", Настройка.ЭтапВыполнения);
	Запрос.УстановитьПараметр("ТипПериода", Настройка.ТипПериода);
	Запрос.УстановитьПараметр("Настройка", Настройка);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	Запрос.УстановитьПараметр("ЕстьОтборДЦ", Настройка.ДилерскиеЦентры);
	Запрос.УстановитьПараметр("ЕстьОтборОтделы", Настройка.Отделы);
	Запрос.УстановитьПараметр("ЕстьОтборМенеджер", Настройка.Менеджеры);
	Запрос.УстановитьПараметр("ЕстьОтборМодели", Настройка.Модели);
	Запрос.УстановитьПараметр("ЕстьОтборТипМодели", Настройка.ТипыМоделей);
	Запрос.УстановитьПараметр("ЕстьОтборГамма", Настройка.ГаммаМоделей);
	Запрос.УстановитьПараметр("ОтборДЦ", Настройка.СоставДилерскиеЦентры.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборОтделы", Настройка.СоставОтделы.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборМодели", Настройка.СоставМодели.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборМенеджер", Настройка.СоставМенеджеры.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборТипыМоделей", Настройка.СоставТипыМоделей.ВыгрузитьКолонку("Значение"));
	Запрос.УстановитьПараметр("ОтборГамма", Настройка.СоставГаммаМоделей.ВыгрузитьКолонку("Значение"));

	Результат = Запрос.Выполнить() ;
	Если не Результат.Пустой() Тогда
		результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		ЗначениеВРеквизитФормы(результат, "Список");
		ПолучитьСтатусСогласования ();
	Иначе
		ЗаполнитьПоНастройке();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьСтатусСогласования ()
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ИсторияСогласованияПлановПродаж.Согласован
	|ИЗ
	|	РегистрСведений.Renault_ИсторияСогласованияПлановПродаж КАК Renault_ИсторияСогласованияПлановПродаж
	|ГДЕ
	|	Renault_ИсторияСогласованияПлановПродаж.Настройка = &Настройка
	|	И Renault_ИсторияСогласованияПлановПродаж.ПериодПлана = &ПериодПлана";
	Запрос.УстановитьПараметр("Настройка", Настройка);
	Запрос.УстановитьПараметр("ПериодПлана", Период);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Элементы.Согласовать.Заголовок = ?(Выборка.Согласован, "Согласован", "Согласовать");
		Элементы.Согласовать.Доступность = Не Выборка.Согласован и ПараметрыСеанса.Renault_ПраваПользователя.ПравоНаУтверждениеПлановПродаж;
		Согласован = Выборка.Согласован;
		Если Согласован ТОгда
			Элементы.Согласовать.ЦветФона = WebЦвета.СветлоЗеленый;
		Иначе
			Элементы.Согласовать.цветфона =ЦветаСтиля.ЦветФонаКнопки;
		КонецЕсли;
	Иначе
		Элементы.Согласовать.Заголовок = "Согласовать";
		Элементы.Согласовать.цветфона =ЦветаСтиля.ЦветФонаКнопки;
		Элементы.Согласовать.Доступность =  ПараметрыСеанса.Renault_ПраваПользователя.ПравоНаУтверждениеПлановПродаж;
		Согласован = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьДатуПериода ( Направление = "");
	Если Настройка.ТипПериода = Перечисления.Renault_ТипыПериода.Неделя Тогда
		Если Направление = "-" Тогда
			Период = НачалоНедели(НачалоНедели(Период)-1);
			
		ИначеЕсли Направление = "+" Тогда
			Период = НачалоНедели(КонецНедели(Период)+1);
		иначе
			Период = НачалоНедели(Период);
		КонецЕсли; 
		ДатаНачала = Период;
		ДатаОкончания = КонецНедели(ДатаНачала);
		Возврат ""+НеделяГода(Период) +" неделя " +Формат(Период,"ДФ=гггг")+"г.";
	ИначеЕсли Настройка.ТипПериода = Перечисления.Renault_ТипыПериода.Месяц Тогда
		Если Направление = "-" Тогда
			Период = НачалоМесяца(НачалоМесяца(Период)-1);
		ИначеЕсли Направление = "+" Тогда
			Период = НачалоМесяца(КонецМесяца(Период)+1);
		Иначе
			Период = НачалоМесяца(Период);
		КонецЕсли;
		ДатаНачала = Период;
		ДатаОкончания = КонецМесяца(ДатаНачала);
		Возврат ""+Формат(Период,"ДФ='ММММ гггг'")+"г.";
	ИначеЕсли Настройка.ТипПериода = Перечисления.Renault_ТипыПериода.Квартал Тогда
		Если Направление = "-" Тогда
			Период = НачалоКвартала(НачалоКвартала(Период)-1);
		ИначеЕсли Направление = "+" Тогда
			Период = НачалоКвартала(КонецКвартала(Период)+1);
		Иначе
			Период = НачалоКвартала(Период);
		КонецЕсли;
		ДатаНачала = Период;
		ДатаОкончания = КонецКвартала(ДатаНачала);
		Возврат ""+Формат(Период,"ДФ=к") +" квартал " +Формат(Период,"ДФ=гггг")+"г.";
	ИначеЕсли Настройка.ТипПериода = Перечисления.Renault_ТипыПериода.Год Тогда
		Если Направление = "-" Тогда
			Период = НачалоГода(НачалоГода(Период)-1);
		ИначеЕсли Направление = "+" Тогда
			Период = НачалоГода(КонецГода(Период)+1);
		Иначе
			Период = НачалоГода(Период);
		КонецЕсли;
		ДатаНачала = Период;
		ДатаОкончания = КонецГода(ДатаНачала);
		Возврат ""+Формат(Период,"ДФ='гггг'")+"г.";
	Иначе
		Период = Дата(1,1,1); 
		ДатаНачала = Период;
		ДатаОкончания = Период;
		Возврат "Настройка не заполнена"; 
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЭтапПродажПриИзменении(Элемент)
	Оповестить("ОбновитьСписок");
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзменения(Команда)
	ЗаписатьИзмененияНаСервере ();
	Оповестить("ОбновитьСписок");
КонецПроцедуры

&НаСервере
Процедура ДеревоВТаблицу(ТаблицаЗначений, ДеревоЗначений = NULL, СтрокаДерева = NULL, КлючСвязи = NULL) Экспорт
	Если СтрокаДерева = NULL И КлючСвязи = NULL Тогда
		//ПЕРВЫЙ ВЫЗОВ ПРОЦЕДУРЫ (КОРНЕВЫЕ ЭЛЕМЕНТЫ)
		ПервыйВызов = Истина;
		ТаблицаЗначений.Очистить();
		ИсточникВыборки = ДеревоЗначений.Строки;
		КлючСвязи = 0;	// ЭЛЕМЕНТ ВЕРХНЕГО УРОВНЯ ИМЕЕТ НОМЕР СТРОКИ РОДИТЕЛЯ 0 (ОБЯЗАТЕЛЬНЫЙ РЕКВИЗИТ)
	Иначе
		//ВНУТРЕННИЙ ВЫЗОВ ПРОЦЕДУРЫ (ПОДЧИНЕННЫЕ ЭЛЕМЕНТЫ)
		ПервыйВызов = Ложь;
		ИсточникВыборки = СтрокаДерева.Строки;
	КонецЕсли;	
	Для каждого Стр из ИсточникВыборки Цикл
		Если Стр.Данные Тогда
			НС = ТаблицаЗначений.Добавить();
			Для каждого Кол из ТаблицаЗначений.Колонки Цикл
				Если Кол.Имя = "КлючСвязи" Тогда
					НС.КлючСвязи = КлючСвязи
				ИначеЕсли Кол.Имя = "НомерСтроки" Тогда
					Продолжить;
				Иначе	
					НС[Кол.Имя] = Стр[Кол.Имя];
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		Если НЕ Стр.Строки.Количество() = 0 Тогда
			ДеревоВТаблицу(ТаблицаЗначений,, Стр, 1);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьИзмененияНаСервере ()
	
	ДеревоДанных = РеквизитФормыВЗначение("Список",Тип("ДеревоЗначений"));
	
	ТаблицаДанных =  Новый ТаблицаЗначений;
	Для Каждого КолонкаДерева из ДеревоДанных.Колонки Цикл
		
		ТаблицаДанных.Колонки.Добавить(КолонкаДерева.Имя, КолонкаДерева.ТипЗначения);
		
	КонецЦикла;
	
	ДеревоВТаблицу(ТаблицаДанных, ДеревоДанных);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.ДилерскиеЦентры,
	|	Таблица.Отделы,
	|	Таблица.Менеджеры,
	|	Таблица.Модели,
	|	Таблица.ТипыМоделей,
	|	Таблица.ГаммаМоделей,
	|	Таблица.Количество,
	|	Таблица.КоличествоRenault,
	|	Таблица.Регистратор,
	|	&ТипПериода КАК ТипПериода,
	|	&ПериодПлана КАК ПериодПлана,
	//|	&ЭтапПродаж КАК ЭтапПродаж,
	|	&Настройка КАК Настройка
	|ПОМЕСТИТЬ Вт_Таблица
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_ПланПродаж.Регистратор,
	|	Renault_ПланПродаж.ДилерскиеЦентры,
	//|	Renault_ПланПродаж.ЭтапПродаж,
	|	Renault_ПланПродаж.Отделы,
	|	Renault_ПланПродаж.Менеджеры,
	|	Renault_ПланПродаж.Модели,
	|	Renault_ПланПродаж.ТипыМоделей,
	|	Renault_ПланПродаж.ГаммаМоделей,
	|	Renault_ПланПродаж.Количество,
	|	Renault_ПланПродаж.КоличествоRenault
	|ПОМЕСТИТЬ ВТ_Регистр
	|ИЗ
	|	РегистрСведений.Renault_ПланПродаж КАК Renault_ПланПродаж
	|ГДЕ
	|	Renault_ПланПродаж.Регистратор В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Вт_Таблица.Регистратор
	|			ИЗ
	|				Вт_Таблица КАК Вт_Таблица)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Вт_Таблица.ДилерскиеЦентры, ВТ_Регистр.ДилерскиеЦентры) КАК ДилерскиеЦентры,
	|	ЕСТЬNULL(Вт_Таблица.Отделы, ВТ_Регистр.Отделы) КАК Отделы,
	|	ЕСТЬNULL(Вт_Таблица.Менеджеры, ВТ_Регистр.Менеджеры) КАК Менеджеры,
	|	ЕСТЬNULL(Вт_Таблица.Модели, ВТ_Регистр.Модели) КАК Модели,
	|	ЕСТЬNULL(Вт_Таблица.ТипыМоделей, ВТ_Регистр.ТипыМоделей) КАК ТипыМоделей,
	|	ЕСТЬNULL(Вт_Таблица.ГаммаМоделей, ВТ_Регистр.ГаммаМоделей) КАК ГаммаМоделей,
	|	ЕСТЬNULL(Вт_Таблица.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(Вт_Таблица.КоличествоRenault, ВТ_Регистр.КоличествоRenault) КАК КоличествоRenault,
	|	ЕСТЬNULL(Вт_Таблица.Регистратор, ВТ_Регистр.Регистратор) КАК Регистратор,
	|	ЕСТЬNULL(Вт_Таблица.ТипПериода, &ТипПериода) КАК ТипПериода,
	|	ЕСТЬNULL(Вт_Таблица.ПериодПлана, &ПериодПлана) КАК ПериодПлана,
	//|	ЕСТЬNULL(Вт_Таблица.ЭтапПродаж, &ЭтапПродаж) КАК ЭтапПродаж,
	|	ЕСТЬNULL(Вт_Таблица.Настройка, &Настройка) КАК Настройка,
	|	ВЫБОР
	|		КОГДА ВТ_Регистр.Количество ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Изменена
	|ИЗ
	|	Вт_Таблица КАК Вт_Таблица
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Регистр КАК ВТ_Регистр
	|		ПО Вт_Таблица.Регистратор = ВТ_Регистр.Регистратор
	|			И (ВЫБОР
	|				КОГДА ВТ_Регистр.ДилерскиеЦентры ЕСТЬ NULL 
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Вт_Таблица.ДилерскиеЦентры = ВТ_Регистр.ДилерскиеЦентры
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_Регистр.Отделы ЕСТЬ NULL 
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Вт_Таблица.Отделы = ВТ_Регистр.Отделы
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_Регистр.Менеджеры ЕСТЬ NULL 
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Вт_Таблица.Менеджеры = ВТ_Регистр.Менеджеры
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_Регистр.Модели ЕСТЬ NULL 
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ Вт_Таблица.Модели = ВТ_Регистр.Модели
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_Регистр.ТипыМоделей ЕСТЬ NULL 
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВТ_Регистр.ТипыМоделей = Вт_Таблица.ТипыМоделей
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_Регистр.ГаммаМоделей ЕСТЬ NULL 
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВТ_Регистр.ГаммаМоделей = Вт_Таблица.ГаммаМоделей
	|			КОНЕЦ)
	|ГДЕ
	|	(ВТ_Регистр.Количество <> Вт_Таблица.Количество
	|			ИЛИ ВТ_Регистр.Количество ЕСТЬ NULL 
	|			ИЛИ Вт_Таблица.Количество ЕСТЬ NULL )
	|ИТОГИ ПО
	|	Регистратор";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДанных);
//	Запрос.УстановитьПараметр("ЭтапПродаж", Настройка.ЭтапПродаж);
	Запрос.УстановитьПараметр("ТипПериода", Настройка.ТипПериода);
	Запрос.УстановитьПараметр("Настройка", Настройка);
	Запрос.УстановитьПараметр("ПериодПлана", Период);
	
	Результат = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Результат.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Результат.Регистратор) Тогда
			ДокОбъект = Документы.Renault_ВводПланаПродаж.СоздатьДокумент();
			//ДокОбъект.ЭтапПродаж = Настройка.ЭтапПродаж;
			ДокОбъект.ТипПериода = Настройка.ТипПериода;
			ДокОбъект.Период = Период;
			ДокОбъект.Настройка = Настройка;
			ДокОбъект.Дата = ТекущаяДата();
			ДокОбъект.УстановитьНовыйНомер();
		Иначе
			ДокОбъект = Результат.Регистратор.ПолучитьОбъект();
		КонецЕсли;
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Изменена Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("ДилерскиеЦентры",Выборка.ДилерскиеЦентры);
				Отбор.Вставить("Отделы",Выборка.Отделы);
				Отбор.Вставить("Менеджеры",Выборка.Менеджеры);
				Отбор.Вставить("Модели",Выборка.Модели);
				Отбор.Вставить("ТипыМоделей",Выборка.ТипыМоделей);
				Отбор.Вставить("ГаммаМоделей", Выборка.ГаммаМоделей);
				НайденаСтрока = ДокОбъект.ПланПродаж.НайтиСтроки(Отбор);
				Если НайденаСтрока.Количество () > 0 Тогда
					СтрокаТЗ = НайденаСтрока[0];
					СтрокаТЗ.Количество = Выборка.Количество;
				КонецЕсли;
			Иначе
				СтрокаТЗ = ДокОбъект.ПланПродаж.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка);
			КонецЕсли;
		КонецЦикла;
		//Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		//Исключение
			
		//КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСписок" Тогда  
		Ошибка = "";
		ЗаполнитьСписок(Ошибка);
		Если Ошибка <> "" Тогда
			Предупреждение(Ошибка);
		КонецЕсли;
		СписокЭлементов = Список.ПолучитьЭлементы();
		Для Каждого лСтрокаЭлемента Из Список.ПолучитьЭлементы() Цикл
			Элементы.Список.Развернуть(лСтрокаЭлемента.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	Если Не Элемент.ТекущиеДанные.Данные или 
		Элемент.ТекущийЭлемент.Имя <> "Количество" или 
		не ПараметрыСеанса.Renault_ПраваПользователя.ПравоНаСозданиеПлановПродаж 
			или (Согласован и не ПараметрыСеанса.Renault_ПраваПользователя.ПравоНаУтверждениеПлановПродаж) Тогда 
			Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
 
	мОтбор = ПолучитьОтбор (); 
	ПересчитатьИтогиНаСервере();
	Для Каждого лСтрокаЭлемента Из Список.ПолучитьЭлементы() Цикл
		Элементы.Список.Развернуть(лСтрокаЭлемента.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	ИдентификаторСтроки = 0; 
	ПрекратитьПоиск = Ложь; 
	НайтиСтрокуДерева(Список.ПолучитьЭлементы(), мОтбор, ИдентификаторСтроки, ПрекратитьПоиск, 0); 
	Элементы.Список.ТекущаяСтрока = ИдентификаторСтроки; 
КонецПроцедуры

&НаСервере
Функция ПолучитьОтбор ()
	Отбор = Новый Структура;
	ТекДанные = Список.НайтиПоИдентификатору(Элементы.Список.ТекущаяСтрока);
	Для Каждого стрНастройка из Настройка.Порядок Цикл
		Отбор.Вставить(стрНастройка.Значение, ТекДанные[стрНастройка.Значение]);
	КонецЦикла;
	Возврат Отбор;
КонецФункции

&НаКлиенте 
Процедура НайтиСтрокуДерева(КоллекцияЭлементовДерева, ТекущиеДанные, ИдентификаторСтроки, ПрекратитьПоиск,Индекс) 
	
	Для Каждого СтрокаДерева Из КоллекцияЭлементовДерева Цикл 
		Если ПрекратитьПоиск Тогда 
			Возврат; 
		КонецЕсли; 
		Ключ = ПолучитьКлюч(Индекс, ТекущиеДанные);
		Если СтрокаДерева[Ключ] = ТекущиеДанные[Ключ] Тогда 
			если ТекущиеДанные.Количество ()-1 = Индекс Тогда
				ИдентификаторСтроки = СтрокаДерева.ПолучитьИдентификатор(); 
				ПрекратитьПоиск = Истина; 
				Возврат; 
			Иначе
				КоллекцияЭлементов = СтрокаДерева.ПолучитьЭлементы(); 
				
				Если КоллекцияЭлементов.Количество() > 0 Тогда 
					НайтиСтрокуДерева(КоллекцияЭлементов, ТекущиеДанные, ИдентификаторСтроки, ПрекратитьПоиск, Индекс+1); 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
 
	КонецЦикла; 
	
КонецПроцедуры 

&НаКлиенте 
Функция ПолучитьКлюч (Индекс, ТекущиеДанные)
	х=0;
	Для Каждого стрСоответствие из ТекущиеДанные Цикл
		Если х = Индекс Тогда
			Возврат стрСоответствие.Ключ;
		КонецЕсли;
		х=х+1
	КонецЦикла;
	Возврат "";
	
КонецФункции

&НаСервере
Процедура  ПересчитатьИтогиНаСервере ()
	Дерево = РеквизитФормыВЗначение("Список", Тип("ДеревоЗначений"));
	соотвКолонок = Новый Соответствие;
	соотвКолонок.Вставить("Количество");
	СчитатьСуммыДЗ(Дерево.Строки, соотвКолонок); 
	ЗначениеВРеквизитФормы(Дерево, "Список");
КонецПроцедуры

&НаСервере
Процедура СчитатьСуммыДЗ(пСтрокиДЗ, пСуммы) Экспорт
	Для Каждого лСтр Из пСтрокиДЗ Цикл
		//если уровень группировок - высчитываем итог
		
		Если лСтр.Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СчитатьСуммыДЗ(лСтр.Строки, пСуммы);
		Для Каждого лЗн Из пСуммы Цикл
			лСтр[лЗн.Ключ] = лСтр.Строки.Итог(лЗн.Ключ);
		КонецЦикла; 
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	Если ЗначениеЗаполнено(Настройка) Тогда
		ЗаполнитьПоНастройке();
	КонецЕсли;
	СписокЭлементов = Список.ПолучитьЭлементы();
	Если СписокЭлементов.Количество() > 0 Тогда
		Для Каждого лСтрокаЭлемента Из Список.ПолучитьЭлементы() Цикл
			Элементы.Список.Развернуть(лСтрокаЭлемента.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоНастройке ()
	
	Если Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Количественный Тогда
		Результат = ПолучитьДЗДляКоличественного ();
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Процентный Тогда
		Результат = ПолучитьДЗДляПроцентрого ();
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Суммовой Тогда 
		Результат = ПолучитьДЗДляСуммового();
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.СуммовойНаЕдиницу Тогда 
		Результат = ПолучитьДЗДляСуммовойНаЕдиницу();
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.СуммаНаЭтапПродажи Тогда
		Результат = ПолучитьДЗДляСуммыНаЭтап();
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Результат, "Список");
	Элементы.Согласовать.Доступность = Ложь;
	Элементы.Согласовать.ЦветФона=ЦветаСтиля.ЦветФонаКнопки;
	Элементы.Согласовать.Заголовок = "Согласовать";
	Согласован = Ложь;

КонецПроцедуры  

