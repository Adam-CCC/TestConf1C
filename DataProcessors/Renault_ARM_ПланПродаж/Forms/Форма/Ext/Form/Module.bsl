&НаСервере 
Функция ПечатьНаСервере ()
	ТЗ = РеквизитФормыВЗначение("Список", Тип("ДеревоЗначений"));
	мНаУдаление = Новый Массив;
	Для Каждого колонки из ТЗ.Колонки Цикл
		ЗначениеНастройки = Настройка.Порядок.Найти(колонки.Имя);
		Если ЗначениеНастройки = Неопределено и
				Колонки.Имя <> "Количество" и
					Колонки.Имя <> "КоличествоФакт" Тогда
			мНаУдаление.Добавить(колонки);
		КонецЕсли;
	КонецЦикла;
	Если мНаУдаление.Количество() Тогда
		Для Каждого знНаУдаление из мНаУдаление Цикл
			ТЗ.Колонки.Удалить(знНаУдаление);
		КонецЦикла;
	КонецЕсли;
	
	ТД = новый ТабличныйДокумент;
	Результат = ТЗ.Строки;
	Колонки = ТЗ.Колонки;
	СформироватьШапку(ТД,,,Колонки);
	ТД.НачатьАвтогруппировкуСтрок();
	ДеревоЗначенийВТД(ТД,Результат,0,Колонки);
	ТД.ЗакончитьАвтогруппировкуСтрок();
	Возврат ТД;
КонецФункции

&НаСервере
Процедура ДеревоЗначенийВТД(ТД,Строки,Уровень,Колонки)
	ТС = новый ТабличныйДокумент;
	Строка2 = ТС.ПолучитьОбласть("R1");
	Макет = Обработки.Renault_ARM_ПланПродаж.ПолучитьМакет("Макет");
	Если Строки.Количество() Тогда
		Для Каждого стр из Строки Цикл
			Для ит = 0 по Настройка.Порядок.Количество()-1 Цикл
				Если ит<Уровень Тогда
					ЗначениеВОбласть(Строка2.Область("R1C"+(ит+1)),"");
				Иначе
					ЗначениеВОбласть(Строка2.Область("R1C"+(ит+1)),стр[Настройка.Порядок[ит].Значение]);
				КонецЕсли;
			КонецЦикла;
			ЗначениеВОбласть(Строка2.Область("R1C"+(Настройка.Порядок.Количество()+1)),стр.Количество);
			ЗначениеВОбласть(Строка2.Область("R1C"+(Настройка.Порядок.Количество()+2)),стр.КоличествоФакт);
			ТД.Вывести(Строка2,Уровень,"Группа "+Уровень,Истина);
			ДеревоЗначенийВТД(ТД,стр.Строки,Уровень+1,Колонки)
		КонецЦикла;	
	КонецЕсли; 
КонецПроцедуры // ДеревоЗначенийВТД()


&НаСервере
Процедура СформироватьШапку(ТД,с=1,к=1,Колонки)
	Макет = Обработки.Renault_ARM_ПланПродаж.ПолучитьМакет("Макет");
	ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
	Если Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Количественный или 
			Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Процентный Тогда
		Этап = Настройка.ЭтапПродаж;
	ИначеЕсли Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.СуммовойНаЕдиницу или
				Настройка.ТипПлана = Перечисления.Renault_ТипыПланирования.Суммовой Тогда
		Этап = Настройка.ЭтапВыполнения;
	КонецЕсли;

	ОбластьШапки.Параметры.ЭтапПродаж = Этап;
	ОбластьШапки.Параметры.Период = ПолучитьДатуПериода();
	ТД.Вывести (ОбластьШапки);
	ПервыйПроход = Истина;
	Для Каждого стр из Настройка.Порядок Цикл
		//ЗначениеНастройки = Настройка.Порядок.Найти(стр.Имя);
		ЗначениеНастройки = стр.Значение;
		Обл = Макет.ПолучитьОбласть(ЗначениеНастройки+"шапка");
		Если ПервыйПроход Тогда
			ТД.Вывести(Обл);
			ПервыйПроход = ЛОжь;
		Иначе
			ТД.Присоединить(Обл);
		КонецЕсли;
	КонецЦикла;
	Обл = Макет.ПолучитьОбласть("КоличествоШапка");
	ТД.Присоединить(Обл);
	Обл = Макет.ПолучитьОбласть("КоличествоФактШапка");
	ТД.Присоединить(Обл);
КонецПроцедуры // СформироватьШапку()


&НаСервере
Процедура ЗначениеВОбласть(Область,Значение)
	Если ТипЗнч(Значение) = Тип("ОбъектМетаданных") Тогда
		Область.Текст = Значение.ПолноеИмя();
	ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений")	Тогда
		Область.Текст = Строка(Значение)+"("+Значение.Количество()+")";
	Иначе
		Область.Текст = Значение;
		Область.Расшифровка = Значение;  
	КонецЕсли;
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
	Область.ГраницаСнизу = Линия;
	Область.ГраницаСправа = Линия;

КонецПроцедуры // ЗначениевОбласть() 

&НаКлиенте
Процедура СогласоватьНажатие(Элемент)
	Если Не Согласован и 
		ПараметрыСеанса.Renault_ПраваПользователя.ПравоНаУтверждениеПлановПродаж Тогда
		СогласоватьНаСервере ();
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СогласоватьНаСервере ()
	
	Менеджер = РегистрыСведений.Renault_ИсторияСогласованияПлановПродаж.СоздатьМенеджерЗаписи();
	Менеджер.Настройка = Настройка;
	Менеджер.ПериодПлана = Период;
	Менеджер.Согласован = Истина;
	Менеджер.Записать();
	ПолучитьСтатусСогласования();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	Если ВвестиДату(Период, , ЧастиДаты.Дата) Тогда
		Элементы.НадписьПериод.Заголовок = ПолучитьДатуПериода();
	КонецЕсли;
	Оповестить("ОбновитьСписок");
КонецПроцедуры

&НаКлиенте
Процедура развернуть(Команда)
	СписокЭлементов = Список.ПолучитьЭлементы();
	Если СписокЭлементов.Количество() > 0 Тогда
		Для Каждого лСтрокаЭлемента Из Список.ПолучитьЭлементы() Цикл
			Элементы.Список.Развернуть(лСтрокаЭлемента.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура свернуть(Команда)
	СписокЭлементов = Список.ПолучитьЭлементы();
	Если СписокЭлементов.Количество() > 0 Тогда
		Для Каждого лСтрокаЭлемента Из Список.ПолучитьЭлементы() Цикл
			Элементы.Список.Свернуть(лСтрокаЭлемента.ПолучитьИдентификатор());
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
