&НаСервере 
Функция ТекстЗапросаНастройки ()
	
	Текст ="
	|ВЫБРАТЬ
	|	ДилерскиеЦентры.ДилерскийЦентр,
	|	Менеджеры.Менеджер,
	|	Отделы.Отдел,
