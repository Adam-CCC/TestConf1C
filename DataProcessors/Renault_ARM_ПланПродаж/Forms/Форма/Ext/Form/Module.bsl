	Если Элементы.Список.ПодчиненныеЭлементы.Количество() Тогда
		мЭлементов = Новый Массив;
		Для Каждого элементСписка из Элементы.Список.ПодчиненныеЭлементы Цикл
			мЭлементов.Добавить(элементСписка);
		КонецЦикла;
		Для Каждого Элемент из мЭлементов Цикл
			Элементы.Удалить(Элемент);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого стрПорядок Из Настройка.Порядок Цикл
		
		НовыйЭлемент = Элементы.Добавить(стрПорядок.Значение, Тип("ПолеФормы"), Элементы.Список);       
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
		НовыйЭлемент.ПутьКДанным = "Список." + стрПорядок.Значение;
