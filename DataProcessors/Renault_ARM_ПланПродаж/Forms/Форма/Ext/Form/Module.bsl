							|	ИНАЧЕ СУММА(СтатистикаВрем.Поле1) / СУММА(СтатистикаВрем.Поле2) * 100
							|КОНЕЦ КАК КоличествоФакт," ;
	КонецЕсли;
	
	Для Каждого СтрокаПорядок из Настройка.Порядок Цикл
		ТекстСтатистика = ТекстСтатистика +"СтатистикаВрем."+ СтрокаПорядок.Значение +",";
	КонецЦикла;
	Текст = СтрЗаменить(Текст,"//КолФакт",ТекстКоличество); 
	Текст = СтрЗаменить(Текст,"//Статистика", Лев(ТекстСтатистика, СтрДлина(ТекстСтатистика)-1));
	Возврат Текст;
КонецФункции

&НаСервере 
Функция ТекстЗапросаФактСуммовой ()
	Текст = 
	"ВЫБРАТЬ
	|	Renault_ФактВыполненияЭтаповПланированияОбороты.ДилерскийЦентр ДилерскиеЦентры,
	|	Renault_ФактВыполненияЭтаповПланированияОбороты.Отдел Отделы,
