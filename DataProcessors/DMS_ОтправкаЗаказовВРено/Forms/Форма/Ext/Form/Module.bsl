
&НаКлиенте
Процедура ОткрытьДопРеквизиты(Команда)

	Отбор = Новый Структура("ЗаказПоставщику", Элементы.Объект.ТекущаяСтрока);
	
	Выборка = РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.Выбрать(Отбор);
	Если Не Выборка.Следующий() Тогда  // Записи еще нет
		Менеджер = РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.СоздатьМенеджерЗаписи();
		Менеджер.ЗаказПоставщику = Элементы.Объект.ТекущаяСтрока;
		Менеджер.Записать();
	КонецЕсли;
	
	
	Ключ = РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.СоздатьКлючЗаписи(Отбор);
	//ОткрытьЗначение(Ключ);
	ФормаЗаписи = ПолучитьФорму("РегистрСведений.Renault_ДопРеквизитыЗаказаПоставщику.Форма.ФормаРедактирования", Новый структура("Ключ", Ключ));
	ФормаЗаписи.Открыть();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКлючЗаписи(Заказ)
	
	Возврат РегистрыСведений.Renault_ДопРеквизитыЗаказаПоставщику.СоздатьКлючЗаписи(Новый Структура("ЗаказПоставщику", Заказ));

КонецФункции

&НаСервере
Функция ОтправитьЗаказНаСервере()

	Заказ = Элементы.Объект.ТекущаяСтрока;
	
	Отправка = Обработки.DMS_OrdersAPI.Создать();
	Возврат Отправка.ВыгрузитьЗаказ(Заказ);

КонецФункции

&НаКлиенте
Процедура ОтправитьЗаказ(Команда)

	Результат = ОтправитьЗаказНаСервере();
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда  // Все выгружено
		
	
	Иначе  // Произошла ошибка
		
		ФормаОшибки = ПолучитьФорму("Обработка.DMS_ОтправкаЗаказовВРено.Форма.ФормаОшибки");
		ФормаОшибки.ТекстОшибки = Результат;
		ФормаОшибки.ОткрытьМодально();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьОстаткиНаСервере()

	Заказ = Элементы.Объект.ТекущаяСтрока;
	
	Отправка = Обработки.DMS_OrdersAPI.Создать();
	Остатки = Отправка.ПолучитьОстаткиПоЗаказу(Заказ);
	
	Для Каждого Артикул Из Остатки Цикл
		
		Сообщить(Артикул.reference + ":");
		
		Для Каждого Стр Из Артикул.stocks Цикл
			
			Сообщить("Склад: " + Стр.name + ", кол-во: " + Стр.qty + ", в резерве: " + Стр.reserver);
	
		КонецЦикла;
		
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОстатки(Команда)
	ПроверитьОстаткиНаСервере();
КонецПроцедуры


