	|	Генерации_Авито.Владелец
	|ИЗ
	|	Справочник.Генерации_Авито КАК Генерации_Авито
	|ГДЕ
	|	Генерации_Авито.Наименование = &Наименование
	|	И Генерации_Авито.Владелец = &МодельАвито";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
 	Запрос.УстановитьПараметр("МодельАвито", МодельАвито);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовГенерация = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	
	Если обЗначениеНеЗаполнено(НовГенерация.Ссылка) Тогда
		
		НовГенерация.Наименование = Наименование;
 		НовГенерация.Владелец = МодельАвито; 
		НовГенерация.УстановитьНовыйКод();
		
		Попытка	НовГенерация.Записать(); Исключение КонецПопытки;
		
	КонецЕсли;
 
	Если Отладка Тогда 	 
		СМГ_Сообщить("Создана/обновлена генерация (поколение) "+НовГенерация+" с владельцем-моделью "+МодельАвито+" у которой марка "+МодельАвито.МаркаАвито);
	КонецЕсли;
	
	Возврат НовГенерация.Ссылка;
	
КонецФункции // НайтиСоздатьГенерацию(Наименование,МодельАвито)
