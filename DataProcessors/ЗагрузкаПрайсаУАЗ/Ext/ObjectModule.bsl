Функция ОбработатьФайлExcel(ПутьКФайлу, НачальнаяСтрокаФайла)
	Попытка
        Excel = новый COMОбъект("Excel.Application");
    Исключение
        Сообщить("Похоже, что Excel на компьютере не установлен. Необходимо выполнить установку/переустановку Excel.");
        Возврат Неопределено;
	КонецПопытки;
	
	Попытка
		//Подключились удачно, открываем файл
	   	Книга =  Excel.Workbooks.Open(ПутьКФайлуПрайсЛиста);
	   
	    //Получим количество строк
	    //В разных версиях Excel получаются по-разному, поэтому сначала определим версию Excel
	    Версия = Лев(Excel.Version,Найти(Excel.Version,".")-1);
		КоличествоСтрок = 0;
		Если Версия = "8" тогда
	        КоличествоСтрок   = Excel.Cells.CurrentRegion.Rows.Count;
	    Иначе
	        КоличествоСтрок   = Excel.Cells(1,1).SpecialCells(11).Row;
		Конецесли;
		
		ТаблицаРезультат = Новый ТаблицаЗначений();
		ТаблицаРезультат.Колонки.Добавить("НомерПП", Новый ОписаниеТипов("Число",, Новый КвалификаторыЧисла(10)));
		ТаблицаРезультат.Колонки.Добавить("Модель", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
		ТаблицаРезультат.Колонки.Добавить("КодМодификацииУАЗ", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(30)));
		ТаблицаРезультат.Колонки.Добавить("КодМодификации", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(30)));
		ТаблицаРезультат.Колонки.Добавить("Двигатель", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(30)));
		ТаблицаРезультат.Колонки.Добавить("Комплектация", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));
		ТаблицаРезультат.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(10,2)));
		
		
		ёё = 0;
		
		Для СЧ = НачальнаяСтрокаФайла По КоличествоСтрок Цикл
			СтрокаТаблицы = ТаблицаРезультат.Добавить();
			ёё = ёё + 1;
			СтрокаТаблицы.НомерПП = ёё;
			СтрокаТаблицы.Модель = СокрЛП(Excel.Cells(СЧ, 2).Value);
			СтрокаТаблицы.КодМодификацииУАЗ	= СокрЛП(Excel.Cells(СЧ, 3).Value);
			СтрокаТаблицы.КодМодификации = СокрЛП(Excel.Cells(СЧ, 4).Value);
			СтрокаТаблицы.Двигатель = СокрЛП(Excel.Cells(СЧ, 5).Value);
			СтрокаТаблицы.Комплектация = СокрЛП(Excel.Cells(СЧ, 6).Value);
			СтрокаТаблицы.Цена = Число(Excel.Cells(СЧ, 7).Value);
			Состояние("Обрабатывается файл Excel обработано " + СЧ +"/"+КоличествоСтрок);
		КОнецЦикла;
		
		Excel.Quit();
		Excel = Неопределено;
		
		Если Отладка Тогда
			ТаблицаРезультат.ВыбратьСтроку("Результат обработки файла Excel");
 		КонецЕсли; 
		 
		
		Возврат ТаблицаРезультат;
	Исключение
		Сообщить("Не удалось загрузить данные из файла Excel" + Символы.ПС + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Процедура ЗагрузитьДокументы(ТаблицаРезультат);
	
	//Выберем запросом то, для чего нужно заполнять цены
	
    ЗапросВариантовКомплектации = Новый Запрос();
	ЗапросВариантовКомплектации.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросВариантовКомплектации.Текст = "ВЫБРАТЬ
	                                    |	ТаблицаРезультат1.НомерПП,
	                                    |	ТаблицаРезультат1.Модель,
	                                    |	ТаблицаРезультат1.КодМодификацииУАЗ,
	                                    |	ТаблицаРезультат1.КодМодификации,
	                                    |	ТаблицаРезультат1.Двигатель,
	                                    |	ТаблицаРезультат1.Комплектация,
	                                    |	ТаблицаРезультат1.Цена
	                                    |ПОМЕСТИТЬ ТаблицаРезультат
	                                    |ИЗ
	                                    |	&ТаблицаРезультат КАК ТаблицаРезультат1
 	                                    |;
	                                    |
	                                    |////////////////////////////////////////////////////////////////////////////////
	                                    |ВЫБРАТЬ
	                                    |	ТаблицаРезультат.НомерПП,
	                                    |	ТаблицаРезультат.Модель,
	                                    |	ТаблицаРезультат.КодМодификацииУАЗ,
	                                    |	ТаблицаРезультат.КодМодификации,
	                                    |	ТаблицаРезультат.Двигатель,
	                                    |	ТаблицаРезультат.Комплектация,
	                                    |	МАКСИМУМ(ТаблицаРезультат.Цена) КАК Цена,
	                                    |	ВариантыКомплектации.Ссылка КАК ВариантыКомплектации,
	                                    |	ВариантыКомплектации.Владелец
	                                    |ИЗ
	                                    |	ТаблицаРезультат КАК ТаблицаРезультат
	                                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектации КАК ВариантыКомплектации
	                                    |		ПО ТаблицаРезультат.КодМодификацииУАЗ = ВариантыКомплектации.Артикул
	                                    |
	                                    |СГРУППИРОВАТЬ ПО
	                                    |	ТаблицаРезультат.НомерПП,
	                                    |	ТаблицаРезультат.Модель,
	                                    |	ТаблицаРезультат.КодМодификацииУАЗ,
	                                    |	ТаблицаРезультат.КодМодификации,
	                                    |	ТаблицаРезультат.Двигатель,
	                                    |	ТаблицаРезультат.Комплектация,
	                                    |	ВариантыКомплектации.Владелец,
	                                    |	ВариантыКомплектации.Ссылка
	                                    |
	                                    |УПОРЯДОЧИТЬ ПО
	                                    |	ТаблицаРезультат.НомерПП";
							   
	ЗапросВариантовКомплектации.УстановитьПараметр("ТаблицаРезультат", ТаблицаРезультат);
	
 	//ЗапросВариантовКомплектации.Текст = СтрЗаменить(ЗапросВариантовКомплектации.Текст, "ЛЕВОЕ СОЕДИНЕНИЕ", "ВНУТРЕННЕЕ СОЕДИНЕНИЕ");
	
	Если Отладка Тогда
		ТЗ = ЗапросВариантовКомплектации.Выполнить().Выгрузить();
		ТЗ.ВыбратьСтроку("Результирующая таблица для загрузки: "+ТЗ.Количество());
 	КонецЕсли; 
 	//
	//Возврат;
  	
	НачатьТранзакцию();
	
	АвторДокумента = ПараметрыСеанса.Пользователь;
	
	РезультатЗапросаВариантовКомплектации 					= ЗапросВариантовКомплектации.Выполнить().Выбрать();
	ДокументУстановкиЦен 									= Документы.ИзменениеЦенАвтомобилей.СоздатьДокумент();
	ДокументУстановкиЦен.Автор 								= АвторДокумента ;
	ДокументУстановкиЦен.Дата 								= ТекущаяДата();
	ДокументУстановкиЦен.Организация 						= ПодразделениеЦен.Организация;
	ДокументУстановкиЦен.ПодразделениеКомпании 				= ПодразделениеЦен;
 	ДокументУстановкиЦен.ТипЦен 							= ТипЦен;
	ДокументУстановкиЦен.ВалютаДокумента 					= Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	ДокументУстановкиЦен.КурсДокумента 						= 1;
	ДокументУстановкиЦен.ДатаНачалаДействия 				= ТекущаяДата();
	ДокументУстановкиЦен.Комментарий 						= "Документ создан автоматически пользователем "+АвторДокумента+" при обработке файла прайс-листа " + Формат(ТекущаяДата(), "ДЛФ=DD");
	
	СЧ = 0;
	КоличествоСозданныхДокументов = 0;
	КоличествоСтрок = РезультатЗапросаВариантовКомплектации.Количество();
  	
	Попытка
		ДокументУстановкиЦен.Записать(РежимЗаписиДокумента.Проведение);
 	Исключение
		ДокументУстановкиЦен.Записать(РежимЗаписиДокумента.Запись);
 	КонецПопытки;
 	
	Пока РезультатЗапросаВариантовКомплектации.Следующий() Цикл
		ОбработкаПрерыванияПользователя();
		СЧ = СЧ + 1;
   		
		СЧ = 0;
 		
		Если НЕ ЗначениеЗаполнено(РезультатЗапросаВариантовКомплектации.ВариантыКомплектации) Тогда
 			Сообщить("ОШИБКА! Не удалось найти вариант комплектации для "+РезультатЗапросаВариантовКомплектации.КодМодификацииУАЗ);
			Продолжить;
   		Иначе
			ВариантКомплектацииСсылка = РезультатЗапросаВариантовКомплектации.ВариантыКомплектации;
			ВладелецВариантКомплектацииСсылка = РезультатЗапросаВариантовКомплектации.Владелец.Ссылка;
 		КонецЕсли;
		
		СтрокаДокумента 			        = ДокументУстановкиЦен.Автомобили.Добавить();
		СтрокаДокумента.Автомобиль 	        = ВладелецВариантКомплектацииСсылка;
		СтрокаДокумента.ВариантКомплектации = ВариантКомплектацииСсылка;
		ДокументУстановкиЦен.ОбработкаРеквизита("Товары.Автомобили", СтрокаДокумента);
		СтрокаДокумента.Цена 		        = РезультатЗапросаВариантовКомплектации.Цена;
		Состояние("Обработано " + СЧ + "/"+ КоличествоСтрок + " (для перывания загрузки нажмите Ctrl + Break)");
	КонецЦикла;
	
	Если ДокументУстановкиЦен.Автомобили.Количество() <> 0 Тогда
		Попытка
			ДокументУстановкиЦен.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("Проведен документ: " + ДокументУстановкиЦен);
		Исключение
			ДокументУстановкиЦен.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("Записан, но не проведен документ: " + ДокументУстановкиЦен);
		КонецПопытки;
	КонецЕсли;
 	ЗафиксироватьТранзакцию();
	Попытка
		Форма=ДокументУстановкиЦен.ПолучитьФорму("ФормаДокумента");
		Форма.Открыть();
	Исключение
		//
	КонецПопытки;	
		
 КонецПроцедуры			
	
Процедура ВыполнитьЗагрузкуПрайса() Экспорт
	
	ТаблицаЦен = ОбработатьФайлExcel(ПутьКФайлуПрайсЛиста, НачальнаяСтрокаФайла);
	
	Если Отладка Тогда
		ТаблицаЦен.ВыбратьСтроку("Количество строк: "+ТаблицаЦен.Количество());  
 	КонецЕсли; 
	
	Если ТипЗнч(ТаблицаЦен)<>Тип("ТаблицаЗначений") ИЛИ ТаблицаЦен.Количество() = 0 Тогда
		Сообщить("ОШИБКА! Таблица цен не подходит для заполнения документа 'Изменение цен на автомобили'"+Символы.ПС+"Обработка прервана",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДокументы(ТаблицаЦен);
	
КонецПроцедуры

		
			