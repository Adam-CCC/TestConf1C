	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.IndiceBoite" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("GearboxIndex", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.NumeroDeBoite" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("GearboxNumber", "Показатель");
		
