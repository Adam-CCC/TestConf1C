		ТекПоказатель = ТаблицаПоказателей.Найти("RegistrationDate", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.MarqueCommerciale" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("Mark", "Показатель");		
			
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.TousLesCriteres.Critere" Тогда
		
		НоваяСтрока.Значение = Ответ_A2A.Значение;
		Наименование = Справочники.Опции.НайтиПоРеквизиту("Артикул",СокрЛП(Ответ_A2A.Значение));
		
		Если ЗначениеЗаполнено(Наименование) Тогда
			
			Если ЗначениеЗаполнено(Наименование.НаименованиеПолное) И Наименование.НаименованиеПолное <> "-" Тогда
			
				НоваяСтрока.Наименование = Наименование.НаименованиеПолное;
				
			Иначе
				
				НоваяСтрока.Наименование = НоваяСтрока.libelle;
				
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока.Наименование = НоваяСтрока.libelle;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ТекПоказатель = Неопределено тогда
		ТекПоказатель.Значение = СокрЛП(ЗначениеЭлемента);
	КонецЕсли;
	
	//Пока всегда успешно
	Возврат Успешно;
	
