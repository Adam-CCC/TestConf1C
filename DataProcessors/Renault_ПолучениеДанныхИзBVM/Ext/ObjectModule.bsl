////@+ Функция ОбработатьЗначениеЭлемента(Знач ИмяЭлемента, Знач ЗначениеЭлемента, ТаблицаПоказателей)
// Дата создания - 18.06.2012 14:41:33;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
// <Вставить описание>
//
// Параметры
//  Парам1 ИмяЭлемента  - <Тип.Вид> - <описание параметра>
//                 <продолжение описания параметра>
//  Парам2 ЗначениеЭлемента  - Строка(200) - Строковое значение параметра
//
//  Парам3 ТаблицаПоказателей  - ТаблицаЗначений - Таблица значений, в которой храним полученные данные
//
// Возвращаемое значение
//  Успешно  - Булево - Истина (по умолчанию) разбор успешен
//  Ложь - разбор не успешен
//@-
Функция ОбработатьЗначениеЭлемента(Знач ИмяЭлемента, Знач ЗначениеЭлемента, ТаблицаПоказателей, Ответ_A2A = Неопределено) 
	
	//Первоначальная инициализация
	Успешно = Истина;
	
	ТекПоказатель = Неопределено;
	
	Если ИмяЭлемента = "Response.MQ_Response.Donnees.VIN" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("Vin", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.NumeroDeFabrication" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("ProductionNumber", "Показатель");
	
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.TAPV" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("AftersalesType", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.DateDeFabrication" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("ProductionDate", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.AnneeDeFabrication" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("ProductionYear", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.NumeroImmatriculation" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("PlateNumber", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.Modele" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("Model", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.CodeModele2" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("BodyModel", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.Version" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("Version", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.LibelleModele" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("ModelText", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.LibelleCarrosserie" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("BodyworkText", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.NumeroDeMoteur" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("MotorNumber", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.TypeMoteur" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("MotorType", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.IndiceMoteur" Тогда
		
		ТекПоказатель = ТаблицаПоказателей.Найти("MotorIndex", "Показатель");
		
	ИначеЕсли ИмяЭлемента = "Response.MQ_Response.Donnees.TypeBoite" Тогда
		
