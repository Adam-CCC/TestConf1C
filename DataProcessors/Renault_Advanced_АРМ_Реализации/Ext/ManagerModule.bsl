	|		КОГДА ВТ_Товары.КоличествоДО + ВТ_Товары.Количество <= ВТ_ЗаказаноПоставщику.Заказано
	|				И ВТ_Товары.КоличествоПОСЛЕ <> 0
	|			ТОГДА ВТ_Товары.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Заказано,
	|	ВЫБОР
	|		КОГДА ВТ_Резерв.Резерв ЕСТЬ NULL
	|			ТОГДА 0
	|		КОГДА ВТ_Резерв.Резерв >= ЕСТЬNULL(ВТ_ЗаказаноВМагазин.Количество, 0)
	|			ТОГДА ВТ_Резерв.Резерв - ЕСТЬNULL(ВТ_ЗаказаноВМагазин.Количество, 0) - ЕСТЬNULL(ВТВПути.ВПути, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Резерв,
	|	ЕСТЬNULL(ВТ_Выдано.Выдано, 0) КАК Выдано,
	|	ЕСТЬNULL(ВТ_Отгружено.ОстатокСкладРеализации, 0) КАК Отгружено,
	|	ЕСТЬNULL(ВТ_Возвращено.Возвращено, 0) КАК Возвращено,
	|	ВТ_Товары.Количество,
	|	ЕСТЬNULL(ВТ_Резерв.ОстатокЯчейки, 0) КАК ОстатокЯчейки,
	|	ЕСТЬNULL(ВТ_ЗаказаноВМагазин.Количество, 0) КАК ЗаказаноВМагазин,
	|	ВТ_Товары.СуммаВсего,
	|	ЕСТЬNULL(ВТВПути.ВПути, 0) КАК ВПути
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказаноПоставщику КАК ВТ_ЗаказаноПоставщику
	|		ПО ВТ_Товары.Номенклатура = ВТ_ЗаказаноПоставщику.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_ЗаказаноПоставщику.ХарактеристикаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Резерв КАК ВТ_Резерв
	|		ПО ВТ_Товары.Номенклатура = ВТ_Резерв.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_Резерв.ХарактеристикаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Выдано КАК ВТ_Выдано
	|		ПО ВТ_Товары.Номенклатура = ВТ_Выдано.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_Выдано.ХарактеристикаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Отгружено КАК ВТ_Отгружено
	|		ПО ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_Отгружено.ХарактеристикаНоменклатуры
	|			И ВТ_Товары.Номенклатура = ВТ_Отгружено.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Возвращено КАК ВТ_Возвращено
	|		ПО ВТ_Товары.Номенклатура = ВТ_Возвращено.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_Возвращено.ХарактеристикаНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказаноВМагазин КАК ВТ_ЗаказаноВМагазин
	|		ПО ВТ_Товары.Номенклатура = ВТ_ЗаказаноВМагазин.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_ЗаказаноВМагазин.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТВПути КАК ВТВПути
	|		ПО ВТ_Товары.Номенклатура = ВТВПути.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ВТВПути.ХарактеристикаНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

КонецФункции // ТекстЗапросаСтатусыЗапчастей()

////////////////////////////////////////////////////////////////////////////////
// ПЕЧАТЬ

Функция ПечатьСчетПроформа(СсылкаНаОбъект) Экспорт 
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб = Истина;
	
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПредварительныйСчет";
	ТабДокумент.АвтоМасштаб = Истина;
	
	Макет = ПолучитьМакет("СчетПроформа");
	ЗаголовокДок = Макет.ПолучитьОбласть("Заголовок");
	
	ШтрихКод = ПолучитьШтрихКод(ЗаголовокДок, СсылкаНаОбъект);
	
	ЗаголовокДок.Параметры.Номер = СсылкаНаОбъект.Номер;
	ТабДокумент.Вывести(ЗаголовокДок);
	
	ПоДоговору = Макет.ПолучитьОбласть("Стороны");

	Структура = ПолучитьТелефонАдресКонтрагента(СсылкаНаОбъект.Контрагент);
	ТелефонКонтрагента = Структура.Телефон;
	АдресКонтрагента = Структура.Адрес;
	
	Структура = ПолучитьТелефонАдресОрганизации(СсылкаНаОбъект.Организация);
	ТелефонОрганизации = Структура.Телефон;
	АдресОрганизации = Структура.Адрес;
	
	ПоДоговору.Параметры.ИнфаПоставщик                       = ?(ЗначениеЗаполнено(СсылкаНаОбъект.Организация.ИНН), "ИНН " + СсылкаНаОбъект.Организация.ИНН + " ", "")
	+ ?(ЗначениеЗаполнено(СсылкаНаОбъект.Организация.КПП), ",КПП " + СсылкаНаОбъект.Организация.КПП + " ", "")
	+ ?(ЗначениеЗаполнено(СсылкаНаОбъект.Организация.НаименованиеПолное), СсылкаНаОбъект.Организация.НаименованиеПолное + " ", СсылкаНаОбъект.Организация.Наименование + " ")
	+ ?(ЗначениеЗаполнено(АдресОрганизации),АдресОрганизации + " ", "")
	+ ?(ЗначениеЗаполнено(АдресОрганизации),", тел." + ТелефонОрганизации + " ", "");
	
	ПоДоговору.Параметры.ИнфаПокупатель                      = ?(ЗначениеЗаполнено(СсылкаНаОбъект.Контрагент.ИНН), "ИНН " + СсылкаНаОбъект.Контрагент.ИНН + " ", "")
	+ ?(ЗначениеЗаполнено(СсылкаНаОбъект.Контрагент.КПП), ",КПП " + СсылкаНаОбъект.Контрагент.КПП + " ", "")
	+ ?(ЗначениеЗаполнено(СсылкаНаОбъект.Контрагент.НаименованиеПолное), СсылкаНаОбъект.Контрагент.НаименованиеПолное + " ", СсылкаНаОбъект.Контрагент.Наименование + " ")
	+ ?(ЗначениеЗаполнено(АдресКонтрагента),АдресКонтрагента + " ", "")
	+ ?(ЗначениеЗаполнено(ТелефонКонтрагента),", тел." + ТелефонКонтрагента + " ", "");
	
	ТабДокумент.Вывести(ПоДоговору);
	
	ДанныеАвтомобиль = Макет.ПолучитьОбласть("ДанныеАвтомобиль");
	Автомобиль = СсылкаНаОбъект.Автомобиль;
	ЗаполнитьДанныеПоАвтомобилю(Автомобиль, ДанныеАвтомобиль);
	ТабДокумент.Вывести(ДанныеАвтомобиль);
	
	// ЗАПЧАСТИ
	
	ТаблицаЗапчастиШапка = Макет.ПолучитьОбласть("ТаблицаЗапчастиШапка");
	ТабДокумент.Вывести(ТаблицаЗапчастиШапка);
	
	ТаблицаЗапчасти = Макет.ПолучитьОбласть("ТаблицаЗапчасти");
	
	ТоварыЗаказа = ПолучитьТоварыДляПечати(СсылкаНаОбъект); 
	
	НомерСтрокиЗапчасти = 1;
	ЗапчастиСуммаСНДС = 0;
	ЗапчастиСуммаНДС  = 0;
	Колво           = 0;
	Для каждого Выборка Из ТоварыЗаказа Цикл
		 ТаблицаЗапчасти.Параметры.Заполнить(Выборка);
		 ТаблицаЗапчасти.Параметры.Запчасть 					= ПолучитьНаименование(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
		 ТаблицаЗапчасти.Параметры.Цена 						= Выборка.Цена;
		 ТаблицаЗапчасти.Параметры.Колво						= Выборка.ЗаказаноПриход;
		 ТаблицаЗапчасти.Параметры.Скидка 						= Выборка.РезультирующаяСкидка;
		 ТаблицаЗапчасти.Параметры.Сумма 						= Выборка.СуммаПриход;
		 ТаблицаЗапчасти.Параметры.Номер                        = НомерСтрокиЗапчасти;
		 ТаблицаЗапчасти.Параметры.Артикул                      = СокрЛП(Строка(Выборка.Артикул));
		 ТабДокумент.Вывести(ТаблицаЗапчасти);
		 
		 ЗапчастиСуммаСНДС = ЗапчастиСуммаСНДС + Выборка.СуммаПриход;
		 СуммаНДС = Окр(Выборка.СуммаПриход * Выборка.СтавкаНДС.Ставка / (100 + Выборка.СтавкаНДС.Ставка), 2); 
		 ЗапчастиСуммаНДС = ЗапчастиСуммаНДС + СуммаНДС;
		 
		 Колво = Колво+ Выборка.ЗаказаноПриход;
		 НомерСтрокиЗапчасти  = НомерСтрокиЗапчасти + 1;
	КонецЦикла;
	
	ИтогоПоЗапчастям = Макет.ПолучитьОбласть("ИтогоПоЗапчастям");
	ИтогоПоЗапчастям.Параметры.ИтогоСумма                  = Формат(ЗапчастиСуммаСНДС, "ЧЦ=15; ЧДЦ=2; ЧН = 0,00");
	ИтогоПоЗапчастям.Параметры.ИтогоКолво                  = Колво;
	
	ТабДокумент.Вывести(ИтогоПоЗапчастям);
	
	ОрганизацияНеЯвляетсяПлательщикомНДС = СсылкаНаОбъект.Организация.ОсвобожденОтНДС;
	
	Если ОрганизацияНеЯвляетсяПлательщикомНДС Тогда 
		ИтогоПоДокументу = Макет.ПолучитьОбласть("ИтогоПоДокументуБезНДС");
	Иначе
		ИтогоПоДокументу = Макет.ПолучитьОбласть("ИтогоПоДокументу");
	КонецЕсли;
	
	ИтогоПоДокументу.Параметры.ИтогоСуммаСНДС = ЗапчастиСуммаСНДС;
	
	Если НЕ ОрганизацияНеЯвляетсяПлательщикомНДС Тогда
		ИтогоПоДокументу.Параметры.ИтогоСуммаНДС = ЗапчастиСуммаНДС;
	КонецЕсли;
	
	ФормСтрока = "Л = ru_RU; ДП = ЛОЖЬ";
	ПарПредмета="рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";

	ИтогоПоДокументу.Параметры.СуммаПрописью = ЧислоПрописью(ЗапчастиСуммаСНДС,ФормСтрока, ПарПредмета);
	ИтогоПоДокументу.Параметры.Номер = ?((НомерСтрокиЗапчасти) > 1, (НомерСтрокиЗапчасти) - 1, "0");
	
	Оплачено = ПолучитьОплачено(СсылкаНаОбъект, СсылкаНаОбъект);
	
	ИтогоПоДокументу.Параметры.Оплачено    = Оплачено;
	ИтогоПоДокументу.Параметры.СуммаОплаты = ЗапчастиСуммаСНДС - Оплачено;
	ТабДокумент.Вывести(ИтогоПоДокументу);
	
	ОбластьЭлектроннаяПочта = Макет.ПолучитьОбласть("ЭлектроннаяПочта"); 
	
	Запрос	= Новый Запрос;
	Запрос.Текст	= 		
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий)"; // АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами = АдресЭлектроннойПочтыРабочий ???
	Запрос.УстановитьПараметр("Объект", СсылкаНаОбъект.Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты тогда
			ОбластьЭлектроннаяПочта.Параметры.емаил = Выборка.Представление;
		КонецЕсли;
	КонецЦикла;
	
	ОбластьЭлектроннаяПочта.Параметры.Покупатель = СсылкаНаОбъект.Контрагент.Наименование;
	ТабДокумент.Вывести(ОбластьЭлектроннаяПочта);
	
	// !!! доработать
	//Если СсылкаНаОбъект.Организация <>Константы.пац_ОрганизацияЕНВДДляСервиса.Получить() Тогда 
	//    Подвал = Макет.ПолучитьОбласть("Подвал");
	//    Подвал.Параметры.Мастер = СсылкаНаОбъект.ЗаполненМастером;
	//    ТабДокумент.Вывести(Подвал);
	//КонецЕсли;

	Если ЗначениеЗаполнено(Автомобиль) Тогда
		ВывестиВМакетНеоплаченныеЗаказНаряды(Макет, ТабДокумент, СсылкаНаОбъект);
	КонецЕсли;

	ПодразделениеСервиса = Renault_AdvancedКлиент.ПолучитьСкладИлиНастройкуПодразделения(СсылкаНаОбъект.ПодразделениеКомпании, "ПодразделениеСервиса");
	ПодразделениеМКЦ = Renault_AdvancedКлиент.ПолучитьСкладИлиНастройкуПодразделения(СсылкаНаОбъект.ПодразделениеКомпании, "ПодразделениеМКЦ");
	Если СсылкаНаОбъект.Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо И (ПодразделениеСервиса ИЛИ ПодразделениеМКЦ) Тогда
		Опросник = Макет.ПолучитьОбласть("Опросник");
		ТабДокумент.Вывести(Опросник);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьСчет(ЗаказСсылка, Вариант) Экспорт

	ТабДокумент = Новый ТабличныйДокумент;

	Если Вариант = "ЗапчастиРаботы" Тогда
		ТабДокумент.АвтоМасштаб = Истина;
		ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СчетНаОплату(полный)";
		Макет = Обработки.Renault_Advanced_ЗаказНаряд.ПолучитьМакет("ПредвСчет");
		
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Шапка.Параметры.Получатель                               = ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.НаименованиеПолное),ЗаказСсылка.Организация.НаименованиеПолное,ЗаказСсылка.Организация.Наименование);
		Шапка.Параметры.ИНН                                      =  ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.ИНН), ЗаказСсылка.Организация.ИНН, "");
		Шапка.Параметры.КПП                                      =  ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.КПП), ЗаказСсылка.Организация.КПП, "");

		БанкСчет = Справочники.БанковскиеСчета.ПустаяСсылка();
		Банк = Справочники.Банки.ПустаяСсылка();
		Если ЗначениеЗаполнено(ЗаказСсылка.Организация.ОсновнойБанковскийСчет) Тогда 
			БанкСчет                                             =  ЗаказСсылка.Организация.ОсновнойБанковскийСчет;  
			Банк                                                 =  БанкСчет.Банк;
		Иначе
			Сообщить("Не заполнен банковский счет");
		КонецЕсли;	

		Шапка.Параметры.БанкПолучателя                           =  Банк;
		Шапка.Параметры.СчетПолучателя                           =  БанкСчет.НомерСчета;
		Шапка.Параметры.КоррСчет                                 =  Банк.КоррСчет;
		БИК                                                      =  Банк.Код;
		Шапка.Параметры.БИК                                      =  БИК;
		
		ТабДокумент.Вывести(Шапка);
		
		ЗаголовокТабДок = Макет.ПолучитьОбласть("ЗаголовокФраншиза");
		ЗаголовокТабДок.Параметры.Номер                                = ЗаказСсылка.Номер;
		ЗаголовокТабДок.Параметры.ДатаСчет                             = Формат(ЗаказСсылка.Дата,"ДЛФ=ДД");
		ЗаголовокТабДок.Параметры.НомерСчет		                     = ЗаказСсылка.Номер;
		ТабДокумент.Вывести(ЗаголовокТабДок);
		
		ПоДоговору = Макет.ПолучитьОбласть("ПоДоговору");
		Договор = ЗаказСсылка.ДоговорВзаиморасчетов;
		ПоДоговору.Параметры.НомерДоговора                       = ?(ЗначениеЗаполнено(Договор.НомерДоговора),Договор.Номер,"");
		ПоДоговору.Параметры.ДатаДоговора                        = ?(ЗначениеЗаполнено(Договор.ДатаНачала),Формат(Договор.ДатаНачала,"ДЛФ=Д"),"");
		ПоДоговору.Параметры.Направление                         = "";
		
		Структура = ПолучитьТелефонАдресКонтрагента(ЗаказСсылка.Контрагент);
		ТелефонКонтрагента = Структура.Телефон;
		АдресКонтрагента = Структура.Адрес;
		
		Структура = ПолучитьТелефонАдресОрганизации(ЗаказСсылка.Организация);
		ТелефонОрганизации = Структура.Телефон;
		АдресОрганизации = Структура.Адрес;

		ПоДоговору.Параметры.ИнфаПоставщик                       = ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.ИНН), "ИНН " + ЗаказСсылка.Организация.ИНН + " ", "")
																 + ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.КПП), ",КПП " + ЗаказСсылка.Организация.КПП + " ", "")
																 + ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.НаименованиеПолное), ЗаказСсылка.Организация.НаименованиеПолное + " ", ЗаказСсылка.Организация.Наименование + " ")
																 + ?(ЗначениеЗаполнено(АдресОрганизации),АдресОрганизации + " ", "")
																 + ?(ЗначениеЗаполнено(АдресОрганизации),", тел." + ТелефонОрганизации + " ", "");

		ПоДоговору.Параметры.ИнфаПокупатель                      = ?(ЗначениеЗаполнено(ЗаказСсылка.Контрагент.ИНН), "ИНН " + ЗаказСсылка.Контрагент.ИНН + " ", "")
																 + ?(ЗначениеЗаполнено(ЗаказСсылка.Контрагент.КПП), ",КПП " + ЗаказСсылка.Контрагент.КПП + " ", "")
																 + ?(ЗначениеЗаполнено(ЗаказСсылка.Контрагент.НаименованиеПолное), ЗаказСсылка.Контрагент.НаименованиеПолное + " ", ЗаказСсылка.Контрагент.Наименование + " ")
																 + ?(ЗначениеЗаполнено(АдресКонтрагента),АдресКонтрагента + " ", "")
																 + ?(ЗначениеЗаполнено(ТелефонКонтрагента),", тел." + ТелефонКонтрагента + " ", "");


		
		ТабДокумент.Вывести(ПоДоговору);
		
		// Получим контактных лиц контрагента
		КонтактноеЛицо = Макет.ПолучитьОбласть("КонтактноеЛицоСчетПолный");
		КонтактныеЛица = ПолучитьКонтактныеЛицаКонтрагента(ЗаказСсылка.Контрагент);
		Если КонтактныеЛица.Количество() = 1 Тогда
			ОсновноеКонтактноеЛицо = КонтактныеЛица[0].Значение;
		ИначеЕсли КонтактныеЛица.Количество() > 1 Тогда
			#Если ТолстыйКлиентОбычноеПриложение Тогда
			Предупреждение("Необходимо выбрать контактное лицо контрагента");
			ОсновноеКонтактноеЛицо = КонтактныеЛица.ВыбратьЭлемент("Контактные лица");
			ОсновноеКонтактноеЛицо = ?(ОсновноеКонтактноеЛицо=Неопределено, Неопределено, ОсновноеКонтактноеЛицо.Значение);
			#Иначе
			ОсновноеКонтактноеЛицо = КонтактныеЛица[0].Значение;
			#КонецЕсли
		КонецЕсли;
		КонтактноеЛицо.Параметры.КонтактноеЛицо                  = ?(ЗначениеЗаполнено(ОсновноеКонтактноеЛицо),ОсновноеКонтактноеЛицо.Наименование, "");
		ТабДокумент.Вывести(КонтактноеЛицо);

		
		ДанныеАвтомобиль = Макет.ПолучитьОбласть("ДанныеАвтомобиль");
		ЗаполнитьДанныеПоАвтомобилю(ЗаказСсылка.Автомобиль, ДанныеАвтомобиль);
		ТабДокумент.Вывести(ДанныеАвтомобиль);
		
		ТаблицаРаботыШапка = Макет.ПолучитьОбласть("ТаблицаРаботыШапка");
		ТабДокумент.Вывести(ТаблицаРаботыШапка);
		
		ТаблицаТовары = ПолучитьТоварыДляПечати(ЗаказСсылка);
		
		НомерПоПорядку = 1;
		ЗапчастиСуммаСНДС = 0;
		ЗапчастиСуммаНДС  = 0;
		ФормСтрока = "Л = ru_RU; ДП = ЛОЖЬ";
		ПарПредмета="рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
		ОбластьСтрокаТовары = Макет.ПолучитьОбласть("ТаблицаРаботы");
		
		Для каждого Выборка Из ТаблицаТовары Цикл
			ОбластьСтрокаТовары.Параметры.Товар = ПолучитьНаименование(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
			ОбластьСтрокаТовары.Параметры.Номер = НомерПоПорядку;
			ОбластьСтрокаТовары.Параметры.Артикул = СокрЛП(Строка(Выборка.Артикул));
			ОбластьСтрокаТовары.Параметры.Цена = Выборка.Цена;
			ОбластьСтрокаТовары.Параметры.Колво = Выборка.ЗаказаноПриход;
			ОбластьСтрокаТовары.Параметры.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
			ОбластьСтрокаТовары.Параметры.Скидка = Выборка.РезультирующаяСкидка;
			ОбластьСтрокаТовары.Параметры.СуммаСНДС = Выборка.СуммаПриход;
			ТабДокумент.Вывести(ОбластьСтрокаТовары);
			
			ЗапчастиСуммаСНДС = ЗапчастиСуммаСНДС + Выборка.СуммаПриход;
			СуммаНДС = Окр(Выборка.СуммаПриход * Выборка.СтавкаНДС.Ставка / (100 + Выборка.СтавкаНДС.Ставка), 2); 
			ЗапчастиСуммаНДС = ЗапчастиСуммаНДС + СуммаНДС;
			
			НомерПоПорядку = НомерПоПорядку + 1;
		КонецЦикла;
	
		ИтогоПоДокументу = Макет.ПолучитьОбласть("ИтогоПоДокументу");
		ИтогоПоДокументу.Параметры.ИтогоСуммаРабот                = 0;
		ИтогоПоДокументу.Параметры.ИтогоСуммаЗапчастей            = ЗапчастиСуммаСНДС;
		ИтогоПоДокументу.Параметры.ИтогоСуммаСНДС                 = ЗапчастиСуммаСНДС;
		//корректируем НДС во всех печатных формах
		//расчитаем как общее от всей суммы
		//ИтогоПоДокументу.Параметры.ИтогоСуммаНДС                  = РаботыСуммаНДС+ ЗапчастиСуммаНДС;
		ОрганизацияНеЯвляетсяПлательщикомНДС = ЗаказСсылка.Организация.ОсвобожденОтНДС;
		СуммаНДСОтОбщего = 0;
		Если ОрганизацияНеЯвляетсяПлательщикомНДС Тогда
			// Трояновский К.Е. 15.02.2019 12:21:57 {
			// Закомментировано по DMSCOR-1087
			//Если ЗаказСсылка.Дата >= '20190101' Тогда
			//	СуммаНДСОтОбщего = ЗаказСсылка.СуммаДокумента *20/120;
			//Иначе
			//	СуммаНДСОтОбщего = ЗаказСсылка.СуммаДокумента *18/118;
			//КонецЕсли;
			СуммаНДСОтОбщего = ЗаказСсылка.СуммаДокумента * Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка / (100 + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка);
			// Трояновский К.Е. 15.02.2019 12:21:57 }
		КонецЕсли;
	 	ИтогоПоДокументу.Параметры.ИтогоСуммаНДС = СуммаНДСОтОбщего;
		
		ИтогоПоДокументу.Параметры.СуммаПрописью                  = ЧислоПрописью(ЗапчастиСуммаСНДС,ФормСтрока, ПарПредмета);
		ИтогоПоДокументу.Параметры.Номер                          = ?(НомерПоПорядку >1, НомерПоПорядку - 1, "0");
		ТабДокумент.Вывести(ИтогоПоДокументу);

		// ВЫВОД ОТВЕТСТВЕННЫХ 
		
		Подвал = Макет.ПолучитьОбласть("Подвал");
		
		Ответственные = ПолучитьОтветственныхПоОрганизации(ЗаказСсылка.Организация, ЗаказСсылка.Дата);
		Подвал.Параметры.Директор   =  Ответственные.Руководитель;
		Подвал.Параметры.Бухгалтер  =  Ответственные.ГлавныйБухгалтер;
		Подвал.Параметры.Ответственный       =ПараметрыСеанса.Пользователь.Наименование;
		ТабДокумент.Вывести(Подвал);
		 
	КонецЕсли;
	
	Возврат ТабДокумент;
		 
КонецФункции // ПечатьСчет()

Функция ПечатьДоговораНаПоставкуЗЧ(ЗаказСсылка) Экспорт 
		
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ДоговорНаПоставкуЗапчастей";
	Макет = Обработки.Renault_Advanced_ЗаказНаряд.ПолучитьМакет("ДоговорНаПоставкуЗЧ");
	
	Шапка = Макет.ПолучитьОбласть("Шапка");	
	Шапка.Параметры.Организация = ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.НаименованиеПолное),ЗаказСсылка.Организация.НаименованиеПолное,ЗаказСсылка.Организация.Наименование);
	Шапка.Параметры.ОрганизацияАдрес  = киПолучитьПредставлениеКИ(ЗаказСсылка.Организация,Справочники.ВидыКонтактнойИнформации["АДРЕСЮРИДИЧЕСКИЙ"]);
	Шапка.Параметры.ОрганизацияТелефон = киПолучитьПредставлениеКИ(ЗаказСсылка.Организация,Справочники.ВидыКонтактнойИнформации["ТЕЛЕФОНРАБОЧИЙ"]);
	
	ТабДокумент.Вывести(Шапка);
	ЗаголовокТабДок = Макет.ПолучитьОбласть("Заголовок");
	ЗаголовокПараметры = ЗаголовокТабДок.Параметры;
	ЗаголовокПараметры.Номер                                                = ЗаказСсылка.Номер;
	ЗаголовокПараметры.НомерДоговор                                         = ЗаказСсылка.Номер;
	ЗаголовокПараметры.Дата                                                 = Формат(ЗаказСсылка.Дата,"ДЛФ=ДД");
	ЗаголовокПараметры.ДатаДоговор                                          = Формат(ЗаказСсылка.Дата,"ДЛФ=ДД");

	Попытка
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
	Исключение
		Сообщить("Компонента 1С:Печать штрихкодов не установлена на данном компьютере!", СтатусСообщения.Важное);
		Возврат Новый ТабличныйДокумент;
	КонецПопытки;
	ШтрихКод = Renault_Advanced_ШтрихкодированиеДокументов.Renault_ПрочитатьШтрихКод(ЗаказСсылка); // читаем ШК
	Если Не ЗначениеЗаполнено(ШтрихКод) Тогда
		ШтрихКод = Renault_Advanced_ШтрихкодированиеДокументов.Renault_ЗаписатьШтрихКод(ЗаказСсылка); 
		Если Не ЗначениеЗаполнено(ШтрихКод) Тогда
			Сообщить("Не удалось найти/создать штрих-код!", СтатусСообщения.Важное);
			Возврат Новый ТабличныйДокумент;	
		КонецЕсли;
	КонецЕсли;
	//ТипКода = Renault_Advanced_ШтрихкодированиеДокументов.ПолучитьЗначениеТипаШтрихкодаДляЭУ(ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13);
	ТипКода = 1;
	ЗаголовокТабДок.Рисунки.Штрихкод.Объект.ТипКода   = ТипКода;
	ЗаголовокТабДок.Рисунки.Штрихкод.Объект.Сообщение = ШтрихКод;

	ТабДокумент.Вывести(ЗаголовокТабДок);          
	Заказчик = Макет.ПолучитьОбласть("Заказчик");
	ЗаказчикПараметры = Заказчик.Параметры;
	
	Автомобиль = ЗаказСсылка.Автомобиль;
	ЗаказчикПараметры.Модель                                                = Автомобиль.Модель;
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЗаказСсылка.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	ЗаказчикПараметры.ГосНомер                                              = ?(ЗначениеЗаполнено(ГосНомер),ГосНомер,"");
	ЗаказчикПараметры.VIN		                                            = Автомобиль.VIN;
	ЗаказчикПараметры.Заказчик                                              = ?(ЗначениеЗаполнено(ЗаказСсылка.Контрагент.НаименованиеПолное),ЗаказСсылка.Контрагент.НаименованиеПолное,ЗаказСсылка.Контрагент.Наименование);
	
	ЗаказчикПараметры.КонтактныйТелефон = киПолучитьПредставлениеКИ(ЗаказСсылка.Контрагент, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	ДоверенныеЛица = РегистрыСведений.Renault_Advanced_ДоверенныеЛицаКонтрагентов.ПолучитьДоверенныеЛица(ЗаказСсылка.Контрагент);
	Если ДоверенныеЛица <> Неопределено И ДоверенныеЛица.Количество() > 0 Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
		Предупреждение("Укажите доверенное лицо");	
		Строка = ДоверенныеЛица.ВыбратьСтроку("Доверенные лица");
		Если Строка <> Неопределено Тогда ДоверенноеЛицо = Строка.ДоверенноеЛицо; КонецЕсли;
		
		#Иначе
			
		ДоверенноеЛицо = ДоверенныеЛица[0].ДоверенноеЛицо;
		
		#КонецЕсли
		
	КонецЕсли;
		
	ЗаказчикПараметры.ДоверенноеЛицо                           = ?(ЗначениеЗаполнено(ДоверенноеЛицо),ДоверенноеЛицо.Наименование, "");
    ЗаказчикПараметры.Организация                              = ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.НаименованиеПолное),ЗаказСсылка.Организация.НаименованиеПолное,ЗаказСсылка.Организация.Наименование);
	ТабДокумент.Вывести(Заказчик);
	ТаблицаЗапчастиШапка = Макет.ПолучитьОбласть("ТаблицаЗапчастиШапка");	
	ТабДокумент.Вывести(ТаблицаЗапчастиШапка);
	ТаблицаЗапчасти = Макет.ПолучитьОбласть("ТаблицаЗапчасти");
	
	ТоварыТаблица = ПолучитьТоварыДляПечати(ЗаказСсылка);
	
	СуммаИтоговая = 0;
	ИтогоКолво = 0;
	Для каждого Выборка Из ТоварыТаблица Цикл
		ТаблицаЗапчасти.Параметры.Запчасть = ПолучитьНаименование(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
		ТаблицаЗапчасти.Параметры.Шифр = Выборка.Артикул;
		ТаблицаЗапчасти.Параметры.ЕдиницаИзмерения = Выборка.ЕдиницаИзмерения;
		ТаблицаЗапчасти.Параметры.Колво = Выборка.ЗаказаноПриход;
		ТаблицаЗапчасти.Параметры.Цена = Выборка.Цена;
		ТаблицаЗапчасти.Параметры.Сумма = Выборка.СуммаПриход;
		СуммаИтоговая  = СуммаИтоговая + Выборка.СуммаПриход;
		ИтогоКолво = ИтогоКолво + Выборка.ЗаказаноПриход;
		ТабДокумент.Вывести(ТаблицаЗапчасти);
	КонецЦикла;
	
	ИтогоТаблица = Макет.ПолучитьОбласть("Итого");
	ИтогоТаблица.Параметры.ИтогоКолво                                       = ИтогоКолво; 
	ИтогоТаблица.Параметры.ИтогоСумма                                       = СуммаИтоговая;
	ТабДокумент.Вывести(ИтогоТаблица);
	
	ПоДоговору = Макет.ПолучитьОбласть("ПоДоговору");

	ТабДокумент.Вывести(ПоДоговору);
	
	ОтЗаказчикаИсполнителя = Макет.ПолучитьОбласть("ОтЗаказчикаИсполнителя");	
	ОтЗаказчикаИсполнителя.Параметры.Контрагент                             = ?(ЗначениеЗаполнено(ЗаказСсылка.Контрагент.НаименованиеПолное),ЗаказСсылка.Контрагент.НаименованиеПолное,ЗаказСсылка.Контрагент.Наименование);
	ТабДокумент.Вывести(ОтЗаказчикаИсполнителя);
	
	Возврат ТабДокумент;
	
КонецФункции // ПечатьАктаОбОказанииУслуг()

Функция ПечатьСчетФактура(ЗаказСсылка, Вариант = "СчетФактура") Экспорт

	Если ЗаказСсылка.Renault_advanced_ТипОбслуживания = Справочники.Renault_advanced_ТипыОбслуживания.Внутренний Тогда Возврат Неопределено; КонецЕсли;

	СФ = НайтиПодчиненныйСчетФактуру(ЗаказСсылка,, "СчетФактураВыданный");
	Если Не ЗначениеЗаполнено(СФ) Тогда Возврат Неопределено; КонецЕсли;
	
	обСФ = СФ.ПолучитьОбъект();
	Если Вариант = "СчетФактураРеферансы" Тогда обСФ.ДополнительныеСвойства.Вставить("СчетФактураРеферансы", Истина); КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент;
	Если СФ.ХозОперация = Справочники.ХозОперации.СчетФактураВыданныйКорректировка Тогда
		обСФ.ПечатьКорректировочныйСчетФактура(ТабДок);	
	Иначе	
		обСФ.ПечатьСчетФактура(ТабДок);	
	КонецЕсли;
		
	Возврат ТабДок;
	
КонецФункции // ПечатьСчетФактура()

Функция ПечатьТорг12(ЗаказСсылка) Экспорт

	Если ЗаказСсылка.Renault_advanced_ТипОбслуживания = Справочники.Renault_advanced_ТипыОбслуживания.Внутренний Тогда Возврат Неопределено; КонецЕсли;

	Реализация = ПолучитьСсылкуНаСформированныйДокумент(, "РеализацияТоваров",, ЗаказСсылка);
	
	Если НЕ ЗначениеЗаполнено(Реализация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Реализация = Реализация.ПолучитьОбъект();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	ТабДок = Новый ТабличныйДокумент;
	Реализация.ПечатьТОРГ12(ТабДок);	
	
	Возврат ТабДок;

КонецФункции // ПечатьСчетФактура()

Функция ПечатьТоварныйЧек(ЗаказСсылка) Экспорт
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ТоварныйЧек";
	Макет = Обработки.Renault_Advanced_ЗаказНаряд.ПолучитьМакет("ТоварныйЧек");
	
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.Организация = ?(ЗначениеЗаполнено(ЗаказСсылка.Организация.НаименованиеПолное),ЗаказСсылка.Организация.НаименованиеПолное,ЗаказСсылка.Организация.Наименование);
	Шапка.Параметры.ОрганизацияАдрес  = киПолучитьПредставлениеКИ(ЗаказСсылка.Организация,Справочники.ВидыКонтактнойИнформации["АДРЕСЮРИДИЧЕСКИЙ"]);
	Шапка.Параметры.ОрганизацияТелефон = киПолучитьПредставлениеКИ(ЗаказСсылка.Организация,Справочники.ВидыКонтактнойИнформации["ТЕЛЕФОНРАБОЧИЙ"]);
	
	ТабДокумент.Вывести(Шапка);
	
	ЗаголовокТабДок = Макет.ПолучитьОбласть("Заголовок");
	ЗаголовокТабДок.Параметры.ДатаДок  = ЗаказСсылка.Дата;
	ЗаголовокТабДок.Параметры.НомерДок = ЗаказСсылка.Номер;
	Реализация = ПолучитьСсылкуНаСформированныйДокумент(, "РеализацияТоваров",, ЗаказСсылка); 
	ЗаголовокТабДок.Параметры.ДатаРеализации  = ?(ЗначениеЗаполнено(Реализация), Реализация.Дата,"");
	ЗаголовокТабДок.Параметры.НомерРеализации = ?(ЗначениеЗаполнено(Реализация), Реализация.Номер,"");

	ТабДокумент.Вывести(ЗаголовокТабДок);
	
	МодельЗаказчик = Макет.ПолучитьОбласть("МодельЗаказчик");
	МодельЗаказчик.Параметры.Модель = ЗаказСсылка.Автомобиль.Модель;
	МодельЗаказчик.Параметры.VIN = ЗаказСсылка.Автомобиль.VIN;
	МодельЗаказчик.Параметры.ГосНомер= Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЗаказСсылка.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	МодельЗаказчик.Параметры.Заказчик = ЗаказСсылка.Контрагент.НаименованиеПолное;
	ТабДокумент.Вывести(МодельЗаказчик);
	
	ТаблицаЗапчастиШапка = Макет.ПолучитьОбласть("ТаблицаЗапчастиШапка");
	ТабДокумент.Вывести(ТаблицаЗапчастиШапка);
	
	ТаблицаЗапчасти = Макет.ПолучитьОбласть("ТаблицаЗапчасти");

	ТоварыТаблица = ПолучитьТоварыДляПечати(ЗаказСсылка);

	//выводить в цикле
	НомерПоПорядку = 1;
	СуммаИтоговая = 0;
	СуммаНДС = 0;
	СуммаСоСкидкой = 0;
	Для каждого Выборка Из ТоварыТаблица Цикл
		ТаблицаЗапчасти.Параметры.Номер             = НомерПоПорядку;
		ТаблицаЗапчасти.Параметры.Запчасть          = ПолучитьНаименование(Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры);
		ТаблицаЗапчасти.Параметры.ЕдиницаИзмерения  = Выборка.ЕдиницаИзмерения;
		ТаблицаЗапчасти.Параметры.Колво             = Выборка.ЗаказаноПриход;
		ТаблицаЗапчасти.Параметры.Цена              = Выборка.Цена;
		
		СуммаБезСкидки = Выборка.СуммаПриход + Выборка.РезультирующаяСкидкаСумма;
		ТаблицаЗапчасти.Параметры.Сумма             = СуммаБезСкидки;
		СуммаИтоговая  = СуммаИтоговая + СуммаБезСкидки;
		СуммаСоСкидкой = СуммаСоСкидкой + Выборка.СуммаПриход;
		ТабДокумент.Вывести(ТаблицаЗапчасти);
		НомерПоПорядку = НомерПоПорядку+1;
	КонецЦикла;
	
	СкидкаИтоговая = СуммаИтоговая  - СуммаСоСкидкой; 
	ИтогоТаблица = Макет.ПолучитьОбласть("ИтогоТаблица");
	ИтогоТаблица.Параметры.ИтогоСумма               = СуммаИтоговая;
	ТабДокумент.Вывести(ИтогоТаблица);
	
	Если СкидкаИтоговая <> 0 тогда
		СтрокаСоСкидкой = Макет.ПолучитьОбласть("СтрокаСкидка");
		СтрокаСоСкидкой.Параметры.ИтогоСкидка       = СкидкаИтоговая;
		ТабДокумент.Вывести(СтрокаСоСкидкой);	
	КонецЕсли;	
	
	//расчитаем как общее от всей суммы
	ИтогНДС = Макет.ПолучитьОбласть("ИтогНДС");
	СуммаНДСОтОбщего = 0;
	Если Не ЗаказСсылка.Организация.ОсвобожденОтНДС Тогда
		// Трояновский К.Е. 15.02.2019 12:24:04 {
		// Закомментировано по DMSCOR-1087
		//Если ЗаказСсылка.Дата >= '20190101' Тогда
		//	СуммаНДСОтОбщего = СуммаСоСкидкой *20/120;
		//Иначе
		//	СуммаНДСОтОбщего = СуммаСоСкидкой *18/118;
		//КонецЕсли;
		СуммаНДСОтОбщего = СуммаСоСкидкой * Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка / (100 + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка);
		// Трояновский К.Е. 15.02.2019 12:24:04 }
	КонецЕсли;
    ИтогНДС.Параметры.ИтогоСуммаНДС                 = СуммаНДСОтОбщего;
	ТабДокумент.Вывести(ИтогНДС);
	
	ФормСтрока = "Л = ru_RU; ДП = ЛОЖЬ";
	ПарПредмета="рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	
	Если СкидкаИтоговая <> 0 тогда
		ИтогоСоСкидкой = Макет.ПолучитьОбласть("ИтогоСоСкидкой");
		ИтогоСоСкидкой.Параметры.ИтогоСоСкидкой     = СуммаСоСкидкой;
		ТабДокумент.Вывести(ИтогоСоСкидкой);
		СоСкидкойПрописью = Макет.ПолучитьОбласть("СоСкидкойПрописью");
		СуммаСкидкаПропись  = ЧислоПрописью(СуммаСоСкидкой,ФормСтрока, ПарПредмета);
		СоСкидкойПрописью.Параметры.СуммаСкидкаПрописью = СуммаСкидкаПропись;
		ТабДокумент.Вывести(СоСкидкойПрописью);
	Иначе
		Итого = Макет.ПолучитьОбласть("Итого");
		Итого.Параметры.ИтогоСумма                  = СуммаИтоговая;
		ТабДокумент.Вывести(Итого);
		БезСкидкиПрописью = Макет.ПолучитьОбласть("БезСкидкиПрописью");
		БезСкидкиПропись  =ЧислоПрописью(СуммаИтоговая,ФормСтрока, ПарПредмета);
		БезСкидкиПрописью.Параметры.СуммаПрописью = БезСкидкиПропись;
		ТабДокумент.Вывести(БезСкидкиПрописью);
	КонецЕсли;	
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Ответственный                  = ВРег(ЗаказСсылка.Автор.Наименование);
	ТабДокумент.Вывести(Подвал);
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ПолеСлева = 0;
	ТабДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабДокумент;
	
КонецФункции // ПечатьТоварныйЧек()

Функция ПолучитьШтрихКод(ПечатнаяФормаДокумента, СсылкаНаОбъект)
	ШтрихКод = Renault_Advanced_ШтрихкодированиеДокументов.Renault_ПрочитатьШтрихКод(СсылкаНаОбъект);
	Если НЕ ЗначениеЗаполнено(ШтрихКод) Тогда
		Попытка
			ШтрихКод = Renault_Advanced_ШтрихкодированиеДокументов.Renault_ЗаписатьШтрихКод(СсылкаНаОбъект);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ШтрихКод) Тогда Возврат Новый ТабличныйДокумент; КонецЕсли;
	
	//ТипКода = Renault_Advanced_ШтрихкодированиеДокументов.ПолучитьЗначениеТипаШтрихкодаДляЭУ(ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13);
	ТипКода = 1;
    
	Попытка 
		КомпонентШК = Новый COMОбъект("V8.Barcod"); 
	Исключение Сообщить("Компонента 1С:Печать штрихкодов не установлена на данном компьютере!", СтатусСообщения.Важное);
		Возврат КомпонентШК; 
	КонецПопытки; 
	
	ПечатнаяФормаДокумента.Рисунки.ШтрихКод.Объект.ТипКода   = ТипКода;
	ПечатнаяФормаДокумента.Рисунки.ШтрихКод.Объект.Сообщение = ШтрихКод;

КонецФункции

Процедура ВывестиВМакетНеоплаченныеЗаказНаряды(Макет, ТабДокумент, СсылкаНаОбъект)
	
	Таблица = ПолучитьНеоплаченныеЗаказы(СсылкаНаОбъект.Автомобиль, СсылкаНаОбъект);	
	Если Таблица.Количество() > 0 Тогда 
		ОбластьНеоплаченныеЗН = Макет.ПолучитьОбласть("НеоплаченныеЗаказНаряды");
		ТабДокумент.Вывести(ОбластьНеоплаченныеЗН);
		
		Для каждого Выборка Из Таблица Цикл
			ОбластьТаблицаЗН = Макет.ПолучитьОбласть("ТаблицаЗаказНаряды");
			ОбластьТаблицаЗН.Параметры.Заполнить(Выборка);
			ТабДокумент.Вывести(ОбластьТаблицаЗН);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецЕсли