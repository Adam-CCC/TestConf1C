// Функция - Получить статусы запчастей
//
// Параметры:
//  Строки	 - Массив - Строки ТЧ по которым необходимо получить статусы
// 
// Возвращаемое значение:
//   - Таблица значений
//
Функция ПолучитьСтатусыЗапчастей(Заказ, Строки = Неопределено, ТоварыТЗ = Неопределено) Экспорт

	Если ТоварыТЗ = Неопределено Тогда
		ТоварыТЗ = Заказ.Товары.Выгрузить();
	КонецЕсли;
	
	Если Строки = Неопределено Тогда
		ТаблицаДляЗапроса = ТоварыТЗ.Скопировать(, "НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, Коэффициент, Количество, СуммаВсего");
	Иначе	
		ТаблицаДляЗапроса = ТоварыТЗ.Скопировать(Строки, "НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, Коэффициент, Количество, СуммаВсего");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаСтатусыЗапчастей());
	
	Запрос.УстановитьПараметр("ТоварыТЗ", ТаблицаДляЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Заказ.Контрагент);
	Запрос.УстановитьПараметр("ЗаказПокупателя", Заказ);
	Запрос.УстановитьПараметр("СкладКомпании", Заказ.СкладКомпании);
	Запрос.УстановитьПараметр("СкладРеализации", Заказ.Renault_Advanced_СкладРеализации);
	
	ТипЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	
	СтатусыЗапчастей = Запрос.Выполнить().Выгрузить();
	
	//КешСтатусыЗапчастей = СтатусыЗапчастей;
	
	Возврат СтатусыЗапчастей;

КонецФункции // ПолучитьСтатусыЗапчастей()

Функция ТекстЗапросаСтатусыЗапчастей()

	Возврат
	"ВЫБРАТЬ
	|	ЗаказПокупателяТовары.НомерСтроки,
	|	ЗаказПокупателяТовары.Номенклатура,
	|	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	|	ЗаказПокупателяТовары.Количество * ЗаказПокупателяТовары.Коэффициент КАК Количество,
	|	ЗаказПокупателяТовары.Коэффициент,
	|	ЗаказПокупателяТовары.СуммаВсего
	|ПОМЕСТИТЬ ВТ_ТоварыПодготовка
	|ИЗ
	|	&ТоварыТЗ КАК ЗаказПокупателяТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыПодготовка.НомерСтроки,
	|	ВТ_ТоварыПодготовка.Номенклатура КАК Номенклатура,
	|	ВТ_ТоварыПодготовка.ХарактеристикаНоменклатуры,
	|	МАКСИМУМ(ВТ_ТоварыПодготовка.Количество) КАК Количество,
	|	СУММА(ЕСТЬNULL(ВТ_ТоварыПодготовкаДО.Количество, 0)) КАК КоличествоДО,
	|	ВТ_ТоварыПодготовка.Коэффициент,
	|	МАКСИМУМ(ВТ_ТоварыПодготовка.СуммаВсего) КАК СуммаВсего
	|ПОМЕСТИТЬ ВТ_ТоварыПодготовкаДО
	|ИЗ
	|	ВТ_ТоварыПодготовка КАК ВТ_ТоварыПодготовка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварыПодготовка КАК ВТ_ТоварыПодготовкаДО
	|		ПО ВТ_ТоварыПодготовка.Номенклатура = ВТ_ТоварыПодготовкаДО.Номенклатура
	|			И ВТ_ТоварыПодготовка.ХарактеристикаНоменклатуры = ВТ_ТоварыПодготовкаДО.ХарактеристикаНоменклатуры
	|			И ВТ_ТоварыПодготовка.НомерСтроки > ВТ_ТоварыПодготовкаДО.НомерСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТоварыПодготовка.НомерСтроки,
	|	ВТ_ТоварыПодготовка.Номенклатура,
	|	ВТ_ТоварыПодготовка.ХарактеристикаНоменклатуры,
	|	ВТ_ТоварыПодготовка.Коэффициент
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.НомерСтроки,
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВТ_Товары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	МАКСИМУМ(ВТ_Товары.Количество) КАК Количество,
	|	МАКСИМУМ(ВТ_Товары.КоличествоДО) КАК КоличествоДО,
	|	МАКСИМУМ(ЕСТЬNULL(ВТ_ТоварыПОСЛЕ.Количество, 0)) КАК КоличествоПОСЛЕ,
	|	ВТ_Товары.Коэффициент,
	|	СУММА(ВТ_Товары.СуммаВсего) КАК СуммаВсего
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	ВТ_ТоварыПодготовкаДО КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварыПодготовкаДО КАК ВТ_ТоварыПОСЛЕ
	|		ПО ВТ_Товары.Номенклатура = ВТ_ТоварыПОСЛЕ.Номенклатура
	|			И ВТ_Товары.ХарактеристикаНоменклатуры = ВТ_ТоварыПОСЛЕ.ХарактеристикаНоменклатуры
	|			И ВТ_Товары.НомерСтроки < ВТ_ТоварыПОСЛЕ.НомерСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Товары.НомерСтроки,
	|	ВТ_Товары.Номенклатура,
	|	ВТ_Товары.ХарактеристикаНоменклатуры,
	|	ВТ_Товары.Коэффициент
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыРаспределениеОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыРаспределениеОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	ЗаказыРаспределениеОстатки.КоличествоОстаток КАК Заказано
	|ПОМЕСТИТЬ ВТ_ЗаказаноПоставщику
	|ИЗ
	|	РегистрНакопления.ЗаказыРаспределение.Остатки(
	|			,
	|			ЗаказПокупателя = &ЗаказПокупателя
	|				И ЗаказПоставщика ССЫЛКА Документ.ЗаказПоставщику
	|				И (Номенклатура, ХарактеристикаНоменклатуры) В
	|					(ВЫБРАТЬ
	|						ВТ_Товары.Номенклатура,
	|						ВТ_Товары.ХарактеристикаНоменклатуры
	|					ИЗ
	|						ВТ_Товары КАК ВТ_Товары)) КАК ЗаказыРаспределениеОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
