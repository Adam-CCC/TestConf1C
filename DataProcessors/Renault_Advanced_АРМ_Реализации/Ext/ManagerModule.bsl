
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ПолучитьФормуДокумента(ИмяФормы, ВладелецФорма) Экспорт
	Возврат ПолучитьФорму(ИмяФормы, ВладелецФорма);	
КонецФункции

Процедура ОткрытьФормуАРМ(Знач Заказ) Экспорт

	Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Заказ = Заказ.ПолучитьОбъект();
	ИначеЕсли ТипЗнч(Заказ) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
	Иначе
		Сообщить("Не удалось открыть форму АРМ Реализации");
		Возврат;
	КонецЕсли;	

	ФормаАРМ = ПолучитьФормуДокумента("ФормаДокумента", Неопределено);
	ФормаАРМ.ДокументОбъект = Заказ;
	ФормаАРМ.Открыть();
	
КонецПроцедуры

Функция ПолучитьТоварыСУчетомКорректировок(ЗаказСсылка,Аннулирован=Ложь,УчитыватьАннулирование=Истина) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Контрагент", ЗаказСсылка.Контрагент);
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	Запрос.УстановитьПараметр("СкладКомпании", ЗаказСсылка.СкладКомпании);
	Запрос.УстановитьПараметр("Аннулирован", Аннулирован);
	Запрос.УстановитьПараметр("УчитыватьАннулирование", УчитыватьАннулирование);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыПокупателейОбороты.Номенклатура КАК Номенклатура,
	               |	ЗаказыПокупателейОбороты.ХарактеристикаНоменклатуры,
	               |	СУММА(ЗаказыПокупателейОбороты.ЗаказаноПриход) КАК ЗаказаноПриход,
	               |	СУММА(ЗаказыПокупателейОбороты.СуммаУпрПриход) КАК СуммаУпрПриход,
	               |	СУММА(ЗаказыПокупателейОбороты.СуммаПриход) КАК СуммаПриход
	               |ПОМЕСТИТЬ ВТ_Заказы
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПокупателей.Обороты(
	               |			,
	               |			,
	               |			Регистратор,
	               |			Контрагент = &Контрагент
	               |				И Заказ = &Заказ
	               |				И СкладКомпании = &СкладКомпании) КАК ЗаказыПокупателейОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыПокупателейОбороты.Номенклатура,
	               |	ЗаказыПокупателейОбороты.ХарактеристикаНоменклатуры
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателей.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	               |			ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателей.Регистратор КАК Документ.ЗаказПокупателя)
	               |		КОГДА ЗаказыПокупателей.Регистратор ССЫЛКА Документ.КорректировкаЗаказаПокупателя
	               |			ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателей.Регистратор КАК Документ.КорректировкаЗаказаПокупателя)
	               |	КОНЕЦ КАК Регистратор,
	               |	ЗаказыПокупателей.Регистратор.МоментВремени
	               |ПОМЕСТИТЬ ВТ_Регистраторы
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	               |ГДЕ
	               |	(ЗаказыПокупателей.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	               |			ИЛИ ЗаказыПокупателей.Регистратор ССЫЛКА Документ.КорректировкаЗаказаПокупателя)
	               |	И ЗаказыПокупателей.Заказ = &Заказ
	               |	И ЗаказыПокупателей.СкладКомпании = &СкладКомпании
	               |	И ЗаказыПокупателей.Контрагент = &Контрагент
	               |	И (ЗаказыПокупателей.Номенклатура, ЗаказыПокупателей.ХарактеристикаНоменклатуры) В
	               |			(ВЫБРАТЬ
	               |				ВТ_Заказы.Номенклатура,
	               |				ВТ_Заказы.ХарактеристикаНоменклатуры
	               |			ИЗ
	               |				ВТ_Заказы КАК ВТ_Заказы)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыПокупателей.Регистратор,
	               |	ЗаказыПокупателей.Регистратор.МоментВремени
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Регистраторы.Регистратор,
	               |	СУММА(ВЫБОР
	               |			КОГДА ВТ_РегистраторыПОСЛЕ.Регистратор ЕСТЬ NULL 
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) КАК КолвоПОСЛЕ
	               |ПОМЕСТИТЬ ВТ_РегистраторыПодготовка
	               |ИЗ
	               |	ВТ_Регистраторы КАК ВТ_Регистраторы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Регистраторы КАК ВТ_РегистраторыПОСЛЕ
	               |		ПО ВТ_Регистраторы.РегистраторМоментВремени < ВТ_РегистраторыПОСЛЕ.РегистраторМоментВремени
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Регистраторы.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоследнийРегистратор.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ ВТ_ПоследнийРегистратор
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_РегистраторыПодготовка.Регистратор КАК Регистратор
	               |	ИЗ
	               |		ВТ_РегистраторыПодготовка КАК ВТ_РегистраторыПодготовка
	               |	ГДЕ
	               |		ВЫБОР
	               |				КОГДА &Аннулирован
	               |						И &УчитыватьАннулирование
	               |					ТОГДА ВТ_РегистраторыПодготовка.КолвоПОСЛЕ = 0
	               |				КОГДА &Аннулирован
	               |						И НЕ &УчитыватьАннулирование
	               |					ТОГДА ВТ_РегистраторыПодготовка.КолвоПОСЛЕ = 1
	               |				ИНАЧЕ ВТ_РегистраторыПодготовка.КолвоПОСЛЕ = 0
	               |			КОНЕЦ) КАК ПоследнийРегистратор
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ПоследнийРегистратор.Регистратор КАК Документ,
	               |	ЗаказПокупателяТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказПокупателяТовары.ХарактеристикаНоменклатуры,
	               |	ЗаказПокупателяТовары.СтавкаНДС,
	               |	ЗаказПокупателяТовары.Цена КАК Цена,
	               |	ЗаказПокупателяТовары.ПроцентСкидкиСтроки + ЗаказПокупателяТовары.ПроцентСкидки + ЗаказПокупателяТовары.Renault_advanced_ПроцентРучнойСкидки КАК РезультирующаяСкидка,
	               |	ЗаказПокупателяТовары.СуммаСкидки + ЗаказПокупателяТовары.СуммаСкидкиСтроки + ЗаказПокупателяТовары.Renault_advanced_СуммаРучнойСкидки КАК РезультирующаяСкидкаСумма,
	               |	ЗаказПокупателяТовары.ПроцентСкидки,
	               |	ЗаказПокупателяТовары.СуммаСкидки,
	               |	ЗаказПокупателяТовары.ПроцентСкидкиСтроки,
	               |	ЗаказПокупателяТовары.СуммаСкидкиСтроки,
	               |	ЗаказПокупателяТовары.СкидкаНаТовар,
	               |	ЗаказПокупателяТовары.Renault_advanced_ПроцентРучнойСкидки,
	               |	ЗаказПокупателяТовары.Renault_advanced_СуммаРучнойСкидки,
	               |	ЗаказПокупателяТовары.СуммаНДС,
	               |	ЗаказПокупателяТовары.СуммаВсего,
	               |	ЗаказПокупателяТовары.Количество,
	               |	ЗаказПокупателяТовары.Сумма,
	               |	ЗаказПокупателяТовары.НомерСтроки
	               |ПОМЕСТИТЬ ВТ_ТЧПоследнийРегистратор
	               |ИЗ
	               |	ВТ_ПоследнийРегистратор КАК ВТ_ПоследнийРегистратор
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
	               |		ПО ВТ_ПоследнийРегистратор.Регистратор = ЗаказПокупателяТовары.Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_ПоследнийРегистратор.Регистратор,
	               |	КорректировкаЗаказаПокупателяТовары.Номенклатура,
	               |	КорректировкаЗаказаПокупателяТовары.ХарактеристикаНоменклатуры,
	               |	КорректировкаЗаказаПокупателяТовары.СтавкаНДС,
	               |	КорректировкаЗаказаПокупателяТовары.Цена,
	               |	КорректировкаЗаказаПокупателяТовары.ПроцентСкидкиСтроки + КорректировкаЗаказаПокупателяТовары.ПроцентСкидки + КорректировкаЗаказаПокупателяТовары.Renault_Advanced_ПроцентРучнойСкидки,
	               |	КорректировкаЗаказаПокупателяТовары.СуммаСкидки + КорректировкаЗаказаПокупателяТовары.СуммаСкидкиСтроки + КорректировкаЗаказаПокупателяТовары.Renault_Advanced_СуммаРучнойСкидки,
	               |	КорректировкаЗаказаПокупателяТовары.ПроцентСкидки,
	               |	КорректировкаЗаказаПокупателяТовары.СуммаСкидки,
	               |	КорректировкаЗаказаПокупателяТовары.ПроцентСкидкиСтроки,
	               |	КорректировкаЗаказаПокупателяТовары.СуммаСкидкиСтроки,
	               |	КорректировкаЗаказаПокупателяТовары.СкидкаНаТовар,
	               |	КорректировкаЗаказаПокупателяТовары.Renault_Advanced_ПроцентРучнойСкидки,
	               |	КорректировкаЗаказаПокупателяТовары.Renault_Advanced_СуммаРучнойСкидки,
	               |	КорректировкаЗаказаПокупателяТовары.СуммаНДС,
	               |	КорректировкаЗаказаПокупателяТовары.СуммаВсего,
	               |	КорректировкаЗаказаПокупателяТовары.Количество,
	               |	КорректировкаЗаказаПокупателяТовары.Сумма,
	               |	КорректировкаЗаказаПокупателяТовары.НомерСтроки
	               |ИЗ
	               |	ВТ_ПоследнийРегистратор КАК ВТ_ПоследнийРегистратор
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаЗаказаПокупателя.Товары КАК КорректировкаЗаказаПокупателяТовары
	               |		ПО ВТ_ПоследнийРегистратор.Регистратор = КорректировкаЗаказаПокупателяТовары.Ссылка
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ТЧПоследнийРегистратор.Номенклатура,
	               |	ВТ_ТЧПоследнийРегистратор.ХарактеристикаНоменклатуры,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.СтавкаНДС, ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ОсновнаяСтавкаНДС)) КАК СтавкаНДС,
	               |	ВТ_Заказы.ЗаказаноПриход,
	               |	ВТ_Заказы.СуммаУпрПриход КАК СуммаУпр,
	               |	спрНоменклатура.ОсновнаяЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВЫБОР
	               |		КОГДА ЕдиницыИзмерения.Коэффициент ЕСТЬ NULL 
	               |				ИЛИ ЕдиницыИзмерения.Коэффициент = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ЕдиницыИзмерения.Коэффициент
	               |	КОНЕЦ КАК Коэффициент,
	               |	спрНоменклатура.Артикул,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.Цена, 0) КАК Цена,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.РезультирующаяСкидка, 0) КАК РезультирующаяСкидка,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.РезультирующаяСкидкаСумма, 0) КАК РезультирующаяСкидкаСумма,
	               |	ВТ_Заказы.СуммаПриход,
	               |	спрНоменклатура.Наименование КАК НоменклатураНаименование,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.ПроцентСкидки, 0) КАК ПроцентСкидки,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.СуммаСкидки, 0) КАК СуммаСкидки,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.ПроцентСкидкиСтроки, 0) КАК ПроцентСкидкиСтроки,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.СуммаСкидкиСтроки, 0) КАК СуммаСкидкиСтроки,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.СкидкаНаТовар, ЗНАЧЕНИЕ(Справочник.ТипыСкидок.ПустаяСсылка)) КАК СкидкаНаТовар,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.Renault_advanced_ПроцентРучнойСкидки, 0) КАК Renault_advanced_ПроцентРучнойСкидки,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.Renault_advanced_СуммаРучнойСкидки, 0) КАК Renault_advanced_СуммаРучнойСкидки,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.СуммаНДС, 0) КАК СуммаНДС,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.СуммаВсего, 0) КАК СуммаВсего,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.Количество, 0) КАК Количество,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.Сумма, 0) КАК Сумма,
	               |	ЕСТЬNULL(ВТ_ТЧПоследнийРегистратор.НомерСтроки, 0) КАК НомерСтроки
	               |ИЗ
	               |	ВТ_ТЧПоследнийРегистратор КАК ВТ_ТЧПоследнийРегистратор
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	               |			ПО спрНоменклатура.ОсновнаяЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	               |		ПО ВТ_ТЧПоследнийРегистратор.Номенклатура = спрНоменклатура.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
	               |		ПО ВТ_ТЧПоследнийРегистратор.Номенклатура = ВТ_Заказы.Номенклатура
	               |			И ВТ_ТЧПоследнийРегистратор.ХарактеристикаНоменклатуры = ВТ_Заказы.ХарактеристикаНоменклатуры
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ВТ_ТЧПоследнийРегистратор.Документ ССЫЛКА Документ.КорректировкаЗаказаПокупателя
	               |				ТОГДА ВТ_ТЧПоследнийРегистратор.Количество <> 0
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";

	Возврат Запрос.Выполнить().Выгрузить();			   
				   
КонецФункции

Функция ПолучитьТоварыДляПечати(ЗаказСсылка) Экспорт

	Если ЗаказСсылка.Проведен И ЕстьКорректировки(ЗаказСсылка) Тогда
		Возврат ПолучитьТоварыСУчетомКорректировок(ЗаказСсылка);	
	Иначе 	
		// Берем товары из ТЧ
		// Возвращаем таблицу с идентичными полями как в первом условии
		
		ТаблицаТовары = Новый ТаблицаЗначений;
		ТаблицаТовары.Колонки.Добавить("Номенклатура");
		ТаблицаТовары.Колонки.Добавить("ХарактеристикаНоменклатуры");
		ТаблицаТовары.Колонки.Добавить("СтавкаНДС");
		ТаблицаТовары.Колонки.Добавить("ЗаказаноПриход");
		ТаблицаТовары.Колонки.Добавить("СуммаУпр");
		ТаблицаТовары.Колонки.Добавить("ЕдиницаИзмерения");
		ТаблицаТовары.Колонки.Добавить("Коэффициент");
		ТаблицаТовары.Колонки.Добавить("Артикул");
		ТаблицаТовары.Колонки.Добавить("Цена");
		ТаблицаТовары.Колонки.Добавить("РезультирующаяСкидка");
		ТаблицаТовары.Колонки.Добавить("РезультирующаяСкидкаСумма");
		ТаблицаТовары.Колонки.Добавить("СуммаПриход");
		ТаблицаТовары.Колонки.Добавить("НоменклатураНаименование");
		
		Для каждого СтрокаТовары Из ЗаказСсылка.Товары Цикл
			НС = ТаблицаТовары.Добавить();
			ЗаполнитьЗначенияСвойств(НС, СтрокаТовары);
			НС.Артикул = СтрокаТовары.Номенклатура.Артикул;
			НС.НоменклатураНаименование = СтрокаТовары.Номенклатура.Наименование;
			НС.ЗаказаноПриход = СтрокаТовары.Количество * СтрокаТовары.Коэффициент;
			НС.СуммаПриход = СтрокаТовары.СуммаВсего;
			НС.РезультирующаяСкидка = СтрокаТовары.ПроцентСкидки + СтрокаТовары.ПроцентСкидкиСтроки + СтрокаТовары.Renault_advanced_ПроцентРучнойСкидки;
			НС.РезультирующаяСкидкаСумма = СтрокаТовары.СуммаСкидки + СтрокаТовары.СуммаСкидкиСтроки + СтрокаТовары.Renault_advanced_СуммаРучнойСкидки;
		КонецЦикла;
		
		Возврат ТаблицаТовары;
	КонецЕсли;

КонецФункции // ПолучитьТоварыДляПечати()

Функция ЕстьКорректировки(ЗаказСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Корректировка.Ссылка
	               |ИЗ
	               |	Документ.КорректировкаЗаказаПокупателя КАК Корректировка
	               |ГДЕ
	               |	Корректировка.ДокументОснование = &Заказ
	               |	И Корректировка.Проведен";
	
	Результат = Запрос.Выполнить();
	Возврат ?(Результат.Пустой(), Ложь, Истина);

КонецФункции 

// Функция - Получить оплачено
//
// Параметры:
//  Заказ			 - 	ДокументСсылка - заказ-наряд или заказ покупателя
//  ЗаказПокупателя	 - 	ДокументСсылка - заказ покупателя
// 
// Возвращаемое значение:
//   - Число
//
Функция ПолучитьОплачено(Заказ, ЗаказПокупателя) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Renault_Advanced_СформированныеДокументы.Документ КАК Документ
	                      |ПОМЕСТИТЬ Сделки
	                      |ИЗ
	                      |	РегистрСведений.Renault_Advanced_СформированныеДокументы КАК Renault_Advanced_СформированныеДокументы
	                      |ГДЕ
	                      |	Renault_Advanced_СформированныеДокументы.ЗаказНаряд = &Заказ
	                      |	И Renault_Advanced_СформированныеДокументы.Документ ССЫЛКА Документ.РеализацияТоваров
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ
	                      |	&ЗаказПокупателя
	                      |
	                      |ОБЪЕДИНИТЬ
	                      |
	                      |ВЫБРАТЬ
	                      |	&Заказ
	                      |
	                      |ИНДЕКСИРОВАТЬ ПО
	                      |	Документ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВзаиморасчетыКомпании.Регистратор КАК Регистратор,
	                      |	ВзаиморасчетыКомпании.Сумма КАК Сумма
	                      |ПОМЕСТИТЬ Регистраторы
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчетыКомпании КАК ВзаиморасчетыКомпании
	                      |ГДЕ
	                      |	ВзаиморасчетыКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |	И ВзаиморасчетыКомпании.Контрагент = &Контрагент
	                      |	И ВзаиморасчетыКомпании.ДоговорВзаиморасчетов = &ДоговорВзаиморасчетов
	                      |	И ВзаиморасчетыКомпании.Сделка В
	                      |			(ВЫБРАТЬ
	                      |				Сделки.Документ
	                      |			ИЗ
	                      |				Сделки КАК Сделки)
	                      |
	                      |ИНДЕКСИРОВАТЬ ПО
	                      |	Регистратор
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Регистраторы.Регистратор,
	                      |	Регистраторы.Сумма
	                      |ПОМЕСТИТЬ Подготовка
	                      |ИЗ
	                      |	Регистраторы КАК Регистраторы
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	                      |		ПО Регистраторы.Регистратор = ПриходныйКассовыйОрдер.Ссылка
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Регистраторы.Регистратор,
	                      |	Регистраторы.Сумма
	                      |ИЗ
	                      |	Регистраторы КАК Регистраторы
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Выписка КАК Выписка
	                      |		ПО Регистраторы.Регистратор = Выписка.Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	СУММА(Подготовка.Сумма) КАК Сумма
	                      |ИЗ
	                      |	Подготовка КАК Подготовка");
						  
	Запрос.УстановитьПараметр("Контрагент", ЗаказПокупателя.Контрагент);
	Запрос.УстановитьПараметр("ДоговорВзаиморасчетов", ЗаказПокупателя.ДоговорВзаиморасчетов);
	Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Оплачено = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
	Иначе
		Оплачено = 0;
	КонецЕсли;
	
	Возврат Оплачено;

КонецФункции // ПолучитьОплачено()

// Функция - Получить неоплаченные заказы
//
// Параметры:
//  Автомобиль		 - СправочникСсылка	 - автомобиль
//  ЗаказИсключение	 - ДокументСсылка	 - если указан, получим все не оплаченные кроме этого
// 
// Возвращаемое значение:
//   - ТаблицаЗначений
//
Функция ПолучитьНеоплаченныеЗаказы(Автомобиль, ЗаказИсключение = Неопределено) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(ЗаказыПокупателейОбороты.Заказ КАК Документ.ЗаказПокупателя) КАК Заказ,
	                      |	ЗаказыПокупателейОбороты.СуммаПриход КАК СуммаЗН
	                      |ПОМЕСТИТЬ Заказы
	                      |ИЗ
	                      |	РегистрНакопления.ЗаказыПокупателей.Обороты(
	                      |			,
	                      |			,
	                      |			,
	                      |			Заказ ССЫЛКА Документ.ЗаказПокупателя
	                      |				И ВЫРАЗИТЬ(Заказ КАК Документ.ЗаказПокупателя).Автомобиль = &Автомобиль
	                      |				И (&ВсеЗаказы
	                      |					ИЛИ Заказ <> &ТекЗаказНаряд)) КАК ЗаказыПокупателейОбороты
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	ДокЗаказНаряд.Ссылка,
	                      |	ДокЗаказНаряд.СуммаДокумента
	                      |ИЗ
						  |     Документ.ЗаказНаряд КАК ДокЗАказНаряд
	                      |	ГДЕ (ДокЗАказНаряд.DMS_СтатусЗаказНаряда <> ЗНАЧЕНИЕ(Справочник.Renault_Advanced_СтатусыЗаказНарядов.Закрыт))
	                      |			И (ДокЗАказНаряд.DMS_СтатусЗаказНаряда <> ЗНАЧЕНИЕ(Справочник.Renault_Advanced_СтатусыЗаказНарядов.Аннулирован))
	                      |			И (ДокЗАказНаряд.DMS_Обслуживание = ЗНАЧЕНИЕ(Справочник.Renault_Advanced_ТипыОбслуживания.Клиентский))
	                      |			И (ДокЗаказНаряд.Автомобиль = &Автомобиль)
	                      |			И (&ВсеЗаказы
	                      |				ИЛИ ДокЗаказНаряд.Ссылка <> &ТекЗаказНаряд)
	                      |
	                      |ИНДЕКСИРОВАТЬ ПО
	                      |	Заказ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВЫРАЗИТЬ(Renault_Advanced_СформированныеДокументы.ЗаказНаряд КАК Документ.ЗаказПокупателя) КАК Заказ,
	                      |	ВЫРАЗИТЬ(Renault_Advanced_СформированныеДокументы.Документ КАК Документ.РеализацияТоваров).Контрагент КАК Контрагент,
	                      |	ВЫРАЗИТЬ(Renault_Advanced_СформированныеДокументы.Документ КАК Документ.РеализацияТоваров).ДоговорВзаиморасчетов КАК Договор,
	                      |	Renault_Advanced_СформированныеДокументы.Документ КАК Сделка,
	                      |	Заказы.СуммаЗН
	                      |ПОМЕСТИТЬ Сделки
	                      |ИЗ
	                      |	РегистрСведений.Renault_Advanced_СформированныеДокументы КАК Renault_Advanced_СформированныеДокументы
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заказы КАК Заказы
	                      |		ПО Renault_Advanced_СформированныеДокументы.ЗаказНаряд = Заказы.Заказ
	                      |ГДЕ
	                      |	Renault_Advanced_СформированныеДокументы.ЗаказНаряд В
	                      |			(ВЫБРАТЬ
	                      |				Заказы.Заказ
	                      |			ИЗ
	                      |				Заказы КАК Заказы)
	                      |	И Renault_Advanced_СформированныеДокументы.Документ ССЫЛКА Документ.РеализацияТоваров
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	Заказы.Заказ,
	                      |	Заказы.Заказ.Контрагент,
	                      |	Заказы.Заказ.ДоговорВзаиморасчетов,
	                      |	Заказы.Заказ,
	                      |	Заказы.СуммаЗН
	                      |ИЗ
	                      |	Заказы КАК Заказы
	                      |
	                      |ИНДЕКСИРОВАТЬ ПО
	                      |	Сделка,
	                      |	Контрагент,
	                      |	Договор
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ВзаиморасчетыКомпании.Сделка КАК Сделка,
	                      |	СУММА(ВзаиморасчетыКомпании.Сумма) КАК Оплачено
	                      |ПОМЕСТИТЬ Оплачено
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчетыКомпании КАК ВзаиморасчетыКомпании
	                      |ГДЕ
	                      |	(ВзаиморасчетыКомпании.Контрагент, ВзаиморасчетыКомпании.ДоговорВзаиморасчетов, ВзаиморасчетыКомпании.Сделка) В
	                      |			(ВЫБРАТЬ
	                      |				Сделки.Контрагент,
	                      |				Сделки.Договор,
	                      |				Сделки.Сделка
	                      |			ИЗ
	                      |				Сделки КАК Сделки)
	                      |	И ВзаиморасчетыКомпании.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВзаиморасчетыКомпании.Сделка
	                      |
	                      |ИНДЕКСИРОВАТЬ ПО
	                      |	Сделка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Сделки.Заказ,
	                      |	МАКСИМУМ(Сделки.СуммаЗН) КАК СуммаЗН,
	                      |	СУММА(ЕСТЬNULL(ВТОплачено.Оплачено, 0)) КАК Оплачено,
	                      |	Сделки.Заказ.Дата КАК Дата,
	                      |	Сделки.Заказ.Номер КАК НомерЗН,
	                      |	Сделки.Заказ.ПодразделениеКомпании КАК Подразделение,
	                      |	Сделки.Заказ КАК ЗаказПокупателя
	                      |ПОМЕСТИТЬ Итоговая
	                      |ИЗ
	                      |	Сделки КАК Сделки
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Оплачено КАК ВТОплачено
	                      |		ПО Сделки.Сделка = ВТОплачено.Сделка
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Сделки.Заказ,
	                      |	Сделки.Заказ.Дата,
	                      |	Сделки.Заказ.Номер,
	                      |	Сделки.Заказ.ПодразделениеКомпании,
	                      |	Сделки.Заказ
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Итоговая.Заказ,
	                      |	Итоговая.СуммаЗН,
	                      |	Итоговая.Оплачено,
	                      |	Итоговая.Дата КАК Дата,
	                      |	Итоговая.НомерЗН,
	                      |	Итоговая.Подразделение,
	                      |	Итоговая.ЗаказПокупателя,
	                      |	Итоговая.СуммаЗН - Итоговая.Оплачено КАК Остаток
	                      |ИЗ
	                      |	Итоговая КАК Итоговая
	                      |ГДЕ
	                      |	Итоговая.СуммаЗН > Итоговая.Оплачено
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Дата");
						  
	ВсеЗаказы = ЗаказИсключение = Неопределено;
						  
	Запрос.УстановитьПараметр("ВсеЗаказы", ВсеЗаказы);
	Запрос.УстановитьПараметр("ТекЗаказНаряд", ?(ВсеЗаказы, Документы.ЗаказПокупателя.ПустаяСсылка(), ЗаказИсключение));
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьНеоплаченныеЗаказы()

Функция ПолучитьТелефонАдресКонтрагента(Контрагент) Экспорт

	 Запрос	= Новый Запрос;
	 Запрос.Текст	= 		
	 "ВЫБРАТЬ
	 |	КонтактнаяИнформация.Объект,
	 |	КонтактнаяИнформация.Тип,
	 |	КонтактнаяИнформация.Вид,
	 |	КонтактнаяИнформация.Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Объект = &Объект
	 |	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	 |				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонКонтактный)
	 |			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	 |				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))";

	 Запрос.УстановитьПараметр("Объект", Контрагент);
	 Выборка = Запрос.Выполнить().Выбрать();
	 
	 Пока Выборка.Следующий() цикл
		 Если Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон тогда
			 ТелефонКонтрагента = Выборка.Представление;
		 Иначе
			 АдресКонтрагента = Выборка.Представление;
		 КонецЕсли;
	 КонецЦикла;

	 Возврат Новый Структура("Телефон, Адрес", ТелефонКонтрагента, АдресКонтрагента);
	 
КонецФункции 

Функция ПолучитьТелефонАдресОрганизации(Организация) Экспорт

	 Запрос	= Новый Запрос;
	 Запрос.Текст	= 		
	 "ВЫБРАТЬ
	 |	КонтактнаяИнформация.Объект,
	 |	КонтактнаяИнформация.Тип,
	 |	КонтактнаяИнформация.Вид,
	 |	КонтактнаяИнформация.Представление
	 |ИЗ
	 |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	 |ГДЕ
	 |	КонтактнаяИнформация.Объект = &Объект
	 |	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	 |				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонРабочий)
	 |			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	 |				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))";
	 
	 Запрос.УстановитьПараметр("Объект", Организация);
	 Выборка = Запрос.Выполнить().Выбрать();
	 
	 Пока Выборка.Следующий() цикл
		 Если Выборка.Тип = перечисления.ТипыКонтактнойИнформации.Телефон тогда
			 ТелефонОрганизации = Выборка.Представление;
		 Иначе
			 АдресОрганизации = Выборка.Представление;
		 КонецЕсли;
	 КонецЦикла;

	 Возврат Новый Структура("Телефон, Адрес", ТелефонОрганизации, АдресОрганизации);
	 
КонецФункции // ПолучитьТелефонАдресОрганизации()

Функция ПолучитьКонтактныеЛицаКонтрагента(Контрагент) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Контрагенты.Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.ВедушийКонтрагент = &Контрагент
	               |	И Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ВидыКонтрагентов.КонтактноеЛицо)
	               |	И НЕ Контрагенты.ПометкаУдаления
	               |	И Контрагенты.ВидОтношений = ЗНАЧЕНИЕ(Справочник.ВидыВзаимоотношений.КонтактноеЛицо)
	               |	И Контрагенты.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)";
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат Список;

КонецФункции 

Функция ЗаполнитьДанныеПоАвтомобилю(Автомобиль, ТабличныйДокумент) Экспорт

	 АвтомобильПараметры = ТабличныйДокумент.Параметры;
	 АвтомобильПараметры.Пробег                               = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
	 АвтомобильПараметры.Модель                               = Автомобиль.Модель;
	 АвтомобильПараметры.Марка                                = Автомобиль.ВариантКомплектации;
	 АвтомобильПараметры.НомерДвигателя                       = ?(ЗначениеЗаполнено(Автомобиль.НомерДвигателя),Автомобиль.НомерДвигателя,"");
	 ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	 АвтомобильПараметры.ГосНомер                             = ?(ЗначениеЗаполнено(ГосНомер),ГосНомер,"");
	 АвтомобильПараметры.ГодВыпуска                           = ?(ЗначениеЗаполнено(Автомобиль.ГодВыпуска),Год(Автомобиль.ГодВыпуска),"");
	 АвтомобильПараметры.VIN		                             = ?(ЗначениеЗаполнено(Автомобиль.VIN),Автомобиль.VIN,"");
	 АвтомобильПараметры.ДатаПродажи                          = ?(ЗначениеЗаполнено(Автомобиль.ДатаНачалаГарантии),Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д"),"");

КонецФункции // ЗаполнитьДанныеПоАвтомобилю()

Функция ПолучитьОтветственныхПоОрганизации(Организация, РабочаяДата) Экспорт

	//Чтение значения для руководителя
	СтруктураОтбора=Новый Структура("Организация,Объект",Организация,Перечисления.ВидыОбъектовСведений.Руководитель);
	СтруктураСведений=РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(РабочаяДата,СтруктураОтбора);
	Руководитель=СтруктураСведений.Значение;
	//Чтение значения для главного бухгалтера
	СтруктураОтбора=Новый Структура("Организация,Объект",Организация,Перечисления.ВидыОбъектовСведений.ГлавныйБухгалтер);
	СтруктураСведений=РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(РабочаяДата,СтруктураОтбора);
	ГлавныйБухгалтер=СтруктураСведений.Значение;

	Возврат Новый Структура("Руководитель, ГлавныйБухгалтер", Руководитель, ГлавныйБухгалтер);
	
КонецФункции // ПолучитьОтветственныхПоОрганизации()

Функция НайтиПодчиненныйСчетФактуру(ЗаказСсылка, Реализация = Неопределено, ВидДокумента = "СчетФактураВыданный") Экспорт
	
	Если Реализация = Неопределено Тогда
	
		Реализация = ПолучитьСсылкуНаСформированныйДокумент(, "РеализацияТоваров",, ЗаказСсылка);
		
		Если НЕ ЗначениеЗаполнено(Реализация) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Попытка
			Реализация = Реализация.ПолучитьОбъект();
		Исключение
			Возврат Неопределено;
		КонецПопытки;
		
		Реализация = Реализация.Ссылка;
		
	КонецЕсли;
	
	Возврат Renault_Advanced_УчетНДС.НайтиПодчиненныйДокумент(Реализация, ВидДокумента);
	
КонецФункции

// Возвращает ссылку на один из документов заданного типа, сформированных из Заказа
Функция ПолучитьСсылкуНаСформированныйДокумент(мСформированныеДокументы=Неопределено, ТипДокумента, Фильтр = Неопределено, Ссылка) Экспорт
	
	Перем СсылкаНаДокумент;
	
	Если ТипЗнч(мСформированныеДокументы) <> Тип("Структура") Тогда
		мСформированныеДокументы = Новый Структура;
	КонецЕсли;
	
	Если НЕ мСформированныеДокументы.Свойство(ТипДокумента, СсылкаНаДокумент) ИЛИ НЕ ЗначениеЗаполнено(СсылкаНаДокумент) ИЛИ СсылкаНаДокумент.ПолучитьОбъект() = Неопределено Тогда
			
		СсылкаНаДокумент = Неопределено;	
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Заказ", Ссылка);
	
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СформированныеДокументы.Документ КАК Документ." + ТипДокумента + ") КАК Ссылка
		|ИЗ
		|	РегистрСведений.Renault_Advanced_СформированныеДокументы КАК СформированныеДокументы
		|ГДЕ
		|	СформированныеДокументы.ЗаказНаряд = &Заказ
		|	И СформированныеДокументы.Документ ССЫЛКА Документ." + ТипДокумента + "
		|	И Выразить(СформированныеДокументы.Документ КАК Документ." + ТипДокумента + ").Проведен";
		
		Если ЗначениеЗаполнено(Фильтр) Тогда
			Для Каждого СтрокаФильтра Из Фильтр Цикл
				Запрос.УстановитьПараметр(СтрокаФильтра.Ключ, СтрокаФильтра.Значение);
				Запрос.Текст = Запрос.Текст + "
				|И СформированныеДокументы.Документ." + СтрокаФильтра.Ключ + " = &" + СтрокаФильтра.Ключ; 
			КонецЦикла;
		КонецЕсли;
	
		Выборка = Запрос.Выполнить().Выбрать();
	
		Если Выборка.Следующий() Тогда
			СсылкаНаДокумент = Выборка.Ссылка;
			Если НЕ ЗначениеЗаполнено(Фильтр) Тогда 
				мСформированныеДокументы.Вставить(ТипДокумента, СсылкаНаДокумент);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СсылкаНаДокумент;
	
КонецФункции // ПолучитьСсылкуНаСформированныйДокумент()

Функция ПолучитьНаименование(Номенклатура, Характеристика) Экспорт

	НоменклатураНаименование = спПолучитьНаименование(Номенклатура);
	Если НЕ Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка() Тогда    
		НоменклатураНаименование = НоменклатураНаименование + ", " + Характеристика;	       
	КонецЕсли;
	
	Возврат НоменклатураНаименование;
	
КонецФункции // ПолучитьНаименование()

// Функция - Получить склад по группе доступности
//
// Параметры:
//  ГруппаДоступности	 - 	СправочникСсылка - Ссылка на склад или группу доступности
// 
// Возвращаемое значение:
//   - СправочникСсылка.СкладыКомпании
//
Функция ПолучитьСкладПоГруппеДоступности(ГруппаДоступности) Экспорт

	Если ТипЗнч(ГруппаДоступности) = Тип("СправочникСсылка.СкладыКомпании") Тогда Возврат ГруппаДоступности; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппаДоступности", ГруппаДоступности);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_СоставГруппДоступностиСкладов.Склад
	               |ИЗ
	               |	РегистрСведений.Renault_СоставГруппДоступностиСкладов КАК Renault_СоставГруппДоступностиСкладов
	               |ГДЕ
	               |	Renault_СоставГруппДоступностиСкладов.ГруппаДоступности = &ГруппаДоступности";
	
	Склады = Запрос.Выполнить().Выгрузить();
	Если Склады.Количество() = 1 Тогда
		Возврат Склады[0].Склад;
	Иначе	
		Возврат Справочники.СкладыКомпании.ПустаяСсылка();
	КонецЕсли;

КонецФункции // ПолучитьСкладПоГруппеДоступности()

// Процедура - Проверить подразделение, проверяет возможность использовать подразделение в документах
//
// Параметры:
//  ЗаказОбъект	 - ДокументОбъект	 - заказ покупателя
//
Процедура ПроверитьПодразделение(ЗаказОбъект) Экспорт

	ПодразделениеИспользоватьВДокументах = Renault_AdvancedКлиент.ПолучитьСкладИлиНастройкуПодразделения(ЗаказОбъект.ПодразделениеКомпании, "ИспользоватьВДокументах");
	Если ЗначениеЗаполнено(ПодразделениеИспользоватьВДокументах) И ПодразделениеИспользоватьВДокументах Тогда
		СкладГруппа  = Renault_AdvancedКлиент.ПолучитьСкладИлиНастройкуПодразделения(ЗаказОбъект.ПодразделениеКомпании, "ГруппаДоступности");
		ЗаказОбъект.СкладКомпании = ПолучитьСкладПоГруппеДоступности(СкладГруппа);
		ЗаказОбъект.Renault_Advanced_СкладРеализации = Renault_AdvancedКлиент.ПолучитьСкладИлиНастройкуПодразделения(ЗаказОбъект.ПодразделениеКомпании, "СкладРемзоны");
	Иначе			
		Если ЗначениеЗаполнено(ЗаказОбъект.ПодразделениеКомпании) Тогда
			Сообщить("Подразделение " + ЗаказОбъект.ПодразделениеКомпании + " запрещено использовать в документах");
		КонецЕсли;
		
		ЗаказОбъект.СкладКомпании   = Неопределено;
		ЗаказОбъект.Renault_Advanced_СкладРеализации  = Справочники.СкладыКомпании.ПустаяСсылка();
		ЗаказОбъект.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ПустаяСсылка();				
	КонецЕсли;

КонецПроцедуры

// Функция - Получить реквизит
//
// Параметры:
//  Заказ		 - ДокументСсылка	 - Заказ покупателя
//  ИмяРеквизита - Строка	 - Имя реквизита
// 
// Возвращаемое значение:
//   - Значение реквизита или Неопределено
//
Функция ПолучитьРеквизит(Заказ, ИмяРеквизита) Экспорт

	// 1. Ищем в реквизитах документа
	РеквизитДокумента = Ложь;
	Для каждого Реквизит Из Метаданные.Документы.ЗаказПокупателя.Реквизиты Цикл
		Если Реквизит.Имя = ИмяРеквизита Тогда РеквизитДокумента = Истина; Прервать; КонецЕсли;
	КонецЦикла;	
	Если РеквизитДокумента Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	КорректировкаЗаказаПокупателя.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
		               |ГДЕ
		               |	КорректировкаЗаказаПокупателя.ДокументОснование = &Заказ
		               |	И КорректировкаЗаказаПокупателя.Проведен
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Ссылка УБЫВ
		               |АВТОУПОРЯДОЧИВАНИЕ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка[ИмяРеквизита];	
		Иначе	
			Возврат Заказ[ИмяРеквизита];
		КонецЕсли;
	КонецЕсли;
	
	// 2. Ищем в регистре доп. реквизитов
	ИзРегистра = Ложь;
	Для каждого Ресурс Из Метаданные.РегистрыСведений.Renault_Advanced_ДополнительныеРеквизитыЗаказПокупателя.Ресурсы Цикл
		Если Ресурс.Имя = ИмяРеквизита Тогда ИзРегистра = Истина; Прервать; КонецЕсли;
	КонецЦикла;
	Если ИзРегистра Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДополнительныеРеквизитыЗаказПокупателя."+ИмяРеквизита+"
		               |ИЗ
		               |	РегистрСведений.Renault_Advanced_ДополнительныеРеквизитыЗаказПокупателя КАК ДополнительныеРеквизитыЗаказПокупателя
		               |ГДЕ
		               |	ДополнительныеРеквизитыЗаказПокупателя.Заказ = &Заказ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
		    Возврат Выборка[ИмяРеквизита];
		КонецЕсли;
	КонецЕсли;

КонецФункции 

Процедура СоздатьРеализацию(Заказ, Товары = Неопределено) Экспорт

	Если Заказ.Renault_advanced_ТипОбслуживания = Справочники.Renault_advanced_ТипыОбслуживания.Внутренний Тогда Возврат; КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Заказ.Renault_Advanced_СкладРеализации) Тогда Сообщить("Не указан склад реализации"); Возврат; КонецЕсли;
	
	ЗаказСУчетомКорректировки = ПолучитьКорректировкуЗаказа(Заказ);
	СтатусыЗапчастей = ПолучитьСтатусыЗапчастей(Заказ,,?(Товары = Неопределено, ЗаказСУчетомКорректировки.Товары.Выгрузить(), Товары));

	ТоварыРеализация = ?(Товары = Неопределено, ПолучитьТоварыКРеализации(ЗаказСУчетомКорректировки, СтатусыЗапчастей), Товары);
	
	Если ТоварыРеализация = Неопределено ИЛИ ТоварыРеализация.Количество() = 0 Тогда Возврат; КонецЕсли; //Сообщить("Нет товаров к реализации");
	
	ДокРеализ = Документы.РеализацияТоваров.СоздатьДокумент();
	ДокРеализ.Комментарий = КомментарийСозданиеДокумента();
	ДокРеализ.Заполнить(Заказ);
	ДокРеализ.ДокументОснование = Заказ;
	ДокРеализ.СкладКомпании = Заказ.Renault_Advanced_СкладРеализации;
	ДокРеализ.Товары.Очистить();
	
	Для каждого СтрокаТовары Из ТоварыРеализация Цикл //ЗаказСУчетомКорректировки.Товары Цикл

		СтрокаРезЗапроса = СтатусыЗапчастей.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", СтрокаТовары.Номенклатура, СтрокаТовары.ХарактеристикаНоменклатуры));
		//Если СтрокаРезЗапроса.Количество() = 0 ИЛИ СтрокаТовары.Количество >  СтрокаРезЗапроса[0].Отгружено / СтрокаРезЗапроса[0].Коэффициент Тогда 
		//	Возврат; // создаем реализацию только на все строки сразу, 1 заказ - 1 реализация
		//КонецЕсли; 
		
		СтрокаТоварыРеализация = ДокРеализ.Товары.Добавить();
	    ЗаполнитьЗначенияСвойств(СтрокаТоварыРеализация, СтрокаТовары, "Номенклатура, ХарактеристикаНоменклатуры");
		ДокРеализ.ОбработкаРеквизита("Товары.Номенклатура", СтрокаТоварыРеализация);

		СтрокаТоварыРеализация.Количество = СтрокаРезЗапроса[0].Отгружено / СтрокаРезЗапроса[0].Коэффициент;
		СтрокаТоварыРеализация.КоличествоБазовое = СтрокаТоварыРеализация.Количество * СтрокаТоварыРеализация.Коэффициент;
		Если СтрокаРезЗапроса[0].Отгружено = СтрокаТовары.Количество * СтрокаТовары.Коэффициент Тогда
			СтрокаТоварыРеализация.СуммаВсего = СтрокаТовары.СуммаВсего;
			ДокРеализ.ОбработкаРеквизита("Товары.СуммаВсего", СтрокаТоварыРеализация);
		Иначе	
			//СтрокаТоварыРеализация.Цена = СтрокаТовары.Цена;
			СтрокаТоварыРеализация.Цена = СтрокаТовары.СуммаВсего / СтрокаТовары.Количество / СтрокаТовары.Коэффициент;
			ДокРеализ.ОбработкаРеквизита("Товары.Цена", СтрокаТоварыРеализация);
		КонецЕсли;
	КонецЦикла;
	
	Если ДокРеализ.Товары.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	Попытка
		НачатьТранзакцию();
		ДокРеализ.Записать(РежимЗаписиДокумента.Проведение);
		ДобавитьСформированныеДокумент(Заказ, ДокРеализ.Ссылка);
		
		//+ еще создадим счф автоматически
		ДокОбъектСЧФ = Неопределено;
		Если ДокРеализ.Товары.Итог("СуммаНДС") > 0 Тогда
			
			Запроссчф = Новый Запрос;
			Запроссчф.Текст = 
			"ВЫБРАТЬ
			|	СчетФактураВыданный.Ссылка
			|ИЗ
			|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
			|ГДЕ
			|	СчетФактураВыданный.ПометкаУдаления = Ложь
			|	И СчетФактураВыданный.ДокументОснование = &ДокументОснование";
			
			Запроссчф.УстановитьПараметр("ДокументОснование", ДокРеализ.Ссылка);
			
			
			РезультатЗапросасчф = Запроссчф.Выполнить().Выбрать();
			
			Если РезультатЗапросасчф.Следующий() Тогда
				ДокОбъектСЧФ = РезультатЗапросасчф.Ссылка.ПолучитьОбъект(); 	
			Иначе
				ДокОбъектСЧФ = Документы.СчетФактураВыданный.СоздатьДокумент();
			КонецЕсли;
			
			ДокОбъектСЧФ.Заполнить(ДокРеализ.Ссылка);
			ДокОбъектСЧФ.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		//-
		
		ЗафиксироватьТранзакцию();
		Сообщить("Создан документ: " + ДокРеализ.Ссылка, СтатусСообщения.Информация);
		Если ДокОбъектСЧФ <>  Неопределено Тогда
			Сообщить("Создана счет-фактура: " + ДокОбъектСЧФ, СтатусСообщения.Информация);	
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьКорректировкуЗаказа(ЗаказПокупателя) Экспорт
	
	КоррЗаказПокупателя = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(КорректировкаЗаказаПокупателя.Дата) КАК Дата
	               |ПОМЕСТИТЬ ВТПослКорр
	               |ИЗ
	               |	Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
	               |ГДЕ
	               |	КорректировкаЗаказаПокупателя.ДокументОснование = &ДокументОснование
	               |	И КорректировкаЗаказаПокупателя.Проведен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КорректировкаЗаказаПокупателя.Ссылка
	               |ИЗ
	               |	ВТПослКорр КАК ВТПослКорр
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
	               |		ПО ВТПослКорр.Дата = КорректировкаЗаказаПокупателя.Дата";
	
	Запрос.УстановитьПараметр("ДокументОснование", ЗаказПокупателя);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
	    КоррЗаказПокупателя = Выборка.Ссылка;
	КонецЦикла;
			
	Возврат ?(КоррЗаказПокупателя = Неопределено, ЗаказПокупателя, КоррЗаказПокупателя);
	
КонецФункции

Процедура СоздатьСписание(Заказ) Экспорт

	Если Заказ.Renault_advanced_ТипОбслуживания <> Справочники.Renault_advanced_ТипыОбслуживания.Внутренний Тогда Возврат; КонецЕсли;
	
	Если Не Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ВключитьФункционалСписанияВнутреннихЗаказовПокупателя Тогда
		Сообщить("Не включен функционал списания внутренних заказов покупателя");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Заказ.Renault_Advanced_СкладРеализации) Тогда Сообщить("Не указан склад реализации"); Возврат; КонецЕсли;

	//ОтмеченныеСтроки = ТоварыТЗ.НайтиСтроки(Новый Структура("Отметка", Истина));
	//ОтмеченныеСтроки = ТоварыТЗ.Скопировать(ОтмеченныеСтроки, "НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, Количество, Коэффициент");
	СтатусыЗапчастей = ПолучитьСтатусыЗапчастей(Заказ);
	
	СтрокиУдалить = Новый Массив;
	ТоварыСписание = СтатусыЗапчастей.Скопировать();
	Для каждого СтрокаСтатусы Из ТоварыСписание Цикл
		
		ВыбСтрока = Заказ.Товары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", СтрокаСтатусы.Номенклатура, СтрокаСтатусы.ХарактеристикаНоменклатуры));
		
		Если ВыбСтрока.Количество() = 0 Тогда 
			СтрокиУдалить.Добавить(СтрокаСтатусы); // строка не выбрана
		ИначеЕсли СтрокаСтатусы.Отгружено < ВыбСтрока[0].Количество * ВыбСтрока[0].Коэффициент Тогда
			СтрокиУдалить.Добавить(СтрокаСтатусы); // товар не полностью получен на склад реализации
		КонецЕсли;
		
	КонецЦикла;
	Пока СтрокиУдалить.Количество() <> 0 Цикл
		ТоварыСписание.Удалить(СтрокиУдалить[0]);
		СтрокиУдалить.Удалить(0);
	КонецЦикла;
	
	ДокСписание = Документы.СписаниеТоваров.СоздатьДокумент();
	ДокСписание.ХозОперация = Справочники.ХозОперации.СписаниеТоваров;
	ДокСписание.Организация = Заказ.Организация;
	ДокСписание.ПодразделениеКомпании = Заказ.ПодразделениеКомпании;
	ДокСписание.Заполнить(Неопределено);
	ДокСписание.РегламентированныйУчет = Истина;
	ДокСписание.Комментарий = КомментарийСозданиеДокумента();
	ДокСписание.СкладКомпании = Заказ.Renault_Advanced_СкладРеализации;
	ДокСписание.ТипЦен = Заказ.ТипЦен;
	ДокСписание.ВалютаДокумента = Заказ.ВалютаДокумента;
	ДокСписание.КурсДокумента = Заказ.КурсДокумента;
	ДокСписание.ПодразделениеЗатрат = Заказ.Renault_Advanced_СкладРеализации.Подразделение;
	ДокСписание.СтатьяСписанияТМЦ = Справочники.СтатьиДоходовИРасходов.ПрочиеЗатраты;
	ДокСписание.КурсВалютыУпр = Заказ.КурсВалютыУпр;
	ДокСписание.Проект = Заказ.Проект;
	ДокСписание.Renault_advanced_ДокументОснование = Заказ;
	ДокСписание.Товары.Очистить();
	
	РозничныйСклад = ДокСписание.СкладКомпании.Розничный;
	Для каждого СтрокаТовары Из Заказ.Товары Цикл
		СтрокаРезЗапроса = ТоварыСписание.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", СтрокаТовары.Номенклатура, СтрокаТовары.ХарактеристикаНоменклатуры));
		Если СтрокаРезЗапроса.Количество() = 0 ИЛИ СтрокаТовары.Количество >  СтрокаРезЗапроса[0].Отгружено / СтрокаРезЗапроса[0].Коэффициент Тогда 
			Возврат; // создаем реализацию только на все строки сразу, 1 заказ - 1 реализация
		КонецЕсли; 
		
		СтрокаТоварыСписание = ДокСписание.Товары.Добавить();
	    ЗаполнитьЗначенияСвойств(СтрокаТоварыСписание, СтрокаТовары, "Номенклатура,ХарактеристикаНоменклатуры,ЕдиницаИзмерения,Коэффициент");

		СтрокаТоварыСписание.Количество = СтрокаРезЗапроса[0].Отгружено / СтрокаРезЗапроса[0].Коэффициент;
		
		Если РозничныйСклад Тогда
			Если СтрокаРезЗапроса[0].Отгружено = СтрокаТовары.Количество * СтрокаТовары.Коэффициент Тогда
				СтрокаТоварыСписание.СуммаРозничная = СтрокаТовары.СуммаВсего;
				ДокСписание.ОбработкаРеквизита("Товары.СуммаРозничная",СтрокаТоварыСписание);
			Иначе	
				СтрокаТоварыСписание.ЦенаРозничная = СтрокаТовары.СуммаВсего / СтрокаТовары.Количество / СтрокаТовары.Коэффициент;
				ДокСписание.ОбработкаРеквизита("Товары.ЦенаРозничная", СтрокаТоварыСписание);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ДокСписание.Товары.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	Попытка
		НачатьТранзакцию();
		// Нужно связать списание с заказом, до проведения списания
		ДокСписание.Записать(РежимЗаписиДокумента.Запись);
		Запись = РегистрыСведений.Renault_СписанияВнутреннихЗаказовПокупателя.СоздатьМенеджерЗаписи();
		Запись.СписаниеТоваров = ДокСписание.Ссылка;
		Запись.ЗаказПокупателя = Заказ;
		Запись.Записать();
		
		ДокСписание.Записать(РежимЗаписиДокумента.Проведение);
		ДобавитьСформированныеДокумент(Заказ, ДокСписание.Ссылка);
		//РегистрыСведений.Renault_Advanced_ДополнительныеРеквизитыЗаказПокупателя.ЗаписатьДопРеквизиты(Заказ, Новый Структура("Статус",Статус));
		ЗафиксироватьТранзакцию();		
		Сообщить("Создан документ: " + ДокСписание.Ссылка, СтатусСообщения.Информация);
	Исключение
		ОтменитьТранзакцию();
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

