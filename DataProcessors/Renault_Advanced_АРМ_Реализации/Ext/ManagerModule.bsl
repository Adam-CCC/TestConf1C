	//ОтмеченныеСтроки = ТоварыТЗ.НайтиСтроки(Новый Структура("Отметка", Истина));
	//ОтмеченныеСтроки = ТоварыТЗ.Скопировать(ОтмеченныеСтроки, "НомерСтроки, Номенклатура, ХарактеристикаНоменклатуры, Количество, Коэффициент");
