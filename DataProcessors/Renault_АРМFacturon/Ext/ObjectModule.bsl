Процедура ЗаписатьДанныеВРегистр(СтрокиДокумента, ПлПоручение)
	
	НЗ = РегистрыСведений.Renault_ОплатыВАФМ.СоздатьНаборЗаписей();
	
	НЗ.Отбор.ПлатежноеПоручение.Установить(ПлПоручение);
	НЗ.Прочитать();
	НЗ.Очистить();
	
	Для каждого СтрокаДокумента Из СтрокиДокумента Цикл
	
		НС = НЗ.Добавить();
		НС.НомерДокумента	  = СтрокаДокумента.NumDoc;
		НС.ДатаДокумента	  = СтрокаДокумента.DateFacture;
		НС.СуммаПлатежа		  = СтрокаДокумента.СуммаКОплате;
		НС.VIN				  = СтрокаДокумента.VIN_PRinvoice;
		НС.ПлатежноеПоручение = ПлПоручение;
		НС.ДатаПлатежа		  = ПлПоручение.Дата;
	КонецЦикла;
	
	НЗ.Записать();
	
КонецПроцедуры

Функция СформироватьСуммуПрописью(Сумма)

	ПараметрыПрописиНаРусском = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	
	Если НЕ Метаданные.Справочники.Найти("Валюты") = Неопределено тогда
		
		ВалютаРубль = Справочники["Валюты"].НайтиПоКоду("643");
		
		Если ЗначениеЗаполнено(ВалютаРубль) тогда
			ПараметрыПрописиНаРусском = ВалютаРубль.ПараметрыПрописиНаРусском;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЧислоПрописью(Сумма, ,ПараметрыПрописиНаРусском);
	
КонецФункции // СформироватьСуммуПрописью()

