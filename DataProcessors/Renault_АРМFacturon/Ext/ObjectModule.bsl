//			Печать Счета и письма

Функция СформироватьПисьмо(ТекСчет) Экспорт
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("ПениДетали", ПениДетали);
	Запрос.УстановитьПараметр("ТабПени", Пени);
	Запрос.УстановитьПараметр("ТекСчет", ТекСчет);
	
	//Получим таблицу детализации
	ТекстЗапроса =  "ВЫБРАТЬ ПЕРВЫЕ 1 *
	|ПОМЕСТИТЬ Детализация
	|ИЗ
	|	&ПениДетали КАК ПениДетали
	|ГДЕ
	|	ПениДетали.NUM_CCHET = &ТекСчет";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Получим таблицу Пеней
	ТекстЗапроса = "ВЫБРАТЬ *
	|ПОМЕСТИТЬ Пени
	|ИЗ
	|	&ТабПени КАК ТабПени
	|ГДЕ
	|	ТабПени.NumberInvoice = &ТекСчет";

	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Начинаем собирать данные
	ТекстЗапроса = "ВЫБРАТЬ
	|	Детализация.DEALER_NAME_FULL КАК НаименованиеДилера,
	|	Пени.NumberInvoice КАК НомерСчета,
	|	Пени.InvoiceDate КАК ДатаСчета,
	|	Детализация.NUMERO_ANNEXE КАК ДоговорНомер,
	|	Детализация.DATE_ANNEXE КАК ДоговорДата,
	|	Пени.PeriodFrom КАК НачалоПериода,
	|	Пени.PeriodTo КАК КонецПериода,
	|	Пени.FineTaxed КАК СуммаПени
	|ИЗ
	|	Пени КАК Пени
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Детализация КАК Детализация
	|		ПО Пени.NumberInvoice = Детализация.NUM_CCHET
	|ГДЕ
	|	Пени.NumberInvoice = &ТекСчет";
	
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		Попытка
			
			Письмо = ПолучитьМакет("МакетПисьма");
			Word = Письмо.Получить();
			Word.Application.Visible= 0;
			
			//Заполнение полей
			Word.Variables.Item("НаименованиеДилера").Value = Выборка.НаименованиеДилера;
			Word.Variables.Item("ДатаСчета").Value			= Выборка.ДатаСчета;
			Word.Variables.Item("НомерСчета").Value			= Строка(Выборка.НомерСчета) + "/П";
			Word.Variables.Item("НачалоПериода").Value		= Выборка.НачалоПериода;
			Word.Variables.Item("КонецПериода").Value		= Выборка.КонецПериода;
			Word.Variables.Item("ДоговорНомер").Value		= Выборка.ДоговорНомер;
			Word.Variables.Item("ДоговорДата").Value		= Формат(Выборка.ДоговорДата,"ДФ=dd.MM.yyyy");
			Word.Variables.Item("СуммаПени").Value			= Формат(Выборка.СуммаПени,"ЧДЦ=2; ЧРД=,; ЧРГ=' '; ЧГ=3,0");
			Word.Fields.Update();

			//Возвращаем объект с письмом
			Возврат Word;
			
		Исключение
			
			Сообщить(ОписаниеОшибки());
			Возврат неопределено;
			
		КонецПопытки;
	Иначе
		
		Сообщить("Детальных данных для счета №" + ТекСчет + " не найдено.");
		Возврат неопределено;
		
	КонецЕсли;
	
КонецФункции

Функция ПечатьСчета(ТекСчет) Экспорт
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("ПениДетали", ПениДетали);
	Запрос.УстановитьПараметр("ТабПени", Пени);
	Запрос.УстановитьПараметр("ТекСчет", ТекСчет);
	
	//Получим таблицу детализации
	ТекстЗапроса =  "ВЫБРАТЬ *
	|ПОМЕСТИТЬ Детализация
	|ИЗ
	|	&ПениДетали КАК ПениДетали
	|ГДЕ
	|	ПениДетали.NUM_CCHET = &ТекСчет";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Получим таблицу Пеней
	ТекстЗапроса = "ВЫБРАТЬ *
	|ПОМЕСТИТЬ Пени
	|ИЗ
	|	&ТабПени КАК ТабПени
	|ГДЕ
	|	ТабПени.NumberInvoice = &ТекСчет";

	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Начинаем собирать шапку
	ТекстЗапроса = "ВЫБРАТЬ
	|	Пени.NumberInvoice КАК СчетНомер,
	|	Пени.InvoiceDate КАК СчетДата,
	|	Пени.PeriodFrom КАК НачалоПериода,
	|	Пени.PeriodTo КАК КонецПериода,
	|	Детализация.DEALER_NAME_FULL КАК НаименованиеДилера,
	|	Детализация.INN КАК ИНН,
	|	Детализация.KPP КАК КПП,
	|	Детализация.ADR_CODE_POSTAL КАК Индекс,
	|	Детализация.ADR_VILLE КАК Город,
	|	Детализация.ADR КАК Адрес
	|ИЗ
	|	Пени КАК Пени
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Детализация КАК Детализация
	|		ПО Пени.NumberInvoice = Детализация.NUM_CCHET
	|ГДЕ
	|	Пени.NumberInvoice = &ТекСчет";

	Запрос.Текст = ТекстЗапроса;
	Шапка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Шапка.Следующий() тогда
		
		Сообщить("Детальных данных для счета № " + ТекСчет + " не найдено.");
		Возврат Неопределено;
		
	КонецЕсли;
	
	//Начинаем собирать данные по табличной части
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Детализация.NUMERO_ANNEXE КАК ДоговорНомер,
	|	Детализация.DATE_ANNEXE КАК ДоговорДата,
	|	Детализация.NUM_FAC КАК НомерТТН,
	|	Детализация.VIN,
	|	Детализация.date_f КАК ДатаОтгрузки,
	|	Детализация.DATE_R КАК СрокОплаты,
	|	Детализация.DATE_P КАК ДатаОплаты,
	|	Детализация.DAY_R КАК Просрочка,
	|	Детализация.PRICE_F КАК СтоимостьАвто,
	|	Детализация.PENI КАК Пени
	|ИЗ
	|	Пени КАК Пени
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Детализация КАК Детализация
	|		ПО Пени.NumberInvoice = Детализация.NUM_CCHET
	|ГДЕ
	|	Пени.NumberInvoice = &ТекСчет
	|	И (НЕ Детализация.NUMERO_ANNEXE = """")";
	
	Запрос.Текст = ТекстЗапроса;
	ТабЧасть = Запрос.Выполнить().Выгрузить();

	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаказПокупателя_СчетЗаказ";

	Макет = ПолучитьМакет("Счет");
	
	/////////////////////////////////////////////////////////////
	//			Вывод таблицы с банковскими реквизитами
	ОбластьМакета       = Макет.ПолучитьОбласть("ЗаголовокСчета");
	ТабДокумент.Вывести(ОбластьМакета);

	/////////////////////////////////////////////////////////////
	//			Вывод заголовка документа
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.ТекстЗаголовка = "Счет №" + Шапка.СчетНомер + "/П от " + Формат(Шапка.СчетДата,"ДФ=dd.MM.yyyy") + 
					" за период с " + Формат(Шапка.НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(Шапка.КонецПериода, "ДФ=dd.MM.yyyy");

	ТабДокумент.Вывести(ОбластьМакета);
	
	/////////////////////////////////////////////////////////////
	//			Вывод строки Поставщик
	ОбластьМакета = Макет.ПолучитьОбласть("Поставщик");
	ТабДокумент.Вывести(ОбластьМакета);
	
	/////////////////////////////////////////////////////////////
	//			Вывод строки Покупатель
	ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
	
	//Заголовок ИНН/КПП
	ИННКПП = "";
	Если ЗначениеЗаполнено(Шапка.ИНН) тогда
		ИННКПП = "ИНН";
		
		//Если нет ИНН то нет и КПП
		Если ЗначениеЗаполнено(Шапка.КПП) тогда
			ИННКПП = ИННКПП + "/КПП";
		КонецЕсли;
		
		//Значение ИНН/КПП
		ИННКПП = ИННКПП + ": " + Шапка.ИНН;
		
		//Если нет ИНН то нет и КПП
		Если ЗначениеЗаполнено(Шапка.КПП) тогда
			ИННКПП = ИННКПП + " / " + Шапка.КПП;
		КонецЕсли;
		
	Иначе
		
		ИННКПП = "";
		
	КонецЕсли;
	
	ОбластьМакета.Параметры.ПредставлениеПокупателя = Шапка.НаименованиеДилера + 
				", Адрес: " + Шапка.Индекс + ", " + Шапка.Город + ", " + Шапка.Адрес +
				", " + ?(ЗначениеЗаполнено(Шапка.ИНН), ИННКПП,".");
	ТабДокумент.Вывести(ОбластьМакета);
	
	/////////////////////////////////////////////////////////////
	//			Вывод шапки таблицы
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДокумент.Вывести(ОбластьМакета);
	
	/////////////////////////////////////////////////////////////
	//			Вывод строк таблицы
	
	ИтогоСуммаДокумента = 0;
	
	Для каждого строка из ТабЧасть Цикл
		
		ИтогоСуммаДокумента = ИтогоСуммаДокумента + строка.Пени;

		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Заполнить(строка);
		
		ОбластьМакета.Параметры.НомерДатаДоговора = "Прил.№11 к Дог." + Строка.ДоговорНомер + Символы.ПС + 
				" от " + Формат(Строка.ДоговорДата,"ДФ=dd.MM.yyyy");
		
		ТабДокумент.Вывести(ОбластьМакета);
		
	КонецЦикла;
	
	/////////////////////////////////////////////////////////////
	//			Вывод строки Итого
	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	ОбластьМакета.Параметры.Всего = ИтогоСуммаДокумента;
	ТабДокумент.Вывести(ОбластьМакета);
	
	/////////////////////////////////////////////////////////////
	//			Вывод Итого к оплате
	ОбластьМакета = Макет.ПолучитьОбласть("ИтогоКОплате");
	ОбластьМакета.Параметры.ИтогоКОплате = ИтогоСуммаДокумента;
	ТабДокумент.Вывести(ОбластьМакета);

	/////////////////////////////////////////////////////////////
	//			Вывод Суммы прописью
	ОбластьМакета = Макет.ПолучитьОбласть("СуммаПрописью");
	ОбластьМакета.Параметры.ИтоговаяСтрока = "Всего наименований " + ТабЧасть.Количество() + ", на сумму " + 
			ИтогоСуммаДокумента + " руб.";
		
	ОбластьМакета.Параметры.СуммаПрописью = СформироватьСуммуПрописью(ИтогоСуммаДокумента);
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	/////////////////////////////////////////////////////////////
	//			Вывод подвала с печатью и подписью
	ОбластьМакета = Макет.ПолучитьОбласть("ПодвалСчета");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ПолеСверху = 5;
	ТабДокумент.ПолеСлева = 2;
	ТабДокумент.ПолеСправа = 2;
	ТабДокумент.ПолеСнизу = 2;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьДетализации(ТекСчет) Экспорт
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("ПениДетали", ПениДетали);
	Запрос.УстановитьПараметр("ТабПени", Пени);
	Запрос.УстановитьПараметр("ТекСчет", ТекСчет);
	
	//Получим таблицу детализации
	ТекстЗапроса =  "ВЫБРАТЬ *
	|ПОМЕСТИТЬ Детализация
	|ИЗ
	|	&ПениДетали КАК ПениДетали
	|ГДЕ
	|	ПениДетали.NUM_CCHET = &ТекСчет";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Получим таблицу Пеней
	ТекстЗапроса = "ВЫБРАТЬ *
	|ПОМЕСТИТЬ Пени
	|ИЗ
	|	&ТабПени КАК ТабПени
	|ГДЕ
	|	ТабПени.NumberInvoice = &ТекСчет";

	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Начинаем собирать данные по табличной части
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Детализация.NUM_FAC КАК НомерТТН,
	|	Детализация.VIN,
	|	Детализация.date_f КАК ДатаОтгрузки,
	|	Детализация.DATE_R КАК СрокОплаты,
	|	Детализация.DATE_P КАК ДатаОплаты,
	|	Детализация.DAY_R КАК Просрочка,
	|	Детализация.PRICE_F КАК СтоимостьАвто,
	|	Детализация.PENI КАК Пени,
	|	Детализация.PENI_NDS КАК НДСПени
	|ИЗ
	|	Пени КАК Пени
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Детализация КАК Детализация
	|		ПО Пени.NumberInvoice = Детализация.NUM_CCHET
	|ГДЕ
	|	Пени.NumberInvoice = &ТекСчет";
	
	Запрос.Текст = ТекстЗапроса;
	ТабЧасть = Запрос.Выполнить().Выгрузить();

	Если ТабЧасть.Количество() = 0 тогда
		
		Сообщить("Детальных данных для счета № " + ТекСчет + " не найдено.");
		Возврат Неопределено;
		
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;

	Макет = ПолучитьМакет("ДетализацияПени");
	
	////////////////////////////////////////////////////
	//			Заголовок
	ТекстЗаголовка = "Детализация к счету № " +  ТекСчет;
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.ТекстЗаголовка = ТекстЗаголовка;
	ТабДокумент.Вывести(ОбластьМакета);
	
	////////////////////////////////////////////////////
	//			Шапка таблицы
	ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДокумент.Вывести(ОбластьМакета);
	
	СуммаИтого = 0;
	НДСИтого   = 0;
	
	////////////////////////////////////////////////////
	//			Строки таблицы
	Для Каждого строка из ТабЧасть Цикл
		
		СуммаИтого = СуммаИтого + Строка.Пени;
		НДСИтого   = НДСИтого + Строка.НДСПени;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Заполнить(Строка);
		ТабДокумент.Вывести(ОбластьМакета);
		
	КонецЦикла;
	
	////////////////////////////////////////////////////
	//			Итоги
	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	ОбластьМакета.Параметры.Всего = СуммаИтого;
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ПолеСверху = 5;
	ТабДокумент.ПолеСлева = 2;
	ТабДокумент.ПолеСправа = 2;
	ТабДокумент.ПолеСнизу = 2;
	
	Возврат ТабДокумент;
	
КонецФункции

