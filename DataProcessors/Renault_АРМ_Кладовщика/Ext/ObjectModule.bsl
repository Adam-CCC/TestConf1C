	               |					ВТ_ОтгруженоВМагазинПодготовка.Контрагент,
	               |					ВТ_ОтгруженоВМагазинПодготовка.СкладРеализации,
	               |					ВТ_ОтгруженоВМагазинПодготовка.Номенклатура,
	               |					ВТ_ОтгруженоВМагазинПодготовка.Характеристика
	               |				ИЗ
	               |					ВТ_ОтгруженоВМагазинПодготовка КАК ВТ_ОтгруженоВМагазинПодготовка)) КАК ЗаказыПокупателейОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтгруженоВМагазинПодготовка КАК ВТ_ОтгруженоВМагазинПодготовка
	               |		ПО ЗаказыПокупателейОстатки.Заказ = ВТ_ОтгруженоВМагазинПодготовка.Заказ
	               |			И ЗаказыПокупателейОстатки.СкладКомпании = ВТ_ОтгруженоВМагазинПодготовка.СкладРеализации
	               |			И ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры = ВТ_ОтгруженоВМагазинПодготовка.Характеристика
	               |			И ЗаказыПокупателейОстатки.Номенклатура = ВТ_ОтгруженоВМагазинПодготовка.Номенклатура
	               |			И ЗаказыПокупателейОстатки.Контрагент = ВТ_ОтгруженоВМагазинПодготовка.Контрагент
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ОтгруженоВМагазинПодготовка.Заказ,
	               |	ВТ_ОтгруженоВМагазинПодготовка.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОстаткиПроизводство.Документ,
	               |	ВТ_ОстаткиПроизводство.ЗаказНаряд,
	               |	ВТ_ОстаткиПроизводство.Номенклатура КАК Номенклатура,
	               |	ВТ_ОстаткиПроизводство.Остаток
	               |ПОМЕСТИТЬ Итоговая
	               |ИЗ
	               |	ВТ_ОстаткиПроизводство КАК ВТ_ОстаткиПроизводство
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТ_ОтгруженоВМагазин.Документ,
	               |	ВТ_ОтгруженоВМагазин.ЗаказНаряд,
	               |	ВТ_ОтгруженоВМагазин.Номенклатура,
	               |	ВТ_ОтгруженоВМагазин.Остаток
	               |ИЗ
	               |	ВТ_ОтгруженоВМагазин КАК ВТ_ОтгруженоВМагазин
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Итоговая.Документ,
	               |	Итоговая.ЗаказНаряд,
	               |	Итоговая.Номенклатура КАК Номенклатура,
	               |	Итоговая.Остаток,
	               |	спрНоменклатура.Артикул,
	               |	ЕСТЬNULL(ЕдиницыИзмерения.Коэффициент, 1) КАК Коэффициент,
	               |	Итоговая.Остаток КАК КоличествоБазовое,
	               |	Итоговая.Остаток / ЕСТЬNULL(ЕдиницыИзмерения.Коэффициент, 1) КАК Количество,
	               |	Итоговая.Остаток / ЕСТЬNULL(ЕдиницыИзмерения.Коэффициент, 1) КАК КоличествоОбщ,
	               |	ИСТИНА КАК Выбран
	               |ИЗ
	               |	Итоговая КАК Итоговая
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	               |			ПО спрНоменклатура.ОсновнаяЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	               |		ПО Итоговая.Номенклатура = спрНоменклатура.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ";
				   
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ОбновитьВнутреннееПеремещение() Экспорт

	Запрос = Новый Запрос;
			
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании); 
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиТоваровОрдерныйСкладОстатки.Ячейка КАК ЯчейкаХранения,
	               |	ОстаткиТоваровОрдерныйСкладОстатки.КоличествоОстаток
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТоваровОрдерныйСклад.Остатки(, СкладКомпании = &СкладКомпании) КАК ОстаткиТоваровОрдерныйСкладОстатки";
	
	СписокДокументов.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Процедура ОбновитьТоварыВнутреннееПеремещение(Ячейка) Экспорт

	Запрос = Новый Запрос;
			
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура,
	               |	ОстаткиТоваровОрдерныйСкладОстатки.КоличествоОстаток КАК КоличествоБазовое,
	               |	ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура.Артикул КАК Артикул,
	               |	ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент КАК Коэффициент,
	               |	ВЫБОР
	               |		КОГДА ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ ОстаткиТоваровОрдерныйСкладОстатки.КоличествоОстаток / ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ КАК Остаток,
	               |	ИСТИНА КАК Выбран
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТоваровОрдерныйСклад.Остатки(
	               |			,
	               |			СкладКомпании = &СкладКомпании
	               |				И Ячейка = &Ячейка) КАК ОстаткиТоваровОрдерныйСкладОстатки";
	
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Процедура ОбновитьДокументыПеремещений() Экспорт

    Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	
	// Определение заказ-наряда для внутреннего заказа:
	// Заказ внутренний может быть введен на основании заказ-наряда, но не может быть основанием для заказ-наряда
	// и не может быть введен на основании счета на оплату
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказВнутренний) КАК Документ,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	               |			ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ.ДокументОснование КАК Документ.ЗаказНаряд)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |	КОНЕЦ КАК ЗаказНаряд,
	               |	ЗаказыПокупателейОстатки.Заказ.Номер КАК Номер,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	               |			ТОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование.Номер
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК НомерЗаказаНаряда,
	               |	МАКСИМУМ(ЗаказыПокупателейОстатки.РезервОстаток) КАК Количество,
	               |	ЗаказыПокупателейОстатки.СкладКомпании КАК СкладКомпании,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказВнутренний).Дата КАК Дата
	               |ПОМЕСТИТЬ Вт_ПредИтог
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПокупателей.Остатки(
	               |			,
	               |			СкладКомпании = &СкладКомпании
	               |				И Контрагент ССЫЛКА Справочник.ПодразделенияКомпании
	               |				И Заказ ССЫЛКА Документ.ЗаказВнутренний
	               |				И ВЫРАЗИТЬ(Заказ КАК Документ.ЗаказВнутренний).СкладКомпании = &СкладКомпании) КАК ЗаказыПокупателейОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыПокупателейОстатки.Номенклатура,
	               |	ЗаказыПокупателейОстатки.СкладКомпании,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказВнутренний),
	               |	ЗаказыПокупателейОстатки.Заказ.Номер,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	               |			ТОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование.Номер
	               |		ИНАЧЕ """"
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	               |			ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ.ДокументОснование КАК Документ.ЗаказНаряд)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказВнутренний).Дата
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_ТоварыВПутиОбороты.Номенклатура,
	               |	Renault_ТоварыВПутиОбороты.Перемещение,
	               |	ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка),
	               |	Renault_ТоварыВПутиОбороты.Перемещение.Номер,
	               |	"""",
	               |	Renault_ТоварыВПутиОбороты.КоличествоОборот,
	               |	Renault_ТоварыВПутиОбороты.СкладКомпании,
	               |	Renault_ТоварыВПутиОбороты.Перемещение.Дата
	               |ИЗ
	               |	РегистрНакопления.Renault_ТоварыВПути.Обороты(, , , СкладКомпании = &СкладКомпании) КАК Renault_ТоварыВПутиОбороты
	               |ГДЕ
	               |	Renault_ТоварыВПутиОбороты.КоличествоОборот > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_ПредИтог.Номенклатура,
	               |	Вт_ПредИтог.Документ,
	               |	Вт_ПредИтог.ЗаказНаряд,
	               |	Вт_ПредИтог.Номер,
	               |	Вт_ПредИтог.НомерЗаказаНаряда,
	               |	Вт_ПредИтог.Количество,
	               |	Вт_ПредИтог.СкладКомпании,
	               |	Вт_ПредИтог.Дата,
	               |	Вт_ПредИтог.ЗаказНаряд.Контрагент КАК Контрагент
	               |ИЗ
	               |	Вт_ПредИтог КАК Вт_ПредИтог";
			   
	Результат = Запрос.Выполнить().Выгрузить();			   
	Результат.Свернуть("Документ, ЗаказНаряд");
	
	СписокДокументов.Загрузить(Результат);

КонецПроцедуры

// Процедура - Обновить товары к перемещению
//
// Параметры:
//  Документ - ДокументСсылка	 - Заказ внутренний или Перемещение товаров
//
Процедура ОбновитьТоварыКПеремещению(Документ) Экспорт

    Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	Запрос.УстановитьПараметр("Документ", Документ);
	Если ТипЗнч(Документ)=Тип("ДокументСсылка.ЗаказВнутренний") Тогда
		Запрос.УстановитьПараметр("ПодразделениеЗаказа", Документ.ПодразделениеПолучатель);
	Иначе
		Запрос.УстановитьПараметр("ПодразделениеЗаказа", Справочники.ПодразделенияКомпании.ПустаяСсылка());
	КонецЕсли;
	
	// Определение заказ-наряда для внутреннего заказа:
	// Заказ внутренний может быть введен на основании заказ-наряда, но не может быть основанием для заказ-наряда
	// и не может быть введен на основании счета на оплату
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыПокупателейОстатки.Номенклатура,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказВнутренний) КАК Документ,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	               |			ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ.ДокументОснование КАК Документ.ЗаказНаряд)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |	КОНЕЦ КАК ЗаказНаряд,
	               |	ЗаказыПокупателейОстатки.СкладКомпании КАК СкладКомпании,
	               |	ЗаказыПокупателейОстатки.Номенклатура.Артикул КАК Артикул,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ ЗаказыПокупателейОстатки.РезервОстаток / ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ ЗаказыПокупателейОстатки.РезервОстаток / ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ КАК КоличествоОбщ,
	               |	МАКСИМУМ(ЗаказыПокупателейОстатки.РезервОстаток) КАК КоличествоБазовое,
	               |	ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент КАК Коэффициент,
	               |	ИСТИНА КАК Выбран
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПокупателей.Остатки(
	               |			,
	               |			СкладКомпании = &СкладКомпании
	               |				И Контрагент = &ПодразделениеЗаказа
	               |				И Заказ = &Документ
	               |				И ВЫРАЗИТЬ(Заказ КАК Документ.ЗаказВнутренний).СкладКомпании = &СкладКомпании) КАК ЗаказыПокупателейОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыПокупателейОстатки.Номенклатура,
	               |	ЗаказыПокупателейОстатки.СкладКомпании,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказВнутренний),
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Заказ.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	               |			ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ.ДокументОснование КАК Документ.ЗаказНаряд)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |	КОНЕЦ,
	               |	ЗаказыПокупателейОстатки.Номенклатура.Артикул,
	               |	ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ ЗаказыПокупателейОстатки.РезервОстаток / ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_ТоварыВПутиОбороты.Номенклатура,
	               |	Renault_ТоварыВПутиОбороты.Перемещение,
	               |	ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка),
	               |	Renault_ТоварыВПутиОбороты.СкладКомпании,
	               |	СпрНоменклатура.Артикул,
	               |	ВЫБОР
	               |		КОГДА ЕдиницыИзмерения.Ссылка ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ Renault_ТоварыВПутиОбороты.КоличествоОборот / ЕдиницыИзмерения.Коэффициент
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ЕдиницыИзмерения.Ссылка ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ Renault_ТоварыВПутиОбороты.КоличествоОборот / ЕдиницыИзмерения.Коэффициент
	               |	КОНЕЦ,
	               |	Renault_ТоварыВПутиОбороты.КоличествоОборот,
	               |	ЕдиницыИзмерения.Коэффициент,
	               |	ИСТИНА
	               |ИЗ
	               |	РегистрНакопления.Renault_ТоварыВПути.Обороты(
	               |			,
	               |			,
	               |			,
	               |			Перемещение = &Документ
	               |				И СкладКомпании = &СкладКомпании) КАК Renault_ТоварыВПутиОбороты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	               |			ПО СпрНоменклатура.ОсновнаяЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	               |		ПО Renault_ТоварыВПутиОбороты.Номенклатура = СпрНоменклатура.Ссылка
	               |ГДЕ
	               |	Renault_ТоварыВПутиОбороты.КоличествоОборот > 0";

				   
	Результат = Запрос.Выполнить().Выгрузить();			   
	
	Товары.Загрузить(Результат);
	
КонецПроцедуры

Процедура ОбновитьДокументыРазмещение() Экспорт

	Запрос = Новый Запрос;
			
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании); 
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеТоваров.Ссылка КАК Документ,
	               |	ОстаткиТоваровОрдерныйСклад.Номенклатура,
	               |	СУММА(ОстаткиТоваровОрдерныйСклад.Количество) КАК Размещено
	               |ПОМЕСТИТЬ ВТ_Размещено
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТоваровОрдерныйСклад КАК ОстаткиТоваровОрдерныйСклад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |		ПО ОстаткиТоваровОрдерныйСклад.Регистратор = Корректировка.ДокументОснование
	               |			И (Корректировка.Проведен)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |		ПО ОстаткиТоваровОрдерныйСклад.Регистратор.ДокументОснование = ПоступлениеТоваров.Ссылка
	               |			И (ОстаткиТоваровОрдерныйСклад.Регистратор ССЫЛКА Документ.ПриходныйСкладскойОрдер)
	               |			И (ОстаткиТоваровОрдерныйСклад.СкладКомпании = &СкладКомпании)
	               |ГДЕ
	               |	Корректировка.Ссылка ЕСТЬ NULL 
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступлениеТоваров.Ссылка,
	               |	ОстаткиТоваровОрдерныйСклад.Номенклатура,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ОстаткиТоваровОрдерныйСклад.Регистратор КАК Документ.ПриходныйСкладскойОрдер).ДокументОснование КАК Документ.ПоступлениеТоваров)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступленияПодготовка.Документ,
	               |	ПоступленияПодготовка.Номенклатура,
	               |	СУММА(ПоступленияПодготовка.Поступило) КАК Поступило
	               |ПОМЕСТИТЬ ВТ_Поступления
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВЫРАЗИТЬ(ОстаткиТоваровКомпании.Регистратор КАК Документ.ПоступлениеТоваров) КАК Документ,
	               |		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
	               |		ОстаткиТоваровКомпании.Количество КАК Поступило
	               |	ИЗ
	               |		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |			ПО ОстаткиТоваровКомпании.Регистратор = Корректировка.ДокументОснование
	               |				И (Корректировка.Проведен)
	               |	ГДЕ
	               |		ОстаткиТоваровКомпании.СкладКомпании = &СкладКомпании
	               |		И ОстаткиТоваровКомпании.Регистратор ССЫЛКА Документ.ПоступлениеТоваров
	               |		И Корректировка.Ссылка ЕСТЬ NULL 
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ВЫРАЗИТЬ(ОстаткиТоваровКомпании.Регистратор КАК Документ.КорректировкаПоступления).ДокументОснование,
	               |		ОстаткиТоваровКомпании.Номенклатура,
	               |		ОстаткиТоваровКомпании.Количество
	               |	ИЗ
	               |		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |			ПО ОстаткиТоваровКомпании.Регистратор = Корректировка.ДокументОснование
	               |				И (Корректировка.Проведен)
	               |	ГДЕ
	               |		ОстаткиТоваровКомпании.СкладКомпании = &СкладКомпании
	               |		И Корректировка.Ссылка ЕСТЬ NULL 
	               |		И ОстаткиТоваровКомпании.Регистратор ССЫЛКА Документ.КорректировкаПоступления) КАК ПоступленияПодготовка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступленияПодготовка.Документ,
	               |	ПоступленияПодготовка.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(ВТ_Поступления.Документ, ВТ_Размещено.Документ) КАК Документ,
				   |	ЕСТЬNULL(ВТ_Поступления.Документ.Номер, ВТ_Размещено.Документ.Номер) КАК Номер,
	               |	СУММА(ЕСТЬNULL(ВТ_Поступления.Поступило, 0) - ЕСТЬNULL(ВТ_Размещено.Размещено, 0)) КАК Количество
	               |ИЗ
	               |	ВТ_Поступления КАК ВТ_Поступления
	               |		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Размещено КАК ВТ_Размещено
	               |		ПО ВТ_Поступления.Документ = ВТ_Размещено.Документ
	               |			И ВТ_Поступления.Номенклатура = ВТ_Размещено.Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЕСТЬNULL(ВТ_Поступления.Документ, ВТ_Размещено.Документ),
				   |    ЕСТЬNULL(ВТ_Поступления.Документ.Номер, ВТ_Размещено.Документ.Номер)";
	
	СписокДокументовТЗ = Запрос.Выполнить().Выгрузить();	
	
	ДокументыМасс = СписокДокументовТЗ.ВыгрузитьКолонку("Документ");
	
	// Подменяем док. корректировок на поступления
	
	ПоступленияКорректировки = Новый Соответствие;
	
	Для каждого Док Из ДокументыМасс Цикл
	
		Если ТипЗнч(Док) <> Тип("ДокументСсылка.КорректировкаПоступления") Тогда
			Продолжить;
		КонецЕсли;
		
		тДок = Док;
		Сч = 0;
		Пока ТипЗнч(тДок) <> Тип("ДокументСсылка.ПоступлениеТоваров") Цикл
			тДок = тДок.ДокументОснование;
			
			Сч = Сч + 1;
			Если Сч > 50 Тогда // Предполагаем, что больше 50ти корректировок не может быть
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ПоступленияКорректировки.Вставить(Док, тДок);
		
	КонецЦикла;
	
	Для каждого КлючЗначение Из ПоступленияКорректировки Цикл
		
		Отбор = Новый Структура("Документ", КлючЗначение.Ключ);
		
		Для каждого стр Из СписокДокументовТЗ.НайтиСтроки(Отбор) Цикл
			стр.Документ = КлючЗначение.Значение;
		КонецЦикла;	
		
	КонецЦикла;
	
	СписокДокументовТЗ.Свернуть("Документ", "Количество");
	
	// В результате свертки могут появится строки с нулевым или отрицательным количеством
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СписокДокументовТЗ", СписокДокументовТЗ);

    Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТ_СписокДокументов ИЗ &СписокДокументовТЗ КАК СписокДокументовТЗ ГДЕ СписокДокументовТЗ.Количество > 0;
					|ВЫБРАТЬ * ИЗ ВТ_СписокДокументов Упорядочить ПО Документ УБЫВ АВТОУПОРЯДОЧИВАНИЕ";

    СписокДокументов.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Процедура ОбновитьТоварыРазмещение(ДокПоступление) Экспорт

	Корректировки = ПолучитьКорректировкиПоПоступлению(ДокПоступление);
	
	Запрос = Новый Запрос;
			
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	Запрос.УстановитьПараметр("ДокПоступление", ДокПоступление);
	Запрос.УстановитьПараметр("Корректировки", Корректировки);
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеТоваров.Ссылка КАК Документ,
	               |	ОстаткиТоваровОрдерныйСклад.Номенклатура,
	               |	СУММА(ОстаткиТоваровОрдерныйСклад.Количество) КАК Размещено
	               |ПОМЕСТИТЬ ВТ_Размещено
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТоваровОрдерныйСклад КАК ОстаткиТоваровОрдерныйСклад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |		ПО ОстаткиТоваровОрдерныйСклад.Регистратор = Корректировка.ДокументОснование
	               |			И (Корректировка.Проведен)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	               |		ПО ОстаткиТоваровОрдерныйСклад.Регистратор.ДокументОснование = ПоступлениеТоваров.Ссылка
	               |			И (ОстаткиТоваровОрдерныйСклад.Регистратор ССЫЛКА Документ.ПриходныйСкладскойОрдер)
	               |			И (ОстаткиТоваровОрдерныйСклад.СкладКомпании = &СкладКомпании)
	               |			И (ПоступлениеТоваров.Ссылка = &ДокПоступление)
	               |ГДЕ
	               |	Корректировка.Ссылка ЕСТЬ NULL 
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиТоваровОрдерныйСклад.Номенклатура,
	               |	ПоступлениеТоваров.Ссылка
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоступленияПодготовка.Документ,
	               |	ПоступленияПодготовка.Номенклатура,
	               |	СУММА(ПоступленияПодготовка.Поступило) КАК Поступило
	               |ПОМЕСТИТЬ ВТ_Поступления
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВЫРАЗИТЬ(&ДокПоступление КАК Документ.ПоступлениеТоваров) КАК Документ,
	               |		ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
	               |		ОстаткиТоваровКомпании.Количество КАК Поступило
	               |	ИЗ
	               |		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |			ПО ОстаткиТоваровКомпании.Регистратор = Корректировка.ДокументОснование
	               |				И (Корректировка.Проведен)
	               |	ГДЕ
	               |		ОстаткиТоваровКомпании.СкладКомпании = &СкладКомпании
	               |		И Корректировка.Ссылка ЕСТЬ NULL 
	               |		И ОстаткиТоваровКомпании.Регистратор = &ДокПоступление
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ВЫРАЗИТЬ(&ДокПоступление КАК Документ.ПоступлениеТоваров),
	               |		ОстаткиТоваровКомпании.Номенклатура,
	               |		ОстаткиТоваровКомпании.Количество
	               |	ИЗ
	               |		РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |			ПО ОстаткиТоваровКомпании.Регистратор = Корректировка.ДокументОснование
	               |				И (Корректировка.Проведен)
	               |	ГДЕ
	               |		ОстаткиТоваровКомпании.СкладКомпании = &СкладКомпании
	               |		И Корректировка.Ссылка ЕСТЬ NULL 
	               |		И ОстаткиТоваровКомпании.Регистратор В(&Корректировки)) КАК ПоступленияПодготовка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПоступленияПодготовка.Документ,
	               |	ПоступленияПодготовка.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Поступления.Документ КАК Документ,
	               |	ВТ_Поступления.Номенклатура КАК Номенклатура,
	               |	ВТ_Поступления.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент КАК Коэффициент,
	               |	ВТ_Поступления.Поступило - ЕСТЬNULL(ВТ_Размещено.Размещено, 0) КАК КоличествоБазовое,
	               |	ВЫБОР
	               |		КОГДА ВТ_Поступления.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ (ВТ_Поступления.Поступило - ЕСТЬNULL(ВТ_Размещено.Размещено, 0)) / ВТ_Поступления.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ВТ_Поступления.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		ИНАЧЕ (ВТ_Поступления.Поступило - ЕСТЬNULL(ВТ_Размещено.Размещено, 0)) / ВТ_Поступления.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ КАК КоличествоОбщ,
	               |	ВТ_Поступления.Номенклатура.Артикул КАК Артикул,
	               |	ИСТИНА КАК Выбран
	               |ИЗ
	               |	ВТ_Поступления КАК ВТ_Поступления
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Размещено КАК ВТ_Размещено
	               |		ПО ВТ_Поступления.Документ = ВТ_Размещено.Документ
	               |			И ВТ_Поступления.Номенклатура = ВТ_Размещено.Номенклатура
	               |ГДЕ
	               |	ЕСТЬNULL(ВТ_Поступления.Поступило, 0) > ЕСТЬNULL(ВТ_Размещено.Размещено, 0)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
	Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура РаспределитьПоЯчейкамРасход() Экспорт

	Запрос = Новый Запрос;
	
	Товары.Свернуть("Артикул, Коэффициент, Номенклатура, Документ, ЗаказНаряд, Статус, Выбран, КоличествоОбщ", "Количество, КоличествоБазовое");
	
	Запрос.УстановитьПараметр("СписокНоменклатуры", Товары.ВыгрузитьКолонку("Номенклатура"));
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
			
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиТоваровОрдерныйСкладОбороты.Номенклатура КАК Номенклатура,
	               |	ВЫРАЗИТЬ(ОстаткиТоваровОрдерныйСкладОбороты.Регистратор КАК Документ.РасходныйСкладскойОрдер) КАК Регистратор
	               |ПОМЕСТИТЬ ВТ_РасходЯчейкаПодготовка
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТоваровОрдерныйСклад.Обороты(
	               |			,
	               |			,
	               |			Регистратор,
	               |			СкладКомпании = &СкладКомпании
	               |				И Номенклатура В (&СписокНоменклатуры)) КАК ОстаткиТоваровОрдерныйСкладОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |		ПО ОстаткиТоваровОрдерныйСкладОбороты.Регистратор = Корректировка.ДокументОснование
	               |			И (Корректировка.Проведен)
	               |ГДЕ
	               |	ОстаткиТоваровОрдерныйСкладОбороты.КоличествоРасход > 0
	               |	И ОстаткиТоваровОрдерныйСкладОбороты.Регистратор ССЫЛКА Документ.РасходныйСкладскойОрдер
	               |	И Корректировка.Ссылка ЕСТЬ NULL 
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиТоваровОрдерныйСкладОбороты.Номенклатура,
	               |	ОстаткиТоваровОрдерныйСкладОбороты.Регистратор
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_РасходЯчейкаПодготовка.Номенклатура,
	               |	ВТ_РасходЯчейкаПодготовка.Регистратор,
	               |	СУММА(ВЫБОР
	               |			КОГДА ВТ_РасходЯчейкаПодготовкаДО.Номенклатура ЕСТЬ NULL 
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) КАК КолвоДО
	               |ПОМЕСТИТЬ ВТ_РасходЯчейкаПодготовка2
	               |ИЗ
	               |	ВТ_РасходЯчейкаПодготовка КАК ВТ_РасходЯчейкаПодготовка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасходЯчейкаПодготовка КАК ВТ_РасходЯчейкаПодготовкаДО
	               |		ПО ВТ_РасходЯчейкаПодготовка.Номенклатура = ВТ_РасходЯчейкаПодготовкаДО.Номенклатура
	               |			И ВТ_РасходЯчейкаПодготовка.Регистратор.МоментВремени > ВТ_РасходЯчейкаПодготовкаДО.Регистратор.МоментВремени
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_РасходЯчейкаПодготовка.Номенклатура,
	               |	ВТ_РасходЯчейкаПодготовка.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_РасходЯчейкаПодготовка2.Номенклатура КАК Номенклатура,
	               |	ОстаткиТоваровОрдерныйСклад.Ячейка КАК Ячейка
	               |ИЗ
	               |	ВТ_РасходЯчейкаПодготовка2 КАК ВТ_РасходЯчейкаПодготовка2
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_РасходЯчейкаПодготовка2.Номенклатура КАК Номенклатура,
	               |			МАКСИМУМ(ВТ_РасходЯчейкаПодготовка2.КолвоДО) КАК КолвоДО
	               |		ИЗ
	               |			ВТ_РасходЯчейкаПодготовка2 КАК ВТ_РасходЯчейкаПодготовка2
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_РасходЯчейкаПодготовка2.Номенклатура) КАК ВложенныйЗапрос
	               |		ПО ВТ_РасходЯчейкаПодготовка2.Номенклатура = ВложенныйЗапрос.Номенклатура
	               |			И ВТ_РасходЯчейкаПодготовка2.КолвоДО = ВложенныйЗапрос.КолвоДО
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровОрдерныйСклад КАК ОстаткиТоваровОрдерныйСклад
	               |		ПО ВТ_РасходЯчейкаПодготовка2.Регистратор = ОстаткиТоваровОрдерныйСклад.Регистратор
	               |			И ВТ_РасходЯчейкаПодготовка2.Номенклатура = ОстаткиТоваровОрдерныйСклад.Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_РасходЯчейкаПодготовка2.Номенклатура,
	               |	ОстаткиТоваровОрдерныйСклад.Ячейка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОстаткиТоваровОрдерныйСкладОстатки.Номенклатура,
	               |	ОстаткиТоваровОрдерныйСкладОстатки.Ячейка,
	               |	ОстаткиТоваровОрдерныйСкладОстатки.КоличествоОстаток КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТоваровОрдерныйСклад.Остатки(
	               |			,
	               |			СкладКомпании = &СкладКомпании
	               |				И Номенклатура В (&СписокНоменклатуры)) КАК ОстаткиТоваровОрдерныйСкладОстатки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Остаток УБЫВ";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ПриоритетныеЯчейки = Результат[2].Выгрузить();
	ТаблицаЯчейки = Результат[3].Выгрузить();
	
	Для Сч=0 По Товары.Количество()-1 Цикл
		
		СтрокаТовары = Товары[Сч];
		
		ОтборНоменклатура = Новый Структура("Номенклатура", СтрокаТовары.Номенклатура);
		
		Если ТаблицаЯчейки.НайтиСтроки(ОтборНоменклатура).Количество() > 0 Тогда
			
			РедактируемаяСтрока = СтрокаТовары;
			
			ОсталосьРаспределить = РедактируемаяСтрока.КоличествоБазовое;
			
			// Сначала распределяем по приоритетным ячейкам
			
			Найдено = ПриоритетныеЯчейки.НайтиСтроки(ОтборНоменклатура);
			
			Для каждого стрПрЯчейка Из Найдено Цикл
				
				Если ОсталосьРаспределить <= 0 Тогда
					Прервать;
				КонецЕсли;
				
				стрОст = ТаблицаЯчейки.НайтиСтроки(Новый Структура("Номенклатура, Ячейка", СтрокаТовары.Номенклатура, стрПрЯчейка.Ячейка));
				
				Если стрОст.Количество() > 0 Тогда
					Если стрОст[0].Остаток >= ОсталосьРаспределить Тогда
						// ОК
						ОсталосьРаспределить = 0;
						РедактируемаяСтрока.ЯчейкаХранения = стрОст[0].Ячейка;
					Иначе
						// Разбиваем строку
						
						ОсталосьРаспределить = ОсталосьРаспределить - стрОст[0].Остаток;
						
						РедактируемаяСтрока.ЯчейкаХранения = стрОст[0].Ячейка;
						РедактируемаяСтрока.КоличествоБазовое = стрОст[0].Остаток;
						
						НС = Товары.Добавить();
						ЗаполнитьЗначенияСвойств(НС, РедактируемаяСтрока,, "Количество, КоличествоБазовое, ЯчейкаХранения");
						
						НС.КоличествоБазовое = ОсталосьРаспределить;
						
						РедактируемаяСтрока = НС;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если ОсталосьРаспределить <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			// Распределение по остальным ячейкам
			
			Для каждого стрОстаткиЯчейка Из ТаблицаЯчейки.НайтиСтроки(ОтборНоменклатура) Цикл
				
				Если ОсталосьРаспределить <= 0 Тогда
					Прервать;
				КонецЕсли;
				
				Отбор = Новый Структура("Номенклатура, Ячейка", РедактируемаяСтрока.Номенклатура, стрОстаткиЯчейка.Ячейка);
				Если ПриоритетныеЯчейки.НайтиСтроки(Отбор).Количество() > 0 Тогда
					Продолжить; // распределено выше
				КонецЕсли;
				
				Если стрОстаткиЯчейка.Остаток >= ОсталосьРаспределить Тогда
					// ОК
					ОсталосьРаспределить = 0;
					РедактируемаяСтрока.ЯчейкаХранения = стрОстаткиЯчейка.Ячейка;
				Иначе
					// Разбиваем строку
					
					ОсталосьРаспределить = ОсталосьРаспределить - стрОстаткиЯчейка.Остаток;
					
					РедактируемаяСтрока.ЯчейкаХранения = стрОстаткиЯчейка.Ячейка;
					РедактируемаяСтрока.КоличествоБазовое = стрОстаткиЯчейка.Остаток;
					
					НС = Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НС, РедактируемаяСтрока,, "Количество, КоличествоБазовое, ЯчейкаХранения");
					
					НС.КоличествоБазовое = ОсталосьРаспределить;
					
					РедактируемаяСтрока = НС;
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;	
	КонецЦикла;
	
	Товары.Сортировать("Номенклатура");
	
	// Заполняем количество
	Для каждого СтрокаТовары Из Товары Цикл
		СтрокаТовары.Количество = ?(СтрокаТовары.Коэффициент = 0, 0, СтрокаТовары.КоличествоБазовое / СтрокаТовары.Коэффициент);
	КонецЦикла;

КонецПроцедуры

Процедура РаспределитьПоЯчейкамПриход() Экспорт

	// Заполняем ячейками, в которые последний раз ложили
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Товары", Товары.Выгрузить());
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);

	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ПОМЕСТИТЬ ВТ_Товары
	               |ИЗ
	               |	&Товары КАК Товары
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОстаткиТоваровОрдерныйСкладОбороты.Номенклатура КАК Номенклатура,
	               |	ВЫРАЗИТЬ(ОстаткиТоваровОрдерныйСкладОбороты.Регистратор КАК Документ.ПриходныйСкладскойОрдер) КАК Регистратор
	               |ПОМЕСТИТЬ ВТ_РасходЯчейкаПодготовка
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТоваровОрдерныйСклад.Обороты(
	               |			,
	               |			,
	               |			Регистратор,
	               |			СкладКомпании = &СкладКомпании
	               |				И Номенклатура В
	               |					(ВЫБРАТЬ
	               |						ВТ_Товары.Номенклатура
	               |					ИЗ
	               |						ВТ_Товары КАК ВТ_Товары)) КАК ОстаткиТоваровОрдерныйСкладОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
	               |		ПО ОстаткиТоваровОрдерныйСкладОбороты.Регистратор = Корректировка.ДокументОснование
	               |			И (Корректировка.Проведен)
	               |ГДЕ
	               |	ОстаткиТоваровОрдерныйСкладОбороты.КоличествоПриход > 0
	               |	И ОстаткиТоваровОрдерныйСкладОбороты.Регистратор ССЫЛКА Документ.ПриходныйСкладскойОрдер
	               |	И Корректировка.Ссылка ЕСТЬ NULL 
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиТоваровОрдерныйСкладОбороты.Номенклатура,
	               |	ОстаткиТоваровОрдерныйСкладОбороты.Регистратор
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_РасходЯчейкаПодготовка.Номенклатура,
	               |	ВТ_РасходЯчейкаПодготовка.Регистратор,
	               |	СУММА(ВЫБОР
	               |			КОГДА ВТ_РасходЯчейкаПодготовкаДО.Номенклатура ЕСТЬ NULL 
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) КАК КолвоДО
	               |ПОМЕСТИТЬ ВТ_РасходЯчейкаПодготовка2
	               |ИЗ
	               |	ВТ_РасходЯчейкаПодготовка КАК ВТ_РасходЯчейкаПодготовка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасходЯчейкаПодготовка КАК ВТ_РасходЯчейкаПодготовкаДО
	               |		ПО ВТ_РасходЯчейкаПодготовка.Номенклатура = ВТ_РасходЯчейкаПодготовкаДО.Номенклатура
	               |			И ВТ_РасходЯчейкаПодготовка.Регистратор.МоментВремени > ВТ_РасходЯчейкаПодготовкаДО.Регистратор.МоментВремени
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_РасходЯчейкаПодготовка.Номенклатура,
	               |	ВТ_РасходЯчейкаПодготовка.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_РасходЯчейкаПодготовка2.Номенклатура КАК Номенклатура,
	               |	МАКСИМУМ(ОстаткиТоваровОрдерныйСклад.Ячейка) КАК ЯчейкаРазмещение
	               |ПОМЕСТИТЬ ВТ_ЯчейкиРазмещение
	               |ИЗ
	               |	ВТ_РасходЯчейкаПодготовка2 КАК ВТ_РасходЯчейкаПодготовка2
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_РасходЯчейкаПодготовка2.Номенклатура КАК Номенклатура,
	               |			МАКСИМУМ(ВТ_РасходЯчейкаПодготовка2.КолвоДО) КАК КолвоДО
	               |		ИЗ
	               |			ВТ_РасходЯчейкаПодготовка2 КАК ВТ_РасходЯчейкаПодготовка2
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_РасходЯчейкаПодготовка2.Номенклатура) КАК ВложенныйЗапрос
	               |		ПО ВТ_РасходЯчейкаПодготовка2.Номенклатура = ВложенныйЗапрос.Номенклатура
	               |			И ВТ_РасходЯчейкаПодготовка2.КолвоДО = ВложенныйЗапрос.КолвоДО
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваровОрдерныйСклад КАК ОстаткиТоваровОрдерныйСклад
	               |		ПО ВТ_РасходЯчейкаПодготовка2.Регистратор = ОстаткиТоваровОрдерныйСклад.Регистратор
	               |			И ВТ_РасходЯчейкаПодготовка2.Номенклатура = ОстаткиТоваровОрдерныйСклад.Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_РасходЯчейкаПодготовка2.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЯчейкиРазмещение КАК ВТ_ЯчейкиРазмещение
	               |		ПО ВТ_Товары.Номенклатура = ВТ_ЯчейкиРазмещение.Номенклатура";
	
	ТоварыНовый = Запрос.Выполнить().Выгрузить();	
	
	ТоварыНовый.Колонки.Удалить("ЯчейкаХранения");
	
	КолЯч = ТоварыНовый.Колонки.Найти("ЯчейкаРазмещение");
	КолЯч.Имя = "ЯчейкаХранения";
	
	Товары.Загрузить(ТоварыНовый);
	
КонецПроцедуры

Функция ПолучитьКорректировкиПоПоступлению(ДокПоступление) Экспорт

	ВозвращаемоеЗначение = Новый Массив;
	
	тДок = ДокПоступление;
	Пока Истина Цикл
	
		ДокКорр = Документы.КорректировкаПоступления.НайтиПоРеквизиту("ДокументОснование", тДок);
		
		Если ДокКорр.Пустая() Тогда
			Прервать;
		Иначе	
			ВозвращаемоеЗначение.Добавить(ДокКорр);
		КонецЕсли;
		
		тДок = ДокКорр;
		
	КонецЦикла;

	Возврат ВозвращаемоеЗначение;
	
КонецФункции // ПолучитьКорректировкиПоПоступлению()


