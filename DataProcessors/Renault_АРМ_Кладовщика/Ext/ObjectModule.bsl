Перем АвтоПечатьПикингЛиста Экспорт;

Процедура ОбновитьДокументыВыдачи() Экспорт

    Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	//Запрос.УстановитьПараметр("СкладРеализации", ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.Запчасти_СкладРеализации);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыПокупателейОстатки.Номенклатура,
	               |	ЗаказыПокупателейОстатки.Заказ КАК Заказ,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказПокупателя).Контрагент КАК Контрагент,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказПокупателя).ДокументОснование КАК ДокументОснование,
	               |	ЗаказыПокупателейОстатки.РезервОстаток,
	               |	ЗаказыПокупателейОстатки.СкладКомпании КАК СкладКомпании,
	               |	ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказПокупателя).Renault_Advanced_СкладРеализации КАК СкладРеализации
	               |ПОМЕСТИТЬ ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПокупателей.Остатки(
	               |			,
	               |			СкладКомпании = &СкладКомпании
	               |				И Заказ ССЫЛКА Документ.ЗаказПокупателя) КАК ЗаказыПокупателейОстатки
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Заказ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(КорректировкаЗаказаПокупателя.ДокументОснование КАК Документ.ЗаказПокупателя) КАК Заказ,
	               |	КорректировкаЗаказаПокупателя.МоментВремени КАК МоментВремени
	               |ПОМЕСТИТЬ КорректировкиПодготовка
	               |ИЗ
	               |	Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
	               |ГДЕ
	               |	КорректировкаЗаказаПокупателя.Проведен
	               |	И КорректировкаЗаказаПокупателя.ДокументОснование В
	               |			(ВЫБРАТЬ
	               |				ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.Заказ
	               |			ИЗ
	               |				ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка КАК ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Заказ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КорректировкиПодготовка.Заказ,
	               |	КорректировкиПодготовкаПосле.МоментВремени КАК МоментВремениКорректировки
	               |ПОМЕСТИТЬ ПоследниеКорректировки
	               |ИЗ
	               |	КорректировкиПодготовка КАК КорректировкиПодготовка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КорректировкиПодготовка КАК КорректировкиПодготовкаПосле
	               |		ПО КорректировкиПодготовка.Заказ = КорректировкиПодготовкаПосле.Заказ
	               |			И КорректировкиПодготовка.МоментВремени < КорректировкиПодготовкаПосле.МоментВремени
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КорректировкиПодготовка.Заказ,
	               |	КорректировкиПодготовкаПосле.МоментВремени
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ВЫБОР
	               |			КОГДА КорректировкиПодготовкаПосле.МоментВремени ЕСТЬ NULL
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) = 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.Номенклатура,
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.Заказ КАК Заказ,
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.Контрагент,
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.ДокументОснование,
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.РезервОстаток,
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.СкладКомпании,
	               |	ВЫБОР
	               |		КОГДА КорректировкаЗаказаПокупателя.Ссылка ЕСТЬ NULL
	               |			ТОГДА ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.СкладРеализации
	               |		ИНАЧЕ КорректировкаЗаказаПокупателя.Renault_Advanced_СкладРеализации
	               |	КОНЕЦ КАК СкладРеализации
	               |ПОМЕСТИТЬ ВТ_ЗаказыПокупателейОстаткиДетально
	               |ИЗ
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка КАК ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПоследниеКорректировки КАК ПоследниеКорректировки
	               |		ПО ВТ_ЗаказыПокупателейОстаткиДетальноПодготовка.Заказ = ПоследниеКорректировки.Заказ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КорректировкаЗаказаПокупателя КАК КорректировкаЗаказаПокупателя
	               |		ПО (ПоследниеКорректировки.МоментВремениКорректировки = КорректировкаЗаказаПокупателя.МоментВремени)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Заказ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.Заказ,
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.ДокументОснование КАК ДокументОснование
	               |ПОМЕСТИТЬ ВТ_Заказы
	               |ИЗ
	               |	ВТ_ЗаказыПокупателейОстаткиДетально КАК ВТ_ЗаказыПокупателейОстаткиДетально
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.Заказ,
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.ДокументОснование
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Заказы.Заказ КАК Заказ,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ВТ_Заказы.ДокументОснование ССЫЛКА Документ.ЗаказНаряд
	               |				ТОГДА ВЫРАЗИТЬ(ВТ_Заказы.ДокументОснование КАК Документ.ЗаказНаряд)
	               |			КОГДА НЕ ЗаказНаряд.Ссылка ЕСТЬ NULL
	               |				ТОГДА ЗаказНаряд.Ссылка
	               |			КОГДА НЕ ЗаказНарядНаОснованииЗаказа.Ссылка ЕСТЬ NULL
	               |				ТОГДА ЗаказНарядНаОснованииЗаказа.Ссылка
	               |			КОГДА НЕ Renault_CRM_ЗаявкаНаСервисСчетаНаОплату.Ссылка.ЗаказНаряд ЕСТЬ NULL
	               |				ТОГДА Renault_CRM_ЗаявкаНаСервисСчетаНаОплату.Ссылка.ЗаказНаряд
	               |			ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |		КОНЕЦ) КАК ЗаказНаряд
	               |ПОМЕСТИТЬ ВТ_ЗаказНарядыПоЗаказам
	               |ИЗ
	               |	ВТ_Заказы КАК ВТ_Заказы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис.СчетаНаОплату КАК Renault_CRM_ЗаявкаНаСервисСчетаНаОплату
	               |		ПО ВТ_Заказы.ДокументОснование = Renault_CRM_ЗаявкаНаСервисСчетаНаОплату.СчетНаОплату
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНарядНаОснованииЗаказа
	               |		ПО ВТ_Заказы.Заказ = ЗаказНарядНаОснованииЗаказа.ДокументОснование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряд
	               |		ПО ВТ_Заказы.ДокументОснование = ЗаказНаряд.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Заказы.Заказ
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Заказ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.Номенклатура КАК Номенклатура,
	               |	ВТ_ЗаказНарядыПоЗаказам.ЗаказНаряд КАК ЗаказНаряд
	               |ПОМЕСТИТЬ ВТ_НоменклатураЗаказНаряды
	               |ИЗ
	               |	ВТ_ЗаказыПокупателейОстаткиДетально КАК ВТ_ЗаказыПокупателейОстаткиДетально
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЗаказНарядыПоЗаказам КАК ВТ_ЗаказНарядыПоЗаказам
	               |		ПО ВТ_ЗаказыПокупателейОстаткиДетально.Заказ = ВТ_ЗаказНарядыПоЗаказам.Заказ
	               |			И (ВТ_ЗаказНарядыПоЗаказам.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка))
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура,
	               |	ЗаказНаряд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(ЗаказыПокупателейОстатки.ЗаказаноОстаток, 0) КАК ЗаказаноВРемзону,
	               |	ВТ_НоменклатураЗаказНаряды.ЗаказНаряд КАК ЗаказНаряд,
	               |	ВТ_НоменклатураЗаказНаряды.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ВТ_ЗаказаноВРемзоны
	               |ИЗ
	               |	ВТ_НоменклатураЗаказНаряды КАК ВТ_НоменклатураЗаказНаряды
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Остатки(
	               |				,
	               |				Заказ ССЫЛКА Документ.ЗаказВнутренний
	               |					И (Номенклатура, Заказ.ДокументОснование) В
	               |						(ВЫБРАТЬ
	               |							ВТ_НоменклатураЗаказНаряды.Номенклатура,
	               |							ВТ_НоменклатураЗаказНаряды.ЗаказНаряд
	               |						ИЗ
	               |							ВТ_НоменклатураЗаказНаряды КАК ВТ_НоменклатураЗаказНаряды)) КАК ЗаказыПокупателейОстатки
	               |		ПО ВТ_НоменклатураЗаказНаряды.Номенклатура = ЗаказыПокупателейОстатки.Номенклатура
	               |			И ВТ_НоменклатураЗаказНаряды.ЗаказНаряд = ЗаказыПокупателейОстатки.Заказ.ДокументОснование
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ЗаказНаряд,
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.Номенклатура,
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.Заказ,
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.Контрагент,
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.ДокументОснование,
	               |	ВЫБОР
	               |		КОГДА ВТ_ЗаказНарядыПоЗаказам.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВТ_ЗаказыПокупателейОстаткиДетально.РезервОстаток > ЕСТЬNULL(ВТ_ЗаказаноВРемзоны.ЗаказаноВРемзону, 0)
	               |						ТОГДА ЕСТЬNULL(ВТ_ЗаказаноВРемзоны.ЗаказаноВРемзону, 0)
	               |					ИНАЧЕ ВТ_ЗаказыПокупателейОстаткиДетально.РезервОстаток
	               |				КОНЕЦ
	               |		ИНАЧЕ ВТ_ЗаказыПокупателейОстаткиДетально.РезервОстаток
	               |	КОНЕЦ КАК Количество,
	               |	ВТ_ЗаказыПокупателейОстаткиДетально.СкладКомпании,
	               |	ВТ_ЗаказНарядыПоЗаказам.ЗаказНаряд
	               |ПОМЕСТИТЬ ВТ_ЗаказыПокупателейОстаткиДетальноСЗаказамиВРемзону
	               |ИЗ
	               |	ВТ_ЗаказыПокупателейОстаткиДетально КАК ВТ_ЗаказыПокупателейОстаткиДетально
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЗаказНарядыПоЗаказам КАК ВТ_ЗаказНарядыПоЗаказам
	               |		ПО ВТ_ЗаказыПокупателейОстаткиДетально.Заказ = ВТ_ЗаказНарядыПоЗаказам.Заказ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказаноВРемзоны КАК ВТ_ЗаказаноВРемзоны
	               |		ПО ВТ_ЗаказыПокупателейОстаткиДетально.Номенклатура = ВТ_ЗаказаноВРемзоны.Номенклатура
	               |			И (ВТ_ЗаказНарядыПоЗаказам.ЗаказНаряд = ВТ_ЗаказаноВРемзоны.ЗаказНаряд)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗаказыПокупателейОстаткиДетальноСЗаказамиВРемзону.Номенклатура,
