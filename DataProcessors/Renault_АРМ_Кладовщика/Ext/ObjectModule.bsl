	               |ПОМЕСТИТЬ ВТ_Подготовка
	               |ИЗ
	               |	ВТ_ЗаказыПокупателейОстатки КАК ЗаказыПокупателейОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыПокупателейОстатки.Заказ,
	               |	ЗаказыПокупателейОстатки.ЗаказНаряд,
	               |	ЗаказыПокупателейОстатки.ЗаказНаряд.ВидРемонта
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ЗаказНаряд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТИтоговая.Документ КАК Документ,
	               |	ВТИтоговая.ЗаказНаряд,
	               |	ВТИтоговая.ЗаказНаряд.Номер КАК НомерЗаказаНаряда,
	               |	ВТИтоговая.Документ.Номер КАК Номер,
	               |	ВЫБОР
	               |		КОГДА Renault_ВидыРемонтаДопРеквизиты.ВидРемонта ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ Renault_ВидыРемонтаДопРеквизиты.ГарантияЗавода
	               |	КОНЕЦ КАК ТипЗН,
	               |	ВТИтоговая.Документ.Контрагент КАК Контрагент
	               |ИЗ
	               |	ВТ_Подготовка КАК ВТИтоговая
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВТ_ВозможноОтгрузить.Заказ КАК Заказ,
	               |			СУММА(ВТ_ВозможноОтгрузить.Количество) КАК Количество
	               |		ИЗ
	               |			ВТ_ВозможноОтгрузить КАК ВТ_ВозможноОтгрузить
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ВТ_ВозможноОтгрузить.Заказ) КАК ВозможноОтгрузить
	               |		ПО ВТИтоговая.Документ = ВозможноОтгрузить.Заказ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ВидыРемонтаДопРеквизиты КАК Renault_ВидыРемонтаДопРеквизиты
	               |		ПО ВТИтоговая.ЗаказНарядВидРемонта = Renault_ВидыРемонтаДопРеквизиты.ВидРемонта
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ВТИтоговая.ЗаказНаряд = ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |					И ВозможноОтгрузить.Количество ЕСТЬ NULL
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Документ УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ";

    СписокДокументов.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Процедура ОбновитьТоварыНаВыдачу(ЗаказПокупателя, ЗаказНаряд) Экспорт

	Товары.Очистить();
	
    Запрос = Новый Запрос;
	
    Запрос.УстановитьПараметр("СкладКомпании", ЭтотОбъект.СкладКомпании);
	Запрос.УстановитьПараметр("СкладРеализации", Обработки.Renault_Advanced_АРМ_Реализации.ПолучитьРеквизит(ЗаказПокупателя,"Renault_Advanced_СкладРеализации"));
    Запрос.УстановитьПараметр("Заказ", ЗаказПокупателя);
	Запрос.УстановитьПараметр("Контрагент", ЗаказПокупателя.Контрагент);
	Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыПокупателейОстатки.Заказ КАК Документ,
	               |	&ЗаказНаряд,
	               |	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |				ИЛИ ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ КАК Коэффициент,
	               |	МАКСИМУМ(ЗаказыПокупателейОстатки.РезервОстаток) КАК КоличествоБазовое,
	               |	ЗаказыПокупателейОстатки.Номенклатура.Артикул КАК Артикул,
	               |	ИСТИНА КАК Выбран
	               |ПОМЕСТИТЬ ВТ_ЗаказыОстатки
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПокупателей.Остатки(
	               |			,
	               |			СкладКомпании = &СкладКомпании
	               |				И Заказ = &Заказ
	               |				И Контрагент = &Контрагент) КАК ЗаказыПокупателейОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказыПокупателейОстатки.Номенклатура,
	               |	ЗаказыПокупателейОстатки.Заказ,
	               |	ЗаказыПокупателейОстатки.Номенклатура.Артикул,
	               |	ВЫБОР
	               |		КОГДА ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент ЕСТЬ NULL 
	               |				ИЛИ ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент = 0
	               |			ТОГДА 1
	               |		ИНАЧЕ ЗаказыПокупателейОстатки.Номенклатура.ОсновнаяЕдиницаИзмерения.Коэффициент
	               |	КОНЕЦ
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВТ_ЗаказыОстатки.Номенклатура КАК Номенклатура,
	               |	ВТ_ЗаказыОстатки.ЗаказНаряд КАК ЗаказНаряд
	               |ПОМЕСТИТЬ ВТ_НоменклатураЗаказНаряды
	               |ИЗ
	               |	ВТ_ЗаказыОстатки КАК ВТ_ЗаказыОстатки
	               |ГДЕ
	               |	ВТ_ЗаказыОстатки.ЗаказНаряд ССЫЛКА Документ.ЗаказНаряд
	               |	И ВТ_ЗаказыОстатки.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(ЗаказыПокупателейОстатки.ЗаказаноОстаток, 0) КАК ЗаказаноВРемзону,
	               |	ВТ_НоменклатураЗаказНаряды.ЗаказНаряд КАК ЗаказНаряд,
	               |	ВТ_НоменклатураЗаказНаряды.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ВТ_ЗаказаноВРемзоны
	               |ИЗ
	               |	ВТ_НоменклатураЗаказНаряды КАК ВТ_НоменклатураЗаказНаряды
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Остатки(
	               |				,
	               |				Заказ ССЫЛКА Документ.ЗаказВнутренний
	               |					И (Номенклатура, ВЫБОР
	               |						КОГДА Заказ ССЫЛКА Документ.ЗаказВнутренний
	               |							ТОГДА ВЫРАЗИТЬ(Заказ КАК Документ.ЗаказВнутренний).ДокументОснование
	               |					КОНЕЦ) В
	               |						(ВЫБРАТЬ
	               |							ВТ_НоменклатураЗаказНаряды.Номенклатура,
	               |							ВТ_НоменклатураЗаказНаряды.ЗаказНаряд
	               |						ИЗ
	               |							ВТ_НоменклатураЗаказНаряды КАК ВТ_НоменклатураЗаказНаряды)) КАК ЗаказыПокупателейОстатки
	               |		ПО ВТ_НоменклатураЗаказНаряды.Номенклатура = ЗаказыПокупателейОстатки.Номенклатура
	               |			И (ВТ_НоменклатураЗаказНаряды.ЗаказНаряд = ВЫБОР
	               |				КОГДА ЗаказыПокупателейОстатки.Заказ ССЫЛКА Документ.ЗаказВнутренний
	               |					ТОГДА ВЫРАЗИТЬ(ЗаказыПокупателейОстатки.Заказ КАК Документ.ЗаказВнутренний).ДокументОснование
	               |			КОНЕЦ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗаказыОстатки.Документ,
	               |	ВТ_ЗаказыОстатки.ЗаказНаряд,
	               |	ВТ_ЗаказыОстатки.Номенклатура,
	               |	ВТ_ЗаказыОстатки.Коэффициент,
	               |	ВЫБОР
	               |		КОГДА ВТ_ЗаказыОстатки.ЗаказНаряд ССЫЛКА Документ.ЗаказНаряд
	               |				И ВТ_ЗаказыОстатки.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяССылка)
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВТ_ЗаказыОстатки.КоличествоБазовое > ЕСТЬNULL(ВТ_ЗаказаноВРемзоны.ЗаказаноВРемзону, 0)
	               |						ТОГДА ЕСТЬNULL(ВТ_ЗаказаноВРемзоны.ЗаказаноВРемзону, 0)
	               |					ИНАЧЕ ВТ_ЗаказыОстатки.КоличествоБазовое
	               |				КОНЕЦ
	               |		ИНАЧЕ ВТ_ЗаказыОстатки.КоличествоБазовое
	               |	КОНЕЦ КАК КоличествоБазовое,
	               |	ВТ_ЗаказыОстатки.Артикул,
	               |	ВТ_ЗаказыОстатки.Выбран
	               |ПОМЕСТИТЬ ВТ_ЗаказыОстаткиЗаказаноВРемзону
	               |ИЗ
	               |	ВТ_ЗаказыОстатки КАК ВТ_ЗаказыОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказаноВРемзоны КАК ВТ_ЗаказаноВРемзоны
	               |		ПО ВТ_ЗаказыОстатки.ЗаказНаряд = ВТ_ЗаказаноВРемзоны.ЗаказНаряд
	               |			И ВТ_ЗаказыОстатки.Номенклатура = ВТ_ЗаказаноВРемзоны.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИнформацияПоСтрокамЗаказа.Номенклатура КАК Номенклатура,
	               |	СУММА(ИнформацияПоСтрокамЗаказа.КоличествоЗаказаноНаСкладРеализации - ИнформацияПоСтрокамЗаказа.КоличествоОтгруженоНаСкладРеализации) КАК Количество
	               |ПОМЕСТИТЬ ВТ_ЗаказаноМагазин
	               |ИЗ
	               |	РегистрСведений.Renault_Advanced_ИнформацияПоСтрокамЗаказа КАК ИнформацияПоСтрокамЗаказа
	               |ГДЕ
	               |	ИнформацияПоСтрокамЗаказа.Заказ = &Заказ
	               |	И ИнформацияПоСтрокамЗаказа.Номенклатура В
	               |			(ВЫБРАТЬ
	               |				ВТ_ЗаказыОстатки.Номенклатура
	               |			ИЗ
	               |				ВТ_ЗаказыОстатки КАК ВТ_ЗаказыОстатки)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ИнформацияПоСтрокамЗаказа.Номенклатура
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ИнформацияПоСтрокамЗаказа.КоличествоЗаказаноНаСкладРеализации - ИнформацияПоСтрокамЗаказа.КоличествоОтгруженоНаСкладРеализации) > 0
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗаказыОстаткиЗаказаноВРемзону.Выбран,
	               |	ВТ_ЗаказыОстаткиЗаказаноВРемзону.Документ,
	               |	ВТ_ЗаказыОстаткиЗаказаноВРемзону.ЗаказНаряд,
	               |	ВТ_ЗаказыОстаткиЗаказаноВРемзону.Артикул,
	               |	ВТ_ЗаказыОстаткиЗаказаноВРемзону.Номенклатура,
	               |	ВТ_ЗаказыОстаткиЗаказаноВРемзону.Коэффициент,
	               |	ВЫБОР
	               |		КОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |			ТОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.КоличествоБазовое
	               |		ИНАЧЕ ЕСТЬNULL(ВТ_ЗаказаноМагазин.Количество, 0)
	               |	КОНЕЦ КАК КоличествоБазовое,
	               |	ВЫБОР
	               |		КОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |			ТОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.КоличествоБазовое / ВТ_ЗаказыОстаткиЗаказаноВРемзону.Коэффициент
	               |		ИНАЧЕ ЕСТЬNULL(ВТ_ЗаказаноМагазин.Количество, 0) / ВТ_ЗаказыОстаткиЗаказаноВРемзону.Коэффициент
	               |	КОНЕЦ КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |			ТОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.КоличествоБазовое / ВТ_ЗаказыОстаткиЗаказаноВРемзону.Коэффициент
	               |		ИНАЧЕ ЕСТЬNULL(ВТ_ЗаказаноМагазин.Количество, 0) / ВТ_ЗаказыОстаткиЗаказаноВРемзону.Коэффициент
	               |	КОНЕЦ КАК КоличествоОбщ
	               |ИЗ
	               |	ВТ_ЗаказыОстаткиЗаказаноВРемзону КАК ВТ_ЗаказыОстаткиЗаказаноВРемзону
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказаноМагазин КАК ВТ_ЗаказаноМагазин
	               |		ПО ВТ_ЗаказыОстаткиЗаказаноВРемзону.Номенклатура = ВТ_ЗаказаноМагазин.Номенклатура
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	               |			ПО спрНоменклатура.ОсновнаяЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	               |		ПО ВТ_ЗаказыОстаткиЗаказаноВРемзону.Номенклатура = спрНоменклатура.Ссылка
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.ЗаказНаряд <> ЗНАЧЕНИЕ(Документ.ЗаказНаряд.ПустаяСсылка)
	               |				ТОГДА ВТ_ЗаказыОстаткиЗаказаноВРемзону.КоличествоБазовое
	               |			ИНАЧЕ ЕСТЬNULL(ВТ_ЗаказаноМагазин.Количество, 0)
	               |		КОНЕЦ > 0";
	
    Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ОбновитьДокументыВозврата() Экспорт

    Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыВПроизводствеОстатки.ЗаказНаряд КАК Документ,
	               |	ТоварыВПроизводствеОстатки.ЗаказНаряд КАК ЗаказНаряд,
	               |	ТоварыВПроизводствеОстатки.Номенклатура КАК Номенклатура,
	               |	ТоварыВПроизводствеОстатки.КоличествоОстаток КАК КоличествоОстаток
	               |ПОМЕСТИТЬ ВТ_ОстаткиПроизводствоПодготовка
	               |ИЗ
	               |	РегистрНакопления.ТоварыВПроизводстве.Остатки КАК ТоварыВПроизводствеОстатки
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ЗаказНаряд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОстаткиПроизводство.ЗаказНаряд КАК ЗаказНаряд,
	               |	ВТ_ОстаткиПроизводство.ЗаказНаряд.ДокументОснование КАК ЗаказНарядДокументОснование
	               |ПОМЕСТИТЬ ЗаказНаряды
	               |ИЗ
	               |	ВТ_ОстаткиПроизводствоПодготовка КАК ВТ_ОстаткиПроизводство
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ОстаткиПроизводство.ЗаказНаряд,
	               |	ВТ_ОстаткиПроизводство.ЗаказНаряд.ДокументОснование
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ЗаказНаряд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказНаряды.ЗаказНаряд КАК ЗаказНаряд,
	               |	ВЫБОР
	               |		КОГДА ЗаказНаряды.ЗаказНарядДокументОснование ССЫЛКА Документ.ЗаказПокупателя
	               |			ТОГДА ВЫРАЗИТЬ(ЗаказНаряды.ЗаказНарядДокументОснование КАК Документ.ЗаказПокупателя)
	               |		КОГДА НЕ ЗаказПокупателя.Ссылка ЕСТЬ NULL
	               |			ТОГДА ЗаказПокупателя.Ссылка
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	               |	КОНЕЦ КАК ЗаказПокупателя
	               |ПОМЕСТИТЬ ЗаказыПокупателейПоЗН
	               |ИЗ
	               |	ЗаказНаряды КАК ЗаказНаряды
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |		ПО ЗаказНаряды.ЗаказНаряд = ЗаказПокупателя.ДокументОснование
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ЗаказНаряд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОстаткиПроизводствоПодготовка.Документ КАК Документ,
	               |	ВТ_ОстаткиПроизводствоПодготовка.ЗаказНаряд КАК ЗаказНаряд,
