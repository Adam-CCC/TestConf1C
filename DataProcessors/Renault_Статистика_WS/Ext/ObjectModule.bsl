СоответствиеПотоков = Новый Соответствие;

Для каждого Значение из Перечисления.Renault_ПотокиОбмена Цикл
	
	СоответствиеПотоков.Вставить(Значение, Метаданные.Перечисления.Renault_ПотокиОбмена.ЗначенияПеречисления[Перечисления.Renault_ПотокиОбмена.Индекс(Значение)].Имя);
	
КонецЦикла;

АдресWS  = Константы.Renault_АдресWebСервисов.Получить();
ЛогинWS  = Константы.Renault_ЛогинВебСервиса.Получить();
ПарольWS = Константы.Renault_ПарольВебСервиса.Получить();