Процедура ПроверитьПараметрыПодключения()
	
	Если НЕ ЗначениеЗаполнено(АдресWS) тогда
		АдресWS = Renault_Открытый.ПолучитьАдресВебСервисовПоУмолчанию();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЛогинWS) тогда
		ЛогинWS = Renault_Открытый.ПолучитьЛогинСервисовПоУмолчанию();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПарольWS) тогда
		ПарольWS = Renault_Открытый.ПолучитьПарольСервисовПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры // ПроверитьПараметрыПодключения()


Процедура ОтправитьСтатистикуПоWS()
	
	IP = ПолучитьIP();
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/stat.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));

	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/datatable", 
							   "Статистика","СтатистикаSoap12",600);
	
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	
	Статистика = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable", "Статистика"));;
	
	Статистика.BIR = BIR;
	Статистика.Поток = СоответствиеПотоков[Поток];
	Статистика.Дата = ТекущаяДата();
	Статистика.IP = IP;
	Статистика.ВерсияDMS = ВерсияDMS;
	
	ВебСервис.setstat(Статистика);
	
КонецПроцедуры

