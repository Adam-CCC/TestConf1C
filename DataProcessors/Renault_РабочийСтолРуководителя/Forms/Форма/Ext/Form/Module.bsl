Перем СписокДнейНеделиСокр;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	Сегодня = Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy, dddd'");
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	НачалоРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьНачалоРабочегоДняАвтосервиса(ДилерскийЦентр,ТекущаяДата());
	КонецРабочегоДня = Справочники.CRM_ДилерскиеЦентры.ПолучитьКонецРабочегоДняАвтосервиса(ДилерскийЦентр,ТекущаяДата()); 
	
	ОбновитьИнтерфейсПользователя();
	
	ОбновитьВсеНаСервере(); 	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Массив = Новый Массив;
	Массив.Добавить(Элементы.Logo);
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив, "Картинка", "Логотип5");

	ВывестиЧасы();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеНаСервере()
	ОбновитьПоказатели();
	
	ОбновитьМойОтдел();	
КонецПроцедуры

&НаСервере 
Процедура ОбновитьМойОтдел()
	
	ТаблицаМойОтдел.Очистить();
	
	Отдел = Renault_CRM.ПолучитьОтделСотрудника(ПараметрыСеанса.Пользователь.Сотрудник);
	
	Если НЕ ЗначениеЗаполнено(Отдел) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СписокСотрудников = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(Отдел);
	
	Если Не ЗначениеЗаполнено(СписокСотрудников) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтатусыСотрудников = Renault_CRM.ПолучитьСтатусыСотрудников(СписокСотрудников.ВыгрузитьЗначения());
	
	Для Каждого Сотр из СтатусыСотрудников Цикл
		
		НоваяСтрока = ТаблицаМойОтдел.Добавить();
		НоваяСтрока.Сотрудник = Сотр.Сотрудник;
		
		Если Сотр.АктивностьПользователя Тогда
			
			Если Сотр.ЗанятостьСотрудника = Перечисления.CRM_ЗанятостьСотрудника.Свободен Тогда
				
				НоваяСтрока.Статус = "Он-лайн, свободен";
				
			Иначе
				
				НоваяСтрока.Статус = "Он-лайн, занят: " + Строка(Сотр.ПричинаЗнаятостиСотрудника);
				
			КонецЕсли;
				
			
		Иначе
			
			НоваяСтрока.Статус = "Оффлайн";
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнтерфейсПользователя()
	СписокОтчетовПользователя = Renault_ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("РабочийСтолРуководителя_СписокОтчетовПользователя", , Новый СписокЗначений);
	
	Если СписокОтчетовПользователя.Количество() > 0 Тогда
		Для Каждого Эл Из СписокОтчетовПользователя Цикл
			ДобавитьОтчетНаСервере(Эл.Значение);
		КонецЦикла;
	КонецЕсли;
	
	СписокПоказателейПользователя = Renault_ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("РабочийСтолРуководителя_СписокПоказателейПользователя", , Новый СписокЗначений);
	
	Если СписокПоказателейПользователя.Количество() > 0 Тогда
		Для Каждого Эл Из СписокПоказателейПользователя Цикл
			ДобавитьПоказательНаСервере(Эл.Значение);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказатели()
	Для Каждого Эл Из СписокПоказателейПользователя Цикл
		ЭлЗначение = СтрокаВВерблюжьейНотации(Эл.Значение);
		ИмяРеквизита = ЭлЗначение + "Путь";

		ОбновитьПоказатель(ЭлЗначение, ИмяРеквизита);
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказатель(ИмяЭлемента, ИмяРеквизита)
	Если ИмяЭлемента = "ЗагрузкаНаСегодня" Тогда
		ОбновитьПоказательЗагрузкиНаСегодня(ИмяРеквизита);
	ИначеЕсли ИмяЭлемента = "ЗагрузкаНаНеделю" Тогда
		ОбновитьПоказательЗагрузкиНаНеделю(ИмяРеквизита);
	ИначеЕсли ИмяЭлемента = "СреднийЧекПоВидамРемонта" Тогда
		ОпределитьПоказательСреднийЧекПоВидамРемонта(ИмяРеквизита);
	ИначеЕсли ИмяЭлемента = "НормочасыЗаЗаездПоВидамРемонта" Тогда
		ОпределитьПоказательСреднееКоличествоНормочасовЗаЗаездПоВидамРемонта(ИмяРеквизита);
	ИначеЕсли ИмяЭлемента = "СуммаПроданныхТоваровПоВидамРемонта" Тогда
		ОпределитьПоказательСуммаЗапчастейПоВидамРемонта(ИмяРеквизита);
	ИначеЕсли ИмяЭлемента = "КоличествоЗаездов" Тогда
		ОпределитьПоказательКоличествоЗаездов(ИмяРеквизита);
	ИначеЕсли ИмяЭлемента = "КоличествоНормочасов" Тогда
		ОпределитьПоказательКоличествоНормочасов(ИмяРеквизита);
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитьПоказатель(Команда)
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Загрузка на сегодня");
	СписокВыбора.Добавить("Загрузка на неделю");
	СписокВыбора.Добавить("Средний чек по видам ремонта");
	СписокВыбора.Добавить("Нормочасы за заезд по видам ремонта");
	СписокВыбора.Добавить("Сумма проданных товаров по видам ремонта");
	СписокВыбора.Добавить("Количество заездов");
	СписокВыбора.Добавить("Количество нормочасов");
	
	СписокВыборкаДляПользователя = Новый СписокЗначений;
	
	Добавлять = Истина;
	Для Каждого ЭлСписка Из СписокВыбора Цикл
		Для Каждого Показатель Из СписокПоказателейПользователя Цикл
			Если ЭлСписка.Значение = Показатель.Значение Тогда
				Добавлять = Ложь;
				Прервать;
			КонецЕсли;			
		КонецЦикла;
		
		Если Добавлять Тогда
			СписокВыборкаДляПользователя.Добавить(ЭлСписка.Значение);
			
			Продолжить;
		КонецЕсли;
		
		Добавлять = Истина;
	КонецЦикла;
	
	Если СписокВыборкаДляПользователя.Количество() = 0 Тогда
		Сообщить("Все показатели добавлены!");
	Иначе	
		Результат = ПоказатьФормуВыбора(СписокВыборкаДляПользователя);
		
		Ответ = ДобавитьПоказательНаСервере(Результат);
		
		Если ЗначениеЗаполнено(Ответ) Тогда		
			ПоказатьПредупреждение(, Ответ);
		Иначе
			Если ЗначениеЗаполнено(Результат) Тогда
				Если ТипЗнч(СписокПоказателейПользователя) = Тип("СписокЗначений") Тогда
					СписокПоказателейПользователя.Добавить(Результат);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ДобавитьПоказательНаСервере(ИмяПоказателя)
	Перем Ответ;
	
	Если ЗначениеЗаполнено(ИмяПоказателя) Тогда
		ГруппаПоказателей = Элементы.ГруппаПоказатели;
		ИмяЭлемента = СтрокаВВерблюжьейНотации(ИмяПоказателя);
		ИмяРеквизита = ИмяЭлемента + "Путь";
		
		Ответ = СоздатьПоказатель(ИмяПоказателя, ИмяЭлемента, ИмяРеквизита, ГруппаПоказателей);
		
		Если ИмяПоказателя = "Загрузка на сегодня" Тогда
			ОбновитьПоказательЗагрузкиНаСегодня(ИмяРеквизита); 			
		ИначеЕсли ИмяПоказателя = "Загрузка на неделю" Тогда 			
			ОбновитьПоказательЗагрузкиНаНеделю(ИмяРеквизита); 			
		ИначеЕсли ИмяПоказателя = "Средний чек по видам ремонта" Тогда
			ОпределитьПоказательСреднийЧекПоВидамРемонта(ИмяРеквизита);
		ИначеЕсли ИмяПоказателя = "Нормочасы за заезд по видам ремонта" Тогда
			ОпределитьПоказательСреднееКоличествоНормочасовЗаЗаездПоВидамРемонта(ИмяРеквизита);	
		ИначеЕсли ИмяПоказателя = "Сумма проданных товаров по видам ремонта" Тогда
			ОпределитьПоказательСуммаЗапчастейПоВидамРемонта(ИмяРеквизита);		
		ИначеЕсли ИмяПоказателя = "Количество нормочасов" Тогда 			
			ОпределитьПоказательКоличествоНормочасов(ИмяРеквизита);
		ИначеЕсли ИмяПоказателя = "Количество заездов" Тогда 			
			ОпределитьПоказательКоличествоЗаездов(ИмяРеквизита);	
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Ответ;
КонецФункции

&НаСервере
Функция СоздатьПоказатель(ИмяПоказателя, ИмяЭлемента, ИмяРеквизита, ГруппаПоказателей)
	Если Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда				
		Возврат "Такой показатель уже есть";				
	КонецЕсли;
	
	ДобавитьКПанПоказателяИлиОтчета(ГруппаПоказателей, ИмяЭлемента);
	
	ДобавляемыеРеквизиты = Новый Массив();
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Диаграмма"));
    ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Показатель = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаПоказателей);
	Показатель.Вид = ВидПоляФормы.ПолеДиаграммы;
	Показатель.Заголовок = ИмяПоказателя;
	Показатель.ПутьКДанным = ИмяРеквизита;	
КонецФункции

&НаСервере
Процедура ДобавитьКПанПоказателяИлиОтчета(Родитель, Имя)	
	ИмяГруппы = "ГруппаКПан" + Строка(Имя); 
	
	НоваяКП = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Родитель);
	НоваяКП.Вид = ВидГруппыФормы.КоманднаяПанель;
	НоваяКП.Заголовок = "";
	
	КФУдалить = ЭтаФорма.Команды.Найти(Имя + "Удалить");
	
	Если КФУдалить = Неопределено Тогда		
		КФУдалить = ЭтаФорма.Команды.Добавить(Имя + "Удалить");
		КФУдалить.Действие = "КомандаКПанУдалить"; 		
	КонецЕсли;
	
	ИмяКнопки = "Удалить" + Строка(Имя);
	
	НоваяКН = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), НоваяКП);
	НоваяКН.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НоваяКН.Заголовок = "Удалить";
	НоваяКН.ИмяКоманды = Имя + "Удалить";
	
	Если Родитель.Имя = "ГруппаПоказатели" Тогда
    	КФОбновить = ЭтаФорма.Команды.Найти(Имя + "Обновить");

		Если КФОбновить = Неопределено Тогда			
			КФОбновить = ЭтаФорма.Команды.Добавить(Имя + "Обновить");
			КФОбновить.Действие = "КомандаКПанОбновить";			
		КонецЕсли;
		
		ИмяКнопки = "Обновить" + Строка(Имя);
		
		НоваяКН = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), НоваяКП);
		НоваяКН.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		НоваяКН.Заголовок = "Обновить";
		НоваяКН.ИмяКоманды = Имя + "Обновить";	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказательЗагрузкиНаСегодня(ИмяРеквизита)
	
	ОбновитьДиаграммуЗагрузка(ИмяРеквизита, НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()), Истина);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоказательЗагрузкиНаНеделю(ИмяРеквизита)
	
	ОбновитьДиаграммуЗагрузка(ИмяРеквизита, НачалоДня(ТекущаяДата()), КонецДня(ТекущаяДата()), Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаКПанОбновить(Команда)
	ИмяКоманды = Команда.Имя;
	
	ДлинаСтрокиКонцовка = СтрДлина("Обновить");
	ДлинаСтроки = СтрДлина(ИмяКоманды);
	
	ИмяЭлемента = Лев(Команда.Имя, ДлинаСтроки - ДлинаСтрокиКонцовка);	
	ИмяРеквизита = ИмяЭлемента + "Путь";
	
	ОбновитьПоказатель(ИмяЭлемента, ИмяРеквизита);
КонецПроцедуры

&НаКлиенте
Процедура КомандаКПанУдалить(Команда)
	ИмяКоманды = Команда.Имя;
	
	ДлинаСтрокиКонцовка = СтрДлина("Удалить");
	ДлинаСтроки = СтрДлина(ИмяКоманды);
	
	ИмяЭлемента = Лев(Команда.Имя, ДлинаСтроки - ДлинаСтрокиКонцовка);
		
	УдалитьОтчетИлиПоказатель(ИмяЭлемента); 		
КонецПроцедуры

&НаСервере
Процедура УдалитьОтчетИлиПоказатель(ИмяЭлемента)
	ЗначениеОтчета = СписокОтчетовПользователя.НайтиПоЗначению(СтрокаБезВерблюжьейНотации(ИмяЭлемента));
	Если ЗначениеОтчета <> Неопределено Тогда
		УдалитьОтчет(ИмяЭлемента);
		
		СписокОтчетовПользователя.Удалить(ЗначениеОтчета);
	КонецЕсли;	
	
	ЗначениеПоказателя = СписокПоказателейПользователя.НайтиПоЗначению(СтрокаБезВерблюжьейНотации(ИмяЭлемента));
	Если ЗначениеПоказателя <> Неопределено Тогда
		УдалитьПоказатель(ИмяЭлемента);
		
		Для Каждого Эл Из СписокПоказателейПользователя Цикл
			Если Эл.Значение = ЗначениеПоказателя.Значение Тогда
				СписокПоказателейПользователя.Удалить(Эл);
				Прервать;
			КонецЕсли;			
		КонецЦикла; 		
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УдалитьОтчет(ИмяЭлемента)
	КомандаОтчета = Команды.Найти(ИмяЭлемента);
	Команды.Удалить(КомандаОтчета);
	
	КнопкаОтчета = Элементы.Найти(ИмяЭлемента); 	
	Элементы.Удалить(КнопкаОтчета);
	
	КомандаУдалить = Команды.Найти(ИмяЭлемента + "Удалить");
	Команды.Удалить(КомандаУдалить);
	
	КнопкаУдалить = Элементы.Найти("Удалить" + ИмяЭлемента);
	Элементы.Удалить(КнопкаУдалить);
	
	Группа = Элементы.Найти("ГруппаКПан" + ИмяЭлемента);
	Элементы.Удалить(Группа);
КонецПроцедуры

&НаСервере
Процедура УдалитьПоказатель(ИмяЭлемента)
	//Диаграмма
	Показатель = Элементы.Найти(ИмяЭлемента); 	
	Элементы.Удалить(Показатель);	
	
	УдаляемыеРеквизиты = Новый Массив;	
	ИмяРеквизита = ИмяЭлемента + "Путь"; 
	
	УдаляемыеРеквизиты.Добавить(ИмяРеквизита);	
	ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	
	//Кнопка "Удалить"
	КомандаУдалить = Команды.Найти(ИмяЭлемента + "Удалить");
	Команды.Удалить(КомандаУдалить);
	
	КнопкаУдалить = Элементы.Найти("Удалить" + ИмяЭлемента);
	Элементы.Удалить(КнопкаУдалить);
	
	//Кнопка "Обновить"
	КомандаОбновить = Команды.Найти(ИмяЭлемента + "Обновить");
	Команды.Удалить(КомандаОбновить);
	
	КнопкаОбновить = Элементы.Найти("Обновить" + ИмяЭлемента);
	Элементы.Удалить(КнопкаОбновить);
	
	//Группа
	Группа = Элементы.Найти("ГруппаКПан" + ИмяЭлемента);
	Элементы.Удалить(Группа);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчет(Команда)
	Перем Форма;
	
	ИмяКоманды = Команда.Имя;

	Если ИмяКоманды = "Исполнители" ИЛИ 
		ИмяКоманды = "ЭффективностьЦеха" ИЛИ
		ИмяКоманды = "УчетНерабочегоВремени" ИЛИ
		ИмяКоманды = "УчетВремени" ИЛИ
		ИмяКоманды = "ПрочаяЗанятость" ИЛИ
		ИмяКоманды = "ОтчетПоСреднемуЧеку" ИЛИ
		ИмяКоманды = "ОтчетПоСертификатамКонтроля" ИЛИ
		ИмяКоманды = "ОтчетПоЗаездам" ИЛИ
		ИмяКоманды = "КонверсияОбращений"  ИЛИ
		ИмяКоманды = "ИспользованиеDMS" ИЛИ
		ИмяКоманды = "ТО" Тогда
		
		Форма = Отчеты["Renault_АвтосервисОтчетность_" + ИмяКоманды].ПолучитьФорму("ФормаОтчета");
		
	КонецЕсли;	
	
	Если Форма <> Неопределено Тогда
		Форма.СпособОтображенияОкна = ВариантСпособаОтображенияОкна.Максимизированное;
		Форма.Открыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере 
Процедура ОбновитьДиаграммуЗагрузка(ИмяРеквизита, НачалоПериода, КонецПериода, НаТекущийДень = Истина)
	
	//Если НаТекущийДень Тогда
	
	//Если НаТекущийДень Тогда
	
		Текущий_НачалоРабочегоДня = НачалоРабочегоДня;
		Текущий_КонецРабочегоДня = КонецРабочегоДня;
	
	//КонецЕсли;
	
	Текущий_ТекущийРабочийДень = ТекущаяДата();
	
	НачалоПериода = НачалоДня(ТекущаяДата());
	
	Если НЕ НаТекущийДень Тогда
	
		КонецПериода = КонецДня(НачалоПериода + 12 * 24 * 60 * 60);
	
	КонецЕсли;
	
	Значения = Новый ТаблицаЗначений;
	МаксимальнаяТочка = 0;
	
	Значения =  Renault_АвтосервисПланирование.ПолучитьТаблицуЗанятостиИМаксимальнуюТочку(МаксимальнаяТочка, 
	Текущий_ТекущийРабочийДень, ДилерскийЦентр, Текущий_НачалоРабочегоДня, Текущий_КонецРабочегоДня, Ложь,
	Ложь,Справочники.Цеха.ПустаяСсылка(),Перечисления.CRM_ВидыМашиноместВЦеху.ПустаяСсылка(),Справочники.Сотрудники.ПустаяСсылка());
	
	Диаграмма = ЭтаФорма[ИмяРеквизита];					
	
	Если Диаграмма = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
			
	Диаграмма.Очистить();
	
	Диаграмма.АвтоМаксимальноеЗначение = Ложь;
	
	Если НаТекущийДень Тогда
		
		Диаграмма.МаксимальноеЗначение = 95;
		
	Иначе
		
		Диаграмма.МаксимальноеЗначение = МаксимальнаяТочка;
		
	КонецЕсли;
	
	Если НаТекущийДень Тогда
		
		СерияЗагрузка = Диаграмма.Серии.Добавить(Строка(Сегодня));
		СерияЗагрузка.Цвет = новый Цвет(255,182,0);
		
	Иначе
		
		СерияЗагрузка = Диаграмма.Серии.Добавить("Загрузка с " + Формат(НачалоПериода, "ДФ=дд.ММММ") + " по " + Формат(КонецПериода, "ДФ=дд.ММММ"));
		СерияЗагрузка.Цвет = новый Цвет(255,182,0);
		
	КонецЕсли;
	
	Индекс = НачалоПериода;
	
	Пока Индекс <= КонецПериода Цикл
		
		Поиск = Значения.Найти(Индекс, "ДеньМесяца");
		
		Если Поиск = Неопределено Тогда
			
			Значение = 0;
			
		Иначе
			
			Значение = Поиск.Длительность;
			
		КонецЕсли;
		
		Значение = 100* Значение/?(МаксимальнаяТочка <> 0, МаксимальнаяТочка, 1);
		
		НоваяТочка = Диаграмма.Точки.Добавить(Строка(СписокДнейНеделиСокр[ДеньНедели(Индекс)-1])+ " " + Формат(Индекс, "ДФ=dd.MM.yy"));
		Диаграмма.УстановитьЗначение(НоваяТочка, СерияЗагрузка, Значение, Строка(Значение));
		
		Индекс = Индекс+24*60*60;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПоказатьФормуВыбора(СписокВыбора)	
	Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой", Заголовок = "Выбор");
	Форма.Заголовок = Заголовок;
	Форма.СписокВыбора = СписокВыбора;
	Ответ = Форма.ОткрытьМодально();
	Если НЕ ЗначениеЗаполнено(Ответ) Тогда
		Предупреждение("Необходим выбор элемента");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ответ; 	
КонецФункции

