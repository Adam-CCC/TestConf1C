	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ПродажиОбороты.КоличествоНормочасовОборот) КАК КоличествоНормочасов
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&НачалоМесяца, &КонецМесяца, Регистратор, ) КАК ПродажиОбороты
		|ГДЕ
		|	ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд"; 	
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца);
	Результат = Запрос.Выполнить();	
		
	Если НЕ Результат.Пустой() Тогда 
		Выборка = Результат.Выбрать();
		
		СерияМесяц = Диаграмма.Серии.Добавить(Строка("Количество нормочасов (месяц)"));

		Пока Выборка.Следующий() Цикл
			КоличествоНормочасов = Выборка.КоличествоНормочасов;
				
			НоваяТочка = Диаграмма.Точки.Добавить("Показатель");
			Диаграмма.УстановитьЗначение(НоваяТочка, СерияМесяц, КоличествоНормочасов);
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Renault_ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("РабочийСтолРуководителя_СписокОтчетовПользователя",,СписокОтчетовПользователя);
	Renault_ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("РабочийСтолРуководителя_СписокПоказателейПользователя",,СписокПоказателейПользователя);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоказатели(Команда)
	ОчиститьПоказателиСервер();
КонецПроцедуры

&НаСервере
Процедура ОчиститьПоказателиСервер()
	СписокПоказателей = Новый Массив;
	
	Для Каждого Эл Из СписокПоказателейПользователя Цикл
		СписокПоказателей.Добавить(Эл.Значение);	
	КонецЦикла;
	
	Для Каждого Показатель Из СписокПоказателей Цикл
		УдалитьОтчетИлиПоказатель(СтрокаВВерблюжьейНотации(Показатель));
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтчеты(Команда)
	ОчиститьОтчетыСервер();	
КонецПроцедуры

&НаСервере
Процедура ОчиститьОтчетыСервер()
	СписокОтчетов = Новый Массив;
	
	Для Каждого Эл Из СписокОтчетовПользователя Цикл
		СписокОтчетов.Добавить(Эл.Значение);	
	КонецЦикла;
	
	Для Каждого ОтчетИмя Из СписокОтчетов Цикл
		УдалитьОтчетИлиПоказатель(СтрокаВВерблюжьейНотации(ОтчетИмя));
	КонецЦикла;	
КонецПроцедуры 

