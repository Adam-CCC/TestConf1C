&НаКлиенте
Процедура ДобавитьОтчет(Команда)	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Анализ первичных заездов");
	СписокВыбора.Добавить("Исполнители");
	СписокВыбора.Добавить("Эффективность цеха");
	СписокВыбора.Добавить("Учет нерабочего времени");
	СписокВыбора.Добавить("Учет времени");
	СписокВыбора.Добавить("Прочая занятость");
	СписокВыбора.Добавить("Отчет по среднему чеку");
	СписокВыбора.Добавить("Отчет по сертификатам контроля");
	СписокВыбора.Добавить("Отчет по заездам");
	СписокВыбора.Добавить("Конверсия обращений");
	СписокВыбора.Добавить("Использование DMS");
	СписокВыбора.Добавить("ТО", "ТО");
	
	СписокВыборкаДляПользователя = Новый СписокЗначений;
	
	Добавлять = Истина;
	Для Каждого ЭлСписка Из СписокВыбора Цикл
		Для Каждого Показатель Из СписокОтчетовПользователя Цикл
			Если ЭлСписка.Значение = Показатель.Значение Тогда
				Добавлять = Ложь;
				Прервать;
			КонецЕсли;			
		КонецЦикла;
		
		Если Добавлять Тогда
			СписокВыборкаДляПользователя.Добавить(ЭлСписка.Значение);
			
			Продолжить;
		КонецЕсли;
		
		Добавлять = Истина;
	КонецЦикла;
	
	Если СписокВыборкаДляПользователя.Количество() = 0 Тогда
		Сообщить("Все отчеты добавлены!");
	Иначе
		Результат = ПоказатьФормуВыбора(СписокВыборкаДляПользователя);
		
		Ответ = ДобавитьОтчетНаСервере(Результат);
		
		Если ЗначениеЗаполнено(Ответ) Тогда
			
			ПоказатьПредупреждение(, Ответ);
		Иначе
			Если ЗначениеЗаполнено(Результат) Тогда
				Если ТипЗнч(СписокОтчетовПользователя) = Тип("СписокЗначений") Тогда
					СписокОтчетовПользователя.Добавить(Результат);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ДобавитьОтчетНаСервере(ИмяОтчета)
	Перем Ответ; 
		
	Если ЗначениеЗаполнено(ИмяОтчета) Тогда
		ГруппаОтчетов = Элементы.ГруппаОтчеты;
		Эталон = Элементы.КнопкаЭталон;
		
		Если ИмяОтчета = "Исполнители" ИЛИ
			ИмяОтчета = "Эффективность цеха" ИЛИ
			ИмяОтчета = "Учет нерабочего времени" ИЛИ 
			ИмяОтчета = "Учет времени" ИЛИ
			ИмяОтчета = "Прочая занятость" ИЛИ
			ИмяОтчета = "Отчет по среднему чеку" ИЛИ
			ИмяОтчета = "Отчет по сертификатам контроля" ИЛИ
			ИмяОтчета = "Отчет по заездам" ИЛИ
			ИмяОтчета = "Конверсия обращений" ИЛИ
			ИмяОтчета = "Использование DMS" ИЛИ
			ИмяОтчета = "ТО" ИЛИ 
			ИмяОтчета = "Анализ первичных заездов" Тогда
			
			ИмяЭлемента = СтрокаВВерблюжьейНотации(ИмяОтчета);
			Ответ = СоздатьКнопкуОтчета(ИмяОтчета, ИмяЭлемента, ГруппаОтчетов, Эталон); 			
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ответ; 	
КонецФункции

&НаСервере
Функция СоздатьКнопкуОтчета(ИмяОтчета, ИмяЭлемента, ГруппаОтчетов, Эталон)
	Если Элементы.Найти(ИмяЭлемента) <> Неопределено Тогда			
		Возврат "Такой отчет уже есть"; 			
	КонецЕсли;
	
	КФОткрытьОтчет = ЭтаФорма.Команды.Найти( ИмяЭлемента);

	Если КФОткрытьОтчет = Неопределено Тогда			
		КФОткрытьОтчет = ЭтаФорма.Команды.Добавить(ИмяЭлемента);
		КФОткрытьОтчет.Действие = "ОткрытьОтчет";			
	КонецЕсли;
	
	ДобавитьКПанПоказателяИлиОтчета(ГруппаОтчетов, ИмяЭлемента); 
				
	НовыйОтчет = Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ГруппаОтчетов);
	НовыйОтчет.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	
	ЗаполнитьЗначенияСвойств(НовыйОтчет, Эталон, , "Родитель, Видимость, ИмяКоманды, Заголовок, Имя");
	
	НовыйОтчет.Заголовок = ИмяОтчета;
	НовыйОтчет.ИмяКоманды = ИмяЭлемента;	
КонецФункции

&НаСервереБезКонтекста
Функция СтрокаВВерблюжьейНотации(Знач Строка)
	Строка = СокрЛП(Строка);
	
	ДлинаСтроки = СтрДлина(Строка);
	
	ПеревестиВВерхнийРегистр = Истина;
	НоваяСтрока = "";
	
	Для Счетчик = 1 По ДлинаСтроки Цикл
		СимволСтроки = Сред(Строка, Счетчик, 1);
		
		Если ПеревестиВВерхнийРегистр Тогда
			СимволСтроки = ВРег(СимволСтроки);
			ПеревестиВВерхнийРегистр = Ложь;			
		КонецЕсли;		
		
		Если СимволСтроки = " " Тогда
			ПеревестиВВерхнийРегистр = Истина;
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = НоваяСтрока + СимволСтроки;		
	КонецЦикла;
	
	Возврат НоваяСтрока;	
КонецФункции	 

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаБезВерблюжьейНотации(Знач Строка)
	Строка = СокрЛП(Строка);
	
	ДлинаСтроки = СтрДлина(Строка);
	
	Пробел = " ";	
	НоваяСтрока = "";
	ПредыдущийСимвол = "";
	
	Для Счетчик = 1 По ДлинаСтроки Цикл
		СимволСтроки = Сред(Строка, Счетчик, 1);
		
		Если СимволСтроки = ВРег(СимволСтроки) И НЕ Счетчик = 1 Тогда
			Если ПредыдущийСимвол <> ВРег(ПредыдущийСимвол) Тогда
				НоваяСтрока = НоваяСтрока + Пробел + НРег(СимволСтроки);
			Иначе
				НоваяСтрока = Лев(НоваяСтрока, СтрДлина(НоваяСтрока) - 1) + ПредыдущийСимвол;
				НоваяСтрока = НоваяСтрока + СимволСтроки;
			КонецЕсли;
		Иначе
			НоваяСтрока = НоваяСтрока + СимволСтроки;
		КонецЕсли;
		
		ПредыдущийСимвол = СимволСтроки;
	КонецЦикла;
	
	Возврат НоваяСтрока;	
КонецФункции

&НаСервере
Процедура ОпределитьПоказательСреднийЧекПоВидамРемонта(ИмяРеквизита)
	Диаграмма = ЭтаФорма[ИмяРеквизита];					
	
	Если Диаграмма = Неопределено Тогда		
		Возврат;		
	КонецЕсли;
	
	Диаграмма.ОбластьПостроения.ОтображатьТаблицуДанных = Истина;
	Диаграмма.Очистить();
	
	ТекущаяДата = ТекущаяДата();
	НачалоМесяца = НачалоМесяца(ТекущаяДата);
	КонецМесяца = КонецМесяца(ТекущаяДата);
	НачалоГода = НачалоГода(ТекущаяДата);
	КонецГода = КонецГода(ТекущаяДата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
		|			КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|				ТОГДА ВЫРАЗИТЬ(ПродажиОбороты.Регистратор КАК Документ.ЗаказНаряд).Ссылка
		|		КОНЕЦ) КАК КоличествоЧеков,
		|	СУММА(ПродажиОбороты.СуммаОборот) КАК Сумма,
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|			ТОГДА ВЫРАЗИТЬ(ПродажиОбороты.Регистратор КАК Документ.ЗаказНаряд).ВидРемонта
		|	КОНЕЦ КАК ВидРемонта
		|ПОМЕСТИТЬ ПродажиОсновныеДанныеМесяц
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&НачалоМесяца, &КонецМесяца, Регистратор, ) КАК ПродажиОбороты
		|ГДЕ
		|	ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|			ТОГДА ВЫРАЗИТЬ(ПродажиОбороты.Регистратор КАК Документ.ЗаказНаряд).ВидРемонта
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
		|			КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|				ТОГДА ВЫРАЗИТЬ(ПродажиОбороты.Регистратор КАК Документ.ЗаказНаряд).Ссылка
		|		КОНЕЦ) КАК КоличествоЧеков,
		|	СУММА(ПродажиОбороты.СуммаОборот) КАК Сумма,
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|			ТОГДА ВЫРАЗИТЬ(ПродажиОбороты.Регистратор КАК Документ.ЗаказНаряд).ВидРемонта
		|	КОНЕЦ КАК ВидРемонта
		|ПОМЕСТИТЬ ПродажиОсновныеДанныеГод
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&НачалоГода, &КонецГода, Регистратор, ) КАК ПродажиОбороты
		|ГДЕ
		|	ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|			ТОГДА ВЫРАЗИТЬ(ПродажиОбороты.Регистратор КАК Документ.ЗаказНаряд).ВидРемонта
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОсновныеДанныеМесяц.ВидРемонта,
		|	ВЫРАЗИТЬ(ПродажиОсновныеДанныеМесяц.Сумма / ПродажиОсновныеДанныеМесяц.КоличествоЧеков КАК ЧИСЛО(15, 2)) КАК СуммаСреднегоЧекаЗаМесяц
		|ПОМЕСТИТЬ СреднийЧекМесяц
		|ИЗ
		|	ПродажиОсновныеДанныеМесяц КАК ПродажиОсновныеДанныеМесяц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПродажиОсновныеДанныеГод.ВидРемонта,
		|	ВЫРАЗИТЬ(ПродажиОсновныеДанныеГод.Сумма / ПродажиОсновныеДанныеГод.КоличествоЧеков КАК ЧИСЛО(15, 2)) КАК СуммаСреднегоЧекаЗаГод
		|ПОМЕСТИТЬ СреднийЧекГод
		|ИЗ
		|	ПродажиОсновныеДанныеГод КАК ПродажиОсновныеДанныеГод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(СреднийЧекГод.ВидРемонта) КАК ВидРемонтаПредставление,
		|	СреднийЧекГод.СуммаСреднегоЧекаЗаГод,
		|	ЕСТЬNULL(СреднийЧекМесяц.СуммаСреднегоЧекаЗаМесяц, 0) КАК СуммаСреднегоЧекаЗаМесяц
		|ИЗ
		|	СреднийЧекГод КАК СреднийЧекГод
		|		ЛЕВОЕ СОЕДИНЕНИЕ СреднийЧекМесяц КАК СреднийЧекМесяц
		|		ПО СреднийЧекГод.ВидРемонта = СреднийЧекМесяц.ВидРемонта"; 	
	Запрос.УстановитьПараметр("КонецГода", КонецГода);
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца);
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода);
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца); 	
	Результат = Запрос.Выполнить();	
		
	Если НЕ Результат.Пустой() Тогда 
		Выборка = Результат.Выбрать();
		
		СерияГод = Диаграмма.Серии.Добавить(Строка("Средний чек за год"));
		СерияМесяц = Диаграмма.Серии.Добавить(Строка("Средний чек за месяц"));

		Пока Выборка.Следующий() Цикл
			ВидРемонтаПредставление = Выборка.ВидРемонтаПредставление;
			СуммаСреднегоЧекаЗаГод = Выборка.СуммаСреднегоЧекаЗаГод;
			СуммаСреднегоЧекаЗаМесяц = Выборка.СуммаСреднегоЧекаЗаМесяц;			
				
			НоваяТочка = Диаграмма.Точки.Добавить(ВидРемонтаПредставление);
