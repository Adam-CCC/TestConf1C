Функция ПолучитьСписокПодразделенийСДочернимиИзЗапроса(ТекПодр) Экспорт
	
	СписокПодразделенийСДочерними = Новый СписокЗначений;
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка,
	|	ПодразделенияКомпании.Родитель.Код,
	|	ПодразделенияКомпании.Код
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Родитель = &ТекПодр
	|	И НЕ ПодразделенияКомпании.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ТекПодр", ТекПодр);
	
	СписокПодразделенийСДочерними = Новый СписокЗначений;
	СписокПодразделенийСДочерними.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СписокПодразделенийСДочерними; 
	
КонецФункции

Функция ПолучитьСписокМарокАвто(ТекПодр) Экспорт
	
	СЗ = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодразделенияКомпанииМаркиАвтомобилей.Ссылка,
	|	ПодразделенияКомпанииМаркиАвтомобилей.Марка
	|ИЗ
	|	Справочник.ПодразделенияКомпании.МаркиАвтомобилей КАК ПодразделенияКомпанииМаркиАвтомобилей
	|ГДЕ
	|	ПодразделенияКомпанииМаркиАвтомобилей.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ТекПодр);
	
	СЗ.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Марка"));
	
	Если СЗ.Количество() = 0 Тогда
		Если НЕ обЗначениеНеЗаполнено(ТекПодр.Родитель) Тогда
			СЗ = ПолучитьСписокМарокАвто(ТекПодр.Родитель);
			Если СЗ.Количество() > 0 Тогда
				Возврат СЗ;	 	
			КонецЕсли;
		Иначе
			Возврат СЗ;	 	
		КонецЕсли; 
	Иначе	
		Возврат СЗ;	 
	КонецЕсли; 
	
КонецФункции // ПолучитьСписокМарок()

