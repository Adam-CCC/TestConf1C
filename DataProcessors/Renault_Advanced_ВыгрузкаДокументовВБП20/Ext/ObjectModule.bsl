Функция УбратьСлужебныеСимволы(Знач Стр)
	
	Стр = СтрЗаменить(Стр,"//","\\");
	Стр = СтрЗаменить(Стр,"{","");
	Стр = СтрЗаменить(Стр,"}","");
	Стр = СтрЗаменить(Стр,"|","");
	Стр = СтрЗаменить(Стр,Символ(13),"");
	Стр = СтрЗаменить(Стр,Символ(182),"");
	Стр = СтрЗаменить(Стр,Символы.ПС,"");
	
	Возврат СокрЛП(Стр); 	
КонецФункции

Функция ПолучитьКассуПоПодразделению(Подразделение)
	
	Касса = Справочники.Кассы.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		Возврат Касса;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КассыКомпании.Ссылка КАК Касса
	               |ИЗ
	               |	Справочник.КассыКомпании КАК КассыКомпании
	               |ГДЕ
	               |	КассыКомпании.Подразделение = &Подразделение";
				   
	Запрос.УстановитьПараметр("Подразделение",Подразделение);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		Возврат ВыборкаЗапроса.Касса;
	КонецЦикла; 
		
	Возврат Касса;

КонецФункции // ПолучитьКассуПоПодразделению()

Функция ПолучитьОплатуСтраховогоПолиса(ДокПКО)
	
	ПустойДок = Документы.Renault_ОплатаСтраховогоПолиса.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ДокПКО) Тогда
		Возврат ПустойДок;
	КонецЕсли; 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ОплатаПолиса.Ссылка
	                      |ИЗ
	                      |	Документ.Renault_ОплатаСтраховогоПолиса КАК ОплатаПолиса
	                      |ГДЕ
	                      |	ОплатаПолиса.ПометкаУдаления = ЛОЖЬ
	                      |	И ОплатаПолиса.ПлатежныйДокумент = &ДокПКО
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ОплатаПолиса.Дата УБЫВ");
						  
	Запрос.УстановитьПараметр("ДокПКО",ДокПКО);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли; 
	
	Возврат ПустойДок;
КонецФункции // ПолучитьДокументОплатаСтрахования()

Функция ПолучитьДанныеПоступленияАМ(Автомобиль,ДокСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(АвтомобилиНаСкладахОбороты.Партия.Контрагент, ЗНАЧЕНИЕ(Справочник.КОнтрагенты.ПустаяСсылка)) КАК Поставщик,
	               |	СтоимостьАвтомобиляОбороты.СуммаОборот КАК Стоимость,
	               |	ЕСТЬNULL(АвтомобилиНаСкладахОбороты.Партия.ДоговорВзаиморасчетов, ЗНАЧЕНИЕ(Справочник.ДоговорыВзаиморасчетов.ПустаяСсылка)) КАК Договор
	               |ИЗ
	               |	РегистрНакопления.ПродажиАвтомобилей.Обороты(, , Регистратор, Автомобиль = &Автомобиль) КАК СтоимостьАвтомобиляОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиАвтомобилей.Обороты КАК АвтомобилиНаСкладахОбороты
	               |		ПО СтоимостьАвтомобиляОбороты.Автомобиль = АвтомобилиНаСкладахОбороты.Автомобиль
	               |ГДЕ
	               |	СтоимостьАвтомобиляОбороты.Регистратор = &Ссылка
	               |	И АвтомобилиНаСкладахОбороты.Партия ССЫЛКА Документ.ПоступлениеАвтомобилей";
				   
	Запрос.УстановитьПараметр("Автомобиль"	,Автомобиль);
	Запрос.УстановитьПараметр("Ссылка"		,ДокСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Результат = Новый Структура("Поставщик,Договор,Стоимость",Справочники.Контрагенты.ПустаяСсылка(),Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка(),0);
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Результат,Выборка);
		
		Возврат Результат;
	Иначе
		Возврат Результат;
	КонецЕсли;	
	
КонецФункции	

