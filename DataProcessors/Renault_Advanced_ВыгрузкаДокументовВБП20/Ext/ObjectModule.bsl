	СтруктураДопСвойств.Вставить("сзОперации"		 	,сзОперации);
	СтруктураДопСвойств.Вставить("сзОперацииРКО"	,сзОперацииРКО);
КонецПроцедуры // ИнициализироватьТаблицыДанных()

