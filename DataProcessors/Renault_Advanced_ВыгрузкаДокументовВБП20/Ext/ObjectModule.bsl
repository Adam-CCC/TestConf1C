//*******************************************************************************************
Процедура ОбработкаДокументаВозвратТоваровОтПокупателя(ДокОбъект,ДопСвойства);
	
	Если Не ДокОбъект.Товары.Количество() Тогда
		Возврат;
	КонецЕсли; 
	
	ДокОснование = ДокОбъект.Товары[0].Партия;
	
	Если Не ЗначениеЗаполнено(ДокОснование) Тогда
		Сообщить("В документе <" + ДокОбъект + "> не указан документ реализации! Документ выгружен не будет!",СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли; 
	
	ЭтоВозвратЗЧ = Истина;
	
	//Если ЗначениеЗаполнено(ДокОснование.Сделка.бит_ЗаказНаряд) И
	//		Не (ДокОснование.Сделка.бит_ЗаказНаряд.пацВидОперации = Перечисления.пацВидыОперацийЗаказНаряд.Реализация) Тогда
	//	
	//	ЭтоВозвратЗЧ = Ложь;
	//КонецЕсли; 
	
	Операция	= ?(ЭтоВозвратЗЧ,"03","24");
	
	СтруктураНаименованиеУид = СформироватьНаименованиеУидДоговора(ДокОбъект,ДокОснование.Сделка,ДокОснование.ДоговорВзаиморасчетов);
	
	ДокСФ = Renault_Advanced_УчетНДС.НайтиПодчиненныйДокумент(ДокОбъект, "СчетФактураВыданный");
	
	ЭтоКорректировкаПрошлогоПериода = Не (КонецКвартала(ДокОбъект.Дата) = КонецКвартала(ДокОснование.Дата));
	
	Для каждого СтрокаТЧ Из ДокОбъект.Товары Цикл
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		НовСтрока.ДокОснование		= СтрокаТЧ.Партия.УникальныйИдентификатор();
		
		НовСтрока.ДатаДок			= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);

		НовСтрока.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.Контрагент 	 	= СтрокаТЧ.Партия.Контрагент.УникальныйИдентификатор();
		НовСтрока.Договор 			= СтруктураНаименованиеУид.УИД;
		
		НовСтрока.Номенклатура		= СтрокаТЧ.Номенклатура.УникальныйИдентификатор();
		НовСтрока.Количество		= СтрокаТЧ.Количество;
		НовСтрока.Сумма				= СтрокаТЧ.СуммаРозничная;
		//НовСтрока.СуммаНДС			= СтрокаТЧ.СуммаНДС;
		НовСтрока.ЭтоЛКМ			= Число(СтрокаТЧ.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ЛКМ);
		НовСтрока.Подразделение 	= ДокОбъект.ПодразделениеКомпании.УникальныйИдентификатор();		
		
		НовСтрока.ЭтоКорректировкаПрошлогоПериода = Число(ЭтоКорректировкаПрошлогоПериода); 
		
		// для отражения перемещения запчастей по зн из 10.01 в 41.01..
		//----------------------------------------------------------------
		Если Не ЭтоВозвратЗЧ И (НовСтрока.ЭтоЛКМ = 0) Тогда
			
			НовСтрокаПеремещение = ДопСвойства.ТаблицаДокументов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрокаПеремещение,НовСтрока);
			
			НовСтрокаПеремещение.Операция 	= "25";
			НовСтрокаПеремещение.Количество	= СтрокаТЧ.Количество;
		КонецЕсли; 
		
		ДобавитьВТаблицу(СтрокаТЧ.ДокументПартии.Контрагент			,2,ДопСвойства);
		ДобавитьВТаблицу(СтрокаТЧ.ДокументПартии.ДоговорВзаиморасчетов	,7,ДопСвойства,СтруктураНаименованиеУид.Наименование,СтруктураНаименованиеУид.УИД, СтруктураНаименованиеУид.ВидДоговора,,СтрокаТЧ.ДокументПартии.Контрагент);
		ДобавитьВТаблицу(СтрокаТЧ.Номенклатура						,7,ДопСвойства);
	КонецЦикла; 
	
	ДобавитьВТаблицу(ДокОбъект.Организация							,1,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.Подразделение						,7,ДопСвойства);
	
	Если ЭтоВозвратЗЧ Тогда
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры // ОбработкаДокументаВозвратТоваровОтПокупателя()

