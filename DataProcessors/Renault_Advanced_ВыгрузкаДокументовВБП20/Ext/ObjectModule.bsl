Процедура ОбработкаДокументаПКО(ДокОбъект,ДопСвойства);
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		
		Если Не ДокОбъект.ХозОперация = Справочники.ХозОперации.ПриходныйКассовыйОрдер Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка при выгрузке документа <" + ДокОбъект + ">: выгрузка документов с видом операции " + СокрЛП(ДокОбъект.ВидОперации) + " не предусмотрена!";
			Сообщение.Сообщить(); 
			Возврат;
			
		КонецЕсли; 
		
		Касса = ДокОбъект.КассаКомпании;	
	КонецЕсли; 
	
	Если ТипЗнч(ДокОбъект) = Тип("ДокументСсылка.ЧекНаОплату") Тогда
		
		Если Не ДокОбъект.ХозОперация = Справочники.ХозОперации.ЧекНаОплату Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка при выгрузке документа <" + ДокОбъект + ">: выгрузка документов с видом операции " + СокрЛП(ДокОбъект.ВидОперации) + " не предусмотрена!";
			Сообщение.Сообщить(); 
			Возврат;
		КонецЕсли;
		
		Касса = ДокОбъект.КассаКомпании;
		
		Если Не ЗначениеЗаполнено(Касса) Тогда
			Касса = ПолучитьКассуПоПодразделению(ДокОбъект.Подразделение);
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(Касса) Тогда
			Сообщить("Не удалось получить кассу для подразделения <" + ДокОбъект.ПодразделениеКомпании + "> в документе <" + ДокОбъект + ">!",СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	Операция = "15";
	
	ОплатаПолиса = ПолучитьОплатуСтраховогоПолиса(ДокОбъект);
	
	//Для каждого СтрокаТЧ Из ДокОбъект.Оплата Цикл
		
		СтруктураНаименованиеУид = СформироватьНаименованиеУидДоговора(ДокОбъект,ДокОбъект.Сделка,ДокОбъект.ДоговорВзаиморасчетов);
		
		ЭтоЗалог 				    = Ложь;
		ЭтоПродленнаяГарантия 	    = Ложь;
		ЭтоПродленнаяГарантияКардиф = Ложь;
		
		//Если ТипЗнч(СтрокаТЧ.Сделка)  = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		//	
		//	ЭтоЗалог 						= (СтрокаТЧ.Сделка.бит_ЗаказНаряд.пацВидОбслуживания = Справочники.пацВидыОбслуживания.Залог); 
		//	ЭтоПродленнаяГарантия 	= (СтрокаТЧ.Сделка.бит_ЗаказНаряд.пацВидОбслуживания = Справочники.пацВидыОбслуживания.Карта) Или (СтрокаТЧ.Сделка.бит_ЗаказНаряд.пацВидОбслуживания = Справочники.пацВидыОбслуживания.КартаПомощь); 
		//	//ПАЦ Тишин 24.09.2015 +++
		//	ЭтоПродленнаяГарантияКардиф = СтрокаТЧ.Сделка.бит_ЗаказНаряд.пацВидОбслуживания.КартаПродленнаяГарантия И СтрокаТЧ.Сделка.бит_ЗаказНаряд.пацВидОбслуживания = Справочники.пацВидыОбслуживания.НайтиПоКоду("000000231"); 
		//	//ПАЦ Тишин 24.09.2015 ---
		//	Если Не ЭтоПродленнаяГарантия И ЗначениеЗаполнено(СписокПодразделенийПродленнаяГарантия) Тогда
		//		
		//		ПодразделенияПродлГарантия = ЗначениеИзСтрокиВнутр(СписокПодразделенийПродленнаяГарантия);
		//		
		//		ЭтоПродленнаяГарантия = Не (ПодразделенияПродлГарантия.НайтиПоЗначению(СтрокаТЧ.Сделка.бит_ЗаказНаряд.Подразделение) = Неопределено);
		//		
		//	КонецЕсли;	
		//
		//КонецЕсли; 
		
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ДатаДок			= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		НовСтрока.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
		
		// в случае если это оплата страхования - то мы договора
		// будем генерировать по наименованию уже в БУ..
		//---------------------------------------------------------
		Если ЗначениеЗаполнено(ОплатаПолиса) Тогда
			
			Контрагент = ОплатаПолиса.СтраховойПолис.СтраховаяКомпания;
			
			НовСтрока.Контрагент 	 	= Контрагент.УникальныйИдентификатор();
			НовСтрока.Договор			= Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка().УникальныйИдентификатор();
			
		Иначе	
			
			Контрагент = ДокОбъект.Контрагент;
			
			НовСтрока.Контрагент 	 	= ДокОбъект.Контрагент.УникальныйИдентификатор();
			НовСтрока.Договор 			= ?(ЗначениеЗаполнено(СтруктураНаименованиеУид.УИД),СтруктураНаименованиеУид.УИД,ДокОбъект.ДоговорВзаиморасчетов.УникальныйИдентификатор());
			
			ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов		,7,ДопСвойства,СтруктураНаименованиеУид.Наименование,СтруктураНаименованиеУид.УИД, СтруктураНаименованиеУид.ВидДоговора	);
		КонецЕсли; 
		
		//НовСтрока.Касса 			= Касса.УникальныйИдентификатор();
		НовСтрока.Сумма				= ДокОбъект.СуммаДокумента;
		
		НовСтрока.ЭтоОплатаСтрахования        = Число(ЗначениеЗаполнено(ОплатаПолиса));
		НовСтрока.НомерПолиса				  = СокрЛП(ОплатаПолиса.СтраховойПолис.Номер);
		НовСтрока.ДатаПолиса				  = Формат(ОплатаПолиса.СтраховойПолис.Дата, "ДФ=ггггММдд");
		НовСтрока.ЭтоЗалог					  = ЭтоЗалог;
		НовСтрока.ЭтоПродленнаяГарантия       = ЭтоПродленнаяГарантия;
		НовСтрока.ЭтоПродленнаяГарантияКардиф = ЭтоПродленнаяГарантияКардиф;
		
		Если ЭтоПродленнаяГарантия ИЛИ ЭтоПродленнаяГарантияКардиф Тогда	
			НовСтрока.ВИН = (НовСтрока.Сделка.Renault_ЗаказНаряд.Автомобиль.VIN);
		КонецЕсли;	
		
	//КонецЦикла; 
	
	ДобавитьВТаблицу(ДокОбъект.Организация				,1,ДопСвойства);
	ДобавитьВТаблицу(Контрагент							,2,ДопСвойства);
	ДобавитьВТаблицу(Касса								,7,ДопСвойства);	
	
КонецПроцедуры // ОбработкаДокументаПКО()

