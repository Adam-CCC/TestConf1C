Процедура ОбработкаДокументаРКО(ДокОбъект,ДопСвойства);
	
	ЭлементСписка = ДопСвойства.сзОперацииРКО.НайтиПоЗначению(ДокОбъект.ХозОперация);
	
	Операция = "";
	Если ЭлементСписка = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка при выгрузке документа <" + ДокОбъект + ">: выгрузка документов с видом операции " + СокрЛП(ДокОбъект.ВидОперации) + " не предусмотрена!";
		Сообщение.Сообщить(); 
		Возврат;
	КонецЕсли; 
	
	Операция = ЭлементСписка.Представление;
	
	Касса = ДокОбъект.КассаКомпании;	
	
	//Для каждого СтрокаТЧ Из ДокОбъект.РасшифровкаПлатежа Цикл
		
		СтруктураНаименованиеУид = СформироватьНаименованиеУидДоговора(ДокОбъект,ДокОбъект.Сделка,ДокОбъект.ДоговорВзаиморасчетов);
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ДатаДок			= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		НовСтрока.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.РасчетныйСчет	    = ДокОбъект.Организация.ОсновнойБанковскийСчет.УникальныйИдентификатор();
		НовСтрока.Касса 			= Касса.УникальныйИдентификатор();
		НовСтрока.Сумма				= ДокОбъект.СуммаДокумента;
		
		Если Операция = "40" Тогда // инкассация
			
			НовСтрока.Выдать		= УбратьСлужебныеСимволы(СокрЛП(ДокОбъект.Выдать));
			НовСтрока.Приложение	= УбратьСлужебныеСимволы(СокрЛП(ДокОбъект.Приложение));
		
		ИначеЕсли Операция = "41" Тогда // выдача з/п
			
			НовСтрока.Выдать		= "Сотрудники";
			НовСтрока.Приложение	= "Платежная ведомость";
			
		ИначеЕсли	Операция = "42" Тогда // возрат д/с
			
			Контрагент = ДокОбъект.Контрагент;
			
			//Если ДокОбъект.ДоговорВзаиморасчетов.Автодоговор.СпособОплаты = Перечисления.СпособыОплаты.Лизинг 
			//	И ЗначениеЗаполнено(ДокОбъект.ДоговорВзаиморасчетов.Автодоговор.Плательщик) Тогда
			//	Контрагент =	ДокОбъект.ДоговорВзаиморасчетов.Автодоговор.Плательщик;
			//КонецЕсли;	
			
			Договор = ДокОбъект.ДоговорВзаиморасчетов;

			НовСтрока.Контрагент 		= Контрагент.УникальныйИдентификатор();
			НовСтрока.Договор			= Договор.УникальныйИдентификатор();
				
			НовСтрока.Выдать		= УбратьСлужебныеСимволы(СокрЛП(ДокОбъект.Контрагент.Наименование));
			НовСтрока.Приложение	= "Заявление, касовый чек, договор";
			НовСтрока.СуммаНДС  	= ДокОбъект.СуммаНДС;

			ДобавитьВТаблицу(Контрагент	,2,ДопСвойства);
			ДобавитьВТаблицу(Договор		,7,ДопСвойства,,,"С покупателем",,Контрагент);
			
		ИначеЕсли Операция = "43" Тогда // выдача подотчетнику
			
			НовСтрока.Контрагент = ДокОбъект.Контрагент.УникальныйИдентификатор();
			НовСтрока.Выдать	 = УбратьСлужебныеСимволы(СокрЛП(ДокОбъект.Контрагент.Наименование));
			
			ДобавитьВТаблицу(ДокОбъект.Контрагент,2,ДопСвойства);
			
		ИначеЕсли	Операция = "44" Тогда // оплата поставщику
			
			НовСтрока.Контрагент 		= ДокОбъект.Контрагент.УникальныйИдентификатор();
			НовСтрока.Договор			= ДокОбъект.ДоговорВзаиморасчетов.УникальныйИдентификатор();
			НовСтрока.СуммаНДС  		= ДокОбъект.СуммаНДС;
			НовСтрока.Выдать			= УбратьСлужебныеСимволы(СокрЛП(ДокОбъект.Контрагент.Наименование));

			ДобавитьВТаблицу(Контрагент						,2,ДопСвойства);
			ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов	,7,ДопСвойства,,,"С комитентом",,Контрагент);
			
		КонецЕсли;

	//КонецЦикла; 
	
	ДобавитьВТаблицу(ДокОбъект.Организация	,1,ДопСвойства);
	ДобавитьВТаблицу(Касса					,7,ДопСвойства);	
	
КонецПроцедуры // ОбработкаДокументаПКО()

Процедура ОбработкаДокументаПереходПраваСобственности(ДокОбъект,ДопСвойства)
	
	Операция = "13";
	
	Отбор = Новый Структура("Организация,РазделУчета",ДокОбъект.Организация,Перечисления.квРазделыУчетаВзаимоотношенийОрганизаций.Автомобили);
	ВзаимоотношенияОрганизаций = РегистрыСведений.квВзаимоотношенияОрганизаций.СрезПоследних(ДокОбъект.Дата,Отбор);
	
	Если Не ВзаимоотношенияОрганизаций.Количество() Тогда
		Сообщить("Не заданы настройки взаимоотношения организации <" + "> с другими организациями, документ <" + ДокОбъект + "> выгружен не будет!",СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;	
	
	// разбираемся кто есть кто в этом документе, кто отгружает автомобиль,
	// а кто его приходует..
	//-------------------------------------------------------------------------
	Если ВзаимоотношенияОрганизаций[0].РольОрганизацииПартнера = Перечисления.квРолиОрганизаций.Поставщик Или ВзаимоотношенияОрганизаций[0].РольОрганизацииПартнера = Перечисления.квРолиОрганизаций.Принципал Тогда
		
		ОрганизацияПоставщик 	= ВзаимоотношенияОрганизаций[0].ОрганизацияПартнер;
		КонтрагентПокупатель		= ВзаимоотношенияОрганизаций[0].КонтрагентОрганизации;
		
		ОрганизацияПокупатель	= ВзаимоотношенияОрганизаций[0].Организация;
		КонтрагентПоставщик		= ВзаимоотношенияОрганизаций[0].КонтрагентПартнер;
		
	ИначеЕсли ВзаимоотношенияОрганизаций[0].РольОрганизацииПартнера = Перечисления.квРолиОрганизаций.Покупатель Или ВзаимоотношенияОрганизаций[0].РольОрганизацииПартнера = Перечисления.квРолиОрганизаций.Комитент Тогда
		
		ОрганизацияПоставщик 	= ВзаимоотношенияОрганизаций[0].Организация;
		КонтрагентПокупатель		= ВзаимоотношенияОрганизаций[0].КонтрагентПартнер;
		
		ОрганизацияПокупатель	= ВзаимоотношенияОрганизаций[0].ОрганизацияПартнер;
		КонтрагентПоставщик		= ВзаимоотношенияОрганизаций[0].КонтрагентОрганизации;
		
	КонецЕсли;	
	
	Для каждого СтрокаТЧ Из ДокОбъект.Автомобили Цикл
		
		// реализация отгруженных товаров
		// от принципала..
		//----------------------------------
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= "50";
		НовСтрока.Представление 	= "Отгрузка без перехода права собственности";
		НовСтрока.ДатаДок				= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		НовСтрока.Организация 	 	= ОрганизацияПоставщик.УникальныйИдентификатор();
		НовСтрока.Контрагент 	 		= КонтрагентПокупатель.УникальныйИдентификатор();
		//НовСтрока.Договор 			= ДокОбъект.Договор.УникальныйИдентификатор();
		НовСтрока.Номенклатура		= СтрокаТЧ.Автомобиль.УникальныйИдентификатор();		
		НовСтрока.Автомобиль 		= СтрокаТЧ.Автомобиль.УникальныйИдентификатор();
		
		НовСтрока.Сумма				= СтрокаТЧ.Сумма;
		НовСтрока.Количество			= 1;
		НовСтрока.ЭтоСкладТрейдИн= 1;
		
		//НовСтрока.ЭтоАгентскаяСхема = Число(Истина);
		
		// поступление комиссионного товара комитенту..
		//------------------------------------------------
		НовСтрока2 = ДопСвойства.ТаблицаДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока2,НовСтрока);
		
		НовСтрока2.Операция = "18";
		НовСтрока2.Представление 	= "Поступление автомобилей";
		НовСтрока2.Организация 	 	= ОрганизацияПокупатель.УникальныйИдентификатор();
		НовСтрока2.Контрагент 	 	= КонтрагентПоставщик.УникальныйИдентификатор();
		
		ДобавитьВТаблицу(СтрокаТЧ.Автомобиль,2,ДопСвойства,,,,);
		
	КонецЦикла; 
	
	ДобавитьВТаблицу(ОрганизацияПоставщик,1,ДопСвойства);
	ДобавитьВТаблицу(ОрганизацияПокупатель,1,ДопСвойства);
	ДобавитьВТаблицу(КонтрагентПокупатель,2,ДопСвойства);	
	ДобавитьВТаблицу(КонтрагентПоставщик,2,ДопСвойства);	
	
КонецПроцедуры	

Процедура ВыгрузитьВТекст(Таблица,Очищать=Истина,ИмяОбъекта="")

	//----------------------------------------------
	Текст 		= Новый ЗаписьТекста(ПолноеИмяФайла,"windows-1251",,Не Очищать);
	ФайлТекста  = Новый ТекстовыйДокумент;
	
	// проставляем дату и время...
	//----------------------------
	Если Очищать Тогда
		ДатаВремя = "" + ТекущаяДата() + "_" + ИмяПользователя();
		Текст.ЗаписатьСтроку(ДатаВремя);
		
		Текст.ЗаписатьСтроку("~~Справочники~~");
		
	ИначеЕсли ИмяОбъекта = "Документы" Тогда	
		
		Текст.ЗаписатьСтроку("~~Документы~~");
	КонецЕсли;
	
	//----------------------------------------------
	КолСтр = Таблица.Количество();
	Если КолСтр = 0 тогда
		Попытка
			Текст.Закрыть();
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Исключение: "+ОписаниеОшибки();
			Сообщение.Сообщить();
		КонецПопытки;
		возврат;
	КонецЕсли;	
	
	// выгрузка структуры таблицы
	//----------------------------------------------
	Стр="{"+ИмяОбъекта;
	Текст.ЗаписатьСтроку(Стр);
	
	//@++
	Для каждого Колонка Из Таблица.Колонки Цикл
		Если ИмяОбъекта = "ДоговорыКонтрагентов" Тогда
			Стр = "//"+Колонка.Имя;
			Если Колонка.Имя = "НомерДоговора" Тогда
				Стр = "//Номер";
			ИначеЕсли Колонка.Имя = "ДатаНачала" Тогда
				Стр = "//Дата";
			КонецЕсли;
		Иначе
			Стр = "//"+Колонка.Имя;	
		КонецЕсли;
		Текст.ЗаписатьСтроку(Стр);
	КонецЦикла; 
	//@--
	
	// знак-разделитель и знак-замена
	//----------------------------------------------
	Знак = "|";
	ЗнакЗамены = "?";
	
	//Индикатор 						= ЭтотОбъект.ПолучитьФорму().ЭлементыФормы.Индикатор;
	//Индикатор.МаксимальноеЗначение 	= Таблица.Количество();

	// проход строк таблицы-параметра
	//----------------------------------------------
	Счетчик = 0;
	Для каждого СтрокаТЗ из Таблица цикл
		
		//Индикатор.Значение = Индикатор.Значение + 1;
		
		// обход колонок строки ТЗ
		//----------------------------------------------
		Стр = "";
		Для Каждого Колонка из Таблица.Колонки цикл
			
			// получили значение из ячейки таблицы
			//----------------------------------------------
			тмпСтр = ""+СтрокаТЗ[Колонка.Имя];
			
			// если в строке есть знак разделитель - меняем 
			//----------------------------------------------
			тмпСтр = СтрЗаменить(тмпСтр,Знак,ЗнакЗамены);
			// суммируем строку
			//----------------------------------------------
			Стр = Стр + "" + Знак + "" + тмпСтр;
		КонецЦикла;	
		
		// добавим в файл
		//----------------------------------------------
		Текст.ЗаписатьСтроку(Стр);

		проц = Окр((Счетчик/Таблица.Количество())*100,0,1);
	КонецЦикла;	
	// конецраздела
	//----------------------------------------------
	Стр="}";
	Текст.ЗаписатьСтроку(Стр);
	
	Попытка
		Текст.Закрыть();
	Исключение
	    Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Исключение: "+ОписаниеОшибки();
		Сообщение.Сообщить();
	КонецПопытки;
КонецПроцедуры

