Процедура ОбработкаДокументаПоступлениеАвтомобилей(ДокОбъект,ДопСвойства);
	
	ЭлементСписка = ДопСвойства.сзОперации.НайтиПоЗначению(ДокОбъект.ХозОперация);
	Операция = "";
	
	Если Не ДокОбъект.ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилей
		И Не ДокОбъект.ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилейКомиссия Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка при выгрузке документа <" + ДокОбъект + ">: выгрузка документов с видом операции " + СокрЛП(ДокОбъект.ХозОперация) + " не предусмотрена!";
			Сообщение.Сообщить(); 
		Возврат;
	КонецЕсли; 
	
	Операция = ЭлементСписка.Представление;
	
	Если Операция = "11" и Найти(ДокОбъект.ВхДокНомер,"F") > 0 Тогда
		Операция = "17";
	КонецЕсли;	
	
	ВидДоговора = ?(Операция = "18",Перечисления.ВидыДоговоров.СКомитентом,Перечисления.ВидыДоговоров.Покупка);
		
	Для каждого СтрокаТЧ Из ДокОбъект.Автомобили Цикл
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ДатаДок			= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);
		НовСтрока.ДатаВхДок			= ДокОбъект.ВхДокДата;
		НовСтрока.НомерВхДок		= СокрЛП(ДокОбъект.ВхДокНомер);
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		НовСтрока.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.Контрагент 	 	= ДокОбъект.Контрагент.УникальныйИдентификатор();
		НовСтрока.Номенклатура		= СтрокаТЧ.Автомобиль.УникальныйИдентификатор();
		НовСтрока.Автомобиль 		= СтрокаТЧ.Автомобиль.УникальныйИдентификатор();
		НовСтрока.Сумма				= СтрокаТЧ.Сумма;
		НовСтрока.Количество			= 1;		
		//НовСтрока.ЭтоАгентскаяСхема = Число(ДокОбъект.ВидОперации = Перечисления.ВидыОперацийДокументов.Агентский);
		
		Если Операция = "19" И (СтрокаТЧ.Договор.Владелец = ДокОбъект.Контрагент) Тогда
			
			НовСтрока.ДоговорВзаиморасчетов 	= ДокОбъект.ДоговорВзаиморасчетов.УникальныйИдентификатор();
			ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов	,7,ДопСвойства,,,ВидДоговора,,ДокОбъект.Контрагент);		

		ИначеЕсли Не Операция = "18" И (СтрокаТЧ.ДоговорВзаиморасчетов.Владелец = ДокОбъект.Контрагент) Тогда
			
			НовСтрока.Договор 	= СтрокаТЧ.ДоговорВзаиморасчетов.УникальныйИдентификатор();		
			ДобавитьВТаблицу(СтрокаТЧ.ДоговорВзаиморасчетов					,7,ДопСвойства,,,ВидДоговора,,ДокОбъект.Контрагент);		
			
		Иначе
			
			НовСтрока.Договор 	= ДокОбъект.ДоговорВзаиморасчетов.УникальныйИдентификатор();
			ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов	,7,ДопСвойства,,,ВидДоговора,,ДокОбъект.Контрагент);		
			
		КонецЕсли;
		
		ДобавитьВТаблицу(СтрокаТЧ.Автомобиль					,2,ДопСвойства);
	КонецЦикла; 
	
	ДобавитьВТаблицу(ДокОбъект.Организация				,1,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.Контрагент					,2,ДопСвойства);
КонецПроцедуры // ОбработкаДокументаПоступлениеАвтомобилей()

