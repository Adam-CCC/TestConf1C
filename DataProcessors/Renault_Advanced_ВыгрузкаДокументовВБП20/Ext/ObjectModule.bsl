Процедура ПроверкаЗаполнения(Отказ)
	
	Если Не ВыгружаемыеДокументы.Количество() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Отсутствуют документы к выгрузке!";
		Сообщение.Сообщить(); 
		
		Отказ = Истина;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указан каталог для выгрузки файла!";
		Сообщение.Сообщить(); 
		
		Отказ = Истина;
	КонецЕсли;
	
	ФС = Новый Файл(СокрЛП(КаталогВыгрузки));
	
	Если Не ФС.Существует() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Указанный каталог для выгрузки не найден! Измените каталог выгрузки.";
		Сообщение.Сообщить(); 
		
		Отказ = Истина;
	КонецЕсли; 
КонецПроцедуры
 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Отказ = Ложь;
	
	ПроверкаЗаполнения(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	ВыгрузитьДокументы();
КонецПроцедуры

