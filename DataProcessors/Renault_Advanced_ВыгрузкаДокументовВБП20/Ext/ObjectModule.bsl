Функция ПолучитьУИДУпр(Ссылка)
	
	ПустойУИД = "00000000-0000-0000-0000-000000000000";
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ПустойУИД;
	КонецЕсли; 
	
	НаборЗаписей = РегистрыСведений.пэСинхронизацияОбъектовУУ.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.УИД_БУ.Установить(Ссылка.УникальныйИдентификатор());
	НаборЗаписей.Отбор.Ссылка_БУ.Установить(Ссылка);
	
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат ПустойУИД;
	КонецЕсли; 
	
	Возврат НаборЗаписей[0].УИД_УУ;
КонецФункции // ПолучитьУИДУпр()

