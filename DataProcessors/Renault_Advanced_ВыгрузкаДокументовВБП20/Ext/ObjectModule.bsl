Процедура ДобавитьВТаблицу(Ссылка,Приоритет,ДопСвойства,НаименованиеДляВыгрузки = "",УИДДляВыгрузки = "", ВидДоговора = "",ЭтоОС = Ложь,Владелец = Неопределено)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли; 
	
	Тип 			= Метаданные.НайтиПоТипу(ТипЗнч(Ссылка)).Имя;
	
	ЭтоОрганизация 	= Ложь;
	
	Если Тип = "Подразделения" Тогда
		Возврат;
	КонецЕсли; 
	
	Попытка
		
		Если ЭтоОС Тогда
			ТабДанных = ДопСвойства.СоответствиеТаблицСправочников["ОсновныеСредства"];
			
		Иначе	
			ТабДанных = ДопСвойства.СоответствиеТаблицСправочников[Тип];
		КонецЕсли;
		
		СтрокаТЗ   = ТабДанных.Добавить();
		
	Исключение
		Сообщить("Не удалось получить таблицу данных для справочника " + Тип + ": " + ОписаниеОшибки(),СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;
	
	Для каждого Колонка Из ТабДанных.Колонки Цикл
		
		Если Не Ссылка.Метаданные().Реквизиты.Найти(Колонка.Имя) = Неопределено Тогда
			
			Если (Колонка.Имя = "Банк") или (Колонка.Имя = "БанкДляРасчетов") или (Колонка.Имя = "Организация") Или (Колонка.Имя = "БазоваяЕдиницаИзмерения") Тогда
				
				СтрокаТЗ[Колонка.Имя] = Ссылка[Колонка.Имя].УникальныйИдентификатор();
				
			Иначе
								
				Если Колонка.Имя = "ВидДоговора" И ЗначениеЗаполнено(ВидДоговора) Тогда
				    СтрокаТЗ[Колонка.Имя] = ВидДоговора;
				Иначе
					СтрокаТЗ[Колонка.Имя] = Ссылка[Колонка.Имя];
					
				КонецЕсли; 
				
			КонецЕсли;	
			
		Иначе
			
			Если Колонка.Имя = "ИдУпр" Тогда
				
				Если ЗначениеЗаполнено(УидДляВыгрузки) И УИДДляВыгрузки <> "00000000-0000-0000-0000-000000000000" Тогда
					СтрокаТЗ[Колонка.Имя] = УИДДляВыгрузки;
				Иначе	
					СтрокаТЗ[Колонка.Имя] = Ссылка.УникальныйИдентификатор();
				КонецЕсли; 
				
			ИначеЕсли Колонка.Имя = "ИдВладелец" Тогда
				
				Если Не Владелец = Неопределено Тогда
					
					СтрокаТЗ[Колонка.Имя] = Владелец.УникальныйИдентификатор();	
					
				ИначеЕсли Не Ссылка.Владелец = Неопределено Тогда
					
					СтрокаТЗ[Колонка.Имя] = Ссылка.Владелец.УникальныйИдентификатор();	
					
				ИначеЕсли Тип = "Подразделения" И ЗначениеЗаполнено(ДопСвойства.Организация) Тогда
					
					СтрокаТЗ[Колонка.Имя] = ДопСвойства.Организация.УникальныйИдентификатор();
					
				КонецЕсли;
				
			ИначеЕсли Колонка.Имя = "Приоритет" Тогда
				
				СтрокаТЗ[Колонка.Имя] = Приоритет;	
				
			ИначеЕсли Колонка.Имя = "Представление" Тогда
				
				Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда 
					СтрокаТЗ[Колонка.Имя] = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка().Метаданные().Представление();	
				Иначе	
					СтрокаТЗ[Колонка.Имя] = ?(ЭтоОС,"Основные средства",Ссылка.Метаданные().Представление());	
				КонецЕсли;
				
			ИначеЕсли Колонка.Имя = "Наименование" Тогда
				
				Наименование = ?(ЗначениеЗаполнено(НаименованиеДляВыгрузки),СокрЛП(НаименованиеДляВыгрузки),СокрЛП(Ссылка.Наименование));
				
				Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Или ТипЗнч(Ссылка) = Тип("СправочникСсылка.Renault_Advanced_Договоры") Тогда
					Наименование = СтрЗаменить(Наименование,"(Подписан)","");
					Наименование = СтрЗаменить(Наименование,"(Расторгнут)","");
				КонецЕсли; 
				
				СтрокаТЗ[Колонка.Имя] = СокрЛП(УбратьСлужебныеСимволы(Наименование));		
				
			ИначеЕсли Колонка.Имя = "Код" Тогда
				
				СтрокаТЗ[Колонка.Имя] = СокрЛП(Ссылка.Код);			
				
			ИначеЕсли Колонка.Имя = "ЮридическийАдрес" или Колонка.Имя = "ФактическийАдрес" или Колонка.Имя = "Телефон" Тогда
				
			 	Продолжить;
				
			ИначеЕсли Колонка.Имя = "НомерГТД" Тогда
				
				//ВыборкаПТС = Справочники.ПаспортаТранспортныхСредств.Выбрать(,Ссылка);
				//
				//Пока ВыборкаПТС.Следующий() Цикл
				//	
				//	Если ВыборкаПТС.Дубликат Тогда
				//		Продолжить;
				//	КонецЕсли;
				//	
				//	СтрокаТЗ.НомерГТД 					= СокрЛП(ВыборкаПТС.НомерГТД);
				//	СтрокаТЗ.НомерГТД						= УбратьСлужебныеСимволы(СтрокаТЗ.НомерГТД);
				//	
				//	СтрокаТЗ.СтранаПроисхождения 	= СокрЛП(ВыборкаПТС.Изготовитель);
				//	
				//	Прервать;
				//КонецЦикла;	
				Продолжить;

			ИначеЕсли Колонка.Имя = "СтранаПроисхождения" Тогда	
				  Продолжить;
				  
			ИначеЕсли Колонка.Имя = "ЭтоЛКМ" Тогда					  
				СтрокаТЗ.ЭтоЛКМ = Число(Ссылка.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ЛКМ);
				
			ИначеЕсли Колонка.Имя = "ВидДоговора" Тогда
				СтрокаТЗ[Колонка.Имя]  = ВидДоговора;
				
			ИначеЕсли Колонка.Имя = "Артикул" Тогда
				СтрокаТЗ[Колонка.Имя]  = Ссылка.VIN;
				
			Иначе
				
				Сообщить("Непонятен реквизит " + Колонка.Имя + " для справочника " + Тип + "!",СтатусСообщения.Внимание);
			КонецЕсли; 
		КонецЕсли; 
	КонецЦикла;
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
		
		ДобавитьВТаблицу(Ссылка.Владелец				,1,ДопСвойства);
		ДобавитьВТаблицу(Ссылка.Банк					,2,ДопСвойства);
		ДобавитьВТаблицу(Ссылка.БанкДляРасчетов	,2,ДопСвойства);
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ДоговорыВзаиморасчетов") Тогда 	
		ДобавитьВТаблицу(Ссылка.Владелец			,2,ДопСвойства);
		ДобавитьВТаблицу(Ссылка.Организация		,1,ДопСвойства);
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") Тогда
		ДобавитьВТаблицу(Ссылка.БазоваяЕдиницаИзмерения,2,ДопСвойства);
	КонецЕсли; 
	
	// контактная информация для контрагентов и организаций..
	//-------------------------------------------------------
	СтрокиФильтра = ДопСвойства.ФильтрыКонтактов.Строки.Найти(Тип,"ТипОбъекта");
	
	Если СтрокиФильтра = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	
	Для каждого Строка Из СтрокиФильтра.Строки Цикл
		НаборЗаписей.Отбор.Объект.Установить(Ссылка);
		НаборЗаписей.Отбор.Тип.Установить(Строка.Тип);
		НаборЗаписей.Отбор.Вид.Установить(Строка.Вид);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТЗ[Строка.Синоним] = СокрЛП(УбратьСлужебныеСимволы(НаборЗаписей[0].Представление));
	КонецЦикла;
КонецПроцедуры // ДобавитьВТаблицу()
 
