// Параметры:
// ----------
// 		Параметр1 - описание параметра
// 		Параметр2 - описание параметра
//
// Описание:
// ---------
// 		Описание процедуры
//
//*******************************************************************************************
Процедура ОбработкаДокументаРеализацияТоваровУслугПродажа(ДокОбъект,ДопСвойства);
	
	//Если Найти(ДокОбъект.ДокументОснование.Renault_ЗаказНаряд.ВидОбслуживания,"ДОП в ДКП Юр. лица") = 1 Тогда
	//	Возврат;
	//КонецЕсли;	
	
	Операция = "02";
	
	СтруктураНаименованиеУид = СформироватьНаименованиеУидДоговора(ДокОбъект,ДокОбъект.ЗаказПокупателя,ДокОбъект.ДоговорВзаиморасчетов);
	
	ДокСФ = Renault_Advanced_УчетНДС.НайтиПодчиненныйДокумент(ДокОбъект, "СчетФактураВыданный");
	
	Для каждого СтрокаТЧ Из ДокОбъект.Запчасти Цикл
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		
		НовСтрока.ДатаДок			= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);

		Если ЗначениеЗаполнено(ДокСФ) Тогда
		
			НовСтрока.НомерСФ 	= СокрЛП(ДокСФ.Номер);
			НовСтрока.ДатаСФ	= СокрЛП(ДокСФ.Дата);
		
		КонецЕсли; 

		НовСтрока.Организация 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.Контрагент 	= ДокОбъект.Контрагент.УникальныйИдентификатор();
		НовСтрока.Договор	    = СтруктураНаименованиеУид.УИД;
		
		НовСтрока.Номенклатура	= СтрокаТЧ.Номенклатура.УникальныйИдентификатор();
		НовСтрока.Количество	= СтрокаТЧ.Количество * СтрокаТЧ.Коэффициент;
		НовСтрока.Сумма			= СтрокаТЧ.Сумма + ?(ДокОбъект.СуммаВключаетНДС,0,СтрокаТЧ.СуммаНДС);
		НовСтрока.СуммаНДС		= СтрокаТЧ.СуммаНДС;
		НовСтрока.ЭтоЛКМ		=  Число(СтрокаТЧ.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ЛКМ);
		
		// данные для отчета в БУ..
		//--------------------------
		Если ЗначениеЗаполнено(ДокОбъект.ЗаказПокупателя) И ТипЗнч(ДокОбъект.ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			НовСтрока.МаркаАвтомобиля 			=  СокрЛП(ДокОбъект.Автомобиль.Модель);
			НовСтрока.ГосударственныйНомер 		=  СокрЛП(ДокОбъект.Автомобиль.ГосударственныйНомер);
			НовСтрока.НомерНаправления 			=  СокрЛП(ДокОбъект.НомерНаправления);
			НовСтрока.НомерЗаказНаряда          =  СокрЛП(ДокОбъект.Номер);
			НовСтрока.ДатаЗакрытияЗаказНаряда 	=  Формат(ДокОбъект.ДатаЗакрытия, "ДФ=ггггММддЧЧммсс");
		КонецЕсли; 
		
		// если продаем ЛКМ - его нужно сначала переместить с 10 на 41
		//----------------------------------------------------------------
		Если Число(СтрокаТЧ.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ЛКМ) Тогда
				
				НовСтрокаПеремещение = ДопСвойства.ТаблицаДокументов.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрокаПеремещение,НовСтрока);
				
				НовСтрокаПеремещение.Операция 	= "25";
				НовСтрокаПеремещение.ДатаДок  	= Формат(ДокОбъект.Дата - 1, "ДФ=ггггММддЧЧммсс");
		КонецЕсли; 
		
		ДобавитьВТаблицу(СтрокаТЧ.Номенклатура				,7,ДопСвойства);
	КонецЦикла; 
	
	ДобавитьВТаблицу(ДокОбъект.Организация					,1,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.Контрагент					,2,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов			,7,ДопСвойства,СтруктураНаименованиеУид.Наименование,СтруктураНаименованиеУид.УИД, СтруктураНаименованиеУид.ВидДоговора,,ДокОбъект.Контрагент);
	
КонецПроцедуры // ОбработкаДокументаРеализацияЗЧ()

//*******************************************************************************************
// Параметры:
// ----------
// 		Параметр1 - описание параметра
// 		Параметр2 - описание параметра
//
// Описание:
// ---------
// 		Описание процедуры
//
//*******************************************************************************************
Процедура ОбработкаДокументаРеализацияТоваровУслугЗН(ДокОбъект,ДопСвойства);
	
	Если ДокОбъект.СуммаДокумента = 0 Тогда
		Возврат;	
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(ДокОбъект.ДоговорВзаиморасчетов.Владелец) и ЗначениеЗаполнено(ДокОбъект.ДоговорВзаиморасчетов) Тогда
		Сообщить("В документе <" + ДокОбъект + "> не указан владелец в договоре! Документ выгружен не будет!",СтатусСообщения.Важное);
		Возврат;
	КонецЕсли; 
	
	Операция = "20";
	
	СтруктураНаименованиеУид = СформироватьНаименованиеУидДоговора(ДокОбъект,ДокОбъект.ЗаказПокупателя,ДокОбъект.ДоговорВзаиморасчетов);
	
	ДокСФ 		= Renault_Advanced_УчетНДС.НайтиПодчиненныйДокумент(ДокОбъект, "СчетФактураВыданный");
	ЭтоГарантия = (ДокОбъект.Обслуживание = Справочники.Renault_Advanced_ТипыОбслуживания.Гарантийный);
	ЭтоЗалог	= (ДокОбъект.ВидОбслуживания = Справочники.Renault_Advanced_ВидыОбслуживания.Залог); 
	
	Попытка
		ВидыОбслуживанияБезРеализаций = ЗначениеИзСтрокиВнутр(СтрВидыОбслуживанияБезРеализаций);
	Исключение
		ВидыОбслуживанияБезРеализаций = Новый СписокЗначений;
	КонецПопытки;	

	// реализации по данному виду обслуживания не выгружаются..
	//--------------------------------------------------------------
	Если ВидыОбслуживанияБезРеализаций.НайтиПоЗначению(ДокОбъект.ВидОбслуживания) = Неопределено Тогда
		
		НовСтрока 	= ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		
		НовСтрока.ДатаДок			= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);
		
		Если ЗначениеЗаполнено(ДокСФ) Тогда
			
			НовСтрока.НомерСФ 	= СокрЛП(ДокСФ.Номер);
			НовСтрока.ДатаСФ	= СокрЛП(ДокСФ.Дата);
			
		КонецЕсли; 
		
		НовСтрока.Организация 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.Контрагент 	= ДокОбъект.Плательщик.УникальныйИдентификатор();
		НовСтрока.Договор 		= СтруктураНаименованиеУид.УИД;
		
		НовСтрока.Количество	= (ДокОбъект.Запчасти.Итог("Количество") * ДокОбъект.Запчасти.Итог("Коэффициент")) 
		+ ДокОбъект.Работы.Итог("Количество");
		
		НовСтрока.Сумма			= (ДокОбъект.Запчасти.Итог("Сумма")  + ?(ДокОбъект.СуммаВключаетНДС,0,ДокОбъект.Запчасти.Итог("СуммаНДС"))) 
		+ (ДокОбъект.Работы.Итог("Сумма")  + ?(ДокОбъект.СуммаВключаетНДС,0,ДокОбъект.Работы.Итог("СуммаНДС")));
		
		НовСтрока.СуммаНДС		= ?(ЭтоГарантия, 0, ДокОбъект.Запчасти.Итог("СуммаНДС") + ДокОбъект.Работы.Итог("СуммаНДС"));
		НовСтрока.ЭтоУслуга		= 1;		
		НовСтрока.ЭтоГарантия	= Число(ЭтоГарантия);	
		
		// данные для отчета в БУ..
		//--------------------------
		Если ЗначениеЗаполнено(ДокОбъект.ЗаказПокупателя) И ТипЗнч(ДокОбъект.ЗаказПокупателя) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			
			НовСтрока.МаркаАвтомобиля 			=  СокрЛП(ДокОбъект.Автомобиль.Модель);
			НовСтрока.ГосударственныйНомер 		=  СокрЛП(ДокОбъект.Автомобиль.ГосударственныйНомер);
			НовСтрока.НомерНаправления 			=  СокрЛП(УбратьСлужебныеСимволы(ДокОбъект.НомерНаправления));
			НовСтрока.НомерЗаказНаряда          =  СокрЛП(ДокОбъект.Номер);
			НовСтрока.ДатаЗакрытияЗаказНаряда 	=  Формат(ДокОбъект.ДатаЗакрытия, "ДФ=ггггММддЧЧммсс");
			
		КонецЕсли; 
		
		ДобавитьВТаблицу(ДокОбъект.Организация				,1,ДопСвойства);
		ДобавитьВТаблицу(ДокОбъект.Плательщик				,2,ДопСвойства);
		ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов	,7,ДопСвойства,СтруктураНаименованиеУид.Наименование,СтруктураНаименованиеУид.УИД, СтруктураНаименованиеУид.ВидДоговора,,ДокОбъект.Плательщик);
		
	КонецЕсли;
	
	Если ДокОбъект.Запчасти.Количество() Тогда
	
		ОбработкаДокументаТребованиеНакладная(ДокОбъект,ДопСвойства)
	
	КонецЕсли; 

КонецПроцедуры // ОбработкаДокументаРеализацияЗаказНаряда()

//*******************************************************************************************
// Параметры:
// ----------
// 		Параметр1 - описание параметра
// 		Параметр2 - описание параметра
//
// Описание:
// ---------
// 		Описание процедуры
//
//*******************************************************************************************
Процедура ОбработкаДокументаТребованиеНакладная(ДокОбъект,ДопСвойства);
	
	ОперацияПеремещение = "21";
	ОперацияТН				 = "22";
	
	ИмяТЧ = ?(ТипЗнч(ДокОбъект) = Тип("ДокументСсылка.ТребованиеНакладная"),"Материалы","Товары");
	
	Если Не ДокОбъект[ИмяТЧ].Количество() Тогда
		Возврат;
	КонецЕсли; 
	
	// определяемся со счетом затрат..
	//----------------------------------
	СчетЗатрат = "20";
	//Если ТипЗнч(ДокОбъект) = Тип("ДокументСсылка.ТребованиеНакладная") Тогда
	//	
	//	ДокЗН = Документы.бит_ус_ЗаказНаряд.ПустаяСсылка();
	//	
	//	ДокЗаказ = ДокОбъект.Материалы[0].ЗаказРезерв;
	//	Если ТипЗнч(ДокЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
	//		ДокЗН = ДокЗаказ.бит_ЗаказНаряд;
	//	КонецЕсли;
	//	
	//	Если ЗначениеЗаполнено(ДокЗН) Тогда
	//		СчетЗатрат = ?(ДокЗН.Заказчик = ДокЗН.Плательщик,"26","44");
	//	КонецЕсли; 
	//КонецЕсли;	
	
	Для каждого СтрокаТЧ Из ДокОбъект[ИмяТЧ] Цикл
		
		// отражается списание материалов в НЗП..
		//------------------------------------------
		НовСтрокаТН = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрокаТН.Операция 		 	= ОперацияТН;
		НовСтрокаТН.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрокаТН.ИдДок			 		= ДокОбъект.Ссылка.УникальныйИдентификатор();
			
		НовСтрокаТН.ДатаДок				= Формат(ДокОбъект.Дата - 1, "ДФ=ггггММддЧЧммсс");
		НовСтрокаТН.НомерДок			= СокрЛП(ДокОбъект.Номер);
			
		НовСтрокаТН.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
			
		НовСтрокаТН.Номенклатура		= СтрокаТЧ.Номенклатура.УникальныйИдентификатор();
		НовСтрокаТН.Количество			= СтрокаТЧ.Количество * СтрокаТЧ.Коэффициент;
		
		НовСтрокаТН.ЭтоЛКМ			 	= Число(СтрокаТЧ.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ЛКМ);
		НовСтрокаТН.СчетЗатрат 		 	= СчетЗатрат;
		НовСтрокаТН.Подразделение 	= ДокОбъект.Подразделение.УникальныйИдентификатор();

		// если у нас в ЗН использовались обычные запчасти (не ЛКМ) - 
		// сначала отразим перемещение товаров для производства
		// с 41 счета на 10.01..
		//----------------------------------------------------------
		Если Не (СтрокаТЧ.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Краска Или СтрокаТЧ.Номенклатура.ВидНоменклатуры.Наименование = "МКЦ Рецепты") Тогда
			
			НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,НовСтрокаТН);
			НовСтрока.Операция = ОперацияПеремещение;
		КонецЕсли; 
		
		ДобавитьВТаблицу(СтрокаТЧ.Номенклатура				,7,ДопСвойства);		
		
	КонецЦикла; 		

	ДобавитьВТаблицу(ДокОбъект.Организация					,1,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.Подразделение				,7,ДопСвойства);	
КонецПроцедуры // ОбработкаДокументаТребованиеНакладная()

