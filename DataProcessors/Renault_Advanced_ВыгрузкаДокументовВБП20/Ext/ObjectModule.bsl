//*******************************************************************************************
Процедура ОбработкаДокументаКорректировкаРеализации(ДокОбъект,ДопСвойства);
	
	Если Не ЗначениеЗаполнено(ДокОбъект.ДокументОснование) Тогда
		Сообщить("В документе <" + ДокОбъект + "> не указан корректируемый документ реализации! Документ выгружен не будет!",СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли; 
	
	ЭтоКорректировкаПрошлогоПериода = Не (КонецКвартала(ДокОбъект.Дата) = КонецКвартала(ДокОбъект.ДокументОснование.Дата));
	
	// корректировать документы прошлого периода
	// можно в течение 14 дней после окончания квартала..
	//-------------------------------------------------------
	Если ЭтоКорректировкаПрошлогоПериода 
		И Число(ДокОбъект.Дата - КонецКвартала(ДокОбъект.ДокументОснование.Дата))/86400 > 14 Тогда
		
		Сообщить("Документ <" + ДокОбъект + "> корректирует реализацию <" + ДокОбъект.ДокументОснование + "> - со дня отгрузки прошло более 14 дней! Документ выгружен не будет!",СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;	
	
	ЭтоКорректировкаРеализацииЗЧ = Истина;
	
	//Если ЗначениеЗаполнено(ДокОбъект.ДокументОснование.Renault_ЗаказНаряд) И
	//		Не (ДокОбъект.ДокументРеализации.Сделка.Renault_ЗаказНаряд.ВидОперации = Перечисления.Renault_Advanced_ВидыОперацийЗаказНаряд.Реализация) Тогда
	//	
	//	ЭтоКорректировкаРеализацииЗЧ = Ложь;
	//КонецЕсли; 
	
	Операция	= ?(ЭтоКорректировкаРеализацииЗЧ,"04","26");
	
	СтруктураНаименованиеУид = СформироватьНаименованиеУидДоговора(ДокОбъект,ДокОбъект.ДокументОснование,ДокОбъект.ДокументОснование.ДоговорВзаиморасчетов);
	
	ДокСФ = Renault_Advanced_УчетНДС.НайтиПодчиненныйДокумент(ДокОбъект, "СчетФактураВыданный");
	
	Для каждого СтрокаТЧ Из ДокОбъект.Товары Цикл
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		НовСтрока.ДокОснование		= ДокОбъект.ДокументОснование.УникальныйИдентификатор();
		
		НовСтрока.ДатаДок				= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);

		НовСтрока.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.Контрагент 	 	= ДокОбъект.ДокументОснование.Контрагент.УникальныйИдентификатор();
		НовСтрока.Договор 			= СтруктураНаименованиеУид.УИД;
		
		НовСтрока.Номенклатура		= СтрокаТЧ.Номенклатура.УникальныйИдентификатор();
		НовСтрока.Количество			= 0; 
		НовСтрока.Сумма				= 0;
		НовСтрока.СуммаНДС			= 0;
		НовСтрока.ЭтоЛКМ			= Число(СтрокаТЧ.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ЛКМ);
		
		НовСтрока.ЭтоКорректировкаПрошлогоПериода = Число(ЭтоКорректировкаПрошлогоПериода); 
		
		//Если ЭтоКорректировкаРеализацииЗЧ И НовСтрока.ЭтоЛКМ = 1 Тогда
		//	
		//	НовСтрокаПеремещение = ДопСвойства.ТаблицаДокументов.Добавить();
		//	ЗаполнитьЗначенияСвойств(НовСтрокаПеремещение,НовСтрока);
		//		
		//	НовСтрокаПеремещение.Операция 	= "25";
		//КонецЕсли; 
		
		ДобавитьВТаблицу(СтрокаТЧ.Номенклатура										,7,ДопСвойства);
	КонецЦикла; 

	ДобавитьВТаблицу(ДокОбъект.Организация											,1,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.ДокументОснование.Контрагент				,2,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.ДокументОснование.ДоговорВзаиморасчетов	,7,ДопСвойства,СтруктураНаименованиеУид.Наименование,СтруктураНаименованиеУид.УИД, СтруктураНаименованиеУид.ВидДоговора,,ДокОбъект.ДокументОснование.Контрагент);
	
КонецПроцедуры // ОбработкаДокументаРеализацияЗЧ()

