Процедура ВыгрузитьДокументы() Экспорт
	
	СтруктураДопСвойств = Новый Структура();
	
	ИнициализироватьТаблицыДанных(СтруктураДопСвойств);
	
	Заголовок 	= "Анализируем выгружаемые документы..";
	
	тДоковКВыгрузке = ВыгружаемыеДокументы.Выгрузить();
	тДоковКВыгрузке.Свернуть("Документ,Контрагент","Сумма");
	 
	Для каждого СтрокаТаб Из тДоковКВыгрузке Цикл
		
		ОбработкаПрерыванияПользователя();
		
		Проц = тДоковКВыгрузке.Индекс(СтрокаТаб) / тДоковКВыгрузке.Количество() * 100;
		Проц = Окр(Проц);
		
		Состояние(Заголовок + " - " + Проц + "%");
		
		Если ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ПоступлениеАвтомобилей") Тогда
			ОбработкаДокументаПоступлениеАвтомобилей(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.РеализацияАвтомобилей") Тогда
			ОбработкаДокументаРеализацияАвтомобилей(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
			ОбработкаДокументаПКО(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ЧекНаОплату") Тогда
			ОбработкаДокументаПКО(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда 	
			ОбработкаДокументаРКО(СтрокаТаб.Документ,СтруктураДопСвойств);
		
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда 	
			ОбработкаДокументаППИ(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ПоступлениеТоваров") Тогда 	
			ОбработкаДокументаПоступлениеТоваровУслуг(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.Renault_ЗаказНаряд") Тогда 	
			
			ЭтоЗаказНаряд = Ложь;
			
			ЭтоЗаказНаряд = Не СтрокаТаб.Документ.ВидОперации = Перечисления.Renault_Advanced_ВидыОперацийЗаказНаряд.Реализация;

			//Если ЗначениеЗаполнено(СтрокаТаб.Документ.ДокументОснование) 
			//		И ТипЗнч(СтрокаТаб.Документ.ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			//		
			//		//Если ЗначениеЗаполнено(СтрокаТаб.Документ.ДокументОснование.Renault_ЗаказНаряд) Тогда
			//		//	ЭтоЗаказНаряд = Не СтрокаТаб.Документ.ДокументОснование.Renault_ЗаказНаряд.ВидОперации = Перечисления.Renault_Advanced_ВидыОперацийЗаказНаряд.Реализация;
			//		//КонецЕсли;
			//КонецЕсли;	
			
			Если ЭтоЗаказНаряд Тогда
				ОбработкаДокументаРеализацияТоваровУслугЗН(СтрокаТаб.Документ,СтруктураДопСвойств);
			Иначе
				ОбработкаДокументаРеализацияТоваровУслугПродажа(СтрокаТаб.Документ,СтруктураДопСвойств);
			КонецЕсли; 
			
		//ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ТребованиеНакладная") Тогда 	
		//	ОбработкаДокументаТребованиеНакладная(СтрокаТаб.Документ,СтруктураДопСвойств);
		//	
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда 	
			ОбработкаДокументаКорректировкаРеализации(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ВозвратОтПокупателя") Тогда
			
			ОбработкаДокументаВозвратТоваровОтПокупателя(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		//ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
		//	ОбработкаДокументаВозвратТоваровПоставщику(СтрокаТаб.Документ,СтруктураДопСвойств);
		//	
		//ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда 	
		//	ОбработкаДокументаОприходованиеТоваров(СтрокаТаб.Документ,СтруктураДопСвойств);
		//	
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.СписаниеТоваров") Тогда 	
			ОбработкаДокументаСписаниеТоваров(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.Комплектация") Тогда 	
			ОбработкаДокументаКомплектация(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		//ИначеЕсли ТипЗнч(СтрокаТаб.Документ) = Тип("ДокументСсылка.Пац_ПереходПраваСобственностиАвтомобиля") Тогда
		//	ОбработкаДокументаПереходПраваСобственности(СтрокаТаб.Документ,СтруктураДопСвойств);
			
		Иначе
			Сообщить("Неизвестный вид документа для выгрузки: <" + СтрокаТаб.Документ + ">",СтатусСообщения.Информация);
		КонецЕсли; 
	КонецЦикла; 
	 
	 Если СтруктураДопСвойств.ТаблицаДокументов.Количество() = 0 Тогда
		 Сообщить("Нет данных для выгрузки!",СтатусСообщения.Внимание);
		 Возврат;
	 КонецЕсли; 
	 
	Заголовок = "Выгружаем данные в файл - " + ПолноеИмяФайла;
	 
	СчетчикТаб = 0;
	Для каждого Соответствие Из СтруктураДопСвойств.СоответствиеТаблицСправочников Цикл
		
		ИмяТаб = Соответствие.Ключ;
		
		Если ИмяТаб = "ДоговорыВзаиморасчетов" Тогда
			ИмяТаб = "ДоговорыКонтрагентов"
		ИначеЕсли ИмяТаб = "бит_ус_Изделия" Тогда
			ИмяТаб = "Автомобили"
		ИначеЕсли ИмяТаб = "КассыКомпании" Тогда
			ИмяТаб = "Кассы"
		КонецЕсли; 
		
		СчетчикТаб = СчетчикТаб + 1;
		
		Проц = СчетчикТаб / СтруктураДопСвойств.СоответствиеТаблицСправочников.Количество() * 100;
		Проц = Окр(Проц);
		
		Состояние(Заголовок + " - " + Проц + "%");
		
		ТабДанных = Соответствие.Значение;
		
		СворачиваемыеКолонки = "";
		
		Счетчик = 0;
		Для каждого Колонка Из ТабДанных.Колонки Цикл
			
			Счетчик = Счетчик + 1;
			
			СворачиваемыеКолонки = СворачиваемыеКолонки + Колонка.Имя + ?(Счетчик = ТабДанных.Колонки.Количество(),"",","); 
		КонецЦикла; 
		
		ТабДанных.Свернуть(СворачиваемыеКолонки);
		
		ВыгрузитьВТекст(ТабДанных,?(СчетчикТаб = 1,Истина,Ложь),ИмяТаб);
	КонецЦикла; 
	 
	 ГруппируемыеКолонки = "";
	 СуммируемыеКолонки  = "";
	 
	 // сформируем строки с колонками для свертки таблицы..
	 //--------------------------------------------------------
	 Для каждого Колонка Из СтруктураДопСвойств.ТаблицаДокументов.Колонки Цикл
			 
		 Счетчик = Счетчик + 1;
		 
		 Если Найти(Колонка.Имя,"Сумма") > 0 Или Найти(Колонка.Имя,"Количество") > 0 Или Найти(Колонка.Имя,"Себестоимость") > 0 Тогда
			 СуммируемыеКолонки  = СуммируемыеКолонки + Колонка.Имя + ","; 
		 Иначе
			 ГруппируемыеКолонки = ГруппируемыеКолонки + Колонка.Имя + ","; 
		 КонецЕсли; 
	 КонецЦикла; 
	 
	 // отсекаем последний знак в строке..
	 //-------------------------------------
	 СуммируемыеКолонки  = Лев(СуммируемыеКолонки,СтрДлина(СуммируемыеКолонки) - 1);
	 ГруппируемыеКолонки = Лев(ГруппируемыеКолонки,СтрДлина(ГруппируемыеКолонки) - 1);
		 
	 СтруктураДопСвойств.ТаблицаДокументов.Свернуть(ГруппируемыеКолонки,СуммируемыеКолонки);
	 ВыгрузитьВТекст(СтруктураДопСвойств.ТаблицаДокументов,Ложь,"Документы");
	 
	 Предупреждение("Выгрузка успешно завершена!");
КонецПроцедуры // ВыгрузитьДокументы()

