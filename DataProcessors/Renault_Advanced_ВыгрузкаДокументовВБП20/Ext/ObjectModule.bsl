Процедура ОбработкаДокументаПоступлениеТоваровУслуг(ДокОбъект,ДопСвойства);
	
	Операция = "01";
	
	СтруктураНаименованиеУид = СформироватьНаименованиеУидДоговора(ДокОбъект,ДокОбъект.ДокументОснование,ДокОбъект.ДоговорВзаиморасчетов);
	
	Для каждого СтрокаТЧ Из ДокОбъект.Товары Цикл
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= Операция;
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		
		НовСтрока.ДатаДок			= Формат(ДокОбъект.Дата, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);
		НовСтрока.ДатаВхДок			= ДокОбъект.ВхДокДата;
		НовСтрока.НомерВхДок		= СокрЛП(ДокОбъект.ВхДокНомер);
		
		НовСтрока.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.Контрагент 	 	= ДокОбъект.Контрагент.УникальныйИдентификатор();
		НовСтрока.Договор 			= СтруктураНаименованиеУид.УИД;
		
		НовСтрока.Номенклатура		= СтрокаТЧ.Номенклатура.УникальныйИдентификатор();
		НовСтрока.Количество		= СтрокаТЧ.Количество * СтрокаТЧ.Коэффициент;
		НовСтрока.Сумма				= СтрокаТЧ.СуммаВсего;// + ?(ДокОбъект.СуммаНДС,0,СтрокаТЧ.СуммаНДС);
		НовСтрока.СуммаНДС			= СтрокаТЧ.СуммаНДС;
		НовСтрока.ЭтоЛКМ			= Число(СтрокаТЧ.Номенклатура.ВидНоменклатуры = Перечисления.ВидыНоменклатуры.ЛКМ);
		//= Число(СтрокаТЧ.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.Краска Или СтрокаТЧ.Номенклатура.ВидНоменклатуры.Наименование = "МКЦ Рецепты");
		
		ДобавитьВТаблицу(СтрокаТЧ.Номенклатура					,7,ДопСвойства);
	КонецЦикла; 
	
	ДобавитьВТаблицу(ДокОбъект.Организация					,1,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.Контрагент						,2,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов			,7,ДопСвойства,СтруктураНаименованиеУид.Наименование,СтруктураНаименованиеУид.УИД, СтруктураНаименованиеУид.ВидДоговора,,ДокОбъект.Контрагент);
	
КонецПроцедуры // ОбработкаДокументаПоступлениеТоваровУслуг()

