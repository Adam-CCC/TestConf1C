Процедура ОбработкаДокументаППИ(ДокОбъект,ДопСвойства);
	
	//ДатаДок = ?(ЗначениеЗаполнено(ДокОбъект.ДатаОплаты),ДокОбъект.ДатаОплаты,ДокОбъект.Дата);
	ДатаДок = ДокОбъект.Дата;
	
	// оплата поставщику за а/м
	// в бух-ии разбивается на 2 документа:
	// возврат товаров поставщику и поступление товаров..
	//---------------------------------------------------
	//Для каждого СтрокаТЧ Из ДокОбъект.Платежи Цикл
		
		НовСтрока = ДопСвойства.ТаблицаДокументов.Добавить();
		
		НовСтрока.Операция 			= "12";
		НовСтрока.Представление 	= ДокОбъект.Метаданные().Представление();
		НовСтрока.ДатаДок			= Формат(ДатаДок, "ДФ=ггггММддЧЧммсс");
		НовСтрока.НомерДок			= СокрЛП(ДокОбъект.Номер);
		НовСтрока.ИдДок			 	= ДокОбъект.Ссылка.УникальныйИдентификатор();
		НовСтрока.Организация 	 	= ДокОбъект.Организация.УникальныйИдентификатор();
		НовСтрока.Контрагент 	 	= ДокОбъект.Контрагент.УникальныйИдентификатор();
		НовСтрока.Договор 			= ДокОбъект.ДоговорВзаиморасчетов.УникальныйИдентификатор();
		//НовСтрока.Номенклатура		= ДокОбъект.Автомобиль.УникальныйИдентификатор();
		//НовСтрока.Автомобиль 		= СтрокаТЧ.Автомобиль.УникальныйИдентификатор();
		НовСтрока.ДокОснование 	    = ДокОбъект.ДокументОснование.УникальныйИдентификатор();   // сделано для того, чтобы по каждому а/м формировался отдельный документ
		НовСтрока.Сумма				= ДокОбъект.СуммаДокумента;
		НовСтрока.Количество		= 1;
		
		НовСтрокаВозврат = ДопСвойства.ТаблицаДокументов.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовСтрокаВозврат,НовСтрока);
		
		НовСтрокаВозврат.Операция 	= "16";
		
		ДобавитьВТаблицу(ДокОбъект.ДоговорВзаиморасчетов						,7,ДопСвойства,,,,,ДокОбъект.Контрагент);
		//ДобавитьВТаблицу(СтрокаТЧ.Автомобиль					,2,ДопСвойства);
	//КонецЦикла; 
	
	ДобавитьВТаблицу(ДокОбъект.Организация				,1,ДопСвойства);
	ДобавитьВТаблицу(ДокОбъект.Контрагент				,2,ДопСвойства);

КонецПроцедуры // ОбработкаДокументаППИ()

