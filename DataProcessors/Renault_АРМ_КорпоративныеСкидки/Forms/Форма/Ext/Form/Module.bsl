&НаКлиенте
Процедура Автосклад(Команда)
	
	сПараметров = ПолучитьСтруктуруПараметров(Клиент);
	
	Форма = ПолучитьФорму("Обработка.Renault_АРМ_Автосклад.Форма");

	Если сПараметров.Количество() > 0 Тогда
		Форма.м_РабочийЛист = сПараметров.РабочийЛист;
		Форма.м_Клиент = сПараметров.Клиент;
		Форма.ЗапомнитьКлиента = Истина;
	КонецЕсли;
	Попытка
		Форма.ОткрытьМодально();
	Исключение
		Предупреждение("Автосклад ранее уже был открыт.
			|Закройте ранее открытую ыорму и повторите попытку.");
	КонецПопытки;
	Элементы.СписокВинКлиента.Обновить(); 
	Элементы.СписокВыданных.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруПараметров(Клиент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочиеЛисты.IDK
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.Клиент.Ссылка = &Ссылка
	|	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ
	|	И Renault_РабочиеЛисты.ЗапросНаЗакрытие = ЛОЖЬ";
	Запрос.УстановитьПараметр("Ссылка", Клиент.Контрагент);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не найден работчий лист";
		Возврат Новый Структура;
	КонецЕсли;
	сПараметров = Новый Структура;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	сПараметров.Вставить("РабочийЛист", Выборка.IDK);
	сПараметров.Вставить("Клиент", Клиент.Контрагент);
	Возврат сПараметров;
	
КонецФункции

&НаКлиенте
Процедура СменитьМенеджера(Команда)
	
	Если Элементы.ГруппаСтатусов.ТекущаяСтраница = Элементы.Все Тогда
		ТекущиеДанные = Элементы.СписокКлиентовВсе.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСтатусов.ТекущаяСтраница = Элементы.НаСогласовании Тогда
		ТекущиеДанные = Элементы.СписокКлиентовНаСогласовании.ТекущиеДанные;
	ИначеЕсли Элементы.ГруппаСтатусов.ТекущаяСтраница = Элементы.НеСогласован Тогда
		ТекущиеДанные = Элементы.СписокКлиентовНеСогласован.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Клиент = ТекущиеДанные.Ссылка;
	
	Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
	Форма.Заголовок = "Выберите менеджера";
	СписокВыбора = Новый СписокЗначений;
	Выборка = Справочники.Сотрудники.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Renault_РаботаСПравамиПользователя.ЕстьПравоКорпПродажи(Выборка.Ссылка) Тогда
			СписокВыбора.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Форма.СписокВыбора = СписокВыбора;
	
	Ответ = Форма.ОткрытьМодально();
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СменитьМенеджераНаСервере(Клиент, Ответ);
	Оповестить("Запись_КорпоративныеКлиенты");
	
КонецПроцедуры

