&НаКлиенте
Процедура СформироватьОтчетЗаявкаНаКорпкидку(Команда)
	
	ТекущаяСтрока = Неопределено;
	
	Если Элементы.СписокVINНаСогласовании.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокVINНаСогласовании.ТекущиеДанные;
		
	ИначеЕсли Элементы.СписокVINСогласован.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокVINСогласован.ТекущиеДанные;
		
	ИначеЕсли Элементы.СписокVINНеСогласован.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокVINНеСогласован.ТекущиеДанные;
		
	ИначеЕсли Элементы.СписокVINОтчетПредоставлен.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокVINОтчетПредоставлен.ТекущиеДанные;
		
	ИначеЕсли Элементы.СписокVINОтчетаНеБудет.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокVINОтчетаНеБудет.ТекущиеДанные;
		
	ИначеЕсли Элементы.СписокVINДопИнформация.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокVINДопИнформация.ТекущиеДанные;
		
	ИначеЕсли Элементы.СписокЗаявокАрхив.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокЗаявокАрхив.ТекущиеДанные;
		
	ИначеЕсли Элементы.СписокЗаявок.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.СписокЗаявок.ТекущиеДанные;
		ЗаявкаСсылка = ТекущаяСтрока.Ссылка;
	КонецЕсли;
		
	Если ТекущаяСтрока <> Неопределено Тогда
		ЗаявкаСсылка = ТекущаяСтрока.Заявка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
		Результат = СформироватьОтчетЗаявкаНаКорпкидкуНаСервере(ЗаявкаСсылка);
		Результат.ОтображатьЗаголовки = Ложь;
		Результат.ОтображатьСетку = Ложь;
		Результат.Показать("Отчет по заявке на корп.скидку");
	КонецЕсли;

КонецПроцедуры
