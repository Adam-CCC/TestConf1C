&НаКлиенте
Перем мВыбраныСсылки; 

&НаКлиенте
Процедура УстановитьЗаголовкиВкладокКлиент()
	
	УстановитьЗаголовкиВкладок();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиВкладок()
	
	ЭтоРКП = РольДоступна("ПолныеПрава") Или ПараметрыСеанса.Renault_ПраваПользователя.РазрешитьРасботуСАРМРуководителяКП;
	
	сПараметров = Новый Структура;
	сПараметров.Вставить("ПоказыватьУдаленныеЗаписи", ПоказыватьУдаленныеЗаписи);
	сПараметров.Вставить("Наименование", Наименование);
	сПараметров.Вставить("Пользователь", ПараметрыСеанса.Пользователь.Сотрудник);
	сПараметров.Вставить("ЭтоРКП", ЭтоРКП);
	
	Для Каждого Страница Из Элементы.ГруппаЗаявок.ПодчиненныеЭлементы Цикл
		мСтатусов = Новый Массив;
		Если Страница = Элементы.VINЧерновик Тогда
			КоличестоVIN = РегистрыСведений.Renault_СостоянияVINВЗаявках.ПолучитьКоличествоЗаявок(
				Перечисления.Renault_СостоянияСогласованияКорпСкидок[СтрЗаменить(Страница.Имя, "VIN", "")]);
		Иначе
			КоличестоVIN = РегистрыСведений.Renault_СостоянияVINВЗаявках.ПолучитьКоличествоVIN(
				Перечисления.Renault_СостоянияСогласованияКорпСкидок[СтрЗаменить(Страница.Имя, "VIN", "")]);
		КонецЕсли;
			
		Если КоличестоVIN = 0 Тогда
			Страница.Заголовок = Страница.Подсказка;
		Иначе
			Страница.Заголовок = Страница.Подсказка + " (" + Формат(КоличестоVIN, "ЧГ=") + ")";
		КонецЕсли;
	КонецЦикла;
	
	КоличествоНаСогласовании = Справочники.Renault_КорпоративныеКлиенты.ПолучитьКоличествоКлиентов(
		Перечисления.Renault_СостоянияСогласованияКлиента.НаСогласовании,
		сПараметров);
	КоличествоНеСогласованные = Справочники.Renault_КорпоративныеКлиенты.ПолучитьКоличествоКлиентов(
		Перечисления.Renault_СостоянияСогласованияКлиента.НеСогласован,
		сПараметров);
	КоличествоЧерновик = Справочники.Renault_КорпоративныеКлиенты.ПолучитьКоличествоКлиентов(
		Перечисления.Renault_СостоянияСогласованияКлиента.Черновик,
		сПараметров);
	КоличествоСогласован = Справочники.Renault_КорпоративныеКлиенты.ПолучитьКоличествоКлиентов(
		Перечисления.Renault_СостоянияСогласованияКлиента.Согласован,
		сПараметров);
	
	Элементы.НаСогласовании.Заголовок = "На регистрации";
	Элементы.НеСогласован.Заголовок = "Не зарегистрированные";
	
	Если ЗначениеЗаполнено(Статус) Тогда
		Если Статус = Перечисления.Renault_СостоянияСогласованияКлиента.Черновик Тогда
			КоличествоВсе = КоличествоЧерновик;
		ИначеЕсли Статус = Перечисления.Renault_СостоянияСогласованияКлиента.Согласован Тогда
			КоличествоВсе = КоличествоСогласован;
		КонецЕсли;
	Иначе
		КоличествоВсе = КоличествоЧерновик + КоличествоСогласован;
	КонецЕсли;
	
	Если КоличествоЧерновик > 0 или КоличествоСогласован > 0 Тогда
		Элементы.Все.Заголовок = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Все (%1)",
			Строка(КоличествоВсе));
	КонецЕсли;		
	Если КоличествоНаСогласовании > 0 Тогда
		Элементы.НаСогласовании.Заголовок = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"На регистрации (%1)",
			Строка(КоличествоНаСогласовании));
	КонецЕсли;
	Если КоличествоНеСогласованные > 0 Тогда
		Элементы.НеСогласован.Заголовок	= Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Не зарегистрированные (%1)",
			Строка(КоличествоНеСогласованные));
	КонецЕсли;
	
	Элементы.СменитьМенеджера.Видимость = ЭтоРКП;
	Элементы.СписокКлиентовВсеКонтекстноеМенюСменитьМенеджера.Видимость = ЭтоРКП;
	Элементы.СписокКлиентовНаСогласованииКонтекстноеМенюСменитьМенеджера.Видимость = ЭтоРКП;
	Элементы.СписокКлиентовНеСогласованКонтекстноеМенюСменитьМенеджера.Видимость = ЭтоРКП;
	Элементы.СписокКлиентовВсеМенеджер.Видимость = ЭтоРКП;
	Элементы.СписокКлиентовНаСогласованииМенеджер.Видимость = ЭтоРКП;
	Элементы.СписокКлиентовНеСогласованМенеджер.Видимость = ЭтоРКП;
	
	мСтатусов = Новый Массив;
	мСтатусов.Добавить(Перечисления.Renault_СостоянияСогласованияКорпСкидок[СтрЗаменить(СокрЛП(Элементы.ГруппаЗаявок.ТекущаяСтраница.Имя), "VIN", "")]);
	СписокVIN.Параметры.УстановитьЗначениеПараметра("Статус", мСтатусов);
	
	КонтактнаяИнформацияТекущегоКлиента.Параметры.УстановитьЗначениеПараметра("Объект", Клиент);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтутусовПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	мСостояние = Новый Массив;
	Состояние = ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКлиента." + СокрЛП(Элементы.ГруппаКлиенты.ПодчиненныеЭлементы.Группа1.ПодчиненныеЭлементы.ГруппаСтатусов.ТекущаяСтраница.Имя));
	Если Состояние <> Неопределено Тогда
		мСостояние.Добавить(Состояние);
		СписокКлиентов.Параметры.УстановитьЗначениеПараметра("Состояние", мСостояние );
	Иначе
		Если ЗначениеЗаполнено(Статус) Тогда
			мСостояние.Добавить(Статус);
			СписокКлиентов.Параметры.УстановитьЗначениеПараметра("Состояние", мСостояние );
		Иначе
			мСостояние.Добавить(ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКлиента.Согласован"));
			мСостояние.Добавить(ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКлиента.Черновик"));
			СписокКлиентов.Параметры.УстановитьЗначениеПараметра("Состояние", мСостояние);
		КонецЕсли;
	КонецЕсли;
	СписокКлиентов.Параметры.УстановитьЗначениеПараметра("ПоказыватьВсе", ПоказыватьУдаленныеЗаписи);
	СписокКлиентов.Параметры.УстановитьЗначениеПараметра("Пользователь", ПараметрыСеанса.Пользователь.Сотрудник);
	СписокКлиентов.Параметры.УстановитьЗначениеПараметра("ЭтоРКП", ЭтоРКП);
	УстановитьПараметрСписка();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьЗаголовкиВкладок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	мВыбраныСсылки = Новый Массив;
	Элементы.ГруппаОбработки.Видимость = Ложь;
	мСостояние = Новый Массив;
	Состояние = ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКлиента." + СокрЛП(Элементы.ГруппаКлиенты.ПодчиненныеЭлементы.Группа1.ПодчиненныеЭлементы.ГруппаСтатусов.ТекущаяСтраница.Имя));
	Если Состояние <> Неопределено Тогда
		мСостояние.Добавить(Состояние);
		СписокКлиентов.Параметры.УстановитьЗначениеПараметра("Состояние", мСостояние);
	Иначе
		мСостояние.Добавить(ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКлиента.Согласован"));
		мСостояние.Добавить(ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКлиента.Черновик"));
		СписокКлиентов.Параметры.УстановитьЗначениеПараметра("Состояние", мСостояние);
	КонецЕсли;
	СписокКлиентов.Параметры.УстановитьЗначениеПараметра("ПоказыватьВсе", ПоказыватьУдаленныеЗаписи);
	СписокКлиентов.Параметры.УстановитьЗначениеПараметра("Пользователь", ПараметрыСеанса.Пользователь.Сотрудник);
	СписокКлиентов.Параметры.УстановитьЗначениеПараметра("ЭтоРКП", ЭтоРКП);
	мСтатусов = Новый Массив();
	мСтатусов.Добавить( ПредопределенноеЗначение("Перечисление.Renault_СостоянияСогласованияКорпСкидок.Черновик"));
	СписокVIN.Параметры.УстановитьЗначениеПараметра("Статус", мСтатусов);
	
	Если ЗначениеЗаполнено(Клиент) Тогда
		ОткрытьСтраницуКлиента();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("УстановитьЗаголовкиВкладокКлиент", 60, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздать(Команда)
	
	Форма = ПолучитьФорму("Справочник.Renault_КорпоративныеКлиенты.Форма.Renault_ФормаКорпоративногоКлиента");
	Форма.СправочникОбъект = Справочники.Контрагенты.СоздатьЭлемент(); 
	Форма.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаИзменить(Команда)
	
	ТекущийКлиент = Неопределено;
	ТекущиеДанные = Элементы["СписокКлиентов" + Элементы.ГруппаСтатусов.ТекущаяСтраница.Имя].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтрагентСсылка = ТекущиеДанные.Контрагент;
	ОткрытьКарточкуКлиента(КонтрагентСсылка, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_КорпоративныеКлиенты" Тогда
		Элементы["СписокКлиентов" + Элементы.ГруппаКлиенты.ПодчиненныеЭлементы.Группа1.ПодчиненныеЭлементы.ГруппаСтатусов.ТекущаяСтраница.Имя].Обновить();
		УстановитьЗаголовкиВкладок();
	ИначеЕсли ИмяСобытия = "ЗаписьVIN" Тогда
		Если Элементы.ГруппаВИН.ПодчиненныеЭлементы.ГруппаЗаявок.ТекущаяСтраница.Имя = "VINЧерновик" Тогда
			Если Элементы.ГруппаВИН.Видимость Тогда
				//Козлов Е.А. Начало 12.05.2016
				//Элементы.СписокЗаявок.Обновить();
				//Козлов Е.А. Конец
			Иначе
				Элементы.СписокВинКлиента.Обновить();
				Элементы.СписокВыданных.Обновить();
			КонецЕсли;
		Иначе
			Элементы["Список" + Элементы.ГруппаВИН.ПодчиненныеЭлементы.ГруппаЗаявок.ТекущаяСтраница.Имя].Обновить();
		КонецЕсли;
		
		УстановитьЗаголовкиВкладок();
		
		Элементы.СписокVINНаСогласовании.Обновить();
		Элементы.СписокVINСогласован.Обновить();
		Элементы.СписокVINНеСогласован.Обновить();
		Элементы.СписокVINОтчетПредоставлен.Обновить();
		Элементы.СписокVINОтчетаНеБудет.Обновить();
		Элементы.СписокVINДопИнформация.Обновить();
		Элементы.СписокЗаявокАрхив.Обновить();
		Элементы.СписокЗаявок.Обновить();
		
	ИначеЕсли ИмяСобытия = "ОбновитьРабочийЛист" Тогда
		Если Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя = "ГруппаОбработкиВин" Тогда
			Элементы.СписокВинКлиента.Обновить();
			Элементы.СписокВыданных.Обновить();
		ИначеЕсли Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя = "ГруппаВыданных" Тогда
			Элементы.СписокВыданных.Обновить();
		КонецЕсли;
	КонецЕсли;
	
	УстановитьЗаголовкиВкладок();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКлиентовЧернивикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьСтраницуКлиента();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРабочиеЛистыКонтрагента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РабочиеЛисты.IDK
		|ИЗ
		|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|ГДЕ
		|	Renault_РабочиеЛисты.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Контрагент);
	МассивРабочихЛистов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	Возврат МассивРабочихЛистов;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСтраницуКлиента ()

	ТекущаяСтрока = Элементы.СписокКлиентовВсе.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивРабочихЛистов = ПолучитьРабочиеЛистыКонтрагента( ТекущаяСтрока.Контрагент);
	
	Элементы.ГруппаВИН.Видимость = Ложь;
	Элементы.ГруппаОбработки.Видимость = Истина;
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаОбработки;
	Элементы.ГруппаОбработки.Заголовок = Строка(ТекущаяСтрока.Ссылка);
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.Renault_СостоянияСогласованияКорпСкидок.ОтчетПринят);
	МассивСтатусов.Добавить(Перечисления.Renault_СостоянияСогласованияКорпСкидок.ОтчетаНеБудет);
	
	СписокВинКлиента.Параметры.УстановитьЗначениеПараметра("РабочиеЛистыКонтрагента", МассивРабочихЛистов);
	СписокВинКлиента.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	СписокВинКлиента.Параметры.УстановитьЗначениеПараметра("МассивСтатусов", МассивСтатусов);
	
	СписокВыданных.Параметры.УстановитьЗначениеПараметра("РабочиеЛистыКонтрагента", МассивРабочихЛистов);
	СписокВыданных.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	СписокВыданных.Параметры.УстановитьЗначениеПараметра("МассивСтатусов", МассивСтатусов);
	КонтактнаяИнформация.Параметры.УстановитьЗначениеПараметра("Объект", ТекущаяСтрока.Контрагент); 
	
	СписокАрхив.Параметры.УстановитьЗначениеПараметра("МассивСтатусов", МассивСтатусов);
	СписокАрхив.Параметры.УстановитьЗначениеПараметра("РабочиеЛистыКонтрагента", МассивРабочихЛистов);
	СписокАрхив.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуКлиента(КонтрагентСсылка, ТекущиеДанные)
	
	ФормаКорпКлиента = ТекущиеДанные.Ссылка.ПолучитьОбъект().ПолучитьФорму("Renault_ФормаКорпоративногоКлиента");
	ФормаКорпКлиента.СправочникОбъект = КонтрагентСсылка.ПолучитьОбъект();
	ФормаКорпКлиента.СферыДеятельности = ТекущиеДанные.Ссылка.СферыДеятельности.Выгрузить();
	ФормаКорпКлиента.Автопарк = ТекущиеДанные.Ссылка.Автопарк.Выгрузить();
	ФормаКорпКлиента.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	
	РежимВопроса = РежимДиалогаВопрос.ДаНет;
	Ответ = Вопрос(НСтр("ru='Удалить данного клиента?'"), РежимВопроса, 0);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийКлиент = Неопределено;
	ТекущиеДанные = Элементы["СписокКлиентов" + Элементы.ГруппаКлиенты.ПодчиненныеЭлементы.Группа1.ПодчиненныеЭлементы.ГруппаСтатусов.ТекущаяСтраница.Имя].ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КорпоративныйКлиентСсылка = ТекущиеДанные.Ссылка;
	ИзменитьПометкуУдаленияКлиента(КорпоративныйКлиентСсылка);
	Оповестить("Запись_КорпоративныеКлиенты");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИзменитьПометкуУдаленияКлиента(КорпоративныйКлиентСсылка)
	
	КорпоративныйКлиент = КорпоративныйКлиентСсылка.ПолучитьОбъект();
	Контрагент = КорпоративныйКлиент.Контрагент.ПолучитьОбъект();
	КорпоративныйКлиент.УстановитьПометкуУдаления(Не КорпоративныйКлиент.ПометкаУдаления);
	Контрагент.УстановитьПометкуУдаления(Не Контрагент.ПометкаУдаления);
	
КонецПроцедуры

