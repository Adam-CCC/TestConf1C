&НаКлиенте
Процедура ОткрытьVIN(Команда)
	
	Если Элементы.ГруппаВИН.Видимость Тогда
		ТекушаяСтрока = Элементы["Список" + Элементы.ГруппаЗаявок.ТекущаяСтраница.Имя].ТекущиеДанные;
	Иначе
		ТекушаяСтрока = Элементы.СписокВинКлиента.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекушаяСтрока <> Неопределено Тогда
		сПараметров = Новый Структура;
		сПараметров.Вставить("Заявка", ТекушаяСтрока.Заявка);
		сПараметров.Вставить("Автомобиль", ТекушаяСтрока.Автомобиль);
		сПараметров.Вставить("Статус", ТекушаяСтрока.СтатусЗаявки);
		ОткрытьФорму("Обработка.Renault_АРМ_КорпоративныеСкидки.Форма.ФормаVIN", сПараметров, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Процедура УстановитьПараметрСписка()
	
	ТекущаяСтрока = Элементы["СписокКлиентов" + Элементы.ГруппаКлиенты.ПодчиненныеЭлементы.Группа1.ПодчиненныеЭлементы.ГруппаСтатусов.ТекущаяСтраница.Имя].ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РезервированиеАвтомобилей.Ссылка КАК ИдентификаторРезерва,
		|	Renault_РезервированиеАвтомобилей.ВерсияДанных,
		|	Renault_РезервированиеАвтомобилей.ПометкаУдаления,
		|	Renault_РезервированиеАвтомобилей.Номер,
		|	Renault_РезервированиеАвтомобилей.Дата КАК Дата,
		|	Renault_РезервированиеАвтомобилей.Проведен,
		|	Renault_РезервированиеАвтомобилей.VIN,
		|	Renault_РезервированиеАвтомобилей.Менеджер,
		|	Renault_РезервированиеАвтомобилей.Комментарий,
		|	Renault_РезервированиеАвтомобилей.Автор,
		|	Renault_РезервированиеАвтомобилей.Контролер,
		|	Renault_РезервированиеАвтомобилей.СтатусРезерва,
		|	Renault_РезервированиеАвтомобилей.РабочийЛист,
		|	Renault_РезервированиеАвтомобилей.SedreNum,
		|	Renault_РезервированиеАвтомобилей.Клиент,
		|	Renault_РезервированиеАвтомобилей.Автомобиль,
		|	Renault_РезервированиеАвтомобилей.ДатаСнятияРезерва,
		|	ЛОЖЬ КАК Флажок,
		|	СостоянияVINВЗаявках.Статус КАК СтатусЗаявки
		|ИЗ
		|	Документ.Renault_РезервированиеАвтомобилей КАК Renault_РезервированиеАвтомобилей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_СостоянияVINВЗаявках КАК СостоянияVINВЗаявках
		|		ПО Renault_РезервированиеАвтомобилей.Автомобиль = СостоянияVINВЗаявках.VIN
		|			И Renault_РезервированиеАвтомобилей.Клиент = СостоянияVINВЗаявках.Заявка.Клиент
		|ГДЕ
		|	Renault_РезервированиеАвтомобилей.Проведен = ИСТИНА
		|	И Renault_РезервированиеАвтомобилей.Клиент = &Клиент
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		Запрос.УстановитьПараметр("Клиент", ТекущаяСтрока.Контрагент);
	Иначе
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКлиентовЧерновикПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбработатьСменуСтроки", 0.2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСменуСтроки()
	
	ТекущаяСтрока = Элементы["СписокКлиентов" + Элементы.ГруппаСтатусов.ТекущаяСтраница.Имя].ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Если ТекущаяСтрока.Ссылка <> Клиент Тогда
			Клиент = ТекущаяСтрока.Ссылка;
		КонецЕсли;
	Иначе
		Клиент = ПредопределенноеЗначение("Справочник.Renault_КорпоративныеКлиенты.ПустаяСсылка");
		Коментарий = "";
	КонецЕсли;
	
	КонтактнаяИнформацияТекущегоКлиента.Параметры.УстановитьЗначениеПараметра("Объект", Клиент.Контрагент);
	ЗаполнитьСписокКомментариев();
	
КонецПроцедуры

&НаСервере 
Процедура ОчиститьКонтакты()
	
	мУдаления = новый Массив;
	Для Каждого СтрокаЭлемента из Элементы.ГруппаКонтактов.ПодчиненныеЭлементы Цикл
		мУдаления.Добавить(СтрокаЭлемента);
	КонецЦикла;
	Для Каждого строкаМассива из мУдаления Цикл
		Элементы.Удалить(строкаМассива);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СписокКлиентовДобавитьКонтактнуюИнформацию()
	
	ОчиститьКонтакты();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 5
	|	КонтактнаяИнформация.Объект КАК Объект,
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид КАК Вид,
	|	КонтактнаяИнформация.Объект.ВедушийКонтрагент КАК ВедушийКонтрагент
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип В(&Тип)
	|	И (КонтактнаяИнформация.Объект = &Контрагент
	|			ИЛИ КонтактнаяИнформация.Объект.ВедушийКонтрагент = &Контрагент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВедушийКонтрагент,
	|	Объект,
	|	Вид";
	Запрос.УстановитьПараметр("Контрагент", Клиент.Контрагент);
	мТипов = Новый Массив;
	мТипов.Добавить(Перечисления.ТипыКонтактнойИнформации.Телефон);
	мТипов.Добавить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("Тип", мТипов);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() тогда
		Возврат;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Вид = Неопределено;
	ВедушийКонтрагент = Неопределено;
	х = 1;
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ВедушийКонтрагент) И выборка.Объект <> ВедушийКонтрагент Тогда
			ВедушийКонтрагент = Выборка.Объект;
			ПолеФормы = Элементы.Найти("КонактноеЛицо" + х);
			Если ПолеФормы = Неопределено Тогда
				ПолеФормы = Элементы.Добавить("КонактноеЛицо" + х, Тип("ДекорацияФормы"), Элементы.ГруппаКонтактов);
				ПолеФормы.Вид = ВидДекорацииФормы.Надпись; 
				ПолеФормы.Шрифт = Новый Шрифт(,,Истина,,Истина);
			КонецЕсли;
			ПолеФормы.Заголовок = Строка(Выборка.Объект);
			Вид = Неопределено;
		КонецЕсли;
		Если Вид = Неопределено ИЛИ Выборка.Вид <> Вид Тогда
			Вид = Выборка.Вид;
			ЭлементВид = Элементы.Найти("вид" + х);
			Если ЭлементВид = Неопределено Тогда
				ЭлементВид = Элементы.Добавить("Вид" + х, Тип("ДекорацияФормы"), Элементы.ГруппаКонтактов);
				ЭлементВид.Вид = ВидДекорацииФормы.Надпись;
				ЭлементВид.Шрифт = Новый Шрифт(,,Истина);
			КонецЕсли;
			ЭлементВид.Заголовок = Строка(Выборка.Вид);
		КонецЕсли;
		ЭлементПредставление = Элементы.Найти("Представление" + х);
		Если ЭлементПредставление = Неопределено Тогда
			ЭлементПредставление = Элементы.Добавить("Представление" + х, Тип("ДекорацияФормы"), Элементы.ГруппаКонтактов);
			ЭлементПредставление.Вид = ВидДекорацииФормы.Надпись;
		КонецЕсли;
		ЭлементПредставление.Заголовок = Строка(Выборка.Представление);
		х = х + 1;
	КонецЦикла;
	Коментарий = Клиент.Контрагент.Комментарий;
	
КонецПроцедуры

