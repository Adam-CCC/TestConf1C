&НаКлиенте
Перем мВыбраныСсылки;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Клиент) Тогда
		ОткрытьСтраницуКлиента();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздать(Команда)
	
	Форма = ПолучитьФорму("Справочник.Renault_КорпоративныеКлиенты.Форма.Renault_ФормаКорпоративногоКлиента");
	Форма.СправочникОбъект = Справочники.Контрагенты.СоздатьЭлемент(); 
	Форма.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_КорпоративныеКлиенты" Тогда
		
		Элементы["СписокКлиентов" + Элементы.ГруппаКлиенты.ПодчиненныеЭлементы.Группа1.ПодчиненныеЭлементы.ГруппаСтатусов.ТекущаяСтраница.Имя].Обновить();
		
	ИначеЕсли ИмяСобытия = "ОбновитьРабочийЛист" Тогда
		
		Если Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя = "ГруппаОбработкиВин" Тогда
			Элементы.СписокВинКлиента.Обновить();
			Элементы.СписокВыданных.Обновить();
		ИначеЕсли Элементы.ГруппаСтраниц.ТекущаяСтраница.Имя = "ГруппаВыданных" Тогда
			Элементы.СписокВыданных.Обновить();
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ЗаписьVIN" Тогда
		
		Элементы.СписокВинКлиента.Обновить();
		Элементы.СписокВыданных.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКлиентовЧернивикВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьСтраницуКлиента();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтраницуКлиента()
	
	Контрагент = ПолучитьКонтрагентаПоКлиенту(Клиент);
	
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.Renault_СостоянияСогласованияКорпСкидок.ОтчетПринят);
	МассивСтатусов.Добавить(Перечисления.Renault_СостоянияСогласованияКорпСкидок.ОтчетаНеБудет);
	
	СписокВинКлиента.Параметры.УстановитьЗначениеПараметра("РабочийЛист",РабочийЛист);
	СписокВинКлиента.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	СписокВинКлиента.Параметры.УстановитьЗначениеПараметра("МассивСтатусов", МассивСтатусов);
	
	СписокВыданных.Параметры.УстановитьЗначениеПараметра("РабочийЛист",РабочийЛист);
	СписокВыданных.Параметры.УстановитьЗначениеПараметра("ТекущаяДата", ТекущаяДата());
	СписокВыданных.Параметры.УстановитьЗначениеПараметра("МассивСтатусов", МассивСтатусов);
	КонтактнаяИнформация.Параметры.УстановитьЗначениеПараметра("Объект", Контрагент); 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКонтрагентаПоКлиенту(Клиент)
	
	Возврат Клиент.Контрагент;
	
КонецФункции

&НаКлиенте
Процедура СоздатьЗаявку(Команда)
	
	ФормаНового = ПолучитьФорму("Документ.Renault_ЗаявкаНаКорпоративнуюСкидку.Форма.ФормаДокумента");
	ДанныеФормы = ФормаНового.Объект;
	Если Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаОбработкиВин Тогда
		ТекущийСписок = Элементы.СписокВинКлиента;
	Иначе
		ТекущийСписок = Элементы.СписокВыданных;
	КонецЕсли;
	
	ПолучитьВыделеныеСтроки(ТекущийСписок, ТекущийСписок.ВыделенныеСтроки);
	СоздатьЗаявкуНаСервере (ДанныеФормы, мВыбраныСсылки);
	КопироватьДанныеФормы(ДанныеФормы, ФормаНового.Объект); 
	
	Если Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаВыданных Тогда
		ФормаНового.Объект.ТипЗаявки = ПредопределенноеЗначение("Перечисление.Renault_ТипыЗаявокНаКорпоротивнуюСкидку.ВозмещениеСкидки");
	КонецЕсли;
	
	ФормаНового.Открыть();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаявкуНаСервере(ДанныеФормы, мВыбраныСсылки)
	
	ТЗЗарезервированных = Новый ТаблицаЗначений;
	ТЗЗарезервированных.Колонки.Добавить("VIN", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(17)));
	ТЗЗарезервированных.Колонки.Добавить("Автомобиль", Новый ОписаниеТипов("СправочникСсылка.Автомобили"));
	
	Для Каждого СтрокаМассива из мВыбраныСсылки Цикл 
		Если Не ЗначениеЗаполнено(СтрокаМассива.СтатусЗаявки) Тогда 
			СтрокаТЗ = ТЗЗарезервированных.Добавить();
			СтрокаТЗ.VIN = СтрокаМассива.VIN;
			СтрокаТЗ.Автомобиль = СтрокаМассива.Автомобиль;
		КонецЕсли;
	КонецЦикла;
	
	ЗаявкаНаСкидку = Документы.Renault_ЗаявкаНаКорпоративнуюСкидку.СоздатьДокумент();
	ЗаявкаНаСкидку.Дата = ТекущаяДата();
	ЗаявкаНаСкидку.УстановитьНовыйНомер();
	ЗаявкаНаСкидку.Клиент = Клиент;
	ЗаявкаНаСкидку.ТипЗаявки = Перечисления.Renault_ТипыЗаявокНаКорпоротивнуюСкидку.ВозмещениеСкидки;
	ЗаявкаНаСкидку.ТипОтгрузки = Перечисления.Renault_ТипыОтгрузокНаКорпоративнуюСкидку.Отгрузка;
	ЗаявкаНаСкидку.Статус = Перечисления.Renault_СостоянияСогласованияКорпСкидок.Черновик;
	ЗаявкаНаСкидку.Автор = ПараметрыСеанса.Пользователь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.VIN,
	|	Таблица.Автомобиль
	|ПОМЕСТИТЬ ВТ_Автомобилей
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Автомобилей.VIN КАК ВИН,
	|	ВТ_Автомобилей.Автомобиль,
	|	ЕСТЬNULL(CRM_СостояниеАвтомобилейПроизводителя_v2.ЦенаПродажиБаза + CRM_СостояниеАвтомобилейПроизводителя_v2.ЦенаПродажиОпции, 0) КАК ЦенаPVC,
	|	ЕСТЬNULL(CRM_СостояниеАвтомобилейПроизводителя_v2.DEALER_PRICE_BASE + CRM_СостояниеАвтомобилейПроизводителя_v2.DEALER_PRICE_OPTION, 0) КАК ЦенаPVR
	|ИЗ
	|	ВТ_Автомобилей КАК ВТ_Автомобилей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|		ПО ВТ_Автомобилей.VIN = CRM_СостояниеАвтомобилейПроизводителя_v2.VIN";
	Запрос.УстановитьПараметр("Таблица", ТЗЗарезервированных);
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество () > 0 Тогда
		ЗаявкаНаСкидку.ТаблицаВИН.Загрузить(Результат);
	КонецЕсли;
	Приемник = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.Renault_ЗаявкаНаКорпоративнуюСкидку"));
	ЗаполнитьЗначенияСвойств(Приемник, ЗаявкаНаСкидку);
	Приемник.ТаблицаВИН.Загрузить(ЗаявкаНаСкидку.ТаблицаВИН.Выгрузить()); 
	ЗначениеВДанныеФормы(Приемник, ДанныеФормы);
	мВыбраныСсылки = Новый Массив;
	
КонецПроцедуры

&НаСервере
Процедура СогласоватьНаСервере(Отбор) 
	
	МенеджерЗаписи = РегистрыСведений.Renault_СостоянияVINВЗаявках.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.VIN = Отбор.Автомобиль;
	МенеджерЗаписи.Заявка = Отбор.Заявка;
	МенеджерЗаписи.Статус = Перечисления.Renault_СостоянияСогласованияКорпСкидок.НеСогласован;
	МенеджерЗаписи.Записать();
	
	НаборЗаписи = РегистрыСведений.Renault_СостоянияVINВЗаявках.СоздатьНаборЗаписей();
	НаборЗаписи.Отбор.VIN.Установить(Отбор.Автомобиль);
	НаборЗаписи.Отбор.Заявка.Установить(Отбор.Заявка);
	НаборЗаписи.Прочитать();
	Узел = ПланыОбмена.Renault_ОчередьЗаявокНаСкидку.ПоличитьУзелОбмена();
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, НаборЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.ГруппаВИН.Видимость = Ложь И ТекущаяСтраница = Элементы.ГруппаКлиенты Тогда
		Элементы.ГруппаВИН.Видимость = Истина;
		Элементы.ГруппаОбработки.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВинКлиентаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Если Поле.Имя = "СписокВинКлиентаФлаг" Тогда
			СтандартнаяОбработка = Ложь;
			мИндекс = мВыбраныСсылки.Найти(Элемент.ТекущиеДанные.Автомобиль);
			Если мИндекс = Неопределено Тогда
				мВыбраныСсылки.Добавить(Элемент.ТекущиеДанные.Автомобиль);
			Иначе
				мВыбраныСсылки.Удалить(мИндекс);
			КонецЕсли;
		ИначеЕсли Поле.Имя = "СписокВинКлиентаVIN" ИЛИ Поле.Имя = "СписокВинКлиентаАвтомобиль" Тогда
			Если ЗначениеЗаполнено(ТекущаяСтрока.Заявка) Тогда
				сПараметров = Новый Структура;
				сПараметров.Вставить("Заявка", ТекущаяСтрока.Заявка);
				сПараметров.Вставить("Автомобиль", ТекущаяСтрока.Автомобиль);
				сПараметров.Вставить("Статус", ТекущаяСтрока.СтатусЗаявки);
				ОткрытьФорму("Обработка.Renault_АРМ_КорпоративныеСкидки.Форма.ФормаVIN", сПараметров, ЭтаФорма);
			КонецЕсли;
		ИначеЕсли Поле.Имя = "СписокВинКлиентаСтатусДоговора" Тогда
			Если ЗначениеЗаполнено(ТекущаяСтрока.ДоговорСсылка) Тогда
				сПараметры = Новый Структура;
				сПараметры.Вставить("Ключ", ТекущаяСтрока.ДоговорСсылка);
				ОткрытьФорму("Документ.Renault_Договор.ФормаОбъекта", сПараметры);
			КонецЕсли;
		ИначеЕсли Поле.Имя = "СписокВинКлиентаСтатусЗаявки" Тогда
			Если ЗначениеЗаполнено(ТекущаяСтрока.Заявка) И ТекущаяСтрока.СтатусЗаявки = Перечисления.Renault_СостоянияСогласованияКорпСкидок.Черновик Тогда
				сПараметры = Новый Структура;
				сПараметры.Вставить("Ключ", ТекущаяСтрока.Заявка);
				ОткрытьФорму("Документ.Renault_ЗаявкаНаКорпоративнуюСкидку.Форма.ФормаДокумента", сПараметры);
			ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Заявка) И ТекущаяСтрока.СтатусЗаявки <> Перечисления.Renault_СостоянияСогласованияКорпСкидок.Черновик Тогда
				сПараметров = Новый Структура;
				сПараметров.Вставить("Заявка", ТекущаяСтрока.Заявка);
				сПараметров.Вставить("Автомобиль", ТекущаяСтрока.Автомобиль);
				сПараметров.Вставить("Статус", ТекущаяСтрока.СтатусЗаявки);
				ОткрытьФорму("Обработка.Renault_АРМ_КорпоративныеСкидки.Форма.ФормаVIN", сПараметров, ЭтаФорма);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура ПолучитьВыделеныеСтроки(ЭлементСписок, ВыделенныеСтроки)
	
	мВыбраныСсылки = Новый Массив;
	Для Каждого ВыделеннаяСтрока из ВыделенныеСтроки Цикл
		мВыбраныСсылки.Добавить(ЭлементСписок.ДанныеСтроки(ВыделеннаяСтрока));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗаявку(Команда)
	
	Если Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаОбработкиВин Тогда
		ТекущийСписок = Элементы.СписокВинКлиента;
	ИначеЕсли Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаВыданных Тогда
		ТекущийСписок = Элементы.СписокВыданных;
	КонецЕсли;
	ТекущаяСтрока = ТекущийСписок.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Или ТекущаяСтрока.СтатусЗаявки <> Перечисления.Renault_СостоянияСогласованияКорпСкидок.Черновик Тогда
		Возврат;
	КонецЕсли;
	
	сПараметры = Новый Структура;
	сПараметры.Вставить("Ключ", ТекущаяСтрока.Заявка);
	ОткрытьФорму("Документ.Renault_ЗаявкаНаКорпоративнуюСкидку.Форма.ФормаДокумента", сПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокКомментариев()
	
	ОтключитьОбработчикОжидания("ЗаполнитьСписокКомментариев");
	Если Элементы.ГруппаСтатусов.ТекущаяСтраница = Элементы.НаСогласовании 
		И Элементы.СписокКлиентовНаСогласовании.ТекущиеДанные <> Неопределено Тогда
		ИсторияКомментариев = ПолучитьИсториюКомментариевПоЗаявке(Клиент);
	Иначе
		ИсторияКомментариев = "";
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ЗаполнитьСписокКомментариев", 3, Ложь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИсториюКомментариевПоЗаявке(Клиент)
	
	Возврат РегистрыСведений.RenaultFlotte_ИсторияКомментариев.ПолучитьКомментарииПоОбъектуСтрокой(Клиент.ИдЗаявки);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьКомментарий(Клиент, Текст)
	
	ДатаДобавления = ТекущаяУниверсальнаяДата();
	
	РегистрыСведений.RenaultFlotte_ИсторияКомментариев.ДобавитьКомментарий(
		Клиент.ИдЗаявки,
		Текст,
		ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр,
		ДатаДобавления);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКомментарий(Команда)
	
	Если Не ЗначениеЗаполнено(НовыйКомментарий) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьКомментарий(Клиент, НовыйКомментарий);
	
	ЗаполнитьСписокКомментариев();
	НовыйКомментарий = "";
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговор(Команда)
	
	ПолучитьВыделеныеСтроки(Элементы.СписокВинКлиента, Элементы.СписокВинКлиента.ВыделенныеСтроки); 
	СоздатьДоговорНаСервере(мВыбраныСсылки);
	Элементы.СписокВинКлиента.Обновить();
	Элементы.СписокВыданных.Обновить();
	мВыбраныСсылки = Новый Массив;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДоговорНаСервере (мВыбраныСсылки)
	
	мАвтомобилей = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочиеЛисты.IDK
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.Клиент.Ссылка = &Ссылка
	|	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ
	|	И Renault_РабочиеЛисты.ЗапросНаЗакрытие = ЛОЖЬ";
	Запрос.УстановитьПараметр("Ссылка", Клиент.Контрагент);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не найден работчий лист";
		Возврат;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	РабочийЛист = Выборка.IDK;
	Отдел = Renault_РаботаСПравамиПользователя.ОтделПоУмолчанию(ПараметрыСеанса.Пользователь);
	ДилерскийЦентр = Отдел.ДилерскийЦентр;
	
	Для Каждого СтрокаМассива из мВыбраныСсылки Цикл 
		
		Если ЗначениеЗаполнено(СтрокаМассива.ДоговорСсылка)
			ИЛИ СтрокаМассива.Заявка.ТипЗаявки = Перечисления.Renault_ТипыЗаявокНаКорпоротивнуюСкидку.СкидкаПриОтгрузке
			И СтрокаМассива.СтатусЗаявки <> Перечисления.Renault_СостоянияСогласованияКорпСкидок.Согласован Тогда
			Продолжить;
		КонецЕсли;
		
		НовДок = Документы.Renault_Договор.СоздатьДокумент();
		НовДок.Дата = ТекущаяДата();
		НовДок.ДатаДоговора = ТекущаяДата();
		НовДок.ДилерскийЦентр = ДилерскийЦентр;
		
		НовДок.Клиент = Клиент.Контрагент;
		
		НовДок.НесколькоАвтомобилейВДоговоре = Ложь;
		НовДок.РабочийЛист = РабочийЛист;
		
		СтрАвто = НовДок.СоставДоговора.Добавить();
		СтрАвто.Идентификатор = Новый УникальныйИдентификатор;
		СтрАвто.VIN = СтрокаМассива.VIN;
		СтрАвто.Автомобиль = СтрокаМассива.Автомобиль;
		СтрАвто.Модель = СтрокаМассива.Автомобиль.Модель;
		СтрАвто.Версия = СтрокаМассива.Автомобиль.ВариантКомплектации;
		СтрАвто.Цвет = СтрокаМассива.Автомобиль.Цвет;
		СтрАвто.ГодВыпуска = Формат(СтрокаМассива.Автомобиль.ГодВыпуска, "ДФ=yyyy");
		СтрАвто.ЖелаемаяДатаВыдачи = ТекущаяДата();
		
		Запись = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
		Запись.VIN = СтрокаМассива.VIN;
		Запись.Прочитать();
		
		Если Не Запись.Выбран() Тогда
			//Все цены в ноль
			тОбщаяСуммаПоАвтомобилю = 0;
			тСтоимостьБазовойКомплектации = 0;
			тСуммаДоставки = 0;
			тСуммаСкидки = 0;
			тСтоимостьДопОпций = 0;
			тСтоимостьОпцийДилера = 0;
		Иначе
			//Получим цены продажи по данным склада
			тСтоимостьБазовойКомплектации = Запись.ЦенаПродажиБаза;
			тСуммаДоставки = Запись.ЦенаПродажиДоставка;
			тСтоимостьДопОпций = Запись.ЦенаПродажиОпции;
			тСтоимостьОпцийДилера = Запись.ЦенаПродажиДопОборудования;
			тСуммаСкидки = 0;
			ЗапролнитьДанныеПТС(СтрАвто, Запись);
		КонецЕсли;
		//Заполним окончательно в договоре
		тОбщаяСуммаПоАвтомобилю = тСтоимостьБазовойКомплектации + тСтоимостьДопОпций + тСтоимостьОпцийДилера + тСуммаДоставки;
		СтрАвто.СтоимостьБазовойКомплектации = тСтоимостьБазовойКомплектации;
		СтрАвто.СтоимостьДопОпций = тСтоимостьДопОпций;
		СтрАвто.СтоимостьОпцийДилера = тСтоимостьОпцийДилера;
		СтрАвто.ОбщаяСуммаПоАвтомобилю = тОбщаяСуммаПоАвтомобилю;
		СтрАвто.СуммаДоставки = тСуммаДоставки;
		СтрАвто.СуммаСкидки = СтрокаМассива.ЦенаPVC - СтрокаМассива.ЦенаFlotte;
		НовДок.СуммаДоговора = тОбщаяСуммаПоАвтомобилю - (СтрокаМассива.ЦенаPVC - СтрокаМассива.ЦенаFlotte);
		НовДок.ПриСозданииНовогоДоговора();
		ЗаполнитьДанныеОрганизации(НовДок);
		ЗагрузитьСписокДополнительныхОпцийПоТарифу(НовДок, СтрАвто);
		НовДок.СтатусПредварительныхДокументов = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик;
		НовДок.СтатусОкончательныхДокументов = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик;
		НовДок.СтатусДоговора = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик;
		Попытка
			НовДок.Записать(РежимЗаписиДокумента.Проведение);
			мАвтомобилей.Добавить(СтрокаМассива.Автомобиль);
		Исключение
			Инфо = ИнформацияОбОшибке();
		КонецПопытки
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗонаВыдачиПоУмолчанию(ДЦ = Неопределено)
	
	Если ДЦ = Неопределено Тогда
		ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	КонецЕсли;
	
	Запрос = новый Запрос("ВЫБРАТЬ
	                      |	CRM_ДилерскиеЦентрыЗоныВыдачи.ЗонаВыдачи.Ссылка
	                      |ИЗ
	                      |	Справочник.CRM_ДилерскиеЦентры.ЗоныВыдачи КАК CRM_ДилерскиеЦентрыЗоныВыдачи
	                      |ГДЕ
	                      |	CRM_ДилерскиеЦентрыЗоныВыдачи.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка",ДЦ);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() > 0 Тогда
		Возврат Таблица[0].ЗонаВыдачиСсылка;
	Иначе
		Возврат Справочники.Renault_ЗоныВыдачиАвтомобилей.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗапролнитьДанныеПТС(СтрАвто, ЗаписьСостояниеАвтомобилейПроизводителя)
	
	СтрАвто.ПТС = ЗаписьСостояниеАвтомобилейПроизводителя.PTS_SERIE + " " + ЗаписьСостояниеАвтомобилейПроизводителя.PTS_NUM;
	СтрАвто.МаркаМодельПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ModelTS;
	СтрАвто.ТипПТС = ЗаписьСостояниеАвтомобилейПроизводителя.TypeTS;
	СтрАвто.КатегорияПТС = ЗаписьСостояниеАвтомобилейПроизводителя.CategTS;
	СтрАвто.ГодИзготовленияПТС = ЗаписьСостояниеАвтомобилейПроизводителя.YEAR;
	СтрАвто.НомерДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ENGINE_NUM;
	СтрАвто.НомерШассиПТС = ЗаписьСостояниеАвтомобилейПроизводителя.Shassi;
	СтрАвто.НомерКузоваПТС = ЗаписьСостояниеАвтомобилейПроизводителя.Kuzov;
	СтрАвто.ЦветКузоваПТС = ЗаписьСостояниеАвтомобилейПроизводителя.COLOR_PTS;
	СтрАвто.РазрешеннаяМаксимальнаяМассаПТС = ЗаписьСостояниеАвтомобилейПроизводителя.MaxMass;
	СтрАвто.МассаБезНагрузкиПТС = ЗаписьСостояниеАвтомобилейПроизводителя.MinMass;
	СтрАвто.МощностьДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.PowerLS;
	СтрАвто.РабочийОбъемДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.VolumeEngine;
	СтрАвто.ТипДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.TypeEngine;
	СтрАвто.ЭкологическийКлассДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.EcoClass;
	СтрАвто.ОрганизацияИзготовительПТС = ЗаписьСостояниеАвтомобилейПроизводителя.NaimProiz;
	СтрАвто.ОдобрениеТипаТСПТС = ЗаписьСостояниеАвтомобилейПроизводителя.APPROV_STRING; 		
	СтрАвто.ДатаПТС = ЗаписьСостояниеАвтомобилейПроизводителя.DATE_PTS;
	СтрАвто.МодельДвигателяПТС = ЗаписьСостояниеАвтомобилейПроизводителя.ENGINE_MODEL;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеОрганизации(ДоговорОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Организация,
	|	Организации.ИНН КАК ДилерИНН,
	|	Организации.КПП КАК ДилерКПП,
	|	Организации.НаименованиеПолное КАК ДилерНаименованиеОрганизации,
	|	Организации.ОсновнойБанковскийСчет.Банк.Наименование КАК ДилерБанк,
	|	Организации.ОсновнойБанковскийСчет.Банк.КоррСчет КАК ДилерКоррСчет,
	|	Организации.ОсновнойБанковскийСчет.Банк.Код КАК ДилерБИК,
	|	Организации.ОсновнойБанковскийСчет.НомерСчета КАК ДилерСчет,
	|	КонтактнаяИнформацияАдресФактический.Представление КАК ДилерАдресФактический,
	|	КонтактнаяИнформацияАдресЮридический.Представление КАК ДилерАдресЮридический,
	|	КонтактнаяИнформацияТелефон.Представление КАК ДилерТелефон
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияАдресЮридический
	|		ПО Организации.Ссылка = КонтактнаяИнформацияАдресЮридический.Объект
	|			И (&ВидАдресЮр = КонтактнаяИнформацияАдресЮридический.Вид)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияАдресФактический
	|		ПО Организации.Ссылка = КонтактнаяИнформацияАдресФактический.Объект
	|			И (&ВидАдресФакт = КонтактнаяИнформацияАдресФактический.Вид)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияТелефон
	|		ПО Организации.Ссылка = КонтактнаяИнформацияТелефон.Объект
	|			И (&ВидТелефон = КонтактнаяИнформацияТелефон.Вид)
	|ГДЕ
	|	Организации.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДоговорОбъект.Организация);
	Запрос.УстановитьПараметр("ВидТелефон", Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Запрос.УстановитьПараметр("ВидАдресФакт", Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Запрос.УстановитьПараметр("ВидАдресЮр", Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДоговорОбъект, Выборка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокДополнительныхОпцийПоТарифу(ДоговорОбъект, СтрАвто)
	
	ДоговорОбъект.ДопОпцииАвтомобилей.Очистить();
	Тариф = Renault_CRM.ПолучитьТекущийТарифНаАвтомобили(ДоговорОбъект.ДатаДоговора);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модель", СтрАвто.Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", СтрАвто.Версия);
	Запрос.УстановитьПараметр("Тариф", Тариф);
	Запрос.УстановитьПараметр("Идентификатор", СтрАвто.Идентификатор);
	Запрос.УстановитьПараметр("ДатаДоговора", ДоговорОбъект.ДатаДоговора);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Идентификатор КАК Идентификатор,
	|	ЛОЖЬ КАК Выбран,
	|	Renault_ТарифНаОпцииАвтомобилей.Опция КАК Опция,
	|	Renault_ТарифНаОпцииАвтомобилей.ЦенаКлиентская КАК Цена,
	|	Renault_ТарифНаОпцииАвтомобилей.Опция.Артикул КАК Код,
	|	ВЫРАЗИТЬ(Renault_ТарифНаОпцииАвтомобилей.Опция.НаименованиеПолное КАК СТРОКА(500)) КАК Наименование,
	|	10 КАК НомерСтроки
	|ИЗ
	|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних(
	|			,
	|			Модель = &Модель
	|				И ВариантКомплектации = &ВариантКомплектации
	|				И Тариф = &Тариф
	|				И Базовая = ЛОЖЬ) КАК Renault_ТарифНаОпцииАвтомобилей";
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	НомерСтроки = 1;
	Для Каждого Строка Из ТаблицаРезультат Цикл
		Строка.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ДоговорОбъект.ДопОпцииАвтомобилей.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДоговор(Команда)
	
	Если Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаОбработкиВин Тогда
		ТекущийСписок = Элементы.СписокВинКлиента;
	ИначеЕсли Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаВыданных Тогда
		ТекущийСписок = Элементы.СписокВыданных;
	КонецЕсли;
	
	ТекущаяСтрока = ТекущийСписок.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Или Не ЗначениеЗаполнено(ТекущаяСтрока.ДоговорСсылка)Тогда
		Возврат;
	КонецЕсли;
	
	сПараметры = Новый Структура;
	сПараметры.Вставить("Ключ", ТекущаяСтрока.ДоговорСсылка);
	ОткрытьФорму("Документ.Renault_Договор.ФормаОбъекта", сПараметры, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьВыдачу(Команда)
	
	Перем ДатаВыдачи;
	ПолучитьВыделеныеСтроки(Элементы.СписокВинКлиента, Элементы.СписокВинКлиента.ВыделенныеСтроки);
	Если ВвестиДату(ДатаВыдачи, "Введите планируемую дату выдачи", ЧастиДаты.Дата) Тогда 
		ЗапланироватьВыдачуНаСервере (мВыбраныСсылки, ДатаВыдачи);
	КонецЕсли;
	Элементы.СписокВинКлиента.Обновить();
	Элементы.СписокВыданных.Обновить();
	мВыбраныСсылки = Новый Массив;
	
КонецПроцедуры

&НаСервере
Процедура ЗапланироватьВыдачуНаСервере (мВыбраныСсылки, ДатаВыдачи)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочиеЛисты.IDK
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.Клиент.Ссылка = &Ссылка
	|	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ
	|	И Renault_РабочиеЛисты.ЗапросНаЗакрытие = ЛОЖЬ";
	Запрос.УстановитьПараметр("Ссылка", Клиент.Контрагент);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не найден рабочий лист";
		Возврат;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	РабочийЛист = Выборка.IDK;
	Отдел = Renault_РаботаСПравамиПользователя.ОтделПоУмолчанию(ПараметрыСеанса.Пользователь);
	ДилерскийЦентр = Отдел.ДилерскийЦентр;
	ЗонаВыдачи = ЗонаВыдачиПоУмолчанию(ДилерскийЦентр);
	Для Каждого СтрокаАвтомобиля из мВыбраныСсылки Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаАвтомобиля.ДоговорСсылка)
			ИЛИ СтрокаАвтомобиля.Заявка.ТипЗаявки = Перечисления.Renault_ТипыЗаявокНаКорпоротивнуюСкидку.СкидкаПриОтгрузке
			И СтрокаАвтомобиля.СтатусЗаявки <> Перечисления.Renault_СостоянияСогласованияКорпСкидок.Согласован Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаАвтомобиля.Событие) Тогда
			
			СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
			СобытиеОбъект.IDK = РабочийЛист;
			СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.Выдача;
			СобытиеОбъект.Сотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
			СобытиеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
			СобытиеОбъект.Отдел = Отдел;
			СобытиеОбъект.Комментарий = "Выдача автомобиля";
			СобытиеОбъект.ДилерскийЦентр = ДилерскийЦентр;
			СобытиеОбъект.Подразделение = ПараметрыСеанса.ПодразделениеКомпании;
			СобытиеОбъект.Дата = ТекущаяДата();
			СобытиеОбъект.ДатаНапоминания = ДатаВыдачи + 3600*9;
			
			ДокВыдача = Документы.CRM_ЗаписьНаВыдачу.СоздатьДокумент();
			ДокВыдача.Дата = ТекущаяДата();
			ДокВыдача.ДилерскийЦентр = ДилерскийЦентр;
			ДокВыдача.IDK = РабочийЛист;
			ДокВыдача.Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик;
			ДокВыдача.Клиент = Клиент.Контрагент;
			ДокВыдача.ДатаНачала =  ДатаВыдачи + 3600*9;
			ДокВыдача.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;;
			ДокВыдача.Продолжительность = 30; 
			ДокВыдача.ЗонаВыдачи = ЗонаВыдачи;
			
			СтрокаТЧ = ДокВыдача.АвтомобилиДляВыдачи.Добавить();
			СтрокаТЧ.Автомобиль = СтрокаАвтомобиля.Автомобиль;
			СтрокаТЧ.VIN = СтрокаАвтомобиля.VIN;
			СтрокаТЧ.Выбран = Истина;
			ДокВыдача.Записать(РежимЗаписиДокумента.Проведение);
			
			СобытиеОбъект.Объект = ДокВыдача.Ссылка;
			СтрокаТЧ = СобытиеОбъект.АвтомобилиДляВыдачи.Добавить();
			СтрокаТЧ.Автомобиль = СтрокаАвтомобиля.Автомобиль;
			СтрокаТЧ.VIN = СтрокаАвтомобиля.VIN;
			СтрокаТЧ.Выбран = Истина;
			СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Выдача(Команда)
	
	ПолучитьВыделеныеСтроки(Элементы.СписокВинКлиента, Элементы.СписокВинКлиента.ВыделенныеСтроки);
	ЗапланироватьВыдачуНаСервере (мВыбраныСсылки, ТекущаяДата());
	Элементы.СписокВинКлиента.Обновить();
	Элементы.СписокВыданных.Обновить();
	ПолучитьВыделеныеСтроки(Элементы.СписокВинКлиента, Элементы.СписокВинКлиента.ВыделенныеСтроки);
	ЗавершитьВыдачуНаСервере (мВыбраныСсылки, "Автомобиль выдан");
	мВыбраныСсылки = Новый Массив;
	Элементы.СписокВинКлиента.Обновить();
	Элементы.СписокВыданных.Обновить();
	
КонецПроцедуры

&НаСервере
Функция ЗавершитьВыдачуНаСервере(мВыбраныСсылки, СтатусВыдачи)
	
	МассивЗапланированных = Новый Массив;
	Для Каждого СтрокаАвтомобиля из мВыбраныСсылки Цикл	
		
		Если Не ЗначениеЗаполнено(СтрокаАвтомобиля.ДоговорСсылка)
			ИЛИ СтрокаАвтомобиля.Заявка.ТипЗаявки = Перечисления.Renault_ТипыЗаявокНаКорпоротивнуюСкидку.СкидкаПриОтгрузке
			И СтрокаАвтомобиля.СтатусЗаявки <> Перечисления.Renault_СостоянияСогласованияКорпСкидок.Согласован Тогда
			Продолжить;
		КонецЕсли;
		
		Событие = СтрокаАвтомобиля.Событие.ПолучитьОбъект();
		Событие.Обработано = Истина;
		Событие.ДатаЗакрытия = ТекущаяДата();
		Событие.АвторЗакрытия = ПараметрыСеанса.Пользователь.Сотрудник;
		Если СтатусВыдачи = "Выдача отменена" Тогда
			Событие.КомментарийЗакрытия = "Выдача отменена";
			Событие.Обработано = Ложь;
			Событие.ЗавершеноУспешно = Ложь;
		ИначеЕсли СтатусВыдачи = "Автомобиль выдан" Тогда
			Событие.КомментарийЗакрытия = "Автомобиль выдан";
			Событие.ЗавершеноУспешно = Истина;
		КонецЕсли;
		Событие.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ОтменаВыдачи(Команда)
	
	Если Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаОбработкиВин Тогда
		ТекущийСписок = Элементы.СписокВинКлиента;
	Иначе
		ТекущийСписок = Элементы.СписокВыданных;
	КонецЕсли;
	
	ПолучитьВыделеныеСтроки(ТекущийСписок, ТекущийСписок.ВыделенныеСтроки);
	ЗавершитьВыдачуНаСервере (мВыбраныСсылки, "Выдача отменена");
	мВыбраныСсылки = Новый Массив;
	Элементы.СписокВинКлиента.Обновить(); 
	Элементы.СписокВыданных.Обновить(); 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "СписокВыданныхVIN" или Поле.Имя = "СписокВыданныхАвтомобиль" Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.Заявка) Тогда
			сПараметров = Новый Структура;
			сПараметров.Вставить("Заявка", ТекущаяСтрока.Заявка);
			сПараметров.Вставить("Автомобиль", ТекущаяСтрока.Автомобиль);
			сПараметров.Вставить("Статус", ТекущаяСтрока.СтатусЗаявки);
			ОткрытьФорму("Обработка.Renault_АРМ_КорпоративныеСкидки.Форма.ФормаVIN", сПараметров, ЭтаФорма);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "СписокВыданныхДоговорСсылка" ИЛИ Поле.Имя = "СписокВыданныхСтатусДоговора" Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДоговорСсылка) Тогда
			сПараметры = Новый Структура;
			сПараметры.Вставить("Ключ", ТекущаяСтрока.ДоговорСсылка);
			ОткрытьФорму("Документ.Renault_Договор.ФормаОбъекта", сПараметры);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "СписокВыданныхСтатусЗаявки" Тогда
		Если ЗначениеЗаполнено(ТекущаяСтрока.Заявка) И ТекущаяСтрока.СтатусЗаявки = Перечисления.Renault_СостоянияСогласованияКорпСкидок.Черновик Тогда
			сПараметры = Новый Структура;
			сПараметры.Вставить("Ключ", ТекущаяСтрока.Заявка);
			ОткрытьФорму("Документ.Renault_ЗаявкаНаКорпоративнуюСкидку.Форма.ФормаДокумента", сПараметры);
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.Заявка) И ТекущаяСтрока.СтатусЗаявки <> Перечисления.Renault_СостоянияСогласованияКорпСкидок.Черновик Тогда
			сПараметров = Новый Структура;
			сПараметров.Вставить("Заявка", ТекущаяСтрока.Заявка);
			сПараметров.Вставить("Автомобиль", ТекущаяСтрока.Автомобиль);
			сПараметров.Вставить("Статус", ТекущаяСтрока.СтатусЗаявки);
			ОткрытьФорму("Обработка.Renault_АРМ_КорпоративныеСкидки.Форма.ФормаVIN", сПараметров, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
