// При использовании данной формы изменения вноятся в процедуру "Ок"
// Смотри в ней комментарии
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИмяПользователя=ПолноеИмяПользователя();
	СисИнфо = Новый СистемнаяИнформация;
	Софт=Метаданные.Имя+" v."+Метаданные.Версия+", 1C: "+СисИнфо.ВерсияПриложения;	
	Обработка=РеквизитФормыВЗначение("Объект");
	Версия=Обработка.Метаданные().Комментарий;
	ТипОбработки=?(Лев(ТипЗнч(Обработка),7)="Внешняя","Внешняя","")+"Обработка."+Обработка.Метаданные().Имя;
	Попытка
		Данные=ХранилищеОбщихНастроек.Загрузить("Ниракс-Лицензирование","Авторизация");
		Если ТипЗнч(Данные)=Тип("Структура") Тогда 
			Если Данные.Свойство("Логин")  Тогда Логин=Данные.Логин;  КонецЕсли;
			Если Данные.Свойство("Пароль") Тогда Пароль=Данные.Пароль; КонецЕсли;
		КонецЕсли;
	Исключение
	Конецпопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	urlAPI="http://web.nirax.ru/api/index.php";
	ЭтаФорма.Заголовок=ЭтаФорма.Заголовок+" v."+Версия;
	Если Не Пустаястрока(Логин) Тогда
		ЛогинПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛогинПриИзменении(Элемент)
	Если ПустаяСтрока(Логин) Тогда
		Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(0,0,0);
		ЛогинВерен=Ложь;
	Иначе
		Оповещение=Новый ОписаниеОповещения("КурсорНаЛогин",ЭтаФорма);
		Запрос=новый Структура("action,login","isRegistration",Логин);
		Ответ=ВыполнитьЗапрос(Запрос);
		Если Ответ.result=Ложь тогда
			ЛогинВерен=Ложь;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
			ПоказатьПредупреждение(Оповещение,"Проблемы доступа к серверу."+символы.ПС+Ответ.comment,,"Проверка регистрации пользователя");
		ИначеЕсли Ответ.isRegistration<>Истина Тогда
			ЛогинВерен=Ложь;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
			ПоказатьПредупреждение(Оповещение,"Пользователь с таким Логином не существует.",,"Проверка регистрации пользователя");
		ИначеЕсли Ответ.role<1 Тогда
			ЛогинВерен=Ложь;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
			ПоказатьПредупреждение(Оповещение,"Требуется подтверждение регистрации.",,"Проверка регистрации пользователя");
		Иначе
			ЛогинВерен=Истина;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(0,0,0);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура КурсорНаЛогин(Пар=Неопределено) Экспорт
	ЭтаФорма.ТекущийЭлемент=Элементы.Логин;
КонецПроцедуры	

&НаКлиенте
Процедура Регистрация(Команда)
	ПараметрыФормы=Новый Структура("urlAPI",urlAPI);
	Если Не ПустаяСтрока(Логин) Тогда ПараметрыФормы.Вставить("Логин",Логин); КонецЕсли;
	Если Не ПустаяСтрока(Пароль) Тогда ПараметрыФормы.Вставить("Пароль",Пароль); КонецЕсли;
	Оповещение=Новый ОписаниеОповещения("КонецРегистрации",ЭтаФорма);
	ОткрытьФорму(ТипОбработки+".Форма.Лицензирование",ПараметрыФормы,
	ЭтаФорма,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура КонецРегистрации(Данные,Доп) Экспорт
	Если Данные<>Неопределено Тогда
		Логин=Данные.Логин;
		Пароль=Данные.Пароль;
	КонецЕсли;
	ЛогинПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Ок(Команда)
	Если ЛогинВерен = Ложь или ПустаяСтрока(Пароль) Тогда Возврат; КонецЕсли;
	Запрос=новый Структура("action,login,password","userView",Логин,Пароль);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Ложь Тогда
		ЭтаФорма.ТекущийЭлемент=Элементы.Пароль;
		ПоказатьПредупреждение(,Ответ.comment,,"Проверка регистрации пользователя");
		Возврат;
	КонецЕсли;

	// Открытие сеанса
	Запрос=новый Структура("action,login,password","sessionOpen",Логин,Пароль);
	// Укажите ключ продукта вместо "registration"
	Запрос.Вставить("keySoftware","CarAssistant");
	Запрос.Вставить("userName",ИмяПользователя);
	Запрос.Вставить("workstation",ИмяКомпьютера());
	Запрос.Вставить("softwareVersion",Версия);
	Запрос.Вставить("userSoft",Софт);
	ДанныеСеанса=ВыполнитьЗапрос(Запрос);
	Если ДанныеСеанса.result=ложь или ДанныеСеанса.idSession=0 Тогда
		ПоказатьПредупреждение(,"При при открытии сеанса произошли ошибки:"+символы.ПС+ДанныеСеанса.comment,,"Открытие сеанса");
	Иначе
		// Укажите имя основной формы. 
		ОсновнаяФорма="ОсновнаяФормаУФ";
		ДанныеСеанса.Вставить("urlAPI",urlAPI);
		// В основную форму передадутся Данные сеанса, которые содержат следующую информацию
		// idSession - Код сеанса - указывать при каждом обращении к web-серверу и при закрытии сеанса
		// idLicense - Код лицензии - если 0 - лицензия отсутствует - генерируйте в этом случае режим "ДЕМО"
		// idSoftware - Код программного продукта 
		// idUser - код Пользователя
		// urlAPI - адрес API;
		// Добавляейте в Данные сеанса требуемую информацию
		//
		ОткрытьФорму(ТипОбработки+".Форма."+ОсновнаяФорма, ДанныеСеанса);
		ЭтаФорма.Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапрос(ПараметрыЗапроса)
	Попытка
		ПараметрыТекст="";
		ПараметрыТекст2="";
		Если ТипЗнч(ПараметрыЗапроса)=Тип("Структура") Тогда
			Для каждого Эл Из ПараметрыЗапроса Цикл
				Тип=ТипЗнч(Эл.Значение);
				Значение=?(Тип=Тип("Число"),Формат(Эл.Значение,"ЧГ=0;ЧН="),
				?(Тип<>Тип("Булево"), КодироватьURL(Строка(Эл.Значение)),
				?(Эл.Значение=Истина,1,0)));
				ПараметрыТекст=ПараметрыТекст+"&"+Эл.Ключ+"="+Значение;
			КонецЦикла
		КонецЕсли;
		Запрос=Сред(ПараметрыТекст,2);
		
		НТТР = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");

		НТТР.open("POST", urlAPI, 0);
		НТТР.setRequestHeader("Content-Type","application/x-www-form-urlencoded; charset=utf-8");
		НТТР.setRequestHeader("Content-Length", СтрДлина(Запрос));
		НТТР.send(Запрос);
		Если  НТТР.status=200 Тогда
			Если лев(НТТР.responseText,1)="<" Тогда
				Возврат Новый Структура("result,comment",Ложь,"Не выполнен запрос: "+символы.ПС+
				Запрос+Символы.ПС+"получен ответ: "+Символы.ПС+НТТР.responseText);
			КонецЕсли;
			Рез=UnJSON(НТТР.responseText);
			Если ЗначениеЗаполнено(Рез) Тогда
				Возврат Рез;
			Иначе
				Возврат Новый Структура("result,comment",Ложь,"Не выполнен запрос: "+символы.ПС+
				Запрос+Символы.ПС+"получен ответ: "+Символы.ПС+НТТР.responseText);
			КонецЕсли;
	
		Иначе
			
			Возврат Новый Структура("result,comment",Ложь,"Ошибка подключения при авторизации, статус ответа =  "+Строка(НТТР.status));
		КонецЕсли;
	Исключение
		Возврат Новый Структура("result,comment",Ложь,"Ошибка при подключении: "+ОписаниеОшибки());
	Конецпопытки;
 
КонецФункции

&НаСервере
Функция КодироватьURL(Текст)
	Ш16="0123456789ABCDEF";
	С127="37,38,39,42,44,47,58,59,60,61,62,63,91,93,94,96,123,124,125,127";
	Рез="";
	Дл=СтрДлина(Текст);
	Для Поз=1 По Дл Цикл
		КодС=КодСимвола(Текст,Поз);
		Если КодС<45 ИЛИ КодС=47 Тогда
			Рез=Рез+"%"+Сред(Ш16,Цел(КодС/16)+1,1)+Сред(Ш16,КодС%16+1,1);
		ИначеЕсли КодС<128 Тогда
			Если Найти(С127,Строка(КодС))=0 Тогда
				Рез=Рез+Сред(Текст,Поз,1);
			Иначе
				Рез=Рез+"%"+Сред(Ш16,Цел(КодС/16)+1,1)+Сред(Ш16,КодС%16+1,1);
			КонецЕсли;
		Иначе
			Ост=КодС%16;
			КодС=Цел(КодС/16);
			Если КодС<128 Тогда
				КодК=(КодС%4+8)*16+Ост;
				КодС=Цел(КодС/4);
				Ост=КодС%16;
				КодС=Цел(КодС/16);
				КодН=(КодС+12)*16+Ост;
				Рез=Рез+"%"+Сред(Ш16,Цел(КодН/16)+1,1)+Сред(Ш16,КодН%16+1,1)+
				"%"+Сред(Ш16,Цел(КодК/16)+1,1)+Сред(Ш16,КодК%16+1,1);
			Иначе
				КодК=(КодС%4+8)*16+Ост;
				КодС=Цел(КодС/4);
				Ост=КодС%16;
				КодС=Цел(КодС/16);
				КодСр=(КодС%4+8)*16+Ост;
				КодС=Цел(КодС/4);
				Рез=Рез+"%E"+Сред(Ш16,КодС+1,1)+
				"%"+Сред(Ш16,Цел(КодСр/16)+1,1)+Сред(Ш16,КодСр%16+1,1)+
				"%"+Сред(Ш16,Цел(КодК/16)+1,1)+Сред(Ш16,КодК%16+1,1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;	
КонецФункции

&НаСервере
Функция UnJSON(Текст,ЭтоСтруктура=Истина,Типизация=Истина,Сериализация=Ложь)
	Перем Объект;
	Если Не ЗначениеЗаполнено(Текст) Тогда Возврат Неопределено;КонецЕсли;

	Попытка
	Если Не ЗначениеЗаполнено(Текст) Тогда Возврат Неопределено;КонецЕсли;
	Тпоз=1; // Текущая позиция текста
	Род=Новый Массив;
	Уровень=-1;	// Текущий 
	ЭтоОбъект=Ложь;
	Объект=Новый Массив;
	ЭтоНачало=Истина;
	ЭтоЗначение=Истина;
	ДлТекст=СтрДлина(Текст);
	Пока Истина Цикл
		Если ЭтоНачало Тогда
			Если Не ЭтоЗначение Тогда           // Определяем ИМЯ Ключа
				Пока КодСимвола(Текст,ТПоз)<=32 Цикл ТПоз=ТПоз+1;КонецЦикла;  // Пропускаем пустые символы
				ТСимв=Сред(Текст,ТПоз,1);
				Если ТСимв<>"""" Тогда 
					Если ТСимв="}" Тогда ЭтоНачало=ЛОжь;Продолжить;КонецЕсли;
					ВызватьИсключение "Не найдено открывающая кавычка ключа поз: "+Строка(ТПоз);
				КонецЕсли;
				ТПоз=ТПоз+1;
				Поз=Найти(Сред(Текст,ТПоз),"""");
				ЕСли Поз=0 Тогда 
					ВызватьИсключение "Не найден закрывающая кавычка ключа поз: "+Строка(ТПоз);
				КонецЕсли;
				Ключ=Сред(Текст,ТПоз,Поз-1);
				ТПоз=ТПоз+Поз;
				ТСимв=Сред(Текст,ТПоз,1);
				ТПоз=ТПоз+1;
				Если ТСимв<>":" Тогда
					Поз=Найти(Сред(Текст,ТПоз),":");
					ЕСли Поз=0 Тогда
						ВызватьИсключение "Не найдено двоеточие после имени ключа поз: "+Строка(ТПоз);
					КонецЕсли;
					ТПоз=ТПоз+Поз;
				КонецЕсли;
				ЭтоЗначение=Истина;
			КонецЕсли;
		
			Если ЭтоЗначение Тогда
				Пока КодСимвола(Текст,ТПоз)<=32 Цикл 
					ТПоз=ТПоз+1;
					Если ТПоз>ДлТекст Тогда ВызватьИсключение "Нет завершения текста, возможно обрыв данных(1)";КонецЕсли;
				КонецЦикла;  // Пропускаем пустые символы
				ТСимв=Сред(Текст,ТПоз,1);
				Если ТСимв="{" Тогда
					Род.Добавить(?(ЭтоСтруктура,Новый Структура(),Новый Соответствие()));
					Уровень=Уровень+1;
					Если ЭтоОбъект Тогда
						Если КодСимвола(Ключ,1)<58 Тогда
							//Доработка для цифровых имен элементов структуры
							Объект.Вставить("_"+Ключ,Род[Уровень]);
						Иначе
							Объект.Вставить(Ключ,Род[Уровень]);
						КонецЕсли;
					Иначе
					    Объект.Добавить(Род[Уровень]);
					КонецЕсли;
					ЭтоОбъект=Истина;
					Объект=Род[Уровень];
					ЭтоЗначение=Ложь;
					ТПоз=ТПоз+1;
				ИначеЕсли ТСимв="[" Тогда
					Род.Добавить(Новый Массив);
					Уровень=Уровень+1;
					Если ЭтоОбъект Тогда
						Если КодСимвола(Ключ,1)<58 Тогда
							//Доработка для цифровых имен элементов структуры
							Объект.Вставить("_"+Ключ,Род[Уровень]);
						Иначе
							Объект.Вставить(Ключ,Род[Уровень]);
						КонецЕсли;
					Иначе
					    Объект.Добавить(Род[Уровень]);
					КонецЕсли;
					ЭтоОбъект=Ложь;
					Объект=Род[Уровень];
					//ЭтоЗначение=Ложь;
					ТПоз=ТПоз+1;
				Иначе
					КодС=КодСимвола(ТСимв);
					Если ТСимв="""" Тогда    //Строка - ищем закрывающую кавычку
						ТПоз=ТПоз+1;
						ТПоз1=ТПоз;
						Пока Истина Цикл
							Поз=Найти(Сред(Текст,ТПоз1),"""");
							ЕСли Поз=0 Тогда 
								ВызватьИсключение "Не найден закрывающая кавычка строки от поз: "+Строка(ТПоз1);
							КонецЕсли;
							Если Сред(Текст,ТПоз1+Поз-2,1)<>"\" Тогда Прервать; КонецЕсли;
							//Подсчитываем количество наклонных и игнорируем парные
							ПозНак=ТПоз1+Поз-3;
							КолНак=1;
							Пока Сред(Текст,ПозНак,1)="\" Цикл
								КолНак=КолНак+1;
								ПозНак=ПозНак-1;
							КонецЦикла;
							Если КолНак%2=0 Тогда Прервать; КонецЕсли;
							ТПоз1=ТПоз1+Поз;
						КонецЦикла;
						Поз=Поз+ТПоз1-ТПоз;
						Значение=Сред(Текст,ТПоз,Поз-1);
						ТПоз=Тпоз+Поз;   
						Пока Истина Цикл                       //Ищем в строке Esc-последовательности
							Поз=Найти(Значение,"\");
							Если Поз=0 Тогда Прервать;КонецЕсли;
							Есимв=Сред(Значение,Поз+1,1);
							Если ЕСимв="u" Тогда
								Код1=КодСимвола(Значение,Поз+2);
								Код2=КодСимвола(Значение,Поз+3);
								Код3=КодСимвола(Значение,Поз+4);
								Код4=КодСимвола(Значение,Поз+5);
								КодС=(Код1-?(Код1<=57,48,?(Код1>=97,87,55)))*4096+
								(Код2-?(Код2<=57,48,?(Код2>=97,87,55)))*256+
								(Код3-?(Код3<=57,48,?(Код3>=97,87,55)))*16+
								(Код4-?(Код4<=57,48,?(Код4>=97,87,55)));
								Если КодС<32 И Сериализация Тогда
									Значение=Лев(Значение,Поз-1)+" "+Сред(Значение,Поз+6);
								Иначе
									Значение=Лев(Значение,Поз-1)+Символ(КодС)+Сред(Значение,Поз+6);
								КонецЕсли;
							ИначеЕсли Сериализация И Найти("0abtnvfre",Есимв)<>0 Тогда
								Значение=Лев(Значение,Поз-1)+" "+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="a" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(0)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="a" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(7)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="b" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(8)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="t" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(9)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="n" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(10)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="v" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(11)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="f" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(12)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="r" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(13)+Сред(Значение,Поз+2);
							ИначеЕсли Есимв="e" тогда 
								Значение=Лев(Значение,Поз-1)+Символ(27)+Сред(Значение,Поз+2);
							Иначе
								Значение=Лев(Значение,Поз-1)+Сред(Значение,Поз+1);
							КонецЕсли;
						КонецЦикла;
					ИначеЕсли КодС<=57 Тогда   // Число
						ТПоз1=ТПоз+1;
						Пока Истина Цикл
							Если Найти(",]}",Сред(Текст,ТПоз1,1))<>0 Тогда 
								Прервать;
							КонецЕсли;
							ТПоз1=ТПоз1+1;
						КонецЦикла ;
						ТекстЗначения=Сред(Текст,ТПоз,ТПоз1-ТПоз);
						Если Типизация Тогда
							Значение=Число(ТекстЗначения);
						Иначе
							Значение=ТекстЗначения;
						КонецЕсли;
						ТПОЗ=ТПОЗ1;
					ИначеЕсли ТСимв="]" Тогда 
						ЭтоНачало=Ложь;Продолжить;
					Иначе
						Слово=Сред(Текст,ТПоз,4);
						Если Слово="true" или слово="TRUE" Тогда
							Если Типизация Тогда
								Значение=Истина;
							Иначе
								Значение=Слово;
							КонецЕсли;
							ТПоз=ТПоз+4;
						ИначеЕсли Сред(Текст,ТПоз,5)="false" или Сред(Текст,ТПоз,5)="FALSE" Тогда
							Если Типизация Тогда
								Значение=Ложь;
							Иначе
								Значение=Сред(Текст,ТПоз,5);
							КонецЕсли;
							ТПоз=ТПоз+5;
						ИначеЕсли Слово="null" или слово="NULL" Тогда
							ТПоз=ТПоз+4;
							Если Типизация Тогда
								Значение=Неопределено;
							Иначе
								Значение=Слово;
							КонецЕсли;
						Иначе
							ВызватьИсключение "Не определено начало значения поз: "+Строка(ТПоз);
						КонецЕсли;
					КонецЕсли;
					Если ЭтоОбъект Тогда
						Если КодСимвола(Ключ,1)<58 Тогда
							//Доработка для цифровых имен элементов структуры
							Объект.Вставить("_"+Ключ,Значение);
						Иначе
							Объект.Вставить(Ключ,Значение);
						КонецЕсли;
					Иначе
						Объект.Добавить(Значение);
					КонецЕсли;
					ЭтоНачало=Ложь;
				КонецЕсли;	
			КонецЕсли;      					//ЭтоЗначение
		КонецЕсли; 								//ЭтоНачало
		
		Если Не ЭтоНачало Тогда      			//Конец элемента
			Пока КодСимвола(Текст,ТПоз)<=32 Цикл 
				ТПоз=ТПоз+1;
				Если ТПоз>ДлТекст Тогда ВызватьИсключение "Нет завершения текста, возможно обрыв данных";КонецЕсли;
			КонецЦикла;  // Пропускаем пустые символы
			ТСимв=Сред(Текст,ТПоз,1);
			Если ТСимв="," Тогда            // Следующий элемент или пара
				ЭтоЗначение=Не ЭтоОбъект;
		        ТПоз=ТПоз+1;
				ЭтоНачало=Истина;
			ИначеЕсли ТСимв="]" или ТСимв="}" Тогда
				Уровень=Уровень-1;
				ЕСли Уровень<0 Тогда Возврат Объект; КонецЕсли;
				Объект=Род[Уровень];
				ЭтоОбъект=ТипЗнч(Объект)<>Тип("Массив");
				Род.Удалить(Уровень+1);
		        ТПоз=ТПоз+1;
			Иначе
				ВызватьИсключение "Не найден конец элемента поз: "+Строка(ТПоз);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции




