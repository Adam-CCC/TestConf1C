


Процедура ПолучитьСписокСинонимовНажатие()
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.ПолучитьСинонимы();
	УстановитьПривилегированныйРежим(Истина);
	
	Синонимы = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Синонимы",,"Администратор");	
	Если Синонимы <> Неопределено Тогда
		ТаблицаСинонимов.Загрузить(Синонимы);
	КонецЕсли;
	Элементы.ЗагрузитьСправочникСинонимов.Доступность = ТаблицаСинонимов.Количество() = 0;
	Элементы.ОсновныеДействияФормыВыполнить.Доступность = ТаблицаСинонимов.Количество() > 0;
	ИспользоватьСинонимы = ТаблицаСинонимов.Количество() > 0;
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
КонецПроцедуры

Процедура ТаблицаСинонимовПроизводительНачалоВыбора(Элемент, СтандартнаяОбработка)
	Если НЕ Метаданные.Справочники.Найти("ЗначенияСвойствОбъектов") = Неопределено Тогда
		Если ТипЗнч(Элемент.Значение) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
			СсылкаПСО = СвойствоПроизводитель();
			СтандартнаяОбработка = Ложь;
			Форма = Справочники.ЗначенияСвойствОбъектов.ПолучитьФормуВыбора();
			Форма.Отбор.Владелец.Значение = СсылкаПСО;
			Форма.Отбор.Владелец.Использование = Истина;
			Форма.Отбор.Владелец.ВидСравнения=ВидСравнения.Равно;
			Значение = Форма.ОткрытьМодально();
			Если ЗначениеЗаполнено(Значение) Тогда
				Элемент.Значение = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция СвойствоПроизводитель()
	Запрос=Новый Запрос(
	"ВЫБРАТЬ
	|	СвойстваОбъектов.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
	|ГДЕ
	|	СвойстваОбъектов.Наименование = &Наименование
	|	И СвойстваОбъектов.НазначениеСвойства = &НазначениеСвойства");
	Запрос.УстановитьПараметр("Наименование","Производитель");
	Запрос.УстановитьПараметр("НазначениеСвойства",ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_Номенклатура);
	Выб=Запрос.Выполнить().Выбрать();
	Выб.Следующий();
	Возврат Выб.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии()
	
	
	ПолучитьИзХранилища();	
	
	
	//Если ТаблицаСинонимов.Количество() > 0 Тогда
	Элементы.ЗагрузитьСправочникСинонимов.Доступность = ТаблицаСинонимов.Количество() = 0;
	Элементы.ОсновныеДействияФормыВыполнить.Доступность = ТаблицаСинонимов.Количество() > 0;	
	//КонецЕсли;
	Данные=ПолучитьДанные();
	Если ТипЗнч(Данные)=Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект,Данные);
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьДанные()
	УстановитьПривилегированныйРежим(Истина);
	Данные = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ОбъектMySQL");
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Возврат Данные;
КонецФункции

Процедура ПолучитьИзХранилища()
	УстановитьПривилегированныйРежим(Истина);
	Синонимы = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Синонимы",,"Администратор");
	Если Синонимы <> Неопределено Тогда
		
		ТаблицаСинонимов.Загрузить( Синонимы);
	Иначе
		Синонимы = Новый ТаблицаЗначений;
		Массив = Новый Массив;
		Массив.Добавить(Тип("СправочникСсылка.Производители"));
		Синонимы.Колонки.Добавить("Производитель",Новый ОписаниеТипов(Массив));
		Синонимы.Колонки.Добавить("Бренд");
		Синонимы.Колонки.Добавить("Синоним");
		ТаблицаСинонимов.Загрузить( Синонимы);
		
	КонецЕсли;
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Синонимы",ТаблицаСинонимов.Выгрузить(),,"Администратор");	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
КонецПроцедуры

