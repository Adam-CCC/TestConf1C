&НаКлиенте
Процедура ОсновныеДействияФормыВыполнить(Команда)
	Таблицапроизводителей.Очистить();
	ОбработкаПроизводителейИСинонимов();
	Режим = РежимДиалогаВопрос.ДаНет;
	
		
	Для Каждого Выб из ТаблицаПроизводителей Цикл
		Масс = ТаблицаСинонимов.НайтиСтроки(Новый Структура("Синоним",Строка(Выб.Ссылка)));
		Если Масс.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(Масс[0].Производитель) Тогда
				Текст = Строка(Выб.Ссылка)+" и "+Строка(Масс[0].Производитель)+" являются синонимами? Если ""ДА"" тогда"+" "+Строка(Выб.Ссылка)+" будет помечен на удаление."; 
				Ответ = Вопрос(Текст,Режим);
				Если Ответ = КодВозвратаДиалога.Нет Тогда
					Масс[0].Производитель = Выб.Ссылка;
				ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
					ПометитьНаУдаление(Выб.Ссылка);
					
				КонецЕсли;	
			Иначе
				Бренд = Масс[0].Бренд;
				Масс1 = ТаблицаСинонимов.НайтиСтроки(Новый Структура("Бренд",Масс[0].Бренд));
				Для Каждого Стр Из Масс1 Цикл
					Стр.Производитель = Выб.Ссылка;
				КонецЦикла;
			КонецЕсли;
		Иначе
			Стр = ТаблицаСинонимов.Добавить();
			Стр.Производитель = Выб.Ссылка;
			Стр.Синоним = ВРег(Строка(Выб.Ссылка));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПометитьНаУдаление(Ссылка)
	Об = Ссылка.ПолучитьОбъект();
	Об.ПометкаУдаления = Истина;
	Об.Записать();
КонецПроцедуры



