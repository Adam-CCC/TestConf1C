// При вызове возможно задать параметры:
// Действие - выполняемое действие:
//		registration - регистрация пользователя
//		userUpdate - редактирование данных пользователя
//		userRestore - восстановление данных регистрации -
//			отправляется письмо на email пользователя
//			содержащая пароль, и если пользователь не
//			прошел подтверждение регистрации - ссылку подтверждения
//		userDelete - удаление регистрации пользователя
//		licenseQuery - запросы лицензий, здесь можно запросить
//			лицензию и посмотреть наличие запросов,
//			при необходимости скорректировать данные запроса
//		licenseActive - активные лицензии, здесь можно посмотреть
//			все свои активные лицензии, сроки их действия,
//			и на какое количество пользователей,
//			список активных сеансов, и при необходимости
//			завершить какие то сеансы.
//	Логин - логин пользователя
//	Пароль - пароль пользователя
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	urlAPI=Параметры.urlAPI;
	Логин=?(Параметры.Свойство("Логин"),Параметры.Логин,"");
	Пароль=?(Параметры.Свойство("Пароль"),Параметры.Пароль,"");
	Если Параметры.Свойство("idSession") Тогда
		КодСеанса=Параметры.idSession;
	Иначе
		ИмяПользователя=ПолноеИмяПользователя();
		СисИнфо = Новый СистемнаяИнформация;
		Софт=Метаданные.Имя+" v."+Метаданные.Версия+", 1C: "+СисИнфо.ВерсияПриложения;	
	КонецЕсли;
	
	Если Параметры.Свойство("Действие") Тогда
		Действие=Параметры.Действие;
	ИначеЕсли КодСеанса<>0 Тогда
		Действие="licenseQuery";
	ИначеЕсли ПустаяСтрока(Логин) Тогда
		Действие="registration";
	Иначе
		Действие="userUpdate";
	КонецЕсли;
	
	Попытка
		//Сначала смотрим наличие в хранилище записей Авторизации
		Данные=ХранилищеОбщихНастроек.Загрузить("Ниракс-Лицензирование","Авторизация");
		Если ТипЗнч(Данные)=Тип("Структура") Тогда 
			Если Не ПустаяСтрока(Данные.Логин) Тогда
				СохранятьПароль=Истина;
				Если ПустаяСтрока(Логин) Тогда 
					Логин=Данные.Логин;
					Пароль=Данные.Пароль;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ПустаяСтрока(Логин) Тогда
			// Берем данные из хранилища программного обеспечения /не обязательно/	
			Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ОбъектMySQL");
			Если ТипЗнч(Данные)=Тип("Структура") Тогда
				Логин=Данные.ОрганизацияДляЗаявки;
				Пароль=Данные.КлючПО;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Версия=ЭтаФорма.Заголовок;
	ЭтаФорма.Заголовок="Регистрация и лицензирование v."+Версия;
	ДействиеПриИзменении(Неопределено);
	Если КодСеанса<>0 Тогда
		Элементы.Действие.СписокВыбора.Очистить();
		Элементы.Действие.СписокВыбора.Добавить("licenseQuery","Запросы лицензий");
		Элементы.Действие.СписокВыбора.Добавить("licenseActive","Активные лицензии");
	Иначе
		ЭтаФорма.ТекущийЭлемент=Элементы.Логин;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Если КодСеанса<>0 Тогда
		Запрос=Новый Структура("action, idSession", "sessionClose", КодСеанса);
		Ответ=ВыполнитьЗапрос(Запрос);
		Если ответ.result=Ложь Тогда
			ПоказатьПредупреждение(,"При закрытии сеанса произошли ошибки:"+символы.ПС+Ответ.comment,,"Закрытие сеанса");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛогинПриИзменении(Элемент)
	Запрос=новый Структура("action,login","isRegistration",Логин);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Ложь тогда
		ЛогинПроверен=Ложь;
		Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
		ПоказатьПредупреждение(,"Проблемы доступа к серверу."+символы.ПС+Ответ.comment,,"Проверка регистрации пользователя");
	ИначеЕсли Действие="registration" Тогда
		Если Ответ.isRegistration=Истина Тогда
			ПоказатьПредупреждение(,"Пользователь с таким Логином уже существует.",,"Проверка регистрации пользователя");
			ЛогинПроверен=Ложь;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
		Иначе
			ЛогинПроверен=Истина;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(0,0,0);
		КонецЕсли;
	ИначеЕсли Действие="userUpdate" или Действие="userDelete" 
		или Действие="licenseQuery" или Действие="licenseActive" Тогда
		Если Ответ.isRegistration=Истина Тогда
			ЛогинПроверен=Истина;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(0,0,0);
			Элементы.Требуется.Видимость=Ответ.role=0;
			Если Ответ.role=0 И (Действие="licenseQuery" или Действие="licenseActive") Тогда
				ЛогинПроверен=Ложь;
				Элементы.ЗаписатьИВыйти.Доступность=Ложь;
			иначе
			    Элементы.ЗаписатьИВыйти.Доступность=Истина;
			КонецЕсли;
			Если ЗначениеЗаполнено(Пароль) Тогда
				ПарольПриИзменении(Элемент);
				Возврат;
			КонецЕсли;
		Иначе
			ПоказатьПредупреждение(,"Пользователь с таким Логином не существует.",,"Проверка регистрации пользователя");
			ЛогинПроверен=Ложь;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
		КонецЕсли;	
	ИначеЕсли Действие="userRestore" тогда
		Если Ответ.isRegistration=Истина Тогда
			ЛогинПроверен=Истина;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(0,0,0);
			Если Ответ.Свойство("role") Тогда
				Элементы.Требуется.Видимость=Ответ.role=0;
			КонецЕсли;
			Если ЗначениеЗаполнено(Email) Тогда
				EmailПриИзменении(Элемент);
				Возврат;
			КонецЕсли;
		Иначе
			ПоказатьПредупреждение(,"Пользователь с таким Логином не существует.",,"Проверка регистрации пользователя");
			ЛогинПроверен=Ложь;
			Элементы.Логин.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
		КонецЕсли;	
	КонецЕсли;
	ПроверкаЗаполненияПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)
	Если Действие="userUpdate" Тогда
		Если Элементы.Логин.Доступность=Ложь Тогда
			Элементы.ЗаписатьИВыйти.Доступность=Истина;
		ИначеЕсли ЛогинПроверен И не пустаястрока(Пароль) Тогда
			Запрос=новый Структура("action,login,password","userView",Логин,Пароль);
			Ответ=ВыполнитьЗапрос(Запрос);
			Если Ответ.result=Истина Тогда
				ПарольПроверен=Истина;
				Элементы.Пароль.ЦветТекстаЗаголовка = Новый Цвет(0,0,0);
				Фамилия=Ответ.surname;
				Имя=Ответ.name;
				Отчество=Ответ.middleName;
				Email=Ответ.email;
				Телефон=Ответ.phone;
				НаименованиеПредприятия=Ответ.companyName;
				ПарольБыл=Пароль;
				Элементы.Логин.Доступность=Ложь;
				Элементы.Фамилия.Доступность=Истина;
				Элементы.Email.Доступность=Истина;
				Элементы.Имя.Доступность=Истина;
				Элементы.Фамилия.Доступность=Истина;
				Элементы.Отчество.Доступность=Истина;
				Элементы.Телефон.Доступность=Истина;
				Элементы.НаименованиеПредприятия.Доступность=Истина;
				Элементы.СохранятьПароль.Доступность=Истина;		
				ЭтаФорма.ТекущийЭлемент=Элементы.Фамилия;
			Иначе
				ПарольПроверен=Ложь;
				Элементы.Пароль.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
				ЭтаФорма.ТекущийЭлемент=Элементы.Пароль;
				ПоказатьПредупреждение(,Ответ.comment,,"Проверка регистрации пользователя");
			КонецЕсли;
		Иначе
			ПарольПроверен=Ложь;
			Если ПустаяСтрока(Пароль) Тогда
				Элементы.Пароль.ЦветТекстаЗаголовка = Новый Цвет(0,0,0);
			Иначе
				Элементы.Пароль.ЦветТекстаЗаголовка = Новый Цвет(255,0,0);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Действие="userDelete" Тогда
		Если ЛогинПроверен И не ПустаяСтрока(Пароль) Тогда
			Запрос=новый Структура("action,login,password","isRegistration",Логин,Пароль);
			Ответ=ВыполнитьЗапрос(Запрос);
			Если Ответ.result=Истина и Ответ.isRegistration = Истина Тогда
				Элементы.ЗаписатьИВыйти.Доступность = Истина;
			Иначе
				Элементы.ЗаписатьИВыйти.Доступность = Ложь;
				ПоказатьПредупреждение(,"Не верен пароль");
			КонецЕсли;
		Иначе
			Элементы.ЗаписатьИВыйти.Доступность = Ложь;			
		КонецЕсли;
	ИначеЕсли Действие="licenseQuery" или Действие="licenseActive" Тогда 
		Если  ПустаяСтрока(Пароль) или не ЛогинПроверен Тогда
			Элементы.ЗаписатьИВыйти.Доступность = Ложь;
		Иначе
			Запрос=новый Структура("action,login,password","isRegistration",Логин,Пароль);
			Ответ=ВыполнитьЗапрос(Запрос);
			Элементы.ЗаписатьИВыйти.Доступность = Ответ.result=Истина и Ответ.isRegistration = Истина 
			И Ответ.role<>0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтметкаПриИзменении(Элемент)
	Если Действие="userUpdate" и Элементы.Email.Доступность=Истина тогда
		Элементы.ЗаписатьИВыйти.Доступность=Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура EmailПриИзменении(Элемент)
	Если Email<>"" Тогда
		Поз1=Найти(Email,"@");
		Поз2=Найти(Email,".");
		Поз3=Найти(Прав(Email,5),".");
		Если Поз1<2 или Поз2<Поз1 или Поз3=0 или Поз3=5 Тогда
			Элементы.Email.ЦветТекстаЗаголовка=Новый Цвет(255,0,0);
			EmailПроверен=Ложь;
			ПоказатьПредупреждение(,"Ошибочное имя электронной почты.",,"Проверка регистрации пользователя");
		ИначеЕсли Действие="userRestore" и ЛогинПроверен тогда
			Запрос=новый Структура("action,login,email","isRegistration",Логин,Email);
			Ответ=ВыполнитьЗапрос(Запрос);
			Если Ответ.result=Истина и Ответ.isRegistration=Истина тогда
				Элементы.Email.ЦветТекстаЗаголовка=Новый Цвет(0,0,0);
				EmailПроверен=Истина;
				Элементы.ЗаписатьИВыйти.Доступность=Истина;
				ЭтаФорма.ТекущийЭлемент=Элементы.Email;
			Иначе
				Элементы.Email.ЦветТекстаЗаголовка=Новый Цвет(255,0,0);
				EmailПроверен=Ложь;
				Элементы.ЗаписатьИВыйти.Доступность=Ложь;
				ПоказатьПредупреждение(,?(Ответ.Свойство("comment"),ответ.comment,"Не верное имя электронной почты."),,"Проверка регистрации пользователя");
			КонецЕсли;
		Иначе
			Элементы.Email.ЦветТекстаЗаголовка=Новый Цвет(0,0,0);
			EmailПроверен=Истина;
		КонецЕсли;
	Иначе
		Элементы.Email.ЦветТекстаЗаголовка=Новый Цвет(0,0,0);
		EmailПроверен=Ложь;
	КонецЕсли;
	ПроверкаЗаполненияПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЗаполненияПриИзменении(Элемент)
	Если Действие="registration" Тогда	
		ЕстьДоступ=Не (ПустаяСтрока(Логин) или Пустаястрока(Пароль) 
		или ПустаяСтрока(Имя) или Пустаястрока(Email) или Пустаястрока(Телефон)) И ЛогинПроверен И EmailПроверен;
		Элементы.ЗаписатьИВыйти.Доступность=ЕстьДоступ;
	ИначеЕсли Действие="userUpdate" и Элементы.Email.Доступность=Истина тогда
		Элементы.ЗаписатьИВыйти.Доступность=Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДействиеПриИзменении(Элемент)
	Если ПустаяСтрока(Действие) Тогда 
		Действие="registration";
	КонецЕсли;
	Если КодСеанса=0 Тогда
		Элементы.Страницы.ТекущаяСтраница=Элементы.Регистрация;
		Элементы.ЗаписатьИВыйти.Доступность=Ложь;
		ЛогинПроверен=Ложь;
		ЭтаФорма.ТекущийЭлемент=Элементы.Логин;			
		Если Действие="registration" Тогда
			Элементы.Логин.Доступность=Истина;
			Элементы.Пароль.Доступность=Истина;
			Элементы.Email.Доступность=Истина;
			Элементы.Имя.Доступность=Истина;
			Элементы.Фамилия.Доступность=Истина;
			Элементы.Отчество.Доступность=Истина;
			Элементы.Телефон.Доступность=Истина;
			Элементы.НаименованиеПредприятия.Доступность=Истина;
			Элементы.СохранятьПароль.Доступность=Истина;
			Если ЗначениеЗаполнено(Логин) Тогда
				ЛогинПриИзменении(Элемент);
				Возврат;
			КонецЕсли;
		ИначеЕсли Действие="userUpdate" или Действие="userDelete"
			или Действие="licenseQuery" или Действие="licenseActive" Тогда
			Элементы.Логин.Доступность=Истина;
			Элементы.Пароль.Доступность=Истина;
			Элементы.Email.Доступность=Ложь;
			Элементы.Имя.Доступность=Ложь;
			Элементы.Фамилия.Доступность=Ложь;
			Элементы.Отчество.Доступность=Ложь;
			Элементы.Телефон.Доступность=Ложь;
			Элементы.НаименованиеПредприятия.Доступность=Ложь;
			Элементы.СохранятьПароль.Доступность=Ложь;
			Если ЗначениеЗаполнено(Логин) Тогда
				ЛогинПриИзменении(Элемент);
				Возврат;
			КонецЕсли;
		ИначеЕсли Действие="userRestore" Тогда
			Элементы.Логин.Доступность=Истина;
			Элементы.Пароль.Доступность=Ложь;
			Элементы.Email.Доступность=Истина;
			Элементы.Имя.Доступность=Ложь;
			Элементы.Фамилия.Доступность=Ложь;
			Элементы.Отчество.Доступность=Ложь;
			Элементы.Телефон.Доступность=Ложь;
			Элементы.НаименованиеПредприятия.Доступность=Ложь;
			Элементы.СохранятьПароль.Доступность=Ложь;
			Если ЗначениеЗаполнено(Логин) Тогда
				ЛогинПриИзменении(Элемент);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Действие="licenseQuery" Тогда
		ПоказатьЗапросыЛицензий();
	ИначеЕсли Действие="licenseActive" Тогда
		ПоказатьАктивныеЛицензии();
	КонецЕсли;
	ПроверкаЗаполненияПриИзменении(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИВыйти(Команда)
	Завершить=Новый ОписаниеОповещения("ЗавершениеРаботы",ЭтаФорма,Неопределено);
	Запрос=новый Структура("action,login",Действие,Логин);
	
	Если Действие="registration" Тогда 
		Запрос.Вставить("password",Пароль);
		Запрос.Вставить("surname",Фамилия);
		Запрос.Вставить("name",Имя);
		Запрос.Вставить("middleName",Отчество);
		Запрос.Вставить("email",Email);
		Запрос.Вставить("phone",Телефон);
		Запрос.Вставить("companyName",НаименованиеПредприятия);
		Ответ=ВыполнитьЗапрос(Запрос);
		Если Ответ.result=Истина Тогда
			Если СохранятьПароль Тогда 
				Данные=Новый Структура("Логин,Пароль",Логин,Пароль);
			Иначе
				Данные=Новый Структура("Логин,Пароль","","");
			КонецЕсли;
			ЗаписатьВХранилище(Данные);
			ПоказатьПредупреждение(Завершить,"Вам отправлено письмо. Для подтверждения регистрации перейдите по ссылке, указаной в письме.",,"Регистрация пользователя");			
		Иначе
			ПоказатьПредупреждение(,"Регистрация не произведена. Ошибки:"+символы.ПС+Ответ.comment,,"Регистрация пользователя");
		КонецЕсли;
	ИначеЕсли Действие="userRestore" Тогда
		Запрос.Вставить("email",Email);
		Ответ=ВыполнитьЗапрос(Запрос);
		Если Ответ.result=Истина Тогда
			ПоказатьПредупреждение(Завершить,"Вам отправлено письмо с данными персонализации",,"Восстановление данных регистрации");
		Иначе
			ПоказатьПредупреждение(,"Ошибки при восстановлении данных регистрации:"+Символы.ПС+Ответ.comment,,"Восстановление данных регистрации");
		КонецЕсли;
	ИначеЕсли Действие="userUpdate" Тогда
		Запрос.Вставить("passwordOld",ПарольБыл);		
		Запрос.Вставить("password",Пароль);
		Запрос.Вставить("surname",Фамилия);
		Запрос.Вставить("name",Имя);
		Запрос.Вставить("middleName",Отчество);
		Запрос.Вставить("email",Email);
		Запрос.Вставить("phone",Телефон);
		Запрос.Вставить("companyName",НаименованиеПредприятия);
		Ответ=ВыполнитьЗапрос(Запрос);
		Если Ответ.result=Истина Тогда
			Если СохранятьПароль Тогда 
				Данные=Новый Структура("Логин,Пароль",Логин,Пароль);
			Иначе
				Данные=Новый Структура("Логин,Пароль","","");
			КонецЕсли;
			ЗаписатьВХранилище(Данные);
			ПоказатьПредупреждение(Завершить,"Изменение данных регистрации выполнено успешно.",,"Регистрация пользователя");			
		Иначе
			ПоказатьПредупреждение(,"Изменение данных регистрации не произведено. Ошибки:"+символы.ПС+Ответ.comment,,"Регистрация пользователя");
		КонецЕсли;
	ИначеЕсли Действие="userDelete" Тогда
		Оповещение=Новый ОписаниеОповещения("УдалениеПользователя",ЭтаФорма);
		ПоказатьВопрос(Оповещение,"Вы действительно хотите удалить пользователя: "+Логин+"?",РежимДиалогаВопрос.ДаНет);
	иначеЕсли Действие="licenseQuery" или Действие="licenseActive" Тогда
		Запрос.Вставить("password",Пароль);
		Запрос.action="sessionOpen";
		Запрос.Вставить("keySoftware","registration");
		Запрос.Вставить("userName",ИмяПользователя);
		Запрос.Вставить("workstation",ИмяКомпьютера());
		Запрос.Вставить("softwareVersion",Версия);
		Запрос.Вставить("userSoft",Софт);
		Ответ=ВыполнитьЗапрос(Запрос);
		Если Ответ.result=ложь или Ответ.idSession=0 Тогда
			ПоказатьПредупреждение(,"При при открытии сеанса произошли ошибки:"+символы.ПС+Ответ.comment,,"Открытие сеанса");
		Иначе
			КодСеанса=Ответ.idSession;
			Элементы.Действие.СписокВыбора.Очистить();
			Элементы.Действие.СписокВыбора.Добавить("licenseQuery","Запросы лицензий");
			Элементы.Действие.СписокВыбора.Добавить("licenseActive","Активные лицензии");
			Если Действие="licenseQuery" Тогда
				ПоказатьЗапросыЛицензий();
			Иначе
				ПоказатьАктивныеЛицензии();
		    КонецЕсли
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВХранилище(Данные)
	 ХранилищеОбщихНастроек.Сохранить("Ниракс-Лицензирование","Авторизация",Данные);
 КонецПроцедуры
 
&НаСервере
Процедура УдалитьВХранилище()
	ХранилищеОбщихНастроек.Удалить("Ниракс-Лицензирование","Авторизация",ИмяПользователя());
КонецПроцедуры
 
&НаКлиенте
Процедура ПоказатьЗапросыЛицензий(Команда=Неопределено)
	Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаЗапросов; 
	ЭтаФорма.Заголовок="Запросы лицензий";
	ТекДан=Элементы.ЗапросыЛицензий.ТекущиеДанные;
	Если ТекДан<>Неопределено Тогда
		ТекДан=Новый Структура("idLicenseQuery",ТекДан.idLicenseQuery);
	КонецЕсли;
	Запрос=Новый Структура("action, idSession","licenseQuery", КодСеанса);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Истина Тогда
		ЗапросыЛицензий.Очистить();
		Для Каждого Стр из Ответ.Data Цикл
			ЗаполнитьЗначенияСвойств(ЗапросыЛицензий.Добавить(),Стр);
		КонецЦикла;
		Если ТекДан <> Неопределено Тогда
			МТекСтр=ЗапросыЛицензий.НайтиСтроки(ТекДан);
			Если МТекСтр.Количество()>0 Тогда
				Элементы.ЗапросыЛицензий.ТекущаяСтрока=МТекСтр[0].ПолучитьИдентификатор();
			КонецЕсли;
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(,"При чтении данных произошли ошибки:"+символы.ПС+Ответ.comment,,"Запросы лицензий");
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ПоказатьАктивныеЛицензии(Команда=Неопределено)
	Элементы.Страницы.ТекущаяСтраница=Элементы.СтраницаЛицензий;
	ЭтаФорма.Заголовок="Активные лицензии";
	Запрос=Новый Структура("action, idSession","licenseActive", КодСеанса);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Истина Тогда
		Лицензии.Очистить();
		Для Каждого Стр из Ответ.Data Цикл
			ЗаполнитьЗначенияСвойств(Лицензии.Добавить(),Стр);
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(,"При чтении данных произошли ошибки:"+символы.ПС+Ответ.comment,,"Активные лицензии");
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура УдалениеПользователя(Рез,Доп) Экспорт
	Если Рез=Неопределено или Рез=КодВозвратаДиалога.Нет тогда 
