&НаКлиенте
Процедура АктивацияЛицензии(Ключ, Доп=Неопределено) Экспорт
	Если Ключ=Неопределено Тогда Возврат;КонецЕсли;
	Запрос=Новый Структура("action, idSession, unikey","licenseActivateKey", КодСеанса, Ключ);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Ложь Тогда
		ПоказатьПредупреждение(,"Ошибки активации лицензии: "+Ответ.comment,,"Активация лицензии");
	Иначе
		ПоказатьПредупреждение(,"Лицензия успешно активирована. Приятной работы.",,"Активация лицензии");
		
		ПоказатьАктивныеЛицензии();
		МСтр=Лицензии.НайтиСтроки(Новый Структура("idLicense",Ответ.idLicense));
		Если МСтр.Количество()>0 Тогда
			Элементы.Лицензии.ТекущаяСтрока=МСтр[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры
	
&НаКлиенте
Процедура АктивацияЛицензииИзФайла(Файл, КодЗапроса) Экспорт
	Если Файл=Неопределено Тогда Возврат;КонецЕсли;
	ТекДок=Новый ТекстовыйДокумент;
	Оповещение=Новый ОписаниеОповещения("ЧтениеЛицензииИзФайла",ЭтаФорма,ТекДок);
	ТекДок.НачатьЧтение(Оповещение,Файл[0]);
КонецПроцедуры

&НаКлиенте
Процедура ЧтениеЛицензииИзФайла(ТекДок) Экспорт
	Текст=ТекДок.ПолучитьТекст();
	Поз=Найти(Текст,"key='");
	Текст=Сред(Текст,Поз+5,24);
	Поз=Найти(Текст,"'");
	Ключ=Лев(Текст,Поз-1);
	АктивацияЛицензии(Ключ);
КонецПроцедуры

&НаКлиенте
Процедура ЛицензииПриАктивизацииСтроки(Элемент)
	ЕстьДанные=Элементы.Лицензии.ТекущиеДанные<>Неопределено;
	Элементы.ТекущиеСеансы.Доступность=ЕстьДанные;
