&НаКлиенте
Процедура ЗапроситьЛицензию(Команда)
	// Запрашиваем список программ, запросы на которые не активны или отсутствуют
	Запрос=Новый Структура("action,idSession","softwareUserView",КодСеанса);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=ЛОжь Тогда
		ПоказатьПредупреждение(,"При чтении данных произошли ошибки:"+символы.ПС+Ответ.comment,,"Программная продукция");
	КонецЕсли;
	// заносим его в список значений для выбора и начального заполнения. 
	Список=Новый СписокЗначений;
	КолСтр=Ответ.data.Количество()-1;
	Если КолСтр<0 Тогда
		ПоказатьПредупреждение(,"Продукция для запроса отсутствует",,"Программная продукция");
		Возврат;
	КонецЕсли;
	Для Инд=1 по КолСтр Цикл
		Список.Добавить(Инд,Ответ.data[Инд].name);
	КонецЦикла;
	Оповещение=Новый ОписаниеОповещения("ДобавлениеЗапросаЛицензии",ЭтаФорма,Ответ.data);
	Список.ПоказатьВыборЭлемента(Оповещение,"Произведите выбор программной продукции");
КонецПроцедуры

&НаКлиенте
Процедура ДобавлениеЗапросаЛицензии(Выбор,Данные) Экспорт
	Если Выбор=Неопределено тогда Возврат;КонецЕсли;
	Стр=Данные[Выбор.Значение];
	// Добавляем в запросы лицензий новый запрос
	Запрос=Новый Структура("action, idSession, idSoftware","licenseQueryAdd",КодСеанса,стр.idSoftware);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Ложь Тогда
		ПоказатьПредупреждение(,"При создании запроса лицензии произошли ошибки:"+символы.ПС+Ответ.comment,,"Запрос лицензии");
		Возврат;
	КонецЕсли;
	Нов=ЗапросыЛицензий.Добавить();
	Нов.idLicenseQuery=Ответ.idLicenseQuery;
	Элементы.ЗапросыЛицензий.ТекущаяСтрока=Нов.ПолучитьИдентификатор();
	Запрос=Новый Структура("action, idSession, idLicenseQuery","licenseQuery",КодСеанса,Ответ.idLicenseQuery);
	Ответ=ВыполнитьЗапрос(Запрос);
	Если Ответ.result=Ложь Тогда
		ПоказатьПредупреждение(,"При чтении созданного запроса произошли ошибки:"+символы.ПС+Ответ.comment,,"Запрос лицензии");
		ПоказатьЗапросыЛицензий();
	Иначе
		ЗаполнитьЗначенияСвойств(Нов,Ответ,"name,maxSessions,leaseTerm,queryDate");
		Нов.isDay=Число(Ответ.isDay)<>0;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ЗапросыЛицензийПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	Если Не НоваяСтрока Тогда
		ТекДан=Элементы.ЗапросыЛицензий.ТекущиеДанные;
		Запрос=Новый Структура("action, idSession, idLicenseQuery, maxSessions, leaseTerm, isDay", 
		"licenseQueryUpdate", КодСеанса, ТекДан.idLicenseQuery, Формат(ТекДан.maxSessions,"ЧГ=0;ЧН="), 
		ТекДан.leaseTerm, ТекДан.isDay);
		Ответ=ВыполнитьЗапрос(Запрос);
		Если ответ.result=Ложь Тогда
			ПоказатьПредупреждение(,"При изменении запроса лицензии произошли ошибки:"+символы.ПС+Ответ.comment,,"Изменение запроса лицензии");
			ОтменаРедактирования=Истина;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

