&НаКлиенте
Процедура Перенести(Команда)
	Спис=Новый Массив();
	Дан=Новый Структура("Марка,Номер,Наименование,Дополнительно");
	Для каждого Эл из ДанныеВыбора Цикл
		ЗаполнитьЗначенияСвойств(Дан,Эл);
		Спис.Добавить(Новый ФиксированнаяСтруктура(Дан));
	конецЦикла;
	ОповеститьОВыборе(Спис);
КонецПроцедуры

Процедура ДобавитьОбновитьВБазуСервер(Спис)
	РеквизитФормыВЗначение("Объект").АПИ_АвтоДилер_СоздатьОбновитьНоменклатуру(Спис);
Конецпроцедуры

&НаКлиенте
Процедура ДобавитьОбновитьВБазу(Команда)
	Объект.АвтоДилер_Параметры.Склад=Склад;
	Объект.АвтоДилер_Параметры.ТипЦен=ТипЦен;
	Спис=Новый Массив;
	Если РежимТД=Ложь тогда	
		Для каждого Эл из Элементы.ДанныеВыбора.ВыделенныеСтроки Цикл
			Стр=Новый Структура("Артикул,Номенклатура,Производитель,Наименование,Цена,Остаток,резерв,Номенклатура,ПозицияЭлемента");
			Дан=Элементы.ДанныеВыбора.ДанныеСтроки(Эл);
			ЗаполнитьЗначенияСвойств(Стр,Дан);
			Стр.ПозицияЭлемента=Эл;
			Спис.Добавить(Стр);
		КонецЦикла;
		ДобавитьОбновитьВБазуСервер(Спис);
		СписДоб=Новый Массив();
		Для каждого Эл из Спис Цикл
			Дан=Элементы.ДанныеВыбора.ДанныеСтроки(Эл.ПозицияЭлемента);
			ЗаполнитьЗначенияСвойств(Дан,Эл);
			Если ЗначениеЗаполнено(Дан.Номенклатура) тогда
				Если Дан.Остаток<>0 тогда
					Дан.ТипСтроки=1;
				иначе
					Дан.ТипСтроки=2;
				КонецЕсли;
				СписДоб.Добавить(Дан);
			иначе
				Если Дан.Артикул<>""  тогда
					Дан.ТипСтроки=4;
				иначе
					Дан.ТипСтроки=5;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ПоискП=Новый Структура("Артикул");
		Для каждого Эл из СписДоб Цикл
			ПоискП.Артикул=Эл.Артикул;
			СтрП=ДанныеВыбора.НайтиСтроки(ПоискП);
			Для каждого ЭлП из СтрП Цикл
				ЭлП.Номенклатура=Эл.Номенклатура;
				ЭлП.ТипСтроки=Эл.ТипСтроки;
				ЭлП.Остаток=Эл.Остаток;
				ЭлП.Цена= Эл.Цена;
				ЭлП.резерв=Эл.Резерв;
			КонецЦикла;
			
		КонецЦикла;
	иначе
		
		Для каждого Эл из Элементы.ДанныеВыбораТД.ВыделенныеСтроки Цикл
			Стр=Новый Структура("Артикул,Номенклатура,Производитель,Наименование,Цена,Остаток,резерв,Номенклатура,ПозицияЭлемента");
			Дан=Элементы.ДанныеВыбораТД.ДанныеСтроки(Эл);
			ЗаполнитьЗначенияСвойств(Стр,Дан);
			Стр.ПозицияЭлемента=Эл;
			Спис.Добавить(Стр);
		КонецЦикла;
		ДобавитьОбновитьВБазуСервер(Спис);
		СписДоб=Новый Массив();
		Для каждого Эл из Спис Цикл
			Дан=Элементы.ДанныеВыбораТД.ДанныеСтроки(Эл.ПозицияЭлемента);
			ЗаполнитьЗначенияСвойств(Дан,Эл);
			Если ЗначениеЗаполнено(Дан.Номенклатура) тогда
				Если Дан.Остаток<>0 тогда
					Дан.ТипСтроки=1;
				иначе
					Дан.ТипСтроки=2;
				КонецЕсли;
				СписДоб.Добавить(Дан);
			иначе
				Если Дан.Артикул<>""  тогда
					Дан.ТипСтроки=4;
				иначе
					Дан.ТипСтроки=5;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		ПоискП=Новый Структура("Артикул");
		Для каждого Эл из СписДоб Цикл
			ПоискП.Артикул=Эл.Артикул;
			СтрП=ДанныеВыбораТД.НайтиСтроки(ПоискП);
			Для каждого ЭлП из СтрП Цикл
				ЭлП.Номенклатура=Эл.Номенклатура;
				ЭлП.ТипСтроки=Эл.ТипСтроки;
				ЭлП.Остаток=Эл.Остаток;
				ЭлП.Цена= Эл.Цена;
				ЭлП.резерв=Эл.Резерв;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНоменклатуру(Команда)
	Если РежимТД=Ложь тогда
	
		Если Элементы.ДанныеВыбора.ТекущаяСтрока=Неопределено тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(Элементы.ДанныеВыбора.ТекущиеДанные.Номенклатура) тогда
			ОткрытьЗначение(Элементы.ДанныеВыбора.ТекущиеДанные.Номенклатура);
		КонецЕсли;
	иначе
		Если Элементы.ДанныеВыбораТД.ТекущаяСтрока=Неопределено тогда
			Возврат;
		КонецЕсли;
		Если ЗначениеЗаполнено(Элементы.ДанныеВыбораТД.ТекущиеДанные.Номенклатура) тогда
			ОткрытьЗначение(Элементы.ДанныеВыбораТД.ТекущиеДанные.Номенклатура);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАртикулВПоиск(Команда)
	Если РежимТД=Ложь тогда
		Если Элементы.ДанныеВыбора.ТекущаяСтрока=Неопределено тогда
			Возврат;
		КонецЕсли;
		Если Элементы.ДанныеВыбора.ТекущиеДанные.Артикул="" тогда
			Возврат;
		КонецЕсли;
		ВладелецФормы.Объект.НомерАртикула=Элементы.ДанныеВыбора.ТекущиеДанные.Артикул;
	иначе
		Если Элементы.ДанныеВыбораТД.ТекущаяСтрока=Неопределено тогда
			Возврат;
		КонецЕсли;
		Если Элементы.ДанныеВыбораТД.ТекущиеДанные.Артикул="" тогда
			Возврат;
		КонецЕсли;
		ВладелецФормы.Объект.НомерАртикула=Элементы.ДанныеВыбораТД.ТекущиеДанные.Артикул;
	КонецЕсли;
	ВладелецФормы.Окно.Активизировать();
КонецПроцедуры

