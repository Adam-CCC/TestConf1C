&НаКлиенте
Процедура ДобавитьВКорзину(Команда)
	Если РежимТД=Ложь тогда	
		Для каждого Эл из Элементы.ДанныеВыбора.ВыделенныеСтроки Цикл
			Дан=Элементы.ДанныеВыбора.ДанныеСтроки(Эл);
			Если не ЗначениеЗаполнено(Дан.Номенклатура) тогда
				Продолжить;
			КонецЕсли;
			ДанНом=ПолучитьИнфПоНоменклатуре(Дан.Номенклатура);
			Стр=ВладелецФормы.Объект.ЗаявкаНаОформление.Добавить();
			Стр.Номенклатура=Дан.Номенклатура;
			Стр.Производитель=Дан.Производитель;
			Стр.Количество=1;
			Стр.НаименованиеТовара=Дан.Наименование;
			Стр.Склад=Склад;
			Стр.Наименование=Дан.Номенклатура;
			Стр.Артикул=ДанНом.Артикул;
			Стр.СтавкаНДС=ДанНом.СтавкаНДС;
			Стр.СуммаСоСкидкой=Дан.Цена;
			Стр.Всего=Дан.Цена;
			Стр.СуммаНДС=0;
			Если Стр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") ИЛИ 
				Стр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
				Стр.СуммаНДС = Окр(Стр.Сумма*(1-(1/1.10)),2);
			ИначеЕсли Стр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") ИЛИ 
				Стр.СтавкаНДС=ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
				Стр.СуммаНДС = Окр(Стр.Сумма*(1-(1/1.18)),2);
			КонецЕсли;
			ЕСли ВладелецФормы.Объект.ЗаявкаНаОформление.Количество() > 0 Тогда
				ВладелецФормы.ЭтаФорма.Элементы.СтрКорзина.Заголовок = "Корзина (" + ВладелецФормы.Объект.ЗаявкаНаОформление.Количество() + ")";
			Иначе
				ВладелецФормы.ЭтаФорма.Элементы.СтрКорзина.Заголовок = "Корзина";
			КонецЕСли;
			ВладелецФормы.ЭтаФорма.СуммаКорзины=ВладелецФормы.Объект.ЗаявкаНаОформление.Итог("Всего");
		КонецЦикла;
	иначе
		Для каждого Эл из Элементы.ДанныеВыбораТД.ВыделенныеСтроки Цикл
			Дан=Элементы.ДанныеВыбораТД.ДанныеСтроки(Эл);
			Если не ЗначениеЗаполнено(Дан.Номенклатура) тогда
				Продолжить;
			КонецЕсли;
			ДанНом=ПолучитьИнфПоНоменклатуре(Дан.Номенклатура);
			Стр=ВладелецФормы.Объект.ЗаявкаНаОформление.Добавить();
			Стр.Номенклатура=Дан.Номенклатура;
			Стр.Производитель=Дан.Производитель;
			Стр.Количество=1;
			Стр.НаименованиеТовара=Дан.Наименование;
			Стр.Склад=Склад;
			Стр.Наименование=Дан.Номенклатура;
			Стр.Артикул=ДанНом.Артикул;
			Стр.СтавкаНДС=ДанНом.СтавкаНДС;
			Стр.СуммаСоСкидкой=Дан.Цена;
			Стр.Всего=Дан.Цена;
			Стр.СуммаНДС=0;
			Если Стр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10") ИЛИ 
				Стр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
				Стр.СуммаНДС = Окр(Стр.Сумма*(1-(1/1.10)),2);
			ИначеЕсли Стр.СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18") ИЛИ 
				Стр.СтавкаНДС=ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
				Стр.СуммаНДС = Окр(Стр.Сумма*(1-(1/1.18)),2);
			КонецЕсли;
			ЕСли ВладелецФормы.Объект.ЗаявкаНаОформление.Количество() > 0 Тогда
				ВладелецФормы.ЭтаФорма.Элементы.СтрКорзина.Заголовок = "Корзина (" + ВладелецФормы.Объект.ЗаявкаНаОформление.Количество() + ")";
			Иначе
				ВладелецФормы.ЭтаФорма.Элементы.СтрКорзина.Заголовок = "Корзина";
			КонецЕСли;
			ВладелецФормы.ЭтаФорма.СуммаКорзины=ВладелецФормы.Объект.ЗаявкаНаОформление.Итог("Всего");
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоУзловТДВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	РежимТД=Истина;
	Дан=Элементы.ДеревоУзлов.ДанныеСтроки(ВыбраннаяСтрока);
	Если  Дан.Каталог=1 тогда
		Возврат;
	КонецЕсли;
	Если Объект.АвтоДилер_Параметры.ОбработкаУзла="" тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка=Ложь;
	Объект.АвтоДилер_Параметры.Склад=Склад;
	Объект.АвтоДилер_Параметры.ТипЦен=ТипЦен;
	Объект.АвтоДилер_Параметры.ПараметрыУзла=Элементы.ДеревоУзлов.ДанныеСтроки(ВыбраннаяСтрока).ПараметрУзла;
	Объект.АвтоДилер_Параметры.ПоказыватьКартинку=ПоказыватьКартинку;
	Рез=ДеревоУзловВыборНаСервере();
	СтрВр=Дан.Наименование;
	Род=Дан.ПолучитьРодителя();
	ГлУзел=ДеревоУзлов.ПолучитьЭлементы()[0];
	Пока Род<>ГлУзел Цикл
		СтрВр=Род.Наименование+"\"+СтрВр;
		Род=Род.ПолучитьРодителя();
	КонецЦикла;
	ПрименяемостьТД=ложь;
	ЗаголовокУзлаТД=СтрВр;
    Элементы.ОбщиеСведенияДетали.Видимость=Ложь;
	Элементы.СтрПрименяемосьТД.Видимость=Ложь;
	Элементы.СтрТДИнф.ТекущаяСтраница=Элементы.СтрОписКомплектации;
	ДанныеВыбораТД.Очистить();
	Для каждого Эл из Рез.СписокВыбора Цикл
		СтрД=ДанныеВыбораТД.Добавить();
		ЗаполнитьЗначенияСвойств(СтрД,Эл);
		Если ЗначениеЗаполнено(СтрД.Номенклатура) тогда
			Если СтрД.Остаток<>0 тогда
				СтрД.ТипСтроки=1;
			иначе
				СтрД.ТипСтроки=2;
			КонецЕсли;
		иначе
			Если СтрД.Артикул<>""  тогда
				СтрД.ТипСтроки=4;
			иначе
				СтрД.ТипСтроки=5;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ИнфДетальТД(ИмяФункции)
	Возврат РеквизитФормыВЗначение("Объект").ВыполнитьСобытие(ИмяФункции);
КонецФункции

&НаКлиенте
Процедура ДанныеВыбораТДВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	Если ВыбраннаяСтрока=Неопределено тогда
		Возврат;
	КонецЕсли;
	Дан=Элементы.ДанныеВыбораТД.ДанныеСтроки(ВыбраннаяСтрока);
	Объект.АвтоДилер_Параметры.ПоказыватьКартинку=ПоказыватьКартинку;
	Объект.АвтоДилер_Параметры.ПараметрДетали=Дан.ИнфДетали;
	Рез=ИнфДетальТД("АПИ_АвтоДилер_ТД_ИнфДетальТД");
	ИНформацияТДДетали=Рез.ИнфДетали;
	ПрименяемостьТД=ложь;
    Элементы.ОбщиеСведенияДетали.Видимость=истина;
	Элементы.СтрПрименяемосьТД.Видимость=истина;
	Элементы.СтрТДИнф.ТекущаяСтраница=Элементы.ОбщиеСведенияДетали;
КонецПроцедуры

&НаСервере
