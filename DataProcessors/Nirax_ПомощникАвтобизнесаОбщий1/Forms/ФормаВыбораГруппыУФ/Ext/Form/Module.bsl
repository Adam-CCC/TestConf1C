
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца=Истина;
	Если Параметры.Свойство("Группы") Тогда
		ТекРод="";
		Строки=Группы.ПолучитьЭлементы();
		Для Каждого Стр Из Параметры.Группы Цикл
			Если Стр.Родитель<>ТекРод Тогда
				НовРод=Строки.Добавить();
				НовРод.Наименование=Стр.Родитель;
				СтрРод=НовРод.ПолучитьЭлементы();
				ТекРод=Стр.Родитель;
			КонецЕсли;
			НовСтр=СтрРод.Добавить();
			НовСтр.Наименование=Стр.Наименование;
			НовСтр.Код=Формат(Стр.ID_Группы,"ЧГ=0");
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажки(Команда)
	Строки=Группы.ПолучитьЭлементы();
	Значение=Команда.Имя="УстановитьФлажки";
	Для каждого Стр Из Строки Цикл
		Стр.Флаг=Значение;
		Колекция=Стр.ПолучитьЭлементы();
		Для Каждого Эл Из Колекция Цикл
			Эл.Флаг=Значение;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	СписокГрупп = "";
	Строки=Группы.ПолучитьЭлементы();
	Значение=Команда.Имя="УстановитьФлажки";
	Для каждого Стр Из Строки Цикл
		Стр.Флаг=Значение;
		Колекция=Стр.ПолучитьЭлементы();
		Для Каждого Эл Из Колекция Цикл
			Если Эл.Флаг Тогда
				СписокГрупп = СписокГрупп+", "+Эл.Код;	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ЭтаФорма.Закрыть(Сред(СписокГрупп,3));
КонецПроцедуры


&НаКлиенте
Процедура Таблица1ФлагПриИзменении(Элемент)
	Тек=Элементы.Таблица1.ТекущиеДанные;
	Род=Тек.ПолучитьРодителя();
	//Если корень
	Если Род=Неопределено Тогда
		Колекция=Тек.ПолучитьЭлементы();
		Для каждого Эл Из Колекция Цикл
			Эл.Флаг=Тек.Флаг;
		КонецЦикла;
	ИначеЕсли Род.Флаг И Тек.Флаг<>Род.Флаг Тогда
		Род.Флаг=Ложь;
	КонецЕсли;
КонецПроцедуры
