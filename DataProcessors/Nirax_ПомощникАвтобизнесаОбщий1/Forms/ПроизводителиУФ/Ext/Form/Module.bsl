
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца=Истина;
	ТЗПроизводители=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Производители");
	Если ТипЗнч(ТЗПроизводители)=Тип("ТаблицаЗначений") Тогда
		Для Каждого Стр Из ТЗПроизводители Цикл
			Нов=Производители.Добавить();
			ЗаполнитьЗначенияСвойств(Нов,Стр);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Объект.КроссПодключен=ВладелецФормы.Объект.КроссПодключен;
	Объект.СтрокаПодключенияКроссов=ВладелецФормы.Объект.СтрокаПодключенияКроссов;
	Элементы.ПроизводителиЗагрузитьИзКроссов.Доступность=Объект.КроссПодключен;
КонецПроцедуры

&НаКлиенте
Процедура Флажки(Команда)
	БулевыйФлаг=Команда.Имя="УстановитьФлажки";
	Для Каждого СтрокаТаблицы Из Производители Цикл
		СтрокаТаблицы.Признак = БулевыйФлаг;
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзКроссов(Команда)
	ЗагрузитьИзКроссовНаСервере()
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзКроссовНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	ТЗПроизводители=Обработка.ПолучитьПроизводителейИзКроссов();
	ТЗПроизводители.Сортировать("Производитель Возр");
	Отбор=Новый Структура("ТРегПроизводитель");
	Для Каждого Стр Из ТЗПроизводители Цикл
		Отбор.ТРегПроизводитель=ТРег(Стр.Производитель);
		Мас=Производители.НайтиСтроки(Отбор);
		Если Мас.Количество()=0 Тогда
			Нов=Производители.Добавить();
			Нов.Производитель=Стр.Производитель;
			Нов.ТРегПроизводитель=Отбор.ТРегПроизводитель;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	ТЗПроизводители=Новый ТаблицаЗначений;
	ТЗПроизводители.Колонки.Добавить("Признак",Новый ОписаниеТипов("Булево"));
	ТЗПроизводители.Колонки.Добавить("Производитель",Новый ОписаниеТипов("Строка"));
	ТЗПроизводители.Колонки.Добавить("ТРегПроизводитель",Новый ОписаниеТипов("Строка"));
	Для Каждого Стр Из Производители Цикл
		ЕСли ПустаяСтрока(Стр.Производитель) Тогда Продолжить;КонецЕсли;
		Нов=ТЗПроизводители.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Стр);
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Производители",ТЗПроизводители);
КонецПроцедуры

&НаКлиенте
Процедура ПроизводителиПроизводительОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Отбор=Новый Структура("ТРегПроизводитель",ТРег(Текст));
	Мас=Производители.НайтиСтроки(Отбор);
	Если Мас.Количество()=0 ИЛИ (Мас.Количество()=1 и Мас[0]=Элементы.Производители.ТекущиеДанные) Тогда
		Элементы.Производители.ТекущиеДанные.ТРегПроизводитель=ТРег(Текст);
	Иначе
		СтандартнаяОбработка=Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если ЭтаФорма.ВладелецФормы.Объект.ОтборПроизводители=Истина Тогда
		Если НетОтметокПроизводителей() Тогда
			ЭтаФорма.ВладелецФормы.Объект.ОтборПроизводители=Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НетОтметокПроизводителей()
	ТЗПроизводители=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Производители");
	Если ТипЗнч(ТЗПроизводители)<>тип("ТаблицаЗначений") Тогда Возврат Истина; КонецЕсли;
	Возврат ТЗПроизводители.Найти(Истина,"Признак")=Неопределено;
КонецФункции

