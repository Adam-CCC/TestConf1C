&НаКлиенте
Процедура ВыгрузитьПроценки(Команда)
	// Определить место выгрузки
	ТолькоВкл=Команда.Имя="ВыгрузитьОтмеченные";
	Диалог=Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Расширение="json";
	Диалог.ПолноеИмяФайла="НастройкиПроценок";
	Диалог.Заголовок="Сохранение результата выгрузки";
	Если Объект.РежимМодальности Тогда
		ЕСли Не Диалог.Выбрать() ТОгда Возврат;КонецЕсли;
		ВыгрузитьПроценкиКлиент(Диалог.ВыбранныеФайлы,ТолькоВкл);
	Иначе
		Оповещение=Новый ОписаниеОповещения("ВыгрузитьПроценкиКлиент",ЭтаФорма,ТолькоВкл);
		Диалог.Показать(Оповещение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПроценкиКлиент(МФайл,ТолькоВкл)
	Если МФайл=Неопределено ИЛИ МФайл.Количество()=0 Тогда Возврат;КонецЕсли;
	ИмяФайла=МФайл[0];
	Текст=ВыгрузитьПроценкиСервер(ТолькоВкл);
	Если Текст="" Тогда Возврат;КонецЕсли;
	ТекДок=Новый ТекстовыйДокумент;
	ТекДок.ДобавитьСтроку(Текст);
	ТекДок.Записать(ИмяФайла);
КонецПроцедуры

&НаСервере
Функция ВыгрузитьПроценкиСервер(ТолькоВкл)
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ВыгрузитьПроценки(ТолькоВкл);
КонецФункции

&НаКлиенте
Процедура ЗагрузитьПроценки(Команда)
    Если ДанныеПроценкиИзменены ИЛИ ФильтрыИзменены ИЛИ МетодыИзменены Тогда
		ТабПроценкиПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
	ЗагрузитьПроценкиНаСервере("");
	ТабПроценкиПриАктивизацииСтроки(Неопределено);
	ПроценкиИзменены=Истина;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПроценкиНаСервере(Текст="")
	Обработка=РеквизитФормыВЗначение("Объект");
	ПутьКВременнойПапке=КаталогВременныхФайлов();
	Если Текст="" Тогда
		ИмяМакета="Проценки";
		Макет=Обработка.ПолучитьМакет(ИмяМакета);
		ИмяФайла=?(Прав(ПутьКВременнойПапке,1)="\","","\")+ИмяМакета+".json";
		Макет.Записать(ИмяФайла);
		ТекДок=Новый ТекстовыйДокумент;
		ТекДок.Прочитать(ИмяФайла);
		УдалитьФайлы(ПутьКВременнойПапке,ИмяМакета+".json");
		Текст=ТекДок.ПолучитьТекст();
	КонецЕсли;
	Проценки=Обработка.UnJSON(Текст);
	Если Проценки=Неопределено Тогда
		Сообщить("Ошибки в данных, загрузка не выполнена");
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из Проценки Цикл
		МСтр=ТабПроценки.НайтиСтроки(Новый Структура("Сайт",Стр.Сайт));
		Если МСтр.Количество()=0 Тогда
			ТСтр=ТабПроценки.Добавить();
			ТСтр.Сайт=Стр.Сайт;
		Иначе
			ТСтр=МСтр[0];
		КонецЕсли;
		Если СтрДлина(Стр.Помощь)>СтрДлина(ТСтр.Помощь) Тогда
			ТСтр.Помощь=Стр.Помощь;
		КонецЕсли;
		Если ТСтр.Авторизация=Неопределено Тогда 
			ТСтр.Авторизация=Новый Структура();
		КонецЕсли;
		Для Каждого Эл Из Стр.Авторизация Цикл
			Если Не ТСтр.Авторизация.Свойство(Эл.Ключ) Тогда
				ТСтр.Авторизация.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		Если ТСтр.Фильтры=Неопределено Тогда 
			ТСтр.Фильтры=Новый Структура();
		КонецЕсли;
		Для Каждого Эл Из Стр.Фильтры Цикл
			Если Не ТСтр.Фильтры.Свойство(Эл.Ключ) Тогда
				ТСтр.Фильтры.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		Если ТСтр.Методы=Неопределено Тогда 
			ТСтр.Методы=Новый Структура();
		КонецЕсли;
		Для Каждого Эл Из Стр.Методы Цикл
			Если Не ТСтр.Методы.Свойство(Эл.Ключ) Тогда
				ТСтр.Методы.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	Диалог=Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр= "Настройки проценок(*.json)|*.json";
	Диалог.Заголовок="Выбор файла настроек проценок";
	Если Объект.РежимМодальности Тогда
		Если Не ДИалог.Выбрать() Тогда Возврат;КонецЕсли;
		ЗагрузитьФайлКлиент(Диалог.ВыбранныеФайлы);
	Иначе
		Оповещение=Новый ОписаниеОповещения("ЗагрузитьФайлКлиент",ЭтаФорма);
		Диалог.Показать(Оповещение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайлКлиент(МФайл,Доп=Неопределено)
	Если МФайл.Количество()=0 Тогда Возврат;КонецЕсли;
	ИмяФайла=МФайл[0];
	ТекДок=Новый ТекстовыйДокумент;
	ТекДок.Прочитать(ИмяФайла);
    Если ДанныеПроценкиИзменены ИЛИ ФильтрыИзменены ИЛИ МетодыИзменены Тогда
		ТабПроценкиПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
	ЗагрузитьПроценкиНаСервере(ТекДок.ПолучитьТекст());
	ТабПроценкиПриАктивизацииСтроки(Неопределено);
	ПроценкиИзменены=Истина;
КонецПроцедуры

&НаКлиенте
Процедура СпецНаз(Команда)
	Текст="";
	Тек="";
	Для Каждого Эл Из Объект.СпецНаз Цикл
		Текст=Текст+";"+Эл.Ключ;
		Если Эл.Значение = Истина Тогда Тек=Тек+";"+Эл.Ключ;КонецЕсли;
	КонецЦикла;
	Текст=Сред(Текст,2);
	Тек=Сред(Тек,2);
	Оповещение=Новый ОписаниеОповещения("СпецНазЗаписать",ЭтаФорма);
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",
	Новый Структура("СписокЗначений,ТекущееЗначение,Групповой,ФормаВыбора",Текст,Тек,Истина,Истина),
	ЭтаФорма,"СпецНаз",ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение);
КонецПроцедуры

Процедура СпецНазЗаписать(Рез,Доп=Неопределено)
	ЕСли Рез=Неопределено Тогда Возврат;КонецЕсли;
	Рез=";"+Рез+";";
	НастройкиБыли=Объект.СпецНаз.НастройкиПользователя;
	Для Каждого Эл Из Объект.СпецНаз Цикл
		Объект.СпецНаз[Эл.Ключ]=Найти(Рез,";"+Эл.Ключ+";")<>0;
	КонецЦикла;
	Если Объект.СпецНаз.НастройкиПользователя Тогда
		ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","СпецНаз",Объект.СпецНаз);
		Если НастройкиБыли=Ложь Тогда
			ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","СпецНаз",Объект.СпецНаз,,"Администратор");
		КонецЕсли;	
	Иначе
		ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","СпецНаз",Объект.СпецНаз,,"Администратор");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ШаблонНомераДляПоискаПриИзменении(Элемент)
	ЕСли ПустаяСтрока(Объект.ШаблонНомераДляПоиска) Тогда
