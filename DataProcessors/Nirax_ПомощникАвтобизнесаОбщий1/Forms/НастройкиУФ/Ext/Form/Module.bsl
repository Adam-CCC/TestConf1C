&НаКлиенте
Процедура ФильтрыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	// Ключевое поле должно быть не пустым
	Если Элементы.Фильтры.ТекущиеДанные.Параметр="" Тогда
		Если Объект.РежимМодальности Тогда
			Предупреждение("Не определено имя параметра");
		КонецЕсли;
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	Текст=ТРег(Элементы.Фильтры.ТекущиеДанные.Параметр);
	Попытка 
		Тест=Новый Структура(Текст);
	Исключение 
		Если Объект.РежимМодальности Тогда
			Предупреждение("Ошибочное именя параметра");
		КонецЕсли;
		Отказ=Истина;
		Возврат;
	КонецПопытки;
	// Ключевое поле должно быть уникальным
    //Макс=?(Элементы.Фильтры.ТекущиеДанные.Параметр=Текст,1,0);
	Элементы.Фильтры.ТекущиеДанные.Параметр=Текст;
	Отбор=Новый Структура("Параметр",Текст);
	Если Фильтры.НайтиСтроки(Отбор).Количество()>1 Тогда
		Отказ=Истина;
		//СтандартнаяОбработка=Ложь;
		Если Объект.РежимМодальности Тогда
			Предупреждение("Дубликат имени параметра");
		КонецЕсли;
	Иначе
		ФильтрыИзменены=Истина;
		ПроценкиИзменены=Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура МетодыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	// Ключевое поле должно быть не пустым
	Если Элементы.Методы.ТекущиеДанные.Метод="" Тогда
		Если Объект.РежимМодальности Тогда
			Предупреждение("Не определено имя метода");
		КонецЕсли;
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	Текст=ТРег(Элементы.Методы.ТекущиеДанные.Метод);
	Попытка 
		Тест=Новый Структура(Текст);
	Исключение 
		Если Объект.РежимМодальности Тогда
			Предупреждение("Ошибочное именя метода");
		КонецЕсли;
		Отказ=Истина;
		Возврат;
	КонецПопытки;
	// Ключевое поле должно быть уникальным
    //Макс=?(Элементы.Фильтры.ТекущиеДанные.Параметр=Текст,1,0);
	Элементы.Методы.ТекущиеДанные.Метод=Текст;
	Отбор=Новый Структура("Метод",Текст);
	Если Методы.НайтиСтроки(Отбор).Количество()>1 Тогда
		Отказ=Истина;
		//СтандартнаяОбработка=Ложь;
		Если Объект.РежимМодальности Тогда
			Предупреждение("Дубликат имени параметра");
		КонецЕсли;
	Иначе
		МетодыИзменены=Истина;
		ПроценкиИзменены=Истина;
	КонецЕсли;	
