&НаКлиенте
Процедура ОчиститьБаза(Команда)
	Попытка
		Ответ = Вопрос("Очистить артикулы номенклатуры от незначащих символов?", РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ОчиститьАртикулыНаСервере();
			Предупреждение("Операция завершена!", 0, "1С: Помощник автобизнеса");
		КонецЕсли;
	Исключение
		ОчиститьАртикулыНаСервере();
		Сообщить("Операция завершена!");
	Конецпопытки;	
КонецПроцедуры

Процедура ОчиститьАртикулыНаСервере()
	
    Выборка = Справочники.Номенклатура.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ Выборка.ЭтоГруппа Тогда
			СправочникОбъект = Выборка.ПолучитьОбъект();
			СправочникОбъект.Артикул = ПодготовитьНомер(СокрЛП(СправочникОбъект.Артикул));
			Попытка
			    СправочникОбъект.Записать();
			Исключение
				Сообщить("Номенклатура " + СправочникОбъект.Наименование + " не обработана! " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла; 
		
	КонецПроцедуры
	
Функция ПодготовитьНомер(СтрНомер)
		
	СтрНомер=СокрЛП(строка(СтрНомер));
	СтрНомер=Стрзаменить(СтрНомер,символы.НПП,"");
	СтрНомер=Стрзаменить(СтрНомер,",","");
	СтрНомер=Стрзаменить(СтрНомер,")","");
	СтрНомер=Стрзаменить(СтрНомер,"(","");
	СтрНомер=Стрзаменить(СтрНомер,"-","");
	СтрНомер=Стрзаменить(СтрНомер,".","");
	СтрНомер=Стрзаменить(СтрНомер," ","");
	//СтрНомер=Стрзаменить(СтрНомер,"_",""); Символ подчеркивания является значимым
	СтрНомер=Стрзаменить(СтрНомер,"-","");
	СтрНомер=Стрзаменить(СтрНомер,"""","");
	СтрНомер=Стрзаменить(СтрНомер,"'","");
	СтрНомер=Стрзаменить(СтрНомер,":","");
	СтрНомер=Стрзаменить(СтрНомер,";","");
	СтрНомер=Стрзаменить(СтрНомер,"/","");
	СтрНомер=Стрзаменить(СтрНомер,"|","");
	СтрНомер=Стрзаменить(СтрНомер,"\","");
	СтрНомер=Стрзаменить(СтрНомер,"!","");
	СтрНомер=Стрзаменить(СтрНомер,"#","");
	СтрНомер=Стрзаменить(СтрНомер,"№","");
	СтрНомер=Стрзаменить(СтрНомер,"?","");
	СтрНомер=Стрзаменить(СтрНомер,"*","");
	Возврат СтрНомер;
	
Конецфункции

&НаКлиенте
Процедура ОчиститьПрайс(Команда)
	Попытка
		Ответ = Вопрос("Очистить артикулы прайс-листов от незначащих симвлов?", РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ = КодВозвратаДиалога.Да Тогда
	        ОчиститьПрайсНаСервере();		
			Предупреждение("Операция завершена!", 0, "1С: Помощник автобизнеса");		
		КонецЕсли;	
	Исключение
	    ОчиститьПрайсНаСервере();		
		Сообщить("Операция завершена!");		
	Конецпопытки;
КонецПроцедуры

&НаСервере 
Процедура ОчиститьПрайсНаСервере()
	Попытка
		Эксель = Новый COMОбъект("Excel.Application"); 
		Эксель.Displayalerts = 0;
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
		
	НастройкаЗагрузки=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","НастройкаЗагрузки");
	Для каждого СтрокаТаб Из НастройкаЗагрузки Цикл
	
		Книга = Эксель.WorkBooks.Open(СокрЛП(СтрокаТаб.ПутьКФайлу));                                      
		Лист = Книга.WorkSheets(1).UsedRange;
			
		Для К = 1 По Лист.Rows.Count Цикл
			
			Лист.Cells(К,СтрокаТаб.Артикул).Value = Строка(ПодготовитьНомер(СокрЛП(Лист.Cells(К,СтрокаТаб.Артикул).Value)));
			Лист.Cells(К,СтрокаТаб.Артикул).NumberFormat = "@";
			
		КонецЦикла;
			
		Попытка 		
			Книга.Save();
		Исключение
		КонецПопытки;
				
	КонецЦикла;
		
	Эксель.Application.Quit();
		
КонецПроцедуры

&НаСервере 
