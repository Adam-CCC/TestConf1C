&НаКлиенте
Процедура ТабПроценкиПриАктивизацииСтроки(Элемент)
	Если ДанныеПроценкиИзменены Тогда
		//Изменение значений структуры данных
		СвойстваД=Новый Структура;
		Для Каждого Элем Из ДанныеПроценки Цикл
			Попытка
				СвойстваД.Вставить(Элем.Ключ,Элем.Значение);
			Исключение
			КонецПопытки;
		КонецЦикла;
		ТекПроценка.Авторизация = СвойстваД;
		ДанныеПроценкиИзменены=Ложь;
	КонецЕсли;
	
	Если ФильтрыИзменены Тогда
		СтрФильтры=Новый Структура;
		Для Каждого Эл из Фильтры Цикл
			Попытка
				СтрФильтры.Вставить(Эл.Параметр,Новый Структура("Вкл,Значение,Служебный,Оперативный,Фильтрация,Групповой,СписокВыбора,Владелец,Примечания",
				Эл.Вкл,Эл.Значение,Эл.Служебный,Эл.Оперативный,Эл.Фильтрация,Эл.Групповой,Эл.СписокВыбора,Эл.Владелец,Эл.Примечания));
			Исключение
				Информация=ИнформацияОбОшибке();
			КонецПопытки;
		КонецЦикла;
		ТекПроценка.Фильтры = СтрФильтры;
		ФильтрыИзменены=Ложь;
	КонецЕсли;
	
	Если МетодыИзменены Тогда
		СтрМетоды=Новый Структура;
		Для Каждого Эл из Методы Цикл
			Попытка
				СтрМетоды.Вставить(Эл.Метод,Новый Структура("Вкл,Наименование,Страница,Объект,Состояние,Предупреждение,Примечания,НаКлиенте",
				Эл.Вкл,Эл.Наименование,Эл.Страница,Эл.Объект,Эл.Состояние,Эл.Предупреждение,Эл.Примечания,Эл.НаКлиенте));
			Исключение
				Информация=ИнформацияОбОшибке();
			КонецПопытки;
		КонецЦикла;
		ТекПроценка.Методы = СтрМетоды;
		МетодыИзменены=Ложь;
	КонецЕсли;
	
	ДанныеПроценки.Очистить();
	ТекПроценка=Элементы.Проценки.ТекущиеДанные;
	Если ТекПроценка=Неопределено Тогда
		Элементы.Группа31.Доступность=Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.Группа31.Доступность=Истина;
	Если ТекПроценка.Авторизация=Неопределено Тогда
		ТекПроценка.Авторизация=Новый Структура;
	Иначе
		Для каждого Элем из ТекПроценка.Авторизация Цикл
			Нов=ДанныеПроценки.Добавить();
			Нов.Ключ=Элем.Ключ;
			Нов.Значение=Элем.Значение;
		КонецЦикла;
	КонецЕсли;
	
	Фильтры.Очистить();
	Если ТипЗнч(ТекПроценка.Фильтры)=Тип("Структура") Тогда
		Для Каждого Элем Из ТекПроценка.Фильтры Цикл
			Нов=Фильтры.Добавить();
			Нов.Параметр=Элем.Ключ;
			ЗаполнитьЗначенияСвойств(Нов,Элем.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Методы.Очистить();
	Если ТипЗнч(ТекПроценка.Методы)=Тип("Структура") Тогда
		Для Каждого Элем Из ТекПроценка.Методы Цикл
			Нов=Методы.Добавить();
			Нов.Метод=Элем.Ключ;
			ЗаполнитьЗначенияСвойств(Нов,Элем.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Помощь=ТекПроценка.Помощь;
	
КонецПроцедуры

