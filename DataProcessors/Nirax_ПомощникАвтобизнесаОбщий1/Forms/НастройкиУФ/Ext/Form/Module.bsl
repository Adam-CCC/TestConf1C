	Элементы.ШаблонНомераДляПоиска.Доступность=Объект.РеквизитНомераДляПоиска<>"";
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеПроизводителейИСинонимовНажатие(Команда)
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ОбработкаСинонимовУФ",,ЭтаФорма);
КонецПроцедуры

&НаСервере
Функция СохранитьНастройкиВФайлНаСервере()
	СтруктураНастроек = Новый Структура(
	"АналогиЕстьВ1С,АртикулОчищать,БанковскийСчетДляЗаявки,БезАналогов,БезПрименяемости,ВидНоменклатуры,
    |ВКорзину,ВыбиратьГруппу,ВыводитьАналоги,ВыводитьНаличие,Группировать,ЗаказПокупателя,ЗаписьШтрихкода,
    |ЗапрашиватьКоличество,ЗапрашиватьСкидку,ЗапрашиватьЦену,ИспользоватьПроценкуОнлайнПоставщиков,
    |ИспользоватьЦены,КассаККМ,КонтрольОстатков,НДСПоУмолчанию,ОбщийПоиск,ОрганизацияДляЗаявки,
	|ОтборПроизводители,ПутьКВременнойПапке,РеализацияТоваров,Склад,СортироватьТолькоПоЦенам,ПроводитьДокументы,
	|СчетФактура,ТипЦен,ЦеноваяГруппа,ШаблонНаименования,ШаблонНаименованияП,ШаблонНомераДляПоиска,
	|РеквизитНомераДляПоиска,ИспользоватьСинонимы,ЗапрашиватьГруппуНоменклатуры,ПоискПоОчищенному");
	ЗаполнитьЗначенияСвойств(СтруктураНастроек,Объект);	
	ЕСли Не Объект.СпецНаз.НастройкиПользователя Тогда
		Попытка
			Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,"Администратор");
		Исключение
			Объект.СпецНаз.НастройкиПользователя=Истина;
		Конецпопытки;
	КонецЕсли;
	
	ЕСли Объект.СпецНаз.НастройкиПользователя Тогда
		Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки");
	КонецЕсли;
	
	Если ТипЗнч(Проценки)<>Тип("ТаблицаЗначений") Тогда
		Проценки=Новый ТаблицаЗначений();
	КонецЕсли;
	СтруктураНастроек.Вставить("Проценки", Проценки);
	ПрайсЛисты=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","НастройкаЗагрузки");
	Если ТипЗнч(ПрайсЛисты)<>Тип("ТаблицаЗначений") Тогда
		ПрайсЛисты=Новый ТаблицаЗначений();
	КонецЕсли;
	СтруктураНастроек.Вставить("ПрайсЛисты", ПрайсЛисты);
	Возврат ЗначениеВСтрокуВнутр(СтруктураНастроек);
КонецФункции

&НаКлиенте
Процедура СохранитьНастройкиВФайл(Команда)
	СтруктураНастроек = СохранитьНастройкиВФайлНаСервере();
	Диалог = Новый ДиалогВыбораФайла (РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Файлы настроек отчетов *.rep1c|*.rep1c";
	Если НЕ Диалог.Выбрать() Тогда
	      Возврат;
	КонецЕсли;
	    
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.УстановитьТекст(СтруктураНастроек);
	Попытка
	    ТекстовыйФайл.Записать(Диалог.ПолноеИмяФайла);
	Исключение
		//ошибка записи 
    	Сообщить("ошибка при сохранении файла настроек: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкиИзФайлаНаСервере(ТекстовыйФайл)
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.ЗагрузитьНастройкиИзФайла(ТекстовыйФайл);
	Данные=Новый Структура(
	"АналогиЕстьВ1С,АртикулОчищать,БанковскийСчетДляЗаявки,БезАналогов,БезПрименяемости,ВидНоменклатуры,
    |ВКорзину,ВыбиратьГруппу,ВыводитьАналоги,ВыводитьНаличие,Группировать,ЗаказПокупателя,ЗаписьШтрихкода,
    |ЗапрашиватьКоличество,ЗапрашиватьСкидку,ЗапрашиватьЦену,ИспользоватьПроценкуОнлайнПоставщиков,
    |ИспользоватьЦены,КассаККМ,КонтрольОстатков,НДСПоУмолчанию,ОбщийПоиск,ОрганизацияДляЗаявки,
	|ОтборПроизводители,ПутьКВременнойПапке,РеализацияТоваров,Склад,СортироватьТолькоПоЦенам,ПроводитьДокументы,
	|СчетФактура,ТипЦен,ЦеноваяГруппа,ШаблонНаименования,ШаблонНаименованияП,ШаблонНомераДляПоиска,
	|РеквизитНомераДляПоиска,ИспользоватьСинонимы,ЗапрашиватьГруппуНоменклатуры,ПоискПоОчищенному");
	ЗаполнитьЗначенияСвойств(Данные,ЗначениеИзСтрокиВнутр(ТекстовыйФайл.ПолучитьТекст()));
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","ОбъектMySQL",Данные);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкиИзФайла(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Файлы настроек отчетов *.rep1c|*.rep1c";
    Если НЕ Диалог.Выбрать() Тогда
        Возврат;
    КонецЕсли;
    
    ТекстовыйФайл = Новый ТекстовыйДокумент;
	
    ТекстовыйФайл.Прочитать(Диалог.ПолноеИмяФайла);
	ЗагрузитьНастройкиИзФайлаНаСервере(ТекстовыйФайл);
	Объект.РежимМодальности = Ложь;
	ЭтаФорма.ВладелецФормы.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПроценки(Команда)
	Если ДанныеПроценкиИзменены ИЛИ ФильтрыИзменены ИЛИ МетодыИзменены Тогда
		ТабПроценкиПриАктивизацииСтроки(Неопределено);
	КонецЕсли;
	ПараметрыФормы=Новый Структура("ТабПроценки", ТабПроценки);
	Оповещение=Новый ОписаниеОповещения("ВыборПроценокНаКлиенте",ЭтаФорма);
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаЗагрузкиПроценокУФ",ПараметрыФормы,ЭтаФорма,,,,Оповещение);
	
	ТабПроценкиПриАктивизацииСтроки(Неопределено);
	ПроценкиИзменены=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыборПроценокНаКлиенте(Результат,Параметры) Экспорт
	
	ВыборПроценокНаСервере(Результат);
	
КонецПроцедуры	

&НаСервере
Процедура ВыборПроценокНаСервере(Результат)
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого СтрокаВыбора Из Результат Цикл
		
		Если НЕ СтрокаВыбора.Загружать Тогда
			Продолжить;
		КонецЕсли;
		
		МСтр=ТабПроценки.НайтиСтроки(Новый Структура("Сайт",СтрокаВыбора.Сайт));
		Если МСтр.Количество()=0 Тогда
			ТСтр=ТабПроценки.Добавить();
			ТСтр.Сайт=СтрокаВыбора.Сайт;
			ТСтр.Вкл = Истина;
		Иначе
			МСтр[0].Вкл = Истина;
			Продолжить;
		КонецЕсли;
		
		Стр=СтрокаВыбора.Данные;
		ТСтр.Помощь=Стр.Помощь;
		ТСтр.Авторизация=Новый Структура();
		Для Каждого Эл Из Стр.Авторизация Цикл
			Если Не ТСтр.Авторизация.Свойство(Эл.Ключ) Тогда
				ТСтр.Авторизация.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		ТСтр.Фильтры=Новый Структура();
		Для Каждого Эл Из Стр.Фильтры Цикл
			Если Не ТСтр.Фильтры.Свойство(Эл.Ключ) Тогда
				ТСтр.Фильтры.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		ТСтр.Методы=Новый Структура();
		Для Каждого Эл Из Стр.Методы Цикл
			Если Не ТСтр.Методы.Свойство(Эл.Ключ) Тогда
				ТСтр.Методы.Вставить(Эл.Ключ,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры	
////#КонецОбласти