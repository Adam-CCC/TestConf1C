Процедура Проверка(Команда)
	// Записать последние изменения
	Если ТекПроценка=Неопределено Тогда Возврат;КонецЕсли; 
	Если ДанныеПроценкиИзменены=Истина Тогда
		//Изменение значений структуры данных
		СвойстваД=Новый Структура;
		Для Каждого Элем Из ДанныеПроценки Цикл
			СвойстваД.Вставить(Элем.Ключ,Элем.Значение);
		КонецЦикла;
		ТекПроценка.Авторизация = СвойстваД;
	КонецЕсли;
	Ошибки=ПроверкаНаСервере(Новый Структура("Сайт,Авторизация",ТекПроценка.Сайт,ТекПроценка.Авторизация));
	Если Ошибки="" Тогда 
		ТекПроценка.Проверка=Истина;
	Иначе
		Попытка
			Предупреждение("Ошибки при подключении: "+Ошибки); 
		Исключение
			Сообщить("Ошибки при подключении: "+Ошибки); 
		Конецпопытки;
		ТекПроценка.Проверка=Ложь;
	КонецЕсли;
КонецПроцедуры

