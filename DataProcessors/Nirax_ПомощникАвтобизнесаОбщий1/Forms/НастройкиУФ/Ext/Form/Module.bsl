&НаКлиенте   //!!!
Процедура СохранитьНастройки(Команда)
	//Сохраниение проценок
	Если ПроценкиИзменены Тогда
		СохранитьПроценки(Команда);
	КонецЕсли;
	//Сохранение настроек
	СохранитьНастройкиНаСервере();
	ЭтаФорма.Закрыть();
КонецПроцедуры

