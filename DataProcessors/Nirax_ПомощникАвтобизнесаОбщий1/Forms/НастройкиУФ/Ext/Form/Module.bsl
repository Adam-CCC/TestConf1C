&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	ЕстьЗаказ=Метаданные.Документы.Найти("ЗаказПокупателя")<>Неопределено ИЛИ
	Метаданные.Документы.Найти("ЗаказКлиента")<>Неопределено;
	Элементы.ЗаказПокупателя.Видимость=ЕстьЗаказ;
	ЕстьРеализация=Метаданные.Документы.Найти("РеализацияТоваров")<>Неопределено ИЛИ
	Метаданные.Документы.Найти("РеализацияТоваровУслуг")<>Неопределено;
	Элементы.РеализацияТоваров.Видимость=ЕстьРеализация;
	ЕстьСчет=Метаданные.Документы.Найти("СчетФактураВыданный")<>Неопределено;
	Элементы.СчетФактура.Видимость=ЕстьСчет;
	
	// Список выбора для РеквизитНомераДляПоиска
	Реквизиты=Метаданные.Справочники.Номенклатура.Реквизиты;
	Если Реквизиты.Найти("Артикул")<>Неопределено Тогда 
		Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("Артикул",Реквизиты.Артикул.Синоним);
	КонецЕсли;
	Если Реквизиты.Найти("АртикулДляПоиска")<>Неопределено Тогда 
		Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("АртикулДляПоиска",Реквизиты.АртикулДляПоиска.Синоним);
	КонецЕсли;
	Если Реквизиты.Найти("ор_НомерПоКаталогу")<>Неопределено Тогда 
		Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("ор_НомерПоКаталогу",Реквизиты.ор_НомерПоКаталогу.Синоним);
	КонецЕсли;
	Если Реквизиты.Найти("НомерПоКаталогу")<>Неопределено Тогда 
		Элементы.РеквизитНомераДляПоиска.СписокВыбора.Добавить("НомерПоКаталогу",Реквизиты.НомерПоКаталогу.Синоним);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца=Истина;
	ВладелецОбъект = ЭтаФорма.ВладелецФормы.Объект;
	ЗаполнитьЗначенияСвойств(Объект,ВладелецОбъект,,
	"ЗаявкаНаОформление,ЗаявкаПоставщику,ОчищеннаяТаблица");
	// Проценки начальные значяения
	ЗагрузитьТабПроценки();
	ДанныеПроценкиИзменены=Ложь; ПроценкиИзменены=Ложь;
	ФильтрыИзменены=Ложь;МетодыИзменены=Ложь;
	Элементы.Фильтры.КоманднаяПанель.Видимость=Ложь;
	Элементы.Фильтры.ОтборСтрок=Новый ФиксированнаяСтруктура("Служебный",Ложь);
	Элементы.Фильтры.ИзменятьСоставСтрок=Ложь;
	Элементы.Помощь.ТолькоПросмотр=Истина;
	// ограничения на доступность элементов формы
	Элементы.ВидНоменклатуры.Видимость=Объект.ВидНоменклатуры<>Неопределено;
	Элементы.ЦеноваяГруппа.Видимость=Объект.ЦеноваяГруппа<>Неопределено;
	Элементы.Группа31.Доступность=Элементы.Проценки.ТекущиеДанные<>Неопределено;
	РеквизитНомераДляПоискаПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Объект.РежимМодальности И ПроценкиИзменены Тогда
		Если Вопрос("Данные настроек были изменены, сохранить изменения?",РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда
			СохранитьНастройки(Неопределено);
		КонецЕсли;
	КонецЕсли;
	//Перезапись объекта с изменениями в основную форму
	Попытка
		ВладелецОбъект = ЭтаФорма.ВладелецФормы.Объект;
		ЗаполнитьЗначенияСвойств(ВладелецОбъект,Объект,,
		"ЗаявкаНаОформление,ЗаявкаПоставщику,ОчищеннаяТаблица");
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

