Функция ПолучитьОбработчик(НаименованиеОбработчика = "") Экспорт
	
	#Если НаКлиенте тогда
	Если НЕ ЗначениеЗаполнено(АдресWS) тогда 
		Предупреждение("Адрес не указан", 10);
		Возврат Неопределено;
	КонецЕсли;
	#КонецЕсли
	
	Попытка
		//удалим определение документа wsdl - его добавляем автоматически
		АдресWS = СокрЛП(АдресWS) + "ws/getclass.ws?wsdl";
		
		ВСОпределение = Новый WSОпределения(АдресWS, СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
		
		ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/binary", 
								   "ВыдачаОбработчиков","ВыдачаОбработчиковSoap12",600);
		
		ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
		ВебСервис.Пароль		 = СокрЛП(ПарольWS);
		
		обработчик = Неопределено;
		
		ОбработчикXDTO = ВебСервис.getbinary(СокрЛП(НаименованиеОбработчика));
		
		Если НЕ ОбработчикXDTO = Неопределено тогда
			
			ПолноеИмяОбработчика = ПолучитьИмяВременногоФайла("epf");
			
			ОбработчикXDTO.Записать(ПолноеИмяОбработчика);
			
			обработчик = ВнешниеОбработки.Создать(ПолноеИмяОбработчика, Ложь);
			
		КонецЕсли;
		
	Исключение
		
		Обработчик = Неопределено;
		
	КонецПопытки;
	
	Возврат Обработчик;
	
КонецФункции // ПолучитьДанные()
