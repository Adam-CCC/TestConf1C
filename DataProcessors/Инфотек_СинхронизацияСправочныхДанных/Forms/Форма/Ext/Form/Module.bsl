КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормыСопоставленияДанных

&НаСервере
Процедура НастройкаПодключенияПриИзмененииНаСервере() 
	
	СвойствоЗаказНаряда = НастройкаПодключения.СвойствоЗаказНарядаТО;  
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПодключенияПриИзменении(Элемент)
	
	НастройкаПодключенияПриИзмененииНаСервере();  
	СвойствоЗаказНарядаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СвойствоЗаказНарядаПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(СвойствоЗаказНаряда) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияСвойств.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗначенияСвойств КАК ЗначенияСвойств
		|ГДЕ
		|	ЗначенияСвойств.Владелец = &Владелец";	 
		Запрос.УстановитьПараметр("Владелец", СвойствоЗаказНаряда);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗначенияСвойствЗаказНаряда.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвойствоЗаказНарядаПриИзменении(Элемент)  
	
	СвойствоЗаказНарядаПриИзмененииНаСервере();   
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицФормыСопоставленияДанных

&НаКлиенте
Процедура Объекты1СНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка,ТипРедактирования,ТекДанные) 
	
	СтандартнаяОбработка = Ложь;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ТекДанные.Объекты1С Цикл
		СписокВыбора.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокРедактирования",СписокВыбора);
	ПараметрыФормы.Вставить("ТипРедактирования",ТипРедактирования);
	
	РезультатОткрытия = Неопределено;
	ОткрытьФорму("Обработка.Инфотек_СинхронизацияСправочныхДанных.Форма.ФормаПодбораВСписокЗначений",ПараметрыФормы,,,,, Новый ОписаниеОповещения("Объекты1СНачалоВыбораЗавершение", ЭтаФорма, Новый Структура("ТекДанные", ТекДанные)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура Объекты1СНачалоВыбораТО(Элемент, ДанныеВыбора, СтандартнаяОбработка,ТипРедактирования,ТекДанные) 
	
	СтандартнаяОбработка = Ложь;
	
	Если ТекДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Новый СписокЗначений;
	Для Каждого ЭлементСписка Из ТекДанные.Объекты1С Цикл
		СписокВыбора.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокРедактирования",СписокВыбора);
	ПараметрыФормы.Вставить("ТипРедактирования",ТипРедактирования);
    ПараметрыФормы.Вставить("ЗначенияСвойствЗаказНаряда",ЗначенияСвойствЗаказНаряда);

	РезультатОткрытия = Неопределено;
	ОткрытьФорму("Обработка.Инфотек_СинхронизацияСправочныхДанных.Форма.ФормаПодбораВСписокЗначений",ПараметрыФормы,,,,, Новый ОписаниеОповещения("Объекты1СНачалоВыбораЗавершение", ЭтаФорма, Новый Структура("ТекДанные", ТекДанные)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура Объекты1СНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	
	РезультатОткрытия = Результат;
	
	Если РезультатОткрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.Объекты1С.Очистить();
	
	Для Каждого ЭлементСписка Из РезультатОткрытия Цикл
		Если Не ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		ТекДанные.Объекты1С.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
КонецПроцедуры

