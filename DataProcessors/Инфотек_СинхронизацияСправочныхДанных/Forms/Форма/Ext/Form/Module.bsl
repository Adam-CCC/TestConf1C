		Сообщить("Для чтения данных укажите отбор по бренду!");
		Возврат;
	КонецЕсли;
	id_бренда = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,Бренд,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Бренд);
