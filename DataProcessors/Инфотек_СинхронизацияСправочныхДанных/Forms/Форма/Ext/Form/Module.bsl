&НаСервере
Процедура ЗаполнитьЗаказНарядыНаСервере()
	
	Объект.ЗаказНаряды.Очистить();
	
	Запрос = Новый запрос();
	Запрос.УстановитьПараметр("ДН",ПериодДокументовЗаказНаряды.ДатаНачала);
	Запрос.УстановитьПараметр("ДК",КонецДня(ПериодДокументовЗаказНаряды.ДатаОкончания));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказНаряд.Ссылка
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Дата МЕЖДУ &ДН И &ДК";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		ВыгружатьПодразделение = Ложь;
		ВыгружатьОрганзацию = Ложь;
				
		Если НастройкаПодключения.Подразделения.Количество() = 0 Тогда
			ВыгружатьПодразделение = Истина;
		Иначе
			Для Каждого СтрокаПодразделения из НастройкаПодключения.Подразделения Цикл
				Если СтрокаПодразделения.Подразделение =  Выборка.Ссылка.ПодразделениеКомпании Тогда
					ВыгружатьПодразделение = Истина;
				КонецЕсли
			КонецЦикла;
		КонецЕсли;
		
		Если НастройкаПодключения.Организации.Количество() = 0 Тогда
			ВыгружатьОрганзацию = Истина;
		Иначе
			Для Каждого СтрокаОрганизации из НастройкаПодключения.Организации Цикл
				Если СтрокаОрганизации.Организация =  Выборка.Ссылка.Организация Тогда
					ВыгружатьОрганзацию = Истина;
				КонецЕсли
			КонецЦикла;
		КонецЕсли;
		
		Если  ВыгружатьОрганзацию И  ВыгружатьПодразделение Тогда
			НоваяСтрока = Объект.ЗаказНаряды.Добавить();
			НоваяСтрока.Документ = Выборка.ссылка;
			НоваяСтрока.Пометка = Истина;
		КонецЕсли
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередатьЗаказНаряды(Команда)   
	
	Если Не ЗначениеЗаполнено(НастройкаПодключения) Тогда
		Сообщить("Для передачи документов в CRM систему укажите настройку подключения");
		Возврат;
	КонецЕсли;		
	ПередатьЗаказНарядыНаСервере();  
	
КонецПроцедуры

&НаСервере
Процедура ПередатьЗаказНарядыНаСервере()   
	
	Для Каждого СтрокаТЗ из Объект.ЗаказНаряды цикл
		Если Не СтрокаТЗ.Пометка Тогда
			Продолжить;
		КонецЕсли;	
		ОписаниеЗаказНаряда = Инфотек_ИнтеграцияCRMПереопределяемый.ПолучитьОписаниеЗаказНарядаCRM(СтрокаТЗ.Документ,НастройкаПодключения);
		Если ОписаниеЗаказНаряда <> Неопределено Тогда 
			СтрокаТЗ.УспешноОтправлен = Инфотек_ИнтеграцияCRM.СоздатьОбновитьЗаказНарядВCRM(СтрокаТЗ.Документ,ОписаниеЗаказНаряда,НастройкаПодключения);			
			Если Не СтрокаТЗ.УспешноОтправлен Тогда
				Сообщить("Произошла ошибка! Не удалось передать документ в CRM-систему!!!");
			КонецЕсли;
			Если СтрокаТЗ.УспешноОтправлен Тогда
				ИдентификаторВидаРемонтаТО = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,СтрокаТЗ.Документ.ВидРемонта,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ВидРемонтаТО);
				Если Не ЗначениеЗаполнено(ИдентификаторВидаРемонтаТО) Тогда
					Для Каждого СтрокаРабот ИЗ СтрокаТЗ.Документ.Работы Цикл
						ИдентификаторВидаРемонтаТО = Инфотек_ОбщиеПроцедуры.ПолучитьИдентификаторСоответствияПоОбъекту(НастройкаПодключения,СтрокаРабот.Работа,ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ВидРемонтаТО);
						Если ЗначениеЗаполнено(ИдентификаторВидаРемонтаТО) Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если ЗначениеЗаполнено(ИдентификаторВидаРемонтаТО) Тогда
					СтрокаТЗ.УспешноОтправлен = Инфотек_ИнтеграцияCRM.ОбработатьДанныеПоТО(СтрокаТЗ.Документ,ИдентификаторВидаРемонтаТО,НастройкаПодключения);	
					Если Не СтрокаТЗ.УспешноОтправлен Тогда
						Сообщить("Произошла ошибка! Не удалось передать данные по ТО в CRM-систему!!!");
					КонецЕсли;
				КонецЕсли;					
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуФормыПоДаннымСайта(МассивДанных,ВидОбъекта,ТаблицаЗаполнения)  
	
	Если МассивДанных.Количество() = 0 Тогда
		Сообщить("Настройки подключения (логин и пароль) к CRM введены не корректно или нет связи с сервером!");
		Возврат;
	КонецЕсли;     
	
	ТаблицаЗаполнения.Очистить();	
	ТаблицаСоответствий = Инфотек_ОбщиеПроцедуры.ПолучитьТаблицуСоответствийПоВидуОбъекта(НастройкаПодключения,ВидОбъекта);
	
	Для каждого ТекДанные ИЗ МассивДанных Цикл
		НоваяСтрока               = ТаблицаЗаполнения.Добавить();
		НоваяСтрока.Идентификатор = ТекДанные.id;  
		Попытка
			НоваяСтрока.Наименование = Строка(ТекДанные.last_name) + " " + Строка(ТекДанные.first_name) + " " + Строка(ТекДанные.middle_name);
		Исключение
			НоваяСтрока.Наименование  = ТекДанные.name;
		КонецПопытки;
		Попытка  
			НоваяСтрока.ИдентификаторСалона = ТекДанные.salon_id;	
			Салон = Инфотек_ИнтеграцияCRM.ПолучитьСалонПоИдентификатору(НастройкаПодключения,ТекДанные.salon_id);
			Если Салон <> Неопределено Тогда
				НоваяСтрока.НаименованиеСалона = Салон.name;
			КонецЕсли;
		Исключение
		КонецПопытки;
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Идентификатор",НоваяСтрока.Идентификатор);
		
		НайденныеСтроки = ТаблицаСоответствий.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого Стр Из НайденныеСтроки Цикл
			НоваяСтрока.Объекты1С.Добавить(Стр.Объект);		
		КонецЦикла;
		Если ВидОбъекта = ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ПричинаОтказа Тогда  
			Если ТекДанные.id = НастройкаПодключения.ИдентфикаторПричиныОтказаОтКонтрактаПоУмолчанию Тогда
				НоваяСтрока.ВыбиратьПоУмолчанию = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФормыПоДаннымСайтаИзСоответствия(МассивДанных,ВидОбъекта,ТаблицаЗаполнения)

	ТаблицаЗаполнения.Очистить();	
	ТаблицаСоответствий = Инфотек_ОбщиеПроцедуры.ПолучитьТаблицуСоответствийПоВидуОбъекта(НастройкаПодключения,ВидОбъекта);
	
	Для каждого ТекДанные ИЗ МассивДанных Цикл
		НоваяСтрока               = ТаблицаЗаполнения.Добавить();
		НоваяСтрока.Идентификатор = ТекДанные.Ключ;
		НоваяСтрока.Наименование  = ТекДанные.Значение;
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Идентификатор",НоваяСтрока.Идентификатор);
		
		НайденныеСтроки = ТаблицаСоответствий.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого Стр Из НайденныеСтроки Цикл
			НоваяСтрока.Объекты1С.Добавить(Стр.Объект);		
		КонецЦикла;		
	КонецЦикла;    
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияСоответствий(ВидОбъекта,НоваяТаблицаСоответствий)
	
	НачатьТранзакцию();
	
	Если ВидОбъекта = ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.ПричинаОтказа Тогда  
		ПричинаОтказаОтКонтрактаПоУмолчаниюВыбрана = Ложь;	
		Для Каждого Запись Из НоваяТаблицаСоответствий Цикл  
			Если Запись.ВыбиратьПоУмолчанию = Истина Тогда
				ПричинаОтказаОтКонтрактаПоУмолчаниюВыбрана = Истина;  
				ОбъектНастройкиПодключения = НастройкаПодключения.ПолучитьОбъект();
				ОбъектНастройкиПодключения.ОбменДанными.Загрузка = Истина;
				ОбъектНастройкиПодключения.ИдентфикаторПричиныОтказаОтКонтрактаПоУмолчанию = Запись.Идентификатор;
				ОбъектНастройкиПодключения.Записать();
			КонецЕсли;
		КонецЦикла;
		Если ПричинаОтказаОтКонтрактаПоУмолчаниюВыбрана = Ложь Тогда
			Сообщить("Для записи параметров соответствия укажите причину отказа по умолчанию!");  
			Возврат;
		КонецЕсли;  
	КонецЕсли;  
	
	Инфотек_ОбщиеПроцедуры.ОчиститьСоответствияПоВидуОбъекта(ВидОбъекта,НастройкаПодключения);
	
	Для Каждого Запись Из НоваяТаблицаСоответствий Цикл
		Для Каждого ЭлементСписка Из Запись.Объекты1С Цикл
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,ЭлементСписка.Значение,ВидОбъекта,Запись.Идентификатор);
		КонецЦикла;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияСоответствийСОтборами(ВидОбъекта,НоваяТаблицаСоответствий)
	
	НачатьТранзакцию();
		
	Для Каждого Запись Из НоваяТаблицаСоответствий Цикл
		Для Каждого ЭлементСписка Из Запись.Объекты1С Цикл
			Инфотек_ОбщиеПроцедуры.ЗаписатьСоответствиеОбъектов(НастройкаПодключения,ЭлементСписка.Значение,ВидОбъекта,Запись.Идентификатор);
		КонецЦикла;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМаркиНаСервере()
	
	СписокВыбора = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Инфотек_СоответствиеОбъектов.Объект
	|ИЗ
	|	РегистрСведений.Инфотек_СоответствиеОбъектов КАК Инфотек_СоответствиеОбъектов
	|ГДЕ
	|	Инфотек_СоответствиеОбъектов.ВидОбъекта = &ВидОбъекта
	|	И Инфотек_СоответствиеОбъектов.НастройкаПодключения = &НастройкаПодключения";
	Запрос.УстановитьПараметр("ВидОбъекта", ПланыВидовХарактеристик.Инфотек_ВидыОбъектов.Бренд);
	Запрос.УстановитьПараметр("НастройкаПодключения", НастройкаПодключения);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокВыбора.Добавить(Выборка.Объект);
			СправочникСсылка = Выборка.Объект;
			Пока Не СправочникСсылка.Родитель.Пустая() Цикл
				СправочникСсылка = СправочникСсылка.Родитель;	
				СписокВыбора.Добавить(СправочникСсылка);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Возврат СписокВыбора;

КонецФункции

