
&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	Модифицированность = Ложь;
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	СоставСтандартногоИнтерфейсаOData = Новый Массив;
	ДеревоМетаданныхЗН = РеквизитФормыВЗначение("ДеревоМетаданных");
	Для Каждого СтрГруппаМетаданных Из ДеревоМетаданныхЗН.Строки Цикл
		Для Каждого ОбъектМетаданных Из СтрГруппаМетаданных.Строки Цикл
			Если ОбъектМетаданных.Пометка Тогда
				СоставСтандартногоИнтерфейсаOData.Добавить(ОбъектМетаданных.ПолноеИмя);	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	УстановитьСоставСтандартногоИнтерфейсаOData(СоставСтандартногоИнтерфейсаOData);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Если Не Метаданные.РежимСовместимости = Метаданные.СвойстваОбъектов.РежимСовместимости.НеИспользовать Тогда
	//	Сообщить("В конфигурации установлен режим совместимости. Настроить состав интерфейса невозможно!");
	//	Возврат;
	//КонецЕсли;
	ДеревоМетаданныхЗН = РеквизитФормыВЗначение("ДеревоМетаданных");
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "Справочники";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "Документы";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "Перечисления";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "РегистрыБухгалтерии";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "РегистрыСведений";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "РегистрыНакопления";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "РегистрыРасчета";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "ЖурналыДокументов";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "ПланыВидовРасчета";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "ПланыВидовХарактеристик";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "ПланыСчетов";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "ПланыОбмена";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "БизнесПроцессы";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "Задачи";
	ДеревоМетаданныхЗН.Строки.Добавить().Имя = "Константы";
	
	СоставСтандартногоИнтерфейсаOData = ПолучитьСоставСтандартногоИнтерфейсаOData();
	
	Для Каждого СтрГруппаМетаданных Из ДеревоМетаданныхЗН.Строки Цикл
		Для Каждого ОбъектМетаданных Из Метаданные[СтрГруппаМетаданных.Имя] Цикл
			СтрОбъектМетаданных = СтрГруппаМетаданных.Строки.Добавить();	
			СтрОбъектМетаданных.Имя = ОбъектМетаданных.Имя;
			СтрОбъектМетаданных.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Если Не СоставСтандартногоИнтерфейсаOData.Найти(ОбъектМетаданных) = Неопределено Тогда
				СтрОбъектМетаданных.Пометка = Истина;	
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДеревоМетаданныхЗН, "ДеревоМетаданных"); 
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	Для Каждого Эл Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		Эл.Пометка = Ложь;
		Для Каждого Эл2 Из Эл.ПолучитьЭлементы() Цикл
			Если Эл2.Пометка Тогда 
				Эл2.Пометка = Ложь;
				Модифицированность = Истина;
			КонецЕсли;
		КонецЦикла
	КонецЦикла
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	Для Каждого Эл Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		Эл.Пометка = Истина;
		Для Каждого Эл2 Из Эл.ПолучитьЭлементы() Цикл
			Если Не Эл2.Пометка Тогда
				Эл2.Пометка = Истина;
				Модифицированность = Истина;
			КонецЕсли;
		КонецЦикла
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМетаданныхПометкаПриИзменении(Элемент)
	Модифицированность = Истина;
	Эл = Элементы.ДеревоМетаданных.ТекущиеДанные;
	Для Каждого Эл2 Из Эл.ПолучитьЭлементы() Цикл
		Эл2.Пометка = Эл.Пометка;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОбъектыДляРаботыПриложенияПартнеры(Команда)
	
	СписокСправочников = Новый СписокЗначений;
	СписокСправочников.Добавить("Контрагенты");
	СписокСправочников.Добавить("Партнеры");
	СписокСправочников.Добавить("КонтактныеЛица");
	СписокСправочников.Добавить("РолиКонтактныхЛиц");
	
	СоответствиеНеобходимыхТипов = Новый Соответствие;
	СоответствиеНеобходимыхТипов["Справочники"] = СписокСправочников;
	
	
	Для Каждого Эл Из ДеревоМетаданных.ПолучитьЭлементы() Цикл
		СписокОбъектов = СоответствиеНеобходимыхТипов[Эл.Имя];
		Если Не СписокОбъектов = Неопределено Тогда
			Для Каждого ЭлОбъект Из Эл.ПолучитьЭлементы() Цикл
				Если Не СписокОбъектов.НайтиПоЗначению(ЭлОбъект.Имя) = Неопределено И Не ЭлОбъект.Пометка Тогда					
					ЭлОбъект.Пометка = Истина;
					Модифицированность = Истина;
				КонецЕсли;
			КонецЦикла
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

