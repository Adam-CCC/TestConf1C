	Поиск = Справочники.Модели.НайтиПоРеквизиту("Артикул", "HJD");
	Если НЕ ЗначениеЗаполнено(Поиск) Тогда
		НовМодель = Справочники.Модели.СоздатьЭлемент();
	Иначе
		НовМодель = Поиск.ПолучитьОбъект();
	КонецЕсли;
	НовМодель.УстановитьНовыйКод();
	НовМодель.Наименование = "Новый Duster";
	НовМодель.НаименованиеПолное = "Новый Duster";
	НовМодель.ВалютаУчета        = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	НовМодель.Артикул = "HJD";
	НовМодель.КатегорияТС = Справочники.КатегорииТранспортныхСредств.АвтомобилиЛегковые;
	НовМодель.КатегорияТСКОДД = Перечисления.КатегорииТранспортныхСредств.B;
	НовМодель.Записать();
	
	НовИнтерес = Справочники.CRM_ПервичныйИнтерес.СоздатьЭлемент();
	НовИнтерес.Модель = НовМодель.Ссылка;
	НовИнтерес.Наименование = "Новый Duster";
	НовИнтерес.Записать();
	
	МаркаАвто = Справочники.CRM_МаркаАвтомобиля.RENAULT.ПолучитьОбъект();
	НовСтр = МаркаАвто.МоделиАвтомобилей.Добавить();
	НовСтр.Модель = НовМодель.Ссылка;
	НовСтр = МаркаАвто.МоделиАвтомобилейПервичныйИнтерес.Добавить();
	НовСтр.Модель = НовМодель.Ссылка;
	НовСтр = МаркаАвто.МоделиАвтомобилейКоммерческоеПредложение.Добавить();
	НовСтр.Модель = НовМодель.Ссылка;
	НовСтр = МаркаАвто.МоделиАвтомобилейАвтосклад.Добавить();
	НовСтр.Модель = НовМодель.Ссылка;
	МаркаАвто.Записать();
	
	Настройка = Справочники.Renault_СлужебныеНастройкиБазыДанных.RENAULT.ПолучитьОбъект();
	Настройка.АдресWsGate = "http://gate.rnlt.ru/renault-ws-gate/";
	Настройка.HTTP_URL = "gate.rnlt.ru";
	Настройка.HTTP_port = 80;
	Настройка.URL_ОПД = "dms.rnlt.ru";
	Настройка.АдресDistriNetWSDL = "https://gate.rnlt.ru/renault-ws-gate/";
	Настройка.КЦАдресСервера = "http://gate.rnlt.ru/renault-ws-gate/";
	Настройка.АдресWsCentral = "http://gate.rnlt.ru/renault-webservices/";
	Настройка.АдресWebSocket = "http://84.201.147.128:8888";
	Настройка.Записать();
	
	Выб = Справочники.Renault_НастройкиFacturon.Выбрать();
	Если Выб.Следующий() Тогда
		Настройка = Выб.Ссылка.ПолучитьОбъект();
		Настройка.АдресWEBСервиса = "http://gate.rnlt.ru/renault-ws-gate/";
		Настройка.Записать();
	КонецЕсли;
	
	Выб = Справочники.Renault_НастройкиОбменаСРеноПартс.Выбрать();
	Если Выб.Следующий() Тогда
		Настройка = Выб.Ссылка.ПолучитьОбъект();
		Настройка.Сервер = "gate.rnlt.ru";
		Настройка.Путь = "/dms-rparts/hs/rparts/";
		Настройка.Порт = 80;
		Настройка.Записать();
	КонецЕсли;
	
	Настройка = Справочники.Renault_ПараметрыПодключенияКСервисам.WSGate.ПолучитьОбъект();
	Настройка.АдресСервера = "http://gate.rnlt.ru/renault-ws-gate/ws/";
	Настройка.Записать();
	
	Выб = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	Пока Выб.Следующий() Цикл
		Об = Выб.Ссылка.ПолучитьОбъект();
		НовСтр = Об.ПервичныйИнтерес.Добавить();
		НовСтр.ПервичныйИнтерес = НовИнтерес;
		Об.Записать();
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция Версия270213(ТекстОшибки)
	
	//Обновление 08.07.2021 Зубков
	//Эта функция больше не актуальна, реквизит удален.
	Возврат Истина;
	
	//Перенесем дату согласия из справочника "Контрагенты" в регистр "CRM_КлиентскиеДанные"
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанные
	|	ПО CRM_КлиентскиеДанные.Клиент = Контрагенты.Ссылка
	|ГДЕ Контрагенты.Удалить_СогласиеНаПолучениеSMSДата <> &ПустаяДата
	|	И НЕ CRM_КлиентскиеДанные.Клиент ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Выборка = Запрос.Выполнить().Выбрать();
	Набор = РегистрыСведений.CRM_КлиентскиеДанные.СоздатьНаборЗаписей();
	Пока Выборка.Следующий() Цикл
		Набор.Отбор.Клиент.Установить(Выборка.Ссылка);
		Набор.Прочитать();
		Запись = Набор[0];
		Запись.СогласиеНаПолучениеSMSДата = Выборка.Ссылка.Удалить_СогласиеНаПолучениеSMSДата;
		Набор.Записать();
	КонецЦикла;
	
	НовИнтересСсылка = Справочники.CRM_ПервичныйИнтерес.НайтиПоНаименованию("Новый Duster");
	НовМодель = Справочники.Модели.НайтиПоРеквизиту("Артикул", "JD1");
	Если НовИнтересСсылка = Неопределено Тогда
		НовИнтерес = Справочники.CRM_ПервичныйИнтерес.СоздатьЭлемент();
		НовИнтерес.Модель = НовМодель;
		НовИнтерес.Наименование = "Новый Duster";
		НовИнтерес.Записать();
		НовИнтересСсылка = НовИнтерес.Ссылка;
	Иначе
		Если ЗначениеЗаполнено(НовМодель) Тогда
			НовИнтерес = НовИнтересСсылка.ПолучитьОбъект();
			НовИнтерес.Модель = НовМодель;
			НовИнтерес.Записать();
		КонецЕсли;
	КонецЕсли;
	
	МодельHJD = Справочники.Модели.НайтиПоРеквизиту("Артикул", "HJD");
	МодельJD1 = Справочники.Модели.НайтиПоРеквизиту("Артикул", "JD1");
	
	МаркаАвто = Справочники.CRM_МаркаАвтомобиля.RENAULT.ПолучитьОбъект();
	НовСтр = МаркаАвто.МоделиАвтомобилей.Найти(МодельHJD, "Модель");
	Если НовСтр <> Неопределено Тогда
		НовСтр.Модель = МодельJD1;
	Иначе
		НовСтр = МаркаАвто.МоделиАвтомобилей.Добавить();
		НовСтр.Модель = МодельJD1;
	КонецЕсли;
	НовСтр = МаркаАвто.МоделиАвтомобилейПервичныйИнтерес.Найти(МодельHJD, "Модель");
	Если НовСтр <> Неопределено Тогда
		НовСтр.Модель = МодельJD1;
	Иначе
		НовСтр = МаркаАвто.МоделиАвтомобилейПервичныйИнтерес.Добавить();
		НовСтр.Модель = МодельJD1;
	КонецЕсли;
	НовСтр = МаркаАвто.МоделиАвтомобилейКоммерческоеПредложение.Найти(МодельHJD, "Модель");
	Если НовСтр <> Неопределено Тогда
		НовСтр.Модель = МодельJD1;
	Иначе
		НовСтр = МаркаАвто.МоделиАвтомобилейКоммерческоеПредложение.Добавить();
		НовСтр.Модель = МодельJD1;
	КонецЕсли;
	НовСтр = МаркаАвто.МоделиАвтомобилейАвтосклад.Найти(МодельJD1, "Модель");
	Если НовСтр = Неопределено Тогда
		НовСтр = МаркаАвто.МоделиАвтомобилейАвтосклад.Добавить();
		НовСтр.Модель = МодельJD1;
	КонецЕсли;
	МаркаАвто.Записать();
	
	Выб = Справочники.CRM_ДилерскиеЦентры.Выбрать();
	Пока Выб.Следующий() Цикл
		Об = Выб.Ссылка.ПолучитьОбъект();
		НовСтр = Об.ПервичныйИнтерес.Найти(НовИнтересСсылка, "ПервичныйИнтерес");
		Если НовСтр <> Неопределено Тогда // уже есть
			Продолжить;
		КонецЕсли;
		НовСтр = Об.ПервичныйИнтерес.Найти(Справочники.CRM_ПервичныйИнтерес.ПустаяСсылка(), "ПервичныйИнтерес");
		Если НовСтр <> Неопределено Тогда // есть строка с пустым значением
			НовСтр.ПервичныйИнтерес = НовИнтересСсылка;
			Об.Записать();
			Продолжить;
		КонецЕсли;
		// нет вообще строки
		НовСтр = Об.ПервичныйИнтерес.Добавить();
		НовСтр.ПервичныйИнтерес = НовИнтересСсылка;
		Об.Записать();
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

