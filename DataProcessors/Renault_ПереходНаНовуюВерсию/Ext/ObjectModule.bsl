	Сообщить(Символы.Таб + "- обновление регистра Renault_ДопИнформацияПоВерсиям", СтатусСообщения.Информация);
	Попытка
		ЕстьНастройкиПодключения = Ложь;
		Если ЗначениеЗаполнено(ПараметрыСеанса.DMS_Бренд) Тогда
			Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
			Если НЕ Настройки.ИспользоватьHTTPСервисы Тогда
				Если ЗначениеЗаполнено(Настройки.АдресWsGate) И ЗначениеЗаполнено(Настройки.ПарольДоступаКВебСервисам) И ЗначениеЗаполнено(Настройки.ЛогинДоступаКВебСервисам) Тогда
					ЕстьНастройкиПодключения = Истина;
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(Настройки.HTTP_URL) И ЗначениеЗаполнено(Настройки.HTTP_ServiceName) И ЗначениеЗаполнено(Настройки.ПарольДоступаКВебСервисам) И ЗначениеЗаполнено(Настройки.ЛогинДоступаКВебСервисам) Тогда
					ЕстьНастройкиПодключения = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ЕстьНастройкиПодключения Тогда
			Renault_ЗагрузкаТарифа.ЗагрузитьМодели(Дата("00010101"));
			Renault_ЗагрузкаТарифа.ЗагрузитьНастройкиПоМаркам(Дата("00010101"));
			Renault_ЗагрузкаТарифа.ЗагрузитьВерсии(Дата("00010101"));
