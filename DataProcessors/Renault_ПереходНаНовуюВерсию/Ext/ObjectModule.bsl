Функция ВыполнитьОбновление(Версия) Экспорт
	
	Перем Результат;
	
	спВерсии = ПолучитьСписокВерсий();
	ТекВерсия = Константы.Renault_Версия.Получить();
	СтарыйИндекс = спВерсии.Найти(ТекВерсия);
	НовыйИндекс = спВерсии.Найти(Версия);
	
	Если СтарыйИндекс = Неопределено или НовыйИндекс = Неопределено Тогда
		Сообщить("Обновление не выполнено, нарушен порядок обновлений",СтатусСообщения.Внимание);
		Возврат Ложь;
	КонецЕсли;
	
	Пока СтарыйИндекс<НовыйИндекс Цикл
		
		СтарыйИндекс = СтарыйИндекс+1;
		ТекВерсия = спВерсии[СтарыйИндекс];
		Сообщить("Выполняется обновление до версии "+ТекВерсия+":",СтатусСообщения.Информация);
		
		Попытка
			ТекстОшибки = "";
			Выполнить("Результат=Версия"+СтрЗаменить(ТекВерсия,".","")+"(ТекстОшибки)");
			Если Результат = Истина Тогда 
				Константы.Renault_Версия.Установить(ТекВерсия);
				Сообщить("Обновление завершено успешно",СтатусСообщения.Информация);
			Иначе
				Сообщить("Обновление не завершено"+Символы.ПС+ТекстОшибки,СтатусСообщения.Внимание);
				Возврат Ложь
			КонецЕсли;
		Исключение
			Сообщить("Обновление не завершено"+Символы.ПС+ОписаниеОшибки(), СтатусСообщения.Внимание);
			Возврат Ложь
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

