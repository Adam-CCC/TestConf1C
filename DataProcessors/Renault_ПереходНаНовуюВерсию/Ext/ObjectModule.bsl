Функция Версия270223(ТекстОшибки)
	
	Узел = Неопределено;
	Выборка = ПланыОбмена.Renault_Автосервис.Выбрать();
	ЭтаБаза = ПланыОбмена.Renault_Автосервис.ЭтотУзел();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> ЭтаБаза Тогда
			Узел = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_СертификатКонтроля.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Renault_СертификатКонтроля КАК Renault_СертификатКонтроля
	|ГДЕ
	|	Renault_СертификатКонтроля.Дата >= &Дата";
	Запрос.УстановитьПараметр("Дата", '20210101');
	Таб = Запрос.Выполнить().Выгрузить();
	Массив = Таб.ВыгрузитьКолонку("Ссылка");
	Если Узел <> Неопределено Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Массив);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаряд.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.ДатаЗакрытия >= &Дата";
	Запрос.УстановитьПараметр("Дата", '20220101');
	Таб = Запрос.Выполнить().Выгрузить();
	Массив = Таб.ВыгрузитьКолонку("Ссылка");
	Если Узел <> Неопределено Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Массив);
	КонецЕсли;
	
	Возврат Истина;
	
