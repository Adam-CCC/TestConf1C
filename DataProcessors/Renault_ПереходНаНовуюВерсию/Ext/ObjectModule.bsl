		КонецЕсли;
	Исключение
		//ТекстОшибки = ТекстОшибки + ?(ТекстОшибки = "", "", Символы.ПС) + ОписаниеОшибки();
		Сообщить("Не удалось загрузить тариф на автомобили. Запустите загрузку после заполнения настроек подключения.");
	КонецПопытки;
	
	// 3. Добавили предопределенные элементы в справочник Renault_ПредложенияПоРекламациям
	// Пометим дублирующиеся наименования на удаление
	Сообщить(Символы.Таб+"- обновление справочника Renault_ПредложенияПоРекламациям",СтатусСообщения.Информация);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ПредложенияПоРекламациям.Наименование
	               |ПОМЕСТИТЬ Дубли
	               |ИЗ
	               |	Справочник.Renault_ПредложенияПоРекламациям КАК Renault_ПредложенияПоРекламациям
	               |ГДЕ
	               |	НЕ Renault_ПредложенияПоРекламациям.ЭтоГруппа
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Renault_ПредложенияПоРекламациям.Наименование
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(1) > 1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Renault_ПредложенияПоРекламациям.Ссылка,
	               |	Renault_ПредложенияПоРекламациям.Наименование
	               |ПОМЕСТИТЬ КУдалению
	               |ИЗ
	               |	Справочник.Renault_ПредложенияПоРекламациям КАК Renault_ПредложенияПоРекламациям
	               |ГДЕ
	               |	Renault_ПредложенияПоРекламациям.Наименование В
	               |			(ВЫБРАТЬ
	               |				Дубли.Наименование
	               |			ИЗ
	               |				Дубли КАК Дубли)
	               |	И НЕ Renault_ПредложенияПоРекламациям.Предопределенный
	               |	И НЕ Renault_ПредложенияПоРекламациям.ЭтоГруппа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КУдалению.Ссылка
	               |ИЗ
	               |	КУдалению КАК КУдалению
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Renault_ПредложенияПоРекламациям КАК Renault_ПредложенияПоРекламациям
