	Сообщить("Выполняется заполнение настроек подключения http");
	Настройки = Справочники.Renault_СлужебныеНастройкиБазыДанных.RENAULT;
	Если Не ЗначениеЗаполнено(СокрЛП(Настройки.HTTP_URL)) Тогда
		
		НастройкиОбъект = Настройки.ПолучитьОбъект();
