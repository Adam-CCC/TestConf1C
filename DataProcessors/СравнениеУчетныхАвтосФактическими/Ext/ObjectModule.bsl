Процедура  ЗагрузитьДанныеИзФайла(Excel)   Экспорт 
      ТЗ = ЗаполнитьТЗ(Excel);   //вариант через com объект
	  
	  Для Каждого стр из ТЗ цикл
		  Если стр.Склад = "" тогда
			  Сообщить("В строке с Вином "+стр.VIN+" не обнаружен склад");
              Продолжить;
		  ИначеЕсли  Склады.Найти(стр.склад, "СкладСинхронизации") = Неопределено тогда
			  Продолжить;
		  КонецЕсли;	                              
		  Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Автомобили.Ссылка
			               |ИЗ
			               |	Справочник.Автомобили КАК Автомобили
			               |ГДЕ
			               |	Автомобили.VIN ПОДОБНО &VIN"; 
			Запрос.УстановитьПараметр("VIN","%" + стр.VIN + "%");	
		Авто	= Запрос.Выполнить().Выбрать();
		Если Авто.Следующий() тогда
			НайденнаяСтрока = Автомобили.Найти(авто.Ссылка, "Автомобиль"); 
			Если НайденнаяСтрока<>Неопределено тогда
				НайденнаяСтрока.Количество = 1;
			Иначе
				НоваяСтрока=Автомобили.Добавить();
				НоваяСтрока.Автомобиль=Авто.Ссылка;
				НоваяСтрока.Количество=1;
				//Если  НоваяСтрока.КоличествоУчет = 1 
				//НоваяСтрока.КоличествоУчет = 0;
				//
				//НоваяСтрока.Сумма = стр.Сумма;

			КонецЕсли;	
				
		Иначе
			Сообщить("Автомоиль с VIN "+стр.VIN+" не обнаружен");
		КонецЕсли;	
		  
	КонецЦикла;	  
КонецПроцедуры
  
Функция ЗаполнитьТЗ(Excel) Экспорт 
	
	
	//****************
	//создадим тз для записи данных
	ТЗ = новый ТаблицаЗначений;
	
	
	ТЗ.Колонки.Добавить("VIN");
	//ТЗ.Колонки.Добавить("Сумма");
	ТЗ.Колонки.Добавить("Склад");
	//ТЗ.Колонки.Добавить("Статус");

	
	VINКолонка =  VIN-1;
	СуммаКолонка = Сумма-1;
	СкладКолонка = Склад-1;
	СтатусКолонка = Статус-1;

	
	//ЭлементыФормы.Индикатор.МаксимальноеЗначение=10000;
	н = 0;
	
	
	//НетСотр = Новый ТаблицаЗначений;
	//НетСотр.Колонки.Добавить("Сотрудник");
	
	//Попытка
	
	Состояние("Чтение документа...");
	
	// используемые объекты
	Соединение = Новый COMОбъект("ADODB.Connection");
	НаборДанных = Новый COMОбъект("ADODB.Recordset");
	Каталог          = Новый COMОбъект("ADOX.Catalog");
	
	// подключение файла данных
	//Соединение.Open("Provider=Microsoft.Jet.OLEDB.4.0;Data Source=" + ПутьКФайлуXLS + ";Extended Properties=""Excel 8.0;IMEX=1;"""); //Это для Эксел 97-2000
	СтрокаСоединения = "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + ПутьКФайлу + "; Extended Properties=""Excel 12.0;""";     //Это для Эксел 2010
	//СтрокаСоединения = "Provider=Microsoft.Jet.OLEDB.4.0;Data Source=" + ПутьКФайлуXLS + ";Extended Properties=""Excel 8.0;IMEX=1;""";     //Это для Эксел 2010
	
	Соединение.Open(СтрокаСоединения);
	
	// определение имени листа для выбора данных
	Каталог.ActiveConnection     = Соединение;
	ИмяПервойСтраницы = Каталог.Tables.Item(0).Name;
	
	// получение данных листа
	НаборДанных.Open("
	|Select 
	|          *
	|From ["+НазваниеСтраницы+"$"+"]", 
	Соединение);
	
	ТекущаяСтрока = 1;
	НачальнаяСтрока = 3; //откуда стартуем
	КонечнаяСтрока = 1389; //где заканчиваем (отладка)
	
	// перенос данных в таблицу значений
	Пока Не НаборДанных.EOF Цикл
		Если ТекущаяСтрока >= НачальнаяСтрока - 1 Тогда  
			Проверка = СокрЛП(?(ТипЗнч(НаборДанных.Fields.Item(VIN).Value) <> Тип("Null"), (НаборДанных.Fields.Item(VIN).Value),""));
			
			Если  Проверка = "" тогда
				Прервать;
			КонецЕсли;	
			
			СтрокаТаблицы = ТЗ.Добавить();
			
			СтрокаТаблицы.VIN 	        = СокрЛП(?(ТипЗнч(НаборДанных.Fields.Item(VINКолонка).Value) <> Тип("Null"), (НаборДанных.Fields.Item(VINКолонка).Value),""));
			//СтрокаТаблицы.Сумма	        = СокрЛП(?(ТипЗнч(НаборДанных.Fields.Item(СуммаКолонка ).Value) <> Тип("Null"), (НаборДанных.Fields.Item(СуммаКолонка ).Value),""));
							
			СтрокаТаблицы.Склад 	        = СокрЛП(?(ТипЗнч(НаборДанных.Fields.Item(СкладКолонка).Value) <> Тип("Null"), (НаборДанных.Fields.Item(СкладКолонка).Value),""));
			//СтрокаТаблицы.Статус 	        = СокрЛП(?(ТипЗнч(НаборДанных.Fields.Item(СтатусКолонка).Value) <> Тип("Null"), (НаборДанных.Fields.Item(СтатусКолонка).Value),""));

		КонецЕсли; 
		
		НаборДанных.MoveNext();
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
		н = н+1;
		//ЭлементыФормы.Индикатор.Значение = н;
		
	КонецЦикла; 
	
	Соединение.Close();
	Сообщить(н);        
	
	
	//ТЗ.ВыбратьСтроку();
	
	Возврат ТЗ;	
	
КонецФункции




