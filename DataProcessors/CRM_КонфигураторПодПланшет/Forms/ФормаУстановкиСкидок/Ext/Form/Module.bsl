
&НаКлиенте
Процедура ОК(Команда)
	
	Ответ = Новый Структура;
	Ответ.Вставить("СуммаСкидки", СуммаСкидки);
	Ответ.Вставить("СуммаДоставки", СуммаДоставки);
	Закрыть(Ответ);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
    Закрыть(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СкидкаОбщаяПроцентПриИзменении(Элемент)
	СуммаСкидки = Окр(СуммаКонфигурации * СкидкаОбщаяПроцент / 100);
КонецПроцедуры

&НаКлиенте
Процедура СкидкаОбщаяСуммаПриИзменении(Элемент)
	
	Если СуммаКонфигурации <> 0 Тогда
		СкидкаОбщаяПроцент = СуммаСкидки / СуммаКонфигурации * 100;
	Иначе
		СкидкаОбщаяПроцент = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СкидкаОбщаяСуммаПриИзменении(Неопределено);
КонецПроцедуры
