&НаСервере
Процедура УдалитьКонфигурацию(Конфигурация)
	
	ОбКП = ТекущееКП.ПолучитьОбъект();
	Строки = ОбКП.Состав.НайтиСтроки(Новый Структура("Конфигурация", Конфигурация));
	Для Каждого Стр Из Строки Цикл
		ОбКП.Состав.Удалить(Стр);
	КонецЦикла;
	
	ОбКП.Сумма = ОбКП.Состав.Итог("Сумма");
	
	ОбКП.Записать(РежимЗаписиДокумента.Проведение);
	
