&НаСервере
Процедура СохранитьДанныеКлиента(ФИО, Телефон, Email)
	
	Если Не ЗначениеЗаполнено(ТекущийКлиент) Тогда
		КлиентОбъект = Справочники.CRM_ПотенциальныеКонтрагенты.СоздатьЭлемент();		
		КлиентОбъект.Наименование = ФИО;
		КлиентОбъект.НаименованиеПолное = ФИО;
		КлиентОбъект.Записать();
	Иначе
		КлиентОбъект = ТекущийКлиент.ПолучитьОбъект();
		КлиентОбъект.Наименование = ФИО;
		КлиентОбъект.НаименованиеПолное = ФИО;
		КлиентОбъект.Записать();
	КонецЕсли;
	
	Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойТелефонКлиента(Телефон, КлиентОбъект.Ссылка);
	
	Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойEmailКлиента(Email, КлиентОбъект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКлиентаСервер()
	
	Телефон = "";
	Email = "";
	ФИО = "";

	Если ЗначениеЗаполнено(ТекущийКлиент) Тогда
		
		Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(ТекущийКлиент);
		
		Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(ТекущийКлиент);
		
		ФИО = ТекущийКлиент.НаименованиеПолное;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКП()
	
	НомерКП = "";
	ДатаКП = Неопределено;
	
	Если ЗначениеЗаполнено(ТекущееКП) Тогда
		НомерКП = ТекущееКП.Номер;
		ДатаКП = ТекущееКП.Дата;
		СрокДействия = ТекущееКП.СрокДействия;
		ТекущаяКонфигурация = ТекущееКП.Состав[0].Конфигурация;
		ЗаявкаНаТрейдИн = ТекущееКп.ЗаявкаНаТрейдИн;
		ИнтересовалсяТрейдИн = ТекущееКП.ИнтересовалсяТрейдИн;
		ИнтересовалсяСтраховкой = ТекущееКП.ИнтересовалсяСтраховкой;
		ЗаявкаНаКредит = ТекущееКп.ЗаявкаНаКредит;
		ЗаявкаНаСтраховку = ТекущееКП.ЗаявкаНаСтраховку;
		ИнтересовалсяКредитом = ТекущееКП.ИнтересовалсяКредитом;
        ЗаявкаНаОборудование = ТекущееКП.ЗаявкаНаОборудование;
		ЗагрузитьЗаявкуНаТрейдИн();
		ЗагрузитьЗаявкуНаКредит();
		ЗагрузитьЗаявкуНаГарантию();
		ЗагрузитьЗаявкуНаОборудование();
		ЗагрузитьЗаявкуНаСтраховку();

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЦветов(ТекМодель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&ПустаяСтрока КАК Цвет,
	               |	"""" КАК Код,
	               |	"""" КАК ЦветНаименование
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_ЦветаМоделей.Цвет,
	               |	Renault_ЦветаМоделей.Цвет.Артикул,
	               |	Renault_ЦветаМоделей.Цвет.Наименование
	               |ИЗ
	               |	РегистрСведений.Renault_ЦветаМоделей КАК Renault_ЦветаМоделей
	               |ГДЕ
	               |	Renault_ЦветаМоделей.Модель = &Модель
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЦветНаименование";
	Запрос.УстановитьПараметр("Модель", ТекМодель);
	Запрос.УстановитьПараметр("ПустаяСтрока", Справочники.Цвета.ПустаяСсылка());
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Таблица.Очистить();
	КонецЕсли;
	
	ТаблицаЦвета.Загрузить(Таблица);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокМоделей()
	
	Бренд = ПараметрыСеанса.DMS_Бренд;
	
	Если ЗначениеЗаполнено(Бренд) Тогда
		МаркаРено = Бренд;
	Иначе
		МаркаРено = CRM_Сервер.ПолучитьМаркуRenault();
	КонецЕсли;
	
	МассивМарок = Новый Массив;
	Если Не МаркаРено.Пустая() Тогда
		МассивМарок = МаркаРено.МоделиАвтомобилейКоммерческоеПредложение.ВыгрузитьКолонку("Модель");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&ПустаяСтрока КАК Модель,
	               |	"""" КАК Наименование
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Модели.Ссылка,
	               |	Модели.Наименование
	               |ИЗ
	               |	Справочник.Модели КАК Модели
	               |ГДЕ
	               |	Модели.Ссылка В(&МассивМарок)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	Запрос.УстановитьПараметр("ПустаяСтрока", Справочники.Модели.ПустаяСсылка());
	Запрос.УстановитьПараметр("МассивМарок", МассивМарок);
	Таблица = Запрос.Выполнить().Выгрузить();
	ТаблицаМодели.Загрузить(Таблица);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКонфигураций(ТекМодель)
					   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	"""""""" КАК Комплектация,
	               |	&ПустаяСтрока КАК Ссылка,
	               |	"""""""" КАК Код,
	               |	"""""""" КАК Наименование
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации.НаименованиеПолное,
	               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации.Ссылка,
	               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации.Артикул,
	               |	ПОДСТРОКА(Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ВариантКомплектации.НаименованиеПолное, 0, 150)
	               |ИЗ
	               |	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних(
	               |			,
	               |			Тариф = &Тариф
	               |				И Модель = &Модель) КАК Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних
	               |ГДЕ
	               |	Renault_ТарифНаКомплектацииАвтомобилейСрезПоследних.ДоступноКЗаказуВПроизводство = ИСТИНА ИЛИ НЕ &СкрыватьНедоступныеКЗаказу
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
				   
	Запрос.УстановитьПараметр("Модель", ТекМодель);
	Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
	Запрос.УстановитьПараметр("ПустаяСтрока", Справочники.ВариантыКомплектации.ПустаяСсылка());
	Запрос.УстановитьПараметр("СкрыватьНедоступныеКЗаказу", Не ЗначениеЗаполнено(Автомобиль));
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Таблица.Очистить();
	Иначе
	КонецЕсли;
	
	ТаблицаКомплектации.Загрузить(Таблица);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаМоделиПриАктивизацииСтроки(Элемент)
	
	Если НеОбновлятьПриАктивизацииСтроки ИЛИ Элемент <> ЭтаФорма.ТекущийЭлемент Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ТаблицаМодели.ТекущаяСтрока <> Неопределено Тогда
		Модель = Элементы.ТаблицаМодели.ТекущиеДанные.Модель;
	Иначе
		Модель = Неопределено;
	КонецЕсли;
	
	ОбновитьСписокКонфигураций(Модель);
	ОбновитьСписокЦветов(Модель);
	ОбновитьКартинкуМодели();
	ПриИзмененииМоделиАвто();
	VIN = "";
	
КонецПроцедуры

