
&НаСервере
Функция ПолучитьСрокДействия(ДИлЦентр)
	
	
	ЭтоКорпКлиент = Ложь;
	РабочийЛист = ПолучитьРабочийЛист(ТекущийРабочийЛист);
	Если РабочийЛист <> Неопределено 
		И РабочийЛист.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
		
		ЭтоКорпКлиент = Истина;
		
	КонецЕсли;
	
	Если ДИлЦентр <> неопределено И ЗначениеЗаполнено(ДилЦентр.СрокДействияКпПоУмолчанию) Тогда
		
		Если Не ЭтоКорпКлиент И ЗначениеЗаполнено(ДилЦентр.СрокДействияКпПоУмолчанию) Тогда
			Ответ = КонецДня(ТекущаяДата()) + ДилЦентр.СрокДействияКпПоУмолчанию*60*60*24;
		ИначеЕсли ЭтоКорпКлиент И ЗначениеЗаполнено(ДилЦентр.СрокДействияКпПоУмолчаниюКОРП) Тогда
			Ответ = КонецДня(ТекущаяДата()) + ДилЦентр.СрокДействияКпПоУмолчаниюКОРП*60*60*24;
		ИначеЕсли ЭтоКорпКлиент Тогда
			Ответ = КонецДня(ТекущаяДата() + 30*24*60*60);
		Иначе
			Ответ = КонецДня(ТекущаяДата());
		КонецЕсли;
		
	Иначе
		
		Если ЭтоКорпКлиент Тогда
			Ответ = КонецДня(ТекущаяДата() + 30*24*60*60);
		Иначе
			Ответ = КонецДня(ТекущаяДата());
		КонецЕсли;
		
   	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

&НаСервере
Функция ПолучитьРабочийЛист(НомерЛиста)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|ГДЕ
		|	Renault_РабочиеЛисты.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", НомерЛиста);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПриОткрытииСервер()
	
	ТекДилерскийЦентр = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	ТекущийТариф = Renault_CRM.ПолучитьТекущийТарифНаАвтомобили();
	ТипЦенКП = Renault_РаботаСПравамиПользователя.ПолучитьТипЦенКП(ТекДилерскийЦентр); 
	СуммаДоставки = ТекДилерскийЦентр.СтоимостьДоставкиПоУмолчанию;
	//РассылкаУчетнаяЗапись = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь).ОсновнаяУчетнаяЗаписьЭлПочты;
	РассылкаТемаСообщения ="Комерческое предложение";
	Если ГодВыпуска = 0 Тогда
		ГодВыпуска = Год(ТекущаяДата());
	КонецЕсли;
	
	Если ТрейдИнГодВыпуска = 0 Тогда
		ТрейдИнГодВыпуска = Год(ТекущаяДата());
	КонецЕсли;
	
	СрокДействия = ПолучитьСрокДействия(ТекДилерскийЦентр);

	Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
	
	ПрочитатьДанныеКлиентаСервер();
	ОбновитьСписокМоделей();
	
	СоставКП.Параметры.УстановитьЗначениеПараметра("Ссылка", ТекущееКП);
	СписокКП.Параметры.УстановитьЗначениеПараметра("РабочийЛист", ТекущийРабочийЛист);
	
	//ОтображатьПредложения = Ложь;
	//ОтображатьСклад = Ложь;
	//ОбновитьОтображениеСклад();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Парам = Renault_ОбщиеФункции.МультибрендПараметрыОформления();
	Элементы.ДекорацияЛоготип.Картинка = Вычислить(Парам.Логотип2);
	
	УстановитьЦенуРОП();
	НастройкиОтправки =  Renault_CRM.ПолучитьНастройкиОтправкиКП(ПараметрыСеанса.Пользователь.Сотрудник);
	РассылкаУчетнаяЗапись = НастройкиОтправки.УчетнаяЗапись;
	РассылкаТемаСообщения = НастройкиОтправки.Тема;
	РассылкаТекстСоообщения = НастройкиОтправки.Текст;
    Если ЗначениеЗаполнено( НастройкиОтправки.УчетнаяЗапись) Тогда
		РассылкаПредставление = НастройкиОтправки.УчетнаяЗапись.Наименование;
	КонецЕсли;
	НеОбновлятьПриАктивизацииСтроки = Истина;	
	
	ПриОткрытииСервер();
	
	Если Не ТекущееКП.Пустая() Тогда
		//Загрузим коммерческое предложение при открытии
		ЗагрузитьКоммерческоеПредложение(ТекущееКП);
		//ОбновитьТаблицыСклад();
		ОбновитьРежимРедактирования();
	Иначе
		//Пустой конфигуратор
		ОбновитьСписокКонфигураций(Модель);
		ОбновитьСписокЦветов(Модель);
		ПриИзмененииВерсииАвто();
		ОбновитьВидимостьЭлементов();
		ОбновитьЗаголовки();
	КонецЕсли;
	
	СнятьОтображениеПродуктов();
	ОбновитьОтображениеПродукты();
	ОбновитьКнопкиЗаявок();
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
КонецПроцедуры

