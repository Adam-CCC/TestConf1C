&НаСервере
Функция ПоказатьНаПечать(Док) 
	
	МассивКП = Новый массив();
	МассивКП.Добавить(ТекущееКП);
	ТабДокумент = Новый ТабличныйДокумент;
	Документы.CRM_КоммерческоеПредложение.Печать(МассивКП,ТабДокумент,"ПФ_MXL_КП");
		
	Возврат ТабДокумент;
		
КонецФункции
	
Функция ПолучитьДанныеШапки(Док)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_КоммерческоеПредложение.Клиент.Наименование КАК НаименованиеКлиента,
	|	АдресаОрганизаций.Объект.Наименование КАК НаименованиеОрганизации,
	|	АдресаОрганизаций.Представление КАК АдресОрганизации,
	|	CRM_КоммерческоеПредложение.Клиент,
	|	&Организация,
	|	CRM_КоммерческоеПредложение.Автор.Сотрудник КАК КонтактноеЛицо,
	|	CRM_КоммерческоеПредложение.СрокДействия
	|ИЗ
	|	Документ.CRM_КоммерческоеПредложение КАК CRM_КоммерческоеПредложение
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КонтактнаяИнформация.Объект КАК Объект,
	|			КонтактнаяИнформация.Представление КАК Представление
	|		ИЗ
	|			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ГДЕ
	|			КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический)
	|			И КонтактнаяИнформация.Объект = &Организация) КАК АдресаОрганизаций
	|		ПО (ИСТИНА)
	|ГДЕ
	|	CRM_КоммерческоеПредложение.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Док);
	Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьБазовыеОпции(Модель, Версия)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОпцииВариантовКомплектации.Опция.Наименование КАК НаименованиеОпции
	|ИЗ
	|	РегистрСведений.ОпцииВариантовКомплектации КАК ОпцииВариантовКомплектации
	|ГДЕ
	|	ОпцииВариантовКомплектации.ВариантКомплектации = &Версия
	|	И ОпцииВариантовКомплектации.ВидВключения = 2";
	Запрос.УстановитьПараметр("Версия", Версия);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено
	Иначе
		Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("НаименованиеОпции");
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКонтакт(Объект, ВидКонтакта)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Вид = &Вид";
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Вид", ВидКонтакта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Представление;
	Иначе
		Возврат ""
	КонецЕсли;
	
КонецФункции

