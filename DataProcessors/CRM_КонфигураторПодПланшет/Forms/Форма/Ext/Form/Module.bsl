&НаКлиенте
Процедура ОбновитьКнопкиЗаявок()
	// Вставить содержимое обработчика.
	ЦветИстина = Новый Цвет(255, 196, 35);
	ЦветЛожь = Новый Цвет(245,242,221);
	
	Если ИнтересовалсяОборудованием Тогда
		Элементы.КнопкаИнтересовалсяОборудованием.ЦветФона =ЦветИстина;
	Иначе
		Элементы.КнопкаИнтересовалсяОборудованием.ЦветФона =ЦветЛожь;
	КонецЕсли;
	Если СоздаватьЗаявкуНаОборудование Тогда
		Элементы.КнопкаСоздаватьЗаявкуНаОборудование.ЦветФона =ЦветИстина;
	Иначе
		Элементы.КнопкаСоздаватьЗаявкуНаОборудование.ЦветФона =ЦветЛожь;
	КонецЕсли;
	
	Если ИнтересовалсяТрейдИн Тогда
		Элементы.КнопкаИнтересовалсяТрейдИн.ЦветФона =ЦветИстина;
	Иначе
		Элементы.КнопкаИнтересовалсяТрейдИн.ЦветФона =ЦветЛожь;
	КонецЕсли;
	Если СоздаватьЗаявку Тогда
		Элементы.КнопкаСоздаватьЗаявкуТрейдИн.ЦветФона =ЦветИстина;
		
	Иначе
		Элементы.КнопкаСоздаватьЗаявкуТрейдИн.ЦветФона =ЦветЛожь;
	КонецЕсли;
	
	Если ИнтересовалсяСтраховкой Тогда
		Элементы.КнопкаИнтересовалсяСтраховкой.ЦветФона =ЦветИстина;
	Иначе
		Элементы.КнопкаИнтересовалсяСтраховкой.ЦветФона =ЦветЛожь;
	КонецЕсли;
	Если СоздаватьЗаявкуНаСтраховку Тогда
		Элементы.КнопкаСоздаватьЗаявкуНаСтраховку.ЦветФона =ЦветИстина;
		
	Иначе
		Элементы.КнопкаСоздаватьЗаявкуНаСтраховку.ЦветФона =ЦветЛожь;
	КонецЕсли;
	
	Если ИнтересовалсяКредитом Тогда
		Элементы.КнопкаИнтересовалсяКредитом.ЦветФона =ЦветИстина;
	Иначе
		Элементы.КнопкаИнтересовалсяКредитом.ЦветФона =ЦветЛожь;
	КонецЕсли;
	Если СоздаватьЗаявкуНаКредит Тогда
		Элементы.КнопкаСоздаватьЗаявкуНаКредит.ЦветФона =ЦветИстина;
		
	Иначе
		Элементы.КнопкаСоздаватьЗаявкуНаКредит.ЦветФона =ЦветЛожь;
	КонецЕсли;


	
КонецПроцедуры



