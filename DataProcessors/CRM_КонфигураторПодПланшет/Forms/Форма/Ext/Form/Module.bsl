&НаКлиенте
Процедура ЗагрузитьКонфигурациюВКонфигураторКлиент(Конфигурация)
	
	ИндексыСтрок = ЗагрузитьКонфигурациюВКонфигураторСервер(Конфигурация);	
	ОбновитьТаблицыПоДаннымРеквизитов(ИндексыСтрок);	
	
	ОбновитьТТХИБазовыеОпции();
	ОбновитьКартинкуМодели();
	ПересчитатьЦенуВариантаКомплектации(); //Необходимо устанавливать в соответствии с КП!
	
	ОбновитьСпискиОборудованияАксессуаров(); //Дополнительные опции
	ЗагрузитьОпцииИзКонфигурации(ТекущаяКонфигурация);
	
	ПриИзмененииВерсииАвтоКлиент();
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьКонфигурациюВКонфигураторСервер(Конфигурация)
	
	Если Конфигурация = Неопределено Тогда
		Если ТекущееКП.Состав.Количество() > 0 Тогда
			Конфигурация = ТекущееКП.Состав[0].Конфигурация;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Конфигурация);
	УстановитьЦенуРОП();
	
	ОбновитьСписокКонфигураций(Модель);
	ОбновитьСписокЦветов(Модель);
	
	ИндексыСтрок = ПолучитьИндексыСтрокТаблиц(Модель, Версия, Цвет);
	
	Возврат ИндексыСтрок
	
КонецФункции

&НаСервере
Процедура ЗагрузитьОпцииИзКонфигурации(Конфигурация)

	Для Каждого Стр Из ВыбранныеНебазовыеОпции Цикл
		
		Если НЕ Конфигурация.Опции.Найти(Стр.Опция, "Опция") = Неопределено Тогда
			Стр.Выбран = Истина;
		Иначе
			Стр.Выбран = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ВыбранноеОборудование.Загрузить(Конфигурация.Оборудование.Выгрузить());

КонецПроцедуры	
	
&НаКлиенте
Процедура ЗагрузитьКПНажатие(Команда)
	
	Если ЗначениеЗаполнено(Элементы.СписокКП.ТекущаяСтрока) Тогда
		ТекущееКП = Элементы.СписокКП.ТекущаяСтрока;
	Иначе
		Возврат;
	КонецЕсли;
	
	ЗагрузитьКоммерческоеПредложение(ТекущееКП);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицыПоДаннымРеквизитов(ИндексыСтрок)
	
	Если ИндексыСтрок.ИндексМодель <> Неопределено Тогда
    	Элементы.ТаблицаМодели.ТекущаяСтрока = ТаблицаМодели[ИндексыСтрок.ИндексМодель].ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ИндексыСтрок.ИндексВерсия <> Неопределено Тогда
    	Элементы.ТаблицаКомплектации.ТекущаяСтрока = ТаблицаКомплектации[ИндексыСтрок.ИндексВерсия].ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ИндексыСтрок.ИндексЦвет <> Неопределено Тогда
    	Элементы.ТаблицаЦвета.ТекущаяСтрока = ТаблицаЦвета[ИндексыСтрок.ИндексЦвет].ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьИндексыСтрокТаблиц(Модель, Версия, Цвет)
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Модель", Модель);
	Строки = ТаблицаМодели.НайтиСтроки(СтруктураОтбора);
	Если Строки.Количество() > 0 Тогда
		ИндексМодель = ТаблицаМодели.Индекс(Строки[0]);
	Иначе
		ИндексМодель = Неопределено;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Ссылка", Версия);
	Строки = ТаблицаКомплектации.НайтиСтроки(СтруктураОтбора);
	Если Строки.Количество() > 0 Тогда
		ИндексВерсия = ТаблицаКомплектации.Индекс(Строки[0]);
	Иначе
		ИндексВерсия = Неопределено;
	КонецЕсли;	
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Цвет", Цвет);
	Строки = ТаблицаЦвета.НайтиСтроки(СтруктураОтбора);
	Если Строки.Количество() > 0 Тогда
		ИндексЦвет = ТаблицаЦвета.Индекс(Строки[0]);
	Иначе
		ИндексЦвет = Неопределено;
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("ИндексМодель", ИндексМодель);
	Ответ.Вставить("ИндексВерсия", ИндексВерсия);
	Ответ.Вставить("ИндексЦвет", ИндексЦвет);
	
	Возврат Ответ;
		
КонецФункции

&НаКлиенте
Процедура КонфигурацияДобавитьВКПНажатие(Команда)
	
	Если Не ЗначениеЗаполнено(Версия) ИЛИ Не ЗначениеЗаполнено(Цвет) Тогда
		Предупреждение("Не указана версия или цвет автомобиля");
		Возврат;
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	ТекущаяКонфигурация = ЗаписатьКонфигурацию(Истина);
	
	Если ЗначениеЗаполнено(ТекущаяКонфигурация) Тогда		
		ДобавитьКП(ТекущаяКонфигурация);
		ОткрытьСтраницуСоставКП();
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
	Оповестить("ОбновитьРабочийЛист");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКП(Конфигурация)
	
	Если НЕ ЗначениеЗаполнено(ТекущееКП) Тогда
		
		ОбКП = Документы.CRM_КоммерческоеПредложение.СоздатьДокумент();
		ОбКП.Дата			= ТекущаяДата();
		ОбКП.СрокДействия   = СрокДействия;
		ОбКП.Автор			= ПараметрыСеанса.Пользователь;
		//ОбКП.СрокДействия	= ТекущаяДата() + 86400 * Константы.CRM_СрокДействияКП.Получить();
		//ОбКП.СрокПоставки	= ТекущаяДата() + 86400 * Константы.CRM_СрокПоставки.Получить();
		ОбКП.Клиент			= ТекущийКлиент;
		ОбКП.РабочийЛист	= ТекущийРабочийЛист;
		ОбКП.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		ОбКП.ЗаявкаНаТрейдИн = СоздатьНайтиЗаявкуНаТрейдИн();
		обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
		ОбКП.ЗаявкаНаКредит = СоздатьНайтиЗаявкуНаКредит();
		ОбКП.ЗаявкаНаСтраховку = СоздатьНайтиЗаявкуНаСтраховку();
		ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
		Обкп.ЗаявкаНаОборудование = СоздатьНайтиЗаявкуНаОборудование();
		обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;

		ОбКП.Записать();
		
		ТекущееКП = ОбКП.Ссылка;
		
	Иначе
		
		ОбКП = ТекущееКП.ПолучитьОбъект();
		//ОбКП.Дата			= ТекущаяДата();
		//ОбКП.Автор			= ПараметрыСеанса.Пользователь;
		ОбКП.СрокДействия	= СрокДействия;
		//ОбКП.СрокПоставки	= ТекущаяДата() + 86400 * Константы.CRM_СрокПоставки.Получить();
		//ОбКП.Клиент			= ТекущийКлиент;
		//ОбКП.РабочийЛист	= ТекущийРабочийЛист;
		//ОбКП.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		ОбКП.ЗаявкаНаТрейдИн = СоздатьНайтиЗаявкуНаТрейдИн();
		обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
		ОбКП.ЗаявкаНаКредит = СоздатьНайтиЗаявкуНаКредит();
		ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
		ОбКП.ЗаявкаНаОборудование = СоздатьНайтиЗаявкуНаОборудование();
		обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
        Обкп.ИнтересовалсяСтраховкой = ИнтересовалсяСтраховкой;
		ОбКП.ЗаявкаНаСтраховку = СоздатьНайтиЗаявкуНаСтраховку();
		ОбКП.Записать();
		
	КонецЕсли;
	
	СтрКонф = ОбКП.Состав.Добавить();
	СтрКонф.Конфигурация = Конфигурация;
	СтрКонф.Сумма = ЦенаИТОГО;
	СтрКонф.СуммаДоставки = СуммаДоставки;
	СтрКонф.СуммаСкидки = СуммаСкидки;
	
	НомерКП = ОбКП.Номер;
	ДатаКП = ОбКП.Дата;
	
	ОбКП.Сумма = ОбКП.Состав.Итог("Сумма");
	обКП.ЗаявканаТрейдИн = ЗаявкаНаТрейдИн;
	обКП.ЗаявкаНаКредит = ЗаявкаНаКредит;
	ОбКП.ЗаявкаНаСтраховку = ЗаявкаНаСтраховку;
	обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
	обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
	ОбКП.интересовалсяСтраховкой = ИнтересовалсяСтраховкой;

	ОбКП.Записать(РежимЗаписиДокумента.Проведение);
	
