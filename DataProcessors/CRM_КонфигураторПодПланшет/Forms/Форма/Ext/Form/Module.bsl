&НаКлиенте
Процедура ЗагрузитьКоммерческоеПредложение(КоммерческоеПредложениеСсылка)
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	ПрочитатьДанныеКП();
	
	Если Не ТекущееКП.Пустая() Тогда
		
		Элементы.СписокКП.ТекущаяСтрока = ТекущееКП;
		ОткрытьСтраницуСоставКП();		
		ЗагрузитьКонфигурациюВКонфигураторКлиент(ТекущаяКонфигурация);
		
	КонецЕсли;
	
	ОбновитьЗаголовки();
	ОбновитьВидимостьЭлементов();
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьАвтомобильВКонфигураторКлиент(АвтомобильСсылка)
	
	ТекущийТариф = Renault_CRM.ПолучитьПоследнийТарифНаАвтомобиль(АвтомобильСсылка.ВариантКомплектации);
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	Автомобиль = АвтомобильСсылка;
	УстановитьЦенуРОП();
		
	ИндексыСтрок = ЗагрузитьАвтомобильВКонфигураторСервер(АвтомобильСсылка);	
	ОбновитьТаблицыПоДаннымРеквизитов(ИндексыСтрок);	

	ОбновитьТТХИБазовыеОпции();
	ОбновитьКартинкуМодели();
	ПересчитатьЦенуВариантаКомплектации(); //Плохо. Необходимо устанавливать в соответствии с авто

	ОбновитьСпискиОборудованияАксессуаров(); //Дополнительные опции
	ЗагрузитьОпцииИзАвтомобиля(АвтомобильСсылка);

	ПриИзмененииВерсииАвтоКлиент();
	
	ОбновитьЗаголовки();
	ОбновитьВидимостьЭлементов();
	ОбновитьРежимРедактирования();
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьАвтомобильВКонфигураторСервер(АвтомобильСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.Модель,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.Версия,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.Цвет,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.OPTIONS,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN
	               |ИЗ
	               |	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	               |ГДЕ
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль = &Автомобиль";
	Запрос.УстановитьПараметр("Автомобиль", АвтомобильСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	VIN = "";
	Модель = Справочники.Модели.ПустаяСсылка();
	Версия = Справочники.ВариантыКомплектации.ПустаяСсылка();
	Цвет = Справочники.Цвета.ПустаяСсылка();
	
	Если Выборка.Следующий() Тогда
		
		VIN = Выборка.VIN;
		Модель = Выборка.Модель;
		Версия = Выборка.Версия;
		Цвет = Выборка.Цвет;
		
	КонецЕсли;
	
	ОбновитьСписокКонфигураций(Модель);
	ОбновитьСписокЦветов(Модель);
	
	ИндексыСтрок = ПолучитьИндексыСтрокТаблиц(Модель, Версия, Цвет);
	
	//Если ИндексыСтрок.ИндексМодель = Неопределено Тогда
	//	Элементы.ПолеМодель.Видимость = Истина;
	//Иначе
	//	Элементы.ПолеМодель.Видимость = Ложь;
	//КонецЕсли;
	//
	//Если ИндексыСтрок.ИндексВерсия = Неопределено Тогда
	//	Элементы.ПолеКомплектация.Видимость = Истина;
	//Иначе
	//	Элементы.ПолеМодель.Видимость = Ложь;
	//КонецЕсли;
	//
	//Если ИндексыСтрок.ИндексЦвет = Неопределено Тогда
	//	Элементы.ПолеЦвет.Видимость = Истина;
	//Иначе
	//	Элементы.ПолеМодель.Видимость = Ложь;
	//КонецЕсли;
		
	Возврат ИндексыСтрок;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьОпцииИзАвтомобиля(АвтомобильСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.OPTIONS
	               |ИЗ
	               |	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	               |ГДЕ
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль = &Автомобиль";
	Запрос.УстановитьПараметр("Автомобиль", АвтомобильСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий(); //Плохо, нет проверки на ошибку
	
	МассивПодстрок = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(Выборка.OPTIONS, " ");
		
	Для Каждого Стр Из ВыбранныеНебазовыеОпции Цикл
		
		Если МассивПодстрок.Найти(СокрЛП(Стр.КодОпции)) <> Неопределено Тогда
			Стр.Выбран = Истина;
		Иначе
			Стр.Выбран = Ложь;
		КонецЕсли;
		
	КонецЦикла;

