&НаКлиенте
Процедура КонфигурацияПерезаписать(Команда)
	
	Если Не ЗначениеЗаполнено(Версия) ИЛИ Не ЗначениеЗаполнено(Цвет) Тогда
		Предупреждение("Не указана версия или цвет автомобиля");
		Возврат;
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	ЗаявкаНаТрейдИн = СоздатьНайтиЗаявкуНаТрейдИн();
	ЗаявкаНаКредит = СоздатьНайтиЗаявкуНаКредит();
	ЗаявкаНаСтраховку = СоздатьНайтиЗаявкуНаСтраховку();
	ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
	ЗаявкаНаОборудование = СоздатьНайтиЗаявкуНаОборудование();
	ТекущаяКонфигурация = ЗаписатьКонфигурацию(Истина);
	
	Если ЗначениеЗаполнено(ТекущаяКонфигурация) Тогда		
		Перезаписать(ТекущаяКонфигурация);
		ОткрытьСтраницуСоставКП();
	КонецЕсли;
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
	Оповестить("ОбновитьРабочийЛист");
	//ОбновитьОтображениеГруппПоЗаявкам();
	
КонецПроцедуры

