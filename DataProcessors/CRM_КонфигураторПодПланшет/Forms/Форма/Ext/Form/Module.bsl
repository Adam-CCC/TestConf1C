процедура ЗагрузитьЗаявкуНаТрейдИн()
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) тогда
		
		ТрейдИнВерсия =ЗаявкаНаТрейдИн.Версия;
		ТрейдИнГодВыпуска=ЗаявкаНаТрейдИн.ГодВыпуска ;
		
		ТрейдИнКомментарий=	ЗаявкаНаТрейдИн.Комментарий ;
		ТрейдИнМодель=ЗаявкаНаТрейдИн.Модель ;
		ТрейдИнПробег=ЗаявкаНаТрейдИн.Пробег ;
		
		ТрейдИнСумма=ЗаявкаНаТрейдИн.СуммаСНДС ;
		ТрейдИнЦвет=ЗаявкаНаТрейдИн.Цвет ;
		
		ИнтересовалсяТрейдИн = истина;
				
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере 
Функция СоздатьНайтиЗаявкуНаТрейдИн()
	
	ЗначениеПустое = Ложь;
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		
		ДокОб = ЗаявкаНаТрейдИн.Ссылка.ПолучитьОбъект();
		
	ИначеЕсли  СоздаватьЗаявку Тогда
		
		ДокОб = Документы.Renault_ЗаявкаНаТрейдИн.СоздатьДокумент();
	Иначе
		
		ДокОб =  Документы.Renault_ЗаявкаНаТрейдИн.ПустаяСсылка();
		ЗначениеПустое = Истина;
		
	КонецЕсли;
	
	Если Не(ЗначениеПустое)Или СоздаватьЗаявку Тогда
		МожноСохранить = Ложь;
		Если НЕ ДокОб.ЭтоНовый() Тогда
			Если ДокОб.Черновик И Не ДокОб.Закрыта Тогда
			   МожноСохранить = Истина;
				
			КонецЕсли;
		Иначе
			
			МожноСохранить = Истина;
			
		КонецЕсли;
		Если МожноСохранить тогда
			
			ДокОб.Версия = ТрейдИнВерсия;
			ДокОб.ГодВыпуска = ТрейдИнГодВыпуска;
			ДокОб.Дата = ТекущаяДата();
			ДокОб.Клиент = ТекущийКлиент;
			ДокОб.Комментарий = ТрейдИнКомментарий;
			ДокОб.Модель = ТрейдИнВерсия;
			ДокОб.Марка = ТрейдИнМодель;
			ДокОб.Пробег = ТрейдИнПробег;
			ДокОб.РабочийЛист = ТекущийРабочийЛист;
			Докоб.СрокДействия = СрокДействия;
			ДокОб.ОриентировочнаяЦена = ТрейдИнСумма;
			ДокОб.Цвет = ТрейдИнЦвет;
			ДокОб.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			ДокОб.Записать(РежимЗаписиДокумента.Проведение);
			ЗаявкаНаТрейдИн = ДокОб.Ссылка;
			ИнтересовалсяТрейдИн = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДокОб.Ссылка;	
КонецФункции

