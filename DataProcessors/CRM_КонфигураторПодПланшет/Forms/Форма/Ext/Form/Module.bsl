&НаСервере
Процедура ОбновитьТТХИБазовыеОпции()
	
	ТТХ.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Renault_ДопИнформацияПоВерсиям.ОбъемДвигателя КАК ДвигательОбъем,
	|	Renault_ДопИнформацияПоВерсиям.ТипТоплива КАК ДвигательТипТоплива,
	|	Renault_ДопИнформацияПоВерсиям.МощностьЛС КАК ДвигательЛС,
	|	Renault_ДопИнформацияПоВерсиям.МощностьКВТ КАК Двигатель_кВт,
	|	Renault_ДопИнформацияПоВерсиям.СтандартЕвро КАК Двигатель_НормаЕвро,
	|	Renault_ДопИнформацияПоВерсиям.МаксимальнаяМасса КАК МассаMax,
	|	Renault_ДопИнформацияПоВерсиям.МинимальнаяМасса КАК МассаMin
	|ИЗ
	|	РегистрСведений.Renault_ДопИнформацияПоВерсиям КАК Renault_ДопИнформацияПоВерсиям
	|ГДЕ
	|	Renault_ДопИнформацияПоВерсиям.ВариантКомплектации = &Версия";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Объём двигателя";
		Стр.Значение = Выборка.ДвигательОбъем;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Тип топлива";
		Стр.Значение = Выборка.ДвигательТипТоплива;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Мощность (л.с.)";
		Стр.Значение = Выборка.ДвигательЛС;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Мощность (кВт)";
		Стр.Значение = Выборка.Двигатель_кВт;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Норма ЕВРО";
		Стр.Значение = Выборка.Двигатель_НормаЕвро;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Максимальная масса";
		Стр.Значение = Выборка.МассаMax;
		Стр = ТТХ.Добавить();
		Стр.Показатель = "Минимальная масса";
		Стр.Значение = Выборка.МассаMin;
	Иначе
		ТекущийИдентификатор = ""
	КонецЕсли;
	
	БазовыеОпции.Отбор.Элементы[0].ПравоеЗначение = ТекущийТариф;
	БазовыеОпции.Отбор.Элементы[1].ПравоеЗначение = Модель;
	БазовыеОпции.Отбор.Элементы[2].ПравоеЗначение = Версия;
	
КонецПроцедуры

