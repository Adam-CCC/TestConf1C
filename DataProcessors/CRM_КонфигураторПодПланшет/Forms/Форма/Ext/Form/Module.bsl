&НаСервере
Процедура ПересчитатьЦенуВариантаКомплектации()
	
	ЦенаВариантаКомплектации = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", Версия);
	Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Renault_ТарифНаКомплектацииАвтомобилей.ЦенаКлиентская
	|ИЗ
	|	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних(, Тариф = &Тариф) КАК Renault_ТарифНаКомплектацииАвтомобилей
	|ГДЕ
	|	Renault_ТарифНаКомплектацииАвтомобилей.Модель = &Модель
	|	И Renault_ТарифНаКомплектацииАвтомобилей.ВариантКомплектации = &ВариантКомплектации";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЦенаВариантаКомплектации = Выборка.ЦенаКлиентская;
	Иначе
		ЦенаВариантаКомплектации = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКартинкуМодели()
	
	АдресКартинки = "";
	МенеджерИдентификатор = РегистрыСведений.CRM_ИдентификаторыКартинок.СоздатьМенеджерЗаписи();
	МенеджерИдентификатор.Модель = Модель;
	МенеджерИдентификатор.Цвет = Цвет;
	МенеджерИдентификатор.ВариантКомплектации = Версия;
	МенеджерИдентификатор.Прочитать();
	Если НЕ МенеджерИдентификатор.Выбран() Тогда
		МенеджерИдентификатор.Модель = Модель;
		МенеджерИдентификатор.Цвет = Цвет;
		МенеджерИдентификатор.Прочитать();
	КонецЕсли;
	Если НЕ МенеджерИдентификатор.Выбран() Тогда
		МенеджерИдентификатор.Модель = Модель;
		МенеджерИдентификатор.Прочитать();
	КонецЕсли;
	Если НЕ МенеджерИдентификатор.Выбран() Тогда
		Возврат
	КонецЕсли;
	КлючЗаписиРег = РегистрыСведений.КартинкиИФайлы.СоздатьКлючЗаписи(Новый Структура("Объект,Идентификатор", Модель, МенеджерИдентификатор.Идентификатор)); 
	Если НЕ КлючЗаписиРег.Пустой() Тогда
		АдресКартинки = ПолучитьНавигационнуюСсылку(КлючЗаписиРег, "Данные")
	КонецЕсли;
	
КонецПроцедуры

