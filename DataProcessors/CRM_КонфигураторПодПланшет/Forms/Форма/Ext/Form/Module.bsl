&НаКлиенте
Процедура КредитнаяПрограммаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(КредитнаяПрограмма) Тогда
		
		СтараяПГ = ПродленнаяГарантия;		
		ОбновитьДанныеКредита();
		Если ПродленнаяГарантия <> СтараяПГ Тогда
			Предупреждение("Выбрана бесплатная продлённая гарантия: " + Строка(ПродленнаяГарантия), 30);
			ПересчитатьЦенуАвто();
		КонецЕсли;
		ПересчитатьКредит();
		Элементы.ДопустимыеСрокиКредита.Заголовок = "(" + Строка(МинимальныйСрокКредита) + " - " + Строка(МаксимальныйСрокКредита) + " мес.)";
		Элементы.ДекорацияПроцент.Заголовок = "% (" + Строка(МинимальныйПервоначальныйВзнос) + " - " + Строка(МаксимальныйПервоначальныйВзнос) + " %)";
		
	Иначе
		
		Элементы.ДопустимыеСрокиКредита.Заголовок = "";
		Элементы.ДекорацияПроцент.Заголовок = "";
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКредита()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КредитнаяПрограмма", КредитнаяПрограмма);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_ПараметрыКредитныхПрограмм.МинимальныйСрокКредита,
	|	CRM_ПараметрыКредитныхПрограмм.МаксимальныйСрокКредита,
	|	CRM_ПараметрыКредитныхПрограмм.МинимальныйПервоначальныйВзнос,
	|	CRM_ПараметрыКредитныхПрограмм.МаксимальныйПервоначальныйВзнос,
	|	CRM_ПараметрыКредитныхПрограмм.СтавкаБанка,
	|	CRM_ПараметрыКредитныхПрограмм.МаркетинговаяСтавка
	|ИЗ
	|	РегистрСведений.CRM_ПараметрыКредитныхПрограмм КАК CRM_ПараметрыКредитныхПрограмм
	|ГДЕ
	|	CRM_ПараметрыКредитныхПрограмм.КредитнаяПрограмма = &КредитнаяПрограмма";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		МинимальныйСрокКредита 				= Выборка.МинимальныйСрокКредита;
		МаксимальныйСрокКредита 			= Выборка.МаксимальныйСрокКредита;
		МинимальныйПервоначальныйВзнос 		= Выборка.МинимальныйПервоначальныйВзнос;
		МаксимальныйПервоначальныйВзнос 	= Выборка.МаксимальныйПервоначальныйВзнос;
		СтавкаБанка 						= Выборка.СтавкаБанка;
		МаркетинговаяСтавка 				= Выборка.МаркетинговаяСтавка;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("ГодПроизводства", ГодВыпуска);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(CRM_СтоимостьПродленнойГарантии.ПредложениеПГ, ЗНАЧЕНИЕ(Справочник.CRM_ПредложенияПродленнойГарантии.ПустаяСсылка)) КАК ПГ,
	|	ЕСТЬNULL(CRM_СтоимостьПродленнойГарантии.Сумма, 0) КАК Сумма
	|ИЗ
	|	РегистрСведений.CRM_ПрименениеКредитныхПрограмм КАК CRM_ПрименениеКредитныхПрограмм
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СтоимостьПродленнойГарантии КАК CRM_СтоимостьПродленнойГарантии
	|		ПО CRM_ПрименениеКредитныхПрограмм.ПГВПодарок = CRM_СтоимостьПродленнойГарантии.ПредложениеПГ
	|			И CRM_ПрименениеКредитныхПрограмм.Модель = CRM_СтоимостьПродленнойГарантии.Модель
	|ГДЕ
	|	CRM_ПрименениеКредитныхПрограмм.Модель = &Модель
	|	И CRM_ПрименениеКредитныхПрограмм.Версия = &Версия
	|	И CRM_ПрименениеКредитныхПрограмм.ГодПроизводства = &ГодПроизводства
	|	И CRM_ПрименениеКредитныхПрограмм.КредитнаяПрограмма = &КредитнаяПрограмма";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ГарантияСумма < Выборка.Сумма Тогда
			ПродленнаяГарантия = Выборка.ПГ;
			ГарантияСумма = Выборка.Сумма;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

