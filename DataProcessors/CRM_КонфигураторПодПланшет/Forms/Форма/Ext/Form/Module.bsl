	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущееКП) Тогда
		Элементы.ДекорацияЗаголовок.Заголовок = "Коммерческое предложение - " + ИмяКлиента + " (РЛ №" + ТекущийРабочийЛист + ")"; 
	Иначе
		Элементы.ДекорацияЗаголовок.Заголовок = "Коммерческое предложение* - " + ИмяКлиента + " (РЛ №" + ТекущийРабочийЛист + ")"; 
	КонецЕсли;
	
