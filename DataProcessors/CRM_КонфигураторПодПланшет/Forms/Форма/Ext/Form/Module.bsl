&НаКлиенте 
Процедура ОбновитьРежимРедактирования()
	
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		//Нет свободного редактирования		
		
		//ограничение доступности
		Элементы.ГруппаКомплектация.Доступность = Ложь;
		//Элементы.ВыбранныеНебазовыеОпции.Доступность = Ложь;
		Элементы.ВыбранныеНебазовыеОпции.ТолькоПросмотр = Истина;
		Элементы.ВыбратьОпцию.Видимость = Ложь;
		
		//видимость элементов
		Элементы.КнопкаПерейтиВРежимСвободногоРедактирования.Видимость = Истина;
		
		//выделение цветом
		Элементы.ТаблицаКомплектации.ЦветФона = Новый Цвет(248, 242, 216);
		Элементы.ТаблицаМодели.ЦветФона = Новый Цвет(248, 242, 216);
		Элементы.ТаблицаЦвета.ЦветФона = Новый Цвет(248, 242, 216);
		Элементы.ВыбранныеНебазовыеОпции.ЦветФона = Новый Цвет(248, 242, 216);
		
	Иначе
		//Свободное редактирование		
		
		//ограничение доступности
		Элементы.ГруппаКомплектация.Доступность = Истина;
		//Элементы.ВыбранныеНебазовыеОпции.Доступность = Истина;
		Элементы.ВыбранныеНебазовыеОпции.ТолькоПросмотр = Ложь;
		Элементы.ВыбратьОпцию.Видимость = Истина;
		
		//видимость элементов
		Элементы.КнопкаПерейтиВРежимСвободногоРедактирования.Видимость = Истина;
		
		//выделение цветом
		Элементы.ТаблицаКомплектации.ЦветФона = Новый Цвет(255, 255, 255);
		Элементы.ТаблицаМодели.ЦветФона = Новый Цвет(255, 255, 255);
		Элементы.ТаблицаЦвета.ЦветФона = Новый Цвет(255, 255, 255);
		Элементы.ВыбранныеНебазовыеОпции.ЦветФона = Новый Цвет(255, 255, 255);
		
	КонецЕсли;
	
