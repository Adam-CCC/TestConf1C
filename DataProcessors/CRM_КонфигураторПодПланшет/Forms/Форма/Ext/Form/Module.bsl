&НаСервере 
Функция СоздатьНайтиЗаявкуНаОборудование()
	
	ЗначениеПустое = Ложь;
	Если ЗначениеЗаполнено(ЗаявкаНаОборудование) Тогда
		ДокОб = ЗаявкаНаОборудование.Ссылка.ПолучитьОбъект();
	ИначеЕсли ВыбранноеОборудование.Количество() > 0
		ИЛИ ВыбранныеАвтоработы.Количество() > 0 Тогда
		ДокОб = Документы.CRM_ЗаявкаНаДилерскиеОпции.СоздатьДокумент();
		ДокОб.Статус = Перечисления.Renault_CRM_СтатусЗаявокНаОборудование.НаРассмотрении;
	Иначе
		ДокОб = Документы.CRM_ЗаявкаНаДилерскиеОпции.ПустаяСсылка();
		ЗначениеПустое = Истина;
	КонецЕсли;
	
	Если Не(ЗначениеПустое) И (Не(ДокОб = неопределено)) Тогда
		МожноСохранить = Ложь;
		Если НЕ ДокОб.ЭтоНовый() Тогда
			//Если Не ДокОб.ВыполненаУспешно Тогда
			   МожноСохранить = Истина;
			//КонецЕсли;
		Иначе
			МожноСохранить = Истина;
		КонецЕсли;
		Если МожноСохранить И СоздаватьЗаявкуНаОборудование тогда
			ДокОб.Комплектация = Версия;
			ДокОб.Дата = ТекущаяДата();
			ДокОб.Клиент = Метаданные.Документы.CRM_ЗаявкаНаДилерскиеОпции.Реквизиты.Клиент.Тип.ПривестиЗначение(ТекущийКлиент);
			//ДокОб.Комментарий = ТрейдИнКомментарий;
			ДокОб.Модель = Модель;
			ДокОб.РабочийЛист = ТекущийРабочийЛист;
			//ДокОб.Сумма = ГарантияСумма;
			ДокОб.Цвет = Цвет;
			//ДокОб.ПродленнаяГарантия = ПродленнаяГарантия;
			ДокОб.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			ДокОб.ДопОпции.Очистить();
			ДокОб.Автоработы.Очистить();
			
			Для Каждого Оборудование Из ВыбранноеОборудование Цикл
				
				НовСтрока = ДокОб.ДопОпции.Добавить();
				ЗаполнитьСтрокуТЧЗаявкиНаОборудование(НовСтрока, Оборудование);
				
			КонецЦикла;
			
			Для Каждого Авторабота Из ВыбранныеАвтоработы Цикл
				
				НовСтрока = ДокОб.Автоработы.Добавить();
				ЗаполнитьСтрокуТЧЗаявкиНаОборудование(НовСтрока, Авторабота);
				
			КонецЦикла;
			
			ДокОб.Записать(РежимЗаписиДокумента.Проведение);
			ЗаявкаНаОборудование = ДокОб.Ссылка;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ДокОб.Ссылка;
	
КонецФункции


Функция РазослатьСообщение(ТемаСообщения,ТекстСообщения,МассивАдресовРассылки,УчетнаяЗапись,ПредставлениеОтправителя,МассивПутейКПрикрепляемымФайлам)Экспорт
	
