			Если УчетнаяЗапись.ВремяОжиданияСервера > 0 Тогда
				Профиль.ВремяОжидания = УчетнаяЗапись.ВремяОжиданияСервера;
			КонецЕсли; 

			ИнтернетПочта = Новый ИнтернетПочта;  		
			
			Попытка
				ИнтернетПочта.Подключиться(Профиль);
				Письмо =  СоздатьПисьмо(ТемаСообщения,ТекстСообщения,АдресРассылки,УчетнаяЗапись,ПредставлениеОтправителя,МассивПутейКПрикрепляемымФайлам);
				ИнтернетПочта.Послать(Письмо);
			Исключение
				//Сообщить(элРазобратьОшибкуПочтовогоСоединения(), СтатусСообщения.Важное);
				//Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
				//Предупреждение("Произошли ошибки при проверке настроек учетной записи.
				//|Описание ошибки приведено в окне сообщения.");
				Возврат Ложь;
				
			КонецПопытки; 		

			//РежимОбмена = Новый Структура();
			//РежимОбмена.Вставить("Получить",Ложь);
			//РежимОбмена.Вставить("Отправить",Истина);
			//ПочтовыйЯщик = эпПодключитьсяКПочтовомуСерверу(УчетнаяЗапись,РежимОбмена);
			//  
			//УчетнаяЗапись= Справочники.УчетныеЗаписиЭлектроннойПочты.СоздатьЭлемент().
			//ПочтовыйЯщик.Послать(Письмо);
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЦикла;
	Возврат истина;
КонецФункции

Функция СоздатьПисьмо(Тема,ТекстСообщения,Получатель,Отправитель,ПредставлениеОтправителя,ПутиКФайлам)Экспорт
	Сообщение = новый ИнтернетПочтовоеСообщение;
	//Сообщение.ДатаОтправления =ТекущаяДата();
	Сообщение.Тема = Тема;
	Сообщение.Тексты.Добавить(ТекстСообщения);
	Сообщение.Получатели.Добавить(Получатель);	
	Сообщение.Отправитель.Адрес = Отправитель.АдресЭлектроннойПочты;
	Сообщение.Отправитель.ОтображаемоеИмя = ПредставлениеОтправителя;//"Рассылка комерческих предложений(автомат)";
	Для Каждого ПутьКФайлу Из ПутиКФайлам Цикл
		Сообщение.Вложения.Добавить(ПутьКФайлу,"Комерческое предложение");
	КонецЦикла;
	Возврат Сообщение;
	
КонецФункции

&НаКлиенте
Процедура ОтправитьКП(Команда)
	
	Если ЗначениеЗаполнено(ТекущееКП)И ЗначениеЗаполнено(Email)И ЗначениеЗаполнено(РассылкаУчетнаяЗапись) Тогда
		
		МассивПутейКФайламКп = Новый Массив();
		ТабДок = Новый ТабличныйДокумент();
		МассивДок = Новый Массив();
		МассивДок.Добавить(ТекущееКП.Ссылка);
		Документы.CRM_КоммерческоеПредложение.Печать(МассивДок,ТабДок,"ПФ_MXL_КП");
		ИмяФайла = ПолучитьИмяВременногоФайла("PDF");
		ТабДок.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
		МассивПутейКФайламКп.Добавить(ИмяФайла); 
		Адресаты = Новый	 Массив();
		Адресаты.Добавить(Email);
		ЗаполненныйТекстСообщения = ЗаполнитьТекстЕмаилаПараметрами(РассылкаТекстСоообщения);
		Ответ =	РазослатьСообщение(РассылкаТемаСообщения,ЗаполненныйТекстСообщения,Адресаты,
							РассылкаУчетнаяЗапись,РассылкаПредставление,МассивПутейКФайламКп);
							
		Если Ответ = Истина Тогда
			Предупреждение("Сообщение отправлено");
		Иначе
			Предупреждение("Не удалось отправить сообщение, обратитесь в поддержку");
		КонецЕсли;
							
	Иначе
		Предупреждение("Необходимо сохранить предложение, заполнить email и указать учетную запись электронной почты");	
	КонецЕсли;	

КонецПроцедуры


