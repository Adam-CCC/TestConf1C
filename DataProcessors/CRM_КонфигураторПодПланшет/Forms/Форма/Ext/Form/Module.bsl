Процедура ОбновитьОтображениеПродукты()
	
	Элементы.ГруппаПродленнаяГарантия.Видимость = Ложь;
	Элементы.ГруппаТрейдИн.Видимость = Ложь;
	Элементы.ГруппаСтраховка.Видимость = Ложь;
	Элементы.ГруппаРасчетКредита.Видимость = Ложь;
	
	Элементы.Продукты_Гарантия.Шрифт = Новый Шрифт(Элементы.Продукты_Гарантия.Шрифт,,,Ложь);
	Элементы.Продукты_Кредит.Шрифт = Новый Шрифт(Элементы.Продукты_Кредит.Шрифт,,,Ложь);
	Элементы.Продукты_Страховка.Шрифт = Новый Шрифт(Элементы.Продукты_Страховка.Шрифт,,,Ложь);
	Элементы.Продукты_ТрейдИн.Шрифт = Новый Шрифт(Элементы.Продукты_ТрейдИн.Шрифт,,,Ложь);
	
	Если ОтображатьГарантию Тогда
		Элементы.ГруппаПродленнаяГарантия.Видимость = Истина;
		Элементы.Продукты_Гарантия.Шрифт = Новый Шрифт(Элементы.Продукты_Гарантия.Шрифт,,,Истина);
		
	ИначеЕсли ОтображатьКредит Тогда
		Элементы.ГруппаРасчетКредита.Видимость = Истина;
		Элементы.Продукты_Кредит.Шрифт = Новый Шрифт(Элементы.Продукты_Кредит.Шрифт,,,Истина);
		
	ИначеЕсли ОтображатьСтраховку Тогда
		Элементы.ГруппаСтраховка.Видимость = Истина;
		Элементы.Продукты_Страховка.Шрифт = Новый Шрифт(Элементы.Продукты_Страховка.Шрифт,,,Истина);
		
	ИначеЕсли ОтображатьТрейдИн Тогда
		Элементы.ГруппаТрейдИн.Видимость = Истина;
		Элементы.Продукты_ТрейдИн.Шрифт = Новый Шрифт(Элементы.Продукты_ТрейдИн.Шрифт,,,Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Перезаписать(Конфигурация)
	
	Если НЕ ЗначениеЗаполнено(ТекущееКП) Тогда
		
		ОбКП = Документы.CRM_КоммерческоеПредложение.СоздатьДокумент();
		ОбКП.Дата			= ТекущаяДата();
		ОбКП.Автор			= ПараметрыСеанса.Пользователь;
		ОбКП.СрокДействия	= ТекущаяДата() + 86400 * Константы.CRM_СрокДействияКП.Получить();
		//ОбКП.СрокПоставки	= ТекущаяДата() + 86400 * Константы.CRM_СрокПоставки.Получить();
		ОбКП.Клиент			= ТекущийКлиент;
		ОбКП.РабочийЛист	= ТекущийРабочийЛист;
		ОбКП.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		ОбКП.ЗаявкаНаТрейдИн = СоздатьНайтиЗаявкуНаТрейдИн();
		обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
		ОбКП.ЗаявкаНаКредит = СоздатьНайтиЗаявкуНаКредит();
		ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
		ОбКП.ЗаявкаНаОборудование = СоздатьНайтиЗаявкуНаОборудование();
		обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
		Обкп.ИнтересовалсяСтраховкой = ИнтересовалсяСтраховкой;
		ОбКП.ЗаявкаНаСтраховку = СоздатьНайтиЗаявкуНаСтраховку();
		ОбКП.Записать();
		
		ТекущееКП = ОбКП.Ссылка;
		
	Иначе
		
		ОбКП = ТекущееКП.ПолучитьОбъект();
		
	КонецЕсли;
	
	СтрКонф = ОбКП.Состав.Найти(Элементы.СоставКП.ТекущаяСтрока, "Конфигурация");
	СтрКонф.Конфигурация = Конфигурация;
	СтрКонф.Сумма = ЦенаИТОГО;
	СтрКонф.СуммаДоставки = СуммаДоставки;
	СтрКонф.СуммаСкидки = СуммаСкидки;
	
	НомерКП = ОбКП.Номер;
	ДатаКП = ОбКП.Дата;
	
	ОбКП.Сумма = ОбКП.Состав.Итог("Сумма");
	ОбКП.ЗаявкаНаТрейдИн = СоздатьНайтиЗаявкуНаТрейдИн();
	обКП.ИнтересовалсяТрейдИн = ИнтересовалсяТрейдИн;
	ОбКП.ЗаявкаНаКредит = СоздатьНайтиЗаявкуНаКредит();
	ОбКП.ЗаявкаНаГарантию = СоздатьНайтиЗаявкуНаГарантию();
	обКП.ИнтересовалсяКредитом = ИнтересовалсяКредитом;
	ОбКП.ЗаявкаНаОборудование = СоздатьНайтиЗаявкуНаОборудование();
	Обкп.ИнтересовалсяСтраховкой = ИнтересовалсяСтраховкой;
	ОбКП.ЗаявкаНаСтраховку = СоздатьНайтиЗаявкуНаСтраховку();
	ОбКП.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

