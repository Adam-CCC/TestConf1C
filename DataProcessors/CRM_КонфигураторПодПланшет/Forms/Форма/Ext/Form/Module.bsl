&НаКлиенте
Процедура ВыбранноеОборудованиеПриИзменении(Элемент)
		
	ТекДанные = Элементы.ВыбранноеОборудование.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		
		Если ТекДанные.Количество = 0 Тогда
			ТекДанные.Количество = 1
		КонецЕсли;
		ТекДанные.Сумма = ТекДанные.Количество * ТекДанные.Цена;
		
	КонецЕсли;
	
	ПересчитатьЦенуАвто();
	
КонецПроцедуры

