&НаКлиенте
Процедура ПересчитатьЦенуАвто()
	
	ЦенаДопОпций = 0;
	Для Каждого ДопОпция Из ВыбранныеНебазовыеОпции Цикл
		ЦенаДопОпций = ЦенаДопОпций + ?(ДопОпция.Выбран, ДопОпция.Цена, 0);
	КонецЦикла;
	
	ЦенаОборудования = ВыбранноеОборудование.Итог("Сумма");
	ЦенаАвторабот = ВыбранныеАвтоработы.Итог("Сумма");
	ПересчитатьСкидки();
	ПересчитатьСуммуКредита();
	ЦенаИТОГО = ЦенаВариантаКомплектации + ЦенаДопОпций - ТрейдИнСумма + СуммаДоставки + ЦенаОборудования + ЦенаАвторабот + СтраховкаСумма + ГарантияСумма - СуммаСкидки;
	Если Не(ЦенаРОП = 0) Тогда
		Если УстановитьРасчетнуюПоЦенеРоп Тогда
			НаценкаРОП = ЦенаРОП - (ЦенаИТОГО - ЦенаОборудования - ЦенаАвторабот); //временно
			Если НаценкаРОП > 0 Тогда
				СуммаДоставки = СуммаДоставки + НаценкаРОП;	
				ЦенаИТОГО = ЦенаВариантаКомплектации + ЦенаДопОпций - ТрейдИнСумма + СуммаДоставки + ЦенаОборудования + ЦенаАвторабот + СтраховкаСумма + ГарантияСумма - СуммаСкидки;
			ИначеЕсли НаценкаРОП < 0 Тогда
				СуммаСкидки = - НаценкаРОП;	
				ЦенаИТОГО = ЦенаВариантаКомплектации + ЦенаДопОпций - ТрейдИнСумма + СуммаДоставки + ЦенаОборудования + ЦенаАвторабот + СтраховкаСумма + ГарантияСумма - СуммаСкидки;	
			КонецЕсли;
		Иначе		
			//Не меняем			
		КонецЕсли;
	КонецЕсли;
	
	ПересчитатьСкидки();
	
	ОбновитьНадписьЦена();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьЦена()
	
	НадписьЦена =  
	"Комплектация: " + Строка(ЦенаВариантаКомплектации) + Символы.ПС +
	"Опции:        " + Строка(ЦенаДопОпций) + Символы.ПС +
	"Оборудование: " + Строка(ЦенаОборудования) + Символы.ПС +
	"Автоработы:   " + Строка(ЦенаАвторабот) + Символы.ПС +
	"Доставка:     " + Строка(СуммаДоставки) + Символы.ПС +
	"Трейд-ин:     " + Строка(ТрейдИнСумма) + Символы.ПС +
	"Пр.гарантия:  " + Строка(ГарантияСумма) + Символы.ПС +
	"Страховка:    " + Строка(СтраховкаСумма) + Символы.ПС +
	?(СуммаСкидки > 0,	"СКИДКА:       " + Строка(СуммаСкидки) + Символы.ПС, "") +
	"--------------------------" + Символы.ПС +
	"ИТОГО:        " + Строка(ЦенаИТОГО) + " р.";
	
	НадписьРасчетнаяЦена = "Расчетная цена " + Строка(ЦенаИтого) + " р.";
	НадписьЦенаРуководителя = "Цена руководителя " + Строка(ЦенаРОП) + " р.";
	
	Элементы.ГруппаЦена.Заголовок = НадписьРасчетнаяЦена;
	Элементы.ДекорацияЦенаРОП.Заголовок = НадписьЦенаРуководителя;
	Элементы.ДекорацияЦенаРОП.Видимость = ЗначениеЗаполнено(ЦенаРОП);
	Элементы.УстановитьРасчетнуюПоЦенеРоп.Видимость = ЗначениеЗаполнено(ЦенаРОП);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуКредита()
	
	Возврат;
	
	СуммаКредита = ЦенаВариантаКомплектации - ТрейдИнСумма + СуммаДоставки;
	Если ДопОборудованиеВКредит Тогда
		СуммаКредита = СуммаКредита + ЦенаДопОпций + ЦенаОборудования + ЦенаАксессуаров;
	КонецЕсли;
	Если ВключитьСтраховкуВКредит Тогда
		СуммаКредита = СуммаКредита + СтраховкаСумма
	КонецЕсли;
	Если ВключитьПродленнуюГарантиюВКредит Тогда
		СуммаКредита = СуммаКредита + ГарантияСумма;
	КонецЕсли;
	Если УчитыватьСкидкуПриРасчетеСуммыКредита Тогда
		СуммаКредита = СуммаКредита - СуммаСкидки;
	КонецЕсли;
	ПересчитатьКредит();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиОборудованияАксессуаров()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
	Запрос.УстановитьПараметр("УжеВыбрано", ВыбранныеНебазовыеОпции.Выгрузить());
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", Версия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УжеВыбрано.Выбран,
	|	УжеВыбрано.Опция
	|ПОМЕСТИТЬ ВТ_УжеВыбрано
	|ИЗ
	|	&УжеВыбрано КАК УжеВыбрано
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_ТарифНаОпцииАвтомобилей.Опция КАК ОпцияСпр,
	|	Renault_ТарифНаОпцииАвтомобилей.НаименованиеОпции КАК НаименованиеОпции,
	|	Renault_ТарифНаОпцииАвтомобилей.ЦенаКлиентская,
	|	Renault_ТарифНаОпцииАвтомобилей.Опция.Артикул КАК КодОпции
	|ПОМЕСТИТЬ ВТ_Опции
	|ИЗ
	|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних КАК Renault_ТарифНаОпцииАвтомобилей
	|ГДЕ
	|	Renault_ТарифНаОпцииАвтомобилей.Тариф = &Тариф
	|	И Renault_ТарифНаОпцииАвтомобилей.Базовая = ЛОЖЬ
	|	И Renault_ТарифНаОпцииАвтомобилей.Модель = &Модель
	|	И Renault_ТарифНаОпцииАвтомобилей.ВариантКомплектации = &ВариантКомплектации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Опции.ОпцияСпр КАК Опция,
	|	ВТ_Опции.НаименованиеОпции КАК НаименованиеОпции,
	|	ВТ_Опции.ЦенаКлиентская КАК Цена,
	|	ЕСТЬNULL(ВТ_УжеВыбрано.Выбран, ЛОЖЬ) КАК Выбран,
	|	ВТ_Опции.КодОпции КАК КодОпции
	|ИЗ
	|	ВТ_Опции КАК ВТ_Опции
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УжеВыбрано КАК ВТ_УжеВыбрано
	|		ПО ВТ_Опции.ОпцияСпр = ВТ_УжеВыбрано.Опция";
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ВыбранныеНебазовыеОпции.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Модель.Пустая() Тогда
		Предупреждение("Не выбрана модель", 30);
		Возврат;
	КонецЕсли;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Если Диалог.Выбрать() Тогда
		Попытка
			Картинка = Новый Картинка(Диалог.ПолноеИмяФайла);
			ЗаписатьКартинку(Картинка)
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКартинку(Картинка)
	
	//Удалим старую картинку
	МенеджерИдент = РегистрыСведений.CRM_ИдентификаторыКартинок.СоздатьМенеджерЗаписи();
	МенеджерИдент.Модель = Модель;
	МенеджерИдент.ВариантКомплектации = Версия;
	МенеджерИдент.Цвет = Цвет;
	МенеджерИдент.Прочитать();
	Если МенеджерИдент.Выбран() Тогда
		МенеджерКартинки = РегистрыСведений.КартинкиИФайлы.СоздатьМенеджерЗаписи();
		МенеджерКартинки.Объект = Модель;
		МенеджерКартинки.Идентификатор = МенеджерИдент.Идентификатор;
		МенеджерКартинки.Удалить();
	КонецЕсли;
	МенеджерИдент.Модель = Модель;
	МенеджерИдент.ВариантКомплектации = Версия;
	МенеджерИдент.Цвет = Цвет;
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	МенеджерИдент.Идентификатор = Идентификатор;
	МенеджерИдент.Записать(Истина);
	
	МенеджерКартинки = РегистрыСведений.КартинкиИФайлы.СоздатьМенеджерЗаписи();
	МенеджерКартинки.Объект = Модель;
	МенеджерКартинки.Идентификатор = Идентификатор;
	МенеджерКартинки.Данные = Новый ХранилищеЗначения(Картинка);
	МенеджерКартинки.Записать(Истина);
	КлючЗаписиРег = РегистрыСведений.КартинкиИФайлы.СоздатьКлючЗаписи(Новый Структура("Объект,Идентификатор", Модель, Идентификатор)); 
	Если НЕ КлючЗаписиРег.Пустой() Тогда
		АдресКартинки = ПолучитьНавигационнуюСсылку(КлючЗаписиРег, "Данные")
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьКартинкуСервер()
	
	АдресКартинки = "";
	МенеджерИдент = РегистрыСведений.CRM_ИдентификаторыКартинок.СоздатьМенеджерЗаписи();
	МенеджерИдент.Модель = Модель;
	МенеджерИдент.ВариантКомплектации = Версия;
	МенеджерИдент.Цвет = Цвет;
	МенеджерИдент.Прочитать();
	Если МенеджерИдент.Выбран() Тогда
		МенеджерКартинки = РегистрыСведений.КартинкиИФайлы.СоздатьМенеджерЗаписи();
		МенеджерКартинки.Объект = Модель;
		МенеджерКартинки.Идентификатор = МенеджерИдент.Идентификатор;
		МенеджерКартинки.Удалить();
		МенеджерИдент.Удалить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКПНажатие(Команда)
	
	Если Не ЗначениеЗаполнено(Версия) ИЛИ Не ЗначениеЗаполнено(Цвет) Тогда
		Предупреждение("Не указана версия или цвет автомобиля");
		Возврат;
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Истина;
	
	ТекущаяКонфигурация = ЗаписатьКонфигурацию(Истина);
	
	Если ЗначениеЗаполнено(ТекущаяКонфигурация) Тогда
		
		ТекущееКП = Документы.CRM_КоммерческоеПредложение.ПустаяСсылка();
		ДобавитьКП(ТекущаяКонфигурация);
		Элементы.СписокКП.Обновить();
		Элементы.СписокКП.ТекущаяСтрока = ТекущееКП;
		
		ОткрытьСтраницуСоставКП();
		
		ОбновитьВидимостьЭлементов();
		ОбновитьЗаголовки();
		
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
	Печать(ТекущееКП);
	
	Оповестить("ОбновитьРабочийЛист");
	
КонецПроцедуры

