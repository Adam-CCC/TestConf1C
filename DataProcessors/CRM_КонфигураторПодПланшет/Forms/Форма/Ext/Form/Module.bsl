	ЗначениеПустое = Ложь;
	Если ЗначениеЗаполнено(ЗаявкаНаГарантию) Тогда
		ДокОб = ЗаявкаНаГарантию.Ссылка.ПолучитьОбъект();
	ИначеЕсли  ЗначениеЗаполнено(ПродленнаяГарантия)Или ЗначениеЗаполнено(ГарантияСумма) Тогда
		ДокОб = Документы.Renault_CRM_ЗаявкаНаГарантию.СоздатьДокумент();
	Иначе
		ДокОб = Документы.Renault_CRM_ЗаявкаНаГарантию.ПустаяСсылка();
		ЗначениеПустое = Истина;
	КонецЕсли;
	
	Если Не(ЗначениеПустое) И (не(ДокОб = неопределено)) Тогда
		МожноСохранить = Ложь;
