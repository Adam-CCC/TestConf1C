//#Область ОбработчикиСобытийЭлементаФормыТабличныйДокумент

&НаКлиенте
Процедура ТабличныйДокументВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Область.Расшифровка) И ТипЗнч(Область.Расшифровка) = Тип("СправочникСсылка.DMS_СтатусыМакетовРекламнойКампании") Тогда  
		
		НомерСтроки  = Число(СтрЗаменить(Лев(Область.Имя,Найти(Область.Имя,"C")-1),"R",""));
		мКампания = ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧЦ=10; ЧГ=")+"C3:R"+Формат(НомерСтроки,"ЧЦ=10; ЧГ=")+"C3").Расшифровка;
		
		Если ТипЗнч(мКампания) = Тип("ДокументСсылка.DMS_РекламнаяКампания") 
			И Область.Расшифровка = ПредопределенноеЗначение("Справочник.DMS_СтатусыМакетовРекламнойКампании.БезМакета") Тогда
			
			ПараметрыФормы = Новый Структура("Ключ",мКампания);
			ОткрытьФорму("Документ.DMS_РекламнаяКампания.Форма.ФормаПомощникСоздания",ПараметрыФормы,ЭтаФорма);
			
			СтандартнаяОбработка = Ложь;
			
		ИначеЕсли ТипЗнч(мКампания) = Тип("ДокументСсылка.DMS_РекламнаяКампания") Тогда  
			
			ПараметрыФормы = Новый Структура("Отбор",Новый Структура("РекламнаяКампания",мКампания));
			ОткрытьФорму("Справочник.DMS_МакетыРекламнойКампании.ФормаСписка",ПараметрыФормы,ЭтаФорма);
			
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли; 
		
	ИначеЕсли ЗначениеЗаполнено(Область.Расшифровка) И ТипЗнч(Область.Расшифровка) = Тип("СправочникСсылка.DMS_СтатусыОтчетовПоРекламнойКампании") Тогда  
		
		НомерСтроки  = Число(СтрЗаменить(Лев(Область.Имя,Найти(Область.Имя,"C")-1),"R",""))-1;
		мКампания = ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧЦ=10; ЧГ=")+"C3:R"+Формат(НомерСтроки,"ЧЦ=10; ЧГ=")+"C3").Расшифровка;
		
		Если ТипЗнч(мКампания) = Тип("ДокументСсылка.DMS_РекламнаяКампания") 
			И Область.Расшифровка = ПредопределенноеЗначение("Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.БезОтчета") Тогда
			
			ПараметрыФормы = Новый Структура("Ключ",мКампания);
			ОткрытьФорму("Документ.DMS_РекламнаяКампания.Форма.ФормаПомощникСоздания",ПараметрыФормы,ЭтаФорма);
			
			СтандартнаяОбработка = Ложь;
			
		ИначеЕсли ТипЗнч(мКампания) = Тип("ДокументСсылка.DMS_РекламнаяКампания") Тогда  
			
			ПараметрыФормы = Новый Структура("Отбор",Новый Структура("РекламнаяКампания",мКампания));
			ОткрытьФорму("Документ.DMS_ОтчетПоРекламнойКампании.ФормаСписка",ПараметрыФормы,ЭтаФорма);
			
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли; 
		
	ИначеЕсли ЗначениеЗаполнено(Область.Расшифровка) И ТипЗнч(Область.Расшифровка) = Тип("ДокументСсылка.DMS_РекламнаяКампания") Тогда  
		
		ПараметрыФормы = Новый Структура("Ключ",Область.Расшифровка);
		ОткрытьФорму("Документ.DMS_РекламнаяКампания.Форма.ФормаПомощникСоздания",ПараметрыФормы,ЭтаФорма);
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставительПриИзменении(Элемент)
	СформироватьОтчет();
КонецПроцедуры

&НаКлиенте
Процедура ГодСтрокаПриИзменении(Элемент)
	
	ВыбранныйГод = СокрЛП(СтрЗаменить(ГодСтрока," год",""));
	
	СтрокаГода = ВыбранныйГод+"0101";
	
	Год = Дата(СтрокаГода);
	
	Если ФинансовыйГод Тогда
		ДатаНачала 	  = Дата(ВыбранныйГод+"0401");
		ДатаОкончания = ДобавитьМесяц(ДатаНачала,11);
		Квартал 	  = ДатаНачала;
	Иначе 
		ДатаНачала    = Год;
		ДатаОкончания = КонецГода(Год);
		Квартал 	  = НачалоГода(Год);
	КонецЕсли; 
	
	КварталСтрока = "ВесьГод";
	
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура КварталСтрокаПриИзменении(Элемент)
	
	НачалоФинансовогоГода = Формат(Год,"ДФ=yyyy")+"0401";
	
	ГодФинансовый = Дата(НачалоФинансовогоГода);
	
	Если КварталСтрока = "ВесьГод" Тогда
		
		Если ФинансовыйГод Тогда
			
			ДатаНачала    = НачалоГода(ГодФинансовый);
			ДатаОкончания = КонецГода(ГодФинансовый);
			Квартал 	  = ГодФинансовый;
			
			СтрокаКвартала = Формат(ДатаНачала,"ДФ=yyyyMMdd");
			
		Иначе 
			
			ДатаНачала    = НачалоГода(Год);
			ДатаОкончания = КонецГода(Год);
			Квартал 	  = ДатаНачала;
			
		КонецЕсли; 
		
		Элементы.МесяцСтрока.Видимость = Ложь;
		
		СформироватьЗаКвартал = Ложь;
		СформироватьЗаМесяц   = Ложь;
		
	ИначеЕсли КварталСтрока = "ПервыйКвартал" Тогда 
		
		Если ФинансовыйГод Тогда
			
			ДатаНачала    = ГодФинансовый;
			ДатаОкончания = ДобавитьМесяц(ДатаНачала,2);
			Квартал 	  = ДатаНачала;
			
			СтрокаКвартала = Формат(ДатаНачала,"ДФ=yyyyMMdd");
			
		Иначе 
			
			ДатаНачала     = НачалоГода(Год);
			СтрокаКвартала = Формат(Год,"ДФ=yyyy")+"0101";
			ДатаОкончания  = КонецКвартала(Дата(СтрокаКвартала));
			Квартал = Дата(СтрокаКвартала);
			
		КонецЕсли; 
		
		Элементы.МесяцСтрока.Видимость = ФинансовыйГод;
		ЗаполнитьМесяц(Дата(СтрокаКвартала));
		
		СформироватьЗаКвартал = Истина;
		
	ИначеЕсли КварталСтрока = "ВторойКвартал" Тогда 
		
		Если ФинансовыйГод Тогда
			
			ДатаНачала    = ДобавитьМесяц(ГодФинансовый,3);
			ДатаОкончания = ДобавитьМесяц(ДатаНачала,2);
			Квартал 	  = ДатаНачала;
			
			СтрокаКвартала = Формат(ДатаНачала,"ДФ=yyyyMMdd");
			
		Иначе 
			
			СтрокаКвартала = Формат(Год,"ДФ=yyyy")+"0401";
			
			ДатаНачала     = НачалоКвартала(Дата(СтрокаКвартала));
			ДатаОкончания  = КонецКвартала(Дата(СтрокаКвартала));
			Квартал 	   = Дата(СтрокаКвартала);
			
		КонецЕсли; 
		
		Элементы.МесяцСтрока.Видимость = ФинансовыйГод;
		ЗаполнитьМесяц(Дата(СтрокаКвартала));
		
		СформироватьЗаКвартал = Истина;
		
	ИначеЕсли КварталСтрока = "ТретийКвартал" Тогда 
		
		Если ФинансовыйГод Тогда
			
			ДатаНачала    = ДобавитьМесяц(ГодФинансовый,6);
			ДатаОкончания = ДобавитьМесяц(ДатаНачала,2);
			Квартал 	  = ДатаНачала;
			
			СтрокаКвартала = Формат(ДатаНачала,"ДФ=yyyyMMdd");
			
		Иначе 
			
			СтрокаКвартала = Формат(Год,"ДФ=yyyy")+"0701";
			
			ДатаНачала     = НачалоКвартала(Дата(СтрокаКвартала));
			ДатаОкончания  = КонецКвартала(Дата(СтрокаКвартала));
			Квартал 	   = Дата(СтрокаКвартала);
			
		КонецЕсли; 
		
		Элементы.МесяцСтрока.Видимость = ФинансовыйГод;
		ЗаполнитьМесяц(Дата(СтрокаКвартала));
		
		СформироватьЗаКвартал = Истина;
		
	ИначеЕсли КварталСтрока = "ЧетвертыйКвартал" Тогда 
		
		Если ФинансовыйГод Тогда
			
			ДатаНачала    = ДобавитьМесяц(ГодФинансовый,9);
			ДатаОкончания = ДобавитьМесяц(ДатаНачала,2);
			Квартал 	  = ДатаНачала;
			
			СтрокаКвартала = Формат(ДатаНачала,"ДФ=yyyyMMdd");
			
		Иначе 
			
			СтрокаКвартала = Формат(Год,"ДФ=yyyy")+"1001";
			
			ДатаНачала     = НачалоКвартала(Дата(СтрокаКвартала));
			ДатаОкончания  = КонецКвартала(Дата(СтрокаКвартала));
			Квартал 	   = Дата(СтрокаКвартала);
			
		КонецЕсли; 
		
		Элементы.МесяцСтрока.Видимость = ФинансовыйГод;
		ЗаполнитьМесяц(Дата(СтрокаКвартала));
		
		СформироватьЗаКвартал = Истина;
		
	КонецЕсли;		
	
	СформироватьОтчет();
	
КонецПроцедуры

