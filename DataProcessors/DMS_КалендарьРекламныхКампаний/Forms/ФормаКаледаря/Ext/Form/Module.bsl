	ВидОтчета = ИмяМакета;
	ЦветТекстаОформления = Новый Цвет(62,79,145);
	
	СформироватьОтчет();
	
	Элементы.ФормаКалендарьКампаний.Пометка 			 = Истина;
	Элементы.ФормаКалендарьКампанийБезОформления.Пометка = Ложь;
	Элементы.ФормаКалендарьКампанийЗеленый.Пометка 		 = Ложь;
	Элементы.ФормаКалендарьКампанийЯркий.Пометка 		 = Ложь;
	
КонецПроцедуры

