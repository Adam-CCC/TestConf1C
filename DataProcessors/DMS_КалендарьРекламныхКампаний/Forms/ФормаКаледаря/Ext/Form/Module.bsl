&НаКлиенте
Процедура ФинансовыйГодПриИзменении(Элемент)
	
	Если ФинансовыйГод Тогда
		
		ПериодФинансовогоПериода = ПолучитьФинансовыйГод(Год);
		
		ДатаНачала 	  = ПериодФинансовогоПериода.ДатаНачала;
		ДатаОкончания = ПериодФинансовогоПериода.ДатаОкончания;
		
		СформироватьЗаКвартал = Ложь;
		СформироватьЗаМесяц = Ложь;
		
	Иначе 
		
		ДатаНачала 	  = НачалоГода(Год);
		ДатаОкончания = КонецГода(Год);
		
		СформироватьЗаКвартал 		   = Ложь;
		СформироватьЗаМесяц 		   = Ложь;
		Элементы.МесяцСтрока.Видимость = Ложь;
		
	КонецЕсли;
	
	КварталСтрока = "ВесьГод";
	
	Квартал = ДатаНачала;
	
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура ПланФактДельтаПриИзменении(Элемент)
	СформироватьОтчет();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМесяц(НачалоКвартала)
	
	МесяцСтрока = "ВесьКвартал";
	
	Элементы.МесяцСтрока.СписокВыбора.Очистить();
	
	Элементы.МесяцСтрока.СписокВыбора.Добавить(0,"Весь квартал");	
	Элементы.МесяцСтрока.СписокВыбора.Добавить(Месяц(НачалоКвартала),Формат(НачалоКвартала,"ДФ=MMMM"));	
	Элементы.МесяцСтрока.СписокВыбора.Добавить(Месяц(ДобавитьМесяц(НачалоКвартала,1)),Формат(ДобавитьМесяц(НачалоКвартала,1),"ДФ=MMMM"));	
	Элементы.МесяцСтрока.СписокВыбора.Добавить(Месяц(ДобавитьМесяц(НачалоКвартала,2)),Формат(ДобавитьМесяц(НачалоКвартала,2),"ДФ=MMMM"));	
	
КонецПроцедуры // ЗаполнитьМесяц()

&НаКлиенте
Процедура МесяцСтрокаПриИзменении(Элемент)
	
	Если МесяцСтрока = 0 Тогда
		
		ПериодФинансовогоПериода = ПолучитьФинансовыйГод(Год);
		
		ДатаНачала 	  = ПериодФинансовогоПериода.ДатаНачала;
		ДатаОкончания = ПериодФинансовогоПериода.ДатаОкончания;
		
		СформироватьЗаМесяц = Ложь;
		
		КварталСтрокаПриИзменении(Неопределено);
		
		Возврат;
		
	Иначе 
		
		Если МесяцСтрока >= 1 И МесяцСтрока <= 3 Тогда
			
			мДатаСтрокой = Формат(ДобавитьМесяц(Год,12),"ДФ=yyyy")+Формат(МесяцСтрока,"ЧЦ=2; ЧВН=; ЧГ=")+"01";
			
			ДатаНачала	  = НачалоМесяца(мДатаСтрокой);
			ДатаОкончания = КонецМесяца(мДатаСтрокой);
			
		Иначе 
			
			мДатаСтрокой = Формат(Год,"ДФ=yyyy")+Формат(МесяцСтрока,"ЧЦ=2; ЧВН=; ЧГ=")+"01";
			
			ДатаНачала	  = НачалоМесяца(мДатаСтрокой);
			ДатаОкончания = КонецМесяца(мДатаСтрокой);
			
		КонецЕсли; 
		
		СформироватьЗаМесяц = Истина;
		
	КонецЕсли; 
	
	СформироватьОтчет();
	
КонецПроцедуры

&НаКлиенте
Процедура Отбор(Команда)
	
	Элементы.ФормаОтбор.Пометка    = Не Элементы.ФормаОтбор.Пометка;
	
	Элементы.ФормаОтбор.Заголовок = ?(Элементы.ФормаОтбор.Пометка,"Скрыть отбор","Установить отбор");
	
	Элементы.ГруппаШапка.Видимость = Элементы.ФормаОтбор.Пометка;
	
КонецПроцедуры

//#КонецОбласти

//#Область ФормированиеОтчета

&НаСервере
Процедура СформироватьОтчет()
	
	Если СформироватьЗаМесяц Тогда
		СформироватьОтчетЗаМесяцНаСервере();
	ИначеЕсли СформироватьЗаКвартал Тогда
		СформироватьОтчетЗаКварталНаСервере();
	Иначе 
		СформироватьОтчетЗаГодНаСервере();
	КонецЕсли;	
	
КонецПроцедуры // СформироватьОтчет()

&НаСервере
Функция ПолучитьПараметрыЗапроса(ЭтоВыгрузка = Ложь)
	
	ПараметрыЗапроса = Новый Структура;
	
	Если ЭтоВыгрузка Тогда	
		
		ПараметрыГраницы = Новый Массив(2);
		ПараметрыГраницы[0] = КонецДня(ДатаОкончанияВыгрузки);
		ПараметрыГраницы[1] = ВидГраницы.Включая;
		ГраницаОкочания = Новый(Тип("Граница"),ПараметрыГраницы);	
		
		ПараметрыЗапроса.Вставить("ДатаНачала", 		  ДатаНачалаВыгрузки); 
		ПараметрыЗапроса.Вставить("ДатаОкончанияВывода",  ДатаОкончанияВыгрузки);
		ПараметрыЗапроса.Вставить("ДатаОкончания",  	  ГраницаОкочания);
		ПараметрыЗапроса.Вставить("РекламнаяКампания",    Документы.DMS_РекламнаяКампания.ПустаяСсылка());
		ПараметрыЗапроса.Вставить("ДилерскийЦентр",       Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка());
		ПараметрыЗапроса.Вставить("Модель",  			  Справочники.Модели.ПустаяСсылка());
		ПараметрыЗапроса.Вставить("МедиаРесурс",  		  Справочники.DMS_МедиаРесурсы.ПустаяСсылка());
		ПараметрыЗапроса.Вставить("ТипРазмещения",  	  Перечисления.DMS_ТипыРазмещенияМедиа.ПустаяСсылка());
		ПараметрыЗапроса.Вставить("ВидРекламы", 		  0);
		ПараметрыЗапроса.Вставить("ПланФактДельта", 	  0);
		ПараметрыЗапроса.Вставить("Представитель", 		  Справочники.DMS_Представители.ПустаяСсылка());
		
	Иначе 
		
		ПараметрыГраницы = Новый Массив(2);
		ПараметрыГраницы[0] = КонецДня(ДатаОкончания);
		ПараметрыГраницы[1] = ВидГраницы.Включая;
		ГраницаОкочания = Новый(Тип("Граница"),ПараметрыГраницы);	
		
		ПараметрыЗапроса.Вставить("ДатаНачала", 		  ДатаНачала); 
		ПараметрыЗапроса.Вставить("ДатаОкончанияВывода",  ДатаОкончания);
		ПараметрыЗапроса.Вставить("ДатаОкончания",  	  ГраницаОкочания);
		ПараметрыЗапроса.Вставить("РекламнаяКампания",    РекламнаяКампания);
		ПараметрыЗапроса.Вставить("ДилерскийЦентр",       ДилерскийЦентр);
		ПараметрыЗапроса.Вставить("Модель",  			  Модель);
		ПараметрыЗапроса.Вставить("МедиаРесурс",  		  ТипМедиа);
		ПараметрыЗапроса.Вставить("ТипРазмещения",  	  ТипРазмещенияКампании);
		ПараметрыЗапроса.Вставить("ВидРекламы", 		  ВидРекламы);
		ПараметрыЗапроса.Вставить("ПланФактДельта", 	  ПланФактДельта);
		ПараметрыЗапроса.Вставить("Представитель", 		  Представитель);
		
	КонецЕсли; 
		
	Возврат ПараметрыЗапроса;
	
КонецФункции // ПолучитьПараметрыЗапроса()

&НаСервере
Процедура СформироватьОтчетЗаГодНаСервере()
	
	ТабличныйДокумент.Очистить();
	
	Объект = РеквизитФормыВЗначение("ЭтаОбработка");
	Макет = Объект.ПолучитьМакет(СокрЛП(ВидОтчета));
	Объект = Неопределено;
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	
	ПакетЗапросов = СформироватьЗапрос(ПараметрыЗапроса);
	
	ВыборкаОбщий = ПакетЗапросов[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщий.Следующий();
	
	План_Данные   = ВыборкаОбщий.План;
	Факт_Данные   = ВыборкаОбщий.Факт;
	Дельта_Данные = ВыборкаОбщий.Дельта;
	
	ОбластьШапка 				   = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСтрокаРекламныхКампаний = Макет.ПолучитьОбласть("ОбластьСтрокаРекламныхКампаний");
	
	Если ФинансовыйГод Тогда
		ОбластьШапкаГод = Макет.ПолучитьОбласть("ОбластьШапкаФинансовыйГод");
	Иначе 	
		ОбластьШапкаГод = Макет.ПолучитьОбласть("ОбластьШапкаГод");
	КонецЕсли; 
	
	ОбластьКонтрагент = Макет.ПолучитьОбласть("ОбластьКонтрагент");
	
	ОбластьМедиаРесурсГод = Макет.ПолучитьОбласть("ОбластьМедиаРесурсГод");
	ОбластьИтогГод		  = Макет.ПолучитьОбласть("ОбластьИтогГод");	
	
	ОбластьЕстьМакетИОтчет  = Макет.ПолучитьОбласть("ОбластьЕстьМакетИОтчет");
	ОбластьНетМакетаИОтчета = Макет.ПолучитьОбласть("ОбластьНетМакетаИОтчета");
	
	ОбластьЧерта = Макет.ПолучитьОбласть("ОбластьЧерта");
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Если ФинансовыйГод Тогда
		ОбластьШапкаГод.Параметры.ДатаНачала    = ДатаНачала;
		ОбластьШапкаГод.Параметры.ДатаОкончания = ДатаОкончания;
	Иначе 
		ОбластьШапкаГод.Параметры.Год = Год;
	КонецЕсли;
	
	ТабличныйДокумент.Присоединить(ОбластьШапкаГод);
	
	ВыборкаДилерскихЦентров = ВыборкаОбщий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДилерскихЦентров.Следующий() Цикл
		
		ОбластьКонтрагент.Параметры.Заполнить(ВыборкаДилерскихЦентров);
		
		ТабличныйДокумент.Вывести(ОбластьКонтрагент);
		ТабличныйДокумент.НачатьГруппуСтрок();		
		
		ВыборкаМедиаРесурс = ВыборкаДилерскихЦентров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаМедиаРесурс.Следующий() Цикл
			
			ОбластьМедиаРесурсГод.Параметры.Заполнить(ВыборкаМедиаРесурс);
			ТабличныйДокумент.Вывести(ОбластьМедиаРесурсГод);
			ТабличныйДокумент.НачатьГруппуСтрок();
			
			ТабличныйДокумент.Вывести(ОбластьЧерта);
			
			ВыборкаКампании = ВыборкаМедиаРесурс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКампании.Следующий() Цикл
				
				ОбластьСтрокаРекламныхКампаний.Параметры.Заполнить(ВыборкаКампании);
				ОбластьСтрокаРекламныхКампаний.Параметры.ДатаНачала    = ВыборкаКампании.РекламнаяКампания.ДатаНачала;
				ОбластьСтрокаРекламныхКампаний.Параметры.ДатаОкончания = ВыборкаКампании.РекламнаяКампания.ДатаОкончания;
				ТабличныйДокумент.Вывести(ОбластьСтрокаРекламныхКампаний);
				
				мГод = Формат(Год,"ДФ=yyyy");
				
				МесяцЗаполнения = НачалоМесяца(ДатаНачала);
				
				Пока МесяцЗаполнения <= НачалоМесяца(ДатаОкончания) Цикл 
					
					Если МесяцЗаполнения >= НачалоМесяца(ВыборкаКампании.РекламнаяКампания.ДатаНачала) И МесяцЗаполнения <= НачалоМесяца(ВыборкаКампании.РекламнаяКампания.ДатаОкончания) Тогда
						ОбластьЕстьМакетИОтчет.Параметры.Заполнить(ВыборкаКампании);
						ТабличныйДокумент.Присоединить(ОбластьЕстьМакетИОтчет);
					Иначе 
						ТабличныйДокумент.Присоединить(ОбластьНетМакетаИОтчета);
					КонецЕсли;
					
					МесяцЗаполнения = ДобавитьМесяц(МесяцЗаполнения,1);
					
				КонецЦикла;  
				
				ТабличныйДокумент.Вывести(ОбластьЧерта);
				
			КонецЦикла; 
			
			ТабличныйДокумент.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьГруппуСтрок();
		
	КонецЦикла; 
	
	ВыборкаСтатусов = ПакетЗапросов[6].Выбрать();
	
	Пока ВыборкаСтатусов.Следующий() Цикл
		ОбъединитьЯчейкиПоСтатусам(ВыборкаСтатусов.Статус);
	КонецЦикла; 
	
	ОбластьИтогГод.Параметры.Заполнить(ВыборкаОбщий);
	
	ТабличныйДокумент.Вывести(ОбластьИтогГод);
	
	ТабличныйДокумент.Вывести(ОбластьЧерта);
	
	ВывестиОбозначенияСтатусов(Макет);
	
	ТабличныйДокумент.ФиксацияСверху = 2;
	//ТабличныйДокумент.ФиксацияСлева  = 4;
	ТабличныйДокумент.АвтоМасштаб    = Истина;
	
КонецПроцедуры // СформироватьОтчетЗаГодНаСервере()

&НаСервере
Процедура СформироватьОтчетЗаКварталНаСервере()
	
	ТабличныйДокумент.Очистить();
	
	Объект = РеквизитФормыВЗначение("ЭтаОбработка");
	Макет = Объект.ПолучитьМакет(СокрЛП(ВидОтчета));
	Объект = Неопределено;
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	
	ПакетЗапросов = СформироватьЗапрос(ПараметрыЗапроса);
	
	ВыборкаОбщий = ПакетЗапросов[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщий.Следующий();
	
	План_Данные   = ВыборкаОбщий.План;
	Факт_Данные   = ВыборкаОбщий.Факт;
	Дельта_Данные = ВыборкаОбщий.Дельта;
	
	//ВыборкаМедиаРесурс = ВыборкаОбщий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ОбластьШапкаВерх 			   = Макет.ПолучитьОбласть("ОбластьШапкаВерх");
	ОбластьШапка 				   = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСтрокаРекламныхКампаний = Макет.ПолучитьОбласть("ОбластьСтрокаРекламныхКампаний");
	ОбластьМесяц				   = Макет.ПолучитьОбласть("ОбластьМесяц");
	ОбластьНеделя				   = Макет.ПолучитьОбласть("ОбластьНеделя");
	ОбластьЧерта 				   = Макет.ПолучитьОбласть("ОбластьЧерта");
	ОбластьДопЧерта				   = Макет.ПолучитьОбласть("ОбластьДопЧерта");	
	ОбластьДопПоле 				   = Макет.ПолучитьОбласть("ОбластьДопПоле");
	
	СоответствиеКвартал.Очистить();
	
	мТекущийМесяц = ДатаНачала;
	
	МесяцНедели = НачалоМесяца(НачалоНедели(мТекущийМесяц));
	
	НачатьСоСледующейНедели = Ложь;	
	
	СписокНедель = Новый СписокЗначений;
	
	Если мТекущийМесяц <> МесяцНедели Тогда
		
		МассивНедель  = Новый Массив;
		мНачалоНедели = НачалоНедели(НачалоНедели(мТекущийМесяц));
		мКонецНедели  = КонецНедели(НачалоНедели(мТекущийМесяц));
		
		СписокНедель.Добавить(мНачалоНедели);
		
		МассивНедель.Добавить(Новый Структура("ДатаНачалаНедели,ДатаОкончанияНедели",мНачалоНедели,мКонецНедели));
		
		НоваяСтрока = СоответствиеКвартал.Добавить();
		НоваяСтрока.ТекущийМесяц = МесяцНедели;
		НоваяСтрока.Недели.ЗагрузитьЗначения(МассивНедель);
		
		НачатьСоСледующейНедели = Истина;
		
	КонецЕсли; 
	
	Пока мТекущийМесяц <= ДатаОкончания Цикл
		
		МассивНедель = Новый Массив;
		
		Если НачатьСоСледующейНедели Тогда
			мНачалоНедели = НачалоНедели(КонецНедели(мТекущийМесяц)+24*60*60);
			мКонецНедели  = КонецНедели(мНачалоНедели);
		Иначе 
			мНачалоНедели = НачалоНедели(мТекущийМесяц);
			мКонецНедели  = КонецНедели(мТекущийМесяц);
		КонецЕсли; 
		
		Пока мНачалоНедели <= КонецМесяца(мТекущийМесяц) Цикл
			
			СписокНедель.Добавить(мНачалоНедели);
			
			МассивНедель.Добавить(Новый Структура("ДатаНачалаНедели,ДатаОкончанияНедели",мНачалоНедели,мКонецНедели));
			
			мНачалоНедели = НачалоНедели(мКонецНедели+24*60*60);
			мКонецНедели  = КонецНедели(мНачалоНедели);
			
		КонецЦикла; 
		
		НоваяСтрока = СоответствиеКвартал.Добавить();
		НоваяСтрока.ТекущийМесяц = мТекущийМесяц;
		НоваяСтрока.Недели.ЗагрузитьЗначения(МассивНедель);
		
		мТекущийМесяц = ДобавитьМесяц(мТекущийМесяц,1);
		
	КонецЦикла; 
	
	ТабличныйДокумент.Вывести(ОбластьШапкаВерх);
	
	НачалоКолонки = 5;
	КонецКолонки  = 4;
	
	Для каждого ПараметрМесяца Из СоответствиеКвартал Цикл
		
		мТекущийМесяц = ПараметрМесяца.ТекущийМесяц;
		
		мНедели = ПараметрМесяца.Недели.ВыгрузитьЗначения();
		
		Для мНеделя = 1 По мНедели.Количество() Цикл
			
			ОбластьМесяц.Параметры.Месяц = мТекущийМесяц;
			ТабличныйДокумент.Присоединить(ОбластьМесяц);
			
		КонецЦикла; 
		
		КонецКолонки = КонецКолонки + ?(мНедели.Количество() = 1, 1, мНедели.Количество()-1);
		
		ОбластьЯчейки = ТабличныйДокумент.Область("R1C"+Формат(НачалоКолонки,"ЧЦ=10; ЧГ=")+":R1C"+Формат(КонецКолонки,"ЧЦ=10; ЧГ=")+"");
		ОбластьЯчейки.Объединить();
		
		КонецКолонки = КонецКолонки+1;
		
		НачалоКолонки = КонецКолонки;
		
	КонецЦикла; 
	
	ПерваяНеделя = Истина;
	
	Для каждого ПараметрМесяца Из СоответствиеКвартал Цикл
		
		мНедели = ПараметрМесяца.Недели.ВыгрузитьЗначения();
		
		Для каждого мНеделя Из мНедели Цикл
			
			Если ПерваяНеделя Тогда
				
				ТабличныйДокумент.Вывести(ОбластьШапка);
				
				ПерваяНеделя = Ложь;
				
			КонецЕсли; 
			
			ОбластьНеделя.Параметры.Заполнить(мНеделя); 
			ТабличныйДокумент.Присоединить(ОбластьНеделя);
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C1:R3C2");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Модель";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	                                  
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C3:R3C3");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Кампания";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C4:R3C4");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Затраты";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C5:R3C5");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Дата нач/кон акции";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьМедиаРесурсГод = Макет.ПолучитьОбласть("ОбластьМедиаРесурсГод");
	ОбластьИтогГод		  = Макет.ПолучитьОбласть("ОбластьИтогГод");	
	ОбластьКонтрагент	  = Макет.ПолучитьОбласть("ОбластьКонтрагент");
	
	ОбластьЕстьМакетИОтчет  = Макет.ПолучитьОбласть("ОбластьЕстьМакетИОтчет");
	ОбластьНетМакетаИОтчета = Макет.ПолучитьОбласть("ОбластьНетМакетаИОтчета");
	
	СписокНедель.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
	ВыборкаДилерскихЦентров = ВыборкаОбщий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДилерскихЦентров.Следующий() Цикл
		
		ОбластьКонтрагент.Параметры.Заполнить(ВыборкаДилерскихЦентров);
		ОбластьКонтрагент.Области.ОбластьКонтрагент.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		ОбластьКонтрагент.Области.ОбластьКонтрагент.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		
		ТабличныйДокумент.Вывести(ОбластьКонтрагент);
		ТабличныйДокумент.НачатьГруппуСтрок();		
		
		Для А = 13 По СписокНедель.Количество() Цикл
			
			ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			
			Если А = СписокНедель.Количество() Тогда
				ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
			КонецЕсли; 
			
			ТабличныйДокумент.Присоединить(ОбластьДопПоле);
			
		КонецЦикла; 
		
		ТабличныйДокумент.Вывести(ОбластьЧерта);
		
		Для А = 13 По СписокНедель.Количество() Цикл
			ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
		КонецЦикла; 
		
		ВыборкаМедиаРесурс = ВыборкаДилерскихЦентров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаМедиаРесурс.Следующий() Цикл
			
			ОбластьМедиаРесурсГод.Области.ОбластьМедиаРесурсГод.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ОбластьМедиаРесурсГод.Области.ОбластьМедиаРесурсГод.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ОбластьМедиаРесурсГод.Параметры.Заполнить(ВыборкаМедиаРесурс);
			
			ТабличныйДокумент.Вывести(ОбластьМедиаРесурсГод);
			
			Для А = 13 По СписокНедель.Количество() Цикл
				
				ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
				ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
				
				Если А = СписокНедель.Количество() Тогда
					ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
				КонецЕсли; 
				
				ТабличныйДокумент.Присоединить(ОбластьДопПоле);
				
			КонецЦикла; 
			
			ТабличныйДокумент.НачатьГруппуСтрок();
			
			ТабличныйДокумент.Вывести(ОбластьЧерта);
			
			Для А = 13 По СписокНедель.Количество() Цикл
				ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
			КонецЦикла; 
			
			ВыборкаКампании = ВыборкаМедиаРесурс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКампании.Следующий() Цикл
				
				ОбластьСтрокаРекламныхКампаний.Параметры.Заполнить(ВыборкаКампании);
				ОбластьСтрокаРекламныхКампаний.Параметры.ДатаНачала    = ВыборкаКампании.РекламнаяКампания.ДатаНачала;
				ОбластьСтрокаРекламныхКампаний.Параметры.ДатаОкончания = ВыборкаКампании.РекламнаяКампания.ДатаОкончания;
				ТабличныйДокумент.Вывести(ОбластьСтрокаРекламныхКампаний);
				
				Для каждого ЗначениеСписка Из СписокНедель Цикл
					
					мНеделя = ЗначениеСписка.Значение;
					
					Если мНеделя >= НачалоНедели(ВыборкаКампании.РекламнаяКампания.ДатаНачала) И мНеделя <= НачалоНедели(ВыборкаКампании.РекламнаяКампания.ДатаОкончания) Тогда
						ОбластьЕстьМакетИОтчет.Параметры.Заполнить(ВыборкаКампании);
						ТабличныйДокумент.Присоединить(ОбластьЕстьМакетИОтчет);
					Иначе 
						ТабличныйДокумент.Присоединить(ОбластьНетМакетаИОтчета);
					КонецЕсли;
					
				КонецЦикла; 
				
				ТабличныйДокумент.Вывести(ОбластьЧерта);
				
				Для А = 13 По СписокНедель.Количество() Цикл
					ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
				КонецЦикла; 
				
			КонецЦикла; 
			
			ТабличныйДокумент.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ТабличныйДокумент.ЗакончитьГруппуСтрок();
		
	КонецЦикла;	
	
	ВыборкаСтатусов = ПакетЗапросов[6].Выбрать();
	
	Пока ВыборкаСтатусов.Следующий() Цикл
		ОбъединитьЯчейкиПоСтатусам(ВыборкаСтатусов.Статус);
	КонецЦикла; 
	
	ОбластьИтогГод.Параметры.Заполнить(ВыборкаОбщий);
	
	ОбластьИтогГод.Области.ОбластьИтогГод.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	ОбластьИтогГод.Области.ОбластьИтогГод.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	
	ТабличныйДокумент.Вывести(ОбластьИтогГод);
	
	Для А = 13 По СписокНедель.Количество() Цикл
		
		ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		
		Если А = СписокНедель.Количество() Тогда
			ОбластьДопПоле.Области.ОбластьДопПоле.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		КонецЕсли; 
		
		ТабличныйДокумент.Присоединить(ОбластьДопПоле);
		
	КонецЦикла; 
	
	ТабличныйДокумент.Вывести(ОбластьЧерта);
	
	Для А = 13 По СписокНедель.Количество() Цикл
		ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
	КонецЦикла; 
	
	ВывестиОбозначенияСтатусов(Макет);
	
	ТабличныйДокумент.ФиксацияСверху = 3;
	ТабличныйДокумент.ФиксацияСлева  = 4;
	ТабличныйДокумент.АвтоМасштаб    = Истина;
	
КонецПроцедуры // СформироватьОтчетНаКварталСервере()

&НаСервере
Процедура СформироватьОтчетЗаМесяцНаСервере()
	
	ТабличныйДокумент.Очистить();
	
	Объект = РеквизитФормыВЗначение("ЭтаОбработка");
	Макет = Объект.ПолучитьМакет(СокрЛП(ВидОтчета));
	Объект = Неопределено;
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса();
	
	ПакетЗапросов = СформироватьЗапрос(ПараметрыЗапроса);
	
	ВыборкаОбщий = ПакетЗапросов[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщий.Следующий();
	
	План_Данные   = ВыборкаОбщий.План;
	Факт_Данные   = ВыборкаОбщий.Факт;
	Дельта_Данные = ВыборкаОбщий.Дельта;
	
	ОбластьШапкаВерх 			   = Макет.ПолучитьОбласть("ОбластьШапкаВерх");
	ОбластьШапка 				   = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСтрокаРекламныхКампаний = Макет.ПолучитьОбласть("ОбластьСтрокаРекламныхКампаний");
	ОбластьМесяцГод				   = Макет.ПолучитьОбласть("ОбластьМесяцГод_День");
	ОбластьДень				  	   = Макет.ПолучитьОбласть("ОбластьДень");
	ОбластьЧерта 				   = Макет.ПолучитьОбласть("ОбластьЧерта");
	ОбластьДопЧерта				   = Макет.ПолучитьОбласть("ОбластьДопЧерта_День");	
	ОбластьДопПоле 				   = Макет.ПолучитьОбласть("ОбластьДопПоле_День");
	
	ТабличныйДокумент.Вывести(ОбластьШапкаВерх);
	
	НачалоКолонки = 5;
	КонецКолонки  = 4;
	
	КоличествоДней = ?(ПакетЗапросов[5].Пустой(),ПолучитьРазностьДат(ДатаНачала,ДатаОкончания),ВыборкаОбщий.КоличествоДней);
	
	Для мДень = 1 По КоличествоДней Цикл
		
		ОбластьМесяцГод.Параметры.Месяц = ДатаНачала;
		ОбластьМесяцГод.Области.ОбластьМесяцГод_День.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		ОбластьМесяцГод.Области.ОбластьМесяцГод_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		
		Если мДень = КоличествоДней Тогда
			ОбластьМесяцГод.Области.ОбластьМесяцГод_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		КонецЕсли; 
		
		ТабличныйДокумент.Присоединить(ОбластьМесяцГод);
		
	КонецЦикла; 
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C6:R1C"+Формат(КоличествоДней+5,"ЧЦ=10; ЧГ=")+"");
	ОбластьЯчейки.Объединить();
	
	ОбластьЯчейки.Текст = Формат(ДатаНачала,"ДФ='MMMM yyyy ''года'''");
	
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Для мДень = 1 По КоличествоДней Цикл
		
		ОбластьДень.Параметры.мДень = мДень;
		ТабличныйДокумент.Присоединить(ОбластьДень);
		
	КонецЦикла; 
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C1:R3C2");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Модель";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	                                  
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C3:R3C3");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Кампания";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C4:R3C4");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Затраты";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьЯчейки = ТабличныйДокумент.Область("R1C5:R3C5");
	ОбластьЯчейки.Объединить();
	ОбластьЯчейки.Текст = "Дата нач/кон акции";
	ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОбластьЯчейки.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ОбластьЯчейки.ЦветТекста = ЦветТекстаОформления;	
	ОбластьЯчейки.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	
	ОбластьМедиаРесурсГод = Макет.ПолучитьОбласть("ОбластьМедиаРесурсГод");
	ОбластьИтогГод		  = Макет.ПолучитьОбласть("ОбластьИтогГод");	
	ОбластьКонтрагент  	  = Макет.ПолучитьОбласть("ОбластьКонтрагент");	
	
	ОбластьЕстьМакетИОтчет  = Макет.ПолучитьОбласть("ОбластьЕстьМакетИОтчет_День");
	ОбластьНетМакетаИОтчета = Макет.ПолучитьОбласть("ОбластьНетМакетаИОтчета_День");
	
	ВыборкаДилерскихЦентров = ВыборкаОбщий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДилерскихЦентров.Следующий() Цикл
		
		ОбластьКонтрагент.Параметры.Заполнить(ВыборкаДилерскихЦентров);
		ОбластьКонтрагент.Области.ОбластьКонтрагент.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		ОбластьКонтрагент.Области.ОбластьКонтрагент.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		
		ТабличныйДокумент.Вывести(ОбластьКонтрагент);
		ТабличныйДокумент.НачатьГруппуСтрок();		
		
		Для А = 13 По КоличествоДней Цикл
			
			ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			
			Если А = КоличествоДней Тогда
 				ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
			КонецЕсли; 
			
			ТабличныйДокумент.Присоединить(ОбластьДопПоле);
		КонецЦикла; 
		
		ТабличныйДокумент.Вывести(ОбластьЧерта);
		
		Для А = 13 По КоличествоДней Цикл
			ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
		КонецЦикла; 
		
		ВыборкаМедиаРесурс = ВыборкаДилерскихЦентров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаМедиаРесурс.Следующий() Цикл
			
			ОбластьМедиаРесурсГод.Параметры.Заполнить(ВыборкаМедиаРесурс);
			ОбластьМедиаРесурсГод.Области.ОбластьМедиаРесурсГод.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ОбластьМедиаРесурсГод.Области.ОбластьМедиаРесурсГод.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
			ТабличныйДокумент.Вывести(ОбластьМедиаРесурсГод);
			
			Для А = 13 По КоличествоДней Цикл
				
				ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
				ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
				
				Если А = КоличествоДней Тогда
					ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
				КонецЕсли; 
				
				ТабличныйДокумент.Присоединить(ОбластьДопПоле);
			КонецЦикла; 
			
			ТабличныйДокумент.НачатьГруппуСтрок();
			
			ТабличныйДокумент.Вывести(ОбластьЧерта);
			
			Для А = 13 По КоличествоДней Цикл
				ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
			КонецЦикла; 
			
			ВыборкаКампании = ВыборкаМедиаРесурс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКампании.Следующий() Цикл
				
				ОбластьСтрокаРекламныхКампаний.Параметры.Заполнить(ВыборкаКампании);
				ОбластьСтрокаРекламныхКампаний.Параметры.ДатаНачала    = ВыборкаКампании.РекламнаяКампания.ДатаНачала;
				ОбластьСтрокаРекламныхКампаний.Параметры.ДатаОкончания = ВыборкаКампании.РекламнаяКампания.ДатаОкончания;
				ТабличныйДокумент.Вывести(ОбластьСтрокаРекламныхКампаний);
				
				Для ДеньМесяца = 1 По КоличествоДней Цикл
					
					мДень = НачалоДня(Дата(Формат(ДатаНачала,"ДФ=yyyyMM")+Формат(ДеньМесяца,"ЧЦ=2; ЧН=01; ЧВН=; ЧГ=")));
					
					Если мДень >= НачалоДня(ВыборкаКампании.РекламнаяКампания.ДатаНачала) И мДень <= НачалоДня(ВыборкаКампании.РекламнаяКампания.ДатаОкончания) Тогда
						ОбластьЕстьМакетИОтчет.Параметры.Заполнить(ВыборкаКампании);
						ТабличныйДокумент.Присоединить(ОбластьЕстьМакетИОтчет);
					Иначе 
						ТабличныйДокумент.Присоединить(ОбластьНетМакетаИОтчета);
					КонецЕсли;
					
				КонецЦикла; 
				
				ТабличныйДокумент.Вывести(ОбластьЧерта);
				
				Для А = 13 По КоличествоДней Цикл
					ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
				КонецЦикла; 
				
			КонецЦикла; 
			
			ТабличныйДокумент.ЗакончитьГруппуСтрок();
		КонецЦикла;
		ТабличныйДокумент.ЗакончитьГруппуСтрок();
	КонецЦикла;
	
	ВыборкаСтатусов = ПакетЗапросов[6].Выбрать();
	
	Пока ВыборкаСтатусов.Следующий() Цикл
		ОбъединитьЯчейкиПоСтатусам(ВыборкаСтатусов.Статус);
	КонецЦикла; 
	
	ОбластьИтогГод.Параметры.Заполнить(ВыборкаОбщий);
	ОбластьИтогГод.Области.ОбластьИтогГод.ГраницаСверху = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	ОбластьИтогГод.Области.ОбластьИтогГод.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	ТабличныйДокумент.Вывести(ОбластьИтогГод);
	
	Для А = 13 По КоличествоДней Цикл
		
		ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСлева  = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		
		Если А = КоличествоДней Тогда
			ОбластьДопПоле.Области.ОбластьДопПоле_День.ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		КонецЕсли; 
		
		ТабличныйДокумент.Присоединить(ОбластьДопПоле);
		
	КонецЦикла; 
	
	ТабличныйДокумент.Вывести(ОбластьЧерта);
	
	Для А = 13 По КоличествоДней Цикл
		ТабличныйДокумент.Присоединить(ОбластьДопЧерта);
	КонецЦикла; 
	
	ВывестиОбозначенияСтатусов(Макет);
	
	ТабличныйДокумент.ФиксацияСверху = 3;
	ТабличныйДокумент.ФиксацияСлева  = 4;
	ТабличныйДокумент.АвтоМасштаб    = Истина;
	
КонецПроцедуры // СформироватьОтчетНаКварталСервере()

&НаСервере
Функция СформироватьЗапрос(ПараметрыЗапроса)
		
	Запрос = Новый Запрос;
	
	Для каждого ТекущийПараметр Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(ТекущийПараметр.Ключ,ТекущийПараметр.Значение);
	КонецЦикла; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РекламныеКампании.РекламнаяКампания КАК РекламнаяКампания,
	|	РекламныеКампании.ДилерскийЦентр КАК ДилерскийЦентр,
	|	РекламныеКампании.ТипКампании КАК ТипКампании,
	|	РекламныеКампании.Модель КАК Модель,
	|	РекламныеКампании.РекламнаяКампания.ДатаНачала КАК ДатаНачала,
	|	РекламныеКампании.РекламнаяКампания.ДатаОкончания КАК ДатаОкончания,
	|	РекламныеКампании.РекламнаяКампания.МедиаРесурс КАК МедиаРесурс,
	|	СУММА(РекламныеКампании.СуммаФактОборот) КАК СуммаФакт,
	|	СУММА(РекламныеКампании.СуммаПланОборот) КАК СуммаПлан
	|ПОМЕСТИТЬ ТаблицаКампаний
	|ИЗ
	|	РегистрНакопления.DMS_РекламныеКампании.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			,
	|			РекламнаяКампания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.DMS_ВидыОперацийРекламнойкампании.РазмещениеКампании)
	|				И (РекламнаяКампания = &РекламнаяКампания
	|					ИЛИ &РекламнаяКампания = ЗНАЧЕНИЕ(Документ.DMS_РекламнаяКампания.пустаяСсылка))
	|				И (ДилерскийЦентр = &ДилерскийЦентр
	|					ИЛИ &ДилерскийЦентр = ЗНАЧЕНИЕ(Справочник.CRM_ДилерскиеЦентры.пустаяСсылка))
	|				И (Модель = &Модель
	|					ИЛИ &Модель = ЗНАЧЕНИЕ(Справочник.Модели.пустаяСсылка))
	|				И (РекламнаяКампания.МедиаРесурс = &МедиаРесурс
	|					ИЛИ &МедиаРесурс = ЗНАЧЕНИЕ(Справочник.DMS_МедиаРесурсы.ПустаяСсылка))
	|				И (РекламнаяКампания.МедиаРесурс.ТипРазмещения = &ТипРазмещения
	|					ИЛИ &ТипРазмещения = ЗНАЧЕНИЕ(Перечисление.DMS_ТипыРазмещенияМедиа.ПустаяСсылка))
	|				И (Представитель = &Представитель
	|					ИЛИ &Представитель = ЗНАЧЕНИЕ(Справочник.DMS_Представители.пустаяссылка))
	|				И (РекламнаяКампания.КооперативнаяРеклама = ИСТИНА
	|						И &ВидРекламы = 1
	|					ИЛИ РекламнаяКампания.КооперативнаяРеклама = ЛОЖЬ
	|						И &ВидРекламы = 2
	|					ИЛИ &ВидРекламы = 0)) КАК РекламныеКампании
	|
	|СГРУППИРОВАТЬ ПО
	|	РекламныеКампании.Модель,
	|	РекламныеКампании.ТипКампании,
	|	РекламныеКампании.ДилерскийЦентр,
	|	РекламныеКампании.РекламнаяКампания,
	|	РекламныеКампании.РекламнаяКампания.ДатаОкончания,
	|	РекламныеКампании.РекламнаяКампания.ДатаНачала,
	|	РекламныеКампании.РекламнаяКампания.МедиаРесурс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаКампаний.РекламнаяКампания КАК РекламнаяКампания,
	|	ТаблицаКампаний.ДилерскийЦентр КАК ДилерскийЦентр,
	|	ТаблицаКампаний.ТипКампании КАК ТипКампании,
	|	ТаблицаКампаний.Модель КАК Модель,
	|	НАЧАЛОПЕРИОДА(ТаблицаКампаний.ДатаНачала, МЕСЯЦ) КАК ДатаНачала,
	|	НАЧАЛОПЕРИОДА(ТаблицаКампаний.ДатаОкончания, МЕСЯЦ) КАК ДатаОкончания,
	|	ТаблицаКампаний.МедиаРесурс КАК МедиаРесурс,
	|	ВЫБОР
	|		КОГДА &ПланФактДельта = 0
	|			ТОГДА ЕСТЬNULL(ТаблицаКампаний.СуммаПлан, 0)
	|		КОГДА &ПланФактДельта = 1
	|			ТОГДА ЕСТЬNULL(ТаблицаКампаний.СуммаФакт, 0)
	|		ИНАЧЕ ЕСТЬNULL(ТаблицаКампаний.СуммаПлан, 0) - ЕСТЬNULL(ТаблицаКампаний.СуммаФакт, 0)
	|	КОНЕЦ КАК СуммаФакт,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СтатусыМакетов.Статус, ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.БезМакета)) = ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьМакет,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СтатусыОтчетов.Статус, ЗНАЧЕНИЕ(Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.БезОтчета)) = ЗНАЧЕНИЕ(Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.ПустаяСсылка)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОтчет,
	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ТаблицаКампаний.ДатаНачала, ДЕНЬ), НАЧАЛОПЕРИОДА(ТаблицаКампаний.ДатаОкончания, ДЕНЬ), МЕСЯЦ) КАК КоличествоМесяцев,
	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ), КОНЕЦПЕРИОДА(&ДатаОкончанияВывода, МЕСЯЦ), ДЕНЬ) + 1 КАК КоличествоДней,
	|	ЕСТЬNULL(СтатусыМакетов.Статус, ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.БезМакета)) КАК СтатусМакета,
	|	ЕСТЬNULL(СтатусыОтчетов.Статус, ЗНАЧЕНИЕ(Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.Безотчета)) КАК СтатусОтчета,
	|	ЕСТЬNULL(СтатусыМакетов.Статус, ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.Безмакета)) КАК КоличествоСтатусовМакета,
	|	ЕСТЬNULL(СтатусыОтчетов.Статус, ЗНАЧЕНИЕ(Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.Безотчета)) КАК КоличествоСтатусовОтчета,
	|	ЕСТЬNULL(СтатусыМакетов.Статус.Вес, ВЫРАЗИТЬ(ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.БезМакета) КАК Справочник.DMS_СтатусыМакетовРекламнойКампании).Вес) КАК СтатусМакетаВес,
	|	ЕСТЬNULL(СтатусыОтчетов.Статус.Вес, ВЫРАЗИТЬ(ЗНАЧЕНИЕ(Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.БезОтчета) КАК Справочник.DMS_СтатусыОтчетовПоРекламнойКампании).Вес) КАК СтатусОтчетаВес,
	|	ЕСТЬNULL(ТаблицаКампаний.СуммаФакт, 0) КАК Факт,
	|	ЕСТЬNULL(ТаблицаКампаний.СуммаПлан, 0) КАК План,
	|	ЕСТЬNULL(ТаблицаКампаний.СуммаПлан, 0) - ЕСТЬNULL(ТаблицаКампаний.СуммаФакт, 0) КАК Дельта
	|ПОМЕСТИТЬ Данные
	|ИЗ
	|	ТаблицаКампаний КАК ТаблицаКампаний
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.DMS_СтатусыМакетовРекламныхКампаний.СрезПоследних КАК СтатусыМакетов
	|		ПО ТаблицаКампаний.РекламнаяКампания = СтатусыМакетов.РекламнаяКампания
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.DMS_СтатусыОтчетовПоРекламнойКампании.СрезПоследних КАК СтатусыОтчетов
	|		ПО ТаблицаКампаний.РекламнаяКампания = СтатусыОтчетов.РекламнаяКампания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаКампаний
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.РекламнаяКампания,
	|	Данные.Модель,
	|	Данные.МедиаРесурс,
	|	МАКСИМУМ(ЕСТЬNULL(Данные.СтатусМакетаВес, 0)) КАК СтатусМакетаВес,
	|	МАКСИМУМ(ЕСТЬNULL(Данные.СтатусОтчетаВес, 0)) КАК СтатусОтчетаВес
	|ПОМЕСТИТЬ ВесыСтатусов
	|ИЗ
	|	Данные КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.РекламнаяКампания,
	|	Данные.Модель,
	|	Данные.МедиаРесурс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.СтатусМакета КАК Статус
	|ПОМЕСТИТЬ Статусы
	|ИЗ
	|	Данные КАК Данные
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Данные.СтатусОтчета
	|ИЗ
	|	Данные КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.РекламнаяКампания КАК РекламнаяКампания,
	|	Данные.ДилерскийЦентр КАК ДилерскийЦентр,
	|	Данные.ТипКампании КАК ТипКампании,
	|	Данные.Модель КАК Модель,
	|	Данные.ДатаНачала,
	|	Данные.ДатаОкончания,
	|	Данные.МедиаРесурс КАК МедиаРесурс,
	|	Данные.СуммаФакт КАК СуммаФакт,
	|	Данные.ЕстьМакет КАК ЕстьМакет,
	|	Данные.ЕстьОтчет КАК ЕстьОтчет,
	|	Данные.КоличествоМесяцев КАК КоличествоМесяцев,
	|	Данные.КоличествоДней КАК КоличествоДней,
	|	ВЫБОР
	|		КОГДА Данные.СтатусМакета.Вес = ВесыСтатусов.СтатусМакетаВес
	|			ТОГДА Данные.СтатусМакета
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.ПустаяСсылка)
	|	КОНЕЦ КАК СтатусМакета,
	|	ВЫБОР
	|		КОГДА Данные.СтатусОтчета.Вес = ВесыСтатусов.СтатусОтчетаВес
	|			ТОГДА Данные.СтатусОтчета
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.ПустаяСсылка)
	|	КОНЕЦ КАК СтатусОтчета,
	|	Данные.КоличествоСтатусовМакета КАК КоличествоСтатусовМакета,
	|	Данные.КоличествоСтатусовОтчета КАК КоличествоСтатусовОтчета,
	|	Данные.Модель КАК КоличествоМоделей,
	|	Данные.Факт КАК Факт,
	|	Данные.План КАК План,
	|	Данные.Дельта КАК Дельта,
	|	Данные.ДилерскийЦентр.Код КАК КодДилерскогоЦентра,
	|	НЕОПРЕДЕЛЕНО КАК БизнесРегион,
	|	Данные.РекламнаяКампания.ФорматМедиаРесурса КАК ФорматМедиаРесурса,
	|	Данные.РекламнаяКампания.КооперативнаяРеклама КАК КооперативнаяРеклама,
	|	Данные.РекламнаяКампания.Наименование КАК РекламнаяКампанияНаименование
	|ИЗ
	|	Данные КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВесыСтатусов КАК ВесыСтатусов
	|		ПО Данные.РекламнаяКампания = ВесыСтатусов.РекламнаяКампания
	|			И Данные.Модель = ВесыСтатусов.Модель
	|			И Данные.МедиаРесурс = ВесыСтатусов.МедиаРесурс
	|			И Данные.СтатусМакетаВес = ВесыСтатусов.СтатусМакетаВес
	|			И Данные.СтатусОтчетаВес = ВесыСтатусов.СтатусОтчетаВес
	|
	|УПОРЯДОЧИТЬ ПО
	|	МедиаРесурс,
	|	Модель,
	|	РекламнаяКампания
	|ИТОГИ
	|	МАКСИМУМ(ТипКампании),
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоМоделей) > 1
	|			ТОГДА ""Несколько моделей""
	|		ИНАЧЕ МАКСИМУМ(Модель)
	|	КОНЕЦ КАК Модель,
	|	СУММА(СуммаФакт),
	|	МАКСИМУМ(ЕстьМакет),
	|	МАКСИМУМ(ЕстьОтчет),
	|	МАКСИМУМ(КоличествоМесяцев),
	|	МАКСИМУМ(КоличествоДней),
	|	МАКСИМУМ(СтатусМакета),
	|	МАКСИМУМ(СтатусОтчета),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоСтатусовМакета),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоСтатусовОтчета),
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КоличествоМоделей),
	|	СУММА(Факт),
	|	СУММА(План),
	|	СУММА(Дельта),
	|	МАКСИМУМ(КодДилерскогоЦентра),
	|	МАКСИМУМ(БизнесРегион),
	|	МАКСИМУМ(ФорматМедиаРесурса),
	|	МАКСИМУМ(КооперативнаяРеклама),
	|	МАКСИМУМ(РекламнаяКампанияНаименование)
	|ПО
	|	ОБЩИЕ,
	|	ДилерскийЦентр,
	|	МедиаРесурс,
	|	РекламнаяКампания
	|АВТОУПОРЯДОЧИВАНИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Статусы.Статус КАК Статус
	|ИЗ
	|	Статусы КАК Статусы
	|ГДЕ
	|	Статусы.Статус <> ЗНАЧЕНИЕ(Справочник.DMS_СтатусыМакетовРекламнойКампании.ПустаяСсылка)
	|	И Статусы.Статус <> ЗНАЧЕНИЕ(Справочник.DMS_СтатусыОтчетовПоРекламнойКампании.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Статусы.Статус
	|
	|УПОРЯДОЧИТЬ ПО
	|	Статус
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	//Если Не ОтображенияДляПредставителя Тогда
