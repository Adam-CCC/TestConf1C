
//#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли; 
		
	Если Параметры.Свойство("ДилерскийЦентр") Тогда
		ДилерскийЦентр = Параметры.ДилерскийЦентр;
	//Иначе 
	//	Контрагент = ЗначениеНастроекПовтИсп.ПолучитьКонтрагентаПользователяПоУмолчанию(ПараметрыСеанса.ТекущийПользователь);	
	КонецЕсли; 
	
	МассивВыбора = ЗаполнитьСписокУровнейДетализацииПоГодам();
	
	Элементы.ГодСтрока.СписокВыбора.ЗагрузитьЗначения(МассивВыбора);
	Элементы.ГодСтрока.СписокВыбора.СортироватьПоЗначению(НаправлениеСортировки.Возр);	
	
	Год = НачалоГода(ТекущаяДатаСеанса());
	
	ДатаНачала    = Год;
	ДатаОкончания = КонецГода(Год);
	
	Квартал = НачалоКвартала(ТекущаяДатаСеанса());
	
	ГодСтрока 	  = Формат(Год,"ДФ='yyyy ''год'''; ДП=-");
	КварталСтрока = "ВесьГод";
	
	ВидОтчета = "КалендарьКампаний";
	ЦветТекстаОформления = Новый Цвет(62,79,145);
	
	//ВидОперации = ПараметрыСеанса.ВидОперацииРекламнойКампании;
	
	Элементы.ГруппаШапка.Видимость = Элементы.ФормаОтбор.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СформироватьОтчет();	
	
	Элементы["Форма"+СокрЛП(ВидОтчета)].Пометка = Истина;
	
	Если СокрЛП(ВидОтчета) = "КалендарьКампаний" Тогда
	
		ЦветТекстаОформления = Новый Цвет(62,79,145);
	
	ИначеЕсли СокрЛП(ВидОтчета) = "КалендарьКампанийБезОформления" Тогда
	
		ЦветТекстаОформления = Новый Цвет(0,0,0);
	
	ИначеЕсли СокрЛП(ВидОтчета) = "КалендарьКампанийЗеленый" Тогда
	
		ЦветТекстаОформления = Новый Цвет(72,125,72);
	
	ИначеЕсли СокрЛП(ВидОтчета) = "КалендарьКампанийЯркий" Тогда
	
		ЦветТекстаОформления = Новый Цвет(255,255,255);
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_РекламнаяКампания" Тогда
		СформироватьОтчет();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СтандартныйПериод") Тогда
		ОповещениеПослеВыбораПериода(ВыбранноеЗначение,ПутьКФайлу);
	КонецЕсли; 
		
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийКомандФормы

&НаКлиенте
Процедура ОбновитьОтчет(Команда)
	СформироватьОтчет();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКампанию(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.DMS_ВидыОперацийРекламнойКампании.СозданиеШаблона") Тогда
		ОткрытьФорму("Документ.DMS_РекламнаяКампания.Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма);
	Иначе 	
		ОткрытьФорму("Документ.DMS_РекламнаяКампания.Форма.ФормаПомощникСоздания",ПараметрыФормы,ЭтаФорма);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	ПараметрыФормы = Новый Структура("ТабличныйДокумент,Заголовок", ТабличныйДокумент,"Календарь кампаний");
	ОткрытьФорму("Обработка.DMS_КалендарьРекламныхКампаний.Форма.ПечатнаяФормаДокументов", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМакет(Команда)
	
	Если Не ЗначениеЗаполнено(ТекущаяРекламнаяКампания) Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура("РекламнаяКампания",ТекущаяРекламнаяКампания);
	ОткрытьФорму("Справочник.DMS_МакетыРекламнойКампании.Форма.ФормаЭлемента",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОтчет(Команда)
	
	Если Не ЗначениеЗаполнено(ТекущаяРекламнаяКампания) Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура("РекламнаяКампания",ТекущаяРекламнаяКампания);
	ОткрытьФорму("Документ.DMS_ОтчетПоРекламнойКампании.Форма.ФормаДокумента",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура МоиЗадачи(Команда)
	ОткрытьФорму("Задача.DMS_ЗадачаИсполнителя.Форма.МоиЗадачи",,ЭтаФорма);		
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВCSV(Команда)
	
	АдресФайла 			  = "";
	ДатаНачалаВыгрузки	  = "";
	ДатаОкончанияВыгрузки = "";
	Режим = РежимДиалогаВыбораФайла.Открытие;
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	
	ДиалогОткрытияФайла.ПолноеИмяФайла  = "";
	Фильтр = "Файл выгрузки(*,csv)|*.csv";
	ДиалогОткрытияФайла.Фильтр = Фильтр;
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок   = "Выберите файл";
	
	ПутьКФайлу = "";  
	
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		ПутьКФайлу = ДиалогОткрытияФайла.ПолноеИмяФайла;
	КонецЕсли;	
	
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		Предупреждение("Файл не выбран!",15,"Внимание");
		Возврат;
	КонецЕсли; 
		
	ПараметрыФормы = Новый Структура("Заголовок","Выберите дату выгрузки");
	
	ОткрытьФорму("Обработка.DMS_КалендарьРекламныхКампаний.Форма.ФормаВыбораПериода",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КалендарьКампаний(Команда)
	
