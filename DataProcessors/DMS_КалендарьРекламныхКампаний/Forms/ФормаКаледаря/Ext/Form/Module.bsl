&НаКлиенте
Процедура ОповещениеПослеВыбораПериода(Результат,ПутьКФайлу) Экспорт
	
	Если ТипЗнч(Результат) = Тип("СтандартныйПериод") Тогда
		ДатаНачалаВыгрузки 	  = Результат.ДатаНачала;
		ДатаОкончанияВыгрузки = Результат.ДатаОкончания;
	Иначе 
		Возврат;
	КонецЕсли; 
	
	Состояние("Начало выгрузки файла",,,БиблиотекаКартинок.ФорматExcel);
	
	ВыгрузитьВCSVНаСервере();
	
	Если СокрЛП(АдресФайла) <> "" Тогда
	
		ФайлВыгрузки = ПолучитьИзВременногоХранилища(АдресФайла);
		
		ФайлВыгрузки.Получить().Записать(ПутьКФайлу);
	
	КонецЕсли;
	
	Состояние("Выгрузка завершена",,,БиблиотекаКартинок.ФорматExcel);
	
КонецПроцедуры // ОповещениеПослеВыбора()
 
&НаСервереБезКонтекста
Функция ЗаполнитьСписокУровнейДетализацииПоГодам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РекламныеКампанииОбороты.ПериодГод КАК ПериодГод
	|ИЗ
	|	РегистрНакопления.DMS_РекламныеКампании.Обороты(, , Авто, ) КАК РекламныеКампанииОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПериодГод";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаГод = РезультатЗапроса.Выбрать();
	
	МассивВыбора = Новый Массив;
	
	Пока ВыборкаГод.Следующий() Цикл
		МассивВыбора.Добавить(Формат(ВыборкаГод.ПериодГод,"ДФ='yyyy ''год'''; ДП=-"));
	КонецЦикла;
	
	Возврат МассивВыбора;
	
КонецФункции // ЗаполнитьСписокУровнейДетализацииПоГодам()

&НаСервереБезКонтекста
Функция ПолучитьФинансовыйГод(Год)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Год", Год);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Год, ГОД), КВАРТАЛ, 1) КАК ДатаНачала,
	|	ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(НАЧАЛОПЕРИОДА(&Год, ГОД), КВАРТАЛ), ГОД, 1) КАК ДатаОкончания";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ФинансовыйГодПериод = Новый Структура("ДатаНачала,ДатаОкончания");
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ФинансовыйГодПериод,ВыборкаДетальныеЗаписи);	
		
	КонецЕсли; 
	
	Возврат ФинансовыйГодПериод;
	
КонецФункции // ПолучитьФинансовыйГод()

&НаСервереБезКонтекста
Функция ПолучитьРазностьДат(ДатаНачала,ДатаОкончания,Тип = "День")
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", 	ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",  ДатаОкончания);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РАЗНОСТЬДАТ(&ДатаНачала, &ДатаОкончания, "+Тип+")+1 КАК Разность";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаДетальныеЗаписи.Следующий();
	
	Возврат ВыборкаДетальныеЗаписи.Разность;
	
КонецФункции // ПолучитьРазностьДат()

&НаСервере
Процедура ОбъединитьЯчейкиПоСтатусам(Статус)
	
	ИмяСтатуса = СокрЛП(Статус);
	
	ТаблицаЯчеек = Новый ТаблицаЗначений;
	ТаблицаЯчеек.Колонки.Добавить("НомерСтроки",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ТаблицаЯчеек.Колонки.Добавить("НомерКолонки",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)));
	ТаблицаЯчеек.Колонки.Добавить("Текст",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	
	мОбласть = ТабличныйДокумент.НайтиТекст(ИмяСтатуса,,,,Истина);
	
	МассивИсключений = Новый Соответствие;
	
	Пока мОбласть <> Неопределено Цикл
		
		ОбозначениеСтроки = Лев(мОбласть.Имя,Найти(мОбласть.Имя,"C")-1);
		
		ОбозначениеКолонки = СтрЗаменить(мОбласть.Имя,ОбозначениеСтроки,"");
		
		НомерСтрока  = Число(СтрЗаменить(ОбозначениеСтроки,"R",""));
		НомерКолонки = Число(СтрЗаменить(ОбозначениеКолонки,"C",""));
		
		Если мОбласть.Расшифровка = Статус Тогда
			НоваяЗапись = ТаблицаЯчеек.Добавить();
			НоваяЗапись.НомерСтроки  = НомерСтрока;
			НоваяЗапись.НомерКолонки = НомерКолонки;
			НоваяЗапись.Текст 		 = мОбласть.Текст;
		Иначе 
			МассивИсключений.Вставить(мОбласть,мОбласть.Текст);
		КонецЕсли; 
		
		мОбласть.Текст = "";
		
		мОбласть = ТабличныйДокумент.НайтиТекст(ИмяСтатуса);		
		
	КонецЦикла; 
	
	Для каждого ЭлементИсключения Из МассивИсключений Цикл
		ЭлементИсключения.Ключ.Текст = ЭлементИсключения.Значение;
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЯчеек",ТаблицаЯчеек);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЯчеек.НомерСтроки,
	|	ТаблицаЯчеек.НомерКолонки,
	|	ТаблицаЯчеек.Текст
	|ПОМЕСТИТЬ мТаблицаЯчеек
	|ИЗ
	|	&ТаблицаЯчеек КАК ТаблицаЯчеек
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	мТаблицаЯчеек.НомерСтроки КАК НомерСтроки,
	|	МАКСИМУМ(мТаблицаЯчеек.НомерКолонки) КАК НомерКолонкиКонец,
	|	МАКСИМУМ(мТаблицаЯчеек.Текст) КАК Текст,
	|	МИНИМУМ(мТаблицаЯчеек.НомерКолонки) КАК НомерКолонкиНачало
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	мТаблицаЯчеек КАК мТаблицаЯчеек
	|
	|СГРУППИРОВАТЬ ПО
	|	мТаблицаЯчеек.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.НомерКолонкиКонец КАК НомерКолонкиКонец,
	|	ВТ.Текст,
	|	ВТ.НомерКолонкиНачало КАК НомерКолонкиНачало
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	НомерКолонкиНачало,
	|	НомерКолонкиКонец";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ИмяОбласти = "R"+Формат(ВыборкаДетальныеЗаписи.НомерСтроки,"ЧЦ=10; ЧГ=")+"C"+Формат(ВыборкаДетальныеЗаписи.НомерКолонкиНачало,"ЧЦ=10; ЧГ=")+":"+"R"+Формат(ВыборкаДетальныеЗаписи.НомерСтроки,"ЧЦ=10; ЧГ=")+"C"+Формат(ВыборкаДетальныеЗаписи.НомерКолонкиКонец,"ЧЦ=10; ЧГ=");
		
		мОбласть = ТабличныйДокумент.Область(ИмяОбласти);
		
		мОбласть.Объединить();
		
		мОбласть.Текст 					 = СокрЛП(Статус.ПредставлениеВОтчете);
		мОбласть.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		мОбласть.ВертикальноеПоложение 	 = ВертикальноеПоложение.Центр;
		мОбласть.Гиперссылка = Истина;
		Если ТипЗнч(мОбласть.Расшифровка) = Тип("СправочникСсылка.DMS_СтатусыМакетовРекламнойКампании") 
			Или ТипЗнч(мОбласть.Расшифровка) = Тип("СправочникСсылка.DMS_СтатусыОтчетовПоРекламнойКампании") Тогда
			
			мЦветФона = мОбласть.Расшифровка.ЦветФона.Получить();
			
			Если мЦветФона <> Неопределено Тогда
				мОбласть.ЦветФона = мЦветФона;
			КонецЕсли; 
			
			мЦветТекста = мОбласть.Расшифровка.ЦветТекста.Получить();
			
			Если мЦветТекста <> Неопределено Тогда
				мОбласть.ЦветТекста = мЦветТекста;
			КонецЕсли; 
			
			мШрифтТекста = мОбласть.Расшифровка.ШрифтТекста.Получить();
			
			Если мШрифтТекста <> Неопределено Тогда
				мОбласть.Шрифт = мШрифтТекста;
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры // ОбъединитьЯчейкиПоСтатусам()

&НаСервере
Функция ПоместитьТабличныеДокументыВоВременноеХранилище(НастройкиСохранения)
	Перем ЗаписьZipФайла, ИмяАрхива;
	
	Результат = Новый Массив;
	
	// подготовка архива
	Если НастройкиСохранения.УпаковатьВАрхив Тогда
		ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
	КонецЕсли;
	
	// подготовка временной папки
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);
	ИспользованныеИменаФайлов = Новый Соответствие;
	
	ВыбранныеФорматыСохранения = НастройкиСохранения.ФорматыСохранения;
	ТаблицаФорматов = Renault_УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();
	
	// сохранение печатных форм
	ОбработанныеПечатныеФормы = Новый Массив;
		
	ПечатнаяФорма = ТабличныйДокумент;
	
	Если ВычислитьИспользованиеВывода(ПечатнаяФорма) = ИспользованиеВывода.Запретить Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ПечатнаяФорма.Защита Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ПечатнаяФорма.ВысотаТаблицы = 0 Тогда
		Возврат Результат;
	КонецЕсли;
			
	Для Каждого ТипФайла Из ВыбранныеФорматыСохранения Цикл
		НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("ТипФайлаТабличногоДокумента", ТипФайла))[0];
		
		ИмяФайла = ПолучитьИмяВременногоФайлаДляПечатнойФормы("КалендарьРекламныхКампаний",НастройкиФормата.Расширение,ИспользованныеИменаФайлов);
		
		ПолноеИмяФайла = УникальноеИмяФайла(Renault_ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременнойПапки) + ИмяФайла);
		ПечатнаяФорма.Записать(ПолноеИмяФайла, ТипФайла);
		
		Если ТипФайла = ТипФайлаТабличногоДокумента.HTML Тогда
			ВставитьКартинкиВHTML(ПолноеИмяФайла);
		КонецЕсли;
		
		Если ЗаписьZipФайла <> Неопределено Тогда 
			ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
		Иначе
			ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
			ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
			ОписаниеФайла = Новый Структура;
			ОписаниеФайла.Вставить("Представление", ИмяФайла);
			ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
			Если ТипФайла = ТипФайлаТабличногоДокумента.ANSITXT Тогда
				ОписаниеФайла.Вставить("Кодировка", "windows-1251");
			КонецЕсли;
			Результат.Добавить(ОписаниеФайла);
		КонецЕсли;
	КонецЦикла;
	
	// Если архив подготовлен, записываем и помещаем его во временное хранилище.
	Если ЗаписьZipФайла <> Неопределено Тогда 
		ЗаписьZipФайла.Записать();
		ФайлАрхива = Новый Файл(ИмяАрхива);
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяАрхива);
		ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("Представление", ПолучитьИмяФайлаДляАрхива());
		ОписаниеФайла.Вставить("АдресВоВременномХранилище", ПутьВоВременномХранилище);
		Результат.Добавить(ОписаниеФайла);
	КонецЕсли;
	
	УдалитьФайлы(ИмяВременнойПапки);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СохранитьПечатныеФормыВПапку(СписокФайловВоВременномХранилище, Знач Папка = "")
	
	#Если ВебКлиент Тогда
		Для Каждого ФайлДляЗаписи Из СписокФайловВоВременномХранилище Цикл
			ПолучитьФайл(ФайлДляЗаписи.АдресВоВременномХранилище, ФайлДляЗаписи.Представление);
		КонецЦикла;
		Возврат;
	#КонецЕсли
	
	Папка = Renault_ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(Папка);
	Для Каждого ФайлДляЗаписи Из СписокФайловВоВременномХранилище Цикл
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ФайлДляЗаписи.АдресВоВременномХранилище);
		ДвоичныеДанные.Записать(УникальноеИмяФайла(Папка + ФайлДляЗаписи.Представление));
	КонецЦикла;
	
	Состояние(НСтр("ru='Сохранение успешно завершено';en='Save completed successfully'"), , НСтр("ru='в папку:';en='in folder:'") + " " + Папка);
	
КонецПроцедуры

&НаСервере
Функция ВычислитьИспользованиеВывода(мТабличныйДокумент)
	
	Если мТабличныйДокумент.Вывод = ИспользованиеВывода.Авто Тогда
		Возврат ?(ПравоДоступа("Вывод", Метаданные), ИспользованиеВывода.Разрешить, ИспользованиеВывода.Запретить);
	Иначе
		Возврат мТабличныйДокумент.Вывод;
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УникальноеИмяФайла(ИмяФайла)
	
	Файл = Новый Файл(ИмяФайла);
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	Расширение = Файл.Расширение;
	Папка = Файл.Путь;
	
	Счетчик = 1;
	Пока Файл.Существует() Цикл
		Счетчик = Счетчик + 1;
		Файл = Новый Файл(Папка + ИмяБезРасширения + " (" + Счетчик + ")" + Расширение);
	КонецЦикла;
	
	Возврат Файл.ПолноеИмя;

КонецФункции

&НаСервере
Функция ИмяФайлаПечатнойФормыПоУмолчанию(ОбъектПечати, НазваниеПечатнойФормы)
	
	ПараметрыДляВставки = Новый Структура;
	ПараметрыДляВставки.Вставить("НазваниеПечатнойФормы",НазваниеПечатнойФормы);
	ПараметрыДляВставки.Вставить("ПредставлениеОбъекта", Renault_ОбщегоНазначения.ПредметСтрокой(ОбъектПечати));
	ПараметрыДляВставки.Вставить("ТекущаяДата",Формат(ТекущаяДатаСеанса(), "ДЛФ=D"));
	Шаблон = НСтр("ru='[НазваниеПечатнойФормы] - [ПредставлениеОбъекта] - [ТекущаяДата]';en='[NazvaniePechatnoyFormy] - [PredstavlenieObekta] - [TekuschayaData]'");
	
	Возврат Renault_СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыДляВставки);
	
КонецФункции

&НаСервере
Функция ИмяФайлаПечатнойФормыОбъекта(ОбъектПечати, ИмяФайлаПечатнойФормы)
	Если ТипЗнч(ИмяФайлаПечатнойФормы) = Тип("Соответствие") Тогда
		Возврат Строка(ИмяФайлаПечатнойФормы[ОбъектПечати]);
	ИначеЕсли ТипЗнч(ИмяФайлаПечатнойФормы) = Тип("Строка") И Не ПустаяСтрока(ИмяФайлаПечатнойФормы) Тогда
		Возврат ИмяФайлаПечатнойФормы;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьИмяВременногоФайлаДляПечатнойФормы(ИмяМакета, Расширение, ИспользованныеИменаФайлов)
	
	ШаблонИмениФайла = "%1%2.%3";
	
	ИмяВременногоФайла = Renault_ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(
		Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмениФайла, ИмяМакета, "", Расширение));
		
	НомерИспользования = ?(ИспользованныеИменаФайлов[ИмяВременногоФайла] <> Неопределено,
							ИспользованныеИменаФайлов[ИмяВременногоФайла] + 1,
							1);
	
	ИспользованныеИменаФайлов.Вставить(ИмяВременногоФайла, НомерИспользования);
	
	// Если имя уже было ранее использовано, прибавляем счетчик в конце имени.
	Если НомерИспользования > 1 Тогда
		ИмяВременногоФайла = Renault_ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(
			Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонИмениФайла,
				ИмяМакета,
				" (" + НомерИспользования + ")",
				Расширение));
	КонецЕсли;
	
	Возврат ИмяВременногоФайла;
	
КонецФункции

&НаСервере
Процедура ВставитьКартинкиВHTML(ИмяФайлаHTML)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.Прочитать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	ТекстHTML = ТекстовыйДокумент.ПолучитьТекст();
	
	ФайлHTML = Новый Файл(ИмяФайлаHTML);
	
	ИмяПапкиКартинок = ФайлHTML.ИмяБезРасширения + "_files";
	ПутьКПапкеКартинок = СтрЗаменить(ФайлHTML.ПолноеИмя, ФайлHTML.Имя, ИмяПапкиКартинок);
	
	// Ожидается, что в папке будут только картинки.
	ФайлыКартинок = НайтиФайлы(ПутьКПапкеКартинок, "*");
	
	Для Каждого ФайлКартинки Из ФайлыКартинок Цикл
		КартинкаТекстом = Base64Строка(Новый ДвоичныеДанные(ФайлКартинки.ПолноеИмя));
		КартинкаТекстом = "data:image/" + Сред(ФайлКартинки.Расширение,2) + ";base64," + Символы.ПС + КартинкаТекстом;
		
		ТекстHTML = СтрЗаменить(ТекстHTML, ИмяПапкиКартинок + "\" + ФайлКартинки.Имя, КартинкаТекстом);
	КонецЦикла;
		
	ТекстовыйДокумент.УстановитьТекст(ТекстHTML);
	ТекстовыйДокумент.Записать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИмяФайлаДляАрхива()
	
	Результат = "";
	
	ПечатнаяФорма = ТабличныйДокумент;
	
	Если ВычислитьИспользованиеВывода(ПечатнаяФорма) = ИспользованиеВывода.Запретить Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = НСтр("ru='Документы';en='Documentation'");
	
	Возврат Результат + ".zip";
	
КонецФункции

&НаСервере
Процедура ВывестиОбозначенияСтатусов(Макет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтатусыМакетов.Ссылка КАК СтатусМакета,
		|	СтатусыМакетов.Вес КАК Вес,
		|	СтатусыМакетов.Наименование КАК Статус
		|ИЗ
		|	Справочник.DMS_СтатусыМакетовРекламнойКампании КАК СтатусыМакетов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Вес УБЫВ,
		|	СтатусМакета";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОбластьЗаголовокОбозначенияСтатусаМакета = Макет.ПолучитьОбласть("ОбластьЗаголовокОбозначенияСтатусаМакета");
	ОбластьСтатусМакета 					 = Макет.ПолучитьОбласть("ОбластьСтатусМакета");
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокОбозначенияСтатусаМакета);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ОбластьСтатусМакета.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
		ТабличныйДокумент.Вывести(ОбластьСтатусМакета);
		
		УстановитьПримерЗаполненияСтатусов("СтатусМакета",ВыборкаДетальныеЗаписи.СтатусМакета);
		
	КонецЦикла;
	
	//
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтатусыОтчетов.Ссылка КАК СтатусОтчета,
		|	СтатусыОтчетов.Вес КАК Вес,
		|	СтатусыОтчетов.Наименование КАК Отчет
		|ИЗ
		|	Справочник.DMS_СтатусыОтчетовПоРекламнойКампании КАК СтатусыОтчетов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Вес УБЫВ,
		|	СтатусОтчета";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОбластьЗаголовокОбозначенияСтатусаОтчета = Макет.ПолучитьОбласть("ОбластьЗаголовокОбозначенияСтатусаОтчета");
	ОбластьСтатусОтчета 					 = Макет.ПолучитьОбласть("ОбластьСтатусОтчета");
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовокОбозначенияСтатусаОтчета);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ОбластьСтатусОтчета.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
		ТабличныйДокумент.Вывести(ОбластьСтатусОтчета);
		
		УстановитьПримерЗаполненияСтатусов("СтатусОтчета",ВыборкаДетальныеЗаписи.СтатусОтчета);
		
	КонецЦикла;
	
КонецПроцедуры // ВывестиОбозначенияСтатусов()	

&НаСервере
Процедура УстановитьПримерЗаполненияСтатусов(ТекстПоиска,Статус)
		
	мОбласть = ТабличныйДокумент.НайтиТекст(ТекстПоиска,,,,Истина);
				
	мОбласть.Текст 					 = СокрЛП(Статус.ПредставлениеВОтчете);
	мОбласть.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	мОбласть.ВертикальноеПоложение 	 = ВертикальноеПоложение.Центр;
	
	Если ТипЗнч(мОбласть.Расшифровка) = Тип("СправочникСсылка.DMS_СтатусыМакетовРекламнойКампании") 
		Или ТипЗнч(мОбласть.Расшифровка) = Тип("СправочникСсылка.DMS_СтатусыОтчетовПоРекламнойКампании") Тогда
		
		мЦветФона = мОбласть.Расшифровка.ЦветФона.Получить();
		
		Если мЦветФона <> Неопределено Тогда
			мОбласть.ЦветФона = мЦветФона;
		КонецЕсли; 
		
		мЦветТекста = мОбласть.Расшифровка.ЦветТекста.Получить();
		
		Если мЦветТекста <> Неопределено Тогда
			мОбласть.ЦветТекста = мЦветТекста;
		КонецЕсли; 
		
		мШрифтТекста = мОбласть.Расшифровка.ШрифтТекста.Получить();
		
		Если мШрифтТекста <> Неопределено Тогда
			мОбласть.Шрифт = мШрифтТекста;
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры // ОбъединитьЯчейкиПоСтатусам()

&НаКлиенте
Процедура ТабличныйДокументПриАктивизацииОбласти(Элемент)
	
	ПодключитьОбработчикОжидания("ТабличныйДокументПриАктивизацииОбластиОжидание",0.1,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументПриАктивизацииОбластиОжидание()
	
	ТекущаяОбласть = Элементы.ТабличныйДокумент.ТекущаяОбласть;
	
	Если ТекущаяОбласть = Неопределено Тогда
		ТекущаяРекламнаяКампания = Неопределено;
		Возврат;
	КонецЕсли; 
	
	ИмяОбласти = ТекущаяОбласть.Имя;
	
	Попытка
		
		НомерСтроки  = Число(СтрЗаменить(Лев(ИмяОбласти,Найти(ИмяОбласти,"C")-1),"R",""));
		мКампания    = ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧЦ=10; ЧН=1; ЧГ=")+"C3:R"+Формат(НомерСтроки,"ЧЦ=10; ЧН=1; ЧГ=")+"C3").Расшифровка;
		
		Если мКампания = Неопределено Тогда
			НомерСтроки  = Число(СтрЗаменить(Лев(ИмяОбласти,Найти(ИмяОбласти,"C")-1),"R",""))-1;
			мКампания    = ТабличныйДокумент.Область("R"+Формат(НомерСтроки,"ЧЦ=10; ЧН=1; ЧГ=")+"C3:R"+Формат(НомерСтроки,"ЧЦ=10; ЧН=1; ЧГ=")+"C3").Расшифровка;
		КонецЕсли;
		
	Исключение
		Возврат;	
	КонецПопытки;
	
	Если ТипЗнч(мКампания) = Тип("ДокументСсылка.DMS_РекламнаяКампания")  Тогда
		ТекущаяРекламнаяКампания = мКампания;
		Элементы.ТабличныйДокументКонтекстноеМенюДобавитьМакет.Видимость = Истина;
		Элементы.ТабличныйДокументКонтекстноеМенюДобавитьОтчет.Видимость = Истина;
	Иначе 
		ТекущаяРекламнаяКампания = Неопределено;
		Элементы.ТабличныйДокументКонтекстноеМенюДобавитьМакет.Видимость = Ложь;
		Элементы.ТабличныйДокументКонтекстноеМенюДобавитьОтчет.Видимость = Ложь;
	КонецЕсли; 
	
КонецПроцедуры // ТабличныйДокументПриАктивизацииОбластиОжидание()

&НаСервере
Процедура ВыгрузитьВCSVНаСервере()
	
	Разделитель = ";";
	
	ПолноеИмяФайла = ПолучитьИмяВременногоФайла(".csv");
	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(Истина);
	
	ПакетЗапросов = СформироватьЗапрос(ПараметрыЗапроса);
	
	ВыборкаОбщий = ПакетЗапросов[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщий.Следующий();
	
	ТекстВыгрузки = "";
	
	ТекстВыгрузки = ТекстВыгрузки + "N п/п"+Разделитель
	+"Dlr ID"+Разделитель
	+"Dealer"+Разделитель
	+"City"+Разделитель
	+"Модель"+Разделитель
	+"Тип компании"+Разделитель
	+"Кооп"+Разделитель
	+"Тип медиа"+Разделитель
	+"Медиа"+Разделитель
	+"Площадка размещения"+Разделитель
	+"Кампания"+Разделитель
	+"Дата начала"+Разделитель
	+"Дата окончания"+Разделитель
	+"ЦБ план"+Разделитель
	+"БД план"+Разделитель
	+"БД факт"+Разделитель
	+"БД факт неутвержденный"+Символы.ПС;

	НомерСтроки = 1;
	
	ВыборкаДилерскихЦентров = ВыборкаОбщий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДилерскихЦентров.Следующий() Цикл
				
		ВыборкаМедиаРесурс = ВыборкаДилерскихЦентров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаМедиаРесурс.Следующий() Цикл
						
			ВыборкаКампании = ВыборкаМедиаРесурс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКампании.Следующий() Цикл
				
				ТекстВыгрузки = ТекстВыгрузки + Формат(НомерСтроки,"ЧЦ=10; ЧН=0; ЧГ=") + Разделитель
				 + УдалитьЛидирующиеНулиИзНомераОбъекта(СокрЛП(ВыборкаКампании.КодДилерскогоЦентра)) + Разделитель
				 + СокрЛП(ВыборкаКампании.ДилерскийЦентр)     + Разделитель
				 + СокрЛП(ВыборкаКампании.БизнесРегион)   + Разделитель
				 + СокрЛП(ВыборкаКампании.Модель)   	  + Разделитель
				 + СокрЛП(ВыборкаКампании.ТипКампании)    + Разделитель
				 + Формат(ВыборкаКампании.КооперативнаяРеклама,"БЛ=Самостоятельная; БИ=КООП") + Разделитель
				 + СокрЛП(ВыборкаКампании.МедиаРесурс.ТипРазмещения) + Разделитель
				 + СокрЛП(ВыборкаКампании.МедиаРесурс)    + Разделитель
				 + СокрЛП(ВыборкаКампании.ФорматМедиаРесурса) + Разделитель
				 + СокрЛП(ВыборкаКампании.РекламнаяКампания)  + Разделитель
				 + ВыборкаКампании.РекламнаяКампания.ДатаНачала + Разделитель
				 + ВыборкаКампании.РекламнаяКампания.ДатаОкончания + Разделитель
				 //+ 0 					+ Разделитель
				 //+ ВыборкаКампании.План + Разделитель
				 //+ ВыборкаКампании.Факт + Разделитель
				 //+ 0    	  			+ Символы.ПС;
				 //+ Формат(ВыборкаКампании.ДатаНачала,"ДФ=dd.MM.yyyy; ДП=01.01.0001") + Разделитель
				 //+ Формат(ВыборкаКампании.ДатаОкончания,"ДФ=dd.MM.yyyy; ДП=01.01.0001") + Разделитель
				 + Формат(0,"ЧЦ=15; ЧДЦ=2; ЧН=0; ЧГ=")    + Разделитель
				 + Формат(ВыборкаКампании.План,"ЧЦ=15; ЧДЦ=2; ЧН=0; ЧГ=") + Разделитель
				 + Формат(ВыборкаКампании.Факт,"ЧЦ=15; ЧДЦ=2; ЧН=0; ЧГ=") + Разделитель
				 + Формат(0,"ЧЦ=15; ЧДЦ=2; ЧН=0; ЧГ=")    	  			  + Символы.ПС;
				 
			 КонецЦикла; 
			
		КонецЦикла;
		
	КонецЦикла; 
	
	ФайлВыгрузки = Новый ЗаписьТекста(ПолноеИмяФайла,КодировкаТекста.ANSI,Разделитель,Ложь);
		
	ФайлВыгрузки.ЗаписатьСтроку(ТекстВыгрузки);
	
	ФайлВыгрузки.Закрыть();
	
	Файл = Новый Файл(ПолноеИмяФайла);
	
	Если Файл.Существует() Тогда
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
		
		ХранилищеФайла = Новый ХранилищеЗначения(ДвоичныеДанные,Новый СжатиеДанных(9));
		
		АдресФайла = ПоместитьВоВременноеХранилище(ХранилищеФайла);
		
		УдалитьФайлы(ПолноеИмяФайла);
		
	Иначе 
		ЗаписьЖурналаРегистрации("Сохранение файла CSV",УровеньЖурналаРегистрации.Ошибка,,,"Не найден сохраненный файл");
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция УдалитьЛидирующиеНулиИзНомераОбъекта(Знач НомерОбъекта) Экспорт
	
	ПрефиксИнформационнойБазы = Лев(НомерОбъекта, 2);
	
	НомерОбъекта = СтрЗаменить(НомерОбъекта,ПрефиксИнформационнойБазы,"");
	
	Префикс = "";
	Номер = Сред(НомерОбъекта, 1);
	
	// Удаляем лидирующие нули слева в номере.
	Номер = Renault_СтроковыеФункцииКлиентСервер.УдалитьПовторяющиесяСимволы(Номер, "0");
	
	Возврат Номер;
	
КонецФункции

