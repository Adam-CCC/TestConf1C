Процедура УдалитьЗамечаниеНаСервере(Запись)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ЗамечанияМенеджерам.Период,
	               |	CRM_ЗамечанияМенеджерам.Менеджер,
	               |	CRM_ЗамечанияМенеджерам.ИдентификаторТрафика,
	               |	CRM_ЗамечанияМенеджерам.ТекстЗамечания
	               |ИЗ
