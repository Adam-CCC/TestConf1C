&НаКлиенте
Процедура ОбновитьДиаграммуМенеджера(Элемент="") ДиаграммаМенеджеров() КонецПроцедуры
Процедура ДиаграммаМенеджеров() 
	
	ЦветАкт=Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ОсновнойЦвет);
	ЦветДоп1=Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ДопЦвет1);
	ЦветДоп2=Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ДопЦвет2);
	
	Если ПереключательДиаграммМенеджера=0 или ПереключательДиаграммМенеджера=1 Тогда //Распределение посещений, //Распределение звонков
		
		ДиаграммаПоМенеджерам.Обновление=Ложь;
		ДиаграммаПоМенеджерам.Очистить();
		ДиаграммаПоМенеджерам.АвтоТранспонирование=Ложь;
		
		Запрос=Новый Запрос("
		|ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Идентификатор) Количество, Представление(Менеджер) Сотрудник
		|ИЗ РегистрСведений.Renault_Трафик
		|ГДЕ Период МЕЖДУ &НачПериода И &КонПериода И Отдел=&Отдел И ТипТрафика=&ТипТрафика
		|СГРУППИРОВАТЬ ПО Менеджер");
		Запрос.УстановитьПараметр("НачПериода", Дата1);
		Запрос.УстановитьПараметр("КонПериода", КонецДня(Дата2));
		Запрос.УстановитьПараметр("ТипТрафика", ?(ПереключательДиаграммМенеджера=0,Справочники.CRM_ТипТрафика.ПосещениеАвтосалона,Справочники.CRM_ТипТрафика.Звонок));
		Запрос.УстановитьПараметр("ПервичныйПовторный", Перечисления.CRM_ПервичныйПовторный.Первичный);
		Запрос.УстановитьПараметр("Отдел",Отдел);
		Серия=ДиаграммаПоМенеджерам.УстановитьСерию("МА");
		Результат = Запрос.Выполнить();
		Таблица = Результат.Выгрузить();
		
		СреднееЗначение = Таблица.Итог("Количество")/?(Таблица.Количество()=0,1,Таблица.Количество());
		НовСрЗн = Таблица.Добавить();
		НовСрЗн.Сотрудник = "Средний показатель";
		НовСрЗн.Количество = СреднееЗначение;
		Таблица.Сортировать("Количество убыв, Сотрудник убыв");
		
		//Всего = ДиаграммаПоМенеджерам.Серии.Добавить("Сумма");
		Для каждого Строка из Таблица Цикл 
			Точка = ДиаграммаПоМенеджерам.Точки.Добавить(СокрЛП(Строка.Сотрудник)); 
			Если НЕ Строка.Сотрудник="Средний показатель" Тогда
				Если Строка.Количество>=Окр(СреднееЗначение) Тогда
					Точка.Цвет=ЦветАкт; //Желтый
				Иначе
					Точка.Цвет=ЦветДоп2; //Темно-серый
				КонецЕсли;
			Иначе
				Точка.Цвет=ЦветДоп1; //Серый
			КонецЕсли;
			Точка.ПриоритетЦвета = Истина;
			ДиаграммаПоМенеджерам.УстановитьЗначение(Точка, Серия, Строка.Количество);
		КонецЦикла;
		
		ДиаграммаПоМенеджерам.ЦветРамки=Новый Цвет(255,255,255);
		ДиаграммаПоМенеджерам.ПоложениеПодписей=ПоложениеПодписейКДиаграмме.Край;
		ДиаграммаПоМенеджерам.АвтоТранспонирование=Истина;
		ДиаграммаПоМенеджерам.ПодписиШкалыЗначенийИзмерительнойДиаграммыВдольШкалы=Истина;
		ДиаграммаПоМенеджерам.ОтображениеЗначенияИзмерительнойДиаграммы=ОтображениеЗначенияИзмерительнойДиаграммы.Сектор;
		ДиаграммаПоМенеджерам.ПоложениеПодписейШкалыЗначенийИзмерительнойДиаграммы=ПоложениеПодписейШкалыЗначенийИзмерительнойДиаграммы.НаШкале;
		ДиаграммаПоМенеджерам.АвтоУстановкаТекстаТочек=Истина;
		ДиаграммаПоМенеджерам.АвтоУстановкаИменТочек=Истина;
		ДиаграммаПоМенеджерам.ВидПодписей=ВидПодписейКДиаграмме.Значение;
		ДиаграммаПоМенеджерам.Обновление=Истина;
		
		Элементы.ДиаграммаПоМенеджерам.Видимость=Истина;
		Элементы.АктивностьМенеджеров.Видимость=Ложь;
		
	ИначеЕсли ПереключательДиаграммМенеджера=2 Тогда //Статусы менеджеров
		СписокСотрудников=Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(Отдел);
		АктивностьМенеджеров.Загрузить(Renault_CRM.ПолучитьСтатусыСотрудников(СписокСотрудников.ВыгрузитьЗначения()).Скопировать());
		
		Элементы.ДиаграммаПоМенеджерам.Видимость=Ложь;
		Элементы.АктивностьМенеджеров.Видимость=Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПередатьФотоСотрудников()
	МассивАдресовФайлов=Новый Массив;
	Запрос=Новый Запрос("Выбрать * Из РегистрСведений.КартинкиИФайлы ГДЕ Картинка И Объект В(
	|	Выбрать Различные Сотрудник Из Справочник.CRM_ДилерскиеЦентры.СотрудникиДляОтображенияВСтатусБареАдминистартора
	|	ГДЕ Не Сотрудник.ПометкаУдаления И НЕ Сотрудник.ЭтоГруппа И Сотрудник.Подразделение В(&спПодразделения)
	|)");
	Запрос.УстановитьПараметр("спПодразделения",Отдел.Подразделения.ВыгрузитьКолонку("Подразделение"));
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		//динамическое добавление элементов
		//Эл=Элементы.Добавить("img"+Формат(Н,"ЧГ=0"),Тип("ДекорацияФормы"),Элементы.спФото);
		//Эл.Вид=ВидДекорацииФормы.Картинка;
		//Эл.Картинка=?(Выборка.ДанныеВоВнешнемФайле,Новый Картинка(Выборка.ИмяФайла),Выборка.Данные.Получить());
		
		Если Выборка.ДанныеВоВнешнемФайле Тогда ИмяФайла=Выборка.ИмяФайла
		Иначе
			ИмяФайла=ПолучитьИмяВременногоФайла();
			Выборка.Данные.Получить().Записать(ИмяФайла);
		КонецЕсли;
		
		МассивАдресовФайлов.Добавить(ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла),УникальныйИдентификатор));
	КонецЦикла;
	АдресаФайлов=ЗначениеВСтрокуВнутр(МассивАдресовФайлов);
КонецПроцедуры	

