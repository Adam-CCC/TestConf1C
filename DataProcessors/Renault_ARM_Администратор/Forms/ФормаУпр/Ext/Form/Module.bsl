&НаСервереБезКонтекста
Процедура ЗафиксироватьОбращениеНаСервере(ЗаписьТрафика, ЕстьЖалоба, мОтдел)
	
	Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ЗаписьТрафика.Идентификатор);

	Документ = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
					
	Документ.Дата = ТекущаяДата();
	Документ.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.СРешепшен;
	Документ.ДилерскийЦентр = Запись.ДилерскийЦентр;
	Документ.Менеджер = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Запись.Администратор);
	
	ФИО = Запись.Представление;
	
	Если ТипЗнч(Запись.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") 
		ИЛИ ТипЗнч(Запись.Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Документ.Клиент = Запись.Клиент;
	Иначе
		Документ.Клиент = ФИО;
	КонецЕсли;
	
	Модель = Запись.ПервичныйИнтерес;
	Если ЗначениеЗаполнено(Модель) Тогда
		МодельНаименование = Модель.Наименование;
	Иначе
		МодельНаименование = "";
	КонецЕсли;
	
	Документ.Примечание = Запись.Комментарий + ?(ЗначениеЗаполнено(Модель), " Модель: " + МодельНаименование, "");     
	Документ.ПервичныйПовторный = Запись.ПервичныйПовторный;
	Документ.ОбращениеОбработано = Ложь;
	
	Попытка
		Документ.ИдентификаторТрафика = ЗаписьТрафика.Идентификатор;
	Исключение
	Конецпопытки;
		
	Документ.Жалоба = ЕстьЖалоба;
	
	Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Запись.Клиент);
	
	Попытка
		Документ.ТелефонПримечание = Телефон;
	Исключение
		Документ.Примечание = Документ.Примечание + " Телефон клиента: " + Телефон;
	КонецПопытки;
	
	НачатьТранзакцию();
	
	Запись.Отдел = мОтдел;
	Запись.Записать();
	
	Документ.Записать();
	
	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	Напоминание.Отправитель = Запись.Администратор;
	Напоминание.Подробнее = Документ.Ссылка;
	Напоминание.Адресаты.Добавить().Сотрудник = Запись.Менеджер;
	Напоминание.ДатаОтправки = ТекущаяДата();
	Напоминание.Комментарий = Запись.Комментарий;
	Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера;
	Напоминание.ПоказыватьС = ТекущаяДата();
	Напоминание.ПоказыватьПо = ТекущаяДата();
	Напоминание.Наименование = ФИО;
	Напоминание.Сообщение = "На вас назначен клиент: " + ФИО + " | " + Запись.Комментарий + ?(ЗначениеЗаполнено(Модель), " | " + МодельНаименование, "");
	
	Напоминание.Записать();
	
	ЗафиксироватьТранзакцию();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗафиксироватьОтделНаСервере(ЗаписьТрафика, мОтдел);
	
	Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ЗаписьТрафика.Идентификатор);

	Запись.Отдел = мОтдел;
					
	Попытка
		Запись.Записать();
	Исключение
		Сообщить("Ошибка записи. Не удалось изменить отдел");
	КонецПопытки;

КонецПроцедуры

