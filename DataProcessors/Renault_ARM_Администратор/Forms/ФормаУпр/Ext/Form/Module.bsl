&НаКлиенте
Процедура УстановитьОтдел(Запись)
	
	Если ЗаписьСуществуетИНеОбработана(Запись) Тогда
		
		//Заблокируем форму от изменения
		ЭтаФорма.ТолькоПросмотр = Истина;
		
		Список = Renault_CRM.ПолучитьСписокПрочихОтделовЦентра(Элементы.спТрафик.ТекущиеДанные.ДилерскийЦентр);

		Парам=Новый Структура;
		Парам.Вставить("Список",Список);
		Парам.Вставить("Заголовок", "Выбор отдела");

		ФормаСписка = ПолучитьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений", Парам);
		
		Ответ = ФормаСписка.ОткрытьМодально();
		Если ЗначениеЗаполнено(Ответ) Тогда
			мОтдел = Ответ;
			
			Если ИспользуетсяАвтосервис(Элементы.спТрафик.ТекущиеДанные.Отдел, мОтдел, Элементы.спТрафик.ТекущиеДанные.ДилерскийЦентр) Тогда
				
				Если ОтделСервиса(мОтдел) Тогда
					ЗаписьНаСервис = ИСТИНА;
				Иначе
					ЗаписьНаСервис = Ложь;
				КонецЕсли;
				
				ТрафикУпущен = ПолучитьПризнакУпущенНаСервере(Запись);
								
				Если ЗаписьНаСервис И
					Не ТрафикУпущен Тогда
					
					ТекстВопроса = "Будет создан документ ""Обращение в авто сервис (Renault CRM)"". Продолжить?";
					Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
						Сообщить("Не удалось изменить отдел");
						Возврат;
					КонецЕсли;
					
					ВариантыОтвета = Новый СписокЗначений;
					ВариантыОтвета.Добавить("Да", "Да");
					ВариантыОтвета.Добавить("Нет", "Нет / Не знаю");
					
					Если Вопрос("Была жалоба при обращении клиента?", ВариантыОтвета) = "Да" Тогда
						ЕстьЖалоба = Истина;
					КонецЕсли;

					ЗафиксироватьОбращениеНаСервере(Запись, ЕстьЖалоба, мОтдел);
					
				Иначе
					ЗафиксироватьОтделНаСервере(Запись, мОтдел);
				КонецЕсли;
				
			Иначе	
				ЗафиксироватьОтделНаСервере(Запись, мОтдел);
			КонецЕсли;
						
		КонецЕсли;
		
		ЭтаФорма.ТолькоПросмотр = Ложь;
		
	КонецЕсли;

КонецПроцедуры

