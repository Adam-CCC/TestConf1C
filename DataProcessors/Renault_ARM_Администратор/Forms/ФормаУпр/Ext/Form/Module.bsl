&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Дата1=НачалоМесяца(ТекущаяДата());
	Дата2=ТекущаяДата();
	УстановитьЗаголовок();

	ДилерскийЦентр=Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(Renault_ОбщиеФункцииСервер.ТекущийПользователь());
	Отдел=Renault_CRM.ПолучитьОтделАвтосалона();
	
	// Проверка на доступ к работе с АРМ
	Если НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмРесепшена(Renault_ОбщиеФункцииСервер.ТекущийПользователь()) Тогда
		Сообщить("У вас нет прав на запуск АРМ Администратор зала");
		Отказ=Истина;
		Возврат
	КонецЕсли;
	
	ПунктыМеню.Добавить("РегистрацияТрафика");
	ПунктыМеню.Добавить("Трафик");
	ПунктыМеню.Добавить("ТестДрайв");
	ПунктыМеню.Добавить("Диаграммы");
	ПунктыМеню.Добавить("Фото");
	Если ДилерскийЦентр.ИспользуетАвтосервис Тогда
		ПунктыМеню.Добавить("ЗаписьНаСервис");
	КонецЕсли;
	
	ТекущаяЗакладкаМеню=0;
	УстановитьПараметрыСписков();
	УстановитьОтбор();
	
	ТекущийРежимДиаграммы=Элементы.кнСпДиаграммы.ПодчиненныеЭлементы[0].Имя;
	ПередатьФотоСотрудников();
	
КонецПроцедуры

