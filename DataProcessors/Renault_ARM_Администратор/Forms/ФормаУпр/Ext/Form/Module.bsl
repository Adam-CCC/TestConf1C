Процедура УстановитьМенеджераНаСервере(ЗаписьТрафика, Ответ) 
	
	Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ЗаписьТрафика.Идентификатор);
	ЗаписьЗадача = Renault_CRM.ПолучитьЗаписьЗадачиПоIDТрафика(ЗаписьТрафика.Идентификатор);

	Если ЗначениеЗаполнено(Ответ) Тогда
		Запись.Менеджер = Ответ;
		Запись.Записать();
		
		//Если есть задача по трафику, в ней также необходимо изменить менеджера
		Если ЗаписьЗадача <> Неопределено Тогда
			ЗаписьЗадача.Менеджер = Ответ;
			ЗаписьЗадача.Записать();
		КонецЕсли;
	Иначе
		
		Запись.Менеджер = Справочники.Сотрудники.ПустаяСсылка();
		Запись.Записать();
		
		//Если есть задача по трафику, в ней также необходимо изменить менеджера
		Если ЗаписьЗадача <> Неопределено Тогда
			ЗаписьЗадача.Менеджер = Справочники.Сотрудники.ПустаяСсылка();
			ЗаписьЗадача.Записать();
		КонецЕсли;
		
	КонецЕсли;
		
