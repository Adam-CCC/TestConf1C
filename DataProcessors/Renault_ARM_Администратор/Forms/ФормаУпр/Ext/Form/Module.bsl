&НаКлиенте
Процедура РаботаСоСписком(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ИмяСписка=ИмяСписка();
	Если ИмяСписка = "спТрафик" Тогда
		РасшифроватьТрафик(ВыбраннаяСтрока, Поле.Имя);
	ИначеЕсли ИмяСписка = "спТестДрайв" Тогда
		РасшифроватьТестДрайв(Поле.Имя);
	ИначеЕсли ИмяСписка = "спЗаписьНаСервис" Тогда
		РасшифроватьЗаписьНаСервис(Поле.Имя);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьТрафик(ВыбраннаяСтрока, ИмяПоля)
			
	Если ИмяПоля = "спТрафикМенеджер" Тогда
		
		УстановитьМенеджера(ВыбраннаяСтрока, Отдел);
		
	ИначеЕсли ИмяПоля = "спТрафикКомментарий" Тогда
		
		УстановитьКомментарий(ВыбраннаяСтрока);
		
	ИначеЕсли ИмяПоля = "спТрафикТрафикУпущен" Тогда
		
		УстановитьОтметкуУпущен(ВыбраннаяСтрока);
		
	ИначеЕсли ИмяПоля = "спТрафикЕстьЗамечание" Тогда
		
		УстановитьЗамечание(ВыбраннаяСтрока);
		
	ИначеЕсли ИмяПоля = "спТрафикТД" Тогда
		
		УстановитьТД(ВыбраннаяСтрока);
			
	ИначеЕсли ИмяПоля = "спТрафикОтдел" Тогда

		УстановитьОтдел(ВыбраннаяСтрока);	
				
	КонецЕсли;

	Элементы.спТрафик.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьТестДрайв(ИмяПоля)
	
	Запись = Элементы.спТестДрайв.ТекущиеДанные;

	Если ИмяПоля = "спТестДрайвЗаписьНаТестДрайв" Тогда
		
		////Печать
		ДокументСсылка = Запись.ЗаписьНаТестДрайв;
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		//	
		//	//Иначе печатаем типовой вариант
			МассивДокументов = Новый Массив;
			МассивДокументов.Добавить(ДокументСсылка);
		//	
		    #Если ТолстыйКлиентОбычноеПриложение Тогда
			Форма = ПолучитьФорму("Документ.CRM_ЗаписьНаТестДрайв.Форма.ФормаЗаполненияДанныхДляПечати");
			Форма.СсылкаНаОбъект = ДокументСсылка;
			Если НЕ Форма.ОткрытьМодально() = Истина Тогда
				Возврат;
			КонецЕсли;		
			CRM_Клиент.ПечатьДокументаВыборФормы(МассивДокументов, "Документ.CRM_ЗаписьНаТестДрайв");
			
			#КонецЕсли

		КонецЕсли;
		
	ИначеЕсли ИмяПоля = "спТестДрайвСобытиеПоРабочемуЛисту" Тогда
		
		//Печать
		#Если ТолстыйКлиентОбычноеПриложение Тогда
		П=Новый Структура("ключ", Запись.СобытиеПоРабочемуЛисту);
		Ответ = ОткрытьФормуМодально("Документ.CRM_СобытияПоРабочимЛистам.Форма.ФормаЗавершенияСобытия", П);
		#КонецЕсли

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьЗаписьНаСервис(ИмяПоля)
	
	Запись = Элементы.спЗаписьНаСервис.ТекущиеДанные;

	Если ИмяПоля = "спЗаписьНаСервисКлиент" Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
		Ответ = Запись.Клиент.ПолучитьФорму("Renault_Форма").ОткрытьМодально();
		#КонецЕсли

	ИначеЕсли ИмяПоля = "спЗаписьНаСервисАвтомобиль" Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
		Ответ = Запись.Автомобиль.ПолучитьФорму("ФормаЭлемента").ОткрытьМодально();
		#КонецЕсли

	ИначеЕсли ИмяПоля = "спЗаписьНаСервисДокумент" Тогда
		
		Если ПроверитьСостояниеНаНезавершенность(Запись.Документ) Тогда
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
			Ответ = Запись.Документ.ПолучитьФорму("ФормаЗавершенияСобытия").ОткрытьМодально();
			#КонецЕсли
		
		Иначе
			
			Вопрос(НСтр("ru = 'Запись уже имеет необходимый статус.'"), РежимДиалогаВопрос.ОК,,,"Предупреждение.");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

