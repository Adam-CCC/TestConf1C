	               |ГДЕ
	               |	CRM_ЗамечанияМенеджерам.ИдентификаторТрафика = &ИдентификаторТрафика
	               |	И CRM_ЗамечанияМенеджерам.Менеджер = &Менеджер";
	Запрос.УстановитьПараметр("Менеджер", Запись.Менеджер);
	Запрос.УстановитьПараметр("ИдентификаторТрафика", Запись.Идентификатор);
	
	ЗаписьЗамечание = РегистрыСведений.CRM_ЗамечанияМенеджерам.СоздатьМенеджерЗаписи();

