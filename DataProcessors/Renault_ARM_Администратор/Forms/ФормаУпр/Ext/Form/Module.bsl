	ТекстЗамечания = ПолучитьЗамечаниеНаСервере(Запись);
		
	ФормаВводаЗамечания = ПолучитьФорму("Обработка.Renault_ARM_Администратор.Форма.ФормаВводаКомментарияУПР");
