&НаКлиенте
Процедура НажатиеКнМеню(Элемент) 
	Для Н=0 По ПунктыМеню.Количество()-1 Цикл
		Если Найти(ТекущийЭлемент.Имя,ПунктыМеню[Н].Значение)>0 Тогда ТекущаяЗакладкаМеню=Н; Прервать КонецЕсли;	
	КонецЦикла;
	УправлениеМеню();
КонецПроцедуры
&НаКлиенте
Процедура УправлениеМеню()
	//скрыть или показать пункты меню в зависимости от набора прав
	Для Каждого Эл Из Элементы.кнМеню.ПодчиненныеЭлементы Цикл Эл.Видимость=ПунктыМеню.НайтиПоЗначению(Сред(Эл.Имя,3))<>Неопределено КонецЦикла;	
	
	//скрыть показать списки
	Для Н=0 По ПунктыМеню.Количество()-1 Цикл 
		Эл=Элементы.Найти("сп"+ПунктыМеню[Н]);
		Если Эл=Неопределено Тогда Продолжить КонецЕсли;
		Эл.Видимость=Н=ТекущаяЗакладкаМеню;
	КонецЦикла;	
	
	//цвета кнопок меню
	ПарамОфр=Renault_ОбщиеФункции.МультибрендПараметрыОформления();
	//Вкл=Новый Цвет(255,207,0);
	Вкл=Вычислить(ПарамОфр.ОсновнойЦвет);
	//Выкл=Вычислить(ПарамОфр.ДопЦвет1);
	//ВыклСерый=Вычислить(ПарамОфр.ДопЦвет1);
	Выкл=Новый Цвет(189,195,206);
	ВыклСерый=Новый Цвет(231,231,231);
	
	Для Н=1 По Элементы.кнМеню.ПодчиненныеЭлементы.Количество() Цикл
		Эл=Элементы.кнМеню.ПодчиненныеЭлементы[Н-1];
		Если НЕ Эл.Видимость Тогда Продолжить КонецЕсли;
		ЭтоТекущаяЗакладка=Сред(Эл.Имя,3)=ПунктыМеню[ТекущаяЗакладкаМеню].Значение;
		Эл.ЦветФона=?(ЭтоТекущаяЗакладка,Вкл,Выкл);  //?(Н=ТекущаяЗакладкаМеню,Вкл,Выкл);
		Эл.ЦветРамки=?(ЭтоТекущаяЗакладка,Вкл,Выкл);
	КонецЦикла;
	
	ИмяЗакладки=ИмяЗакладки();
	Если ИмяЗакладки="РегистрацияТрафика" Тогда
		Элементы.грРегТрафика.Видимость=Истина;
		Элементы.кнОтбор.Видимость=Ложь;
		ОбновитьДиаграммуМенеджера();
	ИначеЕсли ИмяЗакладки="Фото" Тогда
		Элементы.кнОтбор.Видимость=Ложь;
	ИначеЕсли ИмяЗакладки="Диаграммы" Тогда
		Элементы.кнОтбор.Видимость=Ложь;
	Иначе
		Элементы.грРегТрафика.Видимость=Ложь;
		Элементы.кнОтбор.Видимость=Истина;
	КонецЕсли;
	
	//кнопки отчета-диаграммы
	Для Каждого Эл Из Элементы.кнСпДиаграммы.ПодчиненныеЭлементы Цикл
		Эл.ЦветРамки=?(Эл.Имя=ТекущийРежимДиаграммы,Вкл,ВыклСерый);
		Эл.ЦветФона=?(Эл.Имя=ТекущийРежимДиаграммы,Вкл,ВыклСерый);
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура НажатиеКнМенюСписка(Элемент)
	ИмяПунктаМеню=ИмяЗакладки();
	ИмяСписка=ИмяСписка();
	
	Если ТекущийЭлемент.Имя="кнОбновить" Тогда //это действие по умолчанию всегда
		Элементы[ИмяСписка].Обновить();
	ИначеЕсли ТекущийЭлемент.Имя="кнОтбор" Тогда
		
	//	Если ИмяПунктаМеню="Отчеты" Тогда
	//		Renault_ОбщиеФункции.ОткрытьКомпоновщикНастроек(ЭтаФорма,КомпоновщикНастроекОтчета,"ОтборОтчета")
	//	Иначе //динамические списки
	//		
	//		Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
	//			Сообщить("Функционал не доступен",СтатусСообщения.Информация);
	//			Возврат
	//		КонецЕсли;	

	Если ИмяПунктаМеню="Трафик" Тогда 
		Источник=ПолучитьИсточникНаСервере(ИмяСписка); 
	Иначе 
		Источник=ПолучитьПроизвольныйИсточникНаСервере(ИмяСписка);
	КонецЕсли;	
	
	Renault_ОбщиеФункции.ОткрытьФормуОтбора(ЭтаФорма,Источник,ЭтаФорма[ИмяСписка].КомпоновщикНастроек,"ОтборСписка",ИмяСписка,,Истина)
		
	ИначеЕсли ТекущийЭлемент.Имя="кнПериод" Тогда	
		Стр=ОткрытьФормуМодально("ОбщаяФорма.Renault_ВыборПериода",Новый Структура("Дата1,Дата2",Дата1,Дата2),ЭтаФорма,УникальныйИдентификатор);
		Если ТипЗнч(Стр)=Тип("Структура") Тогда
			Дата1=Стр.Дата1;
			Дата2=КонецДня(Стр.Дата2);
			УстановитьПараметрыСписков();
			УстановитьЗаголовок();
		КонецЕсли;	
		
	ИначеЕсли ТекущийЭлемент.Имя="кнПосещение" Тогда
		ОткрытьФорму("Обработка.Renault_ARM_Администратор.Форма.РегистрацияУПР",,ЭтаФорма)
	ИначеЕсли ТекущийЭлемент.Имя="кнЗвонок" Тогда
		ОткрытьФорму("Обработка.Renault_ARM_Администратор.Форма.РегистрацияУПР",,ЭтаФорма)
	ИначеЕсли ТекущийЭлемент.Имя="кнEMAIL" Тогда
		ОткрытьФорму("Обработка.Renault_ARM_Администратор.Форма.РегистрацияУПР",,ЭтаФорма)
	ИначеЕсли ТекущийЭлемент.Имя="кнЛидRenault" Тогда
		ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма",,ЭтаФорма)
	ИначеЕсли ТекущийЭлемент.Имя="кнКонсультант" Тогда
		ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма",,ЭтаФорма)
	ИначеЕсли ТекущийЭлемент.Имя="кнСоцсети" Тогда	
		ОткрытьФорму("Обработка.Renault_АРМ_ОнлайнКонсультант.Форма",,ЭтаФорма)
	
	Иначе 
		Сообщить("Действие кнопки еще не настроено"); Возврат
	КонецЕсли;
	
	//обновление списка - при любом действии кнопок списка
	Если ИмяПунктаМеню="РегистрацияТрафика" Тогда ОбновитьДиаграммуМенеджера()
	ИначеЕсли ИмяПунктаМеню="Диаграммы" Тогда ОтчетДиаграмма()
	//Иначе Элементы[ИмяСписка].Обновить() 
	КонецЕсли;
	
КонецПроцедуры

