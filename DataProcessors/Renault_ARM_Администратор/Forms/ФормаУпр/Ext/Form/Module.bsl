&НаКлиенте
Процедура УстановитьОтметкуУпущен(Запись)
	
	Если Запись <> Неопределено Тогда
		
		ЕстьПризнакУпущен = ПолучитьПризнакУпущенНаСервере(Запись);
					
		Если ЕстьПризнакУпущен Тогда
			//Если Трафик упущен - можно отменить
			ФормаПодтверждения = ПолучитьФорму("Обработка.Renault_ARM_Администратор.Форма.ФормаПодтвержденияУПР");
			ФормаПодтверждения.Заголовок = "Отменить признак 'Упущен'?";
			Ответ = ФормаПодтверждения.ОткрытьМодально();
			Если ЗначениеЗаполнено(Ответ) Тогда			
				ОтменитьПризнакУпущенНаСервере(Запись);
			КонецЕсли;
		ИначеЕсли ЗаписьСуществуетИНеОбработана(Запись) Тогда
			//Отметим как упущенный	
			ФормаВводаЗамечания = ПолучитьФорму("Обработка.Renault_ARM_Администратор.Форма.ФормаВводаПричиныУпущенногоКлиентаУПР");
			ФормаВводаЗамечания.Заголовок = "Ввод причины упущенного клиента";
			Ответ = ФормаВводаЗамечания.ОткрытьМодально();
			Если ЗначениеЗаполнено(Ответ) Тогда
				ОтметитьКакУпущенныйНаСервере(Запись, Ответ);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПризнакУпущенНаСервере(Запись)
	
	Запрос = Новый Запрос;
				
	Запрос.УстановитьПараметр("Идентификатор", Запись.Идентификатор);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	РегистрСведений.Renault_Трафик.СрезПоследних КАК Renault_ТрафикСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CRM_УпущенныйТрафик КАК CRM_УпущенныйТрафик
	|		ПО Renault_ТрафикСрезПоследних.Идентификатор = CRM_УпущенныйТрафик.ИдентификаторТрафика
	|			И (Renault_ТрафикСрезПоследних.Идентификатор = &Идентификатор)";
	
	Результат = Запрос.Выполнить();
	Возврат Не Результат.Пустой();

КонецФункции

&НаСервереБезКонтекста
Функция ОтменитьПризнакУпущенНаСервере(ЗаписьТрафика)
	
	Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ЗаписьТрафика.Идентификатор);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.CRM_УпущенныйТрафик КАК CRM_УпущенныйТрафик
		|ГДЕ
		|	CRM_УпущенныйТрафик.ИдентификаторТрафика = &ИдентификаторТрафика";
	Запрос.УстановитьПараметр("ИдентификаторТрафика", Запись.Идентификатор);
	ВыборкаУпущен = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаУпущен.Следующий() Тогда
		ЗаписьУпущен = РегистрыСведений.CRM_УпущенныйТрафик.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьУпущен, ВыборкаУпущен);
		ЗаписьУпущен.Прочитать();
		ЗаписьУпущен.Удалить();
		Запись.Обработан = Ложь;
		Запись.Записать();	
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОтметитьКакУпущенныйНаСервере(ЗаписьТрафика, Ответ)
	
	Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ЗаписьТрафика.Идентификатор);

	ЗаписьУпущен = РегистрыСведений.CRM_УпущенныйТрафик.СоздатьМенеджерЗаписи();
	ЗаписьУпущен.Период = ТекущаяДата();
	ЗаписьУпущен.ИдентификаторТрафика = ЗаписьТрафика.Идентификатор;
	ЗаписьУпущен.Менеджер = Запись.Менеджер;
	ЗаписьУпущен.ДилерскийЦентр = Запись.ДилерскийЦентр;
	ЗаписьУпущен.Комментарий = Ответ.ТекстКомментарияУпущен;
	ЗаписьУпущен.Причина = Ответ.ПричинаУпущенногоКлиента;
	ЗаписьУпущен.АвторКомментария = Запись.Администратор;
	ЗаписьУпущен.ВидУпущения = Перечисления.CRM_ТипыУпущенияТрафика.Администратор;
	ЗаписьУпущен.Записать();
	
	Запись.Обработан = Истина;
	Запись.Записать();

