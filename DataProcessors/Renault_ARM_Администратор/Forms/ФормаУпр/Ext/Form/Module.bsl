&НаСервереБезКонтекста
Функция ПолучитьЗамечаниеНаСервере(Запись)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ЗамечанияМенеджерам.Период,
	               |	CRM_ЗамечанияМенеджерам.Менеджер,
	               |	CRM_ЗамечанияМенеджерам.ИдентификаторТрафика,
	               |	CRM_ЗамечанияМенеджерам.ТекстЗамечания
	               |ИЗ
	               |	РегистрСведений.CRM_ЗамечанияМенеджерам КАК CRM_ЗамечанияМенеджерам
	               |ГДЕ
	               |	CRM_ЗамечанияМенеджерам.ИдентификаторТрафика = &ИдентификаторТрафика
	               |	И CRM_ЗамечанияМенеджерам.Менеджер = &Менеджер";
	Запрос.УстановитьПараметр("Менеджер", Запись.Менеджер);
	Запрос.УстановитьПараметр("ИдентификаторТрафика", Запись.Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ТекстЗамечания;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
