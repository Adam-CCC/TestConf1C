 	ЗаписьЗамечание = РегистрыСведений.CRM_ЗамечанияМенеджерам.СоздатьМенеджерЗаписи();
	ЗаписьЗамечание.Период = ТекущаяДата();
	ЗаписьЗамечание.ИдентификаторТрафика = Запись.Идентификатор;
	ЗаписьЗамечание.Менеджер = Запись.Менеджер;
	ЗаписьЗамечание.ТекстЗамечания = ТекстЗамечания;
	ЗаписьЗамечание.Записать();
 
КонецПроцедуры

