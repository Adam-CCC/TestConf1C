&НаКлиенте
Процедура ПереключениеДиаграммы(Команда) 
	ТекущийРежимДиаграммы=ТекущийЭлемент.Имя; 
	УправлениеМеню(); 
	Элементы.ОтчетДиаграмма.Видимость=?(ТекущийРежимДиаграммы="ТрафикПоПериодам" или ТекущийРежимДиаграммы="ТрафикВРазрезах",Ложь,Истина);
	Если ТекущийРежимДиаграммы="ТрафикПоПериодам" Тогда
		ОткрытьФорму("Отчет.Renault_ТрафикПоПериодам.Форма.Форма",,ЭтаФорма,УникальныйИдентификатор);
	ИначеЕсли ТекущийРежимДиаграммы="ТрафикВРазрезах" Тогда
		ОткрытьФорму("Отчет.Renault_ТрафикВРазрезах.Форма.ФормаОтчета",,ЭтаФорма,УникальныйИдентификатор);
	Иначе ОтчетДиаграмма() 
	КонецЕсли;	
КонецПроцедуры
Процедура ОтчетДиаграмма()
	
	ОтчетДиаграмма.Очистить();
	ОтчетДиаграмма.Обновление=Ложь;
	ОтчетДиаграмма.АвтоТранспонирование=Ложь;
	ОтчетДиаграмма.АвтоУстановкаИменТочек=Истина;
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Дата1",Дата1);
	Запрос.УстановитьПараметр("Дата2",КонецДня(?(Дата2='00010101',ТекущаяДата(),Дата2)));
	Запрос.УстановитьПараметр("Отдел",Отдел);
	
	Если ТекущийРежимДиаграммы="ПТпоМенеджерам" Тогда
		Точка=ОтчетДиаграмма.УстановитьТочку("- количество первичного трафика -");
		Запрос.Текст="
		|Выбрать
		|	ЕстьNULL(Менеджер, ""Не указан"") Менеджер,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Идентификатор) Количество,
		|	0 КАК Процент
		|ИЗ РегистрСведений.Renault_Трафик
		|ГДЕ Период МЕЖДУ &Дата1 И &Дата2 И Отдел=&Отдел
		|СГРУППИРОВАТЬ ПО Менеджер";
		Табл=Запрос.Выполнить().Выгрузить();
		Всего=Табл.Итог("Количество");
		Для Каждого Строка Из Табл Цикл
			Если Не ЗначениеЗаполнено(Строка.Менеджер) Тогда Строка.Менеджер="Не указан"; КонецЕсли;
			Серия=ОтчетДиаграмма.УстановитьСерию(Строка(Строка.Менеджер));
			Серия.Текст=""+Строка.Менеджер;
			ОтчетДиаграмма.УстановитьЗначение(Точка,Серия,Строка.Количество);
			Строка.Процент=Окр(100*Строка.Количество/Всего,2);
		КонецЦикла;
		
	ИначеЕсли ТекущийРежимДиаграммы="ПТпоМоделям" Тогда
		Точка=ОтчетДиаграмма.УстановитьТочку("- количество первичного трафика -");
		Запрос.Текст="
		|Выбрать
		|	ЕСТЬNULL(Renault_Трафик.ПервичныйИнтерес, ""Не указан"") КАК Модель,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Renault_Трафик.Идентификатор) КАК Количество,
		|	0 КАК Процент
		|ИЗ РегистрСведений.Renault_Трафик КАК Renault_Трафик
		|ГДЕ Renault_Трафик.Период МЕЖДУ &Дата1 И &Дата2 И Renault_Трафик.Отдел = &Отдел
		|СГРУППИРОВАТЬ ПО ЕСТЬNULL(Renault_Трафик.ПервичныйИнтерес, ""Не указан"")";
		Табл = Запрос.Выполнить().Выгрузить();
		Всего=Табл.Итог("Количество");
		Для Каждого Строка Из Табл Цикл
			Если Не ЗначениеЗаполнено(Строка.Модель) Тогда Строка.Модель = "Не указан"; КонецЕсли;
			ОтчетДиаграмма.УстановитьЗначение(Точка, ОтчетДиаграмма.УстановитьСерию(Строка(Строка.Модель)), Строка.Количество);
			Строка.Процент = Окр(100 * Строка.Количество / Всего, 2);
		КонецЦикла;
	ИначеЕсли ТекущийРежимДиаграммы="ПТ_ОП_ИИ" Тогда
		Точка=ОтчетДиаграмма.УстановитьТочку("- количество первичного трафика -");
		Запрос.Текст="
		|Выбрать
		|	ЕстьNULL(Renault_Трафик.ИсточникИнформации, ""Не указан"") КАК ИсточникИнформации,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Renault_Трафик.Идентификатор) КАК Количество,
		|	0 КАК Процент
		|ИЗ РегистрСведений.Renault_Трафик КАК Renault_Трафик
		|ГДЕ Renault_Трафик.Период МЕЖДУ &Дата1 И &Дата2 И Renault_Трафик.Отдел = &Отдел
		|СГРУППИРОВАТЬ ПО Renault_Трафик.ИсточникИнформации";
		Табл=Запрос.Выполнить().Выгрузить();
		Всего=Табл.Итог("Количество");
		Для Каждого Строка Из Табл Цикл
			Если Не ЗначениеЗаполнено(Строка.ИсточникИнформации) Тогда Строка.ИсточникИнформации = "Не указан"; КонецЕсли;
			ОтчетДиаграмма.УстановитьЗначение(Точка, ОтчетДиаграмма.УстановитьСерию(Строка(Строка.ИсточникИнформации)), Строка.Количество);
			Строка.Процент = Окр(100 * Строка.Количество / Всего, 2);
		КонецЦикла;
	ИначеЕсли ТекущийРежимДиаграммы="ТДпоМенедж" Тогда
		Точка=ОтчетДиаграмма.УстановитьТочку("- количество тест-драйвов -");
		Запрос.Текст="
		|Выбрать
		|	0 КАК Процент,
		|	CRM_ПроведенныйТестДрайв.Сотрудник КАК Менеджер,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CRM_ПроведенныйТестДрайв.ID) КАК Количество
		|ИЗ РегистрСведений.CRM_ПроведенныйТестДрайв КАК CRM_ПроведенныйТестДрайв
		|ГДЕ CRM_ПроведенныйТестДрайв.Дата МЕЖДУ &Дата1 И &Дата2
		|СГРУППИРОВАТЬ ПО CRM_ПроведенныйТестДрайв.Сотрудник";
		Табл = Запрос.Выполнить().Выгрузить();
		Всего=Табл.Итог("Количество");
		Для Каждого Строка Из Табл Цикл
			Если Не ЗначениеЗаполнено(Строка.Менеджер) Тогда Строка.Менеджер = "Не указан"; КонецЕсли;
			ОтчетДиаграмма.УстановитьЗначение(Точка, ОтчетДиаграмма.УстановитьСерию(Строка(Строка.Менеджер)), Строка.Количество);
			Строка.Процент = Окр(100 * Строка.Количество / Всего, 2);
		КонецЦикла;
	ИначеЕсли ТекущийРежимДиаграммы="ТДпоМоделям" Тогда
		Точка=ОтчетДиаграмма.УстановитьТочку("- количество тест-драйвов -");
		Запрос.Текст="
		|Выбрать
		|	0 КАК Процент,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CRM_ПроведенныйТестДрайв.ID) КАК Количество,
		|	CRM_ПроведенныйТестДрайв.МодельАвтомобиля КАК Модель
		|ИЗ РегистрСведений.CRM_ПроведенныйТестДрайв КАК CRM_ПроведенныйТестДрайв
		|ГДЕ CRM_ПроведенныйТестДрайв.Дата МЕЖДУ &Дата1 И &Дата2
		|СГРУППИРОВАТЬ ПО CRM_ПроведенныйТестДрайв.МодельАвтомобиля";
		Табл=Запрос.Выполнить().Выгрузить();
		Всего=Табл.Итог("Количество");
		Для Каждого Строка Из Табл Цикл
			Если Не ЗначениеЗаполнено(Строка.Модель) Тогда Строка.Модель = "Не указан"; КонецЕсли;
			ОтчетДиаграмма.УстановитьЗначение(Точка, ОтчетДиаграмма.УстановитьСерию(Строка(Строка.Модель)), Строка.Количество);
			Строка.Процент = Окр(100 * Строка.Количество / Всего, 2);
		КонецЦикла;
	КонецЕсли;
	
	ОтчетДиаграмма.Обновление=Истина;
КонецПроцедуры	

