Процедура кнИсточникИнформации(Команда, Параметр = Неопределено)
	
	Если Параметр = Неопределено ИЛИ СтруктураОткрываемыхФорм.ОткрыватьИсточникИнформации Тогда
		
		Список = ПолучитьСписокИсточниковИнформации();	

		Парам = Новый Структура;
		Парам.Вставить("Список", Список);
		Парам.Вставить("Заголовок", "Выбор источника информации");
		Парам.Вставить("ШиринаЭлемента",17);
		Парам.Вставить("ВысотаЭлемента",2);
		
		//Парам.Вставить("КоличествоЭлементовВСтроке", 4);
		ФормаСписка = ПолучитьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений", Парам);
		Ответ = ФормаСписка.ОткрытьМодально();
		Если ЗначениеЗаполнено(Ответ) Тогда
