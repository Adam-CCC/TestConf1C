Процедура кнПерезвонить(Команда)
	
	Перезвонить = Не Перезвонить;
	ОбновлениеОтображения();

КонецПроцедуры

&НаКлиенте
Процедура кнРегистрация(Команда)
	
	ТрафикУпущен = СтрДлина(ТекстКомментарияУпущен) > 0 ИЛИ ПричинаУпущенногоКлиента <> ПолучитьПричинуУпущенияПустая();
	ЕстьЗамечаниеМенеджеру = (СтрДлина(ТекстЗамечания) > 0);
	МенеджерЗаменен = ЗначениеЗаполнено(МенеджерЗамены);
	СоздаемРЛ = Не ТрафикУпущен И не ЗаписьНаСервис;
	ЕстьТД = ЗначениеЗаполнено(НомерТестДрайва);
	ВОтделПродаж = (Отдел = ОтделАвтосалона);
	
	Если Не ПроверитьЗаполнениеРеквизитов(ТрафикУпущен) Тогда
		Возврат;
	КонецЕсли;

	////////////////////////////////////////////////
	//Фиксация трафика
	
	Если ЗаписьНаСервис = Ложь Тогда
	
		Идентификатор = "";
		Если ЗначениеЗаполнено(Клиент) Тогда
			
			РабЛистКлиента = ПолучитьРабЛистКлиента();
			
			Если ЗначениеЗаполнено(РабЛистКлиента) Тогда
			
				Ответ = Вопрос("По клиенту уже есть рабочий лист в работе: №" + РабЛистКлиента.IDK + ", менеджер:" + РабЛистКлиента.Сотрудник + ". Вы хотите использовать его?", РежимДиалогаВопрос.ДаНет);
				Если Ответ = КодВозвратаДиалога.Да Тогда
					Идентификатор = РабЛистКлиента.IDТрафика;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	кнРегистрацияНаСервере(Идентификатор, ТрафикУпущен, ЕстьТД, ЕстьЗамечаниеМенеджеру, ВОтделПродаж, МенеджерЗаменен);
		
	Закрыть();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПричинуУпущенияПустая()
	Возврат Справочники.CRM_ПричиныУпущенныхКлиентов.ПустаяСсылка();
КонецФункции

&НаСервере
Функция ПолучитьРабЛистКлиента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочиеЛисты.IDK,
	|	Renault_РабочиеЛисты.IDТрафика,
	|	Renault_РабочиеЛисты.Сотрудник
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.Клиент = &Клиент
	|	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;	
	
	Возврат "";
	
КонецФункции

&НаСервере
Процедура кнРегистрацияНаСервере(Идентификатор, ТрафикУпущен, ЕстьТД, ЕстьЗамечаниеМенеджеру, ВОтделПродаж, МенеджерЗаменен)
		
	Если Идентификатор = "" ИЛИ НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		
		ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
		
		ЗаписьТрафик.Период = ТекущаяДата();
		Идентификатор = Новый УникальныйИдентификатор();
		ЗаписьТрафик.ТипТрафика = ТипТрафика;
		ЗаписьТрафик.Идентификатор = Идентификатор;
		ЗаписьТрафик.Менеджер = Сотрудник;
		ЗаписьТрафик.Администратор = Администратор;
		ЗаписьТрафик.Отдел = Отдел;
		ЗаписьТрафик.Клиент = Клиент;
		ЗаписьТрафик.ДилерскийЦентр = ДилерскийЦентр;
		ЗаписьТрафик.ПервичныйИнтерес = Модель;
		ЗаписьТрафик.ИсточникИнформации = ИсточникИнформации;
		ЗаписьТрафик.ПервичныйПовторный = ПервичныйПовторный;
		ЗаписьТрафик.Представление = ФИО;
		ЗаписьТрафик.Обработан = ТрафикУпущен ИЛИ ЕстьТД;
		ЗаписьТрафик.Комментарий = Комментарий;
		
		ЗаписьТрафик.Записать();
		
		//создать задачу в ОФУ
		Задачи.Renault_События.СоздатьНовую("",Справочники.CRM_ВидыСобытий.КонсультацияОФУ,"Консультация ОФУ (трафик "+ТипТрафика+")",ДилерскийЦентр,,Отдел,,Клиент);
		
	КонецЕсли;
	
	//Создадим типизированные колонки в ТЗ
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	CRM_ЗначенияРеквизитовТрафика.РеквизитТрафика КАК РеквизитТрафика,
	                      |	CRM_ЗначенияРеквизитовТрафика.ЗначениеРеквизита КАК ЗначениеРеквизита,
	                      |	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика
	                      |ИЗ
	                      |	РегистрСведений.CRM_ЗначенияРеквизитовТрафика КАК CRM_ЗначенияРеквизитовТрафика
	                      |ГДЕ
	                      |	CRM_ЗначенияРеквизитовТрафика.ИдентификаторТрафика ЕСТЬ NULL ");
	РеквизитыТрафика = Запрос.Выполнить().Выгрузить();
	//Удалим "лишние записи" на всякий случай
	РеквизитыТрафика.Очистить();
	
	//Заполним реквизиты трафика
	
	//Пол
	НовоеСвойство = РеквизитыТрафика.Добавить();
	НовоеСвойство.ИдентификаторТрафика = Идентификатор;
	НовоеСвойство.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Пол;
	НовоеСвойство.ЗначениеРеквизита = Пол;	
	
	Если ТипТрафика = Справочники.CRM_ТипТрафика.EmailДилера Тогда
		
		//email
		НовоеСвойство = РеквизитыТрафика.Добавить();
		НовоеСвойство.ИдентификаторТрафика = Идентификатор;
		НовоеСвойство.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Email;
		НовоеСвойство.ЗначениеРеквизита = Телефон;
		
	Иначе
		
		//Телефон
		НовоеСвойство = РеквизитыТрафика.Добавить();
		НовоеСвойство.ИдентификаторТрафика = Идентификатор;
		НовоеСвойство.РеквизитТрафика = ПланыВидовХарактеристик.CRM_РеквизитыТрафика.Телефон;
		НовоеСвойство.ЗначениеРеквизита = Телефон;
		
	КонецЕсли;
	
	//Запись в регистр
	НЗ = РегистрыСведений.CRM_ЗначенияРеквизитовТрафика.СоздатьНаборЗаписей();
	НЗ.Отбор.ИдентификаторТрафика.Установить(Идентификатор);
	НЗ.Прочитать();
	НЗ.Загрузить(РеквизитыТрафика);
	Нз.Записать();
	
	//Фиксация трафика
	////////////////////////////////////////////////
	
	////////////////////////////////////////////////
	//Фиксация упущенного трафика

	Если ТрафикУпущен Тогда
		
		Запись = РегистрыСведений.CRM_УпущенныйТрафик.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.Менеджер = Сотрудник;
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		Запись.Комментарий = СокрЛП(ТекстКомментарияУпущен);
		Запись.Причина = ПричинаУпущенногоКлиента;
		Запись.АвторКомментария = Администратор;
		Запись.ВидУпущения = Перечисления.CRM_ТипыУпущенияТрафика.Менеджер;
		Запись.Записать();
		
	КонецЕсли;
	
	//Фиксация упущенного трафика
	////////////////////////////////////////////////
	
	////////////////////////////////////////////////
	//Фиксация замечания менеджеру
	
	Если ЕстьЗамечаниеМенеджеру Тогда
		
		Запись = РегистрыСведений.CRM_ЗамечанияМенеджерам.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.Менеджер = Сотрудник;
		Запись.ТекстЗамечания = СокрЛП(ТекстЗамечания);
		Запись.Записать();
		
	КонецЕсли;
	
	//Фиксация замечания менеджеру
	////////////////////////////////////////////////
	
	////////////////////////////////////////////////
	//Фиксация задачи по трафику
	
	Если Перезвонить Тогда
		
		Запись = РегистрыСведений.CRM_ЗадачиПоТрафику.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.ИдентификаторЗадачи = Новый УникальныйИдентификатор;
		Запись.ТипЗадачи = Перечисления.CRM_ТипыЗадачПоТрафику.ПерезвонПоПросьбеКлиента;
		Запись.Менеджер = Сотрудник;
		Запись.Автор = Администратор;
		Запись.Комментарий = СокрЛП(Комментарий);
		Запись.Телефон = Телефон;
		Запись.Представление = ФИО;
		Запись.Обработано = Ложь;
		Запись.Записать();
		
	КонецЕсли;
	
	//Фиксация задачи по трафику
	////////////////////////////////////////////////
	
	////////////////////////////////////////////////
	//Фиксация замены менеджера
	
	Если МенеджерЗаменен Тогда
		
		Запись = РегистрыСведений.CRM_ЗаменыМенеджеров.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.ИдентификаторТрафика = Идентификатор;
		Запись.МенеджерЗаменил = Сотрудник;
		Запись.МенеджерЗаменен = МенеджерЗамены;
		Запись.Записать();
		
	КонецЕсли;
	
	//Фиксация замены менеджера
	////////////////////////////////////////////////
	
	////////////////////////////////////////////////
	//создание рабочего листа и ТД
	
	Если ЕстьТД Тогда
		
		ЗаписьРЛ = Renault_CRM.СоздатьРабочийЛистПоТрафику(ЗаписьТрафик.Идентификатор);
		Если ЗаписьРЛ <> Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	CRM_ЗаписьНаТестДрайв.Ссылка
			               |ИЗ
			               |	Документ.CRM_ЗаписьНаТестДрайв КАК CRM_ЗаписьНаТестДрайв
			               |ГДЕ
			               |	CRM_ЗаписьНаТестДрайв.РабочийЛист = &РабочийЛист
			               |	И CRM_ЗаписьНаТестДрайв.Проведен = ИСТИНА";
			Запрос.УстановитьПараметр("РабочийЛист", НомерТестДрайва);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Об = Выборка.Ссылка.ПолучитьОбъект();
				Об.РабочийЛист = ЗаписьРЛ.IDK;
				Об.Клиент = ЗаписьРЛ.Клиент;
				Об.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗаписьНаСервис и Не ТрафикУпущен Тогда
		
		Документ = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
		
		Документ.Дата = ТекущаяДата();
		Документ.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.СРешепшен;
		Документ.ДилерскийЦентр = ДилерскийЦентр;
		
		//от Вити
		//Документ.Менеджер = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Сотрудник);
		
		Документ.Менеджер = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Администратор);
		
		//the-end
		
		Если ТипЗнч(Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") ИЛИ
			ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			Документ.Клиент = Клиент;
			
		Иначе
		
			Документ.Клиент = ФИО;
		
		КонецЕсли;
		
		Документ.Примечание = Комментарий + " Модель: " + Модель.Наименование;
		Документ.ПервичныйПовторный = ПервичныйПовторный;
		Документ.ОбращениеОбработано = Ложь;
		
		Попытка
		
			Документ.ИдентификаторТрафика = Идентификатор;
			
		Исключение
			
			
		Конецпопытки;
			
		Документ.Жалоба = Жалоба;
		
		Попытка
			
			Документ.ТелефонПримечание = Телефон;
			
		Исключение
			
			Документ.Примечание = Документ.Примечание + " Телефон клиента: " + Телефон;
			
		КонецПопытки;
		
		Документ.Записать();
		
		Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
		
		Напоминание.Отправитель = Администратор;
		
		Напоминание.Подробнее = Документ.Ссылка;
		
		Напоминание.Адресаты.Добавить().Сотрудник = Сотрудник;
		
		ДатаОтправки = ТекущаяДата();
		
		Напоминание.ДатаОтправки = ДатаОтправки;
		
		Напоминание.Комментарий = Комментарий;
		
		Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.НовыйКлиентБезМенеджера;
		
		Напоминание.ПоказыватьС = ДатаОтправки;
		Напоминание.ПоказыватьПо = ДатаОтправки;
		
		Напоминание.Наименование = ФИО;
		Напоминание.Сообщение = "На вас назначен клиент: " + ФИО + " | " + Комментарий + " | " + Модель.Наименование;;
		
		Напоминание.Записать();
		
	КонецЕсли;
	
	//создание рабочего листа и ТД
	////////////////////////////////////////////////
	
	////////////////////////////////////////////////
	//Временно	
	////////////////////////////////////////////////
	//Дилерский код                          
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Отдел", Отдел);
	СтруктураДанных.Вставить("ДилерскийЦентр", ДилерскийЦентр);
	СтруктураДанных.Вставить("ПервичныйПовторный", ПервичныйПовторный);
	СтруктураДанных.Вставить("Модель",Модель);
	СтруктураДанных.Вставить("ИсточникИнформации",ИсточникИнформации);
	СтруктураДанных.Вставить("Комментарий",Комментарий);
	СтруктураДанных.Вставить("Сотрудник",Сотрудник);
	СтруктураДанных.Вставить("Телефон",Телефон);
	СтруктураДанных.Вставить("Администратор",Администратор);
	СтруктураДанных.Вставить("ФИО",ФИО);
	СтруктураДанных.Вставить("ТипТрафика",ТипТрафика);
	СтруктураДанных.Вставить("Перезвонить",Перезвонить);
	СтруктураДанных.Вставить("ТрафикУпущен",ТрафикУпущен);
	Renault_МодульДилера.ПриСозданииТрафика(СтруктураДанных);

	// Внесем в планшет продавца запись о клиенте	
	Если ЗначениеЗаполнено(ДилерскийЦентр) И ВОтделПродаж И ТипТрафика = Справочники.CRM_ТипТрафика.ПосещениеАвтосалона Тогда
		Если ДилерскийЦентр.СинхронизированСПланшетомПродавца = Истина Тогда
			КлиентскиеДанные = Новый Структура;
			Если ЗначениеЗаполнено(Клиент) Тогда
				КлиентскиеДанные.Вставить("Идентификатор", Строка(Клиент.УникальныйИдентификатор()));
				КлиентскиеДанные.Вставить("Имя", Клиент.Имя);
				КлиентскиеДанные.Вставить("Фамилия", Клиент.Фамилия);
				КлиентскиеДанные.Вставить("Отчество", Клиент.Отчество);
				КлиентскиеДанные.Вставить("Телефон", Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Клиент));
				КлиентскиеДанные.Вставить("Email", Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Клиент));
				КлиентскиеДанные.Вставить("ДатаРождения", Клиент.ДатаРождения);
			Иначе
				Если ЗаписьТрафик <> Неопределено Тогда
					КлиентскиеДанные.Вставить("Идентификатор", ЗаписьТрафик.Идентификатор);
					КлиентскиеДанные.Вставить("Имя", ФИО);
					КлиентскиеДанные.Вставить("Фамилия", "");
					КлиентскиеДанные.Вставить("Отчество", "");
					КлиентскиеДанные.Вставить("Телефон", Телефон);
					КлиентскиеДанные.Вставить("Email", "");
					КлиентскиеДанные.Вставить("ДатаРождения", '00010101');
				КонецЕсли;
			КонецЕсли;
			Если КлиентскиеДанные.Свойство("Идентификатор") Тогда
				
				мПараметры = Новый Массив;
				мПараметры.Добавить(ДилерскийЦентр);
				мПараметры.Добавить(КлиентскиеДанные);
				мПараметры.Добавить(ТекущаяДата());
				мПараметры.Добавить(Ложь);
				мПараметры.Добавить(Неопределено);
				
				Если ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
						
					мПараметры.Добавить(Клиент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да);	
				Иначе	
					мПараметры.Добавить(Ложь);	
				КонецЕсли;
				
				//ФоновыеЗадания.Выполнить("Renault_РаботаСSalesTablet.ОбновитьДанныеПоТрафику", мПараметры);
				// внесем в трафик отметку о синхронизации с планшетом продавца
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					ЗаписьТрафика = Renault_CRM.ПолучитьЗаписьТрафикаПоID(Строка(Идентификатор));
					ЗаписьТрафика.Представление = ЗаписьТрафика.Представление;
					ЗаписьТрафика.Записать();
				КонецЕсли;
			
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
			
&НаКлиенте
Функция ПроверитьЗаполнениеРеквизитов(ТрафикУпущен = Ложь)
	
	РеквизитыЗаполнены = Истина;
	МассивНеЗаполненных = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		РеквизитыЗаполнены = Ложь;
		МассивНеЗаполненных.Добавить("Дилерский центр");
	КонецЕсли;
	
	Если Перезвонить Тогда
		
		Если Не ЗначениеЗаполнено(Телефон) И МассивНеЗаполненных.Найти("Телефон") = Неопределено Тогда
			РеквизитыЗаполнены = Ложь;
			МассивНеЗаполненных.Добавить("Телефон");
		КонецЕсли;
		
	КонецЕсли;
		
	Если Не ТрафикУпущен Тогда
	
		Если Не ЗначениеЗаполнено(Пол) Тогда
			РеквизитыЗаполнены = Ложь;
			МассивНеЗаполненных.Добавить("Пол");
		КонецЕсли;
			
		Если Не ЗначениеЗаполнено(Отдел) Тогда
			РеквизитыЗаполнены = Ложь;
			МассивНеЗаполненных.Добавить("Отдел");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПервичныйПовторный) Тогда
			РеквизитыЗаполнены = Ложь;
			МассивНеЗаполненных.Добавить("Первичный / Повторный");
		КонецЕсли;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(ТекстКомментарияУпущен) Тогда
			РеквизитыЗаполнены = Ложь;
			МассивНеЗаполненных.Добавить("Текст причины упущенного клиента");
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Администратор) Тогда
		РеквизитыЗаполнены = Ложь;
		МассивНеЗаполненных.Добавить("Администратор");
	КонецЕсли;
	
	Если Не РеквизитыЗаполнены Тогда
		Текст = "Не заполнены поля: ";
		НужнаЗапятая = Ложь;
		Для Каждого Поле Из МассивНеЗаполненных Цикл
			Если НужнаЗапятая Тогда
				Текст = Текст + ", ";
			Иначе
				НужнаЗапятая = Истина;
			КонецЕсли;
			Текст = Текст + Строка(Поле);
		КонецЦикла;							
		Предупреждение(Текст);
	КонецЕсли;
	
	Возврат РеквизитыЗаполнены;
	
КонецФункции

