
&НаКлиенте 
Перем СтруктураОткрываемыхФорм;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаписьНаСервис = Ложь;
	Жалоба = Ложь;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//брендовое оформление
	Массив=Новый Массив;
	Массив.Добавить(Элементы.кнРегистрация);	
	Массив.Добавить(Элементы.КнопкаКарточкаКлиента);	
	
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветФона","ОсновнойЦвет");
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветРамки","ОсновнойЦвет");
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветТекста","ЦветТекста");

	Если ЗначениеЗаполнено(ЭтаФорма.ВладелецФормы) Тогда
		Если ЭтаФорма.ВладелецФормы.ТекущийЭлемент.Имя = "кнПосещение" Тогда
			ЭтаФорма.Заголовок = НСтр("ru = 'Регистрация нового трафика. Посещение'");
		ИначеЕсли ЭтаФорма.ВладелецФормы.ТекущийЭлемент.Имя = "кнЗвонок" Тогда
			ЭтаФорма.Заголовок = НСтр("ru = 'Регистрация нового трафика. Звонок'");
		ИначеЕсли ЭтаФорма.ВладелецФормы.ТекущийЭлемент.Имя = "кнEmail" Тогда
			ЭтаФорма.Заголовок = НСтр("ru = 'Регистрация нового трафика. Email'");
			Элементы.ДекорацияТелефон.Картинка = БиблиотекаКартинок.Renault_Mail_New_20;
			Элементы.Телефон.Маска =  "";	
		КонецЕсли;
	КонецЕсли;
		
	ЗаполнитьДанныеНаСервере();

    ОпределитьТипТрафикаНаСервере(ЭтаФорма.ВладелецФормы.ТекущийЭлемент.Имя);
				
	ОбновитьСтруктуруОткрываемыхФорм();
	ОбновлениеОтображения();
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьТипТрафикаНаСервере(Владелец)
	
	Если Владелец = "кнПосещение" Тогда
		ТипТрафика = Справочники.CRM_ТипТрафика.ПосещениеАвтосалона;
	ИначеЕсли Владелец = "кнЗвонок" Тогда
		ТипТрафика = Справочники.CRM_ТипТрафика.Звонок;
	ИначеЕсли Владелец = "кнEmail" Тогда
		ТипТрафика = Справочники.CRM_ТипТрафика.EmailДилера;
	ИначеЕсли Владелец = "кнЛидRenault" Тогда
		ТипТрафика = Справочники.CRM_ТипТрафика.ЛидДилера;
	Иначе
		ТипТрафика = Справочники.CRM_ТипТрафика.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипТрафика <> Справочники.CRM_ТипТрафика.EmailДилера Тогда
		
		Если ЗначениеЗаполнено(ДилерскийЦентр) Тогда
			ПервыйСимволТелефона = ДилерскийЦентр.ПервыйСимволТелефона;
			
			Если НЕ ПустаяСтрока(ПервыйСимволТелефона) Тогда
				МаскаТелефона = Элементы.Телефон.Маска;
				
				ОстатокМаски = Прав(МаскаТелефона, СтрДлина(МаскаТелефона) - 1);
				
				МаскаТелефона = ПервыйСимволТелефона + ОстатокМаски;
				
				Элементы.Телефон.Маска = МаскаТелефона;
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеНаСервере()
	
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	ОтделАвтосалона = Renault_CRM.ПолучитьОтделАвтосалона(ДилерскийЦентр); 
	Марка = ОтделАвтосалона.БрендМарка;

	ЗаполнятьАдминистратораТрафикаТекущимПользователем = ПараметрыСеанса.Renault_ПраваПользователя.ЗаполнятьАдминистратораТрафикаТекущимПользователем;
	
	Если ЗаполнятьАдминистратораТрафикаТекущимПользователем Тогда
		Администратор = ПараметрыСеанса.Пользователь.Сотрудник;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтруктуруОткрываемыхФорм()
	
	СтруктураОткрываемыхФорм = Новый Структура;
	СтруктураОткрываемыхФорм.Вставить("ОткрыватьИсточникИнформации", Истина);
	СтруктураОткрываемыхФорм.Вставить("ОткрыватьМодель", Истина);
	СтруктураОткрываемыхФорм.Вставить("ОткрыватьМенеджер", Истина);
	СтруктураОткрываемыхФорм.Вставить("ОткрыватьАдминистратор", Истина);
	
	СтрокаНастроек = ПолучитьНастройкиТрафика(ДилерскийЦентр, Отдел, ПервичныйПовторный, ТипТрафика);
	
	Если СтрокаНастроек.Количество()>0 Тогда
		СтруктураОткрываемыхФорм.Вставить("ОткрыватьИсточникИнформации", СтрокаНастроек.ОткрыватьИсточникИнформации);
		СтруктураОткрываемыхФорм.Вставить("ОткрыватьМодель", СтрокаНастроек.ОткрыватьМодель);
		СтруктураОткрываемыхФорм.Вставить("ОткрыватьМенеджер", СтрокаНастроек.ОткрыватьМенеджер);
		СтруктураОткрываемыхФорм.Вставить("ОткрыватьАдминистратор", СтрокаНастроек.ОткрыватьАдминистратор);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНастройкиТрафика(ДилерскийЦентр, Отдел, ПервичныйПовторный, ТипТрафика)
	
	СтруктураНастроек = Новый Структура;

	Если ДилерскийЦентр <> Справочники.CRM_ДилерскиеЦентры.ПустаяСсылка() И Отдел <> Справочники.CRM_Отделы.ПустаяСсылка() И ПервичныйПовторный <> Перечисления.CRM_ПервичныйПовторный.ПустаяСсылка() Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ТипТрафика", ТипТрафика);
		Отбор.Вставить("Отдел", ?(Отдел.ПродажаАвтомобилей, "Отдел продаж", "Другой отдел"));
		Отбор.Вставить("ПервичныйПовторный", ПервичныйПовторный);
		НастройкиРегистрацииТрафика = ДилерскийЦентр.НастройкиРегистрацииТрафика.НайтиСтроки(Отбор);
		Если НастройкиРегистрацииТрафика.Количество()>0 Тогда
		    СтруктураНастроек.Вставить("ОткрыватьИсточникИнформации", НастройкиРегистрацииТрафика[0].ОткрыватьИсточникИнформации);
		    СтруктураНастроек.Вставить("ОткрыватьМодель", НастройкиРегистрацииТрафика[0].ОткрыватьМодель);
		    СтруктураНастроек.Вставить("ОткрыватьМенеджер", НастройкиРегистрацииТрафика[0].ОткрыватьМенеджер);
		    СтруктураНастроек.Вставить("ОткрыватьАдминистратор", НастройкиРегистрацииТрафика[0].ОткрыватьАдминистратор);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураНастроек;

КонецФункции

&НаКлиенте
Процедура ОбновлениеОтображения()
	
	Парам=Renault_ОбщиеФункции.МультибрендПараметрыОформления();

	ЦветРено = Вычислить(Парам.ОсновнойЦвет);;
	ЦветБелый = Новый Цвет(255, 255, 255);
	ЦветСерый = Новый Цвет(153, 153, 153);
	
	ЦветЗаполнено = ЦветРено;
	ЦветРамкиНеВыбрано = Новый Цвет(153, 153, 153);
	ЦветНеЗаполнено = Новый Цвет(49, 52, 49);
	ЦветВыбрано = Вычислить(Парам.ОсновнойЦвет);
	ЦветНеВыбрано = Новый Цвет(49, 52, 49);
	ЦветВыбрано = ЦветРено;
	ЦветРамкиВыбрано = Вычислить(Парам.ОсновнойЦвет);
	ЦветТекстаВыбрано = Новый Цвет(49, 52, 49); //Черный
	ЦветФонаНеВыбрано = Новый Цвет(212, 212, 212); //Серый
	ЦветФонаВыбрано = ЦветРено;
	
	ПараметрыРаскраски = ПолучитьПараметрыРаскраскиФормы();
	
	ВыделятьКнИсточникИнформации = ЗначениеЗаполнено(ИсточникИнформации);
	ВыделятьКнМодель = ЗначениеЗаполнено(Модель);
	ВыделятьКнМенеджер = ЗначениеЗаполнено(Сотрудник);
	ВыделятьКнАдминистратор = ЗначениеЗаполнено(Администратор);
	
	ВыделятьКнОтделПродажи = ЗначениеЗаполнено(Отдел) И (Отдел = ОтделАвтосалона);
	ВыделятьКнОтделДругой = ЗначениеЗаполнено(Отдел) И (Отдел <> ОтделАвтосалона);
	
	ВыделятьКнЗамечаниеМенеджеру = (СтрДлина(СокрЛП(ТекстЗамечания)) > 0);
	ВыделятьКнУпущенныйКлиент = ЗначениеЗаполнено(ПричинаУпущенногоКлиента);
	ВыделятьКнЗаменаМенеджера = ЗначениеЗаполнено(МенеджерЗамены);
	ВыделятьКнПерезвонить = Перезвонить;

	Элементы.кнИсточникИнформации.Видимость = ПараметрыРаскраски.ВидимостьКнИсточникИнформации;
	Элементы.кнЗаменаМенеджера.Видимость = ПараметрыРаскраски.ВидимостьКнЗаменаМенеджера;
	
	Элементы.кнВыборДЦ.Заголовок = Строка(ДилерскийЦентр);
	
	Кнопка = Элементы.кнТипПервичный;
	Если ПараметрыРаскраски.ВыделятьКнПервичный Тогда
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнТипПовторный;
	Если ПараметрыРаскраски.ВыделятьКнПовторный Тогда
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнТипЖалоба;
	
	Если Жалоба Тогда
		
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = WebЦвета.Красный;
		
	Иначе
		
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = Новый Цвет (128,0,0);
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
		
	КонецЕсли;
	
	Кнопка = Элементы.кнПолМужской;
	Если ПараметрыРаскраски.ВыделятьКнПолМужской Тогда
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнПолЖенский;
	Если ПараметрыРаскраски.ВыделятьКнПолЖенский Тогда
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнОтделПродажи;
	Если ВыделятьКнОтделПродажи Тогда
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнОтделДругой;
	Если ВыделятьКнОтделДругой Тогда
		Кнопка.Заголовок = "Отдел: " + Строка(Отдел);
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.Заголовок = "Другой отдел";
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнИсточникИнформации;
	Если ВыделятьКнИсточникИнформации Тогда
		Кнопка.Заголовок = "Источник информации: " + Строка(ИсточникИнформации);
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.Заголовок = "Источник информации: не заполнено";
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеЗаполнено;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнМодель;
	Если ВыделятьКнМодель Тогда
		Кнопка.Заголовок = "Модель: " + Строка(Модель);
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.Заголовок = "Модель: не заполнено";
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеЗаполнено;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнМенеджер;
	Если ЗаписьНаСервис Тогда
	
		Если ВыделятьКнМенеджер Тогда
			Кнопка.Заголовок = "Мастер-приемщик: " + Строка(Сотрудник);
			Кнопка.ЦветРамки = ЦветРамкиВыбрано;
			Кнопка.ЦветТекста = ЦветТекстаВыбрано;
			Кнопка.ЦветФона = ЦветФонаВыбрано;
		Иначе
			Кнопка.Заголовок = "Мастер-приемщик: не заполнено";
			Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
			Кнопка.ЦветТекста = ЦветНеЗаполнено;
			Кнопка.ЦветФона = ЦветФонаНеВыбрано;
		КонецЕсли;
		
		Элементы.кнТипЖалоба.Видимость = Истина;
		
	Иначе
		
		Если ВыделятьКнМенеджер Тогда
			Кнопка.Заголовок = "Менеджер: " + Строка(Сотрудник);
			Кнопка.ЦветРамки = ЦветРамкиВыбрано;
			Кнопка.ЦветТекста = ЦветТекстаВыбрано;
			Кнопка.ЦветФона = ЦветФонаВыбрано;
		Иначе
			Кнопка.Заголовок = "Менеджер: не заполнено";
			Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
			Кнопка.ЦветТекста = ЦветНеЗаполнено;
			Кнопка.ЦветФона = ЦветФонаНеВыбрано;
		КонецЕсли;
		
		Элементы.кнТипЖалоба.Видимость = Ложь;
	
	КонецЕсли;

	Кнопка = Элементы.кнАдминистратор;
	Если ВыделятьКнАдминистратор Тогда
		Кнопка.Заголовок = "Администратор: " + Строка(Администратор);
		Кнопка.ЦветРамки = ЦветРамкиВыбрано;
		Кнопка.ЦветТекста = ЦветТекстаВыбрано;
		Кнопка.ЦветФона = ЦветФонаВыбрано;
	Иначе
		Кнопка.Заголовок = "Администратор: не заполнено";
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеЗаполнено;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнЗамечаниеМенеджеру;
	Если ВыделятьКнЗамечаниеМенеджеру Тогда
		Кнопка.ЦветРамки = ЦветРено;
		Кнопка.ЦветТекста = ЦветРено;
		Кнопка.ЦветФона = ЦветБелый;
	Иначе
		Кнопка.ЦветРамки = ЦветСерый;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнУпущенныйКлиент;
	Если ВыделятьКнУпущенныйКлиент Тогда
		Кнопка.ЦветРамки = ЦветРено;
		Кнопка.ЦветТекста = ЦветРено;
		Кнопка.ЦветФона = ЦветБелый;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветНеВыбрано;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнЗаменаМенеджера;
	Если ВыделятьКнЗаменаМенеджера Тогда		
		Кнопка.ЦветРамки = ЦветРено;
		Кнопка.ЦветТекста = ЦветРено;
		Кнопка.ЦветФона = ЦветБелый;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = ЦветРено;
		Кнопка.ЦветФона = ЦветФонаНеВыбрано;
	КонецЕсли;
	
	Кнопка = Элементы.кнПерезвонить;
	Если ВыделятьКнПерезвонить Тогда		
		Кнопка.ЦветРамки = ЦветРено;
		Кнопка.ЦветТекста = Новый Цвет(49, 52, 49);
		Кнопка.ЦветФона = ЦветРено;
		Кнопка.Картинка = БиблиотекаКартинок.Renault_Confirm_Square;
	Иначе
		Кнопка.ЦветРамки = ЦветРамкиНеВыбрано;
		Кнопка.ЦветТекста = Новый Цвет(49, 52, 49);
		Кнопка.ЦветФона = Новый Цвет(245, 245, 245);
		Кнопка.Картинка = БиблиотекаКартинок.Renault_Square_NEw;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Клиент) Тогда
		Элементы.КнопкаКарточкаКлиента.Видимость = Истина;
	Иначе
		Элементы.КнопкаКарточкаКлиента.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыРаскраскиФормы()
	
	ПараметрыРаскраски = Новый Структура;
	
	ПараметрыРаскраски.Вставить("ВыделятьКнПервичный", ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный);
	ПараметрыРаскраски.Вставить("ВыделятьКнПовторный", ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный);
	
	ПараметрыРаскраски.Вставить("ВыделятьКнПолМужской", Пол = Перечисления.ПолФизическихЛиц.Мужской);
	ПараметрыРаскраски.Вставить("ВыделятьКнПолЖенский", Пол = Перечисления.ПолФизическихЛиц.Женский);
		
	ПараметрыРаскраски.Вставить("ВидимостьКнИсточникИнформации", НЕ ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный);
	ПараметрыРаскраски.Вставить("ВидимостьКнЗаменаМенеджера", ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный);
	
	Возврат ПараметрыРаскраски;

КонецФункции

&НаКлиенте
Процедура ФИОПриИзменении(Элемент)
	
	Если СтрДлина(ФИО) > 0 и Не ЗначениеЗаполнено(Клиент) Тогда
		
		Однофамильцы = ПолучитьКлиентовПоФИО(ФИО);
		
		Если Однофамильцы.Количество()>0 Тогда
			Парам = Новый Структура;
			Парам.Вставить("Список", Однофамильцы);
			Парам.Вставить("Заголовок", "Найдены клиенты с ФИО");

			ФормаСписка = ПолучитьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений", Парам);
			
			Ответ = ФормаСписка.ОткрытьМодально();
			Если Ответ <> Неопределено Тогда
				Клиент = Ответ;
				ФИО = Ответ.Наименование;
				Пол = Ответ.Пол;
				Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Клиент);
				ОбновлениеОтображения();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКлиентовПоФИО(ФИО)
	
	сКлиентов = Новый СписокЗначений;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_НормализованныеКонтактыДляПоиска.Объект
	|ИЗ
	|	РегистрСведений.Renault_НормализованныеКонтактыДляПоиска КАК Renault_НормализованныеКонтактыДляПоиска
	|ГДЕ
	|	(Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.Контрагенты
	|			ИЛИ Renault_НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.CRM_ПотенциальныеКонтрагенты)
	|	И Renault_НормализованныеКонтактыДляПоиска.Объект.Наименование подобно &Наименование";
	Запрос.УстановитьПараметр("Наименование", "%"+СокрЛП(ФИО)+"%");
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат сКлиентов;
	КонецЕсли;
	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл
		сКлиентов.Добавить(Выборка.Объект, Строка(Выборка.Объект));
	КонецЦикла;

	Возврат сКлиентов;
	
КонецФункции

&НаКлиенте
Процедура кнВыборДЦНажатие(Команда)
	
	ОтделАвтосалона = Неопределено;
	
	Список = Renault_CRM.ПолучитьСписокДилерскихЦентров();
	
	Парам = Новый Структура;
	Парам.Вставить("Список", Список);
	Парам.Вставить("Заголовок", "Выбор дилерского центра");
	//Парам.Вставить("КоличествоЭлементовВСтроке", 2);
	Парам.Вставить("ШиринаЭлемента",17);
	Парам.Вставить("ВысотаЭлемента",2);

	ФормаСписка = ПолучитьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений", Парам);
	
	Ответ = ФормаСписка.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		ДилерскийЦентр = Ответ;
	Иначе
		ДилерскийЦентр = Неопределено;
	КонецЕсли;
	
	Отдел = Неопределено;
	Сотрудник = Неопределено;
	
	ОтделАвтосалона = Renault_CRM.ПолучитьОтделАвтосалона(ДилерскийЦентр); 
	Марка = ОтделАвтосалона.БрендМарка;
	
	ОбновитьСтруктуруОткрываемыхФорм();
	
	ОбновлениеОтображения();

КонецПроцедуры

&НаКлиенте
Процедура ТелефонПриИзменении(Элемент)
	
	Если ТипТрафика = ТипТрафикаЭлПисьмо() Тогда
		
		ВыбратьКонтрагентаПоEmail();
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		ВыбратьКонтрагентаПоТелефону();
	КонецЕсли;

