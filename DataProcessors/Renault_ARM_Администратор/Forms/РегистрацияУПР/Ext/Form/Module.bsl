&НаСервереБезКонтекста
Функция ТипТрафикаЭлПисьмо()
	Возврат Справочники.CRM_ТипТрафика.EmailДилера;
КонецФункции

&НаКлиенте
Процедура ТелефонОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	Если ТипТрафика <> ТипТрафикаЭлПисьмо() Тогда
		
		ДлинаТекста = СтрДлина(Текст);
		
		ТекстЗамечанияПервый = "";
		Если ДлинаТекста < 11 Тогда
			ТекстЗамечанияПервый = "Телефон состоит из - " + ДлинаТекста + " цифр, а должен состоять из 11 цифр" + Символы.ПС;
		КонецЕсли;
		
		СтрокаПроверки = "0123456789+";
		ТекстЗамечанияВторой = "";
		
		Для Счетчик = 1 По ДлинаТекста Цикл
			СимволСтроки = Сред(Текст, Счетчик, 1);
			
			Если СтрЧислоВхождений(СтрокаПроверки, СимволСтроки) = 0 Тогда
				ТекстЗамечанияВторой = "В номере телефон, кроме цифр и знака ""+"", не должно содержаться других символов!";
				Прервать;
			КонецЕсли;			
		КонецЦикла;
		
		ОбщийТекстЗамечания = ТекстЗамечанияПервый + ТекстЗамечанияВторой;
		
		Если ЗначениеЗаполнено(ОбщийТекстЗамечания) Тогда
			Предупреждение(ОбщийТекстЗамечания,, "Замечание по вводу номера телефона");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

