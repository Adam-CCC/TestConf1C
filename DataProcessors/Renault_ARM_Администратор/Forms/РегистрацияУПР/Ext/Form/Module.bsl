&НаКлиенте
Процедура ВыбратьКонтрагентаПоEmail()
	
	НайденныеКлиенты = НайтиСписокПоEmail(Телефон);
	
	Если НайденныеКлиенты.Количество() = 1 Тогда
		
		Ответ = НайденныеКлиенты[0].Контрагент;
		Если ЗначениеЗаполнено(Ответ) Тогда
			Клиент = Ответ;
			ФИО = Ответ.Наименование;
			Пол = Ответ.Пол;
			ОбновлениеОтображения();
		КонецЕсли;
		
		Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Ответ);
		
	ИначеЕсли  НайденныеКлиенты.Количество() > 1 Тогда
		
		сКлиентов = Новый СписокЗначений;
		Для Каждого СтрТЗ из НайденныеКлиенты Цикл
			сКлиентов.Добавить(СтрТЗ.Контрагент, Строка(СтрТЗ.Контрагент));
		КонецЦикла;
		
		Парам = Новый Структура;
		Парам.Вставить("Список",сКлиентов);
		Парам.Вставить("Заголовок", "Найдены клиенты с данным телефоном");
		Парам.Вставить("КоличествоЭлементовВСтроке",2);

		ФормаСписка = ПолучитьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений", Парам);
		
		Ответ = ФормаСписка.ОткрытьМодально();
		Если Ответ <> Неопределено Тогда
			Клиент = Ответ;
			ФИО = Ответ.Наименование;
			Пол = Ответ.Пол;
			ОбновлениеОтображения();
		КонецЕсли;
		
		Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Ответ);
			
	КонецЕсли;
			
КонецПроцедуры

