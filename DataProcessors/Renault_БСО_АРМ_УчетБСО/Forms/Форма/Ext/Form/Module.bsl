&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ПараметрыСеанса.Renault_ПраваПользователя.РазрешитьРаботуАРМБСО Тогда 
		Отказ=Истина;
		Сообщить("Нет прав на Учет БСО",СтатусСообщения.Внимание);
	КонецЕсли;
	
	ТекущийЭлемент=Элементы.кнПриход;
	ПереключитьЗакладку();
КонецПроцедуры

&НаКлиенте
Процедура кнДействие(Команда)
	ИмяСписка="СпБСО";
	
	//закладки	
	Если ТекущийЭлемент.Имя="кнПриход" или ТекущийЭлемент.Имя="кнРасход" или ТекущийЭлемент.Имя="кнВозврат" или ТекущийЭлемент.Имя="кнПолисы" Тогда ПереключитьЗакладку()
		
	//отчеты		
	ИначеЕсли ТекущийЭлемент.Имя="кнОтчетСостояние" Тогда ОткрытьФорму("Отчет.Renault_БСО_СостоянияБСО.Форма.ФормаОтчета",,ЭтаФорма,УникальныйИдентификатор)
	ИначеЕсли ТекущийЭлемент.Имя="кнОтчетДвижения" Тогда ОткрытьФорму("Отчет.Renault_БСО_ДвиженияБСО.Форма.ФормаОтчета",,ЭтаФорма,УникальныйИдентификатор)	
		
	//управление Списком
	//ИначеЕсли ТекущийЭлемент.Имя="кнДобавить" Тогда 
	//ИначеЕсли ТекущийЭлемент.Имя="кнУдалить" Тогда
	//ИначеЕсли ТекущийЭлемент.Имя="кнОбновить" Тогда
	ИначеЕсли ТекущийЭлемент.Имя="кнПериод" Тогда
		НастройкаПериода=Новый НастройкаПериода;
		НастройкаПериода.ДатаНачала=Элементы[ИмяСписка].Период.ДатаНачала;
		НастройкаПериода.ДатаОкончания=Элементы[ИмяСписка].Период.ДатаОкончания;
		НастройкаПериода.ВариантПериода=ВариантПериода.ПроизвольныйИнтервал;
		НастройкаПериода.Редактировать();
		Элементы[ИмяСписка].Период.ДатаНачала=НастройкаПериода.ДатаНачала;
		Элементы[ИмяСписка].Период.ДатаОкончания=НастройкаПериода.ДатаОкончания;
		Элементы[ИмяСписка].Обновить();
		
	ИначеЕсли ТекущийЭлемент.Имя="кнОтбор" Тогда
		Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
			Сообщить("Функционал не доступен",СтатусСообщения.Информация);
			Возврат
		КонецЕсли;
		
		Источник=Renault_ОбщиеФункции.ИсточникДанныхФормы(ЭтаФорма,ИмяСписка);
		Renault_ОбщиеФункции.ОткрытьФормуОтбора(ЭтаФорма,Источник,ЭтаФорма[ИмяСписка].КомпоновщикНастроек,"ОтборСписка",ИмяСписка,,Истина);
		
	ИначеЕсли ТекущийЭлемент.Имя="кнЗакрыть" Тогда Закрыть()
	КонецЕсли;	
	
КонецПроцедуры
&НаКлиенте
Процедура ОтборСписка(КомпНастроек,ИмяСписка) Экспорт
	Если КомпНастроек=Неопределено Тогда Возврат КонецЕсли;		
	ЭтаФорма[ИмяСписка].КомпоновщикНастроек.ЗагрузитьФиксированныеНастройки(КомпНастроек.ФиксированныеНастройки);
	//ЭтаФорма[ИмяСписка].КомпоновщикНастроек.ЗагрузитьНастройки(КомпоновщикНастроек.Настройки);
	//ЭтаФорма[ИмяСписка].КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);
	//ЭтаФорма[ИмяСписка].КомпоновщикНастроек.ЗагрузитьФиксированныеНастройки(КомпоновщикНастроек.ФиксированныеНастройки);
КонецПроцедуры

Процедура ПереключитьЗакладку()
	Если ТекущийЭлемент.Имя="кнПриход" Тогда
		СпБСО.ОсновнаяТаблица="Документ.Renault_БСО_ПриходБланковСтрогойОтчетности"
	ИначеЕсли ТекущийЭлемент.Имя="кнРасход" Тогда
		СпБСО.ОсновнаяТаблица="Документ.Renault_БСО_РасходБланковСтрогойОтчетности"
	ИначеЕсли ТекущийЭлемент.Имя="кнВозврат" Тогда
		СпБСО.ОсновнаяТаблица="Документ.Renault_БСО_ВозвратБланковСтрогойОтчетности"
	ИначеЕсли ТекущийЭлемент.Имя="кнПолисы" Тогда
		СпБСО.ОсновнаяТаблица="Документ.Renault_СтраховойПолис"
	КонецЕсли;
	
	Заголовок="Бланки строгой отчетности ("+ТекущийЭлемент.Заголовок+")";
	
	//цвета кнопок меню
	Вкл=Новый Цвет(255,207,0);
	Выкл=Новый Цвет(189,195,206);
	
	Для Каждого Эл Из Элементы.кнЗакладки.ПодчиненныеЭлементы Цикл
		Если Эл=ТекущийЭлемент Тогда
			Эл.ЦветФона=Вкл;
			Эл.ЦветРамки=Вкл;
		Иначе
			Эл.ЦветФона=Выкл;
			Эл.ЦветРамки=Выкл;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

