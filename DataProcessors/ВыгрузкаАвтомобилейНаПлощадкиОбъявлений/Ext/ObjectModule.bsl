Функция ВернутьXMLкакСтроку() Экспорт

	ТЗ = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
		
 	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиАвтомобилейОстатки.Автомобиль,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.VIN КАК VIN,
		|	СУММА(ОстаткиАвтомобилейОстатки.КоличествоОстаток) КАК Остаток,
		|	ЦенаАвто.Цена КАК Цена,
		|	ХарАвто.Значение КАК ВидАвто,
		|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение.ДилерскийЦентр КАК ДилерскийЦентр,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.МодельАвтоРу.МаркаАвтоРу КАК МаркаАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.МодельАвтоРу КАК МодельАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.МодификацияАвтоРу КАК МодификацияАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СпециальнаяЦена КАК СпециальнаяЦена,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриПокупкеВКредит КАК СкидкаПриПокупкеВКредит,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриСтраховании КАК СкидкаПриСтраховании,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидаПриПокупкеВТрейдИн КАК СкидаПриПокупкеВТрейдИн,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаМаксимальная КАК СкидкаМаксимальная,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка КАК Марка,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка.Наименование КАК МаркаНаименование,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель КАК Модель,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Наименование КАК МодельНаименование,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации КАК ВариантКомплектации,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации.Наименование КАК ВариантКомплектацииНаименование
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЦеныАвтомобилейСрезПоследних.Цена КАК Цена,
		|			ЦеныАвтомобилейСрезПоследних.Автомобиль КАК Автомобиль,
		|			ЦеныАвтомобилейСрезПоследних.ВариантКомплектации КАК ВариантКомплектации,
		|			ЦеныАвтомобилейСрезПоследних.ТипЦен КАК ТипЦен
		|		ИЗ
		|			РегистрСведений.ЦеныАвтомобилей.СрезПоследних КАК ЦеныАвтомобилейСрезПоследних
		|		ГДЕ
		|			ЦеныАвтомобилейСрезПоследних.ТипЦен = &ТипЦен) КАК ЦенаАвто
		|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ЦенаАвто.Автомобиль
		|			И ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации = ЦенаАвто.Автомобиль.ВариантКомплектации
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
		|			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
		|			АвтомобилиСрезПоследних.Значение КАК Значение
		|		ИЗ
		|			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
		|		ГДЕ
		|			АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения) КАК ХарАвто
		|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ХарАвто.Автомобиль
		|ГДЕ
		|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
		|	И ХарАвто.Значение = &НовыйАвтомобиль
 		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиАвтомобилейОстатки.Автомобиль,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.VIN,
		|	ЦенаАвто.Цена,
		|	ХарАвто.Значение,
		|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение.ДилерскийЦентр,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.МодельАвтоРу.МаркаАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.МодельАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.МодификацияАвтоРу,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СпециальнаяЦена,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриПокупкеВКредит,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаПриСтраховании,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидаПриПокупкеВТрейдИн,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.СкидкаМаксимальная,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка.Наименование,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Наименование,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации,
		|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации.Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	МаркаНаименование,
		|	МодельНаименование,
		|	ВариантКомплектации";
 		Запрос.УстановитьПараметр("Марка", Марка);	

	
	Запрос.УстановитьПараметр("ТипЦен", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
 	Запрос.УстановитьПараметр("ВидЗначения",Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля);
	Запрос.УстановитьПараметр("НовыйАвтомобиль",Перечисления.ВидАвтомобиля.Новый);
 	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
 	//ВремФайл = Новый Файл;
	XML=Новый ЗаписьXML();
	
	//ИмяВремФайл = СокрЛП(КаталогВременныхФайлов()+"For_Avto_RU.xml");
	//  
	//XML.ОткрытьФайл(ИмяВремФайл);
	
	XML.УстановитьСтроку("UTF8");
	XML.ЗаписатьОбъявлениеXML();
	
	XML.ЗаписатьНачалоЭлемента("Catalog");
	//XML.ЗаписатьАтрибут("xmlns:xsi", "https:www.w3.org/2001/XMLSchema-instance");
	
	XML.ЗаписатьНачалоЭлемента("creation");
	XML.ЗаписатьТекст(Формат(ТекущаяДата(),"ДФ=yyyy-MM-dd")+" "+Формат(ТекущаяДата(),"ДЛФ=T"));
	XML.ЗаписатьКонецЭлемента(); //creation
	
	XML.ЗаписатьНачалоЭлемента("Cars");
	
	Для каждого Стр1 Из ТЗ Цикл
		
		Если обЗначениеНеЗаполнено(Стр1.Цена) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если обЗначениеНеЗаполнено(Стр1.Автомобиль.Модель.Марка.МаркаАвтоРу) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если обЗначениеНеЗаполнено(Стр1.Автомобиль.МодельАвтоРу) Тогда
			Продолжить;
		КонецЕсли; 

		
 		XML.ЗаписатьНачалоЭлемента("сar");
		XML.ЗаписатьНачалоЭлемента("mаrk_id");             XML.ЗаписатьТекст(Стр1.Автомобиль.Модель.Марка.МаркаАвтоРу.Наименование);                            XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("folder_id");           XML.ЗаписатьТекст(Стр1.Автомобиль.МодельАвтоРу.Наименование);                                        XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("modification_id");     XML.ЗаписатьТекст(Стр1.Автомобиль.МодификацияАвтоРу.Наименование);                                   XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("copmplectation_name"); XML.ЗаписатьТекст(Стр1.Автомобиль.КомплектацияАвтоРу.Наименование);                                                                               XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("body_type");           XML.ЗаписатьТекст(СокрЛП(Стр1.Автомобиль.ТипКузоваСайт));                                            XML.ЗаписатьКонецЭлемента();
 		XML.ЗаписатьНачалоЭлемента("wheel");               XML.ЗаписатьТекст(СокрЛП(Стр1.Автомобиль.Руль));                                                     XML.ЗаписатьКонецЭлемента();
 		XML.ЗаписатьНачалоЭлемента("color");               XML.ЗаписатьТекст(СокрЛП(Стр1.Автомобиль.ЦветАвтоРу));                                                 XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("metallic");            XML.ЗаписатьТекст(СокрЛП(Стр1.Автомобиль.ОкраскаМеталлик));                                            XML.ЗаписатьКонецЭлемента();
        XML.ЗаписатьНачалоЭлемента("availability");        XML.ЗаписатьТекст("В наличии");                                                                        XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("custom");              XML.ЗаписатьТекст("Растаможен");                                                                       XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("state");               XML.ЗаписатьТекст(СокрЛП(Стр1.Автомобиль.Состояние));                                                  XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("owners_number");       XML.ЗаписатьТекст("Не было владельцев");                                                               XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("run");                 XML.ЗаписатьТекст("0");                                                                                XML.ЗаписатьКонецЭлемента();
 		XML.ЗаписатьНачалоЭлемента("year");                XML.ЗаписатьТекст(Формат(Стр1.Автомобиль.ГодВыпуска,"ДФ=yyyy"));                                       XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("registry_year");       XML.ЗаписатьТекст(Формат(Стр1.Автомобиль.ГодВыпуска,"ДФ=yyyy"));                                       XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("doors_count");         XML.ЗаписатьТекст(СокрЛП(Стр1.Автомобиль.КоличествоДверей));                                           XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("currency");            XML.ЗаписатьТекст("RUR");                                                                              XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("vin");                 XML.ЗаписатьТекст(Стр1.Автомобиль.VIN);                                                                XML.ЗаписатьКонецЭлемента();
		
		Попытка
			ЦенаМинимальная =  СокрЛП(Число(СтрЗаменить(Стр1.Цена,Символы.НПП,""))-Число(СтрЗаменить(Стр1.СкидкаМаксимальная,Символы.НПП,"")));         
 		Исключение
			ЦенаМинимальная = СокрЛП(Число(СтрЗаменить(Стр1.Цена,Символы.НПП,"")));
		КонецПопытки; 
		 
		XML.ЗаписатьНачалоЭлемента("price");               XML.ЗаписатьТекст(СокрЛП(СтрЗаменить(ЦенаМинимальная,Символы.НПП,"")));                                XML.ЗаписатьКонецЭлемента(); 
		XML.ЗаписатьНачалоЭлемента("special_price");       XML.ЗаписатьТекст(СокрЛП(СтрЗаменить(Стр1.СпециальнаяЦена,Символы.НПП,"")));                           XML.ЗаписатьКонецЭлемента(); 
		XML.ЗаписатьНачалоЭлемента("credit_discount");     XML.ЗаписатьТекст(СокрЛП(СтрЗаменить(Стр1.СкидкаПриПокупкеВКредит,Символы.НПП,"")));                   XML.ЗаписатьКонецЭлемента(); 
		XML.ЗаписатьНачалоЭлемента("insurance_discount");  XML.ЗаписатьТекст(СокрЛП(СтрЗаменить(Стр1.СкидкаПриСтраховании,Символы.НПП,"")));                      XML.ЗаписатьКонецЭлемента();  
		XML.ЗаписатьНачалоЭлемента("tradein_discount");    XML.ЗаписатьТекст(СокрЛП(СтрЗаменить(Стр1.СкидаПриПокупкеВТрейдИн,Символы.НПП,"")));                   XML.ЗаписатьКонецЭлемента();  
		XML.ЗаписатьНачалоЭлемента("max_discount");        XML.ЗаписатьТекст(СокрЛП(СтрЗаменить(Стр1.СкидкаМаксимальная,Символы.НПП,"")));                        XML.ЗаписатьКонецЭлемента(); 

   		XML.ЗаписатьНачалоЭлемента("images");
		
		ёё = 0;
		
		Для каждого СтрТЧ Из Стр1.Автомобиль.ПутьКФото Цикл
			
			Сообщить(СтрТЧ.Путь);
			
			ёё = ёё + 1;
			
			Если обЗначениеНеЗаполнено(СтрТЧ.URL) Тогда
				Продолжить;
			КонецЕсли; 
			XML.ЗаписатьНачалоЭлемента("url");
			XML.ЗаписатьТекст(СокрЛП(СтрТЧ.URL));                            							
			XML.ЗаписатьКонецЭлемента(); //url	
		КонецЦикла; 
		
		XML.ЗаписатьКонецЭлемента(); //images	
		
		XML.ЗаписатьНачалоЭлемента("video");                 XML.ЗаписатьТекст(Стр1.Автомобиль.СсылкаНаВидео); 	XML.ЗаписатьКонецЭлемента(); 
 		XML.ЗаписатьНачалоЭлемента("comment");   	         XML.ЗаписатьТекст(СокрЛП(Слоган));	              	XML.ЗаписатьКонецЭлемента();	 //comment
		
		XML.ЗаписатьКонецЭлемента(); //Car

 	КонецЦикла; 
	
	XML.ЗаписатьКонецЭлемента();	 //Cars
	
	XML.ЗаписатьКонецЭлемента();         //Catalog
	
	XMLТекст = XML.Закрыть();
	
 	Возврат XMLТекст;

КонецФункции // ВернутьXMLкакСтроку()
 