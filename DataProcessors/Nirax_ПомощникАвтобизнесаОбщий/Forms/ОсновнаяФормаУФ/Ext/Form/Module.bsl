//      ****** Станица поиска онлайн ******
&НаКлиенте
Процедура ОтборПоНаличию(Команда)
	ОтборПараметры=Новый	Структура("Склад,ЕстьНаСкладе,ЕстьУПоставщика",Объект.ФильтрСкладЕмекс,ЕстьНаСкладе,ЕстьУПоставщика);
	КолЕмекс=ОтборПоНаличиюНаСервере(ОтборПараметры);
	Если ЗначениеЗаполнено(КолЕмекс) И КолЕмекс > 0 Тогда
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики) (" + КолЕмекс + ")";
	Иначе
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики)";
	КонецЕСли;
КонецПроцедуры

&НаСервере
Функция ОтборПоНаличиюНаСервере(ОтборПараметры)
	ТЗ = РезультатПоискаЕмекс.Выгрузить();
	ЭтоОбъект=РеквизитФормыВЗначение("Объект");
	Возврат ЭтоОбъект.ВыводРезультатаПоискаЕмекс(ТЗ,РезультатЕмекс,ОтборПараметры);
КонецФункции
	
//      ****** Станица поиска по автомобилю ******
&НаКлиенте
Процедура ЗагрузитьПоМодели(Команда)
	ИскомаяМарка=ТЗДляФильтраМарок.НайтиСтроки(Новый Структура("MFA_BRAND",ФильтрФирмаАвто));
	ПараметрыФормы=Новый Структура("Марка, Модель", ИскомаяМарка[0].MFA_ID, ФильтрМодельАвто);	
	ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаЗагрузкиУФ",ПараметрыФормы,ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	Элементы.Группа5.Видимость=Ложь;
	Элементы.Группа4.Видимость=Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПоУзлу(Команда)
	Если ОбработанныйУзелАйди<>"" Тогда
		ПараметрыФормы=Новый Структура("Узел, Комплект", ОбработанныйУзелАйди, ТипАвтоИзТаблицыТипов);	
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаЗагрузкиУФ",ПараметрыФормы, ЭтаФорма);
	Иначе
		Сообщить("Не выбран узел для обработки!");
	КонецЕсли;
КонецПроцедуры

//      ****** Станица Корзина ******
&НаКлиенте
Процедура ОформитьЗаявку(Команда,СКодомЗаказа=Ложь)
	НетДокумента= НЕ (Объект.ЗаказПокупателяВрем ИЛИ Объект.РеализацияТоваровВрем ИЛИ Объект.СчетФактураВрем);
	НетЗаказов = Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина)).Количество()=0;
	Если НетДокумента ИЛИ НетЗаказов Тогда
		Если Объект.РежимМодальности Тогда
			Предупреждение(?(НетДокумента,"Не определен ни один тип документа для оформления"+Символы.ПС,"")+
			?(НетЗаказов,"Ни одна заявка не отмечена для оформления документов",""));
		Иначе
			Сообщить(?(НетДокумента,"Не определен ни один тип документа для оформления"+Символы.ПС,"")+
			?(НетЗаказов,"Ни одна заявка не отмечена для оформления документов",""));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Рез=КонтрольДанныхДляДокументовНаСервере();
	Если Рез<>"" Тогда
		Если Объект.РежимМодальности Тогда
			Если Лев(Рез,1)="!" Тогда
				Предупреждение("Для оформления документов необходимо в настройках и форме определить следующие данные:"+
				Символы.ПС+Сред(Рез,2));
				Возврат;
			ИначеЕсли Вопрос("Для оформления документов рекомендуется в настройках и форме определить следующие данные:"+
				Символы.ПС+Сред(Рез,2)+Символы.ПС+"Отменить оформление документов?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да)=КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
		ИначеЕсли Лев(Рез,1)="!" Тогда
			Сообщить("Для оформления документов необходимо в настройках и форме определить следующие данные:"+
			Символы.ПС+Сред(Рез,2));
			Возврат;
		Иначе
			
		КонецЕсли;
	КонецЕсли;
	МасДок=ОформитьЗаявкуНаСервере();
	Для Каждого Стр Из МасДок Цикл
		ОткрытьФорму("Документ."+Стр.Имя+".ФормаОбъекта",Стр);
	КонецЦикла;
КонецПроцедуры

&НаСервере      
Функция КонтрольДанныхДляДокументовНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.КонтрольДанныхДляДокументов();
КонецФункции

&НаСервере
Функция ОформитьЗаявкуНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	МасДок=Обработка.ОформитьЗаявку();
	Если Объект.ЗаказПокупателяВрем Тогда
		Для Каждого Элем из МасДок Цикл
			Если НЕ Элем.Свойство("Склад") Тогда Продолжить; КонецЕсли;
			ЗаказМета=МетаДанные.Документы[Элем.Имя];
			Если ЗаказМета.ТабличныеЧасти.Найти("Товары")<>Неопределено Тогда
				ЗаказТовар="Товары";
			ИначеЕсли ЗаказМета.ТабличныеЧасти.Найти("Запасы")<>Неопределено  Тогда
				ЗаказТовар="Запасы";
			Иначе
				Прервать;
			КонецЕсли;
			Если Элем.Склад=Объект.СкладДляЗаявки Тогда
				Отбор=Новый Структура("Выбран,Номенклатура",Истина);
				Для Каждого Стр Из Элем.Ключ[ЗаказТовар] Цикл
					Отбор.Номенклатура=Стр.Номенклатура;
					МасРез=Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
					Для Каждого ЭлРез Из МасРез Цикл
						Если ТипЗнч(ЭлРез.Склад)=Тип("Строка") или ЭлРез.Склад=Объект.СкладДляЗаявки Или
							Не ЗначениеЗаполнено(ЭлРез.Склад) ТОгда
							ЭлРез.ЗаказПокупателя=Элем.Ключ;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			Иначе
				Отбор=Новый Структура("Выбран,Склад,Номенклатура",Истина,Элем.Склад);
				Для Каждого Стр из Элем.Ключ[ЗаказТовар] Цикл
					Отбор.Номенклатура=Стр.Номенклатура;
					МасРез=Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
					Если МасРез.Количество()>0 Тогда
						МасРез[0].ЗаказПокупателя=Элем.Ключ;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли;		
	Возврат МасДок;
КонецФункции

&НаКлиенте
Процедура ОформитьЧекККМ(Команда)
	ЧекККМСсылка=ОформитьЧекККМНаСервере();
	Если ЗначениеЗаполнено(ЧекККМСсылка) Тогда
		  ОткрытьЗначение(ЧекККМСсылка);  
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ОформитьЧекККМНаСервере()
	
	Попытка
	
		Чек = Документы.ЧекККМ.СоздатьДокумент(); 		
		Чек.Дата = ТекущаяДата();
		Чек.КассаККМ = Объект.КассаККМ;
		Чек.Организация = Объект.ОрганизацияДляЗаявки;
		Чек.СуммаДокумента = СуммаКорзины;
		Попытка
			Чек.ЦенаВключаетНДС = Истина;
		Исключение
		    Чек.СуммаВключаетНДС = Истина;
		КонецПопытки;
		
		Если Объект.Конфигурация = "УправлениеТорговлей 11.0" ИЛИ
				 Объект.Конфигурация = "УправлениеТорговлей 11.1.2" ИЛИ
				 Объект.Конфигурация = "УправлениеТорговлей 11.1.4" Тогда
			Попытка	 
				Чек.Склад = Объект.СкладДляЗаявки;
				Чек.Партнер = Объект.КонтрагентДляЗаявки.Партнер;
				Чек.ВидЦены = Объект.ТипЦен;
				Чек.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
				Чек.Кассир = ПараметрыСеанса.ТекущийПользователь;
				Чек.Валюта = Объект.ТипЦен.ВалютаЦены;
				Если НЕ Чек.Метаданные().Реквизиты.Найти("КассоваяСмена") = Неопределено Тогда
					Запрос = Новый Запрос(
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	КассоваяСмена.Номер               КАК НомерКассовойСмены,
					|	КассоваяСмена.Ссылка              КАК КассоваяСмена,
					|	КассоваяСмена.СтатусКассовойСмены КАК СтатусКассовойСмены,
					|	
					|	КассоваяСмена.КассаККМ             КАК КассаККМ,
					|	КассоваяСмена.Валюта               КАК Валюта,
					|	КассоваяСмена.Валюта.Представление КАК ВалютаПредставление,
					|	КассоваяСмена.ВидЦены              КАК ВидЦены,
					|	КассоваяСмена.Организация          КАК Организация,
					|	КассоваяСмена.Кассир               КАК Кассир,
					|	КассоваяСмена.Склад                КАК Склад,
					|	КассоваяСмена.ЦенаВключаетНДС      КАК ЦенаВключаетНДС,
					|	КассоваяСмена.НалогообложениеНДС   КАК НалогообложениеНДС,
					|	
					|	ВЫБОР
					|		КОГДА КассоваяСмена.СтатусКассовойСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ КАК СменаОткрыта,
					|	
					|	ВЫБОР
					|		КОГДА КассоваяСмена.СтатусКассовойСмены = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
					|			ТОГДА КассоваяСмена.НачалоКассовойСмены
					|		ИНАЧЕ КассоваяСмена.ОкончаниеКассовойСмены
					|	КОНЕЦ КАК ДатаИзмененияСтатуса,
					|	
					|	ЕСТЬNULL(ДенежныеСредстваВКассахККМОстатки.СуммаОстаток, 0) КАК НаличностьВКассе
					|	
					|ИЗ
					|	Документ.КассоваяСмена КАК КассоваяСмена
					|	
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКассахККМ.Остатки(, КассаККМ = &КассаККМ) КАК ДенежныеСредстваВКассахККМОстатки
					|		ПО КассоваяСмена.КассаККМ = ДенежныеСредстваВКассахККМОстатки.КассаККМ
					|	
					|ГДЕ
					|	КассоваяСмена.Проведен
					|	И КассоваяСмена.КассаККМ = &КассаККМ
					|
					|УПОРЯДОЧИТЬ ПО
					|	КассоваяСмена.Дата УБЫВ,
					|	КассоваяСмена УБЫВ");
					Запрос.УстановитьПараметр("КассаККМ",Объект.КассаККМ);
					Выборка = Запрос.Выполнить().Выбрать();
					Если Выборка.Следующий() Тогда
						Чек.КассоваяСмена = Выборка.КассоваяСмена;
					КонецЕсли;
				КонецЕсли;
			Исключение
				Чек.СтруктурнаяЕдиница = Объект.СкладДляЗаявки;
				Чек.асВидОперации = Перечисления.асВидыОперацийЧекККМ.ЧекККМ;
				Чек.ФормаОплаты = Перечисления.ТипыДенежныхСредств.Наличные;
				Чек.ВидЦен = Объект.ТипЦен;
				Чек.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
				Чек.Автор = ПараметрыСеанса.ТекущийПользователь;
				Чек.ВалютаДокумента = Объект.ТипЦен.ВалютаЦены;
			КонецПопытки;
			
		ИначеЕсли Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" 
			или  Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.0"
			Тогда
			Чек.ВидОперации=Перечисления.ВидыОперацийЧекККМ.Продажа;
			Чек.АналитикаХозяйственнойОперации=Справочники.АналитикаХозяйственныхОпераций.РеализацияТоваров;
			Чек.Магазин=объект.КассаККМ.Магазин;
		КонецЕсли;
		
		Для каждого Строка Из Объект.ЗаявкаНаОформление Цикл
		    Попытка
				ЧекСтрока = Чек.Товары.Добавить();
				ЧекСтрока.Номенклатура = Строка.Наименование;
				ЧекСтрока.ПроцентРучнойСкидки = Строка.Скидка;
				ЧекСтрока.СуммаРучнойСкидки = Строка.Сумма - Строка.СуммаСоСкидкой;
				ЧекСтрока.КоличествоУпаковок = Строка.Количество;
				ЧекСтрока.Количество = Строка.Количество;
				ЧекСтрока.Цена = Строка.Цена;
				ЧекСтрока.Сумма = Строка.СуммаСоСкидкой;
				ЧекСтрока.СтавкаНДС = Строка.СтавкаНДС;
				ЧекСтрока.СуммаНДС = Строка.СуммаНДС;
				Если НЕ Чек.метаданные().ТабличныеЧасти.Товары.Реквизиты.Найти("Продавец") = Неопределено Тогда
					ЧекСтрока.Продавец = ПараметрыСеанса.ТекущийПользователь;
				КонецЕсли;
			Исключение
				ЧекСтрока = Чек.Запасы.Добавить();
				ЧекСтрока.Номенклатура = Строка.Наименование;
				ЧекСтрока.ЕдиницаИзмерения = Строка.Наименование.ЕдиницаИзмерения;
				ЧекСтрока.Количество = Строка.Количество;
				ЧекСтрока.Цена = Строка.Цена;
				ЧекСтрока.Сумма = Строка.СуммаСоСкидкой;
				ЧекСтрока.СтавкаНДС = Строка.СтавкаНДС;
				ЧекСтрока.СуммаНДС = Строка.СуммаНДС;
				ЧекСтрока.Всего = Строка.Всего;
			КонецПопытки;
			
			Если Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" 
				 или Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.0"				
				Тогда
				ЧекСтрока.Склад=объект.Склад;
			КонецЕсли;
		КонецЦикла; 
		
		Чек.Записать();
		Возврат Чек.Ссылка;
	
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;	
	
КонецФункции

&НаКлиенте
Процедура ОчиститьЗаявку(Команда)
	Попытка
		Отбор=Новый Структура("Выбран",Истина);
		Массив = Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
		Если Массив.Количество()>0 Тогда
			Ответ = Вопрос("Удалить все записи ( Да ) или только выбранные ( Нет ) ?", РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Нет);
			Если Ответ = КодВозвратаДиалога.Отмена Тогда Возврат;
			ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
				Для Каждого Стр Из Массив Цикл
					Объект.ЗаявкаНаОформление.Удалить(Стр);
				КонецЦикла;
				ЗаявкаНаОформлениеПослеУдаления(Неопределено);
				Возврат;
			КонецЕсли;
		Иначе
			Ответ = Вопрос("Удалить все записи ?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
			Если Ответ = КодВозвратаДиалога.Нет Тогда Возврат;КонецЕсли;
		КонецЕСли;
	Исключение
	КонецПопытки;
	Объект.ЗаявкаНаОформление.Очистить();
	ЗаявкаНаОформлениеПослеУдаления(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВКорзинуОнлайн(Команда)
	Если Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина)).Количество()=0 Тогда
		Текст="Нет ни одной отмеченной заявки для переноса в корзину поставщика";
		Если Объект.РежимМодальности Тогда
			Предупреждение(Текст);
		Иначе
			Сообщить(Текст);
		КонецЕсли;
	Иначе
		ВКорзинуОнлайнНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВКорзинуОнлайнНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.ВКорзинуПроценки(Объект.ЗаявкаНаОформление,Объект.ЗаявкаПоставщику);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажки(Команда)
	Флаг=Команда.Имя="УстановитьФлажки";
	Для каждого СтрокаТЗ Из Объект.ЗаявкаНаОформление Цикл
	  Если Флаг = Неопределено Тогда
		  СтрокаТЗ.Выбран = НЕ СтрокаТЗ.Выбран;
		Иначе	
		  СтрокаТЗ.Выбран = Флаг;
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура КПоставщику(Команда)
	МасСтр=Объект.ЗаявкаНаОформление.НайтиСтроки(Новый Структура("Выбран",Истина));
	Если МасСтр.Количество()=0 Тогда
		МасСтр.Добавить(Элементы.ЗаявкаНаОформление.ТекущаяСтрока);
	КонецЕсли;
	Для Каждого Заявка из МасСтр Цикл
		Нов=Объект.ЗаявкаПоставщику.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Заявка,"Номенклатура,Артикул,Количество,СтавкаНДС");
		Если ЗначениеЗаполнено(Заявка.ЗаказПокупателя) Тогда
			Нов.ЗаказПокупателя=Заявка.ЗаказПокупателя;
		КонецЕсли;	
		Нов.Срок=?(Заявка.СрокДоставкиГарантированный=0,Заявка.СрокДоставки,Заявка.СрокДоставкиГарантированный);
		Нов.Склад=?(ТипЗнч(Заявка.Склад)=Тип("Строка") или Не ЗначениеЗаполнено(Заявка.Склад),Объект.СкладДляЗаявки,Заявка.Склад);
		Если ЗначениеЗаполнено(Заявка.Поставщик) Тогда
			Нов.Поставщик=Заявка.Поставщик;
		ИначеЕсли Не ПустаяСтрока(Заявка.Сайт) Тогда
			Пост = ПолучитьПоставщика(Заявка.Сайт);
			Если ЗначениеЗаполнено(Пост) ТОгда
				Нов.Поставщик=Пост;
			КонецЕсли;
		КонецЕсли;	
		Нов.Цена=Заявка.ЦенаПоставки;
		Нов.Скидка=0;
		ИзмКолПостНаСервере(Нов.НомерСтроки-1);
		ЕСли Заявка.КодЗаказа="error" Тогда
			Нов.Состояние="Не определено";
		Иначе
			Нов.Состояние="В корзине";
		КонецЕсли;
		Нов.Сайт=Заявка.Сайт;
		Нов.КодТовара=Заявка.КодТовара;
		Нов.КодЗаказа=Заявка.КодЗаказа;
		Нов.idСклад=Заявка.idСклад;
		Нов.КодДоставки=Заявка.КодДоставки;
		Нов.ДанныеСайта="{""Производитель"":"""+СтрЗаменить(СтрЗаменить(Заявка.Производитель,"/","//"),"""","/""")+
		""",""КодПроизводителя"":"""+СтрЗаменить(СтрЗаменить(Заявка.КодПроизводителя,"/","//"),"""","/""")+
		""",""ДляКорзины"":"""+СтрЗаменить(СтрЗаменить(Заявка.ДляКорзины,"/","//"),"""","/""")+"""}";
	КонецЦикла;
	Элементы.Группа10.Заголовок="Заказ поставщику ("+Строка(Объект.ЗаявкаПоставщику.Количество())+")";
КонецПроцедуры

&НаСервере
Функция ПолучитьПоставщика(СайтПост)
	Пост = "";
	ЕСли Объект.СпецНаз.НастройкиПользователя Тогда
		Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки");
	Иначе
		Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,"Администратор");
	КонецЕсли;
	Сайт=Проценки.Найти(СайтПост,"Сайт");
	Если Сайт<>Неопределено ТОгда
		Попытка
		Если ЗначениеЗаполнено(Сайт.Поставщик) ТОгда
			Пост=Сайт.Поставщик;
		КонецЕсли;
		Исключение КонецПопытки;
	КонецЕсли;
	Возврат Пост;
КонецФункции

//     ****** Страница Заказы Поставщику  *****
&НаКлиенте
Процедура ОформитьЗаказы(Команда)
	Отбор=Новый Структура("Выбран",Истина);
	Если Объект.ЗаявкаПоставщику.НайтиСтроки(Отбор).Количество() > 0 Тогда
		ОформленныеЗаказы=ОформитьЗаказыНаСервере();
		Если ЗначениеЗаполнено(ОформленныеЗаказы) Тогда
			Для Каждого Значение Из ОформленныеЗаказы Цикл
				ЗаявкаПост = Значение.Значение;
				ОткрытьЗначение(ЗаявкаПост);
			КонецЦикла;
		КонецЕСли;	
	Иначе
		Попытка
			Предупреждение("Нет данных для формирования заказов!");
		Исключение
			Сообщить("Нет данных для формирования заказов!");
		Конецпопытки;
	КонецЕсли;
	РассчитатьКоличествоЭлементов();
		
КонецПроцедуры

&НаСервере
Функция ОформитьЗаказыНаСервере()
	
	Отбор=Новый Структура("Выбран",Истина);
	ТЗДляОформления = Объект.ЗаявкаПоставщику.Выгрузить(Объект.ЗаявкаПоставщику.НайтиСтроки(Отбор));
	ОформленныеЗаказы=Новый СписокЗначений;
	ТЗВЗаказ = ТЗДляОформления.СкопироватьКолонки();
	Если Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" или Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.0" Тогда	
		ТЗДляОформления.Сортировать("Поставщик,Склад");
		ТекущийПоставщик = ТЗДляОформления[0].Поставщик;
		ТекущийСклад=ТЗДляОформления[0].Склад;
		Для каждого Запись Из ТЗДляОформления Цикл
			
			Если (ТекущийПоставщик = Запись.Поставщик) и (Запись.Склад=ТекущийСклад) Тогда
				
				СтрокаВЗаказ = ТЗВЗаказ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
				Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
					СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
				КонецЕСли;
				
			Иначе
				
				Если ТЗВЗаказ.Количество() > 0 Тогда
					СоздатьЗаказПоставщику(ТЗВЗАказ,ОформленныеЗаказы);
				КонецЕСли;
				
				ТекущийПоставщик = Запись.Поставщик;
				ТекущийСклад = Запись.Склад;
				
				ТЗВЗаказ.Очистить();
				СтрокаВЗаказ = ТЗВЗАказ.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
				
				Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
					СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
				КонецЕСли;
				
			КонецЕсли; 	
			
		КонецЦикла;
		
		РассчитатьКоличествоЭлементов();	
		
		Возврат ОформленныеЗаказы;
	КонецЕсли;
	
	ТЗДляОформления.Сортировать("Поставщик");
	
	ТекущийПоставщик = ТЗДляОформления[0].Поставщик;
	
	Для каждого Запись Из ТЗДляОформления Цикл
		
		Если ТекущийПоставщик = Запись.Поставщик Тогда
			
			СтрокаВЗаказ = ТЗВЗаказ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
			Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
				СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
			КонецЕСли;
			
		Иначе
			
			Если ТЗВЗаказ.Количество() > 0 Тогда
				СоздатьЗаказПоставщику(ТЗВЗАказ,ОформленныеЗаказы);
			КонецЕСли;
			
			ТекущийПоставщик = Запись.Поставщик;
			ТЗВЗаказ.Очистить();
			СтрокаВЗаказ = ТЗВЗАказ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВЗаказ, Запись);
			
			Если (ТЗДляОформления.Количество() - 1) = ТЗДляОформления.Индекс(Запись) Тогда
				СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы);
			КонецЕСли;
			
		КонецЕсли; 	
		
	КонецЦикла;
	
	РассчитатьКоличествоЭлементов();	
	
	Возврат ОформленныеЗаказы;
	
КонецФункции

&НаСервере
Процедура СоздатьЗаказПоставщику(ТЗВЗаказ,ОформленныеЗаказы)
	
	Попытка
	
		ЗаказПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();		
		ЗаказПоставщику.Дата = ТекущаяДата();
		МаксДней=0;
		Если Объект.Конфигурация = "УправлениеТорговлей 11.0" ИЛИ
				 Объект.Конфигурация = "УправлениеТорговлей 11.1.2" ИЛИ
				 Объект.Конфигурация = "УправлениеТорговлей 11.1.4" Тогда
				 Если Документы.ЗаказПоставщику.ПустаяСсылка().Метаданные().Реквизиты.Найти("Менеджер") = Неопределено тогда
					 Заказпоставщику.Ответственный = параметрыСеанса.ТекущийПользователь;
				 Иначе
					 ЗаказПоставщику.Менеджер = ПараметрыСеанса.ТекущийПользователь;
				 КонецЕсли;
				 Если Документы.ЗаказПоставщику.ПустаяСсылка().Метаданные().Реквизиты.Найти("ХозяйственнаяОперация") = Неопределено тогда
					 ЗаказПоставщику.ВидОперации = Перечисления.ВидыОперацийЗаказПоставщику.ЗаказНаЗакупку;
				 Иначе
					 ЗаказПоставщику.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
				 КонецЕсли;
				 Попытка
					 ЗаказПоставщику.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
					 ЗаказПоставщику.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
					 ЗаказПоставщику.Приоритет = Справочники.Приоритеты.НайтиПоНаименованию("Средний");  //Перечисления.Приоритеты.Средний;
					 ЗаказПоставщику.Статус = Перечисления.СтатусыЗаказовПоставщикам.Согласован;		
					 ЗаказПоставщику.Валюта = Объект.ТипЦен.ВалютаЦены;
					 ЗаказПоставщику.Партнер = ТЗВЗАказ[0].Поставщик.Партнер;
					 ЗаказПоставщику.ДатаСогласования = ТекущаяДата();
					 //ЗаказПоставщику.ЖелаемаяДатаПоступления = ТекущаяДата() + ТЗВЗаказ[0].Срок*24*60*60;
				 Исключение
					 ЗаказПоставщику.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДС;
					 ЗаказПоставщику.СостояниеЗаказа = Справочники.СостоянияЗаказовПоставщикам.Открыт;
					 Заказпоставщику.ВалютаДокумента = ТЗВЗАказ[0].Поставщик.ДоговорПоУмолчанию.ВалютаРасчетов;
					 ЗаказПоставщику.Контрагент = ТЗВЗАказ[0].Поставщик;
					 ЗаказПоставщику.ДатаПоступления = ТекущаяДата() + ТЗВЗаказ[0].Срок*24*60*60;
					 ЗаказПоставщику.Договор = ТЗВЗАказ[0].Поставщик.ДоговорПоУмолчанию;
					 Курс = РегистрыСведений.КурсыВалют.СрезПоследних();
						Для Каждого СтрокаКурс Из Курс Цикл
							Если СтрокаКурс.Валюта = Объект.ТипЦен.ВалютаЦены Тогда
								ЗаказПоставщику.Кратность = СтрокаКурс.Кратность;
								ЗаказПоставщику.Курс = СтрокаКурс.Курс;
							КонецЕсли;
						КонецЦикла;
				 Конецпопытки;
				 
					РежимЗаписиЗаказа = ?(Объект.ПроводитьДокументы=Истина,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись);
		ИначеЕсли Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" или Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.0" Тогда
			ЗаказПоставщику.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			ЗаказПоставщику.Магазин = ТЗВЗАказ[0].Склад.Магазин;
			РежимЗаписиЗаказа = РежимЗаписиДокумента.Запись;
		КонецЕсли;
		ЗаказПоставщику.Организация = Объект.ОрганизацияДляЗаявки;
		ЗаказПоставщику.Контрагент = ТЗВЗАказ[0].Поставщик;
		Если НЕ ЗаказПоставщику.Метаданные().Реквизиты.Найти("Партнер") = Неопределено Тогда
			ЗаказПоставщику.Партнер=ЗаказПоставщику.Контрагент.Партнер;
		КонецЕсли;
		Если НЕ Документы.ЗаказПоставщику.ПустаяСсылка().Метаданные().Реквизиты.Найти("Склад") = Неопределено Тогда
			ЗаказПоставщику.Склад = ТЗВЗАказ[0].Склад;
		КонецЕсли;
		ЗаказПоставщику.ДатаПоступления = ТекущаяДата() + ТЗВЗаказ[0].Срок*24*60*60;
		
		Для каждого Строка Из ТЗВЗаказ Цикл
		    Попытка
				ЗаказПоставщикуСтрока = ЗаказПоставщику.Товары.Добавить();
				ЗаказПоставщикуСтрока.Номенклатура = Строка.Номенклатура;
				ЗаказПоставщикуСтрока.КоличествоУпаковок = Строка.Количество;
			Исключение
			    ЗаказПоставщикуСтрока = ЗаказПоставщику.Запасы.Добавить();
				ЗаказПоставщикуСтрока.Номенклатура = Строка.Номенклатура;
				ЗаказПоставщикуСтрока.ДатаПоступления = ТекущаяДата() + ТЗВЗаказ[0].Срок*24*60*60;
			КонецПопытки;
			
			ЗаказПоставщикуСтрока.Количество = Строка.Количество;
			ЗаказПоставщикуСтрока.Цена = Строка.Цена;
			ЗаказПоставщикуСтрока.Сумма = Строка.Сумма;
			ЗаказПоставщикуСтрока.СтавкаНДС = Строка.СтавкаНДС;
			ЗаказПоставщикуСтрока.СуммаНДС = Строка.СуммаНДС;
			Если Объект.Конфигурация = "УправлениеТорговлей 11.0" ИЛИ
				 Объект.Конфигурация = "УправлениеТорговлей 11.1.2" ИЛИ
				 Объект.Конфигурация = "УправлениеТорговлей 11.1.4" Тогда
				 Попытка
				ЗаказПоставщикуСтрока.СуммаСНДС = Строка.Всего;
				ЗаказПоставщикуСтрока.Склад = Строка.Склад;	
			Исключение
				КонецПопытки;
			ИначеЕсли Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.1" 
				или Объект.Конфигурация = "РозницаМагазинАвтозапчастей 2.0"
				Тогда
				//БСА151115(
				ЗаказПоставщикуСтрока.ор_ЗаказПокупателя=Строка.ЗаказПокупателя;
				//)
			КонецЕсли;
			Если Строка.Срок>МаксДней Тогда МаксДней=Строка.Срок КонецЕсли;
		КонецЦикла;  		
	    Если Метаданные.Документы.ЗаказПоставщику.Реквизиты.Найти("ЖелаемаяДатаПоступления")<>Неопределено Тогда
			ЗаказПоставщику.ЖелаемаяДатаПоступления = ТекущаяДата() + ТЗВЗаказ[0].Срок*86400;
		КонецЕсли;
		ЗаказПоставщику.Записать(?(Объект.ПроводитьДокументы=Истина,РежимЗаписиДокумента.Проведение,РежимЗаписиДокумента.Запись));
		ОформленныеЗаказы.Добавить(ЗаказПоставщику.Ссылка);	
				
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗаказы(Команда)
	Попытка
		Отбор=Новый Структура("Выбран",Истина);
		Массив = Объект.ЗаявкаПоставщику.НайтиСтроки(Отбор);
		Если Массив.Количество()>0 Тогда
			Ответ = Вопрос("Удалить все записи ( Да ) или только выбранные ( Нет ) ?", РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Отмена);
			Если Ответ = КодВозвратаДиалога.Отмена Тогда Возврат;
			ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
				Для Каждого Стр Из Массив Цикл
					Объект.ЗаявкаПоставщику.Удалить(Стр);
				КонецЦикла;
				Элементы.Группа10.Заголовок = "Заказы поставщикам (" + Объект.ЗаявкаПоставщику.Количество() + ")";
				Возврат;
			КонецЕсли;
		Иначе
			Ответ = Вопрос("Удалить все записи ?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
			Если Ответ = КодВозвратаДиалога.Нет Тогда Возврат;КонецЕсли;
		КонецЕСли;
	Исключение
	КонецПопытки;	
	Объект.ЗаявкаПоставщику.Очистить();
	Элементы.Группа10.Заголовок = "Заказы поставщикам";
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФлажкиПоставщику(Команда)
	Флаг=Команда.Имя="УстановитьФлажкиПоставщику";
	Для каждого СтрокаТЗ Из Объект.ЗаявкаПоставщику Цикл
	  Если Флаг = Неопределено Тогда
		  СтрокаТЗ.Выбран = НЕ СтрокаТЗ.Выбран;
		Иначе	
		  СтрокаТЗ.Выбран = Флаг;
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

//#КонецОбласти

//#Область СлужебныеПроцедурыИФункции

//#Область ОбщегоНазаначения

// ***** Общего назаначения *****
&НаКлиентеНаСервереБезКонтекста 
Функция ПодготовитьНомер(СтрНом)
	СтрНомер=СокрЛП(строка(СтрНом));
	СтрНомер=Стрзаменить(СтрНомер,символы.НПП,"");
	СтрНомер=Стрзаменить(СтрНомер,",","");
	СтрНомер=Стрзаменить(СтрНомер,")","");
	СтрНомер=Стрзаменить(СтрНомер,"(","");
	СтрНомер=Стрзаменить(СтрНомер,"-","");
	СтрНомер=Стрзаменить(СтрНомер,".","");
	СтрНомер=Стрзаменить(СтрНомер," ","");
	СтрНомер=Стрзаменить(СтрНомер,"-","");
	СтрНомер=Стрзаменить(СтрНомер,"""","");
	СтрНомер=Стрзаменить(СтрНомер,"'","");
	СтрНомер=Стрзаменить(СтрНомер,":","");
	СтрНомер=Стрзаменить(СтрНомер,";","");
	СтрНомер=Стрзаменить(СтрНомер,"/","");
	СтрНомер=Стрзаменить(СтрНомер,"|","");
	СтрНомер=Стрзаменить(СтрНомер,"\","");
	СтрНомер=Стрзаменить(СтрНомер,"!","");
	СтрНомер=Стрзаменить(СтрНомер,"#","");
	СтрНомер=Стрзаменить(СтрНомер,"№","");
	СтрНомер=Стрзаменить(СтрНомер,"?","");
	СтрНомер=Стрзаменить(СтрНомер,"*","");
	Возврат СтрНомер;
Конецфункции

&НаСервере
Функция ЗаполнитьТаблицуГрупп()
	Обработка=РеквизитФормыВЗначение("Объект");
	ТаблицаГруппТоваров=Обработка.ПоискГруппПоАртикулу(Объект.НомерАртикула, Предикат);
	ТаблицаГруппТоваров.Сортировать("Родитель");
	Массив=Новый Массив;
	Для Каждого Стр Из ТаблицаГруппТоваров Цикл
		Массив.Добавить(Новый Структура("ID_Группы,Наименование,Родитель",Стр.ID_Группы,Стр.Наименование,Стр.Родитель));
	КонецЦикла;
	Возврат Массив;
КонецФункции

&НаКлиенте
Процедура ПоискПоАртикулу(СписокГрупп="",ДополнительныйПараметр=Неопределено) Экспорт
	Если СписокГрупп=Неопределено Тогда СписокГрупп="";КонецЕсли;
	Попытка
		СтрокаОриг = Объект.НомерАртикула;
		СтрокаПоиска = Врег(ПодготовитьНомер(СтрокаОриг));
		Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоАртикулу или Объект.ОбщийПоискВрем Тогда
			ПоискВТекДок(СписокГрупп);
		КонецЕсли;
		
		Если Объект.ОбщийПоискВрем или ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоПрайсу Тогда
			ПоискПрайсНаКлиенте(СтрокаПоиска,СтрокаОриг);
		КонецЕсли;

		Если (Объект.ОбщийПоискВрем или ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.ПоискЕмекс)
			и Объект.ИспользоватьПроценкуОнлайнПоставщиков Тогда
			ПоискПроценки();
		КонецЕсли;
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура РассчитатьКоличествоЭлементов()Экспорт
	
	Если ЗначениеЗаполнено(КолТекДок) И КолТекДок > 0 Тогда
		Элементы.СтраницаПоискПоАртикулу.Заголовок = "Поиск по артикулу (TecDoc) (" + КолТекДок + ")";
	Иначе
		Элементы.СтраницаПоискПоАртикулу.Заголовок = "Поиск по артикулу (TecDoc)";
	КонецЕСли;
	
	Если ЗначениеЗаполнено(КолПрайс) И КолПрайс > 0 Тогда
		Элементы.СтраницаПоискПоПрайсу.Заголовок = "Поиск по артикулу (прайс-листы) (" + КолПрайс + ")";
	Иначе
		Элементы.СтраницаПоискПоПрайсу.Заголовок = "Поиск по артикулу (прайс-листы)";
	КонецЕСли;
	
	Если ЗначениеЗаполнено(КолЕмекс) И КолЕмекс > 0 Тогда
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики) (" + КолЕмекс + ")";
	Иначе
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики)";
	КонецЕСли;
	
	ЕСли Объект.ЗаявкаНаОформление.Количество() > 0 Тогда
		Элементы.СтрКорзина.Заголовок = "Корзина (" + Объект.ЗаявкаНаОформление.Количество() + ")";
	Иначе
		Элементы.СтрКорзина.Заголовок = "Корзина";
	КонецЕСли;
	
	ЕСли Объект.ЗаявкаПоставщику.Количество() > 0 Тогда
		Элементы.Группа10.Заголовок = "Заказы поставщикам (" + Объект.ЗаявкаПоставщику.Количество() + ")";
	Иначе
		Элементы.Группа10.Заголовок = "Заказы поставщикам";
	КонецЕСли;	
	
КонецПроцедуры

&НаКлиенте
Функция ВыполнитьМетодНаКлиенте(Метод,ТекСтр)
	Попытка
		ИмяМетода=Метод.Сайт+"_"+Метод.Метод;
		Рез=Неопределено;
		Если ИмяМетода="Корзина_Подбор" Тогда
			Рез=Корзина_Подбор();
		Иначе
			Возврат "Метод "+Метод.Метод+" для сайта "+Метод.Сайт+" не найден";
		КонецЕсли;
		Возврат Рез;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;	
	
КонецФункции

