
//#Область ОбработчикиСобытийФормы

&НаСервере   
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем Данные;
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ОбъектMySQL");
	Если ТипЗнч(Данные)=Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект,Данные);
	КонецЕсли;
	
	Обработка=РеквизитФормыВЗначение("Объект");
	Если Лев(Строка(ТипЗнч(Обработка)),7)="Внешняя" ТОгда
		Объект.ВнешняяОбработка="ВнешняяОбработка";
	Иначе
		Объект.ВнешняяОбработка="Обработка";
	КонецЕсли;
	
	Данные=Неопределено;
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ЗаявкаНаОформление");
	Если ТипЗнч(Данные)=Тип("ТаблицаЗначений") Тогда
		КолДан=Данные.Количество();
		Если КолДан>0 Тогда
			Объект.ЗаявкаНаОформление.Загрузить(Данные);
			Элементы.СтрКорзина.Заголовок="Корзина ("+Строка(КолДан)+")";
			СуммаКорзины=Объект.ЗаявкаНаОформление.Итог("Всего");
		КонецЕсли;
	КонецЕсли;

	Данные=Неопределено;
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","ЗаявкаПоставщику");
	Если ТипЗнч(Данные)=Тип("ТаблицаЗначений") Тогда
		КолДан=Данные.Количество();
		Если КолДан>0 Тогда
			Объект.ЗаявкаПоставщику.Загрузить(Данные);
			Элементы.Группа10.Заголовок="Заказ поставщику ("+Строка(КолДан)+")";
		КонецЕсли;
	КонецЕсли;

	Данные=Неопределено;
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","УровниЦен");
	Если ТипЗнч(Данные)=Тип("ТаблицаЗначений") И Данные.Количество()>0 Тогда
		Мас=Данные.ВыгрузитьКолонку("Наименование");                                          
		Элементы.УровеньЦен.СписокВыбора.ЗагрузитьЗначения(Мас);
		Элементы.УровеньЦенЕмекс.СписокВыбора.ЗагрузитьЗначения(Мас);
	Иначе
		Мас=Новый Массив;
		Мас.Добавить("Закупочная");
		Элементы.УровеньЦен.СписокВыбора.ЗагрузитьЗначения(Мас);
		Элементы.УровеньЦенЕмекс.СписокВыбора.ЗагрузитьЗначения(Мас);
	КонецЕсли;

 	Попытка
		#Если ВебКлиент Тогда
			Объект.РежимМодальности=Ложь;
		#Иначе
			Объект.РежимМодальности=НЕ Метаданные.РежимИспользованияМодальности=Метаданные.СвойстваОбъектов.РежимИспользованияМодальности.НеИспользовать;
		#КонецЕсли
	Исключение
		Объект.РежимМодальности=Истина;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ВыяснитьКонфигурациюНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ВыяснитьКонфигурацию(ЭтаФорма.Элементы);
КонецФункции

&НаСервере
Процедура СохранитьЗаявкиНаСервере()
	Данные=Объект.ЗаявкаНаОформление.Выгрузить();
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","ЗаявкаНаОформление",Данные);
	Данные=Объект.ЗаявкаПоставщику.Выгрузить();
	ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","ЗаявкаПоставщику",Данные);
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.ПризакрытииОграничения();
КонецПроцедуры

&НаКлиенте   
Процедура ПриОткрытии(Отказ)
	Состояние("Запуск Ниракс: Помощника автобизнеса...", , "Восстанавливаем ранее сохраненные настройки");
	Объект.Версия = "4.2.000";
	Объект.Лицензия = "ПРОФ";
	
	// Определение конфигурации
	Рез=ВыяснитьКонфигурациюНаСервере();
	
	ЗаполнитьЗначенияСвойств(Объект,Рез);
	Отказ = Объект.ОтказОт;
	ЭтаФорма.Заголовок = "Ниракс: Помощник автобизнеса " + Объект.Лицензия + " " + Объект.Версия;
	//Определение доступности реквизитов
	//Убираем элементы формы, данные которых отсутствуют в данной конфигурации
	Элементы.ЗаказПокупателяВрем.Видимость=Рез.ЕстьЗаказ;
	Элементы.РеализацияТоваровВрем.Видимость=Рез.ЕстьРеализация;
	Элементы.СчетФактураВрем.Видимость=Рез.ЕстьСчет;
	Элементы.Соглашение.Видимость=Рез.Свойство("Соглашение");
	Элементы.ДоговорДляЗаявки.Видимость=Объект.ДоговорДляЗаявки<>Неопределено;
	Элементы.ЧекККМ.Видимость=Объект.КассаККМ<>Неопределено;
	Элементы.ПоискЕмекс.Видимость=Объект.ИспользоватьПроценкуОнлайнПоставщиков;
	Элементы.ДополнительноTecDoc.Видимость=Объект.СпецНаз.ДополнительноПоставщикам;
	Элементы.ДополнительноПрайс.Видимость=Объект.СпецНаз.ДополнительноПоставщикам;
	Элементы.ДополнительноПроценки.Видимость=Объект.СпецНаз.ДополнительноПоставщикам;
	Элементы.ДополнительноКорзина.Видимость=Объект.СпецНаз.ДополнительноПоставщикам;
	Элементы.ДополнительноПоставщикам.Видимость=Объект.СпецНаз.ДополнительноПоставщикам;
	Элементы.СтраницаПоискПоАртикулу.Видимость=Рез.TecDocПодключен;
	Элементы.Стр3.Видимость=Рез.TecDocПодключен;
		
	// Присваиваем начальные значения реквизитам
	Если НЕ (Пред1 ИЛИ Пред2 ИЛИ Пред3 Или Пред4 Или Пред5) Тогда Пред1=Истина;КонецЕсли; 
	ПредПриИзменении(Неопределено);	
	ИзменениеУровняЦенНаСервере();
	УровеньЦенЕмексПриИзмененииНаСервере();
	Объект.ОбщийПоискВрем=Объект.ОбщийПоиск;
	Объект.ВыводитьНаличиеВрем=Объект.ВыводитьНаличие;
	Объект.ВыводитьАналогиВрем=Объект.ВыводитьАналоги;
	Объект.ЗаказПокупателяВрем=Объект.ЗаказПокупателя;
	Объект.РеализацияТоваровВрем=Объект.РеализацияТоваров;
	Объект.СчетФактураВрем=Объект.СчетФактура;
	Объект.СкладДляЗаявки=Объект.Склад;
	Объект.ФильтрСклад=Объект.Склад;
	Объект.ФильтрСкладЕмекс=Объект.Склад;
	Объект.ФильтрСкладПрайс=Объект.Склад;
	Если ПустаяСтрока(Объект.ШаблонНаименования) Тогда
		Объект.ШаблонНаименования = "&К &Н *&П";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ШаблонНаименованияП) Тогда
		Объект.ШаблонНаименованияП = "&К &Н *&П";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ШаблонНомераДляПоиска) Тогда
		Объект.ШаблонНомераДляПоиска = "&К_&П";
	КонецЕсли;
	Ошибки="";
		
	Если Не ЗначениеЗаполнено(ТипАвто) Тогда ТипАвто="всем автомобилям";КонецЕсли;
	Если Объект.TecDocПодключен Тогда
		ТипАвтоПриИзменении(Неопределено);
	КонецЕсли;
	
	// Заносим сохраненное значение артикула в список выбора
	Если Объект.НомерАртикула<>"" Тогда
		НомерАртикулаПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	#Если ВебКлиент Тогда
	#Иначе
		Если Объект.РежимМодальности Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Текст = "Вы действительно хотите выйти из ""Ниракс: Помощник автобизнеса?""";
			Ответ = Вопрос(Текст, Режим, 0,,"Ниракс: Помощник автобизнеса");
			Если Ответ = КодВозвратаДиалога.Нет Тогда   //продолжаем работать
				Отказ=Истина; 
				Возврат;
			КонецЕсли;   
		КонецЕсли;
	#КонецЕсли
	СохранитьЗаявкиНаСервере();
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НомерАртикулаПриИзменении(Элемент)
	Если Элементы.НомерАртикула.СписокВыбора.НайтиПоЗначению(Объект.НомерАртикула) = Неопределено Тогда
		Элементы.НомерАртикула.СписокВыбора.Вставить(0,Объект.НомерАртикула);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КартинкаНираксНажатие(Элемент)
	ЗапуститьПриложение("https:\\www.nirax.ru?from=tecdoc_ut11");
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПоискПоВИН Тогда
		Элементы.НомерАртикула.Заголовок = "Номер VIN";
	Иначе
		Элементы.НомерАртикула.Заголовок = "Номер артикула";
	КонецЕсли; 
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийЭлементовСтраницыПоискаПоАртикулу

&НаКлиенте
Процедура ПредПриИзменении(Элемент)
	Если Элемент=Элементы.Пред4 Тогда
		Пред2=Пред4;
	КонецЕсли;
	Если Элемент=Элементы.Пред0 И Пред0 Тогда 
		Пред1=Истина; Пред2=Истина; Пред3=Истина;
		Пред4=Истина; Пред5=Истина;
		Элементы.Пред0.Доступность=Ложь;
	ИначеЕсли Пред1 И Пред2 И Пред3 И Пред4 И Пред5 Тогда
		Пред0=Истина;
		Элементы.Пред0.Доступность=Ложь;
	ИначеЕсли НЕ (Пред1 ИЛИ Пред2 ИЛИ Пред3 ИЛИ Пред4 ИЛИ Пред5) Тогда
		Пред1=Истина;
	Иначе
		Пред0=Ложь;
		Элементы.Пред0.Доступность=Истина;
	КонецЕсли;
	Предикат=Сред(?(Пред1,", '1'","")+?(Пред2,", '2'","")+?(Пред3,", '3'","")
	+?(Пред4,", '4'","")+?(Пред5,", '5'",""),3);
КонецПроцедуры

&НаКлиенте
Процедура Пред0ПриИзменении(Элемент)
	ПредПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Пред1ПриИзменении(Элемент)
	ПредПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Пред3ПриИзменении(Элемент)
	ПредПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Пред4ПриИзменении(Элемент)
	ПредПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура Пред5ПриИзменении(Элемент)
	ПредПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)
	Если Элемент=Элементы.ФильтрСклад И 
		ТипЗнч(Элементы.Результат.ТекущаяОбласть)=Тип("ОбластьЯчеекТабличногоДокумента") Тогда
		ТекСтр=Элементы.Результат.ТекущаяОбласть.Верх;
		ТекКол=Элементы.Результат.ТекущаяОбласть.Лево;
	Иначе
		ТекСтр=1;ТекКол=1;
	КонецЕсли;
	
	ФильтрПриИзмененииНаСервере();
	ТекущаяОбласть=Результат.Область(ТекСтр,ТекКол,ТекСтр,ТекКол);
	Элементы.Результат.ТекущаяОбласть=ТекущаяОбласть;
КонецПроцедуры

&НаСервере
Процедура ФильтрПриИзмененииНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	ТЗ = РезультатПоискаТЗ.Выгрузить();
	Если ПустаяСтрока(Объект.ФильтрМарка) Тогда
		КолСтр=Обработка.ВыводРезультатаПоиска(ТЗ,Результат);
	Иначе
		Структура = Новый Структура("поставщик",Объект.ФильтрМарка);
		Массив = ТЗ.НайтиСтроки(Структура);
		КолСтр=Обработка.ВыводРезультатаПоиска(Массив, Результат);
	КонецЕсли;
	Элементы.СтраницаПоискПоАртикулу.Заголовок="Поиск по артикулу (TecDoc)("+Строка(КолСтр)+")";
КонецПроцедуры

&НаКлиенте
Процедура ФильтрМаркаПриИзменении(Элемент)
	ФильтрПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСкладПриИзменении(Элемент)
	ФильтрПриИзменении(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ТипЦенПриИзменении(Элемент)
	ТекСтр=1;ТекКол=1;
	ФильтрПриИзмененииНаСервере();
	ТекущаяОбласть=Результат.Область(ТекСтр,ТекКол,ТекСтр,ТекКол);
	Элементы.Результат.ТекущаяОбласть=ТекущаяОбласть;
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	Если Расшифровка=Неопределено тогда
		Если ТипЗнч(Элемент.ТекущаяОбласть)=Тип("РисунокТабличногоДокумента") тогда
			Расшифровка=Элемент.ТекущаяОбласть.Расшифровка;
		иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Попытка

		Если Расшифровка.Действие="ДобавитьВЗаявку" Тогда
			Если Объект.КонтрольОстатков И Расшифровка.Остаток=0 Тогда
				Попытка
					ТекстОшибки="Для оформления заявки с нулевыми остатками требуется в настройках убрать признак контроля остатков";
					Предупреждение(ТекстОшибки);
				Исключение
					Сообщить(ТекстОшибки);
				Конецпопытки;
				Возврат;
			КонецЕсли;
			
			ПередачаПараметров=Новый Структура;
			ПередачаПараметров.Вставить("Номенклатура",Расшифровка.Номенклатура);
			ПередачаПараметров.Вставить("Склад",Объект.ФильтрСклад);
			Если (Объект.ЗапрашиватьКоличество ИЛИ Объект.ЗапрашиватьЦену ИЛИ Объект.ЗапрашиватьСкидку) Тогда
				ПередачаПараметров.Вставить("Остаток",Расшифровка.Остаток);
				ПередачаПараметров.Вставить("ЦенаПоУмолчанию",Расшифровка.Цена);
				ПередачаПараметров.Вставить("КонтрольОстатков",Объект.КонтрольОстатков);
				ПередачаПараметров.Вставить("ЗапрашиватьКолво",Объект.ЗапрашиватьКоличество);
				ПередачаПараметров.Вставить("ЗапрашиватьЦену",Объект.ЗапрашиватьЦену);
				ПередачаПараметров.Вставить("ЗапрашиватьСкидку",Объект.ЗапрашиватьСкидку);
				
				Оповещение=Новый ОписаниеОповещения("ДобавитьВЗаявкуНаСервере",ЭтаФорма,Неопределено);
				ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПередачаПараметров,ЭтаФорма,Истина,,,Оповещение);
			Иначе
				ПередачаПараметров.Вставить("Количество",1);
				ПередачаПараметров.Вставить("Цена",Расшифровка.Цена);
				ПередачаПараметров.Вставить("Скидка",0);
				ДобавитьВЗаявкуНаСервере(ПередачаПараметров);
			КонецЕсли;
			Возврат;
		ИначеЕсли Расшифровка.Действие="ОткрытьФорму" Тогда
		
			ПараметрыФормы=Новый Структура("Ключ",Расшифровка.Значение);
			ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",ПараметрыФормы);
		ИначеЕсли Расшифровка.Действие = "ДополнитьИнформацию" Тогда
			ОбработкаРасшифровкиНаСервере(Расшифровка, Элемент.Имя);
			Если ЗначениеЗаполнено(Расшифровка.Номенклатура) Тогда
				Ключ = Новый Структура("Ключ", Расшифровка.Номенклатура);
				ФормаЭлемента=ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", Ключ);
			КонецЕсли;	
			
		// если дополняем информацию	
		ИначеЕсли Расшифровка.Действие="ДобавитьДетальВБазу" Тогда
			ТипНомера=Неопределено;
        	Номенклатура=ДобавитьТоварВБазуНаСервере(Расшифровка.Значение, ТипНомера,Элемент.Имя,Расшифровка.НомерКартинки);
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				Если Объект.ЗапрашиватьГруппуНоменклатуры Тогда
					ПараметрыФормы = Новый Структура("УникальныйИдентификатор", новый УникальныйИдентификатор);
					Оповещение = Новый ОписаниеОповещения("ВходВгруппу", ЭтаФорма, Номенклатура);
			
					ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",ПараметрыФормы,,,,,Оповещение);
				Иначе
					ПараметрыФормы=Новый Структура("Ключ",Номенклатура);
					ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",ПараметрыФормы);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Расшифровка.Действие = "Назад" Тогда
			Если Элемент.Имя="Результат1" Тогда
				Элементы.Результат1.Видимость=Ложь;
				Элементы.Результат.Видимость=Истина;
			Иначе
				Элементы.РезультатПоДереву1.Видимость=Ложь;
				Элементы.РезультатПоДереву.Видимость=Истина;
			КонецЕсли;
		ИначеЕсли Расшифровка.Действие="РасшифровкаДляПроценки" Тогда
			Объект.НомерАртикула = Расшифровка.Значение;
			ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.ПоискЕмекс;
			ПоискПоАртикулу();
		Иначе
			ОбработкаРасшифровкиНаСервере(Расшифровка,Элемент.Имя);
		КонецЕсли;
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
	
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийЭлементовСтраницыПоискаПоПрайсу

&НаКлиенте
Процедура УровеньЦенПриИзменении(Элемент)
	
	ИзменениеУровняЦенНаСервере();	
	
КонецПроцедуры

&НаСервере
Процедура ИзменениеУровняЦенНаСервере()
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","УровниЦен");
	Если ТипЗнч(Данные)=Тип("ТаблицаЗначений") И Данные.Количество()>0 Тогда
		Стр=Данные.Найти(Объект.УровеньЦен,"Наименование");
		Объект.НаценкаПрайс=?(Стр=Неопределено,1,1+Стр.Наценка/100);
	Иначе
		Объект.УровеньЦен="Закупочная";
		Объект.НаценкаПрайс=1;
	КонецЕсли;
	
	Если РезультатПоискаПрайс.Количество()>0 Тогда
		Обработка=РеквизитФормыВЗначение("Объект");
		КолПрайс=Обработка.ВыводРезультатаПоискаПрайс(РезультатПоискаПрайс, РезультатПрайс);
		Элементы.СтраницаПоискПоПрайсу.Заголовок="Поиск по артикулу (прайс-листы) ("+Строка(КолПрайс)+")";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСкладПрайсПриИзменении(Элемент)
	Если РезультатПоискаПрайс.Количество()>0 Тогда
		ФильтрСкладПрайсПриИзмененииНаСервере()
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ФильтрСкладПрайсПриИзмененииНаСервере()
	Обработка=РеквизитФормыВЗначение("Объект");
	КолПрайс=Обработка.ВыводРезультатаПоискаПрайс(РезультатПоискаПрайс, РезультатПрайс);
	Элементы.СтраницаПоискПоПрайсу.Заголовок="Поиск по артикулу (прайс-листы) ("+Строка(КолПрайс)+")";
КонецПроцедуры

&НаКлиенте
Процедура РезультатПрайсОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Расшифровка=Неопределено тогда
		Если ТипЗнч(Элемент.ТекущаяОбласть)=Тип("РисунокТабличногоДокумента") тогда
			Расшифровка=Элемент.ТекущаяОбласть.Расшифровка;
		иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	ЕСли Расшифровка.Действие = "Открыть" Тогда
		ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",Новый Структура("Ключ",Расшифровка.Значение));
		
	ИначеЕсли Расшифровка.Действие = "ДобавитьВЗаявкуПрайс" Тогда
	    // проверим наличие детали в базе
		Если Объект.ЗапрашиватьГруппуНоменклатуры Тогда
			Номенклатура=ПолучитьНоменклатуруТовараНаСервере(Новый Структура("Артикул,Наименование,Производитель",Расшифровка.Артикул,Расшифровка.Название,Расшифровка.Производитель),Ложь);
			Если Номенклатура = Неопределено Тогда
				Номенклатура=ПолучитьНоменклатуруТовараНаСервере(Новый Структура("Артикул,Наименование,Производитель",Расшифровка.Артикул,Расшифровка.Название,Расшифровка.Производитель));
				Оповещение = Новый ОписаниеОповещения("ВходВгруппуПрайс", ЭтаФорма, Новый Структура("Номенклатура, Расшифровка", Номенклатура, Расшифровка));
		        ПараметрыФормы = Новый Структура("УникальныйИдентификатор", новый УникальныйИдентификатор);
				ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",ПараметрыФормы,,,,,Оповещение);
			КонецЕсли;
		Иначе
			Номенклатура=ПолучитьНоменклатуруТовараНаСервере(Новый Структура("Артикул,Наименование,Производитель",Расшифровка.Артикул,Расшифровка.Название,Расшифровка.Производитель));
		КонецЕсли;
		
		
		ПроверкаОтбор = Новый Структура("Номенклатура, Поставщик, Склад", Номенклатура, Расшифровка.Поставщик, Объект.ФильтрСкладПрайс);
		ПроверкаСуществования = Объект.ЗаявкаПоставщику.НайтиСтроки(ПроверкаОтбор);
		Остаток=Число(Расшифровка.Остаток)-?(ПроверкаСуществования.Количество()=0,0,ПроверкаСуществования[0].Количество);
		Если Остаток<=0 И Объект.КонтрольОстатков Тогда
			ТекстОшибки="Для оформления заказа с нулевыми остатками требуется в настройках убрать признак контроля остатков";
			Попытка
				Предупреждение(ТекстОшибки);
			Исключение
				Сообщить(ТекстОшибки);
			Конецпопытки;
			Возврат;
		КонецЕсли;
		Если Объект.ЗапрашиватьКоличество ИЛИ ((Объект.ЗапрашиватьЦену ИЛИ Объект.ЗапрашиватьСкидку) И Объект.ВКорзину) Тогда
			ПередачаПараметров = Новый Структура(
			"Номенклатура,Склад,Остаток,ЦенаПоУмолчанию,КонтрольОстатков,ЗапрашиватьКолво,ЗапрашиватьЦену,ЗапрашиватьСкидку",
			Номенклатура,Объект.ФильтрСкладПрайс,Остаток,Расшифровка.Цена,Объект.КонтрольОстатков,
			Объект.ЗапрашиватьКоличество, Объект.ВКорзину И Объект.ЗапрашиватьЦену, Объект.ВКорзину И Объект.ЗапрашиватьСкидку);
			Оповещение=Новый ОписаниеОповещения("ОбработкаРасшифровкиПрайсНаСервере",ЭтаФорма,Расшифровка);
			ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПередачаПараметров,ЭтаФорма,Истина,,,Оповещение)
		Иначе
			Данные=Новый Структура("Номенклатура,Склад,Количество,Цена,Скидка",
			Номенклатура,Объект.ФильтрСкладПрайс,1,Расшифровка.Цена,0);
			ОбработкаРасшифровкиПрайсНаСервере(Данные,Расшифровка)
		КонецЕсли;
			
	КонецЕсли;
		
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийЭлементовСтраницыПоискаОнлайн

&НаКлиенте
Процедура ФильтрМаркаЕмексПриИзменении(Элемент)
	ФильтрТекст = Элемент.ВыделенныйТекст;
	ФильтрМаркаЕмексПриИзмененииНаСервере(Элемент.ВыделенныйТекст);
	Элемент.ВыделенныйТекст = ФильтрТекст;
КонецПроцедуры

Процедура ФильтрМаркаЕмексПриИзмененииНаСервере(эл)
	ЭтоОбъект=РеквизитФормыВЗначение("Объект");
	ОтборПараметры=Новый	Структура("Склад,ЕстьНаСкладе,ЕстьУПоставщика",Объект.ФильтрСкладЕмекс,ЕстьНаСкладе,ЕстьУПоставщика);
	ТЗ = РезультатПоискаЕмекс.Выгрузить();
	Если ЗначениеЗаполнено(эл) Тогда
		Структура = Новый Структура;
		Структура.Вставить("Производитель",эл);
		Массив = ТЗ.НайтиСтроки(Структура);
		Если ТЗ.Колонки.Найти("ДляПоиска") <> Неопределено Тогда
			КолЕмекс=ЭтоОбъект.ВыводРезультатаПоискаТоваровЕмекс(Массив, РезультатЕмекс);
		Иначе
			КолЕмекс=ЭтоОбъект.ВыводРезультатаПоискаЕмекс(Массив, РезультатЕмекс, ОтборПараметры);
		КонецЕсли;
	Иначе
		Если ТЗ.Колонки.Найти("ДляПоиска") <> Неопределено Тогда
			КолЕмекс=ЭтоОбъект.ВыводРезультатаПоискаТоваровЕмекс(ТЗ, РезультатЕмекс);
		Иначе
			КолЕмекс=ЭтоОбъект.ВыводРезультатаПоискаЕмекс(ТЗ,РезультатЕмекс,ОтборПараметры);
		КонецЕсли;
	КонецЕсли;
	//Сфокусируемся на первом элементе
	ТекущаяОбласть=Результат.Область("R1C1");
	Элементы.Результат.ТекущаяОбласть = ТекущаяОбласть;	
	Если ЗначениеЗаполнено(КолЕмекс) И КолЕмекс > 0 Тогда
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики) (" + КолЕмекс + ")";
	Иначе
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики)";
	КонецЕСли;
		
КонецПроцедуры

&НаКлиенте
Процедура ФильтрМаркаЕмексОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Объект.ФильтрМаркаЕмекс = ВыбранноеЗначение;
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСкладЕмексПриИзменении(Элемент)
	ФильтрСкладЕмексПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ФильтрСкладЕмексПриИзмененииНаСервере()
	ЭтоОбъект=РеквизитФормыВЗначение("Объект");
	ОтборПараметры=Новый Структура("Склад,ЕстьНаСкладе,ЕстьУПоставщика",Объект.ФильтрСкладЕмекс,ЕстьНаСкладе,ЕстьУПоставщика);
	ТЗ = РезультатПоискаЕмекс.Выгрузить();
	//Сохраним позицию курсора
	ТекущаяОбласть = Элементы.РезультатЕмекс.ТекущаяОбласть;
	Если ЗначениеЗаполнено(Объект.ФильтрМаркаЕмекс) Тогда
		Структура = Новый Структура;
		Структура.Вставить("Производитель", Объект.ФильтрМаркаЕмекс);
		Массив = ТЗ.НайтиСтроки(Структура);
		КолЕмекс=ЭтоОбъект.ВыводРезультатаПоискаЕмекс(Массив, РезультатЕмекс, ОтборПараметры);
	Иначе
		КолЕмекс=ЭтоОбъект.ВыводРезультатаПоискаЕмекс(ТЗ,РезультатЕмекс,ОтборПараметры);
	КонецЕсли; 
	//Восстановим позицию курсора
	Элементы.РезультатЕмекс.ТекущаяОбласть = ТекущаяОбласть;
	Если ЗначениеЗаполнено(КолЕмекс) И КолЕмекс > 0 Тогда
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики) (" + КолЕмекс + ")";
	Иначе
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики)";
	КонецЕСли;

КонецПроцедуры

&НаКлиенте
Процедура УровеньЦенЕмексПриИзменении(Элемент)
	УровеньЦенЕмексПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура УровеньЦенЕмексПриИзмененииНаСервере()
	Данные=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","УровниЦен");
	Если ТипЗнч(Данные)=Тип("ТаблицаЗначений") И Данные.Количество()>0 Тогда
		Стр=Данные.Найти(Объект.УровеньЦенЕмекс,"Наименование");
		Объект.НаценкаПроценки=?(Стр=Неопределено,1,1+Стр.Наценка/100);
	Иначе
		Объект.УровеньЦен="Закупочная";
		Объект.НаценкаПроценки=1;
	КонецЕсли;
	Для Каждого Стр Из РезультатПоискаЕмекс Цикл
		Стр.Цена=Стр.ЦенаПоставки*Объект.НаценкаПроценки;
	КонецЦикла;
	ФильтрСкладЕмексПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РезультатЕмексОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	Если Расшифровка=Неопределено тогда
		Если ТипЗнч(Элемент.ТекущаяОбласть)=Тип("РисунокТабличногоДокумента") тогда
			Расшифровка=Элемент.ТекущаяОбласть.Расшифровка;
		иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Попытка

		Если Расшифровка.Действие="ДобавитьВЗаявку" Тогда
			
			Если НЕ Объект.КонтрольОстатков ИЛИ (Объект.КонтрольОстатков И Расшифровка.Остаток > 0)  Тогда
				
				Отбор = Новый Структура("Наименование, Склад, Сайт", Расшифровка.Название, Объект.ФильтрСкладЕмекс, "");
				ПроверкаСуществованияКорзина = Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);				
				
				Если Объект.ЗапрашиватьКоличество или Объект.ЗапрашиватьЦену или Объект.ЗапрашиватьСкидку Тогда
					ПередачаПараметров=Новый Структура("Номенклатура,Склад,Остаток,ЦенаПоУмолчанию,КонтрольОстатков,ЗапрашиватьКолво,ЗапрашиватьЦену,ЗапрашиватьСкидку",
					Расшифровка.Название,Объект.ФильтрСклад,Расшифровка.Остаток,Расшифровка.Цена,
					Объект.КонтрольОстатков,Объект.ЗапрашиватьКоличество,Объект.ЗапрашиватьЦену,Объект.ЗапрашиватьСкидку);
					Оповещение=Новый ОписаниеОповещения("ДобавитьВЗаявкуНаСервере",ЭтаФорма,Неопределено);
					ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПередачаПараметров,ЭтаФорма,Истина,,,Оповещение);
				Иначе
					ПередачаПараметров=Новый Структура("Номенклатура,Склад,Количество,Цена,Скидка",
					Расшифровка.Название,Объект.ФильтрСклад,1,Расшифровка.Цена,0);
					ДобавитьВЗаявкуНаСервере(ПередачаПараметров);
				КонецЕсли;
			Иначе
				Попытка
					Предупреждение("Для оформления заявки с нулевыми остатками требуется в настройках убрать признак контроля остатков");
				Исключение
					Сообщить("Для оформления заявки с нулевыми остатками требуется в настройках убрать признак контроля остатков");
				КонецПопытки;
			КонецЕсли;
			
		ИначеЕсли Расшифровка.Действие="ДобавитьВЗаявкуССайта" Или Расшифровка.Действие="ДобавитьВЗаявкуССайтаПрисутствие" Тогда
			
			Запись = Расшифровка.Запись;
			
			Если Запись.Наличие <=0 И Объект.КонтрольОстатков Тогда
				Попытка
					Предупреждение("Не хватает товара на складе");
				Исключение
					Сообщить("Не хватает товара на складе");
				КонецПопытки;
				Возврат;
			КонецЕсли;
				
			//Если Расшифровка.Действие="ДобавитьВЗаявкуССайта" Тогда
			Если Запись.Номенклатура.Пустая() Тогда	
				НоменклатураСсылка = ДобавлениеТовараВБазуЕмекс(Запись);
				Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
					Возврат;
				Иначе
					Запись.Номенклатура=НоменклатураСсылка;
					Если Объект.ЗапрашиватьГруппуНоменклатуры Тогда
						Оповещение = Новый ОписаниеОповещения("ВходВгруппуЕмекс", ЭтаФорма, Запись);
				        ПараметрыФормы = Новый Структура("УникальныйИдентификатор", новый УникальныйИдентификатор);
						ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",ПараметрыФормы,,,,,Оповещение);
					КонецЕсли;	
					
				КонецЕсли;
			Иначе 
				НоменклатураСсылка = Запись.Номенклатура; //ЗначениеАналог; 
			КонецЕсли;
			
			Отбор = Новый Структура("Номенклатура, idСклад, Сайт", Запись.Номенклатура, Запись.idСклад, Запись.Сайт);
			ПроверкаСуществованияКорзина = Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
			Если ПроверкаСуществованияКорзина.Количество()=0 Тогда
				ЗаписьВКорзине=Неопределено;
				МожноВКорзину=Запись.Наличие;
			Иначе
				ЗаписьВКорзине=ПроверкаСуществованияКорзина[0];
				МожноВКорзину=Запись.Наличие-ЗаписьВКорзине.Количество;
				Если МожноВКорзину<=0 И Объект.КонтрольОстатков Тогда
					Попытка
						Предупреждение("В корзине уже находится "+Строка(ЗаписьВКорзине.Количество)+" единиц на товара.");
					Исключение
						Сообщить("В корзине уже находится "+Строка(ЗаписьВКорзине.Количество)+" единиц на товара.");
					Конецпопытки;
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			Если Объект.ЗапрашиватьКоличество или Объект.ЗапрашиватьЦену или Объект.ЗапрашиватьСкидку Тогда
				ПараметрыФормы=Новый Структура("Номенклатура,Склад,Остаток,ЦенаПоУмолчанию,КонтрольОстатков,ЗапрашиватьКолво,ЗапрашиватьЦену,ЗапрашиватьСкидку",
				НоменклатураСсылка,Объект.ФильтрСкладЕмекс,МожноВКорзину,Запись.Цена,Объект.КонтрольОстатков,Объект.ЗапрашиватьКоличество,Объект.ЗапрашиватьЦену,Объект.ЗапрашиватьСкидку);
				Оповещение=Новый ОписаниеОповещения("ДобавитьВЗаявкуНаСервере",ЭтаФорма,Запись);
				ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение);
			Иначе
				Данные=Новый Структура("Номенклатура,Склад,Количество,Цена,Скидка",
				НоменклатураСсылка,Объект.ФильтрСкладЕмекс,1,Запись.Цена,0);
				ДобавитьВЗаявкуНаСервере(Данные,Запись);
			КонецЕсли;
			
		ИначеЕсли Расшифровка.Действие = "ДобавитьДетальВБазу" Тогда
			
			Запись = Расшифровка.Запись;
			Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
				ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",Новый Структура("Ключ",Запись.Номенклатура),Запись.Номенклатура);
				//Запись.Номенклатура.ПолучитьФорму("ФормаЭлемента").Открыть();
			Иначе
				НоменклатураСсылка = ДобавлениеТовараВБазуЕмекс(Запись);
				Если НоменклатураСсылка <> Неопределено Тогда
					Если Объект.ЗапрашиватьГруппуНоменклатуры Тогда
						Оповещение = Новый ОписаниеОповещения("ВходВгруппуЕмексДобавить", ЭтаФорма, НоменклатураСсылка);
				        ПараметрыФормы = Новый Структура("УникальныйИдентификатор", новый УникальныйИдентификатор);
						ОткрытьФорму("Справочник.Номенклатура.ФормаВыбораГруппы",ПараметрыФормы,,,,,Оповещение);
					Иначе
						ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",Новый Структура("Ключ",НоменклатураСсылка),НоменклатураСсылка);
					КонецЕсли;
					
				КонецЕсли; 
			КонецЕсли;
			
		ИначеЕсли Расшифровка.Действие = "ОткрытьФорму" Тогда
		
			ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",Новый Структура("Ключ",Расшифровка.Значение),Расшифровка.Значение);
			
		ИначеЕсли Расшифровка.Действие = "ПоискЦенТоваров" Тогда
			ПоискЦенТоваровСервер(Расшифровка.Данные,Врег(ПодготовитьНомер(Объект.НомерАртикула)),Объект.ЕмексИскатьСЗаменамиИАналогами);
			
				
		КонецЕсли;
		
	Исключение
		
		Сообщить(ОписаниеОшибки());
		
	КонецПопытки;
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийЭлементовСтраницыПоискаПоАвтомобилю

&НаКлиенте
Процедура ТипАвтоПриИзменении(Элемент)
	Если ТипАвто="коду двигателя" Тогда
		Элементы.ФильтрМодельАвто.Видимость=Ложь;
		Элементы.КодДвигателя.Видимость=Истина;
	Иначе
		Элементы.ФильтрМодельАвто.Видимость=Истина;
		Элементы.КодДвигателя.Видимость=Ложь;
		Если ТипАвто="" Тогда
			ТипАвто="всем автомобилям";
		КонецЕсли;
	КонецЕсли;
	Элементы.ФильтрФирмаАвто.СписокВыбора.Очистить();
	ФильтрФирмаАвто="";
	КодДвигателя="";
	Состояние("Производится загрузка списка торговых марок.       Ж Д И Т Е . . .");
	
	//Элементы.ФильтрФирмаАвто.СписокВыбора.ВыбратьЭлемент();
	Элементы.ФильтрМодельАвто.СписокВыбора.Очистить();
	Элементы.ФильтрМодельАвто.Доступность=Ложь;
	Элементы.ЗагрузитьПоМодели.Доступность=Ложь;
	//Вызовем процедуру вывода марок
	ВыводМарокАвтоНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрФирмаАвтоПриИзменении(Элемент)
	КодДвигателя="";	
	Если ФильтрФирмаАвто="" Тогда	
		Элементы.ФильтрМодельАвто.СписокВыбора.Очистить(); 
		ФильтрМодельАвто = "";
		Элементы.ФильтрМодельАвто.Доступность=Ложь;
		Элементы.ЗагрузитьПоМодели.Доступность=Ложь;
		Состояние("Производится загрузка списка торговых марок.       Ж Д И Т Е . . .");
		ВыводМарокАвтоНаСервере();
	Иначе
		ФильтрМодельАвто="";
		Состояние("Производится загрузка марок автомобилей.        Ж Д И Т Е . . .");
		ВыводОтфильтрованныхМарокАвтоНаСервере();
		Элементы.ФильтрМодельАвто.Доступность=Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыводМарокАвтоНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ВыводМарокАвто(ТипАвто,РезультатУзлы,Элементы.ФильтрФирмаАвто.СписокВыбора,ТЗДляФильтраМарок);
КонецПроцедуры

&НаСервере
Процедура ВыводОтфильтрованныхМарокАвтоНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	МСтрФирма=ТЗДляФильтраМарок.НайтиСтроки(Новый Структура("MFA_BRAND",ФильтрФирмаАвто));
	Если НРЕГ(Лев(ТипАвто,1))="к" Тогда
		Обработка.ВыводОтфильтрованныхМарокАвто(МСтрФирма[0],РезультатУзлы,Элементы.КодДвигателя.СписокВыбора,Истина);
	Иначе
		Обработка.ВыводОтфильтрованныхМарокАвто(МСтрФирма[0],РезультатУзлы,Элементы.ФильтрМодельАвто.СписокВыбора);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КодДвигателяПриИзменении(Элемент)
	Состояние("Производится загрузка комплектаций автомобилей.         Ж Д И Т Е . . .");
	УзлыОбработкаНаСервере(Новый Структура("Действие,Значение", "РасшифровкаДвигателя", КодДвигателя), Неопределено);
КонецПроцедуры

&НаСервере
Процедура УзлыОбработкаНаСервере( Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка=Ложь;
	Попытка
		Если Расшифровка.Действие="РасшифровкаМодели" Тогда
			//Запомним таблицу до расшифровки
			Если РезультатУзлы.Область(2,1,2,1).Текст<>"Типы комплектаций:" Тогда
				РезультатМарокДляВозврата.Очистить();
				РезультатМарокДляВозврата.Вывести(РезультатУзлы);
				РезультатМарокДляВозврата.ТекущаяОбласть=Элементы.РезультатУзлы.ТекущаяОбласть;
			КонецЕсли;
			ФильтрМодельАвто=Элементы.РезультатУзлы.ТекущаяОбласть.Текст;
			Обработка = РеквизитФормыВЗначение("Объект");
			Обработка.ВыводТаблицыТипов(Расшифровка.Значение, РезультатУзлы);
		ИначеЕсли Расшифровка.Действие="РасшифровкаБренда" Тогда
			//Запомним таблицу до расшифровки
			ФильтрФирмаАвто=Расшифровка.Значение;
			ФильтрМодельАвто="";
			ВыводОтфильтрованныхМарокАвтоНаСервере();
			Элементы.ФильтрМодельАвто.Доступность=Истина;
		ИначеЕсли Расшифровка.Действие="НазадКМаркам" Тогда
			//вернем таблице исходный марочный вид
			РезультатУзлы.Очистить();
			РезультатУзлы.Вывести(РезультатМарокДляВозврата);
			Элементы.РезультатУзлы.ТекущаяОбласть=РезультатМарокДляВозврата.ТекущаяОбласть;
		ИначеЕсли Расшифровка.Действие="РасшифровкаОписания" Тогда
			Элементы.Группа4.Видимость=Ложь;
			Элементы.Группа5.Видимость=Истина;
			Обработка = РеквизитФормыВЗначение("Объект");
			Обработка.ВыводУзлов(Расшифровка.Значение, РезультатПоДереву, УзловоеДерево);
			ТипАвтоИзТаблицыТипов = Расшифровка.Значение;
			РезультатПоДереву.Очистить();
		ИначеЕсли Расшифровка.Действие="РасшифровкаДвигателя" Тогда
			Если РезультатУзлы.Область(2,1,2,1).Текст<>"Типы комплектаций:" Тогда
				РезультатМарокДляВозврата.Очистить();
				РезультатМарокДляВозврата.Вывести(РезультатУзлы);
				РезультатМарокДляВозврата.ТекущаяОбласть=Элементы.РезультатУзлы.ТекущаяОбласть;
			КонецЕсли;
			Если КодДвигателя<>Расшифровка.Значение Тогда КодДвигателя=Расшифровка.Значение;КонецЕсли;
			Обработка = РеквизитФормыВЗначение("Объект");
			Обработка.ВыводТаблицыТипов(Расшифровка.Значение, РезультатУзлы,Истина);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ФильтрМодельАвтоПриИзменении(Элемент)
	
	Если Элемент.ВыделенныйТекст="" Тогда	
		Состояние("Производится загрузка марок автомобилей.        Ж Д И Т Е . . .");
		ВыводОтфильтрованныхМарокАвтоНаСервере();
		Элементы.ЗагрузитьПоМодели.Доступность=Ложь;
	Иначе
		Состояние("Производится загрузка модели автомобиля.        Ж Д И Т Е . . .");
		ФильтрМодельАвтоПриИзмененииНаСервере();
		Элементы.ЗагрузитьПоМодели.Доступность=Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ФильтрМодельАвтоПриИзмененииНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ВыводОтфильтрованныхМоделейАвто(ФильтрФирмаАвто,ФильтрМодельАвто,РезультатУзлы,ТЗДляФильтраМарок);
	Элементы.РезультатУзлы.ТекущаяОбласть=РезультатУзлы.Область(1,1,1,1);
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатУзлыОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	Если Расшифровка=Неопределено тогда
		Если ТипЗнч(Элемент.ТекущаяОбласть)=Тип("РисунокТабличногоДокумента") тогда
			Расшифровка=Элемент.ТекущаяОбласть.Расшифровка;
		иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	Если Расшифровка.Действие="ЗагрузитьПоКомплектации" Тогда
		Состояние("Производится загрузка комплектующих автомобиля.  Ж Д И Т Е . . .");
		ПараметрыФормы=Новый Структура("Комплект", Расшифровка.Значение);
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаЗагрузкиУФ",ПараметрыФормы,ЭтаФорма);
	Иначе
		Состояние("Производится загрузка комплектаций автомобилей.         Ж Д И Т Е . . .");
		УзлыОбработкаНаСервере(Расшифровка, СтандартнаяОбработка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УзловоеДеревоПриАктивизацииСтроки(Элемент)
	
	попытка
		Если Элементы.УзловоеДерево.ТекущиеДанные<>Неопределено И Элементы.УзловоеДерево.ТекущиеДанные.ПолучитьЭлементы().Количество()=0 Тогда
			Если Элемент.ТекущиеДанные.Айди <> ОбработанныйУзелАйди или ОбработанныйУзелАйди="" тогда
				Элементы.РезультатПоДереву1.Видимость=Ложь;
				Элементы.РезультатПоДереву.Видимость=Истина;
				ОбработанныйУзелАйди=Элементы.УзловоеДерево.ТекущиеДанные.Айди;
				Состояние("Производится загрузка данных о комплектующих.     Ж Д И Т Е . . .");
				ПриАктивизацииНаСервере(Число(Элемент.ТекущиеДанные.айди));
			КонецЕсли;
		КонецЕсли;
	Исключение
		сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере                
Процедура ПриАктивизацииНаСервере(ТекДан) Экспорт
	РезультатПоДереву.Очистить();
	Обработка = РеквизитФормыВЗначение("Объект");
	ТЗРасшифровкаУзлов="";
	Обработка.ВыводРезультатаПоУзлам(ТЗРасшифровкаУзлов, РезультатПоДереву, ТекДан, 
	Элементы.РезультатУзлы.ТекущаяОбласть.Расшифровка.Значение);
КонецПроцедуры

&НаКлиенте
Процедура РезультатПоДеревуОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
КонецПроцедуры

&НаКлиенте
Процедура РезультатПоДереву1ОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
КонецПроцедуры

//#КонецОбласти

//#Область ОбработчикиСобытийЭлементовСтраницыКорзина

&НаКлиенте
Процедура ЗаявкаНаОформлениеПриИзменении(Элемент)
	Если  Объект.ЗаявкаНаОформление.Количество()>0 Тогда
		Данные=Новый Структура("Количество,Цена,Сумма,Скидка,СуммаСоСкидкой,СтавкаНДС,СуммаНДС,Всего");
		ЗаполнитьЗначенияСвойств(Данные,Элементы.ЗаявкаНаОформление.ТекущиеДанные);
		ЗаявкаНаОформлениеПриИзмененииНаСервере(Данные);
		ЗаполнитьЗначенияСвойств(Элементы.ЗаявкаНаОформление.ТекущиеДанные,Данные);
		СуммаКорзины=Объект.ЗаявкаНаОформление.Итог("Всего");
	КонецЕсли;
КонецПроцедуры

&НаСервере
