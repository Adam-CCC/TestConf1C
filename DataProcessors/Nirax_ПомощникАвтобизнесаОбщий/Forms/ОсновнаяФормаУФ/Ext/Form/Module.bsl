//      ****** общие команды  ******
&НаКлиенте
Процедура Дополнительно(Команда)
	Страница=Сред(Команда.Имя,14);
	Если Страница="Поставщикам" Тогда
		ТекДан=Элементы.ЗаявкаПоставщику.ТекущиеДанные;
		ТекСтр=Элементы.ЗаявкаПоставщику.ТекущаяСтрока;
		Если ТекДан=Неопределено Тогда
			ПараметрыФормы=Новый Структура("Страница,Сайт,Состояние",Страница,Неопределено,Неопределено);
		Иначе
			ПараметрыФормы=Новый Структура("Страница,Сайт,Состояние",Страница,ТекДан.Сайт,ТекДан.Состояние);
		КонецЕсли;
	ИначеЕсли Страница="Корзина" Тогда
		ТекДан=Элементы.ЗаявкаНаОформление.ТекущиеДанные;
		ТекСтр=Элементы.ЗаявкаНаОформление.ТекущаяСтрока;
		Если ТекДан=Неопределено Тогда
			ПараметрыФормы=Новый Структура("Страница,Сайт",Страница,Неопределено);
		Иначе
			ПараметрыФормы=Новый Структура("Страница,Сайт",Страница,ТекДан.Сайт);
		КонецЕсли;
	Иначе
		ТекСтр=Неопределено;
		ПараметрыФормы=Новый Структура("Страница",Страница);
	КонецЕсли;	
	ПараметрыФормы.Вставить("ПараметрыПользователя",Объект.СпецНаз.НастройкиПользователя);
		
	Если Объект.РежимМодальности Тогда
		Рез=ОткрытьФормуМодально(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ДополнительноУФ",ПараметрыФормы,ЭтаФорма);
		Если Рез=Неопределено Тогда Возврат;КонецЕсли;
		ВыполнитьДопМетодНаКлиенте(Рез,ТекСтр);
	Иначе
		Оповещение=Новый ОписаниеОповещения("ВыполнитьДопМетодНаКлиенте",ЭтаФорма,ТекСтр);
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ДополнительноУФ",ПараметрыФормы,ЭтаФорма,ПараметрыФормы,ВариантОткрытияОкна.ОтдельноеОкно,Оповещение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДопМетодНаКлиенте(Метод,ТекСтр) Экспорт
	Если Метод.НаКлиенте Тогда
		Рез=ВыполнитьМетодНаКлиенте(Метод,ТекСтр);
	Иначе
		Если Метод.Страница="Поставщикам" Тогда
			Если ТекСтр=Неопределено Тогда
				ТекДанные=Неопределено;
				ТекНом=Неопределено;
			Иначе
				ТекДанные=Объект.ЗаявкаПоставщику.НайтиПоИдентификатору(ТекСтр);
			    ТекНом=ТекДанные.НомерСтроки-1;
			КонецЕсли;
		ИначеЕсли Метод.Страница="Корзина" Тогда
			Если ТекСтр=Неопределено Тогда
				ТекДанные=Неопределено;
				ТекНом=Неопределено;
			Иначе
				ТекДанные=Объект.ЗаявкаНаОформление.НайтиПоИдентификатору(ТекСтр);
			    ТекНом=ТекДанные.НомерСтроки-1;
			КонецЕсли;
		Иначе
			ТекНом=Неопределено;
		КонецЕсли;
		//Параметры: Метиод - структура: Сайт, Метод из проценки
		//Номер строки из ТЧ ЗаявкиПоставщиков
	 	Рез=ВыполнитьДопМетодНаСервере(Метод,ТекНом);
	КонецЕсли;
	
	//Обработка результата выполнения метода:
	// Строка - сообщение об ошибке
	// Неопределено или Ложь - не выполнен
	// Истина - выполнен;
	// Табличный документ - выводится
	// Структура - изменены параметры (строки/заказа)
	//   если количество = 0 удалить - строку/заказ
	// Массив структур - требуется синхронизация
	
	// Если текст - сообщение об ошибке
	Если ТипЗнч(Рез)=Тип("Строка") Тогда
		ЕСли Не ПустаяСтрока(Рез) Тогда
			Если Объект.РежимМодальности Тогда
				Предупреждение(Рез);
			Иначе
				Сообщить(Рез);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Если Табличный документ - показать его
	Если ТипЗнч(Рез)=Тип("ТабличныйДокумент") Тогда
		Рез.Показать();       //"Данные о исполняемых заказах на сайте autologist.ru");
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Рез)=Тип("Булево") или Рез=Неопределено Тогда
		Если Рез=Неопределено или Рез=Ложь Тогда
			Текст = "Запрашиваемый метод не выполнен по неопределенным причинам";
		Иначе
			//Если выполнен - преобразования в соответствии с методом
			Текст= "Успешное завершение";
		КонецЕсли;
		Если Объект.РежимМодальности Тогда
			Предупреждение(Текст);
		Иначе
			Сообщить(Текст);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Рез)=Тип("Структура") Тогда
		Если Метод.Страница="Поставщикам" Тогда
			// Формируем массив строк изменяемых записей
			Если Метод.Объект="Запись" Тогда
				Мсиз=Новый Массив;
				МСиз.Добавить(ТекДанные);
			Иначе
				Отбор=Новый Структура("Сайт,Состояние",Метод.Сайт,Метод.Состояние);
				МСиз=Объект.ЗаявкаПоставщику.НайтиСтроки(Отбор);
			КонецЕсли;
			
			// Проверка на удаление записей
			Если Рез.Свойство("Количество") и Рез.Количество=0 Тогда
				Для Каждого Стр Из МСиз Цикл
					Объект.ЗаявкаПоставщику.Удалить(Стр);
				КонецЦикла;
			Иначе
				Для Каждого Стр Из МСиз Цикл
					ЗаполнитьЗначенияСвойств(Стр,Рез);
				КонецЦикла;
			КонецЕсли;
			Возврат;
		ИначеЕсли Метод.Страница="Корзина" Тогда
			Если Метод.Объект="Запись" Тогда
				Мсиз=Новый Массив;
				МСиз.Добавить(ТекДанные);
			Иначе
				Отбор=Новый Структура("Сайт",Метод.Сайт);
				МСиз=Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
			КонецЕсли;
			
			// Проверка на удаление записей
			Если Рез.Свойство("Количество") и Рез.Количество=0 Тогда
				Для Каждого Стр Из МСиз Цикл
					Объект.ЗаявкаНаОформление.Удалить(Стр);
				КонецЦикла;
			Иначе
				Для Каждого Стр Из МСиз Цикл
					ЗаполнитьЗначенияСвойств(Стр,Рез);
				КонецЦикла;
			КонецЕсли;
			Возврат;
		 КонецЕсли;
	КонецЕсли;
	
	Предупреждение("Метод выполнен, но обработка данных выполнения еще не реализована");
	
КонецПроцедуры

&НаСервере
