// ***** Поиск в TECDOC
&НаСервере
Процедура ПоискВТекДок(СписокГрупп)
	СтрокаОриг = Объект.НомерАртикула;
	СтрокаПоиска = Врег(ПодготовитьНомер(СтрокаОриг));
	Обработка=РеквизитФормыВЗначение("Объект");
	//Вызовем процедуру поиска
	ТЗТекДок = Обработка.ПоискПоАртикулуВТекДок(СтрокаПоиска, Предикат, СписокГрупп); 
	Обработка.ПоискВ1С(ТЗТекДок, СтрокаОриг,ПоШаблону);
	РезультатПоискаТЗ.Загрузить(ТЗТекДок);
	
	//Заполним список выбора ФильтрМарка
	ТабПоставщики=ТЗТекДок.Скопировать(,"поставщик");
	ТабПоставщики.Свернуть("поставщик");
	Элементы.ФильтрМарка.СписокВыбора.ЗагрузитьЗначения(ТабПоставщики.ВыгрузитьКолонку("поставщик"));
	КолСтр=Обработка.ВыводРезультатаПоиска(ТЗТекДок,Результат);
	Элементы.СтраницаПоискПоАртикулу.Заголовок="Поиск по артикулу (TecDoc)("+Строка(КолСтр)+")";
Конецпроцедуры

&НаКлиенте
Процедура ВходВгруппу(Результат,Номенклатура) Экспорт
	
	ВходВгруппуЕмексСервер(Результат,Номенклатура);	
	
	ПараметрыФормы=Новый Структура("Ключ",Номенклатура);
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",ПараметрыФормы);	
КонецПроцедуры

&НаСервере
Функция ДобавитьТоварВБазуНаСервере(Значение, ТипНомера, Элемент, НомерКартинки=0)
	Обработка=РеквизитФормыВЗначение("Объект");
	Номенклатура=Обработка.ДобавлениеТовараВБазу(Значение, ТипНомера);
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда Возврат Номенклатура;КонецЕсли;
	
	Если Элемент="Результат" или Элемент="Результат1" Тогда
		ТЗТекДок = РезультатПоискаТЗ.Выгрузить(); 
		Стр=ТЗТекДок.Найти(Значение,"ART_ID");
		Стр.Номенклатура=Номенклатура;
		Стр.ВБазе=1;
		Обработка.ЗаменаОбластиТабДок(Результат, "МакетПоискаПоАртикулу", Значение, Номенклатура);
		Элементы.Результат.ТекущаяОбласть=Результат.ТекущаяОбласть;
		
	Иначе
		
		Обработка.ЗаменаОбластиТабДок(РезультатПоДереву, "МакетУзлов", Значение, Номенклатура);
		Элементы.РезультатПоДереву.ТекущаяОбласть=РезультатПоДереву.ТекущаяОбласть;

	КонецЕсли;	
	
	Возврат Номенклатура;
КонецФункции

&НаСервере
Процедура ДобавитьВЗаявкуНаСервере(Данные,Запись=Неопределено) Экспорт
	Если Данные=Неопределено тогда возврат;КонецЕсли;
	Если Запись=Неопределено Тогда
		ЕстьПоставщик=Данные.Свойство("Поставщик");
		Если ЕстьПоставщик Тогда
			Отбор=Новый Структура("Наименование, Склад, Поставщик",Данные.Номенклатура,Данные.Склад,Данные.Поставщик);
		Иначе			
			Отбор=Новый Структура("Наименование, Склад, Сайт",Данные.Номенклатура,Данные.Склад,"");
		КонецЕсли;
		Массив=Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
	Иначе
		Отбор = Новый Структура("Наименование, idСклад, Сайт", Данные.Номенклатура, Запись.idСклад, Запись.Сайт);
		Массив = Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
	КонецЕсли;
	
	Если Массив.Количество()=0 Тогда
		Стр=Объект.ЗаявкаНаОформление.Добавить();
		Если Запись=Неопределено Тогда
			Стр.Склад=Данные.Склад;
			Стр.Артикул=Данные.Номенклатура.Артикул;
			Стр.НаименованиеТовара=Данные.Номенклатура.Наименование;
			Если ЕстьПоставщик Тогда
				Стр.Поставщик=Данные.Поставщик;
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(Стр,Запись,,"Наименование");
			Стр.НаименованиеТовара=Запись.Наименование;
			Стр.Склад=Запись.Сайт+": "+Запись.Склад;
		КонецЕсли;
		Стр.Наименование = Данные.Номенклатура;
    	Стр.Номенклатура = Данные.Номенклатура;
		Стр.Количество   = Данные.Количество;
		Элементы.СтрКорзина.Заголовок="Корзина ("+Строка(Объект.ЗаявкаНаОформление.Количество())+")";
	Иначе
		Стр=Массив[0];
		Стр.Количество=Стр.Количество+Данные.Количество;
	КонецЕсли;
	Стр.СтавкаНдс = Данные.Номенклатура.СтавкаНДС;
	Стр.Цена=Данные.Цена;
	Стр.Скидка=Данные.Скидка;
	Если Запись=Неопределено  И ЕстьПоставщик Тогда
		Стр.ЦенаПоставки=Данные.ЦенаПоставки;
		Стр.СрокДоставки=Данные.СрокДоставки;
	КонецЕсли;		
	Обработка=РеквизитФормыВЗначение("Объект");
	Обработка.РассчитатьСуммы(Стр);
	СуммаКорзины=Объект.ЗаявкаНаОформление.Итог("Всего");
КонецПроцедуры

&НаСервере
Процедура ОбработкаРасшифровкиНаСервере(Расшифровка, Элемент)
	Если Элемент="Результат" Тогда
		ТабДок=Результат;
	ИначеЕсли Элемент="Результат1" Тогда
		ТабДок=Результат1;
	ИначеЕсли Элемент="РезультатПоДереву" Тогда
		ТабДок=РезультатПоДереву;
	ИначеЕсли Элемент="РезультатПоДереву1" Тогда
		ТабДок=РезультатпоДереву1;
	КонецЕсли;
	//Разберемся, что за расшифровка
	Попытка
		Обработка=РеквизитФормыВЗначение("Объект");
		Если Расшифровка.Действие="СледующаяКартинка" Тогда
			Расшифровка.НомерКартинки=Расшифровка.НомерКартинки+1;
			Обработка.ВыводРасшифровки(Расшифровка.Значение, ТабДок, Расшифровка.НомерКартинки); 
		ИначеЕсли Расшифровка.Действие="ПредыдущаяКартинка" Тогда
			Расшифровка.НомерКартинки=Расшифровка.НомерКартинки-1;
			Обработка.ВыводРасшифровки(Расшифровка.Значение, ТабДок, Расшифровка.НомерКартинки); 
			
		ИначеЕсли Расшифровка.Действие = "ДополнитьИнформацию" Тогда
			
			Обработка.ДополнитьИнформацию(Расшифровка.Значение, Расшифровка.Номенклатура);
		ИначеЕсли Расшифровка.Действие = "РасшифровкаПоАртикулу" Тогда
			//Найдем нужную строку
			НомерКартинки=0;
			Если Элемент="Результат" Тогда
				Обработка.ВыводРасшифровки(Расшифровка.Значение, Результат1, НомерКартинки);
				Элементы.Результат.Видимость=Ложь;
				Элементы.Результат1.Видимость=Истина;
			Иначе
				Обработка.ВыводРасшифровки(Расшифровка.Значение, РезультатПоДереву1, НомерКартинки);
				Элементы.РезультатПоДереву.Видимость=Ложь;
				Элементы.РезультатПоДереву1.Видимость=Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

