// ***** Поиск в прайс-листах
&НаСервере
Функция ПолучитьНастройкиЗагрузки()
	НастройкаЗагрузки=ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","НастройкаЗагрузки");
	Мас=Новый Массив;
	ЕСли ТипЗнч(НастройкаЗагрузки)<>Тип("ТаблицаЗначений") Тогда
		Возврат Мас;
	КонецЕсли;
	Для Каждого Стр Из НастройкаЗагрузки Цикл
		Если Стр.Вкл Тогда
			Мас.Добавить(Новый Структура("Поставщик,ПутьКФайлу,Лист,Артикул,Наименование,Производитель,Время,Остаток,Цена",
			Стр.Поставщик,Стр.ПутьКФайлу,Стр.Лист,Стр.Артикул,Стр.Наименование,Стр.Производитель,Стр.Время,Стр.Остаток,Стр.Цена));
        КонецЕсли;
	КонецЦикла;
	Возврат Мас;
КонецФункции

&НаКлиенте
Процедура ПоискПрайсНаКлиенте(Артикул,АртОриг)
	Попытка
		Эксель = Новый COMОбъект("Excel.Application"); 
		Эксель.Displayalerts = 0;
	Исключение
		Сообщить("Ошибка при попытке работы с Mirosoft Excel, возможно он не установлен"+Символы.ПС+ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	НастройкаЗагрузки=ПолучитьНастройкиЗагрузки();
	Если НастройкаЗагрузки.Количество()=0 Тогда
		Сообщить("Отсутствут данные - выполните настройку поставщиков");
	КонецЕсли;
	ТЗРез=Новый Массив;
	Для Каждого СтрТаб из НастройкаЗагрузки Цикл
		Попытка	
			Книга = Эксель.WorkBooks.Open(СокрЛП(СтрТаб.ПутьКФайлу),0,Истина);
			Если СтрТаб.Лист<>"" Тогда
				Лист=Книга.Worksheets(СтрТаб.Лист)
			Иначе
				Лист=Книга.Worksheets(1);
			КонецЕсли;
			Лист.Activate();
			ВсегоСтрок = Лист.Cells(1,1).SpecialCells(11).Row; 
			ИмяКолонки=Символ(64+СтрТаб.Артикул);
			КонОбл=":"+ИмяКолонки+Формат(ВсегоСтрок,"ЧГ=0");
			МасПоиск=Новый Массив;
			МасПоиск.Добавить(АртОриг);
			Если ВРЕГ(СокрЛП(АртОриг))<>ВРЕГ(СОКРЛП(Артикул)) Тогда
				МасПоиск.Добавить(Артикул);
			КонецЕсли;
			Попытка 
				АртЧисло=Число(АртОриг);
				МасПоиск.Добавить(АртЧисло);
			Исключение
			Конецпопытки;
			Для Каждого Искомое из МасПоиск Цикл
				НомерСтроки=1;
				Пока Истина Цикл
					Попытка
	        			Сдвиг=Эксель.WorksheetFunction.Match(Искомое,Лист.Range(ИмяКолонки+Формат(НомерСтроки,"ЧГ=0")+КонОбл),0);
					Исключение
						Сдвиг=Неопределено;
					Конецпопытки;
					//Если не нашли - выходим
					Если ТипЗнч(Сдвиг)<>Тип("Число") Тогда 
						Прервать;
					КонецЕсли;
					
					//Если нашли - вносим данные в таблицу
					НомерСтроки=НомерСтроки+Сдвиг-1;
					ТЗРез.Добавить(Новый Структура("Полное_описание_русский,поставщик,Артикул,ЦенаПрайс,Остаток,Срок,ПоставщикПрайс",
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки,СтрТаб.Наименование).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Производитель).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Артикул).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Цена).Value), Символы.НПП, ""),
					СтрЗаменить(СокрЛП(Лист.Cells(НомерСтроки, СтрТаб.Остаток).Value), Символы.НПП, ""),
					СтрТаб.Время,СтрТаб.Поставщик));
					НомерСтроки=НомерСтроки+1;
					Если НомерСтроки>ВсегоСтрок Тогда Прервать;КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Книга.Close();
		Исключение
			Сообщить("Ошибки при разборе данных прайс-листа:"+Символы.ПС+"Файл: "+СтрТаб.ПутьКфайлу+" лист: "+СтрТаб.Лист+символы.ПС+"Возможно ошибки в настройках или данных.");
			Попытка Книга.Close();Исключение;КонецПопытки;
		КонецПопытки;
	КонецЦикла;
	Эксель=Неопределено;
	ПоискПрайсНаСервере(ТЗРез, АртОриг);
КонецПроцедуры

&НаСервере
Процедура ПоискПрайсНаСервере(ТЗРез, АртОриг)
	
	КЧ = Новый КвалификаторыЧисла(10,2);
	КС = Новый КвалификаторыСтроки(500);
	ТипЧ = Новый ОписаниеТипов("Число", КЧ);
	ТипС = Новый ОписаниеТипов("Строка", КС);
	ТипСпр = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	
	//Результирующая таблица
	ТЗПрайс = Новый ТаблицаЗначений();	
	ТЗПрайс.Колонки.Добавить("Полное_название_группы", ТипС);
	ТЗПрайс.Колонки.Добавить("Место_установки", ТипС);
	ТЗПрайс.Колонки.Добавить("Входит_в", ТипС);
	ТЗПрайс.Колонки.Добавить("поставщик", ТипС);
	ТЗПрайс.Колонки.Добавить("Артикул", ТипС);
	ТЗПрайс.Колонки.Добавить("ПоставщикЗапчасти", ТипЧ);
	ТЗПрайс.Колонки.Добавить("ART_ID", ТипЧ);
	ТЗПрайс.Колонки.Добавить("МОДЕЛЬ", ТипС);
	ТЗПрайс.Колонки.Добавить("Полное_описание_русский", ТипС);
	ТЗПрайс.Колонки.Добавить("ТипНомера", ТипС);
	ТЗПрайс.Колонки.Добавить("тип", ТипС);
	ТЗПрайс.Колонки.Добавить("номер", ТипС);
	ТЗПрайс.Колонки.Добавить("ПоставщикПрайс", ТипСпр);
	ТЗПрайс.Колонки.Добавить("Остаток", ТипС);
	ТЗПрайс.Колонки.Добавить("ЦенаПрайс", ТипЧ);
	ТЗПрайс.Колонки.Добавить("Срок", ТипЧ);
	ТЗПрайс.Колонки.Добавить("НашАрт", ТипЧ);
	ТЗПрайс.Колонки.Добавить("Источник",ТипЧ);
	ТЗПрайс.Колонки.Добавить("Номенклатура");
	Для Каждого Стр Из ТЗРез Цикл
		Нов=ТЗПрайс.Добавить();
		ЗаполнитьЗначенияСвойств(Нов,Стр);
	КонецЦикла;
	Обработка=РеквизитФормыВЗначение("Объект");
	ТЗПрайс.Сортировать("поставщик");
	ТекПроизводитель="";
	ТекНоменклатура=Справочники.Номенклатура.ПустаяСсылка();
	ТекИсточник=0;
	Если Объект.ПоискПоОчищенному И Объект.ОчищеннаяТаблица.Количество() = 0 Тогда
		Таб = Обработка.ПолучитьТаблицуНоменклатуры();
		Для Каждого Эл Из Таб Цикл
			Стр = Объект.ОчищеннаяТаблица.Добавить();
			Стр.Артикул = ВРЕГ(ПодготовитьНомер(СокрЛП(Эл.Артикул)));
			Стр.Производитель= ВРЕГ(ПодготовитьНомер(СокрЛП(Эл.Производитель)));
		    Стр.Номенклатура = Эл.Ссылка;
		КонецЦикла;
	КонецЕсли;
	Для каждого Стр Из ТЗПрайс Цикл
		Если Стр.поставщик<>ТекПроизводитель Тогда
			ТекПроизводитель=Стр.поставщик;
			Если Объект.ПоискПоОчищенному И Объект.ОчищеннаяТаблица.Количество() > 0 Тогда
				Рез=Объект.ОчищеннаяТаблица.НайтиСтроки(Новый Структура("Артикул,Производитель",АртОриг,ТекПроизводитель));
				Если Рез.Количество()=0 Тогда
					ТекИсточник=0;
					ТекНоменклатура=Справочники.Номенклатура.ПустаяСсылка();
				Иначе
					ТекИсточник=1;
					ТекНоменклатура=Рез[0].Номенклатура;
				КонецЕсли;
			Иначе
				Рез=Обработка.ПолучитьНоменклатуруТовара(Новый Структура("Артикул,Производитель",АртОриг,ТекПроизводитель),Ложь);
				Если Рез=Неопределено Тогда
					ТекИсточник=0;
					ТекНоменклатура=Справочники.Номенклатура.ПустаяСсылка();
				Иначе
					ТекИсточник=1;
					ТекНоменклатура=Рез;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Стр.Номенклатура=ТекНоменклатура;
		Стр.Источник=ТекИсточник;
	КонецЦикла;
	РезультатПоискаПрайс.Загрузить(ТЗПрайс);
	КолСтр=Обработка.ВыводРезультатаПоискаПрайс(ТЗПрайс,РезультатПрайс);
	Элементы.СтраницаПоискПоПрайсу.Заголовок="Поиск по артикулу (прайс-листы) ("+Строка(КолСтр)+")";
КонецПроцедуры

&НаСервере
Функция ПолучитьНоменклатуруТовараНаСервере(Запись,Создать=Истина);
	Обработка=РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьНоменклатуруТовара(Запись,Создать);
КонецФункции

&НаСервере
Процедура ЗаписатьгруппуНоменклатуры(Группа,Номенклатура)
	Об = Номенклатура.ПолучитьОбъект();
	Об.Родитель = Группа;
	Об.Записать();
КонецПроцедуры
	
&НаКлиенте
Процедура ВходВгруппуПрайс(Результат,Отбор) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗаписатьгруппуНоменклатуры(Результат,Отбор.Номенклатура);
	КонецЕсли;
	Номенклатура = Отбор.Номенклатура;
	Расшифровка = Отбор.Расшифровка;
	ПроверкаОтбор = Новый Структура("Номенклатура, Поставщик, Склад", Номенклатура, Расшифровка.Поставщик, Объект.ФильтрСкладПрайс);
	ПроверкаСуществования = Объект.ЗаявкаПоставщику.НайтиСтроки(ПроверкаОтбор);
	Остаток=Число(Расшифровка.Остаток)-?(ПроверкаСуществования.Количество()=0,0,ПроверкаСуществования[0].Количество);
	Если Остаток<=0 И Объект.КонтрольОстатков Тогда
		ТекстОшибки="Для оформления заказа с нулевыми остатками требуется в настройках убрать признак контроля остатков";
		Попытка
			Предупреждение(ТекстОшибки);
		Исключение
			Сообщить(ТекстОшибки);
		Конецпопытки;
		Возврат;
	КонецЕсли;
	Если Объект.ЗапрашиватьКоличество ИЛИ ((Объект.ЗапрашиватьЦену ИЛИ Объект.ЗапрашиватьСкидку) И Объект.ВКорзину) Тогда
		ПередачаПараметров = Новый Структура(
		"Номенклатура,Склад,Остаток,ЦенаПоУмолчанию,КонтрольОстатков,ЗапрашиватьКолво,ЗапрашиватьЦену,ЗапрашиватьСкидку",
		Номенклатура,Объект.ФильтрСкладПрайс,Остаток,Расшифровка.Цена,Объект.КонтрольОстатков,
		Объект.ЗапрашиватьКоличество, Объект.ВКорзину И Объект.ЗапрашиватьЦену, Объект.ВКорзину И Объект.ЗапрашиватьСкидку);
		Оповещение=Новый ОписаниеОповещения("ОбработкаРасшифровкиПрайсНаСервере",ЭтаФорма,Расшифровка);
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПередачаПараметров,ЭтаФорма,Истина,,,Оповещение)
	Иначе
		Данные=Новый Структура("Номенклатура,Склад,Количество,Цена,Скидка",
		Номенклатура,Объект.ФильтрСкладПрайс,1,Расшифровка.Цена,0);
		ОбработкаРасшифровкиПрайсНаСервере(Данные,Расшифровка)
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаРасшифровкиПрайсНаСервере(Данные, Расшифровка) Экспорт
	//Отказ при выборе количества
	Если Данные=Неопределено Тогда Возврат; КонецЕсли;
	
	Если Объект.ВКорзину Тогда
		Данные.Вставить("Поставщик",Расшифровка.Поставщик);
		Данные.Вставить("ЦенаПоставки",Расшифровка.ЦенаПоставщика);
		Данные.Вставить("СрокДоставки",Расшифровка.Срок);
		ДобавитьВЗаявкуНаСервере(Данные,Неопределено);
		Возврат;
	КонецЕсли;
	
	Попытка
	
		ПроверкаОтбор = Новый Структура("Номенклатура, Поставщик, Склад", Данные.Номенклатура, Расшифровка.Поставщик, Данные.Склад);
		ПроверкаСуществованияЗаказ = Объект.ЗаявкаПоставщику.НайтиСтроки(ПроверкаОтбор);
		
		Если ПроверкаСуществованияЗаказ.Количество()=0 Тогда
			НоваяСтрока=Объект.ЗаявкаПоставщику.Добавить();
			НоваяСтрока.Номенклатура = Данные.Номенклатура;
			НоваяСтрока.Артикул = Данные.Номенклатура.Артикул;
			НоваяСтрока.Поставщик = Расшифровка.Поставщик;
			НоваяСтрока.Склад = Данные.Склад;
			НоваяСтрока.Количество = Данные.Количество;
		Иначе
			НоваяСтрока=ПроверкаСуществованияЗаказ[0];
			НоваяСтрока.Количество = НоваяСтрока.Количество+Данные.Количество;
		КонецЕсли;
		
		НоваяСтрока.Цена = Расшифровка.ЦенаПоставщика;
		НоваяСтрока.Скидка=0;
		НоваяСтрока.СтавкаНдс = Данные.Номенклатура.СтавкаНДС;
		НоваяСтрока.Срок = Расшифровка.Срок;
		НоваяСтрока.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		Обработка=РеквизитФормыВЗначение("Объект");
		Обработка.РассчитатьСуммы(НоваяСтрока);
		
		КолСтр=Объект.ЗаявкаПоставщику.Количество();
		Элементы.Группа10.Заголовок="Заказы поставщику ("+Строка(КолСтр)+")";
			
	Исключение
	    Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры

//#КонецОбласти

//#Область ПоискОнлайн
// ***** Поиск онлайн
&НаСервере
Процедура ПоискПроценки()
	СтрокаОриг = Объект.НомерАртикула;
	СтрокаПоиска = Врег(ПодготовитьНомер(СтрокаОриг));
	Обработка=РеквизитФормыВЗначение("Объект");
	Если Объект.ВыборочныйПоиск Тогда
		ТЗЕмекс=Обработка.ПоискПроценкиТовары(СтрокаОриг);
		КолЕмекс=Обработка.ВыводРезультатаПоискаТоваровЕмекс(ТЗЕмекс,РезультатЕмекс);
	Иначе
		ТЗЕмекс=Обработка.ПоискПроценки(СтрокаОриг,Объект.ЕмексИскатьСЗаменамиИАналогами,Парсинг);
				
		РезультатПоискаЕмекс.Очистить();
		РезультатПоискаЕмекс.Загрузить(ТЗЕмекс);
		ОтборПараметры=Новый	Структура("Склад,ЕстьНаСкладе,ЕстьУПоставщика",Объект.ФильтрСкладЕмекс,ЕстьНаСкладе,ЕстьУПоставщика);
		КолЕмекс=Обработка.ВыводРезультатаПоискаЕмекс(ТЗЕмекс,РезультатЕмекс,ОтборПараметры);
	КонецЕсли;
	ТабПро=ТЗЕмекс.Скопировать(,"Производитель");
	ТабПро.Свернуть("Производитель");ТабПро.Сортировать("Производитель");
	Элементы.ФильтрМаркаЕмекс.СписокВыбора.ЗагрузитьЗначения(ТабПро.ВыгрузитьКолонку("Производитель"));
	Если ЗначениеЗаполнено(КолЕмекс) И КолЕмекс > 0 Тогда
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики) (" + КолЕмекс + ")";
	Иначе
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики)";
	КонецЕСли;

Конецпроцедуры

&НаКлиенте
Процедура ВходВгруппуЕмексДобавить(Результат,НоменклатураСсылка) Экспорт
	
	ВходВгруппуЕмексСерверДобавить(Результат,НоменклатураСсылка);
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",Новый Структура("Ключ",НоменклатураСсылка),НоменклатураСсылка);	
КонецПроцедуры

&НаКлиенте
Процедура ВходВгруппуЕмекс(Результат,Запись) Экспорт
	
	ВходВгруппуЕмексСервер(Результат,Запись);
	
	НоменклатураСсылка = Запись.Номенклатура;
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта",Новый Структура("Ключ",НоменклатураСсылка),НоменклатураСсылка);
	Отбор = Новый Структура("Номенклатура, idСклад, Сайт", Запись.Номенклатура, Запись.idСклад, Запись.Сайт);
	ПроверкаСуществованияКорзина = Объект.ЗаявкаНаОформление.НайтиСтроки(Отбор);
	Если ПроверкаСуществованияКорзина.Количество()=0 Тогда
		ЗаписьВКорзине=Неопределено;
		МожноВКорзину=Запись.Наличие;
	Иначе
		ЗаписьВКорзине=ПроверкаСуществованияКорзина[0];
		МожноВКорзину=Запись.Наличие-ЗаписьВКорзине.Количество;
		Если МожноВКорзину<=0 И Объект.КонтрольОстатков Тогда
			Попытка
				Предупреждение("В корзине уже находится "+Строка(ЗаписьВКорзине.Количество)+" единиц на товара.");
			Исключение
				Сообщить("В корзине уже находится "+Строка(ЗаписьВКорзине.Количество)+" единиц на товара.");
			Конецпопытки;
			Возврат;
		КонецЕсли;
	КонецЕсли;
			
	Если Объект.ЗапрашиватьКоличество или Объект.ЗапрашиватьЦену или Объект.ЗапрашиватьСкидку Тогда
		ПараметрыФормы=Новый Структура("Номенклатура,Склад,Остаток,ЦенаПоУмолчанию,КонтрольОстатков,ЗапрашиватьКолво,ЗапрашиватьЦену,ЗапрашиватьСкидку",
		НоменклатураСсылка,Объект.ФильтрСкладЕмекс,МожноВКорзину,Запись.Цена,Объект.КонтрольОстатков,Объект.ЗапрашиватьКоличество,Объект.ЗапрашиватьЦену,Объект.ЗапрашиватьСкидку);
		Оповещение=Новый ОписаниеОповещения("ДобавитьВЗаявкуНаСервере",ЭтаФорма,Запись);
		ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ВыборКоличестваУФ",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение);
	Иначе
		Данные=Новый Структура("Номенклатура,Склад,Количество,Цена,Скидка",
		НоменклатураСсылка,Объект.ФильтрСкладЕмекс,1,Запись.Цена,0);
		ДобавитьВЗаявкуНаСервере(Данные,Запись);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВходВгруппуЕмексСервер(Результат,Запись) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		Об = Запись.Номенклатура.ПолучитьОбъект();
		Об.Родитель = Результат;
		Об.Записать();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВходВгруппуЕмексСерверДобавить(Результат,Запись) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		Об = Запись.ПолучитьОбъект();
		Об.Родитель = Результат;
		Об.Записать();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ДобавлениеТовараВБазуЕмекс(Запись, ТипНомера = Неопределено) Экспорт
	ЭтоОбъект=РеквизитФормыВЗначение("Объект");
	Номенклатура=ЭтоОбъект.ПолучитьНоменклатуруТовара(Запись, Истина, ТипНомера);
	
	Если Номенклатура<>Неопределено Тогда
		СтрокаВрем = РезультатПоискаЕмекс.Добавить();
		СтрокаВрем.Группа = Запись.Группа;
		СтрокаВрем.Тип = Запись.Тип;
		СтрокаВрем.Производитель = Запись.Производитель;
		СтрокаВрем.Артикул = Запись.Артикул;
		СтрокаВрем.Наименование = Номенклатура.Наименование;
		СтрокаВрем.Номенклатура = Номенклатура;
		РезультатПоискаЕмекс.Сортировать("Тип Возр, Производитель Возр, Группа Возр, Артикул Возр, Цена Возр");
	КонецЕсли;	
	Возврат Номенклатура;
		        	
КонецФункции

&НаСервере
Процедура ПоискЦенТоваровСервер(Данные,Арт,Аналоги)
	ЭтоОбъект=РеквизитФормыВЗначение("Объект");
	Дан = Данные;
	Таб=ЭтоОбъект.ПоискЦенПроценки(Дан,Арт,Аналоги);
	ТабПро=Таб.Скопировать(,"Производитель");
	ТабПро.Свернуть("Производитель");ТабПро.Сортировать("Производитель");
	Элементы.ФильтрМаркаЕмекс.СписокВыбора.ЗагрузитьЗначения(ТабПро.ВыгрузитьКолонку("Производитель"));
	ОтборПараметры=Новый Структура("Склад,ЕстьНаСкладе,ЕстьУПоставщика",Объект.ФильтрСкладЕмекс,ЕстьНаСкладе,ЕстьУПоставщика);
	КолЕмекс=ЭтоОбъект.ВыводРезультатаПоискаЕмекс(Таб,РезультатЕмекс,ОтборПараметры);
	Если ЗначениеЗаполнено(КолЕмекс) И КолЕмекс > 0 Тогда
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики) (" + КолЕмекс + ")";
	Иначе
		Элементы.ПоискЕмекс.Заголовок = "Поиск по артикулу (онлайн поставщики)";
	КонецЕСли;
КонецПроцедуры

//#КонецОбласти

//#Область Корзина

&НаСервере
Функция Корзина_Подбор_ПолучитьВалюту()
	Если Метаданные.Обработки.Найти("ПодборТоваровВДокументПродажи")=Неопределено
		Тогда Возврат Неопределено;
	Иначе
		Возврат Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
КонецФункции

&Наклиенте
Функция Корзина_Подбор()
	Перем Валюта,ФрмВр,Эл,Стр;
	Попытка
		Валюта=Корзина_Подбор_ПолучитьВалюту();
		Если Валюта=Неопределено Тогда
			Возврат "Данная конфигурация не поддерживает функцию подбора";
		КонецЕсли;
		Если не ЗначениеЗаполнено(Объект.Соглашение)тогда
			Возврат "Не заполнено соглашение с контрагентом";
		КонецЕсли;
		ФрмВр=ПолучитьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта",,Элементы.ЗаявкаНаОформление);
		Для каждого Эл из Объект.ЗаявкаНаОформление Цикл
		     Стр=ФрмВр.Объект.Товары.Добавить();
			 ЗаполнитьЗначенияСвойств(Стр,Эл);
		 КонецЦикла;
		ПараметрЗаголовок = НСтр("ru = 'Подбор товаров в корзину");
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Соглашение", Объект.Соглашение);
		ПараметрыФормы.Вставить("ЦенаВключаетНДС", Истина);
		ПараметрыФормы.Вставить("Склад", Объект.Склад);
		ПараметрыФормы.Вставить("Валюта",Валюта);
		ПараметрыФормы.Вставить("Заголовок", ПараметрЗаголовок);
		ПараметрыФормы.Вставить("Дата", ТекущаяДата());
		ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти", Истина);
		ПараметрыФормы.Вставить("РежимПодбораИсключитьГруппыДоступныеВЗаказах", Истина);
		ПараметрыФормы.Вставить("СкрыватьПодакцизныеТовары", Ложь);
		ПараметрыФормы.Вставить("ОтображатьФлагСкрыватьПодакцизныеТовары", Ложь);
		ПараметрыФормы.Вставить("Документ", ФрмВр.Объект.Ссылка);
		ПараметрыФормы.Вставить("Заголовок", ПараметрЗаголовок);
		Оповещение=Новый ОписаниеОповещения("Корзина_Подбор_УТ11_ЗаявкаНаОформлениеОбработкаВыбора",ЭтаФорма);
		
		ОткрытьФорму("Обработка.ПодборТоваровВДокументПродажи.Форма",ПараметрыФормы,ЭтаФорма,Истина,,,Оповещение);
	Исключение
		Возврат "Ошибки при вызове подбора номенклатуры. "+Символы.ПС+ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

&НаСервере
Процедура Корзина_Подбор_УТ11_ЗаполнитьСтрокиДополнительно(Спис)
	Для каждого Эл из Спис Цикл
		ТекСтр=Объект.ЗаявкаНаОформление.НайтиПоИдентификатору(Эл);
		ТекСтр.Наименование=ТекСтр.Номенклатура;
		ТекСтр.Артикул=ТекСтр.Номенклатура.Артикул;
		ТекСтр.СтавкаНДС=ТекСтр.Номенклатура.СтавкаНДС;
		ТекСтр.СуммаСоСкидкой=ТекСтр.Сумма;
		ТекСтр.Всего=ТекСтр.Сумма;
		ТекСтр.СуммаНДС=0;
		Если ТекСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ ТекСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
			ТекСтр.СуммаНДС = Окр(ТекСтр.Сумма*(1-(1/1.10)),2);
		ИначеЕсли ТекСтр.СтавкаНДС = Перечисления.СтавкиНДС.НДС18 ИЛИ ТекСтр.СтавкаНДС= Перечисления.СтавкиНДС.НДС18_118 Тогда
			ТекСтр.СуммаНДС = Окр(ТекСтр.Сумма*(1-(1/1.18)),2);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Корзина_Подбор_УТ11_ЗаявкаНаОформлениеОбработкаВыбора(ВыбранноеЗначение,Источник) Экспорт
		ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
        СписСтрок=Новый Массив; 
		Для каждого Эл из ТаблицаТоваров Цикл
			 Стр=Объект.ЗаявкаНаОформление.Добавить();
			 ЗаполнитьЗначенияСвойств(Стр,Эл);
			 СписСтрок.Добавить(Стр.ПолучитьИдентификатор());
		 КонецЦикла;
		 Корзина_Подбор_УТ11_ЗаполнитьСтрокиДополнительно(СписСтрок);
		 СуммаКорзины=Объект.ЗаявкаНаОформление.Итог("Всего");
КонецПроцедуры

