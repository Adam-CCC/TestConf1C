&НаКлиенте
Процедура АвтодилерТест(Команда)
	ПолучитьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.АвтоДилер_ПоискПоАвтомобилю",,ЭтаФорма).Открыть();
КонецПроцедуры
	
&НаКлиенте
Процедура НайтиАртикул(Команда)
	
	Попытка
		Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоВИН Тогда
			ПоискПоВИН(); Возврат;
		КонецЕсли;
		СписокГрупп = "";
		Если ЭтаФорма.Элементы.Страницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПоискПоАртикулу или Объект.ОбщийПоискВрем Тогда
			//Заполнение таблицы выбора групп
			Если  Объект.ВыбиратьГруппу Тогда
				Группы=ЗаполнитьТаблицуГрупп();
				Если Группы.Количество()>1 Тогда
					Оповещение=Новый ОписаниеОповещения("ПоискПоАртикулу",ЭтаФорма);
					ОткрытьФорму(Объект.ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаВыбораГруппыУФ",Новый Структура("Группы",Группы),ЭтаФорма,Истина,,,Оповещение);
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ПоискПоАртикулу(СписокГрупп);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
		
КонецПроцедуры

