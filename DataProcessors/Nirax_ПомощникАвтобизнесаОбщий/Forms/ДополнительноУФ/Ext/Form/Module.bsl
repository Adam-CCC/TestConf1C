// Форма имеет 2 назначения:
// 1. предназначена для отображения дополнительных методов работы с сайтом
// и в случае выбора метода - отображением параметров метода для ввода их значений.
// Выборка методов производится из настроек Проценки в зависимости от страницы,
// на которой находится:
//   Для "Поставщикам" (Заявки поставщикам):
// 	  По методам всех отмеченных проценкок (Вкл=Истина) и проценке текущей заявки
//    Внутри по: для всех: Объект="Проценка", для текущей по "Состояние" текущей.
//  Параметры:
//    Страница - имя страницы (таблицы) где будет выполняться команда - обязателен
//    Сайт - имя проценки, для которой выполняются методы, если не указано - для всех.
//    Состояние - (для поставщикам) - состояние текущей строки
// Возвращает - структуру с данными выбранного метода или неопределено - если выбор не сделан
//
// 2. предназначена для отображения параметров по условиям отбора
//  Параметры:
//    Отбор - структура содержащий критерий отбора для каждой строки таблицы параметров
//    Сайт - если указано значение - отбор только по указанному сайту, иначе по всем включеным
//
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//Загружаем информацию по проценкам
	НастройкиПользователя=Параметры.НастройкиПользователя;
	ЕСли НастройкиПользователя Тогда
		Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки");
	Иначе
		Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,"Администратор");
	КонецЕсли;
	Если ТипЗнч(Проценки)<>Тип("ТаблицаЗначений") Тогда Отказ=Истина;Возврат;КонецЕсли;
	Сайты.Загрузить(Проценки);
	ЭтоМетоды=ТипЗнч(Параметры.Отбор)<> Тип("Структура");
	Если ЭтоМетоды ТОгда
		// Методы
		ЭтаФорма.Заголовок="Выберите требуемый метод и нажмите Выполнить";
		Элементы.Фильтры.Видимость=Ложь;
		Если Параметры.Страница="" Тогда Отказ=Истина;Возврат;КонецЕсли;
		Страница=Параметры.Страница;
		ТекСайт=Параметры.Сайт;
		Если ПустаяСтрока(ТекСайт) Тогда ТекСайт=Неопределено;КонецЕсли;
		Состояние=Параметры.Состояние;
		Отбор=Новый Структура("Вкл",Истина);
		Массив=Проценки.НайтиСтроки(Отбор);
		Если ТекСайт<>Неопределено Тогда
			// Если текущая строка не проценка - считаем, что текущая строка неопределена
			СтрПроценка=Проценки.Найти(ТекСайт,"Сайт");
			Если СтрПроценка=Неопределено Тогда 
				ТекСайт=Неопределено;
			Иначе
				Если СтрПроценка.Вкл Тогда
					Массив.Удалить(Массив.Найти(СтрПроценка));;
				КонецЕсли;
				Массив.Вставить(0,СтрПроценка);
			КонецЕсли
		КонецЕсли;
		// Выбираем методы для каждой строки из массива
		Для Каждого Стр Из Массив Цикл
			Если Стр.Методы=Неопределено Тогда Продолжить;КонецЕсли;
			Для Каждого Метод из Стр.Методы Цикл
				МетодЗ=Метод.Значение;
				Если Не МетодЗ.Вкл или МетодЗ.Страница<>Страница Тогда Продолжить;КонецЕсли;
				Если МетодЗ.Объект<>"Сайт" Тогда
					Если ТекСайт<>Стр.Сайт Тогда Продолжить;КонецЕсли;
					ЕСли МетодЗ.Состояние<>Состояние Тогда Продолжить;КонецЕсли;
				КонецЕсли;
				// Заполнение таблицы "Методы"
				Нов=Методы.Добавить();
				Нов.Сайт=Стр.Сайт;
				Нов.Метод=Метод.Ключ;
				ЗаполнитьЗначенияСвойств(Нов,МетодЗ);

			КонецЦикла;
		КонецЦикла;
	Иначе
		Элементы.Методы.Видимость=Ложь;
		ЭтаФорма.Заголовок="Определите требуемые данные";
	КонецЕсли;
	ВнешняяОбработка=?(Метаданные.Обработки.Найти("Nirax_ПомощникАвтобизнесаОбщий")=Неопределено,"ВнешняяОбработка","Обработка");
	РежимМодальности=Метаданные.РежимИспользованияМодальности=Метаданные.СвойстваОбъектов.РежимИспользованияМодальности.Использовать;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ЭтоМетоды И Методы.Количество()=0 Тогда
		Текст="Дополнительные методы для используемых данных не подключены или не реализованы, обращайтесь к разработчику";
		Если РежимМодальности Тогда
			Предупреждение(Текст);
		Иначе
			Сообщить(Текст);
		КонецЕсли;
		Отказ=Истина;
	КонецЕсли;
	#Если ВебКлиент Тогда
		РежимМодальности=Ложь;
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьМетод(Команда)
	ТекДан=Элементы.Методы.ТекущиеДанные;
	Если ТекДан=Неопределено Тогда Возврат;КонецЕсли;
	// Производи анализ наличия параметров для ввода данных
	МСайт=Сайты.НайтиСтроки(Новый Структура("Сайт",ТекДан.Сайт));
	Фильтры.Очистить();
	Если МСайт.Количество()>0 Тогда
		ТСайт=МСайт[0];
		Если ТипЗнч(ТСайт.Фильтры)=Тип("Структура") Тогда
			Для Каждого Эл Из ТСайт.Фильтры Цикл;
				Если Эл.Значение.Владелец=ТекДан.Метод И Эл.Значение.Оперативный Тогда
					Нов=Фильтры.Добавить();
					ЗаполнитьЗначенияСвойств(Нов,Эл.Значение);
					Нов.Параметр=Эл.Ключ;
					Нов.Сайт=ТекДан.Сайт;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Фильтры.Количество()=0 Тогда
			Сайт=МСайт[0];
			Если Не ПустаяСтрока(ТекДан.Предупреждение) Тогда
				ЕСли РежимМодальности Тогда
					Ответ=Вопрос("Внимание!!!"+Символы.ПС+ТекДан.Предупреждение+Символы.ПС+"Продолжить?",РежимДиалогаВопрос.ДаНетОтмена);
					Если Ответ=КодВозвратаДиалога.Отмена Тогда Возврат;КонецЕсли;
					Если Ответ=КодВозвратаДиалога.Нет Тогда ЭтаФорма.Закрыть();Возврат;КонецЕсли;
				Иначе
					Оповещение=Новый ОписаниеОповещения("ЗавершитьВопрос",ЭтаФорма,Новый Структура("Сайт,Метод,Наименование,Страница,Объект,Состояние,НаКлиенте,Вкл,Поставщик,Авторизация,Фильтры",
					ТекДан.Сайт,ТекДан.Метод,ТекДан.Наименование,ТекДан.Страница,ТекДан.Объект,ТекДан.Состояние,ТекДан.НаКлиенте,
					Сайт.Вкл,Сайт.Поставщик,Сайт.Авторизация,Сайт.Фильтры));
					ПоказатьВопрос(Оповещение,"Внимание!!!"+Символы.ПС+ТекДан.Предупреждение+Символы.ПС+"Продолжить?",РежимДиалогаВопрос.ДаНетОтмена);
					Возврат;
				КонецЕсли;
			КонецЕсли;
			ЭтаФорма.Закрыть(Новый Структура("Сайт,Метод,Наименование,Страница,Объект,Состояние,НаКлиенте,Вкл,Поставщик,Авторизация,Фильтры",
			ТекДан.Сайт,ТекДан.Метод,ТекДан.Наименование,ТекДан.Страница,ТекДан.Объект,ТекДан.Состояние,ТекДан.НаКлиенте,
			Сайт.Вкл,Сайт.Поставщик,Сайт.Авторизация,Сайт.Фильтры));
		Иначе
			ЭтаФорма.Заголовок="Определите данные для выполенеия метода";
			ВыбСтр=Элементы.Методы.ТекущаяСтрока;
			Элементы.Методы.Видимость=Ложь;
			Элементы.Фильтры.Видимость=Истина;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВопрос(Ответ,Данные)
	Если Ответ=КодВозвратаДиалога.Да Тогда 
		ЭтаФорма.Закрыть(Данные);
	ИначеЕсли Ответ=КодВозвратаДиалога.Нет Тогда 
		ЭтаФорма.Закрыть();
	КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура СохранитьЗначения(Команда)
	ТСайт="";
	СтрЗнач="";
	Для Каждого Стр Из Фильтры Цикл
		Если Стр.Сайт<>ТСайт Тогда
			МСайт=Сайты.НайтиСтроки(Новый Структура("Сайт",Стр.Сайт));
			СтрСайт=МСайт[0];
			ТСайт=Стр.Сайт;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрСайт.Фильтры[Стр.Параметр],Стр);
	КонецЦикла;
	СохранитьЗначенияНаСервере();
	ЕСли ЭтоМетоды Тогда
		ТекДан=Методы.НайтиПоИдентификатору(ВыбСтр);
		Сайт=Сайты.Найти(ТекДан.Сайт,"Сайт");
		ЭтаФорма.Закрыть(Новый Структура("Сайт,Метод,Наименование,Страница,Объект,Состояние,НаКлиенте,Вкл,Поставщик,Авторизация,Фильтры",
		ТекДан.Сайт,ТекДан.Метод,ТекДан.Наименование,ТекДан.Страница,ТекДан.Объект,ТекДан.Состояние,ТекДан.НаКлиенте,
		Сайт.Вкл,Сайт.Поставщик,Сайт.Авторизация,Сайт.Фильтры));
	Иначе
		ЭтаФорма.Закрыть(Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СохранитьЗначенияНаСервере()
		ЕСли НастройкиПользователя Тогда
			ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Проценки",Сайты.Выгрузить());
		Иначе
			ХранилищеОбщихНастроек.Сохранить("ПомощникАвтобизнеса","Проценки",Сайты.Выгрузить(),,"Администратор");
		КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФильтрыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	Тек=Элементы.Фильтры.ТекущиеДанные;
	ПараметрыФормы=Новый Структура("СписокЗначений,ФормаВыбора,Групповой,ТекущееЗначение",Тек.СписокВыбора,Истина,Тек.Групповой,Тек.Значение);
	Оповещение=Новый ОписаниеОповещения("ФильтрыЗначениеЗапись",ЭтаФорма,Новый Структура("ТекСтр",Элементы.Фильтры.ТекущаяСтрока));
	ОткрытьФорму(ВнешняяОбработка+".Nirax_ПомощникАвтобизнесаОбщий.Форма.ФормаСпискаУФ",ПараметрыФормы,ЭтаФорма,Элементы.Фильтры.ТекущиеДанные.Параметр,ВариантОткрытияОкна.ОтдельноеОкно,,Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ФильтрыЗначениеЗапись(Рез,Доп) Экспорт
	Если Рез=Неопределено Тогда Возврат;КонецЕсли;
	Стр=Фильтры.НайтиПоИдентификатору(Доп.ТекСтр);
	Стр.Значение=Рез;
Конецпроцедуры

