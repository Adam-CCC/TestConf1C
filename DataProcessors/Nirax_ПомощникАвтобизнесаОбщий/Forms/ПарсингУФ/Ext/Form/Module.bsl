///////Разбор результатов поиска
&НаКлиенте
Функция РазобратьРезультатыПоискаФорумАвто() Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Кроссы");
	ТЗ.Колонки.Добавить("Артикул");
	ТЗ.Колонки.Добавить("Производитель");
	ТЗ.Колонки.Добавить("Наименование");
	ТЗ.Колонки.Добавить("Кратность");
	ТЗ.Колонки.Добавить("ЦенаПоставки");
	ТЗ.Колонки.Добавить("Цена");
	ТЗ.Колонки.Добавить("Наличие");
	ТЗ.Колонки.Добавить("Корзина");
	
	Попытка
	  ТаблицаРезультатов = ПолучитьТаблицуРезультатовПоискаФорумАвто();
	  Для каждого СтрокаТабРез Из ТаблицаРезультатов.rows Цикл
		  Если (СтрокаТабРез.classname <> "header") И (СтрокаТабРез.className <> "tr_hr") Тогда //не шапка таблицы и не разделительная линия
				Строка = ТЗ.Добавить();
				Для каждого опСтр Из СтрокаТабРез.children Цикл
					Если опСтр.className = "td2" Тогда
                          Строка.Артикул = опСтр.innerText;
					  КонецЕсли;
					  Если опСтр.className = "td3" Тогда
                          Строка.Производитель = опСтр.innerText;
					  КонецЕсли;
					  Если опСтр.className = "td4" Тогда
                          Строка.Наименование = опСтр.innerText;
					  КонецЕсли;
					  Если опСтр.className = "td6" Тогда
                          Строка.цена = СтрЗаменить(опСтр.innerText," ","");//опСтр.innerText;
						  Строка.ЦенаПоставки = СтрЗаменить(опСтр.innerText," ","");//опСтр.innerText;
					  КонецЕсли;
					  Если опСтр.className = "td7" Тогда
						  //ост = опСтр.innerTex;
						  Поиск = найти(опСтр.innerText,"*");
						  Если Поиск >0 Тогда
							  Строка.Наличие = 999999;
							  Строка.Кратность = НайтиКратность(опСтр.innerText);
							  
							  Иначе
                          Строка.Наличие = опСтр.innerText;
						   КонецЕсли
					  КонецЕсли;

					  КонецЦикла;
				
			КонецЕсли;        
		КонецЦикла;
	Исключение
	  //СообщитьОбОшибкеПарсингаСтраницы(ИнформацияОбОшибке(), ЭлементыФормы.Браузер.Документ);
	КонецПопытки;
	Возврат ТЗ;	
КонецФункции // РазобратьРезультатыПоиска()

