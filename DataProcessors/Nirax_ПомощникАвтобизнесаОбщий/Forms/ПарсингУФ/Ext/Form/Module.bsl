Процедура ДобавитьВКорзинуШатеМ(Строка)
	
					
					СтрокаТабРез = ПолучитьТаблицуРезультатовПоискаШатеМ();
					i = Число(Строка.ДляКорзины);//Строка.ДляКорзины;
					ПолеКоличество = СтрокаТабРез.cells.item(i).firstChild;
					//СтрокаТабРез.cells.item(i).firstChild.lastChild.firstChild.value = Строка.Количество;
					ПолеКоличество = ПолеКоличество.firstChild;
					Если ПолеКоличество.className = "spinner-quantity" Тогда
					ПолеКоличество.value = Строка.Количество;
				Иначе
					ПолеКоличество.firstChild.value = Строка.Количество;
				КонецЕсли;
				
					//ПолеКоличество.onclick();
					КнопкаКорзины = СтрокаТабРез.cells.item(i).firstChild;
					КнопкаКорзины = КнопкаКорзины.lastChild;
					Если КнопкаКорзины.nodeName = "#text" тогда 
					КнопкаКорзины = КнопкаКорзины.previousSibling;
				иначе
					КнопкаКорзины = КнопкаКорзины.lastChild.previousSibling;
					КонецЕсли;
					КнопкаКорзины.onclick(); 
	Этаформа.Активизировать();
					
КонецПроцедуры

