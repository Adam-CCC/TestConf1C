&НаКлиенте
Функция АвторизацияШатеМ()Экспорт
	
	
	Если Не ПроверитьАвторизациюШатеМ() Тогда
		ЕСли Объект.СпецНаз.НастройкиПользователя Тогда
			Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки");
		Иначе
			Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,"Администратор");
		КонецЕсли;
		Для каждого сайт из Проценки Цикл
			Если Сайт.Сайт = "ШатеМ" Тогда
				Авт = Сайт.Авторизация;
			КонецЕсли;
		КонецЦикла;
		
	Попытка
			  Документ = БраузерСформирован.Документ;
				КоллекцияФормы = Документ.forms;
			  Для каждого ЭлементФорма Из КоллекцияФормы Цикл
					Если ЭлементФорма.action = "/Account/Login" Тогда //это форма авторизации
					  	ЭлементФорма.LoginUserName.Value = Авт.Логин;					
					  	ЭлементФорма.LoginPassword.Value = Авт.Пароль;
						ЭлементФорма.submit();
						
						//ПодключитьОбработчикОжидания("ОбработчикОжиданияАвторизацияНаСайте", 1);
						
						//ЭтотОбъект.ПолучитьФорму("ОсновнаяФорма").Активизировать();
					КонецЕсли; 
				КонецЦикла; 
			Исключение
			  //Сообщить(ИнформацияОбОшибке(), Документ);
			КонецПопытки;
КонецЕсли;	
	
