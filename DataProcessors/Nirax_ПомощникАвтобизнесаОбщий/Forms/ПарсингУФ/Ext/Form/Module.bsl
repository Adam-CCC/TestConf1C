&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.Страница1.Видимость = Ложь;
	Элементы.Страница2.Видимость = Ложь;
	Элементы.Страница3.Видимость = Ложь;
	Элементы.Страница4.Видимость = Ложь;
	Элементы.Страница5.Видимость = Ложь;
	Элементы.Страница6.Видимость = Ложь;
	ВладелецОбъект = ЭтаФорма.ВладелецФормы.Объект;
	ЗаполнитьЗначенияСвойств(Объект,ВладелецОбъект,"СпецНаз");
	//"ЗаявкаНаОформление,ЗаявкаПоставщику");

		ЕСли Объект.СпецНаз.НастройкиПользователя Тогда
			Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки");
		Иначе
			Проценки = ХранилищеОбщихНастроек.Загрузить("ПомощникАвтобизнеса","Проценки",,"Администратор");
		КонецЕсли;
		Для каждого сайт из Проценки Цикл
			Если Сайт.вкл Тогда
				//Для Каждого Авторизация Из Сайт Цикл
					Авт = Сайт.Авторизация;
					Если авт.Свойство("Парсинг") = Истина Тогда
						Если ЗначениеЗаполнено(Авт.парсинг) тогда
							Если Элементы.Страница1.Заголовок = "Страница1" Тогда 
							
								Элементы.Страница1.Видимость = Истина;
								Элементы.Браузер1.Документ.URL = Авт.Парсинг;
								Элементы.Страница1.Заголовок = Сайт.Сайт;
							ИначеЕсли Элементы.Страница2.Заголовок = "Страница2" Тогда 
									
										Элементы.Страница2.Видимость = Истина;
										Элементы.Браузер2.Документ.URL = Авт.Парсинг;
										Элементы.Страница2.Заголовок = Сайт.Сайт;
										ИначеЕсли Элементы.Страница3.Заголовок = "Страница3" Тогда 
									
										Элементы.Страница3.Видимость = Истина;
										Элементы.Браузер3.Документ.URL = Авт.Парсинг;
										Элементы.Страница3.Заголовок = Сайт.Сайт;
										ИначеЕсли Элементы.Страница4.Заголовок = "Страница4" Тогда 
									
										Элементы.Страница4.Видимость = Истина;
										Элементы.Браузер4.Документ.URL = Авт.Парсинг;
										Элементы.Страница4.Заголовок = Сайт.Сайт;
										ИначеЕсли Элементы.Страница5.Заголовок = "Страница5" Тогда 
									
										Элементы.Страница5.Видимость = Истина;
										Элементы.Браузер5.Документ.URL = Авт.Парсинг;
										Элементы.Страница5.Заголовок = Сайт.Сайт;
										ИначеЕсли Элементы.Страница6.Заголовок = "Страница6" Тогда 
									
										Элементы.Страница6.Видимость = Истина;
										Элементы.Браузер6.Документ.URL = Авт.Парсинг;
										Элементы.Страница6.Заголовок = Сайт.Сайт;
						КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			КонецЕсли;
		КонецЦикла;
КонецПроцедуры
	
