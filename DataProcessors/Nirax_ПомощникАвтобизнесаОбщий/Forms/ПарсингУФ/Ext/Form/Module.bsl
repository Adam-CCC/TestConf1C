			Попытка
			  Документ = БраузерСформирован.Документ;
				КоллекцияФормы = Документ.forms;
			  Для каждого ЭлементФорма Из КоллекцияФормы Цикл
					Если ЭлементФорма.name = "enter" Тогда //это форма авторизации
					  ЭлементФорма.login.Value = Авт.Логин;					
					  ЭлементФорма.password.Value = Авт.Пароль;
						ЭлементФорма.remember.checked = Истина;
						ЭлементТаблица = ЭлементФорма.children.item(1);
						ЭлементСтрока = ЭлементТаблица.rows(3);
						КнопкаВойти = ЭлементСтрока.cells(1).firstChild;
						КнопкаВойти.click();
						
					КонецЕсли; 
				КонецЦикла;
				Форма = Истина;
				Возврат Форма;
			Исключение
			  Возврат(ИнформацияОбОшибке());//, Документ);
			КонецПопытки;
		 
	Иначе 
		Возврат "";
	КонецЕсли;

	
