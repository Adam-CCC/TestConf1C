//Получение ТаблицРезультатовПоиска
&НаКлиенте
Функция ПолучитьТаблицуРезультатовПоискаФорумАвто()
	Документ = БраузерСформирован.Документ;
	КоллекцияТаблиц = Документ.getElementsByTagName("TABLE");
	Для каждого ЭлементТаблица Из КоллекцияТаблиц Цикл
	  Если Лев(ЭлементТаблица.innerText, 35) = " Артикул БрендТоварПрименимостьДост" Тогда
			Возврат ЭлементТаблица;
		КонецЕсли; 
	КонецЦикла; 
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция ПолучитьТаблицуРезультатовПоискаАвтоДок()
	Документ = БраузерСформирован.Документ;
	Коллекция = Документ.getElementsByName("gridDetails");
	Если Коллекция.length > 0 Тогда
    Возврат Коллекция.item(0);
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
КонецФункции

&НаКлиенте
Функция ПолучитьТаблицуРезультатовПоискаШатеМ()
	Документ = БраузерСформирован.Документ;
	Коллекция = Документ.getElementsByName("goods");
	Если Коллекция.length > 0 Тогда
    Возврат Коллекция.item(0);
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
КонецФункции
