				Нов.ПолныйПуть = Файл.ПолноеИмя;
				Нов.Данные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		ПакетXDTO = Сериализатор.ЗаписатьXDTO(ФайлыКОтправке);
		Ответ = Прокси.Put(ПакетXDTO, ИдентификаторДилера, Сервер);
		
		Если Ответ Тогда
			Для Каждого СтрокаТЗ из ФайлыКОтправке Цикл
