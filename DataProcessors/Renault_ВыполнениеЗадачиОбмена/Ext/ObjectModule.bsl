	ОбработкаСтатистики.Организация = ЗадачаОбъект.Организация;
	ОбработкаСтатистики.Поток = Задача.Поток;
	
	Попытка
		ОбработкаСтатистики.ОтправитьСтатистику();
	Исключение КонецПопытки;
	
	////$+ Комментарий ДатаCоздания - 30.05.2013 17:00:20, Автор - Окипний Андрей Евгеньевич
	//<xml version="1.0" encoding="UTF-8">
