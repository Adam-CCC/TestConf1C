Процедура ЗавершитьПринудительноПроцессы()
	
	ИмяВременногоФайла = КаталогВременныхФайлов() + "kill_java_cmd_proc.bat";
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст("TASKKILL /F /IM ""java.exe""" + Символы.ПС + "TASKKILL /F /IM ""cmd.exe""");
	
	ТекстовыйДокумент.Записать(ИмяВременногоФайла,КодировкаТекста.ANSI);
	ТекстовыйДокумент = Неопределено;
	
	WShell_1 = Новый COMОбъект("WScript.Shell");
	WShell_1.Run(ИмяВременногоФайла);
	
	УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

