					ВызватьИсключение;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации("Задача обмена (Протокол TDFa)", УровеньЖурналаРегистрации.Информация , ,
		ЗадачаОбъект.Ссылка, "Отправка данных завершена");
		
	////КонецРаскоменторовать
	
