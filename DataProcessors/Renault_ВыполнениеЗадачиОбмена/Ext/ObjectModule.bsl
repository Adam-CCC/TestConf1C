			Если НЕ ОбработкаФормирования = Неопределено тогда 
				
				ОбработкаОбъект = ОбработкаФормирования.Создать();
				
				ЗаписьЖурналаРегистрации("Задача обмена (Протокол Web сервис)", УровеньЖурналаРегистрации.Информация,,,
				"Запущена обработка Загрузки полученных данных: " + ОбработкаОбъект.Метаданные().Синоним);
				
				//=====================
				//Заполнение реквизитов
				Если НЕ ОбработкаОбъект.Метаданные().Реквизиты.Найти("Организация") = Неопределено тогда
					ОбработкаОбъект.Организация = Задача.Организация;
				КонецЕсли;
				
				Параметры = Задача.Параметры;
				
				Для каждого Параметр из Параметры Цикл
					
					Реквизит = ОбработкаОбъект.метаданные().Реквизиты.Найти(Параметр.РеквизитОбработки);
					
					Если Реквизит <> Неопределено Тогда
						
						Значение = Параметр.Значение;
						Если НЕ Значение = Неопределено Тогда
							Если Реквизит.Тип = Новый ОписаниеТипов("СтандартныйПериод") тогда
								
								ОбработкаОбъект[Параметр.РеквизитОбработки].Вариант = СоответствиеВариантыПериода[Значение];
								
							Иначе
								
								ОбработкаОбъект[Параметр.РеквизитОбработки] = Значение;
								
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
				
				//Заполнение реквизитов
				//=====================
				
				ОбработкаОбъект.ОбработкаНаСервере();
				ЗаписьЖурналаРегистрации("Задача обмена (Протокол Web сервис)", УровеньЖурналаРегистрации.Информация,,,
				"Выполнена загрузка данных: " + ОбработкаОбъект.Метаданные().Синоним);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВыполнениеЗадачи()

Функция ПолучитьВебСервис() 
	
	Адрес = Константы.Renault_АдресWebСервисов.Получить() + "ws/";
	ЛогинWS = Константы.Renault_ЛогинВебСервиса.Получить();
	ПарольWS =Константы.Renault_ПарольВебСервиса.Получить();
	WSОпределение = Renault_ОбщегоНазначенияПовтИсп.ОпределениеTDFa(Адрес, ЛогинWS, ПарольWS);
	ВебСервис = Новый WSПрокси(
		WSОпределение, 
		"http://v8.1c.ru/8.1/data/core", 
		"Renault_TDFa", 
		"Renault_TDFaSoap12",
		3600);
	ВебСервис.Пользователь = СокрЛП(ЛогинWS);
	ВебСервис.Пароль = СокрЛП(ПарольWS);
	Возврат ВебСервис;
	
КонецФункции


