Функция ЗакрытьРЛ(НомерРЛ)
	ЗаписьРЛ=Renault_CRM.ПолучитьЗаписьРЛПоIDK(НомерРЛ);
	Если ЗаписьРЛ<>Неопределено Тогда
		ЗаписьРЛ.ЛистЗакрыт=Истина;
		ЗаписьРЛ.Период=ТекущаяДата();
		ЗаписьРЛ.Записать();
	КонецЕсли;
	Возврат Истина
КонецФункции
Функция ВернутьВРаботуРЛ(НомерРЛ,Комментарий)
	ЗаписьРЛ=Renault_CRM.ПолучитьЗаписьРЛПоIDK(НомерРЛ);
	Если ЗаписьРЛ=Неопределено Тогда Возврат Ложь КонецЕсли;
	
	Менеджер=РегистрыСведений.CRM_Комментарии.СоздатьМенеджерЗаписи();
	Менеджер.IDK=ЗаписьРЛ.IDK;
	Менеджер.Автор=Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник;
	Менеджер.Дата=ТекущаяДата();
	Менеджер.Идентификатор=Строка(Новый УникальныйИдентификатор());
	Менеджер.ТекстКомментария=Комментарий;
	Менеджер.Записать();
	
	ЗаписьРЛ.ЗапросНаЗакрытие=Ложь;
	ЗаписьРЛ.Период=ТекущаяДата();
	ЗаписьРЛ.Записать();
	
	Возврат Истина
КонецФункции