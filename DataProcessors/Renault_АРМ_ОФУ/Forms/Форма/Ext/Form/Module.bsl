Процедура УстановитьПараметрыСписков()
	//отбор списка страховые полисы
	Эл=спСтраховыеПолисы.Параметры.Элементы.Найти("ТекущаяДата"); Эл.Значение=ТекущаяДата(); Эл.Использование=Истина;
	Эл=спСтраховыеПолисы.Параметры.Элементы.Найти("Пролонгация"); Эл.Значение=ТолькоПролонгация; Эл.Использование=Истина;
	
	Эл=спПролонгация.Параметры.Элементы.Найти("ЭтоРуководитель"); Эл.Значение=ПараметрыСеанса.Renault_ПраваПользователя.РуководительОФУ; Эл.Использование=Истина; 
	Эл=спПролонгация.Параметры.Элементы.Найти("Пользователь"); Эл.Значение=Renault_ОбщиеФункцииСервер.ТекущийПользователь(); Эл.Использование=Истина;
	Эл=спПролонгация.Параметры.Элементы.Найти("Подразделение"); Эл.Значение=ПараметрыСеанса.ПодразделениеКомпании; Эл.Использование=Истина;
	
	Права=Renault_ОбщиеФункции.ПраваПользователя(Renault_ОбщиеФункцииСервер.ТекущийПользователь());
