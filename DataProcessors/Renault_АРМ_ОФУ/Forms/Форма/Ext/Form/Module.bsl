Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) 
	Если ИмяСобытия="ОбновитьСобытия" Тогда ОбновитьКалендарь() 
	ИначеЕсли ИмяСобытия="ОбновитьСписок" Тогда 
		ИмяСписка=ИмяСписка();
		Если Элементы.Найти(ИмяСписка)<>Неопределено Тогда
			Если ТипЗНЧ(Элементы[ИмяСписка]) = Тип("ТаблицаФормы") Тогда
				Элементы[ИмяСписка].Обновить();
			Иначе
				ОбновитьКалендарь();	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли 
