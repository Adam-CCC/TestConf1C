&НаКлиенте
Процедура НажатиеКнМенюСписка(Элемент)
	ИмяПунктаМеню=ИмяЗакладки();
	ИмяСписка=ИмяСписка();
	
	Если ТекущийЭлемент.Имя="кнОбновить" Тогда //это действие по умолчанию всегда
	ИначеЕсли ТекущийЭлемент.Имя="кнОтбор" Тогда
		
		Если ИмяПунктаМеню="Отчеты" Тогда
			Renault_ОбщиеФункции.ОткрытьКомпоновщикНастроек(ЭтаФорма,КомпоновщикНастроекОтчета,"ОтборОтчета")
		Иначе //динамические списки	
			
			//произвольный запрос
			Если ИмяПунктаМеню="Пролонгация" Тогда Источник=ПолучитьПроизвольныйИсточникНаСервере(ИмяСписка)
			//ИначеЕсли ИмяПунктаМеню="" Тогда
			Иначе Источник=ПолучитьИсточникНаСервере(ИмяСписка) //запрос по основной таблице
			КонецЕсли;	
			
			Renault_ОбщиеФункции.ОткрытьФормуОтбора(ЭтаФорма,Источник,ЭтаФорма[ИмяСписка].КомпоновщикНастроек,"ОтборСписка",ИмяСписка,,Истина)
		КонецЕсли;	
		
	ИначеЕсли ТекущийЭлемент.Имя="кнВыполнить" Тогда
		Если Элементы[ИмяСписка].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли; 
		ТекСтрока=Элементы[ИмяСписка].ТекущаяСтрока;
		Если ИмяПунктаМеню="Задачи" Тогда
			РезультатВыполнения = Задачи.Renault_События.ВыполнитьЗадачу(ТекСтрока, ПараметрыСеанса.Пользователь);
			//Сергеев В.Н. DMSREN-1114
			Если Не РезультатВыполнения Тогда
				DMS_ЗадачиКлиент.СоздатьОткрытьЦельЗадачи(ТекСтрока);
			КонецЕсли;
			//---------------------------------
		Иначе
			Проведение(ТекСтрока)
		КонецЕсли;
		
	ИначеЕсли ТекущийЭлемент.Имя="кнСостояние" Тогда
		Если Элементы[ИмяСписка].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		Сп=Новый СписокЗначений;
		Если ИмяПунктаМеню="Задачи" Тогда
			//ИмяРеквизита="Состояние";
			Выборка=Справочники.Renault_Состояния.Выбрать();
			Пока Выборка.Следующий() Цикл Сп.Добавить(Выборка.Ссылка) КонецЦикла;
		ИначеЕсли ИмяПунктаМеню="ФинансовыеУслуги" Тогда
			//ИмяРеквизита="Состояние";
			Для Каждого Эл Из Перечисления.Renault_CRM_СтатусЗаявокНаСтраховку Цикл Сп.Добавить(Эл) КонецЦикла;
		ИначеЕсли ИмяПунктаМеню="ЗаявкиНаКредит" Тогда	
			//ИмяРеквизита="Состояние";
			Для Каждого Эл Из Перечисления.Renault_CRM_СтатусЗаявокНаКредит Цикл Сп.Добавить(Эл) КонецЦикла;
		Иначе Возврат	
		КонецЕсли;
		
		Парам=Новый Структура;
		Парам.Вставить("Список",Сп);
		Парам.Вставить("Заголовок","Установить новое состояние");
		Парам.Вставить("МножественныйВыбор",Ложь);
		//Парам.Вставить("КоличествоЭлементовВСтроке",7);
		//Парам.Вставить("ШиринаЭлемента",0);
		Парам.Вставить("ШиринаЭлемента",17); 
		Парам.Вставить("ВысотаЭлемента",2);
		ТекЗнач=Сп.НайтиПоЗначению(Элементы[ИмяСписка].ТекущаяСтрока.Состояние);
		Если ТекЗнач<>Неопределено Тогда ТекЗнач.Пометка=Истина КонецЕсли;
		Состояние=ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
		Если Состояние<>Неопределено И УстановитьНовоеСостояние(ИмяСписка,Состояние) Тогда 
			Элементы[ИмяСписка].Обновить();
			ТекстИнформации(Элементы[ИмяСписка].ТекущаяСтрока);
		КонецЕсли;	
	
	ИначеЕсли ТекущийЭлемент.Имя="кнОтменить" Тогда
		Если Элементы[ИмяСписка].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		ТекСтрока=Элементы[ИмяСписка].ТекущаяСтрока;
		Если ИмяПунктаМеню="Задачи" Тогда Задачи.Renault_События.ОтменитьВыполнениеЗадачи(ТекСтрока)				
		Иначе ОтменаПроведения(ТекСтрока)
		КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнДобавить" Тогда
		ИмяОбъекта=ОснованаяТаблица(ИмяСписка);
		ОткрытьФорму(ИмяОбъекта+".ФормаОбъекта",,ЭтаФорма,УникальныйИдентификатор);
	ИначеЕсли ТекущийЭлемент.Имя="кнУдалить" Тогда
		Если Элементы[ИмяСписка].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		ТекСтрока=Элементы[ИмяСписка].ТекущаяСтрока; 
		ПометкаУдаления(ТекСтрока);
	ИначеЕсли ТекущийЭлемент.Имя="кнПериод" Тогда	
		
		Если ИмяПунктаМеню="Календарь" Тогда
			кнВыбратьПериод(Элемент);
		Иначе
			НастройкаПериода=Новый НастройкаПериода;
			
			Если ИмяПунктаМеню="СтраховыеПолисы" Тогда
				НастройкаПериода.ДатаНачала=ДобавитьМесяц(ТекущаяДата(), -1);
				НастройкаПериода.ДатаОкончания=ДобавитьМесяц(ТекущаяДата(), 1);
			ИначеЕсли ИмяПунктаМеню="Отчеты" Тогда
				Попытка 
					НастройкаПериода.ДатаНачала=КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата1").Значение;
					НастройкаПериода.ДатаОкончания=КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата2").Значение;
				Исключение Возврат КонецПопытки //попытка настройки не инициализированного отчета
			Иначе	
				НастройкаПериода.ДатаНачала=Элементы[ИмяСписка].Период.ДатаНачала;
				НастройкаПериода.ДатаОкончания=Элементы[ИмяСписка].Период.ДатаОкончания;
			КонецЕсли;
			
			НастройкаПериода.ВариантПериода=ВариантПериода.ПроизвольныйИнтервал;
			НастройкаПериода.Редактировать();
			
			Если ИмяПунктаМеню="СтраховыеПолисы" Тогда
				НачалоПериода=НастройкаПериода.ДатаНачала;
				КонецПериода=НастройкаПериода.ДатаОкончания;
			ИначеЕсли ИмяПунктаМеню="Отчеты" Тогда
				КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата1").Значение=НастройкаПериода.ДатаНачала;
				КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата2").Значение=КонецДня(НастройкаПериода.ДатаОкончания);
				КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата1").Использование=НастройкаПериода.ДатаНачала>'00010101';
				КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата2").Использование=НастройкаПериода.ДатаОкончания>'00010101';
				СформироватьОтчет();
			Иначе
				Элементы[ИмяСписка].Период.ДатаНачала=НастройкаПериода.ДатаНачала;
				Элементы[ИмяСписка].Период.ДатаОкончания=НастройкаПериода.ДатаОкончания;
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли ТекущийЭлемент.Имя="кнПролонгация" Тогда
		ТолькоПролонгация=НЕ ТолькоПролонгация;
		УстановитьПараметрыСписков();
		УправлениеМеню();
		
	ИначеЕсли ТекущийЭлемент.Имя="кнВидСобытия" Тогда
		
		Если ИмяПунктаМеню="Календарь" Тогда МассивТекСобытий=Календарь.ВидыСобытий.ВыгрузитьЗначения()
		ИначеЕсли ИмяПунктаМеню="Задачи" Тогда 
			Для Каждого Эл Из спЗадачи.Отбор.Элементы Цикл
				Если ТипЗнч(Эл)<>Тип("ЭлементОтбораКомпоновкиДанных") Тогда Продолжить КонецЕсли;
				Если Строка(Эл.ЛевоеЗначение)="ВидСобытия" Тогда
					ЭлОтбора=Эл;
					МассивТекСобытий=Эл.ПравоеЗначение.ВыгрузитьЗначения();
					Прервать
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	
		
		Массив=Новый Массив;
		Массив.Добавить(Перечисления.Renault_ОбластиПрименения.Общие);
		Массив.Добавить(Перечисления.Renault_ОбластиПрименения.ОФУ);
		МассивРазрешенных=Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластямПрименения(Массив,"Просмотр");
		
		ВариантыОтбора=Справочники.CRM_ВидыСобытий.СписокВидовСобытий(МассивРазрешенных,МассивТекСобытий);
		ВариантыОтбора.СортироватьПоПредставлению();
		ВариантыОтбора.Вставить(0,"ТолькоСвои","Только свои",НЕ Календарь.Сотрудник.Пустая(),БиблиотекаКартинок.Renault_Client_New);
		
		Парам=Новый Структура;
		Парам.Вставить("Список",ВариантыОтбора);
		Парам.Вставить("Заголовок","Отбор по видам событий");
		Парам.Вставить("МножественныйВыбор",Истина);
		//Парам.Вставить("КоличествоЭлементовВСтроке",4);
		Парам.Вставить("ШиринаЭлемента",17);
		Парам.Вставить("ВысотаЭлемента",2);
		
		Оповещение=Новый ОписаниеОповещения("ОтборПоВидуСобытийКалендаря",ЭтаФорма);
		ОткрытьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
		//Варианты=ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
		//
		//Если Варианты<>Неопределено Тогда
		//	Если ИмяПунктаМеню="Календарь" Тогда
		//		Календарь.ВидыСобытий.ЗагрузитьЗначения(Варианты);
		//		Календарь.Сотрудник=?(Варианты.Найти("ТолькоСвои")=Неопределено,"",Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник);
		//		ОбновитьКалендарь();
		//	ИначеЕсли ИмяПунктаМеню="Задачи" Тогда		
		//		ЭлОтбора.ПравоеЗначение.ЗагрузитьЗначения(Варианты);
		//	КонецЕсли;	
		//КонецЕсли;	
	ИначеЕсли ТекущийЭлемент.Имя="кнИсторияКоммуникации" Тогда
		Если Элементы[ИмяСписка].ТекущиеДанные=Неопределено Тогда Возврат КонецЕсли;
		ТекСтрока=Элементы[ИмяСписка].ТекущиеДанные;
		//Если Не ЗначениеЗаполнено(ТекСтрока.Контрагент) Тогда Возврат КонецЕсли;
		Если ТекСтрока.Свойство("Клиент") и ЗначениеЗаполнено(ТекСтрока.Клиент) тогда
			ИмяКолонки = "Клиент"
		ИначеЕсли ТекСтрока.Свойство("Контрагент") и ЗначениеЗаполнено(ТекСтрока.Контрагент) тогда
			ИмяКолонки = "Контрагент";
		иначе
			возврат;
		КонецЕсли;
		//Если Не ТекСтрока.Свойство("Клиент") Или Не ЗначениеЗаполнено(ТекСтрока.Клиент) Тогда Возврат КонецЕсли;
		спПролонгация.Отбор.Элементы.Очистить();
	    ЭлементОтбора=спПролонгация.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
		ЭлементОтбора.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.Использование=Истина;
		ЭлементОтбора.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Клиент");
		//ЭлементОтбора.ПравоеЗначение=ТекСтрока.Контрагент;
		ЭлементОтбора.ПравоеЗначение=ТекСтрока[ИмяКолонки];
        ТекущаяЗакладкаМеню=ПунктыМеню.Количество()-1; 
		ТекстИнформации(Неопределено);//очистка информации
		УправлениеМеню(ТекущийЭлемент.Имя);	
	Иначе 
		Сообщить("Действие кнопки еще не настроено"); Возврат
	КонецЕсли;
	
	//обновление списка - при любом действии кнопок списка
	Если ИмяПунктаМеню="Календарь" Тогда ОбновитьКалендарь() 
	ИначеЕсли ИмяПунктаМеню="Отчеты" Тогда СформироватьОтчет()
	Иначе Элементы[ИмяСписка].Обновить() КонецЕсли;
	
	ЗаголовокСтраницы();
КонецПроцедуры
&НаКлиенте
