Процедура СформироватьОтчет() Экспорт 
	Если АдресСхемыОтчета="" Тогда ОтчетHTML="" Иначе

		Фреймворк=Обработки[Renault_ОбщиеФункции.ПолучитьИмяФреймворкаОтчетов()].Создать();
		Фреймворк.Заголовок=Элементы.РазделУчета.СписокВыбора.НайтиПоЗначению(РазделУчета).Представление;
		ПарамДата1=КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата1");
		ПарамДата2=КомпоновщикНастроекОтчета.Настройки.ПараметрыДанных.Элементы.Найти("Дата2");
		Фреймворк.Подзаголовок="Группировка: "+Строка(КомпоновщикНастроекОтчета.Настройки.Структура[0].ПоляГруппировки);
		Если ПарамДата1.Использование ИЛИ ПарамДата2.Использование Тогда
			Фреймворк.Подзаголовок=Фреймворк.Подзаголовок+" за период "+?(ПарамДата1.Использование,"с "+Формат(ПарамДата1.Значение,"ДФ=dd.MM.yyyy"),"")+?(ПарамДата2.Использование," по "+Формат(ПарамДата2.Значение,"ДФ=dd.MM.yyyy"),"")
		КонецЕсли;	
		Фреймворк.Тип="pie";
		
		ЗаполнитьСерии(Фреймворк);    
		ОтчетHTML=Фреймворк.ПолучитьHTML();
	КонецЕсли;	
КонецПроцедуры

Процедура ЗаполнитьСерии(Фреймворк)
	Перем МаксЗначение;
	
	ТЗ=ВыполнитьСКД();
	КолВоВсего=ТЗ.Итог("КолВо");
	
	Менеджер=Обработки[Renault_ОбщиеФункции.ПолучитьИмяФреймворкаОтчетов()];
	ИмяСерии=Строка(КомпоновщикНастроекОтчета.Настройки.Структура[0].ПоляГруппировки.Элементы[0].Поле);
	
	Точки=Новый Массив;
	Для Каждого Стр Из ТЗ Цикл
		Точка=Менеджер.НоваяТочка(ИмяСерии,Стр[ИмяСерии],Окр(Стр.КолВо/КолВоВсего*100,2));
		Точки.Добавить(Точка);
		МаксЗначение=?(МаксЗначение=Неопределено,Точка, ?(Точка.Значение>МаксЗначение.Значение,Точка,МаксЗначение) );
	КонецЦикла;
	Менеджер.УстановитьАктивнуюТочку(Фреймворк,МаксЗначение); //выделить максимальное значение

	Серия=Новый Структура("ИмяСерии,Точки",ИмяСерии,Точки);
	
	Серии=Новый Массив;
	Серии.Добавить(Серия);
	
	Фреймворк.Серии=ЗначениеВСтрокуВнутр(Серии);
	
КонецПроцедуры	
Функция ВыполнитьСКД()
	Схема=ПолучитьИзВременногоХранилища(АдресСхемыОтчета);
	КомпоновщикМакета=Новый КомпоновщикМакетаКомпоновкиДанных;
	Настройки=КомпоновщикНастроекОтчета.ПолучитьНастройки();
	//Для Н=0 По Параметры.Количество()-1 Цикл Настройки.ПараметрыДанных.Элементы[Н].Значение=Параметры[Н] КонецЦикла;
	Макет=КомпоновщикМакета.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки=Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет,,,Истина);
	ПроцессорВывода=Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Возврат ПроцессорВывода.Вывести(ПроцессорКомпоновки,Истина)
КонецФункции

