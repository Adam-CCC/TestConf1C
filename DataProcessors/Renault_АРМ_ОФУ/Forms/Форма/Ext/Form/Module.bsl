&НаКлиенте
Процедура НажатиеКнМеню(Элемент) 
	Для Н=0 По ПунктыМеню.Количество()-1 Цикл
		Если Найти(ТекущийЭлемент.Имя,ПунктыМеню[Н].Значение)>0 Тогда ТекущаяЗакладкаМеню=Н; Прервать КонецЕсли;	
	КонецЦикла;
	ТекстИнформации(Неопределено);//очистка информации
	УправлениеМеню();
КонецПроцедуры

&НаКлиенте
Процедура УправлениеМеню(ИмяПереключателя = Неопределено)
	//скрыть или показать пункты меню в зависимости от набора прав
	Для Каждого Эл Из Элементы.кнМеню.ПодчиненныеЭлементы Цикл Эл.Видимость=ПунктыМеню.НайтиПоЗначению(Сред(Эл.Имя,3))<>Неопределено КонецЦикла;	
	
	//скрыть показать списки
	Для Н=0 По ПунктыМеню.Количество()-1 Цикл 
		Эл=Элементы.Найти("сп"+ПунктыМеню[Н]);
		Если Эл=Неопределено Тогда Продолжить КонецЕсли;
		Эл.Видимость=Н=ТекущаяЗакладкаМеню;
	КонецЦикла;	
	
	//цвета кнопок меню
	ПарамОфр=Renault_ОбщиеФункции.МультибрендПараметрыОформления();
	//Вкл=Новый Цвет(255,207,0);
	Вкл=Вычислить(ПарамОфр.ОсновнойЦвет);
	//Выкл=Вычислить(ПарамОфр.ДопЦвет1);
	//ВыклСерый=Вычислить(ПарамОфр.ДопЦвет1);
	Выкл=Новый Цвет(189,195,206);
	ВыклСерый=Новый Цвет(231,231,231);
	
	Для Н=1 По Элементы.кнМеню.ПодчиненныеЭлементы.Количество() Цикл
		Эл=Элементы.кнМеню.ПодчиненныеЭлементы[Н-1];
		Если НЕ Эл.Видимость Тогда Продолжить КонецЕсли;
		ЭтоТекущаяЗакладка=Сред(Эл.Имя,3)=ПунктыМеню[ТекущаяЗакладкаМеню].Значение;
		Эл.ЦветФона=?(ЭтоТекущаяЗакладка,Вкл,Выкл);  //?(Н=ТекущаяЗакладкаМеню,Вкл,Выкл);
		Эл.ЦветРамки=?(ЭтоТекущаяЗакладка,Вкл,Выкл);
	КонецЦикла;
	
	Элементы.кнПродление.ЦветФона=?(ТолькоПролонгация,Вкл,ВыклСерый);
	Элементы.кнПродление.ЦветРамки=?(ТолькоПролонгация,Вкл,ВыклСерый);
	
	ЗаголовокСтраницы();
	//НаборКнопокСписка();
	
	ИмяЗакладки=ИмяЗакладки();
	Если ИмяЗакладки="Календарь" Тогда
		Если КалендарьHTML="" Тогда ОбновитьКалендарь() КонецЕсли; //загрузка графика (HTML) при первом включении
		Элементы.кнДобавить.Видимость=Ложь;
		Элементы.кнУдалить.Видимость=Ложь;
		Элементы.кнВыполнить.Видимость=Ложь;
		Элементы.кнОтменить.Видимость=Ложь;
		Элементы.Интервал.Видимость=Истина;
		Элементы.кнКалендаря.Видимость=Истина;
		Элементы.кнПродление.Видимость=Ложь;
		Элементы.кнОтбор.Видимость=Ложь;
		Элементы.кнИсторияКоммуникации.Видимость = Ложь;
	ИначеЕсли ИмяЗакладки="Отчеты" Тогда
		Элементы.кнДобавить.Видимость=Ложь;
		Элементы.кнУдалить.Видимость=Ложь;
		Элементы.кнВыполнить.Видимость=Ложь;
		Элементы.кнОтменить.Видимость=Ложь;
		Элементы.Интервал.Видимость=Истина;
		Элементы.кнКалендаря.Видимость=Ложь;
		Элементы.кнПродление.Видимость=Ложь;
		Элементы.кнОтбор.Видимость=Истина;
		Элементы.кнИсторияКоммуникации.Видимость = Ложь;
	ИначеЕсли ИмяЗакладки="СтраховыеПолисы" Тогда
		Элементы.кнДобавить.Видимость=Истина;
		Элементы.кнУдалить.Видимость=Истина;
		Элементы.кнВыполнить.Видимость=Ложь;
		Элементы.кнОтменить.Видимость=Ложь;
		Элементы.Интервал.Видимость=Истина;
		Элементы.кнКалендаря.Видимость=Ложь;
		Элементы.кнПродление.Видимость=Истина;
		Элементы.кнОтбор.Видимость=Истина;
		Элементы.кнИсторияКоммуникации.Видимость = Ложь;
	ИначеЕсли ИмяЗакладки="КлиентыСервиса" или ИмяЗакладки="Пролонгация" Тогда
		Элементы.кнДобавить.Видимость=Ложь;
		Элементы.кнУдалить.Видимость=Ложь;
		Элементы.кнВыполнить.Видимость=Ложь;
		Элементы.кнОтменить.Видимость=Ложь;
		Элементы.Интервал.Видимость=Ложь;
		Элементы.кнКалендаря.Видимость=Ложь;
		Элементы.кнПродление.Видимость=Ложь;
		Элементы.кнОтбор.Видимость=Истина;
		Элементы.кнИсторияКоммуникации.Видимость = Ложь;
		Если ИмяПереключателя = Неопределено Тогда
			спПролонгация.Отбор.Элементы.Очистить();
		КонецЕсли;
	Иначе
		Элементы.кнДобавить.Видимость=Истина;
		Элементы.кнУдалить.Видимость=Истина;
		Элементы.кнВыполнить.Видимость=Истина;
		Элементы.кнОтменить.Видимость=Истина;
		Элементы.Интервал.Видимость=Ложь;
		Элементы.кнКалендаря.Видимость=Ложь;
		Элементы.кнПродление.Видимость=Ложь;
		Элементы.кнОтбор.Видимость=Истина;
		Элементы.кнИсторияКоммуникации.Видимость = Истина;
	КонецЕсли; 
	
	Элементы.кнСостояние.Видимость=(ИмяЗакладки="Задачи" или ИмяЗакладки="ФинансовыеУслуги" или ИмяЗакладки="ЗаявкиНаКредит");
	Элементы.кнВидСобытия.Видимость=ИмяЗакладки="Задачи" или ИмяЗакладки="Календарь";
	
	//Элементы.ИнформацияПоСтроке.Видимость=Не (ИмяЗакладки="Календарь" или ИмяЗакладки="Отчеты");
//проблемы совместимости	
Если НЕ Renault_ОбщиеФункции.СтараяПлатформа() Тогда
	Выполнить("Элементы.ИнформацияПоСтроке.Видимость=Не (ИмяЗакладки=""Календарь"" или ИмяЗакладки=""Отчеты"");")
КонецЕсли;	
	
КонецПроцедуры	

Функция ЗаголовокСтраницы()
	ИмяПунктаМеню=ИмяЗакладки();
	ДопЗаголовок="";
	Если ИмяПунктаМеню="Задачи" Тогда
	//задачи		
		//свои
		Запрос=Новый Запрос("Выбрать Количество(1) КолВо Из Задача.Renault_События ГДЕ Исполнитель=&Пользователь И Не Выполнена");
		Запрос.УстановитьПараметр("Пользователь",Renault_ОбщиеФункцииСервер.ТекущийПользователь());
		Выборка=Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ДопЗаголовок=" ("+Формат(Выборка.КолВо,"ЧН=0; ЧГ=0");
		//общие
		Запрос=Новый Запрос("Выбрать Количество(1) КолВо Из Задача.Renault_События ГДЕ Не Выполнена");
		Выборка=Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ДопЗаголовок=ДопЗаголовок+"/"+Формат(Выборка.КолВо,"ЧГ=0")+")";
	ИначеЕсли ИмяПунктаМеню="ЗаявкиНаКредит" Тогда
	//заявки на кредит	
		//Запрос=Новый Запрос("Выбрать Количество(1) КолВо Из Документ.Renault_РабочийЛистОФУ ГДЕ Состояние<>&Состояние");
		//Запрос.УстановитьПараметр("Состояние",Перечисления.Renault_СтатусЗаявокНаКредит.Выполнена);
		//Выборка=Запрос.Выполнить().Выбрать();
		//Выборка.Следующий();
		//ДопЗаголовок=" ("+Формат(Выборка.КолВо,"ЧГ=0")+")";
	
	ИначеЕсли ИмяПунктаМеню="ФинансовыеУслуги" Тогда
	//заявки на страховку
		//Запрос=Новый Запрос("Выбрать Количество(1) КолВо Из Документ.Renault_РабочийЛистОФУ ГДЕ Состояние <>&Состояние");
		//Запрос.УстановитьПараметр("Состояние",Перечисления.Renault_СтатусЗаявокНаСтраховку.Выполнена);
		//Выборка=Запрос.Выполнить().Выбрать();
		//Выборка.Следующий();
		//ДопЗаголовок=" ("+Формат(Выборка.КолВо,"ЧГ=0")+")";
		
	ИначеЕсли ИмяПунктаМеню="Календарь" Тогда
		ДопЗаголовок=" за период "+Обработки.Renault_КалендарьСобытий.ПериодСтрокой(Календарь,Истина);
		
	ИначеЕсли ИмяПунктаМеню="СтраховыеПолисы" Тогда
		ДопЗаголовок=?(ТолькоПролонгация," (пролонгация +/- месяц)","");
	КонецЕсли;	
	
	Стр=Новый Структура("Задачи,ЗаявкиНаКредит,ФинансовыеУслуги,СтраховыеПолисы,КлиентыСервиса,Календарь,Отчеты","Задачи и события","Заявки на кредит","Финансовые услуги","Страховые полисы","Клиенты сервиса","Календарь событий","Отчеты");
	//Элементы.ЗаголовокЗакладки.Заголовок=Врег(Стр[ИмяПунктаМеню])+ДопЗаголовок;
	
	Заголовок="ОФУ: "+ ?(Стр.Свойство(ИмяПунктаМеню),Стр[ИмяПунктаМеню]+ДопЗаголовок,ИмяПунктаМеню);
КонецФункции	

