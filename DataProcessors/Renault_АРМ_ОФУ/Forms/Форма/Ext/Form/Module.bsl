Функция Представление(Значение) //текстовое представление
	Перем СтрПредставление;
	Если ТипЗнч(Значение)=Тип("ДокументСсылка.CRM_КоммерческоеПредложение") Тогда
		
		СтрКП="";
		Для Каждого Стр Из Значение.Состав Цикл
			Если Стр.Конфигурация.Модель.Пустая() Тогда
				СтрЗнач=Стр.Конфигурация.Автомобиль.Наименование+" "+Стр.Конфигурация.Автомобиль.VIN;
			Иначе
				СтрЗнач=Стр.Конфигурация.Наименование+" "+Стр.Конфигурация.Модель.Наименование+" "+Стр.Конфигурация.Версия.Наименование
			КонецЕсли;	
			СтрКП=СтрКП+?(СтрКП="","",Символы.ПС)+СтрЗнач
		КонецЦикла;
		СтрПредставление=СтрКП+"; Сумма: "+Значение.Сумма
		
	ИначеЕсли ТипЗнч(Значение)=Тип("Дата") Тогда
		СтрПредставление=?(Значение='00010101',"",Формат(Значение,"ДЛФ=DDT; ДП="))
	ИначеЕсли ТипЗнч(Значение)=Тип("Число") Тогда
		СтрПредставление=Формат(Значение,"ЧРД=,; ЧРГ=`")
	Иначе
		СтрПредставление=Строка(Значение)
	КонецЕсли;
	Возврат СтрПредставление
КонецФункции
