&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	//брендовое оформление
	Массив=Новый Массив;
	Для Каждого Эл Из Элементы.кнМеню.ПодчиненныеЭлементы Цикл Массив.Добавить(Эл) КонецЦикла;	
	
	//Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветФона","ДопЦвет2");
	//Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветРамки","ДопЦвет2");
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветТекста","ЦветТекста");
	
	Массив=Новый Массив;
	Массив.Добавить(Элементы.кнСостояние);
	Массив.Добавить(Элементы.кнВидСобытия);
	Массив.Добавить(Элементы.кнОтбор);
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветФона","ОсновнойЦвет");
	
	Массив=Новый Массив;
	Массив.Добавить(Элементы.Декорация3);
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"Картинка","Логотип3");
	
	УправлениеМеню();
	
	//условное оформление задач
	Эл=спЗадачи.УсловноеОформление.Элементы.Добавить();
	Эл.Оформление.Элементы[0].Значение=Новый Цвет(255,207,0); //цвет фона
	Эл.Оформление.Элементы[0].Использование=Истина;
	Отбор=Эл.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
	Отбор.Использование=Истина;                        
	Отбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Исполнитель");
