			<field>СтатусПартии</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ОстаткиТоваровКомпанииОстатки.Номенклатура,
	ОстаткиТоваровКомпанииОстатки.СкладКомпании,
	ОстаткиТоваровКомпанииОстатки.ХарактеристикаНоменклатуры,
	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток,
	ОстаткиТоваровКомпанииОстатки.РезервОстаток,
	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул,
	ОстаткиТоваровКомпанииОстатки.Номенклатура.Производитель,
	Уценка.Номенклатура КАК НоменклатураУценки
ИЗ
	РегистрНакопления.ОстаткиТоваровКомпании.Остатки КАК ОстаткиТоваровКомпанииОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			УценкаТоваров.Номенклатура КАК Номенклатура
		ИЗ
			РегистрСведений.УценкаТоваров КАК УценкаТоваров) КАК Уценка
		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = Уценка.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ПартииТоваровКомпанииОстатки.СкладКомпании КАК СкладКомпанииПартии,
			ПартииТоваровКомпанииОстатки.Номенклатура КАК НоменклатураПартии,
			ПартииТоваровКомпанииОстатки.Партия КАК Партия,
			ПартииТоваровКомпанииОстатки.КоличествоОстаток КАК КП,
			ПартииТоваровКомпанииОстатки.СуммаОстаток КАК СП
		ИЗ
			РегистрНакопления.ПартииТоваровКомпании.Остатки КАК ПартииТоваровКомпанииОстатки) КАК ОстаткиПартийТоваров
		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура = ОстаткиПартийТоваров.НоменклатураПартии
			И ОстаткиТоваровКомпанииОстатки.СкладКомпании = ОстаткиПартийТоваров.СкладКомпанииПартии
ГДЕ
	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток &gt; 0</query>
