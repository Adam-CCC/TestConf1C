Процедура ОтправитьТаблицуАвтомобили(ТаблицаДанных, BIR)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&BIR КАК BIR,
	|	Таблица.Ссылка КАК Автомобиль
	|ПОМЕСТИТЬ Врем
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|ВЫБРАТЬ
	|	Врем.BIR,
	|	Врем.Автомобиль КАК Автомобиль,
	|	Врем.Автомобиль.Модель КАК Модель,
	|	Врем.Автомобиль.ВариантКомплектации КАК ВариантКомплектации
	|ИЗ
	|	Врем КАК Врем";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДанных);
	Запрос.УстановитьПараметр("BIR", BIR);
	ТаблицаАвтомобили = Запрос.Выполнить().Выгрузить();
	
	Результат = Фабрика.Создать(Фабрика.Тип("http://renault-nissan.com/schema/service", "АвтомобилиСтроки"));
	Для Каждого СтрокаТЗ ИЗ ТаблицаАвтомобили Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Автомобиль) Тогда
			СтрокаОтправки = Фабрика.Создать(Фабрика.Тип("http://renault-nissan.com/schema/service", "АвтомобилиСтрока"));
			Для Каждого Свойство ИЗ СтрокаОтправки.Свойства() Цикл
				Если Метаданные.Справочники.Автомобили.Реквизиты.Найти(Свойство.Имя) <> Неопределено
					И НЕ (Свойство.Имя = "Модель" ИЛИ Свойство.Имя = "ВариантКомплектации" ИЛИ Свойство.Имя = "Поставщик" ИЛИ Свойство.Имя = "Продавец" ИЛИ Свойство.Имя = "СемействоАвтомобиля") Тогда
					СтрокаОтправки[Свойство.Имя] = Строка(СтрокаТЗ.Автомобиль[Свойство.Имя]);
				Иначе
					СтрокаОтправки[Свойство.Имя] = "";
				КонецЕсли;
			КонецЦикла;
			СтрокаОтправки.UID = Строка(СтрокаТЗ.Автомобиль.УникальныйИдентификатор());
			СтрокаОтправки.BIR = СтрокаТЗ.BIR;
			СтрокаОтправки.Наименование = Строка(СтрокаТЗ.Автомобиль.Наименование);
			Если ЗначениеЗаполнено(СтрокаТЗ.Автомобиль.Модель) Тогда
				СтрокаОтправки.Модель = Строка(СтрокаТЗ.Автомобиль.Модель.Артикул);
				СтрокаОтправки.МодельUID = Строка(СтрокаТЗ.Автомобиль.Модель.УникальныйИдентификатор());
			Иначе
				СтрокаОтправки.Модель = "";
				СтрокаОтправки.МодельUID = "";
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТЗ.Автомобиль.ВариантКомплектации) Тогда
				СтрокаОтправки.ВариантКомплектации = Строка(СтрокаТЗ.Автомобиль.ВариантКомплектации.Артикул);
			Иначе
				СтрокаОтправки.ВариантКомплектации = "";
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТЗ.Автомобиль.Поставщик) Тогда
				СтрокаОтправки.Поставщик = Строка(СтрокаТЗ.Автомобиль.Поставщик.УникальныйИдентификатор());
			Иначе
				СтрокаОтправки.Поставщик = "";
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаТЗ.Автомобиль.Продавец) Тогда
				СтрокаОтправки.Продавец = Строка(СтрокаТЗ.Автомобиль.Продавец.УникальныйИдентификатор());
			Иначе
				СтрокаОтправки.Продавец = "";
			КонецЕсли;
