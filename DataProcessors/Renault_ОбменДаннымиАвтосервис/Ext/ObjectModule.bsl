	|	Врем КАК Врем";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДанных);
	Запрос.УстановитьПараметр("BIR", BIR);
	ТаблицаАвторабот = Запрос.Выполнить().Выгрузить();
	
	Результат = Фабрика.Создать(Фабрика.Тип("http://renault-nissan.com/schema/service", "АвтоработыСтроки"));
	Для Каждого СтрокаТЗ ИЗ ТаблицаАвторабот Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Работа) Тогда
			СтрокаОтправки = Фабрика.Создать(Фабрика.Тип("http://renault-nissan.com/schema/service", "АвтоработыСтрока"));
			СтрокаОтправки.Артикул = ?(ЗначениеЗаполнено(СтрокаТЗ.Работа.Артикул), СтрокаТЗ.Работа.Артикул, "");
			СтрокаОтправки.Наименование = ?(ЗначениеЗаполнено(СтрокаТЗ.Работа.Наименование), СтрокаТЗ.Работа.Наименование, "");;
			СтрокаОтправки.НаименованиеПолное = ?(ЗначениеЗаполнено(СтрокаТЗ.Работа.НаименованиеПолное), СтрокаТЗ.Работа.НаименованиеПолное, "");
			СтрокаОтправки.ВремяВыполнения = ?(ЗначениеЗаполнено(СтрокаТЗ.Работа.ВремяВыполнения), СтрокаТЗ.Работа.ВремяВыполнения, 0);
			СтрокаОтправки.Комментарий = ?(ЗначениеЗаполнено(СтрокаТЗ.Работа.Комментарий), СтрокаТЗ.Работа.Комментарий, "");
			Если ЗначениеЗаполнено(СтрокаТЗ.Работа.Номенклатура) Тогда
				СтрокаОтправки.Номенклатура = Строка(СтрокаТЗ.Работа.Номенклатура.Артикул);
			Иначе
				СтрокаОтправки.Номенклатура = "";
			КонецЕсли;
			Результат.Строки.Добавить(СтрокаОтправки);
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Строки.Количество() <> 0 Тогда
		Ответ = ВебСервис.SetData(Результат, "SetAutoWorks");
	КонецЕсли;
	
КонецПроцедуры

