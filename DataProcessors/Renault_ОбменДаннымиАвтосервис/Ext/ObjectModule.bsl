				СтрокаОтправки = Фабрика.Создать(Фабрика.Тип("http://renault-nissan.com/schema/service", "КлиентыСтрока"));
				СтрокаОтправки.UID = Строка(СтрокаТЗ.Клиент.УникальныйИдентификатор());
				СтрокаОтправки.BIR = СтрокаТЗ.BIR;
				
				Если ЗначениеЗаполнено(СтрокаТЗ.ИндексФС) Тогда
				
					СтрокаОтправки.ИндексФС = СтрокаТЗ.ИндексФС;
				
				Иначе
					
					СтрокаОтправки.ИндексФС = "";
				
				КонецЕсли;
				
				СтрокаОтправки.Наименование = Строка(СтрокаТЗ.Клиент.Наименование);
				СтрокаОтправки.НаименованиеПолное = Строка(СтрокаТЗ.Клиент.НаименованиеПолное);
				Результат.Строки.Добавить(СтрокаОтправки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Строки.Количество() <> 0 Тогда
		ВебСервис.SetData(Результат, "SetClients");
	КонецЕсли;
	
