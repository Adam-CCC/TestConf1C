
Перем ПериодВыгрузкиДней;
Перем ВебСервис;
Перем Фабрика;

//Точка входа. Вызывается регламентным заданием
Процедура ОбработкаНаСервере() Экспорт
	
	Если ЗначениеЗаполнено(ПланОбмена) Тогда
		
		ВыполнитьОтправкуДанныхВЦентральПоПлану();
		
	Иначе
		
		ВыполнитьОтправкуДанныхВЦентральБезПлана();
		//Renault_Открытый.СообщитьПользователю("Формирование отменено, Нет данных");
		
	КонецЕсли;
	
КонецПроцедуры

//Отправка данных По WS
Процедура ВыполнитьОтправкуДанныхВЦентральПоПлану()
	
	АдресWS = Константы.Renault_АдресWebСервисов.Получить();
	ЛогинWS = Константы.Renault_ЛогинВебСервиса.Получить();
	ПарольWS = Константы.Renault_ПарольВебСервиса.Получить();
	BIR = Константы.Renault_BIR_db.Получить();
	
	Адрес = АдресWS + "ws/auto_service.ws";
	Адрес = СтрЗаменить(Адрес, "?wsdl", "");
	WSОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
	СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	ВебСервис = Новый WSПрокси(WSОпределение, "http://renault-nissan.com/schema/service", 
	"ОбменАвтосервис", "ОбменАвтосервисSoap12", 3600);
	ВебСервис.Пользователь = СокрЛП(ЛогинWS);
	ВебСервис.Пароль = СокрЛП(ПарольWS);
	
	Фабрика = ВебСервис.ФабрикаXDTO;
	
	//Инициализируем таблицы и массивы
	ТаблицаКлиенты = ИнициализироватьТаблицуКлиенты();
	ТаблицаДЦ = ИнициализироватьТаблицуДЦ();
	ТаблицаСотрудники = ИнициализироватьТаблицуСотрудники();
	ТаблицаВидыОбращений = ИнициализироватьТаблицуВидыОбращений();
	ТаблицаМодели = ИнициализироватьТаблицуМодели();
	ТаблицаВариантыКомплектации = ИнициализироватьТаблицуВариантыКомплектации();
	ТаблицаАвтомобили = ИнициализироватьТаблицуАвтомобили();
	ТаблицаПричиныУпущения = ИнициализироватьТаблицуПричиныУпущения();
	ТаблицаАкцииИСкидки = ИнициализироватьТаблицуАкцииИСкидки();
	ТаблицаОбращения = ИнициализироватьТаблицуОбращения();
	ТаблицаЗН = ИнициализироватьТаблицуЗН();
	ТаблицаЗаявки = ИнициализироватьТаблицуЗаявки();
	ТаблицаНЧ = ИнициализироватьТаблицуНЧ();
	ТаблицаАвтоработы = ИнициализироватьТаблицуАвтоработы();
	ТаблицаЕдиницыИзмерения = ИнициализироватьТаблицуЕдиницыИзмерения();
	ТаблицаНоменклатура = ИнициализироватьТаблицуНоменклатура();
	ТаблицаЦеха = ИнициализироватьТаблицуЦеха();
	
	МассивИзмененныхДанных = Renault_Обмен_Общее.ПолучитьИзмененныеДанные(ПланОбмена);
	
	Если МассивИзмененныхДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//Зарегистрируем справочные данные, которые есть в документах
	Для Каждого ЭлементИзмененныхДанных Из МассивИзмененныхДанных Цикл
		
		Если ТипЗнч(ЭлементИзмененныхДанных) = Тип("ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис") Тогда
			
			Если ЗначениеЗаполнено(ЭлементИзмененныхДанных.Клиент) Тогда
				Стр = ТаблицаКлиенты.Добавить();
				Стр.Ссылка = ЭлементИзмененныхДанных.Клиент;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЭлементИзмененныхДанных.Автомобиль) Тогда
				Стр = ТаблицаАвтомобили.Добавить();
				Стр.Ссылка = ЭлементИзмененныхДанных.Автомобиль;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			
			Если ЗначениеЗаполнено(ЭлементИзмененныхДанных.Заказчик) Тогда
				Стр = ТаблицаКлиенты.Добавить();
				Стр.Ссылка = ЭлементИзмененныхДанных.Заказчик;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЭлементИзмененныхДанных.Контрагент) Тогда
				Стр = ТаблицаКлиенты.Добавить();
				Стр.Ссылка = ЭлементИзмененныхДанных.Контрагент;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЭлементИзмененныхДанных.Автомобиль) Тогда
				Стр = ТаблицаАвтомобили.Добавить();
				Стр.Ссылка = ЭлементИзмененныхДанных.Автомобиль;
			КонецЕсли;
			
			Для Каждого СтрокаРаботы ИЗ ЭлементИзмененныхДанных.Работы Цикл
				Если ЗначениеЗаполнено(СтрокаРаботы.Работа) Тогда
					Стр = ТаблицаАвтоработы.Добавить();
					Стр.Ссылка = СтрокаРаботы.Работа;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого СтрокаТовара ИЗ ЭлементИзмененныхДанных.Товары Цикл
				Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
					Стр = ТаблицаНоменклатура.Добавить();
					Стр.Ссылка = СтрокаТовара.Номенклатура;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаСервис") Тогда
			
			Если ЗначениеЗаполнено(ЭлементИзмененныхДанных.Клиент) Тогда
				Стр = ТаблицаКлиенты.Добавить();
				Стр.Ссылка = ЭлементИзмененныхДанных.Клиент;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЭлементИзмененныхДанных.Автомобиль) Тогда
				Стр = ТаблицаАвтомобили.Добавить();
				Стр.Ссылка = ЭлементИзмененныхДанных.Автомобиль;
			КонецЕсли;
			
			Для Каждого СтрокаРаботы ИЗ ЭлементИзмененныхДанных.Работы Цикл
				Если ЗначениеЗаполнено(СтрокаРаботы.Работа) Тогда
					Стр = ТаблицаАвтоработы.Добавить();
					Стр.Ссылка = СтрокаРаботы.Работа;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого СтрокаТовара ИЗ ЭлементИзмененныхДанных.Товары Цикл
				Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда
					Стр = ТаблицаНоменклатура.Добавить();
					Стр.Ссылка = СтрокаТовара.Номенклатура;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Получим ссылки на все изменения повторно, с учетом добавленных клиентов
	Для Каждого ЭлементИзмененныхДанных Из МассивИзмененныхДанных Цикл
		
		//Если ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Контрагенты") Тогда
		//	Стр = ТаблицаКлиенты.Добавить();
		//	Стр.Ссылка = ЭлементИзмененныхДанных;
		Если ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.CRM_ДилерскиеЦентры") Тогда
			Стр = ТаблицаДЦ.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Сотрудники") Тогда
			Стр = ТаблицаСотрудники.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Renault_ВидыОбращенийВАвтосервис") Тогда
			Стр = ТаблицаВидыОбращений.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Модели") Тогда
			Стр = ТаблицаМодели.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.ВариантыКомплектации") Тогда
			Стр = ТаблицаВариантыКомплектации.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		//ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Автомобили") Тогда
		//	Стр = ТаблицаАвтомобили.Добавить();
		//	Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Renault_ПричиныУпущенияОбращенийАвтосервис") Тогда
			Стр = ТаблицаПричиныУпущения.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Renault_АкцииИСкидки") Тогда
			Стр = ТаблицаАкцииИСкидки.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис") Тогда
			Стр = ТаблицаОбращения.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			Стр = ТаблицаЗН.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаСервис") Тогда
			Стр = ТаблицаЗаявки.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Нормочасы") Тогда
			Стр = ТаблицаНЧ.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		//ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Автоработы") Тогда
		//	Стр = ТаблицаАвтоработы.Добавить();
		//	Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.ЕдиницыИзмерения") Тогда
			Стр = ТаблицаЕдиницыИзмерения.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;	
		//ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Номенклатура") Тогда
		//	Стр = ТаблицаНоменклатура.Добавить();
		//	Стр.Ссылка = ЭлементИзмененныхДанных;
		ИначеЕсли ТипЗнч(ЭлементИзмененныхДанных) = Тип("СправочникСсылка.Цеха") Тогда
			Стр = ТаблицаЦеха.Добавить();
			Стр.Ссылка = ЭлементИзмененныхДанных;
		КонецЕсли;
		
	КонецЦикла;
	
	ОтправитьТаблицуКлиенты(ТаблицаКлиенты, BIR);
	ОтправитьТаблицуДЦ(ТаблицаДЦ, BIR);
	ОтправитьТаблицуСотрудники(ТаблицаСотрудники, BIR);
	ОтправитьТаблицуВидыОбращений(ТаблицаВидыОбращений, BIR);
	ОтправитьТаблицуМодели(ТаблицаМодели, BIR);
	ОтправитьТаблицуВариантыКомплектации(ТаблицаВариантыКомплектации, BIR);
	ОтправитьТаблицуАвтомобили(ТаблицаАвтомобили, BIR);
	ОтправитьТаблицуПричиныУпущения(ТаблицаПричиныУпущения, BIR);
	ОтправитьТаблицуАкцииИСкидки(ТаблицаАкцииИСкидки, BIR);
	ОтправитьТаблицуНЧ(ТаблицаНЧ, BIR);
	ОтправитьТаблицуАвтоработы(ТаблицаАвтоработы, BIR);
	ОтправитьТаблицуЕдиницыИзмерения(ТаблицаЕдиницыИзмерения, BIR);
	ОтправитьТаблицуНоменклатура(ТаблицаНоменклатура, BIR);
	ОтправитьТаблицуЦеха(ТаблицаЦеха, BIR);
	ОтправитьТаблицуОбращения(ТаблицаОбращения, BIR);
	ОтправитьТаблицуЗН(ТаблицаЗН, BIR);
	ОтправитьТаблицуЗаявки(ТаблицаЗаявки, BIR);
	
КонецПроцедуры

//Отправка данных По WS
Процедура ВыполнитьОтправкуДанныхВЦентральБезПлана()
	
	ПериодВыгрузкиДней = 365;
	ДатаНачалаВыгрузки = НачалоДня(НачалоПериода);
	ДатаОкончанияВыгрузки = КонецДня(ОкончаниеПериода);
	
	АдресWS = Константы.Renault_АдресWebСервисов.Получить();
	ЛогинWS = Константы.Renault_ЛогинВебСервиса.Получить();
	ПарольWS = Константы.Renault_ПарольВебСервиса.Получить();
	BIR = Константы.Renault_BIR_db.Получить();
	
	Адрес = АдресWS + "ws/auto_service.ws";
	Адрес = СтрЗаменить(Адрес, "?wsdl", "");
	WSОпределение = Новый WSОпределения(СокрЛП(Адрес) + "?wsdl",
	СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	ВебСервис = Новый WSПрокси(WSОпределение, "http://renault-nissan.com/schema/service", 
	"ОбменАвтосервис", "ОбменАвтосервисSoap12", 3600);
	ВебСервис.Пользователь = СокрЛП(ЛогинWS);
	ВебСервис.Пароль = СокрЛП(ПарольWS);
	
	Фабрика = ВебСервис.ФабрикаXDTO;
	
	//Инициализируем таблицы и массивы
	ТаблицаКлиенты = ИнициализироватьТаблицуКлиенты();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДилерскиеЦентры.Ссылка
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры КАК ДилерскиеЦентры";
	ТаблицаДЦ = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники";
	ТаблицаСотрудники = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОбращений.Ссылка
	|ИЗ
	|	Справочник.Renault_ВидыОбращенийВАвтосервис КАК ВидыОбращений";
	ТаблицаВидыОбращений = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Модели.Ссылка
	|ИЗ
	|	Справочник.Модели КАК Модели";
	ТаблицаМодели = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВариантыКомплектации.Ссылка
	|ИЗ
	|	Справочник.ВариантыКомплектации КАК ВариантыКомплектации";
	ТаблицаВариантыКомплектации = Запрос.Выполнить().Выгрузить();
	
	ТаблицаАвтомобили = ИнициализироватьТаблицуАвтомобили();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПричиныУпущения.Ссылка
	|ИЗ
	|	Справочник.Renault_ПричиныУпущенияОбращенийАвтосервис КАК ПричиныУпущения";
	ТаблицаПричиныУпущения = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АкцииИСкидки.Ссылка
	|ИЗ
	|	Справочник.Renault_АкцииИСкидки КАК АкцииИСкидки";
	ТаблицаАкцииИСкидки = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Обращения.Ссылка
	|ИЗ
	|	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Обращения
	|ГДЕ Обращения.Дата >= &ДатаНачалаВыгрузки
	|	И Обращения.Дата <= &ДатаОкончанияВыгрузки";
	Запрос.УстановитьПараметр("ДатаНачалаВыгрузки", ДатаНачалаВыгрузки);
	Запрос.УстановитьПараметр("ДатаОкончанияВыгрузки", ДатаОкончанияВыгрузки);
	ТаблицаОбращения = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаряд.Ссылка
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ ЗаказНаряд.Дата >= &ДатаНачалаВыгрузки
	|	И ЗаказНаряд.Дата <= &ДатаОкончанияВыгрузки";
	Запрос.УстановитьПараметр("ДатаНачалаВыгрузки", ДатаНачалаВыгрузки);
	Запрос.УстановитьПараметр("ДатаОкончанияВыгрузки", ДатаОкончанияВыгрузки);
	ТаблицаЗН = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Заявки.Ссылка
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Заявки
	|ГДЕ Заявки.Дата >= &ДатаНачалаВыгрузки
	|	И Заявки.Дата <= &ДатаОкончанияВыгрузки";
	Запрос.УстановитьПараметр("ДатаНачалаВыгрузки", ДатаНачалаВыгрузки);
	Запрос.УстановитьПараметр("ДатаОкончанияВыгрузки", ДатаОкончанияВыгрузки);
	ТаблицаЗаявки = Запрос.Выполнить().Выгрузить();
	
