	Запрос.УстановитьПараметр("BIR", BIR);
	ТаблицаКлиенты = Запрос.Выполнить().Выгрузить();
	Менеджер.Закрыть();
	
	Результат = Фабрика.Создать(Фабрика.Тип("http://renault-nissan.com/schema/service", "КлиентыСтроки"));
	Для Каждого СтрокаТЗ ИЗ ТаблицаКлиенты Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.Клиент) Тогда
