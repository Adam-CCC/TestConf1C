
Процедура СформироватьЦэЭсВэНаСервере() Экспорт
	
	ГдеСоздавать = КаталогВременныхФайлов(); 
	//ГдеСоздавать = "L:\PowerBI\";
	
	ТаблицаСостав = Новый ТаблицаЗначений;
	ТаблицаСостав.Колонки.Добавить("Дата");
	ТаблицаСостав.Колонки.Добавить("Номер");
	ТаблицаСостав.Колонки.Добавить("ПодразделениеКомпании");
	ТаблицаСостав.Колонки.Добавить("ПредставлениеТелефона");
	ТаблицаСостав.Колонки.Добавить("Марка");
	ТаблицаСостав.Колонки.Добавить("АвтомобильНовый");
  	ТаблицаСостав.Колонки.Добавить("НомерРЛ");
	ТаблицаСостав.Колонки.Добавить("Чат");
	ТаблицаСостав.Колонки.Добавить("ЭтоВизит");
	ТаблицаСостав.Колонки.Добавить("Ссылка");
	
	Для Сч = 1 По 3 Цикл
		
		Если Сч = 1 Тогда
			ИмяФайла = ГдеСоздавать+"RL.CSV";
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	РабочийЛист.Дата КАК Дата,
			               |	РабочийЛист.Номер КАК Номер,
			               |	РабочийЛист.ПодразделениеКомпании КАК ПодразделениеКомпании,
			               |	РабочийЛист.ПредставлениеТелефона КАК ПредставлениеТелефона,
			               |	РабочийЛист.Модель.Марка КАК Марка,
			               |	РабочийЛист.Ссылка КАК Ссылка
			               |ИЗ
			               |	Документ.РабочийЛист КАК РабочийЛист
			               |ГДЕ
			               |	РабочийЛист.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			               |	И РабочийЛист.Проведен
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	Дата";
		ИначеЕсли Сч = 2 Тогда
			ИмяФайла = ГдеСоздавать+"RA.CSV";
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	РеализацияАвтомобилейАвтомобили.Ссылка.Дата КАК Дата,
			               |	РеализацияАвтомобилейАвтомобили.Ссылка.Номер КАК Номер,
			               |	РеализацияАвтомобилейАвтомобили.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
			               |	РеализацияАвтомобилейАвтомобили.Ссылка.Заказчик.ОсновнойТелефон КАК ПредставлениеТелефона,
			               |	РеализацияАвтомобилейАвтомобили.Автомобиль.Модель.Марка КАК Марка,
			               |	ВЫБОР
			               |		КОГДА ХарАвто.Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.Новый)
			               |			ТОГДА ИСТИНА
			               |		ИНАЧЕ ЛОЖЬ
			               |	КОНЕЦ КАК АвтомобильНовый,
			               |	РеализацияАвтомобилейАвтомобили.Ссылка КАК Ссылка,
			               |	РеализацияАвтомобилейАвтомобили.Автомобиль КАК Автомобиль,
			               |	РеализацияАвтомобилейАвтомобили.ЗаказНаАвтомобиль.РабочийЛист.Номер КАК НомерРЛ
			               |ИЗ
			               |	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
			               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			               |			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
			               |			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
			               |			АвтомобилиСрезПоследних.Значение КАК Значение
			               |		ИЗ
			               |			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
			               |		ГДЕ
			               |			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля)) КАК ХарАвто
			               |		ПО РеализацияАвтомобилейАвтомобили.Автомобиль = ХарАвто.Автомобиль
			               |ГДЕ
			               |	РеализацияАвтомобилейАвтомобили.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			               |	И РеализацияАвтомобилейАвтомобили.Ссылка.Проведен
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	Дата";
			
		ИначеЕсли Сч = 3 Тогда	                
			ИмяФайла = ГдеСоздавать+"SB.CSV";
			Запрос = Новый Запрос;
			
			Запрос.Текст = "ВЫБРАТЬ
			               |	Событие.ДатаОкончания КАК Дата,
			               |	Событие.Номер КАК Номер,
			               |	Событие.ПодразделениеКомпании КАК ПодразделениеКомпании,
			               |	Событие.Модель.Марка КАК Марка,
			               |	Событие.ПредставлениеТелефона КАК ПредставлениеТелефона,
			               |	Событие.ДокументОснование.Номер КАК НомерРЛ,
			               |	Событие.ВидСобытия КАК ВидСобытия,
			               |	Событие.ТипСообщения КАК ТипСообщения,
			               |	Событие.ДокументОснование.Реклама КАК Чат,
			               |	ВЫБОР
			               |		КОГДА Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)
			               |			ТОГДА ИСТИНА
			               |		ИНАЧЕ ЛОЖЬ
			               |	КОНЕЦ КАК ЭтоВизит
			               |ИЗ
			               |	Документ.Событие КАК Событие
			               |ГДЕ
			               |	Событие.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщений.Входящее)
			               |	И Событие.ДатаОкончания МЕЖДУ &ДатаНачала И &ДатаОкончания
			               |	И Событие.Проведен
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	Дата";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ДатаНачала",Дата(2023,1,1));
		Запрос.УстановитьПараметр("ДатаОкончания",НачалоДня(ТекущаяДата())-1);
		
		ТаблицаСостав = Запрос.Выполнить().Выгрузить();
		
		ТекстЗН = Новый ТекстовыйДокумент; 
		
		Для каждого Строка Из ТаблицаСостав Цикл
			
			Если Сч = 1 Тогда
				ТекстЗН.ДобавитьСтроку(
				СокрЛП(Формат(Строка.Дата,"ДФ=dd.MM.yyyy"))+";"+
				СокрЛП(Строка.Номер) + ";"+
				СокрЛП(Строка.ПодразделениеКомпании) + ";"+
				СокрЛП(Строка.ПредставлениеТелефона) + ";"+
				СокрЛП(Строка.Марка) ); 
			ИначеЕсли Сч = 2 Тогда
				ТекстЗН.ДобавитьСтроку(
				СокрЛП(Формат(Строка.Дата,"ДФ=dd.MM.yyyy"))+";"+
				СокрЛП(Строка.Номер) + ";"+
				СокрЛП(Строка.ПодразделениеКомпании) + ";"+
				СокрЛП(Строка.ПредставлениеТелефона) + ";"+
				СокрЛП(Строка.Марка) + ";"+
 				СокрЛП(Строка.НомерРЛ) + ";"+
				СокрЛП(Строка.АвтомобильНовый) );
			ИначеЕсли Сч = 3 Тогда
				ТекстЗН.ДобавитьСтроку(
				СокрЛП(Формат(Строка.Дата,"ДФ=dd.MM.yyyy"))+";"+
				СокрЛП(Строка.Номер) + ";"+
				СокрЛП(Строка.ПодразделениеКомпании) + ";"+
				СокрЛП(Строка.ПредставлениеТелефона) + ";"+
				СокрЛП(Строка.Марка) + ";"+
 				СокрЛП(Строка.НомерРЛ) + ";"+
				СокрЛП(Строка.Чат) + ";"+
				СокрЛП(Строка.ЭтоВизит) );
			КонецЕсли;
 			
		КонецЦикла;
		
		Попытка
			ТекстЗН.Записать(ИмяФайла); 
			СМГ_Сообщить("Выгрузка в файл <<"+ИмяФайла+">> завершена: "+Формат(ТекущаяДата(),"ДЛФ=DDT"));
		Исключение
			СМГ_Сообщить("ОШИБКА! Не удалось записать файл : "+ИмяФайла,СтатусСообщения.ОченьВажное);		
		КонецПопытки; 
		
	КонецЦикла;

  	
КонецПроцедуры

 