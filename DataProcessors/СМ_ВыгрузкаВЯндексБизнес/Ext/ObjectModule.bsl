
Функция ПолучитьСписокПодразделений(ТекОбъект)
	
	ИтогСпПодр = Новый СписокЗначений;
	
	Для каждого ТекПодр Из ТекОбъект.Подразделения Цикл
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПодразделенияКомпании.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		               |ГДЕ
		               |	ПодразделенияКомпании.Ссылка В ИЕРАРХИИ(&Подразделение)
		               |	И ПодразделенияКомпании.ПометкаУдаления = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Подразделение",ТекПодр.ПодразделениеКомпании);
		
		ТекСпПодр = Новый СписокЗначений;
		
		ТекСпПодр.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
		
		Для каждого НовПодр Из ТекСпПодр Цикл
			Если ИтогСпПодр.НайтиПоЗначению(НовПодр.Значение) = Неопределено Тогда
				ИтогСпПодр.Добавить(НовПодр.Значение);
  			КонецЕсли;		
 		КонецЦикла;
		
	КонецЦикла;	 
	
 	Возврат ИтогСпПодр;
	
КонецФункции // ПолучитьСписокПодразделений(ТекОбъект)

Процедура ВыгрузитьОстаткиАвтоВЭксЭмЭльФайл() Экспорт
	
	ИмяПодкаталога = ВыбратьКаталог_();
	
	Если обЗначениеНеЗаполнено(ИмяПодкаталога) Тогда
 		Возврат;		
	КонецЕсли; 
	
  	Выборка = Справочники.СМ_ЯндексБизнес_Настройки.Выбрать();
	
 	Пока Выборка.Следующий()  Цикл
		
		ТекОбъект = Выборка.ПолучитьОбъект();
		
		Если ТекОбъект.ЭтоГруппа Тогда
		    Продолжить;
		КонецЕсли;
		
		Если ТекОбъект.ПометкаУдаления Тогда
		    Продолжить;
		КонецЕсли; 
		
		#Если Клиент Тогда
			Попытка Состояние("Выгрузка "+СокрЛП(ТекОбъект.Наименование)); Исключение КонецПопытки; 
 		#КонецЕсли
 		
		СписокПодразделений = Новый СписокЗначений;
		
		Если ТекОбъект.Подразделения.Количество() > 0 Тогда
 			СписокПодразделений = ПолучитьСписокПодразделений(ТекОбъект);
  		КонецЕсли;
 		
		Если СписокПодразделений.Количество() > 0 Тогда
			СписокМарок = Новый СписокЗначений;
			СписокМарок.ЗагрузитьЗначения(ТекОбъект.МаркиДляВыгрузки.Выгрузить().ВыгрузитьКолонку("Марка"));
			Если СписокМарок.Количество() > 0 Тогда
				ИмяФайла = ИмяПодкаталога+"\"+ТекОбъект.Наименование+".xml";
				Отказ = СформироватьФайлДляЯндекса(ИмяФайла,СписокПодразделений,СписокМарок);			
				Если Отказ Тогда 
					#Если Клиент Тогда
						Попытка Сообщить("ОШИБКА! Файл "+ИмяФайла+" не сформирован",СтатусСообщения.ОченьВажное) Исключение КонецПопытки;
					#КонецЕсли	
 				КонецЕсли;
 			КонецЕсли;
		КонецЕсли
		
	КонецЦикла; 
	
	#Если Клиент Тогда
    	Предупреждение("Выгрузка завершена.");
	#КонецЕсли	
	
КонецПроцедуры //ВыгрузитьОстаткиАвтоВЭксЭмЭльФайл()

Функция ВыбратьКаталог_()
	ИмяКаталога = "";
	Диалог = новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Если Диалог.Выбрать() Тогда
		ИмяКаталога = Диалог.Каталог;
		//Полный путь к каталогу помещен в переменную ИмяКаталога
	КонецЕсли;       
	Возврат ИмяКаталога;
КонецФункции // ВыбратьКаталог_() 

Функция СформироватьФайлДляЯндекса(ПутьКФайлу,СпПодр,СпМарок)

	ФлОтказ = Истина;                      
	
 	ФайлВыгрузки = Новый Файл(ПутьКФайлу);
	
	Если ФайлВыгрузки.Существует() Тогда
		Если НЕ ФайлВыгрузки.ЭтоФайл() Тогда
 			Предупреждение("ОШИБКА! Указанное имя соответствует каталогу, а не файлу.");
			Возврат ФлОтказ;
		КонецЕсли;
 	КонецЕсли;
	
	СпАвтоТестДрайва = ПолучитьАвтомобилиДляТестДрайва();
	
	ТаблицаАвто = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.Наименование КАК Наименование,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.VIN КАК VIN,
	|	СУММА(ОстаткиАвтомобилейОстатки.КоличествоОстаток) КАК Остаток,
	|	ЦенаАвто.Цена КАК Цена,
	|	ХарАвто.Значение КАК ВидАвто,
	|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение КАК ПодразделениеКомпании,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.СтоимостьДопОборудования КАК СтоимостьДопОборудования,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЦеныАвтомобилейСрезПоследних.Цена КАК Цена,
	|			ЦеныАвтомобилейСрезПоследних.Автомобиль КАК Автомобиль,
	|			ЦеныАвтомобилейСрезПоследних.ВариантКомплектации КАК ВариантКомплектации,
	|			ЦеныАвтомобилейСрезПоследних.ТипЦен КАК ТипЦен
	|		ИЗ
	|			РегистрСведений.ЦеныАвтомобилей.СрезПоследних КАК ЦеныАвтомобилейСрезПоследних
	|		ГДЕ
	|			ЦеныАвтомобилейСрезПоследних.ТипЦен = ЗНАЧЕНИЕ(Справочник.ТипыЦен.ОсновнойТипЦенПродажи)) КАК ЦенаАвто
	|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ЦенаАвто.Автомобиль
	|			И ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации = ЦенаАвто.Автомобиль.ВариантКомплектации
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			АвтомобилиСрезПоследних.Автомобиль КАК Автомобиль,
	|			АвтомобилиСрезПоследних.ВидЗначения КАК ВидЗначения,
	|			АвтомобилиСрезПоследних.Значение КАК Значение
	|		ИЗ
	|			РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	|		ГДЕ
	|			АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля)) КАК ХарАвто
	|		ПО ОстаткиАвтомобилейОстатки.Автомобиль = ХарАвто.Автомобиль
	|ГДЕ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
	|	И (ХарАвто.Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.Новый)
	|			ИЛИ ХарАвто.Значение = ЗНАЧЕНИЕ(Перечисление.ВидАвтомобиля.ПараллельныйИмпорт))
	|	И ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение В (&СпПодр)
	|	И ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка В (&СпМарок)
	|	И НЕ ОстаткиАвтомобилейОстатки.Автомобиль В (&СпАвтоТестДрайва)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАвтомобилейОстатки.Автомобиль,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.VIN,
	|	ЦенаАвто.Цена,
	|	ХарАвто.Значение,
	|	ОстаткиАвтомобилейОстатки.СкладКомпании.Подразделение,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.Наименование,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.СтоимостьДопОборудования,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель.Марка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
  	
 	Запрос.УстановитьПараметр("СпПодр",СпПодр);
	Запрос.УстановитьПараметр("СпМарок",СпМарок);
	Запрос.УстановитьПараметр("СпАвтоТестДрайва",СпАвтоТестДрайва);
	
	ТаблицаАвто = Запрос.Выполнить().Выгрузить();
	
	АйДиКатегории = "1";
	
 	XML=Новый ЗаписьXML();
	
	XML.ОткрытьФайл(ФайлВыгрузки.ПолноеИмя);
	
	XML.ЗаписатьОбъявлениеXML();
	
	XML.ЗаписатьНачалоЭлемента("yml_catalog");
	//XML.ЗаписатьАтрибут("xmlns:xsi", "https:www.w3.org/2001/XMLSchema-instance");
	
	XML.ЗаписатьНачалоЭлемента("shop"); 
 	 
 	XML.ЗаписатьНачалоЭлемента("categories");
	XML.ЗаписатьНачалоЭлемента("category");
	XML.ЗаписатьАтрибут("id",АйДиКатегории);
 	XML.ЗаписатьТекст("Автомобили");
  	XML.ЗаписатьКонецЭлемента(); //category
	XML.ЗаписатьКонецЭлемента(); //categories
 	
	XML.ЗаписатьНачалоЭлемента("offers");
	
	Для каждого Стр1 Из ТаблицаАвто Цикл
		
		Если обЗначениеНеЗаполнено(Стр1.Цена) Тогда
			Продолжить;
 		КонецЕсли;
		
		XML.ЗаписатьНачалоЭлемента("offer");
		XML.ЗаписатьАтрибут("id",СокрЛП(Стр1.VIN));
		XML.ЗаписатьНачалоЭлемента("name");                XML.ЗаписатьТекст(Стр1.Автомобиль.Модель.Наименование);                                                                  XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("model");               XML.ЗаписатьТекст(Стр1.Автомобиль.Модель.Наименование);                                                XML.ЗаписатьКонецЭлемента();
		XML.ЗаписатьНачалоЭлемента("vendor");              XML.ЗаписатьТекст(Стр1.Автомобиль.Модель.Марка.Наименование);                                          XML.ЗаписатьКонецЭлемента();

		ЦенаПродажи =  0+Стр1.Цена+Стр1.СтоимостьДопОборудования;         
		XML.ЗаписатьНачалоЭлемента("price");               XML.ЗаписатьТекст(СокрЛП(СтрЗаменить(ЦенаПродажи,Символы.НПП,"")));                                    XML.ЗаписатьКонецЭлемента(); 
		
		XML.ЗаписатьНачалоЭлемента("currencyId");          XML.ЗаписатьТекст("RUR");                                                                              XML.ЗаписатьКонецЭлемента();
 
		XML.ЗаписатьНачалоЭлемента("categoryId");         XML.ЗаписатьТекст(АйДиКатегории);                                                                              XML.ЗаписатьКонецЭлемента();
   
   		 
  		Для каждого СтрТЧ Из Стр1.Автомобиль.ПутьКФото Цикл
   			Если обЗначениеНеЗаполнено(СтрТЧ.GUID) Тогда
				Продолжить;
			КонецЕсли;                        
 			XML.ЗаписатьНачалоЭлемента("picture"); 
			XML.ЗаписатьТекст("https://it.sokolmotors.ru/alfaauto-noauth/hs/advert/photo/"+Стр1.Автомобиль.УникальныйИдентификатор()+"/"+СтрТЧ.GUID+".jpg");
   			XML.ЗаписатьКонецЭлемента(); //picture	
			Прервать;
		КонецЦикла; 
 		
		XML.ЗаписатьНачалоЭлемента("description");         XML.ЗаписатьТекст("Комплектация: " + Стр1.Автомобиль.ВариантКомплектации.НаименованиеПолное + " Двигатель: " + Стр1.Автомобиль.ВариантКомплектации.ТипДвигателя.Наименование + " КПП: " + Стр1.Автомобиль.ВариантКомплектации.ТипКПП.Наименование);                                                XML.ЗаписатьКонецЭлемента();
		
  		XML.ЗаписатьКонецЭлемента(); //offer

 	КонецЦикла; 
	
	XML.ЗаписатьКонецЭлемента();	 //offers
	
	XML.ЗаписатьКонецЭлемента();	 //shop
	
	XML.ЗаписатьКонецЭлемента();     //yml_catalog
	
	XMLТекст = XML.Закрыть();
	
 	флОтказ = Ложь;
	
	Возврат флОтказ; 
	
КонецФункции //СформироватьФайлДляЯндекса(ПутьКФайлу,СпПодр,СпМарок)

Функция ПолучитьАвтомобилиДляТестДрайва() 
	СписокАвто = Новый СписокЗначений;
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Объект КАК Автомобиль
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Объект ССЫЛКА Справочник.Автомобили
	|	И ЗначенияСвойствОбъектов.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ИспользоватьДляТестДрайва)
	|	И ЗначенияСвойствОбъектов.Значение = ИСТИНА";
 	СписокАвто = Новый СписокЗначений;
	СписокАвто.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Автомобиль")); 
	Возврат СписокАвто;
КонецФункции
 
