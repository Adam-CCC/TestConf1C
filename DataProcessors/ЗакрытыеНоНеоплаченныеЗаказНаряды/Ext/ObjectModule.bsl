Процедура СформироватьОтчет() Экспорт

	ПустаяДата = Дата(1, 1, 1);
	Дата = НачалоДня(Дата);
	ОтчетыПоДЦ.Очистить();
	
	// Запрос для списка нарушителей
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СУММА(ВзаиморасчетыКомпанииОстаткиИОбороты.СуммаОборот) КАК Долг,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.СуммаДокумента КАК СуммаДокумента,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка КАК Сделка,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ДатаЗакрытия КАК ДатаЗакрытияЗН,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.Контрагент КАК КонтрагентЗН,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ПодразделениеКомпании.Родитель КАК ДилерскийЦентр,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ПодразделениеКомпании.Родитель.Наименование КАК ДилерскийЦентр_Наименование,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ВидРемонта.ГарантияЗавода КАК ГарантияЗавода,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.Контрагент.Наименование КАК Контрагент_Наименование
	                      |ИЗ
	                      |	РегистрНакопления.ВзаиморасчетыКомпании.Обороты(, , , ) КАК ВзаиморасчетыКомпанииОстаткиИОбороты
	                      |ГДЕ
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.СуммаОборот > 0
	                      |	И ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка ССЫЛКА Документ.ЗаказНаряд
	                      |	И ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ВидРемонта.ТипРемонта = ЗНАЧЕНИЕ(Перечисление.ТипыРемонта.Платный)
	                      |	И ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	                      |	И НЕ ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.Контрагент.НашаФирма
	                      |	И НЕ ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ВидРемонта.ГарантияЗавода
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ДатаЗакрытия,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.СуммаДокумента,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.Контрагент,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ПодразделениеКомпании.Родитель,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ПодразделениеКомпании.Родитель.Наименование,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.ВидРемонта.ГарантияЗавода,
	                      |	ВзаиморасчетыКомпанииОстаткиИОбороты.Сделка.Контрагент.Наименование
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДилерскийЦентр_Наименование,
	                      |	Контрагент_Наименование");
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Дата)-25200);  
	
	//3600 * 7, то есть до 17 часов предыдущего дня
	
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Дата)); 
  			
	Результат = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДЦ = Результат.Скопировать();
	
	//ТаблицаДЦ.ВыбратьСтроку(ТаблицаДЦ.Количество());
  	
	ТаблицаДЦ.Свернуть("ДилерскийЦентр");
	
	//ТаблицаДЦ.ВыбратьСтроку(ТаблицаДЦ.Количество());
	
  	//=========================================================
	
	Для Каждого СтрокаДЦ Из ТаблицаДЦ Цикл 
		
  		ТабДокумент = Новый ТабличныйДокумент();
		Макет = ПолучитьМакет("Отчёт");
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакета.Параметры.Дата = Формат(Дата, "ДЛФ=ДД");
		ТабДокумент.Вывести(ОбластьМакета);
		ОбластьМакета = Макет.ПолучитьОбласть("СтрокаДЦ");
		ОбластьМакета.Параметры.ДилерскийЦентр = Строка(СтрокаДЦ.ДилерскийЦентр);
		ТабДокумент.Вывести(ОбластьМакета);

		МассивСтрок = Результат.НайтиСтроки(Новый Структура("ДилерскийЦентр", СтрокаДЦ.ДилерскийЦентр));				
		сч = 0;
  		
  		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			
  			ОбластьМакета = Макет.ПолучитьОбласть("Строка"); 
 			
			сч = сч + 1;
			
			ОбластьМакета.Параметры.Ном = Строка(сч);
			ОбластьМакета.Параметры.Долг = СтрокаТаблицы.Долг;  
			ОбластьМакета.Параметры.СуммаДокумента = СтрокаТаблицы.СуммаДокумента;  
			ОбластьМакета.Параметры.Сделка = СтрокаТаблицы.Сделка;  
		    ОбластьМакета.Параметры.КонтрагентЗН = СтрокаТаблицы.КонтрагентЗН;
 			
 			ТабДокумент.Вывести(ОбластьМакета);
 			 
		КонецЦикла;
		
		#Если Клиент Тогда
			Если сч > 0 Тогда
				ТабДокумент.ТолькоПросмотр=Истина;
				ТабДокумент.Показать();
			КонецЕсли;	
		#КонецЕсли
   		
		Если сч > 0 Тогда
			// сохранить в файл Excel и вернуть полное имя
			ИмяФайла = ПолучитьИмяВременногоФайла("xlsx"); // c:\Users\semenikhin_i\AppData\Local\Temp\v8_E508_74.xlsx
			Попытка
				ТабДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
			Исключение
				ЗаписьЖурналаРегистрации("Обработка.ЗакрытыеНоНеоплаченныеЗН", 
				        УровеньЖурналаРегистрации.Ошибка, , ,
				        "Ошибка при сохранении файла-отчета: " + ОписаниеОшибки()); 
				Продолжить;
			КонецПопытки;
		Иначе
			ИмяФайла = "";
		КонецЕсли;
		
		НовыйОтчет = ОтчетыПоДЦ.Добавить();
		НовыйОтчет.ДЦ = СтрокаДЦ.ДилерскийЦентр;
		НовыйОтчет.ИмяФайла = ИмяФайла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РассылкаОтчетаПоНеоплаченнымЗН(Параметры = Неопределено) Экспорт
	ТекущаяДата = ТекущаяДата();
	Если Параметры <> Неопределено И ТипЗнч(Параметры[0]) = Тип("ПеречислениеСсылка.ИсточникиРассылки") Тогда
		ИсточникРассылки = Параметры[0];
	Иначе
		ИсточникРассылки = Перечисления.ИсточникиРассылки.Неоплаченные;
	КонецЕсли;
	
	НаборДляРассылки = РегистрыСведений.РассылкаПочты.СоздатьНаборЗаписей();
	НаборДляРассылки.Отбор.ТипРассылки.Установить(Перечисления.ТипыРассылок.НеоплаченныеЗН);
	НаборДляРассылки.Отбор.ИсточникРассылки.Установить(Перечисления.ИсточникиРассылки.Неоплаченные);
	НаборДляРассылки.Прочитать();
	
 	НаборДляВсехДЦ = РегистрыСведений.РассылкаПочты.СоздатьНаборЗаписей();
	НаборДляВсехДЦ.Отбор.ТипРассылки.Установить(Перечисления.ТипыРассылок.ВсеНеоплаченныеЗН);
	НаборДляВсехДЦ.Отбор.ИсточникРассылки.Установить(Перечисления.ИсточникиРассылки.Неоплаченные);
	НаборДляВсехДЦ.Прочитать();
	
	Если НаборДляРассылки.Количество() + НаборДляВсехДЦ.Количество() = 0 Тогда 
 		ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
		        УровеньЖурналаРегистрации.Предупреждение, , ,
		        "Список адресатов рассылки пуст!"); 
 		Возврат;
	КонецЕсли;
	
	//обрФормироватьОтчет = Обработки.ФормированиеОтчетаУРВ.Создать();
	//обрФормироватьОтчет.Дата = ТекущаяДата;
	//обрФормироватьОтчет.СформироватьОтчет();
	
	// цикл по ТЧ ОтчетыПоДЦ
	
	Для Каждого СтрокаОтчет Из ОтчетыПоДЦ Цикл
 		ЭлПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();	 
 		Для Каждого Рассылка из НаборДляВсехДЦ Цикл
			АдресЭлПочты = киПолучитьПредставлениеКИ(Рассылка.Сотрудники, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
			Если ЗначениеЗаполнено(АдресЭлПочты) Тогда
 				СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
				СтрокаПолучатели.АдресЭлектроннойПочты = АдресЭлПочты;
				СтрокаПолучатели.Представление = АдресЭлПочты;
				СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
		        ЭлПисьмо.ПолучателиПредставление = ЭлПисьмо.ПолучателиПредставление +?(ЭлПисьмо.ПолучателиПредставление = "", АдресЭлПочты, ";" + АдресЭлПочты);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Рассылка из НаборДляРассылки Цикл
			// проверка на принадлежность текущему ДЦ
			//Бондаренко++ 20240607
			//Подразделение = Рассылка.Сотрудники.Подразделение;
			Подразделение = Рассылка.Подразделение; 
 			//Если ЗначениеЗаполнено(Рассылка.Подразделение) Тогда
			//	ДЦРассылка = Рассылка.Подразделение.ДилерскийЦентр;
			//Иначе
			//	ДЦРассылка = Справочники.ДилерскиеЦентры.ПустаяСсылка();
			//КонецЕсли;
 			//Если СтрокаОтчет.ДЦ.ДилерскийЦентр = Подразделение.ДилерскийЦентр Или СтрокаОтчет.ДЦ = ДЦРассылка Тогда
			Если СтрокаОтчет.ДЦ = Подразделение Тогда
			//Бондаренко-- 20240607
				АдресЭлПочты = киПолучитьПредставлениеКИ(Рассылка.Сотрудники, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
				Если ЗначениеЗаполнено(АдресЭлПочты) Тогда
					СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
					СтрокаПолучатели.АдресЭлектроннойПочты = АдресЭлПочты;
					СтрокаПолучатели.Представление = АдресЭлПочты;
					СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
			        ЭлПисьмо.ПолучателиПредставление = ЭлПисьмо.ПолучателиПредставление +?(ЭлПисьмо.ПолучателиПредставление = "", АдресЭлПочты, ";" + АдресЭлПочты);
				КонецЕсли;                                      
 			КонецЕсли;
		КонецЦикла;
		
		Если ЭлПисьмо.Получатели.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
			        УровеньЖурналаРегистрации.Предупреждение, , ,
			        "Ни у одного из адресатов рассылки не указан e-mail!"); 
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаОтчет.ИмяФайла) Тогда
			// добавить вложение
			Попытка
				ДвДанные = Новый ДвоичныеДанные(СтрокаОтчет.ИмяФайла);
				ВыбранныйФайл = Новый Файл(СтрокаОтчет.ИмяФайла);
				ФайлВложение = ЭлПисьмо.ПрикрепленныеФайлы.Добавить();
				ФайлВложение.Файл = Новый ХранилищеЗначения(ДвДанные);
				ФайлВложение.Размер = ВыбранныйФайл.Размер();
				ФайлВложение.Имя = Строка(СтрокаОтчет.ДЦ) + "_ОтчетПоНеоплаченнымЗН_" + Формат(ТекущаяДата, "ДЛФ=Д") + ВыбранныйФайл.Расширение;
				ЭлПисьмо.ЕстьВложения = Истина;
			Исключение
				ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
				        УровеньЖурналаРегистрации.Ошибка, , ,
				        "Ошибка при обработке файла-отчета: " + ОписаниеОшибки()); 
				Возврат;
			КонецПопытки;		
			// Удаление использованного файла-отчета
			Попытка
			    УдалитьФайлы(СтрокаОтчет.ИмяФайла);  
			Исключение
				ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
				        УровеньЖурналаРегистрации.Ошибка, , ,
				        "Ошибка при удалении файла-отчета: " + ОписаниеОшибки()); 
			КонецПопытки;
			ЭлПисьмо.ТекстПисьма= "Во вложении - отчёт по Неоплаченным ЗН для ДЦ """ + Строка(СтрокаОтчет.ДЦ) + """.";
		Иначе
			ЭлПисьмо.ТекстПисьма= "По ДЦ """ + Строка(СтрокаОтчет.ДЦ) + """ нарушений оплат ЗН нет.";
		КонецЕсли;
		
		ЭлПисьмо.Тема = "ДЦ """ + Строка(СтрокаОтчет.ДЦ) + """: отчет по Неоплаченным ЗН от " + Формат(ТекущаяДата, "ДЛФ=ДД");
		ЭлПисьмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.Альфа;	
		ЭлПисьмо.Организация =   ПараметрыСеанса.Пользователь.Организация;
		ЭлПисьмо.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;
		ЭлПисьмо.Автор   = ПараметрыСеанса.Пользователь;
		
		СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	    СтрокаСоединения = СтрЗаменить(СтрокаСоединения, ";", Символы.ПС);
		Если Найти(ВРег(СтрокаСоединения), "FILE=") = 1  Тогда
			// файловая
	        ИмяИБ = СтрПолучитьСтроку(СтрокаСоединения, 1);
	    Иначе
			// клиент-сервер
	        ИмяИБ = СтрПолучитьСтроку(СтрокаСоединения, 2);
		КонецЕсли;	
	    Если НЕ Пустаястрока(ИмяИБ) Тогда
			ИмяИБ = Сред(ИмяИБ, Найти(ИмяИБ, """") + 1);
		КонецЕсли;		
		ЭлПисьмо.ОтправительПредставление = "Альфа-Авто" + " (" + Лев(ИмяИБ, СтрДлина(ИмяИБ) - 1) + ") <1c@sokolmotors.ru>";
		
		ЭлПисьмо.ГруппаПисем = Справочники.ГруппыПисемЭлектроннойПочты.НайтиПоНаименованию("Исходящие");
		ЭлПисьмо.Важность = Перечисления.Важность.Средняя;
		ЭлПисьмо.ДатаОтправления = ТекущаяДата;
		ЭлПисьмо.Дата = ТекущаяДата;
		ЭлПисьмо.ХозОперация = Справочники.ХозОперации.ЭлектронноеПисьмо;
		ЭлПисьмо.ФорматТекста = Перечисления.ФорматТекста.ПростойТекст; 
		ЭлПисьмо.Записать();
		
		СтруктураРежимовОбмена = Новый Структура("Получить, Отправить", Ложь, Истина);
		СоединениеСПочтовымСервером = эпПодключитьсяКПочтовомуСерверу(ЭлПисьмо.УчетнаяЗапись, СтруктураРежимовОбмена);
		Если СоединениеСПочтовымСервером <> Неопределено Тогда
			Если эпОтправитьПисьмо(ЭлПисьмо.ЭтотОбъект, СоединениеСПочтовымСервером) Тогда
				эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
			Иначе
				эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
			КонецЕсли;	
		КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция ОпределитьВремяПеремещенияГрафик(ДЦ_уход,ДЦ_приход)
	
	ВремяНаПеремещение = 0;
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрУход КАК ДилерскийЦентрУход,
		|	ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрПриход КАК ДилерскийЦентрПриход,
		|	ВремяНаПеремещениеМеждуДЦ.Продолжительность КАК Продолжительность
		|ИЗ
		|	РегистрСведений.ВремяНаПеремещениеМеждуДЦ КАК ВремяНаПеремещениеМеждуДЦ
		|ГДЕ
		|	ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрУход = &ДилерскийЦентрУход
		|	И ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрПриход = &ДилерскийЦентрПриход";
	
	Запрос.УстановитьПараметр("ДилерскийЦентрУход", ДЦ_уход);
	Запрос.УстановитьПараметр("ДилерскийЦентрПриход", ДЦ_приход);
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВремяНаПеремещение =  ВыборкаДетальныеЗаписи.Продолжительность/60;
	КонецЦикла;
	
	Возврат ВремяНаПеремещение;
 
КонецФункции // ОпределитьВремяПеремещенияГрафик()

Функция ЧислоВЧасыМинуты(ЧислоВчасах)
	
    Стр = "";		
	
	Час = Цел(ЧислоВчасах);
	Мин = (ЧислоВчасах-Час)*60;
	
	Если Час > 0 Тогда
		Если Мин > 0 Тогда
			Стр = СокрЛП(Час)+" час. "+СокрЛП(Мин)+" мин.";	
		Иначе	
 			Стр = СокрЛП(Час)+" час.";	
		КонецЕсли;
	Иначе	
		Если Мин > 0 Тогда
			Стр = СокрЛП(Мин)+" мин.";	
		Иначе	
			Стр = " --- ";	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Стр;
	

КонецФункции // ЧислоВЧасыМинуты(ЧислоВчасах)
