Процедура ОбработкаНаСервере()Экспорт
	ОтправитьДанныеВЦентраль();	
	
КонецПроцедуры

Процедура ОтправитьДанныеВЦентраль() 
	УзелИзменений = Константы.Renault_УзелРегистрацииИзмененийДанныхАФМ.Получить();
	АдресWS	 = Константы.Renault_АдресWebСервисов.Получить();
	ЛогинWS	 = Константы.Renault_ЛогинВебСервиса.Получить();
	ПарольWS = Константы.Renault_ПарольВебСервиса.Получить();
	
	//удалим определение документа wsdl - его добавляем автоматически
	АдресWS = СтрЗаменить(АдресWS, "ws/dafm.ws?wsdl", "");
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/dafm.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/dafm", 
							   "ReciveAFM", "ReciveAFMSoap12", 6000);
	
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	ТаблицаКОтправке = ПолучитьТаблицуКОтправке(УзелИзменений);
	ТаблицаИзменений = ТаблицаКОтправке.Скопировать(,"Автомобиль");
	ТаблицаКОтправке.Колонки.Удалить("Автомобиль");

	ИдентификаторДилера = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();

	Сериализатор = Новый СериализаторXDTO(СервисФабрика);
	//Зап = Новый ЗаписьXML();
	//Зап.ОткрытьФайл("d:\fil\MyDataTest.xml");
	ТаблицаКОтправкеСериализованная = Сериализатор.ЗаписатьXDTO(ТаблицаКОтправке);
	
	Итог = ВебСервис.SendDateAFM(ТаблицаКОтправкеСериализованная);
	Если Итог = Истина Тогда
		ВебСервис.RegOperation(ИдентификаторДилера);
		Renault_Привилегированный.ОтменитьРегистрациюДополнительнойИнформациюПоАвтомобилям(ТаблицаИзменений);
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьТаблицуКОтправке(УзелИзменений)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	CRM_ДополнительнаяИнформацияПоАвтомобилям.ЖелаемаяДатаОтгрузки КАК DistrDate,
	                      |	CRM_ДополнительнаяИнформацияПоАвтомобилям.Автомобиль.VIN КАК VIN,
	                      |	CRM_СостояниеАвтомобилейПроизводителя_v2.BIR КАК BIR_Invoice,
	                      |	CRM_ДополнительнаяИнформацияПоАвтомобилямИзменения.Автомобиль
	                      |ИЗ
	                      |	РегистрСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.Изменения КАК CRM_ДополнительнаяИнформацияПоАвтомобилямИзменения
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям КАК CRM_ДополнительнаяИнформацияПоАвтомобилям
	                      |		ПО CRM_ДополнительнаяИнформацияПоАвтомобилямИзменения.Автомобиль = CRM_ДополнительнаяИнформацияПоАвтомобилям.Автомобиль
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	                      |		ПО CRM_ДополнительнаяИнформацияПоАвтомобилямИзменения.Автомобиль.VIN = CRM_СостояниеАвтомобилейПроизводителя_v2.VIN
	                      |ГДЕ
	                      |	CRM_ДополнительнаяИнформацияПоАвтомобилям.Автомобиль.VIN <> &ПустойВин
	                      |	И НЕ CRM_ДополнительнаяИнформацияПоАвтомобилям.Автомобиль.VIN ЕСТЬ NULL 
	                      |	И CRM_ДополнительнаяИнформацияПоАвтомобилямИзменения.Узел = &Узел");
	Запрос.УстановитьПараметр("Узел",УзелИзменений);
	Запрос.УстановитьПараметр("ПустойВин","");
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Возврат Таблица;
	
	
КонецФункции