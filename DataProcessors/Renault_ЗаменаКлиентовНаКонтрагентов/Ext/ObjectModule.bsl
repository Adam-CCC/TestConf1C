
Процедура ОбработкаНаСервере()Экспорт
	
	ЗаменитьКлиентовНаКонтрагентов();	
	
КонецПроцедуры

Процедура ЗаменитьКлиентовНаКонтрагентов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КлиентыНаЗамену.Клиент КАК Клиент,
	|	Контрагенты.Ссылка КАК Контрагент
	|ИЗ
	|	РегистрСведений.Renault_КлиентыНаЗамену КАК КлиентыНаЗамену
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Контрагенты КАК Контрагенты
	|ПО КлиентыНаЗамену.Клиент.Контрагент = Контрагенты.Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ИскомыйОбъект = Выборка.Клиент;
		ОбъектНаЗамену = Выборка.Контрагент;
		МассивСсылок = Новый Массив;
		МассивСсылок.Добавить(ИскомыйОбъект);
		ТабСсылок = НайтиПоСсылкам(МассивСсылок);
		ТранзакцияУдачна = Истина;
		Для Каждого ТекНайденныйОбъект ИЗ ТабСсылок Цикл
			
			Если ТекНайденныйОбъект.Метаданные.Имя = "Renault_КлиентыНаЗамену" Тогда
				Продолжить;
			КонецЕсли;
			
			//Если Метаданные.Подсистемы.DMS.Подсистемы.Renault_new.Состав.Содержит(ТекНайденныйОбъект.Метаданные) Тогда
			Если ТекНайденныйОбъект.Метаданные.Имя = "КонтактнаяИнформация"
				И Метаданные.РегистрыСведений.Содержит(ТекНайденныйОбъект.Метаданные) Тогда
				
				Запись = Неопределено;
				Итог = ПолучитьЗаписьИзРегистра(ТекНайденныйОбъект.Метаданные, ТекНайденныйОбъект.Данные, Запись);
				Если Итог тогда
					НоваяЗапись = РегистрыСведений[ТекНайденныйОбъект.Метаданные.Имя].СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(НоваяЗапись, Запись);
					ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.Метаданные.Ресурсы, НоваяЗапись, ИскомыйОбъект, ОбъектНаЗамену);
					ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.метаданные.Реквизиты, НоваяЗапись, ИскомыйОбъект, ОбъектНаЗамену);
					ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.метаданные.Измерения, НоваяЗапись, ИскомыйОбъект, ОбъектНаЗамену);
					Попытка 
						НоваяЗапись.Записать();
					Исключение
						ТранзакцияУдачна = Ложь;
						Сообщить(ОписаниеОшибки());
					Конецпопытки;
				КонецЕсли;
			ИначеЕсли ТекНайденныйОбъект.Метаданные.Имя = "БанковскиеСчета"  
					И Метаданные.Справочники.Содержит(ТекНайденныйОбъект.Метаданные) тогда
					Попытка 
						Запись = ТекНайденныйОбъект.Данные.ПолучитьОбъект();
						Запись.Заблокировать();
						Запись.Владелец = ОбъектНаЗамену;
						Запись.Записать();
						Запись.Разблокировать();
						
					Исключение
						ТранзакцияУдачна = Ложь;
						//Сообщить(ОписаниеОшибки());
					КонецПопытки;
					
			Иначе
					
				// регистр сведений
				Если Метаданные.РегистрыСведений.Содержит(ТекНайденныйОбъект.Метаданные) Тогда
					
					Запись = Неопределено;
					Итог = ПолучитьЗаписьИзРегистра(ТекНайденныйОбъект.Метаданные, ТекНайденныйОбъект.Данные, Запись);
					Если Итог тогда
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.Метаданные.Ресурсы, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.метаданные.Реквизиты, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.метаданные.Измерения, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						Попытка 
							Запись.Записать();
						Исключение
							ТранзакцияУдачна = Ложь;
							Сообщить(ОписаниеОшибки());
						Конецпопытки;
					КонецЕсли;
									
				//Документ
				ИначеЕсли Метаданные.Документы.Содержит(ТекНайденныйОбъект.Метаданные)  Тогда
					
					Попытка 
						Запись = ТекНайденныйОбъект.Данные.ПолучитьОбъект();
						Запись.Заблокировать();
						Запись.ОбменДанными.Загрузка = Истина;
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.Метаданные.Реквизиты, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						Для Каждого ТабЧасть из ТекНайденныйОбъект.Метаданные.ТабличныеЧасти цикл
							ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						КонецЦикла;
						Если Запись.Проведен Тогда
							Попытка
								Запись.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
							Исключение
								Запись.Записать(РежимЗаписиДокумента.Запись);
							КонецПопытки;
						Иначе
							Запись.Записать(РежимЗаписиДокумента.Запись);
						КонецЕсли;
						
						Запись.Записать();
						
						Запись.Разблокировать();
						
					Исключение
						ТранзакцияУдачна = Ложь;
						//Сообщить(ОписаниеОшибки());
					КонецПопытки;
					
					
				// справочник
				ИначеЕсли Метаданные.Справочники.Содержит(ТекНайденныйОбъект.Метаданные) тогда
					
					Попытка 
						Запись = ТекНайденныйОбъект.Данные.ПолучитьОбъект();
						Запись.Заблокировать();
						ПроверитьИЗаполнитьРеквизиты(ТекНайденныйОбъект.Метаданные.Реквизиты, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						Для Каждого ТабЧасть из ТекНайденныйОбъект.Метаданные.ТабличныеЧасти цикл
							ПроверитьИЗаполнитьРеквизитыТЧ(ТабЧасть, Запись, ИскомыйОбъект, ОбъектНаЗамену);
						КонецЦикла;
						Запись.Записать();
						
						Запись.Разблокировать();
						
					Исключение
						ТранзакцияУдачна = Ложь;
						//Сообщить(ОписаниеОшибки());
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТранзакцияУдачна Тогда
			Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
			Запись.Клиент = ИскомыйОбъект;
			Запись.Прочитать();
			Запись.Удалить();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//Получает запись регистра по ключу записи
Функция ПолучитьЗаписьИзРегистра(ДанныеПоРегистру, КлючЗаписи, Запись)
	
	Ответ = Ложь;
	Если ЗначениеЗаполнено(КлючЗаписи) И (Не КлючЗаписи.Пустой()) Тогда
		Если ПроверитьРегистрНаНезависимость(ДанныеПоРегистру) Тогда
			Запись = РегистрыСведений[ДанныеПоРегистру.Имя].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, КлючЗаписи);
			Попытка
				Запись.Прочитать();
				Ответ = Истина;
			Исключение
				Запись = Неопределено;
				Ответ = Ложь;
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

//Находит  изменяет все ссылки в реквизитах на ИскомыйОбъект в объекте запись на ОбъектНаЗамену ,КоллекцияРекв - метаданные записи
Процедура ПроверитьИЗаполнитьРеквизиты(КоллекцияРекв, Запись, ИскомыйОбъект, ОбъектНаЗамену)
	
	Для Каждого Реквизит Из КоллекцияРекв Цикл
		
		Если ТипЗнч(ИскомыйОбъект) = Тип("Массив") Тогда
			Для Каждого ИскОб из ИскомыйОбъект Цикл
				
				Если Реквизит.Тип.СодержитТип(ТипЗнч(ИскОб))Тогда
					Если Запись[Реквизит.Имя] = ИскОб Тогда
						Если Не(ОбъектНаЗамену = Неопределено) Тогда 
							Если Реквизит.Тип.СодержитТип(ТипЗнч(ОбъектНаЗамену.Ссылка))Тогда
								Запись[Реквизит.Имя] = Реквизит.Тип.ПривестиЗначение(ОбъектНаЗамену.Ссылка);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;				
			КонецЦикла;			
		Иначе
			Если Реквизит.Тип.СодержитТип(ТипЗнч(ИскомыйОбъект))Тогда
				Если Запись[Реквизит.Имя] = ИскомыйОбъект Тогда
					Если Не(ОбъектНаЗамену = Неопределено) Тогда 
						Если Реквизит.Тип.СодержитТип(ТипЗнч(ОбъектНаЗамену.Ссылка))Тогда
							Запись[Реквизит.Имя] = Реквизит.Тип.ПривестиЗначение(ОбъектНаЗамену.Ссылка);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//Находит  изменяет все ссылки в реквизитах Табличной части на ИскомыйОбъект в объекте запись на ОбъектНаЗамену ,
//МетаТЧ - метаданные табличной части
Процедура ПроверитьИЗаполнитьРеквизитыТЧ(МетаТЧ, Запись, ИскомыйОбъект, ОбъектНаЗамену)
	
	Для Каждого СтрТЧ из Запись[МетаТЧ.Имя] Цикл
		ПроверитьИЗаполнитьРеквизиты(МетаТЧ.Реквизиты, СтрТЧ, ИскомыйОбъект, ОбъектНаЗамену);
	КонецЦикла;
	
КонецПроцедуры

//Проверяет регистр является ли он Независимым
Функция ПроверитьРегистрНаНезависимость(МетДанные)
	
	Ответ = Ложь;
	Попытка
		Если (МетДанные.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый) Тогда
			Ответ = Истина;
		КонецЕсли;
	Исключение
		Ответ = Ложь;
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
	
КонецФункции
