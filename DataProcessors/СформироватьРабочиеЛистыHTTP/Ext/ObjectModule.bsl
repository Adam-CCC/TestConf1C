Процедура ЧтениеИзJSON(ИмяФайла)
	тЧтение = Новый ЧтениеJSON;
	//тЧтение.ОткрытьФайл("C:\test.json");
	тЧтение.ОткрытьФайл(ИмяФайла);
	Пока тЧтение.Прочитать() Цикл
		Если Отладка Тогда
			#Если Клиент Тогда
			Сообщить("Тип текущего элемента " + тЧтение.ТипТекущегоЗначения);
			#КонецЕсли
		КонецЕсли; 
		Если тЧтение.ТипТекущегоЗначения = ТипЗначенияJSON.ИмяСвойства Тогда
			Имя  = тЧтение.ТекущееЗначение;
			Если Отладка Тогда
				#Если Клиент Тогда 
				Сообщить("Имя = " + Имя );
				#КонецЕсли
			КонецЕсли; 
		КонецЕсли;
		Если тЧтение.ТипТекущегоЗначения = ТипЗначенияJSON.Булево ИЛИ
			тЧтение.ТипТекущегоЗначения = ТипЗначенияJSON.Строка ИЛИ 
			тЧтение.ТипТекущегоЗначения = ТипЗначенияJSON.Число ИЛИ 
			тЧтение.ТипТекущегоЗначения = ТипЗначенияJSON.Комментарий Тогда
			ТекущееЗначение = тЧтение.ТекущееЗначение;
			Если Отладка Тогда
				#Если Клиент Тогда 
				Сообщить("Значение = " + ТекущееЗначение);
				#КонецЕсли
			КонецЕсли; 
			Если Имя = "Id" Тогда
				Попытка
					Док.Записать();
					#Если Клиент Тогда 
					Сообщить("Записан документ "+Док+" ; с реквизитом "+Имя+" = "+ТекущееЗначение);
					#КонецЕсли
				Исключение
					//
				КонецПопытки; 
				Док = НайтиСоздатьРабочийЛист(ТекущееЗначение);
			КонецЕсли;
			Если НЕ обЗначениеНеЗаполнено(Док) Тогда
				
				Если Имя = "phone" Тогда
					Попытка
						Док.НомерТелефона         = СокрЛП(ТекущееЗначение);
						Док.ПредставлениеТелефона = СокрЛП(ТекущееЗначение);
					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
				
				//Бондаренко++ 20180312
  				Если Имя = "region" Тогда
					Попытка
						Док.ГдеПроживает         = СокрЛП(ТекущееЗначение);
 					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
				
				Если Имя = "company" Тогда
					Если СокрЛП(ТекущееЗначение)="1" Тогда
						Попытка
							Док.ЮридическоеЛицо = Истина;
 						Исключение
							//					
						КонецПопытки; 
					КонецЕсли;	
				КонецЕсли;
 				
				Если Имя = "price" Тогда
					Попытка
						Док.ЦенаПродавца = СокрЛП(ТекущееЗначение);
 					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
				
				Если Имя = "run" Тогда
					Попытка
						Док.ПробегТрейдИн = Дата(Число(СокрЛП(ТекущееЗначение)),1,1);
 					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
				
				Если Имя = "year" Тогда
					Попытка
						Док.ГодВыпускаТрейдИн = СокрЛП(ТекущееЗначение);
 					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
 				//Бондаренко-- 20180312
  				
				Если Имя = "marka" Тогда
					Марка = СокрЛП(ТекущееЗначение);
 				КонецЕсли; 
				
				Если Имя = "model" Тогда
					ТекНаименованиеМодели = Марка+" "+СокрЛП(ТекущееЗначение);
					Попытка
						Док.МодельТрейдИн = Справочники.Модели.НайтиПоНаименованию(ТекНаименованиеМодели);
						Док.КомментарийTradeIn = ТекНаименованиеМодели;
 					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
				
				Если Имя = "fio" Тогда
 					Попытка
						Док.Контрагент = СокрЛП(ТекущееЗначение);
  					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
 
				Если Имя = "url" Тогда
					Попытка
						Док.СсылкаНаОбъявление = СокрЛП(ТекущееЗначение);
 					Исключение
						//					
					КонецПопытки; 
				КонецЕсли;
				
				ИмяРус = Имя;
				ИмяРус = ЗаменитьИмяНаРус(Имя);
				
				Попытка
					Если НЕ обЗначениеНеЗаполнено(Док.Комментарий) Тогда
						Док.Комментарий = Док.Комментарий+" "+Символы.ВК+Символы.ПС+СокрЛП(ИмяРус)+": "+СокрЛП(ТекущееЗначение);
					Иначе	
						Док.Комментарий = СокрЛП(ИмяРус)+": "+СокрЛП(ТекущееЗначение);	
 					КонецЕсли;  
 				Исключение
					//					
				КонецПопытки; 
				
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Попытка
		Док.Записать();
	    #Если Клиент Тогда 
		Сообщить("Записан документ "+Док+" ; с реквизитом "+Имя+" = "+ТекущееЗначение);
		#КонецЕсли
	Исключение
		//
	КонецПопытки; 
	
	тЧтение.Закрыть(); 	   
	
КонецПроцедуры

