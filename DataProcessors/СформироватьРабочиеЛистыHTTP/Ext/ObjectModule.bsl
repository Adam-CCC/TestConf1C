Функция НайтиСоздатьРабочийЛист(Идент)
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочийЛист.Комментарий,
		|	РабочийЛист.Ссылка,
		|	РабочийЛист.Дата,
		|	РабочийЛист.ПометкаУдаления
		|ИЗ
		|	Документ.РабочийЛист КАК РабочийЛист
		|ГДЕ
		|	(РабочийЛист.Комментарий ПОДОБНО &ВыбКоммент
		|			ИЛИ РабочийЛист.ИдентификаторОбъявления = &ВыбИдентификаторОбъявления)
		|	И РабочийЛист.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|	И РабочийЛист.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ВыбКоммент","%%"+Идент+"%%");
	Запрос.УстановитьПараметр("ВыбИдентификаторОбъявления",Идент);
	Запрос.УстановитьПараметр("ДатаНач",НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаКон",КонецДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовДок = Документы.РабочийЛист.СоздатьДокумент();
	НовДок.Дата = ТекущаяДата();
	НовДок.Автор = ПараметрыСеанса.Пользователь;
	НовДок.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций;
	НовДок.КурсДокумента = 1.0;
	НовДок.КурсВалютыУпр = 1.0;
	НовДок.ДатаСоздания = ТекущаяДата();
	//НовДок.Комментарий = Идент;
	
	НовДок.ПредставлениеТелефона = "Новый";
	НовДок.НомерТелефона = "Новый";
	НовДок.ВидТелефона=Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный;
	НовДок.Контрагент = "Клиент интернета";
	НовДок.ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
	НовДок.Организация = ПараметрыСеанса.Организация;
	НовДок.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
	НовДок.РуководительМенеджера = ПараметрыСеанса.Пользователь.Сотрудник;
	НовДок.Пол = Перечисления.ПолФизическихЛиц.НеУказан;
	НовДок.ВидКонтакта=Перечисления.ВидыСобытий.ТелефонныйЗвонок;
	НовДок.Реклама=Справочники.ИсточникиИнформации.ОбъявлениеОПродажеАвтомобиляВИнтернет;
	НовДок.ВидОплаты=Перечисления.ВидыОплаты.Обмен;
	НовДок.Статус=Справочники.СтатусыРабочегоЛиста.Создан;
	НовДок.ТрейдИн=Истина;
	
	Попытка
		НовДок.ИдентификаторОбъявления = Идент;
  	Исключение
		//	
	КонецПопытки;
	
	НовСтрокаПользователи = НовДок.Пользователи.Добавить();
	НовСтрокаПользователи.Пользователь = ПараметрыСеанса.Пользователь;
 
	Попытка
		НовДок.Записать();
		#Если Клиент Тогда 
		Сообщить("Записан новый документ "+НовДок);
		#КонецЕсли
	Исключение
		#Если Клиент Тогда 
		Сообщить("ОШИБКА! Не удалось записать новый документ Рабочий лист с идентификатором "+Идент,СтатусСообщения.ОченьВажное);	
		#КонецЕсли
		НовДок = Документы.РабочийЛист.ПустаяСсылка();
 	КонецПопытки; 
	
	Возврат НовДок;
 
КонецФункции // НайтиСоздатьРабочийЛист()


