Функция ПолучитьСтруктуруLocation(Подразделение)
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Код = смсКоммуникатор.Транслитерация(Подразделение.Код);
		СтруктураВозврата = Новый Структура("id, name", Код, Подразделение.Наименование);
		Возврат СтруктураВозврата;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ВыгрузитьДанныеДляAutoru(Подразделение, ЭтоРегЗадание)
	Город = ПолучитьГородПодразделения(Подразделение);	
	Если НЕ ЗначениеЗаполнено(Город) Тогда
		ВыводСообщения = "Не удалось получить город подразделения " + Подразделение.Наименование + "!";
		ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ПолучитьГородПодразделения", УровеньЖурналаРегистрации.Ошибка, , ,ВыводСообщения);
		Возврат;
	КонецЕсли;
	
	СтруктураLocation = ПолучитьСтруктуруLocation(Подразделение);
	
	СписокФайлов.Очистить();
	ПолучитьДанныеПродажиАвто(Подразделение, Истина);
	ПолучитьДанныеПоРемонтуОбслуживаниюАвто(Подразделение, Истина);
	ПолучитьДанныеПоУстановкеДопОборудования(Подразделение, Истина);
	
	Если СписокФайлов.Количество() = 0 Тогда
		ВыводСообщения = "Отсутствуют файлы для отправки (" + Подразделение.Наименование + ")!";
		ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ВыполнитьОбработку", УровеньЖурналаРегистрации.Предупреждение, , ,ВыводСообщения);
		Возврат;
	КонецЕсли;
	
	ЭлПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();	 
	АдресЭлПочты = "sokolmotors-A29yH@partner-main.autoru.tv";
	//АдресЭлПочты = "semenikhin_i@sokolmotors.ru";
	СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
	СтрокаПолучатели.АдресЭлектроннойПочты = АдресЭлПочты;
	СтрокаПолучатели.Представление = АдресЭлПочты;
	СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
    ЭлПисьмо.ПолучателиПредставление = ЭлПисьмо.ПолучателиПредставление +?(ЭлПисьмо.ПолучателиПредставление = "", АдресЭлПочты, ";" + АдресЭлПочты);
	
	ТекущаяДата = ТекущаяДата();	
	ЭлПисьмо.Тема = "Данные по ГК Соколмоторс от " + Формат(ТекущаяДата, "ДЛФ=ДД");
	ЭлПисьмо.ТекстПисьма= "";
	ЭлПисьмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.Альфа;	
	ЭлПисьмо.Организация =   ПараметрыСеанса.Пользователь.Организация;
	ЭлПисьмо.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;
	ЭлПисьмо.Автор   = ПараметрыСеанса.Пользователь;

	// добавить вложения
	Для Каждого ЭлементСписка Из СписокФайлов Цикл
		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			Попытка
				ДвДанные = Новый ДвоичныеДанные(ЭлементСписка.Значение);
				ВыбранныйФайл = Новый Файл(ЭлементСписка.Значение);
				ФайлВложение = ЭлПисьмо.ПрикрепленныеФайлы.Добавить();
				ФайлВложение.Файл = Новый ХранилищеЗначения(ДвДанные);
				ФайлВложение.Размер = ВыбранныйФайл.Размер();
				ФайлВложение.Имя = ВыбранныйФайл.Имя;
				ЭлПисьмо.ЕстьВложения = Истина;
			Исключение
				ВыводСообщения = "Ошибка формирования e-mail (" + Подразделение.Наименование + "): " + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ВыполнитьОбработку", УровеньЖурналаРегистрации.Ошибка, , ,ВыводСообщения);
				#Если Клиент Тогда
				Сообщить(ВыводСообщения, СтатусСообщения.Внимание);
				#КонецЕсли
				Продолжить;
			КонецПопытки;		
			
		Иначе
			ВыводСообщения = "Ошибка формирования e-mail (" + Подразделение.Наименование + "): пустое имя файла!";
			ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ВыполнитьОбработку", УровеньЖурналаРегистрации.Ошибка, , ,ВыводСообщения);
			#Если Клиент Тогда
			Сообщить(ВыводСообщения, СтатусСообщения.Внимание);
			#КонецЕсли
			Продолжить;
		КонецЕсли;
	КонецЦикла;
		
	ЭлПисьмо.ОтправительПредставление = "ГК Соколмоторс <1c@sokolmotors.ru>";	
	ЭлПисьмо.ГруппаПисем = Справочники.ГруппыПисемЭлектроннойПочты.НайтиПоНаименованию("Исходящие");
	ЭлПисьмо.Важность = Перечисления.Важность.Средняя;
	ЭлПисьмо.ДатаОтправления = ТекущаяДата;
	ЭлПисьмо.Дата = ТекущаяДата;
	ЭлПисьмо.ХозОперация = Справочники.ХозОперации.ЭлектронноеПисьмо;
	ЭлПисьмо.ФорматТекста = Перечисления.ФорматТекста.ПростойТекст; 
	ЭлПисьмо.Записать();
	
	// отправить письмо
	Попытка	
		СтруктураРежимовОбмена = Новый Структура("Получить, Отправить", Ложь, Истина);
		СоединениеСПочтовымСервером = эпПодключитьсяКПочтовомуСерверу(ЭлПисьмо.УчетнаяЗапись, СтруктураРежимовОбмена);
		Если СоединениеСПочтовымСервером <> Неопределено Тогда
			эпОтправитьПисьмо(ЭлПисьмо, СоединениеСПочтовымСервером);
			эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
		КонецЕсли;

	Исключение
		Если СоединениеСПочтовымСервером <> Неопределено Тогда
			эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
		КонецЕсли;
		ВыводСообщения = "Ошибка при отправке по e-mail (" + Подразделение.Наименование + "): " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ВыполнитьОбработку", УровеньЖурналаРегистрации.Ошибка, , ,ВыводСообщения);
		#Если Клиент Тогда
		Сообщить(ВыводСообщения, СтатусСообщения.Внимание);
		#КонецЕсли
		Возврат;
	КонецПопытки;
	
	Для Каждого ИмяВремФайла Из СписокФайлов Цикл
		Файл = Новый Файл(ИмяВремФайла.Значение);
		Если Файл.Существует() Тогда
			Попытка
				УдалитьФайлы(ИмяВремФайла.Значение);
			Исключение
			КонецПопытки;		
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

