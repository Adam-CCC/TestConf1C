		ЗаписьJSON = Новый ЗаписьJSON;
		тПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ", Истина);
		ПутьКФайлу = КаталогВременныхФайлов() + ИмяФайла;
		ЗаписьJSON.ОткрытьФайл(ПутьКФайлу,"UTF-8",,тПараметрыJSON);
		ЗаписатьJSON(ЗаписьJSON, МассивСтруктур);
		ЗаписьJSON.Закрыть();
		СписокФайлов.Добавить(ПутьКФайлу,ИмяФайла);
		Сообщить("Создан файл с данными по ремонту и обслуживанию " + ПутьКФайлу);
	Исключение
		ВыводСообщения = "Ошибка создания файла JSON." + Символы.ПС + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ПолучитьДанныеПоРемонтуОбслуживаниюАвто", УровеньЖурналаРегистрации.Ошибка, , ,ВыводСообщения);
		Сообщить(ВыводСообщения);
	КонецПопытки;
		
КонецПроцедуры

Процедура ПолучитьДанныеПродажиАвто(Подразделение, ДляAutoru = Ложь)	
	МассивСтруктур = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль.VIN КАК ВИН,
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.Номер КАК НомерДокумента,
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.Дата КАК ДатаСобытия,
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.ПодразделениеКомпании КАК ПодразделениеКомпании,
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль,
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль.Модель.Марка КАК Марка,
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль.Модель.НаименованиеМодели_Аш_Промис КАК Модель_Аш_Промис,
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль.ВариантКомплектации КАК ВариантКомплектации,
	               |	ПРЕДСТАВЛЕНИЕ(РеализацияАвтомобилейАвтомобили.Автомобиль.Цвет) КАК Цвет,
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль.Привод КАК Привод,
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль.МощностьДвигателя КАК МощностьДвигателя,
	               |	ВЫБОР
	               |		КОГДА РеализацияАвтомобилейАвтомобили.Автомобиль.ОбъемДвигателя = 0
	               |			ТОГДА РеализацияАвтомобилейАвтомобили.Автомобиль.ВариантКомплектации.ТипДвигателя.ОбъемДвигателя
	               |		ИНАЧЕ РеализацияАвтомобилейАвтомобили.Автомобиль.ОбъемДвигателя
	               |	КОНЕЦ КАК ОбъемДвигателя,
	               |	ВЫБОР
	               |		КОГДА РеализацияАвтомобилейАвтомобили.Автомобиль.ТипКПП <> ЗНАЧЕНИЕ(Справочник.ТипыКПП.ПустаяСсылка)
	               |			ТОГДА ПРЕДСТАВЛЕНИЕ(РеализацияАвтомобилейАвтомобили.Автомобиль.ТипКПП)
	               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(РеализацияАвтомобилейАвтомобили.Автомобиль.ВариантКомплектации.ТипКПП)
	               |	КОНЕЦ КАК ТипКПП,
	               |	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(РеализацияАвтомобилейАвтомобили.Автомобиль.ТипДвигателя.ТипТоплива), ПРЕДСТАВЛЕНИЕ(РеализацияАвтомобилейАвтомобили.Автомобиль.ВариантКомплектации.ТипДвигателя.ТипТоплива)) КАК ТипДвигателя,
	               |	ВЫБОР
	               |		КОГДА РеализацияАвтомобилейАвтомобили.Автомобиль.ГодВыпуска <> ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА ГОД(РеализацияАвтомобилейАвтомобили.Автомобиль.ГодВыпуска)
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ КАК ГодВыпуска
	               |ИЗ
	               |	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
	               |ГДЕ
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.Проведен = ИСТИНА
	               |	И РеализацияАвтомобилейАвтомобили.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И РеализацияАвтомобилейАвтомобили.Ссылка.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделений)
	               |	И НЕ(РеализацияАвтомобилейАвтомобили.Автомобиль.VIN ПОДОБНО ""I%""
