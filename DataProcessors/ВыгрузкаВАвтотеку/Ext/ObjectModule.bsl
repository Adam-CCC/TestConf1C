	Исключение
		ВыводСообщения = "Ошибка создания файла JSON." + Символы.ПС + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ПолучитьДанныеПродажиАвто", УровеньЖурналаРегистрации.Ошибка, , ,ВыводСообщения);
