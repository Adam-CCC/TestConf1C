Процедура ПолучитьДанныеПоУстановкеДопОборудования(Подразделение, ДляAutoru = Ложь)	
	МассивСтруктур = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ГруппаПодразделений", Подразделение);
	Запрос.УстановитьПараметр("СостояниеЗакрыт", Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	//Бондаренко++ 20210524
	//Запрос.УстановитьПараметр("ВидРемонтаДопОборудование",Справочники.ВидыРемонта.ДополнительноеОборудование);
	СЗ_ВидовРемонта = Новый СписокЗначений;
	СЗ_ВидовРемонта.Добавить(Справочники.ВидыРемонта.ДополнительноеОборудование);
	СЗ_ВидовРемонта.Добавить(Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером);
	Запрос.УстановитьПараметр("ВидРемонтаДопОборудование",СЗ_ВидовРемонта);
	//Бондаренко-- 20210524
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказНаряд.Ссылка,
	               |	ЗаказНаряд.Дата КАК ДатаСобытия,
	               |	ЗаказНаряд.Номер КАК НомерДокумента,
	               |	ЗаказНаряд.Автомобиль,
	               |	ЗаказНаряд.Автомобиль.Модель.Марка КАК Марка,
	               |	ЗаказНаряд.Автомобиль.Модель.НаименованиеМодели_Аш_Промис КАК Модель_Аш_Промис,
	               |	ЗаказНаряд.Автомобиль.ВариантКомплектации КАК ВариантКомплектации,
	               |	ПРЕДСТАВЛЕНИЕ(ЗаказНаряд.Автомобиль.Цвет) КАК Цвет,
	               |	ЗаказНаряд.Автомобиль.Привод КАК Привод,
	               |	ЗаказНаряд.Автомобиль.МощностьДвигателя КАК МощностьДвигателя,
	               |	ВЫБОР
	               |		КОГДА ЗаказНаряд.Автомобиль.ОбъемДвигателя = 0
	               |			ТОГДА ЗаказНаряд.Автомобиль.ВариантКомплектации.ТипДвигателя.ОбъемДвигателя
	               |		ИНАЧЕ ЗаказНаряд.Автомобиль.ОбъемДвигателя
	               |	КОНЕЦ КАК ОбъемДвигателя,
	               |	ВЫБОР
	               |		КОГДА ЗаказНаряд.Автомобиль.ТипКПП <> ЗНАЧЕНИЕ(Справочник.ТипыКПП.ПустаяСсылка)
	               |			ТОГДА ПРЕДСТАВЛЕНИЕ(ЗаказНаряд.Автомобиль.ТипКПП)
	               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ЗаказНаряд.Автомобиль.ВариантКомплектации.ТипКПП)
	               |	КОНЕЦ КАК ТипКПП,
	               |	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(ЗаказНаряд.Автомобиль.ТипДвигателя.ТипТоплива), ПРЕДСТАВЛЕНИЕ(ЗаказНаряд.Автомобиль.ВариантКомплектации.ТипДвигателя.ТипТоплива)) КАК ТипДвигателя,
	               |	ВЫБОР
	               |		КОГДА ЗаказНаряд.Автомобиль.ГодВыпуска <> ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА ГОД(ЗаказНаряд.Автомобиль.ГодВыпуска)
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ КАК ГодВыпуска,
	               |	ЗаказНаряд.Автомобиль.VIN КАК ВИН,
	               |	ЗаказНаряд.Пробег,
	               |	ЗаказНаряд.ПричинаОбращения,
	               |	ЗаказНаряд.СервиснаяКампания.Наименование КАК СервиснаяКампания
	               |ИЗ
	               |	Документ.ЗаказНаряд КАК ЗаказНаряд
	               |ГДЕ
	               |	ЗаказНаряд.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ЗаказНаряд.ПодразделениеКомпании В ИЕРАРХИИ(&ГруппаПодразделений)
	               |	И ЗаказНаряд.Состояние = &СостояниеЗакрыт
	               |	И НЕ(ЗаказНаряд.Автомобиль.VIN ПОДОБНО ""I%""
	               |				ИЛИ ЗаказНаряд.Автомобиль.VIN ПОДОБНО ""O%""
	               |				ИЛИ ЗаказНаряд.Автомобиль.VIN ПОДОБНО ""Q%"")
	               |	И ЗаказНаряд.ВидРемонта В(&ВидРемонтаДопОборудование)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаказНаряд.Дата";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;	
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураВозврата = Новый Структура;
		
		ГодСобытия = Формат(ВыборкаДетальныеЗаписи.ДатаСобытия,"ДФ=yyyy");
		ИдСобытия = ГодСобытия + "_" + ВыборкаДетальныеЗаписи.НомерДокумента;
		СтруктураВозврата.Вставить("id",ИдСобытия);
		СтруктураВозврата.Вставить("et",3);
		СтруктураВозврата.Вставить("v",ВыборкаДетальныеЗаписи.ВИН);
		СтруктураВозврата.Вставить("dt",Формат(ВыборкаДетальныеЗаписи.ДатаСобытия,"ДФ=yyyy-MM-dd"));
		СтруктураВозврата.Вставить("er","Ростовская область");
		Если СтруктураLocation <> Неопределено Тогда
			СтруктураВозврата.Вставить("location",СтруктураLocation);
		КонецЕсли;

		СтруктураВозврата.Вставить("ec", Город);
		СтруктураВозврата.Вставить("m", ВыборкаДетальныеЗаписи.Пробег);
		
		////Далее все необязательные, передаем null  //В 1С null передавать нельзя , выдает ошибку
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Марка) Тогда
			СтруктураВозврата.Вставить("cbrand",ТРег(ВыборкаДетальныеЗаписи.Марка));
		Иначе
			СтруктураВозврата.Вставить("cbrand","");
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Модель_Аш_Промис) Тогда
			СтруктураВозврата.Вставить("cmodel",ВыборкаДетальныеЗаписи.Модель_Аш_Промис);
		Иначе
			СтруктураВозврата.Вставить("cmodel","");
		КонецЕсли;

		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВариантКомплектации) Тогда
			СтруктураВозврата.Вставить("cdetails",СокрЛП(ВыборкаДетальныеЗаписи.ВариантКомплектации));	
		КонецЕсли;

		//СтруктураВозврата.Вставить("cdescr",null);
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ГодВыпуска) Тогда
			СтруктураВозврата.Вставить("y",ВыборкаДетальныеЗаписи.ГодВыпуска);
		КонецЕсли;

		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОбъемДвигателя) Тогда
			ОбъемДвигателя = ВыборкаДетальныеЗаписи.ОбъемДвигателя;
			Если ВыборкаДетальныеЗаписи.ОбъемДвигателя < 10 Тогда
				ОбъемДвигателя = ОбъемДвигателя*1000;
			КонецЕсли;
			СтруктураВозврата.Вставить("cengs",ОбъемДвигателя);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.МощностьДвигателя) Тогда
			СтруктураВозврата.Вставить("chp",ВыборкаДетальныеЗаписи.МощностьДвигателя);  
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТипДвигателя) Тогда
			ТипДвигателя = "";
			Если ВыборкаДетальныеЗаписи.ТипДвигателя = "Бензин" Тогда
				ТипДвигателя = "petrol";
			ИначеЕсли ВыборкаДетальныеЗаписи.ТипДвигателя = "Дизельное топливо" Тогда
				ТипДвигателя = "diesel";
			КонецЕсли;
			Если ЗначениеЗаполнено(ТипДвигателя) Тогда
				СтруктураВозврата.Вставить("cengt",ТипДвигателя);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Цвет) Тогда
		    СтруктураВозврата.Вставить("ccolor",ТРег(ВыборкаДетальныеЗаписи.Цвет));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Привод) Тогда
			Если ВыборкаДетальныеЗаписи.Привод = Перечисления.Привод.Передний Тогда
				СтруктураВозврата.Вставить("cdrive","front");
			ИначеЕсли ВыборкаДетальныеЗаписи.Привод = Перечисления.Привод.Полный Тогда
				СтруктураВозврата.Вставить("cdrive","full");
			ИначеЕсли ВыборкаДетальныеЗаписи.Привод = Перечисления.Привод.Задний Тогда
				СтруктураВозврата.Вставить("cdrive","back");
			КонецЕсли;
		КонецЕсли;
		//СтруктураВозврата.Вставить("csw",null);
		//СтруктураВозврата.Вставить("clnttp",null);  //НЕ ПЕРЕДАВАТЬ!
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТипКПП) Тогда
			Если ВыборкаДетальныеЗаписи.ТипКПП = "Автомат" Тогда
				СтруктураВозврата.Вставить("ctrans","automatic");
			ИначеЕсли  ВыборкаДетальныеЗаписи.ТипКПП = "Механика" Тогда
				СтруктураВозврата.Вставить("ctrans","manual");
            ИначеЕсли  ВыборкаДетальныеЗаписи.ТипКПП = "Робот" Тогда
				СтруктураВозврата.Вставить("ctrans","robotic");
			ИначеЕсли  ВыборкаДетальныеЗаписи.ТипКПП = "Вариатор" Тогда
				СтруктураВозврата.Вставить("ctrans","variator");
			КонецЕсли;
		КонецЕсли;

		//СтруктураВозврата.Вставить("amnt",null); //НЕ ПЕРЕДАВАТЬ!
	
		ОписаниеРабот = "";
		
		Для Каждого стр Из ВыборкаДетальныеЗаписи.Ссылка.Работы Цикл
			ВыполненнаяРабота = стр.Работа.НаименованиеПолное;
			ОписаниеРабот = ОписаниеРабот + ВыполненнаяРабота + "; ";
		КонецЦикла;
		
		СтруктураВозврата.Вставить("det",ОписаниеРабот);
		
		МассивСтруктур.Добавить(СтруктураВозврата);
		
	КонецЦикла;
	
	ВремяФормирования = Формат(ТекущаяДата(),"ДФ=ггггММдд-ЧЧммсс");
	ПодразделениеКод = смсКоммуникатор.Транслитерация(Подразделение.Код);
	Если ДляAutoru Тогда
		ИмяФайла = ПодразделениеКод + "_3_" + ВремяФормирования + ".json";
	Иначе
		ИмяФайла = "SOKOLMOTORS" + "_" + ПодразделениеКод + "_3_" + ВремяФормирования + ".json";
	КонецЕсли;
	
	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		тПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ", Истина);
		ПутьКФайлу = КаталогВременныхФайлов() + ИмяФайла;
		ЗаписьJSON.ОткрытьФайл(ПутьКФайлу,"UTF-8",,тПараметрыJSON);
		ЗаписатьJSON(ЗаписьJSON, МассивСтруктур);
		ЗаписьJSON.Закрыть();
		СписокФайлов.Добавить(ПутьКФайлу,ИмяФайла);
		Сообщить("Создан файл с данными по установке доп.оборудования " + ПутьКФайлу);

	Исключение
		ВыводСообщения = "Ошибка создания файла JSON." + Символы.ПС + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВыгрузкаВАвтотеку.ПолучитьДанныеПоУстановкеДопОборудования", УровеньЖурналаРегистрации.Ошибка, , ,ВыводСообщения);
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

