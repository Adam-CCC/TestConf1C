
Функция СформироватьЛист(ДатаНачала, ДатаОкончания) Экспорт
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	//////////////////////////////////////////////
	//// Установка всех параметров на запрос /////
	//////////////////////////////////////////////
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("СписокПодразделений", ПодразделенияДляАнализа.ВыгрузитьКолонку("ПодразделениеКомпании"));
	Запрос.УстановитьПараметр("ГруппаАвто", ГруппаАвтомобилей);
	
	СписокВидовРемонтаКоммерческие = Новый СписокЗначений();
	ВидРемонта = Справочники.ВидыРемонта.НайтиПоНаименованию("Коммерческий ремонт", истина);
	Если ВидРемонта = Неопределено Тогда
		Сообщить("Не найден вид ремонта с наименованием Коммерческий ремонт");
	Иначе
		СписокВидовРемонтаКоммерческие.Добавить(ВидРемонта);
	КонецЕсли;
	ВидРемонта = Справочники.ВидыРемонта.НайтиПоНаименованию("Техническое обслуживание", истина);
	Если ВидРемонта = Неопределено Тогда
		Сообщить("Не найден вид ремонта с наименованием Техническое обслуживание");
	Иначе
		СписокВидовРемонтаКоммерческие.Добавить(ВидРемонта);
	КонецЕсли;
	Запрос.УстановитьПараметр("СписокВидовРемонтаКоммерческие", СписокВидовРемонтаКоммерческие);
	
	
	СписокВидовРемонтаГарантийные = Новый СписокЗначений;
	ЗапросГарантийныхВидовРемонта = Новый Запрос();
	ЗапросГарантийныхВидовРемонта.Текст = "ВЫБРАТЬ
	                                      |	ВидыРемонта.Ссылка КАК ВидРемонта
	                                      |ИЗ
	                                      |	Справочник.ВидыРемонта КАК ВидыРемонта
	                                      |ГДЕ
	                                      |	ВидыРемонта.ГарантияЗавода";
	СписокВидовРемонтаГарантийные.ЗагрузитьЗначения(ЗапросГарантийныхВидовРемонта.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидРемонта"));
	Запрос.УстановитьПараметр("СписокВидовРемонтаГарантийные", СписокВидовРемонтаГарантийные);
	
	
	СписокВидовРемонтаДопы = Новый СписокЗначений;
	//ВидРемонта = Справочники.ВидыРемонта.НайтиПоНаименованию("Дополнительное оборудование", истина);
	//Если ВидРемонта = Неопределено Тогда
	//	Сообщить("Не найден вид ремонта с наименованием Дополнительное оборудование");
	//Иначе
	//	СписокВидовРемонтаДопы.Добавить(ВидРемонта);
	//КонецЕсли;
	СписокВидовРемонтаДопы.Добавить(Справочники.ВидыРемонта.ДополнительноеОборудование);
	СписокВидовРемонтаДопы.Добавить(Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером);
 	Запрос.УстановитьПараметр("СписокВидовРемонтаДопы", СписокВидовРемонтаДопы);
	
	СписокВидовРемонтаМалярноКузовной = Новый СписокЗначений();
	//ВидРемонта = Справочники.ВидыРемонта.НайтиПоНаименованию("Малярно-Кузовной", истина);
	//Если ВидРемонта = Неопределено Тогда
	//	Сообщить("Не найден вид ремонта с наименованием Малярно-Кузовной");
	//Иначе
	//	СписокВидовРемонтаМалярноКузовной.Добавить(ВидРемонта);
	//КонецЕсли; 
	СписокВидовРемонтаДопы.Добавить(Справочники.ВидыРемонта.КузовнойКоммерческий);
	СписокВидовРемонтаДопы.Добавить(Справочники.ВидыРемонта.КузовнойРемонт);
	Запрос.УстановитьПараметр("СписокВидовРемонтаМалярноКузовной", СписокВидовРемонтаМалярноКузовной);
	
	Запрос.УстановитьПараметр("ГруппаГСМ", ГруппаГСМ);
	
	Запрос.УстановитьПараметр("СписокПРоизводителей", ПроизводительЗЧ);
	
	Запрос.УстановитьПараметр("Авторабота", Справочники.Номенклатура.Авторабота);	
	
	Запрос.УстановитьПараметр("СписокДопы", ГруппаАксессуары);	
	//////////////////////////////////////////////
	////////////  Текст запросов  ////////////////
	//////////////////////////////////////////////
	
	//временная таблица выработка з/н
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВыработкаСотрудниковОбороты.КоличествоОборот КАК Количество,
	               |	ВыработкаСотрудниковОбороты.КоличествоНормочасовОборот КАК КоличествоНормочасов,
	               |	ВыработкаСотрудниковОбороты.ВидРемонта,
	               |	ВыработкаСотрудниковОбороты.Работа,
	               |	ВыработкаСотрудниковОбороты.ДокументПродажи,
	               |	ВыработкаСотрудниковОбороты.Автомобиль,
	               |	РАЗНОСТЬДАТ(ВыработкаСотрудниковОбороты.Автомобиль.ГодВыпуска, &ДатаНачала, ГОД) + 1 КАК ВозрастАвто,
	               |	ВыработкаСотрудниковОбороты.СуммаУпрОборот КАК Сумма
	               |ПОМЕСТИТЬ ВыработкаЗаказНаряд
	               |ИЗ
	               |	РегистрНакопления.ВыработкаСотрудников.Обороты(
	               |			&ДатаНачала,
	               |			&ДатаОкончания,
	               |			,
	               |			ДокументПродажи.ПодразделениеКомпании В ИЕРАРХИИ (&СписокПодразделений)
	               |				И Автомобиль.Модель В ИЕРАРХИИ (&ГруппаАвто)
	               |				И ВидРемонта В (&СписокВидовРемонтаКоммерческие, &СписокВидовРемонтаГарантийные, &СписокВидовРемонтаДопы)) КАК ВыработкаСотрудниковОбороты";
	Запрос.Выполнить();
	
	//Выборка продажи зч по ЗН
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ПродажиОбороты.ДокументПродажи.ВидРемонта В (&СписокВидовРемонтаКоммерческие)
	               |				И НЕ ПродажиОбороты.Номенклатура В ИЕРАРХИИ (&ГруппаГСМ)
	               |			ТОГДА ПродажиОбороты.СуммаОборот
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СервисЗапчастиКоммерческие,
	               |	ВЫБОР
	               |		КОГДА ПродажиОбороты.ДокументПродажи.ВидРемонта В (&СписокВидовРемонтаГарантийные)
	               |				И НЕ ПродажиОбороты.Номенклатура В ИЕРАРХИИ (&ГруппаГСМ)
	               |			ТОГДА ПродажиОбороты.СуммаОборот
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СервисЗапчастиГарантийные,
	               |	ВЫБОР
	               |		КОГДА ПродажиОбороты.ДокументПродажи.ВидРемонта В (&СписокВидовРемонтаДопы)
	               |				И НЕ ПродажиОбороты.Номенклатура В ИЕРАРХИИ (&ГруппаГСМ)
	               |			ТОГДА ПродажиОбороты.СуммаОборот
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СервисЗапчастиАксессуары,
	               |	ПродажиОбороты.СуммаОборот,
	               |	ВЫБОР
	               |		КОГДА ПродажиОбороты.Номенклатура В ИЕРАРХИИ (&ГруппаГСМ)
	               |			ТОГДА ПродажиОбороты.СуммаОборот
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СервисЗапчастиГСМ
	               |ПОМЕСТИТЬ ПродажиПоВидамРемонта
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(
	               |			&ДатаНачала,
	               |			&ДатаОкончания,
	               |			,
	               |			ДокументПродажи.Автомобиль.Модель В ИЕРАРХИИ (&ГруппаАвто)
	               |				И ПодразделениеКомпании В ИЕРАРХИИ (&СписокПодразделений)
	               |				И ДокументПРодажи ССЫЛКА Документ.ЗаказНаряд
	               |				И (ДокументПродажи.ВидРемонта В (&СписокВидовРемонтаКоммерческие, &СписокВидовРемонтаГарантийные, &СписокВидовРемонтаДопы)
	               |					ИЛИ Номенклатура В ИЕРАРХИИ (&ГруппаГСМ))
	               |				И НЕ Номенклатура = &Авторабота) КАК ПродажиОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ПродажиПоВидамРемонта.СервисЗапчастиКоммерческие) КАК ЗапчастиКлиент,
	               |	СУММА(ПродажиПоВидамРемонта.СервисЗапчастиГарантийные) КАК ЗапчастиГарантия,
	               |	СУММА(ПродажиПоВидамРемонта.СервисЗапчастиАксессуары) КАК ЗапчастиАксессуары,
	               |	СУММА(ПродажиПоВидамРемонта.СервисЗапчастиГСМ) КАК ЗапчастиГСМ,
	               |	СУММА(ПродажиПоВидамРемонта.СуммаОборот) КАК ЗапчастиВсего
	               |ИЗ
	               |	ПродажиПоВидамРемонта КАК ПродажиПоВидамРемонта";
	ВыборкаПродажиЗЧПоЗН = Запрос.Выполнить().Выбрать();
	
	//Выборка работы и НЧ по ЗН
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаКоммерческие)
	               |			ТОГДА ВыработкаЗаказНаряд.Сумма
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК РаботыКлиент,
	               |	ВЫБОР
	               |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаГарантийные)
	               |			ТОГДА ВыработкаЗаказНаряд.Сумма
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК РаботыГарантия,
	               |	ВЫБОР
	               |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаДопы)
	               |			ТОГДА ВыработкаЗаказНаряд.Сумма
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК РаботыАксессуары,
	               |	ВыработкаЗаказНаряд.Сумма КАК РаботыВсего,
	               |	ВЫБОР
	               |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаКоммерческие)
	               |			ТОГДА ВыработкаЗаказНаряд.КоличествоНормочасов
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НормочасыКлиент,
	               |	ВЫБОР
	               |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаГарантийные)
	               |			ТОГДА ВыработкаЗаказНаряд.КоличествоНормочасов
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НормочасыГарантия,
	               |	ВЫБОР
	               |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаДопы)
	               |			ТОГДА ВыработкаЗаказНаряд.КоличествоНормочасов
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НормочасыАксессуары,
	               |	ВыработкаЗаказНаряд.КоличествоНормочасов КАК НормочасыВсего
	               |ПОМЕСТИТЬ РаботыИНЧПоВидамРемонта
	               |ИЗ
	               |	ВыработкаЗаказНаряд КАК ВыработкаЗаказНаряд
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(РаботыИНЧПоВидамРемонта.РаботыКлиент) КАК РаботыКлиент,
	               |	СУММА(РаботыИНЧПоВидамРемонта.РаботыГарантия) КАК РаботыГарантия,
	               |	СУММА(РаботыИНЧПоВидамРемонта.РаботыАксессуары) КАК РаботыАксессуары,
	               |	СУММА(РаботыИНЧПоВидамРемонта.РаботыВсего) КАК РаботыВсего,
	               |	СУММА(РаботыИНЧПоВидамРемонта.НормочасыКлиент) КАК НормочасыКлиент,
	               |	СУММА(РаботыИНЧПоВидамРемонта.НормочасыГарантия) КАК НормочасыГарантия,
	               |	СУММА(РаботыИНЧПоВидамРемонта.НормочасыАксессуары) КАК НормочасыАксессуары,
	               |	СУММА(РаботыИНЧПоВидамРемонта.НормочасыВсего) КАК НормочасыВсего
	               |ИЗ
	               |	РаботыИНЧПоВидамРемонта КАК РаботыИНЧПоВидамРемонта";
	ВыборкаРаботыИНЧПоЗН = Запрос.Выполнить().Выбрать();
	
	//Выборка по машинозаездам
	//Запрос.Текст = "ВЫБРАТЬ
	//			   |	ВЫБОР
	//			   |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В ИЕРАРХИИ (&СписокВидовРемонтаКоммерческие)
	//			   |			ТОГДА ВыработкаЗаказНаряд.ДокументПродажи
	//			   |		ИНАЧЕ NULL
	//			   |	КОНЕЦ КАК ДокументыПродажиКлиентские,
	//			   |	ВЫБОР
	//			   |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В ИЕРАРХИИ (&СписокВидовРемонтаГарантийные)
	//			   |			ТОГДА ВыработкаЗаказНаряд.ДокументПродажи
	//			   |		ИНАЧЕ NULL
	//			   |	КОНЕЦ КАК ДокументыПродажиГарантия,
	//			   |	ВЫБОР
	//			   |		КОГДА ВыработкаЗаказНаряд.ВидРемонта В ИЕРАРХИИ (&СписокВидовРемонтаДопы)
	//			   |			ТОГДА ВыработкаЗаказНаряд.ДокументПродажи
	//			   |		ИНАЧЕ NULL
	//			   |	КОНЕЦ КАК ДокументыПродажиДопы,
	//			   |	ВыработкаЗаказНаряд.ДокументПродажи КАК ДокументПродажиВсе
	//			   |ПОМЕСТИТЬ ДокументыПродажиПоВидамРемонта
	//			   |ИЗ
	//			   |	ВыработкаЗаказНаряд КАК ВыработкаЗаказНаряд
	//			   |;
	//			   |
	//			   |////////////////////////////////////////////////////////////////////////////////
	//			   |ВЫБРАТЬ
	//			   |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыПродажиПоВидамРемонта.ДокументыПродажиКлиентские) КАК МашинозаездыКлиент,
	//			   |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыПродажиПоВидамРемонта.ДокументыПродажиГарантия) КАК МашинозаездыГарантия,
	//			   |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыПродажиПоВидамРемонта.ДокументыПродажиДопы) КАК МашинозаездыАксессуары,
	//			   |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыПродажиПоВидамРемонта.ДокументПродажиВсе) КАК МашинозаездыВсего
	//			   |ИЗ
	//			   |	ДокументыПродажиПоВидамРемонта КАК ДокументыПродажиПоВидамРемонта";
				   
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаКоммерческие)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК МашинозаездыКлиент,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаГарантийные)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК МашинозаездыГарантия,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаДопы)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК МашинозаездыАксессуары,
	               |	СУММА(ВЫБОР
	               |			КОГДА НЕ ЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаМалярноКузовной)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК МашинозаездыВсего,
	               |	СУММА(ВЫБОР
	               |			КОГДА ЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаМалярноКузовной)
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КузовнойМашинозаездыСтраховой
	               |ИЗ
	               |	Документ.ЗаказНаряд КАК ЗаказНаряд
	               |ГДЕ
	               |	ЗаказНаряд.Проведен
	               |	И ЗаказНаряд.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	               |	И ЗаказНаряд.ВидРемонта В (&СписокВидовРемонтаКоммерческие, &СписокВидовРемонтаГарантийные, &СписокВидовРемонтаДопы, &СписокВидовРемонтаМалярноКузовной)
	               |	И ЗаказНаряд.ПодразделениеКомпании В ИЕРАРХИИ(&СписокПодразделений)
	               |	И ЗаказНаряд.Автомобиль.Модель В ИЕРАРХИИ(&ГруппаАвто)";
	ВыборкаПоМашинозаездам = Запрос.Выполнить().Выбрать();
	
	//Выборка по запасным частям проданным через магазин
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.СуммаОборот КАК ПродажиЗЧМагазин
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(
	               |			&ДатаНачала,
	               |			&ДатаОкончания,
	               |			,
	               |			ПодразделениеКомпании В ИЕРАРХИИ (&СписокПодразделений)
	               |				И ДокументПРодажи ССЫЛКА Документ.РеализацияТоваров
	               |				И Номенклатура.Производитель В (&СписокПРоизводителей)
	               |				И НЕ Номенклатура = &Авторабота) КАК ПродажиОбороты";
	ВыборкаЗЧМагазин = Запрос.Выполнить().Выбрать();
	
	//Выборка по остаткам и оборотам зч на складах
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПартииТоваровКомпанииОстаткиИОбороты.Номенклатура,
	               |	ВЫБОР
	               |		КОГДА НЕ ПартииТоваровКомпанииОстаткиИОбороты.Номенклатура В ИЕРАРХИИ (&СписокДопы)
	               |			ТОГДА ПартииТоваровКомпанииОстаткиИОбороты.СуммаНачальныйОстаток
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НачальныйОстатокЗЧ,
	               |	ВЫБОР
	               |		КОГДА НЕ ПартииТоваровКомпанииОстаткиИОбороты.Номенклатура В ИЕРАРХИИ (&СписокДопы)
	               |			ТОГДА ПартииТоваровКомпанииОстаткиИОбороты.СуммаРасход
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОборотыЗЧ,
	               |	ВЫБОР
	               |		КОГДА ПартииТоваровКомпанииОстаткиИОбороты.Номенклатура В ИЕРАРХИИ (&СписокДопы)
	               |			ТОГДА ПартииТоваровКомпанииОстаткиИОбороты.СуммаНачальныйОстаток
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК НачальныйОстатокДопы,
	               |	ВЫБОР
	               |		КОГДА ПартииТоваровКомпанииОстаткиИОбороты.Номенклатура В ИЕРАРХИИ (&СписокДопы)
	               |			ТОГДА ПартииТоваровКомпанииОстаткиИОбороты.СуммаРасход
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ОборотыДопы
	               |ПОМЕСТИТЬ ВсеОстаткиИОборотыЗЧ
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровКомпании.ОстаткиИОбороты(
	               |			&ДатаНачала,
	               |			&ДатаОкончания,
	               |			,
	               |			,
	               |			СкладКомпании.Подразделение В ИЕРАРХИИ (&СписокПодразделений)
	               |				И Номенклатура.Производитель В (&СписокПроизводителей)
	               |				И НЕ Номенклатура В ИЕРАРХИИ (&ГруппаГСМ)) КАК ПартииТоваровКомпанииОстаткиИОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВсеОстаткиИОборотыЗЧ.НачальныйОстатокЗЧ) КАК НачальныйОстатокЗЧ,
	               |	СУММА(ВсеОстаткиИОборотыЗЧ.ОборотыЗЧ) КАК ОборотыЗЧ,
	               |	СУММА(ВсеОстаткиИОборотыЗЧ.НачальныйОстатокДопы) КАК НачальныйОстатокДопы,
	               |	СУММА(ВсеОстаткиИОборотыЗЧ.ОборотыДопы) КАК ОборотыДопы
	               |ИЗ
	               |	ВсеОстаткиИОборотыЗЧ КАК ВсеОстаткиИОборотыЗЧ";
	ВыборкаОстаткиИОборотыЗЧ = Запрос.Выполнить().Выбрать();
	
	//Статистика по автомобилям
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПродажиОбороты.ДокументПродажи.Автомобиль,
	               |	РАЗНОСТЬДАТ(ПродажиОбороты.ДокументПродажи.Автомобиль.ГодВыпуска, &ДатаНачала, ГОД) КАК ВозрастАвто,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиОбороты.ДокументПродажи) КАК КоличествоПосещений
	               |ПОМЕСТИТЬ УникальныеАвтомобили
	               |ИЗ
	               |	РегистрНакопления.Продажи.Обороты(
	               |			ДОБАВИТЬКДАТЕ(&ДатаОкончания, ДЕНЬ, -360),
	               |			&ДатаОкончания,
	               |			,
	               |			ДокументПродажи ССЫЛКА Документ.ЗаказНаряд
	               |				И ДокументПродажи.Автомобиль <> ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
	               |				И ДокументПродажи.Автомобиль.Модель В ИЕРАРХИИ (&ГруппаАвто)
	               |				И ПодразделениеКомпании В ИЕРАРХИИ (&СписокПодразделений)) КАК ПродажиОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПродажиОбороты.ДокументПродажи.Автомобиль,
	               |	РАЗНОСТЬДАТ(ПродажиОбороты.ДокументПродажи.Автомобиль.ГодВыпуска, &ДатаНачала, ГОД)
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПродажиОбороты.ДокументПродажи) >= 2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(ВЫБОР
	               |			КОГДА УникальныеАвтомобили.ВозрастАвто <= 3
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КоличествоАвтоСегмент1,
	               |	СУММА(ВЫБОР
	               |			КОГДА УникальныеАвтомобили.ВозрастАвто > 3
	               |					И УникальныеАвтомобили.ВозрастАвто <= 7
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КоличествоАвтоСегмент2,
	               |	СУММА(ВЫБОР
	               |			КОГДА УникальныеАвтомобили.ВозрастАвто > 7
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КоличествоАвтоСегмент3,
	               |	СУММА(1) КАК КоличествоАвтоВсего
	               |ИЗ
	               |	УникальныеАвтомобили КАК УникальныеАвтомобили";
	ВыборкаКоличествоАвто = Запрос.Выполнить().Выбрать();
	
	//Вывод данных в отчет
	
	МакетОТчета = ПолучитьМакет("Макет");
	ОбластьСтраницы = МакетОТчета.ПолучитьОбласть("ОбластьСтраницы");
	ОбластьСтраницы.Параметры.Месяц = Формат(ДатаНачала, "ДФ='MMMM yyyy'");
	
	Если ВыборкаРаботыИНЧПоЗН.Следующий() Тогда
		ОбластьСтраницы.Параметры.Заполнить(ВыборкаРаботыИНЧПоЗН);
	КонецЕсли;
	
	Если ВыборкаПродажиЗЧПоЗН.Следующий() Тогда
		ОбластьСтраницы.Параметры.Заполнить(ВыборкаПродажиЗЧПоЗН);
	КонецЕсли;
	
	Если ВыборкаПоМашинозаездам.Следующий() Тогда
		ОбластьСтраницы.Параметры.Заполнить(ВыборкаПоМашинозаездам);
	КонецЕсли;
	
	Если ВыборкаЗЧМагазин.Следующий() Тогда
		ОбластьСтраницы.Параметры.Заполнить(ВыборкаЗЧМагазин);
	КонецЕсли;
	Если ДатаНачала < ТекущаяДата() Тогда
		Если ВыборкаОстаткиИОборотыЗЧ.Следующий() Тогда
			ОбластьСтраницы.Параметры.Заполнить(ВыборкаОстаткиИОборотыЗЧ);
		КонецЕсли;
		
		Если ВыборкаКоличествоАвто.Следующий() Тогда
			ОбластьСтраницы.Параметры.Заполнить(ВыборкаКоличествоАвто);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОбластьСтраницы;
КонецФункции
	
	
	
	
	