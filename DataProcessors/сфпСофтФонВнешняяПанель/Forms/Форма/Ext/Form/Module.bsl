&НаКлиенте
// Процедура - обработчик оповещения для создания события
//
// Параметры:
//	ВыбранныйКонтакт		- ЭлементСпискаЗначений	- Контакт
//	ДополнительныеПараметры	- Структура				- Структура дополнительных параметров
//
Процедура СоздатьСобытиеПоКонтакту(ВыбранныйКонтакт, ДополнительныеПараметры) Экспорт
	Если ВыбранныйКонтакт = Неопределено Тогда
		Контакт = Неопределено;	
	Иначе
		Контакт = ВыбранныйКонтакт.Значение;	
	КонецЕсли;	
	ФормаСобытие = ПолучитьФорму("Документ.Событие.Форма.ФормаДокумента");
	ФормаСобытие.Автор		= сфпСофтФонПроСервер.сфпТекущийПользователь();
	ФормаСобытие.ВидСобытия	= Перечисления.ВидыСобытий.ТелефонныйЗвонок;
	Если ДополнительныеПараметры.НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Исходящий Тогда
		ФормаСобытие.ТипСообщения = Перечисления.ТипыСообщений.Исходящее;
	Иначе
		ФормаСобытие.ТипСообщения = Перечисления.ТипыСообщений.Входящее;
	КонецЕсли;
	ФормаСобытие.Состояние				= Перечисления.СостоянияСобытий.Выполняется;
	ФормаСобытие.ДатаНачала				= сфпСофтФонПроСервер.сфпТекущаяДата();
	ФормаСобытие.Тема					= НСтр("ru='!!!НЕ РАЗОБРАНО!!!'");
	ФормаСобытие.сфпИдентификаторЗвонка	= ИдентификаторТекущегоЗвонка;		
	Если Контакт = Неопределено Тогда
		ФормаСобытие.Контрагент				= НСтр("ru='НЕ НАЙДЕН!!!'");
		ФормаСобытие.ПредставлениеТелефона	= ДополнительныеПараметры.НомерТелефона;
	ИначеЕсли ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
		Ведущий = РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт);
		Если ЗначениеЗаполнено(Ведущий) Тогда
			ФормаСобытие.Контрагент     = Ведущий;
			ФормаСобытие.КонтактноеЛицо = Контакт;
		Иначе
			ФормаСобытие.Контрагент     = Контакт;
		КонецЕсли;
		ФормаСобытие.ПредставлениеТелефона	= сфпСофтФонПроСервер.сфпПолучитьПредставлениеНомераТелефона(Контакт, ДополнительныеПараметры.НомерТелефона);
	Иначе
		ФормаСобытие.Контрагент				= Контакт;
		ФормаСобытие.ПредставлениеТелефона	= сфпСофтФонПроСервер.сфпПолучитьПредставлениеНомераТелефона(Контакт, ДополнительныеПараметры.НомерТелефона);
	КонецЕсли;
	ФормаСобытие.ТекущийЭлемент = ФормаСобытие.ЭлементыФормы.ПолеHTMLДокументаСодержание;
	Если ФормаСобытие.Открыта() Тогда
		ФормаСобытие.Активизировать();
	Иначе
		ФормаСобытие.Открыть();
	КонецЕсли;
	ФормаСобытие.Модифицированность	= Истина;
	Попытка
		ФормаСобытие.ЗаписатьВФорме();
	Исключение
	КонецПопытки;	
КонецПроцедуры // СоздатьСобытиеПоКонтакту()	

&НаКлиенте
// Процедура создает документ "Событие"
//
// Параметры:
//	НаправлениеЗвонка	- Число		- Направление звонка
//	НомерТелефона		- Строка	- Номер телефона
//	ContactID			- Строка	- Уникальный идентификатор контакта
//
Процедура СоздатьНовоеСобытие(НаправлениеЗвонка, НомерТелефона, ContactID)
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НаправлениеЗвонка",	НаправлениеЗвонка);
	ДополнительныеПараметры.Вставить("НомерТелефона",		НомерТелефона);
	СписокКонтактов = Новый СписокЗначений;
	Если (НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Исходящий) И НЕ ПустаяСтрока(ContactID) Тогда
		Контакт = сфпСофтФонПроСервер.сфпНайтиКонтактПоGUID(ContactID);
		СписокКонтактов.Добавить(Контакт);
	Иначе
		МассивЗвонящих = сфпСофтФонПроСервер.сфпНайтиОбъектВРегистреПоТелефону(НомерТелефона);
		Для Каждого Контакт Из МассивЗвонящих Цикл
			Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
				Ведущий = РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт);
				Если ЗначениеЗаполнено(Контакт) Тогда
					СписокКонтактов.Добавить(Контакт, Строка(Контакт) + " <" + Строка(Ведущий) + ">");
				Иначе
					СписокКонтактов.Добавить(Контакт, Строка(Контакт));
				КонецЕсли;	
			Иначе
				СписокКонтактов.Добавить(Контакт, Строка(Контакт));
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Если СписокКонтактов.Количество() = 0 Тогда
		СоздатьСобытиеПоКонтакту(Неопределено, ДополнительныеПараметры);
	ИначеЕсли СписокКонтактов.Количество() = 1 Тогда
		СоздатьСобытиеПоКонтакту(СписокКонтактов[0], ДополнительныеПараметры);
	Иначе	
		ОписаниеВыбора = Новый ОписаниеОповещения("СоздатьСобытиеПоКонтакту", ЭтаФорма, ДополнительныеПараметры); 
		СписокКонтактов.ПоказатьВыборЭлемента(ОписаниеВыбора, НСтр("ru='Выберите контакт для номера '") + НомерТелефона, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры // СоздатьНовоеСобытие()	

&НаКлиенте
// Процедура - обработчик оповещения для открытия карточки
//
// Параметры:
//	ВыбранныйКонтакт		- ЭлементСпискаЗначений	- Контакт
//	ДополнительныеПараметры	- Структура				- Структура дополнительных параметров
//
Процедура ОткрытьКарточкуПоКонтакту(ВыбранныйКонтакт, ДополнительныеПараметры) Экспорт
	Если ВыбранныйКонтакт = Неопределено Тогда Возврат; КонецЕсли;
	Контакт = ВыбранныйКонтакт.Значение;
	ОбновитьКонтакт(Контакт);
	ПоказатьЗначение(, Контакт);
КонецПроцедуры // ОткрытьКарточкуПоКонтакту()

&НаКлиенте
// Процедура открывает карточку контакта
//
// Параметры:
//	НаправлениеЗвонка		- ПеречислениеСсылка	- Направление звонка
//	НомерТелефона			- Строка				- Номер телефона
//	ContactID				- Строка				- Уникальный идентификатор контакта
//
Процедура ОткрытьКарточку(НаправлениеЗвонка, НомерТелефона, ContactID)		
	ДополнительныеПараметры = Новый Структура;
	СписокКонтактов = Новый СписокЗначений;
	Если (НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Исходящий) И НЕ ПустаяСтрока(ContactID) Тогда
		Контакт = сфпСофтФонПроСервер.сфпНайтиКонтактПоGUID(ContactID);
		СписокКонтактов.Добавить(Контакт);
	Иначе
		МассивЗвонящих = сфпСофтФонПроСервер.сфпНайтиОбъектВРегистреПоТелефону(НомерТелефона);
		Для Каждого Контакт Из МассивЗвонящих Цикл
			Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
				Ведущий = РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт);
				Если ЗначениеЗаполнено(Контакт) Тогда
					СписокКонтактов.Добавить(Контакт, Строка(Контакт) + " <" + Строка(Ведущий) + ">");
				Иначе
					СписокКонтактов.Добавить(Контакт, Строка(Контакт));
				КонецЕсли;	
			Иначе
				СписокКонтактов.Добавить(Контакт, Строка(Контакт));
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Если СписокКонтактов.Количество() = 0 Тогда
		ОткрытьКарточкуПоКонтакту(Неопределено, ДополнительныеПараметры);
	ИначеЕсли СписокКонтактов.Количество() = 1 Тогда
		ОткрытьКарточкуПоКонтакту(СписокКонтактов[0], ДополнительныеПараметры);
	Иначе	
		ОписаниеВыбора = Новый ОписаниеОповещения("ОткрытьКарточкуПоКонтакту", ЭтаФорма, ДополнительныеПараметры); 
		СписокКонтактов.ПоказатьВыборЭлемента(ОписаниеВыбора, НСтр("ru='Выберите контакт для номера '") + НомерТелефона, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры // ОткрытьКарточку()		

&НаКлиенте
// Процедура сохраняет телефонную книгу на сервер СофтФон
//
// Параметры:
//	ОписаниеТелефоннойКниги	- Строка	- XML-описание телефонной книги
//
Процедура ЗаписатьТелефоннуюКнигу(ОписаниеТелефоннойКниги) Экспорт
	Если ПустаяСтрока(ОписаниеТелефоннойКниги) Тогда Возврат; КонецЕсли;
	ОписаниеОшибки = "";
	#Если Вебклиент Тогда
		Состояние(НСтр("ru='Работа СофтФона невозможна в web-клиенте!'"));
		Возврат;
	#Иначе
		Если ПанельСофтФон = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Попытка
			ПанельСофтФон.PutAddressBooks(ОписаниеТелефоннойКниги, ОписаниеОшибки);
		Исключение
			сфпСофтФонПроКлиент.сфпОткрытьФормуОшибкиПодключения();
		КонецПопытки;
	#КонецЕсли
	Если НЕ (ОписаниеОшибки = "Ok") Тогда
		ПроцедурыОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
	КонецЕсли;	
КонецПроцедуры // ЗаписатьТелефоннуюКнигу()	

