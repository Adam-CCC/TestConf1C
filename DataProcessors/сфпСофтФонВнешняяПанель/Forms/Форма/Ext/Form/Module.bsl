//
Процедура ПриОткрытии(Отказ)
	#Если ВебКлиент Тогда
	Отказ = Истина;
	Возврат;
	#Иначе
	Если ПанельСофтФон = Неопределено Тогда
		Отказ = Истина;
		Возврат;
