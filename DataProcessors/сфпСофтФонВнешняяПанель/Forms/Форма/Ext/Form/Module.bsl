&НаКлиенте
// Функция выполняет подключение к серверу СофтФона
//
// Параметры:
//	Нет.
//
// Возвращаемое значение:
//	Булево	- Результат подключения
//
Функция Подключиться() Экспорт
	#Если ВебКлиент Тогда
		Состояние(НСтр("ru='Работа СофтФона невозможна в web-клиенте!'"));
		Возврат Ложь;
	#Иначе
		// Пробуем прочитать номер версии внешней панели
		Попытка
			Shell = Новый COMОбъект("WScript.Shell");
			Ключ = "HKEY_LOCAL_MACHINE\SOFTWARE\1C-Rarus\SoftPhone\Versions\";
			ВерсияПанели = Shell.RegRead(Ключ + "Client 2.0");
		Исключение
			ВерсияПанели = "0.0.0.0";
		КонецПопытки;	
		Если НЕ ПроверитьАктуальностьВерсии(ВерсияПанели) Тогда
			сфпСофтФонПроКлиент.сфпОткрытьФормуОшибкиПодключения(НСтр("ru='Текущая версия внешней панели устарела! Обновите, пожалуйста, внешнюю панель!'"));
			Возврат Ложь;
		КонецЕсли;
		ИдентификаторТекущегоЗвонка	= 0;
		ЗаписьЗапущена				= Ложь;
		// Запускаем внешнюю панель
		Попытка
			Состояние("Подключение...");
			ПанельСофтФон = Новый COMОбъект("SPPanel.SPPanelAO");
			ДобавитьОбработчик ПанельСофтФон.OnCallInfo, Подключаемый_OnCallInfo;
			ДобавитьОбработчик ПанельСофтФон.OnEvent, Подключаемый_OnEvent;
			ДобавитьОбработчик ПанельСофтФон.OnRecordInfo, Подключаемый_OnRecordInfo;
			ДобавитьОбработчик ПанельСофтФон.OnAllLinesInfo, Подключаемый_OnAllLinesInfo;
			ПанельСофтФон.RegistrationEvents("2=Карточка");
			ЕстьОшибки = Ложь;
		Исключение
			ЕстьОшибки = Истина;
		КонецПопытки;
		Если ЕстьОшибки Тогда     	
			сфпСофтФонПроКлиент.сфпОткрытьФормуОшибкиПодключения();
			Возврат Ложь;
		Иначе	
			Состояние("Версия ПанельСофтФон: " + ВерсияПанели);
			ЗаполнитьПрефиксыИНастройки();		
			Возврат Истина;
		КонецЕсли;	
	#КонецЕсли
КонецФункции // Подключиться()

&НаКлиенте
// Процедура - обработчик ответа на вопрос
//
// Параметры:
//	ОтветНаВопрос			- КодВозвратаДиалога	- Ответ на вопрос
//	ДополнительныеПараметры	- Структура				- Структура дополнительных параметров
//
Процедура ВыполнитьМеждународныйЗвонок(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда	
		ВыполнитьЗвонок(ДополнительныеПараметры);
	КонецЕсли;	
КонецПроцедуры // ВыполнитьМеждународныйЗвонок()

&НаКлиенте
// Процедура выполняет звонок 
//
// Параметры:
//	ДополнительныеПараметры	- Структура	- Структура дополнительных параметров
//
Процедура ВыполнитьЗвонок(ДополнительныеПараметры)
	Если ПустаяСтрока(ДополнительныеПараметры.Телефон) Тогда Возврат; КонецЕсли;
	ContactID		= "";
	ContactName		= "";
	ContactDopInfo	= "";
	ContactImage	= ""; 
	Если ЗначениеЗаполнено(ДополнительныеПараметры.СсылкаНаОбъект) Тогда
		ContactName = СокрЛП(ДополнительныеПараметры.СсылкаНаОбъект);
		Если НЕ (ТипЗнч(ДополнительныеПараметры.СсылкаНаОбъект) = Тип("Строка")) Тогда
			ContactID = Строка(ДополнительныеПараметры.СсылкаНаОбъект.УникальныйИдентификатор());
			Если ТипЗнч(ДополнительныеПараметры.СсылкаНаОбъект)  = Тип("СправочникСсылка.Контрагенты") Тогда
				ContactDopInfo = Строка(РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(ДополнительныеПараметры.СсылкаНаОбъект));	
			КонецЕсли;
			ContactImage = сфпСофтФонПроСервер.сфпПолучитьАватарКонтакта(ДополнительныеПараметры.СсылкаНаОбъект, Истина);	
		КонецЕсли;
	КонецЕсли;
	Попытка
		Результат = ПанельСофтФон.MakeCall("", ДополнительныеПараметры.Телефон, ContactID, ContactName, ContactDopInfo, ContactImage);
	Исключение
		Результат = -1;		
	КонецПопытки;
	Если Результат = 0 Тогда
		ИдентификаторСобытия	= ДополнительныеПараметры.сфпИдентификаторСобытия;
		ДанныеЗаполнения		= ДополнительныеПараметры.сфпДанныеЗаполнения;
	Иначе	
		ИдентификаторСобытия	= "";		
		ДанныеЗаполнения		= Неопределено;
		Состояние(НСтр("ru='Не удалось создать звонок'"));	
	КонецЕсли;
КонецПроцедуры // ВыполнитьЗвонок()

&НаКлиенте
// Процедура выполняет звонок 
//
// Параметры:
//	НомерТелефона			- Строка			- Номер телефона	
//	СсылкаНаОбъект			- СправочникСсылка	- Ссылка на контакт
//	сфпИдентификаторСобытия	- Строка			- Уникальный идентификатор события
//	сфпДанныеЗаполнения		- Структура			- Данные для заполнения создаваемого события
//
Процедура Позвонить(НомерТелефона, СсылкаНаОбъект, сфпИдентификаторСобытия = "", сфпДанныеЗаполнения = Неопределено) Экспорт
	Если ПанельСофтФон = Неопределено Тогда
		Возврат;
	ИначеЕсли ПустаяСтрока(НомерТелефона) Тогда
		Возврат;
	ИначеЕсли НомерТелефона = сфпСофтФонПроСервер.сфпТекущийВнутреннийНомер() Тогда
		Возврат;
	КонецЕсли;
	ContactID		= "";
	ContactName		= "";
	ContactDopInfo	= "";
	ContactImage	= "";
	СтруктураНомера	= сфпСофтФонПроСервер.сфпЗаполнитьСтруктуруПолейПоПредставлениюТелефон(НомерТелефона);
	Телефон = ПреобразоватьНомерСУчетомПрефиксов(СтруктураНомера);
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Телефон",					Телефон);
	ДополнительныеПараметры.Вставить("СсылкаНаОбъект",			СсылкаНаОбъект);
	ДополнительныеПараметры.Вставить("сфпИдентификаторСобытия",	сфпИдентификаторСобытия);
	ДополнительныеПараметры.Вставить("сфпДанныеЗаполнения",		сфпДанныеЗаполнения);
	Если СтрДлина(Телефон) > 10 Тогда
		ОповещениеОтвета = Новый ОписаниеОповещения("ВыполнитьМеждународныйЗвонок", ЭтаФорма, ДополнительныеПараметры);
		ТекстЗаголовка	= НСтр("ru='ВНИМАНИЕ!!! Выполняется звонок в другую страну'");
		ТекстВопроса	= НСтр("ru='ВОЗМОЖНО!!! Телефонный номер набран неверно"  + Символы.ПС + "Подтвердите выполнение международного звонка'");
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,	НСтр("ru='Набрать номер'"));
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет,	НСтр("ru='Отменить'"));
		ПоказатьВопрос(ОповещениеОтвета, ТекстВопроса, СписокКнопок, 30, КодВозвратаДиалога.Нет, ТекстЗаголовка, КодВозвратаДиалога.Нет);
	Иначе
		ВыполнитьЗвонок(ДополнительныеПараметры);		
	КонецЕсли;	
КонецПроцедуры // Позвонить()

&НаКлиенте
// Процедура - обработчик оповещения для выполнения звонка
//
// Параметры:
//	ВыбранныйНомер			- ЭлементСпискаЗначений	- Контакт
//	ДополнительныеПараметры	- Структура				- Структура дополнительных параметров
//
Процедура ВыполнитьЗвонокПоНомеру(ВыбранныйНомер, ДополнительныеПараметры) Экспорт
	Если ВыбранныйНомер = Неопределено Тогда Возврат; КонецЕсли;
	Позвонить(ВыбранныйНомер.Значение.Телефон, ВыбранныйНомер.Значение.Контакт, ДополнительныеПараметры.сфпИдентификаторСобытия, ДополнительныеПараметры.сфпДанныеЗаполнения);
КонецПроцедуры // ВыполнитьЗвонокПоНомеру()

&НаКлиенте
// Процедура выполняет звонок после выбора номера телефона из списка, который формируется по структуре объектов
//
// Параметры:
//	СписокОбъектов			- СписокЗначений	- Список объектов, для которых выбираются телефоны
//	сфпИдентификаторСобытия	- Строка			- Уникальный идентификатор события
//	сфпДанныеЗаполнения		- Структура			- Данные для заполнения создаваемого события
//
Процедура ПозвонитьВыбравТелефон(СписокОбъектов, сфпИдентификаторСобытия = "", сфпДанныеЗаполнения = Неопределено) Экспорт 
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("сфпИдентификаторСобытия",	сфпИдентификаторСобытия);
	ДополнительныеПараметры.Вставить("сфпДанныеЗаполнения",		сфпДанныеЗаполнения);
	СписокТелефонов = сфпСофтФонПроКлиент.сфпЗаполнитьСписокТелефонов(СписокОбъектов);	
	Если СписокТелефонов.Количество() = 2 Тогда
		ВыполнитьЗвонокПоНомеру(СписокТелефонов[0], ДополнительныеПараметры);
	Иначе	
		ОписаниеВыбора = Новый ОписаниеОповещения("ВыполнитьЗвонокПоНомеру", ЭтаФорма, ДополнительныеПараметры); 
		СписокТелефонов.ПоказатьВыборЭлемента(ОписаниеВыбора, НСтр("ru='Выбор телефона'"), ЭтаФорма);
	КонецЕсли;
КонецПроцедуры // ПозвонитьВыбравТелефон()

&НаКлиенте
// Процедура - обработчик оповещения для выполнения звонка
//
// Параметры:
//	ВыбранныйКонтакт		- ЭлементСпискаЗначений	- Контакт
//	ДополнительныеПараметры	- Структура				- Структура дополнительных параметров
//
Процедура ВыполнитьЗвонокПоКонтакту(ВыбранныйКонтакт, ДополнительныеПараметры) Экспорт
	Если ВыбранныйКонтакт = Неопределено Тогда
		Позвонить(ДополнительныеПараметры.НомерТелефона, ВыбранныйКонтакт, ДополнительныеПараметры.сфпИдентификаторСобытия, ДополнительныеПараметры.сфпДанныеЗаполнения);
	Иначе
		Позвонить(ДополнительныеПараметры.НомерТелефона, ВыбранныйКонтакт.Значение, ДополнительныеПараметры.сфпИдентификаторСобытия, ДополнительныеПараметры.сфпДанныеЗаполнения);
	КонецЕсли;	
КонецПроцедуры // ВыполнитьЗвонокПоКонтакту()

&НаКлиенте
// Процедура выполняет поиск контакта по номеру телефона и совершает звонок
//
// Параметры:
//	НомерТелефона			- Строка			- Номер телефона
//	Контакт					- СправочникСсылка	- Владелец номера телефона
//	сфпИдентификаторСобытия	- Строка			- Уникальный идентификатор события
//
Процедура ПозвонитьВыбравКонтакт(НомерТелефона, Контакт, сфпИдентификаторСобытия = "", сфпДанныеЗаполнения = Неопределено) Экспорт
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("НомерТелефона", 			НомерТелефона);
	ДополнительныеПараметры.Вставить("сфпИдентификаторСобытия",	сфпИдентификаторСобытия);
	ДополнительныеПараметры.Вставить("сфпДанныеЗаполнения",		сфпДанныеЗаполнения);
	СписокКонтактов = Новый СписокЗначений;
	Если ЗначениеЗаполнено(Контакт) Тогда
		СписокКонтактов.Добавить(Контакт);
	Иначе	
		МассивЗвонящих = сфпСофтФонПроСервер.сфпНайтиОбъектВРегистреПоТелефону(НомерТелефона);
		Для Каждого Контакт Из МассивЗвонящих Цикл
			Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
				Ведущий = РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт);
				Если ЗначениеЗаполнено(Контакт) Тогда
					СписокКонтактов.Добавить(Контакт, Строка(Контакт) + " <" + Строка(Ведущий) + ">");
				Иначе	
					СписокКонтактов.Добавить(Контакт, Строка(Контакт));
				КонецЕсли;	
			Иначе
				СписокКонтактов.Добавить(Контакт, Строка(Контакт));
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	Если СписокКонтактов.Количество() = 0 Тогда
		ВыполнитьЗвонокПоКонтакту(Неопределено, ДополнительныеПараметры);
	ИначеЕсли СписокКонтактов.Количество() = 1 Тогда
		ВыполнитьЗвонокПоКонтакту(СписокКонтактов[0], ДополнительныеПараметры);
	Иначе	
		ОписаниеВыбора = Новый ОписаниеОповещения("ВыполнитьЗвонокПоКонтакту", ЭтаФорма, ДополнительныеПараметры); 
		СписокКонтактов.ПоказатьВыборЭлемента(ОписаниеВыбора, НСтр("ru='Выберите контакт для номера '") + НомерТелефона, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры // НайтиКонтактИПозвонить()

&НаКлиенте
// Функция разбирает переданный номер телефона или структуру содержащую поля номера телефона в зависимости
//  от того какой это звонок входящий или исходящих. Если входящий звонок, то передается строка с номером телефона
//  а возвращаем структуру содержащую поля номера телефона. Так же проверяем если звонок внутренний, то сохраняем номер
//  как внутренний, иначе передаем его как есть, пользователь разберет номер в ручную.
//  Если звонок исходящий то получаем структуру в качестве номера, а возвращаем преобразованную строку которую будет набирать
//  станция.
Функция ПреобразоватьНомерСУчетомПрефиксов(НомерТелефона, СостояниеЗвонка = "", ВходящийИсходящийЗвонок = Неопределено) Экспорт
	сфпПараметрыСервера = сфпСофтФонПроСервер.сфпПараметрыСервера();
	КодСтраныПользователь = сфпПараметрыСервера.КодСтраны;
	КодГородаПользователь = сфпПараметрыСервера.КодГорода;
	// Подготавливаем структуру номера телефона который будем возвращать при входящем звонке
	//  при исходящем будем возвращать строку с номером телефона
	РезультатНомер = сфпСофтФонПроКлиент.сфпСформироватьСтруктуруНомераИзПолей();
	// Если точно не определен входящий или исходящий звонок....то пытаемся определить его по состоянию звонка
	Если ВходящийИсходящийЗвонок = Неопределено Тогда
		ВходящийИсходящийЗвонок = ?(СостояниеЗвонка = "", ТипВходящийИсходящийЗвонок.Исходящий, ОпределитьВходящееИсходящееСобытие(СостояниеЗвонка));
	КонецЕсли;
	// Обрабатываем входящий звонок
	Если (ВходящийИсходящийЗвонок = ТипВходящийИсходящийЗвонок.Входящий) И ТипЗнч(НомерТелефона) = Тип("Строка") Тогда
		НомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона);
		// Если состояние звонка является внутренним номером, то никаких префиксов подставлять не нужно 
		//  просто сразу возвращаем номер телефона, структуру смотрим в ВидыВходящихИсходящихСобытий
		Если ОпределитьВнутреннийВнешнийЗвонок(СостояниеЗвонка, НомерТелефона) = ТипВнутреннийВнешнийЗвонок.Внутренний Тогда
			РезультатНомер.Внутренний = НомерТелефона;
		Иначе
			// Если длина телефона равна 7 цифрам или меньше, то это только номер
			Если СтрДлина(НомерТелефона) < 8 Тогда
				РезультатНомер.НомерТелефона = НомерТелефона;
			ИначеЕсли СтрДлина(НомерТелефона) = 10 Тогда
			// Если длина телефона равна 10 цифрам, то это код города и номер
				РезультатНомер.КодСтраны = КодСтраныПользователь;
				// Если код города совпадает
				Если Найти(НомерТелефона, КодГородаПользователь) = 1 Тогда
					РезультатНомер.КодГорода = КодГородаПользователь;
					РезультатНомер.НомерТелефона = Сред(НомерТелефона, СтрДлина(КодГородаПользователь) + 1);
				Иначе
				// Считаем, что длина кода города 3 цифры
					РезультатНомер.КодГорода = Лев(НомерТелефона, 3);
					РезультатНомер.НомерТелефона = Сред(НомерТелефона, 4);
				КонецЕсли;	
			Иначе	
			// Считаем, что длина номера 7 цифр, остальные код города
				РезультатНомер.КодСтраны     = КодСтраныПользователь;
				РезультатНомер.НомерТелефона = Прав(НомерТелефона, 7);
				РезультатНомер.КодГорода	 = Лев(НомерТелефона, СтрДлина(НомерТелефона) - 7);
			КонецЕсли;
		КонецЕсли;
		// Сформируем представление
		сфпСофтФонПроКлиент.сфпСформироватьПредставлениеТелефонаПоСтруктуре(РезультатНомер);
	ИначеЕсли ВходящийИсходящийЗвонок = ТипВходящийИсходящийЗвонок.Исходящий И ТипЗнч(НомерТелефона) = Тип("Структура") Тогда
		// Обрабатываем исходящий звонок
		// Необходимо позвонить по внутреннему номер, префиксы не нужны
		Если (НЕ ПустаяСтрока(НомерТелефона.Внутренний) И ПустаяСтрока(НомерТелефона.НомерТелефона)) 
			ИЛИ (НЕ ПустаяСтрока(НомерТелефона.НомерТелефона) И ПустаяСтрока(НомерТелефона.Внутренний) 
			И СтрДлина(сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона.НомерТелефона)) <= сфпПараметрыСервера.МаксимальнаяДлинаВнутреннихНомеров) Тогда
			РезультатНомер = ?(НЕ ЗначениеЗаполнено(НомерТелефона.Внутренний), НомерТелефона.НомерТелефона, НомерТелефона.Внутренний);
		Иначе
			Если НЕ ПустаяСтрока(НомерТелефона.НомерТелефона) Тогда
				КодСтраныНомера = ?(СокрЛП(НомерТелефона.КодСтраны) = "8", "7", СтрЗаменить(НомерТелефона.КодСтраны, "+", ""));
				КодГородаНомера = НомерТелефона.КодГорода;
				КодСтраныБезПлюса = СтрЗаменить(КодСтраныПользователь, "+", "");
				// 1. Если это наш город и страна, то просто номер телефона или код города и номер телефона
				Если ((КодСтраныНомера = КодСтраныБезПлюса) ИЛИ ПустаяСтрока(КодСтраныНомера)) 
					И ((КодГородаНомера = КодГородаПользователь) ИЛИ ПустаяСтрока(КодГородаНомера)) Тогда
					Если (СтрДлина(НомерТелефона.НомерТелефона) > 10) И (Лев(НомерТелефона.НомерТелефона, СтрДлина(КодСтраныБезПлюса)) = КодСтраныБезПлюса) Тогда
						НомерТелефона.НомерТелефона = Сред(НомерТелефона.НомерТелефона, СтрДлина(КодСтраныБезПлюса) + 1);	
					ИначеЕсли СтрДлина(НомерТелефона.НомерТелефона) < 7 Тогда	
						// Добавляем код города
						НомерТелефона.НомерТелефона = КодГородаНомера + НомерТелефона.НомерТелефона;	
					КонецЕсли;
					РезультатНомер = НомерТелефона.НомерТелефона;
				// 2. Если это не наш город, но наша страна, то выход код города и номер телефона
				ИначеЕсли (НЕ (КодГородаНомера = КодГородаПользователь) И НЕ ПустаяСтрока(КодГородаНомера)) 
					И ((КодСтраныНомера = КодСтраныБезПлюса) ИЛИ ПустаяСтрока(КодСтраныНомера)) Тогда
					РезультатНомер = КодГородаНомера + НомерТелефона.НомерТелефона;
				// 3. Если это не наша страна, то международный звонок.
				Иначе
					РезультатНомер = КодСтраныНомера + КодГородаНомера + НомерТелефона.НомерТелефона;
				КонецЕсли;
			Иначе
				РезультатНомер = "";		
			КонецЕсли;
		КонецЕсли;
		РезультатНомер = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(РезультатНомер);
	КонецЕсли;
	Возврат РезультатНомер;
КонецФункции // ПреобразоватьНомерСУчетомПрефиксов()

&НаКлиенте
// Процедура изменяет таблицу маршрутизации в АТС
//
// Параметры:
//	Объект	- СправочникСсылка	- Объект, информацию о маршрутизации которого следует изменить
//
Процедура ИзменитьМаршрутизациюВАТС(Объект) Экспорт
	#Если Вебклиент Тогда
		Состояние(НСтр("ru='Работа СофтФона невозможна в web-клиенте!'"));
	#Иначе
		Если ПанельСофтФон = Неопределено Тогда Возврат; КонецЕсли;
		Попытка
			ИдентификаторКонфигурации	= сфпСофтФонПроСервер.сфпПолучитьИдентификаторКонфигурации();
			СписокМаршрутизации			= сфпСофтФонПроСервер.сфпПолучитьСписокМаршрутизации();
			ПанельСофтФон.SendStrData("", 1, "", ИдентификаторКонфигурации);
			ПанельСофтФон.SendStrData("", 0, СписокМаршрутизации, ИдентификаторКонфигурации);
		Исключение
			сфпСофтФонПроКлиент.сфпОткрытьФормуОшибкиПодключения();
		КонецПопытки;
	#КонецЕсли
КонецПроцедуры // ИзменитьМаршрутизациюВАТС()

&НаКлиенте
// Процедура получает файл записи разговора
//
// Параметры:
//	СтруктураЗаписи	- Структура	- Структура записи разговора
//
Процедура ПолучитьФайлРазговора(СтруктураЗаписи) Экспорт
	#Если Вебклиент Тогда
		Состояние(НСтр("ru='Работа СофтФона невозможна в web-клиенте!'"));
	#Иначе
		Если ПанельСофтФон = Неопределено Тогда
			Возврат;
		ИначеЕсли НЕ сфпСофтФонПроСервер.сфпИспользоватьЗаписьПереговоров() Тогда
			Возврат;
		КонецЕсли;
		FileName = сфпСофтФонПроКлиент.ПолучитьИмяФайлаЗаписиРазговора();
		Если сфпСофтФонПроСервер.сфпИспользоватьСпрут7() Тогда
			Попытка
				ПанельСофтФон.SaveRecordedFile(СтруктураЗаписи.ИмяЛинии, СтруктураЗаписи.ИдентификаторЗаписи, FileName);
			Исключение	
			КонецПопытки;	
		КонецЕсли;
		Если сфпСофтФонПроСервер.сфпИспользоватьCLON() Тогда
			Попытка
				КодВозврата = сфпObjCLON.GetSoundFile(СтруктураЗаписи.ИдентификаторЗаписи, FileName);
			Исключение	
				КодВозврата = -1;
			КонецПопытки;
			Если КодВозврата = -1 Тогда
				// Переподключимся к CLON
				сфпСофтФонПроКлиент.сфпПодключитьCLON();
				// Повторим получение файла
				Попытка
					КодВозврата = сфпObjCLON.GetSoundFile(СтруктураЗаписи.ИдентификаторЗаписи, FileName);
				Исключение	
					КодВозврата = -1;
				КонецПопытки;
			КонецЕсли;	
			Если КодВозврата = -1 Тогда
				ПоказатьПредупреждение(, НСтр("ru='Ошибка получения файла записи разговора!'"), 5);
			КонецЕсли;
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры	// ПолучитьФайлРазговора()

&НаКлиенте
