	ПанельСофтФон.PanelHide();
	// Оповещаем внешнюю панель о работе в скрытом режиме
	УстановитьСкрытыйРежим();
	// Устанавливаем видимость панели пропущенных звонков
	ОбновитьОтображениеЗвонков();
	#КонецЕсли
КонецПроцедуры // ПриОткрытии()

