// Функция определяет и возвращает какой это звонок внутренний или внешний
Функция ОпределитьВнутреннийВнешнийЗвонок(Знач СостояниеЗвонка, НомерТелефона) 
	СостояниеЗвонка = Число(СостояниеЗвонка);
	Если СостояниеЗвонка = ВидыВходящихИсходящихСобытий.ВнешнийВходящий Тогда // 3
		Возврат ТипВнутреннийВнешнийЗвонок.Внешний;
	ИначеЕсли СостояниеЗвонка = ВидыВходящихИсходящихСобытий.ВнешнийИсходящий Тогда // 6
		Возврат ТипВнутреннийВнешнийЗвонок.Внешний;
	ИначеЕсли ЗначениеЗаполнено(НомерТелефона) Тогда                  
		НомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона);
		сфпПараметрыСервера = сфпСофтФонПроСервер.сфпПараметрыСервера();
		Если ПустаяСтрока(НомерТелефона) Тогда
			Возврат ТипВнутреннийВнешнийЗвонок.Внешний;	
		ИначеЕсли сфпСофтФонПроКлиент.сфпОпределитьВнутреннийЗвонокПоНомеру(НомерТелефона, сфпПараметрыСервера.МаксимальнаяДлинаВнутреннихНомеров) Тогда
			Возврат ТипВнутреннийВнешнийЗвонок.Внутренний;
		Иначе
			Возврат ТипВнутреннийВнешнийЗвонок.Внешний;	
		КонецЕсли;	
	ИначеЕсли СостояниеЗвонка = ТипВнутреннийВнешнийЗвонок.Внутренний Тогда // 1
		Возврат ТипВнутреннийВнешнийЗвонок.Внутренний;
	ИначеЕсли СостояниеЗвонка = ТипВнутреннийВнешнийЗвонок.Внешний Тогда  // 0
		Возврат ТипВнутреннийВнешнийЗвонок.Внешний;	
	Иначе
		Возврат ТипВнутреннийВнешнийЗвонок.Внешний;  // 4, 5
	КонецЕсли;
КонецФункции

&НаКлиенте
// Функция по переданному входящему или исходящему событию в числовом виде определяет его тип
//	Если определить не удается, то по умолчанию передается входящее сообщение
//
// Параметры:
//	НомерСобытия	- Число	- Номер события	
//
// Возвращаемое значение:
//	Число	- Тип события
//
Функция ОпределитьВходящееИсходящееСобытие(Знач НомерСобытия) 
	НомерСобытия = Число(НомерСобытия);
	Если НомерСобытия = ВидыВходящихИсходящихСобытий.ВнутреннийИсходящий Тогда // 1
		Возврат ТипВходящийИсходящийЗвонок.Исходящий;
	ИначеЕсли НомерСобытия = ВидыВходящихИсходящихСобытий.ВнешнийИсходящий Тогда // 6
		Возврат ТипВходящийИсходящийЗвонок.Исходящий;
	Иначе
		Возврат ТипВходящийИсходящийЗвонок.Входящий;
	КонецЕсли;
КонецФункции // ОпределитьВходящееИсходящееСобытие()

&НаКлиенте
// Процедура заполняет префиксы и настройки
//
// Параметры:
//	Нет.
//
Процедура ЗаполнитьПрефиксыИНастройки()
	#Если Вебклиент Тогда
		Состояние(НСтр("ru='Работа СофтФона невозможна в web-клиенте!'"));
	#Иначе
		сфпПараметрыСервера = сфпСофтФонПроСервер.сфпПараметрыСервера();
		PrefCity			= сфпПараметрыСервера.ПрефиксВыходаВГород;
		PrefContry			= сфпПараметрыСервера.ПрефиксВыходаВМежгород;
		PrefWorld			= сфпПараметрыСервера.ПрефиксВыходаНаМеждународную;
		InternalNumMaxLen	= сфпПараметрыСервера.МаксимальнаяДлинаВнутреннихНомеров;
		LastNumberCount		= сфпПараметрыСервера.ПоследниеЦифрыТелефонногоНомера;
		LocalPhoneNum		= сфпСофтФонПроСервер.сфпПолучитьЗначениеРеквизита(сфпСофтФонПроСервер.сфпТекущийПользователь(), "сфпТекущийВнутреннийНомер");
		HistoryOn				= Ложь;
		HistoryConnectionString = "";
		Попытка
			ПанельСофтФон.GetSettings(PrefCity, PrefContry, PrefWorld, InternalNumMaxLen, LastNumberCount, LocalPhoneNum, HistoryOn, HistoryConnectionString);
			НастройкиПолучены = Истина;
		Исключение	
			НастройкиПолучены = Ложь;
		КонецПопытки;
		Элементы.НадписьЛинияПодключения.Заголовок				= НСтр("ru='Линия не выбрана'");
		Элементы.НадписьСостояниеПодключения.Заголовок			= НСтр("ru='Не подключен'");
		Элементы.КартинкаКлиентСостояниеПодключения.Картинка	= БиблиотекаКартинок.сфпКлиентОтключен;
		Если НастройкиПолучены Тогда
			Если НЕ HistoryOn Тогда
				HistoryConnectionString = "";
			КонецЕсли;	
			ТребуетсяОбновитьРегистр = НЕ (LastNumberCount = сфпПараметрыСервера.ПоследниеЦифрыТелефонногоНомера);
			// Запишем настройки сервера СофтФона
			сфпПараметрыСервера.ПрефиксВыходаВГород					= PrefCity;
			сфпПараметрыСервера.ПрефиксВыходаВМежгород				= PrefContry;
			сфпПараметрыСервера.ПрефиксВыходаНаМеждународную		= PrefWorld;
			сфпПараметрыСервера.МаксимальнаяДлинаВнутреннихНомеров	= InternalNumMaxLen;
			сфпПараметрыСервера.ПоследниеЦифрыТелефонногоНомера		= LastNumberCount;
			сфпПараметрыСервера.СтрокаПодключенияИстории			= HistoryConnectionString;
			сфпСофтФонПроСервер.сфпЗаписатьПараметрыСервера(сфпПараметрыСервера);
			// Если изменилось количество последних цифр, то перезаполним регистр поиска по номерам
			Если ТребуетсяОбновитьРегистр Тогда
				Состояние(НСтр("ru='Выполняется обновление регистра поиска по номеру телефона'"));
				сфпСофтФонПроСервер.сфпПерезаполнитьРегистрПоискаПоНомерам();
            КонецЕсли;
			// Запишем внутренний номер для текущего пользователя и изменим маршрутизацию в АТС
			Если сфпСофтФонПроСервер.сфпЗаписатьНомерТекущемуПользователю(LocalPhoneNum) Тогда
				ИзменитьМаршрутизациюВАТС(сфпСофтФонПроСервер.сфпТекущийПользователь());
			КонецЕсли;
			// Заполним статусы на форме
			Если ЗначениеЗаполнено(LocalPhoneNum) Тогда
				Элементы.НадписьЛинияПодключения.Заголовок				= НСтр("ru='Внутренний номер: '") + LocalPhoneNum;
				Элементы.НадписьСостояниеПодключения.Заголовок			= НСтр("ru='Готов к работе'");
				Элементы.КартинкаКлиентСостояниеПодключения.Картинка	= БиблиотекаКартинок.сфпКлиентПодключен;
			КонецЕсли;
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры // ЗаполнитьПрефиксыИНастройки()	

&НаКлиенте
// Функция проверяет актуальность версии внешней панели
//
// Параметры:
//	ТекущаяВерсия	- Строка	- Текущая версия панели
//
// Возвращаемое значение:
//	Булево	- Актуальность панели
//
Функция ПроверитьАктуальностьВерсии(ТекущаяВерсия)
	АктуальнаяВерсия		= "3.0.3.51";
	МассивАктуальнойВерсии	= сфпСофтФонПроКлиент.сфпРазложитьСтрокуВМассивПодстрок(АктуальнаяВерсия,	".");
	МассивТекущейВерсии		= сфпСофтФонПроКлиент.сфпРазложитьСтрокуВМассивПодстрок(ТекущаяВерсия,		".");
	Для НомерВМассиве = 0 По 3 Цикл
		Если Число(МассивАктуальнойВерсии[НомерВМассиве]) > Число(МассивТекущейВерсии[НомерВМассиве]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;	
	Возврат Истина;
КонецФункции // ПроверитьАктуальностьВерсии()	

