&НаКлиенте
// Динамически подключаемый обработчик события "OnEvent" внешней панели
// Отсутствие ссылок на процедуру не является ошибкой!
//
// Параметры:
//	EventType	- Число		- Тип события (-1 – Таймер; -2 – Изменились настройки; 0 – Автоматический при ответе на звонок;
//										1 – Ручной вызов для создания события;	Прочие при регистрации событий из 1С)
//	Origin		- Число		- Направление звонка звонка (0 – Неопределенно; 1 – Внутренний исходящий; 2 – Внутренний входящий;
//										3 – Внешний входящий; 4 – Недоступно; 5 – Конференция; 6 – Входящий)
//	ContactID	- Строка	- Идентификатор контакта во внешней учетной системе
//	PhoneNumber	- Строка	- Номер телефона контакта
//
Процедура Подключаемый_OnEvent(EventType, Origin, ContactID, PhoneNumber)
	НаправлениеЗвонка = ОпределитьВходящееИсходящееСобытие(Origin);
	ОткрыватьДокументПриСнятииТрубки = сфпСофтФонПроСервер.сфпПолучитьЗначениеПоУмолчаниюПользователя("ОткрыватьДокументПриСнятииТрубки");
	ОткрыватьДокументПриСнятииТрубкиПриИсходящем = сфпСофтФонПроСервер.сфпПолучитьЗначениеПоУмолчаниюПользователя("ОткрыватьДокументПриСнятииТрубкиПриИсходящем");
	НомерТелефона = сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксыВыходаНаЛинию(PhoneNumber);		
	Если EventType = 0 Тогда
		Если (НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Исходящий) И НЕ ПустаяСтрока(ИдентификаторСобытия) Тогда
			// Событие не создаем, оповещаем событие-источник об ответе на звонок		
			СтруктураОповещения = Новый Структура;
			СтруктураОповещения.Вставить("ИдентификаторСобытия",	ИдентификаторСобытия);
			СтруктураОповещения.Вставить("ИдентификаторЗвонка",		ИдентификаторТекущегоЗвонка);
			Если ПустаяСтрока(ContactID) Тогда
				Контакт = Неопределено;
			Иначе	
				Контакт = сфпСофтФонПроСервер.сфпНайтиКонтактПоGUID(ContactID);
			КонецЕсли;
			Если НЕ (Контакт = Неопределено) Тогда
				Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
					Ведущий = РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт);
					Если ЗначениеЗаполнено(Ведущий) Тогда
						СтруктураОповещения.Вставить("Партнер",			Ведущий);
						СтруктураОповещения.Вставить("КонтактноеЛицо", 	Контакт);
					Иначе
						СтруктураОповещения.Вставить("Клиент",         Контакт);
						СтруктураОповещения.Вставить("КонтактноеЛицо", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
					КонецЕсли;
				Иначе	
					СтруктураОповещения.Вставить("Партнер",			Контакт);
					СтруктураОповещения.Вставить("КонтактноеЛицо", 	ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
				КонецЕсли;
			КонецЕсли;
			ПредставлениеНомераТелефона = сфпСофтФонПроСервер.сфпПолучитьПредставлениеНомераТелефона(Контакт, НомерТелефона);
			СтруктураОповещения.Вставить("НомерТелефона", ПредставлениеНомераТелефона);
			Оповестить("СофтФон_НачалоРазговора", СтруктураОповещения);
		ИначеЕсли ((НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Входящий) И ОткрыватьДокументПриСнятииТрубки) 
			ИЛИ ((НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Исходящий) И ОткрыватьДокументПриСнятииТрубкиПриИсходящем) Тогда
			СоздатьНовоеСобытие(НаправлениеЗвонка, НомерТелефона, ContactID);
		КонецЕсли;
	ИначеЕсли EventType = 1 Тогда
		СоздатьНовоеСобытие(НаправлениеЗвонка, НомерТелефона, ContactID);
	ИначеЕсли EventType = 2 Тогда
		ОткрытьКарточку(НаправлениеЗвонка, НомерТелефона, ContactID);		
	ИначеЕсли EventType = -1 Тогда
		// Событие таймера, для обновления истории звонков
	ИначеЕсли EventType = -2 Тогда
		// Событие изменения номера основной линии
		ЗаполнитьПрефиксыИНастройки();
	КонецЕсли;
КонецПроцедуры // Подключаемый_OnEvent()

&НаКлиенте
// Динамически подключаемый обработчик события "OnCallInfo" внешней панели
// Отсутствие ссылок на процедуру не является ошибкой!
//
// Параметры:
//	hCall				- Число			- Идентификатор линии.
//	LineName			- Строка		- Имя линии.
//	LineType			- Строка		- Тип линии.
//	CallerID			- Строка		- Номер звонящего.
//	CallerInfoName		- Строка		- Представление звонящего. Возвращаемый параметр.
//											Значение может быть изменено приложением.
//	CalledId			- Строка		- Номер принимающего звонок.
//	CalledInfoName		- Строка		- Представление принимающего звонок. Возвращаемый параметр.
//											Значение может быть изменено приложением.
//	State				- Число			- Состояние звонка.
//	Origin				- Число			- Направление звонка звонка. (0 – Неопределенно; 1 – Внутренний исходящий;
//											2 – Внутренний входящий; 3 – Внешний входящий; 4 – Недоступно;
//											5 – Конференция; 6 – Входящий)
//	DopInfo				- Строка		- Дополнительная информация о звонке. Возвращаемый параметр.
//											Значение может быть изменено приложением.
//	AvailableActions	- Число			- Доступные действия со звонком. Битовая маска (aa_Drop	= $00000001; aa_Answer = $00000002;
//											aa_Hold = $00000004; aa_UnHold = $00000008; aa_Redirect = $00000010; aa_Transfer = $00000020;
//											aa_CompleteTransfer = $00000040; aa_CancelTransfer = $00000080)
//	AppValue			- Произвольный	- Произвольная, служебная информация, хранимая приложением. Возвращаемый параметр.
//											Значение может быть изменено приложением.
//	ImageData			- Строка		- Картинка контакта в формате Base64. Возвращаемый параметр.
//											Значение может быть изменено приложением.
//	ContactID			- Строка		- Идентификатор контакта во внешней учетной системе. Возвращаемый параметр.
//											Значение может быть изменено приложением.
Процедура Подключаемый_OnCallInfo(hCall, LineName, LineType, CallerID, CallerInfoName, CalledId, CalledInfoName, State, Origin, DopInfo, AvailableActions, AppValue, ImageData, ContactID)
	Если ПанельАктивна Тогда
		// Оповещаем внешнюю панель о работе в скрытом режиме
		УстановитьСкрытыйРежим();
	КонецЕсли;	
	Если НЕ (ИдентификаторТекущегоЗвонка = hCall) Тогда
		Если (ИдентификаторТекущегоЗвонка = 0) И НЕ ПустаяСтрока(ИдентификаторСобытия) Тогда
			// Оповещаем событие о смене идентификатора звонка		
			СтруктураОповещения = Новый Структура;
			СтруктураОповещения.Вставить("ИдентификаторСобытия",	ИдентификаторСобытия);
			СтруктураОповещения.Вставить("ИдентификаторЗвонка",		hCall);
			Оповестить("СофтФон_ОбновитьЗвонок", СтруктураОповещения);
		КонецЕсли;
		ИдентификаторТекущегоЗвонка	= hCall;
		// Если изменился звонок, то очищаем признак записи
		ЗаписьЗапущена	= Ложь;
	КонецЕсли;
	Контакт				= Неопределено;
	НаправлениеЗвонка	= ОпределитьВходящееИсходящееСобытие(Origin);
	НомерТелефона		= ?(НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Входящий, CallerID, CalledId);
	ВнутреннийВнешний	= ОпределитьВнутреннийВнешнийЗвонок(Origin, НомерТелефона);
	Если ЗначениеЗаполнено(НомерТелефона) Тогда
		Если ЗначениеЗаполнено(СокрЛП(AppValue)) Тогда
			Текст = Новый ТекстовыйДокумент;
			Текст.УстановитьТекст(AppValue);
			СтарыйНомер = Текст.ПолучитьСтроку(3);
			Если НЕ ПустаяСтрока(СтарыйНомер) И НЕ (СтарыйНомер = НомерТелефона) Тогда
				Если (СтрДлина(СтарыйНомер) > 7) И (Найти(НомерТелефона, СтарыйНомер) > 0) Тогда
					НомерТелефона = СтарыйНомер;
				Иначе	
					AppValue = "";
				КонецЕсли;	
		    КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(AppValue)) Тогда
			Текст = Новый ТекстовыйДокумент;
			Текст.УстановитьТекст(AppValue);
			Если НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Входящий Тогда
				CallerInfoName = Текст.ПолучитьСтроку(1);
			Иначе
				CalledInfoName = Текст.ПолучитьСтроку(1);	
			КонецЕсли;
			DopInfo = Текст.ПолучитьСтроку(2);
		Иначе
			МассивЗвонящих = сфпСофтФонПроСервер.сфпНайтиОбъектВРегистреПоТелефону(НомерТелефона);
			Если МассивЗвонящих.Количество() = 1 Тогда
				Контакт = МассивЗвонящих[0];
				ИмяКонтакта = Строка(Контакт);
				ContactID = Строка(Контакт.УникальныйИдентификатор());
				Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
					DopInfo = Строка(РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт));	
				КонецЕсли;
				Если НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Входящий Тогда
					CallerInfoName = ИмяКонтакта;
				Иначе
					CalledInfoName = ИмяКонтакта;	
				КонецЕсли;
				ImageData = сфпСофтФонПроСервер.сфпПолучитьАватарКонтакта(Контакт, Истина);
				AppValue = ИмяКонтакта + Символы.ПС + DopInfo + Символы.ПС + НомерТелефона;
			ИначеЕсли МассивЗвонящих.Количество() > 1 Тогда
				Если НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Входящий Тогда
					CallerInfoName = НСтр("ru='Несколько совпадений номера '") + CallerID;
					AppValue = CallerInfoName + Символы.ПС + DopInfo + Символы.ПС + НомерТелефона;
					CallerInfoName = CallerInfoName + Символы.ПС;
					// составим многострочный текст из контактов для показа в панели
					// первая строка будет проигнорирована
					Сч = 0;
					Для Каждого СтрокаМассива Из МассивЗвонящих Цикл
						Сч = Сч + 1;
						Если Сч = 5 Тогда
							CallerInfoName = CallerInfoName + "..."
						КонецЕсли;
						CallerInfoName = CallerInfoName + ?(Сч = 1, "", ", ") + Строка(СтрокаМассива); 
					КонецЦикла;
				Иначе
					Если ПустаяСтрока(ContactID) Тогда
						Контакт = МассивЗвонящих[0];
					Иначе	
						Контакт = сфпСофтФонПроСервер.сфпНайтиКонтактПоGUID(ContactID);
					КонецЕсли;	
					Если НЕ (Контакт = Неопределено) Тогда
						ИмяКонтакта = Строка(Контакт);
						ContactID = Строка(Контакт.УникальныйИдентификатор());
						Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
							DopInfo = Строка(РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт));	
						КонецЕсли;
						CalledInfoName = ИмяКонтакта;
						ImageData = сфпСофтФонПроСервер.сфпПолучитьАватарКонтакта(Контакт, Истина);
						AppValue = ИмяКонтакта + Символы.ПС + DopInfo + Символы.ПС + НомерТелефона;
					КонецЕсли;	
				КонецЕсли;
			ИначеЕсли НЕ (СтруктураВнешнихДанных = Неопределено) Тогда
				AppValue = НомерТелефона + Символы.ПС + DopInfo + Символы.ПС + НомерТелефона;
			КонецЕсли;
		КонецЕсли;
		// Если отвечаем на звонок
		Если State = 8 Тогда
			Если НЕ ВнутреннийВнешний И сфпСофтФонПроСервер.сфпИспользоватьЗаписьПереговоров() И НЕ ЗаписьЗапущена И (ИдентификаторТекущегоЗвонка > 0) Тогда
				Если (Контакт = Неопределено) И ЗначениеЗаполнено(ContactID) Тогда
					Контакт = сфпСофтФонПроСервер.сфпНайтиКонтактПоGUID(ContactID);
				КонецЕсли;	
				внНомерТелефона = LineName;
				Если сфпСофтФонПроСервер.сфпТелефонныйРазговорЗаписывается(Контакт, внНомерТелефона, НомерТелефона) Тогда
					Если сфпСофтФонПроСервер.сфпИспользоватьCLON() Тогда
						ЗаписьЗапущена		= Истина;
						СмещениеВремениCLON	= сфпСофтФонПроКлиент.сфпПолучитьСмещениеВремениCLON();		
						СтруктураЗаписи		= Новый Структура;
						СтруктураЗаписи.Вставить("НачалоЗаписи",	сфпСофтФонПроСервер.сфпТекущаяДата() + СмещениеВремениCLON);
						СтруктураЗаписи.Вставить("hCall",			hCall);
						СтруктураЗаписи.Вставить("LineID",			внНомерТелефона);
						СтруктураЗаписи.Вставить("Контакт",			Контакт);
						СтруктураЗаписи.Вставить("НомерТелефона",	сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона));
						СтруктураЗаписи.Вставить("LineName",		LineName);
						сфпСофтФонПроСервер.сфпДобавитьЗаписьРазговораВРегистр(СтруктураЗаписи);
					КонецЕсли;
					Если сфпСофтФонПроСервер.сфпИспользоватьСпрут7() Тогда
						Попытка
							ПанельСофтФон.StartRecord(LineName, hCall);	
							ЗаписьЗапущена = Истина;
						Исключение	
						КонецПопытки;	
						Если ЗаписьЗапущена Тогда
							СтруктураЗаписи = Новый Структура;
							СтруктураЗаписи.Вставить("НачалоЗаписи",	сфпСофтФонПроСервер.сфпТекущаяДата());
							СтруктураЗаписи.Вставить("hCall",			hCall);
							СтруктураЗаписи.Вставить("LineID",			внНомерТелефона);
							СтруктураЗаписи.Вставить("Контакт",			Контакт);
							СтруктураЗаписи.Вставить("НомерТелефона",	сфпСофтФонПроСервер.сфпУбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона));
							СтруктураЗаписи.Вставить("LineName",		LineName);
							сфпСофтФонПроСервер.сфпДобавитьЗаписьРазговораВРегистр(СтруктураЗаписи);
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Если ПанельАктивна Тогда
		Если State = 0 Тогда
			// Удаляем звонок на панели
			УдалитьЗвонок(hCall);
		Иначе
			// Формируем структуру данных звонка
			СтруктураЗвонка = Новый Структура;
			СтруктураЗвонка.Вставить("hCall",				hCall);
			СтруктураЗвонка.Вставить("LineName",			LineName);
			СтруктураЗвонка.Вставить("State",				State);
			СтруктураЗвонка.Вставить("AvailableActions",	AvailableActions);
			СтруктураЗвонка.Вставить("НомерТелефона", 		НомерТелефона);
			Если Контакт = Неопределено Тогда
				Если НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Входящий Тогда
					СтруктураЗвонка.Вставить("Клиент",		CallerInfoName);
				Иначе
					СтруктураЗвонка.Вставить("Клиент",		CalledInfoName);
				КонецЕсли;	
				СтруктураЗвонка.Вставить("КонтактноеЛицо",	DopInfo);
			ИначеЕсли ТипЗнч(Контакт) = Тип("СправочникСсылка.Контрагенты") Тогда
				Ведущий = РаботаСКонтактнымиЛицами.ПолучитьВедущегоКонтрагента(Контакт);	
				Если ЗначениеЗаполнено(Ведущий) Тогда
					СтруктураЗвонка.Вставить("Клиент",			Ведущий);
					СтруктураЗвонка.Вставить("КонтактноеЛицо",	Контакт);
				Иначе
					СтруктураЗвонка.Вставить("Клиент",			Контакт);
					СтруктураЗвонка.Вставить("КонтактноеЛицо",	DopInfo);
				КонецЕсли;	
			Иначе
				СтруктураЗвонка.Вставить("Клиент",			Контакт);
				СтруктураЗвонка.Вставить("КонтактноеЛицо",	DopInfo);
			КонецЕсли;	
			Если НаправлениеЗвонка = ТипВходящийИсходящийЗвонок.Входящий Тогда
				СтруктураЗвонка.Вставить("Входящий", Истина);
				Если ВнутреннийВнешний = ТипВнутреннийВнешнийЗвонок.Внешний Тогда
					СтруктураЗвонка.Вставить("ВидЗвонка", НСтр("ru='Внешний входящий'"));
				Иначе
					СтруктураЗвонка.Вставить("ВидЗвонка", НСтр("ru='Внутренний входящий'"));
				КонецЕсли;	
			Иначе	
				СтруктураЗвонка.Вставить("Входящий", Ложь);
				Если ВнутреннийВнешний = ТипВнутреннийВнешнийЗвонок.Внешний Тогда
					СтруктураЗвонка.Вставить("ВидЗвонка", НСтр("ru='Внешний исходящий'"));
				Иначе
					СтруктураЗвонка.Вставить("ВидЗвонка", НСтр("ru='Внутренний исходящий'"));
				КонецЕсли;	
			КонецЕсли;	
			// Обновляем или создаем звонок на панели
			ДобавитьОбновитьЗвонок(СтруктураЗвонка);
			// Если больше одного звонка, то переходим на последний звонок
			Если Звонки.Количество() > 1 Тогда
				ПоследняяСтрока = Звонки[Звонки.Количество() - 1].ПолучитьИдентификатор();
				Элементы.Звонки.ТекущаяСтрока = ПоследняяСтрока;
            КонецЕсли;
			// Выводим форму наверх
			ЭтаФорма.Активизировать();			
		КонецЕсли;	
		ОбновитьОтображениеЗвонков();
	КонецЕсли;	
	Если State = 0 Тогда
		СтруктураВнешнихДанных = Неопределено;
		СтруктураОповещения = Новый Структура;
		СтруктураОповещения.Вставить("ИдентификаторЗвонка", ИдентификаторТекущегоЗвонка);
		Оповестить("СофтФон_КонецРазговора", СтруктураОповещения);		
		Если ЗаписьЗапущена И (ИдентификаторТекущегоЗвонка > 0) Тогда
			// Если завершаем разговор и разговор записывается,
			// то получаем данные о разговоре и обновляем информацию в регистре
			Если сфпСофтФонПроСервер.сфпИспользоватьCLON() Тогда
					// Обновляем продолжительность разговора
					СмещениеВремениCLON	= сфпСофтФонПроКлиент.сфпПолучитьСмещениеВремениCLON();
					СтруктураЗвонка		= Новый Структура;
					СтруктураЗвонка.Вставить("hCall",			ИдентификаторТекущегоЗвонка);
					СтруктураЗвонка.Вставить("RecordID",		-1);
					СтруктураЗвонка.Вставить("ОкончаниеЗаписи",	сфпСофтФонПроСервер.сфпТекущаяДата() + СмещениеВремениCLON);
					сфпСофтФонПроСервер.сфпЗаписатьОкончаниеРазговора(СтруктураЗвонка);
			КонецЕсли;
			ИдентификаторТекущегоЗвонка	= 0;
			ИдентификаторСобытия		= "";
			ЗаписьЗапущена				= Ложь;
		КонецЕсли;
	КонецЕсли;
	ИзменитьДоступностьКнопок();
КонецПроцедуры // Подключаемый_OnCallInfo()

&НаКлиенте
// Динамически подключаемый обработчик события "OnRecordInfo" внешней панели
// Отсутствие ссылок на процедуру не является ошибкой!
//
// Параметры:
//	RecordEventType		- Число		- Тип события
// 	hCall				- Число		- Идентификатор звонка. Может быть = 0.
//	LineID				- Строка	- Имя линии, на которой происходит звонок. Может быть = "".
//	RecordID			- Строка	- Идентификатор записи
//	TimeStart			- ДатаВремя	- Время начала записи
//	DurationTalk		- Число		- Продолжительность записи в секундах.
//	FileName			- Строка	- Имя файла звонка. Может быть = "".
//	ResultDescription	- Строка	- Описание ошибки. Может быть = "".
//	
Процедура Подключаемый_OnRecordInfo(RecordEventType, hCall, LineID, RecordID, TimeStart, DurationTalk, FileName, ResultDescription)
	Если НЕ сфпСофтФонПроСервер.сфпИспользоватьЗаписьПереговоров() Тогда Возврат; КонецЕсли;
	Если RecordEventType = 0 Тогда
		// Запись остановлена
	ИначеЕсли RecordEventType = 1 Тогда
		// Запись запущена
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("hCall",		hCall);
		СтруктураЗаписи.Вставить("LineID",		LineID);
		СтруктураЗаписи.Вставить("RecordID",	RecordID);
		сфпСофтФонПроСервер.сфпОбновитьЗаписьРазговораВРегистре(СтруктураЗаписи);
	ИначеЕсли RecordEventType = 2 Тогда
		// Файл записи сохранен
		СтруктураЗаписи = Новый Структура;
		Если hCall = 0 Тогда
			hCall = сфпСофтФонПроСервер.сфпПолучитьИдентификаторЗвонка(RecordID); 
		КонецЕсли;	
		Если (hCall > 0) И (DurationTalk > 0) Тогда
			СтруктураЗаписи.Вставить("hCall",			hCall);
			СтруктураЗаписи.Вставить("RecordID",		RecordID);
			СтруктураЗаписи.Вставить("DurationTalk",	DurationTalk);
			сфпСофтФонПроСервер.сфпЗаписатьПродолжительностьРазговора(СтруктураЗаписи);
		КонецЕсли;	
		FileName = сфпСофтФонПроКлиент.ПолучитьИмяФайлаЗаписиРазговора();
		Если ЗначениеЗаполнено(FileName) Тогда
			Попытка
				ЗапуститьПриложение(FileName);
			Исключение
			КонецПопытки;
		КонецЕсли;	
	ИначеЕсли RecordEventType = 3 Тогда
		// Сообщение об ошибке
		Состояние(ResultDescription);
	КонецЕсли;	
КонецПроцедуры // Подключаемый_OnRecordInfo()

&НаКлиенте
// Динамически подключаемый обработчик события "OnEvent" внешней панели
// Отсутствие ссылок на процедуру не является ошибкой!
//
// Параметры:
//	SA	- COMSafeArray	- Массив описания состояния линий
//
Процедура Подключаемый_OnAllLinesInfo(SA)
	ZA = SA.GetDimensions();
	Если НЕ (ZA = 2) Тогда Возврат; КонецЕсли;
	ZA = SA.GetUpperBound(0);
	Если НЕ (ZA = 5) Тогда Возврат; КонецЕсли;
	XA = SA.GetLowerBound(1);
	YA = SA.GetUpperBound(1);
	МассивЛиний = Новый Массив;
	Для ZA = XA По YA Цикл
		СтруктураЛинии = Новый Структура;
		СтруктураЛинии.Вставить("hLine",		SA.GetValue(0, ZA));
		СтруктураЛинии.Вставить("LineName",		SA.GetValue(1, ZA));
		СтруктураЛинии.Вставить("Number",		SA.GetValue(2, ZA));
		СтруктураЛинии.Вставить("LineType",		SA.GetValue(3, ZA));
		СтруктураЛинии.Вставить("Provider",		SA.GetValue(4, ZA));
		СтруктураЛинии.Вставить("LineState",	SA.GetValue(5, ZA));
		МассивЛиний.Добавить(СтруктураЛинии);
	КонецЦикла;
	Оповестить("OnAllLinesInfo", МассивЛиний, ЭтаФорма);
КонецПроцедуры // Подключаемый_OnAllLinesInfo()

