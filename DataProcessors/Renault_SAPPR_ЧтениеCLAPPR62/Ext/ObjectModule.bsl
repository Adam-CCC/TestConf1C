Перем ТЗРегистра Экспорт;

/////////////////////////////////////////////
//Точка входа

Процедура НайтиФайлыВКаталоге() Экспорт
	
	Если ЗначениеЗаполнено(ПутьКфайлу) тогда
		//Ищем файлы
		Фильтр = "*.RCD.*.*";
		ФайлыДанных = НайтиФайлы(ПутьКфайлу, Фильтр, Истина);
	КонецЕсли;
	
	//Заполняем табличную часть файлами.
	ФайлыКОбработке.Очистить();
	
	Для каждого ФайлДанных из ФайлыДанных Цикл
		НС = ФайлыКОбработке.Добавить();
		НС.ИмяФайла = ФайлДанных.Имя;
		НС.ПутьКФайлу = ФайлДанных.ПолноеИмя;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабличныйДокумент(ТабличныйДокумент) Экспорт
	
	ТабличныйДокумент.Очистить();
	
	//Выгружаем только отмеченные строки - эти файлы идут в обработку.
	Отбор = Новый Структура("Отметка", Истина);
	ВремТаб = ФайлыКОбработке.Выгрузить(Отбор);
	
	СчетчикСтрок = 2;
	
	ВывестиШапку(ТабличныйДокумент);
	
	Для каждого СтрокаФайлов из ВремТаб цикл
		
		// Комментарий 
		//Дата создания - 06.06.2012 14:41:22; Автор - Окипний Андрей Евгеньевич
		//Получим имя файла, по этим именам будем сортировать файлы к загрузке
		//
		
		ФайлДанных = Новый Файл(СтрокаФайлов.ПутьКФайлу);
		
		ИмяФайла = ФайлДанных.Имя;
		
		//Уничтожаем файл
		ФайлДанных = Неопределено;
		
		// Комментарий 
		//Дата создания - 06.06.2012 14:43:58; Автор - Окипний Андрей Евгеньевич
		//Теперь прочитаем файл в объект - текстовый документ
		//
		ТекстовыйДок = Новый ТекстовыйДокумент;
		ТекстовыйДок.Прочитать(СтрокаФайлов.ПутьКФайлу, "iso-8859-5");
		
		Для ТекущаяСтрока = 1 По ТекстовыйДок.КоличествоСтрок() Цикл
			
			ТекстСтроки = ТекстовыйДок.ПолучитьСтроку(ТекущаяСтрока);
			
			//Строки - разделители пропускаем
			Если Найти(ТекстСтроки, "*S*")<> 0 тогда Продолжить; КонецЕсли;
			
			МассивСтроки = РазложитьСтрокуВМассивПодстрок(ТекстСтроки);
			
			ТекущаяКолонка = 0;
			Для каждого Значение Из МассивСтроки Цикл
				
				ТекущаяКолонка = ТекущаяКолонка + 1;
				ТабличныйДокумент.Область("R" + Формат(СчетчикСтрок, "ЧГ=") +"C" + Формат(ТекущаяКолонка, "ЧГ=")).Текст = Значение;
				
			КонецЦикла;
			
			// Комментарий 
			//Дата создания - 06.06.2012 14:44:53; Автор - Окипний Андрей Евгеньевич
			//Добавим имя файла в таблицу
			//
			ТекущаяКолонка = ТекущаяКолонка + 1;
			ТабличныйДокумент.Область("R" + Формат(СчетчикСтрок, "ЧГ=") +"C" + Формат(ТекущаяКолонка, "ЧГ=")).Текст = ИмяФайла;
			
			СчетчикСтрок = СчетчикСтрок + 1;
			
		КонецЦикла;
		
		//сбросим привязку к файлу
		ТекстовыйДок = Неопределено;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьТаблицуЗначений(ТабличныйДокумент) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	SAPPR_Отгружено.PURCH_NO_C,
	|	SAPPR_Отгружено.ITM_NUMBER,
	|	SAPPR_Отгружено.MATERIAL,
	|	SAPPR_Отгружено.REQ_QTY,
	|	SAPPR_Отгружено.QTEXP,
	|	SAPPR_Отгружено.NUMBL,
	|	SAPPR_Отгружено.MAGMM,
	|	SAPPR_Отгружено.IN_PROGRESS,
	|	SAPPR_Отгружено.NON_PROCESSED,
	|	SAPPR_Отгружено.ЗаказПоставщику,
	|	SAPPR_Отгружено.Организация,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(30)) КАК ИмяФайла
	|ИЗ
	|	РегистрСведений.SAPPR_Отгружено КАК SAPPR_Отгружено
	|ГДЕ
	|	SAPPR_Отгружено.ЗаказПоставщику.Ссылка = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)");
	
	ТЗРегистра = Запрос.Выполнить().Выгрузить();
	ТЗРегистра.Очистить();
	
	// Комментарий 
	//Дата создания - 06.06.2012 14:39:40; Автор - Окипний Андрей Евгеньевич
	//Добавим индексы
	//
	ТЗРегистра.Индексы.Добавить("ИмяФайла");
	ТЗРегистра.Индексы.Добавить("PURCH_NO_C");
	ТЗРегистра.Индексы.Добавить("NUMBL");
	
	КоличествоСтрок  = ТабличныйДокумент.ВысотаТаблицы;
	
	Для К = 2 по КоличествоСтрок Цикл
		НС = ТЗРегистра.Добавить();
		
		//%+ Дата изменения - 02.07.2012 16:59:08; Автор - Окипний Андрей Евгеньевич
		//
		// Описание изменений
		//  Изменено получение числовых показателей. Их нужно делить на 10
		//
		//%-
		НС.PURCH_NO_C	 = ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C1").Текст;
		НС.ITM_NUMBER	 = ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C2").Текст;
		НС.MATERIAL		 = Прав(СокрЛП(ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C3").Текст), 10);
		НС.REQ_QTY		 = Число(?(ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C4").Текст="",0,
							ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C4").Текст))/10;
		НС.QTEXP		 = Число(?(ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C5").Текст = "",0,
							ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C5").Текст))/10;
		НС.NUMBL		 = ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C6").Текст;
		НС.MAGMM		 = ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C7").Текст;
		НС.IN_PROGRESS	 = Число(?(ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C8").Текст = "", 0,
							ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C8").Текст))/10;
		НС.NON_PROCESSED = Число(?(ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C9").Текст = "", 0,
							ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C9").Текст))/10;
		НС.ИмяФайла		 = СокрЛП(ТабличныйДокумент.Область("R"+Формат(К,"ЧГ=")+"C10").Текст);
		
	КонецЦикла;
	
	//Проставим ссылки на заказ и организацию
	Для каждого СтрокаТЗ из ТЗРегистра Цикл
		
		ЗаказСсылка = Документы.ЗаказПоставщику.НайтиПоНомеру(СокрЛП(СтрокаТЗ.PURCH_NO_C));
		
		Если НЕ ЗаказСсылка = Документы.ЗаказПоставщику.ПустаяСсылка() тогда
			СтрокаТЗ.ЗаказПоставщику = ЗаказСсылка;
			СтрокаТЗ.Организация = ЗаказСсылка.Организация;
			
		Иначе
			
			СтрокаТЗ.ЗаказПоставщику = СтрокаТЗ.PURCH_NO_C;
			
		КонецЕсли;
			
	КонецЦикла;
	
	ТЗРегистра.Сортировать("ИмяФайла Возр, PURCH_NO_C Возр");
	
КонецПроцедуры

Процедура ЗаписатьВРегистр() Экспорт
	
	Если Ложь тогда ТЗРегистра = Новый ТаблицаЗначений; КонецЕсли;
	
	////$+ Комментарий 
	// Дата создания - 06.06.2012 14:59:05;
	// Автор - Окипний Андрей Евгеньевич
	//
	//Формирование записей в hubcnh необходимо выполнять пофайлово.
	//для этого получим список используемых файлов из списка отмеченных
	//по этому списку будем копировать строки из ТЗРегистра и записывать в регистр.
	//
	//$-
	
	Отбор = Новый Структура("Отметка", Истина);
	СписокФайлов = ФайлыКОбработке.Выгрузить(Отбор,"ИмяФайла");
	
	СписокФайлов.Сортировать("ИмяФайла Возр");
	//Теперь будем работать с каждым файлом отдельно
	
	Для Каждого СтрокаФайла из СписокФайлов Цикл
		
		Отбор = Новый Структура("ИмяФайла", СтрокаФайла.ИмяФайла);
		ВремТЗ = ТЗРегистра.Скопировать(Отбор);
		
		ВремТЗ.Свернуть("PURCH_NO_C,ЗаказПоставщику");
		
		Для каждого СтрокаЗаказ Из ВремТЗ Цикл
		
			Отбор = Новый Структура;
			Отбор.Вставить("ЗаказПоставщику", СтрокаЗаказ.ЗаказПоставщику);
			Отбор.Вставить("PURCH_NO_C", СтрокаЗаказ.PURCH_NO_C);
			Отбор.Вставить("ИмяФайла", СтрокаФайла.ИмяФайла);
			
			ВрТЗ = ТЗРегистра.Скопировать(Отбор);
			
			////$+ Комментарий 
			// Дата создания - 06.06.2012 16:49:32;
			// Автор - Окипний Андрей Евгеньевич
			//
			//В поставках может быть несколько одинаковых реферансов !!!
			//Поэтому отобранные занные нужно предварительно свернуть.
			//$-
			
			ВрТЗ.Свернуть("ЗаказПоставщику,Организация,ITM_NUMBER,MATERIAL,PURCH_NO_C,NUMBL,MAGMM",
						  "IN_PROGRESS,NON_PROCESSED,REQ_QTY,QTEXP");
			
			НЗ = РегистрыСведений.SAPPR_Отгружено.СоздатьНаборЗаписей();
			НЗ.Отбор.PURCH_NO_C.Установить(СтрокаЗаказ.PURCH_NO_C);
			НЗ.Прочитать();
			
			НЗ.Загрузить(ВрТЗ);
			НЗ.Записать();
			
		КонецЦикла;
		
	КонецЦикла;
	
	Renault_Открытый.СообщитьПользователю("Записи в регистре Отгрузки по SAPPR сформированы.");
	
КонецПроцедуры

Процедура ОбработкаНаСервере() Экспорт
	
	НайтиФайлыВКаталоге();
	
	//На сервере обрабатываем все файлы
	//В цикле устанавливаем флаг по причине отсутствия соответсвующей функции у 
	//Табличной части!
	Для каждого СтрокаТЗ из ФайлыКОбработке Цикл СтрокаТЗ.Отметка = Истина; КонецЦикла;

	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ЗаполнитьТабличныйДокумент(ТабличныйДокумент);
	
	ПолучитьТаблицуЗначений(ТабличныйДокумент);
	
	ЗаписатьВРегистр();
	
	//Теперь нужно переименовать файлы
	Для каждого СтрокаТЗ из ФайлыКОбработке Цикл
		
		Попытка  //Переименование делаем в попытке, может не быть доступа
			
			ФайлОбъект = Новый Файл(СтрокаТЗ.ПутьКФайлу);
			
			ИмяБезРасширения = СтрЗаменить(ФайлОбъект.ИмяБезРасширения,".RCD.",".RC_.");
			Путь			 = ФайлОбъект.Путь;
			Расширение		 = ФайлОбъект.Расширение;
			
			ФайлОбъект = Неопределено;
			
			ПереместитьФайл(СтрокаТЗ.ПутьКФайлу, Путь+ИмяБезРасширения+Расширение);
			
		Исключение КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры


//////////////////////////////////////////////
//		Вспомогательные функции

Функция РазложитьСтрокуВМассивПодстрок(ТекстСтроки)
	
	МассивСтрок = Новый Массив();
	
	//Из строки нужно получить только определенные части
	НомерЗаказа = СокрЛП(Сред(ТекстСтроки, 32,35));
	МассивСтрок.Добавить(НомерЗаказа);
	ITM_NUMBER = Сред(ТекстСтроки, 67,6);
	МассивСтрок.Добавить(ITM_NUMBER);
	MATERIAL = Сред(ТекстСтроки, 73,18);
	МассивСтрок.Добавить(MATERIAL);
	REQ_QTY = Число(Сред(ТекстСтроки, 192,15))/100;  //делением на 100 выделяем дробную часть
	МассивСтрок.Добавить(REQ_QTY);
	QTEXP = Число(Сред(ТекстСтроки, 91,15))/100; //делением на 100 выделяем дробную часть
	МассивСтрок.Добавить(QTEXP);
	NUMBL = Сред(ТекстСтроки, 207,10);
	МассивСтрок.Добавить(NUMBL);
	MAGMM = Сред(ТекстСтроки, 228,4);
	МассивСтрок.Добавить(MAGMM);
	IN_PROGRESS = Число(Сред(ТекстСтроки, 235,13))/100; //делением на 100 выделяем дробную часть
	МассивСтрок.Добавить(IN_PROGRESS);
	NON_PROCESSED = Число(Сред(ТекстСтроки, 248,15))/100; //делением на 100 выделяем дробную часть
	МассивСтрок.Добавить(NON_PROCESSED);
	
	Возврат МассивСтрок;
КонецФункции

Процедура ВывестиШапку(ТабличныйДокумент)
	
	ТабличныйДокумент.Область("R1C1").Текст = "Номер заказа";
	ТабличныйДокумент.Область("R1C2").Текст = "Номер строки";
	ТабличныйДокумент.Область("R1C3").Текст = "Реферанс";
	ТабличныйДокумент.Область("R1C4").Текст = "Заказано";
	ТабличныйДокумент.Область("R1C5").Текст = "Отгружено";
	ТабличныйДокумент.Область("R1C6").Текст = "Номер поставки в SAPPR";
	ТабличныйДокумент.Область("R1C7").Текст = "Склад отгрузки";
	ТабличныйДокумент.Область("R1C8").Текст = "В процессе";
	ТабличныйДокумент.Область("R1C9").Текст = "Осталось отгрузить";
	ТабличныйДокумент.Область("R1C10").Текст = "Имя файла";
	
КонецПроцедуры