&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Свойство("Идентификатор", Идентификатор) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Параметры.Свойство("Наименование", Наименование);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НачальноеОформлениеФормы(); 
КонецПроцедуры

&НаКлиенте
Процедура НачальноеОформлениеФормы() 
	МассивАктив = Новый Массив;
	МассивАктив.Добавить(Элементы.кнСохранить);  	
	
	Renault_ОбщиеФункции.МультибрендОсновноеОформление(МассивАктив);	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	Если НЕ ЗначениеЗаполнено(Дата) И НЕ ЗначениеЗаполнено(Время) Тогда  		
		Сообщить("Необходимо ввести дату и время!");
		Возврат;   		
	КонецЕсли;
	
	ДанныеНапоминания = Новый Структура("Идентификатор, Дата, Время, Наименование, Сообщение",
		Идентификатор, Дата, Время, Наименование, Сообщение);
		
	СоздатьНапоминание(ДанныеНапоминания);
	
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьНапоминание(ДанныеНапоминания)
	Идентификатор = ДанныеНапоминания.Идентификатор;
	Дата = ДанныеНапоминания.Дата;
	Время = ДанныеНапоминания.Время; 	
	Наименование = ДанныеНапоминания.Наименование;
	Сообщение = ДанныеНапоминания.Сообщение; 
	ТекПользователь = ПараметрыСеанса.Пользователь;
	ТекСотрудник = ТекПользователь.Сотрудник;
	Показ = Дата(Формат(Дата, "ДФ=yyyyMMdd") + СтрЗаменить(?(СтрДлина(СокрЛП(Время)) = 5, Время, "0" + СокрЛП(Время)), ":", "") + "00");
	
	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент(); 	
	Напоминание.Отправитель = ТекПользователь; 	
	Напоминание.Адресаты.Добавить().Сотрудник = ТекСотрудник; 	
	Напоминание.ДатаОтправки = ТекущаяДата(); 	
	Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.КЦ_Уведомление;
	Напоминание.ИдентификаторОбъекта = Идентификатор;
	Напоминание.Обработано = Ложь;
	Напоминание.ПоказыватьС = Показ;
	Напоминание.ПоказыватьПо = Показ;
	Напоминание.Наименование = Наименование;
	Напоминание.Сообщение = Сообщение;  	
	Напоминание.Записать(); 
КонецПроцедуры

