	Элементы.ПанельОбщая.ТекущаяСтраница = Элементы.РолиИстории;
	СнятьВыделениеКнопки();
	Элементы.ОткрытьРолиИстории.Шрифт	= Новый Шрифт(,,Истина);
	
КонецПроцедуры

