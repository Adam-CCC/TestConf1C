&НаКлиенте
Процедура ОчиститьИсториюНажатие(Команда)
	
	ЗаполнитьТаблицы = Ложь;
	Если ДатаОчистки > ТекущаяДата() Тогда 
		Предупреждение("Указана неправильная дата!");
		Возврат
	КонецЕсли;

	Если ДатаОчистки = Дата (1, 1, 1) Тогда 
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Вы действительно хотите ПОЛНОСТЬЮ очистить журнал?", Режим, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
		    Возврат;
		КонецЕсли;
		
		Удачно = Renault_внОбщийМодуль.ОчиститьЖурналРегистрацииПолностью();
		ЗаполнитьТаблицы = Истина;
	Иначе
		
		Если НеобходимоСжатиеПередОчисткой() Тогда
			Если Вопрос("Перед очисткой журнала регистрации необхожимо его сжать. Произвести сжатие сейчас?", РежимДиалогаВопрос.ДаНет, 0) = КодВозвратаДиалога.Да Тогда
				СжатьИсториюНажатие(Команда, Ложь);
			Иначе 
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("ОбновитьПрогрессОчистки", 1, Истина);
		Удачно = Renault_внОбщийМодуль.ОчиститьЖурналРегистрацииНаДату(Истина, ДатаОчистки);
		
	КонецЕсли;
	
	Если Удачно Тогда
		Оповестить("внОбновитьИсторию");
		Предупреждение("История очищена!");
		Если ЗаполнитьТаблицы Тогда 
			Renault_внОбщийМодуль.ПриНачалеРаботыСистемы();
		КонецЕсли;
	Иначе
		Предупреждение("Подключение не может быть установлено...");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СжатьИсториюНажатие(Команда, Оповещать = Истина)
	
	Удачно = Renault_внОбщийМодуль.СжатьИсториюИзменений(Истина, Ложь);
	Если Удачно Тогда
		Оповестить("внОбновитьИсторию");
		Если НЕ Оповещать = Ложь Тогда 
			Предупреждение("История сжата!");
		КонецЕсли;
	Иначе
		Предупреждение("Подключение не может быть установлено...");
	КонецЕсли;
	
КонецПроцедуры

