////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ

//
// Процедура выполняет обновление информационной базы в случае необходимости.
//
Процедура ВыполнитьОбновление() Экспорт
	ТекущаяВерсия = Renault_внОбщийМодульПовтИсп.глВНЗначениеПеременной("Версия");
	
	ПоследняяВерсия = "2.0.3.6";
	
	Если ТекущаяВерсия = ПоследняяВерсия Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ТекущаяВерсия) Тогда
		// Это первый запуск
		// 		
		ЗаполнитьПервоначальнымиДанными();
		
	Иначе
				
		Если ТекущаяВерсия = "2.0.2.3" Тогда
			Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ФиксироватьПерепроведенияДокументов",	Истина);
			
			ПереходНаВерсию_2_0_3_4();
			
			ТекущаяВерсия = "2.0.3.4";
		КонецЕсли;
		
		Если ТекущаяВерсия = "2.0.2.4" Тогда
			ТекущаяВерсия = "2.0.3.5";
		КонецЕсли;
		
		Если ТекущаяВерсия = "2.0.3.4" ИЛИ ТекущаяВерсия = "2.0.2.4" ИЛИ ТекущаяВерсия = "2.0.3.5" Тогда
			ТекущаяВерсия = "2.0.3.6";
		КонецЕсли;
		
		Сообщить("Подсистема <Журнал регистрации изменений во внешней БД MS SQL Server> обновлена на версию " + ПоследняяВерсия);
	КонецЕсли;
	
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("Версия", ПоследняяВерсия);
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

Процедура ЗаполнитьПервоначальнымиДанными() Экспорт
	
	// Удаляем регистры из регистрируемых объектов
	НаборЗаписей = РегистрыСведений.Renault_внНеРегистрируемыеОбъекты.СоздатьНаборЗаписей();
	Для каждого Регистр Из Метаданные.РегистрыСведений Цикл
		НоваяЗапись						= НаборЗаписей.Добавить();
		НоваяЗапись.МетаданныеОбъекта	= Регистр.ПолноеИмя();
		НоваяЗапись.ИмяТЧ				= "";
		НоваяЗапись.ИмяРеквизита		= "";
		НоваяЗапись.НеРегистрировать	= Истина;
	КонецЦикла;
	НаборЗаписей.Записать(Истина);
	
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ОчищатьЖурналРегистрацииАвтоматически", 		Ложь);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ПериодАвтоматическойОчисткиЖурналаРегистрации",365);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ТаймаутСоединенияИБ", 							180);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ИспользоватьПараметрУникальностиИБ",			Истина);
	Параметры																							= Renault_внОбщийМодуль.ПараметрУникальностиИБ();
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ПараметрУникальностиСписокСерверов",			Параметры.Сервер);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ПараметрУникальностиИмяБазы",					Параметры.ИмяБазы);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ИдентификаторИБ",								Метаданные.Имя);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ИнтервалПроверкиПодпискиНаСобытия",			900);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ТипОбменаРИБ",									Перечисления.Renault_внТипОбменаРИБ.УпрощенныйОбмен);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ТипБД",										Перечисления.Renault_внТипБД.MSSQL);
	Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ФиксироватьПерепроведенияДокументов",			Истина);
	
	// Установка узла РИБ
	Выборка = Справочники.Renault_внУзлыРИБ.Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Элемент = Справочники.Renault_внУзлыРИБ.СоздатьЭлемент();
		Элемент.Наименование = "Главная ИБ";
		Элемент.Записать();
		
		Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ТекущийУзелРИБ",							Элемент.Ссылка);
	Иначе
		Renault_внОбщийМодуль.УстановитьНастройкуЖурналаРегистрации("ТекущийУзелРИБ",							Выборка.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПереходНаВерсию_2_0_3_4()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	внКэшЖурналаРегистрации.Ссылка,
		|	внКэшЖурналаРегистрации.ГУИДОбъекта
		|ИЗ
		|	Справочник.Renault_внКэшЖурналаРегистрации КАК внКэшЖурналаРегистрации
		|ГДЕ
		|	ПОДСТРОКА(внКэшЖурналаРегистрации.ГУИДОбъекта, 1, 5) = ""{""""#"""",""
		|
		|УПОРЯДОЧИТЬ ПО
		|	внКэшЖурналаРегистрации.ДатаИзменения"
	);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Ссылка = ЗначениеИзСтрокиВнутр(Выборка.ГУИДОбъекта);
			Об = Выборка.Ссылка.ПолучитьОбъект();
			Об.ГУИДОбъекта = Renault_внОбщийМодуль.СистемноеПредставлениеОбъекта(Ссылка);
			Для Каждого Строки Из Об.внИзменения Цикл
				
				Попытка
					Значение = ЗначениеИзСтрокиВнутр(Строки.Значение);
				Исключение
					Продолжить;
				КонецПопытки;

				Строки.Значение = Renault_внОбщийМодуль.СистемноеПредставлениеОбъекта(Значение);
				
			КонецЦикла;
			Об.Записать();
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры