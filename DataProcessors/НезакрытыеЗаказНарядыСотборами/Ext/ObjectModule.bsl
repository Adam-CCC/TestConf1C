Функция НайтиЗаказЗапчастей(ЗаказНаряд)
	
	ЗаказКлиента = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка КАК Ссылка,
		|	ЗаказПокупателя.Проведен КАК Проведен,
		|	ЗаказПокупателя.Дата КАК Дата,
		|	ЗаказПокупателя.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Проведен
		|	И ЗаказПокупателя.ДокументОснование = &ЗаказНаряд
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаказКлиента  = ВыборкаДетальныеЗаписи.Ссылка; 
		Прервать;
 	КонецЦикла;
	
	Возврат ЗаказКлиента;
 
КонецФункции // НайтиЗаказЗапчастей(ЗаказНаряд)

Функция НайтиПриходЗапчастей(ЗаказКлиента)
	
	ПриходЗапчастей = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыПокупателейОбороты.Заказ КАК Заказ,
	               |	ЗаказыПокупателейОбороты.Период КАК Период,
	               |	ЗаказыПокупателейОбороты.Регистратор КАК Регистратор,
	               |	ЗаказыПокупателейОбороты.РезервПриход КАК РезервПриход
	               |ИЗ
	               |	РегистрНакопления.ЗаказыПокупателей.Обороты(, , Регистратор, ) КАК ЗаказыПокупателейОбороты
	               |ГДЕ
	               |	ЗаказыПокупателейОбороты.Заказ = &ЗаказКлиента
	               |	И ТИПЗНАЧЕНИЯ(ЗаказыПокупателейОбороты.Регистратор) = ТИП(Документ.ПоступлениеТоваров)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПриходЗапчастей  = ВыборкаДетальныеЗаписи.Регистратор; 
		Прервать;
 	КонецЦикла;
	
	Возврат ПриходЗапчастей;
 
КонецФункции // НайтиПриходЗапчастей(ЗаказКлиента)

Процедура РассылкаОтчетаПоНезакрытымЗН(Параметры = Неопределено) Экспорт
	ТекущаяДата = ТекущаяДата();
	Если Параметры <> Неопределено И ТипЗнч(Параметры[0]) = Тип("ПеречислениеСсылка.ИсточникиРассылки") Тогда
		ИсточникРассылки = Параметры[0];
	Иначе
		ИсточникРассылки = Перечисления.ИсточникиРассылки.Незакрытые;
	КонецЕсли;
	
	НаборДляРассылки = РегистрыСведений.РассылкаПочты.СоздатьНаборЗаписей();
	НаборДляРассылки.Отбор.ТипРассылки.Установить(Перечисления.ТипыРассылок.НезакрытыеЗН);
	НаборДляРассылки.Отбор.ИсточникРассылки.Установить(Перечисления.ИсточникиРассылки.Незакрытые);
	НаборДляРассылки.Прочитать();
	
 	НаборДляВсехДЦ = РегистрыСведений.РассылкаПочты.СоздатьНаборЗаписей();
	НаборДляВсехДЦ.Отбор.ТипРассылки.Установить(Перечисления.ТипыРассылок.ВсеНезакрытыеЗН);
	НаборДляВсехДЦ.Отбор.ИсточникРассылки.Установить(Перечисления.ИсточникиРассылки.Незакрытые);
	НаборДляВсехДЦ.Прочитать();
	
	Если НаборДляРассылки.Количество() + НаборДляВсехДЦ.Количество() = 0 Тогда 
 		ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
		        УровеньЖурналаРегистрации.Предупреждение, , ,
		        "Список адресатов рассылки пуст!"); 
 		Возврат;
	КонецЕсли;
	
	//обрФормироватьОтчет = Обработки.ФормированиеОтчетаУРВ.Создать();
	//обрФормироватьОтчет.Дата = ТекущаяДата;
	//обрФормироватьОтчет.СформироватьОтчет();
	
	// цикл по ТЧ ОтчетыПоДЦ
	
	Для Каждого СтрокаОтчет Из ОтчетыПоДЦ Цикл
 		ЭлПисьмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();	 
 		Для Каждого Рассылка из НаборДляВсехДЦ Цикл
			АдресЭлПочты = киПолучитьПредставлениеКИ(Рассылка.Сотрудники, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
			Если ЗначениеЗаполнено(АдресЭлПочты) Тогда
 				СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
				СтрокаПолучатели.АдресЭлектроннойПочты = АдресЭлПочты;
				СтрокаПолучатели.Представление = АдресЭлПочты;
				СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
		        ЭлПисьмо.ПолучателиПредставление = ЭлПисьмо.ПолучателиПредставление +?(ЭлПисьмо.ПолучателиПредставление = "", АдресЭлПочты, ";" + АдресЭлПочты);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Рассылка из НаборДляРассылки Цикл
			// проверка на принадлежность текущему ДЦ
			//Бондаренко++ 20240607
			//Подразделение = Рассылка.Сотрудники.Подразделение;
			Подразделение = Рассылка.Подразделение; 
 			//Если ЗначениеЗаполнено(Рассылка.Подразделение) Тогда
			//	ДЦРассылка = Рассылка.Подразделение.ДилерскийЦентр;
			//Иначе
			//	ДЦРассылка = Справочники.ДилерскиеЦентры.ПустаяСсылка();
			//КонецЕсли;
 			//Если СтрокаОтчет.ДЦ.ДилерскийЦентр = Подразделение.ДилерскийЦентр Или СтрокаОтчет.ДЦ = ДЦРассылка Тогда
			Если СтрокаОтчет.ДЦ = Подразделение Тогда
			//Бондаренко-- 20240607
				АдресЭлПочты = киПолучитьПредставлениеКИ(Рассылка.Сотрудники, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
				Если ЗначениеЗаполнено(АдресЭлПочты) Тогда
					СтрокаПолучатели = ЭлПисьмо.Получатели.Добавить();
					СтрокаПолучатели.АдресЭлектроннойПочты = АдресЭлПочты;
					СтрокаПолучатели.Представление = АдресЭлПочты;
					СтрокаПолучатели.КодГруппыАдреса = Перечисления.КодГруппыАдресаЭлектронногоПисьма.Кому;
			        ЭлПисьмо.ПолучателиПредставление = ЭлПисьмо.ПолучателиПредставление +?(ЭлПисьмо.ПолучателиПредставление = "", АдресЭлПочты, ";" + АдресЭлПочты);
				КонецЕсли;                                      
 			КонецЕсли;
		КонецЦикла;
		
		Если ЭлПисьмо.Получатели.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
			        УровеньЖурналаРегистрации.Предупреждение, , ,
			        "Ни у одного из адресатов рассылки не указан e-mail!"); 
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаОтчет.ИмяФайла) Тогда
			// добавить вложение
			Попытка
				ДвДанные = Новый ДвоичныеДанные(СтрокаОтчет.ИмяФайла);
				ВыбранныйФайл = Новый Файл(СтрокаОтчет.ИмяФайла);
				ФайлВложение = ЭлПисьмо.ПрикрепленныеФайлы.Добавить();
				ФайлВложение.Файл = Новый ХранилищеЗначения(ДвДанные);
				ФайлВложение.Размер = ВыбранныйФайл.Размер();
				ФайлВложение.Имя = Строка(СтрокаОтчет.ДЦ) + "_ОтчетПоНезакрытымЗН_" + Формат(ТекущаяДата, "ДЛФ=Д") + ВыбранныйФайл.Расширение;
				ЭлПисьмо.ЕстьВложения = Истина;
			Исключение
				ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
				        УровеньЖурналаРегистрации.Ошибка, , ,
				        "Ошибка при обработке файла-отчета: " + ОписаниеОшибки()); 
				Возврат;
			КонецПопытки;		
			// Удаление использованного файла-отчета
			Попытка
			    УдалитьФайлы(СтрокаОтчет.ИмяФайла);  
			Исключение
				ЗаписьЖурналаРегистрации("РегламентноеЗадание.РассылкаОтчетаПоУРВ", 
				        УровеньЖурналаРегистрации.Ошибка, , ,
				        "Ошибка при удалении файла-отчета: " + ОписаниеОшибки()); 
			КонецПопытки;
			ЭлПисьмо.ТекстПисьма= "Во вложении - отчёт по незакрытым ЗН для ДЦ """ + Строка(СтрокаОтчет.ДЦ) + """.";
		Иначе
			ЭлПисьмо.ТекстПисьма= "По ДЦ """ + Строка(СтрокаОтчет.ДЦ) + """ нарушений закрытия ЗН нет.";
		КонецЕсли;
		
		ЭлПисьмо.Тема = "ДЦ """ + Строка(СтрокаОтчет.ДЦ) + """: отчет по незакрытым ЗН от " + Формат(ТекущаяДата, "ДЛФ=ДД");
		ЭлПисьмо.УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.Альфа;	
		ЭлПисьмо.Организация =   ПараметрыСеанса.Пользователь.Организация;
		ЭлПисьмо.ПодразделениеКомпании = ПараметрыСеанса.Пользователь.Подразделение;
		ЭлПисьмо.Автор   = ПараметрыСеанса.Пользователь;
		
		СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	    СтрокаСоединения = СтрЗаменить(СтрокаСоединения, ";", Символы.ПС);
		Если Найти(ВРег(СтрокаСоединения), "FILE=") = 1  Тогда
			// файловая
	        ИмяИБ = СтрПолучитьСтроку(СтрокаСоединения, 1);
	    Иначе
			// клиент-сервер
	        ИмяИБ = СтрПолучитьСтроку(СтрокаСоединения, 2);
		КонецЕсли;	
	    Если НЕ Пустаястрока(ИмяИБ) Тогда
			ИмяИБ = Сред(ИмяИБ, Найти(ИмяИБ, """") + 1);
		КонецЕсли;		
		ЭлПисьмо.ОтправительПредставление = "Альфа-Авто" + " (" + Лев(ИмяИБ, СтрДлина(ИмяИБ) - 1) + ") <1c@sokolmotors.ru>";
		
		ЭлПисьмо.ГруппаПисем = Справочники.ГруппыПисемЭлектроннойПочты.НайтиПоНаименованию("Исходящие");
		ЭлПисьмо.Важность = Перечисления.Важность.Средняя;
		ЭлПисьмо.ДатаОтправления = ТекущаяДата;
		ЭлПисьмо.Дата = ТекущаяДата;
		ЭлПисьмо.ХозОперация = Справочники.ХозОперации.ЭлектронноеПисьмо;
		ЭлПисьмо.ФорматТекста = Перечисления.ФорматТекста.ПростойТекст; 
		ЭлПисьмо.Записать();
		
		СтруктураРежимовОбмена = Новый Структура("Получить, Отправить", Ложь, Истина);
		СоединениеСПочтовымСервером = эпПодключитьсяКПочтовомуСерверу(ЭлПисьмо.УчетнаяЗапись, СтруктураРежимовОбмена);
		Если СоединениеСПочтовымСервером <> Неопределено Тогда
			Если эпОтправитьПисьмо(ЭлПисьмо.ЭтотОбъект, СоединениеСПочтовымСервером) Тогда
				эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
			Иначе
				эпОтключитьсяОтПочтовогоСервера(СоединениеСПочтовымСервером);
			КонецЕсли;	
		КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция ОпределитьВремяПеремещенияГрафик(ДЦ_уход,ДЦ_приход)
	
	ВремяНаПеремещение = 0;
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрУход КАК ДилерскийЦентрУход,
		|	ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрПриход КАК ДилерскийЦентрПриход,
		|	ВремяНаПеремещениеМеждуДЦ.Продолжительность КАК Продолжительность
		|ИЗ
		|	РегистрСведений.ВремяНаПеремещениеМеждуДЦ КАК ВремяНаПеремещениеМеждуДЦ
		|ГДЕ
		|	ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрУход = &ДилерскийЦентрУход
		|	И ВремяНаПеремещениеМеждуДЦ.ДилерскийЦентрПриход = &ДилерскийЦентрПриход";
	
	Запрос.УстановитьПараметр("ДилерскийЦентрУход", ДЦ_уход);
	Запрос.УстановитьПараметр("ДилерскийЦентрПриход", ДЦ_приход);
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВремяНаПеремещение =  ВыборкаДетальныеЗаписи.Продолжительность/60;
	КонецЦикла;
	
	Возврат ВремяНаПеремещение;
 
КонецФункции // ОпределитьВремяПеремещенияГрафик()

Функция ЧислоВЧасыМинуты(ЧислоВчасах)
	
    Стр = "";		
	
	Час = Цел(ЧислоВчасах);
	Мин = (ЧислоВчасах-Час)*60;
	
	Если Час > 0 Тогда
		Если Мин > 0 Тогда
			Стр = СокрЛП(Час)+" час. "+СокрЛП(Мин)+" мин.";	
		Иначе	
 			Стр = СокрЛП(Час)+" час.";	
		КонецЕсли;
	Иначе	
		Если Мин > 0 Тогда
			Стр = СокрЛП(Мин)+" мин.";	
		Иначе	
			Стр = " --- ";	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Стр;
	

КонецФункции // ЧислоВЧасыМинуты(ЧислоВчасах)
