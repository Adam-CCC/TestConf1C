// Функция возвращает строку прочитанную из XML файла
// ЧтениеXML - Объект XML файла
//
Функция ПрочитатьСтроку(Знач ЧтениеXML, Знач Имя="")
	Если НЕ ЧтениеXML.Прочитать() Тогда
		ВызватьИсключение "Не удалось считать значение";
	КонецЕсли;
	// +++++ Соколмоторс +++++
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Если НЕ ЧтениеXML.Прочитать() Тогда
			ВызватьИсключение "Не удалось считать значение";
		КонецЕсли;
	КонецЕсли;
	// ----- Соколмоторс -----
	Если НЕ ЧтениеXML.ТипУзла=ТипУзлаXML.Текст Тогда
		Если ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
			Возврат "";
		Иначе
			ВызватьИсключение "Ожидается тип узла ""Текст""";
		КонецЕсли;
	КонецЕсли;
	Стр=ЧтениеXML.Значение;
	Если НЕ ЧтениеXML.Прочитать() Тогда
		ВызватьИсключение "Не удалось считать окончание узла";
	КонецЕсли;
	Если НЕ ЧтениеXML.ТипУзла=ТипУзлаXML.КонецЭлемента Тогда
		ВызватьИсключение "Ожидается тип узла ""Конец элемента""";;
	КонецЕсли;
	Возврат Стр;
КонецФункции

// Найти узел создания объекта
Функция НайтиУзелСозданияОбъекта() Экспорт
	ПредставлениеОтправителя = Неопределено;
	Попытка
		ТекущийОбъект = ОбъектСсылка.ПолучитьОбъект();
		Отправитель = ТекущийОбъект.ОбменДанными.Отправитель;
		Если (Отправитель = Неопределено)Или (Отправитель.Пустая())Тогда
			Отправитель = ПланыОбмена.УдаленныеПодразделения.ЭтотУзел().Ссылка;
		КонецЕсли;
		ПредставлениеОтправителя = "Узел создания объекта: " + Отправитель.ПодразделениеКомпании + " [" + Отправитель.Наименование + "]";
	Исключение
	КонецПопытки;
	Возврат ПредставлениеОтправителя;
КонецФункции// НайтиУзелСозданияОбъекта()

#Если Клиент Тогда
// Формирует журнал регистрации
Процедура СформироватьЖурналРегистрации(ЖурналРегистрации = Неопределено) Экспорт
	ФормаОтчета = ЭтотОбъект.ПолучитьФорму("Форма");
	Если ЖурналРегистрации = Неопределено Тогда
		ЖурналРегистрации = ФормаОтчета.ЭлементыФормы["ЖурналРегистрации"].Значение;		
	КонецЕсли;
	ЖурналРегистрации.Очистить();  
	
	ФильтрЖурнала = Новый Структура;
	Если (НЕ ОбъектСсылка = Неопределено) И (НЕ ОбъектСсылка.Пустая()) Тогда
		ФильтрЖурнала.Вставить("Данные",ОбъектСсылка);
	Иначе
		Предупреждение("Выберите объект!");
		Возврат;
	КонецЕсли;	
	
	ИмяФайлаЖурналаРегистрации = КаталогВременныхФайлов() + "Reg1C.xml";
	
	ВыгрузитьЖурналРегистрации(ИмяФайлаЖурналаРегистрации, ФильтрЖурнала);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайлаЖурналаРегистрации);
	ЧтениеXML.Прочитать();
	Если ЧтениеXML.ЛокальноеИмя <> "EventLog" Тогда
		Сообщить("Неверный формат файла");
		Возврат;
	КонецЕсли;
	
	ЖурналРегистрации.Очистить();  
	
	Пока ЧтениеXML.Прочитать() Цикл
		ЛокальноеИмя = ЧтениеXML.ЛокальноеИмя;
		Если ЛокальноеИмя = "Event" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ОбработкаПрерыванияПользователя();
			СтрТЗ = ЖурналРегистрации.Добавить();
		ИначеЕсли ЛокальноеИмя = "Date" Тогда
			СтрТЗ.Date = XMLЗначение(Тип("Дата"),ПрочитатьСтроку(ЧтениеXML));
		Иначе
			Если ЖурналРегистрации.Колонки.Найти(ЛокальноеИмя) <> Неопределено Тогда				
				СтрТЗ[ЛокальноеИмя] = ПрочитатьСтроку(ЧтениеXML);
				
				Если ЛокальноеИмя = "UserName" Тогда
					ДатаРегистрации=Неопределено;
					МассивСоединений=ПолучитьСоединенияИнформационнойБазы();
					Если ТипЗнч(МассивСоединений) = Тип("Массив") Тогда
						Для Каждого ТекущееСоединение Из МассивСоединений Цикл
							Если (НЕ ТекущееСоединение.Пользователь = Неопределено) И 
									(ТекущееСоединение.Пользователь.Имя=СтрТЗ[ЛокальноеИмя]) И (ТекущееСоединение.ИмяПриложения=СтрТЗ["ApplicationName"]) Тогда
								ДатаРегистрации=ТекущееСоединение.НачалоСеанса;
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					
					Если ДатаРегистрации<>Неопределено Тогда
						СтрТЗ["ДатаРегистрации"] = ДатаРегистрации;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ФормаОтчета.ЭлементыФормы.ГиперссылкаНаОтправителя.Заголовок = НайтиУзелСозданияОбъекта();
	Если НЕ ФормаОтчета.Открыта() Тогда
		ФормаОтчета.Открыть();
	КонецЕсли;
КонецПроцедуры// СформироватьЖурналРегистрации() Экспорт
#КонецЕсли