
#Область СлужебныеПроцедурыИФункции

// Функция - Получить адрес
//
// Параметры:
//  ИмяСервиса	 - Строка - Имя HTTP сервиса
// 
// Возвращаемое значение:
//  Строка - Адрес ресурса
//
Функция ПолучитьАдрес(ИмяСервиса)

	Возврат НастройкаОбмена.Путь + ИмяСервиса + "/";

КонецФункции // ПолучитьАдрес()

// Создает и возвращает HTTP соединение
// 
// Возвращаемое значение:
//  HTTPСоединение - HTTP Соединение с сервером Рено Партс
//
Функция СоздатьСоединение()

    Возврат Новый HTTPСоединение(НастройкаОбмена.Сервер,
	                             НастройкаОбмена.Порт,
								 НастройкаОбмена.Пользователь,
                                 НастройкаОбмена.Пароль);

КонецФункции // СоздатьСоединение()

#КонецОбласти


#Область ВыгрузкаОстатков

// Возвращает массив структур данных об остатках запчастей
// 
// Возвращаемое значение:
//  Маасив - Массив структур данных об остатках
//
Функция ПолучитьОстаткиЗапчастей()

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |	Renault_НастройкиОбменаСРеноПартсСкладыОстатков.Склад
                   |ПОМЕСТИТЬ ВТ_СкладыОстатков
                   |ИЗ
                   |	Справочник.Renault_НастройкиОбменаСРеноПартс.СкладыОстатков КАК Renault_НастройкиОбменаСРеноПартсСкладыОстатков
                   |ГДЕ
                   |	Renault_НастройкиОбменаСРеноПартсСкладыОстатков.Ссылка = &НастройкаОбмена
                   |
                   |СГРУППИРОВАТЬ ПО
                   |	Renault_НастройкиОбменаСРеноПартсСкладыОстатков.Склад
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |	ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул КАК NumCat,
                   |	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток - ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК Balance
                   |ПОМЕСТИТЬ ВТ_Итоговая
                   |ИЗ
                   |	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(
                   |			,
                   |			СкладКомпании В
                   |				(ВЫБРАТЬ
                   |					СкладыОстатков.Склад
                   |				ИЗ
                   |					ВТ_СкладыОстатков КАК СкладыОстатков)) КАК ОстаткиТоваровКомпанииОстатки
                   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
                   |		ПО ОстаткиТоваровКомпанииОстатки.Номенклатура.Артикул = Renault_КаталогРеферансов.Артикул
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |	ВТ_Итоговая.NumCat,
                   |	СУММА(ВТ_Итоговая.Balance) КАК Balance
                   |ИЗ
                   |	ВТ_Итоговая КАК ВТ_Итоговая
                   |ГДЕ
                   |	ВТ_Итоговая.NumCat <> 0
                   |
                   |СГРУППИРОВАТЬ ПО
                   |	ВТ_Итоговая.NumCat";

	Запрос.УстановитьПараметр("НастройкаОбмена", НастройкаОбмена);			   

    Выборка = Запрос.Выполнить().Выбрать();

    МассивОстатков = Новый Массив;
    Пока Выборка.Следующий() Цикл
        МассивОстатков.Добавить(Новый Структура("Reference, Qty", СокрЛП(ВРег(Выборка.NumCat)), Выборка.Balance));
    КонецЦикла;

    Возврат МассивОстатков;

КонецФункции // ПолучитьОстаткиЗапчастей()

// Формирует строку в формате JSON для выгрузки остатков
// 
// Возвращаемое значение:
//  Строка - Строка данных об остатках в формате JSON
//
Функция СформироватьЗапросПоОстаткам()

	ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(,Символы.Таб));

    СтруктураЗапроса = Новый Структура;
    СтруктураЗапроса.Вставить("DMD", НастройкаОбмена.DMD);
    СтруктураЗапроса.Вставить("Stock", ПолучитьОстаткиЗапчастей());

    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);

    Возврат ЗаписьJSON.Закрыть();

КонецФункции // СформироватьЗапросПоОстаткам()

// Выгружает остатки запчастей в Рено Партс
//
Процедура ВыгрузитьОстатки() Экспорт

	ЗапросПоОстаткамJSON = СформироватьЗапросПоОстаткам();

	Запрос = Новый HTTPЗапрос(ПолучитьАдрес("UpdateStock")); 
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(ЗапросПоОстаткамJSON);

	Соединение = СоздатьСоединение();
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);

	Если СтруктураОтвета.ReturnCode <> "H000" Тогда
		Сообщить("Ошибка " + СтруктураОтвета.ReturnCode);
		Возврат;
	КонецЕсли;

	Сообщить("Остатки успешно выгружены");

КонецПроцедуры // ВыгрузитьОстатки()

#КонецОбласти


#Область ОбновлениеКлиентов

// Возвращает массив структур групп контрагентов
// 
// Возвращаемое значение:
//  Массив - Массив структур групп контрагентов
//
Функция ПолучитьСписокГрупп()

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |    Renault_ГруппыКонтрагентов.Код,
                   |    Renault_ГруппыКонтрагентов.Наименование,
                   |    ЕСТЬNULL(Renault_СкидкиОптовыеПокупатели.Процент, 0) КАК Процент,
				   |    ЕСТЬNULL(Renault_СкидкиОптовыеПокупатели.ЛокальнаяСкидка, 0) КАК ЛокальнаяСкидка
                   |ИЗ
                   |    Справочник.Renault_ГруппыКонтрагентов КАК Renault_ГруппыКонтрагентов
                   |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_СкидкиОптовыеПокупатели КАК Renault_СкидкиОптовыеПокупатели
                   |        ПО Renault_ГруппыКонтрагентов.Ссылка = Renault_СкидкиОптовыеПокупатели.ГруппаКонтрагента";
    Выборка = Запрос.Выполнить().Выбрать();

    МассивГрупп = Новый Массив;
    Пока Выборка.Следующий() Цикл
        МассивГрупп.Добавить(Новый Структура(
            "Name,Margin,LocalDiscount",
            Выборка.Наименование,
            Выборка.Процент,
			Выборка.ЛокальнаяСкидка
        ));
    КонецЦикла;

    Возврат МассивГрупп;

КонецФункции // ПолучитьСписокГрупп()

// Возвращает массив структур данных о клиентах
// 
// Возвращаемое значение:
//  Маасив - Массив структур данных о клиентах
//
Функция ПолучитьСписокКлиентов()
    
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |    Renault_ОптовыеПокупателиЗапЧастей.Код КАК ID,
                   |    Renault_ОптовыеПокупателиЗапЧастей.Наименование КАК Name,
                   |    Renault_ОптовыеПокупателиЗапЧастей.ГруппаКонтрагента.Наименование КАК GroupName,
                   |    Renault_ОптовыеПокупателиЗапЧастей.Активный КАК Active
                   |ИЗ
                   |    Справочник.Renault_ОптовыеПокупателиЗапЧастей КАК Renault_ОптовыеПокупателиЗапЧастей";
    
    Выборка = Запрос.Выполнить().Выбрать();

    МассивГрупп = Новый Массив;
    Пока Выборка.Следующий() Цикл
        МассивГрупп.Добавить(Новый Структура(
            "ID,Name,GroupName,Active",
            Выборка.ID,
            Выборка.Name,
            Выборка.GroupName,
            Выборка.Active
        ));
    КонецЦикла;

    Возврат МассивГрупп;

КонецФункции // ПолучитьСписокКлиентов()

// Формирует строку в формате JSON с данными клиентов
// 
// Возвращаемое значение:
//  Строка - Строка в формате JSON
//
Функция СформироватьЗапросПоКлиентам()

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(,Символы.Таб));

    СтруктураЗапроса = Новый Структура;
    СтруктураЗапроса.Вставить("DMD", НастройкаОбмена.DMD);
    СтруктураЗапроса.Вставить("Groups", ПолучитьСписокГрупп());
    СтруктураЗапроса.Вставить("Customers", ПолучитьСписокКлиентов());

    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);

    Возврат ЗаписьJSON.Закрыть();

КонецФункции // СформироватьЗапросПоКлиентам()

// Обновляет данные о клиентах в Рено Партс
//
Процедура ОбновитьКлиентов() Экспорт

    Соединение = СоздатьСоединение();

    Запрос = Новый HTTPЗапрос(ПолучитьАдрес("UpdateCustomers"));
    Запрос.Заголовки.Вставить("Content-Type", "application/json");
    Запрос.УстановитьТелоИзСтроки(СформироватьЗапросПоКлиентам());

    Ответ = Соединение.ОтправитьДляОбработки(Запрос);

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON,, "Date");

    Если СтруктураОтвета.ReturnCode <> "H000" Тогда
        Сообщить("Ошибка " + СтруктураОтвета.ReturnCode);
        Возврат;
	КонецЕсли;

	Сообщить("Клиенты успешно синхронизированы");

КонецПроцедуры // ОбновитьКлиентов()

#КонецОбласти


#Область ПолучениеЗаказов

// Формирует строку в формате JSON для загрузки заказов 
// 
// Возвращаемое значение:
//  Строка - Строка в формате JSON
//
Функция СформироватьЗапросПоЗаказам()

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(,Символы.Таб));

	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("From", НачалоДня(ЭтотОбъект.ДатаНачала));
	СтруктураЗапроса.Вставить("To",   КонецДня(ЭтотОбъект.ДатаОкончания));
	СтруктураЗапроса.Вставить("DMD",  НастройкаОбмена.DMD);

    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);

    Возврат ЗаписьJSON.Закрыть();

КонецФункции // СформироватьЗапросПоЗаказам()

// Записывает полученные заказы запчастей в базу
//
// Параметры:
//  МассивЗаказов	 - Массив - Массив данных о заказах запчастей
//
Процедура ЗаписатьЗаказы(МассивЗаказов)

    Для Каждого Заказ Из МассивЗаказов Цикл

        НомерДокумента = Формат(Заказ.Number, "ЧГ=0");

        Заявка = Документы.Renault_ЗаказЗапчастейПокупателя.НайтиПоРеквизиту("НомерЗаявки", НомерДокумента);
        Если ЗначениеЗаполнено(Заявка) Тогда
            Продолжить;  // Пропускаем уже созданную заявку
        КонецЕсли;

        Заявка = Документы.Renault_ЗаказЗапчастейПокупателя.СоздатьДокумент();
        Заявка.Дата = Заказ.Date;
        Заявка.НомерЗаявки = НомерДокумента;
		// Заявка.ДилерскийЦентр = НастройкаОбмена.
        Заявка.Клиент = Справочники.Renault_ОптовыеПокупателиЗапЧастей.НайтиПоКоду(Заказ.Customer); 

        Для Каждого Стр Из Заказ.Goods Цикл
            СтрТовары = Заявка.Запчасти.Добавить();
            СтрТовары.Артикул = Стр.Reference;
			СтрТовары.Номенклатура = Renault_ЗапчастиСервер.ПолучитьНоменклатуруПоКаталогу(Стр.Reference);
            СтрТовары.Количество = Стр.Qty;
            СтрТовары.Цена = Стр.Price;
            СтрТовары.Коэффициент = Стр.Discount;
            СтрТовары.Скидка = "-";
            СтрТовары.Сумма = СтрТовары.Количество * СтрТовары.Цена;
        КонецЦикла;

        Заявка.УстановитьНовыйНомер();
        Заявка.Записать();

    КонецЦикла;

КонецПроцедуры // ЗаписатьЗаказы()

// Получает данные о заказах запчастей
//
Процедура ПолучитьЗаказы() Экспорт

    Соединение = СоздатьСоединение();

    Запрос = Новый HTTPЗапрос(ПолучитьАдрес("GetOrders"));
    Запрос.Заголовки.Вставить("Content-Type", "application/json");
    Запрос.УстановитьТелоИзСтроки(СформироватьЗапросПоЗаказам());

    Ответ = Соединение.ОтправитьДляОбработки(Запрос);

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON,, "Date");

    Если СтруктураОтвета.ReturnCode <> "H000" Тогда
        Сообщить("Ошибка " + СтруктураОтвета.ReturnCode);
        Возврат;
    КонецЕсли;

    ЗаписатьЗаказы(СтруктураОтвета.Orders);

	Сообщить("Заказы успешно получены");

КонецПроцедуры // ПолучитьЗаказы()

