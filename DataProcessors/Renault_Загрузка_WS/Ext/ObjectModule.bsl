//  <!-- Вставить описание -->
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>Результат</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//</Процедура>
//</Автодок>
//</xml>
//@-
Процедура РазобратьЦвета(Цвета)
	
	ЭлементЦвет = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ЭлементЦвет"));
	СвойстваЗаписи = ЭлементЦвет.Свойства();
	
	ТаблицаЦветов = Новый ТаблицаЗначений;
	
	Для Каждого Свойство из СвойстваЗаписи Цикл
		ТаблицаЦветов.Колонки.Добавить(Свойство.Имя);
	КонецЦикла;
	
	Для Каждого Цвет из Цвета.Цвет Цикл
		
		НС = ТаблицаЦветов.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Цвет);
		
	КонецЦикла;
	
КонецПроцедуры // РазобратьРезультат(Результат)

////@+ Процедура ЗагрузитьЦвета()
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="24.05.2013 10:38:57" Автор="Окипний Андрей Евгеньевич">
// <Имя>ЗагрузитьЦвета()</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
// </Параметры>
//  <!-- Без параметров -->
//</Процедура>
//</xml>
//@-
Процедура ЗагрузитьЦвета()
	
	Для Каждого стрЦвет из ТаблицаЦветов Цикл
		
		НайденныйЦвет = Справочники.Цвета.НайтиПоРеквизиту("Артикул", СокрЛП(стрЦвет.Артикул));
		
		Если НайденныйЦвет = Справочники.Цвета.ПустаяСсылка() тогда
			
			ЭлементЦвет = Справочники.Цвета.СоздатьЭлемент();
			
			ЗаполнитьЗначенияСвойств(ЭлементЦвет, стрЦвет);
			ЭлементЦвет.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьЦвета()

////@+ Процедура РазобратьКартинки(Картинки)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="05.06.2013 12:26:20" Автор="Администратор Nissan">
// <Имя>РазобратьКартинки(Картинки)</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>Картинки</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//</Процедура>
//</Автодок>
//</xml>
//@-
Процедура РазобратьКартинки(Картинки) 
	
	ЭлементКартинка = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ЭлементКартинка"));
	СвойстваЗаписи = ЭлементКартинка.Свойства();
	
	ТаблицаКартинок = Новый ТаблицаЗначений;
	
	Для Каждого Свойство из СвойстваЗаписи Цикл
		ТаблицаКартинок.Колонки.Добавить(Свойство.Имя);
	КонецЦикла;
	
	Для Каждого стрКартинка из Картинки.Картинка Цикл
		
		НС = ТаблицаКартинок.Добавить();
		ЗаполнитьЗначенияСвойств(НС, стрКартинка);
		НС.Картинка = Новый Картинка(стрКартинка.Картинка);
		
	КонецЦикла;
	
	//Дополняем данные по моделям, цветам, комплектациям
	
	//////////////////////////////
	//	Модели
	МассивМоделей = ТаблицаКартинок.ВыгрузитьКолонку("КодМодели");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Модели.Ссылка,
	|	Модели.Артикул
	|ИЗ
	|	Справочник.Модели КАК Модели
	|ГДЕ
	|	НЕ Модели.Артикул = """"
	|	И Модели.Артикул В(&МассивМоделей)"
	);
	Запрос.УстановитьПараметр("МассивМоделей", МассивМоделей);
	ТаблицаМоделей = Запрос.Выполнить().Выгрузить();
	
	//////////////////////////////
	//	Цвета
	МассивЦветов = ТаблицаКартинок.ВыгрузитьКолонку("КодЦвета");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Цвета.Ссылка,
	|	Цвета.Артикул
	|ИЗ
	|	Справочник.Цвета КАК Цвета
	|ГДЕ
	|	НЕ Цвета.Артикул = """"
	|	И Цвета.Артикул В(&МассивЦветов)"
	);
	Запрос.УстановитьПараметр("МассивЦветов", МассивЦветов);
	ТаблицаЦветов = Запрос.Выполнить().Выгрузить();
	
	МассивКомплектаций = ТаблицаКартинок.ВыгрузитьКолонку("КодКомплектации");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВариантыКомплектации.Ссылка,
	|	ВариантыКомплектации.Артикул
	|ИЗ
	|	Справочник.ВариантыКомплектации КАК ВариантыКомплектации
	|ГДЕ
	|	НЕ ВариантыКомплектации.Артикул = """"
	|	И ВариантыКомплектации.Артикул В(&МассивКомплектаций)"
	);
	Запрос.УстановитьПараметр("МассивКомплектаций",МассивКомплектаций);
	ТаблицаКомплектаций = Запрос.Выполнить().Выгрузить();
	
	//Теперь проставим модель, цвет, комплектацию в таблицу картинок
	ТаблицаКартинок.Колонки.Добавить("Модель");
	ТаблицаКартинок.Колонки.Добавить("Комплектация");
	ТаблицаКартинок.Колонки.Добавить("Цвет");
	
	Для Каждого стрКартинка из ТаблицаКартинок Цикл
		
		НайденнаяМодель = ТаблицаМоделей.Найти(стрКартинка.КодМодели, "Артикул");
		
		Если НЕ НайденнаяМодель = Неопределено тогда
			стрКартинка.Модель = НайденнаяМодель.Ссылка;
		Иначе
			стрКартинка.Модель = Справочники.Модели.ПустаяСсылка();
		КонецЕсли;
		
		НайденныйЦвет = ТаблицаЦветов.Найти(стрКартинка.КодЦвета, "Артикул");
		
		Если НЕ НайденныйЦвет = Неопределено тогда
			стрКартинка.Цвет = НайденныйЦвет.Ссылка;
		Иначе
			стрКартинка.Цвет = Справочники.Цвета.ПустаяСсылка();
		КонецЕсли;
		
		НайденнаяКомплектация = ТаблицаКомплектаций.Найти(стрКартинка.КодКомплектации, "Артикул");
		
		Если НЕ НайденнаяКомплектация = Неопределено тогда
			стрКартинка.Комплектация = НайденнаяКомплектация.Ссылка;
		иначе
			стрКартинка.Комплектация = Справочники.ВариантыКомплектации.ПустаяСсылка();
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаКартинок.Колонки.Картинка.Имя = "Данные";
	
	ЗагрузитьКартинки();
	
КонецПроцедуры // РазобратьКартинки(Картинки)

////@+ Процедура ЗагрузитьКартинки()
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="05.06.2013 14:22:33" Автор="Администратор Nissan">
// <Имя>ЗагрузитьКартинки()</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
// </Параметры>
//  <!-- Без параметров -->
//</Процедура>
//</xml>
//@-
Процедура ЗагрузитьКартинки()
	
	Для Каждого стрКартинка из ТаблицаКартинок Цикл
		
		Если НЕ ЗначениеЗаполнено(стрКартинка.Модель) тогда Продолжить; КонецЕсли;
		
		МЗИдентификатор = РегистрыСведений.CRM_ИдентификаторыКартинок.СоздатьМенеджерЗаписи();
		
		ЗаполнитьЗначенияСвойств(МЗИдентификатор, стрКартинка);
		МЗИдентификатор.Прочитать();
		
		Если НЕ МЗИдентификатор.Выбран() тогда
			ЗаполнитьЗначенияСвойств(МЗИдентификатор, стрКартинка);
			МЗИдентификатор.Записать(Истина);
		КонецЕсли;
		
		МЗКартинка = РегистрыСведений.КартинкиИФайлы.СоздатьМенеджерЗаписи();
		
		ЗаполнитьЗначенияСвойств(МЗКартинка, стрКартинка);
		МЗКартинка.Объект = стрКартинка.Модель;
		МЗКартинка.Прочитать();
		
		Если НЕ МЗКартинка.Выбран() тогда
			ЗаполнитьЗначенияСвойств(МЗКартинка, стрКартинка);
			МЗКартинка.Объект = стрКартинка.Модель;
			МЗКартинка.Записать(Истина);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьКартинки()

////@+ Процедура РазобратьКредПредложения(КредитныеПредложения)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="10.06.2013 10:39:21" Автор="Администратор Nissan">
// <Имя>РазобратьКредПредложения(КредитныеПредложения)</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
//  <Параметр>
//  <ИмяПараметра>КредитныеПредложения</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//</Процедура>
//</xml>
//@-
Процедура РазобратьКредПредложения(КредитныеПредложения)
	
	ЭлементКредПредложение = СервисФабрика.Создать(СервисФабрика.Тип("http://renault-nissan.com/schema/datatable","ЭлементКредитнаяПрограмма"));
	СвойстваЗаписи = ЭлементКредПредложение.Свойства();
	
	ТаблицаКредПредложений = Новый ТаблицаЗначений;
	
	Для Каждого Свойство из СвойстваЗаписи Цикл
		ТаблицаКредПредложений.Колонки.Добавить(Свойство.Имя);
	КонецЦикла;
	
	Для Каждого КредПредложение из КредитныеПредложения.КредитнаяПрограмма Цикл
		
		НС = ТаблицаКредПредложений.Добавить();
		ЗаполнитьЗначенияСвойств(НС, КредПредложение, ,"Банк,ПрименениеКредитныхПрограмм");
		
		НС.Банк = НайтиСоздатьБанк(КредПредложение.Банк);
		
		ТаблицаПрименений = СобратьПрименения(КредПредложение.ПрименениеКредитныхПрограмм.СтрокиПримКредПрограмм);
		НС.ПрименениеКредитныхПрограмм = ТаблицаПрименений;
		
	КонецЦикла;
	
	ЗагрузитьКредПредложения();
	
КонецПроцедуры // РазобратьКредПредложения()

////@+ Процедура ЗагрузитьКредПредложения()
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры=""
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="11.06.2013 11:35:05" Автор="Администратор Nissan">
// <Имя>ЗагрузитьКредПредложения()</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
// </Параметры>
//  <!-- Без параметров -->
//</Процедура>
//</xml>
//@-
Процедура ЗагрузитьКредПредложения() 
	
	Для каждого стрПредложение из ТаблицаКредПредложений цикл
		
		КредПредложениеСпр = Справочники.КредитныеПрограммы.НайтиПоРеквизиту("RenaultNissan_Идентификатор", стрПредложение.Идентификатор);
		
		Если НЕ ЗначениеЗаполнено(КредПредложениеСпр) тогда
			КредПредложениеОбъект = Справочники.КредитныеПрограммы.СоздатьЭлемент();
		Иначе
			КредПредложениеОбъект = КредПредложениеСпр.ПолучитьОбъект();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(КредПредложениеОбъект, стрПредложение);
		
		КредПредложениеОбъект.Записать();
		
		КредПредложениеСпр = КредПредложениеОбъект.Ссылка;
		
		//Пишем данные в регистры
		
		//Доп. параметры
		МЗ = РегистрыСведений.CRM_ПараметрыКредитныхПрограмм.СоздатьМенеджерЗаписи();
		
		МЗ.КредитнаяПрограмма = КредПредложениеСпр;
		МЗ.Прочитать();
		
		Если НЕ МЗ.Выбран() тогда
			МЗ.КредитнаяПрограмма = КредПредложениеСпр;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(МЗ, стрПредложение);
		МЗ.Записать();
		
		//Применяемость
		ТаблицаПрименений = стрПредложение.ПрименениеКредитныхПрограмм;
		ТаблицаПрименений.ЗаполнитьЗначения(КредПредложениеСпр, "КредитнаяПрограмма");
		
		НЗ = РегистрыСведений.CRM_ПрименениеКредитныхПрограмм.СоздатьНаборЗаписей();
		
		НЗ.Отбор.КредитнаяПрограмма.Установить(КредПредложениеСпр);
		
		НЗ.Прочитать();
		НЗ.Очистить();
		
		НЗ.Загрузить(ТаблицаПрименений);
		НЗ.Записать();
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьКредПредложения()

