//  <Результат>
//  	<ИмяРезультата>МодельСпр</ИмяРезультата>
//  	<ТипРезультата><!-- Укажите тип результата --></ТипРезультата>
//  	<ОписаниеРезультата><!-- описание результата -->
//                 <!-- продолжение описания результата --></ОписаниеРезультата>
//  </Результат>
//</Функция>
//</Автодок>
//</xml>
//@-
Функция НайтиСоздатьМодель(МодельXDTO)
	
	//Первоначальная инициализация
	МодельСпр = неопределено;
	
	МодельСпр = Справочники.Модели.НайтиПоРеквизиту("Артикул", СокрЛП(МодельXDTO.Артикул));
	
	Если НЕ ЗначениеЗаполнено(МодельСпр) тогда
		
		МодельОб = Справочники.Модели.СоздатьЭлемент();
		
		ЗаполнитьЗначенияСвойств(МодельОб, МодельXDTO, , "ДоступныеЦвета,КодВалютыУчета");
		
		//Обязательные реквизиты
		МодельОб.ВалютаУчета	 = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		МодельОб.УстановитьНовыйКод();
		
		МодельОб.Записать();
		
		МодельСпр = МодельОб.Ссылка;
		
	КонецЕсли;
	
	Возврат МодельСпр;
	
КонецФункции // СоздатьМодель(МодельXDTO)

////@+ Функция СоздатьВерсию(ВерсияXDTO)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции=""
//         ИнструкцииПрепроцессору=""
//         ДатаCоздания="10.06.2013 17:36:26" Автор="Администратор Nissan">
// <Имя>СоздатьВерсию(ВерсияXDTO)</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>ВерсияXDTO</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//
//  <Результат>
//  	<ИмяРезультата>ВерсияСпр</ИмяРезультата>
//  	<ТипРезультата><!-- Укажите тип результата --></ТипРезультата>
//  	<ОписаниеРезультата><!-- описание результата -->
//                 <!-- продолжение описания результата --></ОписаниеРезультата>
//  </Результат>
//</Функция>
//</Автодок>
//</xml>
//@-
Функция НайтиСоздатьВерсию(ВерсияXDTO)
	
	//Первоначальная инициализация
	ВерсияСпр = неопределено;
	
	ВерсияСпр = Справочники.ВариантыКомплектации.НайтиПоРеквизиту("Артикул", СокрЛП(ВерсияXDTO.Артикул));
	
	Если НЕ ЗначениеЗаполнено(ВерсияСпр) тогда
		
		ВерсияОб = Справочники.ВариантыКомплектации.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(ВерсияОб, ВерсияXDTO, ,"Владелец, КодВалютыУчета");
		
		ВерсияОб.УстановитьНовыйКод();
		ВерсияОб.ВалютаУчета		 = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		
		МодельВладелец = Справочники.Модели.НайтиПоРеквизиту("Артикул", СокрЛП(ВерсияXDTO.Владелец.Артикул));
		Если НЕ ЗначениеЗаполнено(МодельВладелец) тогда
			МодельВладелец = НайтиСоздатьМодель(ВерсияXDTO.Владелец);
		КонецЕсли;
		
		ВерсияОб.Владелец = МодельВладелец;
		
		ВерсияОб.Записать();
		
		ВерсияСпр = ВерсияОб.Ссылка;
		
	КонецЕсли;
	
	Возврат ВерсияСпр;
	
КонецФункции // СоздатьВерсию(ВерсияXDTO)

