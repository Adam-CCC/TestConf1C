Перем СервисФабрика;
Перем ТаблицаЦветов;
Перем ТаблицаКартинок;
Перем ТаблицаКредПредложений;

Перем Загрузчик;

////@+ Процедура ПолучитьДанные()
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Процедура ТипПроцедуры="Экспорт"
//           ИнструкцииПрепроцессору=""
//           ДатаCоздания="21.05.2013 16:25:50" Автор="Окипний Андрей Евгеньевич">
// <Имя>ПолучитьДанные()</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
// </Параметры>
//  <!-- Без параметров -->
//</Процедура>
//</xml>
//@-
Процедура ПолучитьДанные() Экспорт
	
	АдресWS	 = Константы.Renault_АдресWebСервисов.Получить();
	ЛогинWS	 = Константы.Renault_ЛогинВебСервиса.Получить();
	ПарольWS = Константы.Renault_ПарольВебСервиса.Получить();
	
	//удалим определение документа wsdl - его добавляем автоматически
	АдресWS = СтрЗаменить(АдресWS, "?wsdl", "");
	
	ВСОпределение = Новый WSОпределения(СокрЛП(АдресWS) + "ws/Credit.ws?wsdl",
									СокрЛП(ЛогинWS), СокрЛП(ПарольWS));
	
	ВебСервис = Новый WSПрокси(ВСОпределение, "http://renault-nissan.com/schema/datatable", 
							   "ОтправкаНСИпоЗапросу","ОтправкаНСИпоЗапросуSoap12",600);
	
	ВебСервис.Пользователь	 = СокрЛП(ЛогинWS);
	ВебСервис.Пароль		 = СокрЛП(ПарольWS);
	
	СервисФабрика = ВебСервис.ФабрикаXDTO;
	
	Если ПолучитьЦвета тогда
		Цвета = ВебСервис.getcolors();
	КонецЕсли;
	
	Если ПолучитьКартинки тогда
		Картинки = ВебСервис.getimage();
	КонецЕсли;
	
	Если ПолучитьКредитныеПрограммы тогда
		КредитныеПредложения = ВебСервис.getcredit();
	КонецЕсли;
	
	ВебСервис = Неопределено;
	
	Если ПолучитьЦвета тогда
		РазобратьЦвета(Цвета);
		ЗагрузитьЦвета();
	КонецЕсли;
	
	Если ПолучитьКартинки тогда
		РазобратьКартинки(Картинки);
	КонецЕсли;
	
	Если ПолучитьКредитныеПрограммы тогда
		РазобратьКредПредложения(КредитныеПредложения);
	КонецЕсли;
	
КонецПроцедуры // ПолучитьДанные()

