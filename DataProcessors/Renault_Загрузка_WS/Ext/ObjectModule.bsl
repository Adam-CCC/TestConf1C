Функция НайтиСоздатьБанк(БанкXDTO) 
	
	//Первоначальная инициализация
	БанкСсылка = неопределено;
	
	БанкСсылка = Справочники.Банки.НайтиПоКоду(СокрЛП(БанкXDTO.БикБанка));
	
	Если НЕ ЗначениеЗаполнено(БанкСсылка) тогда
		
		БанкОбъект = Справочники.Банки.СоздатьЭлемент();
		
		ЗаполнитьЗначенияСвойств(БанкОбъект, БанкXDTO);
		
		БанкОбъект.Код = БанкXDTO.БикБанка;
		
		БанкОбъект.Записать();
		
		БанкСсылка = БанкОбъект.Ссылка;
		
	КонецЕсли;
	
	Возврат БанкСсылка;
	
КонецФункции // НайтиСоздатьБанк(БанкXDTO)

////@+ Функция СобратьПрименения(ПримененияXDTO)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции=""
//         ИнструкцииПрепроцессору=""
//         ДатаCоздания="11.06.2013 9:44:30" Автор="Администратор Nissan">
// <Имя>СобратьПрименения(ПримененияXDTO)</Имя>
//
// <Описание>
//  <!-- Вставить описание -->
// </Описание>
//
// <Параметры>
//  <Параметр>
//  <ИмяПараметра>ПримененияXDTO</ИмяПараметра>
//  	<ТипПараметра><!-- Укажите тип параметра --></ТипПараметра>
//  	<ОписаниеПараметра><!-- описание параметра -->
//                 <!-- продолжение описания параметра --></ОписаниеПараметра>
//  </Параметр>
// </Параметры>
//
//  <Результат>
//  	<ИмяРезультата>ТаблицаПрименения</ИмяРезультата>
//  	<ТипРезультата><!-- Укажите тип результата --></ТипРезультата>
//  	<ОписаниеРезультата><!-- описание результата -->
//                 <!-- продолжение описания результата --></ОписаниеРезультата>
//  </Результат>
//</Функция>
//</Автодок>
//</xml>
//@-
Функция СобратьПрименения(ПримененияXDTO)
	
	//Первоначальная инициализация
	ТаблицаПрименения = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	CRM_ПрименениеКредитныхПрограмм.Модель,
	|	CRM_ПрименениеКредитныхПрограмм.Версия,
	|	CRM_ПрименениеКредитныхПрограмм.ГодПроизводства,
	|	CRM_ПрименениеКредитныхПрограмм.КредитнаяПрограмма,
	|	CRM_ПрименениеКредитныхПрограмм.ПГВПодарок
	|ИЗ
	|	РегистрСведений.CRM_ПрименениеКредитныхПрограмм КАК CRM_ПрименениеКредитныхПрограмм"
	);
	
	ТаблицаПрименения = Запрос.Выполнить().Выгрузить();
	
	Если ПримененияXDTO.Количество() = 0 Тогда Возврат ТаблицаПрименения КонецЕсли;
	
	Для Каждого стрПрименение из ПримененияXDTO цикл
		
		НС = ТаблицаПрименения.Добавить();
		
		НС.Модель = НайтиСоздатьМодель(стрПрименение.Модель);
		НС.Версия = НайтиСоздатьВерсию(стрПрименение.Версия);
		НС.ГодПроизводства = стрПрименение.ГодПроизводства;
		НС.ПГВПодарок = НайтиСоздатьПродленнуюГарантию(стрПрименение.ПГВПодарок);
		
	КонецЦикла;
	
	Возврат ТаблицаПрименения;
	
КонецФункции // СобратьПрименения(ПримененияXDTO)

