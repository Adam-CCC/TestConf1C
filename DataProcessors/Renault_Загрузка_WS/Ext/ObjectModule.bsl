////@+ Функция НайтиСоздатьБанк(БанкXDTO)
//<xml version="1.0" encoding="UTF-8">
//<Автодок>
//<Функция ТипФункции=""
//         ИнструкцииПрепроцессору=""
//         ДатаCоздания="11.06.2013 9:38:27" Автор="Администратор Nissan">
