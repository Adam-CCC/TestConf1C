//                  значение Ложь, возвращается пароль администратора ККМ.
//
// Возвращаемое значение:
//  <Число>       - Пароль ККМ.
//
Функция ПолучитьПарольККМ(ПарольКассира)

	Результат = Renault_Advanced_УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ПараметрыСеанса.Пользователь,
	                                        ?(ПарольКассира,
	                                        "ПарольКассираФискальногоРегистратора",
