							РезультатФР = ЗакрытьЧек(ИдентификаторФР, 0, 0);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

			Если Не ЗначениеЗаполнено(Результат)
			      И ЗначениеЗаполнено(РезультатФР) Тогда
				Обработка.ОтменитьПлатежПоПлатежнойКарте(Объект, Сумма, КодRRN, КодАвторизации, КодОперации, МассивСтрокСлипЧека, ШиринаЧека, КоличествоКопий);
