	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьЗаполнениеКатегорииЗаявок(МВТ, ТаблицаОшибок)

&НаСервере
Процедура ПроверитьЗаполнениеКодСтатьиРасходовЗаявок(МВТ, ТаблицаОшибок) 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	// Комментарий 
	//Дата создания - 10.04.2012 13:19:03; Автор - Окипний Андрей Евгеньевич
	//Выполним поиск пустых Кодов статей расходов в таблице заявок
	//Всю проверку сделаем одним пакетным запросом. 
	//
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПаттерныЗаявок.ЗаказНаряд,
	|	ПаттерныЗаявок.Счет,
	|	ПаттерныЗаявок.Категория,
	|	ПаттерныЗаявок.ВидРасходов
	|ПОМЕСТИТЬ ВремЗаявки
	|ИЗ
	|	ПаттерныЗаявок КАК ПаттерныЗаявок
	|ГДЕ
	|	ПаттерныЗаявок.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСоответствийКатегорий.ExpenceCode,
	|	ТаблицаСоответствийКатегорий.Категория
	|ПОМЕСТИТЬ ВремТабПрименяемости
	|ИЗ
	|	&ТаблицаСоответствийКатегорий КАК ТаблицаСоответствийКатегорий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТабПрименяемости.Категория,
	|	ВремТабПрименяемости.ExpenceCode
	|ПОМЕСТИТЬ ВсеСоответствия
	|ИЗ
	|	ВремТабПрименяемости КАК ВремТабПрименяемости
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	EDR_КатегорииСчетовВидыРасходов.КодСтатьиРасходов,
	|	EDR_КатегорииСчетовВидыРасходов.Ссылка
	|ИЗ
	|	Справочник.EDR_КатегорииСчетов.ВидыРасходов КАК EDR_КатегорииСчетовВидыРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСоответствия.Категория,
	|	ВсеСоответствия.ExpenceCode
	|ПОМЕСТИТЬ НеПустыеСоответствия
	|ИЗ
	|	ВсеСоответствия КАК ВсеСоответствия
	|ГДЕ
	|	(НЕ ВсеСоответствия.ExpenceCode = НЕОПРЕДЕЛЕНО)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеСоответствия.ExpenceCode,
	|	ВсеСоответствия.Категория
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВсеСоответствия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НеПустыеСоответствия.Категория КАК СоответствиеКатегория,
	|	КОЛИЧЕСТВО(НеПустыеСоответствия.ExpenceCode) КАК КоличествоСоответсвий
	|ПОМЕСТИТЬ ПодсчитанныеВхождения
	|ИЗ
	|	НеПустыеСоответствия КАК НеПустыеСоответствия
	|
	|СГРУППИРОВАТЬ ПО
	|	НеПустыеСоответствия.Категория
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремТабПрименяемости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НеПустыеСоответствия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремЗаявки.ЗаказНаряд,
	|	ВремЗаявки.Счет КАК Заявка,
	|	""-"" КАК Инцидент,
	|	""Вид расходов"" КАК Объект,
	|	""Не заполнено обязательное поле """"Вид расходов"""""" КАК ОписаниеОшибки
	|ИЗ
	|	ВремЗаявки КАК ВремЗаявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПодсчитанныеВхождения КАК ПодсчитанныеВхождения
	|		ПО ВремЗаявки.Категория = ПодсчитанныеВхождения.СоответствиеКатегория
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремЗаявки"
	;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаСоответствийКатегорий", ТаблицаСоответствийКатегорий.Выгрузить());
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьЗаполнениеКодСтатьиРасходовЗаявок(МВТ, ТаблицаОшибок)

