	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", 		 Новый Цвет(160,160,160));
	
////#КонецОбласти

КонецПроцедуры // УстановитьУсловноеОформление()

&НаКлиенте
Процедура ОбновитьЗаголовкиКомментариевОбращения(ЭтоАктивация = Ложь)
	
	ТекущаяСтрока = Элементы.ТаблицаИнцидентовИКомментарии.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Элементы.РезультатДиагностик.Заголовок = "Результат диагностики: 	Осталось символов: " + Формат(100 - СтрДлина(ТекущаяСтрока.РезультатДиагностики),"ЧЦ=10; ЧН=-; ЧГ="); 	
	Элементы.ОписаниеЖалобы.Заголовок      = "Жалоба клиента: 	 Осталось символов: "	 + Формат(80  - СтрДлина(ТекущаяСтрока.ОписаниеЖалобы),"ЧЦ=10; ЧН=-; ЧГ="); 	
	Элементы.КомментарийОперации.Заголовок = "Комментарии к инциденту: 	Осталось символов: " + Формат(350 - СтрДлина(ТекущаяСтрока.КомментарийОперации),"ЧЦ=10; ЧН=-; ЧГ="); 	
	
	Если Не ЭтоАктивация И Не Модифицированность Тогда
		Модифицированность = Истина;
	КонецЕсли; 
	
КонецПроцедуры // ОбновитьЗаголовкиКомментариевОбращения()

&НаСервере
Процедура УстановитьДоступность()

	Элементы.ГотовностьКОтправке.ТолькоПросмотр = Отправлен;	
	Элементы.РангАвторабот.ТолькоПросмотр 		= Отправлен;	
	Элементы.ПовторнаяОтправка.ТолькоПросмотр   = Не Отправлен;
	
	Элементы.ТаблицаИнцидентовОтзывнаяНота.ТолькоПросмотр = Не OTS;
	
	Элементы.ТаблицаСчетовКоманднаяПанель.Доступность = (Не Отправлен Или ПовторнаяОтправка);
	Элементы.ТаблицаСчетовКонтекстноеМеню.Доступность = (Не Отправлен Или ПовторнаяОтправка);
	
	Элементы.ТаблицаТоваров.ТолькоПросмотр 						 = Отправлен И Не ПовторнаяОтправка;
	Элементы.ТаблицаТоваровДобавитьDiversCode.Доступность 		 = Не Отправлен;
	Элементы.ТаблицаТоваровВосстановитьСписокДеталей.Доступность = (Не Отправлен Или ПовторнаяОтправка);
	
	Элементы.ТаблицаРаботы.ТолькоПросмотр 					   = Отправлен И Не ПовторнаяОтправка;
	Элементы.ТаблицаРаботыДобавитьDiversCodeРаботы.Доступность = Не Отправлен;
	Элементы.ТаблицаРаботыВосстановитьРаботы.Доступность       = (Не Отправлен Или ПовторнаяОтправка);
	
	Элементы.ТаблицаИнцидентов.ТолькоПросмотр = (Отправлен И Не ПовторнаяОтправка);
	
	Для каждого ЭлементКоманднойПанели Из Элементы.ТаблицаИнцидентовКоманднаяПанель.ПодчиненныеЭлементы Цикл
		
		Если ЭлементКоманднойПанели = Элементы.ТаблицаИнцидентовКомандаИнцидентыICM Тогда
			Продолжить;
		КонецЕсли; 
		
		ЭлементКоманднойПанели.Доступность = (Не Отправлен Или ПовторнаяОтправка);
	
	КонецЦикла; 
	
	Для каждого ЭлементКоманднойПанели Из Элементы.ТаблицаИнцидентовКонтекстноеМеню.ПодчиненныеЭлементы Цикл
		
		Если ЭлементКоманднойПанели = Элементы.ТаблицаИнцидентовКомандаИнцидентыICM Тогда
			Продолжить;
		КонецЕсли; 
		
		ЭлементКоманднойПанели.Доступность = (Не Отправлен Или ПовторнаяОтправка);
	
	КонецЦикла; 
	
	Элементы.ТаблицаСоответствий.ТолькоПросмотр = (Отправлен И Не ПовторнаяОтправка);
	
	Элементы.ТаблицаИнцидентовИКомментарии.ТолькоПросмотр = (Отправлен И Не ПовторнаяОтправка);
	Элементы.ГруппаКомментарииКИнцидентам.ТолькоПросмотр  = (Отправлен И Не ПовторнаяОтправка);	
	
	Если Отправлен и НЕ ПовторнаяОтправка Тогда
		Элементы.ТаблицаТоваровЗаполнитьЦеныПоАктуальномуТарифу.Доступность = Ложь;
	Иначе
		Элементы.ТаблицаТоваровЗаполнитьЦеныПоАктуальномуТарифу.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры // УстановитьДоступность()

&НаСервере
Процедура УстановитьВидимость()

	ВСчетахЕстьТипParts = (ТаблицаСчетов.НайтиСтроки(Новый Структура("Type","Parts")).Количество() > 0);
	
	Элементы.ТаблицаИнцидентовНомерСФ.Видимость 		   = ВСчетахЕстьТипParts;
	Элементы.ТаблицаИнцидентовДатаСФ.Видимость 			   = ВСчетахЕстьТипParts;
	Элементы.ТаблицаИнцидентовПробегПриУстановке.Видимость = ВСчетахЕстьТипParts;
	
	Элементы.ТаблицаИнцидентовОтзывнаяНота.Видимость = OTS;
	
КонецПроцедуры // УстановитьВидимость()

