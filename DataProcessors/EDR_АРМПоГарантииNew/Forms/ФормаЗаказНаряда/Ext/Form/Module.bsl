Процедура ЗаполнитьСчетаПоОтбору()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счета.ЗаказНаряд,
	|	Счета.Invoice КАК Счет,
	|	Счета.Invoice КАК СчетДоИзменения,
	|	Счета.Invoice КАК СчетДоНачалаРедактирования,
	|	Счета.GUID КАК ИдентификаторСчета,
	|	Счета.Категория,
