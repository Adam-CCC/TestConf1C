
////#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗаказНаряд") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, 
			"ЗаказНаряд,СемействоАвтомобиля,ГотовностьКОтправке,ЛКМ,OTS,ПовторнаяОтправка,Отправлен,ПробегАвтомобиля,ДатаОткрытия,РангАвторабот,ДатаЗакрытия,Автомобиль");
	КонецЕсли;
	
	СтавкаБезНДС = Справочники.СтавкиНДС.БезНДС;
	
	ЗаполнитьСчетаПоОтбору();
	ЗаполнитьИнцидентыПоОтбору();
	ЗаполнитьСоответствияПоОтбору();
	ЗаполнитьТоварыПоОтбору();
	ЗаполнитьРаботыПоОтбору();
	ЗаполнитьФотографииПоОтбору();
	
	ОписаниеТипаКатегорий = Справочники.EDR_КатегорииСчетов.ПолучитьОписаниеТипов();
	ОписаниеТипаРасходов  = Справочники.EDR_ВидыРасходов.ПолучитьОписаниеТипов();
	
	мТаблицаСоответствийКатегорий = ТаблицаСоответствийКатегорий.Выгрузить();
	
	//Заполняем таблицу соответствий категорий статьям расходов
	Справочники.EDR_КатегорииСчетов.ЗаполнитьТаблицуПоказателей(мТаблицаСоответствийКатегорий);
	
	ТаблицаСоответствийКатегорий.Загрузить(мТаблицаСоответствийКатегорий);
	
	ПаттернЛитераловНомеров = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	Элементы.РезультатДиагностик.МаксимальноеЗначение = 100;
	Элементы.ОписаниеОперации.МаксимальноеЗначение 	  = 80;
	Элементы.КомментарийОперации.МаксимальноеЗначение = 350;
	
	НастроитьКолонкуНомерСогласованияИнцидентов();
	
	ЗаполнитьСлужебныеРеквизитыТаблицыИнциденты();
	
	ЗаполнитьСлужебныеРеквизитыТаблицыТовары();
	
	ЗаполнитьСлужебныеРеквизитыТаблицыРаботы();
	
	ОбновитьСпискиВыбораИнцидентов();
	
	Если Отправлен Или ПовторнаяОтправка Тогда
		
		Для каждого ТекущаяСтрока Из ТаблицаСчетов Цикл
			ТекущаяСтрока.Отправлен = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
	УстановитьДоступность();
	
	УстановитьВидимость();
	
	ОбновитьСпискиВыбораСчетов();
	
	// Перенесено в УстановитьДоступность()
	//Если Отправлен и НЕ ПовторнаяОтправка Тогда
	//	
	//	Элементы.ТаблицаТоваровЗаполнитьЦеныПоАктуальномуТарифу.Доступность = Ложь;
	//	
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		Если ВыбранноеЗначение.Свойство("Счет") Тогда
			
			Попытка
				
				//Заменяемый Идентификатор
				мИдентификаторСчета = ВыбранноеЗначение.ИдентификаторСчета;
				
				//Нужно пройтись по таблице соответствий и поменять старый идентификатор на новый.
				
				СтруктураПоиска = Новый Структура("ИдентификаторСчета", ВыбранноеЗначение.Счет);
				
				мВыбранныйСчет = ТаблицаСчетов.НайтиСтроки(СтруктураПоиска);
				
				ВыбранныйСчет = мВыбранныйСчет[0].Счет;
				
				СтруктураИспользованияСчета = ПроверитьИспользованиеСчета(мИдентификаторСчета);
				
				//Массив идентификаторов
				МассивИдентификаторов = СтруктураИспользованияСчета["Соответствия"];
				
				Для каждого Идентификатор из МассивИдентификаторов Цикл
					
					мСтрокаТаб = ТаблицаСоответствий.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
					СтрокаТаб = мСтрокаТаб[0];
					СтрокаТаб.Счет = ВыбранныйСчет;
					СтрокаТаб.ИдентификаторСчета = ВыбранныйСчет;
					
				КонецЦикла;
				
				СтрокиУдаления = ТаблицаСчетов.НайтиСтроки(Новый Структура("ИдентификаторСчета", мИдентификаторСчета));
				
				Для каждого СтрокаУдаления Из СтрокиУдаления Цикл
					СтрокаУдаления.Удален = Истина;
				КонецЦикла; 
				Модифицированность = Истина;
			Исключение
				
				Предупреждение(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				Возврат;
				
			КонецПопытки;
			
		ИначеЕсли ВыбранноеЗначение.Свойство("Инцидент") Тогда 
			
			Попытка
				
				//ЗаменяемыйИдентификатор
				ИдентификаторИнцидента = ВыбранноеЗначение.ИдентификаторИнцидента;
				
				//Нужно пройтись по всем таблицам и поменять старый идентификатор на новый.
				мВыбранныйИнцидент = ТаблицаИнцидентов.НайтиСтроки(Новый Структура("ИдентификаторИнцидента", ВыбранноеЗначение.Инцидент));
				
				ВыбранныйИнцидент = мВыбранныйИнцидент[0].Инцидент;
				
				СтруктураИспользованияИнцидента = ПроверитьИспользованиеИнцидента(ИдентификаторИнцидента);
				
				//Массив товаров
				МассивТоваров = СтруктураИспользованияИнцидента["Товары"];
				
				Для каждого ИдентификаторТовара из МассивТоваров Цикл
					
					СтрокиТаб = ТаблицаТоваров.НайтиСтроки(Новый Структура("ИдентификаторТовара", ИдентификаторТовара));
					СтрокаТаб = СтрокиТаб[0];
					
					СтрокаТаб.Инцидент = ВыбранныйИнцидент;
					СтрокаТаб.ИдентификаторИнцидента = ВыбранноеЗначение.Инцидент;
					
					//Для переназначенных инцидентов сбрасываем все флаги
					СтрокаТаб.ПричинаОбращения = Ложь;
					
				КонецЦикла;
				
				//Массив работ
				МассивРабот = СтруктураИспользованияИнцидента["Работы"];
				
				Для каждого ИдентификаторРаботы из МассивРабот Цикл
					
					СтрокиТаб = ТаблицаРаботы.НайтиСтроки(Новый Структура("ИдентификаторРаботы", ИдентификаторРаботы));
					СтрокаТаб = СтрокиТаб[0];
					
					СтрокаТаб.Инцидент = ВыбранныйИнцидент;
					СтрокаТаб.ИдентификаторИнцидента = ВыбранноеЗначение.Инцидент;
					
				КонецЦикла;
				
				//Таблица Соответствий
				МассивИнцидентов = СтруктураИспользованияИнцидента["Соответствия"];
				
				Для каждого Идентификатор из МассивИнцидентов Цикл
					
					СтрокиТаб = ТаблицаСоответствий.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
					СтрокаТаб = СтрокиТаб[0];
					
					СтрокаТаб.Инцидент = ВыбранныйИнцидент;
					СтрокаТаб.ИдентификаторИнцидента = ВыбранноеЗначение.Инцидент;
					
				КонецЦикла;
				
				СтрокиУдаления = ТаблицаИнцидентов.НайтиСтроки(Новый Структура("ИдентификаторИнцидента", ИдентификаторИнцидента));
				
				Для каждого СтрокаУдаления Из СтрокиУдаления Цикл
					СтрокаУдаления.Удален = Истина;
				КонецЦикла;
				Модифицированность = Истина;
				
			Исключение
				
				Предупреждение(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Модифицированность Тогда
		
		//Отказ = Истина;
		Режим = РежимДиалогаВопрос.ДаНет;
		
		ТекстВопроса = "Существуют измененные записи. Закрытие формы приведет к утере изменений. " + Символы.ПС + "Сохранить записи автоматически?";
		
		//Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтаФорма, Параметры);
		//ПоказатьВопрос(Оповещение, "Существуют измененные записи. Закрытие формы приведет к утере изменений. " + Символы.ПС + "Сохранить записи автоматически?", Режим, 0);
		
		Результат = Вопрос(ТекстВопроса,Режим,0);
		
		ПередЗакрытиемЗавершение(Результат, Параметры, Отказ, СтандартнаяОбработка);
		
		Если Не Отказ Тогда
			
			Оповестить("ОбновитьСписок", ПараметрыСеанса.Пользователь);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

////#КонецОбласти

