&НаСервере
Процедура РассчитатьСтоимостьТоваров(ТекущаяСтрока)
	
	НДС_В_Сумме = ЗаказНаряд.ТипЦен.ЦенаВключаетНДС;
	
	Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	
	Если НДС_В_Сумме тогда
		
		Сумма	   = Сумма - ТекущаяСтрока.СуммаСкидки;
		СуммаНДС   = Сумма - (100 *Сумма / (100 + ТекущаяСтрока.СтавкаНДС.Ставка)); 
		СуммаВсего = Сумма; //НДС в сумме, значит ничего прибавлять уже не надо
		
	Иначе
		
		Сумма      = Сумма - ТекущаяСтрока.СуммаСкидки;
		СуммаНДС   = Сумма * ТекущаяСтрока.СтавкаНДС.Ставка / 100;
		СуммаВсего = Сумма + СуммаНДС;
		
	КонецЕсли;
	
	ТекущаяСтрока.СуммаНДС   = СуммаНДС;
	ТекущаяСтрока.СуммаВсего = СуммаВсего;
	
КонецПроцедуры

