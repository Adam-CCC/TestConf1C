	);
	Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаСчетов.Загрузить(РезультатЗапроса.Выгрузить());
	
