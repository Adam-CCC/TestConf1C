&НаСервереБезКонтекста
Функция ЕстьТакойНомерЗаявки(СчетДляПроверки, ЗаказНарядПроверки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Invoice", 	СчетДляПроверки);
	Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНарядПроверки);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	EDR_Invoices.Invoice
		|ИЗ
		|	РегистрСведений.EDR_Invoices КАК EDR_Invoices
		|ГДЕ
		|	EDR_Invoices.Invoice = &Invoice
		|	И EDR_Invoices.ЗаказНаряд <> &ЗаказНаряд";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции // ЕстьТакойНомерЗаявки()

&НаКлиенте
Функция ПроверитьНомерЗаявки(СтрокаПроверки)
	
	Для А = 1 По СтрДлина(СтрокаПроверки) Цикл
		
		КодСимвола = КодСимвола(Сред(СтрокаПроверки, А, 1));
		
		Если ((КодСимвола < 65) Или (КодСимвола > 90 И КодСимвола < 97) Или (КодСимвола > 122)) И НЕ (КодСимвола >= 48 И КодСимвола <= 57) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции // ПроверитьНомерЗаявки()

&НаКлиенте
Процедура ТаблицаСчетовСчетПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаСчетов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ТекущаяСтрока.Счет = СтрЗаменить(ТекущаяСтрока.Счет, " ", "");
	
	Если ЕстьТакойНомерЗаявки(ТекущаяСтрока.Счет,ЗаказНаряд) Тогда
		
		ТекстСообщения = "В базе уже существует заявка с номером: " + СокрЛП(ТекущаяСтрока.Счет) + Символы.НПП + "Продолжить?";
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос(ТекстСообщения, Режим, 0);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ТекущаяСтрока.СчетДоНачалаРедактирования = ТекущаяСтрока.Счет;
		Иначе 
			ТекущаяСтрока.Счет = ТекущаяСтрока.СчетДоНачалаРедактирования;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекущаяСтрока.Счет) Тогда
		
		ЕстьОшибка = ПроверитьНомерЗаявки(ТекущаяСтрока.Счет);
		
		Если Не ЕстьОшибка Тогда
			
			СтрокиСоотвествия = ТаблицаСоответствий.НайтиСтроки(Новый Структура("ИдентификаторСчета", ТекущаяСтрока.ИдентификаторСчета));
			
			Для каждого СтрокаЗамены Из СтрокиСоотвествия Цикл
				СтрокаЗамены.Счет = ТекущаяСтрока.Счет;
			КонецЦикла;
			
			ОбновитьСпискиВыбораСчетов();
			
			Возврат;
			
		КонецЕсли;
		
		ТекстВопроса = "В номере счета должен содержать только латинские буквы и цифры" + Символы.НПП + "Продолжить?";
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос(ТекстВопроса, Режим, 0);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ТекущаяСтрока.СчетДоНачалаРедактирования = ТекущаяСтрока.Счет;
			Возврат;
		КонецЕсли;
		
		ТекущаяСтрока.Счет = ТекущаяСтрока.СчетДоНачалаРедактирования;
		
	КонецЕсли;
	
	СтрокиСоотвествия = ТаблицаСоответствий.НайтиСтроки(Новый Структура("ИдентификаторСчета", ТекущаяСтрока.ИдентификаторСчета));
	
	Для каждого СтрокаЗамены Из СтрокиСоотвествия Цикл
		СтрокаЗамены.Счет = ТекущаяСтрока.Счет;
	КонецЦикла;
	
	ОбновитьСпискиВыбораСчетов();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНедопустимыеСимволыВКомментарих() //РезультатДиагностики,ОписаниеЖалобы,ОписаниеОперации,КомментарийОперации
	
	Для каждого ТекущаяСтрока Из ТаблицаИнцидентов Цикл
		
		ТекущаяСтрока.РезультатДиагностики = УдалитьНедопустимыеСимволы(ТекущаяСтрока.РезультатДиагностики);
		ТекущаяСтрока.ОписаниеЖалобы 	   = УдалитьНедопустимыеСимволы(ТекущаяСтрока.ОписаниеЖалобы);
		ТекущаяСтрока.ОписаниеОперации 	   = УдалитьНедопустимыеСимволы(ТекущаяСтрока.ОписаниеОперации);
		ТекущаяСтрока.КомментарийОперации  = УдалитьНедопустимыеСимволы(ТекущаяСтрока.КомментарийОперации);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция УдалитьНедопустимыеСимволы(СтроковоеЗначение)
	
	ЗначениеСтроки = СокрЛП(СтроковоеЗначение);
	
	ЗначениеСтроки = СтрЗаменить(ЗначениеСтроки, Символы.ВК, "");
	ЗначениеСтроки = СтрЗаменить(СокрЛП(ЗначениеСтроки), Символы.ВТаб, "");
	ЗначениеСтроки = СтрЗаменить(СокрЛП(ЗначениеСтроки), Символы.НПП, "");
	ЗначениеСтроки = СтрЗаменить(СокрЛП(ЗначениеСтроки), Символы.ПС, "");
	ЗначениеСтроки = СтрЗаменить(СокрЛП(ЗначениеСтроки), Символы.ПФ, "");
	ЗначениеСтроки = СтрЗаменить(СокрЛП(ЗначениеСтроки), Символы.Таб, "");
	
	Возврат СокрЛП(ЗначениеСтроки);
	
КонецФункции // УдалитьНедопустимыеСимволы()

