	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСчетов_Ex91",   ТаблицаСчетов_Ex91);
	Запрос.УстановитьПараметр("мТаблицаИнцидентов",   ТаблицаИнцидентов.Выгрузить());
	Запрос.УстановитьПараметр("мТаблицаСоответствий", ТаблицаСоответствий.Выгрузить());
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мТаблицаСчетов.ИдентификаторСчета,
		|	мТаблицаСчетов.ВидРасходов
		|ПОМЕСТИТЬ ТаблицаСчетов
		|ИЗ
		|	&ТаблицаСчетов_Ex91 КАК мТаблицаСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мТаблицаИнцидентов.ИдентификаторИнцидента,
		|	мТаблицаИнцидентов.ОтзывнаяНота,
		|	мТаблицаИнцидентов.Инцидент,
		|	мТаблицаИнцидентов.ЗаказНаряд
		|ПОМЕСТИТЬ ТаблицаИнцидентов
		|ИЗ
		|	&мТаблицаИнцидентов КАК мТаблицаИнцидентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мТаблицаСоответствий.ИдентификаторИнцидента,
		|	мТаблицаСоответствий.ИдентификаторСчета,
		|	мТаблицаСоответствий.ВидРасходов
		|ПОМЕСТИТЬ ТаблицаСоответсвий
		|ИЗ
		|	&мТаблицаСоответствий КАК мТаблицаСоответствий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСоответсвий.ИдентификаторИнцидента,
		|	ТаблицаСоответсвий.ИдентификаторСчета,
		|	ТаблицаСоответсвий.ВидРасходов
		|ПОМЕСТИТЬ СчетаEx91
		|ИЗ
		|	ТаблицаСоответсвий КАК ТаблицаСоответсвий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаСчетов КАК ТаблицаСчетов
		|		ПО ТаблицаСоответсвий.ИдентификаторСчета = ТаблицаСчетов.ИдентификаторСчета
		|			И (ТаблицаСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91))
		|			И ТаблицаСоответсвий.ВидРасходов = ТаблицаСчетов.ВидРасходов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаИнцидентов.ИдентификаторИнцидента КАК ИдентификаторИнцидента,
		|	ТаблицаИнцидентов.ОтзывнаяНота,
		|	ТаблицаИнцидентов.Инцидент,
		|	""В таблице 'Инциденты' для инцидента: '"" + ТаблицаИнцидентов.Инцидент + ""' не указана отзывная нота"" КАК ОписаниеОшибки,
		|	""-"" КАК Заявка,
		|	""Отзывная нота"" КАК Объект,
		|	ТаблицаИнцидентов.ЗаказНаряд КАК ЗаказНаряд
		|ИЗ
		|	СчетаEx91 КАК СчетаEx91
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаИнцидентов КАК ТаблицаИнцидентов
		|		ПО (ТаблицаИнцидентов.ОтзывнаяНота = ЗНАЧЕНИЕ(Справочник.СервисныеКампании.ПустаяСсылка))
		|			И СчетаEx91.ИдентификаторИнцидента = ТаблицаИнцидентов.ИдентификаторИнцидента
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИдентификаторИнцидента
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Отказ = Ложь;
	
	ВыборкаОшибок = Запрос.Выполнить().Выбрать();
	
	Если СформироватьТаблицуОшибок Тогда
		
		Пока ВыборкаОшибок.Следующий() Цикл
			
			НоваяСтрока = ТаблицаОшибок.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаОшибок);
			
			Если ТаблицаОшибокРаботыТовары <> Неопределено Тогда
				НоваяСтрокаРаботыТовары = ТаблицаОшибокРаботыТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРаботыТовары, ВыборкаОшибок);
			КонецЕсли;
			
			Отказ = Истина;
			
		КонецЦикла;
		
	Иначе 
		
		Пока ВыборкаОшибок.Следующий() Цикл
			Сообщить(СокрЛП(ВыборкаОшибок.ОписаниеОшибки), СтатусСообщения.Внимание);
			Отказ = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьЗаполнениеОтзывнойНоты()

&НаКлиенте
Процедура ТаблицаТоваровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Поле = Элементы.ТаблицаТоваровПричинаОбращения Тогда
		Элементы.ТаблицаТоваров.Обновить();
		
		Модифицированность = Истина;
		
	//С подачи ЮАГ делаем возможность выбора детали по Diverscode
	ИначеЕсли Поле = Элементы.ТаблицаТоваровАртикул Или Поле = Элементы.ТаблицаТоваровDiversCode Тогда
		
		ТипDiversCode = "Детали";
		РедактированиеСтроки = Истина;
		
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.EDR_ТипDiversCode.P")));
		
		Ответ = ОткрытьФормуМодально("Обработка.EDR_АРМПоГарантииNew.Форма.ФормаВыборDiversCode",ПараметрыФормы);
		//ФормаВыбора.ЗначениеОтбора = ПредопределенноеЗначение("Перечисление.EDR_ТипDiversCode.P");
		//Ответ = ФормаВыбора.ОткрытьМодально();
		
		Если ЗначениеЗаполнено(Ответ) Тогда
			
			ТекущаяСтрока.DiversCode = Ответ.Ссылка;
			ТекущаяСтрока.СтрокаИзЗаказНаряда = ЛОЖЬ;
			//ВыбраннаяСтрока.Номенклатура = Ответ.Наименование;
			
		КонецЕсли;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтарыеСчета(СтруктураПараметров)
	
	НаборУдаления = РегистрыСведений.EDR_Invoices.СоздатьНаборЗаписей();
	
	Для каждого ИзмерениеРегистра Из СтруктураПараметров Цикл
		НаборУдаления.Отбор[ИзмерениеРегистра.Ключ].Установить(ИзмерениеРегистра.Значение);
	КонецЦикла;
	
	НаборУдаления.Очистить();
	
	НаборУдаления.Записать(Истина);
	
КонецПроцедуры // УдалитьСтарыеСчета()

&НаКлиенте
Процедура ПроверитьЗаполнениеНоменклатуры(Отказ)
	
	Если Отказ Тогда
