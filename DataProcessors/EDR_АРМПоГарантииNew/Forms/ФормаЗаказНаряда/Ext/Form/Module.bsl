&НаКлиенте
Процедура ДобавитьИзображениеНаКлиенте()
	
	ТекущаяСтрока = Элементы.ТаблицаФотографий.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ИмяФайла) Тогда
		ПросмотретьПрисоединенныйФайл(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПросмотретьПрисоединенныйФайл(ТекущаяСтрока)
	
	ОчиститьСообщения();
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ИмяФайла) Тогда
		
		// Открытие Файла.
		Если ЗначениеЗаполнено(ТекущаяСтрока.ПолноеНаименование) Тогда
			ИмяОткрываемогоФайла = СокрЛП(ТекущаяСтрока.ПолноеНаименование);
		Иначе 
			ИмяОткрываемогоФайла = КаталогВременныхФайлов() + ТекущаяСтрока.ИмяФайла;
			
			СтруктураПоиска = Новый Структура("ЗаказНаряд,UID,ИмяФайла");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска,ТекущаяСтрока);
			
			ХранилищеКартинки = ПолучитьДвоичныеДанныеИзображения(СтруктураПоиска);
			
			Если ХранилищеКартинки = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			ФайлКартинки = ХранилищеКартинки.Получить();
			
			Попытка
				ФайлКартинки.Записать(ИмяОткрываемогоФайла);		
			Исключение
				
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				Предупреждение( Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='При открытии файла"
"""%1"""
"произошла ошибка:"
"""%2"".';en='When you open a file"
"""%1"""
"An error has occurred:"
"""% 2"".'"),
					ИмяОткрываемогоФайла,
				ИнформацияОбОшибке.Описание));
				
			КонецПопытки;
			
		КонецЕсли; 
		
		Попытка
			ЗапуститьПриложение(ИмяОткрываемогоФайла);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Предупреждение(Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='При открытии файла"
"""%1"""
"произошла ошибка:"
"""%2"".';en='When you open a file"
"""%1"""
"An error has occurred:"
"""% 2"".'"),
				ИмяОткрываемогоФайла,
				ИнформацияОбОшибке.Описание));
		КонецПопытки;
		
		ТекущаяСтрока.ПолноеНаименование = ИмяОткрываемогоФайла;
		
	Иначе
		ТекстСообщения = НСтр("ru='Отсутствует изображение для просмотра';en='No picture to show'");
		Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "АдресКартинки");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДвоичныеДанныеИзображения(ПараметрыПоиска)

	Запрос = Новый Запрос;
	
	Для каждого ПараметрЗапроса Из ПараметрыПоиска Цикл
		Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ,ПараметрЗапроса.Значение);	
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
		|	ПрикрепленныеФото.Данные
		|ИЗ
		|	РегистрСведений.EDR_ПрикрепленныеФото КАК ПрикрепленныеФото
		|ГДЕ
		|	ПрикрепленныеФото.ЗаказНаряд = &ЗаказНаряд
		|	И ПрикрепленныеФото.UID = &UID
		|	И ПрикрепленныеФото.ИмяФайла ПОДОБНО &ИмяФайла";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	Если ВыборкаДетальныеЗаписи.Следующий() И ВыборкаДетальныеЗаписи.Количество() = 1 Тогда
		Возврат ВыборкаДетальныеЗаписи.Данные;
	КонецЕсли; 
	
	Возврат Неопределено;

КонецФункции // ПолучитьДвоичныеДанныеИзображения()

&НаСервере
Процедура ЗаписатьУдалитьИзображенияЗаказНаряда(Отменить = Ложь)

	Для каждого ТекущаяСтрока Из ТаблицаФотографий Цикл
				
		Если Отменить И ТекущаяСтрока.НоваяСтрока Тогда
		
			НаборЗаписей = РегистрыСведений.EDR_ПрикрепленныеФото.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЗаказНаряд.Установить(ТекущаяСтрока.ЗаказНаряд);
			НаборЗаписей.Отбор.UID.Установить(ТекущаяСтрока.UID);
			
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			
			НаборЗаписей.Записать(Истина);
			
		ИначеЕсли Не Отменить И ТекущаяСтрока.Удалить Тогда 
		
			НаборЗаписей = РегистрыСведений.EDR_ПрикрепленныеФото.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЗаказНаряд.Установить(ТекущаяСтрока.ЗаказНаряд);
			НаборЗаписей.Отбор.UID.Установить(ТекущаяСтрока.UID);
			
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли; 
		
		ИмяФайлаУдаления = КаталогВременныхФайлов()+СокрЛП(ТекущаяСтрока.ИмяФайла);
		
		Файл = Новый Файл(ИмяФайлаУдаления);
		
		Если Файл.Существует() Тогда
			
			Попытка
				УдалитьФайлы(ИмяФайлаУдаления);
			Исключение
				ЗаписьЖурналаРегистрации("Удаление временного файла изображения",УровеньЖурналаРегистрации.Ошибка,,,КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));	
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла; 		

КонецПроцедуры // ЗаписатьУдалитьИзображенияЗаказНаряда()

&НаСервере
Функция ФильтрФайловИзображений()
	Возврат НСтр("ru = 'Все картинки (*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf)|*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf"
		                            + "|Формат bmp(*.bmp*;*.dib;*.rle)|*.bmp;*.dib;*.rle"
		                            + "|Формат GIF(*.gif*)|*.gif"
		                            + "|Формат JPEG(*.jpeg;*.jpg)|*.jpeg;*.jpg"
		                            + "|Формат PNG(*.png*)|*.png"
		                            + "|Формат TIFF(*.tif)|*.tif"
		                            + "|Формат icon(*.ico)|*.ico"
		                            + "|Формат метафайл(*.wmf;*.emf)|*.wmf;*.emf"
		                            + "|Все файлы(*.*)|*.*'");
									
								КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьФайлНаСервере(ЗаказНаряд,ПутьКФайлу,ИмяФайла,ИзображениеGUID,ДвоичныеДанныеИзображения)
	
	Попытка
		
		ХранилищеИзображения = Новый ХранилищеЗначения(Новый Картинка(ДвоичныеДанныеИзображения),Новый СжатиеДанных(9));
		
		НаборЗаписей = РегистрыСведений.EDR_ПрикрепленныеФото.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗаказНаряд.Установить(ЗаказНаряд);
		НаборЗаписей.Отбор.UID.Установить(ИзображениеGUID);
		
		НоваяСтрока = НаборЗаписей.Добавить();
		НоваяСтрока.UID 	   = ИзображениеGUID;
		НоваяСтрока.ЗаказНаряд = ЗаказНаряд;
		НоваяСтрока.Данные 	   = ХранилищеИзображения;
		НоваяСтрока.ИмяФайла   = ИмяФайла;
		
		НаборЗаписей.Записать(Истина);
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции // ЗаписатьФайлНаСервере()

