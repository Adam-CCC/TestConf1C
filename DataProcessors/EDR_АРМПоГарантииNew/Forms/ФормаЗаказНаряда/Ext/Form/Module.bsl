Процедура ТаблицаТоваровНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровНоменклатураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Тип("СправочникСсылка.Номенклатура") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ФормаПодбора = ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаСписка",,Элементы.ТаблицаТоваровНоменклатура);
		ФормаПодбора.РежимВыбора 		= Истина;
		
		ФормаПодбора.ЗакрыватьПриВыборе = Истина;
		
	ИначеЕсли ВыбранноеЗначение = Тип("СправочникСсылка.EDR_DiversCode") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Отбор = Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.EDR_ТипDiversCode.P"));
		
		ПараметрыФормы = Новый Структура("Отбор, ИсключитьIP", Отбор, Истина);
		
		ОткрытьФорму("Обработка.EDR_АРМПоГарантииNew.Форма.ФормаВыборDiversCode", ПараметрыФормы, Элементы.ТаблицаТоваровНоменклатура);
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		ТекущаяСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
		
		//Заполняем поля по умолчанию или очистим которые былы заполнены ранее
		ТекущаяСтрока.Цена 	      = 0;
		ТекущаяСтрока.СуммаСкидки = 0;
		ТекущаяСтрока.СуммаНДС    = 0;
		ТекущаяСтрока.СуммаВсего  = 0;
		ТекущаяСтрока.Количество  = 1;
		
		ТекущаяСтрока.ЗапретСнятияПричины = Истина;
		ТекущаяСтрока.ПричинаОбращения 	  = Истина;
		ТекущаяСтрока.НеВключатьВСчет 	  = Истина;
		
		ТекущаяСтрока.Артикул 	   = ВыбранноеЗначение.Артикул;
		ТекущаяСтрока.Номенклатура = ВыбранноеЗначение;
		ТекущаяСтрока.ЗаказНаряд   = ЗаказНаряд;
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.EDR_DiversCode") Тогда
		
		ТекущаяСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
		
		//Очистим поля которые былы заполнены ранее
		ТекущаяСтрока.Цена 		  = 0;
		ТекущаяСтрока.СуммаСкидки = 0;
		ТекущаяСтрока.СуммаНДС 	  = 0;
		ТекущаяСтрока.СуммаВсего  = 0;
		ТекущаяСтрока.Количество  = 1;
		
		ТекущаяСтрока.DiversCode   = ВыбранноеЗначение;
		ТекущаяСтрока.Артикул 	   = ВыбранноеЗначение.Код;
		ТекущаяСтрока.Номенклатура = ВыбранноеЗначение.Наименование;
		
		//добавляем ссылку на текущий заказ
		ТекущаяСтрока.ЗаказНаряд	= ЗаказНаряд;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровИнцидентПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаТоваров.ТекущиеДанные;
	
	СтруктураПоиска = Новый Структура("ЗаказНаряд, Инцидент", ЗаказНаряд, ТекущаяСтрока.Инцидент);
	
	СтрокиИнцидентов = ТаблицаИнцидентов.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиИнцидентов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаИнцидентов = СтрокиИнцидентов[0];
	
	Если Не ТекущаяСтрока.СтрокаИзЗаказНаряда Тогда
		
		//Отрабатываем логику доступа из параметров ExpenceCode
		ИдентификаторИнцидента = СтрокаИнцидентов.ИдентификаторИнцидента;
		
		DiversCodePart = ПолучитьПараметр_Булево_ExpenceCode(ЗаказНаряд, неопределено, ИдентификаторИнцидента, "Control_DiverPart");
		
		Если НЕ DiversCodePart тогда //Использовать Diverse code нельзя
			
			Предупреждение("У выбранного инцидента запрещено использование ""Diverse code"" для деталей");
			ТекущаяСтрока.Инцидент = "-";
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущаяСтрока.ИдентификаторИнцидента = СтрокаИнцидентов.ИдентификаторИнцидента;
	
	СтруктураПоиска = Новый Структура("ИдентификаторИнцидента, ПричинаОбращения", ТекущаяСтрока.ИдентификаторИнцидента, Истина);
	
	НайденныеСтрокиПричин = ТаблицаТоваров.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтрокиПричин.Количество() > 1 Тогда
		
		МассивСтрок = Новый Массив;
		
		Для каждого СтрокаПричин Из НайденныеСтрокиПричин Цикл
			
			СтруктураСтроки = Новый Структура("ЗаказНаряд,ИдентификаторИнцидента,ИдентификаторТовара,Артикул,Номенклатура,Инцидент");
			ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаПричин);
			
			МассивСтрок.Добавить(СтруктураСтроки);
			
		КонецЦикла;
		
		ПараметрыФормы = Новый Структура("МассивСтрок", МассивСтрок);
		
		ОткрытьФорму("Обработка.EDR_АРМПоГарантииNew.Форма.ФормаВыбораПричин", ПараметрыФормы, Элементы.ТаблицаТоваровИнцидент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаТоваровИнцидентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
