////#Область ЗаписьДанныхВРегистры

&НаСервере
Функция ЗаписатьИнформациюВРегистры()
	
	НачатьТранзакцию();
	
	Попытка
		
		ЗаписьИзмененийПоСчетам();
		ЗаписьИзмененийПоИнцидентам();
		ЗаписьИзмененийПоРаботам();
		ЗаписьИзмененийПоТоварам();
		ЗаписьИзмененийПоСоответствиям();
		ЗаписьИзмененийПоЗаказНарядам();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ЗаписатьВЖурналНаСервере(ЗаказНаряд,"Ошибка",ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ОтменитьТранзакцию();
		
		Возврат Ложь;
		
	КонецПопытки;
		
	Возврат Истина;
	
КонецФункции // ЗаписатьИнформациюВРегистры()

&НаСервере
Процедура ЗаписьИзмененийПоСчетам()
	
	////нужно отработать номер заявки при повторной отправке.
	Если ПовторнаяОтправка Тогда
	
		СтруктураПоиска = Новый Структура("ЗаказНаряд,Удален",ЗаказНаряд,Ложь);
		
		СтрокиСчетов = ТаблицаСчетов.НайтиСтроки(СтруктураПоиска);
		
		Для каждого ТекущаяСтрокаСчета Из СтрокиСчетов Цикл
			
			НомерЗаявкиПаттерн = EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(ЗаказНаряд);
			НовыйНомер = Прав(НомерЗаявкиПаттерн, 4) + "P";
			
			Если Найти(ТекущаяСтрокаСчета.Счет, НомерЗаявкиПаттерн) = 0 Тогда
				
				Если СтрДлина(ТекущаяСтрокаСчета.Счет) > 5 Тогда
				
					НовыйНомер = Лев(ТекущаяСтрокаСчета.Счет, СтрДлина(ТекущаяСтрокаСчета.Счет) - 1) + "P";
					ТекущаяСтрокаСчета.Счет = НовыйНомер;
					
				ИначеЕсли СтрДлина(ТекущаяСтрокаСчета.Счет) <= 5 Тогда
					
					ТекущаяСтрокаСчета.Счет = ТекущаяСтрокаСчета.Счет + "P";
					
				КонецЕсли;
				
			Иначе
			
				ТекущаяСтрокаСчета.Счет = СтрЗаменить(ТекущаяСтрокаСчета.Счет, НомерЗаявкиПаттерн, НовыйНомер);
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	//Измененные строки
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСчетов",ТаблицаСчетов.Выгрузить());
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСчетов.ЗаказНаряд КАК ЗаказНаряд,
		|	ТаблицаСчетов.Удален КАК Удален,
		|	ТаблицаСчетов.ИдентификаторСчета КАК GUID,
		|	ТаблицаСчетов.Категория КАК Категория,
		|	ТаблицаСчетов.ДатаИнвойса КАК ДатаИнвойса,
		|	ТаблицаСчетов.ВидРасходов КАК Expense_code,
		|	ТаблицаСчетов.СчетФактура КАК СчетФактура,
		|	ТаблицаСчетов.Счет КАК Invoice,
		|	ТаблицаСчетов.СчетДоИзменения КАК СчетДоИзменения
		|ПОМЕСТИТЬ мТаблицаСчетов
		|ИЗ
		|	&ТаблицаСчетов КАК ТаблицаСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мТаблицаСчетов.ЗаказНаряд КАК ЗаказНаряд,
		|	мТаблицаСчетов.СчетДоИзменения КАК Invoice,
		|	мТаблицаСчетов.GUID КАК GUID,
		|	мТаблицаСчетов.СчетФактура КАК СчетФактура
		|ИЗ
		|	мТаблицаСчетов КАК мТаблицаСчетов
		|ГДЕ
		|	НЕ мТаблицаСчетов.Удален
		|	И мТаблицаСчетов.СчетДоИзменения <> """"
		|	И мТаблицаСчетов.СчетДоИзменения <> мТаблицаСчетов.Invoice
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мТаблицаСчетов.ЗаказНаряд,
		|	мТаблицаСчетов.GUID,
		|	мТаблицаСчетов.ДатаИнвойса,
		|	мТаблицаСчетов.Expense_code,
		|	мТаблицаСчетов.СчетФактура,
		|	мТаблицаСчетов.Invoice,
		|	мТаблицаСчетов.Категория
		|ИЗ
		|	мТаблицаСчетов КАК мТаблицаСчетов
		|ГДЕ
		|	НЕ мТаблицаСчетов.Удален
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	мТаблицаСчетов.GUID
		|ИЗ
		|	мТаблицаСчетов КАК мТаблицаСчетов
		|ГДЕ
		|	мТаблицаСчетов.Удален";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаСтарыхСчетов = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаСтарыхСчетов.Следующий() Цикл
		
		СтруктураПараметровУдаления = Новый Структура;
		
		Для каждого ТекущаяКолонка Из РезультатЗапроса[1].Колонки  Цикл		
			СтруктураПараметровУдаления.Вставить(ТекущаяКолонка.Имя,ВыборкаСтарыхСчетов[ТекущаяКолонка.Имя]);	
		КонецЦикла; 
		
		УдалитьСтарыеСчета(СтруктураПараметровУдаления);
		
	КонецЦикла;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса[2].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураПараметров = Новый Структура;
		
		Для каждого ТекущаяКолонка Из РезультатЗапроса[2].Колонки  Цикл		
			СтруктураПараметров.Вставить(ТекущаяКолонка.Имя,ВыборкаДетальныеЗаписи[ТекущаяКолонка.Имя]);	
		КонецЦикла; 
		
		РегистрыСведений.EDR_Invoices.ОбновитьИнвойс(СтруктураПараметров);
		
	КонецЦикла;
	
	//Удаленные строки
	
	ВыборкаУдаления = РезультатЗапроса[3].Выбрать();
	
	Пока ВыборкаУдаления.Следующий() Цикл
		РегистрыСведений.EDR_Invoices.УдалитьИнвойс(ВыборкаУдаления.GUID);
	КонецЦикла; 
	
КонецПроцедуры // ЗаписьИзмененийПоСчетам()

