////#Область РасчетЛКМ

&НаСервере
Функция РассчетЛКМ(ТекстОшибки)
	
	//получим стоимость окраски
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидРемонта", ЗаказНаряд.ВидРемонта);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыРемонта.ЦенаЛКМ
		|ИЗ
		|	РегистрСведений.Renault_ВидыРемонтаДопРеквизиты КАК ВидыРемонта
		|ГДЕ
		|	ВидыРемонта.ВидРемонта = &ВидРемонта
		|	И ЕСТЬNULL(ВидыРемонта.ЦенаЛКМ, 0) <> 0";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ЦенаКраски = 490;
	
	Если Выборка.Следующий() Тогда
		ЦенаКраски = Выборка.ЦенаЛКМ;
	КонецЕсли;
	
	РезультатЗапроса = Неопределено;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТекДата",		ТекущаяДата());
	Запрос.УстановитьПараметр("ЗаказНаряд",		ЗаказНаряд);
	Запрос.УстановитьПараметр("ТаблицаРабот",	ТаблицаРаботы.Выгрузить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаРабот.ИдентификаторРаботы,
	|	ТаблицаРабот.ЗаказНаряд,
	|	ТаблицаРабот.Работа
	|ПОМЕСТИТЬ ТЗРабот
	|ИЗ
	|	&ТаблицаРабот КАК ТаблицаРабот
	|ГДЕ
	|	ТаблицаРабот.ЗаказНаряд = &ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЗРабот.ИдентификаторРаботы,
	|	ТЗРабот.ЗаказНаряд,
	|	ТЗРабот.Работа,
	|	Автоработы.Артикул
	|ПОМЕСТИТЬ ВремТЗ
	|ИЗ
	|	ТЗРабот КАК ТЗРабот
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Автоработы КАК Автоработы
	|		ПО ТЗРабот.Работа = Автоработы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТЗРабот
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВремТЗ.ИдентификаторРаботы,
	|	ВремТЗ.Работа
	|ИЗ
	|	РегистрСведений.OPERACODE_НормыРабот.СрезПоследних(&ТекДата, ВидРабот = ЗНАЧЕНИЕ(Перечисление.OPERACODE_ВидыРабот.P)) КАК OPERACODE_НормыРаботСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТЗ КАК ВремТЗ
	|		ПО OPERACODE_НормыРаботСрезПоследних.КодПоКаталогу = ВремТЗ.Артикул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремТЗ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаМалярныхРабот = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаМалярныхРабот.Следующий() Цикл
		
		НайденныеСтроки = ТаблицаРаботы.НайтиСтроки(Новый Структура("ИдентификаторРаботы, РаботаПоЛКМ", ВыборкаМалярныхРабот.ИдентификаторРаботы, Ложь));
		
		Для каждого СтрокаРабот Из НайденныеСтроки Цикл
			СтрокаРабот.РаботаПоЛКМ = Истина;
		КонецЦикла; 
		
	КонецЦикла; 
	
	РезультатЗапроса = Неопределено;
	
	СтруктураПоиска = Новый Структура("ЗаказНаряд,РаботаПоЛКМ",ЗаказНаряд,Истина);
	
	СтрокиДляПокраски = ТаблицаРаботы.НайтиСтроки(СтруктураПоиска);
	
	Если СтрокиДляПокраски.Количество() = 0 Тогда
		
		ТекстОшибки = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='По заказ-наряду:"
"""%1"""
"Запись изменений прервана по причине:"
"""%2"".';en='According to the order, as well as:"
"""%1"""
"Record changes canceled due to:"
"""% 2"".'"),
			"№ "+СокрЛП(ЗаказНаряд.Номер) + " от " + Формат(ЗаказНаряд.Дата,"ДФ=dd.MM.yyyy; ДП=-"),
			"Не указаны работы для расчета количества ЛКМ");
			
		Возврат Ложь;
		
	КонецЕсли;
	
	СтрокиДляПокраски = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаРабот", ТаблицаРаботы.Выгрузить());
	Запрос.УстановитьПараметр("ЦенаКраски",	  ЦенаКраски);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ТаблицаРабот.ЗаказНаряд КАК Документ.ЗаказНаряд) КАК ЗаказНаряд,
		|	ВЫРАЗИТЬ(ТаблицаРабот.ИдентификаторИнцидента КАК СТРОКА(50)) КАК ИдентификаторИнцидента,
		|	ВЫРАЗИТЬ(ТаблицаРабот.Инцидент КАК СТРОКА(1)) КАК Инцидент,
		|	ВЫРАЗИТЬ(ТаблицаРабот.СтавкаНДС КАК Справочник.СтавкиНДС) КАК СтавкаНДС,
		|	ВЫРАЗИТЬ(ТаблицаРабот.Количество КАК ЧИСЛО(15, 3)) КАК Количество,
		|	ВЫРАЗИТЬ(ТаблицаРабот.Коэффициент КАК ЧИСЛО(7, 2)) КАК Коэффициент,
		|	ВЫРАЗИТЬ(ТаблицаРабот.РаботаПоЛКМ КАК БУЛЕВО) КАК РаботаПоЛКМ
		|ПОМЕСТИТЬ мТаблицаРабот
		|ИЗ
		|	&ТаблицаРабот КАК ТаблицаРабот
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мТаблицаРабот.ИдентификаторИнцидента КАК ИдентификаторИнцидента,
		|	мТаблицаРабот.Инцидент КАК Инцидент,
		|	мТаблицаРабот.ЗаказНаряд
		|ИЗ
		|	мТаблицаРабот КАК мТаблицаРабот
		|ГДЕ
		|	мТаблицаРабот.РаботаПоЛКМ
		|
		|СГРУППИРОВАТЬ ПО
		|	мТаблицаРабот.ЗаказНаряд,
		|	мТаблицаРабот.ИдентификаторИнцидента,
		|	мТаблицаРабот.Инцидент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	мТаблицаРабот.СтавкаНДС КАК СтавкаНДС,
		|	мТаблицаРабот.ЗаказНаряд
		|ИЗ
		|	мТаблицаРабот КАК мТаблицаРабот
		|ГДЕ
		|	мТаблицаРабот.РаботаПоЛКМ
		|
		|СГРУППИРОВАТЬ ПО
		|	мТаблицаРабот.ЗаказНаряд,
		|	мТаблицаРабот.СтавкаНДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	мТаблицаРабот.ЗаказНаряд КАК ЗаказНаряд,
		|	СУММА(мТаблицаРабот.Количество * мТаблицаРабот.Коэффициент) КАК Длительность,
		|	мТаблицаРабот.СтавкаНДС КАК СтавкаНДС,
		|	ЕСТЬNULL(мТаблицаРабот.СтавкаНДС.Ставка, 0) КАК СтавкаПоНДС,
		|	мТаблицаРабот.Инцидент
		|ПОМЕСТИТЬ ВТ_Расчет
		|ИЗ
		|	мТаблицаРабот КАК мТаблицаРабот
		|ГДЕ
		|	мТаблицаРабот.РаботаПоЛКМ
		|
		|СГРУППИРОВАТЬ ПО
		|	мТаблицаРабот.ЗаказНаряд,
		|	мТаблицаРабот.СтавкаНДС,
		|	ЕСТЬNULL(мТаблицаРабот.СтавкаНДС.Ставка, 0),
		|	мТаблицаРабот.Инцидент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ мТаблицаРабот
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Расчет.ЗаказНаряд КАК ЗаказНаряд,
		|	ВТ_Расчет.Длительность КАК КоличествоКраски,
		|	ВТ_Расчет.СтавкаНДС КАК СтавкаНДС,
		|	ВТ_Расчет.СтавкаПоНДС КАК СтавкаПоНДС,
		|	ВТ_Расчет.Длительность * &ЦенаКраски * (1 - ВТ_Расчет.СтавкаПоНДС / 100) КАК СтоимостьКраски,
		|	ВТ_Расчет.Длительность * &ЦенаКраски * (ВТ_Расчет.СтавкаПоНДС / 100) КАК НДСКраски
		|ИЗ
		|	ВТ_Расчет КАК ВТ_Расчет";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаИнцидентов   = РезультатЗапроса[1].Выбрать();
	
	//Временно... если будут проблемы, то раскоментировать
	//Если ВыборкаИнцидентов.Количество() > 1 Тогда
	//		
	//	ТекстОшибки = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	//		НСтр("ru = 'По заказ-наряду:
	//		|""%1""
	//		|Запись изменений прервана по причине:
	//		|""%2"".'"),
	//		"№ "+СокрЛП(ЗаказНаряд.Номер) + " от " + Формат(ЗаказНаряд.Дата,"ДФ=dd.MM.yyyy; ДП=-"),
	//		"Работы для расчета количества ЛКМ распределены на несколько инцидентов");
	//		
	//	Возврат Ложь;
	//		
	//КонецЕсли; 
	
	ВыборкаСтавокНДС = РезультатЗапроса[2].Выбрать();
	
	//Временно... если будут проблемы, то раскоментировать
	//Если ВыборкаСтавокНДС.Количество() > 1 Тогда
	//		
	//	ТекстОшибки = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	//		НСтр("ru = 'По заказ-наряду:
	//		|""%1""
	//		|Запись изменений прервана по причине:
	//		|""%2"".'"),
	//		"№ "+СокрЛП(ЗаказНаряд.Номер) + " от " + Формат(ЗаказНаряд.Дата,"ДФ=dd.MM.yyyy; ДП=-"),
	//		"Работы для расчета количества ЛКМ распределены на несколько ставок НДС");
	//		
	//	Возврат Ложь;
	//	
	//КонецЕсли; 
	
	ВыборкаРасчет = РезультатЗапроса[5].Выбрать();
	ВыборкаРасчет.Следующий();
	
	Пока ВыборкаИнцидентов.Следующий() Цикл
		
		СтруктураПоиска = Новый Структура("ЗаказНаряд, РаботаПоЛКМ, Инцидент", ЗаказНаряд, Истина, ВыборкаИнцидентов.Инцидент);
		
		НайденныеСтроки = ТаблицаРаботы.НайтиСтроки(СтруктураПоиска);
		
		СколькоВсегоКоличество = 0;
		
		Для Каждого Строка из НайденныеСтроки Цикл
			
			СколькоВсегоКоличество = СколькоВсегоКоличество+Строка.Количество * Строка.Коэффициент;
			
		КонецЦикла;
		
		Если НайденныеСтроки.Количество() > 0  Тогда
			ПравильнаяСтрока = НайденныеСтроки[0];
			
			КоличествоКраски = СколькоВсегоКоличество;
			СтоимостьКраски  = ЦенаКраски*КоличествоКраски;
			НДСКраски        = ВыборкаРасчет.НДСКраски;
			СтавкаНДС        = ВыборкаРасчет.СтавкаНДС;
			
		Иначе 
			
			КоличествоКраски = ВыборкаРасчет.КоличествоКраски;
			СтоимостьКраски  = ВыборкаРасчет.СтоимостьКраски;
			НДСКраски        = ВыборкаРасчет.НДСКраски;
			СтавкаНДС        = ВыборкаРасчет.СтавкаНДС;
			
		КонецЕсли; 
		
		СтруктураПоиска = Новый Структура("ЗаказНаряд, Артикул, Инцидент",ЗаказНаряд, "IP", ВыборкаИнцидентов.Инцидент);
		
		НайденныеСтроки = ТаблицаТоваров.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() > 0  Тогда
			СтрокаСКраской = НайденныеСтроки[0];
		Иначе 
			СтрокаСКраской = ТаблицаТоваров.Добавить();
		КонецЕсли; 
		
		СтрокаСКраской.ЗаказНаряд			  = ЗаказНаряд;
		СтрокаСКраской.ИдентификаторИнцидента = ВыборкаИнцидентов.ИдентификаторИнцидента;
		СтрокаСКраской.Инцидент				  = ВыборкаИнцидентов.Инцидент;
		СтрокаСКраской.ИдентификаторТовара	  = Строка(Новый УникальныйИдентификатор());
		СтрокаСКраской.Артикул				  = Справочники.EDR_DiversCode.IP.Код;
		СтрокаСКраской.DiversCode			  = Справочники.EDR_DiversCode.IP;
		СтрокаСКраской.Номенклатура			  = Справочники.EDR_DiversCode.IP.Наименование;
		СтрокаСКраской.Количество			  = КоличествоКраски;
		СтрокаСКраской.СуммаВсего			  = СтоимостьКраски;
		СтрокаСКраской.СтавкаНДС			  = СтавкаНДС;
		СтрокаСКраской.Цена					  = ЦенаКраски;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // РассчетЛКМ()

////#КонецОбласти

////#Область ПроверкаКорректности

&НаСервере
Функция ПроверитьНаКорректность(ЭтоОшибкиРаботыТовары = Ложь, Отказ = Ложь)
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	СтруктураПараметров = Новый Структура("ЗаказНаряд,СемействоАвтомобиля,ГотовностьКОтправке,ЛКМ,OTS,ПовторнаяОтправка,Отправлен,ПробегАвтомобиля,ДатаОткрытия");
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, ЭтаФорма);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Для каждого ТекущийПараметр Из СтруктураПараметров Цикл
		Запрос.УстановитьПараметр(ТекущийПараметр.Ключ,ТекущийПараметр.Значение);
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("ТекущаяДата",	   НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Заявки", 		   ТаблицаСчетов.Выгрузить());
	Запрос.УстановитьПараметр("Инциденты",		   ТаблицаИнцидентов.Выгрузить());
	Запрос.УстановитьПараметр("СоответсвияСчетов", ТаблицаСоответствий.Выгрузить());
	Запрос.УстановитьПараметр("ТабНоменклатура",   ТаблицаТоваров.Выгрузить());
	Запрос.УстановитьПараметр("Работы", 		   ТаблицаРаботы.Выгрузить());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ЗаказНаряд КАК ЗаказНаряд,
	|	&OTS КАК OTS,
	|	&ГотовностьКОтправке КАК ГотовностьКОтправке,
	|	&ПовторнаяОтправка КАК ПовторнаяОтправка,
	|	&Отправлен КАК Отправлен,
	|	&ДатаОткрытия КАК ДатаОткрытия,
	|	&СемействоАвтомобиля КАК СемействоАвтомобиля,
	|	&ЛКМ КАК ЛКМ,
	|	&ПробегАвтомобиля КАК ПробегАвтомобиля,
	|	ВЫБОР
	|		КОГДА &Отправлен = ИСТИНА
	|				И &ПовторнаяОтправка = ИСТИНА
	|			ТОГДА ИСТИНА
	|		КОГДА &Отправлен = ИСТИНА
	|				И &ПовторнаяОтправка = ЛОЖЬ
	|			ТОГДА ЛОЖЬ
	|		КОГДА &Отправлен = ЛОЖЬ
	|				И &ПовторнаяОтправка = ЛОЖЬ
	|				И &ГотовностьКОтправке = ИСТИНА
	|			ТОГДА ИСТИНА
	|	КОНЕЦ КАК ПризнакОтбора
	|ПОМЕСТИТЬ ЗаказНаряды
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаряды.ЗаказНаряд,
	|	ЗаказНаряды.OTS,
	|	ЗаказНаряды.ГотовностьКОтправке,
	|	ЗаказНаряды.ПовторнаяОтправка,
	|	ЗаказНаряды.Отправлен,
	|	ЗаказНаряды.ДатаОткрытия,
	|	ЗаказНаряды.СемействоАвтомобиля,
	|	ЗаказНаряды.ЛКМ,
	|	ЗаказНаряды.ПробегАвтомобиля,
	|	&ТекущаяДата,
	|	ВЫБОР
	|		КОГДА ЗаказНаряды.ПовторнаяОтправка
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ВЫБОР
	|				КОГДА РАЗНОСТЬДАТ(&ТекущаяДата, ЗаказНаряды.ДатаОткрытия, ДЕНЬ) < 30
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ
	|	КОНЕЦ КАК ТребоватьСогласование
	|ПОМЕСТИТЬ ПаттерныЗН
	|ИЗ
	|	ЗаказНаряды КАК ЗаказНаряды
	|ГДЕ
	|	ЗаказНаряды.ПризнакОтбора
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ЗаказНаряды"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Получаем паттерн Заявок в менеджер ВТ
	ТекстЗапроса = "ВЫБРАТЬ
	|	Заявки.ЗаказНаряд,
	|	Заявки.Счет,
	|	Заявки.ИдентификаторСчета,
	|	Заявки.Категория,
	|	Заявки.ДатаИнвойса,
	|	Заявки.ВидРасходов,
	|	Заявки.Удален,
	|	Заявки.СчетФактура
	|ПОМЕСТИТЬ Заявки
	|ИЗ
	|	&Заявки КАК Заявки
	|ГДЕ
	|	Не Заявки.Удален
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Заявки.ЗаказНаряд КАК ЗаказНаряд,
	|	Заявки.Счет,
	|	Заявки.ИдентификаторСчета,
	|	Заявки.Категория,
	|	Заявки.ДатаИнвойса,
	|	Заявки.ВидРасходов,
	|	Заявки.Удален,
	|	Заявки.СчетФактура
	|ПОМЕСТИТЬ ПаттерныЗаявок
	|ИЗ
	|	Заявки КАК Заявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПаттерныЗН КАК ПаттерныЗН
	|		ПО Заявки.ЗаказНаряд = ПаттерныЗН.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Заявки"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Получаем паттерн соответсвий в менеджер ВТ
	//Из соответсвия потом получим какие инциденты нам нужны.
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	СоответсвияСчетов.ЗаказНаряд,
	|	СоответсвияСчетов.ИдентификаторСчета,
	|	СоответсвияСчетов.ИдентификаторИнцидента,
	|	СоответсвияСчетов.Процент,
	|	СоответсвияСчетов.ВидРасходов,
	|	СоответсвияСчетов.Категория
	|ПОМЕСТИТЬ Распределения
	|ИЗ
	|	&СоответсвияСчетов КАК СоответсвияСчетов
	|ГДЕ
	|	СоответсвияСчетов.Удален = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаттерныРаспределения.ЗаказНаряд,
	|	ПаттерныРаспределения.ИдентификаторСчета,
	|	ПаттерныРаспределения.ИдентификаторИнцидента,
	|	ПаттерныРаспределения.Процент,
	|	ПаттерныРаспределения.ВидРасходов,
	|	ПаттерныРаспределения.Категория
	|ПОМЕСТИТЬ ПаттерныРаспределения
	|ИЗ
	|	Распределения КАК ПаттерныРаспределения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПаттерныЗН КАК ПаттерныЗН
	|		ПО ПаттерныРаспределения.ЗаказНаряд = ПаттерныЗН.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Распределения"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	//Получаем паттерн инцидентов в менеджер ВТ
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Инциденты.Инцидент,
	|	Инциденты.ИдентификаторИнцидента,
	|	Инциденты.КодОщущенияКлиента,
	|	Инциденты.ФункциональныйКод,
	|	Инциденты.НомерСогласования,
	|	Инциденты.ОтзывнаяНота,
	|	Инциденты.НомерСФ,
	|	Инциденты.ДатаСФ,
	|	Инциденты.ПробегПриУстановке,
	|	Инциденты.ОписаниеОперации,
	|	Инциденты.ОписаниеЖалобы,
	|	Инциденты.КомментарийОперации,
	|	Инциденты.ЗаказНаряд
	|ПОМЕСТИТЬ Инциденты
	|ИЗ
	|	&Инциденты КАК Инциденты
	|ГДЕ
	|	Инциденты.Удален = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаттерныРаспределения.ИдентификаторИнцидента,
	|	ПаттерныРаспределения.ВидРасходов.Control_Indicator КАК ТребоватьПричину,
	|	ПаттерныРаспределения.ВидРасходов
	|ПОМЕСТИТЬ ВТТребоватьПричину
	|ИЗ
	|	ПаттерныРаспределения КАК ПаттерныРаспределения
	|ГДЕ
	|	(ПаттерныРаспределения.ВидРасходов.Control_Indicator = ИСТИНА
	|			ИЛИ ПаттерныРаспределения.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Инциденты.ЗаказНаряд,
	|	Инциденты.Инцидент,
	|	Инциденты.ИдентификаторИнцидента,
	|	Инциденты.КодОщущенияКлиента,
	|	Инциденты.ФункциональныйКод,
	|	Инциденты.НомерСогласования,
	|	Инциденты.ОтзывнаяНота,
	|	Инциденты.НомерСФ,
	|	Инциденты.ДатаСФ,
	|	Инциденты.ПробегПриУстановке,
	|	Инциденты.ОписаниеОперации,
	|	Инциденты.ОписаниеЖалобы,
	|	Инциденты.КомментарийОперации,
	|	ВЫБОР
	|		КОГДА ВТТребоватьПричину.ТребоватьПричину = ИСТИНА
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТребоватьПричину,
	|	ВЫБОР
	|		КОГДА ВТТребоватьПричину.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ТребоватьЖалобуКомментарий,
	|	ВТТребоватьПричину.ВидРасходов
	|ПОМЕСТИТЬ ПаттерныИнцидентов
	|ИЗ
	|	Инциденты КАК Инциденты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПаттерныЗН КАК ПаттерныЗН
	|		ПО Инциденты.ЗаказНаряд = ПаттерныЗН.ЗаказНаряд
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТребоватьПричину КАК ВТТребоватьПричину
	|		ПО Инциденты.ИдентификаторИнцидента = ВТТребоватьПричину.ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТТребоватьПричину
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Инциденты"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	ТекстЗапроса = "
	|Выбрать * 
	|ПОМЕСТИТЬ ПаттерныНоменклатуры
	|Из
	|  &ТабНоменклатура как ТабНоменклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|Выбрать * 
	|ПОМЕСТИТЬ ПаттерныРабот
	|Из
	|  &Работы как ТабРаботы"
	;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
	///////////////////////////////////
	////	Начинаем проверки
	//
	
	ДатаРелиза = Константы.EDR_ДатаРелиза.Получить();
	
	Если НЕ ЗначениеЗаполнено(ДатаРелиза) тогда
		
		НС = ТаблицаОшибок.Добавить();
		НС.ЗаказНаряд	  = "-";
		НС.Заявка		  = "-";
		НС.Инцидент		  = "-";
		НС.Объект		  = "Константа ""Дата релиза""";
		НС.ОписаниеОшибки = "Не заполнена константа Дата релиза.";
		
	КонецЕсли;
	
	ПроверитьВалюты(МВТ, ТаблицаОшибок);
	
	ПроверитьПроизводителей(МВТ, ТаблицаОшибок);
	
	ПроверитьНомераСогласования(МВТ, ТаблицаОшибок);
	
	ПроверитьПустыеКомментарии(МВТ, ТаблицаОшибок);
	
	ПроверитьЗаполнениеПолейИнцидентов(МВТ, ТаблицаОшибок, Отказ);
	
	ПроверитьЗаполнениеКатегорииЗаявок(МВТ, ТаблицаОшибок);
	
	ПроверитьЗаполнениеКодСтатьиРасходовЗаявок(МВТ, ТаблицаОшибок);
	
	ПроверитьПустыеЗаявки(МВТ, ТаблицаОшибок);
	
	ПроверитьПотерянныеИнциденты(МВТ, ТаблицаОшибок);
	
	ПроверитьКодРасходов_19(МВТ, ТаблицаОшибок);
	
	ПроверитьНоменклатуруИАвтоработыНаСоответствие(МВТ, ТаблицаОшибок,ТаблицаОшибокРаботыТовары);
	
	ПроверитьПричиныОбращения(МВТ, ТаблицаОшибок);
	
	Если ТаблицаОшибок.Количество() > 0 тогда //Есть ошибки
		
		ВсеНормально = Ложь;
		
		Если ТаблицаОшибокРаботыТовары.Количество() = ТаблицаОшибок.Количество() Тогда
			ЭтоОшибкиРаботыТовары = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТаблицаОшибок.Количество() > 0 тогда //Есть ошибки
		Возврат Ложь;
	КонецЕсли;
	
	//Удаляем все временные таблицы
	МВТ = Неопределено;
		
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПроверитьВалюты(МВТ, ТаблицаОшибок) 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ПаттерныЗН.ЗаказНаряд.ВалютаДокумента КАК Валюта
	|ПОМЕСТИТЬ ОшибкиВалюты
	|ИЗ
	|	ПаттерныЗН КАК ПаттерныЗН
	|ГДЕ
	|	""RUB"" = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""-"" КАК ЗаказНаряд,
	|	""-"" КАК Заявка,
	|	""-"" КАК Инцидент,
	|	""Валюта "" + ОшибкиВалюты.Валюта.Наименование КАК Объект,
	|	""Не заполнен код валюты по ISO"" КАК ОписаниеОшибки
	|ИЗ
	|	ОшибкиВалюты КАК ОшибкиВалюты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиВалюты"
	;
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьВалюты(МВТ, ТаблицаОшибок)

&НаСервере
Процедура ПроверитьПроизводителей(МВТ, ТаблицаОшибок) 

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ПаттерныЗН.ЗаказНаряд,
	|	ПаттерныЗН.ЗаказНаряд.Автомобиль КАК Автомобиль
	|ПОМЕСТИТЬ ВТПроизводители
	|ИЗ
	|	ПаттерныЗН КАК ПаттерныЗН
	|ГДЕ
	|	ПаттерныЗН.ЗаказНаряд.Автомобиль.Модель.Производитель = ЗНАЧЕНИЕ(Справочник.Производители.ПустаяСсылка)
	//Добавлена проверка на Марку MO 2015.01.12
	| И ПаттерныЗН.ЗаказНаряд.Автомобиль.Модель НЕ В (&МоделиМарки)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПаттерныЗН.ЗаказНаряд.Автомобиль,
	|	ПаттерныЗН.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПроизводители.ЗаказНаряд,
	|	""-"" КАК Заявка,
	|	""-"" КАК Инцидент,
	|	ВТПроизводители.Автомобиль КАК Объект,
	|	""У модели автомобиля не указан производитель"" КАК ОписаниеОшибки
	|ИЗ
	|	ВТПроизводители КАК ВТПроизводители
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТПроизводители"
	;
	
	//Добавлена проверка на Марку MO 2015.01.12
	Запрос.УстановитьПараметр("МоделиМарки", Справочники.CRM_МаркаАвтомобиля.RENAULT.МоделиАвтомобилей.ВыгрузитьКолонку("Модель"));	
	
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры // ПроверитьПроизводителей(МВТ, ТаблицаОшибок)

&НаСервере
Процедура ПроверитьНомераСогласования(МВТ, ТаблицаОшибок)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПаттерныЗН.ЗаказНаряд КАК ЗаказНаряд,
	|	ПаттерныЗН.ТребоватьСогласование
	|ПОМЕСТИТЬ Заказы
	|ИЗ
	|	ПаттерныЗН КАК ПаттерныЗН
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаттерныРаспределения.ИдентификаторСчета,
	|	ПаттерныРаспределения.ИдентификаторИнцидента,
	|	ПаттерныРаспределения.ЗаказНаряд,
	|	ПаттерныРаспределения.ВидРасходов
	|ПОМЕСТИТЬ Распределение
	|ИЗ
	|	ПаттерныРаспределения КАК ПаттерныРаспределения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заказы КАК Заказы
	|		ПО ПаттерныРаспределения.ЗаказНаряд = Заказы.ЗаказНаряд
	|ГДЕ
	|	ПаттерныРаспределения.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex57)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаттерныИнцидентов.ЗаказНаряд,
	|	ПаттерныИнцидентов.Инцидент,
	|	ПаттерныИнцидентов.НомерСогласования
	|ПОМЕСТИТЬ ИнцидентыБезСогласования
	|ИЗ
	|	ПаттерныИнцидентов КАК ПаттерныИнцидентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Распределение КАК Распределение
	|		ПО ПаттерныИнцидентов.ИдентификаторИнцидента = Распределение.ИдентификаторИнцидента
	|ГДЕ
	|	ПаттерныИнцидентов.НомерСогласования = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Заказы.ЗаказНаряд
	|ПОМЕСТИТЬ ЗаказыСОбязательнымСогласованием
	|ИЗ
	|	Заказы КАК Заказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Распределение КАК Распределение
	|		ПО Заказы.ЗаказНаряд = Распределение.ЗаказНаряд
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Заказы.ЗаказНаряд
	|ИЗ
	|	Заказы КАК Заказы
	|ГДЕ
	|	Заказы.ТребоватьСогласование = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Заказы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Распределение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыСОбязательнымСогласованием.ЗаказНаряд КАК ЗаказНаряд,
	|	ИнцидентыБезСогласования.Инцидент КАК Инцидент,
	|	""-"" КАК Заявка,
	|	""Номер согласования"" КАК Объект,
	|	""Не заполнен номер согласования"" КАК ОписаниеОшибки
	|ИЗ
	|	ЗаказыСОбязательнымСогласованием КАК ЗаказыСОбязательнымСогласованием
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИнцидентыБезСогласования КАК ИнцидентыБезСогласования
	|		ПО ЗаказыСОбязательнымСогласованием.ЗаказНаряд = ИнцидентыБезСогласования.ЗаказНаряд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ЗаказыСОбязательнымСогласованием
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ИнцидентыБезСогласования"
	;
	
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПустыеКомментарии(МВТ, ТаблицаОшибок)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	// Комментарий 
	//Дата создания - 09.04.2012 16:31:25; Автор - Окипний Андрей Евгеньевич
	//
	//Выполним поиск пустых комментариев и жалоб клиента
	//Всю проверку сделаем одним пакетным запросом. 
	//
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПаттерныИнцидентов.ИдентификаторИнцидента,
	|	ПаттерныИнцидентов.ЗаказНаряд,
	|	ПаттерныИнцидентов.Инцидент,
	|	ПаттерныИнцидентов.КодОщущенияКлиента,
	|	ПаттерныИнцидентов.ФункциональныйКод,
	|	ПаттерныИнцидентов.НомерСогласования,
	|	ПаттерныИнцидентов.ОтзывнаяНота,
	|	ПаттерныИнцидентов.НомерСФ,
	|	ПаттерныИнцидентов.ДатаСФ,
	|	ПаттерныИнцидентов.ПробегПриУстановке,
	|	ПаттерныИнцидентов.ОписаниеОперации,
	|	ПаттерныИнцидентов.ОписаниеЖалобы,
	|	ПаттерныИнцидентов.КомментарийОперации,
	|	ПаттерныИнцидентов.ТребоватьЖалобуКомментарий,
	|	ПаттерныИнцидентов.ВидРасходов
	|ПОМЕСТИТЬ ВремИнциденты
	|ИЗ
	|	ПаттерныИнцидентов КАК ПаттерныИнцидентов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремИнциденты.ЗаказНаряд,
	|	ВремИнциденты.Инцидент,
	|	""-"" КАК Заявка,
	|	""Комментарий"" КАК Объект,
	|	""Не указан комментарий"" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиКомментарии
	|ИЗ
	|	ВремИнциденты КАК ВремИнциденты
	|ГДЕ
	|	ВремИнциденты.КомментарийОперации = """"
	|	И ВремИнциденты.ТребоватьЖалобуКомментарий = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремИнциденты.ЗаказНаряд,
	|	ВремИнциденты.Инцидент,
	|	""-"" КАК Заявка,
	|	""Жалоба клиента"" КАК Объект,
	|	""Не указана жалоба клиента"" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиЖалобы
	|ИЗ
	|	ВремИнциденты КАК ВремИнциденты
	|ГДЕ
	|	ПОДСТРОКА(ВремИнциденты.ОписаниеЖалобы, 0, 1000) = """"
	|	И ВремИнциденты.ТребоватьЖалобуКомментарий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОшибкиКомментарии.ЗаказНаряд КАК ЗаказНаряд,
	|	ОшибкиКомментарии.Инцидент КАК Инцидент,
	|	ОшибкиКомментарии.Заявка КАК Заявка,
	|	ОшибкиКомментарии.Объект КАК Объект,
	|	ОшибкиКомментарии.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	ОшибкиКомментарии КАК ОшибкиКомментарии
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОшибкиЖалобы.ЗаказНаряд,
	|	ОшибкиЖалобы.Инцидент,
	|	ОшибкиЖалобы.Заявка,
	|	ОшибкиЖалобы.Объект,
	|	ОшибкиЖалобы.ОписаниеОшибки
	|ИЗ
	|	ОшибкиЖалобы КАК ОшибкиЖалобы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиКомментарии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиЖалобы"
	;
	
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеПолейИнцидентов(МВТ, ТаблицаОшибок, Отказ = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	// Комментарий 
	//Дата создания - 10.04.2012 10:41:41; Автор - Окипний Андрей Евгеньевич
	//Выполним поиск пустых комментариев и жалоб клиента
	//Всю проверку сделаем одним пакетным запросом. 
	//
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВремИнциденты.ИдентификаторИнцидента,
	|	ВремИнциденты.ЗаказНаряд,
	|	ВремИнциденты.Инцидент,
	|	ВремИнциденты.КодОщущенияКлиента,
	|	ВремИнциденты.ФункциональныйКод,
	|	ВремИнциденты.ОтзывнаяНота
	|ПОМЕСТИТЬ ВремТЗ_OTS_ФК_КОК
	|ИЗ
	|	ВремИнциденты КАК ВремИнциденты
	|ГДЕ
	|	ВремИнциденты.ВидРасходов <> &ВидРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТЗ_OTS_ФК_КОК.ЗаказНаряд,
	|	ВремТЗ_OTS_ФК_КОК.Инцидент,
	|	""-"" КАК Заявка,
	|	""Функциональный код"" КАК Объект,
	|	""Не заполнен функциональный код"" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиФК
	|ИЗ
	|	ВремТЗ_OTS_ФК_КОК КАК ВремТЗ_OTS_ФК_КОК
	|ГДЕ
	|	ВремТЗ_OTS_ФК_КОК.ФункциональныйКод = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаряды.ЗаказНаряд
	|ПОМЕСТИТЬ Заказы_с_OTS
	|ИЗ
	|	ПаттерныЗН КАК ЗаказНаряды
	|ГДЕ
	|	ЗаказНаряды.OTS = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТЗ_OTS_ФК_КОК.ЗаказНаряд,
	|	ВремТЗ_OTS_ФК_КОК.Инцидент,
	|	""-"" КАК Заявка,
	|	""Отзывная нота"" КАК Объект,
	|	""Не указана отзывная компания"" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиOTS
	|ИЗ
	|	ВремТЗ_OTS_ФК_КОК КАК ВремТЗ_OTS_ФК_КОК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заказы_с_OTS КАК Заказы_с_OTS
	|		ПО ВремТЗ_OTS_ФК_КОК.ЗаказНаряд = Заказы_с_OTS.ЗаказНаряд
	|ГДЕ
	|	ВремТЗ_OTS_ФК_КОК.ОтзывнаяНота = ЗНАЧЕНИЕ(Справочник.СервисныеКампании.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Заказы_с_OTS
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПроверкиКОК.ИдентификаторИнцидента
	|ПОМЕСТИТЬ ТаблицаПроверкиКОК
	|ИЗ
	|	&ТаблицаПроверкиКОК КАК ТаблицаПроверкиКОК
	|ГДЕ
	|	ТаблицаПроверкиКОК.Control_EC = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремТЗ_OTS_ФК_КОК.ЗаказНаряд,
	|	ВремТЗ_OTS_ФК_КОК.Инцидент,
	|	""-"" КАК Заявка,
	|	""Код ощущения/жалобы клиента"" КАК Объект,
	|	""Не заполнено поле """"Код ощущения\жалобы клиента"""""" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ ОшибкиКОК
	|ИЗ
	|	ВремТЗ_OTS_ФК_КОК КАК ВремТЗ_OTS_ФК_КОК
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПроверкиКОК КАК ТаблицаПроверкиКОК
	|		ПО ВремТЗ_OTS_ФК_КОК.ИдентификаторИнцидента = ТаблицаПроверкиКОК.ИдентификаторИнцидента
	|ГДЕ
	|	ВремТЗ_OTS_ФК_КОК.КодОщущенияКлиента = ЗНАЧЕНИЕ(Справочник.EDR_КодыОщущенийКлиента.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаПроверкиКОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОшибкиФК.ЗаказНаряд,
	|	ОшибкиФК.Инцидент,
	|	ОшибкиФК.Заявка,
	|	ОшибкиФК.Объект,
	|	ОшибкиФК.ОписаниеОшибки
	|ИЗ
	|	ОшибкиФК КАК ОшибкиФК
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОшибкиOTS.ЗаказНаряд,
	|	ОшибкиOTS.Инцидент,
	|	ОшибкиOTS.Заявка,
	|	ОшибкиOTS.Объект,
	|	ОшибкиOTS.ОписаниеОшибки
	|ИЗ
	|	ОшибкиOTS КАК ОшибкиOTS
	|ГДЕ
	|	ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОшибкиКОК.ЗаказНаряд,
	|	ОшибкиКОК.Инцидент,
	|	ОшибкиКОК.Заявка,
	|	ОшибкиКОК.Объект,
	|	ОшибкиКОК.ОписаниеОшибки
	|ИЗ
	|	ОшибкиКОК КАК ОшибкиКОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиOTS
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиКОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОшибкиФК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремТЗ_OTS_ФК_КОК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремИнциденты"
	;
	
	ТаблицаПараметровВидовРасходов = ОбновитьТаблицуПараметровВидовРасходов();
	
	Запрос.УстановитьПараметр("ТаблицаПроверкиКОК", ТаблицаПараметровВидовРасходов);
	Запрос.УстановитьПараметр("ВидРасходов", Справочники.EDR_ВидыРасходов.Ex91);
	Запрос.Текст = ТекстЗапроса;
	
	СформироватьЗаписиОшибок(Запрос, ТаблицаОшибок);
	
	Отказ = Ложь;
	
	ПроверитьЗаполнениеОтзывнойНоты(Отказ,Истина);
	
КонецПроцедуры // ПроверитьЗаполнениеПолейИнцидентов(МВТ, ТаблицаОшибок)

&НаСервере
Процедура ПроверитьЗаполнениеКатегорииЗаявок(МВТ, ТаблицаОшибок)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	// Комментарий 
	//Дата создания - 10.04.2012 13:19:03; Автор - Окипний Андрей Евгеньевич
	//Выполним поиск пустых категорий в таблице заявок
	//Всю проверку сделаем одним пакетным запросом. 
	//
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПаттерныЗаявок.ЗаказНаряд,
	|	ПаттерныЗаявок.Счет КАК Заявка,
	|	""-"" КАК Инцидент,
	|	""Категория"" КАК Объект,
	|	""Не заполнено поле """"Категория"""""" КАК ОписаниеОшибки
	|ИЗ
	|	ПаттерныЗаявок КАК ПаттерныЗаявок
	|ГДЕ
	|	ПаттерныЗаявок.Категория = ЗНАЧЕНИЕ(Справочник.EDR_КатегорииСчетов.ПустаяСсылка)"
