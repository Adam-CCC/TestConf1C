		ТекущаяСтрока.ПричинаОбращения = Ложь;
		ТекущаяСтрока.РаботаПоЛКМ 	   = Ложь;
		
	КонецЕсли; 
	
	Отказ = Истина;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРаботыПриАктивизацииЯчейки(Элемент)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.НеСтандартнаяОперация 
		И Элемент.ТекущийЭлемент.Имя = "ТаблицаРаботыАртикул" Тогда
		
		Элементы.ТаблицаРаботыАртикул.РежимВыбораИзСписка = Истина;
		
		Элементы.ТаблицаРаботыАртикул.КнопкаСпискаВыбора = Истина;
		
		Элементы.ТаблицаРаботыАртикул.СписокВыбора.Очистить();
		
		Элементы.ТаблицаРаботыАртикул.СписокВыбора.Добавить("1777", "1777");
		Элементы.ТаблицаРаботыАртикул.СписокВыбора.Добавить("1888", "1888");
		Элементы.ТаблицаРаботыАртикул.СписокВыбора.Добавить("8888", "8888");

		
		Если ТекущаяСтрока.РаботаПоЛКМ тогда
			Элементы.ТаблицаРаботыАртикул.СписокВыбора.Добавить("1999", "1999");
		КонецЕсли;
		
	ИначеЕсли Не ТекущаяСтрока.НеСтандартнаяОперация 
		И Элемент.ТекущийЭлемент.Имя = "ТаблицаРаботыАртикул" Тогда
		
		Элементы.ТаблицаРаботыАртикул.РежимВыбораИзСписка = Ложь;
		
		Элементы.ТаблицаРаботыАртикул.КнопкаСпискаВыбора = Ложь;
		
		Элементы.ТаблицаРаботыАртикул.СписокВыбора.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

