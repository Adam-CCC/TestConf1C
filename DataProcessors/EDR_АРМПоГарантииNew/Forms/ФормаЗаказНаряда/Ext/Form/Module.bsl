	//СтруктураПоиска = Новый Структура("ЗаказНаряд,Удален",ЗаказНаряд,Ложь);
	
	//СтрокиСчетовПоИдентификатору = ТаблицаСчетов.НайтиСтроки(СтруктураПоиска);
	
