&НаКлиенте
Процедура ДобавитьИзображение(Команда)
	
	Фильтр = ФильтрФайловИзображений();
	
	ВыборФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ВыборФайла.МножественныйВыбор = Ложь;
	ВыборФайла.Заголовок = НСтр("ru='Выбор файла';en='file selection'");
	ВыборФайла.Фильтр = ?(ЗначениеЗаполнено(Фильтр), Фильтр, НСтр("ru='Все файлы';en='All files'") + " (*.*)|*.*");
	
	Если ВыборФайла.Выбрать() Тогда
		
		ПрисоединенныйФайл = ВыборФайла.ВыбранныеФайлы[0];
		
		ПоказатьОповещениеПользователя(
			НСтр("ru='Создание:';en='Creature:'"),,
			//ПолучитьНавигационнуюСсылку(ПрисоединенныйФайл),
			ПрисоединенныйФайл,
			БиблиотекаКартинок.Информация32);
		
		Файл = Новый Файл(ПрисоединенныйФайл);
		
		Если Файл.Существует() Тогда
			
			ДвоичныеДанныеИзображения = Новый ДвоичныеДанные(ПрисоединенныйФайл);
			
			ИзображениеGUID = СокрЛП(Новый УникальныйИдентификатор);
			
			Успешно = ЗаписатьФайлНаСервере(ЗаказНаряд, ПрисоединенныйФайл, Файл.Имя, ИзображениеGUID, ДвоичныеДанныеИзображения);
			
			Если Успешно Тогда
				
				НоваяСтрока = ТаблицаФотографий.Добавить();
				
				НоваяСтрока.ЗаказНаряд  	   = ЗаказНаряд;
				НоваяСтрока.UID 	    	   = ИзображениеGUID;
				НоваяСтрока.ИмяФайла    	   = Файл.Имя;
				НоваяСтрока.НоваяСтрока 	   = Истина;
				НоваяСтрока.ПолноеНаименование = Файл.ПолноеИмя;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

