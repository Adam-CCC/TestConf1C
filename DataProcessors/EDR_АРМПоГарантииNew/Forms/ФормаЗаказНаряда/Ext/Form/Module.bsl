&НаСервере
Процедура НастроитьКолонкуНомерСогласованияИнцидентов()
	
	//Инициализация флага
	Отображать = Ложь;
	
	//При просрочке более 30 дней, заказ наряд может быть уже отправлен, поэтому расчитывать просрочку 
	//для отправленных нет смысла
	Если Не Отправлен тогда
		//Теперь смотрим на сколько запаздывает начало заказ наряда от текущей даты
		//если запоздание более или равно 30 дней - нужно колонку открывать
		
		ДатаНачала	  = НачалоДня(ЗаказНаряд.ДатаСоздания);
		ДнейПросрочки = Число(?(ТекущаяДата() - ДатаНачала = 0,1, ТекущаяДата() - ДатаНачала))/60/60/24;
		
		Если Окр(ДнейПросрочки) >= 30 тогда
			Отображать = Истина;
		КонецЕсли;
		
	Иначе
		
		Отображать = ПовторнаяОтправка;
				
	КонецЕсли;
	
	
	//Если Отображать уже истина - нет смысла выполнять запрос.
	Если НЕ Отображать тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ТабСчета.ЗаказНаряд,
		|	ТабСчета.ВидРасходов
		|ПОМЕСТИТЬ ТабСчетов
		|ИЗ
		|	&ТабСчета КАК ТабСчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ТабСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex57)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьКод57
		|ИЗ
		|	ТабСчетов КАК ТабСчетов
		|ГДЕ
		|	ТабСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex57)
		|	И ТабСчетов.ЗаказНаряд = &ЗаказНаряд
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ТабСчетов"
		);
		Запрос.УстановитьПараметр("ТабСчета",   ТаблицаСчетов.Выгрузить());
		Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() и Результат.ЕстьКод57 тогда
			Отображать = Истина
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ТаблицаИнцидентовНомерСогласования.Видимость = Отображать;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьИспользованиеСчета(ИдентификаторСчета) Экспорт
	
	СтруктураРезультата = Новый Структура;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	//Таблицы в Менеджер
	//Соответствия
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТСоответствия
	|ИЗ
	|	&ТаблицаСоответствий КАК ТаблицаСоответствий";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаСоответствий",ТаблицаСоответствий.Выгрузить());
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТСоответствия.Идентификатор,
	|	ВТСоответствия.ИдентификаторСчета
	|ИЗ
	|	ВТСоответствия КАК ВТСоответствия
	|ГДЕ
	|	ВТСоответствия.ИдентификаторСчета = &ИдентификаторСчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСоответствия";
	
	Запрос.УстановитьПараметр("ИдентификаторСчета",ИдентификаторСчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИдентификаторов = РезультатЗапроса.Выбрать();
	
	МассивИдентификаторов = Новый Массив;
	
	Пока ВыборкаИдентификаторов.Следующий() Цикл
		МассивИдентификаторов.Добавить(ВыборкаИдентификаторов.Идентификатор);	
	КонецЦикла; 
	
	СтруктураРезультата.Вставить("Соответствия",МассивИдентификаторов);
	
	Если МассивИдентификаторов.Количество() > 0 тогда
		СтруктураРезультата.Вставить("ЕстьИспользование", Истина);
	Иначе
		СтруктураРезультата.Вставить("ЕстьИспользование", Ложь);
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьДругойСчет(СтруктураИспользованияСчета,ИдентификаторСчета,Успешно)
	
