&НаСервере
Функция ЗаполнитьЦеныПоАктуальномуТарифуНаСервере()
	
	ВебСервис = Renault_АвтосервисСерверПовтИспользования.ПолучитьПроксиPartsCostHist();
	BIR = DMS_ВыгрузкаEDRСервер.ПолучитьИдентификаторBIRПоОрганизации(ЗаказНаряд.Организация);
	Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
	
	ТаблицаИзменений = Новый ТаблицаЗначений;
	
	ТаблицаИзменений.Колонки.Добавить("Артикул");
	ТаблицаИзменений.Колонки.Добавить("Номенклатура");
	ТаблицаИзменений.Колонки.Добавить("СтараяЦена",,"Старая цена");
	ТаблицаИзменений.Колонки.Добавить("НоваяЦена",, "Новая цена");
	ТаблицаИзменений.Колонки.Добавить("ДатаТарифа", , "Дата тарифа");
	ТаблицаИзменений.Колонки.Добавить("СрочныйТариф", , "Срочный тариф");

	
	Для Каждого Реферанс из ТаблицаТоваров Цикл
		
		Если ЗначениеЗаполнено(Реферанс.DiversCode) Тогда
			
			Продолжить;
				
		КонецЕсли;
		
		НовыйЦены = Сериализатор.ПрочитатьXDTO(ВебСервис.GetPriceHistory(BIR, Реферанс.Артикул));
			
		Результат = ПолучитьАктуальнуюЦенуЗаПериод(НовыйЦены, ДатаОткрытия);
		
		Если ЗначениеЗаполнено(Результат) Тогда
				
			НоваяСтрока = ТаблицаИзменений.Добавить();
			НоваяСтрока.Артикул = Реферанс.Артикул;
			НоваяСтрока.Номенклатура = Реферанс.Номенклатура;
			НоваяСтрока.СтараяЦена = Реферанс.Цена;
			Если ЗначениеЗаполнено(Реферанс.ЗаказНаряд) и ЗначениеЗаполнено(Реферанс.ЗаказНаряд.ТипЦен) 
					и Реферанс.ЗаказНаряд.ТипЦен.ЦенаВключаетНДС Тогда
				СуммаНДС   = Реферанс.Цена - (100 *Реферанс.Цена / (100 + Реферанс.СтавкаНДС.Ставка)); 
				НоваяСтрока.СтараяЦена = НоваяСтрока.СтараяЦена - СуммаНДС; 
			КонецЕсли;
			
			Если Реферанс.СрочныйТариф=Истина Тогда
				НоваяСтрока.НоваяЦена = Результат.PNCU;
			Иначе
				НоваяСтрока.НоваяЦена = Результат.PNC;
			КонецЕсли;
			НоваяСтрока.ДатаТарифа = Результат.Период;
			НоваяСтрока.СрочныйТариф = Реферанс.СрочныйТариф;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаИзменений;
	
КонецФункции

&НаСервере
Функция ПолучитьАктуальнуюЦенуЗаПериод(ТаблицаЦен, Дата)
	
	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	
	ТаблицаЦен.Сортировать("Период Убыв");
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТаблицаЦена.Артикул,
	               |	ТаблицаЦена.Период,
	               |	ТаблицаЦена.PCL,
	               |	ТаблицаЦена.PNC,
	               |	ТаблицаЦена.PNCU
	               |ПОМЕСТИТЬ ПредВыбор
	               |ИЗ
	               |	&ТаблицаЦена КАК ТаблицаЦена
	               |ГДЕ
	               |	ТаблицаЦена.PNCU > 0
	               |	И ТаблицаЦена.Период <= &ДатаОткрытия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПредВыбор.Артикул,
	               |	ПредВыбор.Период,
	               |	ПредВыбор.PCL,
	               |	ПредВыбор.PNC,
	               |	ПредВыбор.PNCU
	               |ИЗ
	               |	ПредВыбор КАК ПредВыбор";
	
	Запрос.УстановитьПараметр("ТаблицаЦена", ТаблицаЦен);
	Запрос.УстановитьПараметр("ДатаОткрытия", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("Период", Выборка.Период);
		Результат.Вставить("PNCU", Выборка.PNCU);
		Результат.Вставить("PNC", Выборка.PNC);
		
		Возврат Результат;
		
	Иначе
		
		Возврат Неопределено;
		
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЦеныПоАктуальномуТарифу(Команда)
	ТаблицаИзменений = ЗаполнитьЦеныПоАктуальномуТарифуНаСервере();
	
	Если ЗначениеЗаполнено(ТаблицаИзменений) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТаблицаИзменений",ТаблицаИзменений);
		ПараметрыФормы.Вставить("ДатаОткрытияЗаказНаряда", ДатаОткрытия);
		
		Результат = ОткрытьФормуМодально("Обработка.EDR_АРМПоГарантииNew.Форма.ФормаРазницыЦен", 
		ПараметрыФормы, ЭтаФорма);
		
		Если ЗначениеЗаполнено(Результат) Тогда
			
			Для Каждого Строка из Результат Цикл
				
				Если Строка.ИзменятьЦену Тогда
					
					СтруктураОтбора = Новый Структура;
					СтруктураОтбора.Вставить("Артикул", Строка.Артикул);
					
					СтрокиДляИзмения = ТаблицаТоваров.НайтиСтроки(СтруктураОтбора);
					
					Для Каждого СтрокаДляИзменения из СтрокиДляИзмения Цикл
						
						Если ЗначениеЗаполнено(СтрокаДляИзменения.DiversCode) Тогда
							Продолжить;
							
						КонецЕсли;
							
						СтрокаДляИзменения.Цена = Строка.НоваяЦена;
						СтрокаДляИзменения.СтрокаИзЗаказНаряда = Ложь;
						 
						СтруктураСтроки = Новый Структура("Количество, Цена, СуммаНДС, СуммаВсего, СтавкаНДС, СуммаСкидки");
						
						ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаДляИзменения);
						//  Вариант, когда расчет идет по ставке 20% и от настроек типа цен
						// СтруктураСтроки["СтавкаНДС"] = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
						// Если ЗаказНаряд.ТипЦен.ЦенаВключаетНДС Тогда
						// 		СтруктураСтроки["Цена"] =  СтруктураСтроки["Цена"] * (100 + СтруктураСтроки["СтавкаНДС"].Ставка) / 100;
						// КонецЕсли;
						
						//  Вариант когда, в GM отправляются значения без НДС
						СтруктураСтроки["СтавкаНДС"] = Справочники.СтавкиНДС.БезНДС;

						РассчитатьСтоимостьТоваров(СтруктураСтроки);
						
						ЗаполнитьЗначенияСвойств(СтрокаДляИзменения, СтруктураСтроки);
						
						Модифицированность = Истина;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

