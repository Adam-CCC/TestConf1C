&НаКлиенте
Процедура НастроитьТаблицуСчетов(ТекущаяСтрока)
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Категория) Тогда
		Возврат;
	КонецЕсли; 
	
	мТекущаяСтрокаСчетов = ТаблицаСчетов.НайтиСтроки(Новый Структура("ИдентификаторСчета", ТекущаяСтрока.ИдентификаторСчета));
	
	ТекущаяСтрокаСчетов = мТекущаяСтрокаСчетов[0];
	
	СтруктураПоиска = Новый Структура("Категория", ТекущаяСтрока.Категория);
	СоответствиеКатегорииРасходам = ТаблицаСоответствийКатегорий.НайтиСтроки(СтруктураПоиска);
	
	Если СоответствиеКатегорииРасходам.Количество() = 0 Тогда
		СоответствиеКатегорииРасходам = ДополнитьТаблицуСоответствийКатегорий(ТекущаяСтрока.Категория);
	КонецЕсли; 
	
	
	Если СоответствиеКатегорииРасходам.Количество() = 0 тогда
		
		ТекстСообщения = "Нет данных по доступным видам расходов для данной категории """ + СокрЛП(ТекущаяСтрока.Категория) + """. Проверте корректность введенных данных.";
		
		Предупреждение(ТекстСообщения,15);
		
		Возврат;
		
	КонецЕсли;
	
	Если СоответствиеКатегорииРасходам.Количество() > 1 Тогда 
		
		//Сформируем массив с найденными кодами статей расходов
		МассивРасходов = Новый Массив;
		
		Для каждого элМассива из СоответствиеКатегорииРасходам цикл
			МассивРасходов.Добавить(элМассива.ExpenceCode);
		КонецЦикла;
		
		//теперь ищем по массиву
		Если ЗначениеЗаполнено(ТекущаяСтрока.ВидРасходов) И МассивРасходов.Найти(ТекущаяСтрока.ВидРасходов) = Неопределено тогда //если вернулся индекс элемента тогда все нормально
			
			ТекстСообщения = "Данный вид расходов не предназначен для выбранной категории." + Символы.ПС;
			ТекстСообщения = ТекстСообщения + "Для категории - " + СокрЛП(ТекущаяСтрока.Категория) + " доступны только следующие";
			
			ТекстСообщения = ТекстСообщения + "Виды расходов:" + Символы.ПС;
			
			Для Каждого элМассива из МассивРасходов Цикл
				Если НЕ элМассива = неопределено тогда
					ТекстСообщения = ТекстСообщения + "	Код " + элМассива.Код + "  " + элМассива.Наименование + Символы.ПС;
				КонецЕсли;
			КонецЦикла;
			
			Предупреждение(ТекстСообщения,,"Ошибка ввода данных!");
			
			//Такой комбинации быть не может, очищаем, помечаем красным
			ТекущаяСтрокаСчетов.ВидРасходов = ВидРасходовПустаяСсылка;
			
		КонецЕсли;
		
	ИначеЕсли СоответствиеКатегорииРасходам.Количество() = 1 Тогда 
		
		Если ЗначениеЗаполнено(СоответствиеКатегорииРасходам[0].ExpenceCode) тогда
			
			//ВИД РАСХОДОВ ЕСТЬ НО НЕ СООТВЕТСВУЕТ
			Если ЗначениеЗаполнено(ТекущаяСтрока.ВидРасходов) И СоответствиеКатегорииРасходам[0].ExpenceCode <> ТекущаяСтрока.ВидРасходов тогда 
				
				Предупреждение("Введеный вид расходов не соответствует предопределенному в категории!" + Символы.ПС +
				"Ошибочные данные будут автоматически исправлены.", 15);
				
				ТекущаяСтрокаСчетов.ВидРасходов = СоответствиеКатегорииРасходам.ExpenceCode;
				
			КонецЕсли;
			
		Иначе //Вид расходов не определен
			
			//Вид расходов отсутствует, значит поле не должно заполняться
			Если ЗначениеЗаполнено(ТекущаяСтрока.ВидРасходов) тогда
				
				Предупреждение("Для категории - " + СокрЛП(ТекущаяСтрока.Категория) + " вид расходов не заполняется." + Символы.ПС + 
				"Вид расходов будет очищен.", 15);	
				ТекущаяСтрокаСчетов.ВидРасходов = ВидРасходовПустаяСсылка;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		//Вид расходов отсутствует, значит поле не должно заполняться
		Если ЗначениеЗаполнено(ТекущаяСтрока.ВидРасходов) тогда
			ТекущаяСтрокаСчетов.ВидРасходов = ВидРасходовПустаяСсылка;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьТаблицуПараметровВидовРасходов();
	
КонецПроцедуры // НастроитьТаблицуСчетов()

