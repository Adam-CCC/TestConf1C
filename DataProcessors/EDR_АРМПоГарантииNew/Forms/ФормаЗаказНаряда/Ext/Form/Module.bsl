////#КонецОбласти

////#Область ОбработчикиСобытийТаблицыФормыТаблицаСоответствий

&НаКлиенте
Процедура ТаблицаСоответствийПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.ТаблицаСоответствий.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.Удален = Не ТекущаяСтрока.Удален;
	Модифицированность = Истина;
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	НоваяСтрока = ТаблицаСоответствий.Добавить();
	НоваяСтрока.Идентификатор = Строка(Новый УникальныйИдентификатор());
	НоваяСтрока.ЗаказНаряд    = ЗаказНаряд;
	
	ОбновитьТаблицуПараметровВидовРасходов();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ОбновитьТаблицуПараметровВидовРасходов();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийВидРасходовПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаСоответствий.ТекущиеДанные;
	
	Если ТекущаяСтрока.ВидРасходов <> ПредопределенноеЗначение("Справочник.EDR_ВидыРасходов.Ex57")
		И ТекущаяСтрока.Процент <> 100 Тогда
		
		ТекущаяСтрока.Процент = 100;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийСчетПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаСоответствий.ТекущиеДанные;
	
	СтруктураПоиска = Новый Структура("ЗаказНаряд,Счет", ЗаказНаряд, ТекущаяСтрока.Счет);
		
	НайденныеСчета = ТаблицаСчетов.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСчета.Количество() = 0 Тогда
		ТекущаяСтрока.ЗаказНаряд = ЗаказНаряд;
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, НайденныеСчета[0]);
	
	Если ТекущаяСтрока.ВидРасходов <> ПредопределенноеЗначение("Справочник.EDR_ВидыРасходов.Ex57")
		И ТекущаяСтрока.Процент <> 100 Тогда 
		
		ТекущаяСтрока.Процент = 100;
		
	КонецЕсли;
	
КонецПроцедуры

