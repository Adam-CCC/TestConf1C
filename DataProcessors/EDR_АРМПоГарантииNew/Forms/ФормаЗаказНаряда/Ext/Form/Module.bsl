&НаКлиенте
Процедура ТаблицаИнцидентовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	//сразу отказываемся от добавления строки "стандартным способом"
	Отказ = Истина;
	
	НоваяСтрока = ТаблицаИнцидентов.Добавить();
	НоваяСтрока.Инцидент   = ПолучитьСледующийНомерИнцидента();
	НоваяСтрока.ЗаказНаряд = ЗаказНаряд;
	
	НоваяСтрока.ИдентификаторИнцидента = Строка(Новый УникальныйИдентификатор());
	
	ЗаполнитьСлужебныеРеквизитыТаблицыИнциденты();
	
	//Обновляем список выбора
	//
	ОбновитьСпискиВыбораИнцидентов();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнцидентовПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.ТаблицаИнцидентов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекущаяСтрока.Удален тогда
		
		Успешно = Ложь;
		
		СтруктураПоиска = Новый Структура("ЗаказНаряд, Удален", ЗаказНаряд, Ложь);
		
		СтрокиИнцидентов = ТаблицаИнцидентов.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиИнцидентов.Количество() = 1 тогда 
			
			Предупреждение("У заказ-наряда " + ЗаказНаряд.Номер + " только один действующий инцидент. Удаление не возможно.", 5);
			Отказ = Истина;
			Возврат;
			
		ИначеЕсли СтрокиИнцидентов.Количество() = 0 тогда 
			
			Предупреждение("У заказ-наряда " + ЗаказНаряд.Номер + " нет действующих инцидентов. Удаление не возможно.", 5);
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
		СтруктураИспользованияИнцидента = ПроверитьИспользованиеИнцидента(ТекущаяСтрока.ИдентификаторИнцидента);
		
		Если СтруктураИспользованияИнцидента["ЕстьИспользование"]= истина тогда
			ВыбратьДругойИнцидент(СтруктураИспользованияИнцидента, ТекущаяСтрока.ИдентификаторИнцидента, Успешно);
		Иначе //Использования еще нет
			Успешно = Истина;
		КонецЕсли;
		
		Если Успешно тогда
			
			ТекущаяСтрока.Удален = Истина;
			
		КонецЕсли;
		
	Иначе
		
		ТекущаяСтрока.Удален = Ложь;
		
	КонецЕсли;
	
	Модифицированность = Истина;
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнцидентовПослеУдаления(Элемент)
	
	ОбновитьСпискиВыбораИнцидентов();
	ЗаполнитьСлужебныеРеквизитыТаблицыИнциденты();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнцидентовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ОбновитьСпискиВыбораИнцидентов();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИнцидентовИнцидентПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаИнцидентов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Инцидент) Тогда
		Возврат;
	КонецЕсли;
	
	//Для начала смотрим, есть ли запись в таблице соответствий
	НайденноеСоответствие = ТаблицаСоответствий.НайтиСтроки(Новый Структура("ИдентификаторИнцидента", ТекущаяСтрока.ИдентификаторИнцидента));
	Если НайденноеСоответствие.Количество() > 0 тогда
			//При вводе новых инцидентов нужно переформировывать таблицу параметров
		ОбновитьТаблицуПараметровВидовРасходов();
	Иначе
		
		Предупреждение("Для инцидента: <" + СокрЛП(ТекущаяСтрока.Инцидент) + ">, не указана привязка к счету.", 15);
	КонецЕсли;
	
КонецПроцедуры

