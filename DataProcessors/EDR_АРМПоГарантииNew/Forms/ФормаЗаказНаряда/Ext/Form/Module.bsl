////#Область ОбработчикиСобытийТаблицыФормыТовары

&НаКлиенте
Процедура ТаблицаТоваровОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.EDR_DiversCode") Тогда
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		НоваяСтрока.DiversCode   		= ВыбранноеЗначение;
		НоваяСтрока.Артикул 	 		= ВыбранноеЗначение.Код;
		НоваяСтрока.Номенклатура 		= ВыбранноеЗначение.Наименование;
		НоваяСтрока.ЗаказНаряд   		= ЗаказНаряд;
		НоваяСтрока.СтавкаНДС 	 		= СтавкаБезНДС;
		НоваяСтрока.ИдентификаторТовара = Строка(Новый УникальныйИдентификатор());
		
		Модифицированность = Истина;
		
		ЗаполнитьСлужебныеРеквизитыТаблицыТовары();
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Номенклатура") Тогда 
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.Цена 		= 0;
		НоваяСтрока.СуммаСкидки = 0;
		НоваяСтрока.СуммаНДС 	= 0;
		НоваяСтрока.СуммаВсего  = 0;
		НоваяСтрока.Количество  = 1;
		
		НоваяСтрока.ЗапретСнятияПричины = Истина;
		НоваяСтрока.ПричинаОбращения 	= Истина;
		НоваяСтрока.НеВключатьВСчет 	= Истина;
		
		НоваяСтрока.Артикул 			= ВыбранноеЗначение.Артикул;
		НоваяСтрока.Номенклатура 		= ВыбранноеЗначение;
		
		//добавляем ссылку на текущий заказ
		НоваяСтрока.ЗаказНаряд			= ЗаказНаряд;
		
		НоваяСтрока.СтавкаНДС 			= СтавкаБезНДС;
		НоваяСтрока.ИдентификаторТовара = Строка(Новый УникальныйИдентификатор());
		
		Модифицированность = Истина;
		
		ЗаполнитьСлужебныеРеквизитыТаблицыТовары();
		
	КонецЕсли;
	Модифицированность = Истина;
	
КонецПроцедуры

