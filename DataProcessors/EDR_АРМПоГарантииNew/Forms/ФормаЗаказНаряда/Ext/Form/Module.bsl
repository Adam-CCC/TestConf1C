&НаКлиенте
Процедура ТаблицаСчетовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	//Оповещение = Новый ОписаниеОповещения("ТаблицаСчетовПередНачаломДобавленияЗавершение",ЭтаФорма);
	
	ТекстВопроса = "Внимание!" + Символы.ПС + "Не рекомендуется использовать несколько заявок в заказ-наряде!" + 
	Символы.ПС + "Продолжить?";
	
	//ПоказатьВопрос(Оповещение,ТекстВопроса,РежимДиалогаВопрос.ДаНет,0);
	
	Результат = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
	ТаблицаСчетовПередНачаломДобавленияЗавершение(Результат, Параметры);
	
КонецПроцедуры
 
&НаКлиенте
Процедура ТаблицаСчетовКатегорияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаСчетов.ТекущиеДанные;
	
	НастроитьТаблицуСчетов(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСчетовВидРасходовПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаСчетов.ТекущиеДанные;
	
	НастроитьТаблицуСчетов(ТекущаяСтрока);
	//Теперь нужно настроить поведение всех таблиц с этим видом расходов
	
	ТекстСообщения = "";
	
	Отказ = ПроверитьГарантийныеСроки(ТекущаяСтрока.ВидРасходов, ТекстСообщения);
	
	Если Отказ тогда
		
		Предупреждение(ТекстСообщения);
		
		ТекущаяСтрока.ВидРасходов = ВидРасходовПустаяСсылка;
		Возврат; //Дальше не продолжаем
		
	КонецЕсли;
	
	НастроитьКолонкуНомерСогласованияИнцидентов();
	
	ЗаполнитьСлужебныеРеквизитыТаблицыИнциденты();
	
	//Нужно обновить таблицу параметров
	ОбновитьТаблицуПараметровВидовРасходов();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСчетовПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.ТаблицаСчетов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекущаяСтрока.Удален тогда
		
		Успешно = Ложь;
		
		СтруктураПоиска = Новый Структура("ЗаказНаряд, Удален", ЗаказНаряд, Ложь);
		
		СтрокиНаУдаление = ТаблицаСчетов.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиНаУдаление.Количество() = 1 тогда 
			Предупреждение("У заказ-наряда " + ЗаказНаряд.Номер + " только один действующий счет. Удаление не возможно.", 5);
			Отказ = Истина;
			Возврат;
			
		ИначеЕсли СтрокиНаУдаление.Количество() = 0 тогда 
			Предупреждение("У заказ-наряда " + ЗаказНаряд.Номер + " нет действующих счетов. Удаление не возможно.", 5);
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
		СтруктураИспользованияСчетов = ПроверитьИспользованиеСчета(ТекущаяСтрока.ИдентификаторСчета);
		
		Если СтруктураИспользованияСчетов["ЕстьИспользование"] = Истина тогда
			ВыбратьДругойСчет(СтруктураИспользованияСчетов,ТекущаяСтрока.ИдентификаторСчета, Успешно);
		ИначеЕсли СтруктураИспользованияСчетов["ЕстьИспользование"] = Ложь тогда
			Успешно = Истина;
		КонецЕсли;
		
		Если Успешно тогда
			ТекущаяСтрока.Удален = Истина;
		КонецЕсли;
	Иначе
		ТекущаяСтрока.Удален = Ложь;
	КонецЕсли;
	
	Отказ = Истина;
	Модифицированность = Истина;
	
КонецПроцедуры

