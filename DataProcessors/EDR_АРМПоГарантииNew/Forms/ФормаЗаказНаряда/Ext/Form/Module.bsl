Функция ПолучитьСледующийНомерСчета() Экспорт
	
	Отбор = Новый Структура("ЗаказНаряд", ЗаказНаряд);
	
	СчетаЗаказа = ТаблицаСчетов.НайтиСтроки(Отбор);
	
	ПаттернСозданныхСчетов = "";
	
	СвободныеЛитералы = Строка(ПаттернЛитераловНомеров);
	
	Для каждого ТекСчет из СчетаЗаказа Цикл
		СвободныеЛитералы = СтрЗаменить(СвободныеЛитералы, Прав(ТекСчет.Счет, 1),"");
	КонецЦикла;
	
	ТекущийЛитерал = Лев(СвободныеЛитералы, 1);
	
	НомерДокумента = "" + EDR_КешируемыеЗначения.ПолучитьНомерДляПечати(ЗаказНаряд) + ТекущийЛитерал;
	
	Возврат НомерДокумента;
	
