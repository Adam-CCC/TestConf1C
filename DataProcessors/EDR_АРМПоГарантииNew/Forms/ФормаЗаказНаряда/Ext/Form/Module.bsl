	|	КОНЕЦ КАК Инцидент,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.Количество
	|		ИНАЧЕ ЗаказНарядРаботы.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_РаботыДоп.Коэффициент = 0
	|							ИЛИ EDR_РаботыДоп.Коэффициент ЕСТЬ NULL 
	|						ТОГДА 1
	|					ИНАЧЕ EDR_РаботыДоп.Коэффициент
	|				КОНЕЦ
	|		ИНАЧЕ ЗаказНарядРаботы.Коэффициент
	|	КОНЕЦ КАК Коэффициент,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СуммаСкидки
	|		ИНАЧЕ ЗаказНарядРаботы.СуммаСкидки
	|	КОНЕЦ КАК СуммаСкидки,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СуммаНДС
	|		ИНАЧЕ ЗаказНарядРаботы.СуммаНДС
	|	КОНЕЦ КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СуммаВсего
	|		ИНАЧЕ ЗаказНарядРаботы.СуммаВсего
	|	КОНЕЦ КАК СуммаВсего,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.Нормочас
	|		ИНАЧЕ ЗаказНарядРаботы.Нормочас
	|	КОНЕЦ КАК Нормочас,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.Сумма
	|		ИНАЧЕ ЗаказНарядРаботы.Сумма
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА EDR_Interventions.Intervention ЕСТЬ NULL 
	|			ТОГДА """"
	|		ИНАЧЕ EDR_РаботыДоп.GUID_Инцидента
	|	КОНЕЦ КАК ИдентификаторИнцидента,
	|	EDR_РаботыДоп.GUID_Работы КАК ИдентификаторРаботы,
	|	EDR_РаботыДоп.ПричинаОбращения,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_РаботыДоп.АртикулНестандартнойОперации = """"
	|						ТОГДА EDR_РаботыДоп.DiversCode.Код
	|					ИНАЧЕ EDR_РаботыДоп.АртикулНестандартнойОперации
	|				КОНЕЦ
	|		ИНАЧЕ ЗаказНарядРаботы.Работа.Артикул
	|	КОНЕЦ КАК Артикул,
	|	EDR_РаботыДоп.РаботаПоЛКМ,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда = ЛОЖЬ
	|			ТОГДА EDR_РаботыДоп.СтавкаНДС
	|		ИНАЧЕ ЗаказНарядРаботы.СтавкаНДС
	|	КОНЕЦ КАК СтавкаНДС,
	|	EDR_РаботыДоп.СтрокаИзЗаказНаряда,
	|	EDR_РаботыДоп.DiversCode,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.АртикулНестандартнойОперации = """"
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК НеСтандартнаяОперация,
	|	ВЫБОР
	|		КОГДА EDR_РаботыДоп.Цена = 0
	|			ТОГДА ВЫБОР
	|					КОГДА EDR_РаботыДоп.СтрокаИзЗаказНаряда
	|						ТОГДА ЗаказНарядРаботы.Цена
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ EDR_РаботыДоп.Цена
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрСведений.EDR_РаботыДоп КАК EDR_РаботыДоп
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Interventions КАК EDR_Interventions
	|		ПО EDR_РаботыДоп.GUID_Инцидента = EDR_Interventions.GUID
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
	|		ПО EDR_РаботыДоп.ЗаказНаряд = ЗаказНарядРаботы.Ссылка
	|			И EDR_РаботыДоп.GUID_Работы = ЗаказНарядРаботы.ИдентификаторРаботы
	|ГДЕ
	|	EDR_РаботыДоп.ЗаказНаряд = &ЗаказНаряд"
	);
	Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРаботы.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры //ЗаполнитьРаботыПоОтбору(ЗаказНаряды)

&НаСервере
Процедура ЗаполнитьФотографииПоОтбору()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрикрепленныеФото.ЗаказНаряд,
	|	ПрикрепленныеФото.UID,
	|	ПрикрепленныеФото.ИмяФайла
	|ИЗ
	|	РегистрСведений.EDR_ПрикрепленныеФото КАК ПрикрепленныеФото
	|ГДЕ
	|	ПрикрепленныеФото.ЗаказНаряд = &ЗаказНаряд";
	
	Запрос.УстановитьПараметр("ЗаказНаряд", ЗаказНаряд);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаФотографий.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры // ЗаполнитьФотографииПоОтбору()

&НаСервере
Функция ОбновитьТаблицуПараметровВидовРасходов() Экспорт
	
	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	//Счета в МВТ
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСчетов.ЗаказНаряд,
	|	ТаблицаСчетов.ИдентификаторСчета,
	|	ТаблицаСчетов.ВидРасходов
	|ПОМЕСТИТЬ ТаблицаСчетов
	|ИЗ
	|	&ТаблицаСчетов КАК ТаблицаСчетов"
	;
	Запрос.УстановитьПараметр("ТаблицаСчетов", ТаблицаСчетов.Выгрузить());
	Запрос.Выполнить();
	
	//Соответствия в МВТ
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСоответствий.ЗаказНаряд,
	|	ТаблицаСоответствий.ИдентификаторСчета,
	|	ТаблицаСоответствий.ИдентификаторИнцидента
	|ПОМЕСТИТЬ ТаблицаСоответствий
	|ИЗ
	|	&ТаблицаСоответствий КАК ТаблицаСоответствий"
	;
	Запрос.УстановитьПараметр("ТаблицаСоответствий", ТаблицаСоответствий.Выгрузить());
	Запрос.Выполнить();
	
	//В запросе заглушены проверки Control_Comm#
	//по требованию гарантийного департамента
	//Для всех видов расходов, кроме 91 OTS, комментарий обязателен!
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСчетов.ЗаказНаряд КАК ИдентификаторЗаказа,
	|	ТаблицаСчетов.ИдентификаторСчета,
	|	ТаблицаСоответствий.ИдентификаторИнцидента,
	|	ТаблицаСчетов.ВидРасходов,
	|	ТаблицаСчетов.ВидРасходов.Type КАК Type,
	|	ТаблицаСчетов.ВидРасходов.MinAgeDay КАК MinAgeDay,
	|	ТаблицаСчетов.ВидРасходов.MaxAgeDay КАК MaxAgeDay,
	|	ТаблицаСчетов.ВидРасходов.Control_TAPV КАК Control_TAPV,
	|	ТаблицаСчетов.ВидРасходов.Control_NewV КАК Control_NewV,
	|	ТаблицаСчетов.ВидРасходов.Control_EC КАК Control_EC,
	|	ТаблицаСчетов.ВидРасходов.Control_Part КАК Control_Part,
	|	ТаблицаСчетов.ВидРасходов.Control_MD КАК Control_MD,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Control_Comm1,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Control_Comm2,
	|	ВЫБОР
	|		КОГДА ТаблицаСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex91)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Control_Comm3,
	|	ТаблицаСчетов.ВидРасходов.Control_Indicator КАК Control_Indicator,
	|	ТаблицаСчетов.ВидРасходов.Control_DiverPart КАК Control_DiverPart,
	|	ТаблицаСчетов.ВидРасходов.Control_DiverOper КАК Control_DiverOper,
	|	ТаблицаСчетов.ВидРасходов.Control_CustomerReq КАК Control_CustomerReq
	|ИЗ
	|	ТаблицаСчетов КАК ТаблицаСчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаСоответствий КАК ТаблицаСоответствий
	|		ПО ТаблицаСчетов.ЗаказНаряд = ТаблицаСоответствий.ЗаказНаряд
	|			И ТаблицаСчетов.ИдентификаторСчета = ТаблицаСоответствий.ИдентификаторСчета
	|ГДЕ
	|	ТаблицаСчетов.ВидРасходов <> ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаСоответствий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаСчетов";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
	//Уничтожаем менеджер
	МВТ = Неопределено;
	//
КонецФункции // ОбновитьТаблицуПараметровВидовРасходов()

