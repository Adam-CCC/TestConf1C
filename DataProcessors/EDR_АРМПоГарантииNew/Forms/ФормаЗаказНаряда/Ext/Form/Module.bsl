&НаСервере
Функция ПроверитьИспользованиеИнцидента(ИдентификаторИнцидента) Экспорт
	
	СтруктураРезультата = Новый Структура;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	//Таблицы в Менеджер
	//Товары
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаТоваров",ТаблицаТоваров.Выгрузить());
	Запрос.Выполнить();
	
	//Работы
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТРаботы
	|ИЗ
	|	&ТаблицаРабот КАК ТаблицаРабот";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаРабот",ТаблицаРаботы.Выгрузить());
	Запрос.Выполнить();

	//Соответствия
	ТекстЗапроса = "ВЫБРАТЬ * ПОМЕСТИТЬ ВТСоответствия
	|ИЗ
	|	&ТаблицаСоответствий КАК ТаблицаСоответствий";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаСоответствий",ТаблицаСоответствий.Выгрузить());
	Запрос.Выполнить();
	
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТТовары.ИдентификаторТовара,
	|	ВТТовары.Номенклатура,
	|	ВТТовары.ИдентификаторИнцидента
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|ГДЕ
	|	ВТТовары.ИдентификаторИнцидента = &ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТТовары";
	
	Запрос.УстановитьПараметр("ИдентификаторИнцидента",ИдентификаторИнцидента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаТовары = РезультатЗапроса.Выбрать();
	
	МассивТоваров = Новый Массив;
	
	Пока ВыборкаТовары.Следующий() Цикл
		МассивТоваров.Добавить(ВыборкаТовары.ИдентификаторТовара);	
	КонецЦикла; 
	
	СтруктураРезультата.Вставить("Товары",МассивТоваров);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТРаботы.ИдентификаторРаботы,
	|	ВТРаботы.Работа,
	|	ВТРаботы.ИдентификаторИнцидента
	|ИЗ
	|	ВТРаботы КАК ВТРаботы
	|ГДЕ
	|	ВТРаботы.ИдентификаторИнцидента = &ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТРаботы";
	Запрос.УстановитьПараметр("ИдентификаторИнцидента",ИдентификаторИнцидента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРабот = РезультатЗапроса.Выбрать();
	
	МассивРабот = Новый Массив;
	
	Пока ВыборкаРабот.Следующий() Цикл
		МассивРабот.Добавить(ВыборкаРабот.ИдентификаторРаботы);	
	КонецЦикла; 
		
	СтруктураРезультата.Вставить("Работы",МассивРабот);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВТСоответствия.Идентификатор,
	|	ВТСоответствия.ИдентификаторИнцидента
	|ИЗ
	|	ВТСоответствия КАК ВТСоответствия
	|ГДЕ
	|	ВТСоответствия.ИдентификаторИнцидента = &ИдентификаторИнцидента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТСоответствия";
	Запрос.УстановитьПараметр("ИдентификаторИнцидента",ИдентификаторИнцидента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИнцидентов = РезультатЗапроса.Выбрать();
	
	МассивИнцидентов = Новый Массив;
	
	Пока ВыборкаИнцидентов.Следующий() Цикл
		МассивИнцидентов.Добавить(ВыборкаИнцидентов.Идентификатор);	
	КонецЦикла; 
	
	СтруктураРезультата.Вставить("Соответствия",МассивИнцидентов);
	
	Если МассивТоваров.Количество() > 0 
	 или МассивРабот.Количество() > 0 
	 или МассивИнцидентов.Количество() > 0 тогда
		СтруктураРезультата.Вставить("ЕстьИспользование", Истина);
	Иначе
		СтруктураРезультата.Вставить("ЕстьИспользование", Ложь);
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыТаблицыИнциденты()

	Для каждого ТекущаяСтрока Из ТаблицаИнцидентов Цикл
		
		//Отрабатываем логику доступа из параметров ExpenceCode
		ТекущаяСтрока.Control_EC = ПолучитьПараметр_Булево_ExpenceCode(ЗаказНаряд,,ТекущаяСтрока.ИдентификаторИнцидента,"Control_EC");
		
		//Если Не ТекущаяСтрока.Control_EC Тогда
		//	ТекущаяСтрока.КодОщущенияКлиента = Неопределено;
		//КонецЕсли; 
		
		НайденныеСтрокиСоответствия = ТаблицаСоответствий.НайтиСтроки(Новый Структура("ИдентификаторИнцидента,Type",ТекущаяСтрока.ИдентификаторИнцидента,"Parts")); 
		
		ТекущаяСтрока.ЕстьСоответствие = (ТаблицаСоответствий.НайтиСтроки(Новый Структура("ИдентификаторИнцидента",ТекущаяСтрока.ИдентификаторИнцидента)).Количество() > 0);
		
		ТекущаяСтрока.Type = ?(НайденныеСтрокиСоответствия.Количество()>0,"Parts","");
		
		ТекущаяСтрока.НомерСогласованияОбязателен = НастроитьДоступКолонкеНомерСогласованияИнцидентов(ТекущаяСтрока.ИдентификаторИнцидента);
		
		//ТекущаяСтрока.НомерСогласования = "";
		
	КонецЦикла; 	

КонецПроцедуры // ЗаполнитьСлужебныеРеквизитыТаблицыИнциденты()

&НаСервере
Функция НастроитьДоступКолонкеНомерСогласованияИнцидентов(ТекущийИнцидент)
	
	ОтображатьКолонку = Элементы.ТаблицаИнцидентовНомерСогласования.Видимость;
	
	//Колонка видна, значит ищем счет по номеру инцидента
	Если ОтображатьКолонку тогда
				
		//Смотрим повторная отправка или нет
		Если ПовторнаяОтправка тогда
			
			Возврат Истина; //Продолжать проверку далее нет смысла.
			
		КонецЕсли;
		
		//Теперь смотрим на сколько запаздывает начало заказ наряда от текущей даты
		//если запоздание более или равно 30 дней - нужно обязательно заполнять поле
		ДатаНачала    = НачалоДня(ЗаказНаряд.ДатаСоздания);
		ДнейПросрочки = Число(?(ТекущаяДата() - ДатаНачала = 0,1, ТекущаяДата() - ДатаНачала))/60/60/24;
	
		Если Окр(ДнейПросрочки) >= 30 тогда
			Возврат Истина
		КонецЕсли;
		
		//Если все еще тут, значит проверяем по ExCode
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ТабСоответствий.ИдентификаторИнцидента,
		|	ТабСоответствий.ИдентификаторСчета,
		|	ТабСоответствий.ЗаказНаряд,
		|	ТабСоответствий.Инцидент,
		|	ТабСоответствий.Счет
		|ПОМЕСТИТЬ ТабСоответствий
		|ИЗ
		|	&ТабСоответствий КАК ТабСоответствий
		|ГДЕ
		|	ТабСоответствий.ЗаказНаряд = &ЗаказНаряд
		|	И ТабСоответствий.ИдентификаторИнцидента = &ИдентификаторИнцидента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабСчета.ЗаказНаряд,
		|	ТабСчета.ВидРасходов,
		|	ТабСчета.ИдентификаторСчета,
		|	ТабСчета.Счет
		|ПОМЕСТИТЬ ТабСчетов
		|ИЗ
		|	&ТабСчета КАК ТабСчета
		|ГДЕ
		|	ТабСчета.ЗаказНаряд = &ЗаказНаряд
		|	И ТабСчета.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex57)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ТабСчетов.ВидРасходов = ЗНАЧЕНИЕ(Справочник.EDR_ВидыРасходов.Ex57)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьКод57
		|ИЗ
		|	ТабСоответствий КАК ТабСоответствий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабСчетов КАК ТабСчетов
		|		ПО ТабСоответствий.ИдентификаторСчета = ТабСчетов.ИдентификаторСчета
		|			И ТабСоответствий.ЗаказНаряд = ТабСчетов.ЗаказНаряд
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ТабСчетов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ТабСоответствий"
		);
		
		Запрос.УстановитьПараметр("ТабСоответствий", ТаблицаСоответствий.Выгрузить());
		Запрос.УстановитьПараметр("ТабСчета", 		 ТаблицаСчетов.Выгрузить());
		
		Запрос.УстановитьПараметр("ЗаказНаряд", 			ЗаказНаряд);
		Запрос.УстановитьПараметр("ИдентификаторИнцидента", ТекущийИнцидент);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() и Результат.ЕстьКод57 тогда
			
			Возврат Истина
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ложь;
	
КонецФункции

