&НаСервере
Процедура ЗаписьИзмененийПоСоответствиям()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСоответствия",ТаблицаСоответствий.Выгрузить());
	Запрос.Текст =                 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСоответствия.ЗаказНаряд КАК ЗаказНаряд,
		|	ТаблицаСоответствия.ИдентификаторСчета КАК Invoice,
		|	ТаблицаСоответствия.ИдентификаторИнцидента КАК intervention,
		|	ТаблицаСоответствия.Счет КАК Счет,
		|	ТаблицаСоответствия.Категория КАК Категория,
		|	ТаблицаСоответствия.ВидРасходов КАК ВидРасходов,
		|	ТаблицаСоответствия.Инцидент КАК Инцидент,
		|	ТаблицаСоответствия.Процент КАК Процент,
		|	ТаблицаСоответствия.Идентификатор КАК GUID,
		|	ТаблицаСоответствия.Удален
		|ПОМЕСТИТЬ мТаблицаСоответствия
		|ИЗ
		|	&ТаблицаСоответствия КАК ТаблицаСоответствия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	мТаблицаСоответствия.ЗаказНаряд,
		|	мТаблицаСоответствия.Invoice,
		|	мТаблицаСоответствия.intervention,
		|	мТаблицаСоответствия.Счет,
		|	мТаблицаСоответствия.Категория,
		|	мТаблицаСоответствия.ВидРасходов,
		|	мТаблицаСоответствия.Инцидент,
		|	мТаблицаСоответствия.Процент,
		|	мТаблицаСоответствия.GUID
		|ИЗ
		|	мТаблицаСоответствия КАК мТаблицаСоответствия
		|ГДЕ
		|	НЕ мТаблицаСоответствия.Удален
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	мТаблицаСоответствия.ЗаказНаряд,
		|	мТаблицаСоответствия.GUID
		|ИЗ
		|	мТаблицаСоответствия КАК мТаблицаСоответствия
		|ГДЕ
		|	мТаблицаСоответствия.Удален";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаЗаписи = РезультатЗапроса[1].Выбрать();
	
	Пока ВыборкаЗаписи.Следующий() Цикл
		
		СтруктураПараметров = Новый Структура;
		
		Для каждого ТекущаяКолонка Из РезультатЗапроса[1].Колонки  Цикл		
			СтруктураПараметров.Вставить(ТекущаяКолонка.Имя,ВыборкаЗаписи[ТекущаяКолонка.Имя]);	
		КонецЦикла; 
		
		РегистрыСведений.EDR_СоответствияИнвойсов.ОбновитьСоответствие(СтруктураПараметров);
		
	КонецЦикла; 
	
	ВыборкаУдаленияСтрок = РезультатЗапроса[2].Выбрать();
	
	Пока ВыборкаУдаленияСтрок.Следующий() Цикл
		РегистрыСведений.EDR_СоответствияИнвойсов.УдалитьСоответствие(ВыборкаУдаленияСтрок.GUID);
	КонецЦикла; 
	
КонецПроцедуры // ЗаписьИзмененийПоСоответствиям()

