&НаКлиенте
Процедура ТаблицаРаботыАртикулПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРаботы.ТекущиеДанные;
	
	Если ТекущаяСтрока.Артикул = "1777"
		Или ТекущаяСтрока.Артикул = "1888"
		Или ТекущаяСтрока.Артикул = "1999"
		Или ТекущаяСтрока.Артикул = "8888"
		Или ТекущаяСтрока.Артикул = "9499" Тогда
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.Работа) Тогда
			
			ТекущаяСтрока.Работа = "<Операция не закодирована>";
			
		КонецЕсли;
		
		Если ТекущаяСтрока.Артикул = "1999"
			Или ТекущаяСтрока.Артикул = "9499" Тогда
			ТекущаяСтрока.РаботаПоЛКМ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

