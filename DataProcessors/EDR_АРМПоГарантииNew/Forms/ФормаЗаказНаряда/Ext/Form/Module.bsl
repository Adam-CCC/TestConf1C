&НаКлиенте
Процедура ТаблицаИнцидентовИКомментарииПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаИнцидентовИКомментарии.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Комментарий1 = ПолучитьПараметр_Булево_ExpenceCode(ЗаказНаряд, неопределено, ТекущаяСтрока.ИдентификаторИнцидента, "Control_Comm1");
	Комментарий2 = ПолучитьПараметр_Булево_ExpenceCode(ЗаказНаряд, неопределено, ТекущаяСтрока.ИдентификаторИнцидента, "Control_Comm2");
	Комментарий3 = ПолучитьПараметр_Булево_ExpenceCode(ЗаказНаряд, неопределено, ТекущаяСтрока.ИдентификаторИнцидента, "Control_Comm3");
	
	Если Комментарий1 
		или Комментарий2
		или Комментарий3 тогда
		
		Элементы.КомментарийОперации.АвтоОтметкаНезаполненного = Истина;
		Элементы.КомментарийОперации.АвтоВыборНезаполненного   = Истина;
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.КомментарийОперации) тогда
			
			Элементы.КомментарийОперации.ЦветФона = Новый Цвет(255,0,0);
			
		Иначе
			
			Элементы.КомментарийОперации.ЦветФона = Новый Цвет(255,255,255);
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ОписаниеЖалобы) тогда
			
			Элементы.ОписаниеЖалобы.ЦветФона = Новый Цвет(255,0,0);
			
		Иначе
			
			Элементы.ОписаниеЖалобы.ЦветФона = Новый Цвет(255,255,255);
			
		КонецЕсли;
		
	Иначе
		
		Элементы.КомментарийОперации.АвтоОтметкаНезаполненного = Ложь;
		Элементы.КомментарийОперации.АвтоВыборНезаполненного = Ложь;
		
	КонецЕсли;
	
	ЖалобаКлиента = ПолучитьПараметр_Булево_ExpenceCode(ЗаказНаряд, неопределено, ТекущаяСтрока.ИдентификаторИнцидента,"Control_CustomerReq");
	
	Если ЖалобаКлиента тогда
		
		Элементы.ОписаниеЖалобы.АвтоОтметкаНезаполненного = Истина;
		Элементы.ОписаниеЖалобы.АвтоВыборНезаполненного = Истина;
		
	Иначе
		
		Элементы.ОписаниеЖалобы.АвтоОтметкаНезаполненного = Ложь;
		Элементы.ОписаниеЖалобы.АвтоВыборНезаполненного = Ложь;
		
	КонецЕсли;

	ОбновитьЗаголовкиКомментариевОбращения(Истина);
	
КонецПроцедуры

