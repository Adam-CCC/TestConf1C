&НаКлиенте
Процедура СохранитьИзменения(Команда, Отказ = Ложь, Закрытие = Ложь)
	
	//Отказ = Ложь;
	//
	//ПроверитьЗаполнениеОтзывнойНоты(Отказ);
	//
	//Если Отказ Тогда
	//	Возврат;
	//КонецЕсли;
	
	Отказ = Ложь;
	
	ПроверитьЗаполнениеНоменклатуры(Отказ);
	ПроверитьЗаполнениеАвтоработы(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		УдалитьНедопустимыеСимволыВКомментарих();
	КонецЕсли;
	
	ЗаполнитьВТабличныхЧастяхЗаказНаряд();
	
	//ИнициализироватьОбмен();
	
	ТаблицаОшибок.Очистить();
	ТаблицаОшибокРаботыТовары.Очистить();
	
	Если Не Модифицированность Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Если ЛКМ Тогда
		
		Успешно = РассчетЛКМ(ТекстОшибки);
		
		Если Не Успешно Тогда
			Отказ = Истина;
			Предупреждение(ТекстОшибки, 20);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Отказ = Ложь;
	
	Успешно = ПроверитьНаКорректность(,Отказ);
	
	Если Не Успешно Тогда
		
		Отказ = Истина;
		
		Если ТаблицаОшибок.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		#Если ТолстыйКлиентУправляемоеПриложение ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда
			
			ВывестиОшибкиСКД();
			
			ПараметрыФормы = Новый Структура("ТабличныйДокумент",ТабличныйДокумент);
			ОткрытьФорму("Обработка.EDR_АРМПоГарантииNew.Форма.ФормаОтчет",ПараметрыФормы,ЭтаФорма);
			
		#Иначе
			
			ТекстОшибки = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='По заказ-наряду:"
"""%1"""
"Запись изменений прервана по причине:';en='According to the order, as well as:"
"""%1"""
"Record changes canceled due to:'"),
				"№ "+СокрЛП(ЗаказНаряд.Номер) + " от " + Формат(ЗаказНаряд.Дата,"ДФ=dd.MM.yyyy; ДП=-"));
			
			Для каждого ТекущаяСтрокаОшибки Из ТаблицаОшибок Цикл
				ТекстОшибки = ТекстОшибки + Символы.ПС + СокрЛП(ТекущаяСтрокаОшибки.ОписаниеОшибки) + ";";
			КонецЦикла;
			
			ТекстОшибки = Лев(ТекстОшибки, СтрДлина(ТекстОшибки) - 1);
			Сообщить(ТекстОшибки, 20);
			
		#КонецЕсли
		
		Возврат;
		
	КонецЕсли;
	
	Успешно = ЗаписатьИнформациюВРегистры();
	
	Если Не Успешно Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗаписатьУдалитьИзображенияЗаказНаряда();
	Исключение
		Предупреждение(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Модифицированность = Ложь;
	
	ИнициализироватьОбмен();
	
	Если Не Закрытие Тогда
		ОповеститьОВыборе("ОбновитьСписок");
	КонецЕсли;
	
КонецПроцедуры

