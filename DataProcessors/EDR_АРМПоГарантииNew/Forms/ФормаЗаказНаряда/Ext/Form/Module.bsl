Процедура ТаблицаРаботыИнцидентПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаРаботы.ТекущиеДанные;
	
	СтруктураПоиска = Новый Структура("ЗаказНаряд, Инцидент", ЗаказНаряд, ТекущаяСтрока.Инцидент);
	
	НайденныеСтроки = ТаблицаИнцидентов.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаИнцидента = НайденныеСтроки[0];
	
	ИдентификаторИнцидента = СтрокаИнцидента.ИдентификаторИнцидента;
	
	Если Не ТекущаяСтрока.СтрокаИзЗаказНаряда Тогда
		
		//Это Diverse code. Нужно проверить право на использование инцидента
		DiversCodeLabor = ПолучитьПараметр_Булево_ExpenceCode(Неопределено, Неопределено, ИдентификаторИнцидента, "Control_DiverOper");
		
		Если НЕ DiversCodeLabor тогда //Использовать Diverse code нельзя
			
			Предупреждение("У выбранного инцидента использование для работ ""Diverse code"" запрещено.");
			ТекущаяСтрока.Инцидент = "-";
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущаяСтрока.ИдентификаторИнцидента = ИдентификаторИнцидента;
	
	ЗаполнитьСлужебныеРеквизитыТаблицыРаботы();
	
