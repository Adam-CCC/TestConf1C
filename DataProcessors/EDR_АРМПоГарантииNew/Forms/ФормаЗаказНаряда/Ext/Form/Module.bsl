&НаКлиенте
Процедура ТаблицаФотографийПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.ТаблицаФотографий.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.Удалить 	  = Не ТекущаяСтрока.Удалить;
	ТекущаяСтрока.НоваяСтрока = Ложь;
	
	Отказ = Истина;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФотографийПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаФотографий.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураПоиска = Новый Структура("ЗаказНаряд, UID, ИмяФайла");
	ЗаполнитьЗначенияСвойств(СтруктураПоиска,ТекущаяСтрока);
	
	ХранилищеКартинки = ПолучитьДвоичныеДанныеИзображения(СтруктураПоиска);
	
	Если ХранилищеКартинки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ПолноеНаименование) Тогда
		ДвоичныеДанныеИзображение = Новый ДвоичныеДанные(СокрЛП(ТекущаяСтрока.ПолноеНаименование));
	Иначе 
		
		ИмяОткрываемогоФайла = КаталогВременныхФайлов() + ТекущаяСтрока.ИмяФайла;
		
		СтруктураПоиска = Новый Структура("ЗаказНаряд, UID, ИмяФайла");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТекущаяСтрока);
		
		ХранилищеКартинки = ПолучитьДвоичныеДанныеИзображения(СтруктураПоиска);
		
		Если ХранилищеКартинки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ФайлКартинки = ХранилищеКартинки.Получить();
		
		Попытка
			ФайлКартинки.Записать(ИмяОткрываемогоФайла);
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Предупреждение( Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='При записи временного файла изображения"
"""%1"""
"произошла ошибка:"
"""%2"".';en='When recording the temporary image file"
"""%1"""
"An error has occurred:"
"""% 2"".'"),
			ИмяОткрываемогоФайла,
			ИнформацияОбОшибке.Описание));
			
			Возврат;
			
		КонецПопытки;
		
		ТекущаяСтрока.ПолноеНаименование = ИмяОткрываемогоФайла;
		
		ДвоичныеДанныеИзображение = Новый ДвоичныеДанные(СокрЛП(ТекущаяСтрока.ПолноеНаименование));
		
	КонецЕсли; 
	
	АдресКартинки = ПоместитьВоВременноеХранилище(ДвоичныеДанныеИзображение);
	
КонецПроцедуры

