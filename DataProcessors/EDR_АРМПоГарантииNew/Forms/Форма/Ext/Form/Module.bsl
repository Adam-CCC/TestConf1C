
////#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийПользователь = ПараметрыСеанса.Пользователь;
	ОрганизацияОтбор    = ПараметрыСеанса.Организация;
	
	Период.Вариант = ВариантСтандартногоПериода.ЭтаНеделя;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтказатьВОткрытии()
	
	Предупреждение("У вас нет прав на открытие АРМ"); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ Renault_РаботаСПравамиПользователя.ЕстьПравоНаОткрытиеАРМГарантия(ПараметрыСеанса.Пользователь) тогда
		//обПраво("РазрешитьРаботуСАРММенеджера", ЭтаФорма.ЭтотОбъект.Права) Тогда		
		ОтказатьВОткрытии();
		
		Отказ = Истина;
		Возврат;		
	КонецЕсли;
	
	ЗаполнитьПараметрыДинамическогоСписка();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ВыбранноеЗначение = "ОбновитьСписок" Тогда
		Элементы.СписокЗаказов.Обновить();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСписок"
		И Параметр = ПараметрыСеанса.Пользователь Тогда
		Элементы.СписокЗаказов.Обновить();
	КонецЕсли; 
	
КонецПроцедуры

////#КонецОбласти

////#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ЗаполнитьПараметрыДинамическогоСписка();	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОтборПриИзменении(Элемент)
	ЗаполнитьПараметрыДинамическогоСписка();	
КонецПроцедуры

////#КонецОбласти

////#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьЗаказНаряд(Команда)
	
	ТекущаяСтрока = Элементы.СписокЗаказов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура("ЗаказНаряд,СемействоАвтомобиля,ГотовностьКОтправке,ЛКМ,OTS,ПовторнаяОтправка,Отправлен,ПробегАвтомобиля,ДатаОткрытия,РангАвторабот,ДатаЗакрытия,Автомобиль");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы,ТекущаяСтрока);
	
	ОткрытьФорму("Обработка.EDR_АРМПоГарантииNew.Форма.ФормаЗаказНаряда",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузку(Команда)
	ВыполнитьВыгрузкуНаСервере();	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьГрафическоеПредставление(Команда)
	
	ПолучитьДеревоЗаказНарядовДляОтправки(ПолучитьМассивЗаказов());
	
	ТекКлюч = Строка(Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy"));
	
	ФормаПечати = ПолучитьФорму("ОбщаяФорма.ПечатнаяФормаДокументов",,ЭтаФорма);
	
	ФормаПечати.ОбъектПредставление = "Структура распределения счетов и инцидентов по Заказ-Нарядам";
	ФормаПечати.ЭлементыФормы.ТабличныйДокумент.Вывести(ТабличныйДокумент);
	ФормаПечати.Открыть();
	
КонецПроцедуры

////#КонецОбласти

////#Область ОбработчикиСобытийЭлементовДинамическогоСпискаФормыСписокЗаказов

&НаКлиенте
Процедура СписокЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура("ЗаказНаряд,СемействоАвтомобиля,ГотовностьКОтправке,ЛКМ,OTS,ПовторнаяОтправка,Отправлен,ПробегАвтомобиля,ДатаОткрытия,РангАвторабот,ДатаЗакрытия,Автомобиль");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы,ТекущаяСтрока);
	
	ОткрытьФорму("Обработка.EDR_АРМПоГарантииNew.Форма.ФормаЗаказНаряда",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры

