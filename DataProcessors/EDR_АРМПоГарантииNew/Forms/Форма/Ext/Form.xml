			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	EDR_ЗаказНаряды.ЗаказНаряд КАК ЗаказНаряд,
	EDR_ЗаказНаряды.ОтправленВСистему_GCM КАК Отправлен,
	EDR_ЗаказНаряды.OTS,
	EDR_ЗаказНаряды.ДатаОткрытия КАК ДатаОткрытия,
	EDR_ЗаказНаряды.ДатаЗакрытия КАК ДатаЗакрытия,
	EDR_ЗаказНаряды.ЗаказНаряд.Автомобиль КАК Автомобиль,
	EDR_ЗаказНаряды.СемействоАвтомобиля КАК СемействоАвтомобиля,
	EDR_ЗаказНаряды.ПробегАвтомобиля,
	EDR_ЗаказНаряды.РангАвторабот,
	EDR_ЗаказНаряды.ЗаказНаряд.СуммаДокумента КАК СуммаДокумента,
	EDR_ЗаказНаряды.ГотовностьКОтправке,
	EDR_ЗаказНаряды.ПовторнаяОтправка,
	Renault_ВидыРемонтаДопРеквизиты.EDR_ЛКМ КАК ЛКМ,
	EDR_Invoices.Invoice КАК Счет
ИЗ
	РегистрСведений.EDR_ЗаказНаряды КАК EDR_ЗаказНаряды
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ВидыРемонтаДопРеквизиты КАК Renault_ВидыРемонтаДопРеквизиты
		ПО EDR_ЗаказНаряды.ЗаказНаряд.ВидРемонта = Renault_ВидыРемонтаДопРеквизиты.ВидРемонта
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.EDR_Invoices КАК EDR_Invoices
		ПО EDR_ЗаказНаряды.ЗаказНаряд = EDR_Invoices.ЗаказНаряд
ГДЕ
	EDR_ЗаказНаряды.ЗаказНаряд.Организация В(&amp;Организация)
	И EDR_ЗаказНаряды.ДатаЗакрытия МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И EDR_ЗаказНаряды.Гарантия</QueryText>
