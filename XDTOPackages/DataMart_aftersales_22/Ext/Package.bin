	<objectType name="address">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="zipCode" type="d3p1:String100" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="region" type="d3p1:String100" lowerBound="0"/>
