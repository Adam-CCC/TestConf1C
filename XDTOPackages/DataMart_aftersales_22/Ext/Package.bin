		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="work" type="d3p1:work_body" lowerBound="0" upperBound="-1"/>
	</objectType>
	<objectType name="work_body">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="code" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="payment" type="d3p1:PaymentCode"/>
