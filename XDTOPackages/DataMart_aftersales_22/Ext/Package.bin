		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="code" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="opercode" type="d3p1:OPERCODE" lowerBound="0"/>
