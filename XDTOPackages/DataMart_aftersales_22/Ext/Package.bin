<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://gate.renault.ru/dataMart-aftersales" elementFormQualified="true" attributeFormQualified="false">
	<property name="aftersales">
		<typeDef xsi:type="ObjectType" ordered="false" sequenced="true">
			<property name="ver" lowerBound="1" form="Attribute">
				<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
					<pattern>[0-9]{1,2}\.[0-9]{1,2}</pattern>
				</typeDef>
			</property>
			<property name="bir" lowerBound="1" form="Attribute">
				<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
					<pattern>[0-9]{8}</pattern>
				</typeDef>
			</property>
			<property name="site" lowerBound="1" form="Attribute">
				<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
					<pattern>[0-9]{8}-[0-9]{3}</pattern>
				</typeDef>
			</property>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-aftersales" name="order" type="d4p1:Order" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-aftersales" name="bodyshop" type="d4p1:Bodyshop" lowerBound="0" upperBound="-1" nillable="true"/>
		</typeDef>
	</property>
	<valueType name="AUDATEX" base="xs:string" variety="Atomic" maxLength="12"/>
	<valueType name="Email" base="xs:string" variety="Atomic">
		<pattern>[^@]+@[^\.]+\..+|null</pattern>
	</valueType>
	<valueType name="GCM" base="xs:string" variety="Atomic" length="6"/>
	<valueType name="OPERCODE" base="xs:string" variety="Atomic">
		<pattern>[0-9A-Z]{4}</pattern>
	</valueType>
	<valueType name="PaymentCode" base="xs:string" variety="Atomic">
		<enumeration>33-01</enumeration>
		<enumeration>33-02</enumeration>
		<enumeration>33-03</enumeration>
		<enumeration>33-04</enumeration>
	</valueType>
	<valueType name="Phone" base="xs:string" variety="Atomic">
		<pattern>\+[0-9]{10,15}|null</pattern>
	</valueType>
	<valueType name="String100" base="xs:string" variety="Atomic" maxLength="100"/>
	<valueType name="String1000" base="xs:string" variety="Atomic" maxLength="1000"/>
	<valueType name="String25" base="xs:string" variety="Atomic" maxLength="25"/>
	<valueType name="String255" base="xs:string" variety="Atomic" maxLength="255"/>
	<valueType name="String50" base="xs:string" variety="Atomic" maxLength="50"/>
	<valueType name="String8000" base="xs:string" variety="Atomic" maxLength="8000"/>
	<valueType name="UUID" base="xs:string" variety="Atomic">
		<pattern>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}</pattern>
	</valueType>
	<valueType name="UploadingMode" base="xs:string" variety="Atomic">
		<pattern>C|U|D</pattern>
	</valueType>
	<valueType name="VIN" base="xs:string" variety="Atomic">
		<pattern>[0123456789ABCDEFGHJKLMNPRSTUVWXYZ-]{8,17}</pattern>
	</valueType>
