	<objectType name="Bodyshop" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="payer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="car" type="d3p1:Car"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="documentNumber" type="d3p1:String25"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="gcmNumber" type="d3p1:GCM" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="status" type="d3p1:String50"/>
		<property name="dateOpening" type="xs:dateTime"/>
		<property name="dateClosing" type="xs:dateTime" lowerBound="0"/>
		<property name="mileage" type="xs:integer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="serviceAdvisor" type="d3p1:Employee"/>
		<property name="repairType">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>Гарантия кузовной ремонт|Кузовной ремонт</pattern>
			</typeDef>
		</property>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="workshop" type="d3p1:String50"/>
		<property name="totalDuration" type="xs:decimal"/>
		<property name="totalWorks" type="xs:decimal"/>
		<property name="totalParts" type="xs:decimal"/>
		<property name="totalDiscount" type="xs:decimal"/>
		<property name="total" type="xs:decimal"/>
		<property name="VAT" type="xs:decimal"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="parts" type="d3p1:Parts"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="works" type="d3p1:works_body"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="comments" type="d3p1:String1000" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="recommendation" type="d3p1:String8000"/>
		<property name="nextServiceDate" type="xs:date"/>
	</objectType>
	<objectType name="Car" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="VIN" type="d3p1:VIN"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="brand" type="d3p1:String50" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="model" type="d3p1:String50" lowerBound="0"/>
		<property name="mileage" type="xs:integer"/>
		<property name="license" type="xs:string" lowerBound="0"/>
		<property name="year" type="xs:integer"/>
	</objectType>
	<objectType name="Customer" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="firstName" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="middleName" type="d3p1:String50" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="lastName" type="d3p1:String50"/>
		<property name="isLegal" type="xs:boolean"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="companyName" type="d3p1:String100" lowerBound="0"/>
		<property name="TIN" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>[0-9]{10}([0-9]{2})?</pattern>
			</typeDef>
		</property>
		<property name="dateOfBirth" type="xs:date" lowerBound="0"/>
		<property name="gender" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>male|female</pattern>
			</typeDef>
		</property>
		<property name="age" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:integer" variety="Atomic" minInclusive="16" maxInclusive="100"/>
		</property>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="address" type="d3p1:address"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="email1" type="d3p1:Email" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="email2" type="d3p1:Email" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="phone1" type="d3p1:Phone" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="phone2" type="d3p1:Phone" lowerBound="0"/>
		<property name="agreement">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>true|false|null</pattern>
			</typeDef>
		</property>
	</objectType>
	<objectType name="Employee" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="firstName" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="middleName" type="d3p1:String50" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="lastName" type="d3p1:String50"/>
		<property name="ipn" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>du[0-9]{5}</pattern>
			</typeDef>
		</property>
	</objectType>
	<objectType name="Order" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="payer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="car" type="d3p1:Car"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="documentNumber" type="d3p1:String25"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="gcmNumber" type="d3p1:GCM" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="status" type="d3p1:String50"/>
		<property name="dateOpening" type="xs:dateTime"/>
		<property name="dateClosing" type="xs:dateTime" lowerBound="0"/>
		<property name="mileage" type="xs:integer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="serviceAdvisor" type="d3p1:Employee"/>
		<property name="repairType">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>Слесарный ремонт|Регулярное ТО|Регулярное ТО\+Слесарный ремонт|Мойка|Дополнительное оборудование|Гарантия слесарный ремонт|Внутренний ремонт|Сервисные продукты</pattern>
			</typeDef>
		</property>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="workshop" type="d3p1:String50"/>
		<property name="totalDuration" type="xs:decimal"/>
		<property name="totalWorks" type="xs:decimal"/>
		<property name="totalParts" type="xs:decimal"/>
		<property name="totalDiscount" type="xs:decimal"/>
		<property name="total" type="xs:decimal"/>
		<property name="VAT" type="xs:decimal"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="parts" type="d3p1:Parts"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="works" type="d3p1:works"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="comments" type="d3p1:String1000" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="recommendation" type="d3p1:String8000"/>
		<property name="nextServiceDate" type="xs:date"/>
	</objectType>
	<objectType name="aftersales" open="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="order" type="d3p1:Order" lowerBound="0" upperBound="-1"/>
		<property name="ver" form="Attribute"/>
		<property name="bir" form="Attribute"/>
		<property name="site" form="Attribute"/>
	</objectType>
	<objectType name="Parts" open="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="part" type="d3p1:part" lowerBound="0" upperBound="-1"/>
	</objectType>
	<objectType name="part">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="reference" type="d3p1:String25"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-aftersales" name="name" type="d3p1:String255"/>
		<property name="qty" type="xs:decimal"/>
		<property name="price" type="xs:decimal"/>
		<property name="discount" type="xs:decimal"/>
