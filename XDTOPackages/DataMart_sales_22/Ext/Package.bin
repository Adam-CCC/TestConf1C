<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://gate.renault.ru/dataMart-sales" elementFormQualified="true" attributeFormQualified="false">
	<property name="sales">
		<typeDef xsi:type="ObjectType" ordered="false" sequenced="true">
			<property name="ver" lowerBound="1" form="Attribute">
				<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
					<pattern>[0-9]{1,2}\.[0-9]{1,2}</pattern>
				</typeDef>
			</property>
			<property name="bir" lowerBound="1" form="Attribute">
				<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
					<pattern>[0-9]{8}</pattern>
				</typeDef>
			</property>
			<property name="site" lowerBound="1" form="Attribute">
				<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
					<pattern>[0-9]{8}-[0-9]{3}</pattern>
				</typeDef>
			</property>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="renaultLead" type="d4p1:Lead" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="dealerLead" type="d4p1:Lead" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="mailing" type="d4p1:Mailing" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="incomingCall" type="d4p1:Call" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="outgoingCall" type="d4p1:Call" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="visit" type="d4p1:Visit" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="revisit" type="d4p1:Visit" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="credit" type="d4p1:Credit" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="offer" type="d4p1:Offer" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="testdrive" type="d4p1:Testdrive" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="draftContract" type="d4p1:Contract" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="contract" type="d4p1:Contract" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="delivery" type="d4p1:Delivery" lowerBound="0" upperBound="-1" nillable="true"/>
			<property xmlns:d4p1="http://gate.renault.ru/dataMart-sales" name="tradeIn" type="d4p1:TradeIn" lowerBound="0" upperBound="-1" nillable="true"/>
		</typeDef>
	</property>
	<valueType name="Department" base="xs:string" variety="Atomic">
		<pattern>Отдел продаж|Отдел сервиса|Отдел продаж запасных частей|Отдел корпоративных продаж|Отдел трейд-ин|Отдел reception|ОФУ|Отдел кузовного ремонта|Прочее</pattern>
	</valueType>
	<valueType name="Email" base="xs:string" variety="Atomic">
		<pattern>[^@]+@[^\.]+\..+|null</pattern>
	</valueType>
	<valueType name="Phone" base="xs:string" variety="Atomic">
		<pattern>\+[0-9]{10,15}|null</pattern>
	</valueType>
	<valueType name="String100" base="xs:string" variety="Atomic" maxLength="100"/>
	<valueType name="String25" base="xs:string" variety="Atomic" maxLength="25"/>
	<valueType name="String255" base="xs:string" variety="Atomic" maxLength="255"/>
	<valueType name="String5" base="xs:string" variety="Atomic" maxLength="5"/>
	<valueType name="String50" base="xs:string" variety="Atomic" maxLength="50"/>
	<valueType name="UUID" base="xs:string" variety="Atomic">
		<pattern>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}</pattern>
	</valueType>
	<valueType name="UploadingMode" base="xs:string" variety="Atomic">
		<pattern>C|U|D</pattern>
	</valueType>
	<valueType name="VIN" base="xs:string" variety="Atomic">
		<pattern>[0123456789ABCDEFGHJKLMNPRSTUVWXYZ-]{8,17}</pattern>
	</valueType>
	<objectType name="Call" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="department" type="d3p1:Department"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="request" type="d3p1:Car" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50" lowerBound="0"/>
		<property name="isPrimary" type="xs:boolean"/>
		<property name="nextContactDate" type="xs:date"/>
	</objectType>
	<objectType name="Car" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="model" type="d3p1:CarModel"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="version" type="d3p1:String100" lowerBound="0"/>
		<property name="transmission" type="xs:string" lowerBound="0"/>
		<property name="fuel" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<enumeration>P</enumeration>
				<enumeration>D</enumeration>
				<enumeration>E</enumeration>
				<enumeration>L</enumeration>
				<enumeration>H</enumeration>
			</typeDef>
		</property>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="color" type="d3p1:CarColor" lowerBound="0"/>
		<property name="year" type="xs:integer" lowerBound="0"/>
		<property name="isUsed" type="xs:boolean"/>
	</objectType>
	<objectType name="CarColor" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="name" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="colorCode" type="d3p1:String5" lowerBound="0"/>
		<property name="isMetallic" type="xs:boolean"/>
	</objectType>
	<objectType name="CarModel" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="brand" type="d3p1:String25"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="name" type="d3p1:String25"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="renaultCode" type="d3p1:String5" lowerBound="0"/>
	</objectType>
	<objectType name="Contract" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="documentNumber" type="d3p1:String25"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="status" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="channel" type="d3p1:SalesChannel"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="cars" type="d3p1:contractCars"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="currentCar" type="d3p1:Car" lowerBound="0"/>
		<property name="nextContactDate" type="xs:date"/>
		<property name="paymentDate" type="xs:date" lowerBound="0"/>
	</objectType>
	<objectType name="Credit" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="request" type="d3p1:Car"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="creditCampaign" type="d3p1:String100" lowerBound="0"/>
	</objectType>
	<objectType name="Customer" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="firstName" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="middleName" type="d3p1:String50" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="lastName" type="d3p1:String50" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="companyName" type="d3p1:String255" lowerBound="0"/>
		<property name="TIN" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>[0-9]{10}([0-9]{2})?</pattern>
			</typeDef>
		</property>
		<property name="dateOfBirth" type="xs:date" lowerBound="0"/>
		<property name="gender" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>male|female</pattern>
			</typeDef>
		</property>
		<property name="age" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:integer" variety="Atomic" minInclusive="16" maxInclusive="100"/>
		</property>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="city" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="email1" type="d3p1:Email" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="email2" type="d3p1:Email" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="phone1" type="d3p1:Phone" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="phone2" type="d3p1:Phone" lowerBound="0"/>
		<property name="agreement">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>true|false|null</pattern>
			</typeDef>
		</property>
	</objectType>
	<objectType name="Delivery" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="contractNumber" type="d3p1:String25"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="car" type="d3p1:Car"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="VIN" type="d3p1:VIN"/>
		<property name="isDemo" type="xs:boolean"/>
		<property name="netPrice" type="xs:decimal"/>
		<property name="optionsTotal" type="xs:decimal"/>
		<property name="accessoriesTotal" type="xs:decimal"/>
		<property name="servicesTotal" type="xs:decimal"/>
		<property name="renaultPromosTotal" type="xs:decimal"/>
		<property name="dealerPromosTotal" type="xs:decimal"/>
		<property name="tradeIn" type="xs:decimal"/>
		<property name="subsidy" type="xs:decimal"/>
		<property name="total" type="xs:decimal"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="options" type="d3p1:contractCarsLineOptions"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="accessories" type="d3p1:contractCarsLineAccessories"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="services" type="d3p1:contractCarsLineServices"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="renaultPromos" type="d3p1:contractCarsLineRenaultPromos"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="dealerPromos" type="d3p1:contractCarsLineDealerPromos"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="currentCar" type="d3p1:Car" lowerBound="0"/>
		<property name="deliveryDate" type="xs:date"/>
		<property name="paymentDate" type="xs:date"/>
		<property name="PTSDate" type="xs:date"/>
		<property name="nextContactDate" type="xs:date"/>
	</objectType>
	<objectType name="Lead" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="department" type="d3p1:Department"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="request" type="d3p1:Car"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50" lowerBound="0"/>
		<property name="isPrimary" type="xs:boolean"/>
		<property name="isLost" type="xs:boolean"/>
	</objectType>
	<objectType name="Mailing" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="department" type="d3p1:Department"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="request" type="d3p1:Car"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50" lowerBound="0"/>
		<property name="isPrimary" type="xs:boolean"/>
	</objectType>
	<objectType name="Manager" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="firstName" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="middleName" type="d3p1:String50" lowerBound="0"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="lastName" type="d3p1:String50"/>
		<property name="ipn" lowerBound="0">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<pattern>du[0-9]{5}</pattern>
			</typeDef>
		</property>
	</objectType>
	<objectType name="Offer" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="channel" type="d3p1:SalesChannel"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="cars" type="d3p1:offerCars"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="currentCar" type="d3p1:Car" lowerBound="0"/>
		<property name="nextContactDate" type="xs:date"/>
	</objectType>
	<objectType name="SalesChannel" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="name" type="d3p1:String50"/>
	</objectType>
	<objectType name="Testdrive" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property name="date" type="xs:dateTime"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="manager" type="d3p1:Manager"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="customer" type="d3p1:Customer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="channel" type="d3p1:SalesChannel" lowerBound="0"/>
