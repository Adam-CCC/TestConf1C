		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="VIN" type="d3p1:VIN"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50"/>
		<property name="nextContactDate" type="xs:date"/>
	</objectType>
	<objectType name="TradeIn" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="stockNumber" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="worksheet" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="car" type="d3p1:Car"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="VIN" type="d3p1:VIN"/>
		<property name="mileage" type="xs:integer"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="condition" type="d3p1:String50"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="incomeData" type="d3p1:tradeInIncomeData"/>
		<property name="isSold" type="xs:boolean"/>
		<property name="saleData" lowerBound="0">
			<typeDef xsi:type="ObjectType" ordered="false" sequenced="true">
				<property name="date" type="xs:date"/>
				<property name="price" type="xs:decimal"/>
				<property name="GM1" type="xs:decimal"/>
				<property name="GM2" type="xs:decimal"/>
			</typeDef>
		</property>
		<property name="isRenaultSelection" type="xs:boolean"/>
		<property name="isOnWarranty" type="xs:boolean"/>
		<property name="isRoadAssistance" type="xs:boolean"/>
		<property name="isCredit" type="xs:boolean"/>
		<property name="isPublished" type="xs:boolean"/>
	</objectType>
	<objectType name="Visit" ordered="false" sequenced="true">
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="id" type="d3p1:UUID" lowerBound="1" form="Attribute"/>
		<property xmlns:d3p1="http://gate.renault.ru/dataMart-sales" name="mode" type="d3p1:UploadingMode" lowerBound="1" form="Attribute"/>
