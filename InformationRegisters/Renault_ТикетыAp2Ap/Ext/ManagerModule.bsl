// 
// Описание процедуры
//  Процедура записи результата выполнения тикета.
//
// Параметры
//  Парам1 РезультатЗапроса  - Строка - XML с результатом запроса
//
//  Парам2 Тикет  - Строка(16) - НомерТикета, в который необходимо положить результат
//
//@-
Процедура ЗаписатьРезультат(РезультатЗапроса, Тикет) Экспорт

	// Комментарий 
	//Дата создания - 19.04.2012 11:25:08; Автор - Окипний Андрей Евгеньевич
	//Нужно найти созданный тикет
	//
	МЗ = СоздатьМенеджерЗаписи();
	
	МЗ.Тикет = Тикет;
	
	// Комментарий 
	//Дата создания - 19.04.2012 11:26:51; Автор - Окипний Андрей Евгеньевич
	//Считываем запись из регистра
	//
	МЗ.Прочитать();
	
	// Комментарий 
	//Дата создания - 19.04.2012 11:27:11; Автор - Окипний Андрей Евгеньевич
	//Устанавливаем новые значения реквизитов
	//
	РезультатВХранилище = Новый ХранилищеЗначения(РезультатЗапроса, Новый СжатиеДанных(9));
	
	МЗ.Результат = РезультатВХранилище;
	МЗ.ТикетВыполнен = Истина;
	МЗ.ОшибкаВыполнения = Ложь;
	
	// Комментарий 
	//Дата создания - 19.04.2012 11:28:10; Автор - Окипний Андрей Евгеньевич
	//Сохраняем результат
	//
	МЗ.Записать();
	
КонецПроцедуры // ЗаписатьРезультат(РезультатЗапроса, Тикет)

////@+ Процедура ЗаписатьОшибкуВТикет(Тикет)
