Процедура ЗаписатьОшибкуВТикет(Тикет, ОписаниеОшибки = "") Экспорт

	МЗ = СоздатьМенеджерЗаписи();
	
	МЗ.Тикет = Тикет;
	
	// Комментарий 
	//Дата создания - 19.04.2012 11:37:59; Автор - Окипний Андрей Евгеньевич
	//Считываем запись из регистра
	//
	МЗ.Прочитать();
	
	// Комментарий 
	//Дата создания - 19.04.2012 11:38:15; Автор - Окипний Андрей Евгеньевич
	//Устанавливаем новые значения реквизитов
	//
	МЗ.ТикетВыполнен = Истина;
