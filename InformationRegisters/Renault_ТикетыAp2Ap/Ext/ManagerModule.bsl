КонецПроцедуры // ЗаписатьОшибкуВТикет(Тикет)

////@+ Функция СоздатьНовыйТикет()
// Дата создания - 19.04.2012 11:39:15;
// Автор - Окипний Андрей Евгеньевич
//
// Описание функции
//  Функция создает новый тимкет в регистре
//
// Параметры
//  Без параметров
//
// Возвращаемое значение
//  Тикет  - Строка(16) - Номер тикета в формате ГГГГММДДччммсс
//
//@-
Функция СоздатьНовыйТикет() Экспорт
	
	//Первоначальная инициализация
	Тикет = неопределено;
	
	Тикет = Формат(ТекущаяДата(),"ДФ=ггггММддччммсс");
	
	// Комментарий 
	//Дата создания - 19.04.2012 11:41:59; Автор - Окипний Андрей Евгеньевич
	//создаем менеджер записи
	//
	МЗ = СоздатьМенеджерЗаписи();
	МЗ.Тикет = Тикет;
	МЗ.Прочитать();
	
	МЗ.Тикет = Тикет;
	МЗ.Записать();
	
	
	Возврат Тикет;
КонецФункции // СоздатьНовыйТикет()
