Функция ПолучитьДанныеСинхронизации(Производитель) Экспорт
	Структура=Новый Структура;
	Запрос=Новый Запрос("Выбрать ИмяИсточникаДанных,ДатаПоследнейСинхронизации Из РегистрСведений.DMS_СинхронизацияВнешнихИсточниковДанных ГДЕ Производитель=&Производитель");
	Запрос.УстановитьПараметр("Производитель",Производитель);
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Структура.Вставить(Выборка.ИмяИсточникаДанных,Выборка.ДатаПоследнейСинхронизации)
	КонецЦикла;
	Возврат Структура
КонецФункции

//где СтруктураСинхронизации - (ИмяИсточникаДанных,ДатаПоследнейСинхронизации)
Функция УстановитьДанныеСинхронизации(Производитель,СтруктураСинхронизации) Экспорт
	Для Каждого Эл Из СтруктураСинхронизации Цикл 
		Рег=РегистрыСведений.DMS_СинхронизацияВнешнихИсточниковДанных.СоздатьМенеджерЗаписи();
		Рег.Производитель=Производитель;
		Рег.ИмяИсточникаДанных=Эл.Ключ;
		Рег.ДатаПоследнейСинхронизации=Эл.Значение;
		Рег.Записать(Истина);
	КонецЦикла;	
КонецФункции	