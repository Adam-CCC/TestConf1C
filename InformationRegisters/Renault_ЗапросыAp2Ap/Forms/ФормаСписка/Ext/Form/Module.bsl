
&НаСервере
Функция ПоказатьЗапросНаСервере(ТекущиеДанные)
	Менеджер = РегистрыСведений.ЗапросыAp2Ap.СоздатьМенеджерЗаписи();
	Менеджер.BIR = ТекущиеДанные.BIR;
	Менеджер.Ключ = ТекущиеДанные.Ключ;
	Менеджер.Прочитать();
	Возврат Менеджер.ТекстЗапроса.Получить();
КонецФункции

&НаКлиенте
Процедура ПоказатьЗапрос(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаОтвет = ПоказатьЗапросНаСервере(ТекущиеДанные);
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(СтрокаОтвет);
	Тд.Показать();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтвет(Команда)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаОтвет = ПоказатьОтветНаСервере(ТекущиеДанные);
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(СтрокаОтвет);
	Тд.Показать();
КонецПроцедуры

&НаСервере
Функция ПоказатьОтветНаСервере (ТекущиеДанные)
	Менеджер = РегистрыСведений.ЗапросыAp2Ap.СоздатьМенеджерЗаписи();
	Менеджер.BIR = ТекущиеДанные.BIR;
	Менеджер.Ключ = ТекущиеДанные.Ключ;
	Менеджер.Прочитать();
	Возврат Менеджер.ТекстОтвета.Получить();
КонецФункции

