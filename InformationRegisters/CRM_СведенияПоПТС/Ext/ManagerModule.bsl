	Ответ = Ложь;
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Модель.Установить(Модель);
	Набор.Отбор.Версия.Установить(Версия);	
	Набор.Прочитать();
	Если Набор.Количество() > 0 Тогда
		Попытка
			ДанныеПТС = СформироватьСтруктуруДанныхПТС(Набор[0]);
			Ответ = истина;

		исключение
			Ответ = Ложь;
		КонецПопытки;
	КонецЕсли;
