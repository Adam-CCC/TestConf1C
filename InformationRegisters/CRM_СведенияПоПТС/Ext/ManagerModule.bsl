	Набор.Отбор.Версия.Установить(Версия);	
	Набор.Прочитать();
	
	Если Набор.Количество() = 0 Тогда
		 НовыйПТС = Набор.Добавить();
	 Иначе
		 НовыйПТС = Набор[0];
	КонецЕсли;
		
    Попытка
		    НовыйПтс.Модель = Модель;
			НовыйПтс.Версия = Версия;
			ЗаполнитьЗначенияСвойств(НовыйПТС,ДанныеПТС);
			Набор.Записать(Истина);
			Ответ = Истина;
  	Исключение
			Ответ = Ложь;
