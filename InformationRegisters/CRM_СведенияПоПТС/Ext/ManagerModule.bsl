КонецФункции

//Формируем структуру данных птс из объекта 
//КонецОписания
Функция СформироватьСтруктуруДанныхПТС(Объект) Экспорт
	
	Ответ = Новый Структура();
	Набор = СоздатьНаборЗаписей();
	Для Каждого Ресурс ИЗ Набор.Метаданные().Ресурсы Цикл
		Ответ.Вставить(Ресурс.Имя,Объект[Ресурс.Имя]);
	КонецЦикла;
	Для Каждого Реквизит ИЗ Набор.Метаданные().Реквизиты Цикл
		Ответ.Вставить(Реквизит.Имя,Объект[Реквизит.Имя]);
	КонецЦикла;
    Возврат Ответ;
	
КонецФункции
//Сохраняем(перезаписываем если есть данныеПТС в регистре по Модели и Версии 
//КонецОписания
Функция СохранитьДанныеПТС(Модель,Версия,ДанныеПТС)  экспорт
	Ответ = Ложь;
