&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Территория = ПолучитьЗначениеНастройки(ПараметрыСеанса.Пользователь, "ГруппаДоступностиСкладов");
	мДоступныеСклады = ПолучитьСписокДоступныхСкладов();
	
	Если НЕ ЗначениеЗаполнено(мДоступныеСклады) Тогда
		
		Сообщить("У пользователя не заданы доступные склады автомобилей.");
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;
	
	Элементы.Территория.СписокВыбора.ЗагрузитьЗначения(мДоступныеСклады);
	ДоступныеСклады.ЗагрузитьЗначения(мДоступныеСклады);
	УО = ДинамическийСписок.УсловноеОформление.Элементы;
	ЭлементУО = УО.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Красный);
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТребуетсяЗарядкаАКБ");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ Отказ тогда
		ОбновлениеДинамическихДанных();
		ПодключитьОбработчикОжидания("ОбновлениеДинамическихДанных", 20, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеДинамическихДанных()
	
	ПараметрыДинСписка	= ДинамическийСписок.Параметры;
	
	Если Не ЗначениеЗаполнено(Территория) Тогда
	    Склад = ДоступныеСклады.ВыгрузитьЗначения();
	иначе
		Склад = Территория; ;
	КонецЕсли;
	
	//ОтборПоТерритории = ?(Территория = Справочники.СкладыКомпании.ПустаяСсылка(), Ложь, Истина);
	
	//ПараметрыДинСписка.УстановитьЗначениеПараметра("ЕстьОтборПоТерритории", ОтборПоТерритории);
	ПараметрыДинСписка.УстановитьЗначениеПараметра("Территория", Склад);
	ПараметрыДинСписка.УстановитьЗначениеПараметра("текДата", ТекущаяДата());
	ПараметрыДинСписка.УстановитьЗначениеПараметра("ТребуетсяЗарядка", ТребуетсяЗарядитьАКБ);
	ПараметрыДинСписка.УстановитьЗначениеПараметра("ПоказыватьПроданныеАвтомобили", ПоказыватьПроданныеАвтомобили);

	Элементы.ДинамическийСписок.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ТерриторияПриИзменении(Элемент)
	
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ДинамическийСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеСтроки	= Элементы.ДинамическийСписок.ДанныеСтроки(ВыбраннаяСтрока);
	
	ДанныеОткрытия	= Новый Структура;
	ДанныеОткрытия.Вставить("Автомобиль",	ДанныеСтроки.Автомобиль);
	ОткрытьФормуМодально("РегистрСведений.Renault_ЖурналПроверкиАКБ.Форма.ФормаЗаписи", ДанныеОткрытия);
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ТребуетсяЗарядитьАКБПриИзменении(Элемент)
	
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьПроданныеАвтомобилиПриИзменении(Элемент)
	
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеНастройки(Пользователь, Настройка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_Advanced_НастройкиПользователей.Значение
		|ИЗ
		|	РегистрСведений.Renault_Advanced_НастройкиПользователей КАК Renault_Advanced_НастройкиПользователей
		|ГДЕ
		|	Renault_Advanced_НастройкиПользователей.Пользователь = &Пользователь
		|	И Renault_Advanced_НастройкиПользователей.Настройка.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Настройка);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Вставить обработку выборки ВыборкаДетальныеЗаписи
	КонецЦикла;

КонецФункции // ПолучитьЗначениеНастройки()

&НаСервереБезКонтекста
Функция ПолучитьСписокДоступныхСкладов()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки
		|ПОМЕСТИТЬ ПраваИНастройки
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Renault_ПраваИНастройкиПользователейАвтосклад_ДоступныеСклады.Склад
		|ИЗ
		|	Справочник.Renault_ПраваИНастройкиПользователей.Автосклад_ДоступныеСклады КАК Renault_ПраваИНастройкиПользователейАвтосклад_ДоступныеСклады
		|ГДЕ
		|	Renault_ПраваИНастройкиПользователейАвтосклад_ДоступныеСклады.Ссылка В
		|			(ВЫБРАТЬ
		|				ПраваИНастройки_.ПраваИНастройки
		|			ИЗ
		|				ПраваИНастройки КАК ПраваИНастройки_)";
	
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	    Территория = ПолучитьЗначениеНастройки(ПараметрыСеанса.Пользователь, "ГруппаДоступностиСкладов");
	Иначе
	    Территория = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Склад");
	КонецЕсли;

	Возврат Территория;	

КонецФункции // ПолучитьСписокДоступныхСкладов()

