	<Attributes>
		<Attribute name="ДинамическийСписок" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Динамический список</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>~ДинамическийСписок.ПриПриеме</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ВЗ_ЖурналПроверки.Автомобиль,
	ВЗ_ЖурналПроверки.VIN,
	ВЗ_ЖурналПроверки.Нота,
	ВЗ_ЖурналПроверки.ДатаПроверкиПриПриеме,
	ВЗ_ЖурналПроверки.ДатаПроверки40Дней,
	ВЗ_ЖурналПроверки.ДатаПроверки80Дней,
	ВЗ_ЖурналПроверки.ДатаПроверки120Дней,
	ВЗ_ЖурналПроверки.ДатаПроверки160Дней,
	ВЗ_ЖурналПроверки.Территория,
	ВЗ_ЖурналПроверки.НапряжениеПриПриеме,
	ВЗ_ЖурналПроверки.НапряжениеПриПроверке40Дней,
	ВЗ_ЖурналПроверки.НапряжениеПриПроверке80Дней,
	ВЗ_ЖурналПроверки.НапряжениеПриПроверке120Дней,
	ВЗ_ЖурналПроверки.НапряжениеПриПроверке160Дней,
	ВЗ_ЖурналПроверки.Продан,
	ВЗ_ЖурналПроверки.ТребуетсяЗарядкаАКБ
ИЗ
	(ВЫБРАТЬ
		АвтомобилиНаСкладахОстатки.Автомобиль КАК Автомобиль,
		АвтомобилиНаСкладахОстатки.Автомобиль.VIN КАК VIN,
		ВЫБОР
			КОГДА ВыполнениеСервисныхКампаний.VIN ЕСТЬ NULL 
				ТОГДА ЛОЖЬ
			ИНАЧЕ ИСТИНА
		КОНЕЦ КАК Нота,
		ЖурналПроверкиАКБ.ДатаПроверкиПриПриеме КАК ДатаПроверкиПриПриеме,
		ЖурналПроверкиАКБ.ДатаПроверки40Дней КАК ДатаПроверки40Дней,
		ЖурналПроверкиАКБ.ДатаПроверки80Дней КАК ДатаПроверки80Дней,
		ЖурналПроверкиАКБ.ДатаПроверки120Дней КАК ДатаПроверки120Дней,
		ЖурналПроверкиАКБ.ДатаПроверки160Дней КАК ДатаПроверки160Дней,
		АвтомобилиНаСкладахОстатки.СкладКомпании КАК Территория,
		ЖурналПроверкиАКБ.НапряжениеПриПриеме КАК НапряжениеПриПриеме,
		ЖурналПроверкиАКБ.НапряжениеПриПроверке40Дней КАК НапряжениеПриПроверке40Дней,
		ЖурналПроверкиАКБ.НапряжениеПриПроверке80Дней КАК НапряжениеПриПроверке80Дней,
		ЖурналПроверкиАКБ.НапряжениеПриПроверке120Дней КАК НапряжениеПриПроверке120Дней,
		ЖурналПроверкиАКБ.НапряжениеПриПроверке160Дней КАК НапряжениеПриПроверке160Дней,
		ВЫБОР
			КОГДА НЕ ВЫБОР
							КОГДА ПродажиАвтомобилей.Автомобиль ЕСТЬ НЕ NULL 
								ТОГДА ИСТИНА
							ИНАЧЕ ЛОЖЬ
						КОНЕЦ
					И (ЖурналПроверкиАКБ.ДатаПроверки40Дней = ДАТАВРЕМЯ(1, 1, 1)
							И РАЗНОСТЬДАТ(&amp;ТекДата, ДОБАВИТЬКДАТЕ(Renault_АвтомобилиДопРеквизиты.ДатаПриемкиНаСклад, ДЕНЬ, 40), ДЕНЬ) &lt;= 7
						ИЛИ ЖурналПроверкиАКБ.ДатаПроверки80Дней = ДАТАВРЕМЯ(1, 1, 1)
							И РАЗНОСТЬДАТ(&amp;ТекДата, ДОБАВИТЬКДАТЕ(Renault_АвтомобилиДопРеквизиты.ДатаПриемкиНаСклад, ДЕНЬ, 80), ДЕНЬ) &lt;= 7
						ИЛИ ЖурналПроверкиАКБ.ДатаПроверки120Дней = ДАТАВРЕМЯ(1, 1, 1)
							И РАЗНОСТЬДАТ(&amp;ТекДата, ДОБАВИТЬКДАТЕ(Renault_АвтомобилиДопРеквизиты.ДатаПриемкиНаСклад, ДЕНЬ, 12), ДЕНЬ) &lt;= 7
						ИЛИ ЖурналПроверкиАКБ.ДатаПроверки160Дней = ДАТАВРЕМЯ(1, 1, 1)
							И РАЗНОСТЬДАТ(&amp;ТекДата, ДОБАВИТЬКДАТЕ(Renault_АвтомобилиДопРеквизиты.ДатаПриемкиНаСклад, ДЕНЬ, 160), ДЕНЬ) &lt;= 7)
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ КАК ТребуетсяЗарядкаАКБ,
		ВЫБОР
			КОГДА ПродажиАвтомобилей.Автомобиль ЕСТЬ НЕ NULL 
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ КАК Продан
	ИЗ
		РегистрНакопления.ОстаткиАвтомобилей.Остатки(, ) КАК АвтомобилиНаСкладахОстатки
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ЖурналПроверкиАКБ КАК ЖурналПроверкиАКБ
			ПО (ЖурналПроверкиАКБ.Автомобиль = АвтомобилиНаСкладахОстатки.Автомобиль)
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПродажиАвтомобилей КАК ПродажиАвтомобилей
			ПО АвтомобилиНаСкладахОстатки.Автомобиль = ПродажиАвтомобилей.Автомобиль
				И (ПродажиАвтомобилей.Регистратор ССЫЛКА Документ.РеализацияАвтомобилей)
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтомобилиДопРеквизиты КАК Renault_АвтомобилиДопРеквизиты
			ПО АвтомобилиНаСкладахОстатки.Автомобиль = Renault_АвтомобилиДопРеквизиты.Автомобиль
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеСервисныхКампаний КАК ВыполнениеСервисныхКампаний
			ПО АвтомобилиНаСкладахОстатки.Автомобиль.VIN = ВыполнениеСервисныхКампаний.VIN
				И (ВыполнениеСервисныхКампаний.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1))
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
			ПО АвтомобилиНаСкладахОстатки.Автомобиль = CRM_СостояниеАвтомобилейПроизводителя_v2.Автомобиль
				И (CRM_СостояниеАвтомобилейПроизводителя_v2.AUTO_STATUS = "На складе дилера")) КАК ВЗ_ЖурналПроверки
ГДЕ
	//ВЫБОР
	//		КОГДА &amp;ЕстьОтборПоТерритории
	//			ТОГДА ВЗ_ЖурналПроверки.Территория в (&amp;Территория)
	//		ИНАЧЕ ИСТИНА
	//	КОНЕЦ
		ВЗ_ЖурналПроверки.Территория в (&amp;Территория)
	И ВЫБОР
			КОГДА &amp;ТребуетсяЗарядка
				ТОГДА ВЗ_ЖурналПроверки.ТребуетсяЗарядкаАКБ = &amp;ТребуетсяЗарядка
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ПоказыватьПроданныеАвтомобили
				ТОГДА ИСТИНА
			ИНАЧЕ ВЗ_ЖурналПроверки.Продан = &amp;ПоказыватьПроданныеАвтомобили
		КОНЕЦ</QueryText>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
