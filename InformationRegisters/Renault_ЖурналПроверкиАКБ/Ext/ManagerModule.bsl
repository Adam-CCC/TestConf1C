
Функция ПолучитьЗначениеНоты(VIN)Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВыполнениеСервисныхКампаний.VIN
	|ИЗ
	|	РегистрСведений.ВыполнениеСервисныхКампаний КАК ВыполнениеСервисныхКампаний
	|ГДЕ
	|	ВыполнениеСервисныхКампаний.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
	|	И ВыполнениеСервисныхКампаний.VIN = &VIN";
	
	
	Запрос.УстановитьПараметр("VIN", VIN);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();
	
КонецФункции // ПолучитЗначениеНоты()()
