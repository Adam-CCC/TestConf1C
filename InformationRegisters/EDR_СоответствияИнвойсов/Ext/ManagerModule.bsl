
Процедура ЗаписатьСоответствие(Параметры) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	EDR_СоответствияИнвойсов.Invoice КАК Invoice
	|ИЗ
	|	РегистрСведений.EDR_СоответствияИнвойсов КАК EDR_СоответствияИнвойсов
	|ГДЕ
	|	EDR_СоответствияИнвойсов.ЗаказНаряд = &ЗаказНаряд
	|	И EDR_СоответствияИнвойсов.Intervention = &Intervention
	|	И EDR_СоответствияИнвойсов.Invoice = &Invoice"
	);
	Запрос.УстановитьПараметр("ЗаказНаряд",Параметры["ЗаказНаряд"]);
	Запрос.УстановитьПараметр("Intervention", Параметры["GUID"]);
	Запрос.УстановитьПараметр("Invoice", Параметры["GUID_Invoice"]);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() тогда //Если записей нет, создаем
		МЗ = РегистрыСведений.EDR_СоответствияИнвойсов.СоздатьМенеджерЗаписи();
		МЗ.GUID			= Строка(Новый УникальныйИдентификатор());
		МЗ.ЗаказНаряд	= Параметры["ЗаказНаряд"];
		МЗ.Intervention = Параметры["GUID"];
		МЗ.Invoice		= Параметры["GUID_Invoice"];
		МЗ.Процент		= Параметры["Процент"];
		МЗ.Записать();
	КонецЕсли;
	
КонецПроцедуры

