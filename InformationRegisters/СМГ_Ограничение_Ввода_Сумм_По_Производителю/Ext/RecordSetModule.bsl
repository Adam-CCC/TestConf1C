Процедура Запрет_Редактирования_Цены_По_Производителю(Элемент,ЭлементыФормы) Экспорт
	
	ЭтотОбъект.Отбор.Пользователь.Значение = ПараметрыСеанса.Пользователь;
	ЭтотОбъект.Отбор.Пользователь.Использование = Истина;
	ЭтотОбъект.Прочитать();
	
	Если ЭтотОбъект.Выбран() Тогда
		Если Элемент.ТекущиеДанные = Неопределено Тогда
			Возврат;	
		КонецЕсли;
		Текущий_Произодитель_Строки = Элемент.ТекущиеДанные.Номенклатура.Производитель;		
		Запрещенные_Производители_Для_Пользователя = ЭтотОбъект.Выгрузить(,"Производитель");		
		Поиск = Запрещенные_Производители_Для_Пользователя.Найти(Текущий_Произодитель_Строки);		
		Если Поиск <> Неопределено Тогда
			ЭлементыФормы.Товары.Колонки.Цена.ЭлементУправления.Доступность = Ложь;
			ЭлементыФормы.Товары.Колонки.СуммаВсего.ЭлементУправления.Доступность = Ложь;
			//Бондаренко++ 20240921
			Попытка ЭлементыФормы.Товары.Колонки.Сумма.ЭлементУправления.Доступность = Ложь; Исключение КонецПопытки; 
			//Бондаренко-- 20240921
		Иначе
			ЭлементыФормы.Товары.Колонки.Цена.ЭлементУправления.Доступность = Истина;
			ЭлементыФормы.Товары.Колонки.СуммаВсего.ЭлементУправления.Доступность = Истина;
			//Бондаренко++ 20240921
			Попытка ЭлементыФормы.Товары.Колонки.Сумма.ЭлементУправления.Доступность = Истина; Исключение КонецПопытки; 
			//Бондаренко-- 20240921
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
КонецПроцедуры