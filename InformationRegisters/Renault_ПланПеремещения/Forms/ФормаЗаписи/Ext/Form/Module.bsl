&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийПользователь = ПараметрыСеанса.Пользователь;
	
	Право_РаботаСПланомПеремещений		= ПараметрыСеанса.Renault_ПраваПользователя.РаботатьСПланомПеремещений;
	Право_РедактироватьПланПеремещений	= ПараметрыСеанса.Renault_ПраваПользователя.ИзменятьПланПеремещений;
	
	//ДатаПлан	= ?(Параметры.Свойство("ДатаПлан"), Параметры.ДатаПлан, Дата(1,1,1));
	Заявка      = ?(Параметры.Свойство("Заявка"), Параметры.Заявка, Неопределено);
	ДатаВыдачи  = ?(Параметры.Свойство("ДатаПлан"), Параметры.ДатаПлан, Дата(1,1,1));
	Ссылка      = Заявка;
	
	Если ЗначениеЗаполнено(Заявка) И Право_РаботаСПланомПеремещений Тогда
		
		МенеджерЗаписи = РегистрыСведений.Renault_ПланПеремещения.СоздатьМенеджерЗаписи();
		
		//МенеджерЗаписи.ДатаПлан = ДатаПлан;
		
		//Если Заявка<>Неопределено Тогда
			МенеджерЗаписи.ПотребностьПеремещения = Заявка;
		//КонецЕсли;
		
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда
			ЗначениеВРеквизитФормы(МенеджерЗаписи, "Запись");
			Если (Запись.Ответственный <> ТекущийПользователь 
				ИЛИ Запись.Зарезервировано) 
				И НЕ Право_РедактироватьПланПеремещений Тогда
				
				ЭтаФорма.ТолькоПросмотр = Истина;
				
			КонецЕсли;
			ОтветственныйВЗаявке = Запись.Ответственный;
			ДопОборудованиеДоИзменения = Запись.ДопОборудование;
		Иначе
			Запись.ДатаПлан 		= ДатаВыдачи;
			Запись.Ответственный	= ТекущийПользователь;
			Запись.Продавец			= ТекущийПользователь;
		КонецЕсли;
		
		Элементы.ДеньНедели.Заголовок = ТРег(Формат(Запись.ДатаПлан, "ДФ='dd MMMM yyyy (dddd) HH:mm '"));
		
	Иначе
		
		Отказ = Истина;
		
		Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет прав на работу с планом перемещения.", ,,, Отказ);

		Возврат;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.Зарезервировано Тогда
		
		ТекущийОбъект.Автомобиль		= Неопределено;
		ТекущийОбъект.ДопОборудование	= Неопределено;
		ТекущийОбъект.ПНУ				= Неопределено;
		ТекущийОбъект.Контрагент		= Неопределено;
		ТекущийОбъект.СкладОтправитель	= Неопределено;
		ТекущийОбъект.СкладПолучатель	= Неопределено;
		ТекущийОбъект.Продавец			= Неопределено;
		
	Иначе
		
		Если ТекущийОбъект.Автомобиль.Пустая() Тогда
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан автомобиль.", Запись, "Запись.Автомобиль", Отказ);
		КонецЕсли;
	
		Если ТекущийОбъект.Контрагент.Пустая() Тогда
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан контрагент.", Запись, "Запись.Контрагент", Отказ);
		КонецЕсли;
	
		Если ТекущийОбъект.Продавец.Пустая() Тогда
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан продавец.", Запись, "Запись.Продавец", Отказ);
		КонецЕсли;
	
		Если ТекущийОбъект.СкладОтправитель.Пустая() Тогда
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан отправитель.", Запись, "Запись.СкладОтправитель", Отказ);
		КонецЕсли;
	
		Если ТекущийОбъект.СкладПолучатель.Пустая() Тогда
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан получатель.", Запись, "Запись.СкладПолучатель", Отказ);
		КонецЕсли;
	
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущийОбъект.ДатаЗаписи = ТекущаяДата();
	
	//Меняем признак наличия доп оборудования в заявке на перемещение
	Если ДопОборудованиеДоИзменения <> ТекущийОбъект.ДопОборудование Тогда
		ЗаявкаНаПеремещениеОбъект = ТекущийОбъект.ПотребностьПеремещения.ПолучитьОбъект();
		ЗаявкаНаПеремещениеОбъект.ДО = ТекущийОбъект.ДопОборудование;
		ЗаявкаНаПеремещениеОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры


