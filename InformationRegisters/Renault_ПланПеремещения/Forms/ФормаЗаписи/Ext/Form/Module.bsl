&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()
	
	ЕстьПравоНаПереносЗаявки = ПараметрыСеанса.Renault_ПраваПользователя.ПереносЧужихЗаявокНаПеремещение;
	ЕстьРасширенныеПраваНаПереносЗаявки = ПараметрыСеанса.Renault_ПраваПользователя.ПереносЧужихЗаявокНаПеремещениеРасширенныеПрава;
	
	ЕстьПравоРедактироватьРабочиеОтметки = ПараметрыСеанса.Renault_ПраваПользователя.РедактированиеПоляРабочиеОтметки;
	ЕстьРасширенныеПраваНаАннулированиеЗаявки = ПараметрыСеанса.Renault_ПраваПользователя.ПраваНаАннулированиеЗаявокРасширенные;
	
	ЗаписьЗарезервирована = Запись.Зарезервировано;
	
	Элементы.Зарезервировано.Видимость = Право_РедактироватьПланПеремещений;
	
	Элементы.Автомобиль.Видимость		= НЕ ЗаписьЗарезервирована;
	Элементы.Контрагент.Видимость		= НЕ ЗаписьЗарезервирована;
	Элементы.ДопОборудование.Видимость  = НЕ ЗаписьЗарезервирована;
	Элементы.ПНУ.Видимость				= НЕ ЗаписьЗарезервирована;
	Элементы.Продавец.Видимость			= НЕ ЗаписьЗарезервирована;
	Элементы.ГруппаМаршрут.Видимость	= НЕ ЗаписьЗарезервирована;
	
	Если Запись.Перемещено И НЕ ЕстьРасширенныеПраваНаАннулированиеЗаявки Тогда
		Элементы.ГруппаСистемные.ПодчиненныеЭлементы.Удалить.Доступность = Ложь;
	Иначе
		
		Если Запись.ДатаПлан <= КонецДня(ТекущаяДата()+24*60*60) Тогда
			Если НЕ ЕстьРасширенныеПраваНаПереносЗаявки И НЕ ЕстьРасширенныеПраваНаАннулированиеЗаявки Тогда
				Элементы.ГруппаСистемные.ПодчиненныеЭлементы.Удалить.Доступность = Ложь;
			КонецЕсли;
		Иначе
			Если Запись.Ответственный <> ТекущийПользователь И Не ЕстьПравоНаПереносЗаявки И НЕ ЕстьРасширенныеПраваНаПереносЗаявки И НЕ ЕстьРасширенныеПраваНаАннулированиеЗаявки Тогда
				Элементы.ГруппаСистемные.ПодчиненныеЭлементы.Удалить.Доступность = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.РабочиеОтметки.ТОлькоПросмотр = НЕ ЕстьПравоРедактироватьРабочиеОтметки;
	Элементы.Комментарий.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущиеДанныеАвтомобиля(ТекущийАвтомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(РезервОстатки.Контрагент,ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	|	НаСкладахОстатки.СкладКомпании
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&ДатаСрез, Автомобиль = &Автомобиль) КАК НаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Renault_АвтомобилиВРезерве.Остатки(&ДатаСрез, Автомобиль = &Автомобиль) КАК РезервОстатки
	|		ПО НаСкладахОстатки.Автомобиль = РезервОстатки.Автомобиль";
	
	Запрос.УстановитьПараметр("ДатаСрез", ТекущаяДата());
	Запрос.УстановитьПараметр("Автомобиль", ТекущийАвтомобиль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Склад,Контрагент", Выборка.Склад, Выборка.Контрагент);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВладельцаАвтомобиля(ТекущийАвтомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Автомобили.Ссылка
	//Исправить
	//|	Автомобили.ВладелецАвтомобиля
	|ИЗ
	|	Справочник.Автомобили КАК Автомобили
	|ГДЕ
	|	Автомобили.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ТекущийАвтомобиль);
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		ВладелецАвтомобиля = Результат.ВладелецАвтомобиля;
	КонецЦикла;
	Возврат ВладелецАвтомобиля;
	
КонецФункции

&НаКлиенте
Процедура ЗарезервированоПриИзменении(Элемент)
	
	ОбновитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Если ЭтаФорма.ТекущийЭлемент.Имя = "Удалить" Тогда
		НовоеВремяЗаписи = Дата(1,1,1);
		ЗаписатьИсториюПереносовЗаявки(НовоеВремяЗаписи);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьИсториюПереносовЗаявки(НовоеВремяЗаписи)
	
	ЗаписьВРегистр = РегистрыСведений.Renault_ИсторияПереносовЗаявокНаПеремещение.СоздатьМенеджерЗаписи();
	ЗаписьВРегистр.ЗаявкаНаПеремещение = Запись.ПотребностьПеремещения;
	ЗаписьВРегистр.СтараяДатаПередачи = Запись.ДатаПлан;
	ЗаписьВРегистр.НоваяДатаПередачи = НовоеВремяЗаписи;
	ЗаписьВРегистр.ОтветственныйЗаПеренос = ТекущийПользователь;
	ЗаписьВРегистр.Продавец = Запись.Ответственный;
	ЗаписьВРегистр.Период = ТекущаяДата();
	ЗаписьВРегистр.Записать();
	
КонецПроцедуры
