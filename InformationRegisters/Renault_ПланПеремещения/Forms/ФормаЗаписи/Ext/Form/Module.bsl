&НаКлиенте
Процедура АвтомобильНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("ОбработкаВыбора", 		Истина);
	ПараметрыОткрытия.Вставить("ВыборГруппИЭлементов",	ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыОткрытия.Вставить("МножественныйВыбор",	Ложь);
	ПараметрыОткрытия.Вставить("РазрешитьВыборКорня",	Ложь);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе",	Истина);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Период",					ТекущаяДата());
	ПараметрыОтбора.Вставить("ВНаличии",				Истина);
	ПараметрыОтбора.Вставить("Остальные",				Истина);
	
	ПараметрыОтбора.Вставить("Свободный",				Истина);
	ПараметрыОтбора.Вставить("ВРезерве",				Истина);
	ПараметрыОтбора.Вставить("НаРекламации",			Истина);
	
	ПараметрыОткрытия.Вставить("ПараметрыОтбора", 		ПараметрыОтбора);
	
	ОткрытьФормуМодально("Справочник.Автомобили.Форма.ФормаПодбора", ПараметрыОткрытия, Элементы.Автомобиль);
	
	АвтомобильПриИзменении(Элементы.Автомобиль);
	
КонецПроцедуры

&НаКлиенте
Процедура АвтомобильПриИзменении(Элемент)
	
	Если НЕ Запись.Автомобиль.Пустая() Тогда
		
		ДанныеАвтомобиля = ПолучитьТекущиеДанныеАвтомобиля(Запись.Автомобиль);
		Если ДанныеАвтомобиля = Неопределено Тогда
			Запись.Автомобиль = Неопределено;
			Запись.Контрагент = Неопределено;
			Предупреждение("Автомобиля нет в наличии",15);
		Иначе
			Запись.СкладОтправитель = ДанныеАвтомобиля.Склад;
			Запись.Контрагент = ПолучитьВладельцаАвтомобиля(Запись.Автомобиль);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

