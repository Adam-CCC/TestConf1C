
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийПользователь = ПараметрыСеанса.Пользователь;
	
	Право_РаботаСПланомПеремещений		= ПараметрыСеанса.Renault_ПраваПользователя.РаботатьСПланомПеремещений;
	Право_РедактироватьПланПеремещений	= ПараметрыСеанса.Renault_ПраваПользователя.ИзменятьПланПеремещений;
	
	Гл_НачалоИнтервала				= Дата(1,1,1,9,0,0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_КоличествоПеревозокВыдачВДеньСрезПоследних.Объект,
	|	Renault_КоличествоПеревозокВыдачВДеньСрезПоследних.КоличествоПеремещенийВыдач
	|ИЗ
	|	РегистрСведений.Renault_КоличествоПеревозокВыдачВДень.СрезПоследних(
	|			&Период,
	|			Объект = &Объект
	|				И КоличествоПеремещенийВыдач <> 0
	|				И НЕ ЭтоКоличествоДнейБлокировки) КАК Renault_КоличествоПеревозокВыдачВДеньСрезПоследних";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Объект", Перечисления.Renault_ОбъектДляУстановкиКоличестваПеремещенийВыдач.ПланПеремещений);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КоличествоПеремещений = Выборка.КоличествоПеремещенийВыдач;
	Иначе
		КоличествоПеремещений = 0;
	КонецЕсли;
	
	Гл_ИнтервалВМинутах = ?(КоличествоПеремещений>0,Цел(10*60/КоличествоПеремещений),60);
	Если КоличествоПеремещений>0 Тогда
		РабочийДеньВСекундах = Гл_ИнтервалВМинутах*КоличествоПеремещений*60;
		Гл_КонецИнтервала = Гл_НачалоИнтервала + РабочийДеньВСекундах-Гл_ИнтервалВМинутах*60;
	Иначе
		Гл_КонецИнтервала = Дата(1,1,1,18,0,0);
	КонецЕсли;
	
	НастройкиБлокировкиЗаписей = Неопределено;
	НастройкиБлокировкиЗаписей = ПолучитьНастройкиБлокировкиЗаписей();
	Если  НастройкиБлокировкиЗаписей <> Неопределено Тогда
	ВремяБлокировкиЗаписей = НастройкиБлокировкиЗаписей["Время"];
	КоличествоДнейБлокировки = НастройкиБлокировкиЗаписей["Количествоперемещений"]; 
	Иначе 
	ВремяБлокировкиЗаписей = Неопределено;
	КонецЕсли;
	Если ВремяБлокировкиЗаписей <> неопределено Тогда
		ДатаБлокировкиЗаписей = Дата(Год(ТекущаяДата()),Месяц(ТекущаяДата()),День(ТекущаяДата()), Час(ВремяБлокировкиЗаписей),Минута(ВремяБлокировкиЗаписей),00);
		Если ТекущаяДата() < ДатаБлокировкиЗаписей Тогда
			Гл_ИнтервалБлокировкиЗаписей = КонецДня(ТекущаяДата()+24*60*60*(КоличествоДнейБлокировки-1))-ТекущаяДата();//заблокировано доконца дня
		Иначе
			Гл_ИнтервалБлокировкиЗаписей = КонецДня(ТекущаяДата()+24*60*60*КоличествоДнейБлокировки)-ТекущаяДата();//заблокировано до конца следующего дня
		КонецЕсли;
	Иначе
		Гл_ИнтервалБлокировкиЗаписей	= 12*3600; //блокируются записи за 12 часов
	КонецЕсли;
	
	ТекстВремени = "
	|ВЫБРАТЬ
	|NULL КАК Часов,
	|NULL КАК Минут";
	
	ИндексВремя = Гл_НачалоИнтервала;
	Пока ИндексВремя <= Гл_КонецИнтервала Цикл
		ТекстВремени	= ТекстВремени + "
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		" + Час(ИндексВремя) + ",
		|		" + Минута(ИндексВремя);
		ИндексВремя	= ИндексВремя + гл_ИнтервалВМинутах * 60;
	КонецЦикла;
	
	ДинамическийСписок.ТекстЗапроса = СтрЗаменить(Гл_ТекстЗапроса, "//ТекстВремени", ТекстВремени);
	
	Пар_ТекущаяДата = НачалоДня(ТекущаяДата());
	Гл_ДатаНедели	= Пар_ТекущаяДата + 86400 *(1 - ДеньНедели(Пар_ТекущаяДата));
	
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ВыводимаяДата",	Пар_ТекущаяДата);
	ДинамическийСписок.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",		ТекущаяДата());
	
КонецПроцедуры

