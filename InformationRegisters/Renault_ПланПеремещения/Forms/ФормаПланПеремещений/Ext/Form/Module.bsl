&НаКлиенте

Процедура ДинамическийСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	РежимВыбораВремени = Ложь;
	
	Если ЭтаФорма.ВладелецФормы <> Неопределено Тогда
		
		Если ЭтаФорма.ВладелецФормы.ТекущийЭлемент.Имя = "ДинамическийСписок" Тогда
			РежимВыбораВремени = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеСтроки = Элементы.ДинамическийСписок.ДанныеСтроки(ВыбраннаяСтрока);
	
	//добавим возможность планировать в обход времени блокировки записей, в основном нужно для Москвы
	ЕстьПраво_СоздаватьЗаписьВОбходВремениБлокировкиЗаписей = ПараметрыСеанса.Renault_ПраваПользователя.СоздаватьЗаписьВОбходВремениБлокировкиЗаписей;
	Если ДанныеСтроки.Время >= ТекущаяДата() + Гл_ИнтервалБлокировкиЗаписей ИЛИ (ЕстьПраво_СоздаватьЗаписьВОбходВремениБлокировкиЗаписей И ДанныеСтроки.Время >= ТекущаяДата()) Тогда
		
		Если РежимВыбораВремени Тогда
			
			Если ДанныеСтроки.ЭтоЗапись Тогда
				Если ДанныеСтроки.ЗаписьЗаблокирована Тогда
					Сообщить("Нельзя сформировать заявку на это время! Запись заблокирована!!!", СтатусСообщения.ОченьВажное);
				Иначе
					Сообщить("Нельзя сформировать несколько заявок на одно время!!", СтатусСообщения.ОченьВажное);
				КонецЕсли;
				Возврат;
			Иначе 
				Закрыть(Новый Структура("ДатаПеремещения,Ответственный", ДанныеСтроки.Время, ТекущийПользователь));
			КонецЕсли;
			
		Иначе
			
			Если ДанныеСтроки.ЭтоЗапись Тогда//И
				//(ДанныеСтроки.Зарезервировано ИЛИ
				Если ДанныеСтроки.Ответственный <> ТекущийПользователь//)
					И НЕ Право_РедактироватьПланПеремещений Тогда
					Предупреждение("У вас нету права на изменение плана перемещений!", 15);
				ИначеЕсли НЕ Право_РаботаСПланомПеремещений Тогда
					Предупреждение("У вас нету права на работу с планом перемещений!", 15);
				ИначеЕсли ДанныеСтроки.ЗаписьЗаблокирована Тогда
					Предупреждение("Нельзя сформировать заявку на это время! Запись заблокирована!!!", 15);
				Иначе
					ПараметрыОткрытия = Новый Структура("ДатаПлан,Заявка", ДанныеСтроки.Время, ДанныеСтроки.ЗаявкаНаПеремещение);
					ОткрытьФормуМодально("РегистрСведений.Renault_ПланПеремещения.Форма.ФормаЗаписи", ПараметрыОткрытия);
					ОбновлениеДинамическихДанных();
				КонецЕсли;
				
			Иначе
				
				ДатаПоступления = Формат(Дата(Год(ДанныеСтроки.Время), Месяц(ДанныеСтроки.Время), День(ДанныеСтроки.Время)));
				ВремяПоступления = Дата(1,1,1, Час(ДанныеСтроки.Время), Минута(ДанныеСтроки.Время), Секунда(ДанныеСтроки.Время));
				ПараметрыОткрытия = Новый Структура("ЖелаемаяДатаПеремещения,ВремяПоступления, Продавец", ДатаПоступления, ВремяПоступления, ТекущийПользователь);
				Форма = ПолучитьФорму("Документ.Renault_ПотребностьПеремещения.Форма.ФормаДокумента");
				Форма.ЖелаемаяДатаПеремещения = ДатаПоступления;
				Форма.ВремяПоступления = ВремяПоступления;
				Форма.Открыть();
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Если ДанныеСтроки.ЭтоЗапись Тогда
			
			ПараметрыОткрытия = Новый Структура("ДатаПлан,Заявка", ДанныеСтроки.Время, ДанныеСтроки.ЗаявкаНаПеремещение);
			ОткрытьФормуМодально("РегистрСведений.Renault_ПланПеремещения.Форма.ФормаЗаписи", ПараметрыОткрытия);
			ОбновлениеДинамическихДанных();
			
		Иначе
			
			Предупреждение("Данные запрещены для изменения!", 15);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

