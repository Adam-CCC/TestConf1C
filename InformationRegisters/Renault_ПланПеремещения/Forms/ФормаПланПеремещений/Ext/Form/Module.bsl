//общая процедура отработки нажатия на выбор даты недели
&НаКлиенте
Процедура ВыбранДеньНедели(НомерДня)
	
	Пар_ТекущаяДата = Гл_ДатаНедели + (НомерДня - 1) * 86400;
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

//процедуры по работе с динамическими данными +++
&НаКлиенте
Функция ПолучитьТекстДняНедели(НомерДня)
	
	Если НомерДня = 1 Тогда
		Возврат "Понедельник";
	ИначеЕсли НомерДня = 2 Тогда
		Возврат "Вторник";
	ИначеЕсли НомерДня = 3 Тогда
		Возврат "Среда";
	ИначеЕсли НомерДня = 4 Тогда
		Возврат "Четверг";
	ИначеЕсли НомерДня = 5 Тогда
		Возврат "Пятница";
	ИначеЕсли НомерДня = 6 Тогда
		Возврат "Суббота";
	Иначе
		Возврат "Воскресенье";
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СформироватьНадписиДней()
	
	текДеньНедели = ДеньНедели(Пар_ТекущаяДата);
	
	Для текДН = 1 ПО 7 Цикл
		
		ИмяЭлементаДата		= "ДатаДня_Д" + текДН;
		текДата				= Гл_ДатаНедели + 86400 *(ДеньНедели(Гл_ДатаНедели) + текДН - 2);
		//значение даты
		ЭтаФорма[ИмяЭлементаДата] = текДата;
		
		//настройки элемента даты
		Если текДН = текДеньНедели Тогда
			Элементы[ИмяЭлементаДата].ЦветТекста	= Новый Цвет;
			Элементы[ИмяЭлементаДата].ЦветФона		= WebЦвета.ЗеленоватоЛимонный;
		Иначе 
			Элементы[ИмяЭлементаДата].ЦветТекста	= WebЦвета.Черный;
			Элементы[ИмяЭлементаДата].ЦветФона		= Новый Цвет;
		КонецЕсли;
		//элемент количество записей на эту дату
		ИмяЭлементаЗаписи		= "Декорация_Записи_Д" + текДН;
		ИмяЭлементаИндикатор    = "ИндикаторЗаполненности_Д" + текДН;
		
		//найдем количество записей
		поискСтроки = Гл_ТаблицаКоличествоЗаписей.НайтиСтроки(Новый Структура("Дата", текДата));
		КолФакт = 0;
		КолПлан = 0;
		
		Если поискСтроки.Количество() Тогда
			КолФакт = поискСтроки[0].КоличествоФакт;
			КолПлан = поискСтроки[0].КоличествоПлан;
		КонецЕсли;
		
		//изменим текст заголовка количествая записи
		Элементы[ИмяЭлементаЗаписи].Заголовок = Строка(КолФакт) + "/" + Строка(КолПлан);
		//теперь изменим индикатор
		Элементы[ИмяЭлементаИндикатор].МаксимальноеЗначение = КолПлан;
		ЭтаФорма[ИмяЭлементаИндикатор]						= КолФакт;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеДинамическихДанных()
	
	ЗаполнитьРасписаниеПеремещений();
	ЗаполнитьТаблицуКоличествоЗаписей();
	
	СформироватьНадписиДней();
	
	текДата = ТекущаяДата();
	
	ПараметрыДинСписка = ДинамическийСписок.Параметры;
	
	ПараметрыДинСписка.УстановитьЗначениеПараметра("ВыводимаяДата",			Пар_ТекущаяДата);
	ПараметрыДинСписка.УстановитьЗначениеПараметра("ТекущаяДата",			текДата);
	ПараметрыДинСписка.УстановитьЗначениеПараметра("ДатаЗапретаИзменения",	текДата + Гл_ИнтервалБлокировкиЗаписей);
	Элементы.ДинамическийСписок.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРасписаниеПеремещений()
	
	Гл_НачалоИнтервала = Дата(1,1,1,9,0,0);
	КоличествоПеремещений = 0;
	ВремяБлокировкиЗаписей = Неопределено;
	ПолучитьКоличествоПеремещенийВремяБлокировки(КоличествоПеремещений, ВремяБлокировкиЗаписей, Пар_ТекущаяДата);
	
	Гл_ИнтервалВМинутах = ?(КоличествоПеремещений > 0, Цел(10*60/КоличествоПеремещений), 60);
	Если КоличествоПеремещений > 0 Тогда
		РабочийДеньВСекундах = Гл_ИнтервалВМинутах * КоличествоПеремещений * 60;
		Гл_КонецИнтервала = Гл_НачалоИнтервала + РабочийДеньВСекундах - Гл_ИнтервалВМинутах * 60;
	Иначе
		Гл_КонецИнтервала = Дата(1,1,1,18,0,0);
	КонецЕсли;
	
	НастройкиБлокировкиЗаписей = Неопределено;
	НастройкиБлокировкиЗаписей = ПолучитьНастройкиБлокировкиЗаписей();
	Если НастройкиБлокировкиЗаписей <> Неопределено Тогда
		ВремяБлокировкиЗаписей = НастройкиБлокировкиЗаписей["Время"];
		КоличествоДнейБлокировки = НастройкиБлокировкиЗаписей["Количествоперемещений"]; 
	Иначе 
		ВремяБлокировкиЗаписей = Неопределено;
	КонецЕсли;
	Если ВремяБлокировкиЗаписей <> неопределено Тогда
		ДатаБлокировкиЗаписей = Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), День(ТекущаяДата()), Час(ВремяБлокировкиЗаписей), Минута(ВремяБлокировкиЗаписей), 00);
		Если ТекущаяДата()< ДатаБлокировкиЗаписей Тогда
			Гл_ИнтервалБлокировкиЗаписей = КонецДня(ТекущаяДата()+24*60*60*(КоличествоДнейБлокировки-1))-ТекущаяДата();//заблокировано доконца дня
		Иначе
			Гл_ИнтервалБлокировкиЗаписей = КонецДня(ТекущаяДата()+24*60*60*КоличествоДнейБлокировки)-ТекущаяДата();//заблокировано до конца следующего дня
		КонецЕсли;
	Иначе
		Гл_ИнтервалБлокировкиЗаписей = 12*3600; //блокируются записи за 12 часов
	КонецЕсли;
	
	ТекстВремени = "
	|ВЫБРАТЬ
	|NULL КАК Часов,
	|NULL КАК Минут";
	
	ИндексВремя = Гл_НачалоИнтервала;
	Пока ИндексВремя <= Гл_КонецИнтервала Цикл
		ТекстВремени = ТекстВремени + "
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		" + Час(ИндексВремя) + ",
		|		" + Минута(ИндексВремя);
		ИндексВремя = ИндексВремя + гл_ИнтервалВМинутах * 60;
	КонецЦикла;
	
	ДинамическийСписокИзменитьТекстЗапроса(Гл_ТекстЗапроса, ТекстВремени);
	
КонецПроцедуры

&НаСервере
Процедура ДинамическийСписокИзменитьТекстЗапроса(Гл_ТекстЗапроса, ТекстВремени)
	
	ДинамическийСписок.ТекстЗапроса = СтрЗаменить(Гл_ТекстЗапроса, "//ТекстВремени", ТекстВремени);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьКоличествоПеремещенийВремяБлокировки(КоличествоПеремещений, ВремяБлокировкиЗаписей, Пар_ТекущаяДата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_КоличествоПеревозокВыдачВДеньСрезПоследних.Объект,
	|	Renault_КоличествоПеревозокВыдачВДеньСрезПоследних.КоличествоПеремещенийВыдач
	|ИЗ
	|	РегистрСведений.Renault_КоличествоПеревозокВыдачВДень.СрезПоследних(
	|			&Период,
	|			Объект = &Объект
	|				И ЭтоКоличествоДнейБлокировки = ЛОЖЬ
	|				И КоличествоПеремещенийВыдач <> 0) КАК Renault_КоличествоПеревозокВыдачВДеньСрезПоследних";
	Запрос.УстановитьПараметр("Период", Пар_ТекущаяДата);
	Запрос.УстановитьПараметр("Объект", Перечисления.Renault_ОбъектДляУстановкиКоличестваПеремещенийВыдач.ПланПеремещений);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КоличествоПеремещений = Выборка.КоличествоПеремещенийВыдач;
	Иначе
		КоличествоПеремещений = 0;
	КонецЕсли;
	
	ВремяБлокировкиЗаписей = Константы.Renault_ВремяБлокировкиЗаписейПланПеремещений.Получить();
	
КонецПроцедуры // ПолучитьКоличествоПеремещенийВремяБлокировки()

&НаКлиенте
Процедура ЗаполнитьТаблицуКоличествоЗаписей()
	
	ДатаКонецНедели = Гл_ДатаНедели + 6 * 86400;
	ВсегоИнтервалов = (Гл_КонецИнтервала - Гл_НачалоИнтервала) / (Гл_ИнтервалВМинутах * 60) + 1;
	
	ФактТаблицаЗаписей = ПолучитьКоличествоЗаписейЗаПериод(Гл_ДатаНедели, ДатаКонецНедели, ВсегоИнтервалов);
	
	МоментПоиска = Строка(Новый УникальныйИдентификатор);
	СтарыйМоментПоиска = ?(Гл_ТаблицаКоличествоЗаписей.Количество(), Гл_ТаблицаКоличествоЗаписей[0].МоментПоиска, Неопределено);
	
	Гл_НадоОбновитьНадписи	= Ложь;
	
	//заполним таблицу по количеству записей по датам
	Для каждого текСтрока из ФактТаблицаЗаписей Цикл
		//если таблица пустая, то просто заполним
		Если СтарыйМоментПоиска = Неопределено Тогда
			СтрокаЗаписи	= Гл_ТаблицаКоличествоЗаписей.Добавить();
			Гл_НадоОбновитьНадписи = Истина;
		Иначе
			//попробуем найти эту запись, если она есть, то просто изменем момент поиска
			поискСтроки = Гл_ТаблицаКоличествоЗаписей.НайтиСтроки(Новый Структура("Дата,КоличествоФакт,КоличествоПлан", текСтрока.Дата, текСтрока.КоличествоФакт, текСтрока.КоличествоПлан));
			Если поискСтроки.Количество() Тогда
				СтрокаЗаписи = поискСтроки[0];
			Иначе
				//если не нашли, то добавим новую запись
				СтрокаЗаписи = Гл_ТаблицаКоличествоЗаписей.Добавить();
				//поставим флаг, что надо будет обновить надписи
				Гл_НадоОбновитьНадписи = Истина;
			КонецЕсли;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтрокаЗаписи, текСтрока);
		СтрокаЗаписи.МоментПоиска	= МоментПоиска;
	КонецЦикла;
	//теперь удалим старые записи, это чтобы таблица не пухла
	поискСтарыхЗаписей = Гл_ТаблицаКоличествоЗаписей.НайтиСтроки(Новый Структура("МоментПоиска", СтарыйМоментПоиска));
	Для каждого текСтрока ИЗ поискСтарыхЗаписей Цикл
		Гл_ТаблицаКоличествоЗаписей.Удалить(текСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоЗаписейЗаПериод(ДатаНачало,ДатаКонец, ВсегоИнтервалов)
	
	ТаблицаДат = Новый ТаблицаЗначений;
	ТаблицаДат.Колонки.Добавить("ДатаПлан", Новый ОписаниеТипов("Дата"));
	
	текДата = ДатаНачало;
	Пока текДата <= ДатаКонец Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДат.Добавить(), Новый Структура("ДатаПлан", текДата));
		текДата = текДата + 86400;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаДат.ДатаПлан КАК ДатаЗаписи
	|ПОМЕСТИТЬ ВТ_ТаблицаДат
	|ИЗ
	|	&ТаблицаДат КАК ТаблицаДат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаДат.ДатаЗаписи КАК Дата,
	|	ЕСТЬNULL(ВЗ_ПланПеремещений.КоличествоФакт, 0) КАК КоличествоФакт,
	|	&ВсегоИнтервалов КАК КоличествоПлан
	|ИЗ
	|	ВТ_ТаблицаДат КАК ВТ_ТаблицаДат
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			НАЧАЛОПЕРИОДА(ПланПеремещений.ДатаПлан, ДЕНЬ) КАК ДатаПлан,
	|			КОЛИЧЕСТВО(ПланПеремещений.ДатаПлан) КАК КоличествоФакт
	|		ИЗ
	|			РегистрСведений.Renault_ПланПеремещения КАК ПланПеремещений
	|		ГДЕ
	|			ПланПеремещений.ДатаПлан >= НАЧАЛОПЕРИОДА(&ДатаНачало,ДЕНЬ)
	|			И ПланПеремещений.ДатаПлан <= КОНЕЦПЕРИОДА(&ДатаКонец,ДЕНЬ)
	|			И (ПланПеремещений.Автомобиль <> ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
	|					ИЛИ ПланПеремещений.Зарезервировано = ИСТИНА
	|					ИЛИ ПланПеремещений.ЗаписьЗаблокирована = ИСТИНА)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			НАЧАЛОПЕРИОДА(ПланПеремещений.ДатаПлан, ДЕНЬ)) КАК ВЗ_ПланПеремещений
	|		ПО ВЗ_ПланПеремещений.ДатаПлан = ВТ_ТаблицаДат.ДатаЗаписи";
	
	Запрос.УстановитьПараметр("ТаблицаДат", 		ТаблицаДат);
	Запрос.УстановитьПараметр("ДатаНачало",			ДатаНачало);
	Запрос.УстановитьПараметр("ДатаКонец",			ДатаКонец);
	Запрос.УстановитьПараметр("ТекущаяДата",		ТекущаяДата());
	Запрос.УстановитьПараметр("ВсегоИнтервалов",	ВсегоИнтервалов);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Renault_ОбщегоНазначенияКлиентСервер.ПолучитьМассивСтруктурИзТаблицы(Результат, "Дата,КоличествоФакт,КоличествоПлан");
	
КонецФункции

&НаКлиенте
Процедура КомандаСоздатьПеремещения(Команда)
	
	Результат = СоздатьПеремещения();
	
	Если Результат.Количество() Тогда
		
		Форма = ПолучитьФорму("РегистрСведений.Renault_ПланПеремещения.Форма.ФормаСозданияПеремещений");
		
		Маршруты = Результат.Скопировать();
		Маршруты.Свернуть("СкладОтправитель, СкладПолучатель");
		Сч = 1;
		Для Каждого Строка Из Маршруты Цикл
			НоваяСтрока = Форма.Маршруты.Добавить();
			НоваяСтрока.Идентификатор = Сч;
			НоваяСтрока.Отправитель = Строка.СкладОтправитель;
			НоваяСтрока.Получатель = Строка.СкладПолучатель;
			НайденныеСтроки = Результат.НайтиСтроки(Новый Структура("СкладОтправитель, СкладПолучатель", Строка.СкладОтправитель, Строка.СкладПолучатель));
			Для Каждого Строка Из НайденныеСтроки Цикл
				НоваяСтрока = Форма.Перемещения1.Добавить();
				НоваяСтрока.Идентификатор = Сч;
				НоваяСтрока.Время = Строка.ДатаПлан;
				НоваяСтрока.Автомобиль = Строка.Автомобиль;
				НоваяСтрока.Заявка= Строка.ПотребностьПеремещения;
				НоваяСтрока.ВнутреннийНомер= Строка.ВнутреннийНомер;
			КонецЦикла;
			Сч = Сч + 1;
		КонецЦикла;
		
		Форма.Открыть();
		
	Иначе
		
		Сообщить("На текущий день перемещения не запланированы или документы перемещения уже созданы");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьПеремещения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланПеремещений.Автомобиль,
	|	ПланПеремещений.ДатаПлан,
	|	ПланПеремещений.СкладОтправитель,
	|	ПланПеремещений.СкладПолучатель,
	|	ПланПеремещений.ПотребностьПеремещения,
	|	Renault_РазмещениеАвтомобилей.Место КАК ВнутреннийНомер
	|ИЗ
	|	РегистрСведений.Renault_ПланПеремещения КАК ПланПеремещений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РазмещениеАвтомобилей КАК Renault_РазмещениеАвтомобилей
	|		ПО ПланПеремещений.Автомобиль = Renault_РазмещениеАвтомобилей.Автомобиль
	|ГДЕ
	|	ПланПеремещений.ДатаПлан МЕЖДУ &НачПериода И &КонПериода
	|	И НЕ ПланПеремещений.Перемещено
	|	И ПланПеремещений.ДокументПеремещения = ЗНАЧЕНИЕ(Документ.ПеремещениеАвтомобилей.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("НачПериода", НачалоДня(Пар_ТекущаяДата));
	Запрос.УстановитьПараметр("КонПериода", КонецДня(Пар_ТекущаяДата));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура КомандаПеренестиЗаявкуНаПеремещение(Команда)
	
	ТекСтрока = ЭтаФорма.Элементы.ДинамическийСписок.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекСтрока.СозданДокументПеремещения Тогда
		Сообщить("По данной заявке уже сформирован документ перемещения!",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	ЕстьПравоНаПереносЗаявки = ПараметрыСеанса.Renault_ПраваПользователя.ПереносЧужихЗаявокНаПеремещение;
	ЕстьРасширенныеПраваНаПереносЗаявки = ПараметрыСеанса.Renault_ПраваПользователя.ПереносЧужихЗаявокНаПеремещениеРасширенныеПрава;
	
	Если ТекСтрока.Время <= КонецДня(ТекущаяДата()+24*60*60) Тогда
		Если НЕ ЕстьРасширенныеПраваНаПереносЗаявки Тогда
			Сообщить("Нет прав на перенос данной заявки!!!", СтатусСообщения.Важное);
			ВОзврат;
		КонецЕсли;
	Иначе
		Если ТекСтрока.Ответственный <> ТекущийПользователь И Не ЕстьПравоНаПереносЗаявки И НЕ ЕстьРасширенныеПраваНаПереносЗаявки Тогда
			Сообщить("Нет прав на перенос данной заявки!!!", СтатусСообщения.Важное);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	НовоеВремяЗаписи = ВыбратьВремяИзПланаПеремещений(ТекСтрока);
	Если НовоеВремяЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекСтрока.ЗаявкаНаПеремещение) Тогда
		ЗаявкаОбъект = ТекСтрока.ЗаявкаНаПеремещение.ПолучитьОбъект();
		ЗаявкаОбъект.ПеренестиЗаявку(ТекСтрока, НовоеВремяЗаписи);
	Иначе
		Сообщить("Заявка не зарегистрировна!");
	КонецЕсли;
	
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПраваПользователя(ТекущийПользователь, Настройка)
	
	ЕстьПравоНаПереносЗаявки = РегистрыСведений.ЗначениеНастроекПользователя.Получить(Новый Структура("Пользователь, Настройка", ТекущийПользователь, Настройка));
	Возврат ЕстьПравоНаПереносЗаявки;
	
КонецФункции

&НаКлиенте
Функция ВыбратьВремяИзПланаПеремещений(ТекСтрока)
	
	ФормаПланаПеремещений = РегистрыСведений.Renault_ПланПеремещения.ПолучитьФорму("ФормаПланПеремещений");
	ФормаПланаПеремещений.ВладелецФормы = ЭтаФорма;
	СтруктураВремяВстречиПлан = ФормаПланаПеремещений.ОткрытьМодально();
	
	Если СтруктураВремяВстречиПлан <> Неопределено Тогда
		
		ДатаВремяПеремещения = СтруктураВремяВстречиПлан.ДатаПеремещения;
		Ответственный = ТекущийПользователь;
		Возврат Новый Структура("ДатаВремяПеремещения, Ответственный", ДатаВремяПеремещения, Ответственный);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ВыбратьВремяИзПланаПеремещений()

&НаСервере
Функция ПолучитьНастройкиБлокировкиЗаписей()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_КоличествоПеревозокВыдачВДеньСрезПоследних.КоличествоПеремещенийВыдач,
	|	Renault_КоличествоПеревозокВыдачВДеньСрезПоследних.Дата
	|ИЗ
	|	РегистрСведений.Renault_КоличествоПеревозокВыдачВДень.СрезПоследних(
	|			&Период,
	|			Объект = &Объект
	|				И ЭтоКоличествоДнейБлокировки = ИСТИНА) КАК Renault_КоличествоПеревозокВыдачВДеньСрезПоследних";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Объект", Перечисления.Renault_ОбъектДляУстановкиКоличестваПеремещенийВыдач.ПланПеремещений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НастройкиБлокировкиЗаписей = Новый Структура;
		НастройкиБлокировкиЗаписей.Вставить("Время", Выборка.Дата);
		НастройкиБлокировкиЗаписей.Вставить("Количествоперемещений", Выборка.КоличествоПеремещенийВыдач);
		Возврат НастройкиБлокировкиЗаписей;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура КомандаОтчетПланПеремещений(Команда)
	
	Форма = ПолучитьФорму("Отчет.Renault_ПланПеремещений.Форма.ФормаОтчета");
	Форма.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаблокироватьЗапись(Команда)
	
	//сначала проверяем, нет ли заявки на это время
	//если есть заявка - то в любом случае блокировать нельзя
	//проверяем наличие прав
	ЕстьПравоНаБлокированиеЗаписи = ПараметрыСеанса.Renault_ПраваПользователя.БлокированиеЗаписейВПланеПеремещений;
	Если НЕ ЕстьПравоНаБлокированиеЗаписи Тогда
		Сообщить("Нет прав на блокирование записей в плане перемещений!!!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка ИЗ ЭтаФорма.Элементы.ДинамическийСписок.ВыделенныеСтроки Цикл
		ДанныеСтроки = ЭтаФорма.Элементы.ДинамическийСписок.ДанныеСтроки(Строка);
	Если ДанныеСтроки.ЭтоЗапись Тогда
		Если НЕ ЭтаФорма.Элементы.ДинамическийСписок.ТекущиеДанные.ЗаписьЗаблокирована Тогда
			Сообщить("На это время запланировано перемещение. Нельзя заблокировать запись!", СтатусСообщения.Важное);
		Иначе
			Сообщить("Эта запись уже заблокирована!!!", СтатусСообщения.Важное);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	НоваяЗаписьВРегистр                     = РегистрыСведений.Renault_ПланПеремещения.СоздатьМенеджерЗаписи();
	НоваяЗаписьВРегистр.ДатаПлан            = ДанныеСтроки.Время;
	НоваяЗаписьВРегистр.ЗаписьЗаблокирована = Истина;
	НоваяЗаписьВРегистр.Записать();
	КонецЦикла;
	
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРазблокироватьЗапись(Команда)
	
	//проверяем наличие прав
	ЕстьПравоНаБлокированиеЗаписи = ПараметрыСеанса.Renault_ПраваПользователя.БлокированиеЗаписейВПланеПеремещений;
	Если НЕ ЕстьПравоНаБлокированиеЗаписи Тогда
		Сообщить("Нет прав на блокирование записей в плане перемещений!!!", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка из  ЭтаФорма.Элементы.ДинамическийСписок.ВыделенныеСтроки Цикл
		ДанныеСтроки = ЭтаФорма.Элементы.ДинамическийСписок.ДанныеСтроки(Строка);
		Если НЕ ДанныеСтроки.ЭтоЗапись Или НЕ ДанныеСтроки.ЗаписьЗаблокирована Тогда
			Сообщить("Запись не заблокирована!!!", СтатусСообщения.Важное);
			Возврат;
		КонецЕсли;
		ЗаписьДляУдаления                     = РегистрыСведений.Renault_ПланПеремещения.СоздатьМенеджерЗаписи();
		ЗаписьДляУдаления.ДатаПлан            = ДанныеСтроки.Время;
		ЗаписьДляУдаления.ЗаписьЗаблокирована = Истина;
		ЗаписьДляУдаления.Прочитать();
		ЗаписьДляУдаления.Удалить();
	КонецЦикла;
	
	ОбновлениеДинамическихДанных();
	
КонецПроцедуры

// Откроем форму документа Заявки на перемещение для изменения комментария
&НаКлиенте
Процедура КомандаОткрытьЗаявку(Команда)
	
	ТекСтрока = ЭтаФорма.Элементы.ДинамическийСписок.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекСтрока.ЗаявкаНаПеремещение) Тогда
		ТекСтрока.ЗаявкаНаПеремещение.ПолучитьФорму().Открыть();
	Иначе
		Сообщить("Заявка не зарегистрирована!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаявкуНаВыдачу(Команда)
	
	ТекСтрока = ЭтаФорма.Элементы.ДинамическийСписок.ТекущиеДанные;
	Право_РаботатьСЖурналомВыдачи = ПараметрыСеанса.Renault_ПраваПользователя.РаботатьСЖурналомВыдачи;
	РабочийЛист = ПроверитьРезеревАвтомобиляПоКонтрагенту(ТекСтрока);
	
	Если РабочийЛист <> Неопределено Тогда
		
		Если Право_РаботатьСЖурналомВыдачи Тогда
		
			ВыбранныйАвтомобиль = ДиалогВыбораАвтомобиляДляВыдачи(РабочийЛист, ТекСтрока.Автомобиль);
			
			Если ЗначениеЗаполнено(ВыбранныйАвтомобиль) И НЕ ВыбранныйАвтомобиль.Автомобиль.Пустая() Тогда
				
				Если ПроверитьВыдачиАвтомобиля(ВыбранныйАвтомобиль)= Истина Тогда
					Возврат;
				КонецЕсли;
				
				ВыбранноеВремя = ДиалогВыбораВремениВыдачиАвтомобиля(ВыбранныйАвтомобиль.Территория);
				
				Если ВыбранноеВремя <> Неопределено И ТипЗнч(ВыбранноеВремя) = Тип("Структура") Тогда
					
					ДанныеЗаписи = Новый Структура;
					ДанныеЗаписи.Вставить("Территория", 	Неопределено);
					ДанныеЗаписи.Вставить("ДатаВыдачи",		Неопределено);
					ДанныеЗаписи.Вставить("РабочийЛист",	РабочийЛист);
					ДанныеЗаписи.Вставить("Автомобиль",		ВыбранныйАвтомобиль.Автомобиль);
					
					ВыбранноеВремя.Свойство("Территория",	ДанныеЗаписи.Территория);
					ВыбранноеВремя.Свойство("ДатаВыдачи",	ДанныеЗаписи.ДатаВыдачи);
					
					Если ЗначениеЗаполнено(ДанныеЗаписи.Территория) И ЗначениеЗаполнено(ДанныеЗаписи.ДатаВыдачи) Тогда
						
						ОткрытьФормуМодально("РегистрСведений.ЖурналВыдачи.Форма.ФормаЗаписи", ДанныеЗаписи);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У Вас нет прав на работу с журналом выдачи");
			
		КонецЕсли;
		
	Иначе
		
		Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Данный автомобиль не зарезервирован для указанного контрагента!");
		
	КонецЕсли;
	
 КонецПроцедуры

&НаСервере
Функция ПроверитьРезеревАвтомобиляПоКонтрагенту(ТекСтрока) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АвтомобилиВРезервеОстатки.Автомобиль,
	|	АвтомобилиВРезервеОстатки.ДокументРезерва,
	|	АвтомобилиВРезервеОстатки.Контрагент,
	|	АвтомобилиВРезервеОстатки.Территория,
	|	АвтомобилиВРезервеОстатки.РабочийЛист
	|ИЗ
	|	РегистрНакопления.Renault_АвтомобилиВРезерве.Остатки КАК АвтомобилиВРезервеОстатки
	|ГДЕ
	|	АвтомобилиВРезервеОстатки.Автомобиль = &Автомобиль
	|	И АвтомобилиВРезервеОстатки.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Автомобиль", ТекСтрока.Автомобиль);
	Запрос.УстановитьПараметр("Контрагент", ТекСтрока.Контрагент);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.РабочийЛист;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ДиалогВыбораАвтомобиляДляВыдачи(РабочийЛист, Автомобиль)
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("ТекстЗапроса",
	"ВЫБРАТЬ
	|	Renault_Территории.Ссылка КАК Территория,
	|	АвтомобилиВРезервеОстатки.Автомобиль,
	|	АвтомобилиВРезервеОстатки.Территория КАК ТекущаяТерритория
	|ИЗ
	|	РегистрНакопления.Renault_АвтомобилиВРезерве.Остатки(
	|			,
	|			РабочийЛист = &РабочийЛист
	|				И РабочийЛист <> ЗНАЧЕНИЕ(Документ.РабочийЛист.ПустаяСсылка)
	|				И Автомобиль = &Автомобиль) КАК АвтомобилиВРезервеОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Renault_Территории КАК Renault_Территории
	|		ПО (ИСТИНА)");
	
	ПолеВыбора = Новый Массив;
	ПолеВыбора.Добавить("Автомобиль");
	ПолеВыбора.Добавить("Территория");
	ПолеВыбора.Добавить("ТекущаяТерритория");
	ПараметрыОткрытия.Вставить("ПолеВыбора", ПолеВыбора);
	
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("РабочийЛист", РабочийЛист);
	ПараметрыЗапроса.Вставить("Автомобиль", Автомобиль);
	
	ПараметрыОткрытия.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	ПараметрыОткрытия.Вставить("ЗаголовокФормы", "Укажите автомобиль и территорию для выдачи");
	
	Возврат ОткрытьФормуМодально("ОбщаяФорма.СтатическаяФормаВыбора", ПараметрыОткрытия);
	
КонецФункции

&НаСервере
Функция ПроверитьВыдачиАвтомобиля(Автомобиль)
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	//Исправить
	"ВЫБРАТЬ
	|	ЖурналВыдачи.Автомобиль,
	|	ЖурналВыдачи.ДатаВыдачи,
	|	ЖурналВыдачи.Территория
	|ИЗ
	|	РегистрСведений.ЖурналВыдачи КАК ЖурналВыдачи
	|ГДЕ
	|	НЕ ЖурналВыдачи.Выдан
	|	И ЖурналВыдачи.Автомобиль = &Автомобиль";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль.Автомобиль);
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Отказ = Истина;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выдача данного автомобиля уже запланирована на " + Выборка.ДатаВыдачи + ". Территория - " + Выборка.Территория + ".");
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

&НаКлиенте
Функция ДиалогВыбораВремениВыдачиАвтомобиля(ТекущаяТерритория)
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Территория", ТекущаяТерритория);
	
	ПараметрыОткрытия.Вставить("ДанныеЗаполнения", ДанныеЗаполнения);
	
	Возврат ОткрытьФормуМодально("РегистрСведений.ЖурналВыдачи.Форма.ФормаЖурналВыдачи", ПараметрыОткрытия);
	
КонецФункции

