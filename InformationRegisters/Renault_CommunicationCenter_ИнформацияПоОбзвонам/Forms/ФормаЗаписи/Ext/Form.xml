		<Attribute name="ИсторияВзаимодействияПоКлиенту" id="3">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>История взаимодействия по клиенту</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Renault_CommunicationCenter_Обзвон.Ссылка,
	Renault_CommunicationCenter_Обзвон.Дата,
	Renault_CommunicationCenter_Обзвон.Клиент,
	Renault_CommunicationCenter_Обзвон.Исполнитель,
	Renault_CommunicationCenter_Обзвон.Недозвон,
	Renault_CommunicationCenter_Обзвон.СхемаОбзвона,
	Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Результат,
	Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Документ,
	Renault_CommunicationCenter_Обзвон.ФайлЗаписиРазговора
ИЗ
	Документ.Renault_CommunicationCenter_Обзвон КАК Renault_CommunicationCenter_Обзвон
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_CommunicationCenter_Обзвон.РезультатКоммуникации КАК Renault_CommunicationCenter_ОбзвонРезультатКоммуникации
		ПО Renault_CommunicationCenter_Обзвон.Ссылка = Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.Ссылка
			И (Renault_CommunicationCenter_ОбзвонРезультатКоммуникации.НомерСтроки = 1)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Renault_CommunicationCenter_СхемыОбзвона.Исполнители КАК Renault_CommunicationCenter_СхемыОбзвонаИсполнители
		ПО Renault_CommunicationCenter_Обзвон.СхемаОбзвона = Renault_CommunicationCenter_СхемыОбзвонаИсполнители.Ссылка
			И (ВЫБОР  
			    КОГДА &amp;РуководительОФУ 
			    	ТОГДА ИСТИНА
				КОГДА Renault_CommunicationCenter_СхемыОбзвонаИсполнители.Исполнитель ССЫЛКА Справочник.CRM_Отделы
					ТОГДА Renault_CommunicationCenter_СхемыОбзвонаИсполнители.Исполнитель В (&amp;Отдел)
				КОГДА Renault_CommunicationCenter_СхемыОбзвонаИсполнители.Исполнитель ССЫЛКА Справочник.ПодразделенияКомпании
					ТОГДА Renault_CommunicationCenter_СхемыОбзвонаИсполнители.Исполнитель = &amp;Подразделение
				ИНАЧЕ Renault_CommunicationCenter_СхемыОбзвонаИсполнители.Исполнитель = &amp;Пользователь
			КОНЕЦ)
ГДЕ
	Renault_CommunicationCenter_Обзвон.Проведен
	И Renault_CommunicationCenter_Обзвон.Клиент = &amp;Клиент
	И Renault_CommunicationCenter_Обзвон.СхемаОбзвона.Родитель В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.Renault_CommunicationCenter_СхемыОбзвона.Пролонгация))</QueryText>
