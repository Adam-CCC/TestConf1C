Процедура  ЗаписатьНвоыйКМ(КодМаркировки, Номенклатура) Экспорт 
	ОбъектШтрихКоды = Обработки.ШтрихКоды.Создать();
	СтруктураШтрихкода = ОбъектШтрихКоды.РазобратьСтрокуШтрихкодаGS1(КодМаркировки);
	Если СтруктураШтрихкода.Разобран Тогда
		Если ПустаяСтрока(СтруктураШтрихкода.ОписаниеОшибки) Тогда
			ПолныйКодМаркировки = КодДляDataMatrix(СтруктураШтрихкода);
			GTIN     = СтруктураШтрихкода.ДанныеШтрихкода["01"].Значение;
			Серийник = СтруктураШтрихкода.ДанныеШтрихкода["21"].Значение;
			
			МенеджерЗаписи = РегистрыСведений.КодыМаркировки.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.GTIN = СтруктураШтрихкода.ДанныеШтрихкода["01"].Значение;
			МенеджерЗаписи.СерийныйНомер = СтруктураШтрихкода.ДанныеШтрихкода["21"].Значение;
			Если СтруктураШтрихкода.ЭтоАСУ Тогда
				МенеджерЗаписи.Криптохвост = СтруктураШтрихкода.ДанныеШтрихкода["93"].Значение	
			Иначе
				МенеджерЗаписи.Криптохвост = СтруктураШтрихкода.ДанныеШтрихкода["91"].Значение + СтруктураШтрихкода.ДанныеШтрихкода["92"].Значение
			КонецЕсли;
			МенеджерЗаписи.Номенклатура = Номенклатура;
			МенеджерЗаписи.ВнутренняяМаркировка = СтруктураШтрихкода.ВнутренняяМаркировка;
			Если СтруктураШтрихкода.ВнутренняяМаркировка Тогда
				КодБезПриставкиSM = СтрШаблон("(01)%1(21)%2", GTIN, Серийник);
				МенеджерЗаписи.ВнешнийКодМаркировки = КодБезПриставкиSM;
				МенеджерЗаписи.ПолныйКодМаркировки = ПолныйКодМаркировки;		
			КонецЕсли;
			МенеджерЗаписи.Записать();
		Иначе
			Сообщить("Код разобрался с ошибкой: " + СтруктураШтрихкода.ОписаниеОшибки, СтатусСообщения.Ошибка)
		КонецЕсли;
	Иначе
		Сообщить("Неправильныый код маркировки", СтатусСообщения.Ошибка);
	КонецЕсли;
КонецПроцедуры 

Функция КодДляDataMatrix(Данные) Экспорт
	GS = Символ(29);
	
	Код = "01" + Данные["01"].Значение + "21" + Данные["21"].Значение;
	
	// Криптохвост: 91 и 92 у обычных кодов, 93 у АСУ
	Для Каждого AI Из СтрРазделить("91,92,93", ",") Цикл
		Часть = Данные.Получить(AI);
		Если Часть <> Неопределено Тогда
			Код = Код + GS + AI + СокрЛП(Часть.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если Данные.ВнутренняяМаркировка Тогда
		Код = "!SM!" + Код;
	КонецЕсли;
	
	Возврат Код;
КонецФункции