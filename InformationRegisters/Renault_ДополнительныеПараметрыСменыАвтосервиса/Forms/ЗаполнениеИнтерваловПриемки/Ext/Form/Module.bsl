Процедура ПериодРегистраРегулирование(Элемент, Направление, СтандартнаяОбработка) СформироватьИнтервалы() КонецПроцедуры

Процедура СформироватьИнтервалы(Перезаполнить=Ложь)
	
	ТаблОтметок=СобратьОтметки();
	Если Перезаполнить или ТаблОтметок.Количество()=0 Тогда //это вызов по кнопке "обновить" - перезаполнить ТаблицаРегистра из РегистраСведений
		Запрос=Новый Запрос("Выбрать Смена,ВремяНачала Из РегистрСведений.Renault_ДополнительныеПараметрыСменыАвтосервиса ГДЕ ДилерскийЦентр=&ДилерскийЦентр");
		Запрос.УстановитьПараметр("ДилерскийЦентр",ДилерскийЦентр);
		ТаблОтметок=Запрос.Выполнить().Выгрузить();
	КонецЕсли;	
	
	ПолучитьСмены(ТекущаяДата());
	СоотвСменИСтрок=Новый Соответствие;
	
	Элементы.ШиринаИнтервала.Заголовок="Масштаб: "+(ШиринаИнтервала-1)+"x";
	
	//очистка ТабличногоДокумента
	Интервалы.Очистить();
	Интервалы.Область("T").ЦветФона=ЦветаСтиля.ЦветФонаФормы;
	Элементы.Интервалы.ТекущаяОбласть=Интервалы.Область("R2C2");
	
	ТЗ=Смены.Выгрузить(,"Смена");
	ТЗ.Свернуть("Смена");
	МассивСмен=ТЗ.ВыгрузитьКолонку("Смена");
	МаксДлинаСтрСмены=0; Для Каждого Смена Из МассивСмен Цикл МаксДлинаСтрСмены=Макс(МаксДлинаСтрСмены,СтрДлина(Смена.Наименование)) КонецЦикла;
	МаксДлинаСтрСмены=МаксДлинаСтрСмены*0.7;
	
	//шкала времени
	ШиринаЭдиницыШкалы=30*(ШиринаИнтервала/Периодичность); //ширина 30 мин.
	//ШиринаЧаса=ШиринаИнтервала/Периодичность*60;
	//ШиринаЭдиницыШкалы=ШиринаЧаса/2;
	
	ТекПериод=ГраницаНачала;
	ВсегоЧасов=(ГраницаОкончания-ТекПериод)/3600;
	
	СплошнаяЛиния=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	ПунктирнаяЛиния=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Точечная,1);
	
	ТекКолонка=2;
	ТекПериод=ГраницаНачала;
	
	Интервалы.Область("R3").СоздатьФорматСтрок();
	//Интервалы.Область("R3C2:R3C60").СоздатьФорматСтрок();
	Интервалы.Область("R3C2").ШиринаКолонки=ШиринаЭдиницыШкалы/2;
	Интервалы.Область("R3C1").ШиринаКолонки=МаксДлинаСтрСмены; //ширина колонки смены
	Интервалы.Область("R2C1").ШиринаКолонки=МаксДлинаСтрСмены; //ширина колонки смены
	Интервалы.Область("R3").ВысотаСтроки=6;
	
	Пока (ТекПериод+Периодичность)<=ГраницаОкончания+30*60 Цикл
		
		Обл=Интервалы.Область("R2C"+Формат(ТекКолонка,"ЧГ=0"));
		Обл.Текст=ФорматВремени(ТекПериод);
		Обл.ШиринаКолонки=ШиринаЭдиницыШкалы;
		Обл.ГоризонтальноеПоложение=ГоризонтальноеПоложение.Центр;
		Обл.ВертикальноеПоложение=ВертикальноеПоложение.Центр;
		Обл.ГраницаСнизу=СплошнаяЛиния;
		
		Если ТекПериод<=ГраницаОкончания Тогда
			Обл=Интервалы.Область("R3C"+Формат(ТекКолонка+1,"ЧГ=0"));
			Обл.ШиринаКолонки=ШиринаЭдиницыШкалы;
			Обл.ГраницаСлева=?(Минута(ТекПериод)=30,ПунктирнаяЛиния,СплошнаяЛиния);
		КонецЕсли;	
		
		ТекКолонка=ТекКолонка+1;
		ТекПериод=ТекПериод+30*60;
		
	КонецЦикла;
	
	//смены
	ТекСтрока=5;
	Для Каждого Смена Из МассивСмен Цикл
		
		СоотвСменИСтрок.Вставить(ТекСтрока,Смена);
		
		Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C1").Текст=Смена;
		Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C1").ВертикальноеПоложение=ВертикальноеПоложение.Центр;
		//Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C2:R"+Формат(ТекСтрока,"ЧГ=0")+"C60").СоздатьФорматСтрок();
		Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")).СоздатьФорматСтрок();
		Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C2").ШиринаКолонки=ШиринаЭдиницыШкалы/2;
		Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C2").ВысотаСтроки=25;
		Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C1").ШиринаКолонки=МаксДлинаСтрСмены; //ширина колонки смены
		
		ТекКолонка=3;
		ТекПериод=ГраницаНачала;
		//Пока (ТекПериод+Периодичность*60)<=ГраницаОкончания Цикл
		Пока (ТекПериод+Периодичность*60/2)<=ГраницаОкончания Цикл 
			
			Обл=Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C"+Формат(ТекКолонка,"ЧГ=0"));
			//Обл.Текст=ТекКолонка;
			Обл.ШиринаКолонки=ШиринаИнтервала;
			
			//ищем отметку
			//ЕстьОтметка=ВхождениеИнтервала(Смена,ТекПериод);
			
			ЕстьОтметка=Ложь;
			Для Каждого СтрСмены Из ТаблОтметок.НайтиСтроки(Новый Структура("Смена",Смена)) Цикл
				Если (ТекПериод-СтрСмены.ВремяНачала)<Периодичность*60 И (СтрСмены.ВремяНачала+Периодичность-ТекПериод)<=Периодичность*60 Тогда 
					ЕстьОтметка=Истина;
					Прервать
				КонецЕсли;
			КонецЦикла;
			
			//если отметки нет определим рабочий/выходной
			Если ЕстьОтметка Тогда
				ЦветФона=ЦветАктивный;	
			Иначе
				ЕстьРабота=ВхождениеИнтервалаСмены(Смена,ТекПериод);
				ЦветФона=?(ЕстьРабота,ЦветРабочий,ЦветНеРабочий);
			КонецЕсли;
			
			Обл.ЦветФона=ЦветФона;
			
			Если ЕстьРабота Тогда
				Обл.ГраницаСверху=ПунктирнаяЛиния;
				Обл.ГраницаСнизу=ПунктирнаяЛиния;
				Обл.ГраницаСлева=ПунктирнаяЛиния;
				Обл.ГраницаСправа=ПунктирнаяЛиния;
			КонецЕсли;	
			
			ТекКолонка=ТекКолонка+1;
			ТекПериод=ТекПериод+Периодичность*60;	
		КонецЦикла;		
		
		ТекСтрока=ТекСтрока+2; //через строку
	КонецЦикла;	
	
	СоответствиеСменИСтрок=ЗначениеВСтрокуВнутр(СоотвСменИСтрок);
	
КонецПроцедуры	

Функция ФорматВремени(Время) Возврат Формат(Час(Время),"ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0")+":"+Формат(Минута(Время),"ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0") КонецФункции	

&НаКлиенте
Процедура ИнтервалыПриАктивизацииОбласти(Элемент)
	СвоВа=СвойстваЯчейки(Элемент.ТекущаяОбласть.Верх,Элемент.ТекущаяОбласть.Право);
	Если СвоВа=Неопределено Тогда Возврат КонецЕсли;
	СвоВа.Вставить("Рабочий",ВхождениеИнтервалаСмены(СвоВа.Смена,СвоВа.ВремяНачала));
	Элемент.ТекущаяОбласть.ЦветФона=?(Элемент.ТекущаяОбласть.ЦветФона=ЦветАктивный, ?(СвоВа.Рабочий,ЦветРабочий,ЦветНеРабочий), ЦветАктивный);
КонецПроцедуры

Функция СвойстваЯчейки(Верх,Право)
	Соотв=ЗначениеИзСтрокиВнутр(СоответствиеСменИСтрок);
	Смена=Соотв.Получить(Верх);
	Если Смена=Неопределено Тогда Возврат Неопределено КонецЕсли;
	
	нВремяНачала=ГраницаНачала+(Право-3)*Периодичность*60;
	нВремяОкончания=нВремяНачала+Периодичность*60;
	
	Если нВремяНачала<ГраницаНачала Или нВремяОкончания>ГраницаОкончания Тогда Возврат Неопределено КонецЕсли;
	
	Возврат Новый Структура("Смена,ВремяНачала,ВремяОкончания",Смена,нВремяНачала,нВремяОкончания)
КонецФункции	

Функция ВхождениеИнтервалаСмены(Смена,НачалоИнтервала)
	Для Каждого Стр Из Смены.НайтиСтроки(Новый Структура("Смена",Смена)) Цикл
		Если Стр.ВремяНачала<=НачалоИнтервала+Периодичность*60/2 И Стр.ВремяОкончания>=НачалоИнтервала+Периодичность*60/2 Тогда //середина интервала должна быть в границах
			Возврат Истина
		КонецЕсли;	
	КонецЦикла;
	Возврат Ложь
КонецФункции

Функция КорректировкаДатыОкончания(Дата) Возврат ?(Минута(Дата)=59,Дата+1,Дата) КонецФункции	

&НаКлиенте
Процедура кнСформировать(Команда) Записать() КонецПроцедуры
Процедура Записать()
	
	Записи=РегистрыСведений.Renault_ДополнительныеПараметрыСменыАвтосервиса.СоздатьНаборЗаписей();
	Записи.Прочитать();
	Записи.Очистить();
	Записи.Записать();
	
	//установка новых значений
	Для Каждого Стр Из СобратьОтметки() Цикл
		Запись=РегистрыСведений.Renault_ДополнительныеПараметрыСменыАвтосервиса.СоздатьМенеджерЗаписи();
		Запись.Смена=Стр.Смена;
		Запись.ДилерскийЦентр=ДилерскийЦентр;
		Запись.ВремяНачала=Стр.Период;
		Запись.ВремяОкончания=Стр.Период+Периодичность*60;
		Запись.Записать(Истина);
	КонецЦикла;	
	
КонецПроцедуры

Функция СобратьОтметки()
	ТЗ=Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Смена");
	ТЗ.Колонки.Добавить("Период");
	
	Если СоответствиеСменИСтрок="" Тогда Возврат ТЗ КонецЕсли; 
	СоотвСмен=ЗначениеИзСтрокиВнутр(СоответствиеСменИСтрок);
	ТекКолонка=3;
	ТекПериод=ГраницаНачала;
	Пока (ТекПериод+Периодичность*60/2)<=ГраницаОкончания Цикл
		Для Каждого Эл Из СоотвСмен Цикл
			Смена=Эл.Значение;
			ТекСтрока=Эл.Ключ;
			Обл=Интервалы.Область("R"+Формат(ТекСтрока,"ЧГ=0")+"C"+Формат(ТекКолонка,"ЧГ=0"));
			Если Обл.ЦветФона=ЦветАктивный Тогда
				Стр=ТЗ.Добавить();	
				Стр.Смена=Смена;
				Стр.Период=ТекПериод;
			КонецЕсли;	
		КонецЦикла;	
		ТекКолонка=ТекКолонка+1;
		ТекПериод=ТекПериод+Периодичность*60;
	КонецЦикла;
	
	Возврат ТЗ
КонецФункции	

&НаКлиенте
Процедура ИнтервалыВыбор(Элемент, Область, СтандартнаяОбработка)
	СвоВа=СвойстваЯчейки(Область.Верх,Область.Право);
	Если СвоВа=Неопределено Тогда 
		Соотв=ЗначениеИзСтрокиВнутр(СоответствиеСменИСтрок);
		Смена=Соотв.Получить(Область.Верх);
		Если Смена<>Неопределено Тогда ОткрытьЗначение(Смена) КонецЕсли;
	Иначе
		Сообщить("Смена "+СвоВа.Смена+", период с "+Формат(СвоВа.ВремяНачала,"ДЛФ=T")+" по "+Формат(СвоВа.ВремяОкончания,"ДЛФ=T"));		
	КонецЕсли;	
КонецПроцедуры
