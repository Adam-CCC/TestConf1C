Функция ПолучитьИсториюКомментариев(Заявка) Экспорт
	
	СтрокаИстория = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.МоментВремени КАК МоментВремени,
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.Заявка,
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.Автор,
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.СотрудникАвтора,
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.Сообщение
		|ИЗ
		|	РегистрСведений.DMS_КомментарииПоЗаявкамНаПовторнуюПечатьГТ КАК КомментарииЗаявкиНаПовторнуюПечатьГТ
		|ГДЕ
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.Заявка = &Заявка
		|
		|УПОРЯДОЧИТЬ ПО
		|	МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(СтрокаИстория) Тогда
			СтрокаИстория = СтрокаИстория + Символы.ПС;
		КонецЕсли;
		СтрокаИстория = СтрокаИстория
			+ Формат(МестноеВремя(Дата(1,1,1) + Выборка.МоментВремени / 1000), "ДФ='dd.MM.yy ЧЧ:мм'") + " "
			+ Выборка.Автор + " "
			+ Выборка.СотрудникАвтора + ": "
			+ Выборка.Сообщение;		
	КонецЦикла;
	
	Возврат СтрокаИстория;
КонецФункции

Функция ДобавитьКомментарий(Заявка, Комментарий) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.DMS_КомментарииПоЗаявкамНаПовторнуюПечатьГТ.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.МоментВремени = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МенеджерЗаписи.Заявка = Заявка;
	МенеджерЗаписи.Автор = Строка(Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь));
	МенеджерЗаписи.СотрудникАвтора = Строка(ПараметрыСеанса.Пользователь);
	МенеджерЗаписи.Сообщение = Комментарий;
	МенеджерЗаписи.Записать();
	
КонецФункции

Процедура ОтправитьКомментарии(Заявка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.МоментВремени КАК МоментВремени,
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.Автор как Дилер,
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.СотрудникАвтора как СотрудникДилера,
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.Сообщение
		|ИЗ
		|	РегистрСведений.DMS_КомментарииПоЗаявкамНаПовторнуюПечатьГТ КАК КомментарииЗаявкиНаПовторнуюПечатьГТ
		|ГДЕ
		|	КомментарииЗаявкиНаПовторнуюПечатьГТ.Заявка = &Заявка
		|
		|УПОРЯДОЧИТЬ ПО
		|	МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	
	ТаблицаКомментарии = Запрос.Выполнить().Выгрузить();
	
	ПараметрыЗаявки = Новый Структура;
	ПараметрыЗаявки.Вставить("Комментарии", ТаблицаКомментарии);
	ПараметрыЗаявки.Вставить("VIN", Заявка.ОбъектСогласования);
	
	ДанныеОтСервиса = Неопределено;
	ПакетДляПередачи = DMS_DataExchange.newPackage(ПараметрыЗаявки); 
	Результат = DMS_DataExchange.sendMessage
		(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),
		"ConsolidationHTTP",
		"DMS_GuaranteeDocs.ЗаписатьКомментарии",
		ПакетДляПередачи,
		ДанныеОтСервиса);
		
	Если Результат <> Истина или ДанныеОтСервиса = Ложь Тогда
		// что-то пошло не так, потом обработаем
		Возврат;
	КонецЕсли;		
	
	СостояниеЗаявки = ДанныеОтСервиса.Состояние;  
	
	ЗаявкаОбъект = Заявка.ПолучитьОбъект();
	Если СостояниеЗаявки = "На согласовании" Тогда
		ЗаявкаОбъект.Статус = Перечисления.DMS_СтатусыЗаявкиНаПовторнуюПечатьГТ.НаРассмотрении;
	ИначеЕсли СостояниеЗаявки = "Согласовано" Тогда
		ЗаявкаОбъект.Статус = Перечисления.DMS_СтатусыЗаявкиНаПовторнуюПечатьГТ.Согласовано;
	ИначеЕсли СостояниеЗаявки = "Не согласовано" Тогда
		ЗаявкаОбъект.Статус = Перечисления.DMS_СтатусыЗаявкиНаПовторнуюПечатьГТ.НеСогласовано;
	Иначе
		ЗаявкаОбъект.Статус = Перечисления.DMS_СтатусыЗаявкиНаПовторнуюПечатьГТ.НаСогласовании;
	КонецЕсли;
		
	ЗаявкаОбъект.Записать();
	
	Для Каждого ОдинКомментарий Из ДанныеОтСервиса.Комментарии Цикл
		МенеджерЗаписи = РегистрыСведений.DMS_КомментарииПоЗаявкамНаПовторнуюПечатьГТ.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.МоментВремени = ОдинКомментарий.МоментВремени;
		МенеджерЗаписи.Автор = ОдинКомментарий.Дилер;
		МенеджерЗаписи.СотрудникАвтора = ОдинКомментарий.СотрудникДилера;
		МенеджерЗаписи.Заявка = Заявка;
		МенеджерЗаписи.Сообщение = ОдинКомментарий.Сообщение;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

