Процедура ДобавитьЗапись(Параметры) Экспорт
	Если ЕстьАктивныйЭтап(Параметры.УникальныйИдентификатор) Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
	МенеджерЗаписи.Записать();	
КонецПроцедуры

Функция ПолучитьПараметры() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("УникальныйИдентификатор", 	);
	Параметры.Вставить("ТекущийСтатус"			,	);
	Параметры.Вставить("ЭтапЗавершен"			,	);
	Параметры.Вставить("ДатаЗавершения"			,	);
	Параметры.Вставить("НомерЭтапа"				,	);
	Параметры.Вставить("Период"					,	);
	Возврат Параметры;
КонецФункции

Процедура ЗаполнитьПараметрыПоУмолчанию(ПараметрыСогласованияДокументов,Параметры) Экспорт
	ЗначениеСвойства = "";
	Если Не ПараметрыСогласованияДокументов.Свойство("Документ",ЗначениеСвойства) ИЛИ Не ЗначениеЗаполнено(ЗначениеСвойства) Тогда 
		Возврат;
	КонецЕсли;
	Параметры.Период                	= ТекущаяДата();
	Параметры.УникальныйИдентификатор   = Строка(ЗначениеСвойства.УникальныйИдентификатор());
	Параметры.ТекущийСтатус             = Перечисления.SM_СтатусыСогласования.ВПроцессе;
	Параметры.ЭтапЗавершен				= Ложь;
	Параметры.ДатаЗавершения            = Дата(1,1,1);
	Параметры.НомерЭтапа				= 1;	
КонецПроцедуры

Функция ЕстьАктивныйЭтап(УникальныйИдентификатор) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SM_ЭтапСогласованияСрезПоследних.Период КАК Период,
		|	SM_ЭтапСогласованияСрезПоследних.УникальныйИдентификатор КАК УникальныйИдентификатор,
		|	SM_ЭтапСогласованияСрезПоследних.ТекущийСтатус КАК ТекущийСтатус,
		|	SM_ЭтапСогласованияСрезПоследних.ЭтапЗавершен КАК ЭтапЗавершен,
		|	SM_ЭтапСогласованияСрезПоследних.ДатаЗавершения КАК ДатаЗавершения,
		|	SM_ЭтапСогласованияСрезПоследних.НомерЭтапа КАК НомерЭтапа
		|ИЗ
		|	РегистрСведений.SM_ЭтапСогласования.СрезПоследних(&ТекущаяДата, Выразить(УникальныйИдентификатор Как Строка(100)) = Выразить(&УникальныйИдентификатор Как Строка(100))) КАК SM_ЭтапСогласованияСрезПоследних";
	
	Запрос.УстановитьПараметр("УникальныйИдентификатор", УникальныйИдентификатор);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат Ложь;                                                                 
	Иначе
		ТекущаяЗапись = РезультатЗапроса[0];
		Если Не ТекущаяЗапись.ЭтапЗавершен Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли
КонецФункции                                                                                     
                                
Функция ПолучитьТекущийЭтап(УникальныйИдентификатор) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	SM_ЭтапСогласованияСрезПоследних.Период КАК Период,
	|	SM_ЭтапСогласованияСрезПоследних.УникальныйИдентификатор КАК УникальныйИдентификатор,
	|	SM_ЭтапСогласованияСрезПоследних.ТекущийСтатус КАК ТекущийСтатус,
	|	SM_ЭтапСогласованияСрезПоследних.ЭтапЗавершен КАК ЭтапЗавершен,
	|	SM_ЭтапСогласованияСрезПоследних.ДатаЗавершения КАК ДатаЗавершения,
	|	SM_ЭтапСогласованияСрезПоследних.НомерЭтапа КАК НомерЭтапа
	|ИЗ
	|	РегистрСведений.SM_ЭтапСогласования.СрезПоследних(&ТекущаяДата, Выразить(УникальныйИдентификатор Как Строка(100)) = Выразить(&УникальныйИдентификатор Как Строка(100))) КАК SM_ЭтапСогласованияСрезПоследних";
	
	Запрос.УстановитьПараметр("УникальныйИдентификатор", УникальныйИдентификатор);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ПараметрыТекущийЭтап = ПолучитьПараметры();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат ПараметрыТекущийЭтап;
	Иначе
		ТекущийЭтап = РезультатЗапроса[0];
		//Если Не ТекущийЭтап.ЭтапЗавершен Тогда
			ЗаполнитьЗначенияСвойств(ПараметрыТекущийЭтап,ТекущийЭтап);
		//КонецЕсли;
		Возврат ПараметрыТекущийЭтап;
	КонецЕсли;
КонецФункции

Функция ПолучитьНомерТекущегоЭтапа(УникальныйИдентификатор) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SM_ЭтапСогласованияСрезПоследних.НомерЭтапа КАК НомерЭтапа
		|ИЗ
		|	РегистрСведений.SM_ЭтапСогласования.СрезПоследних(&ТекущаяДата, Выразить(УникальныйИдентификатор Как Строка(100)) = Выразить(&УникальныйИдентификатор Как Строка(100))) КАК SM_ЭтапСогласованияСрезПоследних";
	
	Запрос.УстановитьПараметр("УникальныйИдентификатор", УникальныйИдентификатор);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат 0;
	Иначе
		НомерЭтапа = РезультатЗапроса[0].НомерЭтапа; 
		Возврат НомерЭтапа;
	КонецЕсли;
КонецФункции

Процедура ИзменитьЗапись(Параметры) Экспорт
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
		МенеджерЗаписи.Записать();
	КонецЕсли;
КонецПроцедуры