&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;
	
	Форма =  ПолучитьФорму("РегистрСведений.Renault_РабочиеЛисты.Форма.ФормаВнешнихПоврежденийКузова");//ПолучитьФорму("Документ.Renault_CRM_ПриемкаАвтомобиля.Форма.ФормаВнешнихПоврежденийОсновная");
	
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		
		Если ВыбраннаяСтрока.ИмяГруппировки = "Автомобиль" Тогда
			
			Форма.Авто = ВыбраннаяСтрока.Ключ;
			Форма.Заявка  = 
				Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту(
				"Обращение", ВыбраннаяСтрока.РодительскаяГруппировка.Ключ);
			
		ИначеЕсли ВыбраннаяСтрока.ИмяГруппировки = "Обращение" Тогда
			
			Форма.Авто = ВыбраннаяСтрока.Ключ.Автомобиль;
			Форма.Заявка  = 
				Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту(
				"Обращение", ВыбраннаяСтрока.Ключ);
			
		Иначе
			
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		Форма.Авто = ВыбраннаяСтрока.Автомобиль;
		Форма.Заявка  = Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту("Обращение", ВыбраннаяСтрока.Обращение);
		
	КонецЕсли;
	
//	Форма.ДоступныДополнительныеКнопки = Истина;
	
	Форма.ОткрытьМодально();
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	
КонецПроцедуры
