
Процедура ПриЗаписи(Отказ, Замещение)
	
	Узел = Неопределено;
	Выборка = ПланыОбмена.Renault_Автосервис.Выбрать();
	ЭтаБаза = ПланыОбмена.Renault_Автосервис.ЭтотУзел();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> ЭтаБаза Тогда
			Узел = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Если Узел <> Неопределено Тогда
		ВидРемонта = Отбор.ВидРемонта.Значение;
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, ВидРемонта);
	КонецЕсли;
	
КонецПроцедуры
