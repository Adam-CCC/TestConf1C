
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//СтандартнаяОбработка = Истина;
	ОповеститьОВыборе(Новый Структура("ПГ, Сумма", Элементы.Список.ТекущиеДанные.ПредложениеПГ, Элементы.Список.ТекущиеДанные.Сумма));
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Модель") Тогда
		Список.Параметры.УстановитьЗначениеПараметра("Модель", Параметры.Модель);
		ЭтаФорма.Заголовок = "Предложения продленной гарантии по модели " + Параметры.Модель; 
	КонецЕсли;
	
КонецПроцедуры
