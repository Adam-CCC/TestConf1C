Функция ЗаписатьТовары(ТаблицаТоваров) Экспорт
	
	Попытка
		ТаблицаЗаказов = ТаблицаТоваров.Скопировать(,"ЗаказНаряд");
		ТаблицаЗаказов.Свернуть("ЗаказНаряд");
		
		ЗаказНаряд = ТаблицаЗаказов[0].ЗаказНаряд;
		
		НЗ = СоздатьНаборЗаписей();
		НЗ.Отбор.ЗаказНаряд.Установить(ЗаказНаряд);
		НЗ.Прочитать();
		
		НЗ.Загрузить(ТаблицаТоваров);
		НЗ.Записать();
	
		Возврат Истина;
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура ОбновитьТовары(ТаблицаТоваров, ЗаказНарядСсылка = Неопределено) Экспорт
	
	ТаблицаЗаказов = ТаблицаТоваров.Скопировать(,"ЗаказНаряд");
	ТаблицаЗаказов.Свернуть("ЗаказНаряд");
	
	//%+ Дата изменения - 16.07.2012 9:59:40; Автор - Окипний Андрей Евгеньевич
	//
	// Описание изменений
	// Корректировка записи пустых наборов
	//
	//%-
	
	////$+ Комментарий 
	// Дата создания - 16.07.2012 10:00:24;
	// Автор - Окипний Андрей Евгеньевич
	// В таблице с записями может не быть строк, из-за чего нет возможности выбрать 
	// ЗаказНаряд. Для таких случаев передаем заказ наряд отдельной переменной.
	//
	//$-
	
	Если ТаблицаЗаказов.Количество() > 0 тогда
		
		ЗаказНаряд = ТаблицаЗаказов[0].ЗаказНаряд;
		
	Иначе
		
		ЗаказНаряд = ЗаказНарядСсылка;
		
	КонецЕсли;
	
	НЗ = СоздатьНаборЗаписей();
	НЗ.Отбор.ЗаказНаряд.Установить(ЗаказНаряд);
	НЗ.Прочитать();
	
	НЗ.Загрузить(ТаблицаТоваров);
	НЗ.Записать();
	
КонецПроцедуры

Процедура УдалитьЗаписиПоЗаказНаряду(ЗаказНаряд) Экспорт
	
	НЗ = СоздатьНаборЗаписей();
	НЗ.Отбор.ЗаказНаряд.Установить(ЗаказНаряд);
	
	НЗ.Прочитать();
	
	Если НЗ.Количество() > 0 тогда
		
		НЗ.Очистить();
		НЗ.Записать();
		
	КонецЕсли;
	
КонецПроцедуры