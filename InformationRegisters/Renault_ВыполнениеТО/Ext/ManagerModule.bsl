Функция ПолучитьПредыдущийТО(Автомобиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_ВыполнениеТОСрезПоследних.ЗаказНаряд,
	|	Renault_ВыполнениеТОСрезПоследних.ДатаФакт
	|ИЗ
	|	РегистрСведений.Renault_ВыполнениеТО.СрезПоследних КАК Renault_ВыполнениеТОСрезПоследних
	|ГДЕ
	|	Renault_ВыполнениеТОСрезПоследних.Автомобиль = &Автомобиль
	|	И Renault_ВыполнениеТОСрезПоследних.ДатаФакт <> ДАТАВРЕМЯ(1, 1, 1)
	|	И Renault_ВыполнениеТОСрезПоследних.ДатаФакт <= &ТекущаяДата";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
//	запрос.УстановитьПараметр("ДатаПлан", НачалоДня(ТекущаяДата()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда		
		Возврат Выборка.ДатаФакт;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции