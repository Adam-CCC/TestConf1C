	ОбъектТек = ЭтотОбъект.Отбор.Объект.Значение;
	
 	Для каждого Запись Из ЭтотОбъект Цикл
		Если Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Знач1 = СокрЛП(Знач1 +" "+ Запись.Представление);
		КонецЕсли;
  	КонецЦикла; 
	
	Если Не обЗначениеНеЗаполнено(Знач1) Тогда
		НовЗапись = РегистрыСведений.ПротоколДействийПользователя.СоздатьМенеджерЗаписи();
