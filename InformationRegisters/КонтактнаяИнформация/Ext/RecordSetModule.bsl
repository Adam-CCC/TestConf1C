		НовЗапись.Пользователь = ПараметрыСеанса.Пользователь;
		НовЗапись.Содержание = Знач1; 
		НовЗапись.Объект = ОбъектТек;
		Попытка
			НовЗапись.Записать(Ложь);
		Исключение
			//
 		КонецПопытки; 
 	КонецЕсли;
 
КонецПроцедуры
