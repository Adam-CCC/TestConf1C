Процедура Renault_ЗаполнитьПоУмолчанию() Экспорт
		
	Макет = РегистрыСведений.Renault_КодировкиТО.ПолучитьМакет("Макет");
	
	ТЗ = Renault_АвтосервисОбщий.Renault_МакетВТаблицуЗначений(Макет);
	
	//Сообщить("уже готово");
		
			
	Набор = РегистрыСведений.Renault_КодировкиТО.СоздатьНаборЗаписей();
	Набор.Прочитать();
	Набор.Очистить();
	Набор.Записать();
	
	Для Каждого Строка ИЗ ТЗ Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ТипТО) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Запись = РегистрыСведений.Renault_КодировкиТО.СоздатьМенеджерЗаписи();
		Запись.АртикулРаботы = Строка.Код;
		
		ВидТО = Перечисления.Renault_ВидыТО[Строка.ТипТО];
		
		Запись.ВидТО = ВидТО;
		
		Если Найти(Строка.НаименованиеRU, "Стандартное") Тогда
			
			Запись.ЭтоКомплексСервис = Ложь;
			
		Иначе
			
			Запись.ЭтоКомплексСервис = Истина;
			
		КонецЕсли;
		
		Запись.Наименование = Строка.НаименованиеRU;
		Запись.Записать();
		
		
	КонецЦикла;

	
КонецПроцедуры
