
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Автомобиль = Параметры.Автомобиль;
	Владелец = Параметры.Контрагент;
	НомерПолиса = ?(Параметры.НовыйПолис, "", Параметры.НомерПолиса);
	СтраховаяКомпания = Параметры.СтраховаяКомпания;
	ДатаОкончанияПолиса = ?(Параметры.НовыйПолис, '00010101', Параметры.ДатаОкончанияПолиса);
	ЭтоНовыйПолис = Параметры.НовыйПолис;
	
	Если Параметры.Свойство("Подразделение") Тогда 
		Пар_Подразделение = Параметры.Подразделение;
	Иначе
		Пар_Подразделение = ПолучитьПодразделениеОтветственного(ПараметрыСеанса.Пользователь);
	КонецЕсли;
	
	Если НЕ ЭтоНовыйПолис Тогда 
		ЗаполнитьПредыдущиеДанные();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	Если Модифицированность Тогда 
		
		ОтказОтЗаписи = ПроверитьВозможностьЗаписи();
		
		Если НЕ ОтказОтЗаписи Тогда
			Попытка
				СфрмироватьНаборЗаписей();
				Модифицированность = Ложь;
				ЗаполнитьПредыдущиеДанные();
			Исключение
				Модифицированность = Истина;
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

