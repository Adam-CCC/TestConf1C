Процедура ДобавитьЗапись(Параметры) Экспорт
	Если СогласованиеЗапущенно(Параметры) Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
	МенеджерЗаписи.Записать();	
КонецПроцедуры 

Функция ПолучитьПараметры(ДокументСсылка = Неопределено) Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Документ"				,ДокументСсылка);
	Параметры.Вставить("УникальныйИдентификатор",	);
	Параметры.Вставить("ДатаЗапуска"			,	);
	Параметры.Вставить("ДатаЗавершения"			,	);
	Параметры.Вставить("СогласованиеЗавершено"	,	);
	Параметры.Вставить("ТекущийСтатус"			,	); 
	Возврат Параметры;
КонецФункции

Процедура ЗаполнитьПараметрыПоУмолчанию(Параметры) Экспорт
	ЗначениеСвойства = "";
	Если Не Параметры.Свойство("Документ",ЗначениеСвойства) ИЛИ Не ЗначениеЗаполнено(ЗначениеСвойства) Тогда 
		Возврат;
	КонецЕсли;
	
	Параметры.УникальныйИдентификатор   = Строка(ЗначениеСвойства.УникальныйИдентификатор());
	Параметры.ДатаЗапуска               = ТекущаяДата();
	Параметры.ДатаЗавершения            = Дата(1,1,1);
	Параметры.СогласованиеЗавершено     = Ложь;
	Параметры.ТекущийСтатус             = Перечисления.SM_СтатусыСогласования.ВПроцессе;	
КонецПроцедуры  

Процедура ПолучитьТекущиеДанныеСогласования(Параметры) Экспорт
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры,"Документ,УникальныйИдентификатор");
	МенеджерЗаписи.Прочитать();
	ЗаполнитьЗначенияСвойств(Параметры,МенеджерЗаписи);	
КонецПроцедуры   

Функция СогласованиеЗапущенно(Параметры) Экспорт
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
	МенеджерЗаписи.Прочитать();
	Возврат МенеджерЗаписи.Выбран();
КонецФункции

Функция ПолучитьТекущееСогласование(Параметры) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	SM_СогласованиеДокументов.Документ КАК Документ,
	|	SM_СогласованиеДокументов.УникальныйИдентификатор КАК УникальныйИдентификатор,
	|	SM_СогласованиеДокументов.ДатаЗапуска КАК ДатаЗапуска,
	|	SM_СогласованиеДокументов.ДатаЗавершения КАК ДатаЗавершения,
	|	SM_СогласованиеДокументов.СогласованиеЗавершено КАК СогласованиеЗавершено,
	|	SM_СогласованиеДокументов.ТекущийСтатус КАК ТекущийСтатус
	|ИЗ
	|	РегистрСведений.SM_СогласованиеДокументов КАК SM_СогласованиеДокументов
	|ГДЕ
	|SM_СогласованиеДокументов.УникальныйИдентификатор = &УникальныйИдентификатор";
	
	Запрос.УстановитьПараметр("УникальныйИдентификатор", Параметры.УникальныйИдентификатор);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ПараметрыТекущееСогласование = ПолучитьПараметры();
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат ПараметрыТекущееСогласование;
	Иначе
		ТекущееСогласование = РезультатЗапроса[0];
		ЗаполнитьЗначенияСвойств(ПараметрыТекущееСогласование,ТекущееСогласование);
		
		Возврат ПараметрыТекущееСогласование;
	КонецЕсли;
КонецФункции

Процедура ИзменитьЗапись(Параметры) Экспорт
	МенеджерЗаписи = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
		МенеджерЗаписи.Записать();
	КонецЕсли;
КонецПроцедуры
