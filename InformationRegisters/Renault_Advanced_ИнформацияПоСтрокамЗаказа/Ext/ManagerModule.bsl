#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Функция - Добавить количество отгружено
//
// Параметры:
//  Перемещение	 - ДокументСсылка	 - Документ заказ покупателя
//  Перемещение	 - ДокументСсылка	 - Документ перемещение товаров, по которому происходи отгрузка на склад реализации
// 
// Возвращаемое значение:
//   - Неопределено
//
Функция ДобавитьКоличествоОтгружено(Заказ, Перемещение) Экспорт

	// При выдаче товаров на склад реализации, необходимо дополнять количество отгружено 
	// записи добавляются в регистр при заказе товара на склад реализации через АРМ Реализации
	
	Запрос = Новый Запрос(ТекстЗапросаКоличествоОтгружено(?(ТипЗнч(Перемещение)= Тип("ДокументСсылка.ЗаказПокупателя"),Истина, Ложь)));
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Перемещение", Перемещение);
	Запрос.УстановитьПараметр("СкладРеализации", ?(ТипЗнч(Перемещение)= Тип("ДокументСсылка.ЗаказПокупателя"), Перемещение.Renault_Advanced_СкладРеализации, Перемещение.СкладПолучатель));
	
	Выборка = Запрос.Выполнить().Выбрать();
	НЗ = СоздатьНаборЗаписей();
	НЗ.Отбор.Заказ.Установить(Заказ);
	НЗ.Прочитать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.Renault_Advanced_ИнформацияПоСтрокамЗаказа.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		
		Запись.КоличествоОтгруженоНаСкладРеализации = Запись.КоличествоОтгруженоНаСкладРеализации + Выборка.КоличествоОтгружено;
		Запись.Записать();
		
		Если Выборка.КолвоПревышение <> 0 Тогда 
			Сообщить("По перемещению: " + Перемещение + " отгружено больше чем заказано на склад реализации! Количество превышено на: " + Формат(Выборка.КолвоПревышение / Выборка.Коэффициент, "ЧДЦ=3") + " (ед.)", СтатусСообщения.Важное); 
		КонецЕсли;
	КонецЦикла;
		
КонецФункции // ДобавитьКоличествоОтгружено()

// Функция - Добавить количество отгружено
//
// Параметры:
//  Перемещение	 - ДокументСсылка	 - Документ заказ покупателя
//  Перемещение	 - ДокументСсылка	 - Документ перемещение товаров, по которому происходи отгрузка на склад реализации
// 
// Возвращаемое значение:
//   - Неопределено
//
Функция ОчиститьКоличествоОтгружено(Заказ, Перемещение) Экспорт

	// При возврате товаров со склада реализации, необходимо дополнять очищать количество отгружено 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаказыПокупателей.Номенклатура КАК Номенклатура,
			|	ЗаказыПокупателей.ХарактеристикаНоменклатуры КАК Характеристика,
			|	СУММА(ЗаказыПокупателей.Резерв) КАК Количество
			|ИЗ
			|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
			|ГДЕ
			|	ЗаказыПокупателей.Заказ = &Заказ
			|	И ЗаказыПокупателей.Регистратор = &Перемещение
			|	И ЗаказыПокупателей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			|	И ЗаказыПокупателей.СкладКомпании = &СкладКомпании
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗаказыПокупателей.Номенклатура,
			|	ЗаказыПокупателей.ХарактеристикаНоменклатуры";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Перемещение", Перемещение);
	Запрос.УстановитьПараметр("СкладКомпании", Перемещение.СкладПолучатель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	НЗ = СоздатьНаборЗаписей();
	НЗ.Отбор.Заказ.Установить(Заказ);
	НЗ.Прочитать();
	ТаблицаНЗ = НЗ.Выгрузить();
	Пока Выборка.Следующий() Цикл
		Отбор = Новый Структура("Номенклатура,Характеристика",Выборка.Номенклатура,Выборка.Характеристика);
		
		Строки = ТаблицаНЗ.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда Продолжить; КонецЕсли;
		
		СтрокаИнформации = Строки[0];
		
		Количество = Мин(СтрокаИнформации.КоличествоОтгруженоНаСкладРеализации, Выборка.Количество);
		СтрокаИнформации.КоличествоОтгруженоНаСкладРеализации = СтрокаИнформации.КоличествоОтгруженоНаСкладРеализации - Количество;
		
		Количество = Мин(СтрокаИнформации.КоличествоЗаказаноНаСкладРеализации, Выборка.Количество);
		СтрокаИнформации.КоличествоЗаказаноНаСкладРеализации = СтрокаИнформации.КоличествоЗаказаноНаСкладРеализации - Количество;
	КонецЦикла;
	
	НЗ.Загрузить(ТаблицаНЗ);
	НЗ.Записать();
		
КонецФункции // ДобавитьКоличествоОтгружено()

Функция УстановитьПризнакЗаказатьПоставщику(Заказ, Номенклатура, Характеристика) Экспорт

	Запись = РегистрыСведений.Renault_Advanced_ИнформацияПоСтрокамЗаказа.СоздатьМенеджерЗаписи();
	Запись.Заказ = Заказ;
	Запись.Номенклатура = Номенклатура;
	Запись.Характеристика = Характеристика;
	Запись.Прочитать();
	
	Запись.Заказ = Заказ;
	Запись.Номенклатура = Номенклатура;
	Запись.Характеристика = Характеристика;
	Запись.ЗаказатьПоставщику = Истина;
	Запись.Записать();

КонецФункции // УстановитьПризнакЗаказатьПоставщику()

Функция ТекстЗапросаКоличествоОтгружено(ПоЗаказу = Ложь)

	Возврат "ВЫБРАТЬ
	        |	ЗаказыПокупателей.Номенклатура КАК Номенклатура,
	        |	ЗаказыПокупателей.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры, "
			+?(ПоЗаказу, 
			"
			|	СУММА(ЗаказыПокупателей.РезервОстаток) КАК Резерв
	        |ПОМЕСТИТЬ ВТ_ОтгруженоПоПеремещению
	        |ИЗ  
	        |	РегистрНакопления.ЗаказыПокупателей.Остатки(
			|    ,
			|   Заказ = &Заказ
			|	И СкладКомпании = &СкладРеализации) КАК ЗаказыПокупателей "
			,
			"  
			|	СУММА(ЗаказыПокупателей.Резерв) КАК Резерв
	        |ПОМЕСТИТЬ ВТ_ОтгруженоПоПеремещению
	        |ИЗ  
	        |	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
	        |ГДЕ
	        |	ЗаказыПокупателей.Заказ = &Заказ
	        |	И ЗаказыПокупателей.Регистратор = &Перемещение
	        |	И ЗаказыПокупателей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	        |	И ЗаказыПокупателей.СкладКомпании = &СкладРеализации")
			+
			"
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ЗаказыПокупателей.Номенклатура,
	        |	ЗаказыПокупателей.ХарактеристикаНоменклатуры
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Номенклатура,
	        |	ХарактеристикаНоменклатуры
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.Заказ,
	        |	0 КАК КлючСтроки,
	        |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.Номенклатура КАК Номенклатура,
	        |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.Характеристика,
	        |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.КоличествоЗаказаноНаСкладРеализации - Renault_Advanced_ИнформацияПоСтрокамЗаказа.КоличествоОтгруженоНаСкладРеализации КАК НеОтгружено
	        |ПОМЕСТИТЬ ВТ_Подготовка
	        |ИЗ
	        |	РегистрСведений.Renault_Advanced_ИнформацияПоСтрокамЗаказа КАК Renault_Advanced_ИнформацияПоСтрокамЗаказа
	        |ГДЕ
	        |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.Заказ = &Заказ
	        |	И (Renault_Advanced_ИнформацияПоСтрокамЗаказа.Номенклатура, Renault_Advanced_ИнформацияПоСтрокамЗаказа.Характеристика) В
	        |			(ВЫБРАТЬ
	        |				ВТ_ОтгруженоПоПеремещению.Номенклатура,
	        |				ВТ_ОтгруженоПоПеремещению.ХарактеристикаНоменклатуры
	        |			ИЗ
	        |				ВТ_ОтгруженоПоПеремещению КАК ВТ_ОтгруженоПоПеремещению)
	        |	И Renault_Advanced_ИнформацияПоСтрокамЗаказа.КоличествоЗаказаноНаСкладРеализации > Renault_Advanced_ИнформацияПоСтрокамЗаказа.КоличествоОтгруженоНаСкладРеализации
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	КлючСтроки,
	        |	Номенклатура
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_Подготовка.Заказ,
	        |	ВТ_Подготовка.КлючСтроки КАК КлючСтроки,
	        |	ВТ_Подготовка.Номенклатура КАК Номенклатура,
	        |	ВТ_Подготовка.Характеристика КАК Характеристика,
	        |	ВТ_Подготовка.НеОтгружено,
	        |	ЕСТЬNULL(ВТ_ПодготовкаДО.НеОтгружено, 0) КАК НеОтгруженоДО
	        |ПОМЕСТИТЬ ВТ_НеОтгруженоПодготовка
	        |ИЗ
	        |	ВТ_Подготовка КАК ВТ_Подготовка
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Подготовка КАК ВТ_ПодготовкаДО
	        |		ПО ВТ_Подготовка.Номенклатура = ВТ_ПодготовкаДО.Номенклатура
	        |			И ВТ_Подготовка.КлючСтроки > ВТ_ПодготовкаДО.КлючСтроки
	        |			И ВТ_Подготовка.Характеристика = ВТ_ПодготовкаДО.Характеристика
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Номенклатура,
	        |	КлючСтроки
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_НеОтгружено.Заказ,
	        |	ВТ_НеОтгружено.КлючСтроки,
	        |	ВТ_НеОтгружено.Номенклатура КАК Номенклатура,
	        |	ВТ_НеОтгружено.Характеристика КАК Характеристика,
	        |	МАКСИМУМ(ВТ_НеОтгружено.НеОтгружено) КАК НеОтгружено,
	        |	МАКСИМУМ(ВТ_НеОтгружено.НеОтгруженоДО) КАК НеОтгруженоДО,
	        |	СУММА(ЕСТЬNULL(ВТ_НеОтгруженоПосле.НеОтгружено, 0)) КАК НеОтгруженоПОСЛЕ
	        |ПОМЕСТИТЬ ВТ_НеОтгружено
	        |ИЗ
	        |	ВТ_НеОтгруженоПодготовка КАК ВТ_НеОтгружено
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НеОтгруженоПодготовка КАК ВТ_НеОтгруженоПосле
	        |		ПО ВТ_НеОтгружено.КлючСтроки < ВТ_НеОтгруженоПосле.КлючСтроки
	        |			И ВТ_НеОтгружено.Характеристика = ВТ_НеОтгруженоПосле.Характеристика
	        |			И ВТ_НеОтгружено.Номенклатура = ВТ_НеОтгруженоПосле.Номенклатура
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_НеОтгружено.Заказ,
	        |	ВТ_НеОтгружено.КлючСтроки,
	        |	ВТ_НеОтгружено.Номенклатура,
	        |	ВТ_НеОтгружено.Характеристика
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	Номенклатура,
	        |	Характеристика
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	&Заказ КАК Заказ,
	        |	ЕСТЬNULL(ВТ_НеОтгружено.КлючСтроки, 0) КАК КлючСтроки,
	        |	ВТ_ОтгруженоПоПеремещению.Номенклатура,
	        |	ВТ_ОтгруженоПоПеремещению.ХарактеристикаНоменклатуры КАК Характеристика,
	        |	ВЫБОР
	        |		КОГДА ВТ_НеОтгружено.НеОтгружено ЕСТЬ NULL 
	        |			ТОГДА ВТ_ОтгруженоПоПеремещению.Резерв
	        |		КОГДА ВТ_ОтгруженоПоПеремещению.Резерв <= ВТ_НеОтгружено.НеОтгруженоДО
	        |			ТОГДА 0
	        |		КОГДА ВТ_НеОтгружено.НеОтгруженоДО + ВТ_НеОтгружено.НеОтгружено > ВТ_ОтгруженоПоПеремещению.Резерв
	        |			ТОГДА ВТ_ОтгруженоПоПеремещению.Резерв - ВТ_НеОтгружено.НеОтгруженоДО
	        |		КОГДА ВТ_НеОтгружено.НеОтгруженоДО + ВТ_НеОтгружено.НеОтгружено <= ВТ_ОтгруженоПоПеремещению.Резерв
	        |				И ВТ_НеОтгружено.НеОтгруженоПОСЛЕ = 0
	        |			ТОГДА ВТ_ОтгруженоПоПеремещению.Резерв
	        |		КОГДА ВТ_НеОтгружено.НеОтгруженоДО + ВТ_НеОтгружено.НеОтгружено <= ВТ_ОтгруженоПоПеремещению.Резерв
	        |				И ВТ_НеОтгружено.НеОтгруженоПОСЛЕ <> 0
	        |			ТОГДА ВТ_НеОтгружено.НеОтгружено
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК КоличествоОтгружено,
	        |	ВЫБОР
	        |		КОГДА ВТ_НеОтгружено.НеОтгружено ЕСТЬ NULL 
	        |			ТОГДА ВТ_ОтгруженоПоПеремещению.Резерв
	        |		КОГДА ВТ_НеОтгружено.НеОтгруженоДО + ВТ_НеОтгружено.НеОтгружено <= ВТ_ОтгруженоПоПеремещению.Резерв
	        |				И ВТ_НеОтгружено.НеОтгруженоПОСЛЕ = 0
	        |			ТОГДА ВТ_ОтгруженоПоПеремещению.Резерв - ВТ_НеОтгружено.НеОтгруженоДО - ВТ_НеОтгружено.НеОтгружено
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК КолвоПревышение,
	        |	ВЫБОР
	        |		КОГДА ЕдиницыИзмерения.Коэффициент ЕСТЬ NULL 
	        |				ИЛИ ЕдиницыИзмерения.Коэффициент = 0
	        |			ТОГДА 1
	        |		ИНАЧЕ ЕдиницыИзмерения.Коэффициент
	        |	КОНЕЦ КАК Коэффициент
	        |ИЗ
	        |	ВТ_ОтгруженоПоПеремещению КАК ВТ_ОтгруженоПоПеремещению
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НеОтгружено КАК ВТ_НеОтгружено
	        |		ПО ВТ_ОтгруженоПоПеремещению.Номенклатура = ВТ_НеОтгружено.Номенклатура
	        |			И ВТ_ОтгруженоПоПеремещению.ХарактеристикаНоменклатуры = ВТ_НеОтгружено.Характеристика
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК спрНоменклатура
	        |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
	        |			ПО спрНоменклатура.ОсновнаяЕдиницаИзмерения = ЕдиницыИзмерения.Ссылка
	        |		ПО ВТ_ОтгруженоПоПеремещению.Номенклатура = спрНоменклатура.Ссылка";

КонецФункции

Функция ПолучитьИнформациюПоСтрокам(Заказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.Номенклатура,
	               |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.Характеристика,
	               |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.КоличествоЗаказаноНаСкладРеализации,
	               |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.КоличествоОтгруженоНаСкладРеализации,
	               |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.ЗаказатьПоставщику,
	               |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.ДатаРезервирования
	               |ИЗ
	               |	РегистрСведений.Renault_Advanced_ИнформацияПоСтрокамЗаказа КАК Renault_Advanced_ИнформацияПоСтрокамЗаказа
	               |ГДЕ
	               |	Renault_Advanced_ИнформацияПоСтрокамЗаказа.Заказ = &Заказ";
	
