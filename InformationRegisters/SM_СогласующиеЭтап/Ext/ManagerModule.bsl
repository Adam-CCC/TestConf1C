Функция ПолучитьПараметры() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("НомерЭтапа"				, 	);
	Параметры.Вставить("УникальныйИдентификатор",	);
	Параметры.Вставить("Согласующий"			,	);
	Параметры.Вставить("Ответ"					,	);
	Параметры.Вставить("ДатаОтвета"				,	);
	Параметры.Вставить("Причина"				,	);
	Возврат Параметры;
КонецФункции

Функция ЗаполнитьПараметрыПоУмолчанию(Параметры) Экспорт
	Параметры.Вставить("НомерЭтапа"				, 	);
	Параметры.Вставить("УникальныйИдентификатор",	);
	Параметры.Вставить("Согласующий"			,	);
	Параметры.Вставить("Ответ"					,Перечисления.SM_СтатусыСогласования.ПустаяСсылка());
	Параметры.Вставить("ДатаОтвета"				,Дата(1,1,1));
КонецФункции 

Функция ЕстьАктивныеЗаписиПоТекущемуЭтапу(Параметры) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	SM_СогласующиеЭтап.НомерЭтапа КАК НомерЭтапа,
		|	SM_СогласующиеЭтап.УникальныйИдентификатор КАК УникальныйИдентификатор,
		|	SM_СогласующиеЭтап.Согласующий КАК Согласующий,
		|	SM_СогласующиеЭтап.Ответ КАК Ответ,
		|	SM_СогласующиеЭтап.ДатаОтвета КАК ДатаОтвета
		|ИЗ
		|	РегистрСведений.SM_СогласующиеЭтап КАК SM_СогласующиеЭтап
		|ГДЕ
		|	SM_СогласующиеЭтап.НомерЭтапа = &НомерЭтапа
		|	И Выразить(SM_СогласующиеЭтап.УникальныйИдентификатор Как Строка(100)) = Выразить(&УникальныйИдентификатор Как Строка(100))
		|	И SM_СогласующиеЭтап.Ответ = ЗНАЧЕНИЕ(Перечисление.SM_СтатусыСогласования.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("НомерЭтапа"				, Параметры.НомерЭтапа);
	Запрос.УстановитьПараметр("УникальныйИдентификатор"	, Параметры.УникальныйИдентификатор);
	
	Пустой = Запрос.Выполнить().Пустой();
	
	Возврат Не Пустой;
КонецФункции

