Процедура ИзменитьЗапись(Параметры) Экспорт
	МенеджерЗаписи = РегистрыСведений.SM_СогласующиеЭтап.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи,Параметры);
		МенеджерЗаписи.Записать();
	КонецЕсли;
КонецПроцедуры

Функция ВсеСогласующиеОтветилиПоТекущемуЭтапу(Параметры) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(SM_СогласующиеЭтап.Согласующий) КАК КоличествоУчастников,
		|	КОЛИЧЕСТВО(ВЫБОР
		|			КОГДА SM_СогласующиеЭтап.Ответ <> ЗНАЧЕНИЕ(Перечисление.SM_СтатусыСогласования.ПустаяСсылка)
		|					И SM_СогласующиеЭтап.ДатаОтвета <> ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА 1
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК КоличествоОтветов
		|ПОМЕСТИТЬ ВТ_Итоги
		|ИЗ
		|	РегистрСведений.SM_СогласующиеЭтап КАК SM_СогласующиеЭтап
		|ГДЕ
		|	SM_СогласующиеЭтап.НомерЭтапа = &НомерЭтапа
		|	И SM_СогласующиеЭтап.УникальныйИдентификатор = &УникальныйИдентификатор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Итоги.КоличествоОтветов = ВТ_Итоги.КоличествоУчастников КАК ВсеОтветили
		|ИЗ
		|	ВТ_Итоги КАК ВТ_Итоги";
	
	Запрос.УстановитьПараметр("НомерЭтапа"				, Параметры.НомерЭтапа);
	Запрос.УстановитьПараметр("УникальныйИдентификатор"	, Параметры.УникальныйИдентификатор);
	
	ВсеОтветили = Запрос.Выполнить().Выгрузить()[0].ВсеОтветили;
	
	Возврат ВсеОтветили;
КонецФункции

