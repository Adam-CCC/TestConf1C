////@+ Процедура ЗаписатьДанныеВРегистр(Параметры)
//Дата создания - 12.05.2012 08:13:21; Автор - Окипний Андрей Евгеньевич
// 
//
// Описание процедуры
//  Процедура производит запись таблицы данных в регистр временного хранения
//
// Параметры
//  Таблица  - Таблица значений - Таблица значений с данными для записи
//
//@-
Процедура ЗаписатьДанныеВРегистр(Таблица) Экспорт
	
	// Комментарий 
	//Дата создания - 14.05.2012 14:51:36; Автор - Окипний Андрей Евгеньевич
	//Для начала очистим регистр. На всякий случай
	//
	ОчиститьРегистр();
	
	КоличествоСтрок = Таблица.Количество();
	
	Если КоличествоСтрок < 99999 тогда
		Renault_Открытый.СостояниеДляПользователя("Запись во временный регистр - единым блоком");
	КонецЕсли;
	
	//Создадим набор записи
	Если КоличествоСтрок > 99999 тогда //Нужно писать построчно. иначе вываливаемся по переполнению памяти
		Для каждого строкаТЗ Из Таблица Цикл
			
			Renault_Открытый.СостояниеДляПользователя("Запись во временный регистр - построчно (" 
							+ Таблица.Индекс(строкаТЗ) + "/" + КоличествоСтрок + ")");
			
			МЗ = СоздатьМенеджерЗаписи();
			
			ЗаполнитьЗначенияСвойств(МЗ, СтрокаТЗ);
			МЗ.Прочитать();
			
			ЗаполнитьЗначенияСвойств(МЗ, СтрокаТЗ);
			МЗ.Записать();
		
		КонецЦикла;
	Иначе
		НЗ = СоздатьНаборЗаписей();
		НЗ.Загрузить(Таблица);
		НЗ.Записать();
	КонецЕсли;
	
КонецПроцедуры // ЗаписатьДанныеВРегистр(Параметры)


////@+ Процедура ОчиститьРегистр()
//Дата создания - 12.05.2012 10:28:11; Автор - Окипний Андрей Евгеньевич
// 
// Описание процедуры
//  Процедура производит ПОЛНУЮ отистку регистра
//
// Параметры
//  Без параметров
//@-
Процедура ОчиститьРегистр() Экспорт

	НЗ = СоздатьНаборЗаписей();
	
	// Комментарий 
	//Дата создания - 12.05.2012 10:28:56; Автор - Окипний Андрей Евгеньевич
	//Запись неинициализированного набора приводит к удалению всех записей из регистра.
	//
	НЗ.Записать();

КонецПроцедуры // ОчиститьРегистр()
