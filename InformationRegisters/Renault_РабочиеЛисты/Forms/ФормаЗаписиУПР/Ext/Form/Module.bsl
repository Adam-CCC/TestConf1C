&НаСервереБезКонтекста
Функция Воронка_ОбновитьВыдачуНаСервере(IDK,ОформлениеЭлементов)
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ВыдачаАвтомобиля;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//Была выдача
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault3;
		Заголовок = "Выдача (" + ТекстДата + ")";
		Картинка = ОформлениеЭлементов.ИзображениеСобытиеВыполнено;
	Иначе
		//Не было выдачи
		//Проверим наличие напоминания
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRM_СобытияПоРабочимЛистам.Ссылка,
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания
		|ИЗ
		|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|ГДЕ
		|	CRM_СобытияПоРабочимЛистам.IDK = &IDK
		|	И CRM_СобытияПоРабочимЛистам.ВидСобытия = &ВидСобытия
		|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
		Запрос.УстановитьПараметр("IDK", IDK);
		Запрос.УстановитьПараметр("ВидСобытия", Справочники.CRM_ВидыСобытий.Выдача);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			//Есть напоминание
			ЦветКнопки = ОформлениеЭлементов.ЦветRenault1;
			Заголовок = "Выдача";
			Картинка = ОформлениеЭлементов.ИзображениеСобытиеЗапланировано;
			Если ЗначениеЗаполнено(Выборка.ДатаНапоминания) Тогда
				ТекстДата = Формат(Выборка.ДатаНапоминания, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
				Заголовок = "Выдача (" + ТекстДата + ")";
			КонецЕсли;
		Иначе
			//Нет напоминания
			ЦветКнопки = ОформлениеЭлементов.ЦветRenault1;
			Заголовок = "Выдача";
			Картинка = ОформлениеЭлементов.ИзображениеПустое;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый Структура("ЦветКнопки,Заголовок,Картинка",ЦветКнопки,Заголовок,Картинка);
	
КонецФункции

