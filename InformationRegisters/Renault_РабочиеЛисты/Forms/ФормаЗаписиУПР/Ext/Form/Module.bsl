Функция Воронка_ОбновитьДопОборудованиеНаСервере(IDK,ОформлениеЭлементов)
	   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаСервис.СтатусПодготовкиКПродаже КАК Статус,
	               |	Renault_CRM_ЗаявкаНаСервис.Ссылка
	               |ИЗ
	               |	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
	               |ГДЕ
	               |	Renault_CRM_ЗаявкаНаСервис.ПометкаУдаления = ЛОЖЬ
	               |	И Renault_CRM_ЗаявкаНаСервис.Обращение.IDK = &IDK
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Renault_CRM_ЗаявкаНаСервис.Дата УБЫВ";
				   
	Запрос.УстановитьПараметр("IDK", IDK);

	ТаблицаЗаявокНаДопОборудование = Запрос.Выполнить().Выгрузить();

	ЕстьЗаявкаНаДопы = ?(ТаблицаЗаявокНаДопОборудование.Количество()=0, Ложь, Истина);
	
	Если Не ЕстьЗаявкаНаДопы Тогда
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		Запись.IDK = IDK;
		Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ИнтересовалсяОборудованием;
		Запись.Прочитать();
		ЕстьИнтересКДопам = Запись.Выбран();
	Иначе
		ЕстьИнтересКДопам = Ложь;
	КонецЕсли;
	
	Если ЕстьЗаявкаНаДопы Тогда
		СтатусПоследнейЗаявки = ТаблицаЗаявокНаДопОборудование[0].Статус;		
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault3;
		Заголовок = "Доп. опции"+Символы.ПС + " ("+СтатусПоследнейЗаявки+")";
	ИначеЕсли ЕстьИнтересКДопам Тогда
		//Есть ДО в КП
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault2;
		Заголовок = "Доп. опции"+Символы.ПС + " (есть интерес)";
	Иначе
		//Нет ДО в КП
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault1;
		Заголовок = "Доп. опции";
	КонецЕсли;
	
	Возврат Новый Структура("ЦветКнопки,Заголовок",ЦветКнопки,Заголовок);
	
КонецФункции

