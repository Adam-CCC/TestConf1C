&НаКлиенте
Процедура ОткрытьСтаруюФорму(Отказ)
	Если Вопрос("Новая (управляемая) форма в разработке. Открыть старую форму?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да)=КодВозвратаДиалога.Да Тогда
		Запись = Renault_CRM.ПолучитьЗаписьРЛПоIDK(Объект.IDK);
		Если Запись=Неопределено Тогда
			ОткрытьФорму("РегистрСведений.Renault_РабочиеЛисты.Форма.ФормаЗаписи");
		Иначе	
			Renault_CRM.ОткрытьФормуРЛ(Объект.IDK);
		КонецЕсли;
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры // ОткрытьСтаруюФорму()

&НаКлиенте
Процедура кнСтараяФорма()
	Если ЗначениеЗаполнено(Объект.IDK) И Модифицированность Тогда
		Записан = Ложь;
		Попытка Записан = Записать(); Исключение Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке())); КонецПопытки;
		Если Не Записан Тогда Возврат; КонецЕсли;
	КонецЕсли;
	
	Renault_CRM.ОткрытьФормуРЛ(Объект.IDK);
	
	Закрыть();
КонецПроцедуры


