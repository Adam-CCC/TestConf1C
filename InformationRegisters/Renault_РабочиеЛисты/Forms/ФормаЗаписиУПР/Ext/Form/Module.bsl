&НаСервереБезКонтекста
Функция Воронка_ОбновитьЗвонокВежливостиНаСервере(IDK,ВидСобытия,ТипКлиента,ОформлениеЭлементов)
	
	Если ВидСобытия = ПредопределенноеЗначение("Справочник.CRM_ВидыСобытий.ЗвонокВежливости3") Тогда
		НомерЗвонка = "1"; ИмяЭлемента = ИмяЭлементаВоронка("кнЗвонокВежливости3",ТипКлиента);
		ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗвонокВежливости3дня;
	ИначеЕсли ВидСобытия = ПредопределенноеЗначение("Справочник.CRM_ВидыСобытий.ЗвонокВежливости30") Тогда	
		НомерЗвонка = "2"; ИмяЭлемента = ИмяЭлементаВоронка("кнЗвонокВежливости30",ТипКлиента);
		ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗвонокВежливости30Дней;
	ИначеЕсли ВидСобытия = ПредопределенноеЗначение("Справочник.CRM_ВидыСобытий.ЗвонокВежливости360") Тогда		
		НомерЗвонка = "3"; ИмяЭлемента = ИмяЭлементаВоронка("кнЗвонокВежливости360",ТипКлиента);;
		ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗвонокВежливости360Дней;
	КонецЕсли;
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = IDK;
	Запись.ЭтапПродаж = ЭтапПродаж;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//Был звонок
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
