Функция Воронка_ОбновитьТрейдИнНаСервере(IDK,СвязаныйIDK,ОформлениеЭлементов)
	
	ТекстМенеджер = "";
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("РабочийЛист", СвязаныйIDK);
	Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
	Пока Выборка.Следующий() И ЗначениеЗаполнено(Выборка.МенеджерТрейдИн) Цикл
		ТекстМенеджер = Символы.ПС + Выборка.МенеджерТрейдИн;
	КонецЦикла;
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИн;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//Есть трейд-ин в КП
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault2;
		Заголовок = "Трейд-ин" +Символы.ПС+ ТекстДата + ТекстМенеджер;
		ЗаписьВып = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		ЗаписьВып.IDK = IDK;
		ЗаписьВып.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнВыполнена;
		ЗаписьВып.Прочитать();
		Если ЗаписьВып.Выбран() Тогда
			Если ЗначениеЗаполнено(ЗаписьВып.ДатаВыполнения) Тогда
				ТекстДата = Формат(ЗаписьВып.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
			КонецЕсли;
			ЦветКнопки = ОформлениеЭлементов.ЦветRenault3;
			Заголовок = "Трейд-ин" +Символы.ПС+ ТекстДата + ТекстМенеджер;
		КонецЕсли;
	Иначе
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		Запись.IDK = СвязаныйIDK;
		Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнВыполнена;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
				ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
			КонецЕсли;
			ЦветКнопки = ОформлениеЭлементов.Цвет121181109;
			Заголовок = "Трейд-ин" +Символы.ПС+ ТекстДата + ТекстМенеджер;
			
		Иначе
			//Нет трейд-ин в КП
			ЦветКнопки = ОформлениеЭлементов.ЦветRenault1;
			Заголовок = "Трейд-ин";
			Если ЗначениеЗаполнено(СвязаныйIDK) Тогда
				СтруктураОтбора = Новый Структура();
				СтруктураОтбора.Вставить("РабочийЛист", СвязаныйIDK);
				Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
				Пока Выборка.Следующий() Цикл
	 				ТекстДата = Формат(Выборка.Ссылка.Дата, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
					ЦветКнопки = ОформлениеЭлементов.ЦветRenault3;
					Заголовок = "Трейд-ин" +Символы.ПС+ ТекстДата + ТекстМенеджер;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Новый Структура("ЦветКнопки,Заголовок",ЦветКнопки,Заголовок);
	
КонецФункции

