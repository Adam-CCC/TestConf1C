&НаСервереБезКонтекста
Функция Воронка_ОбновитьРегистрациюКлиентаВБазеРеноРоссияНаСервере(IDK,Клиент,ТипКлиента,ОформлениеЭлементов)
		
	ДанныеКорпКлиента = ПолучитьИдентификаторКорпКлиента(Клиент,ТипКлиента);  
	ИдентификаторКорпКлиента = ?(ДанныеКорпКлиента <> Неопределено,ДанныеКорпКлиента.ИдентификаторКорпКлиента,"");

	//проверим была ли попытка регистрации клиента 
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.РегистрацияКлиентаВБазеРеноРоссия;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault3;
		//если корп.клиент зарегестрирован, выведем его идентификатор
		//если нет отобразим, дату регистрации корп. клиента
		Если ЗначениеЗаполнено(ИдентификаторКорпКлиента) Тогда		
			Заголовок = "Корп. клиент зарегистрирован. № " + ИдентификаторКорпКлиента;
		Иначе
			Заголовок = "Регистрация клиента в базе Renault Россия (" + ТекстДата + ")";
		КонецЕсли;	
	Иначе
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault1;
		Заголовок = "Регистрация клиента в базе Renault Россия";
	КонецЕсли;
	
	Возврат Новый Структура("ЦветКнопки,Заголовок",ЦветКнопки,Заголовок);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИдентификаторКорпКлиента(Клиент,ТипКлиента)
	
	ИдентификаторКорпКлиента = "";
	
	ДанныеКорпКлиента = Новый Структура("КорпКлиент,ИдентификаторКорпКлиента");	
	ДанныеКорпКлиента.Вставить("КорпКлиент","");
	ДанныеКорпКлиента.Вставить("ИдентификаторКорпКлиента","");
			
	
	Если ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	Renault_КорпоративныеКлиенты.Ссылка
				|ИЗ
				|	Справочник.Renault_КорпоративныеКлиенты КАК Renault_КорпоративныеКлиенты
				|ГДЕ
				|	Renault_КорпоративныеКлиенты.Контрагент = &Контрагент";
			Запрос.УстановитьПараметр("Контрагент", Клиент);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				КорпКлиент  = Выборка.Ссылка;
				ИдентификаторКорпКлиента = КорпКлиент.Идентификатор;
				
				ДанныеКорпКлиента.Вставить("КорпКлиент",КорпКлиент);
				ДанныеКорпКлиента.Вставить("ИдентификаторКорпКлиента",ИдентификаторКорпКлиента);
				
				Возврат ДанныеКорпКлиента;
			КонецЕсли;	
		Иначе
			Возврат ДанныеКорпКлиента;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

