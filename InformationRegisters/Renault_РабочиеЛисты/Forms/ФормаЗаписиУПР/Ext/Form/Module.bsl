Функция Воронка_ОбновитьРасторжениеДКПНаСервере(IDK,ОформлениеЭлементов)
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.РасторжениеДКП;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//Расторгнут
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		ЦветКнопки = ОформлениеЭлементов.Цвет211668;
		Заголовок = "Расторжение" + ТекстДата;
	Иначе
		//Не расторгнут
		ЦветКнопки = ОформлениеЭлементов.ЦветRenault1;
		Заголовок = "Расторжение";
	КонецЕсли;
	
	Возврат Новый Структура("ЦветКнопки,Заголовок",ЦветКнопки,Заголовок);
	
КонецФункции

