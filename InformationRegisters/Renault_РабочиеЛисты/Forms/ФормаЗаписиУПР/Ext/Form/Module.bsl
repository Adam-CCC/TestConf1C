&НаКлиенте
Процедура ВзятьРЛВРаботуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда Возврат; КонецЕсли;
	
	Если РЛВзятьВРаботуНаСервере() Тогда ОбновитьЗаголовок(); КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РЛВзятьВРаботуНаСервере()

	ИзменилиМенеджера = Ложь;
	
	текСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
	Если ЗначениеЗаполнено(текСотрудник) Тогда
		СтруктураОтбора = Новый Структура();
		СтруктураОтбора.Вставить("РабочийЛист", Объект.IDK);
		Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
		
		Если Выборка.Следующий() И НЕ ЗначениеЗаполнено(Выборка.МенеджерТрейдИн) И Не Выборка.ПометкаУдаления Тогда					
			ДокЗаявкаПоТрейдИн = Выборка.Ссылка.ПолучитьОбъект();
			ДокЗаявкаПоТрейдИн.МенеджерТрейдИн = текСотрудник;
			Попытка
				ДокЗаявкаПоТрейдИн.Записать(РежимЗаписиДокумента.Запись); ИзменилиМенеджера = Истина;
			Исключение
				Сообщить("Не удалось указать менеджера по трейд-ин в заявке № "+Выборка.Номер);
			КонецПопытки;
		КонецЕсли;				
	КонецЕсли;

	Возврат ИзменилиМенеджера;
	
КонецФункции // ВзятьРЛВРаботуЗавершение()

&НаСервереБезКонтекста
Процедура ОбновитьКомментарий(IDK,ТабличныйДокумент)
	
	ТабличныйДокумент.Очистить();
	Таб = Новый ТабличныйДокумент;
	
	МакетКомментариев = РегистрыСведений.Renault_РабочиеЛисты.ПолучитьМакет("РазделКомментариевУзкий");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	CRM_Комментарии.Дата КАК ДатаКомментария,
	|	CRM_Комментарии.IDK КАК IDK,
	|	CRM_Комментарии.Идентификатор КАК Идентификатор,
	|	CRM_Комментарии.ИдентификаторРодителя КАК ИдентификаторРодителя,
	|	CRM_Комментарии.Автор,
	|	CRM_Комментарии.ТекстКомментария Как Комментарий
	|ИЗ
	|	РегистрСведений.CRM_Комментарии КАК CRM_Комментарии
	|ГДЕ
	|	CRM_Комментарии.IDK = &IDK
	|
	|УПОРЯДОЧИТЬ ПО
	|	IDK,
	|	Дата,
	|	Идентификатор,
	|	ИдентификаторРодителя");
	Запрос.УстановитьПараметр("IDK",IDK);
	
	ТаблицаКомментариев = Запрос.Выполнить().Выгрузить();
	
	ДеревоКомментариев = Renault_CRM.ПолучитьДеревоКомментариев(ТаблицаКомментариев);
	
	Таб.НачатьАвтогруппировкуСтрок();
	
	ОбластьШапка = МакетКомментариев.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Идентификатор = "ДобавитьКомментарий";
	Таб.Вывести(ОбластьШапка);
	
	Для каждого КорневойКомментарий из ДеревоКомментариев.Строки Цикл
		Renault_CRM.ВывестиКомментарийРекурсивно(Таб, МакетКомментариев, КорневойКомментарий, 1);
	КонецЦикла;
	
	Таб.ЗакончитьАвтогруппировкуСтрок();
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОтображатьСетку     = Ложь;
	Таб.ТолькоПросмотр      = Истина;
	ТабличныйДокумент.Вывести(Таб);
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьГруппировки = Истина;
	
	ТабличныйДокумент.ОтображатьСетку     = Ложь;
	ТабличныйДокумент.ТолькоПросмотр      = Истина;
	ТабличныйДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб         = Истина;
	ТабличныйДокумент.ТекущаяОбласть = ТабличныйДокумент.Область(1, 1, 1, 1);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКлиентаСервер(СтруктураПервичныйИнтерес = Неопределено)
	
	Клиент_ФИО = "";
	Клиент_Телефон = "";
	Клиент_Email = "";
	Клиент_Город = "";
	Клиент_ИсточникИнформации = Справочники.CRM_ИсточникиИнформации.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		
		Клиент_Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.Клиент);
		Клиент_Телефон = CRM_Сервер.Renault_CRM_СкорректироватьТелефонПриЗаписи(Клиент_Телефон);
		
		Если ЗначениеЗаполнено(Объект.ДилерскийЦентр) И НЕ ПустаяСтрока(Объект.ДилерскийЦентр.ПервыйСимволТелефона) Тогда
			Клиент_Телефон = СтрЗаменить(Клиент_Телефон, "+", "");
			Если СтрДлина(Клиент_Телефон) = 11 Тогда
				Клиент_Телефон = Прав(Клиент_Телефон, 10);
			КонецЕсли;
		КонецЕсли;
		
		Клиент_Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Объект.Клиент);
		
		Клиент_ФИО = Объект.Клиент.НаименованиеПолное;
		
		Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.Контрагенты") тогда
			Элементы.Клиент_ФИО.КнопкаВыбора = Истина;
			СтатусКлиента = 1;
		Иначе
			Элементы.Клиент_ФИО.КнопкаВыбора = Истина;
			СтатусКлиента = 0;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CRM_КлиентскиеДанные.ИсточникИнформации,
		|	CRM_КлиентскиеДанные.Город
		|ИЗ
		|	РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанные
		|ГДЕ
		|	CRM_КлиентскиеДанные.Клиент = &Клиент";
		Запрос.УстановитьПараметр("Клиент", Объект.Клиент);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Клиент_Город = Выборка.Город;
			Клиент_ИсточникИнформации = Выборка.ИсточникИнформации;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураПервичныйИнтерес <> Неопределено Тогда
		Если СтруктураПервичныйИнтерес.IDK = Объект.СвязаныйIDK Тогда
			ПервичныйИнтересМодель = СтруктураПервичныйИнтерес.ПервичныйИнтерес;
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

