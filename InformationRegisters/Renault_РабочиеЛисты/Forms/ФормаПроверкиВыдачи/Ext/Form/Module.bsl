&НаКлиенте
Процедура ОбновитьДанныеПоАвтомобилю()
	
	Если ПараметрыОткрытия <> Неопределено Тогда
		ВывестиДанные(ПараметрыОткрытия, "ТипАвтомобиля"        , ПараметрыОткрытия.ТипАвтомобиля                                               , "На продажу",ЗначениеЗаполнено(АнализируемыйАвтомобиль));
		ВывестиДанные(ПараметрыОткрытия, "Договор"              , ?(ПараметрыОткрытия.Проверка_Договор, ПараметрыОткрытия.Договор, "Отсутствует"), "Оформлен"                       , Истина);
		ВывестиДанные(ПараметрыОткрытия, "СтатусДоговора"       , ПараметрыОткрытия.СтатусДоговора                                          	, "Подписан",ЗначениеЗаполнено(ПараметрыОткрытия.Договор));
		ВывестиДанные(ПараметрыОткрытия, "ЦенаДоговора"         , ПараметрыОткрытия.ЦенаДоговора                                                , "Установлена"          , Истина);
		ВывестиДанные(ПараметрыОткрытия, "СкладКомпании"        , ?(ПараметрыОткрытия.Проверка_СкладКомпании, ПараметрыОткрытия.СкладКомпании, "Отсутствует на складе"), "На складе" , Истина);
		ВывестиДанные(ПараметрыОткрытия, "ДокументПоступления"  , ?(ПараметрыОткрытия.Проверка_ДокументПоступления, ПараметрыОткрытия.ДокументПоступления,"Отсутствует"), "Оформлен"  , Истина);
		ВывестиДанные(ПараметрыОткрытия, "ОплатаПоставщику"     , ?(ПараметрыОткрытия.Проверка_ОплатаПоставщику, "Оплачено", "Не оплачено")      , "Оплачено"             , Истина);
		ВывестиДанные(ПараметрыОткрытия, "ПТС"                  , ?(ПараметрыОткрытия.Проверка_ПТС, ПараметрыОткрытия.ПТС, "Отсутствует")        , "Номер ПТС"            , Истина);
		// Ковалев ЕС от 19.10.2018 
		// Закомментировано по задаче:
		// http://217.23.136.86/browse/DMSL-309
		// На форме скрыта группа "Группа14". Основной код получения оплаты оставлен, если придется восстановить. 
		//ВывестиДанные(ПараметрыОткрытия, "ОплатаПокупателя"     , ПараметрыОткрытия.ОплатаПокупателя  											 , "Равна сумме продажи"            , Истина);
		Если ПараметрыОткрытия.Свойство("ЦенаПродажи") Тогда
			ВывестиДанные(ПараметрыОткрытия, "ЦенаПродажи"  , ПараметрыОткрытия.ЦенаПродажи, "Не меньше суммы по договору", Истина);
		КонецЕсли;
		Если ПараметрыОткрытия.Свойство("Реализация") Тогда
			ВывестиДанные(ПараметрыОткрытия, "Реализация" , ?(ПараметрыОткрытия.Проверка_Реализация, ПараметрыОткрытия.Реализация,"Отсутствует"), "Оформлена"            , Истина);
		КонецЕсли;
		Если ПараметрыОткрытия.Свойство("ВыполнениеЗаказов") Тогда
			ВывестиДанные(ПараметрыОткрытия, "ВыполнениеЗаказов" , ?(ПараметрыОткрытия.Проверка_ВыполнениеЗаказов, "Закрыты", "Не закрыты"), "Закрыты"            , Истина);
		КонецЕсли;
		ВывестиДанные(ПараметрыОткрытия, "Готов"                ,                                                         , ""                     , Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиДанные(ДанныеСтроки, ИмяЭлемента, ЗаголовокТекущее, ЗаголовокТребуется, Отображать)
	
	ЭлементНадпись   = Элементы.Найти("Надпись_" + ИмяЭлемента);
	ЭлементТекущее   = Элементы.Найти("Текущее_" + ИмяЭлемента);
	ЭлементТребуется = Элементы.Найти("Требуется_" + ИмяЭлемента);
	ЭлементКартинка  = Элементы.Найти("Картинка_" + ИмяЭлемента);
	Проверка         = Неопределено;
	
	Если ЭлементНадпись <> Неопределено Тогда
		ЭлементНадпись.Видимость = Отображать;
	КонецЕсли;
	
	Если ЭлементТекущее <> Неопределено Тогда
		ЭлементТекущее.Видимость = Отображать;
		ЭлементТекущее.Заголовок = ЗаголовокТекущее;
	КонецЕсли;
	
	Если ЭлементТребуется <> Неопределено Тогда
		ЭлементТребуется.Видимость = Отображать;
		ЭлементТребуется.Заголовок = ЗаголовокТребуется;
	КонецЕсли;
	
	Если ЭлементКартинка <> Неопределено Тогда
		ЭлементКартинка.Видимость = Отображать;
		ЭлементКартинка.Картинка  = ?(ДанныеСтроки.Свойство("Проверка_" + ИмяЭлемента, Проверка), ?(Проверка, Элементы.КартинкаГотов.Картинка, Элементы.КартинкаНеГотов.Картинка), Новый Картинка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьДанныеПоАвтомобилю();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Закрыть(МожноВыдавать);
	
КонецПроцедуры


