
Процедура ДобавитьЗапись(РабочийЛист)Экспорт 
	Если ТипЗнч(РабочийЛист) <> Тип("ДокументСсылка.РабочийЛист") И
		 ТипЗнч(РабочийЛист) <> Тип("ДокументОбъект.РабочийЛист")Тогда
		
		Возврат;
	КонецЕсли;
	МенеджерЗаписи 				= СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период		= ТекущаяДата();
	МенеджерЗаписи.РабочийЛист	= РабочийЛист;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		СтандартныеРеквизиты = Метаданные.Документы.РабочийЛист.СтандартныеРеквизиты;
		Реквизиты = Метаданные.Документы.РабочийЛист.Реквизиты;
		СтруктураОбъекта = Новый Структура;
		Для Каждого СтандартныйРеквизит Из СтандартныеРеквизиты Цикл
			СтруктураОбъекта.Вставить(СтандартныйРеквизит.Имя,РабочийЛист[СтандартныйРеквизит.Имя]);
		КонецЦикла;
		Для Каждого Реквизит Из Реквизиты Цикл
			СтруктураОбъекта.Вставить(Реквизит.Имя,РабочийЛист[Реквизит.Имя]);
		КонецЦикла;
		МенеджерЗаписи.Период					= ТекущаяДата();
		МенеджерЗаписи.РабочийЛист				= РабочийЛист;
		МенеджерЗаписи.ВсеДанныеРабочегоЛиста	= ЗначениеВСтрокуВнутр(СтруктураОбъекта);
		МенеджерЗаписи.Записать();
	КонецЕсли;	
КонецПроцедуры

Функция ПолучитьЗапись(РабочийЛист)Экспорт
	МенеджерЗаписи	= СоздатьНаборЗаписей();
	МенеджерЗаписи.Отбор.РабочийЛист.Установить(РабочийЛист);
	МенеджерЗаписи.Прочитать();
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Период"							,Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),"Дата создания записи");
	ТаблицаЗначений.Колонки.Добавить("РабочийЛист"						,Новый ОписаниеТипов("ДокументСсылка.РабочийЛист"),"Рабочий лист");
	ТаблицаЗначений.Колонки.Добавить("ВсеДанныеРабочегоЛиста"			,Новый ОписаниеТипов("Строка"));
	ТаблицаЗначений.Колонки.Добавить("ВсеДанныеРабочегоЛистаСтруктура"	,Новый ОписаниеТипов("Структура"));
	ТаблицаЗначений.Колонки.Добавить("КоличествоКолонок"				,Новый ОписаниеТипов("Число"));
	
	Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.Количество() <> 0 Тогда 
		Для Каждого Строка Из МенеджерЗаписи Цикл
			НоваяСтрока = ТаблицаЗначений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			НоваяСтрока.ВсеДанныеРабочегоЛистаСтруктура = ЗначениеИзСтрокиВнутр(НоваяСтрока.ВсеДанныеРабочегоЛиста);
			НоваяСтрока.КоличествоКолонок				= НоваяСтрока.ВсеДанныеРабочегоЛистаСтруктура.Количество(); 
		КонецЦикла;                                                                                                 
		ПоискМаксимальногоКоличестваКолонокИСоздание(ТаблицаЗначений);
		ЗаполнитьСтрокиТаблицы(ТаблицаЗначений);
		УдалитьКолонкиТаблицы(ТаблицаЗначений);
	КонецЕсли;
КонецФункции

Процедура ПоискМаксимальногоКоличестваКолонокИСоздание(ТаблицаЗначений)
	КоличествоКолонок = 0;
	ТекущаяСтрока 	  = ТаблицаЗначений[0];
	Для Каждого Строка Из ТаблицаЗначений Цикл
		Если Строка.КоличествоКолонок > ТекущаяСтрока.КоличествоКолонок Тогда
			ИндексТекущейСтроки = ТаблицаЗначений.Индекс(Строка); 
			ТекущаяСтрока		= ТаблицаЗначений[ИндексТекущейСтроки];
		КонецЕсли;
	КонецЦикла;	 
	
	Для Каждого ДанныеКолонки Из ТекущаяСтрока.ВсеДанныеРабочегоЛистаСтруктура Цикл
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(ДанныеКолонки.Значение));
		ТаблицаЗначений.Колонки.Добавить(ДанныеКолонки.Ключ,Новый ОписаниеТипов(МассивТипов));
	КонецЦикла; 
		
	УдалитьКолонкиТаблицы(ТаблицаЗначений);	
КонецПроцедуры 

Процедура ЗаполнитьСтрокиТаблицы(ТаблицаЗначений)
	Для Каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
		Для Каждого СтрокаСтруктуры Из СтрокаТаблицы.ВсеДанныеРабочегоЛистаСтруктура Цикл
			СтрокаТаблицы[СтрокаСтруктуры.Ключ] = СтрокаСтруктуры.Значение;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура УдалитьКолонкиТаблицы(ТаблицаЗначений)
	ТаблицаЗначений.Колонки.Удалить("ВсеДанныеРабочегоЛиста");
	ТаблицаЗначений.Колонки.Удалить("ВсеДанныеРабочегоЛистаСтруктура");
	ТаблицаЗначений.Колонки.Удалить("КоличествоКолонок");
КонецПроцедуры