Перем НеИзменятьАвтора Экспорт; // Признак по которому не изменяется автор

Процедура ПередЗаписью(Отказ, Замещение)
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	Если НеИзменятьАвтора Тогда
		Возврат;
	КонецЕсли;
 	
	Для Каждого Запись Из ЭтотОбъект Цикл
		//Бондаренко++ 20260312
		Если  РольДоступна("ПолныеПрава") Тогда
			//Этих пользователей не проверяем
		ИначеЕсли обПраво("НеПроверятьДокументВыполнения") Тогда
			//Этих пользователей также не проверяем
		Иначе	
			Если Не обЗначениеНеЗаполнено(Запись.ДокументВыполнения) Тогда
				Если Запись.ДокументВыполнения.ВидРемонта <> Справочники.ВидыРемонта.ГарантияПроизводителя Тогда
					#Если НаКлиенте Тогда
						СМГ_Сообщить("ОШИБКА! В "+СокрЛП(Запись.ДокументВыполнения)+" вид ремонта "+Запись.ДокументВыполнения.ВидРемонта,СтатусСообщения.ОченьВажное);
					#КонецЕсли
					Отказ = Истина;
					Возврат;
				КонецЕсли;
				Если Запись.ДокументВыполнения.Автомобиль.VIN <> Запись.VIN Тогда
					#Если НаКлиенте Тогда
						СМГ_Сообщить("ОШИБКА! В "+СокрЛП(Запись.ДокументВыполнения)+" VIN "+СокрЛП(Запись.ДокументВыполнения.Автомобиль.VIN)+" не совпадает с "+СокрЛП(Запись.VIN),СтатусСообщения.ОченьВажное);
					#КонецЕсли
					Отказ = Истина;
					Возврат;
				КонецЕсли;
				Если Запись.ДокументВыполнения.Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
					#Если НаКлиенте Тогда
						СМГ_Сообщить("ОШИБКА! В "+СокрЛП(Запись.ДокументВыполнения)+" состояние "+СокрЛП(Запись.ДокументВыполнения.Состояние)+" не равно Закрыт",СтатусСообщения.ОченьВажное);
					#КонецЕсли
					Отказ = Истина;
					Возврат;
				КонецЕсли;
				Если Запись.ДокументВыполнения.СервиснаяКампания <> Запись.СервиснаяКампания Тогда
					#Если НаКлиенте Тогда
						СМГ_Сообщить("ОШИБКА! В "+СокрЛП(Запись.ДокументВыполнения)+" сервисная компания "+СокрЛП(Запись.ДокументВыполнения.СервиснаяКампания)+" не равна "+СокрЛП(Запись.СервиснаяКампания),СтатусСообщения.ОченьВажное);
					#КонецЕсли
					Отказ = Истина;
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		//Бондаренко-- 20260312
		Запись.Автор=ПараметрыСеанса.Пользователь;
	КонецЦикла;
КонецПроцедуры

НеИзменятьАвтора=Ложь;