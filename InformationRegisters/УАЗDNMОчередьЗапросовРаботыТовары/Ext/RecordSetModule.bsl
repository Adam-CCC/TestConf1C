Процедура ПередЗаписью(Отказ, Замещение)
	Если ЭтотОбъект.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	Для Каждого ТекСтрока из ЭтотОбъект Цикл
		ЧтениеJSON.УстановитьСтроку(ТекСтрока.ТелоЗапроса);
		Попытка
			стРаботаТовар = ПрочитатьJSON(ЧтениеJSON);
		Исключение
			ТекСтрока.НужноВыгрузить = Ложь;
			Продолжить;
		КонецПопытки;
		ТекСтрока.НужноВыгрузить = ЗначениеЗаполнено(стРаботаТовар.purchase_id);
	КонецЦикла;
КонецПроцедуры
