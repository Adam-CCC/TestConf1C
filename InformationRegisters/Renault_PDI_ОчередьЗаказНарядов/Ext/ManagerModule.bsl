Процедура ДобавитьЗапись(ЗаказНаряд) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.ЗаказНаряд = ЗаказНаряд;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Процедура УдалитьЗапись(ЗаказНаряд) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	НаборЗаписей = РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаказНаряд.Установить(ЗаказНаряд);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура УстановитьДатуОтправки(ЗаказНаряд, Дата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	НаборЗаписей = РегистрыСведений.Renault_PDI_ОчередьЗаказНарядов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаказНаряд.Установить(ЗаказНаряд);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Не ЗначениеЗаполнено(Запись.ДатаОтправкиВRF)Тогда
			Запись.ДатаОтправкиВRF = Дата;
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция ПолучитьОчереднуюЗапись() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_PDI_ОчередьЗаказНарядов.Период КАК Период,
		|	Renault_PDI_ОчередьЗаказНарядов.ЗаказНаряд
		|ИЗ
		|	РегистрСведений.Renault_PDI_ОчередьЗаказНарядов КАК Renault_PDI_ОчередьЗаказНарядов
		|ГДЕ
		|	Renault_PDI_ОчередьЗаказНарядов.ДатаОтправкиВRF = &ДатаОтправкиВRF
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	Запрос.УстановитьПараметр("ДатаОтправкиВRF", Дата(1,1,1));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗаказНаряд;
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции