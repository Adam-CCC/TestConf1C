Функция Поиск_Менеджера_По_ID(ID_Менеджера) Экспорт 
	
	Отбор.ID.Значение = ID_Менеджера;
	Отбор.ID.Использование = Истина;
	Прочитать();
	          
	Если Выбран() И Количество() <> 0 Тогда
		Возврат ЭтотОбъект[0].Сотрудник;
	Иначе
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;	
	
КонецФункции