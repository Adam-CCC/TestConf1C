Функция ЕстьПромоакции(Дата, НоменклатураМассив) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("НоменклатураМассив", НоменклатураМассив);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Renault_ПромоакцииСрезПоследних.Номенклатура,
	|	Renault_ПромоакцииСрезПоследних.Акция,
	|	Renault_ПромоакцииСрезПоследних.Значение
	|ИЗ
	|	РегистрСведений.Renault_Промоакции.СрезПоследних(
	|			&Дата,
	|			ДатаОкончания >= &Дата
	|				И Номенклатура В (&НоменклатураМассив)) КАК Renault_ПромоакцииСрезПоследних";
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПромоакции(Дата, Номенклатура) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_ПромоакцииСрезПоследних.Акция КАК Промо
	|ИЗ
	|	РегистрСведений.Renault_Промоакции.СрезПоследних(
	|			&Дата,
	|			ДатаОкончания >= &Дата
	|				И Номенклатура = &Номенклатура) КАК Renault_ПромоакцииСрезПоследних";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Промо");

КонецФункции

