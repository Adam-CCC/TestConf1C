
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Попытка
		ОбъектСсылка = ЗначениеИзСтрокиВнутр(Запись.ГУИДОбъекта);
		Если НЕ Renault_внОбщийМодуль.ЭтаСсылкаСуществуетВИБ(Запись.ГУИДОбъекта) Тогда
			ОбъектСсылка = "<Объект был физически удален>";
		Иначе			
			Элементы.ОбъектСсылка.КнопкаОткрытия = Истина;
		КонецЕсли;		
	Исключение
		ОбъектСсылка = "<Объект недоступен для открытия>";
		Элементы.ОбъектСсылка.КнопкаОткрытия = Ложь;
	КонецПопытки;
	
	Элементы.ОбъектСсылка.КнопкаВыбора = Ложь;
	Элементы.ОбъектСсылка.КнопкаОчистки = Ложь;
	
	Элементы.ДатаПросмотраТекст.Заголовок = ?(Запись.ДатаПросмотра = Дата(1, 1, 1), "Открыто в первый раз", "Просмотрено: " + Запись.ДатаПросмотра);
	ТолькоПросмотр = Истина;
	ТекущийЭлемент = Элементы.ОбъектСсылка;
КонецПроцедуры
