Функция ЭтоПервоеСобытие(Событие) 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Событие.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Событие КАК Событие
		|ГДЕ
		|	Событие.ДокументОснование = &ДокументОснование
		|	И Событие.Дата <= &ДатаСобытия";
	
	Запрос.УстановитьПараметр("ДатаСобытия"			, Событие.Дата);
	Запрос.УстановитьПараметр("ДокументОснование"	, Событие.ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	КоличествоЗаписей = РезультатЗапроса.Количество();
	Если КоличествоЗаписей = 0 Тогда
		Возврат Истина;
	ИначеЕсли КоличествоЗаписей = 1 Тогда
		СсылкаЗапроса = РезультатЗапроса[0].Ссылка;
		ТекущаяСсылка = Событие;
		Если СсылкаЗапроса = ТекущаяСсылка Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции  

Функция ЭтоПервыйВизит(Событие)
	Если Событие.ВидСобытия <> Перечисления.ВидыСобытий.ЛичнаяВстреча Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Событие.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Событие КАК Событие
		|ГДЕ
		|	Событие.ДокументОснование = &ДокументОснование
		|	И Событие.Дата <= &ДатаСобытия
		|	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ЛичнаяВстреча)";
	
	Запрос.УстановитьПараметр("ДатаСобытия"			, Событие.Дата);
	Запрос.УстановитьПараметр("ДокументОснование"	, Событие.ДокументОснование);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	КоличествоЗаписей = РезультатЗапроса.Количество();
	Если КоличествоЗаписей = 0 Тогда
		Возврат Истина;
	ИначеЕсли КоличествоЗаписей = 1 Тогда
		СсылкаЗапроса = РезультатЗапроса[0].Ссылка;
		ТекущаяСсылка = Событие;
		Если СсылкаЗапроса = ТекущаяСсылка Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

//Иванченко 20260608 ++
Функция ЭтоМаркетинговыйЛид(Событие)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(МаркетинговыеЛиды.Период) КАК Период
	|ИЗ
	|	РегистрСведений.МаркетинговыеЛиды КАК МаркетинговыеЛиды
	|ГДЕ
	|	МаркетинговыеЛиды.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И МаркетинговыеЛиды.Телефон = &Телефон
	|	И МаркетинговыеЛиды.Статус = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Завершено)");
    Запрос.УстановитьПараметр("ПодразделениеКомпании", Событие.ПодразделениеКомпании);
	КорректировкаНомера = СтрЗаменить(Событие.ПредставлениеТелефона,",", "");
	КорректировкаНомера = СтрЗаменить(КорректировкаНомера," ", "");
	КорректировкаНомера = СтрЗаменить(КорректировкаНомера,"+7", "8");	
    Запрос.УстановитьПараметр("Телефон", КорректировкаНомера);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если обЗначениеНеЗаполнено(Выборка.Период) ИЛИ (НачалоДня(ТекущаяДата()) - НачалоДня(Выборка.Период)) / 86400 > 30 Тогда
			ЭтоМаркетинговыйЛид = Истина;
		Иначе 
			ЭтоМаркетинговыйЛид = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЭтоМаркетинговыйЛид; 

КонецФункции

Функция ПолучитьИсточникМаркетинг(Событие)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(ВЫРАЗИТЬ(МаркетинговыеЛиды.РабочийЛистСобытие КАК Документ.Событие)) КАК РабочийЛист
	|ИЗ
	|	РегистрСведений.МаркетинговыеЛиды КАК МаркетинговыеЛиды
	|ГДЕ
	|	МаркетинговыеЛиды.ТипДокумента = ""Рабочий лист""
	|	И МаркетинговыеЛиды.Телефон = &Телефон
	|	И МаркетинговыеЛиды.РабочийЛистСобытие.ПодразделениеКомпании = &ПодразделениеКомпании
	|	И МаркетинговыеЛиды.РабочийЛистСобытие.Статус = ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Продажа)");
    Запрос.УстановитьПараметр("ПодразделениеКомпании", Событие.ПодразделениеКомпании);
	КорректировкаНомера = СтрЗаменить(Событие.ПредставлениеТелефона,",", "");
	КорректировкаНомера = СтрЗаменить(КорректировкаНомера," ", "");
	КорректировкаНомера = СтрЗаменить(КорректировкаНомера,"+7", "8");	
    Запрос.УстановитьПараметр("Телефон", КорректировкаНомера);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если обЗначениеНеЗаполнено(Выборка.РабочийЛист) Тогда
			ИсточникМаркетинг = Событие.ИсточникИнформации; 
		Иначе
			ИсточникМаркетинг = Выборка.РабочийЛист.Реклама;			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИсточникМаркетинг;
	
КонецФункции
