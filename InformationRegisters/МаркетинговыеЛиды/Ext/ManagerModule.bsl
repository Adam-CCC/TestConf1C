Процедура ДобавитьЗапись(РабочийЛистСобытие) Экспорт 
	Если ТипЗнч(РабочийЛистСобытие) = Тип("ДокументСсылка.РабочийЛист") Тогда
		СвойстваОбъекта = ПолучитьСвойстваРабочегоЛиста()
	ИначеЕсли ТипЗнч(РабочийЛистСобытие) = Тип("ДокументСсылка.Событие") Тогда 
		СвойстваОбъекта = ПолучитьСвойстваСобытия();
	Иначе
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи							= СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период					= ТекущаяДата();
	МенеджерЗаписи.РабочийЛистСобытие		= РабочийЛистСобытие[СвойстваОбъекта.РабочийЛистСобытие]; 
	//Иванченко 20260608 ++
	//МенеджерЗаписи.ПодразделениеКомпании	= РабочийЛистСобытие[СвойстваОбъекта.ПодразделениеКомпании];   
	//Иванченко 20260608 --	
	МенеджерЗаписи.Прочитать();
	
	Если МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	//Иванченко 20260611 ++
	Попытка
	//Иванченко 20260608 --
		МенеджерЗаписи.Период					= ТекущаяДата();
		МенеджерЗаписи.УникальныйИдентификатор	= Строка(РабочийЛистСобытие.УникальныйИдентификатор());
		Для Каждого Строка Из СвойстваОбъекта Цикл 
			Если Строка.Ключ = "Телефон" Тогда
				КорректировкаНомера = РабочийЛистСобытие[Строка.Значение];
				КорректировкаНомера = СтрЗаменить(КорректировкаНомера,",","");
				КорректировкаНомера = СтрЗаменить(КорректировкаНомера," ","");
				//Иванченко 20260608 ++
				КорректировкаНомера = СтрЗаменить(КорректировкаНомера,"+7","8");	
				//Иванченко 20260608 --
				МенеджерЗаписи[Строка.Ключ] = КорректировкаНомера;
			ИначеЕсли Строка.Ключ = "Бренд" Тогда
				Попытка
					МенеджерЗаписи[Строка.Ключ] = РабочийЛистСобытие.Модель.Марка;
				Исключение
					МенеджерЗаписи[Строка.Ключ] = "Нет в данном типе документа";
				КонецПопытки;
			ИначеЕсли Строка.Ключ = "ТипДокумента" Тогда
				Попытка
					МенеджерЗаписи[Строка.Ключ] = Строка(ТипЗнч(РабочийЛистСобытие));
				Исключение
					МенеджерЗаписи[Строка.Ключ] = "Нет в данном типе документа";
				КонецПопытки; 
				//Иванченко 20260608 ++ 
			ИначеЕсли Строка.Ключ = "ИсточникИнформации" Тогда
				МенеджерЗаписи.ИсточникCRM = РабочийЛистСобытие[Строка.Значение]; 
				//Иванченко 20260608 --	
			Иначе                                                   	
				Попытка
					МенеджерЗаписи[Строка.Ключ] = РабочийЛистСобытие[Строка.Значение];
				Исключение    
					МенеджерЗаписи[Строка.Ключ] = "Нет в данном типе документа";
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
		Если ТипЗнч(РабочийЛистСобытие) = Тип("ДокументСсылка.РабочийЛист") Тогда
			МенеджерЗаписи.РабочийЛистУникальныйИдентификатор = Строка(РабочийЛистСобытие.УникальныйИдентификатор())
		ИначеЕсли ТипЗнч(РабочийЛистСобытие) = Тип("ДокументСсылка.Событие") Тогда 
			МенеджерЗаписи.РабочийЛистУникальныйИдентификатор = Строка(РабочийЛистСобытие.ДокументОснование.УникальныйИдентификатор());
			МенеджерЗаписи.ПервичноеСобытие = ЭтоПервоеСобытие(РабочийЛистСобытие);
			МенеджерЗаписи.ПервичныйВизит	= ЭтоПервыйВизит(РабочийЛистСобытие);
			//Иванченко 20260608 ++   
			МенеджерЗаписи.ИсточникМаркетинг = ПолучитьИсточникМаркетинг(РабочийЛистСобытие); 
			МенеджерЗаписи.ЭтоМаркетинговыйЛид = ЭтоМаркетинговыйЛид(РабочийЛистСобытие); 
			
			Если РабочийЛистСобытие.Дозвонился = 0 Тогда
				
				Если РабочийЛистСобытие.КонтактНеСостоялся Тогда
					МенеджерЗаписи.УспешныйКонтакт = Ложь;	
				Иначе	
					СобытиеФорма = РабочийЛистСобытие.ПолучитьФорму();  
					МенеджерЗаписи.УспешныйКонтакт = Не СобытиеФорма.НеУдалосьСоединить;     
				КонецЕсли;
				
			ИначеЕсли РабочийЛистСобытие.Дозвонился = 1 Тогда 
				МенеджерЗаписи.УспешныйКонтакт = Истина; 
			Иначе
				МенеджерЗаписи.УспешныйКонтакт = Ложь; 
			КонецЕсли;		
			
			Если ТипЗнч(РабочийЛистСобытие.ДокументОснование) = Тип("ДокументСсылка.Событие") Тогда   
				Перем_Событие = РабочийЛистСобытие.ДокументОснование;
			Иначе
				Перем_Событие = РабочийЛистСобытие;
			КонецЕсли;
			
			Если ТипЗнч(Перем_Событие) = Тип("ДокументСсылка.ЗаявкаНаРемонт") Или ТипЗнч(Перем_Событие) = Тип("ДокументСсылка.РабочийЛистСервиса") Или ТипЗнч(Перем_Событие) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
				МенеджерЗаписи.ПризнакСервис = Истина;
			Иначе
				МенеджерЗаписи.ПризнакСервис = Ложь;
			КонецЕсли; 
			
			МенеджерЗаписи.ПризнакРобот = Ложь;
			
			Если РабочийЛистСобытие.ИсточникИнформации = Справочники.ИсточникиИнформации.НайтиПоКоду("ЦБ000149") ИЛИ РабочийЛистСобытие.ИсточникИнформации = Справочники.ИсточникиИнформации.НайтиПоНаименованию("BTL") Тогда
				МенеджерЗаписи.ПризнакBTL = Истина;
			Иначе 
				МенеджерЗаписи.ПризнакBTL = Ложь;
			КонецЕсли;	
			
			МенеджерЗаписи.ПричинаОтказа = РабочийЛистСобытие.ПричинаОтмены; 
			
			Если РабочийЛистСобытие.Дата = РабочийЛистСобытие.СМ_ДатаСоздания Тогда		
				МенеджерЗаписи.СозданЗаднимЧислом = Ложь;
			Иначе
				МенеджерЗаписи.СозданЗаднимЧислом = Истина;
			КонецЕсли;			
			
			//Иванченко 20260608 --
		КонецЕсли;
		
		МенеджерЗаписи.Записать(Ложь); 
	//Иванченко 20260608 ++
	Исключение
	КонецПопытки;
	//Иванченко 20260608 --  
		
КонецПроцедуры                 

Функция ПолучитьСвойстваРегистра()
