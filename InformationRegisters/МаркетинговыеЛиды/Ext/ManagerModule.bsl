Процедура ДобавитьЗапись_Событие_ТонкаяНастройка(Событие,Период,РабочийЛист = "",Состояние = "") Экспорт
	СвойстваСобытия = ПолучитьСвойстваСобытия();  
	
	МенеджерЗаписи							= СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период					= Период;    
	МенеджерЗаписи.РабочийЛистСобытие		= Событие[СвойстваСобытия.РабочийЛистСобытие]; 
	//Иванченко 20260608 ++
	//МенеджерЗаписи.ПодразделениеКомпании	= Событие[СвойстваСобытия.ПодразделениеКомпании];    
	//Иванченко 20260608 --
	МенеджерЗаписи.Прочитать(); 
	
	Если МенеджерЗаписи.Выбран() Тогда 
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи.Период	= Период;	
	Для Каждого Строка Из СвойстваСобытия Цикл
		Если Строка.Ключ = "Телефон" Тогда
			КорректировкаНомера = Событие[Строка.Значение];
			КорректировкаНомера = СтрЗаменить(КорректировкаНомера,",","");
			КорректировкаНомера = СтрЗаменить(КорректировкаНомера," ","");
			МенеджерЗаписи[Строка.Ключ] = КорректировкаНомера;
		ИначеЕсли Строка.Ключ = "ТипДокумента" Тогда
			Попытка
				МенеджерЗаписи[Строка.Ключ] = Строка(ТипЗнч(Событие));
			Исключение
				МенеджерЗаписи[Строка.Ключ] = "Нет в данном типе документа";
			КонецПопытки;
		Иначе                                                   	
			Попытка
				МенеджерЗаписи[Строка.Ключ] = Событие[Строка.Значение];
			Исключение    
				МенеджерЗаписи[Строка.Ключ] = "Нет в данном типе документа";
			КонецПопытки;
		КонецЕсли;	
	КонецЦикла; 
	МенеджерЗаписи.ПервичноеСобытие = ЭтоПервоеСобытие(Событие);
	МенеджерЗаписи.ПервичныйВизит	= ЭтоПервыйВизит(Событие);
	МенеджерЗаписи.РабочийЛистУникальныйИдентификатор = Строка(Событие.ДокументОснование.УникальныйИдентификатор());
	МенеджерЗаписи.УникальныйИдентификатор = Строка(Событие.УникальныйИдентификатор());
	Если Состояние <> "" Тогда
		МенеджерЗаписи.Статус = Состояние;
	КонецЕсли;
	Попытка
		МенеджерЗаписи.Записать(Ложь);
	Исключение    
		//Сообщить("Не обработан " + Событие);
	КонецПопытки;
КонецПроцедуры        

