Функция ЕстьОтветНаЗапрос(Знач СтрокаЗапрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Индекс1 = Найти(СтрокаЗапрос, "<sid>");
	Если Индекс1 > 0 Тогда
		Подстрока = Сред(СтрокаЗапрос, Индекс1, 43);
		СтрокаЗапрос = СтрЗаменить(СтрокаЗапрос, Подстрока, "ИД");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветыНаЗапросыUsedCars.Ответ
		|ИЗ
		|	РегистрСведений.Renault_ОтветыНаЗапросыUsedCars КАК ОтветыНаЗапросыUsedCars
		|ГДЕ
		|	ОтветыНаЗапросыUsedCars.Запрос = &Запрос
		|	И ОтветыНаЗапросыUsedCars.Момент >= &Период";
	Запрос.УстановитьПараметр("Запрос", СтрокаЗапрос);
	Запрос.УстановитьПараметр("Период", ТекущаяУниверсальнаяДатаВМиллисекундах() - 24*3600*1000);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ДобавитьОтветНаЗапрос(Знач СтрокаЗапрос, Знач СтрокаОтвет) Экспорт
	
	Индекс1 = Найти(СтрокаЗапрос, "<sid>");
	Если Индекс1 > 0 Тогда
		Подстрока = Сред(СтрокаЗапрос, Индекс1, 43);
		СтрокаЗапрос = СтрЗаменить(СтрокаЗапрос, Подстрока, "ИД");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Если ЕстьОтветНаЗапрос(СтрокаЗапрос) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.Renault_ОтветыНаЗапросыUsedCars.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Момент = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МенеджерЗаписи.Запрос = СтрокаЗапрос;
	МенеджерЗаписи.Ответ = СтрокаОтвет;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Функция ПолучитьОтветНаЗапрос(Знач СтрокаЗапрос) Экспорт
	
	Индекс1 = Найти(СтрокаЗапрос, "<sid>");
	Если Индекс1 > 0 Тогда
		Подстрока = Сред(СтрокаЗапрос, Индекс1, 43);
		СтрокаЗапрос = СтрЗаменить(СтрокаЗапрос, Подстрока, "ИД");
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не ЕстьОтветНаЗапрос(СтрокаЗапрос) Тогда	
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОтветыНаЗапросыUsedCarsСрезПоследних.Ответ
		|ИЗ
		|	РегистрСведений.Renault_ОтветыНаЗапросыUsedCars КАК ОтветыНаЗапросыUsedCarsСрезПоследних
		|ГДЕ
		|	ОтветыНаЗапросыUsedCarsСрезПоследних.Запрос = &Запрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОтветыНаЗапросыUsedCarsСрезПоследних.Момент УБЫВ";
	Запрос.УстановитьПараметр("Запрос", СтрокаЗапрос);
	Возврат  Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ответ")[0];
	
КонецФункции