#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//#Область СлужебныеПроцедурыИФункции

// Процедура добавляет запись в регистр по переданным значениям структуры.
Процедура ДобавитьЗапись(СтруктураЗаписи, Загрузка = Ложь) Экспорт
	
	DMS_ОбменДаннымиСДМСервер.ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "DMS_СоответствияОбъектовИнформационныхБаз", Загрузка);
	
КонецПроцедуры

// Процедура удаляет набор записей в регистре по переданным значениям структуры.
Процедура УдалитьЗапись(СтруктураЗаписи, Загрузка = Ложь) Экспорт
	
	DMS_ОбменДаннымиСДМСервер.УдалитьНаборЗаписейВРегистреСведений(СтруктураЗаписи, "DMS_СоответствияОбъектовИнформационныхБаз", Загрузка);
	
КонецПроцедуры

Функция ОбъектЕстьВРегистре(Объект, УзелИнформационнойБазы) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ 1
	|ИЗ
	|	РегистрСведений.DMS_СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
	|ГДЕ
	|	  СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы           = &УзелИнформационнойБазы
	|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника = &УникальныйИдентификаторИсточника
	|";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УзелИнформационнойБазы",           УзелИнформационнойБазы);
	Запрос.УстановитьПараметр("УникальныйИдентификаторИсточника", Объект);
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Процедура ДобавитьОбъектВФильтрРазрешенныхОбъектов(Знач Объект, Знач Получатель,Знач ЗначениеПриемника,Знач Представление) Экспорт
	
	Если Не ОбъектЕстьВРегистре(Объект, Получатель) Тогда        
		
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы", 			  		Получатель);
		СтруктураЗаписи.Вставить("УникальныйИдентификаторИсточника",  		Объект);
		СтруктураЗаписи.Вставить("ЗначениеПриемника", 				  		ЗначениеПриемника);
		СтруктураЗаписи.Вставить("ПредставлениеИсточника", 			  		Представление);
		СтруктураЗаписи.Вставить("УникальныйИдентификаторИсточникаСтрокой", СокрЛП(Объект.УникальныйИдентификатор()));
		
		ДобавитьЗапись(СтруктураЗаписи, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗначениеПриемника(Объект, УзелИнформационнойБазы) Экспорт 
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	СоответствияОбъектовИнформационныхБаз.ЗначениеПриемника КАК ЗначениеПриемника
		|ИЗ
		|	РегистрСведений.DMS_СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
		|ГДЕ
		|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &УзелИнформационнойБазы
		|	И СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника = &УникальныйИдентификаторИсточника";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УзелИнформационнойБазы",           УзелИнформационнойБазы);
	Запрос.УстановитьПараметр("УникальныйИдентификаторИсточника", Объект);
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗначениеПриемника;
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции // ПолучитьЗначениеприемника()

Функция ПолучитьУникальныйИдентификаторИсточникаПоЗначениюПриемника(ЗначениеПриемника, УзелИнформационнойБазы) Экспорт 
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК УникальныйИдентификаторИсточника
		|ИЗ
		|	РегистрСведений.DMS_СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
		|ГДЕ
		|	СоответствияОбъектовИнформационныхБаз.УзелИнформационнойБазы = &УзелИнформационнойБазы
		|	И СоответствияОбъектовИнформационныхБаз.ЗначениеПриемника = &ЗначениеПриемника";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УзелИнформационнойБазы",УзелИнформационнойБазы);
	Запрос.УстановитьПараметр("ЗначениеПриемника", 	   ЗначениеПриемника);
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.УникальныйИдентификаторИсточника.УникальныйИдентификатор();
	КонецЕсли; 
	
	Возврат Неопределено;
	
КонецФункции // ПолучитьУникальныйИдентификаторИсточникаПоЗначениюПриемника()
 
