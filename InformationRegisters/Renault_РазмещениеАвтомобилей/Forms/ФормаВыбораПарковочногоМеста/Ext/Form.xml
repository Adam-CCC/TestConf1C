	<Attributes>
		<Attribute name="ДинамическийСписок" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Динамический список</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>~ДинамическийСписок.ЗанятоМесто</Field>
				<Field>~ДинамическийСписок.ТекущийАвтомобиль</Field>
				<Field>ДинамическийСписок.ИндексКартинки</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Renault_РазмещениеАвтомобилей.Место КАК ПарковочноеМесто,
	Renault_РазмещениеАвтомобилей.Автомобиль,
	ВЫБОР
		КОГДА Renault_РазмещениеАвтомобилей.Автомобиль = ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
			ТОГДА 1
		КОГДА Renault_РазмещениеАвтомобилей.Автомобиль = &amp;Автомобиль
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ КАК ИндексКартинки
ИЗ
	РегистрСведений.Renault_РазмещениеАвтомобилей КАК Renault_РазмещениеАвтомобилей
ГДЕ
	Renault_РазмещениеАвтомобилей.Склад = &amp;Склад
	И ВЫБОР
			КОГДА &amp;Свободные = ИСТИНА
				ТОГДА Renault_РазмещениеАвтомобилей.Автомобиль = ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
			ИНАЧЕ ИСТИНА
		КОНЕЦ</QueryText>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
