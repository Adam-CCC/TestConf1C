&НаСервере
Процедура ДополнитьНаСервере()
	
	РеквизитыЗаписи = ЭтаФорма.ПолучитьРеквизиты("Запись");
	Для Каждого Ресурс Из РеквизитыЗаписи Цикл
		Если Найти(Ресурс.Имя,"Цвет") = 1 Тогда
			ТекТип = Новый ОписаниеТипов("Цвет");
			Поиск = Элементы.Найти(Ресурс.Имя);
			Если Не(Поиск = Неопределено) Тогда
				Поиск.УстановитьДействие("ПриИзменении","ПриИзмененииПоляЦвета");
				Поиск.УстановитьДействие("Очистка","ПоляЦветаОчистка");
            КонецЕсли;
			
		ИначеЕсли Найти(Ресурс.Имя, "Высота") = 1 Тогда
			ТекТип = Новый ОписаниеТипов("Число");
			Поиск = Элементы.Найти(Ресурс.Имя);
			Если Не(Поиск = Неопределено) Тогда
				Поиск.УстановитьДействие("ПриИзменении","ПриИзмененииПоляВысоты");
				Поиск.УстановитьДействие("Очистка","ПоляВысотОчистка");
			КонецЕсли;
			
		КонецЕсли;	
			
	КонецЦикла;
	ВостановитьВсеЦвета();
	
	НаборПоВидамРемонта = РегистрыСведений.DMS_ЦветаВидовРемонта.СоздатьНаборЗаписей();
	НаборПоВидамРемонта.Отбор.Пользователь.Установить(Запись.Пользователь);
	НаборПоВидамРемонта.Прочитать();
	
	Для Каждого Стр Из НаборПоВидамРемонта Цикл
		НовСтр = ВидыРемонта.Добавить();
		НовСтр.ВидРемонта = Стр.ВидРемонта;
		НовСтр.ЦветФона   = Renault_Открытый.ПолучитьЦветПоСтроке(Стр.ЦветФона);
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Функция ИмяСвязанногоРеквизитаЦвета(ИскомоеИмя,РеквизитыФормы = Неопределено)
	
	Если не ЗначениеЗаполнено(РеквизитыФормы) Тогда
		РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();
	КонецЕсли;
	
	Для Каждого Рекв Из РеквизитыФормы Цикл
		Если Рекв.Имя = ИскомоеИмя Тогда
			Возврат Рекв.Имя;
		КонецЕсли;
	КонецЦикла;
    Возврат Неопределено;
	
КонецФункции


