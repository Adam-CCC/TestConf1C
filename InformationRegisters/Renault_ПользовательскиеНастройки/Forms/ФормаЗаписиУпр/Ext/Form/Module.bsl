&НаКлиенте
Процедура ПоляЦветаОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЦветаУмолч = СтруктураЦветовПоУмолчанию();
	
	// { DMSREN-302 Болдарев Д.Е. от 10.02.2020  
	// Ошибка, если цвет по умолчанию не задан
	// ЭтаФорма[Элемент.Имя] = ЦветаУмолч[Элемент.Имя];
	ЭтаФорма[Элемент.Имя] = ?(ЦветаУмолч.Свойство(Элемент.Имя), ЦветаУмолч[Элемент.Имя], Новый Цвет());
	// } DMSREN-302 Болдарев Д.Е. от 10.02.2020. 
	
	ПриИзмененииПоляЦвета(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПоляВысотОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЦветаУмолч = СтруктураВысотПоУмолчанию();
	ЭтаФорма[Элемент.Имя] = ЦветаУмолч[Элемент.Имя];
	ПриИзмененииПоляВысоты(Элемент);
КонецПроцедуры


&НаКлиенте
Процедура ВостановитьВсеПоУмолчанию(Команда)
	ВостановитьВсеЦвета(Истина);
	ВосстановитьВсеВысоты(Истина);
	ВосстановитьПрочиеНастройки(Истина);
	
КонецПроцедуры

Процедура ОтобразитьВсеЦвета()
	
	РеквизитыЗаписи = ЭтаФорма.ПолучитьРеквизиты("Запись");
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты();	
	
	Для Каждого Ресурс Из РеквизитыЗаписи Цикл
		Если Найти(Ресурс.Имя,"Цвет") = 1 Тогда
			ТекЗначение = Запись[Ресурс.Имя];
			Если ТипЗнч(ТекЗначение) = Тип("Строка") Тогда
				Если ЗначениеЗаполнено(Запись[Ресурс.Имя]) Тогда
					ИмяРекв = ИмяСвязанногоРеквизитаЦвета(Ресурс.имя,РеквизитыФормы);
					Если ЗначениеЗаполнено(ИмяРекв) тогда
						ЭтаФорма[ИмяРекв] = Renault_Открытый.ПолучитьЦветПоСтроке(Запись[Ресурс.Имя]);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли Найти(Ресурс.Имя, "Высота") = 1 Тогда
			ТекЗначение = Запись[Ресурс.Имя];
			Если ТипЗнч(ТекЗначение) = Тип("Число") Тогда
				Если ЗначениеЗаполнено(Запись[Ресурс.Имя]) Тогда
					ИмяРекв = ИмяСвязанногоРеквизитаЦвета(Ресурс.имя,РеквизитыФормы);
					Если ЗначениеЗаполнено(ИмяРекв) тогда
						ЭтаФорма[ИмяРекв] = Запись[Ресурс.Имя];
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ВостановитьВсеЦвета(ЗаменятьЦвета = ЛОЖЬ)
	
	ЦветаПоУм = СтруктураЦветовПоУмолчанию();
	Для Каждого Цвет Из ЦветаПоУм Цикл
		Если ЗаменятьЦвета = Истина ИЛИ 
			(Не ЗначениеЗаполнено(Запись[Цвет.Ключ])) Тогда
			Запись[Цвет.Ключ] = Renault_Открытый.ЦветВСтроку(Цвет.Значение);
		КонецЕсли;
	КонецЦикла;	
	ОтобразитьВсеЦвета();

	
КонецПроцедуры 

Процедура ВосстановитьВсеВысоты(ЗаменятьВысоты = Ложь)
	
	ВысотыПоУм = СтруктураВысотПоУмолчанию();
	
	Для Каждого Выс из ВысотыПоУм Цикл
		
		Запись[Выс.Ключ] = Выс.Значение;
		
	КонецЦикла;
	ОтобразитьВсеЦвета();

	
КонецПроцедуры

Процедура ВосстановитьПрочиеНастройки(ЗаменятьНастройки = Ложь)
	
	ЭтаФорма.ПросмотрЦветовДругихПользователей = Ложь;
	
КонецПроцедуры

Функция СтруктураВысотПоУмолчанию();
	
	СтруктураВысот = Новый Структура;

	СтруктураВысот.Вставить("ВысотаСтрокиМастера", 12);
	СтруктураВысот.Вставить("ВысотаСтрокиЦех", 20);
	СтруктураВысот.Вставить("ВысотаСтрокимойка", 12);
	СтруктураВысот.Вставить("ВысотаСтрокиПодменка", 12);
	
	Возврат СтруктураВысот;
	
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(Запись.Пользователь) Тогда
		Запись.Пользователь = ПараметрыСеанса.Пользователь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦветНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РедактируемыйЦвет", ЭтаФорма[Элемент.Имя]);
	
	//ОткрытьФорму("Обработка.Renault_ФормаВыбораЦвета.Форма.ФормаВыбораУправляемая", ПараметрыОткрытия); 
	ФормаВыбора = Обработки.Renault_ФормаВыбораЦвета.Создать().ПолучитьФорму("ФормаВыбораОбычная");
	ФормаВыбора.РедактируемыйЦвет = ЭтаФорма[Элемент.Имя];
	
	НовыйЦвет = ФормаВыбора.ОткрытьМодально();
	
	Если НовыйЦвет<>Неопределено Тогда	
		ЭтаФорма[Элемент.Имя] = НовыйЦвет;		
		Запись[Элемент.Имя] = Renault_Открытый.ЦветВСтроку(НовыйЦвет);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НаборПоВидамРемонта = РегистрыСведений.DMS_ЦветаВидовРемонта.СоздатьНаборЗаписей();
	НаборПоВидамРемонта.Отбор.Пользователь.Установить(ТекущийОбъект.Пользователь);
	НаборПоВидамРемонта.Прочитать();
	НаборПоВидамРемонта.Очистить();
	
	Для Каждого Стр Из ВидыРемонта Цикл
		НовСтр = НаборПоВидамРемонта.Добавить();
		НовСтр.Пользователь = ТекущийОбъект.Пользователь;
		НовСтр.ВидРемонта = Стр.ВидРемонта;
		НовСтр.ЦветФона   =  Renault_Открытый.ЦветВСтроку(Стр.ЦветФона);
	КонецЦикла;
	
	НаборПоВидамРемонта.Записать();
		
КонецПроцедуры
