
Процедура НормализоватьКонтакт(СтрокаИсточника) Экспорт
	
	Если СтрокаИсточника = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаИсточника.Представление) Тогда
		Возврат;
	КонецЕсли;
		
	Если СтрокаИсточника.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
		
		Нормалды = НормализоватьНомерТелефона(СтрокаИсточника.Представление);
		
		Если СтрДлина(Нормалды) < 4 Тогда
			Возврат;
		КонецЕсли; 
		
		Запись = РегистрыСведений.Renault_НормализованныеКонтактыДляПоиска.СоздатьМенеджерЗаписи();
		
		Запись.Объект  = СтрокаИсточника.Объект;
		Запись.Данные  = Нормалды;
		Запись.Телефон = Нормалды;  //DMS
		Запись.Записать();
		
		
	ИначеЕсли СтрокаИсточника.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
	    //DMS+
		АдресЭлектроннойПочты = СокрЛП(СтрокаИсточника.Представление);
		
		НедопустимыеСимволы = "!,#,$,%,^,&,*,(,),+,`,~,|,\,/,=,";
		
		СообщениеНедопустимыеСимволы = НСтр("ru = 'Недопустимый символ ""%1"" в адресе электронной почты ""%2""'");
		СообщениеНеверныйФорматПочтовогоАдреса = НСтр("ru = 'Некорректный адрес электронной почты ""%1""'");
		
		МассивНедопустимыхСимволов = Renault_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(НедопустимыеСимволы,",");
		
		ЕстьОшибка = Ложь;
		
		Для каждого НедопустимыйСимвол Из МассивНедопустимыхСимволов Цикл
		
			Если Найти(АдресЭлектроннойПочты,НедопустимыйСимвол) > 0 Тогда
			
				СтрокаОшибки = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеНедопустимыеСимволы,НедопустимыйСимвол,АдресЭлектроннойПочты);	
			    Сообщить(СтрокаОшибки);
				ЕстьОшибка = Истина;
				
			КонецЕсли; 
		
		КонецЦикла; 
		
		Если Найти(АдресЭлектроннойПочты,"@")<2 Тогда
			
			СтрокаОшибки = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеНеверныйФорматПочтовогоАдреса,АдресЭлектроннойПочты);	
			Сообщить(СтрокаОшибки);
			ЕстьОшибка = Истина;
			
		КонецЕсли; 
		
		Если ЕстьОшибка Тогда
			Возврат;
		КонецЕсли; 
	    //DMS-
		
		Запись = РегистрыСведений.Renault_НормализованныеКонтактыДляПоиска.СоздатьМенеджерЗаписи();
		
		Запись.Объект = СтрокаИсточника.Объект;
		Запись.Данные = СтрокаИсточника.Представление;
		Запись.АдресЭлектроннойПочты = СтрокаИсточника.Представление;  //DMS
		Запись.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Функция НормализоватьНомерТелефона(Телефон) Экспорт
	
	Фрагмент = СокрЛП(Телефон);
	
	СтрокаЦифр = "0123456789";
	
	НомерТелефона = "";
	
 	Для А = 1 По СтрДлина(Фрагмент) Цикл
		Символ = Сред(Фрагмент, А, 1);
		Если Найти(СтрокаЦифр,Символ) <> 0 Тогда
			НомерТелефона = НомерТелефона + Символ; 
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(НомерТелефона) Тогда
		Возврат НомерТелефона;
	КонецЕсли; 
	
	Если Найти(НомерТелефона, "7") = 1 ИЛИ Найти(НомерТелефона, "8") = 1 Тогда
		
		НомерТелефона = Прав(НомерТелефона, СтрДлина(НомерТелефона) - 1);
		
	КонецЕсли;

	Возврат НомерТелефона;
	
КонецФункции

Процедура НормализоватьВсеКонтакты(Клиент = Неопределено) Экспорт	
	
	 Запрос = Новый Запрос;
	 Запрос.УстановитьПараметр("Объект", Клиент);
	 Запрос.УстановитьПараметр("ПоВсем", Клиент = Неопределено);
	 Запрос.Текст = "ВЫБРАТЬ
	                |	*
	                |ИЗ
	                |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                |ГДЕ
	                |	(КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	                |			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	                |	И (КонтактнаяИнформация.Объект = &Объект
	                |			ИЛИ &ПоВсем)";
					
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		 НормализоватьКонтакт(Выборка);
	КонецЦикла;	
	
КонецПроцедуры