//служеюные функции
//#Область СлужебныеФункции
Функция ПроверкаЗаполненияРЛ() //для области приминения Продажи И Сервис IDK(рабочий лист) обязательно должен быть заполнен
	
	Если Объект.IDK>0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Объект.ВидСобытия.ОбластиПрименения.Найти(Перечисления.Renault_ОбластиПрименения.Продажи,"Область")=Неопределено 
		И Объект.ВидСобытия.ОбластиПрименения.Найти(Перечисления.Renault_ОбластиПрименения.Сервис,"Область")=Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли
	
КонецФункции

Функция НайтиСвязанныйДокумент(ВидДокумента,ИмяРеквизитаIDK)
	
	Если Объект.IDK=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос=Новый Запрос("Выбрать Ссылка Из Документ."+ВидДокумента+" ГДЕ "+ИмяРеквизитаIDK+"=&IDK");
	Запрос.УстановитьПараметр("IDK",Объект.IDK);
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка
	
КонецФункции

Функция ОбластиПрименения()
	
	Возврат Объект.ОбластиПрименения.Выгрузить().ВыгрузитьКолонку("ОбластьПрименения");
	
КонецФункции

Функция СписокСостояний()
	
	Сп = Новый СписокЗначений;
	Запрос = Новый Запрос("Выбрать Ссылка Из Справочник.Renault_Состояния Где НЕ ПометкаУдаления");
	Для Каждого Эл Из Запрос.Выполнить().Выгрузить() Цикл
		Сп.Добавить(Эл.Ссылка,""+Эл.Ссылка,?(Объект.Состояние=Эл.Ссылка,Истина,Ложь))
	КонецЦикла;
	Возврат Сп;
	
КонецФункции

Функция СписокВидовСобытий()
	
	Возврат Справочники.CRM_ВидыСобытий.СписокВидовСобытий(Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластямПрименения(ОбластиПрименения(),"Создание"),Объект.ВидСобытия);
	
КонецФункции

Функция УстановитьНаименованиеЗадачи(ВидСобытия)
	
	Задачи.Renault_События.УстановитьНаименованиеЗадачи(Объект,ВидСобытия);
	
КонецФункции

Функция ПредопределенноеСобытие(Имя)
	
	Возврат Справочники.CRM_ВидыСобытий[Имя];
	
КонецФункции

