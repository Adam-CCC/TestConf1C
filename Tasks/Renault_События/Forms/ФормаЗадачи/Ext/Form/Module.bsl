&НаКлиенте
Процедура ВыборСвязанногоДокумента(Парам1,Парам2) Экспорт
	Если Парам1 <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Объект,Парам1);
		ВремяНачала = Парам1.Дата;
		ВремяОкончания = Парам1.ДатаЗакрытия
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура кнСостояниеЗадачи(Команда)
	
	Парам=Новый Структура;
	Парам.Вставить("Список",СписокСостояний());
	Парам.Вставить("Заголовок","Состояние события");
	Парам.Вставить("МножественныйВыбор",Ложь);
	//Парам.Вставить("КоличествоЭлементовВСтроке",5);
	Парам.Вставить("ШиринаЭлемента",14);
	Парам.Вставить("ВысотаЭлемента",2);
	Оповещение=Новый ОписаниеОповещения("ИзменитьСостояние",ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
	
КонецПроцедуры

Процедура ИзменитьСостояние(Парам1,Парам2) Экспорт
	
	Если Парам1=Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.Состояние=Парам1; 
	Модифицированность=Истина;
	УправлениеЭлементами();
	
КонецПроцедуры

&НаКлиенте
Процедура кнПринятьКИсполнению(Команда)
	ПринятьКИсполнению();
КонецПроцедуры

Процедура ПринятьКИсполнению() 
	
	ЭтотОбъект=РеквизитФормыВЗначение("Объект");
	Если Задачи.Renault_События.ПринятьКИсполнению(ЭтотОбъект,Renault_ОбщиеФункцииСервер.ТекущийПользователь()) Тогда
		ЗначениеВРеквизитФормы(ЭтотОбъект,"Объект");
		//Если НЕ Объект.Сотрудник.Пустая() Тогда Адресация=4 КонецЕсли;
		УправлениеЭлементами();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура кнОтменитьПринятиеКИсполнению(Команда)
	ОтменитьПринятиеКИсполнению();
КонецПроцедуры

Процедура ОтменитьПринятиеКИсполнению()
	
	ЭтотОбъект=РеквизитФормыВЗначение("Объект");
	Если Задачи.Renault_События.ОтменитьПринятиеКИсполнению(ЭтотОбъект,Renault_ОбщиеФункцииСервер.ТекущийПользователь()) Тогда
		ЗначениеВРеквизитФормы(ЭтотОбъект,"Объект");
		УправлениеЭлементами();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура кнВыполнитьОтменитьВыполнение(Команда) 
	
	Если Объект.Ссылка.Пустая() Тогда
		Сообщить("Задача не записана",СтатусСообщения.Внимание);
		Возврат;
	КонецЕсли;
	Если НЕ ВыполнитьОтменитьВыполнение() Тогда
		ОткрытьЦельЗадачи();
	Иначе
		Закрыть();
	КонецЕсли  //если цель задачи не достигнута открываем объект задачи для выполнения
	
КонецПроцедуры

Функция ВыполнитьОтменитьВыполнение()
	
	ТекЗадача=РеквизитФормыВЗначение("Объект");
	Если Объект.Выполнена Тогда
		Результат=Задачи.Renault_События.ОтменитьВыполнениеЗадачи(ТекЗадача);
	ИначеЕсли ТипЗнч(Объект) = ТИп("СправочникСсылка.Renault_CommunicationCenter_СхемыОбзвона") Тогда
		Результат = Ложь;
	Иначе
		Результат=Задачи.Renault_События.ВыполнитьЗадачу(ТекЗадача.Ссылка,Renault_ОбщиеФункцииСервер.ТекущийПользователь());
	КонецЕсли;
	Возврат Результат;
	//Если Результат Тогда 
	//	ЗначениеВРеквизитФормы(ЭтотОбъект,"Объект");
	//	УправлениеЭлементами();
