&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//определение вида разрешения ("Создание","Просмотр","Редактирование") - редактирование проверим при записи
	ВидРазрешения=?(Объект.Ссылка.Пустая(),"Создание","Просмотр");
	
	Если Параметры.Свойство("Дата") Тогда Объект.Дата=Параметры.Дата КонецЕсли;
	Если Параметры.Свойство("ДатаЗакрытия") Тогда Объект.ДатаЗакрытия=Параметры.ДатаЗакрытия КонецЕсли;
	
	ВремяНачала=Объект.Дата;
	ВремяОкончания=Объект.ДатаЗакрытия;
	
	//для нового события может быть переданы разрешенныые области применения события
	Если Параметры.Свойство("ОбластиПрименения") Тогда 
		Если ТипЗнч(Параметры.ОбластиПрименения)=Тип("Массив") или ТипЗнч(Параметры.ОбластиПрименения)=Тип("СписокЗначений") Тогда
			Для Каждого Эл Из Параметры.ОбластиПрименения Цикл Объект.ОбластиПрименения.Добавить().ОбластьПрименения=Эл КонецЦикла
		ИначеЕсли ТипЗнч(Параметры.ОбластиПрименения)=Тип("ПеречислениеСсылка.Renault_ОбластиПрименения") Тогда 
			Объект.ОбластиПрименения.Добавить().ОбластьПрименения=Параметры.ОбластиПрименения
		КонецЕсли;
	Иначе
		Для Каждого Эл Из Перечисления.Renault_ОбластиПрименения Цикл Объект.ОбластиПрименения.Добавить().ОбластьПрименения=Эл КонецЦикла;
	КонецЕсли;
	
	//определение вида события
	Если Параметры.Свойство("ВидСобытия") Тогда Объект.ВидСобытия=Параметры.ВидСобытия 
	//ИначеЕсли Объект.ВидСобытия.Пустая() Тогда //вид события из переданного списка ОбластиПрименения
	//	РазрешенныеВидыСобытий=Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластямПрименения(ОбластиПрименения(),ВидРазрешения);
	//	Объект.ВидСобытия=?(РазрешенныеВидыСобытий.Найти(Справочники.CRM_ВидыСобытий.Прочее)<>Неопределено,Справочники.CRM_ВидыСобытий.Прочее,
	//		?(РазрешенныеВидыСобытий.Количество()>0,РазрешенныеВидыСобытий[0],"")
	//	)
	КонецЕсли;
	
	//Если Справочники.CRM_ВидыСобытий.РазрешенныеСобытия(ВидРазрешения).Найти(Объект.ВидСобытия)=Неопределено Тогда
	//	Отказ=Истина;
	//	Сообщить("Нет прав <"+ВидРазрешения+"> по виду события "+Объект.ВидСобытия,СтатусСообщения.Внимание);
	//КонецЕсли;
	
	//разрешение редактирования
	Если ВидРазрешения="Просмотр" И Объект.Автор<>Renault_ОбщиеФункцииСервер.ТекущийПользователь() И Объект.Сотрудник<>Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник
		И Справочники.CRM_ВидыСобытий.РазрешенныеСобытия("Редактирование").Найти(Объект.ВидСобытия)=Неопределено Тогда
		ТолькоПросмотр=Истина;
		Для Каждого Эл Из Элементы Цикл Попытка Эл.Доступность=Ложь Исключение КонецПопытки КонецЦикла;
	КонецЕсли;
	
	//ограничение вида события по области применения
	//Если Параметры.Свойство("ОбластьПрименения") Тогда
	//	Элементы.ВидСобытия.СписокВыбора.ЗагрузитьЗначения(Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластиПрименения(Параметры.ОбластьПрименения,ВидРазрешения));
	//КонецЕсли;
	
	//первоначальное заполнение
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Автор=Renault_ОбщиеФункцииСервер.ТекущийПользователь();
		Права=Renault_ОбщиеФункции.ПраваПользователя(Renault_ОбщиеФункцииСервер.ТекущийПользователь());
		
		//если область применения не задана, то по-умолчанию "Общие", но вообще это не правильно, т.к. она должна быть определена при создании и зависить от контекста
		Если ОбластиПрименения().Количество()=0 Тогда Объект.ОбластиПрименения.Добавить().ОбластьПрименения=Перечисления.Renault_ОбластиПрименения.Общие КонецЕсли;
		
		Если Объект.Сотрудник.Пустая() Тогда Объект.Сотрудник=Renault_ОбщиеФункции.СотрудникПользователя(ПараметрыСеанса.Пользователь); КонецЕсли;
		Если Объект.Отдел.Пустая() Тогда Объект.Отдел=Права.Отдел КонецЕсли;
		Если Объект.Подразделение.Пустая() Тогда Объект.Подразделение=Объект.Сотрудник.Подразделение КонецЕсли;
		Если Объект.ДилерскийЦентр.Пустая() Тогда Объект.ДилерскийЦентр=Права.ДилерскийЦентр КонецЕсли;
		Если Параметры.Свойство("IDK") Тогда Объект.IDK = Параметры.IDK КонецЕсли;
		Если Параметры.Свойство("Контрагент") Тогда Объект.Контрагент = Параметры.Контрагент КонецЕсли;		
	КонецЕсли;	
	
	Если НЕ Объект.Сотрудник.Пустая() Тогда Адресация=4
	ИначеЕсли НЕ Объект.Отдел.Пустая() Тогда Адресация=3
	ИначеЕсли НЕ Объект.Подразделение.Пустая() Тогда Адресация=2
	Иначе Адресация=1
	КонецЕсли;	
	
	УправлениеЭлементами();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.Дата=НачалоДня(Объект.Дата)+Час(ВремяНачала)*3600+Минута(ВремяНачала)*60;
	Объект.ДатаЗакрытия=НачалоДня(Объект.ДатаЗакрытия)+Час(ВремяОкончания)*3600+Минута(ВремяОкончания)*60;

	Если Адресация<2 Тогда
		Объект.Подразделение="";
		Объект.Отдел="";
		Объект.Сотрудник="";
	ИначеЕсли Адресация<3 Тогда
		Объект.Отдел="";
		Объект.Сотрудник="";
	ИначеЕсли Адресация<4 Тогда
		Объект.Сотрудник="";
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ОбновитьСобытия");
КонецПроцедуры //обновление календаря

&НаКлиенте
Процедура ПередВыполнением(Отказ)
	
	Если Объект.Исполнитель.Пустая() Тогда
		Объект.Исполнитель = Renault_ОбщиеФункцииСервер.ТекущийПользователь().Сотрудник;
	КонецЕсли;
	Объект.ДатаЗакрытия=Макс(Объект.Дата+5*60,ТекущаяДата());
	Объект.Длительность=(Объект.Дата-Объект.ДатаЗакрытия)/60;
	
КонецПроцедуры

Процедура УправлениеЭлементами()
	
	ЦветФона=Renault_ОбщиеФункцииСервер.ПолучитьЦвет(Объект.ЦветФона);
	ЦветТекста=Renault_ОбщиеФункцииСервер.ПолучитьЦвет(Объект.ЦветТекста);
	
	//Элементы.ЗаголовокФормы.Заголовок=""+Объект.ВидСобытия+" ("+Нрег(Объект.Состояние)+") "+?(Объект.Выполнена,"выполнена","не выполнена");
	Заголовок=""+Объект.ВидСобытия+" ("+Нрег(Объект.Состояние)+") "+?(Объект.Выполнена,"выполнена","не выполнена");
	Элементы.кнСостояниеЗадачи.Заголовок="Состояние:"+Символы.ПС+Объект.Состояние;
	Элементы.кнВыполнить.Заголовок=?(Объект.Выполнена,"Отменить"+Символы.ПС+"выполнение","Выполнить");
	Элементы.кнВидСобытия.Заголовок="Вид события:"+Символы.ПС+Объект.ВидСобытия.Наименование;
	Элементы.грЗакрытие.Видимость=Объект.Выполнена; 
	
	Элементы.Подразделение.Доступность=Адресация>1;
	Элементы.Отдел.Доступность=Адресация>2;
	Элементы.Сотрудник.Доступность=Адресация>3;
	
	Элементы.кнРабочийЛист.Заголовок="Рабочий лист "+?(Объект.IDK=0,"не выбран",Объект.IDK);
	
	ЦветВкл=Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ОсновнойЦвет);
	ЦветВыкл=Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ДопЦвет1);
	Элементы.кнВидСобытия.ЦветРамки=?(Объект.ВидСобытия.Пустая(),ЦветВкл,ЦветВыкл);
	Элементы.кнВидСобытия.ЦветФона=?(Объект.ВидСобытия.Пустая(),ЦветВкл,ЦветВыкл);
	Элементы.кнСостояниеЗадачи.ЦветРамки=?(Объект.Состояние.Пустая(),ЦветВкл,ЦветВыкл);
	Элементы.кнСостояниеЗадачи.ЦветФона=?(Объект.Состояние.Пустая(),ЦветВкл,ЦветВыкл);
	Элементы.кнРабочийЛист.ЦветРамки=?(Объект.IDK=0,ЦветВкл,ЦветВыкл);
	Элементы.кнРабочийЛист.ЦветФона=?(Объект.IDK=0,ЦветВкл,ЦветВыкл);
	Элементы.кнВыполнить.ЦветРамки=?(Не Объект.Выполнена,ЦветВкл,ЦветВыкл);
	Элементы.кнВыполнить.ЦветФона=?(Не Объект.Выполнена,ЦветВкл,ЦветВыкл);
	
	//Элементы.грТестДрайв.Видимость=Объект.ВидСобытия=Справочники.CRM_ВидыСобытий.ТестДрайв;
	//Элементы.грВыдача.Видимость=Объект.ВидСобытия=Справочники.CRM_ВидыСобытий.Выдача;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не Объект.Исполнитель.Пустая() И Renault_ОбщиеФункцииСервер.ТекущийПользователь()<>Объект.Исполнитель Тогда
		ТолькоПросмотр=Истина;
		Элементы.кнВыполнить.Доступность=Ложь;
		Элементы.кнПринятьКИсполнению.Доступность=Ложь;
		Элементы.кнОтменитьПринятиеКИсполнению.Доступность=Ложь;
		Элементы.кнСостояниеЗадачи.Доступность=Ложь;
		Сообщить("Вы не являетесь исполнителем, редактирование не доступно",СтатусСообщения.Информация);
	КонецЕсли;
	
КонецПроцедуры

