&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Объект.Состояние.Пустая() Тогда
		Если Вопрос("Не установлено состояние задачи. Продолжить?",РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Нет Тогда 
			СтандартнаяОбработка=Ложь;
			Отказ=Истина;
			Возврат
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура кнРабочийЛист(Команда)
	
	Парам = Новый Структура("РежимВыбора", Истина);
	Отбор = Новый Структура;
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Отбор.Вставить("Клиент", Объект.Контрагент);
	КонецЕсли;
	Если Не Объект.ДилерскийЦентр.Пустая() Тогда
		Отбор.Вставить("ДилерскийЦентр", Объект.ДилерскийЦентр);
	КонецЕсли;
	Если Не Объект.Отдел.Пустая() Тогда
		Отбор.Вставить("Отдел", Объект.Отдел);
	Иначе
		Если Не Объект.Подразделение.Пустая() Тогда
			Отбор.Вставить("Подразделение", Объект.Подразделение);
		КонецЕсли;
	КонецЕсли;
	Парам.Вставить("Отбор", Отбор);
	Если Объект.ОбластиПрименения.НайтиСтроки(Новый Структура("ОбластьПрименения", Перечисления.Renault_ОбластиПрименения.ОФУ)).Количество() Тогда 
		если Вопрос("Создать новый рабочий лист?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да тогда
			ДанныеЗаполнения = Новый Структура("Клиент",Объект.Контрагент);
			//Если ТипЗнч(Объект.Объект) = Тип("ДокументСсылка.CRM_КоммерческоеПредложение") тогда
			//КонецЕсли;	
			ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
			ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.Форма.ФормаДокумента",ПараметрыФормы);	
		иначе
			ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.ФормаСписка",Парам,ЭтаФорма,УникальныйИдентификатор);
		КонецЕсли;
	Иначе
		ОткрытьФорму("РегистрСведений.Renault_РабочиеЛисты.ФормаСписка",Парам,ЭтаФорма,УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение)=Тип("РегистрСведенийКлючЗаписи.Renault_РабочиеЛисты") Тогда
		Объект.IDK=ВыбранноеЗначение.IDK;
		УправлениеЭлементами();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыборСвязанногоДокумента" Тогда
		ВыборСвязанногоДокумента(Параметр, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Если (НачалоДня(Объект.Дата)+Час(ВремяНачала)*3600+Минута(ВремяНачала)*60)<ТекущаяДата() Тогда
		Сообщить("Дата задачи не может быть меньше текущей");
		Объект.Дата = ТекущаяДата();
		ВремяНачала = Объект.Дата;
	КонецЕсли;
	
КонецПроцедуры




