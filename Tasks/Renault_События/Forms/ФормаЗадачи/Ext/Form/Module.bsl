&НаКлиенте
Процедура ВыборВидаСобытия(Команда="")
	//Виды событий по правам
	//Если Объект.ОбластиПрименения.Количество()=0 Тогда Объект.ОбластиПрименения.Добавить()...(Перечисления.Renault_ОбластиПрименения.Общие) КонецЕсли;
	Парам=Новый Структура;
