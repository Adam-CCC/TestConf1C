	ОткрытьФорму("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВидСобытия(ВидСобытия,Парам2) Экспорт
	
	Если ВидСобытия=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверкаЗаполненияРЛ() Тогда
		Предупреждение("Для этого вида события требуется рабочий лист");
		Возврат;
	КонецЕсли;
	
	Объект.ВидСобытия=ВидСобытия;
	УстановитьНаименованиеЗадачи(ВидСобытия);
	Модифицированность=Истина;
	
	Оповещение=Новый ОписаниеОповещения("ВыборСвязанногоДокумента",ЭтаФорма,"...");
	
	Если ВидСобытия=ПредопределенноеСобытие("Выдача") Тогда
		
		Парам=Новый Структура;
		//Парам.Вставить(...) дописать
		Парам.Вставить("Дата",ТекущаяДата());
		Парам.Вставить("IDK",Объект.IDK);
		Парам.Вставить("Клиент",Объект.Контрагент);
		Парам.Вставить("Менеджер",Объект.Исполнитель);
