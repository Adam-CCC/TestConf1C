Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//права на события
	Если Не ДополнительныеСвойства.Свойство("БезКонтроляПрав") Тогда
		ВидРазрешения = ?(ЭтоНовый(), "создание", "редактирование");
		МассивРазрешенных = Справочники.CRM_ВидыСобытий.РазрешенныеСобытия(ВидРазрешения);
		Если МассивРазрешенных.Найти(ВидСобытия) = Неопределено Тогда
			Отказ = Истина;
			Сообщить("Нет прав на "+ВидРазрешения+" события "+ВидСобытия,СтатусСообщения.Внимание);
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДатаЗакрытия) Тогда
		Длительность = (ДатаЗакрытия-Дата)/60;
	КонецЕсли;
	
	//область по-умолчанию
	Если ОбластиПрименения.Количество()=0 Тогда
		ОбластиПрименения.Добавить().ОбластьПрименения = Справочники.CRM_ВидыСобытий.ПолучитьОбласть(ВидСобытия);
	КонецЕсли;
	
КонецПроцедуры
