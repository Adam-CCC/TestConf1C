&НаКлиенте
Процедура АвтомобильНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	Оповещение=Новый ОписаниеОповещения("ОпределитьСпособВыбораАвто",ЭтаФорма);
	Сп=Новый СписокЗначений;
	Сп.Добавить(1,"Автомобили");
	Сп.Добавить(2,"Автосклад");
	Сп.Добавить(3,"Конфигурация");
	ПоказатьВопрос(Оповещение,"Способ подбора автомобиля",Сп);
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьСпособВыбораАвто(Выбор,Парам) Экспорт
	ИдСтрокиСостав=Элементы.Состав.ТекущаяСтрока;
	Производитель=DMS_ОбщиеФункцииСервер.ПолучитьНаСервере("vars.Производитель",Объект.ДилерскийЦентр);
	Если Выбор=1 Тогда //автомобили
		Оповещение=Новый ОписаниеОповещения("ОкончаниеВыбораАвтомобиля",ЭтотОбъект,ИдСтрокиСостав);
		ОткрытьФорму("РегистрСведений.DMS_Автомобили.ФормаСписка",Новый Структура("РежимВыбора,АктивныйЭлемент,Производитель",Истина,Элементы.Состав.ТекущиеДанные.Автомобиль,Производитель),ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
	ИначеЕсли Выбор=2 Тогда //автосклад, АктивныйЭлемент тут бесполезен т.к. в динамическом списке нет основной таблицы
		Оповещение=Новый ОписаниеОповещения("ОкончаниеВыбораАвтомобиля",ЭтотОбъект,ИдСтрокиСостав);
		ОткрытьФорму("РегистрСведений.DMS_Автосклад.ФормаСписка",Новый Структура("РежимВыбора,Производитель",Истина,Производитель),ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
	ИначеЕсли Выбор=3 Тогда //конфигурация
		Оповещение=Новый ОписаниеОповещения("ОкончаниеВыбораКонфигурации",ЭтотОбъект,ИдСтрокиСостав);
		ОткрытьФорму("Документ.DMS_КоммерческоеПредложение.Форма.ФормаКонфигуратора",ПараметрыКонфигуратора(ИдСтрокиСостав),ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
	КонецЕсли;	
КонецПроцедуры
Функция ПараметрыКонфигуратора(ИдСтрокиСостав)
	СтрокаСостав=Состав.НайтиПоИдентификатору(ИдСтрокиСостав);
	Стр=Новый Структура;
	Стр.Вставить("Производитель",Объект.ДилерскийЦентр.Производитель);
	Стр.Вставить("Модель",?(ТипЗнч(СтрокаСостав.Автомобиль)=Тип("СправочникСсылка.DMS_ВариантыКомплектации"),СтрокаСостав.Автомобиль.Модель,Справочники.DMS_Модели.ПустаяСсылка()));
	Стр.Вставить("ВариантКомплектации",?(ТипЗнч(СтрокаСостав.Автомобиль)=Тип("СправочникСсылка.DMS_ВариантыКомплектации"),СтрокаСостав.Автомобиль,Справочники.DMS_ВариантыКомплектации.ПустаяСсылка()));
	Стр.Вставить("Цвет",СтрокаСостав.Цвет);
	Стр.Вставить("ВариантСалона",СтрокаСостав.ВариантСалона);
	Стр.Вставить("ЦветСалона",СтрокаСостав.ЦветСалона);
	Стр.Вставить("Корпоративный",Истина); //этот вызов всегда из заявки на корп продажи
	Возврат Стр
КонецФункции

&НаКлиенте
Процедура ОкончаниеВыбораАвтомобиля(Ответ,ИдСтрокиСостав) Экспорт 
	Если Ответ=Неопределено Тогда Возврат КонецЕсли;
	СтрокаСостав=Состав.НайтиПоИдентификатору(ИдСтрокиСостав);
	
	СтрокаСостав.Количество=1;
	СтрокаСостав.Автомобиль=Ответ; 
	ЗаполнитьРеквизитыАвто(ИдСтрокиСостав); 
КонецПроцедуры	
Процедура ЗаполнитьРеквизитыАвто(ИдСтрокиСостав)
	СтрокаСостав=Состав.НайтиПоИдентификатору(ИдСтрокиСостав);
	Реквизиты=DMS_Автомобили.Автомобиль(СтрокаСостав.Автомобиль,"VIN,SEDRE_ORDER,NumCl,NumDevis,Цвет,ЦветСалона,ВариантСалона");
	ЗаполнитьЗначенияСвойств(СтрокаСостав,Реквизиты);
КонецПроцедуры	

&НаКлиенте
Процедура ОкончаниеВыбораКонфигурации(Ответ,ИдСтрокиСостав) Экспорт
	Если Ответ=Неопределено Тогда Возврат КонецЕсли;
	СтрокаСостав=Состав.НайтиПоИдентификатору(ИдСтрокиСостав);
		
	СтрокаСостав.Количество=1;
	СтрокаСостав.Автомобиль=Ответ.ВариантКомплектации;
	СтрокаСостав.Цвет=Ответ.Цвет;
	СтрокаСостав.ЦветСалона=Ответ.ЦветСалона;
	СтрокаСостав.ВариантСалона=Ответ.ВариантСалона;
КонецПроцедуры	
