&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) Объект.Наименование=Объект.ВидЗаявки КонецПроцедуры
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//запишем связанный справочник
	Если Объект.ВидЗаявки=Перечисления.DMS_ВидыЗаявокНаСогласование.КорпоративнаяПродажа Тогда
		
		Если Состав.Количество()=0 Тогда
			Отказ=Истина;
			Сообщить("Не указан состав автомобилей");
			Возврат
		КонецЕсли;	
		
		//ссылка понядобится при записи связанного справочника DMS_СоставЗаявкиКорпКлиента
		Если ТекущийОбъект.ЭтоНовый() Тогда
			ТекущийОбъект.УстановитьСсылкуНового(Задачи.DMS_ЗаявкаНаСогласование.ПолучитьСсылку(Новый УникальныйИдентификатор)) 
		КонецЕсли;	
		
		ЭтаСсылка=?(ТекущийОбъект.ЭтоНовый(),ТекущийОбъект.ПолучитьСсылкуНового(),ТекущийОбъект.Ссылка);
		
		Запрос=Новый Запрос("Выбрать Ссылка Из Справочник.DMS_СоставЗаявкиКорпКлиента ГДЕ Заявка=&Заявка");
		Запрос.УстановитьПараметр("Заявка",ЭтаСсылка);
		Выборка=Запрос.Выполнить().Выбрать();
		СоставЗаявки=?(Выборка.Следующий(),Выборка.Ссылка.ПолучитьОбъект(),Справочники.DMS_СоставЗаявкиКорпКлиента.СоздатьЭлемент());
		СоставЗаявки.Заявка=ЭтаСсылка;
		СоставЗаявки.Состав.Загрузить(Состав.Выгрузить());	
		СоставЗаявки.Записать();
		
		//обязательный реквизит 
		СтрокиРекв=Объект.Реквизиты.НайтиСтроки(Новый Структура("Реквизит",ПланыВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.СоставЗаявки));
		Строка=?(СтрокиРекв.Количество()>0,СтрокиРекв[0],ТекущийОбъект.Реквизиты.Добавить());
		Строка.Реквизит=ПланыВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.СоставЗаявки;
		Строка.Значение=СоставЗаявки.Ссылка;
		
	КонецЕсли;	
	
КонецПроцедуры

