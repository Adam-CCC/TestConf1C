Функция СоставРеквизитов()
	Запрос=Новый Запрос("Выбрать Ссылка Реквизит,Обязательный Из ПланВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.ВидыЗаявок ГДЕ ВидЗаявкиНаСогласование=&ВидЗаявки И Интерактивный Упорядочить По Обязательный Убыв");
	Запрос.УстановитьПараметр("ВидЗаявки",Объект.ВидЗаявки);
	Возврат Запрос.Выполнить().Выгрузить()
КонецФункции	

&НаКлиенте
Процедура ВидЗаявкиПриИзменении(Элемент) ЗаполнитьРеквизиты(); УправлениеЭлементами(); КонецПроцедуры
Процедура ЗаполнитьРеквизиты()
	//Объект.Реквизиты.Загрузить(Запрос.Выполнить().Выгрузить());
	Для Каждого Реквизит Из СоставРеквизитов().ВыгрузитьКолонку("Реквизит") Цикл
		Если Объект.Реквизиты.НайтиСтроки(Новый Структура("Реквизит",Реквизит)).Количество()=0 Тогда
			Объект.Реквизиты.Добавить().Реквизит=Реквизит
		КонецЕсли;	
	КонецЦикла;	
	ЗаполнитьЗначенияРеквизитов();
КонецПроцедуры	
Процедура ЗаполнитьЗначенияРеквизитов()
	//Если Не ЗначениеЗаполнено(Объект.Основание) Тогда Возврат
	//ИначеЕсли ТипЗнч(Объект.Основание)=Тип("ДокументСсылка.DMS_ВыдачаАвтомобиля") Тогда
		Для Каждого Стр Из Объект.Реквизиты Цикл
			Если ЗначениеЗаполнено(Стр.Значение) Тогда Продолжить КонецЕсли;
			Если Стр.Реквизит=ПланыВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.Автомобиль И ТипЗнч(Объект.Основание)=Тип("ДокументСсылка.DMS_ВыдачаАвтомобиля") Тогда Стр.Значение=Объект.Основание.Автомобиль;
			ИначеЕсли Стр.Реквизит=ПланыВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.ЖелаемыйГодПроизводства Тогда Стр.Значение=Год(ТекущаяДата()+75*86400);	
			ИначеЕсли Стр.Реквизит=ПланыВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.ЖелаемыйМесяцПроизводства Тогда Стр.Значение=Месяц(ТекущаяДата()+75*86400);	
			ИначеЕсли Стр.Реквизит=ПланыВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.Клиент И ТипЗнч(Объект.Основание)=Тип("ДокументСсылка.DMS_ВыдачаАвтомобиля") Тогда Стр.Значение=Объект.Основание.Контрагент;
			ИначеЕсли Стр.Реквизит=ПланыВидовХарактеристик.DMS_РеквизитыЗаявкиНаСогласование.КорпоративныйКлиент И ТипЗнч(Объект.Основание)=Тип("ДокументСсылка.DMS_ВыдачаАвтомобиля") Тогда Стр.Значение=Справочники.DMS_КорпоративныеКлиенты.КорпоративныйКлиент(Объект.Основание.Контрагент,Объект.ДилерскийЦентр);
			КонецЕсли;				
		КонецЦикла;	
	//КонецЕсли;	
КонецПроцедуры	

