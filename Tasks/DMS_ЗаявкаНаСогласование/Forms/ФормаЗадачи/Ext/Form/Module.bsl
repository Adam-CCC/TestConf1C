Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	DMS_ОбщиеФункцииСервер.МультибрендОсновноеОформление(ЭтаФорма); //мультибренд
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	
	Элементы.Организация.Видимость=Константы.DMS_НесколькоОрганизацийНаОдинBIR.Получить();
	
	Если Объект.Ссылка.Пустая() Тогда 
		Если Объект.ДилерскийЦентр.Пустая() Тогда Объект.ДилерскийЦентр=ПараметрыСеанса.DMS_ТекущийДилерскийЦентр; КонецЕсли;
		Если Объект.Организация.Пустая() Тогда Объект.Организация=ПараметрыСеанса.DMS_ТекущаяОрганизация; КонецЕсли;
		Если Объект.Подразделение.Пустая() Тогда Объект.Подразделение=ПараметрыСеанса.DMS_ТекущееПодразделение; КонецЕсли;
		Объект.Менеджер=ПараметрыСеанса.ТекущийПользователь;
		Объект.Состояние=Справочники.DMS_Состояния.НаРассмотрении;
		ЗаполнитьОрганизацию();
		ЗаполнитьРеквизиты();
		
	Иначе
		ТолькоПросмотр=Объект.Закрыта; // на чтение
		
		//табличная часть "Состав"
		Если Объект.ВидЗаявки=Перечисления.DMS_ВидыЗаявокНаСогласование.КорпоративнаяПродажа Тогда
			Запрос=Новый Запрос("Выбрать * Из Справочник.DMS_СоставЗаявкиКорпКлиента.Состав ГДЕ Ссылка.Заявка=&Заявка");
			Запрос.УстановитьПараметр("Заявка",Объект.Ссылка);
			Состав.Загрузить(Запрос.Выполнить().Выгрузить());
		КонецЕсли;	
	КонецЕсли;
	
	//ТекСтрокаСостав=-1;
	УправлениеЭлементами();
	
КонецПроцедуры
Процедура УправлениеЭлементами()
	Если ЗначениеЗаполнено(Объект.СрокДействия) Тогда ТолькоПросмотр=Объект.СрокДействия<ТекущаяДата() КонецЕсли;	
	
	Элементы.Состав.Видимость=Объект.ВидЗаявки=Перечисления.DMS_ВидыЗаявокНаСогласование.КорпоративнаяПродажа;
	//Элементы.ПодменюПечатьОбычное_VAZ_КорпоративнаяЗаявка.Видимость = Объект.ВидЗаявки = Перечисления.DMS_ВидыЗаявокНаСогласование.КорпоративнаяПродажа;
	
	//отметка обязательных реквизитов для условного оформления
	СоставРеквизитов=СоставРеквизитов();
	Для Каждого Стр Из Объект.Реквизиты Цикл
		СтрСостава=СоставРеквизитов.Найти(Стр.Реквизит,"Реквизит");
		Если СтрСостава<>Неопределено Тогда Стр.Обязательный=СтрСостава.Обязательный КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

