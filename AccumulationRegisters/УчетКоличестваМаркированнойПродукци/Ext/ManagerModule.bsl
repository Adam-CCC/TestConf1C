			СтруктураQRКода						= РазборСроки.РазобратьСтрокуШтрихкодаGS1(КодМаркировки,Ложь,Истина);
			СтрокаДвижения.GTIN                 = СтруктураQRКода.ДанныеШтрихкода["01"].Значение;
			СтрокаДвижения.СерийныйНомер        = СтруктураQRКода.ДанныеШтрихкода["21"].Значение; 
