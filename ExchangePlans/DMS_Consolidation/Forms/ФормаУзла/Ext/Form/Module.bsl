&НаКлиенте
Процедура кнСохранитьВФайл(Команда)
	#Если ВебКлиент Тогда
	Если не ПодключитьРасширениеРаботыСФайлами() Тогда  //если подключить не удалось - требуется установить его (в первый раз)
	  УстановитьРасширениеРаботыСФайлами();
	  //если не удалось установить - то повторный вызов подключения будет неудачный
	  Если не ПодключитьРасширениеРаботыСФайлами() Тогда ВызватьИсключение "Ошибка. Ваш браузер не поддерживает работу с файлами :(" КонецЕсли 
	КонецЕсли;
	#КонецЕсли
	ДиалогОткрытияФайла=Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогОткрытияФайла.МножественныйВыбор=Ложь;
	
	м=Новый Массив;
	м.Добавить(Новый ОписаниеПередаваемогоФайла(,ПолучитьАдрес(Элементы.ОчередьИсходящихПакетов.ТекущаяСтрока)));
	НачатьПолучениеФайлов(Новый ОписаниеОповещения("СохранитьНаДиск", ЭтаФорма),м, ДиалогОткрытияФайла, Истина);
	
КонецПроцедуры
Функция ПолучитьАдрес(КлючЗаписи)
	Запрос=Новый Запрос("Выбрать Данные Из РегистрСведений.DMS_ОчередьИсходящихПакетов ГДЕ Узел=&Узел И Дата=&Дата");
	Запрос.УстановитьПараметр("Узел",КлючЗаписи.Узел);
	Запрос.УстановитьПараметр("Дата",КлючЗаписи.Дата);
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат ПоместитьВоВременноеХранилище(Выборка.Данные.Получить())
КонецФункции	

