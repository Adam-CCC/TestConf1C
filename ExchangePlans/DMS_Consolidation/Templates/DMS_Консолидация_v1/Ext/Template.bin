	<Приемник ВерсияПлатформы="8.0" ВерсияКонфигурации="2.2.3.43" СинонимКонфигурации="Consolidation">Consolidation</Приемник>
	<ПослеЗагрузкиПравилОбмена>Параметры.ИдентификаторБазы=Константы.Renault_BIR_db.Получить();</ПослеЗагрузкиПравилОбмена>
	<ПослеЗагрузкиОбъекта>Попытка	Если Объект.ИнформационнаяБаза&lt;&gt;Параметры.ИБ Тогда Объект.ИнформационнаяБаза=Параметры.ИБ КонецЕсли Исключение КонецПопытки;	
Попытка Объект.Версия=ТекущаяДата() Исключение КонецПопытки;</ПослеЗагрузкиОбъекта>
	<ПослеЗагрузкиПараметров>//ссылка на ИнфомационнаяБаза
Запрос=Новый Запрос("Выбрать Ссылка Из Справочник.ИнформационныеБазыДилеров ГДЕ Идентификатор=&amp;Идентификатор");
Запрос.УстановитьПараметр("Идентификатор",Параметры.ИдентификаторБазы);
Выборка=Запрос.Выполнить().Выбрать();
Параметры.Вставить("ИБ",?(Выборка.Следующий(),Выборка.Ссылка,Справочники.ИнформационныеБазыДилеров.ПустаяСсылка()));</ПослеЗагрузкиПараметров>
	<Параметры>
		<Параметр Имя="ИдентификаторБазы                                 " Наименование="ИдентификаторБазы=DMS.Константы.Renault_BIR_db.Получить()" ИспользуетсяПриЗагрузке="true" УстанавливатьВДиалоге="true" ТипЗначения="Строка" ПередаватьПараметрПриВыгрузке="true"/>
