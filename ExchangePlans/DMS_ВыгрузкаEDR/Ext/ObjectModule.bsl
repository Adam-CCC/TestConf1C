
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Ссылка <> ПланыОбмена.DMS_ВыгрузкаEDR.ЭтотУзел() Тогда
		
		ТекстСообщенияОбОшибке = "";
		
		Если Организации.Количество() = 0 Тогда
			ТекстСообщенияОбОшибке = "Укажите организации для отбора";
		КонецЕсли; 
		
		Если СостоянияЗаказНаряда.Количество() = 0 Тогда
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке+ Символы.ПС+"Укажите состояния заказ-нарядов для отбора";
		КонецЕсли; 
		
		ТекстСообщенияОбОшибке = СокрЛП(ТекстСообщенияОбОшибке);
		
		Если ТекстСообщенияОбОшибке <> "" Тогда
		
			Сообщить(ТекстСообщенияОбОшибке,СтатусСообщения.Важное);
			Отказ = Истина;
		
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры
