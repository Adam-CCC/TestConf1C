&НаКлиенте
Процедура БланкСтрогойОтчетностиПриИзменении(Элемент)
	Серия = Объект.Серия;
	
	Если ЗначениеЗаполнено(Серия) Тогда	
		ВладелецСерии = Renault_БСО_УчетБСО.ЗначениеРеквизитаСущности(Серия, "Владелец");
		
		Если Объект.БланкСтрогойОтчетности <> ВладелецСерии Тогда
			Объект.Серия = ПредопределенноеЗначение("Справочник.Renault_БСО_СерииБланковСтрогойОтчетности.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Подразделение = Объект.Подразделение;
	
	Если ЗначениеЗаполнено(Подразделение) Тогда	
		ОрганизацияПодразделения = Renault_БСО_УчетБСО.ЗначениеРеквизитаСущности(Подразделение, "Организация");
		
		Если Объект.Организация <> ОрганизацияПодразделения Тогда
			Объект.Подразделение = ПредопределенноеЗначение("Справочник.ПодразделенияКомпании.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Организация = Объект.Организация;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		СтандартнаяОбработка = Ложь;
			
		ФормаВыбора = Справочники.ПодразделенияКомпании.ПолучитьФормуВыбора(, Элемент);
		ФормаВыбора.Отбор.Организация.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.Организация.Значение = Организация;
		ФормаВыбора.Отбор.Организация.Использование = Истина;
		ФормаВыбора.ЭлементыФормы.Список.НастройкаОтбора.Организация.Доступность = Ложь;
		ФормаВыбора.Открыть();
	КонецЕсли;
КонецПроцедуры

