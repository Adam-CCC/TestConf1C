&НаКлиенте
Процедура СписокБСОПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Строка = Элементы.СписокБСО.ТекущиеДанные;
		//Строка.ДатаПоступления = Объект.Дата;
		//Строка.Количество = 1;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СписокБСОНомерБСОПриИзменении(Элемент)
	Строка = Элементы.СписокБСО.ТекущиеДанные;
	Строка.НомерБСО = Renault_БСО_УчетБСО.ПреобразоватьВНомерБСО(Строка.НомерБСО); 
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	НомерНачало = Объект.НомерБСОНачальный;
	НомерКонец = Объект.НомерБСОКонечный;
	
	Выход = Ложь;
	
	Если НЕ ЗначениеЗаполнено(НомерНачало) Тогда
		Сообщить("Не указан начальный номер!");
		Выход = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НомерКонец) Тогда
		Сообщить("Не указан конечный номер!");
		Выход = Истина;
	КонецЕсли;   
	
	Если НомерНачало > НомерКонец Тогда
		Сообщить("Начальный нормер больше конечного номера!");
		Выход = Истина;
	КонецЕсли;
	
	Если Выход Тогда
		Возврат;
	КонецЕсли;
	
	ТабСписокБСО = Объект.СписокБСО;
	
	Если ТабСписокБСО.Количество() > 0 Тогда
		ВопросПользователю = Вопрос("Перед заполнением старые данные табличного поля будут удалены, продолжить?", РежимДиалогаВопрос.ДаНет);
		
		Если ВопросПользователю = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//ДатаПоступления = Объект.Дата;	
	
	ТабСписокБСО.Очистить();
	
	Для Счетчик = НомерНачало По НомерКонец Цикл
		Строка = ТабСписокБСО.Добавить();
		Строка.НомерБСО = Renault_БСО_УчетБСО.ПреобразоватьВНомерБСО(Счетчик);
		//Строка.ДатаПоступления = ДатаПоступления;
		//Строка.Количество = 1;
	КонецЦикла;
	
	//РасчитатьКоличествоБСО();
	
	Модифицированность = Истина;
КонецПроцедуры

