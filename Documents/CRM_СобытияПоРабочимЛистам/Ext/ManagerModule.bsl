Функция ПолучитьБлижайшуюДатуДР(ДатаРождения) Экспорт
	ДеньРождения = День(ДатаРождения);
	ДеньРождения = ?(ДеньРождения < 10, "0" + ДеньРождения, Строка(ДеньРождения));
	
	МесяцРождения = Месяц(ДатаРождения);
	МесяцРождения = ?(МесяцРождения < 10, "0" + МесяцРождения, Строка(МесяцРождения));

	ТекущаяДата = ТекущаяДата();
	
	ТекущийГод = Формат(Год(ТекущаяДата), "ЧГ=");

	Если МесяцРождения ="02" и  ДеньРождения = "29" тогда
		МесяцРождения ="03";
		ДеньРождения = "01";
	КонецЕсли;

	ДатаРожденияТекущийГод = Дата(ТекущийГод + МесяцРождения + ДеньРождения);
	
	Если ДатаРожденияТекущийГод < ТекущаяДата Тогда
		ДатаРожденияТекущийГод = ДобавитьМесяц(ДатаРожденияТекущийГод, 12);
	КонецЕсли;
	
	Возврат НачалоДня(ДатаРожденияТекущийГод);	
КонецФункции

Процедура СоздатьЗадачуОЗаписиКлиентаНаДиагностику(Ссылка, Менеджер, IDK) Экспорт
		
	СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	СобытиеОбъект.IDK = IDK;
	СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ОценкаТрейдИн;
	Если ТипЗнч(Менеджер) = Тип("СправочникСсылка.CRM_Отделы") Тогда
		СобытиеОбъект.Отдел = Менеджер;
	Иначе
		СобытиеОбъект.Сотрудник = Менеджер;
	КонецЕсли;
	СобытиеОбъект.ДилерскийЦентр = Ссылка.ДилерскийЦентр;
	СобытиеОбъект.ДоговорНаПродажуАвтомобиля = Ссылка.ДоговорНаПродажуАвтомобиля;
	СобытиеОбъект.Подразделение = Ссылка.Подразделение;
	СобытиеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
	СобытиеОбъект.Дата = ТекущаяДата();
	СобытиеОбъект.ДатаНапоминания = Ссылка.ДатаНапоминания;
	СобытиеОбъект.Комментарий = "РЛ "+IDK + ": "+Ссылка.Комментарий;
	СобытиеОбъект.Обработано = Ложь;
	СобытиеОбъект.ЗавершеноУспешно = Ложь;
	СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	Напоминание.Отправитель = ПараметрыСеанса.Пользователь.Сотрудник;
	Напоминание.Подробнее = СобытиеОбъект.Ссылка;
	Если ТипЗнч(Менеджер) = Тип("СправочникСсылка.CRM_Отделы") Тогда
		Напоминание.Адресаты.Добавить().Отдел = Менеджер;
	Иначе
		Напоминание.Адресаты.Добавить().Сотрудник = Менеджер;
	КонецЕсли;
	Напоминание.ДатаОтправки = ТекущаяДата();
	Напоминание.Комментарий = Ссылка.Комментарий;
	Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.ЗадачаОЗаписиНаДиагностику;
	Напоминание.ПоказыватьС = ТекущаяДата();
	Напоминание.ПоказыватьПо = Ссылка.ДатаНапоминания;
	Напоминание.Наименование = IDK;
	Напоминание.ИдентификаторОбъекта = Строка(Формат(IDK,"ЧГ="));
	Напоминание.Сообщение = "Задача о записи на диагностику по РЛ " + IDK;
	Напоминание.Записать();

КонецПроцедуры

Процедура СоздатьЗвонокВежливостиПослеВыдачи (Событие = Неопределено,Выдача = Неопределено) Экспорт
	Если Событие = Неопределено И Выдача = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Козлов Е.А. Начало 20.07.2016
	Если Событие.ЗвонокНомер = "Звонок ДР" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РабочиеЛисты.Клиент.ДатаРождения КАК ДатаРождения,
		|	Renault_РабочиеЛисты.Отдел КАК Отдел,
		|	Renault_РабочиеЛисты.Подразделение КАК Подразделение,
		|	Renault_РабочиеЛисты.ДилерскийЦентр КАК ДилерскийЦентр
		|ИЗ
		|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|ГДЕ
		|	Renault_РабочиеЛисты.IDK = &IDK";	
		Запрос.УстановитьПараметр("IDK", Выдача.IDK);	
		Результат = Запрос.Выполнить(); 	
		Выборка = Результат.Выбрать(); 	
		Выборка.Следующий(); 
		
		КлиентДатаРождения = Выборка.ДатаРождения;
		
		Если ЗначениеЗаполнено(КлиентДатаРождения) Тогда
			ДатаЗвонкаДР = Документы.CRM_СобытияПоРабочимЛистам.ПолучитьБлижайшуюДатуДР(КлиентДатаРождения); 		
			
			Если ЗначениеЗаполнено(ДатаЗвонкаДр) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				|	CRM_СобытияПоРабочимЛистам.Ссылка
				|ИЗ
				|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
				|ГДЕ
				|	CRM_СобытияПоРабочимЛистам.IDK = &РабочийЛист
				|	И CRM_СобытияПоРабочимЛистам.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.ЗвонокВежливостиДР)
				|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
				|	И CRM_СобытияПоРабочимЛистам.ДатаНапоминания = &ДатаНапоминания
				|
				|УПОРЯДОЧИТЬ ПО
				|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
				Запрос.УстановитьПараметр("РабочийЛист", Выдача.IDK);
				Запрос.УстановитьПараметр("ДатаНапоминания", ДатаЗвонкаДР);
				Результат = Запрос.Выполнить();
				
				Если Результат.Пустой() Тогда 				
					СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
					СобытиеОбъект.IDK = Выдача.IDK;
					СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ЗвонокВежливостиДР;
					СобытиеОбъект.Сотрудник =  Выдача.Менеджер;
					СобытиеОбъект.Отдел = Выборка.Отдел;
					СобытиеОбъект.ДилерскийЦентр = Выборка.ДилерскийЦентр;
					СобытиеОбъект.Подразделение =  Выборка.Подразделение;
					СобытиеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
					СобытиеОбъект.Дата = ТекущаяДата();
					СобытиеОбъект.ДатаНапоминания = ДатаЗвонкаДР;
					СобытиеОбъект.Комментарий = "Звонок на день рождения";
					СобытиеОбъект.Обработано = Ложь;
					СобытиеОбъект.ЗавершеноУспешно = Ложь;
					СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);					
				КонецЕсли;				
			КонецЕсли;
		КонецЕсли;
		Возврат;

	КонецЕсли;	
	//Козлов Е.А. Конец
	
	СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	СобытиеОбъект.Дата = ТекущаяДата();
	СобытиеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
	СобытиеОбъект.ДатаНапоминания = СобытиеОбъект.Дата  + Событие.КоличествоДней*60*60*24;
	СобытиеОбъект.IDK = Выдача.IDK;
	СобытиеОбъект.ДилерскийЦентр = Выдача.ДилерскийЦентр;
	СобытиеОбъект.Подразделение = Выдача.Менеджер.Подразделение;
	СобытиеОбъект.Отдел = Renault_CRM.ПолучитьОтделСотрудника(Выдача.Менеджер);
	Если СокрЛП(Событие.ЗвонокНомер) = "Звонок №1" Тогда
		СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ЗвонокВежливости3;
		СобытиеОбъект.Комментарий = "Звонок вежливости "+Событие.КоличествоДней+" д.";
	ИначеЕсли СокрЛП(Событие.ЗвонокНомер) = "Звонок №2" Тогда
		СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ЗвонокВежливости30; 
		СобытиеОбъект.Комментарий = "Звонок вежливости "+Событие.КоличествоДней+" д.";
	ИначеЕсли СокрЛП(Событие.ЗвонокНомер) = "Звонок №3" Тогда
		СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ЗвонокВежливости360;   
		СобытиеОбъект.Комментарий = "Звонок вежливости "+Событие.КоличествоДней+" д.";		
	// Беседин 19.10.21 заявка 1082
	ИначеЕсли НЕ СокрЛП(Событие.ЗвонокНомер) = "Звонок ДР" Тогда
		СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ЗвонокВежливостиНовый;
		СобытиеОбъект.Комментарий = "Звонок вежливости "+СокрЛП(Событие.ЗвонокНомер) + " "+Событие.КоличествоДней + " д.";
	КонецЕсли;
	СобытиеОбъект.Сотрудник = Выдача.Менеджер;
	СобытиеОбъект.Обработано = Ложь;
	СобытиеОбъект.ЗавершеноУспешно = Ложь;
	//СобытиеОбъект.Отдел = Отдел;
	//СобытиеОбъект.Подразделение = Подразделение;					
	СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Функция ПеренестиСобытие (Событие=Неопределено) Экспорт
	Если Событие = Неопределено  Тогда
		Возврат(Неопределено);
	КонецЕсли;
	СобытиеОбъект = Событие.ПолучитьОбъект();
	Док=Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(Док,СобытиеОбъект);
	Для Каждого ТЧ Из СобытиеОбъект.Метаданные().ТабличныеЧасти Цикл Док[ТЧ.Имя].Загрузить(СобытиеОбъект[ТЧ.Имя].Выгрузить()) КонецЦикла;
	Док.Номер="";
	Док.Основание=Событие.Ссылка;
	Док.Обработано=Ложь;
	Док.ДатаЗакрытия="";
	Док.АвторЗакрытия="";
	Док.ЗавершеноУспешно=Ложь;
	
	//Док.ПолучитьФорму("ФормаСозданияСобытия").ОткрытьМодально();
	Форма=Док.ПолучитьФорму("ФормаСозданияСобытия");
	Форма.ЭтоПерепланирование=Истина; 
	СсылкаНового=Форма.ОткрытьМодально();
	Если СсылкаНового <> Неопределено Тогда 
		СобытиеОбъект.КомментарийЗакрытия="Перенесено на "+Формат(СсылкаНового.ДатаНапоминания,"ДФ=dd.MM.yyyy");
		СобытиеОбъект.ЗавершеноУспешно = Ложь;
		СобытиеОбъект.Обработано = Истина;
		СобытиеОбъект.ДатаЗакрытия= ТекущаяДата();
		СобытиеОбъект.АвторЗакрытия = ПараметрыСеанса.Пользователь.Сотрудник;
		СобытиеОбъект.Записать();
		Возврат(СсылкаНового);
	КонецЕсли;
	Возврат(Неопределено);
	
КонецФункции