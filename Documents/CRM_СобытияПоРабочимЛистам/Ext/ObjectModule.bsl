Функция ПолучитьТестДрайвыНаДату(вхПериод,Авто) Экспорт
	Зап = Новый Запрос("ВЫБРАТЬ
	                   |	CRM_ЗаписьНаТестДрайв.Ссылка,
	                   |	CRM_ЗаписьНаТестДрайв.Менеджер,
	                   |	CRM_ЗаписьНаТестДрайв.Клиент,
	                   |	ЧАС(CRM_ЗаписьНаТестДрайв.Начало) КАК Час,
	                   |	МИНУТА(CRM_ЗаписьНаТестДрайв.Начало) КАК Минута,
	                   |	CRM_ЗаписьНаТестДрайв.Продолжительность,
	                   |	CRM_ЗаписьНаТестДрайв.СтатусДокумента,
	                   |	ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.ТестДрайв) КАК ВидСобытия,
	                   |	CRM_ЗаписьНаТестДрайв.РабочийЛист
	                   |ИЗ
	                   |	Документ.CRM_ЗаписьНаТестДрайв КАК CRM_ЗаписьНаТестДрайв
	                   |ГДЕ
	                   |	CRM_ЗаписьНаТестДрайв.ДатаПроведения МЕЖДУ &ДатаПроведенияНачало И &ДатаПроведенияОкончание
	                   |	И CRM_ЗаписьНаТестДрайв.Автомобиль = &Автомобиль
	                   |	И CRM_ЗаписьНаТестДрайв.СтатусДокумента В(&СтатусыДокумента)
	                   |	И CRM_ЗаписьНаТестДрайв.ПометкаУдаления = ЛОЖЬ");	
	Зап.УстановитьПараметр("ДатаПроведенияНачало",НачалоДня(вхПериод));
	Зап.УстановитьПараметр("ДатаПроведенияОкончание",КонецДня(вхПериод));
    МассивСтатусов = новый Массив();
	МассивСтатусов.Добавить(Перечисления.CRM_СтатусыТестДрайва.Выполняется);
	МассивСтатусов.Добавить(Перечисления.CRM_СтатусыТестДрайва.Запланировано);
	МассивСтатусов.Добавить(Перечисления.CRM_СтатусыТестДрайва.Завершено);
	МассивСтатусов.Добавить(Перечисления.CRM_СтатусыТестДрайва.ЗавершеноДосрочно);
	Зап.УстановитьПараметр("Автомобиль",Авто);
    Зап.УстановитьПараметр("СтатусыДокумента",МассивСтатусов);
	Выг = зап.Выполнить().Выгрузить();
	Возврат Выг;
КонецФункции

Функция ПолучитьТестДрайвыИДругиеСобытияНаДату(вхПериод,Менеджер,Авто,ШагМинут = 5) Экспорт
	Зап = Новый Запрос("ВЫБРАТЬ
	                   |	CRM_ЗаписьНаТестДрайв.Ссылка,
	                   |	CRM_ЗаписьНаТестДрайв.Менеджер,
	                   |	CRM_ЗаписьНаТестДрайв.Клиент,
	                   |	ЧАС(CRM_ЗаписьНаТестДрайв.Начало) КАК Час,
	                   |	МИНУТА(CRM_ЗаписьНаТестДрайв.Начало) КАК Минута,
	                   |	CRM_ЗаписьНаТестДрайв.Продолжительность,
	                   |	CRM_ЗаписьНаТестДрайв.СтатусДокумента,
	                   |	ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.ТестДрайв) КАК ВидСобытия,
	                   |	CRM_ЗаписьНаТестДрайв.РабочийЛист
	                   |ИЗ
	                   |	Документ.CRM_ЗаписьНаТестДрайв КАК CRM_ЗаписьНаТестДрайв
	                   |ГДЕ
	                   |	CRM_ЗаписьНаТестДрайв.ДатаПроведения МЕЖДУ &ДатаПроведенияНачало И &ДатаПроведенияОкончание
	                   |	И CRM_ЗаписьНаТестДрайв.Автомобиль = &Автомобиль
	                   |	И CRM_ЗаписьНаТестДрайв.СтатусДокумента В(&СтатусыДокумента)
	                   |	И CRM_ЗаписьНаТестДрайв.ПометкаУдаления = ЛОЖЬ
	                   |
	                   |ОБЪЕДИНИТЬ ВСЕ
	                   |
	                   |ВЫБРАТЬ
	                   |	CRM_ЗаписьНаВыдачу.Ссылка,
	                   |	CRM_ЗаписьНаВыдачу.Менеджер,
	                   |	CRM_ЗаписьНаВыдачу.Клиент,
	                   |	ЧАС(CRM_ЗаписьНаВыдачу.ДатаНачала),
	                   |	МИНУТА(CRM_ЗаписьНаВыдачу.ДатаНачала),
	                   |	CRM_ЗаписьНаВыдачу.Продолжительность,
	                   |	CRM_ЗаписьНаВыдачу.Статус,
	                   |	ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.Выдача),
	                   |	CRM_ЗаписьНаВыдачу.IDK
	                   |ИЗ
	                   |	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу
	                   |ГДЕ
	                   |	CRM_ЗаписьНаВыдачу.ДатаНачала МЕЖДУ &ДатаПроведенияНачало И &ДатаПроведенияОкончание
	                   |	И CRM_ЗаписьНаВыдачу.Статус В(&Статус)
	                   |	И CRM_ЗаписьНаВыдачу.ПометкаУдаления = ЛОЖЬ
	                   |	И CRM_ЗаписьНаВыдачу.Менеджер = &Менеджер
	                   |
	                   |ОБЪЕДИНИТЬ ВСЕ
	                   |
	                   |ВЫБРАТЬ
	                   |	CRM_СобытияПоРабочимЛистам.Ссылка,
	                   |	CRM_СобытияПоРабочимЛистам.Сотрудник,
	                   |	Renault_РабочиеЛисты.Клиент,
	                   |	ЧАС(CRM_СобытияПоРабочимЛистам.ДатаНапоминания),
	                   |	МИНУТА(CRM_СобытияПоРабочимЛистам.ДатаНапоминания),
	                   |	&ШагМинут,
	                   |	""Прочее"",
	                   |	CRM_СобытияПоРабочимЛистам.ВидСобытия,
	                   |	CRM_СобытияПоРабочимЛистам.IDK
	                   |ИЗ
	                   |	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	                   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
