Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если ВидСобытия = Справочники.CRM_ВидыСобытий.Встреча Тогда		
		Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ПосещениеАвтосалона, IDK);
		Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.НазначенаВстреча, IDK);
	КонецЕсли;
	
КонецПроцедуры

