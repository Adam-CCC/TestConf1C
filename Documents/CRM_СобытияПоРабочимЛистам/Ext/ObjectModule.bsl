	//МассивСтатусов.Добавить(Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.);
	Зап.УстановитьПараметр("Статус",МассивСтатусов);
	Выг = зап.Выполнить().Выгрузить();
	Возврат Выг;
