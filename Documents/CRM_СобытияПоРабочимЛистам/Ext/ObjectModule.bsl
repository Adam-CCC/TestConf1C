	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

//v+
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    //права на события
    ВидРазрешения = ?(ЭтоНовый(), "создание", "редактирование");
    МассивРазрешенных = Справочники.CRM_ВидыСобытий.РазрешенныеСобытия(ВидРазрешения);
    Если МассивРазрешенных.Найти(ВидСобытия) = Неопределено Тогда // Нет прав у пользователя
        Сообщить("Нет прав на """ + ВидРазрешения + """ события """ + ВидСобытия + """.", СтатусСообщения.Внимание);
        Отказ = Истина;
        Возврат;
    КонецЕсли;

	Если ЗначениеЗаполнено(ДатаЗакрытия) Тогда
		Если ЗначениеЗаполнено(ВидСобытия.ДлительностьПоУмолчанию) Тогда
			Длительность = ВидСобытия.ДлительностьПоУмолчанию;
        Иначе
			Длительность = (ДатаЗакрытия - ДатаНапоминания) / 60;
		КонецЕсли;
    КонецЕсли;

КонецПроцедуры
