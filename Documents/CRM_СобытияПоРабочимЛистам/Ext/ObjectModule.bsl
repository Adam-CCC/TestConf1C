		//			ДокВыдача.Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан;
		//			ДокВыдача.ДатаВыдачи = ТекущаяДата();
		//		КонецЕсли;
		//	Иначе
		//		Если ДокВыдача.Статус <> Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Отменено Тогда
		//			ДокВыдача.Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Отменено;
		//			ДокВыдача.ДатаВыдачи = ТекущаяДата();
