&НаКлиенте
Процедура ОбъектЗадачиОткрытие(Элемент, СтандартнаяОбработка)
	Если ТипЗнч(Объект.Объект)=Тип("ДокументСсылка.CRM_КоммерческоеПредложение") Тогда
		СтандартнаяОбработка=Ложь;
		КП=Объект.Объект;
		Документы.CRM_КоммерческоеПредложение.Открыть(КП.РабочийЛист,КП.Клиент,КП)
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция  ПолучитьРабочийЛистДляСобытия ()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_РабочиеЛисты.ДатаID КАК Период,
	|	Renault_РабочиеЛисты.ID,
	|	Renault_РабочиеЛисты.IDK,
	|	Renault_РабочиеЛисты.Отдел,
	|	Renault_РабочиеЛисты.Подразделение,
	|	Renault_РабочиеЛисты.Важность,
	|	ВЫБОР
	|		КОГДА CRM_ВоронкаПродаж_Выдача.Объект ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Выдача,
	|	Renault_РабочиеЛисты.ЗапросНаЗакрытие,
	|	Renault_РабочиеЛисты.КомментарийЗакрытия,
	|	Renault_РабочиеЛисты.Комплектация,
	|	ВЫБОР
	|		КОГДА CRM_ВоронкаПродаж_Контракт.Объект ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Контракт,
	|	Renault_РабочиеЛисты.ЛистЗакрыт,
	|	Renault_РабочиеЛисты.МаркаАвтомобиля,
	|	Renault_РабочиеЛисты.МодельАвтомобиля,
	|	Renault_РабочиеЛисты.Клиент,
	|	Renault_РабочиеЛисты.ПричинаЗакрытия,
	|	Renault_РабочиеЛисты.Сотрудник,
	|	Renault_РабочиеЛисты.Цвет,
	|	Renault_РабочиеЛисты.ДатаID КАК ДатаСоздания,
	|	Renault_РабочиеЛисты.ПервичныйИнтересМодель,
	|	Renault_РабочиеЛисты.VINАвтомобилей,
	|	ПОДСТРОКА(Renault_РабочиеЛисты.Клиент.НаименованиеПолное, 0, 100) КАК ФИО,
	|	ПОДСТРОКА(ЕСТЬNULL(КонтактнаяИнформация_Телефон.Представление, """"), 0, 50) КАК Телефон,
	|	ПОДСТРОКА(ЕСТЬNULL(КонтактнаяИнформация_Почта.Представление, """"), 0, 50) КАК Почта
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж_Выдача
	|		ПО Renault_РабочиеЛисты.IDK = CRM_ВоронкаПродаж_Выдача.IDK
	|			И (CRM_ВоронкаПродаж_Выдача.ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.ВыдачаАвтомобиля))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж_Контракт
	|		ПО Renault_РабочиеЛисты.IDK = CRM_ВоронкаПродаж_Контракт.IDK
	|			И (CRM_ВоронкаПродаж_Контракт.ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.Контракт))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_Телефон
	|		ПО Renault_РабочиеЛисты.Клиент = КонтактнаяИнформация_Телефон.Объект
	|			И (КонтактнаяИнформация_Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|			И (КонтактнаяИнформация_Телефон.ЗначениеПоУмолчанию = ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_Почта
	|		ПО (КонтактнаяИнформация_Почта.ЗначениеПоУмолчанию = ИСТИНА)
	|			И Renault_РабочиеЛисты.Клиент = КонтактнаяИнформация_Почта.Объект
	|			И (КонтактнаяИнформация_Почта.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|ГДЕ
	|	ИСТИНА
	|	И Renault_РабочиеЛисты.ЛистЗакрыт = ЛОЖЬ
	|	И Renault_РабочиеЛисты.ЗапросНаЗакрытие = ЛОЖЬ
	|	И Renault_РабочиеЛисты.Сотрудник = &ОтборМенеджер
	|УПОРЯДОЧИТЬ ПО
	|	Renault_РабочиеЛисты.Важность УБЫВ,
	|	Renault_РабочиеЛисты.ДатаID УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ОтборМенеджер",ПараметрыСеанса.Пользователь.Сотрудник);
	СписокВыбора = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		СписокВыбора.Добавить(Выборка.IDK,""+Выборка.IDK+"-"+Выборка.ФИО);
	КонецЦикла;
	Возврат СписокВыбора;
КонецФункции


&НаКлиенте
Процедура кнВыбратьРабочийЛист(Команда)
	ВыборИзСписка=Обработки.Renault_ARM_Менеджеры.ПолучитьФорму("ФормаВыбораИзСписка");
	ВыборИзСписка.Список=ПолучитьРабочийЛистДляСобытия();
	ВыборИзСписка.Заголовок="Выберите рабочий лист для создания события";
	Объект.IDK=ВыборИзСписка.ОткрытьМодально();
КонецПроцедуры

