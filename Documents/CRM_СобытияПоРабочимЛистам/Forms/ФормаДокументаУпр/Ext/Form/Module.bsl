&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//определение вида разрешения ("Создание","Просмотр","Редактирование") - редактирование проверим при записи
	ВидРазрешения=?(Объект.Ссылка.Пустая(),"Создание","Просмотр");
	
	Если Параметры.Свойство("Дата") Тогда Объект.Дата=Параметры.Дата КонецЕсли;
	Если Параметры.Свойство("ДатаЗакрытия") Тогда Объект.ДатаЗакрытия=Параметры.ДатаЗакрытия КонецЕсли;
	
	//для нового события может быть переданы разрешенныые облсти применения события
	Если Параметры.Свойство("ОбластиПрименения") Тогда ОбластиПрименения.ЗагрузитьЗначения(Параметры.ОбластиПрименения) КонецЕсли;
	
	//определение вида события
	Если Параметры.Свойство("ВидСобытия") Тогда Объект.ВидСобытия=Параметры.ВидСобытия 
	ИначеЕсли Объект.ВидСобытия.Пустая() Тогда //вид события из переданного списка ОбластиПрименения
		РазрешенныеВидыСобытий=Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластямПрименения(ОбластиПрименения.ВыгрузитьЗначения(),ВидРазрешения);
		Объект.ВидСобытия=?(РазрешенныеВидыСобытий.Найти(Справочники.CRM_ВидыСобытий.Прочее)<>Неопределено,Справочники.CRM_ВидыСобытий.Прочее,
			?(РазрешенныеВидыСобытий.Количество()>0,РазрешенныеВидыСобытий[0],"")
		)
	КонецЕсли;
	
	//Если Справочники.CRM_ВидыСобытий.РазрешенныеСобытия(ВидРазрешения).Найти(Объект.ВидСобытия)=Неопределено Тогда
	//	Отказ=Истина;
	//	Сообщить("Нет прав <"+ВидРазрешения+"> по виду события "+Объект.ВидСобытия,СтатусСообщения.Внимание);
	//КонецЕсли;
	
	//разрешение редактирования
	Если ВидРазрешения="Просмотр" И Объект.Автор<>ПараметрыСеанса.Пользователь И Объект.Сотрудник<>ПараметрыСеанса.Пользователь.Сотрудник
		И Справочники.CRM_ВидыСобытий.РазрешенныеСобытия("Редактирование").Найти(Объект.ВидСобытия)=Неопределено Тогда
		ТолькоПросмотр=Истина;
		Для Каждого Эл Из Элементы Цикл Попытка Эл.Доступность=Ложь Исключение КонецПопытки КонецЦикла;
	КонецЕсли;
	
	//ограничение вида события по области применения
	//Если Параметры.Свойство("ОбластьПрименения") Тогда
	//	Элементы.ВидСобытия.СписокВыбора.ЗагрузитьЗначения(Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластиПрименения(Параметры.ОбластьПрименения,ВидРазрешения));
	//КонецЕсли;
	
	//первоначальное заполнение
	Если Параметры.Свойство("IDK") Тогда Объект.IDK=Параметры.IDK КонецЕсли;	
	Если Параметры.Свойство("ВидСобытия") Тогда Объект.ВидСобытия=Параметры.ВидСобытия КонецЕсли;
	Если Параметры.Свойство("Сотрудник") Тогда Объект.Сотрудник=Параметры.Сотрудник КонецЕсли;
	Если Параметры.Свойство("ДилерскийЦентр") Тогда Объект.ДилерскийЦентр=Параметры.ДилерскийЦентр КонецЕсли;
	Если Параметры.Свойство("Подразделение") Тогда Объект.Подразделение=Параметры.Подразделение КонецЕсли;
	Если Параметры.Свойство("Отдел") Тогда Объект.Отдел=Параметры.Отдел КонецЕсли;

	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Автор=ПараметрыСеанса.Пользователь;
		Права=Renault_ОбщиеФункции.ПраваПользователя(ПараметрыСеанса.Пользователь);
		
		Если Объект.Сотрудник.Пустая() Тогда Объект.Сотрудник=ПараметрыСеанса.Пользователь.Сотрудник КонецЕсли;
		Если Объект.Отдел.Пустая() Тогда Объект.Отдел=Права.Отдел КонецЕсли;
		Если Объект.Подразделение.Пустая() Тогда Объект.Подразделение=Объект.Сотрудник.Подразделение КонецЕсли;
		Если Объект.ДилерскийЦентр.Пустая() Тогда Объект.ДилерскийЦентр=Права.ДилерскийЦентр КонецЕсли;
	КонецЕсли;	
	
	Если НЕ Объект.Сотрудник.Пустая() Тогда Адресация=4
	ИначеЕсли НЕ Объект.Отдел.Пустая() Тогда Адресация=3
	ИначеЕсли НЕ Объект.Подразделение.Пустая() Тогда Адресация=2
	Иначе Адресация=1
	КонецЕсли;	
	
	ОбновитьРасписание(); //@++

	УправлениеЭлементами();
	

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Адресация<2 Тогда
		Объект.Подразделение="";
		Объект.Отдел="";
		Объект.Сотрудник="";
	ИначеЕсли Адресация<3 Тогда
		Объект.Отдел="";
		Объект.Сотрудник="";
	ИначеЕсли Адресация<4 Тогда
		Объект.Сотрудник="";
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи) 
	
	Оповестить("ОбновитьСобытия");
	
	Если Объект.ВидСобытия = Справочники.CRM_ВидыСобытий.Оплата Тогда
	
		ФормироватьЗадачуОЗаписиНаДиагностикуПриЗаписиНаОплату = ПолучитьСлужНастрокуФормированияЗадачиОДиагностике();
		
		Если ФормироватьЗадачуОЗаписиНаДиагностикуПриЗаписиНаОплату И ЗначениеЗаполнено(Объект.ДоговорНаПродажуАвтомобиля) Тогда
					
			Для Каждого Стр Из Объект.ДоговорНаПродажуАвтомобиля.СоставДоговора Цикл
				Если ЗначениеЗаполнено(Стр.ЗаявкаНаТрейдИн) Тогда		
					Если Вопрос("Создать задачу о записи клиента на диагностику?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
						СоздатьЗадачуОЗаписиКлиентаНаДиагностику(Объект.Ссылка);
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
					
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры //обновление календаря

