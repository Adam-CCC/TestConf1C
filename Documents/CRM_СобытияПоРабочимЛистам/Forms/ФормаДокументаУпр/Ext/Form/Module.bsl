&НаКлиенте
Процедура ВыборВидаСобытия(Команда="")
	//Виды событий по правам
	Если ОбластиПрименения.Количество()=0 Тогда 
		ОбластиПрименения.Добавить(Перечисления.Renault_ОбластиПрименения.Общие);
		ОбластиПрименения.Добавить(Перечисления.Renault_ОбластиПрименения.Продажи);
		//ОбластиПрименения.Добавить(Перечисления.Renault_ОбластиПрименения.Сервис);
	КонецЕсли;
	ВидыСобытий=Справочники.CRM_ВидыСобытий.СписокВидовСобытий(Справочники.CRM_ВидыСобытий.РазрешенныеВидыСобытийПоОбластямПрименения(ОбластиПрименения.ВыгрузитьЗначения(),"Создание"),Объект.ВидСобытия);
	Парам=Новый Структура;
	Парам.Вставить("Список",ВидыСобытий);
	Парам.Вставить("Заголовок","Выбор вида события");
	Парам.Вставить("МножественныйВыбор",Ложь);
	//Парам.Вставить("КоличествоЭлементовВСтроке",4);
	Парам.Вставить("ШиринаЭлемента",17);
	Парам.Вставить("ВысотаЭлемента",2);
	ВидСобытия=ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
	Если ВидСобытия<>Неопределено Тогда 
		Объект.ВидСобытия=ВидСобытия;
		//УстановитьНаименованиеЗадачи(ВидСобытия);
		Модифицированность=Истина;
	КонецЕсли;
	УправлениеЭлементами();
КонецПроцедуры

