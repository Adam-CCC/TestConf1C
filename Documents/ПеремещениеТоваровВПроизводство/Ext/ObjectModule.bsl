Функция СоздатьМежскладскоеПеремещение(ТоварыКПродаже)
	
	СтавкаНДС20  = Справочники.СтавкиНДС.НайтиПоРеквизиту("Ставка", 20);
	СтавкаБезНДС = Справочники.СтавкиНДС.БезНДС;
 	
	ЕстьОшибки = Ложь;
 	
 	ПеремещениеОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ПеремещениеОбъект.Автор = ПараметрыСеанса.Пользователь;
	ПеремещениеОбъект.ДокументОснование=Ссылка;
	
	ПеремещениеОбъект.Организация = ТоварыКПродаже[0].ОрганизацияПоставщик;
	ПеремещениеОбъект.ОбработкаРеквизита("Организация");
 	ПеремещениеОбъект.ПодразделениеКомпании = ТоварыКПродаже[0].ПодразделениеПоставщик;
	//ПеремещениеОбъект.ОбработкаРеквизита("ПодразделениеКомпании");
 	
	ПеремещениеОбъект.РегламентированныйУчет = Истина;
	ПеремещениеОбъект.Дата = ТекущаяДата();
	ПеремещениеОбъект.УстановитьНовыйНомер();
	ПеремещениеОбъект.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваров;
 	
	ПеремещениеОбъект.СкладКомпании = ТоварыКПродаже[0].СкладОтправитель;
	ПеремещениеОбъект.СкладПолучатель = СкладКомпании;
	
	ПеремещениеОбъект.ТипЦен=Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
	ПеремещениеОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	ПеремещениеОбъект.КурсДокумента = 1;
	ПеремещениеОбъект.КурсВалютыУпр = 1;
 	ПеремещениеОбъект.ЗакрытиеЗаказовПоПодразделению=Истина;
	ПеремещениеОбъект.СверкаПроведена=Истина;
	
	ПеремещениеОбъект.ДатаСоздания = ТекущаяДата();
	
	ТекущийСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
 	ПеремещениеОбъект.ОтпустилСот = ТекущийСотрудник;
	ПеремещениеОбъект.ПолучилСот = ТекущийСотрудник;
	ПеремещениеОбъект.Перевозчик = ТекущийСотрудник;
 	
	ПеремещениеОбъект.ВизаОтправил = Истина;
	ПеремещениеОбъект.ВизаПолучил = Истина;
	  
	ПеремещениеОбъект.СформированАвтоматически=Ложь;
	ПеремещениеОбъект.Комментарий = "Создан на основании объединённого перемещения в производство "+ТекущаяДата()+" пользователем "+ПараметрыСеанса.Пользователь+" для перемещения запасных частей между складами";
	
	Для каждого Стр Из ТоварыКПродаже Цикл
		
		СтрокаТовары = ПеремещениеОбъект.Товары.Добавить();
		СтрокаТовары.Номенклатура = стр.Товар;
    	СтрокаТовары.Количество = стр.Количество;
		СтрокаТовары.ЕдиницаИзмерения = стр.ЕдиницаИзмерения;
		СтрокаТовары.Коэффициент = стр.ЕдиницаИзмерения.Коэффициент;
  		СтрокаТовары.Цена = обПолучитьЦену(ПеремещениеОбъект.ТипЦен,СтрокаТовары.Номенклатура,ПеремещениеОбъект.Дата,,ПеремещениеОбъект.ВалютаДокумента,ПеремещениеОбъект.КурсДокумента, ,СтрокаТовары.ЕдиницаИзмерения , ПеремещениеОбъект.ПодразделениеКомпании);
 
  	    ДопПараметры = Новый Структура;
	    
	    ДопПараметры.Вставить("НеКонтролироватьЗамены",Истина);
	    ДопПараметры.Вставить("ПересчитатьЦену",Истина);
	    ПеремещениеОбъект.ОбработкаРеквизита("Товары.Номенклатура", СтрокаТовары,, ДопПараметры);
	  
	    ПеремещениеОбъект.ОбработкаРеквизита("Товары.ХарактеристикаНоменклатуры", СтрокаТовары,, ДопПараметры);
	    ПеремещениеОбъект.ОбработкаРеквизита("Товары.ЕдиницаИзмерения", СтрокаТовары,, ДопПараметры);
	    ПеремещениеОбъект.ОбработкаРеквизита("Товары.Количество", СтрокаТовары,, ДопПараметры);
	    ПеремещениеОбъект.ОбработкаРеквизита("Товары.Коэффициент", СтрокаТовары,, ДопПараметры);
 
		Если ПеремещениеОбъект.Организация.ОсвобожденОтНДС Тогда
			СтрокаТовары.СтавкаНДС = СтавкаБезНДС;
		Иначе	
  			Если ТекущаяДата() >= Дата(2019,1,1) Тогда
				СтрокаТовары.СтавкаНДС=СтавкаНДС20;	
 			Иначе
				СтрокаТовары.СтавкаНДС=Справочники.СтавкиНДС.ОсновнаяСтавкаНДС; 
			КонецЕсли; 
   		КонецЕсли; 
 
	    ПеремещениеОбъект.ОбработкаРеквизита("Товары.СтавкаНДС", СтрокаТовары,, ДопПараметры);
 		СтрокаТовары.СуммаВсего=СтрокаТовары.Сумма;
  		ПеремещениеОбъект.ОбработкаРеквизита("Товары.СуммаВсего", СтрокаТовары,, ДопПараметры);
	КонецЦикла; 
	 	
	Если ЕстьОшибки Тогда
		#Если НаКлиенте Тогда
			Сообщить("ОШИБКА! Перемещение между складами не сформировано.",СтатусСообщения.ОченьВажное);
		#КонецЕсли 
		Возврат ЕстьОшибки;
	КонецЕсли;
	
	Попытка
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		#Если НаКлиенте Тогда
			Сообщить(ОписаниеОшибки());
		#КонецЕсли
		ЕстьОшибки=Истина;
	КонецПопытки;
	
	Попытка
		СвойствоАвто = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		СвойствоАвто.Объект   = ПеремещениеОбъект.Ссылка;
		СвойствоАвто.Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.ДокументСозданАвтоматически;
		СвойствоАвто.Значение = Истина;
		СвойствоАвто.Записать(Истина);
	Исключение
		//
	Конецпопытки;	
	
	Попытка
		ПеремещениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		#Если НаКлиенте Тогда
			Сообщить(ОписаниеОшибки());
		#КонецЕсли
		ЕстьОшибки=Истина;
	КонецПопытки;	
	
	
	Возврат ЕстьОшибки;
	
КонецФункции // СоздатьМежскладскоеПеремещение()

