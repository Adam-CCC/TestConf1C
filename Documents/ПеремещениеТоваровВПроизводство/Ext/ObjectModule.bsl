//Дадов 20260916 ++
Функция СделатьВнешнююМаркировкуВнутренней(КодМаркировки, Номенклатура)

    //Разбираем КМ на GTIN и серийный номер
    ОбработкаШК = Обработки.ШтрихКоды.Создать();
    СтруктураМаркировки = ОбработкаШК.РазобратьСтрокуШтрихкодаGS1(КодМаркировки, Истина);
    
    Если НЕ СтруктураМаркировки.Разобран Тогда
        Сообщить("Не удалось разобрать КМ: " + КодМаркировки, СтатусСообщения.Важное);
        Возврат "";
    КонецЕсли;
    
    GTIN          = СтруктураМаркировки.ДанныеШтрихкода["01"].Значение;
    СерийныйНомер = СтруктураМаркировки.ДанныеШтрихкода["21"].Значение;
    
    //Смотрим состояние в регистре
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   СостоянияКМ.Состояние КАК Состояние
    |ИЗ
    |   РегистрСведений.СостоянияКодовМаркировки.СрезПоследних КАК СостоянияКМ
    |ГДЕ
    |   СостоянияКМ.Номенклатура = &Номенклатура
    |   И СостоянияКМ.GTIN = &GTIN
    |   И СостоянияКМ.СерийныйНомер = &СерийныйНомер";
    
    Запрос.УстановитьПараметр("Номенклатура",  Номенклатура);
    Запрос.УстановитьПараметр("GTIN",          GTIN);
    Запрос.УстановитьПараметр("СерийныйНомер", СерийныйНомер);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    //Если в обороте — не трогаем
    Если Выборка.Следующий() Тогда
		Если Выборка.Состояние = Перечисления.СостоянияКодовМаркировки.ВведенВОборот Тогда
		    Сообщить("КМ в обороте, внутренний код не создаётся: " + КодМаркировки, СтатусСообщения.Важное);
		    Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//Проверка разработан ли уже внутренниий КМ для внешнего КМ
	ЕстьВнутреннийКМДляВнешнегоКМ = ЕстьВнутреннийКМДляВнешнегоКМ(КодМаркировки);	
	Если ЕстьВнутреннийКМДляВнешнегоКМ Тогда
		Сообщить("Внутренний код маркировки уже разработан");
		Возврат ЕстьВнутреннийКМДляВнешнегоКМ;	
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
    // 4. Делаем внутренний КМ
    КМБезПрефикса = "01" + GTIN + "21" + СерийныйНомер;
    ВнутреннийКМ  = "!SM!" + КМБезПрефикса;
    
    // 5. Пишем в регистр
    МенеджерЗаписи = РегистрыСведений.ВнутренниеКодыМаркировок.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.ВнутреннийКодМаркировки = ВнутреннийКМ;
    МенеджерЗаписи.ВнешнийКодМаркировки    = КМБезПрефикса;
    МенеджерЗаписи.Номенклатура            = Номенклатура;
    МенеджерЗаписи.Записать(Истина);
    
    Возврат ВнутреннийКМ;
КонецФункции

Функция ЕстьВнутреннийКМДляВнешнегоКМ(ВнешнийКМ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВнутренниеКодыМаркировок.ВнешнийКодМаркировки КАК ВнешнийКодМаркировки,
		|	ВнутренниеКодыМаркировок.ВнутреннийКодМаркировки КАК ВнутреннийКодМаркировки
		|ИЗ
		|	РегистрСведений.ВнутренниеКодыМаркировок КАК ВнутренниеКодыМаркировок
		|ГДЕ
		|	ВнутренниеКодыМаркировок.ВнешнийКодМаркировки = &ВнешнийКМ";
	
	Запрос.УстановитьПараметр("ВнешнийКМ", ВнешнийКМ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() > 0 Тогда 
		Возврат Ложь;	
	Иначе
		Пока Выборка.Следующий() Цикл
			Возврат Выборка.ВнутреннийКодМаркировки;	
		КонецЦикла;
	КонецЕсли;
КонецФункции
