Процедура СформироватьПерепродажу(ВопросОПеремещении=Истина,ВозврЗначение) Экспорт
	
	Если ВопросОПеремещении Тогда
		#Если НаКлиенте Тогда
			Если Вопрос("Сформировать перепродажу между юридическими лицами компании?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
	ТоварыКПродаже = Новый ТаблицаЗначений;
	ТоварыКПродаже.Колонки.Добавить("Товар");
	ТоварыКПродаже.Колонки.Добавить("Количество");
	ТоварыКПродаже.Колонки.Добавить("ЗН");
	ТоварыКПродаже.Колонки.Добавить("ЕдиницаИзмерения");
	ТоварыКПродаже.Колонки.Добавить("ОрганизацияПоставщик");
	ТоварыКПродаже.Колонки.Добавить("ПодразделениеПоставщик");
	ТоварыКПродаже.Колонки.Добавить("СкладОтправитель");
	ТоварыКПродаже.Колонки.Добавить("ИНН_Покупателя");
	ТоварыКПродаже.Колонки.Добавить("ИНН_Продавца");
	
	//Бондаренко++ 20201214
	ТоварыКПродаже.Колонки.Добавить("ИдентификаторТовара");
	//Бондаренко-- 20201214
	
	Для Каждого стр из Товары цикл
		
		СтрокаТоварыКПродаже = ТоварыКПродаже.Добавить();
		
		СтрокаТоварыКПродаже.Товар = стр.Номенклатура;
		СтрокаТоварыКПродаже.Количество = стр.Количество;
		СтрокаТоварыКПродаже.ЗН = Ссылка.Ссылка;
		СтрокаТоварыКПродаже.ЕдиницаИзмерения = стр.ЕдиницаИзмерения;
		СтрокаТоварыКПродаже.ОрганизацияПоставщик = Ссылка.Организация;
		СтрокаТоварыКПродаже.ПодразделениеПоставщик = Ссылка.ПодразделениеКомпании;
		СтрокаТоварыКПродаже.СкладОтправитель = Ссылка.СкладКомпании;
		СтрокаТоварыКПродаже.ИНН_Покупателя = Ссылка.ДокументОснование.Организация.ИНН;
		СтрокаТоварыКПродаже.ИНН_Продавца = Ссылка.Организация.ИНН; 
		
		//Бондаренко++ 20201214
		СтрокаТоварыКПродаже.ИдентификаторТовара = стр.ИдентификаторТовара;
		//Бондаренко-- 20201214
		
	КонецЦикла;	
	
	//ТоварыКПродаже.ВыбратьСтроку();
	
	//Бондаренко++ 20201214
	ТаблицаКодовМаркировки = Новый ТаблицаЗначений;
	ТаблицаКодовМаркировки.Колонки.Добавить("ИдентификаторТовара");
	ТаблицаКодовМаркировки.Колонки.Добавить("КодМаркировки");
	
	ЕстьКодыМаркировки=Ложь;
	Для Каждого стр из КодыМаркировки цикл
		СтрокаКодов = ТаблицаКодовМаркировки.Добавить();
		СтрокаКодов.ИдентификаторТовара = стр.ИдентификаторТовара;
		СтрокаКодов.КодМаркировки = стр.КодМаркировки;
		ЕстьКодыМаркировки=Истина;
	КонецЦикла;
	//ТаблицаКодовМаркировки.ВыбратьСтроку();
	//Бондаренко-- 20201214
	
	БылиОшибки = Истина;  
	
	Если ТоварыКПродаже.Количество() > 0 тогда
		НачатьТранзакцию();
		БылиОшибки = СоздатьДокументыПерепродажиПоЮрЛицам(ТоварыКПродаже,ТаблицаКодовМаркировки);
		ЗафиксироватьТранзакцию();
	КонецЕсли; 
	
	Если БылиОшибки Тогда
		Сообщить("Обработка по перепродаже завершена С ошибками",СтатусСообщения.ОченьВажное);
		ВозврЗначение=Ложь;
	Иначе	
		Сообщить("Обработка по перепродаже завершена БЕЗ ошибок.",СтатусСообщения.Обычное);	
		ВозврЗначение=Истина;
	КонецЕсли; 
	
КонецПроцедуры	
