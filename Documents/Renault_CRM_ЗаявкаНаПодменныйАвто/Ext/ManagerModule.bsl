		ДанныеОбъекта.Вставить("СтоимостьВыданногоАвто", ?(НЕ ЗначениеЗаполнено(Выборка.ЦенаКлиентская), Выборка.ЦенаКлиентская, "" + Выборка.ЦенаКлиентская + " руб. в т.ч. НДС - " + Выборка.СуммаНДС + " руб.")); 
		
