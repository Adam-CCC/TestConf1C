Функция ПолучитьОписаниеОбластейМакетаОфисногоДокумента()
	
	ОписаниеОбластей = Новый Структура;
	
	Renault_УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Заголовок", "Общая");
	
	Возврат ОписаниеОбластей;
	
КонецФункции

//Козлов Е.А. Начало 11.11.2016
Функция ОбрезатьЛишниеСимволы(НачальныйНомер)
	СтрокаЭталон = "123456789";
	
	ДлинаСтроки = СтрДлина(НачальныйНомер);
	
	КонечныйНомер = "";
	Для Счетчик = 1 По ДлинаСтроки Цикл
		ТекущийСимвол = Сред(НачальныйНомер, Счетчик, 1);
		
		Если СтрЧислоВхождений(СтрокаЭталон, ТекущийСимвол) <> 0 Тогда
			КонечныйНомер = Прав(НачальныйНомер, ДлинаСтроки - Счетчик + 1);
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат ?(ЗначениеЗаполнено(КонечныйНомер), КонечныйНомер, НачальныйНомер);	
КонецФункции
//Козлов Е.А. Конец