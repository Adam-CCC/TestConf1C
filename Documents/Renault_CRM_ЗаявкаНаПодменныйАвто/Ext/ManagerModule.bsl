Функция ПолучитьДанныеПечати(Знач МассивДокументов, Знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	    
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, ПолучитьДанныеОбъекта(ОбъектСсылка, ИмяМакета));
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ОписаниеОбластей.Вставить(ИмяМакета, ПолучитьОписаниеОбластейМакетаОфисногоДокумента());
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие; 	
	
	Возврат Новый Структура("Данные, Макеты",
							ДанныеПоВсемОбъектам,
							Новый Структура("ОписаниеОбластей, ТипыМакетов, ДвоичныеДанныеМакетов",
											ОписаниеОбластей,
											ТипыМакетов,
											ДвоичныеДанныеМакетов));
	
КонецФункции

Функция ПолучитьДанныеОбъекта(СсылкаНаОбъект, ИмяМакета)
	//Козлов Е.А. Начало 10.11.2016
	МетаданныеСтрока = "Контрагенты";
	Если ТипЗнч(СсылкаНаОбъект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		МетаданныеСтрока = "CRM_ПотенциальныеКонтрагенты";
	КонецЕсли;  
	
	//DMSREN-1335 добавил в запрос птс и стс
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Организации.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
	|	Организации.ИНН КАК ОрганизацияИНН,
	|	Организации.КПП КАК ОрганизацияКПП,
	|	Организации.ОсновнойБанковскийСчет КАК ОрганизацияОсновнойБанковскийСчет,
	|	Организации.ОсновнойБанковскийСчет.Банк КАК ОрганизацияБанк,
	|	Организации.ОсновнойБанковскийСчет.Банк.КоррСчет КАК ОрганизацияКоррСчет,
	|	Организации.ОсновнойБанковскийСчет.Банк.Код КАК ОрганизацияБИК,
	|	КонтактнаяИнформацияРег.Представление КАК ОрганизацияАдресФактический
	|ПОМЕСТИТЬ ДанныеОрганизации
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияРег
	|		ПО Организации.Ссылка = КонтактнаяИнформацияРег.Объект
	|			И (КонтактнаяИнформацияРег.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (КонтактнаяИнформацияРег.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический))
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Номер КАК НомерЗаявки,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Дата КАК ДатаЗаявки,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Клиент,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.ДилерскийЦентр.ОсновнойАдрес КАК АдресДилерскогоЦентра,
	|	ВЫБОР
	|		КОГДА Renault_CRM_ЗаявкаНаПодменныйАвто.Клиент ССЫЛКА Справочник." + МетаданныеСтрока + "
	|			ТОГДА ВЫРАЗИТЬ(Renault_CRM_ЗаявкаНаПодменныйАвто.Клиент КАК Справочник." + МетаданныеСтрока + ").Наименование
	|	КОНЕЦ КАК КлиентНаименование,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.ВремяНачала,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.ВремяОкончания,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Машиноместо,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Автор.Сотрудник КАК Сотрудник,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Автор.Сотрудник.Наименование КАК СотрудникНаименование,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Машиноместо.Автомобиль,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Машиноместо.Автомобиль.Модель,
	|	Renault_CRM_ЗаявкаНаПодменныйАвто.Машиноместо.Автомобиль.ВариантКомплектации
	|ПОМЕСТИТЬ ДанныеЗаявки
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаПодменныйАвто КАК Renault_CRM_ЗаявкаНаПодменныйАвто
	|ГДЕ
