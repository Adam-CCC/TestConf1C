	//		Renault_СообщенияПользователю.СоздатьСообщение(Ссылка, Неопределено, МассивСообщений, Справочники.Renault_ВидСообщения.Автосервис_МойкаОкончена, Неопределено, Неопределено);
	//	КонецЕсли;
	//	
	//КонецЕсли;
	
	Если Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ВРаботе Тогда 		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		Запись.Обращение = Обращение;
		Запись.Цех = Машиноместо;
		Запись.ЭтапРабот = 1;
		Запись.РабочийДокумент = Ссылка;
