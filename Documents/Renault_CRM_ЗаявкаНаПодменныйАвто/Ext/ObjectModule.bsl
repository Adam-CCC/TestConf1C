Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)          	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Дата) ИЛИ НачалоДня(Дата) = НачалоДня(ТекущаяДата()) Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	Renault_CRM_ЗаявкаНаМойку.Ссылка,
	//|	Renault_CRM_ЗаявкаНаМойку.ВремяНачала,
	//|	Renault_CRM_ЗаявкаНаМойку.ВремяОкончания
	//|ИЗ
	//|	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
	//|ГДЕ
	//|	Renault_CRM_ЗаявкаНаМойку.Машиноместо = &Машиноместо
	//|	И Renault_CRM_ЗаявкаНаМойку.Ссылка <> &Ссылка";
	//Запрос.УстановитьПараметр("Машиноместо", Машиноместо);
	//Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_АвтосервисПланРабот.РабочийДокумент КАК Ссылка,
	|	Renault_АвтосервисПланРабот.ВремяНачала,
	|	Renault_АвтосервисПланРабот.ВремяОкончания,
	|	Renault_АвтосервисПланОперативный.ВремяНачала КАК ВремяНачалаПлан,
	|	Renault_АвтосервисПланОперативный.ВремяОкончания КАК ВремяОкончанияПлан,
	|	Renault_АвтосервисФактОперативный.ВремяНачала КАК ВремяНачалаФакт,
	|	Renault_АвтосервисФактОперативный.ВремяОкончания КАК ВремяОкончанияФакт
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисПланОперативный КАК Renault_АвтосервисПланОперативный
	|	ПО Renault_АвтосервисПланОперативный.РабочийДокумент = Renault_АвтосервисПланРабот.РабочийДокумент
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтосервисФактОперативный КАК Renault_АвтосервисФактОперативный
	|	ПО Renault_АвтосервисФактОперативный.РабочийДокумент = Renault_АвтосервисПланРабот.РабочийДокумент
	|ГДЕ
	|	Renault_АвтосервисПланРабот.РабочийДокумент <> &РабочийДокумент
	|	И Renault_АвтосервисПланРабот.ДилерскийЦентр = &ДилерскийЦентр
	|	И Renault_АвтосервисПланРабот.Цех = &Цех";
	Запрос.УстановитьПараметр("Цех", Машиноместо);
	Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	Запрос.УстановитьПараметр("РабочийДокумент", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// если нет факт-плана и опер.плана тогда
		Если НЕ (ЗначениеЗаполнено(Выборка.ВремяНачалаФакт) ИЛИ ЗначениеЗаполнено(Выборка.ВремяНачалаПлан)) Тогда
			Если (ВремяНачала >= Выборка.ВремяНачала И ВремяНачала < Выборка.ВремяОкончания) ИЛИ
				(ВремяОкончания > Выборка.ВремяНачала И ВремяОкончания <= Выборка.ВремяОкончания) Тогда
				Сообщить("Есть пересечения с существующим документом:" + Выборка.Ссылка);
				Отказ = Истина;
			КонецЕсли;
		//Если есть план или факт
		Иначе
			// если есть факт
			Если ЗначениеЗаполнено(Выборка.ВремяНачалаФакт) Тогда
				Если (ВремяНачала >= Выборка.ВремяНачалаФакт И ВремяНачала < Выборка.ВремяОкончанияФакт) ИЛИ
					(ВремяОкончания > Выборка.ВремяНачалаФакт И ВремяОкончания <= Выборка.ВремяОкончанияФакт) Тогда
					Сообщить("Есть пересечения с существующим документом:" + Выборка.Ссылка);
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
			// если есть план
			Если ЗначениеЗаполнено(Выборка.ВремяНачалаПлан) Тогда
				Если (ВремяНачала >= Выборка.ВремяНачалаПлан И ВремяНачала < Выборка.ВремяОкончанияПлан) ИЛИ
					(ВремяОкончания > Выборка.ВремяНачалаПлан И ВремяОкончания <= Выборка.ВремяОкончанияПлан) Тогда
					Сообщить("Есть пересечения с существующим документом:" + Выборка.Ссылка);
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)    	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	//Если СостояниеИзменено Тогда
