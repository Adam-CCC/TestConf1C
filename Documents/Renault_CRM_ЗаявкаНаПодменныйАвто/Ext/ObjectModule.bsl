		//Запись.ВремяОкончания = ТекущаяДата() + ЭтотОбъект.Длительность*60;
		Запись.ВремяОкончания = ВремяНачала + ЭтотОбъект.Длительность * 3600;
		//Козлов Е.А. Конец
		Запись.Длительность = ЭтотОбъект.Длительность;
