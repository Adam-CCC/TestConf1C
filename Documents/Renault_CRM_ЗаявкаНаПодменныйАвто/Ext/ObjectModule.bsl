		Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
			Возврат;
		КонецЕсли;
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
