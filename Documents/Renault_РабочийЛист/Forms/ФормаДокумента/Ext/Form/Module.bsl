&НаСервере
Процедура Воронка_ОбновитьВзятТелефон(ЭтоТрейдИн = Ложь)
	
	Если ЭтоТрейдИн Тогда
		ИмяЭлемента = "ВзятТелефонТрейдИн";
	Иначе
		ИмяЭлемента = "ВзятТелефон";
	КонецЕсли;	
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK 			= Объект.IDK;
	Запись.ЭтапПродаж 	= Справочники.CRM_ЭтапыПродаж.НаличиеТелефона;
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		//Было посещение
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		Элементы[ИмяЭлемента].ЦветФона = ЦветRenault2;
		Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.Клиент);
		Телефон = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Телефон, Объект.ДилерскийЦентр);
		Элементы[ИмяЭлемента].Заголовок = ?(Телефон = "", "Телефон (" + ТекстДата + ")", "Тел: " + Строка(Телефон));
	Иначе
		//Не было посещения
		Элементы[ИмяЭлемента].ЦветФона = ЦветКнопкиВоронкиСерый;
		Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.Клиент);
		Телефон = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Телефон, Объект.ДилерскийЦентр);
		Элементы[ИмяЭлемента].Заголовок = ?(Телефон = "", "Телефон", "Тел: " + Строка(Телефон));
	КонецЕсли;
	
КонецПроцедуры // Воронка_ОбновитьВзятТелефон()

