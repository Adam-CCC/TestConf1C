&НаКлиенте
Процедура ПроизводительТрейдИнПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		ЗаявкаНаТрейдИнОбъект = ЗаявкаНаТрейдИн.ПолучитьОбъект();
	Иначе
		Сообщить("Необходимо создать заявку на трейд-ин!");
		Возврат;
	КонецЕсли;
	
	ЗаявкаНаТрейдИнОбъект.ПроизводительКод = ПроизводительТрейдИн;
	ЗаявкаНаТрейдИнОбъект.МесяцВыпуска = "06";
	ЗаявкаНаТрейдИнОбъект.ГодВыпуска = "";
	ЗаявкаНаТрейдИнОбъект.МодельКод = "";
	ЗаявкаНаТрейдИнОбъект.ТипКузоваКод = "";
	ЗаявкаНаТрейдИнОбъект.ДвигательКод = "";
	ЗаявкаНаТрейдИнОбъект.КППКод = "";
	ЗаявкаНаТрейдИнОбъект.МодификацияКод = "";
	ЗаявкаНаТрейдИнОбъект.Опции.Очистить();
	ЗаявкаНаТрейдИнОбъект.ОриентировочнаяЦена = 0;  
	ЗаявкаНаТрейдИнОбъект.ОжиданиеСтоимостиКлиента = 0;
	ЗаявкаНаТрейдИнОбъект.Автомобиль = ПредопределенноеЗначение("Справочник.Автомобили.ПустаяСсылка");
	ЗаявкаНаТрейдИнОбъект.Цвет = ""; 
	ЗаявкаНаТрейдИнОбъект.VIN = "";
	ЗаявкаНаТрейдИнОбъект.ГосНомер = "";
	ЗаявкаНаТрейдИнОбъект.СрокДействия = "";
	ЗаявкаНаТрейдИнОбъект.ОценкаСостояния = ""; 
	ЗаявкаНаТрейдИнОбъект.Пробег = "";
	ЗаявкаНаТрейдИнОбъект.КоличествоВладельцевПоПТС = "";
	ЗаявкаНаТрейдИнОбъект.СостояниеШин = "";
	ЗаявкаНаТрейдИнОбъект.НаличиеАварий = Ложь;
	ЗаявкаНаТрейдИнОбъект.ОригиналПТС = Ложь;
	ЗаявкаНаТрейдИнОбъект.Металик = Ложь;
	ЗаявкаНаТрейдИнОбъект.Записать();
	
	ГодВыпускаТрейдИн = "";
	МодельТрейдИн = "";
	ОжидаемаяСтоимостьКлиентаТрейдИн = 0;
	
	Значение = ЗначениеЗаполнено(ПроизводительТрейдИн);
	Если Значение Тогда		
		ЗаполнитьСписокВыбораЭлемента("ГодВыпускаТрейдИн");
	КонецЕсли; 	
	
	ПараметрыУправленияЭлементами = Новый Структура();
	ПараметрыУправленияЭлементами.Вставить("ГодВыпускаТрейдИн", 						Значение);
	ПараметрыУправленияЭлементами.Вставить("ВыбратьГодВыпускаТрейдИн", 					Значение);
	ПараметрыУправленияЭлементами.Вставить("МодельТрейдИн", 							ЗначениеЗаполнено(ГодВыпускаТрейдИн));
	ПараметрыУправленияЭлементами.Вставить("ВыбратьМодельТрейдИн", 						ЗначениеЗаполнено(ГодВыпускаТрейдИн));
	ПараметрыУправленияЭлементами.Вставить("ОжидаемаяСтоимостьКлиентаТрейдИн", 			ЗначениеЗаполнено(МодельТрейдИн));
	ПараметрыУправленияЭлементами.Вставить("ВвестиОжидаемаяСтоимостьКлиентаТрейдИн", 	ЗначениеЗаполнено(МодельТрейдИн));

	ОбновитьИнтерфейсТрейдИн(ПараметрыУправленияЭлементами);
	
КонецПроцедуры // ПроизводительТрейдИнПриИзменении()

