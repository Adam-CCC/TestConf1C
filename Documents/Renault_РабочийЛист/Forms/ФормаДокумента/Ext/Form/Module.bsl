//
&НаСервере
Процедура ОбновитьДоступностьПолей() 
	
	ЕстьПраваРОП = Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмРОП(ПараметрыСеанса.Пользователь);
	Элементы.РОП.Видимость = ЕстьПраваРОП;
	
