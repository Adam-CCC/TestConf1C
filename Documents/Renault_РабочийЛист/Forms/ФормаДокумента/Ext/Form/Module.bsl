    Если Не Строка = Неопределено Тогда
        ТаблицаОТС = Renault_АвтосервисСервер.Renault_ОбработатьОТС(Строка);
		Если ТаблицаОТС.Количество()>0 тогда
			Для Каждого СтрокаТЗ из ТаблицаОТС Цикл
				Предупреждение(Строка("По автомобилю с VIN: "+Строка+"Отзывная компания:" + СтрокаТЗ.НаименованиеОТС +Символы.ПС + "
				| Номер технической ноты: " +Строка(СтрокаТЗ.НомерТехническойНоты)),10,"По данному автомобилю, есть отзывные компании!");
			КонецЦикла;
		КонецЕсли;
    КонецЕсли;
//DMSREN-715 
