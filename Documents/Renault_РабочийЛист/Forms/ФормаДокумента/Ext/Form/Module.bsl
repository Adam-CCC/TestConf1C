&НаКлиенте
Процедура ТаблоТестДрайвОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТабличныйДокумент    = Элементы.ТаблоТестДрайв;
	ТекущаяОбласть       = ТабличныйДокумент.ТекущаяОбласть;
	Если ТекущаяОбласть.Лево = 8 Тогда
		
		НомерДокумента = Расшифровка;
		CRM_Клиент.ДополнитьСтроку(НомерДокумента, 9, " ");
		ДокументСсылка = Документы.CRM_ЗаписьНаТестДрайв.НайтиПоНомеру(НомерДокумента);
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			
			//Иначе печатаем типовой вариант
			МассивДокументов = Новый Массив;
			МассивДокументов.Добавить(ДокументСсылка);
			
			Форма = Документы.CRM_ЗаписьНаТестДрайв.ПолучитьФорму("ФормаЗаполненияДанныхДляПечати", ЭтаФорма);
			Форма.СсылкаНаОбъект = ДокументСсылка;
			Если НЕ Форма.ОткрытьМодально() = Истина Тогда
				Возврат;
			КонецЕсли;
			
			CRM_Клиент.ПечатьДокументаВыборФормы(МассивДокументов, "Документ.CRM_ЗаписьНаТестДрайв");
			
		КонецЕсли;
		
	ИначеЕсли ТекущаяОбласть.Лево = 9 Тогда
		
		ДокСобытие = Расшифровка;
		Ответ = ДокСобытие.ПолучитьФорму("ФормаЗавершенияСобытия").ОткрытьМодально();
		
	КонецЕсли;
	
КонецПроцедуры // ТаблоТестДрайвОбработкаРасшифровки()

