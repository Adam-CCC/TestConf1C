&НаКлиенте
Процедура НовыйАвтомобильПриИзменении(Элемент)
	
	Объект.ПродажаБУ = НовыйАвтомобиль = 1;
	ПараметрыУправленияСтраницами = Новый Структура("ТипРабочегоЛиста", Объект.ТипРабочегоЛиста);

	ОбновитьИнтерфейсТрейдИн(, ПараметрыУправленияСтраницами);
	ОбновитьПоляДляСтатистики();
	
КонецПроцедуры // НовыйАвтомобильПриИзменении()

&НаКлиенте
Процедура КарточкаКлиента(Команда)
	
	Если Объект.Клиент <> Неопределено Тогда
		Профиль = Справочники.Renault_ПрофилиКлиентов.СохранитьКлиентаВПрофиль(Объект.Клиент);
		Профиль.ПолучитьФорму(, ЭтаФорма).Открыть();
	КонецЕсли;
	
КонецПроцедуры // КарточкаКлиента()

&НаКлиенте
Процедура КлиентыРабочегоЛиста(Команда)
	
	Форма = РегистрыСведений.Renault_РабочиеЛисты.ПолучитьФорму("ФормаКлиентыРабочегоЛиста");
	Форма.РабочийЛист = Объект.IDK;
	Форма.КлиентРабочегоЛиста = Объект.Клиент;
	Форма.ОткрытьМодально();
	
КонецПроцедуры // КлиентыРабочегоЛиста()

&НаКлиенте
Процедура Позвонить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда
		Возврат;
	КонецЕсли;	
	
	ИспользуемаяТелефония = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользуемаяТелефония;
	
	Если ИспользуемаяТелефония = "" ИЛИ ИспользуемаяТелефония = "СофтФон" Тогда
		Если НЕ ОбПраво("сфпИспользоватьСофтФон") Тогда		
			Возврат;
		КонецЕсли;	
		СписокОбъектов = Новый СписокЗначений;
		СписокОбъектов.Добавить(Объект.Клиент, Объект.Клиент);
		ТекАТС = Константы.CRM_ИспользуемыйСофтФон.Получить();
		Если (ТекАТС = Перечисления.CRM_ИспользуемыйСофтФон.СофтФон3) Тогда //DMSREN-370 было Перечисления.CRM_ИспользуемыйСофтФон.СофтФон2
			сфпСофтФонПроКлиент.сфпПозвонитьВыбравТелефон(СписокОбъектов); //DMSCOR-1550 сфпФормаТелефонВнешняяПанель не используется с 5.1.16
		ИначеЕсли (ТекАТС = Перечисления.CRM_ИспользуемыйСофтФон.СофтФонПроф) И НЕ (РарусСофтФонПроф = Неопределено) Тогда
			РарусСофтФонПроф.ПозвонитьВыбравТелефон(СписокОбъектов);
		КонецЕсли;
	ИначеЕсли ИспользуемаяТелефония = "БИТФон" Тогда
		Выполнить("бит_БитфонКлиент.ОткрытьБитфонНачатьРазговор(Клиент)");	
	КонецЕсли; 
	
КонецПроцедуры // Позвонить()

&НаКлиенте
Процедура ОтправитьСМС(Команда)
	
	//Renault_ОбщийМодуль.ОтправитьСМСИзКарточкиКонтрагента(Объект.Клиент, ЭтаФорма);
	Если ЗначениеЗаполнено(Объект.Клиент) тогда
		Форма = ПолучитьФорму("Справочник.DMS_ШаблоныSMS.Форма.ФормаSMSРЛ");
		Форма.Контрагент = Объект.Клиент;
		Форма.НомерТелефона = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Клиент_Телефон, Объект.ДилерскийЦентр);
		
		Форма.Email = Клиент_Email;
		Форма.Менеджер = Объект.Сотрудник;
		
		// +++ ВГА 08.11.2021 DMSREN-1336
		//Форма.Открыть();
		Результат = Форма.ОткрытьМодально();
		ЗафиксироватьРезультатОтправкиСМС(Результат);
		// --- ВГА 08.11.2021 DMSREN-1336
	КонецЕсли;
	
КонецПроцедуры // ОтправитьСМС()

&НаСервере
Процедура ЗафиксироватьРезультатОтправкиСМС(Результат) // ВГА 08.11.2021 DMSREN-1336
	
	Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Результат.Свойство("ОтправленныеСообщения") ИЛИ НЕ Результат.Свойство("ОписаниеОшибки") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяДата = ТекущаяДата();
	ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
	
	Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	Событие.IDK = Объект.IDK;
	Событие.Дата = ТекущаяДата;
	Событие.Автор = ТекСотрудник;
	Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.ОтправкаСМС;
	Событие.ДатаНапоминания = ТекущаяДата;
	Событие.ДатаЗакрытия = ТекущаяДата;
	Событие.АвторЗакрытия = ТекСотрудник;
	Событие.Сотрудник = ТекСотрудник;
	Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
	Событие.Подразделение = Объект.Подразделение;
	Событие.Отдел = Объект.Отдел;
	Событие.Комментарий = "Отправка СМС из рабочего листа";
	Событие.Обработано = Истина;
		
	Если Результат.ОтправленныеСообщения.Количество() <> 0 И ПустаяСтрока(Результат.ОписаниеОшибки) Тогда
		Событие.КомментарийЗакрытия = "СМС отправлено";
		Событие.ЗавершеноУспешно = Истина;
	Иначе
		Событие.КомментарийЗакрытия = "СМС не отправлено";
		Событие.ЗавершеноУспешно = Ложь;
		
		Если НЕ ПустаяСтрока(Результат.ОписаниеОшибки) Тогда
			Событие.Комментарий = СтрШаблон("%1%2(%3)", Событие.Комментарий, Символы.ПС, Результат.ОписаниеОшибки);
		КонецЕсли;
		Сообщить("Не удалось отправить СМС. Подробности см. в событии");
	КонецЕсли;
	
	Попытка
		Событие.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЗаписьЖурналаРегистрации(Документы.CRM_СобытияПоРабочимЛистам, 
	        УровеньЖурналаРегистрации.Ошибка, , ,
	        "Ошибка записи документа");
	КонецПопытки;
	
	ОбновитьСписокСобытий();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактнаяИнформация(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Клиент) Тогда
		Возврат;
	КонецЕсли;

	////Параметры записи КИ для редактирования
	НаборКонтактнойИнформации = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборКонтактнойИнформации.Отбор.Объект.Установить(Объект.Клиент);
	НаборКонтактнойИнформации.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Телефон);     
	НаборКонтактнойИнформации.Прочитать();
	
	Для Каждого ЗаписьРегистра Из НаборКонтактнойИнформации Цикл
		//Найдем телефон по умолчанию в наборе записей
		Если ЗаписьРегистра.ЗначениеПоУмолчанию=Истина Тогда
			 ЗаписьРегистраДляРедактирования=ЗаписьРегистра;
			 
			СтруктураТелефона = Renault_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруТелефонаПоПолям(ЗаписьРегистраДляРедактирования.Представление, Объект.ДилерскийЦентр);

			Если Не ЗначениеЗаполнено(ЗаписьРегистраДляРедактирования.Поле1) Тогда								
				ЗаписьРегистраДляРедактирования.Поле1 = СтруктураТелефона.Поле1
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ЗаписьРегистраДляРедактирования.Поле2) Тогда
				ЗаписьРегистраДляРедактирования.Поле2 = СтруктураТелефона.Поле2;
				ЗаписьРегистраДляРедактирования.Поле3 = СтруктураТелефона.Поле3;
			КонецЕсли;

			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗаписьРегистраДляРедактирования=Неопределено Тогда
		//Если телефона по умолчанию не найдено, то создадим новый
		ЗаписьРегистраДляРедактирования=НаборКонтактнойИнформации;
		СтруктураНовойЗаписи=Новый Структура;
		СтруктураНовойЗаписи.Вставить("Объект",Объект.Клиент);
		СтруктураНовойЗаписи.Вставить("Тип",Перечисления.ТипыКонтактнойИнформации.Телефон);
		СтруктураНовойЗаписи.Вставить("Вид",Объект.ДилерскийЦентр.ОсновнойВидТелефонаКлиента);
	КонецЕсли;
	
	ОбработкаРедактированияКонтактнойИнформации = Обработки.Renault_РедактированиеКонтактнойИнформации.Создать();
	ОбработкаРедактированияКонтактнойИнформации.РедактированиеБезВладельца=Истина;
	ОбработкаРедактированияКонтактнойИнформации.Объект=Объект.Клиент;
	ОбработкаРедактированияКонтактнойИнформации.мНаборЗаписейКонтактнойИнформации=НаборКонтактнойИнформации;
	ОбработкаРедактированияКонтактнойИнформации.РедактироватьЗапись(ЗаписьРегистраДляРедактирования,,ЭтаФорма,СтруктураНовойЗаписи);
	ОбработкаРедактированияКонтактнойИнформации.ЗапуститьФорму(ЭтаФорма);
	
КонецПроцедуры // КонтактнаяИнформация()

