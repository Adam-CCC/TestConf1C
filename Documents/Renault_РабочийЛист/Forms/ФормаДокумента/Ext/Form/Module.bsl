&НаКлиенте
Процедура ДоговорСКлиентомТрейдИн(Команда)
	
	Если Не ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда
		Сообщить("Для принятия автомобиля по Trade-in должен быть указан клиент.");
	КонецЕсли;
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		
		Ответ = Вопрос("Для принятия автомобиля по Trade-in клиент должен быть контрагентом. "+Символы.ПС+"Вы хотите перевести потенциального клиента в контрагенты?",РежимДиалогаВопрос.ДаНет,,,"Вопрос");
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Клиент = CRM_Редубликация.СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(Объект.Клиент);
		Объект.Клиент = Клиент;
		//ЭтаФорма.Записать();
		Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
		Запись.Клиент = Клиент;
		Запись.Записать();
		ЗаявкаОб = ЗаявкаНаТрейдИн.ПолучитьОбъект();
		ЗаявкаОб.Клиент = Клиент;
		ЗаявкаОб.Записать();
		
		ЗаявкаНаТрейдИн = ЗаявкаОб.ССылка;
	КонецЕсли;
	
	Ошибки = "";
	
	Поступление = Renault_СПробегомКлиент.ОформитьПокупкуАвтомобиля(ЗаявкаНаТрейдИн, Ошибки);
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		Предупреждение(Ошибки);
		Возврат;
	КонецЕсли;
	
	Если Поступление = Документы.ПоступлениеАвтомобилей.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	Поступление.ПолучитьФорму().ОткрытьМодально();
	Попытка
		Набор = РегистрыСведений.ЦеныАвтомобилей.СоздатьНаборЗаписей();
	 	Набор.Отбор.Регистратор.Установить(Поступление.Ссылка);
		СтрНабор = Набор.Добавить();
		СтрНабор.Регистратор = Поступление.Ссылка;
		СтрНабор.Период=Поступление.Дата;
		СтрНабор.ТипЦен=Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
		СтрНабор.Автомобиль=ЗаявкаНаТрейдИн.Автомобиль;
		СтрНабор.Цена=ЗаявкаНаТрейдИн.ОриентировочнаяЦенаСреднее;
		Набор.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Поступление.ДатаОперации) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_ДополнительнаяИнформацияПоАвтомобилям.КодАвтомобиляВыкупа КАК ПорядковыйНомер
		|ИЗ
		|	РегистрСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям КАК CRM_ДополнительнаяИнформацияПоАвтомобилям
		|ГДЕ
		|	ПОДСТРОКА(CRM_ДополнительнаяИнформацияПоАвтомобилям.КодАвтомобиляВыкупа, 2, 4) = &BIR
		|	И CRM_ДополнительнаяИнформацияПоАвтомобилям.Автомобиль = &Автомобиль";
		
		BIR = ЗаявкаНаТрейдИн.ДилерскийЦентр.BIR;
		Автомобиль = ЗаявкаНаТрейдИн.Автомобиль;
		
		Запрос.УстановитьПараметр("BIR", Прав(BIR, 4));
		Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			КодифицироватьАвтомобиль(Автомобиль, Поступление.ДатаОперации, BIR, ЗаявкаНаТрейдИн.ТипОперацииTradeIn);
		КонецЕсли;
		
	КонецЕсли;
		
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнДоговорСКлиентом;
	Запись.ДатаВыполнения = ТекущаяДата();
	Запись.Записать();
	
	ЗаявкаОб = ЗаявкаНаТрейдИн.ПолучитьОбъект();
	ЗаявкаОб.Статус = Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.ОформлениеЗавершено;
	ЗаявкаОб.Записать();
	
	//проверим является ли поступивший автомобиль законтрактованым ранее, если да снимем с него резерв	
	Если ЗаявкаНаТрейдИн.Статус = Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.ОформлениеЗавершено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ЗаконтрактованныеАвтомобили.Период,
		|	Renault_ЗаконтрактованныеАвтомобили.VIN,
		|	Renault_ЗаконтрактованныеАвтомобили.Автомобиль,
		|	Renault_ЗаконтрактованныеАвтомобили.РабочийЛист,
		|	Renault_ЗаконтрактованныеАвтомобили.Регистратор
		|ИЗ
		|	РегистрСведений.Renault_ЗаконтрактованныеАвтомобили КАК Renault_ЗаконтрактованныеАвтомобили
		|ГДЕ
		|	Renault_ЗаконтрактованныеАвтомобили.Автомобиль = &Автомобиль
		|	И Renault_ЗаконтрактованныеАвтомобили.ДатаСнятияРезерва = ДАТАВРЕМЯ(1, 1, 1)";
		   
		Запрос.УстановитьПараметр("Автомобиль", ЗаявкаНаТрейдИн.Автомобиль);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДоговорРегистратор = Выборка.Регистратор;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДоговорРегистратор) Тогда
			НаборЗаписейРезервы = РегистрыСведений.Renault_ЗаконтрактованныеАвтомобили.СоздатьНаборЗаписей();
			НаборЗаписейРезервы.Отбор.Регистратор.Установить(ДоговорРегистратор);
			НаборЗаписейРезервы.Прочитать();
			Для Каждого Запись ИЗ НаборЗаписейРезервы Цикл
				Запись.ДатаСнятияРезерва = ТекущаяДата(); 
			КонецЦикла;
			НаборЗаписейРезервы.Записать();
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьВоронкуИСпискиТрейдИн();
	
КонецПроцедуры // ДоговорСКлиентомТрейдИн()

#КонецОбласти

#Область ОбработчкиКомандФормы

&НаКлиенте
Процедура СменитьСтраницу(Команда)
	
	ИмяПредыдущейКнопки = СтрЗаменить(Элементы.ГруппаСтраницыИнформации.ТекущаяСтраница.Имя, "ГруппаСтраница", "");
	Элементы[ИмяПредыдущейКнопки].ЦветФона 	= ЦветСерый;
	Элементы[ИмяПредыдущейКнопки].ЦветРамки = ЦветСерый;
	
	ИмяТекущейКнопки = ЭтаФорма.ТекущийЭлемент.Имя;
	Элементы[ИмяТекущейКнопки].ЦветФона 	= ЦветРено;
	Элементы[ИмяТекущейКнопки].ЦветРамки 	= ЦветРено;
	
	Элементы.ГруппаСтраницыИнформации.ТекущаяСтраница = Элементы["ГруппаСтраница" + ИмяТекущейКнопки];
	
КонецПроцедуры // СменитьСтраницу()

&НаКлиенте
Процедура ВыбратьЭлемент(Команда)
	
	ИмяЭлемента = СтрЗаменить(ТекущийЭлемент.Имя, "Выбрать", "");
	ПутьКДанным = ПолучитьПутьКДаннымЭлемента(ИмяЭлемента);
	ИмяФормыВыбора = ПолучитьИмяФормыВыбораЭлемента(ПутьКДанным);
	
	ФормаВыбора = ПолучитьФорму(ИмяФормыВыбора);
	ВыбранноеЗначение = ФормаВыбора.ОткрытьМодально();
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		Если Лев(ПутьКДанным, 7) = "Объект." Тогда
			Объект[СтрЗаменить(ПутьКДанным, "Объект.", "")] = ВыбранноеЗначение;
		Иначе
			ЭтаФорма[ПутьКДанным] = ВыбранноеЗначение;
		КонецЕсли;
		
		Если ПутьКДанным = "Клиент_ФИО" ИЛИ ПутьКДанным = "Клиент_Корпоративный" Тогда
			Объект.Клиент = ВыбранноеЗначение;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВыбратьЭлемент()

&НаКлиенте
Процедура ОткрытьЭлемент(Команда)
	
	ИмяЭлемента = СтрЗаменить(ТекущийЭлемент.Имя, "Открыть", "");
	ПутьКДанным = ПолучитьПутьКДаннымЭлемента(ИмяЭлемента);
	
	СсылкаНаОбъект = ПолучитьСсылкуНаОбъект(ПутьКДанным);
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		СсылкаНаОбъект.ПолучитьФорму().Открыть();
	КонецЕсли;
	
КонецПроцедуры // ОткрытьЭлемент()

&НаКлиенте
Процедура ОчиститьЭлемент(Команда)
	
	ИмяЭлемента = СтрЗаменить(ТекущийЭлемент.Имя, "Очистить", "");
	ПутьКДанным = ПолучитьПутьКДаннымЭлемента(ИмяЭлемента);
	
	Если Лев(ПутьКДанным, 7) = "Объект." Тогда
		Объект[СтрЗаменить(ПутьКДанным, "Объект.", "")] = Неопределено;
	Иначе
		ЭтаФорма[ПутьКДанным] = Неопределено;
	КонецЕсли;
	
КонецПроцедуры // ОчиститьЭлемент()

&НаКлиенте
Процедура ВвестиЧисловойЭлемент(Команда)
	
	ИмяЭлемента = СтрЗаменить(ТекущийЭлемент.Имя, "Ввести", "");
	ПутьКДанным = ПолучитьПутьКДаннымЭлемента(ИмяЭлемента);
	
	ВведенноеЧисло = 0;
	
	Если ВвестиЧисло(ВведенноеЧисло) Тогда
		
		Если Лев(ПутьКДанным, 7) = "Объект." Тогда
			Объект[СтрЗаменить(ПутьКДанным, "Объект.", "")] = ВведенноеЧисло;
		Иначе
			ЭтаФорма[ПутьКДанным] = ВведенноеЧисло;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВвестиЧисловойЭлемент()

&НаКлиенте
Процедура ВвестиЭлементДата(Команда)
	
	ИмяЭлемента = СтрЗаменить(ТекущийЭлемент.Имя, "Ввести", "");
	ПутьКДанным = ПолучитьПутьКДаннымЭлемента(ИмяЭлемента);
	
	ВведеннаяДата = 0;
	
	Если ВвестиДату(ВведеннаяДата) Тогда
		
		Если Лев(ПутьКДанным, 7) = "Объект." Тогда
			Объект[СтрЗаменить(ПутьКДанным, "Объект.", "")] = ВведеннаяДата;
		Иначе
			ЭтаФорма[ПутьКДанным] = ВведеннаяДата;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВвестиЭлементДата()

&НаКлиенте
Процедура ВыбратьЭлементИзСписка(Команда)
	
	ИмяЭлемента = СтрЗаменить(ТекущийЭлемент.Имя, "Выбрать", "");
	ПутьКДанным = ПолучитьПутьКДаннымЭлемента(ИмяЭлемента);
	ВыбранноеЗначение = ЭтаФорма.ВыбратьИзСписка(Элементы[ИмяЭлемента].СписокВыбора, Элементы[ИмяЭлемента]);
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		Если Лев(ПутьКДанным, 7) = "Объект." Тогда
			Объект[СтрЗаменить(ПутьКДанным, "Объект.", "")] = ВыбранноеЗначение.Значение;
		Иначе
			ЭтаФорма[ПутьКДанным] = ВыбранноеЗначение.Значение;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ВыбратьЭлементИзСписка()

&НаКлиенте
Процедура СоздатьЗаявкуТрейдИн(Команда)
	
	Если ПроверитьСозданныеЗаявкиТрейдИн() Тогда
		ВопросПользователю = Вопрос("Для рабочего листа уже существует заявка на трейд-ин, создать новую заявку?", РежимДиалогаВопрос.ДаНет);
		
		Если ВопросПользователю = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	СписокСотрудниковТрейдИн = ПолучитьСотрудниковОтделаТрейдИн();
	
	Если СписокСотрудниковТрейдИн.НайтиПоЗначению(Объект.Сотрудник) = Неопределено Тогда
	
		ФормаСписка = Обработки.Renault_ARM_Администратор.ПолучитьФорму("ФормаВыбораИзСпискаПлиткой");
		ФормаСписка.Список = СписокСотрудниковТрейдИн;
		ФормаСписка.Заголовок = "Выбор менеджера или отдела";
		
		ФормаСписка.ЭтоВыборСотрудника = Истина;
		ФормаСписка.КнопокВСтроке = 2;
		ФормаСписка.ВысотаКнопки = 40;
		Ответ = ФормаСписка.ОткрытьМодально();
		Если ЗначениеЗаполнено(Ответ) Тогда
			МенеджерТрейдИн = Ответ;
		Иначе
			Предупреждение("Для создания заявки необходимо выбрать менеджера трейд-ин или отдел.");
			Возврат;
		КонецЕсли;
	
	Иначе
		
		МенеджерТрейдИн = Объект.Сотрудник;
	
	КонецЕсли;
	
	СоздатьЗаявкуТрейдИнНаСервере(МенеджерТрейдИн);
	
КонецПроцедуры // СоздатьЗаявкуТрейдИн()

&НаКлиенте
Процедура РозничныйКлиент(Команда)
	
	Если Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
		Renault_CRM.Воронка_РегистрацияВMyRenault_Снять(Объект.IDK);
		Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.РегистрацияВMYRenault, Объект.IDK);
		
		Renault_CRM.Воронка_РегистрацияВБазеРеноРоссия_Снять(Объект.IDK);
	КонецЕсли;
	
	Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.РозничныйКлиент; 
	
	ОбновитьКнопкиТипКлиента();
	
	ИзменитьФормуСобственностиКлиента(Перечисления.ФормыСобственности.ЧастноеЛицо);
	ОбновитьЗаголовок_КнопкаКредит("Кредит");
	
КонецПроцедуры // РозничныйКлиент()

&НаКлиенте
Процедура КорпоративныйКлиент(Команда)
	
	Если Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.РозничныйКлиент Тогда
		Renault_CRM.Воронка_РегистрацияВMyRenault_Снять(Объект.IDK);
		Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.РегистрацияВMYRenault, Объект.IDK);
	КонецЕсли;
	
	Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент;
	
	ОбновитьКнопкиТипКлиента();
	
	ИзменитьФормуСобственностиКлиента(Перечисления.ФормыСобственности.ЮридическоеЛицо);
	ОбновитьЗаголовок_КнопкаКредит("Лизинг");
	
	Воронка_ОбновитьMYRenault();
	
КонецПроцедуры // КорпоративныйКлиент()

&НаКлиенте
Процедура ТипТрейдИнТрейдИн(Команда)
	
	ТипОперацииТрейдИн = Перечисления.Renault_ТипыОперацийТрейдИн.TradeIn;
	ОбновитьКнопкиТипТрейдИн();
	УстановитьТипОперацииВЗаявкеНаТрейдИн(ТипОперацииТрейдИн);
	
