&НаКлиенте
Процедура СинхронизироватьCПланшетом(Команда)
	
	Возврат;
	
	// Отправка
	
	Трафик = РегистрыСведений.Renault_Трафик.СоздатьНаборЗаписей();
	Трафик.Отбор.Идентификатор.Установить(Объект.IDТрафика);
	Трафик.Прочитать();
	ДатаОбращения = Неопределено;
	Если Трафик.Количество() <> 0 Тогда
		ДатаОбращения = Трафик[0].Период;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		КлиентскиеДанные = Новый Структура;
		КлиентскиеДанные.Вставить("Идентификатор", Строка(Объект.Клиент.УникальныйИдентификатор()));
		КлиентскиеДанные.Вставить("Имя", Объект.Клиент.Имя);
		КлиентскиеДанные.Вставить("Фамилия", Объект.Клиент.Фамилия);
		КлиентскиеДанные.Вставить("Отчество", Объект.Клиент.Отчество);
		КлиентскиеДанные.Вставить("Телефон", Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.Клиент));
		КлиентскиеДанные.Вставить("Email", Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Объект.Клиент));
		КлиентскиеДанные.Вставить("ДатаРождения", Объект.Клиент.ДатаРождения);
		Renault_РаботаСSalesTablet.ОбновитьДанныеПоТрафику(Объект.ДилерскийЦентр, КлиентскиеДанные, ДатаОбращения);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_ЗаписиНаТестДрайв.Регистратор
	|ИЗ
	|	РегистрСведений.CRM_ЗаписиНаТестДрайв КАК CRM_ЗаписиНаТестДрайв
	|ГДЕ
	|	CRM_ЗаписиНаТестДрайв.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	ВыборкаТД = Запрос.Выполнить().Выбрать();
	Пока ВыборкаТД.Следующий() Цикл
		ТД = ВыборкаТД.Регистратор;
		Renault_РаботаСSalesTablet.ОбновитьДанныеТестДрайв(ТД);
	КонецЦИкла;
	
	// Получение
	СинхронизироватьПланшетТД();
	СинхронизироватьПланшетКП();
		
	ОбновитьСписокКП();
	ОбновитьСписокТестДрайвов();
	
КонецПроцедуры // СинхронизироватьCПланшетом()

