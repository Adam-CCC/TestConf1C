		ОбновитьВоронкуИСпискиТрейдИн();
	КонецЕсли;
	
КонецПроцедуры // РегистрацияПредложениеВыкупа()

// Регистрация события предварительной оценки
//
&НаСервере
Процедура РегистрацияПредварительнаяОценка(Параметр)
	
	Если Параметр.ЭтоВыбор Тогда
		ОриентировочнаяЦена = Параметр.ДокументОценки.ОриентировочнаяЦена;
		ДатаОценки = Параметр.ДокументОценки.ДатаОценки;
		
		Если ЗначениеЗаполнено(ДатаОценки) И ЗначениеЗаполнено(ОриентировочнаяЦена) Тогда			
			ЗаявкаНаТрейдИнОбъект = ЗаявкаНаТрейдИн.ПолучитьОбъект();
			ЗаявкаНаТрейдИнОбъект.ОриентировочнаяЦена = ОриентировочнаяЦена;
			ЗаявкаНаТрейдИнОбъект.ДатаОценки = ДатаОценки;
			ЗаявкаНаТрейдИнОбъект.Записать();
		КонецЕсли;
	КонецЕсли;	
	
	ОриентировочнаяЦена = Параметр.ОриентировочнаяЦена;
	ДатаОценки = Параметр.ДатаОценки;			

	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн.ОриентировочнаяЦена) И ЗначениеЗаполнено(ЗаявкаНаТрейдИн.ДатаОценки) Тогда
		Если ЗаявкаНаТрейдИн.ОриентировочнаяЦена <> ОриентировочнаяЦена ИЛИ ЗаявкаНаТрейдИн.ДатаОценки <> ДатаОценки Тогда
			ЭтапЗаявкаНаТрейдИнПредварительнаяОценка = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнПредварительнаяОценка;
			
			Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
			Запись.IDK = Объект.IDK;	
			Запись.ЭтапПродаж = ЭтапЗаявкаНаТрейдИнПредварительнаяОценка;
			Запись.Прочитать();

			Если Не Запись.Выбран() Тогда						
				Запись.IDK = Объект.IDK;
				Запись.Объект = ЗаявкаНаТрейдИн;
				Запись.ЭтапПродаж = ЭтапЗаявкаНаТрейдИнПредварительнаяОценка; 
				Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
				Запись.ДатаВыполнения = ТекущаяДата();
				Запись.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ОбновитьВоронкуИСпискиТрейдИн();
	
КонецПроцедуры // РегистрацияПредварительнаяОценка()

// Проверка на дубли
//
// Параметры:
//  Тип	 - Строка	 - Где искать дубли
//
&НаКлиенте
Процедура ПровестиДедубликацию(Тип)
	
	НайденныеКлиенты = Новый Массив;
	Существует = Ложь;
	Если Тип = "ФИО" Тогда
		Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ОтключитьДедубликациюКлиентовПоФИО Тогда
			Возврат;
		КонецЕсли;
		Существует = CRM_Редубликация.ФИОСуществует(Клиент_ФИО, НайденныеКлиенты, Объект.Клиент);
	ИначеЕсли Тип = "EMail" Тогда
		Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ОтключитьДедубликациюКлиентовПоКонтактам Тогда
			Возврат;
		КонецЕсли;
		Существует = CRM_Редубликация.EMailСуществует(Объект.Email, НайденныеКлиенты, Объект.Клиент);
	ИначеЕсли Тип = "Телефон" Тогда
		Если Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ОтключитьДедубликациюКлиентовПоКонтактам Тогда
			Возврат;
		КонецЕсли;
		ЦифрыПоиска = СтрЗаменить(СтрЗаменить(Объект.Телефон, "(", ""), ")", "");
		ЦифрыПоиска = СтрЗаменить(СтрЗаменить(ЦифрыПоиска, " ", ""), "-", "");
		ЦифрыПоиска = Прав(ЦифрыПоиска, 10);
		Существует = CRM_Редубликация.НомерСуществует(ЦифрыПоиска, НайденныеКлиенты, Объект.Клиент);
	КонецЕсли;
	
	Если Не Существует Тогда
		Возврат;
	КонецЕсли;
	
	Струк = Новый Структура();
	Струк.Вставить("Ссылка", Объект.Клиент);
	Струк.Вставить("Телефон", Объект.Телефон);
	Струк.Вставить("EMail", Объект.EMail);
	Струк.Вставить("ДатаСоздания", CRM_Редубликация.ДатаСозданияКлиента(Объект.Клиент));
	
	Результат = CRM_Редубликация.ВопросЗаменятьКлиента(Струк, НайденныеКлиенты);
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		Объект.Клиент = Струк.Ссылка;
		
		НаборКонтактнойИнформации = Неопределено;
		ФормаРегистрацииТелефона = Обработки.Renault_РедактированиеКонтактнойИнформации.ПолучитьФорму("ФормаЗаписиТелефона");
		Если ФормаРегистрацииТелефона.Открыта() Тогда
			ФормаРегистрацииТелефона.Закрыть();
		КонецЕсли;
				
		Если Справочники.Renault_ПрофилиКлиентов.Используются() Тогда
			Профиль = Справочники.Renault_ПрофилиКлиентов.СохранитьКлиентаВПрофиль(Объект.Клиент);
			Справочники.Renault_ПрофилиКлиентов.ДобавитьКлиента(Профиль, Струк.Ссылка);
		КонецЕсли;
		Клиент = Струк.Ссылка;
		Клиент_ФИО = Клиент.Наименование;
		Объект.EMail = Струк.EMail;
		Объект.Телефон = Струк.Телефон;
		Клиент_Телефон = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Объект.Телефон, Объект.ДилерскийЦентр);
		Если ОбрезатьТелефон Тогда
			Клиент_Телефон = Прав(Клиент_Телефон, 10);
		КонецЕсли;
		СохранитьРабочийЛист();
	КонецЕсли;
	
КонецПроцедуры // ПровестиДедубликацию()

// Обновляет оформление элементов формы
//
// Параметры:
//  ЭтоТрейдИн	 - Булево	 - Признак того, что рабочий лист по трейд-ин
//
&НаКлиенте
Процедура СохранитьДанныеКлиентаПриСменеТелефона(ЭтоТрейдИн = Ложь)
	
	//////// Запишем контактные данные клиента
	Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойТелефонКлиента(Клиент_Телефон, Объект.Клиент);
	
	ТекТелефон = СкорректироватьТелефонПриЗаписиНаСервере();
	
	Клиент_Телефон  = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Объект.Телефон, Объект.ДилерскийЦентр);
	Если ОбрезатьТелефон Тогда
		Клиент_Телефон = Прав(Клиент_Телефон, 10);
	КонецЕсли;
		
	Если ЭтоТрейдИн Тогда
		ОбновитьВоронкуИСпискиТрейдИн();
	Иначе 		
		ОбновитьВоронкуИСписки();
		Оповестить("ОбновитьРабСтолМенеджера");
	КонецЕсли;
	Модифицированность = Истина;
	
КонецПроцедуры // СохранитьДанныеКлиентаПриСменеТелефона()

// Корректирует номер телефона
// 
// Возвращаемое значение:
//  Строка - Скорректированный номер телефона
//
&НаСервере
Функция СкорректироватьТелефонПриЗаписиНаСервере()
	
	Возврат CRM_Сервер.Renault_CRM_СкорректироватьТелефонПриЗаписи(Объект.Телефон);
	
КонецФункции // СохранитьДанныеКлиентаПриСменеТелефонаНаСервере()

// Возвращает путь к данным элемента формы по имени элемента
//
// Параметры:
//  ИмяЭлемента	 - Строка	 - Имя элемента формы
// 
// Возвращаемое значение:
//  Строка - Путь к данным элемента
//
&НаСервере
Функция ПолучитьПутьКДаннымЭлемента(ИмяЭлемента)
	
	Возврат Элементы[ИмяЭлемента].ПутьКДанным;
	
КонецФункции // ПолучитьПутьКДаннымЭлемента()

// Возвращает имя формы выбора элемента
//
// Параметры:
//  ПутьКДанным	 - Ссылка	 - Путь к данным элемента
// 
// Возвращаемое значение:
//  Строка - Имя формы выбора элемента
//
&НаСервере
Функция ПолучитьИмяФормыВыбораЭлемента(ПутьКДанным)
	
	Если ПутьКДанным = "Клиент_ФИО" ИЛИ ПутьКДанным = "Клиент_Корпоративный" Тогда
		СсылкаНаДанные = Справочники.Контрагенты.ПустаяСсылка();		
	Иначе
		СсылкаНаДанные = Вычислить(ПутьКДанным);
	КонецЕсли;
	
	ТипЗначенияЭлемента = ТипЗнч(СсылкаНаДанные);
	
	ИмяФормыВыбора = "";
	ИмяОбъекта = СсылкаНаДанные.Метаданные().Имя;
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначенияЭлемента) Тогда
		ИмяФормыВыбора = "Справочник." + ИмяОбъекта + ".ФормаВыбора";	
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗначенияЭлемента) Тогда
		ИмяФормыВыбора = "Документ." + ИмяОбъекта + ".ФормаВыбора";
	КонецЕсли;
	
	Возврат ИмяФормыВыбора;
	
КонецФункции // ПолучитьИмяФормыВыбораЭлемента()

// Возвращает ссылку на данные по пути к данным
//
// Параметры:
//  ПутьКДанным	 - Ссылка	 - Путь к данным элемента
// 
// Возвращаемое значение:
//  Ссылка - Ссылка на данные элемента формы
//
&НаСервере
Функция ПолучитьСсылкуНаОбъект(ПутьКДанным)
	
	Если ПутьКДанным = "Клиент_ФИО" ИЛИ ПутьКДанным = "Клиент_Корпоративный" Тогда
		СсылкаНаДанные = Объект.Клиент;		
	Иначе
		СсылкаНаДанные = Вычислить(ПутьКДанным);
	КонецЕсли;
	
	Возврат СсылкаНаДанные;
	
КонецФункции // ПолучитьСсылкуНаОбъект()

// Записывает форму собственности для клиента рабочего листа
//
// Параметры:
//  ФормаСобственности	 - ПеречислениеСсылка.ФормыСобственности	-	Устанавливаемая форма собственности
//
&НаСервере
Процедура ИзменитьФормуСобственностиКлиента(ФормаСобственности)

	Если Объект.Клиент <> Неопределено Тогда
	    Если Объект.Клиент.ФормаСобственности <> ФормаСобственности Тогда

	        УстановитьПривилегированныйРежим(Истина);
	        КлиентОбъект = Объект.Клиент.ПолучитьОбъект();
	        КлиентОбъект.ФормаСобственности = ФормаСобственности;
	        Если ФормаСобственности=Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
	            Если НЕ ЗначениеЗаполнено(КлиентОбъект.Фамилия) И НЕ ЗначениеЗаполнено(КлиентОбъект.Имя) И НЕ ЗначениеЗаполнено(КлиентОбъект.Отчество) Тогда
	                КлиентОбъект.Фамилия = "Фамилия";
	                КлиентОбъект.Имя = "Имя";
	                КлиентОбъект.Отчество = "Отчество";
	            КонецЕсли;
	        КонецЕсли;
	        КлиентОбъект.ОбменДанными.Загрузка = Истина; // Защита от незаполненных реквизитов
	        КлиентОбъект.Записать();
	        УстановитьПривилегированныйРежим(Ложь);

		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ИзменитьФормуСобственностиКлиента()

