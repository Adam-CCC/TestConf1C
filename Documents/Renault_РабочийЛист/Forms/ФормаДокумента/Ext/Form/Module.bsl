&НаКлиенте
Процедура ПосещениеАвтосалона(Команда)
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ПосещениеАвтосалона;
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		//Отменим эту встречу или возврат
		ФормаПодтверждения = Объект.Ссылка.ПолучитьФорму("ФормаПодтверждения");
		ФормаПодтверждения.Заголовок = "Отменить выполнение этапа 'Посещение автосалона'?";
		Ответ = ФормаПодтверждения.ОткрытьМодально();
		Если ЗначениеЗаполнено(Ответ) Тогда
			Renault_CRM.Воронка_ПосещениеАвтосалона__Снять(Объект.IDK);
		КонецЕсли;
	Иначе
		//Проверим наличие напоминания
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRM_СобытияПоРабочимЛистам.Ссылка
		|ИЗ
		|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|ГДЕ
		|	CRM_СобытияПоРабочимЛистам.IDK = &IDK
		|	И CRM_СобытияПоРабочимЛистам.ВидСобытия = &ВидСобытия
		|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
		Запрос.УстановитьПараметр("IDK", Объект.IDK);
		Запрос.УстановитьПараметр("ВидСобытия", Справочники.CRM_ВидыСобытий.Встреча);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			//Откроем форму завершения события
			Событие = Выборка.Ссылка;
			Событие.ПолучитьФорму("ФормаЗавершенияСобытия").Открыть();
		Иначе
			//Создадим событие или выполним этап
			ФормаВыбораДействия = Объект.Ссылка.ПолучитьФорму("ФормаВыбораДействия");
			Ответ = ФормаВыбораДействия.ОткрытьМодально();
			Если ЗначениеЗаполнено(Ответ) Тогда
				Если Ответ = "Выполнить" Тогда
					Renault_CRM.Воронка_ПосещениеАвтосалона_Установить(Объект.IDK);
					Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.ПосещениеАвтосалона, Объект.IDK);
				ИначеЕсли Ответ = "Напоминание" Тогда
					СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
					СобытиеОбъект.IDK = Объект.IDK;
					СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.Встреча;
					СобытиеОбъект.Сотрудник = Объект.Сотрудник;
					СобытиеОбъект.Отдел = Объект.Отдел;
					СобытиеОбъект.ДилерскийЦентр = Объект.ДилерскийЦентр;
					СобытиеОбъект.Подразделение = Объект.Подразделение;
					ФормаСобытия = СобытиеОбъект.ПолучитьФорму("ФормаСозданияСобытия");
					ФормаСобытия.Открыть();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущийЭлемент.Имя = "ПосещениеАвтосалонаТрейдИн" Тогда
		Воронка_ОбновитьПосещениеАвтосалона(Истина);
	Иначе
		Воронка_ОбновитьПосещениеАвтосалона();
	КонецЕсли;
	
КонецПроцедуры // ПосещениеАвтосалона()

