	Запись.Прочитать();
	
	Если Запись.Выбран() И ЗначениеЗаполнено(Запись.Объект) Тогда
		//КПОбъект = Запись.Объект.ПолучитьОбъект();
		Возврат Запись.Объект.Состав.ВыгрузитьКолонку("Конфигурация");
	КонецЕсли;
	
КонецФункции // ПолучитьКонфигурацииАвтомобилейРабочегоЛиста()

