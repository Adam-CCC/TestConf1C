
&НаКлиенте
Перем Права;

&НаКлиенте
Перем НаборКонтактнойИнформации;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполнение реквизитов формы с цветами и картинками
	РР  = БиблиотекаКартинок.Renault_Logo_Min;
	РВК = БиблиотекаКартинок.STM_comment;
	РС  = БиблиотекаКартинок.Renault_Calendar_New;
	РКО = БиблиотекаКартинок.STM_comment;

	Права = обПолучитьПраваИНастройкиПользователя(ПараметрыСеанса.Пользователь);
	ПраваРено = ПараметрыСеанса.Renault_ПраваПользователя;
	
	ТекМенеджер = ПараметрыСеанса.Пользователь.Сотрудник;

	СтруктураЦветов = Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления();
	
	ЦветРено = Вычислить(СтруктураЦветов.ОсновнойЦвет);

	ЦветБелый 			= Новый Цвет(255, 255, 255);
	ЦветСерый 			= Новый Цвет(156, 166, 178);
	
	ЦветRenault1 		= Вычислить(СтруктураЦветов.ДопЦвет1);
	ЦветRenault2 		= Вычислить(СтруктураЦветов.ДопЦвет3);
	ЦветRenault3 		= Вычислить(СтруктураЦветов.ДопЦвет4);

	ЦветКнопкиВоронкиСерый = Новый Цвет(212, 212, 212);

	ИзображениеСобытиеВыполнено 		= БиблиотекаКартинок.Renault_Confirm_Square;
	ИзображениеСобытиеЗапланировано 	= БиблиотекаКартинок.Renault_Confirm_New;
	ИзображениеПустое 					= БиблиотекаКартинок.CRM_ПустоеИзображение32;
	
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("РабочийЛист", Объект.IDK);
	Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
	МенеджерТрейдИн = Справочники.Сотрудники.ПустаяСсылка();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.МенеджерТрейдИн) Тогда
		МенеджерТрейдИн = Выборка.МенеджерТрейдИн;
	КонецЕсли;
	
	ТекСотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
	
	Если Объект.Сотрудник <> ТекСотрудник Или (МенеджерТрейдИн <> ТекСотрудник и ЗначениеЗаполнено(МенеджерТрейдИн)) Тогда
		Если ПраваРено.Свойство("ПравоРедактированияЧужихРЛ") Тогда
			Если Не ПраваРено.ПравоРедактированияЧужихРЛ Тогда
				ЗаблокироватьРЛ();
			КонецЕсли;
		Иначе
			ЗаблокироватьРЛ();
		КонецЕсли;
	КонецЕсли;
	
	СлужНастройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	Если Не СлужНастройки.ПоказыватьПрототипы Тогда 
		Элементы.ОткрытьSara.Видимость = Ложь;
	КонецЕсли;
		
	Если ПараметрыСеанса.DMS_Бренд <> Справочники.CRM_МаркаАвтомобиля.RENAULT Тогда
		Элементы.MyRenault.Видимость 		= Ложь;
		Элементы.ОткрытьMyRenault.Видимость = Ложь;
		Элементы.ОтменитьВыдачу.Видимость 	= Ложь;
		Элементы.ИзменитьВыдачу.Видимость 	= Ложь;
	КонецЕсли;
	
	Элементы.РОП.Видимость = ПраваРено.РазрешитьРаботуСАрмРОП;
	Если ПараметрыСеанса.DMS_Бренд <> Справочники.CRM_МаркаАвтомобиля.RENAULT Тогда
		Элементы.КарточкаКлиента.Видимость = Ложь;
	КонецЕсли;
	
	ДЦ = ?(ЗначениеЗаполнено(Объект.ДилерскийЦентр), Объект.ДилерскийЦентр, Renault_CRM.ПолучитьДилерскийЦентрПользователя());
	Если СтрДлина(ДЦ.ПервыйСимволТелефона) Тогда
		ПервыйСимволТел = ДЦ.ПервыйСимволТелефона;
		Если Лев(ПервыйСимволТел, 1) = "+" Тогда
			ПервыйСимволТел = " " + ПервыйСимволТел;
		КонецЕсли;
		Элементы.Клиент_Телефон.Маска = ПервыйСимволТел + "(999)999-99-99";
		Элементы.КлиентКорпоративный_Телефон.Маска = ПервыйСимволТел + "(999)999-99-99";
		ОбрезатьТелефон = Истина;
	Иначе
		Элементы.Клиент_Телефон.Маска = "9(999)999-99-99";
		Элементы.КлиентКорпоративный_Телефон.Маска = "9(999)999-99-99";
		ОбрезатьТелефон = Ложь;
	КонецЕсли;
	
	Элементы.ОтправитьСМС.Видимость = ДЦ.ОтображатьКнопкиРассылкиСМС;
	Элементы.Позвонить.Видимость 	= ДЦ.ОтображатьКнопкиИнтеграцииСТелефонией;
	Элементы.ОтправитьЕмейл.Видимость = ДЦ.ОтображатьКнопкиРассылкиЕмейл;
	
КонецПроцедуры // ПриСозданииНаСервере()

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Заполнение полей формы
	ОбновитьЗаголовок();
	НовыйАвтомобиль = ? (Объект.ПродажаБУ, 1, 0);
	
	ЭтаФорма.Модифицированность = Ложь;
	
	ОпределитьНеобходимостьФункционалаТрейдИн(ПраваРено);	
	
	ОбновитьКомментарий();
	ОбновитьКомментарийРезолюция();
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		Если ЗначениеЗаполнено(Объект.Клиент.Контрагент) Тогда
			Клиент = Объект.Клиент.Контрагент;
			ЗаписатьРабочийЛист();
		КонецЕсли;
	КонецЕсли;
	
	ПрочитатьДанныеКлиентаСервер();
	
	ОбновитьВоронкуИСписки();
	
	ОбновитьЦветКнопкиВажность();
	ОбновитьОтображениеКнопокЗакрытия();
	ОбновитьЦветКнопокРОП();
	ОбновитьЦветКнопкиКарточкаКлиента();
	
	ОбновитьДоступностьПолей();
	
	ОбновитьСтатусКорпКлиента();
	ЗаполнитьСписокКомментариев();
	ОбновитьКнопкиТипКлиента();	
	
	//ПодключитьОбработчикОжидания("СообщенияПользователюПоКорпКлиенту", 3, Ложь);
	
	Если ЗначениеЗаполнено(Объект.СвязаныйIDK) Тогда
		Элементы.НадписьСоздатьРабочийЛистТрейдИн.Заголовок 	= "Открыть связаный рабочий лист";
		Элементы.НадписьСоздатьРабочийЛистПродажа.Заголовок 	= "Открыть связаный рабочий лист";
		Элементы.НадписьПривязатьРабочийЛистПродажа.Заголовок 	= "Отвязать текущий и привязать другой рабочий лист";
		Элементы.ПривязатьСоздатьРабочийЛистТрейдИн.Заголовок 	= "Отвязать текущий и привязать другой рабочий лист";
	КонецЕсли;
	
	Если Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
		
		Элементы.НадписьВыдачи.Видимость 				= Ложь;
		Элементы.СоздатьВыдачу.Видимость 				= Ложь;
		Элементы.НадписьВыдачиПредупреждение.Видимость 	= Ложь;
		Элементы.Выдачи.Видимость 						= Ложь;
		Элементы.ДоговорыСКлиентом.Видимость 			= Ложь;
		Элементы.КоммерческиеПредложения.Видимость 		= Ложь;
		Элементы.ТестДрайв.Видимость 					= Ложь;
		
		Элементы.УспешнаяПродажа.Заголовок = "Успешный выкуп";
		Элементы.ТипПродажиВыкупа.Заголовок = "Тип выкупа";
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " (рабочий лист трейд-ин)."+ ?(ЗначениеЗаполнено(ЗаявкаНаТрейдИн.МенеджерЗаявитель)," Менеджер заявитель: "+ЗаявкаНаТрейдИн.МенеджерЗаявитель, "");
		ЗаполнитьСписокВыбораЭлемента("ПроизводительТрейдИн");	

	Иначе
		
		ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " (рабочий лист продажа)";
		
	КонецЕсли;
	
	ОбновитьПоляДляСтатистики();
	
	Элементы.СинхронизироватьCПланшетом.Видимость = Объект.ДилерскийЦентр.СинхронизированСПланшетомПродавца;
	
	УправлениеКнопкамиОФУ();
	
	Элементы.ГруппаСтраницыКлиента.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	Если ЭтоПетровский() Тогда
		УправлениеПанельюСтатистики();
	КонецЕсли;
	
	СогласиеНаОПД();
	ОбновитьДатуICM();
	
КонецПроцедуры // ПриОткрытии()

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ЗаголовокФормы =  "Рабочий лист №" + Строка(Объект.IDK);
	ЗаголовокФормы = СтрЗаменить(ЗаголовокФормы, " ", "");
	ЗаголовокФормы = СтрЗаменить(ЗаголовокФормы, Символы.НПП, "");
	ЗаголовокФормы = НРег(ЗаголовокФормы);
	ПолноеИмя = "регистрсведений.Renault_РабочиеЛисты.формазаписи." + ЗаголовокФормы;
	
	Если ИмяСобытия = "ОбновитьРабочийЛист" Тогда
		ОбновитьВоронкуИСписки();
		ПрочитатьДанныеКлиентаСервер();
	ИначеЕсли ИмяСобытия =("Активизировать."+ПолноеИмя) Тогда
		Активизировать();
	ИначеЕсли ИмяСобытия = "ОбновитьВоронку" Тогда
		ОбновитьВоронкуИСписки();
	ИначеЕсли ИмяСобытия = "ОбновитьСобытия" Тогда
		ОбновитьСписокСобытий();
	ИначеЕсли ИмяСобытия = "ПеречитатьДанныеКлиента" Тогда
		ПрочитатьДанныеКлиентаСервер();
	ИначеЕсли ИмяСобытия = "ОбновитьВоронкуТелефон" Тогда
		Воронка_ОбновитьВзятТелефон();
	ИначеЕсли ИмяСобытия = "ОбновитьВоронкуЕмаил" Тогда
		Воронка_ОбновитьВзятEmail();
	ИначеЕсли ИмяСобытия = "ОбновитьРабочийЛистПослеЗаписиДоговора" Тогда
		ОбновитьОтображениеДанных();
		ОбновитьВоронкуИСписки();
		ПрочитатьДанныеКлиентаСервер();
	ИначеЕсли ИмяСобытия = "ОбновитьРабочийЛистПослеЗаписиКонтрагента" Тогда
		
		Прочитать();
		Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
			Если ЗначениеЗаполнено(Объект.Клиент.Контрагент) Тогда
				Клиент = Объект.Клиент.Контрагент;
			КонецЕсли;
		КонецЕсли;
		
		СохранитьРабочийЛист();
		ОбновитьОтображениеДанных();
		ОбновитьВоронкуИСписки();
		ОбновитьСтатусКорпКлиента();
		ПрочитатьДанныеКлиентаСервер();
		
	ИначеЕсли ИмяСобытия = "ОбновитьОсновногоКлиентаРабочегоЛиста" Тогда
		Клиент = Параметр;
		ПрочитатьДанныеКлиентаСервер();
	ИначеЕсли ИмяСобытия = "СозданаЗаявкаНаРезерв" Тогда
		ОбновитьСписокРезервов();
	ИначеЕсли ИмяСобытия = "ОткрытьДоступКПолюРабочегоЛистаКлиент_ФИО1" Тогда
		Элементы.Клиент_ФИОКОРП.Доступность = Истина;
		ФормаКорпКлиента = Неопределено;
	ИначеЕсли ИмяСобытия = "ПередачаДанныхНаАвтосервис2СФормыОбращения" Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
			Форма = ЗаявкаНаТрейдИн.ПолучитьФорму("ФормаДокументаУпр");
			Если Форма.Открыта() Тогда
				Форма.Закрыть();
			КонецЕсли;
			
			СоздатьОбращениеПродолжение(Параметр, Источник);			
		КонецЕсли;		
	ИначеЕсли ИмяСобытия = "РабочийЛистВизуальныйОсмотр" Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) И Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда			
			РегистрацияВизуальногоОсмотра();			
		КонецЕсли;		
	ИначеЕсли ИмяСобытия = "РабочийЛистЗаполнениеДанныхАвтомобиля" Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) И Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn  Тогда			
			РегистрацияЗаполненияДанныхАвтомобиля();			
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "РабочийЛистПредложениеВыкупа" Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) И Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn  Тогда			
			РегистрацияПредложениеВыкупа(Параметр);			
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "РабочийЛистПредворительнаяОценка" Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) И Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn  Тогда			
			РегистрацияПредварительнаяОценка(Параметр);			
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "Запись_КорпоративныеКлиенты" Тогда
		ПрочитатьДанныеКлиентаСервер();
	ИначеЕсли ИмяСобытия= "ОбновитьФормуЗаписи" Тогда 
		ПрочитатьДанныеКлиентаСервер(Параметр);
		ЭтаФорма.ОбновитьОтображениеДанных(); 
	ИначеЕсли ИмяСобытия = "ЗаписанаКИ" Тогда
		Если НаборКонтактнойИнформации <> Неопределено И ЗначениеЗаполнено(Объект.Клиент) Тогда	
			Если НаборКонтактнойИнформации.Количество() > 0 Тогда
				НаборКонтактнойИнформации[0].Представление = СтрЗаменить(НаборКонтактнойИнформации[0].Представление, " ", ""); //DMSREN-439
				Объект.Телефон = НаборКонтактнойИнформации[0].Представление;
				Клиент_Телефон = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Объект.Телефон, Объект.ДилерскийЦентр);
				Если ОбрезатьТелефон Тогда
					Клиент_Телефон = Прав(Клиент_Телефон, 10);
				КонецЕсли;
				ПровестиДедубликацию("Телефон");	
				Если НаборКонтактнойИнформации.Количество()>0 Тогда
					НаборКонтактнойИнформации.Записать();
				КонецЕсли;
			КонецЕсли;
			Для Каждого Стр Из НаборКонтактнойИнформации Цикл
				Если Стр.ЗначениеПоУмолчанию Тогда
					ТекущийКлиентОбъект = Объект.Клиент.ПолучитьОбъект();
					ТекущийКлиентОбъект.ОсновнойТелефон = Стр.Представление;
					ТекущийКлиентОбъект.Записать();
					Клиент_ТелефонПриИзменении(Неопределено);
					СохранитьДанныеКлиентаПриСменеТелефона();
					ПрочитатьДанныеКлиентаСервер();	
					Воронка_ОбновитьВзятТелефон();
					Прервать;		
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
    ИначеЕсли ИмяСобытия = "ОбновитьСписокКП" Тогда  //Блинков обработка оповещения при измененииКП DMSREN-742
		ОбновитьСписокКП();
	КонецЕсли;
	
КонецПроцедуры // ОбработкаОповещения()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует заголовок формы и текст надписи "Заголовок" исходя из IDK, ДатаID и сотрудника рабочего листа
//
&НаКлиенте
Процедура ОбновитьЗаголовок()
	
	ЭтоТрейдИн = Объект.ТипРабочегоЛиста = ПредопределенноеЗначение("Перечисление.Renault_ТипыРабочихЛистов.TradeIn");
	
	Элементы.Заголовок.Заголовок = "Рабочий лист №" + Строка(Объект.IDK) + " от " + Формат(Объект.ДатаID, "ДФ=""дд ММММ гггг 'г.' ЧЧ:мм:сс""") + " - " + ?(ЗначениеЗаполнено(Объект.Сотрудник), Объект.Сотрудник, ?(ЭтоТрейдИн, Объект.Отдел, "Взять в работу"));	
	Элементы.Заголовок.Гиперссылка = НЕ ЗначениеЗаполнено(Объект.Сотрудник);	
	ЭтаФорма.Заголовок = "Рабочий лист №" + Строка(Объект.IDK);
	
КонецПроцедуры // ОбновитьЗаголовок()

// Заполняет табличный документ "ТаблоКоментарии" данными комментариев из РС "CRM_Комментарии" 
//	и истории переписки из РС "Renault_ИсторияПерепискиСКлиентом" 
//
&НаСервере
Процедура ОбновитьКомментарий()
	
	ТаблоКоментарии.Очистить();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	МакетКомментариев = РегистрыСведений.Renault_РабочиеЛисты.ПолучитьМакет("РазделКомментариевУзкий");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_Комментарии.Дата КАК ДатаКомментария,
	|	CRM_Комментарии.IDK КАК IDK,
	|	CRM_Комментарии.Идентификатор КАК Идентификатор,
	|	CRM_Комментарии.ИдентификаторРодителя КАК ИдентификаторРодителя,
	|	CRM_Комментарии.Автор КАК Автор,
	|	CRM_Комментарии.ТекстКомментария КАК Комментарий
	|ИЗ
	|	РегистрСведений.CRM_Комментарии КАК CRM_Комментарии
	|ГДЕ
	|	CRM_Комментарии.IDK = &IDK
	|
	|УПОРЯДОЧИТЬ ПО
	|	IDK,
	|	CRM_Комментарии.Дата,
	|	Идентификатор,
	|	ИдентификаторРодителя";
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	
	ТаблицаКомментариев = Запрос.Выполнить().Выгрузить();
	
	ДеревоКомментариев = Renault_CRM.ПолучитьДеревоКомментариев(ТаблицаКомментариев);
	ДеревоКомментариев.Строки.Сортировать("ДатаКомментария "+?(СортировкаКомментариевПоДате,"Убыв","Возр"),Ложь);  //Блинков DMSREN-786
	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	
	ОбластьШапка = МакетКомментариев.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Идентификатор = "ДобавитьКомментарий";
	ОбластьШапка.Параметры.СортировкаПоДате = "СортировкаКомментариевПоДате";  //Блинков DMSREN-786
	ОбластьШапка.Параметры.Убывание = ?(СортировкаКомментариевПоДате,"Убывание","Возрастание");  //Блинков DMSREN-786 изменение надписи
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Для Каждого КорневойКомментарий Из ДеревоКомментариев.Строки Цикл
		Renault_CRM.ВывестиКомментарийРекурсивно(ТабличныйДокумент, МакетКомментариев, КорневойКомментарий, 1);
	КонецЦикла;
	
	// Получим историю переписки с клиентом
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Renault_ИсторияПерепискиСКлиентом.Период КАК ДатаКомментария,
	|	Renault_РабочиеЛисты.IDK,
	|	Renault_ИсторияПерепискиСКлиентом.Идентификатор,
	|	"""" КАК ИдентификаторРодителя,
	|	Renault_ИсторияПерепискиСКлиентом.ПользовательДилера КАК Автор,
	|	Renault_ИсторияПерепискиСКлиентом.Сообщение КАК Комментарий,
	|	Renault_ИсторияПерепискиСКлиентом.Объект
	|ИЗ
	|	РегистрСведений.Renault_ИсторияПерепискиСКлиентом КАК Renault_ИсторияПерепискиСКлиентом
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|		ПО (Renault_РабочиеЛисты.IDТрафика = Renault_ИсторияПерепискиСКлиентом.Объект.ТрафикИД)
	|ГДЕ
	|	Renault_РабочиеЛисты.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	
	ТаблицаПереписки = Запрос.Выполнить().Выгрузить();
	ДеревоПереписки = Renault_CRM.ПолучитьДеревоКомментариев(ТаблицаПереписки);
	
	Для каждого КорневойКомментарий из ДеревоПереписки.Строки Цикл
		Renault_CRM.ВывестиКомментарийРекурсивно(ТабличныйДокумент, МакетКомментариев, КорневойКомментарий, 1);
	КонецЦикла;
	
	// Выведем текст запроса клиента
	ТаблицаЛИДов = ТаблицаПереписки.Скопировать();
	ТаблицаЛИДов.Свернуть("Объект");
	ТаблицаЛИДов.Колонки.Добавить("ДатаКомментария");
	ТаблицаЛИДов.Колонки.Добавить("IDK");
	ТаблицаЛИДов.Колонки.Добавить("Идентификатор");
	ТаблицаЛИДов.Колонки.Добавить("ИдентификаторРодителя");
	ТаблицаЛИДов.Колонки.Добавить("Автор");
	ТаблицаЛИДов.Колонки.Добавить("Комментарий");
	
	Для Каждого Строка Из ТаблицаЛИДов Цикл
		
		Строка.ДатаКомментария = Строка.Объект.Дата;
		Строка.IDK = Объект.IDK;
		Строка.Идентификатор = Строка.Объект.ТрафикИД;
		Строка.ИдентификаторРодителя = "";
		Строка.Автор = Строка.Объект.Менеджер;
		Строка.Комментарий = Строка.Объект.Сообщение;
		
	КонецЦикла;
	
	ДеревоЛИДов = Renault_CRM.ПолучитьДеревоКомментариев(ТаблицаЛИДов);
	
	Для каждого КорневойКомментарий из ДеревоЛИДов.Строки Цикл
		Renault_CRM.ВывестиКомментарийРекурсивно(ТабличныйДокумент, МакетКомментариев, КорневойКомментарий, 1);
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	ТабличныйДокумент.ОтображатьЗаголовки 	= Ложь;
	ТабличныйДокумент.ОтображатьСетку     	= Ложь;
	ТабличныйДокумент.ТолькоПросмотр      	= Истина;
	
	ТаблоКоментарии.Вывести(ТабличныйДокумент);
	
	ТаблоКоментарии.ОтображатьЗаголовки 	= Ложь;
	ТаблоКоментарии.ОтображатьГруппировки 	= Истина;
	
	ТаблоКоментарии.ОтображатьСетку    		= Ложь;
	ТаблоКоментарии.ТолькоПросмотр      	= Истина;
	ТаблоКоментарии.ОриентацияСтраницы  	= ОриентацияСтраницы.Портрет;
	ТаблоКоментарии.АвтоМасштаб         	= Истина;
	ТаблоКоментарии.ТекущаяОбласть 			= ТабличныйДокумент.Область(1, 1, 1, 1);
	
КонецПроцедуры // ОбновитьКомментарий()

// Заполняет резолюцию руководителя отдела продаж из РС "CRM_РезолюцииПоРабочимЛистам"
//
&НаСервере
Процедура ОбновитьКомментарийРезолюция()
	
	ТаблоРезолюций.Очистить();
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = РегистрыСведений.Renault_РабочиеЛисты.ПолучитьМакет("Резолюции");
	Макет.Параметры.Расшифровка = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_РезолюцииПоРабочимЛистам.ID,
	|	CRM_РезолюцииПоРабочимЛистам.IDK,
	|	CRM_РезолюцииПоРабочимЛистам.Дата КАК Дата,
	|	CRM_РезолюцииПоРабочимЛистам.Подразделение,
	|	CRM_РезолюцииПоРабочимЛистам.Комментарий,
	|	CRM_РезолюцииПоРабочимЛистам.Сотрудник
	|ИЗ
	|	РегистрСведений.CRM_РезолюцииПоРабочимЛистам КАК CRM_РезолюцииПоРабочимЛистам
	|ГДЕ
	|	CRM_РезолюцииПоРабочимЛистам.IDK = &IDK
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Комент = "[" + СокрЛП(Выборка.Сотрудник) + " " + Формат(Выборка.Дата, "ДФ=HH:mm") + ", " + Лев(СокрЛП(Выборка.Дата), 10) + "] " + СокрЛП(Выборка.Комментарий);
		ТабличныйДокумент.Вывести(ОбластьМакета);
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	
	ТабличныйДокумент.ОтображатьЗаголовки 		= Ложь;
	ТабличныйДокумент.ОтображатьСетку     		= Ложь;
	ТабличныйДокумент.ТолькоПросмотр      		= Истина;
	
	ТаблоРезолюций.Вывести(ТабличныйДокумент);
	
	ТаблоРезолюций.ОтображатьЗаголовки 			= Ложь;
	ТаблоРезолюций.ОтображатьСетку    			= Ложь;
	ТаблоРезолюций.ТолькоПросмотр      			= Истина;
	ТаблоРезолюций.ОриентацияСтраницы  			= ОриентацияСтраницы.Портрет;
	ТаблоРезолюций.АвтоМасштаб         			= Истина;
	ТаблоРезолюций.ТекущаяОбласть 				= ТаблоРезолюций.Область(1, 1, 1, 1);
	
КонецПроцедуры // ОбновитьКомментарийРезолюция()

// Процедура - Прочитать данные клиента сервер
//
// Параметры:
//  СтруктураПервичныйИнтерес	 - Структура	 - Структура, содержащая ссылку на певричный интерес по связанному IDK, с полями:
//		* IDK				-	Строка										-	Связанный IDK
//		* ПервичныйИнтерес	-	СправочникССылка.CRM_ПервичныйИнтерес		-	Первичный интерес клиента
//
&НаСервере
Процедура ПрочитатьДанныеКлиентаСервер(СтруктураПервичныйИнтерес = Неопределено)
	
	Клиент_ФИО = "";
	Клиент_Телефон = "";
	Клиент_Email = "";
	Клиент_Город = "";
	Клиент_ИсточникИнформации = Справочники.CRM_ИсточникиИнформации.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Телефон) Тогда
			Объект.Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.Клиент);
		КонецЕсли;
		
		Клиент_Телефон = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Объект.Телефон, Объект.ДилерскийЦентр);
		Если ОбрезатьТелефон Тогда
			Клиент_Телефон = Прав(Клиент_Телефон, 10);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.Email) Тогда 
			Объект.Email 	= Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Объект.Клиент);
		КонецЕсли;
		Клиент_Email = Объект.EMail;
		
		Клиент_ФИО = Объект.Клиент.НаименованиеПолное;
		Клиент_Корпоративный = Объект.Клиент.НаименованиеПолное;
			
		Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.Контрагенты") тогда
			СтатусКлиента = 1;
		Иначе
			СтатусКлиента = 0;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_КлиентскиеДанные.ИсточникИнформации,
		|	CRM_КлиентскиеДанные.Город
		|ИЗ
		|	РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанные
		|ГДЕ
		|	CRM_КлиентскиеДанные.Клиент = &Клиент";
		
		Запрос.УстановитьПараметр("Клиент", Объект.Клиент);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Клиент_Город 				= Выборка.Город;
			Клиент_ИсточникИнформации 	= Выборка.ИсточникИнформации;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Клиент_Город) Тогда 
			ПодставитьГородИзТрафика(Клиент_Город,Объект.Клиент);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураПервичныйИнтерес <> Неопределено Тогда
		Если СтруктураПервичныйИнтерес.IDK 	= Объект.СвязаныйIDK Тогда
			ПервичныйИнтересМодель 			= СтруктураПервичныйИнтерес.ПервичныйИнтерес;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры // ПрочитатьДанныеКлиентаСервер()

&НаСервереБезКонтекста
Процедура ПодставитьГородИзТрафика(Город,Клиент)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_Трафик.Город КАК Город
		|ИЗ
		|	РегистрСведений.Renault_Трафик КАК Renault_Трафик
		|ГДЕ
		|	Renault_Трафик.Клиент = &Клиент
		|	И Renault_Трафик.Город <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	Renault_Трафик.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Город = ВыборкаДетальныеЗаписи.Город;
	КонецЦикла;
	
КонецПроцедуры


// Обновляет тексты кнопок страницы "ГруппаСтраницаВоронка", заполняет элементы: 
//	"ПолеСписокСобытий", "ТаблицаКП", "ТаблоТестДрайв", "Договоры", "Выдачи", "Резервы"
//
&НаКлиенте
Процедура ОбновитьВоронкуИСписки()
	
	ОбновитьЦветаВоронки();
	ОбновитьСписокСобытий();
	ОбновитьСписокКП();
	ОбновитьСписокТестДрайвов();
	ОбновитьСписокКонтрактов();
	ОбновитьСписокВыдач();
	ОбновитьСписокРезервов();
	
КонецПроцедуры // ОбновитьВоронкуИСписки()

// Возвращает идентификатор корпоративного клиента из справочника "Renault_КорпоративныеКлиенты"
// 
// Возвращаемое значение:
//  Структура	-	Структура с идентификатором корпоративного клиента, с полями:
//		* КорпКлиент				- СправочникСсылка.Renault_КорпоративныеКлиенты
//      * ИдентификаторКорпКлиента	- Строка
//
&НаСервере
Функция ПолучитьИдентификаторКорпКлиента()

	ИдентификаторКорпКлиента = "";
	
	ДанныеКорпКлиента = Новый Структура("КорпКлиент,ИдентификаторКорпКлиента");	
	ДанныеКорпКлиента.Вставить("КорпКлиент","");
	ДанныеКорпКлиента.Вставить("ИдентификаторКорпКлиента","");
			
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	Renault_КорпоративныеКлиенты.Ссылка
				|ИЗ
				|	Справочник.Renault_КорпоративныеКлиенты КАК Renault_КорпоративныеКлиенты
				|ГДЕ
				|	Renault_КорпоративныеКлиенты.Контрагент = &Контрагент";
			Запрос.УстановитьПараметр("Контрагент", Объект.Клиент);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				КорпКлиент  = Выборка.Ссылка;
				ИдентификаторКорпКлиента = КорпКлиент.Идентификатор;
				
				ДанныеКорпКлиента.Вставить("КорпКлиент", КорпКлиент);
				ДанныеКорпКлиента.Вставить("ИдентификаторКорпКлиента", ИдентификаторКорпКлиента);
				
				Возврат ДанныеКорпКлиента;
			КонецЕсли;	
		Иначе
			Возврат ДанныеКорпКлиента;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции // ПолучитьИдентификаторКорпКлиента()

// Изменяет окраску фона и рамки кнопок "Лизинг", "Кредит" и "Наличные"
//
// Параметры:
//  ВидЗадачи	 - СправочникСсылка.CRM_ВидыСобытий	 - Вид события РЛ
//
&НаСервере
Процедура ПокраситьКнопкиКредитСтраховка(ВидЗадачи) 
	
	УправлениеКнопкамиОФУ();
	
КонецПроцедуры // ПокраситьКнопкиКредитСтраховка()

// Изменяет окраску фона и рамки кнопок "Лизинг", "Кредит" и "Наличные"
//
&НаСервере
Процедура УправлениеКнопкамиОФУ() Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Renault_События.Ссылка,
	|	Renault_События.Состояние,
	|	Renault_События.ВидСобытия
	|ИЗ
	|	Задача.Renault_События КАК Renault_События
	|ГДЕ
	|	НЕ Renault_События.ПометкаУдаления
	|	И Renault_События.Объект В(&СписокКП)
	|	И НЕ Renault_События.Состояние В (ЗНАЧЕНИЕ(Справочник.Renault_Состояния.Отклонено), ЗНАЧЕНИЕ(Справочник.Renault_Состояния.ОтмененоВыполнение))";
	
	Запрос.УстановитьПараметр("СписокКП",СписокКП());
	ЗачачиОФУ=Запрос.Выполнить().Выгрузить();
	
	СуществуетКонсультацияОФУ=ЗачачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.КонсультацияОФУ)).Количество()>0;
	ВыполненаКонсультацияОФУ=ЗачачиОФУ.НайтиСтроки(Новый Структура("Состояние,ВидСобытия",Справочники.Renault_Состояния.ЗавершеноУспешно,Справочники.CRM_ВидыСобытий.КонсультацияОФУ)).Количество()>0;
	
	СуществуетКредит=ЗачачиОФУ.НайтиСтроки(Новый Структура("ВидСобытия",Справочники.CRM_ВидыСобытий.Кредит)).Количество()>0;
	ВыполненКредит=ЗачачиОФУ.НайтиСтроки(Новый Структура("Состояние,ВидСобытия",Справочники.Renault_Состояния.ЗавершеноУспешно,Справочники.CRM_ВидыСобытий.Кредит)).Количество()>0;
	
	СуществуетЛизинг = ?(ЕстьЛизингКорпКлиента(), Истина, Ложь);
	Элементы.Лизинг.ЦветФона=?(СуществуетЛизинг,ЦветРено,ЦветКнопкиВоронкиСерый);
	Элементы.Лизинг.ЦветРамки=?(СуществуетЛизинг,ЦветРено,ЦветСерый);
	
	Элементы.Кредит.Картинка=?(ВыполненКредит,ИзображениеСобытиеВыполнено,Новый Картинка); 
	Элементы.Кредит.ЦветФона=?(СуществуетКредит,ЦветРено,ЦветКнопкиВоронкиСерый);
	Элементы.Кредит.ЦветРамки=?(СуществуетКредит,ЦветРено,ЦветСерый);
	
	Элементы.Наличные.Картинка=?(ВыполненаКонсультацияОФУ,ИзображениеСобытиеВыполнено,Новый Картинка); 
	Элементы.Наличные.ЦветФона=?(СуществуетКонсультацияОФУ,ЦветРено,ЦветКнопкиВоронкиСерый);
	Элементы.Наличные.ЦветРамки=?(СуществуетКонсультацияОФУ,ЦветРено,ЦветСерый);
	
КонецПроцедуры // УправлениеКнопкамиОФУ()

// Возвращает массив коммерческих предложений по этому рабочему листу
// 
// Возвращаемое значение:
//  Массив - Массив ссылок на коммерческие предложения
//
&НаСервере
Функция СписокКП()
	
	Запрос=Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_КоммерческоеПредложение.Ссылка
	|ИЗ
	|	Документ.CRM_КоммерческоеПредложение КАК CRM_КоммерческоеПредложение
	|ГДЕ
	|	CRM_КоммерческоеПредложение.РабочийЛист = &РабочийЛист
	|	И НЕ CRM_КоммерческоеПредложение.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")
	
КонецФункции // СписокКП()

// Проверяет есть ли заявка на лизинг от этого корпоративного клиента
// 
// Возвращаемое значение:
//  Булево - Есть заявка на лизинг
//
&НаСервере
Функция ЕстьЛизингКорпКлиента()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_СтатистикаВыполненияЭтаповПродаж.Объект
		|ИЗ
		|	РегистрСведений.Renault_СтатистикаВыполненияЭтаповПродаж КАК Renault_СтатистикаВыполненияЭтаповПродаж
		|ГДЕ
		|	Renault_СтатистикаВыполненияЭтаповПродаж.IDK = &IDK
		|	И Renault_СтатистикаВыполненияЭтаповПродаж.ЭтапПродаж = &ЭтапПродаж";
	
	Запрос.УстановитьПараметр("IDK", 		Объект.IDK);
	Запрос.УстановитьПараметр("ЭтапПродаж", Справочники.CRM_ЭтапыПродаж.ЗаявкаНаЛизинг);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Возврат ?(ВыборкаДетальныеЗаписи.Следующий(), Истина, Ложь);
	
КонецФункции // ЕстьЛизингКорпКлиента()

// Заполнение табличного документа "ПолеСписокСобытий"
//
&НаСервере
Процедура ОбновитьСписокСобытий()
	
	ПолеСписокСобытий = Элементы.ПолеСписокСобытий;
	ПолеСписокСобытий.Очистить();
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = РегистрыСведений.Renault_РабочиеЛисты.ПолучитьМакет("СписокСобытий");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_СобытияПоРабочимЛистам.Ссылка КАК СобытиеСсылка,
	               |	CRM_СобытияПоРабочимЛистам.Дата КАК Период,
	               |	CRM_СобытияПоРабочимЛистам.Ссылка КАК ID,
	               |	CRM_СобытияПоРабочимЛистам.IDK КАК IDK,
	               |	CRM_СобытияПоРабочимЛистам.Подразделение КАК Подразделение,
	               |	CRM_СобытияПоРабочимЛистам.Отдел КАК Отдел,
	               |	CRM_СобытияПоРабочимЛистам.ДатаНапоминания КАК ДатаНапоминания,
	               |	CRM_СобытияПоРабочимЛистам.Автор КАК Автор,
	               |	CRM_СобытияПоРабочимЛистам.Сотрудник КАК Сотрудник,
	               |	CRM_СобытияПоРабочимЛистам.Комментарий КАК Комментарий,
	               |	CRM_СобытияПоРабочимЛистам.Обработано КАК Обработано,
	               |	CRM_СобытияПоРабочимЛистам.ДатаЗакрытия КАК ДатаЗакрытия,
	               |	CRM_СобытияПоРабочимЛистам.АвторЗакрытия КАК АвторЗакрытия,
	               |	CRM_СобытияПоРабочимЛистам.КомментарийЗакрытия КАК КомментарийЗакрытия,
	               |	CRM_СобытияПоРабочимЛистам.ЛидПрикрепленный.ТрафикИД КАК ЛидПрикрепленныйТрафикИД
	               |ИЗ
	               |	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	               |ГДЕ
	               |	CRM_СобытияПоРабочимЛистам.IDK = &IDK
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаНапоминания";
	Запрос.УстановитьПараметр("IDK", Объект.IDK);

	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоСобытий = Выборка.Количество();
	IDСледСобытия = Неопределено;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заголовок = "Назначенные события по рабочему листу: " + Строка(КоличествоСобытий);
	ТабДок.Вывести(ОбластьМакета);
	
	НомерСтр = 0;
	Пока Выборка.Следующий() Цикл
		
		НомерСтр = НомерСтр + 1;
		Если Выборка.Обработано Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("СтрокаОбработано");
		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОбластьМакета.Параметры, Выборка);
		ОбластьМакета.Параметры.НомерСтроки = НомерСтр;
		
		ОбластьМакета.Параметры.СтруктураРасшифровки=Выборка.ID;
		
		// + DMSREN-1362
		Если ЗначениеЗаполнено(Выборка.ЛидПрикрепленныйТрафикИД) тогда
			ОбластьМакета.Параметры.Действие = "Перейти в" + Символы.ПС + "КЦ";
			ОбластьМакета.Параметры.ИДТрафик = Выборка.ЛидПрикрепленныйТрафикИД;
			Ячейка = ОбластьМакета.Область("Действие");
			Граница = новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
			Ячейка.Обвести(Граница,Граница,Граница,Граница);
		КонецЕсли;
	    // - DMSREN-1362 
		
		ТабДок.Вывести(ОбластьМакета);
		
		//Ищем следующее событие
		Если Не Выборка.Обработано И Не ЗначениеЗаполнено(IDСледСобытия) Тогда
			IDСледСобытия = Выборка.ID;
			КомментарийСледСобытия = Выборка.Комментарий;
			СотрудникСледСобытия = Выборка.Сотрудник;
			ДатаСледСобытия = Выборка.ДатаНапоминания;
		КонецЕсли;
				
	КонецЦикла;
	
	ТабДок.ЗакончитьАвтогруппировкуСтрок();
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку     = Ложь;
	ТабДок.ТолькоПросмотр      = Истина;
	
	ПолеСписокСобытий.Вывести(ТабДок);
	ПолеСписокСобытий.ОтображатьЗаголовки = Ложь;
	ПолеСписокСобытий.ОтображатьСетку     = Ложь;
	ПолеСписокСобытий.ТолькоПросмотр      = Истина;
	ПолеСписокСобытий.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ПолеСписокСобытий.АвтоМасштаб         = Истина;
	ПолеСписокСобытий.ТекущаяОбласть = ПолеСписокСобытий.Область(1, 1, 1, 1);
	
	// Обновим следующее событие
	Если Не ЗначениеЗаполнено(IDСледСобытия) Тогда
		Элементы.НадписьСледСобытие.Заголовок = "Не назначено";
		IDСледСобытия = Неопределено;
	Иначе
		Элементы.НадписьСледСобытие.Заголовок = КомментарийСледСобытия + " (" + СотрудникСледСобытия + ", " + Формат(ДатаСледСобытия, "ДЛФ=ДД") + ")";
	КонецЕсли;
	
	Элементы.СобытиеОтправкаНаОценкуТрейдИн.Видимость = ЕстьСобытиеОтправкиНаОценкуТрейдИн();
	
КонецПроцедуры // ОбновитьСписокСобытий()

// Определяет, существует ли событие "CRM_СобытияПоРабочимЛистам" на оценку по трейд-ин по рабочему листу
// 
// Возвращаемое значение:
//  Булево - Признак наличия события отправки на оценку по трейд-ин
//
&НаСервере
Функция ЕстьСобытиеОтправкиНаОценкуТрейдИн()
	
	ЕстьСобытие = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CRM_СобытияПоРабочимЛистам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	|ГДЕ
	|	CRM_СобытияПоРабочимЛистам.IDK = &IDK
	|	И НЕ CRM_СобытияПоРабочимЛистам.ПометкаУдаления
	|	И НЕ CRM_СобытияПоРабочимЛистам.Обработано
	|	И CRM_СобытияПоРабочимЛистам.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.ОценкаТрейдИн)";
	
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		ЕстьСобытие = Истина;
	КонецЕсли;
	
	Возврат ЕстьСобытие;
	
КонецФункции // ЕстьСобытиеОтправкиНаОценкуТрейдИн()

// Заполняет список коммерческих предложений клиенту по рабочему листу
//
&НаСервере
Процедура ОбновитьСписокКП()
	//Блинков изменил запрос для отображения основного КП основываясь на регистре а не на реквизите документа DMSREN-742
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_КП.РабочийЛист,
	|	CRM_КП.Ссылка,
	|	CRM_КП.Дата КАК Дата,
	|	CRM_КП.Состав.(
	|		Ссылка,
	|		НомерСтроки,
	|		Конфигурация,
	|		Сумма,
	|		Конфигурация.Модель,
	|		Конфигурация.Версия,
	|		Конфигурация.Автомобиль,
	|		Конфигурация.Автомобиль.VIN
	|	) КАК СоставКП,
	|	CRM_КП.Номер,
	|	CRM_КП.Представление КАК Конфигурация,
	|	CRM_КП.Сумма КАК Сумма,
	|	CRM_КП.ДатаНачалаПередачиАвто,
	|	CRM_КП.ДатаОкончанияПередачиАвто,
	|	ВЫБОР
	|		КОГДА CRM_ВоронкаПродаж.Объект ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ОсновноеКП
	|ИЗ
	|	Документ.CRM_КоммерческоеПредложение КАК CRM_КП
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
	|		ПО CRM_КП.Ссылка = CRM_ВоронкаПродаж.Объект
	|			И (CRM_ВоронкаПродаж.ЭтапПродаж = ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.КоммерческоеПредложение))
	|ГДЕ
	|	CRM_КП.РабочийЛист = &РабочийЛист
	|	И CRM_КП.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
	ТаблицаКоммерческихПредложений = Запрос.Выполнить().Выгрузить();
	
	ТаблицаКоммерческихПредложений.Колонки.Добавить("ПериодВыдачиОриентировочный", Новый ОписаниеТипов("Строка"));
	
	Для Каждого Строка Из ТаблицаКоммерческихПредложений Цикл
		НужнаЗапятая = Ложь;
		Строка.Конфигурация = "";
		
		Если Строка.ДатаНачалаПередачиАвто = Дата(1, 1, 1) И Строка.ДатаОкончанияПередачиАвто = Дата(1, 1, 1) Тогда
			Строка.ПериодВыдачиОриентировочный = "";
		Иначе	
			Строка.ПериодВыдачиОриентировочный = ""+Формат(Строка.ДатаНачалаПередачиАвто, "ДЛФ=Д")+" - "+Формат(Строка.ДатаОкончанияПередачиАвто, "ДЛФ=Д");
		КонецЕсли;	
		
		Для Каждого СтрокаКонфигурации Из Строка.СоставКП Цикл
			
			//Наименование
			Если НужнаЗапятая Тогда
				Строка.Конфигурация = Строка.Конфигурация + ", ";
			КонецЕсли;
			НужнаЗапятая = Истина;
			Строка.Конфигурация = Строка.Конфигурация + Строка(СтрокаКонфигурации.КонфигурацияМодель) + " " + Строка(СтрокаКонфигурации.КонфигурацияВерсия);
			Если ЗначениеЗаполнено(СтрокаКонфигурации.КонфигурацияАвтомобиль) Тогда
				Строка.Конфигурация = Строка.Конфигурация + " (" + СтрокаКонфигурации.КонфигурацияАвтомобильVIN + ")";
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаКП.Загрузить(ТаблицаКоммерческихПредложений);
	
	Если ТаблицаКП.Количество() = 1 Тогда
		
		Элементы.ТаблицаКП.ПодчиненныеЭлементы.ТаблицаКПОсновноеКП.Видимость = Ложь;
		
	ИначеЕсли ТаблицаКП.Количество() > 1 Тогда
		
		Элементы.ТаблицаКП.ПодчиненныеЭлементы.ТаблицаКПОсновноеКП.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры // ОбновитьСписокКП()

// Заполнение табличного документа "ТаблоТестДрайв"
//
&НаСервере
Процедура ОбновитьСписокТестДрайвов()
	
	ТаблоТестДрайв.Очистить();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = РегистрыСведений.Renault_РабочиеЛисты.ПолучитьМакет("ЗаписиНаТестДрайв");

	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заголовок = "Тест-драйв клиента";
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаписиНаТестДрайв.IDK,
	|	ЗаписиНаТестДрайв.Автомобиль.Модель КАК МодельАвтомобиля,
	|	ЗаписиНаТестДрайв.Менеджер КАК Сотрудник,
	|	ЗаписиНаТестДрайв.Подразделение КАК Подразделение,
	|	ЗаписиНаТестДрайв.ДатаНачала КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(ЗаписиНаТестДрайв.Регистратор.СтатусДокумента) КАК Комментарий,
	|	ЗаписиНаТестДрайв.Статус КАК Статус,
	|	CRM_СобытияПоРабочимЛистам.Ссылка КАК Ссылка,
	|	ЗаписиНаТестДрайв.Регистратор.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.CRM_ЗаписиНаТестДрайв КАК ЗаписиНаТестДрайв
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	|		ПО ЗаписиНаТестДрайв.Регистратор = CRM_СобытияПоРабочимЛистам.Объект
	|ГДЕ
	|	ЗаписиНаТестДрайв.IDK = &IDK
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";	
	
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	Выборка = Запрос.Выполнить().Выбрать();
	Нпп = 0;
	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	
	Пока Выборка.Следующий() Цикл
		Нпп = Нпп + 1;
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		ОбластьМакета.Параметры.Нпп       = СокрЛП(Нпп);
		ОбластьМакета.Параметры.Дата      = СокрЛП(Формат(Выборка.Дата, "ДЛФ=DD"));
		ОбластьМакета.Параметры.Сотрудник = СокрЛП(Выборка.Сотрудник);
		ОбластьМакета.Параметры.Модель    = СокрЛП(Выборка.МодельАвтомобиля);
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			ОбластьМакета.Параметры.Ссылка = Выборка.Ссылка;
		КонецЕсли;
		ОбластьМакета.Параметры.Номер = Выборка.Номер;
		ОбластьМакета.Параметры.Комментарий = СокрЛП(Выборка.Статус);
		ТабличныйДокумент.Вывести(ОбластьМакета, 2, Ложь);
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ОтображатьСетку     = Ложь;
	ТабличныйДокумент.ТолькоПросмотр      = Истина;
	
