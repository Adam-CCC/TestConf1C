&НаКлиенте
Процедура Клиент_ИННПриИзменении(Элемент)
	
	УстановитьДоступностьРеквизитовКорпКлиента(Ложь);
	
	КонтрагентПоиск = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", Клиент_ИНН);
	Если Не ЗначениеЗаполнено(КонтрагентПоиск) Тогда
		
		Клиент_ИНН = СтрЗаменить(Клиент_ИНН, " ", "");
		СохранениеКонтрагентовСОшибочнымИНН = обПраво("СохранениеКонтрагентовСОшибочнымИНН", Права);
		Если СохранениеКонтрагентовСОшибочнымИНН <> Перечисления.ВидыКонтроля.НеКонтролировать Тогда
			ОшибкаИНН = ПроверкаИНН(Клиент_ИНН);
			Если ОшибкаИНН <> "" Тогда
				Если СохранениеКонтрагентовСОшибочнымИНН = Перечисления.ВидыКонтроля.Предупреждать Тогда
					ОтветНаПредупреждение=Вопрос(ОшибкаИНН + "
												|Вы хотите отправить запрос?",
												РежимДиалогаВопрос.ДаНет,,
												КодВозвратаДиалога.Нет,
												"Внимание");
					Если ОтветНаПредупреждение<>КодВозвратаДиалога.Да Тогда
						Отказ=Истина;
						Клиент_ИНН = "";
						Возврат;
					КонецЕсли;
				Иначе
					Сообщить(ОшибкаИНН); 
					Отказ=Истина;
					Клиент_ИНН = "";
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеПоКонтрагентуВЦентрБазе = RenaultFlotte_ОтправкаЗагрузкаКлиентов.ПоискКонтрагентаВDictionary(Клиент_ИНН);
		
		Если ДанныеПоКонтрагентуВЦентрБазе.Количество()>0 Тогда
			
			СостояниеКорпКлиента = ДанныеПоКонтрагентуВЦентрБазе.Состояние;
			
			Если СостояниеКорпКлиента = "В черном списке" Тогда
				
				Сообщить("Клиент не соответствует критериям корпоративного клиента");
				
			Иначе
				
				ЗагрузитьКорпоративногоКлиента(ДанныеПоКонтрагентуВЦентрБазе);
				Элементы.НадписьКОРПКлиентНайденный.Заголовок = Строка(КонтрагентПоиск);
				Элементы.НадписьКОРПКлиентНайденный.Гиперссылка = Истина;
				Сообщить("Клиент найден в центральной базе корп. продаж и загружен");
				
				//если у клиента уже есть идентификатор, 
				//то у него можно менять только контактные лица и контактную информацию
				УстановитьДоступностьРеквизитовКорпКлиента(Истина);
				
			КонецЕсли;
			
		Иначе
			
			Сообщить("Клиент ранее не обращался в Renault");
			
			Элементы.НадписьКОРПКлиентНайденный.Заголовок = "Контрагент не найден";
			Элементы.НадписьКОРПКлиентНайденный.Гиперссылка = Ложь;
			
		КонецЕсли;
		
	Иначе
		Элементы.НадписьКОРПКлиентНайденный.Заголовок = Строка(КонтрагентПоиск);
		Элементы.НадписьКОРПКлиентНайденный.Гиперссылка = Истина;
	КонецЕсли;
	
КонецПроцедуры // Клиент_ИННПриИзменении()

&НаКлиенте
Процедура Клиент_ФИОКОРПОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(КорпКлиент) Тогда
		КонтрагентСсылка = КорпКлиент.Контрагент;
		ФормаКорпКлиента = Справочники.Renault_КорпоративныеКлиенты.ПолучитьФорму(
			"Renault_ФормаКорпоративногоКлиента",,
			КорпКлиент.Контрагент.УникальныйИдентификатор());
		ФормаКорпКлиента.СправочникОбъект = КонтрагентСсылка.ПолучитьОбъект();
		ФормаКорпКлиента.СферыДеятельности = КорпКлиент.СферыДеятельности.Выгрузить();
		ФормаКорпКлиента.Автопарк = КорпКлиент.Автопарк.Выгрузить();
		ФормаКорпКлиента.КлючУникальности = КорпКлиент.Контрагент.УникальныйИдентификатор();
		ФормаКорпКлиента.ОткрытьМодально();
		
		Элементы.Клиент_ФИОКОРП.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры // Клиент_ФИОКОРПОткрытие()

&НаКлиенте
Процедура ЗаголовокНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Сотрудник) Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос("Взять рабочий лист в работу?", Режим, 0);
		Если Ответ = КодВозвратаДиалога.Да Тогда			
			Объект.Сотрудник = ПараметрыСеанса.Пользователь.Сотрудник;	
			Если ЗначениеЗаполнено(Объект.Сотрудник) Тогда
				Если Объект.ТипРабочегоЛиста = ПредопределенноеЗначение("Перечисление.Renault_ТипыРабочихЛистов.TradeIn") Тогда
					СтруктураОтбора = Новый Структура();
					СтруктураОтбора.Вставить("РабочийЛист", Объект.IDK);
					Выборка = Документы.Renault_ЗаявкаНаТрейдИн.Выбрать(,, СтруктураОтбора);
					
					Если Выборка.Следующий() И НЕ ЗначениеЗаполнено(Выборка.МенеджерТрейдИн) И Не Выборка.ПометкаУдаления Тогда					
						ДокЗаявкаПоТрейдИн = Выборка.Ссылка.ПолучитьОбъект();
						ДокЗаявкаПоТрейдИн.МенеджерТрейдИн = Объект.Сотрудник;
						Попытка
							ДокЗаявкаПоТрейдИн.Записать(РежимЗаписиДокумента.Запись);
						Исключение
							Сообщить("Не удалось указать менеджера по трейд-ин в заявке № "+Выборка.Номер);
						КонецПопытки;
					КонецЕсли;	
					
					РазблокироватьРЛ();
					
				ИначеЕсли Объект.ТипРабочегоЛиста = ПредопределенноеЗначение("Перечисление.Renault_ТипыРабочихЛистов.Продажа") Тогда
					Объект.Сотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
					
					Попытка
						Записать();
						РазблокироватьРЛ();
					Исключение
						Сообщить("Не удалось указать сотрудника в рабочем листе № "+Выборка.Номер);
					КонецПопытки;
					
				КонецЕсли;	
			Иначе
				Сообщить("У текущего пользователя 1С не заполнен сотрудник");
			КонецЕсли;
			ОбновитьЗаголовок();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

