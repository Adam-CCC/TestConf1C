// Устанавливает цвета фона для кнопок "УспешнаяПродажа" и "ЗапросНаЗакрытие"
//
&НаКлиенте
Процедура ОбновитьОтображениеКнопокЗакрытия()
	
	ВыделятьУпущен = Ложь;
	ВыделятьПродан = Ложь;
	Элементы.УспешнаяПродажа.ЦветФона 	= Новый Цвет (156, 166, 178);
	Элементы.КлиентУпущен.ЦветФона 		= Новый Цвет (156, 166, 178);
	
	Если Объект.ЗапросНаЗакрытие Тогда
		
		Если Объект.ПричинаЗакрытия = Справочники.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа Тогда
			ВыделятьПродан = Истина;
		Иначе
			ВыделятьУпущен = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВыделятьПродан Тогда
		Элементы.УспешнаяПродажа.ЦветФона 	= ЦветРено;
	ИначеЕсли ВыделятьУпущен Тогда
		Элементы.КлиентУпущен.ЦветФона 	= ЦветРено;
	КонецЕсли;
	
КонецПроцедуры // ОбновитьОтображениеКнопокЗакрытия()

// Устанавливает цвет фона и цвет рамки для кнопок на странице "ГруппаСтраницаРОП"
//
&НаКлиенте
Процедура ОбновитьЦветКнопокРОП()
	
	Кнопка = Элементы.ПодтвердитьЗакрытие;
	Если Объект.ЛистЗакрыт Тогда
		Кнопка.ЦветРамки 	= ЦветРено;
		Кнопка.ЦветТекста 	= ЦветРено;
		Кнопка.ЦветФона 	= ЦветБелый;
	Иначе
		Кнопка.ЦветРамки 	= ЦветБелый;
		Кнопка.ЦветТекста 	= ЦветБелый;
		Кнопка.ЦветФона 	= ЦветСерый;
	КонецЕсли;
	
КонецПроцедуры // ОбновитьЦветКнопокРОП()

