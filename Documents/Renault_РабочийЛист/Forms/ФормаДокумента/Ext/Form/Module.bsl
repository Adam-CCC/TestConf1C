// Устанавливает тип рабочего листа и начальные настройки для трейд-ин
//
// Параметры:
//  ПраваРено	 - ФиксированнаяСтруктура	 - Права пользователя
//
&НаКлиенте
Процедура ОпределитьНеобходимостьФункционалаТрейдИн(ПраваРено)
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипРабочегоЛиста) Тогда
		Если Объект.Отдел.КлассификацияRenault = Перечисления.CRM_КлассификацияОтделов.ОтделТрейдИн И Не РЛПоПродаже Тогда
			Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn;
		Иначе
			Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.Продажа; 
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьНачальныеЗначенияДляТрейдИн(Истина, ПраваРено.Продажи_РазрешитьВРЛРасширенногоФункционалаТрейдИн, Объект.ТипРабочегоЛиста); 	
		
КонецПроцедуры // ОпределитьНеобходимостьФункционалаТрейдИн()


// Заполняет свойства элементов управления и значения реквизитов в зависимости от типа рабочего листа продажи/трейд-ин
//
// Параметры:
//  ЭтоПродажаПрава	 - Булево	 										- Признак продажи
//  ЭтоТрейдИнПрава	 - Булево	 										- Признак трейд-ин
//  ТипРабочегоЛиста - ПеречислениеСсылка.Renault_ТипыРабочихЛистов	 	- Тип рабочего листа продажа/трейд-ин
//
&НаКлиенте
Процедура ЗаполнитьНачальныеЗначенияДляТрейдИн(ЭтоПродажаПрава, ЭтоТрейдИнПрава, ТипРабочегоЛиста)
	
	Перем ПараметрыУправленияЭлементами;
	Перем ПараметрыУправленияСтраницами;
	
	Если ЭтоТрейдИнПрава Тогда
		
		Если ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
			СессияТрейдИн = Renault_РаботаСРабочимиЛистамиПовтИсп.СессияДляТрейдИн();
			Renault_РаботаСРабочимиЛистами.ЗагрузитьСправочникиТрейдИн(СессияТрейдИн);
			
			ЗаявкаНаТрейдИн = ПолучитьЗаявкуНаТрейдИн(Объект.IDK);			
			
			Значение = ЗначениеЗаполнено(ЗаявкаНаТрейдИн);
			Если Значение Тогда
				
				ПроизводительТрейдИн = ЗаявкаНаТрейдИн.ПроизводительКод;
				ГодВыпускаТрейдИн = ЗаявкаНаТрейдИн.ГодВыпуска;
				МодельТрейдИн = ЗаявкаНаТрейдИн.МодельКод;		
				ОжидаемаяСтоимостьКлиентаТрейдИн = ЗаявкаНаТрейдИн.ОжиданиеСтоимостиКлиента;
				ТипОперацииТрейдИн = ЗаявкаНаТрейдИн.ТипОперацииTradeIn;
				
				ЗаполнитьСписокВыбораЭлемента("ПроизводительТрейдИн");
				
				Если ЗначениеЗаполнено(ПроизводительТрейдИн) Тогда
					Если Элементы.ГодВыпускаТрейдИн.СписокВыбора.Количество() = 0 Тогда
						ЗаполнитьСписокВыбораЭлемента("ГодВыпускаТрейдИн");
					КонецЕсли;

				КонецЕсли;
				
				Если ЗначениеЗаполнено(ГодВыпускаТрейдИн) Тогда
					ЗаполнитьСписокВыбораЭлемента("МодельТрейдИн");
				КонецЕсли;
				
			Иначе
				
				СоздатьЗаявкуТрейдИн(Неопределено);
				
				Значение = ЗначениеЗаполнено(ЗаявкаНаТрейдИн);
				
			КонецЕсли;
			
			ПараметрыУправленияЭлементами = Новый Структура;
			ПараметрыУправленияЭлементами.Вставить("ГодВыпускаТрейдИн", ЗначениеЗаполнено(ПроизводительТрейдИн));
			ПараметрыУправленияЭлементами.Вставить("МодельТрейдИн", ЗначениеЗаполнено(ГодВыпускаТрейдИн));
			ПараметрыУправленияЭлементами.Вставить("ОжидаемаяСтоимостьКлиентаТрейдИн", ЗначениеЗаполнено(МодельТрейдИн));
			
		КонецЕсли;
		
	Иначе
		
		Если ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
			
			Сообщить("Нет прав по работе с рабочими листами трейд-ин!");
			
			ЭтаФорма.Закрыть();
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыУправленияСтраницами = Новый Структура("ТипРабочегоЛиста", Объект.ТипРабочегоЛиста);	

	ОбновитьИнтерфейсТрейдИн(ПараметрыУправленияЭлементами, ПараметрыУправленияСтраницами);
	
	ОбновитьВоронкуИСпискиТрейдИн();
	
КонецПроцедуры // ЗаполнитьНачальныеЗначенияДляТрейдИн()

// Возвращает ссылку на заявку на трейд-ин IDK рабочего листа
//
// Параметры:
//  РабочийЛист	 - Строка	 - IDK рабочего листа
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_ЗаявкаНаТрейдИн - Заявка на трейд-ин по IDK рабочего листа
//
&НаСервере
Функция ПолучитьЗаявкуНаТрейдИн(РабочийЛист)
	
	Документ = Документы.Renault_ЗаявкаНаТрейдИн.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ЗаявкаНаТрейдИн.Ссылка КАК Документ
		|ИЗ
		|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
		|ГДЕ
		|	НЕ Renault_ЗаявкаНаТрейдИн.ПометкаУдаления
		|	И Renault_ЗаявкаНаТрейдИн.РабочийЛист = &РабочийЛист
		|
		|УПОРЯДОЧИТЬ ПО
		|	Renault_ЗаявкаНаТрейдИн.МоментВремени УБЫВ";	
	Запрос.УстановитьПараметр("РабочийЛист", РабочийЛист);	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда	
		Выборка = Результат.Выбрать();		
		Выборка.Следующий();
		
		Документ = Выборка.Документ; 	
	КонецЕсли;
	
	Возврат Документ;
	
КонецФункции // ПолучитьЗаявкуНаТрейдИн()

// Заполняет списки выбора элементов формы
//
// Параметры:
//  ИмяЭлемента	 - Строка	 - Имя элемента формы
//
&НаСервере
Процедура ЗаполнитьСписокВыбораЭлемента(ИмяЭлемента)
	
	Если ИмяЭлемента = "ПроизводительТрейдИн" Тогда
		МассивЗначений = Renault_РаботаСРабочимиЛистами.СписокПроизводителейДляТрейдИн(СессияТрейдИн, "");
		
		Если МассивЗначений.Найти(ПроизводительТрейдИн) = Неопределено Тогда
			МассивЗначений.Добавить(ПроизводительТрейдИн);
		КонецЕсли;
		
	ИначеЕсли ИмяЭлемента = "ГодВыпускаТрейдИн" Тогда
		Если ПроизводительТрейдИн <> Неопределено Тогда
			МассивЗначений = Renault_РаботаСРабочимиЛистами.СписокГодовВыпускаДляТрейдИн(СессияТрейдИн, "", ПроизводительТрейдИн);		
			
			СписокЧисел = Новый СписокЗначений;
			Для Каждого Эл Из МассивЗначений Цикл
				СписокЧисел.Добавить(Формат(Число(Эл), "ЧГ=") + "          ");	// DMSREN-1210
			КонецЦикла;
			
			СписокЧисел.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
			
			МассивЗначений.Очистить();
			
			Для Каждого Эл Из СписокЧисел Цикл
				МассивЗначений.Добавить(Строка(Эл.Значение));
			КонецЦикла;
			
			Если МассивЗначений.Найти(ГодВыпускаТрейдИн) = Неопределено Тогда
				МассивЗначений.Добавить(Формат(ГодВыпускаТрейдИн,"ЧГ=") + "          ");   // DMSREN-1210 
			КонецЕсли;
		КонецЕсли;		
	ИначеЕсли ИмяЭлемента = "МесяцВыпускаТрейдИн" Тогда
		Если Элементы[ИмяЭлемента].СписокВыбора.Количество() = 0 Тогда
			Для Счетчик = 1 По 12 Цикл
				Если Счетчик < 10 Тогда
					Месяц = "0" + Счетчик;
				Иначе
					Месяц = "" + Счетчик;
				КонецЕсли;
				
				Элементы[ИмяЭлемента].СписокВыбора.Добавить(Месяц);	
			КонецЦикла;
		КонецЕсли;
		
		Возврат;
	ИначеЕсли ИмяЭлемента = "МодельТрейдИн" Тогда
		МассивЗначений = Renault_РаботаСРабочимиЛистами.СписокМоделейДляТрейдИн(СессияТрейдИн, "", ПроизводительТрейдИн, МесяцВыпускаТрейдИн, ГодВыпускаТрейдИн);		
		
		Если МассивЗначений.Найти(МодельТрейдИн) = Неопределено Тогда
			МассивЗначений.Добавить(МодельТрейдИн);
		КонецЕсли;
		
	ИначеЕсли ИмяЭлемента = "ПервичныйИнтересМодельВыбор" Тогда
		МассивЗначений = Renault_CRM.ПолучитьПервичныйИнтерес(Объект.ДилерскийЦентр);
	КонецЕсли;
	
	Элементы[ИмяЭлемента].СписокВыбора.Очистить();
	
	Если МассивЗначений <> Неопределено Тогда
	
		Для Каждого Значение Из МассивЗначений Цикл
			Элементы[ИмяЭлемента].СписокВыбора.Добавить(Значение);	
		КонецЦикла;
		
		Если МассивЗначений.Количество() = 1 Тогда
			ПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
			Если Лев(ПутьКДанным, 7) = "Объект." Тогда
				Объект[СтрЗаменить(ПутьКДанным, "Объект.", "")] = МассивЗначений[0];
			Иначе
				ЭтаФорма[ПутьКДанным] = МассивЗначений[0];
			КонецЕсли;
			
			ИмяСледующегоЭлемента = "";
			Если ИмяЭлемента = "ПроизводительТрейдИн" Тогда
				ЗаполнитьСписокВыбораЭлемента("ГодВыпускаТрейдИн");
				
				ПараметрыУправленияЭлементами = Новый Структура();
				ПараметрыУправленияЭлементами.Вставить("ГодВыпускаТрейдИн", Истина);
				//ПараметрыУправленияЭлементами.Вставить("МесяцВыпускаТрейдИн", Истина);
				
				ОбновитьИнтерфейсТрейдИн(ПараметрыУправленияЭлементами);
				
				Возврат; 
			КонецЕсли;		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьСписокВыбораЭлемента()

// Управляет видимостью и доступностью элементов формы в зависимости от переданных параметров
//
// Параметры:
//  ПараметрыУправленияЭлементами	 - Структура	 -  Параметры установки видимости и доступности элементов формы
//  ПараметрыУправленияСтраницами	 - Структура	 -  Параметры отображения страниц элементов формы
//
&НаСервере
Процедура ОбновитьИнтерфейсТрейдИн(ПараметрыУправленияЭлементами = Неопределено, ПараметрыУправленияСтраницами = Неопределено)
	
	Если ПараметрыУправленияЭлементами <> Неопределено Тогда
		Для Каждого Элемент Из ПараметрыУправленияЭлементами Цикл
			Элементы[Элемент.Ключ].Доступность = Элемент.Значение;
		КонецЦикла;		
	КонецЕсли;
	
	Если ПараметрыУправленияСтраницами <> Неопределено Тогда
		ТипЛиста = ПараметрыУправленияСтраницами.ТипРабочегоЛиста;
		
		Элементы.ГруппаСтраницыАвтомобиль.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
			
		Элементы.ГруппаСтраницыПродажаПрием.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;

		Если ТипЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
			Элементы.ГруппаСтраницыАвтомобиль.ТекущаяСтраница 		= Элементы.АвтомобильТрейдИн;
			Элементы.АвтомобильПродажа.Видимость 					= Ложь;
			Элементы.АвтомобильПродажаТрейдИн.Видимость 			= Истина;
			Элементы.АвтомобильТрейдИнПродажа.Видимость 			= Ложь;
			Элементы.АвтомобильТрейдИн.Видимость 					= Истина;
			Элементы.АвтомобильПродажаБУ.Видимость 					= Ложь;

			Элементы.ГруппаСтраницыПродажаПрием.ТекущаяСтраница = Элементы.ГруппаСтраницаПрием;
				
			Элементы.ГруппаОсновнаяИнформацияШапкаЛеваяСтраницы.ТекущаяСтраница = Элементы.ГруппаОсновнаяИнформацияШапкаЛеваяСтраницаТрейдИн;
			
			Элементы.Клиент_Город.Видимость = Ложь;
			//Элементы.НадписьEmail1.Видимость = Ложь;
			Элементы.НовыйАвтомобиль.Видимость = Ложь;
			Если Элементы.НовыйАвтомобиль.СписокВыбора.Количество() = 2 Тогда
				Элементы.НовыйАвтомобиль.СписокВыбора.Удалить(1);
			КонецЕсли;
			ЗаполнитьСписокВыбораЭлемента("ПервичныйИнтересМодель");
			
		Иначе
			Если Объект.ПродажаБУ Тогда
				Элементы.ГруппаСтраницыАвтомобиль.ТекущаяСтраница 	= Элементы.АвтомобильПродажаБУ;
				Элементы.АвтомобильПродажаБУ.Видимость 				= Истина; 
				Элементы.АвтомобильТрейдИнПродажа.Видимость 		= Истина;
				Элементы.АвтомобильПродажа.Видимость 				= Ложь;
				Элементы.ПодборАвто.Видимость 						= Ложь;
			Иначе
				Элементы.ГруппаСтраницыАвтомобиль.ТекущаяСтраница 	= Элементы.АвтомобильПродажа;
				Элементы.АвтомобильПродажа.Видимость 				= Истина;
				Элементы.АвтомобильПродажаБУ.Видимость 				= Ложь;
				Элементы.АвтомобильТрейдИнПродажа.Видимость 		= Истина;
				Элементы.ПодборАвто.Видимость 						= Истина;
			КонецЕсли;
			Элементы.АвтомобильПродажаТрейдИн.Видимость = Ложь;
			Элементы.АвтомобильТрейдИн.Видимость 		= Ложь;

			Элементы.ГруппаСтраницыПродажаПрием.ТекущаяСтраница = Элементы.ГруппаСтраницаПродажа;
				
			Элементы.ГруппаОсновнаяИнформацияШапкаЛеваяСтраницы.ТекущаяСтраница = Элементы.ГруппаОсновнаяИнформацияШапкаЛеваяСтраницаТипКлиента;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // ОбновитьИнтерфейсТрейдИн()

// Вызывает обновление оформления и заполнение таблиц значений формы для типа рабочего листа "Трейд-Ин"
//
&НаСервере
Процедура ОбновитьВоронкуИСпискиТрейдИн()
	
	ОбновитьЦветаВоронкиТрейдИн();	
	ОбновитьСписокСобытий();
	ОбновитьКнопкиТипТрейдИн();
	
КонецПроцедуры // ОбновитьВоронкуИСпискиТрейдИн()

// Устанавливает оформление кнопок типа трейд-ин в зависимости от типа операции трейд-ин
//
&НаСервере
Процедура ОбновитьКнопкиТипТрейдИн()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.Renault_ТипыОперацийТрейдИн.TradeIn) КАК ТрейдИн,
	|	ЗНАЧЕНИЕ(Перечисление.Renault_ТипыОперацийТрейдИн.Комиссия) КАК Комиссия,
	|	ЗНАЧЕНИЕ(Перечисление.Renault_ТипыОперацийТрейдИн.Выкуп) КАК Выкуп";	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();	
	Выборка.Следующий();
	
	ТрейдИн = Выборка.ТрейдИн;
	Комиссия = Выборка.Комиссия;
	Выкуп = Выборка.Выкуп;
	
	Если НЕ ЗначениеЗаполнено(ТипОперацииТрейдИн) Тогда
		ТипОперацииТрейдИн = ТрейдИн;
	КонецЕсли;
	
	Если ТипОперацииТрейдИн = ТрейдИн Тогда
		
		Элементы.ТипТрейдИнТрейдИн.ЦветФона 	= ЦветРено;		
		Элементы.ТипТрейдИнВыкуп.ЦветФона 		= Новый Цвет (156, 166, 178);
		Элементы.ТипТрейдИнКомиссия.ЦветФона 	= Новый Цвет (156, 166, 178);		
		
	ИначеЕсли ТипОперацииТрейдИн = Комиссия Тогда
		
		Элементы.ТипТрейдИнТрейдИн.ЦветФона 	= Новый Цвет (156, 166, 178);		
		Элементы.ТипТрейдИнВыкуп.ЦветФона 		= Новый Цвет (156, 166, 178);
		Элементы.ТипТрейдИнКомиссия.ЦветФона 	= ЦветРено;	
		
	ИначеЕсли ТипОперацииТрейдИн = Выкуп Тогда
		
		Элементы.ТипТрейдИнТрейдИн.ЦветФона 	= Новый Цвет (156, 166, 178);		
		Элементы.ТипТрейдИнВыкуп.ЦветФона 		= ЦветРено;
		Элементы.ТипТрейдИнКомиссия.ЦветФона 	= Новый Цвет (156, 166, 178);	
		
	КонецЕсли;
	
КонецПроцедуры // ОбновитьКнопкиТипТрейдИн()

// Устанавливает свойства элементов группы "ГруппаДляСтатистики"
//
&НаСервере
Процедура ОбновитьПоляДляСтатистики()
	
	Если Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.Продажа И НовыйАвтомобиль = 0 Тогда
		
		Объект.ТипПродажиВыкупа = "";
		Объект.Гарантия 		= "";
		Объект.СрокГарантии 	= "";
		
		Элементы.ТипПродажиВыкупа.Доступность 	= Ложь; 
		Элементы.Гарантия.Доступность 			= Ложь;
		Элементы.СрокГарантии.Доступность 		= Ложь;
		
	Иначе
		
		Элементы.ТипПродажиВыкупа.Доступность 	= Истина; 
		Элементы.Гарантия.Доступность 			= Истина;
		Элементы.СрокГарантии.Доступность 		= Истина;
		
		Элементы.ТипПродажиВыкупа.СписокВыбора.Очистить();
		Элементы.Гарантия.СписокВыбора.Очистить();
		Элементы.СрокГарантии.СписокВыбора.Очистить();
		
		Если Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
			Для ч = 0 по Перечисления.Renault_Used_ТипыПоступленияАвто.Количество() - 1 Цикл
				Элементы.ТипПродажиВыкупа.СписокВыбора.Добавить(Строка(Перечисления.Renault_Used_ТипыПоступленияАвто[ч]));
			КонецЦикла;
		Иначе
			Для ч=0 по Перечисления.Renault_Used_ТипыПродажиАвто.Количество()- 1 Цикл
				Элементы.ТипПродажиВыкупа.СписокВыбора.Добавить(Строка(Перечисления.Renault_Used_ТипыПродажиАвто[ч]));
			КонецЦикла;
		КонецЕсли;
		Элементы.Гарантия.СписокВыбора.Добавить("Renault Selections (silver+)");
		Элементы.Гарантия.СписокВыбора.Добавить("Базовая (bronze+)");
		Элементы.Гарантия.СписокВыбора.Добавить("Нет");
		Элементы.СрокГарантии.СписокВыбора.Добавить(12);
		Элементы.СрокГарантии.СписокВыбора.Добавить(24);
		Если Объект.Гарантия = "Нет" Тогда 
			Элементы.СрокГарантии.Доступность = Ложь 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбновитьПоляДляСтатистики()

// Присутствие в базе организации с определенными ИНН
// 
// Возвращаемое значение:
//  Булево - Признак того, что в базе присутствует организация с ИНН "7813382729" или "7718752313"
//
&НаСервере
Функция ЭтоПетровский()
	
	Запрос=Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	1 КАК Поле1
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН В(&МассивИНН)";
	
	МассивИНН=Новый Массив;
	МассивИНН.Добавить("7813382729");
	МассивИНН.Добавить("7718752313");
	Запрос.УстановитьПараметр("МассивИНН",МассивИНН);
	
	Возврат Не Запрос.Выполнить().Пустой()
	
КонецФункции // ЭтоПетровский()

// Включает видимость группы "ГруппаСправочнаяИнформация" и заполняет реквизиты формы:
// 	 "ОриентировочнаяЦенаТрейдИн", "ОценкаСуммыКредита", "СтоимостьКАСКО"
//
&НаСервере
Процедура УправлениеПанельюСтатистики()
	
	Элементы.ГруппаСправочнаяИнформация.Видимость = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_РабочийЛистОФУРасчетКредита.СуммаКредита,
	|	Renault_РабочийЛистОФУФинансовыеУслуги.Стоимость КАК СтоимостьКАСКО,
	|	Renault_РабочийЛистОФУ.РабочийЛист
	|ПОМЕСТИТЬ Пакет1
	|ИЗ
	|	Документ.Renault_РабочийЛистОФУ КАК Renault_РабочийЛистОФУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_РабочийЛистОФУ.РасчетКредита КАК Renault_РабочийЛистОФУРасчетКредита
	|		ПО Renault_РабочийЛистОФУ.Ссылка = Renault_РабочийЛистОФУРасчетКредита.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_РабочийЛистОФУ.ФинансовыеУслуги КАК Renault_РабочийЛистОФУФинансовыеУслуги
	|		ПО Renault_РабочийЛистОФУ.Ссылка = Renault_РабочийЛистОФУФинансовыеУслуги.Ссылка
	|ГДЕ
	|	Renault_РабочийЛистОФУ.РабочийЛист = &РабочийЛист
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_ЗаявкаНаТрейдИн.ОриентировочнаяЦена,
	|	Пакет1.СуммаКредита,
	|	Пакет1.СтоимостьКАСКО
	|ИЗ
	|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|		ЛЕВОЕ СОЕДИНЕНИЕ Пакет1 КАК Пакет1
	|		ПО Renault_ЗаявкаНаТрейдИн.РабочийЛист = Пакет1.РабочийЛист
	|ГДЕ
	|	Renault_ЗаявкаНаТрейдИн.РабочийЛист = &РабочийЛист";
	
	Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОриентировочнаяЦенаТрейдИн = ВыборкаДетальныеЗаписи.ОриентировочнаяЦена;
		ОценкаСуммыКредита = ВыборкаДетальныеЗаписи.СуммаКредита;
	 	СтоимостьКАСКО = ВыборкаДетальныеЗаписи.СтоимостьКАСКО;
	КонецЦикла;
	
КонецПроцедуры // УправлениеПанельюСтатистики()

// Возвращает документ согласия на обработку персональных данных по клиенту
// 
// Возвращаемое значение:
//  ДокументСсылка.DMS_СогласиеНаОбработкуПерсональныхДанных - документ согласия на обработку персональных данных по клиенту
//
&НаСервере
Функция СогласиеНаОПД()
	
	ДокументСогласиеНаОбработкуПерсональныхДанных = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ВернутьСогласиеПоКлиенту(Объект.Клиент); 
	
	Возврат ДокументСогласиеНаОбработкуПерсональныхДанных;
	
КонецФункции // СогласиеНаОПД()

// Устанавливает заголовок кнопки "ОткрытьICM"
//
// Параметры:
//  СообщатьОбРезультате - Булево	 - Признак вывода сообщения с результатом обработки на экран
//
&НаКлиенте
Процедура ОбновитьДатуICM(СообщатьОбРезультате = Ложь)
	
	VIN = ВернутьVINПоАвтомобилям(Истина);
	ОбновитьДатуICMСервер(VIN, СообщатьОбРезультате);
	
КонецПроцедуры // ОбновитьДатуICM()

// Устанавливает заголовок кнопки "ОткрытьICM"
//
// Параметры:
//  СообщатьОбРезультате - Булево	 - Признак вывода сообщения с результатом обработки на экран
//
&НаСервере
Процедура ОбновитьДатуICMСервер(VIN, СообщатьОбРезультате = Ложь)

	РезультатПроверки = Renault_АвтосервисСервер.ПолучитьРезультатПоследнейПроверкиICM(VIN);
	Если РезультатПроверки.РезультатЗапроса = Неопределено тогда
		Возврат;
	КонецЕсли;	
	Элементы.ОткрытьICM.Заголовок = "ICM:"+Формат(РезультатПроверки.ДатаВыполнения,"ДФ=dd.MM.yy");
	Если СообщатьОбРезультате тогда
		Если РезультатПроверки.РезультатЗапроса = "Есть отзывные компании" тогда
			Сообщить(РезультатПроверки.ОписаниеOTS);
		Иначе
			Сообщить(РезультатПроверки.РезультатЗапроса);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры // ОбновитьДатуICMСервер()

// Возвращает VIN первого автомобиля клиента, либо предсотавляет выбор автомобиля
//
// Параметры:
//  Первый	 - Булево	 - Вернуть первый автомобиль по коммерческому предложению
// 
// Возвращаемое значение:
//  СправочникСсылка.Автомобили - Автомобиль клиента
//
&НаКлиенте
Функция ВернутьVINПоАвтомобилям(Первый = Ложь)
	
		//hvv DMSREN-715
	//
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_Договор.Ссылка,
	|	ВЫБОР
	|		КОГДА CRM_Договор.СтатусДоговора = &Подписан
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК СортировкаПотипуДоговора,
	|	CRM_Договор.VIN
	|ИЗ
	|	Документ.Renault_Договор КАК CRM_Договор
	|ГДЕ
	|	CRM_Договор.РабочийЛист = &IDK
	|	И НЕ CRM_Договор.ПометкаУдаления
	|	И (CRM_Договор.СтатусДоговора = &Подписан
	|			ИЛИ CRM_Договор.СтатусДоговора = &НаОформление
	|			ИЛИ CRM_Договор.СтатусДоговора = &Черновик
	|			ИЛИ CRM_Договор.СтатусДоговора = &Оформлен)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СортировкаПотипуДоговора,
	|	CRM_Договор.Дата УБЫВ";
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	Запрос.УстановитьПараметр("Подписан", перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан);
	Запрос.УстановитьПараметр("НаОформление", перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.НаОформление);
	Запрос.УстановитьПараметр("Черновик", перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик); 
	Запрос.УстановитьПараметр("Оформлен", перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Оформлен);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() Цикл
		Если НЕ Пустаястрока(выборка.VIN) Тогда
			Возврат выборка.VIN;
		Иначе
			продолжить;
		КонецЕсли;
	КонецЦикла;
	
	//
	
	МассивКонфигураций = ПолучитьКонфигурацииАвтомобилейРабочегоЛиста();
	
	Если МассивКонфигураций <> Неопределено Тогда
	
		Если МассивКонфигураций.Количество() > 1 Тогда
			
			Если Первый тогда
				КонфигурацияОбъект = МассивКонфигураций[0];
			Иначе	
				СписокКонфигураций = Новый СписокЗначений;
				СписокКонфигураций.ЗагрузитьЗначения(МассивКонфигураций);
				Ответ = СписокКонфигураций.ВыбратьЭлемент("В коммерческом предложении более одного автомобиля. Выберите подходящий.");
				Если ЗначениеЗаполнено(Ответ) Тогда
					КонфигурацияОбъект = Ответ.Значение;
				Иначе
					КонфигурацияОбъект = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			КонфигурацияОбъект = МассивКонфигураций[0];
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КонфигурацияОбъект.VIN) тогда
			Возврат КонфигурацияОбъект.VIN;
		Иначе	
			Возврат ?(ЗначениеЗаполнено(КонфигурацияОбъект.Автомобиль), КонфигурацияОбъект.Автомобиль.VIN, Объект.VINАвтомобилей)
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции // ВернутьVINПоАвтомобилям()

// Возвращает массив конфигураций автомобилей рабочего листа
// 
// Возвращаемое значение:
//  Массив - массив конфигураций автомобилей рабочего листа
//
&НаСервере
Функция ПолучитьКонфигурацииАвтомобилейРабочегоЛиста()
	
