КонецПроцедуры // ОбновитьДоступностьПолей()

// Блокирует рабочий лист для редактирования
//
&НаСервере
Процедура ЗаблокироватьРЛ() Экспорт
	
	ТолькоПросмотр = Истина;
	Элементы.ТаблицаКП.Доступность = Ложь;
	МассивИменБезБлока = Новый Массив();
	МассивИменБезБлока.Добавить("СводныйОтчет");
	МассивИменБезБлока.Добавить("Закрыть");
	//МассивИменБезБлока.Добавить("ОбновитьКоммерческиеПредложения");
	МассивИменБезБлока.Добавить("ОбновитьСписокСобытий");
	МассивИменБезБлока.Добавить("ТаблоКоментарии");     
    //МассивИменБезБлока.Добавить("ДиалогКомментария");
	//МассивИменБезБлока.Добавить("ВводКомментарияОК");
	//МассивИменБезБлока.Добавить("ВводКомментарияОтмена");
	
	Для Каждого ТекущийЭлемент Из Элементы Цикл
		
		Если ТипЗнч(ТекущийЭлемент) = Тип("КнопкаФормы") Тогда
			Если МассивИменБезБлока.Найти(ТекущийЭлемент.Имя)= Неопределено Тогда
				ТекущийЭлемент.Доступность = Ложь;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ТаблицаФормы")Тогда
			Если МассивИменБезБлока.Найти(ТекущийЭлемент.Имя)= Неопределено Тогда
				ТекущийЭлемент.Доступность = Ложь;
			КонецЕсли;
	    ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ПолеТабличногоДокументаФормы")Тогда
			Если МассивИменБезБлока.Найти(ТекущийЭлемент.Имя)= Неопределено Тогда
				ТекущийЭлемент.Доступность = Ложь;
			КонецЕсли;
        ИначеЕсли ТипЗнч(ТекущийЭлемент) = Тип("ПолеВводаФормы")Тогда
			Если МассивИменБезБлока.Найти(ТекущийЭлемент.Имя)= Неопределено Тогда
				ТекущийЭлемент.Доступность = Ложь;
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗаблокироватьРЛ()

// Заполняет реквизиты формы, связанные с клиентом
//
&НаСервере
Процедура ОбновитьСтатусКорпКлиента()
	
	ЕстьПравоКорпПродажи = Renault_РаботаСПравамиПользователя.ЕстьПравоКорпПродажи(ПараметрыСеанса.Пользователь);
	
	Если Не ЕстьПравоКорпПродажи Тогда
		Элементы.ГруппаОсновнаяИнформацияШапкаЛевая.Видимость = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Клиент) И Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
		
		ИНН = Объект.Клиент.ИНН;		
		
		Если Не ЗначениеЗаполнено(Клиент_КорпоративныйКонтЛицоФИО) Тогда 			
			Клиент_КорпоративныйКонтЛицо = Справочники.Контрагенты.НайтиПоРеквизиту("ВедушийКонтрагент", Объект.Клиент);
			Клиент_КорпоративныйКонтЛицоФИО = Клиент_КорпоративныйКонтЛицо.Наименование;	
		КонецЕсли;
		
	КонецЕсли;    
	
	Если Не ЗначениеЗаполнено(Объект.Клиент) ИЛИ (ТипЗнч(Объект.Клиент) <> Тип("СправочникСсылка.Контрагенты")) Тогда
		КорпКлиентСтатус = "Не создан";
		Элементы.КОРП.Видимость = Ложь;
		Элементы.ГруппаСтраницаКОРППотенциальныйКлиент.Видимость = Истина;
		Элементы.ГруппаСтраницаКОРПКлиент.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Элементы.КОРП.Видимость = Истина;
	Элементы.ГруппаСтраницаКОРППотенциальныйКлиент.Видимость = Ложь;
	Элементы.ГруппаСтраницаКОРПКлиент.Видимость = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_КорпоративныеКлиенты.Ссылка
	|ИЗ
	|	Справочник.Renault_КорпоративныеКлиенты КАК Renault_КорпоративныеКлиенты
	|ГДЕ
	|	Renault_КорпоративныеКлиенты.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", Объект.Клиент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		// Если корп клиент не найден, то создадим его по корреспонденту.
		// Делается для всех корреспондентов, т.к. физ. лицо тоже может претендовать на корпоративную скидку.
		КорпКлиентОбъект = Справочники.Renault_КорпоративныеКлиенты.СоздатьЭлемент();
		КорпКлиентОбъект.Наименование = RenaultFlotte_ОтправкаЗагрузкаКлиентов.ПривестиНаименованиеВТребуемыйВид(Объект.Клиент.Наименование);
		КорпКлиентОбъект.Контрагент = Объект.Клиент;
		КорпКлиентОбъект.Менеджер = Объект.Сотрудник;
		КорпКлиентОбъект.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.Черновик;
		КорпКлиентОбъект.Автор = Объект.Сотрудник;
		КорпКлиентОбъект.ИдЗаявки = Новый УникальныйИдентификатор();		
		Если ЗначениеЗаполнено(Клиент_СфераДеятельности) Тогда
			СтрокаСфераДеятельности  = КорпКлиентОбъект.СферыДеятельности.Добавить(); 
			СтрокаСфераДеятельности.СфераДеятельности = Клиент_СфераДеятельности;
		КонецЕсли;			
		Если ЗначениеЗаполнено(Клиент_АвтопаркМарка) Тогда
			СтрокаАвтопарк            = КорпКлиентОбъект.Автопарк.Добавить();
			СтрокаАвтопарк.Марка      = Клиент_АвтопаркМарка;
			СтрокаАвтопарк.Модель     = Клиент_АвтопаркМодель;
            СтрокаАвтопарк.Количество = Клиент_АвтопаркКоличество;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Клиент_КорпоративныйКонтЛицо) Тогда
			СохранитьДанныеКонтактногоЛица();
        КонецЕсли;			
		КорпКлиентОбъект.Записать();
		КорпКлиент = КорпКлиентОбъект.Ссылка;
		КорпКлиентСтатус = Строка(КорпКлиент.Состояние);
	Иначе
		КорпКлиент = Выборка.Ссылка;
		КорпКлиентСтатус = Строка(КорпКлиент.Состояние);
		Если КорпКлиент.СферыДеятельности.Количество()>0 Тогда
			Клиент_СфераДеятельности  = КорпКлиент.СферыДеятельности[0].СфераДеятельности; 
		КонецЕсли;
		
		Если КорпКлиент.Автопарк.Количество() > 0 Тогда
			Клиент_АвтопаркМарка      = КорпКлиент.Автопарк[0].Марка;
			Клиент_АвтопаркМодель     = КорпКлиент.Автопарк[0].Модель;
			Клиент_АвтопаркКоличество = КорпКлиент.Автопарк[0].Количество;
		КонецЕсли;		
	КонецЕсли;
	
	Элементы.ОтправитьНаСогласование.Доступность = Истина;
	Элементы.ПерейтиКЗаявкамНаСкидки.Доступность = Истина;
	Если КорпКлиент.Состояние <> Перечисления.Renault_СостоянияСогласованияКлиента.Черновик Тогда
		Элементы.ОтправитьНаСогласование.Доступность = Ложь;
	КонецЕсли;
	Если КорпКлиент.Состояние <> Перечисления.Renault_СостоянияСогласованияКлиента.Согласован Тогда
		Элементы.ПерейтиКЗаявкамНаСкидки.Доступность = Ложь;
	КонецЕсли;

	ОбновитьКнопкиТипКлиента();
	
КонецПроцедуры //ОбновитьСтатусКорпКлиента()

// Создает элемент справочника "Контрагенты" или "CRM_ПотенциальныеКонтрагенты"
//
&НаСервере
Процедура СохранитьДанныеКонтактногоЛица()

	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(Клиент_КорпоративныйКонтЛицоФИО) Тогда		

		НовыйЭлемент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйЭлемент.УстановитьНовыйКод();
		НовыйЭлемент.ВидКонтрагента     = Перечисления.ВидыКонтрагентов.КонтактноеЛицо;
		НовыйЭлемент.ВедушийКонтрагент  = Объект.Клиент;
		НовыйЭлемент.ВидОтношений       = Справочники.ВидыВзаимоотношений.КонтактноеЛицо;
		НовыйЭлемент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
		НовыйЭлемент.НаименованиеПолное = Клиент_КорпоративныйКонтЛицоФИО;
		НовыйЭлемент.СогласиеНаОбработкуПерсональныхДанных     = Перечисления.ВариантыОтветов.Спрашивать;
		НовыйЭлемент.Наименование       = Клиент_КорпоративныйКонтЛицоФИО;
		CRM_Сервер.РазбитьФИО(Клиент_КорпоративныйКонтЛицоФИО, НовыйЭлемент.Фамилия, НовыйЭлемент.Имя, НовыйЭлемент.Отчество);
		НовыйЭлемент.Записать();
		
		Клиент_КорпоративныйКонтЛицо = НовыйЭлемент.Ссылка;
		
	КонецЕсли;        

	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") И ЗначениеЗаполнено(Клиент_КорпоративныйКонтЛицоФИО) Тогда		

		НовыйЭлемент = Справочники.CRM_ПотенциальныеКонтрагенты.СоздатьЭлемент();
		НовыйЭлемент.УстановитьНовыйКод();
		НовыйЭлемент.ВидКонтрагента     = Перечисления.ВидыКонтрагентов.КонтактноеЛицо;
		НовыйЭлемент.Renault_ВедушийКонтрагент  	= Объект.Клиент;
		НовыйЭлемент.ВидОтношений       = Справочники.ВидыВзаимоотношений.КонтактноеЛицо;
		НовыйЭлемент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо;
		НовыйЭлемент.НаименованиеПолное = Клиент_КорпоративныйКонтЛицоФИО;
		НовыйЭлемент.СогласиеНаОбработкуПерсональныхДанных     = Перечисления.ВариантыОтветов.Спрашивать;
		НовыйЭлемент.Наименование       = Клиент_КорпоративныйКонтЛицоФИО;
		CRM_Сервер.РазбитьФИО(Клиент_КорпоративныйКонтЛицоФИО, НовыйЭлемент.Фамилия, НовыйЭлемент.Имя, НовыйЭлемент.Отчество);
		НовыйЭлемент.Записать();
		
		Клиент_КорпоративныйКонтЛицо = НовыйЭлемент.Ссылка;
		
	КонецЕсли;

КонецПроцедуры // СохранитьДанныеКонтактногоЛица()

// Управляет видимостью и оформлением кнопок в зависимости от типа клиента
//
&НаСервере
Процедура ОбновитьКнопкиТипКлиента()
	
	Если Не ЗначениеЗаполнено(Объект.ТипКлиента) Тогда
		Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.РозничныйКлиент;
	КонецЕсли;
	
	ДанныеКорпКлиента = ПолучитьИдентификаторКорпКлиента();  
	Если ДанныеКорпКлиента <> Неопределено Тогда
		КорпКлиент = ДанныеКорпКлиента.КорпКлиент;
		ИдентификаторКорпКлиента = ДанныеКорпКлиента.ИдентификаторКорпКлиента;
	Иначе
		КорпКлиент = "";
		ИдентификаторКорпКлиента = "";
	КонецЕсли;
		
	Если Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.РозничныйКлиент Тогда
		Элементы.РозничныйКлиент.ЦветФона = ЦветРено;		
		Элементы.КорпоративныйКлиент.ЦветФона = ЦветRenault1;
		Элементы.КОРП.Видимость = Ложь;
		Элементы.ГруппаСтраницыКлиента.ТекущаяСтраница = Элементы.ГруппаСтраницаКлиент;
		
		Элементы.НадписьДанныеКорпКлиентаЗаполнены.Заголовок = "";
		Элементы.НадписьДанныеКорпКлиентаЗаполнены.Видимость = Ложь;
		
		Элементы.Кредит.Видимость 	= Истина;
		Элементы.Кредит.Доступность = Истина;
		Элементы.Лизинг.Видимость 	= Ложь;
		Элементы.Лизинг.Доступность = Ложь;
		
	ИначеЕсли Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
		
		Если ЗначениеЗаполнено(КорпКлиент) Тогда
			ДанныеЗаполнены = ДанныеКорпКлиентаЗаполнены(КорпКлиент); 
			Если ДанныеЗаполнены Тогда
				ЗаголовокНадписьДанныеКорпКлиентаЗаполнены = "Все обязательные поля корп.клиента заполнены";
			Иначе
				ЗаголовокНадписьДанныеКорпКлиентаЗаполнены = "Не все обязательные поля корп.клиента заполнены";
			КонецЕсли;
		Иначе
			ДанныеЗаполнены = Ложь;
			ЗаголовокНадписьДанныеКорпКлиентаЗаполнены = "Корп.клиент не зарегестрирован";
		КонецЕсли;
		
		Элементы.РозничныйКлиент.ЦветФона = ЦветRenault1;
		Элементы.КорпоративныйКлиент.ЦветФона = ЦветРено;		
		Элементы.КОРП.Видимость = Истина;
		Элементы.ГруппаСтраницыКлиента.ТекущаяСтраница = Элементы.ГруппаСтраницаКорпоративныйКлиент;
		
		Элементы.НадписьДанныеКорпКлиентаЗаполнены.Заголовок = ЗаголовокНадписьДанныеКорпКлиентаЗаполнены;
		Элементы.НадписьДанныеКорпКлиентаЗаполнены.Видимость = Истина;
		
		Элементы.Кредит.Видимость 	= Ложь;
		Элементы.Кредит.Доступность = Ложь;
		Элементы.Лизинг.Видимость 	= Истина;
		Элементы.Лизинг.Доступность = Истина;
		
	КонецЕсли;
	
	Воронка_ОбновитьMYRenault();
	Воронка_ОбновитьРегистрациюКлиентаВБазеРеноРоссия();

	//ПодвинутьКнопки();
	
КонецПроцедуры // ОбновитьКнопкиТипКлиента()

// Проверяет заполненность необходимых данных у корпоративного клиента
//
// Параметры:
//  СсылкаКорпКлиент - СправочникСсылка.Контрагенты	 - Ссылка на корпоративного клиента
// 
// Возвращаемое значение:
//  Булево - Признак того, что необходимые данные по клиенту заполнены
//
&НаСервере
Функция ДанныеКорпКлиентаЗаполнены(СсылкаКорпКлиент)
	
	ДанныеЗаполнены = Ложь;
	
	ОбъектКорпКлиент = СсылкаКорпКлиент.ПолучитьОбъект();
	
	ОбъектКорпКлиент.ПроверитьДанныеДляСогласования(ДанныеЗаполнены, СсылкаКорпКлиент.Контрагент);
	
	ДанныеЗаполнены = НЕ ДанныеЗаполнены;
	
	Если Не ЗначениеЗаполнено(СсылкаКорпКлиент.Контрагент.ИНН) Тогда
		Сообщить("Не заполнен ИНН.");
		ДанныеЗаполнены = Ложь;
	КонецЕсли;
	
	Возврат ДанныеЗаполнены;
	
КонецФункции // ДанныеКорпКлиентаЗаполнены()

