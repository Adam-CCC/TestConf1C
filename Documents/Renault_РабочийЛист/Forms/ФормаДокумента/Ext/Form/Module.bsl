// Создает событие тест-драйва по рабочему листу
//
&НаКлиенте
Процедура СоздатьЗаписьНаТестДрайв()
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Новый автомобиль", "Новый автомобиль");
	СписокВыбора.Добавить("Автомобиль с пробегом", "Автомобиль с пробегом");
	ФормаВыбора = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
	ФормаВыбора.СписокВыбора = СписокВыбора;
	ФормаВыбора.Заголовок = "Выбор типа тест драйва";
	Ответ = ФормаВыбора.ОткрытьМодально();
	
	Если Ответ <> Неопределено Тогда
		//Откроем форму создания события
		СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
		СобытиеОбъект.IDK = Объект.IDK;
		СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ТестДрайв;
		СобытиеОбъект.Сотрудник = Объект.Сотрудник;
		СобытиеОбъект.Отдел = Объект.Отдел;
		СобытиеОбъект.ДилерскийЦентр = Объект.ДилерскийЦентр;
		СобытиеОбъект.Подразделение = Объект.Подразделение;					
		ФормаСобытия = СобытиеОбъект.ПолучитьФорму("ФормаСозданияСобытия");
		ФормаСобытия.БУАвтомобиль = ?(Ответ = Неопределено или Ответ = "Новый автомобиль", Ложь, Истина);
		ФормаСобытия.Открыть();
	КонецЕсли;
	
КонецПроцедуры // СоздатьЗаписьНаТестДрайв()

// Синхронизация тест-драйвов с планшетом
//
&НаКлиенте
Процедура СинхронизироватьПланшетТД()
	
	Возврат;
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Потенциальный = Справочники.CRM_ПотенциальныеКонтрагенты.НайтиПоРеквизиту("Контрагент", Объект.Клиент);
		Ответ = Renault_РаботаСSalesTablet.ПолучитьДанныеПоТестДрайвам(Объект.Клиент);
		РазобратьДанныеПоТДИзПланшета(Ответ);
		Ответ = Renault_РаботаСSalesTablet.ПолучитьДанныеПоТестДрайвам(Потенциальный);
		РазобратьДанныеПоТДИзПланшета(Ответ);
	Иначе
		Ответ = Renault_РаботаСSalesTablet.ПолучитьДанныеПоТестДрайвам(Объект.Клиент);
		РазобратьДанныеПоТДИзПланшета(Ответ);
	КонецЕсли;
	
КонецПроцедуры // СинхронизироватьПланшетТД()

// Записывает данные по тест-драйвам из планшета в базу
//
// Параметры:
//  ТабДанных	 - ТаблицаЗначений	 - Данные по тест-драйвам из планшета
//
&НаКлиенте
Процедура РазобратьДанныеПоТДИзПланшета(ТабДанных)
	
	Возврат;
	
	Если ТипЗнч(ТабДанных)<>Тип("ТаблицаЗначений") Тогда Возврат; КонецЕсли;
	
	Для Каждого Данные из ТабДанных Цикл
		
		СсылкаТД = Документы.CRM_ЗаписьНаТестДрайв.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Id));
		ЕстьДокумент = (СсылкаТД.ПолучитьОбъект() <> Неопределено);
		
		Если НЕ ЕстьДокумент Тогда
			//Создаем запись на ТД
			ДокТестДрайв = Документы.CRM_ЗаписьНаТестДрайв.СоздатьДокумент();
			ДокТестДрайв.УстановитьСсылкуНового(СсылкаТД);
		Иначе
			ДокТестДрайв = СсылкаТД.ПолучитьОбъект();
		КонецЕсли;
		
		ДокТестДрайв.Дата = ТекущаяДата();
		ДокТестДрайв.ДатаПроведения = Данные.Date;
		ДокТестДрайв.Клиент = Объект.Клиент;
		ДокТестДрайв.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Автомобиль = НайтиАвтомобильДляТестДрайва(Объект.ДилерскийЦентр, Данные.Model,Данные.Version);
		Если Автомобиль.Пустая() Тогда
			Сообщить("Не найден автомбиль для тест-драйва по артикулу модели "+ Данные.Model+". Тест-драйв не будет загружен!");
			Продолжить;
		КонецЕсли;	
		ДокТестДрайв.Автомобиль = Автомобиль;
		ДокТестДрайв.Менеджер = Объект.Сотрудник;
		ДокТестДрайв.Отдел = Объект.Отдел;
		ДокТестДрайв.Подразделение = Объект.Подразделение;
		ДокТестДрайв.РабочийЛист = Объект.IDK;
		ДокТестДрайв.СтатусДокумента = Перечисления.CRM_СтатусыТестДрайва.Получить(Данные.TestDriveStatus);
		Если ДокТестДрайв.СтатусДокумента = Перечисления.CRM_СтатусыТестДрайва.Завершено или ДокТестДрайв.СтатусДокумента = Перечисления.CRM_СтатусыТестДрайва.ЗавершеноДосрочно Тогда
			Оценки = Renault_РаботаСSalesTablet.ПолучитьДанныеПоОценкамТестДрайва(Данные.Id);	
			Для Каждого стр из Оценки Цикл
				Показатель = Справочники.CRM_ПлановыеРезультатыКонтактов.НайтиПоНаименованию(стр.Title,Истина);
				Если НЕ ЗначениеЗаполнено(Показатель) Тогда
					ПоказательЭлемент = Справочники.CRM_ПлановыеРезультатыКонтактов.СоздатьЭлемент();
					ПоказательЭлемент.Наименование = стр.Title;
					ПоказательЭлемент.Записать();
					Показатель = ПоказательЭлемент.Ссылка;				
				КонецЕсли;  				
				стрДок = ДокТестДрайв.КодыКомментариев.Найти(Показатель,"Показатель");
				Если стрДок = Неопределено Тогда
					стрДок = ДокТестДрайв.КодыКомментариев.Добавить();	
				КонецЕсли;
				стрДок.Показатель = Показатель;
				стрДок.Оценка =  стр.Mark;
			КонецЦикла;
		КонецЕсли;
		
		ДокТестДрайв.ВыдатьНапоминание = Ложь;
		ДокТестДрайв.ТипТестДрайва = Перечисления.CRM_ТипыТестДрайвов.ЧастноеЛицо;
		ДокТестДрайв.Продолжительность = Объект.ДилерскийЦентр.Продажи_ПродолжительностьТестДрайва;
		ДокТестДрайв.Начало = Данные.Date;
		ДокТестДрайв.Записать(РежимЗаписиДокумента.Проведение);
		
		Если НЕ ЕстьДокумент Тогда
			СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
			СобытиеОбъект.Дата = ТекущаяДата();
			СобытиеОбъект.IDK = Объект.IDK;
			СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ТестДрайв;
			СобытиеОбъект.Сотрудник = Объект.Сотрудник;
			СобытиеОбъект.Отдел = Объект.Отдел;
			СобытиеОбъект.ДилерскийЦентр = Объект.ДилерскийЦентр;
			СобытиеОбъект.Подразделение = Объект.Подразделение;
			СобытиеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
			СобытиеОбъект.Объект = ДокТестДрайв.Ссылка;
			СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // РазобратьДанныеПоТДИзПланшета()

&НаКлиенте
Функция НайтиАвтомобильДляТестДрайва(ДилерскийЦентр, Модель, Версия)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_ДилерскиеЦентрыАвтомобилиТестДрайв.Автомобиль
	|ИЗ
	|	Справочник.CRM_ДилерскиеЦентры.АвтомобилиТестДрайв КАК CRM_ДилерскиеЦентрыАвтомобилиТестДрайв
	|ГДЕ
	|	CRM_ДилерскиеЦентрыАвтомобилиТестДрайв.Ссылка = &ДилерскийЦентр
	|	И ПОДСТРОКА(CRM_ДилерскиеЦентрыАвтомобилиТестДрайв.Автомобиль.Модель.Артикул,1,3) = ПОДСТРОКА(&Модель,1,3)
	|	И CRM_ДилерскиеЦентрыАвтомобилиТестДрайв.Автомобиль.ВариантКомплектации.Артикул = &Версия";
	
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	//Ищем по модели и версии
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Автомобиль;
	Иначе //не нашли, тогда ищем только по модели
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И CRM_ДилерскиеЦентрыАвтомобилиТестДрайв.Автомобиль.ВариантКомплектации.Артикул = &Версия","");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Автомобиль;  
		Иначе
			Возврат Справочники.Автомобили.ПустаяСсылка();		
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.Автомобили.ПустаяСсылка();	
	
КонецФункции // НайтиАвтомобильДляТестДрайва()

// Синхронизирует данные по коммерческим предложениям с планшетом
//
&НаКлиенте
Процедура СинхронизироватьПланшетКП()
	
	Возврат;
	
	Ответ = Renault_РаботаСSalesTablet.ПолучитьДанныеПоКоммерческимПредложениям(Объект.IDТрафика);
	
	Если ТипЗнч(Ответ)<>Тип("ТаблицаЗначений") ИЛИ Ответ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийТариф = Renault_CRM.ПолучитьТекущийТарифНаАвтомобили();
	ТекДилерскийЦентр = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	ТипЦенКП = Renault_РаботаСПравамиПользователя.ПолучитьТипЦенКП(ТекДилерскийЦентр); 
	
	Для Каждого СтрокаОтвета ИЗ Ответ Цикл
		
		ИДПредложения = Сред(СтрокаОтвета.ID, 2, СтрДлина(СтрокаОтвета.ID)-2);
		СсылкаВБазе = Документы.CRM_КоммерческоеПредложение.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДПредложения));
		Если СсылкаВБазе.ПолучитьОбъект() <> Неопределено  Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОпции = СтрокаОтвета.Options;
		СтрокаАксессуары = СтрокаОтвета.Accessories;
		СтрокаДопОпции = СтрокаОтвета.AdditionalOptions;
		МодельАртикул = СтрокаОтвета.Vehicle;
		МодельВКомПредложение = Справочники.Модели.НайтиПоРеквизиту("Артикул", МодельАртикул);
		Если НЕ ЗначениеЗаполнено(МодельВКомПредложение) Тогда
			Возврат;
		КонецЕсли;
		КомплектацияАртикул = СтрокаОтвета.Version;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВариантыКомплектации.Ссылка
		|ИЗ
		|	Справочник.ВариантыКомплектации КАК ВариантыКомплектации
		|ГДЕ
		|	ВариантыКомплектации.Артикул = &Артикул
		|	И ВариантыКомплектации.Владелец = &Владелец";
		Запрос.УстановитьПараметр("Артикул", КомплектацияАртикул);
		Запрос.УстановитьПараметр("Владелец", МодельВКомПредложение);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			КомПредложение = Документы.CRM_КоммерческоеПредложение.СоздатьДокумент();
			Идентификатор = Сред(СтрокаОтвета.ID, 2, СтрДлина(СтрокаОтвета.ID)-2);
			НоваяСсылка = Документы.CRM_КоммерческоеПредложение.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			КомПредложение.УстановитьСсылкуНового(НоваяСсылка);
			КомПредложение.Автор = ПараметрыСеанса.Пользователь;
			КомПредложение.Дата = ТекущаяДата();
			КомПредложение.ДилерскийЦентр = Объект.ДилерскийЦентр;
			КомПредложение.Клиент = Объект.Клиент;
			КомПредложение.РабочийЛист = Объект.IDK;
			СоставПредложения = КомПредложение.Состав.Добавить();
			НоваяКонфигурация = Справочники.CRM_КонфигурацииАвтомобилей.СоздатьЭлемент();
			НоваяКонфигурация.Наименование = "" + МодельВКомПредложение.Наименование + " " + Выборка.Ссылка.Наименование;
			НоваяКонфигурация.РабочийЛист = Объект.IDK;
			НоваяКонфигурация.Комментарий = "Загружено из планшета продавца";
			
			//нет времени объяснять!!! делаем через попытку,  т.к., если в таблице NULL, то приходит пустая дата.
			Попытка				
					НоваяКонфигурация.Автомобиль = Справочники.Автомобили.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаОтвета.VehicleInStockId));					
			Исключение	
					
			КонецПопытки;		
				
			Если ЗначениеЗаполнено(НоваяКонфигурация.Автомобиль) Тогда
				ЗаполнитьЗначенияСвойств(НоваяКонфигурация,НоваяКонфигурация.Автомобиль,,"Наименование,Родитель,Владелец");
				НоваяКонфигурация.Версия = НоваяКонфигурация.Автомобиль.ВариантКомплектации;
			Иначе
				НоваяКонфигурация.Модель = МодельВКомПредложение;
				НоваяКонфигурация.Цвет = Справочники.Цвета.НайтиПоРеквизиту("Артикул",СокрЛП(СтрокаОтвета.ColorId));
				НоваяКонфигурация.Версия = Выборка.Ссылка;
			КонецЕсли;
			
			// Опции
			Если СтрокаОпции <> "" Тогда
				МассивОпций = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(СтрокаОпции, ",");
				Для Каждого СтрокаОпция ИЗ МассивОпций Цикл
					ОпцияСсылка = Справочники.Опции.НайтиПоРеквизиту("Артикул", Сред(СтрокаОпция, 2, СтрДлина(СтрокаОпция)-2));
					Если ЗначениеЗаполнено(ОпцияСсылка) Тогда
						НоваяОпцияВКонфигурации = НоваяКонфигурация.Опции.Добавить();
						НоваяОпцияВКонфигурации.Опция = ОпцияСсылка;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			// Аксессуары и оборудование
			Если СтрокаАксессуары <> "" Тогда
				КомПредложение.ИнтересовалсяОборудованием = Истина;
				МассивАксессуаров = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(СтрокаАксессуары, ",");
				Для Каждого СтрокаАксессуар ИЗ МассивАксессуаров Цикл
					
					АксессуарСтрока = СокрЛП(Сред(СтрокаАксессуар, 2, СтрДлина(СтрокаАксессуар)-2));
					Если АксессуарСтрока <> "" Тогда
						Артикул = "";
						Название = "";
						Цена = 0;
						Сумма = 0;
						МассивОписаниеАксессуара = CRM_Сервер.РазложитьСтрокуВМассивПодстрок(АксессуарСтрока, "&&");
						Если МассивОписаниеАксессуара.Количество()>=1 Тогда
							Артикул = МассивОписаниеАксессуара.получить(0);
						КонецЕсли;
						
						Если МассивОписаниеАксессуара.Количество()>=2 Тогда						
							Название = МассивОписаниеАксессуара.получить(1);
						КонецЕсли;
						
						Если МассивОписаниеАксессуара.Количество()>=3 Тогда						
							Цена = Число(МассивОписаниеАксессуара.получить(2));
							Сумма = Цена;
						КонецЕсли;
						
						АксессуарСсылка = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
						Если ЗначениеЗаполнено(АксессуарСсылка) Тогда
							НовыйАксессуарВКонфигурации = НоваяКонфигурация.Оборудование.Добавить();
							НовыйАксессуарВКонфигурации.Номенклатура = АксессуарСсылка;
							НовыйАксессуарВКонфигурации.Количество = 1;
							НовыйАксессуарВКонфигурации.Цена = Цена;
							НовыйАксессуарВКонфигурации.Сумма = Сумма;
						Иначе
							АксессуарСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Название);
							Если ЗначениеЗаполнено(АксессуарСсылка) Тогда
								НовыйАксессуарВКонфигурации = НоваяКонфигурация.Оборудование.Добавить();
								НовыйАксессуарВКонфигурации.Номенклатура = АксессуарСсылка;
								НовыйАксессуарВКонфигурации.Количество = 1;
								НовыйАксессуарВКонфигурации.Цена = Цена;
								НовыйАксессуарВКонфигурации.Сумма = Сумма;
							Иначе
								НовыйАксессуарВКонфигурации = НоваяКонфигурация.Оборудование.Добавить();
								НовыйАксессуарВКонфигурации.Номенклатура = Название;
								НовыйАксессуарВКонфигурации.Количество = 1;
								НовыйАксессуарВКонфигурации.Цена = Цена;
								НовыйАксессуарВКонфигурации.Сумма = Сумма;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				НоваяКонфигурация.Оборудование.Свернуть("Номенклатура,Цена,Количество,Сумма");
			КонецЕсли;
			
			//Заполним суммы
			ЦенаВариантаКомплектации = 0;
			
			Если НовыйАвтомобиль = 1 Тогда
				
				Запрос = Новый Запрос;
				
				Запрос.УстановитьПараметр("VIN", НоваяКонфигурация.VIN);
				
				Запрос.Текст =
				"ВЫБРАТЬ
				|	CRM_СостояниеАвтомобилейПроизводителя_v2.ЦенаПродажиБаза
				|ИЗ
				|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
				|ГДЕ
				|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN = &VIN";
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					ЦенаВариантаКомплектации = Выборка.ЦенаПродажиБаза;
				Иначе
					ЦенаВариантаКомплектации = 0;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЦенаВариантаКомплектации = 0 Тогда
				
				Запрос = Новый Запрос;
				
				Запрос.УстановитьПараметр("Модель", НоваяКонфигурация.Модель);
				Запрос.УстановитьПараметр("ВариантКомплектации", НоваяКонфигурация.Версия);
				Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
				
				Запрос.Текст =
				"ВЫБРАТЬ
				|	Renault_ТарифНаКомплектацииАвтомобилей.ЦенаКлиентская
				|ИЗ
				|	РегистрСведений.Renault_ТарифНаКомплектацииАвтомобилей.СрезПоследних(, Тариф = &Тариф) КАК Renault_ТарифНаКомплектацииАвтомобилей
				|ГДЕ
				|	Renault_ТарифНаКомплектацииАвтомобилей.Модель = &Модель
				|	И Renault_ТарифНаКомплектацииАвтомобилей.ВариантКомплектации = &ВариантКомплектации";
				Выборка = Запрос.Выполнить().Выбрать();
				
				Если Выборка.Следующий() Тогда
					ЦенаВариантаКомплектации = Выборка.ЦенаКлиентская;
				Иначе
					ЦенаВариантаКомплектации = 0;
				КонецЕсли;
				
			КонецЕсли;
			
			НоваяКонфигурация.ЦенаВерсии = ЦенаВариантаКомплектации;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Опции.Опция
			|ПОМЕСТИТЬ ВТ_Опции
			|ИЗ
			|	&Опции КАК Опции
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Опции.Опция КАК Опция,
			|	ЕСТЬNULL(Renault_ТарифНаОпцииАвтомобилейСрезПоследних.ЦенаКлиентская, 0) КАК Цена
			|ИЗ
			|	ВТ_Опции КАК ВТ_Опции
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних(
			|				,
			|				Модель = &Модель
			|					И Тариф = &Тариф
			|					И ВариантКомплектации = &Комплектация
			|					И Базовая = ЛОЖЬ) КАК Renault_ТарифНаОпцииАвтомобилейСрезПоследних
			|		ПО ВТ_Опции.Опция = Renault_ТарифНаОпцииАвтомобилейСрезПоследних.Опция";
			
			Запрос.УстановитьПараметр("Опции", НоваяКонфигурация.Опции.Выгрузить());
			Запрос.УстановитьПараметр("Комплектация", НоваяКонфигурация.Версия);
			Запрос.УстановитьПараметр("Модель", НоваяКонфигурация.Модель);
			Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
			НоваяКонфигурация.Опции.Загрузить(Запрос.Выполнить().Выгрузить());
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Аксессуары.Номенклатура,
			|	1 КАК Количество
			|ПОМЕСТИТЬ ВТ_Аксессуары
			|ИЗ
			|	&Аксессуары КАК Аксессуары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Аксессуары.Номенклатура КАК Номенклатура,
			|	ВТ_Аксессуары.Количество КАК Количество,
			|	МАКСИМУМ(ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0)) КАК Цена,
			|	МАКСИМУМ(ВТ_Аксессуары.Количество * ЕСТЬNULL(ЦеныСрезПоследних.Цена, 0)) КАК Сумма
			|ИЗ
			|	ВТ_Аксессуары КАК ВТ_Аксессуары
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(, ТипЦен = &ТипЦенКП) КАК ЦеныСрезПоследних
			|		ПО ВТ_Аксессуары.Номенклатура = ЦеныСрезПоследних.Номенклатура
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_Аксессуары.Номенклатура,
			|	ВТ_Аксессуары.Количество";
			
			Запрос.УстановитьПараметр("Аксессуары", НоваяКонфигурация.Аксессуары.Выгрузить());
			Запрос.УстановитьПараметр("ТипЦенКП", ТипЦенКП);
			
			НоваяКонфигурация.Аксессуары.Загрузить(Запрос.Выполнить().Выгрузить());
			
			СтоимостьДоставки = 0;
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЕСТЬNULL(ЕСТЬNULL(ПоВерсиям.СтоимостьДоставки, ПоМоделям.СтоимостьДоставки), 0) КАК СтоимостьДоставки
			|ИЗ
			|	(ВЫБРАТЬ
			|		Renault_СтоимостьДоставкиАвтомобилей.СтоимостьДоставки КАК СтоимостьДоставки
			|	ИЗ
			|		РегистрСведений.Renault_СтоимостьДоставкиАвтомобилей КАК Renault_СтоимостьДоставкиАвтомобилей
			|	ГДЕ
			|		Renault_СтоимостьДоставкиАвтомобилей.Версия = &Версия) КАК ПоВерсиям
			|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			Renault_СтоимостьДоставкиАвтомобилей.СтоимостьДоставки КАК СтоимостьДоставки
			|		ИЗ
			|			РегистрСведений.Renault_СтоимостьДоставкиАвтомобилей КАК Renault_СтоимостьДоставкиАвтомобилей
			|		ГДЕ
			|			Renault_СтоимостьДоставкиАвтомобилей.Модель = &Модель) КАК ПоМоделям
			|		ПО (ИСТИНА)";


			Запрос.УстановитьПараметр("Версия", НоваяКонфигурация.Версия);
			Запрос.УстановитьПараметр("Модель", НоваяКонфигурация.Модель);

			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СтоимостьДоставки = Выборка.СтоимостьДоставки;
			КонецЕсли;
			Если СтоимостьДоставки = 0 ИЛИ Не ЗначениеЗаполнено(СтоимостьДоставки) Тогда
				СтоимостьДоставки = ТекДилерскийЦентр.СтоимостьДоставкиПоУмолчанию;;
			КонецЕсли;
			
			
			НоваяКонфигурация.СуммаДоставки = СтоимостьДоставки;
			СоставПредложения.СуммаДоставки = СтоимостьДоставки;			
			
			НоваяКонфигурация.Записать();
			
			
			СоставПредложения.Конфигурация = НоваяКонфигурация.Ссылка;
			СоставПредложения.Сумма = НоваяКонфигурация.Опции.Итог("Цена") + НоваяКонфигурация.Аксессуары.Итог("Сумма");
			

			КомПредложение.Сумма = ЦенаВариантаКомплектации+ СоставПредложения.Сумма + СоставПредложения.СуммаДоставки - СоставПредложения.СуммаСкидки;

			КомПредложение.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	КонецЦикла;
	
	Воронка_ОбновитьКоммерческоеПредложение();
	
КонецПроцедуры // СинхронизироватьПланшетКП()

// Открывает форму АРМ "Конфигуратор"
//
// Параметры:
//  ТекущаяСтрока				 - Строка табличного поля	 - Текущая строка табличного поля коммерческих предложений
//  ПоказатьСтраницуОборудования - Булево					 - Признак открытия страницы с доп. оборудованием
//
&НаКлиенте
Процедура ОткрытьФормуКомПредложения(ТекущаяСтрока, ПоказатьСтраницуОборудования = Ложь) 
	
	СсылкаНаКП = ТекущаяСтрока.Ссылка;
	
	ФормаРабочийСтол = Обработки.CRM_АРМ_Конфигуратор.ПолучитьФорму("Форма");
	ФормаРабочийСтол.ТекущийРабочийЛист = Объект.IDK;
	ФормаРабочийСтол.ТекущийКлиент = Объект.Клиент;
	ФормаРабочийСтол.ПоказатьСтраницуОборудования = ПоказатьСтраницуОборудования;
	Если ЗначениеЗаполнено(СсылкаНаКП) Тогда
		ФормаРабочийСтол.ТекущееКП = СсылкаНаКП;
		Если СсылкаНаКП.ТрейдИн Тогда
			ФормаРабочийСтол.ЭтоТрейдИН = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ФормаРабочийСтол.Открыть();
	
КонецПроцедуры // ОткрытьФормуКомПредложения()

// Открывает форму коммерческих предложений и задач
//
// Параметры:
//  ВидЗадачи	 - СправочникСсылка.CRM_ВидыСобытий	 - Вид события
//
&НаКлиенте
Процедура СтраховкаКредит(ВидЗадачи)
	
	//выбор коммерческого предложения
	МассивКП=СписокКП();
	Если МассивКП.Количество()=0 Тогда 
		Предупреждение("Создание заявки возможно только на основе КП"); 
		Возврат;
	Иначе
		спКП=Новый СписокЗначений; спКП.ЗагрузитьЗначения(МассивКП); 
		ОткрытьФорму("Документ.Renault_РабочийЛист.Форма.КПиЗадачи", Новый Структура("спКП,ВидСобытия",спКП,ВидЗадачи) ,ЭтаФорма,ВидЗадачи);
	КонецЕсли;
	
КонецПроцедуры // СтраховкаКредит()

// Создает новый договор по рабочему листу
//
&НаКлиенте
Процедура СоздатьНовыйДоговор()
	
	ЗаписьРЛ = Renault_CRM.докПолучитьЗаписьРЛПоIDK(Объект.IDK);

	ДоговорОбъектНового = Документы.Renault_Договор.СоздатьДокумент();
	ДоговорОбъектНового.Дата = ТекущаяДата();
	ДоговорОбъектНового.ДатаДоговора = ТекущаяДата();	
	ДоговорОбъектНового.РабочийЛист = Объект.IDK;
	ДоговорОбъектНового.СтатусДоговора = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик;
	ДоговорОбъектНового.Клиент = ЗаписьРЛ.Клиент;
	ДоговорОбъектНового.ДилерскийЦентр = Объект.ДилерскийЦентр;
			
	//ДоговорОбъектНового.ПолучитьФорму().Открыть();
	ТекМенеджер = ПараметрыСеанса.Пользователь.Сотрудник;
	ТекОрганизация = ТекМенеджер.Организация;
	Если НЕ (ЗначениеЗаполнено(ТекМенеджер) И ЗначениеЗаполнено(ТекОрганизация)) Тогда
		ПоказатьПредупреждение(, "Для пользователя не задан сотрудник/организация!");
		Возврат;
	КонецЕсли;
	Результат  = ДоговорОбъектНового.ПолучитьФорму().ОткрытьМодально();
	Прочитать();
	//ВазСистем Тарасов 25.12.2020 11:04:10 Инцидент #DMSREN-1051
	//{
	//Старый код:
	//Новый код:
	Если ДоговорОбъектНового.Клиент <> Объект.Клиент Тогда 
		Объект.Клиент = ДоговорОбъектНового.Клиент;
		Модифицированность = Истина;
		Оповестить("ПеречитатьДанныеКлиента");
	КонецЕсли;
	//}

КонецПроцедуры // СоздатьНовыйДоговор()

// Создает событие выдачи
//
// Параметры:
//  VIN	 - Строка	 - VIN автомобиля
//
&НаКлиенте
Процедура СоздатьЗаписьНаВыдачу(VIN="")
	
	Если Элементы.Договоры.ТекущиеДанные = Неопределено Тогда
		Если Договоры.Количество() > 0 Тогда
			СтруктураПоиска = Новый Структура("СтатусДоговора", Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан);
			НайденныеСтроки = Договоры.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				ТекДоговор = НайденныеСтроки[0];
			Иначе
				ТекДоговор = Неопределено;
			КонецЕсли;
			Если ТекДоговор = Неопределено Тогда
				ТекДоговор = Договоры[0];
			КонецЕсли;
		Иначе
			Сообщить("Отсутствует договор, выдача невозможна");
			Возврат;
		КонецЕсли;
	Иначе
		ТекДоговор = Элементы.Договоры.ТекущиеДанные;	
	КонецЕсли;
	
	МассивVINПоДоговору = ТекДоговор.Ссылка.СоставДоговора.ВыгрузитьКолонку("VIN");
	
	// ++ начало Давыдов А. 2020-04-30
	// DMSREN-678 - сделаем проверку на повторную выдачу авто. По-хорошему, надо вычищать повторные проверки.
	// но тогда много где много чего найдется переделывать. Поэтому, просто вставлю свою проверку.
	// Рекомендуется использовать ее.
	
	//пока закоментим проверку по задаче DMSREN-847 
	//ТекстСообщения = ""; Элементы.Выдачи.ТекущаяСтрока
	//Если CRM_Сервер.ЕстьВыданныеАвтомобили(Объект.IDK, МассивVINПоДоговору, Истина, ТекстСообщения) Тогда
	//	Сообщить("По данному договору рабочего листа уже имеется запланированная или завершенная выдача. Список VIN:" + Символы.ПС + ТекстСообщения);
	//	Возврат;
	//КонецЕсли; 
	// -- конец Давыдов А.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(CRM_СобытияПоРабочимЛистам.Ссылка) КАК ДокСобытиеВыдача
	|ИЗ
	|	Документ.CRM_СобытияПоРабочимЛистам.АвтомобилиДляВыдачи КАК CRM_СобытияПоРабочимЛистам
	|ГДЕ
	|	CRM_СобытияПоРабочимЛистам.Ссылка.IDK = &IDK
	|	И CRM_СобытияПоРабочимЛистам.VIN В (&МассивVIN)
	|	И CRM_СобытияПоРабочимЛистам.Ссылка.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.Выдача)
	|	И CRM_СобытияПоРабочимЛистам.Ссылка.Обработано = ИСТИНА
	|	И CRM_СобытияПоРабочимЛистам.Ссылка.ЗавершеноУспешно = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	CRM_СобытияПоРабочимЛистам.Ссылка.ДатаНапоминания";
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	Запрос.УстановитьПараметр("МассивVIN", МассивVINПоДоговору);	

	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();		
		Пока Выборка.Следующий() Цикл
			Сообщить("По данному автомобилю рабочего листа уже производилась успешная выдача - " + Выборка.ДокСобытиеВыдача + ".");
		КонецЦикла;		
		Возврат;
	КонецЕсли;	
	
	АвтомобилиДляВыдачи = Новый ТаблицаЗначений;
	// Для одного автомобиля заполняем выдачу сразу
	// Для нескольких выбираем автомобили в самой выдаче
	//Если МассивVINПоДоговору.Количество() = 1 Тогда
	Если МассивVINПоДоговору.Количество() <> 0 Тогда
		VIN = МассивVINПоДоговору[0];
		Если НЕ ЗначениеЗаполнено(VIN) Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			               |	Renault_ЗаконтрактованныеАвтомобили.VIN,
			               |	Renault_ЗаконтрактованныеАвтомобили.Регистратор,
						   |	Renault_ЗаконтрактованныеАвтомобили.Регистратор КАК Договор,
			               |	ВЫБОР
			               |		КОГДА Renault_ЗаконтрактованныеАвтомобили.ДатаСнятияРезерва = ДАТАВРЕМЯ(1, 1, 1)
			               |			ТОГДА ИСТИНА
			               |		ИНАЧЕ ЛОЖЬ
			               |	КОНЕЦ КАК Выбран,
			               |	Renault_ЗаконтрактованныеАвтомобили.Автомобиль
			               |ИЗ
			               |	РегистрСведений.Renault_ЗаконтрактованныеАвтомобили.СрезПоследних КАК Renault_ЗаконтрактованныеАвтомобили
			               |ГДЕ
			               |	Renault_ЗаконтрактованныеАвтомобили.РабочийЛист = &РабочийЛист
			               |	И Renault_ЗаконтрактованныеАвтомобили.ДатаСнятияРезерва = ДАТАВРЕМЯ(1, 1, 1)";
			Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
			АвтомобилиДляВыдачи = Запрос.Выполнить().Выгрузить();			
		Иначе			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Renault_ЗаконтрактованныеАвтомобили.VIN,
			               |	Renault_ЗаконтрактованныеАвтомобили.Регистратор,
						   |	Renault_ЗаконтрактованныеАвтомобили.Регистратор КАК Договор,
			               |	ВЫБОР
			               |		КОГДА Renault_ЗаконтрактованныеАвтомобили.ДатаСнятияРезерва = ДАТАВРЕМЯ(1, 1, 1)
			               |			ТОГДА ИСТИНА
			               |		ИНАЧЕ ЛОЖЬ
			               |	КОНЕЦ КАК Выбран,
			               |	Renault_ЗаконтрактованныеАвтомобили.Автомобиль
			               |ИЗ
			               |	РегистрСведений.Renault_ЗаконтрактованныеАвтомобили.СрезПоследних КАК Renault_ЗаконтрактованныеАвтомобили
			               |ГДЕ
			               |	Renault_ЗаконтрактованныеАвтомобили.РабочийЛист = &РабочийЛист
			               |	И Renault_ЗаконтрактованныеАвтомобили.ДатаСнятияРезерва = ДАТАВРЕМЯ(1, 1, 1)
			               |	И Renault_ЗаконтрактованныеАвтомобили.VIN = &VIN";
			Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
			Запрос.УстановитьПараметр("VIN", VIN);
			
			АвтомобилиДляВыдачи = Запрос.Выполнить().Выгрузить();		
		КонецЕсли;
	КонецЕсли;
	
	////Если МассивVINПоДоговору.Количество() = 0 Тогда
	Если АвтомобилиДляВыдачи.Количество() = 0 Тогда
		Предупреждение("Нет автомобилей для выдачи!");
		Возврат;
	КонецЕсли;
	
	//Откроем форму создания события
	СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	СобытиеОбъект.IDK = Объект.IDK;
	СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.Выдача;
	СобытиеОбъект.Сотрудник = Объект.Сотрудник;
	СобытиеОбъект.Отдел = Объект.Отдел;
	СобытиеОбъект.ДилерскийЦентр = Объект.ДилерскийЦентр;
	СобытиеОбъект.Подразделение = Объект.Подразделение;
	СобытиеОбъект.АвтомобилиДляВыдачи.Загрузить(АвтомобилиДляВыдачи);
	ФормаСобытия = СобытиеОбъект.ПолучитьФорму("ФормаСозданияСобытия");
	ФормаСобытия.Открыть();	
	
КонецПроцедуры // СоздатьЗаписьНаВыдачу()

