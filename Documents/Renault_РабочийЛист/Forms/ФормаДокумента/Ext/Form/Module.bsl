&НаКлиенте
Процедура КлиентУпущен(Команда)
	
	//Проверка, факта закрытия рл
	Если Объект.ЛистЗакрыт Тогда
		Если Не Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмРОП(ПараметрыСеанса.Пользователь)Тогда
			Предупреждение("Данный рабочий лист закрыт. Для изменения причины закрытия обратитесь к руководителю.");
			Возврат;
		Иначе
			Объект.ЛистЗакрыт = Не Объект.ЛистЗакрыт;
			Период = ТекущаяДата();
			Если Объект.ЛистЗакрыт Тогда
				Объект.АвторЗакрытия = ТекМенеджер;
			Иначе
				Объект.АвторЗакрытия = Неопределено;
			КонецЕсли;
			ЗаписатьРабочийЛист();
			ОбновитьЦветКнопокРОП();
		
		КонецЕсли;
		
	КонецЕсли;
	
	//Проверка существования запроса на закрытие "продажа"
	Если Объект.ЗапросНаЗакрытие И Объект.ПричинаЗакрытия = Справочники.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа Тогда		
		Режим = РежимДиалогаВопрос.ДаНет;
		Текст = "По рабочему листу существует запрос на закрытие по другой причине, он будет отменен. Продолжить?";
		Ответ = Вопрос(Текст, Режим, 0); 
		Если Ответ = КодВозвратаДиалога.Нет Тогда		
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//Проверка существования запроса на закрытие "упущен"
	Если Объект.ЗапросНаЗакрытие И Объект.ПричинаЗакрытия <> Справочники.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа Тогда
		Объект.ЗапросНаЗакрытие = Ложь;
		Объект.ПричинаЗакрытия = Неопределено;
		ОбновитьОтображениеКнопокЗакрытия();
		Возврат;
	КонецЕсли;
	
	Если НЕ Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
	
		//Проверим на наличие незакрытых событий
		Если ЕстьСобытияПоРЛ() Тогда
			Предупреждение("Перед закрытием рабочего листа необходимо закрыть все события");
			Возврат;
		КонецЕсли;
		Если НовыйАвтомобиль = 1 Тогда
			Если Не ЗначениеЗаполнено(Объект.ТипПродажиВыкупа) 
			или (Не ЗначениеЗаполнено(Объект.Гарантия) ИЛИ (Объект.Гарантия <> "Нет" и не ЗначениеЗаполнено(Объект.СрокГарантии))) Тогда
			Предупреждение("Для успешного закрытия рабочего листа по продажи необходимо заполнить тип продажи и гарантию для статистики.");
			Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если Не ЗначениеЗаполнено(Объект.ТипПродажиВыкупа)  Тогда
			Предупреждение("Для успешного закрытия рабочего листа по приему необходимо заполнить тип выкупа для статистики.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если ПометитьНеВыполненныеЗаявкиНаСервис() Тогда
        Возврат;
    КонецЕсли;
	ФормаВвода = Объект.Ссылка.ПолучитьФорму("ФормаВыбораПричиныЗакрытияРабочегоЛиста");
	Ответ = ФормаВвода.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		Объект.ПричинаЗакрытия = Ответ.ПричинаЗакрытия;
		Объект.КомментарийЗакрытия = Ответ.КомментарийЗакрытия;
		Объект.ЗапросНаЗакрытие = Истина;
		Объект.ДатаЗапросаНаЗакрытие = ТекущаяДата();
		СохранитьРабочийЛист();
	КонецЕсли;
	
	ОбновитьОтображениеКнопокЗакрытия();
	
КонецПроцедуры // КлиентУпущен()

&НаКлиенте
Процедура УспешнаяПродажа(Команда)
	
	//Проверка, факта закрытия рл
	Если Объект.ЛистЗакрыт Тогда
		Предупреждение("Данный рабочий лист закрыт. Для изменения причины закрытия обратитесь к руководителю.");
		Возврат;
	КонецЕсли;
	
	//Проверка существования запроса на закрытие "упущен"
	Если Объект.ЗапросНаЗакрытие И Объект.ПричинаЗакрытия <> Справочники.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа Тогда		
		Режим = РежимДиалогаВопрос.ДаНет;
		Текст = "По рабочему листу существует запрос на закрытие по другой причине, он будет отменен. Продолжить?";
		Ответ = Вопрос(Текст, Режим, 0); 
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//Проверка существования запроса на закрытие "продажа"
	Если Объект.ЗапросНаЗакрытие И Объект.ПричинаЗакрытия = Справочники.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа Тогда
		Объект.ЗапросНаЗакрытие = Ложь;
		Объект.ПричинаЗакрытия = Неопределено;
		ОбновитьОтображениеКнопокЗакрытия();
		Возврат;
	КонецЕсли;
	
	//Проверим на наличие незакрытых событий
	Если Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
		Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
			ЕстьПоступление = ПроверитьНаличиеПоступленияНаСклад(ЗаявкаНаТрейдИн.Автомобиль);
			Если Не ЕстьПоступление Тогда
				Предупреждение("Для успешного закрытия рабочего листа по приему необходимо оформить поступление автомобиля на склад");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ТипПродажиВыкупа)  Тогда
			Предупреждение("Для успешного закрытия рабочего листа по приему необходимо заполнить тип выкупа для статистики.");
			Возврат;
		КонецЕсли;
	ИначеЕсли Объект.ТипРабочегоЛиста = Перечисления.Renault_ТипыРабочихЛистов.Продажа и НовыйАвтомобиль = 1 Тогда
		Если Не ЗначениеЗаполнено(Объект.ТипПродажиВыкупа) 
			или (Не ЗначениеЗаполнено(Объект.Гарантия) ИЛИ (Объект.Гарантия <> "Нет" и не ЗначениеЗаполнено(Объект.СрокГарантии))) Тогда
			Предупреждение("Для успешного закрытия рабочего листа по продажи необходимо заполнить тип выкупа и гарантию для статистики.");
			Возврат;
		КонецЕсли;
	Иначе
	//Проверка отметки этапа Выдача
	ЗаписьВыдача = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	ЗаписьВыдача.IDK = Объект.IDK;
	ЗаписьВыдача.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ВыдачаАвтомобиля;
	ЗаписьВыдача.Прочитать();
	Если Не ЗаписьВыдача.Выбран() Тогда
		Предупреждение("Перед закрытием рабочего листа необходимо оформление выдачи");
		Возврат;
	КонецЕсли;
	КонецЕсли;

	//проверка наличия не выполненных заявок на установку доп. оборудования
	Если ПометитьНеВыполненныеЗаявкиНаСервис() тогда
        Возврат;
    КонецЕсли;

	Объект.ЗапросНаЗакрытие = Истина;
	Объект.ДатаЗапросаНаЗакрытие = ТекущаяДата();
	Объект.ПричинаЗакрытия = Справочники.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа;
	Объект.КомментарийЗакрытия = "";
	ОбновитьОтображениеКнопокЗакрытия();	
	
КонецПроцедуры // УспешнаяПродажа()

&НаКлиенте
Процедура ПодборАвто(Команда)
	
	// создаем новую заявку
	ЗаявкаДок = Документы.CRM_ЗаявкаНаПодборАвтомобиля.СоздатьДокумент();
	
