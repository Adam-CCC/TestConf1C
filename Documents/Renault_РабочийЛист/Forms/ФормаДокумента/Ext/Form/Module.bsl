// Формирование сообщений пользователю
//
&НаСервере
Процедура СообщенияПользователюПоКорпКлиентуНаСервере()
	
	Если ЗначениеЗаполнено(КорпКлиент) Тогда
	
		Если ДанныеДляСообщенийПользователю = Неопределено Тогда
			
			МассивСтатусовЗаявок = Новый Массив;
			СостояниеКорпКлиента = КорпКлиент.Состояние;
			
			ДанныеДляСообщенийПользователю = Новый Структура("СтатусыЗаявок, СостояниеКорпКлиента, ПериодСообщения", МассивСтатусовЗаявок, СостояниеКорпКлиента, Неопределено);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияVINВЗаявках.VIN КАК VIN,
		|	СостоянияVINВЗаявках.Заявка КАК Заявка,
		|	СостоянияVINВЗаявках.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.Renault_СостоянияVINВЗаявках КАК СостоянияVINВЗаявках
		|ГДЕ
		|	СостоянияVINВЗаявках.Заявка.Клиент = &КорпКлиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Renault_КорпоративныеКлиенты.Состояние КАК Состояние,
		|	Renault_КорпоративныеКлиенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Renault_КорпоративныеКлиенты КАК Renault_КорпоративныеКлиенты
		|ГДЕ
		|	Renault_КорпоративныеКлиенты.Ссылка = &КорпКлиент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	RenaultFlotte_ИсторияКомментариев.Период КАК Период,
		|	RenaultFlotte_ИсторияКомментариев.Автор КАК Автор,
		|	RenaultFlotte_ИсторияКомментариев.Сообщение КАК Сообщение
		|ИЗ
		|	РегистрСведений.RenaultFlotte_ИсторияКомментариев КАК RenaultFlotte_ИсторияКомментариев
		|ГДЕ
		|	RenaultFlotte_ИсторияКомментариев.Объект = &Объект
		|	И RenaultFlotte_ИсторияКомментариев.Автор <> &Автор
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		Запрос.УстановитьПараметр("КорпКлиент", КорпКлиент);
		Запрос.УстановитьПараметр("Объект", Строка(КорпКлиент.ИдЗаявки));
		Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр);
		Результат = Запрос.ВыполнитьПакет();
		
		//Статусы заявок
		Если НЕ Результат[0].Пустой() Тогда
			Выборка = Результат[0].Выбрать();
			
			ДанныеМассивСтатусовЗаявок = ДанныеДляСообщенийПользователю.СтатусыЗаявок;
			Если ДанныеМассивСтатусовЗаявок.Количество() = 0 Тогда
				Пока Выборка.Следующий() Цикл
					Стр = Новый Структура("VIN, Заявка, Статус"); 
					ЗаполнитьЗначенияСвойств(Стр, Выборка);
					
					ДанныеМассивСтатусовЗаявок.Добавить(Стр);
				КонецЦикла;
			Иначе
				Пока Выборка.Следующий() Цикл
					VIN = Выборка.VIN;
					Заявка = Выборка.Заявка;
					Статус = Выборка.Статус;
					
					Для Каждого Эл Из ДанныеМассивСтатусовЗаявок Цикл
						Если Эл.VIN = VIN И Эл.Заявка = Заявка Тогда
							Если Эл.Статус <> Статус Тогда
								Сообщить("Статус заявки - " + Заявка + Символы.ПС + " для VIN - " + VIN + " изменился с """ +
								Эл.Статус + """ на """ + Статус + """.");
							КонецЕсли;
							
							Прервать;						
						КонецЕсли;					
					КонецЦикла;				
				КонецЦикла;	
				
				ДанныеМассивСтатусовЗаявок.Очистить();
				
				Выборка.Сбросить();
				
				Пока Выборка.Следующий() Цикл
					Стр = Новый Структура("VIN, Заявка, Статус"); 
					ЗаполнитьЗначенияСвойств(Стр, Выборка);
					
					ДанныеМассивСтатусовЗаявок.Добавить(Стр);
				КонецЦикла;
			КонецЕсли; 		
		КонецЕсли;
		
		//Состояние клиента	
		Выборка = Результат[1].Выбрать();	
		Выборка.Следующий();
		
		Если Выборка.Состояние <> ДанныеДляСообщенийПользователю.СостояниеКорпКлиента Тогда
			Сообщить("Состояние клиента - " + Выборка.Наименование + " изменилось с """ + 
			ДанныеДляСообщенийПользователю.СостояниеКорпКлиента + """ на """ + Выборка.Состояние + """.");
			
			ДанныеДляСообщенийПользователю.Вставить("СостояниеКорпКлиента", Выборка.Состояние);
		КонецЕсли;	
		
		//Сообщение пользователю
		Выборка = Результат[2].Выбрать();	
		Выборка.Следующий();
		
		Если Выборка.Период <> ДанныеДляСообщенийПользователю.ПериодСообщения И НЕ ДанныеДляСообщенийПользователю.ПериодСообщения = Неопределено Тогда
			КомментарийПользователю = Renault_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				"%1 %2: %3",
				МестноеВремя(Выборка.Период, ЧасовойПоясСеанса()),
				Строка(Выборка.Автор),
				Выборка.Сообщение);
			Сообщить(КомментарийПользователю);	
		КонецЕсли;
		
		ДанныеДляСообщенийПользователю.Вставить("ПериодСообщения", Выборка.Период);
	КонецЕсли;

КонецПроцедуры // СообщенияПользователюПоКорпКлиентуНаСервере()

// Записывает рабочий лист
