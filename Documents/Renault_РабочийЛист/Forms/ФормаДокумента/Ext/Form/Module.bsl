&НаСервере
Процедура Воронка_ОбновитьТестДрайв()
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ТестДрайв;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//Был тест-драйв
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		Элементы.ТестДрайвПродажа.ЦветФона 	= ЦветRenault2;
		Элементы.ТестДрайвПродажа.Заголовок = "Тест-драйв (" + ТекстДата + ")";
		Элементы.ТестДрайвПродажа.Картинка 	= ИзображениеСобытиеВыполнено;
	Иначе
		//Не было посещения
		//Проверим наличие напоминания
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRM_СобытияПоРабочимЛистам.Ссылка,
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания
		|ИЗ
		|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|ГДЕ
		|	CRM_СобытияПоРабочимЛистам.IDK = &IDK
		|	И CRM_СобытияПоРабочимЛистам.ВидСобытия = &ВидСобытия
		|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
		Запрос.УстановитьПараметр("IDK", Объект.IDK);
		Запрос.УстановитьПараметр("ВидСобытия", Справочники.CRM_ВидыСобытий.ТестДрайв);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			//Есть напоминание
			Элементы.ТестДрайвПродажа.ЦветФона 	= ЦветКнопкиВоронкиСерый;
			Элементы.ТестДрайвПродажа.Заголовок = "Тест-драйв";
			Элементы.ТестДрайвПродажа.Картинка 	= ИзображениеСобытиеЗапланировано;
			Если ЗначениеЗаполнено(Выборка.ДатаНапоминания) Тогда
				ТекстДата = Формат(Выборка.ДатаНапоминания, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
				Элементы.ТестДрайвПродажа.Заголовок = "Тест-драйв (" + ТекстДата + ")";
			КонецЕсли;
		Иначе
			//Нет напоминания
			Элементы.ТестДрайвПродажа.ЦветФона = ЦветКнопкиВоронкиСерый;
			Элементы.ТестДрайвПродажа.Заголовок = "Тест-драйв";
			Элементы.ТестДрайвПродажа.Картинка = ИзображениеПустое;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // Воронка_ОбновитьТестДрайв()

