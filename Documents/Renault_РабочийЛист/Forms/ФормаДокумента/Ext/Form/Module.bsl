Процедура Клиент_ТелефонПриИзменении(Элемент)
	
	Объект.Телефон = Renault_УправлениеКонтактнойИнформацией.НормализацияНомераТелефона(Клиент_Телефон, Объект.ДилерскийЦентр);
	ПровестиДедубликацию("Телефон");
	СохранитьДанныеКлиентаПриСменеТелефона(); //временно не используем - надо отладить функционал
	Воронка_ОбновитьВзятТелефон();
	
КонецПроцедуры // Клиент_ТелефонПриИзменении()

&НаКлиенте
Процедура Клиент_ФИОПриИзменении(Элемент)
	
	//На всякий случай обработаем случай, когда у рабочего листа не заполнен клиент
	//Это ошибка, но происхождение ее непонятно
	ЗаписьТрафик = Renault_CRM.ПолучитьЗаписьТрафикаПоID(Объект.IDТрафика);
	Если ЗаписьТрафик <> Неопределено И ЗначениеЗаполнено(ЗаписьТрафик.Клиент) Тогда
		Объект.Клиент = ЗаписьТрафик.Клиент;
		Клиент = ЗаписьТрафик.Клиент;
		ЗаписатьРабочийЛист();
	Иначе	
		//Если и там не заполнен - создадим нового потенциального
		Если ЗаписьТрафик = Неопределено Тогда
			Предупреждение("Ошибка. Нет трафика по рабочему листу. Обратитесь в поддержку DMS.");
			Клиент_ФИО = "";
			Возврат;
		КонецЕсли;
		Клиент = CRM_Сервер.СоздатьПотенциальногоКонтрагентаПоТрафику(Объект.IDТрафика);
		Объект.Клиент = Клиент;
		ЗаписатьРабочийЛист();
		ЗаписьТрафик.Клиент = Клиент;
		ЗаписьТрафик.Записать();
	КонецЕсли;
	
	ПровестиДедубликацию("ФИО");
	Клиент = Объект.Клиент;
	Если ТипЗнч(Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		СохранитьДанныеКлиента();
	ИначеЕсли ТипЗнч(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Клиент_ФИО = Клиент.Наименование;
	КонецЕсли;
	
	Если Клиент_ФИО <> Клиент.Наименование Тогда
		
		Клиент_ФИО = Клиент.Наименование;
		
	КонецЕсли;
	
	//Заменим клиента в заявку ТрейдИн если она есть
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		
		лЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн.ПолучитьОбъект();
		лЗаявкаНаТрейдИн.Клиент = Клиент;
		
		Попытка
			лЗаявкаНаТрейдИн.Записать();
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;
	
	ОбновитьСтатусКорпКлиента();
	
КонецПроцедуры // Клиент_ФИОПриИзменении()

&НаКлиенте
Процедура Клиент_EmailПриИзменении(Элемент)
	
	Объект.Email = Клиент_Email;//Блинков DMSREN-745
	
	Шаблон = ".+@.+\..+";
	
	RegExp = Новый COMОбъект("VBScript.RegExp");
	RegExp.MultiLine = Ложь;
	RegExp.Global = Истина;
	RegExp.IgnoreCase = Истина;
	RegExp.Pattern = Шаблон;
	Если RegExp.Test(Объект.Email) ИЛИ Объект.Email = "" Тогда
		ПровестиДедубликацию("EMail");	// pu02028 #ИЗМ000001
		СохранитьДанныеКлиентаПриСменеEmail();
		Воронка_ОбновитьВзятEmail();
	Иначе
		Сообщить("Некорректный адрес E-Mail");
		ЭтаФорма.ТекущийЭлемент = Элемент;
	КонецЕсли;
	
КонецПроцедуры // Клиент_EmailПриИзменении()

