&НаКлиенте
Процедура ЗвонокВежливостиДР(Команда)
	
	СтрокаЗВ = Объект.ДилерскийЦентр.ЗвонкиВежливости.Найти("Звонок ДР", "ЗвонокНомер");
	Выход = Ложь;
	Если СтрокаЗВ <> Неопределено Тогда
		Если НЕ СтрокаЗВ.ДелатьЗвонок Тогда
			Выход = Истина;
		КонецЕсли;		
	Иначе
		Выход = Истина;
	КонецЕсли;
	
	Если Выход Тогда
		Элементы.ЗвонокВежливостиДР.Доступность = Ложь;
		Возврат;
	Иначе
		Элементы.ЗвонокВежливостиДР.Доступность = Истина;
	КонецЕсли;	
	
	КлиентДатаРождения = Объект.Клиент.ДатаРождения;
	Если ЗначениеЗаполнено(КлиентДатаРождения) Тогда
		ДатаЗвонкаДР = Документы.CRM_СобытияПоРабочимЛистам.ПолучитьБлижайшуюДатуДР(КлиентДатаРождения); 		
				
		Если ЗначениеЗаполнено(ДатаЗвонкаДр) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			               |	CRM_СобытияПоРабочимЛистам.Ссылка
			               |ИЗ
			               |	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
			               |ГДЕ
			               |	CRM_СобытияПоРабочимЛистам.IDK = &РабочийЛист
			               |	И CRM_СобытияПоРабочимЛистам.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.ЗвонокВежливостиДР)
			               |	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
			               |	И CRM_СобытияПоРабочимЛистам.ДатаНапоминания = &ДатаНапоминания
			               |
			               |УПОРЯДОЧИТЬ ПО
			               |	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
			Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
			Запрос.УстановитьПараметр("ДатаНапоминания", ДатаЗвонкаДР);
			Результат = Запрос.Выполнить();
				
			Если НЕ Результат.Пустой() Тогда
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				
				Событие = Выборка.Ссылка;
				ФормаСобытия = Событие.ПолучитьФорму("ФормаЗавершенияСобытия");
				ФормаСобытия.ЭлементыФормы.КнопкаПеренести.Доступность = Ложь;
				ФормаСобытия.Открыть();
			Иначе
				ВопросПользователю = Вопрос("Назначить звонок вежливости на дату - " + ДатаЗвонкаДР + "?", РежимДиалогаВопрос.ДаНет);
				
				Если ВопросПользователю = КодВозвратаДиалога.Да Тогда
					СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
					СобытиеОбъект.IDK = Объект.IDK;
					СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.ЗвонокВежливостиДР;
					СобытиеОбъект.Сотрудник = Объект.Сотрудник;
					СобытиеОбъект.Отдел = Объект.Отдел;
					СобытиеОбъект.ДилерскийЦентр = Объект.ДилерскийЦентр;
					СобытиеОбъект.Подразделение = Объект.Подразделение;
					СобытиеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
					СобытиеОбъект.Дата = ТекущаяДата();
					СобытиеОбъект.ДатаНапоминания = ДатаЗвонкаДР;
					СобытиеОбъект.Комментарий = "Звонок на день рождения";
					СобытиеОбъект.Обработано = Ложь;
					СобытиеОбъект.ЗавершеноУспешно = Ложь;
					СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);	
					
					Сообщить("Назначен звонок на день рождения, на дату - " + Формат(ДатаЗвонкаДР, "ДЛФ=D") + ".");
				КонецЕсли;				
			КонецЕсли;				
		Иначе
			Сообщить("Не определена дата звонка!");
		КонецЕсли;
	Иначе
		Сообщить("Не заполнена дата рождения у клиента!");
	КонецЕсли;
	
	Воронка_ОбновитьЗвонокВежливостиДР();
	
КонецПроцедуры // ЗвонокВежливостиДР()

