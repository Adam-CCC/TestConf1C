// Возвращает список отделов продаж/Трейд-ин
// 
// Возвращаемое значение:
//  СписокЗначений - Список отделов продаж
//
&НаСервере
Функция ПолучитьСписокОтделов(ЭтоТрейдИн)
	
	Если ЭтоТрейдИн Тогда
		ДопУсловие = "(ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделПродажАвтомобилей), ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделТрейдИн))";	
	Иначе
		ДопУсловие = "(ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделПродажАвтомобилей))";	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_Отделы.Ссылка КАК Отдел
	|ИЗ
	|	Справочник.CRM_Отделы КАК CRM_Отделы
	|ГДЕ
	|	CRM_Отделы.КлассификацияRenault В" + ДопУсловие + "
	|	И CRM_Отделы.ДилерскийЦентр = &ДилерскийЦентр
	|	И НЕ CRM_Отделы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	CRM_Отделы.КлассификацияRenault";
	
	Запрос.УстановитьПараметр("ДилерскийЦентр", Объект.ДилерскийЦентр);
	
	Результат = Запрос.Выполнить();
		
	СписокОтделов = Новый СписокЗначений;
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СписокОтделов.Добавить(Выборка.Отдел);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СписокОтделов;
	
КонецФункции // ПолучитьСписокОтделов()

// Создает запись в РС "Renault_Трафик"
//
// Параметры:
//  Отдел			 	- СправочникСсылка.CRM_Отделы	 - Ссылка на отдел
//  ВыбранныйСотрудник	 - СправочникСсылка.Сотрудники	 - Администратор
// 
// Возвращаемое значение:
//  Строка - Идентификатор трафика
//
&НаСервере
Функция СоздатьЗаписьТрафика(Отдел, ВыбранныйСотрудник)
	
	ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
			
	ЗаписьТрафик.Период = ТекущаяДата();
	Идентификатор = Новый УникальныйИдентификатор();
	ЗаписьТрафик.ТипТрафика = Объект.ТипТрафика;
	ЗаписьТрафик.Идентификатор = Идентификатор;
	ЗаписьТрафик.Менеджер = ВыбранныйСотрудник;
	ЗаписьТрафик.Администратор = ВыбранныйСотрудник;
	ЗаписьТрафик.Отдел = ?(ЗначениеЗаполнено(Отдел), Отдел, Объект.Отдел);
	ЗаписьТрафик.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Первичный;
	ЗаписьТрафик.Представление = Клиент_ФИО;
	ЗаписьТрафик.Обработан = Истина;
	ЗаписьТрафик.ДилерскийЦентр = Объект.ДилерскийЦентр;
	ЗаписьТрафик.Клиент = Объект.Клиент;	
	
	ЗаписьТрафик.Записать();
	
	Возврат ЗаписьТрафик.Идентификатор;
	
КонецФункции // СоздатьЗаписьТрафика()

