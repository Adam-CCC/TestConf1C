Процедура Воронка_ОбновитьMYRenault()
	
	ЭтоКОРП = Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент;
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.РегистрацияВMYRenault;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//Зарегистрирован
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		Элементы.MyRenault.ЦветФона = Новый Цвет(125,157,183);
		Если Не ЭтоКОРП Тогда
			Элементы.MyRenault.Заголовок = "Зарегистрирован в MyRenault (" + ТекстДата + ")";
		Иначе	
			Элементы.MyRenault.Заголовок = "Зарегистрирован в корп. портале (" + ТекстДата + ")";
		КонецЕсли;
	Иначе
		//Не зарегистрирован
		Элементы.MyRenault.ЦветФона = ЦветКнопкиВоронкиСерый;
		Если Не ЭтоКОРП Тогда
			Элементы.MyRenault.Заголовок = "Зарегистрировать в MyRenault";
		Иначе	
			Элементы.MyRenault.Заголовок = "Зарегистрировать в корпоративном портале";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // Воронка_ОбновитьMYRenault()

&НаСервере
Процедура Воронка_ОбновитьЗвонокВежливостиДР()
	
	СтрокаЗВ = Объект.ДилерскийЦентр.ЗвонкиВежливости.Найти("Звонок ДР", "ЗвонокНомер");
	Выход = Ложь;
	Если СтрокаЗВ <> Неопределено Тогда
		Если НЕ СтрокаЗВ.ДелатьЗвонок Тогда
			Выход = Истина;
		КонецЕсли;		
	Иначе
		Выход = Истина;
	КонецЕсли;
	
	Если Выход Тогда
		Элементы.ЗвонокВежливостиДР.Доступность = Ложь;
		Элементы.ЗвонокВежливостиДР.ЦветФона = ЦветКнопкиВоронкиСерый;
		Элементы.ЗвонокВежливостиДР.Заголовок = "Звонок ДР";
		Элементы.ЗвонокВежливостиДР.Картинка = ИзображениеПустое; 		

		Возврат;
	Иначе
		Элементы.ЗвонокВежливостиДР.Доступность = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Клиент) Тогда
		Элементы.ЗвонокВежливостиДР.ЦветФона = ЦветКнопкиВоронкиСерый;
		Элементы.ЗвонокВежливостиДР.Заголовок = "Звонок ДР";		
		Возврат;
	КонецЕсли;
	
	КлиентДатаРождения = Объект.Клиент.ДатаРождения;
	Если НЕ ЗначениеЗаполнено(КлиентДатаРождения) Тогда
		Элементы.ЗвонокВежливостиДР.ЦветФона = ЦветКнопкиВоронкиСерый;
		Элементы.ЗвонокВежливостиДР.Заголовок = "Звонок ДР";
		Возврат;
	КонецЕсли;
	
	ДатаЗвонкаДР = Документы.CRM_СобытияПоРабочимЛистам.ПолучитьБлижайшуюДатуДР(КлиентДатаРождения); 		

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	CRM_СобытияПоРабочимЛистам.Ссылка,
	               |	CRM_СобытияПоРабочимЛистам.ДатаНапоминания
	               |ИЗ
	               |	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	               |ГДЕ
	               |	CRM_СобытияПоРабочимЛистам.IDK = &РабочийЛист
	               |	И CRM_СобытияПоРабочимЛистам.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.ЗвонокВежливостиДР)
	               |	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
	               |	И CRM_СобытияПоРабочимЛистам.ДатаНапоминания = &ДатаНапоминания
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
	Запрос.УстановитьПараметр("РабочийЛист", 		Объект.IDK);
	Запрос.УстановитьПараметр("ДатаНапоминания", 	ДатаЗвонкаДР);
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Элементы.ЗвонокВежливостиДР.ЦветФона = ЦветКнопкиВоронкиСерый;
		Элементы.ЗвонокВежливостиДР.Заголовок = "Звонок ДР";
		Элементы.ЗвонокВежливостиДР.Картинка = ИзображениеСобытиеЗапланировано;
		Если ЗначениеЗаполнено(Выборка.ДатаНапоминания) Тогда
			ТекстДата = Формат(Выборка.ДатаНапоминания, "ДФ=""дд.ММ.гггг""");
			Элементы.ЗвонокВежливостиДР.Заголовок = "Звонок ДР" + Символы.ПС + "(" + ТекстДата + ")";
		КонецЕсли;
	Иначе
		Элементы.ЗвонокВежливостиДР.ЦветФона = ЦветКнопкиВоронкиСерый;
		Элементы.ЗвонокВежливостиДР.Заголовок = "Звонок ДР";
		Элементы.ЗвонокВежливостиДР.Картинка = ИзображениеПустое;
	КонецЕсли;
	
КонецПроцедуры

