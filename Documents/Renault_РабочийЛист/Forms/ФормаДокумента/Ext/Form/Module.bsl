&НаКлиенте
Процедура ТаблоКоментарииОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Расшифровка = "ДобавитьКомментарий" Тогда
		
		Элементы.ГруппаСобытиеКомментарииСтраницы.ТекущаяСтраница = Элементы.ГруппаСобытиеКомментарииСтраницаВводКомментария;		
		ЭтаФорма.ТекущийЭлемент = Элементы.ТекстНовогоКомментария;
		
	ИначеЕсли Расшифровка = "СортировкаКомментариевПоДате" Тогда  //Блинков DMSREN-786 Обработка именения сортировки
		
		СортировкаКомментариевПоДате = НЕ СортировкаКомментариевПоДате;
		ОбновитьКомментарий();
		
	Иначе
		
		ИдентификаторКомментарияРодителя = Расшифровка;
		ЭтаФорма.ТекущийЭлемент = Элементы.ТекстНовогоКомментария;
		Элементы.ГруппаСобытиеКомментарииСтраницы.ТекущаяСтраница = Элементы.ГруппаСобытиеКомментарииСтраницаВводКомментария;
		
	КонецЕсли;
	
КонецПроцедуры // ТаблоКоментарииОбработкаРасшифровки()

&НаКлиенте
Процедура ПолеСписокСобытийОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТабличныйДокумент    = Элементы.ПолеСписокСобытий;
	ТекущаяОбласть       = ТабличныйДокумент.ТекущаяОбласть;
	
	Если ТипЗнч(Расшифровка) = Тип("ДокументСсылка.CRM_СобытияПоРабочимЛистам") 
		И (Расшифровка.Обработано) Тогда// ИЛИ Расшифровка.ВидСобытия = Справочники.CRM_ВидыСобытий.Выдача) Тогда //DMSREN-365
		Если  Вопрос("Открыть результат события?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ФормаЗавершенияСобытия = Расшифровка.ПолучитьФорму("ФормаЗавершенияСобытия");
			//ФормаЗавершенияСобытия.ТолькоПросмотр = Истина;
			ФормаЗавершенияСобытия.ЭлементыФормы.КнопкаУспешно.Доступность = Ложь;
			ФормаЗавершенияСобытия.ЭлементыФормы.КнопкаНеуспешно.Доступность = Ложь;
			ФормаЗавершенияСобытия.ЭлементыФормы.ТабличноеПолеАвтоДляВыдачи.Доступность = Ложь;
			ФормаЗавершенияСобытия.ЭлементыФормы.ДиалогКомментария.Доступность = Ложь;
			ФормаЗавершенияСобытия.ЭлементыФормы.КнопкаЗакрыть.Доступность = Истина;
			ФормаЗавершенияСобытия.ЭлементыФормы.ДатаЗакрытия.Доступность = Истина;
			ФормаЗавершенияСобытия.ЭлементыФормы.ДатаЗакрытия.ТолькоПросмотр = Ложь;
			ФормаЗавершенияСобытия.ЭлементыФормы.Комментарий.ТолькоПросмотр = Истина;
			ФормаЗавершенияСобытия.ЭлементыФормы.Сотрудник.ТолькоПросмотр = Истина;
			ФормаЗавершенияСобытия.Открыть();
			//ФормаЗавершенияСобытия.ОткрытьМодально();	

		КонецЕсли;
		
	ИначеЕсли ТекущаяОбласть.Лево = 17 тогда // DMSREN-1362 
		если ЗначениеЗаполнено(Расшифровка) тогда
			Парам = Новый Структура;
			Парам.Вставить("ID", Расшифровка);
			ФормаОбр = ПолучитьФорму("Обработка.Renault_АРМ_ContactCenter.Форма", Парам);
			//ФормаОбр = Обработки.Renault_АРМ_ContactCenter.ПолучитьФорму("Форма");
			//ФормаОбр.ИДТрафика = ID;
			ФормаОбр.Открыть();
		КонецЕсли;
	иначе
		
		ТекСобытие = Расшифровка;
		Ответ = ТекСобытие.ПолучитьФорму("ФормаЗавершенияСобытия",ЭтаФорма,УникальныйИдентификатор).ОткрытьМодально();
		
		Если ЗначениеЗаполнено(Ответ) Тогда
			
			Ответ = Вопрос("Ввести новое событие?", РежимДиалогаВопрос.ДаНет);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				СоздатьНовоеСобытие();
			Иначе
				ОбновитьСписокСобытий();
			КонецЕсли;
			
			Renault_CRM.ОчиститьПроверкуПоРЛ(Объект.IDK);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПолеСписокСобытийОбработкаРасшифровки()

