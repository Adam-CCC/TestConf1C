				КонецЕсли;
			КонецЕсли;
			
			Если ДокументОбъект = Неопределено Тогда
				ДокументОбъект = Документы.Renault_ПредварительнаяОценкаАвтомобиляТрейдИн.СоздатьДокумент();
				ДокументОбъект.ЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн;
				ДокументОбъект.Дата = ТекущаяДата();
			КонецЕсли;
			
			ФормаДокумента = ДокументОбъект.ПолучитьФорму("ФормаДокумента");
			ФормаДокумента.ДокументЗаполняетсяИзРабочегоЛиста = Истина;
			ФормаДокумента.Сессия = СессияТрейдИн;
			ФормаДокумента.ПараметрыОповещения = Новый Структура("ЭтоВыбор", Ложь);
			ФормаДокумента.Открыть();		
		Иначе
			Сообщить("Необходимо внести данные по автомобилю!");			
		КонецЕсли;		
	Иначе
		Сообщить("Не выбрана заявка на трейд-ин!");
	КонецЕсли;
	
КонецПроцедуры // ПредварительнаяОценкаТрейдИн()

