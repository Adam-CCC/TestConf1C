&НаКлиенте
Процедура ЗакрытьСледСобытие(Команда)
	
	Если ЗначениеЗаполнено(IDСледСобытия) Тогда
		
		Ответ = Вопрос("Ввести результат события?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			
			мФорма = IDСледСобытия.ПолучитьФорму("ФормаЗавершенияСобытия");
			
			Если мФорма.Открыта() Тогда
				Предупреждение("Данное событие уже открыто!");
				Возврат;
			КонецЕсли;
			
			Ответ = мФорма.ОткрытьМодально();
			
			Если ЗначениеЗаполнено(Ответ) Тогда
				
				Ответ = Вопрос("Ввести новое событие?", РежимДиалогаВопрос.ДаНет);
				Если Ответ = КодВозвратаДиалога.Да Тогда
					СоздатьНовоеСобытие();
				Иначе
					ОбновитьСписокСобытий();
				КонецЕсли;
				
				Renault_CRM.ОчиститьПроверкуПоРЛ(Объект.IDK);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ЗакрытьСледСобытие()

&НаКлиенте
Процедура СобытиеОтправкаНаОценкуТрейдИн(Команда)
	
	СписокСобытий = ПолучитьСписокСобытийТрейдИн(Объект.IDK);
	
	КолСобытий = СписокСобытий.Количество();
	
	Если КолСобытий > 0 Тогда
		
		Если КолСобытий = 1 Тогда
			ТекСобытие = СписокСобытий[0]; 			
		Иначе
			ФормаСписка = Обработки.Renault_ARM_Администратор.ПолучитьФорму("ФормаВыбораИзСпискаПлиткой");
			ФормаСписка.Список = СписокСобытий;
			ФормаСписка.Заголовок = "Выбор не обработанных событий отправки оценки трайд-ин";
			ФормаСписка.КнопокВСтроке = 1;
			ФормаСписка.ВысотаКнопки = 40;
			ФормаСписка.ЭтоВыборСотрудника = Ложь;
			ТекСобытие = ФормаСписка.ОткрытьМодально();    			 		
		КонецЕсли; 		
		
		Если ТекСобытие <> Неопределено Тогда
			Ответ = ТекСобытие.ПолучитьФорму("ФормаЗавершенияСобытия").ОткрытьМодально();
			
			Если ЗначениеЗаполнено(Ответ) Тогда				
				Ответ = Вопрос("Ввести новое событие?", РежимДиалогаВопрос.ДаНет);
				
				Если Ответ = КодВозвратаДиалога.Да Тогда
					СоздатьНовоеСобытие();
				Иначе
					ОбновитьСписокСобытий();
				КонецЕсли;  
				
				Renault_CRM.ОчиститьПроверкуПоРЛ(Объект.IDK);   				
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Сообщить("Нет не обработанных отправок на оценку трейд-ин!");
		ОбновитьСписокСобытий();
		
	КонецЕсли;
	
КонецПроцедуры // СобытиеОтправкаНаОценкуТрейдИн()

&НаКлиенте
Процедура ПерепланироватьСобытие(Команда)
	
	ТабличныйДокумент    = Элементы.ПолеСписокСобытий;
	ТекущаяОбласть       = ТабличныйДокумент.ТекущаяОбласть;
	
	СобытиеСсылка = Неопределено;
	СтруктураРасшифровки = ТекущаяОбласть.Расшифровка;
	Если ТипЗнч(СтруктураРасшифровки) = Тип("Структура") Тогда
		СтруктураРасшифровки.Свойство("СобытиеСсылка", СобытиеСсылка);	
	ИначеЕсли ТипЗнч(СтруктураРасшифровки) = Тип("ДокументСсылка.CRM_СобытияПоРабочимЛистам") Тогда
		СобытиеСсылка = СтруктураРасшифровки;
	КонецЕсли;
	
	Если СобытиеСсылка = Неопределено Тогда
		Сообщить("Необходимо выделить строку с событием.");
		Возврат;
	КонецЕсли;
	
	Если СобытиеСсылка.Обработано Тогда
		Сообщить("Событие не подлежит редактированию.");
		Возврат;
	КонецЕсли;
	Если СтруктураРасшифровки.ВидСобытия = Справочники.CRM_ВидыСобытий.Выдача Тогда
		СсылкаНового = Документы.CRM_СобытияПоРабочимЛистам.ПеренестиСобытие(СтруктураРасшифровки);
		Если  СсылкаНового <> Неопределено Тогда
			Если СтруктураРасшифровки.Объект <> Неопределено Тогда
				ДокОбъект = СтруктураРасшифровки.Объект.ПолучитьОбъект();
				ДокОбъект.ДатаНачала = СсылкаНового.ДатаНапоминания;
				ДокОбъект.Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик;
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		КонецЕсли;
	Иначе
		ФормаВыбора = Справочники.Renault_ПричиныПерепланированияСобытий.ПолучитьФормуВыбора(, ЭтаФорма, ЭтаФорма.КлючУникальности);
		
		ФормаВыбора.Заголовок = "Укажите причину перепланирования события";
		
		Причина = ФормаВыбора.ОткрытьМодально();
		
		Если Причина = Неопределено Тогда
			Сообщить("Необходимо указать причину перепланирования события");
			Возврат;
		ИначеЕсли Причина.ЭтоГруппа Тогда
			Сообщить("Необходимо выбрать элемент, а не группу.");
			Возврат;
		КонецЕсли;
		
		ФормаСобытия = СобытиеСсылка.ПолучитьФорму("ФормаСозданияСобытия");
		ФормаСобытия.ЭтоПерепланирование = Истина;
		ФормаСобытия.ПричинаПерепланирования = Причина;
		ФормаСобытия.ОткрытьМодально();
	КонецЕсли;
	Оповестить("ОбновитьРабочийЛист");
	
КонецПроцедуры // ПерепланироватьСобытие()

&НаКлиенте
Процедура ОткрытьКонфигураторПолный(Команда)
	
	Если Модифицированность Тогда 
		ЗаписатьРабочийЛист();
	КонецЕсли;

	ФормаРабочийСтол = Обработки.CRM_АРМ_Конфигуратор.ПолучитьФорму("Форма",ЭтаФорма);
	Если Объект.ПродажаБУ Тогда 
		ФормаРабочийСтол.ЭтоТрейдИН = Истина;
		ФормаРабочийСтол.Модель = Объект.АвтомобильБУ.Модель;
		ФормаРабочийСтол.Версия = Объект.АвтомобильБУ.ВариантКомплектации;
		ФормаРабочийСтол.Цвет  =  Объект.АвтомобильБУ.Цвет;
		ФормаРабочийСтол.ТипКП = Перечисления.Renault_ТипКП.АвтомобильСПробегом;
		Если ЗначениеЗаполнено(Объект.АвтомобильБУ) Тогда
			ФормаРабочийСтол.Автомобиль = Объект.АвтомобильБУ;
		Иначе
			Предупреждение("Не выбран автомобиль, печать КП не возможна");
			Возврат;
		КонецЕсли;
	Иначе
		
		ЗаявкиПоРабочемуЛисту = ПолучитьЗаявкиПоРабочемуЛисту(Объект.IDK);
		
		Если ЗначениеЗаполнено(ЗаявкиПоРабочемуЛисту.ЗаявкаНаГарантию) Тогда
			ФормаРабочийСтол.ЗаявкаНаГарантию = ЗаявкиПоРабочемуЛисту.ЗаявкаНаГарантию;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаявкиПоРабочемуЛисту.ЗаявкаНаСтраховкуОсаго) Тогда
			ФормаРабочийСтол.ЗаявкаНаСтраховку = ЗаявкиПоРабочемуЛисту.ЗаявкаНаСтраховкуОсаго;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаявкиПоРабочемуЛисту.ЗаявкаНаСтраховкуКаско) Тогда
			ФормаРабочийСтол.ЗаявкаНаСтраховкуКАСКО = ЗаявкиПоРабочемуЛисту.ЗаявкаНаСтраховкуКаско;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаявкиПоРабочемуЛисту.ЗаявкаНаТрейдИн) Тогда
			ФормаРабочийСтол.ЗаявкаНаТрейдИн = ЗаявкиПоРабочемуЛисту.ЗаявкаНаТрейдИн;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаявкиПоРабочемуЛисту.ЗаявкаНаКредит) Тогда
			ФормаРабочийСтол.ЗаявкаНаКредит = ЗаявкиПоРабочемуЛисту.ЗаявкаНаКредит;
		КонецЕсли;
		
		ФормаРабочийСтол.ТипКП = Перечисления.Renault_ТипКП.НовыйАвтомобиль;
	КонецЕсли;
	ФормаРабочийСтол.ТекущийКлиент = Объект.Клиент;
	ФормаРабочийСтол.ТекущийРабочийЛист = Объект.IDK; 
	ФормаРабочийСтол.Открыть();
	
КонецПроцедуры // ОткрытьКонфигураторПолный()

&НаКлиенте
Процедура ОткрытьКонфигураторВыбранноеПолный(Команда)
	
	Если Модифицированность Тогда 
		ЗаписатьРабочийЛист();
	КонецЕсли;
	
	Если Элементы.ТаблицаКП.ТекущиеДанные<> Неопределено Тогда  //Блинков Было изменено условие т.к. не корректно отрабатывало Заполенено (т.к. мутабильный тип данных) DMSREN-738
		ОткрытьФормуКомПредложения(Элементы.ТаблицаКП.ТекущиеДанные);
	КонецЕсли;
	
	
	
КонецПроцедуры // ОткрытьКонфигураторВыбранноеПолный()

&НаКлиенте
Процедура УдалитьКоммерческоеПредложение(Команда)
	
	Если НЕ Объект.ДилерскийЦентр.ВозможностьУдаленияКП Тогда
		Сообщить("Запрещено удалять ком. предложения из раб. листа");
		Возврат;
	КонецЕсли;
	
	Если Элементы.ТаблицаКП.ТекущиеДанные<> Неопределено Тогда   //Блинков Было изменено условие т.к. не корректно отрабатывало Заполенено (т.к. мутабильный тип данных) DMSREN-738
		Ответ = Вопрос("Вы уверены что хотите удалить данное предложение из списка?", РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			СсылкаКП = Элементы.ТаблицаКП.ТекущиеДанные.Ссылка;
			
			//Удалим движения
			Набор = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьНаборЗаписей();
			Набор.Отбор.IDK.Установить(Объект.IDK);
			Набор.Прочитать();
			Для Каждого Запись ИЗ Набор Цикл
				Если Запись.Объект = СсылкаКП Тогда
					НовоеКП = ЗаменитьКП(СсылкаКП);
					Если ЗначениеЗаполнено(НовоеКП) Тогда
						Запись.Объект = НовоеКП;
						Запись.ДатаВыполнения = НовоеКП.Дата;
					Иначе
						Набор.Удалить(Запись);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Набор.Записать();
			
			КПОбъект = СсылкаКП.ПолучитьОбъект();
			КПОбъект.ПометкаУдаления = Истина;
			КПОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
			ОбновитьСписокКП();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // УдалитьКоммерческоеПредложение()

&НаКлиенте
Процедура СоздатьРезерв(Команда)
	
	Если Элементы.ТаблицаКП.ТекущиеДанные = Неопределено Тогда		
		Возврат;		
	КонецЕсли;
	
	КП = Элементы.ТаблицаКП.ТекущиеДанные.Ссылка;	
	ЕСли Не ЗначениеЗаполнено(КП) Тогда		
		Возврат;		
	КонецЕсли;
	
	Если КП.Состав.Количество() = 0 Тогда
		Возврат 
	КонецЕсли;
	
	Авто = КП.Состав[0].Конфигурация.Автомобиль;
	
	Если Не ЗначениеЗаполнено(Авто) Тогда		
		Предупреждение("Создание резерва возможно только на основе предложения на существующий автомобиль.");
		Возврат;		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ЗаявкиНаРезервАвтомобиля.Регистратор
	|ИЗ
	|	РегистрСведений.Renault_ЗаявкиНаРезервАвтомобиля КАК Renault_ЗаявкиНаРезервАвтомобиля
	|ГДЕ
	|	Renault_ЗаявкиНаРезервАвтомобиля.VIN = &VIN
	|	И Renault_ЗаявкиНаРезервАвтомобиля.Менеджер = &Менеджер
	|	И Renault_ЗаявкиНаРезервАвтомобиля.СтатусРезерва = ЗНАЧЕНИЕ(Перечисление.CRM_СтатусыРезервовАвтомобилей.ЗаявкаНаРезерв)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Renault_УтвержденныеРезервы.Регистратор
	|ИЗ
	|	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
	|ГДЕ
	|	Renault_УтвержденныеРезервы.VIN = &VIN
	|	И Renault_УтвержденныеРезервы.ДатаСнятияСРезерва >= &ТекущаяДата";
	
	Запрос.УстановитьПараметр("VIN", Авто.VIN);
	Запрос.УстановитьПараметр("Менеджер", ПараметрыСеанса.Пользователь.Сотрудник);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Результат = Запрос.Выполнить();	
	Если Не Результат.Пустой() Тогда
		Предупреждение("Автомобиль" + Авто + " уже находится в резерве");	
		Возврат;
	КонецЕсли;
	
	НовыйАвто = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(ОстаткиАвтомобилейОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	               |	ОстаткиАвтомобилейОстатки.СкладКомпании
	               |ИЗ
	               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки(, Автомобиль = &АВтомобиль) КАК ОстаткиАвтомобилейОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РеквизитыСкладовКомпании КАК Renault_РеквизитыСкладовКомпании
	               |		ПО ОстаткиАвтомобилейОстатки.СкладКомпании = Renault_РеквизитыСкладовКомпании.СкладКомпании
	               |			И (Renault_РеквизитыСкладовКомпании.СкладПодержанныхАвто = ИСТИНА)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиАвтомобилейОстатки.СкладКомпании";
	
	Запрос.УстановитьПараметр("Автомобиль", Авто);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		НовыйАвто = Ложь;
	КонецЕсли;
	
	Если НовыйАвто Тогда
		BIR_Distri = СокрЛП(Объект.ДилерскийЦентр.BIR_Distri);	
		МассивСкладовДилера = Объект.ДилерскийЦентр.СкладыДилера.ВыгрузитьКолонку("Склад");
		АвтоДанные = CRM_Сервер.Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей(Авто.VIN,МассивСкладовДилера, BIR_Distri,Истина, Истина, Ложь, Ложь);
		
		Если НЕ ЗначениеЗаполнено(АвтоДанные) Тогда		
			Предупреждение("Автомобиль нельзя поставить в резерв");
			Возврат;		
		КонецЕсли;
		
		ТекущиеДанные = АвтоДанные[0];
		
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Ознакомлен");
		СписокКнопок.Добавить(КодВозвратаДиалога.Отмена,"Отмена");
		Если ТекущиеДанные.СтатусТСМ = "TCM 15m+" Тогда
			Ответ = Вопрос("Данный автомобиль произведен более 15 месяцев назад. "+Символы.ПС+"Такой автомобиль может быть продан только как уцененный, т.е. не отвечающий требованиям нового автомобиля и со сроком действия гарантии, указанной в системе ICM.  "+Символы.ПС+"При создании договора необходимо это учитывать, а так же ознакомиться с датой окончания гарантии в ICM.",СписокКнопок);			
			Если Ответ = КодВозвратаДиалога.Отмена Тогда
				Возврат;
			КонецЕсли;
		ИначеЕсли ТекущиеДанные.СтатусТСМ = "TCM 14m+" Тогда	
			Ответ = Вопрос("Данный автомобиль произведен более 14 месяцев назад.  "+Символы.ПС+"Такой автомобиль может быть продан только как уцененный, т.е. не отвечающий требованиям нового автомобиля и со сроком действия гарантии, указанной в системе ICM.  "+Символы.ПС+"При создании договора необходимо это учитывать, а так же ознакомиться с датой окончания гарантии в ICM.",СписокКнопок);
			Если Ответ = КодВозвратаДиалога.Отмена Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;  
		
		
		Если ТекущиеДанные.Отозван Тогда
			ВопросПользователю = Вопрос("По автомобилю есть невыполненные отзывные ноты, всё равно продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Если ВопросПользователю = КодВозвратаДиалога.Нет Тогда
				Возврат;	
			КонецЕсли;		
		КонецЕсли;
	КонецЕсли;
	
	МаксимальноеКоличествоДнейРезерва = Renault_РаботаСПравамиПользователя.МаксимальноеКоличествоДнейРезерва(ПараметрыСеанса.Пользователь);			
	КомментарийКЗаявке = "";
	
	ДнейРезерваПоУмолчанию = ПараметрыСеанса.Renault_ПраваПользователя.Автосклад_КоличествоДнейРезерваПоУмолчанию;
	Если ДнейРезерваПоУмолчанию = 0 Тогда
		ДнейРезерваПоУмолчанию = МаксимальноеКоличествоДнейРезерва;
		Если МаксимальноеКоличествоДнейРезерва = 0 Тогда
			ДнейРезерваПоУмолчанию = 3;
		КонецЕсли;
	КонецЕсли;
	
	ДатаСнятияСРезерва = ТекущаяДата() + ДнейРезерваПоУмолчанию*60*60*24;	
	Если ВвестиДату(ДатаСнятияСРезерва, "Укажите до какой даты установить резерв") Тогда
		
		Если МаксимальноеКоличествоДнейРезерва <> 0 И ДатаСнятияСРезерва - ТекущаяДата() > МаксимальноеКоличествоДнейРезерва*60*60*24 Тогда
			Предупреждение("Оформление резерва невозможно. Максимальное число дней резерва для вас - " + Строка(МаксимальноеКоличествоДнейРезерва));
			Возврат;
		КонецЕсли;
		
		Если ВвестиСтроку(КомментарийКЗаявке, "Введите комментарий к заявке на резерв...", , Истина) Тогда 			
			МенеджерРезерва = ПараметрыСеанса.Пользователь.Сотрудник;			
		Иначе			
			Возврат;			
		КонецЕсли;		
	Иначе				
		Возврат;		
	КонецЕсли;
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_УтвержденныеРезервы.Регистратор	
	|ИЗ
	|	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
	|ГДЕ
	|	Renault_УтвержденныеРезервы.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN", Авто.VIN);
	
	Результат = Запрос.Выполнить();	
	Если Не Результат.Пустой() Тогда
		Предупреждение("Автомобиль" + Авто + " уже находится в резерве");	
		Возврат;
	КонецЕсли;		
	
	НовЗаявка = Документы.Renault_РезервированиеАвтомобилей.СоздатьДокумент();	
	НовЗаявка.VIN = Авто.VIN;
	НовЗаявка.Автомобиль = Авто;
	НовЗаявка.Дата = ТекущаяДата();
	НовЗаявка.Автор = ПараметрыСеанса.Пользователь;
	НовЗаявка.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
	НовЗаявка.Клиент = Объект.Клиент;
	НовЗаявка.РабочийЛист = Объект.IDK;
	
	ЕстьПравоСразуРезервироватьАвтомобиль = ПараметрыСеанса.Renault_ПраваПользователя.РезервироватьАвтомобильБезСогласования;
	
	Если ЕстьПравоСразуРезервироватьАвтомобиль Тогда
		НовЗаявка.Контролер = ПараметрыСеанса.Пользователь;
		НовЗаявка.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервУтвержден;
	Иначе
		НовЗаявка.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.ЗаявкаНаРезерв;
	КонецЕсли;
	
	НовЗаявка.Комментарий = КомментарийКЗаявке;
	НовЗаявка.ДатаСнятияРезерва = ДатаСнятияСРезерва;
	
	НовЗаявка.Записать(РежимЗаписиДокумента.Проведение);	

	ОбновитьСписокРезервов();
	
КонецПроцедуры // СоздатьРезерв()

&НаКлиенте
Процедура СоздатьДоговорПоРезерву(Команда)
	
	Если Элементы.ТаблицаКП.ТекущаяСтрока = Неопределено Тогда
	
		//Создадим новый
		ТекДанные = Элементы.Резервы.ТекущиеДанные;
		
		Если ТекДанные = Неопределено Тогда
			Предупреждение("Для создания договора необходимо выбрать автомобили из резерва.");
			Возврат;
		КонецЕсли;
		
		ДоговорОбъектНового = Документы.Renault_Договор.СоздатьДокумент();
		ДоговорОбъектНового.Дата = ТекущаяДата();
		ДоговорОбъектНового.ДатаДоговора = ТекущаяДата();	
		ДоговорОбъектНового.РабочийЛист = Объект.IDK;
		ДоговорОбъектНового.СтатусДоговора = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик;
		ДоговорОбъектНового.Клиент = Объект.Клиент;
		ДоговорОбъектНового.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Стр = ДоговорОбъектНового.СоставДоговора.Добавить();
		Стр.Автомобиль = ТекДанные.Автомобиль;
		Стр.Идентификатор = Новый УникальныйИдентификатор;
		Стр.VIN = ТекДанные.VIN;
		ФормаДоговора = ДоговорОбъектНового.ПолучитьФорму();
		ФормаДоговора.ПерезаполнитьДоговор = Истина;
		ФормаДоговора.Открыть();
	Иначе
		КП = Элементы.ТаблицаКП.ТекущиеДанные.ССылка;		
		Если Не ЗначениеЗаполнено(КП) Тогда			
			Возврат;			
		КонецЕсли;
		
		Если КП.Состав.Количество() = 0 Тогда
			Возврат
		КонецЕсли;
		
		Авто = КП.Состав[0].Конфигурация.Автомобиль;		
		Если НЕ ЗначениеЗаполнено(Авто) Тогда			
			Предупреждение("Создание резерва и договора возможно только на основе предложения на существующий автомобиль.");
			Возврат;			
		КонецЕсли;
		
		BIR_Distri = СокрЛП(Объект.ДилерскийЦентр.BIR_Distri);		
		МассивСкладовДилера = Объект.ДилерскийЦентр.СкладыДилера.ВыгрузитьКолонку("Склад");		
		АвтоДанные = CRM_Сервер.Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей(Авто.VIN,МассивСкладовДилера, BIR_Distri, Истина, Истина, Ложь, Ложь);
		
		Если Не ЗначениеЗаполнено(АвтоДанные) Тогда			
			Предупреждение("Автомобиль нельзя поставить в резерв и соответственно создать договор");
			Возврат;			
		КонецЕсли;		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_УтвержденныеРезервы.Регистратор		
		|ИЗ
		|	РегистрСведений.Renault_УтвержденныеРезервы КАК Renault_УтвержденныеРезервы
		|ГДЕ
		|	Renault_УтвержденныеРезервы.VIN = &VIN";
		
		Запрос.УстановитьПараметр("VIN", Авто.VIN);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Не Результат.Пустой() Тогда			
			
		Иначе			
			
			ТекущиеДанные = АвтоДанные[0];		
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Ознакомлен");
			СписокКнопок.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
			Если ТекущиеДанные.СтатусТСМ = "TCM 15m+" Тогда
				Ответ = Вопрос("Данный автомобиль произведен более 15 месяцев назад. "+Символы.ПС+"Такой автомобиль может быть продан только как уцененный, т.е. не отвечающий требованиям нового автомобиля и со сроком действия гарантии, указанной в системе ICM.  "+Символы.ПС+"При создании договора необходимо это учитывать, а так же ознакомиться с датой окончания гарантии в ICM.",СписокКнопок);			
				Если Ответ = КодВозвратаДиалога.Отмена Тогда
					Возврат;
				КонецЕсли;
			ИначеЕсли ТекущиеДанные.СтатусТСМ = "TCM 14m+" Тогда	
				Ответ = Вопрос("Данный автомобиль произведен более 14 месяцев назад.  "+Символы.ПС+"Такой автомобиль может быть продан только как уцененный, т.е. не отвечающий требованиям нового автомобиля и со сроком действия гарантии, указанной в системе ICM.  "+Символы.ПС+"При создании договора необходимо это учитывать, а так же ознакомиться с датой окончания гарантии в ICM.",СписокКнопок);
				Если Ответ = КодВозвратаДиалога.Отмена Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;  		
			
			Если ТекущиеДанные.Отозван Тогда
				ВопросПользователю = Вопрос("По автомобилю есть невыполненные отзывные ноты, всё равно продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
				Если ВопросПользователю = КодВозвратаДиалога.Нет Тогда
					Возврат;	
				КонецЕсли;		
			КонецЕсли;
				
				МаксимальноеКоличествоДнейРезерва = Renault_РаботаСПравамиПользователя.МаксимальноеКоличествоДнейРезерва(ПараметрыСеанса.Пользователь);			
			КомментарийКЗаявке = "";
			
			ДнейРезерваПоУмолчанию = ПараметрыСеанса.Renault_ПраваПользователя.Автосклад_КоличествоДнейРезерваПоУмолчанию;
			Если ДнейРезерваПоУмолчанию = 0 Тогда
				ДнейРезерваПоУмолчанию = МаксимальноеКоличествоДнейРезерва;
				Если МаксимальноеКоличествоДнейРезерва = 0 Тогда
					ДнейРезерваПоУмолчанию = 3;
				КонецЕсли;
			КонецЕсли;
			
			ДатаСнятияСРезерва = ТекущаяДата() + ДнейРезерваПоУмолчанию*60*60*24;
			
			Если ВвестиДату(ДатаСнятияСРезерва, "Укажите до какой даты установить резерв") Тогда
				
				Если МаксимальноеКоличествоДнейРезерва <> 0 И ДатаСнятияСРезерва - ТекущаяДата() > МаксимальноеКоличествоДнейРезерва*60*60*24 Тогда
					Предупреждение("Оформление резерва невозможно. Максимальное число дней резерва для вас - " + Строка(МаксимальноеКоличествоДнейРезерва));
					Возврат;
				КонецЕсли;
				
				Если ВвестиСтроку(КомментарийКЗаявке, "Введите комментарий к заявке на резерв...", , Истина) Тогда 				
					МенеджерРезерва = ПараметрыСеанса.Пользователь.Сотрудник;				
				Иначе				
					Возврат;				
				КонецЕсли;	
			Иначе					
				Возврат;			
			КонецЕсли;					
			
			НовЗаявка = Документы.Renault_РезервированиеАвтомобилей.СоздатьДокумент();
			
			НовЗаявка.VIN = Авто.VIN;
			НовЗаявка.Автомобиль = Авто;
			НовЗаявка.Дата = ТекущаяДата();
			НовЗаявка.Автор = ПараметрыСеанса.Пользователь;
			НовЗаявка.Менеджер = ПараметрыСеанса.Пользователь.Сотрудник;
			НовЗаявка.Клиент = Объект.Клиент;
			НовЗаявка.РабочийЛист = Объект.IDK;
			
			ЕстьПравоСразуРезервироватьАвтомобиль = ПараметрыСеанса.Renault_ПраваПользователя.РезервироватьАвтомобильБезСогласования;
			
			Если ЕстьПравоСразуРезервироватьАвтомобиль Тогда
				НовЗаявка.Контролер = ПараметрыСеанса.Пользователь;
				НовЗаявка.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.РезервУтвержден;
			Иначе
				НовЗаявка.СтатусРезерва = Перечисления.CRM_СтатусыРезервовАвтомобилей.ЗаявкаНаРезерв;
			КонецЕсли;
			
			НовЗаявка.Комментарий = КомментарийКЗаявке;
			НовЗаявка.ДатаСнятияРезерва = ДатаСнятияСРезерва;			
			НовЗаявка.Записать(РежимЗаписиДокумента.Проведение);			
			
			ОбновитьСписокРезервов();
		КонецЕсли;
		
		ДоговорОбъектНового = Документы.Renault_Договор.СоздатьДокумент();
		ДоговорОбъектНового.Дата = ТекущаяДата();
		ДоговорОбъектНового.ДатаДоговора = ТекущаяДата();	
		ДоговорОбъектНового.РабочийЛист = Объект.IDK;
		ДоговорОбъектНового.СтатусДоговора = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Черновик;
		ДоговорОбъектНового.Клиент = Объект.Клиент;
		ДоговорОбъектНового.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Стр = ДоговорОбъектНового.СоставДоговора.Добавить();
		Стр.Автомобиль = Авто;
		Стр.Идентификатор = Новый УникальныйИдентификатор;
		Стр.VIN = Авто.VIN;
		ФормаДоговора = ДоговорОбъектНового.ПолучитьФорму();
		ФормаДоговора.ПерезаполнитьДоговор = Истина;
		
		//Коммерческие акции
		Для каждого Стр Из КП.СкидкиКонфигурации Цикл
			Скидки = ДоговорОбъектНового.СкидкиДоговора.Добавить();
			ЗаполнитьЗначенияСвойств(Скидки, Стр);
			Скидки.Идентификатор = Стр.Акция.УникальныйИдентификатор();
			СкидкиРасшифровка = ДоговорОбъектНового.СкидкиRenualtРасшифровка.Добавить();
			СкидкиРасшифровка.Акция = Стр.Акция;
			СкидкиРасшифровка.ЗначениеСкидки = Стр.СуммаСкидки;
			СкидкиРасшифровка.Вид = Стр.Акция.Наименование;
			СкидкиРасшифровка.КоммерческаяАкцияGUID = Стр.Акция.УникальныйИдентификатор();
			СкидкиРасшифровка.Идентификатор = Стр.Акция.УникальныйИдентификатор();
			СкидкиРасшифровка.Флажок = Истина;
		КонецЦикла;
		
		ФормаДоговора.Открыть();
		
	КонецЕсли;
	
КонецПроцедуры // СоздатьДоговорПоРезерву()

&НаКлиенте
Процедура СоздатьВыдачу(Команда)
	
	// на всякий случай обновим список выдач, он может быть неактуален, если с рабочим листом работает несколько человек одновременно
	ОбновитьСписокВыдач();
	
	//ВазСистем Тарасов 13.12.2020 17:42:23 Инцидент #DMSREN-1046
	//{
	//Старый код:
	//Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
	//	Сообщить("Планирование выдачи для потенциального клиента невозможно");
	//	Возврат;
	//КонецЕсли;
	//Новый код:
	//}
	
	Строка = Элементы.Договоры.ТекущиеДанные;
	
	// ++ начало Давыдов А. 2020-04-30
	Если Строка = Неопределено Тогда
		Если Договоры.Количество() = 1 Тогда
			Строка = Договоры[0];
		Иначе
			Сообщить("Для планирования выдачи укажите договор!");
		КонецЕсли;  
	КонецЕсли;  
	
	// DMSREN-678 - сделаем проверку на повторную выдачу авто. По-хорошему, надо вычищать повторные проверки.
	// но тогда много где много чего найдется переделывать. Поэтому, просто вставлю свою проверку.
	// Рекомендуется использовать ее.
	Если Строка = Неопределено Тогда
		Возврат;
	Иначе 
		ТекстСообщения = "";
		Если CRM_Сервер.ЕстьВыданныеАвтомобили(Объект.IDK, Строка.VIN, Истина, ТекстСообщения) Тогда
			Сообщить("По данному VIN: " + Строка.VIN + " уже существует выдача.");
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	// -- конец Давыдов А.
	
		Если Строка <> Неопределено Тогда
		СтруктураПоиска = Новый Структура("Автомобили", Строка.VIN);
		НайденныеСтроки = Выдачи.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТаблицыВыдачи = НайденныеСтроки[0];
		Иначе
			СтрокаТаблицыВыдачи = Неопределено;
		КонецЕсли;
		
		Если СтрокаТаблицыВыдачи = Неопределено Тогда
			СоздатьЗаписьНаВыдачу(Строка.VIN);
		Иначе
			Если СтрокаТаблицыВыдачи.Статус	= Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Отменено Тогда
				Ответ = Вопрос("По данному VIN: " + Строка.VIN + " уже существует отмененная выдача. Хотите снова запланировать?",РежимДиалогаВопрос.ДаНет);
				Если Ответ = КодВозвратаДиалога.Да Тогда
					СтруктураПоиска = Новый Структура("Автомобили", Строка.VIN);
					НайденныеСтроки = Выдачи.НайтиСтроки(СтруктураПоиска);
					СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
					СобытиеОбъект.Обработано = Ложь;
					СобытиеОбъект.ДатаЗакрытия = Дата(1,1,1);
					СобытиеОбъект.КомментарийЗакрытия = "";
					СобытиеОбъект.Объект = НайденныеСтроки[0].Ссылка;
					СобытиеОбъект.ДоговорНаПродажуАвтомобиля = Строка.Ссылка;
					СобытиеОбъект.IDK = Объект.IDK;
					ФормаСобытия = СобытиеОбъект.ПолучитьФорму("ФормаСозданияСобытия");
					ФормаСобытия.ОткрытьМодально();
					ОбновитьСписокВыдач();
				КонецЕсли;
			Иначе 
				Сообщить("По данному VIN: " + Строка.VIN + " уже существует выдача.");
			КонецЕсли;
		КонецЕсли;
		
		ОбновитьСписокКонтрактов();
		
	КонецЕсли;
	
КонецПроцедуры // СоздатьВыдачу()

&НаКлиенте
Процедура ИзменитьВыдачу(Команда)
	
	Перем НоваяДатаВыдачи;
	
	ТекДанные = Элементы.Выдачи.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		ВвестиДату(НоваяДатаВыдачи, "Введите новую дату выдачи", ЧастиДаты.Дата);
		
		ДокСсылка = CRM_Сервер.ПолучитьАктуальноеСобытиеВыдачи(Элементы.Выдачи.ТекущиеДанные.Ссылка);
		СобытиеОбъект = ДокСсылка.ПолучитьОбъект();		
		СобытиеОбъект.ДатаЗакрытия = НоваяДатаВыдачи;
		СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Если ДокСсылка = Неопределено Тогда
				
				Сообщить ("Не удалось отменить Событие выдача");
			иначе

		ВыдачаОбъект = СобытиеОбъект.Объект.ПолучитьОбъект();
		ВыдачаОбъект.ДатаВыдачи = НоваяДатаВыдачи;
		ВыдачаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		
		ОбновитьВоронкуИСписки();
		
	КонецЕсли;
	
КонецПроцедуры // ИзменитьВыдачу()

&НаКлиенте
Процедура ОтменитьВыдачу(Команда)
	
	ТекДанные = Элементы.Выдачи.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		Ответ = Вопрос("Отменить выдачу?", РежимДиалогаВопрос.ДаНет);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
		
			ДокСсылка = CRM_Сервер.ПолучитьАктуальноеСобытиеВыдачи(Элементы.Выдачи.ТекущиеДанные.Ссылка);
			ЗаписьНаВыдачу = Элементы.Выдачи.ТекущиеДанные.Ссылка.ПолучитьОбъект();
			ЗаписьНаВыдачу.Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Отменено;
			ЗаписьНаВыдачу.Записать(РежимЗаписиДокумента.Проведение);
			
			Если ДокСсылка = Неопределено Тогда
				
				Сообщить ("Не удалось отменить Событие выдача");
			иначе
				СобытиеОбъект = ДокСсылка.ПолучитьОбъект();
				СобытиеОбъект.Обработано = Истина;
				СобытиеОбъект.КомментарийЗакрытия = "Выдача отменена";
				СобытиеОбъект.ДатаЗакрытия = ТекущаяДата();
				СобытиеОбъект.ЗавершеноУспешно = Ложь;
				СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли;
			
			ОбновитьВоронкуИСписки();
			
		КонецЕсли;
		
		ОбновитьСписокКонтрактов();
	КонецЕсли;

	
КонецПроцедуры // ОтменитьВыдачу()

&НаКлиенте
Процедура ЗапланироватьОплату(Команда)
	
	ОткрытьФорму("Обработка.Renault_КалендарьСобытий.Форма.ГрафикОплат", Новый Структура("IDK", Объект.IDK));
	
КонецПроцедуры // ЗапланироватьОплату()

&НаКлиенте
Процедура ДобавитьКомментарийРОП(Команда)
	
	Если НЕ ЗначениеЗаполнено(КомментарийРОП) Тогда
		Предупреждение("Поле комментарий пустое!!!");
		Возврат;
	КонецЕсли;
	
	Комент = РегистрыСведений.CRM_РезолюцииПоРабочимЛистам.СоздатьМенеджерЗаписи();
	Комент.Период       = ТекущаяДата();
	Комент.Дата         = ТекущаяДата();
	Комент.IDK          = Объект.IDK;
	Комент.ID           = СокрЛП(Новый УникальныйИдентификатор); 
	Комент.Сотрудник         = ПараметрыСеанса.Пользователь.Сотрудник;
	Комент.Комментарий       = СокрЛП(КомментарийРОП);
	Комент.Подразделение     = ПараметрыСеанса.ПодразделениеКомпании;
	Комент.Комментарий       = СокрЛП(КомментарийРОП);
	Комент.Записать();
	КомментарийРОП = "";
	ОбновитьКомментарийРезолюция();
	
КонецПроцедуры  // ДобавитьКомментарийРОП()

&НаКлиенте
Процедура ИзменитьМенеджера(Команда)
	
	Список = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(Объект.Отдел);
	ФормаСписка = Обработки.Renault_ARM_Администратор.ПолучитьФорму("ФормаВыбораИзСпискаПлиткой");
	ФормаСписка.Список = Список;
	ФормаСписка.Заголовок = "Выбор менеджера";
	ФормаСписка.КнопокВСтроке = 2;
	ФормаСписка.ВысотаКнопки = 40;
	ФормаСписка.ЭлементыФормы.Отмена.Заголовок = "Отмена";
	Ответ = ФормаСписка.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		Объект.Сотрудник = Ответ;
		ЗаписатьРабочийЛист();
		
		
		//Перенес это в модуль объекта, т.к. выглядит нелогично...
		Возврат;
		
		
		//Также изменим исполнителя у всех событий по рабочему листу
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	CRM_СобытияПоРабочимЛистам.Ссылка
		|ИЗ
		|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|ГДЕ
		|	CRM_СобытияПоРабочимЛистам.IDK = &IDK
		|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ";
		Запрос.УстановитьПараметр("IDK", Объект.IDK);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ЗаписьСобытие = Выборка.Ссылка.ПолучитьОбъект();
			ЗаписьСобытие.Сотрудник = Объект.Сотрудник;
			ЗаписьСобытие.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ИзменитьМенеджера()

&НаКлиенте
Процедура ПодтвердитьЗакрытие(Команда)
	
	Объект.ЛистЗакрыт = Не Объект.ЛистЗакрыт;
	Период = ТекущаяДата();
	Если Объект.ЛистЗакрыт Тогда
		АвторЗакрытия = ТекМенеджер;
	Иначе
		АвторЗакрытия = Неопределено;
	КонецЕсли;
	ЗаписатьРабочийЛист();
	ОбновитьЦветКнопокРОП();
	
КонецПроцедуры // ПодтвердитьЗакрытие()

&НаКлиенте
Процедура СоздатьКонтрагента(Команда)
	
	Ответ = Вопрос("Будет создан новый контрагент. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		КлиентДоговора = Объект.Клиент;
		Контрагент = CRM_Редубликация.СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(КлиентДоговора);
		КонтрагентОбъект = Контрагент.ПолучитьОбъект();
		КонтрагентОбъект.ИНН = Объект.Клиент.ИНН;
		Если ЗначениеЗаполнено(Объект.ДилерскийЦентр) Тогда
			КонтрагентОбъект.Родитель = Объект.ДилерскийЦентр.КаталогСозданияКонтрагентов;
		КонецЕсли;
		КонтрагентОбъект.Записать();
		
		Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
		Запись.Клиент = КлиентДоговора;
		Запись.Записать();
		
		Оповестить("ОбновитьРабочийЛистПослеЗаписиКонтрагента");
		
		ОбновитьКнопкиТипКлиента();
		
	КонецЕсли;
	
КонецПроцедуры // СоздатьКонтрагента()

&НаКлиенте
Процедура ВыбратьКонтрагентаИзСправочника(Команда)
	
	ФормаВыбораКонтрагента = Справочники.Контрагенты.ПолучитьФормуВыбора(, ЭтаФорма);
	ФормаВыбораКонтрагента.РежимВыбора = Истина;
	НовыйКонтрагент = ФормаВыбораКонтрагента.ОткрытьМодально();
	
	Если ЗначениеЗаполнено(НовыйКонтрагент) Тогда
		ТекстВопроса = "Установить выбранного контрагента для данного договора?";
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		КлиентДоговора = Объект.Клиент;
		Если ЗначениеЗаполнено(КлиентДоговора) Тогда
			Если ТипЗнч(КлиентДоговора) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
				КлиентОбъект = КлиентДоговора.ПолучитьОбъект();
				КлиентОбъект.Контрагент = НовыйКонтрагент;
				КлиентОбъект.Записать();
			КонецЕсли;
			Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
			Запись.Клиент = КлиентДоговора;
			Запись.Записать();
		КонецЕсли;
		Оповестить("ОбновитьРабочийЛистПослеЗаписиКонтрагента");
	КонецЕсли;
	
КонецПроцедуры // ВыбратьКонтрагентаИзСправочника()

&НаКлиенте
Процедура ОтправитьНаСогласование(Команда)
	
	ДанныеЗаполнены = ДанныеКорпКлиентаЗаполнены(КорпКлиент);
	Если НЕ ДанныеЗаполнены Тогда
		ФормаКорпКлиента = Справочники.Renault_КорпоративныеКлиенты.ПолучитьФорму(
					"Renault_ФормаКорпоративногоКлиента",,
					КорпКлиент.Контрагент.УникальныйИдентификатор());
		Если ФормаКорпКлиента <> Неопределено Тогда
			Если ФормаКорпКлиента.Открыта() Тогда
				ФормаКорпКлиента.Активизировать();
			КонецЕсли;
		Иначе
			ФормаКорпКлиента = КорпКлиент.ПолучитьФорму("Renault_ФормаКорпоративногоКлиента");
			ФормаКорпКлиента.СправочникОбъект = КорпКлиент.Контрагент.ПолучитьОбъект();
			ФормаКорпКлиента.СферыДеятельности = КорпКлиент.СферыДеятельности.Выгрузить();
			ФормаКорпКлиента.Автопарк = КорпКлиент.Автопарк.Выгрузить();
			ФормаКорпКлиента.Открыть();
		КонецЕсли;
		Элементы.Клиент_ФИОКОРП.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	
	КорпКлиентОбъект = КорпКлиент.ПолучитьОбъект();
	КорпКлиентОбъект.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.НаСогласовании;
	КорпКлиентОбъект.Записать();
	ОбновитьСтатусКорпКлиента();
	
	ОбновитьКнопкиТипКлиента();
	
	Если ЗначениеЗаполнено(КорпКлиент.Идентификатор) Тогда
		КлиентОбъект = КорпКлиент.ПолучитьОбъект();
		КлиентОбъект.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.Согласован;
		КлиентОбъект.Записать();
		КорпКлиентСтатус = Строка(КорпКлиент.Состояние);
	КонецЕсли;
	
КонецПроцедуры // ОтправитьНаСогласование()

&НаКлиенте
Процедура ОбновитьСтатусКлиента(Команда)
	
	ОбновитьСтатусКорпКлиента();
	
КонецПроцедуры // ОбновитьСтатусКлиента()

&НаКлиенте
Процедура ПерейтиКЗаявкамНаСкидки(Команда)
	
	ПараметрыФормы = Новый	Структура;
	ПараметрыФормы.Вставить("Клиент", КорпКлиент);
	ПараметрыФормы.Вставить("РабочийЛист", Объект.IDK);
	ОткрытьФорму("Обработка.Renault_АРМ_КорпоративныеСкидки.Форма.ФормаЗаявкиКлиента", ПараметрыФормы);
	
КонецПроцедуры // ПерейтиКЗаявкамНаСкидки()

&НаКлиенте
Процедура ОтправитьКомментарий(Команда)
	
	Если Не ЗначениеЗаполнено(НовыйКомментарий) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаДобавления = ТекущаяУниверсальнаяДата();
	
	РегистрыСведений.RenaultFlotte_ИсторияКомментариев.ДобавитьКомментарий(
		КорпКлиент.ИдЗаявки,
		НовыйКомментарий,
		ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр,
		ДатаДобавления);
	
	ЗаполнитьСписокКомментариев();
	НовыйКомментарий = "";
	
КонецПроцедуры // ОтправитьКомментарий()

&НаКлиенте
Процедура Клиент_ФИОНачалоВыбора(Команда)
	
	ФормаВыбораКонтрагента = Справочники.Контрагенты.ПолучитьФормуВыбора(, ЭтаФорма);
	ФормаВыбораКонтрагента.РежимВыбора = Истина;
	ВыбранныйКонтрагент = ФормаВыбораКонтрагента.ОткрытьМодально();

	Если ЗначениеЗаполнено(ВыбранныйКонтрагент) Тогда
		ТекстВопроса = "Установить выбранного контрагента для данного рабочего листа?";	
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0);	
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Если Справочники.Renault_ПрофилиКлиентов.Используются() Тогда
			Профиль = Справочники.Renault_ПрофилиКлиентов.СохранитьКлиентаВПрофиль(ВыбранныйКонтрагент);
			Справочники.Renault_ПрофилиКлиентов.ДобавитьКлиента(Профиль, ВыбранныйКонтрагент);
		КонецЕсли;
		
		ЗаменитьКонтрагента(ВыбранныйКонтрагент);
		
		//Записать();
		ЭтаФорма.ОбновитьОтображениеДанных();
		ПрочитатьДанныеКлиентаСервер();
		
	КонецЕсли;
	
	//Заменим клиента в заявку ТрейдИн если она есть
    Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
        
        лЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн.ПолучитьОбъект();
        лЗаявкаНаТрейдИн.Клиент = Объект.Клиент;
        
        Попытка
            лЗаявкаНаТрейдИн.Записать();
        Исключение
            
        КонецПопытки;
        
	КонецЕсли;
	
	СогласиеНаОПД();
	
КонецПроцедуры // Клиент_ФИОНачалоВыбора()

&НаКлиенте
Процедура Клиент_ФИООткрытие(Команда)
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.КорпоративныйКлиент Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_КорпоративныеКлиенты.Ссылка
			|ИЗ
			|	Справочник.Renault_КорпоративныеКлиенты КАК Renault_КорпоративныеКлиенты
			|ГДЕ
			|	Renault_КорпоративныеКлиенты.Контрагент = &Контрагент";
			Запрос.УстановитьПараметр("Контрагент", Объект.Клиент);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				КорпКлиент  = Выборка.Ссылка;
				КонтрагентСсылка = КорпКлиент.Контрагент;
				ФормаКорпКлиента = Справочники.Renault_КорпоративныеКлиенты.ПолучитьФорму(
					"Renault_ФормаКорпоративногоКлиента",,
					КорпКлиент.Контрагент.УникальныйИдентификатор());
				ФормаКорпКлиента.СправочникОбъект = КонтрагентСсылка.ПолучитьОбъект();
				ФормаКорпКлиента.СферыДеятельности = КорпКлиент.СферыДеятельности.Выгрузить();
				ФормаКорпКлиента.Автопарк = КорпКлиент.Автопарк.Выгрузить();
				ФормаКорпКлиента.КлючУникальности = КорпКлиент.Контрагент.УникальныйИдентификатор(); 
				ФормаКорпКлиента.ОткрытьМодально();
			Иначе
				Объект.Клиент.ПолучитьФорму("Renault_Форма", ЭтаФорма).Открыть();
			КонецЕсли;
		Иначе
			Объект.Клиент.ПолучитьФорму("Renault_Форма", ЭтаФорма).Открыть();
		КонецЕсли;
	Иначе
		Renault_CRM.ОткрытьКарточкуКлиента(Объект.Клиент,);
	КонецЕсли;
	
КонецПроцедуры // Клиент_ФИООткрытие()

&НаКлиенте
Процедура Клиент_КорпоративныйКонтЛицоФИОНачалоВыбора(Команда)

	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		ФормаВыбора = Справочники.Контрагенты.ПолучитьФормуВыбора("ФормаСписка", ЭтаФорма);
		
		ФормаВыбора.Отбор.ВидКонтрагента.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.ВидКонтрагента.Значение = Перечисления.ВидыКонтрагентов.КонтактноеЛицо;
		ФормаВыбора.Отбор.ВидКонтрагента.Использование = Истина;
		
		ФормаВыбора.Отбор.ВидОтношений.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.ВидОтношений.Значение = Справочники.ВидыВзаимоотношений.КонтактноеЛицо;
		ФормаВыбора.Отбор.ВидОтношений.Использование = Истина;

		ФормаВыбора.Отбор.ФормаСобственности.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.ФормаСобственности.Значение = Перечисления.ФормыСобственности.ЧастноеЛицо;
		ФормаВыбора.Отбор.ФормаСобственности.Использование = Истина; 
		
		ФормаВыбора.Отбор.ВедушийКонтрагент.ВидСравнения = ВидСравнения.Равно;
		ФормаВыбора.Отбор.ВедушийКонтрагент.Значение = Объект.Клиент;
		ФормаВыбора.Отбор.ВедушийКонтрагент.Использование = Истина;
		
		ФормаВыбора.ЭлементыФормы.Список.НастройкаОтбора.ВидКонтрагента.Доступность = Ложь;
		ФормаВыбора.ЭлементыФормы.Список.НастройкаОтбора.ВидОтношений.Доступность = Ложь;
		ФормаВыбора.ЭлементыФормы.Список.НастройкаОтбора.ФормаСобственности.Доступность = Ложь;
		ФормаВыбора.ЭлементыФормы.Список.НастройкаОтбора.ВедушийКонтрагент.Доступность = Ложь;
		ФормаВыбора.ЭлементыФормы.Список.ИерархическийПросмотр = Ложь;
		
		КонтЛицо = ФормаВыбора.ОткрытьМодально();
		
		Если КонтЛицо <> Неопределено Тогда
			Клиент_КорпоративныйКонтЛицо = КонтЛицо;
			Клиент_КорпоративныйКонтЛицоФИО = Клиент_КорпоративныйКонтЛицо.Наименование;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		
		ФормаВыбора = Справочники.CRM_ПотенциальныеКонтрагенты.ПолучитьФормуВыбора(, ЭтаФорма);
		
		Отбор = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидКонтрагента");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Перечисления.ВидыКонтрагентов.КонтактноеЛицо;
		Отбор.Использование = Истина;		
		Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		Отбор = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидОтношений");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Справочники.ВидыВзаимоотношений.КонтактноеЛицо;
		Отбор.Использование = Истина;		
		Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		Отбор = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ФормаСобственности");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Перечисления.ФормыСобственности.ЧастноеЛицо;
		Отбор.Использование = Истина;		
		Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		Отбор = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Renault_ВедушийКонтрагент");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Объект.Клиент;
		Отбор.Использование = Истина;		
		Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;		
		
		КонтЛицо = ФормаВыбора.ОткрытьМодально();
		
		Если КонтЛицо <> Неопределено Тогда
			Клиент_КорпоративныйКонтЛицо = КонтЛицо;
			Клиент_КорпоративныйКонтЛицоФИО = Клиент_КорпоративныйКонтЛицо.Наименование;
		КонецЕсли;
		
	КонецЕсли;
	
	Клиент_КорпоративныйКонтЛицоФИОПриИзменении(Неопределено);
	
КонецПроцедуры // Клиент_КорпоративныйКонтЛицоФИОНачалоВыбора()

