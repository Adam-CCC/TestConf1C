&НаКлиенте
Процедура ПерейтиКОформлениюКорп(Команда)
	
	Элементы.ГруппаСтраницыИнформации.ТекущаяСтраница = Элементы.ГруппаСтраницаКОРП;
	
	Для Каждого ТекущийЭлемент из Элементы.ГруппаМеню.ПодчиненныеЭлементы Цикл
		
		Если ТекущийЭлемент.Имя = "КОРП" Тогда
			ТекущийЭлемент.ЦветФона = ЦветРено;
		Иначе
			ТекущийЭлемент.ЦветФона = Новый Цвет(156, 166, 178);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПерейтиКОформлениюКорп()

&НаКлиенте
Процедура НадписьСоздатьРабочийЛистПродажаНажатие(Элемент)
	
	Если ЗначениеЗаполнено(Объект.СвязаныйIDK) И Объект.СвязаныйIDK <> Объект.IDK Тогда
		
		СвязанныйРЛ = Renault_CRM.докПолучитьСвязанныйРабочийЛист(Объект.СвязаныйIDK);
		
		Если СвязанныйРЛ <> Неопределено Тогда
			
			Если Не ЗначениеЗаполнено(СвязанныйРЛ.СвязаныйIDK) Тогда
				
				Renault_CRM.докЗаписатьСвязанныйIDKРабочегоЛиста(СвязанныйРЛ, Объект.IDK);
				
			КонецЕсли;
			
			СвязанныйРЛ.ПолучитьФорму().Открыть();
			
			ОбработкаОповещенияФормыЗаписи();
		
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	СписокОтделов = ПолучитьСписокОтделов(Ложь);
	
	ОтделПродаж = Справочники.CRM_Отделы.ПустаяСсылка();
	
	КолОтделов = СписокОтделов.Количество();
	
	Если КолОтделов = 1 Тогда
		ОтделПродаж = СписокОтделов[0].Значение; 			
	Иначе		
		ФормаСписка = Обработки.Renault_ARM_Администратор.ПолучитьФорму("ФормаВыбораИзСпискаПлиткой");
		ФормаСписка.Список = СписокОтделов;
		ФормаСписка.Заголовок = "Выбор отдела";
		ФормаСписка.КнопокВСтроке = 2;
		ФормаСписка.ВысотаКнопки = 40;
		ФормаСписка.ЭтоВыборСотрудника = Ложь;
		Ответ = ФормаСписка.ОткрытьМодально();
		Если ЗначениеЗаполнено(Ответ) Тогда
			ОтделПродаж = Ответ;
		Иначе
			Предупреждение("Необходимо выбрать менеджера.");
			Возврат
		КонецЕсли; 		
	КонецЕсли; 	 
	
	Список = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(ОтделПродаж);
	ФормаСписка = Обработки.Renault_ARM_Администратор.ПолучитьФорму("ФормаВыбораИзСпискаПлиткой");
	ФормаСписка.Список = Список;
	ФормаСписка.Заголовок = "Выбор менеджера";
	ФормаСписка.КнопокВСтроке = 2;
	ФормаСписка.ВысотаКнопки = 40;
	ФормаСписка.ЭтоВыборСотрудника = Истина;
	Ответ = ФормаСписка.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		ВыбранныйСотрудник = Ответ;
	Иначе
		Предупреждение("Необходимо выбрать менеджера.");
		Возврат
	КонецЕсли;
	                   
	Идентификатор = СоздатьЗаписьТрафика(ОтделПродаж, ВыбранныйСотрудник);
	
	РабочийЛистСсылка = Renault_CRM.докСоздатьРабочийЛистПоТрафику(Идентификатор, ,Перечисления.Renault_ТипыРабочихЛистов.Продажа);
	
	Renault_CRM.докЗаписатьСвязанныйIDKРабочегоЛиста(РабочийЛистСсылка, Объект.IDK);
	
	Объект.СвязаныйIDK = РабочийЛистСсылка.IDK;
	
	Элементы.НадписьСоздатьРабочийЛистПродажа.Заголовок = "Открыть связаный рабочий лист";
	ЗаписатьРабочийЛист();
	
КонецПроцедуры // НадписьСоздатьРабочийЛистПродажаНажатие()

&НаКлиенте
Процедура НадписьПривязатьРабочийЛистПродажаНажатие(Элемент)
	
	ОткрытьПоискЛистов();
	
	ОбработкаОповещенияФормыЗаписи();
	
КонецПроцедуры // НадписьПривязатьРабочийЛистПродажаНажатие()

&НаКлиенте
Процедура НадписьСоздатьРабочийЛистТрейдИнНажатие(Элемент)
	
	Если ЗначениеЗаполнено(Объект.СвязаныйIDK) И Объект.СвязаныйIDK <> Объект.IDK Тогда
		
		СвязанныйРЛ = Renault_CRM.докПолучитьСвязанныйРабочийЛист(Объект.СвязаныйIDK);
		
		Если СвязанныйРЛ <> Неопределено Тогда
			
			Если Не ЗначениеЗаполнено(СвязанныйРЛ.СвязаныйIDK) Тогда
				
				Renault_CRM.докЗаписатьСвязанныйIDKРабочегоЛиста(СвязанныйРЛ, Объект.IDK);
				
			КонецЕсли;
			
			СвязанныйРЛ.ПолучитьФорму().Открыть();
			
			ОбработкаОповещенияФормыЗаписи();
		
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОтделТрейдИн = Справочники.CRM_Отделы.ПустаяСсылка();
	
	СписокОтделов = ПолучитьСписокОтделов(Истина);
	
	Если СписокОтделов.Количество() > 0 Тогда
		ОтделТрейдИн = СписокОтделов[0].Значение;
	КонецЕсли;
	
	Список = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(ОтделТрейдИн);
	Список.Добавить(?(ЗначениеЗаполнено(ОтделТрейдИн), ОтделТрейдИн, Объект.Отдел));
	
	ФормаСписка = Обработки.Renault_ARM_Администратор.ПолучитьФорму("ФормаВыбораИзСпискаПлиткой");
	ФормаСписка.Список = Список;
		
		
	ФормаСписка.Заголовок = "Выбор менеджера или отдела";
		
	ФормаСписка.ЭтоВыборСотрудника = Истина;
	ФормаСписка.КнопокВСтроке = 2;
	ФормаСписка.ВысотаКнопки = 40;
	Ответ = ФормаСписка.ОткрытьМодально();
	Если ЗначениеЗаполнено(Ответ) Тогда
		СотрудникВыбор = Ответ;
	Иначе
		Предупреждение("Необходимо выбрать менеджера или отдел.");
		Возврат
	КонецЕсли;
	
	Идентификатор = СоздатьЗаписьТрафика(ОтделТрейдИн, СотрудникВыбор);
	
	// Трояновский К.Е. 06.08.2019 15:38:27 {
	//РабочийЛистСсылка = Renault_CRM.СоздатьРабочийЛистПоТрафику(Идентификатор,,Перечисления.Renault_ТипыРабочихЛистов.TradeIn);
	РабочийЛистСсылка = Renault_CRM.докСоздатьРабочийЛистПоТрафику(Идентификатор,,Перечисления.Renault_ТипыРабочихЛистов.TradeIn);
	// Трояновский К.Е. 06.08.2019 15:38:27 }
	
	Renault_CRM.докЗаписатьСвязанныйIDKРабочегоЛиста(РабочийЛистСсылка, Объект.IDK);
	
	Объект.СвязаныйIDK = РабочийЛистСсылка.IDK;
	Элементы.НадписьСоздатьРабочийЛистТрейдИн.Заголовок = "Открыть связаный рабочий лист";
	
	СоздатьЗаписьВоронкиПродаж(Справочники.CRM_ЭтапыПродаж.ИнтересКТрейдИн);
	
	ЗаписатьРабочийЛист();
	
КонецПроцедуры // НадписьСоздатьРабочийЛистТрейдИнНажатие()

&НаКлиенте
Процедура ПривязатьСоздатьРабочийЛистТрейдИнНажатие(Элемент)
	
	ОткрытьПоискЛистов();
	
КонецПроцедуры // ПривязатьСоздатьРабочийЛистТрейдИнНажатие()

