&НаКлиенте
Процедура ОценкаСервисомТрейдИн(Команда)
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		Если Не ЗначениеЗаполнено(ЗаявкаНаТрейдИн.ДилерскийЦентр) Тогда
			Предупреждение("Необходимо указать дилерский центр");
			Возврат;
		КонецЕсли;
	
		Если Не ЗначениеЗаполнено(ЗаявкаНаТрейдИн.Клиент) Тогда
			Предупреждение("Необходимо указать клиента");
			Возврат;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЗаявкаНаТрейдИн.Автомобиль) Тогда
			Предупреждение("Необходимо указать автомобиль");
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(ЗаявкаНаТрейдИн.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
			Ответ = Вопрос("Для записи автомобиля на диагоностику клиент должен быть контрагентом. " + Символы.ПС + "Вы хотите перевести потенциального клиента в контрагенты?", РежимДиалогаВопрос.ДаНет ,,, "Вопрос");
			
			Если Ответ <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;
			
			ТекКлиент = ЗаявкаНаТрейдИн.Клиент;
			Если обЗначениеНеЗаполнено(ТекКлиент.Фамилия) И обЗначениеНеЗаполнено(ТекКлиент.Имя) И обЗначениеНеЗаполнено(ТекКлиент.Отчество) Тогда
				Ошибки = "Одно из полей ФИО должно быть заполнено. Заполните ФИО.";
				Сообщить(Ошибки, СтатусСообщения.Важное);
				Возврат;
			КонецЕсли;
			
			ЗаявкаНаТрейдИнОбъект = ЗаявкаНаТрейдИн.ПолучитьОбъект();
			ЗаявкаНаТрейдИнОбъект.Клиент = CRM_Редубликация.СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(ЗаявкаНаТрейдИн.Клиент);			
			ЗаявкаНаТрейдИнОбъект.Записать();
			
			Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
			Запись.Клиент = ЗаявкаНаТрейдИн.Клиент;
			Запись.Записать();	
							
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	CRM_Договор.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.Renault_Договор КАК CRM_Договор
			|ГДЕ
			|	CRM_Договор.РабочийЛист = &IDK
			|	И НЕ CRM_Договор.ПометкаУдаления
			|
			|УПОРЯДОЧИТЬ ПО
			|	CRM_Договор.Дата УБЫВ";
			Запрос.УстановитьПараметр("IDK", Объект.СвязаныйIDK);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если НЕ Выборка.Ссылка.КлиентДоговораОтличаетсяОтКлиентаРЛ Тогда
					ДоговорДок = Выборка.Ссылка.ПолучитьОбъект();
					ДоговорДок.Клиент = ЗаявкаНаТрейдИн.Клиент;
			        ДоговорДок.КлиентДоговора = ЗаявкаНаТрейдИн.Клиент;
					ДоговорДок.DMS_ДоговорВзаиморасчетов = CRM_Редубликация.НайтиСоздатьДоговорВзаиморасчетов(ЗаявкаНаТрейдИн.Клиент, Выборка.Ссылка);
					Попытка
						ДоговорДок.Записать();
					Исключение
					КонецПопытки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Оповестить("ОбновитьРабочийЛистПослеЗаписиКонтрагента");
			Объект.Клиент = ЗаявкаНаТрейдИн.Клиент;
			Если ЗначениеЗаполнено(Объект.СвязаныйIDK) тогда
				СвязаныйIDKДок =  Документы.Renault_РабочийЛист.НайтиПоРеквизиту("IDK",Объект.СвязаныйIDK);
				Если СвязаныйIDKДок <>  Документы.Renault_РабочийЛист.ПустаяСсылка() тогда
					
					СвязаныйIDKОбъект =   СвязаныйIDKДок.ПолучитьОбъект();
					СвязаныйIDKОбъект.Клиент = ЗаявкаНаТрейдИн.Клиент;
					СвязаныйIDKОбъект.Записать();
				КонецЕсли;
			КонецЕсли;	
			ОбновитьКнопкиТипКлиента();

		КонецЕсли; 
		
		СоздатьОбращениеВСервис();		
				
	Иначе
		Сообщить("Не выбрана заявка на трейд-ин!");	
	КонецЕсли;
	
КонецПроцедуры // ОценкаСервисомТрейдИн()

&НаКлиенте
Процедура ПроверкаЮрЧистотыТрейдИн(Команда)
	
	Возврат; // Так как функция находятся в разработке.
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда	
		ЭтапПроверкаЮридическойЧистоты = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнПроверкаЮридическойЧистоты;
		
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		Запись.IDK = Объект.IDK;	
		Запись.ЭтапПродаж = ЭтапПроверкаЮридическойЧистоты;
		Запись.Прочитать();
		
		Если Не Запись.Выбран() Тогда
			ТекущаяДата = ТекущаяДата();
			ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
			
			Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
			Событие.IDK = Объект.IDK;
			Событие.Дата = ТекущаяДата;
			Событие.Автор = ТекСотрудник;
			Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
			Событие.Комментарий = "Проверка юридической чистоты по трейд-ин";
			Событие.ДатаНапоминания = ТекущаяДата;
			Событие.ДатаЗакрытия = ТекущаяДата;
			Событие.КомментарийЗакрытия = "Выполнено";
			Событие.АвторЗакрытия = ТекСотрудник;
			Событие.Сотрудник = ЗаявкаНаТрейдИн.МенеджерЗаявитель;
			Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
			Событие.Записать();
			
			Запись.IDK = Объект.IDK;
			Запись.Объект = ЗаявкаНаТрейдИн;
			Запись.ЭтапПродаж = ЭтапПроверкаЮридическойЧистоты; 
			Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
			Запись.ДатаВыполнения = ТекущаяДата;
			Запись.Записать();
		КонецЕсли;	
		
		ОбновитьВоронкуИСпискиТрейдИн(); 		
	Иначе
		Сообщить("Не выбрана заявка на трейд-ин!");	
	КонецЕсли;
	
КонецПроцедуры // ПроверкаЮрЧистотыТрейдИн()

&НаКлиенте
Процедура КалькуляцияТрейдИн(Команда, ВнешнийВызовЗаявкаНаТрейдИн=Неопределено, ВнешниййВызовIDK=Неопределено)
	
	Если ВнешнийВызовЗаявкаНаТрейдИн <> Неопределено Тогда
		ЗаявкаНаТрейдИн = ВнешнийВызовЗаявкаНаТрейдИн; 
	КонецЕсли;
	
	Если ВнешниййВызовIDK <> Неопределено Тогда
		Объект.IDK = ВнешниййВызовIDK; 
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		Автомобиль = ЗаявкаНаТрейдИн.Автомобиль;
		Клиент = ЗаявкаНаТрейдИн.Клиент;
		
		Если НЕ ЗначениеЗаполнено(Автомобиль) Тогда
			Сообщить("В заявке на трейд-ин не указан автомобиль!");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			Сообщить("В заявке на трейд-ин не указан клиент!");
			Возврат;
		КонецЕсли;	
		
		Калькуляция = СоздатьКалькуляцию();
				
		Если ЗначениеЗаполнено(Калькуляция)Тогда
			ПересчитатьСтоимостьВосстановления();
			
			ЭтапСозданиеКалькуляции = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнКалькуляция;
			
			Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
			Запись.IDK = Объект.IDK;	
			Запись.ЭтапПродаж = ЭтапСозданиеКалькуляции;
			Запись.Прочитать();
			
			Если Не Запись.Выбран() Тогда
				ТекущаяДата = ТекущаяДата();
				ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
				
				Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
				Событие.IDK = Объект.IDK;
				Событие.Дата = ТекущаяДата;
				Событие.Автор = ТекСотрудник;
				Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
				Событие.Комментарий = "Создание калькуляции по трейд-ин";
				Событие.ДатаНапоминания = ТекущаяДата;
				Событие.ДатаЗакрытия = ТекущаяДата;
				Событие.КомментарийЗакрытия = "Выполнено";
				Событие.АвторЗакрытия = ТекСотрудник;
				Событие.Сотрудник = ЗаявкаНаТрейдИн.МенеджерЗаявитель;
				Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
				Событие.Записать();
				
				Запись.IDK = Объект.IDK;
				Запись.Объект = ЗаявкаНаТрейдИн;
				Запись.ЭтапПродаж = ЭтапСозданиеКалькуляции; 
				Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
				Запись.ДатаВыполнения = ТекущаяДата;
				Запись.Записать();
			КонецЕсли;
			
			ОбновитьВоронкуИСпискиТрейдИн();
		КонецЕсли;		 		
	Иначе
		Сообщить("Не выбрана заявка на трейд-ин!");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокКалькуляцийТрейдИн(Команда)
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		Заявки = НайтиЗаявки();

		Если Заявки.Количество() > 1 Тогда			
			Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
			СписокВыбора = Новый СписокЗначений;
				
			СписокВыбора.ЗагрузитьЗначения(Заявки.ВыгрузитьКолонку("Заявка"));
				
			Форма.Заголовок = "Выберите в какую заявку добавляем.";
			Форма.СписокВыбора = СписокВыбора;
			
			Заявка = Форма.ОткрытьМодально();
			Если НЕ ЗначениеЗаполнено(Заявка) Тогда
				Предупреждение("Не выбрана заявка!");
				Возврат;
			КонецЕсли; 				
		ИначеЕсли Заявки.Количество() = 1 Тогда		
			Заявка = Заявки[0].Заявка;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Заявка) Тогда 		
			Сообщить("Нет заявки в автосервис!");
			Возврат;		
		КонецЕсли;
	
		Калькуляции = ПолучитьКалькуляцииПоЗаявке(Заявка); 
		
		Если Калькуляции.Количество() > 0 Тогда
			ФормаВыбора = Документы.Renault_Калькуляция.ПолучитьФормуВыбора();
			ФормаВыбора.Отбор.Ссылка.ВидСравнения = ВидСравнения.ВСписке;
			ФормаВыбора.Отбор.Ссылка.Значение = Калькуляции;
			ФормаВыбора.Отбор.Ссылка.Использование = Истина;
			ФормаВыбора.ЭлементыФормы.ДокументСписок.НастройкаОтбора.Ссылка.Доступность = Ложь;

			Калькуляция = ФормаВыбора.ОткрытьМодально();
			
			Если НЕ ЗначениеЗаполнено(Калькуляция) Тогда
				Возврат;
			КонецЕсли;
					
			ФормаКалькуляции = Калькуляция.ПолучитьФорму("ФормаДокумента");
			ФормаКалькуляции.ОткрытьМодально();
		Иначе
			Сообщить("Калькуляции не найдены!");
		КонецЕсли;		 			
	Иначе
		Сообщить("Не выбрана заявка на трейд-ин.");
	КонецЕсли;
	
КонецПроцедуры // ОткрытьСписокКалькуляцийТрейдИн()

&НаКлиенте
Процедура ПредложениеВыкупаТрейдИн(Команда)
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		Автомобиль = ЗаявкаНаТрейдИн.Автомобиль;
		Клиент = ЗаявкаНаТрейдИн.Клиент;
		
		Если НЕ ЗначениеЗаполнено(Автомобиль) Тогда
			Сообщить("В заявке на трейд-ин не указан автомобиль!");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			Сообщить("В заявке на трейд-ин не указан клиент!");
			Возврат;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Renault_ПредложениеВыкупаАвтомобиляТрейдИн.Ссылка
		|ИЗ
		|	Документ.Renault_ПредложениеВыкупаАвтомобиляТрейдИн КАК Renault_ПредложениеВыкупаАвтомобиляТрейдИн
		|ГДЕ
		|	Renault_ПредложениеВыкупаАвтомобиляТрейдИн.ЗаявкаНаТрейдИн = &ЗаявкаНаТрейдИн
		|
		|УПОРЯДОЧИТЬ ПО
		|	Renault_ПредложениеВыкупаАвтомобиляТрейдИн.Дата УБЫВ";
		Запрос.УстановитьПараметр("ЗаявкаНаТрейдИн", ЗаявкаНаТрейдИн);
		Результат = Запрос.Выполнить();
		
		ЕстьПредложениеВыкупа = Не Результат.Пустой();
			
		Если ЕстьПредложениеВыкупа Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			ДокументПредложениеВыкупа = Выборка.Ссылка.ПолучитьОБъект();
		Иначе
			ДокументПредложениеВыкупа = Документы.Renault_ПредложениеВыкупаАвтомобиляТрейдИн.СоздатьДокумент();
			ДокументПредложениеВыкупа.Дата = ТекущаяДата();
			ДокументПредложениеВыкупа.ЗаявкаНаТрейдИн = ЗаявкаНаТрейдИн;
		КонецЕсли;
				
		ФормаДокумента = ДокументПредложениеВыкупа.ПолучитьФорму("ФормаДокумента");
		ФормаДокумента.ДокументЗаполняетсяИзРабочегоЛиста = Истина;
		ФормаДокумента.Открыть();
	Иначе
		Сообщить("Не выбрана заявка на трейд-ин!");	
	КонецЕсли;
	
КонецПроцедуры // ПредложениеВыкупаТрейдИн()

&НаКлиенте
Процедура ОткрытьСписокПредложенийВыкупаТрейдИн(Команда)
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
