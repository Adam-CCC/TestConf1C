		ТекущийЭлемент = Элементы.ТестДрайв;
		СменитьСтраницу(Команда);
	Иначе
		//Проверим наличие напоминания
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRM_СобытияПоРабочимЛистам.Ссылка
		|ИЗ
		|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|ГДЕ
		|	CRM_СобытияПоРабочимЛистам.IDK = &IDK
		|	И CRM_СобытияПоРабочимЛистам.ВидСобытия = &ВидСобытия
		|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
		Запрос.УстановитьПараметр("IDK", Объект.IDK);
		Запрос.УстановитьПараметр("ВидСобытия", Справочники.CRM_ВидыСобытий.ТестДрайв);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			//Откроем форму завершения события
			Событие = Выборка.Ссылка;
			Событие.ПолучитьФорму("ФормаЗавершенияСобытия").Открыть();
		Иначе
			СоздатьЗаписьНаТестДрайв();
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьСписокТестДрайвов();
	Воронка_ОбновитьТестДрайв();
	
