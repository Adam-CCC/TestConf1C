&НаКлиенте
Процедура ДополнительноеОборудование(Команда)
	
	Если ТаблицаКП.Количество() > 0 Тогда
		
		СтруктураПоиска = Новый Структура("ОсновноеКП", Истина);
		НайденныеСтроки = ТаблицаКП.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаОсновноеКП = НайденныеСтроки[0];
		Иначе
			СтрокаОсновноеКП = Неопределено;
		КонецЕсли;
		
		Если СтрокаОсновноеКП = Неопределено Тогда
			Если ТаблицаКП.Количество()=1 Тогда
				СтрокаОсновноеКП = ТаблицаКП[0];
			Иначе
				Сообщить("Не выбрано основное коммерческое предложение");
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаОсновноеКП.Ссылка.ИнтересовалсяОборудованием Тогда		
			ОткрытьФормуКомПредложения(СтрокаОсновноеКП, Истина);	
		Иначе
			Сообщить("Клиент не интересовался оборудованием");
		КонецЕсли;
		
	Иначе
		Сообщить("Нет коммерческих предложений по рабочему листу");
	КонецЕсли;
	
КонецПроцедуры // ДополнительноеОборудование()

&НаКлиенте
Процедура ПродленнаяГарантия(Команда)
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаПрГарантию;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		ОткрытьЗначение(Запись.Объект);
	Иначе
	
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		Запись.IDK = Объект.IDK;
		Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаПрГарантиюВыполнена;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			ОткрытьЗначение(Запись.Объект);
		Иначе
				Док = Документы.Renault_CRM_ЗаявкаНаГарантию.СоздатьДокумент();
				Док.РабочийЛист = Объект.IDK;
				Док.ДилерскийЦентр = Объект.ДилерскийЦентр;
				Док.Клиент = Объект.Клиент;
								
				Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
				Запись.IDK = Объект.IDK;
				Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.КоммерческоеПредложение;
				Запись.Прочитать();
				
				Если Запись.Выбран() И ЗначениеЗаполнено(Запись.Объект) Тогда
					
					КПОбъект = Запись.Объект.ПолучитьОбъект();
					Если КПОбъект.Состав.Количество() > 1 Тогда
						
						Ответ = КПОбъект.Состав.Выгрузить().ВыбратьСтроку("В коммерческом предложении более одного автомобиля. Выберите подходящий.");
						Если ЗначениеЗаполнено(Ответ) Тогда
							КонфигурацияОбъект = Ответ.Конфигурация;
							Сумма = Ответ.Сумма;
						Иначе
							КонфигурацияОбъект = Справочники.CRM_КонфигурацииАвтомобилей.ПустаяСсылка();
						КонецЕсли;
						
					Иначе
						
						КонфигурацияОбъект = КПОбъект.Состав[0].Конфигурация;
						Сумма = КПОбъект.Состав[0].Сумма;
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(КонфигурацияОбъект) Тогда
						Запрос = Новый запрос("ВЫБРАТЬ
						                      |	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_MADC КАК ДатаВыпуска
						                      |ИЗ
						                      |	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
						                      |ГДЕ
						                      |	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN = &Вин");
						Запрос.УстановитьПараметр("Вин", ?(ЗначениеЗаполнено(КонфигурацияОбъект.Автомобиль), КонфигурацияОбъект.Автомобиль.VIN, Объект.VINАвтомобилей));
						ВыборкаДаты = Запрос.Выполнить().Выбрать();
						Если ВыборкаДаты.Следующий() Тогда
							Док.ДатаВыпуска = ВыборкаДаты.ДатаВыпуска;
						КонецЕсли;
						
						Док.Модель = КонфигурацияОбъект.Модель;
						Док.Версия = КонфигурацияОбъект.Версия;
						Док.Цвет = КонфигурацияОбъект.Цвет;
					КонецЕсли;
					
				КонецЕсли;
				
				ОткрытьЗначение(Док);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры // ПродленнаяГарантия()

&НаКлиенте
Процедура ТрейдИн(Команда)
	
	НовыйТрейдИН = Не ЗначениеЗаполнено(Объект.СвязаныйIDK); 
	
	ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
	
	НадписьСоздатьРабочийЛистТрейдИнНажатие(Неопределено);
	
