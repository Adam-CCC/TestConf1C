&НаСервере
Процедура Воронка_ОбновитьПосещениеАвтосалона(ЭтоТрейдИн = Ложь)
	
	Если ЭтоТрейдИн Тогда
		ИмяЭлемента = "ПосещениеАвтосалонаТрейдИн";
	Иначе
		ИмяЭлемента = "ПосещениеАвтосалона";
	КонецЕсли;	
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ПосещениеАвтосалона;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//Было посещение
		Если ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			ТекстДата = Формат(Запись.ДатаВыполнения, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
		КонецЕсли;
		Элементы[ИмяЭлемента].ЦветФона = ЦветRenault2;
		Элементы[ИмяЭлемента].Заголовок = "Посещение автосалона (" + ТекстДата + ")";
		Элементы[ИмяЭлемента].Картинка = ИзображениеСобытиеВыполнено; 
	Иначе
		//Не было посещения
		//Проверим наличие напоминания
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	CRM_СобытияПоРабочимЛистам.Ссылка,
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания
		|ИЗ
		|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
		|ГДЕ
		|	CRM_СобытияПоРабочимЛистам.IDK = &IDK
		|	И CRM_СобытияПоРабочимЛистам.ВидСобытия = &ВидСобытия
		|	И CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	CRM_СобытияПоРабочимЛистам.ДатаНапоминания";
		Запрос.УстановитьПараметр("IDK", Объект.IDK);
		Запрос.УстановитьПараметр("ВидСобытия", Справочники.CRM_ВидыСобытий.Встреча);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			//Есть напоминание
			Элементы[ИмяЭлемента].ЦветФона = ЦветКнопкиВоронкиСерый;
			Элементы[ИмяЭлемента].Заголовок = "Посещение автосалона";
			Элементы[ИмяЭлемента].Картинка = ИзображениеСобытиеЗапланировано;
			Если ЗначениеЗаполнено(Выборка.ДатаНапоминания) Тогда
				ТекстДата = Формат(Выборка.ДатаНапоминания, "ДФ=""дд.ММ.гггг 'в' ЧЧ:мм""");
				Элементы[ИмяЭлемента].Заголовок = "Посещение автосалона (" + ТекстДата + ")";
			КонецЕсли;
		Иначе
			//Нет напоминания
			Элементы[ИмяЭлемента].ЦветФона = ЦветКнопкиВоронкиСерый;
			Элементы[ИмяЭлемента].Заголовок = "Посещение автосалона";
			Элементы[ИмяЭлемента].Картинка = ИзображениеПустое;
		КонецЕсли;
		
	КонецЕсли;
	
