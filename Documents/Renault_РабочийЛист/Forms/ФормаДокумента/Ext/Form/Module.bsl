	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	ОбновитьДанныеCRM_КлиентскиеДанные();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеCRM_КлиентскиеДанные()
	
	Если Не ЗначениеЗаполнено(Объект.Клиент) Тогда 
		Возврат;
	КонецЕсли;
	ОбновитьДанные = Ложь;
	МенеджерЗаписи = РегистрыСведений.CRM_КлиентскиеДанные.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Клиент = Объект.Клиент;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		ОбновитьДанные = ?(МенеджерЗаписи.Город <> Клиент_Город Или МенеджерЗаписи.ИсточникИнформации <> Клиент_ИсточникИнформации,Истина,Ложь);
	//ВазСистем Тарасов 09.12.2020 11:53:24 Инцидент #DMSREN-1039
	//{
	//Старый код:
	//Новый код:
	Иначе 
		ОбновитьДанные = Истина;
	//}
	КонецЕсли; 	

	Если Не ОбновитьДанные Тогда 
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи.Клиент = Объект.Клиент; // DMSREN-1154
	МенеджерЗаписи.Город = Клиент_Город;
	МенеджерЗаписи.ИсточникИнформации = Клиент_ИсточникИнформации;
	МенеджерЗаписи.Записать();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|ГДЕ
	|	Renault_Трафик.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Объект.IDТрафика);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() и ЗначениеЗаполнено(Клиент_ИсточникИнформации) Тогда // DMSREN-1154
		
		ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьТрафик, Выборка);
		ЗаписьТрафик.Прочитать();
		ЗаписьТрафик.ИсточникИнформации = Клиент_ИсточникИнформации;  // DMSREN-1154
		ЗаписьТрафик.Записать();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(IDСледСобытия) Тогда
		СлужНастройки = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
		Если СлужНастройки.ЗапретНаЗакрытиеРЛБезСобытий тогда 
			Предупреждение("Согласно настройкам вашего ДЦ запрещено закрытие РЛ без назначения следующего события");
			Отказ = ИСТИНА;
		иначе
			Ответ = Вопрос("Ввести новое событие?", РежимДиалогаВопрос.ДаНет);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				СоздатьНовоеСобытие();
				Отказ = ИСТИНА;
				//Иначе
				//	ОбновитьСписокСобытий();
			КонецЕсли; 		
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЕмейл(Команда)
	
	//Емейл = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(ДокументОбъект.Клиент); 
	
	если ЗначениеЗаполнено(Клиент_Email) тогда
		
		сПараметры = Новый Структура;
		сПараметры.Вставить("ДЦ", Объект.ДилерскийЦентр);
		сПараметры.Вставить("Клиент_Email", Клиент_Email);
		Ответ = ОткрытьФормуМодально("Документ.Renault_Договор.Форма.ФормаОтвета", сПараметры, ЭтаФорма);
		Если Ответ <> Неопределено и Ответ.Результат Тогда
			ПоказатьПредупреждение(, "Ответ успешно отправлен");
		КонецЕсли; 
		
	иначе
		
		ПоказатьПредупреждение(, "У клиента не указан e-mail. Отправка невозможна");  		
		
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуПервичныйИнтерес()

	 ДоступнаРОП = Renault_РаботаСПравамиПользователя.ЕстьПравоИспользоватьАрмРОП(ПараметрыСеанса.Пользователь);

	 Запрос = Новый запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	CRM_ДилерскиеЦентрыПервичныйИнтерес.ПервичныйИнтерес.Ссылка КАК Модель,
	                |	CRM_ДилерскиеЦентрыПервичныйИнтерес.ПервичныйИнтерес.Модель.Артикул КАК Код
	                |ИЗ
	                |	Справочник.CRM_ДилерскиеЦентры.ПервичныйИнтерес КАК CRM_ДилерскиеЦентрыПервичныйИнтерес
	                |ГДЕ
	                |	CRM_ДилерскиеЦентрыПервичныйИнтерес.Ссылка = &ДЦ
	                |	И (CRM_ДилерскиеЦентрыПервичныйИнтерес.ПервичныйИнтерес.Модель.Артикул <> ""002""
	                |			ИЛИ &ДоступнаРОП)
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	CRM_ДилерскиеЦентрыПервичныйИнтерес.ПервичныйИнтерес.Наименование";
	 Запрос.УстановитьПараметр("ДоступнаРОП",ДоступнаРОП); 
	 Запрос.УстановитьПараметр("ДЦ",Объект.ДилерскийЦентр);
	 
	 возврат запрос.Выполнить().Выгрузить();
	 
КонецФункции



