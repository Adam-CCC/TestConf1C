// Возвращает менеджера трейд-ин
// 
// Возвращаемое значение:
//  СписокЗначений - Список сотрудников отдета трейд-ин
//
&НаСервере
Функция ПолучитьСотрудниковОтделаТрейдИн()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_Отделы.Ссылка
	               |ИЗ
	               |	Справочник.CRM_Отделы КАК CRM_Отделы
	               |ГДЕ
	               |	CRM_Отделы.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделТрейдИн)
	               |	И CRM_Отделы.ДилерскийЦентр = &ДилерскийЦентр";
	Запрос.УстановитьПараметр("ДилерскийЦентр", Объект.ДилерскийЦентр);
	Результат = Запрос.Выполнить();
	
	ОтделТрейдИн = Справочники.CRM_Отделы.ПустаяСсылка();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();		
		Выборка.Следующий();
			
		ОтделТрейдИн = Выборка.Ссылка;				
	КонецЕсли;	
		
	СписокСотрудниковТрейдИн = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(ОтделТрейдИн);
	СписокСотрудниковТрейдИн.Добавить(?(ЗначениеЗаполнено(ОтделТрейдИн), ОтделТрейдИн, Объект.Отдел));
	
	Возврат СписокСотрудниковТрейдИн;
	
КонецФункции // ПолучитьСотрудниковОтделаТрейдИн()

// Обрабатывает команду "СоздатьЗаявкуТрейдИн" на сервере
//
&НаСервере
Процедура СоздатьЗаявкуТрейдИнНаСервере(МенеджерТрейдИн)
	
	ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();	
	ТекущаяДата = ТекущаяДата();
	
	ДокументЗаявка = Документы.Renault_ЗаявкаНаТрейдИн.СоздатьДокумент();
	ДокументЗаявка.Дата = ТекущаяДата;
	ДокументЗаявка.МенеджерЗаявитель = ТекСотрудник; 
	ДокументЗаявка.РабочийЛист = Объект.IDK;
	ДокументЗаявка.ДилерскийЦентр = Объект.ДилерскийЦентр;
	ДокументЗаявка.Клиент = Объект.Клиент;
	ДокументЗаявка.Статус = Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.Черновик;
	ДокументЗаявка.ТипСделки = "ТрейдИн";
	ДокументЗаявка.ВычетДилера = Объект.ДилерскийЦентр.UsedCars_МаржаСумма;
	ДокументЗаявка.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ПроверкаНеВыполнялась;
	ДокументЗаявка.ТипОперацииTradeIn = ТипОперацииТрейдИн;
	Если ТипЗнч(МенеджерТрейдИн) = Тип("СправочникСсылка.CRM_Отделы") Тогда
		ДокументЗаявка.Отдел = МенеджерТрейдИн;
	Иначе
		ДокументЗаявка.МенеджерТрейдИн = МенеджерТрейдИн;
	КонецЕсли;
	ДокументЗаявка.Записать();	
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.Объект = ЗаявкаНаТрейдИн;
	Запись.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИн; 
	Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
	Запись.ДатаВыполнения = ТекущаяДата;
	Запись.Записать();
		
	Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	Событие.IDK = Объект.IDK;
	Событие.Дата = ТекущаяДата();
	Событие.Автор = ТекСотрудник;
	Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
	Событие.Комментарий = "Создание заявки на трейд-ин";
	Событие.ДатаНапоминания = ТекущаяДата;
	Событие.ДатаЗакрытия = ТекущаяДата;
	Событие.КомментарийЗакрытия = "Выполнено";
	Событие.АвторЗакрытия = ТекСотрудник;
	Событие.Сотрудник = ТекСотрудник;
	Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
	Если ТипЗнч(МенеджерТрейдИн) = Тип("СправочникСсылка.CRM_Отделы") Тогда
		Событие.Отдел = МенеджерТрейдИн;
	Иначе
		Событие.Сотрудник = МенеджерТрейдИн;
	КонецЕсли;
	Событие.Записать();
	
	ЗаявкаНаТрейдИн = ДокументЗаявка.Ссылка;
	
	ПроизводительТрейдИн = "";
	ГодВыпускаТрейдИн = "";
	МодельТрейдИн = "";
	ОжидаемаяСтоимостьКлиентаТрейдИн = 0;
	
	ПараметрыУправленияЭлементами = Новый Структура();
	ПараметрыУправленияЭлементами.Вставить("ГодВыпускаТрейдИн", Ложь);
	ПараметрыУправленияЭлементами.Вставить("МодельТрейдИн", Ложь);
	ПараметрыУправленияЭлементами.Вставить("ОжидаемаяСтоимостьКлиентаТрейдИн", Ложь);
	
	ОбновитьИнтерфейсТрейдИн(ПараметрыУправленияЭлементами);
	
КонецПроцедуры // СоздатьЗаявкуТрейдИнНаСервере()	

// Проверка на наличие заявок трейд-ин
// 
// Возвращаемое значение:
//  Булево - Есть заявки трейд-ин
//
&НаСервере
Функция ПроверитьСозданныеЗаявкиТрейдИн()

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТипОперацииTradeIn", ТипОперацииТрейдИн);
	Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_ЗаявкаНаТрейдИн.Ссылка
	|ИЗ
	|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|ГДЕ
	|	НЕ Renault_ЗаявкаНаТрейдИн.ПометкаУдаления
	|	И Renault_ЗаявкаНаТрейдИн.ТипОперацииTradeIn = &ТипОперацииTradeIn
	|	И Renault_ЗаявкаНаТрейдИн.РабочийЛист = &РабочийЛист";
				   
	Возврат Не Запрос.Выполнить().Пустой();
				   
КонецФункции // ПроверитьСозданныеЗаявкиТрейдИн()

// Оповещение "ОбновитьФормуЗаписи"
//
&НаКлиенте
Процедура ОбработкаОповещенияФормыЗаписи()
	
	СтруктураПервичныйИнтерес = Новый Структура;
	СтруктураПервичныйИнтерес.Вставить("IDK", 				Объект.IDK);
	СтруктураПервичныйИнтерес.Вставить("ПервичныйИнтерес",	Объект.ПервичныйИнтересМодель);
	
	Оповестить("ОбновитьФормуЗаписи",СтруктураПервичныйИнтерес);  
	
КонецПроцедуры // ОбработкаОповещенияФормыЗаписи() 

// Открывает форму со списком рабочих листов
//
&НаКлиенте
Процедура ОткрытьПоискЛистов()
	
	// TO DO тут скорее всего придется сделать какую то свою форму или переделать АРМ менеджеров на РЛ-документы
	Форма = Обработки.Renault_ARM_Менеджеры.ПолучитьФорму("Форма");
	
	Если Форма.Открыта() Тогда
		
		Форма.Закрыть();
		
	КонецЕсли;
	
	Если Объект.ТипРабочегоЛиста <> Перечисления.Renault_ТипыРабочихЛистов.TradeIn Тогда
		
		Форма.ВнешнийПоискОтборТиповЛистов = Перечисления.Renault_ТипыРабочихЛистов.TradeIn;
		
	КонецЕсли;
	
	Форма.ЭтоВнешнийПоискЛистов = Истина;
	
	СвязаныйIDKполуч = Форма.ОткрытьМодально();
	
	Если ЗначениеЗаполнено(СвязаныйIDKполуч) Тогда
		
		СвязаныйIDK = СвязаныйIDKполуч;
		
		Элементы.НадписьСоздатьРабочийЛистТрейдИн.Заголовок = "Открыть связаный рабочий лист";
		Элементы.НадписьСоздатьРабочийЛистПродажа.Заголовок = "Открыть связаный рабочий лист";
		Элементы.НадписьПривязатьРабочийЛистПродажа.Заголовок = "Отвязать текущий и привязать другой рабочий лист";
		Элементы.ПривязатьСоздатьРабочийЛистТрейдИн.Заголовок = "Отвязать текущий и привязать другой рабочий лист";
		
	КонецЕсли;
	
КонецПроцедуры // ОткрытьПоискЛистов()

// Создает запись в РС "CRM_ВоронкаПродаж" по этапу продаж
//
// Параметры:
//  ЭтапПродаж	 - СправочникСсылка.CRM_ЭтапыПродаж	 - Этап продаж
//
&НаСервере
Процедура СоздатьЗаписьВоронкиПродаж(ЭтапПродаж)
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;
	Запись.ЭтапПродаж = ЭтапПродаж;
	Запись.Прочитать();
	Если НЕ Запись.Выбран() Тогда
		Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Запись.ДатаВыполнения = ТекущаяДата();
		Запись.Объект = Документы.Renault_ЗаявкаНаТрейдИн.НайтиПоРеквизиту("РабочийЛист", Объект.IDK)
	КонецЕсли;
	
КонецПроцедуры // СоздатьЗаписьВоронкиПродаж()

// Создает новое событие по рабочему листу
//
&НаКлиенте
Процедура СоздатьНовоеСобытие()
	
	ФормаСобытия = ПолучитьФорму("Документ.CRM_СобытияПоРабочимЛистам.Форма.ФормаСозданияСобытия");
	
	ФормаСобытия.IDK 				= Объект.IDK;
	ФормаСобытия.ВидСобытия 		= Справочники.CRM_ВидыСобытий.Прочее;
	ФормаСобытия.Сотрудник 			= Объект.Сотрудник;
	ФормаСобытия.Отдел 				= Объект.Отдел;
	ФормаСобытия.ДилерскийЦентр 	= Объект.ДилерскийЦентр;
	ФормаСобытия.Подразделение 		= Объект.Подразделение;
	ФормаСобытия.Открыть();
			
КонецПроцедуры // СоздатьНовоеСобытие()

// Возвращает список событий трейд-ин по IDK
//
// Параметры:
//  IDK	 - Строка	 - IDK событий
// 
// Возвращаемое значение:
//  СписокЗначений - Список событий трейд-ин по IDK
//
&НаСервереБезКонтекста
Функция ПолучитьСписокСобытийТрейдИн(IDK)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_СобытияПоРабочимЛистам.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	               |ГДЕ
	               |	CRM_СобытияПоРабочимЛистам.IDK = &IDK
	               |	И НЕ CRM_СобытияПоРабочимЛистам.ПометкаУдаления
	               |	И НЕ CRM_СобытияПоРабочимЛистам.Обработано
	               |	И CRM_СобытияПоРабочимЛистам.ВидСобытия = ЗНАЧЕНИЕ(Справочник.CRM_ВидыСобытий.ОценкаТрейдИн)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	CRM_СобытияПоРабочимЛистам.МоментВремени";
	Запрос.УстановитьПараметр("IDK", IDK);
	Результат = Запрос.Выполнить();
	
	СписокСобытий = Новый СписокЗначений;
	
	Выборка = Запрос.Выполнить();
	
	Пока Выборка.Следующий() Цикл
		СписокСобытий.Добавить(Выборка.Ссылка);	
	КонецЦикла;
	
	Возврат СписокСобытий;
	
КонецФункции // ПолучитьСписокСобытийТрейдИн()

// Возвращает есть ли необработанные события по рабочему листу
// 
// Возвращаемое значение:
//  Булево - Признак наличия необработанных событий по рабочему листу
//
&НаСервере
Функция ЕстьСобытияПоРЛ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_СобытияПоРабочимЛистам.Ссылка
	|ИЗ
	|	Документ.CRM_СобытияПоРабочимЛистам КАК CRM_СобытияПоРабочимЛистам
	|ГДЕ
	|	CRM_СобытияПоРабочимЛистам.Обработано = ЛОЖЬ
	|	И CRM_СобытияПоРабочимЛистам.IDK = &IDK";
	
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции // ЕстьСобытияПоРЛ()

// Возвращает массив невыполненных заявок на сервис по рабочему листу
// 
// Возвращаемое значение:
//  Массив - Массив заявок
//
&НаСервере
Функция ПолучитьНеВыполненныеЗаявкиНаСервис()
	
	МассивЗаявок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаСервис.Ссылка
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаСервис.Обращение.IDK = &IDK
	|	И НЕ Renault_CRM_ЗаявкаНаСервис.ПометкаУдаления
	|	И Renault_CRM_ЗаявкаНаСервис.Состояние В (&Состояние)";
	
	Запрос.УстановитьПараметр("IDK", Объект.IDK);
	СостоянияЗаявок = Новый СписокЗначений;
	СостоянияЗаявок.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Заявка);
	СостоянияЗаявок.Добавить(Справочники.ВидыСостоянийЗаказНарядов.ПустаяСсылка());	
	Запрос.УстановитьПараметр("Состояние", СостоянияЗаявок);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		МассивЗаявок.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат МассивЗаявок;
	
КонецФункции // ПолучитьНеВыполненныеЗаявкиНаСервис()

// Устанавливает пометки удаления для выполненных заявок на сервис
// 
// Возвращаемое значение:
//  Булево - Результат выполнения
//
&НаКлиенте
Функция ПометитьНеВыполненныеЗаявкиНаСервис()
	
	МассивЗаявок = ПолучитьНеВыполненныеЗаявкиНаСервис();
	
	Если МассивЗаявок.Количество() > 0 Тогда
			
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ОК", "Ок");
		Кнопки.Добавить("Заполнить", "Заполнить");
		Кнопки.Добавить("Отмена", "Отмена");
		
		Ответ = Вопрос(НСтр("ru = 'По этому рабочему листу есть заявки которые имеют статус ""незаполненные"", которые будут помечены на удаление!!!';"),Кнопки);
		Если Ответ = "ОК" Тогда
			Для Каждого Заявка Из МассивЗаявок Цикл
				ДокЗаявка = Заявка.ПолучитьОбъект();
				Если ДокЗаявка.Проведен Тогда
					ДокЗаявка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				ДокЗаявка.ПометкаУдаления = Истина;
				Попытка
					ДокЗаявка.Записать();
				Исключение
					Сообщить("Не удалось пометить на удаление не выполненные заявки на сервис");
				КонецПопытки;
			КонецЦикла;
			Возврат Ложь;
		ИначеЕсли Ответ = "Заполнить" тогда
			
			Для Каждого Заявка из МассивЗаявок Цикл
				ПараметрыФормы = Новый Структура("Ключ", Заявка);
                ОткрытьФорму("Документ.Renault_CRM_ЗаявкаНаСервис.Форма.ФормаДокумента", ПараметрыФормы);
			КонецЦикла;
			Возврат Истина;
		ИначеЕсли Ответ = "Отмена" тогда
			Возврат Истина;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ПометитьНеВыполненныеЗаявкиНаСервис()

// Проверяет есть ли поступление на склад по авто
//
// Параметры:
//  АвтомобильПроверки	 - СправочникСсылка.Автомобили	 - Проверямый автомобиль
// 
// Возвращаемое значение:
//  Булево - Есть поступление на склад
//
&НаСервере
Функция ПроверитьНаличиеПоступленияНаСклад(АвтомобильПроверки)

	Если Не ЗначениеЗаполнено(АвтомобильПроверки) Тогда
		Ошибки = "В заявке на трейд-ин не указан автомобиль";
		Сообщить(Ошибки);
		Возврат Ложь;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	ВводОстатковАвтомобилейАвтомобили.Ссылка
	|ИЗ
	|	Документ.ВводОстатковАвтомобилей.Автомобили КАК ВводОстатковАвтомобилейАвтомобили
	|ГДЕ
	|	ВводОстатковАвтомобилейАвтомобили.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", АвтомобильПроверки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции // ПроверитьНаличиеПоступленияНаСклад()

// Проверяет есть ли этап посещения автосалона, если нет, то создает его
