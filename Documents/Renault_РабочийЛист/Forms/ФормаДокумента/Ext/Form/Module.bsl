		Событие.ДатаЗакрытия = ТекущаяДата();
		Событие.КомментарийЗакрытия = "Выполнено";
		Событие.АвторЗакрытия = ТекСотрудник;
		Событие.Сотрудник = ТекСотрудник;
		Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Событие.Записать();
		ОбновитьВоронкуИСписки();
	КонецЕсли;
	
