&НаКлиенте
Процедура СогласиеНаОбработкуПД(Команда)
	
	Если Объект.Клиент.Пустая() Тогда 
		Сообщить("Клиент не записан"); 
		Возврат 
	КонецЕсли;
	
	Оповещение=Новый ОписаниеОповещения("ОбновитьСогласиеНаОД",ЭтаФорма);
	
	Если ЗначениеЗаполнено(ДокументСогласиеНаОбработкуПерсональныхДанных) тогда
		ОткрытьЗначение(ДокументСогласиеНаОбработкуПерсональныхДанных);	
	иначе
		ОткрытьФорму("Документ.DMS_СогласиеНаОбработкуПерсональныхДанных.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", Новый Структура("ФизическоеЛицо",Объект.Клиент)),ЭтаФорма,2,,,Оповещение); 
	КонецЕсли;
	
