&НаКлиенте
Процедура ПервичныйИнтересМодельПриИзменении(Элемент)
	
	//При изменении первичного интереса будем записывать изменение первичного интереса в трафик			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|ГДЕ
	|	Renault_Трафик.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Объект.IDТрафика);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьТрафик, Выборка);
		ЗаписьТрафик.Прочитать();
		ЗаписьТрафик.ПервичныйИнтерес = Объект.ПервичныйИнтересМодель;
		ЗаписьТрафик.Записать();
		ЗаписатьРабочийЛист();
		
	КонецЕсли;
	
	Если ТекущийЭлемент.Имя = "ВыбратьГарантия" И Объект.Гарантия = "Нет" Тогда
		СрокГарантии = 0;
		Элементы.СрокГарантии.Доступность = Ложь
	Иначе
		Элементы.СрокГарантии.Доступность = Истина
	КонецЕсли; 
	
	ОбработкаОповещенияФормыЗаписи();
	
КонецПроцедуры // ПервичныйИнтересМодельПриИзменении()

&НаКлиенте
Процедура Клиент_ИсточникИнформацииПриИзменении(Элемент)
	
	
	//+++
	//Сохраняем данные когда сохраняется документ
	ЭтаФорма.Модифицированность = Истина;
	Возврат;
	//---
	СохранитьИсточникИнформации();
	
	//При изменении источника информации будем записывать изменение источника информации в трафик
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	|ГДЕ
	|	Renault_Трафик.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Объект.IDТрафика);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаписьТрафик = РегистрыСведений.Renault_Трафик.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьТрафик, Выборка);
		ЗаписьТрафик.Прочитать();
		ЗаписьТрафик.ПервичныйИнтерес = Клиент_ИсточникИнформации;
		ЗаписьТрафик.Записать();
		ЗаписатьРабочийЛист();
		
	КонецЕсли;
	
	ОбработкаОповещенияФормыЗаписи();
	
КонецПроцедуры // Клиент_ИсточникИнформацииПриИзменении()

