// Обработка оповещения создания обращения
//
&НаКлиенте
Процедура СоздатьОбращениеПродолжение(Параметр, Источник)
	
	ПолученныеДанные = Параметр;
	ФормаОбращения = Источник;
	
	ТекущаяДата = ТекущаяДата();
	
	НовоеОбращение = ФормаОбращения.ДокументОбъект;
	
	Если НЕ ЗначениеЗаполнено(ПолученныеДанные) Тогда
		ТипВызова = "Закрытие";
	Иначе
		ТипВызова = ПолученныеДанные.ТипВызова;
	КонецЕсли; 		
	
	Если ТипВызова = "Закрытие" ИЛИ ТипВызова = "Упущен" ИЛИ ТипВызова = "СохранитьИЗакрытьЗаявку" ИЛИ 
		ТипВызова = "СохранятьОбращение" Тогда
						
		ЭтапОценкаСервисом = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнДиагностикаВСервисе;
		
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		Запись.IDK = Объект.IDK;	
		Запись.ЭтапПродаж = ЭтапОценкаСервисом;
		Запись.Прочитать();
		
		Если Не Запись.Выбран() Тогда
			Запись.IDK = Объект.IDK;
			Запись.Объект = ЗаявкаНаТрейдИн;
			Запись.ЭтапПродаж = ЭтапОценкаСервисом; 
			Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
			Запись.ДатаВыполнения = ТекущаяДата();
			Запись.Записать();
		КонецЕсли;	
			
		ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
		
		Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
		Событие.IDK = Объект.IDK;
		Событие.Дата = ТекущаяДата;
		Событие.Автор = ТекСотрудник;
		Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
		Событие.Комментарий = "Создание заявки на диагностику по трейд-ин";
		Событие.ДатаНапоминания = ТекущаяДата;
		Событие.ДатаЗакрытия = ТекущаяДата;
		Событие.АвторЗакрытия = ТекСотрудник;
		Событие.Сотрудник = ЗаявкаНаТрейдИн.МенеджерЗаявитель;
		Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Событие.ЗавершеноУспешно = Истина;
		Событие.Обработано = Истина;
		Событие.КомментарийЗакрытия = "Выполнено";
		Событие.Записать();
		
		ПриемкаВСервис = Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту("Обращение", НовоеОбращение.Ссылка); 
		
		Если ЗначениеЗаполнено(ПриемкаВСервис) Тогда
			
			МастерПриемщик = ПриемкаВСервис.Машиноместо;
			
			Если НЕ ЗначениеЗаполнено(МастерПриемщик) Тогда
				
				ТаблицаМастеров = Renault_АвтосервисОбщий.ПолучитьМастеровПриемщиковДЦ(Объект.ДилерскийЦентр);
				СписокМастеров = Новый СписокЗначений;
				СписокМастеров.ЗагрузитьЗначения(ТаблицаМастеров.ВыгрузитьКолонку("Сотрудник"));
				ФормаВыбораПлиткой = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
				ФормаВыбораПлиткой.Заголовок = "Для создания обращения в сервис укажите мастера-приемщика";
				ФормаВыбораПлиткой.СписокВыбора = СписокМастеров;
				МастерПриемщик = ФормаВыбораПлиткой.ОткрытьМодально();
				Если НЕ ЗначениеЗаполнено(МастерПриемщик) Тогда
					Предупреждение("Не выбран мастер-приемщик");
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
		Напоминание.Отправитель = ТекСотрудник;
		Напоминание.Адресаты.Добавить().Сотрудник = МастерПриемщик; 
		Напоминание.ДатаОтправки = ТекущаяДата;
		Напоминание.Комментарий = Событие.Комментарий;
		Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.ДиагностикаТрейдИн;
		Напоминание.ПоказыватьС = ТекущаяДата;
		Напоминание.Наименование ="Диагностика трейд-ин";
		Напоминание.Сообщение = "Создана заявка на диагностику трейд-ин";
		Напоминание.ИдентификаторОбъекта = Строка(НовоеОбращение.Ссылка.УникальныйИдентификатор());
		Напоминание.Записать();
		Сообщить("Создано " + НовоеОбращение.Ссылка);
		
		ОбновитьВоронкуИСпискиТрейдИн(); 		

	ИначеЕсли ТипВызова = "НеСохранятьОбращение" Тогда
		НовоеОбращение.ПометкаУдаления = Истина;
		НовоеОбращение.Записать();
	КонецЕсли;
	
КонецПроцедуры // СоздатьОбращениеПродолжение()

// Создание события визуального осмотра
//
&НаСервере
Процедура РегистрацияВизуальногоОсмотра()
	
	ЭтапВизуальныйОсмотр = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнВизуальныйОсмотр;
	
	Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	Запись.IDK = Объект.IDK;	
	Запись.ЭтапПродаж = ЭтапВизуальныйОсмотр;
	Запись.Прочитать();
	
	Если Не Запись.Выбран() Тогда
		ТекущаяДата = ТекущаяДата();
		ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
		
		Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
		Событие.IDK = Объект.IDK;
		Событие.Дата = ТекущаяДата;
		Событие.Автор = ТекСотрудник;
		Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
		Событие.Комментарий = "Визуальный осмотр по трейд-ин";
		Событие.ДатаНапоминания = ТекущаяДата;
		Событие.ДатаЗакрытия = ТекущаяДата;
		Событие.КомментарийЗакрытия = "Выполнено";
		Событие.АвторЗакрытия = ТекСотрудник;
		Событие.Сотрудник = ЗаявкаНаТрейдИн.МенеджерЗаявитель;
		Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Событие.Записать();
		
		Запись.IDK = Объект.IDK;
		Запись.Объект = ЗаявкаНаТрейдИн;
		Запись.ЭтапПродаж = ЭтапВизуальныйОсмотр; 
		Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
		Запись.ДатаВыполнения = ТекущаяДата;
		Запись.Записать();
	КонецЕсли;	
	
	ОбновитьВоронкуИСпискиТрейдИн();
	
КонецПроцедуры // РегистрацияВизуальногоОсмотра()

// Создание события регистрации данных автомобиля
//
&НаСервере
Процедура РегистрацияЗаполненияДанныхАвтомобиля()
	
	ПроизводительТрейдИн = ЗаявкаНаТрейдИн.ПроизводительКод;
	ГодВыпускаТрейдИн = ЗаявкаНаТрейдИн.ГодВыпуска;
	МодельТрейдИн = ЗаявкаНаТрейдИн.МодельКод;		
	
	ЗаполнитьСписокВыбораЭлемента("ПроизводительТрейдИн");
	
	Если ЗначениеЗаполнено(ПроизводительТрейдИн) Тогда
		ЗаполнитьСписокВыбораЭлемента("ГодВыпускаТрейдИн");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГодВыпускаТрейдИн) Тогда
		ЗаполнитьСписокВыбораЭлемента("МодельТрейдИн");
	КонецЕсли;			
	
	ПараметрыУправленияЭлементами = Новый Структура();
	ПараметрыУправленияЭлементами.Вставить("ГодВыпускаТрейдИн", ЗначениеЗаполнено(ПроизводительТрейдИн));
	ПараметрыУправленияЭлементами.Вставить("МодельТрейдИн", ЗначениеЗаполнено(ГодВыпускаТрейдИн));
	ПараметрыУправленияЭлементами.Вставить("ОжидаемаяСтоимостьКлиентаТрейдИн", ЗначениеЗаполнено(МодельТрейдИн));

	ОбновитьИнтерфейсТрейдИн(ПараметрыУправленияЭлементами);	
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн.Автомобиль) Тогда		
		ЭтапЗаполнениеАвто = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнЗаполнениеДанныхАвтомобиля;
		
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		Запись.IDK = Объект.IDK;	
		Запись.ЭтапПродаж = ЭтапЗаполнениеАвто;
		Запись.Прочитать();
		
		Если Не Запись.Выбран() Тогда
			ТекущаяДата = ТекущаяДата();
			ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
			
			Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
			Событие.IDK = Объект.IDK;
			Событие.Дата = ТекущаяДата;
			Событие.Автор = ТекСотрудник;
			Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
			Событие.Комментарий = "Заполнение данных автомобиля по трейд-ин";
			Событие.ДатаНапоминания = ТекущаяДата;
			Событие.ДатаЗакрытия = ТекущаяДата;
			Событие.КомментарийЗакрытия = "Выполнено";
			Событие.АвторЗакрытия = ТекСотрудник;
			Событие.Сотрудник = ЗаявкаНаТрейдИн.МенеджерЗаявитель;
			Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
			Событие.Записать();
			
			Запись.IDK = Объект.IDK;
			Запись.Объект = ЗаявкаНаТрейдИн;
			Запись.ЭтапПродаж = ЭтапЗаполнениеАвто; 
			Запись.ДилерскийЦентр = Объект.ДилерскийЦентр;
			Запись.ДатаВыполнения = ТекущаяДата;
			Запись.Записать();
		КонецЕсли;
	Иначе
		Сообщить("Автомобиль не создан!");
	КонецЕсли;
	
	ОбновитьВоронкуИСпискиТрейдИн();
	
КонецПроцедуры // РегистрацияЗаполненияДанныхАвтомобиля()

// Регистрация события предложения выкупа по трейд-ин
//
// Параметры:
//  ДокументПредложениеВыкупа	 - ДокументСсылка.Renault_ПредложениеВыкупаАвтомобиляТрейдИн	 -  Документ предложения выкупа
//
