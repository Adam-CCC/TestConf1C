// Возвращает актуальный документ предварительной оценки
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_ПредварительнаяОценкаАвтомобиляТрейдИн - Актуальный документ
//
&НаСервере
Функция АктуальныйДокументПредварительнойОценки()
	
	ДокументОценки = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ЗаявкаНаТрейдИн.ОриентировочнаяЦена,
	|	Renault_ЗаявкаНаТрейдИн.ДатаОценки
	|ПОМЕСТИТЬ ДанныеЗаявкиНаТрейдИн
	|ИЗ
	|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|ГДЕ
	|	Renault_ЗаявкаНаТрейдИн.Ссылка = &ЗаявкаНаТрейдИн
	|	И Renault_ЗаявкаНаТрейдИн.ОриентировочнаяЦена <> 0
	|	И Renault_ЗаявкаНаТрейдИн.ДатаОценки <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_ПредварительнаяОценкаАвтомобиляТрейдИн.Ссылка КАК ДокументОценки
	|ИЗ
	|	Документ.Renault_ПредварительнаяОценкаАвтомобиляТрейдИн КАК Renault_ПредварительнаяОценкаАвтомобиляТрейдИн
	|ГДЕ
	|	Renault_ПредварительнаяОценкаАвтомобиляТрейдИн.ЗаявкаНаТрейдИн = &ЗаявкаНаТрейдИн
	|	И (Renault_ПредварительнаяОценкаАвтомобиляТрейдИн.ОриентировочнаяЦена, Renault_ПредварительнаяОценкаАвтомобиляТрейдИн.ДатаОценки) В
	|			(ВЫБРАТЬ
	|				ДанныеЗаявкиНаТрейдИн.ОриентировочнаяЦена,
	|				ДанныеЗаявкиНаТрейдИн.ДатаОценки
	|			ИЗ
	|				ДанныеЗаявкиНаТрейдИн КАК ДанныеЗаявкиНаТрейдИн)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_ПредварительнаяОценкаАвтомобиляТрейдИн.МоментВремени УБЫВ";	
	Запрос.УстановитьПараметр("ЗаявкаНаТрейдИн", ЗаявкаНаТрейдИн);	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		ДокументОценки = Выборка.ДокументОценки;
	КонецЕсли; 
	
	Возврат ДокументОценки;
	
КонецФункции // АктуальныйДокументПредварительнойОценки()

// Создает новое обращение в сервис или предлагает выбор существующего
//
&НаКлиенте
Процедура СоздатьОбращениеВСервис()
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК Документ,
	|	Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения КАК ВидОбращения,
	|	Renault_CRM_ОбращениеВАвтоСервис.Менеджер КАК Менеджер
	|ИЗ
	|	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|		ПО Renault_CRM_ОбращениеВАвтоСервис.Клиент = Renault_ЗаявкаНаТрейдИн.Клиент
	|			И Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = Renault_ЗаявкаНаТрейдИн.Автомобиль
	|ГДЕ
	|	Renault_ЗаявкаНаТрейдИн.Ссылка = &Ссылка
	|	И Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения = &ВидОбращения
	|	И Renault_CRM_ОбращениеВАвтоСервис.ПометкаУдаления = ЛОЖЬ
	|	И Renault_ЗаявкаНаТрейдИн.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ВидОбращения", Справочники.Renault_ВидыОбращенийВАвтосервис.ДиагностикаТрейдИн);
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаНаТрейдИн);
	
	Выборка = Запрос.Выполнить();
	Если НЕ Выборка.Пустой() Тогда
		Форма = Документы.Renault_ЗаявкаНаТрейдИн.ПолучитьФорму("ФормаВыбораОбращений");
		ЗначениеВДанныеФормы(Выборка.Выгрузить(), Форма.ТаблицаОбращений);
		Результат = Форма.ОткрытьМодально();
		Если ЗначениеЗаполнено(Результат) и ТипЗнч(Результат) = Тип("ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис")  тогда  
			Форма = ПолучитьОбщуюФорму("Renault_АвтосервисФормаДеталейОбращения");
			Форма.Обращение = Результат; 				
			Форма.Открыть();		
		ИначеЕсли ЗначениеЗаполнено(Результат) и Результат = "Создать новый" тогда
			СоздатьНовоеОбращение();
		КонецЕсли;
	Иначе
		СоздатьНовоеОбращение();
	КонецЕсли;
	
КонецПроцедуры // СоздатьОбращениеВСервис()

// Создает новое обращение в автосервис
//
&НаКлиенте
Процедура СоздатьНовоеОбращение()
	
	НовоеОбращение = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
	НовоеОбращение.Дата = ТекущаяДата();
	НовоеОбращение.Менеджер = ПараметрыСеанса.Пользователь;
	НовоеОбращение.ОбращениеОбработано = Истина;
	НовоеОбращение.Клиент = ЗаявкаНаТрейдИн.Клиент;
	НовоеОбращение.Автомобиль = ЗаявкаНаТрейдИн.Автомобиль;
	НовоеОбращение.ВидОбращения = Справочники.Renault_ВидыОбращенийВАвтосервис.ДиагностикаТрейдИн;
	НовоеОбращение.ПервичныйПовторный = Перечисления.CRM_ПервичныйПовторный.Повторный;
	НовоеОбращение.IDK = ЗаявкаНаТрейдИн.РабочийЛист;
	НовоеОбращение.Записать();
    НовоеОбращениеСсылка = НовоеОбращение.Ссылка;
	Обработка = Обработки.Renault_АвтосервисВыборВерсии.Создать();
	
	Если Объект.ДилерскийЦентр.Автосервис_ИспользуетсяНоваяВерсияВ2 = Истина ТОГДА
		ФормаАвтосервис2 = Обработки.CRM_АРМ_АвтоСервис_4.ПолучитьФорму("Форма");
	Иначе
		ФормаАвтосервис2 = Обработки.CRM_АРМ_АвтоСервис_2.ПолучитьФорму("Форма");
	КонецЕсли;

	Обработка.ВнешнийЗапрос(НовоеОбращениеСсылка, ЗаявкаНаТрейдИн.Клиент, ЗаявкаНаТрейдИн.Автомобиль, ФормаАвтосервис2);
	
КонецПроцедуры // СоздатьНовоеОбращение()

// Создает калькуляцию ремонта трейд-ин
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_Калькуляция - Ссылка на созданную калькуляцию
//
&НаКлиенте
Функция СоздатьКалькуляцию()
	
	Заявки = НайтиЗаявки();
	
	Если Заявки.Количество() > 1 Тогда			
		Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
		СписокВыбора = Новый СписокЗначений;
			
		СписокВыбора.ЗагрузитьЗначения(Заявки.ВыгрузитьКолонку("Заявка"));
			
		Форма.Заголовок = "Выберите в какую заявку добавлеяем.";
		Форма.СписокВыбора = СписокВыбора;
		
		Заявка = Форма.ОткрытьМодально();
		Если НЕ ЗначениеЗаполнено(Заявка) Тогда
			Предупреждение("Не выбрана заявка!");
			Возврат Неопределено;
		КонецЕсли; 				
	ИначеЕсли Заявки.Количество() = 1 Тогда		
		Заявка = Заявки[0].Заявка;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Заявка) Тогда
		Сообщить("Нет заявки в автосервис!");
		Возврат Неопределено;		
	КонецЕсли;
	
	Калькуляции = ПолучитьКалькуляцииПоЗаявке(Заявка);
	Если Калькуляции.Количество() > 0 Тогда		
		Калькуляция = Калькуляции[0].Значение;
	Иначе
		Калькуляция = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Калькуляция) Тогда
		ВопросПользователю = Вопрос("Найден документ калькуляции, открыть его (да) или создать новый (нет)?", РежимДиалогаВопрос.ДаНет);
					
		Если ВопросПользователю = КодВозвратаДиалога.Нет Тогда
			Калькуляция = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Калькуляция) Тогда 		
		Калькуляция = Документы.Renault_Калькуляция.СоздатьДокумент();
		
		Калькуляция.Контрагент = ЗаявкаНаТрейдИн.Клиент;
		Калькуляция.Автомобиль = ЗаявкаНаТрейдИн.Автомобиль;
		Калькуляция.ТипЦен = Заявка.ТипЦен;
		Калькуляция.Нормочас = Заявка.Нормочас;
		Калькуляция.ДокументОснование = Заявка;		
	Иначе		
		Калькуляция = Калькуляция.Ссылка.ПолучитьОбъект(); 		
	КонецЕсли;
	
	ФормаКалькуляции = Калькуляция.ПолучитьФорму();
	ФормаКалькуляции.ОткрытьМодально();
	
	Возврат Калькуляция.Ссылка;
	
КонецФункции // СоздатьКалькуляцию()

// Пересчитывает суммы заявки на трейд-ин
//
&НаКлиенте
Процедура ПересчитатьСтоимостьВосстановления()
	
	ЗаявкаОбъект = ЗаявкаНаТрейдИн.ПолучитьОбъект();
	

	ЗаявкаОбъект.ЗатратыНаВосстановлениеПослеДиагностики = 0;
	ТабРезультатыДиагностикиRenaultSelection = ЗаявкаОбъект.РезультатыДиагностикиRenaultSelection;
	
	Для Каждого Строка Из ТабРезультатыДиагностикиRenaultSelection Цикл
		ЗаявкаОбъект.ЗатратыНаВосстановлениеПослеДиагностики = 
			ЗаявкаОбъект.ЗатратыНаВосстановлениеПослеДиагностики
			+ Строка.СтоимостьЗапчасти
			+ Строка.СтоимостьРаботы;
	КонецЦикла;	
	
	СтоимостьВосстановленияПоКалькуляции = 0;
	СписокКалькуляции = Документы.Renault_Калькуляция.НайтиКалькуляциюПоЗаявкеНаТрейдИн(ЗаявкаОбъект.Ссылка);
	Если СписокКалькуляции.Количество() = 1 Тогда
		СтоимостьВосстановленияПоКалькуляции = Документы.Renault_Калькуляция.ПолучитьИтого(СписокКалькуляции[0].Ссылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаОбъект.ОриентировочнаяЦена) Тогда		
		МаржаСумма = Объект.ДилерскийЦентр.UsedCars_МаржаСумма;
		МаржаПроцент = Объект.ДилерскийЦентр.UsedCars_МаржаПроцент;
		МаржаСуммаПоПроценту = МаржаПроцент * (ЗаявкаОбъект.ОриентировочнаяЦена - 
			ЗаявкаОбъект.ЗатратыНаВосстановлениеПослеДиагностики - СтоимостьВосстановленияПоКалькуляции) / 100;
		
		ЗаявкаОбъект.ВычетДилера = ?(ЗначениеЗаполнено(МаржаСумма), МаржаСумма, МаржаСуммаПоПроценту);  

		ЗаявкаОбъект.ЦенаВыкупа = ЗаявкаОбъект.ОриентировочнаяЦенаСреднее - ЗаявкаОбъект.ЗатратыНаВосстановлениеПослеДиагностики - СтоимостьВосстановленияПоКалькуляции - ЗаявкаОбъект.ВычетДилера;
	КонецЕсли;
		
	ЗаявкаОбъект.Записать();
	
КонецПроцедуры // ПересчитатьСтоимостьВосстановления()

// Возвращает таблицу заявок на сервис
// 
// Возвращаемое значение:
// ТаблицаЗначений  -  Таблица заявок на сервис
//
&НаСервере
Функция НайтиЗаявки()
	
	Обращение = ПолучитьОбращениеПоЗаявкеНаТрейдИн();
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК Заявка
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаСервис.Обращение.Ссылка = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции // НайтиЗаявки()

// Возвращает обращение по заявке на трейд-ин
// 
// Возвращаемое значение:
//  ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис - Обращение по заявке
//
&НаСервере
Функция ПолучитьОбращениеПоЗаявкеНаТрейдИн()
	
	Обращение = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ЗаявкаНаТрейдИн.Клиент,
	|	Renault_ЗаявкаНаТрейдИн.Автомобиль,
	|	Renault_ЗаявкаНаТрейдИн.РабочийЛист
	|ПОМЕСТИТЬ ПараметрыЗаявкаНаТрейдИн
	|ИЗ
	|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|ГДЕ
	|	Renault_ЗаявкаНаТрейдИн.Ссылка = &ЗаявкаНаТрейдИн
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК Обращение
	|ИЗ
	|	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
	|ГДЕ
	|	Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения = ЗНАЧЕНИЕ(Справочник.Renault_ВидыОбращенийВАвтосервис.ДиагностикаТрейдИн)
	|	И (Renault_CRM_ОбращениеВАвтоСервис.Клиент, Renault_CRM_ОбращениеВАвтоСервис.Автомобиль, Renault_CRM_ОбращениеВАвтоСервис.IDK) В
	|			(ВЫБРАТЬ
	|				ПараметрыЗаявкаНаТрейдИн.Клиент,
	|				ПараметрыЗаявкаНаТрейдИн.Автомобиль,
	|				ПараметрыЗаявкаНаТрейдИн.РабочийЛист
	|			ИЗ
	|				ПараметрыЗаявкаНаТрейдИн КАК ПараметрыЗаявкаНаТрейдИн)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_CRM_ОбращениеВАвтоСервис.МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("ЗаявкаНаТрейдИн", ЗаявкаНаТрейдИн);
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Обращение = Выборка.Обращение;
	КонецЕсли;
	
	Возврат Обращение;
	
КонецФункции // ПолучитьОбращениеПоЗаявкеНаТрейдИн()

// Возвращает список калькуляций по заявке на трейд-ин
//
// Параметры:
//  Заявка	 - ДокументСсылка.Renault_ЗаявкаНаТрейдИн	 - Заявка
// 
// Возвращаемое значение:
//  СписокЗначений - Список калькуляций
//
&НаСервереБезКонтекста
Функция ПолучитьКалькуляцииПоЗаявке(Заявка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_Калькуляция.Ссылка КАК Калькуляция
	|ИЗ
	|	Документ.Renault_Калькуляция КАК Renault_Калькуляция
	|ГДЕ
	|	Renault_Калькуляция.ДокументОснование = &Заявка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_Калькуляция.МоментВремени УБЫВ";	
	Запрос.УстановитьПараметр("Заявка", Заявка);	
	Результат = Запрос.Выполнить();
	
	Калькуляции = Новый СписокЗначений();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Калькуляции.Добавить(Выборка.Калькуляция);
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Калькуляции;
	
КонецФункции // ПолучитьКалькуляцииПоЗаявке()

// Записывает код автомобиля выкупа в РС "CRM_ДополнительнаяИнформацияПоАвтомобилям"
//
// Параметры:
//  Автомобиль		 - СправочникСсылка.Автомобили						- Автомобиль
//  ДатаПоступления	 - Дата	 											- Дата поступления автомобиля
//  BIR				 - Строка											- BIR дилера
//  ТипОперации		 - ПеречислениеСсылка.Renault_ТипыОперацийТрейдИн	- Тип операции трейд-ин
//
&НаСервере
Процедура КодифицироватьАвтомобиль(Автомобиль, ДатаПоступления, BIR, ТипОперации);
	
	// Коды приемки:
	// Формат: A600010170001 , где
	// A – Тип поступления (см. ниже);
	// 6000 – Код дилера (Bir);
	// 10 – Месяц поступления;
	// 17 – Год поступления;
	// 0001 – Индивидуальный номер авто. Нумерация обновляется с 1 числа каждого года.
	
	// 	Коды типов поступления:
	// A – Trade-in (АП на НА);
	// B – Внутренний Trade-in (АП на АП);
	// C – Выкуп;
	// D – Комиссия;
	// E – Обратный выкуп;
	// F – Трансфер (внутри холдинга);
	// G – Юр. лица (Лизинговые компании, банки, аукционы и др.);
	// H – Корпоративные клиенты;
	// I – Другое

	КодАвтомобиляВыкупа = "";
	
	Если ТипОперации = Перечисления.Renault_ТипыОперацийТрейдИн.TradeIn Тогда 
		КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + "A";
	ИначеЕсли ТипОперации = Перечисления.Renault_ТипыОперацийТрейдИн.Выкуп Тогда
		КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + "C"; 
	ИначеЕсли ТипОперации = Перечисления.Renault_ТипыОперацийТрейдИн.Комиссия Тогда
		КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + "D";
	Иначе
		Возврат;
	КонецЕсли; 
	
	КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + Прав(BIR, 4);
	КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + ?(Месяц(ДатаПоступления) < 10, "0" + Строка(Месяц(ДатаПоступления)), Строка(Месяц(ДатаПоступления)));
	КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + Прав(Строка(Год(ДатаПоступления)), 2);
	
	//Определим последний введенный номер в пределах года выкупа по BIR
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ПОДСТРОКА(ВложенныйЗапрос.ПорядковыйНомер, 10, 4)) КАК ПорядковыйНомер
	|ИЗ
	|	(ВЫБРАТЬ
	|		CRM_ДополнительнаяИнформацияПоАвтомобилям.КодАвтомобиляВыкупа КАК ПорядковыйНомер
	|	ИЗ
	|		РегистрСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям КАК CRM_ДополнительнаяИнформацияПоАвтомобилям
	|	ГДЕ
	|		ПОДСТРОКА(CRM_ДополнительнаяИнформацияПоАвтомобилям.КодАвтомобиляВыкупа, 2, 4) = &BIR
	|		И ПОДСТРОКА(CRM_ДополнительнаяИнформацияПоАвтомобилям.КодАвтомобиляВыкупа, 8, 2) = &ГодВыкупа) КАК ВложенныйЗапрос";
	
	Запрос.УстановитьПараметр("BIR", Прав(BIR, 4));
	Запрос.УстановитьПараметр("ГодВыкупа", Прав(Строка(Год(ДатаПоступления)), 2));
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() И РезультатЗапроса.ПорядковыйНомер <> Неопределено И РезультатЗапроса.ПорядковыйНомер <> Null Тогда
		ПорядковыйНомер = РезультатЗапроса.ПорядковыйНомер;
		ПорядковыйНомер = Строка(Число(ПорядковыйНомер) + 1);
		КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + Прав("0000"+ПорядковыйНомер,4);
	Иначе
		КодАвтомобиляВыкупа = КодАвтомобиляВыкупа + "0001"; //Если это новый
	КонецЕсли;
	
	ДопИнфо = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
	ДопИнфо.Автомобиль = Автомобиль;
	ДопИнфо.Прочитать();
	ДопИнфо.Автомобиль = Автомобиль;
	ДопИнфо.КодАвтомобиляВыкупа = КодАвтомобиляВыкупа;
	ДопИнфо.ДилерскийЦентр = ЗаявкаНаТрейдИн.ДилерскийЦентр;
	ДопИнфо.Записать();
	
КонецПроцедуры // КодифицироватьАвтомобиль()

// Возвращает структуру заявок по рабочему листу
//
// Параметры:
//  РабочийЛист	 - Число	 - IDK рабочего листа
// 
// Возвращаемое значение:
//  Структура - Структура заявок, с полями
//		* ЗаявкаНаГарантию
//		* ЗаявкаНаСтраховкуОсаго
//		* ЗаявкаНаСтраховкуКаско
//		* ЗаявкаНаТрейдИн
//		* ЗаявкаНаКредит
//		
&НаСервереБезКонтекста
Функция ПолучитьЗаявкиПоРабочемуЛисту(РабочийЛист)
	
	ЗаявкиРабочегоЛиста = Новый Структура("ЗаявкаНаГарантию, ЗаявкаНаСтраховкуОсаго, ЗаявкаНаСтраховкуКаско, ЗаявкаНаТрейдИн, ЗаявкаНаКредит");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_CRM_ЗаявкаНаГарантию.Ссылка КАК ЗаявкаНаГарантию,
	|	ВЫБОР
	|		КОГДА Renault_CRM_ЗаявкаНаГарантию.ВыполненаУспешно
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПриоритетСортировки
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаГарантию КАК Renault_CRM_ЗаявкаНаГарантию
	|ГДЕ
	|	НЕ Renault_CRM_ЗаявкаНаГарантию.ПометкаУдаления
	|	И Renault_CRM_ЗаявкаНаГарантию.РабочийЛист = &РабочийЛист
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетСортировки УБЫВ
	|;
	|"+?(Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ИспользоватьСтарыйФункционалКСО,"
	|ВЫБРАТЬ
	|	Ссылка ЗаявкаНаКредит,
	|	Выбор Когда Статус=ЗНАЧЕНИЕ(Перечисление.Renault_CRM_СтатусЗаявокНаКредит.Выполнена) Тогда 1 Иначе 0 Конец ПриоритетСортировки 
	|ИЗ Документ.Renault_CRM_ЗаявкаНаКредит
	|ГДЕ НЕ ПометкаУдаления И РабочийЛист=&РабочийЛист
	|УПОРЯДОЧИТЬ ПО ПриоритетСортировки УБЫВ		
	|;","
	|ВЫБРАТЬ
	|	Ссылка ЗаявкаНаКредит,
	|	Выбор Когда Состояние=ЗНАЧЕНИЕ(Перечисление.Renault_CRM_СтатусЗаявокНаКредит.Выполнена) Тогда 1 Иначе 0 Конец ПриоритетСортировки 
	|ИЗ Документ.Renault_РабочийЛистОФУ
	|ГДЕ НЕ ПометкаУдаления И РабочийЛист=&РабочийЛист
	|УПОРЯДОЧИТЬ ПО ПриоритетСортировки УБЫВ		
	|;")+"

	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_ЗаявкаНаТрейдИн.Ссылка КАК ЗаявкаНаТрейдИн
	|ИЗ
	|	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|ГДЕ
	|	НЕ Renault_ЗаявкаНаТрейдИн.ПометкаУдаления
	|	И Renault_ЗаявкаНаТрейдИн.РабочийЛист В
	|			(ВЫБРАТЬ
	|				Renault_РабочиеЛисты.СвязаныйIDK
	|			ИЗ
	|				РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|			ГДЕ
	|				Renault_РабочиеЛисты.IDK = &РабочийЛист)
	|	И Renault_ЗаявкаНаТрейдИн.РабочийЛист > 0";	
	Запрос.УстановитьПараметр("РабочийЛист", РабочийЛист); 	
	Результат = Запрос.ВыполнитьПакет();
	
	//Заявка на гарантию
	Если НЕ Результат[0].Пустой() Тогда
		Выборка = Результат[0].Выбрать();		
		Выборка.Следующий();
		
		ЗаявкиРабочегоЛиста.Вставить("ЗаявкаНаГарантию", Выборка.ЗаявкаНаГарантию);		
	КонецЕсли;
	
	//Заявка на кредит
	Если НЕ Результат[1].Пустой() Тогда
		Выборка = Результат[1].Выбрать();		
		Выборка.Следующий();
		
		ЗаявкиРабочегоЛиста.Вставить("ЗаявкаНаКредит", Выборка.ЗаявкаНаКредит);		
	КонецЕсли;
	
	//Заявка на трейд-ин
	Если НЕ Результат[2].Пустой() Тогда
		Выборка = Результат[2].Выбрать();		
		Выборка.Следующий();
		
		ЗаявкиРабочегоЛиста.Вставить("ЗаявкаНаТрейдИн", Выборка.ЗаявкаНаТрейдИн);		
	КонецЕсли;
	
	Возврат ЗаявкиРабочегоЛиста;
	
КонецФункции // ПолучитьЗаявкиПоРабочемуЛисту()

// Возвращает коммерческое предложение по рабочему листу, не равное переданному
//
// Параметры:
//  СсылкаКП - ДокументСсылка.CRM_КоммерческоеПредложение	 -  Заменяемое коммерческое предложение
// 
// Возвращаемое значение:
//  ДокументСсылка.CRM_КоммерческоеПредложение - Заменяющее коммерческое предложение
//
&НаСервере
Функция ЗаменитьКП(СсылкаКП)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_КоммерческоеПредложение.Ссылка
	|ИЗ
	|	Документ.CRM_КоммерческоеПредложение КАК CRM_КоммерческоеПредложение
	|ГДЕ
	|	CRM_КоммерческоеПредложение.РабочийЛист = &РабочийЛист
	|	И CRM_КоммерческоеПредложение.ПометкаУдаления = ЛОЖЬ
	|	И НЕ CRM_КоммерческоеПредложение.Ссылка = &СсылкаКП
	|УПОРЯДОЧИТЬ ПО
	|	CRM_КоммерческоеПредложение.Дата УБЫВ";
	Запрос.УстановитьПараметр("РабочийЛист", Объект.IDK);
	Запрос.УстановитьПараметр("СсылкаКП", СсылкаКП);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ЗаменитьКП()

// Записывает данные клиента
//
&НаКлиенте
Процедура СохранитьДанныеКлиента()
	
	КлиентОбъект = Объект.Клиент.ПолучитьОбъект();
	CRM_Сервер.РазбитьФИО(Клиент_ФИО, КлиентОбъект.Фамилия, КлиентОбъект.Имя, КлиентОбъект.Отчество);
	КлиентОбъект.Наименование = Клиент_ФИО;
	КлиентОбъект.НаименованиеПолное = Клиент_ФИО;
	КлиентОбъект.Записать();
	
	ОбновитьВоронкуИСписки();
	Оповестить("ОбновитьРабСтолМенеджера");
	Модифицированность = Ложь;
	
КонецПроцедуры // СохранитьДанныеКлиента()

// Проверяет дубли контрагентов
//
// Параметры:
//  НовыйКонтрагент	 - СправочникСсылка.Контрагенты	 - Контрагент после проверки на дубли
//
&НаСервере
Процедура ЗаменитьКонтрагента(НовыйКонтрагент)

	Если ЗначениеЗаполнено(Объект.Клиент) И ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда		
		// { DMSREN-669 Болдарев Д.Е. от 30.03.2020 
		// В процедуре CRM_Редубликация.ПроизвестиЗаменуКлиентов() будет прочитан из базы и записан текущий документ.
		// Чтобы не потерять текущие изменения, запишем данные сейчас
		Попытка
			Записать();			
		Исключение
		    ТекстОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ДокументРабочийЛист.ЗаменитьКонтрагента", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Документы.Renault_РабочийЛист, Объект.Ссылка, ТекстОшибки);
		КонецПопытки;
		// } DMSREN-669 Болдарев Д.Е. от 30.03.2020. 
		
		МассивИсключаемыхОбъектов = Новый Массив;
		CRM_Редубликация.ПроизвестиЗаменуКлиентов(Объект.Клиент, НовыйКонтрагент,, МассивИсключаемыхОбъектов);
		
		// { DMSREN-669 Болдарев Д.Е. от 30.03.2020 
		// После того, как из общего модуля перезаписали объект текущего документа, различаются версии данных
		// объекта БД и данных в форме. Нужно их синхронизировать
		Попытка
			ДокОбъект = Объект.Ссылка.ПолучитьОбъект();
			ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		Исключение
		    ТекстОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ДокументРабочийЛист.ЗаменитьКонтрагента", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Документы.Renault_РабочийЛист, Объект.Ссылка, ТекстОшибки);
		КонецПопытки; 
		// } DMSREN-669 Болдарев Д.Е. от 30.03.2020. 	
	КонецЕсли;
		
	Если ЗначениеЗаполнено(НовыйКонтрагент) Тогда
		Объект.Клиент = НовыйКонтрагент;
	КонецЕсли;
	
КонецПроцедуры // ЗаменитьКонтрагента()

// Обработка оповещения при выборе согласия на обработку персональных данных
//
&НаКлиенте
Процедура ЗавершениеРедактированияПД(Результат, ДополнительныеПараметры) Экспорт 
	
	СогласиеНаОПД(); 
	
КонецПроцедуры // ЗавершениеРедактированияПД()

// Записывает данные корпоративного клиента
//
&НаКлиенте
Процедура ОбновитьДанныеКорпКлиента()
			
	КорпКлиентОбъект = КорпКлиент.ПолучитьОбъект();
	
	СтрокаСферыДеятельности = КорпКлиентОбъект.СферыДеятельности[0];
	СтрокаСферыДеятельности.СфераДеятельности = Клиент_СфераДеятельности;

	СтрокаАвтопарк            = КорпКлиентОбъект.Автопарк[0];
	СтрокаАвтопарк.Марка      = Клиент_АвтопаркМарка;
	СтрокаАвтопарк.Модель     = Клиент_АвтопаркМодель;
    СтрокаАвтопарк.Количество = Клиент_АвтопаркКоличество;

	КорпКлиентОбъект.Записать();		

КонецПроцедуры // ОбновитьДанныеКорпКлиента()

&НаКлиенте
Процедура Клиент_АвтопаркКоличествоНачалоВыбора(Команда)
	
	ВвестиЧисловойЭлемент(Команда);
	Клиент_АвтопаркПриИзменении(Неопределено);
	
КонецПроцедуры // Клиент_АвтопаркКоличествоНачалоВыбора()

// Обработчик события "ПриИзменении" года выпуска трейд-ин
//
&НаКлиенте
Процедура ПриИзмененииДатыВыпуска()
	
	Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
		ЗаявкаНаТрейдИнОбъект = ЗаявкаНаТрейдИн.ПолучитьОбъект();
	Иначе
		Сообщить("Необходимо создать заявку на трейд-ин!");
		Возврат;
	КонецЕсли;
		
	ЗаявкаНаТрейдИнОбъект.ГодВыпуска = ГодВыпускаТрейдИн;
	ЗаявкаНаТрейдИнОбъект.МодельКод = "";
	ЗаявкаНаТрейдИнОбъект.ТипКузоваКод = "";
	ЗаявкаНаТрейдИнОбъект.ДвигательКод = "";
	ЗаявкаНаТрейдИнОбъект.КППКод = "";
	ЗаявкаНаТрейдИнОбъект.МодификацияКод = "";
	ЗаявкаНаТрейдИнОбъект.Опции.Очистить();
	ЗаявкаНаТрейдИнОбъект.ОриентировочнаяЦена = 0;  
	ЗаявкаНаТрейдИнОбъект.ОжиданиеСтоимостиКлиента = 0;
	ЗаявкаНаТрейдИнОбъект.Автомобиль = ПредопределенноеЗначение("Справочник.Автомобили.ПустаяСсылка");
	ЗаявкаНаТрейдИнОбъект.Цвет = ""; 
	ЗаявкаНаТрейдИнОбъект.VIN = "";
	ЗаявкаНаТрейдИнОбъект.ГосНомер = "";
	ЗаявкаНаТрейдИнОбъект.СрокДействия = "";
	ЗаявкаНаТрейдИнОбъект.ОценкаСостояния = ""; 
	ЗаявкаНаТрейдИнОбъект.Пробег = "";
	ЗаявкаНаТрейдИнОбъект.КоличествоВладельцевПоПТС = "";
	ЗаявкаНаТрейдИнОбъект.СостояниеШин = "";
	ЗаявкаНаТрейдИнОбъект.НаличиеАварий = Ложь;
	ЗаявкаНаТрейдИнОбъект.ОригиналПТС = Ложь;
	ЗаявкаНаТрейдИнОбъект.Металик = Ложь;
	ЗаявкаНаТрейдИнОбъект.Записать();
		
	МодельТрейдИн = "";
	ОжидаемаяСтоимостьКлиентаТрейдИн = 0;
	
	Значение = ЗначениеЗаполнено(ГодВыпускаТрейдИн);
	Если Значение Тогда
		ЗаполнитьСписокВыбораЭлемента("МодельТрейдИн");	
	КонецЕсли;
	
	ПараметрыУправленияЭлементами = Новый Структура();
	ПараметрыУправленияЭлементами.Вставить("МодельТрейдИн",								Значение);
	ПараметрыУправленияЭлементами.Вставить("ВыбратьМодельТрейдИн", 						Значение);
	ПараметрыУправленияЭлементами.Вставить("ОжидаемаяСтоимостьКлиентаТрейдИн", 			ЗначениеЗаполнено(МодельТрейдИн));
	ПараметрыУправленияЭлементами.Вставить("ВвестиОжидаемаяСтоимостьКлиентаТрейдИн", 	ЗначениеЗаполнено(МодельТрейдИн));

	ОбновитьИнтерфейсТрейдИн(ПараметрыУправленияЭлементами);
	
КонецПроцедуры // ПриИзмененииДатыВыпуска()

// Записывает источник информации в РС "CRM_КлиентскиеДанные"
//
&НаКлиенте
Процедура СохранитьИсточникИнформации()
	
	ЗаписьКлиентскиеДанные = РегистрыСведений.CRM_КлиентскиеДанные.СоздатьМенеджерЗаписи();
	ЗаписьКлиентскиеДанные.Клиент = Объект.Клиент;
	ЗаписьКлиентскиеДанные.Прочитать();
	
	Если Не ЗаписьКлиентскиеДанные.Выбран() Тогда
		ЗаписьКлиентскиеДанные.Клиент = Объект.Клиент;
	КонецЕсли;
	
	ЗаписьКлиентскиеДанные.ИсточникИнформации = Клиент_ИсточникИнформации;
	ЗаписьКлиентскиеДанные.Записать();
	
КонецПроцедуры // СохранитьИсточникИнформации()

// Записывает город клиента в РС "CRM_КлиентскиеДанные"
//
&НаКлиенте
Процедура СохранитьГород()
	
	ЗаписьКлиентскиеДанные = РегистрыСведений.CRM_КлиентскиеДанные.СоздатьМенеджерЗаписи();
	ЗаписьКлиентскиеДанные.Клиент = Объект.Клиент;
	ЗаписьКлиентскиеДанные.Прочитать();
	
	Если Не ЗаписьКлиентскиеДанные.Выбран() Тогда
		ЗаписьКлиентскиеДанные.Клиент = Объект.Клиент;
	КонецЕсли;
	
	ЗаписьКлиентскиеДанные.Город = Клиент_Город;
	ЗаписьКлиентскиеДанные.Записать();
	
КонецПроцедуры // СохранитьГород()

// Устанавливает признак основного коммерческого предложения
//
// Параметры:
//  КП		 - 	СправочникСсылка.CRM_КонфигурацииАвтомобилей - Текущее коммерческое предложение
//  Основное - 	Булево - Признак основного коммерческого предложения
//
&НаСервере
Процедура УстановитьОсновноеКП(КП, Основное = Ложь)
	
	КПОбъект = КП.ПолучитьОбъект();
	КПОбъект.Основное = Основное;
	КПОбъект.Записать();
	
	Если Основное Тогда
		
		Для Каждого Строка Из ТаблицаКП Цикл
			
			Если Строка.Ссылка = КП Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			КПОбъект = Строка.Ссылка.ПолучитьОбъект();
			КПОбъект.Основное = Ложь;
			КПОбъект.Записать();
			
		КонецЦикла;
		
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	НаборЗаписей.IDK = Объект.IDK;
	НаборЗаписей.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.КоммерческоеПредложение;
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Выбран() И ЗначениеЗаполнено(НаборЗаписей.Объект) Тогда
		 НаборЗаписей.Объект = КП;
	КонецЕсли;
	
	НаборЗаписей.Записать();
	
	ОбновитьСписокКП();
	
КонецПроцедуры // УстановитьОсновноеКП()

// Устанавливает доступность реквизитов корпоративного клиента
//
// Параметры:
//  ЗапретитьРедактирование	 - Булево	 - Признак запрета редактирования реквизитов
//
&НаКлиенте
Процедура УстановитьДоступностьРеквизитовКорпКлиента(ЗапретитьРедактирование)
	
	Элементы.Клиент_Корпоративный.ТолькоПросмотр                  	= ЗапретитьРедактирование;
	Элементы.ГруппаСтраницаСфераДеятельностиАвтопарк.ТолькоПросмотр = ЗапретитьРедактирование;
	Элементы.Клиент_АвтопаркМарка.ТолькоПросмотр                  	= ЗапретитьРедактирование;
	Элементы.Клиент_АвтопаркМодель.ТолькоПросмотр                 	= ЗапретитьРедактирование;
	Элементы.Клиент_АвтопаркКоличество.ТолькоПросмотр             	= ЗапретитьРедактирование; 
	
КонецПроцедуры // УстановитьДоступностьРеквизитовКорпКлиента()

// Проверяет правильность ввода ИНН
//
// Параметры:
//  ПроверяемыйИНН	 - Строка	 - ИНН для проверки
// 
// Возвращаемое значение:
//  Строка - Описание ошибки
//
&НаКлиенте
Функция ПроверкаИНН(ПроверяемыйИНН) Экспорт
	
	ПровИНН = СокрЛП(ПроверяемыйИНН);
	ДлинаИНН = СтрДлина(ПровИНН);
	
	// Проверка длины ИНН
	Если ДлинаИНН < 10 Тогда
		Возврат "ИНН не должен быть меньше 10-ти цифр";
	КонецЕсли;
	
	// Проверка ключа ИНН - сначала составим матрицу простых чисел,
	// потом проверим ключ для разной длины
	КодКонст = Новый Массив;
	КодКонст.Добавить(41);
	КодКонст.Добавить(37);
	КодКонст.Добавить(31);
	КодКонст.Добавить(29);
	КодКонст.Добавить(23);
	КодКонст.Добавить(19);
	КодКонст.Добавить(17);
	КодКонст.Добавить(13);
	КодКонст.Добавить(7);
	КодКонст.Добавить(5);
	КодКонст.Добавить(3);
	
	НСум = 0;
	Если ДлинаИНН = 10 Тогда
		// Для ИНН 10 знаков
		Для Сч = 1 По 9 Цикл
			НСум = НСум + Число(Сред(ПровИНН, Сч, 1)) * КодКонст[Сч + 1];
		КонецЦикла;
		//----------------------------------------------- 
		ННов = 11 - (НСум - (Цел(НСум / 11) * 11)); 
		КНов = Сред(ПровИНН, 1, 9) + ?(ННов < 10, Строка(ННов), "0");
		Если КНов = ПровИНН Тогда
			Возврат "";
		КонецЕсли;
		
	ИначеЕсли ДлинаИНН = 11 Тогда
		// Для ИНН 11 знаков
		КНов = "1" + Сред(ПровИНН, 2, 9);
		ПровИНН = ВРег(ПровИНН);
		Для Сч = 1 По 10 Цикл
			НСум = НСум + Число(Сред(КНов,Сч,1)) * КодКонст[Сч];
		КонецЦикла;
		//----------------------------------------------- 
		ННов = 11 - (НСум - (Цел(НСум/11)*11));
		КНов = "F" + Сред(КНов, 2, 9) + ?(ННов < 10, Строка(ННов), "0");
		Если КНов = ПровИНН Тогда
			Возврат "";
		КонецЕсли;
		
	ИначеЕсли ДлинаИНН = 12 Тогда
		// Для 12 знаков
		Если Число(ПровИНН) * Число(Сред(ПровИНН, 5, 6)) = 0 Тогда
			Возврат "Неправильный ИНН - ошибка ключа";
		КонецЕсли;
		//----------------------------------------------- 
		Для Сч = 1 По 10 Цикл
			НСум = НСум + Число(Сред(ПровИНН, Сч, 1)) * КодКонст[Сч];
		КонецЦикла;
		ННов = 11 - (НСум - (Цел(НСум / 11) * 11));
		КНов = Сред(ПровИНН, 1, 10) + ?(ННов < 10, Строка(ННов), "0");
		НСум = 0;
		//----------------------------------------------- 
		Для Сч = 1 По 11 Цикл
			НСум = НСум + Число(Сред(ПровИНН, Сч, 1)) * КодКонст[Сч - 1];
		КонецЦикла;
		ННов = 11-(НСум - (Цел(НСум / 11) * 11));
		КНов = ?(ННов < 10,КНов+Строка(ННов), КНов + "0");
		Если КНов = ПровИНН Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	Возврат "Неправильный ИНН - ошибка ключа";
	
КонецФункции // ПроверкаИНН()

// Процедура загружает данные корпоративного клиента,
//		полученного с базы Хранилище справочников
//
&НаКлиенте
Процедура ЗагрузитьКорпоративногоКлиента(ДанныеКлиента)
	
	//Создание-обновление данных клиента
	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КлиентОбъект = Справочники.Renault_КорпоративныеКлиенты.СоздатьЭлемент();
	СсылкаКлиента = Справочники.Renault_КорпоративныеКлиенты.ПолучитьСсылку(ДанныеКлиента.Идентификатор);
	КлиентОбъект.УстановитьСсылкуНового(СсылкаКлиента);
	
	КлиентОбъект.Наименование = ДанныеКлиента.Наименование;
	Если ДанныеКлиента.Состояние = "Согласован" Тогда
		Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.Согласован;
	ИначеЕсли ДанныеКлиента.Состояние = "На согласовании" Тогда
		Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.НаСогласовании;
	ИначеЕсли ДанныеКлиента.Состояние = "Не согласован" Тогда
		Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.НеСогласован;
	Иначе
		Состояние = "";
	КонецЕсли;
	
	КлиентОбъект.Состояние = Перечисления.Renault_СостоянияСогласованияКлиента.Черновик;
	КлиентОбъект.ИдЗаявки = ДанныеКлиента.ИдЗаявки;
	КлиентОбъект.Идентификатор = ДанныеКлиента.Идентификатор;
	КонтрагентОбъект.Наименование = ДанныеКлиента.Наименование;
	КонтрагентОбъект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.Покупатель;
	КонтрагентОбъект.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;
	КонтрагентОбъект.НаименованиеПолное = ДанныеКлиента.НаименованиеПолное;
	КонтрагентОбъект.ИНН = Клиент_ИНН;
	
	Попытка
		КонтрагентОбъект.Записать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	КлиентОбъект.Контрагент = КонтрагентОбъект.Ссылка;
	
	Попытка
		КлиентОбъект.Записать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	КонтрагентПоиск = КонтрагентОбъект.Ссылка;
	
КонецПроцедуры // ЗагрузитьКорпоративногоКлиента()

&НаКлиенте
Процедура РазблокироватьРЛ() Экспорт
	
	ТолькоПросмотр = Ложь;
	Элементы.ТаблицаКП.Доступность = Истина;
	МассивИменБезБлока = Новый Массив();
	
	МассивИменБезБлока.Добавить("СводныйОтчет");
	МассивИменБезБлока.Добавить("Закрыть");
	МассивИменБезБлока.Добавить("кнОбновитьКоммерческиеПредложения");
	МассивИменБезБлока.Добавить("кнОбновитьСписокСобытий");
	МассивИменБезБлока.Добавить("ТаблоКоментарии");     
	МассивИменБезБлока.Добавить("ДиалогКомментария");
	МассивИменБезБлока.Добавить("кнВводКомментарияОК");
	МассивИменБезБлока.Добавить("кнВводКомментарияОтмена");
	
	Для Каждого Элем Из Элементы Цикл
		Если ТипЗнч(Элем) = Тип("Кнопка") Тогда
			Если МассивИменБезБлока.Найти(Элем.Имя)= Неопределено Тогда
				Элем.Доступность = Истина;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элем) = Тип("ТабличноеПоле")Тогда
			Если МассивИменБезБлока.Найти(Элем.Имя)= Неопределено Тогда
				Элем.Доступность = Истина;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элем) = Тип("ПолеТабличногоДокумента")Тогда
			Если МассивИменБезБлока.Найти(Элем.Имя)= Неопределено Тогда
				Элем.Доступность = Истина;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элем) = Тип("ПолеВвода")Тогда
			Если МассивИменБезБлока.Найти(Элем.Имя)= Неопределено Тогда
				Элем.Доступность = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

