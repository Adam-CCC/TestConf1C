&НаКлиенте
Процедура ОткрытьICM(Команда)
	
	СправочникСсылка = Неопределено;
	VIN = ВернутьVINПоАвтомобилям();
	Если Не ЗначениеЗаполнено(VIN) тогда
		//DMSREN-715
		Предупреждение("Не установлен VIN автомобиля.");
		
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаVIN",
		ЭтотОбъект);	
		
		ПоказатьВопрос(Оповещение,
		"Хотите вводить VIN вручную?",
		РежимДиалогаВопрос.ДаНет,
		0,
		КодВозвратаДиалога.Да, 
		"Проверка VIN" 
		);    
		//DMSREN-715
		Возврат;
	КонецЕсли;	
	
	ТаблицаОТС = Renault_АвтосервисСервер.Renault_ОбработатьОТС(VIN);
	Если ТаблицаОТС.Количество()>0 тогда
	Для Каждого Строка из ТаблицаОТС Цикл
		СправочникСсылка = Справочники.СервисныеКампании.НайтиПоКоду(Строка.НомерОТС);
		Если НЕ ЗначениеЗаполнено(СправочникСсылка) Тогда
			Элемент = Справочники.СервисныеКампании.СоздатьЭлемент();
			Элемент.Код = Строка.НомерОТС;
			Элемент.Наименование = Строка.НаименованиеОТС + " (" + Строка.ИндексЦветОТС + ")";
			Элемент.Комментарий = Строка.ОписаниеОТС + Символы.ПС + "Номер технической ноты: " +Строка(Строка.НомерТехническойНоты);
			Элемент.Записать();
			СправочникСсылка = Элемент.Ссылка; 
		КонецЕсли;
		Запись = РегистрыСведений.ВыполнениеСервисныхКампаний.СоздатьМенеджерЗаписи();
		Запись.VIN = VIN;
		Запись.СервиснаяКампания = СправочникСсылка;
		Запись.Прочитать();
		Если не Запись.Выбран() Тогда
			Запись.Записать();	
		КонецЕсли;
		Renault_АвтосервисСервер.ЗарегистрироватьПроверкуICMВЖурнале(VIN,"Договор купли-продажи",СправочникСсылка);
		КонецЦикла;
	Иначе
		Renault_АвтосервисСервер.ЗарегистрироватьПроверкуICMВЖурнале(VIN,"Договор купли-продажи",СправочникСсылка);
	КонецЕСли;
	ОбновитьДатуICM(Истина);
	
КонецПроцедуры // ОткрытьICM()

