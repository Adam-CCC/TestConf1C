			Элементы.РегистрацияВБазеРеноРоссия.Заголовок = "Регистрация клиента в базе Renault Россия (" + ТекстДата + ")";
		КонецЕсли;	
	Иначе
		Элементы.РегистрацияВБазеРеноРоссия.ЦветФона = ЦветКнопкиВоронкиСерый;
		Элементы.РегистрацияВБазеРеноРоссия.Заголовок = "Регистрация клиента в базе Renault Россия";
