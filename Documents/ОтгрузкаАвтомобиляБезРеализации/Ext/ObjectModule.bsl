Функция ПечатьДоверенность(ТабДокумент) Экспорт
	
	Доверенность = спПолучитьПодтверждающийДокументОбъектаПоВиду(Ссылка.Водитель,Перечисления.ВидыДокументов.Доверенность);
	Паспорт      = спПолучитьПодтверждающийДокументОбъектаПоВиду(Ссылка.Водитель,Перечисления.ВидыДокументов.Паспорт);
	Город = киПолучитьГород(Ссылка.ПодразделениеКомпании,Справочники.ВидыКонтактнойИнформации.АдресФактический);
	
	Если обЗначениеНеЗаполнено(Доверенность) Тогда
		Сообщить("ОШИБКА! Отсутствует действующая доверенность. Процедура печати прервана.",СтатусСообщения.ОченьВажное);
		Возврат ТабДокумент;
	КонецЕсли; 
	
	Если обЗначениеНеЗаполнено(Паспорт) Тогда
		Сообщить("ОШИБКА! Отсутствует действующий паспорт. Процедура печати прервана.",СтатусСообщения.ОченьВажное);
		Возврат ТабДокумент;
	КонецЕсли; 
	
	Макет = ПолучитьМакет("Доверенность");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	
	СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(ТекущаяДата(),Новый Структура("Организация,Объект",Ссылка.Подразделение.Организация,Перечисления.ВидыОбъектовСведений.Руководитель));
	Руководитель = СтруктураСведений.Значение;
	
	ОбластьМакета.Параметры.ОрганизацияГенеральныйДиректор = Руководитель;
	ОбластьМакета.Параметры.ПодразделениеАдресФактический = киПолучитьПредставлениеКИ(Ссылка.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьМакета.Параметры.ПодразделениеАдресЮридический = киПолучитьПредставлениеКИ(Ссылка.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьМакета.Параметры.ДанныеПаспорта = " серия"+СокрЛП(Паспорт.Серия)+" №"+СокрЛП(Паспорт.Номер)+", выдан "+СокрЛП(Паспорт.КемВыдан)+" "+Формат(Паспорт.ДатаВыдачи,"ДЛФ=DD");
	
	ОбластьМакета.Параметры.ФИО = Ссылка.Наименование;
	//ОбластьМакета.Параметры.Должность =  Ссылка.Должность.Наименование;
	//ОбластьМакета.Параметры.Подразделение = Ссылка.Подразделение.Наименование;
	
	Если обЗначениеНеЗаполнено(Ссылка.ПодразделениеКомпании.Организация.НаименованиеДляПечати) Тогда
		ОбластьМакета.Параметры.Организация = Ссылка.ПодразделениеКомпании.Организация.Наименование;
	Иначе
		ОбластьМакета.Параметры.Организация = Ссылка.ПодразделениеКомпании.Организация.НаименованиеДляПечати;
	КонецЕсли; 
	
	ОбластьМакета.Параметры.ДатаПечати = Формат(ТекущаяДата(),"ДЛФ=DD");
	ОбластьМакета.Параметры.ДатаОкончания = Формат(Доверенность.ДатаОкончания,"ДЛФ=DD");
	
	Табдокумент.Вывести(ОбластьМакета);
	
	Табдокумент.ОриентацияСтраницы=ОриентацияСтраницы.Портрет;
	Табдокумент.АвтоМасштаб = Истина;
	Табдокумент.ОтображатьСетку=Ложь;
	
	Возврат Табдокумент;
	
КонецФункции //ПечатьДоверенность(ТабДокумент) Экспорт

