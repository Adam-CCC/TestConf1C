//
Функция ПечатьАктПриемаПередачиСоколМоторс(ТабДокумент) Экспорт
		
		//Renault Начало
		Если CRM_Клиент.ОплатаПоДоговоруНеВыполнена(ЭтотОбъект.ДоговорВзаиморасчетов) Тогда
			Возврат Неопределено;
		КонецЕсли;
		//Renault Конец 
		
		Если ХозОперация = Справочники.ХозОперации.ОтменаОтгрузкиАвтомобиляБезРеализации Тогда
			СМГ_Сообщить("ОШИБКА! ""Отмена отгрузки автомобиля без реализации"" не может быть распечатана.",СтатусСообщения.ОченьВажное);
			Возврат Неопределено;
		КонецЕсли;
		
		Если НЕ Проведен Тогда
			СМГ_Сообщить("ОШИБКА! Непроведённый документ ""Отгрузка автомобиля без реализации"" не может быть распечатан.",СтатусСообщения.ОченьВажное);
			Возврат Неопределено;
		КонецЕсли;
		
		//Бондаренко++ 20251218
		КонтрагентЯвляетсяФизЛицом = Истина;
		Если НЕ ЭтотОбъект.Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
			ТаблицаРезультат = Новый ТаблицаЗначений;
			РаботаСКонтактнымиЛицами.ПолучитьВедомых(ЭтотОбъект.Контрагент,ТаблицаРезультат);
			Если ТаблицаРезультат.Количество() = 0 Тогда
				СМГ_Сообщить("ОШИБКА! У контрагента """+ЭтотОбъект.Контрагент+""", на вкладке ""Контакты"", нет ни одного контактного лица. Печать документа невозможна.",СтатусСообщения.ОченьВажное);		
				Предупреждение("ОШИБКА! У контрагента """+ЭтотОбъект.Контрагент+""", на вкладке ""Контакты"", нет ни одного контактного лица. Печать документа невозможна.");					
				Возврат Неопределено;
			Иначе
				//===========================================
				ТаблицаРезультат = Новый ТаблицаЗначений;
				РаботаСКонтактнымиЛицами.ПолучитьВедомых(ЭтотОбъект.Контрагент,ТаблицаРезультат);
				СЗ = Новый СписокЗначений;
				СЗ.ЗагрузитьЗначения(ТаблицаРезультат.ВыгрузитьКолонку("Ведомый"));
				ТекЭл = СЗ.ВыбратьЭлемент("Выбирайте контактное лицо.",ТекЭл);
				Попытка
					КонтактноеЛицоСсылка = ТекЭл.Значение;
				Исключение
					//	
				КонецПопытки;
				
				//Бондаренко-- 20210924
				Должность = "";
				Если ЗначениеЗаполнено(КонтактноеЛицоСсылка) Тогда
					//Бондаренко++ 20230407
					//Должность = СокрЛП(КонтактноеЛицоСсылка.Должность.Наименование); 
					Отбор = Новый Структура();
					Отбор.Вставить("Ведомый",КонтактноеЛицоСсылка);
					Строки = ТаблицаРезультат.НайтиСтроки(Отбор);
					Если Строки.Количество() > 0 Тогда
						Должность = СокрЛП(Строки[0].Должность);
					КонецЕсли;
					Если Должность <> "" Тогда
						ПозицияПробела = Найти(Должность," ");
						Если ПозицияПробела > 0 Тогда
							Должность = СокрЛП(ПадежФИО(Сред(Должность,1,ПозицияПробела-1)))+" "+СокрЛП(ПадежФИО(Сред(Должность,ПозицияПробела+1)));	
						Иначе
							Должность = ПадежФИО(Должность);	
						КонецЕсли; 
					КонецЕсли; 
					//Бондаренко-- 20230407 
					КонтактноеЛицо = СокрЛП(СокрЛП(Должность) + " " + СокрЛП(ПадежФИО(КонтактноеЛицоСсылка.Наименование)));
				Иначе
					КонтактноеЛицо = "";
				КонецЕсли;	
				
				Если ЭтотОбъект.Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо
					И (Найти(НРег(Должность), "директор") > 0 Или Найти(НРег(Должность), "председат")) Тогда		
					ПодтвДокументКонтактногЛица = "Устава";		
				Иначе
					ФормаВыбора = Справочники.ПодтверждающиеДокументы.ПолучитьФормуВыбора();
					ФормаВыбора.Заголовок = "Выбор подтверждающего документа";
					ФормаВыбора.Отбор.Владелец.Значение = КонтактноеЛицоСсылка;
					ФормаВыбора.Отбор.Владелец.Использование = Истина;
					ПодтвДокументСсылка = ФормаВыбора.ОткрытьМодально();	
					Если ЗначениеЗаполнено(ПодтвДокументСсылка) Тогда
						ПодтвДокументКонтактногЛица = ПодтвДокументСсылка.Наименование;
					Иначе
						ПодтвДокументКонтактногЛица = "";
					КонецЕсли;	
				КонецЕсли;
				//===========================================
 			КонецЕсли;
			КонтрагентЯвляетсяФизЛицом = Ложь;
		КонецЕсли;             
		//Бондаренко-- 20251218 
		
		Макет = ПолучитьМакет("АктПриемаПередачиСоколМоторс");
		
		//-----------------------------------------------------------------------
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");  
		
		ОбластьМакета.Параметры.Номер = СокрЛП(ДокументОснование.Номер);
		ОбластьМакета.Параметры.ДатаДок = Формат(ДокументОснование.Дата,"ДФ=dd.MM.yyyy");
		
		//Бондаренко++ 20260212
		Если ДокументОснование.ДоговорВзаиморасчетов.ДатаКП <> Дата(1,1,1) Тогда
			ОбластьМакета.Параметры.ДатаДок = Формат(ДокументОснование.ДоговорВзаиморасчетов.ДатаКП,"ДФ=dd.MM.yyyy");
		КонецЕсли;
		//Бондаренко-- 20260212
		 
		ОбластьМакета.Параметры.Город = киПолучитьГород(ЭтотОбъект.ПодразделениеКомпании,Справочники.ВидыКонтактнойИнформации.АдресФактический);
		
		ТабДокумент.Вывести(ОбластьМакета);
	 	
		//-------------------------------------------
		 
		Если ЭтотОбъект.Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
	 		ОбластьМакета = Макет.ПолучитьОбласть("ФизЛицо");
		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть("ЮрЛицо");	
		КонецЕсли;	
		
		ОрганизацияНаименованиеПолное = Организация.НаименованиеПолное;
		
		ОбластьМакета.Параметры.ОрганизацияНаименованиеПолное = ОрганизацияНаименованиеПолное;
 		
		Паспорт = спПолучитьПодтверждающийДокументОбъектаПоВиду(ЭтотОбъект.Контрагент,Перечисления.ВидыДокументов.Паспорт);
  		
		//Бондаренко++ 20251216
		СтруктураОтбора = Новый Структура("Организация,Объект", Организация, Перечисления.ВидыОбъектовСведений.Руководитель);
		СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(РабочаяДата, СтруктураОтбора);
		Руководитель = СтруктураСведений.Значение;
		СтруктураСведений = Неопределено;
		Попытка
			СтруктураОтбора = Новый Структура("Организация", Организация);
			СтруктураСведений = РегистрыСведений.ИОГенеральногоДиректора.ПолучитьПоследнее(ДокументОснование.Дата, СтруктураОтбора);
		Исключение
		КонецПопытки;
		Если СтруктураСведений <> Неопределено И ДокументОснование.Дата >= СтруктураСведений.ДатаНачала И ДокументОснование.Дата < КонецДня(СтруктураСведений.ДатаОкончания) Тогда
			Руководитель = СтруктураСведений.Значение;
			ОбластьМакета.Параметры.ВЛицеРуководителя = " и.о. Генерального директора " + ПадежФИО(Руководитель.Наименование);
