Функция СМГ_ОткорректироватьРЛ(Фл,Док)
	
	РЛ_ = "";
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОтгрузкаАвтомобиляБезРеализации.Ссылка КАК Ссылка,
	               |	ОтгрузкаАвтомобиляБезРеализации.ДокументОснование КАК Заказ,
	               |	ОтгрузкаАвтомобиляБезРеализации.ДокументОснование.ДокументОснование КАК РЛ,
	               |	ОтгрузкаАвтомобиляБезРеализации.ХозОперация КАК ХозОперация,
	               |	ОтгрузкаАвтомобиляБезРеализации.Дата КАК Дата,
	               |	ОтгрузкаАвтомобиляБезРеализации.Проведен КАК Проведен
	               |ИЗ
	               |	Документ.ОтгрузкаАвтомобиляБезРеализации КАК ОтгрузкаАвтомобиляБезРеализации
	               |ГДЕ
	               |	ОтгрузкаАвтомобиляБезРеализации.ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.ОтгрузкаАвтомобиляБезРеализации)
	               |	И ОтгрузкаАвтомобиляБезРеализации.Ссылка = &Ссылка
	               |	И ТИПЗНАЧЕНИЯ(ОтгрузкаАвтомобиляБезРеализации.ДокументОснование.ДокументОснование) = ТИП(Документ.РабочийЛист)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Ссылка",Док);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РЛ_ = ВыборкаДетальныеЗаписи.РЛ;
		Прервать;
	КонецЦикла;
	
	Если Не обЗначениеНеЗаполнено(РЛ_) Тогда
		
		КорректироватьРЛ = Ложь;
		
		РЛ_Объект = РЛ_.ПолучитьОбъект();    
 		
		Если ХозОперация = Справочники.ХозОперации.ОтгрузкаАвтомобиляБезРеализации Тогда
 			Если РЛ_Объект.ОтгрузкаАвтомобиля <> Ссылка Тогда
				РЛ_Объект.ОтгрузкаАвтомобиля = Ссылка;
				КорректироватьРЛ = Истина;
			КонецЕсли;
 			Если Фл Тогда
				Если РЛ_Объект.ДатаОтгрузкиАвтомобиля <> Ссылка.Дата Тогда
					РЛ_Объект.ДатаОтгрузкиАвтомобиля = Ссылка.Дата;
					КорректироватьРЛ = Истина;
				КонецЕсли;
			Иначе	
				Если РЛ_Объект.ДатаОтгрузкиАвтомобиля <> Дата(1,1,1) Тогда
					РЛ_Объект.ДатаОтгрузкиАвтомобиля = Дата(1,1,1);
					КорректироватьРЛ = Истина;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Не обЗначениеНеЗаполнено(РЛ_Объект.ОтгрузкаАвтомобиля) Тогда
				РЛ_Объект.ОтгрузкаАвтомобиля = "";
				КорректироватьРЛ = Истина;
			КонецЕсли;
 			Если Фл Тогда
				Если РЛ_Объект.ДатаОтгрузкиАвтомобиля <> Дата(1,1,1) Тогда
					РЛ_Объект.ДатаОтгрузкиАвтомобиля = Дата(1,1,1);
					КорректироватьРЛ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если КорректироватьРЛ Тогда
			Попытка
	 			РЛ_Объект.Записать();
	 			СМГ_Сообщить("Успешно откорректирован "+РЛ_Объект);
			Исключение
				СМГ_Сообщить("ОШИБКА! Не удалось откорректировать "+РЛ_Объект,СтатусСообщения.ОченьВажное);
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РЛ_;
	
КонецФункции
