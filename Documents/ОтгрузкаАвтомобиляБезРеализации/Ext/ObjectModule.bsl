Процедура СМГ_ПровестиБонусныеБаллыДилера(ДокРЛ)
	
	 	Если Не обЗначениеНеЗаполнено(ДокРЛ) Тогда
			Для Сч = 1 По 5 Цикл
				
				МаркПрограмма_ = Справочники.МаркетинговыеПрограммы.ПустаяСсылка();
				ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.ПустаяСсылка(); 	
				Компенсация_ = 0;
				
				Если Сч = 1 Тогда
					МаркПрограмма_ = ДокРЛ.МаркетинговаяПрограммаСкидкаТрейдИн;
 					Если НЕ обЗначениеНеЗаполнено(МаркПрограмма_) Тогда
						Если ДокРЛ.КомпенсацияТрейдИНРетроспективная > 0 Тогда     
							Компенсация_ = ДокРЛ.КомпенсацияТрейдИНРетроспективная;
							ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.Ретроспективная; 	
						Иначе 
							Компенсация_ = ДокРЛ.КомпенсацияТрейдИНВИнВойсеСледующегоАвтомобиля;
							ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего; 	
  					    КонецЕсли;
					КонецЕсли;
 				ИначеЕсли Сч = 2 Тогда	
					МаркПрограмма_ = ДокРЛ.МаркетинговаяПрограммаСкидкаТрейдИн2;
					Если ДокРЛ.КомпенсацияТрейдИН2Ретроспективная > 0 Тогда     
						Компенсация_ = ДокРЛ.КомпенсацияТрейдИН2Ретроспективная;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.Ретроспективная; 	
					Иначе 
						Компенсация_ = ДокРЛ.КомпенсацияТрейдИНВИнВойсеСледующегоАвтомобиля;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего; 	
 				    КонецЕсли;
				ИначеЕсли Сч = 3 Тогда
					МаркПрограмма_ = ДокРЛ.МаркетинговаяПрограммаСкидкаСубсидияКредит;
					Если ДокРЛ.КомпенсацияСубсидияКредитРетроспективная > 0 Тогда     
						Компенсация_ = ДокРЛ.КомпенсацияСубсидияКредитРетроспективная;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.Ретроспективная; 	
					Иначе 
						Компенсация_ = ДокРЛ.КомпенсацияСубсидияКредитВИнВойсеСледующегоАвтомобиля;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего; 	
 				    КонецЕсли;
				ИначеЕсли Сч = 4 Тогда	
                    МаркПрограмма_ = ДокРЛ.МаркетинговаяПрограммаСкидкаПоПрограммамЛояльности;
					Если ДокРЛ.КомпенсацияПоПрограммамЛояльностиРетроспективная > 0 Тогда     
						Компенсация_ = ДокРЛ.КомпенсацияПоПрограммамЛояльностиРетроспективная;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.Ретроспективная; 	
					Иначе 
						Компенсация_ = ДокРЛ.КомпенсацияПоПрограммамЛояльностиВИнВойсеСледующегоАвтомобиля;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего; 	
 				    КонецЕсли;
				ИначеЕсли Сч = 5 Тогда	
					МаркПрограмма_ = ДокРЛ.МаркетинговаяПрограммаСкидкаПоПрограммамЛояльностиДополнительно;
					Если ДокРЛ.КомпенсацияРозничнаяРетроспективная > 0 Тогда     
						Компенсация_ = ДокРЛ.КомпенсацияРозничнаяРетроспективная;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.Ретроспективная; 	
					Иначе 
						Компенсация_ = ДокРЛ.КомпенсацияРозничнаяВИнВойсеСледующегоАвтомобиля;
						ВариантКомпенсации_ = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего; 	
 				    КонецЕсли;
				КонецЕсли;
				
				Если Не обЗначениеНеЗаполнено(МаркПрограмма_) Тогда
					Если Не обЗначениеНеЗаполнено(ВариантКомпенсации_) Тогда
						Если Компенсация_ > 0 Тогда
  							
	 	 		  			Движение = Движения.БонусныеБаллыДилера.Добавить();
							Движение.ВидДвижения = ВидДвиженияНакопления.Приход; 
							Движение.Период = Дата; 
							Движение.Автомобиль = ДокРЛ.Автомобиль;
							Движение.ПодразделениеКомпании = ДокРЛ.ПодразделениеКомпании;
							Движение.Организация = ДокРЛ.Организация;
							Движение.Марка = ДокРЛ.Автомобиль.Модель.Марка;
							Движение.Модель = ДокРЛ.Автомобиль.Модель;
							Движение.ХозОперация = Справочники.ХозОперации.БонусныеБаллыДилераПриход;
							Движение.МаркетинговаяПрограмма = МаркПрограмма_;
							Движение.ВариантКомпенсации = ВариантКомпенсации_; 
							
							//Бондаренко++ 20260418
							Движение.ВариантОстатков = Перечисления.НачисленоПодтверждено.Начислено;
							//Бондаренко-- 20260418
							
							Движение.Компенсация = Компенсация_;
							Движение.Регистратор = Ссылка;
							Движение.ФактическаяЦенаПродажиАвто = Сумма;
							
							Движение.КонтрагентПокупатель = ДокРЛ.Контрагент;
							Движение.ДатаПродажи = Дата;
							Движение.ДокументРеализации = Ссылка;
							Движение.ДатаРитейла = "";
							Движение.ДатаПодтверждения = "";
							Движение.ДатаПолучения = "";
							
							//Бондаренко++ 20260401
							Движение.РабочийЛист = ДокРЛ.Ссылка;
							//Бондаренко-- 20260401
							
 							
						КонецЕсли;
 					КонецЕсли;
				КонецЕсли;
   			КонецЦикла;
  		КонецЕсли;
 

КонецПроцедуры //СМГ_ПровестиБонусныеБаллыДилера(РабЛист_)



Процедура ОбработкаПроведения(Отказ, Режим)

	//Бондаренко++ 20260401
 	РабЛист_ = "";
	Проведение_ = Истина;                    
	Движения.БонусныеБаллыДилера.Очистить();
	Если ХозОперация = Справочники.ХозОперации.ОтгрузкаАвтомобиляБезРеализации Тогда
		РабЛист_ = СМГ_ОткорректироватьРЛ(Проведение_,Ссылка); 
 		Если Дата >= ДеньЭрЭл Тогда
 			СМГ_ПровестиБонусныеБаллыДилера(РабЛист_); 	
		КонецЕсли;
		
		// Семенихин 24.05.2026 +++++
		мМарки = Новый Массив();
		мМарки.Добавить(Справочники.Марка.TENET);
		мМарки.Добавить(Справочники.Марка.CHERY);
		Если мМарки.Найти(Автомобиль.Модель.Марка) <> Неопределено Тогда
			СМ_ФормированиеНовыхОбъектов.СоздатьЗавершитьВыдачуАвтомобиля(Дата, Автомобиль, РабЛист_);
		КонецЕсли;
		// Семенихин 24.05.2026 -----
		
	Иначе	
		РабЛист_ = СМГ_ОткорректироватьРЛ(Проведение_,Ссылка.ДокументОснование);
 	КонецЕсли;
	//Бондаренко-- 20260401
    
 	Если ХозОперация = Справочники.ХозОперации.ОтгрузкаАвтомобиляБезРеализации Тогда
		
		Движения.ОстаткиАвтомобилей.Очистить();
		
		//Бондаренко++ 20251224
		Если БезСписанияОстаткаАвто Тогда
		    Возврат;
		КонецЕсли;
		//Бондаренко-- 20251224
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
		|	ОстаткиАвтомобилейОстатки.СкладКомпании КАК СкладКомпании,
		|	ОстаткиАвтомобилейОстатки.СтатусПартии КАК СтатусПартии,
		|	ОстаткиАвтомобилейОстатки.Партия КАК Партия,
		|	ОстаткиАвтомобилейОстатки.ГТД КАК ГТД,
		|	ОстаткиАвтомобилейОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ОстаткиАвтомобилейОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ОстаткиАвтомобилейОстатки.СуммаУпрОстаток КАК СуммаУпрОстаток,
		|	ОстаткиАвтомобилейОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&Дата, ) КАК ОстаткиАвтомобилейОстатки
		|ГДЕ
		|	ОстаткиАвтомобилейОстатки.Автомобиль = &Автомобиль
		|	И ОстаткиАвтомобилейОстатки.СкладКомпании = &СкладКомпании
		|	И ОстаткиАвтомобилейОстатки.КоличествоОстаток = 1";
		
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
		Запрос.УстановитьПараметр("СкладКомпании",СкладКомпании);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Движение = Движения.ОстаткиАвтомобилей.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Автомобиль = ВыборкаДетальныеЗаписи.Автомобиль;
			Движение.СкладКомпании = ВыборкаДетальныеЗаписи.СкладКомпании;
			Движение.СтатусПартии = ВыборкаДетальныеЗаписи.СтатусПартии;
			Движение.Партия = ВыборкаДетальныеЗаписи.Партия;
			Движение.ГТД = ВыборкаДетальныеЗаписи.ГТД;
			Движение.Количество = ВыборкаДетальныеЗаписи.КоличествоОстаток;
			Движение.Сумма = ВыборкаДетальныеЗаписи.СуммаОстаток;
			Движение.СуммаУпр = ВыборкаДетальныеЗаписи.СуммаУпрОстаток;
			Движение.СуммаНДС = ВыборкаДетальныеЗаписи.СуммаНДСОстаток;
			
			Движение.ХозОперация = ХозОперация;
			
			//Бондаренко++ 20251223
			//Движение = Движения.ПродажиАвтомобилей.Добавить();
			//Движение.Период = Дата;
			//Движение.Автомобиль = ВыборкаДетальныеЗаписи.Автомобиль;
			//Движение.ДоговорВзаиморасчетов = ДоговорВзаиморасчетов;
			//Движение.ДокументПродажи = Ссылка;
			//Движение.Количество = ВыборкаДетальныеЗаписи.КоличествоОстаток;
			//Движение.Партия = ВыборкаДетальныеЗаписи.Партия;
			//Движение.ПодразделениеКомпании = ПодразделениеКомпании;
			//Движение.Покупатель = Контрагент;
			//Движение.Поставщик = ВыборкаДетальныеЗаписи.Партия.Контрагент;
			//Движение.Себестоимость = ВыборкаДетальныеЗаписи.СуммаОстаток;
			//Движение.СебестоимостьУпр = ВыборкаДетальныеЗаписи.СуммаУпрОстаток;
			//Движение.СкладКомпании = СкладКомпании;
			//Движение.Сумма = Сумма;
			//Движение.СуммаУпр = Сумма;
			//Движение.СтатусПартии = ВыборкаДетальныеЗаписи.СтатусПартии;
			//Движение.ГТД = ВыборкаДетальныеЗаписи.ГТД;
			//Движение.ХозОперация = ХозОперация;
			//Если Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
			//	Движение.КолФизЛица = 1;
			//Иначе
			//	Движение.КолФизЛица = 0;
			//КонецЕсли;
			//Если ДокументОснование.ВКредит Тогда
			//	Движение.КолКредит = 1;
			//Иначе
			//	Движение.КолКредит = 0;
			//КонецЕсли;		                                   
			//Если Не обЗначениеНеЗаполнено(ДокументОснование.ПоступлениеАвтоТрэйдИн) Тогда
			//	Движение.КолТрейдИн = 1;		
			//Иначе
			//	Движение.КолТрейдИн = 0;
			//КонецЕсли;		
			//
			//Движение.СтавкаНДС = СтавкаНДС;
			//Движение.СуммаНДС =  СуммаНДС;
			//Бондаренко-- 20251223
			
		КонецЦикла;
		//Бондаренко++ 20251114	
	Иначе
		Если Не ДокументОснование.Проведен Тогда
			СМГ_Сообщить("ОШИБКА! Документ-основание <<"+ДокументОснование+">> не проведен.",СтатусСообщения.ОченьВажное);
			Отказ = Истина;
			Возврат;	
		КонецЕсли;
		Если НЕ ТипЗНЧ(ДокументОснование) = Тип("ДокументСсылка.ОтгрузкаАвтомобиляБезРеализации") Тогда
			СМГ_Сообщить("ОШИБКА! Тип значения документа-основания <<"+ДокументОснование+">> должен быть ОАБР.",СтатусСообщения.ОченьВажное);
			Отказ = Истина;
			Возврат;	
		КонецЕсли;
		ТЗ_остатки = Новый ТаблицаЗначений;
		ТЗ_остатки = ПолучитьДвиженияОстаткиДокОсн(ДокументОснование);
		Если ТЗ_остатки.Количество() > 0 Тогда
			Для каждого Стр Из ТЗ_остатки Цикл
				Движение = Движения.ОстаткиАвтомобилей.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				Движение.Период = Дата;
				Движение.Автомобиль = Стр.Автомобиль;
				Движение.СкладКомпании = Стр.СкладКомпании;
				Движение.СтатусПартии = Стр.СтатусПартии;
				Движение.Партия = Стр.Партия;
				Движение.ГТД = Стр.ГТД;
				Движение.Количество = Стр.Количество;
				Движение.Сумма = Стр.Сумма;
				Движение.СуммаУпр = Стр.СуммаУпр;
				Движение.СуммаНДС = Стр.СуммаНДС;
				Движение.ХозОперация = ХозОперация;
			КонецЦикла;
		КонецЕсли;
		ТЗ_продажи = Новый ТаблицаЗначений;
		ТЗ_продажи = ПолучитьДвиженияПродажиДокОсн(ДокументОснование);
		Если ТЗ_продажи.Количество() > 0 Тогда
			Для каждого Стр Из ТЗ_продажи Цикл
				Движение = Движения.ПродажиАвтомобилей.Добавить();
				Движение.Период = Дата;
				Движение.Автомобиль = Стр.Автомобиль;
				Движение.ДоговорВзаиморасчетов = Стр.ДоговорВзаиморасчетов;
				Движение.ДокументПродажи = ДокументОснование;
				Движение.Количество = - Стр.Количество;
				Движение.Партия = Стр.Партия;
				Движение.ПодразделениеКомпании = Стр.ПодразделениеКомпании;
				Движение.Покупатель = Стр.Покупатель;
				Движение.Поставщик = Стр.Поставщик;
				Движение.Себестоимость = - Стр.Себестоимость;
				Движение.СебестоимостьУпр = - Стр.СебестоимостьУпр;
				Движение.СкладКомпании = Стр.СкладКомпании;
				Движение.Сумма = - Стр.Сумма;
				Движение.СуммаУпр = - Стр.Сумма;
				Движение.СтатусПартии = Стр.СтатусПартии;
				Движение.ГТД = Стр.ГТД;
				Движение.СтавкаНДС = Стр.СтавкаНДС;
				Движение.СуммаНДС = - Стр.СуммаНДС;
				Движение.СуммаНДСВходящий = - Стр.СуммаНДСВходящий;
				Движение.КолКредит = - Стр.КолКредит;
				Движение.КолТрейдИн = - Стр.КолТрейдИн;
				Движение.КолФизЛица = - Стр.КолФизЛица;
