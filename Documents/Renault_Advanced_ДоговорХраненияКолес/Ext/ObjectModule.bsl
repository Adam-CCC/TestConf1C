//	                                        "Бирки",
//											"Договор хранения",
//											"Прайс-лист хранителя",
//											"СчетЗаказ",
//											"АктБезПросрочки",
//											"СчетЗаказДоплата",
//											"СчетФактура",
//											"ПикингЛист",
//											"АктВозврата");
//Возврат СтруктураПечатныхФорм;  //для отладки
/////////////
	Если НЕ Проведен Тогда
		 СтруктураПечатныхФорм = Новый Структура;
	Иначе
		 Если НЕ ЗначениеЗаполнено(ДатаВыдачиФакт) Тогда
			 СтруктураПечатныхФорм = Новый Структура("ПечатьактаПриемаКолес, 
											|Бирки,
											|ДоговорХранения,
											|ПрайсЛистХранителя,
											|СчетЗаказ",
											"Акт приема-передачи",
	                                        "Бирки",
											"Договор хранения",
											"Прайс-лист хранителя",
											"Счет на оплату");
		ИначеЕсли ЗначениеЗаполнено(ДатаВыдачиФакт) И СрокХраненияПросрочка > 0 И СправочникДанных.Работы.Количество() > 1 Тогда 
			
					СтруктураПечатныхФорм = Новый Структура("АктБезПросрочки,														
											|СчетЗаказДоплата,
											|СчетФактура,
											|ПикингЛист",		 
											"Акт оказанных услуг",
											"Счет на оплату (ПРИ ПРОСРОЧКЕ)",
											"Счет-фактура",
											"Пикинг-лист на выдачу хранения");				 			 
		ИначеЕсли ЗначениеЗаполнено(ДатаВыдачиФакт) И СрокХраненияПросрочка > 0 И СправочникДанных.Работы.Количество() = 1 Тогда
											   СтруктураПечатныхФорм = Новый Структура("АктБезПросрочки,														
											|СчетЗаказДоплата,
											|СчетФактура,
											|ПикингЛист,				 			 
											|АктВозврата",
											"Акт оказанных услуг",
											"Счет на оплату (ПРИ ПРОСРОЧКЕ)",
											"Счет-фактура",
											"Пикинг-лист на выдачу хранения",				 			 
											"Акт оказанных услуг (ЕСТЬ ПРОСРОЧКА)");   	
		ИначеЕсли ЗначениеЗаполнено(ДатаВыдачиФакт) И СрокХраненияПросрочка = 0 Тогда 
		СтруктураПечатныхФорм = Новый Структура("АктБезПросрочки,														
											|СчетФактура,
											|ПикингЛист",				 			 
											"Акт оказанных услуг (НЕТ ПРОСРОЧКИ)",
											"Счет-фактура",
											"Пикинг-лист на выдачу хранения");				 			 
		КонецЕсли;
	КонецЕсли;							
										
 Возврат СтруктураПечатныхФорм; 											

КонецФункции // ПолучитьСтруктуруПечатныхФорм()

//!
Функция ПосчитатьСумму(Цена = 0) Экспорт 
	
	Если Не ЗначениеЗаполнено(Размер) Тогда
	    Цена = 0;
		Возврат 0;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныХраненияКолесСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.Renault_Advanced_ЦеныХраненияКолес.СрезПоследних(
		|			&МоментВремени,
		|			Размер = &Размер
		|				И УдаленноеХранение = &УдаленноеХранение) КАК ЦеныХраненияКолесСрезПоследних";

	Запрос.УстановитьПараметр("МоментВремени", Дата);
	Запрос.УстановитьПараметр("Размер", Размер);
	Запрос.УстановитьПараметр("УдаленноеХранение", УдаленноеХранение);

	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда   
		Цена = ВыборкаДетальныеЗаписи.Цена;
		Сумма = Цена*СрокХранения;
		СуммаСкидки = Сумма * ПроцентСкидкиНаценки / 100;
		Возврат (Сумма-СуммаСкидки); 
	Иначе
		Цена = 0;
		Возврат 0;
	КонецЕсли;
	
КонецФункции

//!
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка  Тогда
		Возврат;
	КонецЕсли;

	ПроверитьЗаполнениеРеквизитов(Отказ);
    Если Не Отказ Тогда
		
		мДатаВыдачиФакт = Неопределено;
		мСуммаПросрочки = Неопределено;
		Если ДополнительныеСвойства.Свойство("ДатаВыдачиФакт", мДатаВыдачиФакт) И Не ДатаВыдачиФакт = мДатаВыдачиФакт Тогда
			
			ДатаВыдачиФакт = мДатаВыдачиФакт;	
			
		КонецЕсли;
		Если ДополнительныеСвойства.Свойство("СуммаПросрочки", мСуммаПросрочки) И Не СуммаПросрочки = мСуммаПросрочки Тогда
			
			СуммаПросрочки = мСуммаПросрочки;	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//!
Процедура ПроверитьЗаполнениеРеквизитов(Отказ)

	// проверки заполненности полей
	Если Не ЗначениеЗаполнено(МК) Тогда
		Сообщить("Не заполнен принявший!");	
		Отказ = Истина;
	КонецЕсли;	
	
	Если Не ТолькоДиски И Не ЗначениеЗаполнено(Габариты) Тогда	
		Сообщить("Не заполнены габариты!");
	КонецЕсли;
	
	Если Не Автопокрышки И Не КолесаВСборе И Не ТолькоДиски Тогда	
		Сообщить("Не заполнены Только диски/Автопокрышки/Колеса В Сборе!");
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Количество) Тогда
		Сообщить("Не заполнено Количество!");
		Отказ = Истина;	
	КонецЕсли;
	
	Если Не ТолькоДиски И Не ЗначениеЗаполнено(ШинаПроизводитель) Тогда
		Сообщить("Не заполнен производитель шин!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ТолькоДиски И Не ЗначениеЗаполнено(ТипПокрышки) Тогда
		Сообщить("Не заполнен тип покрышки!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Размер) Тогда
		Сообщить("Не заполнен Размер!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Новые и Не ЗначениеЗаполнено(СтепеньИзноса) Тогда
		Сообщить("Не заполнена степень износа!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ТолькоДиски И Не ЗначениеЗаполнено(ИндексСкорости) Тогда
		Сообщить("Не заполнен Индекс Скорости!");	
	КонецЕсли;
	
	Если Не ТолькоДиски И Не ЗначениеЗаполнено(ИндексНагрузки) Тогда
		Сообщить("Не заполнен Индекс Нагрузки!");	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СрокХранения) Тогда
		Сообщить("Не заполнен Срок хранения!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ Автопокрышки Тогда
		Если Не ОригТипДисков И Не НеОригТипДисков Тогда
			Сообщить("Не заполнены Оригинальные/Неоригинальный тип дисков!");	
			Отказ = Истина;
		КонецЕсли;
		
		Если Не ОригТипДисков И Не НеОригТипДисков Тогда
			Сообщить("Не заполнены Оригинальные/Неоригинальный тип дисков!");	
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Не КрепежСдан И Не КрепежНеСдан Тогда
		Сообщить("Не заполнено Крепеж сдан/не сдан!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если Не СупинаторыЕсть И Не СупинаторовНет Тогда
		Сообщить("Не заполнено Супинаторы есть/нет!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если Не СекреткиЕсть И Не СекретокНет Тогда
		Сообщить("Не заполнено Секретки есть/нет!");	
		Отказ = Истина;
	КонецЕсли;
	
	Если КолесаВСборе Или ТолькоДиски Тогда
		
		Если Не ДискСталные И Не ДискЛегкосплавные Тогда
			Сообщить("Не заполнен тип дисков Стальные/Легкосплавные!");	
			Отказ = Истина;
		КонецЕсли;	
		
	КонецЕсли;
	
	Если КолесаВСборе Или Автопокрышки Тогда  		
		Если Не ЗначениеЗаполнено(ШинаШирина) Тогда
			Сообщить("Не заполнена ширина шин (W)!");	
			Отказ = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ШинаПрофиль) Тогда
			Сообщить("Не заполнен профиль шин (h/w)!");	
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИндексНагрузки) Тогда
			Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке("Не заполнен индекс нагрузки(ind G)!", Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИндексСкорости) Тогда
			Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке("Не заполнен индекс скорости(ind V)!", Отказ);
		КонецЕсли; 		
	КонецЕсли;	
КонецПроцедуры

//!
Функция ВычислитьСуммуПросрочки(КоличествоИзделий, Дата1, Дата2, ЦенаХраненияВМесяц = 0, РасчетПоДням = Ложь) Экспорт 
	
	Если Дата1 <= Дата2 Или КоличествоИзделий = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Лет		= 0;
	Месяцев	= 0;
	Дней	= 0;     
	РазобратьРазностьДат(Дата1, Дата2, Лет, Месяцев, Дней); 
	
	//если просрочка больше года, не правильно считалось количество месяцев 
	Если Лет > 0 Тогда
		Месяцев = Лет * 12 + Месяцев;
	КонецЕсли;
	
	СрокХраненияПросрочка = Макс(Месяцев, 1);
	
	Если РасчетПоДням Тогда //по дням
		Возврат Дней*ЦенаХраненияВМесяц/30;
	Иначе                   //по месяцам	
		Возврат Макс(Месяцев, 1)*ЦенаХраненияВМесяц;
	КонецЕсли;
	
КонецФункции // ВычислитьСуммуПросрочки()

//! Процедура вычисляет количество лет, месяцев и дней между двумя датами
//
// Параметры
//  Дата1	– дата, первая дата (более поздняя, часто текущая, стаж определяется по состоянию на эту дату)
//  Дата2	– дата, вторая дата (ранняя дата, с нее начинается "течение" стажа)
//  Лет		– Число, в этот параметр будет записано кол-во лет между двумя датами (Дата1-Дата2)
//  Месяцев	– Число, в этот параметр будет записано кол-во месяцев между двумя датами (Дата1-Дата2)
//  Дней	– Число, в этот параметр будет записано кол-во дней между двумя датами (Дата1-Дата2)
//
Процедура РазобратьРазностьДат(Дата1, Дата2, Лет = 0, Месяцев = 0, Дней = 0) Экспорт
	
	Лет		= 0;
	Месяцев	= 0;
	Дней	= 0;
	Если Дата1 > Дата2 Тогда
		
		ВременнаяДата = Дата1;
		Если День(ВременнаяДата) < День(Дата2) Тогда
			Дней = (ВременнаяДата - ДобавитьМесяц(ВременнаяДата,-1))/86400;
			ВременнаяДата = ДобавитьМесяц(ВременнаяДата,-1);
		КонецЕсли;
		Если Месяц(ВременнаяДата) < Месяц(Дата2) Тогда
			ВременнаяДата = ДобавитьМесяц(ВременнаяДата,-12);
			Месяцев = 12;
		КонецЕсли;
		Лет		= Макс(			 Год(ВременнаяДата)		- Год(Дата2),	0);
		Месяцев	= Макс(Месяцев	+ Месяц(ВременнаяДата)	- Месяц(Дата2),	0);
		Дней	= Макс(Дней		+ День(ВременнаяДата)	- День(Дата2),	0);
		
		// скорректируем отображаемое значение, если "вмешалось" разное количество дней в месяцах
		Если Дата2 <> (ДобавитьМесяц(Дата1,-Лет*12-Месяцев)-Дней*86400) Тогда
			Дней = Дней + (День(КонецМесяца(Дата2)) - День(НачалоМесяца(Дата2))) - (День(КонецМесяца(ДобавитьМесяц(Дата1,-1))) - День(НачалоМесяца(ДобавитьМесяц(Дата1,-1))));
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры	// РазобратьРазностьДат

//! Процедура - обработчик события "ОбработкаУдаленияПроведения".
//
Процедура ОбработкаУдаленияПроведения(Отказ) 
	Движения.Renault_Advanced_ИсторияХраненияКолес.Очистить();
	Движения.Renault_Advanced_ПродажиСервиса.Очистить();
	Движения.Записать();
КонецПроцедуры // ОбработкаУдаленияПроведения

//!
Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = Новый Структура;
	СтруктураШапкиДокумента.Вставить("Ссылка", ЭтотОбъект.Ссылка);
	СтруктураШапкиДокумента.Вставить("Дата", ЭтотОбъект.Дата);
	МетаданныеДокумента = ЭтотОбъект.Метаданные();
	Для каждого Реквизит из МетаданныеДокумента.Реквизиты Цикл
		СтруктураШапкиДокумента.Вставить(Реквизит.Имя, ЭтотОбъект[Реквизит.Имя]);
	КонецЦикла; 	
	
	СтруктураШапкиДокумента.Вставить("ВидДокумента", МетаданныеДокумента.Имя);
	СтруктураШапкиДокумента.Вставить("ПредставлениеДокумента", СокрЛП(ЭтотОбъект));
	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = Renault_Advanced_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(СтруктураШапкиДокумента);
	Если НЕ Отказ Тогда
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, Отказ, Заголовок);
	КонецЕсли;
	
КонецПроцедуры

//!
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	// регистр Renault_Advanced_ИсторияХраненияКолес 
	Движения.Renault_Advanced_ИсторияХраненияКолес.Очистить();
	Движение = Движения.Renault_Advanced_ИсторияХраненияКолес.Добавить();
	Движение.Период       = СтруктураШапкиДокумента.Дата;
	Движение.ЗаказНаряд   = СтруктураШапкиДокумента.ЗаказНаряд;
	Движение.Контрагент   = СтруктураШапкиДокумента.Контрагент;
	Движение.Размер       = СтруктураШапкиДокумента.Размер;
	Движение.Количество   = СтруктураШапкиДокумента.Количество;
	Движение.СрокХранения = СтруктураШапкиДокумента.СрокХранения;
	Движение.Сумма        = СтруктураШапкиДокумента.Сумма;
	
	СправочникДанных = Renault_AdvancedСервер.ПолучитьСправочникДанныхЗаказНаряда(СтруктураШапкиДокумента.ЗаказНаряд);
	СправочникДанныхОбъект = СправочникДанных.ПолучитьОбъект();
	
	Если ЗначениеЗаполнено(СтруктураШапкиДокумента.ДатаВыдачиФакт) Тогда //выдача
		
		Если (СтруктураШапкиДокумента.СрокХраненияПросрочка>0 
			Или СтруктураШапкиДокумента.СуммаПросрочки >0) Тогда //фиксируем просрочку
			
			Движение = Движения.Renault_Advanced_ИсторияХраненияКолес.Добавить();
			Движение.Период       = СтруктураШапкиДокумента.Дата;
			Движение.ЗаказНаряд   = СтруктураШапкиДокумента.ЗаказНаряд;
			Движение.Контрагент   = СтруктураШапкиДокумента.Контрагент;
			Движение.Размер       = СтруктураШапкиДокумента.Размер;
			Движение.Количество   = СтруктураШапкиДокумента.Количество;
			Движение.СрокХранения = СтруктураШапкиДокумента.СрокХраненияПросрочка;
			Движение.Сумма        = СтруктураШапкиДокумента.СуммаПросрочки;
			Движение.ЭтоДопХранение = Истина;
			
			// регистр Renault_Advanced_ПродажиСервиса 
			обЗН = СтруктураШапкиДокумента.ЗаказНаряд.ПолучитьОбъект();			
 
			СтруктураШапкиДокументаЗН = Renault_Advanced_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(обЗН, СправочникДанныхОбъект);
			
			Движения.Renault_Advanced_ПродажиСервиса.Очистить();
			Движение = Движения.Renault_Advanced_ПродажиСервиса.Добавить();
			Движение.Период         = СтруктураШапкиДокумента.Дата;
			Движение.ЗаказНаряд     = СтруктураШапкиДокумента.ЗаказНаряд;
			Движение.Контрагент     = СтруктураШапкиДокумента.Контрагент;
			Движение.ВидОбслуживания = СтруктураШапкиДокументаЗН.ВидОбслуживания;
			Движение.ВидОплаты       = СтруктураШапкиДокументаЗН.ВидОплаты;
			
			ТекУслуга = ПолучитьУслугуПоНоменклатуре(СтруктураШапкиДокументаЗН.Автоуслуга);
			
			Движение.Номенклатура   = ТекУслуга;
			Движение.Количество     = СтруктураШапкиДокумента.СрокХраненияПросрочка;
			Движение.Сумма          = СтруктураШапкиДокумента.СуммаПросрочки;
			Движение.СуммаБезСкидок = СтруктураШапкиДокумента.СуммаПросрочки;
			Движение.НДС            = Renault_Advanced_УчетНДС.РассчитатьСуммуНДС(СтруктураШапкиДокумента.СуммаПросрочки,
											СтруктураШапкиДокументаЗН.УчитыватьНДС, СтруктураШапкиДокументаЗН.СуммаВключаетНДС,
											Renault_Advanced_УчетНДС.ПолучитьСтавкуНДС(СтруктураШапкиДокументаЗН.Автоуслуга.СтавкаНДС));
			
			Движение.Склад = СтруктураШапкиДокументаЗН.СкладРемзоны;
			Движение.ДоговорКонтрагента = СтруктураШапкиДокументаЗН.ДоговорВзаиморасчетов;
			Движение.Подразделение = СтруктураШапкиДокументаЗН.ПодразделениеКомпании;
			
			ЗаполнитьЗначенияСвойств(Движение, СтруктураШапкиДокументаЗН, "Организация, Контрагент, Плательщик, ВалютаДокумента, Обслуживание");
			
			Если НЕ ЗначениеЗаполнено(Движение.Изделие) И ЗначениеЗаполнено(СтруктураШапкиДокументаЗН.Автомобиль) Тогда
				Движение.Изделие = СтруктураШапкиДокументаЗН.Автомобиль;
			КонецЕсли;
			
			СтруктураШапкиДокументаЗН.Вставить("КурсДвиженийУпр", 1);
			
			Движение.ИсточникИнформацииПриОбращении = СтруктураШапкиДокументаЗН.ИсточникИнформацииПриОбращении;
			Движение.СуммаУпр          = Движение.Сумма* СтруктураШапкиДокументаЗН.КурсДвиженийУпр;
			Движение.СуммаБезСкидокУпр = Движение.СуммаБезСкидок* СтруктураШапкиДокументаЗН.КурсДвиженийУпр;
			Движение.НДСУпр            = Движение.НДС* СтруктураШапкиДокументаЗН.КурсДвиженийУпр;
			
			//////////////////
			//Если зафиксирована просрочка, добавляем сведения об этом в заказ-наряд
			СуммаРабот = Renault_Advanced_УчетНДС.ПолучитьСуммуДокументаСНДС(СправочникДанныхОбъект, "Работы");
			СуммаДогХК = СтруктураШапкиДокумента.Сумма; 
            СтатусЗН = СправочникДанныхОбъект.СтатусЗаказНаряда;
			Если Не СуммаРабот = СуммаДогХК
				И НЕ (СтатусЗН = Справочники.Renault_Advanced_СтатусыЗаказНарядов.Закрыт И СтруктураШапкиДокумента.ЗаказНаряд.Проведен)Тогда
				
				Работы = СправочникДанныхОбъект.Работы; 				
				
				ТекУслуга = Справочники.Автоработы.НайтиПоНаименованию("Хранение колес просроченное", Истина);
				//1) Добавим строку услуги
				НоваяСтрока = Работы.Добавить();
				НоваяСтрока.Работа = ТекУслуга;
				НоваяСтрока.Цена      = СтруктураШапкиДокумента.Цена;
				НоваяСтрока.ОбъемРаботы = 1;
				НоваяСтрока.Сумма      = СтруктураШапкиДокумента.СуммаПросрочки;
				НоваяСтрока.Количество   = СтруктураШапкиДокумента.СрокХраненияПросрочка;
				НоваяСтрока.СтавкаНДС    = СправочникДанныхОбъект.Автоуслуга.СтавкаНДС;  
				НоваяСтрока.СтадияРаботы = Справочники.Renault_Advanced_СтадииРаботы.Выполнено;
				НоваяСтрока.ПроцентСкидкиНаценки = СтруктураШапкиДокумента.ПроцентСкидкиНаценки;
				СправочникДанныхОбъект.ПересчитатьАвтоматическиеСкидки(обЗН);
				СправочникДанныхОбъект.ПересчитатьРучныеСкидкиРаботы();

				Renault_AdvancedКлиент.СохранитьДополнительныеНастройкиСправочникаДанных(ОбЗН.Ссылка, СправочникДанныхОбъект);
				СправочникДанныхОбъект.Наименование = Строка(ОбЗН.Ссылка);
				СправочникДанныхОбъект.Записать();

				обЗН.Записать();
			ИначеЕсли  НЕ СуммаРабот = СуммаДогХК И СтруктураШапкиДокумента.ЗаказНаряд.Проведен Тогда
				СоздатьСопутствующиеДокументы(Движение, СтруктураШапкиДокумента, СтруктураШапкиДокументаЗН, Отказ, Заголовок);
			КонецЕсли;
          ///////////////

		КонецЕсли;
	КонецЕсли;
	
	Если Не Отказ Тогда
		Если ЗначениеЗаполнено(ДатаВыдачиФакт) Тогда //это выдача

			Если НЕ СтруктураШапкиДокумента.ЗаказНаряд.Проведен Тогда

				Если НЕ СправочникДанных.Обслуживание = Справочники.Renault_Advanced_ТипыОбслуживания.Клиентский Тогда
					//попытаемся провести
					обЗН = СтруктураШапкиДокумента.ЗаказНаряд.ПолучитьОбъект();
					
					Если НЕ СправочникДанных.СтатусЗаказНаряда = Справочники.Renault_Advanced_СтатусыЗаказНарядов.Закрыт Тогда
						СправочникДанныхОбъект.СтатусЗаказНаряда = Справочники.Renault_Advanced_СтатусыЗаказНарядов.Закрыт
					КонецЕсли;
					
					Если обЗН.Пробег = 0 Тогда
						обЗН.Пробег = 1;
					КонецЕсли;
					
					обЗН.ДатаЗакрытия = ТекущаяДата();
					
					Renault_AdvancedКлиент.СохранитьДополнительныеНастройкиСправочникаДанных(ОбЗН.Ссылка, СправочникДанныхОбъект);
					СправочникДанныхОбъект.Наименование = Строка(ОбЗН.Ссылка);
					СправочникДанныхОбъект.Записать(); 

					обЗН.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
				
			КонецЕсли; 			
			
		Иначе                                        //это не выдача 	
			//сравним сумму работ по ЗН и сумму ДХК,
			//если они различаются, перезаполним ЗН
			обЗН = СтруктураШапкиДокумента.ЗаказНаряд.ПолучитьОбъект();
			СуммаРабот = Renault_Advanced_УчетНДС.ПолучитьСуммуДокументаСНДС(СправочникДанныхОбъект, "Работы");
			СуммаДогХК = СтруктураШапкиДокумента.Сумма; 
			Если Не СуммаРабот = СуммаДогХК Тогда
				
				Работы = СправочникДанныхОбъект.Работы; 
				
				Работы.Очистить();
				ТекУслуга = ПолучитьУслугуПоНоменклатуре(СправочникДанныхОбъект.Автоуслуга);
				//1) Добавим строку услуги
				НоваяСтрока = Работы.Добавить();
				НоваяСтрока.Работа = ТекУслуга;
				НоваяСтрока.Цена         = СтруктураШапкиДокумента.Цена;
				НоваяСтрока.ОбъемРаботы = 1;
				НоваяСтрока.Количество   = СтруктураШапкиДокумента.СрокХранения;
				НоваяСтрока.СтавкаНДС    = СправочникДанныхОбъект.Автоуслуга.СтавкаНДС;  
				НоваяСтрока.СтадияРаботы = Справочники.Renault_Advanced_СтадииРаботы.Выполнено;
				НоваяСтрока.ПроцентСкидкиНаценки = СтруктураШапкиДокумента.ПроцентСкидкиНаценки;
				СправочникДанныхОбъект.ПересчитатьАвтоматическиеСкидки(обЗН);
				СправочникДанныхОбъект.ПересчитатьРучныеСкидкиРаботы();
				
				Renault_AdvancedКлиент.СохранитьДополнительныеНастройкиСправочникаДанных(ОбЗН.Ссылка, СправочникДанныхОбъект);
				СправочникДанныхОбъект.Наименование = Строка(ОбЗН.Ссылка);
				СправочникДанныхОбъект.Записать(); 

				обЗН.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

//!
Процедура СоздатьСопутствующиеДокументы(СтрокаДвижения, СтруктураШапкиДокумента, СтруктураШапкиДокументаЗН, Отказ, Заголовок)    
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	#Если Клиент Тогда
	Состояние("Формирование сопутствующих документов...");
	#КонецЕсли

	//1) Заказ
	ЗаказПокупателя = ПолучитьСсылкуНаЗаказПокупателя();   
	Если ЗаказПокупателя = Неопределено Тогда
		ЗаказПокупателя = СоздатьЗаказПокупателя(Отказ, Заголовок, СтруктураШапкиДокументаЗН, СтрокаДвижения);
	КонецЕсли;
	
	//2) РТУ и Счет-фактура
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	СформироватьРеализациюТоваровИУслуг(Отказ, Заголовок, СтруктураШапкиДокумента, СтруктураШапкиДокументаЗН, СтрокаДвижения, Истина);
	
КонецПроцедуры

//!
Функция ПолучитьСкладыИзГруппы(ГруппаДоступностиСкладов) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ГруппаДоступностиСкладов) Тогда
		Возврат Справочники.СкладыКомпании.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(ГруппаДоступностиСкладов) = Тип("СправочникСсылка.СкладыКомпании") Тогда
		Возврат ГруппаДоступностиСкладов;
	КонецЕсли;
	
	СписокСкладов = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппаДоступностиСкладов", ГруппаДоступностиСкладов);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставГруппДоступностиСкладов.Склад
	|ИЗ
	|	РегистрСведений.Renault_СоставГруппДоступностиСкладов КАК СоставГруппДоступностиСкладов
	|ГДЕ
	|	СоставГруппДоступностиСкладов.ГруппаДоступности = &ГруппаДоступностиСкладов";
	
	СписокСкладов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");
	
	
	Возврат СписокСкладов;
	
КонецФункции // ПолучитьСкладыИзГруппы()

//! Создает заказ покупателя заказ-наряда.
//
Функция СоздатьЗаказПокупателя(Отказ, Заголовок, СтруктураШапкиДокументаЗН, СтрокаДвижения)
		
	Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
	Документ.ОбработкаЗаполнения(Неопределено);
	
	Документ.Организация = СтруктураШапкиДокументаЗН.Организация;
	Документ.ОбработкаРеквизита("Организация");
	
	Документ.ПодразделениеКомпании = СтруктураШапкиДокументаЗН.ПодразделениеКомпании;
	Документ.ДокументОснование = ЗаказНаряд;
	Документ.Комментарий = "Сформирован из документа " + ЗаказНаряд;
	
	Документ.Контрагент = СтруктураШапкиДокументаЗН.Плательщик;
	Документ.ОбработкаРеквизита("Контрагент");
	
	Документ.ДоговорВзаиморасчетов = СтруктураШапкиДокументаЗН.ДоговорПлательщика;
	Документ.ОбработкаРеквизита("ДоговорВзаиморасчетов");
	
	Документ.Проект = СтруктураШапкиДокументаЗН.Проект;
	Документ.ОбработкаРеквизита("Проект");
	
	СписокСкладов = ПолучитьСкладыИзГруппы(СтруктураШапкиДокументаЗН.СкладГруппа);
	Если ТипЗнч(СписокСкладов) = Тип("СправочникСсылка.СкладыКомпании") Тогда
		СкладЗаказаПокупателя = СписокСкладов;
	Иначе
		СкладЗаказаПокупателя = СписокСкладов[0];
	КонецЕсли;	
	 
	Документ.СкладКомпании = СкладЗаказаПокупателя;
	Документ.ОбработкаРеквизита("СкладКомпании");
	
	Документ.ДатаСоздания = ТекущаяДата();
	Документ.ОбработкаРеквизита("ДатаСоздания");
	
	Документ.ТипЦен = СтруктураШапкиДокументаЗН.ТипЦен;
	Документ.ОбработкаРеквизита("ТипЦен");
	
	Документ.Автомобиль = СтруктураШапкиДокументаЗН.Автомобиль;

	Документ.СрокПоставки = ?(ЗначениеЗаполнено(СтруктураШапкиДокументаЗН.ВремяИсполнения), СтруктураШапкиДокументаЗН.ВремяИсполнения, ТекущаяДата());
	Документ.ОбработкаРеквизита("ОтображениеСрокаПоставки");
	
	Документ.Товары.Очистить();
	СтрокаУслуг = Документ.Товары.Добавить();
	СтрокаУслуг.ИдентификаторСтроки = Новый УникальныйИдентификатор; 	
	СтрокаУслуг.Номенклатура = СтруктураШапкиДокументаЗН.Автоуслуга;
	Документ.ОбработкаРеквизита("Товары.Номенклатура", СтрокаУслуг); 
	СтрокаУслуг.ПримечаниеНоменклатура = ?(ЗначениеЗаполнено(СтрокаУслуг.Номенклатура.НаименованиеПолное), СтрокаУслуг.Номенклатура.НаименованиеПолное, СтрокаУслуг.Номенклатура.Наименование); 
	СтрокаУслуг.Цена = СтрокаДвижения.Сумма;
	СтрокаУслуг.Количество = 1;		
	Документ.ОбработкаРеквизита("Товары.Количество", СтрокаУслуг);  	
	СтрокаУслуг.СрокПоставкиВСтроке = ?(ЗначениеЗаполнено(СтруктураШапкиДокументаЗН.ВремяИсполнения), СтруктураШапкиДокументаЗН.ВремяИсполнения, ТекущаяДата());	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение); 		
		Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке("Сформирован документ " + Документ.Ссылка, , Заголовок, СтатусСообщения.Информация);
		Renault_Advanced_ОбщегоНазначения.ЗаписатьСвязиЗаказНаряда(Ссылка, Документ.Ссылка);
		
		Возврат Документ.Ссылка;
	Исключение
		Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(), Отказ);
		
		Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
	КонецПопытки;  
КонецФункции // СоздатьЗаказПокупателя()

//! Возвращает ссылку на один из документов заданного типа, сформированных из Заказ-наряда.
//
Функция ПолучитьСсылкуНаСформированныйДокумент(ТипДокумента, Фильтр = Неопределено) Экспорт
	
	Перем СсылкаНаДокумент;
	
	Если ТипЗнч(мСформированныеДокументы) <> Тип("Структура") Тогда
		мСформированныеДокументы = Новый Структура;
	КонецЕсли;
	
	Если НЕ мСформированныеДокументы.Свойство(ТипДокумента, СсылкаНаДокумент) ИЛИ НЕ ЗначениеЗаполнено(СсылкаНаДокумент) ИЛИ СсылкаНаДокумент.ПолучитьОбъект() = Неопределено Тогда
			
		СсылкаНаДокумент = Неопределено;	
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Регистратор", Ссылка);
	    //Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.ЗаказНаряд.Ссылка);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СформированныеДокументы.Документ КАК Документ." + ТипДокумента + ") КАК Ссылка
		|ИЗ
		|	РегистрСведений.Renault_Advanced_СформированныеДокументы КАК СформированныеДокументы
		|ГДЕ
		|	СформированныеДокументы.ЗаказНаряд = &Регистратор
		|	И СформированныеДокументы.Документ ССЫЛКА Документ." + ТипДокумента;
		
		Если ЗначениеЗаполнено(Фильтр) Тогда
			Для Каждого СтрокаФильтра Из Фильтр Цикл
				Запрос.УстановитьПараметр(СтрокаФильтра.Ключ, СтрокаФильтра.Значение);
				Запрос.Текст = Запрос.Текст + "
				|И СформированныеДокументы.Документ." + СтрокаФильтра.Ключ + " = &" + СтрокаФильтра.Ключ; 
			КонецЦикла;
		КонецЕсли;
	
		Выборка = Запрос.Выполнить().Выбрать();
	
		Если Выборка.Следующий() Тогда
			СсылкаНаДокумент = Выборка.Ссылка;
			Если НЕ ЗначениеЗаполнено(Фильтр) Тогда 
				мСформированныеДокументы.Вставить(ТипДокумента, СсылкаНаДокумент);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СсылкаНаДокумент;
	
КонецФункции // ПолучитьСсылкуНаСформированныйДокумент()

//! Получает ссылку на документ "Реализация товаров и услуг", сформированный из "Заказ-наряда".
//
Функция ПолучитьСсылкуНаРТиУ() Экспорт
	
	Возврат ПолучитьСсылкуНаСформированныйДокумент("РеализацияТоваров");
	
КонецФункции // ПолучитьСсылкуНаРТиУ()

//!
Функция ПолучитьСсылкуНаЗаказПокупателя() Экспорт
	
	Возврат ПолучитьСсылкуНаСформированныйДокумент("ЗаказПокупателя");
	
КонецФункции // ПолучитьСсылкуНаРТиУ()

//! Получает ссылку на документ "Счет на оплату покупателю", сформированный из "Заказ-наряда".
//
Функция ПолучитьСсылкуНаСчетНаОплату() Экспорт
	
	Перем СчетНаОплатуПокупателю;
	
	Если ТипЗнч(мСформированныеДокументы) <> Тип("Структура") Тогда
		мСформированныеДокументы = Новый Структура;
	КонецЕсли;
	
	Если НЕ мСформированныеДокументы.Свойство("СчетНаОплатуПокупателю", СчетНаОплатуПокупателю) ИЛИ НЕ ЗначениеЗаполнено(СчетНаОплатуПокупателю) ИЛИ СчетНаОплатуПокупателю.ПолучитьОбъект() = Неопределено Тогда
		
		СчетНаОплатуПокупателю = Неопределено;
		
		// Если заказ покупателя по каким-либо причинам не создан, то счет найти мы не сможем - выходим
		ЗаказПокупателя = ПолучитьСсылкуНаСформированныйДокумент("ЗаказПокупателя");
		Если ЗаказПокупателя = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СчетНаОплату КАК СчетНаОплатуПокупателю
		|ГДЕ
		|	СчетНаОплатуПокупателю.ДокументОснование = &ЗаказПокупателя";
	
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			СчетНаОплатуПокупателю = Выборка.Ссылка;
			мСформированныеДокументы.Вставить("СчетНаОплатуПокупателю", СчетНаОплатуПокупателю);
		КонецЕсли;
	
	КонецЕсли;

	Возврат СчетНаОплатуПокупателю;
	
КонецФункции // ПолучитьСсылкуНаСчетНаОплату()

//! Формирует документ "Реализация товаров и услуг"
//
Процедура СформироватьРеализациюТоваровИУслуг(Отказ, Заголовок, СтруктураШапкиДокумента, СтруктураШапкиДокументаЗН, СтрокаДвижения, ФормироватьСчетФактуру = Истина)
	
	Если ЗаказПокупателя = Неопределено Тогда
		ЗаказПокупателя = ПолучитьСсылкуНаСформированныйДокумент("ЗаказПокупателя");
	КонецЕсли;
	
	Если ЗаказПокупателя = Неопределено Тогда
		// Заказ покупателя не создан, поэтому мы не сможем связать РТиУ с Заказ-нарядом
		Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке("Не найден документ ""Заказ покупателя"", создание ""Реализации товаров и услуг"" невозможно.", Отказ, Заголовок);
		Возврат;
	КонецЕсли;
	
	#Если Клиент Тогда
	Состояние("Формирование реализации товаров и услуг...");
	#КонецЕсли

	Документ = ПолучитьСсылкуНаРТиУ();
	
	// Проверим, что у нас сумма заказ-наряда отличается от нуля, иначе проводить документы не нужно
	Если СуммаПросрочки = 0 Тогда
		
		Если ЗначениеЗаполнено(Документ) Тогда
			Документ.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Документ = ?(ЗначениеЗаполнено(Документ), Документ.ПолучитьОбъект(), Документы.РеализацияТоваров.СоздатьДокумент());
	Если Документ.ПометкаУдаления Тогда
		Документ.УстановитьПометкуУдаления(Ложь);
	КонецЕсли;
	
	Документ.ОбработкаЗаполнения(ЗаказПокупателя);  
	Документ.Дата = ДатаВыдачиФакт;
	Документ.СкладКомпании = ЗаказПокупателя.СкладКомпании;
	Документ.ХозОперация = Справочники.ХозОперации.РеализацияТоваров;
	Документ.БлокироватьПерерасчетСкидок = Истина;
	Документ.ДатаСоздания = ТекущаяДата();
	
	Документ.Товары.Очистить();
	
	СтрокаУслуг = Документ.Товары.Добавить();
	СтрокаУслуг.Номенклатура = СтруктураШапкиДокументаЗН.Автоуслуга;
	Документ.ОбработкаРеквизита("Товары.Номенклатура", СтрокаУслуг);
	СтрокаУслуг.Цена = СтрокаДвижения.Сумма;
	СтрокаУслуг.Количество = 1;	
	Документ.ОбработкаРеквизита("Товары.Количество", СтрокаУслуг);
	            	
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Renault_Advanced_ОбщегоНазначения.ЗаписатьСвязиЗаказНаряда(ЭтотОбъект.Ссылка, Документ.Ссылка);
	Исключение
		Renault_Advanced_ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(), Отказ);
	КонецПопытки;
	
	Если НЕ ФормироватьСчетФактуру ИЛИ НЕ СтруктураШапкиДокументаЗН.ОтражатьВБухгалтерскомУчете ИЛИ Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СчетФактура = Renault_Advanced_УчетНДС.НайтиПодчиненныйДокумент(Документ.Ссылка, "СчетФактураВыданный");
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда
		
		Если НачалоДня(СчетФактура.Дата) = НачалоДня(Дата) Тогда
			Попытка
				СчетФактура.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Отказ = Истина;
			КонецПопытки;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	СформироватьСчетФактуру(Документ.Ссылка, Отказ);
	
КонецПроцедуры // СформироватьРеализациюТоваровИУслуг()

//! Формирует документ Счет-фактура выданный на основании Реализации товаров и услуг,
// созданной из заказ-наряда.
//
// Параметры:
//   Документ - ДокументОбъект.РеализацияТоваровУслуг - основание для формирование с/ф.
//   Отказ - флаг отказа в проведении.
//
// Возвращаемое значение:
//   ДокументОбъект.СчетФактураВыданный, если проведение документа прошло успешно, иначе -
//     Неопределено.
//
Функция СформироватьСчетФактуру(Документ, Отказ = Ложь)
	СчетФактура = Документы.СчетФактураВыданный.СоздатьДокумент();
	СчетФактура.Заполнить(Документ);
	СчетФактура.ДатаСоздания = ТекущаяДата();
	
	Попытка
		СчетФактура.Записать(РежимЗаписиДокумента.Проведение);
		Возврат СчетФактура;
	Исключение
		Отказ = Истина;
		Возврат Неопределено;
	КонецПопытки;	
КонецФункции // СформироватьСчетФактуру()


