		ОбластьМакета.Параметры.НомерСчетаКонтрагента = СведенияОКонтрагенте.НомерСчета;
		//ОбластьМакета.Параметры.ОГРНКонтрагента = Шапка.Контрагент.ОГРН;
	Иначе	
		ОбластьМакета = Макет.ПолучитьОбласть("Подписи_ФЛ");
		ОбластьМакета.Параметры.Покупатель_ФИО_Полностью = ВРег(СведенияОКонтрагенте.ПолноеНаименование);
		ОбластьМакета.Параметры.ФактическийАдресКонтрагента = СведенияОКонтрагенте.АдресФактический;
		ОбластьМакета.Параметры.пасп_сер   = СведенияОКонтрагенте.ДокументСерия;
		ОбластьМакета.Параметры.пасп_ном   = СведенияОКонтрагенте.ДокументНомер;
		ОбластьМакета.Параметры.КогдаВыдан = ?(ЗначениеЗаполнено(СведенияОКонтрагенте.ДокументДатаВыдачи), Формат(СведенияОКонтрагенте.ДокументДатаВыдачи, "ДЛФ=D"), "Нет даты года");
		ОбластьМакета.Параметры.КемВыдан   = СведенияОКонтрагенте.ДокументКемВыдан;
	КонецЕсли;
	ОбластьМакета.Параметры.ТелефоныКонтрагента = СведенияОКонтрагенте.Телефон;
	ОбластьМакета.Параметры.ЮридическийАдресКонтрагента = СведенияОКонтрагенте.АдресЮридический;
	
	ОбластьМакета.Параметры.ПолноеНаименованиеОрганизации = СведенияООрганизации.ПолноеНаименование;
	ОбластьМакета.Параметры.ИНН = СведенияООрганизации.ИНН;
	ОбластьМакета.Параметры.КПП = СведенияООрганизации.КПП;
	ОбластьМакета.Параметры.ЮридическийАдрес = СведенияООрганизации.АдресЮридический;
	ОбластьМакета.Параметры.НомерСчета = СведенияООрганизации.НомерСчета;
	ОбластьМакета.Параметры.Банк = СведенияООрганизации.Банк;
	ОбластьМакета.Параметры.КоррСчет = СведенияООрганизации.КоррСчет;
	ОбластьМакета.Параметры.БИК = СведенияООрганизации.БИК;
	ОбластьМакета.Параметры.КодПоОКПО = СведенияООрганизации.КодПоОКПО;
	ОбластьМакета.Параметры.Телефоны = СведенияООрганизации.Телефон;
	ОбластьМакета.Параметры.ОГРН = СведенияООрганизации.ОГРН;
	ОбластьМакета.Параметры.ФИОРуководителя = ВРег(Руководитель);
	ОбластьМакета.Параметры.КраткоеНаименованиеОрганизации = СведенияООрганизации.Наименование;

    ТабДок.Вывести(ОбластьМакета);

	Возврат ТабДок;
КонецФункции		 

//! Функция формирует табличный документ с печатной формой акта об
// обказании услуг
//
// Возвращаемое значение:
//  Табличный документ - печатная форма акта
//
Функция ПечатьАктаОбОказанииУслуг() Экспорт 
	
	ЭтоЮрЛицо = Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;

	ТабДокумент = Новый ТабличныйДокумент;
	
	//Найдем РТУ по З/н	
	обЗН = ЗаказНаряд.ПолучитьОбъект();
	СправочникДанных = Renault_AdvancedСервер.ПолучитьСправочникДанныхЗаказНаряда(ЗаказНаряд);
	СправочникДанныхОбъект = СправочникДанных.ПолучитьОбъект(); 

	РТУ = СправочникДанныхОбъект.ПолучитьСсылкуНаРТиУ();
	
	Если НЕ ЗначениеЗаполнено(РТУ) Тогда
		Если СправочникДанныхОбъект.Работы.Количество() < 2 ИЛИ 
			(СправочникДанныхОбъект.Работы.Количество() = 1 И СправочникДанныхОбъект.СтатусЗаказНаряда <> Справочники.Renault_Advanced_СтатусыЗаказНарядов.Закрыт) Тогда
			Сообщить("Заказ наряд не закрыт!");
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	СчетНаОплату = СправочникДанныхОбъект.ПолучитьСсылкуНаСчетНаОплату();
	
	ЗапросШапка = Новый Запрос;
	ЗапросШапка.УстановитьПараметр("ТекущийДокумент", РТУ);
	ЗапросШапка.УстановитьПараметр("УчитыватьНДС", СправочникДанныхОбъект.УчитыватьНДС);
	ЗапросШапка.УстановитьПараметр("СуммаВключаетНДС", СправочникДанныхОбъект.СуммаВключаетНДС);

	ЗапросШапка.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваров.Номер,
	|	РеализацияТоваров.Дата,
	|	РеализацияТоваров.ДоговорВзаиморасчетов КАК ДоговорКонтрагента,
	|	РеализацияТоваров.Контрагент КАК Получатель,
	|	РеализацияТоваров.Организация КАК Поставщик,
	|	РеализацияТоваров.Организация КАК Организация,
	|	РеализацияТоваров.СуммаДокумента,
	|	РеализацияТоваров.ВалютаДокумента,
	|	РеализацияТоваров.КурсВалютыВзаиморасчетов КАК Курс,
	|	1 КАК Кратность,
	|	&УчитыватьНДС КАК УчитыватьНДС,
	|	&СуммаВключаетНДС КАК СуммаВключаетНДС
	|ИЗ
	|	Документ.РеализацияТоваров КАК РеализацияТоваров
	|ГДЕ
	|	РеализацияТоваров.Ссылка = &ТекущийДокумент";
	
	Если (Не ЗначениеЗаполнено(РТУ) И СправочникДанныхОбъект.Работы.Количество()>1)
		ИЛИ (Не ЗначениеЗаполнено(РТУ) И СправочникДанныхОбъект.Работы.Количество()=1 И СправочникДанныхОбъект.СтатусЗаказНаряда <> Справочники.Renault_Advanced_СтатусыЗаказНарядов.Закрыт)Тогда
		ЗапросШапка.Текст = СтрЗаменить(ЗапросШапка.Текст,"Документ.РеализацияТоваров","Документ.ЗаказНаряд");  
		ЗапросШапка.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.ЗаказНаряд.Ссылка);
	КонецЕсли;
	
	Шапка = ЗапросШапка.Выполнить().Выбрать();
	Шапка.Следующий();

	Если ЗначениеЗаполнено(РТУ) И СправочникДанныхОбъект.Работы.Количество()=1 Тогда
		
		ЗапросУслуги = Новый Запрос;
		ЗапросУслуги.УстановитьПараметр("ТекущийДокумент", РТУ);
		ЗапросУслуги.УстановитьПараметр("Курс",            Шапка.Курс);
		ЗапросУслуги.УстановитьПараметр("Кратность",       Шапка.Кратность);
		ЗапросУслуги.Текст =
		"ВЫБРАТЬ
		|	РеализацияТоваровТовары.Номенклатура.Наименование КАК Номенклатура,
		|	РеализацияТоваровТовары.Номенклатура.Наименование КАК Товар,
		|	РеализацияТоваровТовары.Количество,
		|	РеализацияТоваровТовары.ЕдиницаИзмерения,
		|	РеализацияТоваровТовары.Цена * &Курс / &Кратность КАК Цена,
		|	РеализацияТоваровТовары.СуммаВсего * &Курс / &Кратность КАК Сумма,
		|	РеализацияТоваровТовары.СтавкаНДС,
		|	РеализацияТоваровТовары.СуммаНДС * &Курс / &Кратность КАК СуммаНДС,
		|	РеализацияТоваровТовары.ПроцентСкидки КАК Скидка,
		|	1 КАК Метка
		|ИЗ
		|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
		|ГДЕ
		|	РеализацияТоваровТовары.Ссылка = &ТекущийДокумент
		|
		|УПОРЯДОЧИТЬ ПО
		|	РеализацияТоваровТовары.НомерСтроки";

		ТаблицаУслуги = ЗапросУслуги.Выполнить().Выгрузить();
	
	Иначе 
		ЗапросУслуги = Новый Запрос;
		ЗапросУслуги.Текст = "ВЫБРАТЬ
		                     |	ЗаказНарядРаботы.Работа,
		                     |	ЗаказНарядРаботы.Количество,
		                     |	ЗаказНарядРаботы.Цена,
		                     |	ЗаказНарядРаботы.Сумма,
		                     |	ЗаказНарядРаботы.СтавкаНДС,
		                     |	ЗаказНарядРаботы.СуммаНДС,
		                     |	ЗаказНарядРаботы.ПроцентСкидкиНаценки КАК Скидка,
		                     |	ЗаказНарядРаботы.Ссылка.СуммаВключаетНДС
		                     |ИЗ
		                     |	Справочник.Renault_Advanced_ДанныеЗаказНаряда.Работы КАК ЗаказНарядРаботы
		                     |ГДЕ
		                     |	ЗаказНарядРаботы.Ссылка = &Ссылка";
		ЗапросУслуги.УстановитьПараметр("Ссылка", СправочникДанных);					 
		ТаблицаУслуги = ЗапросУслуги.Выполнить().Выгрузить();
		
    КонецЕсли;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Renault_Advanced_ДоговорХраненияКолес_АктБезПросрочки";
	Макет       = ПолучитьМакет("АктБезПросрочки");

	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	Если ЗначениеЗаполнено(РТУ) И СправочникДанных.Работы.Количество()=1 Тогда
		ДатаАкта = Шапка.Дата;
	Иначе
		ДатаАкта = ДатаВыдачиФакт;
	КонецЕсли;
	
	НомерЗаказНаряд = дкПолучитьНомерДляПечати(ЗаказНаряд);
	НомерСчет = дкПолучитьНомерДляПечати(СчетНаОплату);
	
	ОбластьМакета.Параметры.ТекстЗаголовка = "Акт от " + Формат(ДатаАкта, "ДФ=dd.MM.yyyy") + " года"
	+ ?(ЗначениеЗаполнено(СчетНаОплату), " (к счету № " + НомерСчет + " от "+Формат(СчетНаОплату.Дата, "ДФ=dd.MM.yyyy") + ")", "")
	+ Символы.ПС + "к заказ-наряду № " + НомерЗаказНаряд + " от " + Формат(ЗаказНаряд.Дата, "ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьМакета);

	Запрос	= Новый Запрос;
	Запрос.Текст = 		
	"ВЫБРАТЬ
	|	Организации.НаименованиеПолное,
	|	Организации.Ссылка КАК Организация,
	|	Организации.ИНН,
	|	Организации.КПП,
	|	Организации.ОГРН,
	|	Организации.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	Организации.ОсновнойБанковскийСчет.Банк.Наименование КАК БанкНаименование,
	|	Организации.ОсновнойБанковскийСчет.Банк.КоррСчет КАК КоррСчет,
	|	Организации.ОсновнойБанковскийСчет.Банк.Код КАК БИК,
	|	Организации.КодПоОКПО
	|ПОМЕСТИТЬ ОрганизацияИнформация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Организации
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Организации).Ссылка
	|	КОНЕЦ КАК Организация,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК Телефон,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК Адрес
	|ПОМЕСТИТЬ ОргКонт
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Организация
	|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонРабочий)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Организации
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Организации).Ссылка
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОрганизацияИнформация.НаименованиеПолное КАК ПолноеНаименование,
	|	ОрганизацияИнформация.ИНН КАК ИНН,
	|	ОрганизацияИнформация.КПП КАК КПП,
	|	ОрганизацияИнформация.ОГРН КАК ОГРН,
	|	ОрганизацияИнформация.НомерСчета КАК НомерСчета,
	|	ОрганизацияИнформация.БанкНаименование КАК Банк,
	|	ОрганизацияИнформация.КоррСчет КАК КоррСчет,
	|	ОрганизацияИнформация.БИК КАК БИК,
	|	ОргКонт.Телефон КАК Телефон,
	|	ОргКонт.Адрес КАК АдресЮридический,
	|	ОрганизацияИнформация.КодПоОКПО КАК КодПоОКПО
	|ИЗ
	|	ОрганизацияИнформация КАК ОрганизацияИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОргКонт КАК ОргКонт
	|		ПО ОрганизацияИнформация.Организация = ОргКонт.Организация";
	Запрос.УстановитьПараметр("Организация", Шапка.Поставщик);
	Результат = Запрос.Выполнить();
	СведенияООрганизации = Результат.Выбрать();		
	СведенияООрганизации.Следующий(); 
	
	Запрос	= Новый Запрос;
	Запрос.Текст = 		
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.ИНН,
	|	Контрагенты.КПП,
	|	Контрагенты.НаименованиеПолное,
	|	Контрагенты.КодПоОКПО,
	|	Контрагенты.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.Наименование КАК Банк,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.КоррСчет КАК КоррСчет,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.Код КАК БИК
	|ПОМЕСТИТЬ КонтрагентИнфа
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	|	КОНЕЦ КАК Контрагент,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК Телефон,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|					И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресФактический)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК АдресФактический,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|					И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК АдресЮридический
	|ПОМЕСТИТЬ КонтИнфа
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контрагент
	|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонКонтактный)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресФактический)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Серия,
	|	ПодтверждающиеДокументы.Номер,
	|	ПодтверждающиеДокументы.ДатаВыдачи,
	|	ПодтверждающиеДокументы.КемВыдан,
	|	ПодтверждающиеДокументы.Владелец КАК Контрагент
	|ПОМЕСТИТЬ ДокументКонтрагента
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Контрагент
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтрагентИнфа.ИНН,
	|	КонтрагентИнфа.КПП,
	|	КонтрагентИнфа.НаименованиеПолное КАК ПолноеНаименование,
	|	КонтИнфа.Телефон,
	|	КонтИнфа.АдресФактический КАК АдресФактический,
	|	КонтИнфа.АдресЮридический КАК АдресЮридический,
	|	ДокументКонтрагента.Серия КАК ДокументСерия,
	|	ДокументКонтрагента.Номер КАК ДокументНомер,
	|	ДокументКонтрагента.ДатаВыдачи КАК ДокументДатаВыдачи,
	|	ДокументКонтрагента.КемВыдан КАК ДокументКемВыдан,
	|	КонтрагентИнфа.КодПоОКПО,
	|	КонтрагентИнфа.НомерСчета,
	|	КонтрагентИнфа.Банк,
	|	КонтрагентИнфа.КоррСчет,
	|	КонтрагентИнфа.БИК
	|ИЗ
	|	КонтрагентИнфа КАК КонтрагентИнфа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДокументКонтрагента КАК ДокументКонтрагента
	|		ПО КонтрагентИнфа.Контрагент = ДокументКонтрагента.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ КонтИнфа КАК КонтИнфа
	|		ПО КонтрагентИнфа.Контрагент = КонтИнфа.Контрагент";
	                                                      
	Запрос.УстановитьПараметр("Контрагент", Шапка.Получатель);
	Результат =  Запрос.Выполнить();
	СведенияОКонтрагенте = Результат.Выбрать();
	СведенияОКонтрагенте.Следующий();

	
	ОбластьМакета = Макет.ПолучитьОбласть("Поставщик");
	ПредставлениеПоставщика = СведенияООрганизации.ПолноеНаименование + 
								" ИНН " + СведенияООрганизации.ИНН + 
								" КПП " + СведенияООрганизации.КПП + 
								" Адрес: " + СведенияООрганизации.АдресЮридический;
								
	ОбластьМакета.Параметры.ПредставлениеПоставщика = ПредставлениеПоставщика;
	ОбластьМакета.Параметры.Поставщик = Шапка.Поставщик;
	ТабДокумент.Вывести(ОбластьМакета);
	
	ПредставлениеПолучателя = СведенияОКонтрагенте.ПолноеНаименование + 
								?(ЭтоЮрЛицо, " ИНН " + СведенияОКонтрагенте.ИНН + 
								" КПП " + СведенияОКонтрагенте.КПП, "") + 
								" Адрес: " + СведенияОКонтрагенте.АдресФактический;

	ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
	ОбластьМакета.Параметры.ПредставлениеПолучателя = ПредставлениеПолучателя;
	ОбластьМакета.Параметры.Получатель = Шапка.Получатель;                                                                                                                       
	ТабДокумент.Вывести(ОбластьМакета);
	
	ПараметрыПечати = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	"+СформироватьСтрокуПоляЗапроса("МаркаМодель")+" КАК МаркаМодель,
	|	ДоговорХраненияКолес.ЗаказНаряд.Автомобиль.VIN КАК VIN
	|ИЗ
	|	Документ.Renault_Advanced_ДоговорХраненияКолес КАК ДоговорХраненияКолес
	|ГДЕ
	|	ДоговорХраненияКолес.Ссылка = &ТекущийДокумент";
	Автомобиль = Запрос.Выполнить().Выбрать();
	Автомобиль.Следующий();
	ПараметрыПечати.Вставить("МаркаМодель", Автомобиль.МаркаМодель);
	ПараметрыПечати.Вставить("VIN", Автомобиль.VIN);
   	ПараметрыПечати.Вставить("ГосНомер", Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЗаказНаряд.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер));
      
	ОбластьМакета = Макет.ПолучитьОбласть("Автомобиль");
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьМакета);

	ЕстьСкидки   = ТаблицаУслуги.Итог("Скидка") <> 0;
	ВалютаПечати = Шапка.ВалютаДокумента;

	// Вывести табличную часть
	Если ЕстьСкидки  Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицыСоСкидкой");
		ОбластьСтроки = Макет.ПолучитьОбласть("СтрокаСоСкидкой");
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	КонецЕсли;

	ТабДокумент.Вывести(ОбластьМакета);
	НомерСтроки = 0;

	Для Каждого СтрокаТабличнойЧасти Из ТаблицаУслуги Цикл	

		НомерСтроки = НомерСтроки + 1;

		ОбластьСтроки.Параметры.Заполнить(СтрокаТабличнойЧасти);
		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		Если СрокХраненияПросрочка > 0 И СуммаПросрочки > 0 И СправочникДанных.Работы.Количество() = 2 Тогда
			Если СтрокаТабличнойЧасти.Работа = Справочники.Автоработы.НайтиПоНаименованию("Хранение колес просроченное", Истина) Тогда
			ОбластьСтроки.Параметры.Товар            = "Сезонное хранение 1месяц, 1комплект " + Размер.ПосадочныйДиаметр + " (просроченное хранение)";
			ОбластьСтроки.Параметры.Количество       = СрокХраненияПросрочка;
			Иначе
			ОбластьСтроки.Параметры.Товар            = "Сезонное хранение 1месяц, 1комплект " + Размер.ПосадочныйДиаметр;
			ОбластьСтроки.Параметры.Количество       = СрокХранения;
			КонецЕсли;
		Иначе
			ОбластьСтроки.Параметры.Товар            = "Сезонное хранение 1месяц, 1комплект " + Размер.ПосадочныйДиаметр;
			ОбластьСтроки.Параметры.Количество       = СрокХранения;
		КонецЕсли;
		
		ОбластьСтроки.Параметры.ЕдиницаИзмерения = "мес"; 
        ОбластьСтроки.Параметры.Цена             = Цена;
		
		Если ЕстьСкидки Тогда
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Скидка) И СтрокаТабличнойЧасти.Скидка <> 100 Тогда
				Скидка = СтрокаТабличнойЧасти.Сумма / (100 - СтрокаТабличнойЧасти.Скидка) * СтрокаТабличнойЧасти.Скидка;
			Иначе
				Скидка = 0;
			КонецЕсли;			
			
			ОбластьСтроки.Параметры.Скидка         = Скидка;
			ОбластьСтроки.Параметры.СуммаБезСкидки = Renault_Advanced_ОбщегоНазначения.ФорматСумм(СтрокаТабличнойЧасти.Сумма + Скидка);
		КонецЕсли;

		ТабДокумент.Вывести(ОбластьСтроки);

	КонецЦикла;

	Если ТаблицаУслуги <> Неопределено Тогда

		тСумма    = ТаблицаУслуги.Итог("Сумма");
		СуммаНДС = ТаблицаУслуги.Итог("СуммаНДС");

	Иначе

		тСумма    = 0;
		СуммаНДС = 0;

	КонецЕсли;

	ОбластьМакета = Макет.ПолучитьОбласть("Итого");
	ОбластьМакета.Параметры.Всего = Renault_Advanced_ОбщегоНазначения.ФорматСумм(тСумма);
	ТабДокумент.Вывести(ОбластьМакета);

	Если Шапка.УчитыватьНДС Тогда

		ОбластьМакета = Макет.ПолучитьОбласть("ИтогоНДС");
		ОбластьМакета.Параметры.ВсегоНДС = Renault_Advanced_ОбщегоНазначения.ФорматСумм(СуммаНДС);
		ОбластьМакета.Параметры.НДС      = ?(Шапка.СуммаВключаетНДС, "В том числе НДС", " Сумма НДС");
		ТабДокумент.Вывести(ОбластьМакета);

	КонецЕсли;

	СуммаКПрописи = тСумма + ?(Шапка.СуммаВключаетНДС, 0, СуммаНДС);
	ОбластьМакета = Макет.ПолучитьОбласть("СуммаПрописью");
	ОбластьМакета.Параметры.ИтоговаяСтрока ="Всего оказано услуг " + НомерСтроки + ", на сумму " + Renault_Advanced_ОбщегоНазначения.ФорматСумм(СуммаКПрописи, ВалютаПечати);
	ОбластьМакета.Параметры.СуммаПрописью  = Renault_Advanced_ОбщегоНазначения.СформироватьСуммуПрописью(СуммаКПрописи, ВалютаПечати);
	ТабДокумент.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("Подписи");
	ТабДокумент.Вывести(ОбластьМакета);

	Возврат ТабДокумент;

КонецФункции // ПечатьАктаОбОказанииУслуг()

//! Функция формирует табличный документ с печатной формой заказа или счета
//
// Возвращаемое значение:
//  Табличный документ - сформированная печатная форма
//
Функция ПечатьСчета(Тип) 	
	Документ = Неопределено;
	
	СправочникДанных = Renault_AdvancedСервер.ПолучитьСправочникДанныхЗаказНаряда(ЗаказНаряд);
	СправочникДанныхОбъект = СправочникДанных.ПолучитьОбъект(); 

	Если Тип = "СчетЗаказ" Тогда
		Документ = СправочникДанныхОбъект.ПолучитьСсылкуНаСчетНаОплату();
	ИначеЕсли Тип = "СчетЗаказДоплата" Тогда
		Если СправочникДанныхОбъект.СтатусЗаказНаряда = Справочники.Renault_Advanced_СтатусыЗаказНарядов.Закрыт
			И СправочникДанныхОбъект.Работы.Количество() = 1 Тогда
			Документ = ПолучитьСсылкуНаЗаказПокупателя();
		ИначеЕсли СправочникДанныхОбъект.Работы.Количество() > 1 Тогда
			Документ = ЭтотОбъект.ЗаказНаряд.Ссылка;
		КонецЕсли; 		
	КонецЕсли;
	
	Если Документ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СоздатьТабличныйДокументПечатиСчетаЗаказа(Тип, ПолучитьПараметрыПечатиСчетаЗаказа(Тип, Документ));
КонецФункции

//!
Функция СоздатьТабличныйДокументПечатиСчетаЗаказа(Тип, ПараметрыПечати)
		
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Renault_Advanced_ДоговорХраненияКолес_СчетЗаказ";

	Макет = ПолучитьМакет("СчетЗаказ");

	// Выводим шапку накладной
	
	СправочникДанных = Renault_AdvancedСервер.ПолучитьСправочникДанныхЗаказНаряда(ЗаказНаряд);
	СправочникДанныхОбъект = СправочникДанных.ПолучитьОбъект(); 

	ОбластьМакета       = Макет.ПолучитьОбласть("ЗаголовокСчета");
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	ОбластьМакета.Параметры.КДоговоруХранения = Renault_Advanced_ОбщегоНазначения.СформироватьЗаголовокДокумента(ЭтотОбъект, "К договору хранения");
	ОбластьМакета.Параметры.ТекстЗаголовка =  Renault_Advanced_ОбщегоНазначения.СформироватьЗаголовокДокумента(ЭтотОбъект.ЗаказНаряд, "Счет на оплату");

	ТабДокумент.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("Поставщик");
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("Покупатель");
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Данные по а/м
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка_АМ");
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьНомера = Макет.ПолучитьОбласть("ШапкаТаблицы|НомерСтроки");
	ОбластьКодов  = Макет.ПолучитьОбласть("ШапкаТаблицы|КолонкаКодов");
	ОбластьДанных = Макет.ПолучитьОбласть("ШапкаТаблицы|Данные");
	ОбластьСкидок = Макет.ПолучитьОбласть("ШапкаТаблицы|Скидка");
	ОбластьСуммы  = Макет.ПолучитьОбласть("ШапкаТаблицы|Сумма");

	ОбластьТовар = Макет.ПолучитьОбласть("ШапкаТаблицы|Товар");
	Если Не ПараметрыПечати.ВыводитьКоды И ПараметрыПечати.ЕстьСкидки Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("ШапкаТаблицы|ТоварБезКодов");
	ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И ПараметрыПечати.ВыводитьКоды Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("ШапкаТаблицы|ТоварБезСкидок");
	ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И НЕ ПараметрыПечати.ВыводитьКоды Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("ШапкаТаблицы|ТоварБезКодовИСкидок");
	КонецЕсли;

	ТабДокумент.Вывести(ОбластьНомера);
	Если ПараметрыПечати.ВыводитьКоды Тогда
		ОбластьКодов.Параметры.ИмяКолонкиКодов = ПараметрыПечати.ИмяКолонкиКодов;
		ТабДокумент.Присоединить(ОбластьКодов);
	КонецЕсли;
	ОбластьТовар.Параметры.Товар = "Товары (работы, услуги)";
	ТабДокумент.Присоединить(ОбластьТовар);
	ТабДокумент.Присоединить(ОбластьДанных);
	Если ПараметрыПечати.ЕстьСкидки Тогда
		ТабДокумент.Присоединить(ОбластьСкидок);
	КонецЕсли;
	ТабДокумент.Присоединить(ОбластьСуммы);

	ОбластьНомера = Макет.ПолучитьОбласть("Строка|НомерСтроки");
	ОбластьКодов  = Макет.ПолучитьОбласть("Строка|КолонкаКодов");
	ОбластьДанных = Макет.ПолучитьОбласть("Строка|Данные");
	ОбластьСкидок = Макет.ПолучитьОбласть("Строка|Скидка");
	ОбластьСуммы  = Макет.ПолучитьОбласть("Строка|Сумма");

	ОбластьТовар = Макет.ПолучитьОбласть("Строка|Товар");
	Если Не ПараметрыПечати.ВыводитьКоды И ПараметрыПечати.ЕстьСкидки Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("Строка|ТоварБезКодов");
	ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И ПараметрыПечати.ВыводитьКоды Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("Строка|ТоварБезСкидок");
	ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И НЕ ПараметрыПечати.ВыводитьКоды Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("Строка|ТоварБезКодовИСкидок");
	КонецЕсли;

	Для каждого ПараметрыПозиции Из ПараметрыПечати.Позиции Цикл 

		Если не ЗначениеЗаполнено(ПараметрыПозиции.Номенклатура) Тогда
			Сообщить("В одной из строк не заполнено значение номенклатуры - строка при печати пропущена.", СтатусСообщения.Важное);
			Продолжить;
		КонецЕсли;

		ОбластьНомера.Параметры.Заполнить(ПараметрыПозиции);
		ТабДокумент.Вывести(ОбластьНомера);

		Если ПараметрыПечати.ВыводитьКоды Тогда
			ОбластьКодов.Параметры.Заполнить(ПараметрыПозиции);
			ТабДокумент.Присоединить(ОбластьКодов);
		КонецЕсли;

		ОбластьТовар.Параметры.Заполнить(ПараметрыПозиции);
		Если Тип = "СчетЗаказДоплата" и ПараметрыПечати.СрокХраненияПросрочка<>0 и СправочникДанныхОбъект.Работы.Количество()>1 Тогда
			ОбластьТовар.Параметры.Товар = "Сезонное хранение (просроченное) 1месяц, 1комплект " + ПараметрыПечати.Радиус;	
		Иначе			
			ОбластьТовар.Параметры.Товар = "Сезонное хранение 1месяц, 1комплект " + ПараметрыПечати.Радиус;
		КонецЕсли;
		ТабДокумент.Присоединить(ОбластьТовар);
		ОбластьДанных.Параметры.Заполнить(ПараметрыПозиции);

		ОбластьДанных.Параметры.Количество = ?(Тип = "СчетЗаказДоплата", ПараметрыПечати.СрокХраненияПросрочка, ПараметрыПечати.СрокХранения);
		
		Если Тип = "СчетЗаказДоплата" и ПараметрыПечати.СрокХраненияПросрочка<>0 и СправочникДанныхОбъект.Работы.Количество()>1 Тогда
				ОбластьДанных.Параметры.Цена = ПараметрыПозиции.Цена;
		Иначе
				ОбластьДанных.Параметры.Цена = ?(Тип = "СчетЗаказДоплата" и ПараметрыПечати.СрокХраненияПросрочка<>0, ПараметрыПозиции.Цена/ПараметрыПечати.СрокХраненияПросрочка, ПараметрыПечати.ЦенаХранения);
		Конецесли;		
		ТабДокумент.Присоединить(ОбластьДанных);

		Если ПараметрыПечати.ЕстьСкидки Тогда
			ОбластьСкидок.Параметры.Заполнить(ПараметрыПозиции);
			ТабДокумент.Присоединить(ОбластьСкидок);
		КонецЕсли;

		ОбластьСуммы.Параметры.Заполнить(ПараметрыПозиции);
		ТабДокумент.Присоединить(ОбластьСуммы);
		
	КонецЦикла;

	// Вывести Итого
	ОбластьНомера = Макет.ПолучитьОбласть("Итого|НомерСтроки");
	ОбластьКодов  = Макет.ПолучитьОбласть("Итого|КолонкаКодов");
	ОбластьДанных = Макет.ПолучитьОбласть("Итого|Данные");
	ОбластьСкидок = Макет.ПолучитьОбласть("Итого|Скидка");
	ОбластьСуммы  = Макет.ПолучитьОбласть("Итого|Сумма");

	ОбластьТовар = Макет.ПолучитьОбласть("Итого|Товар");
	Если Не ПараметрыПечати.ВыводитьКоды И ПараметрыПечати.ЕстьСкидки Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("Итого|ТоварБезКодов");
	ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И ПараметрыПечати.ВыводитьКоды Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("Итого|ТоварБезСкидок");
	ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И НЕ ПараметрыПечати.ВыводитьКоды Тогда
		ОбластьТовар = Макет.ПолучитьОбласть("Итого|ТоварБезКодовИСкидок");
	КонецЕсли;

	ТабДокумент.Вывести(ОбластьНомера);
	Если ПараметрыПечати.ВыводитьКоды Тогда
		ТабДокумент.Присоединить(ОбластьКодов);
	КонецЕсли;
	ТабДокумент.Присоединить(ОбластьТовар);
	ТабДокумент.Присоединить(ОбластьДанных);
	Если ПараметрыПечати.ЕстьСкидки Тогда
		ОбластьСкидок.Параметры.Заполнить(ПараметрыПечати);
		ТабДокумент.Присоединить(ОбластьСкидок);
	КонецЕсли;
	ОбластьСуммы.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Присоединить(ОбластьСуммы);

	// Вывести ИтогоНДС
	Если ПараметрыПечати.УчитыватьНДС Тогда
		ОбластьНомера = Макет.ПолучитьОбласть("ИтогоНДС|НомерСтроки");
		ОбластьКодов  = Макет.ПолучитьОбласть("ИтогоНДС|КолонкаКодов");
		ОбластьДанных = Макет.ПолучитьОбласть("ИтогоНДС|Данные");
		ОбластьСкидок = Макет.ПолучитьОбласть("ИтогоНДС|Скидка");
		ОбластьСуммы  = Макет.ПолучитьОбласть("ИтогоНДС|Сумма");

		ОбластьТовар = Макет.ПолучитьОбласть("ИтогоНДС|Товар");
		Если Не ПараметрыПечати.ВыводитьКоды И ПараметрыПечати.ЕстьСкидки Тогда
			ОбластьТовар = Макет.ПолучитьОбласть("ИтогоНДС|ТоварБезКодов");
		ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И ПараметрыПечати.ВыводитьКоды Тогда
			ОбластьТовар = Макет.ПолучитьОбласть("ИтогоНДС|ТоварБезСкидок");
		ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И НЕ ПараметрыПечати.ВыводитьКоды Тогда
			ОбластьТовар = Макет.ПолучитьОбласть("ИтогоНДС|ТоварБезКодовИСкидок");
		КонецЕсли;

		ТабДокумент.Вывести(ОбластьНомера);
		Если ПараметрыПечати.ВыводитьКоды Тогда
			ТабДокумент.Присоединить(ОбластьКодов);
		КонецЕсли;
		ОбластьТовар.Параметры.Заполнить(ПараметрыПечати);
		ТабДокумент.Присоединить(ОбластьТовар);
		ОбластьДанных.Параметры.Заполнить(ПараметрыПечати);
		ТабДокумент.Присоединить(ОбластьДанных);
		Если ПараметрыПечати.ЕстьСкидки Тогда
			ТабДокумент.Присоединить(ОбластьСкидок);
		КонецЕсли;
		ОбластьСуммы.Параметры.Заполнить(ПараметрыПечати);
		ТабДокумент.Присоединить(ОбластьСуммы);
		
		ОбластьНомера = Макет.ПолучитьОбласть("ВсегоКОплате|НомерСтроки");
		ОбластьКодов  = Макет.ПолучитьОбласть("ВсегоКОплате|КолонкаКодов");
		ОбластьДанных = Макет.ПолучитьОбласть("ВсегоКОплате|Данные");
		ОбластьСкидок = Макет.ПолучитьОбласть("ВсегоКОплате|Скидка");
		ОбластьСуммы  = Макет.ПолучитьОбласть("ВсегоКОплате|Сумма");

		ОбластьТовар = Макет.ПолучитьОбласть("ВсегоКОплате|Товар");
		Если Не ПараметрыПечати.ВыводитьКоды И ПараметрыПечати.ЕстьСкидки Тогда
			ОбластьТовар = Макет.ПолучитьОбласть("ВсегоКОплате|ТоварБезКодов");
		ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И ПараметрыПечати.ВыводитьКоды Тогда
			ОбластьТовар = Макет.ПолучитьОбласть("ВсегоКОплате|ТоварБезСкидок");
		ИначеЕсли НЕ ПараметрыПечати.ЕстьСкидки И НЕ ПараметрыПечати.ВыводитьКоды Тогда
			ОбластьТовар = Макет.ПолучитьОбласть("ВсегоКОплате|ТоварБезКодовИСкидок");
		КонецЕсли;

		ТабДокумент.Вывести(ОбластьНомера);
		Если ПараметрыПечати.ВыводитьКоды Тогда
			ТабДокумент.Присоединить(ОбластьКодов);
		КонецЕсли;
		ОбластьТовар.Параметры.Заполнить(ПараметрыПечати);
		ТабДокумент.Присоединить(ОбластьТовар);
		ОбластьДанных.Параметры.Заполнить(ПараметрыПечати);
		ТабДокумент.Присоединить(ОбластьДанных);
		Если ПараметрыПечати.ЕстьСкидки Тогда
			ТабДокумент.Присоединить(ОбластьСкидок);
		КонецЕсли;
		ОбластьСуммы.Параметры.Заполнить(ПараметрыПечати);
		ТабДокумент.Присоединить(ОбластьСуммы);
		
	КонецЕсли;

	// Вывести Сумму прописью
	ОбластьМакета = Макет.ПолучитьОбласть("СуммаПрописью");
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	ТабДокумент.Вывести(ОбластьМакета);

	ОбластьМакета = Макет.ПолучитьОбласть("ПодвалСчета");
	
	ОбластьМакета.Параметры.Заполнить(ПараметрыПечати);
	
	ТабДокумент.Вывести(ОбластьМакета);

	Возврат ТабДокумент;

КонецФункции // СоздатьТабличныйДокументПечатиСчетаЗаказа()

//! Функция помещает в структуру все данные, отображаемые при печати документа.
// Вызывается из функции ПечатьСчетаЗаказа и из веб-приложения
//
// Параметры:
//  Тип - строка, содержит тип печатаемого документа (счет или заказ)
//
// Возвращаемое значение:
//  Структура
//
Функция ПолучитьПараметрыПечатиСчетаЗаказа(Тип, СчетЗаказ) Экспорт
	СправочникДанных = Renault_AdvancedСервер.ПолучитьСправочникДанныхЗаказНаряда(ЗаказНаряд); 
	СправочникДанныхОбъект = СправочникДанных.ПолучитьОбъект();
	
	ПараметрыПечати = Новый Структура;
	Позиции = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", СчетЗаказ);
	Запрос.УстановитьПараметр("Организация", СчетЗаказ.Организация);
	Запрос.УстановитьПараметр("Контрагент", СчетЗаказ.Контрагент);
	//Запрос.УстановитьПараметр("ПустойКонтрагент", Справочники.Контрагенты.ПустаяСсылка());
	Запрос.УстановитьПараметр("УчитыватьНДС", СправочникДанных.УчитыватьНДС);
	Запрос.УстановитьПараметр("СуммаВключаетНДС", СправочникДанных.СуммаВключаетНДС);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Организации
	               |			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Организации).Ссылка
	               |	КОНЕЦ КАК Организация,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	               |				ТОГДА КонтактнаяИнформация.Представление
	               |			ИНАЧЕ """"""""
	               |		КОНЕЦ) КАК Телефон,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	               |				ТОГДА КонтактнаяИнформация.Представление
	               |			ИНАЧЕ """"""""
	               |		КОНЕЦ) КАК Адрес
	               |ПОМЕСТИТЬ ОргКонт
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Объект = &Организация
	               |	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	               |				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонРабочий)
	               |			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	               |				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Организации
	               |			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Организации).Ссылка
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	               |			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	               |	КОНЕЦ КАК Контрагент,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	               |				ТОГДА КонтактнаяИнформация.Представление
	               |			ИНАЧЕ """"""""
	               |		КОНЕЦ) КАК Телефон,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	               |				ТОГДА КонтактнаяИнформация.Представление
	               |			ИНАЧЕ """"""""
	               |		КОНЕЦ) КАК Адрес
	               |ПОМЕСТИТЬ КонтрагентКонт
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Объект = &Контрагент
	               |	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	               |				И КонтактнаяИнформация.ЗначениеПоУмолчанию
	               |			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	               |				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресФактический))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	               |			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СчетНаОплату.Номер,
	               |	СчетНаОплату.Дата,
	               |	СчетНаОплату.ДоговорВзаиморасчетов,
	               |	СчетНаОплату.Организация,
	               |	СчетНаОплату.Контрагент КАК Получатель,
	               |	СчетНаОплату.Организация КАК Грузоотправитель,
	               |	СчетНаОплату.Контрагент КАК Грузополучатель,
	               |	СчетНаОплату.Организация КАК Руководители,
	               |	СчетНаОплату.Организация КАК Поставщик,
	               |	СчетНаОплату.СуммаДокумента,
	               |	СчетНаОплату.ВалютаДокумента,
	               |	&УчитыватьНДС КАК УчитыватьНДС,
	               |	&СуммаВключаетНДС КАК СуммаВключаетНДС,
	               |	ЕСТЬNULL(ОргКонт.Адрес, """") КАК АдресОрганизация,
	               |	ЕСТЬNULL(ОргКонт.Телефон, """") КАК ТелефонОрганизация,
	               |	ЕСТЬNULL(КонтрагентКонт.Телефон, """") КАК ТелефонКонтрагент,
	               |	ЕСТЬNULL(КонтрагентКонт.Адрес, """") КАК АдресКонтрагент
	               |ИЗ
	               |	Документ.СчетНаОплату КАК СчетНаОплату
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ОргКонт КАК ОргКонт
	               |		ПО СчетНаОплату.Организация = ОргКонт.Организация
	               |		ЛЕВОЕ СОЕДИНЕНИЕ КонтрагентКонт КАК КонтрагентКонт
	               |		ПО СчетНаОплату.Контрагент = КонтрагентКонт.Контрагент
	               |ГДЕ
	               |	СчетНаОплату.Ссылка = &ТекущийДокумент";
	Если ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") 	Тогда
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетНаОплату", "Документ.ЗаказПокупателя");
	ИначеЕсли ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетНаОплату", "Документ.ЗаказНаряд");
	    Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагент КАК Грузополучатель","Организация КАК Грузополучатель");
	КонецЕсли;
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();

	Если ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") 
		ИЛИ ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		
		//СтрокаВыборкиПоляСодержания = Renault_Advanced_ОбработкаТабличныхЧастей.ПолучитьЧастьЗапросаДляВыбораСодержания("СчетНаОплату");
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекущийДокумент", СчетЗаказ);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВложенныйЗапрос.Номенклатура,
		               |	ВЫРАЗИТЬ(ВложенныйЗапрос.Номенклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК НаименованиеПолное,
		               |	ВложенныйЗапрос.Номенклатура.Код КАК Код,
		               |	ВложенныйЗапрос.Номенклатура.Артикул КАК Артикул,
		               |	ВложенныйЗапрос.Количество,
		               |	ВложенныйЗапрос.ЕдиницаИзмерения.Представление КАК ЕдиницаИзмерения,
		               |	ВложенныйЗапрос.ПроцентСкидкиНаценки КАК Скидка,
		               |	ВложенныйЗапрос.Цена,
		               |	ВложенныйЗапрос.СуммаНДС,
		               |	ВложенныйЗапрос.Характеристика,
		               |	ВложенныйЗапрос.НомерСтроки КАК НомерСтроки,
		               |	ВложенныйЗапрос.Метка КАК Метка,
		               |	ВложенныйЗапрос.Сумма
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		СчетНаОплату.Номенклатура КАК Номенклатура,
		               |		СчетНаОплату.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |		СчетНаОплату.ПроцентСкидкиСтроки КАК ПроцентСкидкиНаценки,
		               |		СчетНаОплату.Цена КАК Цена,
		               |		СУММА(СчетНаОплату.Количество) КАК Количество,
		               |		СУММА(СчетНаОплату.СуммаНДС) КАК СуммаНДС,
		               |		СчетНаОплату.ХарактеристикаНоменклатуры КАК Характеристика,
		               |		МИНИМУМ(СчетНаОплату.НомерСтроки) КАК НомерСтроки,
		               |		0 КАК Метка,
		               |		СчетНаОплату.СуммаВсего КАК Сумма
		               |	ИЗ
		               |		Документ.СчетНаОплату.Товары КАК СчетНаОплату
		               |	ГДЕ
		               |		СчетНаОплату.Ссылка = &ТекущийДокумент
		               |	
		               |	СГРУППИРОВАТЬ ПО
		               |		СчетНаОплату.Номенклатура,
		               |		СчетНаОплату.ЕдиницаИзмерения,
		               |		СчетНаОплату.ПроцентСкидкиСтроки,
		               |		СчетНаОплату.Цена,
		               |		СчетНаОплату.ХарактеристикаНоменклатуры,
		               |		СчетНаОплату.СуммаВсего) КАК ВложенныйЗапрос
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Метка,
		               |	НомерСтроки";
	
		Если ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СчетНаОплатуПокупателю", "Документ.ЗаказПокупателя");
		КонецЕсли;
	ИначеЕсли ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
	    Запрос.Текст =  "ВЫБРАТЬ
	                    |	ДанныеЗаказНаряда.Работа КАК Номенклатура,
	                    |	ДанныеЗаказНаряда.Количество,
	                    |	ДанныеЗаказНаряда.Цена,
	                    |	ДанныеЗаказНаряда.СтавкаНДС,
	                    |	ДанныеЗаказНаряда.СуммаНДС,
	                    |	ДанныеЗаказНаряда.ПроцентСкидкиНаценки + ДанныеЗаказНаряда.ПроцентАвтоматическихСкидок КАК Скидка,
	                    |	ВЫРАЗИТЬ(ДанныеЗаказНаряда.Работа.НаименованиеПолное КАК СТРОКА(1000)) КАК НаименованиеПолное,
	                    |	ДанныеЗаказНаряда.Работа.Код КАК Код,
	                    |	ДанныеЗаказНаряда.Работа.Артикул КАК Артикул,
	                    |	ДанныеЗаказНаряда.Сумма
	                    |ИЗ
	                    |	Справочник.Renault_Advanced_ДанныеЗаказНаряда.Работы КАК ДанныеЗаказНаряда
	                    |ГДЕ
	                    |	ДанныеЗаказНаряда.Ссылка = &Ссылка
	                    |	И ДанныеЗаказНаряда.НомерСтроки = &НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", СправочникДанных);
	Запрос.УстановитьПараметр("НомерСтроки", 2);
	
КонецЕсли;

	ЗапросТовары = Запрос.Выполнить().Выгрузить();

	// Выводим шапку накладной

	ПараметрыПечати.Вставить("УчитыватьНДС", Шапка.УчитыватьНДС);
	//Если Тип = "Счет" Тогда
		ПараметрыПечати.Вставить("ИНН", Шапка.Организация.ИНН);
		ПараметрыПечати.Вставить("КПП", Шапка.Организация.КПП);
		ПредставлениеПоставщикаДляПлатПоручения = "";
		Если ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") 
			ИЛИ ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.СчетНаОплату")Тогда 
			СтруктурнаяЕдиница = СчетЗаказ.Организация.ОсновнойБанковскийСчет;
		ИначеЕсли ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			СтруктурнаяЕдиница = ?(ЗначениеЗаполнено(ЭтотОбъект.ЗаказНаряд.БанковскийСчетОрганизации),ЭтотОбъект.ЗаказНаряд.БанковскийСчетОрганизации, ЭтотОбъект.ЗаказНаряд.Организация.ОсновнойБанковскийСчет);
		КонецЕсли;
		
		Если ТипЗнч(СтруктурнаяЕдиница) = Тип("СправочникСсылка.БанковскиеСчета") Тогда
			Банк       = СтруктурнаяЕдиница.Банк;
			БИК        = Банк.Код;
			КоррСчет   = Банк.КоррСчет;
			ГородБанка = Банк.Город;
			НомерСчета = СтруктурнаяЕдиница.НомерСчета;

			ПараметрыПечати.Вставить("БИКБанкаПолучателя", БИК);
			ПараметрыПечати.Вставить("БанкПолучателя", Банк);
			ПараметрыПечати.Вставить("БанкПолучателяПредставление", СокрЛП(Банк) + " " + ГородБанка);
			ПараметрыПечати.Вставить("СчетБанкаПолучателя", КоррСчет);
			ПараметрыПечати.Вставить("СчетБанкаПолучателяПредставление", КоррСчет);
			ПараметрыПечати.Вставить("СчетПолучателяПредставление", НомерСчета);
			ПараметрыПечати.Вставить("СчетПолучателя", НомерСчета);
		КонецЕсли;
		Если ПустаяСтрока(ПредставлениеПоставщикаДляПлатПоручения) Тогда
			ПредставлениеПоставщикаДляПлатПоручения = Шапка.Организация.НаименованиеПолное;
		КонецЕсли;
		ПараметрыПечати.Вставить("ПредставлениеПоставщикаДляПлатПоручения", ПредставлениеПоставщикаДляПлатПоручения);
	//КонецЕсли; 

	ПараметрыПечати.Вставить("ТекстЗаголовка", Renault_Advanced_ОбщегоНазначения.СформироватьЗаголовокДокумента(Шапка, "Счет на оплату"));
	ПараметрыПечати.Вставить("ТекстПоставщик", "Поставщик:");
	
	ПредставлениеОрганизицииСтрока = Шапка.Организация.НаименованиеПолное + ", ИНН: " + Шапка.Организация.ИНН + ", КПП: " + Шапка.Организация.КПП + ", Адрес: " + Шапка.АдресОрганизация + ", Телефон: " + Шапка.ТелефонОрганизация;
	
	ПараметрыПечати.Вставить("ПредставлениеПоставщика", ПредставлениеОрганизицииСтрока);
	ПараметрыПечати.Вставить("ПредставлениеГрузоотправителя", ПредставлениеОрганизицииСтрока);
	
	ПредставлениеКонтрагентСтрока = Шапка.Получатель.НаименованиеПолное + ", ИНН: " + Шапка.Получатель.ИНН + ", КПП: " + Шапка.Получатель.КПП + ", Адрес: " + Шапка.АдресКонтрагент + ", Телефон: " + Шапка.ТелефонКонтрагент;
	ПараметрыПечати.Вставить("ТекстПокупатель", "Покупатель:");
	ПараметрыПечати.Вставить("ПредставлениеПолучателя", ПредставлениеКонтрагентСтрока);
	ПараметрыПечати.Вставить("ПредставлениеГрузополучателя", ПредставлениеКонтрагентСтрока);

	ПараметрыПечати.Вставить("ЕстьСкидки", Ложь);
	Для каждого ВыборкаСтрокТовары Из ЗапросТовары Цикл 
		Если ЗначениеЗаполнено(ВыборкаСтрокТовары.Скидка) Тогда
			ПараметрыПечати.ЕстьСкидки = Истина;
			Прервать;
		КонецЕсли; 
	КонецЦикла;

	//Шапка_АМ
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорХраненияКолес.ЗаказНаряд.Автомобиль.VIN КАК АМ_VIN,
	|	"+СформироватьСтрокуПоляЗапроса("МаркаМодель")+" КАК АМ_МаркаМодель,
	|	ДоговорХраненияКолес.СрокХранения,
	|	ДоговорХраненияКолес.СрокХраненияПросрочка,
	|	ДоговорХраненияКолес.Цена КАК ЦенаХранения,
	|	ДоговорХраненияКолес.Размер.Наименование КАК Радиус
	|ИЗ
	|	Документ.Renault_Advanced_ДоговорХраненияКолес КАК ДоговорХраненияКолес
	|ГДЕ
	|	ДоговорХраненияКолес.Ссылка = &ТекущийДокумент";
	Шапка_АМ = Запрос.Выполнить().Выбрать();
	Шапка_АМ.Следующий();
	ПараметрыПечати.Вставить("АМ_ГосНомер", Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Ссылка.ЗаказНаряд.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ТекущаяДата()));
	ПараметрыПечати.Вставить("АМ_VIN", Шапка_АМ.АМ_VIN);
	ПараметрыПечати.Вставить("АМ_МаркаМодель", Шапка_АМ.АМ_МаркаМодель);
	ПараметрыПечати.Вставить("СрокХранения", Шапка_АМ.СрокХранения);
	ПараметрыПечати.Вставить("СрокХраненияПросрочка", Шапка_АМ.СрокХраненияПросрочка);
	ПараметрыПечати.Вставить("ЦенаХранения", Шапка_АМ.ЦенаХранения);
	ПараметрыПечати.Вставить("Радиус", Шапка_АМ.Радиус);
	
	//ДопКолонка = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	ПараметрыПечати.Вставить("ВыводитьКоды", Ложь);
	//Если ДопКолонка = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
	//	ПараметрыПечати.ВыводитьКоды = Истина;
	//	Колонка = "Артикул";
	//ИначеЕсли ДопКолонка = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Код Тогда
	//	ПараметрыПечати.ВыводитьКоды = Истина;
	//	Колонка = "Код";
	//КонецЕсли;
	//
	//Если ПараметрыПечати.ВыводитьКоды Тогда
	//	ПараметрыПечати.Вставить("ИмяКолонкиКодов", Колонка);
	//КонецЕсли; //пока так, доделать

	тСумма    = 0;
	СуммаНДС = 0;
	ВсегоСкидок    = 0;
	ВсегоБезСкидок = 0;

	Для каждого ВыборкаСтрокТовары Из ЗапросТовары Цикл 
		
		ПараметрыПозиции = Новый Структура;

		ПараметрыПозиции.Вставить("Номенклатура", ВыборкаСтрокТовары.Номенклатура);
		ПараметрыПозиции.Вставить("НомерСтроки", ЗапросТовары.Индекс(ВыборкаСтрокТовары) + 1);

		//Если ПараметрыПечати.ВыводитьКоды Тогда
		//	Если Колонка = "Артикул" Тогда
		//		ПараметрыПозиции.Вставить("Артикул", ВыборкаСтрокТовары.Артикул);
		//	Иначе
		//		ПараметрыПозиции.Вставить("Артикул", ВыборкаСтрокТовары.Код);
		//	КонецЕсли;
		//КонецЕсли; пока так, доделать

		ПараметрыПозиции.Вставить("Количество", ВыборкаСтрокТовары.Количество);
		Если ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
			ПараметрыПозиции.Вставить("ЕдиницаИзмерения", ВыборкаСтрокТовары.ЕдиницаИзмерения);
		ИначеЕсли ТипЗнч(СчетЗаказ) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			ПараметрыПозиции.Вставить("ЕдиницаИзмерения", "шт");
		КонецЕсли;

		
		ПараметрыПозиции.Вставить("Цена", ВыборкаСтрокТовары.Цена);
		Если ТипЗнч(СчетЗаказ) <> Тип("ДокументСсылка.ЗаказНаряд") Тогда  
			ПараметрыПозиции.Вставить("Товар", СокрП(ВыборкаСтрокТовары.НаименованиеПолное));
		Иначе
			ПараметрыПозиции.Вставить("Товар", СокрП(ВыборкаСтрокТовары.НаименованиеПолное));
		КонецЕсли;
	
		Скидка = Окр(ВыборкаСтрокТовары.Сумма * ВыборкаСтрокТовары.Скидка / (100 - ВыборкаСтрокТовары.Скидка), 2);

		Если ПараметрыПечати.ЕстьСкидки Тогда
			ПараметрыПозиции.Вставить("Скидка", Скидка);
			ПараметрыПозиции.Вставить("СуммаБезСкидки", ВыборкаСтрокТовары.Сумма + Скидка);
		КонецЕсли;

		ПараметрыПозиции.Вставить("Сумма", ВыборкаСтрокТовары.Сумма); 
		
		тСумма         = тСумма       + ВыборкаСтрокТовары.Сумма;
		СуммаНДС       = СуммаНДС    + ВыборкаСтрокТовары.СуммаНДС;
		ВсегоСкидок    = ВсегоСкидок + Скидка;
		ВсегоБезСкидок = тСумма       + ВсегоСкидок;
		//#Если ВнешнееСоединение Тогда
		//WEBПриложения.ПодготовитьСтруктуруДляВнешнегоСоединения(ПараметрыПозиции);
		//#КонецЕсли //пока так, доделать

		Позиции.Добавить(ПараметрыПозиции);

	КонецЦикла;
	
	ПараметрыПечати.Вставить("Позиции", Позиции);

	// Вывести Итого
	Если ПараметрыПечати.ЕстьСкидки Тогда
		ПараметрыПечати.Вставить("ВсегоСкидок", ВсегоСкидок);
		ПараметрыПечати.Вставить("ВсегоБезСкидок", ВсегоБезСкидок);
	КонецЕсли;
	ПараметрыПечати.Вставить("Всего", Renault_Advanced_ОбщегоНазначения.ФорматСумм(тСумма));

	// Вывести ИтогоНДС
	Если ПараметрыПечати.УчитыватьНДС Тогда
		ПараметрыПечати.Вставить("НДС", ?(Шапка.СуммаВключаетНДС, "В том числе НДС:", "Сумма НДС:"));
		ПараметрыПечати.Вставить("ВсегоНДС", Renault_Advanced_ОбщегоНазначения.ФорматСумм(ЗапросТовары.Итог("СуммаНДС")));
		ПараметрыПечати.Вставить("ВсегоКОплате", Renault_Advanced_ОбщегоНазначения.ФорматСумм(тСумма + ?(Шапка.СуммаВключаетНДС, 0, СуммаНДС)));
	КонецЕсли;

	// Вывести Сумму прописью
	СуммаКПрописи = тСумма + ?(Шапка.СуммаВключаетНДС, 0, СуммаНДС);
	ПараметрыПечати.Вставить("ИтоговаяСтрока", "Всего наименований " + ЗапросТовары.Количество()
	+ ", на сумму " + Renault_Advanced_ОбщегоНазначения.ФорматСумм(СуммаКПрописи, Шапка.ВалютаДокумента));
	ПараметрыПечати.Вставить("СуммаПрописью", Renault_Advanced_ОбщегоНазначения.СформироватьСуммуПрописью(СуммаКПрописи, Шапка.ВалютаДокумента));

	// Вывести подписи
	//Если Тип = "Счет" Тогда
		Руководители = дкОтветственноеЛицо(ЭтотОбъект.ЗаказНаряд.ПолучитьОбъект(), Перечисления.ВидыОбъектовСведений.Руководитель);
		Руководитель = Руководители.РуководительПредставление;
		ДолжностьРуководителя = Руководители.РуководительДолжность.Наименование;
		
		ГлБухгалтеры =  дкОтветственноеЛицо(ЭтотОбъект.ЗаказНаряд.ПолучитьОбъект(), Перечисления.ВидыОбъектовСведений.ГлавныйБухгалтер);
		Бухгалтер = ГлБухгалтеры.ГлавныйБухгалтерПредставление;
		//Руководители = Renault_Advanced_РегламентированнаяОтчетность.ОтветственныеЛицаОрганизации(Шапка.Руководители, Шапка.Дата,);
		//Руководитель = Руководители.Руководитель;
		//ДолжностьРуководителя = Руководители.РуководительДолжность;
		//Бухгалтер    = Руководители.ГлавныйБухгалтер;
		
		ПараметрыПечати.Вставить("ФИОРуководителя", 		Руководитель);
		ПараметрыПечати.Вставить("ДолжностьРуководителя", 	ДолжностьРуководителя);
		ПараметрыПечати.Вставить("ФИОБухгалтера", 			Бухгалтер);
		
		Ответственный = СчетЗаказ.Автор;
		Если НЕ ЗначениеЗаполнено(Ответственный.Сотрудник) Тогда
			ФИООтветственный = СокрЛП(Ответственный);  
		Иначе
			ФИООтветственный = Ответственный.Сотрудник;
		КонецЕсли;
		ПараметрыПечати.Вставить("ФИООтветственный", ФИООтветственный);

	//КонецЕсли; 
	
	//#Если ВнешнееСоединение Тогда
	//WEBПриложения.ПодготовитьСтруктуруДляВнешнегоСоединения(ПараметрыПечати);
	//#КонецЕсли пока так, доделать

	Возврат ПараметрыПечати;

КонецФункции //ПолучитьПараметрыПечатиСчетаЗаказа()

//!
Функция ПечатьБирок() Экспорт

	ТабДокумент                     = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Renault_Advanced_ДоговорХраненияКолес_Бирки";
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Ландшафт;
	Макет                           = ПолучитьМакет("Бирки");
	ОбластьБирки                    = Макет.ПолучитьОбласть("Строка|Столбец");

	ДатаПечати = РабочаяДата;

	ТекСтолбец = 0;
	ТекСтрока  = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорХраненияКолес.Номер КАК НомерДокумента,
	|	ДоговорХраненияКолес.Дата КАК ДатаДокумента,
	|	ДоговорХраненияКолес.ЗаказНаряд.Номер КАК НомерЗаказНаряда,
	|	ДоговорХраненияКолес.ЗаказНаряд.Дата КАК ДатаЗаказНаряда,
	|	ДоговорХраненияКолес.ДатаВыдачи,
	|	ДоговорХраненияКолес.ЗаказНаряд.Организация.Наименование КАК ОрганизацияНаименование,
	|	ДоговорХраненияКолес.ЗаказНаряд.Автомобиль.VIN КАК АМ_VIN,
	|	ДоговорХраненияКолес.Размер.Наименование КАК Радиус,
	|	ДоговорХраненияКолес.Количество,
	|	Renault_Advanced_РеквизитыЗаказНаряда.РеквизитыДокумента.Плательщик КАК Контрагент,
	|	Renault_Advanced_РеквизитыЗаказНаряда.РеквизитыДокумента.Плательщик.НаименованиеПолное КАК Поклажедатель,
	|	"+СформироватьСтрокуПоляЗапроса("ИзделиеПредставление", Запрос)+" КАК ИзделиеПредставление,
	|	Автомобили.Значение КАК АМ_ГосНомер
	|ИЗ
	|	Документ.Renault_Advanced_ДоговорХраненияКолес КАК ДоговорХраненияКолес
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Advanced_РеквизитыЗаказНаряда КАК Renault_Advanced_РеквизитыЗаказНаряда
	|		ПО ДоговорХраненияКолес.ЗаказНаряд = Renault_Advanced_РеквизитыЗаказНаряда.ЗаказНаряд
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили КАК Автомобили
	|		ПО ДоговорХраненияКолес.ЗаказНаряд.Автомобиль = Автомобили.Автомобиль
	|			И (Автомобили.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер))
	|ГДЕ
	|	ДоговорХраненияКолес.Ссылка = &ТекущийДокумент";
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();

	Для Тмп = 1 По Количество Цикл
		ОбластьБирки.Параметры.Заполнить(Шапка);
		ОбластьБирки.Параметры.Поклажедатель = ВРег(Шапка.Поклажедатель);
		ОбластьБирки.Параметры.ДатаДокумента = Формат(Шапка.ДатаДокумента, "ДЛФ=D");
		ОбластьБирки.Параметры.ДатаВыдачи    = Формат(Шапка.ДатаВыдачи, "ДЛФ=D");
		ОбластьБирки.Параметры.ДатаЗаказНаряда = Формат(Шапка.ДатаЗаказНаряда, "ДЛФ=D");
		
		Если ТекСтолбец = 0 Тогда
			ТабДокумент.Вывести(ОбластьБирки);
		Иначе
			ТабДокумент.Присоединить(ОбластьБирки);
		КонецЕсли;
		
		ТекСтолбец = ТекСтолбец + 1;
		
		Если ТекСтолбец = 2 Тогда
			ТекСтрока  = ТекСтрока + 1;
			ТекСтолбец = 0;
		КонецЕсли;
		
		Если ТекСтрока = 2 Тогда
			ТекСтрока = 0;
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
	КонецЦикла;

	ТабДокумент.ТолькоПросмотр = Истина;

	Возврат ТабДокумент;

КонецФункции // ПечатьБирок()

//!
Функция ПечатьПрайсЛиста() Экспорт
	
	ЭтоЮрЛицо = Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;
	
	ТабДок = Новый ТабличныйДокумент;
	// Зададим параметры макета
	ТабДок.ПолеСверху              = 0;
	ТабДок.ПолеСлева               = 5;
	ТабДок.ПолеСнизу               = 0;
	ТабДок.ПолеСправа              = 5;
	ТабДок.АвтоМасштаб             = Истина;
	ТабДок.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Renault_Advanced_ДоговорХраненияКолес_ПрайсЛистХранителя";

	Макет = ПолучитьМакет("ПрайсЛистХранителя");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорХраненияКолес.Номер КАК НомерДокумента,
	|	ДоговорХраненияКолес.Дата КАК ДатаДокумента,
	|	ДоговорХраненияКолес.ЗаказНаряд.Организация КАК Организация,
	|	ДоговорХраненияКолес.ЗаказНаряд.Организация.ОсновнойБанковскийСчет КАК БанковскийСчет,
	|	Renault_Advanced_РеквизитыЗаказНаряда.РеквизитыДокумента.Плательщик КАК Контрагент
	|ИЗ
	|	Документ.Renault_Advanced_ДоговорХраненияКолес КАК ДоговорХраненияКолес
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Advanced_РеквизитыЗаказНаряда КАК Renault_Advanced_РеквизитыЗаказНаряда
	|		ПО ДоговорХраненияКолес.ЗаказНаряд = Renault_Advanced_РеквизитыЗаказНаряда.ЗаказНаряд
	|ГДЕ
	|	ДоговорХраненияКолес.Ссылка = &ТекущийДокумент";
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	// Заголовок
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	
	// Выводим общие реквизиты шапки
	Запрос	= Новый Запрос;
	Запрос.Текст	= 		
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.ИНН,
	|	Контрагенты.КПП,
	|	Контрагенты.НаименованиеПолное,
	|	Контрагенты.КодПоОКПО,
	|	Контрагенты.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.Наименование КАК Банк,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.КоррСчет КАК КоррСчет,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.Код КАК БИК
	|ПОМЕСТИТЬ КонтрагентИнфа
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	|	КОНЕЦ КАК Контрагент,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК Телефон,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|					И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресФактический)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК АдресФактический,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|					И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК АдресЮридический
	|ПОМЕСТИТЬ КонтИнфа
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контрагент
	|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонКонтактный)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресФактический)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Серия,
	|	ПодтверждающиеДокументы.Номер,
	|	ПодтверждающиеДокументы.ДатаВыдачи,
	|	ПодтверждающиеДокументы.КемВыдан,
	|	ПодтверждающиеДокументы.Владелец КАК Контрагент
	|ПОМЕСТИТЬ ДокументКонтрагента
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Контрагент
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтрагентИнфа.ИНН,
	|	КонтрагентИнфа.КПП,
	|	КонтрагентИнфа.НаименованиеПолное КАК ПолноеНаименование,
	|	КонтИнфа.Телефон,
	|	КонтИнфа.АдресФактический КАК АдресФактический,
	|	КонтИнфа.АдресЮридический КАК АдресЮридический,
	|	ДокументКонтрагента.Серия КАК ДокументСерия,
	|	ДокументКонтрагента.Номер КАК ДокументНомер,
	|	ДокументКонтрагента.ДатаВыдачи КАК ДокументДатаВыдачи,
	|	ДокументКонтрагента.КемВыдан КАК ДокументКемВыдан,
	|	КонтрагентИнфа.КодПоОКПО,
	|	КонтрагентИнфа.НомерСчета,
	|	КонтрагентИнфа.Банк,
	|	КонтрагентИнфа.КоррСчет,
	|	КонтрагентИнфа.БИК
	|ИЗ
	|	КонтрагентИнфа КАК КонтрагентИнфа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДокументКонтрагента КАК ДокументКонтрагента
	|		ПО КонтрагентИнфа.Контрагент = ДокументКонтрагента.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ КонтИнфа КАК КонтИнфа
	|		ПО КонтрагентИнфа.Контрагент = КонтИнфа.Контрагент";
	                                                      
	Запрос.УстановитьПараметр("Контрагент", Шапка.Контрагент);
	Результат =  Запрос.Выполнить();
	СведенияОКонтрагенте = Результат.Выбрать();
	СведенияОКонтрагенте.Следующий();
		
	Запрос	= Новый Запрос;
	Запрос.Текст	= 		
	"ВЫБРАТЬ
	|	Организации.НаименованиеПолное,
	|	Организации.Ссылка КАК Организация,
	|	Организации.ИНН,
	|	Организации.КПП,
	|	Организации.ОГРН,
	|	Организации.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	Организации.ОсновнойБанковскийСчет.Банк.Наименование КАК БанкНаименование,
	|	Организации.ОсновнойБанковскийСчет.Банк.КоррСчет КАК КоррСчет,
	|	Организации.ОсновнойБанковскийСчет.Банк.Код КАК БИК,
	|	Организации.КодПоОКПО,
	|	Организации.Наименование
	|ПОМЕСТИТЬ ОрганизацияИнформация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Организации
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Организации).Ссылка
	|	КОНЕЦ КАК Организация,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК Телефон,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК Адрес
	|ПОМЕСТИТЬ ОргКонт
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Организация
	|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонРабочий)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Организации
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Организации).Ссылка
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОрганизацияИнформация.НаименованиеПолное КАК ПолноеНаименование,
	|	ОрганизацияИнформация.ИНН КАК ИНН,
	|	ОрганизацияИнформация.КПП КАК КПП,
	|	ОрганизацияИнформация.ОГРН КАК ОГРН,
	|	ОрганизацияИнформация.НомерСчета КАК НомерСчета,
	|	ОрганизацияИнформация.БанкНаименование КАК Банк,
	|	ОрганизацияИнформация.КоррСчет КАК КоррСчет,
	|	ОрганизацияИнформация.БИК КАК БИК,
	|	ОргКонт.Телефон КАК Телефон,
	|	ОргКонт.Адрес КАК АдресЮридический,
	|	ОрганизацияИнформация.КодПоОКПО КАК КодПоОКПО,
	|	ОрганизацияИнформация.Наименование
	|ИЗ
	|	ОрганизацияИнформация КАК ОрганизацияИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОргКонт КАК ОргКонт
	|		ПО ОрганизацияИнформация.Организация = ОргКонт.Организация";
	
	Запрос.УстановитьПараметр("Организация", Шапка.Организация);
	Результат = Запрос.Выполнить();
	СведенияООрганизации = Результат.Выбрать();		
	СведенияООрганизации.Следующий(); 
	
	Руководители = дкОтветственноеЛицо(ЭтотОбъект.ЗаказНаряд.ПолучитьОбъект(), Перечисления.ВидыОбъектовСведений.Руководитель);
	Руководитель = Руководители.РуководительПредставление;	
	
	ОбластьМакета.Параметры.Заполнить(Шапка);
	ОбластьМакета.Параметры.ДатаДокумента  = Формат(Шапка.ДатаДокумента, "ДФ=""дд ММММ гггг""");
	ТабДок.Вывести(ОбластьМакета);
	
	Если ЭтоЮрЛицо Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("Подписи_ЮЛ");
		ОбластьМакета.Параметры.Контрагент = ВРег(СведенияОКонтрагенте.ПолноеНаименование);
		ОбластьМакета.Параметры.ИННКонтрагента = СведенияОКонтрагенте.ИНН;
		ОбластьМакета.Параметры.КППКонтрагента = СведенияОКонтрагенте.КПП;
		ОбластьМакета.Параметры.КодПоОКПОКонтрагента = СведенияОКонтрагенте.КодПоОКПО;
		ОбластьМакета.Параметры.БанкКонтрагента = СведенияОКонтрагенте.Банк;
		ОбластьМакета.Параметры.БИККонтрагента = СведенияОКонтрагенте.БИК;
		ОбластьМакета.Параметры.КоррСчетКонтрагента = СведенияОКонтрагенте.КоррСчет;
		ОбластьМакета.Параметры.НомерСчетаКонтрагента = СведенияОКонтрагенте.НомерСчета;
		//ОбластьМакета.Параметры.ОГРНКонтрагента = Шапка.Контрагент.ОГРН;
	Иначе	
		ОбластьМакета = Макет.ПолучитьОбласть("Подписи_ФЛ");
		ОбластьМакета.Параметры.Покупатель_ФИО_Полностью = ВРег(СведенияОКонтрагенте.ПолноеНаименование);
		ОбластьМакета.Параметры.ФактическийАдресКонтрагента = СведенияОКонтрагенте.АдресФактический;
		ОбластьМакета.Параметры.пасп_сер   = СведенияОКонтрагенте.ДокументСерия;
		ОбластьМакета.Параметры.пасп_ном   = СведенияОКонтрагенте.ДокументНомер;
		ОбластьМакета.Параметры.КогдаВыдан = ?(ЗначениеЗаполнено(СведенияОКонтрагенте.ДокументДатаВыдачи), Формат(СведенияОКонтрагенте.ДокументДатаВыдачи, "ДЛФ=D"), "Нет даты года");
		ОбластьМакета.Параметры.КемВыдан   = СведенияОКонтрагенте.ДокументКемВыдан;
	КонецЕсли;
	ОбластьМакета.Параметры.ТелефоныКонтрагента = СведенияОКонтрагенте.Телефон;
	ОбластьМакета.Параметры.ЮридическийАдресКонтрагента = СведенияОКонтрагенте.АдресЮридический;
	
	ОбластьМакета.Параметры.ПолноеНаименованиеОрганизации = СведенияООрганизации.ПолноеНаименование;
	ОбластьМакета.Параметры.ИНН = СведенияООрганизации.ИНН;
	ОбластьМакета.Параметры.КПП = СведенияООрганизации.КПП;
	ОбластьМакета.Параметры.ЮридическийАдрес = СведенияООрганизации.АдресЮридический;
	ОбластьМакета.Параметры.НомерСчета = СведенияООрганизации.НомерСчета;
	ОбластьМакета.Параметры.Банк = СведенияООрганизации.Банк;
	ОбластьМакета.Параметры.КоррСчет = СведенияООрганизации.КоррСчет;
	ОбластьМакета.Параметры.БИК = СведенияООрганизации.БИК;
	ОбластьМакета.Параметры.КодПоОКПО = СведенияООрганизации.КодПоОКПО;
	ОбластьМакета.Параметры.Телефоны = СведенияООрганизации.Телефон;
	ОбластьМакета.Параметры.ОГРН = СведенияООрганизации.ОГРН;
	ОбластьМакета.Параметры.ФИОРуководителя = ВРег(Руководитель); 	

    ТабДок.Вывести(ОбластьМакета);

	Возврат ТабДок;
КонецФункции		 

