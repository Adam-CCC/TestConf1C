//!
Процедура ПриЗаписи(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_Advanced_ХранениеКолес.Контейнер,
		|	Renault_Advanced_ХранениеКолес.Стеллаж,
		|	Renault_Advanced_ХранениеКолес.Полка,
		|	Renault_Advanced_ХранениеКолес.Ряд,
		|	Renault_Advanced_ХранениеКолес.Договор,
		|	ВЫБОР
		|		КОГДА Renault_Advanced_ХранениеКолес.Контейнер = &Контейнер
		|				И Renault_Advanced_ХранениеКолес.Стеллаж = &Стеллаж
		|				И Renault_Advanced_ХранениеКолес.Полка = &Полка
		|				И Renault_Advanced_ХранениеКолес.Ряд = &Ряд
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Флаг
		|ИЗ
		|	РегистрСведений.Renault_Advanced_ХранениеКолес КАК Renault_Advanced_ХранениеКолес
		|ГДЕ
		|	Renault_Advanced_ХранениеКолес.Договор = &Договор
		|
		|УПОРЯДОЧИТЬ ПО
		|	Флаг УБЫВ";

	Запрос.УстановитьПараметр("Договор", Ссылка);
	Запрос.УстановитьПараметр("Контейнер", Контейнер);
	Запрос.УстановитьПараметр("Полка", Полка);
	Запрос.УстановитьПараметр("Ряд", Ряд);
	Запрос.УстановитьПараметр("Стеллаж", Стеллаж);

	Если ПометкаУдаления Тогда
		
		Ответ = Вопрос("Документ помечен на удаление! Информация о хранении будет удалена"+Символы.ВК+ 
		"без возможности востановления! Продолжить и удалить?",РежимДиалогаВопрос.ОКОтмена,,КодВозвратаДиалога.Отмена);
		
		Если Ответ = КодВозвратаДиалога.Отмена тогда
			
			Отказ = Истина;
			
		Иначе
			
			Результат = Запрос.Выполнить();
			Если Не Результат.Пустой() Тогда //надо "освободить" ячейку
				
				ВыборкаДетальныеЗаписи = Результат.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					НаборЗапХранен = РегистрыСведений.Renault_Advanced_ХранениеКолес.СоздатьМенеджерЗаписи();		   
					НаборЗапХранен.Контейнер = ВыборкаДетальныеЗаписи.Контейнер;
					НаборЗапХранен.Стеллаж   = ВыборкаДетальныеЗаписи.Стеллаж;
					НаборЗапХранен.Полка     = ВыборкаДетальныеЗаписи.Полка;
					НаборЗапХранен.Ряд       = ВыборкаДетальныеЗаписи.Ряд;
					НаборЗапХранен.Договор   = Документы.Renault_Advanced_ДоговорХраненияКолес.ПустаяСсылка();
					НаборЗапХранен.Записать();
				КонецЦикла;
				
			КонецЕсли;		 
		КонецЕсли; 		
	Иначе
		Если Контейнер+Стеллаж+Полка+Ряд = 0 Тогда
			
			Если  ЗначениеЗаполнено(ДатаВыдачиФакт) Тогда //это выдача
				Сообщить("Ячейка хранения не указана. Невозможно оформить выдачу по договору без размещения!");	
				Отказ = Истина;
			КонецЕсли;
			Возврат;
			
		КонецЕсли;
		// проверка наличия информации об этом документе 
		// в регистре  //////////////////////////////////
		
		Результат = Запрос.Выполнить();
	
		Если ЗначениеЗаполнено(ДатаВыдачиФакт) Тогда    //это выдача
			Если Не Результат.Пустой() Тогда //надо "освободить" ячейку
				
				ВыборкаДетальныеЗаписи = Результат.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					НаборЗапХранен = РегистрыСведений.Renault_Advanced_ХранениеКолес.СоздатьМенеджерЗаписи();		   
					НаборЗапХранен.Контейнер = ВыборкаДетальныеЗаписи.Контейнер;
					НаборЗапХранен.Стеллаж   = ВыборкаДетальныеЗаписи.Стеллаж;
					НаборЗапХранен.Полка     = ВыборкаДетальныеЗаписи.Полка;
					НаборЗапХранен.Ряд       = ВыборкаДетальныеЗаписи.Ряд;
					НаборЗапХранен.Договор   = Документы.Renault_Advanced_ДоговорХраненияКолес.ПустаяСсылка();
					НаборЗапХранен.Записать();
				КонецЦикла;
			КонецЕсли;
		Иначе                                           //это не выдача
			НаборЗапХранен = РегистрыСведений.Renault_Advanced_ХранениеКолес.СоздатьМенеджерЗаписи();		   
			НаборЗапХранен.Контейнер = Контейнер;
			НаборЗапХранен.Стеллаж   = Стеллаж;
			НаборЗапХранен.Полка     = Полка;
			НаборЗапХранен.Ряд       = Ряд;
			
			НаборЗапХранен.Прочитать();
			
			Если НаборЗапХранен.Выбран()  
				И НаборЗапХранен.Договор <> Ссылка 
				И Не НаборЗапХранен.Договор = Документы.Renault_Advanced_ДоговорХраненияКолес.ПустаяСсылка() Тогда //ячейка занята
				
				Сообщить("Запись не возможна! Ячейка хранения занята");
				Отказ = Истина;
			Иначе			
				НаборЗапХранен.Контейнер = Контейнер;
				НаборЗапХранен.Стеллаж   = Стеллаж;
				НаборЗапХранен.Полка     = Полка;
				НаборЗапХранен.Ряд       = Ряд;
				НаборЗапХранен.Договор   = Ссылка;
				НаборЗапХранен.Записать();
				Если Не Результат.Пустой() Тогда
					
					ВыборкаДетальныеЗаписи = Результат.Выбрать();
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						Если ВыборкаДетальныеЗаписи.Флаг Тогда
							Продолжить;
						КонецЕсли;
						НаборЗапХранен = РегистрыСведений.Renault_Advanced_ХранениеКолес.СоздатьМенеджерЗаписи();		   
						НаборЗапХранен.Контейнер = ВыборкаДетальныеЗаписи.Контейнер;
						НаборЗапХранен.Стеллаж   = ВыборкаДетальныеЗаписи.Стеллаж;
						НаборЗапХранен.Полка     = ВыборкаДетальныеЗаписи.Полка;
						НаборЗапХранен.Ряд       = ВыборкаДетальныеЗаписи.Ряд;
						НаборЗапХранен.Договор   = Документы.Renault_Advanced_ДоговорХраненияКолес.ПустаяСсылка();
						НаборЗапХранен.Записать();
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

//!
Функция ПолучитьУслугуПоНоменклатуре(АвтоуслугаРаботы) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автоработы.Ссылка
		|ИЗ
		|	Справочник.Автоработы КАК Автоработы
		|ГДЕ
		|	Автоработы.Номенклатура = &АвтоуслугаРаботы";

	Запрос.УстановитьПараметр("АвтоуслугаРаботы", АвтоуслугаРаботы);
	
	Результат = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Возврат ?(ВыборкаДетальныеЗаписи.Следующий(), ВыборкаДетальныеЗаписи.Ссылка, Справочники.Автоработы.ПустаяСсылка());
	
КонецФункции // ПолучитьУслугуПоНоменклатуре()

//!
Функция ПечатьАктаПриемаКолес(ГосНомер = "",Телефоны = Неопределено, Выдача=Ложь, АктБезПросрочки = Ложь) Экспорт
	
	ЭтоЮрЛицо = Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо;

	ТабДок = Новый ТабличныйДокумент;
	// Зададим параметры макета
	ТабДок.ПолеСверху              = 0;
	ТабДок.ПолеСлева               = 5;
	ТабДок.ПолеСнизу               = 0;
	ТабДок.ПолеСправа              = 5;
	ТабДок.АвтоМасштаб             = Истина;
	ТабДок.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;//.Ландшафт;
	
	
	Если АктБезПросрочки Тогда 
		ТабДок = ПечатьАктаОбОказанииУслуг(); 	
		Возврат ТабДок;
	ИначеЕсли Выдача И Не СуммаПросрочки>0 И Не СрокХраненияПросрочка>0 Тогда
		Сообщить("Невозможно распечатать акт возврата с просрочкой по причине:
				  |-Просрочка не зафиксирована!");          
		Возврат Неопределено;
	КонецЕсли;
	
			
	ИмяМакета = ?(Выдача, "АктВозврата", "ПечатьАктаПриемаКолес");
	
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Renault_Advanced_ДоговорХраненияКолес_"+ИмяМакета;

	Макет = ПолучитьМакет(ИмяМакета);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорХраненияКолес.Номер КАК НомерДокумента,
	|	ДоговорХраненияКолес.Дата КАК ДатаДокумента,
	|	ДоговорХраненияКолес.ЗаказНаряд.Номер КАК НомерЗаказНаряда,
	|	ДоговорХраненияКолес.ЗаказНаряд.Дата КАК ДатаЗаказНаряда,
	|	ДоговорХраненияКолес.ЗаказНаряд.Организация КАК Организация,
	|	ДоговорХраненияКолес.ЗаказНаряд.Организация.ОсновнойБанковскийСчет КАК БанковскийСчет,
	|	ДоговорХраненияКолес.ЗаказНаряд.Автомобиль.VIN КАК АМ_VIN,
	|	ДоговорХраненияКолес.Количество,
	|	ДоговорХраненияКолес.СрокХранения,
	|	ДоговорХраненияКолес.Сумма,
	|	ДоговорХраненияКолес.ДатаВыдачи,	
	|	ДоговорХраненияКолес.СрокХраненияПросрочка,
	|	ДоговорХраненияКолес.СуммаПросрочки,
	|	ДоговорХраненияКолес.ДатаВыдачиФакт,
	|	ДоговорХраненияКолес.ВыявленыеНеисправности КАК Комментарий,
	|	"+СформироватьСтрокуПоляЗапроса("МаркаМодель")+" КАК АМ_МаркаМодель,
	|	"+СформироватьСтрокуПоляЗапроса("ИзделиеПредставление", Запрос)+" КАК ИзделиеПредставление,
	|	ВЫБОР
	|		КОГДА ДоговорХраненияКолес.Автопокрышки
	|			ТОГДА ""Автопокрышки""
	|		КОГДА ДоговорХраненияКолес.КолесаВСборе
	|			ТОГДА ""Колеса в сборе""
	|		КОГДА ДоговорХраненияКолес.ТолькоДиски
	|			ТОГДА ""Только диски""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК АвтопокрышкиВариант,
	|	ВЫБОР
	|		КОГДА ДоговорХраненияКолес.Автопокрышки
	|			ТОГДА ""Не сданы""
	|		КОГДА ДоговорХраненияКолес.ОригТипДисков
	|			ТОГДА ""Оригинальные""
	|		ИНАЧЕ ""Не оригинальные""
	|	КОНЕЦ КАК ОригТипДисковВыбор,
	|	ВЫБОР
	|		КОГДА ДоговорХраненияКолес.КрепежСдан
	|			ТОГДА ""Крепеж сдан""
	|		ИНАЧЕ ""Крепеж не сдан""
	|	КОНЕЦ КАК КрепежСданВыбор,
	|	ВЫБОР
	|		КОГДА ДоговорХраненияКолес.СупинаторыЕсть
	|			ТОГДА ""Супинаторы сданы""
	|		ИНАЧЕ ""Супинаторы не сданы""
	|	КОНЕЦ КАК СупинаторыЕстьВыбор,
	|	ВЫБОР
	|		КОГДА ДоговорХраненияКолес.СекреткиЕсть
	|			ТОГДА ""Секретки сданы""
	|		ИНАЧЕ ""Секретки не сданы""
	|	КОНЕЦ КАК СекреткиЕстьВыбор,
	|	ВЫБОР
	|		КОГДА ДоговорХраненияКолес.Автопокрышки
	|			ТОГДА ""Без дисков""
	|		КОГДА ДоговорХраненияКолес.ДискСталные
	|			ТОГДА ""Диски сталные""
	|		КОГДА ДоговорХраненияКолес.ДискЛегкосплавные
	|			ТОГДА ""Диски легкосплавные""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ДискСталныеВыбор,
	|	ДоговорХраненияКолес.СтепеньИзноса,
	|	ДоговорХраненияКолес.Новые,
	|	Renault_Advanced_РеквизитыЗаказНаряда.РеквизитыДокумента.Плательщик КАК Контрагент,
	|	Renault_Advanced_РеквизитыЗаказНаряда.РеквизитыДокумента.Плательщик.Сотрудник КАК Контрагент_ФизЛицо,
	|	Автомобили.Значение КАК АМ_ГосНомер
	|ИЗ
	|	Документ.Renault_Advanced_ДоговорХраненияКолес КАК ДоговорХраненияКолес
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Renault_Advanced_РеквизитыЗаказНаряда КАК Renault_Advanced_РеквизитыЗаказНаряда
	|		ПО ДоговорХраненияКолес.ЗаказНаряд = Renault_Advanced_РеквизитыЗаказНаряда.ЗаказНаряд
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили КАК Автомобили
	|		ПО ДоговорХраненияКолес.ЗаказНаряд.Автомобиль = Автомобили.Автомобиль
	|			И (Автомобили.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер))
	|ГДЕ
	|	ДоговорХраненияКолес.Ссылка = &ТекущийДокумент";
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	// Заголовок
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьМакета.Параметры.Заполнить(Шапка);
	
	// Выводим общие реквизиты шапки
	
	Запрос	= Новый Запрос;
	Запрос.Текст	= 		
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.ИНН,
	|	Контрагенты.КПП,
	|	Контрагенты.НаименованиеПолное,
	|	Контрагенты.КодПоОКПО,
	|	Контрагенты.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.Наименование КАК Банк,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.КоррСчет КАК КоррСчет,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.Код КАК БИК
	|ПОМЕСТИТЬ КонтрагентИнфа
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	|	КОНЕЦ КАК Контрагент,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК Телефон,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|					И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресФактический)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК АдресФактический,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|					И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический)
	|				ТОГДА КонтактнаяИнформация.Представление
	|			ИНАЧЕ """"
	|		КОНЕЦ) КАК АдресЮридический
	|ПОМЕСТИТЬ КонтИнфа
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контрагент
	|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонКонтактный)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресФактический)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ВЫРАЗИТЬ(КонтактнаяИнформация.Объект КАК Справочник.Контрагенты).Ссылка
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Серия,
	|	ПодтверждающиеДокументы.Номер,
	|	ПодтверждающиеДокументы.ДатаВыдачи,
	|	ПодтверждающиеДокументы.КемВыдан,
	|	ПодтверждающиеДокументы.Владелец КАК Контрагент
	|ПОМЕСТИТЬ ДокументКонтрагента
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Контрагент
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтрагентИнфа.ИНН,
	|	КонтрагентИнфа.КПП,
	|	КонтрагентИнфа.НаименованиеПолное КАК ПолноеНаименование,
