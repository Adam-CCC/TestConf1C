 				КонецЕсли; 
			КонецПопытки; 
		КонецЕсли; 
		
	КонецЕсли;	
	
	//Бондаренко++ 20231207
	//Если Не Проведен ИЛИ Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
	Если Не Проведен ИЛИ Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт ИЛИ ВидРемонта.ТипРемонта=Перечисления.ТипыРемонта.Бесплатный Тогда
