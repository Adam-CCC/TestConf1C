		Модель = ВРег(ЭтотОбъект.Автомобиль.Модель.Наименование);
	Иначе
		Марка = "";
		Модель = "";
	КонецЕсли;	
	ЭтоНиссан = Найти(Модель, "NISSAN") > 0 Или Найти(Марка, "NISSAN") > 0 Или Найти(Модель, "НИССАН") > 0 Или Найти(Марка, "НИССАН") > 0;
	ЭтоХёндэ = Найти(Модель, "HYUNDAI") > 0 Или Найти(Марка, "HYUNDAI") > 0 Или Найти(Модель, "ХЁНДЭ") > 0 Или Найти(Марка, "ХЁНДЭ") > 0;
	ЭтоФорд = Найти(Модель, "FORD") > 0 Или Найти(Марка, "FORD") > 0 Или Найти(Модель, "ФОРД") > 0 Или Найти(Марка, "ФОРД") > 0;
	ЭтоРено = Найти(Модель, "RENAULT") > 0 Или Найти(Марка, "RENAULT") > 0 Или Найти(Модель, "РЕНО") > 0 Или Найти(Марка, "РЕНО") > 0;
	ЭтоДжип = Найти(Модель, "JEEP") > 0 Или Найти(Марка, "JEEP") > 0 Или Найти(Модель, "ДЖИП") > 0 Или Найти(Марка, "ДЖИП") > 0;
	ЭтоФиат = Найти(Модель, "FIAT") > 0 Или Найти(Марка, "FIAT") > 0 Или Найти(Модель, "ФИАТ") > 0 Или Найти(Марка, "ФИАТ") > 0;
	ЭтоSY = Найти(Модель, "SSANG YONG") > 0 Или Найти(Марка, "SSANG YONG") > 0 Или Найти(Модель, "ССАНГ ЙОНГ") > 0 Или Найти(Марка, "ССАНГ ЙОНГ") > 0
			Или Найти(Модель, "SSANGYONG") > 0 Или Найти(Марка, "SSANGYONG") > 0 Или Найти(Модель, "ССАНГЙОНГ") > 0 Или Найти(Марка, "ССАНГЙОНГ") > 0;
	ЭтоЛада = Найти(Модель, "LADA") > 0 Или Найти(Марка, "LADA") > 0 Или Найти(Модель, "ЛАДА") > 0 Или Найти(Марка, "ЛАДА") > 0;
	ЭтоУАЗ = Найти(Модель, "UAZ") > 0 Или Найти(Марка, "UAZ") > 0 Или Найти(Модель, "УАЗ") > 0 Или Найти(Марка, "УАЗ") > 0;
	
	Если ЭтоРено Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаРено");
