	// Доверенность заказчика — при необходимости раскомментируйте:
	// Доверенность = ЭтотОбъект._г_ДоверенностьЗаказчика;
	// ОбластьДанныеЗаказНаряда1.Параметры.НомерДоверенности = Доверенность.Номер;
	// ОбластьДанныеЗаказНаряда1.Параметры.ДатаДоверенности = Формат(Доверенность.ДатаВыдачи, "ДЛФ=D");
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1.Параметры.Дата = Формат(ТекущаяДата(),"ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.Время = Формат(ТекущаяДата(),"ДЛФ=В");	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;
	
КонецФункции //ПечатьАктСдачиПриемкиТС(ТабДокумент)

Функция ПечатьАктВыполненныхРаботДобраяВоляЭкзЧанганМоторРусCHANGAN(ТабДокумент) Экспорт //
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли; 
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Макет = ПолучитьМакет("АктВыполненныхРаботДобраяВоляЭкзЧанганМоторРусCHANGAN");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	//////////////////////////////////////////////////////////////
	// 1. Шапка компании
	//////////////////////////////////////////////////////////////
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	//////////////////////////////////////////////////////////////
	// 2. Номер и дата акта / заказ-наряда
	//////////////////////////////////////////////////////////////
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");

	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	//////////////////////////////////////////////////////////////
	// 3. Приём в ремонт
	//////////////////////////////////////////////////////////////
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	//////////////////////////////////////////////////////////////
	// 4. Владелец / автомобиль / плательщик
	//////////////////////////////////////////////////////////////
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	Модель = Автомобиль.Модель;
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	Контрагент = ЭтотОбъект.Контрагент;
	ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	//////////////////////////////////////////////////////////////
	// 5. Заказчик (с учётом доверенного лица)
	//////////////////////////////////////////////////////////////
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	// Доверенность заказчика — при необходимости раскомментируйте:
	// Доверенность = ЭтотОбъект._г_ДоверенностьЗаказчика;
	// ОбластьДанныеЗаказНаряда1.Параметры.НомерДоверенности = Доверенность.Номер;
	// ОбластьДанныеЗаказНаряда1.Параметры.ДатаДоверенности = Формат(Доверенность.ДатаВыдачи, "ДЛФ=D");
	
	//////////////////////////////////////////////////////////////
	// 6. Вид ремонта и причина обращения
	//////////////////////////////////////////////////////////////
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения  = ЭтотОбъект.ПричинаОбращения;
	ОбластьДанныеЗаказНаряда1.Параметры.ВидРемонта        = ЭтотОбъект.ВидРемонта.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГарантийныйРемонт = ЭтотОбъект.Гарантии;
	
	ТабДокумент.Вывести(ОбластьШапка);
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	//////////////////////////////////////////////////////////////
	// 7. Таблица работ (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.КолВо           = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьРабота.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьРабота.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего; 
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеРабота = ВсегоКОплатеРабота + СтрокаТЧ.СуммаВсего;
		СуммаНДСРабота      = СуммаНДСРабота + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда2.Параметры.ВсегоКОплате = ВсегоКОплатеРабота;
	ОбластьДанныеЗаказНаряда2.Параметры.СуммаНДС      = СуммаНДСРабота;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	//////////////////////////////////////////////////////////////
	// 8. Таблица запчастей (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.Ед              = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		ОбластьЗапчасти.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьЗапчасти.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьЗапчасти.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего; 
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеТовары = ВсегоКОплатеТовары + СтрокаТЧ.СуммаВсего;
		СуммаНДСТовары      = СуммаНДСТовары + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.ВсегоКОплате = ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаНДС      = СуммаНДСТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.Итого         = ВсегоКОплатеРабота + ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаПрописью = обЧислоПрописью(ВсегоКОплатеРабота + ВсегоКОплатеТовары, ВалютаПечатногоДокумента);
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ПустаяОбласть = Макет.ПолучитьОбласть("ПустаяОбласть");
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Плательщик = ЭтотОбъект.Контрагент.Наименование;
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель    = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
    ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;
	
КонецФункции //ПечатьАктВыполненныхРаботДобраяВоляЭкзЧанганРус(ТабДокумент)

Функция ПечатьАктВыполненныхРаботГарЭкзЧанганМоторРусCHANGAN(ТабДокумент) Экспорт //
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя И НЕ ВидРемонта = Справочники.ВидыРемонта.ВосстановительныйРемонт Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Макет = ПолучитьМакет("АктВыполненныхРаботГарЭкзЧанганМоторРусCHANGAN");

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	//////////////////////////////////////////////////////////////
	// 1. Шапка компании
	//////////////////////////////////////////////////////////////
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	//////////////////////////////////////////////////////////////
	// 2. Номер и дата акта / заказ-наряда
	//////////////////////////////////////////////////////////////
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");

	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	//////////////////////////////////////////////////////////////
	// 3. Приём в ремонт
	//////////////////////////////////////////////////////////////
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	//////////////////////////////////////////////////////////////
	// 4. Владелец / автомобиль / плательщик
	//////////////////////////////////////////////////////////////
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	Модель = Автомобиль.Модель;
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	Контрагент = ЭтотОбъект.Контрагент;
	
	//////////////////////////////////////////////////////////////
	// 5. Заказчик (с учётом доверенного лица)
	//////////////////////////////////////////////////////////////
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	// Доверенность заказчика — при необходимости раскомментируйте:
	// Доверенность = ЭтотОбъект._г_ДоверенностьЗаказчика;
	// ОбластьДанныеЗаказНаряда1.Параметры.НомерДоверенности = Доверенность.Номер;
	// ОбластьДанныеЗаказНаряда1.Параметры.ДатаДоверенности = Формат(Доверенность.ДатаВыдачи, "ДЛФ=D");
	
	//////////////////////////////////////////////////////////////
	// 6. Вид ремонта и причина обращения
	//////////////////////////////////////////////////////////////
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения  = ЭтотОбъект.ПричинаОбращения;
	ОбластьДанныеЗаказНаряда1.Параметры.ВидРемонта        = ЭтотОбъект.ВидРемонта.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГарантийныйРемонт = ЭтотОбъект.Гарантии;
	
	ТабДокумент.Вывести(ОбластьШапка);
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	//////////////////////////////////////////////////////////////
	// 7. Таблица работ (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.КолВо           = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьРабота.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьРабота.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего; 
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеРабота = ВсегоКОплатеРабота + СтрокаТЧ.СуммаВсего;
		СуммаНДСРабота      = СуммаНДСРабота + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда2.Параметры.ВсегоКОплате = ВсегоКОплатеРабота;
	ОбластьДанныеЗаказНаряда2.Параметры.СуммаНДС      = СуммаНДСРабота;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	//////////////////////////////////////////////////////////////
	// 8. Таблица запчастей (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.Ед              = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		ОбластьЗапчасти.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьЗапчасти.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьЗапчасти.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего; 
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеТовары = ВсегоКОплатеТовары + СтрокаТЧ.СуммаВсего;
		СуммаНДСТовары      = СуммаНДСТовары + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.ВсегоКОплате = ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаНДС      = СуммаНДСТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.Итого         = ВсегоКОплатеРабота + ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаПрописью = обЧислоПрописью(ВсегоКОплатеРабота + ВсегоКОплатеТовары, ВалютаПечатногоДокумента);
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ПустаяОбласть = Макет.ПолучитьОбласть("ПустаяОбласть");
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель    = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
    ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьРабочийЛистCHANGAN(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Макет = ПолучитьМакет("РабочийЛистCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	//////////////////////////////////////////////////////////////
	// 1. Шапка компании
	//////////////////////////////////////////////////////////////
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);	
	
	
	//////////////////////////////////////////////////////////////
	// 2. Номер и дата акта / заказ-наряда
	//////////////////////////////////////////////////////////////
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");

	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	//////////////////////////////////////////////////////////////
	// 3. Приём в ремонт
	//////////////////////////////////////////////////////////////
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	ОбластьДанныеЗаказНаряда1.Параметры.ПланируемаяДатаВыдачи = ЭтотОбъект.ПлановаяДатаВыдачи;
	
	
	//////////////////////////////////////////////////////////////
	// 4. Владелец / автомобиль / плательщик
	//////////////////////////////////////////////////////////////
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	Модель = Автомобиль.Модель;
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	Контрагент = ЭтотОбъект.Контрагент;
	
	//////////////////////////////////////////////////////////////
	// 5. Заказчик (с учётом доверенного лица)
	//////////////////////////////////////////////////////////////
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ВидРемонта = ВидРемонта.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли; 
	
	// Доверенность заказчика — при необходимости раскомментируйте:
	// Доверенность = ЭтотОбъект._г_ДоверенностьЗаказчика;
	// ОбластьДанныеЗаказНаряда1.Параметры.НомерДоверенности = Доверенность.Номер;
	// ОбластьДанныеЗаказНаряда1.Параметры.ДатаДоверенности = Формат(Доверенность.ДатаВыдачи, "ДЛФ=D");
	
	//////////////////////////////////////////////////////////////
	// 6. Вид ремонта и причина обращения
	//////////////////////////////////////////////////////////////
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения  = ЭтотОбъект.ПричинаОбращения;
		
	ТабДокумент.Вывести(ОбластьШапка);
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	//////////////////////////////////////////////////////////////
	// 7. Таблица работ (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.Нормочасы = СтрокаТЧ.Коэффициент;
		Для Каждого СтрокаИсполнитель Из Исполнители Цикл 
			Если СтрокаТЧ.ИдентификаторРаботы = СтрокаИсполнитель.ИдентификаторРаботы Тогда
				ОбластьРабота.Параметры.Исполнитель = СтрокаИсполнитель.Исполнитель; // Примечание!! тут сопоставляется id работы и id работы из списка исполнителей, если в списке работ есть два элемента с одинаковыми id но с разными исполнителями, то выберет первого исполнителя
			КонецЕсли;	
		КонецЦикла;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	//////////////////////////////////////////////////////////////
	// 8. Таблица запчастей (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул = СтрокаТЧ.Номенклатура.Артикул;
		ОбластьЗапчасти.Параметры.Наименование = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.Ед = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо = СтрокаТЧ.Количество;   
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	
	ПустаяОбласть = Макет.ПолучитьОбласть("ПустаяОбласть");
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ПустаяОбласть = Макет.ПолучитьОбласть("ПустаяОбласть");
    ТабДокумент.Вывести(ПустаяОбласть);
	
	ОбластьДанныеЗаказНаряда4.Параметры.МастерЦеха = ЭтотОбъект.Мастер;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаВРаботе = ДатаНачала;
    ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьЗаказНарядДобраяВоляЭкзЧанганМоторсРусCHANGAN(ТабДокумент) Экспорт
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ЗаказНарядДобраяВоляЭкзЧанганМоторсРусCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=ДВ");
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.КолВо           = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьРабота.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьРабота.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеРабота = ВсегоКОплатеРабота + СтрокаТЧ.СуммаВсего;
		СуммаНДСРабота      = СуммаНДСРабота + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда2.Параметры.ВсегоКОплате = ВсегоКОплатеРабота;
	ОбластьДанныеЗаказНаряда2.Параметры.СуммаНДС      = СуммаНДСРабота;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.Ед              = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		ОбластьЗапчасти.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьЗапчасти.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьЗапчасти.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеТовары = ВсегоКОплатеТовары + СтрокаТЧ.СуммаВсего;
		СуммаНДСТовары      = СуммаНДСТовары + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.ВсегоКОплате = ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаНДС      = СуммаНДСТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.Итого         = ВсегоКОплатеРабота + ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаПрописью = обЧислоПрописью(ВсегоКОплатеРабота + ВсегоКОплатеТовары, ВалютаПечатногоДокумента);
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации  = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 3 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 7 И КолВоЭлТЧ <= 10 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.Плательщик    = Контрагент.Наименование;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	//////////////////////////////////////////////////////////////
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьШапкаСтр2 = Макет.ПолучитьОбласть("Стр2Шапка");
	
	ОбластьШапкаСтр2.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапкаСтр2.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапкаСтр2.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапкаСтр2.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапкаСтр2.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	ТабДокумент.Вывести(ОбластьШапкаСтр2);
	
	Стр2ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда1");
	Стр2ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда2");

	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);
	
	Стр2ОбластьПусто = Макет.ПолучитьОбласть("Стр2ПустаяОблаcть");  
	Счетчик = 0;
	Пока Счетчик <> 3 Цикл
		ТабДокумент.Вывести(ОбластьПусто);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Плательщик = Контрагент.Наименование;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда2);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
	
КонецФункции //ПечатьЗаказНарядДобраяВоляЭкзЧанганМоторсРус(ТабДокумент)

Функция ПечатьЗаказНарядГарКлиентДилерCHANGAN(ТабДокумент) Экспорт
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя И НЕ ВидРемонта = Справочники.ВидыРемонта.ВосстановительныйРемонт Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;  
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ЗаказНарядГарКлиентДилерCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=ДВ");
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.Нормочасы           = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.КолвоОпераций       = СтрокаТЧ.Количество;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.ЕдИзм           = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации  = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 3 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 7 И КолВоЭлТЧ <= 10 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	//////////////////////////////////////////////////////////////
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьШапкаСтр2 = Макет.ПолучитьОбласть("Стр2Шапка"); 
	
	ОбластьШапкаСтр2.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапкаСтр2.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапкаСтр2.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапкаСтр2.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапкаСтр2.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	ТабДокумент.Вывести(ОбластьШапкаСтр2);
	
	Стр2ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда1");
	Стр2ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда2");

	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);
	
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда2);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
	
КонецФункции //ПечатьЗаказНарядДобраяВоляЭкзЧанганМоторсРус(ТабДокумент)

Функция ПечатьЗаказНарядКлиентДилерCHANGAN(ТабДокумент) Экспорт
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ЗаказНарядКлиентДилерCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=ДВ");
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.Нормочасы           = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.КолвоОпераций       = СтрокаТЧ.Количество;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.ЕдИзм           = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации  = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 3 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 7 И КолВоЭлТЧ <= 10 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	//////////////////////////////////////////////////////////////
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьШапкаСтр2 = Макет.ПолучитьОбласть("Стр2Шапка"); 
	
	ОбластьШапкаСтр2.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапкаСтр2.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапкаСтр2.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапкаСтр2.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапкаСтр2.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	ТабДокумент.Вывести(ОбластьШапкаСтр2);
	
	Стр2ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда1");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик    = ЭтотОбъект.Заказчик; 
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
	
КонецФункции //ПечатьЗаказНарядДобраяВоляЭкзЧанганМоторсРус(ТабДокумент)

Функция ПечатьЗаказНарядCHANGAN(ТабДокумент) Экспорт
	
	Если НЕ Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда 
		Сообщить("Заказ-наряд не закрыт!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли; 
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ЗаказНарядCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=ДВ");
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.Нормочасы       = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.Скидка          = СтрокаТЧ.СуммаСкидки;
		ОбластьРабота.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьРабота.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьРабота.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеРабота = ВсегоКОплатеРабота + СтрокаТЧ.СуммаВсего;
		СуммаНДСРабота      = СуммаНДСРабота + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда2.Параметры.ВсегоКОплате = ВсегоКОплатеРабота;
	ОбластьДанныеЗаказНаряда2.Параметры.СуммаНДС      = СуммаНДСРабота;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	//////////////////////////////////////////////////////////////
	// 8. Таблица запчастей (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Коэффициент;
		ОбластьЗапчасти.Параметры.Скидка          = СтрокаТЧ.СуммаСкидки;
		ОбластьЗапчасти.Параметры.Ед              = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьЗапчасти.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьЗапчасти.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего; 
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеТовары = ВсегоКОплатеТовары + СтрокаТЧ.СуммаВсего;
		СуммаНДСТовары      = СуммаНДСТовары + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.ВсегоКОплате = ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаНДС      = СуммаНДСТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.Итого         = ВсегоКОплатеРабота + ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаПрописью = обЧислоПрописью(ВсегоКОплатеРабота + ВсегоКОплатеТовары, ВалютаПечатногоДокумента);
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации  = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 3 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 7 И КолВоЭлТЧ <= 10 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	ОбластьДанныеЗаказНаряда4.Параметры.Плательщик = ЭтотОбъект.Контрагент;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	//////////////////////////////////////////////////////////////
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьШапкаСтр2 = Макет.ПолучитьОбласть("Стр2Шапка");
	
	ОбластьШапкаСтр2.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапкаСтр2.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапкаСтр2.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапкаСтр2.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапкаСтр2.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	ТабДокумент.Вывести(ОбластьШапкаСтр2);
	
	Стр2ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда1");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = ЭтотОбъект.Контрагент; 
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
	
КонецФункции //ПечатьЗаказНарядCHANGAN  

Функция ПечатьЗаказНарядКлиентДобраяВоляCHANGAN(ТабДокумент) Экспорт 
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
		
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ЗаказНарядКлиентДобраяВоляCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер); 
	ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=ДВ");
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.Нормочасы           = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.КолвоОпераций       = СтрокаТЧ.Количество;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.ЕдИзм           = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации  = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 3 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла; 	
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 7 И КолВоЭлТЧ <= 10 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	ОбластьДанныеЗаказНаряда4.Параметры.Плательщик = ЭтотОбъект.Контрагент;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	////////////////////////////////////////////////////////////// 
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьШапкаСтр2 = Макет.ПолучитьОбласть("Стр2Шапка"); 
	
	ОбластьШапкаСтр2.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапкаСтр2.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапкаСтр2.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапкаСтр2.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапкаСтр2.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапкаСтр2);
	
	Стр2ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда1");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
		
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = ЭтотОбъект.Контрагент;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);

	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
КонецФункции

Функция ПечатьЗаказНарядЭкзЧанганМоторсРусCHANGAN(ТабДокумент) Экспорт
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ЗаказНарядЭкзЧанганМоторсРусCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=ДВ");
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.КолВо           = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьРабота.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьРабота.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеРабота = ВсегоКОплатеРабота + СтрокаТЧ.СуммаВсего;
		СуммаНДСРабота      = СуммаНДСРабота + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда2.Параметры.ВсегоКОплате = ВсегоКОплатеРабота;
	ОбластьДанныеЗаказНаряда2.Параметры.СуммаНДС      = СуммаНДСРабота;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.Ед              = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		ОбластьЗапчасти.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьЗапчасти.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьЗапчасти.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеТовары = ВсегоКОплатеТовары + СтрокаТЧ.СуммаВсего;
		СуммаНДСТовары      = СуммаНДСТовары + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.ВсегоКОплате = ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаНДС      = СуммаНДСТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.Итого         = ВсегоКОплатеРабота + ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаПрописью = обЧислоПрописью(ВсегоКОплатеРабота + ВсегоКОплатеТовары, ВалютаПечатногоДокумента);
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации  = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 3 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 3 И КолВоЭлТЧ <= 6 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 2 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	ИначеЕсли КолВоЭлТЧ >= 7 И КолВоЭлТЧ <= 10 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	//////////////////////////////////////////////////////////////
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьШапкаСтр2 = Макет.ПолучитьОбласть("Стр2Шапка");
	
	ОбластьШапкаСтр2.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапкаСтр2.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапкаСтр2.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапкаСтр2.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапкаСтр2.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	ТабДокумент.Вывести(ОбластьШапкаСтр2);
	
	Стр2ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда1");
	Стр2ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда2");

	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);
	
	Стр2ОбластьПусто = Макет.ПолучитьОбласть("Стр2ПустаяОблаcть");  
	Счетчик = 0;
	Пока Счетчик <> 3 Цикл
		ТабДокумент.Вывести(ОбластьПусто);
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда2);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
	
КонецФункции //ПечатьЗаказНарядЭкзЧанганМоторсРусCHANGAN

Функция ПечатьЗаказНарядКоммерцияCHANGAN(ТабДокумент) Экспорт
	
	Если НЕ Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда 
		Сообщить("Заказ-наряд не закрыт!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ЗаказНарядКоммерцияCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=ДВ");
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.Нормочасы       = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.Скидка          = СтрокаТЧ.СуммаСкидки;
		ОбластьРабота.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьРабота.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьРабота.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеРабота = ВсегоКОплатеРабота + СтрокаТЧ.СуммаВсего;
		СуммаНДСРабота      = СуммаНДСРабота + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда2.Параметры.ВсегоКОплате = ВсегоКОплатеРабота;
	ОбластьДанныеЗаказНаряда2.Параметры.СуммаНДС      = СуммаНДСРабота;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	//////////////////////////////////////////////////////////////
	// 8. Таблица запчастей (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		ОбластьЗапчасти.Параметры.Скидка          = СтрокаТЧ.СуммаСкидки;
		ОбластьЗапчасти.Параметры.Ед              = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьЗапчасти.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьЗапчасти.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего; 
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеТовары = ВсегоКОплатеТовары + СтрокаТЧ.СуммаВсего;
		СуммаНДСТовары      = СуммаНДСТовары + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	ОбластьДанныеЗаказНаряда3.Параметры.ВсегоКОплате = ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаНДС      = СуммаНДСТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.Итого         = ВсегоКОплатеРабота + ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаПрописью = обЧислоПрописью(ВсегоКОплатеРабота + ВсегоКОплатеТовары, ВалютаПечатногоДокумента);
	ОбластьДанныеЗаказНаряда3.Параметры.Рекомендации  = ЭтотОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);                             
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	ОбластьДанныеЗаказНаряда4.Параметры.Плательщик = ЭтотОбъект.Контрагент;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	//////////////////////////////////////////////////////////////
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьШапкаСтр2 = Макет.ПолучитьОбласть("Стр2Шапка");
	
	ОбластьШапкаСтр2.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапкаСтр2.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапкаСтр2.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапкаСтр2.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапкаСтр2.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	
	ТабДокумент.Вывести(ОбластьШапкаСтр2);
	
	Стр2ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда1");
	Стр2ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("Стр2ДанныеЗаказНаряда2");

	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Плательщик = Контрагент.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресПлательщика = киПолучитьПредставлениеКИ(Контрагент, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.РеквизитыПлательщика = Контрагент.ИНН;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);
	
	Стр2ОбластьПусто = Макет.ПолучитьОбласть("Стр2ПустаяОблаcть"); 
	
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.Плательщик = ЭтотОбъект.Контрагент;
	Стр2ОбластьДанныеЗаказНаряда2.Параметры.ДатаЗакрытия = ДатаЗакрытия;
	
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда2);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
КонецФункции //ПечатьЗаказНарядКоммерцияCHANGAN

Функция ПечатьПредварительныйЗаказНарядCHANGAN(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ВалютаПечатногоДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Владелец_ = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
		Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Контрагент = ЭтотОбъект.Контрагент;
	Модель = Автомобиль.Модель;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ПробегСтрока = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ПробегСтрока = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	
	ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонВладельца) Тогда
		ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(АдресВладельца) Тогда
		АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(EmailВладельца) Тогда
		EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ТелефонЗаказчика) Тогда
		ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 1
	//////////////////////////////////////////////////////////////
	
	Макет = ПолучитьМакет("ПредварительныйЗаказНарядCHANGAN");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	Подразделение = ЭтотОбъект.ПодразделениеКомпании;
	Организация   = ЭтотОбъект.Организация;
	
	ОбластьШапка.Параметры.НаименованиеДЦ = Подразделение.Наименование;
	ОбластьШапка.Параметры.ФактАдрес      = киПолучитьПредставлениеКИ(Подразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ЮрАдрес        = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ИННКППОГРН     = Организация.ИНН + " / " + Подразделение.КПП + " / " + Организация.ОГРН;
	ОбластьШапка.Параметры.Контакты       = киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий) + " " + киПолучитьПредставлениеКИ(Организация.КонтрагентОрганизации, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДанныеЗаказНаряда1 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда1");
	ОбластьДанныеЗаказНаряда2 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда2");
	ОбластьДанныеЗаказНаряда3 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда3");
	ОбластьДанныеЗаказНаряда4 = Макет.ПолучитьОбласть("ДанныеЗаказНаряда4");
	
	ОбластьДанныеЗаказНаряда1.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаДокумента  = Формат(ЭтотОбъект.Дата, "ДЛФ=Д");
	
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаПриема  = Формат(ДатаМашинозаезда, "ДФ=dd.MM.yyyy");
	ОбластьДанныеЗаказНаряда1.Параметры.ВремяПриема = Формат(ДатаМашинозаезда, "ДФ=ЧЧ:мм");
	
	ОбластьДанныеЗаказНаряда1.Параметры.Владелец = Владелец_.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = EmailВладельца;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = ГосНомер;
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	ОбластьДанныеЗаказНаряда1.Параметры.Пробег = ПробегСтрока;
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;	
	ОбластьДанныеЗаказНаряда1.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения; 
	ОбластьДанныеЗаказНаряда1.Параметры.ПлановаяДатаИвремяВыдачи = ЭтотОбъект.ПлановаяДатаВыдачи;
	
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда1);
	
	ОбластьРабота = Макет.ПолучитьОбласть("Работы");
	ВсегоКОплатеРабота = 0;
	СуммаНДСРабота = 0;
	КолВоЭлТЧ = 0;
	Для Каждого СтрокаТЧ Из Работы Цикл
		ОбластьРабота.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьРабота.Параметры.НомерОперации   = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Работа.Артикул), СтрокаТЧ.Работа.Код, СтрокаТЧ.Работа.Артикул);
		ОбластьРабота.Параметры.НаименованиеРаботы = СтрокаТЧ.Работа.Наименование;
		ОбластьРабота.Параметры.Нормочасы       = СтрокаТЧ.Коэффициент;
		ОбластьРабота.Параметры.Скидка          = СтрокаТЧ.СуммаСкидки;
		ОбластьРабота.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьРабота.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьРабота.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего;
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеРабота = ВсегоКОплатеРабота + СтрокаТЧ.СуммаВсего;
		СуммаНДСРабота      = СуммаНДСРабота + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьРабота);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда2.Параметры.ВсегоКОплате = ВсегоКОплатеРабота;
	ОбластьДанныеЗаказНаряда2.Параметры.СуммаНДС      = СуммаНДСРабота;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда2);
	
	//////////////////////////////////////////////////////////////
	// 8. Таблица запчастей (с суммами и НДС)
	//////////////////////////////////////////////////////////////
	
	ОбластьЗапчасти = Макет.ПолучитьОбласть("Запчасти");
	ВсегоКОплатеТовары = 0;
	СуммаНДСТовары = 0;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		ОбластьЗапчасти.Параметры.НомерПорядковый = СтрокаТЧ.НомерСтроки;
		ОбластьЗапчасти.Параметры.Артикул         = ?(обЗначениеНеЗаполнено(СтрокаТЧ.Номенклатура.Артикул), СтрокаТЧ.Номенклатура.Код, СтрокаТЧ.Номенклатура.Артикул);
		ОбластьЗапчасти.Параметры.Наименование    = СтрокаТЧ.Номенклатура;
		ОбластьЗапчасти.Параметры.КолВо           = СтрокаТЧ.Количество;
		ОбластьЗапчасти.Параметры.Скидка          = СтрокаТЧ.СуммаСкидки;
		ОбластьЗапчасти.Параметры.Ед              = СтрокаТЧ.ЕдиницаИзмерения;
		ОбластьЗапчасти.Параметры.Стоимость       = СтрокаТЧ.Цена;
		ОбластьЗапчасти.Параметры.НДС             = СтрокаТЧ.СуммаНДС;
		ОбластьЗапчасти.Параметры.ВсегоСНДС       = СтрокаТЧ.СуммаВсего; 
		КолВоЭлТЧ = КолВоЭлТЧ + 1;
		ВсегоКОплатеТовары = ВсегоКОплатеТовары + СтрокаТЧ.СуммаВсего;
		СуммаНДСТовары      = СуммаНДСТовары + СтрокаТЧ.СуммаНДС;
		ТабДокумент.Вывести(ОбластьЗапчасти);
	КонецЦикла;
	
	ОбластьДанныеЗаказНаряда3.Параметры.ВсегоКОплате = ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаНДС      = СуммаНДСТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.Итого         = ВсегоКОплатеРабота + ВсегоКОплатеТовары;
	ОбластьДанныеЗаказНаряда3.Параметры.СуммаПрописью = обЧислоПрописью(ВсегоКОплатеРабота + ВсегоКОплатеТовары, ВалютаПечатногоДокумента);
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда3);
	
	ОбластьПусто = Макет.ПолучитьОбласть("ПустаяОбласть"); 
	Если КолВоЭлТЧ = 1 Или КолВоЭлТЧ = 2 Тогда 
		Счетчик = 0;
		Пока Счетчик <> 1 Цикл
			ТабДокумент.Вывести(ОбластьПусто);
			Счетчик = Счетчик + 1;
		КонецЦикла;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда4.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	ОбластьДанныеЗаказНаряда4.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	ОбластьДанныеЗаказНаряда4.Параметры.ДатаВРаботе = ДатаНачала;
	ТабДокумент.Вывести(ОбластьДанныеЗаказНаряда4);
	
	//////////////////////////////////////////////////////////////
	// СТРАНИЦА 2
	//////////////////////////////////////////////////////////////
