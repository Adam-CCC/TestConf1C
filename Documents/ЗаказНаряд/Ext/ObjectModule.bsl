 	//Бондаренко++ 20230901
	#Если Клиент Тогда 
	//СМГ_ЗаменаВидаРемонтаДляБУ();	
	НадоМенять = Ложь;
	Если обЗначениеНеЗаполнено(Дата) Тогда
