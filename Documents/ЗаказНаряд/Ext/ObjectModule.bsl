Функция СМГ_ВидРемонта(Основание)
	
	ВидРемонтаТек = ВидРемонта;
	
	Если ТипЗНЧ(Основание) = Тип("ДокументСсылка.КомплектацияАвтомобиля") Тогда
		Если Основание.ВидРемонта =Справочники.ВидыРемонта.КомплектацияАвтомобиля Тогда
			ВидРемонтаТек = Справочники.ВидыРемонта.ДополнительноеОборудование;					
 		КонецЕсли;	
	КонецЕсли;
	
	//Бондаренко++ 20231129
	Если ТипЗНЧ(Основание) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
		ВидРемонтаТек = Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером;
		//Бондаренко++ 20240320
		Если НЕ обЗначениеНеЗаполнено(Организация) Тогда
			Заказчик_ = Организация.КонтрагентОрганизации;
			Если НЕ обЗначениеНеЗаполнено(Заказчик_) Тогда
				Если Заказчик <> Заказчик_ Тогда
					Заказчик = Заказчик_;
 				КонецЕсли;	
 			КонецЕсли;
		КонецЕсли;
		//Бондаренко-- 20240320
	КонецЕсли;
	//Бондаренко-- 20231129
	
	Возврат ВидРемонтаТек;

КонецФункции // СМГ_ВидРемонта(Основание)
