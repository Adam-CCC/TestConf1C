Функция ПечатьЗаявкаКолористу(ТабДокумент) Экспорт 

	Макет = ПолучитьМакет("ЗаявкаКолористу");
	
	НомерЗаказНаряда = дкПолучитьНомерДляПечати(ЭтотОбъект);
	
	//Вывод шапки документа
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");   
	ОбластьМакета.Параметры.НомерЗаказНаряда = НомерЗаказНаряда; 
	ОбластьМакета.Параметры.МаркаМодель = Автомобиль.Модель;
	ОбластьМакета.Параметры.ВинНомер = Автомобиль.VIN; 
