	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.EmailВладельца = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	Модель = Автомобиль.Модель;
	ОбластьДанныеЗаказНаряда1.Параметры.Марка  = Модель.Марка.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.Модель = Модель.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	ОбластьДанныеЗаказНаряда1.Параметры.VIN = Автомобиль.VIN;
	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ОбластьДанныеЗаказНаряда1.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, ФорматПредставленияГодаВыпускаАвтомобиля);
	ОбластьДанныеЗаказНаряда1.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии, "ДЛФ=Д");
	ОбластьДанныеЗаказНаряда1.Параметры.СервисныйКонсультант = ФИО_(ЭтотОбъект.Диспетчер);
	
	//////////////////////////////////////////////////////////////
	// 5. Заказчик (с учётом доверенного лица)
	//////////////////////////////////////////////////////////////
	
	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
			Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
		Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика) Тогда
		ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
