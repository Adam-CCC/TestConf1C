Функция СформироватьПерепродажи(ВопросОПеремещении=Истина) Экспорт
	
	#Если Клиент Тогда
	Если ЭтотОбъект.Ссылка.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен 
		ИЛИ ЭтотОбъект.Ссылка.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
		Сообщить("Перепродажи по закрытому или выполненному заказ-наряду недопустимы.");
		Возврат Ложь;
	КонецЕсли; 
	
	Если Вопрос("Сформировать Перепродажи по заказ-наряду ?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НоваяРеализация=Документы.РеализацияТоваров.СоздатьДокумент();
	НоваяРеализация.Заполнить(Ссылка);
	НоваяРеализация=НоваяРеализация.ПолучитьФорму();
	Отказ=Ложь;
	СтандартнаяОбработка=Истина;
	зфФормаПередОткрытием(НоваяРеализация,Отказ,СтандартнаяОбработка);
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли; 
 	
	Возврат Ложь;
	#КонецЕсли

	
КонецФункции	

