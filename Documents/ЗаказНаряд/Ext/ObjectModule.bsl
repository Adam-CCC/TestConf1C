	Выборка = ЗапросЗаполнениеДОПиПП.Выполнить().Выбрать();	
	НаборЗаписей = РегистрыСведений.СебестоимостьЦенаПродажиДОП_и_ПП.СоздатьНаборЗаписей();
	
	Пока Выборка.Следующий() Цикл    
		
		Если Выборка.ЕстьЗаписьРС Тогда
			НаборКоррЗаписей = РегистрыСведений.СебестоимостьЦенаПродажиДОП_и_ПП.СоздатьНаборЗаписей();
			
			НаборКоррЗаписей.Отбор.РЛ_1С.Установить(Выборка.РЛ);
			НаборКоррЗаписей.Отбор.Документ_1С.Установить(Выборка.ЗН); 
			НаборКоррЗаписей.Отбор.Автомобиль_1С.Установить(Выборка.Автомобиль);
			НаборКоррЗаписей.Отбор.Номенклатура_1С.Установить(Выборка.Номенклатура); 
			
			НаборКоррЗаписей.Прочитать();
			
			Для Каждого Запись из НаборКоррЗаписей Цикл 
				Запись.Актуальность = Ложь;
			КонецЦикла;
			
			НаборКоррЗаписей.Записать();
		КонецЕсли;  
		
		НоваяЗапись = НаборЗаписей.Добавить();
		
		НоваяЗапись.Период = ТекущаяДата(); 
		
		НоваяЗапись.РЛ_1С = Выборка.РЛ;
		НоваяЗапись.GUID_РЛ = ?(Выборка.РЛ = NULL, "", Строка(Выборка.РЛ.УникальныйИдентификатор()));
		НоваяЗапись.Документ_1С = Выборка.ЗН;
		НоваяЗапись.Дата = Выборка.ЗН.ДатаНачала;
		НоваяЗапись.Номер = СокрЛП(Выборка.ЗН.Номер);
		НоваяЗапись.ТипДокумента = ТипЗнч(Выборка.ЗН);
		НоваяЗапись.Автомобиль_1С = Выборка.Автомобиль;
		НоваяЗапись.VIN_Автомобиля = СокрЛП(Выборка.Автомобиль.VIN);
		НоваяЗапись.Номенклатура_1С = Выборка.Номенклатура;
		НоваяЗапись.НаименованиеНоменклатуры = СокрЛП(Выборка.Номенклатура.Наименование);   
		
		НоваяЗапись.Количество = Выборка.Количество;
		НоваяЗапись.Себестоимость = Выборка.Себестоимость;
		НоваяЗапись.ЦенаПродажи = Выборка.ЦенаПродажи;
		НоваяЗапись.В_тч_НДС = Выборка.В_тч_НДС;
		НоваяЗапись.Наценка = Выборка.Наценка;  
		
		НоваяЗапись.ВидРемонта = Выборка.ВидРемонта;
		НоваяЗапись.ВидСтроки = Выборка.ВидСтроки; 
		
		НоваяЗапись.Актуальность = Истина;  		
	КонецЦикла;
	
	Если НаборЗаписей.Количество() > 0 Тогда
		
		Попытка
			НаборЗаписей.Записать(Ложь);	
		Исключение
		КонецПопытки;   
		
	КонецЕсли;
	//Иванченко 20260406 --
	
	Итог_Структура =Модуль_ГВС.Присутствие_Маркированная_Номенклатура(Товары);
	
	Если Итог_Структура.Маркировка_Присутствует Тогда 
		СМГ_Н_Списание_Маркировки(Отказ); 
	КонецЕсли;
 	
	Если Состояние<>Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
		//Для состояния выполнен требуется очистка движений
		ОчиститьДвиженияДокумента();
	КонецЕсли;
	
	//++ Галактонов 
	Если Не Отказ Тогда
		 Если Заказчик <> Контрагент 
			И Контрагент <> Справочники.Контрагенты.ПустаяСсылка()
			И Заказчик.ФормаСобственности <> Контрагент.ФормаСобственности
			И Заказчик.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо
			И Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо  Тогда
			Сообщить("Физлицо не может являться плательщиком для юр лица");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	//-- Галактонов
КонецПроцедуры // ОбработкаПроведения

