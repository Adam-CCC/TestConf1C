Функция ПечатьЭксидКартаТО(ТабДокумент) Экспорт

	Если ВидРемонта = Справочники.ВидыРемонта.ДиагностикаТрейдИн Тогда   
		ДиагностическаяКартаTradein(ТабДокумент);	
		Возврат ТабДокумент;	
	ИначеЕсли ВидРемонта = Справочники.ВидыРемонта.ПредпродажнаяПодготовка Тогда
		ПаспортПредпродажнойПодготовки(ТабДокумент); 
		Возврат ТабДокумент;
	ИначеЕсли ВидРемонта = Справочники.ВидыРемонта.ТехническоеОбслуживание ИЛИ
		      ВидРемонта = Справочники.ВидыРемонта.ТехническоеОбслуживаниеБесплатное ИЛИ
			  ВидРемонта = Справочники.ВидыРемонта.ТО_нольПлатный ИЛИ
			  ВидРемонта = Справочники.ВидыРемонта.ТО_ноль Тогда 
		КартаТехническогоОбслуживания(ТабДокумент);
		Возврат ТабДокумент;
	Иначе
		Сообщить("Для данного вида ремонта нет печатной формы.");
	КонецЕсли;
	
КонецФункции  

Процедура ПаспортПредпродажнойПодготовки(ТабДокумент)
	
	Макет = ПолучитьМакет("ЭксидПаспортПредпродажнойПодготовки");
	Макет.Параметры.ВИН    = Автомобиль.VIN; 
	Макет.Параметры.Модель = Автомобиль.Модель; 
	ТабДокумент.Вывести(Макет);
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		
КонецПроцедуры 

Процедура КартаТехническогоОбслуживания(ТабДокумент)
	
	Макет = ПолучитьМакет("ЭксидКартаТехническогоОбслуживания");
	Макет.Параметры.НомерЗаказа				= Номер; 
	Макет.Параметры.НомернойЗнак			= Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	Макет.Параметры.ПостановкаНаГарантию	= Формат(Автомобиль.ДатаНачалаГарантии,"ДФ=dd.MM.yyyy"); 
	Макет.Параметры.Вин						= Автомобиль.VIN;
	Макет.Параметры.Пробег					= Пробег; 
	//Макет.Параметры.Приемщик				= ДокументОбъект;
	Макет.Параметры.Модель					= Автомобиль.Модель;
	//Макет.Параметры.МодельныйГод			= ДокументОбъект; 
	Макет.Параметры.Дата					= Дата;
	ТабДокумент.Вывести(Макет);
		
КонецПроцедуры   

Процедура ДиагностическаяКартаTradein(ТабДокумент)
	
	Макет = ПолучитьМакет("ЭксидДиагностическаяКартаTradein");
	Макет.Параметры.Марка		= Автомобиль.Модель.Марка; 
	Макет.Параметры.Модель		= Автомобиль.Модель;
	Макет.Параметры.Вин			= Автомобиль.VIN; 
	Макет.Параметры.ГодВыпуска	= Формат(Автомобиль.ГодВыпуска,"ДФ=dd.MM.yyyy");
	Макет.Параметры.Пробег		= Пробег; 
	Макет.Параметры.РегНомер	= Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	ТабДокумент.Вывести(Макет);
		
КонецПроцедуры
