	Для Каждого Строка Из СтруктураДопДанных Цикл
		СтрокаДопДанных.Параметры.НазваниеДополнения = Строка.Ключ    ;
		СтрокаДопДанных.Параметры.ЗначениеДополнения = Строка.Значение;
