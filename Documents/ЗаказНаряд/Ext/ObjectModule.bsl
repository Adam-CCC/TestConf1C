Функция КонтактнаяИнформация(Объект, Вид)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Вид = &Вид
	|	И КонтактнаяИнформация.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Вид", Вид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Представление;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

Функция ПечатьЕДОСАктВыпРаботКузовнойРемонт(ТабДокумент) Экспорт
	
	НадоПроверять = ЭтотОбъект.Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт;
	Если НадоПроверять И ЭтотОбъект.ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Автолига Тогда
		НадоПроверять = ЭтотОбъект.Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен;
	КонецЕсли;	
	Если НадоПроверять И НЕ ЭтотОбъект.ВидРемонта=Справочники.ВидыРемонта.НайтиПоНаименованию("Кузовной ремонт") Тогда
		Если НЕ обПраво("ПечатьЗаказНарядаБезЗакрытия", Права) Тогда  
				//Право ПечатьЗаказНарядаБезЗакрытия #41483
 				Предупреждение("ОШИБКА! Печать незакрытого заказ-наряда запрещена!",, Строка(ЭтотОбъект.Ссылка));
				Возврат Неопределено;
			КонецЕсли; 
		КонецЕсли;
		
	
	Если НЕ обПраво("ПечатьЗаказНарядаПриНаличииОткрытых",Права) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказНаряд.Ссылка) КАК Количество
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|ГДЕ
		|	ЗаказНаряд.Проведен = ЛОЖЬ И ЗаказНаряд.ПометкаУдаления = ЛОЖЬ И
		|	ЗаказНаряд.Заказчик = &Заказчик И
		|	ЗаказНаряд.Ссылка <> &ЭтотДокумент";
		Запрос.УстановитьПараметр("Заказчик",ЭтотОбъект.Заказчик);
		Запрос.УстановитьПараметр("ЭтотДокумент",ЭтотОбъект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.Количество>0 Тогда
				Сообщить("Печать заказ-наряда заказчика "+ЭтотОбъект.Заказчик.НаименованиеПолное+" запрещено, так как у него имеются другие открытые заказ-наряды.");
				Возврат Неопределено;
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли; 
		
	ВалютаПечатногоДокумента=Справочники.Валюты.НайтиПоКоду("643");
	Если ВалютаПечатногоДокумента=Неопределено Тогда Возврат Неопределено; КонецЕсли; 
	ТаблицаТоваров=ЭтотОбъект.Товары.Выгрузить();
	зфПерерасчетТаблицыТоваров(ТаблицаТоваров,ЭтотОбъект,ВалютаПечатногоДокумента);
	ТаблицаРабот=ЭтотОбъект.Работы.Выгрузить();
	зфПерерасчетТаблицыТоваров(ТаблицаРабот,ЭтотОбъект,ВалютаПечатногоДокумента,Истина);
		
	Макет = ПолучитьМакет("ЕДОСАктВыполненныхРаботКузовнойРемонт");
		
	ЕстьСкидкаПоДеталям = Ложь;
	Если ЭтотОбъект.Товары.Итог("СуммаСкидки") <> 0 Тогда
		ЕстьСкидкаПоДеталям = Истина;
	КонецЕсли;
		
	ЕстьСкидкаПоРаботам = Ложь;
	Если ЭтотОбъект.Работы.Итог("СуммаСкидки") <> 0 Тогда
		ЕстьСкидкаПоРаботам = Истина;
	КонецЕсли;
		
	//зададим параметры макета
	ТабДокумент.ПолеСверху = 0;
	ТабДокумент.ПолеСлева  = 0;
	ТабДокумент.ПолеСнизу  = 0;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ТолькоПросмотр = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		
	ОбластьСкидка = Макет.Область("Скидка");
		
	ОбластьУслуги = Макет.ПолучитьОбласть("Услуги");
	ОбластьДетали = Макет.ПолучитьОбласть("Детали");
		
	ОбластьСтрокаДеталей	        = Макет.ПолучитьОбласть("СтрокаДеталей");
	ОбластьИтоговПоСтраницеДетали	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталей");
	ОбластьПодвалДеталей	        = Макет.ПолучитьОбласть("ПодвалДетали");
		
	ОбластьСтрокаУслуг		        = Макет.ПолучитьОбласть("СтрокаРабот");
	ОбластьИтоговПоСтраницеУслуги	= Макет.ПолучитьОбласть("ИтогиПоСтраницеРабот");
	ОбластьПодвалУслуг		        = Макет.ПолучитьОбласть("ПодвалУслуги");
		
	ОбластьШапкаДеталейКлиента				= Макет.ПолучитьОбласть("ШапкаДеталейКлиента");
	ОбластьСтрокаДеталейКлиента				= Макет.ПолучитьОбласть("СтрокаДеталейКлиента");
	ОбластьИтоговПоСтраницеДеталиКлиента	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталейКлиента");
	ОбластьПодвалДеталейКлиента 			= Макет.ПолучитьОбласть("ПодвалКлиента");
		
	БезЛинии = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	ОбычнаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	// Настроем колонки вывода деталей если не было скидок
	Если Не ЕстьСкидкаПоДеталям Тогда
		ПоложениеШапкиДеталей = ОбластьДетали.Область("ШапкаДеталей").Низ;
		ПозицияКолонки = ОбластьСкидка.Лево;
		Пока ПозицияКолонки > 6 Цикл
			ОбластьДетали.Область(ПоложениеШапкиДеталей-1,ПозицияКолонки,ПоложениеШапкиДеталей-1,ПозицияКолонки).Текст = ОбластьДетали.Область(ПоложениеШапкиДеталей-1,ПозицияКолонки-1,ПоложениеШапкиДеталей-1,ПозицияКолонки-1).Текст;
			ОбластьДетали.Область(ПоложениеШапкиДеталей,ПозицияКолонки,ПоложениеШапкиДеталей,ПозицияКолонки).Текст = ОбластьДетали.Область(ПоложениеШапкиДеталей,ПозицияКолонки-1,ПоложениеШапкиДеталей,ПозицияКолонки-1).Текст;
				
			ОбластьИсточник = ОбластьСтрокаДеталей.Область(1,ПозицияКолонки-1,1,ПозицияКолонки-1);
			ОбластьПриемник = ОбластьСтрокаДеталей.Область(1,ПозицияКолонки,1,ПозицияКолонки);
			ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
			ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
			ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
			ОбластьИсточник = ОбластьИтоговПоСтраницеДетали.Область(1,ПозицияКолонки-1,1,ПозицияКолонки-1);
			ОбластьПриемник = ОбластьИтоговПоСтраницеДетали.Область(1,ПозицияКолонки,1,ПозицияКолонки);
			ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
			ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
			ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
			ОбластьИсточник = ОбластьПодвалДеталей.Область(1,ПозицияКолонки-1,1,ПозицияКолонки-1);
			ОбластьПриемник = ОбластьПодвалДеталей.Область(1,ПозицияКолонки,1,ПозицияКолонки);
			ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
			ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
			ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
			ПозицияКолонки = ПозицияКолонки-1;
		КонецЦикла;
			
		ОбластьДетали.Область(ПоложениеШапкиДеталей-1, 4, ПоложениеШапкиДеталей-1, 6).Объединить();
		ОбластьДетали.Область(ПоложениеШапкиДеталей, 4, ПоложениеШапкиДеталей, 6).Объединить();
		ОбластьСтрокаДеталей.Область(1, 4, 1, 6).Объединить();
			
		ТекОбласть = ОбластьИтоговПоСтраницеДетали.Область(1, 2, 1, 6);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСнизу = БезЛинии;
			
		ТекОбласть = ОбластьПодвалДеталей.Область(1, 2, 1, 6);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСнизу = БезЛинии;
			
		ТекОбласть = ОбластьИтоговПоСтраницеДетали.Область(1, 8, 1, 9);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСлева = ОбычнаяЛиния;
		ТекОбласть.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Текст;
		ТекОбласть.Текст = "на сумму:";
			
		ТекОбласть = ОбластьПодвалДеталей.Область(1, 8, 1, 9);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСлева = ОбычнаяЛиния;
		ТекОбласть.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Текст;
		ТекОбласть.Текст = "на сумму:";
			
		ПозицияКолонки = ОбластьСкидка.Лево;
		Пока Не ПустаяСтрока(ОбластьДетали.Область(ПоложениеШапкиДеталей-1,ПозицияКолонки,ПоложениеШапкиДеталей-1,ПозицияКолонки).Текст) Цикл
			ОбластьДетали.Область(ПоложениеШапкиДеталей,ПозицияКолонки,ПоложениеШапкиДеталей,ПозицияКолонки).Текст = ПозицияКолонки-3;
			ПозицияКолонки = ПозицияКолонки + 1;
		КонецЦикла;
	КонецЕсли;
		
	ОбластьШапкаДеталей = ОбластьДетали.ПолучитьОбласть("ШапкаДеталей");
		
	// Настроем колонки вывода услуг если не было скидок
	Если Не ЕстьСкидкаПоРаботам Тогда
		ПоложениеШапкиУслуг = ОбластьУслуги.Область("ШапкаУслуг").Низ;
				
		ОбластьИсточник = ОбластьУслуги.Область(ПоложениеШапкиУслуг-1, 7, ПоложениеШапкиУслуг-1, 8);
		ОбластьПриемник = ОбластьУслуги.Область(ПоложениеШапкиУслуг-1, 9, ПоложениеШапкиУслуг-1, 9);
		ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
		//ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
		//ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
		ОбластьИсточник = ОбластьУслуги.Область(ПоложениеШапкиУслуг, 7, ПоложениеШапкиУслуг, 8);
		ОбластьПриемник = ОбластьУслуги.Область(ПоложениеШапкиУслуг, 9, ПоложениеШапкиУслуг, 9);
		ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
		//ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
		//ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
		ОбластьИсточник = ОбластьСтрокаУслуг.Область(1, 7, 1, 8);
		ОбластьПриемник = ОбластьСтрокаУслуг.Область(1, 9, 1, 9);
		ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
		ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
		ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
		
		ПозицияКолонки = ОбластьСкидка.Лево - 2;
		Пока ПозицияКолонки > 5 Цикл
			ОбластьУслуги.Область(ПоложениеШапкиУслуг-1,ПозицияКолонки,ПоложениеШапкиУслуг-1,ПозицияКолонки).Текст = ОбластьУслуги.Область(ПоложениеШапкиУслуг-1,ПозицияКолонки-1,ПоложениеШапкиУслуг-1,ПозицияКолонки-1).Текст;
			ОбластьУслуги.Область(ПоложениеШапкиУслуг,ПозицияКолонки,ПоложениеШапкиУслуг,ПозицияКолонки).Текст = ОбластьУслуги.Область(ПоложениеШапкиУслуг,ПозицияКолонки-1,ПоложениеШапкиУслуг,ПозицияКолонки-1).Текст;
				
			ОбластьИсточник = ОбластьСтрокаУслуг.Область(1,ПозицияКолонки-1,1,ПозицияКолонки-1);
			ОбластьПриемник = ОбластьСтрокаУслуг.Область(1,ПозицияКолонки,1,ПозицияКолонки);
			ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
			ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
			ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
			ОбластьИсточник = ОбластьИтоговПоСтраницеУслуги.Область(1,ПозицияКолонки-1,1,ПозицияКолонки-1);
			ОбластьПриемник = ОбластьИтоговПоСтраницеУслуги.Область(1,ПозицияКолонки,1,ПозицияКолонки);
			ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
			ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
			ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
			ОбластьИсточник = ОбластьПодвалУслуг.Область(1,ПозицияКолонки-1,1,ПозицияКолонки-1);
			ОбластьПриемник = ОбластьПодвалУслуг.Область(1,ПозицияКолонки,1,ПозицияКолонки);
			ОбластьПриемник.Текст 		= ОбластьИсточник.Текст;
			ОбластьПриемник.Заполнение	= ОбластьИсточник.Заполнение;
			ОбластьПриемник.Параметр	= ОбластьИсточник.Параметр;
				
			ПозицияКолонки = ПозицияКолонки-1;
		КонецЦикла;
			
		ОбластьУслуги.Область(ПоложениеШапкиУслуг-1, 4, ПоложениеШапкиУслуг-1, 5).Объединить();
		ОбластьУслуги.Область(ПоложениеШапкиУслуг, 4, ПоложениеШапкиУслуг, 5).Объединить();
		ОбластьСтрокаУслуг.Область(1, 4, 1, 5).Объединить();
			
		ТекОбласть = ОбластьИтоговПоСтраницеУслуги.Область(1, 2, 1, 5);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСнизу = БезЛинии;
			
		ТекОбласть = ОбластьПодвалУслуг.Область(1, 2, 1, 5);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСнизу = БезЛинии;
			
		ТекОбласть = ОбластьИтоговПоСтраницеУслуги.Область(1, 7, 1, 9);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСлева = ОбычнаяЛиния;
		ТекОбласть.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Текст;
		ТекОбласть.Текст = "на сумму:";
			
		ТекОбласть = ОбластьПодвалУслуг.Область(1, 7, 1, 9);
		ТекОбласть.Объединить();
		ТекОбласть.ГраницаСлева = ОбычнаяЛиния;
		ТекОбласть.Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Текст;
		ТекОбласть.Текст = "на сумму:";
			
		ПозицияКолонки = ОбластьСкидка.Лево;
		Пока Не ПустаяСтрока(ОбластьУслуги.Область(ПоложениеШапкиУслуг-1,ПозицияКолонки,ПоложениеШапкиУслуг-1,ПозицияКолонки).Текст) Цикл
			ОбластьУслуги.Область(ПоложениеШапкиУслуг,ПозицияКолонки,ПоложениеШапкиУслуг,ПозицияКолонки).Текст = ПозицияКолонки-3;
			ПозицияКолонки = ПозицияКолонки + 1;
		КонецЦикла;
	КонецЕсли;
		
	ОбластьШапкаУслуг = ОбластьУслуги.ПолучитьОбласть("ШапкаУслуг");
		
	// инициализация итогов по документу
	ИтогоСуммаРабот	              = 0;
	ИтогоСуммаНДСРабот            = 0;
	ИтогоСуммаСкидкиРабот         = 0;
	ИтогоКоличествоРабот          = 0;
	ИтогоСуммаДеталей	          = 0;
	ИтогоСуммаНДСДеталей          = 0;
	ИтогоСуммаСкидкиДеталей       = 0;
	ИтогоКоличествоДеталей        = 0;
	ИтогоКоличествоДеталейКлиента = 0;
		
	ФорматВыводаСуммы      = обПраво("ФорматВыводаСуммы", Права);
	ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества", Права);
	
	НомерДляПечати=дкПолучитьНомерДляПечати(ЭтотОбъект);

	// Вывод шапки документа для Дилера
	Если ЗначениеЗаполнено(ЭтотОбъект.Автомобиль) Тогда
		Марка = ВРег(ЭтотОбъект.Автомобиль.Модель.Родитель.Наименование);
		Модель = ВРег(ЭтотОбъект.Автомобиль.Модель.Наименование);
	Иначе
		Марка = "";
		Модель = "";
	КонецЕсли;	
	ЭтоНиссан = Найти(Модель, "NISSAN") > 0 Или Найти(Марка, "NISSAN") > 0 Или Найти(Модель, "НИССАН") > 0 Или Найти(Марка, "НИССАН") > 0;
	ЭтоХёндэ = Найти(Модель, "HYUNDAI") > 0 Или Найти(Марка, "HYUNDAI") > 0 Или Найти(Модель, "ХЁНДЭ") > 0 Или Найти(Марка, "ХЁНДЭ") > 0;
	ЭтоФорд = Найти(Модель, "FORD") > 0 Или Найти(Марка, "FORD") > 0 Или Найти(Модель, "ФОРД") > 0 Или Найти(Марка, "ФОРД") > 0;
	ЭтоРено = Найти(Модель, "RENAULT") > 0 Или Найти(Марка, "RENAULT") > 0 Или Найти(Модель, "РЕНО") > 0 Или Найти(Марка, "РЕНО") > 0;
	ЭтоДжип = Найти(Модель, "JEEP") > 0 Или Найти(Марка, "JEEP") > 0 Или Найти(Модель, "ДЖИП") > 0 Или Найти(Марка, "ДЖИП") > 0;
	ЭтоФиат = Найти(Модель, "FIAT") > 0 Или Найти(Марка, "FIAT") > 0 Или Найти(Модель, "ФИАТ") > 0 Или Найти(Марка, "ФИАТ") > 0;
	ЭтоSY = Найти(Модель, "SSANG YONG") > 0 Или Найти(Марка, "SSANG YONG") > 0 Или Найти(Модель, "ССАНГ ЙОНГ") > 0 Или Найти(Марка, "ССАНГ ЙОНГ") > 0
			Или Найти(Модель, "SSANGYONG") > 0 Или Найти(Марка, "SSANGYONG") > 0 Или Найти(Модель, "ССАНГЙОНГ") > 0 Или Найти(Марка, "ССАНГЙОНГ") > 0;
	ЭтоЛада = Найти(Модель, "LADA") > 0 Или Найти(Марка, "LADA") > 0 Или Найти(Модель, "ЛАДА") > 0 Или Найти(Марка, "ЛАДА") > 0;
	ЭтоУАЗ = Найти(Модель, "UAZ") > 0 Или Найти(Марка, "UAZ") > 0 Или Найти(Модель, "УАЗ") > 0 Или Найти(Марка, "УАЗ") > 0;
	
	Если ЭтоРено Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаРено");
	Иначе
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаДругие");
	КонецЕсли;	
	ОбластьМакета.Параметры.Организация = ЭтотОбъект.Организация;
	ОбластьМакета.Параметры.ФирмаПолноеНаименование = спПолучитьНаименование(ЭтотОбъект.Организация);
	ОбластьМакета.Параметры.ФирмаАдресЮридический = киПолучитьПредставлениеКИ(ЭтотОбъект.Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Вывод остальной шапки документа
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");  
	ОбластьМакета.Параметры.НомерДок = НомерДляПечати;
	ОбластьМакета.Параметры.ДатаДок = Формат(ЭтотОбъект.Дата,"ДФ=дд.ММ.гггг");
	
	//Владелец = ЭтотОбъект.Владелец;
	ОбластьМакета.Параметры.Владелец = спПолучитьНаименование(Владелец);
	// ИНН и КПП для юр. лиц
	Если Владелец.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
		ОбластьМакета.Параметры.ВладелецИНН = "ИНН " + Владелец.ИНН + " КПП " + Владелец.КПП;
	ИначеЕсли Владелец.ФормаСобственности = Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
		ОбластьМакета.Параметры.ВладелецИНН = "ИНН " + Владелец.ИНН;
	КонецЕсли;	  
	ОбластьМакета.Параметры.АдресВладельца =  киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	ОбластьМакета.Параметры.ТелефоныВладельца =  киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);

	// Доверенное лицо Заказчика
	ОбластьМакета.Параметры.ДовЛицо = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
	ОбластьМакета.Параметры.ДоверенноеЛицо = спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоЗаказчикаДолжность) + " " + спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика);
	ОбластьМакета.Параметры.ДоверенноеЛицоАдресПочтовый = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	ОбластьМакета.Параметры.ДоверенноеЛицоТелефоны = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);	
	Доверенность = ЭтотОбъект._г_ДоверенностьЗаказчика;
	ДоверенностьНомер = Доверенность.Номер;
	ДоверенностьДата = Формат(Доверенность.ДатаВыдачи,"ДЛФ=D");
	ОбластьМакета.Параметры.НомерДоверенности = ДоверенностьНомер;
	ОбластьМакета.Параметры.ДатаДоверенности = ДоверенностьДата;

	// Доверенное лицо Плательщика
	ОбластьМакета.Параметры.ДовЛицо1 = ЭтотОбъект._г_ДоверенноеЛицоПлательщика;
	ОбластьМакета.Параметры.ДоверенноеЛицо1 = спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоПлательщикаДолжность) + " " + спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоПлательщика);
	ОбластьМакета.Параметры.ДоверенноеЛицоАдресПочтовый1 = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоПлательщика, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	ОбластьМакета.Параметры.ДоверенноеЛицоТелефоны1 = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоПлательщика, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);	
	Доверенность1 = ЭтотОбъект._г_ДоверенностьПлательщика;
	ДоверенностьНомер1 = Доверенность1.Номер;
	ДоверенностьДата1 = Формат(Доверенность1.ДатаВыдачи,"ДЛФ=D");
	ОбластьМакета.Параметры.НомерДоверенности1 = ДоверенностьНомер1;
	ОбластьМакета.Параметры.ДатаДоверенности1 = ДоверенностьДата1;
	
	Заказчик_ = ЭтотОбъект.Заказчик;
	ОбластьМакета.Параметры.Заказчик = Заказчик_;
	ОбластьМакета.Параметры.ЗаказчикПолноеНаименование = спПолучитьНаименование(Заказчик_);	  
	// ИНН и КПП для юр. лиц
	Если Заказчик.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
	  ОбластьМакета.Параметры.ЗаказчикИНН = "ИНН " + Заказчик_.ИНН + " КПП " + Заказчик_.КПП;
	ИначеЕсли Заказчик.ФормаСобственности = Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
	  ОбластьМакета.Параметры.ЗаказчикИНН = "ИНН " + Заказчик_.ИНН;
	КонецЕсли;	  
	ОбластьМакета.Параметры.ЗаказчикАдресПочтовый = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	ОбластьМакета.Параметры.ЗаказчикТелефоны = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	Контрагент_ = ЭтотОбъект.Контрагент;
	ОбластьМакета.Параметры.Контрагент = Контрагент_;
	ОбластьМакета.Параметры.КонтрагентПолноеНаименование = спПолучитьНаименование(Контрагент_);
	// ИНН и КПП для юр. лиц
	Если Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
	  ОбластьМакета.Параметры.КонтрагентИНН = "ИНН " + Контрагент_.ИНН + " КПП " + Контрагент_.КПП;
	ИначеЕсли Контрагент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
	  ОбластьМакета.Параметры.КонтрагентИНН = "ИНН " + Контрагент_.ИНН;
	КонецЕсли;
