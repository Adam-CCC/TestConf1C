	//	  ОбластьШапка.Рисунки.ШК.Объект.Сообщение=ШК;
	//  КонецЕсли;
	//Исключение
	//КонецПопытки;
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	//Бондаренко++ 20251008
 	ОбластьОНомерныхРамках = Макет.ПолучитьОбласть("ОНомерныхРамках");
