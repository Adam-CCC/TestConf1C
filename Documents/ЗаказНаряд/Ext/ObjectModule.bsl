	ОбластьМакета.Параметры.КонтактыИсполнителя = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	//ОбластьМакета.Параметры.ЗаказНарядДата = Формат(ДокументОбъект.Дата,"ДЛФ=ДД");
	//ОбластьМакета.Параметры.Время = Формат(ТекущаяДата,"ДЛФ=В");
	  
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	  
	Владелец = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
	Если обЗначениеНеЗаполнено(Владелец) Тогда
		Владелец = ЭтотОбъект.Владелец;
		Если обЗначениеНеЗаполнено(Владелец) Тогда
		  Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
		  Возврат Неопределено;
	  	КонецЕсли;
  	КонецЕсли;
	ОбластьМакета.Параметры.Владелец = Владелец.Наименование;
	
	//ОбластьМакета.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	//Если ОбластьМакета.Параметры.ВладелецАдрес = "" Тогда
	//  ОбластьМакета.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	//КонецЕсли;
	//Если ОбластьМакета.Параметры.ВладелецАдрес = "" Тогда
	//  ОбластьМакета.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	//КонецЕсли;
	ОбластьМакета.Параметры.КонтактыВладельца = киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьМакета.Параметры.КонтактыВладельца) Тогда
	  ОбластьМакета.Параметры.КонтактыВладельца = киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьМакета.Параметры.КонтактыВладельца) Тогда
	  ОбластьМакета.Параметры.КонтактыВладельца = киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	//ОбластьМакета.Параметры.ВладелецЕМэйл = киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	//Если ОбластьМакета.Параметры.ВладелецЕМэйл = "" Тогда
	//  ОбластьМакета.Параметры.ВладелецЕМэйл = киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	//КонецЕсли;

	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
	  Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
		  Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
	  КонецЕсли;			  
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
	  Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;	  
	ОбластьМакета.Параметры.Заказчик = Заказчик.Наименование;
	  
	ОбластьМакета.Параметры.Модель = Автомобиль.Модель.Наименование;
	ДатаСоздания = КонецДня(ЭтотОбъект.ДатаСоздания);
	ОбластьМакета.Параметры.ГосНомер =  Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаСоздания);
	ОбластьМакета.Параметры.ВИН = ЭтотОбъект.Автомобиль.VIN;
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаСоздания);
	ОбластьМакета.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");
	Если ОбластьМакета.Параметры.Пробег = "" Тогда
		ОбластьМакета.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	КонецЕсли;

	ОбластьМакета.Параметры.МастерПриемщик = ЭтотОбъект.Диспетчер.Наименование;	  	  
