	ОбластьМакета.Параметры.ПоДоверенности2 =  "по доверенности №" + ЭтотОбъект.Номер + " от " + Формат(ЭтотОбъект.Дата,"ДЛФ=D");
	//Бондаренко-- 20210419
 	ОбластьМакета.Параметры.НомерДок = НомерДляПечати;
	ОбластьМакета.Параметры.ДатаДок = Формат(ЭтотОбъект.Дата, "ДФ = дд.ММ.гггг");
    НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьМакета, , , НомерСтраницы, , Права);

	//// Вывод причины
	//ОбластьМакета = Макет.ПолучитьОбласть("Причина");
	//Если ПустаяСтрока(ЭтотОбъект.ПричинаОбращения) Тогда
	//	ТекОбласть = ОбластьМакета.Область(2, , 2, );
	//	ТекОбласть.АвтовысотаСтроки = Ложь;
	//	ТекОбласть.ВысотаСтроки = 22;
	//КонецЕсли;
	//ОбластьМакета.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	//НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьМакета, , , НомерСтраницы, , Права);		
	
	// Семенихин 27.06.2023 +++++
	// печать штрихкодов исполнителей
	Если СМ_ФормированиеНовыхОбъектов.КомпонентаПечатиШтрихКодовУстановлена() Тогда
		тзИсполнители = Исполнители.Выгрузить();
		тзИсполнители.Свернуть("Исполнитель");
		КоличествоИсполнителей = тзИсполнители.Количество();
		Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен
			И КоличествоИсполнителей > 0 Тогда
			нзШтрихКодыИсполнителей = РегистрыСведений.ИсполнителиПоЗаказНарядам.СоздатьНаборЗаписей();
			нзШтрихКодыИсполнителей.Отбор.ЗаказНаряд.Установить(Ссылка);
			сч = 1;
			Для Каждого СтрокаИсполнитель Из тзИсполнители Цикл
				Исполнитель = СтрокаИсполнитель.Исполнитель;
				нзШтрихКодыИсполнителей.Отбор.Исполнитель.Установить(Исполнитель);
				нзШтрихКодыИсполнителей.Прочитать();
				
				Если нзШтрихКодыИсполнителей.Количество() > 0 Тогда
					Штрихкод = нзШтрихКодыИсполнителей[0].ШтрихКод;
				Иначе
					Сообщить("У исполнителя " + Строка(Исполнитель) + " нет штрихкода!", СтатусСообщения.Внимание);
					Продолжить;
				КонецЕсли;
				
				Если ПустаяСтрока(Штрихкод) Тогда
					Сообщить("У исполнителя " + Строка(Исполнитель) + " нет штрихкода!", СтатусСообщения.Внимание);
					Продолжить;
					
				Иначе
					Если сч = 1 Тогда
						ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
					Иначе
						ОбластьШтрихкоды = Макет.Область("Штрихкоды");
						Если сч % 2 = 0 Тогда
							ОбластьШтрихкоды.ОриентацияТекста = 180;
						Иначе
							ОбластьШтрихкоды.ОриентацияТекста = 0;
						КонецЕсли;
					КонецЕсли;
					
					ОбластьМакета = Макет.ПолучитьОбласть("Штрихкоды");
					ОбластьМакета.Параметры.Исполнитель = Исполнитель;
					//СМ_ФормированиеНовыхОбъектов.ВывестиКартинкуШтрихКода(ОбластьМакета.Рисунки.Штрихкод, Штрихкод);
					
					// попытаемся напечатать ШК
					Попытка
						ПрефиксШтрихКода = Число(Лев(Штрихкод,2));
					Исключение
						ПрефиксШтрихКода = 0;
					КонецПопытки;
					Попытка
						ОбластьМакета.Рисунки.Штрихкод.Объект.ТипКода=Число(НЕ (СтрДлина(Штрихкод)=8 И ПрефиксШтрихКода<>ПрефиксВесовогоШК));
						ДлинаШК = ?(ОбластьМакета.Рисунки.Штрихкод.Объект.ТипКода=0,8,13);
						Штрихкод = Штрихкод + "0000000000000";
						Штрихкод = Лев(Штрихкод, ДлинаШК - 1 + ОбластьМакета.Рисунки.Штрихкод.Объект.СодержитКС);
						ОбластьМакета.Рисунки.Штрихкод.Объект.Сообщение = Штрихкод;
					Исключение
					КонецПопытки;
					
					НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьМакета, , , НомерСтраницы, , Права);
					сч = сч + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		Сообщить("Не установлена компонента печати штрихкодов ""1C-Barcode""!", СтатусСообщения.Внимание);
	КонецЕсли;
	// Семенихин 15.12.2025 -----
	
	// Верхние колонтитулы
	ТабДокумент.ВерхнийКолонтитул.ВертикальноеПоложение=ВертикальноеПоложение.Низ;
	ТабДокумент.ВерхнийКолонтитул.Выводить=Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница=2;
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа="Заказ-наряд № "+НомерДляПечати+" от "+Формат(ЭтотОбъект.Дата,"ДФ = дд.ММ.гггг");
	ТабДокумент.ВерхнийКолонтитул.Шрифт=Новый Шрифт(ТабДокумент.ВерхнийКолонтитул.Шрифт,,,,Истина,Истина,);
		
	// Нижние колонтитулы
	ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение=ВертикальноеПоложение.Низ;
	ТабДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ДатаРаспечатки_ = ?(ЗначениеЗаполнено(ЭтотОбъект.ДатаРаспечатки), ЭтотОбъект.ДатаРаспечатки, ТекущаяДата());
	ТабДокумент.НижнийКолонтитул.ТекстСлева="Дата распечатки: " + Формат(ДатаРаспечатки_,"ДФ = дд.ММ.гггг");
	ТабДокумент.НижнийКолонтитул.Шрифт = ТабДокумент.ВерхнийКолонтитул.Шрифт;
	
	//Бондаренко++ 20220318
	ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;
	//Бондаренко-- 20220318

	ТабДокумент.АвтоМасштаб = Истина;	

	Возврат ТабДокумент;
КонецФункции  //ПечатьЕДОСРабочийЗаказНаряд(ЭтотОбъект, ТабДокумент)
