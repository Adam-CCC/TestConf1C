Функция ПечатьСервисныйЛист(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	Макет = ПолучитьМакет("ЧериСервисныйЛист");
	Макет.Параметры.НомерЗаказа          = Номер;
	Макет.Параметры.НомернойЗнак       	 = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, Дата);
	Макет.Параметры.ПостановкаНаГарантию = СтрЗаменить(Строка(Год(Автомобиль.ДатаНачалаГарантии)),Символы.НПП,"");
	Макет.Параметры.ВИН                  = Автомобиль.VIN;
	Макет.Параметры.Пробег               = Пробег;
	Макет.Параметры.Приемщик             = Диспетчер.Наименование;
	Макет.Параметры.Модель               = Автомобиль.Модель;
	Макет.Параметры.МодельныйГод         = СтрЗаменить(Строка(Год(Автомобиль.ГодВыпуска)),Символы.НПП,"");
	Макет.Параметры.Дата                 = Дата;
	ТабДокумент.Вывести(Макет);
	Возврат ТабДокумент;                
	
Конецфункции

Функция ФИОРабЛист(Сотрудник)
	Если обЗначениеНеЗаполнено(Сотрудник) Тогда
		Возврат "_____________________________";
	Иначе
		Фамилия = Сотрудник.Фамилия;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Фамилия) Тогда
		СтрокаФИО = Фамилия;;
	Иначе
		Возврат "_____________________________";
	КонецЕсли;
	
	Имя = Сотрудник.Имя;
	Если ЗначениеЗаполнено(Имя) Тогда
		СтрокаФИО = СтрокаФИО + " " + Лев(Имя, 1) + ".";
	Иначе
		Возврат "_____________________________";
	КонецЕсли;
	
	Отчество = Сотрудник.Отчество;
	Если ЗначениеЗаполнено(Отчество) Тогда
		СтрокаФИО = СтрокаФИО + Лев(Отчество, 1) + ".";
	Иначе
		Возврат СтрокаФИО;
	КонецЕсли;
	Возврат СтрокаФИО;
КонецФункции

