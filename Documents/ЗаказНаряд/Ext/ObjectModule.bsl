Функция ПечатьЛадаПриемка(ТабДокумент) Экспорт 
	
	#Если Клиент Тогда
		Для Счетчик = 1 По 4 Цикл 
			
			ТабДокумент = Новый ТабличныйДокумент;                              
			
			Если Счетчик = 1 Тогда
				ПечатьЛадаАктПриемаПередачи(ТабДокумент);
			ИначеЕсли Счетчик = 2 Тогда
				ПечатьЛадаЗаявкаДоговорЗаказНаряд(ТабДокумент);	      
			ИначеЕсли Счетчик = 3 Тогда
				ПечатьЛадаЛистКонтроляКачества(ТабДокумент);	      	
			Иначе 
				ПечатьЛадаНарядНаРаботы(ТабДокумент);	
			КонецЕсли;
			
			ТабДокумент.АвтоМасштаб=Истина;
			
			Если Счетчик <> 4 Тогда
				ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
				ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;				
			Иначе
				ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
				ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВверх;		
			КонецЕсли;
			
			увкНапечататьДокумент(ТабДокумент,1,Истина,"",Ссылка,Неопределено);	
			
		КонецЦикла; 
	#КонецЕсли
	
	Возврат Неопределено;
	
КонецФункции // ПечатьЛадаПриемка(ТабДокумент)

Функция ПечатьЛадаВыдача(ТабДокумент) Экспорт                               
	
	#Если Клиент Тогда
 	КоличествоЭкземпляров = 2;
	
	Для Счетчик = 1 По 3 Цикл 
		
		ТабДокумент = Новый ТабличныйДокумент;                              
		
		Если Счетчик = 1 Тогда
			ПечатьЛадаАктВыполненныхРабот(ТабДокумент);
		ИначеЕсли Счетчик = 2 Тогда
			ПечатьЛадаДоговорЗаказНаряд(ТабДокумент);	      
 		Иначе 
			ПечатьУПД(ТабДокумент);	
			Если Контрагент.ОсвобожденОтНДС Тогда
				КоличествоЭкземпляров = 1;				
 			КонецЕсли;
		КонецЕсли;
		
		ТабДокумент.АвтоМасштаб=Истина;
		
		Если Счетчик <> 3 Тогда
			ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
			ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;				
		Иначе                                                           
			ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
			ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВверх;		
		КонецЕсли;
   
		увкНапечататьДокумент(ТабДокумент,КоличествоЭкземпляров,Истина,"",Ссылка,Неопределено);	
		
	КонецЦикла;
	#КонецЕсли
	
 	Возврат Неопределено;

КонецФункции // ПечатьЛадаВыдача()
