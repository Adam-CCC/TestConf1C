Функция СМГ_ЭтоПовторноеОбращение()  
	
	ЭтоПовторноеОбращение = Ложь;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("Состояние", Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	Запрос.УстановитьПараметр("ЭтотДокумент", Ссылка);
	Запрос.УстановитьПараметр("ДатаВыборки", ДобавитьМесяц(ТекущаяДата(), -1));
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказНаряд.Ссылка
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Автомобиль = &Автомобиль
	|	И ЗаказНаряд.Состояние = &Состояние
	|	И ЗаказНаряд.Ссылка <> &ЭтотДокумент
	|	И ЗаказНаряд.ДатаЗакрытия > &ДатаВыборки";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() > 0 Тогда
		ЭтоПовторноеОбращение = Истина;
 	КонецЕсли;
 	
	Возврат ЭтоПовторноеОбращение;
	
КонецФункции // СМГ_ЭтоПовторноеОбращение()  

Процедура СМГ_ОбработатьВидРемонта(ЭтаФорма)
	
	//Бондаренко++ 20240320
	Если ВидРемонта =Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером Тогда
		Если НЕ обЗначениеНеЗаполнено(Организация) Тогда
			Если НЕ обЗначениеНеЗаполнено(Организация.КонтрагентОрганизации) Тогда
				Если Заказчик <> Организация.КонтрагентОрганизации Тогда
					Заказчик = Организация.КонтрагентОрганизации;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Бондаренко-- 20240320
	
	//Бондаренко++ 20180306
	НомерБыл = СокрЛП(Ссылка.Номер);
	УстановитьПрефикс();
	Если СокрЛП(Номер) <> НомерБыл Тогда
		Попытка
			ЭтотОбъект.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			//			
		КонецПопытки; 
		ЭтотОбъект.УстановитьНовыйНомер();
		Если СокрЛП(Номер) <> НомерБыл Тогда
			Если Найти(Комментарий,НомерБыл) = 0 Тогда
				Комментарий = СокрЛП(СокрЛП(Комментарий)+" "+НомерБыл);
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	//Бондаренко-- 20180306 
	
	//Гэндальф+++
	Если ВидРемонта.БлокироватьСуммыВЗН тогда
		ЭтаФорма.ЭлементыФормы.Товары.Колонки.Сумма.Доступность = Ложь;
		ЭтаФорма.ЭлементыФормы.Товары.Колонки.СуммаВсего.Доступность = Ложь;
		ЭтаФорма.ЭлементыФормы.Работы.Колонки.Сумма.Доступность = Ложь;
		ЭтаФорма.ЭлементыФормы.Работы.Колонки.СуммаВсего.Доступность = Ложь;
	КонецЕсли;
	
	//Галактионов 28022025 ++
	Если ВидРемонта.ОсвобожденОтНДС Тогда 
		Для Каждого Строка Из Товары Цикл
			Строка.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
			ОбработкаРеквизита("Товары.СтавкаНДС",Строка);
		КонецЦикла;
	КонецЕсли;  
	Если ВидРемонта.ОсвобожденОтНДСРаботы Тогда 
		Для Каждого Строка Из Работы Цикл
			Строка.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
              ОбработкаРеквизита("Работы.СтавкаНДС",Строка);
		КонецЦикла;
	КонецЕсли;
	//Галактионов 28022025 --	
КонецПроцедуры  //СМГ_ОбработатьВидРемонта(ЭтаФорма)
