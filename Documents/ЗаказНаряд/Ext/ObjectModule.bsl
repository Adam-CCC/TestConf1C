Процедура ПроверитьНеобходимостьКорректировкиРабочегоЛиста(РежимЗаписи) 
	
	Если ЭтоНовый() Или РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;
	
	ПроактивныеКонтакты = ПолучитьПроактивныеКонтакты();
	
	Если ЭтоУчастникПроактивногоКонтакта() И Не ПроактивныеКонтакты = Неопределено Тогда
		
		Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			
			Если ПроактивныеКонтакты.Количество() = 1 Тогда
				
				ТектПредупрежения = "На основании документа введен рабочий лист """ + ПроактивныеКонтакты[0] + """. Необходимо его удалить!";
				//Попытка
				//	Предупреждение(ТектПредупрежения);
				//Исключение
				//КонецПопытки;	
			Иначе
				
				ТектПредупрежения = "На основании документа введены рабочие листы:" + Символы.ПС + Символы.ПС;
				
				Для Каждого ПроактивныйКонтакт Из ПроактивныеКонтакты Цикл
					ТектПредупрежения = ТектПредупрежения + ПроактивныйКонтакт + Символы.ПС;
				КонецЦикла;
				
				ТектПредупрежения = ТектПредупрежения + Символы.ПС + "Необходимо их удалить!";
				
				//Попытка
				//	Предупреждение(ТектПредупрежения);
				//Исключение
				//КонецПопытки;	
				
				
			КонецЕсли;
			
		Иначе
			
			Если Не ЭтотОбъект.ДатаПроактивногоКонтакта = Ссылка.ДатаПроактивногоКонтакта Или
				Не ЭтотОбъект.ВремяПроактивногоКонтакта = Ссылка.ВремяПроактивногоКонтакта Или
				Не ЭтотОбъект.ВидПроактивногоКонтакта = Ссылка.ВидПроактивногоКонтакта Или
				Не ЭтотОбъект.КонтактнаяИнформацияПроактивногоКонтакта = Ссылка.КонтактнаяИнформацияПроактивногоКонтакта Тогда
				
				Если ПроактивныеКонтакты.Количество() = 1 Тогда
					
					ТектПредупрежения = "Изменены реквизиты программы ""Проактивный контакт"". Внесите необходимые изменения в документ """ + ПроактивныеКонтакты[0] + """!";
					//Попытка
					//	Предупреждение(ТектПредупрежения);
					//Исключение
					//КонецПопытки;	
					
					
				Иначе
					
					ТектПредупрежения = "Изменены реквизиты программы ""Проактивный контакт"". Внесите необходимые изменения в документы:" + Символы.ПС + Символы.ПС;
					
					Для Каждого ПроактивныйКонтакт Из ПроактивныеКонтакты Цикл
						ТектПредупрежения = ТектПредупрежения + ПроактивныйКонтакт + Символы.ПС;
					КонецЦикла;
					
					//Попытка
					//	Предупреждение(ТектПредупрежения);
					//Исключение
					//КонецПопытки;	
					
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
