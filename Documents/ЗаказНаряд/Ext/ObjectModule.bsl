Функция ПечатьПочтаРоссии(ТабДокумент) Экспорт
	
	//============================================
	
	КонтактноеЛицоФИО = "";
	КонтактноеЛицо = "";
	ПодтвДокумент = "";
	
	ФормаВыбора = Справочники.Контрагенты.ПолучитьФормуВыбора();
	ФормаВыбора.Заголовок = "Выбор контактного лица Покупателя";
	ФормаВыбора.Отбор.ВедушийКонтрагент.Значение = Заказчик;
	ФормаВыбора.Отбор.ВедушийКонтрагент.Использование = Истина;
	ФормаВыбора.Отбор.ВидКонтрагента.Значение = Перечисления.ВидыКонтрагентов.КонтактноеЛицо;
	ФормаВыбора.Отбор.ВидКонтрагента.Использование = Истина;
	ФормаВыбора.Отбор.ФормаСобственности.Значение = Перечисления.ФормыСобственности.ЧастноеЛицо;
	ФормаВыбора.Отбор.ВидКонтрагента.Использование = Истина;
	КонтактноеЛицоСсылка = ФормаВыбора.ОткрытьМодально();
	Если ЗначениеЗаполнено(КонтактноеЛицоСсылка) Тогда
		Должность = ПадежФИО(КонтактноеЛицоСсылка.Должность.Наименование);
		КонтактноеЛицо = Должность + " " + ПадежФИО(КонтактноеЛицоСсылка.Наименование);
		КонтактноеЛицоФИО = " "+Лев(КонтактноеЛицоСсылка.Имя,1)+"."+Лев(КонтактноеЛицоСсылка.Отчество,1)+". "+СокрЛП(КонтактноеЛицоСсылка.Фамилия);
 	КонецЕсли;	
	
	ФормаВыбора = Справочники.ПодтверждающиеДокументы.ПолучитьФормуВыбора();
	ФормаВыбора.Заголовок = "Выбор подтверждающего документа";
	ФормаВыбора.Отбор.Владелец.Значение = КонтактноеЛицоСсылка;
	ФормаВыбора.Отбор.Владелец.Использование = Истина;
	//ФормаВыбора.Отбор.Контрагент.Значение = ДокументОбъект.Заказчик; // контрагент есть только у доверенноси!
	//ФормаВыбора.Отбор.Контрагент.Использование = Истина;
	ПодтвДокументСсылка = ФормаВыбора.ОткрытьМодально();	
	Если ЗначениеЗаполнено(ПодтвДокументСсылка) Тогда
		ВидДокумента = ПадежФИО(Строка(ПодтвДокументСсылка.ВидПодтверждающегоДокумента)); // неверно склоняет доверенность!
		//ПодтвДокумент = ВидДокумента + " " + ПодтвДокументСсылка.Серия + " №" + ПодтвДокументСсылка.Номер + " от " + Формат(ПодтвДокументСсылка.ДатаВыдачи, "ДЛФ=Д");
		Если ПодтвДокументСсылка.ВидПодтверждающегоДокумента=Перечисления.ВидыДокументов.Доверенность Тогда
			ПодтвДокумент = "Доверенности №"+ПодтвДокументСсылка.Номер+" от "+Формат(ПодтвДокументСсылка.ДатаВыдачи,"ДФ=dd.MM.yyyy");
  		Иначе
			ПодтвДокумент = ПодтвДокументСсылка.Наименование;
 		КонецЕсли;   
  	КонецЕсли;	
 	
	//============================================
	
	ДатаПечатная = ?(обЗначениеНеЗаполнено(ДатаЗакрытия),ДатаСоздания,ДатаЗакрытия);
	
	Макет = ПолучитьМакет("ПочтаРоссии");
	
	ФорматВыводаСуммы      = обПраво("ФорматВыводаСуммы", Права,,ЭтотОбъект);
	ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества", Права,,ЭтотОбъект);
	
	НомерДляПечати=дкПолучитьНомерДляПечати(ЭтотОбъект);
	
	//зададим параметры макета
