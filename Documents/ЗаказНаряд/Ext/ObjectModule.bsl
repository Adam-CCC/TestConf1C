Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		// Если текущий режим Загрузка, то ничего проверять не надо
		Возврат;
	КонецЕсли;
	
 	Если Этотобъект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	//Бондаренко++ 20250619
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		СтрокаПоискаСНомеромРемонта = "";
		Если ВидРемонта = Справочники.ВидыРемонта.ТехническоеОбслуживание ИЛИ 
			ВидРемонта = Справочники.ВидыРемонта.ТехническоеОбслуживаниеБесплатное ИЛИ 
			ВидРемонта = Справочники.ВидыРемонта.МасляныйСервис Тогда
			СтрокаПоискаСНомеромРемонта = "ТО-"+СокрЛП(НомерТО);
		ИначеЕсли ВидРемонта = Справочники.ВидыРемонта.ТО_ноль ИЛИ ВидРемонта = Справочники.ВидыРемонта.ТО_нольПлатный Тогда
			СтрокаПоискаСНомеромРемонта = "ТО-0";
		КонецЕсли;	
		Если СтрокаПоискаСНомеромРемонта <> "" Тогда
			Если Найти(ПричинаОбращения,СтрокаПоискаСНомеромРемонта) = 0 Тогда
				СМГ_Сообщить("ОШИБКА! В причине обращения отсутствует """+СтрокаПоискаСНомеромРемонта+""". Исправьте.",СтатусСообщения.ОченьВажное);
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
	//Бондаренко-- 20250619
	
	//Бондаренко++ 20240904
	Если (РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения ) И (НЕ Ссылка.Пустая()) Тогда
		
		Запрос = Новый Запрос;
