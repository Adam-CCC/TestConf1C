Функция ФИО2(Наименование)
	Если ЗначениеЗаполнено(Наименование) Тогда
		мСтроки = СтрРазделить(Наименование, " ", Ложь);
		Если мСтроки.Количество() = 3 Тогда
			Возврат мСтроки[0] + " " + Лев(мСтроки[1], 1) + "." + Лев(мСтроки[2], 1) + ".";
		ИначеЕсли мСтроки.Количество() = 2 Тогда
			Возврат мСтроки[0] + " " + Лев(мСтроки[1], 1) + ".";
		ИначеЕсли мСтроки.Количество() = 1 Тогда
			Возврат мСтроки[0];
		Иначе
			Возврат "";
		КонецЕсли;	
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции
