Функция ПечатьЭксидАктПриемаПередачи(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	Макет = ПолучитьМакет("ЭксидАктПриемаПередачи");
	
	//Бондаренко++ 20260721
	МаркаАвто = "";
 	Попытка	МаркаАвто = Автомобиль.Модель.Марка; Исключение	КонецПопытки;
 	Если Не обЗначениеНеЗаполнено(МаркаАвто) Тогда
		Если МаркаАвто = Справочники.Марка.ESTEO Тогда
			Макет = ПолучитьМакет("ЭстеоАктПриемаПередачи");
 		КонецЕсли;
 	КонецЕсли;
	//Бондаренко-- 20260721
	
	Организация = ЭтотОбъект.Организация;
	Макет.Параметры.Организация = Организация.Наименование;
	Макет.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(ЭтотОбъект.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Макет.Параметры.ТелефонОрганизации = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	Макет.Параметры.ИННОрганизации = Организация.ИНН;
	Макет.Параметры.Номер = ЭтотОбъект.Номер;
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	Макет.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	Модель = Автомобиль.Модель;
	Макет.Параметры.Модель = Модель.Наименование;
	Макет.Параметры.Марка = Модель.Марка.Наименование;
	Макет.Параметры.ВИН = ЭтотОбъект.Автомобиль.VIN;
	// Холышевская ++ 26.03.2026
	Пойменная = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000223");
	
	Если ПараметрыСеанса.ПодразделениеКомпании = Пойменная ИЛИ ПараметрыСеанса.ПодразделениеКомпании.Родитель = Пойменная Тогда
		Макет.Параметры.Пробег = "";
	Иначе
		// Холышевская -- 26.03.2026	
		Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
		Если Пробег = 0 Тогда
			Макет.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
		Иначе
			Макет.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");		
		КонецЕсли;  
	КонецЕсли;
	//Макет.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, "ДФ=гггг");	  	  
	Макет.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д");
	Макет.Параметры.ЗаездДата = Формат(ДатаМашинозаезда,"ДФ=dd.MM.yyyy");
	Макет.Параметры.ЗаездВремя = Формат(ДатаМашинозаезда,"ДФ=ЧЧ:мм:сс");
	
	//Бондаренко++ 20251008
  	Если ЭтотОбъект.ЗаменаНомерныхРамок Тогда
		Макет.Параметры.ОНомерныхРамкахТекст = "Замена номерных рамок";
	ИначеЕсли ЭтотОбъект.ОтказОтЗаменыНомерныхРамок Тогда
		Макет.Параметры.ОНомерныхРамкахТекст =  "Отказ от замены номерных рамок";
	Иначе
		Макет.Параметры.ОНомерныхРамкахТекст =  "Рамки не менять";
	КонецЕсли;
   	//Бондаренко-- 20251008

 	ТабДокумент.Вывести(Макет);
	
	ТабДокумент.ПолеСверху              = 5;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 5;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;
КонецФункции 

Функция ФИО_(Сотрудник)
	Если обЗначениеНеЗаполнено(Сотрудник) Тогда
		Возврат "_____________________________";
	Иначе
		Фамилия = Сотрудник.Фамилия;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Фамилия) Тогда
		СтрокаФИО = Фамилия;
	Иначе
		Возврат "_____________________________";
	КонецЕсли;
	
	Имя = Сотрудник.Имя;
	Если ЗначениеЗаполнено(Имя) Тогда
		СтрокаФИО = СтрокаФИО + " " + Лев(Имя, 1) + ".";
	Иначе
		Возврат "_____________________________";
	КонецЕсли;
	
	Отчество = Сотрудник.Отчество;
	Если ЗначениеЗаполнено(Отчество) Тогда
		СтрокаФИО = СтрокаФИО + Лев(Отчество, 1) + ".";
	Иначе
		Возврат СтрокаФИО;
	КонецЕсли;
	Возврат СтрокаФИО;
КонецФункции               
 
Функция ПечатьЭксидГарантийныйЗаказНаряд(ТабДокумент) Экспорт
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	Макет = ПолучитьМакет("ЭксидГарантийныйЗаказНаряд");	  
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	//Бондаренко++ 20260717
	МаркаАвто = "";
 	Попытка	МаркаАвто = Автомобиль.Модель.Марка; Исключение	КонецПопытки;
 	Если Не обЗначениеНеЗаполнено(МаркаАвто) Тогда
		Если МаркаАвто = Справочники.Марка.ESTEO Тогда
			ОбластьШапка = Макет.ПолучитьОбласть("ШапкаЭстео");
 		КонецЕсли;
 	КонецЕсли;
	//Бондаренко-- 20260717
	
	Организация = ЭтотОбъект.Организация;
	ОбластьШапка.Параметры.Организация = Организация.Наименование;
	ОбластьШапка.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(ЭтотОбъект.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ТелефонОрганизации = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	ОбластьШапка.Параметры.ИННОрганизации = Организация.ИНН;
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	// Вывод остальной шапки документа
	ОбластьШапка = Макет.ПолучитьОбласть("Реквизиты");  
	  
	Собственник = ЭтотОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Собственник) Тогда
	  Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
  	КонецЕсли;
	
	ОбластьШапка.Параметры.Собственник = Собственник.Наименование;
	ОбластьШапка.Параметры.СобственникАдрес =  киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.СобственникАдрес) Тогда
	  ОбластьШапка.Параметры.СобственникАдрес =  киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.СобственникАдрес) Тогда
	  ОбластьШапка.Параметры.СобственникАдрес =  киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.АдресЮридический);		
	КонецЕсли;
	Если ЗначениеЗаполнено(Собственник.ИНН) Тогда
		ОбластьШапка.Параметры.СобственникИНН = Собственник.ИНН;
		Если ЗначениеЗаполнено(Собственник.КПП) Тогда
			ОбластьШапка.Параметры.СобственникИНН = ОбластьШапка.Параметры.СобственникИНН + "/" + Собственник.КПП;
		КонецЕсли;
	КонецЕсли;
	ОбластьШапка.Параметры.СобственникТелМейл = киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.СобственникТелМейл) Тогда
	  ОбластьШапка.Параметры.СобственникТелМейл = киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.СобственникТелМейл) Тогда
	  ОбластьШапка.Параметры.СобственникТелМейл = киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	ЕМейл = киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(ЕМейл) Тогда
	  ЕМейл = киПолучитьПредставлениеКИ(Собственник, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЕМейл) Тогда
		ОбластьШапка.Параметры.СобственникТелМейл = ОбластьШапка.Параметры.СобственникТелМейл + ", " + ЕМейл;
	КонецЕсли;

	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
	  Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
		  Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
	  КонецЕсли;			  
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
	  Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;	  	
	ОбластьШапка.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ЗаказчикАдрес) Тогда
	  ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ЗаказчикАдрес) Тогда
	  ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.АдресЮридический);		
	КонецЕсли;
	Если ЗначениеЗаполнено(Заказчик.ИНН) Тогда
		ОбластьШапка.Параметры.ЗаказчикИНН = Заказчик.ИНН;
		Если ЗначениеЗаполнено(Заказчик.КПП) Тогда
			ОбластьШапка.Параметры.ЗаказчикИНН = ОбластьШапка.Параметры.ЗаказчикИНН + "/" + Заказчик.КПП;
		КонецЕсли;
	КонецЕсли;
	ОбластьШапка.Параметры.ЗаказчикТелМейл = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ЗаказчикТелМейл) Тогда
	  ОбластьШапка.Параметры.ЗаказчикТелМейл = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ЗаказчикТелМейл) Тогда
	  ОбластьШапка.Параметры.ЗаказчикТелМейл = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	ЕМейл = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если обЗначениеНеЗаполнено(ЕМейл) Тогда
	  ЕМейл = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЕМейл) Тогда
		ОбластьШапка.Параметры.ЗаказчикТелМейл = ОбластьШапка.Параметры.ЗаказчикТелМейл + ", " + ЕМейл;
	КонецЕсли;
	
	Плательщик = ЭтотОбъект.Контрагент;
	ОбластьШапка.Параметры.Плательщик = Плательщик.НаименованиеПолное;
	ОбластьШапка.Параметры.ПлательщикАдрес =  киПолучитьПредставлениеКИ(Плательщик, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ПлательщикАдрес) Тогда
	  ОбластьШапка.Параметры.ПлательщикАдрес =  киПолучитьПредставлениеКИ(Плательщик, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ПлательщикАдрес) Тогда
	  ОбластьШапка.Параметры.ПлательщикАдрес =  киПолучитьПредставлениеКИ(Плательщик, Справочники.ВидыКонтактнойИнформации.АдресЮридический);		
	КонецЕсли;
	Если ЗначениеЗаполнено(Плательщик.ИНН) Тогда
		ОбластьШапка.Параметры.ПлательщикИНН = Плательщик.ИНН;
		Если ЗначениеЗаполнено(Плательщик.КПП) Тогда
			ОбластьШапка.Параметры.ПлательщикИНН = ОбластьШапка.Параметры.ПлательщикИНН + "/" + Плательщик.КПП;
		КонецЕсли;
	КонецЕсли;
 	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	ОбластьШапка.Параметры.ДатаМашинозаезда = Формат(ДатаМашинозаезда, "ДЛФ=ДВ");
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОкончания) Тогда
		ОбластьШапка.Параметры.ДатаВыполнения = Формат(ЭтотОбъект.ДатаОкончания, "ДЛФ=ДВ");
	Иначе
		ОбластьШапка.Параметры.ДатаВыполнения = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=ДВ");
	КонецЕсли;
	ОбластьШапка.Параметры.ДатаЗакрытия = Формат(ЭтотОбъект.ДатаЗакрытия, "ДЛФ=ДВ");
	ОбластьШапка.Параметры.МастерПриемщик = ЭтотОбъект.Диспетчер.Наименование;	  	  
	ОбластьШапка.Параметры.Номер = ЭтотОбъект.Номер;
	ОбластьШапка.Параметры.ВидРемонта = ЭтотОбъект.ВидРемонта;
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	ОбластьШапка.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ЭтотОбъект.ДатаМашинозаезда);
	Модель = Автомобиль.Модель;
	ОбластьШапка.Параметры.Модель = Модель.Наименование;
	ОбластьШапка.Параметры.Марка = Модель.Марка.Наименование;
	ОбластьШапка.Параметры.ВИН = ЭтотОбъект.Автомобиль.VIN;	
	//ОбластьШапка.Параметры.НомерДвигателя = ЭтотОбъект.Автомобиль.НомерДвигателя;	
 	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ЭтотОбъект.ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ОбластьШапка.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ОбластьШапка.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");		
	КонецЕсли;                         
	
	//СМГ_Сообщить("Пробег = <"+Пробег+">");
	
	Если СокрЛП(Пробег) <> "" Тогда
		Если ЭтотОбъект.Пробег > Пробег Тогда
			ОбластьШапка.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	 	КонецЕсли;
	КонецЕсли;
 	
	//ОбластьШапка.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, "ДФ=гггг");	  	  
	ОбластьШапка.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д");
  	
	ТабДокумент.Вывести(ОбластьШапка);
	
	ФорматВыводаСуммы      = обПраво("ФорматВыводаСуммы", Права);
	ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества", Права);
	
	// Работы
	ОбластьУслуги = Макет.ПолучитьОбласть("Услуги");
	ОбластьШапкаУслуг = ОбластьУслуги.ПолучитьОбласть("ШапкаУслуг");
	ОбластьСтрокаУслуг		        = Макет.ПолучитьОбласть("СтрокаРабот");
	ОбластьИтоговПоСтраницеУслуги	= Макет.ПолучитьОбласть("ИтогиПоСтраницеРабот");
	ОбластьПодвалУслуг		        = Макет.ПолучитьОбласть("ПодвалУслуги");
	
	КоличествоРабот = ЭтотОбъект.Работы.Количество();
	ИтогоСуммаСкидкиРабот = 0;
	ИтогоСуммаНДС = 0;
	ИтогоСуммаРабот = 0;
	Если КоличествоРабот > 0 Тогда
		//Вывод шапки табличной части работ(услуг)
		ТабДокумент.Вывести(ОбластьУслуги);

		НомерСтраницы = 2;
		НомерСтраницыПред = 2;

		//Вывод табличной части работ
		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки", 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалУслуг);		  	  
		Ном	= 0;
		Для Каждого СтрокаРабот Из ЭтотОбъект.Работы Цикл
			Ном = Ном + 1;
			ОбластьСтрокаУслуг.Параметры.НомСтр = Ном;
			ОбластьСтрокаУслуг.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаРабот.Работа, ИмяРеквизитаКода, Права);
			ОбластьСтрокаУслуг.Параметры.Наименование = СтрокаРабот.Работа.НаименованиеПолное;
			ОбластьСтрокаУслуг.Параметры.Коэффициент = Формат(СтрокаРабот.Коэффициент, "ЧЦ=10; ЧДЦ=3");
 			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаУслуг, ОбластьШапкаУслуг);
  		КонецЦикла; 
  	КонецЕсли;
	
	// Товары
	ОбластьДетали = Макет.ПолучитьОбласть("Детали");
	ОбластьШапкаДеталей = ОбластьДетали.ПолучитьОбласть("ШапкаДеталей");
	ОбластьСтрокаДеталей	        = Макет.ПолучитьОбласть("СтрокаДеталей");
	ОбластьИтоговПоСтраницеДетали	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталей");
	ОбластьПодвалДеталей	        = Макет.ПолучитьОбласть("ПодвалДетали");
	
	ИтогоСуммаСкидкиТоваров  = 0;
	ИтогоСуммаТоваров = 0;
	КоличествоТоваров = ЭтотОбъект.Товары.Количество(); 
	Если КоличествоТоваров > 0 Тогда
		//Вывод шапки табличной части работ(услуг)
		ТабДокумент.Вывести(ОбластьДетали);

		НомерСтраницы = 2;
		НомерСтраницыПред = 2;

		//Вывод табличной части товаров
		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки", 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалДеталей);		  	  
		Ном	= 0;
		Для каждого СтрокаТоваров Из ЭтотОбъект.Товары Цикл
			Ном = Ном + 1;
			ОбластьСтрокаДеталей.Параметры.НомСтр = Ном;
			ОбластьСтрокаДеталей.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура, ИмяРеквизитаКода, Права);
			ОбластьСтрокаДеталей.Параметры.Наименование = СтрокаТоваров.Номенклатура.НаименованиеПолное;
			ОбластьСтрокаДеталей.Параметры.Количество = Формат(СтрокаТоваров.Количество, ФорматВыводаКоличества);
			ОбластьСтрокаДеталей.Параметры.ЕдИзм = СтрокаТоваров.ЕдиницаИзмерения;
 			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаДеталей, ОбластьШапкаДеталей);
		КонецЦикла; 

 	КонецЕсли;
  	
	// Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");	
 	ТабДокумент.Вывести(ОбластьПодвал);
 	
	//////////////////////////////////////////////////////
	// Нижние колонтитулы
	НижнийКолонтитул = ТабДокумент.НижнийКолонтитул;
	НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	
	НижнийКолонтитул.ТекстСлева = 
	"___________________/_____________________________/
	| подпись Заказчика       Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстСправа = 
	"____________________/"+ФИО_(ЭтотОбъект.Диспетчер)+"/
	|подпись Исполнителя      Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстВЦентре = "Заказ-наряд № " + СокрЛП(ЭтотОбъект.Номер) + ", страница [&НомерСтраницы] из [&СтраницВсего]";
	
	НижнийКолонтитул.Шрифт = Новый Шрифт("Arial", 7);
	НижнийКолонтитул.Выводить = Истина;
	НижнийКолонтитул.НачальнаяСтраница = 1;
	
	ТабДокумент.ПолеСверху              = 5;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 5;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;

КонецФункции  //ПечатьЭксидГарантийныйЗаказНаряд(ТабДокумент)

Функция ПечатьДокументИсполнителя(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	Макет = ПолучитьМакет("МакетДокументИсполнителя");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	Организация = ЭтотОбъект.Организация;
	ОбластьШапка.Параметры.Организация = Организация.Наименование;
	ОбластьШапка.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(ЭтотОбъект.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ТелефонОрганизации = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	ОбластьШапка.Параметры.ИННОрганизации = Организация.ИНН;

	Заказчик = ЭтотОбъект.Заказчик;
	Попытка
	  Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
		  Заказчик = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
	  КонецЕсли;			  
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
	  Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;	  	
	ОбластьШапка.Параметры.Заказчик = Заказчик.Наименование;
	ОбластьШапка.Параметры.ЗаказчикТел = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ЗаказчикТел) Тогда
	  ОбластьШапка.Параметры.ЗаказчикТел = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ОбластьШапка.Параметры.ЗаказчикТел) Тогда
	  ОбластьШапка.Параметры.ЗаказчикТел = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	ДатаМашинозаезда = ЭтотОбъект.ДатаМашинозаезда;
	ОбластьШапка.Параметры.Номер = ЭтотОбъект.Номер;
	
	Автомобиль = ЭтотОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	ОбластьШапка.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	Модель = Автомобиль.Модель;
	ОбластьШапка.Параметры.Модель = Модель.Наименование;
	ОбластьШапка.Параметры.Марка = Модель.Марка.Наименование;
	ОбластьШапка.Параметры.ВИН = ЭтотОбъект.Автомобиль.VIN;	
	//ОбластьШапка.Параметры.НомерДвигателя = ЭтотОбъект.Автомобиль.НомерДвигателя;	
	Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
	Если Пробег = 0 Тогда
		ОбластьШапка.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
	Иначе
		ОбластьШапка.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");		
	КонецЕсли;
	//ОбластьШапка.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, "ДФ=гггг");	  	  
	ОбластьШапка.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д");
	
	//// попытаемся напечатать ШК
	//ОбработкаОбъектШтрихКоды=Обработки.ШтрихКоды.Создать();
	//ОбработкаОбъектШтрихКоды.Объект=ЭтотОбъект;
	//ОбработкаОбъектШтрихКоды.ПрочитатьЗаполнитьШтрихКоды();
	//Если ОбработкаОбъектШтрихКоды.Состав.Количество()>0 Тогда
	//  ШК=ОбработкаОбъектШтрихКоды.Состав[0].ШтрихКод;
	//Иначе
	//  ШК="";
	//КонецЕсли; 
	//Попытка
	//  Если ПустаяСтрока(ШК) Тогда
	//	  ОбластьШапка.Рисунки.Удалить(ОбластьШапка.Рисунки.ШК);
	//  Иначе
	//	  ПрефиксВесовогоШК=Константы.ПрефиксВесовогоШК.Получить();
	//	  ОбластьШапка.Рисунки.ШК.Объект.ТипКода=Число(НЕ (СтрДлина(ШК)=8 И Число(Лев(ШК,2))<>ПрефиксВесовогоШК));
	//	  ДлинаШК=?(ОбластьШапка.Рисунки.ШК.Объект.ТипКода=0,8,13);
	//	  ШК=ШК+"0000000000000"; ШК=Лев(ШК,ДлинаШК-1+ОбластьШапка.Рисунки.ШК.Объект.СодержитКС);
	//	  ОбластьШапка.Рисунки.ШК.Объект.Сообщение=ШК;
	//  КонецЕсли;
	//Исключение
	//КонецПопытки;
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	ОбластьДопДанные = Макет.ПолучитьОбласть("ДопДанные");
	ТабДокумент.Вывести(ОбластьДопДанные); 
	СтрокаДопДанных  = Макет.ПолучитьОбласть("СтрокаДопДанных"); 
	
	СтруктураДопДанных = Новый Соответствие;
	СтруктураДопДанных.Вставить("Согласен на комплиментарную мойку", ?(ЭтотОбъект.СогласенНаКомплиментарнуюМойку,"Да","Нет"));
	СтруктураДопДанных.Вставить("Согласен на комплиментарный долив жидкостей",?(ЭтотОбъект.СогласенНаКомплиментарныйДоливЖидкостей,"Да","Нет"));
	СтруктураДопДанных.Вставить("Способ приёмки автомобиля",ЭтотОбъект.СпособПриёмкиАвтомобиля);
	Для Каждого Строка Из СтруктураДопДанных Цикл
		СтрокаДопДанных.Параметры.НазваниеДополнения = Строка.Ключ    ;
		СтрокаДопДанных.Параметры.ЗначениеДополнения = Строка.Значение;
		ТабДокумент.Вывести(СтрокаДопДанных);
	КонецЦикла;     
	
	// Причины обращения
	ОбластьШапкаПричин = Макет.ПолучитьОбласть("ШапкаПричин");
	ОбластьСтрокаПричина = Макет.ПолучитьОбласть("СтрокаПричина");
	
	МассивПричин = Новый Массив();
	Для сч = 1 По СтрЧислоСтрок(ЭтотОбъект.ПричинаОбращения) Цикл
		МассивПричин.Добавить(СтрПолучитьСтроку(ЭтотОбъект.ПричинаОбращения, сч));
	КонецЦикла;
	Если ЗначениеЗаполнено(ЭтотОбъект.ОписаниеДефекта) Тогда
		МассивПричин.Добавить(ЭтотОбъект.ОписаниеДефекта);
	КонецЕсли;
	
	КоличествоПричин = МассивПричин.Количество();
	Если КоличествоПричин = 0 Тогда
		МассивПричин.Добавить("Причины обращения в заказ-наряде не указаны");
	КонецЕсли;
	//Вывод шапки причин обращения
	ТабДокумент.Вывести(ОбластьШапкаПричин);

	НомерСтраницы = 2;
	НомерСтраницыПред = 2;
	//Вывод таблицы причин обращения
	СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки", 0, 0);
	  
	Ном	= 0;
	Для Каждого Причина Из МассивПричин Цикл
		Ном = Ном + 1;
		ОбластьСтрокаПричина.Параметры.Номер = Ном;
		ОбластьСтрокаПричина.Параметры.Причина = Причина;

		НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаПричина, ОбластьШапкаПричин,, НомерСтраницы,, Права);
	КонецЦикла; 
	
	// Работы
	ОбластьШапкаРабот = Макет.ПолучитьОбласть("ШапкаРабот");
	ОбластьСтрокаРабота = Макет.ПолучитьОбласть("СтрокаРабота");
	
	КоличествоРабот = ЭтотОбъект.Работы.Количество();
	//Вывод шапки причин обращения
	ТабДокумент.Вывести(ОбластьШапкаРабот);

