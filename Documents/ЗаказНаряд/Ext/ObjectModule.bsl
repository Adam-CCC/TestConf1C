Функция СМГ_НайтиДатуПоследнейРеализацииАвто(Автомобиль)
	
	ДатаРеал = Дата(1,1,1);	
		 	
	Запрос = Новый Запрос;
	
	//Бондаренко++ 20250714
	//Запрос.Текст = 
	//	"ВЫБРАТЬ ПЕРВЫЕ 1
	//	|	РеализацияАвтомобилейАвтомобили.Ссылка.Дата КАК Дата
	//	|ИЗ
	//	|	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
	//	|ГДЕ
	//	|	РеализацияАвтомобилейАвтомобили.Ссылка.Проведен = истина
	// 	|	И РеализацияАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	//	|
	//	|УПОРЯДОЧИТЬ ПО
	//	|	Дата УБЫВ";    
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РеализацияАвтомобилейАвтомобили.Ссылка.Дата КАК Дата
		|ИЗ
		|	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
		|ГДЕ
		|	РеализацияАвтомобилейАвтомобили.Ссылка.Проведен
		|	И РеализацияАвтомобилейАвтомобили.Автомобиль = &Автомобиль
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОтгрузкаАвтомобиляБезреализации.Дата
		|ИЗ
		|	Документ.ОтгрузкаАвтомобиляБезРеализации КАК ОтгрузкаАвтомобиляБезреализации
		|ГДЕ
		|	ОтгрузкаАвтомобиляБезреализации.Проведен
		|	И ОтгрузкаАвтомобиляБезреализации.Автомобиль = &Автомобиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	//Бондаренко++ 20250714	
 	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
   	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДатаРеал = ВыборкаДетальныеЗаписи.Дата;	
		Прервать;
	КонецЦикла;
	
	Возврат ДатаРеал;
 
