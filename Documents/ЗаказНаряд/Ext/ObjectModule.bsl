	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерВладельца = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонВладельца = ТелефонВладельца;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.АдресВладельца = АдресВладельца;
