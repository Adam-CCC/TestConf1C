	ОбластьМакета.Параметры.ДатаНачала = Формат(ЭтотОбъект.ДатаНачала, "ДЛФ=Д");
	ОбластьМакета.Параметры.ДатаОкончания = Формат(ЭтотОбъект.ПлановаяДатаВыдачи, "ДЛФ=Д");
	ОбластьМакета.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	
	// Вывод Шапки Бланка1
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Вывод Шапки таблицы работ и товаров
