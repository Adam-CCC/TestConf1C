	// Вывод таблицы работ и товаров
	ФорматВыводаСуммы      = обПраво("ФорматВыводаСуммы", Права);
	ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества", Права);
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаРаботы");
	КоличествоРабот = ЭтотОбъект.Работы.Количество();
	КоличествоТоваров = ЭтотОбъект.Товары.Количество();
	инд = 0;
	Если КоличествоРабот > КоличествоТоваров Тогда
		Для Каждого СтрокаРаботы Из ЭтотОбъект.Работы Цикл
			Если инд > 7 Тогда
				Прервать;
			КонецЕсли;
			ОбластьМакета.Параметры.Работа = СтрокаРаботы.Работа;
			ОбластьМакета.Параметры.СуммаРабота = Формат(СтрокаРаботы.СуммаВсего, ФорматВыводаСуммы);
			Если инд < КоличествоТоваров Тогда
				ОбластьМакета.Параметры.Товар = ЭтотОбъект.Товары[инд].Номенклатура;
				ОбластьМакета.Параметры.Количество = Формат(ЭтотОбъект.Товары[инд].Количество, ФорматВыводаКоличества);
				ОбластьМакета.Параметры.СуммаТовар = Формат(ЭтотОбъект.Товары[инд].СуммаВсего, ФорматВыводаСуммы);
			Иначе
				ОбластьМакета.Параметры.Товар = "";
				ОбластьМакета.Параметры.Количество = "";
				ОбластьМакета.Параметры.СуммаТовар = "";
			КонецЕсли;
			ТабДокумент.Вывести(ОбластьМакета);
			инд = инд + 1;
		КонецЦикла;
	Иначе                           
		Для Каждого СтрокаТовары Из ЭтотОбъект.Товары Цикл
			Если инд > 7 Тогда
				Прервать;
			КонецЕсли;
			ОбластьМакета.Параметры.Товар = СтрокаТовары.Номенклатура;
			ОбластьМакета.Параметры.Количество = Формат(СтрокаТовары.Количество, ФорматВыводаКоличества);
			ОбластьМакета.Параметры.СуммаТовар = Формат(СтрокаТовары.СуммаВсего, ФорматВыводаСуммы);
			Если инд < КоличествоРабот Тогда
				ОбластьМакета.Параметры.Работа = ЭтотОбъект.Работы[инд].Работа;
				ОбластьМакета.Параметры.СуммаРабота = Формат(ЭтотОбъект.Работы[инд].СуммаВсего, ФорматВыводаСуммы);
			Иначе
				ОбластьМакета.Параметры.Работа = "";
				ОбластьМакета.Параметры.СуммаРабота = "";
			КонецЕсли;
			ТабДокумент.Вывести(ОбластьМакета);
			инд = инд + 1;
		КонецЦикла;
	КонецЕсли;
	
	// Вывод подвала Бланка1
	ОбластьМакета = Макет.ПолучитьОбласть("Бланк1Подвал");  
	ОбластьМакета.Параметры.СуммаДокумента = Формат(ЭтотОбъект.СуммаДокумента, ФорматВыводаСуммы);
	ТабДокумент.Вывести(ОбластьМакета);	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Вывод  Бланка2
	ОбластьМакета = Макет.ПолучитьОбласть("Бланк2");  
	ТабДокумент.Вывести(ОбластьМакета);
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Вывод  Бланка3
	ОбластьМакета = Макет.ПолучитьОбласть("Бланк3");  
	ТабДокумент.Вывести(ОбластьМакета);

	//// Нижние колонтитулы
	//ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение=ВертикальноеПоложение.Низ;
	//ТабДокумент.НижнийКолонтитул.Выводить = Истина;
	//ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	//ДатаРаспечатки = ?(ЗначениеЗаполнено(ДокументОбъект.ДатаРаспечатки), ДокументОбъект.ДатаРаспечатки, ТекущаяДата());
	//ТабДокумент.НижнийКолонтитул.ТекстСлева="Дата распечатки: " + Формат(ДатаРаспечатки,"ДФ = дд.ММ.гггг");
	//ТабДокумент.НижнийКолонтитул.Шрифт = ТабДокумент.ВерхнийКолонтитул.Шрифт;
	ТабДокумент.ПолеСверху              = 0;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 0;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;
КонецФункции

