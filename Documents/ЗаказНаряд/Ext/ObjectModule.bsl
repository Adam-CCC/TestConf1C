Процедура ВывестиТаблицуРекомендаций(ЭтотОбъект, ТаблицаРекомендаций, ТабДокумент, СтатусУстранения)
	  ТаблицаОтбора = ТаблицаРекомендаций.НайтиСтроки(Новый Структура("СтатусУстранения", СтатусУстранения));
	  КоличествоСтрок = ТаблицаОтбора.Количество();
	  Если КоличествоСтрок = 0 Тогда
		  Возврат;
	  КонецЕсли;                                                                                      
	  
	  ВалютаПечатногоДокумента=Справочники.Валюты.НайтиПоКоду("643");
  	  ФорматВыводаСуммы      = обПраво("ФорматВыводаСуммы", Права);
	  ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества", Права);
 	  
	  Макет = ПолучитьМакет("ЕДОСЗаказНаряд");
	  ОбластьШапкаРекомендации = Макет.ПолучитьОбласть("ШапкаРекомендации");
	  ОбластьСтрокаРекомендации = Макет.ПолучитьОбласть("СтрокаРекомендации");
	  ОбластьИтогиПоСтраницеРекомендации = Макет.ПолучитьОбласть("ИтогиПоСтраницеРекомендации");
	  ОбластьПодвалРекомендации = Макет.ПолучитьОбласть("ПодвалРекомендации");
	  
	  //Вывод шапки табличной части рекомендаций
	  НомерСтраницы = 2;
	  СтруктураИтоговПоСтранице = Новый Структура("Сумма, Количество", 0, 0);	  
	  МассивОбластиПодвала = Новый Массив;
	  МассивОбластиПодвала.Добавить(ОбластьПодвалРекомендации);
	  Если СтатусУстранения = Перечисления.СтатусыУстранения.Немедленно Тогда
		  ОбластьШапкаРекомендации.Параметры.СтатусУстранения = "Требуется НЕМЕДЛЕННОЕ устранение:";
	  ИначеЕсли СтатусУстранения = Перечисления.СтатусыУстранения.Срочно Тогда
		  ОбластьШапкаРекомендации.Параметры.СтатусУстранения = "Требуется СРОЧНОЕ устранение:";
	  ИначеЕсли СтатусУстранения = Перечисления.СтатусыУстранения.Рекомендуемо Тогда
		  ОбластьШапкаРекомендации.Параметры.СтатусУстранения = "Рекомендуемые работы:";
	  КонецЕсли;                                           

	  КолонкаКода=дкПолучитьПараметрыРежимаВыводаКодаВДокументах(,Права);
	  
	  ОбластьШапкаРекомендации.Параметры.ИмяКолонкиКодов = КолонкаКода.Синоним;
	  НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьШапкаРекомендации,, , НомерСтраницы, , Права);
	  НомерСтраницыПред = НомерСтраницы;
	  
	  //Вывод табличной части работ
	  Ном	= 0;
	  ИтогоКоличествоРабот  = 0;
	  ИтогоСуммаРабот       = 0;  
	  Для каждого СтрокаРабот Из ТаблицаОтбора Цикл		  
		  Ном = Ном + 1;
		  ОбластьСтрокаРекомендации.Параметры.НомСтр = Ном;
		  ОбластьСтрокаРекомендации.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаРабот.Рекомендация, ИмяРеквизитаКода, Права);
		  ОбластьСтрокаРекомендации.Параметры.Номенклатура = СтрокаРабот.Рекомендация;
		  ОбластьСтрокаРекомендации.Параметры.Наименование = СтрокаРабот.Рекомендация.Наименование;
		  ОбластьСтрокаРекомендации.Параметры.Цена = Формат(СтрокаРабот.Цена, "ЧЦ=15; ЧДЦ=2");
		  ОбластьСтрокаРекомендации.Параметры.Количество = Формат(СтрокаРабот.Количество, ФорматВыводаКоличества);
		  ОбластьСтрокаРекомендации.Параметры.Сумма = Формат(СтрокаРабот.Сумма, ФорматВыводаСуммы);
		  
		  НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаРекомендации, ОбластьШапкаРекомендации,, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоСтрок, МассивОбластиПодвала, Неопределено));
		  
		  // Обновим итоги по документу
		  ИтогоКоличествоРабот  = ИтогоКоличествоРабот + СтрокаРабот.Количество;
		  ИтогоСуммаРабот       = ИтогоСуммаРабот + СтрокаРабот.Сумма;
		  
		  //инициализация итогов по странице
		  Если НомерСтраницы <> НомерСтраницыПред Тогда
			  НомерСтраницыПред = НомерСтраницы;
		  КонецЕсли;	  
		  //обновим итоги по странице
		  дкДобавитьИтогиПоСтранице(СтрокаРабот, СтруктураИтоговПоСтранице);
	  КонецЦикла; 
	  
	  //довыводим последний итог по странице, если страниц больше единицы
	  Если НомерСтраницы > 2 Тогда
		  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтогиПоСтраницеРекомендации, СтруктураИтоговПоСтранице, Права);
	  КонецЕсли;
	  
	  //Вывод подвала табличной части услуг
	  ОбластьПодвалРекомендации.Параметры.Количество = Формат(ИтогоКоличествоРабот, ФорматВыводаКоличества);
	  ОбластьПодвалРекомендации.Параметры.Сумма = Формат(ИтогоСуммаРабот, ФорматВыводаСуммы);
	  
	  ОбластьПодвалРекомендации.Параметры.ЧислоПрописью = обЧислоПрописью(ИтогоСуммаРабот, ВалютаПечатногоДокумента);
	  НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьПодвалРекомендации, , , НомерСтраницы, , Права);
	  
  КонецПроцедуры

Функция РазборСтрокиФИО (СтрокаРазбора) Экспорт 
 ДлинаСтроки = СтрДлина(СтрокаРазбора);
 Индекс = 0;
 СокрФ = "" ;
 Счетчик = 0;
 СтрокаПолученная = "";
 Флаг = Ложь;
 Флаг2 = Ложь;
 Флаг3 = Ложь;
 Пока Индекс < ДлинаСтроки Цикл
  
  СИмволСреза = Сред(СтрокаРазбора,0,Индекс+1);
  Если Флаг = Истина тогда
   СИмволСреза = Прав(СИмволСреза,1)
  КонецЕсли;
  
  Если Счетчик = 1 и Флаг3 = Ложь тогда
   СокрФ = СокрФ + " "+СИмволСреза+ ".";
   Флаг3 = Истина;
  ИначеЕсли  Счетчик = 2 и Флаг3=Истина и Флаг2 = Ложь  тогда  
   СокрФ = СокрФ + " "+СИмволСреза+ ".";
   Флаг2= Истина;
  КонецЕсли; 
  
  Если СИмволСреза = " "  тогда
   Счетчик = Счетчик + 1; 
    
  ИначеЕсли Счетчик <> 1 И Счетчик <> 2 тогда
   СокрФ = СокрФ +СИмволСреза; 
  КонецЕсли; 
  Индекс = Индекс + 1;
  СИмволСреза ="";
  Флаг = Истина;
 КонецЦикла; 
 Возврат СокрФ;  
КонецФункции

