Функция ПечатьЭксидУчетЗатрат(ТабДокумент) Экспорт
	
	ДокументОбъект = ЭтотОбъект;
	
	Если НЕ ДокументОбъект.Проведен Тогда
		//Контроль запрета печати без проведения
		Если НЕ обПраво("ПечатьНепроведенных",Права) Тогда
			Сообщить("Печать заказ-наряда без его проведения запрещена.");
			Возврат Неопределено;
		КонецЕсли; 
	КонецЕсли; 
	//Контроль запрета печати при наличии открытых заказ-нарядов
	Если НЕ обПраво("ПечатьЗаказНарядаПриНаличииОткрытых",Права) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказНаряд.Ссылка) КАК Количество
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|ГДЕ
		|	ЗаказНаряд.Проведен = ЛОЖЬ И ЗаказНаряд.ПометкаУдаления = ЛОЖЬ И
		|	ЗаказНаряд.Заказчик = &Заказчик И
		|	ЗаказНаряд.Ссылка <> &ЭтотДокумент";
		Запрос.УстановитьПараметр("Заказчик",ДокументОбъект.Заказчик);
		Запрос.УстановитьПараметр("ЭтотДокумент",ДокументОбъект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если Выборка.Количество>0 Тогда
				Сообщить("Печать заказ-наряда заказчика "+ДокументОбъект.Заказчик.НаименованиеПолное+" запрещено, так как у него имеются другие открытые заказ-наряды.");
				Возврат Неопределено;
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли; 
 	
	Макет = ПолучитьМакет("ЭксидУчетЗатрат");
 	НомерДляПечати=дкПолучитьНомерДляПечати(ДокументОбъект);	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	
	//Бондаренко++ 20260717
	МаркаАвто = "";
 	Попытка	МаркаАвто = Автомобиль.Модель.Марка; Исключение	КонецПопытки;
 	Если Не обЗначениеНеЗаполнено(МаркаАвто) Тогда
		Если МаркаАвто = Справочники.Марка.ESTEO Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаЭстео");
 		КонецЕсли;
 	КонецЕсли;
	//Бондаренко-- 20260717
 	
	//ОбластьМакета.Параметры.Организация = Организация;
	ОбластьМакета.Параметры.ФирмаПолноеНаименование = спПолучитьНаименование(ДокументОбъект.Организация);
	ОбластьМакета.Параметры.ФирмаАдресЮридический = киПолучитьПредставлениеКИ(ДокументОбъект.Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьМакета.Параметры.НомерДок = НомерДляПечати;
	ОбластьМакета.Параметры.ДатаДок = Формат(ДокументОбъект.Дата,"ДФ=дд.ММ.гггг");
	//ОбластьМакета.Параметры.Заказчик = Заказчик;
	ОбластьМакета.Параметры.ЗаказчикПолноеНаименование = спПолучитьНаименование(ДокументОбъект.Заказчик);
	ОбластьМакета.Параметры.ЗаказчикАдресПочтовый = киПолучитьПредставлениеКИ(ДокументОбъект.Заказчик, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	ОбластьМакета.Параметры.ЗаказчикТелефоны = киПолучитьПредставлениеКИ(ДокументОбъект.Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	Если НЕ обЗначениеНеЗаполнено(ДокументОбъект.Автомобиль) Тогда
		ОбластьМакета.Параметры.АвтомобильГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ДокументОбъект.Автомобиль,Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,ДокументОбъект.ДатаСоздания);
		ОбластьМакета.Параметры.АвтомобильПробег = СокрЛП(Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ДокументОбъект.Автомобиль,Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДокументОбъект.ДатаСоздания));
	КонецЕсли;
	ОбластьМакета.Параметры.Автомобиль = ДокументОбъект.Автомобиль;
	ОбластьМакета.Параметры.АвтомобильКод = ДокументОбъект.Автомобиль.VIN;
	ОбластьМакета.Параметры.АвтомобильМодель = ДокументОбъект.Автомобиль.Модель;
	ОбластьМакета.Параметры.АвтомобильГодВыпуска = Формат(ДокументОбъект.Автомобиль.ГодВыпуска,ФорматПредставленияГодаВыпускаАвтомобиля);
	  // попытаемся напечатать ШК
	  ОбработкаОбъектШтрихКоды=Обработки.ШтрихКоды.Создать();
	  ОбработкаОбъектШтрихКоды.Объект=ДокументОбъект;
	  ОбработкаОбъектШтрихКоды.ПрочитатьЗаполнитьШтрихКоды();
	  Если ОбработкаОбъектШтрихКоды.Состав.Количество()>0 Тогда
		  ШК=ОбработкаОбъектШтрихКоды.Состав[0].ШтрихКод;
	  Иначе
		  ШК="";
	  КонецЕсли; 
	  Попытка
		  Если ПустаяСтрока(ШК) Тогда
			  ОбластьМакета.Рисунки.Удалить(ОбластьМакета.Рисунки.ШК);
		  Иначе
			  ПрефиксВесовогоШК=Константы.ПрефиксВесовогоШК.Получить();
			  ОбластьМакета.Рисунки.ШК.Объект.ТипКода=Число(НЕ (СтрДлина(ШК)=8 И Число(Лев(ШК,2))<>ПрефиксВесовогоШК));
			  ДлинаШК=?(ОбластьМакета.Рисунки.ШК.Объект.ТипКода=0,8,13);
			  ШК=ШК+"0000000000000"; ШК=Лев(ШК,ДлинаШК-1+ОбластьМакета.Рисунки.ШК.Объект.СодержитКС);
			  ОбластьМакета.Рисунки.ШК.Объект.Сообщение=ШК;
		  КонецЕсли; 
	  Исключение
	  КонецПопытки;

	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Услуги");
	ТабДокумент.Вывести(ОбластьМакета);
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаРабот");
	ном =1;
	Для Каждого стр из ДокументОбъект.Работы цикл
		ОбластьМакета.Параметры.НомСтр =ном  ;
		ОбластьМакета.Параметры.Код = стр.Работа.Артикул;
		ОбластьМакета.Параметры.Наименование =  стр.Работа.НаименованиеПолное;
		ОбластьМакета.Параметры.Количество =     стр.Количество;
		ОбластьМакета.Параметры.Цена =          стр.Цена;
		ОбластьМакета.Параметры.Коэффициент =   стр.Коэффициент;
		ОбластьМакета.Параметры.Сумма =        стр.СуммаВсего;
		
		//ОбластьМакета.Параметры.Начало =        стр.Начало;
		//ОбластьМакета.Параметры.Окончание =   стр.Окончание;	
	    Запрос = Новый Запрос();
	    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	  				 |	РегистрацияВремениРабот.Период КАК НачалоРаботы
	  				 |ИЗ
	  				 |	РегистрСведений.РегистрацияВремениРабот КАК РегистрацияВремениРабот
	  				 |ГДЕ
	  				 |	РегистрацияВремениРабот.ПакетРабот = &ПакетРабот  И
	  				 |    РегистрацияВремениРабот.ВидОтметки = ЗНАЧЕНИЕ(Справочник.ВидыОтметокВремени.Работа)
	  				 |УПОРЯДОЧИТЬ ПО
	  				 |	НачалоРаботы";

	    Запрос.УстановитьПараметр("ПакетРабот", стр.ПакетРабот);
	    Рез = Запрос.Выполнить().Выбрать();
		НачалоРаботы = Неопределено;
		Если Рез.Следующий() Тогда
			НачалоРаботы = Рез.НачалоРаботы;
	  		ОбластьМакета.Параметры.Начало = НачалоРаботы;
		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	РегистрацияВремениРабот.КонецРаботы КАК КонецРаботы
		               |ИЗ
		               |	РегистрСведений.РегистрацияВремениРабот КАК РегистрацияВремениРабот
		               |ГДЕ
		               |	РегистрацияВремениРабот.ПакетРабот = &ПакетРабот И
		               |    РегистрацияВремениРабот.ВидОтметки = ЗНАЧЕНИЕ(Справочник.ВидыОтметокВремени.Работа)
		               |УПОРЯДОЧИТЬ ПО
		               |	КонецРаботы УБЫВ";

		Рез = Запрос.Выполнить().Выбрать();
		КонецРаботы = Неопределено;
		Если Рез.Следующий() Тогда
			КонецРаботы = Рез.КонецРаботы;
			ОбластьМакета.Параметры.Окончание = КонецРаботы;
	  	КонецЕсли;
		
		ном =ном+1;
		ТабДокумент.Вывести(ОбластьМакета);	
	КонецЦикла;	
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.Приемщик =  спПолучитьНаименование(ДокументОбъект.Диспетчер);
	//ОбластьМакета.Параметры.Исполнитель =  спПолучитьНаименование(ДокументОбъект.Работы[0].Исполнитель);
	ТабДокумент.Вывести(ОбластьМакета);
	ТабДокумент.Автомасштаб = Истина;
	//ТабДокумент.показать() ;
	Возврат ТабДокумент;

КонецФункции //ПечатьУчетЗатрат
  
