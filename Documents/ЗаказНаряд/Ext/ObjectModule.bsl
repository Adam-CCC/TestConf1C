// Формирует печатную форму "ЕДОСРабочаяЗаявка"
// Возвращает сформированный табличный документ:
Функция ПечатьЕДОСРабочаяЗаявка(ТабДокумент) Экспорт
	Макет = ПолучитьМакет("ЕДОСРабочаяЗаявка");
	
	НомерДляПечати=дкПолучитьНомерДляПечати(ЭтотОбъект);
	
	//Вывод шапки документа
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.НомерДок = НомерДляПечати;
	ОбластьМакета.Параметры.ДатаСоздания = Формат(ДатаСоздания, "ДФ = дд.ММ.гггг");
	ОбластьМакета.Параметры.Заказчик = Заказчик;
	ОбластьМакета.Параметры.ЗаказчикПолноеНаименование = спПолучитьНаименование(Заказчик);
	ОбластьМакета.Параметры.ЗаказчикАдресПочтовый = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	
	Если обЗначениеНеЗаполнено(_г_ДоверенноеЛицоПлательщика) Тогда
		ОбластьМакета.Параметры.ДоверенноеЛицоПолноеНаименование = "--------";
		ОбластьМакета.Параметры.ДоверенноеЛицоАдресПочтовый = "--------";;
	Иначе
		ОбластьМакета.Параметры.ДоверенноеЛицоПолноеНаименование = спПолучитьНаименование(_г_ДоверенноеЛицоПлательщика);
		ОбластьМакета.Параметры.ДоверенноеЛицоАдресПочтовый = киПолучитьПредставлениеКИ(_г_ДоверенноеЛицоПлательщика, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	КонецЕсли;
	
	//ОбластьМакета.Параметры.ЗаказчикТелефоны = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	Если НЕ обЗначениеНеЗаполнено(Автомобиль) Тогда
		ОбластьМакета.Параметры.Автомобиль = Автомобиль.Модель;
		ОбластьМакета.Параметры.АвтомобильМодель = Автомобиль.Модель.Наименование;
		ОбластьМакета.Параметры.АвтомобильДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=D");		
		ОбластьМакета.Параметры.АвтомобильГодВыпуска = Формат(Автомобиль.ГодВыпуска,ФорматПредставленияГодаВыпускаАвтомобиля);
 		 
		ОбластьМакета.Параметры.АвтомобильПробег = Формат(Пробег,"ЧЦ=10");
		ОбластьМакета.Параметры.АвтомобильГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,ДатаСоздания);
		ОбластьМакета.Параметры.АвтомобильКод = Автомобиль.VIN;
 	КонецЕсли; 
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	Причина=СокрЛП(ПричинаОбращения);
 	ОбластьМакета = Макет.ПолучитьОбласть("ПричинаОбращения");
	ОбластьМакета.Параметры.ПричинаОбращения = Причина;
 	ТабДокумент.Вывести(ОбластьМакета);
	
  	ОбластьМакета = Макет.ПолучитьОбласть("ОсновнойТекст");
	ТабДокумент.Вывести(ОбластьМакета);

	ОбластьМакетаШапкаработ = Макет.ПолучитьОбласть("Шапкаработ");
	ТабДокумент.Вывести(ОбластьМакетаШапкаработ);
	
	Счетчик = 0;
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаРабот");
	Для каждого Стр Из ЭтотОбъект.Работы Цикл
		Счетчик = Счетчик + 1;
		ОбластьМакета.Параметры.НомПП = Счетчик;
		ОбластьМакета.Параметры.Артикул = Стр.Работа.Артикул;
		ОбластьМакета.Параметры.Наименование = Стр.Работа.Наименование;
		ОбластьМакета.Параметры.Количество = Стр.Количество * Стр.Коэффициент;		
 		ТабДокумент.Вывести(ОбластьМакета);	      
		Если Счетчик = 8 Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();		
			ТабДокумент.Вывести(ОбластьМакетаШапкаработ);
  		КонецЕсли;
 	КонецЦикла;

	ОбластьМакета = Макет.ПолучитьОбласть("ПустоГрафка");
  	Для Счетчик_ = Счетчик+1 По Счетчик+5 Цикл
 		ТабДокумент.Вывести(ОбластьМакета);
		Если Счетчик_ = 8 Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();		
			ТабДокумент.Вывести(ОбластьМакетаШапкаработ);
			ТабДокумент.Вывести(ОбластьМакета);
 		КонецЕсли;
  	КонецЦикла;
 	
	//Вывод подвала документа
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
 	ОбластьМакета.Параметры.Мастер = Мастер;
	ОбластьМакета.Параметры.МастерПолноеНаименование = Мастер.Наименование;
	ОбластьМакета.Параметры.ДатаПечати = Формат(ТекущаяДата(),"ДЛФ=D");
	ТабДокумент.Вывести(ОбластьМакета);
	
	//Бондаренко++ 20220318
	ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;
	//Бондаренко-- 20220318

	ТабДокумент.Автомасштаб = Истина;
	
	Возврат ТабДокумент;
	
КонецФункции
