Функция СМГ_ПолучитьСписокВыбораЗапрещенныхВидовРемонта() Экспорт 
 
 	СЗ_ЗапрещенныхВидовРемонта = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗапрещенныеВидыРемонта.Пользователь,
	|	ЗапрещенныеВидыРемонта.ВидРемонта
	|ИЗ
	|	РегистрСведений.ЗапрещенныеВидыРемонта КАК ЗапрещенныеВидыРемонта
	|ГДЕ
	|	ЗапрещенныеВидыРемонта.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь",ПараметрыСеанса.Пользователь);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СЗ_ЗапрещенныхВидовРемонта.Добавить(ВыборкаДетальныеЗаписи.ВидРемонта);
	КонецЦикла;
	
 	Если НЕ ( РольДоступна("ПолныеПрава") ИЛИ РольДоступна("СМ_КассирОформитель") ИЛИ РольДоступна("СМ_АудиторСервиса") ) Тогда
		СЗ_ЗапрещенныхВидовРемонта.Добавить(Справочники.ВидыРемонта.ДополнительноеОборудование);		
		СЗ_ЗапрещенныхВидовРемонта.Добавить(Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером);		
	КонецЕсли;

	Если НЕ ( РольДоступна("ПолныеПрава") ИЛИ РольДоступна("СМ_КассирОформитель") ) Тогда
 		СЗ_ЗапрещенныхВидовРемонта.Добавить(Справочники.ВидыРемонта.ДополнительноеОборудованиеСубподряд);		
	КонецЕсли;              
 	
	Возврат СЗ_ЗапрещенныхВидовРемонта;
    	
КонецФункции //СМГ_ПолучитьСписокВыбораЗапрещенныхВидовРемонта(Элемент,Права,ОбъектДокумент)

Функция СМГ_АвтоЕстьНаСкладе(Автомобиль,Контрагент,Дата) Экспорт
	
	ЕстьНаСкладе = Истина;
	
 	Попытка
		КонтрагентСтаричков = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН","262804044870");
	Исключение
		КонтрагентСтаричков = Справочники.Контрагенты.ПустаяСсылка();
	КонецПопытки;
	
	Если Не обЗначениеНеЗаполнено(КонтрагентСтаричков) Тогда	
		Если Не обЗначениеНеЗаполнено(Контрагент) Тогда
			Если Контрагент = КонтрагентСтаричков Тогда
				Возврат ЕстьНаСкладе;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Возврат ЕстьНаСкладе;	
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&ТекущаяДата, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки";
	
	Если обЗначениеНеЗаполнено(Дата) Тогда
		Запрос.Параметры.Вставить("ТекущаяДата", ТекущаяДата());
	Иначе	
		Запрос.Параметры.Вставить("ТекущаяДата", Дата);
	КонецЕсли; 
	
	Запрос.Параметры.Вставить("Автомобиль", Автомобиль);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
 	Если Результат[0].КоличествоОстаток > 0 Тогда
		ЕстьНаСкладе = Истина;
	Иначе
 		ЕстьНаСкладе = Ложь;
	КонецЕсли;               
	
	Возврат ЕстьНаСкладе;
 	
КонецФункции // СМГ_АвтоЕстьНаСкладе(Автомобиль,Контрагент,Дата)

Функция СМГ_ПередЗаписью(РежимЗаписи)
	
	ФлОтказ = Ложь;
	
	//Бондаренко++ 20250417
	Если ЭтоНовый() Тогда
	    СМ_ДатаСоздания=ТекущаяДата();
 	КонецЕсли; 
 	//Бондаренко-- 20250417
	
	//Бондаренко++ 20241025
	Если Дата >= Дата(2024,10,1) Тогда
		Если Состояние = Справочники.ВидыСостоянийЗаказНарядов.Отказ Тогда
			// фильтр по заказу
			ДопОтбор = "";
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказПокупателя") И ЗначениеЗаполнено(ДокументОснование) Тогда
				ДопОтбор = " ИЛИ Заказ = &ЗаказОснование";
			КонецЕсли;
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	ЗаказыПокупателейОстатки.Номенклатура КАК Номенклатура,
			|	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
			|	ЕСТЬNULL(ЗаказыПокупателейОстатки.ЗаказаноОстаток, 0) КАК Заказано,
			|	ЕСТЬNULL(ЗаказыПокупателейОстатки.РезервОстаток, 0) КАК Резерв
			|ИЗ
			|	РегистрНакопления.ЗаказыПокупателей.Остатки(,Заказ ССЫЛКА Документ.ЗаказПокупателя И Заказ.ДокументОснование = &ДокументОснование" + ДопОтбор + ") КАК ЗаказыПокупателейОстатки
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура,
			|	ХарактеристикаНоменклатуры";
			Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
			Запрос.УстановитьПараметр("ЗаказОснование",    ДокументОснование);
			
			Выборка=Запрос.Выполнить().Выбрать();
			Если Выборка.Количество() > 0 Тогда
				СМГ_Сообщить("По заказ-наряду <"+СокрЛП(Ссылка)+"> существуют заказанные/зарезервированные детали:",СтатусСообщения.Информация);
				ИмяРеквизитаКода=дкПолучитьПараметрыРежимаВыводаКодаВДокументах(,ЭтотОбъект).Имя;
				Пока Выборка.Следующий() Цикл
					Код=дкПолучитьЗначениеКолонкиКода(Выборка.Номенклатура,ИмяРеквизитаКода,ЭтотОбъект);
					ЕдИзм=СокрЛП(Выборка.Номенклатура.БазоваяЕдиницаИзмерения);
					ТекстСообщения="Деталь ["+Код+"] """+СокрЛП(Выборка.Номенклатура)+"""";
					Если НЕ обЗначениеНеЗаполнено(Выборка.ХарактеристикаНоменклатуры) Тогда
						ТекстСообщения=ТекстСообщения+" с характеристикой "+СокрЛП(Выборка.ХарактеристикаНоменклатуры);
					КонецЕсли;
					ТекстСообщения=ТекстСообщения+" заказана под заказ-наряд в количестве "+Формат(Выборка.Заказано,"ЧДЦ=2; ЧН=0,00")+" "+ЕдИзм;
					Если Выборка.Резерв<>0 Тогда
						ТекстСообщения=ТекстСообщения+" и зарезервирована в количестве "+Формат(Выборка.Резерв,"ЧДЦ=2; ЧН=0,00")+" "+ЕдИзм;
					КонецЕсли;
					ТекстСообщения=ТекстСообщения+".";
					#Если Клиент Тогда
	 					СМГ_Сообщить(ТекстСообщения,СтатусСообщения.Информация);
					#КонецЕсли	
				КонецЦикла;
				#Если Клиент Тогда
 					СМГ_Сообщить("Для перевода в состояние ""Отказ"" произведите корректировку/снятие резервов данных деталей.",СтатусСообщения.ОченьВажное);
				#КонецЕсли	
				//Если Не РольДоступна("ПолныеПрава") Тогда  
					флОтказ=Истина; 
					Возврат флОтказ;
				//КонецЕсли;  
			КонецЕсли;	
		КонецЕсли;
