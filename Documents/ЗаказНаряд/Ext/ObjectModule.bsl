	//Бондаренко-- 20221019	
		Если НЕ дкОбработкаЗаполнения(ЭтотОбъект, Основание, Копирование) Тогда Возврат; КонецЕсли;
	//Бондаренко++ 20221019
	КонецЕсли;             
	//Бондаренко-- 20221019
 	
