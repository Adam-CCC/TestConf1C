Функция ПолучитьПроактивныеКонтакты()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РабочийЛистСервиса.Ссылка
	               |ИЗ
	               |	Документ.РабочийЛистСервиса КАК РабочийЛистСервиса
	               |ГДЕ
	               |	РабочийЛистСервиса.Проведен
	               |	И РабочийЛистСервиса.ДокументОснование = &Ссылка
	               |	И РабочийЛистСервиса.УчастникПрограммыПроактивныйКонтакт";
				   
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
