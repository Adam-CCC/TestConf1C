Функция ПечатьУАЗЕдиныйСервисныйБланк(ТабДокумент) Экспорт
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	Макет = ПолучитьМакет("УАЗЕдиныйСервисныйБланк");	  
	ОбластьМакета = Макет.ПолучитьОбласть("Бланк1Шапка");  
	Организация = ЭтотОбъект.Организация;
	
	// Вывод шапки документа
	ОбластьМакета.Параметры.Номер = ЭтотОбъект.Номер;
	ОбластьМакета.Параметры.Исполнитель = Организация.Наименование;
