Процедура ОкончаниеПриемки() Экспорт 
// проверим наличие открытых интервалов
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РаботыТехнологическогоПроцесаПоДЦ.Работа КАК Авторабота
	               |ИЗ
	               |	РегистрСведений.РаботыТехнологическогоПроцесаПоДЦ КАК РаботыТехнологическогоПроцесаПоДЦ
	               |ГДЕ
	               |	(РаботыТехнологическогоПроцесаПоДЦ.Работа = &РаботаПриемка
	               |			ИЛИ РаботыТехнологическогоПроцесаПоДЦ.Работа = &РаботаВыдача)
	               |	И РаботыТехнологическогоПроцесаПоДЦ.ДилерскийЦентр = &ДилерскийЦентр";
	Запрос.УстановитьПараметр("ДилерскийЦентр",ПодразделениеКомпании.ДилерскийЦентр);			   
	Запрос.УстановитьПараметр("РаботаПриемка",Справочники.Автоработы.Приемка);	
	Запрос.УстановитьПараметр("РаботаВыдача",Справочники.Автоработы.Выдача);	

