	Если НЕ обЗначениеНеЗаполнено(Автомобиль) И Не обЗначениеНеЗаполнено(ВидРемонта) И Не обЗначениеНеЗаполнено(Организация) Тогда
		Если ВидРемонта=Справочники.ВидыРемонта.РемонтБуАвтомобиля ИЛИ ВидРемонта=Справочники.ВидыРемонта.ПредпродажнаяПодготовка Тогда
			
			Запрос = Новый Запрос();
			
			Запрос.Текст = "ВЫБРАТЬ
			|	ОстаткиАвтомобилейОстатки.Автомобиль,
			|	ОстаткиАвтомобилейОстатки.СкладКомпании.Организация КАК Организация,
			|	ОстаткиАвтомобилейОстатки.КоличествоОстаток,
			|	ОстаткиАвтомобилейОстатки.Партия.Ссылка
			|ИЗ
