Процедура ПроверитьСуммыИЦены() Экспорт
	
	БезОшибок = Истина;
	
  	Для Каждого стрТовары Из Товары Цикл
		СуммаДляЧека = СтрТовары.СуммаВсего;
		Если СтрТовары.Количество*СтрТовары.Коэффициент > 0 Тогда                            
			КолДляЧека = Окр(СтрТовары.Количество * СтрТовары.Коэффициент,3);
			ЦенаДляЧека = Окр ( СуммаДляЧека / КолДляЧека, 2);
			СуммаДляЧекаВычисляемая = Окр( ЦенаДляЧека * КолДляЧека, 2);
			Если СуммаДляЧекаВычисляемая - СуммаДляЧека  <> 0 Тогда
				СМГ_Сообщить("Ошибка! В строке № "+СокрЛП(СтрТовары.НомерСтроки)+" таблицы ""Товары"" вместо ""Всего"" "+
				Формат(СуммаДляЧека,"ЧЦ=15; ЧДЦ=2")+" должно быть указано "+
				Формат(СуммаДляЧекаВычисляемая,"ЧЦ=15; ЧДЦ=2")+" для ["+СокрЛП(СтрТовары.Номенклатура.Артикул)+"] "+СокрЛП(СтрТовары.Номенклатура.Наименование)); 
				БезОшибок = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	Для Каждого стрРаботы Из Работы Цикл
		СуммаДляЧека = стрРаботы.СуммаВсего;
		Если стрРаботы.Количество*стрРаботы.Коэффициент > 0 Тогда                            
			КолДляЧека = Окр(стрРаботы.Количество * стрРаботы.Коэффициент,3);
			ЦенаДляЧека = Окр ( СуммаДляЧека / КолДляЧека, 2);
			СуммаДляЧекаВычисляемая = Окр( ЦенаДляЧека * КолДляЧека, 2);
			Если (СуммаДляЧекаВычисляемая - СуммаДляЧека ) <> 0 Тогда
				СМГ_Сообщить("Ошибка! В строке № "+СокрЛП(стрРаботы.НомерСтроки)+" таблицы ""Работы"" вместо ""Всего"" "+
				Формат(СуммаДляЧека,"ЧЦ=15; ЧДЦ=2")+" должно быть указано "+
				Формат(СуммаДляЧекаВычисляемая,"ЧЦ=15; ЧДЦ=2")+" для ["+СокрЛП(СтрРаботы.Работа.Артикул)+"] "+СокрЛП(СтрРаботы.Работа.Наименование));
				БезОшибок = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Если БезОшибок Тогда
		СМГ_Сообщить("Ошибок сумм и цен не обнаружено"); 		
 	КонецЕсли;
	
КонецПроцедуры
