	ВыполяетсяАвторабота = Справочники.Автоработы.ПустаяСсылка();
	Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	
	Если Автоработы.Найти(Справочники.Автоработы.Приемка,"Авторабота")<>Неопределено или Автоработы.Найти(Справочники.Автоработы.Выдача,"Авторабота")<>Неопределено  тогда
		//Запрос = НОвый Запрос;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РегистрацияВремениСотрудника.Период КАК Период,
		|	РегистрацияВремениСотрудника.Сотрудник КАК Сотрудник,
		|	РегистрацияВремениСотрудника.ВидОтметки КАК ВидОтметки,
		|	РегистрацияВремениСотрудника.КонецРаботы КАК КонецРаботы,
		|	РегистрацияВремениСотрудника.Продолжительность КАК Продолжительность,
		|	РАЗНОСТЬДАТ(РегистрацияВремениСотрудника.Период, &ТекДата, МИНУТА) / 60 КАК Часы,
		|	РегистрацияВремениСотрудника.Авторабота
		|ИЗ
		|	РегистрСведений.РегистрацияВремениРаботТехПроцесс КАК РегистрацияВремениСотрудника
		|ГДЕ
		|	РегистрацияВремениСотрудника.ВидОтметки = &Работа
		|	И РегистрацияВремениСотрудника.Продолжительность = 0
		|	И РегистрацияВремениСотрудника.КонецРаботы = &ПустаяДата
		|	И РегистрацияВремениСотрудника.Период МЕЖДУ &НАчПериода И &КонПериода
		|	И РегистрацияВремениСотрудника.ЗаказНаряд = &ЗаказНаряд";
		
		Запрос.УстановитьПараметр("ЗаказНаряд"  , Ссылка);
		Запрос.УстановитьПараметр("ТекДата"  , ТекущаяДата());
		Запрос.УстановитьПараметр("Работа"     , Справочники.ВидыОтметокВремени.Работа);
		Запрос.УстановитьПараметр("ПустаяДата" , Дата("00010101"));
		Запрос.УстановитьПараметр("НАчПериода"  , НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("КонПериода"  , КонецДня(ТекущаяДата()));
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если  РезультатЗапроса.Найти(Справочники.Автоработы.Приемка,"Авторабота")<>Неопределено тогда
			
			СтрокаЗапроса =   РезультатЗапроса.Найти(Справочники.Автоработы.Приемка,"Авторабота");
			
			ВыполяетсяАвторабота = Справочники.Автоработы.Приемка;
			Сотрудник = Диспетчер;
			
		КонецЕсли;
		
		
		Если  РезультатЗапроса.Найти(Справочники.Автоработы.Выдача,"Авторабота")<>Неопределено тогда
			
			СтрокаЗапроса =   РезультатЗапроса.Найти(Справочники.Автоработы.Выдача,"Авторабота");
			
			ВыполяетсяАвторабота = Справочники.Автоработы.Выдача;
			Сотрудник = Диспетчер;
			
		КонецЕсли;
	КонецЕсли;	
	
	
	 Попытка
	НаборЗаписей = РегистрыСведений.РегистрацияВремениСотрудника.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(СтрокаЗапроса.Период);
	НаборЗаписей.Отбор.Сотрудник.Установить(СтрокаЗапроса.Сотрудник);
	НаборЗаписей.Отбор.ВидОтметки.Установить(СтрокаЗапроса.ВидОтметки);
	НаборЗаписей.Записать();
	
	
	МенеджерЗаписи = РегистрыСведений.РегистрацияВремениРаботТехПроцесс.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период    = СтрокаЗапроса.Период;
	МенеджерЗаписи.ЗаказНаряд = Ссылка;
	МенеджерЗаписи.Сотрудник = СтрокаЗапроса.Сотрудник;
	МенеджерЗаписи.Авторабота =  СтрокаЗапроса.Авторабота;
	
	МенеджерЗаписи.ВидОтметки= Справочники.ВидыОтметокВремени.Работа;
	
	МенеджерЗаписи.Продолжительность= СтрокаЗапроса.Часы;
	МенеджерЗаписи.КонецРаботы= ТекущаяДата();
	
	МенеджерЗаписи.Записать(Истина);
	
	Сообщить("Закончена  " +Строка(ВыполяетсяАвторабота));
Исключение
	КонецПопытки;
КонецПроцедуры	

Функция ПроверкаКорректностиПеремещенияВПроизводстве (Отказ) Экспорт 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТоварыВПроизводствеОстатки.Цех.Организация КАК Организация,
		               |	ТоварыВПроизводствеОстатки.Цех КАК Цех,
		               |	ТоварыВПроизводствеОстатки.Номенклатура КАК Номенклатура,
		               |	ТоварыВПроизводствеОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		               |	ТоварыВПроизводствеОстатки.СтатусПартии КАК СтатусПартии,
		               |	ТоварыВПроизводствеОстатки.Партия КАК Партия,
		               |	ТоварыВПроизводствеОстатки.Партия.Контрагент КАК Поставщик,
		               |	ТоварыВПроизводствеОстатки.Партия.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
		               |	ТоварыВПроизводствеОстатки.ГТД КАК ГТД,
		               |	СУММА(ТоварыВПроизводствеОстатки.КоличествоОстаток) КАК Количество,
		               |	СУММА(ТоварыВПроизводствеОстатки.СуммаОстаток) КАК Сумма,
		               |	СУММА(ТоварыВПроизводствеОстатки.СуммаУпрОстаток) КАК СуммаУпр,
		               |	СУММА(ТоварыВПроизводствеОстатки.СуммаНДСОстаток) КАК СуммаНДС
		               |ИЗ
		               |	РегистрНакопления.ТоварыВПроизводстве.Остатки(
		               |			,
		               |			ЗаказНаряд = &ЗаказНаряд
		               |				И Цех <> &Цех) КАК ТоварыВПроизводствеОстатки
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТоварыВПроизводствеОстатки.Цех,
		               |	ТоварыВПроизводствеОстатки.Номенклатура,
		               |	ТоварыВПроизводствеОстатки.ХарактеристикаНоменклатуры,
		               |	ТоварыВПроизводствеОстатки.СтатусПартии,
		               |	ТоварыВПроизводствеОстатки.Партия,
		               |	ТоварыВПроизводствеОстатки.Партия.Контрагент,
		               |	ТоварыВПроизводствеОстатки.Партия.ДоговорВзаиморасчетов,
		               |	ТоварыВПроизводствеОстатки.ГТД,
		               |	ТоварыВПроизводствеОстатки.Цех.Организация
		               |
		               |ДЛЯ ИЗМЕНЕНИЯ";
		Запрос.УстановитьПараметр("ЗаказНаряд",Ссылка);
	    Запрос.УстановитьПараметр("Цех",Цех);
		
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() тогда
			Отказ = Истина;	
			Сообщить("Цех в 'Перемещении в производство' не соответствует цеху Заказ-наряда!");
		Иначе
			Отказ = Ложь;
		КонецЕсли;	
		
		Возврат Отказ;
КонецФункции	

