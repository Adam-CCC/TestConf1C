Функция СМГ_ПроверитьОстатокАвтоНаСкладеВСобственности(РежимЗаписи)
	
	флОтказ = Ложь;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда                           
		Если НЕ обЗначениеНеЗаполнено(ВидРемонта) Тогда		
			ВидРемонтаДопОборудование = (ВидРемонта = Справочники.ВидыРемонта.ДополнительноеОборудование) ИЛИ (ВидРемонта = Справочники.ВидыРемонта.ДопОборудованиеСогласованноеСДилером);
			Если ВидРемонтаДопОборудование Тогда					
				Если НЕ обЗначениеНеЗаполнено(Автомобиль) Тогда
					Если НЕ обЗначениеНеЗаполнено(ДокументОснование) Тогда	
						Если ТипЗНЧ(ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
							Запрос = Новый Запрос;
							Запрос.Текст = 
							"ВЫБРАТЬ
							|	ОстаткиАвтомобилейОстатки.Автомобиль,
							|	ОстаткиАвтомобилейОстатки.КоличествоОстаток,
							|	ОстаткиАвтомобилейОстатки.СтатусПартии
							|ИЗ
							|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&ДатаОстатков, ) КАК ОстаткиАвтомобилейОстатки
							|ГДЕ
							|	ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
							|	И ОстаткиАвтомобилейОстатки.Автомобиль = &Автомобиль";
							
							ДатаОст = ?(обЗначениеНеЗаполнено(Дата),ТекущаяДата(),Дата);
							
							Запрос.УстановитьПараметр("ДатаОстатков",ДатаОст);
							Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
							ТЗ = Запрос.Выполнить().Выгрузить();
							Если ТЗ.Количество() = 0 Тогда
								#Если Клиент Тогда
									Сообщить("Ошибка! По состоянию на <"+Формат(ДатаОст,"ДЛФ=DDT")+"> автомобиль <"+Автомобиль+"> отсутствует на складе. Заказ-наряд не может быть записан.",СтатусСообщения.Важное);
								#КонецЕсли
								флОтказ=Истина; 
								Возврат флОтказ;
							Иначе
								Если ТЗ.Количество() = 1 Тогда
									//Бондаренко++ 20221221
									//Если ТЗ[0].СтатусПартии <> Перечисления.СтатусыПартий.ТоварКупленный Тогда
									АвтоПарИмпорта = Ложь;
									АвтоПарИмпорта = СМ_ФормированиеНовыхОбъектов.АвтомобильПараллельногоИмпортаНаДату(Автомобиль,ДатаОст);
									Если ( ТЗ[0].СтатусПартии = Перечисления.СтатусыПартий.ТоварКупленный ) ИЛИ 
										( ( ТЗ[0].СтатусПартии = Перечисления.СтатусыПартий.ТоварПринятыйКомиссия ) И АвтоПарИмпорта ) Тогда
										// ничего не делаем
									Иначе                  
										//Бондаренко-- 20221221	
										#Если Клиент Тогда
											Сообщить("Ошибка! По состоянию на <"+Формат(ДатаОст,"ДЛФ=DDT")+"> автомобиль <"+Автомобиль+"> имеет статус <"+СокрЛП(ТЗ[0].СтатусПартии)+"> и автомобиль не параллельного импорта. Заказ-наряд не может быть записан.",СтатусСообщения.Важное);
										#КонецЕсли
										флОтказ=Истина; 
										Возврат флОтказ;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
	
	Возврат флОтказ;
 
КонецФункции // СМГ_ПроверитьОстатокАвтоНаСкладеВСобственности()
