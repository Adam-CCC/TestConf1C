	// Холышевская ++ 26.03.2026
	Пойменная = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000223");
	
	Если ПараметрыСеанса.ПодразделениеКомпании = Пойменная ИЛИ ПараметрыСеанса.ПодразделениеКомпании.Родитель = Пойменная Тогда
		Макет.Параметры.Пробег = "";
	Иначе
		// Холышевская -- 26.03.2026	
		Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
		Если Пробег = 0 Тогда
			ОбластьШапка.Параметры.Пробег = Формат(ЭтотОбъект.Пробег, "ЧЦ=10");
		Иначе
			ОбластьШапка.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");		
		КонецЕсли;    
	КонецЕсли;
	//ОбластьШапка.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, "ДФ=гггг");	  	  
	ОбластьШапка.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д");
	
	//// попытаемся напечатать ШК
	//ОбработкаОбъектШтрихКоды=Обработки.ШтрихКоды.Создать();
	//ОбработкаОбъектШтрихКоды.Объект=ДокументОбъект;
	//ОбработкаОбъектШтрихКоды.ПрочитатьЗаполнитьШтрихКоды();
	//Если ОбработкаОбъектШтрихКоды.Состав.Количество()>0 Тогда
	//  ШК=ОбработкаОбъектШтрихКоды.Состав[0].ШтрихКод;
	//Иначе
	//  ШК="";
	//КонецЕсли; 
	//Попытка
	//  Если ПустаяСтрока(ШК) Тогда
	//	  ОбластьШапка.Рисунки.Удалить(ОбластьШапка.Рисунки.ШК);
	//  Иначе
	//	  ПрефиксВесовогоШК=Константы.ПрефиксВесовогоШК.Получить();
	//	  ОбластьШапка.Рисунки.ШК.Объект.ТипКода=Число(НЕ (СтрДлина(ШК)=8 И Число(Лев(ШК,2))<>ПрефиксВесовогоШК));
	//	  ДлинаШК=?(ОбластьШапка.Рисунки.ШК.Объект.ТипКода=0,8,13);
