// Формирует печатную форму "ДокументВнутреннегоКонтроля"
// Возвращает сформированный табличный документ:
Функция ПечатьДокументВнутреннегоКонтроля(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	Макет = ПолучитьМакет("ДокументВнутреннегоКонтроля");
	ОбластьЛист1 = Макет.ПолучитьОбласть("Лист1");
	
	ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	Если обЗначениеНеЗаполнено(ЗаказчикТелефон) Тогда
		ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
		
		Если обЗначениеНеЗаполнено(ЗаказчикТелефон) Тогда  
			ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
		КонецЕсли;  
			
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("Организация, ОрганизацияАдресОрганизации, ТелефонОрганизации, ИННОрганизации, Заказчик, ЗаказчикТел, Номер, ГосНомер, Марка, Модель, VIN, ДатаНачалаГарантии, Пробег",
										  Организация.Наименование,
										  киПолучитьПредставлениеКИ(ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический),
										  киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий),
										  Организация.ИНН,
										  Заказчик,
                                          ЗаказчикТелефон,
										  СокрЛП(Номер),
										  Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда),
										  Автомобиль.Модель.Марка,
										  Автомобиль.Модель,
										  Автомобиль.VIN,
										  Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д"),
										  Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда));
										  
	ЗаполнитьЗначенияСвойств(ОбластьЛист1.Параметры, СтруктураПараметров);
	ТабДокумент.Вывести(ОбластьЛист1); 
	
	НижнийКолонтитул = ТабДокумент.НижнийКолонтитул;
	НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	
	НижнийКолонтитул.ТекстСлева = 
	"____________________________/" + ФИО_(Диспетчер) + "/
	|подпись Мастера-консультанта       Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстСправа = 
	"____________________/" + ФИО(Мастер) + "/
	|подпись Мастера цеха      Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстВЦентре = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	
	НижнийКолонтитул.Шрифт = Новый Шрифт("Arial", 7);
	НижнийКолонтитул.Выводить = Истина;
	НижнийКолонтитул.НачальнаяСтраница = 1;
	
	ТабДокумент.ПолеСверху              = 5;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 12;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент;
  
КонецФункции
