		Запрос.Текст = "ВЫБРАТЬ
		|	Опрос.Ссылка
		|ИЗ
		|	Документ.Опрос КАК Опрос
		|ГДЕ
		|	Опрос.Дата МЕЖДУ &Дата1 И КОНЕЦПЕРИОДА(&Дата2, ДЕНЬ)
		|	И Опрос.ОпрашиваемоеЛицо = &ОпрашиваемоеЛицо
		|	И Опрос.Принадлежность = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьОпроса.ОС)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Опрос.Ссылка
		|ИЗ
		|	Документ.Опрос КАК Опрос
		|ГДЕ
		|	Опрос.ОпрашиваемоеЛицо = &ОпрашиваемоеЛицо
		|	И Опрос._г_НеДозвон
		|	И НЕ Опрос.ОпросЗавершен
		|	И Опрос.Принадлежность = ЗНАЧЕНИЕ(Перечисление.ПринадлежностьОпроса.ОС)";
		
		//Запрос.УстановитьПараметр("ДокументОснование",Ссылка);	
		Запрос.УстановитьПараметр("ОпрашиваемоеЛицо",Заказчик);	
		Запрос.УстановитьПараметр("Дата1",НачалоДня(ДатаЗакрытия));	
		Запрос.УстановитьПараметр("Дата2",КонецДня(ДатаЗакрытия));	
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() тогда
			Возврат;
		КонецЕсли;
		
		ДокументОпрос = Документы.Опрос.СоздатьДокумент();
		ДокументОпрос.Заполнить(Ссылка);
		Если Заказчик = Справочники.Контрагенты.НайтиПоКоду("ЦБ000003") тогда
			ДокументОпрос.ОпрашиваемоеЛицо = Владелец;
		Иначе 
			ДокументОпрос.ОпрашиваемоеЛицо = Заказчик;
		КонецЕсли;
		
		// + КМ
		// Было:
		//ДокументОпрос.ТиповаяАнкета = Справочники.ТиповыеАнкеты.НайтиПоКоду("ЦБ000005") ;
		//
		// Стало:
		ТиповаяАнкета = Справочники.ТиповыеАнкеты.НайтиПоКоду("ЦБ000005");
		ТиповаяАнкетаFord = Справочники.ТиповыеАнкеты.НайтиПоКоду("ЦБ000021");
		ТиповаяАнкетаУАЗ = Справочники.ТиповыеАнкеты.НайтиПоКоду("ЦБ000009");
		ТиповаяАнкетаSsangYong = Справочники.ТиповыеАнкеты.НайтиПоКоду("ЦБ000025");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	НастройкиЗвонковВежливости.АнкетаСервисFord,
		|	НастройкиЗвонковВежливости.АнкетаСервисSsangYong,
		|	НастройкиЗвонковВежливости.АнкетаСервисУАЗ,
		|	НастройкиЗвонковВежливости.АнкетаСервис,
		|	1 КАК Приоритет
		|ПОМЕСТИТЬ Результат
		|ИЗ
		|	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
		|ГДЕ
		|	НастройкиЗвонковВежливости.Подразделение = &Подразделение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкиЗвонковВежливости.АнкетаСервисFord,
		|	НастройкиЗвонковВежливости.АнкетаСервисSsangYong,
		|	НастройкиЗвонковВежливости.АнкетаСервисУАЗ,
		|	НастройкиЗвонковВежливости.АнкетаСервис,
		|	2
		|ИЗ
		|	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
		|ГДЕ
		|	НастройкиЗвонковВежливости.Подразделение = &ПодразделениеРодитель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Результат.АнкетаСервисFord,
		|	Результат.АнкетаСервисSsangYong,
		|	Результат.АнкетаСервисУАЗ,
		|	Результат.АнкетаСервис,
		|	Результат.Приоритет КАК Приоритет
		|ИЗ
		|	Результат КАК Результат
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
						   
		Запрос.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
		Запрос.УстановитьПараметр("ПодразделениеРодитель", ПодразделениеКомпании.Родитель);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			// Если настройки не заполнены, то используем анкету по умолчанию
			Если ЗначениеЗаполнено(Выборка.АнкетаСервис) Тогда
				ТиповаяАнкета		= Выборка.АнкетаСервис;
			КонецЕсли;
			
			ТиповаяАнкетаFord 		= Выборка.АнкетаСервисFord;
			ТиповаяАнкетаУАЗ 		= Выборка.АнкетаСервисУАЗ;
			ТиповаяАнкетаSsangYong 	= Выборка.АнкетаСервисSsangYong;
		
		КонецЕсли;
				
		Если ЗначениеЗаполнено(Автомобиль) И ЗначениеЗаполнено(Автомобиль.Модель) Тогда
			
			МодельАвтомобиляСтрокой = ВРег(Автомобиль.Модель.Наименование);
			
			Если Лев(МодельАвтомобиляСтрокой, 4) = "FORD" И ЗначениеЗаполнено(ТиповаяАнкетаFord) Тогда
				ТиповаяАнкета = ТиповаяАнкетаFord;
			ИначеЕсли Лев(МодельАвтомобиляСтрокой, 10) = "SSANG YONG" И ЗначениеЗаполнено(ТиповаяАнкетаSsangYong) Тогда
				ТиповаяАнкета = ТиповаяАнкетаSsangYong;
			ИначеЕсли Лев(МодельАвтомобиляСтрокой, 3) = "УАЗ" И ЗначениеЗаполнено(ТиповаяАнкетаУАЗ) Тогда
				ТиповаяАнкета = ТиповаяАнкетаУАЗ;
			КонецЕсли;
				      		
		КонецЕсли;		
			
		ДокументОпрос.ТиповаяАнкета = ТиповаяАнкета;
		// - КМ		
		
		Попытка
			зфОпросОбновитьСписокВопросов(ДокументОпрос);
		Исключение
		КонецПопытки;
		ДокументОпрос.Дата = Дата(Год(ДатаКонтакта),Месяц(ДатаКонтакта),День(ДатаКонтакта),Час(Время),Минута(Время),Секунда(Время));
		ДокументОпрос.Мастер = Диспетчер;
		ДокументОпрос.СпособКонтакта = СпособКонтакта;
		ДокументОпрос.Поле = Поле;
		ДокументОпрос.ДокументОснование = Ссылка;
		ДокументОпрос.Принадлежность = Перечисления.ПринадлежностьОпроса.ОС;	// КМ
		
		// + КМ
		Запрос.Текст = "ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|ГДЕ
		|	ЗаказНаряд.Заказчик = &Заказчик
		|	И ЗаказНаряд.Проведен
		|	И ЗаказНаряд.ДокументОснование <> &ДокументОснование
		|	И ЗаказНаряд.Дата > &Дата";
		
		Запрос.УстановитьПараметр("Заказчик", Заказчик);
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		Запрос.УстановитьПараметр("Дата", ДобавитьМесяц(Дата, -1));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ДокументОпрос.ОбратитьВнимание = Истина;
		КонецЕсли;
		// - КМ
		
		Попытка
			ДокументОпрос.Записать(РежимЗаписиДокумента.Запись);			
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры	

Процедура УстановитьПрефикс() Экспорт
	    НовыйПрефикс = обПолучитьПрефиксОбъекта(ЭтотОбъект,);
		ДлиннаПрефикса = СтрДлина(НовыйПрефикс);
		
		стрНомер = Номер;
		СтарыйПефикс = "";
		Флаг = истина;
		НачНомер = 1;
		Пока Флаг  цикл
			
			 СимволПрефикса= сред(стрНомер,НачНомер,1);
			 Попытка
				Числопрефикса =  Число(СимволПрефикса);
				 флаг = Ложь; 

			 Исключение
				   СтарыйПефикс = СтарыйПефикс+ СимволПрефикса ;
				 НачНомер = НачНомер+1;

			КонецПопытки; 
		КонецЦикла;
		Если СтарыйПефикс <>  НовыйПрефикс тогда
			Номер = СтрЗаменить(Номер,СтарыйПефикс,НовыйПрефикс);
	   КонецЕсли;
КонецПроцедуры	

