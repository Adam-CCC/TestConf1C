Функция Город(СсылкаНаОбъект)
	Попытка
		Подразделение = СсылкаНаОбъект.ПодразделениеКомпании;
	Исключение
		Возврат "";
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтактнаяИнформация.Поле4 КАК Город,
	               |	КонтактнаяИнформация.Поле5 КАК НаселённыйПункт
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Вид В(&Вид)
	               |	И КонтактнаяИнформация.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Подразделение);
	ВидыАдресов = Новый Массив();
	ВидыАдресов.Добавить(Справочники.ВидыКонтактнойИнформации.АдресФактический);
	//Бондаренко++ 20231102
	//ВидыАдресов.Добавить(Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	//Бондаренко++ 20231102
	Запрос.УстановитьПараметр("Вид", ВидыАдресов);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Город) Тогда
			Город = "г. " + Лев(Выборка.Город, СтрДлина(Выборка.Город) - 2);
		ИначеЕсли ЗначениеЗаполнено(Выборка.НаселённыйПункт) Тогда
			Город = "п. " + Лев(Выборка.НаселённыйПункт, СтрДлина(Выборка.НаселённыйПункт) - 2);
		Иначе
			Возврат "";
		КонецЕсли;
		Возврат Город;
	Иначе
		Возврат "г. Ростов-на-Дону";
	КонецЕсли;	
КонецФункции

Функция ФИО(ПолнИмя) 
    // позиция первого пробела
    ПервПроб = Найти(ПолнИмя," ");
    Если ПервПроб=0 Тогда
        Возврат ПолнИмя;
    Иначе
        Фамилия = Лев(ПолнИмя,ПервПроб);
        ИО = СокрЛ(Сред(ПолнИмя,ПервПроб+1));
        Имя = Лев(ИО,1)+".";
        // позиция второго пробела
        ВтПроб = Найти(ИО," ");
        Если ВтПроб=0 Тогда
            Возврат Фамилия+Имя;
        Иначе
            Возврат Фамилия+Имя+" "+Лев(СокрЛ(Сред(ИО,ВтПроб+1)),1)+".";
        КонецЕсли;
    КонецЕсли;
КонецФункции

