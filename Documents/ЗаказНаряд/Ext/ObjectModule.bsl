			//Сообщить("ОШИБКА! Подразделение счет-фактуры "+СокрЛП(СчетФактураВыданный.ПодразделениеКомпании)+" не равно Подразделению документа "+СокрЛП(Ссылка.ПодразделениеКомпании),СтатусСообщения.ОченьВажное);
			БылиОшибки=Истина;  
