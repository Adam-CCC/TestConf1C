Процедура СМГ_ЗаполнитьРеквизиты(НовоеПеремещениеВПроизводство,Склад,ВсегоСкладов,Сч);
	
	Если Не ОбЗначениеНеЗаполнено(НовоеПеремещениеВПроизводство.Цех) Тогда
		Если НовоеПеремещениеВПроизводство.Цех.СкладКомпании <> НовоеПеремещениеВПроизводство.СкладКомпании Тогда
			//Сообщить("Потребуются перепродажи. Подберем цех для склада ["+Склад.СкладКомпании.Код+"] "+Склад.СкладКомпании);
			НайдЦех = НайтиЦехПерепродаж(Склад.СкладКомпании);
			Если ОбЗначениеНеЗаполнено(НайдЦех) Тогда
				НовоеПеремещениеВПроизводство.Цех=Справочники.Цеха.НайтиПоРеквизиту("СкладКомпании",Склад.СкладКомпании); 
			Иначе
				НовоеПеремещениеВПроизводство.Цех=НайдЦех;
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли; 
	
	Попытка НовоеПеремещениеВПроизводство.ПодразделениеКомпании=Склад.СкладКомпании.Подразделение; Исключение КонецПопытки;	
	Попытка	НовоеПеремещениеВПроизводство.Организация=Склад.СкладКомпании.Подразделение.Организация; Исключение	КонецПопытки;	
	Попытка	НовоеПеремещениеВПроизводство.УстановитьНовыйНомер() Исключение	КонецПопытки;			
	
	Если ВсегоСкладов > 1 Тогда
		
		НовоеПеремещениеВПроизводство.Комментарий = СокрЛП(Формат(ТекущаяДата(),"ДЛФ=T")+" Пакет: "+СокрЛП(Сч)+" из "+СокрЛП(ВсегоСкладов));
		
		Если НовоеПеремещениеВПроизводство.Организация <> НовоеПеремещениеВПроизводство.СкладКомпании.Организация Тогда
			НовоеПеремещениеВПроизводство.Организация = НовоеПеремещениеВПроизводство.СкладКомпании.Организация;
		КонецЕсли; 			
		
		Если НовоеПеремещениеВПроизводство.ПодразделениеКомпании <> НовоеПеремещениеВПроизводство.СкладКомпании.Подразделение Тогда
			НовоеПеремещениеВПроизводство.ПодразделениеКомпании = НовоеПеремещениеВПроизводство.СкладКомпании.Подразделение;
		КонецЕсли;
		
		Если НЕ НовоеПеремещениеВПроизводство.Цех.СкладКомпании.ЭтоГруппа Тогда
			Если НовоеПеремещениеВПроизводство.Цех.СкладКомпании <> НовоеПеремещениеВПроизводство.СкладКомпании Тогда
				НайдЦех = НайтиЦехПерепродаж(Склад.СкладКомпании);
				Если ОбЗначениеНеЗаполнено(НайдЦех) Тогда
					НовоеПеремещениеВПроизводство.Цех=Справочники.Цеха.НайтиПоРеквизиту("СкладКомпании",Склад.СкладКомпании); 
				КонецЕсли;
				Если ЗначениеЗаполнено(НайдЦех) Тогда
					НовоеПеремещениеВПроизводство.Цех=НайдЦех;
				Иначе
					Сообщить("ОШИБКА! Не удалось найти цех для склада ["+НовоеПеремещениеВПроизводство.СкладКомпании.Код+"] "+НовоеПеремещениеВПроизводство.СкладКомпании,СтатусСообщения.ОченьВажное);
				КонецЕсли;	
			КонецЕсли; 
		Иначе
			НайдЦех = НайтиЦехПерепродаж(НовоеПеремещениеВПроизводство.СкладКомпании);
			Если ОбЗначениеНеЗаполнено(НайдЦех) Тогда
				НайдЦех = Справочники.Цеха.НайтиПоРеквизиту("СкладКомпании",НовоеПеремещениеВПроизводство.СкладКомпании);
			КонецЕсли;
			Если ЗначениеЗаполнено(НайдЦех) Тогда
				НовоеПеремещениеВПроизводство.Цех=НайдЦех;
			КонецЕсли;	
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры  //СМГ_ЗаполнитьРеквизиты(НовоеПеремещениеВПроизводство,Склад,ВсегоСкладов,ёё)

Функция СМГ_ПроверкаПродажиНижеСебестоимости(ЗапретПродажиНижеСебестоимости,СуммаПродажиСебестоимостьУпр,СуммаПродажиУпр,Сообщение,СтрокаЗаказНаряда)
	
	флОтказ = Ложь;
	
	// Проверка продажи ниже себестоимости
	Если ЗапретПродажиНижеСебестоимости И СуммаПродажиСебестоимостьУпр > СуммаПродажиУпр Тогда
		Если НЕ ПустаяСтрока(Сообщение) Тогда
			Сообщение = Сообщение + Символы.ПС;
		КонецЕсли;
		СтрокаИнформации = ". Себестоимость товара: " + СуммаПродажиСебестоимостьУпр + " " + ВалютаДокумента + ", сумма продажи: " + СуммаПродажиУпр + " " + ВалютаДокумента;
		Если обЗначениеНеЗаполнено(СтрокаЗаказНаряда.ХарактеристикаНоменклатуры) Тогда
			Сообщение = Сообщение+"["+СокрЛП(СтрокаЗаказНаряда.Номенклатура.Артикул)+"] Товар """ + СокрЛП(СтрокаЗаказНаряда.Номенклатура) + """" + СтрокаИнформации + ". Продажа ниже себестоимости запрещена!";
		Иначе
			Сообщение = Сообщение+"["+СокрЛП(СтрокаЗаказНаряда.Номенклатура.Артикул)+"] Товар """ + СокрЛП(СтрокаЗаказНаряда.Номенклатура) + """ с характеристикой """ + СокрЛП(СтрокаЗаказНаряда.ХарактеристикаНоменклатуры) + """" + СтрокаИнформации + ". Продажа ниже себестоимости запрещена!";
		КонецЕсли; 
		флОтказ = Истина;
	КонецЕсли;                        
	
	Возврат флОтказ;		
	
КонецФункции // СМГ_ПроверкаПродажиНижеСебестоимости(ЗапретПродажиНижеСебестоимости,СуммаПродажиСебестоимостьУпр,СуммаПродажиУпр,Сообщение)

