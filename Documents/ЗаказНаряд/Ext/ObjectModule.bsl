	ТабДокумент.Вывести(ОбластьМакета);
	
	//Вывод деталей документа
	ОбластьМакета = Макет.ПолучитьОбласть("Детали");
	ТабДокумент.Вывести(ОбластьМакета);   
	
	//Вывод подвала документа
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ТабДокумент.Автомасштаб = Истина;
	Возврат ТабДокумент;
	
