Функция СМГ_СравнитьТаблицы(ТаблРегистраРаботы,ТаблРегистраТовары,КритическаяОшибка)
	
	Ошибки = "";
	
 	ТаблДокаРаботы = Работы.Выгрузить();
 	ТаблДокаТовары = Товары.Выгрузить();
 	
	//ТаблДока.ВыбратьСтроку(); 		
	
	ТаблДокаРаботы.Колонки.Добавить("БазовоеКоличество");
	Для каждого Стр Из ТаблДокаРаботы Цикл
	    Стр.БазовоеКоличество = Стр.Количество * Стр.Коэффициент;
	КонецЦикла;
	
	ТаблДокаТовары.Колонки.Добавить("БазовоеКоличество");
	Для каждого Стр Из ТаблДокаТовары Цикл
	    Стр.БазовоеКоличество = Стр.Количество * Стр.Коэффициент;
	КонецЦикла; 
	
	//ТаблДока.ВыбратьСтроку("После добавление колонки БазовоеКоличество"); 		
 	ТаблДокаРаботы.Свернуть("Работа","БазовоеКоличество,СуммаВсего");
	//ТаблДока.ВыбратьСтроку("Таблица работ после свёртки");
 	//ТаблРегистра.ВыбратьСтроку();
 	 
	ТаблСравнения = ТаблРегистраРаботы.Скопировать();
	ТаблСравнения.Колонки.Добавить("Номенклатура");
	
 	НоменклатураПустаяСсылка = Справочники.Номенклатура.ПустаяСсылка();
	АвтоработаПустаяСсылка = Справочники.Автоработы.ПустаяСсылка();	
	
	Для каждого Стр Из ТаблСравнения Цикл
 		Стр.Номенклатура         = НоменклатураПустаяСсылка;
 	КонецЦикла;
	
	Для каждого Стр Из ТаблДокаРаботы Цикл
		НовСтр = ТаблСравнения.Добавить();
		НовСтр.Автомобиль        = Автомобиль;
		НовСтр.Работа            = Стр.Работа;
		НовСтр.Номенклатура      = НоменклатураПустаяСсылка;
		НовСтр.Организация       = Организация;
		НовСтр.КоличествоОстаток = -Стр.БазовоеКоличество;
		НовСтр.СуммаУпрОстаток	 = -Стр.СуммаВсего;
	КонецЦикла;	
	
	Для каждого Стр Из ТаблРегистраТовары Цикл
		НовСтр = ТаблСравнения.Добавить();
		НовСтр.Автомобиль        = Автомобиль;
		НовСтр.Работа            = АвтоработаПустаяСсылка;
		НовСтр.Номенклатура      = Стр.Номенклатура;
		НовСтр.Организация       = Организация;
		НовСтр.КоличествоОстаток = Стр.КоличествоОстаток;
		//Бондаренко++ 20260114
		//НовСтр.СуммаУпрОстаток	 = Стр.СуммаУпрОстаток;
		НовСтр.СуммаУпрОстаток	 = Стр.СуммаПродажиУпрОстаток;
		//Бондаренко-- 20260114
	КонецЦикла;
	
	Для каждого Стр Из ТаблДокаТовары Цикл
		НовСтр = ТаблСравнения.Добавить();
		НовСтр.Автомобиль        = Автомобиль;
		НовСтр.Номенклатура      = Стр.Номенклатура;
		НовСтр.Работа            = АвтоработаПустаяСсылка;
		НовСтр.Организация       = Организация;
		НовСтр.КоличествоОстаток = -Стр.БазовоеКоличество;
		НовСтр.СуммаУпрОстаток	 = -Стр.СуммаВсего;
	КонецЦикла;
	
	//ТаблСравнения.ВыбратьСтроку("Таблица сравнения до свёртки");		
	
	ТаблСравнения.Свернуть("Работа,Номенклатура","КоличествоОстаток,СуммаУпрОстаток"); 
 	
	//Бондаренко++ 20220809
 	Всего=ТаблСравнения.Количество()-1;
	Пока Всего > 0 цикл          
 		ТекСтрока = ТаблСравнения[Всего];
		Если ТекСтрока.СуммаУпрОстаток < 10 И ТекСтрока.СуммаУпрОстаток > -10 И ТекСтрока.СуммаУпрОстаток <> 0 И ТекСтрока.КоличествоОстаток = 0 Тогда
			ТаблСравнения.Удалить(ТекСтрока);		
			Всего = Всего - 1;
			//Бондаренко++ 20220917
			Продолжить;    
			//Бондаренко-- 20220917
 		КонецЕсли;
 		Всего = Всего - 1;
	КонецЦикла;                                                         
 	//Бондаренко-- 20220809
	
	//ТаблСравнения.ВыбратьСтроку("Таблица сравнения после свёртки");		
	
	//Бондаренко++ 20220917
	//Если ТаблСравнения.Итог("КоличествоОстаток") <> 0 Или ТаблСравнения.Итог("СуммаУпрОстаток") <> 0 Тогда
	Если ТаблСравнения.Итог("КоличествоОстаток") <> 0 Или ТаблСравнения.Итог("СуммаУпрОстаток") > 10 Или ТаблСравнения.Итог("СуммаУпрОстаток") < -10 Тогда
	//Бондаренко-- 20220917	
		
		Ошибки = "Существуют расхождения между комплектациями и заказ-нарядом по табличным частям :";
		
		Для каждого СтрТабл Из ТаблСравнения Цикл
			
			КолТек   = СтрТабл.КоличествоОстаток;
			СуммаТек = СтрТабл.СуммаУпрОстаток;
			Если Не обЗначениеНеЗаполнено(СтрТабл.Работа) Тогда
				РаботаТек   = "Авторабота: '("+СокрЛП(СтрТабл.Работа.Код)+") "+СтрТабл.Работа+"'";
			Иначе	
				РаботаТек   = "Товар: '["+СокрЛП(СтрТабл.Номенклатура.Артикул)+"] "+СтрТабл.Номенклатура+"'";			
			КонецЕсли;
 			
			Если КолТек = 0  И СуммаТек = 0 Тогда
 				Продолжить;	
			КонецЕсли;                                   
			
			Если КолТек > 0 Тогда
				ОшибкаВколичестве = "; недостача по количеству: "+СтрЗаменить(СокрЛП(КолТек),Символы.НПП,"");
 			ИначеЕсли КолТек < 0 Тогда	
				 ОшибкаВколичестве = "; превышение по количеству: "+СтрЗаменить(СокрЛП(-КолТек),Символы.НПП,"");
				 КритическаяОшибка = Истина;
			Иначе
				ОшибкаВколичестве = "";				
			КонецЕсли;
			
			Если СуммаТек > 0 Тогда
				ОшибкаВсумме = "; недостача по сумме: "+СтрЗаменить(СокрЛП(СуммаТек),Символы.НПП,"");
			ИначеЕсли СуммаТек < 0 Тогда	
				ОшибкаВсумме = "; превышение по сумме: "+СтрЗаменить(СокрЛП(-СуммаТек),Символы.НПП,"");
				КритическаяОшибка = Истина;
			Иначе
				ОшибкаВсумме = "";				
			КонецЕсли;
			
			Ошибки = Ошибки+Символы.ПС+РаботаТек+СокрЛП(ОшибкаВколичестве)+СокрЛП(ОшибкаВсумме);	
 		
		КонецЦикла;
		
 	КонецЕсли;
    	
	Возврат Ошибки;
	
КонецФункции // СМГ_СравнитьТаблицы(ТаблРегистра,ФлагЭтоРаботы)

Процедура СМГ_КорректировкаНормочасаДляШахтМодуль(СтрокаРабота,ЭтаФорма)
	
	НормочасДляШахт = Справочники.Нормочасы.ПустаяСсылка();	
	НормочасДляШахтТО = Справочники.Нормочасы.ПустаяСсылка();                                          
	ТипСкидкиДляШахт = Справочники.ТипыСкидок.ПустаяСсылка();
	СкидкаРаботыДляШахт = 0;

	УстановитьНормочасИСкидкиДляШахтМодуль(Истина,ЭтаФорма,НормочасДляШахт,НормочасДляШахтТО,ТипСкидкиДляШахт,СкидкаРаботыДляШахт);

	Если ЗначениеЗаполнено(НормочасДляШахт) Или ЗначениеЗаполнено(НормочасДляШахтТО) Тогда
		//СтрокаРабота = ЭлементыФормы.Работы.ТекущаяСтрока;
		ГруппаТОНиссан = Справочники.Автоработы.НайтиПоКоду("ЦБ0104500"); // для рабочей базы
		ГруппаТОХендэ = Справочники.Автоработы.НайтиПоКоду("ЦБ00000274");
		ГруппаТОХендэ1 = Справочники.Автоработы.НайтиПоКоду("ЦБ0024489");
		Если ВидРемонта.ТехОбслуживание Тогда
			Если СтрокаРабота.Работа.ПринадлежитЭлементу(ГруппаТОНиссан)
				Или СтрокаРабота.Работа.ПринадлежитЭлементу(ГруппаТОХендэ)
				Или СтрокаРабота.Работа.ПринадлежитЭлементу(ГруппаТОХендэ1) Тогда
				СтрокаРабота.Нормочас = НормочасДляШахтТО;
			Иначе
				СтрокаРабота.Нормочас = НормочасДляШахт;
			КонецЕсли;
		Иначе
            СтрокаРабота.Нормочас = НормочасДляШахт;
		КонецЕсли;
		ОбработкаРеквизита("Работы.Нормочас", СтрокаРабота, ЭтаФорма);
		
		Если ЗначениеЗаполнено(ТипСкидкиДляШахт) И ЗначениеЗаполнено(СкидкаРаботыДляШахт) Тогда
			СтрокаРабота.СкидкаНаТовар = ТипСкидкиДляШахт;
			ОбработкаРеквизита("Работы.СкидкаНаТовар", СтрокаРабота, ЭтаФорма);
			СтрокаРабота.ПроцентСкидкиСтроки = СкидкаРаботыДляШахт;
			ОбработкаРеквизита("Работы.ПроцентСкидкиСтроки", СтрокаРабота, ЭтаФорма);
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры 

