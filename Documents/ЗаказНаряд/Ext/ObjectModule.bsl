		               |	ПеремещениеТоваровВПроизводствоТовары.Количество * ПеремещениеТоваровВПроизводствоТовары.Коэффициент КАК КоличествоОстаток
		               |ИЗ
		               |	Документ.ПеремещениеТоваровВПроизводство.Товары КАК ПеремещениеТоваровВПроизводствоТовары
		               |ГДЕ
		               |	ПеремещениеТоваровВПроизводствоТовары.Ссылка.ДокументОснование = &ВыбЗаказНаряд
		               |	И ПеремещениеТоваровВПроизводствоТовары.Ссылка.Проведен = ИСТИНА
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ИзвлечениеТоваровИзПроизводстваТовары.Номенклатура,
		               |	ИзвлечениеТоваровИзПроизводстваТовары.Номенклатура.Артикул,
		               |	-ИзвлечениеТоваровИзПроизводстваТовары.Количество * ИзвлечениеТоваровИзПроизводстваТовары.Коэффициент
		               |ИЗ
		               |	Документ.ИзвлечениеТоваровИзПроизводства.Товары КАК ИзвлечениеТоваровИзПроизводстваТовары
		               |ГДЕ
		               |	ИзвлечениеТоваровИзПроизводстваТовары.Ссылка.ДокументОснование = &ВыбЗаказНаряд
		               |	И ИзвлечениеТоваровИзПроизводстваТовары.Ссылка.Проведен = ИСТИНА";
		
		Запрос.УстановитьПараметр("ВыбЗаказНаряд",Ссылка);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		ТЗ.Свернуть("Номенклатура,Артикул","КоличествоОстаток");
		
		Если ТЗ.Количество() = 0 Тогда
			//Отказ = Ложь;
		ИначеЕсли Число(ТЗ.Итог("КоличествоОстаток")) = 0 Тогда
			//Отказ = Ложь;
		Иначе	
			ТЗ.ВыбратьСтроку("ОШИБКА! Существуют невозвращенные на склад товары для документа: "+Ссылка);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	//Бондаренко++ 20240810
	
 	Если Не ФлОтказ Тогда
	    СМГ_УстановкаРеквизитовПередЗаписью();
	КонецЕсли; 
	
    Возврат ФлОтказ;
КонецФункции // СМГ_ПередЗаписью()

//Бондаренко++ 20220601
Процедура СМГ_УстановкаРеквизитовПередЗаписью()
	
	Если Состояние=Справочники.ВидыСостоянийЗаказНарядов.Выполнен ИЛИ
		Состояние=Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
		Если НЕ обЗначениеНеЗаполнено(ДатаОкончания) Тогда
			Если ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Олимп и Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
				ДатаКонтакта = ДатаОкончания+864000;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;  
	
	Если  Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Если НЕ обЗначениеНеЗаполнено(ДатаОкончания) Тогда
			ДатаЗакрытия = ДатаОкончания+1;
		КонецЕсли;	
 	КонецЕсли;
 	
	Если ПлановаяДатаВыдачи = '00010101000000' и Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Заявка и Константы.ДилерскийЦентр.Получить() = Справочники.ДилерскиеЦентры.Олимп Тогда
		Итого = 0;
		Для Каждого стр из Работы Цикл
			  Итого = Итого + стр.Количество*стр.Коэффициент ;
 		КонецЦикла;	
		Итого = Итого*60*60;
	 	ПлановаяДатаВыдачи = ДатаНачала + Итого;
	КонецЕсли;
	
	СуммаНоменклатурыДокументаОсновной=0;
	СуммаНоменклатурыДокументаНеОсновной=0;
	СуммаНеликвидаЗН=0;
 	Для каждого Стр Из Товары Цикл
	    Если Стр.Основная Тогда
			СуммаНоменклатурыДокументаОсновной=СуммаНоменклатурыДокументаОсновной+Стр.СуммаВсего;
 		Иначе
			СуммаНоменклатурыДокументаНеОсновной=СуммаНоменклатурыДокументаНеОсновной+Стр.СуммаВсего;
		КонецЕсли; 
		Если Стр.Расширение Тогда
			СуммаНеликвидаЗН=СуммаНеликвидаЗН+Стр.СуммаВсего;
 		КонецЕсли;   
 	КонецЦикла; 
	
	СуммаРаботДокументаОсновной=0;
	СуммаРаботДокументаНеОсновной=0;
  	Для каждого Стр Из Работы Цикл
	    Если Стр.Основная Тогда
			СуммаРаботДокументаОсновной=СуммаРаботДокументаОсновной+Стр.СуммаВсего;
 		Иначе
			СуммаРаботДокументаНеОсновной=СуммаРаботДокументаНеОсновной+Стр.СуммаВсего;
		КонецЕсли; 
  	КонецЦикла; 
	
	СуммаНДС = Работы.Итог("СуммаНДС")+Товары.Итог("СуммаНДС");
 	
	// Семенихин 02.02.2021 +++++
	Если ЭтоНовый() И Не РегламентированныйУчет Тогда
		дкОбработкаЗаполненияРегламентированныйУчет(ЭтотОбъект);
	КонецЕсли;	
	
	Если СписаниеТоваровПоСебестоимости Тогда
		ЗаполнитьТоварыПоСебестоимости();
	КонецЕсли;
	
	СтароеСостояние = Ссылка.Состояние;
	Если ЗначениеЗаполнено(СтароеСостояние) И СтароеСостояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен
		И Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт Тогда
		
		ДатаЗакрытия = ТекущаяДата();
		Дата = ДатаЗакрытия;
	КонецЕсли;
	// Семенихин 28.05.2024 ----- 
 	
 	СуммаНДСТовары=Товары.Итог("СуммаНДС");
 	
 	СуммаДокументаБезВосстановительныхРабот = СуммаДокумента;
	Для каждого Стр Из Работы Цикл
		Если Стр.Работа <> Справочники.Автоработы.КомплексныеРемонтноВосстановительныеРаботы Тогда
			Продолжить;
 		КонецЕсли; 
		СуммаДокументаБезВосстановительныхРабот = СуммаДокументаБезВосстановительныхРабот-Стр.СуммаВсего;
 	КонецЦикла; 
	
	Если Не обЗначениеНеЗаполнено(ДоговорВзаиморасчетов) Тогда
		Если ДоговорВзаиморасчетов.ЭтоКонтракт Тогда
			ЭтоКонтракт=Истина;
 		Иначе
			ЭтоКонтракт=Ложь;
 		КонецЕсли; 
	КонецЕсли;                                    
 
КонецПроцедуры //СМГ_УстановкаРеквизитовПередЗаписью
//Бондаренко-- 20220601
 
//Доступность вида ремонта определяется наличием либо отсутствием авто на остатках, за исключением того случая, когда Контрагент - Старичков (авто в другой базе)
Функция СМГ_ПроверкаВидаРемонтаПоНаличиюОтсутствиюАвто(РежимЗаписи)
	
	ФлОтказ = Ложь;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Отказ Тогда
			Если Не обЗначениеНеЗаполнено(Дата) Тогда
				Если Дата >= Дата(2022,4,1)Тогда     
					Если Не обЗначениеНеЗаполнено(Автомобиль) Тогда					
						СписокВидовРемонта = СМГ_ПолучитьСписокВыбораВидовРемонта();
						Если СписокВидовРемонта.НайтиПоЗначению(ВидРемонта) = Неопределено Тогда
							#Если Клиент Тогда
								СМГ_Сообщить("ОШИБКА! Недопустимый вид ремонта: """+ВидРемонта+""".",СтатусСообщения.ОченьВажное);
							#КонецЕсли
							Если НЕ РольДоступна("ПолныеПрава") Тогда
								ФлОтказ = Истина;
 							КонецЕсли;
  						КонецЕсли;
					КонецЕсли;	           
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	           
	КонецЕсли;	             
	
	Возврат ФлОтказ;
	
КонецФункции // СМГ_ПроверкаВидаРемонтаПоНаличиюОтсутствиюАвто()

//Табличная часть Работы не может быть пустой
Функция СМГ_ТаблицаРаботПустая(РежимЗаписи)
		
	ФлОтказ = Ложь;
	
 	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если НЕ ( Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка ИЛИ Состояние = Справочники.ВидыСостоянийЗаказНарядов.Отказ ) Тогда
			Если Не обЗначениеНеЗаполнено(Дата) Тогда
				Если Дата >= Дата(2022,4,1)Тогда
 					Если Работы.Количество() = 0 Тогда
						#Если Клиент Тогда
							СМГ_Сообщить("Ошибка! Запрещено записывать заказ-наряды без работ.",СтатусСообщения.ОченьВажное);
						#КонецЕсли
						ФлОтказ=Истина;
 					КонецЕсли;		
				КонецЕсли;		
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
		
	Возврат ФлОтказ;
 
КонецФункции // СМГ_ТаблицаРаботПустая()
