			//КонтролируемыеРеквизитыСостава.Вставить("СкладКомпании",КонтрольПоПодразделению);
			//Закомментарил в связи с необходимостью перепродаж с других складов этого же дилерского центра
			//Бондаренко 20150115 ++
			ТабличныеЧасти = Новый Структура();
