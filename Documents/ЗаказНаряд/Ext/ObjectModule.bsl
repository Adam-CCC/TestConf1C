				// Холышевская -- 06.07.2026
			ИначеЕсли Счетчик = 2 Тогда			
				НазваниеПечатнойФормы = "ЕДОС: Акт выполненных работ";
				// Холышевская ++ 06.07.2026
				Копий = 3;
				// Холышевская -- 06.07.2026
			ИначеЕсли Счетчик = 3 Тогда			
				НазваниеПечатнойФормы = "Омода - Заказ-наряд (внешняя)";
				// Холышевская ++ 06.07.2026
				Копий = 3;
				// Холышевская -- 06.07.2026
			КонецЕсли; 			
			
			дкПечать(Ссылка.ПолучитьОбъект(), НазваниеПечатнойФормы, Копий, НаПринтер, Неопределено);
