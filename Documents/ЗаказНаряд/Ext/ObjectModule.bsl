		ОбластьМакета.Параметры.Ожидает = "да";
 	Иначе
		ОбластьМакета.Параметры.Ожидает = "нет";
 	КонецЕсли; 
 	
 	Если Не обЗначениеНеЗаполнено(Организация.НаименованиеДляПечати) Тогда
		НаименованиеДляПечати = СокрЛП(Организация.НаименованиеДляПечати);
	Иначе	
		НаименованиеДляПечати = СокрЛП(Организация.НаименованиеПолное);
 	КонецЕсли; 
	ОбластьМакета.Параметры.ПредставлениеПоставщика = НаименованиеДляПечати;
	ОбластьМакета.Параметры.ПоставщикАдресПочтовый = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	ОбластьМакета.Параметры.ПоставщикТелефон = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	ОбластьМакета.Параметры.ВидРемонта = ВидРемонта;
	
	ДатаНачалаСтр = Формат(ДатаНачала,"ДЛФ=DT");
	ДатаНачалаСтр = Сред(ДатаНачалаСтр,1,СтрДлина(ДатаНачалаСтр)-3);
	ОбластьМакета.Параметры.ДатаНачала = ДатаНачалаСтр ;

	ПлановаяДатаВыдачиСтр = Формат(ПлановаяДатаВыдачи,"ДЛФ=DT");
	ПлановаяДатаВыдачиСтр = Сред(ПлановаяДатаВыдачиСтр,1,СтрДлина(ПлановаяДатаВыдачиСтр)-3);
	ОбластьМакета.Параметры.ПлановаяДатаВыдачи = ПлановаяДатаВыдачиСтр;
	
	Если НЕ обЗначениеНеЗаполнено(Автомобиль) Тогда
		ОбластьМакета.Параметры.ВИН = Автомобиль.VIN;
  		ОбластьМакета.Параметры.Модель = Автомобиль.Модель;
	 	ОбластьМакета.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска,ФорматПредставленияГодаВыпускаАвтомобиля);
 		ОбластьМакета.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,ДатаСоздания);
		
		//Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег,ДатаСоздания);
 		ОбластьМакета.Параметры.Пробег = СтрЗаменить(Формат(Пробег,"ЧЦ=10"),Символы.НПП,"");     
		
		ОбластьМакета.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии,"ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	ОбластьМакета.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;
	ОбластьМакета.Параметры.ОписаниеДефекта = ЭтотОбъект.ОписаниеДефекта;
	
	//Если ЭтотОбъект.ТестоваяПоездка Тогда
	//	ОбластьМакета.Параметры.ПроводиласьТестоваяПоездка   = "проводилась";
	//	ОбластьМакета.Параметры.НеПроводиласьТестоваяПоездка = "";
	// Иначе
	//	ОбластьМакета.Параметры.ПроводиласьТестоваяПоездка   = "";
	//	ОбластьМакета.Параметры.НеПроводиласьТестоваяПоездка = "не проводилась";
	//КонецЕсли; 
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	//=========================== Услуги ================================
	ОбластьМакета = Макет.ПолучитьОбласть("Услуги");
   	ТабДокумент.Вывести(ОбластьМакета);
 
 	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаРабот");
	НПП = 0;
	Для каждого Стр Из ТаблицаРабот Цикл
