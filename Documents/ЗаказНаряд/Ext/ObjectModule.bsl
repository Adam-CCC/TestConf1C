		НомерСтраницыПред = 2;

		//Вывод табличной части работ
		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки", 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалУслуг);		  	  
		Ном	= 0;
		Для Каждого СтрокаРабот Из ДокументОбъект.Работы Цикл
			Ном = Ном + 1;
			ОбластьСтрокаУслуг.Параметры.НомСтр = Ном;
			ОбластьСтрокаУслуг.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаРабот.Работа, ИмяРеквизитаКода, Права);
			ОбластьСтрокаУслуг.Параметры.Наименование = СтрокаРабот.Работа.НаименованиеПолное;
			ОбластьСтрокаУслуг.Параметры.Коэффициент = Формат(СтрокаРабот.Коэффициент, "ЧЦ=10; ЧДЦ=3");
			ОбластьСтрокаУслуг.Параметры.Цена = Формат(СтрокаРабот.Цена, ФорматВыводаСуммы);
			ОбластьСтрокаУслуг.Параметры.ПроцентСкидки = Формат(СтрокаРабот.ПроцентСкидки, "ЧЦ=8%");
			ОбластьСтрокаУслуг.Параметры.Сумма = Формат(СтрокаРабот.СуммаВсего, ФорматВыводаСуммы);

			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаУслуг, ОбластьШапкаУслуг, ОбластьИтоговПоСтраницеУслуги, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоРабот, МассивОбластиПодвала, Неопределено));

			// Обновим итоги по документу
			ИтогоСуммаСкидкиРабот  = ИтогоСуммаСкидкиРабот + СтрокаРабот.СуммаСкидкиСтроки;
			ИтогоСуммаРабот = ИтогоСуммаРабот + СтрокаРабот.СуммаВсего;
			ИтогоСуммаНДС = ИтогоСуммаНДС + СтрокаРабот.СуммаНДС;

			//инициализация итогов по странице
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки", 0, 0);
				НомерСтраницыПред = НомерСтраницы;
			КонецЕсли;

			//обновим итоги по странице
			дкДобавитьИтогиПоСтранице(СтрокаРабот, СтруктураИтоговПоСтранице);
		КонецЦикла; 

		//довыводим последний итог по странице, если страниц больше единицы
		Если НомерСтраницы > 2 Тогда
		  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтоговПоСтраницеУслуги, СтруктураИтоговПоСтранице, Права);
		КонецЕсли;

		//Вывод подвала табличной части услуг
		ОбластьПодвалУслуг.Параметры.СуммаВсего = Формат(ИтогоСуммаРабот, ФорматВыводаСуммы);

		НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьПодвалУслуг, , , НомерСтраницы, , Права);
	КонецЕсли;
	
	// Товары
	ОбластьДетали = Макет.ПолучитьОбласть("Детали");
	ОбластьШапкаДеталей = ОбластьДетали.ПолучитьОбласть("ШапкаДеталей");
	ОбластьСтрокаДеталей	        = Макет.ПолучитьОбласть("СтрокаДеталей");
	ОбластьИтоговПоСтраницеДетали	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталей");
	ОбластьПодвалДеталей	        = Макет.ПолучитьОбласть("ПодвалДетали");
	
	ИтогоСуммаСкидкиТоваров  = 0;
	ИтогоСуммаТоваров = 0;
	КоличествоТоваров = ДокументОбъект.Товары.Количество(); 
	Если КоличествоТоваров > 0 Тогда 
		
		//Иванченко 20260429 ++  
		Если Не ДокументОбъект.ВидРемонта.ГарантияЗавода И Не (ДокументОбъект.ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий ИЛИ ДокументОбъект.ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт) Тогда
			ОбщийМодуль_ИванченкоИлья.МодифицироватьТЧ(ОбластьДетали, ОбластьСтрокаДеталей, 1, "Каталожный номер");
		КонецЕсли;	
		//Иванченко 20260429 --	
		
		//Вывод шапки табличной части работ(услуг)
		ТабДокумент.Вывести(ОбластьДетали);

		НомерСтраницы = 2;
		НомерСтраницыПред = 2;

		//Вывод табличной части товаров
		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки", 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалДеталей);		  	  
		Ном	= 0;
		Для каждого СтрокаТоваров Из ДокументОбъект.Товары Цикл
			Ном = Ном + 1;
			ОбластьСтрокаДеталей.Параметры.НомСтр = Ном;
			ОбластьСтрокаДеталей.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура, ИмяРеквизитаКода, Права);
			ОбластьСтрокаДеталей.Параметры.Наименование = СтрокаТоваров.Номенклатура.НаименованиеПолное;
			ОбластьСтрокаДеталей.Параметры.Количество = Формат(СтрокаТоваров.Количество, ФорматВыводаКоличества);
			ОбластьСтрокаДеталей.Параметры.ЕдИзм = СтрокаТоваров.ЕдиницаИзмерения;
			ОбластьСтрокаДеталей.Параметры.Цена = Формат(СтрокаТоваров.Цена, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.ПроцентСкидки = Формат(СтрокаТоваров.ПроцентСкидки, "ЧЦ=8");
			ОбластьСтрокаДеталей.Параметры.Сумма = Формат(СтрокаТоваров.СуммаВсего, ФорматВыводаСуммы);

			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаДеталей, ОбластьШапкаДеталей, ОбластьИтоговПоСтраницеДетали, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоТоваров, МассивОбластиПодвала, Неопределено));

			// Обновим итоги по документу
			ИтогоСуммаСкидкиТоваров  = ИтогоСуммаСкидкиТоваров + СтрокаТоваров.СуммаСкидкиСтроки;
			ИтогоСуммаНДС = ИтогоСуммаНДС + СтрокаТоваров.СуммаНДС;
			ИтогоСуммаТоваров = ИтогоСуммаТоваров + СтрокаТоваров.СуммаВсего;

			//инициализация итогов по странице
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки", 0, 0);
				НомерСтраницыПред = НомерСтраницы;
			КонецЕсли;

			//обновим итоги по странице
			дкДобавитьИтогиПоСтранице(СтрокаТоваров, СтруктураИтоговПоСтранице);
		КонецЦикла; 

		//довыводим последний итог по странице, если страниц больше единицы
		Если НомерСтраницы > 2 Тогда
		  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтоговПоСтраницеДетали, СтруктураИтоговПоСтранице, Права);
		КонецЕсли;

		//Вывод подвала табличной части товаров
		ОбластьПодвалДеталей.Параметры.СуммаВсего = Формат(ИтогоСуммаТоваров, ФорматВыводаСуммы);

		НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьПодвалДеталей, , , НомерСтраницы, , Права);
	КонецЕсли;
	
	// Итоги
	ОбластьИтоги = Макет.ПолучитьОбласть("Итоги");
	ОбластьИтоги.Параметры.СуммаВсего = Формат(ИтогоСуммаРабот + ИтогоСуммаТоваров, ФорматВыводаСуммы);
	ОбластьИтоги.Параметры.СтоимостьРабот = Формат(ИтогоСуммаРабот, ФорматВыводаСуммы);
	Если ИтогоСуммаСкидкиРабот > 0 Тогда
		ОбластьИтоги.Параметры.СкидкаРаботы = Формат(ИтогоСуммаСкидкиРабот, ФорматВыводаСуммы) + ", ₽";
	Иначе
		ОбластьИтоги.Параметры.СкидкаРаботы = "-";
	КонецЕсли; 
	ОбластьИтоги.Параметры.СтоимостьМатериалов = Формат(ИтогоСуммаТоваров, ФорматВыводаСуммы);
	Если ИтогоСуммаСкидкиТоваров > 0 Тогда
		ОбластьИтоги.Параметры.СкидкаМатериалы = Формат(ИтогоСуммаСкидкиТоваров, ФорматВыводаСуммы) + ", ₽";
	Иначе
		ОбластьИтоги.Параметры.СкидкаМатериалы = "-";
	КонецЕсли;
	ОбластьИтоги.Параметры.СуммаНДС = Формат(ИтогоСуммаНДС, ФорматВыводаСуммы);
	ОбластьИтоги.Параметры.СуммаПрописью = обЧислоПрописью(ИтогоСуммаРабот + ИтогоСуммаТоваров, Справочники.Валюты.НайтиПоКоду("643"));
	ОбластьИтоги.Параметры.Рекомендации = ДокументОбъект.Рекомендации;
	ТабДокумент.Вывести(ОбластьИтоги);
	
	// Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");	
	//ОбластьПодвал.Параметры.Организация = Организация.Наименование;
	//ОбластьПодвал.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(ДокументОбъект.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	//ОбластьПодвал.Параметры.ДатаМашинозаезда = Формат(ДатаМашинозаезда, "ДЛФ=ДД");
	ТабДокумент.Вывести(ОбластьПодвал);
	//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц(); //переходим на следующую страницу
	
	//////////////////////////////////////////////////////
	// Нижние колонтитулы
	НижнийКолонтитул = ТабДокумент.НижнийКолонтитул;
	НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	
	НижнийКолонтитул.ТекстСлева = 
	"___________________/_____________________________/
	| подпись Заказчика       Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстСправа = 
	"____________________/"+ФИО_(ДокументОбъект.Диспетчер)+"/
	|подпись Исполнителя      Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстВЦентре = "Заказ-наряд № " + СокрЛП(ДокументОбъект.Номер) + ", страница [&НомерСтраницы] из [&СтраницВсего]";
	
	НижнийКолонтитул.Шрифт = Новый Шрифт("Arial", 7);
	НижнийКолонтитул.Выводить = Истина;
	НижнийКолонтитул.НачальнаяСтраница = 1;
	
	ТабДокумент.ПолеСверху              = 5;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 5;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	
	Возврат ТабДокумент; 
	
КонецФункции //ЭксидЗаказНаряд(ТабДокумент) 

Функция ПечатьЭксидЛистКонтроля(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	ДокументОбъект = ЭтотОбъект;
	
	Макет = ПолучитьМакет("ЭксидЛистКонтроля");
	
	//Бондаренко++ 20260721
	МаркаАвто = "";
 	Попытка	МаркаАвто = Автомобиль.Модель.Марка; Исключение	КонецПопытки;
 	Если Не обЗначениеНеЗаполнено(МаркаАвто) Тогда
		Если МаркаАвто = Справочники.Марка.ESTEO Тогда
			Макет = ПолучитьМакет("ЭстеоЛистКонтроля");
 		КонецЕсли;
 	КонецЕсли;
	//Бондаренко-- 20260721
	
	Организация = ДокументОбъект.Организация;
	Макет.Параметры.Организация = Организация.Наименование;
	Макет.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(ДокументОбъект.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Макет.Параметры.ТелефонОрганизации = киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	Макет.Параметры.ИННОрганизации = Организация.ИНН;

	Заказчик = ДокументОбъект.Заказчик;
	Попытка
	  Если ЗначениеЗаполнено(ДокументОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
		  Заказчик = ДокументОбъект._г_ДоверенноеЛицоЗаказчика;
	  КонецЕсли;			  
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик) Тогда
	  Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;	  	
	Макет.Параметры.Заказчик = Заказчик.Наименование;
	Макет.Параметры.ЗаказчикТел = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если обЗначениеНеЗаполнено(Макет.Параметры.ЗаказчикТел) Тогда
	  Макет.Параметры.ЗаказчикТел = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если обЗначениеНеЗаполнено(Макет.Параметры.ЗаказчикТел) Тогда
	  Макет.Параметры.ЗаказчикТел = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	
	ДатаМашинозаезда = ДокументОбъект.ДатаМашинозаезда;
	Макет.Параметры.Номер = ДокументОбъект.Номер;
	
	Автомобиль = ДокументОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	Макет.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
	Модель = Автомобиль.Модель;
	Макет.Параметры.Модель = Модель.Наименование;
	Макет.Параметры.Марка = Модель.Марка.Наименование;
	Макет.Параметры.ВИН = ДокументОбъект.Автомобиль.VIN;	
	//Макет.Параметры.НомерДвигателя = ДокументОбъект.Автомобиль.НомерДвигателя;
	// Холышевская ++ 26.03.2026
	Пойменная = Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000223");
	
	Если ПараметрыСеанса.ПодразделениеКомпании = Пойменная ИЛИ ПараметрыСеанса.ПодразделениеКомпании.Родитель = Пойменная Тогда
		Макет.Параметры.Пробег = "";
	Иначе
		// Холышевская -- 26.03.2026	
		Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаМашинозаезда);
		Если Пробег = 0 Тогда
			Макет.Параметры.Пробег = Формат(ДокументОбъект.Пробег, "ЧЦ=10");
		Иначе
			Макет.Параметры.Пробег = Формат(Пробег, "ЧЦ=10");		
		КонецЕсли;   
	КонецЕсли;
	//Макет.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, "ДФ=гггг");	  	  
	Макет.Параметры.ДатаНачалаГарантии = Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д");
 	
	ТабДокумент.Вывести(Макет);
	
	//////////////////////////////////////////////////////
	// Нижние колонтитулы
	НижнийКолонтитул = ТабДокумент.НижнийКолонтитул;
	НижнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	
	НижнийКолонтитул.ТекстСлева = 
	"____________________________/" + ФИО_(ДокументОбъект.Диспетчер) + "/
	|подпись Мастера-консультанта       Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстСправа = 
	"____________________/" + ФИО(ДокументОбъект.Мастер) + "/
	|подпись Мастера цеха      Фамилия и инициалы";
	
	НижнийКолонтитул.ТекстВЦентре = "Страница [&НомерСтраницы] из [&СтраницВсего]";
	
	НижнийКолонтитул.Шрифт = Новый Шрифт("Arial", 7);
	НижнийКолонтитул.Выводить = Истина;
	НижнийКолонтитул.НачальнаяСтраница = 1;
	
	ТабДокумент.ПолеСверху              = 5;
	ТабДокумент.ПолеСлева               = 5;
