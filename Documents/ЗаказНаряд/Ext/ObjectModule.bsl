Функция НайтиСоздатьАвтоработу(ТекРабота,ТекВИН)
	
	Работа_ = "";
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автоработы.Ссылка КАК Ссылка,
		|	Автоработы.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Автоработы КАК Автоработы
		|ГДЕ
		|	Автоработы.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", СокрЛП(ТекРабота)+" №"+СокрЛП(ДоговорВзаиморасчетов.НомерДоговора)+" от "+Формат(ДоговорВзаиморасчетов.ДатаНачала,"ДЛФ=DD")+" VIN "+СокрЛП(ТекВИН));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовРабота = Справочники.Автоработы.ПредпродажнаяПодготовкаУАЗ.Скопировать();
	
	//Бондаренко++ 20240605
	ТекНаим = СокрЛП(НовРабота.Наименование)+" №"+СокрЛП(ДоговорВзаиморасчетов.НомерДоговора)+" от "+Формат(ДоговорВзаиморасчетов.ДатаНачала,"ДЛФ=DD")+" VIN "+СокрЛП(ТекВИН);
	ТекНаимПолное = СокрЛП(НовРабота.НаименованиеПолное)+" №"+СокрЛП(ДоговорВзаиморасчетов.НомерДоговора)+" от "+Формат(ДоговорВзаиморасчетов.ДатаНачала,"ДФ=dd.MM.yyyy")+" VIN "+СокрЛП(ТекВИН);
	//Бондаренко-- 20240605
	
	НовРабота.Наименование = ТекНаим; 
	НовРабота.НаименованиеПолное = ТекНаимПолное;
	НовРабота.Комментарий = "Работа создана программно: "+Формат(ТекущаяДата(),"ДЛФ=DDT")+" пользователем: "+СокрЛП(ПараметрыСеанса.Пользователь);
	НовРабота.УстановитьНовыйКод("");
	
	Попытка
	    НовРабота.Записать();
	Исключение
		Возврат Работа_;
 	КонецПопытки;

	Возврат НовРабота.Ссылка;
 
КонецФункции // НайтиСоздатьАвтоработу(ТекРабота,ТекВИН)
