		Запрос.Текст = "ВЫБРАТЬ
		|	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль
		|ИЗ
		|	РегистрСведений.Автомобили.СрезПоследних(, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)) КАК АвтомобилиСрезПоследних
		|ГДЕ
		|	АвтомобилиСрезПоследних.Значение = &Хозяин";
		Запрос.УстановитьПараметр("Хозяин",Заказчик);
		СписокАвтомобилей=Новый СписокЗначений;
		Выборка=Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокАвтомобилей.Добавить(Выборка.Автомобиль);
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказНаряд.Автомобиль.Ссылка КАК Автомобиль,
		|	ЗаказНаряд.Заказчик КАК Заказчик,
		|	ЗаказНаряд.Дата
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗаказНаряд.Проведен КАК Проведен,
		|			МАКСИМУМ(ЗаказНаряд.Дата) КАК Дата,
		|			ЗаказНаряд.Автомобиль КАК Автомобиль
		|		ИЗ
		|			Документ.ЗаказНаряд КАК ЗаказНаряд
		|		ГДЕ
		|			ЗаказНаряд.Проведен = ИСТИНА
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЗаказНаряд.Проведен,
		|			ЗаказНаряд.Автомобиль) КАК ВложенныйЗапрос
		|		ПО ЗаказНаряд.Автомобиль = ВложенныйЗапрос.Автомобиль
		|ГДЕ
		|	ЗаказНаряд.Проведен = ИСТИНА
		|	И ЗаказНаряд.Заказчик = &Хозяин
		|	И ЗаказНаряд.Дата = ВложенныйЗапрос.Дата";
		Запрос.УстановитьПараметр("Хозяин",Заказчик);
		Выборка=Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл 
			Если СписокАвтомобилей.НайтиПоЗначению(Выборка.Автомобиль)=Неопределено Тогда
				СписокАвтомобилей.Добавить(Выборка.Автомобиль);
			КонецЕсли;
		КонецЦикла; 
		Если СписокАвтомобилей.Количество() = 1 Тогда
			Автомобиль = СписокАвтомобилей[0].Значение; 
			//Бондаренко++ 20220204				
			Пробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег,?(обЗначениеНеЗаполнено(ДатаНачала),ДатаСоздания,ДатаНачала));
			//Бондаренко-- 20220204
		КонецЕсли;
	КонецЕсли;
 	
КонецПроцедуры //СМГ_УстановитьАвтомобильИПробег(Автомобиль,Пробег)
