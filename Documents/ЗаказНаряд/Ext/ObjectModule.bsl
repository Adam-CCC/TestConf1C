		ОбластьМакета.Параметры.НПП = НПП;
		ОбластьМакета.Параметры.КодРаботы = ?(обЗначениеНеЗаполнено(Стр.Работа.Артикул),Стр.Работа.Код,Стр.Работа.Артикул);
		ОбластьМакета.Параметры.НаименованиеРаботы = Стр.Работа;
		ОбластьМакета.Параметры.КолРаботы = Стр.Количество*Стр.Коэффициент;
		//ОбластьМакета.Параметры.ЕдИзмРаботы = Стр.Нормочас;
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЦикла; 
	
	ОбластьМакета = Макет.ПолучитьОбласть("СтрокаРаботПустая");
	Для жи = 1 По 3 Цикл
		ТабДокумент.Вывести(ОбластьМакета);
 	КонецЦикла; 
	
	//=========================== Детали ================================

	//Иванченко 20260429 ++   
	//ОбластьМакета = Макет.ПолучитьОбласть("Детали");
	//ТабДокумент.Вывести(ОбластьМакета); 
	
	ОбластьДетали = Макет.ПолучитьОбласть("Детали");
