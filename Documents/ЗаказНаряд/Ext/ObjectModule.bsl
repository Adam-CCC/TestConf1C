Функция ПечатьЕДОСАктПриёмаПередачиТС(ТабДокумент) Экспорт
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	//Если ЭтотОбъект.ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Автолига Тогда
	//	ЭтотОбъект.Печать("СОПД для Ford (внешняя)");
	//КонецЕсли;
	
	Макет = ПолучитьМакет("ЕДОСАктПриёмаПередачиТС");
	
	//Бондаренко++ 20251010
  	Если ЭтотОбъект.ЗаменаНомерныхРамок Тогда
		Макет.Параметры.ОНомерныхРамкахТекст = "Замена номерных рамок";
	ИначеЕсли ЭтотОбъект.ОтказОтЗаменыНомерныхРамок Тогда
		Макет.Параметры.ОНомерныхРамкахТекст =  "Отказ от замены номерных рамок";
	Иначе
		Макет.Параметры.ОНомерныхРамкахТекст =  "Рамки не менять";
	КонецЕсли;
   	//Бондаренко-- 20251010
 	
	// Вывод шапки документа для Дилера
	Если ЗначениеЗаполнено(ЭтотОбъект.Автомобиль) Тогда
