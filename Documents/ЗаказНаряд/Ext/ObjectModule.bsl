// Формирует отчет история по заказ нарядам
Процедура ОтчетИсторияПоЗаказНарядамРек() Экспорт
	ОзнакомленСИсторией = Истина;
	
	// заполним параметры отчета
	Отчет = Отчеты.ИсторияПоЗаказНарядамРек.Создать();
	Отчет.ЗаполнитьНачальныеНастройки();
	
	МетаданныеОтчета = Отчет.Метаданные();
	
	ВариантОтчета = Отчет.СхемаКомпоновкиДанных.ВариантыНастроек.Основной;
	ВариантОтчета.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала",    ДобавитьМесяц(НачалоМесяца(Дата),-12));
	ВариантОтчета.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", КонецМесяца(Дата));
	ВариантОтчета.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВалютаОтчета",  ВалютаДокумента);
	
	ОтчетыСервер.КомпоновщикУстановитьОтбор(ВариантОтчета.Настройки, "Автомобиль", Автомобиль);
	
	ИмяФормыОтчета = МетаданныеОтчета.ПолноеИмя() + ".ФормаНастроек";
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Вариант",               ВариантОтчета.Настройки);
	СтруктураПараметров.Вставить("ЗаполнитьНастроки",     Ложь);
	СтруктураПараметров.Вставить("КлючВарианта",          ВариантОтчета.Имя);
	СтруктураПараметров.Вставить("ПредставлениеВарианта", ВариантОтчета.Представление);
	
	ФормаНастроек = ПолучитьФорму(ИмяФормыОтчета, СтруктураПараметров);
	ФормаНастроек.Открыть();
	
КонецПроцедуры

Функция ПроверитьСКОбязательные() Экспорт 
	
	//Бондаренко++ 20200724
	ПравоРукСервиса = РольДоступна("СМ_ДиректорСервиса") ИЛИ РольДоступна("СМ_РуководительОтделаСервиса");
	//Бондаренко-- 20200724
	
	//Бондаренко++ 20200807
	Если Не обЗначениеНеЗаполнено(ПодразделениеКомпании) Тогда
		Если Не обЗначениеНеЗаполнено(ПодразделениеКомпании.ДилерскийЦентр) Тогда
			
			СЗ = Новый СписокЗначений;
			ТЗ = Новый ТаблицаЗначений;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 	"ВЫБРАТЬ
			               	|	ДилерскиеЦентрыМаркиДляСервисныхКампаний.Марка КАК МаркаДЦ,
			               	|	ДилерскиеЦентрыМаркиДляСервисныхКампаний.Ссылка КАК ДЦ,
			               	|	ЗН.Ссылка КАК СамЗН,
			               	|	ЗН.ПодразделениеКомпанииДилерскийЦентр КАК ДЦЗН
			               	|ИЗ
			               	|	Справочник.ДилерскиеЦентры.МаркиДляСервисныхКампаний КАК ДилерскиеЦентрыМаркиДляСервисныхКампаний
			               	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			               	|			ЗаказНаряд.Ссылка КАК Ссылка,
			               	|			ЗаказНаряд.ПодразделениеКомпании.ДилерскийЦентр КАК ПодразделениеКомпанииДилерскийЦентр
			               	|		ИЗ
			               	|			Документ.ЗаказНаряд КАК ЗаказНаряд) КАК ЗН
			               	|		ПО ДилерскиеЦентрыМаркиДляСервисныхКампаний.Ссылка = ЗН.ПодразделениеКомпанииДилерскийЦентр.Ссылка
			               	|ГДЕ
			               	|	ЗН.Ссылка = &ЗН";
			
			Запрос.УстановитьПараметр("ЗН",Ссылка);
			
			ТЗ = Запрос.Выполнить().Выгрузить();
			
			//ТЗ.ВыбратьСтроку();
 	 
			СЗ.ЗагрузитьЗначения(ТЗ.ВыгрузитьКолонку("МаркаДЦ"));
			
			Если СЗ.Количество() > 0 Тогда
				Если СЗ.НайтиПоЗначению(Автомобиль.Модель.Марка) = Неопределено Тогда
					Возврат "";		
				КонецЕсли;
			Иначе
				Возврат "";
	 		КонецЕсли; 
	 	КонецЕсли; 
	КонецЕсли; 
	//Бондаренко-- 20200807
	
	Если Не ПравоРукСервиса тогда
		Текст = "Есть обязательные сервисные кампании:";
		Флаг = Ложь;
		СК = орПроверитьСервиснуюКампанию(Автомобиль,Дата,Истина,Ссылка);
		
		
		Для Каждого стр из СК цикл 
			Если стр.СервиснаяКампания <> СервиснаяКампания тогда
				Если стр.СервиснаяКампания.Обязательная и стр.ДокументВыполнения = Документы.ЗаказНаряд.ПустаяСсылка() тогда
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					|	ЗаказНаряд.Ссылка
					|ИЗ
					|	Документ.ЗаказНаряд КАК ЗаказНаряд
					|ГДЕ
					|	ЗаказНаряд.СервиснаяКампания = &СервиснаяКампания
					|	И ЗаказНаряд.Автомобиль = &Автомобиль";
					
					Запрос.УстановитьПараметр("СервиснаяКампания",стр.СервиснаяКампания);		
					Запрос.УстановитьПараметр("Автомобиль",Автомобиль);	
					Результат = Запрос.Выполнить().Выбрать();
					Если Результат.Следующий() тогда
						Продолжить;
					КонецЕсли;	 
					
					Если Текст = "Есть обязательные сервисные кампании:" Тогда
						Текст = СокрЛП(Текст) + " "+стр.СервиснаяКампания;
					Иначе	
						Текст = СокрЛП(Текст) + "; "+стр.СервиснаяКампания;
 					КонецЕсли; 
					 
					Флаг = Истина;
					Если Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт тогда
						//Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			
			
		КонецЦикла;
		Если Флаг тогда
			Возврат СокрЛП(Текст) +" Сформируйте заказ-наряды на эти сервисные кампании.";
		Иначе 
			Возврат "";
		КонецЕсли;
	Иначе 
		Возврат "";
		
	КонецЕсли;
КонецФункции

Процедура  ЗаписатьОткрытиеЗакрытиеДокумента(Флаг) Экспорт 
	Если Флаг тогда
		МенеджерЗаписи = РегистрыСведений.РегистрацияВремениРаботТехПроцесс.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период    = ТекущаяДата();
		МенеджерЗаписи.ЗаказНаряд= Ссылка;
		МенеджерЗаписи.ВидОтметки= Справочники.ВидыОтметокВремени.Работа;
		МенеджерЗаписи.Авторабота= Справочники.Автоработы.Оформление;
		МенеджерЗаписи.Сотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
		
		//Если НовоеСостояние <> Справочники.ВидыОтметокВремени.НерабочееВремя Тогда
		//	МенеджерЗаписи.ЗаказНаряд   = пвЗаказНаряд;
		//	МенеджерЗаписи.ПакетРабот   = ТекПакетРабот;
		//	МенеджерЗаписи.РабочееМесто = пвРабочееМесто;
		//КонецЕсли;
		//
		//МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Записать(Истина);
		
		
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РегистрацияВремениСотрудника.Период КАК Период,
		|	РегистрацияВремениСотрудника.Сотрудник КАК Сотрудник,
		|	РегистрацияВремениСотрудника.ВидОтметки КАК ВидОтметки,
		|	РегистрацияВремениСотрудника.КонецРаботы КАК КонецРаботы,
		|	РегистрацияВремениСотрудника.Продолжительность КАК Продолжительность,
		|	РАЗНОСТЬДАТ(РегистрацияВремениСотрудника.Период, &ТекДата, МИНУТА) / 60 КАК Часы,
		|	РегистрацияВремениСотрудника.Авторабота
		|ИЗ
		|	РегистрСведений.РегистрацияВремениРаботТехПроцесс КАК РегистрацияВремениСотрудника
		|ГДЕ
		|	РегистрацияВремениСотрудника.Сотрудник = &Сотрудник
		|	И РегистрацияВремениСотрудника.ВидОтметки = &Работа
		|	И РегистрацияВремениСотрудника.КонецРаботы = &ПустаяДата
		|	И РегистрацияВремениСотрудника.Продолжительность = 0
		|	И РегистрацияВремениСотрудника.КонецРаботы = &ПустаяДата
		|	И РегистрацияВремениСотрудника.Период МЕЖДУ &НАчПериода И &КонПериода
		|	И РегистрацияВремениСотрудника.ЗаказНаряд = &ЗаказНаряд
		|	И РегистрацияВремениСотрудника.Авторабота = &Авторабота";
		
		Запрос.УстановитьПараметр("ЗаказНаряд"  , Ссылка);
		Запрос.УстановитьПараметр("Сотрудник"  , ПараметрыСеанса.Пользователь.Сотрудник);
		Запрос.УстановитьПараметр("Авторабота"  ,Справочники.Автоработы.Оформление);
		
		Запрос.УстановитьПараметр("ТекДата"  , ТекущаяДата());
		Запрос.УстановитьПараметр("Работа"     , Справочники.ВидыОтметокВремени.Работа);
		Запрос.УстановитьПараметр("ПустаяДата" , Дата("00010101"));
		Запрос.УстановитьПараметр("НАчПериода"  , НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("КонПериода"  , КонецДня(ТекущаяДата()));
		
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		
		Если Не РезультатЗапроса.Следующий() тогда
			
			Возврат;
			
		КонецЕсли;	
		
		СтрокаЗапроса =  РезультатЗапроса;
		
		НаборЗаписей = РегистрыСведений.РегистрацияВремениРаботТехПроцесс.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(СтрокаЗапроса.Период);
		НаборЗаписей.Отбор.Сотрудник.Установить(СтрокаЗапроса.Сотрудник);
		НаборЗаписей.Отбор.ВидОтметки.Установить(СтрокаЗапроса.ВидОтметки);
		НаборЗаписей.Записать();
		
		
		МенеджерЗаписи = РегистрыСведений.РегистрацияВремениРаботТехПроцесс.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период    = СтрокаЗапроса.Период;
		МенеджерЗаписи.ЗаказНаряд = Ссылка;
		МенеджерЗаписи.Сотрудник = СтрокаЗапроса.Сотрудник;
		МенеджерЗаписи.Авторабота =  СтрокаЗапроса.Авторабота;
		
		МенеджерЗаписи.ВидОтметки= Справочники.ВидыОтметокВремени.Работа;
		
		МенеджерЗаписи.Продолжительность= СтрокаЗапроса.Часы;
		МенеджерЗаписи.КонецРаботы= ТекущаяДата();
		
		МенеджерЗаписи.Записать(Истина);
		
		
	КонецЕсли;	
КонецПроцедуры	

Процедура ЗаполнитьОсновныеДопРаботы () Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсключенияДляОсновныхИДопРабот.ВидРемонта
	               |ИЗ
	               |	РегистрСведений.ИсключенияДляОсновныхИДопРабот КАК ИсключенияДляОсновныхИДопРабот
	               |ГДЕ
	               |	ИсключенияДляОсновныхИДопРабот.ВидРемонта = &ВидРемонта";
	Запрос.УстановитьПараметр("ВидРемонта",ВидРемонта);	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() тогда
	   Для Каждого стр из Работы цикл
			стр.Основная = Истина;
		КонецЦикла;
		Для Каждого  стр из Товары цикл
			стр.Основная = Истина;
		КонецЦикла;	

	КонецЕсли;	
КонецПроцедуры	

Процедура СформироватьПродажуМаслаПоЮрЛицам () Экспорт 
	ТоварыКПродажи = Новый ТаблицаЗначений;
	ТоварыКПродажи.Колонки.Добавить("Товар");
	ТоварыКПродажи.Колонки.Добавить("Цена");
	ТоварыКПродажи.Колонки.Добавить("Количество");
    ТоварыКПродажи.Колонки.Добавить("ЗН");
	ТоварыКПродажи.Колонки.Добавить("ЕдиницаИзмерения");

	Для Каждого стр из Товары цикл
		  СвойствоПоНоменклатуре = обПолучитьЗначениеСвойства(стр.Номенклатура.Ссылка,ПланыВидовХарактеристик.СвойстваОбъектов._г_Масло,Ложь);

		  Если СвойствоПоНоменклатуре тогда
			  СтрокаТоварыКПродажи = ТоварыКПродажи.Добавить();
			  СтрокаТоварыКПродажи.Товар = стр.Номенклатура;
			  СтрокаТоварыКПродажи.Цена = стр.Цена;
			  СтрокаТоварыКПродажи.Количество = стр.Количество;
			  СтрокаТоварыКПродажи.ЗН = Ссылка;
			  СтрокаТоварыКПродажи.ЕдиницаИзмерения = стр.ЕдиницаИзмерения;
		  КонецЕсли;
	КонецЦикла;	
	  
	  
	  Если ТоварыКПродажи.Количество() > 0 тогда
		  г_Функции.СоздатьДокументыПерепродажиПоЮрЛицам(ТоварыКПродажи);
	  КонецЕсли; 
		  
		  
КонецПроцедуры	

