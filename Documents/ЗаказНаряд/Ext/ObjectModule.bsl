Функция ПечатьГарантийныйРемонтПриемАвтоCHANGAN(ТабДокумент) Экспорт
	
	Если Состояние <> Справочники.ВидыСостоянийЗаказНарядов.ВРаботе И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Закрыт И Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		Сообщить("Заказ-наряд должен быть либо ""В работе"", либо ""Выполнен"", либо ""Закрыт""", СтатусСообщения.Внимание);
		Возврат Неопределено;
	ИначеЕсли НЕ ВидРемонта.ГарантияЗавода Тогда
		Если НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляКомпании И НЕ ВидРемонта = Справочники.ВидыРемонта.ДобраяВоляПроизводителя И НЕ ВидРемонта = Справочники.ВидыРемонта.ВосстановительныйРемонт Тогда
			Сообщить("Вид ремонта должен быть гарантийным, либо одинм из следующих ""Добрая воля компании"", ""Добрая воля производителя""", СтатусСообщения.Внимание);
			Возврат Неопределено;		
		КонецЕсли;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Ответ = Вопрос("Выполнить пакетную печать?", Режим, 0);
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаПринтер = Истина;  
	Текст = "Вывести на печать?" + Символы.ПС + "Да - печать на принтер"+ Символы.ПС + "Нет - вывод печатных форм";
	
	Ответ = Вопрос(Текст, Режим, 0);
	 Если Ответ = КодВозвратаДиалога.Нет Тогда
		НаПринтер = Ложь;
	КонецЕсли;
	
		Для Счетчик = 1 По 4 Цикл 
			
			ТабДокумент = Новый ТабличныйДокумент;                              
			
			Если Счетчик = 1 Тогда
				ПечатьАктПриемаПередачиCHANGAN(ТабДокумент);
			ИначеЕсли Счетчик = 2 Тогда
				ПечатьПредварительныйЗаказНарядCHANGAN(ТабДокумент);
			ИначеЕсли Счетчик = 3 Тогда
				ПечатьПредварительныйЗаказНарядCHANGAN(ТабДокумент);	            	
			Иначе
				ПечатьРабочийЛистCHANGAN(ТабДокумент);
			КонецЕсли;
			
			увкНапечататьДокумент(ТабДокумент,1,НаПринтер,"",Ссылка,Неопределено);	
			
		КонецЦикла; 
	
	Возврат Неопределено;
	
КонецФункции

