	//ДатаРаспечатки = ?(ЗначениеЗаполнено(ДокументОбъект.ДатаРаспечатки), ДокументОбъект.ДатаРаспечатки, ТекущаяДата());
	//ТабДокумент.НижнийКолонтитул.ТекстСлева="Дата распечатки: " + Формат(ДатаРаспечатки,"ДФ = дд.ММ.гггг");
	//ТабДокумент.НижнийКолонтитул.Шрифт = ТабДокумент.ВерхнийКолонтитул.Шрифт;
	ТабДокумент.ПолеСверху              = 0;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 0;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	#КонецЕсли

	Возврат ТабДокумент;
КонецФункции  

Функция ПечатьЛадаНарядНаРаботы(ТабДокумент) Экспорт
	
 	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли; 
	#Если Клиент Тогда
	ДокументОбъект = ЭтотОбъект;
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВверх;
	ТабДокумент.ПолеСверху              = 0;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 0;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	
	НомерСтраницы = 1;
 	
	Макет = ПолучитьМакет("ЛадаНарядНаРаботы");	  
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");  
	
	// Вывод остальной шапки документа
	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	ЗаказНарядДата = ДокументОбъект.Дата;
	ОбластьШапка.Параметры.ЗаказНарядДата = Формат(ЗаказНарядДата,"ДЛФ=ДД");
	ОбластьШапка.Параметры.ПричинаОбращения = ДокументОбъект.ПричинаОбращения;
	Автомобиль_ = ДокументОбъект.Автомобиль;
	ОбластьШапка.Параметры.VIN = Автомобиль_.VIN;
	ОбластьШапка.Параметры.РегНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль_, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ЗаказНарядДата);
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	// Работы
	ОбластьСтрокаУслуг = Макет.ПолучитьОбласть("СтрокаРабот");	
	КоличествоРабот = ДокументОбъект.Работы.Количество();
	Если КоличествоРабот > 0 Тогда
		//Вывод табличной части работ
		Ном	= 0;
		Для каждого СтрокаРабот Из ДокументОбъект.Работы Цикл
			Ном = Ном + 1;
			ОбластьСтрокаУслуг.Параметры.НомСтр = Ном;
			ОбластьСтрокаУслуг.Параметры.Наименование = СтрокаРабот.Работа.НаименованиеПолное;
			
			СтрокаИсполнитель = ДокументОбъект.Исполнители.Найти(СтрокаРабот.ИдентификаторРаботы, "ИдентификаторРаботы");
			Если СтрокаИсполнитель <> Неопределено И ЗначениеЗаполнено(СтрокаИсполнитель.Исполнитель) Тогда
				ОбластьСтрокаУслуг.Параметры.Исполнитель = СтрокаИсполнитель.Исполнитель.Фамилия;
			КонецЕсли;
			ТабДокумент.Вывести(ОбластьСтрокаУслуг);
		КонецЦикла; 
	КонецЕсли;

	// Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
  	ТабДокумент.Вывести(ОбластьПодвал);              

	ОбластьШапкаИПГ = Макет.ПолучитьОбласть("ШапкаИПГ");
	ОбластьСтрокаИПГ = Макет.ПолучитьОбласть("СтрокаИПГ");
	ОбластьПодвалИПГ = Макет.ПолучитьОбласть("ПодвалИПГ");                            
	ОбластьПодвалИПГ.Параметры.МастерЦеха = ДокументОбъект.Мастер.Наименование;	  	  
	
	СтрокаШапка = Новый Массив;
	СтрокаШапка.Добавить(ОбластьШапкаИПГ);
 	Если Не ТабДокумент.ПроверитьВывод(СтрокаШапка) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		НомерСтраницы = НомерСтраницы + 1;
 	КонецЕсли;
	
	СтрокаСПодвалом = Новый Массив; // создадим массив для проверки вывода 
	СтрокаСПодвалом.Добавить(ОбластьСтрокаИПГ); 
 	
 	Если Не ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		НомерСтраницы = НомерСтраницы + 1;
 	КонецЕсли;
  	
	ТабДокумент.Вывести(ОбластьШапкаИПГ);
	Для Счетчик = 1 По 48 Цикл
		Если Не ТабДокумент.ПроверитьВывод(СтрокаСПодвалом) Тогда
			Если НомерСтраницы = 1 Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				НомерСтраницы = НомерСтраницы + 1;
				СтрокаСПодвалом.Добавить(ОбластьПодвалИПГ); 
			Иначе					
 				Прервать;
			КонецЕсли;
  		КонецЕсли;
 		ТабДокумент.Вывести(ОбластьСтрокаИПГ);
  	КонецЦикла;
	 
   	ТабДокумент.Вывести(ОбластьПодвалИПГ);
	
 	ТабДокумент.ПолеСверху              = 0;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 0;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВверх;
	#КонецЕсли

	Возврат ТабДокумент;
КонецФункции  

Функция ПечатьЛадаАктВыполненныхРабот(ТабДокумент) Экспорт
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;  
	
	#Если Клиент Тогда
	ДокументОбъект = ЭтотОбъект;
	
	Макет = ПолучитьМакет("ЛадаАктВыполненныхРабот");	  
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");  
	Организация_ = ДокументОбъект.Организация;
	ОбластьШапка.Параметры.Организация = Организация_.Наименование;
	ОбластьШапка.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(Организация_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьШапка.Параметры.ТелефонОрганизации = киПолучитьПредставлениеКИ(Организация_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	
	// Вывод остальной шапки документа
	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	ОбластьШапка.Параметры.ЗаказНарядДата = Формат(ДокументОбъект.Дата,"ДЛФ=ДД");
	//ОбластьШапка.Параметры.Время = Формат(ТекущаяДата,"ДЛФ=В");
	ОбластьШапка.Параметры.Организация = Организация.Наименование;
	  
	Автомобиль_ = ДокументОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль_) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	  
	//Владелец = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин, ДокументОбъект.ДатаСоздания);
	Владелец_ = ДокументОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
	  Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
  	КонецЕсли;
	
	ОбластьШапка.Параметры.Владелец = Владелец_.Наименование;
	ОбластьШапка.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если ОбластьШапка.Параметры.ВладелецАдрес = "" Тогда
	  ОбластьШапка.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ВладелецАдрес = "" Тогда
	  ОбластьШапка.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	ОбластьШапка.Параметры.ВладелецТелефон = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если ОбластьШапка.Параметры.ВладелецТелефон = "" Тогда
	  ОбластьШапка.Параметры.ВладелецТелефон = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ВладелецТелефон = "" Тогда
	  ОбластьШапка.Параметры.ВладелецТелефон = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	ОбластьШапка.Параметры.ВладелецЕМэйл = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если ОбластьШапка.Параметры.ВладелецЕМэйл = "" Тогда
	  ОбластьШапка.Параметры.ВладелецЕМэйл = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;

	Заказчик_ = ДокументОбъект.Заказчик;
	Попытка
	  Если ЗначениеЗаполнено(ДокументОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
		  Заказчик_ = ДокументОбъект._г_ДоверенноеЛицоЗаказчика;
	  КонецЕсли;			  
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик_) Тогда
	  Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;	  	
	ОбластьШапка.Параметры.Заказчик = Заказчик_.Наименование;
	ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если ОбластьШапка.Параметры.ЗаказчикАдрес = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ЗаказчикАдрес = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	ОбластьШапка.Параметры.ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если ОбластьШапка.Параметры.ЗаказчикТелефон = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ЗаказчикТелефон = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	ОбластьШапка.Параметры.ЗаказчикЕМэйл = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если ОбластьШапка.Параметры.ЗаказчикЕМэйл = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикЕМэйл = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	Если Не ДокументОбъект.ВидРемонта.ГарантияЗавода Тогда
		Контрагент_ = ДокументОбъект.Контрагент;
		ОбластьШапка.Параметры.Контрагент = Контрагент_.Наименование;
		ОбластьШапка.Параметры.КонтрагентАдрес =  киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
		Если ОбластьШапка.Параметры.КонтрагентАдрес = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентАдрес =  киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
		КонецЕсли;
		Если ОбластьШапка.Параметры.КонтрагентАдрес = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентАдрес =  киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
		КонецЕсли;
		ОбластьШапка.Параметры.КонтрагентТелефон = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
		Если ОбластьШапка.Параметры.КонтрагентТелефон = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентТелефон = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
		КонецЕсли;
		Если ОбластьШапка.Параметры.КонтрагентТелефон = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентТелефон = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
		КонецЕсли;
		ОбластьШапка.Параметры.КонтрагентЕМэйл = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
		Если ОбластьШапка.Параметры.КонтрагентЕМэйл = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентЕМэйл = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
		КонецЕсли;
	КонецЕсли;
	  
	ОбластьШапка.Параметры.Модель = Автомобиль_.Модель.Наименование;
	ДатаСоздания_ = КонецДня(ДокументОбъект.ДатаСоздания);
	ОбластьШапка.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаСоздания);
	ОбластьШапка.Параметры.ВИН = ДокументОбъект.Автомобиль.VIN;	
	ОбластьШапка.Параметры.НомерДвигателя = ДокументОбъект.Автомобиль.НомерДвигателя;	
	Пробег_ = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаСоздания);
	ОбластьШапка.Параметры.Пробег = Формат(Пробег_, "ЧЦ=10");
	Если ОбластьШапка.Параметры.Пробег = "" Тогда
		ОбластьШапка.Параметры.Пробег = Формат(ДокументОбъект.Пробег, "ЧЦ=10");
	КонецЕсли;
	ОбластьШапка.Параметры.ГодВыпуска = Формат(Автомобиль.ГодВыпуска, "ДФ=гггг");	  	  
	ОбластьШапка.Параметры.Цвет = ДокументОбъект.Автомобиль.Цвет;	
	ОбластьШапка.Параметры.ДатаПродажи = Формат(Автомобиль.ДатаНачалаГарантии,"ДЛФ=Д");

	ОбластьШапка.Параметры.ДатаСоздания = Формат(ДокументОбъект.ДатаСоздания,"ДЛФ=ДВ");
	ОбластьШапка.Параметры.ДатаНачала = Формат(ДокументОбъект.ДатаНачала,"ДЛФ=ДВ");
	ОбластьШапка.Параметры.ПланВыдача = Формат(ДокументОбъект.ПлановаяДатаВыдачи,"ДЛФ=ДВ");
	Если ЗначениеЗаполнено(ДокументОбъект.ДатаОкончания) Тогда
		ОбластьШапка.Параметры.ДатаОкончания = Формат(ДокументОбъект.ДатаОкончания,"ДЛФ=ДВ");
	Иначе
		ОбластьШапка.Параметры.ДатаОкончания = ОбластьШапка.Параметры.ПланВыдача;
	КонецЕсли;
	ОбластьШапка.Параметры.Состояние = ДокументОбъект.Состояние;
	ОбластьШапка.Параметры.ВидРемонта = ДокументОбъект.ВидРемонта;
	
	// попытаемся напечатать ШК
	ОбработкаОбъектШтрихКоды=Обработки.ШтрихКоды.Создать();
	ОбработкаОбъектШтрихКоды.Объект=ДокументОбъект;
	ОбработкаОбъектШтрихКоды.ПрочитатьЗаполнитьШтрихКоды();
	Если ОбработкаОбъектШтрихКоды.Состав.Количество()>0 Тогда
	  ШК=ОбработкаОбъектШтрихКоды.Состав[0].ШтрихКод;
	Иначе
	  ШК="";
	КонецЕсли; 
	Попытка
	  Если ПустаяСтрока(ШК) Тогда
		  ОбластьШапка.Рисунки.Удалить(ОбластьШапка.Рисунки.ШК);
	  Иначе
		  ПрефиксВесовогоШК=Константы.ПрефиксВесовогоШК.Получить();
		  ОбластьШапка.Рисунки.ШК.Объект.ТипКода=Число(НЕ (СтрДлина(ШК)=8 И Число(Лев(ШК,2))<>ПрефиксВесовогоШК));
		  ДлинаШК=?(ОбластьШапка.Рисунки.ШК.Объект.ТипКода=0,8,13);
		  ШК=ШК+"0000000000000"; ШК=Лев(ШК,ДлинаШК-1+ОбластьШапка.Рисунки.ШК.Объект.СодержитКС);
		  ОбластьШапка.Рисунки.ШК.Объект.Сообщение=ШК;
	  КонецЕсли;
	Исключение
	КонецПопытки;
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	КолонкаКода = дкПолучитьПараметрыРежимаВыводаКодаВДокументах(,Права);
	ФорматВыводаСуммы      = обПраво("ФорматВыводаСуммы", Права);
	ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества", Права);
	
	// Работы
	ОбластьУслуги = Макет.ПолучитьОбласть("Услуги");
	ОбластьШапкаУслуг = ОбластьУслуги.ПолучитьОбласть("ШапкаУслуг");
	ОбластьСтрокаУслуг		        = Макет.ПолучитьОбласть("СтрокаРабот");
	ОбластьИтоговПоСтраницеУслуги	= Макет.ПолучитьОбласть("ИтогиПоСтраницеРабот");
	ОбластьПодвалУслуг		        = Макет.ПолучитьОбласть("ПодвалУслуги");
	
	КоличествоРабот = ДокументОбъект.Работы.Количество();
	ИтогоКоличествоРабот  = 0;
	ИтогоСуммаСкидкиРабот = 0;
	ИтогоСуммаРабот       = 0;
	Если КоличествоРабот > 0 Тогда
		//Вывод шапки табличной части работ(услуг)
		ОбластьУслуги.Параметры.ИмяКолонкиКодов = КолонкаКода.Синоним;
		ТабДокумент.Вывести(ОбластьУслуги);

		НомерСтраницы = 2;
		НомерСтраницыПред = 2;
		ТекстЗаголовка = "Выполненные работы по заказ-наряду №  " + ДокументОбъект.Номер + " от " + Формат(ДокументОбъект.Дата, "ДФ=дд.ММ.гггг");

		//заполним параметры шапки таблицы для следующего листа
		ОбластьШапкаУслуг.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 

		//Вывод табличной части работ
		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалУслуг);		  	  
		Ном	= 0;
		Для каждого СтрокаРабот Из ДокументОбъект.Работы Цикл
			Ном = Ном + 1;
			ОбластьСтрокаУслуг.Параметры.НомСтр = Ном;
			ОбластьСтрокаУслуг.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаРабот.Работа, ИмяРеквизитаКода, Права);
			ОбластьСтрокаУслуг.Параметры.Наименование = СтрокаРабот.Работа.НаименованиеПолное;
			ОбластьСтрокаУслуг.Параметры.Количество = Формат(СтрокаРабот.Количество, ФорматВыводаКоличества);
			ОбластьСтрокаУслуг.Параметры.Коэффициент = Формат(СтрокаРабот.Коэффициент, "ЧЦ=10; ЧДЦ=3");
			ОбластьСтрокаУслуг.Параметры.ПроцентСкидки = Формат(СтрокаРабот.ПроцентСкидки, "ЧЦ=8");
			ОбластьСтрокаУслуг.Параметры.Цена = Формат(СтрокаРабот.Цена, ФорматВыводаСуммы);
			ОбластьСтрокаУслуг.Параметры.СуммаНДС = Формат(СтрокаРабот.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаУслуг.Параметры.ВсегоБезНДС = Формат(СтрокаРабот.СуммаВсего - СтрокаРабот.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаУслуг.Параметры.СуммаВсего = Формат(СтрокаРабот.СуммаВсего, ФорматВыводаСуммы);
			
			СтрокаИсполнитель = ДокументОбъект.Исполнители.Найти(СтрокаРабот.ИдентификаторРаботы, "ИдентификаторРаботы");
			Если СтрокаИсполнитель <> Неопределено И ЗначениеЗаполнено(СтрокаИсполнитель.Исполнитель) Тогда
				ОбластьСтрокаУслуг.Параметры.Исполнитель = СтрокаИсполнитель.Исполнитель.Фамилия;
			КонецЕсли;

			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаУслуг, ОбластьШапкаУслуг, ОбластьИтоговПоСтраницеУслуги, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоРабот, МассивОбластиПодвала, Неопределено));

			// Обновим итоги по документу
			ИтогоКоличествоРабот  = ИтогоКоличествоРабот + СтрокаРабот.Количество;
			ИтогоСуммаСкидкиРабот = ИтогоСуммаСкидкиРабот + СтрокаРабот.СуммаСкидки;
			ИтогоСуммаРабот       = ИтогоСуммаРабот + СтрокаРабот.СуммаВсего;

			//инициализация итогов по странице
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
				НомерСтраницыПред = НомерСтраницы;
				ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
			КонецЕсли;

			//обновим итоги по странице
			дкДобавитьИтогиПоСтранице(СтрокаРабот, СтруктураИтоговПоСтранице);
		КонецЦикла; 

		//довыводим последний итог по странице, если страниц больше единицы
		Если НомерСтраницы > 2 Тогда
		  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтоговПоСтраницеУслуги, СтруктураИтоговПоСтранице, Права);
		КонецЕсли;

		//Вывод подвала табличной части услуг
		ОбластьПодвалУслуг.Параметры.Сумма = Формат(ИтогоСуммаРабот + ИтогоСуммаСкидкиРабот, ФорматВыводаСуммы);
		ОбластьПодвалУслуг.Параметры.СуммаСкидки = Формат(ИтогоСуммаСкидкиРабот, ФорматВыводаСуммы);
		ОбластьПодвалУслуг.Параметры.СуммаВсего = Формат(ИтогоСуммаРабот, ФорматВыводаСуммы);
		ОбластьПодвалУслуг.Параметры.Номер = ОбластьШапка.Параметры.Номер;
		ОбластьПодвалУслуг.Параметры.ЗаказНарядДата = ОбластьШапка.Параметры.ЗаказНарядДата;

		//ОбластьПодвалУслуг.Параметры.ЧислоПрописью = обЧислоПрописью(ИтогоСуммаРабот, ВалютаПечатногоДокумента);
		НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьПодвалУслуг, , , НомерСтраницы, , Права);
	КонецЕсли;
	
	// Товары
	ОбластьДетали = Макет.ПолучитьОбласть("Детали");
	ОбластьШапкаДеталей = ОбластьДетали.ПолучитьОбласть("ШапкаДеталей");
	ОбластьСтрокаДеталей	        = Макет.ПолучитьОбласть("СтрокаДеталей");
	ОбластьИтоговПоСтраницеДетали	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталей");
	ОбластьПодвалДеталей	        = Макет.ПолучитьОбласть("ПодвалДетали");
	
	ИтогоКоличествоТоваров  = 0;
	ИтогоСуммаСкидкиТоваров = 0;
	ИтогоСуммаТоваров       = 0;
	КоличествоТоваров = ДокументОбъект.Товары.Количество(); 
	Если КоличествоТоваров > 0 Тогда 
		
		//Иванченко 20260429 ++  
		Если Не ДокументОбъект.ВидРемонта.ГарантияЗавода И Не (ДокументОбъект.ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий ИЛИ ДокументОбъект.ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт) Тогда
			ОбщийМодуль_ИванченкоИлья.МодифицироватьТЧ(ОбластьДетали, ОбластьСтрокаДеталей, 1, "ИмяКолонкиКодов");	 
		КонецЕсли;
		//Иванченко 20260429 --	
		
		//Вывод шапки табличной части работ(услуг)
		ОбластьДетали.Параметры.ИмяКолонкиКодов = КолонкаКода.Синоним;
		ТабДокумент.Вывести(ОбластьДетали);

		НомерСтраницы = 2;
		НомерСтраницыПред = 2;
		ТекстЗаголовка = "Расходная накладная к заказ-наряду №  " + ДокументОбъект.Номер + " от " + Формат(ДокументОбъект.Дата, "ДФ=дд.ММ.гггг");

		//заполним параметры шапки таблицы для следующего листа
		ОбластьШапкаУслуг.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 

		//Вывод табличной части работ
		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалДеталей);		  	  
		Ном	= 0;
		Для каждого СтрокаТоваров Из ДокументОбъект.Товары Цикл
			Ном = Ном + 1;
			ОбластьСтрокаДеталей.Параметры.НомСтр = Ном;
			ОбластьСтрокаДеталей.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура, ИмяРеквизитаКода, Права);
			ОбластьСтрокаДеталей.Параметры.Наименование = СтрокаТоваров.Номенклатура.НаименованиеПолное;
			ОбластьСтрокаДеталей.Параметры.Количество = Формат(СтрокаТоваров.Количество, ФорматВыводаКоличества);
			ОбластьСтрокаДеталей.Параметры.ЕдИзм = СтрокаТоваров.ЕдиницаИзмерения;
			ОбластьСтрокаДеталей.Параметры.ПроцентСкидки = Формат(СтрокаТоваров.ПроцентСкидки, "ЧЦ=8");
			ОбластьСтрокаДеталей.Параметры.Цена = Формат(СтрокаТоваров.Цена, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.Сумма = Формат(СтрокаТоваров.СуммаВсего, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.СуммаНДС = Формат(СтрокаТоваров.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.ВсегоБезНДС = Формат(СтрокаТоваров.СуммаВсего - СтрокаТоваров.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.СуммаВсего = Формат(СтрокаТоваров.СуммаВсего, ФорматВыводаСуммы);

			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаДеталей, ОбластьШапкаДеталей, ОбластьИтоговПоСтраницеДетали, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоТоваров, МассивОбластиПодвала, Неопределено));

			// Обновим итоги по документу
			ИтогоКоличествоТоваров  = ИтогоКоличествоТоваров + СтрокаТоваров.Количество;
			ИтогоСуммаСкидкиТоваров = ИтогоСуммаСкидкиТоваров + СтрокаТоваров.СуммаСкидки;
			ИтогоСуммаТоваров       = ИтогоСуммаТоваров + СтрокаТоваров.СуммаВсего;

			//инициализация итогов по странице
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
				НомерСтраницыПред = НомерСтраницы;
				ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
			КонецЕсли;

			//обновим итоги по странице
			дкДобавитьИтогиПоСтранице(СтрокаТоваров, СтруктураИтоговПоСтранице);
		КонецЦикла; 

		//довыводим последний итог по странице, если страниц больше единицы
		Если НомерСтраницы > 2 Тогда
		  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтоговПоСтраницеДетали, СтруктураИтоговПоСтранице, Права);
		КонецЕсли;

		//Вывод подвала табличной части услуг
		ОбластьПодвалДеталей.Параметры.Сумма = Формат(ИтогоСуммаТоваров + ИтогоСуммаСкидкиТоваров, ФорматВыводаСуммы);
		ОбластьПодвалДеталей.Параметры.СуммаСкидки = Формат(ИтогоСуммаСкидкиТоваров, ФорматВыводаСуммы);
		ОбластьПодвалДеталей.Параметры.СуммаВсего = Формат(ИтогоСуммаТоваров, ФорматВыводаСуммы);

		НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьПодвалДеталей, , , НомерСтраницы, , Права);
	КонецЕсли;

	// Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	СуммаДокумента_ = ИтогоСуммаРабот + ИтогоСуммаТоваров + ИтогоСуммаСкидкиРабот + ИтогоСуммаСкидкиТоваров;
	ОбластьПодвал.Параметры.Сумма = Формат(СуммаДокумента_, ФорматВыводаСуммы);
	ОбластьПодвал.Параметры.СуммаСкидки = Формат(ИтогоСуммаСкидкиРабот + ИтогоСуммаСкидкиТоваров, ФорматВыводаСуммы);
	ОбластьПодвал.Параметры.СуммаВсего = Формат(ИтогоСуммаРабот + ИтогоСуммаТоваров, ФорматВыводаСуммы);
	ВалютаПечатногоДокумента = Справочники.Валюты.НайтиПоКоду("643");
	ОбластьПодвал.Параметры.ЧислоПрописью = обЧислоПрописью(ИтогоСуммаРабот + ИтогоСуммаТоваров, ВалютаПечатногоДокумента);
	Если ДокументОбъект.ВидРемонта.ГарантияЗавода Тогда
		ОбластьПодвал.Параметры.ИтогоГарантийныйРемонт = "Гарантийный ремонт выполнен бесплатно. Итого к оплате по заказу-наряду: 0 (ноль) руб.";
	КонецЕсли;
	
	//Если ДокументОбъект.ТЧ_Рекомендации.Количество() > 0 Тогда
	//	Рекомендации = "";
	//	Для Каждого СтрокаРекомендации Из ДокументОбъект.ТЧ_Рекомендации Цикл
	//		Рекомендации = Рекомендации + ?(ЗначениеЗаполнено(Рекомендации), Символы.ПС + СтрокаРекомендации.СтрокаРекомендация, СтрокаРекомендации.СтрокаРекомендация);
	//	КонецЦикла;
	//	ОбластьПодвал.Параметры.Рекомендации = Рекомендации;
	//КонецЕсли;
	ОбластьПодвал.Параметры.Рекомендации = ДокументОбъект.Рекомендации;
	
	ОбластьПодвал.Параметры.Диспетчер = ДокументОбъект.Диспетчер.Наименование;	  	  
	ОбластьПодвал.Параметры.Заказчик = ОбластьШапка.Параметры.Заказчик;	  	  
	ДатаРаспечатки_ = ?(ЗначениеЗаполнено(ДокументОбъект.ДатаРаспечатки), ДокументОбъект.ДатаРаспечатки, ТекущаяДата());
	ОбластьПодвал.Параметры.ДатаРаспечатки = Формат(ДатаРаспечатки_,"ДФ = дд.ММ.гггг");
	
	ТабДокумент.Вывести(ОбластьПодвал);
	
	////////////////////////////////////////////////////////
	//// Нижние колонтитулы
	//ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение=ВертикальноеПоложение.Низ;
	//ТабДокумент.НижнийКолонтитул.Выводить = Истина;
	//ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	//ДатаРаспечатки = ?(ЗначениеЗаполнено(ДокументОбъект.ДатаРаспечатки), ДокументОбъект.ДатаРаспечатки, ТекущаяДата());
	//ТабДокумент.НижнийКолонтитул.ТекстСлева="Дата распечатки: " + Формат(ДатаРаспечатки,"ДФ = дд.ММ.гггг");
	//ТабДокумент.НижнийКолонтитул.Шрифт = ТабДокумент.ВерхнийКолонтитул.Шрифт;
	ТабДокумент.ПолеСверху              = 0;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 0;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	#КонецЕсли

	Возврат ТабДокумент;
КонецФункции // ПечатьЛадаАктВыполненныхРабот(ТабДокумент) 

Функция ПечатьЛадаДоговорЗаказНаряд(ТабДокумент) Экспорт
	
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;                      
	
	#Если Клиент Тогда
	ДокументОбъект = ЭтотОбъект;
	
	Макет = ПолучитьМакет("ЛадаДоговорЗаказНаряд");	  
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");  
	Организация_ = ДокументОбъект.Организация;
	ОбластьШапка.Параметры.Организация = Организация_.Наименование;
	ОбластьШапка.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(ДокументОбъект.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ТелефонОрганизации = киПолучитьПредставлениеКИ(Организация_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	
	// Вывод остальной шапки документа
	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	ОбластьШапка.Параметры.ЗаказНарядДата = Формат(ДокументОбъект.Дата,"ДЛФ=ДД");
	//ОбластьШапка.Параметры.Время = Формат(ТекущаяДата,"ДЛФ=В");
	ОбластьШапка.Параметры.Организация = Организация_.Наименование;
	  
	Автомобиль_ = ДокументОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль_) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	  
	//Владелец = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин, ДокументОбъект.ДатаСоздания);
	Владелец_ = ДокументОбъект.Владелец;
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
	  Сообщить("Поле Владелец не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
  	КонецЕсли;
  		
	ОбластьШапка.Параметры.Владелец = Владелец_.Наименование;
	ОбластьШапка.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если ОбластьШапка.Параметры.ВладелецАдрес = "" Тогда
	  ОбластьШапка.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ВладелецАдрес = "" Тогда
	  ОбластьШапка.Параметры.ВладелецАдрес =  киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	ОбластьШапка.Параметры.ВладелецТелефон = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если ОбластьШапка.Параметры.ВладелецТелефон = "" Тогда
	  ОбластьШапка.Параметры.ВладелецТелефон = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ВладелецТелефон = "" Тогда
	  ОбластьШапка.Параметры.ВладелецТелефон = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	ОбластьШапка.Параметры.ВладелецЕМэйл = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если ОбластьШапка.Параметры.ВладелецЕМэйл = "" Тогда
	  ОбластьШапка.Параметры.ВладелецЕМэйл = киПолучитьПредставлениеКИ(Владелец_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;

	Заказчик_ = ДокументОбъект.Заказчик;
	Попытка
	  Если ЗначениеЗаполнено(ДокументОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
		  Заказчик_ = ДокументОбъект._г_ДоверенноеЛицоЗаказчика;
	  КонецЕсли;			  
	Исключение
	КонецПопытки;
	Если обЗначениеНеЗаполнено(Заказчик_) Тогда
	  Сообщить("Поле Заказчик не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;	  	
	ОбластьШапка.Параметры.Заказчик = Заказчик_.Наименование;
	ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	Если ОбластьШапка.Параметры.ЗаказчикАдрес = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ЗаказчикАдрес = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикАдрес =  киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	КонецЕсли;
	ОбластьШапка.Параметры.ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если ОбластьШапка.Параметры.ЗаказчикТелефон = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	КонецЕсли;
	Если ОбластьШапка.Параметры.ЗаказчикТелефон = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикТелефон = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	КонецЕсли;
	ОбластьШапка.Параметры.ЗаказчикЕМэйл = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
	Если ОбластьШапка.Параметры.ЗаказчикЕМэйл = "" Тогда
	  ОбластьШапка.Параметры.ЗаказчикЕМэйл = киПолучитьПредставлениеКИ(Заказчик_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
	КонецЕсли;
	
	//Если Не ДокументОбъект.ВидРемонта.ГарантияЗавода Тогда
		Контрагент_ = ДокументОбъект.Контрагент;
		ОбластьШапка.Параметры.Контрагент = Контрагент_.Наименование;
		ОбластьШапка.Параметры.КонтрагентАдрес =  киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
		Если ОбластьШапка.Параметры.КонтрагентАдрес = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентАдрес =  киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресФактический);
		КонецЕсли;
		Если ОбластьШапка.Параметры.КонтрагентАдрес = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентАдрес =  киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
		КонецЕсли;
		ОбластьШапка.Параметры.КонтрагентТелефон = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
		Если ОбластьШапка.Параметры.КонтрагентТелефон = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентТелефон = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
		КонецЕсли;
		Если ОбластьШапка.Параметры.КонтрагентТелефон = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентТелефон = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
		КонецЕсли;
		ОбластьШапка.Параметры.КонтрагентЕМэйл = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий);
		Если ОбластьШапка.Параметры.КонтрагентЕМэйл = "" Тогда
		  ОбластьШапка.Параметры.КонтрагентЕМэйл = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний);
		КонецЕсли;
	//КонецЕсли;
	  
	ОбластьШапка.Параметры.Модель = Автомобиль_.Модель.Наименование;
	ДатаСоздания_ = КонецДня(ДокументОбъект.ДатаСоздания);
	ОбластьШапка.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль_, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаСоздания);
	ОбластьШапка.Параметры.ВИН = ДокументОбъект.Автомобиль.VIN;	
	ОбластьШапка.Параметры.НомерДвигателя = ДокументОбъект.Автомобиль.НомерДвигателя;	
	Пробег_ = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег, ДатаСоздания);
	ОбластьШапка.Параметры.Пробег = Формат(Пробег_, "ЧЦ=10");
	Если ОбластьШапка.Параметры.Пробег = "" Тогда
		ОбластьШапка.Параметры.Пробег = Формат(ДокументОбъект.Пробег, "ЧЦ=10");
	КонецЕсли;
	ОбластьШапка.Параметры.ГодВыпуска = Формат(Автомобиль_.ГодВыпуска, "ДФ=гггг");	  	  
	//ОбластьШапка.Параметры.Цвет = ДокументОбъект.Автомобиль.Цвет;	
	ОбластьШапка.Параметры.ДатаПродажи = Формат(Автомобиль_.ДатаНачалаГарантии,"ДЛФ=Д");

	ОбластьШапка.Параметры.ДатаСоздания = Формат(ДокументОбъект.ДатаСоздания,"ДЛФ=ДВ");
	ОбластьШапка.Параметры.ДатаОкончания = Формат(ДокументОбъект.ДатаОкончания,"ДЛФ=ДВ");
	ОбластьШапка.Параметры.Состояние = ДокументОбъект.Состояние;
	ОбластьШапка.Параметры.ВидРемонта = ДокументОбъект.ВидРемонта;	
	ОбластьШапка.Параметры.ПричинаОбращения = ДокументОбъект.ПричинаОбращения;
	ОбластьШапка.Параметры.ОписаниеДефектов = ДокументОбъект.ОписаниеДефекта;
	
	// попытаемся напечатать ШК
	ОбработкаОбъектШтрихКоды=Обработки.ШтрихКоды.Создать();
	ОбработкаОбъектШтрихКоды.Объект=ДокументОбъект;
	ОбработкаОбъектШтрихКоды.ПрочитатьЗаполнитьШтрихКоды();
	Если ОбработкаОбъектШтрихКоды.Состав.Количество()>0 Тогда
	  ШК=ОбработкаОбъектШтрихКоды.Состав[0].ШтрихКод;
	Иначе
	  ШК="";
	КонецЕсли; 
	Попытка
	  Если ПустаяСтрока(ШК) Тогда
		  ОбластьШапка.Рисунки.Удалить(ОбластьШапка.Рисунки.ШК);
	  Иначе
		  ПрефиксВесовогоШК=Константы.ПрефиксВесовогоШК.Получить();
		  ОбластьШапка.Рисунки.ШК.Объект.ТипКода=Число(НЕ (СтрДлина(ШК)=8 И Число(Лев(ШК,2))<>ПрефиксВесовогоШК));
		  ДлинаШК=?(ОбластьШапка.Рисунки.ШК.Объект.ТипКода=0,8,13);
		  ШК=ШК+"0000000000000"; ШК=Лев(ШК,ДлинаШК-1+ОбластьШапка.Рисунки.ШК.Объект.СодержитКС);
		  ОбластьШапка.Рисунки.ШК.Объект.Сообщение=ШК;
	  КонецЕсли;
	Исключение
	КонецПопытки;
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	КолонкаКода = дкПолучитьПараметрыРежимаВыводаКодаВДокументах(,Права);
	ФорматВыводаСуммы      = обПраво("ФорматВыводаСуммы", Права);
	ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества", Права);
	
	// Работы
	ОбластьУслуги = Макет.ПолучитьОбласть("Услуги");
	ОбластьШапкаУслуг = ОбластьУслуги.ПолучитьОбласть("ШапкаУслуг");
	ОбластьСтрокаУслуг		        = Макет.ПолучитьОбласть("СтрокаРабот");
	ОбластьИтоговПоСтраницеУслуги	= Макет.ПолучитьОбласть("ИтогиПоСтраницеРабот");
	ОбластьПодвалУслуг		        = Макет.ПолучитьОбласть("ПодвалУслуги");
	
	КоличествоРабот = ДокументОбъект.Работы.Количество();
	ИтогоКоличествоРабот  = 0;
	ИтогоКоэффициент = 0;
	ИтогоСуммаНДС = 0;
	ИтогоСуммаРабот = 0;
	Если КоличествоРабот > 0 Тогда
		//Вывод шапки табличной части работ(услуг)
		ОбластьУслуги.Параметры.ИмяКолонкиКодов = КолонкаКода.Синоним;
		ТабДокумент.Вывести(ОбластьУслуги);

		НомерСтраницы = 2;
		НомерСтраницыПред = 2;
		ТекстЗаголовка = "Работы по заказ-наряду №  " + ДокументОбъект.Номер + " от " + Формат(ДокументОбъект.Дата, "ДФ=дд.ММ.гггг");

		//заполним параметры шапки таблицы для следующего листа
		ОбластьШапкаУслуг.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 

		//Вывод табличной части работ
		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалУслуг);		  	  
		Ном	= 0;
		Для Каждого СтрокаРабот Из ДокументОбъект.Работы Цикл
			Ном = Ном + 1;
			ОбластьСтрокаУслуг.Параметры.НомСтр = Ном;
			ОбластьСтрокаУслуг.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаРабот.Работа, ИмяРеквизитаКода, Права);
			ОбластьСтрокаУслуг.Параметры.Наименование = СтрокаРабот.Работа.НаименованиеПолное;
			ОбластьСтрокаУслуг.Параметры.Количество = Формат(СтрокаРабот.Количество, ФорматВыводаКоличества);
			ОбластьСтрокаУслуг.Параметры.Коэффициент = Формат(СтрокаРабот.Коэффициент, "ЧЦ=10; ЧДЦ=3");
			ОбластьСтрокаУслуг.Параметры.Цена = Формат(СтрокаРабот.Цена, ФорматВыводаСуммы);
			ОбластьСтрокаУслуг.Параметры.ПроцентСкидки = Формат(СтрокаРабот.ПроцентСкидки, "ЧЦ=8");
			ОбластьСтрокаУслуг.Параметры.СуммаНДС = Формат(СтрокаРабот.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаУслуг.Параметры.СуммаБезНДС = Формат(СтрокаРабот.СуммаВсего - СтрокаРабот.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаУслуг.Параметры.Сумма = Формат(СтрокаРабот.СуммаВсего, ФорматВыводаСуммы);
			
			СтрокаИсполнитель = ДокументОбъект.Исполнители.Найти(СтрокаРабот.ИдентификаторРаботы, "ИдентификаторРаботы");
			Если СтрокаИсполнитель <> Неопределено Тогда
				ОбластьСтрокаУслуг.Параметры.Исполнитель = ФИО2(СтрокаИсполнитель.Исполнитель.Наименование);
			КонецЕсли;

			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаУслуг, ОбластьШапкаУслуг, ОбластьИтоговПоСтраницеУслуги, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоРабот, МассивОбластиПодвала, Неопределено));

			// Обновим итоги по документу
			ИтогоКоличествоРабот  = ИтогоКоличествоРабот + СтрокаРабот.Количество;
			ИтогоКоэффициент  = ИтогоКоэффициент + СтрокаРабот.Коэффициент;
			ИтогоСуммаРабот = ИтогоСуммаРабот + СтрокаРабот.СуммаВсего;
			ИтогоСуммаНДС = ИтогоСуммаНДС + СтрокаРабот.СуммаНДС;

			//инициализация итогов по странице
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
				НомерСтраницыПред = НомерСтраницы;
				ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
			КонецЕсли;

			//обновим итоги по странице
			дкДобавитьИтогиПоСтранице(СтрокаРабот, СтруктураИтоговПоСтранице);
		КонецЦикла; 

		//довыводим последний итог по странице, если страниц больше единицы
		Если НомерСтраницы > 2 Тогда
		  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтоговПоСтраницеУслуги, СтруктураИтоговПоСтранице, Права);
		КонецЕсли;

		//Вывод подвала табличной части услуг
		ОбластьПодвалУслуг.Параметры.ИтогоКоличествоРабот = Формат(ИтогоКоличествоРабот, ФорматВыводаКоличества);
		ОбластьПодвалУслуг.Параметры.ИтогоКоэффициент = Формат(ИтогоКоэффициент, "ЧЦ=10; ЧДЦ=3");
		ОбластьПодвалУслуг.Параметры.ИтогоСуммаНДС = Формат(ИтогоСуммаНДС, ФорматВыводаСуммы);
		ОбластьПодвалУслуг.Параметры.ИтогоСуммаБезНДС = Формат(ИтогоСуммаРабот - ИтогоСуммаНДС, ФорматВыводаСуммы);
		ОбластьПодвалУслуг.Параметры.СуммаВсего = Формат(ИтогоСуммаРабот, ФорматВыводаСуммы);
		ОбластьПодвалУслуг.Параметры.Номер = ОбластьШапка.Параметры.Номер;
		ОбластьПодвалУслуг.Параметры.ЗаказНарядДата = ОбластьШапка.Параметры.ЗаказНарядДата;

		//ОбластьПодвалУслуг.Параметры.ЧислоПрописью = обЧислоПрописью(ИтогоСуммаРабот, ВалютаПечатногоДокумента);
		НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьПодвалУслуг, , , НомерСтраницы, , Права);
	КонецЕсли;
	
	// Товары
	ОбластьДетали = Макет.ПолучитьОбласть("Детали");
	ОбластьШапкаДеталей = ОбластьДетали.ПолучитьОбласть("ШапкаДеталей");
	ОбластьСтрокаДеталей	        = Макет.ПолучитьОбласть("СтрокаДеталей");
	ОбластьИтоговПоСтраницеДетали	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталей");
	ОбластьПодвалДеталей	        = Макет.ПолучитьОбласть("ПодвалДетали");
	
	ИтогоКоличествоТоваров  = 0;
	ИтогоСуммаНДС = 0;
	ИтогоСуммаТоваров = 0;
	КоличествоТоваров = ДокументОбъект.Товары.Количество(); 
	Если КоличествоТоваров > 0 Тогда 
		
		//Иванченко 20260429 ++  
		Если Не ДокументОбъект.ВидРемонта.ГарантияЗавода И Не (ДокументОбъект.ВидРемонта = Справочники.ВидыРемонта.КузовнойКоммерческий ИЛИ ДокументОбъект.ВидРемонта = Справочники.ВидыРемонта.КузовнойРемонт) Тогда
			ОбщийМодуль_ИванченкоИлья.МодифицироватьТЧ(ОбластьДетали, ОбластьСтрокаДеталей, 2, "2");
