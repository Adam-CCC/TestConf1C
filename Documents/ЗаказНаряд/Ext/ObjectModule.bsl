	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик = Заказчик.Наименование;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.МессенджерЗаказчика = "Email";
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Исполнитель = ЭтотОбъект.Диспетчер;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.Заказчик    = ЭтотОбъект.Заказчик;
	Стр2ОбластьДанныеЗаказНаряда1.Параметры.ДатаВРаботе = ДатаНачала;
	ТабДокумент.Вывести(Стр2ОбластьДанныеЗаказНаряда1);
	
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	Возврат ТабДокумент;
	
КонецФункции //ПечатьПредварительныйЗаказНарядCHANGAN

Функция ПечатьКартаИнспекционногоСервисаCHANGAN(ТабДокумент) Экспорт
	
	Автомобиль = Автомобиль;
	Макет = ПолучитьМакет("КартаИнспекционногоСервисаCHANGAN"); 
	ОбластьДокумент = Макет.ПолучитьОбласть("ПечатьЛист");
	 
	НаименованиеДЦ = ЭтотОбъект.ПодразделениеКомпании.Организация;
		
	ОбластьДокумент.Параметры.НаименованиеДЦ = НаименованиеДЦ; 
	ОбластьДокумент.Параметры.Модель = Автомобиль.Модель;
	ОбластьДокумент.Параметры.НомерДокумента = ЭтотОбъект.Номер;
	ОбластьДокумент.Параметры.VIN = Автомобиль.VIN;
	ОбластьДокумент.Параметры.ДатаДокумента = Формат(ЭтотОбъект.Дата, "ДФ=дд.ММ.гггг");
    ОбластьДокумент.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ЭтотОбъект.ДатаСоздания);
	ОбластьДокумент.Параметры.Пробег = ЭтотОбъект.Пробег;
	ОбластьДокумент.Параметры.Мастер = ЭтотОбъект.Мастер;
	ТабДокумент.Вывести(ОбластьДокумент);	
	Возврат ТабДокумент;
КонецФункции //КартаИнспекционногоСервисаCHANGAN

Функция ПечатьСОПДChangan(ТабДокумент) Экспорт
	Макет = ПолучитьМакет("СОПД_CHANGAN");
	ОбластьМакета = Макет.ПолучитьОбласть("Лист");
	ОбластьМакета.Параметры.Клиент = Заказчик;
	Подразделение = ПодразделениеКомпании;
	ПодтверждающийДокументКлиента = спПолучитьПодтверждающийДокументОбъектаПоВиду(Заказчик, Перечисления.ВидыДокументов.Паспорт);
	
	Если ЗначениеЗаполнено(ПодтверждающийДокументКлиента) Тогда
		ОбластьМакета.Параметры.ДокументКлиент = Строка(ПодтверждающийДокументКлиента.ВидПодтверждающегоДокумента) + " серия " + ПодтверждающийДокументКлиента.Серия	+ " № " + ПодтверждающийДокументКлиента.Номер + " выдан " + ПодтверждающийДокументКлиента.КемВыдан + " " + Строка(Формат(ПодтверждающийДокументКлиента.ДатаВыдачи,"ДФ=dd.MM.yyyy"));	
	КонецЕсли;
	ОбластьМакета.Параметры.КлиентАдрес = киПолучитьПредставлениеКИ(Заказчик, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	
	Если ЗначениеЗаполнено(_г_ДоверенноеЛицоЗаказчика) Тогда                                                                          
		ПодтверждающийДокументДоверителя = спПолучитьПодтверждающийДокументОбъектаПоВиду(_г_ДоверенноеЛицоЗаказчика, Перечисления.ВидыДокументов.Паспорт);
		ОбластьМакета.Параметры.Представитель = _г_ДоверенноеЛицоЗаказчика;
		Если ЗначениеЗаполнено(ПодтверждающийДокументДоверителя) Тогда
			ОбластьМакета.Параметры.ДокументПредставитель = Строка(ПодтверждающийДокументДоверителя.ВидПодтверждающегоДокумента) + " серия " + ПодтверждающийДокументДоверителя.Серия	+ " № " + ПодтверждающийДокументДоверителя.Номер + " выдан " + ПодтверждающийДокументДоверителя.КемВыдан + " " + Строка(Формат(ПодтверждающийДокументДоверителя.ДатаВыдачи,"ДФ=dd.MM.yyyy"));
		КонецЕсли;
		ОбластьМакета.Параметры.ПредставительАдрес = киПолучитьПредставлениеКИ(_г_ДоверенноеЛицоЗаказчика, Справочники.ВидыКонтактнойИнформации.АдресФактический); 
		ОбластьМакета.Параметры.Доверенность = _г_ДоверенностьЗаказчика;	
	КонецЕсли;
	ОбластьМакета.Параметры.Дилер = Подразделение.Наименование + ", " + Организация.ИНН + "\" + Подразделение.КПП;
	
	ОбластьМакета.Параметры.Дата = Формат(ДатаСоздания, "ДФ=dd.MM.yyyy");
	Если ЗначениеЗаполнено(_г_ДоверенноеЛицоЗаказчика) Тогда 
		ОбластьМакета.Параметры.ФИО = _г_ДоверенноеЛицоЗаказчика;				
	Иначе
		ОбластьМакета.Параметры.ФИО = Заказчик;
	КонецЕсли;
	ТабДокумент.Вывести(ОбластьМакета);	
	Возврат ТабДокумент;
КонецФункции //ПечатьСОПДChangan
