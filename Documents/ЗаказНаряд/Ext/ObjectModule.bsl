Функция НайтиЦех(Подразделение)
	
	НайденныйЦех = Справочники.Цеха.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Цеха.Ссылка,
		|	Цеха.Подразделение,
		|	Цеха.ПометкаУдаления,
		|	Цеха.ДляПерепродаж КАК ДляПерепродаж
		|ИЗ
		|	Справочник.Цеха КАК Цеха
		|ГДЕ
		|	НЕ Цеха.ПометкаУдаления
		|	И Цеха.Подразделение = &Подразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДляПерепродаж УБЫВ";
	
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НайденныйЦех = ВыборкаДетальныеЗаписи.Ссылка;
		Прервать;
	КонецЦикла;
	
	Возврат НайденныйЦех;
 
КонецФункции // НайтиЦех(Подразделение)
