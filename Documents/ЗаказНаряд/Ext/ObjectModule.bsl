		//Бондаренко++ 20230531
		Отказ = СМ_ФормированиеНовыхОбъектов.СМГ_ОтменаПроведенияАктОказанияУслугСубподряд(Ссылка);
  		//Бондаренко-- 20230531
	КонецЕсли; 	
