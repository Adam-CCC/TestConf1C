	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	
	Автомобиль = ДокументОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	ОбластьШапка.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер, ДатаМашинозаезда);
