	  ОбластьМакета.Параметры.КонтрагентПолноеНаименование = спПолучитьНаименование(Контрагент_);
	  // ИНН и КПП для юр. лиц
	  Если Контрагент_.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
		  ОбластьМакета.Параметры.КонтрагентИНН = "ИНН " + Контрагент_.ИНН + " КПП " + Контрагент_.КПП;
	  ИначеЕсли Контрагент_.ФормаСобственности = Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
		  ОбластьМакета.Параметры.КонтрагентИНН = "ИНН " + Контрагент_.ИНН;
	  КонецЕсли;
	  ОбластьМакета.Параметры.КонтрагентАдресЮридический = киПолучитьПредставлениеКИ(Контрагент_, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	  ОбластьМакета.Параметры.КонтрагентТелефоны = киПолучитьПредставлениеКИ(Контрагент_, Перечисления.ТипыКонтактнойИнформации.Телефон);
	  
	  ОбластьМакета.Параметры.НачГарантии = Формат(ЭтотОбъект.Автомобиль.ДатаНачалаГарантии,"ДФ=dd.MM.yyyy");
	  ОбластьМакета.Параметры.Оператор   =  спПолучитьНаименование(ЭтотОбъект.Оператор);
	  
	  Попытка
		  // Доверенное лицо Заказчика
		  ОбластьМакета.Параметры.ДовЛицо = ЭтотОбъект._г_ДоверенноеЛицоЗаказчика;
		  ОбластьМакета.Параметры.ДоверенноеЛицо = спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоЗаказчикаДолжность) + " " + спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика);
		  ОбластьМакета.Параметры.ДоверенноеЛицоАдресПочтовый = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика, Перечисления.ТипыКонтактнойИнформации.Адрес);
		  ОбластьМакета.Параметры.ДоверенноеЛицоТелефоны = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика, Перечисления.ТипыКонтактнойИнформации.Телефон);	
		  Доверенность = ЭтотОбъект._г_ДоверенностьЗаказчика;
		  ДоверенностьНомер = Доверенность.Номер;
		  ДоверенностьДата = Формат(Доверенность.ДатаВыдачи,"ДЛФ=D");
		  ОбластьМакета.Параметры.НомерДоверенности = ДоверенностьНомер;
		  ОбластьМакета.Параметры.ДатаДоверенности = ДоверенностьДата;
		  
		  // Доверенное лицо Плательщика
		  ОбластьМакета.Параметры.ДовЛицо1 = ЭтотОбъект._г_ДоверенноеЛицоПлательщика;
		  ОбластьМакета.Параметры.ДоверенноеЛицо1 = спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоПлательщикаДолжность) + " " + спПолучитьНаименование(ЭтотОбъект._г_ДоверенноеЛицоПлательщика);
		  ОбластьМакета.Параметры.ДоверенноеЛицоАдресПочтовый1 = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоПлательщика, Перечисления.ТипыКонтактнойИнформации.Адрес);
		  ОбластьМакета.Параметры.ДоверенноеЛицоТелефоны1 = киПолучитьПредставлениеКИ(ЭтотОбъект._г_ДоверенноеЛицоПлательщика, Перечисления.ТипыКонтактнойИнформации.Телефон);	
		  Доверенность1 = ЭтотОбъект._г_ДоверенностьПлательщика;
		  ДоверенностьНомер1 = Доверенность1.Номер;
		  ДоверенностьДата1 = Формат(Доверенность1.ДатаВыдачи,"ДЛФ=D");
		  ОбластьМакета.Параметры.НомерДоверенности1 = ДоверенностьНомер1;
		  ОбластьМакета.Параметры.ДатаДоверенности1 = ДоверенностьДата1;
	  Исключение
	  КонецПопытки;
	  
	  Если НЕ обЗначениеНеЗаполнено(ЭтотОбъект.Автомобиль) Тогда
		  ОбластьМакета.Параметры.АвтомобильГосНомер =  Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЭтотОбъект.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,ЭтотОбъект.ДатаСоздания);
		  
		  ОбластьМакета.Параметры.АвтомобильПробег = Формат(ЭтотОбъект.Пробег,"ЧЦ=10");
		  
		  ОбластьМакета.Параметры.Двигатель = ЭтотОбъект.Автомобиль.НомерДвигателя;
		  //ОбластьМакета.Параметры.НачГарантии   = Формат(ЭтотОбъект.Автомобиль.ДатаНачалаГарантии,"ДФ=dd.MM.yyyy");
		  ОбластьМакета.Параметры.Кузов = ЭтотОбъект.Автомобиль.НомерКузова;
		  ОбластьМакета.Параметры.Шасси = ЭтотОбъект.Автомобиль.НомерШасси;
		  ОбластьМакета.Параметры.Цвет = ЭтотОбъект.Автомобиль.Цвет;
		  
		  ОбластьМакета.Параметры.ТехПаспорт = СокрЛП(Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЭтотОбъект.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ТехПаспорт,ЭтотОбъект.ДатаСоздания));
		  //ОбластьМакета.Параметры.НачалоРабот = Формат(ЭтотОбъект.ДатаНачала,"ДФ=dd.MM.yy");
		  //ОбластьМакета.Параметры.РаботыОкончены = ЭтотОбъект.ДатаОкончания;	  
		  //ОбластьМакета.Параметры.Проведен = ЭтотОбъект.ДатаЗакрытия;		  
	  КонецЕсли;
	  //ОбластьМакета.Параметры.Автомобиль = ЭтотОбъект.Автомобиль;
	  ОбластьМакета.Параметры.АвтомобильКод = ЭтотОбъект.Автомобиль.VIN;
	  ОбластьМакета.Параметры.АвтомобильМодель = ЭтотОбъект.Автомобиль.Модель;
	  ОбластьМакета.Параметры.АвтомобильГодВыпуска = Формат(ЭтотОбъект.Автомобиль.ГодВыпуска,ФорматПредставленияГодаВыпускаАвтомобиля);
	  
	  ОбластьМакета.Рисунки.Принят.Параметр = "Принят:
	  |" + Формат(ЭтотОбъект.ДатаСоздания, "ДЛФ=DT");
	  ОбластьМакета.Рисунки.ВидРемонта.Параметр = "Вид ремонта:
	  |" + ЭтотОбъект.ВидРемонта.Наименование;
	  ОбластьМакета.Рисунки.ВидРемонта.Расшифровка = ЭтотОбъект.ВидРемонта;
	  ОбластьМакета.Рисунки.Мастер.Параметр = "Мастер-приемщик:
	  |" + ЭтотОбъект.Диспетчер.Наименование;
	  ОбластьМакета.Рисунки.Мастер.Расшифровка = ЭтотОбъект.Диспетчер;
	  ОбластьМакета.Рисунки.Состояние.Параметр = ЭтотОбъект.Состояние;
	  ОбластьМакета.Рисунки.РаботыНач.Параметр = "Работы начаты:
	  |" + Формат(ЭтотОбъект.ДатаНачала, "ДФ = дд.ММ.гггг");
	  ОбластьМакета.Рисунки.КонРаботы.Параметр = "Готов:
	  |" + Формат(ЭтотОбъект.ДатаОкончания, "ДФ = дд.ММ.гггг");
	  ОбластьМакета.Рисунки.Проведен.Параметр = "Выдача а/м:
	  |" + Формат(ЭтотОбъект.ДатаЗакрытия, "ДЛФ=DT");
	  
	  ОбластьМакета.Параметры.Валюта = ВалютаПечатногоДокумента;
	  
	  // попытаемся напечатать ШК Компонентой Печати Штрихкодов
	  ОбработкаОбъектШтрихКоды=Обработки.ШтрихКоды.Создать();
	  ОбработкаОбъектШтрихКоды.Объект = ЭтотОбъект;
	  ОбработкаОбъектШтрихКоды.ПрочитатьЗаполнитьШтрихКоды();
	  Если ОбработкаОбъектШтрихКоды.Состав.Количество() > 0 Тогда
		  ШтрихКод = ОбработкаОбъектШтрихКоды.Состав[0].ШтрихКод;
	  Иначе
		  ШтрихКод = "";
	  КонецЕсли; 
	  Если ПустаяСтрока(ШтрихКод) Тогда
		  ОбластьМакета.Рисунки.Удалить(ОбластьМакета.Рисунки.ШК);
	  Иначе			
		  СМ_ФормированиеНовыхОбъектов.ВывестиКартинкуШтрихКода(ОбластьМакета.Рисунки.ШК, ШтрихКод);
	  КонецЕсли;
	  
	  ТабДокумент.Вывести(ОбластьМакета);
	  
	  // Вывод причины
	  ОбластьМакета = Макет.ПолучитьОбласть("Причина");
	  ОбластьМакета.Параметры.Заголовок = "Причина обращения:";
	  Если ПустаяСтрока(ЭтотОбъект.ПричинаОбращения) Тогда
		  ТекОбласть = ОбластьМакета.Область(2, , 2, );
		  ТекОбласть.АвтовысотаСтроки = Ложь;
		  ТекОбласть.ВысотаСтроки = 22;
	  Иначе
		  ОбластьМакета.Параметры.ПричинаОбращения = ЭтотОбъект.ПричинаОбращения;	  
	  КонецЕсли;
	  НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьМакета, , , НомерСтраницы, , Права);
	  
	  // Вывод реквизитов страхового ремонта
	  Попытка
		  Если Не ПустаяСтрока(ЭтотОбъект.НомерНаправленияСК) Тогда
			  ОбластьМакета = Макет.ПолучитьОбласть("Причина");
			  ОбластьМакета.Параметры.Заголовок = "Реквизиты страхового ремонта:";
			  РеквизитыСР = "Направление СК № " + ЭтотОбъект.НомерНаправленияСК + " от " + Формат(ЭтотОбъект.ДатаНаправленияСК, "ДЛФ=ДД");
			  РеквизитыСР = РеквизитыСР + "; " + Строка(ЭтотОбъект.ПроцентИзноса) + "% износа; ";
			  РеквизитыСР = РеквизитыСР + "Сумма франшизы: " + Строка(ЭтотОбъект.СуммаФраншизы) + " руб; ";
			  РеквизитыСР = РеквизитыСР + "Лимит ремонта: " + Строка(ЭтотОбъект.ЛимитРемонта) + " руб;";
			  ОбластьМакета.Параметры.ПричинаОбращения = РеквизитыСР;	  
			  НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьМакета, , , НомерСтраницы, , Права);
		  КонецЕсли;
	  Исключение
	  КонецПопытки;
	  
	  КолонкаКода=дкПолучитьПараметрыРежимаВыводаКодаВДокументах(,Права);
	  
	  // ============ Вывод работ основных ============ 
	  Табл = ТаблицаРабот.Скопировать();
	  КоличествоРабот = Табл.Количество();
	  
	  // инициализация итогов по документу
	  ИтогоСуммаРабот		= 0;
	  ИтогоСуммаНДСРабот	= 0;
	  
	  Если КоличествоРабот = 0 Тогда
		  //не выводим
	  ИначеЕсли  КоличествоРаботОсновных тогда
		  
		  //Вывод шапки табличной части работ(услуг)
		  ОбластьУслуги.Параметры.НомерДок = НомерДляПечати;
		  ОбластьУслуги.Параметры.ДатаДок = Формат(ЭтотОбъект.Дата, "ДФ=дд.ММ.гггг");
		  ОбластьУслуги.Параметры.ИмяКолонкиКодов = КолонкаКода.Синоним;
		  ТабДокумент.Вывести(ОбластьУслуги);
		  
		  НомерСтраницы = 2;
		  НомерСтраницыПред = 2;
		  ТекстЗаголовка = "Выполненные работы по заказ-наряду №  "+НомерДляПечати+" от "+Формат(ЭтотОбъект.Дата, "ДФ=дд.ММ.гггг");
		  
		  //заполним параметры шапки таблицы для следующего листа
		  ОбластьШапкаУслуг.Параметры.ТекстЗаголовка = ТекстЗаголовка;
		  ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
		  ОбластьШапкаУслуг.Параметры.ИмяКолонкиКодов = КолонкаКода.Синоним;
		  
		  //Вывод табличной части работ
		  Ном	= 0;
		  СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаНДС, СуммаСкидки, Количество", 0, 0, 0, 0);
		  
		  МассивОбластиПодвала = Новый Массив;
		  МассивОбластиПодвала.Добавить(ОбластьПодвалУслуг);
		  
		  Для каждого СтрокаРабот Из Табл Цикл
			  Попытка
				  Если НЕ СтрокаРабот.Основная тогда
					  Продолжить;
				  КонецЕсли;
			  Исключение
			  КонецПопытки;
			  
			  Ном = Ном + 1;
			  ОбластьСтрокаУслуг.Параметры.НомСтр = Ном;
			  ОбластьСтрокаУслуг.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаРабот.Работа,ИмяРеквизитаКода,Права);
			  ОбластьСтрокаУслуг.Параметры.Номенклатура = СтрокаРабот.Работа;      
			  // Холышевская ++ 21.04.2026
			  Если НЕ обЗначениеНеЗаполнено(СтрокаРабот.Работа.НаименованиеПолное) Тогда
				  ОбластьСтрокаУслуг.Параметры.Наименование = СтрокаРабот.Работа.НаименованиеПолное;  
			  Иначе
				  ОбластьСтрокаУслуг.Параметры.Наименование = СтрокаРабот.Работа.Наименование;
			  КонецЕсли;
			  // Холышевская -- 21.04.2026			  
			  //ОбластьСтрокаУслуг.Параметры.Цена = Формат(СтрокаРабот.Цена, "ЧЦ=15; ЧДЦ=2");
			  Если ЕстьСкидкаПоРаботам Тогда
				  ОбластьСтрокаУслуг.Параметры.Скидка = Формат(СтрокаРабот.СуммаСкидки, ФорматВыводаСуммы);
			  КонецЕсли;
			  Если ЭтоАвтопарк Тогда
				  ОбластьСтрокаУслуг.Параметры.Коэффициент = Формат(СтрокаРабот.Коэффициент, "ЧЦ=10; ЧДЦ=3");
			  КонецЕсли;
			  ОбластьСтрокаУслуг.Параметры.Количество = Формат(СтрокаРабот.Количество, ФорматВыводаКоличества);
			  //ОбластьСтрокаУслуг.Параметры.Единица = СтрокаРабот.Нормочас;
			  ОбластьСтрокаУслуг.Параметры.Сумма = Формат(СтрокаРабот.СуммаВсего, ФорматВыводаСуммы);
			  //ОбластьСтрокаУслуг.Параметры.НДС = Формат(СтрокаРабот.СуммаНДС, ФорматВыводаСуммы);
			  
			  НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаУслуг, ОбластьШапкаУслуг, ОбластьИтоговПоСтраницеУслуги, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоРабот, МассивОбластиПодвала, Неопределено));
			  
			  // Обновим итоги по документу
			  ИтогоКоличествоРабот  = ИтогоКоличествоРабот + СтрокаРабот.Количество;
			  ИтогоСуммаРабот       = ИтогоСуммаРабот + СтрокаРабот.СуммаВсего;
			  ИтогоСуммаНДСРабот    = ИтогоСуммаНДСРабот + СтрокаРабот.СуммаНДС;
			  ИтогоСуммаСкидкиРабот = ИтогоСуммаСкидкиРабот + СтрокаРабот.СуммаСкидки;
			  
			  //инициализация итогов по странице
			  Если НомерСтраницы <> НомерСтраницыПред Тогда
				  СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаНДС, СуммаСкидки, Количество", 0, 0, 0, 0);
				  НомерСтраницыПред = НомерСтраницы;
				  ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
			  КонецЕсли;
			  
			  //обновим итоги по странице
			  дкДобавитьИтогиПоСтранице(СтрокаРабот, СтруктураИтоговПоСтранице);
		  КонецЦикла; 
		  
		  //довыводим последний итог по странице, если страниц больше единицы
		  Если НомерСтраницы > 2 Тогда
			  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтоговПоСтраницеУслуги, СтруктураИтоговПоСтранице, Права);
		  КонецЕсли;
		  
		  //Вывод подвала табличной части услуг
		  ОбластьПодвалУслуг.Параметры.Количество = Формат(ИтогоКоличествоРабот, ФорматВыводаКоличества);
		  ОбластьПодвалУслуг.Параметры.Сумма = Формат(ИтогоСуммаРабот, ФорматВыводаСуммы);
		  //ОбластьПодвалУслуг.Параметры.НДС = Формат(ИтогоСуммаНДСРабот, ФорматВыводаСуммы);
		  Если ЕстьСкидкаПоРаботам Тогда
			  ОбластьПодвалУслуг.Параметры.Скидка = Формат(ИтогоСуммаСкидкиРабот, ФорматВыводаСуммы);
		  КонецЕсли;
		  
		  ОбластьПодвалУслуг.Параметры.ЧислоПрописью = обЧислоПрописью(ИтогоСуммаРабот, ВалютаПечатногоДокумента);
		  Если ИтогоСуммаНДСРабот <> 0 Тогда
