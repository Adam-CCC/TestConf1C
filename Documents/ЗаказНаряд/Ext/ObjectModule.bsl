Процедура СМГ_ЗаполнитьОстаткамиРегистровМодуль() Экспорт
	
	СотрудникСеанса = ПараметрыСеанса.Пользователь.Сотрудник;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Автомобиль,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Работа,
		|	1 КАК Количество,
		|	СУММА(СМГ_КомплектацияАвтомобилейАвтоработыОстатки.КоличествоОстаток) КАК Коэффициент,
		|	СУММА(СМГ_КомплектацияАвтомобилейАвтоработыОстатки.СуммаУпрОстаток) КАК Сумма,
		|	СУММА(СМГ_КомплектацияАвтомобилейАвтоработыОстатки.СуммаУпрОстаток) КАК СуммаВсего,
		|	СУММА(СМГ_КомплектацияАвтомобилейАвтоработыОстатки.СуммаУпрОстаток) / 6 КАК СуммаНДС,
		|	ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ОсновнаяСтавкаНДС) КАК СтавкаНДС,
		|	ЗНАЧЕНИЕ(Справочник.Нормочасы.Рубль) КАК Нормочас,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.СуммаУпрОстаток / СМГ_КомплектацияАвтомобилейАвтоработыОстатки.КоличествоОстаток КАК Цена,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Организация.КонтрагентОрганизации КАК Контрагент
		|ИЗ
		|	РегистрНакопления.СМГ_КомплектацияАвтомобилейАвтоработы.Остатки(&МоментВремени, ) КАК СМГ_КомплектацияАвтомобилейАвтоработыОстатки
		|ГДЕ
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Автомобиль = &Автомобиль
		|
		|СГРУППИРОВАТЬ ПО
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Автомобиль,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Работа,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.СуммаУпрОстаток / СМГ_КомплектацияАвтомобилейАвтоработыОстатки.КоличествоОстаток,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Организация.КонтрагентОрганизации";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	//Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МоментВремени",?(обЗначениеНеЗаполнено(Ссылка.Дата),КонецДня(ТекущаяДата()),Ссылка.Дата));
	
 	Попытка	Работы.Загрузить(Запрос.Выполнить().Выгрузить()); Исключение КонецПопытки;
	
	Для каждого ТекСтрока Из Работы Цикл
		ТекСтрока.ИдентификаторРаботы = Новый УникальныйИдентификатор;
		ТекСтрока.КтоВнес = СотрудникСеанса;
		Если ТекСтрока.Контрагент = Организация.КонтрагентОрганизации Тогда
			ТекСтрока.Контрагент = "";
  		КонецЕсли;
	КонецЦикла; 
 	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	              |	КомплектацияАвтомобилей.Автомобиль,
	              |	КомплектацияАвтомобилей.СкладКомпании,
	              |	КомплектацияАвтомобилей.Номенклатура,
	              |	СУММА(КомплектацияАвтомобилей.КоличествоОстаток) КАК КоличествоОстаток,
 				  |	СУММА(КомплектацияАвтомобилей.СуммаПродажиУпрОстаток) / 6 КАК СуммаНДСОстаток,
	              |	КомплектацияАвтомобилей.СуммаПродажиУпрОстаток КАК СуммаУпрОстаток
	              |ИЗ
	              |	РегистрНакопления.КомплектацияАвтомобилей.Остатки(&МоментВремени, ) КАК КомплектацияАвтомобилей
	              |ГДЕ
	              |	КомплектацияАвтомобилей.Автомобиль = &Автомобиль
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	КомплектацияАвтомобилей.СкладКомпании,
	              |	КомплектацияАвтомобилей.Автомобиль,
	              |	КомплектацияАвтомобилей.Номенклатура,
	              |	КомплектацияАвтомобилей.СуммаПродажиУпрОстаток";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
 	Запрос.УстановитьПараметр("МоментВремени",?(обЗначениеНеЗаполнено(Ссылка.Дата),КонецДня(ТекущаяДата()),Ссылка.Дата));
	ТЗ = Запрос.Выполнить().Выгрузить();
	//ТЗ.ВыбратьСтроку(ТЗ.Количество());
	Если ТЗ.Количество() > 0 Тогда
 		Для каждого ТекСтрокаТовары Из ТЗ Цикл
			НовСтрокаТовары = Товары.Добавить();
			НовСтрокаТовары.Номенклатура    = ТекСтрокаТовары.Номенклатура;
			НовСтрокаТовары.СкладКомпании   = ТекСтрокаТовары.СкладКомпании;
			НовСтрокаТовары.ЕдиницаИзмерения = ТекСтрокаТовары.Номенклатура.ОсновнаяЕдиницаИзмерения;	
			// Холышевская ++ 07.05.2026  
			Если ТекСтрокаТовары.Номенклатура.ТипНоменклатуры = Справочники.ТипыНоменклатуры.НайтиПоКоду("ЦБ000096") Тогда
				НовСтрокаТовары.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоКоду("ЦБ287170");
			КонецЕсли; 
			// Холышевская -- 07.05.2026
			 
			//Бондаренко++ 20221001                                                                                                              
 			//НовСтрокаТовары.Количество      = ТекСтрокаТовары.КоличествоОстаток;
			//НовСтрокаТовары.Коэффициент     = 1;                                
			НовСтрокаТовары.Количество      = ?(НовСтрокаТовары.ЕдиницаИзмерения.Коэффициент>1,ТекСтрокаТовары.КоличествоОстаток/НовСтрокаТовары.ЕдиницаИзмерения.Коэффициент,ТекСтрокаТовары.КоличествоОстаток);
 			НовСтрокаТовары.Коэффициент     = ?(НовСтрокаТовары.ЕдиницаИзмерения.Коэффициент>1,НовСтрокаТовары.ЕдиницаИзмерения.Коэффициент,1);
			//Бондаренко-- 20221001

			НовСтрокаТовары.Сумма           = ТекСтрокаТовары.СуммаУпрОстаток;
			НовСтрокаТовары.СуммаВсего      = ТекСтрокаТовары.СуммаУпрОстаток;
			НовСтрокаТовары.СуммаНДС        = ТекСтрокаТовары.СуммаНДСОстаток;
			НовСтрокаТовары.СтавкаНДС       = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
			НовСтрокаТовары.КтоВнес			= СотрудникСеанса;
			Если НовСтрокаТовары.Количество > 0 Тогда
				НовСтрокаТовары.Цена        = НовСтрокаТовары.Сумма/(НовСтрокаТовары.Количество * НовСтрокаТовары.Коэффициент);			
			Иначе
				НовСтрокаТовары.Цена        = 1;			 			
			КонецЕсли;
		КонецЦикла;
 	КонецЕсли; 
 	
КонецПроцедуры //СМГ_ЗаполнитьОстаткамиРегистровМодуль

#Если Клиент Тогда 
