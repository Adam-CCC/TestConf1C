		СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
		МассивОбластиПодвала = Новый Массив;
		МассивОбластиПодвала.Добавить(ОбластьПодвалДеталей);		  	  
		Ном	= 0;
		Для каждого СтрокаТоваров Из ДокументОбъект.Товары Цикл
			Ном = Ном + 1;
			ОбластьСтрокаДеталей.Параметры.НомСтр = Ном;
			ОбластьСтрокаДеталей.Параметры.Код = дкПолучитьЗначениеКолонкиКода(СтрокаТоваров.Номенклатура, ИмяРеквизитаКода, Права);
			ОбластьСтрокаДеталей.Параметры.Наименование = СтрокаТоваров.Номенклатура.НаименованиеПолное;
			ОбластьСтрокаДеталей.Параметры.Количество = Формат(СтрокаТоваров.Количество, ФорматВыводаКоличества);
			ОбластьСтрокаДеталей.Параметры.ЕдИзм = СтрокаТоваров.ЕдиницаИзмерения;
			ОбластьСтрокаДеталей.Параметры.Цена = Формат(СтрокаТоваров.Цена, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.ПроцентСкидки = Формат(СтрокаТоваров.ПроцентСкидки, "ЧЦ=8");
			ОбластьСтрокаДеталей.Параметры.СуммаНДС = Формат(СтрокаТоваров.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.СуммаБезНДС = Формат(СтрокаТоваров.СуммаВсего - СтрокаТоваров.СуммаНДС, ФорматВыводаСуммы);
			ОбластьСтрокаДеталей.Параметры.Сумма = Формат(СтрокаТоваров.СуммаВсего, ФорматВыводаСуммы);

			НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрокаДеталей, ОбластьШапкаДеталей, ОбластьИтоговПоСтраницеДетали, НомерСтраницы, СтруктураИтоговПоСтранице,Права, ?(Ном=КоличествоТоваров, МассивОбластиПодвала, Неопределено));

			// Обновим итоги по документу
			ИтогоКоличествоТоваров  = ИтогоКоличествоТоваров + СтрокаТоваров.Количество;
			ИтогоСуммаНДС = ИтогоСуммаНДС + СтрокаТоваров.СуммаНДС;
			ИтогоСуммаТоваров = ИтогоСуммаТоваров + СтрокаТоваров.СуммаВсего;

			//инициализация итогов по странице
			Если НомерСтраницы <> НомерСтраницыПред Тогда
				СтруктураИтоговПоСтранице = Новый Структура("СуммаВсего, СуммаСкидки, Количество", 0, 0, 0);
				НомерСтраницыПред = НомерСтраницы;
				ОбластьШапкаУслуг.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
			КонецЕсли;

			//обновим итоги по странице
			дкДобавитьИтогиПоСтранице(СтрокаТоваров, СтруктураИтоговПоСтранице);
		КонецЦикла; 

		//довыводим последний итог по странице, если страниц больше единицы
		Если НомерСтраницы > 2 Тогда
		  дкВывестиИтогиПоСтранице(ТабДокумент, ОбластьИтоговПоСтраницеДетали, СтруктураИтоговПоСтранице, Права);
		КонецЕсли;

		//Вывод подвала табличной части товаров
		ОбластьПодвалДеталей.Параметры.ИтогоКоличествоТоваров = Формат(ИтогоКоличествоТоваров, ФорматВыводаКоличества);
		ОбластьПодвалДеталей.Параметры.ИтогоСуммаНДС = Формат(ИтогоСуммаНДС, ФорматВыводаСуммы);
		ОбластьПодвалДеталей.Параметры.ИтогоСуммаБезНДС = Формат(ИтогоСуммаТоваров - ИтогоСуммаНДС, ФорматВыводаСуммы);
		ОбластьПодвалДеталей.Параметры.СуммаВсего = Формат(ИтогоСуммаТоваров, ФорматВыводаСуммы);

		НомерСтраницы = дкВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьПодвалДеталей, , , НомерСтраницы, , Права);
	КонецЕсли;

	// Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");	
	Если ДокументОбъект.ВидРемонта.ГарантияЗавода Тогда
		СтрокаИтого = "Итого по договору-заказу-наряду 0,00 рублей (Ноль рублей 00 копеек). Гарантийный ремонт выполняется безвозмездно.";
	Иначе
		СтрокаИтого = "Итого по договору-заказу-наряду " + Формат(ИтогоСуммаРабот + ИтогоСуммаТоваров, ФорматВыводаСуммы) + " Руб ";
		ВалютаПечатногоДокумента = Справочники.Валюты.НайтиПоКоду("643");
		СтрокаИтого = СтрокаИтого + "(" + обЧислоПрописью(ИтогоСуммаРабот + ИтогоСуммаТоваров, ВалютаПечатногоДокумента) + ")";		
	КонецЕсли;
	ОбластьПодвал.Параметры.СтрокаИтого = СтрокаИтого;
	
	ЗапросТО = Новый Запрос();
	ЗапросТО.УстановитьПараметр("Автомобиль", Автомобиль);
	ЗапросТО.УстановитьПараметр("ПустойЗаказНаряд", Документы.ЗаказНаряд.ПустаяСсылка());
	ЗапросТО.Текст =
	"ВЫБРАТЬ
	|	ИсторияТехОбслуживания.НомерТО,
	|	ИсторияТехОбслуживания.ДатаТО
	|ИЗ
	|	РегистрСведений.ИсторияТехОбслуживания КАК ИсторияТехОбслуживания
	|ГДЕ
	|	ИсторияТехОбслуживания.Автомобиль = &Автомобиль
	|	И ИсторияТехОбслуживания.ЗаказНарядТО = &ПустойЗаказНаряд";
	
	РезультатТО = ЗапросТО.Выполнить().Выбрать();
	Если РезультатТО.Следующий() И РезультатТО.ДатаТО > ТекущаяДата() Тогда
		ИнтервалПробег = Автомобиль.Модель.МежсервисныйПробегТО;
		Если ИнтервалПробег = 0 Тогда
			ИнтервалПробег = 15000;
		КонецЕсли;
		ОбластьПодвал.Параметры.ПробегТО = ИнтервалПробег * РезультатТО.НомерТО;
		ОбластьПодвал.Параметры.ДатаТО = Формат(РезультатТО.ДатаТО, "ДЛФ=Д");
	Иначе
		ОбластьПодвал.Параметры.ПробегТО = "__________";
		ОбластьПодвал.Параметры.ДатаТО = "____.____.20____";
	КонецЕсли;
	
	ОбластьПодвал.Параметры.Рекомендации = ДокументОбъект.Рекомендации;
	ОбластьПодвал.Параметры.Заказчик = ФИО2(Заказчик_.Наименование);
	ОбластьПодвал.Параметры.Диспетчер = ФИО2(ДокументОбъект.Диспетчер.Наименование);
	ОбластьПодвал.Параметры.Мастер = ФИО2(ДокументОбъект.Мастер.Наименование);
	ДатаРаспечатки_ = ?(ЗначениеЗаполнено(ДокументОбъект.ДатаРаспечатки), ДокументОбъект.ДатаРаспечатки, ТекущаяДата());
	ОбластьПодвал.Параметры.ДатаРаспечатки = Формат(ДатаРаспечатки_,"ДФ = дд.ММ.гггг");
	
	ТабДокумент.Вывести(ОбластьПодвал);
	
	//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц(); //переходим на следующую страницу	
	//// Приложение
	//ОбластьПриложение = Макет.ПолучитьОбласть("Приложение");
	//ОбластьПриложение.Параметры.Номер = ОбластьШапка.Параметры.Номер;
	//ОбластьПриложение.Параметры.ЗаказНарядДата = ОбластьШапка.Параметры.ЗаказНарядДата;
	//ОбластьПриложение.Параметры.Организация = ОбластьШапка.Параметры.Организация;
	//ОбластьПриложение.Параметры.Заказчик = ОбластьШапка.Параметры.Заказчик;

	//ТабДокумент.Вывести(ОбластьПриложение);
	
	////////////////////////////////////////////////////////
	//// Нижние колонтитулы
	//ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение=ВертикальноеПоложение.Низ;
	//ТабДокумент.НижнийКолонтитул.Выводить = Истина;
	//ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	//ДатаРаспечатки = ?(ЗначениеЗаполнено(ДокументОбъект.ДатаРаспечатки), ДокументОбъект.ДатаРаспечатки, ТекущаяДата());
	//ТабДокумент.НижнийКолонтитул.ТекстСлева="Дата распечатки: " + Формат(ДатаРаспечатки,"ДФ = дд.ММ.гггг");
	//ТабДокумент.НижнийКолонтитул.Шрифт = ТабДокумент.ВерхнийКолонтитул.Шрифт;
	ТабДокумент.ПолеСверху              = 0;
	ТабДокумент.ПолеСлева               = 5;
	ТабДокумент.ПолеСнизу               = 0;
	ТабДокумент.ПолеСправа              = 5;
	ТабДокумент.РазмерКолонтитулаСверху = 0;
	ТабДокумент.РазмерКолонтитулаСнизу  = 0;
	ТабДокумент.АвтоМасштаб             = Истина;
	ТабДокумент.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	ТабДокумент.ДвусторонняяПечать      = ТипДвустороннейПечати.ПереворотВлево;
	#КонецЕсли
	Возврат ТабДокумент;
КонецФункции  

// Семенихин 18.09.2024 +++++
Функция ПечатьЛадаСОПД_XCITE(ТабДокумент) Экспорт
	Если ТабДокумент = Неопределено Тогда
		ТабДокумент = Новый ТабличныйДокумент();
	КонецЕсли;
	
	#Если Клиент Тогда
	ДокументОбъект = ЭтотОбъект;
	
	Макет = ПолучитьМакет("ЛадаСОПД_XCITE");	  
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");  
	Организация_ = ДокументОбъект.Организация;
	ОбластьШапка.Параметры.Организация = Организация_.Наименование;
	ОбластьШапка.Параметры.АдресОрганизации = киПолучитьПредставлениеКИ(ДокументОбъект.ПодразделениеКомпании, Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьШапка.Параметры.ТелефонОрганизации = киПолучитьПредставлениеКИ(Организация_, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	
	// Вывод остальной шапки документа
	ОбластьШапка.Параметры.Номер = ДокументОбъект.Номер;
	ОбластьШапка.Параметры.ЗаказНарядДата = Формат(ДокументОбъект.Дата,"ДЛФ=ДД");
	//ОбластьШапка.Параметры.Время = Формат(ТекущаяДата,"ДЛФ=В");
	ОбластьШапка.Параметры.Организация = Организация.Наименование;
	  
	Автомобиль_ = ДокументОбъект.Автомобиль;
	Если обЗначениеНеЗаполнено(Автомобиль_) Тогда
	  Сообщить("Поле Автомобиль не заполнено!", СтатусСообщения.Внимание);
	  Возврат Неопределено;
	КонецЕсли;
	  
	//Владелец = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин, ДокументОбъект.ДатаСоздания);
	Владелец_ = ДокументОбъект.Владелец; 
	Если обЗначениеНеЗаполнено(Владелец_) Тогда
