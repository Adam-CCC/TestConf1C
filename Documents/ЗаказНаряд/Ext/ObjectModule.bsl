		Если ЗаписьКруговогоОсмотра.ВоздушныйФильтрДвигателя Тогда
			ОбластьМакета.Параметры.ВоздушныйФильтрДвигателяY = "V";
		Иначе
			ОбластьМакета.Параметры.ВоздушныйФильтрДвигателяN = "V";
		КонецЕсли;
		
		Если ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = 0 Тогда
			ОбластьМакета.Параметры.УровеньМаслаВДвигателе = "min";
		ИначеЕсли ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = 1 Тогда
			ОбластьМакета.Параметры.УровеньМаслаВДвигателе = "0";
		ИначеЕсли ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = 2 Тогда
			ОбластьМакета.Параметры.УровеньМаслаВДвигателе = "1/4";
		ИначеЕсли ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = 3 Тогда
			ОбластьМакета.Параметры.УровеньМаслаВДвигателе = "2/4";
		ИначеЕсли ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = 4 Тогда
			ОбластьМакета.Параметры.УровеньМаслаВДвигателе = "3/4";
		ИначеЕсли ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = 5 Тогда
			ОбластьМакета.Параметры.УровеньМаслаВДвигателе = "4/4";
		ИначеЕсли ЗаписьКруговогоОсмотра.УровеньМаслаВДвигателе = 6 Тогда
			ОбластьМакета.Параметры.УровеньМаслаВДвигателе = "max";
		КонецЕсли;
		
		Если ЗаписьКруговогоОсмотра.ПриводныеРемни Тогда
			ОбластьМакета.Параметры.ПриводныеРемниY = "V";
		Иначе
			ОбластьМакета.Параметры.ПриводныеРемниN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.Трубопроводы Тогда
			ОбластьМакета.Параметры.ТрубопроводыY = "V";
		Иначе
			ОбластьМакета.Параметры.ТрубопроводыN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.КлеммыАКБ Тогда
			ОбластьМакета.Параметры.КлеммыАКБY = "V";
		Иначе
			ОбластьМакета.Параметры.КлеммыАКБN = "V";
		КонецЕсли;
		
		// 6. Осмотр частично поднятого автомобиля														
		Если ЗаписьКруговогоОсмотра.РулевоеУправление Тогда
			ОбластьМакета.Параметры.РулевоеУправлениеY = "V";
		Иначе
			ОбластьМакета.Параметры.РулевоеУправлениеN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.ПодшипникиСтупицПередних Тогда
			ОбластьМакета.Параметры.ПодшипникиСтупицПереднихY = "V";
		Иначе
			ОбластьМакета.Параметры.ПодшипникиСтупицПереднихN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.ПодшипникиСтупицЗадних Тогда
			ОбластьМакета.Параметры.ПодшипникиСтупицЗаднихY = "V";
		Иначе
			ОбластьМакета.Параметры.ПодшипникиСтупицЗаднихN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.Амортизаторы Тогда
			ОбластьМакета.Параметры.АмортизаторыY = "V";
		Иначе
			ОбластьМакета.Параметры.АмортизаторыN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.ТормозныеДискиПередние Тогда
			ОбластьМакета.Параметры.ТормозныеДискиПередниеY = "V";
		Иначе
			ОбластьМакета.Параметры.ТормозныеДискиПередниеN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.ТормозныеДискиЗадние Тогда
			ОбластьМакета.Параметры.ТормозныеДискиЗадниеY = "V";
		Иначе
			ОбластьМакета.Параметры.ТормозныеДискиЗадниеN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.ТормозныеКолодкиПередние Тогда
			ОбластьМакета.Параметры.ТормозныеКолодкиПередниеY = "V";
		Иначе
			ОбластьМакета.Параметры.ТормозныеКолодкиПередниеN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.ТормозныеКолодкиЗадние Тогда
			ОбластьМакета.Параметры.ТормозныеКолодкиЗадниеY = "V";
		Иначе
			ОбластьМакета.Параметры.ТормозныеКолодкиЗадниеN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.КолесныеДискиКолпакиШины Тогда
			ОбластьМакета.Параметры.КолесныеДискиКолпакиШиныY = "V";
		Иначе
			ОбластьМакета.Параметры.КолесныеДискиКолпакиШиныN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.СостояниеСотРадиатора Тогда
			ОбластьМакета.Параметры.СостояниеСотРадиатораY = "V";
		Иначе
			ОбластьМакета.Параметры.СостояниеСотРадиатораN = "V";
		КонецЕсли;
		
		// 7. Осмотр полностью поднятого автомобиля														
		Если ЗаписьКруговогоОсмотра.ШРУСыИПыльники Тогда
			ОбластьМакета.Параметры.ШРУСыИПыльникиY = "V";
		Иначе
			ОбластьМакета.Параметры.ШРУСыИПыльникиN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.ПередняяПодвеска Тогда
			ОбластьМакета.Параметры.ПередняяПодвескаY = "V";
		Иначе
			ОбластьМакета.Параметры.ПередняяПодвескаN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.ЗадняяПодвеска Тогда
			ОбластьМакета.Параметры.ЗадняяПодвескаY = "V";
		Иначе
			ОбластьМакета.Параметры.ЗадняяПодвескаN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.СистемаВыпуска Тогда
			ОбластьМакета.Параметры.СистемаВыпускаY = "V";
		Иначе
			ОбластьМакета.Параметры.СистемаВыпускаN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.ГерметичностьОтстутствиеПодтеканий Тогда
			ОбластьМакета.Параметры.ГерметичностьОтстутствиеПодтеканийY = "V";
		Иначе
			ОбластьМакета.Параметры.ГерметичностьОтстутствиеПодтеканийN = "V";
		КонецЕсли;	
		
		// 8. Осмотр снаружи автомобиля
		Если ЗначениеЗаполнено(ЗаписьКруговогоОсмотра.ПоврежденияКузова) Тогда
			Попытка
				КартинкаПовреждений = Новый Картинка(ЗаписьКруговогоОсмотра.ПоврежденияКузова);
				РисунокПовреждение = ОбластьМакета.Рисунки.Авто;
				РисунокПовреждение.Картинка = КартинкаПовреждений;
			Исключение
			КонецПопытки;
		КонецЕсли;	
		
		// 9. Оснащение автомобиля										
		Если ЗаписьКруговогоОсмотра.ЗапасноеКолесо Тогда
			ОбластьМакета.Параметры.ЗапасноеКолесоY = "V";
		Иначе
			ОбластьМакета.Параметры.ЗапасноеКолесоN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.ШтатныйНаборИнструментов Тогда
			ОбластьМакета.Параметры.ШтатныйНаборИнструментовY = "V";
		Иначе
			ОбластьМакета.Параметры.ШтатныйНаборИнструментовN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.Домкрат Тогда
			ОбластьМакета.Параметры.ДомкратY = "V";
		Иначе
			ОбластьМакета.Параметры.ДомкратN = "V";
		КонецЕсли;		
		Если ЗаписьКруговогоОсмотра.ДорожныйНабор Тогда
			ОбластьМакета.Параметры.ДорожныйНаборY = "V";
		Иначе
			ОбластьМакета.Параметры.ДорожныйНаборN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.Аптечка Тогда
			ОбластьМакета.Параметры.АптечкаY = "V";
		Иначе
			ОбластьМакета.Параметры.АптечкаN = "V";
		КонецЕсли;	
		Если ЗаписьКруговогоОсмотра.Пепельница Тогда
			ОбластьМакета.Параметры.ПепельницаY = "V";
		Иначе
			ОбластьМакета.Параметры.ПепельницаN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.Прикуриватель Тогда
			ОбластьМакета.Параметры.ПрикуривательY = "V";
		Иначе
			ОбластьМакета.Параметры.ПрикуривательN = "V";
		КонецЕсли;
		
		// 10. Дополнительное оборудование										
		Если ЗаписьКруговогоОсмотра.ОхранныеСистемыСБлокировкойЗапускаДвигателя Тогда
			ОбластьМакета.Параметры.ОхранныеСистемыСБлокировкойЗапускаДвигателяY = "V";
		Иначе
			ОбластьМакета.Параметры.ОхранныеСистемыСБлокировкойЗапускаДвигателяN = "V";
		КонецЕсли;
		Если ЗаписьКруговогоОсмотра.СекретныеГайкиНаКолесах Тогда
			ОбластьМакета.Параметры.СекретныеГайкиНаКолесахY = "V";
		Иначе
			ОбластьМакета.Параметры.СекретныеГайкиНаКолесахN = "V";
		КонецЕсли;
		
		ОбластьМакета.Параметры.ПрочиеЗамечания = ЗаписьКруговогоОсмотра.ПрочиеЗамечания;
		
		// 11. Сведения о предоставленных Заказчиком запасных частях и материалах														
		ОбластьМакета.Параметры.ДетальЗаказчикаНаименование1 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаНаименование1;
		ОбластьМакета.Параметры.ДетальЗаказчикаКоличество1 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаКоличество1;
		ОбластьМакета.Параметры.ДетальЗаказчикаНаименование2 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаНаименование2;
		ОбластьМакета.Параметры.ДетальЗаказчикаКоличество2 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаКоличество2;
		ОбластьМакета.Параметры.ДетальЗаказчикаНаименование3 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаНаименование3;
		ОбластьМакета.Параметры.ДетальЗаказчикаКоличество3 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаКоличество3;
		ОбластьМакета.Параметры.ДетальЗаказчикаНаименование4 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаНаименование4;
		ОбластьМакета.Параметры.ДетальЗаказчикаКоличество4 = ЗаписьКруговогоОсмотра.ДетальЗаказчикаКоличество4;
		
	Иначе
		//Сообщить("Нет данных кругового осмотра WA", СтатусСообщения.Внимание);
	КонецЕсли;
	///////////////////////////////////////////////////////////////////////////
	  
	ТабДокумент.Вывести(ОбластьМакета);

	// Нижние колонтитулы
	ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение=ВертикальноеПоложение.Низ;
	ТабДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ДатаРаспечатки_ = ?(ЗначениеЗаполнено(ЭтотОбъект.ДатаРаспечатки), ЭтотОбъект.ДатаРаспечатки, ТекущаяДата());
	ТабДокумент.НижнийКолонтитул.ТекстСлева="Дата распечатки: " + Формат(ДатаРаспечатки_,"ДФ = дд.ММ.гггг");
	ТабДокумент.НижнийКолонтитул.Шрифт = ТабДокумент.ВерхнийКолонтитул.Шрифт;
	
	//Бондаренко++ 20220318
	ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;
	//Бондаренко-- 20220318
  	
	ТабДокумент.АвтоМасштаб = Истина;	
	
	Возврат ТабДокумент;  
	
КонецФункции //ПечатьЕДОСАктПриёмаПередачиТС(ТабДокумент)

Функция ПечатьЕДОСАктСдачиПриёмкиРабот(ТабДокумент) Экспорт

	Макет = ПолучитьМакет("ЕДОСАктСдачиПриёмкиРабот");
	
	НомерДляПечати=дкПолучитьНомерДляПечати(ЭтотОбъект);
	
	//Вывод шапки документа
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.НомерДок = НомерДляПечати;
	ОбластьМакета.Параметры.ДатаДок = Формат(ЭтотОбъект.Дата,"ДФ = дд.ММ.гггг");
	ОбластьМакета.Параметры.Исполнитель = ЭтотОбъект.Организация;
	ОбластьМакета.Параметры.ИсполнительНаименование = спПолучитьНаименование(ЭтотОбъект.Организация);
	ОбластьМакета.Параметры.ИсполнительКратко = ЭтотОбъект.Организация.Наименование;
	ОбластьМакета.Параметры.ИсполнительЮрАдрес = киПолучитьПредставлениеКИ(ЭтотОбъект.Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	ОбластьМакета.Параметры.ИсполнительТелефон = киПолучитьПредставлениеКИ(ЭтотОбъект.Организация, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	
	Если ЗначениеЗаполнено(ЭтотОбъект._г_ДоверенноеЛицоЗаказчика) Тогда
		ВладелецФИО = спПолучитьНаименование(Владелец);
	 	Доверенность = ЭтотОбъект._г_ДоверенностьЗаказчика;
		Если ЗначениеЗаполнено(Доверенность) Тогда
			ВладелецФИО = ВладелецФИО + " (доверенность №" + Доверенность.Номер;
			ВладелецФИО = ВладелецФИО + " от " + Формат(Доверенность.ДатаВыдачи,"ДЛФ=D") + ")";
		КонецЕсли;
	Иначе
		//Владелец = ЭтотОбъект.Владелец;		
		ВладелецФИО = спПолучитьНаименование(ЭтотОбъект.Владелец);		
	КонецЕсли;	
 	ОбластьМакета.Параметры.ВладелецФИО = ВладелецФИО;
	
	// ИНН и КПП для юр. лиц
	Если Владелец.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
		ОбластьМакета.Параметры.ВладелецИНН = "ИНН " + Владелец.ИНН + " КПП " + Владелец.КПП;
	ИначеЕсли Владелец.ФормаСобственности = Перечисления.ФормыСобственности.ЧастныйПредприниматель Тогда
		ОбластьМакета.Параметры.ВладелецИНН = "ИНН " + Владелец.ИНН;
	КонецЕсли;	  
	ОбластьМакета.Параметры.адрес = киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
	ОбластьМакета.Параметры.телефон = киПолучитьПредставлениеКИ(Владелец, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	ОбластьМакета.Параметры.Мастер = ЭтотОбъект.Диспетчер;
	
	//Иванченко 20250319 ++
	//БЫЛО	
	//ОбластьМакета.Параметры.МастерПолноеНаименование = ЭтотОбъект.Диспетчер.Наименование;
	//
	// ОбластьМакета.Параметры.ПоДоверенности2 =  "по доверенности №" + ЭтотОбъект.Номер + " от " + Формат(ЭтотОбъект.Дата,"ДЛФ=D");  
	//СТАЛО
	Если Метаданные().Реквизиты.Найти("Подписант") <> Неопределено И ЗначениеЗаполнено(ЭтотОбъект.Подписант) Тогда
		Подписант_Перем = ЭтотОбъект.Подписант;
	ИначеЕсли Метаданные().Реквизиты.Найти("Диспетчер") <> Неопределено И ЗначениеЗаполнено(Диспетчер) Тогда
		Подписант_Перем = ЭтотОбъект.Диспетчер;
	Иначе 
		Подписант_Перем = ПараметрыСеанса.Пользователь.Сотрудник;
	КонецЕсли; 

	ТекущаяДоверенность = СМ_ФормированиеНовыхОбъектов.ПолучитьДоверенность(Подписант_Перем, Организация);
	  
	Если ТекущаяДоверенность <> Неопределено Тогда
		ОбластьМакета.Параметры.МастерПолноеНаименование = Подписант_Перем.Наименование;
		НаОсновании = "доверенности № " + ТекущаяДоверенность.Номер + " от " + Формат(ТекущаяДоверенность.ДатаВыдачи, "ДФ=dd.MM.yy");
		ОбластьМакета.Параметры.ПоДоверенности2 = "по " + НаОсновании;   
	Иначе  
		Руководитель = дкОтветственноеЛицо(ЭтотОбъект,Перечисления.ВидыОбъектовСведений.Руководитель);
		ОбластьМакета.Параметры.МастерПолноеНаименование = Руководитель.РуководительПредставление;	  		
	КонецЕсли;	
	//Иванченко 20250319 --
  	
	Если НЕ обЗначениеНеЗаполнено(ЭтотОбъект.Автомобиль) Тогда
		ОбластьМакета.Параметры.Автомобиль = ЭтотОбъект.Автомобиль;
		ОбластьМакета.Параметры.АвтомобильКод = ЭтотОбъект.Автомобиль.VIN;
		ОбластьМакета.Параметры.АвтомобильМодель = ЭтотОбъект.Автомобиль.Модель;
		ОбластьМакета.Параметры.АвтомобильГодВыпуска = Формат(ЭтотОбъект.Автомобиль.ГодВыпуска,ФорматПредставленияГодаВыпускаАвтомобиля);
 		
		ОбластьМакета.Параметры.АвтомобильГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЭтотОбъект.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,ЭтотОбъект.ДатаСоздания);
 		ОбластьМакета.Параметры.АвтомобильПробег = Формат(ЭтотОбъект.Пробег,"ЧЦ=10");
		
	     ОбластьМакета.Параметры.ДатаГар = Формат(ЭтотОбъект.Автомобиль.ДатаНачалаГарантии,"ДФ=dd.MM.yy");

	КонецЕсли; 
	ТабДокумент.Вывести(ОбластьМакета);
		
	// Нижние колонтитулы
	ТабДокумент.НижнийКолонтитул.ВертикальноеПоложение=ВертикальноеПоложение.Низ;
	ТабДокумент.НижнийКолонтитул.Выводить = Истина;
	ТабДокумент.НижнийКолонтитул.НачальнаяСтраница = 1;
	ДатаРаспечатки_ = ?(ЗначениеЗаполнено(ЭтотОбъект.ДатаРаспечатки), ЭтотОбъект.ДатаРаспечатки, ТекущаяДата());
	ТабДокумент.НижнийКолонтитул.ТекстСлева="Дата распечатки: " + Формат(ДатаРаспечатки_,"ДФ = дд.ММ.гггг");
	ТабДокумент.НижнийКолонтитул.Шрифт = ТабДокумент.ВерхнийКолонтитул.Шрифт;
	
	//Бондаренко++ 20220318
	ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;
	//Бондаренко-- 20220318
	
	//Бондаренко++ 20220318
	ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;
	//Бондаренко-- 20220318
	
	//Бондаренко++ 20220318
	ТабДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.ПереворотВлево;
	//Бондаренко-- 20220318

	ТабДокумент.Автомасштаб = Истина;
	
	Возврат ТабДокумент;

КонецФункции  //ПечатьЕДОСАктСдачиПриёмкиРабот(ТабДокумент)

Функция ПечатьЕДОСДополнительноеСогласование(ТабДокумент) Экспорт
 	  
	  //Контроль запрета печати при наличии открытых заказ-нарядов
	  Попытка
		  Если   обПраво("УРВ_Проверки",Права,,ЭтотОбъект) тогда
			  Запрос = Новый Запрос;
			  Запрос.Текст = "ВЫБРАТЬ
			  |	РегистрацияВремениРаботТехПроцесс.Период,
			  |	РегистрацияВремениРаботТехПроцесс.Сотрудник,
			  |	РегистрацияВремениРаботТехПроцесс.ЗаказНаряд,
			  |	РегистрацияВремениРаботТехПроцесс.Авторабота,
			  |	РегистрацияВремениРаботТехПроцесс.ВидОтметки,
			  |	РегистрацияВремениРаботТехПроцесс.КонецРаботы,
			  |	РегистрацияВремениРаботТехПроцесс.Продолжительность,
			  |	РегистрацияВремениРаботТехПроцесс.РабочееМесто
			  |ИЗ
			  |	РегистрСведений.РегистрацияВремениРаботТехПроцесс КАК РегистрацияВремениРаботТехПроцесс
			  |ГДЕ
			  |	РегистрацияВремениРаботТехПроцесс.ЗаказНаряд.Автомобиль = &Автомобиль
			  |	И РегистрацияВремениРаботТехПроцесс.Авторабота = &Авторабота
			  |	И РегистрацияВремениРаботТехПроцесс.Период МЕЖДУ &ДатаНачало И &ДатаОкончания";
			  Запрос.УстановитьПараметр("Авторабота",Справочники.Автоработы.Приемка);				 
			  Запрос.УстановитьПараметр("Автомобиль",ЭтотОбъект.Ссылка.Автомобиль);	
			  Запрос.УстановитьПараметр("ДатаНачало",   НачалоДня(?(ЭтотОбъект.Ссылка.ДатаНачала='00010101',ТекущаяДата(),ЭтотОбъект.Ссылка.ДатаНачала)));	
			  
			  Запрос.УстановитьПараметр("ДатаОкончания",КонецДня(?(ЭтотОбъект.Ссылка.ДатаНачала='00010101',ТекущаяДата(),ЭтотОбъект.Ссылка.ДатаНачала)));	
			  
			  
			  Результат = Запрос.Выполнить().Выбрать();
			  Если НЕ Результат.Следующий() тогда
				  Флаг = Ложь;
				  Если ЭтотОбъект.ФормаОплаты = Перечисления.ФормаОплаты.ПустаяСсылка() тогда
					  Флаг = Истина;
					  Сообщить("Не указано форма оплаты!!!");
				  КонецЕсли;
				  Если  ЭтотОбъект.Согласование = Перечисления.Согласование.ПустаяСсылка() тогда
					  Флаг = Истина;
					  Сообщить("Не указано форма согласования!!!");
					  
				  КонецЕсли;
				  
				  Если  ЭтотОбъект.Согласование = Перечисления.Ожидание.ПустаяСсылка() тогда
					  Флаг = Истина;
					  Сообщить("Не указано где клиент ожидает!!!");
					  
				  КонецЕсли;
				  Сообщить("Не выполнена приемка");
				  Возврат Неопределено;
				  
				  Если Флаг тогда
					  Возврат Неопределено;
				  КонецЕсли;
			  Иначе
				  Если Результат.КонецРаботы = 0 тогда
					  Сообщить("Не выполнена приемка");
					  
					  Возврат Неопределено;
					  
				  КонецЕсли;  
				  
			  КонецЕсли;	
			  
		  КонецЕсли;
	  Исключение
	  КонецПопытки;
	  
	  ВалютаПечатногоДокумента=Справочники.Валюты.НайтиПоКоду("643");
	  Если ВалютаПечатногоДокумента=Неопределено Тогда Возврат Неопределено; КонецЕсли; 
	  
	  ТаблицаТоваров = ЭтотОбъект.Товары.Выгрузить();
	  зфПерерасчетТаблицыТоваров(ТаблицаТоваров,ЭтотОбъект,ВалютаПечатногоДокумента);
	  ТаблицаРабот = ЭтотОбъект.Работы.Выгрузить();
	  зфПерерасчетТаблицыТоваров(ТаблицаРабот,ЭтотОбъект,ВалютаПечатногоДокумента,Истина);
	  
	  МассивТипов = Новый Массив();
	  МассивТипов.Добавить("Булево");
	  ЛогическийТип = Новый ОписаниеТипов(МассивТипов);
	  ТаблицаТоваров.Колонки.Добавить("ЕстьВЗаявке", ЛогическийТип);
	  ТаблицаРабот.Колонки.Добавить("ЕстьВЗаявке", ЛогическийТип);
	  
	  ЕстьСкидкаПоДеталям = Ложь;
	  Если ЭтотОбъект.Товары.Итог("СуммаСкидки") <> 0 Тогда
		  ЕстьСкидкаПоДеталям = Истина;
	  КонецЕсли;
	  
	  ЕстьСкидкаПоРаботам = Ложь;
	  Если ЭтотОбъект.Работы.Итог("СуммаСкидки") <> 0 Тогда
		  ЕстьСкидкаПоРаботам = Истина;
	  КонецЕсли;
	  
	  КоличествоРаботОсновных = Ложь;
	  КоличествоРаботОсновныхДоп = Ложь;
	  Попытка
		  Для Каждого стр из ТаблицаРабот   цикл
			  Если стр.Основная тогда
				  
				  КоличествоРаботОсновных = Истина;
			  КонецЕсли;
			  Если Не стр.Основная тогда
				  
				  КоличествоРаботОсновныхДоп = Истина;
			  КонецЕсли;	
		  КонецЦикла;
	  Исключение
		  КоличествоРаботОсновных = Истина;
	  КонецПопытки;
	  
	  КоличествоДеталейКлиентаОсновных = Ложь;
	  КоличествоДеталейКлиентаОсновныхДоп = Ложь;	  
	  Попытка
		  Для Каждого стр из ЭтотОбъект.ТОвары.Выгрузить()   цикл
			  Если стр.Основная тогда
				  
				  КоличествоДеталейКлиентаОсновных = Истина;
			  КонецЕсли;
			  Если Не стр.Основная тогда
				  
				  КоличествоДеталейКлиентаОсновныхДоп = Истина;
			  КонецЕсли;	
		  КонецЦикла;		
	  Исключение
		  КоличествоДеталейКлиентаОсновных = Истина;
	  КонецПопытки;
	  
	  // Найдём заявку-основание
	  ЕстьДопТовары = Ложь;
	  ЕстьДопРаботы = Ложь;
	  ТоварыЗаявки = Новый ТаблицаЗначений();
	  РаботыЗаявки = Новый ТаблицаЗначений();
	  Если ЗначениеЗаполнено(ЭтотОбъект.ДокументОснование) Тогда
		  Запрос = Новый Запрос();
		  Запрос.Текст = "ВЫБРАТЬ
		  |	ЗаявкаНаРемонт.Ссылка КАК ЗаявкаОснование
		  |ИЗ
		  |	Документ.ЗаявкаНаРемонт КАК ЗаявкаНаРемонт
		  |ГДЕ
		  |	ЗаявкаНаРемонт.Ссылка = &ОснованиеЗаказНаряда";					 
		  Запрос.УстановитьПараметр("ОснованиеЗаказНаряда", ЭтотОбъект.ДокументОснование);
		  Результат = Запрос.Выполнить().Выбрать();
		  Если Результат.Следующий() Тогда
			  ТоварыЗаявки = Результат.ЗаявкаОснование.Товары.Выгрузить();
			  РаботыЗаявки = Результат.ЗаявкаОснование.Работы.Выгрузить();
		  Иначе
			  Сообщить("Основание заказ-наряда не является заявкой на ремонт!", СтатусСообщения.Информация);
			  Возврат Неопределено;
		  КонецЕсли;
	  Иначе
		  Сообщить("У заказ-наряда нет документа-основания!", СтатусСообщения.Информация);
		  Возврат Неопределено;
	  КонецЕсли;
	  
	  КоличествоДеталей = ТаблицаТоваров.Количество();	  
	  Если ТоварыЗаявки.Количество() > 0 Тогда
		  Для Каждого Товар Из ТаблицаТоваров Цикл
			  Товар.ЕстьВЗаявке = Ложь;
			  Найденный = ТоварыЗаявки.Найти(Товар.Номенклатура, "Номенклатура");
			  Если ЗначениеЗаполнено(Найденный) Тогда
				  Если Найденный.Количество >= Товар.Количество Тогда
					  Товар.ЕстьВЗаявке = Истина;
					  КоличествоДеталей = КоличествоДеталей - 1;
				  Иначе
					  Товар.Количество = Товар.Количество - Найденный.Количество;
					  Товар.СуммаСкидки = Товар.СуммаСкидки - Найденный.СуммаСкидки;
					  Товар.СуммаВсего = Товар.СуммаВсего - Найденный.СуммаВсего;
				  КонецЕсли;
			  КонецЕсли;
		  КонецЦикла;
	  Иначе	  
		  Для Каждого Товар Из ТаблицаТоваров Цикл
			  Товар.ЕстьВЗаявке = Ложь;
		  КонецЦикла;
	  КонецЕсли;
	  
	  КоличествоРабот = ТаблицаРабот.Количество();	  
	  Если РаботыЗаявки.Количество() > 0 Тогда
		  Для Каждого Работа Из ТаблицаРабот Цикл
			  Работа.ЕстьВЗаявке = Ложь;
			  Найденный = РаботыЗаявки.Найти(Работа.Работа, "Работа");
			  Если ЗначениеЗаполнено(Найденный) Тогда
				  Если Найденный.Количество >= Работа.Количество Тогда
					  Работа.ЕстьВЗаявке = Истина;
					  КоличествоРабот = КоличествоРабот - 1;
				  Иначе
					  Работа.Количество = Работа.Количество - Найденный.Количество;
					  Работа.СуммаСкидки = Работа.СуммаСкидки - Найденный.СуммаСкидки;
					  Работа.СуммаВсего = Работа.СуммаВсего - Найденный.СуммаВсего;
				  КонецЕсли;
			  КонецЕсли;
		  КонецЦикла;
	  Иначе	  
		  Для Каждого Работа Из ТаблицаРабот Цикл
			  Работа.ЕстьВЗаявке = Ложь;
		  КонецЦикла;
	  КонецЕсли;
	  
	  //зададим параметры макета
	  ТабДокумент.ПолеСверху = 0;
	  ТабДокумент.ПолеСлева  = 0;
	  ТабДокумент.ПолеСнизу  = 0;
	  ТабДокумент.ПолеСправа = 0;
	  ТабДокумент.ТолькоПросмотр = Истина;
	  ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	  
	  Макет = ПолучитьМакет("ЕДОСДополнительноеСогласование");
	  ОбластьСкидка = Макет.Область("Скидка");	  
	  ОбластьУслуги = Макет.ПолучитьОбласть("Услуги");
	  ОбластьДетали = Макет.ПолучитьОбласть("Детали");	  
	  ОбластьУслугиДоп = Макет.ПолучитьОбласть("УслугиДоп");
	  ОбластьДеталиДоп = Макет.ПолучитьОбласть("ДеталиДоп");
	  
	  ОбластьСтрокаДеталейДоп	        = Макет.ПолучитьОбласть("СтрокаДеталейДоп");
	  ОбластьИтоговПоСтраницеДеталиДоп	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталейДоп");
	  ОбластьПодвалДеталейДоп	        = Макет.ПолучитьОбласть("ПодвалДеталиДоп");
	  
	  ОбластьСтрокаУслугДоп		        = Макет.ПолучитьОбласть("СтрокаРаботДоп");
	  ОбластьИтоговПоСтраницеУслугиДоп	= Макет.ПолучитьОбласть("ИтогиПоСтраницеРаботДоп");
	  ОбластьПодвалУслугДоп		        = Макет.ПолучитьОбласть("ПодвалУслугиДоп");
	  
	  ОбластьШапкаДеталейКлиента			= Макет.ПолучитьОбласть("ШапкаДеталейКлиента");
	  ОбластьСтрокаДеталейКлиента			= Макет.ПолучитьОбласть("СтрокаДеталейКлиента");
	  ОбластьИтоговПоСтраницеДеталиКлиента	= Макет.ПолучитьОбласть("ИтогиПоСтраницеДеталейКлиента");
	  ОбластьПодвалДеталейКлиента 			= Макет.ПолучитьОбласть("ПодвалКлиента");
	  
	  БезЛинии = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	  ОбычнаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	  /////////////////	  
	  ОбластьШапкаДеталейДоп = ОбластьДеталидоп.ПолучитьОбласть("ШапкаДеталейДоп");
	  ОбластьШапкаУслугДоп = ОбластьУслугиДОп.ПолучитьОбласть("ШапкаУслугДоп");	  
	  НомерДляПечати=дкПолучитьНомерДляПечати(ЭтотОбъект);
	  
	  // Вывод шапки документа для Дилера
	  Если ЗначениеЗаполнено(ЭтотОбъект.Автомобиль) Тогда
		  Марка = ВРег(ЭтотОбъект.Автомобиль.Модель.Родитель.Наименование);
		  Модель = ВРег(ЭтотОбъект.Автомобиль.Модель.Наименование);
	  Иначе
		  Марка = "";
		  Модель = "";
	  КонецЕсли;	
	  ЭтоНиссан = Найти(Модель, "NISSAN") > 0 Или Найти(Марка, "NISSAN") > 0 Или Найти(Модель, "НИССАН") > 0 Или Найти(Марка, "НИССАН") > 0;
	  ЭтоХёндэ = Найти(Модель, "HYUNDAI") > 0 Или Найти(Марка, "HYUNDAI") > 0 Или Найти(Модель, "ХЁНДЭ") > 0 Или Найти(Марка, "ХЁНДЭ") > 0;
	  ЭтоФорд = Найти(Модель, "FORD") > 0 Или Найти(Марка, "FORD") > 0 Или Найти(Модель, "ФОРД") > 0 Или Найти(Марка, "ФОРД") > 0;
	  ЭтоРено = Найти(Модель, "RENAULT") > 0 Или Найти(Марка, "RENAULT") > 0 Или Найти(Модель, "РЕНО") > 0 Или Найти(Марка, "РЕНО") > 0;
	  ЭтоДжип = Найти(Модель, "JEEP") > 0 Или Найти(Марка, "JEEP") > 0 Или Найти(Модель, "ДЖИП") > 0 Или Найти(Марка, "ДЖИП") > 0;
	  ЭтоФиат = Найти(Модель, "FIAT") > 0 Или Найти(Марка, "FIAT") > 0 Или Найти(Модель, "ФИАТ") > 0 Или Найти(Марка, "ФИАТ") > 0;
	  ЭтоSY = Найти(Модель, "SSANG YONG") > 0 Или Найти(Марка, "SSANG YONG") > 0 Или Найти(Модель, "ССАНГ ЙОНГ") > 0 Или Найти(Марка, "ССАНГ ЙОНГ") > 0
	  Или Найти(Модель, "SSANGYONG") > 0 Или Найти(Марка, "SSANGYONG") > 0 Или Найти(Модель, "ССАНГЙОНГ") > 0 Или Найти(Марка, "ССАНГЙОНГ") > 0;
	  ЭтоЛада = Найти(Модель, "LADA") > 0 Или Найти(Марка, "LADA") > 0 Или Найти(Модель, "ЛАДА") > 0 Или Найти(Марка, "ЛАДА") > 0;
	  ЭтоУАЗ = Найти(Модель, "UAZ") > 0 Или Найти(Марка, "UAZ") > 0 Или Найти(Модель, "УАЗ") > 0 Или Найти(Марка, "УАЗ") > 0;
	  
	  Если ЭтоРено Тогда
		  ОбластьМакета = Макет.ПолучитьОбласть("ШапкаРено");
	  Иначе
		  ОбластьМакета = Макет.ПолучитьОбласть("ШапкаДругие");
	  КонецЕсли;	
	  ОбластьМакета.Параметры.Организация = ЭтотОбъект.Организация;
	  ОбластьМакета.Параметры.ФирмаПолноеНаименование = спПолучитьНаименование(ЭтотОбъект.Организация);
	  ОбластьМакета.Параметры.ФирмаАдресЮридический = киПолучитьПредставлениеКИ(ЭтотОбъект.Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	  ТабДокумент.Вывести(ОбластьМакета);
	  
	  // Вывод остальной шапки документа
	  ОбластьМакета = Макет.ПолучитьОбласть("Шапка");  
