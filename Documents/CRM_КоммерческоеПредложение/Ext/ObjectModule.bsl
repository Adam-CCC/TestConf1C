Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ВоронкаПродаж.IDK,
	               |	CRM_ВоронкаПродаж.ЭтапПродаж,
	               |	CRM_ВоронкаПродаж.ДатаВыполнения,
	               |	CRM_ВоронкаПродаж.Объект
	               |ИЗ
	               |	РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
	               |ГДЕ
	               |	CRM_ВоронкаПродаж.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
	КонецЦикла;
	
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.КоммерческоеПредложение, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ПредложениеДополнительногоОборудования, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересКТрейдИн, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересККредиту, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересКПродленнойГарантии, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересКСтраховке, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересовалсяОборудованием, РабочийЛист, Ссылка);
	
КонецПроцедуры

Функция ДействуетБлокировкаПродажиАвтомобиля(Конфигурации,Отказ)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_КонфигурацииАвтомобилей.VIN,
		|	CRM_КонфигурацииАвтомобилей.Модель,
		|	CRM_КонфигурацииАвтомобилей.Версия
		|ИЗ
		|	Справочник.CRM_КонфигурацииАвтомобилей КАК CRM_КонфигурацииАвтомобилей
		|ГДЕ
		|	CRM_КонфигурацииАвтомобилей.Ссылка В(&Конфигурации)"; 	
	Запрос.УстановитьПараметр("Конфигурации", Конфигурации);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();	
	Пока Выборка.Следующий() Цикл
		// +++ ВалиховГА 19.10.2021 DMSREN-1334 удаление
		//Если ЗначениеЗаполнено(Выборка.VIN) И Renault_ОбщийМодуль.Блокировка(Выборка.VIN) Тогда
		//	Сообщить("Не удалось записать договор."+Символы.ПС+"Автомобиль с VIN "+Выборка.VIN+" заблокирован к продаже.");
		//	Отказ=Истина;
		//ИначеЕсли ЗначениеЗаполнено(Выборка.Версия) И Renault_ОбщийМодуль.Блокировка(Выборка.Версия) Тогда
		Если ЗначениеЗаполнено(Выборка.Версия) И Renault_ОбщийМодуль.Блокировка(Выборка.Версия) Тогда
		// --- ВалиховГА 19.10.2021 DMSREN-1334 удаление
			Сообщить("Не удалось записать договор."+Символы.ПС+"Вариант комплектации "+Выборка.Версия + " заблокирован к продаже.");
			Отказ=Истина;
		ИначеЕсли ЗначениеЗаполнено(Выборка.Модель) И Renault_ОбщийМодуль.Блокировка(Выборка.Модель) Тогда
			Сообщить("Не удалось записать договор."+Символы.ПС+"Модель "+Выборка.Модель+" заблокирована к продаже.");
			Отказ=Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Отказ;	
КонецФункции