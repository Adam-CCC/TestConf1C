Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Конфигурации = Состав.ВыгрузитьКолонку("Конфигурация");	
	Если ДействуетБлокировкаПродажиАвтомобиля(Конфигурации,Отказ) Тогда
		Возврат;
	КонецЕсли;
