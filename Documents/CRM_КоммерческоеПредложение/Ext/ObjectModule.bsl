Процедура ЗаполнитьСтрокуТЧЗаявкиНаОборудование(НовСтрока,Данные)
	
	НовСтрока.Выбрана = истина;
	Если ТипЗнч(Данные.Номенклатура) = Тип("Строка") Тогда
		НовСтрока.ПсевдоОпция = Данные.Номенклатура;
		НовСтрока.ПсевдоСумма = Данные.Сумма;
		НовСтрока.ПсевдоКоличество = Данные.Количество;
		НовСтрока.Цена = Данные.Цена;
	Иначе
		НовСтрока.ПсевдоОпция = Строка(Данные.Номенклатура);
		НовСтрока.ПсевдоСумма = Данные.Сумма;
		НовСтрока.ПсевдоКоличество = Данные.Количество;
		НовСтрока.Опция = Данные.Номенклатура;
		НовСтрока.Цена = Данные.Цена;
		НовСтрока.Сумма = Данные.Сумма;
		НовСтрока.Количество = Данные.Количество;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	//Удалим всю статистику по КП
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.КоммерческоеПредложение, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ПредложениеДополнительногоОборудования, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересКТрейдИн, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересККредиту, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересКПродленнойГарантии, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересКСтраховке, РабочийЛист, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ИнтересовалсяОборудованием, РабочийЛист, Ссылка);
	
	//Фиксируем факт выполнения этапов продаж "Коммерческое предложение" и "Предложение дополнительного оборудования"
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_КоммерческоеПредложение.РабочийЛист КАК IDK,
	               |	CRM_КоммерческоеПредложение.Ссылка КАК Объект,
	               |	CRM_КоммерческоеПредложение.Дата КАК ДатаВыполнения,
	               |	ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.КоммерческоеПредложение) КАК ЭтапПродаж,
	               |	NULL КАК Номенклатура,
	               |	CRM_КоммерческоеПредложение.ДилерскийЦентр
	               |ИЗ
	               |	Документ.CRM_КоммерческоеПредложение КАК CRM_КоммерческоеПредложение
	               |ГДЕ
	               |	CRM_КоммерческоеПредложение.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.IDK.Установить(РабочийЛист);
	НаборЗаписей.Отбор.ЭтапПродаж.Установить(Справочники.CRM_ЭтапыПродаж.КоммерческоеПредложение);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество()= 0 тогда
		НаборЗаписей.Загрузить(Таблица);
	    НаборЗаписей.Записать();
	КонецЕсли;
	
	
	Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.КоммерческоеПредложение, РабочийЛист, Ссылка, , Дата, Состав[0].Конфигурация.Модель);
	
	//Доп.опции
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_КоммерческоеПредложение.РабочийЛист КАК IDK,
	               |	CRM_КоммерческоеПредложение.Ссылка КАК Объект,
	               |	CRM_КоммерческоеПредложение.Дата КАК ДатаВыполнения,
	               |	ЗНАЧЕНИЕ(Справочник.CRM_ЭтапыПродаж.ПредложениеДополнительногоОборудования) КАК ЭтапПродаж,
	               |	КОЛИЧЕСТВО(CRM_КонфигурацииАвтомобилейОборудование.Номенклатура) КАК Номенклатура,
	               |	CRM_КоммерческоеПредложение.ДилерскийЦентр
	               |ИЗ
	               |	Документ.CRM_КоммерческоеПредложение КАК CRM_КоммерческоеПредложение,
	               |	Справочник.CRM_КонфигурацииАвтомобилей.Оборудование КАК CRM_КонфигурацииАвтомобилейОборудование
	               |ГДЕ
	               |	CRM_КоммерческоеПредложение.Ссылка = &Ссылка
	               |	И CRM_КонфигурацииАвтомобилейОборудование.Ссылка В
	               |			(ВЫБРАТЬ
	               |				CRM_КоммерческоеПредложениеСостав.Конфигурация.Ссылка
	               |			ИЗ
	               |				Документ.CRM_КоммерческоеПредложение.Состав КАК CRM_КоммерческоеПредложениеСостав
	               |			ГДЕ
	               |				CRM_КоммерческоеПредложениеСостав.Ссылка = &Ссылка)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	CRM_КоммерческоеПредложение.РабочийЛист,
	               |	CRM_КоммерческоеПредложение.Ссылка,
	               |	CRM_КоммерческоеПредложение.Дата
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(CRM_КонфигурацииАвтомобилейОборудование.Номенклатура) > 0";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Таблица = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.IDK.Установить(РабочийЛист);
	НаборЗаписей.Отбор.ЭтапПродаж.Установить(Справочники.CRM_ЭтапыПродаж.ПредложениеДополнительногоОборудования);
	НаборЗаписей.Загрузить(Таблица);
	НаборЗаписей.Записать();
	
	Если Таблица.Количество() > 0 Тогда
		Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.ПредложениеДополнительногоОборудования, РабочийЛист, Ссылка, , Дата, Состав[0].Конфигурация.Модель);
	КонецЕсли;
	
	//Трейд-ин
	НаборЗаявкаС = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	НаборЗаявкаС.IDK = (РабочийЛист);
	НаборЗаявкаС.ЭтапПродаж = (Справочники.CRM_ЭтапыПродаж.ИнтересКТрейдИн);
