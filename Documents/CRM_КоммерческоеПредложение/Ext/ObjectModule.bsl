Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Тип("ДокументСсылка.CRM_ЗаписьНаТестДрайв") = ТипЗнч(ДанныеЗаполнения) Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Функция Печать() Экспорт
	
	Макет = ПолучитьМакет("МакетMXL");
	ТД = Новый ТабличныйДокумент;
	
	Обл = Макет.ПолучитьОбласть("Шапка");
	ДанныеШапки = ПолучитьДанныеШапки();
	Если НЕ Неопределено = ДанныеШапки Тогда
		ЗаполнитьЗначенияСвойств(Обл.Параметры, ДанныеШапки);
	КонецЕсли;
	ТД.Вывести(Обл);
	
	Обл = Макет.ПолучитьОбласть("БазовыеОпции");
	СтрСостав = Состав[0];
	МенеджерИдентификатор = РегистрыСведений.CRM_ИдентификаторыКартинок.СоздатьМенеджерЗаписи();
	МенеджерИдентификатор.Модель = СтрСостав.Конфигурация.Модель;
	МенеджерИдентификатор.Цвет = СтрСостав.Конфигурация.Цвет;
	МенеджерИдентификатор.ВариантКомплектации = СтрСостав.Конфигурация.Версия;
	МенеджерИдентификатор.Прочитать();
	Если НЕ МенеджерИдентификатор.Выбран() Тогда
		МенеджерИдентификатор.Модель = СтрСостав.Конфигурация.Модель;
		МенеджерИдентификатор.Цвет = СтрСостав.Конфигурация.Цвет;
		МенеджерИдентификатор.Прочитать();
	КонецЕсли;
	Если НЕ МенеджерИдентификатор.Выбран() Тогда
		МенеджерИдентификатор.Модель = СтрСостав.Конфигурация.Модель;
		МенеджерИдентификатор.Прочитать();
	КонецЕсли;
	Если МенеджерИдентификатор.Выбран() Тогда
		МенеджерКартинка = РегистрыСведений.КартинкиИФайлы.СоздатьМенеджерЗаписи();
		МенеджерКартинка.Объект = СтрСостав.Конфигурация.Модель;
		МенеджерКартинка.Идентификатор = МенеджерИдентификатор.Идентификатор;
		МенеджерКартинка.Прочитать();
		Обл.Рисунки.ИзображениеАвто.Картинка = МенеджерКартинка.Данные.Получить();
	КонецЕсли;
	ТД.Вывести(Обл);
	
	Возврат ТД;
	
КонецФункции

Функция ПолучитьДанныеШапки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_КоммерческоеПредложение.Клиент.Наименование КАК НаименованиеКлиента,
	|	АдресаОрганизаций.Объект.Наименование КАК НаименованиеОрганизации,
	|	АдресаОрганизаций.Представление КАК АдресОрганизации
	|ИЗ
	|	Документ.CRM_КоммерческоеПредложение КАК CRM_КоммерческоеПредложение
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КонтактнаяИнформация.Объект КАК Объект,
	|			КонтактнаяИнформация.Представление КАК Представление
	|		ИЗ
	|			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ГДЕ
	|			КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический)
	|			И КонтактнаяИнформация.Объект = &Организация) КАК АдресаОрганизаций
	|		ПО (ИСТИНА)
	|ГДЕ
	|	CRM_КоммерческоеПредложение.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Организация", ПараметрыСеанса.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции

