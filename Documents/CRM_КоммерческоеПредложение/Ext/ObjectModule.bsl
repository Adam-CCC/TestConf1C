		НаборЗаявкаС.ДатаВыполнения = ЭтотОбъект.Дата;
		НаборЗаявкаС.Записать();
		Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.ИнтересКТрейдИн, РабочийЛист, Ссылка, , Дата, Состав[0].Конфигурация.Модель);
		
	Иначе
		
		Если ИнтересовалсяТрейдИн тогда
			НаборЗаявкаС.IDK = РабочийЛист;
			НаборЗаявкаС.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ИнтересКТрейдИн ;
			НаборЗаявкаС.Объект = ЭтотОбъект.Ссылка;
			НаборЗаявкаС.ДатаВыполнения = ЭтотОбъект.Дата;
			НаборЗаявкаС.Записать();
			Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.ИнтересКТрейдИн, РабочийЛист, Ссылка, , Дата, Состав[0].Конфигурация.Модель);
		Иначе
			Если НаборЗаявкаС.Выбран() Тогда
				НаборЗаявкаС.Удалить();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	////Кредит
	//НаборЗаявкаС = РегистрыСведений.CRM_ВоронкаПродаж.СоздатьМенеджерЗаписи();
	//НаборЗаявкаС.IDK=(РабочийЛист);
