Функция ПолучитьДанныеКонфигурации(Конфигурация, Тариф)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_КонфигурацииАвтомобилей.Модель.Наименование КАК Модель,
	|	CRM_КонфигурацииАвтомобилей.Версия.Наименование КАК Версия,
	|	CRM_КонфигурацииАвтомобилей.Цвет.Наименование КАК Цвет,
	|	Renault_ДопИнформацияПоВерсиям.ОбъемДвигателя КАК Объем,
	|	Renault_ДопИнформацияПоВерсиям.МощностьЛС КАК ДвигательЛС,
	|	Renault_ДопИнформацияПоВерсиям.МощностьКВТ КАК Двигатель_КВТ,
	|	CRM_КонфигурацииАвтомобилей.VIN КАК VIN,
	|	CRM_КонфигурацииАвтомобилей.Автомобиль КАК Автомобиль,
	|	CRM_КонфигурацииАвтомобилей.Модель.Артикул КАК КодМодели,
	|	CRM_КонфигурацииАвтомобилей.Версия.Артикул КАК КодВерсии,
	|	CRM_КонфигурацииАвтомобилей.Цвет.Артикул КАК КодЦвета
	|ИЗ
	|	Справочник.CRM_КонфигурацииАвтомобилей КАК CRM_КонфигурацииАвтомобилей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопИнформацияПоВерсиям КАК Renault_ДопИнформацияПоВерсиям
	|		ПО CRM_КонфигурацииАвтомобилей.Версия = Renault_ДопИнформацияПоВерсиям.ВариантКомплектации
	|ГДЕ
	|	CRM_КонфигурацииАвтомобилей.Ссылка = &Конфигурация";
	Запрос.УстановитьПараметр("Конфигурация", Конфигурация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
