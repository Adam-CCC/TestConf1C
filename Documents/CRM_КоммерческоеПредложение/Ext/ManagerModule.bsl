	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_РабочийЛистОФУРасчетКредита.КредитноеПредложение КАК КредитноеПредложение,
	|	Renault_РабочийЛистОФУРасчетКредита.ПервоначальныйВзнос КАК ПервоначальныйВзнос,
