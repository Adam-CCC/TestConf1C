Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Renault_СтраховойПолис") Тогда
		// Заполнение шапки
		ДокументОснование = ДанныеЗаполнения.Ссылка;
		Ответственный = ПараметрыСеанса.Пользователь;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	// регистр Renault_РасторгнутыеПолисы
	Движения.Renault_РасторгнутыеПолисы.Записывать = Истина;
	Движения.Renault_РасторгнутыеПолисы.Очистить();
	Движение = Движения.Renault_РасторгнутыеПолисы.Добавить();
	Движение.СтраховойПолис = ДокументОснование;
	Движение.Ответственный = Ответственный;
	
КонецПроцедуры
