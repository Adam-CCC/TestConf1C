//Обработчик установки нового номера документа
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	Если НЕ дкПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс) Тогда Возврат; КонецЕсли;
КонецПроцедуры // ПриУстановкеНовогоНомера()

//Обработка заполнения нового документа
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если НЕ дкОбработкаЗаполнения(ЭтотОбъект, Основание) Тогда Возврат; КонецЕсли;
	
	НачалоОтправки			= Дата;
	НачалоПериодаЗапрета	= Константы.смсНачалоПериодаЗапрета.Получить();
	КонецПериодаЗапрета		= Константы.смсКонецПериодаЗапрета.Получить();
	РавномернаяРассылка		= Ложь;
	АвтотекстБулево			= Ложь;
	Транслитерация			= Ложь;
    		
	Если Основание <> Неопределено И ЗначениеЗаполнено(Основание) Тогда
		ДокументОснование = Основание;
		Входящее_Исходящее = Перечисления.ТипыСообщений.Исходящее;
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.Событие") Тогда
			// Заполнение шапки
			Огранизация = Основание.Организация;
			ПодразделениеКомпании = Основание.ПодразделениеКомпании;
			
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.РабочийЛист") Тогда
			Организация = Основание.Организация;
			ПодразделениеКомпании = Основание.ПодразделениеКомпании;
			НоваяСтрока = Получатели.Добавить();
			НоваяСтрока.Контрагент = Основание.Контрагент;
			НоваяСтрока.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			НоваяСтрока.КонтактнаяИнформация = Основание.ПредставлениеТелефона;		
			НоваяСтрока.НомерТелефона = НоваяСтрока.КонтактнаяИнформация;		
			
		ИначеЕсли ТипЗнч(Основание) = Тип("СправочникСсылка.Контрагенты") Тогда
			Организация = ПараметрыСеанса.Организация;
			ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
			НоваяСтрока = Получатели.Добавить();
			НоваяСтрока.Контрагент = Основание;
			НоваяСтрока.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			//поищем мобильный телефон
			НоваяСтрока.КонтактнаяИнформация = Основание.ОсновнойТелефон;
			Если обЗначениеНеЗаполнено(НоваяСтрока.КонтактнаяИнформация) Тогда
				НоваяСтрока.КонтактнаяИнформация = ПолучитьТелефон(Основание);
			КонецЕсли;		
			НоваяСтрока.НомерТелефона = НоваяСтрока.КонтактнаяИнформация;		
			
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
			Организация = Основание.Организация;
			ПодразделениеКомпании = Основание.ПодразделениеКомпании;
			НоваяСтрока = Получатели.Добавить();
			НоваяСтрока.Контрагент = Основание.Заказчик;
			НоваяСтрока.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			//поищем мобильный телефон
			НоваяСтрока.КонтактнаяИнформация = ПолучитьТелефон(НоваяСтрока.Контрагент);
			НоваяСтрока.НомерТелефона = НоваяСтрока.КонтактнаяИнформация;		
			
		ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаявкаНаРемонт") Тогда
			Организация = Основание.Организация;
			ПодразделениеКомпании = Основание.ПодразделениеКомпании;
			НоваяСтрока = Получатели.Добавить();
			НоваяСтрока.Контрагент = Основание.Заказчик;
			НоваяСтрока.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
			//поищем мобильный телефон
			Если ТипЗнч(НоваяСтрока.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
				НоваяСтрока.КонтактнаяИнформация = ПолучитьТелефон(НоваяСтрока.Контрагент);
			Иначе
				НоваяСтрока.КонтактнаяИнформация = Основание.ПредставлениеТелефона;
			КонецЕсли;		
			НоваяСтрока.НомерТелефона = НоваяСтрока.КонтактнаяИнформация;		
			
		Иначе
			Попытка
				Организация = Основание.Организация;
				ПодразделениеКомпании = Основание.ПодразделениеКомпании;
				НоваяСтрока = Получатели.Добавить();
				НоваяСтрока.Контрагент = Основание.Контрагент;
				НоваяСтрока.ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
				//поищем мобильный телефон
				НоваяСтрока.КонтактнаяИнформация = ПолучитьТелефон(НоваяСтрока.Контрагент);
				НоваяСтрока.НомерТелефона = НоваяСтрока.КонтактнаяИнформация;
			Исключение
			КонецПопытки;
		КонецЕсли;		
	КонецЕсли;
	
	// Семенихин 14.10.2025 +++++
	ЭтоПрайд = ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Малиновского43
	Или ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Малиновского43А
	Или ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Вавилова59Г
	Или ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Вавилова59К
	Или ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Текучева354;
	
	Если ЭтоПрайд Тогда
		НомерОтправителя = "PRIDECARSru";
	Иначе
		НомерОтправителя = Константы.смсИмяПользователяПоУмолчанию.Получить();
	КонецЕсли;
	// Семенихин 14.10.2025 -----
КонецПроцедуры

//Обработчик копирования документа
Процедура ПриКопировании(ОбъектКопирования)
	Если НЕ дкПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда Возврат; КонецЕсли;
КонецПроцедуры // ПриКопировании()

//Обработчик перед записью документа
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если НЕ дкПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	// Семенихин 28.01.2021 +++++
	Если Константы.ОператорSMS.Получить() = Перечисления.ОператорыSMS.Билайн Тогда
		Если стрДлина(ТекстСообщения) > 480 Тогда //480
			#Если Клиент Тогда
			Предупреждение
			("Длина текста СМС не должна превышать 480 символов!" +
			Символы.ПС + Символы.ПС + "Сократите текст СМС.",, "Проверка текста СМС");
			#КонецЕсли
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Семенихин 28.01.2021 -----
	
	Если Входящее_Исходящее = Перечисления.ТипыСообщений.Исходящее Тогда
		СтруктураСтатуса = ПолучитьСтатусДокумента();
		СтатусСтрокой = СтруктураСтатуса.СтатусСтрокой;
		Статус        = СтруктураСтатуса.Статус;
	КонецЕсли;
	
	СписокПолучателей="";
	Для Каждого ТекущаяСтрока Из Получатели Цикл 
		Если (ТекущаяСтрока.Контрагент = Неопределено) ИЛИ (обЗначениеНеЗаполнено(ТекущаяСтрока.Контрагент)) ИЛИ (ТипЗнч(ТекущаяСтрока.Контрагент) = Тип("Строка")) Тогда 
			СписокПолучателей=ТекущаяСтрока.НомерТелефона+СписокПолучателей;
		Иначе	
			СписокПолучателей=ТекущаяСтрока.Контрагент.Наименование+СписокПолучателей;
		КонецЕсли;
	КонецЦикла;
	
	// Семенихин 27.05.2022 +++++
	УдалитьДубликатыТелефонов();
	//Если обЗначениеНеЗаполнено(Актуальность) Тогда
	//	Актуальность = НачалоОтправки + 900;
	//КонецЕсли;
	Если обЗначениеНеЗаполнено(НачалоПериодаЗапрета) Тогда
		НачалоПериодаЗапрета = Дата(1, 1, 1, 23, 59, 59);
	КонецЕсли;
	// Семенихин 03.06.2022 -----
КонецПроцедуры // ПередЗаписью()

//Обработчик при записи документа
Процедура ПриЗаписи(Отказ)
	
	Если НЕ дкПриЗаписи(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Входящее_Исходящее = Перечисления.ТипыСообщений.Исходящее Тогда
	КонецЕсли;
	
КонецПроцедуры

//Обработчик перед удалением документа
Процедура ПередУдалением(Отказ)
	Если НЕ дкПередУдалением(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
КонецПроцедуры // ПередУдалением()
	
// Семенихин 30.03.2020 +++++
Функция ПолучитьТелефон(Объект) Экспорт
	Представление = "";
	Представление = киПолучитьПредставлениеКИ(Объект, Справочники.ВидыКонтактнойИнформации.ТелефонСотовый);
	Если ЗначениеЗаполнено(Представление) Тогда Возврат Представление; КонецЕсли;
		
	Представление = киПолучитьПредставлениеКИ(Объект, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	Если ЗначениеЗаполнено(Представление) Тогда Возврат Представление; КонецЕсли;
		
	Представление = киПолучитьПредставлениеКИ(Объект, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
	Если ЗначениеЗаполнено(Представление) Тогда Возврат Представление; КонецЕсли;
	
	Возврат Представление;
КонецФункции

Процедура УдалитьДубликатыТелефонов()
	мТелефоны = Новый Массив();
	мСтрокиДляУдаления = Новый Массив();
	
	Для Каждого СтрокаПолучатель Из Получатели Цикл
		Если мТелефоны.Найти(СтрокаПолучатель.НомерТелефона) = Неопределено Тогда
			мТелефоны.Добавить(СтрокаПолучатель.НомерТелефона);
		Иначе
			мСтрокиДляУдаления.Добавить(СтрокаПолучатель);
		КонецЕсли;		
	КонецЦикла;
	
	Если мСтрокиДляУдаления.Количество() > 0 Тогда
		Для Каждого СтрокаДляУдаления Из мСтрокиДляУдаления Цикл
			Получатели.Удалить(СтрокаДляУдаления);
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры
