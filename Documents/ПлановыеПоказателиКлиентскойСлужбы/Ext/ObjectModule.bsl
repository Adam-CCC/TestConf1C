Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПлановыеПоказателиКлиентскойСлужбы.Ссылка,
	               |	ПлановыеПоказателиКлиентскойСлужбыПоказатели.Менеджер
	               |ИЗ
	               |	Документ.ПлановыеПоказателиКлиентскойСлужбы КАК ПлановыеПоказателиКлиентскойСлужбы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлановыеПоказателиКлиентскойСлужбы.Показатели КАК ПлановыеПоказателиКлиентскойСлужбыПоказатели
	               |		ПО ПлановыеПоказателиКлиентскойСлужбыПоказатели.Ссылка = ПлановыеПоказателиКлиентскойСлужбы.Ссылка
	               |ГДЕ
	               |	ПлановыеПоказателиКлиентскойСлужбы.Проведен
	               |	И ПлановыеПоказателиКлиентскойСлужбы.Дата МЕЖДУ &НачПериода И &КонПериода
	               |	И ПлановыеПоказателиКлиентскойСлужбы.Ссылка <> &Ссылка
	               |	И ПлановыеПоказателиКлиентскойСлужбыПоказатели.Менеджер В(&Менеджер)";
				   
				   
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Менеджер", Показатели.ВыгрузитьКолонку("Менеджер"));
	Запрос.УстановитьПараметр("НачПериода", НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("КонПериода", КонецМесяца(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Сообщить("За " + ПредставлениеПериода(НачалоМесяца(Дата), КонецМесяца(Дата), "ФП = ИСТИНА") + " для менеджера " + Строка(Выборка.Менеджер) + " уже введен документ """ + Выборка.Ссылка + """");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

