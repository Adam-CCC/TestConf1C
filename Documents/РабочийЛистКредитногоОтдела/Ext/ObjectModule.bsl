Процедура ОбработкаПроведения(Отказ, Режим)
 	
	Движения.КомиссионныеВознаграждения.Очистить();
	
	ДосрочноеПогашение = Ложь;
	
	Если ХозОперация = Справочники.ХозОперации.РабочийЛистКредитногоОтдела Тогда
		Попытка
			АвтоТек = ДокументОснование.Автомобиль;
 		Исключение
			АвтоТек = "";
		КонецПопытки; 
	ИначеЕсли ХозОперация = Справочники.ХозОперации.РабочийЛистКредитногоОтделаДосрочноеПогашение Тогда	
		Попытка
			АвтоТек = ДокументОснование.ДокументОснование.Автомобиль;
 		Исключение
			АвтоТек = "";
		КонецПопытки;
 		ДосрочноеПогашение = Истина;
	Иначе
		АвтоТек = "";
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(АвтоТек) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Стр Из Программы Цикл
		
		Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.Одобрен Тогда
			Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.КредитВыдан Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Движение = Движения.КомиссионныеВознаграждения.Добавить();
  		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
 		Движение.Период = Дата;
		Движение.Контрагент = Стр.КредитнаяПрограмма.БанкПартнер.БанкКонтрагент;
		Движение.Автомобиль = АвтоТек;
		Движение.Клиент = Клиент;
		Движение.КредитнаяПрограмма = Стр.КредитнаяПрограмма;
		Движение.Сумма = Стр.КВ;
		
		//Бондаренко++ 20240527
		Прервать;
		//Бондаренко-- 20240527
		
	КонецЦикла;
   
КонецПроцедуры
