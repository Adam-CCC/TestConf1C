Функция ПолучитьТаблицуКредитныхПрограммПоПартнеру(Авто, Модель, БанкПартнер) Экспорт
	
	    ТЗ = Новый ТаблицаЗначений();
	                                                     
		Запрос = Новый Запрос;
		
		Если НЕ обЗначениеНеЗаполнено(Авто) Тогда
			Если АвтомобильСПробегом(Авто) Тогда
 				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				               |	КредитныеПрограммы.Ссылка КАК КредитнаяПрограмма,
				               |	КредитныеПрограммы.ПометкаУдаления КАК ПометкаУдаления,
				               |	КредитныеПрограммы.БуВсе КАК БуВсе,
				               |	КредитныеПрограммы.ЭтоГруппа КАК ЭтоГруппа,
				               |	КредитныеПрограммы.Недействующая КАК Недействующая,
				               |	КредитныеПрограммы.БанкПартнер КАК БанкПартнер,
				               |	КредитныеПрограммы.Директовая КАК Директовая
				               |ИЗ
				               |	Справочник.КредитныеПрограммы КАК КредитныеПрограммы
				               |ГДЕ
				               |	НЕ КредитныеПрограммы.ПометкаУдаления
				               |	И НЕ КредитныеПрограммы.ЭтоГруппа
				               |	И НЕ КредитныеПрограммы.Недействующая
				               |	И КредитныеПрограммы.БуВсе
				               |	И КредитныеПрограммы.БанкПартнер = &БанкПартнер";
				
					Запрос.УстановитьПараметр("БанкПартнер",БанкПартнер);
				
					ТЗ = Запрос.Выполнить().Выгрузить();
			Иначе
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					               |	КредитныеПрограммыМарки.Ссылка КАК КредитнаяПрограмма,
					               |	КредитныеПрограммыМарки.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
					               |	КредитныеПрограммыМарки.Ссылка.ЭтоГруппа КАК ЭтоГруппа,
					               |	КредитныеПрограммыМарки.Ссылка.Недействующая КАК Недействующая,
					               |	КредитныеПрограммыМарки.Ссылка.НовыеОпределенныхМарок КАК Крыж,
					               |	КредитныеПрограммыМарки.МаркаАвтомобиля.Ссылка КАК Марка,
					               |	КредитныеПрограммыМарки.Ссылка.БанкПартнер КАК БанкПартнер,
					               |	КредитныеПрограммыМарки.Ссылка.Директовая КАК Директовая
