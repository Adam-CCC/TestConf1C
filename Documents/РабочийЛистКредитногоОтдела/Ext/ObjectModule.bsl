Функция ПолучитьКомпенсациюБрокерФинанс(Модель,ПрограммаБФ)
	
	КомпБФ_ = 0; 
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.МаркетинговаяПрограмма КАК МаркетинговаяПрограмма,
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.Модель КАК Модель,
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.ВариантКомплектации КАК ВариантКомплектации,
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.РазмерБонуса+ПоказателиМаркетинговыхПрограммСрезПоследних.РазмерБонусаРетро КАК СуммаБонуса
   		|ИЗ
		|	РегистрСведений.ПоказателиМаркетинговыхПрограмм.СрезПоследних КАК ПоказателиМаркетинговыхПрограммСрезПоследних
		|ГДЕ
		|	ПоказателиМаркетинговыхПрограммСрезПоследних.МаркетинговаяПрограмма = &МаркетинговаяПрограмма
		|	И ПоказателиМаркетинговыхПрограммСрезПоследних.Модель = &Модель";
	
 	Запрос.УстановитьПараметр("МаркетинговаяПрограмма", ПрограммаБФ);
	Запрос.УстановитьПараметр("Модель", Модель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		КомпБФ_ = ВыборкаДетальныеЗаписи.СуммаБонуса;
 	КонецЦикла;
	
	Возврат КомпБФ_;
    
КонецФункции
