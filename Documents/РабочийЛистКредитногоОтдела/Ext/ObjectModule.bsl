	Если НЕ дкОбработкаПроведения(ЭтотОбъект, Отказ, Режим) Тогда Возврат; КонецЕсли;
	
	// Проведение по регистру сведений Журнал событий
	Если НЕ Отказ Тогда
		Если НЕ орЖурналСостояний(Ссылка, Статус) Тогда
			Отказ=Истина;
			Возврат;
		КонецЕсли; 
	КонецЕсли;	
	
	// выведем сообщения об ошибках и предупреждениях
	дкВыводРезультатовОбработки(ЭтотОбъект,Отказ);
	
КонецПроцедуры // ОбработкаПроведения()

//Бондаренко++ 20241121
Процедура СМГ_ПриЗаписи()
	
	//Бондаренко++ 20250806
	КредитВыданПоДанномуРЛКО = Ложь;
	//Бондаренко-- 20250806
	РабочийЛистОткорректирован = Ложь;
	
	Если Не обЗначениеНеЗаполнено(ДокументОснование) Тогда
		Если ТипЗНЧ(ДокументОснование) = Тип("ДокументСсылка.РабочийЛист") Тогда
			ДокОснОбъект = ДокументОснование.ПолучитьОбъект();
			Если ТипЗНЧ(Клиент) = Тип("СправочникСсылка.Контрагенты") Тогда
				Если ТипЗНЧ(ДокументОснование.Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
 					ДокОснОбъект.Контрагент = Клиент;
  	 				ДокОснОбъект.Лид = Клиент;
                    РабочийЛистОткорректирован = Истина;
 				КонецЕсли;			
			КонецЕсли;			
			Если СокрЛП(ДокументОснование.КонтактныйТелефон) <> СокрЛП(ПредставлениеТелефона) Тогда
 				ДокОснОбъект.КонтактныйТелефон = СокрЛП(ПредставлениеТелефона);
				ДокОснОбъект.ПредставлениеТелефонаЛида = СокрЛП(ПредставлениеТелефона);
                РабочийЛистОткорректирован = Истина;
			КонецЕсли;
			//Бондаренко++ 20250504 
			
			//Бондаренко++ 20251127
			Если ЕстьДиректоваяПрограмма = Перечисления.ВариантыОтветов.Да Тогда
				Если Не обЗначениеНеЗаполнено(ДокОснОбъект.Автомобиль) Тогда
					Если ДокОснОбъект.Автомобиль.Модель.Марка = Справочники.Марка.CHERY ИЛИ
						ДокОснОбъект.Автомобиль.Модель.Марка = Справочники.Марка.TENET  ИЛИ
						ДокОснОбъект.Автомобиль.Модель.Марка = Справочники.Марка.EXEED ИЛИ
						ДокОснОбъект.Автомобиль.Модель.Марка = Справочники.Марка.OMODA ИЛИ
						ДокОснОбъект.Автомобиль.Модель.Марка = Справочники.Марка.JAECOO Тогда
						Если ДокОснОбъект.ЕстьДиректоваяПрограмма=Ложь Тогда
							ДокОснОбъект.ЕстьДиректоваяПрограмма=Истина;
							РабочийЛистОткорректирован = Истина;
						КонецЕсли;
					Иначе	
						Если ДокОснОбъект.ЕстьДиректоваяПрограмма=Истина Тогда
							ДокОснОбъект.ЕстьДиректоваяПрограмма=Ложь;
							РабочийЛистОткорректирован = Истина;
						КонецЕсли;					
					КонецЕсли;
				Иначе	
					Если ДокОснОбъект.ЕстьДиректоваяПрограмма=Истина Тогда
						ДокОснОбъект.ЕстьДиректоваяПрограмма=Ложь;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;				
				КонецЕсли;	
			Иначе	
				Если ДокОснОбъект.ЕстьДиректоваяПрограмма=Истина Тогда
					ДокОснОбъект.ЕстьДиректоваяПрограмма=Ложь;
					РабочийЛистОткорректирован = Истина;
				КонецЕсли;
