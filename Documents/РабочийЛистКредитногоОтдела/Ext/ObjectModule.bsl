// Обработчик события заполнения
//
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	ХозОперация	= Справочники.ХозОперации.РабочийЛистКредитногоОтдела;	
	
	Если НЕ дкОбработкаЗаполнения(ЭтотОбъект, Основание) Тогда Возврат; КонецЕсли;
	 
	Если ТипЗнч(Основание)=Тип("ДокументСсылка.РабочийЛист") Тогда
		ДокументОснование			= Основание;
		Статус						= Основание.Статус;
		ВалютаДокумента				= Основание.ВалютаДокумента;
		ДатаСделки					= Основание.Дата;
		Клиент						= Основание.Контрагент;
		
		ВидТелефона 				= Основание.ВидТелефона;
		КодРегиона					= Основание.КодРегиона;
		КодГорода					= Основание.КодГорода;	
		НомерТелефона				= Основание.НомерТелефона;
		ВнутреннийНомер				= Основание.ВнутреннийНомер;
		ПредставлениеТелефона		= Основание.ПредставлениеТелефона;	
		
		//Бондаренко++ 20260630
		//МенеджерКредитногоОтдела	= Основание.Менеджер;
		МенеджерКредитногоОтдела	= ПараметрыСеанса.Пользователь.Сотрудник;
		//Бондаренко-- 20260630
		СтоимостьАвтомобиля			= Основание.СуммаПродажи;
 		
		//Бондаренко++ 20240821
  		ТребованиеКПодтверждениюДохода = Перечисления.ТребованияКПодтверждениюДохода.СвободнаяФорма;
		СуммаКредита = СтоимостьАвтомобиля;
		
		//Бондаренко++ 20260728
		Если Не ИспользоватьКалькулятор Тогда
			СуммаСчетаНаАвто = СтоимостьАвтомобиля;
 		КонецЕсли;
		//Бондаренко++ 20260728 
		
		//Бондаренко++ 20260728
		Если Не ИспользоватьКалькулятор Тогда
	 		Если Не обЗначениеНеЗаполнено(ЧистаяСтоимостьАвтомобиля) Тогда
				СуммаСчетаНаАвто = ЧистаяСтоимостьАвтомобиля-ПервоначальныйВзнос; 
	 		КонецЕсли;
		КонецЕсли;
  		//Бондаренко-- 20260728
 		
		ПервоначальныйВзнос = 0;
		СрокКредита = 36;
		ЗаявленныйДоход = 0;
		Статус = Справочники.СтатусыРабочегоЛиста.Консультация;
		
		РублиРФ = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		
		ВалютаДокумента = РублиРФ ;
		КурсДокумента = 1;
		ВалютаУпр = РублиРФ;
		ВалютаЗаявленногоДохода = РублиРФ;
 		 
		Программы.Очистить();
		
		ТЗ = ПолучитьТаблицуКредитныхПрограмм(Основание.Автомобиль,Основание.Модель);
		
		Программы.Загрузить(ТЗ);
		
		Для каждого Стр Из Программы Цикл
			Стр.Статус = Справочники.СтатусыРабочегоЛиста.Заявка; 
 		КонецЦикла;
  		//Бондаренко-- 20240821
	//Бондаренко++ 20260615	
	ИначеЕсли ТипЗнч(Основание)=Тип("ДокументСсылка.РабочийЛистКредитногоОтдела") Тогда	
		ХозОперация = Справочники.ХозОперации.РабочийЛистКредитногоОтделаДосрочноеПогашение;
		Для каждого Стр Из Программы Цикл
			Стр.КВ = -Стр.КВ;
			Стр.УменьшениеПроцентаКВ = Стр.КредитнаяПрограмма.ПроцентКВ;
		КонецЦикла;
		Для каждого Стр Из СтраховыеПродукты Цикл
		    Стр.КВ = -Стр.КВ;
			Стр.УменьшениеПроцентаКВ = Стр.ПроцентКВ;
 		КонецЦикла;
	//Бондаренко-- 20260615		
	КонецЕсли;
		
КонецПроцедуры // ОбработкаЗаполнения()

Функция ПолучитьТаблицуКредитныхПрограмм(Авто, Модель) Экспорт
	
	    ТЗ = Новый ТаблицаЗначений();
	
		Запрос = Новый Запрос;
		
		Если НЕ обЗначениеНеЗаполнено(Авто) Тогда
			Если АвтомобильСПробегом(Авто) Тогда
 				Запрос = Новый Запрос;
				Запрос.Текст = "ВЫБРАТЬ
				               |	КредитныеПрограммы.Ссылка КАК КредитнаяПрограмма,
				               |	КредитныеПрограммы.ПометкаУдаления КАК ПометкаУдаления,
