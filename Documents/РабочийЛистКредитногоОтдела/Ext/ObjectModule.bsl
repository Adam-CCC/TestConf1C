// Обработчик события перед записью
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если НЕ дкПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда Возврат; КонецЕсли;
	
	//Бондаренко++ 20250503
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;		
	КонецЕсли;
	//Бондаренко-- 20250503 
	
	//Бондаренко++ 20250925
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		//Бондаренко++ 20260623
		Если НЕ обЗначениеНеЗаполнено(ДокументОснование) Тогда
			Если ТипЗНЧ(ДокументОснование) = Тип("ДокументСсылка.РабочийЛист") Тогда
				ЕстьДублиРЛКО = ПроверитьНаДублиРЛКО(ДокументОснование);
				Если ЕстьДублиРЛКО Тогда
 					СМГ_Сообщить("Ошибка! Есть дубли РЛКО. Текущий документ не может быть записан.",СтатусСообщения.ОченьВажное);
					Если НЕ РольДоступна("ПолныеПрава") Тогда	
						Отказ = Истина;
						Возврат;
 					КонецЕсли;
				КонецЕсли;
				//Бондаренко++ 20260820
				Если НЕ обЗначениеНеЗаполнено(ДокументОснование.Автомобиль) Тогда
					Если НЕ обЗначениеНеЗаполнено(КредитнаяПрограмма) Тогда
						Если КредитнаяПрограмма.Директовая Тогда
							Если ДокументОснование.Автомобиль.ДиректовыеПрограммыЗапрещены Тогда
								СМГ_Сообщить("Ошибка! У автомобиля установлен флаг <Директовые программы запрещены>.",СтатусСообщения.ОченьВажное);
								Если НЕ РольДоступна("ПолныеПрава") Тогда	
									Отказ = Истина;
									Возврат;
								КонецЕсли;
							КонецЕсли;
							ДиректоваяПрограммаДо_ = ДокументОснование.Автомобиль.ДиректоваяПрограммаДо;
							Если ДиректоваяПрограммаДо_ <> Дата(1,1,1) Тогда
								Если ДатаВыдачиКредита >= ДиректоваяПрограммаДо_ Тогда
									ДатаВыдачиКредита_стр     = СокрЛП(Формат(ДатаВыдачиКредита,"ДЛФ=DD"));
									ДиректоваяПрограммаДо_стр = СокрЛП(Формат(ДиректоваяПрограммаДо_,"ДЛФ=DD"));
									СМГ_Сообщить("Ошибка! <Дата выдачи кредита> = "+
												 ДатаВыдачиКредита_стр+
												 " и больше (либо равна) реквизиту <Директовая программа до> = "+
												 ДиректоваяПрограммаДо_стр+", это недопустимо.",СтатусСообщения.ОченьВажное);
									Если НЕ РольДоступна("ПолныеПрава") Тогда	
										Отказ = Истина;
										Возврат;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				//Бондаренко-- 20260820
			КонецЕсли;
		КонецЕсли;
		//Бондаренко-- 20260623
	КонецЕсли;
	//Бондаренко-- 20250925
	
	//Бондаренко++ 20250805
	Для каждого Стр Из СтраховыеПродукты Цикл
	    Если Стр.Наличные Тогда
			Если Стр.НапрямуюВСК Тогда
			    СМГ_Сообщить("Ошибка! В строке "+Стр.НомерСтроки+" включены флаги ""Наличные"" и ""Напрямую в СК"".",СтатусСообщения.ОченьВажное);
				Отказ = Истина;
				Возврат;
			КонецЕсли;
 		КонецЕсли;
	КонецЦикла;
	//Бондаренко-- 20250805
	
	//Бондаренко++ 20241221
	КредитОдобрен = Справочники.СтатусыРабочегоЛиста.Одобрен;
	КредитВыдан = Справочники.СтатусыРабочегоЛиста.КредитВыдан;
	Если Статус = КредитОдобрен ИЛИ Статус = КредитВыдан Тогда 
		//Бондаренко++ 20260623
		Если ИспользоватьКалькулятор Тогда
 			//Бондаренко-- 20260623
			Если ЕжемесячныйПлатеж = 0 Тогда
				СМГ_Сообщить("Ошибка! Не заполнен ежемесячный платеж!",СтатусСообщения.ОченьВажное);
				Отказ = Истина;
			КонецЕсли;
			Если ПроцентнаяСтавка = 0 Тогда
				СМГ_Сообщить("Ошибка! Не заполнена процентная ставка!",СтатусСообщения.ОченьВажное);
				Отказ = Истина;
			КонецЕсли;
			Если СрокКредита = 0 Тогда
				СМГ_Сообщить("Ошибка! Не заполнен срок кредита!",СтатусСообщения.ОченьВажное);
				Отказ = Истина;
			КонецЕсли;
			//Бондаренко++ 20260623
 		КонецЕсли;	
		//Бондаренко-- 20260623
	КонецЕсли;	
	//Бондаренко-- 20241221
	
	//Бондаренко++ 20250503
	СчетчикОшибок = 0;
	СтрОшибок = "";
	
	Для каждого Стр Из Программы Цикл
		//Бондаренко++ 20250905
		//Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.КредитВыдан Тогда
		Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.КредитВыдан Тогда 
			Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.Одобрен Тогда	
		//Бондаренко++ 20250905		
				Продолжить;
			КонецЕсли; 
		КонецЕсли;
 		СчетчикОшибок = СчетчикОшибок + 1;
		Если СтрОшибок = "" Тогда
			СтрОшибок = СокрЛП(Стр.НомерСтроки);
  		Иначе
			СтрОшибок = СокрЛП(СтрОшибок)+","+Стр.НомерСтроки;
		КонецЕсли;
	КонецЦикла;
	
	Если СчетчикОшибок >= 2 Тогда
	    СМГ_Сообщить("ОШИБКА! Кредит выдан и/или одобрен в строках "+СтрОшибок,СтатусСообщения.ОченьВажное);
		Отказ = Истина;
 	КонецЕсли;
	//Бондаренко-- 20250503
	
		
	//Бондаренко++ 20250807
	Если Не Отказ Тогда
		СМГ_ПередЗаписью();
 	КонецЕсли;
 	//Бондаренко-- 20250807
 	
КонецПроцедуры // ПередЗаписью()

//Бондаренко-- 20250807
Процедура СМГ_ПередЗаписью()	
	Если Не обЗначениеНеЗаполнено(КредитнаяПрограмма) Тогда
		КредитнаяПрограмма = "";
 	КонецЕсли;

	Если Не обЗначениеНеЗаполнено(Банк) Тогда
		Банк = "";
	КонецЕсли;
	
	Если Не обЗначениеНеЗаполнено(БанкПартнер) Тогда
		БанкПартнер = "";
	КонецЕсли;
	
	Для каждого Стр Из Программы Цикл
		
		//Бондаренко++ 20250905
		//Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.КредитВыдан Тогда
		Если (Стр.Статус <> Справочники.СтатусыРабочегоЛиста.КредитВыдан) И ( Стр.Статус <> Справочники.СтатусыРабочегоЛиста.Одобрен ) Тогда	
		//Бондаренко-- 20250905	
			Продолжить;
		КонецЕсли; 	
		
		Если Статус <> Стр.Статус Тогда
			Статус = Стр.Статус;
		КонецЕсли;
		Если КредитнаяПрограмма <> Стр.КредитнаяПрограмма Тогда
			КредитнаяПрограмма = Стр.КредитнаяПрограмма;
		КонецЕсли;
		Если Банк <> Стр.КредитнаяПрограмма.Банк Тогда
			Банк = Стр.КредитнаяПрограмма.Банк;
		КонецЕсли;
		Если БанкПартнер <> Стр.КредитнаяПрограмма.БанкПартнер Тогда
			БанкПартнер = Стр.КредитнаяПрограмма.БанкПартнер;
		КонецЕсли;
		
		Прервать;
		
	КонецЦикла;
	
	//Бондаренко++ 20260429
	Если обЗначениеНеЗаполнено(ЭтотОбъект.СМ_Создатель) Тогда
 		Попытка ЭтотОбъект.СМ_Создатель = ПараметрыСеанса.Пользователь;	Исключение КонецПопытки;	
  	КонецЕсли;
	Если обЗначениеНеЗаполнено(ЭтотОбъект.СМ_ДатаСоздания) Тогда
		Попытка ЭтотОбъект.СМ_ДатаСоздания = ТекущаяДата();	Исключение КонецПопытки; 
	КонецЕсли;
	Если НЕ обЗначениеНеЗаполнено(ЭтотОбъект.ДокументОснование) Тогда
		Если ТипЗНЧ(ЭтотОбъект.ДокументОснование) = Тип("ДокументСсылка.РабочийЛист") Тогда
			Попытка ЭтотОбъект.Марка = ЭтотОбъект.ДокументОснование.Автомобиль.Модель.Марка;	Исключение КонецПопытки;	
			Попытка ЭтотОбъект.Марка = ЭтотОбъект.ДокументОснование.Модель.Марка;	Исключение КонецПопытки;
		Иначе
			ЭтотОбъект.Марка = "";
		КонецЕсли;
 	Иначе
		ЭтотОбъект.Марка = "";
 	КонецЕсли;
    //Бондаренко-- 20260429
  
КонецПроцедуры //СМГ_ПередЗаписью()
