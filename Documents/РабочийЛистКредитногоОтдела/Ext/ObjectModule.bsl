// Возвращает структуру обязательных / уникальных реквизитов документа
// Возвращаемая структура содержит строковые идентификаторы реквизитов или вложенные структуры для табличных частей
// Для реквизита значение структуры содержит число 1-Обязательный, 2-Уникальный, 3-Уникальный и обязательный
Функция ПолучитьОбязательныеРеквизиты() Экспорт
	
	// Обязательные реквизиты документа
	ОбязательныеРеквизиты=Новый Структура();
	ОбязательныеРеквизиты.Вставить("Автор",1);
	ОбязательныеРеквизиты.Вставить("ПодразделениеКомпании",1);
	ОбязательныеРеквизиты.Вставить("Организация",1);	
	ОбязательныеРеквизиты.Вставить("МенеджерКредитногоОтдела",1);
	ОбязательныеРеквизиты.Вставить("Клиент",1);
	ОбязательныеРеквизиты.Вставить("ПредставлениеТелефона",1);
	//Бондаренко++ 20240810
	//ОбязательныеРеквизиты.Вставить("Банк",1);
	//Бондаренко-- 20240810
	ОбязательныеРеквизиты.Вставить("ВалютаДокумента",1);
	ОбязательныеРеквизиты.Вставить("СтоимостьАвтомобиля",1);
	
	//Бондаренко++ 20250802
	//ОбязательныеРеквизиты.Вставить("ПервоначальныйВзнос",1);
	Если НЕ БезПервоначальногоВзноса Тогда
		ОбязательныеРеквизиты.Вставить("ПервоначальныйВзнос",1);
	КонецЕсли;
	//Бондаренко-- 20250802
	
 	ОбязательныеРеквизиты.Вставить("СуммаКредита",1);
	ОбязательныеРеквизиты.Вставить("СрокКредита",1);
	//Бондаренко++ 20240810
	//ОбязательныеРеквизиты.Вставить("ПроцентнаяСтавка",1);
	//Бондаренко-- 20240810
	//Бондаренко++ 20260707
	//ОбязательныеРеквизиты.Вставить("ЗаявленныйДоход",1);
	//Бондаренко++ 20260707
	ОбязательныеРеквизиты.Вставить("ВалютаЗаявленногоДохода",1);
	ОбязательныеРеквизиты.Вставить("ТребованиеКПодтверждениюДохода",1);
	ОбязательныеРеквизиты.Вставить("Статус",1);
	
	//Бондаренко++ 20260724
	Если СтраховыеПродукты.Количество() > 0 Тогда
		Если Дата > Дата(2026,7,23) Тогда
			ОбязательныеСтраховыеПродукты=Новый Структура();
			ОбязательныеСтраховыеПродукты.Вставить("ВариантОплаты",1);
	 		ОбязательныеРеквизиты.Вставить("СтраховыеПродукты",ОбязательныеСтраховыеПродукты);
		КонецЕсли;
 	КонецЕсли;
	//Бондаренко-- 20260724
	
	Возврат ОбязательныеРеквизиты;
КонецФункции // ПолучитьОбязательныеРеквизиты()

// Проверяет корректность заполнения объекта.
// может управляться булевыми флагами выполняемых проверок Заполнение, Уникальность
// (могут быть и другие необязательные)
// Обычно выполняется универсальным обработчиком, но могут быть добавлены доп. проверки
//
// Параметры:
//  Ошибки       - строка, в случае некорректного заполнения содержит описанием возникших ошибок, 
//  ДопРеквизиты - структура, на вход может быть передана структура с дополнительными реквизитами для проверки,
//  Заполнение   - булево, флаг проверки, 
//  Уникальность - булево, флаг проверки.
//
// Возвращаемое значение:
//  Булево - Возвращает Истина если все заполнено корректно и Ложь иначе.
// 
Функция ПроверитьКорректность(Ошибки="", ДопРеквизиты=Неопределено, Заполнение=Истина, Уникальность=Истина) Экспорт
	Результат = дкПроверитьКорректность(ЭтотОбъект, Ошибки, ДопРеквизиты, Заполнение, Уникальность);
	Возврат Результат;	
КонецФункции // ПроверитьКорректность()
 
// Функция проверяет, допустимо ли изменение объекта
//
// Параметры:
//  БлокироватьРеквизиты - структура, структура блокируемых на изменение реквизитов.
//
// Возвращаемое значение:
// Булево - Возвращает Истина, если изменения возможны, ложь иначе
//          Если изменения доступны частично, возвращает ложь и структуру блокируемых на изменение реквизитов.
//
Функция ДоступностьИзменения(БлокироватьРеквизиты=Неопределено) Экспорт
    // Здесь может быть прописано определение наличия ссылок, блокирующих изменение объекта
	Возврат Истина;
КонецФункции // ДоступностьИзменения()

// Возвращает список возможных хозяйственных операций документа
// Вовращаемое значение: 
//  СписокЗначений. 
//  Строка списка: Значение - имя предопределенного элемента; 
//				   Представление - красивое его представление
// 				   "Помеченная" строка - ХО по умолчанию.
Функция ПолучитьСписокХозОпераций() Экспорт
	СписокХозОпераций = Новый СписокЗначений;               
	СписокХозОпераций.Добавить("РабочийЛистКредитногоОтдела","Рабочий лист кредитного отдела",Истина);
	//Бондаренко++ 20260615
	СписокХозОпераций.Добавить("РабочийЛистКредитногоОтделаДосрочноеПогашение","Рабочий лист кредитного отдела Досрочное погашение",Истина);
 	//Бондаренко-- 20260615
	Возврат СписокХозОпераций;
КонецФункции // ПолучитьСписокХозОпераций()

// Обработка изменения реквизитов документа
// Параметры
//  Имя			– Строка			– Имя реквизита документа с полным путем (например Тавары.Номенклатура).
//  ЭтаФорма	– Форма				– Ссылка на форму документа. Если значение неопределено, производится программная обработка реквизитов.
//  ТекСтрока	– СтрокаТабличнойЧасти – Ссылка на строку табличной части документа, реквизит которой обрабатывается.
//										 Имеет смысл только для табличных частей документов.
//  ДопПараметры– Стркутура			– Структура, содержащая дополнительные параметры обработки реквизита.
// Возвращаемое значение:
//   Булево   – Результат выполнения обработки.
Функция ОбработкаРеквизита(Имя,ТекСтрока=Неопределено,ЭтаФорма=Неопределено,ДопПараметры=Неопределено) Экспорт
	
	Если Имя="Клиент" Тогда
		Результат	= дкОбработкаРеквизита(ЭтотОбъект,Имя,ТекСтрока,ЭтаФорма,ДопПараметры);
		
		#Если Клиент Тогда
		КодРегиона = "";
		КодГорода = "";
		НомерТелефона = "";
		ВнутреннийНомер = "";
		ПредставлениеТелефона = "";
		ВидТелефона = Неопределено;
		Если ЗначениеЗаполнено(Клиент) Тогда
			Телефоны = киПолучитьСписокТелефоновОбъекта(Клиент);
			Если Телефоны<>Неопределено И Телефоны.Количество()>0 Тогда
				ЗаполнитьЗначенияСвойств(ЭтотОбъект,Телефоны[0].Значение);
			КонецЕсли;
		КонецЕсли; 
		#КонецЕсли
		
		Возврат Результат;
	//Бондаренко++ 20260613	
	ИначеЕсли Имя="ИспользоватьКалькулятор"	 Тогда
		// 
	//Бондаренко++ 20260721	
	ИначеЕсли Имя="Госпрограмма" Тогда
	    //Бондаренко++ 20260722
	    Если Госпрограмма Тогда
			Если СемейнаяГосПрограмма Тогда
 				СемейнаяГосПрограмма = Ложь;
			КонецЕсли;
 		КонецЕсли;
		//Бондаренко-- 20260722
		Для каждого СтрКредит Из Программы Цикл
			Если СтрКредит.Статус = Справочники.СтатусыРабочегоЛиста.КредитВыдан ИЛИ СтрКредит.Статус = Справочники.СтатусыРабочегоЛиста.Одобрен Тогда	
				ОбработкаРеквизита("Статус",СтрКредит,ЭтаФорма,);	
			КонецЕсли;
		КонецЦикла;
	//Бондаренко-- 20260721
	//Бондаренко++ 20260722
	ИначеЕсли Имя="СемейнаяГоспрограмма" Тогда
	    Если СемейнаяГосПрограмма Тогда
			Если ГосПрограмма Тогда
 				ГосПрограмма = Ложь;
			КонецЕсли;
 		КонецЕсли;
		Для каждого СтрКредит Из Программы Цикл
			Если СтрКредит.Статус = Справочники.СтатусыРабочегоЛиста.КредитВыдан ИЛИ СтрКредит.Статус = Справочники.СтатусыРабочегоЛиста.Одобрен Тогда	
				ОбработкаРеквизита("Статус",СтрКредит,ЭтаФорма,);	
			КонецЕсли;
		КонецЦикла;
	//Бондаренко-- 20260722
	//Бондаренко++ 20260613		
	ИначеЕсли Имя="КредитнаяПрограмма" Тогда
		//Бондаренко++ 20260620
		Если Не обЗначениеНеЗаполнено(ТекСтрока.КредитнаяПрограмма) Тогда
			ТекСтрока.БанкКонтрагентНаименование = ТекСтрока.КредитнаяПрограмма.БанкПартнер.Наименование;
			ТекСтрока.Директовая = ТекСтрока.КредитнаяПрограмма.Директовая;
		Иначе	
		    ТекСтрока.БанкКонтрагентНаименование = "";
			ТекСтрока.Директовая = Ложь;
		КонецЕсли;
		//Бондаренко-- 20260620
  		ОбработкаРеквизита("Статус",ТекСтрока,ЭтаФорма,);
 	ИначеЕсли Имя="Банк" Тогда
		Если НЕ обЗначениеНеЗаполнено(Банк) И
			НЕ обЗначениеНеЗаполнено(КредитнаяПрограмма) И
			Банк<>КредитнаяПрограмма.Банк Тогда
			КредитнаяПрограмма	= Справочники.КредитныеПрограммы.ПустаяСсылка();
		КонецЕсли;
	//Бондаренко++ 20260620	
	ИначеЕсли Имя="Программы.УменьшениеПроцентаКВ" Тогда
		Если ТекСтрока.УменьшениеПроцентаКВ > ТекСтрока.КредитнаяПрограмма.ПроцентКВ Тогда
			ТекСтрока.УменьшениеПроцентаКВ = ТекСтрока.КредитнаяПрограмма.ПроцентКВ;	
 		КонецЕсли;
 		ОбработкаРеквизита("Статус",ТекСтрока,ЭтаФорма);
 	//Бондаренко-- 20260620
	//Бондаренко++ 20260819
	ИначеЕсли Имя = "ДатаВыдачиКредита" Тогда
		Если НЕ ( ТекСтрока.Статус = Справочники.СтатусыРабочегоЛиста.КредитВыдан ИЛИ ТекСтрока.Статус = Справочники.СтатусыРабочегоЛиста.Одобрен ) Тогда
  			ТекСтрока.ДатаВыдачиКредита = Дата(1,1,1);
 		КонецЕсли;		
		ДатаВыдачиКредита = ТекСтрока.ДатаВыдачиКредита ;
 	//Бондаренко-- 20260819	
	ИначеЕсли Имя="Статус" Тогда	
 		Если ТекСтрока.Статус = Справочники.СтатусыРабочегоЛиста.КредитВыдан ИЛИ ТекСтрока.Статус = Справочники.СтатусыРабочегоЛиста.Одобрен Тогда	
		//Бондаренко++ 20250905	
			ТекСтрока.КВ = РассчитатьКВ(ТекСтрока.КредитнаяПрограмма,ТекСтрока.УменьшениеПроцентаКВ);
			//Бондаренко++ 20250806
			КредитнаяПрограмма = ТекСтрока.КредитнаяПрограмма;
			//Бондаренко-- 20250806
			//Бондаренко++ 20260819
			ТекСтрока.ДатаВыдачиКредита = ТекущаяДата();
			//Бондаренко-- 20260819
		Иначе
			ТекСтрока.КВ = 0;	
			//Бондаренко++ 20250806
			КредитнаяПрограмма = "";
			//Бондаренко-- 20250806
			//Бондаренко++ 20260819
			ТекСтрока.ДатаВыдачиКредита = "";
			//Бондаренко-- 20260819
		КонецЕсли;
	//Бондаренко-- 20250503 
	//Бондаренко++ 20260425	
 	ИначеЕсли Имя="СтраховыеПродукты.ПрограммаСтрахования" Тогда
	    Если ТекСтрока.СтраховаяКомпания <> ТекСтрока.ПрограммаСтрахования.Партнер Тогда
			ТекСтрока.СтраховаяКомпания = ТекСтрока.ПрограммаСтрахования.Партнер;
		КонецЕсли;
		//Бондаренко++ 20260615
		//Бондаренко++ 20260620
		Если ТекСтрока.ПроцентКВ <> ТекСтрока.ПрограммаСтрахования.Вознаграждение Тогда
			ТекСтрока.ПроцентКВ = ТекСтрока.ПрограммаСтрахования.Вознаграждение;
		КонецЕсли;
		Если Не обЗначениеНеЗаполнено(ТекСтрока.Тариф) Тогда
			ТекСтрока.Тариф = "";
 		КонецЕсли;
 		//Бондаренко-- 20260620
		ОбработкаРеквизита("СтраховыеПродукты.СуммаСтрахования",ТекСтрока,ЭтаФорма,ДопПараметры);
		//Бондаренко-- 20260615
 	//Бондаренко-- 20260425
	ИначеЕсли Имя = "СтраховыеПродукты.АгентПодразделение" Тогда
		Если Не обЗначениеНеЗаполнено(ТекСтрока.АгентПодразделение) Тогда
			ЕстьПодчиненные = Справочники.ПодразделенияКомпании.СМГ_ЕстьПодчиненныеПодразделения(ТекСтрока.АгентПодразделение);
			Если ЕстьПодчиненные Тогда
				СМГ_Сообщить("ОШИБКА! Запрещено использовать подразделение """+СокрЛП(ТекСтрока.АгентПодразделение)+""" из группы """+СокрЛП(ТекСтрока.АгентПодразделение.Родитель)+""".",СтатусСообщения.ОченьВажное);
				ТекСтрока.АгентПодразделение = "";
			КонецЕсли;
			//Бондаренко++ 20250712
			//Если обЗначениеНеЗаполнено(ТекСтрока.СтраховаяКомпания) Тогда
			//	ТекСтрока.СтраховаяКомпания = Справочники.БанкиЛкПартнеры.НайтиПоРеквизиту("БанкКонтрагент",ТекСтрока.ПрограммаСтрахование.СтраховаяКомпания);
			//КонецЕсли;
			//Если НЕ обЗначениеНеЗаполнено(ТекСтрока.АгентПодразделение) Тогда 
			//	Если НЕ обЗначениеНеЗаполнено(ТекСтрока.СтраховаяКомпания) Тогда	
			//	ТекСтрока.ДоговорКв = НайтиСоздатьДоговорПрочий(ТекСтрока.АгентПодразделение,ТекСтрока.СтраховаяКомпания.БанкКонтрагент);
			//КонецЕсли;
			//КонецЕсли;
			//Бондаренко++ 20250712
		КонецЕсли;	
		//Бондаренко++ 20250821	
	ИначеЕсли Имя = "ПрограммаБрокерФинанс" Тогда
		Если Не обЗначениеНеЗаполнено(ПрограммаБрокерФинанс) Тогда  
			Если Не обЗначениеНеЗаполнено(ДокументОснование.Автомобиль) Тогда  
				Если Не обЗначениеНеЗаполнено(ДокументОснование.Автомобиль.Модель) Тогда
					КомпенсацияБрокерФинанс = ПолучитьКомпенсациюБрокерФинанс(ДокументОснование.Автомобиль.Модель,ПрограммаБрокерФинанс);
					ВариантБрокерФинанс = Перечисления.ВариантыОтветов.Да;
				КонецЕсли;	
			КонецЕсли;	
		Иначе
			ВариантБрокерФинанс = Перечисления.ВариантыОтветов.Нет;
			КомпенсацияБрокерФинанс = 0;
		КонецЕсли;
		//Бондаренко-- 20250821
		//Бондаренко++ 20260424
	ИначеЕсли Имя = "СтраховыеПродукты.Тариф" Тогда
		Если ТекСтрока.Тариф > 0 Тогда
			ТекСтрока.ПроцентКВ = НайтиПроцентКВ(ТекСтрока.ПрограммаСтрахования,ДокументОснование.Автомобиль.Модель.Марка,ТекСтрока.Тариф);
		Иначе	
			//Бондаренко++ 20260620
			ТекСтрока.ПроцентКВ = 0;
			Если НЕ обЗначениеНеЗаполнено(ТекСтрока.ПрограммаСтрахования) Тогда
				ТекСтрока.ПроцентКВ = ТекСтрока.ПрограммаСтрахования.Вознаграждение;
			Иначе
				ТекСтрока.ПроцентКВ = 0;
			//	Если ТекСтрока.УменьшениеПроцентаКВ > 0 Тогда
			//		ТекСтрока.УменьшениеПроцентаКВ = 0;
			//КонецЕсли;
  			КонецЕсли;
 			//Бондаренко-- 20260620
		КонецЕсли;
		ОбработкаРеквизита("СтраховыеПродукты.СуммаСтрахования",ТекСтрока,ЭтаФорма);
	ИначеЕсли Имя = "СтраховыеПродукты.СуммаСтрахования" Тогда	
		Если ТекСтрока.ПроцентКВ > 0 Тогда
			//Бондаренко++ 20260616
			//ТекСтрока.КВ = ТекСтрока.СуммаСтрахования * ТекСтрока.ПроцентКВ / 100;
			ТекСтрока.КВ = ТекСтрока.СуммаСтрахования * ( ТекСтрока.ПроцентКВ - ТекСтрока.УменьшениеПроцентаКВ ) / 100;
		Иначе	
			//ТекСтрока.КВ = ТекСтрока.СуммаСтрахования * ТекСтрока.ПрограммаСтрахования.Вознаграждение / 100; 
			ТекСтрока.КВ = ТекСтрока.СуммаСтрахования * ( ТекСтрока.ПрограммаСтрахования.Вознаграждение - ТекСтрока.УменьшениеПроцентаКВ )  / 100; 
			//Бондаренко-- 20260616
		КонецЕсли; 
		//Бондаренко++ 20260724
		Пересчет();
		//Бондаренко-- 20260724
  		//Бондаренко++ 20260616
	ИначеЕсли Имя = "СтраховыеПродукты.УменьшениеПроцентаКВ" Тогда	        
		Если ТекСтрока.ПроцентКВ > 0 Тогда
 			ТекСтрока.КВ = ТекСтрока.СуммаСтрахования * (ТекСтрока.ПроцентКВ - ТекСтрока.УменьшениеПроцентаКВ) / 100;
  		Иначе	
			ТекСтрока.КВ = ТекСтрока.СуммаСтрахования * ТекСтрока.ПрограммаСтрахования.Вознаграждение / 100; 
		КонецЕсли;
		//Бондаренко-- 20260616
	//Бондаренко++ 20260724
	ИначеЕсли Имя = "СтраховыеПродукты.ВариантОплаты" Тогда	        
		Если ТекСтрока.ВариантОплаты = Перечисления.ВариантыОплатыСтраховыхПрограмм.ВКредит Тогда
 			ТекСтрока.Наличные = Ложь;
			ТекСтрока.НапрямуюВСК = Ложь;
		ИначеЕсли ТекСтрока.ВариантОплаты = Перечисления.ВариантыОплатыСтраховыхПрограмм.Наличные Тогда	
 			ТекСтрока.Наличные = Истина;
			ТекСтрока.НапрямуюВСК = Ложь;
		ИначеЕсли ТекСтрока.ВариантОплаты = Перечисления.ВариантыОплатыСтраховыхПрограмм.НапрямуюВСК Тогда		
 			ТекСтрока.Наличные = Ложь;
			ТекСтрока.НапрямуюВСК = Истина;
		КонецЕсли;    
		Пересчет();
		//Бондаренко-- 20260724
	Иначе	
		Возврат дкОбработкаРеквизита(ЭтотОбъект,Имя,ТекСтрока,ЭтаФорма,ДопПараметры);
	КонецЕсли;		
	
КонецФункции // ОбработкаРеквизита()

