Функция НайтиПроцентКВ(ПрограммаСтрах,МаркаАвто,ТарифТек)
	
	Рез_ = 0;
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоказателиПрограммСтрахованияСрезПоследних.ПрограммаСтрахования КАК ПрограммаСтрахования,
		|	ПоказателиПрограммСтрахованияСрезПоследних.Марка КАК Марка,
		|	ПоказателиПрограммСтрахованияСрезПоследних.Тариф КАК Тариф,
		|	ПоказателиПрограммСтрахованияСрезПоследних.КВ КАК ПроцентКВ
		|ИЗ
		|	РегистрСведений.ПоказателиПрограммСтрахования.СрезПоследних(&Дата, ) КАК ПоказателиПрограммСтрахованияСрезПоследних
		|ГДЕ
		|	ПоказателиПрограммСтрахованияСрезПоследних.ПрограммаСтрахования = &ПрограммаСтрахования
		|	И ПоказателиПрограммСтрахованияСрезПоследних.Марка = &Марка
		|	И ПоказателиПрограммСтрахованияСрезПоследних.Тариф = &Тариф";
	
	Запрос.УстановитьПараметр("Марка", МаркаАвто);
	Запрос.УстановитьПараметр("ПрограммаСтрахования", ПрограммаСтрах);
	Запрос.УстановитьПараметр("Тариф", ТарифТек);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() > 0 Тогда
		Рез_ = ТЗ[0].ПроцентКВ;
 	КонецЕсли;
  	
 	Возврат Рез_;

КонецФункции // НайтиПроцентКВ()
