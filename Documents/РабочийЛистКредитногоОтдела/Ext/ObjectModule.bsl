Функция РассчитатьКВ(КредитнаяПрограмма,УменьшениеПроцентаКВ) Экспорт
	
	КВ = 0;
	
	Если КредитнаяПрограмма.ВариантРассчетаКВ = Перечисления.ВариантыРассчетаКВ.ОтСуммыКредита Тогда
		БазаРасчета = СуммаКредита;
 		Если СообщатьОрасчетеКВ Тогда
			СМГ_Сообщить("1). Расчёт от суммы кредита -> СуммаКредита ("+СуммаКредита+"). БазаРасчета = "+БазаРасчета);
		КонецЕсли;
 		КВ = БазаРасчета * ( КредитнаяПрограмма.ПроцентКВ - УменьшениеПроцентаКВ) / 100;
	ИначеЕсли КредитнаяПрограмма.ВариантРассчетаКВ = Перечисления.ВариантыРассчетаКВ.ОтСтоимостиАвтомобиля Тогда
		Если Госпрограмма Тогда
			БазаРасчета = ЧистаяСтоимостьАвтомобиля * 0.8  - ПервоначальныйВзнос;
 			Если СообщатьОрасчетеКВ Тогда
 				СМГ_Сообщить("2б). Расчёт от чистой стоимости автомобиля * 0.8 => ЧистаяСтоимостьАвтомобиля ("+ЧистаяСтоимостьАвтомобиля+" / ЧистаяСтоимостьАвтомобиля * 0.8 ("+СокрЛП(ЧистаяСтоимостьАвтомобиля*0.8)+") - ПервоначальныйВзнос("+ПервоначальныйВзнос+"). БазаРасчета = "+БазаРасчета);
			КонецЕсли;
 		ИначеЕсли СемейнаяГоспрограмма Тогда
			БазаРасчета = ЧистаяСтоимостьАвтомобиля * 0.9  - ПервоначальныйВзнос;
 			Если СообщатьОрасчетеКВ Тогда
				СМГ_Сообщить("2в). Расчёт от чистой стоимости автомобиля * 0.9 => ЧистаяСтоимостьАвтомобиля ("+ЧистаяСтоимостьАвтомобиля+" / ЧистаяСтоимостьАвтомобиля * 0.9 ("+СокрЛП(ЧистаяСтоимостьАвтомобиля*0.9)+") - ПервоначальныйВзнос("+ПервоначальныйВзнос+"). БазаРасчета = "+БазаРасчета);
			КонецЕсли;
  		Иначе
			БазаРасчета = ЧистаяСтоимостьАвтомобиля  - ПервоначальныйВзнос;
 			Если СообщатьОрасчетеКВ Тогда
				СМГ_Сообщить("2а). Расчёт от чистой стоимости автомобиля => ЧистаяСтоимостьАвтомобиля ("+ЧистаяСтоимостьАвтомобиля+") - ПервоначальныйВзнос("+ПервоначальныйВзнос+"). БазаРасчета = "+БазаРасчета);
			КонецЕсли;
		КонецЕсли;
		КВ = БазаРасчета * ( КредитнаяПрограмма.ПроцентКВ - УменьшениеПроцентаКВ) / 100;
	Иначе
		КВ = 0;
	КонецЕсли;
	
	//Бондаренко++ 20260722
	Если ХранимаяБазаРасчета <> БазаРасчета Тогда
		ХранимаяБазаРасчета = БазаРасчета;
 	КонецЕсли;
	//Бондаренко-- 20260722
	
	Возврат КВ;

КонецФункции // РассчитатьКВ(КредитнаяПрограмма)

Процедура Пересчет() Экспорт
	//БылПеречет = Ложь;
	СуммаСтраховок_ = 0;
	Для каждого Стр Из СтраховыеПродукты Цикл
		Если Стр.Наличные Тогда
			Продолжить;
		КонецЕсли;
		//Бондаренко++ 20250805
		Если Стр.НапрямуюВСК Тогда
			Продолжить;
		КонецЕсли;
		//Бондаренко-- 20250805
		СуммаСтраховок_ =    СуммаСтраховок_ + Стр.СуммаСтрахования;
	КонецЦикла;
	Если СуммаСтраховыхПродуктовВКредит <> СуммаСтраховок_ Тогда
		СуммаСтраховыхПродуктовВКредит = СуммаСтраховок_;
		//БылПеречет = Истина;
	КонецЕсли;
	//Бондаренко++ 20260619
	//СтоимостьАвтомобиля_ = ЧистаяСтоимостьАвтомобиля + СуммаПродуктовБанка + СуммаСтраховыхПродуктовВКредит;
	СтоимостьАвтомобиля_ = ЧистаяСтоимостьАвтомобиля + СуммаПродуктовБанка + СуммаСтраховыхПродуктовВКредит + СуммаДопоборудования;
	//Бондаренко-- 20260619
	Если СтоимостьАвтомобиля <> СтоимостьАвтомобиля_ Тогда
		СтоимостьАвтомобиля = СтоимостьАвтомобиля_;
	КонецЕсли;
	//Бондаренко++ 20260724
	//Бондаренко++ 20260725
	Если ИспользоватьКалькулятор Тогда
		СуммаКредита = 0;		
		ЕжемесячныйПлатеж = 0;
	Иначе
		СуммаКредита = СтоимостьАвтомобиля-ПервоначальныйВзнос;			
		ЕжемесячныйПлатеж = 0;
	КонецЕсли;
	
	//Бондаренко++ 20260728
	Если Не ИспользоватьКалькулятор Тогда
		Если Не обЗначениеНеЗаполнено(ЧистаяСтоимостьАвтомобиля) Тогда
			СуммаСчетаНаАвто = ЧистаяСтоимостьАвтомобиля-ПервоначальныйВзнос; 
		КонецЕсли;
	КонецЕсли;
  		//Бондаренко-- 20260728
	
  	Для каждого Стр Из Программы Цикл
	    Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.Одобрен Тогда
			Если Стр.Статус <> Справочники.СтатусыРабочегоЛиста.КредитВыдан Тогда
				Продолжить;
		    КонецЕсли;
		КонецЕсли;
		ОбработкаРеквизита("Статус",Стр,,);	
	КонецЦикла;	
	//Бондаренко-- 20260725
КонецПроцедуры
