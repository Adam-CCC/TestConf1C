Функция СМГ_ОбновитьДатуКПДоговораЗаказаНаАвтомобиль() Экспорт             
	Отказ_=Ложь;
	// ищем Заказ на автомобиль
	ТолькоНеПомеченные = Истина;
	МассивВидов = Новый Массив(1); МассивВидов[0] = "ЗаказНаАвтомобиль";  
	МассивПодчиненных = дкПолучитьМассивПодчиненных(Ссылка,МассивВидов,ТолькоНеПомеченные);
	Если МассивПодчиненных <> Неопределено И МассивПодчиненных.Количество() > 0 Тогда
		// нашли
		Для каждого Эл Из МассивПодчиненных Цикл
			ЗакНаАвто = Эл.Ссылка;
			Если Не ЗакНаАвто.Проведен Тогда
				Продолжить;
			КонецЕсли;
			ЗаказОтменен = СМГ_ПроверитьОтменуЗаказа(ЗакНаАвто);
			Если НЕ ЗаказОтменен Тогда
				ДоговорВзаиморасчетов_ = ЗакНаАвто.ДоговорВзаиморасчетов.ПолучитьОбъект();
				Если НачалоДня(ДоговорВзаиморасчетов_.ДатаКП) <> НачалоДня(ТекущаяДата()) Тогда
					ДоговорВзаиморасчетов_.ДатаКП = ТекущаяДата();    
					Попытка
						ДоговорВзаиморасчетов_.Записать();
					Исключение                              
						СМГ_Сообщить("ОШИБКА! Не удалось установить текущую дату как дату КП в <<"+ДоговорВзаиморасчетов_+">> с кодом <<"+ДоговорВзаиморасчетов_.Код+">>.",СтатусСообщения.ОченьВажное);
						Отказ_=Истина;
					КонецПопытки; 
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Отказ_;
КонецФункции // СМГ_ОбновитьДатуКПДоговораЗаказаНаАвтомобиль() 

Функция СМГ_ПроверитьОтменуЗаказа(ДокументОснование)
	
	Фл = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаАвтомобиль.Ссылка,
	|	ЗаказНаАвтомобиль.Проведен,
	|	ЗаказНаАвтомобиль.ДокументОснование,
	|	ЗаказНаАвтомобиль.ХозОперация
	|ИЗ
	|	Документ.ЗаказНаАвтомобиль КАК ЗаказНаАвтомобиль
	|ГДЕ
	|	ЗаказНаАвтомобиль.Проведен
	|	И ЗаказНаАвтомобиль.ДокументОснование = &ДокументОснование
	|	И ЗаказНаАвтомобиль.ХозОперация = &ХозОперацияОтмена";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ХозОперацияОтмена", Справочники.ХозОперации.ЗаказНаАвтомобильОтмена);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Фл = Истина;
	КонецЦикла;
	
	Возврат Фл;
	
КонецФункции // ПроверитьОтменуЗаказа(ДокументОснование)

Функция ПоискатьДругиеАвто(Авто)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель КАК АвтомобильМодель,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации КАК АвтомобильВариантКомплектации,
	|	ОстаткиАвтомобилейОстатки.Автомобиль.Цвет.Наименование КАК АвтомобильЦветНаименование,
	|	РАЗНОСТЬДАТ(ОстаткиАвтомобилейОстатки.Партия.Дата, &ТекДата, ДЕНЬ) КАК Дней,
	|	ВЫБОР
	|		КОГДА ОстаткиАвтомобилейОстатки.Автомобиль = &АвтомобильВыбранный
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ФлагНашАвто
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки
	|ГДЕ
	|	ОстаткиАвтомобилейОстатки.Автомобиль.Модель = &АвтомобильВыбранныйМодель
	|	И ОстаткиАвтомобилейОстатки.Автомобиль.ВариантКомплектации = &АвтомобильВыбранныйВариантКомплектации
	|	И ОстаткиАвтомобилейОстатки.Автомобиль.Цвет.Наименование = &АвтомобильВыбранныйЦветНаименование
	|	И ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дней УБЫВ";
	
	Запрос.УстановитьПараметр("АвтомобильВыбранный",Авто);
	Запрос.УстановитьПараметр("АвтомобильВыбранныйМодель",Авто.Модель);
	Запрос.УстановитьПараметр("АвтомобильВыбранныйВариантКомплектации",Авто.ВариантКомплектации);
	Запрос.УстановитьПараметр("АвтомобильВыбранныйЦветНаименование",Авто.Цвет.Наименование);
	Запрос.УстановитьПараметр("ТекДата",НачалоДня(ТекущаяДата()));
	
	ТЗ = Запрос.Выполнить().Выгрузить(); 
	
	Если ТЗ.Количество() > 1 Тогда 
		ДниХраненияВыбранногоАвто = 0;
		НайденнаяСтрока = ТЗ.Найти(Авто,"Автомобиль");
		Если НайденнаяСтрока <> Неопределено Тогда
			ДниХраненияВыбранногоАвто = НайденнаяСтрока.Дней;
		КонецЕсли;
		Для каждого Стр Из ТЗ Цикл
			Если Стр.ФлагНашАвто = 1 Тогда
				Прервать;
			КонецЕсли;
			СМГ_Сообщить("Внимание! "+Стр.Автомобиль+" хранится на складе "+Стр.Дней+" дн. "+?(ДниХраненияВыбранногоАвто>0, "А выбранный - "+ДниХраненияВыбранногоАвто+" дн.",""),СтатусСообщения.Обычное);
		КонецЦикла;
	КонецЕсли;
	
КонецФункции // ПоискатьДругиеАвто(Авто)
