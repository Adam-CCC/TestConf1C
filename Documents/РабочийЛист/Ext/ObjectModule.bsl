Функция СМГ_ПолучитьСуммуПредпродажнойПодготовки(Авто,ДатаПослПост,ДатаРеализации)
	
	//Бондаренко++ 20251015
	Если ДатаРеализации = Дата(1,1,1) Тогда
		ДатаРеал_ = ТекущаяДата();
	Иначе
		ДатаРеал_ = ДатаРеализации;
	КонецЕсли;
	
	Если ДатаПослПост = Дата(1,1,1) Тогда
		ДатаПослПост_ = Дата(2017,1,1);
	Иначе
		ДатаПослПост_ = ДатаПослПост;
	КонецЕсли;
	//Бондаренко 20251015
	
	СуммаПредпродажки_ = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаряд.Ссылка КАК Ссылка,
	|	ЗаказНаряд.Дата КАК Дата,
	|	ЗаказНаряд.Проведен КАК Проведен,
	|	ЗаказНаряд.Состояние КАК Состояние,
	|	ЗаказНаряд.ВидРемонта КАК ВидРемонта,
	|	ЗаказНаряд.Автомобиль КАК Автомобиль,
	|	ЗаказНаряд.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Дата >= &ДатаПослПост
	|	И ЗаказНаряд.Состояние = &СостояниеЗакрыт
	|	И ЗаказНаряд.ВидРемонта = &ВидРемонтаПредпродажнаяПодготовка
	|	И ЗаказНаряд.Автомобиль = &Автомобиль
	|	И ЗаказНаряд.Дата <= &ДатаРеал_";
	
	Запрос.УстановитьПараметр("Автомобиль", Авто);
	Запрос.УстановитьПараметр("ВидРемонтаПредпродажнаяПодготовка", Справочники.ВидыРемонта.ПредпродажнаяПодготовка);
	Запрос.УстановитьПараметр("ДатаПослПост", ДатаПослПост_);
	Запрос.УстановитьПараметр("СостояниеЗакрыт", Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	
	//Бондаренко++ 20251015
	Запрос.УстановитьПараметр("ДатаРеал_", ДатаРеал_);
	//Бондаренко-- 20251015
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СуммаПредпродажки_ = СуммаПредпродажки_ + ВыборкаДетальныеЗаписи.СуммаДокумента ;
	КонецЦикла;
	
	Возврат СуммаПредпродажки_; 
	
КонецФункции // СМГ_ПолучитьСуммуПредпродажнойПодготовки(Авто,ДатаПослПост,ДатаРеал)

