			Если ЕстьПодчиненные Тогда
				СМГ_Сообщить("ОШИБКА! Запрещено использовать подразделение """+СокрЛП(ТекСтрока.АгентПодразделение)+""" из группы """+СокрЛП(ТекСтрока.АгентПодразделение.Родитель)+""".",СтатусСообщения.ОченьВажное);
				ТекСтрока.АгентПодразделение = "";
			КонецЕсли;
			//Бондаренко++ 20250712
			Если обЗначениеНеЗаполнено(ТекСтрока.СтраховаяКомпания) Тогда
				ТекСтрока.СтраховаяКомпания = Справочники.БанкиЛкПартнеры.НайтиПоРеквизиту("БанкКонтрагент",ТекСтрока.ПрограммаСтрахование.СтраховаяКомпания);
			КонецЕсли;
			Если НЕ обЗначениеНеЗаполнено(ТекСтрока.АгентПодразделение) Тогда 
				Если НЕ обЗначениеНеЗаполнено(ТекСтрока.СтраховаяКомпания) Тогда	
					ТекСтрока.ДоговорКв = НайтиСоздатьДоговорПродажаПД(ТекСтрока.АгентПодразделение,ТекСтрока.СтраховаяКомпания.БанкКонтрагент);
				КонецЕсли;
			КонецЕсли;
			//Бондаренко++ 20250712
		КонецЕсли;
		//Бондаренко--+ 20250621
		//Бондаренко++ 20250702
	ИначеЕсли Имя = "ПрограммаКАСКО" Тогда
		Если обЗначениеНеЗаполнено(СтраховаяКомпанияКАСКО) Тогда
			СтраховаяКомпанияКАСКО = Справочники.БанкиЛкПартнеры.НайтиПоРеквизиту("БанкКонтрагент",ПрограммаКАСКО.СтраховаяКомпания);
		КонецЕсли;
	ИначеЕсли Имя = "ПрограммаОСАГО" Тогда
		Если обЗначениеНеЗаполнено(СтраховаяКомпанияОСАГО) Тогда
			СтраховаяКомпанияОСАГО = Справочники.БанкиЛкПартнеры.НайтиПоРеквизиту("БанкКонтрагент",ПрограммаОСАГО.СтраховаяКомпания);
		КонецЕсли;
	ИначеЕсли Имя = "ПрограммаСтрахованиеЖизни" Тогда
		Если обЗначениеНеЗаполнено(СтраховаяКомпанияСЖ) Тогда
			СтраховаяКомпанияСЖ = Справочники.БанкиЛкПартнеры.НайтиПоРеквизиту("БанкКонтрагент",ПрограммаСтрахованиеЖизни.СтраховаяКомпания);
		КонецЕсли;
	ИначеЕсли Имя = "ИныеСтраховыеПродукты.ПрограммаСтрахования" Тогда
		Если обЗначениеНеЗаполнено(ТекСтрока.СтраховаяКомпания) Тогда
			ТекСтрока.СтраховаяКомпания = Справочники.БанкиЛкПартнеры.НайтиПоРеквизиту("БанкКонтрагент",ТекСтрока.ПрограммаСтрахования.СтраховаяКомпания);
		КонецЕсли;
		//Бондаренко-- 20250702
		//Бондаренко++ 20250801	
	ИначеЕсли Имя = "ЛизинговаяПрограмма" Тогда
		Партнер = ЛизинговаяПрограмма.Партнер;
		Если Не обЗначениеНЕЗаполнено(Партнер) Тогда
			БанкЛК = Партнер.БанкКонтрагент;
		КонецЕсли;
		ПроцентАВЛизинг = ЛизинговаяПрограмма.ПроцентКВ;
		КВКредит = ДКПавто * ПроцентАВЛизинг / 100;
	ИначеЕсли Имя = "КредитнаяПрограмма" Тогда
		Партнер = КредитнаяПрограмма.БанкПартнер;
		Если Не обЗначениеНЕЗаполнено(Партнер) Тогда
			БанкЛК = Партнер.БанкКонтрагент;
		КонецЕсли;
		ПроцентАВЛизинг = КредитнаяПРограмма.ПроцентКВ;  
		//Иванченко 20260709 ++
		//КВКредит = СчетИлиАвтоВКредит * ПроцентАВЛизинг / 100;
		
		Если КредитнаяПРограмма.ВариантРассчетаКВ = Перечисления.ВариантыРассчетаКВ.ОтСтоимостиАвтомобиля Тогда
			КВКредит = ДКПавто * ПроцентАВЛизинг / 100; 
		Иначе
			КВКредит = СчетИлиАвтоВКредит * ПроцентАВЛизинг / 100; 
		КонецЕсли;	
		
		//Иванченко 20260709 --	
		//Бондаренко-- 20250801	
		//Бондаренко++ 20250719	
	ИначеЕсли Имя = "СуммаКаско" Тогда
		Если НЕ обЗначениеНеЗаполнено(ПрограммаКаско) Тогда
			Если КвКаско = 0 Тогда
				КвКаско = СуммаКаско * ПрограммаКАСКО.Вознаграждение / 100;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Имя = "CуммаОсаго" Тогда
		Если НЕ обЗначениеНеЗаполнено(ПрограммаОсаго) Тогда
			Если КвОсаго = 0 Тогда
				КвОсаго = СуммаОсаго * ПрограммаОсаго.Вознаграждение / 100;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Имя = "ИныеСтраховыеПродукты.СуммаСтрахования" Тогда
		Если НЕ обЗначениеНеЗаполнено(ТекСтрока.ПрограммаСтрахования) Тогда
			Если ТекСтрока.КВ = 0 Тогда
				ТекСтрока.КВ = ТекСтрока.СуммаСтрахования * ТекСтрока.ПрограммаСтрахования.Вознаграждение / 100;
			КонецЕсли;
		КонецЕсли;	
		//Бондаренко-- 20250719	
		
		//Бондаренко++ 20251016		
	ИначеЕсли Имя = "ПоступлениеАвтомобиля" Тогда
		Если НЕ обЗначениеНеЗаполнено(ПоступлениеАвтомобиля) Тогда
			Если ДатаПоследнегоПоступления <> ПоступлениеАвтомобиля.Дата Тогда
				ДатаПоследнегоПоступления = ПоступлениеАвтомобиля.Дата;
			КонецЕсли;
		Иначе
			Если ДатаПоследнегоПоступления <> Дата(1,1,1) Тогда
				ДатаПоследнегоПоступления = Дата(1,1,1);
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли Имя = "РеализацияАвтомобиля" Тогда
		Если НЕ обЗначениеНеЗаполнено(РеализацияАвтомобиля) Тогда
			Если ДатаРеализацииАвтомобиля <> РеализацияАвтомобиля.Дата Тогда
				ДатаРеализацииАвтомобиля = РеализацияАвтомобиля.Дата;
			КонецЕсли;
		Иначе
			Если ДатаРеализацииАвтомобиля <> Дата(1,1,1) Тогда
				ДатаРеализацииАвтомобиля = Дата(1,1,1);
			КонецЕсли;
		КонецЕсли;	
		//Бондаренко-- 20251016		
		
	Иначе	
		Возврат дкОбработкаРеквизита(ЭтотОбъект,Имя,ТекСтрока,ЭтаФорма,ДопПараметры);
	КонецЕсли;		
КонецФункции // ОбработкаРеквизита()

