Функция СМГ_ПолучитьДатуРеализации(Автомобиль,Ссылка)
	
	ДатаРеализации_ = Дата(1,1,1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияАвтомобилейАвтомобили.ЗаказНаАвтомобиль КАК ЗаказНаАвтомобиль,
	|	РеализацияАвтомобилейАвтомобили.ЗаказНаАвтомобиль.ДокументОснование КАК РабочийЛист,
	|	РеализацияАвтомобилейАвтомобили.Ссылка.Ссылка КАК Ссылка,
	|	РеализацияАвтомобилейАвтомобили.Ссылка.Номер КАК Номер,
	|	РеализацияАвтомобилейАвтомобили.Ссылка.Дата КАК Дата,
	|	РеализацияАвтомобилейАвтомобили.Ссылка.Проведен КАК Проведен
	|ИЗ
	|	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
	|ГДЕ
	|	РеализацияАвтомобилейАвтомобили.Ссылка.Проведен
	|	И РеализацияАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	|	И РеализацияАвтомобилейАвтомобили.ЗаказНаАвтомобиль.ДокументОснование = &РабочийЛист";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("РабочийЛист", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДатаРеализации_ = ВыборкаДетальныеЗаписи.Дата;
		РеализацияАвтомобиля_ = ВыборкаДетальныеЗаписи.Ссылка;
		Если РеализацияАвтомобиля <> РеализацияАвтомобиля_ Тогда
			РеализацияАвтомобиля = РеализацияАвтомобиля_;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
	Возврат ДатаРеализации_; 
	
КонецФункции // СМГ_ПолучитьДатуРеализации(Автомобиль,Ссылка)
