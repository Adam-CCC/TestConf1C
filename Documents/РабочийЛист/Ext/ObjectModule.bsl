//Бондаренко++ 20230907
Функция ПолучитьПредоплату(ДоговорВзаиморасчетов)
	
	СуммаОстаток = 0;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	-СУММА(ВзаиморасчетыКомпанииОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	ВзаиморасчетыКомпанииОстатки.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыКомпании.Остатки КАК ВзаиморасчетыКомпанииОстатки
	|ГДЕ
	|	ВзаиморасчетыКомпанииОстатки.ДоговорВзаиморасчетов = &ДоговорВзаиморасчетов
	|
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыКомпанииОстатки.ДоговорВзаиморасчетов";
	
	Запрос.УстановитьПараметр("ДоговорВзаиморасчетов",ДоговорВзаиморасчетов);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() > 0 Тогда
		СуммаОстаток = ТЗ.Итог("СуммаОстаток");
	КонецЕсли; 
	
	Возврат СуммаОстаток;	
	
КонецФункции // ПолучитьПредоплату(Договор)
