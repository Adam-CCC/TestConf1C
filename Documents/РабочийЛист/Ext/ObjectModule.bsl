	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		СтуктураВрем_ = Новый Структура();
		СтуктураВрем_.Вставить("РазмерСкидки",ВыборкаДетальныеЗаписи.РазмерСкидки);
		СтуктураВрем_.Вставить("РазмерБонуса",ВыборкаДетальныеЗаписи.РазмерБонуса);
		//Бондаренко++ 20250606
		СтуктураВрем_.Вставить("РазмерБонусаРетро",ВыборкаДетальныеЗаписи.РазмерБонусаРетро);
		СтуктураВрем_.Вставить("РазмерБонусаТекущего",ВыборкаДетальныеЗаписи.РазмерБонусаТекущего);
		СтуктураВрем_.Вставить("РазмерПерепродажи",ВыборкаДетальныеЗаписи.РазмерПерепродажи);
		//Бондаренко-- 20250606 
		//Бондаренко++ 20250823
		СтуктураВрем_.Вставить("УдержаниеКомпенсации",ВыборкаДетальныеЗаписи.УдержаниеКомпенсации);
		//Бондаренко-- 20250823
	КонецЦикла;
	
	Возврат СтуктураВрем_;
	
