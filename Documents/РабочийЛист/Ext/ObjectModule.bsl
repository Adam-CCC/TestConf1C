Функция СМГ_ПолучитьДатуПоследнегоПоступленияИзРегистраОстатков(Авто,ДатаРеализации)
	
	Дата_ = Дата(1,1,1);
	
	Запрос = Новый Запрос;
	
	Если ДатаРеализации = Дата(1,1,1) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиАвтомобилейОбороты.Регистратор КАК Регистратор,
		|	ОстаткиАвтомобилейОбороты.Период КАК Период,
		|	ОстаткиАвтомобилейОбороты.Автомобиль КАК Автомобиль,
		|	ОстаткиАвтомобилейОбороты.КоличествоПриход КАК КоличествоПриход,
		|	ОстаткиАвтомобилейОбороты.Регистратор.Контрагент КАК РегистраторКонтрагент,
		|	ОстаткиАвтомобилейОбороты.Регистратор.Контрагент.НашаФирма КАК РегистраторКонтрагентНашаФирма,
		|	ОстаткиАвтомобилейОбороты.Регистратор.ХозОперация КАК РегистраторХозОперация
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Обороты(, , Регистратор, ) КАК ОстаткиАвтомобилейОбороты
		|ГДЕ
		|	ОстаткиАвтомобилейОбороты.КоличествоПриход = 1
		|	И НЕ ОстаткиАвтомобилейОбороты.Регистратор.Контрагент.НашаФирма
		|	И НЕ ОстаткиАвтомобилейОбороты.Регистратор.ХозОперация = &ПереходВСобственность
		//Иванченко 20260129 ++
		|	И ОстаткиАвтомобилейОбороты.Регистратор = ОстаткиАвтомобилейОбороты.Партия
		//Иванченко 20260129 --
		|	И ОстаткиАвтомобилейОбороты.Автомобиль = &Автомобиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ"; 
		
	Иначе	
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиАвтомобилейОбороты.Регистратор КАК Регистратор,
		|	ОстаткиАвтомобилейОбороты.Период КАК Период,
		|	ОстаткиАвтомобилейОбороты.Автомобиль КАК Автомобиль,
		|	ОстаткиАвтомобилейОбороты.КоличествоПриход КАК КоличествоПриход,
		|	ОстаткиАвтомобилейОбороты.Регистратор.Контрагент КАК РегистраторКонтрагент,
		|	ОстаткиАвтомобилейОбороты.Регистратор.Контрагент.НашаФирма КАК РегистраторКонтрагентНашаФирма,
		|	ОстаткиАвтомобилейОбороты.Регистратор.ХозОперация КАК РегистраторХозОперация
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Обороты(, , Регистратор, ) КАК ОстаткиАвтомобилейОбороты
		|ГДЕ
		|	ОстаткиАвтомобилейОбороты.КоличествоПриход = 1
		|	И НЕ ОстаткиАвтомобилейОбороты.Регистратор.Контрагент.НашаФирма
		|	И НЕ ОстаткиАвтомобилейОбороты.Регистратор.ХозОперация = &ПереходВСобственность
		//Иванченко 20260129 ++
		|	И ОстаткиАвтомобилейОбороты.Регистратор = ОстаткиАвтомобилейОбороты.Партия
		//Иванченко 20260129 --		
		|	И ОстаткиАвтомобилейОбороты.Автомобиль = &Автомобиль
		|	И ОстаткиАвтомобилейОбороты.Период < &ДатаРеализации
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ"; 
		
		Запрос.УстановитьПараметр("ДатаРеализации",ДатаРеализации);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Автомобиль",Авто);
	Запрос.УстановитьПараметр("ПереходВСобственность",Справочники.ХозОперации.ПереходВСобственностьАвтомобилей);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Дата_ = ВыборкаДетальныеЗаписи.Период;
		//Бондаренко++ 20251016
		ПоступлениеАвтомобиля_ = ВыборкаДетальныеЗаписи.Регистратор;
		Если ПоступлениеАвтомобиля <> ПоступлениеАвтомобиля_ Тогда
			ПоступлениеАвтомобиля = ПоступлениеАвтомобиля_;
		КонецЕсли;
		//Бондаренко++ 20251016
		Прервать;
	КонецЦикла;
	
	Возврат Дата_;
	
КонецФункции // СМГ_ПолучитьДатуПоследнегоПоступленияИзРегистраОстатков(Авто,ДатаРеализации)
