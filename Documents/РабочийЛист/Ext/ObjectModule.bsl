	Функция СрокХранения(Авто)
		
		Дней = 0; 
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеАвтомобилейАвтомобили.Ссылка,
		|	ПоступлениеАвтомобилейАвтомобили.Автомобиль,
		|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК Дата,
		|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
		|ИЗ
		|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
		|ГДЕ
		|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
		|	И ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("Автомобиль",Авто);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Дней = Цел ( ( НачалоДня(ТекущаяДата()) - НачалоДня(ВыборкаДетальныеЗаписи.Дата) ) / 86400 );
			Прервать;
		КонецЦикла;
		
		Возврат Дней;
		
	КонецФункции // СрокХранения(Авто) 
