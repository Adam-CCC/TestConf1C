//Бондаренко++ 20231209
Процедура СМГ_ЗаполнитьОчиститьАгента(СкладОстаткаАвто,ВладелецАвто)
	
	//Бондаренко++ 20240319
	Если ГосПрограмма Тогда
		СМГ_Сообщить("1).Включена Госпрограмма -> Продажа без агента.");
		Возврат;
	КонецЕсли;
	//Бондаренко-- 20240319
	
	//Бондаренко++ 20240504
	Если ОплатаПоQRCode Тогда
		СМГ_Сообщить("2).Включена Оплата по QR-Code -> Продажа без агента.");
		Возврат;
	КонецЕсли;
	//Бондаренко-- 20240504
	
	//Бондаренко++ 20240507
	Если ВидОплаты = Перечисления.ВидыОплаты.Кредит Тогда
		Если СкидкаСубсидияКредитФакт > 0 Тогда
			Если ЕстьСтраховыеПродуктыКромеКаскоИОсаго() Тогда
				Если НЕ обЗначениеНеЗаполнено(ВидАвтомобиля) Тогда
					Если ВидАвтомобиля = Перечисления.ВидАвтомобиля.Новый Тогда
						СМГ_Сообщить("3).Кредит на новый автомобиль, есть скидка по кредиту, а также - иные страховые продукты (за исключением КАСКО и ОСАГО) -> Продажа без агента.");
						Возврат;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;             
	
	Если ВидОплаты = Перечисления.ВидыОплаты.Кредит Тогда
		Если СуммаПредоплаты = 0 Тогда //Первоначальный взнос
			Если НЕ обЗначениеНеЗаполнено(ВидАвтомобиля) Тогда
				Если ВидАвтомобиля = Перечисления.ВидАвтомобиля.Новый Тогда
					СМГ_Сообщить("4).Кредит на новый автомобиль без первоначального взноса -> Продажа без агента.");
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;             
	//Бондаренко-- 20240507
	
	//Бондаренко++ 20250527
	Если обЗначениеНеЗаполнено(СкладОстаткаАвто) Тогда
		Если РольДоступна("ПолныеПрава") Тогда
			СМГ_Сообщить("Склад остатка авто не заполнен, агент не ищется");
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	//Бондаренко-- 20250527
	
	//Бондаренко++ 202400313
	//ПодразделениеПродажиАвто = СМ_ФормированиеНовыхОбъектов.СМГ_НайтиПодразделениеПоРодителю(СкладОстаткаАвто.Подразделение.Организация,СкладОстаткаАвто.Подразделение.Родитель);
	ПодразделениеПродажиАвто = СМ_ФормированиеНовыхОбъектов.СМГ_НайтиПодразделениеПоРодителю(СкладОстаткаАвто.Подразделение.Организация,ПодразделениеКомпании);
	//Бондаренко-- 202400313
	
	ИскатьАгента = Ложь;
	
	Если обЗначениеНеЗаполнено(ПодразделениеПродажиАвто) Тогда
		ИскатьАгента = Истина;
		Если РольДоступна("ПолныеПрава") Тогда
			СМГ_Сообщить("Подходящее подразделение продажи авто не найдено. Нужен агент.");
		КонецЕсли;	
	ИначеЕсли Не ПодразделениеПродажиАвто.ОПЗарегистрировано Тогда	
		ИскатьАгента = Истина;
		Если РольДоступна("ПолныеПрава") Тогда
			СМГ_Сообщить("Подразделение продажи авто "+ПодразделениеПродажиАвто+" - НЕ зарегистрировано.Нужен агент.");
		КонецЕсли;
	Иначе
		ИскатьАгента = Ложь; 
		// Холышевская ++ 27.06.2026 убыточные организации
		//Если РольДоступна("ПолныеПрава") Тогда
		//	СМГ_Сообщить("Подразделение продажи авто "+ПодразделениеПродажиАвто+" - Зарегистрировано.Агент не нужен.");
		//КонецЕсли;
		Если обПраво("ВключениеОтключениеМеханизмаУбыточныхОрганизаций",Права,,ЭтотОбъект)
			И НЕ обЗначениеНеЗаполнено(Автомобиль) И НЕ обЗначениеНеЗаполнено(СкладВладельцаАвто)
			И НЕ ПроверкаЗаказНаАвтоЕсть()
			// Холышевская ++ 09.07.2026
			// БЫЛО
			//И ВидАвтомобиля = Перечисления.ВидАвтомобиля.АвтомобильСПробегом
			И ПроверитьВидАвтоДляУбыточныхОрганизаций(Автомобиль)
			// Холышевская -- 09.07.2026
			И ПроверкаПоследнееПоступлениеНеКомиссия(Автомобиль) Тогда
			ОрганизацияНеУбыточная = ПроверкаОрганизацияНеУбыточная(ВладелецАвто); 
			//Если ОрганизацияНеУбыточная Тогда 
			//	ИскатьАгента = Истина;
			//	СМГ_Сообщить("Подразделение продажи б/у авто "+ПодразделениеПродажиАвто+" - неубыточное. Агент нужен (убыточная организация).");
			//КонецЕсли;
			//(обход продажи по неубыточным на время отсутсвтия касс)
			Если ОрганизацияНеУбыточная И СкладВладельцаАвто.Организация <> СкладВладельцаАвто.Подразделение.ПерепродажаАвто Тогда 
				ИскатьАгента = Истина;
				СМГ_Сообщить("Подразделение продажи б/у авто "+ПодразделениеПродажиАвто+" - неубыточное. Агент нужен (убыточная организация).");
			КонецЕсли;
			//(обход продажи по неубыточным на время отсутсвтия касс)
		КонецЕсли; 
		Если НЕ ИскатьАгента И РольДоступна("ПолныеПрава") Тогда
			СМГ_Сообщить("Подразделение продажи авто "+ПодразделениеПродажиАвто+" - Зарегистрировано.Агент не нужен.");
		КонецЕсли;
		// Холышевская -- 27.06.2026
	КонецЕсли;
	//Бондаренко-- 20240117
	
	Если Не ИскатьАгента Тогда
		Если НЕ обЗначениеНеЗаполнено(АгентПодразделение) Тогда
			АгентПодразделение = "";
		КонецЕсли;
		Если НЕ обЗначениеНеЗаполнено(Агент) Тогда
			Агент = "";
		КонецЕсли;
	Иначе                                                                                     
		//Бондаренко++ 20240313
		//АгентПодразделениеТекущее = НайтиЗарегистрированноеПодразделение(Подразделение.Родитель);
		АгентПодразделениеТекущее = НайтиЗарегистрированноеПодразделение(ПодразделениеКомпании);
		//Бондаренко-- 20240313
		Если АгентПодразделение <> АгентПодразделениеТекущее Тогда
			АгентПодразделение = АгентПодразделениеТекущее;
		КонецЕсли;
		Если Агент <> АгентПодразделениеТекущее.Организация Тогда
			Агент = АгентПодразделениеТекущее.Организация;
		КонецЕсли;
	КонецЕсли;
	Если Не обЗначениеНеЗаполнено(Агент) Тогда
		Если СуммаКомпенсации <> 30000 Тогда
			СуммаКомпенсации = 30000;
		КонецЕсли;
	Иначе	
		Если СуммаКомпенсации <> 0 Тогда
			СуммаКомпенсации = 0; 
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры //СМГ_ЗаполнитьОчиститьАгента(СкладОстаткаАвто,ВладелецАвто)

