Функция ОпределитьОригинальностьПТС(АвтомобильТрейдИн)
	
	ФлагОригПТС = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Ссылка,
	|	ПодтверждающиеДокументы.ВидПодтверждающегоДокумента КАК Вид,
	|	ПодтверждающиеДокументы.Владелец,
	|	ПодтверждающиеДокументы.ПТСОригинал КАК ПТСОригинал,
	|	ПодтверждающиеДокументы.Текущий
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	(ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ПТС)
	|			ИЛИ ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ВыпискаИзЭлектронногоПаспорта))
	|	И ПодтверждающиеДокументы.Текущий
	|	И ПодтверждающиеДокументы.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", АвтомобильТрейдИн);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.Вид = Перечисления.ВидыДокументов.ВыпискаИзЭлектронногоПаспорта Тогда
			ФлагОригПТС = Истина;
			Прервать;
		ИначеЕсли ВыборкаДетальныеЗаписи.Вид = Перечисления.ВидыДокументов.ПТС Тогда	
			Если ВыборкаДетальныеЗаписи.ПТСОригинал Тогда
				ФлагОригПТС = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ФлагОригПТС; 
	
КонецФункции // ОпределитьОригинальностьПТС(АвтомобильТрейдИн)()
