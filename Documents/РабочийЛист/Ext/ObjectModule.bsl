Функция СМГ_ПолучитьИнвойсИзЗаказаПоставщику(Автомобиль)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(ЗаказПоставщикуНаАвтомобиль.Ссылка) КАК Ссылка,
	|	ЗаказПоставщикуНаАвтомобиль.Автомобиль КАК Автомобиль
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.ЗаказПоставщикуНаАвтомобиль КАК ЗаказПоставщикуНаАвтомобиль
	|ГДЕ
	|	ЗаказПоставщикуНаАвтомобиль.Автомобиль = &Автомобиль
	|	И НЕ ЗаказПоставщикуНаАвтомобиль.ПометкаУдаления
	|	И ЗаказПоставщикуНаАвтомобиль.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПоставщикуНаАвтомобиль.Автомобиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Автомобиль КАК Автомобиль,
	|	ВТ.Ссылка.СуммаВсегоНаАвтомобиль КАК Инвойс
	|ИЗ
	|	ВТ КАК ВТ";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль); 
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда  
			РезультатИнвойс = 0;
	Иначе	
		РезультатИнвойс = Результат[0].Инвойс;  
	КонецЕсли;
	
	Возврат РезультатИнвойс; 
КонецФункции	

