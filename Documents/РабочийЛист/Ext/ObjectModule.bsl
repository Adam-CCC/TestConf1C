Функция СМГ_ПолучитьРРЦ(Автомобиль);
	
	РРЦена = 0;
	
	Запрос = Новый Запрос; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныАвтомобилейСрезПоследних.ТипЦен,
	|	ЦеныАвтомобилейСрезПоследних.Автомобиль,
	|	ЦеныАвтомобилейСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныАвтомобилей.СрезПоследних КАК ЦеныАвтомобилейСрезПоследних
	|ГДЕ
	|	ЦеныАвтомобилейСрезПоследних.Автомобиль = &Автомобиль
	|	И ЦеныАвтомобилейСрезПоследних.ТипЦен = &ТипЦен";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТипЦен", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	
	ВыборкаРРЦ = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаРРЦ.Следующий() Цикл
		РРЦена = ВыборкаРРЦ.Цена;
		Прервать;
	КонецЦикла;
	
	Возврат РРЦена;
	
КонецФункции // СМГ_ПолучитьРРЦ(Автомобиль)

