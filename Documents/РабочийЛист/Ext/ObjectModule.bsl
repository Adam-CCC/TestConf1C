	КонецЕсли;
	// Семенихин 2024.11.03 ----- 
	
	// Холышевская ++ 27.06.2026 убыточные организации
	// если нужно чтобы выбираалсь не та что в ПодразделениеКомпании.ПерепродажаАвто 
	//Если НЕ обЗначениеНеЗаполнено(Автомобиль) И НЕ обЗначениеНеЗаполнено(Агент) 
	//	И ВидАвтомобиля = Перечисления.ВидАвтомобиля.АвтомобильСПробегом
	//	И ПроверкаПоследнееПоступлениеНеКомиссия(Автомобиль) Тогда
	//	ОрганизацияАгентаУбыточная = НЕ ПроверкаОрганизацияНеУбыточная(Агент.КонтрагентОрганизации);
	//	Если ОрганизацияАгентаУбыточная Тогда
	//		СписокОрганизаций.Очистить();
	//		СписокОрганизаций.Добавить(Агент);
	//	КонецЕсли;
	//КонецЕсли;
	// Холышевская -- 27.06.2026
	
	Если СписокОрганизаций.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладыКомпании.Ссылка КАК Склад,
		|	СкладыКомпании.ПометкаУдаления КАК ПометкаУдаления,
		|	СкладыКомпании.ЭтоГруппа КАК ЭтоГруппа,
		|	СкладыКомпании.Подразделение КАК Подразделение,
		|	СкладыКомпании.ТипСклада КАК ТипСклада,
		|	СкладыКомпании.ВидСклада КАК ВидСклада,
