Функция НайтиВладельцаПоЗаказуНаАвтомобиль(Автомобиль) 
	
	ВладАвто = Справочники.Организации.ПустаяСсылка(); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказПоставщикуНаАвтомобиль.Ссылка КАК Ссылка,
	|	ЗаказПоставщикуНаАвтомобиль.Проведен КАК Проведен,
	|	ЗаказПоставщикуНаАвтомобиль.Дата КАК Дата,
	|	ЗаказПоставщикуНаАвтомобиль.Автомобиль КАК Автомобиль,
	|	ЗаказПоставщикуНаАвтомобиль.Организация.КонтрагентОрганизации КАК КонтрагентОрганизации
	|ИЗ
	|	Документ.ЗаказПоставщикуНаАвтомобиль КАК ЗаказПоставщикуНаАвтомобиль
	|ГДЕ
	|	ЗаказПоставщикуНаАвтомобиль.Автомобиль = &Автомобиль
	|	И ЗаказПоставщикуНаАвтомобиль.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВладАвто = ВыборкаДетальныеЗаписи.КонтрагентОрганизации;
		Если РольДоступна("ПолныеПрава") Тогда
			СМГ_Сообщить("3.Найден Владелец авто по заказу поставщику на автомобиль: "+ВладАвто);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВладАвто;
	
КонецФункции // НайтиВладельцаПоЗаказуНаАвтомобиль(Автомобиль)
