Функция НайтиСоздатьДоговорПродажаПД(Подр,Контр) Экспорт
	
	Дог_ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыВзаиморасчетов.Ссылка КАК Договор,
	|	ДоговорыВзаиморасчетов.ЭтоГруппа КАК ЭтоГруппа,
	|	ДоговорыВзаиморасчетов.ПометкаУдаления КАК ПометкаУдаления,
	|	ДоговорыВзаиморасчетов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыВзаиморасчетов.ДатаНачала КАК ДатаНачала,
	|	ДоговорыВзаиморасчетов.ДатаКонца КАК ДатаКонца,
	|	ДоговорыВзаиморасчетов.Владелец КАК Владелец,
	|	ДоговорыВзаиморасчетов.Организация КАК Организация,
	|	ДоговорыВзаиморасчетов.ДляПервичныхДокументов КАК ДляПервичныхДокументов
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	|ГДЕ
	|	НЕ ДоговорыВзаиморасчетов.ПометкаУдаления
	|	И НЕ ДоговорыВзаиморасчетов.ЭтоГруппа
	|	И ДоговорыВзаиморасчетов.Владелец = &Владелец
	|	И ДоговорыВзаиморасчетов.Организация = &Организация
	|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
	|	И ДоговорыВзаиморасчетов.ДляПервичныхДокументов";
	
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоров.Продажа);
	Запрос.УстановитьПараметр("Владелец", Контр);
	Запрос.УстановитьПараметр("Организация", Подр.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Дог_ = ВыборкаДетальныеЗаписи.Договор;
		//СМГ_Сообщить("Договор найден");
		Прервать;
	КонецЦикла;
	
	Если обЗначениеНеЗаполнено(Дог_) Тогда
		
		//СМГ_Сообщить("Договор НЕ найден",СтатусСообщения.ОченьВажное);
		
		Дог_ = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();		
		
		Дог_.Заполнить("");
		
		Дог_.Владелец = Контр;
		Дог_.Организация = Подр.Организация;
		Дог_.Подразделение = Подр;
		Дог_.ВидДоговора = Перечисления.ВидыДоговоров.Продажа;
		
		//Бондаренко++ 20250801
		Дог_.ДляАвтомобилей = Истина;
		Дог_.ДляАвтосалона = Истина;
		Дог_.ДляПервичныхДокументов = Истина;
		//Бондаренко-- 20250801
		
		Дог_.СформироватьНаименование();
		
		//Бондаренко-- 20250801
		//Дог_.Внутренний = Истина;
		Дог_.Внутренний = Ложь;
		//Бондаренко-- 20250801
		
		Дог_.УстановитьНовыйКод("");
		
		Попытка
			Дог_.Записать();		
		Исключение
			СМГ_Сообщить("ОШИБКА! Не удалось создать договор <<Продажа ПД>> для контрагента <<"+СокрЛП(Контр)+">> по организации <<"+СокрЛП(Подр.Организация)+">>.");
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Дог_.Ссылка;    	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
КонецФункции // НайтиСоздатьДоговорПродажаПД(Подр,Контр)
