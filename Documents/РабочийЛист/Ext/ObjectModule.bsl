	|	ПоступлениеАвтомобилейАвтомобили.СуммаНДС,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	|	И ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
	|	И ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата < &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
	Запрос.УстановитьПараметр("Дата",КонецДня(ДатаДок));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураЦеныАвто = Новый Структура;
		СтруктураЦеныАвто.Вставить("Цена",Выборка.Цена);
		СтруктураЦеныАвто.Вставить("СуммаНДС",Выборка.СуммаНДС);
		Возврат СтруктураЦеныАвто;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	

Функция ПолучитьЦенуАвто(Автомобиль,ВариантКомплектации,ТипЦен,ДатаДок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЦеныАвтомобилейСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныАвтомобилей.СрезПоследних(
	|			&Дата,
	|			Автомобиль = &Автомобиль
	|				И ВариантКомплектации = &ВариантКомплектации
	|				И ТипЦен = &ТипЦен) КАК ЦеныАвтомобилейСрезПоследних";
	Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
	Запрос.УстановитьПараметр("ВариантКомплектации", ВариантКомплектации);
	Запрос.УстановитьПараметр("ТипЦен",ТипЦен);
	Запрос.УстановитьПараметр("Дата",ДатаДок);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	Иначе
		Возврат 0;
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьРРЦ(Авто)
	
	ЦенаНайденная = 0;
	
	Запрос = Новый Запрос; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныАвтомобилейСрезПоследних.ТипЦен,
	|	ЦеныАвтомобилейСрезПоследних.Автомобиль,
	|	ЦеныАвтомобилейСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныАвтомобилей.СрезПоследних КАК ЦеныАвтомобилейСрезПоследних
	|ГДЕ
	|	ЦеныАвтомобилейСрезПоследних.Автомобиль = &Автомобиль
	|	И ЦеныАвтомобилейСрезПоследних.ТипЦен = &ТипЦен";
	
	Запрос.УстановитьПараметр("Автомобиль", Авто);
	Запрос.УстановитьПараметр("ТипЦен", Справочники.ТипыЦен.ОсновнойТипЦенПродажи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЦенаНайденная  = Выборка.Цена;
	Иначе
		ЦенаНайденная = ПолучитьЦенуПродажиИзПоступленияАвто(Авто);
	КонецЕсли;
	
	Возврат ЦенаНайденная; 	
	
КонецФункции // ПолучитьРРЦ(Авто) 

