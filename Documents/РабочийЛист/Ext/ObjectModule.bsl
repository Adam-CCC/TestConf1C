	|	И ПоказателиМаркетинговыхПрограммСрезПоследних.ВариантКомплектации = &ВариантКомплектации
	|	И НЕ ПоказателиМаркетинговыхПрограммСрезПоследних.Отменена";	
	//Иванченко 20251116 --	
	
