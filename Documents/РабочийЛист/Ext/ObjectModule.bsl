Процедура ДобавитьКонтрагентаВПодчиненные() Экспорт
	Если обЗначениеНеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;	
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат;
	КонецЕсли;
	
	СписокПодчиненных = КритерииОтбора.ПодчиненныеДокументы.Найти(Ссылка);
	Для Каждого ПодчиненныйДокумент Из СписокПодчиненных Цикл
		ДокументМетаданные = ПодчиненныйДокумент.Метаданные();
		Если ДокументМетаданные.Реквизиты.Найти("Контрагент") = Неопределено Тогда
			Продолжить;
		ИначеЕсли ДокументМетаданные.Имя = "ЗаказНаАвтомобиль" Тогда
			Продолжить;
		Иначе
			ПодчиненныйДокументОбъект = ПодчиненныйДокумент.ПолучитьОбъект();
			Если ПодчиненныйДокументОбъект.Контрагент = Контрагент Тогда
				Продолжить;
			КонецЕсли;
			ПодчиненныйДокументОбъект.Контрагент = Контрагент;
			ПодчиненныйДокументОбъект.ОбменДанными.Загрузка = Истина;
			ПодчиненныйДокументОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаменитьМенеджераВСобытиях()
	ЗапросСобытия = Новый Запрос();
	ЗапросСобытия.УстановитьПараметр("Запланировано", Перечисления.СостоянияСобытий.Запланировано);
	ЗапросСобытия.УстановитьПараметр("РабочийЛист", Ссылка);
	ЗапросСобытия.УстановитьПараметр("Менеджер", Менеджер);
	ЗапросСобытия.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.Состояние = &Запланировано
	|	И Событие.ДокументОснование = &РабочийЛист
	|	И Событие.Продавец <> &Менеджер";
	
	РезультатСобытия = ЗапросСобытия.Выполнить().Выбрать();
	Пока РезультатСобытия.Следующий() Цикл
		СобытиеОбъект = РезультатСобытия.Ссылка.ПолучитьОбъект();
		СобытиеОбъект.Продавец = Менеджер;
		СобытиеОбъект.ПодразделениеКомпании = ПодразделениеКомпании;
		СобытиеОбъект.Организация = ПодразделениеКомпании.Организация;
		Попытка
			СобытиеОбъект.ОбменДанными.Загрузка = Истина;
			СобытиеОбъект.Записать();
		Исключение
			Сообщить("Ошибка замены менеджера в " + Строка(РезультатСобытия.Ссылка) + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
			Продолжить;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьПодчиненныеСобытия() Экспорт
	ЗапросСобытия = Новый Запрос();
	ЗапросСобытия.УстановитьПараметр("РабочийЛист", Ссылка);
	ЗапросСобытия.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка,
	|	Событие.Номер,
	|	Событие.Дата КАК Дата,
	|	Событие.Автомобиль,
	|	Событие.Автор,
	|	Событие.ВидСобытия,
	|	Событие.ВидТелефона,
	|	Событие.ДатаНачала,
	|	Событие.ДатаОкончания,
	|	Событие.ДатаФактическогоЗавершения,
	|	Событие.ЗаказНаАвтомобиль,
	|	Событие.ИсточникИнформации,
	|	Событие.Комментарий,
	|	Событие.Контрагент,
	|	Событие.Продавец,
	|	Событие.Организация,
	|	Событие.ПодразделениеКомпании,
	|	Событие.ПредставлениеТелефона,
	|	Событие.Примечание,
	|	Событие.Продолжительность,
	|	Событие.Результат,
	|	Событие.Содержание,
	|	Событие.Состояние,
	|	Событие.ТипСообщения,
	|	Событие.ФактическаяДатаВыдачиАвтомобиля,
	|	Событие.ПовторныйРемонт,
	|	Событие.ВторичныйКонтакт,
	|	Событие.ПредметОбращения,
	|	Событие.КомментарийКоллЦентра
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	НЕ Событие.ПометкаУдаления
	|	И Событие.ДокументОснование = &РабочийЛист
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Возврат ЗапросСобытия.Выполнить().Выгрузить();
КонецФункции

Процедура ЗаменитьТелефонВСобытиях()	
	ЗапросСобытия = Новый Запрос();
	ЗапросСобытия.УстановитьПараметр("ДокументОснование", Ссылка);
	ЗапросСобытия.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ДокументОснование = &ДокументОснование
	|	И Событие.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)";
	
	РезультатСобытия = ЗапросСобытия.Выполнить();
	Если РезультатСобытия.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаСобытия = РезультатСобытия.Выбрать();
	ОбработкаРедактированиеКИ = Обработки.РедактированиеКонтактнойИнформации.Создать();
	СтруктураТелефона = ОбработкаРедактированиеКИ.СМГ_СформироватьСтруктуруТелефона(ПредставлениеТелефона);
	Пока ВыборкаСобытия.Следующий() Цикл
		СобытиеОбъект = ВыборкаСобытия.Ссылка.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(СобытиеОбъект, СтруктураТелефона);
		СобытиеОбъект.ОбменДанными.Загрузка = Истина;
		СобытиеОбъект.Записать();
	КонецЦикла;
КонецПроцедуры
