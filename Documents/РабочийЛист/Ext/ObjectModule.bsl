Функция ПолучитьОстатокАвтоНаСкладе(Авто)
	
	КолАвто_ = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
	|	СУММА(ОстаткиАвтомобилейОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки
	|ГДЕ
	|	ОстаткиАвтомобилейОстатки.Автомобиль = &Автомобиль
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиАвтомобилейОстатки.Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль",Авто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КолАвто_ = ВыборкаДетальныеЗаписи.КоличествоОстаток;
		Прервать;
	КонецЦикла;
	
	Возврат КолАвто_;
	
КонецФункции // ПолучитьОстатокАвтоНаСкладе(Авто)

Функция СМГ_ПолучитьИнвойсИзПоступленияИКорректировок(Автомобиль,ДатаПоследнегоПоступления)
	
	ИнвойсОст = 0;
	
	СписокАвто = Новый СписокЗначений;
	СписокАвто.Добавить(Автомобиль);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль КАК Автомобиль,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен КАК Проведен,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Ссылка КАК Ссылка,
	|	ПоступлениеАвтомобилейАвтомобили.СуммаВсего КАК СуммаВсего,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент КАК Контрагент,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма КАК КонтрагентНашаФирма,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
	|	И НЕ ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма
	|	И ПоступлениеАвтомобилейАвтомобили.Автомобиль В(&СписокАвто)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВводОстатковАвтомобилейАвтомобили.Автомобиль,
	|	ВводОстатковАвтомобилейАвтомобили.Ссылка.Проведен,
	|	ВводОстатковАвтомобилейАвтомобили.Ссылка,
	|	ВводОстатковАвтомобилейАвтомобили.СуммаВсего,
	|	ВводОстатковАвтомобилейАвтомобили.Ссылка.Контрагент,
	|	ВводОстатковАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма,
	|	ВводОстатковАвтомобилейАвтомобили.Ссылка.Дата
	|ИЗ
	|	Документ.ВводОстатковАвтомобилей.Автомобили КАК ВводОстатковАвтомобилейАвтомобили
	|ГДЕ
	|	ВводОстатковАвтомобилейАвтомобили.Ссылка.Проведен
	|	И ВводОстатковАвтомобилейАвтомобили.Автомобиль В(&СписокАвто)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";  
	
	Запрос.УстановитьПараметр("СписокАвто",СписокАвто);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() > 0 Тогда
		ИнвойсОст = ТЗ[0].СуммаВсего;	
		ТаблицаКорректировокПоступленияАвто = ПолучитьТаблицуКорректировокПоступленияАвто(СписокАвто);
		Если ТаблицаКорректировокПоступленияАвто.Количество() > 0 Тогда
			Для каждого Эл Из ТаблицаКорректировокПоступленияАвто Цикл
				Если Эл.Дата < ДатаПоследнегоПоступления Тогда
					Продолжить;
				КонецЕсли;
				ИнвойсОст = ИнвойсОст + Эл.СуммаРазница;	
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	//Бондаренко++ 20250903
	Если Автомобиль.Модель.Марка = Справочники.Марка.GAC ИЛИ
		Автомобиль.VIN = "LS4ASE2A5RJ104624" ИЛИ
		Автомобиль.VIN = "LS4ASE2A7RA707123" ИЛИ
		Автомобиль.VIN = "LS4ASE2A5RJ106714" ИЛИ
		Автомобиль.VIN = "LS5A2DKR7RA016010" Тогда
		Если ВидАвтомобиля = Перечисления.ВидАвтомобиля.Новый Тогда
			ИнвойсЧанган = 0;
			ИнвойсЧанган = ПолучитьИнвойсЧанган(Автомобиль);				
			Если ИнвойсЧанган > 0 Тогда
				ИнвойсОст = ИнвойсЧанган;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Бондаренко-- 20250903
	
	Возврат ИнвойсОст;
	
КонецФункции // СМГ_ПолучитьИнвойсИзПоступленияИКорректировок(Автомобиль,ДатаПоследнегоПоступления)
