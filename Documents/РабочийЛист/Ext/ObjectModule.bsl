		ДатаРеалАвто_ = ДатаРеалАвто;
	КонецЕсли;
	
	Если ДатаПослПост = Дата(1,1,1) Тогда
		ДатаПослПост_ = Дата(2017,1,1);
	Иначе
		ДатаПослПост_ = ДатаПослПост;
	КонецЕсли;
	
	ЗапросКомплектация = Новый Запрос;
	ЗапросКомплектация.УстановитьПараметр("Автомобиль", Автомобиль); 
	//Бондаренко++ 20251015
	ЗапросКомплектация.УстановитьПараметр("ДатаПоступления", ДатаПослПост_); 	
	ЗапросКомплектация.УстановитьПараметр("ДатаРеализации", ДатаРеалАвто_);	
	//Бондаренко-- 20251015
	ЗапросКомплектация.Текст = 
	"ВЫБРАТЬ
	|	КомплектацияАвтомобиля.Автомобиль КАК Автомобиль,
	|	СУММА(КомплектацияАвтомобиля.СуммаДокумента) КАК СуммаКомплектации
	|ИЗ
	|	Документ.КомплектацияАвтомобиля КАК КомплектацияАвтомобиля
	|ГДЕ
	|	КомплектацияАвтомобиля.Автомобиль = &Автомобиль
	|	И КомплектацияАвтомобиля.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	|	И КомплектацияАвтомобиля.Дата Между &ДатаПоступления И &ДатаРеализации	
	|	И КомплектацияАвтомобиля.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	КомплектацияАвтомобиля.Автомобиль";
	
	РезультатКомплектация = ЗапросКомплектация.Выполнить();
	Если РезультатКомплектация.Пустой() Тогда      
		СуммаВложений = СМГ_ПолучитьСебестоимостьВложений(Автомобиль,ДатаПослПост, ДатаРеалАвто);	
		Возврат СуммаВложений;
	Иначе
		ВыборкаКомплектация = РезультатКомплектация.Выбрать();
		ВыборкаКомплектация.Следующий();
		СуммаКомплектации = ВыборкаКомплектация.СуммаКомплектации;
	КонецЕсли;
	
	ЗапросРазукомплектация = Новый Запрос;
	ЗапросРазукомплектация.УстановитьПараметр("Автомобиль", Автомобиль);
	ЗапросРазукомплектация.УстановитьПараметр("ДатаПоступления", ДатаПослПост_); 
	ЗапросРазукомплектация.УстановитьПараметр("ДатаРеализации", ДатаРеалАвто_);	
	//Иванченко 20251001 --		
	ЗапросРазукомплектация.Текст = 
	"ВЫБРАТЬ
	|	РазукомплектацияАвтомобилей.Автомобиль КАК Автомобиль,
	|	СУММА(РазукомплектацияАвтомобилей.СуммаДокумента) КАК СуммаРазукомплектации
	|ИЗ
	|	Документ.РазукомплектацияАвтомобилей КАК РазукомплектацияАвтомобилей
	|ГДЕ
	|	РазукомплектацияАвтомобилей.Автомобиль = &Автомобиль
	|	И РазукомплектацияАвтомобилей.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	|	И РазукомплектацияАвтомобилей.Дата Между &ДатаПоступления И &ДатаРеализации	
	|	И РазукомплектацияАвтомобилей.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	РазукомплектацияАвтомобилей.Автомобиль";
	
	РезультатРазукомплектация = ЗапросРазукомплектация.Выполнить();
	Если РезультатРазукомплектация.Пустой() Тогда
		Возврат СуммаКомплектации;
	Иначе
		ВыборкаРазукомплектация = РезультатРазукомплектация.Выбрать();
		ВыборкаРазукомплектация.Следующий();
		Возврат СуммаКомплектации - ВыборкаРазукомплектация.СуммаРазукомплектации;
	КонецЕсли;
	
КонецФункции // СМГ_ПолучитьСебестоимостьДО(Автомобиль) 

