Процедура СформироватьРабочиеЛистыКредитногОтдела(ЭтаФорма=Неопределено) Экспорт
	
	#Если Клиент Тогда
		
		Если НЕ (ЭтотОбъект.Ссылка.Статус = Справочники.СтатусыРабочегоЛиста.Интерес
			ИЛИ ЭтотОбъект.Ссылка.Статус = Справочники.СтатусыРабочегоЛиста.Продажа 
			ИЛИ ЭтотОбъект.Ссылка.Статус = Справочники.СтатусыРабочегоЛиста.Сделка )
			Тогда
			Сообщить("Статус должен быть Интерес, Продажа или Сделка.");
			Возврат;	
		КонецЕсли; 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КредитныеПрограммы.Ссылка КАК КредитнаяПрограмма,
		|	КредитныеПрограммы.ПометкаУдаления КАК ПометкаУдаления,
		|	КредитныеПрограммы.Наименование КАК Наименование,
		|	КредитныеПрограммы.Банк КАК Банк,
		|	КредитныеПрограммы.ГодоваяСтавка КАК ГодоваяСтавка
		|ИЗ
		|	Справочник.КредитныеПрограммы КАК КредитныеПрограммы
		|ГДЕ
		|	НЕ КредитныеПрограммы.ПометкаУдаления";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			РЛкредОтд = Документы.РабочийЛистКредитногоОтдела.СоздатьДокумент();
			РЛкредОтд.Заполнить(Ссылка);
			
			РЛкредОтд.ДокументОснование = ЭтотОбъект.Ссылка;
			РЛкредОтд.КредитнаяПрограмма = ВыборкаДетальныеЗаписи.КредитнаяПрограмма;
			РЛкредОтд.Банк = ВыборкаДетальныеЗаписи.Банк;
			РЛкредОтд.ПроцентнаяСтавка = ВыборкаДетальныеЗаписи.ГодоваяСтавка;
			РЛкредОтд.ПервоначальныйВзнос = СуммаПредоплаты;
			РЛкредОтд.СуммаКредита = СчетИлиАвтоВКредит;
			РЛкредОтд.СрокКредита = 36;
			РЛкредОтд.ЗаявленныйДоход = 100000;
			РЛкредОтд.ВалютаЗаявленногоДохода = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
			РЛкредОтд.ТребованиеКПодтверждениюДохода = Перечисления.ТребованияКПодтверждениюДохода.ЗаявлениеЗаемщика; 
			РЛкредОтд.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить(); 
			
			Попытка
				РЛкредОтд.Записать(РежимЗаписиДокумента.Запись);
				СМГ_Сообщить("Записан новый документ "+РЛкредОтд,СтатусСообщения.БезСтатуса);			
			Исключение
				СМГ_Сообщить("ОШИБКА! Не удалось создать новый документ "+РЛкредОтд,СтатусСообщения.ОченьВажное);			
			КонецПопытки;
			
		КонецЦикла;
		
	#КонецЕсли
	
КонецПроцедуры //СформироватьРабочиеЛистыКредитногоОтдела 

Процедура СМГ_ВыполнитьДвижение(МаркетинговаяПрограмма,СкидкаФакт,КомпенсацияРетро,КомпенсацияСлед)
	
	Если Не обЗначениеНеЗаполнено(МаркетинговаяПрограмма) Тогда
		
		Если СкидкаФакт > 0 ИЛИ КомпенсацияРетро > 0 ИЛИ КомпенсацияСлед > 0 Тогда
			
			Движение = Движения.БонусныеБаллыДилера.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Автомобиль = Автомобиль;
			Движение.Активность = Истина; 
			//Бондаренко++ 20260331
			Движение.ДокументРеализации = ОтгрузкаАвтомобиля;
			//Бондаренко-- 20260331
			Движение.МаркетинговаяПрограмма = МаркетинговаяПрограмма;
			Движение.ПодразделениеКомпании = РеализацияАвтомобиля.ПодразделениеКомпании;
			Движение.Организация = РеализацияАвтомобиля.Организация;
			Движение.Модель = Автомобиль.Модель;
			Движение.Марка = Автомобиль.Модель.Марка;
			Движение.КонтрагентПокупатель = РеализацияАвтомобиля.Контрагент;
			Движение.ХозОперация = Справочники.ХозОперации.КорректировкаБонусов;
			Движение.ДатаПродажи = РеализацияАвтомобиля.Дата;
			
			Движение.СкидкаПоМаркетинговойПрограмме = СкидкаФакт; 

			Если КомпенсацияСлед > 0 Тогда
				Движение.Компенсация = КомпенсацияСлед; 
				Движение.ВариантКомпенсации = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего;
			ИначеЕсли КомпенсацияРетро > 0 Тогда	
				Движение.Компенсация = КомпенсацияРетро; 
				Движение.ВариантКомпенсации = Перечисления.ВариантКомпенсации.Ретроспективная;
			Иначе
				Движение.Компенсация = 0; 
				Движение.ВариантКомпенсации = Перечисления.ВариантКомпенсации.ПустаяСсылка();
			КонецЕсли;
 			
		КонецЕсли;
		
	КонецЕсли;	
    
КонецПроцедуры

//Бондаренко++ 20250614
Процедура СМГ_ОбработкаПроведения(Отказ, Режим)
	
  	Движения.ВзаиморасчетыКомпании.Очистить();
	Движения.БонусныеБаллыДилера.Очистить();
	
	СсылкаНаРеализациюАвто_ = НайтиРеализациюАвто(Ссылка);
	
	Если НЕ обЗначениеНеЗаполнено(СсылкаНаРеализациюАвто_) Тогда
		Если СсылкаНаРеализациюАвто_.Дата < Дата(2025,1,1) Тогда
			#Если Клиент Тогда
				СМГ_Сообщить("Документ "+СсылкаНаРеализациюАвто_+" слишком старый. Движения РЛ не выполняются."); 
 			#КонецЕсли
			Возврат;
		КонецЕсли;
		Если ЭтотОбъект.НеПроводной Тогда
			#Если Клиент Тогда
				СМГ_Сообщить("Документ непроводной. Не выполняются движения РЛ.",СтатусСообщения.Обычное); 
			#КонецЕсли
			Возврат;
		КонецЕсли; 
	Иначе	
		#Если Клиент Тогда
			СМГ_Сообщить("Реализация автомобиля не найдена."); 
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	Для Сч = 1 По 5 Цикл
		
		МаркПрогр = "";
		СкидкаФакт = 0;    
		КомпРетро = 0;
		КомпСлед = 0;
		
		Если Сч = 1 Тогда
			МаркПрогр = МаркетинговаяПрограммаСкидкаТрейдИн;
			СкидкаФакт = СкидкаТрейдИнФакт;    
			КомпРетро = КомпенсацияТрейдИНРетроспективная;
			КомпСлед = КомпенсацияТрейдИНВИнВойсеСледующегоАвтомобиля;
		ИначеЕсли Сч = 2 Тогда	
			МаркПрогр = МаркетинговаяПрограммаСкидкаТрейдИн2;
			СкидкаФакт = СкидкаТрейдИн2Факт;    
			КомпРетро = КомпенсацияТрейдИН2Ретроспективная;
			КомпСлед = КомпенсацияТрейдИН2ВИнВойсеСледующегоАвтомобиля;
		ИначеЕсли Сч = 3 Тогда	
			МаркПрогр = МаркетинговаяПрограммаСкидкаСубсидияКредит;
			СкидкаФакт = СкидкаСубсидияКредитФакт;    
			КомпРетро = КомпенсацияСубсидияКредитРетроспективная;
			КомпСлед = КомпенсацияСубсидияКредитВИнВойсеСледующегоАвтомобиля;
		ИначеЕсли Сч = 4 Тогда	
			МаркПрогр = МаркетинговаяПрограммаСкидкаПоПрограммамЛояльности;
			СкидкаФакт = СкидкаПоПрограммамЛояльности;    
			КомпРетро = КомпенсацияПоПрограммамЛояльностиРетроспективная;
			КомпСлед = КомпенсацияПоПрограммамЛояльностиВИнВойсеСледующегоАвтомобиля;
		ИначеЕсли Сч = 5 Тогда	
			МаркПрогр = МаркетинговаяПрограммаСкидкаПоПрограммамЛояльностиДополнительно;
			СкидкаФакт = СкидкаАвтоЦентра;    
			КомпРетро = КомпенсацияРозничнаяРетроспективная;
			КомпСлед = КомпенсацияРозничнаяВИнВойсеСледующегоАвтомобиля;
		КонецЕсли;
		
		Если Не обЗначениеНеЗаполнено(МаркПрогр) Тогда
			Если ( СкидкаФакт > 0 ) ИЛИ	( КомпРетро > 0) ИЛИ ( КомпСлед > 0 )	 Тогда
				СМГ_ВыполнитьДвижение(МаркПрогр,СкидкаФакт,КомпРетро,КомпСлед);	 
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
  	
КонецПроцедуры

Функция НайтиРеализациюАвто(РЛ)
	
	РеалАвто_ = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияАвтомобилейАвтомобили.Автомобиль КАК Автомобиль,
	|	РеализацияАвтомобилейАвтомобили.Ссылка КАК РеалАвто,
	|	РеализацияАвтомобилейАвтомобили.ЗаказНаАвтомобиль КАК ЗаказНаАвтомобиль,
	|	РеализацияАвтомобилейАвтомобили.ЗаказНаАвтомобиль.ДокументОснование КАК ЗаказНаАвтомобильДокументОснование,
	|	РеализацияАвтомобилейАвтомобили.Ссылка.Проведен КАК Проведен,
	|	РеализацияАвтомобилейАвтомобили.Ссылка.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
	|ГДЕ
	|	РеализацияАвтомобилейАвтомобили.ЗаказНаАвтомобиль.ДокументОснование = &СсылкаНаРЛ
	|	И РеализацияАвтомобилейАвтомобили.Автомобиль = &АвтомобильРЛ";
	
	Запрос.УстановитьПараметр("АвтомобильРЛ", Ссылка.Автомобиль);
	Запрос.УстановитьПараметр("СсылкаНаРЛ", РЛ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РеалАвто_ = ВыборкаДетальныеЗаписи.РеалАвто; 
	КонецЦикла;                               
	
	Возврат РеалАвто_;
	
КонецФункции // НайтиРеализациюАвто(Ссылка)
