Функция СМГ_ПолучитьСебестоимостьДОКоммерции(Автомобиль, Дата_ПоследнееПоступление, Дата_Реализация)
		
	Если Дата_ПоследнееПоступление = Дата(1,1,1) Тогда
		Параметр_ДатаПоследнегоПоступления = Дата(2017,1,1);
	Иначе
		Параметр_ДатаПоследнегоПоступления = Дата_ПоследнееПоступление;
	КонецЕсли;       
	
	//Иванченко 20260325 ++	
	//Если Дата_Реализация = Дата(1,1,1) Тогда
	//	Параметр_ДатаРеализации = ТекущаяДата();
	//Иначе
	//	Параметр_ДатаРеализации = Дата_Реализация;
	//КонецЕсли;
	
	//Иванченко 20260406 ++	
	//Если День(Дата) < 14 Тогда
	//	Параметр_ДатаЗарплатыОП = НачалоМесяца(Дата) + 14 * 86400;       
	//Иначе 
	//	Параметр_ДатаЗарплатыОП = КонецМесяца(Дата) + 14 * 86401; 
	//КонецЕсли;
	ДатаПроверкиЗарплатыОП = ?(ДатаРеализацииАвтомобиля = '00010101', ТекущаяДата(), ДатаРеализацииАвтомобиля);
	
	Если День(ДатаПроверкиЗарплатыОП) < 14 Тогда
		Параметр_ДатаЗарплатыОП = НачалоМесяца(ДатаПроверкиЗарплатыОП) + 14 * 86400;       
	Иначе 
		Параметр_ДатаЗарплатыОП = КонецМесяца(ДатаПроверкиЗарплатыОП) + 14 * 86401; 
	КонецЕсли;	
	//Иванченко 20260406 --	
	//Иванченко 20260325 --
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СУММА(ЗаказНаряд.СуммаДокумента) КАК СуммаДокумента
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Проведен
	|	И НЕ ЗаказНаряд.ПометкаУдаления
	|	И ЗаказНаряд.Дата >= &ДатаПоследнегоПоступления
	|	И ЗаказНаряд.Дата <= &ДатаЗарплатыОП
	|	И ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
	|	И ЗаказНаряд.ВидРемонта = ЗНАЧЕНИЕ(Справочник.ВидыРемонта.КоммерческоеДопОборудование)
	|	И ЗаказНаряд.Автомобиль = &Автомобиль
	|
	|ИМЕЮЩИЕ
	|	НЕ СУММА(ЗаказНаряд.СуммаДокумента) ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ДатаПоследнегоПоступления", Параметр_ДатаПоследнегоПоступления);  
	//Иванченко 20260325 ++  
	//Запрос.УстановитьПараметр("ДатаРеализации", Параметр_ДатаРеализации);
	Запрос.УстановитьПараметр("ДатаЗарплатыОП", Параметр_ДатаЗарплатыОП);	
	//Иванченко 20260325 --
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);	

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Параметр_СебестоимостьДОКоммерция = 0; 
	Иначе
		Параметр_СебестоимостьДОКоммерция = РезультатЗапроса.Выгрузить()[0].СуммаДокумента; 
	КонецЕсли;	
	
	Возврат Параметр_СебестоимостьДОКоммерция;
КонецФункции
