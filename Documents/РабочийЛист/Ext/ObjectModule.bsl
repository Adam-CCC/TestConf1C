Функция ПолучитьЦенуПродажиИзПоступленияАвто(Авто)
	
	ЦенаНайденная = 0;
	
	Запрос = Новый Запрос; 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль КАК Автомобиль,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен КАК Проведен,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК Дата,
	|	ПоступлениеАвтомобилейАвтомобили.СуммаПродажи КАК СуммаПродажи
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
	|	И ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Авто
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Авто", Авто);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.СуммаПродажи = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЦенаНайденная  = Выборка.СуммаПродажи;
		Прервать;
	КонецЦикла;
	
	Возврат ЦенаНайденная;	
	
КонецФункции // ПолучитьЦенуПродажиИзПоступленияАвто(Авто)
