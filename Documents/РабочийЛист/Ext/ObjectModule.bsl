//Бондаренко++ 20250816
Функция ЕстьНезакрытыеДокументы(Автомобиль,ДатаПоследнегоПоступления) Экспорт
	
	Флаг_ = Ложь; 
	
	СпСостояний = Новый СписокЗначений;
	СпСостояний.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Отказ);
	СпСостояний.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказНаряд.Проведен КАК ДокПроведен,
	|	ЗаказНаряд.Ссылка КАК Ссылка,
	|	ЗаказНаряд.Состояние КАК Состояние,
	|	ЗаказНаряд.Автомобиль КАК Автомобиль,
	|	ЗаказНаряд.Проведен КАК Проведен,
	|	ЗаказНаряд.Автомобиль.VIN КАК АвтомобильVIN
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Автомобиль = &Автомобиль
	|	И НЕ ЗаказНаряд.Состояние В (&СпСостояний)
	|	И ЗаказНаряд.Проведен
	|	И НЕ ЗаказНаряд.ВидРемонта.ГарантияЗавода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КомплектацияАвтомобиля.Проведен,
	|	КомплектацияАвтомобиля.Ссылка,
	|	КомплектацияАвтомобиля.Состояние,
	|	КомплектацияАвтомобиля.Автомобиль,
	|	КомплектацияАвтомобиля.Проведен,
	|	КомплектацияАвтомобиля.Автомобиль.VIN
	|ИЗ
	|	Документ.КомплектацияАвтомобиля КАК КомплектацияАвтомобиля
	|ГДЕ
	|	КомплектацияАвтомобиля.Автомобиль = &Автомобиль
	|	И НЕ КомплектацияАвтомобиля.Состояние В (&СпСостояний)
	|	И КомплектацияАвтомобиля.Проведен";
	
	Запрос.УстановитьПараметр("ДатаПоследнегоПоступления",ДатаПоследнегоПоступления);
	Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
	Запрос.УстановитьПараметр("СпСостояний",СпСостояний);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() > 0 Тогда
		Флаг_ = Истина;
		Для каждого Стр Из ТЗ Цикл
			#Если Клиент Тогда
				СМГ_Сообщить("ОШИБКА! Есть незакрытый документ: "+Стр.Ссылка,СтатусСообщения.Важное); 
			#КонецЕсли
		КонецЦикла;
	КонецЕсли;
	
	Возврат Флаг_;
	
КонецФункции // ЕстьНезакрытыеДокументы(Автомобиль,ДатаПоследнегоПоступления)
