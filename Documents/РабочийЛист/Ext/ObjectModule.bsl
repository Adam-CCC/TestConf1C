	Функция НайтиРЛКО(СсылкаНаРЛ)
		
		РЛКО_ = "";
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РабочийЛистКредитногоОтдела.Ссылка КАК РЛКО,
		|	РабочийЛистКредитногоОтдела.ПометкаУдаления КАК ПометкаУдаления,
		|	РабочийЛистКредитногоОтдела.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.РабочийЛистКредитногоОтдела КАК РабочийЛистКредитногоОтдела
		|ГДЕ
		|	РабочийЛистКредитногоОтдела.ДокументОснование = &СсылкаНаРЛ
		|	И НЕ РабочийЛистКредитногоОтдела.ПометкаУдаления
		|	И РабочийЛистКредитногоОтдела.Статус <> ЗНАЧЕНИЕ(Справочник.СтатусыРабочегоЛиста.Отказ)";
		
		Запрос.УстановитьПараметр("СсылкаНаРЛ", СсылкаНаРЛ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			РЛКО_ = ВыборкаДетальныеЗаписи.РЛКО
		КонецЦикла;
		
		Возврат РЛКО_;
		
