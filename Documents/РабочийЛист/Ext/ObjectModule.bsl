Процедура ПроверитьВыдачу() Экспорт
	Если Статус = Справочники.СтатусыРабочегоЛиста.Продажа тогда	
		Флаг = Ложь;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Событие.Ссылка
		|ИЗ
		|	Документ.Событие КАК Событие
		|ГДЕ
		|	Событие.ДокументОснование = &ДокументОснование
		|	И Событие.ВидСобытия = &ВидСобытия
		|	И Событие.Состояние = &Состояние";
		
		Запрос.УстановитьПараметр("ВидСобытия", Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
		Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
		Запрос.УстановитьПараметр("Состояние", Перечисления.СостоянияСобытий.Завершено);
		
		Результат = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Флаг= Истина;
		КонецЦикла;
		
		Если Флаг тогда
			МашинаВыдана = Истина;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры		

