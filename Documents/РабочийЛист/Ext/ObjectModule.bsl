// Обработчик события при записи
//
Процедура ПриЗаписи(Отказ)
	Если НЕ дкПриЗаписи(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
	
	//Бондаренко++ 20240314
	Если ОбПраво("НеКорректироватьЛишнееПриЗаписиРЛилиСобытия") Тогда
		Возврат;
	КонецЕсли;
	//Бондаренко-- 20240314
	
	// Синхронизация реквизита «Контрагент» в подчиненных документах
	// РабочийЛистОтделаСтрахования и РабочийЛистКредитногоОтдела
	
	ЗапросПодчиненныхЛистов			= Новый Запрос();
	ЗапросПодчиненныхЛистов.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросПодчиненныхЛистов.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросПодчиненныхЛистов.УстановитьПараметр("Выдача", Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
	ЗапросПодчиненныхЛистов.Текст	= "ВЫБРАТЬ
	|	РабочийЛистКредитногоОтдела.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РабочийЛистКредитногоОтдела КАК РабочийЛистКредитногоОтдела
	|ГДЕ
	|	РабочийЛистКредитногоОтдела.ДокументОснование = &Ссылка
	|	И РабочийЛистКредитногоОтдела.Клиент <> &Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РабочийЛистОтделаСтрахования.Ссылка
	|ИЗ
	|	Документ.РабочийЛистОтделаСтрахования КАК РабочийЛистОтделаСтрахования
	|ГДЕ
	|	РабочийЛистОтделаСтрахования.ДокументОснование = &Ссылка
	|	И РабочийЛистОтделаСтрахования.Страхователь <> &Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Событие.Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ДокументОснование = &Ссылка
	|	И Событие.Контрагент <> &Контрагент
	|	И Событие.ВидСобытия <> &Выдача";
	
	тзПодчиненныхДокументов	= ЗапросПодчиненныхЛистов.Выполнить().Выгрузить();
	ОбновлятьКонтрагента	= Ложь;
	
	#Если Клиент Тогда
		Если (НЕ МонопольныйРежим()) И тзПодчиненныхДокументов.Количество()>0 
			//Гэндальф+++	
			// И Вопрос("Синхронизировать контрагента в подчиненных документах?", РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да 
			Тогда
			ОбновлятьКонтрагента	= Истина;
		КонецЕсли;
	#КонецЕсли
	
	Если ОбновлятьКонтрагента Тогда
		Для Каждого ТекСтрока Из тзПодчиненныхДокументов Цикл
			Подчиненный	= ТекСтрока.Ссылка.ПолучитьОбъект();
			Если Подчиненный<>Неопределено Тогда
				Если ТипЗнч(Подчиненный)=Тип("ДокументОбъект.РабочийЛистКредитногоОтдела") Тогда
					Подчиненный.Клиент	= Контрагент;
				ИначеЕсли ТипЗнч(Подчиненный)=Тип("ДокументОбъект.РабочийЛистОтделаСтрахования") Тогда
					Подчиненный.Страхователь	= Контрагент;
				ИначеЕсли ТипЗнч(Подчиненный)=Тип("ДокументОбъект.Событие") Тогда
					Подчиненный.Контрагент	= Контрагент;
				Иначе
					Продолжить;
				КонецЕсли;
				Попытка
					//Гэндальф+++
					//Подчиненный.Записать();
					Подчиненный.ЭтотОбъект.ОбменДанными.Загрузка = Истина;
					Подчиненный.Записать();
					//Гэндальф---
				Исключение КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//Гэндальф+++
	Если РегистрацияЗвонковИКонтактов <> Неопределено И РегистрацияЗвонковИКонтактов.Имя = "РегистрацияЗвонковИКонтактов" Тогда
		Попытка
			НаборЗаписей = РегистрыСведений.РегистрацияЗвонковИКонтактов.СоздатьНаборЗаписей(); 
			НаборЗаписей.Отбор.Автор.Установить(РегистрацияЗвонковИКонтактов.Автор);
			НаборЗаписей.Отбор.ДатаДень.Установить(РегистрацияЗвонковИКонтактов.ДатаДень); 
			НаборЗаписей.Отбор.ДатаВремя.Установить(РегистрацияЗвонковИКонтактов.ДатаВремя); 
			НаборЗаписей.Отбор.Сотрудник.Установить(РегистрацияЗвонковИКонтактов.Сотрудник);
			НаборЗаписей.Прочитать();
			НаборЗаписей[0].РабочийЛист = Ссылка;
			НаборЗаписей.Записать();
		Исключение
		КонецПопытки;	
	КонецЕсли;
	НоваяЗапись = РегистрыСведений.ИсторияСостоянияРабочегоЛиста.СоздатьМенеджерЗаписи();
	НоваяЗапись.Период = ТекущаяДата();
	НоваяЗапись.РабочийЛист = Ссылка;
	НоваяЗапись.Статус = Статус;
	НоваяЗапись.Документ = Ссылка;
	НоваяЗапись.Значение = Комментарий;
	
	НоваяЗапись.Записать(Истина);
	
	//Гэндальф---
	
	//Бондаренко++ 20200602
	ПоследнийСтатус = Справочники.СтатусыРабочегоЛиста.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИзмененияСтатусаРабочегоЛистаСрезПоследних.РабочийЛист,
	|	ИзмененияСтатусаРабочегоЛистаСрезПоследних.СтатусРабочегоЛиста
	|ИЗ
	|	РегистрСведений.ИзмененияСтатусаРабочегоЛиста.СрезПоследних КАК ИзмененияСтатусаРабочегоЛистаСрезПоследних
	|ГДЕ
	|	ИзмененияСтатусаРабочегоЛистаСрезПоследних.РабочийЛист = &РабочийЛист";
	Запрос.УстановитьПараметр("РабочийЛист", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПоследнийСтатус = ВыборкаДетальныеЗаписи.СтатусРабочегоЛиста;
	КонецЦикла;
	Если Ссылка.Статус <> ПоследнийСтатус Тогда
		НоваяЗапись = РегистрыСведений.ИзмененияСтатусаРабочегоЛиста.СоздатьМенеджерЗаписи();
		НоваяЗапись.Период = ТекущаяДата();
		НоваяЗапись.РабочийЛист = Ссылка;
		НоваяЗапись.СтатусРабочегоЛиста = Статус;
		НоваяЗапись.Записать(Истина);
	КонецЕсли; 
	//Бондаренко-- 20200602
	
	// + КМ
	Если Статус = Справочники.СтатусыРабочегоЛиста._г_База Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
		|	Событие.Ссылка
		|ИЗ
		|	Документ.Событие КАК Событие
		|ГДЕ
		|	Событие.ДокументОснование = &Ссылка
		|	И НЕ Событие.ПометкаУдаления
		|	И Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ТелефонныйЗвонок)
		|	И Событие.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщений.Исходящее)";
		
		Результат = Запрос.Выполнить();
		
		Если Результат.Пустой() Тогда
			
			ДокументСобытие = Документы.Событие.СоздатьДокумент();
			ДокументСобытие.Заполнить(Ссылка);
			ДокументСобытие.ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок;
			ДокументСобытие.ТипСообщения = Перечисления.ТипыСообщений.Исходящее;
			ДокументСобытие.Состояние = Перечисления.СостоянияСобытий.Завершено;
			ДокументСобытие.Приоритет = Перечисления.Важность.Средняя;
			ДокументСобытие.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	// - КМ
	
	///////// Эта проверка должна быть последней!
	// Семенихин 23.03.2021 +++++
	Если Не Отказ Тогда
		ЗаменитьМенеджераВСобытиях();
		СМ_ПроцедурыДляNissanAftersales.ОбновитьСтатусЛидаПоРЛ(Ссылка);
		
		Если ПредставлениеТелефона <> Ссылка.ПредставлениеТелефона Тогда
			ЗаменитьТелефонВСобытиях();
		КонецЕсли;
	КонецЕсли;	
	// Семенихин 04.11.2021 ----- 
	
	Если Не Отказ Тогда
		//РегистрыСведений.МаркетинговыеЛиды.ДобавитьЗапись(Ссылка);
	КонецЕсли;
КонецПроцедуры // ПриЗаписи()

