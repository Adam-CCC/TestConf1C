// Процедура - обработчик ввода на основании
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если НЕ дкОбработкаЗаполнения(ЭтотОбъект, Основание) Тогда Возврат; КонецЕсли;
	
	ТипОснования = ТипЗнч(Основание);
	Если ТипОснования = Тип("ДокументСсылка.ИзменениеПоказателейМотивацииМОП") Тогда
		ЭтотОбъект.ХозОперация = Справочники.ХозОперации.ИзменениеПоказателейМотивацииМОП;
 	КонецЕсли;
		
 	ЭтотОбъект.ДатаНачалаДействия = ТекущаяДата();
    
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ПоказателиМотивацииМОП.Очистить();
	
	Для Каждого ТекСтрокаСостав Из Состав Цикл
		Движение = Движения.ПоказателиМотивацииМОП.Добавить();
		Движение.Период = ДатаНачалаДействия;
		Движение.ВидМотивации = ТекСтрокаСостав.ВидМотивации;
 		Движение.ГодВыпускаC = ТекСтрокаСостав.ГодВыпускаС;
		Движение.ГодВыпускаПо = ТекСтрокаСостав.ГодВыпускаПо;
		Если обЗначениеНеЗаполнено(ТекСтрокаСостав.Марка) Тогда
			Движение.Модель = ТекСтрокаСостав.Модель;
			Движение.ВариантКомплектации = ТекСтрокаСостав.ВариантКомплектации;
		Иначе	
			Движение.Марка = ТекСтрокаСостав.Марка;
 		КонецЕсли;
 		Движение.СуммаБонуса = ТекСтрокаСостав.СуммаБонуса;
 	КонецЦикла;
 
КонецПроцедуры

Функция ОбработкаРеквизита(Имя,ТекСтрока=Неопределено,ЭтаФорма=Неопределено,ДопПараметры=Неопределено) Экспорт
	// ОБРАБОТКА РЕКВИЗИТОВ ДОКУМЕНТА 
 	Если Имя="Дата" Тогда		
		Рез=дкОбработкаРеквизита(ЭтотОбъект,Имя,ТекСтрока,ЭтаФорма,ДопПараметры);
 		Возврат Рез;
    ИначеЕсли Имя="Организация" Тогда
		Рез=дкОбработкаРеквизита(ЭтотОбъект,Имя,ТекСтрока,ЭтаФорма,ДопПараметры);
  		Возврат Рез;
 	ИначеЕсли Имя="ПодразделениеКомпании" Тогда
		Рез=дкОбработкаРеквизита(ЭтотОбъект,Имя,ТекСтрока,ЭтаФорма,ДопПараметры);
		Возврат Рез;
 	КонецЕсли;
КонецФункции	

//Бондаренко-- 20250522
 Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	ЭтоНовыйОбъект = Ложь;
	Попытка
	    ЭтоНовыйОбъект = ЭтотОбъект.ЭтоНовый();
 	Исключение
 	КонецПопытки; 
	Если ЭтоНовыйОбъект Тогда
		Попытка
 			ЭтотОбъект.СМ_Создатель = ПараметрыСеанса.Пользователь;
 		Исключение
		КонецПопытки;
		Попытка
 			ЭтотОбъект.СМ_ДатаСоздания = ТекущаяДата();
 		Исключение
 		КонецПопытки;
  	КонецЕсли;
	 
КонецПроцедуры
