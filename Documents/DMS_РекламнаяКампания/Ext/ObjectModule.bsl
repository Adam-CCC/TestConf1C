#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////#Область ОбработчикиСобытий

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	Если Не ПометкаУдаления Тогда
		РежимЗаписи		= РежимЗаписиДокумента.Проведение;
		РежимПроведения = РежимПроведенияДокумента.Неоперативный;
	КонецЕсли; 
	
	Если ВидОперации = Перечисления.DMS_ВидыОперацийРекламнойКампании.СозданиеШаблона Тогда
		ДилерскийЦентр = Неопределено;
	КонецЕсли; 
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	ЗаполнитьСуммуВзаиморасчетов();
	
	СуммаДокумента = Модели.Итог("ПлановаяСтоимость");
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения);
	
	Если ЭтоНовый() Тогда
		
		Валюта 				 = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		Представитель 		 = DMS_ЗначениеНастроекПовтИсп.ПолучитьОсновногоПредставителяПоНастройке(Автор,Представитель);
		ДилерскийЦентр = DMS_ЗначениеНастроекПовтИсп.ПолучитьОсновногоДилерскийЦентрПоНастройке(Автор,ДилерскийЦентр);
		
		ВидОперации			 = Перечисления.DMS_ВидыОперацийРекламнойКампании.РазмещениеКампании;
		КооперативнаяРеклама = Истина;
		Статус 				 = Перечисления.DMS_СтатусыРекламнойКампании.Действует;
		
		НоваяСтрока = Модели.Добавить();
		НоваяСтрока.КодСтроки = 1;
	
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ИнициализироватьДокумент();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	DMS_РекламныеКампанииСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	Документы.DMS_РекламнаяКампания.ИнициализироватьДанныеДокумента(Ссылка,ДополнительныеСвойства);
	
	DMS_РекламныеКампанииСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	DMS_РекламныеКампанииСервер.ОтразитьРекламныеКампании(ДополнительныеСвойства,Движения,Отказ);
	DMS_РекламныеКампанииСервер.ОтразитьРекламныеКампанииПредставителей(ДополнительныеСвойства,Движения,Отказ);
		
	DMS_РекламныеКампанииСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	DMS_РекламныеКампанииСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ВидОперации = Перечисления.DMS_ВидыОперацийРекламнойКампании.СозданиеШаблона Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ДилерскийЦентр");
		МассивНепроверяемыхРеквизитов.Добавить("ТипРазмещения");
		МассивНепроверяемыхРеквизитов.Добавить("МедиаРесурс");
		МассивНепроверяемыхРеквизитов.Добавить("ФорматМедиаРесурса");
		МассивНепроверяемыхРеквизитов.Добавить("Модели.Модель");
		МассивНепроверяемыхРеквизитов.Добавить("Модели.ПлановаяСтоимость");
	КонецЕсли; 
	
	DMS_ОбщегоНазначенияСервер.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты,МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

////#КонецОбласти

////#Область СлужебныеПроцедурыИФункции

////#Область ИнициализацияИЗаполнение

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Автор  = DMS_РекламныеКампанииСервер.ТекущийПользователь();
	МакетСогласован = Ложь;
	ОтчетСогласован = Ложь;
	ВАрхиве			= Ложь;
	ВидОперации		= Перечисления.DMS_ВидыОперацийРекламнойКампании.РазмещениеКампании;
	
КонецПроцедуры

////#КонецОбласти

// Процедура заполняет сумму взаиморасчетов в шапке документа.
//
// Параметры:
//	ДокументОбъект - ДокументОбъект - Текущий документ
// 
Процедура ЗаполнитьСуммуВзаиморасчетов() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	ТаблицаМодели.НомерСтроки,
		|	ТаблицаМодели.Модель,
		|	ТаблицаМодели.КодСтроки,
		|	ТаблицаМодели.ПлановаяСтоимость,
		|	ТаблицаМодели.ПлановаяСтоимостьВзаиморасчеты,
		|	&ВалютаВзаиморасчетов
		|ПОМЕСТИТЬ ТаблицаДокумента
		|ИЗ
		|	&Модели КАК ТаблицаМодели
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|	
		|ВЫБРАТЬ
		|	ТаблицаДокумента.НомерСтроки КАК НомерСтроки,
		|	ТаблицаДокумента.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
		|	ТаблицаДокумента.Модель КАК Модель,
		|	ТаблицаДокумента.КодСтроки КАК КодСтроки,
		|	ТаблицаДокумента.ПлановаяСтоимость КАК ПлановаяСтоимость,
		|
		|	ВЫБОР КОГДА ТаблицаДокумента.ПлановаяСтоимостьВзаиморасчеты = 0 ТОГДА
		|		(ТаблицаДокумента.ПлановаяСтоимость *
		|		ЕСТЬNULL(КурсыВалютДокумента.Курс, 1) * 
		|		ЕСТЬNULL(КурсыВалют.Кратность, 1)
		|		) / (
		|		ЕСТЬNULL(КурсыВалют.Курс, 1) * 
		|		ЕСТЬNULL(КурсыВалютДокумента.Кратность, 1)
		|		)
		|	ИНАЧЕ
		|		ТаблицаДокумента.ПлановаяСтоимостьВзаиморасчеты
		|	КОНЕЦ КАК ПлановаяСтоимостьВзаиморасчеты
		|ИЗ
		|	ТаблицаДокумента КАК ТаблицаДокумента
		|	
		|	// Определим курс валюты документа.
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|		РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсыВалютДокумента
		|	ПО
		|		Истина
		|		
		|	// Определим курс валюты взаиморасчетов.
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|		РегистрСведений.КурсыВалют.СрезПоследних(&Дата, ) КАК КурсыВалют
		|	ПО
		|		ТаблицаДокумента.ВалютаВзаиморасчетов = КурсыВалют.Валюта
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТаблицаДокумента.НомерСтроки
		|;");
		
	Запрос.УстановитьПараметр("Дата", 				  Дата);
	Запрос.УстановитьПараметр("Валюта", 	 		  Валюта);
	Запрос.УстановитьПараметр("ВалютаВзаиморасчетов", ВалютаВзаиморасчетов);
	Запрос.УстановитьПараметр("Модели", 			  Модели.Выгрузить());
	
	// Получим таблицу документа с рассчитанной суммой взаиморасчетов.
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = Модели.Найти(Выборка.НомерСтроки, "НомерСтроки");
		СтрокаТаблицы.ПлановаяСтоимостьВзаиморасчеты = Выборка.ПлановаяСтоимостьВзаиморасчеты;
		
	КонецЦикла;
	
КонецПроцедуры

////#КонецОбласти

#КонецЕсли
