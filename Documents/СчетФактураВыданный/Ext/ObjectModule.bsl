Функция СформироватьСписокСчетФактур(Сделка,ТекСФ,ДатаТекСФ)
	
	ТЗ_ = Новый ТаблицаЗначений;
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданныйИзПКО.Ссылка КАК Ссылка,
		|	СчетФактураВыданныйИзПКО.Номер КАК Номер,
		|	СчетФактураВыданныйИзПКО.Дата КАК Дата,
		|	СчетФактураВыданныйИзПКО.Проведен КАК Проведен,
		|	СчетФактураВыданныйИзПКО.НаАванс КАК НаАванс,
		|	СчетФактураВыданныйИзПКО.ДокументОснование.Сделка КАК ДокументОснованиеСделка,
		|	ТИПЗНАЧЕНИЯ(СчетФактураВыданныйИзПКО.ДокументОснование) КАК ТипДокОсн,
		|	СчетФактураВыданныйИзПКО.ДокументОснование КАК ДокументОснование,
		|	СчетФактураВыданныйИзПКО.ИдентификаторСтрокиВыписки КАК ИдентификаторСтрокиВыписки
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданныйИзПКО
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(СчетФактураВыданныйИзПКО.ДокументОснование) = ТИП(Документ.ПриходныйКассовыйОрдер)
		|	И СчетФактураВыданныйИзПКО.НаАванс
		|	И СчетФактураВыданныйИзПКО.Проведен
		|	И СчетФактураВыданныйИзПКО.ДокументОснование.Сделка = &Сделка
		|	И СчетФактураВыданныйИзПКО.Ссылка <> &ТекСФ
		|	И СчетФактураВыданныйИзПКО.Дата < &ДатаТекСФ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетФактураВыданныйИзВыписки.Ссылка,
		|	СчетФактураВыданныйИзВыписки.Номер,
		|	СчетФактураВыданныйИзВыписки.Дата,
		|	СчетФактураВыданныйИзВыписки.Проведен,
		|	СчетФактураВыданныйИзВыписки.НаАванс,
		|	ВыпискаСостав.Сделка,
		|	ТИПЗНАЧЕНИЯ(СчетФактураВыданныйИзВыписки.ДокументОснование),
		|	СчетФактураВыданныйИзВыписки.ДокументОснование,
		|	СчетФактураВыданныйИзВыписки.ИдентификаторСтрокиВыписки
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданныйИзВыписки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВыпискаСостав.Ссылка КАК Ссылка,
		|			ВыпискаСостав.Сделка КАК Сделка,
		|			ВыпискаСостав.ИдентификаторСтрокиВыписки КАК ИдентификаторСтрокиВыписки
		|		ИЗ
		|			Документ.Выписка.Состав КАК ВыпискаСостав) КАК ВыпискаСостав
		|		ПО СчетФактураВыданныйИзВыписки.ДокументОснование = ВыпискаСостав.Ссылка
		|			И СчетФактураВыданныйИзВыписки.ИдентификаторСтрокиВыписки = ВыпискаСостав.ИдентификаторСтрокиВыписки
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(СчетФактураВыданныйИзВыписки.ДокументОснование) = ТИП(Документ.Выписка)
		|	И СчетФактураВыданныйИзВыписки.НаАванс
		|	И СчетФактураВыданныйИзВыписки.Проведен
		|	И СчетФактураВыданныйИзВыписки.Ссылка <> &ТекСФ
		|	И СчетФактураВыданныйИзВыписки.Дата < &ДатаТекСФ
		|	И ВыпискаСостав.Сделка = &Сделка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Запрос.УстановитьПараметр("Сделка",Сделка);
	Запрос.УстановитьПараметр("ТекСФ",ТекСФ);
	Запрос.УстановитьПараметр("ДатаТекСФ",ДатаТекСФ);
	
	ТЗ_ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ_.Количество() > 0 Тогда
		Если РольДоступна("ПолныеПрава") Тогда
			//ТЗ_.ВыбратьСтроку();
 		КонецЕсли;
  	КонецЕсли;
 	
  	Возврат ТЗ_;
 
КонецФункции // СформироватьСписокСчетФактур()


Функция СформироватьСписокПредыдущихСФнаАванс()
	
	Сделка = "";
	СписокПредыдущихСФнаАванс_ = "";
	
	Если ТипЗНЧ(ЭтотОбъект.ДокументОснование)=Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Сделка = ЭтотОбъект.ДокументОснование.Сделка;
	ИначеЕсли ТипЗНЧ(ЭтотОбъект.ДокументОснование)=Тип("ДокументСсылка.Выписка") Тогда	
		Сделка = ЭтотОбъект.ДокументОснование.Состав.Найти(ЭтотОбъект.ИдентификаторСтрокиВыписки,"ИдентификаторСтрокиВыписки").Сделка;
	//Бондаренко++ 20260214	
	ИначеЕсли  ТипЗНЧ(ЭтотОбъект.ДокументОснование)=Тип("ДокументСсылка.РеализацияАвтомобилей") Тогда	
		Сделка = ЭтотОбъект.ДокументОснование.Ссылка.Автомобили[0].ЗаказНаАвтомобиль;
	//Бондаренко-- 20260214		
	КонецЕсли;
	
	Если НЕ обЗначениеНеЗаполнено(Сделка) Тогда
		ТЗ_СФ = СформироватьСписокСчетФактур(Сделка,Ссылка,Ссылка.Дата);
		Для каждого Стр Из ТЗ_СФ Цикл
			Если СписокПредыдущихСФнаАванс_ = "" Тогда
				СписокПредыдущихСФнаАванс_ = ""+СокрЛП(ТипЗнч(Стр.Ссылка))+" "+СокрЛП(Стр.Номер)+" от "+Формат(Стр.Дата,"ДФ=dd.MM.yyyy")+";"; 
 			Иначе
				СписокПредыдущихСФнаАванс_ = СокрЛП(СписокПредыдущихСФнаАванс_)+" "+СокрЛП(ТипЗнч(Стр.Ссылка))+" "+ СокрЛП(Стр.Номер)+" от "+Формат(Стр.Дата,"ДФ=dd.MM.yyyy")+";"; 
 			КонецЕсли;
 		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокПредыдущихСФнаАванс_;
  
КонецФункции // СформироватьСписокПредыдущихСФнаАванс()
