Функция НормализоватьНомер(Номер_)
	
	НовНомер = Номер_;
	
	Для жи = 1 По СтрДлина(Номер) Цикл
		Если Найти("0123456789",Сред(Номер_,жи,1)) > 0 Тогда
			БуквеннаяЧасть = Сред(Номер_,1,жи-1);
			ЦифроваяЧасть  = Сред(Номер_,жи);
			Прервать;
		КонецЕсли;   
	КонецЦикла;
	
	ЦифроваяЧасть  = СокрЛП(ЦифроваяЧасть);
	ЦифроваяЧастьЧ  = Число(ЦифроваяЧасть);
	ЦифроваяЧасть  = СтрЗаменить(ЦифроваяЧастьЧ,Символы.НПП,"");
	
	Если Прав(БуквеннаяЧасть,1) = "V" Тогда
		ЦифроваяЧасть  = СМ_Ниссан.ДополнитьСтрокуЛ(ЦифроваяЧасть,11-СтрДлина(БуквеннаяЧасть),"0");
	КонецЕсли;
	
	НовНомер = БуквеннаяЧасть+ЦифроваяЧасть;
	
	Возврат НовНомер;
  
КонецФункции // НормализоватьНомер()


