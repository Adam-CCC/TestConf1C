Функция ПолучитьПлатежныеДокументы () Экспорт 
	ОбработкаДерево = Обработки.ДеревоДокументов.Создать();
	ОбработкаДерево.ВыбДокумент = ДокументОснование; // " = Ссылка;" - было (Семенихин 02.02.2018)
    ОбработкаДерево.ПолучитьДеревоДокументов(ОбработкаДерево.ДеревоДокументов) ;
	ТаблицаДокументов = г_Функции.ЗапускПреодразованияДереваВТаблицуЗначений(ОбработкаДерево.ДеревоДокументов);
	МассивДокументовОснований = Новый Массив;
	Для Каждого стр из ТаблицаДокументов цикл
		Если стр.ВидДокумента = "Заказ на автомобиль" или стр.ВидДокумента = "Счет на оплату за автомобили"
			Или стр.ВидДокумента = "Реализация автомобилей" тогда
			МассивДокументовОснований.Добавить(стр.Документ);
		КонецЕсли;
	КонецЦикла;
		
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдер.Номер,
	               |	ПриходныйКассовыйОрдер.Дата
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	               |ГДЕ
	               |	ПриходныйКассовыйОрдер.Сделка В(&Сделка)
	               |	И ПриходныйКассовыйОрдер.Организация = &Организация
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВыпискаСостав.ПлатежноеПоручениеОснование,
	               |	NULL
	               |ИЗ
	               |	Документ.Выписка.Состав КАК ВыпискаСостав
	               |ГДЕ
	               |	ВыпискаСостав.Сделка В(&Сделка)
	               |	И ВыпискаСостав.Ссылка.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Сделка",МассивДокументовОснований);	
	Запрос.УстановитьПараметр("Организация",Организация);
	ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
    ПлатежныйДокумент = "";
	
	// Семенихин 02.02.2018 +++++
	Для Каждого стр из ТаблицаДокументов цикл
		ПлатежныйДокумент = ПлатежныйДокумент + ?(ПлатежныйДокумент = "", стр.Номер, "; " + стр.Номер);
		Если ЗначениеЗаполнено(стр.Дата) Тогда
			ПлатежныйДокумент = ПлатежныйДокумент + " от " + Формат(стр.Дата,"ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЦикла;
	// Семенихин 02.02.2018 +++++
	
	Возврат ПлатежныйДокумент;	
КонецФункции

