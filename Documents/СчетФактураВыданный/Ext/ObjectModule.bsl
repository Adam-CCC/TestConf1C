		НовСтр = Товары.Добавить();
		НовСтр.Номенклатура = Основание.НоменклатураУслуга;
		НовСтр.ЕдиницаИзмерения = Основание.НоменклатураУслуга.ОсновнаяЕдиницаИзмерения;
		НовСтр.Количество = 1;
		НовСтр.Коэффициент = 1;
		НовСтр.Сумма = Основание.Состав.Итог("Сумма");
