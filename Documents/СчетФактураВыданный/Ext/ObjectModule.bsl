		Грузополучатель_ = обПолучитьЗначениеСвойства(ЭтотОбъект,"Грузополучатель",ЭтотОбъект.Грузополучатель);
	КонецЕсли;
	Если ЭтотОбъект.Грузополучатель <> Грузополучатель_ Тогда
		ЭтотОбъект.Грузополучатель = Грузополучатель_;
 	КонецЕсли;
	//Бондаренко-- 20250215
 	
	флОтказ = Ложь;
	
	Если Не РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
