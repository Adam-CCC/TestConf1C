			КонецЕсли; 
		КонецЕсли;
		// откроем введенную ранее СФ, отменим ввод новой
		Если НЕ СчетФактура = Неопределено Тогда
			ФормаСФ = СчетФактура.ПолучитьФорму();
			Если ФормаСФ.Открыта() Тогда
				ФормаСФ.Активизировать();
			Иначе
				ФормаСФ.Открыть();
