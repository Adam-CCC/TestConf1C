				Если ТекущаяСтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
				//Бондаренко-- 20241225	
					СМГ_Сообщить("Ошибка! Организация """+СокрЛП(ЭтотОбъект.Организация)+""" находится на ""Упрощённой системе налогооболожения"" с нулевой ставкой НДС и не имеет права выписывать счета-фактуры.",СтатусСообщения.ОченьВажное);
					флОтказ=Истина;    
				//Бондаренко++ 20241225	
				КонецЕсли;
			    //Бондаренко-- 20241225
 			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;
	
	Возврат флОтказ;
	
КонецФункции // СМГ_ПередЗаписью(РежимЗаписи)
