		ОбработкаРеквизита("Товары.СуммаВсего",НоваяСтрока);
		Основание=Неопределено;
		//Бондаренко++ 20220830	
	ИначеЕсли ТипЗнч(Основание)=Тип("ДокументСсылка.РеестрОплаченныхЗН") Тогда   
