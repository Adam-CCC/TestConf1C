Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Renault_СтраховыеПолисы
	Движения.Renault_СтраховыеПолисы.Записывать=Истина;
	Движения.Renault_СтраховыеПолисы.Очистить();

	Движение = Движения.Renault_СтраховыеПолисы.Добавить();
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.СтраховаяКомпания = СтраховаяКомпания;
	Движение.ВидСтрахования = ВидСтрахования;
	Движение.ТипБСО = ТипБСО;
	Движение.СерияБСО = СерияБСО;
	Движение.НомерБСО = НомерБСО;
	Движение.Страхователь = Контрагент;
	Движение.Количество = 1;
	Движение.СтраховаяСумма = СтраховаяСумма;
	Движение.СтраховаяПремия = СуммаДокумента;
	
	Движения.Renault_ВзаиморасчетыСоСтрахователями.Записывать = Истина;
	Движения.Renault_ВзаиморасчетыСоСтрахователями.Очистить();
	Если НЕ ОплатаСК Тогда
		Движение = Движения.Renault_ВзаиморасчетыСоСтрахователями.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.Страхователь = Контрагент;
		Движение.СтраховойПолис = Ссылка;
		Движение.Сумма = СуммаДокумента;
	КонецЕсли;	

	Движения.Renault_СтатусыБСО.Записывать = Истина;
	Движения.Renault_СтатусыБСО.Очистить();
	Если Состояние = Перечисления.Renault_СтатусыСтраховыхПолисов.ВРаботе ИЛИ Состояние = Перечисления.Renault_СтатусыСтраховыхПолисов.Продан ИЛИ Состояние = Перечисления.Renault_СтатусыСтраховыхПолисов.Испорчен Тогда
		
		Если Состояние = Перечисления.Renault_СтатусыСтраховыхПолисов.ВРаботе ИЛИ Состояние = Перечисления.Renault_СтатусыСтраховыхПолисов.Продан Тогда
			мСтатус = Перечисления.Renault_СтатусыБСО.Продан;
		ИначеЕсли Состояние = Перечисления.Renault_СтатусыСтраховыхПолисов.Испорчен Тогда
			мСтатус = Перечисления.Renault_СтатусыБСО.Испорчен;
		КонецЕсли;	
		
		Для Каждого Стр Из ТаблицаБСО Цикл
			Движение = Движения.Renault_СтатусыБСО.Добавить();
			Движение.Период = Дата;
			Движение.Организация = Организация;
			Движение.СтраховаяКомпания = СтраховаяКомпания;
			Движение.ТипБСО = Стр.ТипБСО;
			Движение.СерияБСО = Стр.СерияБСО;
			Движение.НомерБСО = Стр.НомерБСО;
			Движение.Статус = мСтатус;
		КонецЦикла;	
		
		//подвинем регистр Пролонгация полисов, если указан Предыдущий полис
		Если ЗначениеЗаполнено(ПредыдущийПолис) И мСтатус = Перечисления.Renault_СтатусыБСО.Продан тогда
			Движения.Renault_ПролонгацияПолисов.Записывать = Истина;
			Движения.Renault_ПролонгацияПолисов.Очистить();
			Движение = Движения.Renault_ПролонгацияПолисов.Добавить();
			Движение.Период = Дата;
			Движение.КаналВхода = Перечисления.Renault_КаналВхода_Страховка.Пролонгация;
			
			//данные из Предыдущего полиса
			Движение.СтраховаяКомпания = ПредыдущийПолис.СтраховаяКомпания;
			Движение.ВидСтрахования = ПредыдущийПолис.ВидСтрахования;
			Движение.Контрагент = ПредыдущийПолис.Контрагент;
			Движение.Результат = Перечисления.Renault_РезультатЗвонкаКлиенту_Страховка.Застраховался;
			Движение.Комментарий = "";
			
			Движение.НовыйПолис = Ссылка;
			Движение.Пользователь = Агент;
			Движение.СтраховойПолис = ПредыдущийПолис;
			Движение.ТочкаПродаж = ПредыдущийПолис.ТочкаПродаж;
			Движение.СерияБСО = ПредыдущийПолис.СерияБСО;
			Движение.НомерБСО = ПредыдущийПолис.НомерБСО;
			Движение.Автомобиль = ПредыдущийПолис.Автомобиль;
			Движение.ДатаОкончанияСрокаДействия = ПредыдущийПолис.ДатаОкончанияСтрахования;
		ИначеЕсли ЗначениеЗаполнено(ПредыдущийПолис) И мСтатус = Перечисления.Renault_СтатусыБСО.Испорчен тогда
			Движения.Renault_ПролонгацияПолисов.Записывать = Истина;
			Движения.Renault_ПролонгацияПолисов.Очистить();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

