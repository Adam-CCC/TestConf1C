Процедура СформироватьЗаказПокупателя(Отказ) Экспорт
//	Если НЕ ЗаказПокупателя.Пустая() Тогда Возврат КонецЕсли;
	
	Заказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	Заказ.ПроцентПредоплаты = 50;
	Заказ.Дата = ТекущаяДата();
	Заказ.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенПродажи;
	Заказ.СрокПоставки = Заказ.Дата;
	Заказ.ХозОперация = Справочники.ХозОперации.ЗаказПокупателя;
	Заказ.СкладКомпании = Справочники.СкладыКомпании.ОсновнойСкладКомпании;
	Заказ.Автор = ПараметрыСеанса.Пользователь;
	Заказ.Автомобиль = Автомобиль;
	Заказ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	Заказ.ВидОплаты = Перечисления.ВидыОплаты.НаличныйРасчет;
	Заказ.ДатаОперации = ТекущаяДата();
	Заказ.ДатаСоздания = ТекущаяДата();
	Заказ.Контрагент = Контрагент;
	Заказ.ДоговорВзаиморасчетов = ПолучитьДоговорКонтрагента();
	Заказ.КурсВалютыУпр = 1;
	Заказ.КурсДокумента = 1;
	Заказ.Менеджер = Агент;
	Заказ.Организация = Организация;
	Заказ.ПодразделениеКомпании = ТочкаПродаж;
	Строка = Заказ.Товары.Добавить();
	Строка.Количество = 1;
	Строка.Номенклатура = ФинансоваяУслуга.ВидУслуги.Номенклатура;
	Строка.ЕдиницаИзмерения = ФинансоваяУслуга.ВидУслуги.Номенклатура.ОсновнаяЕдиницаИзмерения;
	Строка.Коэффициент = 1;
	Строка.Цена = СуммаДокумента;
	
	Если Организация.ОсвобожденОтНДС Тогда
		Строка.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;
	Иначе
		Строка.СтавкаНДС = ФинансоваяУслуга.ВидУслуги.Номенклатура.СтавкаНДС;
		//НДС в том числе
		Строка.СуммаНДС = ФинансоваяУслуга.ВидУслуги.Номенклатура.СтавкаНДС.Ставка * Строка.Цена / (100 + ФинансоваяУслуга.ВидУслуги.Номенклатура.СтавкаНДС.Ставка);
	КонецЕсли;
	
	Строка.Сумма = СуммаДокумента;
	Заказ.Записать();
	ЗаказПокупателя = Заказ.Ссылка;
	
КонецПроцедуры	

Функция ПроверкаПроведения(Отказ)
	
	//Если РежимПроведения=РежимПроведенияДокумента.Оперативный Тогда
		//К+    //На вермя проведения старых документов, потом убрать
		ПроводитьБезПроверок = Renault_AdvancedСервер.РазрешитьПроводитьЗаказНарядБезОпределенныхПроверок();
		//К-

		Если НЕ ПроводитьБезПроверок И ВидСтрахования.НеобходимОбъектСтрахования И Не ЗначениеЗаполнено(Автомобиль) Тогда
			DMS_ОбщегоНазначенияСервер.СообщитьОбОшибке("Для данного вида страхования необходимо заполнить автомобиль ",Отказ)
		КонецЕсли;
		
		//проверить всю информацию по срокам страхования
		//отрицательный срок 
		Если ДатаОкончанияСтрахования-ДатаНачалаСтрахования<0 тогда
			DMS_ОбщегоНазначенияСервер.СообщитьОбОшибке("Дата окончания страхования не может быть ранее даты начала страхования!",Отказ)
		КонецЕсли;
		
		//кривые даты
		ГодНачала = Год(ДатаНачалаСтрахования);
		ГодОкончания = Год(ДатаОкончанияСтрахования);
		//дата начала может быть только текущего года (или прошлого)
		Если НЕ (ГодНачала = (Год(Дата) -1) или ГодНачала = Год(Дата) или  ГодНачала = (Год(Дата) + 1)) тогда
			DMS_ОбщегоНазначенияСервер.СообщитьОбОшибке("Некорректная дата начала страхования",Отказ)
		КонецЕсли;
		
		//пустая дата окончания и начала
		Если НЕ ЗначениеЗаполнено(ДатаНачалаСтрахования) или НЕ ЗначениеЗаполнено(ДатаОкончанияСтрахования) тогда
			DMS_ОбщегоНазначенияСервер.СообщитьОбОшибке("Заполните даты начала и окончания страхования",Отказ)
		КонецЕсли;
		
		Если  НЕ ПроводитьБезПроверок И НЕ ЗначениеЗаполнено(АлгоритмРассрочки) тогда
			DMS_ОбщегоНазначенияСервер.СообщитьОбОшибке("Заполните алгоритм рассрочки",Отказ)
		КонецЕсли;
		Если  НЕ ПроводитьБезПроверок И  АлгоритмРассрочки.Алгоритмы.Количество() И (НЕ ГрафикОплаты.Количество()) тогда
			DMS_ОбщегоНазначенияСервер.СообщитьОбОшибке("Заполните график рассрочки платежей",Отказ)
		КонецЕсли;
		
		Если  НЕ ПроводитьБезПроверок И НЕ ЗаменаБезДоплаты И СуммаПремии = 0 Тогда
			Сообщить("Страховая премия не может быть нулевой, если это не замена без доплаты"); Отказ = истина
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			Сообщить("Необходимо заполнить Страхователя!");
			Отказ = Истина
		КонецЕсли;
		//Если НЕ ЗначениеЗаполнено(ДоговорКонтрагента) Тогда Сообщить("Необходимо заполнить Договор!"); Отказ=Истина КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТипБСО) Тогда
			Сообщить("Необходимо заполнить тип БСО!");
			Отказ = Истина
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НомерБСО) Тогда
			Сообщить("Необходимо заполнить номер БСО!");
			Отказ = Истина
		КонецЕсли;
		
		ТаблицаБСО = Renault_УчетБСО.ПолучитьПустуюТаблицуБСО();
		НоваяСтрока = ТаблицаБСО.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект);
		НоваяСтрока.Количество = 1;
		
		//бланк квитанции
		Если НомерБСО_Квитанция<>"" Тогда
			НоваяСтрока = ТаблицаБСО.Добавить();
			НоваяСтрока.Организация = Организация;
			НоваяСтрока.СтраховаяКомпания = СтраховаяКомпания;
			НоваяСтрока.ТочкаПродаж = ТочкаПродаж;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.ТипБСО = ТипБСО_Квитанция;
			НоваяСтрока.СерияБСО = СерияБСО_Квитанция;
			НоваяСтрока.НомерБСО = НомерБСО_Квитанция;
		КонецЕсли;	
		
		ЕстьБСОНаТочке = Renault_УчетБСО.ПроверитьНаличиеБСО(Дата, ТаблицаБСО, Организация, СтраховаяКомпания, ТочкаПродаж, истина);
		Если НЕ ЕстьБСОНаТочке Тогда
			Отказ = Истина
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СтраховаяКомпания", СтраховаяКомпания);
		Запрос.УстановитьПараметр("ТаблицаБСО", ТаблицаБСО);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.Текст = "
		|Выбрать т.ТипБСО, т.СерияБСО, т.НомерБСО Поместить т Из &ТаблицаБСО т;
		|ВЫБРАТЬ * Из РегистрНакопления.Renault_СтраховыеПолисы 
		|ГДЕ
		|	СтраховаяКомпания = &СтраховаяКомпания
		|	И (ТипБСО,СерияБСО,НомерБСО) В (Выбрать ТипБСО,СерияБСО,НомерБСО Из т)
		|	И Регистратор <> &Ссылка";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Сообщить("Страховой полис " + СокрЛП(Выборка.ТипБСО) + " " + СокрЛП(Выборка.СерияБСО) + " " + СокрЛП(Выборка.НомерБСО) + " уже введен для страхователя " + Выборка.Страхователь);
			Отказ = истина;
		КонецЦикла;
		
	//КонецЕсли;
	
	Возврат НЕ Отказ
	
КонецФункции

Функция ПолучитьДоговорКонтрагента()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
	|	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	|ГДЕ
	|	ДоговорыВзаиморасчетов.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец",Контрагент);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	если ВыборкаДетальныеЗаписи.Следующий() тогда
		возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	возврат Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	
КонецФункции


Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	ПроверкаПроведения(Отказ);
КонецПроцедуры

