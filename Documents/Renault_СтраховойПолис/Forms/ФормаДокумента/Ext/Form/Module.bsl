Функция ДокументРасторжения()
	
	Запрос = Новый Запрос("Выбрать Регистратор Из РегистрСведений.Renault_РасторгнутыеПолисы ГДЕ СтраховойПолис=&Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Регистратор
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции

