&НаКлиенте
Процедура кнСостояние(Состояние="")
	
	Если ТипЗнч(Состояние) = Тип("КомандаФормы") Тогда
		Состояния = Новый СписокЗначений;
		Для Каждого Эл Из Перечисления.Renault_СтатусыСтраховыхПолисов Цикл
			Состояния.Добавить(Эл);
		КонецЦикла;
		Если ЗначениеЗаполнено(Объект.Состояние) Тогда
			Состояния.НайтиПоЗначению(Объект.Состояние).Пометка = Истина;
		КонецЕсли;
		Парам = Новый Структура;
		Парам.Вставить("Список", Состояния);
		Парам.Вставить("Заголовок", "Состояние страхового полиса");
		Парам.Вставить("МножественныйВыбор", Ложь);
		//Парам.Вставить("КоличествоЭлементовВСтроке",3);
		Парам.Вставить("ШиринаЭлемента", 14);
		Парам.Вставить("ВысотаЭлемента", 2);
		Состояние = ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений", Парам,ЭтаФорма);
	КонецЕсли;
	
	Если Состояние <> Неопределено Тогда
		//СтароеСостояние=Объект.Состояние;
		Объект.Состояние = Состояние;
		Модифицированность = Истина;
		//Если НЕ ИзменитьСостояние() Тогда Объект.Состояние=СтароеСостояние КонецЕсли;
	КонецЕсли;
	УправлениеЭлементами();
	
КонецПроцедуры

