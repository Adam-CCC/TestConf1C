Процедура кнСформироватьЗаказПокупателя(Команда)
	
	Если НЕ Объект.ЗаказПокупателя.Пустая() или СформироватьЗаказПокупателя() Тогда
		ОткрытьЗначение(Объект.ЗаказПокупателя);
	КонецЕсли
	
КонецПроцедуры

Функция СформироватьЗаказПокупателя()
	
	Если Объект.Ссылка.Пустая() Тогда
		Сообщить("Документ не записан", СтатусСообщения.Информация);
		Возврат Ложь;
	КонецЕсли;
	Модуль = РеквизитФормыВЗначение("Объект");
	Отказ = Ложь;
	Попытка
		Модуль.СформироватьЗаказПокупателя(Отказ);
	Исключение
		//Предупреждение("При формировании заказа произошла ошибка, подробности в служебных сообщенниях!");
		Возврат Ложь;
	КонецПопытки;
	
	Если НЕ Отказ Тогда
		ЗначениеВРеквизитФормы(Модуль, "Объект");
		Модифицированность = Истина;
		УстановитьПараметрыДинамическогоСпискаВзаиморасчеты();
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

