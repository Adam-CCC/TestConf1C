&НаКлиенте
Процедура кнЗаполнитьГрафик(Команда)
	
	ЗаполнитьГрафик();
	
КонецПроцедуры

Процедура ЗаполнитьГрафик()
	
	Модуль = РеквизитФормыВЗначение("Объект");
	
	Если ЗначениеЗаполнено(Объект.АлгоритмРассрочки) Тогда
		Объект.ГрафикОплаты.Очистить();
		//НачДата = ДатаСтрахования;
		Для Каждого Строка Из Объект.АлгоритмРассрочки.Алгоритмы Цикл
			НоваяСтрока = Объект.ГрафикОплаты.Добавить();
			НоваяСтрока.ДатаОплаты = ДобавитьМесяц(Объект.ДатаНачалаСтрахования,Строка.КоличествоМесяцев);
			НоваяСтрока.Сумма = Модуль.ПолучитьСуммуДокумента() * Строка.Процент / 100;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

