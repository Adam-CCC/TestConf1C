&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ПараметрыСеанса.Renault_ПраваПользователя.СотрудникОФУ И Не ПараметрыСеанса.Renault_ПраваПользователя.РуководительОФУ Тогда 
		Отказ = Истина;
		Сообщить("Нет прав на Учет БСО",СтатусСообщения.Внимание);
		Возврат
	КонецЕсли;
	
	
	Если Объект.Ссылка.Пустая() Тогда
		Если Не ЗначениеЗаполнено(Объект.Агент) Тогда
			Объект.Агент = ПараметрыСеанса.Пользователь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
			Объект.Организация = ПараметрыСеанса.Организация;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ТочкаПродаж) Тогда
			Объект.ТочкаПродаж = ПараметрыСеанса.ПодразделениеКомпании;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.Состояние) Тогда
			Объект.Состояние = Перечисления.Renault_СтатусыСтраховыхПолисов.Открыт;
		КонецЕсли;
		//Объект.КвитанцияБСО=Справочники.Renault_БСО_НаименованияБланковСтрогойОтчетности.Квитанция;
		//Объект.ПолисБСО=Документы.Renault_СтраховойПолис.ПолучитьНаименованиеБСО(Объект); - станет известно после выбора вида страховки
		Объект.ДатаВыдачи = ТекущаяДата();
	КонецЕсли;	
	
	УправлениеЭлементами();
	УстановитьПараметрыДинамическогоСпискаБСО();
	УстановитьПараметрыДинамическогоСпискаВзаиморасчеты();
	
КонецПроцедуры

