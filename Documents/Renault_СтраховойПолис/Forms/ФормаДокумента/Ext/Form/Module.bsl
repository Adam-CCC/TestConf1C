Процедура ПересчитатьСуммы()
	
	//Объект.СтраховаяСумма=Объект.ПлатежнаяИнформация.Итог("СтраховаяСумма");
	//Объект.СуммаПремии=Объект.ПлатежнаяИнформация.Итог("СтраховаяПремия");
	
	//доплата
	Если ЗначениеЗаполнено(Объект.ЗаменяемыйПолис) Тогда
		Объект.СуммаДоплаты = ?(Объект.ЗаменаБезДоплаты, 0, Объект.СуммаПремии - Объект.ЗаменяемыйПолис.СуммаДокумента);
	Иначе
		Объект.СуммаДоплаты=0;
	КонецЕсли;	
	
	Объект.СуммаДокумента = РеквизитФормыВЗначение("Объект").ПолучитьСуммуДокумента();
	Если Не Объект.Организация.ОсвобожденОтНДС Тогда
		// Трояновский К.Е. 15.02.2019 12:00:12 {
		// Закомментировано по DMSCOR-1087
		//Если Объект.Дата >= '20190101' Тогда
		//	Объект.СуммаНДС=Объект.СуммаДокумента*20/120;
		//Иначе
		//	Объект.СуммаНДС=Объект.СуммаДокумента*18/118;
		//КонецЕсли;
		Объект.СуммаНДС = Объект.СуммаДокумента * Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка / (100 + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка);
		// Трояновский К.Е. 15.02.2019 12:00:12 }
	КонецЕсли;
	
КонецПроцедуры
