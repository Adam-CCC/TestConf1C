&НаКлиенте
Процедура ЛицаДопущенныеКУправлениюТСПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Объект.ЛицаДопущенныеКУправлениюТС.Количество() = 0 Тогда
		Отказ = Истина;
		ДобавитьВодительскоеУдостоверениеКонтрагента();
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьВодительскоеУдостоверениеКонтрагента() Экспорт
	
	СтрЛицДопУпр = Объект.ЛицаДопущенныеКУправлениюТС.Добавить();
	СтрЛицДопУпр.ВодительскоеУдостоверение = ВодительскоеУдостоверение(Объект.Контрагент);
	СтрЛицДопУпр.ГодНачалаВодительскогоСтажа = СтрЛицДопУпр.ВодительскоеУдостоверение.ДатаВыдачи;
	СтрЛицДопУпр.ЛицоДопущенное = Объект.Контрагент;
	СтрЛицДопУпр.ВодительскийСтаж = Год(Объект.Дата) - Год(СтрЛицДопУпр.ГодНачалаВодительскогоСтажа);
	
КонецПроцедуры	

Функция ВодительскоеУдостоверение(Контрагент)
	
	Запрос = Новый Запрос("Выбрать Ссылка
						|Из Справочник.ПодтверждающиеДокументы
						|ГДЕ Владелец=&Контрагент И НЕ ПометкаУдаления
						|	И ВидПодтверждающегоДокумента=Значение(Перечисление.ВидыДокументов.Удостоверение)");
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ВодительскоеУдостоверениеПриИзменении(Элемент)
	
	Элементы.ЛицаДопущенныеКУправлениюТС.ТекущиеДанные.ГодНачалаВодительскогоСтажа = Элементы.ЛицаДопущенныеКУправлениюТС.ТекущиеДанные.ВодительскоеУдостоверение.ДатаВыдачи;
	Элементы.ЛицаДопущенныеКУправлениюТС.ТекущиеДанные.ВодительскийСтаж = Год(Объект.Дата) - Год(Элементы.ЛицаДопущенныеКУправлениюТС.ТекущиеДанные.ГодНачалаВодительскогоСтажа);
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетДатыОкончанияСтрахования(Элемент)
	
	Если Объект.ТипПериодаСтрахования = Перечисления.DMS_ПериодичностьДействияБаллов.Год Тогда
		Объект.ДатаОкончанияСтрахования = ДобавитьМесяц(Объект.ДатаНачалаСтрахования, 12 * Объект.СрокСтрахования) - 86400
	ИначеЕсли Объект.ТипПериодаСтрахования = Перечисления.DMS_ПериодичностьДействияБаллов.Месяц Тогда
		Объект.ДатаОкончанияСтрахования = ДобавитьМесяц(Объект.ДатаНачалаСтрахования, Объект.СрокСтрахования) - 86400
	ИначеЕсли Объект.ТипПериодаСтрахования = Перечисления.DMS_ПериодичностьДействияБаллов.День Тогда
		Объект.ДатаОкончанияСтрахования = Объект.ДатаНачалаСтрахования + Объект.СрокСтрахования * 86400 - 86400
	КонецЕсли;
	
	Если Объект.ДатаНачалаИспользованияТС1 = '00010101' И Объект.ДатаОкончанияИспользованияТС1 = '00010101' Тогда 
		Объект.ДатаНачалаИспользованияТС1 = Объект.ДатаНачалаСтрахования;
		Объект.ДатаОкончанияИспользованияТС1 = Объект.ДатаОкончанияСтрахования;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.Ссылка.Пустая() Тогда
		Если Не Объект.БезФраншизы И Объект.СуммаФраншизы = 0 Тогда
			Сообщить("Укажите сумму франшизы или отметьте, что полис без франшизы!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительскоеУдостоверениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ЛицаДопущенныеКУправлениюТС.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекДанные.ЛицоДопущенное) Тогда
		ЗначениеОтбора = Новый Структура("Владелец", ТекДанные.ЛицоДопущенное);
		ПараметрыВыбораИзСписка = Новый Структура("Отбор", ЗначениеОтбора);
		ОткрытьФорму("Справочник.ПодтверждающиеДокументы.ФормаВыбора", ПараметрыВыбораИзСписка, Элемент);
	Иначе
		ОткрытьФорму("Справочник.ПодтверждающиеДокументы.ФормаВыбора",, Элемент);
	КонецЕсли;
	
КонецПроцедуры
