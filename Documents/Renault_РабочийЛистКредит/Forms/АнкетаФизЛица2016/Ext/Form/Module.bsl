// Заполнение печатной формы анкеты

&НаСервере
Функция ЗаполнитьАнкету() Экспорт

	ТабДок = Документы.Renault_РабочийЛистКредит.ПолучитьМакет("АнкетаФизЛица2016");
	
	Для каждого стрРеквизит Из ПолучитьРеквизиты() Цикл
		
		ЗначениеРеквизита = ЭтаФорма[стрРеквизит.Имя];
		
		Если стрРеквизит.Имя = "Фамилия" Тогда
			Заполнить_Фамилия(ТабДок, ЗначениеРеквизита);   
		ИначеЕсли стрРеквизит.Имя = "Имя" Тогда
			Заполнить_Имя(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "Отчество" Тогда
			Заполнить_Отчество(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ПрежнееФИО" Тогда
			Заполнить_ПрежнееФИО(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ОтношениеККредиту" Тогда
			Заполнить_ОтношениеККредиту(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "БралКредитРанее" Тогда
			Заполнить_БралиКредит(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ДатаРождения" Тогда
			Заполнить_ДатаРождения(ТабДок, ЗначениеРеквизита);  
		ИначеЕсли стрРеквизит.Имя = "СНИЛС" Тогда
			Заполнить_СНИЛС(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ДокументУдостоверяющийЛичность" Тогда
			Заполнить_ВидДокумента(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "СерияДокУЛ" Тогда
			Заполнить_СерияДокумента(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "НомерДокУЛ" Тогда
			Заполнить_НомерДокумента(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ДатаВыдачиДокУЛ" Тогда
			Заполнить_ДатаВыдачиДокумента(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ВыданДокУЛ" Тогда
			Заполнить_ВыданДокумент(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "СемейноеПоложение" Тогда
			Заполнить_СемейноеПоложение(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ЧислоИждивенцев" Тогда
			Заполнить_Иждивение(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ИзНихДетей" Тогда
			Заполнить_ИждивениеДетей(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ВодительскийСтаж" Тогда
			Заполнить_ВодительскийСтаж(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "Образование" Тогда
			Заполнить_Образование(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "СоциальныйСтатус" Тогда
			Заполнить_СоциальныйСтатус(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "АдресФактПроживанияСобственность" Тогда
			Заполнить_ВидСобственности(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "КодовоеСлово" Тогда
			Заполнить_КодовоеСлово(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "АдресФактПроживанияСовпадаетСРегистрацией" Тогда
			Заполнить_АдресСовпадает(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "ДатаНачалаПроживания" Тогда
			Заполнить_ДатаНачалаПроживания(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "АдресФактПроживанияИндекс" Тогда
			Заполнить_АдресПроживанияИндекс(ТабДок, ЗначениеРеквизита);
		ИначеЕсли стрРеквизит.Имя = "АдресФактПроживанияОбласть" Тогда
