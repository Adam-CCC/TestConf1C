Функция ДатаКСтроке(Дата)

	Если ЗначениеЗаполнено(Дата) Тогда
		ЗначениеЗаполнения = Лев(стрЗаменить(Строка(Дата), ".", ""), 8);
	Иначе	
		ЗначениеЗаполнения = "        ";
	КонецЕсли;

	Возврат ЗначениеЗаполнения;
	
