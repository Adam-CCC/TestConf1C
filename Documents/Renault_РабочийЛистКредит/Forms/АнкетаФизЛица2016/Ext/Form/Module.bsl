&НаКлиенте
Процедура РаботодательНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка) ПодборОрганизации() КонецПроцедуры
&НаКлиенте
Процедура ПодборОрганизации()
	
	Если РаботодательОрганизационноПравоваяФорма="Гос. предприятие (ГУП, ФГУП, МГУП и пр.)" ИЛИ РаботодательОрганизационноПравоваяФорма="Гос. (МВД, В/Ч и пр.) и муниц. служба" Тогда
		ОПФорма="";		
	ИначеЕсли РаботодательОрганизационноПравоваяФорма="Прочее" Тогда
		ОПФорма=РаботодательОрганизационноПравоваяФормаПрочее;
	Иначе
		ОПФорма=РаботодательОрганизационноПравоваяФорма;
	КонецЕсли;	
	
	Парам=Новый Структура("СтрокаПоиска",ОПФорма+" "+СтрЗаменить(РаботодательНаименование,ОПФорма,""));
	Структура=ОткрытьФормуМодально("Обработка.Renault_Ext.Форма.ПоискОрганизацииOnline",Парам,ЭтаФорма,УникальныйИдентификатор);
	Если Структура<>Неопределено Тогда
		РаботодательНаименование=Структура.Наименование;
		РаботодательИНН=Структура.ИНН;
		РаботодательВозраст=РаботодательВозраст(Структура.ДатаРегистрации);
		//Структура.ОГРН
		
		СтруктураАдреса=Структура.Адрес;
		АдресРаботодателяСтрокой=СтруктураАдреса.Представление;
		РаботодательИндекс=СтруктураАдреса.Индекс;
		РаботодательОбласть=СтруктураАдреса.Область;
		РаботодательРайон=СтруктураАдреса.Район;
		РаботодательГород=СтруктураАдреса.Город;
		РаботодательУлица=СтруктураАдреса.Улица;
		РаботодательДом=СтруктураАдреса.Дом;
		РаботодательСтроение=СтруктураАдреса.Строение;
		РаботодательКорпус=СтруктураАдреса.Корпус;
		РаботодательОфис=СтруктураАдреса.Офис;
	КонецЕсли;	
	
КонецПроцедуры
Функция РаботодательВозраст(ДатаРегистрации)
	ЧислоЛет=Цел(Год(ТекущаяДата())-Год(ДатаРегистрации));	
	Если ЧислоЛет<1 Тогда Возврат "менее 1"
	ИначеЕсли ЧислоЛет<3 Тогда Возврат "1-2"
	ИначеЕсли ЧислоЛет<11 Тогда Возврат "2-10"
	ИначеЕсли ЧислоЛет<26 Тогда Возврат "10-25"
	ИначеЕсли ЧислоЛет<51 Тогда Возврат "25-50"
	Иначе Возврат "более 50"	
	КонецЕсли;
КонецФункции
//-подбор работодателя

&НаКлиенте
Процедура кнЗаписать(Команда) 
	Запрос=Новый Запрос("Выбрать 1 Из РегистрСведений.КартинкиИФайлы ГДЕ Объект=&ПодтверждающийДокумент");
	Запрос.УстановитьПараметр("ПодтверждающийДокумент",ПодтверждающийДокумент);
	Если Запрос.Выполнить().Пустой() Тогда
		Сп=Новый СписокЗначений;
		Сп.Добавить("ПрикрепитьСейчас","Прикрепить сейчас");
		Сп.Добавить("ПрикрепитьПозже","Прикрепить позже");
		Если Вопрос("Для передачи заявки в банк необходимо прикрепить скан документа",Сп)="ПрикрепитьСейчас" Тогда кнПрикрепитьСкан("") КонецЕсли;	
	КонецЕсли;	
	
	Закрыть(ПолучитьДанныеАнкеты()) 
КонецПроцедуры //сохранение данных анкеты 
Функция ПолучитьДанныеАнкеты()
	Структура=Новый Структура;
	Для Каждого Эл Из ПолучитьРеквизиты() Цикл Структура.Вставить(Эл.Имя,ЭтаФорма[Эл.Имя]) КонецЦикла;	
	Возврат ЗначениеВСтрокуВнутр(Структура)
КонецФункции	

&НаКлиенте
Процедура кнПрикрепитьСкан(Команда)
	Форма=ПолучитьФорму("РегистрСведений.КартинкиИФайлы.Форма.ФормаЗаписи");
	Форма.Объект=ПодтверждающийДокумент;
	Форма.ОткрытьМодально();
КонецПроцедуры

&НаКлиенте
Процедура кнПечать(Команда)
	Анкета = ЗаполнитьАнкету();
	ФормаПечати = ПолучитьФорму("ОбщаяФорма.ФормаПечати");
	ФормаПечати.Заголовок = "Анкета клиента - физического лица";
	ФормаПечати.ПечатныйДокумент = Анкета;
	ФормаПечати.Открыть();
КонецПроцедуры

&НаКлиенте
Процедура кнPDF(Команда)
	
	Анкета = ЗаполнитьАнкету();
	
	ВремФайл=ПолучитьИмяВременногоФайла("pdf");
	Анкета.Записать(ВремФайл,ТипФайлаТабличногоДокумента.PDF);
	ЗапуститьПриложение(ВремФайл);
	
КонецПроцедуры

&НаКлиенте
Процедура АдресРаботодателяСтрокойНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	//URL="https://www.google.ru/maps/place/"+КодироватьСтроку(АдресРаботодателяСтрокой,СпособКодированияСтроки.КодировкаURL,"UTF8");
	//Yandex URL="https://yandex.ru/maps/?text="+КодироватьСтроку(АдресРаботодателяСтрокой,СпособКодированияСтроки.КодировкаURL,"UTF8");
	URL="https://www.google.ru/maps/place/"+КодироватьСтроку(АдресРаботодателяСтрокой,СпособКодированияСтроки.КодировкаURL,"UTF8");
	Если IE=Неопределено Тогда
		Попытка
			IE=Новый COMОбъект("InternetExplorer.Application");
			//IE.visible=false;
			IE.visible=true;
			IE.navigate(URL);
		Исключение
			ОткрытьФорму("Обработка.Renault_Ext.Форма.Браузер",Новый Структура("html",URL),ЭтаФорма,УникальныйИдентификатор);
		КонецПопытки;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы) Попытка IE.Quit() Исключение КонецПопытки КонецПроцедуры











