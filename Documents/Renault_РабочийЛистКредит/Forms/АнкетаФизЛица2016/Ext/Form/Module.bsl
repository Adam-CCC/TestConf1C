Процедура ЗаполнитьЯчейки(ТабДок, ОбластьЗаполнения, Знач Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ЗначениеЗаполнения = ВРег(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		ЗначениеЗаполнения = Строка(Значение);
		
		//убираем пробелы
		ЗначениеЗаполнения = СтрЗаменить(ЗначениеЗаполнения, Символ(160), "");
		ЗначениеЗаполнения = СтрЗаменить(ЗначениеЗаполнения, " ", "");
	КонецЕсли;
	
	КолвоЯчеек = ПолучитьКоличествоЯчеек(ОбластьЗаполнения);
	
	ЭтоОбластьCheckBox = ЭтоОбластьCheckBox(ОбластьЗаполнения);
	Если ЭтоОбластьCheckBox Тогда
		ИмяОбластиТекЗнач = ПолучитьИмяЯчейкиДляЗначения(ОбластьЗаполнения, Значение);
	КонецЕсли;
	
	Для Сч=1 По КолвоЯчеек Цикл
		
		ИмяОбласти = ОбластьЗаполнения+Сч;
		
		Если ЭтоОбластьCheckBox И ИмяОбласти = ИмяОбластиТекЗнач Тогда
			Значение = "Х";
		ИначеЕсли ЭтоОбластьCheckBox И ИмяОбласти <> ИмяОбластиТекЗнач Тогда	
			Значение = "";
		ИначеЕсли Сч <= СтрДлина(ЗначениеЗаполнения) Тогда
			Значение = Сред(ЗначениеЗаполнения, Сч, 1);	
		Иначе
			Значение = "";
		КонецЕсли;
		
		//// для тестирования
		//Попытка
		//    ТабДок.Область(ИмяОбласти).Текст = Значение;
		//Исключение
		//	Возврат;
		//КонецПопытки;
		
		 ТабДок.Область(ИмяОбласти).Текст = Значение;
		
	КонецЦикла;

КонецПроцедуры

