&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтаФорма.ТекущийЭлемент=Элементы.кнПерсональныеДанные;
	кнЗакладка("");
КонецПроцедуры

&НаКлиенте
Процедура РаботодательОтрасльПриИзменении(Элемент) УправлениеЭлементами() КонецПроцедуры

&НаКлиенте
Процедура кнЗакладка(Команда)
	//цвета кнопок
	АктивныйЦвет=Новый Цвет(255,207,0);
	ПассивныйЦвет=Новый Цвет(189,195,206);
	Для Каждого Кн Из Элементы.грКнопки.ПодчиненныеЭлементы Цикл
		Кн.ЦветРамки=ПассивныйЦвет;
		Кн.ЦветФона=ПассивныйЦвет;
	КонецЦикла;	
	ЭтаФорма.ТекущийЭлемент.ЦветРамки=АктивныйЦвет;
	ЭтаФорма.ТекущийЭлемент.ЦветФона=АктивныйЦвет;
	
	//переключение группы
	ИмяГруппы="гр"+Сред(ЭтаФорма.ТекущийЭлемент.Имя,3);
	Для Каждого Эл Из Элементы.Группы.ПодчиненныеЭлементы Цикл
		Эл.Видимость=?(Эл.Имя=ИмяГруппы,Истина,Ложь)
	КонецЦикла;	
КонецПроцедуры

