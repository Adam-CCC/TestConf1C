Процедура КП_НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка) //выбор кредитного предложения
	Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда Возврат КонецЕсли; //откроется простая форма списка без подбора
	СтандартнаяОбработка=Ложь;
	Парам=Новый Структура;
	Парам.Вставить("РежимВыбора",Истина);
	Если Не КредитноеПредложение.Пустая() И КредитноеПредложение.Владелец<>Справочники.Renault_КредитныеПредложения.РНБанк() Тогда
		Парам.Вставить("Банк",КредитноеПредложение.Владелец);
	КонецЕсли;	
	Парам.Вставить("Модель",Автомобиль);
	Парам.Вставить("Комплектация",Версия);
	Если ПовторныйКлиентБанка Тогда Парам.Вставить("ПовторныйКлиентБанка",Истина) КонецЕсли;
	Если ПрограммаCRM Тогда Парам.Вставить("ПрограммаCRM",Истина) КонецЕсли;
	Если ТипКП=Перечисления.Renault_ТипКП.НовыйАвтомобиль Тогда Парам.Вставить("НовыйАвтомобиль",Истина) КонецЕсли;
	
	Ответ=ОткрытьФормуМодально("Справочник.Renault_КредитныеПредложения.ФормаВыбора",Парам,ЭтаФорма);
	Если Ответ=Неопределено Тогда Возврат КонецЕсли;
	КредитноеПредложение=Ответ;
	
	Попытка ВладелецФормы.Объект.КомментарийПричиныОтказаОтРНБанка=КомментарийПричиныОтказаОтРНБанка Исключение КонецПопытки;
	ЗаполнитьДанныеКредитногоПредложенияПоУмолчанию();
	ВыполнитьРасчет();
	//ОбновитьГрафик();
	УправлениеЭлементами();
КонецПроцедуры

