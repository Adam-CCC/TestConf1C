	Запрос.УстановитьПараметр("Ссылка", КредитноеПредложение);
	Запрос.УстановитьПараметр("ПервоначальныйВзносПроцент", ПервоначальныйВзносПроцент);
	Запрос.УстановитьПараметр("СрокКредита",СрокКредита);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
