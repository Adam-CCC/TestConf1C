&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//в случае если расчет был выполнен ранее - заполнение условий расчета по ранее посчитанным данным
	Если Параметры.Свойство("УсловияРасчета") И СтрДлина(Параметры.УсловияРасчета)>0 Тогда
		Для Каждого Эл Из ЗначениеИзСтрокиВнутр(Параметры.УсловияРасчета) Цикл 
			Если Эл.Ключ="Сервисы" Тогда
				Сервисы.Загрузить(ЗначениеИзСтрокиВнутр(Эл.Значение))
			Иначе
				ЭтаФорма[Эл.Ключ]=Эл.Значение 	
			КонецЕсли;	
		КонецЦикла;
	Иначе //инициализация и расчет
		
		//автозаполнение реквизитов
		Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
			Если Параметры.Свойство(Реквизит.Имя) Тогда ЭтаФорма[Реквизит.Имя]=Параметры[Реквизит.Имя] КонецЕсли
		КонецЦикла;
		
		//СтоимостьКАСКО=?(СтоимостьКАСКО=0,ПолучитьСтоимостьКАСКО(),СтоимостьКАСКО);
		Если КредитноеПредложение.Пустая() Тогда НайтиКредитноеПредложение() Иначе ЗаполнитьДанныеКредитногоПредложенияПоУмолчанию() КонецЕсли;
		
	КонецЕсли;	
	
	УправлениеЭлементами();
КонецПроцедуры

Процедура УправлениеЭлементами()
	Элементы.СтоимостьАвтомобиля.Доступность=СтоимостьАвтомобиля=0;
	Элементы.ЗаголовокФормы.Заголовок=""+ТипКП+": "+Автомобиль+" "+Версия+", Стоимость: "+СтоимостьАвтомобиля+" руб.";
	//данные сторонних банков
	Элементы.грДанныеСтороннихБанков.Видимость=КредитноеПредложение.Владелец<>Справочники.Renault_КредитныеПредложения.РНБанк();
КонецПроцедуры	

Процедура НайтиКредитноеПредложение()
	Банк=?(КредитноеПредложение.Пустая(),Справочники.Renault_КредитныеПредложения.РНБанк(),КредитноеПредложение.Владелец);
	КредитноеПредложение=Справочники.Renault_КредитныеПредложения.ОптимальноеКредитноеПредложение(Банк,Автомобиль,Версия,ПовторныйКлиентБанка,ПрограммаCRM);
	ЗаполнитьДанныеКредитногоПредложенияПоУмолчанию();
	ВыполнитьРасчет();
КонецПроцедуры	

Процедура ЗаполнитьДанныеКредитногоПредложенияПоУмолчанию()
	Если КредитноеПредложение.Пустая() Тогда 
		СрокКредита=0;
		СтавкаМаркетинговая=0;
		СтавкаБанка=0;
		СуммаКредита=0;
		ЕжемесячныйПлатеж=0;
		Возврат
	КонецЕсли;
	
	//сервисы и стоимость
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",КредитноеПредложение);
	Запрос.УстановитьПараметр("Модель",?(ТипЗнч(Автомобиль)=Тип("СправочникСсылка.Модели"),Автомобиль,Автомобиль.Модель));
	Запрос.Текст="
	|Выбрать
	|	ЗП.Сервис Сервис,
	|	ЗП.Сервис.ТипСервиса ТипСервиса,
	|	Обязательный,
	|	ВыбранПоУмолчанию,
	|	Стоимость.ФиксированнаяСтоимость,
	|	Стоимость.ПроцентОтСтоимостиАвтомобиля,
	|	Стоимость.ПроцентОтСтоимостиКредита
	|ИЗ(	
	|	Выбрать
	|		Сервисы.*,
	|		Выбор Когда Обязательные.ТипСервиса Есть NULL Тогда Ложь Иначе Истина Конец Обязательный,
	|		Выбор Когда ПоУмолчанию.ТипСервиса Есть NULL Тогда Ложь Иначе Истина Конец ВыбранПоУмолчанию
			
	|	Из Справочник.Renault_КредитныеПредложения.ДоступныеСервисы Сервисы

	|	Левое Соединение Справочник.Renault_КредитныеПредложения.ОбязательныеСервисы Обязательные
	|	По Обязательные.Ссылка=&Ссылка И Сервисы.Сервис.ТипСервиса=Обязательные.ТипСервиса    

	|	Левое Соединение Справочник.Renault_КредитныеПредложения.СервисыПоУмолчанию ПоУмолчанию
	|	По ПоУмолчанию.Ссылка=&Ссылка И Сервисы.Сервис.ТипСервиса=ПоУмолчанию.ТипСервиса

	|	ГДЕ Сервисы.Ссылка=&Ссылка
	|)ЗП

	|Левое Соединение Справочник.Renault_КредитныеСервисы.СтоимостьСервиса Стоимость
	|ПО ЗП.Сервис=Стоимость.Ссылка И Стоимость.Модель=&Модель
	|";
	Сервисы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//отметим обязательные сервисы по принципу самый дорогой
	Обязательные=КредитноеПредложение.ОбязательныеСервисы.Выгрузить().ВыгрузитьКолонку("ТипСервиса");
	Для Каждого ТипСервиса Из Обязательные Цикл
		МаксОбязательный=0; СервисОбязательный="";
		Для Каждого Стр Из Сервисы.НайтиСтроки(Новый Структура("ТипСервиса",ТипСервиса)) Цикл
			Если Обязательные.Найти(Стр.ТипСервиса)<>Неопределено Тогда
				Если (Стр.ФиксированнаяСтоимость+Стр.ПроцентОтСтоимостиАвтомобиля+Стр.ПроцентОтСтоимостиКредита)>МаксОбязательный Тогда
					МаксОбязательный=Стр.ФиксированнаяСтоимость+Стр.ПроцентОтСтоимостиАвтомобиля+Стр.ПроцентОтСтоимостиКредита;
					СервисОбязательный=Стр.Сервис;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		Строки=Сервисы.НайтиСтроки(Новый Структура("Сервис",СервисОбязательный)); Если Строки.Количество()>0 Тогда Строки[0].Вкл=Истина КонецЕсли;
	КонецЦикла;
	
	//отметим сервисы по умолчанию по принципу самый дорогой
	ПоУмолчанию=КредитноеПредложение.СервисыПоУмолчанию.Выгрузить().ВыгрузитьКолонку("ТипСервиса");
	Для Каждого ТипСервиса Из ПоУмолчанию Цикл
		МаксПоУмолчанию=0; СервисПоУмолчанию="";
		Для Каждого Стр Из Сервисы.НайтиСтроки(Новый Структура("ТипСервиса",ТипСервиса)) Цикл
			Если ПоУмолчанию.Найти(Стр.ТипСервиса)<>Неопределено Тогда
				Если (Стр.ФиксированнаяСтоимость+Стр.ПроцентОтСтоимостиАвтомобиля+Стр.ПроцентОтСтоимостиКредита)>МаксПоУмолчанию Тогда
					МаксПоУмолчанию=Стр.ФиксированнаяСтоимость+Стр.ПроцентОтСтоимостиАвтомобиля+Стр.ПроцентОтСтоимостиКредита;
					СервисПоУмолчанию=Стр.Сервис;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		Строки=Сервисы.НайтиСтроки(Новый Структура("Сервис",СервисПоУмолчанию)); Если Строки.Количество()>0 Тогда Строки[0].Вкл=Истина КонецЕсли;
	КонецЦикла;
	
	//доступный выбор срока кредита
	МинимальныйСрок=КредитноеПредложение.ОграничениеСрокаОт;
	МаксимальныйСрок=КредитноеПредложение.ОграничениеСрокаДо;
	РазницаЛет=(МаксимальныйСрок-МинимальныйСрок)/12;
	Для Индекс=0 По РазницаЛет Цикл	Элементы.СрокКредита.СписокВыбора.Добавить((МинимальныйСрок+Индекс*12)) КонецЦикла;
	Элементы.СтрСрокКредита.Заголовок=""+МинимальныйСрок+" ... "+МаксимальныйСрок +" месяца";
	Элементы.СрокКредита.МинимальноеЗначение=МинимальныйСрок;
	Элементы.СрокКредита.МаксимальноеЗначение=МаксимальныйСрок;
	СрокКредита=?(СрокКредита>0,СрокКредита,КредитноеПредложение.СрокПоУмолчанию);
//	ИспользуетсяРазумноеКАСКО=КредитноеПредложение.ПоддерживаетРазумноеКАСКО;

	Элементы.ИспользоватьBaloon.Доступность=КредитноеПредложение.Baloon;
	Элементы.СтрОстаточныйПлатежПроцент.Заголовок=""+КредитноеПредложение.BaloonОт+" ... "+КредитноеПредложение.BaloonДо+" %";
	Элементы.ОстаточныйПлатежПроцент.МинимальноеЗначение=КредитноеПредложение.BaloonОт;
	Элементы.ОстаточныйПлатежПроцент.МаксимальноеЗначение=КредитноеПредложение.BaloonДо;
	ПроцентОстаточногоПлатежа=?(ПроцентОстаточногоПлатежа<=КредитноеПредложение.BaloonДо И ПроцентОстаточногоПлатежа>=КредитноеПредложение.BaloonОт,ПроцентОстаточногоПлатежа,КредитноеПредложение.BaloonОт);

	//Если КредитноеПредложение.ТребуетсяКАСКО Тогда КАСКОвКредит=Истина КонецЕсли;
	//Элементы.КАСКОвКредит.Доступность=НЕ КредитноеПредложение.ТребуетсяКАСКО;
	//Элементы.СтоимостьКАСКО.АвтоОтметкаНезаполненного=КредитноеПредложение.ТребуетсяКАСКО;
	
	//первоначальный взнос...
	ПервоначальныйВзносПроцент=КредитноеПредложение.ПервоначальныйВзносПоУмолчанию;
	ПервоначальныйВзнос=СтоимостьАвтомобиля*ПервоначальныйВзносПроцент/100;
	
	Запрос=Новый Запрос("Выбрать ЕстьNULL(Минимум(ПервоначальныйВзносОт),0) от, ЕстьNULL(Максимум(ПервоначальныйВзносДо),0) до Из Справочник.Renault_КредитныеПредложения.КредитныеСтавки ГДЕ Ссылка=&КП");
	Запрос.УстановитьПараметр("КП",КредитноеПредложение);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Элементы.СтрПервоначальныйВзносПроцент.Заголовок=""+Выборка.от+" ... "+Выборка.до+" %";
		Элементы.ПервоначальныйВзносПроцент.МинимальноеЗначение=Выборка.от;
		Элементы.ПервоначальныйВзносПроцент.МаксимальноеЗначение=Выборка.до;
		
		ВзносОт=Окр(СтоимостьАвтомобиля*Выборка.от/100);
		ВзносДо=Окр(СтоимостьАвтомобиля*Выборка.до/100);
		Элементы.СтрПервоначальныйВзнос.Заголовок=""+ВзносОт+" ... "+ВзносДо+" руб.";
		Элементы.ПервоначальныйВзнос.МинимальноеЗначение=ВзносОт;
		Элементы.ПервоначальныйВзнос.МаксимальноеЗначение=ВзносДо;
	КонецЕсли;
	
	//график обновим при открытии на клиенте
	
