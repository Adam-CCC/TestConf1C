	//СтоимостьДопОборудованияВКредит=?(ДопОборудованиеВКредит,СтоимостьДопОборудования,0);
	//ЦенаАвтомобиляИтоговая=ЦенаАвтомобиляПослеСубсидирования+СтоимостьДопОборудованияВКредит+СтоимостьПГ;
	//СуммаКредитаПослеСубсидирования=ИсходнаяСуммаКредита-СубсидияПоКредитнойПрограмме-СубсидияПГ+СтоимостьПГ;
	//
	//Если ЗащитаКредита Тогда
	//	СуммаЗащитыКредита=СуммаКредитаПослеСубсидирования*СтавкаЗащитыКредита/100*СрокКредита+ФиксированнаяЧастьЗащитыКредита*(1+СтавкаЗащитыКредита/100*СрокКредита);
	//Иначе
	//	СуммаЗащитыКредита=0;
	//КонецЕсли;
	//
	//СуммаКредита=СтоимостьАвтомобиля+?(КАСКОвКредит,СтоимостьКАСКО,0)+?(ПГВКредит,СтоимостьПГ,0)+СуммаЗащитыКредита-ПервоначальныйВзнос;
	//
	//Если СрокКредита<>0 Тогда
	//	Если СтавкаБанка>0 Тогда
	//		ЕжемесячныйПлатеж=(СтавкаБанка/1200*СуммаКредита*Pow(1+СтавкаБанка/1200, СрокКредита))/(Pow(1+СтавкаБанка/1200, СрокКредита)-1)
	//	Иначе
	//		ЕжемесячныйПлатеж=СуммаКредита/СрокКредита
	//	КонецЕсли;
	//КонецЕсли;
	
//версия 3

	CpriceInput=СтоимостьАвтомобиля;
	cPriceDDisc=СтоимостьАвтомобиля; //стоимость авто со скидкой (в нашем случае она уже со скидкой)
	
	//ПервоначальныйВзнос=CpriceInput*ПервоначальныйВзносПроцент/100; //D37 Первоначальный взнос
	cCashInput=ПервоначальныйВзнос;
	
	cFPInput=CpriceInput*ПроцентОстаточногоПлатежа/100; //Остаточный платеж (baloon)
	cFPPerc=ПроцентОстаточногоПлатежа/100;
	cFP=?(cFPPerc>0,cPriceDDisc*cFPPerc,cFPInput);

	cBRateFIrst=СтавкаБанка/100;
	cTerm=СрокКредита;
	cMRateFirst=СтавкаМаркетинговая/100;
	
	cAccessLoan=0; //D92 ? допоборудование =0 т.к. включено в стоимость тачки
	cRefinLoan=0; //D30 ? скидка за трейдин
	cASSubsFixRate=0; //G127 ? субсидии за допсервисы, пока не используется
	cASSubsMarkRate=0; //I127 ? пока не используется
	
	cDealerSubsPercInput=0; //D82? ставка под которую хотят выдать кредит, пока не учитывать и выводить в интерфейс
	cDealerSubsInput=0; //D80? сумма скидки дилера, пока не учитывать и выводить в интерфейс
	
	F115=0; G115=0; H115=0;
	Для Каждого Стр Из Сервисы.НайтиСтроки(Новый Структура("Вкл",Истина)) Цикл
		F115=F115+Стр.ФиксированнаяСтоимость;
		G115=G115+Стр.ПроцентОтСтоимостиАвтомобиля;
		H115=H115+Стр.ПроцентОтСтоимостиКредита;
	КонецЦикла;	
	
	F114=0; //? не используется   
	cASLoanFix=F115-F114;
	
	cASSubsLoanRate=0; //H127 ? не учитываем, субсидия по доп сервисам
	F126=0; //?  не учитываем, субсидия по доп сервисам
	cASFixSubs=F126;
	cTradeIN=0; //D28 ? не учитываем
	cCashPercInput=ПервоначальныйВзносПроцент; //D39
	
	cCashDP=?(cCashPercInput>0,cPriceDDisc*cCashPercInput/100-cTradeIN,cCashInput);
	
	cDP=cTradeIN+cCashDP;
	cLoanAfterDP=cPriceDDisc-cDP;
	
	cSubsidyFirst=Окр(cLoanAfterDP-rciPV(cBRateFIrst/12,cTerm, rciPMT(cMRateFirst/12,cTerm,cLoanAfterDP,cFP) ,cFP),2);
	cPriceSFirst=cPriceDDisc-cSubsidyFirst;
	
	cLoanAfterSubsFirst=cPriceSFirst-cDP;
	cDealerSubsidy=?(cDealerSubsPercInput=0,cDealerSubsInput,cLoanAfterSubsFirst-rciPV(cMRateFirst/12,cTerm, rciPMT(cDealerSubsPercInput/12,cTerm,cLoanAfterSubsFirst,cFP) ,cFP));
	
	cLoanAfterDealerSubs=cLoanAfterSubsFirst-cDealerSubsidy;
	cLoanAfterAccess=cLoanAfterDealerSubs+cAccessLoan+cRefinLoan;
	cASFixSubs=СубсидииНаДопСервисы;
	cLoanAfterFixSubs=cLoanAfterAccess-cASFixSubs;
	
	cPriceSubsDealer=cPriceSFirst-cDealerSubsidy;
	D100=СубсидииНаДопОборудование;
	cPriceAfterAccess=cPriceSubsDealer-D100;
	cPriceAfterFixSubs=cPriceAfterAccess-cASFixSubs;
	
	cASSubs=((cLoanAfterFixSubs-cAccessLoan-cRefinLoan)*(cASSubsFixRate+cASSubsMarkRate+cASSubsLoanRate)+(cPriceAfterFixSubs-(cLoanAfterFixSubs-cAccessLoan-cRefinLoan))*(cASSubsFixRate))/(1+cASSubsFixRate+cASSubsLoanRate+cASSubsMarkRate);
	
	cPriceAfterASSubs=cPriceAfterFixSubs-cASSubs;
	
	cLoanAfterASSubs=cLoanAfterFixSubs-cASSubs;
	
	cASLoanDKP=G115*cPriceAfterASSubs;
	cASLoanLoan=(H115*(cLoanAfterASSubs+cASLoanFix+cASLoanDKP)+F114)/(1-H115);
	cLoanAS=cASLoanFix+cASLoanDKP+cASLoanLoan;
	
	cLoanAfterAS=cLoanAfterASSubs+cLoanAS; 
	
	cOtherKASKOLoan=КАСКО_СтороннихПоставщиковВКредит; //итого чужая КАСКО в кредит	
	
	cLoan=cLoanAfterAS+cOtherKASKOLoan;	//общая сумма кредита = стоимость авто - первоначальный взнос + стоимость дополнительных сервисов приобретаемых в кредит 
	
	СуммаКредита=cLoan;
	ЕжемесячныйПлатеж=rciPMT(cBRateFIrst/12,cTerm,cLoan,cFP);	
	
КонецПроцедуры
Function rciPMT(Rate,Знач Nper,PV,FV)
	If FV > 0 Then Nper = Nper - 1 EndIf;
	If Rate = 0 Then
	    Return (PV - FV) / Nper
	Else
	    Return (Rate * (PV * Pow(1 + Rate,Nper) - FV / (1 + Rate))) / (Pow(1 + Rate,Nper) - 1)
	EndIf
EndFunction
Function rciPV(Rate,Знач Nper,PMT,FV)
	If FV > 0 Then Nper = Nper - 1 EndIf;
	If Rate = 0 Then
	    Return PMT * Nper + FV
	Else
	    Return (PMT * ( Pow(1 + Rate,Nper) - 1) / Rate + FV / (1 + Rate)) / Pow(1 + Rate,Nper) 
	EndIf
EndFunction

