	Парам.Вставить("Клиент",Объект.Клиент);
	Парам.Вставить("Автомобиль",Объект.Автомобиль);
	Парам.Вставить("Версия",Объект.Версия);
	Парам.Вставить("ТипКП",Объект.КоммерческоеПредложение.ТипКП);
	Парам.Вставить("СтоимостьАвтомобиля",Объект.СтоимостьАвтомобиля);
	
	Если ИдСтроки<>Неопределено Тогда
		Строка=Объект.РасчетКредита.НайтиПоИдентификатору(ИдСтроки);
		//Парам.Вставить("КредитноеПредложение",Строка.КредитноеПредложение);
		//Парам.Вставить("ПервоначальныйВзнос",Строка.ПервоначальныйВзнос);
		//Парам.Вставить("ПервоначальныйВзносПроцент",Строка.ПервоначальныйВзносПроцент);
		//Парам.Вставить("СрокКредита",Строка.СрокКредита);
		//Парам.Вставить("СуммаКредита",Строка.СуммаКредита);
		//Парам.Вставить("СтавкаБанка",Строка.СтавкаБанка);
		//Парам.Вставить("ЕжемесячныйПлатеж",Строка.ЕжемесячныйПлатеж);
		Парам.Вставить("УсловияРасчета",Строка.УсловияРасчета);
	КонецЕсли;	
	
	//Данные=ОткрытьФормуМодально("Документ.Renault_РабочийЛистКредит.Форма.РасчетКредита",Парам,ЭтаФорма,УникальныйИдентификатор);
//проблемы совместимости
Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
	Данные=ОткрытьФормуМодально("Документ.Renault_РабочийЛистКредит.Форма.РасчетКредита",Парам,ЭтаФорма);
Иначе
	Выполнить("Данные=ОткрытьФормуМодально(""Документ.Renault_РабочийЛистКредит.Форма.РасчетКредита"",Парам,ЭтаФорма,УникальныйИдентификатор)")
КонецЕсли;	
	Если Данные<>Неопределено Тогда
		Если ИдСтроки=Неопределено Тогда Строка=Объект.РасчетКредита.Добавить() КонецЕсли; // иначе строка передана в процедуру
		ЗаполнитьЗначенияСвойств(Строка,Данные);
		Строка.УсловияРасчета=ЗначениеВСтрокуВнутр(Данные);
	КонецЕсли;	
КонецПроцедуры

