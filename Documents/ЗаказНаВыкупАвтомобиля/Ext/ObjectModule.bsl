// Процедура - обработчик ввода на основании
Процедура ОбработкаЗаполнения(Основание) Экспорт
	Если НЕ дкОбработкаЗаполнения(ЭтотОбъект, Основание) Тогда
		Возврат;
	КонецЕсли;
	ХозОперация = Справочники.ХозОперации.ЗаказНаВыкупАвтомобиля;
	СтавкаНДСНаАвтомобиль = Справочники.СтавкиНДС.БезНДС;
	
	Если ТипЗнч(Основание) = Тип("СправочникСсылка.Автомобили") И (НЕ Основание.ЭтоГруппа) Тогда
 		Автомобиль = Основание;
 		ОбработкаРеквизита("Автомобиль");
 	КонецЕсли; 
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.РабочийЛист") Тогда
 		Контрагент = Основание.СобственникТрейдИн;                                                                 
		ПодразделениеКомпании = СМ_ФормированиеНовыхОбъектов.СМГ_НайтиПодразделениеПоРодителю(Основание.Организация,Основание.ПОдразделениеКомпании);
 		Организация = Основание.Организация;
		//Бондаренко++ 20250130
		//ДоговорВзаиморасчетов = СМ_ФормированиеНовыхОбъектов.НайтиСоздатьДоговор(Контрагент,Организация,ПодразделениеКомпании,Перечисления.ВидыДоговоров.Продажа);        
 		ДоговорВзаиморасчетов = СМ_ФормированиеНовыхОбъектов.НайтиСоздатьДоговорНеИстекший(Контрагент,Организация,ПодразделениеКомпании,Перечисления.ВидыДоговоров.Продажа,ТекущаяДата());
		//Бондаренко-- 20250130
 		ЦенаАвтомобиля = Основание.ЦенаДКПТрейдИн;
		СуммаДокумента = Основание.ЦенаДКПТрейдИн;
 		ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
		ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		КурсДокумента = 1;
		СтоимостьВР = 0;                         
		РабочийЛист = Основание.Ссылка;
		ДокументОснование = Основание.Ссылка;
		Автомобиль = Основание.АвтомобильТрейдИн;
		ОбработкаРеквизита("Автомобиль");
 	КонецЕсли; 
	
	Если обЗначениеНеЗаполнено(Основание) Тогда
		НоваяСуммаДокумента = РассчитатьСуммуВсего();
		Если СуммаДокумента<>НоваяСуммаДокумента Тогда
			СуммаДокумента = НоваяСуммаДокумента;
		КонецЕсли; 
		//Заполнение предоплаты
		Если ДоговорВзаиморасчетов.ПроцентПредоплаты = 0 Тогда
			ПроцентПредоплаты = обПраво("МинимальныйПроцентПредоплаты", Права,,ЭтотОбъект);
		Иначе
			ПроцентПредоплаты = ДоговорВзаиморасчетов.ПроцентПредоплаты;
		КонецЕсли;
		//ОбработкаРеквизита("ПроцентПредоплаты");
	КонецЕсли;
	
	ТекущаяВалютаДокумента = ВалютаДокумента;
	ТекущийКурсДокумента   = КурсДокумента;
	
КонецПроцедуры

