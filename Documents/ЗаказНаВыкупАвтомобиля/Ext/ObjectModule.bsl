		БазаНДС  = ЦенаАвтомобиля; // База для расчета НДС
		
		ЦенаВключаетНДС = (обЗначениеНеЗаполнено(ТипЦен) ИЛИ ТипЦен.ЦенаВключаетНДС);
		СтавкаНДС = СтавкаНДСНаАвтомобиль.Ставка;
