			Иначе
				ЦенаАвтомобиля = Окр(СуммаВсегоНаАвтомобиль/(1-ПроцентСкидкиНаАвтомобиль/100-ЗначениеСкидкиНаАвтомобиль/100),2);
			КонецЕсли;
		Иначе
			Если СкидкаНаАвтомобильАбсолютная Тогда
