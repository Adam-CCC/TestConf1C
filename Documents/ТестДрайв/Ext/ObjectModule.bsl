		//	ОрганизацияЛицо = ОрганизацияЛицо + ", действующего  на основании " + ДоверенностьРуководителя;
		//КонецЕсли;
		ОбластьМакета.Параметры.ОрганизацияЛицо = ОрганизацияЛицо;
	КонецЕсли;
	
	ДействующИйАя = "действующий(-ая)";
