//Бондаренко++ 20240405
Функция СоздатьРабочийЛист()
	
	Если обЗначениеНеЗаполнено(Менеджер) Тогда
		Возврат Документы.РабочийЛист.ПустаяСсылка();
	КонецЕсли;
	
	ТелефонЦифрами = ОставитьТолькоЦифры(ПредставлениеТелефона);
	Если обЗначениеНеЗаполнено(ПредставлениеТелефона) Или СтрДлина(ТелефонЦифрами) < 10 Тогда
		Возврат Документы.РабочийЛист.ПустаяСсылка();
	КонецЕсли;
	
	#Если Клиент Тогда
		Состояние("Идёт создание нового рабочего листа ...");
	#КонецЕсли			        
	
	ДокРЛ = Документы.РабочийЛист.СоздатьДокумент();
	ДокРЛ.Заполнить(Ссылка);
	ДокРЛ.Автомобиль = "";
	
	//Бондаренко++ 20240406
	ДокРЛ.Дата = Дата;
	ДокРЛ.ДатаСоздания = ТекущаяДата();
 	//Бондаренко-- 20240406
	
 	ДокРЛ.Статус = Справочники.СтатусыРабочегоЛиста.Создан;
	ДокРЛ.ПредставлениеТелефона = ПредставлениеТелефона;
	ДокРЛ.Менеджер = Менеджер; 
	ДокРЛ.Контрагент = Контрагент;
	
	Если ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
		Сообщить("На подразделение " + Строка(ПодразделениеКомпании) + " Рабочие листы не создаются!", СтатусСообщения.Информация);
		Возврат Документы.РабочийЛист.ПустаяСсылка();
		
	Иначе	
		Если ПодразделениеКомпании.Родитель = Справочники.ПодразделенияКомпании.ОсновноеПодразделение Тогда
			ДокРЛ.ПодразделениеКомпании = ПодразделениеКомпании;
		Иначе	
			ДокРЛ.ПодразделениеКомпании = ПодразделениеКомпании.Родитель;
		КонецЕсли;                    
	КонецЕсли;
  	
	ДокРЛ.Организация = ДокРЛ.ПодразделениеКомпании.Организация;
	
	Если ВРЕГ(Прав(СокрЛП(Контрагент.Отчество),1))= "А" Тогда
		ДокРЛ.Пол = Перечисления.ПолФизическихЛиц.Женский;
	Иначе	
		ДокРЛ.Пол = Перечисления.ПолФизическихЛиц.Мужской;
	КонецЕсли;
	
	ДокРЛ.Модель = Автомобиль.Модель;
	ДокРЛ.ВидАвтомобиля = Перечисления.ВидАвтомобиля.Новый;
	
	ДокРЛ.АвтомобильКлиентаМодель = Справочники.Модели.НЕ_СМОГ_ВЫЯСНИТЬ;
	ДокРЛ.ГодВыпускаАвтомобиляКлиента = Перечисления.ВариантыОтветов.Нет; 
	ДокРЛ.ГодПокупкиАвтомобиляКлиента = Перечисления.ВариантыОтветов.Нет; 
	ДокРЛ.ГдеПроживает = "Ростов-на-Дону г";
    ДокРЛ.СоставСемьи = Перечисления.СоставСемьи._12; 
	ДокРЛ.ВидДеятельности = Справочники.ВидыДеятельностиКонтрагентов.НЕ_УДАЛОСЬ_ВЫЯСНИТЬ;
    ДокРЛ.Возраст = Справочники.ВозрастныеГруппы.НЕ_УДАЛОСЬ_ВЫЯСНИТЬ;
	
	ДокРЛ.Комментарий = "Документ автоматом создан "+СокрЛП(Формат(ТекущаяДата(),"ДЛФ=DDT"))+" пользователем "+СокрЛП(ПараметрыСеанса.Пользователь)+" при записи документа "+СокрЛП(Ссылка)+".";
 	
	Попытка
	    ДокРЛ.Записать(РежимЗаписиДокумента.Запись);
		#Если Клиент Тогда
			Состояние("Записан рабочий лист "+ДокРЛ);
		#КонецЕсли	
		Попытка
			ДокРЛ.Записать(РежимЗаписиДокумента.Проведение); 
			#Если Клиент Тогда
				Состояние("Проведён рабочий лист "+ДокРЛ);
			#КонецЕсли	
 		Исключение
			Возврат Документы.РабочийЛист.ПустаяСсылка();
		КонецПопытки;
 	Исключение
		Возврат Документы.РабочийЛист.ПустаяСсылка();
	КонецПопытки;
  	
 	Возврат ДокРЛ.Ссылка;
	
КонецФункции //СоздатьРабочийЛист()
