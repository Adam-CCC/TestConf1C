		НаборПланОперативный.Отбор.РабочийДокумент.Установить(ЭтотОбъект.Ссылка);
		НаборПланОперативный.Отбор.Обращение.Установить(Обращение);
		НаборПланОперативный.Прочитать();
		НаборПланОперативный.Очистить();
		
		// запишем все автоработы
		СтрокаГрафика = ЭтотОбъект.ДилерскийЦентр.АвтосервисГрафикРабот.Найти(ДеньНедели(Дата), "ДеньНедели");
		НачалоРабочегоДня = СтрокаГрафика.НачалоРабочегоДня;
		КонецРабочегоДня = СтрокаГрафика.КонецРабочегоДня;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_АвтосервисПланРабот.ВремяНачала,
		|	Renault_АвтосервисПланРабот.ВремяОкончания,
		|	Renault_АвтосервисПланРабот.ЭтапРабот,
		|	Renault_АвтосервисПланРабот.Цех,
		|	Renault_АвтосервисПланРабот.Длительность,
		|	Renault_АвтосервисПланРабот.РабочийДокумент
		|ИЗ
		|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
		|ГДЕ
		|	Renault_АвтосервисПланРабот.Обращение = &Обращение
		|	И Renault_АвтосервисПланРабот.РабочийДокумент = &РабочийДокумент";
		Запрос.УстановитьПараметр("РабочийДокумент", ЭтотОбъект.Ссылка);
		Запрос.УстановитьПараметр("Обращение", Обращение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Запись = НаборПланОперативный.Добавить();
			Запись.ДилерскийЦентр = ДилерскийЦентр;
			Запись.Период = ТекущаяДата();
			Запись.Обращение = Обращение;
			Запись.РабочийДокумент = Выборка.РабочийДокумент;
			Запись.ЭтапРабот = Выборка.ЭтапРабот;
			Запись.Цех = Выборка.Цех;
			Если Выборка.РабочийДокумент = Ссылка Тогда
				Запись.ВремяНачала = Выборка.ВремяНачала + ОтставаниеВоВремени;
				Запись.ВремяОкончания = Выборка.ВремяОкончания + ОтставаниеВоВремени;
			Иначе
				Запись.ВремяНачала = Выборка.ВремяНачала;
				Запись.ВремяОкончания = Выборка.ВремяОкончания;
			КонецЕсли;
			//Длительность = Выборка.ВремяОкончания - Выборка.ВремяНачала;
			//Запись.ВремяОкончания = Запись.ВремяНачала + Длительность;
			Длительность = Выборка.Длительность;
			Запись.Длительность = Выборка.Длительность;
			
		КонецЦикла;
		
		НаборПланОперативный.Записать();
		
		//Запишем занятость сотрудника
		
		Длительность = ЭтотОбъект.ДилерскийЦентр.ДлительностьПриемки*60;
		Сотрудник = ЭтотОбъект.Машиноместо;
		
		Запись = РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СоздатьМенеджерЗаписи();
		Запись.Сотрудник = Машиноместо;
