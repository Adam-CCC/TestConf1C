		Запись.Записать();
		
		НаборПлан = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		НаборПлан.Отбор.РабочийДокумент.Установить(Ссылка);
		НаборПлан.Прочитать();
		НаборПлан.Очистить();
		НаборПлан.Записать();
		
	//какой статус для "свободен" пока не придумал, пусть будет так:	
	//ИначеЕсли Состояние <> Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ПриемкаНачата Тогда
		
		Запись = РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СоздатьМенеджерЗаписи();
		Запись.Сотрудник = Машиноместо;
		Запись.Статус = Перечисления.CRM_ЗанятостьСотрудника.Свободен;
		Запись.Период = ТекущаяДата();
		
		Запись.Записать();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Автомобиль.VIN) И ЭтотОбъект.Автомобиль.VIN <> VIN Тогда
		
		VIN = ЭтотОбъект.Автомобиль.VIN;
		
		//ЭтотОбъект.Записать();
		
	КонецЕсли;
	
	// Воробьев Д.А. 06.10.2016 16:40:41 +++
	
	ЗафиксироватьСостояние = Ложь;
	
	Если Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ПриемкаНачата
		И Не ПометкаУдаления Тогда
		
		ЗафиксироватьСостояние = Истина;
		мЭтап = 1;
		
	ИначеЕсли Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен
		И Не ПометкаУдаления Тогда
		
		ЗафиксироватьСостояние = Истина;
		мЭтап = 2;
		
	ИначеЕсли ПометкаУдаления Тогда
		УдалитьДвиженияПродажиСервиса(1);
		УдалитьДвиженияПродажиСервиса(2);
	КонецЕсли;
	
	Если ЗафиксироватьСостояние Тогда
	
		МассивЗаявок = НайтиСвязанныеЗаявкиНаСервис();
		
		Для каждого мЗаявкаНаСервис Из МассивЗаявок Цикл
		
			Запрос = Новый Запрос;
			
			Запрос.УстановитьПараметр("Сотрудник", Машиноместо);
			Запрос.УстановитьПараметр("ЗаявкаНаСервис", мЗаявкаНаСервис);
			Запрос.УстановитьПараметр("Этап", мЭтап);
			
			// Если есть заказ-наряд, то считаем его итоговым документом
			Если Не ЗначениеЗаполнено(мЗаявкаНаСервис.ЗаказНаряд) Тогда
				
				Запрос.Текст = 
