//функция, возвращает значение НЕ ОтменилЗапись
Функция ОтменилЗапись() Экспорт
	
	#Если Клиент Тогда
	Если ЭтотОбъект.Состояние <> Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен Тогда
		
		Если Вопрос("Внимание! Будут удален весь планнинг по клиенту!", РежимДиалогаВопрос.ОКОтмена) = КодВозвратаДиалога.ОК Тогда
			
			Если ЗначениеЗаполнено(ЭтотОбъект.Обращение) Тогда
				
				ОбращениеОбъект = ЭтотОбъект.Обращение.Ссылка.ПолучитьОбъект();
				
			Иначе
				
				Предупреждение("Обращение по приемке не найдено или было удалено.");
				Возврат ИСТИНА; 
				
			КонецЕсли;
			
			Если ОчиститьПланПоКлиенту(ЭтотОбъект.Обращение) = ИСТИНА Тогда
				
				Форма = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
				Форма.Заголовок = "Выберите причину упущения обращения";
				СписокВыбора = Новый СписокЗначений;
				Выборка = Справочники.Renault_ПричиныУпущенияОбращенийАвтосервис.Выбрать();
				Пока Выборка.Следующий() Цикл
					СписокВыбора.Добавить(Выборка.Ссылка);
				КонецЦикла;
				Форма.СписокВыбора = СписокВыбора;
				Форма.ЗапретЗакрытияБезВыбора = истина; // DMSREN-1062
				
				Ответ = Форма.ОткрытьМодально();
				
				Объект = ЭтотОбъект.Ссылка.ПолучитьОбъект();
				Объект.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Отмена;
				Объект.ВремяОкончания = '00010101';
				Объект.Записать();
				
				ОбращениеОбъект = Обращение.Ссылка.ПолучитьОбъект();
				ОбращениеОбъект.ОтменилЗапись = Истина;
				ОбращениеОбъект.Упущено = ИСТИНА;
				ОбращениеОбъект.ПричинаУпущения = Ответ;
				ОбращениеОбъект.Записать();
				
				Возврат ЛОЖЬ;
				
			КонецЕсли;
			
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;
	Иначе
		
		Вопрос("Статус работ не повзовляет отменить запись клиента.", РежимДиалогаВопрос.ОК);
		Возврат ИСТИНА;
		
	КонецЕсли;
	
	#КонецЕсли
	
