Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Renault_CRM_ЗаявкаНаСервис") Тогда
		VIN = ДанныеЗаполнения.VIN;
		Автомобиль = ДанныеЗаполнения.Автомобиль;
		Клиент = ДанныеЗаполнения.Клиент;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьДокументы(Авто = Неопределено, Клиент = Неопределено)
	
	Обр = Обращение.Ссылка.ПолучитьОбъект();
	
	ГосНомер = "";
	
	Если ЗначениеЗаполнено(Авто) Тогда
		
		ГосНомер = 	Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Авто.Ссылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
		Обр.Автомобиль = Авто.Ссылка;
		Обр.Записать();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Клиент) Тогда
		
		Обр.Клиент = Клиент.Ссылка;
		Обр.Записать();
		
	КонецЕсли;
	
	Выдача = Документы.Renault_CRM_ВыдачаАвтомобиля.НайтиПоРеквизиту("Обращение", Обр.Ссылка);
	
	Если ЗначениеЗаполнено(Выдача) Тогда
		
		Выдача = Выдача.Ссылка.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(Авто) Тогда
			
			Выдача.Автомобиль = Авто.Ссылка;
			Выдача.ГосНомер = ГосНомер;
			Выдача.VIN = Авто.VIN;
			Выдача.Записать();
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Клиент) Тогда
			
			Выдача.Клиент = Клиент.Ссылка;
			Выдача.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗапросМойки = Новый Запрос();
	ЗапросМойки.Текст = "ВЫБРАТЬ
	                    |	Renault_CRM_ЗаявкаНаМойку.Ссылка
	                    |ИЗ
	                    |	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
	                    |ГДЕ
	                    |	Renault_CRM_ЗаявкаНаМойку.Обращение.Ссылка = &Обращение";
	ЗапросМойки.УстановитьПараметр("Обращение", Обр.Ссылка);
	Мойки = ЗапросМойки.Выполнить().Выбрать();
	
	Пока Мойки.Следующий() Цикл
		
		Мойка = Мойки.Ссылка.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(Авто) Тогда
			
			Мойка.Автомобиль = Авто.Ссылка;
			Мойка.ГосНомер = ГосНомер;
			Мойка.Записать();
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Клиент) Тогда
			
			Мойка.Клиент = Клиент.Ссылка;
			Мойка.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗапросЗаявки = Новый Запрос();
	ЗапросМойки.Текст = "ВЫБРАТЬ
	                    |	Renault_CRM_ЗаявкаНаСервис.Ссылка
	                    |ИЗ
	                    |	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
	                    |ГДЕ
	                    |	Renault_CRM_ЗаявкаНаСервис.Обращение.Ссылка = &Обращение";
	ЗапросЗаявки.УстановитьПараметр("Обращение", Обр.Ссылка);
	Заявки = ЗапросМойки.Выполнить().Выбрать();
	
	Пока Заявки.Следующий() Цикл
		
		Заявка = Заявки.Ссылка.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(Авто) Тогда
			
			Заявка.ГосНомер = ГосНомер;
			Заявка.VIN = Авто.VIN;
			Заявка.Автомобиль = Авто.Ссылка;
			Заявка.Записать();
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Клиент) Тогда
			
			Заявка.Клиент = Клиент.Ссылка;
			Заявка.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Подменка = Документы.Renault_CRM_ЗаявкаНаПодменныйАвто.НайтиПоРеквизиту("Обращение", Обр.Ссылка);
	
	Если ЗначениеЗаполнено(Подменка) Тогда
		
		Подменка = Подменка.Ссылка.ПолучитьОбъект();
		
		Если ЗначениеЗаполнено(Авто) Тогда
			
			Подменка.Автомобиль = Выдача.Ссылка;
			Подменка.ГосНомер = ГосНомер;
			Подменка.Записать();
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Клиент) Тогда
			
			Подменка.Клиент = Клиент.Ссылка;
			Подменка.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
