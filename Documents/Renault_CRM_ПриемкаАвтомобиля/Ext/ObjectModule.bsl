		//		//Пробег		 = АвтоОб.ЧтениеЗначенияРегистраСведения(Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);	
		//		
		//	Исключение
		//		
		//		//Сообщить("Не удалось прочитать данные автомобиля: " + ОписаниеОшибки());
		//		
		//	КонецПопытки;
		//	
		//Иначе
			
			Выполнить("ГосНомер	 = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль.Ссылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер)");
			//Пробег		 = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Элемент.ТекущиеДанные.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
			
		//КонецЕсли;
		
	КонецЕсли;
	
	#КонецЕсли
		
	Если Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка Тогда
		
		
	/// При старте приемки запишем все документы по обращению в регистр "Renault_АвтосервисПланОперативный"
	ИначеЕсли Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ПриемкаНачата Тогда
		
		// запишем приемку
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
