Функция НайтиСвязанныеЗаявкиНаСервис()

	МассивЗаявок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
	               |		ПО Renault_CRM_ПриемкаАвтомобиля.Обращение = Renault_CRM_ЗаявкаНаСервис.Обращение
	               |			И (Renault_CRM_ПриемкаАвтомобиля.Ссылка = &Ссылка
	               |				И НЕ Renault_CRM_ЗаявкаНаСервис.ПометкаУдаления)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивЗаявок.Добавить(Выборка.Ссылка);	
	КонецЦикла;

	Возврат МассивЗаявок;
	
