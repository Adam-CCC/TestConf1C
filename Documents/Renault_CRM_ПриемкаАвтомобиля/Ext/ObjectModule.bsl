Функция ОчиститьПланПоКлиенту(Обращение) Экспорт
	
	#Если Клиент Тогда
	
	Если ЗначениеЗаполнено(Обращение) Тогда
		
		СписокСтатусов = Новый СписокЗначений;
		СписокСтатусов.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована);
		СписокСтатусов.Добавить(Справочники.Renault_СтатусыАвторабот.РаботаПросрочена);
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_АвтосервисСтатусыРаботСрезПоследних.СтатусРаботы
		|ИЗ
		|	РегистрСведений.Renault_АвтосервисСтатусыРабот.СрезПоследних(
		|			,
		|			Обращение = &ТекущееОбращение
		|				) КАК Renault_АвтосервисСтатусыРаботСрезПоследних";
		Запрос.УстановитьПараметр("ТекущееОбращение", Обращение);
		Запрос.УстановитьПараметр("СписокСтатусов", СписокСтатусов);
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			
			Ответ = Вопрос("Вы уверены что хотите удалить планирование по текущему клиенту?", РежимДиалогаВопрос.ДаНет);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				
				НаборПлан = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьНаборЗаписей();
				НаборПлан.Отбор.Обращение.Установить(Обращение);
				НаборПлан.Прочитать();
				НаборПлан.Очистить();
				НаборПлан.Записать();
				
				НаборСтатусы = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
				НаборСтатусы.Отбор.Обращение.Установить(Обращение);
				НаборСтатусы.Прочитать();
				НаборСтатусы.Очистить();
				НаборСтатусы.Записать();
				
				НаборПланОп = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
				НаборПланОп.Отбор.Обращение.Установить(Обращение);
				НаборПланОп.Прочитать();
				НаборПланОп.Очистить();
				НаборПланОп.Записать();
				
				НаборФактОп = РегистрыСведений.Renault_АвтосервисФактОперативный.СоздатьНаборЗаписей();
				НаборФактОп.Отбор.Обращение.Установить(Обращение);
				НаборФактОп.Прочитать();
				НаборФактОп.Очистить();
				НаборФактОп.Записать();
				
				ПустаяДата = '00010101';
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	Renault_CRM_ПриемкаАвтомобиля.Ссылка
				|ИЗ
				|	Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
				|ГДЕ
				|	Renault_CRM_ПриемкаАвтомобиля.Обращение = &Обращение";
				Запрос.УстановитьПараметр("Обращение", Обращение);
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
					ОбъектДок.ВремяНачала = ПустаяДата;
					ОбъектДок.ВремяОкончания = ПустаяДата;
					ОбъектДок.Машиноместо = Справочники.Сотрудники.ПустаяСсылка();
					ОбъектДок.Записать();
				КонецЦикла;
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	Renault_CRM_ВыдачаАвтомобиля.Ссылка
				|ИЗ
				|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
				|ГДЕ
				|	Renault_CRM_ВыдачаАвтомобиля.Обращение = &Обращение";
				Запрос.УстановитьПараметр("Обращение", Обращение);
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
					ОбъектДок.ВремяНачала = ПустаяДата;
					ОбъектДок.ВремяОкончания = ПустаяДата;
					ОбъектДок.Машиноместо = Справочники.Сотрудники.ПустаяСсылка();
					ОбъектДок.Записать();
				КонецЦикла;
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	Renault_CRM_ЗаявкаНаМойку.Ссылка
				|ИЗ
				|	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
				|ГДЕ
				|	Renault_CRM_ЗаявкаНаМойку.Обращение = &Обращение";
				Запрос.УстановитьПараметр("Обращение", Обращение);
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
					ОбъектДок.ВремяНачала = ПустаяДата;
					ОбъектДок.ВремяОкончания = ПустаяДата;
					ОбъектДок.Машиноместо = Справочники.Renault_CRM_Мойки.ПустаяСсылка();
					ОбъектДок.Записать();
				КонецЦикла;
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	Renault_CRM_ЗаявкаНаСервис.Ссылка
				|ИЗ
				|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
				|ГДЕ
				|	Renault_CRM_ЗаявкаНаСервис.Обращение = &Обращение";
				Запрос.УстановитьПараметр("Обращение", Обращение);
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
					ОбъектДок.ВремяНачала = ПустаяДата;
					ОбъектДок.ВремяОкончания = ПустаяДата;
					Для Каждого СтрокаРаботы ИЗ ОбъектДок.Работы Цикл
						СтрокаРаботы.ВремяНачала = ПустаяДата;
						СтрокаРаботы.ВремяОкончания = ПустаяДата;
						СтрокаРаботы.Машиноместо = Справочники.Цеха.ПустаяСсылка();
					КонецЦикла;
					ОбъектДок.Записать();
				КонецЦикла;
				
				Если Вопрос("Клиент упущен?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				
					Возврат Истина
				
				Иначе
			
					Возврат Ложь;
			
				КонецЕсли;

				
			КонецЕсли;
			
		Иначе
			Предупреждение("План по обращению отсутствует" + Символы.ПС + "или по данному обращению нельзя изменять планирование.");
			
			Если Вопрос("Клиент упущен?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
				
				Возврат Истина
				
			Иначе
			
				Возврат Ложь;
			
			КонецЕсли;
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
	#КонецЕсли

	
