Функция ПроверкаГосНомера(ГосНомер)
	
	Для х=0 по СтрДлина(ГосНомер) цикл
		ТекСимвол = Сред(ГосНомер,х,1);
		Если НЕ КодСимвола(ТекСимвол)= 32  //пробел
			и НЕ (КодСимвола(ТекСимвол)>47 и КодСимвола(ТекСимвол)<58) //цифры
			и НЕ (КодСимвола(ТекСимвол)>64 и КодСимвола(ТекСимвол)<91) //большие латинские буквы
			и НЕ (КодСимвола(ТекСимвол)>96 и КодСимвола(ТекСимвол)<123) //маленькие латинские буквы
			Тогда
				Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
		
