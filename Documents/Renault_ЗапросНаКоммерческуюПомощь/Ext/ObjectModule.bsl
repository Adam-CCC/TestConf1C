Функция СохранитьИПрикрепитьКДокументу(ТабДокумент,ДокументСсылка) Экспорт
	
	//ВременноеИмяФайла = ПолучитьИмяВременногоФайла("XLS"); 
	ПрефиксБланка =  "Бланк_ЗКП_№";
	ИимяБланка = ПрефиксБланка + ДокументСсылка.Номер+".XLS";
	
	//Проверим создав
	ВременноеИмяФайла = КаталогВременныхФайлов()+ИимяБланка;
	
	ТабДокумент.Записать(ВременноеИмяФайла,ТипФайлаТабличногоДокумента.XLS);
	ФайлXLS = Новый Файл(ВременноеИмяФайла);
	
	Если ФайлXLS.Существует() Тогда
		
		Запрос = новый Запрос(
		"ВЫБРАТЬ
		|	КартинкиИФайлы.Идентификатор,
		|	КартинкиИФайлы.ИмяФайла,
		|	КартинкиИФайлы.ДатаСохранения,
		|	КартинкиИФайлы.Комментарий,
		|	КартинкиИФайлы.Данные КАК ХранилищеДанных,
		|	КартинкиИФайлы.Объект
		|ИЗ
		|	РегистрСведений.Renault_КартинкиИФайлы КАК КартинкиИФайлы
		|ГДЕ
		|	КартинкиИФайлы.Объект = &Объект
		|	И КартинкиИФайлы.Наименование ПОДОБНО &Наименование"
		);
		Запрос.УстановитьПараметр("Объект", ДокументСсылка);
		Запрос.УстановитьПараметр("Наименование", "%"+ПрефиксБланка+"%");
	
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			 Идентификатор = Выборка.Идентификатор;
		КонецЦикла;
		
		НаборЗаписей = РегистрыСведений.Renault_КартинкиИФайлы.СоздатьНаборЗаписей();
		
		Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
			ТекущийНаборЗаписей = НаборЗаписей.Добавить();		 
		Иначе
			НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор);
			НаборЗаписей.Прочитать();
			ТекущийНаборЗаписей = НаборЗаписей[0];
		КонецЕсли;
				
		ТекущийНаборЗаписей.Объект = ДокументСсылка;
		ТекущийНаборЗаписей.ИмяФайла = ФайлXLS.ПолноеИмя;
		ТекущийНаборЗаписей.ДанныеВоВнешнемФайле = Ложь;
		ТекущийНаборЗаписей.РазмерФайла = ФайлXLS.Размер();
		ТекущийНаборЗаписей.ДатаСохранения = ТекущаяДата();
		
		ТекущийНаборЗаписей.Данные = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ФайлXLS.ПолноеИмя), Новый СжатиеДанных(9));
		ТекущийНаборЗаписей.Наименование = ФайлXLS.ИмяБезРасширения;

		ТекущийНаборЗаписей.Картинка = Ложь;

		Если НЕ ЗначениеЗаполнено(ТекущийНаборЗаписей.Идентификатор) Тогда
			ТекущийНаборЗаписей.Идентификатор = Новый УникальныйИдентификатор();
		Иначе
			ТекущийНаборЗаписей.Идентификатор = Идентификатор;
		КонецЕсли;
				
		НаборЗаписей.Записать(Истина);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции