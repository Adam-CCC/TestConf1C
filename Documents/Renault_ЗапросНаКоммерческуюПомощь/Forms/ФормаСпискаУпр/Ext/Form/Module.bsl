
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Отбор = Истина;
	Статус = ПолучитьСтатусПоСтранице (ТекущаяСтраница);
	
	Если ТекущаяСтраница = Элементы.ГруппаВсе Тогда
		Отбор = Ложь;
	КонецЕсли;
	
	ОбновитьЗапросСписка (Отбор, Статус);
	УстановитьЗаголовки();
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтатусПоСтранице (ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.ГруппаВсе Тогда
		Статус = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ПустаяСсылка();
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаОтправлен Тогда
		Статус = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросОтправлен;
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаРассмотрении Тогда
		Статус = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросНаРассмотренииSRC;
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаОжидание Тогда
		Статус = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ВОжиданииОтветаДилера;
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаОдобренно Тогда
		Статус = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.Одобрено;
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаНеодобрено Тогда
		Статус = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.НеОдобрено;
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаЗакрыто Тогда
		Статус = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.Закрыто; 
	КонецЕсли;
	Возврат Статус;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапроса ()
	
	Возврат "ВЫБРАТЬ
	|	Renault_ЗапросНаКоммерческуюПомощь.Ссылка,
	|	Renault_ЗапросНаКоммерческуюПомощь.Номер,
	|	Renault_ЗапросНаКоммерческуюПомощь.Дата,
	|	Renault_ЗапросНаКоммерческуюПомощь.Контрагент,
	|	Renault_ЗапросНаКоммерческуюПомощь.Автомобиль,
	|	Renault_ЗапросНаКоммерческуюПомощь.ПричинаОбращения,
	|	Renault_ЗапросНаКоммерческуюПомощь.ЗапросДилераСумма,
	|	Renault_ЗапросНаКоммерческуюПомощь.Комментарий,
	|	Renault_ЗапросНаКоммерческуюПомощь.CaseNumber,
	|	Renault_ЗапросНаКоммерческуюПомощь.CaseStatus,
	|	Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса,
	|	Renault_ЗапросНаКоммерческуюПомощь.DateResolved,
	|	ВЫРАЗИТЬ(РАЗНОСТЬДАТ(Renault_ЗапросНаКоммерческуюПомощь.Дата, Renault_ЗапросНаКоммерческуюПомощь.DateResolved, ДЕНЬ) КАК ЧИСЛО(15, 2)) КАК DateResolvedAlert
	|ИЗ
	|	Документ.Renault_ЗапросНаКоммерческуюПомощь КАК Renault_ЗапросНаКоммерческуюПомощь";
	
КонецФункции

&НаСервере
Процедура ОбновитьЗапросСписка (Отбор, Статус)
	ТекстЗапроса = ПолучитьТекстЗапроса();
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	Если Отбор Тогда
		ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
		ОтборЗапрос = ПакетЗапросов.Операторы[0].Отбор;
		ОтборЗапрос.Добавить("Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса = &СтатусЗапроса");
	КонецЕсли; 
	Если ФлажокОткрытия Тогда
		ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
		ОтборЗапрос = ПакетЗапросов.Операторы[0].Отбор;
		ОтборЗапрос.Добавить("Renault_ЗапросНаКоммерческуюПомощь.ДатаОткрытияДосье >= &ДатаНачала");
		ОтборЗапрос.Добавить("Renault_ЗапросНаКоммерческуюПомощь.ДатаОткрытияДосье <= &ДатаОкончания");
	КонецЕсли;
	Если ФлажокЗакрытия Тогда
		ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
		ОтборЗапрос = ПакетЗапросов.Операторы[0].Отбор;
		ОтборЗапрос.Добавить("Renault_ЗапросНаКоммерческуюПомощь.ДатаЗакрытияДосье >= &ДатаНачала");
		ОтборЗапрос.Добавить("Renault_ЗапросНаКоммерческуюПомощь.ДатаЗакрытияДосье <= &ДатаОкончания");
	КонецЕсли;
	Список.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	Если Отбор Тогда
		Список.Параметры.УстановитьЗначениеПараметра("СтатусЗапроса", Статус);
	КонецЕсли;
	Если ФлажокОткрытия Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ПериодОткрытия.ДатаНачала);
		Список.Параметры.УстановитьЗначениеПараметра("ДатаОкончания", ПериодОткрытия.ДатаОкончания);
	КонецЕсли;
	Если ФлажокЗакрытия Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ПериодЗакрытия.ДатаНачала);
		Список.Параметры.УстановитьЗначениеПараметра("ДатаОкончания", ПериодЗакрытия.ДатаОкончания);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовки ()
	ТекстЗапроса = ПолучитьТекстЗапроса();
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	сОтбор = Новый Структура;
	Элементы.ГруппаВсе.Заголовок = "Все запросы (" + ПросчитатьКоличествоЛидов(СхемаЗапроса.ПолучитьТекстЗапроса(), сОтбор)+")";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
	Отбор = ПакетЗапросов.Операторы[0].Отбор;
	сОтбор = Новый Структура;
	сОтбор.Вставить("СтатусЗапроса", Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросОтправлен);
	Отбор.Добавить("Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса = &СтатусЗапроса");
	Элементы.ГруппаОтправлен.Заголовок = "Запрос отправлен (" + ПросчитатьКоличествоЛидов(СхемаЗапроса.ПолучитьТекстЗапроса(), сОтбор)+")";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
	Отбор = ПакетЗапросов.Операторы[0].Отбор;
	сОтбор = Новый Структура;
	сОтбор.Вставить("СтатусЗапроса", Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросНаРассмотренииSRC);
	Отбор.Добавить("Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса = &СтатусЗапроса");
	Элементы.ГруппаРассмотрении.Заголовок = "Запрос на рассмотрении (" + ПросчитатьКоличествоЛидов(СхемаЗапроса.ПолучитьТекстЗапроса(), сОтбор)+")";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
	Отбор = ПакетЗапросов.Операторы[0].Отбор;
	сОтбор = Новый Структура;
	сОтбор.Вставить("СтатусЗапроса", Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ВОжиданииОтветаДилера);
	Отбор.Добавить("Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса = &СтатусЗапроса");
	Элементы.ГруппаОжидание.Заголовок = "В ожидании ответа от дилера (" + ПросчитатьКоличествоЛидов(СхемаЗапроса.ПолучитьТекстЗапроса(), сОтбор)+")";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
	Отбор = ПакетЗапросов.Операторы[0].Отбор;
	сОтбор = Новый Структура;
	сОтбор.Вставить("СтатусЗапроса", Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.Одобрено);
	Отбор.Добавить("Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса = &СтатусЗапроса");
	Элементы.ГруппаОдобренно.Заголовок = "Одобрено (" + ПросчитатьКоличествоЛидов(СхемаЗапроса.ПолучитьТекстЗапроса(), сОтбор)+")";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
	Отбор = ПакетЗапросов.Операторы[0].Отбор;
	сОтбор = Новый Структура;
	сОтбор.Вставить("СтатусЗапроса", Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.НеОдобрено);
	Отбор.Добавить("Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса = &СтатусЗапроса");
	Элементы.ГруппаНеодобрено.Заголовок = "Неодобрено (" + ПросчитатьКоличествоЛидов(СхемаЗапроса.ПолучитьТекстЗапроса(), сОтбор)+")";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[0];
	Отбор = ПакетЗапросов.Операторы[0].Отбор;
	сОтбор = Новый Структура;
	сОтбор.Вставить("СтатусЗапроса", Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.Закрыто);
	Отбор.Добавить("Renault_ЗапросНаКоммерческуюПомощь.СтатусЗапроса = &СтатусЗапроса");
	Элементы.ГруппаЗакрыто.Заголовок = "Закрытые (" + ПросчитатьКоличествоЛидов(СхемаЗапроса.ПолучитьТекстЗапроса(), сОтбор)+")";

КонецПроцедуры

&НаСервереБезКонтекста
Функция  ПросчитатьКоличествоЛидов (ТекстЗапроса, сПараметры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Для Каждого Параметр из сПараметры Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ТЗ.Количество();
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьЗаголовки();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок ()
	
	Отбор = Истина;
	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	Статус = ПолучитьСтатусПоСтранице (ТекущаяСтраница);
	
	Если ТекущаяСтраница = Элементы.ГруппаВсе Тогда
		Отбор = Ложь;
	КонецЕсли;
	
	ОбновитьЗапросСписка (Отбор, Статус);
	
КонецПроцедуры

&НаКлиенте
Процедура ФлажокОткрытияПриИзменении(Элемент)
	ОбновитьСписок ();
КонецПроцедуры

&НаКлиенте
Процедура ФлажокЗакрытияПриИзменении(Элемент)
	ОбновитьСписок();
КонецПроцедуры

&НаКлиенте
Процедура ПериодЗакрытияПриИзменении(Элемент)
	Если ФлажокЗакрытия Тогда
		ОбновитьСписок();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПериодОткрытияПриИзменении(Элемент)
	Если ФлажокОткрытия Тогда
		ОбновитьСписок();
	КонецЕсли;
КонецПроцедуры
