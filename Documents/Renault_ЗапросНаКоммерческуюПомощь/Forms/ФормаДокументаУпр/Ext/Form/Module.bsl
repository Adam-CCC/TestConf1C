&Наклиенте
Функция ОтправитьHTTPЗапрос(Ответ,Сервер="localhost",ТипПакета, ПараметрыЗапроса, ЗащищенноеСоединение) 
	
	//Пользователь=Справочники.DMS_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ЛогинДоступаКВебСервисам;
	//Пароль=Справочники.DMS_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ПарольДоступаКВебСервисам;
	//
	//ЗаписьJSON=Новый ЗаписьJSON;
	//ЗаписьJSON.УстановитьСтроку();
	//ЗаписатьJSON(ЗаписьJSON,Значение);
	//value=ЗаписьJSON.Закрыть();

	//параметры в URL нельзя использовать из-за ограничения на длину URL
	//имя базы = dev3_gate
	//имя веб сервиса = traffic
	URL="/dev3_gate/hs/traffic/"+Сервер+"/"+ТипПакета+"/v1/msg";//+?(ПараметрыСтрокой()="","","?"+ПараметрыСтрокой());
	Заголовки=Новый Соответствие;
	Заголовки.Вставить("Content-Type","text/html; charset=UTF-8");
	
	//вычисление и создание объектов для защищенного соединения
	//User="Админ";
	//Pass="Админ";
	//Соединение=Новый HTTPСоединение("localhost",80,User,Pass,,,Новый ЗащищенноеСоединениеOpenSSL);
	
	Если ЗащищенноеСоединение Тогда
		Порт = 443;
		Защита = Новый ЗащищенноеСоединениеOpenSSL(
			Новый СертификатКлиентаWindows(СпособВыбораСертификатаWindows.Выбирать),
			Новый СертификатыУдостоверяющихЦентровWindows());
	Иначе
		Порт = 8080;
		Защита = Неопределено;
	КонецЕсли;

	Соединение = Новый HTTPСоединение("localhost",Порт,,,,,Защита); //89.108.111.89:55890
	
	Запрос = Новый HTTPЗапрос(URL,Заголовки);
	
	Запрос.УстановитьТелоИзСтроки(УпаковатьДанные(ПараметрыЗапроса));
	
	Попытка 
		ОтветСервера  = Соединение.ОтправитьДляОбработки(Запрос);
		Ответ = ОтветСервера.ПолучитьТелоКакСтроку();
	Исключение
		Сообщить("Не установлено соединение с сервисом "+ОписаниеОшибки(),СтатусСообщения.Информация);
		Возврат Ложь
	КонецПопытки;	
	
	Если ОтветСервера.КодСостояния=200 Тогда 
		Ответ=РаспаковатьДанные(Ответ); 
		Возврат Истина
	ИначеЕсли ОтветСервера.КодСостояния=400 Тогда Ответ="Не верный запрос. "+Ответ
	ИначеЕсли ОтветСервера.КодСостояния=404 Тогда Ответ="Ошибка при работе с ресурсом. "+Ответ
	ИначеЕсли ОтветСервера.КодСостояния=401 Тогда Ответ="Не авторизован. "+Ответ
	ИначеЕсли ОтветСервера.КодСостояния=500 Тогда Ответ="Внутренняя ошибка сервера. "+Ответ
	Иначе Ответ="Не удалось установить соединение с сервисом"
	КонецЕсли;
	
	Сообщить(Ответ,СтатусСообщения.Внимание);
	Возврат Ложь
КонецФункции	

