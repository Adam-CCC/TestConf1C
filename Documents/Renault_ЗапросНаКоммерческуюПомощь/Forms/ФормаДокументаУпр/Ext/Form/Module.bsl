	Объект.Ответственный = ПараметрыСеанса.Пользователь;
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	Объект.БизнесРегион = ДЦ.DMS_БизнесРегион;
		
	Если Объект.ЗапросДилераСумма > Объект.РекомендованнаяКоммерческаяПомощь Тогда
		Элементы.КоментарийПричинаУвелеченияСкидки.Видимость = Истина;
	КонецЕсли;
		
