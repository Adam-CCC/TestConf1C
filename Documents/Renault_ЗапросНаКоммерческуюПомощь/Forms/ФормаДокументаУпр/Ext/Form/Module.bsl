&НаКлиенте
Функция ДоступноПравоНаКлиенте(НазваниеПрава);
	
	ПараметрОтбора = Новый Структура("ИмяПрава","ПолныеПрава");
	Если НаборПравПользователя.НайтиСтроки(ПараметрОтбора).Количество() = 1 тогда 
		Возврат Истина;
	Иначе
		ПараметрОтбора = Новый Структура("ИмяПрава",НазваниеПрава);
		Если НаборПравПользователя.НайтиСтроки(ПараметрОтбора).Количество() = 1 тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

