&НаСервере
Процедура ЗаполнитьКонтактнуюИнформациюНаФорме();

	Если ЗначениеЗаполнено(Объект.Контрагент) тогда
		КлиентТелефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.Контрагент);
		КлиентEmail = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Объект.Контрагент);
		КлиентАдрес = Renault_УправлениеКонтактнойИнформацией.АдресКлиента(Объект.Контрагент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СпециалистРено) тогда
		СпециалистРеноТелефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.СпециалистРено);
		СпециалистРеноEmail = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Объект.СпециалистРено);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) тогда
		Объект.Ответственный =  ПараметрыСеанса.Пользователь
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Ответственный.Сотрудник) тогда
		ОтветственныйТелефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Объект.Ответственный.Сотрудник);
		ОтветственныйEmail = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Объект.Ответственный.Сотрудник);
	КонецЕсли;
	
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	BIRКод = Лев(ДЦ.BIR,8);
	АдресДЦ = ДЦ.ОсновнойАдрес;	
	
Конецпроцедуры

&НаСервере
Функция СформироватьТекстСообщения()
	
	//ЗКП_<НомерДокументаОбращение>_<BIR Дилера>_<НазваниеДилера>_<ФИО_Клиента>
	//Символы.НПП разрыв
	
	//BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	BIR = ДЦ.BIR; 	
	ЗаголовокПисьма  = НСтр("ru='DMS_TEST_ЗКП_'")+"_"+Объект.Номер+"_"+BIR+"_"+ДЦ+"_"+Объект.Контрагент+"";
	СтрокаПисьма = Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "-----------------------------" + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Номер запроса: " + Объект.Номер + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Дата запроса: " + Объект.Дата + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Основание: " + Объект.ПричинаОбращения + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Регион: " + Объект.БизнесРегион + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "BIR код: " + BIRКод + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Адрес ДЦ: " + АдресДЦ + Символы.ПС;
	
	СтрокаПисьма = СтрокаПисьма + "-----------------------------" + Символы.ПС;
	
	СтрокаПисьма = СтрокаПисьма + "Ответственный: " + Объект.Ответственный + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Ответственный телефон: " + ОтветственныйТелефон + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Ответственный email: " + ОтветственныйEmail + Символы.ПС;
	
	СтрокаПисьма = СтрокаПисьма + "-----------------------------" + Символы.ПС;
	
	СтрокаПисьма = СтрокаПисьма + "Клиент: " + Объект.Контрагент + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Клиент телефон: " + КлиентТелефон + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Клиент адрес: " + КлиентАдрес + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Клиент Email: " + КлиентEmail + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Адрес ДЦ: " + АдресДЦ + Символы.ПС;
	
	СтрокаПисьма = СтрокаПисьма + "-----------------------------" + Символы.ПС;

	СтрокаПисьма = СтрокаПисьма + "Автомобиль: " + Объект.Автомобиль + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "VIN: " + Объект.VIN + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Модель: " + Объект.Модель + Символы.ПС;
	СтрокаПисьма = СтрокаПисьма + "Государственный номер: " + Объект.ГосНомер + Символы.ПС;
	
	СтрокаПисьма = СтрокаПисьма + "-----------------------------" + Символы.ПС;
	
	СтрокаПисьма = СтрокаПисьма + "Запрос дилера: " + Объект.ЗапросДилераСумма + Символы.ПС;
	
	ТекстСообщения = ЗаголовокПисьма  + СтрокаПисьма;
	Возврат ТекстСообщения;
	
КонецФункции

&НаСервере
Функция СформироватьТЗДляОтправки(Ссылка)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ЗапросНаКоммерческуюПомощь.Ссылка КАК Ссылка,
		|	Renault_ЗапросНаКоммерческуюПомощь.Номер КАК Number,
		|	Renault_ЗапросНаКоммерческуюПомощь.Дата КАК Datetime,
		|	Renault_ЗапросНаКоммерческуюПомощь.Контрагент.Наименование КАК Partner,
		|	Renault_ЗапросНаКоммерческуюПомощь.Автомобиль.Наименование КАК Auto,
		|	Renault_ЗапросНаКоммерческуюПомощь.ПричинаОбращения.Наименование КАК ReasonPetition,
		|	Renault_ЗапросНаКоммерческуюПомощь.Гарантия КАК Guarantee,
		|	Renault_ЗапросНаКоммерческуюПомощь.Пробег КАК Mileage,
		|	Renault_ЗапросНаКоммерческуюПомощь.ГосНомер КАК GovNumber,
		|	ПРЕДСТАВЛЕНИЕ(Renault_ЗапросНаКоммерческуюПомощь.ТипКлиента) КАК СustomerType,
