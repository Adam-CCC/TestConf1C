	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ПричинаОбращения) Тогда
		 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Основание"+Символ(34)+" не заполнено",,"ПричинаОбращения","Объект",Отказ);	 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ОщущениеКлиента) Тогда
		 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Ощущение клиента (жалоба)"+Символ(34)+" не заполнено",,"ОщущениеКлиента","Объект",Отказ);	 
 	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ПроблемнаяСистемаАвто) Тогда
		 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Причина неисправности а/м"+Символ(34)+" не заполнено",,"ПроблемнаяСистемаАвто","Объект",Отказ);	 
 	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ПрохождениеТО) Тогда
		 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Прохождение ТО"+Символ(34)+" не заполнено",,"ПрохождениеТО","Объект",Отказ);	 
	
	//ИначеЕсли ЗначениеЗаполнено(Объект.СтоимостьРешения) Тогда
	//	 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Стоимость решения"+Символ(34)+" не заполнено",,,"ПричинаОбращения",Отказ);	 	 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СтоимостьРешенияПоГарантийнымРасценкам) Тогда
		 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Стоимость решения по гарантийным расценкам"+Символ(34)+" не заполнено",,"СтоимостьРешенияПоГарантийнымРасценкам","Объект",Отказ);	 
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.СтоимостьРешенияПоКоммерческимРасценкам) Тогда
		 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Стоимость решения по коммерческим расценкам"+Символ(34)+" не заполнено",,"СтоимостьРешенияПоКоммерческимРасценкам","Объект",Отказ);	 
		  		 
	КонецЕсли;
		
	Возврат Отказ;

	
