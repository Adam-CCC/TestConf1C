	Пока Выборка.Следующий() Цикл
		newRow = Attaches.Добавить();
		newRow.GUID_FILE = Строка(Выборка.ИдентификаторФайла);
		СтруктураИмениФайла = Renault_ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Выборка.ИмяФайла);
		newRow.FILENAME = СтруктураИмениФайла.Имя;
		newRow.DESCRIPTION = Выборка.Комментарий;
		newRow.Data = Выборка.ХранилищеДанных;
	КонецЦикла;
	
	ТабДокумент = СформироватьТабличныйДокументЗКПНаСервере();

	ПрефиксБланка =  "Бланк_ЗКП_№";
	ИимяБланка = ПрефиксБланка + Ссылка.Номер+".XLS";
	ВременноеИмяФайла = КаталогВременныхФайлов()+ИимяБланка;	
	ТабДокумент.Записать(ВременноеИмяФайла,ТипФайлаТабличногоДокумента.XLS);
	ФайлXLS = Новый Файл(ВременноеИмяФайла);

	newRow = Attaches.Добавить();
	newRow.GUID_FILE = Строка(Ссылка.УникальныйИдентификатор());
	СтруктураИмениФайла = Renault_ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ФайлXLS.ПолноеИмя);
	newRow.FILENAME = СтруктураИмениФайла.Имя;
	newRow.DESCRIPTION = ИимяБланка;
	newRow.Data = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ФайлXLS.ПолноеИмя), Новый СжатиеДанных(9));

	
	ПараметрыЗапроса.Вставить("Attaches", Attaches); 

	Возврат ПараметрыЗапроса;
	
КонецФункции


