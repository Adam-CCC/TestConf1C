&НаСервере
Процедура ОпределитьПроцентРекомендованнойКоммерческойПомощи()
	
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаПродажиАвто) Тогда
		Отказ = Истина;
	    Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"Дата продажи"+Символ(34)+" не заполнено",,,"ДатаПродажиАвто",Отказ);	 
	КонецЕсли;
	
	Гарантия = Объект.Гарантия;	
	
	Если Гарантия Тогда
		МаксРазмерСкидки = 50;
	Иначе 
		МаксРазмерСкидки = 100;
	КонецЕсли;
			
	ВозрастАвто = (НачалоДня(ТекущаяДата()) - НачалоДня(Объект.ДатаПродажиАвто)) / (60 * 60 * 24);   // ОпределитьВозврастАвто(Объект.ДатаПродажиАвто,ТекущаяДата());
	ПробегАвто = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Объект.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег,ТекущаяДата());
	
	БаллыВозрастАвто = 0;
	БаллыПробегАвто = 0;
	БаллыДополнительные = 0;
	
	Если Гарантия Тогда
		
		Если ВозрастАвто >=0 И  ВозрастАвто <= 122 Тогда
			БаллыВозрастАвто = 50;	
		ИначеЕсли ВозрастАвто > 122 И ВозрастАвто <= 213.5 Тогда
			БаллыВозрастАвто = 45;
		ИначеЕсли ВозрастАвто > 213.5 И ВозрастАвто <= 305 Тогда
			БаллыВозрастАвто = 40;
	    ИначеЕсли ВозрастАвто > 305 И ВозрастАвто <= 395.5 Тогда
			БаллыВозрастАвто = 35;
		ИначеЕсли ВозрастАвто > 395.5 И ВозрастАвто <= 487 Тогда
			БаллыВозрастАвто = 30;
		ИначеЕсли ВозрастАвто > 395.5 И ВозрастАвто <= 609 Тогда
			БаллыВозрастАвто = 25;
		ИначеЕсли ВозрастАвто > 609 И ВозрастАвто <= 730 Тогда
			БаллыВозрастАвто = 20;
		ИначеЕсли ВозрастАвто > 730 И ВозрастАвто <= 852 Тогда
			БаллыВозрастАвто = 15;
		ИначеЕсли ВозрастАвто > 852 И ВозрастАвто <= 974 Тогда
			БаллыВозрастАвто = 10;
		ИначеЕсли ВозрастАвто > 974 Тогда
			БаллыВозрастАвто = 5;
		КонецЕсли;
		
	Иначе
		
		Если ВозрастАвто <= 1247.5 Тогда
			БаллыВозрастАвто = 100;
		ИначеЕсли ВозрастАвто > 1247.5 И ВозрастАвто <= 1369.5 Тогда
			БаллыВозрастАвто = 90;
		ИначеЕсли ВозрастАвто > 1369.5 И ВозрастАвто <= 1582 Тогда
			БаллыВозрастАвто = 80;
	    ИначеЕсли ВозрастАвто > 1582 И ВозрастАвто <= 1704 Тогда
			БаллыВозрастАвто = 70;
 		ИначеЕсли ВозрастАвто > 1704 И ВозрастАвто <= 1825 Тогда
			БаллыВозрастАвто = 60;
		ИначеЕсли ВозрастАвто > 1825 И ВозрастАвто <= 1947 Тогда
			БаллыВозрастАвто = 50;
		ИначеЕсли ВозрастАвто > 1947 И ВозрастАвто <= 2038.5 Тогда
			БаллыВозрастАвто = 40;
		ИначеЕсли ВозрастАвто > 2038.5 И ВозрастАвто <= 2130 Тогда
			БаллыВозрастАвто = 30;
		ИначеЕсли ВозрастАвто > 2130 И ВозрастАвто <= 2190 Тогда
			БаллыВозрастАвто = 20;
		ИначеЕсли ВозрастАвто > 2190 Тогда
			БаллыВозрастАвто = 10;
		КонецЕсли;

	КонецЕсли;
	
	Если Гарантия Тогда
		
		Если ПробегАвто <> Неопределено Тогда
			Если ПробегАвто <= 20000 Тогда
				БаллыПробегАвто = 50;
			ИначеЕсли ПробегАвто > 20000 И ПробегАвто <= 30000 Тогда
				БаллыПробегАвто = 45;
		    ИначеЕсли ПробегАвто > 30000 И ПробегАвто <= 40000 Тогда
				БаллыПробегАвто = 40;
			ИначеЕсли ПробегАвто > 40000 И ПробегАвто <= 50000 Тогда
				БаллыПробегАвто = 35;
			ИначеЕсли ПробегАвто > 50000 И ПробегАвто <= 60000 Тогда
				БаллыПробегАвто = 30;
			ИначеЕсли ПробегАвто > 60000 И ПробегАвто <= 70000 Тогда
				БаллыПробегАвто = 25;
			ИначеЕсли ПробегАвто > 70000 И ПробегАвто <= 80000 Тогда
				БаллыПробегАвто = 20;
			ИначеЕсли ПробегАвто > 80000 И ПробегАвто <= 90000 Тогда
				БаллыПробегАвто = 15;
			ИначеЕсли ПробегАвто > 90000 И ПробегАвто <= 100000 Тогда
				БаллыПробегАвто = 10;
			ИначеЕсли ПробегАвто > 100000 Тогда
				БаллыПробегАвто = 5;
			КонецЕсли;
		КонецЕсли;
			
	Иначе
		
		Если ПробегАвто <> Неопределено Тогда

			Если ПробегАвто <= 20000 Тогда
				БаллыПробегАвто = 100;
			ИначеЕсли ПробегАвто > 20000 И ПробегАвто <= 30000 Тогда
				БаллыПробегАвто = 90;
		    ИначеЕсли ПробегАвто > 30000 И ПробегАвто <= 40000 Тогда
				БаллыПробегАвто = 80;
			ИначеЕсли ПробегАвто > 40000 И ПробегАвто <= 50000 Тогда
				БаллыПробегАвто = 70;
			ИначеЕсли ПробегАвто > 50000 И ПробегАвто <= 60000 Тогда
				БаллыПробегАвто = 60;
			ИначеЕсли ПробегАвто > 60000 И ПробегАвто <= 70000 Тогда
				БаллыПробегАвто = 50;
			ИначеЕсли ПробегАвто > 70000 И ПробегАвто <= 80000 Тогда
				БаллыПробегАвто = 40;
			ИначеЕсли ПробегАвто > 80000 И ПробегАвто <= 90000 Тогда
				БаллыПробегАвто = 30;
			ИначеЕсли ПробегАвто > 90000 И ПробегАвто <= 100000 Тогда
				БаллыПробегАвто = 20;
			ИначеЕсли ПробегАвто > 100000 Тогда
				БаллыПробегАвто = 10;
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
	
	Если Гарантия Тогда
		
		Если Объект.ПрохождениеТО = Перечисления.Renault_ПрохождениеТО.ТОПроводилосьВДилерскойСети Тогда			
			БаллыДополнительные = БаллыДополнительные + 20;
		ИначеЕсли  Объект.ПовтороноеПриобретенияАвто  Тогда
			БаллыДополнительные = БаллыДополнительные + 20;
		ИначеЕсли  Объект.НаличиеДопОборудования  Тогда
			БаллыДополнительные = БаллыДополнительные + 20;
		ИначеЕсли  Объект.НаличиеДопОборудования  Тогда
			БаллыДополнительные = БаллыДополнительные + 20;
		ИначеЕсли  Объект.ПлатныеРемонты  Тогда
			БаллыДополнительные = БаллыДополнительные + 20;
		ИначеЕсли  найти(Строка(Объект.Модель),"Megane")>0 
				   или найти(Строка(Объект.Модель),"Koleos")>0 
				   или найти(Строка(Объект.Модель),"Clio")>0       
				   или найти(Строка(Объект.Модель),"Latitude")>0 
				   или найти(Строка(Объект.Модель),"Scenic")>0  Тогда 
			БаллыДополнительные = БаллыДополнительные + 20;
		КонецЕсли;
		
	Иначе
		
		Если Объект.ПрохождениеТО = Перечисления.Renault_ПрохождениеТО.ТОПроводилосьВДилерскойСети Тогда			
			БаллыДополнительные = БаллыДополнительные + 10;
		ИначеЕсли  Объект.ПовтороноеПриобретенияАвто  Тогда
			БаллыДополнительные = БаллыДополнительные + 10;
		ИначеЕсли  Объект.НаличиеДопОборудования  Тогда
			БаллыДополнительные = БаллыДополнительные + 10;
		ИначеЕсли  Объект.НаличиеДопОборудования  Тогда
			БаллыДополнительные = БаллыДополнительные + 10;
		ИначеЕсли  Объект.ПлатныеРемонты  Тогда
			БаллыДополнительные = БаллыДополнительные + 10;
		ИначеЕсли  Найти(Объект.Модель,"Megane")>0 
				   или Найти(Объект.Модель,"Koleos")>0 
				   или Найти(Объект.Модель,"Clio")>0       
				   или Найти(Объект.Модель,"Latitude")>0 
				   или Найти(Объект.Модель,"Scenic")>0  Тогда 
			БаллыДополнительные = БаллыДополнительные + 10;
		КонецЕсли;
	
	КонецЕсли;

	ПроцентСкидки = (БаллыВозрастАвто + БаллыПробегАвто + БаллыДополнительные) /300;
	ПроцентРекомендованноцКоммерческойПомощи = ПроцентСкидки*100;
	

	Если Объект.СтоимостьРешенияПоКоммерческимРасценкам <> 0 Тогда
		Объект.РекомендованнаяКоммерческаяПомощь = ПроцентСкидки * Объект.СтоимостьРешенияПоГарантийнымРасценкам;
		Объект.СкидкаКлиента =  ((ПроцентСкидки * Объект.СтоимостьРешенияПоГарантийнымРасценкам)/Объект.СтоимостьРешенияПоКоммерческимРасценкам)*100;
		
	Иначе
	    Объект.РекомендованнаяКоммерческаяПомощь = 0;
		Объект.СкидкаКлиента = 0;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ОпределитьВозврастАвто(Дата1, Дата2)
	
	ДатаНач = ?(Дата1<Дата2, Дата1,Дата2);
	ДатаКон = ?(Дата1<Дата2, Дата2,Дата1);
	Годы = Год(ДатаКон) - Год(ДатаНач);
	Месяцы = Месяц(ДатаКон) - Месяц(ДатаНач);
	Если Месяцы <> 0 Тогда
		Разность = (Месяцы * 30.5) + (Годы * 12);
	Иначе
		Разность = (Месяцы + Годы * 12)*30.5;
	КонецЕсли;

	Возврат Разность;
 
КонецФункции

