	Отказ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.VIN) Тогда
		 Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле "+Символ(34)+"VIN"+Символ(34)+" не заполнено",,"VIN","Объект",Отказ);
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Модель) Тогда
