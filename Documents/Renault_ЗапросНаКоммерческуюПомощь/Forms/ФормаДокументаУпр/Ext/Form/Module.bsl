&НаСервере
Процедура ОбновитьСтатусЗапросаНаСервере()
	
	ОтветСервера="";
	
	GUID_TZ = Новый ТаблицаЗначений;
	GUID_TZ.Колонки.Добавить("GUID");
	СтрокаТЗ = GUID_TZ.Добавить();
	СтрокаТЗ.GUID = Строка(Объект.Ссылка.УникальныйИдентификатор());
	
	ПараметрыЗапроса = Новый Структура("GUID_TZ,zip",GUID_TZ,9);
		
	ВремяНачала=ТекущаяДата();
		
	Ответ = Неопределено;
	Если  DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"ECARE_serv.readJournal",DMS_DataExchange.newPackage(ПараметрыЗапроса),Ответ) Тогда
		Если Ответ <> Неопределено Тогда
			
			ЗаполнитьЗначенияСвойств(Объект,Ответ,"CaseNumber,CaseStatus,DATE_MODIFIED");
			
			//Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.РешениеПредоставлено;
			ОбновитьЗначениеСтатусаЗапроса(Ответ);
			
			Сообщить("Номер досье в системе RForce: "+Строка(Ответ.CaseNumber) ,СтатусСообщения.Информация);
			Сообщить("Статус досье в системе RForce: "+Строка(Ответ.CaseStatus) ,СтатусСообщения.Информация);
		Иначе
			Сообщить("Ответ от RForce не получен",СтатусСообщения.Информация);
		КонецЕсли;
	Иначе	
		Сообщить("Ошибка при обновлении информации по ЗКП",СтатусСообщения.Внимание);
	КонецЕсли;	
	
	Сообщить("Время выполнения "+(ТекущаяДата()-ВремяНачала)+" сек.");

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗначениеСтатусаЗапроса(ОтветСервера);
	
	CaseStatus = ОтветСервера.CaseStatus;
	DealerProactivityExpected = ОтветСервера.DealerProactivityExpected;
	
	Если CaseStatus = "New" Тогда
		Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросОтправлен;
	ИначеЕсли CaseStatus = "Open" Тогда
		Если не ЗначениеЗаполнено(Объект.ДатаОткрытияДосье) Тогда
			Объект.ДатаОткрытияДосье = ТекущаяДата();
		КонецЕсли;
		Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросНаРассмотренииSRC;
	ИначеЕсли CaseStatus = "Waiting for reply" Тогда
		Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ВОжиданииОтветаДилера;
	ИначеЕсли CaseStatus = "Answered" Тогда
		Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросНаРассмотренииSRC;
	ИначеЕсли CaseStatus = "Resolved" Тогда
		Если ЗначениеЗаполнено(DealerProactivityExpected) Тогда
			Если DealerProactivityExpected Тогда
				Объект.DateResolved = ТекущаяДата();
				Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.Одобрено;
			Иначе
				Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.НеОдобрено;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли CaseStatus = "Closed" Тогда
		Если не ЗначениеЗаполнено(Объект.ДатаЗакрытияДосье) Тогда
			Объект.ДатаЗакрытияДосье = ТекущаяДата();
		КонецЕсли;
		Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.Закрыто;
	КонецЕсли;
	
КонецПроцедуры

