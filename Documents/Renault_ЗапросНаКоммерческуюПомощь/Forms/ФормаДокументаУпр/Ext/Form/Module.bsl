&НаСервере
Функция ПроверитьНаОшибки ()
	
	Ответ = Истина;
	Если Не ЗначениеЗаполнено(КлиентEmail) ТОгда
		Сообщить("Не указан e-mail клиента, отправка невозможна");
		Возврат Ложь;
	КонецЕсли;
	
	Если не Объект.Проведен Тогда
		Сообщить("Перед отправкой ЗКП необходимо провести");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

&НаСервере
Процедура ОтправитьЗапросВКлиентскуюСлужбуНаСервере()
	Если не ПроверитьНаОшибки () Тогда
		Возврат;
	КонецЕсли;
	
	ОтветСервера="";
	
	ПараметрыЗапроса = СформироватьПараметрыЗапроса(Объект.Ссылка);
	
	ВремяНачала=ТекущаяДата();	
	
	Если не DMS_DataExchange.sendMessage(DMS_ОбщиеПовторныеФункции.ПараметрыHTTPСоединения(),,"ECARE_serv.addZKP",DMS_DataExchange.newPackage(ПараметрыЗапроса)) Тогда
		Сообщить("Ошибка при отправке ЗКП",СтатусСообщения.Внимание);
	КонецЕсли;
	
	Сообщить("Время выполнения "+(ТекущаяДата()-ВремяНачала)+" сек.");	
	Если НЕ ЗначениеЗаполнено(Объект.CaseStatus) Тогда
		Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ЗапросОтправлен;
	Иначе
		ОбновитьСтатусЗапросаНаСервере()
		//			ОбновитьЗначениеСтатусаЗапроса(ОтветСервера);
	КонецЕсли;
	Записать();
		
КонецПроцедуры

