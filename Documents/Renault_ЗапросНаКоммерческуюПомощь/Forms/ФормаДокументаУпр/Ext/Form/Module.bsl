&НаСервере
Процедура ЗаполнитьРеквизитыФормыПоУмолчанию()
	
	//BIRКод = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	Объект.Дата = ТекущаяДата();
	Объект.ТипКлиента = Перечисления.Renault_ТипыКлиентов.РозничныйКлиент;
