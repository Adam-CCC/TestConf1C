&НаКлиенте
Процедура VINПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Автомобиль) и ЗначениеЗаполнено(Объект.VIN) тогда
		Объект.Автомобиль = НайтиАвтомобильПоVINНаСервере(Объект.VIN);
		Если ЗначениеЗаполнено(Объект.Автомобиль) тогда
		 	ЗаполнитьЗначенияСвойств(Объект,ПолучитьДанныеПоАвтомобилюНаСервере(Объект.Автомобиль, Объект.Дата));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТелефонПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Объект.Контрагент) и ЗначениеЗаполнено(Объект.Телефон)  тогда
		Объект.Контрагент = НайтиКлиентаПоТелефонуНаСервере(Объект.Телефон);
		ПриИзмененииКонтрагента();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
функция ПроверкаВыполнениеПросрочено(Действие,ДатаПланируемая, ДатаВыполнения)
	
	Если ЗначениеЗаполнено(Действие.ДлительностьДействия) тогда
	
		ДатаОкончания = ДатаПланируемая + Час(Действие.ДлительностьДействия) * 60 * 60 + Минута(Действие.ДлительностьДействия) * 60 + Секунда(Действие.ДлительностьДействия);	
		
		Если ДатаОкончания < ДатаВыполнения тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;	
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиКлиентаПоТелефонуНаСервере(Телефон)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	 Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ОсновнойТелефон ПОДОБНО &Телефон";
	
	Запрос.УстановитьПараметр("Телефон", "%"+Прав(Телефон,6)+"%");  // поиск по последним 6 цифрам номера
	
	Выборка= Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	иначе 
		//поищем в регистре контактная информация 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Представление ПОДОБНО &Телефон
		|	И КонтактнаяИнформация.Тип = &Тип";
		
		Запрос.УстановитьПараметр("Телефон", "%"+Прав(Телефон,6)+"%");  // поиск по последним 6 цифрам номера
		Запрос.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.Телефон);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() тогда
			Возврат Выборка.Объект;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

