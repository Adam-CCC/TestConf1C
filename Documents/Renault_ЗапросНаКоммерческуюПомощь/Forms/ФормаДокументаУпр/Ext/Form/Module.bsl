&НаСервере
Функция ДоступноПраво(НазваниеПрава) Экспорт
	
	ПараметрОтбора = Новый Структура("ИмяПрава","ПолныеПрава");
	Если НаборПравПользователя.НайтиСтроки(ПараметрОтбора).Количество() > 0 тогда 
		Возврат Истина;
	Иначе
		ПараметрОтбора = Новый Структура("ИмяПрава",НазваниеПрава);
		Если НаборПравПользователя.НайтиСтроки(ПараметрОтбора).Количество() > 0 тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура НастройкаДоступностиФормы(Отказ)
	
	Если ДоступноПраво("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДоступноПраво("ПравоНаПросмотр")
		и НЕ ДоступноПраво("ПравоНаРедактирование")
		тогда
		Сообщить("Недостаточно прав для создания и просмотра обращения клиента!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ДоступноПраво("ПравоНаПросмотр")
		и НЕ ДоступноПраво("ПравоНаРедактирование")
		тогда
		Если Объект.Ссылка.Пустая() тогда
			Сообщить("Недостаточно прав для создания обращения клиента");
 		 	Отказ = Истина;
			Возврат;
		иначе
			ЭтаФорма.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЭтаФорма.ТолькоПросмотр Тогда
	   Если Объект.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.Закрыто и НЕ ДоступноПраво("ПравоНаЗакрытие") тогда
			ЭтаФорма.ТолькоПросмотр = Истина;
			Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = Ложь;
		КонецЕсли;   
	КонецЕсли;
	
	Элементы.ФормаОтправитьЗапрос.Доступность = ДоступноПраво("ПравоНаСогласование");
	
	//Если Не ЭтаФорма.ТолькоПросмотр Тогда
	//	Если Объект.ТипОбращения = Справочники.DMS_ТипыОбращений.Гарантия тогда
	//		ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ТипОбращенияГарантия");
	//	ИначеЕсли Объект.ТипОбращения = Справочники.DMS_ТипыОбращений.Сервис тогда
	//		ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ТипОбращенияСервис");
	//	ИначеЕсли Объект.ТипОбращения = Справочники.DMS_ТипыОбращений.Продажа тогда
	//		ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ТипОбращенияПродажа");
	//	КонецЕсли;
	//КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаборПравПользователя()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_ПраваИНастройкиПользователейОбращенияКлиентов.Право,
		|	DMS_ПраваИНастройкиПользователейОбращенияКлиентов.Право.Код КАК ИмяПрава
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК DMS_ПользователиИШаблоныПравИНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПраваИНастройкиПользователей.ОбращенияКлиентов КАК DMS_ПраваИНастройкиПользователейОбращенияКлиентов
		|		ПО DMS_ПользователиИШаблоныПравИНастроек.ПраваИНастройки = DMS_ПраваИНастройкиПользователейОбращенияКлиентов.Ссылка
		|			И (DMS_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь)
		|			И (DMS_ПраваИНастройкиПользователейОбращенияКлиентов.Доступность = ИСТИНА)
		|ГДЕ
		|	DMS_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Справочники.Пользователи.НайтиПоКоду(ПользователиИнформационнойБазы.ТекущийПользователь().Имя));
	
	НаборПравПользователя.Загрузить(Запрос.Выполнить().Выгрузить());
	Для Каждого стр из НаборПравПользователя цикл
		Стр.ИмяПрава = Справочники.DMS_ПраваРолейПоОбращениям.ПолучитьИмяПредопределенного(Стр.Право);
	КонецЦикла;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ВернутьСписокКлиентовКонтрагента(Контрагент)
	
	СписокКлиентов = Новый СписокЗначений;
	СписокКлиентов.Добавить(Контрагент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Renault_ПрофилиКлиентовКлиенты1.Клиент КАК Контрагент
		|ИЗ
		|	Справочник.Renault_ПрофилиКлиентов.Клиенты КАК Renault_ПрофилиКлиентовКлиенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПрофилиКлиентов.Клиенты КАК Renault_ПрофилиКлиентовКлиенты1
		|		ПО Renault_ПрофилиКлиентовКлиенты.Ссылка = Renault_ПрофилиКлиентовКлиенты1.Ссылка
		|ГДЕ
		|	Renault_ПрофилиКлиентовКлиенты.Клиент = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокКлиентов.Добавить(Выборка.Контрагент);
	КонецЦикла;
	
Возврат СписокКлиентов;	
	
КонецФункции

&НаКлиенте
Процедура АвтомобильНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Клиент", Объект.Контрагент);
	ОткрытьФорму("Документ.DMS_ОбращениеКлиента.Форма.ФормаВыбораАвтомобиля", ПараметрыОткрытия);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВернутьКоличествоАвтомобилейКонтрагента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль
	               |ИЗ
	               |	РегистрСведений.Автомобили.СрезПоследних(, ) КАК АвтомобилиСрезПоследних
	               |ГДЕ
	               |	АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения
	               |	И АвтомобилиСрезПоследних.Значение В(&СписокКлиентов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	АвтомобилиСрезПоследних.Период УБЫВ";
				   
				   
	Запрос.УстановитьПараметр("СписокКлиентов", ВернутьСписокКлиентовКонтрагента(Контрагент));
	Запрос.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
	
	
	Количество = Запрос.Выполнить().Выгрузить().Количество();
	Возврат Количество;
	

КонецФункции

