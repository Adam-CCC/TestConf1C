&НаКлиенте
Перем РезультатПолученияДопИнформации;
&НаКлиенте
Перем ФормаДлительнойОперации;
&НаКлиенте
Перем ПараметрыОбработчика;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьНаборПравПользователя();   
	НастройкаДоступностиФормы(Отказ);

	//Начальное заполнение
	Если Объект.Ссылка.Пустая() тогда
		ЗаполнитьРеквизитыФормыПоУмолчанию();
	иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_CRM_ЗаявкаНаСервис.ЗаказНаряд,
		|	Renault_CRM_ЗаявкаНаСервис.Ссылка
		|ИЗ
		|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.DMS_ОбращениеКлиента КАК DMS_ОбращениеКлиента
		|			ПО Renault_CRM_ОбращениеВАвтоСервис.ЖалобаКлиента = DMS_ОбращениеКлиента.Ссылка
		|		ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка
		|ГДЕ
		|	DMS_ОбращениеКлиента.ЗКП = &ЗКП";
		Запрос.УстановитьПараметр("ЗКП", Объект.Ссылка);
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Если ЗначениеЗаполнено(Выборка.ЗаказНаряд) Тогда
				ТекущийЗаказНаряд = Выборка.ЗаказНаряд;
			Иначе
				ТекущийЗаказНаряд = ВЫборка.ССылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СписокЗаказНарядов.Параметры.УстановитьЗначениеПараметра("Автомобиль", Объект.Автомобиль);
	ЗаполнитьКонтактнуюИнформациюНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКартинкиИФайлы(Команда)
	
	Если Объект.Ссылка.Пустая() тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Текст = "Для продолжения ввода необходимо записать документ, 
		|Записать?";
		Ответ = Вопрос(Текст, Режим, 0);
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		Иначе
			ЭтаФорма.Записать();
		КонецЕсли;
	КонецЕсли;
	
	ПриложитьФайлКДокументу();

КонецПроцедуры

&НаКлиенте
Процедура ПриложитьФайлКДокументу()
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		 ВыполнитьЗаписьДокумента();
	КонецЕсли;
	Отбор = Новый Структура();
	Отбор.Вставить("Объект", Объект.Ссылка);
	//Отбор.Вставить("Идентификатор", "");
	ФормаКартинок=РегистрыСведений.Renault_КартинкиИФайлы.ПолучитьФормуСписка(,ЭтаФорма);
	ФормаКартинок.ПараметрОтборПоИзмерению=Отбор;
	ФормаКартинок.Открыть();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗаписьДокумента()
	 ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	 ТекущийОбъект.Записать(РежимЗаписиДокумента.Запись);
	 ЗначениеВреквизитФормы(ТекущийОбъект,"Объект");
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте()
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = Renault_ДлительныеОперации.ЗаданиеВыполнено(РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);

	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор Тогда
				Renault_ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОбработатьРезультатВыполненияЗадания();
		Иначе
		Renault_ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыполненияЗадания()
	сОтвет = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);
	Объект.ТранспортнаяКомпания = сОтвет.Контрагент;
	Объект.ДоговорПеревозчика = сОтвет.Договор;
	Элементы.ГруппаПеревозчики.ТекущаяСтраница = Элементы.ГруппаВводаПеревозчика;
КонецПроцедуры


