&НаСервереБезКонтекста
Функция ПолучитьПрофильКлиента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	DMS_ПрофилиКлиентовКлиенты.Ссылка
		|ИЗ
		|	Справочник.DMS_ПрофилиКлиентов.Клиенты КАК DMS_ПрофилиКлиентовКлиенты
		|ГДЕ
		|	DMS_ПрофилиКлиентовКлиенты.Клиент = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		НовыйПрофиль = Справочники.DMS_ПрофилиКлиентов.СоздатьЭлемент();
		Клиент = НовыйПрофиль.Клиенты.Добавить();
		Клиент.Клиент = Контрагент;
		НовыйПрофиль.Записать();
		Возврат	НовыйПрофиль.Ссылка;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПрофильКлиента(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОткрытьЗначение(ПолучитьПрофильКлиента(Объект.Контрагент));
 	
КонецПроцедуры

