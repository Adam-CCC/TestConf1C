//Бондаренко++ 20250426
Функция СМГ_ПередЗаписью()
	
	ФлОтказ = Ложь;
	
	Для каждого ТекСтрока Из Автомобили Цикл
		
		Если ТекСтрока.КоличествоРазница = 0 И ТекСтрока.СуммаВсегоРазница = 0 Тогда
			Продолжить;
		КонецЕсли;
		
 		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиАвтомобилейОстаткиТекСклада.Автомобиль,
		|	ОстаткиАвтомобилейОстаткиТекСклада.КоличествоОстаток КАК ОстатокНаТекущем,
		|	0 КАК ОстатокНаДругих
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(
		|			&Период,
		|			СкладКомпании = &Склад
		|				И Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстаткиТекСклада
		|ГДЕ
		|	ОстаткиАвтомобилейОстаткиТекСклада.КоличествоОстаток = 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиАвтомобилейОстаткиДругихСкладов.Автомобиль,
		|	0,
		|	ОстаткиАвтомобилейОстаткиДругихСкладов.КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(
		|			&Период,
		|			СкладКомпании <> &Склад
		|				И Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстаткиДругихСкладов
		|ГДЕ
		|	ОстаткиАвтомобилейОстаткиДругихСкладов.КоличествоОстаток = 1";
		
		Запрос.УстановитьПараметр("Склад", СкладКомпании);
		Запрос.УстановитьПараметр("Автомобиль", ТекСтрока.Автомобиль);
		Запрос.УстановитьПараметр("Период", Дата);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Если ТЗ.Количество() = 1 Тогда
			Если ТЗ[0].ОстатокНаТекущем = 0 Тогда
				СМГ_Сообщить("ОШИБКА! "+ТекСтрока.Автомобиль+" отсутствует на складе """+СкладКомпании+""".",СтатусСообщения.ОченьВажное);
				ФлОтказ = Истина;
				Возврат ФлОтказ;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ФлОтказ;
 	
КонецФункции //
