	// Возможно расхождение баланса на "копейки" из-за округления. Возникшую разницу
	// необходимо списать на доходы и расходы.
	Отказ = НЕ дкСписаниеКопейкиПриОкругленииВалютныхСчетов(ЭтотОбъект) ИЛИ Отказ; 
	
	//Бондаренко++ 20260326
	Движения.БонусныеБаллыДилера.Очистить();
	Если Дата >= ДеньЭрЭл Тогда
		Если РабочиеЛисты.Количество() > 0 Тогда
			Для каждого ТекСтрокаРабочиеЛисты Из РабочиеЛисты Цикл
 				Для Счетчик_ = 1 По 2 Цикл
					
					Движение = Движения.БонусныеБаллыДилера.Добавить();
					
					Если Счетчик_ = 1 Тогда
						Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
						Движение.ВариантОстатков = Перечисления.НачисленоПодтверждено.Начислено;
					Иначе
						Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
						Движение.ВариантОстатков = Перечисления.НачисленоПодтверждено.Подтверждено;
					КонецЕсли;
 					 
					Движение.Период = Дата; 
					Движение.ПодразделениеКомпании = ТекСтрокаРабочиеЛисты.РабочийЛист.ПодразделениеКомпании;
					Движение.Организация = ТекСтрокаРабочиеЛисты.РабочийЛист.Организация;
					Движение.Автомобиль = ТекСтрокаРабочиеЛисты.РабочийЛист.Автомобиль;
					Движение.Марка = ТекСтрокаРабочиеЛисты.РабочийЛист.Автомобиль.Модель.Марка;
					Движение.Модель = ТекСтрокаРабочиеЛисты.РабочийЛист.Автомобиль.Модель;
					Движение.МаркетинговаяПрограмма = ТекСтрокаРабочиеЛисты.МаркетинговаяПрограмма;
					Движение.ДатаСписанияБонусов = Дата;
					
					//Бондаренко++ 20260311
					Движение.Компенсация = ТекСтрокаРабочиеЛисты.СуммаПоАкту;
					Если ТекСтрокаРабочиеЛисты.ВариантКомпенсации = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего Тогда
						Движение.ВариантКомпенсации = Перечисления.ВариантКомпенсации.ВИнвойсеСледующего;
					ИначеЕсли ТекСтрокаРабочиеЛисты.ВариантКомпенсации = Перечисления.ВариантКомпенсации.Ретроспективная Тогда	
						Движение.ВариантКомпенсации = Перечисления.ВариантКомпенсации.Ретроспективная;
					Иначе
						Движение.ВариантКомпенсации = Перечисления.ВариантКомпенсации.ПустаяСсылка();
					КонецЕсли;
					//Бондаренко-- 20260311
					
					Движение.ХозОперация = Справочники.ХозОперации.БонусныеБаллыДилераРасход;
					Если НЕ обЗначениеНеЗаполнено(ТекСтрокаРабочиеЛисты.РабочийЛист.РеализацияАвтомобиля) Тогда
						Движение.ФактическаяЦенаПродажиАвто = ТекСтрокаРабочиеЛисты.РабочийЛист.РеализацияАвтомобиля.Автомобили[0].СуммаВсего;
						Движение.КонтрагентПокупатель = ТекСтрокаРабочиеЛисты.РабочийЛист.РеализацияАвтомобиля.Контрагент;
						Движение.ДатаПродажи = ТекСтрокаРабочиеЛисты.РабочийЛист.РеализацияАвтомобиля.Дата;
						//Бондаренко++ 20260331
						Движение.ДокументРеализации = ТекСтрокаРабочиеЛисты.РабочийЛист.ОтгрузкаАвтомобиля;
						//Бондаренко-- 20260331
					КонецЕсли;
					Движение.ДатаРитейла = "";
					Движение.ДатаПодтверждения = "";
					Движение.ДатаПолучения = "";
					
					//Бондаренко++ 20260401
					Движение.РабочийЛист = ТекСтрокаРабочиеЛисты.РабочийЛист.Ссылка;
					//Бондаренко-- 20260401
					
				КонецЦикла;
 			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	//Бондаренко-- 20260326
	
	// выведем сообщения об ошибках и предупреждениях
	дкВыводРезультатовОбработки(ЭтотОбъект,Отказ);
	
КонецПроцедуры // ОбработкаПроведения

//Бондаренко++ 20220930
Процедура СМГ_ПриЗаписи()
 	СМГ_СоздатьИлиОбновитьСФПолученный();
 КонецПроцедуры  //СМГ_ПриЗаписи()
	
Процедура СМГ_СоздатьИлиОбновитьСФПолученный()
	
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
 	КонецЕсли;
 	
	СФ_полученный = Неопределено; 
	
	Если ЭтотОбъект.Автомобили.Итог("СуммаНДС") > 0 Тогда
		СФ_полученный = Документы.СчетФактураПолученный.СоздатьДокумент(); 
		СФ_полученный.Комментарий = "Документ был автоматически создан "+СокрЛП(ТекущаяДата());
 	КонецЕсли;
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураПолученный.Ссылка КАК СФ,
	|	СчетФактураПолученный.ДокументОснование,
	|	СчетФактураПолученный.Проведен
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ЭтотОбъект.Ссылка);
     	
	Результат = Запрос.Выполнить();		
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СФ_полученный = ВыборкаДетальныеЗаписи.СФ.ПолучитьОбъект(); 
		Прервать;
	КонецЦикла; 
	
	Если СФ_полученный = Неопределено Тогда
		// Так как "Автомобили.Итог("СуммаНДС") равна нулю и старый счет-фактура полученный не найден
		Возврат;
 	КонецЕсли;
	 
	СФ_полученный.Заполнить(ЭтотОбъект.Ссылка);
 	СФ_полученный.Дата = ЭтотОбъект.Дата; 
	СФ_полученный.Комментарий = "Документ был автоматически обновлен "+СокрЛП(ТекущаяДата());
  	
	ФлЭтотОбъектПроведен = ЭтотОбъект.Проведен;
	ФлЭтотОбъектПометкаУдаления = ЭтотОбъект.ПометкаУдаления;
	
	СФ_полученный.Проведен = ФлЭтотОбъектПроведен;			
	СФ_полученный.ПометкаУдаления = ФлЭтотОбъектПометкаУдаления;
	
	Если ФлЭтотОбъектПометкаУдаления Тогда               
		Попытка СФ_полученный.Записать(РежимЗаписиДокумента.Запись); Исключение КонецПопытки; 
	Иначе                                                           
		Если ФлЭтотОбъектПроведен Тогда
			Попытка СФ_полученный.Записать(РежимЗаписиДокумента.Проведение); Исключение КонецПопытки; 					
		Иначе
			Попытка СФ_полученный.Записать(РежимЗаписиДокумента.ОтменаПроведения); Исключение КонецПопытки; 					
		КонецЕсли; 
	КонецЕсли;
 	
КонецПроцедуры //СМГ_СоздатьИлиОбновитьСФПолученный()
