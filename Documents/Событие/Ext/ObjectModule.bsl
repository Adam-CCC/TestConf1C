		НаборЗаписей.Отбор.Сотрудник.Установить(РегистрацияЗвонковИКонтактов.Сотрудник);
		НаборЗаписей.Прочитать();
		//Бондаренко++ 20190716
		Если НаборЗаписей.Количество()>0 Тогда
		//Бондаренко-- 20190716	
			НаборЗаписей[0].ДокументСобытие = Ссылка;
			НаборЗаписей.Записать();
		//Бондаренко++ 20190716	
		КонецЕсли; 
	    //Бондаренко-- 20190716
 	КонецЕсли;
	
	#Если Клиент Тогда
		Оповестить("ДокументСобытиеПриЗаписи", ЭтотОбъект,);
	#КонецЕсли
	
	///////// Эта проверка должна быть последней!
	// Семенихин 24.05.2021 +++++
	Если Не Отказ Тогда
		СМГ_ПриЗаписи(Отказ);
	КонецЕсли;	
	// Семенихин 24.05.2021 -----
КонецПроцедуры // ПриЗаписи()

