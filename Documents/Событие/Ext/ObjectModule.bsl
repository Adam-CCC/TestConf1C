			Данные = НовоеСобытие.ЗаполнитьНапоминаниеиСоздатьНопоминание(НовоеСобытие.ДатаНачала,Пользователи[0].Пользователь);
			НовоеСобытие.АвтоВыборОповещения(НовоеСобытие.Ссылка, Данные);
			
			ТиповаяАнкета = Неопределено;
			ПринадлежностьОпроса = Перечисления.ПринадлежностьОпроса.ОП;
			СрокЗвонкаВежливостиДляНапоминания = "";
			
			Если ПериодСобытия = 86400 Тогда			// 1 день
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета1День;
				СрокЗвонкаВежливостиДляНапоминания = "1 день";
			ИначеЕсли ПериодСобытия = 259200 Тогда		// 1 месяц
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета3Дня;
			ИначеЕсли ПериодСобытия = 2592000 Тогда		// 1 месяц
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета1Месяц;
				СрокЗвонкаВежливостиДляНапоминания = "1 месяц";
			ИначеЕсли ПериодСобытия = 7776000 Тогда		// 3 месяца
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета3Месяца;
				СрокЗвонкаВежливостиДляНапоминания = "3 месяца";
			ИначеЕсли ПериодСобытия = 15552000 Тогда	// 6 месяцев
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета6Месяцев;
				СрокЗвонкаВежливостиДляНапоминания = "6 месяцев";
			ИначеЕсли ПериодСобытия = 23328000 Тогда	// 9 месяцев
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета9Месяцев;
				СрокЗвонкаВежливостиДляНапоминания = "9 месяцев";
			ИначеЕсли ПериодСобытия = 31536000 Тогда	// 1 год
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета1Год;
				СрокЗвонкаВежливостиДляНапоминания = "1 год";
			ИначеЕсли ПериодСобытия = 38880000 Тогда	// 15 месяцев
				ТиповаяАнкета = НастройкиЗвонковВежливости.Анкета15Месяцев;
				СрокЗвонкаВежливостиДляНапоминания = "15 месяцев";
