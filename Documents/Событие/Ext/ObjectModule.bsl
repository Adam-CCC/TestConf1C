Процедура ИзменитьСтатусРабочегоЛиста()
	Если обЗначениеНеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	Если  Не (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РабочийЛист") 
		Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РабочийЛистСервиса")) Тогда
		Возврат;
	КонецЕсли;
	Если ДокументОснование.Статус <> Справочники.СтатусыРабочегоЛиста.Создан Тогда
		Возврат;
	КонецЕсли;
	Если ТипСообщения = Перечисления.ТипыСообщений.Исходящее И Состояние = Перечисления.СостоянияСобытий.Запланировано Тогда
		Возврат;
	КонецЕсли;
	
	РабочийЛистОбъект = ДокументОснование.ПолучитьОбъект();
	РабочийЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.Интерес;
	РабочийЛистОбъект.ОбменДанными.Загрузка = Истина;
	РабочийЛистОбъект.Записать();
КонецПроцедуры

Процедура ЗаменитьМенеджераРабочегоЛиста()
	Если Не ЗаписанНовыйДокумент Тогда
		Возврат;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ДокументОснование) Или ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.РабочийЛист") Тогда
		Возврат;
	КонецЕсли;
	
	ПродавецПользователь = Справочники.Пользователи.НайтиПоРеквизиту("Сотрудник", Продавец);
	Если обЗначениеНеЗаполнено(ПродавецПользователь) Тогда
		Возврат;
	КонецЕсли;
	
	ПользовательИБ = СМ_ПривилегированныйРежим.ПолучитьПользователяИБ(ПродавецПользователь);
	Если обЗначениеНеЗаполнено(ПользовательИБ) Тогда
		Возврат;
	КонецЕсли;	
	ПодходящийПользователь = ПользовательИБ.Роли.Содержит(Метаданные.Роли.СМ_МенеджерОтделаПродаж) 
		И Не ПользовательИБ.Роли.Содержит(Метаданные.Роли.СМ_РуководительОтделаПродаж) 
		И Не ПользовательИБ.Роли.Содержит(Метаданные.Роли.СМ_CallCenter);
	
	Если ПодходящийПользователь И ВидСобытия <> Перечисления.ВидыСобытий.ЗвонокВежливости Тогда		
		РабочийЛистОбъект = ДокументОснование.ПолучитьОбъект();
		Если РабочийЛистОбъект.Менеджер <> Продавец Тогда
			РабочийЛистОбъект.Менеджер = Продавец;
			Попытка
				РабочийЛистОбъект.ОбменДанными.Загрузка = Истина;
				РабочийЛистОбъект.Записать();
			Исключение
				Сообщить("Ошибка замены менеджера в " + Строка(РабочийЛистОбъект) + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Процедура ОтменитьЗапланированныеСобытия()
	Если ВидСобытия <> Перечисления.ВидыСобытий.ВыдачаАвтомобиля И ВидСобытия <> Перечисления.ВидыСобытий.ОтказОтАвтомобиля Тогда
		Возврат;
	ИначеЕсли Состояние <> Перечисления.СостоянияСобытий.Завершено Тогда
		Возврат;
	ИначеЕсли ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.РабочийЛист") Тогда
		Возврат;
	КонецЕсли;	
	
	СписокВидов = Новый Массив();
	СписокВидов.Добавить(Перечисления.ВидыСобытий.ЛичнаяВстреча);
	СписокВидов.Добавить(Перечисления.ВидыСобытий.ТелефонныйЗвонок);
	СписокВидов.Добавить(Перечисления.ВидыСобытий.ТестДрайв);
	Если ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля Тогда
		СписокВидов.Добавить(Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
	КонецЕсли;
	
	ЗапросЗапланированные = Новый Запрос();
	ЗапросЗапланированные.УстановитьПараметр("РабочийЛист", ДокументОснование);
	ЗапросЗапланированные.УстановитьПараметр("СписокВидов", СписокВидов);
	ЗапросЗапланированные.УстановитьПараметр("Запланировано", Перечисления.СостоянияСобытий.Запланировано);
	ЗапросЗапланированные.Текст =
	"ВЫБРАТЬ
	|	Событие.Ссылка
	|ИЗ
	|	Документ.Событие КАК Событие
	|ГДЕ
	|	Событие.ДокументОснование = &РабочийЛист
	|	И Событие.ВидСобытия В(&СписокВидов)
	|	И Событие.Состояние = &Запланировано
	|	И Событие.ПометкаУдаления = ЛОЖЬ";
	
	ВыборкаЗапланированные = ЗапросЗапланированные.Выполнить().Выбрать();
	Пока ВыборкаЗапланированные.Следующий() Цикл
		СобытиеОбъект = ВыборкаЗапланированные.Ссылка.ПолучитьОбъект();
		СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Отменено;
		
		Если ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля Тогда
			СобытиеОбъект.Результат = "Выдан автомобиль " + Строка(Автомобиль);
			Если СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча Тогда
				СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Завершено;
			КонецЕсли;
			
		Иначе
			СобытиеОбъект.Результат = "Зарегистрирован отказ от автомобиля.";
		КонецЕсли;
		
 		//Бондаренко++ 20230812
		Если СобытиеОбъект.Организация <> СобытиеОбъект.ПодразделениеКомпании.Организация Тогда
 			Попытка СобытиеОбъект.Организация = СобытиеОбъект.ПодразделениеКомпании.Организация; Исключение КонецПопытки; 
 	   	КонецЕсли;             
		//Бондаренко-- 20230812
		
		Попытка
			СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Ошибка при отмене запланированного " + Строка(СобытиеОбъект) + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
			Продолжить;
		КонецПопытки;		
	КонецЦикла;
КонецПроцедуры

Процедура СМГ_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//Бондаренко++ 20230801
	Если ЭтоНовый() Тогда
	    СМ_ДатаСоздания=ТекущаяДата();
 	КонецЕсли; 
 	//Бондаренко-- 20230801
 	
	// Семенихин 24.05.2021 +++++
	ЗаписанНовыйДокумент = ЭтоНовый();
	ЭтоСобытиеОП = ЗначениеЗаполнено(ДокументОснование) И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РабочийЛист");
	
	Если ЗаписанНовыйДокумент Тогда
		Если Пользователи.Количество() > 0 Тогда
			НайденнаяСтрока = Пользователи.Найти(Автор, "Пользователь");
			Если НайденнаяСтрока = Неопределено Тогда
				НоваяСтрока = Пользователи.Добавить();
				НоваяСтрока.Пользователь = Автор;
			КонецЕсли;		
		Иначе
			НоваяСтрока = Пользователи.Добавить();
			НоваяСтрока.Пользователь = Автор;
		КонецЕсли;
		
		Если ЭтоСобытиеОП И ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля Тогда			
			ЗапросВыдачи = Новый Запрос();
			ЗапросВыдачи.УстановитьПараметр("РабочийЛист", ДокументОснование);
			ЗапросВыдачи.Текст =
			"ВЫБРАТЬ
			|	Событие.Ссылка
			|ИЗ
			|	Документ.Событие КАК Событие
			|ГДЕ
			|	Событие.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыСобытий.ВыдачаАвтомобиля)
			|	И Событие.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Отменено)
			|	И Событие.ДокументОснование = &РабочийЛист
			|	И НЕ Событие.ПометкаУдаления";
			
			РезультатВыдачи = ЗапросВыдачи.Выполнить();
			Если Не РезультатВыдачи.Пустой() Тогда
				Сообщить("По документу " + Строка(ДокументОснование) + " уже есть выдача автомобиля!!!", СтатусСообщения.ОченьВажное);
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоСобытиеОП И ДатаНачала > ДобавитьМесяц(ТекущаяДата(), 1) И Не РольДоступна("ПолныеПрава") Тогда
			#Если Клиент Тогда
			Сообщить("Период планирования события не может превышать 1 месяц!", СтатусСообщения.Внимание);
			#КонецЕсли
			Отказ = Истина;
		КонецЕсли;
			
		// Семенихин 11.06.2023 +++++
		Если Состояние = Перечисления.СостоянияСобытий.Завершено Или Состояние = Перечисления.СостоянияСобытий.Отменено Тогда
			Если ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля Тогда
				ДатаФактическогоЗавершения = ТекущаяДата() + 180;
			Иначе
				ДатаФактическогоЗавершения = ТекущаяДата();
			КонецЕсли;
		КонецЕсли;
		// Семенихин 02.10.2025 -----
		
	ИначеЕсли Состояние <> Ссылка.Состояние Тогда
		Если (ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча Или ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок
			И ТипСообщения = Перечисления.ТипыСообщений.Исходящее) Тогда
			//Бондаренко++ 20230404
			Если НЕ РольДоступна("ПолныеПрава") Тогда
				//Бондаренко 20230404
				ДатаНачала = ТекущаяДата();
				ДатаОкончания = ДатаНачала + 600;
				//Бондаренко++ 20230404	
			КонецЕсли;
		КонецЕсли;
		//Бондаренко 20230404
			
		// Семенихин 08.06.2023 +++++
		Если Состояние = Перечисления.СостоянияСобытий.Завершено Тогда
			ДатаФактическогоЗавершения = ТекущаяДата();
		КонецЕсли;
		// Семенихин 08.06.2023 -----
	КонецЕсли;
	
	Если обЗначениеНеЗаполнено(Результат) И Состояние = Перечисления.СостоянияСобытий.Завершено И ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля Тогда
		Результат = "Автомобиль выдан.";
	КонецЕсли;	
	
	Если ЭтоСобытиеОП И Состояние = Перечисления.СостоянияСобытий.Отменено Тогда		
		ЗапросСобытия = Новый Запрос();
		ЗапросСобытия.УстановитьПараметр("РабочийЛист", ДокументОснование);
		ЗапросСобытия.УстановитьПараметр("ЭтоСобытие", Ссылка);
		ЗапросСобытия.УстановитьПараметр("Выдача", Перечисления.ВидыСобытий.ВыдачаАвтомобиля);
		ЗапросСобытия.Текст =
		"ВЫБРАТЬ
		|	Событие.Ссылка
		|ИЗ
		|	Документ.Событие КАК Событие
		|ГДЕ
		|	Событие.ДокументОснование = &РабочийЛист
		|	И Событие.Ссылка <> &ЭтоСобытие
		|	И Событие.ВидСобытия <> &Выдача";
		
		РезультатЗапроса = ЗапросСобытия.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			//Бондаренко++ 20230404
			Если НЕ РольДоступна("ПолныеПрава")  Тогда
				//Бондаренко 20230404
				Сообщить("ВНИМАНИЕ! Запрещено отменять единственное событие в рабочем листе!", СтатусСообщения.Важное);
				Отказ = Истина;
				Возврат;           
				//Бондаренко++ 20230404	
			КонецЕсли;             
			//Бондаренко 20230404
		КонецЕсли;
	КонецЕсли;
	// Семенихин 22.08.2024 -----
	
	// Семенихин 22.10.2024 закомментировал для возможности работы МОП с разными брендами
	////Бондаренко++ 20201119
	//Если Не обЗначениеНеЗаполнено(Продавец) И ЭтоОбычныйМОП Тогда
	//	Если Продавец.Подразделение <> ПодразделениеКомпании Тогда
	//		Попытка ПодразделениеКомпании = Продавец.Подразделение; Исключение КонецПопытки;  
	//		Попытка Организация = Продавец.Подразделение.Организация; Исключение КонецПопытки;  
	//		Попытка УстановитьНовыйНомер(); Исключение	 КонецПопытки; 
	//	КонецЕсли; 
	//КонецЕсли; 
	////Бондаренко-- 20201119
	
	// Попытка заполнения времени планируемой выдачи автомобияя на основании даты
	ПланируемоеВремяВыдачиАвтомобиля	= Дата(1,1,1,0,0,0);
	Если ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля И ЗначениеЗаполнено(ПланируемаяДатаВыдачиАвтомобиля) Тогда
		ПланГод		= Год(ПланируемаяДатаВыдачиАвтомобиля);
		ПланМесяц	= Месяц(ПланируемаяДатаВыдачиАвтомобиля);
		ПланДень	= День(ПланируемаяДатаВыдачиАвтомобиля);
		ПланЧас		= Час(ПланируемаяДатаВыдачиАвтомобиля);
		ПланМинута	= Минута(ПланируемаяДатаВыдачиАвтомобиля);
		ПланСекунда	= Секунда(ПланируемаяДатаВыдачиАвтомобиля);
		ПланируемоеВремяВыдачиАвтомобиля= Дата(1, 1, 1, ПланЧас, ПланМинута, ПланСекунда);
	КонецЕсли;                   
	
	//Бондаренко++ 20211007
	Если ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча Тогда
		Если ТипСообщения <> Перечисления.ТипыСообщений.Входящее Тогда
			ТипСообщения = Перечисления.ТипыСообщений.Входящее; 					
		КонецЕсли;
 	КонецЕсли;
 	//Бондаренко++ 20211007
 	
	// + КМ
	Если Состояние = Перечисления.СостоянияСобытий.Завершено И ЗначениеЗаполнено(ФорматТекста) И Не ПометкаУдаления Тогда	
		СодержаниеТекст = Содержание;
		РезультатТекст = Результат;
		
		Если ФорматТекста = Перечисления.ФорматТекста.HTML Тогда
			СодержаниеТекст = обПолучитьТекст(Содержание);
			РезультатТекст = обПолучитьТекст(Результат);
		КонецЕсли;
		
		Если Лев(СодержаниеТекст, 17) = "Звонок вежливости" Или ВидСобытия = Перечисления.ВидыСобытий.ЗвонокВежливости Тогда
			
			Если ЗначениеЗаполнено(Опрос) И Не Опрос.ОпросЗавершен и Константы.ДилерскийЦентр.Получить() <> Справочники.ДилерскиеЦентры.Дельта Тогда
				Сообщить("Не завершен опрос!", СтатусСообщения.БезСтатуса);
				Отказ = Истина;
			КонецЕсли;
			
			Если ПустаяСтрока(РезультатТекст) Тогда
				Сообщить("Реквизит <Результат> не заполнен !", СтатусСообщения.БезСтатуса);
				Отказ = Истина;					
			КонецЕсли;
			
			Если Отказ Тогда				
				Сообщить("При записи < " + СокрЛП(ЭтотОбъект) + " > обнаружены ошибки", СтатусСообщения.Внимание);
				Сообщить("Из-за возникших ошибок операция записи была отменена.", СтатусСообщения.Важное); 				
			КонецЕсли;		
		КонецЕсли;	
	КонецЕсли;
	// - КМ
	
	//Бондаренко++ 20221004 
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если обЗначениеНеЗаполнено(ЭтотОбъект.Модель) Тогда
			Если НЕ обЗначениеНеЗаполнено(ЭтотОбъект.ДокументОснование) Тогда 
				Если ТипЗНЧ(ЭтотОбъект.ДокументОснование)=Тип("ДокументСсылка.РабочийЛист") ИЛИ ТипЗНЧ(ЭтотОбъект.ДокументОснование)=Тип("ДокументСсылка.РабочийЛистСервиса") Тогда
 					Если НЕ обЗначениеНеЗаполнено(ЭтотОбъект.ДокументОснование.Модель) Тогда			
						Попытка ЭтотОбъект.Модель = ЭтотОбъект.ДокументОснование.Модель; Исключение КонецПопытки;  
					КонецЕсли; 	
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	//Бондаренко-- 20221004
 	
КонецПроцедуры

Процедура СМГ_ПриЗаписи(Отказ)
	// При записи Выдачи автомобиля
	Если ВидСобытия = Перечисления.ВидыСобытий.ВыдачаАвтомобиля И Состояние = Перечисления.СостоянияСобытий.Завершено Тогда		
		Если ДокументОснование.Статус <> Справочники.СтатусыРабочегоЛиста.Продажа Тогда 
			РабочийЛистОбъект = ДокументОснование.ПолучитьОбъект();
			РабочийЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.Продажа;
			РабочийЛистОбъект.Автомобиль = Автомобиль;
			РабочийЛистОбъект.ОбработкаРеквизита("Автомобиль");
			РабочийЛистОбъект.МашинаВыдана = Истина;
			Попытка
				РабочийЛистОбъект.ОбменДанными.Загрузка = Истина;
				РабочийЛистОбъект.Записать();
			Исключение
				Сообщить("Не удалось установить статус Продажа для " + Строка(ДокументОснование) + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
				Отказ = Истина;
				Возврат;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// При записи Отказа от автомобиля
	Если ВидСобытия = Перечисления.ВидыСобытий.ОтказОтАвтомобиля И Состояние = Перечисления.СостоянияСобытий.Завершено Тогда		
		Если ДокументОснование.Статус <> Справочники.СтатусыРабочегоЛиста.Отказ Тогда
			ИзменитьТекущийСтатус = Истина;
			Если ДокументОснование.Статус = Справочники.СтатусыРабочегоЛиста.Продажа Тогда
				мПодчиненные = КритерииОтбора.ПодчиненныеДокументы.Найти(ДокументОснование);
				ПродажаСсылка = Документы.РеализацияАвтомобилей.ПустаяСсылка();
				Для Каждого ПодчиненныйРабЛиста Из мПодчиненные Цикл
					Если ТипЗнч(ПодчиненныйРабЛиста) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
						мПодчиненныеЗаказа = КритерииОтбора.ПодчиненныеДокументы.Найти(ПодчиненныйРабЛиста);
						Для Каждого ПодчиненныйЗаказа Из мПодчиненныеЗаказа Цикл
							Если ТипЗнч(ПодчиненныйЗаказа) = Тип("ДокументСсылка.РеализацияАвтомобилей") Тогда
								ПродажаСсылка = ПодчиненныйЗаказа;
								Прервать;

							ИначеЕсли ТипЗнч(ПодчиненныйЗаказа) = Тип("ДокументСсылка.ОтгрузкаАвтомобиляБезРеализации") Тогда
								ПродажаСсылка = ПодчиненныйЗаказа;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
						Если ЗначениеЗаполнено(ПродажаСсылка) Тогда
							ИзменитьТекущийСтатус = Ложь;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ИзменитьТекущийСтатус Тогда
				РабочийЛистОбъект = ДокументОснование.ПолучитьОбъект();
				РабочийЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.Отказ;
				РабочийЛистОбъект.ПричинаОтказа = ПричинаОтмены;
				Попытка
					РабочийЛистОбъект.ОбменДанными.Загрузка = Истина;
					РабочийЛистОбъект.Записать();
				Исключение
					Сообщить("Не удалось установить статус Отказ для " + Строка(ДокументОснование) + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
					Отказ = Истина;
					Возврат;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	ОтменитьЗапланированныеСобытия();
	Если ЭтоОбычныйМОП Тогда
		ЗаменитьМенеджераРабочегоЛиста();
	КонецЕсли;	
	ИзменитьСтатусРабочегоЛиста();
	СМ_ПроцедурыДляNissanAftersales.ОбновитьСтатусЛидаПоСобытию(Ссылка);
	Если Не Отказ Тогда
		РегистрыСведений.МаркетинговыеЛиды.ДобавитьЗапись(Ссылка);
	КонецЕсли;
КонецПроцедуры
