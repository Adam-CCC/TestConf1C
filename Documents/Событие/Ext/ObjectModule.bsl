// + КМ
Функция ПолучитьОпрос(Основание, ТиповаяАнкета, ДатаОпроса, ПринадлежностьОпроса = Неопределено, МенеджерОпроса) Экспорт 				
	ДокументОпрос = Документы.Опрос.СоздатьДокумент();
	ДокументОпрос.Заполнить(Основание);
	
	ДокументОпрос.ТиповаяАнкета = ТиповаяАнкета;
	
#Если НаКлиенте Тогда
	Попытка
		зфОпросОбновитьСписокВопросов(ДокументОпрос);
	Исключение		
	КонецПопытки;
#КонецЕсли
	
	ДокументОпрос.Дата = ДатаОпроса;
	ДокументОпрос.Менеджер = МенеджерОпроса;
	ДокументОпрос.СпособКонтакта = Перечисления.ВидыСобытий.ТелефонныйЗвонок;
	ДокументОпрос.ДокументОснование = Основание;
	ДокументОпрос.Принадлежность = ПринадлежностьОпроса;
	
	Если ЗначениеЗаполнено(ДокументОпрос.ОпрашиваемоеЛицо) И ТипЗнч(ДокументОпрос.ОпрашиваемоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		ДокументОпрос.Поле = ДокументОпрос.ОпрашиваемоеЛицо.ОсновнойТелефон;
	КонецЕсли;
			
	Попытка
		ДокументОпрос.Записать(РежимЗаписиДокумента.Запись);			
	Исключение
	КонецПопытки;
	
	Возврат ДокументОпрос.Ссылка;	
КонецФункции

Функция ПолучитьПользователяПоСотруднику(Сотрудник)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Пользователи.Ссылка
	               |ИЗ
	               |	Справочник.Пользователи КАК Пользователи
	               |ГДЕ
	               |	Пользователи.Сотрудник = &Сотрудник
	               |	И НЕ Пользователи.ПометкаУдаления";
				   
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции
