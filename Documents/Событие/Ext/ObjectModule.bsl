				НовоеНапоминание.СрокДоНачала			= 15;
				НовоеНапоминание.Тема					= "Звонок вежливости";
				НовоеНапоминание.ТипПериода				= "00";
				НовоеНапоминание.УдалитьПоИстеченииСрока= Истина;
				
				Попытка
					НовоеНапоминание.Записать(Ложь);
				Исключение КонецПопытки;
				
			КонецЕсли;
			
			// С первым звонком вежливости "1 день" формируем отдельный опрос для звонка "10 дней", но без события
			Если ПериодСобытия = 86400 Тогда
				
