				НовоеНапоминание.Объект					= НовоеСобытие.Ссылка;
				
				// заполним ресурсы
				НовоеНапоминание.ДатаАктуальности		= '00010101';
				НовоеНапоминание.ДатаНачала				= НовоеСобытие.ДатаНачала;
				НовоеНапоминание.ДатаОповещения			= НовоеСобытие.ДатаНачала;
				НовоеНапоминание.Описание				= "Звонок вежливости (" + СрокЗвонкаВежливостиДляНапоминания + ")" + Символы.ПС + "Клиент " + Строка(НовоеСобытие.Контрагент) + Символы.ПС + "Автомобиль " + Строка(НовоеСобытие.Автомобиль);
