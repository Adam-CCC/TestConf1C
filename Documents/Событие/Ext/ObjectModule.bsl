		СтрокаПользователь.Пользователь = ПараметрыСеанса.Пользователь;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

Процедура ПриКопировании(ОбъектКопирования)
	Если НЕ дкПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда Возврат; КонецЕсли;
КонецПроцедуры // ПриКопировании()

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//Бондаренко++ 20240314
	Если Не обЗначениеНеЗаполнено(ПодразделениеКомпании) Тогда
		Если Не обЗначениеНеЗаполнено(Организация) Тогда
			Если Организация <> ПодразделениеКомпании.Организация Тогда	
				Организация = ПодразделениеКомпании.Организация;
				Комментарий = СокрЛП(Комментарий)+" / "+СокрЛП(Организация)+" / "+СокрЛП(Номер);
				Попытка
				   УстановитьНовыйНомер("");
 				Исключение
 				КонецПопытки;
 		    КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ОбПраво("НеКорректироватьЛишнееПриЗаписиРЛилиСобытия") Тогда
		Возврат;
 	КонецЕсли;
 	//Бондаренко-- 20240314
	
	Если НЕ дкПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда Возврат; КонецЕсли;
	
	СМГ_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения);
	
КонецПроцедуры // ПередЗаписью()

