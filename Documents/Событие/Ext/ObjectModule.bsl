Процедура АвтоВыборОповещения(Объект, ДопПараметры) Экспорт
#Если Клиент тогда
	Перем СписокОповещений; // Список оповещений
	СписокОповещений = Новый СписокЗначений;
	Если НЕ Объект.Ссылка.Пустая() тогда
		Запрос = Новый Запрос;
		Запрос.Текст = " 
		|ВЫБРАТЬ
		|	Напоминания.Пользователь,
		|	Напоминания.Автор,
		|	Напоминания.Завершено,
		|	Напоминания.РеальнаяДатаОповещения КАК РеальнаяДатаОповещения,
		|	Напоминания.Объект,
		|	Напоминания.ДатаОповещения,
		|	Напоминания.Тема
		|ИЗ
		|	РегистрСведений.Напоминания КАК Напоминания
		|ГДЕ
		|	Напоминания.Объект = &Объект
		|	И (НЕ Напоминания.Завершено)
		|
		|УПОРЯДОЧИТЬ ПО
		|	РеальнаяДатаОповещения
		|";
		Запрос.УстановитьПараметр("Объект", Объект);
		ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
		Для каждого стр Из ТаблицаРезультата Цикл
			текОповещение = Новый Структура;
			КолВо =  ТаблицаРезультата.Колонки.Количество()-1;
			//Для поле=0 по КолВо Цикл
			//	текОповещение.Вставить(ТаблицаРезультата.Колонки[поле].Имя,Стр[поле]);
			//КонецЦикла;
			Флаг = Истина;
			итератор = 0;
			Пока Флаг цикл
				Если итератор > КолВо тогда
					Прервать;
				КонецЕсли;
				текОповещение.Вставить(ТаблицаРезультата.Колонки[итератор].Имя,Стр[итератор]);
               итератор = итератор +1;
			КонецЦикла;	
			текДата = Формат(текОповещение.РеальнаяДатаОповещения, "ДЛФ=D");
			текЗаголовок = текДата+" "+СокрЛП(текОповещение.Тема);
			Если НЕ обЗначениеНЕЗаполнено(текОповещение.Пользователь) Тогда
				текЗаголовок = текЗаголовок + " (Получатель: " + текОповещение.Пользователь.Наименование + ")";
			КонецЕсли;
			СписокОповещений.Добавить(текОповещение, текЗаголовок,,БиблиотекаКартинок.ОповещениеИзменить);

		КонецЦикла;
	КонецЕсли;
	
	СписокОповещений.Добавить(Неопределено, "Создать новое напоминание",,БиблиотекаКартинок.Оповещение);
	
	текДействие = "Создать";
	текДанные = ДопПараметры;
	
	Если СписокОповещений.Количество() > 1 Тогда // иначе нужно создать новое
		//РезВыбора = Форма.ВыбратьИзМеню(СписокОповещений, Элемент);
		//Если РезВыбора = Неопределено Тогда
		//	возврат;
		//ИначеЕсли РезВыбора.Значение <> Неопределено тогда // выбран НЕ пункт "создать"
		//	текДействие = "Изменить";
		//	текДанные = РезВыбора.Значение;
		//КонецЕсли;
		//Для Каждого стр из СписокОповещений цикл
		//	стр.
		//	
		//КонецЦикла;	
		Возврат;
	КонецЕсли;
	
	Если текДействие = "Создать" Тогда		
		Если ДопПараметры.Свойство("СписокПользователей") Тогда
			//Если Вопрос("Создать напоминание для всех пользователей?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
				текДанные.Удалить("СписокПользователей");
			//КонецЕсли;
		КонецЕсли;
		АвтоСоздатьОповещение(Объект, текДанные);
	ИначеЕсли текДействие = "Изменить" Тогда
		опОткрытьОповещение(Объект, текДанные);
	КонецЕсли;
#КонецЕсли
КонецПроцедуры // опВыборОповещения()

Процедура АвтоСоздатьОповещение(Объект=Неопределено, ДопПараметры=Неопределено, Форма=Неопределено) Экспорт
#Если Клиент тогда
	ЭтоНовыйОбъект = Ложь;
	Попытка ЭтоНовыйОбъект = Форма.ЭтотОбъект.ЭтоНовый(); Исключение КонецПопытки;
	Если ЭтоНовыйОбъект Тогда
		Ответ = Вопрос("Объект еще не записан, создание для него нового напоминания не возможно.
						|Записать объект?", РежимДиалогаВопрос.ДаНет);
		Отказ = Истина;
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Попытка Отказ = НЕ Форма.ЗаписатьВФорме(); Исключение КонецПопытки;
		КонецЕсли;
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.Напоминания.СоздатьМенеджерЗаписи();
	//МенеджерЗаписи.СрокДоНачала = ПлановаяДатаВыдачи-2400;
	Если Объект <> Неопределено Тогда		
		МенеджерЗаписи.Объект = Объект;
	КонецЕсли;
	Если ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		МетаИзмерения = Метаданные.РегистрыСведений.Напоминания.Измерения;
		МетаРесурсы = Метаданные.РегистрыСведений.Напоминания.Ресурсы;
		Для Каждого Параметр Из ДопПараметры Цикл
			МетаОбъект = МетаИзмерения.Найти(Параметр.Ключ);
			Если (МетаОбъект<>Неопределено) тогда
				МенеджерЗаписи[МетаОбъект.Имя] = Параметр.Значение;
			Иначе
				МетаОбъект = МетаРесурсы.Найти(Параметр.Ключ);
				Если (МетаОбъект<>Неопределено) тогда
					МенеджерЗаписи[МетаОбъект.Имя] = Параметр.Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если обЗначениеНеЗаполнено(МенеджерЗаписи.ДатаНачала) Тогда
			МенеджерЗаписи.ДатаНачала = ТекущаяДата();
		КонецЕсли;
		Если обЗначениеНеЗаполнено(МенеджерЗаписи.ДатаОповещения) Тогда
			МенеджерЗаписи.ДатаОповещения =ДатаНачала-1800;
		КонецЕсли;
		Если обЗначениеНеЗаполнено(МенеджерЗаписи.РеальнаяДатаОповещения) Тогда
			МенеджерЗаписи.РеальнаяДатаОповещения = Макс(ТекущаяДата(), МенеджерЗаписи.ДатаОповещения - МенеджерЗаписи.СрокДоНачала);
		КонецЕсли;
			//МенеджерЗаписи.ВидНапоминания = Перечисления.ВидыНапоминаний.Выдача;
			МенеджерЗаписи.УдалитьПоИстеченииСрока = Истина;
		текФорма = МенеджерЗаписи.ПолучитьФорму();
		// занесем список переданных пользователей
		//ДопПараметры.Свойство("СписокПользователей", текФорма.Пользователи); 
		//текФорма.Открыть();
		МенеджерЗаписи.Записать();
	Иначе	
		текФорма = МенеджерЗаписи.ПолучитьФорму();
		текФорма.Открыть();
	КонецЕсли;
#КонецЕсли
КонецПроцедуры // опСоздатьОповещение()

Функция ЗаписатьВыдачуВРЛ (Флаг) Экспорт 
	Если Флаг тогда
		Если ТипЗнч(ДокументОснование.Ссылка) = Тип("ДокументСсылка.РабочийЛист") тогда
			Если   ДокументОснование.Ссылка.Статус = Справочники.СтатусыРабочегоЛиста.Продажа и Состояние = Перечисления.СостоянияСобытий.Завершено тогда
				Объект = ДокументОснование.Ссылка.ПолучитьОбъект();
				Объект.Автомобиль = Автомобиль;
				Объект.ОбработкаРеквизита("Автомобиль");
				Объект.МашинаВыдана = Истина;
				Попытка
					Объект.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					Возврат Ложь;
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;

	Иначе
	  	Если ТипЗнч(ДокументОснование.Ссылка) = Тип("ДокументСсылка.РабочийЛист") тогда
			Объект = ДокументОснование.Ссылка.ПолучитьОбъект();
			Объект.МашинаВыдана = Ложь;
			Попытка
				Объект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Возврат Ложь;
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;
    Возврат Истина;
КонецФункции

Функция  ЗаполнитьНапоминаниеиСоздатьНопоминание(ДатаНапоминания,Пользаватель) Экспорт 
		Данные = Новый Структура;
		Данные.Вставить("Пользователь", Пользаватель);
		Данные.Вставить("Автор",Пользаватель );
		Данные.Вставить("Объект", ЭтотОбъект.Ссылка);
		Данные.Вставить("Завершено", Ложь);
		Данные.Вставить("ДатаНачала", ДатаНапоминания-900);
		Данные.Вставить("ТипПериода","00");
		//Данные.Вставить("СрокДоНачала", 0*86400);
		Данные.Вставить("Тема", "Напомнить о событие "+Контрагент);
		//формируем текст напоминания
		Стр = "Вид события: " + " напоминание клиенту" + "." + Символы.ПС + Символы.ПС + Контрагент + ", " + Автомобиль;
		Данные.Вставить("Описание", Стр);
		
		СписокПользователей = Новый СписокЗначений;
		СписокПользователей.Добавить(ПараметрыСеанса.Пользователь);
		Данные.Вставить("СписокПользователей", СписокПользователей);

		
		Возврат Данные;
КонецФункции	
	
Процедура ОбновитьРЛ()  Экспорт 
	Попытка
		Если ТипЗнч(ДокументОснование.Ссылка) = Тип("ДокументСсылка.РабочийЛист") тогда
			Объект = ДокументОснование.Ссылка.ПолучитьОбъект() ;
			Объект.ДатаИзменения = ТекущаяДата();
			Если ВидСобытия = Перечисления.ВидыСобытий.ТестДрайв и Состояние = Перечисления.СостоянияСобытий.Завершено тогда
				Объект.ТестДрайв = Истина;
			КонецЕсли;	
			Попытка
				Объект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				
			КонецПопытки;	
			НоваяЗапись = РегистрыСведений.ИсторияСостоянияРабочегоЛиста.СоздатьМенеджерЗаписи();
			НоваяЗапись.Период = ТекущаяДата();
			НоваяЗапись.РабочийЛист = ДокументОснование.Ссылка;
			НоваяЗапись.Статус = ДокументОснование.Статус;
			НоваяЗапись.Документ = Ссылка;
			НоваяЗапись.Значение = Содержание;
			
			НоваяЗапись.Записать(Истина);
			
		КонецЕсли;	
	Исключение
	КонецПопытки;
КонецПроцедуры	

Процедура СоздатьСобытияВежливости() Экспорт 
	
	Попытка
				
		Если ТипЗнч(ДокументОснование.Ссылка) = Тип("ДокументСсылка.РабочийЛист") И ДокументОснование.Ссылка.Статус = Справочники.СтатусыРабочегоЛиста.Продажа Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	НастройкиЗвонковВежливости.Анкета1День,
			               |	НастройкиЗвонковВежливости.Анкета3Дня,
			               |	НастройкиЗвонковВежливости.Анкета10Дней,
			               |	НастройкиЗвонковВежливости.Анкета1Месяц,
			               |	НастройкиЗвонковВежливости.Анкета3Месяца,
			               |	НастройкиЗвонковВежливости.Анкета6Месяцев,
			               |	НастройкиЗвонковВежливости.Анкета9Месяцев,
			               |	НастройкиЗвонковВежливости.Анкета1Год,
			               |	НастройкиЗвонковВежливости.Анкета15Месяцев,
			               |	НастройкиЗвонковВежливости.Анкета18Месяцев,
			               |	НастройкиЗвонковВежливости.Анкета3Года
			               |ИЗ
			               |	РегистрСведений.НастройкиЗвонковВежливости КАК НастройкиЗвонковВежливости
			               |ГДЕ
			               |	НастройкиЗвонковВежливости.Подразделение = &Подразделение";
						   
			Запрос.УстановитьПараметр("Подразделение", ДокументОснование.ПодразделениеКомпании);
						   
			НастройкиЗвонковВежливости = Новый Структура("Анкета1День, Анкета3Дня, Анкета10Дней, Анкета1Месяц, Анкета3Месяца, Анкета6Месяцев, Анкета9Месяцев, Анкета1Год, Анкета15Месяцев, Анкета18Месяцев, Анкета3Года");
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				ЗаполнитьЗначенияСвойств(НастройкиЗвонковВежливости, Выборка);
			КонецЕсли;
			
			МассивПериодовЗвонковВежливости = Новый Массив;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета1День) Тогда		// 1 день
				МассивПериодовЗвонковВежливости.Добавить(86400);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета3Дня) Тогда			// 3 дня
				МассивПериодовЗвонковВежливости.Добавить(259200);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета1Месяц) Тогда		// 1 месяц
				МассивПериодовЗвонковВежливости.Добавить(2592000);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета3Месяца) Тогда		// 3 месяца
				МассивПериодовЗвонковВежливости.Добавить(7776000);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета6Месяцев) Тогда		// 6 месяцев
				МассивПериодовЗвонковВежливости.Добавить(15724800);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета9Месяцев) Тогда		// 9 месяцев
				МассивПериодовЗвонковВежливости.Добавить(23328000);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета1Год) Тогда			// 1 год
				МассивПериодовЗвонковВежливости.Добавить(31536000);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НастройкиЗвонковВежливости.Анкета15Месяцев) Тогда	// 15 месяцев
