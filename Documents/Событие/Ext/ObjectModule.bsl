			Если ЗначениеЗаполнено(ТиповаяАнкета) и Константы.ДилерскийЦентр.Получить() <> Справочники.ДилерскиеЦентры.Дельта Тогда
				НовоеСобытие.Опрос = ПолучитьОпрос(НовоеСобытие.Ссылка, ТиповаяАнкета, НовоеСобытие.ДатаНачала, ПринадлежностьОпроса, МенеджерОпроса);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НовоеСобытие.Опрос) Тогда
				Попытка
					НовоеСобытие.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
						
			ПолучательНапоминания = ПолучитьПользователяПоСотруднику(МенеджерОпроса);
			
			Если ЗначениеЗаполнено(ПолучательНапоминания) Тогда
			
				НовоеНапоминание						= РегистрыСведений.Напоминания.СоздатьМенеджерЗаписи();
				
				// заполним измерения
				НовоеНапоминание.Пользователь			= ПолучательНапоминания;
