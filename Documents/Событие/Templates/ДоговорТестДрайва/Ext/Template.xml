					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>в) для сдачи в аренду, напрокат или иным образом в пользование или владение третьим лицам;</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
