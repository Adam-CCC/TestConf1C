				<c>
					<f>14</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>б) для перевозки легковоспламеняющихся, радиоактивных, ядовитых и прочих опасных веществ;</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
