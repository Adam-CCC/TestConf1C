Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Renault_ЗаявкаНаТрейдИн.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
		               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
		               |			ПО Renault_CRM_ЗаявкаНаСервис.Обращение = Renault_CRM_ОбращениеВАвтоСервис.Ссылка
		               |				И (Renault_CRM_ЗаявкаНаСервис.Ссылка = &Ссылка)
		               |		ПО Renault_ЗаявкаНаТрейдИн.Клиент = Renault_CRM_ОбращениеВАвтоСервис.Клиент
		               |			И (НЕ Renault_ЗаявкаНаТрейдИн.ПометкаУдаления)
		               |			И (НЕ Renault_CRM_ОбращениеВАвтоСервис.ПометкаУдаления)
		               |			И (Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения = &ВидОбращения)
		               |			И Renault_ЗаявкаНаТрейдИн.Автомобиль = Renault_CRM_ОбращениеВАвтоСервис.Автомобиль";
		
		Запрос.УстановитьПараметр("ВидОбращения", Справочники.Renault_ВидыОбращенийВАвтосервис.ДиагностикаТрейдИн);
		Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
		
			ЗаявкаНаТрейдИн = Выборка[0].Ссылка.ПолучитьОбъект();
			ЗаявкаНаТрейдИн.ЗатратыДиагностика = Работы.Итог("Сумма") + Товары.Итог("Сумма");
			ЗаявкаНаТрейдИн.ОриентировочнаяЦена = ЗаявкаНаТрейдИн.ОриентировочнаяЦенаСреднее - ЗаявкаНаТрейдИн.Маржа - ЗаявкаНаТрейдИн.ЗатратыОсмотрМашины - ЗаявкаНаТрейдИн.ЗатратыДиагностика;
			ЗаявкаНаТрейдИн.ЦенаВыкупа = ЗаявкаНаТрейдИн.ОриентировочнаяЦенаСреднее - ЗаявкаНаТрейдИн.ЗатратыОсмотрМашины - ЗаявкаНаТрейдИн.ЗатратыДиагностика;
			Попытка
				ЗаявкаНаТрейдИн.Записать();
			Исключение
			КонецПопытки;
			
			Прервать;
			
		КонецЦикла;
				
	КонецЕсли;
	
КонецПроцедуры