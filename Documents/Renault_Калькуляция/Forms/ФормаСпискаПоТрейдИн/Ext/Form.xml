	<Attributes>
		<Attribute name="СписокКалькуляций" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список калькуляций</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>List calculations</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<UseAlways>
				<Field>СписокКалькуляций.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Renault_Калькуляция.Ссылка,
	Суммы.Сумма КАК Итого,
	Renault_Калькуляция.Дата,
	Renault_Калькуляция.Автор
ИЗ
	Документ.Renault_Калькуляция КАК Renault_Калькуляция
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СУММА(ЕСТЬNULL(Работы.Сумма, 0)) + СУММА(ЕСТЬNULL(Товары.Сумма, 0)) КАК Сумма,
			Описание.Ссылка КАК Ссылка
		ИЗ
			Документ.Renault_Калькуляция.ПроизвольноеОписание КАК Описание
				ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Калькуляция.Работы КАК Работы
				ПО Описание.Ссылка = Работы.Ссылка
					И (Описание.ДаноСогласие = ИСТИНА)
				ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Калькуляция.Товары КАК Товары
				ПО Описание.Ссылка = Товары.Ссылка
					И (Описание.ДаноСогласие = ИСТИНА)
		
		СГРУППИРОВАТЬ ПО
			Описание.Ссылка) КАК Суммы
		ПО Renault_Калькуляция.Ссылка = Суммы.Ссылка
ГДЕ
	Renault_Калькуляция.ДокументОснование В
			(ВЫБРАТЬ
				Renault_CRM_ЗаявкаНаСервис.Ссылка
			ИЗ
				Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
			ГДЕ
				Renault_CRM_ЗаявкаНаСервис.Обращение В
					(ВЫБРАТЬ
						Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК Документ
					ИЗ
						Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
							ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
							ПО
								Renault_CRM_ОбращениеВАвтоСервис.Клиент = Renault_ЗаявкаНаТрейдИн.Клиент
									И Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = Renault_ЗаявкаНаТрейдИн.Автомобиль
					ГДЕ
						Renault_ЗаявкаНаТрейдИн.Ссылка = &amp;Ссылка
						И Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения = &amp;ВидОбращения
						И Renault_CRM_ОбращениеВАвтоСервис.ПометкаУдаления = ЛОЖЬ
						И Renault_ЗаявкаНаТрейдИн.ПометкаУдаления = ЛОЖЬ))</QueryText>
				<MainTable>Document.Renault_Калькуляция</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
