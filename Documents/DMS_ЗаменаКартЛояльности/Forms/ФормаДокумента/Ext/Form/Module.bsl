&НаСервере
Процедура СоздатьНовыеКартыНаСервере()
	
	Для каждого ТекущаяСтрока Из Объект.КартыПокупателей Цикл
	
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.КартаПриемник) 
			И ЗначениеЗаполнено(ТекущаяСтрока.ВидКарты)
			И ЗначениеЗаполнено(ТекущаяСтрока.КартаИсточник) Тогда

			НоваяКартаОбъект = ТекущаяСтрока.КартаИсточник.Скопировать();	
			НоваяКартаОбъект.УстановитьНовыйКод();
			НоваяКартаОбъект.DMS_ВидКартыЛояльности = ТекущаяСтрока.ВидКарты;
			НоваяКартаОбъект.Наименование			= "Карта("+СокрЛП(ТекущаяСтрока.ВидКарты)+"): " + Строка(Объект.Контрагент);
			НоваяКартаОбъект.ДилерскийЦентр 		= Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			
			Попытка
				НоваяКартаОбъект.Записать();
			Исключение
			   	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			
			ТекущаяСтрока.КартаПриемник = НоваяКартаОбъект.Ссылка;
	
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.КартаПриемник) 
			И ЗначениеЗаполнено(ТекущаяСтрока.ВидКарты)
			И ЗначениеЗаполнено(ТекущаяСтрока.КартаИсточник) Тогда

			НоваяКартаОбъект = ТекущаяСтрока.КартаПриемник.ПолучитьОбъект();	
			НоваяКартаОбъект.DMS_ВидКартыЛояльности = ТекущаяСтрока.ВидКарты;
			НоваяКартаОбъект.ПометкаУдаления = Ложь;
			НоваяКартаОбъект.Наименование			= "Карта("+СокрЛП(ТекущаяСтрока.ВидКарты)+"): " + Строка(Объект.Контрагент);
			НоваяКартаОбъект.ДилерскийЦентр 		= Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			
			Попытка
				НоваяКартаОбъект.Записать();
			Исключение
			   	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			
			ТекущаяСтрока.КартаПриемник = НоваяКартаОбъект.Ссылка;
			
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры
 
&НаСервереБезКонтекста
Функция ПолучитьОстатокПоКартеЛояльнсти(КартаЛояльности,Период)
	
	ПараметрыГраницы = Новый Массив(2);
	ПараметрыГраницы[0] = КонецДня(Период);
	ПараметрыГраницы[1] = ВидГраницы.Включая;
	
	ГраницаПериода = Новый(Тип("Граница"),ПараметрыГраницы);	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КартаЛояльности", КартаЛояльности);
	Запрос.УстановитьПараметр("Период", 		 ГраницаПериода);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БонусныеБаллы.КартаЛояльности,
		|	БонусныеБаллы.НачисленоОстаток КАК НачисленоОстаток
		|ИЗ
		|	РегистрНакопления.DMS_БонусныеБаллы.Остатки(&Период, КартаЛояльности = &КартаЛояльности) КАК БонусныеБаллы
		|ГДЕ
		|	БонусныеБаллы.НачисленоОстаток + БонусныеБаллы.КСписаниюОстаток > 0";
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НачисленоОстаток = 0;
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		НачисленоОстаток = ВыборкаДетальныеЗаписи.НачисленоОстаток;	
	КонецЕсли; 
	
	Возврат НачисленоОстаток;
	
КонецФункции // ПолучиьтОстатокПоКартеЛояльнсти()

&НаСервереБезКонтекста
Функция ПолучитьВидыКартПоЗаменеДисконтных(КартаЛояльности)
	
	ВидДисконтнойКарты = КартаЛояльности.DMS_ВидКартыЛояльности;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПравилаЗаменыДисконтныхКарт.Ссылка КАК ВидКарты
		|ПОМЕСТИТЬ ВидыКарт
		|ИЗ
		|	Справочник.DMS_ВидыКартЛояльности.ПравилаЗаменыДисконтныхКарт КАК ПравилаЗаменыДисконтныхКарт
		|ГДЕ
		|	ПравилаЗаменыДисконтныхКарт.Ссылка.ИспользуетсяЗаменаДисконтныхКарт
		|	И НЕ ПравилаЗаменыДисконтныхКарт.Ссылка.ПометкаУдаления
		|	И ПравилаЗаменыДисконтныхКарт.ВидДисконтнойКарты = &ВидДисконтнойКарты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыКарт.ВидКарты
		|ИЗ
		|	ВидыКарт КАК ВидыКарт";
	
	Запрос.УстановитьПараметр("ВидДисконтнойКарты", ВидДисконтнойКарты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СписокВидовКарт = Новый СписокЗначений;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СписокВидовКарт.Добавить(ВыборкаДетальныеЗаписи.ВидКарты);	
	КонецЦикла;
	
	Возврат СписокВидовКарт;

КонецФункции // ПолучитьВидыКартПоЗаменеДиксонтных()

&НаКлиенте
Процедура СогласиеНаОбработкуДанных(Команда)
	
	// сохранение ссылки на коллекцию прав, настроек и окружения
	Права = Неопределено;
	#Если Клиент Тогда
		Права = глПрава;
	#КонецЕсли
	
	СогласиеНаОбработкуПерсональныхДанныхДата = Объект.Дата;
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = Документы.DMS_ЗаменаКартЛояльности.ПолучитьМакетСогласия();
	
	СтруктураПредставления=Новый Структура(
		"ИНН,КПП,АдресЮридический,ТелефонРабочий",
		"ИНН ","КПП ","Адрес: ","тел.: "
	);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.КонтрагентНаименование	= Объект.Контрагент.НаименованиеПолное;
	ОбластьМакета.Параметры.КонтрагентАдрес			= киПолучитьПредставлениеКИ(Объект.Контрагент,Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьМакета.Параметры.КонтрагентДокумент		= спПолучитьПодтверждающийДокументОбъектаПоВиду(Объект.Контрагент,Перечисления.ВидыДокументов.Паспорт);
	ОбластьМакета.Параметры.ОрганизацияНаименование	= спПолучитьПредставление(ПараметрыСеанса.Организация,Новый Структура("Наименование",""));
	ОбластьМакета.Параметры.ОрганизацияАдрес		= спПолучитьПредставление(ПараметрыСеанса.Организация,СтруктураПредставления);
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Согласие");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.КонтрагентНаименование	= Объект.Контрагент.Наименование;
	ОбластьМакета.Параметры.СогласиеДата			= Формат(СогласиеНаОбработкуПерсональныхДанныхДата,"ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Отобразить печатный документ на экране
	КлючУникальности	= Новый УникальныйИдентификатор();
	ФормаПечати			= ПолучитьОбщуюФорму("ПечатнаяФормаДокументов",,КлючУникальности);
	ТабличныйДокумент	= ФормаПечати.ЭлементыФормы.ТабличныйДокумент;
	ТабличныйДокумент.Защита			= обПраво("ЗащитаПечатныхФорм",Права);
	ТабличныйДокумент.ТолькоПросмотр	= обПраво("ОткрытиеПечатныхФормДокументовВРежимеПросмотра",Права);
	// Выведем печатную форму	
	ФормаПечати.ЭлементыФормы.ТабличныйДокумент.Вывести(ТабДокумент);
	// Заполним необходимые переменные и откроем форму
	ФормаПечати.Объект						= Объект.Контрагент.Ссылка;
	ФормаПечати.ОбъектПредставление			= Строка(Объект.Контрагент.Ссылка);
	ФормаПечати.ДополнительноКПредставлению	= "Согласие на обработку персональных данных";
	ФормаПечати.Открыть();
	
	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.DMS_СтатусЗаменыКарт.Согласован") Тогда
		
		Объект.Статус = ПредопределенноеЗначение("Перечисление.DMS_СтатусЗаменыКарт.Согласован");
		Модифицированность = Истина;
		
	КонецЕсли; 
	
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.DMS_СтатусЗаменыКарт.НаОзнакомлении") Тогда
		Элементы.Статус.ТолькоПросмотр = Истина;
	КонецЕсли; 
	
КонецПроцедуры
