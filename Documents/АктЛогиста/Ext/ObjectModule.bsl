Функция НайтиДоговор(ПараметрыДоговора)
	
	ДоговорВзаиморасчетовТек = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	//Бондаренко++ 20180321
	//Если СокрЛП(ПараметрыДоговора.Организация.ИНН)<>"6167075244" Тогда 
	//	Запрос.Текст = 
	//	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	//	|	ДоговорыВзаиморасчетов.Ссылка,
	//	|	ДоговорыВзаиморасчетов.ВидДоговора,
	//	|	ДоговорыВзаиморасчетов.Владелец,
	//	|	ДоговорыВзаиморасчетов.Организация,
	//	|	ДоговорыВзаиморасчетов.ДатаСоздания КАК ДатаСоздания,
	//	|	ДоговорыВзаиморасчетов.ДляЗапчастей,
	//	|	ДоговорыВзаиморасчетов.ПометкаУдаления,
	//	|	ДоговорыВзаиморасчетов.Владелец.ОсновнойДоговорВзаиморасчетов КАК ОснДоговор,
	//	|	ДоговорыВзаиморасчетов.ДляПерепродаж,
	//	|	ДоговорыВзаиморасчетов.Подразделение
	//	|ИЗ
	//	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	//	|ГДЕ
	//	|	ДоговорыВзаиморасчетов.Владелец = &ВыбВладелец
	//	|	И ДоговорыВзаиморасчетов.Организация = &ВыбОрганизация
	//	|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВыбВидДоговора
	//	|	И ДоговорыВзаиморасчетов.ДляЗапчастей = ИСТИНА
	//	|	И ДоговорыВзаиморасчетов.ДляПерепродаж = ИСТИНА
	//	|	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
	//	|	И ДоговорыВзаиморасчетов.Подразделение = &ВыбПодразделение
	//	|
	//	|УПОРЯДОЧИТЬ ПО
	//	|	ДатаСоздания";
	//	Запрос.УстановитьПараметр("ВыбПодразделение", ПараметрыДоговора.Подразделение);
 	//Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДоговорыВзаиморасчетов.Ссылка,
		|	ДоговорыВзаиморасчетов.ВидДоговора,
		|	ДоговорыВзаиморасчетов.Владелец,
		|	ДоговорыВзаиморасчетов.Организация,
		|	ДоговорыВзаиморасчетов.ДатаСоздания КАК ДатаСоздания,
		|	ДоговорыВзаиморасчетов.ДляЗапчастей,
		|	ДоговорыВзаиморасчетов.ПометкаУдаления,
		|	ДоговорыВзаиморасчетов.Владелец.ОсновнойДоговорВзаиморасчетов КАК ОснДоговор,
		|	ДоговорыВзаиморасчетов.ДляПерепродаж
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
		|ГДЕ
		|	ДоговорыВзаиморасчетов.Владелец = &ВыбВладелец
		|	И ДоговорыВзаиморасчетов.Организация = &ВыбОрганизация
		|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВыбВидДоговора
		|	И ДоговорыВзаиморасчетов.ДляЗапчастей = ИСТИНА
		|	И ДоговорыВзаиморасчетов.ДляПерепродаж = ИСТИНА
		|	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСоздания";
 	//КонецЕсли; 
	//Бондаренко-- 20180321
	
 	
	Запрос.УстановитьПараметр("ВыбВидДоговора", ПараметрыДоговора.ВидДоговора);
	Запрос.УстановитьПараметр("ВыбВладелец", ПараметрыДоговора.Контрагент);
	Запрос.УстановитьПараметр("ВыбОрганизация", ПараметрыДоговора.Организация);
 	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорВзаиморасчетовТек = ВыборкаДетальныеЗаписи.Ссылка; 
		Если ВыборкаДетальныеЗаписи.ДляПерепродаж Тогда
			//Бондаренко++ 20200413
			Возврат ДоговорВзаиморасчетовТек;
			//Бондаренко-- 20200413
			Прервать;
		КонецЕсли; 
	КонецЦикла;
	
	Если обЗначениеНезаполнено(ДоговорВзаиморасчетовТек) Тогда
		Дог = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		Дог.Автор=ПараметрыСеанса.Пользователь;
		Дог.ДатаСоздания=ТекущаяДата();
		Дог.ДатаНачала=ТекущаяДата();
		Дог.ВидДоговора=ПараметрыДоговора.ВидДоговора;
		Дог.Владелец = ПараметрыДоговора.Контрагент;
		Дог.Организация = ПараметрыДоговора.Организация;
		Дог.Подразделение = ПараметрыДоговора.Подразделение;
		Дог.ВалютаВзаиморасчетов=Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		Дог.ВидОплаты=Перечисления.ВидыОплаты.ПроизвольнаяОплата;
		Дог.ДляЗапчастей=Истина;
		Дог.ДляПерепродаж=Истина;
		Дог.Наименование = СокрЛП(Строка(Дог.ВидДоговора))
		+ ?(ПустаяСтрока(Дог.НомерДоговора),""," № " + СокрЛП(Дог.НомерДоговора))
		+ " в " + Дог.ВалютаВзаиморасчетов.Наименование
		+ " от "+Формат(Дог.ДатаНачала,"ДФ=дд.ММ.гг");
		
		Попытка
			Дог.Записать();
			ДоговорВзаиморасчетов = Дог.Ссылка;
		Исключение
			#Если НаКлиенте Тогда
				Сообщить("ОШИБКА! Не удалось записать договор");		
			#КонецЕсли 
		КонецПопытки;
		
	КонецЕсли; 
	
	Возврат ДоговорВзаиморасчетовТек;
	
	
КонецФункции // НайтиДоговор(ПараметрыДоговора)
