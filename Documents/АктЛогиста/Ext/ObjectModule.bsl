Процедура СМГ_АгентскоеВознаграждение()
	
	ХозОперация=Справочники.ХозОперации.АктОбОказанииУслуг;
	ОптоваяПродажа=Ложь;
	ИсточникИнформации = Справочники.ИсточникиИнформации.ЛичныйВизит;
	ОрганизацияАгент = Справочники.Организации.НайтиПоРеквизиту("ИНН","262804044870");
	Если Организация <> ОрганизацияАгент Тогда
		Организация = ОрганизацияАгент;
	КонецЕсли; 
	ПодразделениеКомпании = НайтиПодразделениеАгента(ПодразделениеКомпании,ОрганизацияАгент);
	ДоговорВзаиморасчетов = СМ_ABCP.НайтиСоздатьДоговор(Контрагент,Организация,ПодразделениеКомпании);
	Товары.Очистить();
	НовСтрока = Товары.Добавить();
	НовСтрока.Номенклатура = Справочники.Номенклатура.АгентскоеВознаграждение;
	НовСтрока.ЕдиницаИзмерения = Справочники.Номенклатура.АгентскоеВознаграждение.ОсновнаяЕдиницаИзмерения;
	НовСтрока.ИдентификаторТовара = Новый УникальныйИдентификатор();
	НовСтрока.Количество = 1;
	НовСтрока.КоличествоБазовое = 1;
	НовСтрока.Коэффициент=1;
	Если Организация.ОсвобожденОтНДС Тогда
		НовСтрока.СтавкаНДС=Справочники.СтавкиНДС.БезНДС;
	Иначе
		НовСтрока.СтавкаНДС=Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	КонецЕсли;
	НовСтрока.Цена = 5000;
	НовСтрока.Сумма = НовСтрока.Цена*НовСтрока.Количество*НовСтрока.Коэффициент;
	НовСтрока.СуммаВсего = НовСтрока.Сумма;
	НовСтрока.СуммаНДС = НовСтрока.СуммаВсего*НовСтрока.СтавкаНДС.Ставка/(100+НовСтрока.СтавкаНДС.Ставка);
	
	
КонецПроцедуры

