Функция НайтиСписокАйДи(ТекЗаказПокупателя,ТекНоменклатура)
	
	СтрокаАйДи = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателяТовары.Ссылка КАК ЗаказПокупателя,
		|	ЗаказПокупателяТовары.Номенклатура,
		|	ЗаказПокупателяТовары.АйДи
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|ГДЕ
		|	ЗаказПокупателяТовары.Ссылка = &Ссылка
		|	И ЗаказПокупателяТовары.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", ТекНоменклатура);
	Запрос.УстановитьПараметр("Ссылка", ТекЗаказПокупателя);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() > 0 Тогда
		Для каждого Стр Из ТЗ Цикл
			Если НЕ обЗначениеНеЗаполнено(СтрокаАйДи) Тогда
				СтрокаАйДи = СтрокаАйДи+","+СокрЛП(Стр.АйДи);
			Иначе
				СтрокаАйДи = СокрЛП(Стр.АйДи);
 			КонецЕсли; 
 		КонецЦикла; 	
	КонецЕсли; 
	
	Возврат СтрокаАйДи;
 
КонецФункции // НайтиСписокАйДи()
