Процедура СформироватьПерепродажу(ВопросОПеремещении=Истина,ВозврЗначение,СписокОчищаемыхСкладов,ФлагНашаФирма) Экспорт
	
	Если ВопросОПеремещении Тогда
		#Если НаКлиенте Тогда
		Если Вопрос("Сформировать перепродажу между юридическими лицами компании?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
	//Бондаренко++ 20170412
	СЗ_СкладыОтправители = Новый СписокЗначений; 
	
 	Для Каждого стр из Товары цикл
		Если обЗначениеНеЗаполнено(стр.СкладКомпании) Тогда
			Продолжить;
		КонецЕсли;
		Если СЗ_СкладыОтправители.НайтиПоЗначению(стр.СкладКомпании.Ссылка)=Неопределено Тогда
			СЗ_СкладыОтправители.Добавить(стр.СкладКомпании.Ссылка);
		КонецЕсли; 
	КонецЦикла;	
 	//Бондаренко-- 20170412
	
	Для каждого ТекСклад Из СЗ_СкладыОтправители Цикл
		
		ТоварыКПродаже = Новый ТаблицаЗначений;
		ТоварыКПродаже.Колонки.Добавить("Товар");
		ТоварыКПродаже.Колонки.Добавить("Количество");
		ТоварыКПродаже.Колонки.Добавить("ЗН");
		ТоварыКПродаже.Колонки.Добавить("ЕдиницаИзмерения");
		ТоварыКПродаже.Колонки.Добавить("ОрганизацияПоставщик");
		ТоварыКПродаже.Колонки.Добавить("ПодразделениеПоставщик");
		ТоварыКПродаже.Колонки.Добавить("СкладОтправитель");
		ТоварыКПродаже.Колонки.Добавить("ИНН_Покупателя");
		ТоварыКПродаже.Колонки.Добавить("ИНН_Продавца");
		ТоварыКПродаже.Колонки.Добавить("ИдентификаторТовара");
		
		Для Каждого стр из Товары цикл
			
 			Если обЗначениеНеЗаполнено(стр.СкладКомпании) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Стр.СкладКомпании.Ссылка <> ТекСклад.Значение Тогда
				Продолжить;
			КонецЕсли; 
 			
			СтрокаТоварыКПродаже = ТоварыКПродаже.Добавить();
			
			СтрокаТоварыКПродаже.Товар = стр.Номенклатура;
			СтрокаТоварыКПродаже.Количество = стр.Количество;
			СтрокаТоварыКПродаже.ЗН = Ссылка.Ссылка;
			СтрокаТоварыКПродаже.ЕдиницаИзмерения = стр.ЕдиницаИзмерения;
			
 			СтрокаТоварыКПродаже.ОрганизацияПоставщик   = стр.СкладКомпании.Организация;
			СтрокаТоварыКПродаже.ПодразделениеПоставщик = стр.СкладКомпании.Подразделение;
			СтрокаТоварыКПродаже.СкладОтправитель       = стр.СкладКомпании.Ссылка;
			СтрокаТоварыКПродаже.ИНН_Продавца           = стр.СкладКомпании.Организация.ИНН; 
 			
  			СтрокаТоварыКПродаже.ИНН_Покупателя = Ссылка.Организация.ИНН;
			
			//Бондаренко++ 20210218
			СтрокаТоварыКПродаже.ИдентификаторТовара = стр.ИдентификаторТовара;
 			//Бондаренко-- 20210218
 
		КонецЦикла;	
		
		//Бондаренко++ 20181229
		//=====================================================
		//Откорректируем таблицу товаров на количество, уже проданного.
		//Защита от повторных нажатий при частичных (не до конца сформированных) пакетах перепродаж
		
		Запрос = Новый Запрос;
		
		СЗ_Товары = Новый СписокЗначений;
		
		СЗ_Товары.ЗагрузитьЗначения(ТоварыКПродаже.ВыгрузитьКолонку("Товар"));
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	РеализацияТоваровТовары.Ссылка КАК Реализация,
		               |	РеализацияТоваровТовары.Ссылка.ДокументОснование КАК ДокументОснованиеРеализации,
		               |	РеализацияТоваровТовары.Номенклатура КАК Товар,
		               |	СУММА(РеализацияТоваровТовары.КоличествоБазовое) КАК Количество,
		               |	РеализацияТоваровТовары.Ссылка.СкладКомпании КАК СкладОтправитель
		               |ИЗ
		               |	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
		               |ГДЕ
		               |	РеализацияТоваровТовары.Ссылка.ДокументОснование = &ДокументОснование
		               |	И РеализацияТоваровТовары.Ссылка ССЫЛКА Документ.РеализацияТоваров
		               |	И РеализацияТоваровТовары.Ссылка.СкладКомпании В (&СЗ_СкладыОтправители)
		               |	И РеализацияТоваровТовары.Номенклатура В (&Сз_Номенклатура)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	РеализацияТоваровТовары.Ссылка.СкладКомпании,
		               |	РеализацияТоваровТовары.Номенклатура,
		               |	РеализацияТоваровТовары.Ссылка,
		               |	РеализацияТоваровТовары.Ссылка.ДокументОснование";
		
		Запрос.УстановитьПараметр("ДокументОснование",Ссылка);
		Запрос.УстановитьПараметр("СЗ_СкладыОтправители",СЗ_СкладыОтправители);
		Запрос.УстановитьПараметр("Сз_Номенклатура",СЗ_Товары);
				
		ТЗ_УжеПродано = Запрос.Выполнить().Выгрузить();
		Если РольДоступна("ПолныеПрава") Тогда
			ТЗ_УжеПродано.ВыбратьСтроку("Товары уже продано");
		КонецЕсли; 
		
		Если РольДоступна("ПолныеПрава") Тогда
			ТоварыКПродаже.ВыбратьСтроку("Товары к продаже ДО корректировки");
		КонецЕсли; 
 	
		Для каждого Стр Из ТоварыКПродаже Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Товар",Стр.Товар);
			ПараметрыОтбора.Вставить("СкладОтправитель",Стр.СкладОтправитель);
			СтрокиКорректировки = ТЗ_УжеПродано.НайтиСтроки(ПараметрыОтбора);
			Если СтрокиКорректировки.Количество()>0  Тогда
				Стр.Количество = Число(Стр.Количество) - Число(СтрокиКорректировки[0].Количество);
 			КонецЕсли; 
  		КонецЦикла; 
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Количество",0);
		СтрокиКорректировки = ТоварыКПродаже.НайтиСтроки(ПараметрыОтбора);
		Для каждого СтрокаУдаления Из СтрокиКорректировки Цикл
      		ТоварыКПродаже.Удалить(СтрокаУдаления);
		КонецЦикла;
 		//=====================================================
		//Бондаренко-- 20181229
 		
		Если РольДоступна("ПолныеПрава") Тогда
			ТоварыКПродаже.ВыбратьСтроку("Товары к продаже ПОСЛЕ корректировки");
		КонецЕсли; 
		
		//Бондаренко++ 20210218
		ТаблицаКодовМаркировки = Новый ТаблицаЗначений;
		ТаблицаКодовМаркировки.Колонки.Добавить("ИдентификаторТовара");
		ТаблицаКодовМаркировки.Колонки.Добавить("КодМаркировки");
		
		//ЕстьКодыМаркировки=Ложь;
		//Для Каждого стр из КодыМаркировки цикл
		//	СтрокаКодов = ТаблицаКодовМаркировки.Добавить();
		//	СтрокаКодов.ИдентификаторТовара = стр.ИдентификаторТовара;
		//	СтрокаКодов.КодМаркировки = стр.КодМаркировки;
		//	ЕстьКодыМаркировки=Истина;
		//КонецЦикла;
		//ТаблицаКодовМаркировки.ВыбратьСтроку();
		//Бондаренко-- 20210218
  		
		БылиОшибки = Истина;  
		
		Если ТоварыКПродаже.Количество() > 0 тогда
			НачатьТранзакцию();
			
			//Бондаренко++ 20210218
			БылиОшибки = СоздатьДокументыПерепродажиПоЮрЛицам(ТоварыКПродаже,ФлагНашаФирма);
			
 //   		СкладСтрокиТаблицы = ТекСклад.Значение;
 //   		Сообщить("Обрабатывается склад = "+ТекСклад.Значение);
 //   		Отбор = Новый Структура("СкладОтправитель", ТекСклад.Значение);
 //   		ТЗ_ПоСкладу = ТоварыКПродаже.Скопировать(Отбор);
 //
 //			ТЗ_КодовМаркировки=ТаблицаКодовМаркировки.Скопировать();
 //   		ТЗ_КодовМаркировки.Очистить();
 //			Если ЕстьКодыМаркировки Тогда
 //   			СЗ_ИдентификаторовТовара = Новый СписокЗначений;
 //   			СЗ_ИдентификаторовТовара.ЗагрузитьЗначения(ТЗ_ПоСкладу.ВыгрузитьКолонку("ИдентификаторТовара"));
 //				Для каждого Стр Из ТаблицаКодовМаркировки Цикл
 //   				Если СЗ_ИдентификаторовТовара.НайтиПоЗначению(Стр.ИдентификаторТовара)=Неопределено Тогда
 //   					Продолжить;
 //					КонецЕсли; 
 //   				НовСтрока = ТЗ_КодовМаркировки.Добавить();					
 //   				НовСтрока.ИдентификаторТовара = Стр.ИдентификаторТовара;
 //   				НовСтрока.КодМаркировки = Стр.КодМаркировки;
 //   			КонецЦикла; 
 //			КонецЕсли;  
 //
 //   		БылиОшибки = СМ_ПерепродажиЗапчастей.СоздатьДокументыПерепродажиПоЮрЛицамОбщийМодуль(ТЗ_ПоСкладу,ТЗ_КодовМаркировки,Ссылка,СкладКомпании);
			//Бондаренко-- 20210218
			ЗафиксироватьТранзакцию();
			//Бондаренко++ 20181229	
		Иначе
			#Если НаКлиенте Тогда
				Сообщить("Все товары уже перепроданы.",СтатусСообщения.ОченьВажное);
			#КонецЕсли 
			БылиОшибки = Ложь; 
			//Бондаренко-- 20181229	
		КонецЕсли; 
		
		Если БылиОшибки Тогда
			#Если НаКлиенте Тогда
			Сообщить("Обработка по перепродаже завершена С ошибками",СтатусСообщения.ОченьВажное);
			#КонецЕсли 
			ВозврЗначение=Ложь;
		Иначе	
			#Если НаКлиенте Тогда
