Процедура ПересчитатьПоСебестоимости(Этаформа) Экспорт
	ДокументОбъект = ЭтотОбъект;
	
	//Бондаренко++ 20220308
	Если ДокументОбъект.НепроводнойДляДопОборудования Тогда
 	    Возврат;
 	КонецЕсли;		
	//Бондаренко-- 20220308
	
	ИмяРеквизитаДокумент = "Партия"  ;
	ПартииУказаны=НЕ обЗначениеНеЗаполнено(ИмяРеквизитаДокумент);
