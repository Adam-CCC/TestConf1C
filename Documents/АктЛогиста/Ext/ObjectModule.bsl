//Бондаренко++ 20210128	
Функция НайтиПодразделениеАгента(ПодразделениеКомпании,ОрганизацияАгент)
	
	ЭтоРодитель = НайтиПодчиненные(ПодразделениеКомпании);
	
 	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка,
		|	ПодразделенияКомпании.Родитель,
		|	ПодразделенияКомпании.Организация
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Родитель = &Родитель
		|	И ПодразделенияКомпании.Организация = &ОрганизацияАгент";
	
	Запрос.УстановитьПараметр("ОрганизацияАгент", ОрганизацияАгент);
	
	Если ЭтоРодитель Тогда
		Запрос.УстановитьПараметр("Родитель", ПодразделениеКомпании);
	Иначе	
	    Запрос.УстановитьПараметр("Родитель", ПодразделениеКомпании.Родитель);
	КонецЕсли; 
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат	ВыборкаДетальныеЗаписи.Ссылка; 
	КонецЦикла;
	
 	Возврат Справочники.ПодразделенияКомпании.ПустаяСсылка();
 
КонецФункции // НайтиПодразделениеАгента((ПодразделениеКомпании,ОрганизацияАгент)

Функция НайтиПодчиненные(ПодразделениеКомпании)
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодразделенияКомпании.Ссылка,
		|	ПодразделенияКомпании.Родитель
		|ИЗ
		|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
		|ГДЕ
		|	ПодразделенияКомпании.Родитель = &Родитель";
	
	Запрос.УстановитьПараметр("Родитель", ПодразделениеКомпании);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь; 
 
КонецФункции // НайтиПодчиненные(ПодразделениеКомпании)
