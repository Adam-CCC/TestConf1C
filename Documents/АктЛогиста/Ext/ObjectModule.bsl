Функция НайтиСоздатьДокументыПеремешенияИПерепродажОдногоДЦмодуль(ТЗ_Перемещений,ТЗ_Реализаций) Экспорт
	
	СЗ_CкладовОтправителей = Новый СписокЗначений;
	
	Для каждого Стр Из ТЗ_Перемещений Цикл
	    Если СЗ_CкладовОтправителей.НайтиПоЗначению(Стр.СкладОтправитель)<>Неопределено Тогда
			Продолжить;
 		КонецЕсли; 
 	    СЗ_CкладовОтправителей.Добавить(Стр.СкладОтправитель);
	КонецЦикла; 
	
	//СЗ_CкладовОтправителей.ЗагрузитьЗначения(ТЗ_Перемещений.ВыгрузитьКолонку("СкладОтправитель"));
	
	//Создан = Истина;
	
	Для каждого ТекСкладОтправитель Из СЗ_CкладовОтправителей Цикл
		#Если Клиент Тогда
			//Сообщить("Обрабатывается склад: "+ТекСкладОтправитель);		 	
 		#КонецЕсли
 		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеТоваров.Ссылка КАК ПеремещениеТоваров,
