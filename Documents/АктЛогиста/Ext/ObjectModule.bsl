Процедура СМГ_СформироватьДвиженияПартийТоваровДляУчета()

 	Если Не Контрагент.НашаФирма Тогда
		
		Если Дата >= Дата(2019,4,24) ИЛИ ЭтоНовый() Тогда
			
 			Движения.ПартииТоваровДляУчета.Очистить();
			Движения.Записать();
			
			ТЗ_товаров = Новый ТаблицаЗначений;
			ТЗ_товаров = ПолучитьТаблицуТоваров();
 			
			СЗ_Товаров = Новый СписокЗначений;
			
			СЗ_Товаров.ЗагрузитьЗначения(Ссылка.Товары.ВыгрузитьКолонку("Номенклатура"));
			
			ТЗ_партий = Новый ТаблицаЗначений;
			ТЗ_партий = ПолучитьТаблицуОстатковПартий(СЗ_Товаров);
 			
			ТЗ_ТоварыДока = Товары.Выгрузить();
			ТЗ_ТоварыДока.Свернуть("Номенклатура","КоличествоБазовое");
			
			Для Каждого ТекСтрокаТовары Из ТЗ_ТоварыДока Цикл
				
 				Если ТекСтрокаТовары.Номенклатура.ВидНоменклатуры <> Перечисления.ВидыНоменклатуры.Товар Тогда
					Продолжить;
				КонецЕсли; 
 				
				ТекНоменклатура = ТекСтрокаТовары.Номенклатура; 
				ТребуетсяКол = ТекСтрокаТовары.КоличествоБазовое;
				
				Отбор = Новый Структура;
				Отбор.Вставить("Номенклатура",ТекНоменклатура);
				
				НайдСтроки = ТЗ_партий.НайтиСтроки(Отбор);
				
				ВсегоВналичии = 0;
				Для Каждого СтрокаМассива Из НайдСтроки Цикл
					ВсегоВналичии = ВсегоВналичии + СтрокаМассива.КоличествоОстаток;
				КонецЦикла;
				
				Если ТребуетсяКол > ВсегоВналичии Тогда
					Сообщить("Номенклатуры ["+ТекНоменклатура.Артикул+"] "+ТекНоменклатура+" cписывается по регистру 'Товары для учета'"+ТребуетсяКол+", а в наличии по этому регистру "+ВсегоВналичии);	
					Продолжить;
					//Отказ = Истина;
					//Возврат;
				КонецЕсли;	
				
				Для каждого Эл из НайдСтроки Цикл
					Движение = Движения.ПартииТоваровДляУчета.Добавить();
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
					Движение.Период = Дата;
					Движение.ДокументПродажи = Ссылка;
					Движение.Официально = Эл.Официально;
					Движение.Партия = Эл.Партия;
					Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
					Движение.ХозОперация = ХозОперация;
					Движение.ДилерскийЦентр = Эл.Партия.ПодразделениеКомпании.ДилерскийЦентр;
 					Движение.ДилерскийЦентрПродажи = ЭтотОбъект.ПодразделениеКомпании.ДилерскийЦентр;
 					Движение.Количество = Мин(ТребуетсяКол,Эл.КоличествоОстаток);
					Движение.Производитель = ТекСтрокаТовары.Номенклатура.Производитель;
					Если ТребуетсяКол >= Эл.КоличествоОстаток Тогда
						Движение.Сумма = Эл.СуммаОстаток;
					Иначе
						Если Эл.КоличествоОстаток > 0 Тогда
							Движение.Сумма = Эл.СуммаОстаток*Движение.Количество/Эл.КоличествоОстаток;
						Иначе
							Движение.Сумма = 0;	
						КонецЕсли;
					КонецЕсли;
					ТребуетсяКол = ТребуетсяКол - Движение.Количество;
					Если ТребуетсяКол <= 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли; 
	КонецЕсли;
  
КонецПроцедуры

