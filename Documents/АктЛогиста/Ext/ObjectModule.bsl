Функция ПолучитьТаблицуТоваров()
	
	ТекстЗапроса="ВЫБРАТЬ
	             |	СписаниеТоваровТовары.Номенклатура КАК Номенклатура,
	             |	СписаниеТоваровТовары.Количество * СписаниеТоваровТовары.Коэффициент КАК Количество
	             |ИЗ
	             |	Документ.РеализацияТоваров.Товары КАК СписаниеТоваровТовары
	             |ГДЕ
	             |	СписаниеТоваровТовары.Ссылка = &Ссылка";

	Запрос=Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.Текст=ТекстЗапроса;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуОстатковПартий(СЗ_Товаров)
	
	ТекстЗапроса="ВЫБРАТЬ
	             |	ПартииТоваровДляУчета.Номенклатура КАК Номенклатура,
	             |	ПартииТоваровДляУчета.Партия КАК Партия,
	             |	ПартииТоваровДляУчета.КоличествоОстаток КАК КоличествоОстаток,
	             |	ПартииТоваровДляУчета.СуммаОстаток КАК СуммаОстаток,
	             |	ПартииТоваровДляУчета.Партия.Дата КАК ПартияДата,
	             |	ПартииТоваровДляУчета.Официально
	             |ИЗ
	             |	РегистрНакопления.ПартииТоваровДляУчета.Остатки(&МоментВремени, Номенклатура В (&ВыбСписокНоменклатура)) КАК ПартииТоваровДляУчета
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ПартияДата";

	Запрос=Новый Запрос();
	Запрос.УстановитьПараметр("МоментВремени",?(обЗначениеНеЗаполнено(Ссылка.Дата),ТекущаяДата(),Ссылка.Дата));
 	Запрос.УстановитьПараметр("ВыбСписокНоменклатура",СЗ_Товаров);
	Запрос.Текст=ТекстЗапроса;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
