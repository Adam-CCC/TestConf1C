Процедура ЗаполнитьОстаткамиЗаказовКонтрагента() Экспорт
	
	СписокСкладов = Новый СписокЗначений;
	
 	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладыКомпании.Ссылка КАК Склад,
		|	СкладыКомпании.ЭтоГруппа,
		|	СкладыКомпании.Подразделение,
		|	СкладыКомпании.ВидСклада,
		|	СкладыКомпании.Основной,
		|	СкладыКомпании.ТипСклада
		|ИЗ
		|	Справочник.СкладыКомпании КАК СкладыКомпании
		|ГДЕ
		|	СкладыКомпании.ЭтоГруппа = ЛОЖЬ
		|	И СкладыКомпании.ВидСклада = &ВидСклада
		|	И СкладыКомпании.Основной = ИСТИНА
		|	И СкладыКомпании.ТипСклада В(&ТипСклада)
		|	И СкладыКомпании.Подразделение.Родитель = &Родитель";
	
	СЗ_ТиповСкладов = Новый СписокЗначений;
	СЗ_ТиповСкладов.Добавить(Перечисления.ТипыСкладов.Экспедитор);
	СЗ_ТиповСкладов.Добавить(Перечисления.ТипыСкладов.ЗапЧасти);
	
	Запрос.УстановитьПараметр("ВидСклада", Перечисления.ВидыСкладов.Обычный);
	Запрос.УстановитьПараметр("Родитель", ПодразделениеКомпании.Родитель);
	Запрос.УстановитьПараметр("ТипСклада",СЗ_ТиповСкладов);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если обПраво("ДоступКЗначимымОбработкам") Тогда
		ТЗ.ВыбратьСтроку("Это список складов в количестве: "+ТЗ.Количество());
 	КонецЕсли; 
 	СписокСкладов.ЗагрузитьЗначения(ТЗ.ВыгрузитьКолонку("Склад"));
	
 	Если Ссылка.Пустая() Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЗаказыПокупателейОстатки.Номенклатура,
		                      |	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
		                      |	СУММА(ЗаказыПокупателейОстатки.СуммаОстаток) КАК Сумма,
		                      |	СУММА(ЗаказыПокупателейОстатки.ЗаказаноОстаток) КАК Количество
		                      |ИЗ
		                      |	РегистрНакопления.ЗаказыПокупателей.Остатки(, Контрагент = &Контрагент) КАК ЗаказыПокупателейОстатки
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	ЗаказыПокупателейОстатки.Номенклатура,
		                      |	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры");
		
	Иначе
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ЗаказыПокупателейОстатки.Номенклатура,
		                      |	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры,
		                      |	СУММА(ЗаказыПокупателейОстатки.СуммаОстаток) КАК Сумма,
		                      |	СУММА(ЗаказыПокупателейОстатки.ЗаказаноОстаток) КАК Количество
		                      |ИЗ
		                      |	РегистрНакопления.ЗаказыПокупателей.Остатки(&НаМомент, Контрагент = &Контрагент) КАК ЗаказыПокупателейОстатки
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	ЗаказыПокупателейОстатки.Номенклатура,
		                      |	ЗаказыПокупателейОстатки.ХарактеристикаНоменклатуры");
		Запрос.УстановитьПараметр("НаМомент",МоментВремени());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
 	
	ТЗ_ОстатковЗаказов = Запрос.Выполнить().Выгрузить();
	Если обПраво("ДоступКЗначимымОбработкам") Тогда
		ТЗ_ОстатковЗаказов.ВыбратьСтроку("Это свёрнутая таблица всех заказов контрагента:"+Контрагент+", строк: "+ТЗ_ОстатковЗаказов.Количество());
	КонецЕсли;	
	
	СписокТоваровЗаказов = Новый СписокЗначений;
	СписокТоваровЗаказов.ЗагрузитьЗначения(ТЗ_ОстатковЗаказов.ВыгрузитьКолонку("Номенклатура"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура,
