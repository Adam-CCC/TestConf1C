//Бондаренко++ 20220422 
//Организации Мкртчян запрещено пререпродавать товары нашим фирмам в том числе и через механизм автоматических перепродаж.
Функция СМГ_ЗапретПерепродажОтМкртчян()
	
	ФлагОтказ = Ложь;
	
	Для каждого Стр Из Товары Цикл
		Если Стр.СкладКомпании.Организация.ИНН = "616714023180" Тогда
			// т.е. организацией является Мкртчян К.А. ИП        
			Если Стр.СкладКомпании.Организация<>Организация Тогда 
				ФлагОтказ = Истина;
				#Если НаКлиенте Тогда
					Сообщить("Ошибка! Организации <"+Стр.СкладКомпании.Организация+"> запрещено перепродавать товары контрагенту <"+Организация.КонтрагентОрганизации+">",СтатусСообщения.ОченьВажное);
				#КонецЕсли 	
 				Прервать; 
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат ФлагОтказ;
	
КонецФункции // СМГ_ЗапретПерепродажОтМкртчян() 

//Запрет заполненности колонки СкладКомпании в табличной части Товары
Функция СМГ_ПроверитьПотребностьВВыполненииПерепродаж()
	
	ФлагОтказ = Ложь;
	
	Если Контрагент.НашаФирма И ХозОперация = Справочники.ХозОперации.РеализацияТоваров Тогда
		Для каждого стр Из Товары Цикл
			Если НЕ обЗначениеНеЗаполнено(стр.СкладКомпании) Тогда
				ФлагОтказ = Истина;
				#Если НаКлиенте Тогда
				Сообщить("ОШИБКА! При наличии складов в табличной части 'Товары' проведение выполняется только через кнопку 'Перепродажи'. "+Формат(ТекущаяДата(),"ДЛФ=T"), СтатусСообщения.ОченьВажное);
				#КонецЕсли 	
				Прервать; 
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли;	 
	
	Возврат ФлагОтказ; 
	
КонецФункции // СМГ_ПроверкаСкладовВТаблицеТовары(РежимЗаписи)

 //Для типа цен Уценка проверяется заполненность этой цены у каждой номенклатцры и, кроме того, чтобы цена в строке не оказалась ниже.
Функция СМГ_ПроверкаТоваровПоЦенамУценки()
	
	ФлагОтказ = Ложь;
	
 	Если ХозОперация = Справочники.ХозОперации.РеализацияТоваров И ТипЦен = Справочники.ТипыЦен.ЦенаУценки Тогда
		ФлагОбнаруженыСуммыНижеЦеныУценки = Ложь;
		ТекстОшибки = "";
		Для каждого ТекСтрока Из Товары Цикл
			ЦенаУценки = 0;
			ЦенаУценки = обПолучитьЦену(ТипЦен,ТекСтрока.Номенклатура,,,ЭтотОбъект.ВалютаДокумента,ЭтотОбъект.КурсДокумента,,ТекСтрока.ЕдиницаИзмерения,Справочники.ПодразделенияКомпании.ОсновноеПодразделение);
			Если ЦенаУценки = 0 Тогда
				ФлагОтказ = Истина;
				#Если НаКлиенте Тогда
				Сообщить("ОШИБКА! Для номенклатуры ["+ТекСтрока.Номенклатура.Артикул + "]"+ТекСтрока.Номенклатура+"не задана цена уценки. Проведение документа прервано.", СтатусСообщения.ОченьВажное);
				#КонецЕсли 	
				Прервать;
			КонецЕсли; 
			Если ТекСтрока.Цена < ЦенаУценки Тогда
				Если ФлагОбнаруженыСуммыНижеЦеныУценки Тогда
					ТекстОшибки = СокрЛП(ТекстОшибки)+", "+СокрЛП(ТекСтрока.НомерСтроки);
				Иначе
					ТекстОшибки = СокрЛП(ТекСтрока.НомерСтроки);
					ФлагОбнаруженыСуммыНижеЦеныУценки = Истина;
				КонецЕсли; 
			КонецЕсли; 
		КонецЦикла;
		Если ФлагОбнаруженыСуммыНижеЦеныУценки Тогда
			ФлагОтказ = Истина;
			#Если НаКлиенте Тогда
			Сообщить("ОШИБКА! В табличной части 'Товары' обнаружены цены ниже уценки. Номера строк:  " + ТекстОшибки + ". Проведение документа прервано.", СтатусСообщения.ОченьВажное);
			#КонецЕсли 	
 		КонецЕсли;			
	КонецЕсли;
	
	Возврат ФлагОтказ;
	
КонецФункции // СМГ_ПроверкаТоваровПоЦенамУценки(РежимЗаписи)
