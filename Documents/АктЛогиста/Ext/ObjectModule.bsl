Функция СМГ_ПроверитьКорректность(Результат,Ошибки)

 	// Проверим ТЧ на наличие НДС для ХозОперации "РеализацияТоваров"
	Если Результат И ХозОперация = Справочники.ХозОперации.РеализацияТоваров И Не Организация.ОсвобожденОтНДС И (Контрагент.Код<>"ЦБ003307") Тогда
		МассивСтрок = Новый Массив;
		НомераСтрок = " ";
		Флаг = Ложь;
		Для Каждого ТекСтрока Из ЭтотОбъект.Товары Цикл
			Если ТекСтрока.СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
				НомераСтрок = НомераСтрок + ?(НомераСтрок = " ", " ", ", " ) + ТекСтрока.НомерСтроки;
				Флаг = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Флаг Тогда
			стрОшибка = "Для организации <" + Организация + "> не должно быть строк без НДС в табличной части. Номера строк без НДС:" + НомераСтрок;
			дкДобавитьОшибку(Ошибки, стрОшибка);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // СМГ_ПроверитьКорректность(Результат)

Процедура СМГ_ПечатьАдресаЗаказа(ТабДокумент,Макет)

 		АдресПеч = "";
		Запрос = Новый Запрос; 
		Запрос.Текст =     
		"ВЫБРАТЬ
		|	ЗаказыПокупателей.Период,
		|	ЗаказыПокупателей.Регистратор,
		|	ЗаказыПокупателей.Заказ
		|ИЗ
		|	РегистрНакопления.ЗаказыПокупателей КАК ЗаказыПокупателей
		|ГДЕ
		|	ЗаказыПокупателей.Регистратор = &Регистратор"; 
		
		Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Если ТЗ.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			
			Запрос.Текст = 
			
			"ВЫБРАТЬ
			|	АдресаХраненияЗаказовПокупателейСрезПоследних.ЯчейкаХранения,
			|	АдресаХраненияЗаказовПокупателейСрезПоследних.ЗаказПокупателя
			|ИЗ
			|	РегистрСведений.АдресаХраненияЗаказовПокупателей.СрезПоследних КАК АдресаХраненияЗаказовПокупателейСрезПоследних
			|ГДЕ
			|	АдресаХраненияЗаказовПокупателейСрезПоследних.ЗаказПокупателя = &ВыбЗаказ";
			
			Запрос.УстановитьПараметр("ВыбЗаказ", ТЗ[0].Заказ);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				АдресПеч = ВыборкаДетальныеЗаписи.ЯчейкаХранения;
 			КонецЦикла;
			
		КонецЕсли; 
		
		Если СокрЛП(АдресПеч) <> "" Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("Адрес");
			ОбластьМакета.Параметры.АдресПеч = АдресПеч;
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЕсли; 
		//Бондаренко-- 20171005
 
КонецПроцедуры

