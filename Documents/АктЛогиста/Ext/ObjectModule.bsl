Процедура СМГ_СоздатьИлиОбновитьСФВыданный()
	
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
 	КонецЕсли;
	
	СФ_выданный = Неопределено;
	
	Если СуммаНДС > 0 Тогда
		СФ_выданный = Документы.СчетФактураВыданный.СоздатьДокумент(); 
		СФ_выданный.Комментарий = "Автоматически создан "+СокрЛП(ТекущаяДата());
 	КонецЕсли;
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК СФ,
	|	СчетФактураВыданный.ДокументОснование,
	|	СчетФактураВыданный.Проведен
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ЭтотОбъект.Ссылка);
 	 
 	Результат = Запрос.Выполнить();		
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СФ_выданный = ВыборкаДетальныеЗаписи.СФ.ПолучитьОбъект();
		//Бондаренко++ 2023207
		Если СФ_выданный.ДоговорВзаиморасчетов <> ЭтотОбъект.ДоговорВзаиморасчетов Тогда
			Попытка
				СФ_выданный.Контрагент = ЭтотОбъект.Контрагент;
				СФ_выданный.ДоговорВзаиморасчетов = ЭтотОбъект.ДоговорВзаиморасчетов;
				СФ_выданный.Грузополучатель = ЭтотОбъект.Контрагент;
				СФ_выданный.Записать(РежимЗаписиДокумента.Запись);
			Исключение
	 		КонецПопытки;
		КонецЕсли;            
		//Бондаренко-- 2023207
  		Прервать;
	КонецЦикла; 
	
	Если СФ_выданный = Неопределено Тогда
		// Так как "СуммаНДС" равна нулю и старый счет-фактура выданный не найден
		Возврат;
 	КонецЕсли;
 	
	СФ_выданный.Заполнить(ЭтотОбъект.Ссылка);
 	СФ_выданный.Дата = ЭтотОбъект.Дата;      
	СФ_выданный.Номер = ЭтотОбъект.Номер;      				
 	
	ФлЭтотОбъектПроведен = ЭтотОбъект.Проведен;
	ФлЭтотОбъектПометкаУдаления = ЭтотОбъект.ПометкаУдаления;
	
	СФ_выданный.Проведен = ФлЭтотОбъектПроведен;			
	СФ_выданный.ПометкаУдаления = ФлЭтотОбъектПометкаУдаления;
	
	Если ФлЭтотОбъектПометкаУдаления Тогда               
		Попытка СФ_выданный.Записать(РежимЗаписиДокумента.Запись); Исключение КонецПопытки; 
	Иначе                                                           
		Если ФлЭтотОбъектПроведен Тогда
			Попытка СФ_выданный.Записать(РежимЗаписиДокумента.Проведение); Исключение КонецПопытки; 					
		Иначе
			Попытка СФ_выданный.Записать(РежимЗаписиДокумента.ОтменаПроведения); Исключение КонецПопытки; 					
		КонецЕсли; 
	КонецЕсли;
 	
КонецПроцедуры //СМГ_СоздатьИлиОбновитьСФВыданный()
