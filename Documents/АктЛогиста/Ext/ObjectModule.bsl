		|	СУММА(ОстаткиТоваровКомпанииОстатки.КоличествоОстаток) КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки КАК ОстаткиТоваровКомпанииОстатки
		|ГДЕ
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура В (&СпНоменклатуры)
		|	И ОстаткиТоваровКомпанииОстатки.СкладКомпании В (&СпСкладовКомпании)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТоваровКомпанииОстатки.СкладКомпании,
		|	ОстаткиТоваровКомпанииОстатки.Номенклатура";
	
	Запрос.УстановитьПараметр("СпНоменклатуры", СписокТоваровЗаказов);
	Запрос.УстановитьПараметр("СпСкладовКомпании", СписокСкладов);
	
	ТЗ_ОстатковНоменклатуры = Запрос.Выполнить().Выгрузить();
	Если обПраво("ДоступКЗначимымОбработкам") Тогда
		ТЗ_ОстатковНоменклатуры.ВыбратьСтроку("Это свёрнутая таблица всех остатков товаров на экспедиторских складах:"+СписокСкладов+", строк: "+ТЗ_ОстатковНоменклатуры.Количество());
	КонецЕсли;	
	
	ВалютаУпр = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	КурсВалютыУпр = 1;
	
	Для Каждого ТекСтрокаТовары Из ТЗ_ОстатковЗаказов Цикл
		
		ТекНоменклатура = ТекСтрокаТовары.Номенклатура; 
		ТребуетсяКол = ТекСтрокаТовары.Количество;
		ТекЦена = 0;
		Если ТребуетсяКол > 0 Тогда
			ТекЦена = ТекСтрокаТовары.Сумма/ТребуетсяКол;
 		КонецЕсли; 
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура",ТекНоменклатура);
		
		НайдСтроки = ТЗ_ОстатковНоменклатуры.НайтиСтроки(Отбор);
		
		ВсегоВналичии = 0;
		Для Каждого СтрокаМассива Из НайдСтроки Цикл
			ВсегоВналичии = ВсегоВналичии + СтрокаМассива.КоличествоОстаток;
		КонецЦикла;
		
		Если ВсегоВналичии = 0 Тогда
 			Продолжить;
 		КонецЕсли;	
		
		Для каждого Эл из НайдСтроки Цикл
			НоваяСтрока=Товары.Добавить();
 			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
			НоваяСтрока.СкладКомпании = Эл.СкладКомпании;
			НоваяСтрока.Количество = Мин(ТребуетсяКол,Эл.Количествоостаток);
			НоваяСтрока.КоличествоБазовое = НоваяСтрока.Количество;
			ТребуетсяКол = ТребуетсяКол - НоваяСтрока.Количество;
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТовары.Номенклатура.ОсновнаяЕдиницаИзмерения;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.Отметка = Истина;
			НоваяСтрока.Цена = ТекЦена; 
			НоваяСтрока.СуммаВсего = НоваяСтрока.Цена*НоваяСтрока.Количество*НоваяСтрока.Коэффициент;
			НоваяСтрока.СуммаВсего = обПересчет(НоваяСтрока.СуммаВсего, ВалютаУпр, КурсВалютыУпр, ВалютаДокумента, КурсДокумента);
			ОбработкаРеквизита("Товары.СуммаВсего", НоваяСтрока);
 			//НоваяСтрока.АйДи = НайтиСписокАйДи(НоваяСтрока.Заказ,НоваяСтрока.Номенклатура);
 			Если ТребуетсяКол <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;

	
	//Возврат;
