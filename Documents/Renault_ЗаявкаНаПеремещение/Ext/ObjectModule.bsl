Перем СтараяДата;
Перем Ответственный;
Перем РабочиеОтметки;


Процедура ПриЗаписи(Отказ)
	
	РабочиеОтметки = Неопределено;
	НаборЗаписей = РегистрыСведений.ПланПеремещений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДатаПлан.Установить(СтараяДата);
	
	НаборЗаписей.Прочитать();
	Для каждого запись из НаборЗаписей цикл
		РабочиеОтметки = запись.РабочиеОтметки;
	КонецЦикла;
	
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
	
	НаборЗаписей = РегистрыСведений.ПланПеремещений.СоздатьНаборЗаписей();
	текДатаПоступления = ДатаПоступления + (ВремяПоступления - Дата('00010101'));
	НаборЗаписей.Отбор.ДатаПлан.Установить(текДатаПоступления);
	
	НоваяСтрока = НаборЗаписей.Добавить();
	НоваяСтрока.ДатаПлан = текДатаПоступления;
	НоваяСтрока.Автомобиль = Автомобиль;
	НоваяСтрока.Контрагент = Контрагент;
	НоваяСтрока.ДатаЗаписи = Дата;
	НоваяСтрока.Комментарий = Комментарий;
	НоваяСтрока.Продавец = Продавец;
	НоваяСтрока.Ответственный = Продавец;
	НоваяСтрока.СкладОтправитель = Маршрут.СкладОтправитель;
	НоваяСтрока.СкладПолучатель = Маршрут.СкладПолучатель;
	НоваяСтрока.ЗаявкаНаПеремещение = Ссылка;
	НоваяСтрока.РабочиеОтметки = РабочиеОтметки;
	НоваяСтрока.ДопОборудование = ДО;
	НаборЗаписей.Записать();
	
	Если СтараяДата <> текДатаПоступления И НЕ СтараяДата = Дата(1,1,1) Тогда
		
		//делаем запись в регистр "История переносов заявок на перемещение"
		ЗаписатьИсториюПереносовЗаявки(СтараяДата, текДатаПоступления, Ответственный);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	СтараяДата = Ссылка.ДатаПоступления + (Ссылка.ВремяПоступления - Дата('00010101'));
	Ответственный = Ссылка.Продавец;
	
КонецПроцедуры

Процедура ПеренестиЗаявку(ТекСтрока, НовоеВремяЗаписи) Экспорт
	
	СтараяДатаЗаписи = ДатаПоступления;
	СтароеВремяЗаписи = ВремяПоступления;
	
	НачатьТранзакцию();
	ТекстСообщения = "";
	Попытка
		ДатаПоступления = Дата(Год(НовоеВремяЗаписи.ДатаВремяПеремещения),Месяц(НовоеВремяЗаписи.ДатаВремяПеремещения),День(НовоеВремяЗаписи.ДатаВремяПеремещения));
		ВремяПоступления = Дата(1,1,1,Час(НовоеВремяЗаписи.ДатаВремяПеремещения),Минута(НовоеВремяЗаписи.ДатаВремяПеремещения),Секунда(НовоеВремяЗаписи.ДатаВремяПеремещения));
		Записать();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = "Не удалось создать новую запись в журнале по причине:
		|" + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
		ТекстСообщения = "Заявка № " + Номер + " перенесена с " + Формат(СтароеВремяЗаписи, "ДФ=ЧЧ:мм") + Формат(СтараяДатаЗаписи, "ДФ='dd MMMM yyyy ""г.""'") + 
						" на " + Формат(ВремяПоступления, "ДФ=ЧЧ:мм") + " " + Формат(ДатаПоступления, "ДФ='dd MMMM yyyy ""г.""'");
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьИнформациюПользователю(ТекстСообщения);
	
КонецПроцедуры

Процедура ИзменитьЗаявкуИзПланаПеремещений(ДопОборудование) Экспорт
	
	НачатьТранзакцию();
	ТекстСообщения = "";
	Попытка
		ДО = ДопОборудование;
		Записать();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = "Не удалось создать новую запись в журнале по причине:
		|" + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьИнформациюПользователю(ТекстСообщения);
	
КонецПроцедуры

Процедура ЗаписатьИсториюПереносовЗаявки(СтараяДатаЗаписи, НовоеВремяЗаписи, Ответственный) Экспорт
	
	ЗаписьИсторияПереносов = РегистрыСведений.Renault_ИсторияПереносовЗаявокНаПеремещение.СоздатьМенеджерЗаписи();
	ЗаписьИсторияПереносов.ЗаявкаНаПеремещение = Ссылка;
	ЗаписьИсторияПереносов.СтараяДатаПередачи = СтараяДатаЗаписи;
	ЗаписьИсторияПереносов.НоваяДатаПередачи = НовоеВремяЗаписи;
	ЗаписьИсторияПереносов.ОтветственныйЗаПеренос = ПараметрыСеанса.ТекущийПользователь;
	ЗаписьИсторияПереносов.Продавец = Ответственный;
	ЗаписьИсторияПереносов.Период = ТекущаяДата();
	ЗаписьИсторияПереносов.Записать();
	
КонецПроцедуры

