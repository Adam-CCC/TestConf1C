КонецПроцедуры

Процедура ПроверитьПустыеРаботы()
	
	Для Каждого Этап Из Этапы Цикл 
		Если Этап.НачалоЭтапа = Этап.КонецЭтапа Тогда 
			ВызватьИсключение("Не найдено слотов под онлайн запись");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтруктуруТаблицПоКС(МассивКС,ДилерскийЦентр)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Работа");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Нормочас");
	Результат.Колонки.Добавить("Цена",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));
	Результат.Колонки.Добавить("Количество");
	Результат.Колонки.Добавить("ДлительностьЗН");
	Результат.Колонки.Добавить("Длительность");
	Результат.Колонки.Добавить("Стоимость",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10,2)));

	
	ОбработкаКС = Обработки.Renault_ПодборКомплексСервисов.Создать();
	ТабАвтоработы = Работы;
	ТабЗапчасти = Товары;
	
	СуммаРабот = 0;
	Для Каждого Элем Из МассивКС Цикл
		Результат.Очистить();
		Данные = ОбработкаКС.ЗаполнитьСоставПоКомплексу(Элем,Результат,ДилерскийЦентр);
		
		Для каждого ТекСтрока из Данные Цикл
			Если ЗначениеЗаполнено(ТекСтрока.Работа) Тогда
				СуммаРабот = ТекСтрока.Цена;
				
				НоваяСтрокаРабота = ТабАвтоработы.Добавить();
				НоваяСтрокаРабота.Коэффициент = ПолучитьКоэффициентСложностиРаботы(ТекСтрока.Работа, ДилерскийЦентр.Автосервис_ВидРемонтаПоУмолчанию);
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРабота, ТекСтрока);
				НоваяСтрокаРабота.Нормочас = ДилерскийЦентр.Автосервис_Нормочас;
				//+++Уберем ошибку с делением на 0
				Если НоваяСтрокаРабота.Длительность <> 0 Тогда
					НоваяСтрокаРабота.Цена = НоваяСтрокаРабота.Сумма / НоваяСтрокаРабота.Длительность;
				КонецЕсли;
				//
				НоваяСтрокаРабота.Сумма = ТекСтрока.Стоимость;
			ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
				НоваяСтрока = ТабЗапчасти.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.Сумма = ТекСтрока.Стоимость;
				
			//DMSREN-975+
				НоваяСтрока.Цена = обПолучитьЦену(ДилерскийЦентр.Автосервис_ТипЦенПродажи, ТекСтрока.Номенклатура,,,,,,,ПараметрыСеанса.ПодразделениеКомпании); // DMSREN-1053
				НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
				СуммаРабот = СуммаРабот - НоваяСтрока.Сумма;
				
				//DMSREN-1006 -> DMSREN-1177
				//ОстатокНаСкладе = Renault_АвтосервисОбщий.Renault_ПроверитьОстатокНаСкладе(ТекСтрока.Номенклатура, ДилерскийЦентр.Автосервис_СкладПоУмолчанию);
				//Если НоваяСтрока.Количество>ОстатокНаСкладе Тогда 
				//	ВызватьИсключение("На складе нет необходимого количества "+ТекСтрока.Номенклатура);
				//КонецЕсли;
				//---
			КонецЕсли;
			
			Если НоваяСтрокаРабота.Длительность <> 0 Тогда
				НоваяСтрокаРабота.Цена = СуммаРабот / НоваяСтрокаРабота.Длительность;
			КонецЕсли;
			НоваяСтрокаРабота.Сумма = СуммаРабот;
			//DMSREN-975-	
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Работы,Запчасти",ТабАвтоработы,ТабЗапчасти);
	
КонецФункции

Функция СоздатьОбращение(ПараметрыОбращения) Экспорт
	
	Обращение = Документы.Renault_CRM_ОбращениеВАвтоСервис.СоздатьДокумент();
	Обращение.Дата					= ТекущаяДата();
	Обращение.ДилерскийЦентр 		= ПараметрыОбращения.ДилерскийЦентр;
	
	Обращение.Клиент 				= ПараметрыОбращения.Клиент;
	Обращение.ВидОбращения 			= ПараметрыОбращения.ВидОбращения;
	Обращение.Примечание 			= ПараметрыОбращения.Примечание;
	Обращение.Автомобиль 			= ПараметрыОбращения.ТекущийАвтомобиль;
	Обращение.Автор					= ПараметрыОбращения.Автор;
	Обращение.ХозОперация 			= Справочники.ХозОперации.ПрочиеДокументы;
	Обращение.ПервичныйПовторный	= Перечисления.CRM_ПервичныйПовторный.Первичный;
	Обращение.ДокументОнлайнЗаписи	= ПараметрыОбращения.Онлайн;
	Обращение.ОбращениеОбработано	= Истина;
	Обращение.ПроверенВICM			= Ложь;
	
	Попытка	
		Обращение.Записать(РежимЗаписиДокумента.Запись);		
		ОбращениеСсылка = Обращение.Ссылка;
	Исключение
		
	КонецПопытки; 	
	
	Возврат Обращение;
КонецФункции

Функция НайтиСоздатьКлиента(ПараметрыКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.Объект КАК Клиент,
		|	КонтактнаяИнформация.Тип КАК Тип,
		|	КонтактнаяИнформация.Вид КАК Вид,
		|	КонтактнаяИнформация.Представление КАК представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Представление ПОДОБНО &телефон
		|	И (ТИПЗНАЧЕНИЯ(КонтактнаяИнформация.Объект) = ТИП(справочник.CRM_ПотенциальныеКонтрагенты)
		|			ИЛИ ТИПЗНАЧЕНИЯ(КонтактнаяИнформация.Объект) = ТИП(справочник.Контрагенты))";
	
	Запрос.УстановитьПараметр("телефон", ПараметрыКлиента.Телефон);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Клиент;
	КонецЦикла;

	//если в базе нету, то создадим потенциального клиента
	НовыйКонтрагент = Справочники.CRM_ПотенциальныеКонтрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Фамилия = ПараметрыКлиента.Фамилия;	
	НовыйКонтрагент.Имя = ПараметрыКлиента.Имя; 
	НовыйКонтрагент.ФормаСобственности = перечисления.ФормыСобственности.ЧастноеЛицо;
	НовыйКонтрагент.Наименование = СокрЛП(НовыйКонтрагент.Фамилия) + ?(ПустаяСтрока(СокрЛП(НовыйКонтрагент.Имя)),""," " + СокрЛП(НовыйКонтрагент.Имя)) + ?(ПустаяСтрока(СокрЛП(НовыйКонтрагент.Отчество)),""," " + СокрЛП(НовыйКонтрагент.Отчество));
	
	Если ПустаяСтрока(НовыйКонтрагент.НаименованиеПолное) Тогда
		НовыйКонтрагент.НаименованиеПолное = СокрЛП(НовыйКонтрагент.Наименование);
	КонецЕсли; 

	
	НовыйКонтрагент.Записать();
	
	Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	Менеджер.Объект = НовыйКонтрагент.Ссылка;
	Менеджер.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
	Менеджер.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонСотовый;
	Если ЗначениеЗаполнено(ПараметрыКлиента.Телефон) Тогда
		Менеджер.Представление = ПараметрыКлиента.Телефон;
		Менеджер.ЗначениеПоУмолчанию = Истина;
		Менеджер.Записать(Истина);
	Иначе
		Менеджер.Удалить();
	КонецЕсли;

	Менеджер = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	Менеджер.Объект = НовыйКонтрагент.Ссылка;
	Менеджер.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	Менеджер.Вид = Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний;
	Если ЗначениеЗаполнено(ПараметрыКлиента.Почта) Тогда
		Менеджер.Представление = ПараметрыКлиента.Почта;
		Менеджер.ЗначениеПоУмолчанию = Истина;
		Менеджер.Записать(Истина);
	Иначе
		Менеджер.Удалить();
	КонецЕсли;
	
	Возврат НовыйКонтрагент.Ссылка;
	
КонецФункции

//Будем возвращать любого клиента для того чтобы спланировать время записи
Функция ВернутьКлиентаДляРезерва()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
	КонецЦикла;
	Возврат ВыборкаДетальныеЗаписи.Ссылка;	
	
КонецФункции

//Будем возвращать любой автомобиль для того чтобы спланировать время записи
Функция ВернутьАвтомобильДляРезерва()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Автомобили.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Автомобили КАК Автомобили
		|ГДЕ
		|	Автомобили.Модель <> ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
	КонецЦикла;
	Возврат ВыборкаДетальныеЗаписи.Ссылка;	
	
КонецФункции

Функция НайтиСоздатьАвтомобиль(ПараметрыАвтомобиля)
	
	Если ЗначениеЗаполнено(ПараметрыАвтомобиля.VIN) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автомобили.Ссылка КАК Ссылка,
		|	1 КАК Приоритет
		|ИЗ
		|	Справочник.Автомобили КАК Автомобили
		|ГДЕ
		|	Автомобили.VIN ПОДОБНО &VIN
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Renault_ЧерновикиАвтомобилей.Ссылка,
		|	2
		|ИЗ
		|	Справочник.Renault_ЧерновикиАвтомобилей КАК Renault_ЧерновикиАвтомобилей
		|ГДЕ
		|	Renault_ЧерновикиАвтомобилей.VIN ПОДОБНО &VIN
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		
		Запрос.УстановитьПараметр("VIN", ПараметрыАвтомобиля.VIN);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Возврат ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;

	КонецЕсли;
	
	НовыйАвто = Справочники.Renault_ЧерновикиАвтомобилей.СоздатьЭлемент();
