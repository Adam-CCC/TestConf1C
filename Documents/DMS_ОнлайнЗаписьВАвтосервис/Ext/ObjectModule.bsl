Функция ПолучитьКоэффициентСложностиРаботы(Авторабота, ВидРемонта = Неопределено)
	
	Если ЗначениеЗаполнено(ВидРемонта) Тогда
		
		Гарантия = РегистрыСведений.Renault_ВидыРемонтаДопРеквизиты.ПолучитьГарантиюЗавода(ВидРемонта);
		
		Если Гарантия = Истина Тогда
			
			Возврат 1;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Коэффициент = 1;
	
	Если НЕ ЗначениеЗаполнено(Авторабота.Артикул) Тогда
		Возврат Коэффициент;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Справочник.Коэффициент
	|ИЗ
	|	РегистрСведений.OPERACODE_НормыРабот.СрезПоследних(&Период, КодПоКаталогу = &Артикул) КАК OPERACODE_НормыРаботСрезПоследних
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_КоэффициентыСложностиРабот КАК Справочник
	|ПО Справочник.СложностьРабот = OPERACODE_НормыРаботСрезПоследних.СложностьРабот";
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Артикул", Авторабота.Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Коэффициент = Выборка.Коэффициент;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Коэффициент) Тогда
		
		Возврат Коэффициент;
		
	Иначе
		
		Возврат 1;
		
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьДокументПланированием(Планирование)
	
	Приемка = Планирование.Приемка;
	Заявка = Планирование.Заявка;
	Выдача = Планирование.Выдача;
	
	ПриемкаВремяНачала = Приемка.ВремяНачала;
	ВыдачаВремяНачала  = Выдача.ВремяНачала;
	ПриемкаВремяОкончания = Приемка.ВремяОкончания;
	ВыдачаВремяОкончания = Выдача.ВремяОкончания;
	Работы.Загрузить(Заявка.Работы.Выгрузить());
	Товары.Загрузить(Заявка.Товары.Выгрузить());
	Этапы.Загрузить(Заявка.Этапы.Выгрузить());
	
КонецПроцедуры

Процедура ЗапланироватьДаннымиДокумента(СтруктураДанных) Экспорт 
	
	ОбщиеДанные = СтруктураДанных.data;
	
	НачатьТранзакцию();
	
	ОбработкаАвтосервис = Обработки.CRM_АРМ_АвтоСервис_4.Создать();
	ОбработкаАвтосервис.ДилерскийЦентр = ДилерскийЦентр;

	СтруктураПриемки = Новый Структура;
	СтруктураПриемки.Вставить("Исполнитель",ПриемкаМашиноместо);
	СтруктураПриемки.Вставить("ВремяНачала",ПриемкаВремяНачала);
	СтруктураПриемки.Вставить("ВремяОкончания",ПриемкаВремяОкончания);
	Ошибка = ОбработкаАвтосервис.ПроверитьВремяПриемки(СтруктураПриемки);
	
	Если Ошибка Тогда
		СообщениеОшибки = "Время приемки занято";
		ОтменитьТранзакцию();
		ВызватьИсключение(СообщениеОшибки);	
	КонецЕсли;

	Комментарий =  ОбщиеДанные.Comment+Символы.ПС+ОбщиеДанные.CommentPrice;
	
	ДанныеКлиента = Новый Структура;
	ДанныеКлиента.Вставить("Фамилия",ОбщиеДанные.LastName);
	ДанныеКлиента.Вставить("Имя",ОбщиеДанные.FirstName);
	ДанныеКлиента.Вставить("Почта",ОбщиеДанные.Email);
	ДанныеКлиента.Вставить("Телефон",ОбщиеДанные.Telephone);
	Клиент = НайтиСоздатьКлиента(ДанныеКлиента);

	ДанныеАвтомобиля = Новый Структура;
	ДанныеАвтомобиля.Вставить("Кондиционер",ОбщиеДанные.ModelDesc.AirConditioner);
	ДанныеАвтомобиля.Вставить("Модель",Справочники.Модели.НайтиПоРеквизиту("Артикул",ОбщиеДанные.ModelDesc.ModelCode));
	ДанныеАвтомобиля.Вставить("Пробег",ОбщиеДанные.ModelDesc.Odometer);
	ДанныеАвтомобиля.Вставить("VIN",ОбщиеДанные.ModelDesc.VIN);
	ДанныеАвтомобиля.Вставить("ГУР","");
	ДанныеАвтомобиля.Вставить("Хозяин",Клиент);
	Автомобиль = НайтиСоздатьАвтомобиль(ДанныеАвтомобиля);          	
	
	ПараметрыОбращения = Новый Структура;
	ПараметрыОбращения.Вставить("ДилерскийЦентр",ДилерскийЦентр);
	ПараметрыОбращения.Вставить("Клиент",Клиент);
	ПараметрыОбращения.Вставить("ВидОбращения",Справочники.Renault_ВидыОбращенийВАвтосервис.ОнлайнЗапись);
	ПараметрыОбращения.Вставить("Примечание",Комментарий);
	ПараметрыОбращения.Вставить("ТекущийАвтомобиль",Автомобиль);
	ПараметрыОбращения.Вставить("Автор",ПараметрыСеанса.Пользователь);
	ПараметрыОбращения.Вставить("Онлайн",Ссылка);
	Обращение = СоздатьОбращение(ПараметрыОбращения);

	
	ПараметрыПланирования = Новый Структура;
	ПараметрыПланирования.Вставить("ДилерскийЦентр",ДилерскийЦентр);
	ПараметрыПланирования.Вставить("ОбращениеСсылка",Обращение.Ссылка);
	ПараметрыПланирования.Вставить("Автор",Автор);
	ПараметрыПланирования.Вставить("Клиент",Клиент);
	ПараметрыПланирования.Вставить("ВладелецАвтомобиля",Клиент);
	ПараметрыПланирования.Вставить("Автоработы",Работы);
	ПараметрыПланирования.Вставить("ТаблицаМатериалы",Товары);
	ПараметрыПланирования.Вставить("ИсполнительЦех",ПриемкаМашиноместо);
	ПараметрыПланирования.Вставить("ВремяНачала",ПриемкаВремяНачала);
	ПараметрыПланирования.Вставить("ДлительностьПриемки",ДилерскийЦентр.ДлительностьПриемки/60);
	ПараметрыПланирования.Вставить("ДлительностьВыдачи",ДилерскийЦентр.ДлительностьВыдачи/60);
	ПараметрыПланирования.Вставить("ВидРемонта",ДилерскийЦентр.Автосервис_ВидРемонтаПоУмолчанию);
	ПараметрыПланирования.Вставить("Нормочас",ДилерскийЦентр.Автосервис_Нормочас);
	ПараметрыПланирования.Вставить("ТипЦен",ДилерскийЦентр.Автосервис_ТипЦенПродажи);
	Планирование = ПолучитьДанныеПоПланированию(ПараметрыПланирования);
	
	Ошибка = ПроверитьДанныеСДокументом(Планирование);
	
	Если Не Ошибка Тогда
		Подтверждена = Истина;		
		ЗафиксироватьТранзакцию();
	Иначе 
		ОтменитьТранзакцию();
	КонецЕсли;
	
	// Беседин 23.11.21 заявка 1373 логирование в журнал
	Попытка
		Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ОнлайнЗапись", УровеньЖурналаРегистрации.Ошибка, ЭтотОбъект.Метаданные(),
				СокрЛП(Клиент) + "  " + СокрЛП(Автомобиль), "Невозможно запланировать данными документа");	
	КонецПопытки;
	
КонецПроцедуры

Функция ПроверитьДанныеСДокументом(Планирование)
	
	ЕстьОшибки = Ложь;
	СообщениеОшибки = "";
		
	Приемка = Планирование.Приемка;
	Заявка = Планирование.Заявка;
	Выдача = Планирование.Выдача;
	
	ПриемкаВремяНачала = Приемка.ВремяНачала;
	ВыдачаВремяНачала  = Выдача.ВремяНачала;
	ПриемкаВремяОкончания = Приемка.ВремяОкончания;
	ВыдачаВремяОкончания = Выдача.ВремяОкончания;
	Работы.Загрузить(Заявка.Работы.Выгрузить());
	Товары.Загрузить(Заявка.Товары.Выгрузить());
	Этапы.Загрузить(Заявка.Этапы.Выгрузить());
	

	
	Если ВыдачаВремяНачала <>  Выдача.ВремяНачала или ВыдачаВремяОкончания <> Выдача.ВремяОкончания Тогда 
		ЕстьОшибки = Истина;
		СообщениеОшибки = "Не совпадает время выдачи автомобиля";
	КонецЕсли;
	
	Если Этапы.Количество() <> Заявка.Этапы.Количество() Тогда 
		ЕстьОшибки = Истина;
		СообщениеОшибки = "Отличается количество этапов работ";
	Иначе
		Индекс = 0;
		Пока Индекс < Этапы.Количество() цикл 
			СтрокаЭтапа = Этапы[Индекс];
			СтрокаЭтапаНовый = Заявка.Этапы[Индекс];
			Если СтрокаЭтапа.НачалоЭтапа <> СтрокаЭтапаНовый.НачалоЭтапа
				Или СтрокаЭтапа.КонецЭтапа <> СтрокаЭтапаНовый.КонецЭтапа
				Или СтрокаЭтапа.Цех <> СтрокаЭтапаНовый.Цех Тогда 
				ЕстьОшибки = Истина;
				СообщениеОшибки = "Не совпадают данные по работам";
				Прервать;
			КонецЕсли;
			Индекс = Индекс + 1;				
		КонецЦикла;
	КонецЕсли;
	ОшибкаПланирования = СообщениеОшибки;
	Возврат ЕстьОшибки;	
	
КонецФункции






