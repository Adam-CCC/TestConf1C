	ЗаполнитьДокументПланированием(Планирование);	
	ОтменитьТранзакцию();
	
	ПроверитьПустыеРаботы();     
	
	// Беседин 23.11.21 заявка 1373 логирование ошибок
	Попытка
		Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ОнлайнЗапись", УровеньЖурналаРегистрации.Ошибка, "Документ.ОнлайнЗаписьВАвтосервис",
				СокрЛП(Клиент) + " " + СокрЛП(Автомобиль), ОписаниеОшибки());			
