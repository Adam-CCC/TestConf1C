
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.Renault_ОстаткиПТС.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_СписаниеПТС.ПТС,
		|	Renault_СписаниеПТС.Ссылка.СкладКомпании,
		|	ЕСТЬNULL(Renault_ОстаткиПТСОстатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	Документ.Renault_СписаниеПТС.Состав КАК Renault_СписаниеПТС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Renault_ОстаткиПТС.Остатки(&МоментВремени, ) КАК Renault_ОстаткиПТСОстатки
		|		ПО Renault_СписаниеПТС.ПТС = Renault_ОстаткиПТСОстатки.ПТС
		|			И Renault_СписаниеПТС.Ссылка.СкладКомпании = Renault_ОстаткиПТСОстатки.Склад
		|ГДЕ
		|	Renault_СписаниеПТС.Ссылка = &Ссылка
		|	И ЕСТЬNULL(Renault_ОстаткиПТСОстатки.КоличествоОстаток, 0) <= 0";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Сообщить("Нет на складе "+ Выборка.ПТС);
		Отказ = Истина;
	КонецЦикла;

	Для Каждого ТекСтрокаСостав Из Состав Цикл
		Движение = Движения.Renault_ОстаткиПТС.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Склад = СкладКомпании;
		Движение.ПТС = ТекСтрокаСостав.ПТС;
		Движение.Количество = 1;
	КонецЦикла;

КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	УникальныеПТС = Состав.Выгрузить(,"ПТС");
	УникальныеПТС.Свернуть("ПТС");
	Если УникальныеПТС.Количество() <> Состав.Количество() Тогда
		Сообщить("В списке документов ПТС есть повторяющиеся строки");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
