Функция НайтиЦехПерепродаж(ВыбСклад);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Цеха.Ссылка,
		|	Цеха.СкладКомпании,
		|	Цеха.ДляПерепродаж КАК ДляПерепродаж
		|ИЗ
		|	Справочник.Цеха КАК Цеха
		|ГДЕ
		|	Цеха.СкладКомпании = &ВыбСклад
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДляПерепродаж УБЫВ";
	
	Запрос.УстановитьПараметр("ВыбСклад", ВыбСклад);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Справочники.Цеха.ПустаяСсылка();
  
КонецФункции // НайтиЦехПерепродаж()
