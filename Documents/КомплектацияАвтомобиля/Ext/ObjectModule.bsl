// Формирует отчет по незавершенному производству
Процедура ОтчетПоНезавершенномуПроизводству() Экспорт
	// заполним параметры отчета
	Отчет=Отчеты.ОстаткиИОборотыТоваровВПроизводстве.Создать();
	Отчет.ВидОтчета=Перечисления.ВидыОтчетов.ОстаткиИОбороты;
	Отчет.ДатаНачала=Неопределено;
	Отчет.ДатаКонца=КонецДня(ТекущаяДата());
	Отчет.РежимВыводаОтчета=Перечисления.РежимыВыводаОтчета.ТабличныйДокумент;
	Отчет.РежимНастройки=Перечисления.РежимыНастройкиОтчетов.Эксперт;
	Отчет.ИмяФормыНастроек="НастройкиОстаткиИОбороты";
	Отчет.ЗаполнитьНачальныеНастройки("ТекстЗапросаОстаткиИОбороты");
	// уберем лишние измерения
	Для каждого ИзмерениеОтчета Из Отчет.ИзмеренияСтроки Цикл
		Если ИзмерениеОтчета.ПутьКДанным="Номенклатура" Тогда
			ИзмерениеОтчета.Использование=Истина;
			ИзмерениеОтчета.ТипИзмерения="Элементы";
		Иначе
			ИзмерениеОтчета.Использование=Ложь;
		КонецЕсли; 
	КонецЦикла; 
	Для Каждого СтрокаПоказателей Из Отчет.Показатели Цикл
		Если СтрокаПоказателей.Имя="Количество" Тогда
			СтрокаПоказателей.Использование=Истина;
		Иначе
			СтрокаПоказателей.Использование=Ложь;
		КонецЕсли; 
	КонецЦикла;
	Для Каждого СтрокаПоказателей Из Отчет.Функции Цикл
		Если СтрокаПоказателей.Имя="Приход" ИЛИ СтрокаПоказателей.Имя="Расход" Тогда
			СтрокаПоказателей.Использование=Истина;
		Иначе
			СтрокаПоказателей.Использование=Ложь;
		КонецЕсли; 
	КонецЦикла;
	// фильтры
	ОтборПостроителя=Отчет.ПостроительОтчета.Отбор.Найти("ЗаказНаряд");
	Если ОтборПостроителя<>Неопределено Тогда
		ОтборПостроителя.Значение=Ссылка;
		ОтборПостроителя.Использование=Истина;
	КонецЕсли; 
	ОтборПостроителя=Отчет.ПостроительОтчета.Отбор.Найти("ПериодРегистратор");
	Если ОтборПостроителя<>Неопределено Тогда
		ОтборПостроителя.Значение=Ссылка;
		ОтборПостроителя.ВидСравнения=ВидСравнения.НеРавно;
		ОтборПостроителя.Использование=Истина;
	КонецЕсли; 
	
	ФормаОтчета=ПолучитьОбщуюФорму("Отчет");
	ФормаОтчета.ОтчетОбъект=Отчет;
	ФормаОтчета.Заголовок="Остатки и обороты товаров в производстве";
	ФормаОтчета.Открыть();
КонецПроцедуры

