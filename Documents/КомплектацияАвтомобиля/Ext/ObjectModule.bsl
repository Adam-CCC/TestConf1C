// Семенихин 04.06.2024 +++++
Функция АвтомобильОприходован() Экспорт
	Если обЗначениеНеЗаполнено(Автомобиль) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЗапросАвтомобиль = Новый Запрос();
	ЗапросАвтомобиль.УстановитьПараметр("НаДату", Дата);
	ЗапросАвтомобиль.УстановитьПараметр("Автомобиль", Автомобиль);
	ЗапросАвтомобиль.Текст =
	"ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&НаДату, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки";
	
	РезультатАвтомобиль = ЗапросАвтомобиль.Выполнить();
	Если РезультатАвтомобиль.Пустой() Тогда
		Возврат Ложь;
		
	Иначе
		ВыборкаАвтомобиль = РезультатАвтомобиль.Выбрать();
		ВыборкаАвтомобиль.Следующий();
		Возврат ВыборкаАвтомобиль.КоличествоОстаток > 0;
	КонецЕсли;
КонецФункции
