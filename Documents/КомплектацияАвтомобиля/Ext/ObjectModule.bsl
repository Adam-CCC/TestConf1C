Функция СМГ_ЕстьПодчиненныеПодразделения(РежимЗаписи)
	
	ФлОтказ = Ложь;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если НЕ ( Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка ИЛИ Состояние = Справочники.ВидыСостоянийЗаказНарядов.Отказ ) Тогда
			Если Не обЗначениеНеЗаполнено(Дата) Тогда
				Если Дата >= Дата(2023,3,1)Тогда
					Если Не обЗначениеНеЗаполнено(ПодразделениеКомпании) Тогда
 						
						Запрос = Новый Запрос;
						Запрос.Текст = 
						"ВЫБРАТЬ
						|	ПодразделенияКомпании.Ссылка,
						|	ПодразделенияКомпании.Родитель
						|ИЗ
						|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
						|ГДЕ
						|	ПодразделенияКомпании.Родитель = &ПодразделениеКомпании";
						
						Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
						
						РезультатЗапроса = Запрос.Выполнить();
						
						ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
						
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							ФлОтказ = Истина;
	 						#Если Клиент Тогда
								СМГ_Сообщить("Ошибка! У подразделения """+ПодразделениеКомпании+""" есть подчиненные.",СтатусСообщения.ОченьВажное);
							#КонецЕсли
 							Прервать;
						КонецЦикла;
						
 					КонецЕсли;		
 				КонецЕсли;		
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ФлОтказ;
	
КонецФункции // СМГ_ЕстьПодчиненныеПодразделения(РежимЗаписи)


