Функция ПроверитьКорректностьСкладаПоРодителю() Экспорт 
	
	ФЛаг = Ложь;
  	
	Для Каждого стр из Товары цикл
		Если НЕ Цех.СкладКомпании.ЭтоГруппа Тогда
			Если НЕ стр.СкладКомпании.ЭтоГруппа Тогда
 	 			Если стр.СкладКомпании.Подразделение.Родитель <> Цех.СкладКомпании.Подразделение.Родитель Тогда
					Флаг = Истина;
					Сообщить("ОШИБКА! Родителем подразделения склада табличной части ["+стр.СкладКомпании.Код+"] "+стр.СкладКомпании + 
					" является ["+стр.СкладКомпании.Подразделение.Родитель.Код+"] "+стр.СкладКомпании.Подразделение.Родитель
					+" и не совпадает с родителем подразделения склада цеха "+Цех+" равного ["+Цех.СкладКомпании.Подразделение.Родитель.Код+"] "+Цех.СкладКомпании.Подразделение.Родитель, СтатусСообщения.ОченьВажное);
				КонецЕсли;
 			КонецЕсли; 
 		Иначе
			Если НЕ стр.СкладКомпании.Подразделение.ПринадлежитЭлементу(Цех.Подразделение) Тогда
				Флаг = Истина;
				Сообщить("ОШИБКА! Подразделение склада табличной части ["+стр.СкладКомпании.Код+"] "+стр.СкладКомпании+" равно ["+стр.СкладКомпании.Подразделение.Код+"] "+
				стр.СкладКомпании.Подразделение+" не входит в группу подразделений цеха ["+Цех.Код+"] "+Цех+", которая имеет значение равное ["+Цех.Подразделение.Код+"] "+Цех.Подразделение,
				СтатусСообщения.ОченьВажное);
			КонецЕсли;
         КонецЕсли; 
	КонецЦикла;
	
 	Возврат ФЛаг;
	
КонецФункции
