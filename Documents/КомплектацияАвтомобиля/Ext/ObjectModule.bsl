Процедура СМГ_ПередЗаписью(РежимЗаписи)
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		Для каждого СтрокаТЧ Из Товары Цикл
			Попытка ОбработкаРеквизита("Товары.СуммаВсего",СтрокаТЧ); Исключение КонецПопытки; 
			Попытка ОбработкаРеквизита("Товары.Цена",СтрокаТЧ); Исключение КонецПопытки; 
		КонецЦикла;
		Для каждого СтрокаТЧ Из Работы Цикл                                                    
			Если СтрокаТЧ.Коэффициент = 0 Тогда
				СтрокаТЧ.Коэффициент = 1;			
			КонецЕсли;
			Попытка ОбработкаРеквизита("Работы.СуммаВсего",СтрокаТЧ); Исключение КонецПопытки; 
			Попытка ОбработкаРеквизита("Работы.Цена",СтрокаТЧ); Исключение КонецПопытки; 
		КонецЦикла;
		//Бондаренко++ 20251014
		Если Дата >= Дата(2024,1,1) Тогда
			Если ВидРемонта <> Справочники.ВидыРемонта.КомплектацияАвтомобиля Тогда
				ВидРемонта = Справочники.ВидыРемонта.КомплектацияАвтомобиля;  		
			КонецЕсли;
		КонецЕсли;
 		//Бондаренко++ 20251014
   	КонецЕсли;
КонецПроцедуры// СМГ_ПередЗаписью(РежимЗаписи)
