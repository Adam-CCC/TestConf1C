Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	Если НЕ дкПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс) Тогда Возврат; КонецЕсли;
КонецПроцедуры

// Процедура - обработчик ввода на основании
Процедура ОбработкаЗаполнения(Основание, РаботыИзWA=Неопределено) Экспорт
	дкОбработкаЗаполнения(ЭтотОбъект, Основание); 
	
	Если Основание <> Неопределено
		И ТипЗнч(Основание) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
		
		ЭтотОбъект.Работы.Очистить();
		
		ЭтотОбъект.РабочееМесто = Основание.Цех;
		ЭтотОбъект.Статус = Перечисления.УРВ_СтатусыРабот.Запланировано;
		
		// KRAA
		// Заполним работы
		Если РаботыИзWA=Неопределено Или РаботыИзWA=Истина Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ПакетРаботРаботы.ИдентификаторСтрокиЗаказНаряда
			               |ИЗ
			               |	Документ.УРВ_ПакетРабот.Работы КАК ПакетРаботРаботы
			               |ГДЕ
			               |	ПакетРаботРаботы.Ссылка.ПометкаУдаления = ЛОЖЬ
			               |	И ПакетРаботРаботы.ЗаказНаряд = &ЗаказНаряд";
			Запрос.УстановитьПараметр("ЗаказНаряд", Основание);
			РаботыВЗаказНарядах = Запрос.Выполнить().Выгрузить(); 		
	
			Для Каждого СтрокаРабот Из Основание.Работы Цикл
				Если РаботыВЗаказНарядах.Найти(СтрокаРабот.ИдентификаторРаботы, "ИдентификаторСтрокиЗаказНаряда") = Неопределено Тогда
					НоваяСтрока = ЭтотОбъект.Работы.Добавить();
					НоваяСтрока.ЗаказНаряд = Основание;
					НоваяСтрока.ИдентификаторСтрокиЗаказНаряда = СтрокаРабот.ИдентификаторРаботы;
					НоваяСтрока.Работа = СтрокаРабот.Работа;
					НоваяСтрока.Количество = СтрокаРабот.Количество;
					НоваяСтрока.Коэффициент = СтрокаРабот.Коэффициент;
				Иначе
				КонецЕсли;
			КонецЦикла;
		Иначе			
			Для Каждого СтрокаРабот Из Основание.Работы Цикл
				Если РаботыИзWA.Найти(СокрЛП(СтрокаРабот.Работа.Код)) <> Неопределено Тогда
					НоваяСтрока = ЭтотОбъект.Работы.Добавить();
					НоваяСтрока.ЗаказНаряд = Основание;
					НоваяСтрока.ИдентификаторСтрокиЗаказНаряда = СтрокаРабот.ИдентификаторРаботы;
					НоваяСтрока.Работа = СтрокаРабот.Работа;
					НоваяСтрока.Количество = СтрокаРабот.Количество;
					НоваяСтрока.Коэффициент = СтрокаРабот.Коэффициент;
				Иначе
				КонецЕсли;
			КонецЦикла; 		
		КонецЕсли;
		
		// Заполним исполнителей
		// только по тем работам, которые попали в пакет
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
					   |	ЗаказНарядИсполнители.Исполнитель КАК Сотрудник
					   |ИЗ
					   |	Документ.ЗаказНаряд.Исполнители КАК ЗаказНарядИсполнители
					   |ГДЕ
					   |	ЗаказНарядИсполнители.Ссылка = &ЗаказНаряд
					   |	И ЗаказНарядИсполнители.ИдентификаторРаботы В(&СписокИдентификаторовРабот)";
		Запрос.УстановитьПараметр("ЗаказНаряд", Основание);
		Запрос.УстановитьПараметр("СписокИдентификаторовРабот", ЭтотОбъект.Работы.ВыгрузитьКолонку("ИдентификаторСтрокиЗаказНаряда"));
		ТаблицаИсполнителей = Запрос.Выполнить().Выгрузить();
		Если ТаблицаИсполнителей.Количество() > 0 Тогда
			ЭтотОбъект.Сотрудники.Загрузить(ТаблицаИсполнителей);	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Если НЕ дкПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда Возврат; КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если НЕ дкПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда Возврат; КонецЕсли;
	Если НЕ ОбменДанными.Загрузка Тогда
		
		Если ЭтотОбъект.Дата = Дата(1,1,1,0,0,0) Тогда ЭтотОбъект.Дата = ТекущаяДата(); КонецЕсли;
		ПредставлениеАРМ = Строка(Номер) + " от "+ Формат(Дата, "ДЛФ=Д");
		ПереченьЗаказов = "";
		
		ВремТабл = Работы.Выгрузить();
		ВремТабл.Свернуть("ЗаказНаряд","Количество");
		Для Каждого СтрокаЗаказов Из ВремТабл Цикл
			ПредставлениеЗН = "№" + Строка(СтрокаЗаказов.ЗаказНаряд.Номер) + "," + СтрокаЗаказов.ЗаказНаряд.Автомобиль.Модель + ";";
			ПереченьЗаказов = ПереченьЗаказов + ПредставлениеЗН;
		КонецЦикла;
		ПредставлениеАРМ = ПредставлениеАРМ + " (" + Лев(ПереченьЗаказов, СтрДлина(ПереченьЗаказов)-1) + ")";
		
		ЗаписьВФорме = ДополнительныеСвойства.Свойство("ЗаписьВФорме");
		
		// ЗАПИСЬ
		Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			Если Статус = Перечисления.УРВ_СтатусыРабот.Завершение Тогда
				РежимЗаписи = РежимЗаписиДокумента.Проведение;	
			Иначе
				//#Если Клиент Тогда
					ДатаЗаписиСостояния = ТекущаяДата();
				//#Иначе	
					//ДатаЗаписиСостояния = КонецДня(ТекущаяДата());
				//#КонецЕсли
				Если Статус = Перечисления.УРВ_СтатусыРабот.Выполнение Тогда	
					ВидПерерыва = Справочники.УРВ_ВидыПерерывов.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// ПРОВЕДЕНИЕ	
		Если  РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			
			Если Статус <> Перечисления.УРВ_СтатусыРабот.Завершение Тогда
				#Если Клиент Тогда
				//Если ЗаписьВФорме Тогда
					Сообщить("Проведение документа допустимо только в состоянии ""Завершено""", СтатусСообщения.Важное);
				//КонецЕсли;
				#КонецЕсли
				Отказ=Истина;
			КонецЕсли;
			ВидПерерыва = Справочники.УРВ_ВидыПерерывов.ПустаяСсылка();
			Если ЗаписьВФорме Тогда
				// если проведение в форме документа, то проверим оперативно или нет
				Если РежимПроведения = РежимПроведенияДокумента.Оперативный Тогда
					//#Если Клиент Тогда
					//	ЭтотОбъект.Дата = РабочаяДата + Час(ТекущаяДата())*60*60 + Минута(ТекущаяДата())*60 + Секунда(ТекущаяДата());
					//#Иначе	
						ЭтотОбъект.Дата = ТекущаяДата();
					////#КонецЕсли
				Иначе
					// если не оперативно, то дату документа не меняем
					// ...но убедимся, что дата документа не меньше последнего из состояний
					ЗаписиРегистра = РегистрыСведений.УРВ_СостояниеРабот.СрезПоследних(, Новый Структура("ПакетРабот", ЭтотОбъект.Ссылка));
					ЗаписиРегистра.Сортировать("Период Убыв");
					Если ЭтотОбъект.Дата < ЗаписиРегистра[0].Период Тогда
						#Если Клиент Тогда
						Сообщить("Документ проводится раньше даты последнего изменения статуса <"+ ЗаписиРегистра[0].Статус + " с " + Строка(ЗаписиРегистра[0].Период) +"> 
						|Установите дату документа, соответствующую дате завершения работ!",СтатусСообщения.Важное);	
						#КонецЕсли
						Отказ = Истина;
					КонецЕсли;
				КонецЕсли;
			Иначе
				// если проведение через АРМ или из списка, то всегда оперативно
				
				Если НЕ ЭтотОбъект.Проведен Тогда
					//#Если Клиент Тогда
					//	ЭтотОбъект.Дата = РабочаяДата + Час(ТекущаяДата())*60*60 + Минута(ТекущаяДата())*60 + Секунда(ТекущаяДата());
					//#Иначе	
						ЭтотОбъект.Дата = ТекущаяДата();
					//#КонецЕсли
				КонецЕсли;
			КонецЕсли;
			ДатаЗаписиСостояния = ЭтотОбъект.Дата;
		КонецЕсли;	
		
		// ОТМЕНА ПРОВЕДЕНИЯ	
		Если  РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			
			Если Статус = Перечисления.УРВ_СтатусыРабот.Завершение Тогда
				Статус = Перечисления.УРВ_СтатусыРабот.Выполнение;		
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	Если ЗаписьВФорме Тогда
		ДополнительныеСвойства.Удалить("ЗаписьВФорме");
	КонецЕсли;
	
	Режим = РежимЗаписи;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если НЕ дкПриЗаписи(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
	
	Если НЕ ОбменДанными.Загрузка Тогда
		
		// Проверим в каком статусе документ записывался в прошлый раз
		ЗаписиРегистра = РегистрыСведений.УРВ_СостояниеРабот.СрезПоследних(, Новый Структура("ПакетРабот", ЭтотОбъект.Ссылка));
		ЗаписиРегистра.Сортировать("Период Убыв");
		// Если статус изменился, то запишем изменение состояния
		Если ЗаписиРегистра.Количество() = 0 ИЛИ ЗаписиРегистра[0].Статус <> Статус ИЛИ Режим = РежимЗаписиДокумента.Проведение Тогда
			Если Режим = РежимЗаписиДокумента.ОтменаПроведения Тогда
				Попытка
					НаборЗаписей = РегистрыСведений.УРВ_СостояниеРабот.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.ПакетРабот.Значение = ЭтотОбъект.Ссылка;
					НаборЗаписей.Отбор.ПакетРабот.Использование = Истина;
					НаборЗаписей.Отбор.Статус.Значение = Перечисления.УРВ_СтатусыРабот.Завершение;
					НаборЗаписей.Отбор.Статус.Использование = Истина;
					НаборЗаписей.Прочитать();
					НаборЗаписей.Очистить();
					НаборЗаписей.Записать();
				Исключение
					Отказ = Истина;
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			Иначе	
				Попытка
					НаборЗаписей = РегистрыСведений.УРВ_СостояниеРабот.СоздатьНаборЗаписей();
					Если Режим = РежимЗаписиДокумента.Проведение Тогда
						НаборЗаписей.Отбор.Статус.Значение = Перечисления.УРВ_СтатусыРабот.Завершение;
						НаборЗаписей.Отбор.Статус.Использование = Истина;
					Иначе 
						НаборЗаписей.Отбор.Период.Значение = ДатаЗаписиСостояния;
						НаборЗаписей.Отбор.Период.Использование = Истина;
					КонецЕсли;
					НаборЗаписей.Отбор.ПакетРабот.Значение = ЭтотОбъект.Ссылка;
					НаборЗаписей.Отбор.ПакетРабот.Использование = Истина;
					НаборЗаписей.Прочитать();
					НаборЗаписей.Очистить();
					НаборЗаписей.Записать();
					
					Для Каждого СтрокаСотрудники Из Сотрудники Цикл
						Для Каждого СтрокаРабот ИЗ Работы Цикл
							НоваяЗапись = НаборЗаписей.Добавить();
							НоваяЗапись.Период = ДатаЗаписиСостояния;
							НоваяЗапись.РабочееМесто = ЭтотОбъект.РабочееМесто;
							НоваяЗапись.ПакетРабот = ЭтотОбъект.Ссылка;
							НоваяЗапись.Сотрудник = СтрокаСотрудники.Сотрудник;
							НоваяЗапись.ЗаказНаряд = СтрокаРабот.ЗаказНаряд;
							НоваяЗапись.Работа = СтрокаРабот.Работа;
							НоваяЗапись.Статус = ЭтотОбъект.Статус;
							НоваяЗапись.ВидПерерыва = ВидПерерыва;
						КонецЦикла;
					КонецЦикла;
					НаборЗаписей.Записать(Ложь);
				Исключение
					Отказ = Истина;
					Сообщить(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ПометкаУдаления Тогда
		обОтправитьЗапросВWA(Строка(Ссылка.УникальныйИдентификатор()),"3","D");
	КонецЕсли;
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если НЕ дкПередУдалением(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Если НЕ дкОбработкаУдаленияПроведения(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
	НаборЗаписейФактическоеВремяРабот = РегистрыСведений.УРВ_ФактическоеВремяРабот.СоздатьНаборЗаписей();
	НаборЗаписейФактическоеВремяРабот.Отбор.ПакетРабот.Установить(Ссылка);
	НаборЗаписейФактическоеВремяРабот.Прочитать();
	НаборЗаписейФактическоеВремяРабот.Очистить();
	НаборЗаписейФактическоеВремяРабот.Записать();
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Если НЕ дкОбработкаПроведения(ЭтотОбъект, Отказ, Режим) Тогда Возврат; КонецЕсли;
	
	// Определим общее время выполнения пакета работ
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СостояниеРабот.Период КАК Период,
	               |	СостояниеРабот.РабочееМесто КАК РабочееМесто,
	               |	СостояниеРабот.Сотрудник КАК Сотрудник,
	               |	СостояниеРабот.Статус КАК Статус
	               |ИЗ
	               |	РегистрСведений.УРВ_СостояниеРабот КАК СостояниеРабот
	               |ГДЕ
	               |	СостояниеРабот.ПакетРабот = &ПакетРабот
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СостояниеРабот.Период,
	               |	СостояниеРабот.РабочееМесто,
	               |	СостояниеРабот.Сотрудник,
	               |	СостояниеРабот.Статус
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период
	               |ИТОГИ ПО
	               |	Период,
	               |	Статус";
	Запрос.УстановитьПараметр("ПакетРабот", ЭтотОбъект.Ссылка);
	ЗаписиСостоянийПериод = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	СписокПериодов = Новый СписокЗначений;
	
	СчитатьПромежуточныеИтоги = Ложь;
	СчитатьОкончательныеИтоги = Ложь;
	ПромежуточноеВремяВСекундах = 0;
	ОбщееВремяРаботы = 0;
	
	ДатаНачалаРабот = ПлановаяДатаНачалаРабот;
	ДатаОкончанияРабот = ПлановаяДатаОкончанияРабот;
		
	Пока ЗаписиСостоянийПериод.Следующий() Цикл
		
		ЗаписиСостоянийСтатус = ЗаписиСостоянийПериод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		ЗаписиСостоянийСтатус.Следующий();
		Если ЗаписиСостоянийСтатус.Статус = Перечисления.УРВ_СтатусыРабот.Выполнение Тогда
			ДатаНачалаРабот = ЗаписиСостоянийСтатус.Период;
			СчитатьПромежуточныеИтоги = Ложь;	
			СчитатьОкончательныеИтоги = Ложь;
		ИначеЕсли ЗаписиСостоянийСтатус.Статус = Перечисления.УРВ_СтатусыРабот.Пауза Тогда
			ДатаОкончанияРабот = ЗаписиСостоянийСтатус.Период;
			СчитатьПромежуточныеИтоги = Истина;	
			СчитатьОкончательныеИтоги = Ложь;
		ИначеЕсли ЗаписиСостоянийСтатус.Статус = Перечисления.УРВ_СтатусыРабот.Завершение Тогда
			ДатаОкончанияРабот = ЗаписиСостоянийСтатус.Период;
			СчитатьПромежуточныеИтоги = Истина;	
			СчитатьОкончательныеИтоги = Истина;
		КонецЕсли;
		
		Если СчитатьПромежуточныеИтоги Тогда
			
			// если дата начала не заполнена, то нет возможности рассчитать фактическое время
			Если ДатаНачалаРабот = Дата(1,1,1,0,0,1) Тогда
				ПромежуточноеВремяВСекундах = 0;
			Иначе
				ПромежуточноеВремяВСекундах = ДатаОкончанияРабот - ДатаНачалаРабот;
				
				СтруктураЭлемента = Новый Структура("Время, РабочееМесто, СписокСотрудников");
				СтруктураЭлемента.Вставить("Время", ПромежуточноеВремяВСекундах);
				
				ЗаписиСостоянийСтроки = ЗаписиСостоянийСтатус.Выбрать(ОбходРезультатаЗапроса.Прямой);
				СписокСотрудников = Новый СписокЗначений;
				ТекущееРабочееМесто = Неопределено;
				Пока ЗаписиСостоянийСтроки.Следующий() Цикл
					Если ТекущееРабочееМесто = Неопределено Тогда ТекущееРабочееМесто = ЗаписиСостоянийСтроки.РабочееМесто; КонецЕсли;
					СписокСотрудников.Добавить(ЗаписиСостоянийСтроки.Сотрудник);				
				КонецЦикла;
				
				СтруктураЭлемента.Вставить("РабочееМесто", ТекущееРабочееМесто);
				СтруктураЭлемента.Вставить("СписокСотрудников", СписокСотрудников);
				
				СписокПериодов.Добавить(СтруктураЭлемента);
				
				ДатаНачалаРабот = Дата(1,1,1,0,0,1);
				
			КонецЕсли;
			
			Если СчитатьОкончательныеИтоги Тогда 
				Прервать;	
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПакетРаботРаботы.ЗаказНаряд КАК ЗаказНаряд,
	               |	ПакетРаботРаботы.Работа,
	               |	СУММА(ЕСТЬNULL(ПакетРаботРаботы.Количество, 0) * ЕСТЬNULL(ПакетРаботРаботы.Коэффициент, 0)) КАК Норматив
	               |ИЗ
	               |	Документ.УРВ_ПакетРабот.Работы КАК ПакетРаботРаботы
	               |ГДЕ
	               |	ПакетРаботРаботы.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПакетРаботРаботы.ЗаказНаряд,
	               |	ПакетРаботРаботы.Работа";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	ТаблицаРабот = Запрос.Выполнить().Выгрузить();
	ВсегоНорматив = ТаблицаРабот.Итог("Норматив");
	
	ТаблицаЗаписей = Новый ТаблицаЗначений;
	ТаблицаЗаписей.Колонки.Добавить("ЗаказНаряд");
	ТаблицаЗаписей.Колонки.Добавить("РабочееМесто");
	ТаблицаЗаписей.Колонки.Добавить("Работа");
	ТаблицаЗаписей.Колонки.Добавить("Сотрудник");
	ТаблицаЗаписей.Колонки.Добавить("Время");
	
	Для Каждого ПериодРаботы Из СписокПериодов Цикл
		
		КоличествоСотрудников = ПериодРаботы.Значение.СписокСотрудников.Количество();
		Для Каждого Сотрудник Из ПериодРаботы.Значение.СписокСотрудников Цикл
			
			Для Каждого СтрокаРабот Из ТаблицаРабот Цикл
				НоваяЗапись = ТаблицаЗаписей.Добавить();
				НоваяЗапись.ЗаказНаряд = СтрокаРабот.ЗаказНаряд;
				НоваяЗапись.РабочееМесто = ПериодРаботы.Значение.РабочееМесто;
				НоваяЗапись.Работа = СтрокаРабот.Работа;
				НоваяЗапись.Сотрудник = Сотрудник.Значение;
				ДоляВОбщемНормативе = СтрокаРабот.Норматив/ВсегоНорматив;
				НоваяЗапись.Время  = Окр(ПериодРаботы.Значение.Время*ДоляВОбщемНормативе/КоличествоСотрудников);
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	ТаблицаЗаписей.Свернуть("ЗаказНаряд, РабочееМесто, Работа, Сотрудник", "Время");
	
	НаборЗаписейФактическоеВремяРабот = РегистрыСведений.УРВ_ФактическоеВремяРабот.СоздатьНаборЗаписей();
	НаборЗаписейФактическоеВремяРабот.Отбор.ПакетРабот.Установить(Ссылка);
	НаборЗаписейФактическоеВремяРабот.Прочитать();
	Если НаборЗаписейФактическоеВремяРабот.Количество() <> 0 Тогда
		НаборЗаписейФактическоеВремяРабот.Очистить();	
	КонецЕсли;
	
	Для Каждого СтрокаЗаписей Из ТаблицаЗаписей Цикл
		НоваяЗапись = НаборЗаписейФактическоеВремяРабот.Добавить();
		НоваяЗапись.ПакетРабот = Ссылка;
		НоваяЗапись.ЗаказНаряд = СтрокаЗаписей.ЗаказНаряд;
		НоваяЗапись.РабочееМесто = СтрокаЗаписей.РабочееМесто;
		НоваяЗапись.Работа = СтрокаЗаписей.Работа;
		НоваяЗапись.Сотрудник = СтрокаЗаписей.Сотрудник;
		НоваяЗапись.Время  = СтрокаЗаписей.Время;
	КонецЦикла;
	
	НаборЗаписейФактическоеВремяРабот.Записать();
	
	// выведем сообщения об ошибках и предупреждениях
	дкВыводРезультатовОбработки(ЭтотОбъект,Отказ);
	
КонецПроцедуры // ОбработкаПроведения


