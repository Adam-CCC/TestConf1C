Процедура АвтомобилиАвтомобильПриИзменении(Элемент)
	ТекДанные=Элементы.Состав.ТекущиеДанные;
	Если НЕ ПроверкаАвто(ТекДанные.Автомобиль) Тогда
		ТекДанные.Автомобиль="";		
	КонецЕсли;
	УправлениеЭлементами();
