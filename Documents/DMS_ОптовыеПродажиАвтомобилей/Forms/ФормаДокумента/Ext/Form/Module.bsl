&НаСервере
Функция ЗаполнитьДокументРеализации()
	ТаблицаАвто = Объект.Состав.Выгрузить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаАвто.Автомобиль,
	               |	ТаблицаАвто.Стоимость КАК СуммаВсего
	               |ПОМЕСТИТЬ ТаблицаАвто
	               |ИЗ
	               |	&ТаблицаАвто КАК ТаблицаАвто
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаАвто.Автомобиль,
	               |	ТаблицаАвто.СуммаВсего
	               |ИЗ
	               |	ТаблицаАвто КАК ТаблицаАвто
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
	               |		ПО ТаблицаАвто.Автомобиль = РеализацияАвтомобилейАвтомобили.Автомобиль
	               |ГДЕ
	               |	РеализацияАвтомобилейАвтомобили.Ссылка ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ТаблицаАвто",ТаблицаАвто);
	ТаблицаАвто = ЗАпрос.Выполнить().Выгрузить();
	Если ТаблицаАвто.Количество() = 0 тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ВалютаРеглУчета								= Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	ДокументРеализация							= Документы.РеализацияАвтомобилей.СоздатьДокумент();			
	ДокументРеализация.Дата						= ТекущаяДата();
	ДокументРеализация.Автор 					= ПараметрыСеанса.Пользователь;
	ДокументРеализация.Менеджер 				= Объект.Менеджер;
	ДокументРеализация.Организация				= Объект.ДилерскийЦентр.Организация;
	//ДокументРеализация.ПодразделениеКомпании 	= Объект.Подразделение;
	ДокументРеализация.РегламентированныйУчет	= Истина;
	ДокументРеализация.Контрагент				= Объект.Клиент.Контрагент;
	ДокументРеализация.Заказчик					= ДокументРеализация.Контрагент; // ?
	ДокументРеализация.КурсВалютыВзаиморасчетов = 1;
	ДокументРеализация.ВалютаДокумента			= ВалютаРеглУчета;
	ДокументРеализация.КурсВалютыУпр			= 1;
	ДокументРеализация.КурсДокумента			= 1;
	ДокументРеализация.ВидОплаты				= Перечисления.ВидыОплаты.БезналичныйРасчет; //?
	ДокументРеализация.СкладКомпании			= ""; //?
	ДокументРеализация.ТипЦен					= ""; //?
	ДокументРеализация.СкидкаНаценкаАвтомобили	= Справочники.ТипыСкидок.НеНайдена; //?
	ДокументРеализация.ЗначениеСкидкиНаценкиАвтомобили = 0;
	ДокументРеализация.СуммаСкидкиНаценкиАвтомобили = 0; //?
	ДокументРеализация.СкидкаНаценка			= Справочники.ТипыСкидок.НеНайдена;
	ДокументРеализация.ЗначениеСкидкиНаценки	= 0;
	ДокументРеализация.СуммаСкидкиНаценки		= 0;
	ДокументРеализация.ХозОперация				= Справочники.ХозОперации.РеализацияАвтомобилей;
	ДокументРеализация.ДатаСоздания				= ДокументРеализация.Дата;
	ДокументРеализация.ДатаОперации				= ДокументРеализация.Дата; //?
	ДокументРеализация.БлокироватьПерерасчетСкидок = Ложь;
	
	Для Каждого ТекСтр из ТаблицаАвто цикл
		НовСтр 							= ДокументРеализация.Автомобили.Добавить();
		НовСтр.Автомобиль 				= ТекСтр.Автомобиль;
		НовСтр.ИдентификаторАвтомобиля 	= Строка(НовСтр.Автомобиль.УникальныйИдентификатор());
		НовСтр.Количество				= 1;
		НовСтр.Цена						= ТекСтр.СуммаВсего;
		НовСтр.СуммаВсего				= ТекСтр.СуммаВсего;
	КонецЦикла;	
	возврат ДокументРеализация;
КонецФункции

