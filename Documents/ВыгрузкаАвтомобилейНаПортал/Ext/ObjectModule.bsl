	СтруктураМакетов.Вставить("Реквизитов", "Печать реквизитов");
	//СтруктураМакетов.Вставить("ИНВ3", "Инвентаризационная опись (ИНВ-3)");
	//СтруктураМакетов.Вставить("ИНВ19", "Сличительная ведомость (ИНВ-19)");
	//СтруктураМакетов.Вставить("ИнвентаризацияАвтомобилей", "Пустографка");
   	Возврат СтруктураМакетов;
КонецФункции

#КонецЕсли
