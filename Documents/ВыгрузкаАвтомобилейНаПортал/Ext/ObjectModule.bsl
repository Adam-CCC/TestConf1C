Функция ПолучитьПробег(Автомобиль) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АвтомобилиСрезПоследних.Значение КАК Пробег
	               |ИЗ
	               |	РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	               |ГДЕ
	               |	АвтомобилиСрезПоследних.Автомобиль = &Автомобиль
	               |	И АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения";
				   
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
 		Возврат Выборка.Пробег;
 	Иначе
 		Возврат 0;
 	КонецЕсли;
	
КонецФункции

Функция НайтиНомерПТС(Авто) Экспорт
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Владелец,
		|	ПодтверждающиеДокументы.Номер,
		|	ПодтверждающиеДокументы.Серия,
		|	ПодтверждающиеДокументы.ВидПодтверждающегоДокумента
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.ПТС)
		|	И ПодтверждающиеДокументы.Владелец = &Авто";
	
	Запрос.УстановитьПараметр("Авто",Авто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ""+ВыборкаДетальныеЗаписи.Серия+""+ВыборкаДетальныеЗаписи.Номер;
	КонецЦикла;
	
	Возврат "";
 
КонецФункции // НайтиПТС()

Функция ПолучитьИмяХоста(знач Местоположение) Экспорт

    Местоположение=СокрЛП(Местоположение);
    если Лев(НРег(Местоположение),5)="http:" тогда
        Местоположение=Сред(Местоположение, 6);
    конецесли;
    // пока пробел или косая черта, продолжаем
 
    пока Найти(" /", Лев(Местоположение, 1))<>0 цикл
        Местоположение=Сред(Местоположение, 2);
    конеццикла;
    // Выделим все, что до следующего знака "/"
 
    Поз=Найти(Местоположение, "/");
    если Поз<>0 тогда
        возврат СокрП(Лев(Местоположение, Поз-1));
    конецесли;
    // не нашли - вернем всю строку
 
    возврат СокрП(Местоположение);
КонецФункции   

Процедура ОтправитьЗапросВWA(MessageID,MessageType,ActionType) Экспорт
	
  	Прокси = WSСсылки.Message.СоздатьWSПрокси("http://wa.dms.webservice/", "Message", "MessageSoap");        	
	ТипWSПараметра = Прокси.ФабрикаXDTO.Пакеты.Получить("http://wa.dms.webservice/MessageReceiveRequest").Получить("MessageReceiveRequest");
	ТипWSПараметраMessageRecieve = Прокси.ФабрикаXDTO.Пакеты.Получить("http://wa.dms.webservice/MessageReceiveRequest").Получить("MessageReceive");
	ТипWSПараметраTH = Прокси.ФабрикаXDTO.Пакеты.Получить("http://wa.dms.webservice/MessageReceiveRequest").Получить("TransactionHeader");
    		
	TransactionHeader  = Прокси.ФабрикаXDTO.Создать(ТипWSПараметраTH);   
	TransactionHeader.DealerID = "0100";
	Если ЗначениеЗаполнено(ПараметрыСеанса.Пользователь.Сотрудник) Тогда
		TransactionHeader.RequestPollingToken = ПараметрыСеанса.Пользователь.Сотрудник.Код;
	Иначе
		TransactionHeader.RequestPollingToken = "";
	КонецЕсли;
	TransactionHeader.TransactionDateTimeUTC = ТекущаяДата();
	TransactionHeader.TransactionDateTimeLocal = ТекущаяДата();
	
	MessageReceive	   = Прокси.ФабрикаXDTO.Создать(ТипWSПараметраMessageRecieve);   
	MessageReceive.MessageID = MessageID;
	MessageReceive.MessageType = MessageType;
	MessageReceive.ActionType = ActionType;

	WSПараметр	   = Прокси.ФабрикаXDTO.Создать(ТипWSПараметра);   
	WSПараметр.TransactionHeader = TransactionHeader;
	WSПараметр.MessageReceive = MessageReceive;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();     
	Прокси.ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, WSПараметр, , , , НазначениеТипаXML.Явное);
	СтрокаXML = ЗаписьXML.Закрыть();
	
	ТекстДок = Новый ТекстовыйДокумент;
	ТекстДок.УстановитьТекст(СтрокаXML);
	ТекстДок.УдалитьСтроку(1);
	ТекстДок.УдалитьСтроку(1);
	ТекстДок.УдалитьСтроку(ТекстДок.КоличествоСтрок());
	
    urlAddress = Прокси.ТочкаПодключения.Местоположение;
    hostName=обПолучитьИмяХоста(Прокси.ТочкаПодключения.Местоположение);
    xmlHttp = New COMОбъект("MSXML2.xmlHttp");
    xmlHttp.OPEN ("POST", urlAddress, 0);
    xmlHttp.setRequestHeader ("User-Agent", "1C+Enterprise/8.2");
    xmlHttp.setRequestHeader ("Host", hostName);
    xmlHttp.setRequestHeader ("SOAPAction", "http://wa.dms.webservice/MessageReceive");
    xmlHttp.setRequestHeader ("Content-type", "text/xml; charset=utf-8");
    xmlHttp.setRequestHeader ("Content-Length", "length");
    DOC = Новый COMОбъект("Msxml2.DOMDocument");
    
   	DOC.loadXML("<soap12:Envelope xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:soap12=""http://www.w3.org/2003/05/soap-envelope"">
   |<soap12:Body>
   |    <MessageReceiveRequest xmlns=""http://wa.dms.webservice/MessageReceiveRequest"">
   |      "+ТекстДок.ПолучитьТекст()+"
   |   </MessageReceiveRequest>
   |</soap12:Body>
   |</soap12:Envelope>");   

    попытка
    	xmlHttp.SEND(DOC);
    исключение
    	Сообщить("Ошибка при отправке "+ОписаниеОшибки());
    конецпопытки;          

    Если xmlHttp.statusText="OK" Тогда       
    	чтениеХМЛ = Новый ЧтениеXML;
    	чтениеХМЛ.УстановитьСтроку(СокрЛП(xmlHttp.responseText));
    	//хдто = Фабрика.ПрочитатьXML(чтениеХМЛ); 
    КонецЕсли;		    

КонецПроцедуры


