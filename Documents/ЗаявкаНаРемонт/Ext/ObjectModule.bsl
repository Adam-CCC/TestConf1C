Процедура ОтправитьСМСПоФактуЗаписи()
	Если обЗначениеНеЗаполнено(ДатаНачала) Тогда
		Возврат;
	КонецЕсли;
	Если НачалоДня(ТекущаяДата()) >= НачалоДня(ДатаНачала) Тогда
		Возврат;
	КонецЕсли;
	
	Если Состояние = Перечисления.СостоянияЗаявкиНаРемонт.Отклонено Тогда
		Возврат;
	КонецЕсли;
	Если обЗначениеНеЗаполнено(ПредставлениеТелефона) Тогда
		Возврат;
	КонецЕсли;
	ДокументСМС = Документы.SMS.НайтиПоРеквизиту("ДокументОснование", Ссылка);
	Если ЗначениеЗаполнено(ДокументСМС) Тогда
		Возврат;
	КонецЕсли;
	
	//Бондаренко++ 20250404 № 7851 
	СписокВидовРемонтаСМС = Новый СписокЗначений;
	СписокВидовРемонтаСМС.Добавить(Справочники.ВидыРемонта.КоммерческийРемонт);
	СписокВидовРемонтаСМС.Добавить(Справочники.ВидыРемонта.ТехническоеОбслуживание);
	СписокВидовРемонтаСМС.Добавить(Справочники.ВидыРемонта.ТехническоеОбслуживаниеБесплатное);
	СписокВидовРемонтаСМС.Добавить(Справочники.ВидыРемонта.ТО_ноль);
	СписокВидовРемонтаСМС.Добавить(Справочники.ВидыРемонта.ТО_нольПлатный);
 	Если ПодразделениеКомпании.ДилерскийЦентр = Справочники.ДилерскиеЦентры.Пойменная Тогда
		Если СписокВидовРемонтаСМС.НайтиПоЗначению(ВидРемонта) = Неопределено Тогда
 			Возврат;
			//На Пойменной 1Г (EXEED) по остальным видам ремонта SMS не отправляем.
		КонецЕсли;	
 	КонецЕсли;	
	//Бондаренко-- 20250404
	
	ТекстСМС = "";
	Если ЗначениеЗаполнено(Заказчик) Тогда
		Если ТипЗнч(Заказчик) = Тип("СправочникСсылка.Контрагенты") Тогда
			Если Заказчик.НашаФирма Тогда
				Возврат;
			ИначеЕсли Заказчик.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
				ТекстСМС = Заказчик.Имя + " " + Заказчик.Отчество + ", ";
			Иначе
				ТекстСМС = Заказчик.Наименование + ", ";
			КонецЕсли;
			
		Иначе
			ТекстСМС = СокрЛП(Заказчик) + ", ";
		КонецЕсли;
	КонецЕсли;
	
	ТекстСМС = ТекстСМС + "Вы записаны в сервисный центр " + Строка(ПодразделениеКомпании.ДилерскийЦентр) + " ";
	ТекстСМС = ТекстСМС + Формат(ДатаНачала, "ДФ='дд.ММ.гггг ЧЧ:мм'");
	
	ТекущееПодразделение = ПодразделениеКомпании;
	Пока Не ТекущееПодразделение.Пустая() Цикл
		ПодразделениеАдрес = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.АдресФактический);
		Если обЗначениеНеЗаполнено(ПодразделениеАдрес) Тогда
			ПодразделениеАдрес = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.АдресПочтовый);
		КонецЕсли;
		Если ЗначениеЗаполнено(ПодразделениеАдрес) Тогда
			ТекстСМС = ТекстСМС + ". Адрес: " + ПодразделениеАдрес;
			Прервать;
		Иначе
			ТекущееПодразделение = ТекущееПодразделение.Родитель;
			Продолжить;
		КонецЕсли;
	КонецЦикла;

	ТекущееПодразделение = ПодразделениеКомпании;
	Пока Не ТекущееПодразделение.Пустая() Цикл
		ПодразделениеТелефон = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
		Если обЗначениеНеЗаполнено(ПодразделениеТелефон) Тогда
			ПодразделениеТелефон = СМ_ОтправкаСМС.ПолучитьПредставлениеКИДляСМС(ТекущееПодразделение, Справочники.ВидыКонтактнойИнформации.ТелефонРабочий);
		КонецЕсли;
		Если ЗначениеЗаполнено(ПодразделениеТелефон) Тогда
			ТекстСМС = ТекстСМС + ", Тел: " + ПодразделениеТелефон;
			Прервать;
		Иначе
			ТекущееПодразделение = ТекущееПодразделение.Родитель;
			Продолжить;
		КонецЕсли;
	КонецЦикла;	  
	
	ТекстСМС = ТекстСМС + ". Ждём Вас!";
	
	//Бондаренко++ 20250228
	ТекстСМС = ТекстСМС + " Подобрать автомобиль или оценить свой - sokolmotors.ru ";
	//Бондаренко-- 20250228
	
	ТекстСМС = ТекстСМС + "Напоминаем, что официальный дилер " + Организация.Наименование + ", ";
	ТекстСМС = ТекстСМС + "не производит то с запасными частями и расходными материалами, приобретенными вами у сторонних поставщиков";
	
	СМСОтправлено = СМ_ОтправкаСМС.ОтправитьСМС(Ссылка, ТекстСМС);
КонецПроцедуры

Функция НайтиСоздатьРабЛистСервиса()
	РабЛистСсылка = СМ_ФормированиеНовыхОбъектов.НайтиРабочийЛистСервиса(ПодразделениеКомпании, ПредставлениеТелефона);
	Если ЗначениеЗаполнено(РабЛистСсылка) Тогда
		Сообщить("Найден " + Строка(РабЛистСсылка), СтатусСообщения.Информация);
		Возврат РабЛистСсылка;
		
	Иначе
		РабЛистОбъект = Документы.РабочийЛистСервиса.СоздатьДокумент();
		РабЛистОбъект.Заполнить(ЭтотОбъект);
		
		РабЛистОбъект.Дата = Дата - 300;
		РабЛистОбъект.ДатаИзменения = РабЛистОбъект.Дата;
		РабЛистОбъект.ХозОперация = Справочники.ХозОперации.РабочийЛистСервиса;
		//Бондаренко++ 20241128
		//РабЛистОбъект.Контрагент = Заказчик;
		Если обЗначениеНеЗаполнено(Контрагент) Тогда
			РабЛистОбъект.Контрагент = Заказчик;
		Иначе	
			РабЛистОбъект.Контрагент = Контрагент;
 		КонецЕсли;
		//Бондаренко-- 20241128
		РабЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.Интерес;
		РабЛистОбъект.Пол = Перечисления.ПолФизическихЛиц.НеУказан;
		РабЛистОбъект.Комментарий = "Создан автоматически при оформлении Заявки на ремонт №" + СокрЛП(Номер) + " от " + Формат(Дата, "ДЛФ=Д");
		
		Попытка
			РабЛистОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Возврат РабЛистОбъект.Ссылка;
		Исключение
			Сообщить("Не удалось записать Рабочий лист сервиса!", СтатусСообщения.Внимание);
			Возврат Документы.РабочийЛистСервиса.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли; 
КонецФункции
