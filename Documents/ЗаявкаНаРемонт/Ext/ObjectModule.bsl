Функция СМГ_ПолучитьЦенуНчИзРегистра(ДатаЗапроса,Нормочас) Экспорт
	
	НайденнаяЦена = 0; 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ЦенаНормочасаСрезПоследних.Период,
	               |	СМ_ЦенаНормочасаСрезПоследних.Модель КАК Модель,
	               |	СМ_ЦенаНормочасаСрезПоследних.Марка КАК Марка,
	               |	СМ_ЦенаНормочасаСрезПоследних.ПодразделениеКомпании КАК ПодразделениеКомпании,
	               |	СМ_ЦенаНормочасаСрезПоследних.НормоЧас КАК Нормочас,
	               |	СМ_ЦенаНормочасаСрезПоследних.Цена
	               |ИЗ
	               |	РегистрСведений.СМ_ЦенаНормочаса.СрезПоследних(
	               |			&Дата,
	               |			(Марка = &Марка
	               |				ИЛИ Марка = ЗНАЧЕНИЕ(Справочник.Марка.ПустаяСсылка))
	               |				И (Модель = &Модель
	               |					ИЛИ Модель = ЗНАЧЕНИЕ(Справочник.Модели.ПустаяСсылка))
	               |				И (ПодразделениеКомпании = &ПодразделениеКомпании
	               |					ИЛИ ПодразделениеКомпании = ЗНАЧЕНИЕ(Справочник.ПодразделенияКомпании.ПустаяСсылка))
	               |				И Нормочас = &Нормочас) КАК СМ_ЦенаНормочасаСрезПоследних
	               |ГДЕ
	               |	СМ_ЦенаНормочасаСрезПоследних.Цена > 0";
	
	//++Галактионов 20260121
	Если ТипЗнч(Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда 
		Марка	= Автомобиль.Модель.Марка;
		Модель	= Автомобиль.Модель;	 
	ИначеЕсли ТипЗнч(Автомобиль) = Тип("СправочникСсылка.Модели") Тогда
		Марка	= Автомобиль.Марка;
		Модель	= Автомобиль;
	ИначеЕсли ТипЗнч(Автомобиль) = Тип("Строка") Тогда 
		Сообщить("Строчный тип не содержит цены в регистре. Выберите другой тип в поле ""Автомобиль""");
		Возврат 0;
	КонецЕсли;
	//--Галактионов 20260121	
	Запрос.УстановитьПараметр("Марка",Марка);
	Запрос.УстановитьПараметр("Модель",Модель);
	Запрос.УстановитьПараметр("Нормочас",Нормочас);
	Запрос.УстановитьПараметр("ПодразделениеКомпании",ПодразделениеКомпании);
	Если ДатаЗапроса <> Дата(1,1,1) Тогда
		Запрос.УстановитьПараметр("Дата", ДатаЗапроса);											
	Иначе	
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());												
  	КонецЕсли;
  	 
	ТЗ = Запрос.Выполнить().Выгрузить(); 
	ТЗ.Сортировать("Нормочас Убыв, Модель Убыв, Марка Убыв, ПодразделениеКомпании Убыв"); 
	
	//#Если Клиент Тогда
	//Если РольДоступна("СМ_ИТОтдел") Тогда
	//	Если ТЗ.Количество() > 0  Тогда
	//		ТЗ.ВыбратьСтроку(); 
	//		//Для контроля, на стадии отладки алгоритма
	// 	КонецЕсли;			
	//  КонецЕсли;
	//#КонецЕсли
  	
	Если ТЗ.Количество() > 0 Тогда
		Для каждого Стр Из ТЗ Цикл
			НайденнаяЦена = Стр.Цена;
			Прервать;				
 		КонецЦикла;
  	КонецЕсли;
	
	Возврат НайденнаяЦена;			  
	
КонецФункции // СМГ_ПолучитьЦенуРаботыИзРегистра(ДатаЗапроса)
