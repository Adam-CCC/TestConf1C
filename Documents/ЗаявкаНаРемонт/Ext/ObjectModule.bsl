Процедура СМГ_ОбработкаРеквизита(Автомобиль,ЭтаФорма)

	Если НЕ обЗначениеНеЗаполнено(Автомобиль) Тогда
		Если ТипЗНЧ(Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда
			Марка_ = Автомобиль.Модель.Марка;
		ИначеЕсли ТипЗНЧ(Автомобиль) = Тип("СправочникСсылка.Модели") Тогда	
			Марка_ = Автомобиль.Марка;
		Иначе	
			Марка_ = "";
		КонецЕсли;
		Если НЕ обЗначениеНеЗаполнено(Марка_) Тогда
			ОбновитьНадписьОбщихРеквизитов = Ложь;
			ПодразделениеОбслуживания_ = СМ_ФормированиеНовыхОбъектов.НайтиПодразделениеПоМаркеАвто(Марка_);	
			Если Не обЗначениеНеЗаполнено(ПодразделениеОбслуживания_) Тогда
				Если ЭтотОбъект.ПодразделениеГК <> ПодразделениеОбслуживания_ Тогда
					ЭтотОбъект.ПодразделениеГК = ПодразделениеОбслуживания_;
				КонецЕсли;
				ПодразделениеКомпании_ = СМ_ФормированиеНовыхОбъектов.НайтиПодразделениеКомпанииПоМаркеДЦ(Марка_,ПодразделениеОбслуживания_.ДилерскийЦентр);
				Если НЕ обЗначениеНеЗаполнено(ПодразделениеКомпании_) Тогда
					Если ПодразделениеКомпании <> ПодразделениеКомпании_ Тогда
						ПодразделениеКомпании = ПодразделениеКомпании_;
						ОбновитьНадписьОбщихРеквизитов = Истина;
					КонецЕсли;
					Если Организация <> ПодразделениеКомпании.Организация Тогда	 
						Организация = ПодразделениеКомпании.Организация;
						ОбновитьНадписьОбщихРеквизитов = Истина;
					КонецЕсли;
					Цех_ = СМ_ФормированиеНовыхОбъектов.НайтиЦехОрганизацииВДЦ(ПодразделениеКомпании,ПодразделениеОбслуживания_.ДилерскийЦентр);					                                                              	
					Если Цех <> Цех_ Тогда
						Цех = Цех_;
					КонецЕсли;	
					Если Не ОбЗначениеНеЗаполнено(Контрагент) Тогда
						Если Не ОбЗначениеНеЗаполнено(Организация) Тогда
							ДоговорВзаиморасчетов_ = СМ_ФормированиеНовыхОбъектов.НайтиСоздатьДоговорНеИстекший(Контрагент,Организация,ПодразделениеКомпании,Перечисления.ВидыДоговоров.Продажа,Дата); 
							Если ДоговорВзаиморасчетов <> ДоговорВзаиморасчетов_ Тогда
								ДоговорВзаиморасчетов = ДоговорВзаиморасчетов_;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Дисп_ = Справочники.Сотрудники.НайтиПоНаименованию(ПараметрыСеанса.Пользователь.Наименование);
				Если Диспетчер <> Дисп_ Тогда
					Диспетчер = Дисп_;	
				КонецЕсли;							
				Если ОбновитьНадписьОбщихРеквизитов Тогда
					УстановитьНовыйНомер();
					#Если Клиент Тогда
						Попытка зфОрганизацияПодразделениеИндикация(ЭтаФорма); Исключение КонецПопытки;	
					#КонецЕсли
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;		
	
КонецПроцедуры	
