// Формирует отчет история по заказ нарядам
Процедура ОтчетИсторияПоЗаказНарядам() Экспорт
	ОзнакомленСИсторией = Истина;
	ДатаНачала = ДобавитьМесяц(НачалоМесяца(Дата), -12);
	ДатаОкончания = КонецМесяца(Дата);
	
	// заполним параметры отчета
	Отчет = Отчеты.ИсторияПоЗаказНарядамРек.Создать();
	Отчет.ЗаполнитьНачальныеНастройки();
	
	ВариантОтчета = Отчет.СхемаКомпоновкиДанных.ВариантыНастроек.Основной;
	ВариантОтчета.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", ДатаНачала);
	ВариантОтчета.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", ДатаОкончания);
	ВариантОтчета.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВалютаОтчета",  ВалютаДокумента);
	
	Если ТипЗнч(Автомобиль) = Тип("СправочникСсылка.Автомобили") И ЗначениеЗаполнено(Автомобиль) Тогда
		ОтчетыСервер.КомпоновщикУстановитьОтбор(ВариантОтчета.Настройки, "Автомобиль", Автомобиль);
	Иначе
		ТекстПредупреждения = "В заявке необходимо указать автомобиль из справочника!";
		#Если Клиент Тогда
			Предупреждение(ТекстПредупреждения,, "История по заказ-нарядам");
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("КлючВарианта", ВариантОтчета.Имя);
	СтруктураПараметров.Вставить("ПредставлениеВарианта", ВариантОтчета.Представление);
	СтруктураПараметров.Вставить("Вариант", ВариантОтчета.Настройки);
	СтруктураПараметров.Вставить("СхемаКомпоновки", ПоместитьВоВременноеХранилище(Отчет.СхемаКомпоновкиДанных));
	СтруктураПараметров.Вставить("СформироватьПриОткрытии", Истина);
	
	ИмяФормыОтчета = Отчет.Метаданные().ПолноеИмя() + ".Форма";
	ФормаОтчета = ПолучитьФорму(ИмяФормыОтчета, СтруктураПараметров);
	ФормаОтчета.ДатаНачала = ДатаНачала;
	ФормаОтчета.ДатаОкончания = ДатаОкончания;
	ФормаОтчета.Открыть();
	
КонецПроцедуры

Процедура ЗаменаСклдавПодчиненомЗН() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказНаряд.Ссылка
	               |ИЗ
	               |	Документ.ЗаказНаряд КАК ЗаказНаряд
	               |ГДЕ
	               |	НЕ ЗаказНаряд.Состояние В (&Состояние)
	               |	И ЗаказНаряд.ДокументОснование = &ДокументОснование";
	мСостояний = Новый Массив;
	мСостояний.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	мСостояний.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Выполнен);
	Запрос.УстановитьПараметр("Состояние",мСостояний);
	Запрос.УстановитьПараметр("ДокументОснование",Ссылка);

	Результат = Запрос.Выполнить().Выбрать();
	Текст = "Заментить склад в следующих заказ-нарядов "  ;
	Флаг = Ложь;
	Пока Результат.Следующий() цикл
		Флаг = Истина;
		Текст = Текст +" "+Результат.Ссылка;
	КонецЦикла;
	#Если Клиент Тогда	
	Если Флаг тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Ответ = Вопрос(Текст, Режим, 0);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Результат.Сбросить();
			Пока    Результат.Следующий() цикл
				ДокументОбъект = Результат.Ссылка.ПОлучитьОбъект();
				
				Для Каждого стр из ДокументОбъект.Товары цикл
					стр.СкладКомпании = СкладКомпании;
					
				КонецЦикла;
				
				Попытка
					ДокументОбъект.Записать();
					
				Исключение
					Сообщить(ОписаниеОшибки()) ;
                 КонецПопытки;
			КонецЦикла;	
		КонецЕсли; 
		
		
	КонецЕсли; 
	  #КонецЕсли

  КонецПроцедуры	
  
