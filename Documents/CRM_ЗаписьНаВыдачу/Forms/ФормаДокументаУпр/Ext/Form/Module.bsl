&Насервере
Процедура ПолучитьСписокСтатусов(Статусы)
	Для Каждого Эл Из Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу Цикл 
		Статусы.Добавить(Эл) 
	КонецЦикла;	
КонецПроцедуры 

&НаКлиенте
Процедура кнСтатус(Команда)
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		Статусы = Новый СписокЗначений;
		ПолучитьСписокСтатусов(Статусы);	
		Статусы.НайтиПоЗначению(Объект.Статус).Пометка = Истина;

		Парам = Новый Структура;
		Парам.Вставить("Список",Статусы);
		Парам.Вставить("Заголовок","Статусы записи на выдачу");
		Парам.Вставить("МножественныйВыбор",Ложь);
		Парам.Вставить("КоличествоЭлементовВСтроке",3);
		Парам.Вставить("ШиринаЭлемента",19);
		Парам.Вставить("ВысотаЭлемента",3);
		Статус = ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
	КонецЕсли;
	
	Если Статус <> Неопределено Тогда 
		Объект.Статус = Статус;
		Модифицированность = Истина;
	КонецЕсли;
	УправлениеЭлементами();
КонецПроцедуры

Процедура УправлениеЭлементами()
	
	Элементы.кнСтатус.Заголовок = "Статус:" + Символы.ПС + Объект.Статус;
	
КонецПроцедуры


