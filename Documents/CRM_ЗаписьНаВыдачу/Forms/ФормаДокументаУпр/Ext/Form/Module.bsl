&НаКлиенте
Процедура ДатаВыдачиПриИзменении(Элемент)
	
	Если Объект.ДатаВыдачи = Неопределено И Не Объект.ДатаНачала = Неопределено Тогда
		Объект.ДатаВыдачи = Объект.ДатаНачала + 60*Объект.Продолжительность;
	ИначеЕсли Не Объект.ДатаВыдачи = Неопределено И Объект.ДатаНачала = Неопределено Тогда		
		Объект.ДатаНачала = Объект.ДатаВыдачи - 60*Объект.Продолжительность;
	Иначе
		Если Объект.ДатаВыдачи < Объект.ДатаНачала Тогда
			Сообщить("Дата выдачи не может быть меньше Даты начала!"); 
			Объект.ДатаВыдачи = Объект.ДатаНачала;
		КонецЕсли;
		Объект.Продолжительность = (Объект.ДатаВыдачи - Объект.ДатаНачала) / 60;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)

	Если Не Объект.ДатаВыдачи = Неопределено И Объект.ДатаНачала = Неопределено Тогда		
		Объект.ДатаНачала = Объект.ДатаВыдачи - 60*Объект.Продолжительность;
	ИначеЕсли Объект.ДатаВыдачи = Неопределено И Не Объект.ДатаНачала = Неопределено Тогда
		Объект.ДатаВыдачи = Объект.ДатаНачала + 60*Объект.Продолжительность;
	Иначе
		Если Объект.ДатаВыдачи < Объект.ДатаНачала Тогда
			Сообщить("Дата начала не может быть больше Даты выдачи!");
			Объект.ДатаНачала = Объект.ДатаВыдачи;
		КонецЕсли;
		Объект.Продолжительность = (Объект.ДатаВыдачи - Объект.ДатаНачала) / 60;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПродолжительностьПриИзменении(Элемент)
	
	Если Не Объект.ДатаНачала = Неопределено Тогда
		Объект.ДатаВыдачи = Объект.ДатаНачала + 60*Объект.Продолжительность;
	ИначеЕсли Не Объект.ДатаВыдачи = Неопределено И Объект.ДатаНачала = Неопределено Тогда		
		Объект.ДатаНачала = Объект.ДатаВыдачи - 60*Объект.Продолжительность;
	КонецЕсли;
	
КонецПроцедуры

