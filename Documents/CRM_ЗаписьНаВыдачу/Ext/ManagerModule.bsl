
Функция ПолучитьДанныеПечати(знач МассивДокументов, знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, ПолучитьДанныеОбъекта(ОбъектСсылка, ИмяМакета));
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ОписаниеОбластей.Вставить(ИмяМакета, ПолучитьОписаниеОбластейМакетаОфисногоДокумента());
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие;
	
	Для Каждого ИмяМакета Из МассивИменМакетов Цикл
		Если ИмяМакета = "ПФ_DOC_Выдача" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, Renault_УправлениеПечатью.ПолучитьМакет("Документ.CRM_ЗаписьНаВыдачу.ПФ_DOC_Выдача"));
			ТипыМакетов.Вставить(ИмяМакета, "DOC");
		ИначеЕсли ИмяМакета = "ПФ_MXL_СертификатКонтроля" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, Renault_УправлениеПечатью.ПолучитьМакет("Документ.CRM_ЗаписьНаВыдачу.ПФ_MXL_СертификатКонтроля"));
			ТипыМакетов.Вставить(ИмяМакета, "MXL");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Данные, Макеты",
							ДанныеПоВсемОбъектам,
							Новый Структура("ОписаниеОбластей, ТипыМакетов, ДвоичныеДанныеМакетов",
											ОписаниеОбластей,
											ТипыМакетов,
											ДвоичныеДанныеМакетов));
	
КонецФункции

Функция ПолучитьДанныеОбъекта(СсылкаНаОбъект, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	*
	               |ИЗ
	               |	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу
	               |ГДЕ
	               |	CRM_ЗаписьНаВыдачу.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда		
		
		ДанныеОбъекта = Новый Структура;
		
		ДанныеОбъекта.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеОбъекта.Вставить("Дата", Формат(Выборка.Дата, "ДФ='дд ММММ гггг'"));		
		
		ВыборкаАвтомобилиДляВыдачи = Выборка.АвтомобилиДляВыдачи.Выбрать();
		
		Если ВыборкаАвтомобилиДляВыдачи.Следующий() Тогда
			ДанныеОбъекта.Вставить("Автомобиль", ВыборкаАвтомобилиДляВыдачи.Автомобиль);
			ДанныеОбъекта.Вставить("VIN", ВыборкаАвтомобилиДляВыдачи.VIN);
		КонецЕсли;
		
		//Клиент
		
		ДанныеОбъекта.Вставить("Клиент", Выборка.Клиент);
		Возврат ДанныеОбъекта;
		
	Иначе
		Возврат Неопределено;		
	КонецЕсли;
		
КонецФункции

Функция ПолучитьОписаниеОбластейМакетаОфисногоДокумента()
	
	ОписаниеОбластей = Новый Структура;
	
	Renault_УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Заголовок", "Общая");
	
	Возврат ОписаниеОбластей;
	
КонецФункции

Функция ПолучитьЗаписьНаВыдачуПоРЛиДоговору (VIN = Неопределено, ДоговорНаПродажуАвтомобиля = Неопределено) Экспорт
	Если  VIN = Неопределено или ДоговорНаПродажуАвтомобиля = Неопределено  Тогда
		Возврат(Неопределено);
	КонецЕсли;
	 	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_ЗаписьНаВыдачу.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу
		|ГДЕ
		|	CRM_ЗаписьНаВыдачу.VIN = &VIN
		|	И CRM_ЗаписьНаВыдачу.ДоговорНаПродажуАвтомобиля = &ДоговорНаПродажуАвтомобиля";
	
	Запрос.УстановитьПараметр("VIN", VIN);
	Запрос.УстановитьПараметр("ДоговорНаПродажуАвтомобиля", ДоговорНаПродажуАвтомобиля);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	 Возврат(Неопределено);
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

КонецФУнкции