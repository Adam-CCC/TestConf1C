	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	//Если СогласиеНаОбработкуПерсональныхДанных.Пустая() Тогда 
	//	Сообщить("Согласие на обработку персональных данных является обязательным",СтатусСообщения.Внимание);
	//	Отказ=Истина;
	//КонецЕсли;
	
	Если АвтомобилиДляВыдачи.Количество() 
			И АвтомобилиДляВыдачи.НайтиСтроки(Новый Структура("Автомобиль", Справочники.Автомобили.ПустаяСсылка())).Количество() Тогда
		Сообщить("В документе не может быть строк без выбранного автомобиля", СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;
	
	СоздатьЗаявкуНаУтверждение = Ложь;
	Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
		Если Не РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			Если ДатаНачала<НачалоМесяца(ТекущаяДата())
				И ДатаВыдачи<>Ссылка.ДатаВыдачи
				И Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан Тогда   
				Если ЭтоНовый() Тогда
					СоздатьЗаявкуНаУтверждение = Истина;
					Утверждена = Ложь;
				Иначе
					Утверждена = ЗаявкаУтверждена(Ссылка);
					Если Утверждена = Неопределено Тогда
						СоздатьЗаявкуНаУтверждение = Истина;
						Утверждена = Ложь;
					КонецЕсли;
				КонецЕсли;
				Если Не Утверждена Тогда 
					РежимЗаписи = РежимЗаписиДокумента.Запись;					
					Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик;
					Если Не СоздатьЗаявкуНаУтверждение Тогда
						Сообщить("Выдача автомобиля VIN " + VIN + " прошлым периодом не утверждена.");
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	СтрокаАвтомобили = "";
	НужнаЗапятая = Ложь;
	Для Каждого Стр Из АвтомобилиДляВыдачи Цикл
		Если НужнаЗапятая Тогда
			СтрокаАвтомобили = СтрокаАвтомобили + ", ";
		Иначе
			НужнаЗапятая = Истина;
		КонецЕсли;
		СтрокаАвтомобили = СтрокаАвтомобили + Стр.VIN;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Ссылка)
		И Ссылка.Статус <> Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан 
		И Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_ЗаписьНаВыдачу.Ссылка
		|ИЗ
		|	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу
		|ГДЕ
		|	CRM_ЗаписьНаВыдачу.Статус <> &Статус
		|	И CRM_ЗаписьНаВыдачу.Ссылка <> &Ссылка
		|	И CRM_ЗаписьНаВыдачу.IDK = &IDK";
		
		Запрос.УстановитьПараметр("IDK", IDK);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Статус", Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан);
		
		Если Запрос.Выполнить().Пустой() Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ *
			|ИЗ
			|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
			|ГДЕ
			|	Renault_РабочиеЛисты.IDK = &IDK");
			Запрос.УстановитьПараметр("IDK", IDK);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				МенеджерРЛ = РегистрыСведений.Renault_РабочиеЛисты.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МенеджерРЛ, Выборка);
				МенеджерРЛ.Прочитать();
				МенеджерРЛ.ЛистЗакрыт = ?(ДилерскийЦентр.ЗакрыватьРЛПриВыдаче, Ложь, Истина);
				МенеджерРЛ.ПричинаЗакрытия = Справочники.CRM_ПричиныЗакрытияРЛ.УспешнаяПродажа;
				МенеджерРЛ.ЗапросНаЗакрытие = Истина;
				МенеджерРЛ.ДатаЗапросаНаЗакрытие = ТекущаяДата();
				МенеджерРЛ.КомментарийЗакрытия = "";
				МенеджерРЛ.Записать();
			КонецЕсли;
		КонецЕСли;
	КонецЕсли;	
	
	//проверка факта выдачи
	Если Статус=Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан И Статус<>Ссылка.Статус Тогда
		ДополнительныеСвойства.Вставить("ПроизошлаВыдача",Истина)
	ИначеЕсли Не Ссылка.Пустая() И Статус<>Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан И Статус<>Ссылка.Статус Тогда
		ДополнительныеСвойства.Вставить("ПроизошлаВыдача",Ложь)	
	Иначе	
		ДополнительныеСвойства.Вставить("ПроизошлаВыдача",Неопределено)
	КонецЕсли;	

КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если СоздатьЗаявкуНаУтверждение Тогда
		Запись = РегистрыСведений.VAZ_УтверждениеДокументов.СоздатьМенеджерЗаписи();
		Запись.Объект = Ссылка;
		Запись.Записать();
		Сообщить("Создана заявка для утверждения выдачи автомобиля VIN " + VIN + " прошлым периодом.");
	КонецЕсли;
	
КонецПроцедуры

Функция ЗаявкаУтверждена(Ссылка)
	Запрос = Новый Запрос("ВЫБРАТЬ Утвержден, ДатаУтверждения ИЗ РегистрСведений.VAZ_УтверждениеДокументов ГДЕ Объект=&Объект");
	Запрос.УстановитьПараметр("Объект",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Утвержден = Выборка.Утвержден;
	КонецЦикла;	
	Возврат Утвержден;  
КонецФункции	
