Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Автомобили к выдаче
	Движения.Renault_АвтомобилиКВыдаче.Записывать = Истина;
	Движения.Renault_АвтомобилиКВыдаче.Очистить();
	
	Движения.CRM_АвтомобилиВыданные.Записывать = Истина;
	Движения.CRM_АвтомобилиВыданные.Очистить();

	
	Renault_CRM.Воронка_ВыдачаАвто_Снять(IDK, Ссылка);
	Renault_CRM.Статистика_Снять(Справочники.CRM_ЭтапыПродаж.ВыдачаАвтомобиля, IDK, Ссылка);
	
	// регистр Renault_АвтомобилиКВыдаче Расход
		
	Если Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан
			ИЛИ Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик Тогда
			
			Для Каждого Строка Из АвтомобилиДляВыдачи Цикл
				
				Если Строка.Выбран И ЗначениеЗаполнено(Строка.VIN) Тогда
					Движение = Движения.Renault_АвтомобилиКВыдаче.Добавить();
					Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
					Движение.Период = Дата;
					Движение.РабочийЛист = IDK;
					Движение.Автомобиль = Строка.Автомобиль;
					Движение.VIN = Строка.VIN;
					Движение.Количество = 1;
				КонецЕсли;
			КонецЦикла;
		
	КонецЕсли;
		
	Если Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Выдан Тогда
		
		//Воронка
		Если АвтомобилиДляВыдачи.Количество() > 0 Тогда
			Renault_CRM.Воронка_ВыдачаАвто_Установить(IDK, Ссылка, ДатаВыдачи);
			Renault_CRM.Статистика_Установить(Справочники.CRM_ЭтапыПродаж.ВыдачаАвтомобиля, IDK, Ссылка, , ДатаВыдачи, АвтомобилиДляВыдачи[0].Автомобиль.Модель);
		КонецЕсли;
		
		//Автомобили выданные
		Для Каждого Строка Из АвтомобилиДляВыдачи Цикл
			Если Строка.Выбран И ЗначениеЗаполнено(Строка.VIN) Тогда
				НовЗапись = Движения.CRM_АвтомобилиВыданные.Добавить();
				НовЗапись.VIN = Строка.VIN;
				НовЗапись.ДатаВыдачи = ДатаВыдачи;
				НовЗапись.Регистратор = Ссылка;
				НовЗапись.Период =ДатаВыдачи;
				ДЦ = Неопределено;
				
				Если ЗначениеЗаполнено(IDK) Тогда
					Запись = Renault_CRM.докПолучитьЗаписьРЛПоIDK(IDK);
					Если Запись <> Неопределено Тогда 
						ДЦ = Запись.ДилерскийЦентр;
						Если ДЦ.СинхронизированСПланшетомПродавца = Истина Тогда
							АвтомобильИД = Строка(Строка.Автомобиль.Ссылка.УникальныйИдентификатор());
							мПараметры = Новый Массив;
							мПараметры.Добавить(АвтомобильИД);
							//ФоновыеЗадания.Выполнить("Renault_РаботаСSalesTablet.УдалитьАвтоИзСклада", мПараметры);
							//Renault_РаботаСSalesTablet.УдалитьАвтоИзСклада(АвтомобильИД);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		
		
	ИначеЕсли Статус = Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Черновик Тогда
		
		////Черновики - в записи на выдачу
		//Запись = РегистрыСведений.CRM_ЗаписиНаВыдачу.СоздатьМенеджерЗаписи();
		//Запись.Клиент = Клиент;
		//Запись.Документ = Ссылка;
		//Запись.Менеджер = Менеджер;
		//Запись.Записать();
	Иначе
		//
	КонецЕсли;
	
	////сервис статистики передачи авто
	Если Не Отказ И LADA_Services.ВыгрузкаВыдачиАвтомобиля(ЭтотОбъект.Ссылка,Отказ) Тогда Иначе 
		//последствия ...
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Renault_CRM.Воронка_ВыдачаАвто_Снять(IDK, Ссылка);	
	УдалитьЗаписиНаВыдачу();
	
	//сервис статистики передачи авто
	Если Не Отказ И LADA_Services.ВыгрузкаВыдачиАвтомобиля(ЭтотОбъект.Ссылка,Отказ) Тогда Иначе 
		//последствия ...
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьЗаписиНаВыдачу()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	CRM_ЗаписиНаВыдачу.Регистратор,
	               |	CRM_ЗаписиНаВыдачу.НомерСтроки,
	               |	CRM_ЗаписиНаВыдачу.Активность,
	               |	CRM_ЗаписиНаВыдачу.Автомобиль,
	               |	CRM_ЗаписиНаВыдачу.Менеджер,
	               |	CRM_ЗаписиНаВыдачу.ДатаНачала,
	               |	CRM_ЗаписиНаВыдачу.Клиент,
	               |	CRM_ЗаписиНаВыдачу.Документ
	               |ИЗ
	               |	РегистрСведений.CRM_ЗаписиНаВыдачу КАК CRM_ЗаписиНаВыдачу
	               |ГДЕ
	               |	CRM_ЗаписиНаВыдачу.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = РегистрыСведений.CRM_ЗаписиНаВыдачу.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

