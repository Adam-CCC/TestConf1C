Функция ПолучитьМойки()
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаМойку.Ссылка,
	               |	Renault_CRM_ЗаявкаНаМойку.Дата,
	               |	Renault_CRM_ЗаявкаНаМойку.ДилерскийЦентр,
	               |	Renault_CRM_ЗаявкаНаМойку.Клиент,
	               |	Renault_CRM_ЗаявкаНаМойку.ВремяНачала,
	               |	Renault_CRM_ЗаявкаНаМойку.ВремяОкончания,
	               |	Renault_CRM_ЗаявкаНаМойку.Машиноместо,
	               |	Renault_CRM_ЗаявкаНаМойку.ГосНомер,
	               |	Renault_CRM_ЗаявкаНаМойку.Автомобиль,
	               |	Renault_CRM_ЗаявкаНаМойку.Обращение,
	               |	Renault_CRM_ЗаявкаНаМойку.Длительность,
	               |	Renault_CRM_ЗаявкаНаМойку.РаботаМойка,
	               |	Renault_CRM_ЗаявкаНаМойку.Платная,
	               |	Renault_CRM_ЗаявкаНаМойку.Стоимость
	               |ИЗ
	               |	Документ.Renault_CRM_ЗаявкаНаМойку КАК Renault_CRM_ЗаявкаНаМойку
	               |ГДЕ
	               |	Renault_CRM_ЗаявкаНаМойку.Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Обращение);
	
	Мойки = Запрос.Выполнить().Выгрузить();
	
	Возврат Мойки;

КонецФункции

Процедура ЗаполнитьОбластьКомментариев(ОбластьКомментариев)
	
	Комментарии = "";
	ЭтоПерв = Истина;
	Для Каждого Описание Из Товары Цикл
		Если Описание.ВНаличииУКлиента = Истина Тогда
			Если ЭтоПерв Тогда
				Комментарии = Описание.Номенклатура.Наименование;
				ЭтоПерв = Ложь;
			Иначе
				Комментарии = Комментарии + ", " + Описание.Номенклатура.Наименование;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если не ЭтоПерв Тогда
		ОбластьКомментариев.Параметры.Комментарии = Комментарии + " предоставлены клиентом"; 
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьВторуюСтраницу(ВтораяСтраница, СвязаннаяПриемка, СвязаннаяВыдача)
	
	Если ЗначениеЗаполнено(СвязаннаяПриемка) Тогда
		ВтораяСтраница.Параметры.МастерПриемщикРас = СвязаннаяПриемка.Машиноместо;
	КонецЕсли;
	
	Если Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо тогда
		ВтораяСтраница.Параметры.ЗаказчикРас2 = "";
	Иначе
		ВтораяСтраница.Параметры.ЗаказчикРас2 = Клиент.Фамилия + " " + Лев(Клиент.Имя, 1) + "." + Лев(Клиент.Отчество, 1) + ".";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
		ВтораяСтраница.Параметры.ВидОплаты = ЗаказНаряд.ВидОплаты;
	Иначе
		
		#Если Клиент Тогда
			
			Если ДилерскийЦентр.Автосервис_ЗапрашиватьВидОплаты Тогда
				
				Форма = Перечисления.ВидыОплаты.ПолучитьФормуВыбора();
				
				Ответ = Форма.ОткрытьМодально();
				
				Если ЗначениеЗаполнено(Ответ) Тогда
					
					ВтораяСтраница.Параметры.ВидОплаты = Ответ;
					ЭтотОбъект.ВидОплаты = Ответ;
					
				Иначе
					
					ВтораяСтраница.Параметры.ВидОплаты = Перечисления.ВидыОплаты.НаличныйРасчет;
					ЭтотОбъект.ВидОплаты = Перечисления.ВидыОплаты.НаличныйРасчет;
					
				КонецЕсли;
				
			Иначе
				
				ВтораяСтраница.Параметры.ВидОплаты = Перечисления.ВидыОплаты.НаличныйРасчет;
				ЭтотОбъект.ВидОплаты = Перечисления.ВидыОплаты.НаличныйРасчет; 
				
			КонецЕсли;
			
			ЭтотОбъект.Записать();
			
		#КонецЕсли
		
	КонецЕсли;
	
	Если Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо тогда
		ВтораяСтраница.Параметры.ЗаказчикРас = "_____________";
	Иначе
		ВтораяСтраница.Параметры.ЗаказчикРас = Клиент.Фамилия + " " + Лев(Клиент.Имя, 1) + "." + Лев(Клиент.Отчество, 1) + ".";
	КонецЕсли;
	ПоврежденияАвто = ПолучитьПовреждения(Автомобиль);
	ОбнаруженныеПоврежденияАвтомобиля = ОтобразитьПовреждения(ВтораяСтраница, ПоврежденияАвто);
	ВтораяСтраница.Параметры.ОбнаруженныеПоврежденияАвтомобиля = ОбнаруженныеПоврежденияАвтомобиля;
	
	ВтораяСтраница.Параметры.ДатаСдачи = ТекущаяДата();
	
	//ВтораяСтраница.Параметры.ЮрИнфа = ДилерскийЦентр.Автосервис_ЮрИнфаЗаявка;
	
	Рекомендации = ПолучитьРекомендуемыеРаботы(СвязаннаяПриемка);
	ВтораяСтраница.параметры.Рекомендации = Рекомендации;
	ЮрНаименование = ?(ЗначениеЗаполнено(ДилерскийЦентр.Организация), ДилерскийЦентр.Организация.НаименованиеПолное, ДилерскийЦентр.Наименование)+
	" адрес: " + ДилерскийЦентр.ОсновнойАдрес;
	ВтораяСтраница.Параметры.ДилерскаяИнформация = ЮрНаименование;
	
КонецПроцедуры

Функция ПолучитьСвязаннуюПриемкуАвто()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	| Renault_CRM_ПриемкаАвтомобиля.Ссылка КАК Приемка
	|ИЗ
	| Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
	|ГДЕ
	| Renault_CRM_ПриемкаАвтомобиля.Обращение.Ссылка = &Обращение");
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Приемка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

