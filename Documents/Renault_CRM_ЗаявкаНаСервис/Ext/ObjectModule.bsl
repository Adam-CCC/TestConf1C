			НоваяСтрока.Количество = СтрокаРабот.Количество;
		Иначе
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.Количество = СтрокаРабот.Длительность;
		КонецЕсли;
		НоваяСтрока.СуммаВсего = СтрокаРабот.Цена*НоваяСтрока.Количество;
	КонецЦикла;
		
	Если НЕ ЗначениеЗаполнено(ТипЦен) Тогда
			
		НовыйСчет.ТипЦен = ЭтотОбъект.ДилерскийЦентр.Автосервис_ТипЦенПродажи;
			
	КонецЕсли;
	
	НовыйСчет.Записать();
	Если СтрокаСчета <> Неопределено Тогда
		СтрокаСчета.СчетНаОплату = НовыйСчет.Ссылка;
	Иначе
		СтрокаСчета = СчетаНаОплату.Добавить();
		СтрокаСчета.СчетНаОплату = НовыйСчет.Ссылка;
		СтрокаСчета.ЭтоСчетНаРаботы = Истина;
	КонецЕсли;
	ЭтотОбъект.Записать();
	
КонецПроцедуры


Функция ПечатьРабочейКарты(СсылкаНаОбъект) Экспорт
	

	ТабДокумент = Новый ТабличныйДокумент;
	Если НЕ ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат ТабДокумент;
	КонецЕсли;
	
	Макет = ПолучитьОбщийМакет("Renault_ШтампЧасыЗаявкиНаСервис");	
		
   	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьЗаголовокТаблицыРаботы = Макет.ПолучитьОбласть("ЗаголовокТаблицыРаботы");
	ОбластьСтрокаРаботы = Макет.ПолучитьОбласть("СтрокаРаботы");

	ОбластьШапка.Параметры.НомерКарты = СсылкаНаОбъект.Номер;	
	ОбластьШапка.Параметры.ДатаКарты = Формат(СсылкаНаОбъект.Дата,"ДЛФ=Д");	
	
	ОбластьШапка.Параметры.ЗаявкаНаРемонт = СсылкаНаОбъект.Номер;	
	Если  ЗначениеЗаполнено(СсылкаНаОбъект.ЗаказНаряд) Тогда
		ОбластьШапка.Параметры.НомерЗаказНаряда = СсылкаНаОбъект.ЗаказНаряд.Номер;	
		ОбластьШапка.Параметры.ДатаЗаказНаряда = Формат(СсылкаНаОбъект.ЗаказНаряд.Дата,"ДЛФ=Д");	
		ОбластьШапка.Параметры.Комментарии = Строка(СсылкаНаОбъект.ЗаказНаряд.ПричинаОбращения);	
	Иначе
		Если ЗначениеЗаполнено(СсылкаНаОбъект.Обращение) Тогда
			ОбластьШапка.Параметры.Комментарии = СсылкаНаОбъект.Обращение.Примечание;
		КонецЕсли;
	КонецЕсли; 
	
		
	// -- приемка
	Если значениеЗаполнено(СсылкаНаОбъект.Обращение) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Renault_CRM_ПриемкаАвтомобиля.Ссылка КАК Приемка
		|ИЗ
		| Документ.Renault_CRM_ПриемкаАвтомобиля КАК Renault_CRM_ПриемкаАвтомобиля
		|ГДЕ
		| Renault_CRM_ПриемкаАвтомобиля.Обращение.Ссылка = &Обращение");
		Запрос.УстановитьПараметр("Обращение", СсылкаНаОбъект.Обращение);
		Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
			СвязаннаяПриемка = Выборка.Приемка;
		    ОбластьШапка.Параметры.МастерПриемщик  = СвязаннаяПриемка.Машиноместо;
			Если СвязаннаяПриемка.КлиентБудетОжидатьОкончаниеРемонта = истина Тогда
				ОбластьШапка.Параметры.КлиентОжидает = "Клиент ожидает";
			Иначе
				ОбластьШапка.Параметры.КлиентОжидает = "Клиент уехал";
			КонецЕсли;
			
			Если  СвязаннаяПриемка.СохранятьЗамененныеЗЧ = истина Тогда
				ОбластьШапка.Параметры.СохранятьЗЧ = "ДА";
			Иначе
				ОбластьШапка.Параметры.СохранятьЗЧ = "НЕТ";
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;
	// --- вр начала
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка,
	               |	МИНИМУМ(Renault_CRM_ЗаявкаНаСервисЭтапы.НачалоЭтапа) КАК НачалоЭтапа,
	               |	МАКСИМУМ(Renault_CRM_ЗаявкаНаСервисЭтапы.КонецЭтапа) КАК КонецЭтапа,
	               |	СУММА(Renault_CRM_ЗаявкаНаСервисЭтапы.ДлительностьЭтапаПлан) КАК ДлительностьЭтапаПлан,
	               |	СУММА(Renault_CRM_ЗаявкаНаСервисЭтапы.ДлительностьЭтапаФакт) КАК ДлительностьЭтапаФакт,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Renault_CRM_ЗаявкаНаСервисЭтапы.Этап) КАК Этап,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Renault_CRM_ЗаявкаНаСервисЭтапы.НомерСтроки) КАК НомерСтроки
	               |ИЗ
	               |	Документ.Renault_CRM_ЗаявкаНаСервис.Этапы КАК Renault_CRM_ЗаявкаНаСервисЭтапы
	               |ГДЕ
	               |	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",СсылкаНаОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		 ОбластьШапка.Параметры.ВрНачала = Формат(Выборка.НачалоЭтапа,"ДФ=""дд.ММ.гггг ЧЧ:мм""");
		 ОбластьШапка.Параметры.ВрОкончания = Формат(Выборка.КонецЭтапа,"ДФ=""дд.ММ.гггг ЧЧ:мм""");
	КонецЕсли;
	// ---
	//  ---- повреждения
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ПоврежденияКузоваСрезПоследних.Повреждение КАК Повреждение,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Повреждение.Описание КАК НаименованиеПовреждения,
	               |	Renault_ПоврежденияКузоваСрезПоследних.ЗонаПовреждения КАК ЗонаПовреждения,
	               |	Renault_ПоврежденияКузоваСрезПоследних.ЗонаПовреждения.ИмяЭлемента КАК ИмяЭлемента,
	               |	Renault_ПоврежденияКузоваСрезПоследних.ЗонаПовреждения.ОтображаемаяЗона КАК Отображать,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Значение КАК Значение,
	               |	Renault_ПоврежденияКузоваСрезПоследних.СтепеньПовреждения КАК СтепеньПовреждения,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Комментарий КАК Комментарий,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Авторабота КАК Авторабота
	               |ИЗ
	               |	РегистрСведений.Renault_ПоврежденияКузова.СрезПоследних(
	               |			,
	               |			Автомобиль = &Автомобиль
	               |				И Обращение = &Обращение) КАК Renault_ПоврежденияКузоваСрезПоследних";
	
	Запрос.УстановитьПараметр("Автомобиль", СсылкаНаОбъект.Автомобиль);
	Запрос.УстановитьПараметр("Обращение", СсылкаНаОбъект.Обращение.Ссылка);
	ТаблицаПовреждений = Запрос.Выполнить().Выгрузить();
	
	// ------------------------------------------------
	СписокПовреждений = "";
	нпп = 1;
	ЭтоПерв = Истина;
	Для Каждого Строка из ТаблицаПовреждений Цикл
		 
		Если Строка.ЗонаПовреждения.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
 
		Если Строка.Отображать = Истина Тогда
			Если Не ЗначениеЗаполнено(Строка.Повреждение) И Не ЗначениеЗаполнено(Строка.ЗонаПовреждения) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЭтоПерв = Истина Тогда
				 ЭтоПерв = Ложь;
				СписокПовреждений = "1. " + СформироватьНазваниеПовреждения(Строка);
			Иначе
				СписокПовреждений = СписокПовреждений + Символы.ПС + СтрЗаменить(Строка(нпп), Символы.НПП, "") + ". " +
				СформироватьНазваниеПовреждения(Строка);
			КонецЕсли;
			
			
			нпп = нпп+1;
			
		ИначеЕсли Строка.Повреждение = Справочники.Renault_Автосервис_Повреждения.УровеньТоплива Тогда
			
			
			
		Иначе //Если Строка.Повреждение = Справочники.Renault_Автосервис_Повреждения.КомментарийАктОсмотра Тогда
			Если ЗначениеЗаполнено(Строка.Повреждение) Тогда
				СписокПовреждений = СписокПовреждений + Символы.ПС + СтрЗаменить(Строка(нпп), Символы.НПП, "") + ". " +
				СформироватьНазваниеПовреждения(Строка);
				нпп = нпп+1;
				ЭтоПерв = Ложь;
			КонецЕсли;
		КонецЕсли;		
		
	КонецЦикла;
	
	//Если ДилерскийЦентр.Автосервис_ИспользуетсяПланшет Тогда  
	//	ДополнительныеСведения = Renault_АвтосервисСервер.ПолучитьВсеПрочиеПовреждения(Ссылка,нпп);	  
	//	СписокПовреждений =СписокПовреждений + Символы.ПС + ДополнительныеСведения;
	//КонецЕсли;
	
	ОбластьШапка.Параметры.ОбнаруженныеПоврежденияАвтомобиля = СписокПовреждений;
	

	// ---------------------------------------------
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Клиент) Тогда
		кл1 =  СсылкаНаОбъект.Клиент;			
		Если ЗначениеЗаполнено(кл1.Фамилия) Тогда
			ОбластьШапка.Параметры.Заказчик = кл1.Фамилия + " " + кл1.Имя + " " + кл1.Отчество;
		Иначе
			ОбластьШапка.Параметры.Заказчик = кл1.НаименованиеПолное;
		КонецЕсли;
		ТелефонЗаказчика = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(кл1.Ссылка);
		ОбластьШапка.Параметры.ТелефонЗаказчика = ТелефонЗаказчика;
	конецЕсли;
	Если ЗначениеЗаполнено(СсылкаНаОбъект.Автомобиль) Тогда
		авт1 = СсылкаНаОбъект.Автомобиль;		
		ОбластьШапка.Параметры.VIN = авт1.VIN;
		ОбластьШапка.Параметры.ГодВыпуска = формат(авт1.ГодВыпуска,"ДФ=""гггг""");
		Если ЗначениеЗаполнено(авт1.Модель) Тогда
			ОбластьШапка.Параметры.АвтомобильМодель = авт1.Модель;
			//  марка автомобиля
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Ссылка,
			|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Ссылка.Наименование КАК Наименование
			|ИЗ
			|	Справочник.CRM_МаркаАвтомобиля.МоделиАвтомобилей КАК CRM_МаркаАвтомобиляМоделиАвтомобилей
			|ГДЕ
			|	CRM_МаркаАвтомобиляМоделиАвтомобилей.Модель = &Модель";
			Запрос.УстановитьПараметр("Модель",авт1.Модель);
			Выборка =  Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ОбластьШапка.Параметры.АвтомобильМарка =  Выборка.Наименование;
			КонецЕсли;

			
		КонецЕсли;
		Попытка
			Хозяин     = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(авт1, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
			ОбластьШапка.Параметры.Владелец = Хозяин;
			ОбластьШапка.Параметры.ТелефонВладельца = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Хозяин.Ссылка);
		Исключение
		КонецПопытки;
		//Получить последний пробег
		ОбластьШапка.Параметры.Пробег     = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(авт1, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
		//Получить последний ГосНомер
		ОбластьШапка.Параметры.ГосНомер   = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(авт1, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
		//Получить последний техпаспорт
		//Установим формат отображения года выпуска
		//ФорматПредставленияГодаВыпускаАвтомобиля=орПолучитьФорматПредставленияГодаВыпускаАвтомобиля(глПрава);
		//ЭлементыФормы.ГодВыпуска.Формат=ФорматПредставленияГодаВыпускаАвтомобиля;

	конецЕсли;
	ТабДокумент.Вывести(ОбластьШапка);
	
	ТабДокумент.Вывести(ОбластьПустаяСтрока);
	ТабДокумент.Вывести(ОбластьЗаголовокТаблицыРаботы);
	
	Счетчик = 0;
	Для каждого стрРаботы из СсылкаНаОбъект.Работы Цикл
		Счетчик = Счетчик + 1;
		ОбластьСтрокаРаботы.Параметры.НомерСтрокиРаботы = Счетчик;
		ОбластьСтрокаРаботы.Параметры.Работа = Строка(стрРаботы.Работа);
		//ОбластьСтрокаРаботы.Параметры.Артикул = Строка(стрРаботы.Работа.Артикул);
		ТабДокумент.Вывести(ОбластьСтрокаРаботы);

	КонецЦикла;
	// ОбластьСтрокаРаботы
	ТабДокумент.Вывести(ОбластьПустаяСтрока);
	
	// ----
	ОбластьЗаголовокТаблицыВыполненные = Макет.ПолучитьОбласть("ЗаголовокТаблицыВыполненные");
	ОбластьСтрокаВыполненные = Макет.ПолучитьОбласть("СтрокаВыполненные");
	ТабДокумент.Вывести(ОбластьЗаголовокТаблицыВыполненные);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.Ссылка,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDЭтапа
	               |ПОМЕСТИТЬ тРабЭтапы
	               |ИЗ
	               |	Документ.Renault_CRM_ЗаявкаНаСервис.СоставЭтапа КАК Renault_CRM_ЗаявкаНаСервисСоставЭтапа
	               |ГДЕ
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.Ссылка,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDЭтапа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Работа,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Длительность,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Нормочас,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Цена,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Сумма,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.ИдентификаторРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.ДлительностьЗН,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.IDРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.НомерСтроки,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Работа.Артикул КАК Артикул,
	               |	т2.IDЭтапа
	               |ПОМЕСТИТЬ тЭтапСводно
	               |ИЗ
	               |	Документ.Renault_CRM_ЗаявкаНаСервис.Работы КАК Renault_CRM_ЗаявкаНаСервисРаботы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ тРабЭтапы КАК т2
	               |		ПО (т2.Ссылка = Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка)
	               |			И (т2.IDРаботы = Renault_CRM_ЗаявкаНаСервисРаботы.IDРаботы)
	               |ГДЕ
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т3.Ссылка,
	               |	т3.IDЭтапа,
	               |	СУММА(т3.Длительность) КАК СумДлительность,
	               |	СУММА(т3.ДлительностьЗН) КАК СумДлительностьЗН,
