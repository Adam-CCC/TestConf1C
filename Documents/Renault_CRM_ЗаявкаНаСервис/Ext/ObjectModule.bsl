Функция ТелефонСКомментариями(Клиент)

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КонтактнаяИнформация.Представление,
	                      |	КонтактнаяИнформация.Комментарий
	                      |ИЗ
	                      |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                      |ГДЕ
	                      |	КонтактнаяИнформация.Тип = &Тип
	                      |	И КонтактнаяИнформация.ЗначениеПоУмолчанию = ИСТИНА
	                      |	И КонтактнаяИнформация.Объект = &Объект");
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Объект", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Строка(Выборка.Представление) + " " + Строка(Выборка.Комментарий);
	Иначе
		
		Попытка
			
			Телефон = Клиент.ОсновнойТелефон;
			
			Возврат СокрЛП(Телефон);
			
		Исключение
			
			Возврат "";
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецФункции // ТелефонСКомментариями()

Функция ПолучитьПовреждения(Авто)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ПоврежденияКузоваСрезПоследних.Повреждение КАК Повреждение,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Повреждение.Описание КАК НаименованиеПовреждения,
	               |	Renault_ПоврежденияКузоваСрезПоследних.ЗонаПовреждения КАК ЗонаПовреждения,
	               |	Renault_ПоврежденияКузоваСрезПоследних.ЗонаПовреждения.ИмяЭлемента КАК ИмяЭлемента,
	               |	Renault_ПоврежденияКузоваСрезПоследних.ЗонаПовреждения.ОтображаемаяЗона КАК Отображать,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Значение КАК Значение,
	               |	Renault_ПоврежденияКузоваСрезПоследних.СтепеньПовреждения КАК СтепеньПовреждения,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Комментарий КАК Комментарий,
	               |	Renault_ПоврежденияКузоваСрезПоследних.Авторабота КАК Авторабота
	               |ИЗ
	               |	РегистрСведений.Renault_ПоврежденияКузова.СрезПоследних(
	               |			,
	               |			Автомобиль = &Автомобиль
	               |				И Обращение = &Обращение) КАК Renault_ПоврежденияКузоваСрезПоследних";
	
	Запрос.УстановитьПараметр("Автомобиль", Авто);
	Запрос.УстановитьПараметр("Обращение", Обращение.Ссылка);
	ТаблицаПовреждений = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаПовреждений;
	
КонецФункции

Функция ОтобразитьПовреждения(ОбластьПовреждений, ТаблицаПовреждений)
	
	СписокПовреждений = "";
	нпп = 1;
	ЭтоПерв = Истина;
	Для Каждого Строка из ТаблицаПовреждений Цикл
		 
		Если Строка.ЗонаПовреждения.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
 
		Если Строка.Отображать = Истина Тогда
			Если Не ЗначениеЗаполнено(Строка.Повреждение) И Не ЗначениеЗаполнено(Строка.ЗонаПовреждения) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивРисунки = Новый массив();
			МассивРисунки = НайтиРисунокПоИмени(Справочники.Renault_ЗоныПоврежденийАвто.ПолучитьИмяПредопределенного(Строка.ЗонаПовреждения),ОбластьПовреждений);
			Если МассивРисунки.Количество() = 0 Тогда
				МассивРисунки = НайтиРисунокПоИмени(Строка.ЗонаПовреждения.ИмяЭлемента,ОбластьПовреждений);
			КонецЕсли;
			Если ЭтоПерв = Истина Тогда
				 ЭтоПерв = Ложь;
				СписокПовреждений = "1. " + СформироватьНазваниеПовреждения(Строка);
			Иначе
				СписокПовреждений = СписокПовреждений + Символы.ПС + СтрЗаменить(Строка(нпп), Символы.НПП, "") + ". " +
				СформироватьНазваниеПовреждения(Строка);
			КонецЕсли;
			
			Если Строка.повреждение = Справочники.Renault_Автосервис_Повреждения.Удар Тогда				
				Для Каждого Рис Из МассивРисунки Цикл
					Рис.Картинка = БиблиотекаКартинок.Renault_Cross;
				КонецЦикла;
			ИначеЕсли Строка.повреждение = Справочники.Renault_Автосервис_Повреждения.Царапина
					Или Строка.повреждение = Справочники.Renault_Автосервис_Повреждения.ЦарапинаОкраска
					Или Строка.повреждение = Справочники.Renault_Автосервис_Повреждения.ЦарапинаПолировка Тогда
				Для Каждого Рис Из МассивРисунки Цикл
					Рис.Картинка = БиблиотекаКартинок.Renault_Circle;
				КонецЦикла;
			ИначеЕсли Строка.повреждение = Справочники.Renault_Автосервис_Повреждения.УдарЦарапина Тогда
				Для Каждого Рис Из МассивРисунки Цикл
					Рис.Картинка = БиблиотекаКартинок.Renault_CircleCross;
				КонецЦикла;
			Иначе
				Для Каждого Рис Из МассивРисунки Цикл
					Рис.Картинка = БиблиотекаКартинок.Renault_CircleCross;
				КонецЦикла				
			КонецЕсли;
			
			нпп = нпп+1;
			
		ИначеЕсли Строка.Повреждение = Справочники.Renault_Автосервис_Повреждения.УровеньТоплива Тогда
			
			РисункиТоплива = НайтиРисунокПоИмени("ДиаграммаТоплива", ОбластьПовреждений);
			Для Каждого Рис из РисункиТоплива Цикл
				
				Диаграмма = Рис.Объект;
				Диаграмма.ТипДиаграммы = ТипДиаграммы.Измерительная;
				Диаграмма.АвтоМаксимальноеЗначение = Ложь;
				Диаграмма.МаксимальноеЗначение = 100;
				Диаграмма.АвтоМинимальноеЗначение = Ложь;
				Диаграмма.МинимальноеЗначение = 0;
				Диаграмма.ОтображатьЛегенду = Ложь;
				
				// Создать три полосы.
				Полосы = Диаграмма.ПолосыИзмерительнойДиаграммы; 
				НоваяПолоса = Полосы.Добавить(); 
				НоваяПолоса.Начало = 0;
				НоваяПолоса.Конец = 10;
				НоваяПолоса.ЦветФона = WebЦвета.Красный;
				
				НоваяПолоса = Полосы.Добавить();
				НоваяПолоса.Начало =10;
				НоваяПолоса.Конец = 30;
				НоваяПолоса.ЦветФона = WebЦвета.Желтый;
				
				НоваяПолоса = Полосы.Добавить();
				НоваяПолоса.Начало = 30;
				НоваяПолоса.Конец = 100;
				НоваяПолоса.ЦветФона = WebЦвета.Зеленый;
				
				Диаграмма.КоличествоТочек = 1;
				Диаграмма.КоличествоСерий = 1;
				Зна = 0;
				Попытка
					Зна = Окр(100*Число(Строка.Значение));
				Исключение 
					Зна = 0;
				КонецПопытки;
				
				Диаграмма.УстановитьЗначение(0, 0, зна);
				Диаграмма.Обновление = Истина;
				
			КонецЦикла;
			
		Иначе //Если Строка.Повреждение = Справочники.Renault_Автосервис_Повреждения.КомментарийАктОсмотра Тогда
			Если ЗначениеЗаполнено(Строка.Повреждение) Тогда
				СписокПовреждений = СписокПовреждений + Символы.ПС + СтрЗаменить(Строка(нпп), Символы.НПП, "") + ". " +
				СформироватьНазваниеПовреждения(Строка);
				нпп = нпп+1;
				ЭтоПерв = Ложь;
			КонецЕсли;
		КонецЕсли;		
		
	КонецЦикла;
	
	Если ДилерскийЦентр.Автосервис_ИспользуетсяПланшет Тогда  
		ДополнительныеСведения = Renault_АвтосервисСервер.ПолучитьВсеПрочиеПовреждения(Ссылка,нпп);	  
		СписокПовреждений =СписокПовреждений + Символы.ПС + ДополнительныеСведения;
	КонецЕсли;
	
	Возврат СписокПовреждений;
	
КонецФункции

Функция РазбитьПоЗаглавным(Строка)
	
	Выход = Лев(Строка, 1);
	Для Индекс = 2 по СтрДлина(Строка) цикл
		Символ = Сред(Строка, Индекс, 1);
		Выход = Выход + ?(ВРег(Символ) = Символ, " " + НРег(Символ), Символ);
	КонецЦикла;
	
	Возврат Выход;
	
КонецФункции

Функция СформироватьНазваниеПовреждения(Описание)
	
	Ответ = "";
	
	Если ЗначениеЗаполнено(Описание.ЗонаПовреждения) Тогда		
		Ответ = РазбитьПоЗаглавным(Описание.ЗонаПовреждения.Наименование) + " -> ";		
	КонецЕсли;
	
	Если Описание.Повреждение = Справочники.Renault_Автосервис_Повреждения.Удар ИЛИ
		Описание.Повреждение = Справочники.Renault_Автосервис_Повреждения.Царапина ИЛИ
		Описание.Повреждение = Справочники.Renault_Автосервис_Повреждения.УдарЦарапина Тогда
		
		Ответ = Ответ + " " + РазбитьПоЗаглавным(Строка(Описание.Повреждение));		
		Если ЗначениеЗаполнено(Описание.СтепеньПовреждения) Тогда				
			Ответ = Ответ + " (" + Строка(Описание.СтепеньПовреждения) + ")."				
		КонецЕсли;		

	ИначеЕсли Описание.Повреждение = Справочники.Renault_Автосервис_Повреждения.КомментарийАктОсмотра Тогда	
		Ответ = Ответ + " Комментарий акта осмотра:" + Строка(Описание.Значение);
	ИначеЕсли Описание.Повреждение = Справочники.Renault_Автосервис_Повреждения.Комментарий Тогда
		Ответ = Ответ + " Дополнительный комментарий:" + Строка(Описание.Комментарий);
	Иначе			
		//Ответ = Ответ + " " + Описание.Повреждение +" " +Строка(Описание.Комментарий);	
		Ответ = Ответ + " " + Описание.Повреждение;			
	КонецЕсли;
		
	Возврат Ответ;
	
КонецФункции

Функция НайтиРисунокПоИмени(ИмяРисунка, ОбластьСРисунками)
	
	МассивРисунков = новый Массив();
	Для Каждого Рис Из ОбластьСРисунками.Рисунки Цикл
		Если Рис.Имя = ИмяРисунка Тогда
			МассивРисунков.Добавить(Рис);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивРисунков;
	
КонецФункции

Функция ПолучитьРекомендуемыеРаботы(СвязаннаяПриемка)
	
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_ПоврежденияАвтомобилейСрезПоследних.Работа,
	|	Renault_ПоврежденияАвтомобилейСрезПоследних.РаботаАктуальна
	|ИЗ
	|	РегистрСведений.Renault_ПоврежденияАвтомобилей КАК Renault_ПоврежденияАвтомобилейСрезПоследних
	|ГДЕ
	|	Renault_ПоврежденияАвтомобилейСрезПоследних.Автомобиль = &Автомобиль");
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	ПоврежденияАвто = запрос.Выполнить().Выгрузить();
	Ответ = "";
	ЭтоПерв = Истина;
	нпп = 1;
	Для Каждого Опис из ПоврежденияАвто Цикл
		Если Опис.РаботаАктуальна = Истина Тогда
			
			ТекстРаботы = ?(ТипЗнч(Опис.Работа) = Тип("СправочникСсылка.Автоработы"), Строка(Опис.Работа.Наименование), Строка(Опис.Работа)); 
			
			Если ЭтоПерв Тогда
				Ответ = СтрЗаменить(Строка(нпп), Символы.НПП, "") + " " + ТекстРаботы;
				ЭтоПерв = Ложь;
			Иначе
				Ответ = Ответ + Символы.ПС + СтрЗаменить(Строка(нпп), Символы.НПП, "") + " " + ТекстРаботы;
			КонецЕсли;
			нпп = нпп + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Ответ;
	
КонецФункции

Процедура ЗаписатьВРегистр(Исполнитель, План, Факт, Авторабота, Цех, IDЭтапа)
	
	Запись = РегистрыСведений.Renault_АвтосервисФактПоИсполнителям.СоздатьМенеджерЗаписи();
	
	Работа = ЭтотОбъект.Работы.Найти(Авторабота);
	
	Если ЗначениеЗаполнено(Работа) Тогда
		
		Норма = Работа.ДлительностьЗН;
		IDРаботы = Работа.IDРаботы;
		
	Иначе
		
		Норма = 0;
		IDРаботы = 0;
		
	КонецЕсли;
	
	Запись.Исполнитель = Исполнитель;
	Запись.Период = ТекущаяДата();
	Запись.План = План;
	Запись.Факт = Факт;
	Запись.Цех = Цех;
	Запись.IDЭтапа = IDЭтапа;
	Запись.РабочийДокумент = ЭтотОбъект.Ссылка;
	Запись.Работа = Авторабота;
	Запись.Норма = Норма;
	Запись.IDРаботы = IDРаботы;
	
	Запись.Записать(ИСТИНА);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	УпрощенныйРежим = ДилерскийЦентр.ИспользоватьУпрощенныйФункционалСвязиСервисПродажи;
	
	Если ЭтотОбъект.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
		
		Для Каждого Этап из ЭтотОбъект.Этапы Цикл
			
			Если ОбщаяДлительность = 0 Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Отбор = Новый Структура();
			Отбор.Вставить("Этап", Этап.IDЭтапа);
			СтрокиЗанятости = ЭтотОбъект.ВыполнениеРабот.НайтиСтроки(Отбор);
			
			Для Каждого СтрокаЗанятости ИЗ СтрокиЗанятости Цикл
				
				ЗаписатьВРегистр(СтрокаЗанятости.Исполнитель, ОбщаяДлительность, СтрокаЗанятости.Длительность, Справочники.Автоработы.ПустаяСсылка(), Этап.Цех, Этап.IDЭтапа);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
		
	//////////////////
	//Доступно также в упрощенном режиме
	
	Если СтатусПодготовкиКПродаже = Перечисления.Renault_СтатусыЗаявкиНаПрепродажнуюПодготовку.Выполнена Тогда
	
		//Движения по выполнению этапов выдачи
		Если ЗначениеЗаполнено(ДоговорНаПродажуАвтомобиля) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_ВыполнениеЭтаповВыдачи.Ссылка КАК ВыполнениеЭтапов,
			|	CRM_ЗаписьНаВыдачу.Ссылка КАК ЗаписьНаВыдачу
			|ИЗ
			|	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_ВыполнениеЭтаповВыдачи КАК Renault_ВыполнениеЭтаповВыдачи
			|		ПО CRM_ЗаписьНаВыдачу.Ссылка = Renault_ВыполнениеЭтаповВыдачи.ВыдачаАвтомобиля
			|ГДЕ
			|	CRM_ЗаписьНаВыдачу.ДоговорНаПродажуАвтомобиля = &ДоговорНаПродажуАвтомобиля
			|	И CRM_ЗаписьНаВыдачу.Статус <> &Статус";
			
			Запрос.УстановитьПараметр("ДоговорНаПродажуАвтомобиля",ДоговорНаПродажуАвтомобиля);
			Запрос.УстановитьПараметр("Статус", Перечисления.CRM_СтатусыДокументаЗаписьНаВыдачу.Отменено);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.ВыполнениеЭтапов = NULL  Тогда
					ДокОбъектВыполнениеЭтатапов = Документы.Renault_ВыполнениеЭтаповВыдачи.СоздатьДокумент();
					ДокОбъектВыполнениеЭтатапов.Дата = ТекущаяДата();
					ДокОбъектВыполнениеЭтатапов.ВыдачаАвтомобиля = Выборка.ЗаписьНаВыдачу;
				Иначе
					ДокОбъектВыполнениеЭтатапов = Выборка.ВыполнениеЭтапов.ПолучитьОбъект();
				КонецЕсли;
				СтрТЧ = ДокОбъектВыполнениеЭтатапов.ЭтатыВыдачи.Найти(Справочники.Renault_ЭтапыВыдачи.УстановкаДопОб,"Этап");
				Если СтрТЧ = Неопределено Тогда
					СтрТЧ = ДокОбъектВыполнениеЭтатапов.ЭтатыВыдачи.Добавить();
					СтрТЧ.Этап = Справочники.Renault_ЭтапыВыдачи.УстановкаДопОб;
				КонецЕсли;
				СтрТЧ.Сотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
				СтрТЧ.ДатаВыполнения = ТекущаяДата();
				ДокОбъектВыполнениеЭтатапов.Записать(РежимЗаписиДокумента.Проведение);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	//Движения по регистрам для допов в автоскладе
		
	ДвиженияУстановленноеОборудование = Движения.Renault_УстановленноеОборудованиеАвтомобилей;
	ДвиженияУстановленноеОборудование.Очистить();
	ДвиженияУстановленноеОборудование.Записывать = Истина;
	
	ДвиженияОборудованиеКУстановке = Движения.Renault_ОборудованиеКУстановке;
	ДвиженияОборудованиеКУстановке.Очистить();
	ДвиженияОборудованиеКУстановке.Записывать = Истина;
	
	ДвиженияСтоимостьУстановленногоОборудования = Движения.Renault_СтоиомостьУстановленногоОборудования;
	ДвиженияСтоимостьУстановленногоОборудования.Очистить();
	ДвиженияСтоимостьУстановленногоОборудования.Записывать = Истина;
	
	//Соберем таблицу оборудования для движений
	
	ТаблицаОборудования = Новый ТаблицаЗначений;
	ТаблицаОборудования.Колонки.Добавить("ВидДвижения");
	ТаблицаОборудования.Колонки.Добавить("Автомобиль");
	ТаблицаОборудования.Колонки.Добавить("Оборудование");
	ТаблицаОборудования.Колонки.Добавить("Себестоимость");
	ТаблицаОборудования.Колонки.Добавить("Стоимость");
	ТаблицаОборудования.Колонки.Добавить("Количество");
	ТаблицаОборудования.Колонки.Добавить("Период");
	ТаблицаОборудования.Колонки.Добавить("АртикулОборудования");
	
	Если ТипПривязкиДоповКАвтомобилям = Перечисления.Renault_ТипыУчетаДополнительногоОборудования.ИзДополнительногоОборудования Тогда
		
		//Оборудование
		
		Для Каждого Стр Из ДополнительноеОборудование Цикл
			СтрДвиж = ТаблицаОборудования.Добавить();
			СтрДвиж.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрДвиж.Автомобиль = Автомобиль;
			СтрДвиж.Оборудование = Стр.Оборудование;
			СтрДвиж.Себестоимость = Стр.Себестоимость;
			СтрДвиж.Стоимость = Стр.ЦенаДляКлиента;
			СтрДвиж.Количество = Стр.Количество;
			Если ТипЗнч(Стр.Оборудование) = Тип("СправочникСсылка.Renault_СписокДопов") Тогда
				СтрДвиж.АртикулОборудования = Стр.Оборудование.Код;
			КонецЕсли;
			СтрДвиж.Период = ТекущаяДата();
		КонецЦикла;
		
	Иначе
		
		//Номенклатура
		
		Для Каждого Стр Из Товары Цикл
			СтрДвиж = ТаблицаОборудования.Добавить();
			СтрДвиж.ВидДвижения = ВидДвиженияНакопления.Приход;
			СтрДвиж.Автомобиль = Автомобиль;
			СтрДвиж.Оборудование = Стр.Номенклатура;
			СтрДвиж.Себестоимость = 0;
			СтрДвиж.Стоимость = Стр.Сумма;
			СтрДвиж.Количество = Стр.Количество;
			СтрДвиж.АртикулОборудования = Стр.Номенклатура.Артикул;
			СтрДвиж.Период = ТекущаяДата();
		КонецЦикла;
		
		Если ТипПривязкиДоповКАвтомобилям = Перечисления.Renault_ТипыУчетаДополнительногоОборудования.ИзНоменклатурыИРабот Тогда
				
			//Работы
			
			Для Каждого Стр Из Работы Цикл
				СтрДвиж = ТаблицаОборудования.Добавить();
				СтрДвиж.ВидДвижения = ВидДвиженияНакопления.Приход;
				СтрДвиж.Автомобиль = Автомобиль;
				СтрДвиж.Оборудование = Стр.Работа;
				СтрДвиж.Себестоимость = 0;
				СтрДвиж.Стоимость = Стр.Сумма;
				СтрДвиж.Количество = 1;
				СтрДвиж.АртикулОборудования = Стр.Работа.Артикул;
				СтрДвиж.Период = ТекущаяДата();
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	////////////////////////////////////////////////////
	//Теперь сделаем движения в зависимости от статусов
		
	Если СтатусПодготовкиКПродаже = Перечисления.Renault_СтатусыЗаявкиНаПрепродажнуюПодготовку.Выполнена Тогда
		
		//ДвиженияУстановленноеОборудование
		
		Для Каждого Стр Из ТаблицаОборудования Цикл
			СтрДвиж = ДвиженияУстановленноеОборудование.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДвиж, Стр);
		КонецЦикла;
		
		Если НЕ Отказ И ДвиженияУстановленноеОборудование.Количество() > 0 Тогда
			Renault_СообщенияПользователю.Renault_События_ПриВыполненииЗаявкиВАвтосервисСДопОборудованием(Ссылка);
		КонецЕсли;	
		
		//ДвиженияСтоимостьУстановленногоОборудования
		
		Для Каждого Стр Из ТаблицаОборудования Цикл
			СтрДвиж = ДвиженияСтоимостьУстановленногоОборудования.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДвиж, Стр);
		КонецЦикла;
		
	ИначеЕсли СтатусПодготовкиКПродаже = Перечисления.Renault_СтатусыЗаявкиНаПрепродажнуюПодготовку.ОтправленаВРаботу Тогда
		
		//ДвиженияОборудованиеКУстановке
			
		Для Каждого Стр Из ТаблицаОборудования Цикл
			СтрДвиж = ДвиженияОборудованиеКУстановке.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДвиж, Стр);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьСчетНаОплатуОбщий() Экспорт
	
	СтрокаСчета = ЭтотОбъект.СчетаНаОплату.Найти(Истина, "ЭтоОбщийСчет");
	Если СтрокаСчета <> Неопределено Тогда
		СчетНаОплату = СтрокаСчета.СчетНаОплату;
	Иначе
		СчетНаОплату = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетНаОплату) Тогда
		
		СчетОбъект = СчетНаОплату.Ссылка.ПолучитьОбъект();
		СчетОбъект.Товары.Очистить();
		
		НовыйСчет = СчетОбъект;
		
	Иначе
		
		НовыйСчет = Документы.СчетНаОплату.СоздатьДокумент();
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭтотОбъект.ЗаказНаряд) Тогда
		дкОбработкаЗаполнения(НовыйСчет, ЭтотОбъект.ЗаказНаряд);
	Иначе
		дкОбработкаЗаполнения(НовыйСчет, ЭтотОбъект);
		НовыйСчет.Контрагент = ЭтотОбъект.Клиент;
		Если ЗначениеЗаполнено(НовыйСчет.Организация) Тогда
			НовыйСчет.РасчетныйСчетОрганизации = НовыйСчет.Организация.ОсновнойБанковскийСчет;
		КонецЕсли;
		Для Каждого СтрокаТовары ИЗ НовыйСчет.Товары Цикл
			СтрокаТовары.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ОсновнаяЕдиницаИзмерения;
			СтрокаТовары.Коэффициент = 1;
			СтрокаТовары.СуммаВсего = СтрокаТовары.Цена*СтрокаТовары.Количество;
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ТипЦен) Тогда
				
			НовыйСчет.ТипЦен = ЭтотОбъект.ДилерскийЦентр.Автосервис_ТипЦенПродажи;
				
		КонецЕсли;
		
		Для Каждого СтрокаРабот ИЗ ЭтотОбъект.Работы Цикл
			НоваяСтрока = НовыйСчет.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРабот);
			НоваяСтрока.Номенклатура = СтрокаРабот.Работа;
			
			НоваяСтрока.Цена = СтрокаРабот.Цена;			
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.ЕдиницаИзмерения = СтрокаРабот.Нормочас;
			НоваяСтрока.Количество = СтрокаРабот.Длительность;
			НоваяСтрока.СуммаВсего = НоваяСтрока.Количество * НоваяСтрока.Цена;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НовыйСчет.Контрагент) Тогда
		Если НЕ ЗначениеЗаполнено(CRM_Сервер.DMS_ПолучитьОсновнойДоговорКонтрагента(НовыйСчет.Контрагент)) Тогда
			КонтрагентОбъект = НовыйСчет.Контрагент.ПолучитьОбъект();
			КонтрагентОбъект.СоздатьОсновнойДоговор();
			КонтрагентОбъект.Записать();
		КонецЕсли;
		НовыйСчет.ДоговорВзаиморасчетов = CRM_Сервер.DMS_ПолучитьОсновнойДоговорКонтрагента(НовыйСчет.Контрагент);
	КонецЕсли;
	
	НовыйСчет.Записать();
	Если СтрокаСчета <> Неопределено Тогда
		СтрокаСчета.СчетНаОплату = НовыйСчет.Ссылка;
	Иначе
		СтрокаСчета = СчетаНаОплату.Добавить();
		СтрокаСчета.СчетНаОплату = НовыйСчет.Ссылка;
		СтрокаСчета.ЭтоОбщийСчет = Истина;
	КонецЕсли;
	ЭтотОбъект.Записать();
	
КонецПроцедуры

