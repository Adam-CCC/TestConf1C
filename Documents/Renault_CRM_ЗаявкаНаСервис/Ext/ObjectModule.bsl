		СтрокаСчета = СчетаНаОплату.Добавить();
		СтрокаСчета.СчетНаОплату = НовыйСчет.Ссылка;
		СтрокаСчета.ЭтоСчетНаТовары = Истина;
	КонецЕсли;
	ЭтотОбъект.Записать();
	
КонецПроцедуры

