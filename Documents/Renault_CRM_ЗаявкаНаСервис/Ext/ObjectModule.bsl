	КонецЕсли;
	
	НовыйСчет.Товары.Очистить();
	Для Каждого СтрокаТовары ИЗ Основание.Товары Цикл
		НоваяСтрока = НовыйСчет.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовары);
		НоваяСтрока.ЕдиницаИзмерения = СтрокаТовары.Номенклатура.ОсновнаяЕдиницаИзмерения;
