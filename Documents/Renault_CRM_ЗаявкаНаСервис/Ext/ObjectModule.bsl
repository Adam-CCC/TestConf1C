Функция ПолучитьСтрокуКомментариевЭтапРаботы(ДокСсылка,IDЭтапа) 
	Рез = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.РабочийДокумент,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.IDЭтапа,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Цех,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Исполнитель,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.ВремяНачало,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.ВремяОкончание,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Длительность,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Комментарий,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.СтатусАвтоработы
	               |ИЗ
	               |	РегистрСведений.Renault_АвтосервисЦехШтампЧасыПродуктивные КАК Renault_АвтосервисЦехШтампЧасыПродуктивные
	               |ГДЕ
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.РабочийДокумент = &РабочийДокумент
	               |	И Renault_АвтосервисЦехШтампЧасыПродуктивные.IDЭтапа = &IDЭтапа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.ВремяНачало";
	Запрос.УстановитьПараметр("РабочийДокумент",ДокСсылка);
	Запрос.УстановитьПараметр("IDЭтапа",IDЭтапа);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез = Рез + СокрЛП(Выборка.Комментарий) + "; ";	
	КонецЦикла;
	Если СтрДлина(Рез)>2 Тогда
		Рез = Лев(Рез,СтрДлина(Рез)-2);
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция ПолучитьСтрокуИсполнителиЭтапРаботы(ДокСсылка,IDЭтапа) 
	Рез = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.РабочийДокумент,
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.IDЭтапа,
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.ВремяНачало,
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.Исполнитель
	               |ПОМЕСТИТЬ тИсполнители
	               |ИЗ
	               |	РегистрСведений.Renault_АвтосервисЦехШтампЧасыИсполнители КАК Renault_АвтосервисЦехШтампЧасыИсполнители
	               |ГДЕ
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.РабочийДокумент = &РабочийДокумент
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.РабочийДокумент,
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.IDЭтапа,
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.ВремяНачало,
	               |	Renault_АвтосервисЦехШтампЧасыИсполнители.Исполнитель
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.РабочийДокумент,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.IDЭтапа,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Цех,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Исполнитель,
	               |	т1.Исполнитель КАК ИсполнительШтамп,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.ВремяНачало,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.ВремяОкончание,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Длительность,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.Комментарий,
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.СтатусАвтоработы
	               |ИЗ
	               |	РегистрСведений.Renault_АвтосервисЦехШтампЧасыПродуктивные КАК Renault_АвтосервисЦехШтампЧасыПродуктивные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ тИсполнители КАК т1
	               |		ПО (т1.РабочийДокумент = Renault_АвтосервисЦехШтампЧасыПродуктивные.РабочийДокумент)
	               |			И (т1.IDЭтапа = Renault_АвтосервисЦехШтампЧасыПродуктивные.IDЭтапа)
	               |			И (т1.ВремяНачало = Renault_АвтосервисЦехШтампЧасыПродуктивные.ВремяНачало)
	               |ГДЕ
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.РабочийДокумент = &РабочийДокумент
	               |	И Renault_АвтосервисЦехШтампЧасыПродуктивные.IDЭтапа = &IDЭтапа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Renault_АвтосервисЦехШтампЧасыПродуктивные.ВремяНачало,
	               |	т1.Исполнитель";
	Запрос.УстановитьПараметр("РабочийДокумент",ДокСсылка);
	Запрос.УстановитьПараметр("IDЭтапа",IDЭтапа);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ИсполнительШтамп) Тогда
			Рез = Рез + СокрЛП(Строка(Выборка.ИсполнительШтамп)) + "; ";	
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Рез)>2 Тогда
		Рез = Лев(Рез,СтрДлина(Рез)-2);
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Функция ПолучитьСтрокуСписокРабот(ДокСсылка,IDЭтапа,СтрокаАртикулы="") 
	Рез = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.Ссылка,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDЭтапа
	               |ПОМЕСТИТЬ тРабЭтапы
	               |ИЗ
	               |	Документ.Renault_CRM_ЗаявкаНаСервис.СоставЭтапа КАК Renault_CRM_ЗаявкаНаСервисСоставЭтапа
	               |ГДЕ
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.Ссылка = &РабочийДокумент
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.Ссылка,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисСоставЭтапа.IDЭтапа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Работа,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Длительность,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Нормочас,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Цена,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Сумма,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.ИдентификаторРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.ДлительностьЗН,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.IDРаботы,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.НомерСтроки,
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Работа.Артикул КАК Артикул,
	               |	т2.IDЭтапа
	               |ИЗ
	               |	Документ.Renault_CRM_ЗаявкаНаСервис.Работы КАК Renault_CRM_ЗаявкаНаСервисРаботы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ тРабЭтапы КАК т2
	               |		ПО (т2.Ссылка = Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка)
	               |			И (т2.IDРаботы = Renault_CRM_ЗаявкаНаСервисРаботы.IDРаботы)
	               |ГДЕ
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка = &РабочийДокумент
	               |	И т2.IDЭтапа = &IDЭтапа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Renault_CRM_ЗаявкаНаСервисРаботы.НомерСтроки";
	Запрос.УстановитьПараметр("РабочийДокумент",ДокСсылка);
	Запрос.УстановитьПараметр("IDЭтапа",IDЭтапа);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Работа) Тогда
			Рез = Рез + СокрЛП(Строка(Выборка.Работа)) + "; ";
			СтрокаАртикулы = СтрокаАртикулы  + СокрЛП(Строка(Выборка.Артикул)) + "; ";
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Рез)>2 Тогда
		Рез = Лев(Рез,СтрДлина(Рез)-2);
	КонецЕсли;
	Если СтрДлина(СтрокаАртикулы)>2 Тогда
		СтрокаАртикулы = Лев(СтрокаАртикулы,СтрДлина(СтрокаАртикулы)-2);
	КонецЕсли;

	Возврат Рез;
КонецФункции

Функция РазделитьСтрокуНаПодстроки(ОригинальнаяСтрока,ПервыйНомерСтроки, ПоследнийНомерСтроки)
	
	ВозвращаемаяСтрока = "";
	Для Индекс = ПервыйНомерСтроки По ПоследнийНомерСтроки Цикл

    	ВозвращаемаяСтрока = ВозвращаемаяСтрока + СтрПолучитьСтроку(ОригинальнаяСтрока,Индекс) + Символы.ПС;
		
	КонецЦикла; 
	Возврат ВозвращаемаяСтрока;
	
КонецФункции
