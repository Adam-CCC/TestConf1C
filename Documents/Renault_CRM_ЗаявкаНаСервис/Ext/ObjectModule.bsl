КонецФункции

Процедура СопоставитьРаботыИСоставыЭтапов()
	
	Для Каждого Работа из СоставЭтапа Цикл
		
		ЕстьРаботы = ЭтотОбъект.Работы.НайтиСтроки(Новый Структура("IDРаботы", Работа.IDРаботы));
		
		Если ЕстьРаботы.Количество() = 0 Тогда
			
			СоставЭтапа.Удалить(Работа);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьСтатусЭтапаВрегистре(Этап)
	
	ЗаписьСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
	ЗаписьСтатуса.РабочийДокумент = ЭтотОбъект.Ссылка;
	ЗаписьСтатуса.Период = ТекущаяДата();
	ЗаписьСтатуса.Обращение = ЭтотОбъект.Обращение;
	ЗаписьСтатуса.ДилерскийЦентр = ЭтотОбъект.ДилерскийЦентр;
	ЗаписьСтатуса.ЭтапРабот = Этап.IDЭтапа;
	ЗаписьСтатуса.Цех = Этап.Цех;
	ЗаписьСтатуса.СтатусРаботы = Этап.СтатусЭтапа;
	
	Если ЗначениеЗаполнено(ЗаписьСтатуса.СтатусРаботы) Тогда
		
		ЗаписьСтатуса.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьПланПоЭтапу(Этап)
	
	Если ТипЗнч(Этап) = Тип("Строка") Тогда
		
		IDЭтапа = Этап;
		
	Иначе
		
		IDЭтапа = Этап.IDЭтапа;
		
	КонецЕсли;
	
	ОтборПлана = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьНаборЗаписей();
	
	ОтборПлана.Отбор.РабочийДокумент.Установить(ЭтотОбъект.Ссылка);
	ОтборПлана.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборПлана.Прочитать();
	ОтборПлана.Очистить();
	ОтборПлана.Записать();
	
	ОтборСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
	ОтборСтатуса.Отбор.РабочийДокумент.Установить(ЭтотОбъект.Ссылка);
	ОтборСтатуса.Отбор.ЭтапРабот.Установить(IDЭтапа);
	ОтборСтатуса.Прочитать();
	ОтборСтатуса.Очистить();
	ОтборСтатуса.Записать();
	
КонецПроцедуры

Процедура ЗапланироватьЭтап(Этап, Статус)
	
	Если ЗначениеЗаполнено(Этап.НачалоЭтапа) и ЗначениеЗаполнено(Этап.КонецЭтапа) и Этап.ДлительностьЭтапаПлан > 0 Тогда
		
		ОчиститьПланПоЭтапу(Этап);
		
		Запись = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьМенеджерЗаписи();
		Запись.Обращение = ЭтотОбъект.Обращение;
		Запись.РабочийДокумент = ЭтотОбъект.Ссылка;
		Запись.ДилерскийЦентр = ЭтотОбъект.ДилерскийЦентр;
		Запись.Длительность = Этап.ДлительностьЭтапаПлан;
		Запись.ВремяНачала = Этап.НачалоЭтапа;
		Запись.ВремяОкончания = Этап.КонецЭтапа;
		Запись.ЭтапРабот = Этап.IDЭтапа;
		Запись.Цех = Этап.Цех;
		
		Этап.СтатусЭтапа = Статус;
		
		Запись.Записать();
		
		ЗаписьПлана = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьПлана, Запись);
		ЗаписьПлана.Период = ТекущаяДата();
		ЗаписьПлана.Записать();
		
		ОбновитьСтатусЭтапаВрегистре(Этап);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СопоставитьЭтапыИРегистры()
	
	ОтборСтатуса = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьНаборЗаписей();
	ОтборСтатуса.Отбор.РабочийДокумент.Установить(ЭтотОбъект.Ссылка);
	ОтборСтатуса.Прочитать();
	
	Для Каждого Статус из ОтборСтатуса Цикл
		
		ЭтапВЗаявке = ЭтотОбъект.Этапы.Найти(Статус.ЭтапРабот, "IDЭтапа");
		
		Если НЕ ЗначениеЗаполнено(ЭтапВЗаявке) Тогда
			
			ОчиститьПланПоЭтапу(Статус.ЭтапРабот);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПодготовитьФормуЗаявкиКПечати(Ожидает = Ложь, СохранятьЗЧ = Ложь)Экспорт
	
	Если ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		ВнешняяФорма = ДилерскийЦентр.Автосервис_ФормаПечатиЗаявки;
		Если ЗначениеЗаполнено(ВнешняяФорма) Тогда
			Если ВнешняяФорма.ХранитьВоВнешнемФайле = Ложь И ЗначениеЗаполнено(ВнешняяФорма.Хранилище) Тогда
				ДвоичныеДанные = ВнешняяФорма.Хранилище.Получить();
				ИмяВремФайла = ПолучитьИмяВременногоФайла("epf");
				ДвоичныеДанные.Записать(ИмяВремФайла);
				ВнешняяОбработка = ВнешниеОбработки.Создать(ИмяВремФайла);
				ВнешняяОбработка.СсылкаНаОбъект = Ссылка;
				Попытка
					ТабДок = ВнешняяОбработка.Печать();
					Возврат ТабДок;
				Исключение
					Сообщить("Ошибка печати из внешней печатной формы!");
					Возврат Новый ТабличныйДокумент;
				КонецПопытки;
			ИначеЕсли ВнешняяФорма.ХранитьВоВнешнемФайле = Истина И ЗначениеЗаполнено(ВнешняяФорма.ПутьКВнешнемуФайлу) Тогда
				Попытка
					ВнешняяОбработка = ВнешниеОбработки.Создать(ВнешняяФорма.ПутьКВнешнемуФайлу);
					ВнешняяОбработка.СсылкаНаОбъект = Ссылка;
					ТабДок = ВнешняяОбработка.Печать();
					Возврат ТабДок;
				Исключение
					Сообщить("Ошибка печати из внешней печатной формы!");
					Возврат Новый ТабличныйДокумент;
