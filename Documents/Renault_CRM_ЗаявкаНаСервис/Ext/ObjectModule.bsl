	|ИЗ
	| Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
	|ГДЕ
	| Renault_CRM_ВыдачаАвтомобиля.Обращение.Ссылка = &Обращение");
	Запрос.УстановитьПараметр("Обращение", Обращение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Выдача;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьАдресКлиента(Клиент)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КонтактнаяИнформация.Представление КАК Представление,
	                      |	КонтактнаяИнформация.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию
	                      |ИЗ
	                      |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                      |ГДЕ
	                      |	КонтактнаяИнформация.Объект = &Объект
	                      |	И КонтактнаяИнформация.Тип = &Тип");
	Запрос.УстановитьПараметр("Объект", Клиент);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Адрес);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество()>0 Тогда
		СтрОсн = Выборка.НайтиСтроки(Новый СТруктура("ЗначениеПоУмолчанию", Истина));
		Если СтрОсн.Количество()>0 Тогда
			Возврат СтрОсн[0].Представление;
		Иначе			
			Возврат Выборка[0].Представление;
		КонецЕсли;
	Иначе
		Возврат " ";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеПлательщика (вхПлательщик) 
	
	Ответ = "";
	Если ЗначениеЗаполнено(вхПлательщик) Тогда
		Ответ = "ИНН " + вхПлательщик.ИНН + " адрес: " + ПолучитьАдресКлиента(вхПлательщик) + " телефон: " + ТелефонСКомментариями(вхПлательщик); 
		Возврат Ответ;
	Иначе
		Возврат " ";
	КонецЕсли;
	
КонецФункции

