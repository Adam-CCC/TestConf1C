	Если ЗначениеЗаполнено(СвязаннаяПриемка) Тогда
		
		ОбластьШапки.Параметры.МастерПриемщик  = СвязаннаяПриемка.Машиноместо;
		ОбластьШапки.Параметры.ДатаПриема  = Формат(СвязаннаяПриемка.ВремяОкончания,"ДФ=""дд.ММ.гггг ЧЧ:мм""");//СвязаннаяПриемка.ВремяНачала;

        //DMSREN-1326
		Если Ожидает = Истина И СвязаннаяПриемка.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен Тогда
			ОбластьШапки.Параметры.КлиентОжидает = "Клиент ожидает";
		ИначеЕсли Ожидает = Ложь И СвязаннаяПриемка.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен Тогда
			ОбластьШапки.Параметры.КлиентОжидает = "Клиент уедет";
			ИначеЕсли Ожидает = Ложь И СвязаннаяПриемка.Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка Тогда
			ОбластьШапки.Параметры.КлиентОжидает = "";
		КонецЕсли;
		
		Если СохранятьЗЧ = истина Тогда
			ОбластьШапки.Параметры.СохранятьЗЧ = "ДА";
		Иначе
			ОбластьШапки.Параметры.СохранятьЗЧ = "НЕТ";
		КонецЕсли;
		
		// STRAKHOV
		ОбластьШапки.Параметры.СтоимостьАвтомобиля = Формат(СвязаннаяПриемка.СтоимостьАвтомобиля,"ЧЦ=10; ЧДЦ=2");

	КонецЕсли;
	//Если СохранятьЗамененныеЧасти Тогда                                     
	//	ОбластьШапки.Рисунки.Картинка =  БиблиотекаКартинок.Renault_ПолеКлеткиГалка;
	//КонецЕсли;
	Если ЗначениеЗаполнено(СвязаннаяВыдача)И ЗначениеЗаполнено(СвязаннаяВыдача.ВремяНачала) Тогда
		ОбластьШапки.Параметры.ВремяВыдачиАвтомобиля = Формат(СвязаннаяВыдача.ВремяНачала,"ДФ=""дд.ММ.гггг ЧЧ:мм""");
	КонецЕсли;
	
	ТекстЗаявка = "Заявка на ремонт №"+ Ссылка.Номер+" от "+ Формат(Ссылка.ВремяНачала,"ДФ=""дд.ММ.гггг""");
	
	Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
		
		// Трояновский К.Е. 28.10.2019 14:35:18 {
		//ТекстЗаявка = ТекстЗаявка + " " + ЗаказНаряд.Номер + " от " + Формат(ЗаказНаряд.Дата,"ДФ=""дд.ММ.гггг""")
		//ТекстЗаявка = ТекстЗаявка + " " + ЗаказНаряд.Номер + " от " + Формат(ЗаказНаряд.ДатаМашинозаезда,"ДФ=""дд.ММ.гггг""");		
		ТекстЗаявка = ТекстЗаявка + " ЗН №" + ЗаказНаряд.Номер + " от " + Формат(ЗаказНаряд.ДатаНачала,"ДФ=""дд.ММ.гггг"""); //Сергеев В.Н. DMSREN-859		
		// Трояновский К.Е. 28.10.2019 14:35:18 }
		
	КонецЕсли;
	мКлиент = Клиент;
	пПлательщик = ?(КлиентЯвляетсяПлательщиком,Клиент, ?(ЗначениеЗаполнено(Плательщик), Плательщик, Клиент));
	Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
		
		АвтомобильПечать = ЗаказНаряд.Автомобиль;
		// DMSREN-1186 Подтягивает клиента и плательщика из ЗН, если он есть
		мКлиент = ЗаказНаряд.Заказчик;
		пПлательщик = ?(ЗначениеЗаполнено(ЗаказНаряд.Контрагент),ЗаказНаряд.Контрагент,пПлательщик);
		// DMSREN-1186 ----
		Если ЗаказНаряд.Автомобиль <> Автомобиль Тогда
			
			//вставить сюда сообщение пользователю
			
		КонецЕсли;
		
	Иначе
		
		АвтомобильПечать = Автомобиль;
		
	КонецЕсли;
	
	ГосНомерА = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтомобильПечать, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	
	Скидки = Renault_АвтосервисСкидки.НайтиДоступныеСкидкиПоКлиенту(Клиент);
	
	Если ЗначениеЗаполнено(Скидки) Тогда 
		
		НомерКарты = Скидки[0].Номер_Карты;
		
	КонецЕсли;
	
	ОбластьШапки.Параметры.ЗаявкаНаРемонт = ТекстЗаявка;
	ОбластьШапки.Параметры.ГосНомер = ?(ЗначениеЗаполнено(ГосНомерА), ГосНомерА,
	?(ЗначениеЗаполнено(СвязаннаяПриемка), СвязаннаяПриемка.ГосНомер, ""));
	ОбластьШапки.Параметры.Заказчик = СокрЛП(мКлиент.НаименованиеПолное);
	АдресЗакзачика = ПолучитьАдресКлиента(мКлиент);
	//Сергеев В.Н. DMSREN-970
	ТелефонЗаказчика = ТелефонСКомментариями(мКлиент);
	ТелефонЗаказчика = ?(ПустаяСтрока(ТелефонЗаказчика),""," Телефон: " + ТелефонЗаказчика);
	//----------------------
	ОбластьШапки.Параметры.АдресЗаказчика = АдресЗакзачика + ТелефонЗаказчика;
	АвтомобильОписание = "";
	Если ЗначениеЗаполнено(АвтомобильПечать) тогда
		АвтомобильОписание = АвтомобильОписание + АвтомобильПечать.Модель.Наименование + ", гос. номер " + ГосНомерА +
		", VIN " + АвтомобильПечать.VIN + ", год выпуска " + Формат(АвтомобильПечать.ГодВыпуска, "ДФ=""гггг""") + ", пробег " + Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтомобильПечать.Ссылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
		АвтомобильВладелец = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтомобильПечать.Ссылка, 
		Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
		ОбластьШапки.параметры.Автомобиль = АвтомобильОписание;
		АдресВладельца = ПолучитьАдресКлиента(АвтомобильВладелец);
		ОбластьШапки.Параметры.Владелец = ?(ЗначениеЗаполнено(АвтомобильВладелец), АвтомобильВладелец.НаименованиеПолное, "");
		//Сергеев В.Н. DMSREN-970
		ТелефонВладельца = ТелефонСКомментариями(АвтомобильВладелец);
		ТелефонВладельца = ?(ПустаяСтрока(ТелефонВладельца),""," Телефон: " + ТелефонВладельца);
		//----------------------
		ОбластьШапки.параметры.АдресВладельца = АдресВладельца + ТелефонВладельца;
	КонецЕсли;
	
	ДанныеПлательщика = ПолучитьДанныеПлательщика(пПлательщик);
	Если ЗначениеЗаполнено(пПлательщик)Тогда
		ОбластьШапки.Параметры.Плательщик = пПлательщик.НаименованиеПолное;
		ОбластьШапки.Параметры.ДанныеПлательщика = ДанныеПлательщика;
	КонецЕсли;
	
	ОбластьШапки.Параметры.email = "e-mail: " + Renault_CRM.ПолучитьЕмаилКлиент(мКлиент);
	// начало ЗеленчукДС изменено 13.10.2017
	//ОбластьШапки.Параметры.КартаНаСервисноеОбслуживание = "Карта на сервисное обслуживание а/м марки RENAULT: ";
	ОбластьШапки.Параметры.КартаНаСервисноеОбслуживание = "Карта на сервисное обслуживание а/м марки " + СокрЛП(ДилерскийЦентр.Бренд.Наименование) + ": ";
	// окончание ЗеленчукДС изменено 13.10.2017
	ОбластьШапки.Параметры.ДисконтнаяКарта = "Дисконтная карта Номер " + Строка(НомерКарты);
	//Добавить Клиент ожидает или клиент уехал
	
	Если ПредложеноТакси Тогда
		ОбластьШапки.Параметры.ВремРешение = "предложено такси";
	ИначеЕсли ПредложенПодменныйАвтомобиль Тогда
		ОбластьШапки.Параметры.ВремРешение = "подменный автомобиль";
	Иначе
		ОбластьШапки.Параметры.ВремРешение = "не требуется";
	КонецЕсли;
	
КонецПроцедуры

