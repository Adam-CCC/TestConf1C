Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)     	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	#Если Клиент Тогда	
		Если ЭтотОбъект.ЭтоНовый() Тогда
			
			ЭтотОбъект.Автор = ПараметрыСеанса.Пользователь;
			
		КонецЕсли;
	#КонецЕсли
	
	СуммаРаботВсего = Работы.Итог("Сумма");
	СуммаЗапчастиВсего = Товары.Итог("Сумма");
	ОбщаяДлительность = Работы.Итог("Длительность");
	СопоставитьРаботыИСоставыЭтапов();
	СопоставитьЭтапыИРегистры();
	
	Renault_АвтосервисОбщий.ЗаписатьИзмененияДокументаВСправочникИзмененияДокументов(ЭтотОбъект);
	
	УпрощенныйРежим = ДилерскийЦентр.ИспользоватьУпрощенныйФункционалСвязиСервисПродажи;
	
	Если Не УпрощенныйРежим Тогда
		
		Если ЭтотОбъект.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен Тогда
			
			Для Каждого Этап из ЭтотОбъект.Этапы Цикл
				
				Если НЕ ЗначениеЗаполнено(Этап.ДлительностьЭтапаПлан) Тогда
					
					Продолжить;
					
				КонецЕсли;
						
				ОбщаяДлительность = Этап.ДлительностьЭтапаПлан;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьКонецЭтапа(ВремяНачалаЭтапа, Длительность)
	
	СтрокаГрафика = ЭтотОбъект.ДилерскийЦентр.АвтосервисГрафикРабот.Найти(ДеньНедели(ВремяНачалаЭтапа), "ДеньНедели");
	ТекущийКонецРабочегоДня = НачалоДня(ВремяНачалаЭтапа) + СтрокаГрафика.КонецРабочегоДня;
	ТекущееНачалоРабочегоДня = НачалоДня(ВремяНачалаЭтапа) + СтрокаГрафика.НачалоРабочегоДня;
	
	ВремяОкончанияЭтапа = ВремяНачалаЭтапа + Длительность * 3600;
	Пока ВремяОкончанияЭтапа > ТекущийКонецРабочегоДня Цикл
		
		ПереносимаяЧасть = ВремяОкончанияЭтапа - ТекущийКонецРабочегоДня;
		ВремяОкончанияЭтапа = ТекущееНачалоРабочегоДня + 86400 + ПереносимаяЧасть;
		ЭтоРаботыСледующегоДня = Истина;
		ВремяПредыдущихРабот = ПереносимаяЧасть;
		ВремяНачалаРаботы = ТекущееНачалоРабочегоДня + 86400;
		
		ТекущееНачалоРабочегоДня = ТекущееНачалоРабочегоДня + 86400;
		ТекущийКонецРабочегоДня = ТекущийКонецРабочегоДня + 86400;
		
	КонецЦикла;
	
	Возврат ВремяОкончанияЭтапа;
	
КонецФункции

Процедура ПриЗаписи(Отказ)   	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	СуммаДокумента = СтоимостьВсего;
	
	Для Каждого Этап Из ЭтотОбъект.Этапы Цикл
		
		Если НЕ ЗначениеЗаполнено(Этап.КонецЭтапа) Тогда
			
			Этап.КонецЭтапа = Этап.НачалоЭтапа + Этап.ДлительностьЭтапаПлан*3600;
			
		КонецЕсли;
		
		СтатусЭтапа = Этап.СтатусЭтапа;
		
		Если Не ЗначениеЗаполнено(СтатусЭтапа) Тогда
			
			СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована;
			
		КонецЕсли;
		
		Если СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаПросрочена Тогда
			
			СтатусЭтапа = Справочники.Renault_СтатусыАвторабот.РаботаЗапланирована;
			
		КонецЕсли;
		
		//ЗапланироватьЭтап(Этап, СтатусЭтапа);
		//ОбновитьСтатусЭтапаВрегистре(Этап);
		
	КонецЦикла;
	
	// Трояновский К.Е. 25.10.2019 12:18:40 {
	//ВремяОкончания = ПолучитьВремяОкончания();
	//ВремяНачала = ПолучитьВремяНачала();
	Если НЕ ЗначениеЗаполнено(ВремяОкончания) Тогда
		ВремяОкончания = ПолучитьВремяОкончания();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ВремяНачала) Тогда
		ВремяНачала = ПолучитьВремяНачала();
	КонецЕсли;
	// Трояновский К.Е. 25.10.2019 12:18:40 }
		
	Если Обращение.ВидОбращения.Докомплектация = Истина 
		И Автор <> ПараметрыСеанса.Пользователь И ЗначениеЗаполнено(ВремяНачала) И ЗначениеЗаполнено(ВремяОкончания) Тогда
		
		ОтправитьСообщениеАвтору();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаказНаряд) Тогда
		
		Набор = РегистрыНакопления.Renault_ЧастоИспользуемыеРаботы.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Набор.Записать();
		
		Если ЗаказНаряд.Работы.Количество() <> 0 Тогда
			
			Для Каждого СтрокаРаботы ИЗ ЗаказНаряд.Работы Цикл
				Запись = Набор.Добавить();
				Запись.Период = Дата;
				Запись.Регистратор = Ссылка;
				Запись.Авторабота = СтрокаРаботы.Работа;
				Запись.Модель = Автомобиль.Модель;
				Запись.Количество = СтрокаРаботы.Количество;
				Запись.ГодВыпуска = Год(Автомобиль.ГодВыпуска);
				Запись.Пробег = Renault_АвтосервисОбщий.Renault_ПолучитьПробег(Автомобиль);
			КонецЦикла;
			
			Набор.Записать();
			
		КонецЕсли;
		
		Набор = РегистрыНакопления.Renault_ЧастоИспользуемыеЗапчасти.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Набор.Записать();
		
		Если ЗаказНаряд.Товары.Количество() <> 0 Тогда
			
			Для Каждого СтрокаТовара ИЗ ЗаказНаряд.Товары Цикл
				Запись = Набор.Добавить();
				Запись.Период = Дата;
				Запись.Регистратор = Ссылка;
				Запись.Номенклатура = СтрокаТовара.Номенклатура;
				Запись.Модель = Автомобиль.Модель;
				Запись.Количество = СтрокаТовара.Количество;
				
			КонецЦикла;
			
			Набор.Записать();
			
		КонецЕсли;
		
	Иначе
		
		Набор = РегистрыНакопления.Renault_ЧастоИспользуемыеРаботы.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Набор.Записать();
		
		Если Работы.Количество() <> 0 Тогда
			
			Для Каждого СтрокаРаботы ИЗ Работы Цикл
				Запись = Набор.Добавить();
				Запись.Период = Дата;
				Запись.Регистратор = Ссылка;
				Запись.Авторабота = СтрокаРаботы.Работа;
				Запись.Модель = Автомобиль.Модель;
				Запись.Количество = СтрокаРаботы.Длительность;
				Запись.ГодВыпуска = Год(Автомобиль.ГодВыпуска);
				Запись.Пробег = Renault_АвтосервисОбщий.Renault_ПолучитьПробег(Автомобиль);
			КонецЦикла;
			
			Набор.Записать();
			
		КонецЕсли;
		
		Набор = РегистрыНакопления.Renault_ЧастоИспользуемыеЗапчасти.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Набор.Записать();
		
		Если Товары.Количество() <> 0 Тогда
			
			Для Каждого СтрокаТовара ИЗ Товары Цикл
				Запись = Набор.Добавить();
				Запись.Период = Дата;
				Запись.Регистратор = Ссылка;
				Запись.Номенклатура = СтрокаТовара.Номенклатура;
				Запись.Модель = Автомобиль.Модель;
				Запись.Количество = СтрокаТовара.Количество;
				
			КонецЦикла;
			
			Набор.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтправитьСообщениеАвтору()
	
	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	
	Напоминание.Отправитель = ПараметрыСеанса.Пользователь;
	
	Напоминание.Подробнее = ЭтотОбъект.Обращение.Ссылка;
	
	Напоминание.Адресаты.Добавить().Сотрудник = Автор.Сотрудник;
	
	ДатаОтправки = ТекущаяДата();
	
	Напоминание.ДатаОтправки = ДатаОтправки;
	
	//Напоминание.Комментарий = Примечание;
	
	Напоминание.ПоказыватьС = ДатаОтправки;
	Напоминание.ПоказыватьПо = ДатаОтправки;
	
	Напоминание.Наименование = Автомобиль;
	Напоминание.Сообщение = "Заявка на докомплектацию. Запланированая дата готовности: " + ВремяОкончания + " | ";
	
	Напоминание.Записать();

КонецПроцедуры

Функция ПолучитьВремяОкончания()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.КонецЭтапа КАК КонецЭтапа
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаСервис.Этапы КАК Renault_CRM_ЗаявкаНаСервисЭтапы
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка.Ссылка = &ЭтотДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонецЭтапа УБЫВ";
	
	Запрос.УстановитьПараметр("ЭтотДокумент", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.КонецЭтапа;
		
	Иначе
		
		Возврат Дата("00010101000000");
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьВремяНачала()
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.НачалоЭтапа КАК НачалоЭтапа
	|ИЗ
	|	Документ.Renault_CRM_ЗаявкаНаСервис.Этапы КАК Renault_CRM_ЗаявкаНаСервисЭтапы
	|ГДЕ
	|	Renault_CRM_ЗаявкаНаСервисЭтапы.Ссылка.Ссылка = &ЭтотДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	КонецЭтапа ВОЗР";
	
	Запрос.УстановитьПараметр("ЭтотДокумент", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
