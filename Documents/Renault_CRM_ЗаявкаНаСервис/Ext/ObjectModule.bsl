Процедура ЗаполнитьСтрокуПланаРабот(СтрокаТаблицы, ОписаниеЭтапа, нпп)
	
	//переделать
	
	СтрокаТаблицы.Параметры.ПостПриемщик = ОписаниеЭтапа.Цех;
	СтрокаТаблицы.Параметры.ВрНачала = ОписаниеЭтапа.НачалоЭтапа;
	СтрокаТаблицы.Параметры.ВрОкончания = ОписаниеЭтапа.КонецЭтапа;
	
	Отбор = Новый Структура;
	Отбор.Вставить("IDЭтапа", ОписаниеЭтапа.IDЭтапа);
	
	Состав = СоставЭтапа.НайтиСтроки(Отбор);
	
	СосТек = "";
	
	Для Каждого Сост из Состав Цикл
		
		СосТек = Строка(Сост.Работа) + Символы.ПС + Строка(СосТек);
		
	КонецЦикла;
	
	СтрокаТаблицы.Параметры.Состав = СосТек;
	
КонецПроцедуры

