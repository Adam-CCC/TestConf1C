		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    Номенклатура.Ссылка КАК Номенклатура,
    Номенклатура.Артикул
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
    Справочник.Номенклатура КАК Номенклатура
ГДЕ
    Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
    И НЕ Номенклатура.ЭтоГруппа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ЦеныСрезПоследних.Номенклатура КАК Номенклатура,
    МАКСИМУМ(ЦеныСрезПоследних.Цена) КАК Цена
ПОМЕСТИТЬ ВТ_Цены
ИЗ
    РегистрСведений.Цены.СрезПоследних(
            &amp;ДатаАнализаЦен,
            Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
                И ТипЦен = &amp;ТипЦен) КАК ЦеныСрезПоследних

СГРУППИРОВАТЬ ПО
    ЦеныСрезПоследних.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ВТ_Номенклатура.Номенклатура КАК Номенклатура,
    ВТ_Номенклатура.Артикул КАК Артикул,
    ВЫБОР
        КОГДА ВТ_Цены.Цена ЕСТЬ NULL 
                ИЛИ ВТ_Цены.Цена &lt;= &amp;Класс0
            ТОГДА 0
        КОГДА ВТ_Цены.Цена &lt;= &amp;Класс1
            ТОГДА 1
        КОГДА ВТ_Цены.Цена &lt;= &amp;Класс2
            ТОГДА 2
        ИНАЧЕ 3
    КОНЕЦ КАК Класс,
    ВТ_Цены.Цена КАК ЗначениеПоказателя,
    ЕСТЬNULL(ПредыдущиеПоказатели.Класс, 0) КАК КлассСтарый,
    Renault_КаталогРеферансов.Модель,
    Renault_КаталогРеферансов.ТехСемья,
    Renault_КаталогРеферансов.Сегмент,
    Renault_КаталогРеферансов.Проект
ИЗ
    ВТ_Номенклатура КАК ВТ_Номенклатура
        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Цены КАК ВТ_Цены
        ПО ВТ_Номенклатура.Номенклатура = ВТ_Цены.Номенклатура
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ЦеновыеГруппыНоменклатуры.СрезПоследних(&amp;Период, ) КАК ПредыдущиеПоказатели
        ПО ВТ_Номенклатура.Номенклатура = ПредыдущиеПоказатели.Номенклатура
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
        ПО ВТ_Номенклатура.Артикул = Renault_КаталогРеферансов.Артикул</query>
	</dataSet>
