Процедура СоздатьКорректировкуРеализации()
	
	Попытка
		КорректировкаОбъект = Документы.КорректировкаРеализации.СоздатьДокумент();
		КорректировкаОбъект.Заполнить(РеализацияТоваров);
		КорректировкаОбъект.Комментарий = "Сформирован из документа " + ЭтотОбъект;
		КорректировкаОбъект.Дата = ТекущаяДата();
		Если КорректировкаОбъект.Услуги.Количество() > 0 Тогда
			СтрокаУслуг = КорректировкаОбъект.Услуги[0];
			СтрокаУслуг.Количество = 1;
			СтрокаУслуг.Цена = СтрокаУслуг.Цена - СуммаДокумента;
			СтрокаУслуг.Сумма = СтрокаУслуг.Сумма - СуммаДокумента;
			СтрокаУслуг.ОтражатьТоварныйУчет = истина;
			КорректировкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КорректировкаРеализации = КорректировкаОбъект.Ссылка;
		Иначе
			КорректировкаРеализации = Документы.КорректировкаРеализации.ПустаяСсылка(); 
		КонецЕсли;	
	Исключение
		КорректировкаРеализации = Документы.КорректировкаРеализации.ПустаяСсылка(); 
	КонецПопытки;	
	
КонецПроцедуры	

