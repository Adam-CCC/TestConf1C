Процедура ПечатьНаправленияВКассу() Экспорт
	
	Если НЕ Проведен Тогда
		Сообщить("Направление может быть распечатано только после проведения документа");	
		Возврат;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("НаправлениеВКассу");	
    Область = Макет.ПолучитьОбласть("Направление");
	Область.Параметры.Заголовок = "Направление на возврат № " + Ссылка.Номер;
	Область.Параметры.НомерПолиса = "" + СокрЛП(СтраховойПолис.СерияБСО) + " " + СокрЛП(СтраховойПолис.НомерБСО);
	Область.Параметры.ДатаЗаключения = СтраховойПолис.ДатаСтрахования;
	Область.Параметры.Дата = ДатаОплаты;
	Область.Параметры.СтраховаяКомпания = СтраховойПолис.СтраховаяКомпания;
	Область.Параметры.Сумма = "" + Цел(СуммаДокумента) + " руб. " + Прав(Формат(СуммаДокумента, "ЧДЦ=2"), 2) + " коп.";
	Область.Параметры.Агент = Агент;
	Область.Параметры.Контрагент = Контрагент;
	
	ТабДок.Вывести(Область);
	
	ТабДок.Показать();

КонецПроцедуры

