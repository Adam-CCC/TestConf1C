// + КМ
Процедура ОбработатьШаблоныВступления(МакетАнкеты)
	
	ОбластьВступление = МакетАнкеты.Области.Найти("Вступление");
	
	Если ОбластьВступление = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВступления = ОбластьВступление.Текст;

	ТекстВступления = СтрЗаменить(ТекстВступления, "<ФИО>", ОпрашиваемоеЛицо);
	ТекстВступления = СтрЗаменить(ТекстВступления, "<Телефон>", ОпрашиваемоеЛицо.ОсновнойТелефон);
	ТекстВступления = СтрЗаменить(ТекстВступления, "<Менеджер>", Менеджер);
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.Событие") Тогда
		ТекстВступления = СтрЗаменить(ТекстВступления, "<Автомобиль>", ДокументОснование.Автомобиль);
	КонецЕсли;
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказНаряд") Тогда
		ТекстВступления = СтрЗаменить(ТекстВступления, "<Автомобиль>", ДокументОснование.Автомобиль);
		ТекстВступления = СтрЗаменить(ТекстВступления, "<Мастер>", ДокументОснование.Диспетчер);				
	КонецЕсли;
	
	ОбластьВступление.Текст = ТекстВступления;
	
КонецПроцедуры
// - КМ

