Функция СМГ_ПередЗаписью(РежимЗаписи)
	
	флОтказ = Ложь;
	
	
	//Бондаренко++ 20220601
	Если НЕ РольДоступна("ПолныеПрава") Тогда 
 		флОтказ = СМГ_АвтомобильПроданПоЭтомуЗаказу();
		Если флОтказ Тогда 
			Возврат флОтказ;
	 	КонецЕсли;
	КонецЕсли;
 	//Бондаренко-- 20220601
 	
	//Бондаренко++ 20220520
	//Создает договор, если он не заполнен 
	Если обЗначениеНеЗаполнено(ЭтотОбъект.ДоговорВзаиморасчетов) И ( (РежимЗаписи=РежимЗаписиДокумента.Запись И Ссылка.Проведен) ИЛИ РежимЗаписи=РежимЗаписиДокумента.Проведение ) Тогда
		ЭтотОбъект.ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.СМГ_СоздатьДоговор(ЭтотОбъект.Контрагент,ЭтотОбъект.Организация,ЭтотОбъект.ПодразделениеКомпании,ЭтотОбъект.Номер,ЭтотОбъект.ДатаСоздания,ТипЗНЧ(ЭтотОбъект));
	КонецЕсли;
	
	//Изменяет договор, если он заполнен и не является долгосрочным
	Если Не обЗначениеНеЗаполнено(ЭтотОбъект.ДоговорВзаиморасчетов) 
		И Не ЭтотОбъект.ДоговорВзаиморасчетов.Долгосрочный 
		И Не обЗначениеНеЗаполнено(ЭтотОбъект.Номер) 
		И Не обЗначениеНеЗаполнено(ЭтотОбъект.ДатаСоздания)
		И Не РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Справочники.ДоговорыВзаиморасчетов.СМГ_ОбновитьДоговор(ЭтотОбъект.ДоговорВзаиморасчетов.ПолучитьОбъект(),ЭтотОбъект.Номер,ЭтотОбъект.Дата,ТипЗНЧ(ЭтотОбъект));
	КонецЕсли;		       
	//Бондаренко-- 20220520  
	
	//Бондаренко++ 20210923
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НЕ флОтказ Тогда
	 	флОтказ = обЗначениеНеЗаполнено(ДоговорВзаиморасчетов);
		Если флОтказ Тогда
			Сообщить("Договор взаиморасчетов не заполнен, проведение невозможно.",  СтатусСообщения.Важное);
			Возврат флОтказ;
		КонецЕсли;
	КонецЕсли;             
	//Бондаренко-- 20210923
 	
	// Семенихин 27.05.2021 +++++
	Если НЕ флОтказ И обЗначениеНеЗаполнено(Комментарий) Тогда
		Комментарий = "Автомобиль готов к выдаче.";
	КонецЕсли;
	// Семенихин 13.04.2022 -----
	
	Возврат флОтказ;
	
КонецФункции // СМГ_ПередЗаписью()
