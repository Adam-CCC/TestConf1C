	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт)
	|	И ПодтверждающиеДокументы.Текущий = ИСТИНА";
	Запрос.УстановитьПараметр("Владелец", Ссылка.Автор.Сотрудник);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	НомерДоговора = ?(ЗначениеЗаполнено(Ссылка.ДоговорВзаиморасчетов), ?(ЗначениеЗаполнено(Ссылка.ДоговорВзаиморасчетов.НомерДоговора), Ссылка.ДоговорВзаиморасчетов.НомерДоговора, Ссылка.Номер), Ссылка.ДоговорВзаиморасчетов);
	//ОбластьМакета.Параметры.Номер = НомерДоговора;
	
	ОбластьМакета.Параметры.НомерДоверенности = Ссылка.Номер;
	ОбластьМакета.Параметры.ДатаДоверенности = Формат(ДатаДоговора,"ДЛФ=D");
	ОбластьМакета.Параметры.Город = Город(Ссылка);
	//ОбластьМакета.Параметры.ДатаПрописью = Формат(Дата(Сред(ДатаДоговора,7),Сред(ДатаДоговора,4,2),Сред(ДатаДоговора,1,2)),"ДЛФ=DD");
 	
	//Чтение значения для руководителя
	СтруктураОтбора = Новый Структура("Организация,Объект", Ссылка.Организация, Перечисления.ВидыОбъектовСведений.Руководитель);
	СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(РабочаяДата, СтруктураОтбора);
	Руководитель = СтруктураСведений.Значение;
	СтруктураСведений = Неопределено;
	Попытка
		СтруктураОтбора = Новый Структура("Организация", Ссылка.Организация);
		СтруктураСведений = РегистрыСведений.ИОГенеральногоДиректора.ПолучитьПоследнее(Ссылка.Дата, СтруктураОтбора);
	Исключение
	КонецПопытки;
	Если Ссылка.Организация.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
		Если СтруктураСведений <> Неопределено И Ссылка.Дата >= СтруктураСведений.ДатаНачала И Ссылка.Дата < КонецДня(СтруктураСведений.ДатаОкончания) Тогда
			Руководитель = СтруктураСведений.Значение;
			ОбластьМакета.Параметры.ВЛицеРуководителя = " и.о. Генерального директора " + ПадежФИО(Руководитель.Наименование);
			ФормаВыбора = Справочники.ПодтверждающиеДокументы.ПолучитьФормуВыбора();
			ФормаВыбора.Заголовок = "Выбор доверенности для и.о. Генерального директора";
			ФормаВыбора.Отбор.Владелец.Значение = Руководитель;
			ФормаВыбора.Отбор.Владелец.Использование = Истина;
			ФормаВыбора.Отбор.ВидПодтверждающегоДокумента.Значение = Перечисления.ВидыДокументов.Доверенность;
			ФормаВыбора.Отбор.ВидПодтверждающегоДокумента.Использование = Истина;
			ПодтвДокументСсылка = ФормаВыбора.ОткрытьМодально();	
			Если ЗначениеЗаполнено(ПодтвДокументСсылка) Тогда
				ПодтвДокумент = ПодтвДокументСсылка.Наименование;
				ОбластьМакета.Параметры.НаОсновании = "доверенности от " + Формат(ПодтвДокументСсылка.ДатаВыдачи, "ДЛФ=Д");			
			Иначе
				//Возврат Неопределено;
			КонецЕсли;	
		Иначе
			
			ОбластьМакета.Параметры.ВЛицеРуководителя = "Генерального директора " + ПадежФИО(Руководитель.Наименование);
			ОбластьМакета.Параметры.НаОсновании = " действующего на основании Устава";			
		КонецЕсли;
	Иначе
		ОбластьМакета.Параметры.ВЛицеРуководителя = ПадежФИО(Руководитель.Наименование);
		ОбластьМакета.Параметры.НаОсновании = "";			
	КонецЕсли;
	
 	ОбластьМакета.Параметры.НаименованиеПолное = "" + ?(ЗначениеЗаполнено(Ссылка.Организация), Ссылка.Организация.НаименованиеПолное, Ссылка.Организация);
 	ОбластьМакета.Параметры.Доверитель = Руководитель.Наименование;
 	ОбластьМакета.Параметры.СерияПаспорта = Результат.Серия;
	ОбластьМакета.Параметры.НомерПаспорта = Результат.Номер;
	ОбластьМакета.Параметры.Выдан = "" + Результат.Выдан + ", дата выдачи " + Формат(Результат.ДатаВыдачи, "ДФ='dd.MM.yyyy ""г.""'; ДП=");
	ОбластьМакета.Параметры.Адрес = ПокупательАдрес;
	ОбластьМакета.Параметры.ДатаРождения = ?(ЗначениеЗаполнено(Ссылка.Автор), "" + Формат(Ссылка.Автор.Сотрудник.ДатаРождения, "ДФ='dd.MM.yyyy ""г.р.""'") + ", ", "");
   	
	ТабДокумент.Вывести(ОбластьМакета);
 	
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОтображатьСетку = Ложь;
 	
	ТабДокумент.РазмерКолонтитулаСверху = 7;
	ТабДокумент.ВерхнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	ТабДокумент.ВерхнийКолонтитул.Шрифт = Новый Шрифт("Arial", 7);
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа = "Редакция от 18.06.2018г.";
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница = 1;
	ТабДокумент.ВерхнийКолонтитул.Выводить = Истина;
 	
	Возврат ТабДокумент; 
	
КонецФункции

// Возвращает доступные варианты печати документа
// Возвращаемое значение: Структура, каждая строка которой
// соответствует одному из вариантов печати
