Функция СоздатьРабочийЛистОпт() Экспорт
	Если ЗначениеЗаполнено(РабочийЛист) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ДатаНачала = Дата - 1800;
	РабочийЛистОбъект = Документы.РабочийЛист.СоздатьДокумент();
	РабочийЛистОбъект.Заполнить(Неопределено);
	РабочийЛистОбъект.Дата = ДатаНачала;
	РабочийЛистОбъект.ДатаСоздания = ДатаНачала;
	РабочийЛистОбъект.Организация = Организация;
	РабочийЛистОбъект.ПодразделениеКомпании = ПодразделениеКомпании;
	РабочийЛистОбъект.УстановитьНовыйНомер();
	
	РабочийЛистОбъект.Менеджер = Менеджер;
	РабочийЛистОбъект.Контрагент = Заказчик;
	РабочийЛистОбъект.ПредставлениеТелефона = Заказчик.ОсновнойТелефон;
	РабочийЛистОбъект.ВидКонтакта = Перечисления.ВидыСобытий.ЛичнаяВстреча;
	РабочийЛистОбъект.Статус = Справочники.СтатусыРабочегоЛиста.Сделка;
	Если ЗначениеЗаполнено(Заказчик.Пол) Тогда
		РабочийЛистОбъект.Пол = Заказчик.Пол;
	Иначе
		РабочийЛистОбъект.Пол = Перечисления.ПолФизическихЛиц.НеУказан;
	КонецЕсли;

	Если ЗначениеЗаполнено(Автомобиль) И ТипЗнч(Автомобиль) = Тип("СправочникСсылка.Автомобили") Тогда
		РабочийЛистОбъект.Автомобиль = Автомобиль;
		РабочийЛистОбъект.Модель = Автомобиль.Модель;
	ИначеЕсли ЗначениеЗаполнено(Модель) Тогда
		РабочийЛистОбъект.Модель = Модель;
	Иначе
		#Если Клиент Тогда	
		Сообщить("Необходимо указать Автомобиль или Модель!", СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		РабочийЛистОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		#Если Клиент Тогда	
		Сообщить("Не удалось записать Рабочий лист!" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецПопытки;
	
	РабочийЛист = РабочийЛистОбъект.Ссылка;
	ДокументОснование = РабочийЛист;
	
	СобытиеОбъект = Документы.Событие.СоздатьДокумент();
	СобытиеОбъект.Заполнить(РабочийЛист);
	СобытиеОбъект.ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча;
	СобытиеОбъект.Приоритет = Перечисления.Важность.Средняя;
	СобытиеОбъект.ТипСообщения = Перечисления.ТипыСообщений.Входящее;
	СобытиеОбъект.Состояние = Перечисления.СостоянияСобытий.Завершено;
	СобытиеОбъект.Дата = ДатаНачала;
	СобытиеОбъект.ДатаНачала = ДатаНачала;
	СобытиеОбъект.ДатаОкончания = ДатаНачала + 900;
	
	Попытка
		СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		#Если Клиент Тогда	
		Сообщить("Не удалось записать Событие Личная встреча!" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Записать();
		Возврат Истина;
	Исключение
		#Если Клиент Тогда	
		Сообщить("Не удалось записать Заказ на автомобиль!" + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Важное);
		#КонецЕсли
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

