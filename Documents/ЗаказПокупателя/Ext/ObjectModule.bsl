	//	И Не обЗначениеНеЗаполнено(ЭтотОбъект.ДатаСоздания) 
	//	И Не РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
	//	Справочники.ДоговорыВзаиморасчетов.СМГ_ОбновитьДоговор(ЭтотОбъект.ДоговорВзаиморасчетов.ПолучитьОбъект(),ЭтотОбъект.Номер,ЭтотОбъект.Дата,ТипЗНЧ(ЭтотОбъект));
	//КонецЕсли;		       
	//Бондаренко-- 20221220
 	
	//Бондаренко++ 20210923
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НЕ Отказ Тогда
	 	флОтказ = обЗначениеНеЗаполнено(ДоговорВзаиморасчетов);
		Если флОтказ Тогда
			Сообщить("Договор взаиморасчетов не заполнен, проведение невозможно.",  СтатусСообщения.Важное);
		КонецЕсли;
	КонецЕсли;             
	//Бондаренко-- 20210923
	
	//Бондаренко++ 20250514
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И НЕ ЭтоНовый() И НЕ Отказ Тогда
	 	флОтказ = ЗаказПоставщикуПроведен(ЭтотОбъект.Ссылка);
		Если флОтказ Тогда
			СМГ_Сообщить("Обработка проведения прервана.",  СтатусСообщения.ОченьВажное);
		КонецЕсли;
	КонецЕсли;             
	//Бондаренко-- 20250514
	
	//Бондаренко++ 20250520
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения И НЕ Отказ Тогда
	 	флОтказ = ЗаказПоставщикуПроведен(ЭтотОбъект.Ссылка);
		Если флОтказ Тогда
			СМГ_Сообщить("Обработка отмены проведения прервана.",  СтатусСообщения.ОченьВажное);
		КонецЕсли;
	КонецЕсли;             
	//Бондаренко-- 20250520
	
	//Бондаренко++ 2017113
	Если НЕ обЗначениеНеЗаполнено(ДокументОснование) Тогда
 		Если ТипЗНЧ(ДокументОснование)=Тип("ДокументСсылка.ЗаказНаряд") Тогда
			Если НЕ обЗначениеНеЗаполнено(ДокументОснование.Заказчик) Тогда	
				Если Ссылка.Заказчик <> ДокументОснование.Заказчик Тогда		
					Заказчик = ДокументОснование.Заказчик;
				КонецЕсли; 	
			КонецЕсли; 	
		КонецЕсли; 	
	КонецЕсли; 
	//Бондаренко++ 20171103
  	
	Возврат флОтказ;
	
КонецФункции // СМГ_ПередЗаписью(Отказ,РежимЗаписи,РежимПроведения)

//Бондаренко++ 20250314
Функция ЗаказПоставщикуПроведен(ЗаказПокупателяСсылка)
	
	Флаг = Ложь;
	
	//Бондаренко++ 20250515
	Если НЕ обЗначениеНеЗаполнено(ЗаказПокупателяСсылка) Тогда
	//Бондаренко-- 20250515	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПоставщику.Ссылка КАК Ссылка,
		|	ЗаказПоставщику.Проведен КАК Проведен,
		|	ЗаказПоставщику.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.ДокументОснование = &ЗакПок
		|	И ЗаказПоставщику.Проведен";
		
		Запрос.УстановитьПараметр("ЗакПок", ЗаказПокупателяСсылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СМГ_Сообщить("ОШИБКА! Подчинённый документ """+СокрЛП(ВыборкаДетальныеЗаписи.Ссылка)+""" уже проведён.",  СтатусСообщения.ОченьВажное);
			Флаг = Истина;
		КонецЦикла;
		
	//Бондаренко++ 20250515	
	КонецЕсли;
    //Бондаренко-- 20250515
	
	Возврат Флаг;

КонецФункции // ЗаказПоставщикуПроведен(ЗаказПокупателяСсылка)
