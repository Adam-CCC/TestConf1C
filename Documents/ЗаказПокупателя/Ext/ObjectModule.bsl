	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорВзаиморасчетов = ВыборкаДетальныеЗаписи.Ссылка; 
		Если ВыборкаДетальныеЗаписи.ДляПерепродаж Тогда
			Прервать;
 		КонецЕсли; 
 	КонецЦикла;
	
	Если обЗначениеНезаполнено(ДоговорВзаиморасчетов) Тогда
		Дог = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		Дог.Автор=ПараметрыСеанса.Пользователь;
		Дог.ДатаСоздания=ТекущаяДата();
		Дог.ДатаНачала=ТекущаяДата();
		Дог.ВидДоговора=ПараметрыДоговора.ВидДоговора;
		Дог.Владелец = ПараметрыДоговора.Контрагент;
		Дог.Организация = ПараметрыДоговора.Организация;
		Дог.Подразделение = ПараметрыДоговора.Подразделение;
		Дог.ВалютаВзаиморасчетов=Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		Дог.ВидОплаты=Перечисления.ВидыОплаты.ПроизвольнаяОплата;
		Дог.ДляЗапчастей=Истина;
		Дог.ДляПерепродаж=Истина;
 		Дог.Наименование = СокрЛП(Строка(Дог.ВидДоговора))
	             + ?(ПустаяСтрока(Дог.НомерДоговора),""," № " + СокрЛП(Дог.НомерДоговора))
	             + " в " + Дог.ВалютаВзаиморасчетов.Наименование
	             + " от "+Формат(Дог.ДатаНачала,"ДФ=дд.ММ.гг");
 		
		Попытка
 			Дог.Записать();
			ДоговорВзаиморасчетов = Дог.Ссылка;
 		Исключение
			Сообщить("ОШИБКА! Не удалось записать договор");		
		КонецПопытки;
 	
	КонецЕсли; 
	
	Возврат ДоговорВзаиморасчетов;
 	

КонецФункции // НайтиДоговор(ПараметрыДоговора)
 
Функция НайтиРозничнуюЦену(Номенклатура,ТипЦен,ЕдИзмерения,Подразделение)

	 	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныСрезПоследних.Номенклатура,
		|	ЦеныСрезПоследних.ТипЦен,
		|	ЦеныСрезПоследних.ЕдиницаИзмерения,
		|	ЦеныСрезПоследних.ПодразделениеКомпании,
		|	ЦеныСрезПоследних.Цена,
		|	ЦеныСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
		|ГДЕ
		|	ЦеныСрезПоследних.Номенклатура = &ВыбНомен
		|	И ЦеныСрезПоследних.ТипЦен = &ВыбТипЦен
		|	И ЦеныСрезПоследних.ЕдиницаИзмерения = &ВыбЕдИзмерен
		|	И ЦеныСрезПоследних.ПодразделениеКомпании = &ВыбПодразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
		
	Запрос.Параметры.Вставить("ВыбНомен",Номенклатура);
	Запрос.Параметры.Вставить("ВыбТипЦен",ТипЦен);
	Запрос.Параметры.Вставить("ВыбЕдИзмерен",ЕдИзмерения);
	Запрос.Параметры.Вставить("ВыбПодразделение",Подразделение);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Цена;
	КонецЦикла;
	
	Возврат 0;
	

КонецФункции // НайтиРозничнуюЦену()
