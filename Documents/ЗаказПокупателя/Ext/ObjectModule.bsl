Процедура СформироватьПерепродажуРеализациями(ВопросОПеремещении=Истина,ВозврЗначение) Экспорт
	
	Если ВопросОПеремещении Тогда
		#Если НаКлиенте Тогда
 		Если Вопрос("Сформировать перепродажу между юридическими лицами компании?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
	ТоварыКПродаже = Новый ТаблицаЗначений;
	ТоварыКПродаже.Колонки.Добавить("Товар");
 	ТоварыКПродаже.Колонки.Добавить("Количество");
    ТоварыКПродаже.Колонки.Добавить("Цена");
	ТоварыКПродаже.Колонки.Добавить("СуммаВсего");
	ТоварыКПродаже.Колонки.Добавить("ЕдиницаИзмерения");
	ТоварыКПродаже.Колонки.Добавить("ОрганизацияПоставщик");
	ТоварыКПродаже.Колонки.Добавить("ПодразделениеПоставщик");
	ТоварыКПродаже.Колонки.Добавить("СкладОтправитель");
	ТоварыКПродаже.Колонки.Добавить("ИНН_Покупателя");
	ТоварыКПродаже.Колонки.Добавить("ИНН_Продавца");

	СЗ_СкладовОтправителей = Новый СписокЗначений;
	
	Для Каждого стр из Товары Цикл
		
		Если обЗначениеНеЗаполнено(стр.СкладыКомпании) Тогда
		    Продолжить;
 		КонецЕсли; 
		
  		СтрокаТоварыКПродаже = ТоварыКПродаже.Добавить();
		
 		СтрокаТоварыКПродаже.Товар = стр.Номенклатура;
  		СтрокаТоварыКПродаже.Количество = стр.Количество;
		
		СтрокаТоварыКПродаже.Цена = стр.Цена;
		СтрокаТоварыКПродаже.СуммаВсего = стр.СуммаВсего;
		
		//СтрокаТоварыКПродаже.ЗН = Ссылка.Ссылка;
		СтрокаТоварыКПродаже.ЕдиницаИзмерения = стр.ЕдиницаИзмерения;
		СтрокаТоварыКПродаже.ОрганизацияПоставщик = стр.СкладыКомпании.Организация;
		СтрокаТоварыКПродаже.ПодразделениеПоставщик = стр.СкладыКомпании.Подразделение;
		СтрокаТоварыКПродаже.СкладОтправитель = стр.СкладыКомпании;
		СтрокаТоварыКПродаже.ИНН_Покупателя = Ссылка.СкладКомпании.Организация.ИНН;
		СтрокаТоварыКПродаже.ИНН_Продавца = стр.СкладыКомпании.Организация.ИНН; 
		
		Если СЗ_СкладовОтправителей.НайтиПоЗначению(стр.СкладыКомпании)=Неопределено Тогда
			СЗ_СкладовОтправителей.Добавить(стр.СкладыКомпании);
 		КонецЕсли; 
		
	КонецЦикла;	
	
	//ТоварыКПродаже.ВыбратьСтроку();
 	
 	БылиОшибки = Истина;  
	
	Если ТоварыКПродаже.Количество() > 0 тогда
		НачатьТранзакцию();
		Для каждого ЗначениеСклада Из СЗ_СкладовОтправителей Цикл
 			БылиОшибки = СоздатьДокументыПерепродажиПоЮрЛицам(ТоварыКПродаже,ЗначениеСклада.Значение);
 		КонецЦикла; 
 		ЗафиксироватьТранзакцию();
	КонецЕсли; 
	
	Если БылиОшибки Тогда
		Сообщить("Обработка по перепродаже завершена С ошибками",СтатусСообщения.ОченьВажное);
		ВозврЗначение=Ложь;
	Иначе	
  		Сообщить("Обработка по перепродаже завершена БЕЗ ошибок.",СтатусСообщения.Обычное);	
		ВозврЗначение=Истина;
   	КонецЕсли; 
 		  
КонецПроцедуры	

