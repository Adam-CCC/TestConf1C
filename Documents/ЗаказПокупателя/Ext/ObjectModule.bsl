	//Сообщить("Работает список складов ДЦ");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладыКомпании.Ссылка,
		|	СкладыКомпании.Подразделение.ДилерскийЦентр
		|ИЗ
		|	Справочник.СкладыКомпании КАК СкладыКомпании
		|ГДЕ
		|	СкладыКомпании.Подразделение.ДилерскийЦентр = &ВыбДЦ";
	
	Запрос.УстановитьПараметр("ВыбДЦ", ВыбДЦ);
 	
