	Функция ПечатьАктОбОказанииУслуг(ТабДокумент) Экспорт  
		СтрокаАвтомобиля = Автомобили[0]; 
		ДокументПоступления = СтрокаАвтомобиля.ДокументПоступления;	
		
		ЗапросПродажа = Новый Запрос;
		ЗапросПродажа.Текст =
		"ВЫБРАТЬ
		|	МИНИМУМ(ПродажиАвтомобилейОбороты.ДокументПродажи) КАК ДокументПродажи
		|ИЗ
		|	РегистрНакопления.ПродажиАвтомобилей.Обороты(
		|			&Дата,
		|			,
		|			,
		|			НЕ ДокументПродажи.Контрагент.НашаФирма
		|				И Автомобиль = &Автомобиль) КАК ПродажиАвтомобилейОбороты";
		
		ЗапросПродажа.Параметры.Вставить("Дата", ДокументПоступления.ДатаСоздания);  
		ЗапросПродажа.Параметры.Вставить("Автомобиль", СтрокаАвтомобиля.Автомобиль);
		
		РезультатПродажа = ЗапросПродажа.Выполнить().Выгрузить();
		
		Если РезультатПродажа.Количество() = 0 Тогда
			Сообщить("ОШИБКА!!! Акт об оказании услуг может быть распечатан только по реализованным автомобилям.", СтатусСообщения.ОченьВажное); 
			
			Возврат "";
		КонецЕсли;	
		
		ФорматВыводаСуммы = обПраво("ФорматВыводаСуммы",Права,,ЭтотОбъект);	
		
		Макет = ПолучитьМакет("АктОбОказанииУслуг");
		ОбластьМакета = Макет.ПолучитьОбласть("АктЗаголовок");
		ОбластьМакета.Параметры.Заполнить(ЭтотОбъект);
		ТекстЗаголовка = дкПолучитьПредставление(ЭтотОбъект);
		
		ОбластьМакета.Параметры.ТекстЗаголовка = СтрЗаменить(ТекстЗаголовка,"Отчет комитенту за автомобили","Акт об оказании услуг");
		ОбластьМакета.Параметры.ПредставлениеКомиссионера	= спПолучитьПредставление(Организация);
		ОбластьМакета.Параметры.ПредставлениеКомитента		= спПолучитьПредставление(Контрагент);
		
		ТабДокумент.Вывести(ОбластьМакета);                    
		
		ОбластьМакета = Макет.ПолучитьОбласть("АктШапкаТЧ");
		ТабДокумент.Вывести(ОбластьМакета);                    
		
		ОбластьМакета = Макет.ПолучитьОбласть("АктСтрокаТЧ");
		
		Прибыль = Автомобили.Итог("СуммаПродажи") - Автомобили.Итог("Сумма");	
		
		СуммаДоход = Формат(Прибыль,ФорматВыводаСуммы); 
		СуммаДоходПрописью = обЧислоПрописью(Прибыль,ЭтотОбъект.ВалютаДокумента);	
		
		//Иванченко 20251229 ++
		ОбластьМакета.Параметры.Номенклатура = Справочники.Номенклатура.КомиссионноеВознаграждение;   
		//Иванченко 20251229 --		
		ОбластьМакета.Параметры.СуммаДоход = СуммаДоход;
		ТабДокумент.Вывести(ОбластьМакета);          
		
		ОбластьМакета = Макет.ПолучитьОбласть("АктПодвал"); 
		ОбластьМакета.Параметры.ВалютаДокумента = ВалютаДокумента;
		ОбластьМакета.Параметры.СуммаДоход = СуммаДоход; 
		
		//Иванченко 20251218 ++
		//Если Организация.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
		//	ОбластьМакета.Параметры.НДС = "Включая НДС " + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка + "%:";
		//	СуммаНДС = Прибыль * Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка / (100 + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка);
		//	ОбластьМакета.Параметры.СуммаНДС = Формат(СуммаНДС, ФорматВыводаСуммы);
		//Иначе
		//	ОбластьМакета.Параметры.НДС = "Без налога (НДС):";
		//	ОбластьМакета.Параметры.СуммаНДС = "-";
		//КонецЕсли;
		                                                                                         
		Если СтрокаАвтомобиля.СтавкаНДС = Справочники.СтавкиНДС.БезНДС Тогда
			ОбластьМакета.Параметры.НДС = "Без налога (НДС):"; 
			ОбластьМакета.Параметры.СуммаНДС = "-";
		Иначе
			ОбластьМакета.Параметры.НДС = "Включая " + СтрокаАвтомобиля.СтавкаНДС + ":"; 
			ОбластьМакета.Параметры.СуммаНДС = Формат(СтрокаАвтомобиля.СуммаНДС, ФорматВыводаСуммы) + " "; 
		КонецЕсли;    
		
		//Иванченко 20251229 ++
		//ОбластьМакета.Параметры.СуммаНДССтрокой = "(" + ЧислоПрописью(СтрокаАвтомобиля.СуммаНДС) + ")";
		ОбластьМакета.Параметры.СуммаНДССтрокой = "(" + обЧислоПрописью(СтрокаАвтомобиля.СуммаНДС, ЭтотОбъект.ВалютаДокумента) + ")";  
		//Иванченко 20251229 --		
		//Иванченко 20251218 --
		
		ОбластьМакета.Параметры.СуммаДоходПрописью = СуммаДоходПрописью;
		
		Отпустил = дкОтветственноеЛицо(ЭтотОбъект,"Отпустил");
		Отпустил.ОтпустилПредставление = ?(обЗначениеНеЗаполнено(Отпустил.Отпустил),"","/ "+ Отпустил.ОтпустилПредставление);
		Отпустил.ОтпустилПредставление = СМГ_ПолучитьСотраОтпустил(Ссылка);
		ОбластьМакета.Параметры.Заполнить(Отпустил);
		
		ТабДокумент.Вывести(ОбластьМакета); 

		ТабДокумент.ПолеСверху = 0;
		ТабДокумент.ПолеСлева  = 10;
		ТабДокумент.ПолеСнизу  = 12;
		ТабДокумент.ПолеСправа = 5;   
		ТабДокумент.АвтоМасштаб = Истина;	
		ТабДокумент.ОтображатьСетку = Ложь;
		
		Возврат ТабДокумент 
		
	КонецФункции 
	
	Функция ПечатьАктСФ(ТабДокумент) Экспорт 	
		дкПечать(Ссылка.ПолучитьОбъект(), "Акт об оказании услуг", 0,, Неопределено);
		дкПечать(Ссылка.ПолучитьОбъект(), "Счет-фактура", 0,, Неопределено);
 	КонецФункции 

	Функция ПечатьЗаявлениеНаПеречислениеДС(ТабДокумент) Экспорт  
		СтрокаАвтомобиля = Автомобили[0]; 
		ДокументПоступления = СтрокаАвтомобиля.ДокументПоступления;	
		ДатаДоговора = ?(ЗначениеЗаполнено(ДокументПоступления.ДоговорВзаиморасчетов.ДатаКП), ДокументПоступления.ДоговорВзаиморасчетов.ДатаКП, ДокументПоступления.ДатаСоздания);	
		
		СтруктураЗаполнения = Новый Структура;
		СтруктураЗаполнения.Вставить("Контрагент", Контрагент); 
		Паспорт = спПолучитьПодтверждающийДокументОбъектаПоВиду(Контрагент, Перечисления.ВидыДокументов.Паспорт); 
		
		Если ЗначениеЗаполнено(Паспорт) Тогда
			СтруктураЗаполнения.Вставить("Документ", "паспорт " + Паспорт.Серия + " №" + Паспорт.Номер + ", выдан " + Паспорт.КемВыдан + ", дата выдачи " + Формат(Паспорт.ДатаВыдачи, "ДЛФ=D"));  
		КонецЕсли;  	
		
		СтруктураЗаполнения.Вставить("НаименованиеДляПечати", Организация.НаименованиеДляПечати);
		СтруктураЗаполнения.Вставить("ЦенаАвто", СтрокаАвтомобиля.СуммаВсего);
		СтруктураЗаполнения.Вставить("ЦенаАвтоПрописью", обЧислоПрописью(СтрокаАвтомобиля.СуммаВсего, ВалютаДокумента));
		СтруктураЗаполнения.Вставить("Модель", СтрокаАвтомобиля.Автомобиль.Модель);
		СтруктураЗаполнения.Вставить("ВИН", СтрокаАвтомобиля.Автомобиль.VIN); 	
		СтруктураЗаполнения.Вставить("Владелец", Контрагент);
		СтруктураЗаполнения.Вставить("ВладелецСЧ", Контрагент.ОсновнойБанковскийСчет.НомерСчета);
		СтруктураЗаполнения.Вставить("ВладелецБанк", Контрагент.ОсновнойБанковскийСчет.Банк);
		СтруктураЗаполнения.Вставить("ВладелецИНН", Контрагент.ИНН);
		СтруктураЗаполнения.Вставить("ВладелецБИК", Контрагент.ОсновнойБанковскийСчет.Банк.Код);
		СтруктураЗаполнения.Вставить("ВладелецКСЧ", Контрагент.ОсновнойБанковскийСчет.Банк.КоррСчет);	
		СтруктураЗаполнения.Вставить("Доверенность", "на праве собственности"); 	
		СтруктураЗаполнения.Вставить("Номер", СокрЛП(?(ЗначениеЗаполнено(ДокументПоступления.ВхДокНомер), ДокументПоступления.ВхДокНомер, ДокументПоступления.Номер)));
		СтруктураЗаполнения.Вставить("Дата", Формат(ДатаДоговора, "ДЛФ=DD"));  
		
		Макет = ПолучитьМакет("ЗаявлениеНаПеречислениеДС");
		Макет.Параметры.Заполнить(СтруктураЗаполнения);
		ТабДокумент.Вывести(Макет); 
		
		ТабДокумент.ПолеСверху		= 0;
		ТабДокумент.ПолеСлева		= 0;
		ТабДокумент.ПолеСнизу		= 0;
		ТабДокумент.ПолеСправа		= 0; 
		ТабДокумент.АвтоМасштаб		= Истина;
		ТабДокумент.ОтображатьСетку = Ложь;
		
		Возврат ТабДокумент;
		
	КонецФункции
	
