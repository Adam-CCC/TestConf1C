Функция НайтиСуммуПоступления(ДокументПоступления, Автомобиль)
	ЗапросПоступление = Новый Запрос();
	ЗапросПоступление.УстановитьПараметр("ДокументПоступления", ДокументПоступления);
	ЗапросПоступление.УстановитьПараметр("Автомобиль", Автомобиль);
	ЗапросПоступление.УстановитьПараметр("ПеремещениеАвтомобилей", Справочники.ХозОперации.ПеремещениеАвтомобилей);
	ЗапросПоступление.Текст =
	"ВЫБРАТЬ
	|	ОстаткиАвтомобилей.Сумма
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей КАК ОстаткиАвтомобилей
	|ГДЕ
	|	ОстаткиАвтомобилей.Партия = &ДокументПоступления
	|	И ОстаткиАвтомобилей.Автомобиль = &Автомобиль
	|	И ОстаткиАвтомобилей.ХозОперация <> &ПеремещениеАвтомобилей
	|	И ОстаткиАвтомобилей.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)";
	
	Результат = ЗапросПоступление.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат 0;
		
	Иначе
		ВыборкаРезулитат = Результат.Выбрать();
		СуммаПоступления = 0;
		Пока ВыборкаРезулитат.Следующий() Цикл
			СуммаПоступления = СуммаПоступления + ВыборкаРезулитат.Сумма;
		КонецЦикла;
		
		Возврат СуммаПоступления;
	КонецЕсли;	
КонецФункции
