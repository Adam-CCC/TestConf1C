//Бондаренко++ 20230601
Функция СМГ_ПолучитьСотраОтпустил(Ссылка)
	
	ОтпустилТекст = "";
	
	Если НЕ обЗначениеНеЗаполнено(Ссылка.Подписант) Тогда
		ПодписантТек = Ссылка.Подписант;
	Иначе
		ПодписантТек = ПараметрыСеанса.Пользователь.Сотрудник;
	КонецЕсли;
	
	ТекущаяДоверенность = СМ_ФормированиеНовыхОбъектов.ПолучитьДоверенность(ПодписантТек,Ссылка.Организация);
	Если ТекущаяДоверенность<>Неопределено Тогда
		ОтпустилТекст = СокрЛП(ПодписантТек.Наименование)+" "+"по доверенности № "+ТекущаяДоверенность.Номер+ " от " + Формат(ТекущаяДоверенность.ДатаВыдачи,"ДФ=dd.MM.yy");;
	Иначе	
		ПодписантТек = дкОтветственноеЛицо(Ссылка.ПолучитьОбъект(),Перечисления.ВидыОбъектовСведений.Руководитель);
		ОтпустилТекст = СокрЛП(ПодписантТек.РуководительПредставление);
	КонецЕсли;
	
	Возврат ОтпустилТекст; 
	
КонецФункции // СМГ_ПолучитьСотраОтпустил(Ссылка)
