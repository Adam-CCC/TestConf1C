Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	//Временное отключение проверки
	//Возврат;
	
	Если ЭтотОбъект.ОбменДанными.Загрузка ИЛИ РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		
		Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
			Сообщить("Оплата должна быть введена на основании страхового полиса!");	
		КонецЕсли;	
		
		Если СтраховойПолис.ОплатаСК Тогда
			Сообщить("Для прямой оплаты страховой компании ввод документов оплаты не требуется!");
			Отказ = истина;
		КонецЕсли;
		
		Если СтраховойПолис.Состояние <> Перечисления.Renault_СтатусыСтраховыхПолисов.ВРаботе И СтраховойПолис.Состояние <> Перечисления.Renault_СтатусыСтраховыхПолисов.Продан Тогда
			Сообщить("Для оплаты полиса установите статус ""В работе"" или ""Продан""!");
			Отказ = истина;
		КонецЕсли;	
		
		Если НЕ БезКвитанции Тогда
			Если НЕ ЗначениеЗаполнено(ТипБСО) Тогда
				Сообщить("Необходимо заполнить тип БСО!");
				Отказ = Истина;
			КонецЕсли;
			//Если НЕ ЗначениеЗаполнено(СерияБСО) Тогда
			//	Сообщить("Необходимо заполнить серию БСО!");
			//	Отказ = Истина;
			//КонецЕсли;
			Если НЕ ЗначениеЗаполнено(НомерБСО) Тогда
				Сообщить("Необходимо заполнить номер БСО!");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;	
		
		ТаблицаБСО = Renault_УчетБСО.ПолучитьПустуюТаблицуБСО();
		НоваяСтрока = ТаблицаБСО.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтотОбъект);
		НоваяСтрока.СтраховаяКомпания = СтраховойПолис.СтраховаяКомпания;
		НоваяСтрока.Количество = 1;
		
		Если НЕ БезКвитанции Тогда
			ЕстьБСОНаТочке = Renault_УчетБСО.ПроверитьНаличиеБСО(Дата, ТаблицаБСО, Организация, СтраховойПолис.СтраховаяКомпания, ТочкаПродаж, истина);
			Если НЕ ЕстьБСОНаТочке Тогда
				Отказ = истина;	
			КонецЕсли;	
		
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("СтраховаяКомпания", СтраховойПолис.СтраховаяКомпания);
			Запрос.УстановитьПараметр("ТипБСО", ТипБСО);
			Запрос.УстановитьПараметр("СерияБСО", СерияБСО);
			Запрос.УстановитьПараметр("НомерБСО", НомерБСО);
			Запрос.Текст = "ВЫБРАТЬ
			               |	Renault_КвитанцииКПолисам.СтраховойПолис,
			               |	Renault_КвитанцииКПолисам.СтраховаяКомпания,
			               |	Renault_КвитанцииКПолисам.ТипБСО,
			               |	Renault_КвитанцииКПолисам.СерияБСО,
			               |	Renault_КвитанцииКПолисам.НомерБСО
			               |ИЗ
			               |	РегистрСведений.Renault_КвитанцииКПолисам КАК Renault_КвитанцииКПолисам
			               |ГДЕ
			               |	Renault_КвитанцииКПолисам.ТипБСО = &ТипБСО
			               |	И Renault_КвитанцииКПолисам.СтраховаяКомпания = &СтраховаяКомпания
			               |	И Renault_КвитанцииКПолисам.СерияБСО = &СерияБСО
			               |	И Renault_КвитанцииКПолисам.НомерБСО = &НомерБСО";
						   
			Если НЕ ЭтоНовый() Тогда
				Запрос.Текст = Запрос.Текст + "
				               |	И Renault_КвитанцииКПолисам.Регистратор <> &Ссылка";
				Запрос.УстановитьПараметр("Ссылка", Ссылка);			   
			КонецЕсли;				   
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Сообщить("Квитанция " + СокрЛП(Выборка.ТипБСО) + " " + СокрЛП(Выборка.СерияБСО) + " " + СокрЛП(Выборка.НомерБСО) + " уже введена для полиса " + Выборка.СтраховойПолис);
				Отказ = истина;
			КонецЦикла;	
		КонецЕсли;
		
		Если СтраховойПолис.ОплатаСК ИЛИ СтраховойПолис.ОплатаЧерезБанк Тогда
			Сообщить("Нельзя ввести документ оплаты, если указано, что весь полис оплачен через страховую или банк");
			Отказ = истина;
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		
		Если ЗначениеЗаполнено(ПлатежныйДокумент) Тогда
			Сообщить("Нельзя отменять проведение документа, если на кассе введен платежный документ");
			Отказ = истина;
		КонецЕсли;	
		
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если НЕ ЗначениеЗаполнено(ДокументОснование) 
			//ИЛИ ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка() 
			//ИЛИ НЕ ЗначениеЗаполнено(ЗаказПокупателя) 
			ИЛИ ЗаказПокупателя <> ДокументОснование.ЗаказПокупателя 
			ИЛИ (ДокументОснование.Состояние <> Перечисления.Renault_СтатусыСтраховыхПолисов.ВРаботе 
			И ДокументОснование.Состояние <> Перечисления.Renault_СтатусыСтраховыхПолисов.Продан) 
			ИЛИ НЕ ДокументОснование.Проведен Тогда
			Сообщить("Полис был изменен, либо не проведен, либо не установлен статус ""В работе"" или ""Продан""");
			Сообщить("Если полис не проведен или имеет другой статус, то установите статус, перепроведите полис и заново введите оплату");
			Сообщить("Если статус полиса верный и он проведен, то введите новый документ ""Оплата страхового полиса""");
			Сообщить("Если документ ""Оплата страхового полиса"" открыт, то закройте его без сохранения и введите заново");
			Отказ = истина;
		КонецЕсли;	
		
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПолучитьПредставлениеКонтрагента(ТекущийКонтрагент)
	
	Представление = "";

	ЭтоЮрЛицо = ТекущийКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	
	ДанныеКонтрагента = ?(ЭтоЮрЛицо, Renault_ОбщегоНазначения.ПолучитьДанныеЮрЛица(ТекущийКонтрагент), Renault_ОбщегоНазначения.ПолучитьДанныеФизЛица(ТекущийКонтрагент));
	
	Если ЭтоЮрЛицо Тогда
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.НаименованиеПолное, ", ", "");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.ИНН,                ", ", "ИНН/КПП ");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.КПП,                "/",  "");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.АдресОсновной,      ", ", "");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.ТелефонОсновной,    ", ", "тел.: ");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.НомерСчета,         ", ", "р/с ");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.БанкНаименование,   ", ", "в банке ");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.БанкБИК,            ", ", "БИК ");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.БанкКоррСчет,       ", ", "к/с ");
	Иначе
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.ПолноеФИО,          ", ", "");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.АдресОсновной,      ", ", "");
		ДобавитьТекстКПредставлению(Представление, ДанныеКонтрагента.ТелефонОсновной,    ", ", "тел.: ");
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

Процедура ДобавитьТекстКПредставлению(ТекущиеПредставление, Знач ТекущийТекст, Разделитель = ",", НачалоТекста ="", КонецТекста = "")
	
	ТекущийТекст      = СокрЛП(ТекущийТекст);
	ДобавитьРазделить = НЕ ПустаяСтрока(ТекущиеПредставление) И Прав(ТекущиеПредставление, СтрДлина(Разделитель)) <> Разделитель И НЕ ПустаяСтрока(ТекущийТекст);
	Если НЕ ПустаяСтрока(ТекущийТекст) Тогда
		ТекущиеПредставление = ТекущиеПредставление + ?(ДобавитьРазделить, Разделитель, "") + НачалоТекста + ТекущийТекст + КонецТекста;
	КонецЕсли;
	
КонецПроцедуры

