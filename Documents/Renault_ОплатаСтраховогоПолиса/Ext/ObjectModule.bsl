
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	//{{__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Renault_СтраховойПолис") Тогда
		// Заполнение шапки
		Агент = ДанныеЗаполнения.Агент;
		Банк = ДанныеЗаполнения.Банк;
//		БанковскийСчетОрганизации = ДанныеЗаполнения.БанковскийСчетОрганизации;
		//ВалютаДокумента = ДанныеЗаполнения.ВалютаДокумента;
		//ВидОплаты = ДанныеЗаполнения.ВидОплаты;
		
		ДокументОснование = ДанныеЗаполнения.Ссылка;
		ЗаказПокупателя = ДанныеЗаполнения.ЗаказПокупателя;
		Комментарий = ДанныеЗаполнения.Комментарий;
		Контрагент = ДанныеЗаполнения.Контрагент;
		//КратностьВзаиморасчетов = ДанныеЗаполнения.КратностьВзаиморасчетов;
		//КурсВзаиморасчетов = ДанныеЗаполнения.КурсВзаиморасчетов;
		//НомерБСО = ДанныеЗаполнения.НомерБСО;
		Организация = ДанныеЗаполнения.Организация;
		Плательщик = ДанныеЗаполнения.Плательщик;
		
		ДоговорПлательщика = CRM_Сервер.DMS_ПолучитьОсновнойДоговорКонтрагента(Плательщик);//ДанныеЗаполнения.ДоговорПлательщика;
		
		
		//Подразделение = ДанныеЗаполнения.Подразделение;
		//Проект = ДанныеЗаполнения.Проект;
		//СерияБСО = ДанныеЗаполнения.СерияБСО;
		СтраховойПолис = ДанныеЗаполнения.Ссылка;
		СтавкаНДС =Справочники.СтавкиНДС.ОсновнаяСтавкаНДС; // ДанныеЗаполнения.СтавкаНДС;
		СуммаВключаетНДС = Истина;// ДанныеЗаполнения.СуммаВключаетНДС;
		СуммаДокумента = ДанныеЗаполнения.СуммаДокумента;
		//ТипБСО = ДанныеЗаполнения.ТипБСО;
		//ТипЦен = ДанныеЗаполнения.ТипЦен;
		ТочкаПродаж = ДанныеЗаполнения.ТочкаПродаж;
		//УсловиеПродаж = ДанныеЗаполнения.УсловиеПродаж;
		УчитыватьНДС = Истина; //ДанныеЗаполнения.УчитыватьНДС;
		//РеализацияТоваров=ДанныеЗаполнения.РеализацияТоваров;
		
		Запрос=Новый Запрос("Выбрать Первые 1 Ссылка Из Документ.РеализацияТоваров Где ДокументОснование=&Заказ");
		Запрос.УстановитьПараметр("Заказ",ЗаказПокупателя);
		Выборка=Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		РеализацияТоваров=Выборка.Ссылка;
		
		Запрос=Новый Запрос;
		Запрос.УстановитьПараметр("Заказ",ЗаказПокупателя);
		Запрос.УстановитьПараметр("РеализацияТоваров",РеализацияТоваров);
		Запрос.Текст="
		|Выбрать Первые 1 Ссылка Из Документ.ПриходныйКассовыйОрдер Где ДокументОснование В(&РеализацияТоваров,&Заказ)
		|Объединить
		|Выбрать Первые 1 Ссылка Из Документ.ПлатежноеПоручение Где ДокументОснование В(&РеализацияТоваров,&Заказ)
		|Объединить
		|Выбрать Первые 1 Ссылка Из Документ.ЧекНаОплату Где ДокументОснование В(&РеализацияТоваров,&Заказ)
		|";
		Выборка=Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		ПлатежныйДокумент=Выборка.Ссылка;
		
	КонецЕсли;
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!

	// регистр Renault_ВзаиморасчетыСоСтрахователями Приход
	Движения.Renault_ВзаиморасчетыСоСтрахователями.Записывать = Истина;
	Движения.Renault_ВзаиморасчетыСоСтрахователями.Очистить();
	Движение = Движения.Renault_ВзаиморасчетыСоСтрахователями.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период = Дата;
	Движение.Организация = Организация;
	Движение.Страхователь = Контрагент;
	Движение.СтраховойПолис = СтраховойПолис;
	Движение.Сумма = СуммаДокумента;

	Движения.Renault_КвитанцииКПолисам.Записывать = Истина;
	Движения.Renault_КвитанцииКПолисам.Очистить();
	
	Движения.Renault_СтатусыБСО.Записывать = Истина;
	Движения.Renault_СтатусыБСО.Очистить();
	
	Если НЕ БезКвитанции Тогда
		// регистр Renault_КвитанцииКПолисам
		Движение = Движения.Renault_КвитанцииКПолисам.Добавить();
		Движение.СтраховаяКомпания = СтраховойПолис.СтраховаяКомпания;
		Движение.ТипБСО = ТипБСО;
		Движение.СерияБСО = СерияБСО;
		Движение.НомерБСО = НомерБСО;
		Движение.СтраховойПолис = СтраховойПолис;
		
		// регистр Renault_СтатусыБСО
		Движение = Движения.Renault_СтатусыБСО.Добавить();
		Движение.Период = Дата;
		Движение.Организация = Организация;
		Движение.СтраховаяКомпания = СтраховойПолис.СтраховаяКомпания;
		Движение.ТипБСО = ТипБСО;
		Движение.СерияБСО = СерияБСО;
		Движение.НомерБСО = НомерБСО;
		Движение.Статус = Перечисления.Renault_СтатусыБСО.Продан;
		
	КонецЕсли;	

	//}}__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
КонецПроцедуры

Процедура ПечатьНаправленияВКассу() Экспорт
	
	Если НЕ Проведен Тогда
		Сообщить("Направление может быть распечатано только после проведения документа");	
		Возврат;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет("НаправлениеВКассу");	
    Область = Макет.ПолучитьОбласть("Направление");
	Область.Параметры.Заголовок = "Направление в кассу № " + Ссылка.Номер;
	Область.Параметры.НомерПолиса = "" + СокрЛП(СтраховойПолис.СерияБСО) + " " + СокрЛП(СтраховойПолис.НомерБСО);
	Область.Параметры.ДатаЗаключения = СтраховойПолис.Дата;
	Область.Параметры.Дата = ДатаОплаты;
	Область.Параметры.СтраховаяКомпания = СтраховойПолис.СтраховаяКомпания;
	Область.Параметры.Сумма = "" + Цел(СуммаДокумента) + " руб. " + Прав(Формат(СуммаДокумента, "ЧДЦ=2"), 2) + " коп.";
	Область.Параметры.Агент = Агент;
	Область.Параметры.Контрагент = Контрагент;
	
	ТабДок.Вывести(Область);
	
	ТабДок.Показать();

КонецПроцедуры

