
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьРеквизитыФормы();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормы()

	Автомобиль = Параметры.Автомобиль;
	ГУР = Параметры.ГУР;
	Кондиционер = Параметры.Кондиционер;
	СалонныйФильтр = Параметры.СалонныйФильтр;
	ТарифнаяЗона = Параметры.ТарифнаяЗона;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Renault_АвтомобилиДопРеквизиты.Автомобиль,
		|	Renault_АвтомобилиДопРеквизиты.СалонныйФильтр,
		|	Renault_АвтомобилиДопРеквизиты.ГУР,
		|	Renault_АвтомобилиДопРеквизиты.AC,
		|	Renault_АвтомобилиДопРеквизиты.КодМоделиДвигателя,
		|	Renault_АвтомобилиДопРеквизиты.ИндексМоделиДвигателя,
		|	ПОДСТРОКА(Renault_АвтомобилиДопРеквизиты.Автомобиль.Модель.Артикул, 0, 3) КАК КодТипаКузова,
		|	Renault_АвтомобилиДопРеквизиты.Фаза,
		|	Renault_АвтомобилиДопРеквизиты.ТипДвигателя,
		|	Renault_АвтомобилиДопРеквизиты.ТипТоплива,
		|	Renault_АвтомобилиДопРеквизиты.ABS,
		|	Renault_АвтомобилиДопРеквизиты.КодМоделиКПП,
		|	Renault_АвтомобилиДопРеквизиты.ИндексМоделиКПП
		|ИЗ
		|	РегистрСведений.Renault_АвтомобилиДопРеквизиты КАК Renault_АвтомобилиДопРеквизиты
		|ГДЕ
		|	Renault_АвтомобилиДопРеквизиты.Автомобиль = &Автомобиль
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Renault_АвтомобилиДопРеквизиты.КодМоделиДвигателя + ВЫБОР
		|		КОГДА Renault_АвтомобилиДопРеквизиты.ИндексМоделиДвигателя = """"
		|			ТОГДА """"
		|		ИНАЧЕ "" "" + Renault_АвтомобилиДопРеквизиты.ИндексМоделиДвигателя
		|	КОНЕЦ КАК КодДвигателя
		|ПОМЕСТИТЬ КодДвигателяАвтомобиля
		|ИЗ
		|	РегистрСведений.Renault_АвтомобилиДопРеквизиты КАК Renault_АвтомобилиДопРеквизиты
		|ГДЕ
		|	Renault_АвтомобилиДопРеквизиты.Автомобиль = &Автомобиль
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Renault_АвтоработыДопРеквизиты.ТипДвигателя,
		|	Renault_АвтоработыДопРеквизиты.Привод
		|ИЗ
		|	РегистрСведений.Renault_АвтоработыДопРеквизиты КАК Renault_АвтоработыДопРеквизиты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодДвигателяАвтомобиля КАК КодДвигателяАвтомобиля
		|		ПО Renault_АвтоработыДопРеквизиты.КодДвигателя = КодДвигателяАвтомобиля.КодДвигателя";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[0].Выбрать();
	
	Если Выборка.Следующий() Тогда
		КодМоделиКузова = Выборка.КодТипаКузова;
	    СалонныйФильтр = Выборка.СалонныйФильтр;
		ГУР = Выборка.ГУР;
	    Кондиционер = Выборка.AC;
		Фаза = ?(Не ЗначениеЗаполнено(Выборка.Фаза), "Фаза 1", Выборка.Фаза);
		ABS = Выборка.ABS;
		ТипТоплива = Выборка.ТипТоплива;
		ТипДвигателя = Выборка.ТипДвигателя;
		ABS = Выборка.ABS;
		КодТипаДвигателя = Выборка.КодМоделиДвигателя;
		КодКПП = Выборка.КодМоделиКПП; 
		ИндексДвигателя = Выборка.ИндексМоделиДвигателя;
		ИндексКПП = Выборка.ИндексМоделиКПП;
	КонецЕсли; 
	
	Привод = "4x2";
	
	Если Не РезультатЗапроса[2].пустой() Тогда
		Таб = РезультатЗапроса[2].Выгрузить();
	    Элементы.ТипДвигателя.СписокВыбора.ЗагрузитьЗначения(Таб.ВыгрузитьКолонку("ТипДвигателя"));
		Элементы.ТипДвигателя.РежимВыбораИзСписка = Истина;
		Привод = ?(Таб[0].Привод = "", Привод, Таб[0].Привод);
	КонецЕсли; 
	
	ЗаполнитьДеревоАвтоработНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоАвтоработНаСервере()
	
	Отборы = Новый Структура;
	Если НЕ Фаза.Пустая() Тогда Отборы.Вставить("Фаза", Фаза) КонецЕсли;
	Если ТипДвигателя <> "" Тогда Отборы.Вставить("ТипДвигателя", ТипДвигателя) КонецЕсли;
	Если ТипТоплива <> "" Тогда Отборы.Вставить("ТипТоплива", ТипТоплива) КонецЕсли;
	Если СалонныйФильтр Тогда Отборы.Вставить("СалонныйФильтр", СалонныйФильтр) КонецЕсли;
	Если ГУР Тогда Отборы.Вставить("ГУР", ГУР) КонецЕсли;
	Если Кондиционер Тогда Отборы.Вставить("Кондиционер", Кондиционер) КонецЕсли;
	Если Привод <> "" Тогда Отборы.Вставить("Привод", Привод) КонецЕсли;
	Если КодТипаДвигателя <> "" Тогда Отборы.Вставить("КодДвигателя", КодТипаДвигателя) КонецЕсли;
	Если ABS Тогда Отборы.Вставить("ABS", ABS) КонецЕсли;
	Если ИндексДвигателя <> "" Тогда Отборы.Вставить("ИндексДвигателя", ИндексДвигателя) КонецЕсли;
	Если КодКПП <> "" Тогда Отборы.Вставить("КодКПП", КодКПП) КонецЕсли;
	Если ИндексКПП <> "" Тогда Отборы.Вставить("ИндексКПП", ИндексКПП) КонецЕсли;
	
	//количество модификаций по регистру
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодМодели", КодМоделиКузова);
	Запрос.Текст = "
	//общее кол-во различных кроме пустых
	|Выбрать
	|	КолВоРазличных.ТипРаботы,
	|	Фаза_К-ЕстьNULL(Фаза_ПЗ,0) Фаза,
	|	ТипДвигателя_К-ЕстьNULL(ТипДвигателя_ПЗ,0) ТипДвигателя,
	|	ТипТоплива_К-ЕстьNULL(ТипТоплива_ПЗ,0) ТипТоплива,
	|	СалонныйФильтр_К-ЕстьNULL(СалонныйФильтр_ПЗ,0) СалонныйФильтр,
	|	ГУР_К-ЕстьNULL(ГУР_ПЗ,0) ГУР,	
	|	Кондиционер_К-ЕстьNULL(Кондиционер_ПЗ,0) Кондиционер,
	|	Привод_К-ЕстьNULL(Привод_ПЗ,0) Привод,
	|	КодДвигателя_К-ЕстьNULL(КодДвигателя_ПЗ,0) КодДвигателя,
	|	ABS_К-ЕстьNULL(ABS_ПЗ,0) ABS,
	|	ИндексДвигателя_К-ЕстьNULL(ИндексДвигателя_ПЗ,0) ИндексДвигателя,
	|	КодКПП_К-ЕстьNULL(КодКПП_ПЗ,0) КодКПП,
	|	ИндексКПП_К-ЕстьNULL(ИндексКПП_ПЗ,0) ИндексКПП
	|ИЗ(
	//количество различных
	|	Выбрать
	|		Авторабота.Наименование ТипРаботы,
	|		Количество(Различные Фаза) Фаза_К,
	|		Количество(Различные ТипДвигателя) ТипДвигателя_К,
	|		Количество(Различные ТипТоплива) ТипТоплива_К,
	|		Количество(Различные СалонныйФильтр) СалонныйФильтр_К,
	|		Количество(Различные ГУР) ГУР_К,
	|		Количество(Различные Кондиционер) Кондиционер_К,
	|		Количество(Различные Привод) Привод_К,
	|		Количество(Различные КодДвигателя) КодДвигателя_К,
	|		Количество(Различные ABS) ABS_К,
	|		Количество(Различные ИндексДвигателя) ИндексДвигателя_К,
	|		Количество(Различные КодКПП) КодКПП_К,
	|		Количество(Различные ИндексКПП) ИндексКПП_К
	|	Из РегистрСведений.Renault_АвтоработыДопРеквизиты ГДЕ КодМодели=&КодМодели 
	|	Сгруппировать По Авторабота.Наименование
	|)КолВоРазличных
	//наличие пустых значений
	|Левое Соединение(
	|	Выбрать
	|		ТипРаботы,
	|		Максимум(Фаза) Фаза_ПЗ,
	|		Максимум(ТипДвигателя) ТипДвигателя_ПЗ,
	|		Максимум(ТипТоплива) ТипТоплива_ПЗ,
	|		Максимум(СалонныйФильтр) СалонныйФильтр_ПЗ,
	|		Максимум(ГУР) ГУР_ПЗ,
	|		Максимум(Кондиционер) Кондиционер_ПЗ,
	|		Максимум(Привод) Привод_ПЗ,
	|		Максимум(КодДвигателя) КодДвигателя_ПЗ,
	|		Максимум(ABS) ABS_ПЗ,
	|		Максимум(ИндексДвигателя) ИндексДвигателя_ПЗ,
	|		Максимум(КодКПП) КодКПП_ПЗ,
	|		Максимум(ИндексКПП) ИндексКПП_ПЗ
	|	ИЗ(		
	|		Выбрать
	|			Авторабота.Наименование ТипРаботы,
	|			Выбор Когда Фаза=Значение(Справочник.Renault_ФазыМоделей.ПустаяСсылка) Тогда 1 Иначе 0 Конец Фаза,
	|			Выбор Когда ТипДвигателя="""" Тогда 1 Иначе 0 Конец ТипДвигателя,
	|			Выбор Когда ТипТоплива="""" Тогда 1 Иначе 0 Конец ТипТоплива,
	|			Выбор Когда Не СалонныйФильтр Тогда 1 Иначе 0 Конец СалонныйФильтр,
	|			Выбор Когда Не ГУР Тогда 1 Иначе 0 Конец ГУР,
	|			Выбор Когда Не Кондиционер Тогда 1 Иначе 0 Конец Кондиционер,
	|			Выбор Когда Привод="""" Тогда 1 Иначе 0 Конец Привод,
	|			Выбор Когда КодДвигателя="""" Тогда 1 Иначе 0 Конец КодДвигателя,
	|			Выбор Когда Не ABS Тогда 1 Иначе 0 Конец ABS,
	|			Выбор Когда ИндексДвигателя="""" Тогда 1 Иначе 0 Конец ИндексДвигателя,
	|			Выбор Когда КодКПП="""" Тогда 1 Иначе 0 Конец КодКПП,
	|			Выбор Когда ИндексКПП="""" Тогда 1 Иначе 0 Конец ИндексКПП
	|		Из РегистрСведений.Renault_АвтоработыДопРеквизиты
	|		ГДЕ КодМодели=&КодМодели 
	|	)ЗП
	|	Сгруппировать По ТипРаботы 
	|)ПустыеЗначения
	|По КолВоРазличных.ТипРаботы=ПустыеЗначения.ТипРаботы
	|";
	ТабМодификацийРесурсов = Запрос.Выполнить().Выгрузить();
	
	МассивАвторабот = Новый Массив;
	Для Каждого СтрРабот Из ТабМодификацийРесурсов Цикл
		ЗП = Новый Запрос("Выбрать Авторабота Из РегистрСведений.Renault_АвтоработыДопРеквизиты ГДЕ КодМодели=&КодМодели И Авторабота.Наименование=&ТипРаботы");
		ЗП.УстановитьПараметр("КодМодели", КодМоделиКузова);
		ЗП.УстановитьПараметр("ТипРаботы", СтрРабот.ТипРаботы);
		СтрокаОтбора = "";
		Для Каждого Эл Из Отборы Цикл
			Если СтрРабот[Эл.Ключ] > 0 Тогда
				СтрокаОтбора = СтрокаОтбора + ?(СтрокаОтбора = "", "", " И ") + Эл.Ключ + "=&" + Эл.Ключ;
				ЗП.УстановитьПараметр(Эл.Ключ, Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		ЗП.Текст = ЗП.Текст + ?(СтрокаОтбора = "", "", " И ") + СтрокаОтбора;
		Для Каждого Работа Из ЗП.Выполнить().Выгрузить().ВыгрузитьКолонку("Авторабота") Цикл
			МассивАвторабот.Добавить(Работа);
		КонецЦикла;
	КонецЦикла;
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.Текст = "
	|ВЫБРАТЬ
	|	АвтоработыЦены.ИтогоНЧ ИтогоНЧ,
	|	ВЫБОР
	|		КОГДА &ТарифнаяЗона=ЗНАЧЕНИЕ(Справочник.Renault_ТарифныеЗоны.ТЗ1) 
	|		ТОГДА АвтоработыЦены.СтоимостьНормоЧасаСНДС1 ИНАЧЕ АвтоработыЦены.СтоимостьНормоЧасаСНДС2
	|	КОНЕЦ СтоимостьНормоЧасаСНДС,
	|	ВЫБОР
	|		КОГДА &ТарифнаяЗона=ЗНАЧЕНИЕ(Справочник.Renault_ТарифныеЗоны.ТЗ1) 
	|		ТОГДА АвтоработыЦены.Цена1ТЗ ИНАЧЕ АвтоработыЦены.Цена2ТЗ
	|	КОНЕЦ ЦенаТЗ,
	|	ЦеныЗапчастей.Запчасть СвязанныеАвтоработы,
	|	ЦеныЗапчастей.Количество,
	|	ЦеныЗапчастей.PNC,
	|	ЦеныЗапчастей.PCL,
	|	Автоработы.Авторабота,
	|	Ложь Выбрать
	|ИЗ РегистрСведений.Renault_АвтоработыДопРеквизиты Автоработы
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтоработыЦены.СрезПоследних АвтоработыЦены ПО Автоработы.Авторабота=АвтоработыЦены.Авторабота
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_АвтоработыЦеныЗапчастей.СрезПоследних ЦеныЗапчастей По Автоработы.Авторабота=ЦеныЗапчастей.Авторабота
	|ГДЕ Автоработы.Авторабота В(&Автоработы)
	
	|УПОРЯДОЧИТЬ ПО Автоработы.Авторабота.Наименование
	|ИТОГИ
	|	МАКСИМУМ(ИтогоНЧ),
	|	МАКСИМУМ(СтоимостьНормоЧасаСНДС),
	|	МАКСИМУМ(ЦенаТЗ)
	|ПО Автоработы.Авторабота
	
	|{ГДЕ 
	|	Автоработы.КодМодели,
	|	Автоработы.Фаза,
	|	Автоработы.ТипДвигателя,
	|	Автоработы.ТипТоплива,
	|	Автоработы.СалонныйФильтр,
	|	Автоработы.ГУР,
	|	Автоработы.Кондиционер,
	|	Автоработы.Привод,
	|	Автоработы.КодДвигателя,
	|	Автоработы.ABS,
	|	Автоработы.ИндексДвигателя,
	|	Автоработы.КодКПП,
	|	Автоработы.ИндексКПП
	|}
	|";
	Построитель.ЗаполнитьНастройки();
	Построитель.Параметры.Вставить("ТарифнаяЗона",ТарифнаяЗона);
	Построитель.Параметры.Вставить("Автоработы",МассивАвторабот);
	//Для Каждого Эл Из МассивОтбора Цикл
	//	Если Не ЗначениеЗаполнено(Эл.Значение) Тогда Продолжить КонецЕсли;
	//	
	//	Запрос=Новый Запрос("Выбрать Количество(Различные "+Эл.Ключ+") КолВо Из РегистрСведений.Renault_АвтоработыДопРеквизиты ГДЕ "+Эл.Ключ+"<>&ПустоеЗначение");
	//	Если Запрос.Выполнить().Выгрузить()[0].КолВо=0 Тогда Продолжить КонецЕсли;
	//	
	//	Отбор=Построитель.Отбор.Добавить(Эл.Ключ);
	//	Отбор.ВидСравнения=ВидСравнения.Равно;
	//	Отбор.Значение=Эл.Значение;
	//	Отбор.Использование=Истина;
	//КонецЦикла;	
	Построитель.Выполнить();
	ЗначениеВРеквизитФормы(Построитель.Результат.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам),"ДеревоКомплексовАвторабот");
	Возврат;
	
	//Если ТипДвигателя = "" или ТипТоплива = "" Тогда
	//    Возврат;	
	//КонецЕсли; 	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_АвтоработыДопРеквизиты.Авторабота,
		|	ЛОЖЬ КАК Выбрать
		|ПОМЕСТИТЬ ВсеАвтоработы
		|ИЗ
		|	РегистрСведений.Renault_АвтоработыДопРеквизиты КАК Renault_АвтоработыДопРеквизиты
		|ГДЕ
		|	(Renault_АвтоработыДопРеквизиты.КодМодели = &КодМодели
		|			ИЛИ &КодМодели = """")
		|	И (Renault_АвтоработыДопРеквизиты.Фаза = &Фаза
		|			ИЛИ Renault_АвтоработыДопРеквизиты.Фаза = ЗНАЧЕНИЕ(Справочник.Renault_ФазыМоделей.ПустаяСсылка))
		|	И (Renault_АвтоработыДопРеквизиты.КодДвигателя = &КодДвигателя
		|			ИЛИ &КодДвигателя = """")
		|	И Renault_АвтоработыДопРеквизиты.ГУР = &ГУР
		|	И Renault_АвтоработыДопРеквизиты.Кондиционер = &Кондиционер
		|	И (Renault_АвтоработыДопРеквизиты.Привод = &Привод
		|			ИЛИ &Привод = ""4x2"")
		|	И Renault_АвтоработыДопРеквизиты.ABS = &ABS
		|	И Renault_АвтоработыДопРеквизиты.СалонныйФильтр = &СалонныйФильтр
		|	И (Renault_АвтоработыДопРеквизиты.ТипДвигателя = &ТипДвигателя
		|			ИЛИ &ТипДвигателя = """")
		|	И (Renault_АвтоработыДопРеквизиты.ТипТоплива = &ТипТоплива
		|			ИЛИ &ТипТоплива = """")
		|	И (Renault_АвтоработыДопРеквизиты.ИндексДвигателя = &ИндексДвигателя
