Процедура ПриЗаписи(Отказ)    	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	// регистр Renault_ОбращенияВАвтосервис
	//Набор = РегистрыСведений.Renault_ОбращенияВАвтосервис.СоздатьНаборЗаписей();
	//Набор.Отбор.Обращение.Установить(Ссылка);
	//Набор.Прочитать();
	//Набор.Очистить();
	
	//Запись = Набор.Добавить();
	//Запись.Обращение = Ссылка;
	//Запись.Контрагент = Клиент;
	//Запись.Период = Дата;
	//Набор.Записать();
	
	//Сергеев /DMSREN-1129
	Если ЗначениеЗаполнено(Клиент) Тогда
		Запись = РегистрыСведений.Renault_ОбращенияВАвтосервис.СоздатьМенеджерЗаписи();
		Запись.Обращение = Ссылка;
		Запись.Контрагент = Клиент;
		Запись.Период = Дата;
		Запись.Записать();
	КонецЕсли;
	
	Если ЭтотОбъект.Жалоба Тогда
		
		Если ЗначениеЗаполнено(Менеджер) Тогда
			
			Если Справочники.Renault_СообщенияПользователю.НайтиПоРеквизиту("ИдентификаторОбъекта", Строка(ЭтотОбъект.Ссылка.УникальныйИдентификатор())) = Справочники.Renault_СообщенияПользователю.ПустаяСсылка() Тогда
			
				Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
				
				Напоминание.Отправитель = ПараметрыСеанса.Пользователь;
				
				ОтборДЦ = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ЭтотОбъект.Менеджер);
				
				Отдел = Renault_CRM.ПолучитьОтделАвтосалона(ОтборДЦ);
				
				Запрос = Новый Запрос();
				Запрос.Текст = "ВЫБРАТЬ
				               |	Пользователи.Сотрудник.Ссылка КАК Сотрудник
				               |ИЗ
				               |	Справочник.Пользователи КАК Пользователи
				               |ГДЕ
				               |	Пользователи.Сотрудник.Должность.Ссылка = &Ссылка
				          	   |	И Пользователи.Сотрудник.Подразделение В(&Подразделения)";
				
				Запрос.УстановитьПараметр("Ссылка", Справочники.Должности.Мастер);
				
				Если Отдел = Неопределено Тогда
					
					Отдел = Справочники.CRM_Отделы.НайтиПоНаименованию("Сервис Renault");
					
					Если Отдел = Неопределено Тогда
						
						Отдел = Справочники.CRM_Отделы.ПустаяСсылка();
						
					КонецЕсли;
					
				КонецЕсли;
				
				Запрос.УстановитьПараметр("Подразделения", Отдел.Подразделения.ВыгрузитьКолонку("Подразделение"));
				ВыборкаАдресаты = Запрос.Выполнить().Выбрать();
				Пока ВыборкаАдресаты.Следующий() Цикл
					НоваяСтрока = Напоминание.Адресаты.Добавить();
					НоваяСтрока.Сотрудник = ВыборкаАдресаты.Сотрудник.Ссылка;
				КонецЦикла;
				
				ДатаОтправки = ТекущаяДата();
				
				Напоминание.ИдентификаторОбъекта = ЭтотОбъект.Ссылка.УникальныйИдентификатор();
				
				Напоминание.ДатаОтправки = ДатаОтправки;
				
				Напоминание.Комментарий = Примечание;
				
				Напоминание.Подробнее = Новый ХранилищеЗначения(ЭтотОбъект.Ссылка);
				
				Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.Автосервис_ПовторноеОбращение;
				
				Напоминание.ПоказыватьС = ДатаОтправки;
				Напоминание.ПоказыватьПо = ДатаОтправки;
				
				Если ЭтотОбъект.ВидОбращения <> Справочники.Renault_ВидыОбращенийВАвтосервис.ПлохойРемонт Тогда
				
				Напоминание.Наименование = "Жалоба клиента: " + Клиент;
					
					Если ЗначениеЗаполнено(Примечание) Тогда
						
						Напоминание.Сообщение = "Поступила жалоба! " + " | " + Примечание;
						
					Иначе
						
						Напоминание.Сообщение = "Поступила жалоба!";
						
					КонецЕсли;
					
				Иначе
					
					Напоминание.Наименование = "Повторное обращение клиента: " + Клиент;
					
					Если ЗначениеЗаполнено(Примечание) Тогда
						
						Напоминание.Сообщение = "Плохо проведенный ремонт! " + " | " + Примечание;
						
					Иначе
						
						Напоминание.Сообщение = "Плохо проведенный ремонт!";
						
					КонецЕсли;
					
				КонецЕсли;
				
				Напоминание.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВсеОбязательныеРеквизитыЗаполнены(СообщатьОНезаполнении = Ложь) Экспорт
	МассивОбязательныхРеквизитов = Новый Массив;
	//МассивОбязательныхРеквизитов.Добавить("ИсточникОбращения");
	
	Для Каждого ТекРеквизит Из МассивОбязательныхРеквизитов цикл
		Если Не ЗначениеЗаполнено(ЭтотОбъект[ТекРеквизит]) тогда
			#Если Клиент Тогда	
			Если СообщатьОНезаполнении тогда
				   Предупреждение("Не заполнен реквизит "+ЭтотОбъект.Метаданные().Реквизиты[ТекРеквизит].Синоним);
				   Возврат Ложь;
			КонецЕсли;	
			#КонецЕсли	
		КонецЕсли;	
	КонецЦикла;	
	Возврат Истина;
КонецФункции	

