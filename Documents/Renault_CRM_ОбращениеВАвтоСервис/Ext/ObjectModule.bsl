Процедура ЗакрытьЗадачуПоОбращению() Экспорт
	
	Если НЕ ЭтотОбъект.ЭтоНовый() И ЗначениеЗаполнено(ИдентификаторТрафика) Тогда
		
		Запись = Renault_CRM.ПолучитьЗаписьЗадачиПоIDТрафика(ИдентификаторТрафика);
		
		Если Запись <> Неопределено Тогда
			
			Запись.Обработано = Истина;
			Запись.ДатаВремяЗавершения = ТекущаяДата();
			Запись.КомментарийПриЗакрытии = Строка(ВидОбращения) + Строка(?(Упущено, " " + Строка(ПричинаУпущения), ""));
			Запись.Записать();
			
		КонецЕсли;
		
		Запись = Renault_CRM.ПолучитьЗаписьТрафикаПоID(ИдентификаторТрафика);
		
		Если Запись <> Неопределено Тогда
			
			Запись.Обработан = Истина;
			Запись.Комментарий = Строка(ВидОбращения) + Строка(?(Упущено, " " + Строка(ПричинаУпущения), ""));
			Запись.Записать();
			
			
			Если Упущено Тогда
				
				ЗаписьУпущен = РегистрыСведений.CRM_УпущенныйТрафик.СоздатьМенеджерЗаписи();
				
				ЗаполнитьЗначенияСвойств(ЗаписьУпущен, Запись);
				
				ЗаписьУпущен.ИдентификаторТрафика = Запись.Идентификатор;
				ЗаписьУпущен.ВидУпущения = Перечисления.CRM_ТипыУпущенияТрафика.Менеджер;
				
				ЗаписьУпущен.Записать();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// НАЧАЛО DMSCOR-1082 14.02.2019
Процедура ПередУдалением(Отказ)
	
	СообщениеУдаления = "";
	
	лПриемка = Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту("Обращение", Ссылка);
	лВыдача = Документы.Renault_CRM_ВыдачаАвтомобиля.НайтиПоРеквизиту("Обращение", Ссылка);
	
	Если (ЗначениеЗаполнено(лПриемка) И НЕ лПриемка.ПометкаУдаления) ИЛИ (ЗначениеЗаполнено(лВыдача) И НЕ лВыдача.ПометкаУдаления) Тогда
		
		Если ЕстьЗапланированныеРаботы() Тогда
			СообщениеУдаления = "По обращению есть запланированные приемки/выдачи.";
		Иначе
			СообщениеУдаления = "По обращению есть документы приемки/выдачи.";
		КонецЕсли;
		
		Сообщить(СообщениеУдаления + " Обращение не удалено.");
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьЗапланированныеРаботы()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Renault_АвтосервисПланРабот.ДилерскийЦентр,
	|	Renault_АвтосервисПланРабот.Обращение,
	|	Renault_АвтосервисПланРабот.РабочийДокумент,
	|	Renault_АвтосервисПланРабот.Цех,
	|	Renault_АвтосервисПланРабот.ЭтапРабот,
	|	Renault_АвтосервисПланРабот.Удалить_Авторабота,
	|	Renault_АвтосервисПланРабот.ВремяНачала,
	|	Renault_АвтосервисПланРабот.ВремяОкончания,
	|	Renault_АвтосервисПланРабот.Длительность
	|ИЗ
	|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
	|ГДЕ
	|	Renault_АвтосервисПланРабот.Обращение = &Обращение";
	Запрос.УстановитьПараметр("Обращение", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции
