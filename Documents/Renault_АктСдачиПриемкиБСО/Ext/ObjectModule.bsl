		Для Каждого Строка Из ДвиженияБСОВОрганизации Цикл
			
			Движение = Движения.Renault_БСОВОрганизации.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Организация = Организация;
			Движение.Период = Дата;
			Движение.СтраховаяКомпания = СтраховаяКомпания;
			Движение.ТипБСО    = Строка.ТипБСО;
			Движение.СерияБСО = Строка.СерияБСО;
			Движение.НомерБСО = Строка.НомерБСО;
			Движение.Количество = Строка.Количество;
		
		КонецЦикла;
		
	КонецЕсли;	
	
	Для Каждого Строка Из ДвиженияВключитьВОтчетность Цикл
		
		Движение = Движения.Renault_ПринятыеВОтчетностьБСО.Добавить();
		Движение.Организация = Организация;
		Движение.Период = Дата;
		Движение.СтраховаяКомпания = СтраховаяКомпания;
		Движение.СтраховаяПремияОтКлиента = Строка.СтраховаяПремияОтКлиента;
		Движение.ТипБСО = Строка.ТипБСО;
		Движение.СерияБСО = Строка.СерияБСО;
		Движение.НомерБСО = Строка.НомерБСО;
		Движение.ВидОперации = ВидОперации;
		Движение.Количество = 1;
		
	КонецЦикла;
	
	Для Каждого Строка Из ДвиженияБСОБудущиеПериодыСписать Цикл
		
		Движение = Движения.Renault_БСОБудущиеПериоды.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Организация = Организация;
		Движение.Период = Дата;
		Движение.СтраховаяКомпания = СтраховаяКомпания;
		Движение.СтраховаяПремияОтКлиента = Строка.СтраховаяПремияОтКлиента;
		Движение.ТипБСО = Строка.ТипБСО;
		Движение.СерияБСО = Строка.СерияБСО;
		Движение.НомерБСО = Строка.НомерБСО;
		Движение.ВидОперации = ВидОперации;
		Движение.Количество = Строка.Количество;
		
	КонецЦикла;
	
	
	Запрос.Текст = "ВЫБРАТЬ * ИЗ Вт_БСО_НеВОтчетность КАК Вт_БСО_НеВОтчетность";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Движение = Движения.Renault_БСОБудущиеПериоды.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Организация = Организация;
		Движение.Период = Дата;
		Движение.СтраховаяКомпания = СтраховаяКомпания;
		Движение.СтраховаяПремияОтКлиента = Выборка.СтраховаяПремияОтКлиента;
		Движение.ТипБСО = Выборка.ТипБСО;
		Движение.СерияБСО = Выборка.СерияБСО;
		Движение.НомерБСО = Выборка.НомерБСО;
		Движение.ВидОперации = ВидОперации;
		Движение.Количество = 1;
		
	КонецЦикла;	
	
	Для Каждого Строка Из ДвиженияБезКвитанции Цикл
		
