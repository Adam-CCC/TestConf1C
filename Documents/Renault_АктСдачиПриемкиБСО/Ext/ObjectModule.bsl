		КонецЕсли;	
		
		Если (ВидОперации = Перечисления.Renault_ВидыОперацийАктСдачиПриемкиБСО.Бордеро
			ИЛИ ВидОперации = Перечисления.Renault_ВидыОперацийАктСдачиПриемкиБСО.ВстречноеБордеро 
			ИЛИ ВидОперации = Перечисления.Renault_ВидыОперацийАктСдачиПриемкиБСО.ДВОУ) 
			И Выборка.СтатусБСО <> Перечисления.Renault_СтатусыБСО.Продан Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Выборка.НомерБСО = NULL Тогда
			Продолжить;
		КонецЕсли;	
		
		
		СтрокаБСО = БСО.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаБСО,Выборка);
