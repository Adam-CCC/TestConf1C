		СтрокаБСО.ВключитьВОтчетность = Истина;
		Если ВидОперации = Перечисления.Renault_ВидыОперацийАктСдачиПриемкиБСО.Бордеро ИЛИ ВидОперации = Перечисления.Renault_ВидыОперацийАктСдачиПриемкиБСО.ВстречноеБордеро Тогда
			СтрокаБСО.ВознаграждениеАгентаПроцент = Выборка.КВБордеро - Выборка.ПроцентСкидкиЗасчетКВ;
			СтрокаБСО.ВознаграждениеАгентаСумма = Окр((Выборка.КВБордеро - Выборка.ПроцентСкидкиЗасчетКВ) * Выборка.СтраховаяПремияОтКлиента / 100, 2);
			СтрокаБСО.ПремияСтраховщику = СтрокаБСО.СтраховаяПремияОтКлиента - СтрокаБСО.ВознаграждениеАгентаСумма;
		ИначеЕсли ВидОперации = Перечисления.Renault_ВидыОперацийАктСдачиПриемкиБСО.ДВОУ Тогда
			СтрокаБСО.ВознаграждениеАгентаПроцент = Выборка.КВДВОУ;	
			СтрокаБСО.ВознаграждениеАгентаСумма = Окр(Выборка.КВДВОУ * Выборка.СтраховаяПремияОтКлиента / 100, 2);
			СтрокаБСО.ПремияСтраховщику = СтрокаБСО.СтраховаяПремияОтКлиента - СтрокаБСО.ВознаграждениеАгентаСумма;
		Иначе
			Если НЕ Выборка.НомерПодзапроса = 3 Тогда
				СтрокаБСО.ВознаграждениеАгентаПроцент = Выборка.КВДВОУ + Выборка.КВБордеро - Выборка.ПроцентСкидкиЗасчетКВ;
				СтрокаБСО.ВознаграждениеАгентаСумма = Окр((Выборка.КВДВОУ + Выборка.КВБордеро - Выборка.ПроцентСкидкиЗасчетКВ) * Выборка.СтраховаяПремияОтКлиента / 100, 2);
				СтрокаБСО.ПремияСтраховщику = СтрокаБСО.СтраховаяПремияОтКлиента - СтрокаБСО.ВознаграждениеАгентаСумма;
			КонецЕсли;	
		КонецЕсли;	
		
		СтрокаБСО.СрокСтрахования = "" + Формат(Выборка.ДатаНачалаСтрахования, "ДЛФ=Д") + " - " + Формат(Выборка.ДатаОкончанияСтрахования, "ДЛФ=Д");
		
