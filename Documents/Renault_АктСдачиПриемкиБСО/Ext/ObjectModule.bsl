//Процедура ЗаполнитьТЧ(ВариантЗаполнения) Экспорт
Процедура ЗаполнитьТЧ() Экспорт
	
	Если Проведен Тогда
		Сообщить("Для перезаполнения необходимо отменить проведение документа");
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(БСО) Тогда
		#Если Клиент Тогда
			Ответ = Вопрос("Табличная часть документа будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет,60);
			Если Ответ = КодВозвратаДиалога.Да Тогда 
				БСО.Очистить();
			Иначе 
				Возврат;
			КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтраховаяКомпания) Тогда 
		Сообщить("Заполните реквизит ""Страховая компания""!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация)Тогда
		Сообщить("Заполните реквизит ""Организация""!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПериодС) Тогда 
		Сообщить("Заполните реквизит ""Период с""!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПериодПо) Тогда 
		Сообщить("Заполните реквизит ""Период по""!");
		Возврат;
	КонецЕсли;
	
	Запрос=Новый Запрос(ПолучитьМакет("ЗапросЗаполнения").ПолучитьТекст());
	Запрос.УстановитьПараметр("НачалоПериода", ПериодС);
	Запрос.УстановитьПараметр("КонецПериода", ПериодПо);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СтраховаяКомпания", СтраховаяКомпания);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	
//	Если ВариантЗаполнения = "ЗаполнитьПоПериоду" Тогда ...

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ФормироватьПоВидуСтрахования Тогда
		СписокВидовСтрахования = ВидСтрахования.Получить();
	КонецЕсли;	
			
	Пока Выборка.Следующий()Цикл
		
