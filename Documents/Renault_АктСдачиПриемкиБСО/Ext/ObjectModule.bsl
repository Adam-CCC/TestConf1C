// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ ДОКУМЕНТА

Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь, НепосредственнаяПечать = Ложь) Экспорт
	
	Если  Модифицированность() Тогда 
		Сообщить("Документ необходимо записать!");
		Возврат;
	КонецЕсли;
	
	Если ИмяМакета = "АктСдачиПриемкиБСО" Тогда
		ПечатьАктаСдачиПриемки(ИмяМакета);
	ИначеЕсли ИмяМакета = "МакетОформленныеБСО" ИЛИ ИмяМакета = "МакетОформленныеБСОИнгосстрах" ИЛИ ИмяМакета = "МакетОформленныеБСОРесо" Тогда
		ПечатьБСО(ИмяМакета, Перечисления.Renault_СтатусыБСО.Продан);
	ИначеЕсли ИмяМакета = "МакетИспорченныеБСО" Тогда
		ПечатьБСО(ИмяМакета, Перечисления.Renault_СтатусыБСО.Испорчен);	
	ИначеЕсли ИмяМакета = "МакетЧистыеБСО" Тогда
		ПечатьБСО(ИмяМакета, Перечисления.Renault_СтатусыБСО.Чистый);	
		
	ИначеЕсли ИмяМакета = "АктСдачиПриемкиБСОРесо" Тогда
		ПечатьАктаСдачиПриемкиРесо("АктСдачиПриемкиБСОРесо");
		//ПечатьБСО(ИмяМакета, Перечисления.Renault_СтатусыБСО.Продан);
	
	КонецЕсли;	
	
КонецПроцедуры

