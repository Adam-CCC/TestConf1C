		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.Период = Дата;
		Движение.ВидОперации = ВидОперации;
		
	КонецЦикла;	
	
КонецПроцедуры

// Возвращает доступные варианты печати документа
//
// Возвращаемое значение:
//  Структура, каждая строка которой соответствует одному из вариантов печати
//  
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	СтруктураМакетов = Новый Структура;

	СтруктураМакетов.Вставить("АктСдачиПриемкиБСО", "Бордеро");
	СтруктураМакетов.Вставить("МакетОформленныеБСО", "Оформленные БСО");
	СтруктураМакетов.Вставить("МакетЧистыеБСО", "Чистые БСО");
	СтруктураМакетов.Вставить("МакетИспорченныеБСО", "Испорченные БСО");
	СтруктураМакетов.Вставить("МакетОформленныеБСОИнгосстрах", "Оформленные Ингосстрах");

	СтруктураМакетов.Вставить("АктСдачиПриемкиБСОРесо", "Бордеро Ресо");
	СтруктураМакетов.Вставить("МакетОформленныеБСОРесо", "Оформленные Ресо");

	Возврат СтруктураМакетов;

КонецФункции // ПолучитьСтруктуруПечатныхФорм()

Процедура ПечатьБСО(ИмяМакета, мСтатусБСО)
	
	МассивСтрок = БСО.НайтиСтроки(Новый Структура("СтатусБСО", мСтатусБСО));
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = ПолучитьМакет(ИмяМакета);
	
	Если мСтатусБСО = Перечисления.Renault_СтатусыБСО.Продан Тогда
		ТабДок.ОриентацияСтраницы      = ОриентацияСтраницы.Ландшафт;
	Иначе
		ТабДок.ОриентацияСтраницы      = ОриентацияСтраницы.Портрет;
	КонецЕСли;	
	
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Заголовок = "АКТ № " + Номер;
	Если Найти(Организация.Наименование, "СПб") Тогда
		Область.Параметры.Город = "г. Санкт-Петербург";
	Иначе
		Область.Параметры.Город = "г. Москва";
	КонецЕсли;
	Область.Параметры.Организация = Организация;
	Область.Параметры.Ответственный = Ответственный;
	Область.Параметры.СтраховаяКомпания = СтраховаяКомпания;
	Область.Параметры.Дата = Дата;
	ТабДок.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(Область);
	
	НомерСтроки = 1;
	Итого = 0;
	ИтогоКоличество= 0;
	Для Каждого Строка Из МассивСтрок Цикл
		
		Область = Макет.ПолучитьОбласть("Строка");
		Область.Параметры.Заполнить(Строка);
		Область.Параметры.НомерСтроки = НомерСтроки;
		Если мСтатусБСО = Перечисления.Renault_СтатусыБСО.Продан Тогда
			Область.Параметры.СерияНомерКвитанции = "" + Строка.СерияКвитанции + " " + Строка.НомерКвитанции;
		Иначе
			Область.Параметры.Количество = 1;
		КонецЕсли;	
		
		Если мСтатусБСО = Перечисления.Renault_СтатусыБСО.Продан Тогда
			Итого = Итого + Строка.СтраховаяПремияОтКлиента;
		Иначе	
			ИтогоКоличество = ИтогоКоличество + 1; 
		КонецЕсли;	
		
		НомерСтроки = НомерСтроки + 1;
		
		ТабДок.Вывести(Область);
		
	КонецЦикла;	
	
	Область = Макет.ПолучитьОбласть("Итого");
	Если мСтатусБСО = Перечисления.Renault_СтатусыБСО.Продан Тогда
		Область.Параметры.СтраховаяПремияОтКлиентаИтого = Итого;
	Иначе
		Область.Параметры.ИтогоКоличество = ИтогоКоличество;
	КонецЕсли;	
		
	ТабДок.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("Подвал");
	ТабДок.Вывести(Область);
	
	ТабДок.Показать();	
	
КонецПроцедуры	

