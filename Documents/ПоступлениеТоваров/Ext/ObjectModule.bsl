		|			(ВЫБРАТЬ
		|				ВТ_МаксимальнаяДата.Период КАК Период,
		|				ВТ_МаксимальнаяДата.Номенклатура КАК Номенклатура,
		|				ВТ_МаксимальнаяДата.СкладКомпании КАК СкладКомпании
		|			ИЗ
		|				ВТ_МаксимальнаяДата КАК ВТ_МаксимальнаяДата)
		|	И ВТ_Начало.КоличествоКонечныйОстаток - ВТ_Начало.РезервКонечныйОстаток > 0
		|	И РАЗНОСТЬДАТ(ВТ_Начало.Период, &ТекущаяДата, ДЕНЬ) > 91";    
		
	СписокНомеклатуры = Товары.ВыгрузитьКолонку("Номенклатура");
	
	Запрос.УстановитьПараметр("Номенклатура",СписокНомеклатуры);
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
	Если РезультатЗапроса.Количество() <> 0 Тогда
		
		ТекстСообщения = СтрШаблон("Поступление номер: %1
		|Склад поступления: %2
		|Номенклатуры, по которым есть свободные остатки на других складах
		|без движений более 3x месяцев:",Номер,СкладКомпании); 
		НомерСтроки = 1;   
		
		Для Каждого Строка Из РезультатЗапроса Цикл 
					СтрокаНаВывод = СтрШаблон("<%1> 
			|		<Номенклатура:%2> 
			|		<Количество свободного остатка:%3>
			|		<Дата движения:%4>
			|		<Последний документ движения:%5>",НомерСтроки,Строка.Номенклатура,Строка.СвободныйОстаток,Строка.Период,Строка.Регистратор);
			
			НомерСтроки = НомерСтроки + 1;
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтрокаНаВывод;
		КонецЦикла;           
		мКопии = Новый Массив();
		мКому = Новый Массив;
		мКому.Добавить("sokolov_y@sokolmotors.ru");
		мКому.Добавить("sadchikov_dv@sokolmotors.ru");
		мКому.Добавить("zolotarev_ka@sokolmotors.ru");
		мКому.Добавить("baev_i@sokolmotors.ru");
		мКому.Добавить("ostapovich_ia@sokolmotors.ru");
		г_Функции.СоздатьИОтпраитьЭлПисьмо(мКому, мКопии, "Номенклатура без движения более 3x месяцев", ТекстСообщения, Документы.ЗаказНаряд.ПустаяСсылка());
	КонецЕсли;
	
КонецПроцедуры
