 КонецПроцедуры  //СМГ_ПриЗаписи()
	
Процедура СМГ_СоздатьИлиОбновитьСФПолученный()
	
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
 	КонецЕсли;
 	
	СФ_полученный = Неопределено; 
	
	Если СуммаНДСДокумента > 0 Тогда
		СФ_полученный = Документы.СчетФактураПолученный.СоздатьДокумент(); 
		СФ_полученный.Комментарий = "Автоматически создан "+СокрЛП(ТекущаяДата());
 	КонецЕсли;
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураПолученный.Ссылка КАК СФ,
	|	СчетФактураПолученный.ДокументОснование,
	|	СчетФактураПолученный.Проведен
	|ИЗ
	|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	|ГДЕ
	|	СчетФактураПолученный.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ЭтотОбъект.Ссылка);
     	
	Результат = Запрос.Выполнить();		
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СФ_полученный = ВыборкаДетальныеЗаписи.СФ.ПолучитьОбъект(); 
		Прервать;
	КонецЦикла; 
	
	Если СФ_полученный = Неопределено Тогда
		// Так как "СуммаНДСТовары" равна нулю и старый счет-фактура полученный не найден
		Возврат;
 	КонецЕсли;
	 
	СФ_полученный.Заполнить(ЭтотОбъект.Ссылка);
 	СФ_полученный.Дата = ЭтотОбъект.Дата;

	//Бондаренко++ 20230109
	Попытка
		СФ_полученный.УстановитьНовыйНомер();	
 	Исключение
 	КонецПопытки;
  	//Бондаренко-- 20230109

	СФ_полученный.Комментарий = "Автоматически обновлен "+СокрЛП(ТекущаяДата());
  	
	ФлЭтотОбъектПроведен = ЭтотОбъект.Проведен;
	ФлЭтотОбъектПометкаУдаления = ЭтотОбъект.ПометкаУдаления;
	
	СФ_полученный.Проведен = ФлЭтотОбъектПроведен;			
	СФ_полученный.ПометкаУдаления = ФлЭтотОбъектПометкаУдаления;
	
	Если ФлЭтотОбъектПометкаУдаления Тогда               
		Попытка СФ_полученный.Записать(РежимЗаписиДокумента.Запись); Исключение КонецПопытки; 
	Иначе                                                           
		Если ФлЭтотОбъектПроведен Тогда
			Попытка СФ_полученный.Записать(РежимЗаписиДокумента.Проведение); Исключение КонецПопытки; 					
		Иначе
			Попытка СФ_полученный.Записать(РежимЗаписиДокумента.ОтменаПроведения); Исключение КонецПопытки; 					
		КонецЕсли; 
	КонецЕсли;
 	
КонецПроцедуры //СМГ_СоздатьИлиОбновитьСФПолученный()
