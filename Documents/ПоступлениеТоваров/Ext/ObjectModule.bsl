				|ИЗ
				|	РегистрНакопления.ПартииТоваровКомпании.Обороты(, , Запись, ) КАК ПартииТоваровКомпанииОбороты
				|ГДЕ
				|   ПартииТоваровКомпанииОбороты.КоличествоРасход > 0
				|	И ПартииТоваровКомпанииОбороты.Партия = &Партия";
				
				Запрос.УстановитьПараметр("Партия",Ссылка);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					Если НачалоДня(ЭтотОбъект.Дата) > НачалоДня(ВыборкаДетальныеЗаписи.ДатаРеализации) Тогда
						#Если Клиент Тогда
							СМГ_Сообщить("ОШИБКА! Дата документа <<"+СокрЛП(ЭтотОбъект.Дата)+">>, но он участвовал в движении документа <<"+СокрЛП(ВыборкаДетальныеЗаписи.Реализация)+">> с более ранней датой. Изменение запрещено.",СтатусСообщения.ОченьВажное);
 						#КонецЕсли
 						Отказ = Истина;
						Возврат;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	//Бондаренко-- 20240912
	
	//Бондаренко++ 20230601
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если ВхДокДата = Дата(1,1,1) Тогда
