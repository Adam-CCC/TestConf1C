Процедура СМГ_ОбработкаЗаполненияПоЗаказНаряду(Основание)
	
	Если Основание.Контрагент.НашаФирма Тогда
		
		ПодразделениеКомпании = Основание.ПодразделениеКомпании;		
 		Организация			  = ПодразделениеКомпании.Организация;
		Контрагент            = Основание.Организация.КонтрагентОрганизации;
		
		ВхДокНомер            = Основание.Номер;
		ВхДокДата             = Основание.Дата;
 		
		НовСтрока = Товары.Добавить();
		НовСтрока.Номенклатура      = Справочники.Номенклатура.Авторабота;
		НовСтрока.ЗаказНаряд        = Основание;
		НовСтрока.ЕдиницаИзмерения  = Справочники.Номенклатура.Авторабота.ОсновнаяЕдиницаИзмерения;
		НовСтрока.Количество        = 1;
		НовСтрока.КоличествоБазовое = 1;
		НовСтрока.Коэффициент       = 1;
		НовСтрока.ПартионныйПризнак = Справочники.ПартионныйПризнак.ЗаказОтделаПродаж;
		Если Основание.Работы.Количество() > 0 Тогда
			НовСтрока.СтавкаНДС         = Основание.Работы[0].СтавкаНДС;
		Иначе	
			НовСтрока.СтавкаНДС         = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;			
 		КонецЕсли;
 		НовСтрока.Сумма             = Основание.СуммаДокумента;		
		НовСтрока.СуммаВсего        = НовСтрока.Сумма;
		НовСтрока.СуммаНДС          = ( НовСтрока.СуммаВсего * НовСтрока.СтавкаНДС.Ставка ) / ( 100 + НовСтрока.СтавкаНДС.Ставка );
		НовСтрока.Цена              = НовСтрока.СуммаВсего;
		
 	КонецЕсли; 	

КонецПроцедуры         
