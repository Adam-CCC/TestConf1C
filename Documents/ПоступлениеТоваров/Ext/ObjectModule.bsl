 				ОбработкаРеквизита("Контрагент");
			КонецЕсли;
			
		//Бондаренко++ 20230615	
		ИначеЕсли ТипЗнч(Основание)=Тип("ДокументСсылка.ТСД") Тогда
 			ХозОперация=Справочники.ХозОперации.ПоступлениеТоваров;
