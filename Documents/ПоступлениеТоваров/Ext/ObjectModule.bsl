				Товары.Очистить();
			КонецЕсли;
			СМГ_ОбработкаЗаполненияПоТСД(Основание);
			//Если НЕ обЗначениеНеЗаполнено(Контрагент) Тогда
			//	ОбработкаРеквизита("Контрагент");
			//КонецЕсли;
		//Бондаренко-- 20230615	
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПодразделениеКомпании) Тогда
