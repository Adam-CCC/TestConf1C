	КонецЕсли; 
	//Гэндальф---
КонецПроцедуры // ПриКопировании()

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	//Бондаренко++ 20250312
	Если РежимЗаписи=РежимЗаписиДокумента.ОтменаПроведения Тогда
		ЭтоОптоваяПродажа = Ложь;
		Если Не обЗначениеНеЗаполнено(ДокументОснование) Тогда
			Если ТипЗНЧ(ДокументОснование)=Тип("ДокументСсылка.РеализацияТоваров") Тогда
				Если ДокументОснование.ОптоваяПродажа Тогда
					ЭтоОптоваяПродажа = Истина;
				Иначе						
					Если Не обЗначениеНеЗаполнено(ДокументОснование.ДокументОснование) Тогда
						Если ТипЗНЧ(ДокументОснование.ДокументОснование)=Тип("ДокументСсылка.РеализацияТоваров") Тогда
							Если ДокументОснование.ДокументОснование.ОптоваяПродажа Тогда
								ЭтоОптоваяПродажа = Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если  НЕ ( РольДоступна("ПолныеПрава") ИЛИ РольДоступна("СМ_Бухгалтер") ИЛИ РольДоступна("СМ_АудиторСервиса") ИЛИ (ЭтоОптоваяПродажа И РольДоступна("СМ_МенеджерОтделаЗапасныхЧастейОпт") ) ) Тогда
				#Если НаКлиенте Тогда
					Сообщить("ОШИБКА! Вам запрещено распроводить документ Поступление товаров.",СтатусСообщения.ОченьВажное);
				#КонецЕсли	
				Отказ=Истина; 
				Возврат;
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;	
	//Бондаренко-- 20250312
	
	//Бондаренко++ 20240912
	Если обПраво("ПроверятьПартииПриИзмененииДатыПоступленияТоваров") Тогда
		Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда 
			Если ХозОперация = Справочники.ХозОперации.ПоступлениеТоваров ИЛИ 
