	//Бондаренко-- 20230601
	
	//Бондаренко++ 20220811
	Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если ТипЗнч(ДокументОснование)=Тип("ДокументСсылка.РеализацияТоваров") Тогда		
