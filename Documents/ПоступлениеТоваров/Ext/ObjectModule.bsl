				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПартииТоваровКомпанииОбороты.Период КАК ДатаРеализации,
				|	ПартииТоваровКомпанииОбороты.Партия КАК Поступление,
				|	ПартииТоваровКомпанииОбороты.Партия.Дата КАК ДатаПоступления,
				|	ПартииТоваровКомпанииОбороты.Регистратор КАК Реализация,
