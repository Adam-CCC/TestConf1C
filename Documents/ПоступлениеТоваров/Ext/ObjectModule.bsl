//Бондаренко 20160318 ++
Функция НайтиОрганизациюПоРегиструСведений(ВыбДЦ)

  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкаПродажиТоваровПриБезвозмездномПоступлении.ДилерскийЦентр,
		|	НастройкаПродажиТоваровПриБезвозмездномПоступлении.ОрганизацияПокупатель,
		|	НастройкаПродажиТоваровПриБезвозмездномПоступлении.ПодразделениеОрганизацииПокупателя,
		|	НастройкаПродажиТоваровПриБезвозмездномПоступлении.СкладОрганизацииПокупателя
 		|ИЗ
		|	РегистрСведений.НастройкаПродажиТоваровПриБезвозмездномПоступлении КАК НастройкаПродажиТоваровПриБезвозмездномПоступлении
		|ГДЕ
		|	НастройкаПродажиТоваровПриБезвозмездномПоступлении.ДилерскийЦентр = &ВыбДЦ";

	Запрос.УстановитьПараметр("ВыбДЦ", ВыбДЦ);

	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
   
КонецФункции // НайтиОрганизациюПоФрагментуНаименования()

Функция НайтиКонтраИдоговорПоРегиструСведений(ВыбОрганизация,ВыбКонтрагент)

  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентовПоУмолчанию.КонтрагентДляДоговора,
		|	ДоговорыКонтрагентовПоУмолчанию.Организация,
		|	ДоговорыКонтрагентовПоУмолчанию.ДоговорПоставки
		|ИЗ
		|	РегистрСведений.ДоговорыКонтрагентовПоУмолчанию КАК ДоговорыКонтрагентовПоУмолчанию
		|ГДЕ
		|	ДоговорыКонтрагентовПоУмолчанию.Организация = &ВыбОрганизация
		|	И ДоговорыКонтрагентовПоУмолчанию.КонтрагентДляДоговора = &ВыбКонтрагент";

	Запрос.УстановитьПараметр("ВыбОрганизация", ВыбОрганизация);
	Запрос.УстановитьПараметр("ВыбКонтрагент", ВыбКонтрагент);

	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
   
КонецФункции // НайтиОрганизациюПоФрагментуНаименования()

