// 
////#Область ПрограммныйИнтерфейс

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если Данные.Свойство("Ссылка") И ЗначениеЗаполнено(Данные.Ссылка) Тогда
		СтандартнаяОбработка = Ложь;
		Представление = Данные.Ссылка.Наименование;
	КонецЕсли; 
	
КонецПроцедуры

////#КонецОбласти

////#Область СлужебныеПроцедурыИФункции

////#Область Проведение

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	                      
	////////////////////////////////////////////////////////////////////////////
	// Сформируем текст запроса
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстыЗапроса.Добавить(ТекстЗапросаВтТаблицаРекламныеКампании(), "ТаблицаРекламныеКампании");
	
	DMS_РекламныеКампанииСервер.ИницализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений);
	
КонецПроцедуры                                       

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОтчетПоРекламнойКампании.Дата КАК Период,
		|	ОтчетПоРекламнойКампании.Ссылка КАК Ссылка,
		|	ОтчетПоРекламнойКампании.Представитель КАК Представитель,
		|	ОтчетПоРекламнойКампании.ДилерскийЦентр КАК ДилерскийЦентр,
		|	ОтчетПоРекламнойКампании.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
		|	ОтчетПоРекламнойКампании.Валюта КАК Валюта,
		|	ОтчетПоРекламнойКампании.СуммаДокумента КАК СуммаДокумента,
		|	ОтчетПоРекламнойКампании.ТипКампании КАК ТипКампании,
		|	ОтчетПоРекламнойКампании.РекламнаяКампания КАК РекламнаяКампания
		|ИЗ
		|	Документ.DMS_ОтчетПоРекламнойКампании КАК ОтчетПоРекламнойКампании
		|ГДЕ
		|	ОтчетПоРекламнойКампании.Ссылка = &Ссылка";
	
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Коэффициенты = DMS_РаботаСКурсамиВалют.ПолучитьКоэффициентыПересчетаВалюты(Реквизиты.Валюта, Реквизиты.ВалютаВзаиморасчетов, Реквизиты.Период);
	
	СтруктураПараметров = Новый Структура;
	
	Для А = 0 По Запрос.Выполнить().Колонки.Количество()-1 Цикл
		СтруктураПараметров.Вставить(Запрос.Выполнить().Колонки[А].Имя);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(СтруктураПараметров,Реквизиты);
	
	Для каждого Параметр Из СтруктураПараметров Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ,Параметр.Значение);	
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуУПР",           Коэффициенты.КоэффициентПересчетаВВалютуУПР);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуРегл",          Коэффициенты.КоэффициентПересчетаВВалютуРегл);
	Запрос.УстановитьПараметр("КоэффициентПересчетаВВалютуВзаиморасчетов",Коэффициенты.КоэффициентПересчетаВВалютуВзаиморасчетов);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", 		  Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить());
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета",               Константы.ВалютаУправленческогоУчетаКомпании.Получить());
	
КонецПроцедуры

Функция ТекстЗапросаВтТаблицаРекламныеКампании()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	&Период КАК Период,
		|	&Ссылка КАК Регистратор,
		|	&Представитель КАК Представитель,
		|	&ВалютаВзаиморасчетов КАК Валюта,
		|	&ДилерскийЦентр КАК ДилерскийЦентр,
		|	&ТипКампании КАК ТипКампании,
		|	Модели.Модель КАК Модель,
		|	&РекламнаяКампания КАК РекламнаяКампания,
		|	Модели.СуммаВзаиморасчеты КАК СуммаФакт,
		|	ВЫБОР
		|		КОГДА &ВалютаВзаиморасчетов = &ВалютаРегламентированногоУчета
		|				И &Валюта <> &ВалютаРегламентированногоУчета
		|			ТОГДА Модели.СуммаВзаиморасчеты
		|		ИНАЧЕ ВЫРАЗИТЬ(Модели.Сумма * &КоэффициентПересчетаВВалютуРегл КАК ЧИСЛО(15, 2))
		|	КОНЕЦ КАК СуммаФактРегл,
		|	ВЫБОР
		|		КОГДА &ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
		|			ТОГДА Модели.СуммаВзаиморасчеты
		|		ИНАЧЕ ВЫРАЗИТЬ(Модели.Сумма * &КоэффициентПересчетаВВалютуУпр КАК ЧИСЛО(15, 2))
		|	КОНЕЦ КАК СуммаФактУпр
		|ИЗ
		|	Документ.DMS_ОтчетПоРекламнойКампании.Модели КАК Модели
		|ГДЕ
		|	Модели.Ссылка = &Ссылка
		|	И Модели.Сумма > 0
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
		
		Возврат ТекстЗапроса;
	
КонецФункции // ТекстЗапросаВтТаблицаБрониНомерногоФонда()

////#КонецОбласти

////#КонецОбласти

#КонецЕсли
