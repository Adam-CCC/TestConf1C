Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.Renault_ВызовыТакси.Записывать = Истина;
	Движения.Renault_ВызовыТакси.Очистить();
	
	Движение = Движения.Renault_ВызовыТакси.Добавить();
	Движение.Период = Дата;
	Движение.ДилерскийЦентр = ДилерскийЦентр;
	Движение.Клиент = Клиент;
	Движение.Менеджер = Автор;
	Движение.ОплатаДилерскимЦентром = ОплатаДилерскимЦентром;
	Движение.Стоимость = Стоимость;
	Движение.Количество = 1;
КонецПроцедуры
