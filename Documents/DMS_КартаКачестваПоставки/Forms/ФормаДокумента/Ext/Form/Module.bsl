			НоваяСтрока = ДокументОбъект.ЧекЛистХранения.Добавить();
			НоваяСтрока.Операция = стр.Операция;
			НоваяСтрока.Подробности = стр.Подробности;
			НоваяСтрока.Месяц = Сч;
			НоваяСтрока.Ответственный = стр["Ответственный"+Сч];
			НоваяСтрока.ДатаПлан = стр["ДатаПлан"+Сч];
			НоваяСтрока.ДатаФакт = стр["ДатаФакт"+Сч];
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

