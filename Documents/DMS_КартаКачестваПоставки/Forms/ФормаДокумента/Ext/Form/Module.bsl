&НаКлиенте
Процедура ДефектыКузоваНажатие(Элемент)

	Форма = ПолучитьФорму("Документ.DMS_КартаКачестваПоставки.Форма.ФормаСхемыНесоответствийКузова"); 
	Форма.Объект = ЭтаФорма.Объект.Ссылка;
	Рез = Форма.ОткрытьМодально();
	Если Рез <> Неопределено Тогда
		ЭтаФорма.Объект.ДефектыКузова.Очистить();
		Для Каждого Стр из Рез Цикл
			ЗаполнитьЗначенияСвойств(ЭтаФорма.Объект.ДефектыКузова.Добавить(),Стр);
		КонецЦикла;
		Записать();
	КонецЕсли;
			
КонецПроцедуры

