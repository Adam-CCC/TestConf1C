	сОтвет = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);
	Объект.ТранспортнаяКомпания = сОтвет.Контрагент;
	Объект.ДоговорПеревозчика = сОтвет.Договор;
	Элементы.ГруппаПеревозчики.ТекущаяСтраница = Элементы.ГруппаВводаПеревозчика;
