&НаКлиенте
Процедура ДолгосрочноеХранениеПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ДолгосрочноеХранение.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		
		Месяцы = Новый Массив;
		Месяцы.Добавить(3);
		Месяцы.Добавить(6);
		Месяцы.Добавить(9);
		Месяцы.Добавить(12);
		
		Для каждого НомерМесяца Из Месяцы Цикл
			
			Строки = ВидыОперацийМесяцы.НайтиСтроки(Новый Структура("Операция,Подробности,Месяц",ТекущиеДанные.Операция,ТекущиеДанные.Подробности,НомерМесяца));
			
			РазрешеноРедактировать = Строки.Количество()<>0;
			
			Элементы["ДолгосрочноеХранениеОтветственный"+НомерМесяца].ТолькоПросмотр = Не РазрешеноРедактировать;
			Элементы["ДолгосрочноеХранениеДатаФакт"+НомерМесяца].ТолькоПросмотр = Не РазрешеноРедактировать;
			
			//Если заполнено по старой версии ККП разрешим редактирование DMSCOR-1083
			Если ЗначениеЗаполнено(ТекущиеДанные["ДатаПлан"+НомерМесяца]) Тогда
				Элементы["ДолгосрочноеХранениеОтветственный"+НомерМесяца].ТолькоПросмотр = Ложь;
				Элементы["ДолгосрочноеХранениеДатаФакт"+НомерМесяца].ТолькоПросмотр = Ложь;
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьMADC(VIN, ДатаMADC)
	Если ПустаяСтрока(VIN) Тогда ДатаMADC = Неопределено; Возврат; КонецЕсли;
	
	Запись = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
	Запись.VIN = VIN;
	Запись.Прочитать();
	
	ДатаMADC = ?(Запись.Выбран(),Запись.DATE_MADC,Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ДолгосрочноеХранениеДатаФактПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДолгосрочноеХранение.ТекущиеДанные;
	
	НомерМесяца = Число(СтрЗаменить(Элемент.Имя,"ДолгосрочноеХранениеДатаФакт",""));	
	
	Если НомерМесяца=12 Тогда Возврат; КонецЕсли;
	
	ДатаНачала = Неопределено;
	Для каждого стр Из ДолгосрочноеХранение Цикл
		Если Не ЗначениеЗаполнено(стр["ДатаФакт"+НомерМесяца]) Тогда Продолжить; КонецЕсли;
		Если ДатаНачала=Неопределено Тогда
			ДатаНачала = стр["ДатаФакт"+НомерМесяца];
		Иначе
			ДатаНачала = ?(ДатаНачала>стр["ДатаФакт"+НомерМесяца],стр["ДатаФакт"+НомерМесяца],ДатаНачала);
		КонецЕсли;
	КонецЦикла;
	Если ДатаНачала = Неопределено Тогда ДатаНачала = ТекущиеДанные["ДатаПлан"+НомерМесяца]; КонецЕсли;
	
	ПересчитатьПлановыеДаты_рекурсия(ДатаНачала,НомерМесяца+3);
	
	Если ЭтоСтрокаЗарядкиАКБ(ТекущиеДанные) Тогда
		ЗаполнитьТаблицуАКБ();
		
		СтрокаАКБ = ТаблицаАКБ.НайтиСтроки(Новый Структура("Месяц",НомерМесяца))[0];
	    Элементы.ТаблицаАКБ.ТекущаяСтрока = СтрокаАКБ.ПолучитьИдентификатор();
		Элементы.ТаблицаАКБ.ТекущийЭлемент = Элементы.ТаблицаАКБФактическаяДатаЗарядки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДолгосрочноеХранениеОтветственныйПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДолгосрочноеХранение.ТекущиеДанные;
	НомерМесяца = Число(СтрЗаменить(Элемент.Имя,"ДолгосрочноеХранениеОтветственный",""));
	
	Если ЭтоСтрокаЗарядкиАКБ(ТекущиеДанные) Тогда
		СтрокаАКБ = ТаблицаАКБ.НайтиСтроки(Новый Структура("Месяц",НомерМесяца))[0];
		СтрокаАКБ.Ответственный = ТекущиеДанные["Ответственный"+НомерМесяца];
		
		Элементы.ТаблицаАКБ.ТекущаяСтрока = СтрокаАКБ.ПолучитьИдентификатор();
		Элементы.ТаблицаАКБ.ТекущийЭлемент = Элементы.ТаблицаАКБОтветственный;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьПлановыеДаты_рекурсия(ДатаФактПрошл,НомерМесяца)

	ЕстьФакт = Ложь;
	
	Для каждого стр Из ДолгосрочноеХранение Цикл
		Если ВидыОперацийМесяцы.НайтиСтроки(Новый Структура("Операция,Подробности,Месяц",стр.Операция,стр.Подробности,НомерМесяца)).Количество()=0 Тогда Продолжить; КонецЕсли;
		стр["ДатаПлан"+НомерМесяца] = ДобавитьМесяц(ДатаФактПрошл,3);
		Если ЗначениеЗаполнено(стр["ДатаФакт"+НомерМесяца]) Тогда Естьфакт = Истина; КонецЕсли;
		ДатаПлан = стр["ДатаПлан"+НомерМесяца];
	КонецЦикла;
	
	Если Не ЕстьФакт И НомерМесяца<12 Тогда ПересчитатьПлановыеДаты_рекурсия(ДатаПлан,НомерМесяца+3); КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурнал(Команда)
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда Сообщить("Необходимо сохранить документ"); Возврат; КонецЕсли;
	
	Если Команда.Имя = "ОткрытьЖурналПроверок" Тогда 
		ИмяОткрываемойФормы = "ФормаЖурналПроверкиХраненияНА";
	Иначе 
		ИмяОткрываемойФормы = "ФормаЖурналЗарядкиАКБ"; 
	КонецЕсли;
	Если Объект.ЧекЛистХранения.Количество()=0 Тогда 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Поле = "ДолгосрочноеХранениеЗаполнитьДолгосрочноеХранение";
		Сообщение.Текст = "Необходимо заполнить чек-лист долгосрочного хранения Н/А";
		Сообщение.УстановитьДанные(Объект);
		Сообщение.Сообщить();
		Возврат; 
	КонецЕсли;

	ОткрытьФорму("Документ.DMS_КартаКачестваПоставки.Форма."+ИмяОткрываемойФормы,Новый Структура("ДокументККП",Объект.Ссылка),ЭтаФорма,ЭтаФорма.КлючУникальности);
КонецПроцедуры


&НаСервере
Функция ПолучитьДатуРеализации()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.Дата
	               |ИЗ
	               |	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
	               |ГДЕ
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	               |	И РеализацияАвтомобилейАвтомобили.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.Дата";
	Запрос.УстановитьПараметр("Автомобиль",Объект.Автомобиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка.Дата;
	КонецЕсли;	
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуАКБ()

	ТаблицаАКБ.Очистить();
	
	Операция = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.АккумуляторнаяБатарея;
	Подробности = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.Подробности(Операция);
	Месяцы = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.МесяцыПроверок(Операция,Подробности[0]);
	
	Отбор = Новый Структура("Операция,Подробности", Операция,Подробности[0]);
	Строки = ДолгосрочноеХранение.НайтиСтроки(Отбор);
	
	Если Строки.Количество()=0 Тогда //Проверим Подробности на старый стандарт
        Отбор = Новый Структура("Операция,Подробности", Операция, "Заряжать в течении 6 часов (ATEQ)");
        Строки = ДолгосрочноеХранение.НайтиСтроки(Отбор);
        
        Если Строки.Количество() = 0 Тогда Возврат; КонецЕсли;
    КонецЕсли;
	
	СтрокаХранения = Строки[0];
	
	ДатаРеализации = ПолучитьДатуРеализации();
	
	Для Сч=0 По Месяцы.Количество()-1 Цикл
		НомерМесяца = Месяцы[Сч];
		// DMSREN-260 ++
		Если ДатаРеализации = неопределено или ДатаРеализации> СтрокаХранения["ДатаПлан"+Строка(НомерМесяца)] тогда
		// DMSREN-260 --	
			НоваяСтрока = ТаблицаАКБ.Добавить();
			
			Если НомерМесяца>3 Тогда
				НоваяСтрока.ПредыдущаяДатаЗарядки = СтрокаХранения["ДатаФакт"+Строка(НомерМесяца-3)];
			КонецЕсли;
			НоваяСтрока.ПлановаяДатаСледующейЗарядки = СтрокаХранения["ДатаПлан"+Строка(НомерМесяца)];
			НоваяСтрока.ФактическаяДатаЗарядки = СтрокаХранения["ДатаФакт"+Строка(НомерМесяца)];
			НоваяСтрока.Ответственный = СтрокаХранения["Ответственный"+Строка(НомерМесяца)];
			НоваяСтрока.Месяц = НомерМесяца;
		Иначе СтрокаХранения["ДатаПлан"+Строка(НомерМесяца)] = Дата(1,1,1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаАКБПриИзмененииДанных(Элемент)
	ТекущиеДанные = Элементы.ТаблицаАКБ.ТекущиеДанные;
	
	НомерМесяца = ТекущиеДанные.Месяц;
	
	Операция = ПредопределенноеЗначение("Перечисление.Renault_ВидыОперацийДолгосрочногоХранения.АккумуляторнаяБатарея");
	Подробности = "Заряжать в течении 6 часов (ATEQ)";
	
	СтрокаХранения = ДолгосрочноеХранение.НайтиСтроки(Новый Структура("Операция,Подробности",Операция,Подробности))[0];
	Элементы.ДолгосрочноеХранение.ТекущаяСтрока = СтрокаХранения.ПолучитьИдентификатор();
	
	Если СтрЧислоВхождений(Элемент.Имя,"Ответственный")<>0 Тогда
		СтрокаХранения["Ответственный"+НомерМесяца] = ТекущиеДанные.Ответственный;
		Элементы.ДолгосрочноеХранение.ТекущийЭлемент = Элементы["ДолгосрочноеХранениеОтветственный"+НомерМесяца];
	Иначе
		Элементы.ДолгосрочноеХранение.ТекущийЭлемент = Элементы["ДолгосрочноеХранениеДатаФакт"+НомерМесяца];
		СтрокаХранения["ДатаФакт"+НомерМесяца] = ТекущиеДанные.ФактическаяДатаЗарядки;
		ДолгосрочноеХранениеДатаФактПриИзменении(Элементы["ДолгосрочноеХранениеДатаФакт"+ТекущиеДанные.Месяц]);
		
		СтрокаАКБ = ТаблицаАКБ.НайтиСтроки(Новый Структура("Месяц",НомерМесяца))[0];
		Элементы.ТаблицаАКБ.ТекущаяСтрока = СтрокаАКБ.ПолучитьИдентификатор();
		Элементы.ТаблицаАКБ.ТекущийЭлемент = Элемент;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЭтоСтрокаЗарядкиАКБ(ТекущиеДанные)

	Операция = ПредопределенноеЗначение("Перечисление.Renault_ВидыОперацийДолгосрочногоХранения.АккумуляторнаяБатарея");
	Подробности = "Заряжать в течении 6 часов (ATEQ)";
	НовыеПодробности = "Заряжать ATEQ до полной зарядки (зеленый индикатор горит постоянно, не мигает)";
	
	Возврат ТекущиеДанные.Операция=Операция И (ТекущиеДанные.Подробности=Подробности ИЛИ ТекущиеДанные.Подробности = НовыеПодробности);

КонецФункции


&НаСервере
Процедура ЗаполнитьОпцииПоДоговоруКПНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(Renault_ДоговорСоставДоговора.Ссылка) КАК Ссылка
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
		|ГДЕ
		|	Renault_ДоговорСоставДоговора.VIN = &VIN
		|	И НЕ Renault_ДоговорСоставДоговора.Ссылка.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Ссылка,
		|	Renault_ДоговорДопОпцииАвтомобилей.Опция,
		|	Renault_ДоговорДопОпцииАвтомобилей.Цена,
		|	Renault_ДоговорСоставДоговора.Идентификатор,
		|	Renault_ДоговорСоставДоговора.Автомобиль
		|ИЗ
		|	ВТ КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Договор.ДопОпцииАвтомобилей КАК Renault_ДоговорДопОпцииАвтомобилей
		|			ПО Renault_ДоговорСоставДоговора.Идентификатор = Renault_ДоговорДопОпцииАвтомобилей.Идентификатор
		|				И Renault_ДоговорСоставДоговора.Ссылка = Renault_ДоговорДопОпцииАвтомобилей.Ссылка
		|		ПО ВТ.Ссылка = Renault_ДоговорСоставДоговора.Ссылка
		|			И (Renault_ДоговорСоставДоговора.VIN = &VIN)";
	
	Запрос.УстановитьПараметр("VIN", Объект.VIN);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Объект.Опции.Очистить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.Опции.Добавить(),Выборка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьОпцииПоДоговоруКП(Команда)
	ЗаполнитьОпцииПоДоговоруКПНаСервере();
КонецПроцедуры

// Обновление опций 
&НаКлиенте
Процедура ЗаполнитьОпции(Команда)

	Если Объект.Опции.Количество() > 0 Тогда
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОбновитьОпции", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Обновить опции?", Режим, 0);
	Иначе
		ОбновитьОпцииНаСервере();		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОбновитьОпции(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьОпцииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОпцииНаСервере() 
		
	ТаблицаОпцийАвтомобиля = Renault_CRM.ПолучитьТаблицуОпцийПоВин(Объект.VIN);
	МассивОпцийАвтомобиля = ТаблицаОпцийАвтомобиля.ВыгрузитьКолонку("Опция");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ТарифНаОпцииАвтомобилей.Опция КАК Опция,
	|	Renault_ТарифНаОпцииАвтомобилей.ЦенаКлиентская КАК Цена
	|ИЗ
	|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних(
	|			,
	|			Тариф = &Тариф
	|				И Модель = &Модель
	|				И ВариантКомплектации = &ВариантКомплектации
	|				И Опция В (&МассивОпцийАвтомобиля)) КАК Renault_ТарифНаОпцииАвтомобилей";
		
	Запрос.УстановитьПараметр("МассивОпцийАвтомобиля", МассивОпцийАвтомобиля);		
	Запрос.УстановитьПараметр("Тариф",                 Renault_CRM.ПолучитьПоследнийТарифНаАвтомобиль(Объект.Версия));
	Запрос.УстановитьПараметр("ВариантКомплектации",   Объект.Версия);
	Запрос.УстановитьПараметр("Модель",                Объект.Модель);		
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Объект.Опции.Очистить();
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект.Опции.Добавить();		
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

