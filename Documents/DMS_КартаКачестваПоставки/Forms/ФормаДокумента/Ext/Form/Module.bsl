&НаСервере
Функция ПроверитьICM_Окончание()
	ТаблицаОТС = Renault_АвтосервисСервер.Renault_ОбработатьОТС(Объект.VIN);
	Для Каждого Строка из ТаблицаОТС Цикл
		СправочникСсылка = Справочники.СервисныеКампании.НайтиПоКоду(Строка.НомерОТС);
		
		Если НЕ ЗначениеЗаполнено(СправочникСсылка) Тогда
			Элемент = Справочники.СервисныеКампании.СоздатьЭлемент();
			Элемент.Код = Строка.НомерОТС;
			Элемент.Наименование = Строка.НаименованиеОТС + " (" + Строка.ИндексЦветОТС + ")";
			Элемент.Комментарий = Строка.ОписаниеОТС + Символы.ПС + "Номер технической ноты: " +Строка(Строка.НомерТехническойНоты);
			Элемент.Записать();
			СправочникСсылка = Элемент.Ссылка; 
		КонецЕсли;
		Запись = РегистрыСведений.ВыполнениеСервисныхКампаний.СоздатьМенеджерЗаписи();
		Запись.VIN = Объект.VIN;
		Запись.СервиснаяКампания = СправочникСсылка;
		Запись.Прочитать();
		Если не Запись.Выбран() Тогда
			Запись.Записать();	
		КонецЕсли;
	КонецЦикла;		
КонецФункции	

&НаСервере
Функция ПроверитьICM_Начало()
	
	Ответ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ВыполнениеСервисныхКампаний.ДатаВыполнения) КАК ДатаВыполнения
	               |ИЗ
	               |	РегистрСведений.ВыполнениеСервисныхКампаний КАК ВыполнениеСервисныхКампаний
	               |ГДЕ
	               |	ВыполнениеСервисныхКампаний.VIN = &VIN";
	Запрос.УстановитьПараметр("VIN",Объект.VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Если ЗначениеЗаполнено(Выборка.ДатаВыполнения) Тогда
			Если Выборка.ДатаВыполнения+86400<ТекущаяДата() тогда
				Ответ = Истина;
			КонецЕсли;
		Иначе
			Ответ = Истина;
		КонецЕсли;
		
	Иначе 
		Ответ = Истина;
	КонецЕсли;	
	
	Возврат Ответ;
	
КонецФункции	
	
