Процедура ОбновитьСтрокуХранения(ВидКонтроля)

	Если ВидКонтроля="Приемка" Тогда Отказ = Не Объект.ВыполненПриемкаАвтомобиля;
	ИначеЕсли ВидКонтроля="Выдача" Тогда Отказ = Не Объект.ВыполненТоржественнаяВыдача; КонецЕсли;
		
	Строки = Объект.ПроведениеFlashAves.НайтиСтроки(Новый Структура("ВидКонтроля",ВидКонтроля));
	
	Если Отказ Тогда
		Если Строки.Количество()>0 Тогда Объект.ПроведениеFlashAves.Удалить(Строки[0]); КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Строки.Количество()=0 Тогда
		Строка = Объект.ПроведениеFlashAves.Добавить();
		Строка.ВидКонтроля = ВидКонтроля;
		Строка.Состояние = "NOK";
	Иначе Строка = Строки[0]; КонецЕсли;	
	
	Если ВидКонтроля="Приемка" Тогда
		Строка.Дата = Объект.ДатаПримеки;
		Строка.Сотрудник = Объект.ФИОПримещика;
		Строка.Состояние = ?(Объект.СостАвтоСоотвТребКачестваПримеки,"ОК","NOK");
		Строка.НаличиеОТС = Объект.НаличиеOTS_ПА;
		Строка.ОписаниеОТС = Объект.ОписаниеOTS_ПА;
	ИначеЕсли ВидКонтроля="Выдача" Тогда
		Строка.Дата = Объект.ДатаВыдачиАвто;
		Строка.Сотрудник = Объект.ФИОВыдавшегоАвто;
		Строка.Состояние = ?(Объект.АМСоответствуетВыдаче,"ОК","NOK");
	КонецЕсли;
	
КонецПроцедуры

