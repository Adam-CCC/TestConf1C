&НаКлиенте
Процедура ЗаполнитьПодготовкуКВыдаче(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаMADC) Тогда Сообщить("Не заполнена дата MADC"); Возврат; КонецЕсли;
	////////Если Объект.ЧекЛистВыдача.Количество() > 0 Тогда Сообщить("Таблица уже заполнена"); Возврат; КонецЕсли;
	Объект.ЧекЛистВыдача.Очистить();
	////////
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CRM_ЗаписьНаВыдачу.ДатаНачала
	|ИЗ
	|	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу
	|ГДЕ
	|	CRM_ЗаписьНаВыдачу.VIN = &VIN
	|
	|УПОРЯДОЧИТЬ ПО
	|	CRM_ЗаписьНаВыдачу.Дата УБЫВ";
	Запрос.УстановитьПараметр("VIN", Объект.VIN);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		ДатаПланируемойВыдачи = РезультатЗапроса.ДатаНачала
	Иначе
		Сообщить("Не найдена запланированная выдача");
		Возврат
	КонецЕсли;
	
	//
	Если ДатаПланируемойВыдачи - ТекущаяДата() < 72 * 3600 Тогда
		ДатаПлан = ТекущаяДата()
	Иначе
		ДатаПлан = ДатаПланируемойВыдачи - 72 * 3600
	КонецЕсли; 
	
	Стр = Объект.ЧекЛистВыдача.Добавить();
	Стр.Операция = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.ДавлениеВШинах;
	Стр.Подробности = "При необходимости отрегулировать давление в соответствии с моделью";
	Стр.ДатаПлан = ДатаПлан;
	
	Стр = Объект.ЧекЛистВыдача.Добавить();
	Стр.Операция = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.АккумуляторнаяБатарея;
	Стр.Подробности = "Зарядить 30 мин ATEQ. Если на а/м сообщение о необходимости заряда АКБ, заряжать ATEQ до полной зарядки (зеленый индикатор горит постоянно, не мигает)";
	Стр.ДатаПлан = ДатаПлан;
	
	//Если автомобилю больше года, тогда замена аккумулятора
	Если ДобавитьМесяц(ДатаMADC, 12) < ДатаПланируемойВыдачи Тогда
		Стр = Объект.ЧекЛистВыдача.Добавить();
		Стр.Операция = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.АккумуляторнаяБатарея;
		Стр.Подробности = "Замена, если выдаваемый автомобиль > 12 мес от MADC";
	КонецЕсли;
	
	Стр = Объект.ЧекЛистВыдача.Добавить();
	Стр.Операция = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.СистемаВентиляции;
	Стр.Подробности = "Проверить, что отключен режим рециркуляции воздуха в салоне";
	Стр.ДатаПлан = ДатаПлан;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьICM(Команда)
	ПроверитьICMНаСервере("НаличиеOTS_ПА","ОписаниеOTS_ПА");
КонецПроцедуры

&НаСервере
Процедура ПроверитьICMНаСервере(НаличиеOTS,ОписаниеOTS)
	ТаблицаОТС = Renault_АвтосервисСервер.Renault_ОбработатьОТС(Объект.VIN);	
	СправочникСсылка = Неопределено;
	Если ТаблицаОТС.Количество()>0 тогда
		Для Каждого Строка из ТаблицаОТС Цикл
			СправочникСсылка = Справочники.СервисныеКампании.НайтиПоКоду(Строка.НомерОТС);
			
			Если НЕ ЗначениеЗаполнено(СправочникСсылка) Тогда
				Элемент = Справочники.СервисныеКампании.СоздатьЭлемент();
				Элемент.Код = Строка.НомерОТС;
				Элемент.Наименование = Строка.НаименованиеОТС + " (" + Строка.ИндексЦветОТС + ")";
				Элемент.Комментарий = Строка.ОписаниеОТС + Символы.ПС + "Номер технической ноты: " +Строка(Строка.НомерТехническойНоты);
				Элемент.Записать();
				СправочникСсылка = Элемент.Ссылка; 
			КонецЕсли;
			Запись = РегистрыСведений.ВыполнениеСервисныхКампаний.СоздатьМенеджерЗаписи();
			Запись.VIN = Объект.VIN;
			Запись.СервиснаяКампания = СправочникСсылка;
			Запись.Прочитать();
			Если не Запись.Выбран() Тогда
				Запись.Записать();	
			КонецЕсли;
			Renault_АвтосервисСервер.ЗарегистрироватьПроверкуICMВЖурнале(Объект.VIN,НаличиеOTS,СправочникСсылка);
		КонецЦикла;
	Иначе
		
		Renault_АвтосервисСервер.ЗарегистрироватьПроверкуICMВЖурнале(Объект.VIN,НаличиеOTS,СправочникСсылка);
	КонецЕсли;
	ОбновитьДатуICM(НаличиеOTS,ОписаниеOTS);
	
	РезультатПроверки = Renault_АвтосервисСервер.ПолучитьРезультатПоследнейПроверкиICM(Объект.VIN);
	Если РезультатПроверки.РезультатЗапроса = неопределено тогда
		Возврат;
	КонецЕСли;	
	
	Если РезультатПроверки.РезультатЗапроса = "Есть отзывные компании" тогда
		Сообщить(РезультатПроверки.ОписаниеOTS);
	Иначе
		Сообщить(РезультатПроверки.РезультатЗапроса);
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьДатуICM(НаличиеOTS,ОписаниеOTS)
	Запрос = Новый Запрос;
	ЗАпрос.Текст = "ВЫБРАТЬ
	|	ВыполнениеСервисныхКампаний.ДатаВыполнения,
	|	ВыполнениеСервисныхКампаний.СервиснаяКампания.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.ВыполнениеСервисныхКампаний КАК ВыполнениеСервисныхКампаний
	|ГДЕ
	|	ВыполнениеСервисныхКампаний.VIN = &VIN";
	Запрос.УстановитьПараметр("VIN",Объект.VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Объект[НаличиеOTS] = Истина;
		Объект[ОписаниеOTS] = Выборка.Комментарий;
	КонецЕСли;	
КонецПроцедуры	

