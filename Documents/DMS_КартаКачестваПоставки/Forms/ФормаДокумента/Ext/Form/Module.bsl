&НаСервере
Процедура ОбновитьОпцииДилераНаСервере() 
						
	НастройкиБазы = Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование];
	
	Запрос = Новый Запрос;	
	Если  НастройкиБазы.ИспользоватьТиповойУчетДО Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	КомплектацияАвтомобилейОстаткиИОбороты.Автомобиль,
		|	КомплектацияАвтомобилейОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	СУММА(КомплектацияАвтомобилейОстаткиИОбороты.СуммаПродажиПриход) КАК Сумма,
		|	СУММА(КомплектацияАвтомобилейОстаткиИОбороты.КоличествоПриход) КАК Количество
		|ИЗ
		|	РегистрНакопления.КомплектацияАвтомобилей.ОстаткиИОбороты(, , Регистратор, , Автомобиль = &Автомобиль) КАК КомплектацияАвтомобилейОстаткиИОбороты
		|ГДЕ
		|	КомплектацияАвтомобилейОстаткиИОбороты.Регистратор ССЫЛКА Документ.ЗаказНаряд
		|
		|СГРУППИРОВАТЬ ПО
		|	КомплектацияАвтомобилейОстаткиИОбороты.Автомобиль,
		|	КомплектацияАвтомобилейОстаткиИОбороты.Номенклатура";
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.Автомобиль,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.Оборудование КАК Номенклатура,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.СтоимостьОстаток КАК Сумма,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.СебестоимостьОстаток,
		|	Renault_УстановленноеОборудованиеАвтомобилейОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.Renault_УстановленноеОборудованиеАвтомобилей.Остатки(, Автомобиль = &Автомобиль) КАК Renault_УстановленноеОборудованиеАвтомобилейОстатки";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Автомобиль", Объект.Автомобиль);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Объект.Аксессуары.Очистить();
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Объект.Аксессуары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Цена = Окр(Выборка.Сумма/Выборка.Количество, 2);	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

