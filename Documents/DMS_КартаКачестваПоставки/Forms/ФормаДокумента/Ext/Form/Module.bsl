&НаСервере
Процедура СохранитьТаблицуДолгосрочногоХранения(ДокументОбъект)
	ДокументОбъект.ЧекЛистХранения.Очистить();
	
	ТЗ = РеквизитФормыВЗначение("ДолгосрочноеХранение");
	Мс = Новый Массив;
	Для каждого Колонка Из ТЗ.Колонки Цикл
		Если СтрЧислоВхождений(Колонка.Имя,"Ответственный")<>0 Тогда Мс.Добавить(Число(СтрЗаменить(Колонка.Имя,"Ответственный",""))); КонецЕсли;
	КонецЦикла;
	Для каждого стр Из ДолгосрочноеХранение Цикл
		Для каждого Сч Из Мс Цикл
			
			//Если заполнено по старой версии ККП запишем данные DMSCOR-1140
			Если Не ЗначениеЗаполнено(Стр["ДатаПлан"+Сч]) Тогда
				Продолжить
			КонецЕсли; 
			//Строки = ВидыОперацийМесяцы.НайтиСтроки(Новый Структура("Операция,Подробности,Месяц",стр.Операция,стр.Подробности,Сч));
