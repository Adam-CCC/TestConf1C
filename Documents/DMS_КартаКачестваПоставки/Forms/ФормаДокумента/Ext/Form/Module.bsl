&НаКлиенте
Процедура ЗаполнитьСмету(Команда)
	Форма = ПолучитьФорму("Документ.DMS_КартаКачестваПоставки.Форма.ФормаСмета");
	ДанныеФормы = Форма.Объект;
	КопироватьДанныеФормы(Объект, ДанныеФормы);
	если Элементы.ПриемкаАвтомобиля.ТолькоПросмотр Тогда
		Форма.Доступность = ложь;
	КонецЕсли;
