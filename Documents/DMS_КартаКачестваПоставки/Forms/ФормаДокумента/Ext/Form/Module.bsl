&НаСервере
Процедура ЗаполнитьДанныеПоАвтомобилюНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Автомобиль) Тогда
		ЭтаФорма.Объект.VIN = ЭтаФорма.Объект.Автомобиль.VIN;
		ЭтаФорма.Объект.Цвет = ЭтаФорма.Объект.Автомобиль.Цвет;
		ЭтаФорма.Объект.Версия = ЭтаФорма.Объект.Автомобиль.ВариантКомплектации;
		ЭтаФорма.Объект.Модель = ЭтаФорма.Объект.Автомобиль.Модель;
		
		Запись=РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
		Запись.VIN=Объект.Автомобиль.VIN;
		Запись.Прочитать();
		Объект.КодМагнитолы=Запись.CODE_RADIO;
	КонецЕсли;
	
	ОбновитьMADC(Объект.VIN, ДатаMADC);
	
КонецПроцедуры

