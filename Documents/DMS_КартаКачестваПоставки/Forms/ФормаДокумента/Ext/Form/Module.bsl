&НаКлиенте
Процедура Печать(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Документ не записан");
		Возврат;
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент;
	Документы.DMS_КартаКачестваПоставки.Печать(ТабДок, Объект.Ссылка); 
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Защита = Ложь;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	
	//КлючУникальности = Новый УникальныйИдентификатор();
    ФормаПечати = ПолучитьОбщуюФорму("ПечатнаяФормаДокументов",,Новый УникальныйИдентификатор());
    ТабличныйДокумент = ФормаПечати.ЭлементыФормы.ТабличныйДокумент;
    ТабличныйДокумент.ИмяПараметровПечати = "ПечатьККП";
    ТабличныйДокумент.Вывести(ТабДок);
    ЗаполнитьЗначенияСвойств(ТабличныйДокумент,ТабДок,"ПолеСверху,ПолеСнизу,ПолеСлева,ПолеСправа,Автомасштаб,ОриентацияСтраницы");
	
	ФормаПечати.ИзменятьСпособОтображенияОкна = ИзменениеСпособаОтображенияОкна.Разрешить;
    ФормаПечати.Объект = Объект.Ссылка;
    ФормаПечати.ОбъектПредставление = Строка(Объект.Ссылка);
    ФормаПечати.Открыть();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Если Параметры.Свойство("Автомобиль") Тогда  //Создание из 
			Объект.Автомобиль					= Параметры.Автомобиль;
			Объект.КоммерческийАдминистратор 	= ПараметрыСеанса.Пользователь.Сотрудник;
			МенеджерВДоговоре 					= ПолучитьМенеджераИЗДоговора(Параметры.Автомобиль);
			Объект.Менеджер 					= ?(ЗначениеЗаполнено(МенеджерВДоговоре), МенеджерВДоговоре, ПараметрыСеанса.Пользователь.Сотрудник);
			Объект.Автосалон 					= Renault_CRM.ПолучитьДилерскийЦентрПользователя(Объект.Менеджер);
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Renault_ДоговорСоставДоговора.Ссылка
			|ИЗ
			|	Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
			|ГДЕ
			|	Renault_ДоговорСоставДоговора.Автомобиль = &Автомобиль
			|
			|УПОРЯДОЧИТЬ ПО
			|	Renault_ДоговорСоставДоговора.Ссылка.Дата УБЫВ";
			
			Запрос.УстановитьПараметр("Автомобиль", Объект.Автомобиль);
			ВыборкаДоговоры = Запрос.Выполнить().Выбрать();
			Если ВыборкаДоговоры.Следующий() Тогда
				ДоговорКП = ВыборкаДоговоры.Ссылка;
				Объект.ДоговорКП = ДоговорКП;
				Объект.РабочийЛист= ДоговорКП.РабочийЛист;
				Объект.Клиент 	= ДоговорКП.КлиентДоговора;
			КонецЕсли;;
		КонецЕсли;	
		
		Если Параметры.Свойство("ЗаписьНаВыдачу") Тогда
			Объект.Автосалон 					= Параметры.ЗаписьНаВыдачу.ДилерскийЦентр;	
			Объект.Клиент 						= Параметры.ЗаписьНаВыдачу.Клиент;
			Объект.ДоговорКП 					= Параметры.ЗаписьНаВыдачу.ДоговорНаПродажуАвтомобиля;
			Объект.РабочийЛист 					= Параметры.ЗаписьНаВыдачу.IDK;
			
			СтрСостава = Параметры.ЗаписьНаВыдачу.ДоговорНаПродажуАвтомобиля.СоставДоговора.Найти(Параметры.Автомобиль,"Автомобиль");
			Если СтрСостава <> Неопределено Тогда
				ДопОпции = Параметры.ЗаписьНаВыдачу.ДоговорНаПродажуАвтомобиля.ДопОпцииАвтомобилей.НайтиСтроки(Новый Структура("Идентификатор",СтрСостава.Идентификатор));	
				Для каждого Стр из ДопОпции Цикл
					ЗаполнитьЗначенияСвойств(Объект.Опции.Добавить(),Стр);
				КонецЦикла;                                               				
			КонецЕсли;
		КонецЕсли;
		
		Если Параметры.Свойство("ТаблицаОпций") И Объект.Опции.Количество() = 0 Тогда		
			Для каждого Стр из Параметры.ТаблицаОпций Цикл
				НовСтр = Объект.Опции.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,Стр);
				НовСтр.Цена = Стр.Сумма;
			КонецЦикла; 
		КонецЕсли;

		Если Параметры.Свойство("ТаблицаОпцийДилера") И Объект.Аксессуары.Количество() = 0 Тогда		
			Для каждого Стр из Параметры.ТаблицаОпцийДилера Цикл
				НовАкс = Объект.Аксессуары.Добавить();
				НовАкс.Номенклатура = Стр.Опция;
				НовАкс.Количество = Стр.Количество;
				НовАкс.Цена = Окр(Стр.Сумма/Стр.Количество,2);	
				НовАкс.Сумма = Стр.Сумма;
			КонецЦикла; 
		КонецЕсли;

		Если Параметры.Свойство("Договор") Тогда
			Объект.Автосалон 					= Параметры.Договор.ДилерскийЦентр;	
			Объект.Клиент 						= Параметры.Договор.КлиентДоговора;
			Объект.ДоговорКП 					= Параметры.Договор;
			Объект.РабочийЛист 					= Параметры.Договор.РабочийЛист;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.СтатусPVR) Тогда
			Объект.СтатусPVR = Перечисления.Renault_СтатусыPVR.Создан;
			Объект.ДатаСтатуса = ТекущаяДата();
		КонецЕсли;
	Иначе
		Если Параметры.Свойство("ТекущаяСтраница") Тогда		
			Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницыФормы.ПодчиненныеЭлементы[Параметры.ТекущаяСтраница];
		КонецЕсли;		
	КонецЕсли;
	Если Параметры.Свойство("Поступление") Тогда
		Поступление = Параметры.Поступление;
	КонецЕсли;
	Если Объект.СтатусPVR = Перечисления.Renault_СтатусыPVR.ОжидаетПроверки Тогда
		Элементы.ПриемкаАвтомобиля.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ЗаполнитьТаблицуДолгосрочногоХранения();
	ЗаполнитьВидыОперацийМесяцы();
	ОбновитьMADC(Объект.VIN, ДатаMADC);
	
	ЗаполнитьПричиныНеВыдачи ();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПричиныНеВыдачи ()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПричиныНеВыдачи.Ссылка
	|ИЗ
	|	Справочник.Renault_ПричиныНеВыдачи КАК Renault_ПричиныНеВыдачи
	|ГДЕ
	|	Renault_ПричиныНеВыдачи.Активный = ИСТИНА";
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы.ОтказВвыдаче.СписокВыбора.Очистить();

	Пока Выборка.Следующий() Цикл
		Элементы.ОтказВвыдаче.СписокВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

