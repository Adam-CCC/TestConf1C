&НаСервере
Процедура ПриЗакрытииНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ИсторияСтатусовPVRСрезПоследних.Статус
	|ИЗ
	|	РегистрСведений.Renault_ИсторияСтатусовPVR.СрезПоследних КАК Renault_ИсторияСтатусовPVRСрезПоследних
	|ГДЕ
	|	Renault_ИсторияСтатусовPVRСрезПоследних.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Мендеджер = РегистрыСведений.Renault_ИсторияСтатусовPVR.СоздатьМенеджерЗаписи();
		Мендеджер.Период = ТекущаяДата();
		Мендеджер.Объект = Объект.Ссылка;
		Мендеджер.Статус = Объект.СтатусPVR;
		Мендеджер.Записать();
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Если Выборка.Статус <> Объект.СтатусPVR Тогда
		Мендеджер = РегистрыСведений.Renault_ИсторияСтатусовPVR.СоздатьМенеджерЗаписи();
		Мендеджер.Период = ТекущаяДата();
		Мендеджер.Объект = Объект.Ссылка;
		Мендеджер.Статус = Объект.СтатусPVR;
		Мендеджер.Записать();
	КонецЕсли;
	Если Объект.ДокументыPVRОтправлены и Выборка.Статус <> Перечисления.Renault_СтатусыPVR.ОжидаетПроверки Тогда
		ПланОбмена = ПолучитьПланОбмена();
		ПланыОбмена.ЗарегистрироватьИзменения(ПланОбмена, Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПланОбмена ()
	ВыбораПланаОбмена = ПланыОбмена.Renault_PVR.Выбрать();
	ЭтаБаза = ПланыОбмена.Renault_PVR.ЭтотУзел();
	ПланОбмена = ПланыОбмена.Renault_PVR.ПустаяСсылка();
	Пока ВыбораПланаОбмена.Следующий() цикл
		Если ВыбораПланаОбмена.Ссылка <> ЭтаБаза Тогда
			ПланОбмена = ВыбораПланаОбмена.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат ПланОбмена;
КонецФункции

&НаКлиенте
Процедура ПроведениеFlashAvesПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.ПроведениеFlashAves.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.Дата = ТекущаяДата();
		ТекущиеДанные.Сотрудник = СотрудникТекущегоПользователя();
		ТекущиеДанные.Состояние = "NOK";
