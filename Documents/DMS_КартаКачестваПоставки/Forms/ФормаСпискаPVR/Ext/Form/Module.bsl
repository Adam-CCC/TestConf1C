КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		ФормаПоступления = ВыбраннаяСтрока.Ключ.ПолучитьФорму();
		ФормаПоступления.Открыть();
	Иначе
		сПараметры = Новый Структура;
		сПараметры.Вставить("Ключ", ВыбраннаяСтрока);
		сПараметры.Вставить("Поступление", Элемент.ТекущиеДанные.РодительскаяГруппировкаСтроки.Ключ);
		ОткрытьФорму("Документ.DMS_КартаКачестваПоставки.ФормаОбъекта", сПараметры);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОтправитьНаПроверкуНаСервере()
	Если ТипЗнч(Элементы.Список.ТекущаяСтрока)<> Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		ДокОбъект = Элементы.Список.ТекущаяСтрока.ПолучитьОбъект();
		ДокОбъект.СтатусPVR = Перечисления.Renault_СтатусыPVR.ОжидаетПроверки;
		ДокОбъект.ДокументыPVRОтправлены = Истина;
		ДокОбъект.Записать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьНаПроверку(Команда)
	ОтправитьНаПроверкуНаСервере();
	Элементы.Список.Обновить();
КонецПроцедуры
