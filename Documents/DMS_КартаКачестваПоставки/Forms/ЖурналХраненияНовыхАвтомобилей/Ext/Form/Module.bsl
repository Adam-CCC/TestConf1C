
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Список.Параметры.УстановитьЗначениеПараметра("ТекущаяДата",НачалоДня(ТекущаяДата()));
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОткрытьЗначение(Элементы.Список.ТекущиеДанные.ДокументККП);
КонецПроцедуры



&НаСервере
Функция ПолучитьБыстрыйФильтрНаСервере()
	// Вставить содержимое обработчика.
	сз1 = Новый СписокЗначений;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_ВидыОперацийДолгосрочногоХранения.Ссылка
	               |ИЗ
	               |	Перечисление.Renault_ВидыОперацийДолгосрочногоХранения КАК Renault_ВидыОперацийДолгосрочногоХранения";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		сз1.Добавить(Выборка.ссылка, Строка(Выборка.ссылка));
	КонецЦикла;
	Возврат сз1;
КонецФункции

&НаКлиенте
Процедура ОткрытьБыстрыйФильтр(Команда)
	
	сз1 = ПолучитьБыстрыйФильтрНаСервере();
	сз1.ЗаполнитьПометки(Истина);
	//сз1.ОтметитьЭлементы("Выберите значения для фильтра:");
	 ОповещениеПослеОтметкиЭлементов = Новый ОписаниеОповещения(
        "ПослеОтметкиЭлементов", ЭтаФорма
    );	
 
    сз1.ПоказатьОтметкуЭлементов(
        ОповещениеПослеОтметкиЭлементов,
        "Выберите значения для фильтра:"
    );
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиЭлементов(Элементы, Параметры) Экспорт
 
	Если Элементы <> Неопределено Тогда
		списокОтбора = Новый СписокЗначений;
		
        Для Каждого опер1 Из Элементы Цикл
            Если опер1.Пометка Тогда
                //Сообщить(опер1.Значение);
				списокОтбора.Добавить(опер1.Значение);
            КонецЕсли;
		КонецЦикла;
		
			
		Для каждого эл из Список.Отбор.Элементы Цикл
			Если Строка(эл.ЛевоеЗначение) = "Операция" Тогда
				список.отбор.элементы.Удалить(эл);
			КонецЕсли;
		КонецЦикла;
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Операция");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ПравоеЗначение = списокОтбора;
		
    КонецЕсли;
 
КонецПроцедуры

