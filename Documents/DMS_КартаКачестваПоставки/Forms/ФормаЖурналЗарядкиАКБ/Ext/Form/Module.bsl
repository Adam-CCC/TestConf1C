
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицу(Параметры.ДокументККП, Отказ);
КонецПроцедуры


&НаСервере
Функция ПолучитьДатуРеализации(ДокументККП)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.Дата
	               |ИЗ
	               |	Документ.РеализацияАвтомобилей.Автомобили КАК РеализацияАвтомобилейАвтомобили
	               |ГДЕ
	               |	РеализацияАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	               |	И РеализацияАвтомобилейАвтомобили.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияАвтомобилейАвтомобили.Ссылка.Дата";
	Запрос.УстановитьПараметр("Автомобиль",ДокументККП.Автомобиль);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка.Дата;
	КонецЕсли;	
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицу(ДокументККП, Отказ)
	
	Если ДокументККП.ЧекЛистХранения.Количество()=0 Тогда Возврат; КонецЕсли;
	Операция = ПредопределенноеЗначение("Перечисление.Renault_ВидыОперацийДолгосрочногоХранения.АккумуляторнаяБатарея");
	Подробности = "Заряжать в течении 6 часов (ATEQ)";
	
	МесяцыПодзарядки = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.МесяцыПроверок(Операция,"Заряжать ATEQ до полной зарядки (зеленый индикатор горит постоянно, не мигает)");
	//МесяцыПодзарядки = Перечисления.Renault_ВидыОперацийДолгосрочногоХранения.МесяцыПроверок(Операция,Подробности);
	
	Отбор = Новый Структура("Операция, Подробности",Операция,Подробности);
	Строки = ДокументККП.ЧекЛистХранения.НайтиСтроки(Отбор);
	СтрокиХранения = ДокументККП.ЧекЛистХранения.Выгрузить(Строки);
	
	// НАЧАЛО DMSREN-393 26.12.2019 
	Если СтрокиХранения.Количество() = 0 Тогда
		Сообщить("Нет операции ""Аккумуляторная батарея"" с подробностью ""Заряжать в течении 6 часов (ATEQ)""");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	// КОНЕЦ DMSREN-393 26.12.2019
	
	// Дата производства А/М
	Запись = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
	Запись.VIN = ДокументККП.VIN;
	Запись.Прочитать();
	MADC = ?(Запись.Выбран(),Запись.DATE_MADC,Дата("00010101"));
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.Автомобиль = ДокументККП.Автомобиль;
	НоваяСтрока.MADC = MADC;
	НоваяСтрока.БудущаяПодзарядка = СтрокиХранения.Найти(МесяцыПодзарядки[0],"Месяц").ДатаПлан;
	
	ДатаРеализации = ПолучитьДатуРеализации(ДокументККП);

	Для Сч=0 По МесяцыПодзарядки.Количество()-1 Цикл
		
		// DMSREN-260 ++
		Если ДатаРеализации = неопределено или ДатаРеализации > СтрокиХранения.Найти(МесяцыПодзарядки[Сч+1],"Месяц").ДатаПлан тогда
			// DMSREN-260 --	
			
			НоваяСтрока = ТаблицаДанных.Добавить();
			НоваяСтрока.Автомобиль = ДокументККП.Автомобиль;
			НоваяСтрока.MADC = MADC;
			
			НоваяСтрока.ПрошлаяПодзарядка = СтрокиХранения.Найти(МесяцыПодзарядки[Сч],"Месяц").ДатаФакт;
			Если Сч<>МесяцыПодзарядки.Количество()-1 Тогда
				НоваяСтрока.БудущаяПодзарядка = СтрокиХранения.Найти(МесяцыПодзарядки[Сч+1],"Месяц").ДатаПлан;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(НоваяСтрока.ПрошлаяПодзарядка) И Не ЗначениеЗаполнено(НоваяСтрока.БудущаяПодзарядка) Тогда
				ТаблицаДанных.Удалить(НоваяСтрока);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

