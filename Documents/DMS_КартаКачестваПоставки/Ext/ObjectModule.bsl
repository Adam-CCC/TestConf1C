Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Клиент) И ЗначениеЗаполнено(VIN) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(Renault_ДоговорСоставДоговора.Ссылка) КАК Ссылка
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
		|ГДЕ
		|	Renault_ДоговорСоставДоговора.VIN = &VIN
		|	И НЕ Renault_ДоговорСоставДоговора.Ссылка.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Ссылка.Клиент КАК Клиент
		|ИЗ
		|	ВТ КАК ВТ";
		
		Запрос.УстановитьПараметр("VIN", VIN);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Клиент = ВыборкаДетальныеЗаписи.Клиент;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИДСинхронизации) Тогда
		ИДСинхронизации = Строка(Ссылка.УникальныйИдентификатор());
	КонецЕсли;
КонецПроцедуры
