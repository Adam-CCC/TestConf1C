Процедура Печать(ТабДок,Ссылка) Экспорт
	
	Макет = ПолучитьМакет("КартаКачестваПоставки");
	ДанныеДокумента = ПолучитьДанныеОбъекта(Ссылка);
	
	ОбластьСтраница = Макет.ПолучитьОбласть("Страница");
	ТабДок.Очистить();
	ОбластьСтраница.Параметры.Заполнить(ДанныеДокумента);
	ОбластьСтраница.Параметры.ДатаMADC = Формат(ДанныеДокумента.ДатаMADC, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.ДатаВыдачиАвто = Формат(ДанныеДокумента.ДатаВыдачиАвто, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.ДатаКонтроляАмПослеРемонта = Формат(ДанныеДокумента.ДатаКонтроляАмПослеРемонта, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.ДатаПППодготовки = Формат(ДанныеДокумента.ДатаПППодготовки, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.ДатаПримеки = Формат(ДанныеДокумента.ДатаПримеки, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.СогласованнаяДатаВыдачи = Формат(ДанныеДокумента.СогласованнаяДатаВыдачи, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.СогласованнаяДатаПоставки = Формат(ДанныеДокумента.СогласованнаяДатаПоставки, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.ПланируемаяДатаПредпродажнойПодготовки = Формат(ДанныеДокумента.ПланируемаяДатаПредпродажнойПодготовки, "ДФ=dd.MM.yyyy");
	ОбластьСтраница.Параметры.ПланируемаяДатаУстановкиАксессуаров = Формат(ДанныеДокумента.ПланируемаяДатаУстановкиАксессуаров, "ДФ=dd.MM.yyyy");
	
	КартинкаЛого = Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().Логотип_mini_4);
	//ОбластьСтраница.Рисунки["D1"].Картинка = КартинкаЛого;
	
	Для сч = 1 по 17 Цикл
		ОбластьСтраница.Параметры["V"+Строка(СЧ)] = Сред(ДанныеДокумента.VIN,Сч,1);
	КонецЦикла;
	Для сч = 1 по 4 Цикл
		ОбластьСтраница.Параметры["K"+Строка(СЧ)] = Сред(ДанныеДокумента.КодМагнитолы,Сч,1);
	КонецЦикла;
	//Для сч = 1 по 8 Цикл
	//	ОбластьСтраница.Параметры["А"+Строка(СЧ)] = Сред(ДанныеДокумента.КодСостоянияАКБ,Сч,1);
	//КонецЦикла;
	
	Если ДанныеДокумента.АмНаСвобСкладе Тогда
		ОбластьСтраница.Области["АМНаСкладе"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.АмЗаказанПодКлиента Тогда
		ОбластьСтраница.Области["АмЗаказанПодКлиента"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.ЗаправитьАМ Тогда
		ОбластьСтраница.Области["ЗаправитьАМДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе
		//ОбластьСтраница.Рисунки["ЗаправитьАМНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;	
	КонецЕсли;
	
	Если ДанныеДокумента.ПостановкаНаУчетГИБДД Тогда 
		ОбластьСтраница.Области["ПостановкаНаУчетГИБДДДА"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе	
		//ОбластьСтраница.Рисунки["ПостановкаНаУчетГИБДДНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.АвтоПроверенПоFlashAves Тогда 
		ОбластьСтраница.Области["АвтоПроверенПоFlashAves"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	Если ДанныеДокумента.ЛистДлительногоХранения Тогда 
		ОбластьСтраница.Области["ЛистДлительногоХраненияДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	Если ДанныеДокумента.ДокументыВыданыКлиентуВПолномОбъеме Тогда 
		ОбластьСтраница.Области["ДокументыВыданыКлиентуВПолномОбъемеДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;    
	
	Если ДанныеДокумента.СостАвтоСоотвТребКачестваПримеки Тогда 
		ОбластьСтраница.Области["СостАвтоСоотвТребКачестваПримекиДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе	
		//ОбластьСтраница.Рисунки["СостАвтоСоотвТребКачестваПримекиНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.НаличиеOTS_ПА Тогда 
		ОбластьСтраница.Области["НаличиеOTS_ПАДА"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	иначе
		//ОбластьСтраница.Рисунки["НаличиеOTS_ПАНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.НаличиеOTS_ППП	Тогда 
		ОбластьСтраница.Области["НаличиеOTS_ПППДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе
		//ОбластьСтраница.Рисунки["НаличиеOTS_ПППНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;		
	КонецЕсли;
	
	
	Если ДанныеДокумента.НаличиеOTS_ПП	Тогда 
		ОбластьСтраница.Области["НаличиеOTS_ППДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.ВыявленыПроблемыАМ Тогда 
		ОбластьСтраница.Области["ВыявленыПроблемыАМДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе	
		//ОбластьСтраница.Рисунки["ВыявленыПроблемыАМНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	//	Если ДанныеДокумента.АкбВХорошемСостоянии Тогда 
	//	ОбластьСтраница.Рисунки["АкбВХорошемСостоянииДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	//Иначе	
	//	//ОбластьСтраница.Рисунки["АкбВХорошемСостоянииНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	//КонецЕсли;

	Если ДанныеДокумента.ТопливоЗаправлено Тогда 
		ОбластьСтраница.Области["ТопливоЗаправленоДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе	
		//ОбластьСтраница.Рисунки["ТопливоЗаправленоНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	Если ДанныеДокумента.УстановленыНомерныеЗнаки Тогда 
		ОбластьСтраница.Области["УстановленыНомерныеЗнакиДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе	
		//ОбластьСтраница.Рисунки["УстановленыНомерныеЗнакиНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.ЛокДвигатель Тогда 
		ОбластьСтраница.Области["ЛокДвигатель"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.ЛокКолесаШины Тогда 
		ОбластьСтраница.Области["ЛокКолесаШины"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.ЛокНаружныеПовреждения Тогда 
		ОбластьСтраница.Области["ЛокНаружныеПовреждения"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	Если ДанныеДокумента.ЛокИнтерьерАвтомобиля Тогда 
		ОбластьСтраница.Области["ЛокИнтерьерАвтомобиля"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	Если ДанныеДокумента.ЛокДругое Тогда 
		ОбластьСтраница.Области["ЛокДругое"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	Если ДанныеДокумента.СоответствиеАмПП Тогда 
		ОбластьСтраница.Области["СоответствиеАмППДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе	
		//ОбластьСтраница.Рисунки["СоответствиеАмППНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;	
	КонецЕсли;

	Если ДанныеДокумента.ПроверкаПоFlashAVESВыполнена Тогда 
		ОбластьСтраница.Области["ПроверкаПоFlashAVESВыполнена"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;

	Если ДанныеДокумента.АМСоответствуетВыдаче Тогда 
		ОбластьСтраница.Области["АМСоответствуетВыдачеДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе
		//ОбластьСтраница.Рисунки["АМСоответствуетВыдачеНет"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ДанныеДокумента.BluetoothСинхронизированаСТелефономКлиента Тогда 
		ОбластьСтраница.Области["BluetoothСинхронизированаСТелефономКлиента"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	Если ДанныеДокумента.АудиосистемаНастроена Тогда 
		ОбластьСтраница.Области["АудиосистемаНастроена"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	Если ДанныеДокумента.АдресКлиентаВведенВНавигатор Тогда 
		ОбластьСтраница.Области["АдресКлиентаВведенВНавигатор"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	// Сергеев В.Н. DMSREN-864
	СогласиеНаОбработкуПерсональныхДанных = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ВернутьСогласиеПоКлиенту(ДанныеДокумента.Клиент);
	СогласиеНаПодключаемыеСервисы = Ложь;
	
	Если ЗначениеЗаполнено(СогласиеНаОбработкуПерсональныхДанных) Тогда
	    СогласиеНаПодключаемыеСервисы = СогласиеНаОбработкуПерсональныхДанных.СогласиеНаПодключаемыеСервисы;
	КонецЕсли;
	
	Если СогласиеНаПодключаемыеСервисы Тогда
		ОбластьСтраница.Области["НаличиеСогласияНаПодключаемыеСервисы1"].Картинка = БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	Иначе	
	    ОбластьСтраница.Области["ОтсутствиеСогласияНаПодключаемыеСервисы1"].Картинка = БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	ТаблицаЧекЛистВыдача = Ссылка.ЧекЛистВыдача.Выгрузить();
	Для каждого Стр Из ТаблицаЧекЛистВыдача Цикл
		Если Стр.Подробности = "Зарядить 30 мин ATEQ. Если на а/м сообщение о необходимости заряда АКБ, заряжать ATEQ до полной зарядки (зеленый индикатор горит постоянно, не мигает)" 
		 И ЗначениеЗаполнено(Стр.ДатаФакт) Тогда
			ОбластьСтраница.Области["ЗарядкаАКБ_ДА"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
		КонецЕсли; 
	КонецЦикла; 
	
	СписокОтзывныхНот = Renault_АвтосервисСерверПовтИспользования.ПолучитьОписаниеДействующихОТС(ДанныеДокумента.VIN);
	Если Не ПустаяСтрока(СписокОтзывныхНот) Тогда
		ОбластьСтраница.Области["НаличиеОТСВыдачиДа"].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
		ОбластьСтраница.Параметры.ОписаниеOTS_Выдачи = СписокОтзывныхНот
	КонецЕсли;
	
	//Заполним опции, аксессуары, автоработы
	ОбластьСтраница.Параметры.Опции = "";
	Для каждого стр из Ссылка.Опции цикл
		ОбластьСтраница.Параметры.Опции = ОбластьСтраница.Параметры.Опции + Стр.Опция.Наименование + ?(Стр.НомерСтроки<Ссылка.Опции.Количество(),", ","");		
	КонецЦикла;
	//ОбластьСтраница.Параметры.Аксессуары = "";
	Сч = 0;
	Для каждого стр из Ссылка.Аксессуары цикл
		Сч = Сч + 1;
		Если Сч <= 4 Тогда
			Если ТипЗнч(Стр.Номенклатура) = Тип("Строка") Тогда
				ОбластьСтраница.Параметры["Аксессуар" + Сч] = Стр.Номенклатура;		
			Иначе	
				ОбластьСтраница.Параметры["Аксессуар" + Сч] = Стр.Номенклатура.Наименование;		
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;
	ОбластьСтраница.Параметры.Автоработы = "";
	Для каждого стр из Ссылка.Автоработы цикл
		Если ТипЗнч(Стр.Номенклатура) = Тип("Строка") Тогда
			ОбластьСтраница.Параметры.Автоработы = ОбластьСтраница.Параметры.Автоработы + Стр.Номенклатура + ?(Стр.НомерСтроки<Ссылка.Автоработы.Количество(),", ","");			
		Иначе	
			ОбластьСтраница.Параметры.Автоработы = ОбластьСтраница.Параметры.Автоработы + Стр.Номенклатура.Наименование + ?(Стр.НомерСтроки<Ссылка.Автоработы.Количество(),", ","");		
		КонецЕсли;	
	КонецЦикла;

	////Заполним повреждения автомобиля
	//Для каждого стрПовреждение из Ссылка.ДефектыКузова цикл
	//	Если стрПовреждение.Повреждение = 1 тогда
	//		ОбластьСтраница.Рисунки["Кузов"+стрПовреждение.ЗонаПовреждения.ИмяПредопределенныхДанных].Картинка = БиблиотекаКартинок.Renault_Cross;
	//	КонецЕсли;
	//КонецЦикла;
	//	
	//Для каждого стрПовреждение из Ссылка.ДефектыСалона цикл
	//	Если стрПовреждение.Повреждение = 1 тогда
	//		ОбластьСтраница.Рисунки["Салон"+стрПовреждение.ЗонаПовреждения.ИмяПредопределенныхДанных].Картинка = БиблиотекаКартинок.Renault_Cross;
	//	КонецЕсли;
	//КонецЦикла;
	
	//приведем телефон к 
	Если ЗначениеЗаполнено(ДанныеДокумента.ТелефонКлиента) тогда
		Если Лев(ДанныеДокумента.ТелефонКлиента,1) = "9" тогда
			ОбластьСтраница.Параметры.ТелефонКлиента = "8"+ ДанныеДокумента.ТелефонКлиента;
		КонецЕсли;
	КонецЕсли;
	
    ТабДок.ВерхнийКолонтитул.Выводить = Ложь;
	ТабДок.НижнийКолонтитул.Выводить = Ложь;
	ТабДок.ПолеСнизу = 0;
	ТабДок.ПолеСверху = 0;	
	
	ТабДок.Вывести(ОбластьСтраница);
	
	 
КонецПроцедуры

Функция ПолучитьДанныеОбъекта(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ЗаказНаряд.Дата) КАК ПланируемаяДатаУстановкиАксессуаров
	               |ПОМЕСТИТЬ ВтДатыЗаказаАксессуаров
	               |ИЗ
	               |	Документ.DMS_КартаКачестваПоставки КАК DMS_КартаКачестваПоставки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаряд КАК ЗаказНаряд
	               |		ПО DMS_КартаКачестваПоставки.Автомобиль = ЗаказНаряд.Автомобиль
	               |ГДЕ
	               |	DMS_КартаКачестваПоставки.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	DMS_КартаКачестваПоставки.Ссылка,
	               |	DMS_КартаКачестваПоставки.Номер,
	               |	DMS_КартаКачестваПоставки.Дата,
