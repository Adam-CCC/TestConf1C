Функция ПолучитьНоментТТН(ДокОбъект) 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка КАК ТТНСсылка,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.NUM_TTN КАК ВхДокНомер,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.ВхДокДата
	|ИЗ
	|	Документ.DMS_КартаКачестваПоставки КАК ДокументDMS_КартаКачестваПоставки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|		ПО ДокументDMS_КартаКачестваПоставки.VIN = ПоступлениеАвтомобилейАвтомобили.VIN
	|			И (ПоступлениеАвтомобилейАвтомобили.Ссылка.ПометкаУдаления = ЛОЖЬ)
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|		ПО ДокументDMS_КартаКачестваПоставки.VIN = CRM_СостояниеАвтомобилейПроизводителя_v2.VIN
	|ГДЕ
	|	ДокументDMS_КартаКачестваПоставки.СостАвтоСоотвТребКачестваПримеки = ЛОЖЬ
	|	И ДокументDMS_КартаКачестваПоставки.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("НомерТТН,ДатаТТН",Выборка.ВхДокНомер,Формат(Выборка.ВхДокДата, "ДФ=dd.MM.yyyy"));
	
КонецФункции

Функция ВывестиГоризонтальнуюОбласть(ТабДокумент, Область, ОбластьШапка = Неопределено, ОбластьПодвал = Неопределено, НомерСтраницы = 1,
	СтруктураИтоговПоСтранице = Неопределено, Права = Неопределено, мсвДопОбластиПодвала = Неопределено) 
	
	Попытка
		ПраваПользователя=Права.Права;
		ЭтотОбъект=Права;
	Исключение
		ПраваПользователя=Права;
		ЭтотОбъект=Неопределено;
	КонецПопытки; 
	
	ИспользоватьРазбиениеНаСтраницы = Истина;
	
	//если не разбиваем, выводим и все
	Если Не ИспользоватьРазбиениеНаСтраницы Тогда
		ТабДокумент.Вывести(Область);
		Возврат НомерСтраницы;
	КонецЕсли;
	
	//запишем их в один массив
	МассивОбластейДляПроверки = Новый Массив;
	МассивОбластейДляПроверки.Добавить(Область);
	Если ОбластьПодвал <> Неопределено Тогда
		МассивОбластейДляПроверки.Добавить(ОбластьПодвал);
	КонецЕсли;
	Если мсвДопОбластиПодвала <> Неопределено Тогда
		Для Каждого ТекОбласть Из мсвДопОбластиПодвала Цикл
			МассивОбластейДляПроверки.Добавить(ТекОбласть);
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		//проверим, помещаются ли на странице
		РезультатПроверки = ТабДокумент.ПроверитьВывод(МассивОбластейДляПроверки);
		
		//если не помещаются, то ...
		Если НЕ РезультатПроверки Тогда
			ВывестиИтогиПоСтранице(ТабДокумент,ОбластьПодвал,СтруктураИтоговПоСтранице,Права); //выводим итог по странице
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц(); //переходим на следующую страницу
			НомерСтраницы = НомерСтраницы + 1;
			Если ОбластьШапка <> Неопределено Тогда
				ТабДокумент.Вывести(ОбластьШапка); //выводим шапку таблицы
			КонецЕсли;
		КонецЕсли;
	Исключение 		
	КонецПопытки;
	
	//выводим текущую область
	ТабДокумент.Вывести(Область);
	
	Возврат НомерСтраницы;
КонецФункции

Процедура ВывестиИтогиПоСтранице(ТабДокумент,ОбластьПодвал,СтруктураИтоговПоСтранице,Права) Экспорт
	Если ОбластьПодвал <> Неопределено Тогда
		Если СтруктураИтоговПоСтранице <> Неопределено Тогда
			Попытка
				ПраваПользователя=Права.Права;
				ЭтотОбъект=Права;
			Исключение
				ПраваПользователя=Права;
				ЭтотОбъект=Неопределено;
			КонецПопытки; 
			ФорматВыводаКоличества = обПраво("ФорматВыводаКоличества",ПраваПользователя,,ЭтотОбъект);
			ФорматВыводаСуммы = обПраво("ФорматВыводаСуммы",ПраваПользователя,,ЭтотОбъект);
			Для Каждого ЭлементИтога Из СтруктураИтоговПоСтранице Цикл
				Если Найти(ЭлементИтога.Ключ,"Кол") <> 0 Тогда
					ЗначениеПараметра = Формат(ЭлементИтога.Значение,ФорматВыводаКоличества);
				Иначе
					ЗначениеПараметра = Формат(ЭлементИтога.Значение,ФорматВыводаСуммы);
				КонецЕсли; 
				Попытка
					ОбластьПодвал.Параметры[ЭлементИтога.Ключ] = ЗначениеПараметра;
				Исключение
				КонецПопытки; 
			КонецЦикла;
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьПодвал);
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьПредставлениеОрганизации (Организация)
	
	ПредставлениеОрганизации = Новый Структура ("Наименование,ИНН,КПП,АдресЮридический,ТелефонРабочий,ОКПО");
	ПредставлениеОрганизации.Вставить("Наименование", Организация.НаименованиеПолное);
	ПредставлениеОрганизации.Вставить("ИНН", Организация.ИНН);
	ПредставлениеОрганизации.Вставить("КПП", Организация.КПП);
	ПредставлениеОрганизации.Вставить("АдресЮридический", киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресЮридический));
	ПредставлениеОрганизации.Вставить("ФактическийАдрес", киПолучитьПредставлениеКИ(Организация, Справочники.ВидыКонтактнойИнформации.АдресФактический));
	Возврат ПредставлениеОрганизации;
	
КонецФункции

Функция ВывестиПрописьюЦелуюЧасть(Сумма)
	
	Возврат ЧислоПрописью(Цел(Сумма),"Л = ru_RU; НП = Ложь", ",,,,,,,,0")
	
КонецФункции

Функция ВывестиКопейки(Сумма)
	
	БезКопеек = Цел( Сумма);
	Копейки   = Цел((Сумма - БезКопеек)*100);
	
	Возврат ?(Копейки = 0, "00", Строка(Копейки));
	
КонецФункции
