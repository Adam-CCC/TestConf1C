Процедура ПечатьСмета(ТабДок,ДокОбъект) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	DMS_КартаКачестваПоставкиРаботыPVR.КодОперации КАК код,
	|	DMS_КартаКачестваПоставкиРаботыPVR.НаименованиеОперации КАК Наименование,
	|	DMS_КартаКачестваПоставкиРаботыPVR.НормаЧас КАК НормаВремени,
	|	DMS_КартаКачестваПоставкиРаботыPVR.Стоимость КАК Стоимость,
	|	""Работы"" КАК Сортировка
	|ИЗ
	|	Документ.DMS_КартаКачестваПоставки.РаботыPVR КАК DMS_КартаКачестваПоставкиРаботыPVR
	|ГДЕ
	|	DMS_КартаКачестваПоставкиРаботыPVR.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	NULL,
	|	DMS_КартаКачестваПоставкиТоварыPVR.НаименованиеТовара,
	|	DMS_КартаКачестваПоставкиТоварыPVR.Количество,
	|	DMS_КартаКачестваПоставкиТоварыPVR.Стоимость,
	|	""Товары""
	|ИЗ
	|	Документ.DMS_КартаКачестваПоставки.ТоварыPVR КАК DMS_КартаКачестваПоставкиТоварыPVR
	|ГДЕ
	|	DMS_КартаКачестваПоставкиТоварыPVR.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокОбъект);
	
	ТЗДанных = Запрос.Выполнить().Выгрузить();
	
	Макет = Документы.DMS_КартаКачестваПоставки.ПолучитьМакет("МакетСмета");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ПредставлениеОрганизации = ПолучитьПредставлениеОрганизации(ДокОбъект.Автосалон.Организация);
	ОбластьШапка.Параметры.Заполнить(ПредставлениеОрганизации);
	ОбластьШапка.Параметры.НомерДокумента = ДокОбъект.Номер;
	ОбластьШапка.Параметры.ДатаДокумента = Формат(ДокОбъект.Дата,"ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.Модель = ДокОбъект.Модель.НаименованиеПолное;
	ОбластьШапка.Параметры.VIN = ДокОбъект.VIN;
	
	ТабДок.Вывести (ОбластьШапка);
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДок.Вывести (ОбластьШапкаТаблицы);
	
	ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	
	сОтбор = Новый Структура("Сортировка", "Работы");
	Работы = ТЗДанных.НайтиСтроки(сОтбор);
	ИтогРабот = 0;
	Если Работы.Количество() > 0 Тогда
		ОбластьСтроки.Параметры.Наименование = "Описание работ";
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;
	Для Каждого СтрРабот из Работы Цикл
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.Заполнить(СтрРабот);
		ТабДок.Вывести(ОбластьСтроки);
		ИтогРабот = ИтогРабот + СтрРабот.Стоимость;
	КонецЦикла;
	ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	ОбластьСтроки.Параметры.Наименование = "Итого работы:";
	ОбластьСтроки.Параметры.Стоимость = ИтогРабот;
	ТабДок.Вывести(ОбластьСтроки);
	
	сОтбор = Новый Структура("Сортировка", "Товары");
	Товары = ТЗДанных.НайтиСтроки(сОтбор);
	ИтогТовары = 0;
	Если Товары.Количество() > 0 Тогда
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ТабДок.Вывести(ОбластьСтроки);
		ОбластьСтроки.Параметры.Наименование = "Запчасти и расходные материалы:";
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;
	Для Каждого СтрТовары из Товары Цикл
		ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
		ОбластьСтроки.Параметры.Заполнить(СтрТовары);
		ТабДок.Вывести(ОбластьСтроки);
		ИтогТовары = ИтогТовары + СтрТовары.Стоимость;
	КонецЦикла;
	ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	ОбластьСтроки.Параметры.Наименование = "Итого товары:";
	ОбластьСтроки.Параметры.Стоимость = ИтогТовары;
	ТабДок.Вывести(ОбластьСтроки);
	ОбластьСтроки = Макет.ПолучитьОбласть("Строка");
	ОбластьСтроки.Параметры.Наименование = "Всего на общую сумму:";
	ОбластьСтроки.Параметры.Стоимость = ИтогРабот + ИтогТовары;
	ТабДок.Вывести(ОбластьСтроки);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.стоимостьНомоЧаса = ДокОбъект.СтоимостьНормаЧаса;
	ОбластьПодвал.Параметры.стоимостьНомоЧасаПрописью = ВывестиПрописьюЦелуюЧасть (ДокОбъект.СтоимостьНормаЧаса);
	ТабДок.Вывести(ОбластьПодвал);
	
	
КонецПроцедуры

Процедура ПечатьРекАкт(ТабДок,ДокОбъект) Экспорт 
	
	Если ДокОбъект.Автомобили.Количество() = 0 Тогда 
		//Предупреждение("Документ поступления автомобилей не содержит автомобилей");
		Возврат;
	КонецЕсли;
	
	ЗапросПВР = Новый Запрос;
	ЗапросПВР.Текст = 
	"ВЫБРАТЬ
	|	ДокументDMS_КартаКачестваПоставки.Ссылка
	|ИЗ
	|	Документ.DMS_КартаКачестваПоставки КАК ДокументDMS_КартаКачестваПоставки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|		ПО ДокументDMS_КартаКачестваПоставки.Автомобиль = ПоступлениеАвтомобилейАвтомобили.Автомобиль
	|			И (ПоступлениеАвтомобилейАвтомобили.Ссылка.ПометкаУдаления = ЛОЖЬ)
	|ГДЕ
	|	ДокументDMS_КартаКачестваПоставки.СостАвтоСоотвТребКачестваПримеки = ЛОЖЬ
	|	И ПоступлениеАвтомобилейАвтомобили.Ссылка = &Ссылка";
	ЗапросПВР.УстановитьПараметр("ссылка", ДокОбъект);
	ТЗДокПВР = ЗапросПВР.Выполнить().Выгрузить();
	Если ТЗДокПВР.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	мДокПВР = ТЗДокПВР.ВыгрузитьКолонку("Ссылка");
	ДокПВР = мДокПВР[0];
	
	Макет = ПолучитьМакет("МакетРекАкт");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ПредставлениеОрганизации = ПолучитьПредставлениеОрганизации(ДокОбъект.Организация);
	ОбластьШапка.Параметры.Заполнить(ПредставлениеОрганизации);
	ОбластьШапка.Параметры.ЮрРено = ДокОбъект.Контрагент.НаименованиеПолное;
	ОбластьШапка.Параметры.НомерДокумента = ДокОбъект.Номер;
	ОбластьШапка.Параметры.ДатаДокумента = Формат (ДокОбъект.Дата, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.номердоговора = ДокПВР.Автосалон.НомерДилерскогоДоговора;
	ОбластьШапка.Параметры.ДатаДоговора = Формат(ДокПВР.Автосалон.ДатаДилерскогоДоговора, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.Город = киПолучитьГород(ДокОбъект.Организация,Справочники.ВидыКонтактнойИнформации.АдресФактический);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_FACT,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.NUM_TTN
	|ИЗ
	|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|ГДЕ
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN В(&VIN)
	|	И CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_FACT <> ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("VIN", ДокОбъект.Автомобили.ВыгрузитьКолонку("VIN"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбластьШапка.Параметры.ДатаОтгрузки = Формат(Выборка.DATE_FACT,"ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.НомерТТН = Выборка.NUM_TTN;
		ОбластьШапка.Параметры.ДатаТТН = Формат(ДокОбъект.ВхДокДата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	ТабДок.Вывести(ОбластьШапка);
	Для Каждого СтрАвтомобили из ДокОбъект.Автомобили Цикл
		ОбластьАвтомобили = Макет.ПолучитьОбласть("Автомобили");
		ОбластьАвтомобили.Параметры.VIN = СтрАвтомобили.VIN;
		ОбластьАвтомобили.Параметры.НаименованиеАвтомобиля = "Renault " + СтрАвтомобили.Автомобиль.Модель + " " + СтрАвтомобили.Автомобиль.ВариантКомплектации;
		ТабДок.Вывести(ОбластьАвтомобили);
