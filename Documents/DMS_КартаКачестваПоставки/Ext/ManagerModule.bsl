	ПредставлениеПеревозчик = ПолучитьПредставлениеОрганизации(ДокПВР.ТранспортнаяКомпания);
	ОбластьШапка_2.Параметры.ФактическийАдрес = ПредставлениеОрганизации.ФактическийАдрес;
	ТабДок.Вывести(ОбластьШапка_2);
	
	Для Каждого СтрокаДокПВР из мДокПВР Цикл
		ОбластьСтрокиПВР = Макет.ПолучитьОбласть("СтрокиПВР");
		ОбластьСтрокиПВР.Параметры.НомерПВР = СтрокаДокПВР.НомерPVR;
		ОбластьСтрокиПВР.Параметры.ДатаПВР = Формат(СтрокаДокПВР.ДатаPVR,"ДФ=dd.MM.yyyy");
		ТабДок.Вывести(ОбластьСтрокиПВР);
	КонецЦикла;
	
	ОбластьШапка_3 = Макет.ПолучитьОбласть("Шапка_3");
	ОбластьШапка_3.Параметры.ФИОВодитель = ДокПВР.Водитель;
	ОбластьШапка_3.Параметры.НомерТягача = ""+ ДокПВР.НомерАвтовоза +" / "+ ДокПВР.НомерПрицепа;
	ТабДок.Вывести(ОбластьШапка_3);
	Для Каждого СтрокаДокПВР из мДокПВР Цикл
		ОбластьСтрокиПовреждения = Макет.ПолучитьОбласть("СтрокиПовреждения");
		ОбластьСтрокиПовреждения.Параметры.VIN = СтрокаДокПВР.VIN;
		СтрокаПовреждения = "";
		Для Каждого СтрТЗПовреждения из СтрокаДокПВР.ПоврежденияПоPVR Цикл 
			СтрокаПовреждения = СтрокаПовреждения + СтрТЗПовреждения.Характер + " " + СтрТЗПовреждения.Деталь +", ";
		КонецЦикла;
		ОбластьСтрокиПовреждения.Параметры.Повреждения = СтрокаПовреждения;
		ТабДок.Вывести(ОбластьСтрокиПовреждения);
	КонецЦикла;
	
	ОбластьШапка_4 = Макет.ПолучитьОбласть("Шапка_4");
	ТабДок.Вывести(ОбластьШапка_4);
	ИтогоСтоимость = 0;
	Для Каждого СтрокаДокПВР из мДокПВР Цикл
		
		ОбластьСтрокиСумма = Макет.ПолучитьОбласть("СтрокиСумма");
		ИтогоСтоимость = ИтогоСтоимость + СтрокаДокПВР.РаботыPVR.Итог("Стоимость") + СтрокаДокПВР.ТоварыPVR.Итог("Стоимость");
		ОбластьСтрокиСумма.Параметры.VIN = СтрокаДокПВР.VIN;
		ОбластьСтрокиСумма.Параметры.Сумма = СтрокаДокПВР.РаботыPVR.Итог("Стоимость") + СтрокаДокПВР.ТоварыPVR.Итог("Стоимость");
		ТабДок.Вывести(ОбластьСтрокиСумма);
	КонецЦикла;
	
	ОбластьШапка_5 = Макет.ПолучитьОбласть("Шапка_5");
	ОбластьШапка_5.Параметры.СуммаРемонта = ИтогоСтоимость;
	ОбластьШапка_5.Параметры.Организация = ПредставлениеОрганизации.Наименование;
	ОбластьШапка_5.Параметры.СуммаРемонта = ИтогоСтоимость;
	ТабДок.Вывести(ОбластьШапка_5);
	
	Для Каждого СтрокаДокПВР из мДокПВР Цикл
		
		ОбластьСтроки = Макет.ПолучитьОбласть("Строки");
		ОбластьСтроки.Параметры.НомерПВР = СтрокаДокПВР.НомерPVR;
		ОбластьСтроки.Параметры.ДатаПВР = Формат(СтрокаДокПВР.ДатаPVR, "ДФ=dd.MM.yyyy");
		ОбластьСтроки.Параметры.НомерСметы = СтрокаДокПВР.Номер;;
		ОбластьСтроки.Параметры.ДатаСметы = Формат(ДокОбъект.Дата,"ДФ=dd.MM.yyyy");
		ТабДок.Вывести(ОбластьСтроки);
	КонецЦикла;
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.СуммаРемонта = ИтогоСтоимость;
	ОбластьПодвал.Параметры.СуммаРемонтаПрописью = ВывестиПрописьюЦелуюЧасть (ИтогоСтоимость);
	ОбластьПодвал.Параметры.РасчетныйСчет = ПараметрыСеанса.Организация.ОсновнойБанковскийСчет;
	ТабДок.Вывести (ОбластьПодвал);
	
КонецПроцедуры

Процедура ПечатьТорг2(ТабДокумент,ДокОбъект) Экспорт 
	
	Перем тзВрем; // Временная таблица значений
	Перем ФорматВыводаСуммы; // Строка формата вывода суммы
	Перем ФорматВыводаКоличества; // Строка формата вывода количества
	//
	ФорматВыводаСуммы      = "ЧЦ=10; ЧДЦ=2; ЧН=0";
	ФорматВыводаКоличества = "ЧЦ=10; ЧДЦ=3; ЧН=0.000";
	
	// Получим табличную часть за исключением услуг
	тзВрем = ДокОбъект.Автомобили.Выгрузить();
	тзВрем.Колонки.Добавить("Брутто", Новый ОписаниеТипов("Число",
	Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)));
	мсвУдалить = Новый Массив;
	//Для каждого ТекСтрока Из тзВрем Цикл
	//	ТекСтрока.Брутто = ТекСтрока.Количество * ТекСтрока.ЕдиницаИзмерения.Вес;
	//КонецЦикла;
	Для каждого ТекСтрока Из мсвУдалить Цикл
		тзВрем.Удалить(ТекСтрока);	   
	КонецЦикла;
	
	ЗапросПВР = Новый Запрос;
	ЗапросПВР.Текст = 
	"ВЫБРАТЬ
	|	ДокументDMS_КартаКачестваПоставки.Ссылка
	|ИЗ
	|	Документ.DMS_КартаКачестваПоставки КАК ДокументDMS_КартаКачестваПоставки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|		ПО ДокументDMS_КартаКачестваПоставки.Автомобиль = ПоступлениеАвтомобилейАвтомобили.Автомобиль
	|			И (ПоступлениеАвтомобилейАвтомобили.Ссылка.ПометкаУдаления = ЛОЖЬ)
	|ГДЕ
	|	ДокументDMS_КартаКачестваПоставки.СостАвтоСоотвТребКачестваПримеки = ЛОЖЬ
	|	И ПоступлениеАвтомобилейАвтомобили.Ссылка = &Ссылка";
	ЗапросПВР.УстановитьПараметр("ссылка", ДокОбъект);
	ТЗДокПВР = ЗапросПВР.Выполнить().Выгрузить();
	Если ТЗДокПВР.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	мДокПВР = ТЗДокПВР.ВыгрузитьКолонку("Ссылка");
	ДокПВР = мДокПВР[0];
	
	Макет = ПолучитьМакет("ТОРГ2");
	
	ОбластьСтраница1 = Макет.ПолучитьОбласть("ШапкаСтраница1");
	ОбластьСтраница1.Параметры.Заполнить(ДокОбъект);
	
	Параметры = Новый Структура;
	
	СтруктураПредставления1=Новый Структура(
	"Наименование,ИНН,КПП,АдресЮридический,ТелефонРабочий",
	"","ИНН ","КПП ","","тел.: "
	);
	СтруктураПредставления2=Новый Структура(
	"Наименование,ИНН,КПП,АдресФактический,ТелефонРабочий",
	"","ИНН ","КПП ","","тел.: "
	);
	
	// Правим, что автоматом не заполнилось, или заполнилось неправильно
	Если НЕ обЗначениеНеЗаполнено(ДокОбъект.ПодразделениеКомпании) И НЕ обЗначениеНеЗаполнено(ДокОбъект.ПодразделениеКомпании.КПП) Тогда
		СтрокаПредставления = спПолучитьПредставление(ДокОбъект.Организация, СтруктураПредставления1);
		Параметры.Вставить("ОрганизацияПредставление", СтрЗаменить(СтрокаПредставления, ДокОбъект.Организация.КПП, ДокОбъект.ПодразделениеКомпании.КПП));
	Иначе	
		Параметры.Вставить("ОрганизацияПредставление", спПолучитьПредставление(ДокОбъект.Организация, СтруктураПредставления1));
	КонецЕсли;
	Параметры.Вставить("КодПоОКПО",				 ДокОбъект.Организация.КодПоОКПО);
	Параметры.Вставить("ВидДеятельностиПоОКДП",	 ДокОбъект.Организация.КодПоОКДП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_FACT,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.NUM_TTN,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.DEALER_PRICE_FULL,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN
	|ИЗ
	|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|ГДЕ
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN В(&VIN)";
	Запрос.УстановитьПараметр("VIN", ДокОбъект.Автомобили.ВыгрузитьКолонку("VIN"));
	Выборка = Запрос.Выполнить().Выбрать();
	ТЗДанных = Запрос.Выполнить().Выгрузить();
	Если Выборка.Следующий() Тогда
		Параметры.Вставить("ПредставлениеДокумента", "Товарно транспортная накладная №" + Выборка.NUM_TTN +" от " + Формат(ДокОбъект.ВхДокДата,"ДФ=dd.MM.yyyy"));
	КонецЕсли;
	Параметры.Вставить("Номер",	 ДокОбъект.Номер);
	Параметры.Вставить("Дата",	 ДокОбъект.Дата);
	
	Параметры.Вставить("МестоПриемки",	                 ДокОбъект.СкладКомпании);
	Параметры.Вставить("ГрузоотправительПредставление",	 спПолучитьПредставление(обПолучитьЗначениеСвойства(,"Грузоотправитель",ДокОбъект.Контрагент),СтруктураПредставления2));
	Параметры.Вставить("ПоставщикПредставление",	     спПолучитьПредставление(ДокОбъект.Контрагент,СтруктураПредставления1));
	//Параметры.Вставить("ПроизводительПредставление",	 дкОтветственноеЛицо(ДокОбъект, "Производитель").ПроизводительПредставление);
	//Параметры.Вставить("СтраховаяКомпанияПредставление", дкОтветственноеЛицо(ДокОбъект, "СтраховаяКомпания").СтраховаяКомпанияПредставление);
	//Параметры.Вставить("СпособДоставкиПредставление",    обПолучитьЗначениеСвойства(ДокОбъект, ПланыВидовХарактеристик.СвойстваОбъектов.СпособДоставки, ""));
	
	ДатаОтправления = обПолучитьЗначениеСвойства(ДокОбъект, ПланыВидовХарактеристик.СвойстваОбъектов.ДатаОтправления, "");
	Если ДатаОтправления<>"" Тогда
		ДатаОтправления = "Дата отправления товара: " + Формат(ДокОбъект.ДатаОтправления, "ДЛФ=DD");
	Иначе
		ДатаОтправления = "Дата отправления товара " + " ""_______""  _____________________ _______ г.";
	КонецЕсли;
	
	//Параметры.Вставить("ДатаОтправления", ДокОбъект.ДатаОтправления);
	
	Параметры.Вставить("НомерДоговора",	СокрЛП(ДокОбъект.ДоговорВзаиморасчетов.НомерДоговора));
	Параметры.Вставить("ДатаДоговора",  Формат(ДокОбъект.ДоговорВзаиморасчетов.ДатаНачала, "ДЛФ=DD"));
	
	// Счет-фактура, если есть.
	МассивВидов=Новый Массив(1); МассивВидов[0]="СчетФактураПолученный"; 
	МассивПодчиненных = дкПолучитьМассивПодчиненных(ДокОбъект, МассивВидов);
	Если МассивПодчиненных.Количество()>0 Тогда
		// нашли
		СФ=МассивПодчиненных[0].Ссылка;
		Попытка
			НомерСФ = дкПолучитьНомерДляПечати(СФ);
			ДатаСФ  = Формат(СФ.Дата, "ДЛФ=DD");
		Исключение
			НомерСФ = "";
			ДатаСФ  = """" + "_______"  + """" + "  __________________________  " + "__________ г.";
		КонецПопытки; 
	Иначе
		НомерСФ = "";
		ДатаСФ  = """" + "_______"  + """" + "  __________________________  " + "__________ г.";
	КонецЕсли; 
	
	Параметры.Вставить("НомерСФ", НомерСФ);
	Параметры.Вставить("ДатаСФ",  ДатаСФ);
	Параметры.Вставить("СпособДоставкиПредставление", "автовоз № " + ДокПВР.НомерАвтовоза +"/"+ ДокПВР.НомерПрицепа);
	ОбластьСтраница1.Параметры.Заполнить(Параметры);
	
	ТабДокумент.Вывести(ОбластьСтраница1);
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// ВТОРАЯ СТРАНИЦА
	НомерСтраницы     = 3;
	НомерСтраницыПред = НомерСтраницы;
	
	ОбластьНомерСтроки = Макет.ПолучитьОбласть("НомерСтраницы");
	ОбластьНомерСтроки.Параметры.НомерСтраницы = "Страница: " + 2; 
	ТабДокумент.Вывести(ОбластьНомерСтроки);
	
	ОбластьСтраница2   = Макет.ПолучитьОбласть("ШапкаСтраница2"); 
 	ОбластьСтраница2.Параметры.КоличествоМестПоДокументу = Формат(тзВрем.Итог("Количество"), ФорматВыводаКоличества);
	ОбластьСтраница2.Параметры.Брутто                    = Формат(тзВрем.Итог("Брутто"),     ФорматВыводаКоличества);    
	ТабДокумент.Вывести(ОбластьСтраница2);
	
	// ВЫВОДИМ ТАБЛИЧНУЮ ЧАСТЬ
	ОбластьШапкаТЧ = Макет.ПолучитьОбласть("ШапкаТабличнойЧасти"); 
	ОбластьШапкаТЧ.Параметры.Валюта = ДокОбъект.ВалютаДокумента;
	ТабДокумент.Вывести(ОбластьШапкаТЧ);
	// Для последующего вывода
	ОбластьШапкаТЧ.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы;
	
	// получаем макет строки
	
	
	//перебор строк
	ВыборкаТабличнойЧасти = ДокОбъект.Автомобили;
	Для каждого СтрокаТабличнойЧасти Из тзВрем Цикл
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка1");
		//заполняем данные строки
		//СтруктураСтроки = дкПолучитьПредставлениеДанныхТоварнойСтроки(СтрокаТабличнойЧасти,ДокОбъект);
		ОбластьСтрока.Параметры.НомерСтроки = СтрокаТабличнойЧасти.НомерСтроки;
		ОбластьСтрока.Параметры.ТоварНаименование = "Автомобиль марки Renault";
		ОбластьСтрока.Параметры.Артикул = СтрокаТабличнойЧасти.VIN;
		//ОбластьСтрока.Параметры.Цена = ;
		СтрАвтосклад = ТЗДанных.Найти(СтрокаТабличнойЧасти.VIN, "VIN");
		Если СтрАвтосклад <> Неопределено Тогда
			ОбластьСтрока.Параметры.СуммаВсего = СтрАвтосклад.DEALER_PRICE_FULL;
		КонецЕсли;
		// Рассчитаем цену.
		//ОбластьСтрока.Параметры.Цена = Формат(СтрокаТабличнойЧасти.СуммаВсего / СтрокаТабличнойЧасти.Количество, ФорматВыводаСуммы);
		
		ОбластьСтрока.Параметры.КодЕдиницыПоОКЕИ = "" + СокрЛП("шт.");
		
		//выводим строку, делая проверку попадания на лист
		НомерСтраницы = ВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрока, ОбластьШапкаТЧ, , НомерСтраницы, ,ДокОбъект);  		
		
		//инициализация итогов по странице
		Если НомерСтраницы <> НомерСтраницыПред Тогда
			НомерСтраницыПред = НомерСтраницы;
			ОбластьШапкаТЧ.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
		КонецЕсли; 		
	КонецЦикла;
	
	
	// ВЫВОДИМ 3-Ю СТРАНИЦУ
	//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();	
	//ОбластьНомерСтроки = Макет.ПолучитьОбласть("НомерСтраницы");
	//ОбластьНомерСтроки.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
	//ТабДокумент.Вывести(ОбластьНомерСтроки);
	
	ОбластьСтраница3   = Макет.ПолучитьОбласть("ШапкаСтраница3"); 	
	ТабДокумент.Вывести(ОбластьСтраница3);
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();	
	ОбластьНомерСтроки = Макет.ПолучитьОбласть("НомерСтраницы");
	ОбластьНомерСтроки.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
	ТабДокумент.Вывести(ОбластьНомерСтроки);
	//НомерСтраницы = НомерСтраницы + 1;
	
	// ВЫВОДИМ ПРОДОЛЖЕНИЕ ТАБЛИЧНОЙ ЧАСТИ
	ОбластьШапкаТЧ = Макет.ПолучитьОбласть("ШапкаТабличнойЧасти2"); 
	ОбластьШапкаТЧ.Параметры.Валюта = ДокОбъект.ВалютаДокумента;
	ТабДокумент.Вывести(ОбластьШапкаТЧ);
	// Для последующего вывода
	ОбластьШапкаТЧ.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы;
	
	// получаем макет строки
		ИтогоРемонт = 0;
	//перебор строк
	Для каждого СтрокаТабличнойЧасти Из тзВрем Цикл
		//заполняем данные строки
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка2");
		ОбластьСтрока.Параметры.НомерСтроки = СтрокаТабличнойЧасти.НомерСтроки;
		//ОбластьСтрока.Параметры.ТоварНаименование = СтрокаТабличнойЧасти.Автомобиль.Наименование;
		ОбластьСтрока.Параметры.Артикул = СтрокаТабличнойЧасти.VIN;
		//ОбластьСтрока.Параметры.Цена = СтрокаТабличнойЧасти.Цена;   
		СтрАвтосклад = ТЗДанных.Найти(СтрокаТабличнойЧасти.VIN, "VIN");
		Если СтрАвтосклад <> Неопределено Тогда
			ОбластьСтрока.Параметры.СуммаВсего = СтрАвтосклад.DEALER_PRICE_FULL;
		КонецЕсли;
		//ОбластьСтрока.Параметры.СуммаВсего = СтрокаТабличнойЧасти.СуммаВсего;
		Для Каждого СтрокаПВР из мДокПВР Цикл
			Если СтрокаТабличнойЧасти.VIN = СтрокаПВР.VIN Тогда
				Если СтрокаПВР.РаботыPVR.Итог("Стоимость") = 0 и СтрокаПВР.ТоварыPVR.Итог("Стоимость") = 0 Тогда
					Продолжить;
				КонецЕсли;
				ИтогоРемонт = ИтогоРемонт + СтрокаПВР.РаботыPVR.Итог("Стоимость") + СтрокаПВР.ТоварыPVR.Итог("Стоимость");
				ОбластьСтрока.Параметры.СтоимостьРемонта = СтрокаПВР.РаботыPVR.Итог("Стоимость") + СтрокаПВР.ТоварыPVR.Итог("Стоимость");
				ОбластьСтрока.Параметры.брутто = 1;
			КонецЕсли;
		КонецЦикла;
		
		//выводим строку, делая проверку попадания на лист
		НомерСтраницы = ВывестиГоризонтальнуюОбласть(ТабДокумент, ОбластьСтрока, ОбластьШапкаТЧ, , НомерСтраницы, ,ДокОбъект);
		
		//инициализация итогов по странице
		Если НомерСтраницы <> НомерСтраницыПред Тогда
			НомерСтраницыПред = НомерСтраницы;
			ОбластьШапкаТЧ.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
		КонецЕсли; 		
	КонецЦикла;
	
	
	// ВЫВОДИМ 4-Ю СТРАНИЦУ
	//ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	//ОбластьНомерСтроки = Макет.ПолучитьОбласть("НомерСтраницы");
	//ОбластьНомерСтроки.Параметры.НомерСтраницы = "Страница: " + НомерСтраницы; 
	//ТабДокумент.Вывести(ОбластьНомерСтроки);
	
	ОбластьСтраница4_1 = Макет.ПолучитьОбласть("ШапкаСтраница4_1");
	ТабДокумент.Вывести (ОбластьСтраница4_1);
	
	Для Каждого СтрокаДокПВР из мДокПВР Цикл
		ОбластьСтрокиПовреждения = Макет.ПолучитьОбласть("ОписаниеПовреждений"); 
		СтрокаПовреждения = СтрокаДокПВР.VIN +"        ";
		Для Каждого СтрТЗПовреждения из СтрокаДокПВР.ПоврежденияПоPVR Цикл 
			СтрокаПовреждения = СтрокаПовреждения + СтрТЗПовреждения.Характер + " " + СтрТЗПовреждения.Деталь +", ";
		КонецЦикла;
		ОбластьСтрокиПовреждения.Параметры.ОписаниеПовреждений = СтрокаПовреждения;
		ТабДокумент.Вывести(ОбластьСтрокиПовреждения);
	КонецЦикла;
	
	ОбластьСтраница4 = Макет.ПолучитьОбласть("ШапкаСтраница4_2");
	ОбластьСтраница4.Параметры.ИтогоРемонт = ИтогоРемонт;
	ГлавныйБухгалтер = дкОтветственноеЛицо(ДокОбъект,"ГлавныйБухгалтер");
	ОбластьСтраница4.Параметры.Заполнить(ГлавныйБухгалтер);
	
	// Комиссия
	ПредседательКомиссии = дкОтветственноеЛицо(ДокОбъект,"ПредседательКомиссии");
	ОбластьСтраница4.Параметры.Заполнить(ПредседательКомиссии);
	
	ЧленКомиссии1 = дкОтветственноеЛицо(ДокОбъект,"ЧленКомиссии1");
	ОбластьСтраница4.Параметры.Заполнить(ЧленКомиссии1);
	
	ЧленКомиссии2 = дкОтветственноеЛицо(ДокОбъект,"ЧленКомиссии2");
	ОбластьСтраница4.Параметры.Заполнить(ЧленКомиссии2);
	
	ТабДокумент.Вывести(ОбластьСтраница4); 
	
	
	// Зададим параметры макета
	ТабДокумент.ПолеСверху = 0;
	ТабДокумент.ПолеСлева  = 15;
	ТабДокумент.ПолеСнизу  = 0;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;

	
КонецПроцедуры

Процедура ПечатьПротоколОсмотра(ТабДокумент,ДокОбъект) Экспорт
	
	Если ПараметрыСеанса.DMS_Бренд = Справочники.CRM_МаркаАвтомобиля.LADA Тогда
		Макет = Документы.DMS_КартаКачестваПоставки.ПолучитьМакет("ПротоколОсмотраLADA");
	Иначе
		Макет = Документы.DMS_КартаКачестваПоставки.ПолучитьМакет("ПротоколОсмотраНовый");
	КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	ОбластьШапка.Параметры.Номер = ДокОбъект.НомерPVR;
	Если ЗначениеЗаполнено(ДокОбъект.VIN) Тогда
		VIN  = ДокОбъект.VIN;
		ОбластьШапка.Параметры.V1 = Сред(VIN,1,1);
		ОбластьШапка.Параметры.V2 = Сред(VIN,2,1);
		ОбластьШапка.Параметры.V3 = Сред(VIN,3,1);
		ОбластьШапка.Параметры.V4 = Сред(VIN,4,1);
		ОбластьШапка.Параметры.V5 = Сред(VIN,5,1);
		ОбластьШапка.Параметры.V6 = Сред(VIN,6,1);
		ОбластьШапка.Параметры.V7 = Сред(VIN,7,1);
		ОбластьШапка.Параметры.V8 = Сред(VIN,8,1);
		ОбластьШапка.Параметры.V9 = Сред(VIN,9,1);
		ОбластьШапка.Параметры.V10 = Сред(VIN,10,1);
		ОбластьШапка.Параметры.V11 = Сред(VIN,11,1);
		ОбластьШапка.Параметры.V12 = Сред(VIN,12,1);
		ОбластьШапка.Параметры.V13 = Сред(VIN,13,1);
		ОбластьШапка.Параметры.V14 = Сред(VIN,14,1);
		ОбластьШапка.Параметры.V15 = Сред(VIN,15,1);
		ОбластьШапка.Параметры.V16 = Сред(VIN,16,1);
		ОбластьШапка.Параметры.V17 = Сред(VIN,17,1);
	КонецЕсли;
	ДанныеОрганизации = ПолучитьПредставлениеОрганизации(ДокОбъект.Автосалон.Организация);
	
	ОбластьШапка.Параметры.Организация = ДанныеОрганизации.ФактическийАдрес;
	ОбластьШапка.Параметры.Модель = ДокОбъект.Модель.Наименование;
	ОбластьШапка.Параметры.Заполнить(ПолучитьНоментТТН(ДокОбъект));
	ОбластьШапка.Параметры.ГосНомер = ДокОбъект.ГосНомер;
	//ОбластьШапка.Параметры.КодЦвета = ДокОбъект.Цвет.Артикул;
	ТабДокумент.Вывести(ОбластьШапка);
	Для Каждого СтрокаТЗ из ДокОбъект.ПоврежденияПоPVR Цикл
		ОбластьСтрокиПовреждения = Макет.ПолучитьОбласть("СтрокаДефекта");
		ОбластьСтрокиПовреждения.Параметры.КодДетали = СтрокаТЗ.Деталь.Артикул ;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеДетали = СтрокаТЗ.Деталь.Наименование; 
		ОбластьСтрокиПовреждения.Параметры.КодХарактер = СтрокаТЗ.Характер.Артикул;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеХарактер = СтрокаТЗ.Характер.Наименование;
		ОбластьСтрокиПовреждения.Параметры.КодСтепень = СтрокаТЗ.Степень.Артикул;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеСтепень = СтрокаТЗ.Степень.Наименование;
		ОбластьСтрокиПовреждения.Параметры.КодРасположение = СтрокаТЗ.Расположение.Артикул;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеРасположение = СтрокаТЗ.Расположение.Наименование;
		//ОбластьСтрокиПовреждения.Параметры.КодПричины = СтрокаТЗ.Причина.Артикул;
		//ОбластьСтрокиПовреждения.Параметры.НаименованиеПричины = СтрокаТЗ.Причина.Наименование;
		ТабДокумент.Вывести(ОбластьСтрокиПовреждения);
	КонецЦикла;
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Дата = Формат(ДокОбъект.ДатаPVR, "ДФ=dd.MM.yyyy");
	ОбластьПодвал.Параметры.перевозчик = ДокОбъект.ТранспортнаяКомпания.Наименование;
	ОбластьПодвал.Параметры.Организация = ДокОбъект.Автосалон.Организация.Наименование;
	ОбластьПодвал.Параметры.НомерГрузовика = ""+ ДокОбъект.НомерАвтовоза +" / "+ ДокОбъект.НомерПрицепа;
	ОбластьПодвал.Параметры.водитель = ДокОбъект.Водитель;
	ОбластьПодвал.Параметры.Автор = ДокОбъект.ФИОПримещика;
	
	ТабДокумент.Вывести(ОбластьПодвал);
	ОбластьСхемаАвто = Макет.ПолучитьОбласть("СхемаАвто");
	ТабДокумент.Вывести(ОбластьСхемаАвто);
	ОбластьТерминология = Макет.ПолучитьОбласть("Терминология");
	ТабДокумент.Вывести(ОбластьТерминология);
	
КонецПроцедуры

Процедура ПечатьПротоколОсмотра_Старая(ТабДокумент,ДокОбъект) Экспорт
	
	Макет = Документы.DMS_КартаКачестваПоставки.ПолучитьМакет("ПротоколОсмотра");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = ДокОбъект.НомерPVR;
	ОбластьШапка.Параметры.VIn = ДокОбъект.VIN;
	ОбластьШапка.Параметры.Организация = ДокОбъект.Автосалон.Организация.Наименование;
	ОбластьШапка.Параметры.Модель = ДокОбъект.Модель.Наименование;
	ОбластьШапка.Параметры.НомерТТН = ПолучитьНоментТТН (ДокОбъект);
	ОбластьШапка.Параметры.КодЦвета = ДокОбъект.Цвет.Артикул;
	ТабДокумент.Вывести(ОбластьШапка);
	ОбластьЗамки = Макет.ПолучитьОбласть("ОбластьЗамки");
	ТабДокумент.Вывести(ОбластьЗамки);
	ОбластьШапкаПовреждения = Макет.ПолучитьОбласть("ШапкаПовреждения");
	ОбластьРаскройка = Макет.ПолучитьОбласть("ОбластьРаскройка");
	
	Для Каждого СтрокаТЗ из ДокОбъект.ПоврежденияПоPVR Цикл
		ОбластьСтрокиПовреждения = Макет.ПолучитьОбласть("СтрокиПовреждения");
		ОбластьСтрокиПовреждения.Параметры.КодДетали = СтрокаТЗ.Деталь.Артикул ;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеДетали = СтрокаТЗ.Деталь.Наименование; 
		ОбластьСтрокиПовреждения.Параметры.КодХарактер = СтрокаТЗ.Характер.Артикул;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеХарактер = СтрокаТЗ.Характер.Наименование;
		ОбластьСтрокиПовреждения.Параметры.КодСтепень = СтрокаТЗ.Степень.Артикул;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеСтепень = СтрокаТЗ.Степень.Наименование;
		ОбластьСтрокиПовреждения.Параметры.КодРасположение = СтрокаТЗ.Расположение.Артикул;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеРасположение = СтрокаТЗ.Расположение.Наименование;
		ОбластьСтрокиПовреждения.Параметры.КодПричины = СтрокаТЗ.Причина.Артикул;
		ОбластьСтрокиПовреждения.Параметры.НаименованиеПричины = СтрокаТЗ.Причина.Наименование;
		ОбластьШапкаПовреждения.Вывести(ОбластьСтрокиПовреждения);
	КонецЦикла;
	ТабДокумент.Вывести (ОбластьШапкаПовреждения);
	ТабДокумент.Присоединить(ОбластьРаскройка);
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.перевозчик = ДокОбъект.ТранспортнаяКомпания.Наименование;
	ОбластьПодвал.Параметры.Организация = ДокОбъект.Автосалон.Организация.Наименование;
	ОбластьПодвал.Параметры.НомерГрузовика = ""+ ДокОбъект.НомерАвтовоза +" / "+ ДокОбъект.НомерПрицепа;
	ОбластьПодвал.Параметры.водитель = ДокОбъект.Водитель;
	ОбластьПодвал.Параметры.Автор = ДокОбъект.ФИОПримещика;
	ОбластьПодвал.Параметры.Дата = Формат(ДокОбъект.ДатаPVR, "ДФ=dd.MM.yyyy");
	
	ТабДокумент.Вывести(ОбластьПодвал);
КонецПроцедуры

Функция ПечатьСертификатаКонтроля(ДокументСсылка) Экспорт
	
	Макет = ПолучитьМакет("ПФ_MXL_СертификатКонтроля");
	
	ТабДок = Новый ТабличныйДокумент;
	
	ОбластьШапка = Макет.ПолучитьОбласть("ШапкаСертификата");
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ДокументСсылка, "Клиент, VIN");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CRM_ЗаписьНаВыдачу.ДатаНачала
	|ИЗ
	|	Документ.CRM_ЗаписьНаВыдачу КАК CRM_ЗаписьНаВыдачу
	|ГДЕ
	|	CRM_ЗаписьНаВыдачу.VIN = &VIN
	|
	|УПОРЯДОЧИТЬ ПО
	|	CRM_ЗаписьНаВыдачу.Дата УБЫВ";
	Запрос.УстановитьПараметр("VIN", ДокументСсылка.VIN);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		ДатаНачалаВыдачи = РезультатЗапроса.ДатаНачала
	Иначе
		Сообщить("Не найдена запланированная выдача");
		Возврат Новый ТабличныйДокумент
	КонецЕсли;
	
	ОбластьШапка.Параметры.ДатаСертификата = ДатаНачалаВыдачи;
	//ОбластьШапка.Параметры.ДатаСледующегоТО = ДобавитьМесяц(ДатаНачалаВыдачи, 12);
	//ОбластьШапка.Параметры.ДатаКомплексСервиса = ДобавитьМесяц(ДатаНачалаВыдачи, 2);
	ОбластьШапка.Параметры.Модель = ДокументСсылка.Модель;
	ОбластьШапка.Параметры.Телефон = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(ДокументСсылка.Клиент);
	ОбластьШапка.Параметры.емаил = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(ДокументСсылка.Клиент);
	ТабДок.Вывести(ОбластьШапка);
	
	ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабДок.Вывести(Макет.ПолучитьОбласть("ЛистКонтроля"));
	ТабДок.Вывести(Макет.ПолучитьОбласть("НижнийКолонтикул"));
	
	// Параметры макета
	ТабДок.ПолеСверху = 5;
	ТабДок.ПолеСлева  = 5;
	ТабДок.ПолеСнизу  = 5;
	ТабДок.ПолеСправа = 5;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПечатьЧекЛиста(ДокументСсылка) Экспорт
	ТабДок = Новый ТабличныйДокумент;
	
	//+++DMSREN-864
	//Макет = ПолучитьМакет("ЧекЛист");
	Макет = ПолучитьМакет("ЧекЛистНовый");
	//---
	VIN = СокрЛП(ДокументСсылка.VIN);   
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтраница2 = Макет.ПолучитьОбласть("Страница2");

	Для Индекс=1 По СтрДлина(VIN) Цикл
