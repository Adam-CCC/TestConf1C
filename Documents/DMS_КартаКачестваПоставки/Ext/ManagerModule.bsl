Функция ПечатьЧекЛистаFlashAves(ДокументСсылка) Экспорт
	
	КолвоКонтролейНаСтранице = 6;
	
	Макет = ПолучитьМакет("ЧекЛистFlashAves");
	
	ТабДок = Новый ТабличныйДокумент;
	
	ТабДок.Вывести(Макет.ПолучитьОбласть("ЧекЛист"));
	
	Если ДокументСсылка.ПроведениеFlashAves.Количество()=0 Тогда
		ОблШапка = Макет.ПолучитьОбласть("КонтрольШапка|Блок1");	
		ОблШапка.Параметры["VIN"] = СокрЛП(ДокументСсылка.VIN);
		
		ТабДок.Вывести(ОблШапка);
		ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольШапка|Отступ"));
		ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольШапка|Блок2"));
		
		Для Сч=1 По 6 Цикл
			ОблТекКонтроль = Макет.ПолучитьОбласть("КонтрольДанные|Блок1");
			ОблТекКонтроль.Параметры["Контроль"] = "Контроль " + Строка(Сч) + " = Дилерский центр";
			
			Если Цел(Сч/2)<>Сч/2 Тогда // первый контроль в строке
				ТабДок.Вывести(ОблТекКонтроль);
			Иначе // второй контроль в строке	
				ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольДанные|Отступ"));	
				ТабДок.Присоединить(ОблТекКонтроль);
			КонецЕсли;			
		КонецЦикла;
	Иначе	
		Сч=0; СчИтог=0;
		Для каждого стр Из ДокументСсылка.ПроведениеFlashAves Цикл
			СчИтог = СчИтог + 1;
			
			Если Сч=0 Тогда // Вывод шапки контроля для новой страницы
				ОблШапка = Макет.ПолучитьОбласть("КонтрольШапка|Блок1");	
				ОблШапка.Параметры["VIN"] = СокрЛП(ДокументСсылка.VIN);
				
				ТабДок.Вывести(ОблШапка);
				ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольШапка|Отступ"));
				ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольШапка|Блок2"));
			КонецЕсли;
			
			ОблТекКонтроль = Макет.ПолучитьОбласть("КонтрольДанные|Блок1");
			ОблТекКонтроль.Параметры["Контроль"] = "Контроль " + Строка(СчИтог) + " = "+?(Не ПустаяСтрока(Стр.ВидКонтроля),Стр.ВидКонтроля,"Дилерский центр");
			ОблТекКонтроль.Параметры["Дата"]=стр.Дата;
			Если ТипЗнч(стр.Сотрудник)=Тип("СправочникСсылка.Сотрудники") Тогда
				ОблТекКонтроль.Параметры["Сотрудник"]=Строка(стр.Сотрудник)+Символы.ПС+стр.Сотрудник.Должность;
			Иначе	
				ОблТекКонтроль.Параметры["Сотрудник"]=стр.Сотрудник;
			КонецЕсли;
			ОблТекКонтроль.Параметры["Результат"]=стр.Состояние;
			ОблТекКонтроль.Параметры["Комментарий"]=стр.Комментарий;
			ОблТекКонтроль.Параметры["ОТС"]=стр.НаличиеОТС;
			ОблТекКонтроль.Параметры["ОписаниеОТС"]=стр.ОписаниеОТС;
			
			Сч=Сч+1;
			
			Если Цел(Сч/2)<>Сч/2 Тогда // первый контроль в строке
				ТабДок.Вывести(ОблТекКонтроль);
			Иначе // второй контроль в строке	
				ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольДанные|Отступ"));	
				ТабДок.Присоединить(ОблТекКонтроль);
			КонецЕсли;
			
			Если Цел(Сч/КолвоКонтролейНаСтранице)=1 Тогда 
				Сч = 0; 
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		КонецЦикла;
		
		Если Цел(СчИтог/КолвоКонтролейНаСтранице)<>СчИтог/КолвоКонтролейНаСтранице Тогда
			КолвоКонтролейИтого = (Цел(СчИтог/КолвоКонтролейНаСтранице)+1)*КолвоКонтролейНаСтранице;
			Пока СчИтог<>КолвоКонтролейИтого Цикл
				СчИтог = СчИтог + 1;
				
				Если Сч=0 Тогда // Вывод шапки контроля для новой страницы
					ОблШапка = Макет.ПолучитьОбласть("КонтрольШапка|Блок1");	
					ОблШапка.Параметры["VIN"] = СокрЛП(ДокументСсылка.VIN);
					
					ТабДок.Вывести(ОблШапка);
					ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольШапка|Отступ"));
					ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольШапка|Блок2"));
				КонецЕсли;
				
				ОблТекКонтроль = Макет.ПолучитьОбласть("КонтрольДанные|Блок1");
				ОблТекКонтроль.Параметры["Контроль"] = "Контроль " + Строка(СчИтог) + " = Дилерский центр";

			    Сч = Сч+1;
				Если Цел(Сч/2)<>Сч/2 Тогда // первый контроль в строке
					ТабДок.Вывести(ОблТекКонтроль);
				Иначе // второй контроль в строке	
					ТабДок.Присоединить(Макет.ПолучитьОбласть("КонтрольДанные|Отступ"));	
					ТабДок.Присоединить(ОблТекКонтроль);
				КонецЕсли;
				
				Если Цел(Сч/КолвоКонтролейНаСтранице)=1 Тогда 
					Сч = 0; 
					ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Параметры макета
	ТабДок.ПолеСверху = 5;
	ТабДок.ПолеСлева  = 5;
	ТабДок.ПолеСнизу  = 5;
	ТабДок.ПолеСправа = 5;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб = Истина;	
	
	Возврат ТабДок;
КонецФункции

