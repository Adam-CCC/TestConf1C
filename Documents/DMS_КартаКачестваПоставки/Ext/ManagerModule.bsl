	ТабДок.Вывести(Макет.ПолучитьОбласть("Страница1"));
	//DMSREN-864+++
	//ТабДок.Вывести(ОбластьШапка);
	//---
	ТабДок.Вывести(ОбластьСтраница2);
	ТабДок.Вывести(Макет.ПолучитьОбласть("ЭтапыВКартинках"));
	
	// Параметры макета
	ТабДок.ПолеСверху = 5;
	ТабДок.ПолеСлева  = 5;
	ТабДок.ПолеСнизу  = 5;
	ТабДок.ПолеСправа = 5;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;	
	
	Возврат ТабДок;
КонецФункции

