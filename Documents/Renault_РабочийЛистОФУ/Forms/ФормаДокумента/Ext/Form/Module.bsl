Функция ДокументФизЛица(ВидДокумента)
	
	Если ВидДокумента="Паспорт" Тогда
		ВидДок=Перечисления.ВидыДокументов.Паспорт;
		НаименованиеДок="Паспорт";
	ИначеЕсли ВидДокумента="ВодительскоеУдостоверение" Тогда
		ВидДок=Перечисления.ВидыДокументов.Удостоверение;
		НаименованиеДок="Удостоверение";
	ИначеЕсли ВидДокумента="АнкетаФизЛица" Тогда
		ВидДок=Перечисления.ВидыДокументов.Прочее;
		НаименованиеДок="Анкета физ. лица";
	Иначе
		ВидДок=Перечисления.ВидыДокументов.Прочее;
		НаименованиеДок=ВидДокумента;
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="Выбрать Первые 1 Ссылка Из Справочник.ПодтверждающиеДокументы ГДЕ Владелец=&Владелец И Не Устаревший И ВидПодтверждающегоДокумента=&ВидДок И Не ПометкаУдаления И Наименование Подобно &Наименование Упорядочить По ДатаВыдачи Убыв";
	Запрос.УстановитьПараметр("Владелец",Объект.Клиент);
	Запрос.УстановитьПараметр("ВидДок",ВидДок);
	Запрос.УстановитьПараметр("Наименование",НаименованиеДок);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СпрДок=Выборка.Ссылка
	Иначе
		СпрДок=Справочники.ПодтверждающиеДокументы.СоздатьЭлемент();
		СпрДок.Владелец=Объект.Клиент;
		СпрДок.ВидПодтверждающегоДокумента=ВидДок;
		СпрДок.Наименование=НаименованиеДок;
		СпрДок.ДатаВыдачи=ТекущаяДата();
		СпрДок.Номер="б/н";
		СпрДок.Серия="б/с";
		СпрДок.Записать();
	КонецЕсли;	
	
	Возврат СпрДок.Ссылка
КонецФункции	

Функция ПолучитьАнкету()
//	Возврат ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла));
	Возврат РеквизитФормыВЗначение("Объект").ПолучитьМакет("АнкетаФизлица")
