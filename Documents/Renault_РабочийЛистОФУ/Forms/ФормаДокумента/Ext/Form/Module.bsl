&НаКлиенте
Процедура ДобавитьДокументФизЛица()
	
	Сп=Новый СписокЗначений;
	Сп.Добавить("АнкетаФизЛица","Анкета физ. лица",Объект.ДанныеАнкетыФизЛица<>"",БиблиотекаКартинок.Renault_Client_New);
	Сп.Добавить("Паспорт","Паспорт");
	Сп.Добавить("ВодительскоеУдостоверение","Водительское удостоверение");
	Сп.Добавить("Прочее","Прочее");
	Сп.Добавить("Выбрать","Выбрать существующий",Истина);
	
	Парам=Новый Структура;
	Парам.Вставить("Список",Сп);
	Парам.Вставить("Заголовок","Документы физического лица для предоставления в банк");
	Парам.Вставить("МножественныйВыбор",Ложь);
	Парам.Вставить("КоличествоЭлементовВСтроке",5); //если не задать - вычислит автоматически соотношением сторон 3:2
	Парам.Вставить("ШиринаЭлемента",14);
	Парам.Вставить("ВысотаЭлемента",2);
	ВыбДок=ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
	Если ВыбДок<>Неопределено Тогда 
		Модифицированность=Истина;
		
		Если ВыбДок="Выбрать" Тогда
		//выбрать существующий документ			
			ФормаПодбора=ПолучитьФорму("Справочник.ПодтверждающиеДокументы.ФормаВыбора",,ЭтаФорма,УникальныйИдентификатор);
			ФормаПодбора.Отбор.Владелец.Значение=Объект.Клиент;
			ФормаПодбора.Отбор.Владелец.Использование=Истина;
			ФормаПодбора.Отбор.Владелец.ВидСравнения=ВидСравнения.Равно;
			ПодтверждающийДокумент=ФормаПодбора.ОткрытьМодально();
		Иначе //создать новый
			ПодтверждающийДокумент=ДокументФизЛица(ВыбДок);	
		КонецЕсли;	
		
		Если Объект.ПредоставленныеДокументы.НайтиСтроки(Новый Структура("Документ",ПодтверждающийДокумент)).Количество()=0 Тогда
			Строка=Объект.ПредоставленныеДокументы.Добавить();
			Строка.ДатаПредоставления=ТекущаяДата();
			Строка.Документ=ПодтверждающийДокумент;
		КонецЕсли;	
		
	Иначе Возврат
	КонецЕсли;
	
	Если ВыбДок="АнкетаФизЛица" Тогда
		
		//данные анкеты - ЗначениеВСтрокуВнутр(Структура), новая структура или реквизит ДанныеАнкетыФизЛица
		Если Объект.ДанныеАнкетыФизЛица<>"" Тогда
			Парам=Новый Структура("ДанныеАнкеты",Объект.ДанныеАнкетыФизЛица);
		Иначе
			Структура=Новый Структура;
			//фио
			Структура.Вставить("Имя",Объект.Клиент.Имя);
			Структура.Вставить("Фамилия",Объект.Клиент.Фамилия);
			Структура.Вставить("Отчество",Объект.Клиент.Отчество);
			Структура.Вставить("ДатаРождения",Объект.Клиент.ДатаРождения);
			
			//паспорт
			Структура.Вставить("ДокументУдостоверяющийЛичность","паспорт гражданина РФ");
			Паспорт=НайтиПаспорт(Объект.Клиент);
			Если ЗначениеЗаполнено(Паспорт) Тогда
				Структура.Вставить("СерияДокУЛ",Паспорт.Серия);
				Структура.Вставить("НомерДокУЛ",Паспорт.Номер);
				Структура.Вставить("ДатаВыдачиДокУЛ",Паспорт.ДатаВыдачи);
				Структура.Вставить("ВыданДокУЛ",Паспорт.КемВыдан);
			КонецЕсли;
			
			//контакты
			Контакты=Контакты(Объект.Клиент);
			Пока Контакты.Следующий() Цикл
				Если Контакты.Тип=Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
					Если Контакты.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонСотовый Тогда
						Структура.Вставить("МобильныйТелефон",Контакты.Представление);
					ИначеЕсли Контакты.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный Тогда
						Структура.Вставить("ДополнительныйТелефон",Контакты.Представление);
					ИначеЕсли Контакты.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонРабочий Тогда
						Структура.Вставить("РабочийТелефон",Лев(Контакты.Представление,10));
						Структура.Вставить("ДобавочныйТелефон",Сред(Контакты.Представление,11));
					ИначеЕсли Контакты.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонДомашний Тогда
						Структура.Вставить("ТелефонПоАдресуПроживания",Контакты.Представление);
					ИначеЕсли Контакты.Вид=Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний ИЛИ Контакты.Вид=Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий Тогда
						Структура.Вставить("ТелефонПоАдресуПроживания",Контакты.Представление);
					Иначе
						Структура.Вставить("Email",Контакты.Представление);
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;
			
			Парам=Новый Структура("ДанныеАнкеты",ЗначениеВСтрокуВнутр(Структура));
		КонецЕсли;
		
		Парам.Вставить("ПодтверждающийДокумент",ПодтверждающийДокумент);
		
//проблемы совместимости		
		//Оповещение=Новый ОписаниеОповещения("СохранитьДанныеАнкеты",ЭтаФорма);
		//ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.Форма.АнкетаФизЛица2016",Парам,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
		
		Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
			ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.Форма.АнкетаФизЛица2016",Парам,ЭтаФорма);
		Иначе
//			Выполнить("
//|			Оповещение=Новый ОписаниеОповещения(""СохранитьДанныеАнкеты"",ЭтаФорма);
//|			ОткрытьФорму(""Документ.Renault_РабочийЛистОФУ.Форма.АнкетаФизЛица2016"",Парам,ЭтаФорма,УникальныйИдентификатор,,,Оповещение);
//			|")
			ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.Форма.АнкетаФизЛица2016",Парам,ЭтаФорма,УникальныйИдентификатор);
		КонецЕсли;	
		
	ИначеЕсли ПодтверждающийДокумент<>Неопределено Тогда 
		ОткрытьЗначение(ПодтверждающийДокумент)		
	КонецЕсли;	
	
	//Анкета=ПолучитьАнкету();
	//ИмяФайла=ПолучитьИмяВременногоФайла("pdf");
	//Анкета.Записать(ИмяФайла);
