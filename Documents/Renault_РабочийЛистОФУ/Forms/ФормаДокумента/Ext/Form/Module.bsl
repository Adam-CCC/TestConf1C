	АктивныйЦвет = Вычислить(Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления().ОсновнойЦвет); 
	//УстановитьОсновнуюЗаявку();//поиск основной заявки по банку
	//УправлениеЭлементами();
КонецПроцедуры
