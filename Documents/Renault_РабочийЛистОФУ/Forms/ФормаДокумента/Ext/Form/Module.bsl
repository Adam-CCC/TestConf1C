		Док.ДатаВыдачи=Док.Дата;
		//Док.ДатаНачалаСтрахования=Док.Дата;
		Док.Агент=ПараметрыСеанса.Пользователь;
		
		Док.ВидДействияДоговора=0;
		
		Если ТипЗнч(Док.СтраховаяКомпания)=Тип("СправочникСсылка.Банки") Тогда Док.ОплатаСК=Истина КонецЕсли;
			
		Док.ДатаВыдачи=ТекущаяДата();
		Док.ДатаНачалаСтрахования=Док.ДатаВыдачи;
		Док.ТипПериодаСтрахования=Перечисления.DMS_ПериодичностьДействияБаллов.Год;
		Док.СрокСтрахования=1;
		Док.ДатаОкончанияСтрахования=ДобавитьМесяц(Док.ДатаВыдачи,12);
		Док.ДатаНачалаИспользованияТС1=Док.ДатаВыдачи;
		Док.ДатаОкончанияИспользованияТС1=Док.ДатаОкончанияСтрахования;

		Док.Организация=Объект.ДилерскийЦентр.Организация;
		Док.ТочкаПродаж=ПараметрыСеанса.ПодразделениеКомпании;
		Док.СуммаПремии=СтрокаТЧ.Стоимость; //СтрокаТЧ.ФинансоваяУслуга.Вознаграждение;
		// Трояновский К.Е. 15.02.2019 11:55:55 {
		// Закомментировано по DMSCOR-1087
		//Если Док.Дата >= '20190101' Тогда
		//	Док.СуммаНДС=Док.СуммаПремии*20/120;
		//Иначе
		//	Док.СуммаНДС=Док.СуммаПремии*18/118;
		//КонецЕсли;
		Док.СуммаНДС=Док.СуммаПремии*Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка / (100 + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка);
		// Трояновский К.Е. 15.02.2019 11:55:55 }
		Док.СтраховаяСумма=Объект.СтоимостьАвтомобиля;
		//Док.СрокСтрахования=СтрокаТЧ.СрокСтрахования;

		ФормаСтрахПолис.ДобавитьВодительскоеУдостоверениеКонтрагента();
		//СтрЛицДопУпр=Док.ЛицаДопущенныеКУправлениюТС.Добавить();
		//СтрЛицДопУпр.ВодительскоеУдостоверение=ВодительскоеУдостоверение(Объект.Клиент);
		//СтрЛицДопУпр.ГодНачалаВодительскогоСтажа=СтрЛицДопУпр.ВодительскоеУдостоверение.ДатаВыдачи;
		//СтрЛицДопУпр.ЛицоДопущенное=Объект.Клиент;
		//СтрЛицДопУпр.ВодительскийСтаж=Год(Объект.Дата)-СтрЛицДопУпр.ГодНачалаВодительскогоСтажа;
		
		//Для Каждого СтрФ Из Объект.ФинансовыеУслуги Цикл
			СтрПлатежнаяИнформация=Док.ПлатежнаяИнформация.Добавить();
			СтрПлатежнаяИнформация.СтраховаяСумма=Объект.СтоимостьАвтомобиля;
			СтрПлатежнаяИнформация.СтраховаяПремия=СтрокаТЧ.Стоимость;
			//СтрПлатежнаяИнформация.СтраховойТариф
		//КонецЦикла;	
		
		//Док.Состояние=Перечисления.Renault_СтатусыСтраховыхПолисов.ВРаботе;
		
		ФормаСтрахПолис.ИдСтрокиВладельца=Элементы.ФинансовыеУслуги.ТекущаяСтрока;
		ФормаСтрахПолис.РежимПодбора=Истина;
		ФормаСтрахПолис.Открыть();
		
	Иначе
		ОткрытьЗначение(СтрокаТЧ.СтраховойПолис)
	КонецЕсли;	
	
