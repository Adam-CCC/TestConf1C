&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи) Оповестить("ОбновитьВоронку"); Оповестить("ОбновитьСписок"); УправлениеЭлементами() КонецПроцедуры

Процедура УправлениеЭлементами()
	Элементы.кнВернутьВЗадачи.Доступность=Не Объект.Задача.Пустая() И НЕ Объект.Ссылка.Проведен И НЕ Объект.Ссылка.Пустая();
	Элементы.кнСостояние.Заголовок="Состояние:"+Символы.ПС+Объект.Состояние;
	//Элементы.ЗаголовокФормы.Заголовок="Рабочий лист кредит ("+Нрег(Объект.Состояние)+")";
	Заголовок="Рабочий лист кредит ("+Нрег(Объект.Состояние)+")";
	
	//Элементы.кнВернутьВЗадачи.Видимость=НЕ Объект.Задача.Пустая();
	
	Элементы.Версия.СписокВыбора.ЗагрузитьЗначения(Renault_ОбщиеФункции.ВариантыКомплектаций(Объект.Автомобиль));
	
	Если Не Объект.КоммерческоеПредложение.Пустая() Тогда
		Элементы.Автомобиль.ТолькоПросмотр=Истина;
		Элементы.Версия.ТолькоПросмотр=Истина;
		Элементы.КоммерческоеПредложение.ТолькоПросмотр=Истина;
		Элементы.СтоимостьАвтомобиля.ТолькоПросмотр=Истина;
		Элементы.Клиент.ТолькоПросмотр=Истина;
	КонецЕсли;	
	
	//переключение закладки
	//АктивныйЦвет=Новый Цвет(255,207,0);
	ПассивныйЦвет=Новый Цвет(189,195,206);
	Для Каждого Эл Из спЗакладки Цикл
		Элементы["кн"+Эл.Значение].ЦветФона=?(Эл.Пометка,АктивныйЦвет,ПассивныйЦвет);
		Элементы["кн"+Эл.Значение].ЦветРамки=?(Эл.Пометка,АктивныйЦвет,ПассивныйЦвет);
		Элементы[Эл.Значение].Видимость=Эл.Пометка;
	КонецЦикла;
	
	Элементы.кнОформитьЗаявку.Видимость=ИмяТЧ()<>"ПредоставленныеДокументы";
	//Элементы.кнОсновной.Доступность=ИмяТЧ()="ЗаявкиВБанк";
	
	////добавим условное оформление
	//Отбор=ЭтаФорма.УсловноеОформление.Элементы[0].Отбор.Элементы[0];
	//Отбор.ПравоеЗначение=ОсновнаяЗаявка;
	
	Элементы.кнОформитьСтраховойПолис.Доступность=Объект.ФинансовыеУслуги.Количество()>0;
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьСостояние(Состояние="")
	Если ТипЗнч(Состояние)=Тип("КомандаФормы") Тогда
		Состояния=Новый СписокЗначений;
		Для Каждого Эл Из Перечисления.Renault_CRM_СтатусЗаявокНаКредит Цикл Состояния.Добавить(Эл) КонецЦикла;	
		Состояния.НайтиПоЗначению(Объект.Состояние).Пометка=Истина;

		Парам=Новый Структура;
		Парам.Вставить("Список",Состояния);
		Парам.Вставить("Заголовок","Состояние заявки");
		Парам.Вставить("МножественныйВыбор",Ложь);
		//Парам.Вставить("КоличествоЭлементовВСтроке",3);
		Парам.Вставить("ШиринаЭлемента",14);
		Парам.Вставить("ВысотаЭлемента",2);
		Состояние=ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
	КонецЕсли;
	
	Если Состояние<>Неопределено Тогда 
		СтароеСостояние=Объект.Состояние;
		Объект.Состояние=Состояние;
		Модифицированность=Истина;
		//Если НЕ ИзменитьСостояние() Тогда Объект.Состояние=СтароеСостояние КонецЕсли;
	КонецЕсли;
	УправлениеЭлементами();
КонецПроцедуры

&НаКлиенте
Процедура кнВернутьВЗадачи(Команда) Если Вопрос(НСтр("en='Return the application to the task?';ru='Вернуть заявку в задачи?'"), РежимДиалогаВопрос.ДаНет, 0)=КодВозвратаДиалога.Да Тогда ВернутьВЗадачи() КонецЕсли КонецПроцедуры 
Процедура ВернутьВЗадачи() Если Задачи.Renault_События.ОтменитьВыполнениеЗадачи(Объект.Задача) Тогда УправлениеЭлементами() КонецЕсли КонецПроцедуры

&НаКлиенте
Процедура кнопкиТЧ(Команда)
	ИмяТЧ=ИмяТЧ();
	ИмяТЧОбъекта=?(ИмяТЧ="ЗаявкиНаКредит","РасчетКредита",ИмяТЧ);
	Если ТекущийЭлемент.Имя="кнДобавить" Тогда 
		//СтрокаТЧ=Объект[ИмяТЧ].Добавить();
		Если ИмяТЧ="РасчетКредита" или ИмяТЧ="ЗаявкиНаКредит" Тогда РасчетКредита()
		ИначеЕсли ИмяТЧ="ПредоставленныеДокументы" Тогда ДобавитьДокументФизЛица()
		КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнУдалить" Тогда 
		Если Элементы[ИмяТЧ].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		ТекСтрока=Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока);
		Если ТекСтрока<>Неопределено Тогда Объект[ИмяТЧОбъекта].Удалить(ТекСтрока) КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнОбновить" Тогда Элементы[ИмяТЧ].Обновить()
	ИначеЕсли ТекущийЭлемент.Имя="кнОформитьЗаявку" Тогда
		Если Элементы[ИмяТЧ].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		ЗаявкаВБанк()
	ИначеЕсли ТекущийЭлемент.Имя="кнОсновной" Тогда
		Если Элементы[ИмяТЧ].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		Для Каждого Стр Из Объект[ИмяТЧОбъекта] Цикл 
			Если Стр=Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока) Тогда
				Стр.Основной=НЕ Стр.Основной
			Иначе
				Стр.Основной=Ложь
			КонецЕсли;	
		КонецЦикла;
		//СтрокаТЧ=Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока);
		//СтрокаТЧ.Основной=Не СтрокаТЧ.Основной;
		//ОсновнаяЗаявка=СтрокаТЧ.ЗаявкаВБанк;
		//Объект.БанкПредоставляющийКредит=СтрокаТЧ.ЗаявкаВБанк.БанкПредоставляющийКредит;
		//Объект.КредитноеПредложение=СтрокаТЧ.ЗаявкаВБанк.КредитноеПредложение;
		//Объект.ПервоначальныйВзносПроцент=СтрокаТЧ.ЗаявкаВБанк.ПервоначальныйВзносПроцент;
		//Объект.ПервоначальныйВзнос=СтрокаТЧ.ЗаявкаВБанк.ПервоначальныйВзнос;
		//Объект.ЕжемесячныйПлатеж=СтрокаТЧ.ЗаявкаВБанк.ЕжемесячныйПлатеж;
		//Объект.Ставка=СтрокаТЧ.ЗаявкаВБанк.Ставка;
		//Объект.Срок=СтрокаТЧ.ЗаявкаВБанк.Срок;
		//Объект.Сумма=СтрокаТЧ.ЗаявкаВБанк.Сумма;
		//УправлениеЭлементами();
		
	//финансовые услуги		
	ИначеЕсли ТекущийЭлемент.Имя="кнДобавитьНал" Тогда
		ДобавитьФинУслугу();
		//ДобавитьВидСтрахования()
		////СтрокаТЧ=Объект[ИмяТЧ].Добавить();
		//Если ИмяТЧ="СтраховыеПолисы" Тогда ОформитьСтраховойПолис() КонецЕсли;
		//Если ИмяТЧ="ФинансовыеУслуги" Тогда ДобавитьВидСтрахования() КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнОформитьСтраховойПолис" Тогда
		
		//создание контрагента
		Если ТипЗнч(Объект.Клиент)<>Тип("СправочникСсылка.Контрагенты") Тогда
			Если Вопрос("Необходимо создать элемент справочника Контрагенты",РежимДиалогаВопрос.ОКОтмена)=КодВозвратаДиалога.ОК Тогда
				Спр=Справочники.Контрагенты.СоздатьЭлемент();
				Спр.НаименованиеПолное=Объект.Клиент;
				Спр.Наименование=Объект.Клиент;
				Спр.ПолучитьФорму().ОткрытьМодально();
				Если НЕ Спр.Ссылка.Пустая() Тогда Объект.Клиент=Спр.Ссылка КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
		ОформитьСтраховойПолис()
	ИначеЕсли ТекущийЭлемент.Имя="кнУдалитьНал" Тогда
		Если Элементы.ФинансовыеУслуги.ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		Строка=Объект.ФинансовыеУслуги.НайтиПоИдентификатору(Элементы.ФинансовыеУслуги.ТекущаяСтрока);
		Если Строка<>Неопределено Тогда Объект.ФинансовыеУслуги.Удалить(Строка) КонецЕсли;
		////Строка=Объект[ИмяТЧ].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока);
		////Если Строка<>Неопределено Тогда Объект[ИмяТЧ].Удалить(Строка) КонецЕсли;
		//Строка=Объект.ФинансовыеУслуги.НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока);
		//Если Строка<>Неопределено Тогда Объект.ФинансовыеУслуги.Удалить(Строка) КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнОбновитьНал" Тогда Элементы.ФинансовыеУслуги.Обновить() //Элементы[ИмяТЧ].Обновить() 
	КонецЕсли;
	
	ИзменениеСостояния();
	УправлениеЭлементами(); 
	
КонецПроцедуры
Функция ИмяТЧ() Для Каждого Эл Из спЗакладки Цикл Если Эл.Пометка Тогда Возврат Эл.Значение КонецЕсли КонецЦикла КонецФункции	

&НаКлиенте
Процедура РасчетКредита(ИдСтроки=Неопределено)
	
	Если ТипЗнч(Объект.Автомобиль) = Тип("СправочникСсылка.Модели") Тогда
		Сообщить("Нельзя оформить кредит на несуществующий автомобиль." + Символы.ПС
		 + "В поле ""Автомобиль"" должен быть указан автомобиль, не модель.");
		Возврат
	КонецЕсли;
	
	Парам=Новый Структура;
	Парам.Вставить("Клиент",Объект.Клиент);
	Парам.Вставить("Автомобиль",Объект.Автомобиль);
	Парам.Вставить("Версия",Объект.Версия);
	Парам.Вставить("ТипКП",Объект.КоммерческоеПредложение.ТипКП);
	Парам.Вставить("СтоимостьАвтомобиля",Объект.СтоимостьАвтомобиля);
	
	Если ИдСтроки<>Неопределено Тогда
		Строка=Объект.РасчетКредита.НайтиПоИдентификатору(ИдСтроки);
		Парам.Вставить("УсловияРасчета",Строка.УсловияРасчета);
	КонецЕсли;	
	
	ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.Форма.РасчетКредита",Парам,ЭтаФорма,УникальныйИдентификатор,,,Новый ОписаниеОповещения("ЗавершениеРачетаКредита",ЭтаФорма,ИдСтроки));
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеРачетаКредита(Данные,ИдСтроки) Экспорт
	Если Данные=Неопределено Тогда Возврат КонецЕсли;
	Строка=?(ИдСтроки=Неопределено,Объект.РасчетКредита.Добавить(),Объект.РасчетКредита.НайтиПоИдентификатору(ИдСтроки));
	ЗаполнитьЗначенияСвойств(Строка,Данные);
	Строка.УсловияРасчета=ЗначениеВСтрокуВнутр(Данные); //сохранить параметры расчета кредита в реквизит строки
КонецПроцедуры	

&НаКлиенте
Процедура РасчетКредитаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) РасчетКредита(Элементы.РасчетКредита.ТекущаяСтрока) КонецПроцедуры

&НаКлиенте
Процедура ЗаявкиНаКредитВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка) СтандартнаяОбработка=Ложь; ЗаявкаВБанк() КонецПроцедуры

&НаКлиенте
Процедура ЗаявкаВБанк()
	Если Элементы[ИмяТЧ()].ТекущиеДанные=Неопределено  Тогда
		Сообщить("Добавьте новый расчет или выбирите существующий",СтатусСообщения.Информация);
		Возврат
	ИначеЕсли Элементы[ИмяТЧ()].ТекущиеДанные.ЗаявкаВБанк.Пустая() Тогда
	//создать новую заявку	
		Форма=ПолучитьФорму("Документ.Renault_ЗаявкаНаКредит.ФормаОбъекта");
		Форма.Объект.Автомобиль=Объект.Автомобиль;
		Форма.Объект.РабочийЛист=Объект.РабочийЛист;
		Форма.Объект.ДилерскийЦентр=Объект.ДилерскийЦентр;
		Форма.Объект.Версия=Объект.Версия;
		Форма.Объект.Клиент=Объект.Клиент;
		Форма.Объект.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Черновик;
		Форма.Объект.СтоимостьАвтомобиля=Объект.СтоимостьАвтомобиля;
		
		Если Объект.РасчетКредита.Количество()=0 Тогда
			Строка=Объект.РасчетКредита.Добавить();
		Иначе
			Строка=Объект.РасчетКредита.НайтиПоИдентификатору(Элементы[ИмяТЧ()].ТекущиеДанные.ПолучитьИдентификатор());
			Форма.Объект.Банк=Строка.КредитноеПредложение.Владелец;
			Форма.Объект.КредитноеПредложение=Строка.КредитноеПредложение;
			Форма.Объект.СтавкаБанка=Строка.СтавкаБанка;
			Форма.Объект.СрокКредита=Строка.СрокКредита;
			Форма.Объект.ПервоначальныйВзносПроцент=Строка.ПервоначальныйВзносПроцент;
			Форма.Объект.ПервоначальныйВзнос=Строка.ПервоначальныйВзнос;
			Форма.Объект.СуммаКредита=Строка.СуммаКредита;
			Форма.Объект.ЕжемесячныйПлатеж=Строка.ЕжемесячныйПлатеж;
		КонецЕсли;	
		
		Форма.ОткрытьМодально();
		Если НЕ Форма.Объект.Ссылка.Пустая() Тогда
			Строка.ЗаявкаВБанк=Форма.Объект.Ссылка;
			Записать();
		КонецЕсли;	
	ИначеЕсли НЕ Элементы[ИмяТЧ()].ТекущиеДанные.ЗаявкаВБанк.Пустая() Тогда
	//открыть существующую заявку	
		ОткрытьФорму("Документ.Renault_ЗаявкаНаКредит.ФормаОбъекта",Новый Структура("Ключ",Элементы[ИмяТЧ()].ТекущиеДанные.ЗаявкаВБанк),ЭтаФорма,УникальныйИдентификатор)	
	КонецЕсли;	
КонецПроцедуры

