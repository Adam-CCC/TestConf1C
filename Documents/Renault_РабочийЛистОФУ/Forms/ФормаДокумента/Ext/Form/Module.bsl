&НаКлиенте
Процедура ПредоставленныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Строка=Объект.ПредоставленныеДокументы.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка.Документ.ВидПодтверждающегоДокумента=Перечисления.ВидыДокументов.Прочее И Строка.Документ.Наименование="Анкета физ. лица" Тогда
		СтандартнаяОбработка=Ложь;
		Парам=Новый Структура("ДанныеАнкеты",Объект.ДанныеАнкетыФизЛица);
		Парам.Вставить("ПодтверждающийДокумент",Строка.Документ);
		Если Renault_ОбщиеФункции.СтараяПлатформа() Тогда
			ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.Форма.АнкетаФизЛица2016",Парам,ЭтаФорма);
		Иначе
			ОткрытьФорму("Документ.Renault_РабочийЛистОФУ.Форма.АнкетаФизЛица2016",Парам,ЭтаФорма,УникальныйИдентификатор);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

