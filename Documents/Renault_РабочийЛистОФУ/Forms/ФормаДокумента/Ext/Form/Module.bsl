Функция НайтиПаспорт(Физик)
	Запрос=Новый Запрос("Выбрать Первые 1 Ссылка Из Справочник.ПодтверждающиеДокументы ГДЕ Владелец=&Физик И ВидПодтверждающегоДокумента=Значение(Перечисление.ВидыДокументов.Паспорт)
	|	И (ДатаОкончания=ДатаВремя(1,1,1,0,0,0) ИЛИ ДатаОкончания>&ТекДата) 
	|");
	Запрос.УстановитьПараметр("Физик",Физик);
	Запрос.УстановитьПараметр("ТекДата",ТекущаяДата());
	Выборка=Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка
КонецФункции	
