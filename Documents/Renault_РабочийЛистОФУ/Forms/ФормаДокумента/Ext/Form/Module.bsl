Процедура ИзменениеСостояния()
	
	Если Объект.Задача.ВидСобытия=Справочники.CRM_ВидыСобытий.Кредит Тогда
		
		Если Объект.РасчетКредита.Количество()=0 Тогда
			Объект.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Черновик
		Иначе
			Если Объект.РасчетКредита.НайтиСтроки(Новый Структура("ЗаявкаВБанк",Документы.Renault_ЗаявкаНаКредит.ПустаяСсылка())).Количество()=0 Тогда
				Объект.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Выполнена
			Иначе
				Объект.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.НаРассмотрении
			КонецЕсли;	
		КонецЕсли;	
		
	ИначеЕсли Объект.Задача.ВидСобытия=Справочники.CRM_ВидыСобытий.КонсультацияОФУ Тогда
		
		Если Объект.ФинансовыеУслуги.Количество()=0 Тогда
			Объект.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Черновик
		Иначе
			Если Объект.ФинансовыеУслуги.НайтиСтроки(Новый Структура("СтраховойПолис",Документы.Renault_СтраховойПолис.ПустаяСсылка())).Количество()=0 Тогда
				Объект.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.Выполнена
			Иначе
				Объект.Состояние=Перечисления.Renault_CRM_СтатусЗаявокНаКредит.НаРассмотрении
			КонецЕсли;	
