Функция НайтиСвязанныеЗаявкиНаСервис()

	МассивЗаявок = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_CRM_ЗаявкаНаСервис.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
	               |		ПО Renault_CRM_ВыдачаАвтомобиля.Обращение = Renault_CRM_ЗаявкаНаСервис.Обращение
	               |			И (Renault_CRM_ВыдачаАвтомобиля.Ссылка = &Ссылка)
	               |			И (НЕ Renault_CRM_ЗаявкаНаСервис.ПометкаУдаления)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Ссылка УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивЗаявок.Добавить(Выборка.Ссылка);	
	КонецЦикла;

	Возврат МассивЗаявок;
	
КонецФункции // НайтиСвязаннуюЗаявкуНаСервис()

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка = Истина Тогда
		
		Возврат;
		
	КонецЕсли;
	
	УдалитьДвиженияПродажиСервиса();
КонецПроцедуры

Процедура УдалитьДвиженияПродажиСервиса()
	
	Заявки = НайтиСвязанныеЗаявкиНаСервис();
	
	Для каждого ЭлЗаявка Из Заявки Цикл
	
		НаборЗаписейПродажиСервиса = РегистрыСведений.Renault_СоставРаботПоЭтапам.СоздатьНаборЗаписей();
		НаборЗаписейПродажиСервиса.Отбор.Этап.Установить(3);
		НаборЗаписейПродажиСервиса.Отбор.ЗаявкаНаСервис.Установить(ЭлЗаявка);
		НаборЗаписейПродажиСервиса.Прочитать();
		НаборЗаписейПродажиСервиса.Очистить();
		НаборЗаписейПродажиСервиса.Записать();		
	
	КонецЦикла;

КонецПроцедуры

