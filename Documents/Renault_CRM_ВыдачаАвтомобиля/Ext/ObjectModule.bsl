Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка = Истина Тогда
		
		Возврат;
		
	КонецЕсли;
	
	#Если Клиент Тогда
	
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		
		//Если ПараметрыСеанса.Renault_ПраваПользователя.ВерсияАльфаАвто = "4" Тогда
		//	
		//	Попытка
		//		
		//		АвтоОб = Автомобиль.Ссылка.ПолучитьОбъект();
		//		
		//		Выполнить("ГосНомер	 = АвтоОб.ЧтениеЗначенияРегистраСведения(Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер)");
		//		//Пробег		 = АвтоОб.ЧтениеЗначенияРегистраСведения(Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);	
		//		
		//	Исключение
		//		
		//		//Сообщить("Не удалось прочитать данные автомобиля: " + ОписаниеОшибки());
		//		
		//	КонецПопытки;
		//	
		//Иначе
			
		Выполнить("ГосНомер	 = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль.Ссылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер)");
			//Пробег		 = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Элемент.ТекущиеДанные.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
			
		//КонецЕсли;
		
	КонецЕсли;
	
	#КонецЕсли
	
	Если Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ВыдачаНачата Тогда
	
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		Запись.Обращение = Обращение;
		Запись.Цех = Машиноместо;
		Запись.ЭтапРабот = 1;
		Запись.РабочийДокумент = Ссылка;
		Запись.Период = ТекущаяДата();
		Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаНачата;
		Запись.Записать();
		
		НаборПланОперативный = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		НаборПланОперативный.Отбор.РабочийДокумент.Установить(Ссылка);
		НаборПланОперативный.Прочитать();
		НаборПланОперативный.Очистить();
		
		Запись = НаборПланОперативный.Добавить();
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		Запись.Период = ТекущаяДата();
		Запись.Обращение = Обращение;
		Запись.РабочийДокумент = Ссылка;
		Запись.ЭтапРабот = 1;
		Запись.Цех = Машиноместо;
		Запись.ВремяНачала = ТекущаяДата();
		//Длительность = Выборка.ВремяОкончания - Выборка.ВремяНачала;
		Запись.ВремяОкончания = ТекущаяДата() + 1200;
		Запись.Длительность = 1/3;
		//Запись.Записать();
		НаборПланОперативный.Записать();
		
		Сотрудник = ЭтотОбъект.Машиноместо;
		
		Запись = РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СоздатьМенеджерЗаписи();
		Запись.Сотрудник = Машиноместо;
		Запись.Статус = Перечисления.CRM_ЗанятостьСотрудника.Занят;
		Запись.Период = ТекущаяДата();
		Запись.ПричинаЗанятости = Перечисления.CRM_ПричиныЗанятостиСотрудника.Выдача;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ДилерскийЦентр.ДлительностьВыдачи) Тогда
			
			Длительность = ЭтотОбъект.ДилерскийЦентр.ДлительностьВыдачи*60;
			
		Иначе
		
			Длительность = 1200;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ВремяОкончания) Тогда
			
			Запись.ПримерноеВремяОкончания = ЭтотОбъект.ВремяОкончания;
			
		Иначе
			
			Запись.ПримерноеВремяОкончания = ТекущаяДата() + Длительность;
			
		КонецЕсли;
		
		Запись.Записать();
		
	//какой статус для "свободен" пока не придумал, пусть будет так:	
	ИначеЕсли Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен Тогда
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		
		Запись.Обращение = Обращение;
		Запись.Цех = Машиноместо;
		Запись.ЭтапРабот = 1;
		Запись.РабочийДокумент = Ссылка;
		Запись.Период = ТекущаяДата();
		Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена;
		Запись.Записать();
		
		НаборПлан = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		НаборПлан.Отбор.РабочийДокумент.Установить(Ссылка);
		НаборПлан.Прочитать();
		НаборПлан.Очистить();
		НаборПлан.Записать();
		
		Запись = РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СоздатьМенеджерЗаписи();
		Запись.Сотрудник = Машиноместо;
		Запись.Статус = Перечисления.CRM_ЗанятостьСотрудника.Свободен;
		Запись.Период = ТекущаяДата();
		
		Запись.Записать();
		
	КонецЕсли;
	
	// Воробьев Д.А. 06.10.2016 16:40:41 +++
	Если Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен
		И Не ПометкаУдаления Тогда
		
		МассивЗаявок = НайтиСвязанныеЗаявкиНаСервис();
		
		Для каждого мЗаявкаНаСервис Из МассивЗаявок Цикл
		
			Запрос = Новый Запрос;
			
			Запрос.УстановитьПараметр("Сотрудник", Машиноместо);
			Запрос.УстановитьПараметр("ЗаявкаНаСервис", мЗаявкаНаСервис);
			
			// Если есть заказ-наряд, то считаем его итоговым документом
			Если Не ЗначениеЗаполнено(мЗаявкаНаСервис.ЗаказНаряд) Тогда
				
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Renault_CRM_ЗаявкаНаСервисРаботы.Работа КАК РаботаЗапчасть,
				|	СУММА(Renault_CRM_ЗаявкаНаСервисРаботы.Сумма) КАК Сумма,
				|	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка КАК ЗаявкаНаСервис,
				|	&Сотрудник КАК Сотрудник,
				|	3 КАК Этап,
				|	ИСТИНА КАК ЭтоРабота
				|ИЗ
				|	Документ.Renault_CRM_ЗаявкаНаСервис.Работы КАК Renault_CRM_ЗаявкаНаСервисРаботы
				|ГДЕ
				|	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка = &ЗаявкаНаСервис
				|
				|СГРУППИРОВАТЬ ПО
				|	Renault_CRM_ЗаявкаНаСервисРаботы.Работа,
				|	Renault_CRM_ЗаявкаНаСервисРаботы.Ссылка
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	Renault_CRM_ЗаявкаНаСервисТовары.Номенклатура,
				|	СУММА(Renault_CRM_ЗаявкаНаСервисТовары.Сумма),
				|	Renault_CRM_ЗаявкаНаСервисТовары.Ссылка,
				|	&Сотрудник,
				|	3,
				|	ЛОЖЬ
				|ИЗ
				|	Документ.Renault_CRM_ЗаявкаНаСервис.Товары КАК Renault_CRM_ЗаявкаНаСервисТовары
				|ГДЕ
				|	Renault_CRM_ЗаявкаНаСервисТовары.Ссылка = &ЗаявкаНаСервис
				|
				|СГРУППИРОВАТЬ ПО
				|	Renault_CRM_ЗаявкаНаСервисТовары.Номенклатура,
				|	Renault_CRM_ЗаявкаНаСервисТовары.Ссылка";
				
			Иначе
				
				Запрос.УстановитьПараметр("ЗаказНаряд", мЗаявкаНаСервис.ЗаказНаряд);
				
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЗаказНарядТовары.Номенклатура КАК РаботаЗапчасть,
				|	СУММА(ЗаказНарядТовары.СуммаВсего) КАК Сумма,
				|	&Сотрудник КАК Сотрудник,
				|	3 КАК Этап,
				|	&ЗаявкаНаСервис,
				|	ЛОЖЬ КАК ЭтоРабота
				|ИЗ
				|	Документ.ЗаказНаряд.Товары КАК ЗаказНарядТовары
				|ГДЕ
				|	ЗаказНарядТовары.Ссылка = &ЗаказНаряд
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказНарядТовары.Номенклатура
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ЗаказНарядРаботы.Работа,
				|	СУММА(ЗаказНарядРаботы.СуммаВсего),
				|	&Сотрудник,
				|	3,
				|	&ЗаявкаНаСервис,
				|	ИСТИНА
				|ИЗ
				|	Документ.ЗаказНаряд.Работы КАК ЗаказНарядРаботы
				|ГДЕ
				|	ЗаказНарядРаботы.Ссылка = &ЗаказНаряд
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказНарядРаботы.Работа";
			
			КонецЕсли;
			
			НаборЗаписейПродажиСервиса = РегистрыСведений.Renault_СоставРаботПоЭтапам.СоздатьНаборЗаписей();
			НаборЗаписейПродажиСервиса.Отбор.Этап.Установить(3);
			НаборЗаписейПродажиСервиса.Отбор.ЗаявкаНаСервис.Установить(мЗаявкаНаСервис);
			НаборЗаписейПродажиСервиса.Прочитать();
			НаборЗаписейПродажиСервиса.Очистить();
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Запись = НаборЗаписейПродажиСервиса.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				
