
Функция ПолучитьВыдачуПоОбращению(Обращение) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_CRM_ВыдачаАвтомобиля.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Renault_CRM_ВыдачаАвтомобиля КАК Renault_CRM_ВыдачаАвтомобиля
	|ГДЕ
	|	Renault_CRM_ВыдачаАвтомобиля.Обращение = &Обращение";
	
	Запрос.УстановитьПараметр("Обращение", Обращение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Документы.Renault_CRM_ВыдачаАвтомобиля.СоздатьДокумент().Ссылка;
	
	
КонецФункции
