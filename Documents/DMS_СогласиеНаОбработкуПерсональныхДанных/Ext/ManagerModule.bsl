
Функция СогласиеНаОбработку(ФизЛицо) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ПустаяСсылка();
	КонецЕсли;
	
	Ссылки = Новый Массив;
	Ссылки.Добавить(ФизЛицо);
	Если ТипЗнч(ФизЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	CRM_ПотенциальныеКонтрагенты.Ссылка
		|ИЗ
		|	Справочник.CRM_ПотенциальныеКонтрагенты КАК CRM_ПотенциальныеКонтрагенты
		|ГДЕ
		|	CRM_ПотенциальныеКонтрагенты.Контрагент = &Ссылка
		|	И НЕ CRM_ПотенциальныеКонтрагенты.ПометкаУдаления";
		Запрос.УстановитьПараметр("Ссылка",ФизЛицо);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ссылки.Добавить(Выборка.Ссылка);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ФизЛицо) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		Ссылки.Добавить(ФизЛицо.Контрагент);
	Иначе
		Возврат Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	DMS_СогласиеНаОбработкуПерсональныхДанных.Ссылка
	|ИЗ
	|	Документ.DMS_СогласиеНаОбработкуПерсональныхДанных КАК DMS_СогласиеНаОбработкуПерсональныхДанных
	|ГДЕ
	|	DMS_СогласиеНаОбработкуПерсональныхДанных.ФизическоеЛицо В(&Ссылки)
	|	И НЕ DMS_СогласиеНаОбработкуПерсональныхДанных.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	DMS_СогласиеНаОбработкуПерсональныхДанных.Дата УБЫВ";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка
	
КонецФункции

Функция ПрочитатьДанные(Ссылка) Экспорт
	
	Структура=Новый Структура;
	Структура.Вставить("Фамилия", Ссылка.ФизическоеЛицо.Фамилия);
	Структура.Вставить("Имя", Ссылка.ФизическоеЛицо.Имя);
	Структура.Вставить("Отчество", Ссылка.ФизическоеЛицо.Отчество);
	Структура.Вставить("Пол", Ссылка.ФизическоеЛицо.Пол);
	Структура.Вставить("ДатаРождения", Формат(Ссылка.ФизическоеЛицо.ДатаРождения, "ДЛФ=Д") + " г.");
	Структура.Вставить("ПаспортНомер", Ссылка.Паспорт.Номер);
	Структура.Вставить("ПаспортСерия", Ссылка.Паспорт.Серия);
	Структура.Вставить("ПаспортОрганВыдачи", Ссылка.Паспорт.КемВыдан);
	Структура.Вставить("ПаспортДатаВыдачи", Формат(Ссылка.Паспорт.ДатаВыдачи, "ДЛФ=Д") + " г.");
	
	//автомобиль
	Запрос=Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	АвтомобилиСрезПоследних.Период,
	|	АвтомобилиСрезПоследних.Автомобиль
	|ИЗ
	|	РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследних
	|ГДЕ
	|	АвтомобилиСрезПоследних.Значение = &ФизЛицо
	|	И АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)";
	Запрос.УстановитьПараметр("ФизЛицо", Ссылка.ФизическоеЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Структура.Вставить("Автомобиль", Выборка.Автомобиль);
		Структура.Вставить("АвтомобильМарка", Выборка.Автомобиль.Модель.Производитель);
		Структура.Вставить("АвтомобильМодель", Выборка.Автомобиль.Модель);
		Структура.Вставить("АвтомобильВариантКомплектации", Выборка.Автомобиль.ВариантКомплектации);
		Структура.Вставить("АвтомобильДатаПокупки", Формат(Выборка.Период, "ДЛФ=Д") + " г.");
		Структура.Вставить("АвтомобильVIN", Выборка.Автомобиль.VIN);
	КонецЕсли;
	
	//контактная информация
	Структура.Вставить("Адрес", КонтактнаяИнформация(Ссылка.ФизическоеЛицо,Перечисления.ТипыКонтактнойИнформации.Адрес));
	Структура.Вставить("Телефоны", КонтактнаяИнформация(Ссылка.ФизическоеЛицо,Перечисления.ТипыКонтактнойИнформации.Телефон,Ложь));
	Структура.Вставить("Email", КонтактнаяИнформация(Ссылка.ФизическоеЛицо,Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты));
	Структура.Вставить("ДилерскийЦентр", Ссылка.ДилерскийЦентр.НаименованиеДляПечати);
	Структура.Вставить("АдресДЦ", Ссылка.ДилерскийЦентр.ОсновнойАдрес);
	Структура.Вставить("Дата", Ссылка.Дата);
	Структура.Вставить("ФизЛицо", "" + Структура.Фамилия + " " + Врег(Лев(Структура.Имя,1)) + ". " + Врег(Лев(Структура.Отчество,1)) + ".");
	
	Возврат	Структура
КонецФункции

Функция КонтактнаяИнформация(Владелец, Тип, Первый=Истина, Вид="")
	Запрос=Новый Запрос("Выбрать "+?(Первый,"Первые 1 ","")+"Представление, 1 Порядок Из РегистрСведений.КонтактнаяИнформация ГДЕ Объект=&Объект И Тип=&Тип "+?(Вид="","","И Вид=&Вид ")+"Упорядочить По ЗначениеПоУмолчанию Убыв");
	Запрос.УстановитьПараметр("Объект",Владелец);
	Запрос.УстановитьПараметр("Тип",Тип);
	Запрос.УстановитьПараметр("Вид",Вид);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Первый Тогда 
		Выборка.Следующий();
		Возврат Выборка.Представление
	Иначе
		Строка="";
		Пока Выборка.Следующий() Цикл Строка=Строка+?(Строка="","",", ")+Выборка.Представление КонецЦикла;
		Возврат Строка
	КонецЕсли;	
КонецФункции

Функция Печать(Ссылка) Экспорт
	
	Если НЕ Ссылка.Проведен Тогда Сообщить("Документ не проведен, печать не возможна"); Возврат Ложь КонецЕсли;
	
	Структура = ПрочитатьДанные(Ссылка);
	ТабДок = Новый ТабличныйДокумент;
	Макет = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ПолучитьМакет("Макет");
	Обл = Макет.ПолучитьОбласть("Шапка");
	Обл.Параметры.Заполнить(Структура);
	ТабДок.Вывести(Обл);
	
	Если Структура.Свойство("Автомобиль") Тогда
		Обл=Макет.ПолучитьОбласть("Автомобиль");
		Обл.Параметры.Заполнить(Структура);
		ТабДок.Вывести(Обл);
	КонецЕсли;	
	
	Обл=Макет.ПолучитьОбласть("Подвал");
	Обл.Параметры.Заполнить(Структура);
	ТабДок.Вывести(Обл);
	
	Возврат ТабДок;
	
КонецФункции

Функция ВернутьСогласиеПоКлиенту(Контрагент) Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	DMS_СогласиеНаОбработкуПерсональныхДанных.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.DMS_СогласиеНаОбработкуПерсональныхДанных КАК DMS_СогласиеНаОбработкуПерсональныхДанных
		|ГДЕ
		|	DMS_СогласиеНаОбработкуПерсональныхДанных.ФизическоеЛицо = &Контрагент
		|	И DMS_СогласиеНаОбработкуПерсональныхДанных.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ПустаяСсылка();

	
	
КонецФункции