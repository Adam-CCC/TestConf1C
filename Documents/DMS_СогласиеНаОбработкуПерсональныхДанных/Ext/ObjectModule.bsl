
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Если СканКопия.Получить() = Неопределено Тогда
	//	Отказ=Истина;
	//	Сообщить("Не приложен скан соглашения",СтатусСообщения.Внимание);
	//	Возврат
	//КонецЕсли;
	
	//Спр=ФизическоеЛицо.ПолучитьОбъект();
	//Спр.СогласиеНаОбработкуПерсональныхДанных=Перечисления.ВариантыОтветов.Да;
	//Спр.СогласиеНаОбработкуПерсональныхДанныхДата=Дата;
	//Спр.Записать();
	
	СсылкаДубль = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ВернутьСогласиеПоКлиенту(ФизическоеЛицо);
	
	Если ЗначениеЗаполнено(СсылкаДубль) и СсылкаДубль<>Ссылка Тогда  
		Сообщить("У клиента уже существует проведенный документ обработки персональных данных "+СсылкаДубль);
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЗаписатьКлиента = Ложь;
	
	КлиентОбъект = ФизическоеЛицо.ПолучитьОбъект();
	
	Если СогласиеНаОбработкуПерсональныхДанных <> ФизическоеЛицо.СогласиеНаОбработкуПерсональныхДанных Тогда
		КлиентОбъект.СогласиеНаОбработкуПерсональныхДанных = СогласиеНаОбработкуПерсональныхДанных;
		КлиентОбъект.СогласиеНаОбработкуПерсональныхДанныхДата = ТекущаяДатаСеанса();
		ЗаписатьКлиента = Истина;
	КонецЕсли;

	Если ТипЗнч(ФизическоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда 
		Если СогласиеНаКоммуникацию <> КлиентОбъект.СогласиеНаПолучениеSMS  Тогда
			КлиентОбъект.СогласиеНаПолучениеSMS = СогласиеНаКоммуникацию;
			//КлиентОбъект.СогласиеНаПолучениеSMSДата = ТекущаяДатаСеанса();
			DMS_ФизическиеЛицаСервер.ЗаписатьСогласиеНаОПД(КлиентОбъект);
			ЗаписатьКлиента = Истина;
		КонецЕсли;
	Иначе 
		Если СогласиеНаКоммуникацию <> КлиентОбъект.СогласенНаКоммуникацию  Тогда
			КлиентОбъект.СогласенНаКоммуникацию = СогласиеНаКоммуникацию;
			ЗаписатьКлиента = Истина;
		КонецЕсли;
	КонецЕсли;

	КлиентОбъект.Записать();

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Спр=ФизическоеЛицо.ПолучитьОбъект();
	Спр.СогласиеНаОбработкуПерсональныхДанных=Перечисления.ВариантыОтветов.Спрашивать;
	Спр.СогласиеНаОбработкуПерсональныхДанныхДата="";
	Спр.Записать();
	
КонецПроцедуры

