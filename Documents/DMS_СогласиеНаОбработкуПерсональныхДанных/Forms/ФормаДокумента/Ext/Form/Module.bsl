
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда 
		Объект.ДилерскийЦентр=ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр;
	КонецЕсли;
	
	Если Параметры.Свойство("Клиент") Тогда 
		Объект.ФизическоеЛицо = Параметры.Клиент;
	КонецЕсли;		
	
	//ОбновитьДанныеПоКлиенту = Истина;
	
	//контакты
	Эл=КонтактнаяИнформация.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	Эл.Использование=Истина;
	Эл.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
	Эл.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Объект");
	Эл.ПравоеЗначение=Объект.ФизическоеЛицо;
	
	//тачки
	Эл=Автомобили.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	Эл.Использование=Истина;
	Эл.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
	Эл.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Значение");
	Эл.ПравоеЗначение=Объект.ФизическоеЛицо;
	
	//сканы
	Эл=СканыДокументов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	Эл.Использование=Истина;
	Эл.ВидСравнения=ВидСравненияКомпоновкиДанных.Равно;
	Эл.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Объект");
	Эл.ПравоеЗначение=Объект.ФизическоеЛицо;
	
	Если НЕ Объект.Ссылка.Пустая() Тогда 
		ОбновитьДанныеПоКлиенту = Истина; //Сергеев В. Н. DMSREN-1020
		ЗаполнитьЗначенияСвойств(ЭтаФорма,ПрочитатьДанные());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ОбновитьДанныеПоКлиенту Тогда 
		Перезаполнить("");	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
		ЗаполнитьСогласияИОтображениеСогласий();
	КонецЕсли;
	
	ОбновитьДоступностьПечати();
КонецПроцедуры

&НаКлиенте
Процедура Перезаполнить(Элемент)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма,ПрочитатьДанные());
	
	ЗаполнитьСогласияИОтображениеСогласий();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСогласияИОтображениеСогласий()
	
	Если ТипЗнч(Объект.ФизическоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда 
		//Элементы.ГруппаКоммуникация.Видимость = Истина;
		//Элементы.ГруппаОПД.Видимость = Истина;
		Элементы.ГруппаСервисы.Видимость = Истина;
		
		Если Объект.СогласиеНаКоммуникацию <> Объект.ФизическоеЛицо.СогласиеНаПолучениеSMS или
			Объект.СогласиеНаОбработкуПерсональныхДанных <> Объект.ФизическоеЛицо.СогласиеНаОбработкуПерсональныхДанных Тогда 
			ЭтаФорма.Модифицированность = Истина;
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
				ПоказатьПредупреждение(,"Данные в документе по согласию были изменены по карточке контрагента");
			КонецЕсли;
		КонецЕсли;
		
		Объект.СогласиеНаОбработкуПерсональныхДанных = Объект.ФизическоеЛицо.СогласиеНаОбработкуПерсональныхДанных;
		Объект.СогласиеНаКоммуникацию = Объект.ФизическоеЛицо.СогласиеНаПолучениеSMS;
		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда 
			Объект.СогласиеНаПодключаемыеСервисы = Ложь;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект.ФизическоеЛицо) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		Элементы.ГруппаСервисы.Видимость = Ложь;
		
		Если Объект.СогласиеНаКоммуникацию <> Объект.ФизическоеЛицо.СогласенНаКоммуникацию или
			Объект.СогласиеНаОбработкуПерсональныхДанных <> Объект.ФизическоеЛицо.СогласиеНаОбработкуПерсональныхДанных Тогда 
			ЭтаФорма.Модифицированность = Истина;
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда 
				ПоказатьПредупреждение(,"Данные в документе по согласию были изменены по карточке клиента");
			КонецЕсли;		
		КонецЕсли;
		
		Объект.СогласиеНаОбработкуПерсональныхДанных = Объект.ФизическоеЛицо.СогласиеНаОбработкуПерсональныхДанных;
		Объект.СогласиеНаКоммуникацию = Объект.ФизическоеЛицо.СогласенНаКоммуникацию;
		Объект.СогласиеНаПодключаемыеСервисы = Ложь;
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьДанные()
	
	Возврат Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ПрочитатьДанные(Объект);
	
КонецФункции

&НаКлиенте
Процедура кнОбновитьДанныеКлиента(Команда)
	
	Перезаполнить("");
	
КонецПроцедуры

//#Область Печать
&НаКлиенте
Процедура кнПечать(Команда)
	
	Макет=Печать();
	Если Макет=Ложь Тогда Возврат КонецЕсли;
	Форма=ПолучитьФорму("ОбщаяФорма.ПечатнаяФормаДокументов",,УникальныйИдентификатор);
	Форма.Объект=Объект.Ссылка;
	Форма.ЭлементыФормы.ТабличныйДокумент.Вывести(Макет);
	Форма.ИзменятьСпособОтображенияОкна=ИзменениеСпособаОтображенияОкна.Разрешить;
	Форма.Открыть();
	
КонецПроцедуры

Функция Печать()
	
	Возврат Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.Печать(Объект.Ссылка);
	
КонецФункции

&НаКлиенте
Процедура кнПечатьСкана(Команда)
	
	ИмяФайла = "";
	Если ПолучитьСкан(ИмяФайла) Тогда
		ЗапуститьПриложение(ИмяФайла);
	Иначе
		Предупреждение("Необходимо провести документ!");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСкан(ИмяФайла)
	
	Если НЕ Объект.Проведен Тогда Возврат Ложь КонецЕсли;
	ИмяФайла = ПолучитьИмяВременногоФайла(Объект.ТипФайла);
	Если АдресСкана <> "" Тогда
		ПолучитьИзВременногоХранилища(АдресСкана).Записать(ИмяФайла);
	Иначе
		Объект.Ссылка.ПолучитьОбъект().СканКопия.Получить().Записать(ИмяФайла);
	КонецЕсли;
	Возврат Истина;
	
КонецФункции
//#КонецОбласти

//#Область ЗагрузитьФайл
&НаКлиенте
Процедура кнПрикрепитьСкан(Команда)
	
	#Если ВебКлиент Тогда
	Если не ПодключитьРасширениеРаботыСФайлами() Тогда  //если подключить не удалось - требуется установить его (в первый раз)
		УстановитьРасширениеРаботыСФайлами();
		//если не удалось установить - то повторный вызов подключения будет неудачный
		Если не ПодключитьРасширениеРаботыСФайлами() Тогда
			ВызватьИсключение "Ошибка. Ваш браузер не поддерживает работу с файлами :(";
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ОбработкаВыборФайла",ЭтотОбъект),,,Истина,УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыборФайла(Результат,Адрес,ВыбранноеИмяФайла,ДопПараметры) Экспорт 
	
	Если Результат Тогда 
