&НаКлиенте
Процедура ПечатьСогласияНаОПДИКоммуникации(Команда)
	
	Если Не Объект.Проведен Тогда 
		Сообщить("Необходимо провести документ");
		Возврат;	
	КонецЕсли;
	
	Если ТипЗнч(Объект.ФизическоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда 
		ПечатьОПДДляКонтрагента("ПерсональныеДанные",Истина);
	Иначе
		ПечатьОПДДляПотеницальногоКонтрагента("ПерсональныеДанные",Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьОПДДляКонтрагента(ВидСогласия,Согласие)
	Ошибка = Ложь;
	Попытка
		СтруктураПараметровОПД = ЗаполнитьДанныеПоКонтрагенту(ВидСогласия,Согласие);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	МассивФайловОПД = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровОПД,Объект.ФизическоеЛицо);
	
	Если МассивФайловОПД = Неопределено Тогда 
		ПоказатьПредупреждение(,"Не удалось получить печатную форму");
	Иначе 
		Для каждого Файл Из МассивФайловОПД Цикл
			НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьОПДДляПотеницальногоКонтрагента(ВидСогласия,Согласие)
	Ошибка = Ложь;
	
	СтруктураПараметровОПД = ЗаполнитьДанныеПоПотенциальномуКлиенту(ВидСогласия,Согласие);
	
	МассивФайловОПД = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровОПД,Объект.ФизическоеЛицо);
	
	Если МассивФайловОПД = Неопределено Тогда 
		ПоказатьПредупреждение(,"Не удалось получить печатную форму");
	Иначе 
		Для каждого Файл Из МассивФайловОПД Цикл
			НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьОПДДляПотенциальногоКонтрагента()
	Ошибка = Ложь;
	Попытка
		СтруктураПараметровОПД = ЗаполнитьДанныеПоПотенциальномуКлиенту("ПерсональныеДанные",Истина);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	МассивФайловОПД = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровОПД,Объект.ФизическоеЛицо);
	
	Если МассивФайловОПД = Неопределено Тогда 
		ПоказатьПредупреждение(,"Не удалось получить печатную форму обработки персональных данных");
	Иначе 
		Для каждого Файл Из МассивФайловОПД Цикл
			НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДанныеПоКонтрагенту(ВидСогласия,Согласие)
	
	СтруктураОбъекта = Новый Структура;
	СтруктураКлиента = Новый Структура;
	СтруктураДокумента = Новый Структура;
	СтруктураАвтомобиля = Новый Структура;
	СтруктураСогласия = Новый Структура;
	СтруктураОтвветсвенный = Новый Структура;
	
	Если Не Объект.Паспорт.Текущий Тогда 
		ВызватьИсключение("Нет данных актуального паспорта");
	КонецЕсли;
	
	СтруктураДокумента.Вставить("passportnumber",Объект.Паспорт.Номер);
	СтруктураДокумента.Вставить("passportseries",Объект.Паспорт.Серия);
	СтруктураДокумента.Вставить("passportissued",Объект.Паспорт.КемВыдан); 
	СтруктураДокумента.Вставить("passportday",День(Объект.Паспорт.ДатаВыдачи));
	СтруктураДокумента.Вставить("passportmonth",Месяц(Объект.Паспорт.ДатаВыдачи));
	СтруктураДокумента.Вставить("passportyear",Год(Объект.Паспорт.ДатаВыдачи));
	
	СтруктураДанных = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ПрочитатьДанные(Объект);
	
	СтруктураКлиента.Вставить("lastname",Объект.ФизическоеЛицо.Фамилия);
	СтруктураКлиента.Вставить("firstname",Объект.ФизическоеЛицо.Имя);
	СтруктураКлиента.Вставить("middlename",Объект.ФизическоеЛицо.Отчество);
	СтруктураКлиента.Вставить("birthday",Объект.ФизическоеЛицо.ДатаРождения);
	СтруктураКлиента.Вставить("gender",?(Объект.ФизическоеЛицо.Пол=Перечисления.ПолФизическихЛиц.НеУказан,"",""+Объект.ФизическоеЛицо.Пол));
	СтруктураКлиента.Вставить("address",СтруктураДанных.Адрес);
	СтруктураКлиента.Вставить("tel",СтруктураДанных.Телефоны);
	СтруктураКлиента.Вставить("email",СтруктураДанных.Email);
	СтруктураКлиента.Вставить("company",?(Объект.ФизическоеЛицо.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо,Истина,Ложь));
	СтруктураКлиента.Вставить("document",СтруктураДокумента);
	СтруктураОбъекта.Вставить("client",СтруктураКлиента);
	
	СтруктураАвтомобиля.Вставить("mark","");
	СтруктураАвтомобиля.Вставить("vin","");
	СтруктураАвтомобиля.Вставить("daybuycar",Дата('00010101'));
	СтруктураОбъекта.Вставить("auto",СтруктураАвтомобиля);
	
	СтруктураСогласия.Вставить("form",ВидСогласия);
	СтруктураСогласия.Вставить("agree",Согласие);
	СтруктураОбъекта.Вставить("consent",СтруктураСогласия);
	
	СтруктураОтвветсвенный.Вставить("name",""+ПараметрыСеанса.Пользователь.Сотрудник);
	СтруктураОтвветсвенный.Вставить("from","Форма документа согласия на опд");
	СтруктураОбъекта.Вставить("responsible",СтруктураОтвветсвенный);
	
	Возврат СтруктураОбъекта;
	
КонецФункции

&НаСервере
Функция ЗаполнитьДанныеПоПотенциальномуКлиенту(ВидСогласия,Согласие)
	СтруктураОбъекта = Новый Структура;
	СтруктураКлиента = Новый Структура;
	СтруктураДокумента = Новый Структура;
	СтруктураАвтомобиля = Новый Структура;
	СтруктураСогласия = Новый Структура;
	СтруктураОтвветсвенный = Новый Структура;
		
	СтруктураДанных = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ПрочитатьДанные(Объект);

	СтруктураДокумента.Вставить("passportnumber",ПаспортСерия);
	СтруктураДокумента.Вставить("passportseries",ПаспортНомер);
	СтруктураДокумента.Вставить("passportissued",ПаспортОрганВыдачи); 
	СтруктураДокумента.Вставить("passportday",День(ПаспортДатаВыдачи));
	СтруктураДокумента.Вставить("passportmonth",Месяц(ПаспортДатаВыдачи));
	СтруктураДокумента.Вставить("passportyear",Год(ПаспортДатаВыдачи));

	СтруктураКлиента.Вставить("lastname",Объект.ФизическоеЛицо.Фамилия);
	СтруктураКлиента.Вставить("firstname",Объект.ФизическоеЛицо.Имя);
	СтруктураКлиента.Вставить("middlename",Объект.ФизическоеЛицо.Отчество);
	СтруктураКлиента.Вставить("birthday",Объект.ФизическоеЛицо.ДатаРождения);
	СтруктураКлиента.Вставить("gender",?(Объект.ФизическоеЛицо.Пол=Перечисления.ПолФизическихЛиц.НеУказан,"",""+Объект.ФизическоеЛицо.Пол));
	СтруктураКлиента.Вставить("address",СтруктураДанных.Адрес);
	СтруктураКлиента.Вставить("tel",СтруктураДанных.Телефоны);
	СтруктураКлиента.Вставить("email",СтруктураДанных.Email);
	СтруктураКлиента.Вставить("company",?(Объект.ФизическоеЛицо.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо,Истина,Ложь));
	СтруктураКлиента.Вставить("document",СтруктураДокумента);
	СтруктураОбъекта.Вставить("client",СтруктураКлиента);

	СтруктураАвтомобиля.Вставить("mark","");
	СтруктураАвтомобиля.Вставить("vin","");
	СтруктураАвтомобиля.Вставить("daybuycar",Дата('00010101'));
	СтруктураОбъекта.Вставить("auto",СтруктураАвтомобиля);
	
	СтруктураСогласия.Вставить("form",ВидСогласия);
	СтруктураСогласия.Вставить("agree",Согласие);
	СтруктураОбъекта.Вставить("consent",СтруктураСогласия);
	
	СтруктураОтвветсвенный.Вставить("name",""+ПараметрыСеанса.Пользователь.Сотрудник);
	СтруктураОтвветсвенный.Вставить("from","Форма документа согласия на опд");
	СтруктураОбъекта.Вставить("responsible",СтруктураОтвветсвенный);
	
	Возврат СтруктураОбъекта;

	
КонецФункции

&НаКлиенте
Процедура ПечатьСогласияНаКоммуникацию(Команда)
	
	Если Не Объект.Проведен Тогда 
		Сообщить("Необходимо провести документ");
		Возврат;	
	КонецЕсли;
	
	Если ТипЗнч(Объект.ФизическоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда 
		ПечатьОПДДляКонтрагента("Коммуникация",Истина);
	Иначе
		ПечатьОПДДляПотеницальногоКонтрагента("Коммуникация",Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьСогласияНаСервисы(Команда)
	
	Если Не Объект.Проведен Тогда 
		Сообщить("Необходимо провести документ");
		Возврат;	
	КонецЕсли;
	
	Попытка
		СтруктураПараметровСервисы = ЗаполнитьДанныеПоКонтрагенту("Сервисы",Истина);
		
		ДанныеСервисы = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровСервисы,Объект.ФизическоеЛицо);
		
		Если ДанныеСервисы = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось получить печатную форму на подключение сервисов");
		Иначе 
			Для каждого Файл Из ДанныеСервисы Цикл
				НачатьПолучениеФайлаССервера(ПоместитьВоВременноеХранилище(Base64Значение(Файл["ДанныеФайла"])), Файл["ИмяФайла"], Новый ПараметрыДиалогаПолученияФайлов());
			КонецЦикла;	
		КонецЕсли;
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СогласиеОПДПриИзменении(Элемент)
	
	Если Объект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да Тогда
		Элементы.ПечатьОПД.Доступность = Истина;
		Возврат;
	Иначе 
		Элементы.ПечатьОПД.Доступность = Ложь;
		Если Объект.СогласиеНаКоммуникацию Тогда 
			Объект.СогласиеНаКоммуникацию = Ложь;
			СогласиеКоммуникацияПриИзменении(Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Объект.ФизическоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда 
		ОтозватьОПДПоКонтрагенту("ПерсональныеДанные","Согласие на обработку персональных данных будет отозвано. Продолжить?");
	Иначе
		ОтозватьОпдДляПотенциальногоКонтрагента("ПерсональныеДанные","Согласие на обработку персональных данных будет отозвано. Продолжить?");
	КонецЕсли;

	ОбновитьДоступностьПечати();
КонецПроцедуры

&НаКлиенте
Процедура СогласиеКоммуникацияПриИзменении(Элемент)
	
	Если Объект.СогласиеНаКоммуникацию Тогда
		Объект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да;
		ОбновитьДоступностьПечати();
		Возврат;
	Иначе 
		Элементы.ПечатьСогласияНаКоммуникацию.Доступность = Ложь;
	КонецЕсли;

	Если ТипЗнч(Объект.ФизическоеЛицо) = Тип("СправочникСсылка.Контрагенты") Тогда 
		ОтозватьОПДПоКонтрагенту("Коммуникация","Согласие на коммуникацию будет отозвано. Продолжить?");
	Иначе
		ОтозватьОпдДляПотенциальногоКонтрагента("Коммуникация","Согласие на коммуникацию будет отозвано. Продолжить?");
	КонецЕсли;

	ОбновитьДоступностьПечати();
	
КонецПроцедуры

&НаКлиенте
Процедура СогласиеСервисыПриИзменении(Элемент)

	Если Объект.СогласиеНаПодключаемыеСервисы Тогда
		Элементы.ПечатьСервисы.Доступность = Истина;
		Возврат;
	Иначе 
		Элементы.ПечатьСервисы.Доступность = Ложь;
	КонецЕсли;

	ОтозватьОПДПоКонтрагенту("Сервисы","Согласие на подключаемые сервисы данных будет отозвано. Продолжить?");
	
	ОбновитьДоступностьПечати();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтозватьОПДПоКонтрагенту(ВидСогласия,ТекстВопроса)
	
	Ответ = Вопрос(ТекстВопроса,РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Нет);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Попытка
			СтруктураПараметровОПД = ЗаполнитьДанныеПоКонтрагенту(ВидСогласия,Ложь);
			
			ДанныеОПД = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровОПД,Объект.ФизическоеЛицо);
			
			Если ДанныеОПД = Неопределено Тогда 
				ПоказатьПредупреждение(,"Не удалось отозвать согласие.");
			Иначе
				ПоказатьПредупреждение(,ДанныеОПД["answer"]);
			КонецЕсли;
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;		
	Иначе
		Если ВидСогласия = "ПерсональныеДанные" Тогда 
			Объект.СогласиеНаОбработкуПерсональныхДанных = СохранениеСогласияОПД;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтозватьОпдДляПотенциальногоКонтрагента(ВидСогласия,ТекстВопроса)

	Ответ = Вопрос(ТекстВопроса,РежимДиалогаВопрос.ДаНетОтмена,,КодВозвратаДиалога.Нет);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		СтруктураПараметровОПД = ЗаполнитьДанныеПоПотенциальномуКлиенту("ПерсональныеДанные",Ложь);
		
		ДанныеОПД = DMS_ОбщегоНазначенияСервер.ПолучитьДанныеОПД(СтруктураПараметровОПД,Объект.ФизическоеЛицо);
		
		Если ДанныеОПД = Неопределено Тогда 
			ПоказатьПредупреждение(,"Не удалось отозвать согласие.");
		Иначе
			ПоказатьПредупреждение(,ДанныеОПД["answer"]);
		КонецЕсли;
	Иначе 
		Если ВидСогласия = "ПерсональныеДанные" Тогда 
			Объект.СогласиеНаОбработкуПерсональныхДанных = СохранениеСогласияОПД;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СогласиеОПДНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СохранениеСогласияОПД = Объект.СогласиеНаОбработкуПерсональныхДанных;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьПечати()
	
	Если Объект.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да Тогда
		Элементы.ПечатьОПД.Доступность = Истина;
	Иначе 
		Элементы.ПечатьОПД.Доступность = Ложь;
	КонецЕсли;
	
	Элементы.ПечатьСогласияНаКоммуникацию.Доступность = Объект.СогласиеНаКоммуникацию;
	Элементы.ПечатьСервисы.Доступность = Объект.СогласиеНаПодключаемыеСервисы;

КонецПроцедуры

//#КонецОбласти
