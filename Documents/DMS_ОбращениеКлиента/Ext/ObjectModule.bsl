Функция ПодготовитьТекстНапоминания(Ссылка,Стр,ТекстНапоминания);
	
	ДатаОкончания = Стр.ДатаПланируемая + Час(Стр.Действие.ДлительностьДействия) * 60 * 60 + Минута(Стр.Действие.ДлительностьДействия) * 60 + Секунда(Стр.Действие.ДлительностьДействия);
	Текст = СтрЗаменить(ТекстНапоминания,"&НомерОбращения",Ссылка.Номер);
	Текст = СтрЗаменить(Текст,"&ДатаОбращения",Ссылка.Дата);
	Текст = СтрЗаменить(Текст,"&ДатаОкончания",Строка(ДатаОкончания));
	Текст = СтрЗаменить(Текст,"&ДатаПланируемая",Строка(Стр.ДатаПланируемая));
	Текст = СтрЗаменить(Текст,"&Фамилия",Ссылка.Контрагент.Фамилия);
	Текст = СтрЗаменить(Текст,"&Имя",Ссылка.Контрагент.Имя);
	Текст = СтрЗаменить(Текст,"&Отчество",Ссылка.Контрагент.Отчество);
	Текст = СтрЗаменить(Текст,"&Исполнитель",Стр.Исполнитель);
	Возврат Текст;
	
КонецФункции 

