Перем КоличествоСтрокДоЗаписи;

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПриЗаписи(Отказ)         	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
		//запишем изменения пробега и ГосНомера
	Если ЗначениеЗаполнено(Автомобиль) тогда
		ТекПробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
		ТекПробег = ?(ТекПробег = Неопределено, 0, ТекПробег);
		Если Пробег < ТекПробег тогда
			Сообщить("Вы указали пробег автомобиля меньше существующего!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	Подсистема_ОбащенияКлиентов = Справочники.DMS_Подсистемы.ОбращенияКлиентов;
	
	Для каждого Стр из ДействияПоОбращению цикл
		
		// добавляем в регистр событий оповещния только для новых записей в обращении 
		Если Стр.НомерСтроки > КоличествоСтрокДоЗаписи 
			и не ЗначениеЗаполнено(стр.ДатаВыполнения) 
			и стр.Действие.ИспользоватьОповещение тогда
				
				Для каждого Оповещение из стр.Действие.Оповещения цикл
					
					СмещениеВСекундах = Час(Оповещение.МоментОповещения)*60*60+ Минута(Оповещение.МоментОповещения)*60 + Секунда(Оповещение.МоментОповещения);
					
					Если СмещениеВСекундах <> 0 и (Стр.ДатаПланируемая - СмещениеВСекундах) < ТекущаяДата() тогда
						Продолжить; // не будем делать оповещния для событий в прошлом времени.
					КонецЕсли;
					
					НомерСобытия = DMS_ОбращенияКлиентов.ПолучитьНомерСобытия();
					
					Набор = РегистрыСведений.dms_ЖурналСобытий.СоздатьНаборЗаписей();
					Набор.Отбор.Подсистема.Установить(Подсистема_ОбащенияКлиентов);
					Набор.Отбор.Событие.Установить(стр.Действие);
					Набор.Отбор.СпособОповещения.Установить(Оповещение.СпособОповещения);
					Набор.Отбор.РегистраторСобытия.Установить(Ссылка);
					Набор.Отбор.НомерСобытия.Установить(НомерСобытия);
					
					Запись = Набор.Добавить();
					Запись.Подсистема = Подсистема_ОбащенияКлиентов;
					Запись.Событие = Стр.Действие;
					Запись.СпособОповещения = Оповещение.СпособОповещения;
					Запись.РегистраторСобытия = Ссылка;
					Запись.НомерСобытия = НомерСобытия;
					Запись.Клиент = Контрагент;
					
					Запись.ДатаОповещения = Стр.ДатаПланируемая - СмещениеВСекундах;
					Запись.ТекстОповещения = ПодготовитьТекстНапоминания(Ссылка, Стр,Оповещение.ШаблонОповещения); 
					
					Если Оповещение.ПолучательОповещения = Перечисления.DMS_ПолучателиОповещения.Исполнитель тогда
						Запись.ОбъектОповещения = Стр.Исполнитель;	
					ИначеЕсли Оповещение.ПолучательОповещения = Перечисления.DMS_ПолучателиОповещения.Клиент тогда
						Запись.ОбъектОповещения = Контрагент;
					КонецЕсли;
					Запись.Приоритет= Ссылка.Приоритет;
					
					Набор.Записать(Истина);

				КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	
	
	//запишем изменения пробега и ГосНомера
	Если ЗначениеЗаполнено(Автомобиль) тогда
		
		ТекПробег = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
		ТекПробег = ?(ТекПробег = Неопределено, 0, ТекПробег);
		Если Пробег > ТекПробег тогда
			Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(Автомобиль, Пробег,Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег,ТекущаяДата());
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГосНомер) тогда
			Если ГосНомер <> Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер) тогда
				Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(Автомобиль, ГосНомер,Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер,ТекущаяДата());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)      	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Для каждого Стр из ДействияПоОбращению цикл
		
		Если не ЗначениеЗаполнено(Стр.ДатаПланируемая) тогда
			
			Сообщить("Необходимо указать планируемую дату для действия """+ Стр.Действие+ """");
			Отказ = Истина;
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;		
	
	КоличествоСтрокДоЗаписи = Ссылка.ДействияПоОбращению.Количество();
	
	
	Если ДействияПоОбращению.Количество()=0 
		или ДействияПоОбращению.Получить(0).Действие <> Справочники.DMS_ДействияПоОбращениям.НазначитьИсполнителя тогда
		Сообщить("Для сохранения обращения необходимо указать первое действие ""Назначить исполнителя""");
		Отказ = Истина;
		Возврат;
	КонецЕсли;		
	
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		Если ЗначениеЗаполнено(ГосНомер) тогда
			Если ПроверкаГосНомера(ГосНомер) тогда
				Сообщить("Ошибка гос. номер может содержать только цифры и буквы латинского алфавита.");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


