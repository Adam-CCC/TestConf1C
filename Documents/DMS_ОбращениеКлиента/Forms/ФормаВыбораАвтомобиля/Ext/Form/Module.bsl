Процедура ПриОткрытии(Отказ)
	
		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьАвто(Контрагент)
	
	СписокКлиентов = Новый СписокЗначений;
	СписокКлиентов.Добавить(Контрагент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Renault_ПрофилиКлиентовКлиенты1.Клиент КАК Контрагент
		|ИЗ
		|	Справочник.Renault_ПрофилиКлиентов.Клиенты КАК Renault_ПрофилиКлиентовКлиенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПрофилиКлиентов.Клиенты КАК Renault_ПрофилиКлиентовКлиенты1
		|		ПО Renault_ПрофилиКлиентовКлиенты.Ссылка = Renault_ПрофилиКлиентовКлиенты1.Ссылка
		|ГДЕ
		|	Renault_ПрофилиКлиентовКлиенты.Клиент = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокКлиентов.Добавить(Выборка.Контрагент);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль,
	               |	АвтомобилиСрезПоследнихГосНомера.Значение КАК ГосНомер,
	               |	АвтомобилиСрезПоследних.Автомобиль.VIN как VIN,
	               |	Renault_ВыполнениеТОСрезПоследних.ДатаПлан КАК ДатаСледующегоТО
	               |ИЗ
	               |	РегистрСведений.Автомобили.СрезПоследних(, ) КАК АвтомобилиСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ВыполнениеТО.СрезПоследних КАК Renault_ВыполнениеТОСрезПоследних
	               |		ПО АвтомобилиСрезПоследних.Автомобиль = Renault_ВыполнениеТОСрезПоследних.Автомобиль
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК АвтомобилиСрезПоследнихГосНомера
	               |		ПО АвтомобилиСрезПоследних.Автомобиль = АвтомобилиСрезПоследнихГосНомера.Автомобиль
	               |			И (АвтомобилиСрезПоследнихГосНомера.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер))
	               |ГДЕ
	               |	АвтомобилиСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)
	               |	И АвтомобилиСрезПоследних.Значение В(&СписокКлиентов)
	               |	И (Renault_ВыполнениеТОСрезПоследних.ДатаФакт = ДатаВремя(1,1,1)
	               |			ИЛИ Renault_ВыполнениеТОСрезПоследних.ДатаФакт ЕСТЬ NULL )
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	АвтомобилиСрезПоследних.Период УБЫВ";
				   
				   
	Запрос.УстановитьПараметр("СписокКлиентов", СписокКлиентов);
	
	ЗначениеВДанныеФормы(Запрос.Выполнить().Выгрузить(), ВсеАвтомобили);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВладелецАвто = Параметры.Клиент;
	Если Не ЗначениеЗаполнено(ВладелецАвто) Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьАвто(ВладелецАвто);
	
КонецПроцедуры

&НаКлиенте
Процедура ВсеАвтомобилиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		Парам = Новый Структура();
		//Парам.Вставить("Основание", Параметры.Основание);
		Парам.Вставить("Автомобиль",Элемент.ТекущиеДанные.Автомобиль);
		Оповестить("ВыбранАвтомобиль",Парам,ЭтаФорма);
		ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьАвтомобиль(Команда)
	
	
	П = Новый Структура();
	ФормаАвто = ОткрытьФорму("Справочник.Автомобили.ФормаОбъекта");
	ФормаАвто.Хозяин = ВладелецАвто;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
Если ИмяСобытия = "АвтомобильИзменен" тогда
	Если Не ЗначениеЗаполнено(ВладелецАвто) Тогда
		Возврат;
	КонецЕсли;
	ПрочитатьАвто(ВладелецАвто);
КонецЕсли;

КонецПроцедуры
