&НаСервере
Функция ДоступноПраво(НазваниеПрава) Экспорт
	
	ПараметрОтбора = Новый Структура("ИмяПрава","ПолныеПрава");
	Если НаборПравПользователя.НайтиСтроки(ПараметрОтбора).Количество() > 0 тогда 
		Возврат Истина;
	Иначе
		ПараметрОтбора = Новый Структура("ИмяПрава",НазваниеПрава);
		Если НаборПравПользователя.НайтиСтроки(ПараметрОтбора).Количество() > 0 тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


&НаСервере
Процедура НастройкаДоступностиФормы(Отказ)
 	
	
	
	Если НЕ ДоступноПраво("ПравоНаПросмотр")
		и НЕ ДоступноПраво("ПравоНаРедактирование")
		тогда
		Сообщить("Недостаточно прав для создания и просмотра обращения клиента!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ДоступноПраво("ПравоНаПросмотр")
		и НЕ ДоступноПраво("ПравоНаРедактирование")
		тогда
		Если Объект.Ссылка.Пустая() тогда
			Сообщить("Недостаточно прав для создания обращения клиента");
 		 	Отказ = Истина;
			Возврат;
		иначе
			ЭтаФорма.ТолькоПросмотр = Истина;
			Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЭтаФорма.ТолькоПросмотр Тогда
	   Если Объект.СтатусОбращения = Перечисления.DMS_СтатусыОбращения.Закрыто и НЕ ДоступноПраво("ПравоНаЗакрытие") тогда
			ЭтаФорма.ТолькоПросмотр = Истина;
			Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = Ложь;
	   КонецЕсли;   
	КонецЕсли;
	
	Если Не ЭтаФорма.ТолькоПросмотр Тогда
		Если Объект.ТипОбращения = Справочники.DMS_ТипыОбращений.Гарантия тогда
			ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ТипОбращенияГарантия");
			Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
		ИначеЕсли Объект.ТипОбращения = Справочники.DMS_ТипыОбращений.Сервис тогда
			ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ТипОбращенияСервис");
			Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
		ИначеЕсли Объект.ТипОбращения = Справочники.DMS_ТипыОбращений.Продажа тогда
			ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ТипОбращенияПродажа");
			Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьНаборПравПользователя()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Право,
		|	Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Право.Код КАК ИмяПрава
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПраваИНастройкиПользователей.ОбращенияКлиентов КАК Renault_ПраваИНастройкиПользователейОбращенияКлиентов
		|		ПО Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки = Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Ссылка
		|			И (Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь)
		|			И (Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Доступность = ИСТИНА)
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Справочники.Пользователи.НайтиПоКоду(ПользователиИнформационнойБазы.ТекущийПользователь().Имя));
	
	НаборПравПользователя.Загрузить(Запрос.Выполнить().Выгрузить());
	Для Каждого стр из НаборПравПользователя цикл
		Стр.ИмяПрава = Справочники.DMS_ПраваРолейПоОбращениям.ПолучитьИмяПредопределенного(Стр.Право);
	КонецЦикла;
	

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьНаборПравПользователя();
	
	НастройкаДоступностиФормы(Отказ);
	УстановитьВидимостьПолейПоТипуОбращения();
	//Начальное заполнение
	Если Объект.Ссылка.Пустая() тогда
		
		Объект.СтатусОбращения = Перечисления.DMS_СтатусыОбращения.Открыто;
		Объект.Дата = ТекущаяДата();
		стрДействия = Объект.ДействияПоОбращению.Добавить();
		стрДействия.Действие = Справочники.DMS_ДействияПоОбращениям.НазначитьИсполнителя;
		стрДействия.ДатаПланируемая = Объект.Дата;
		стрДействия.Исполнитель = Справочники.Пользователи.НайтиПоКоду(ПользователиИнформационнойБазы.ТекущийПользователь().Имя).Сотрудник;
		Объект.Приоритет = Справочники.DMS_Приоритет.Нормальный;
		
		Если Параметры.Свойство("Автомобиль") Тогда
			ЗаполнитьЗначенияСвойств(Объект, Параметры);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьНашеПоследнееОбращение(МассивКлиентов); 
	
	СтруктураВозврата = Новый Структура("Дата,Причина");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Renault_Трафик.Период КАК Дата,
	               |	NULL КАК Ид,
	               |	Renault_Трафик.ТипТрафика КАК Событие,
	               |	"""" КАК Примечание,
	               |	Renault_Трафик.Менеджер
	               |ИЗ
	               |	РегистрСведений.Renault_Трафик КАК Renault_Трафик
	               |ГДЕ
	               |	Renault_Трафик.Клиент В(&МассивКлиентов)
	               |	И Renault_Трафик.Отдел.ПродажаАвтомобилей = ИСТИНА
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Renault_РабочиеЛисты.ДатаID,
	               |	Renault_РабочиеЛисты.IDK,
	               |	""Рабочий лист"",
	               |	"""",
	               |	Renault_РабочиеЛисты.Сотрудник
	               |ИЗ
	               |	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	               |ГДЕ
	               |	Renault_РабочиеЛисты.Клиент В(&МассивКлиентов)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	CRM_КоммерческоеПредложениеСостав.Ссылка.Дата,
	               |	CRM_КоммерческоеПредложениеСостав.Ссылка,
	               |	""Коммерческое предложение"",
	               |	CRM_КоммерческоеПредложениеСостав.Конфигурация.Модель,
	               |	Renault_РабочиеЛисты.Сотрудник
	               |ИЗ
	               |	Документ.CRM_КоммерческоеПредложение.Состав КАК CRM_КоммерческоеПредложениеСостав
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	               |		ПО CRM_КоммерческоеПредложениеСостав.Ссылка.РабочийЛист = Renault_РабочиеЛисты.IDK
	               |ГДЕ
	               |	Renault_РабочиеЛисты.Клиент В(&МассивКлиентов)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	CRM_ЗаписиНаТестДрайв.ДатаНачала,
	               |	CRM_ЗаписиНаТестДрайв.IDK,
	               |	""Тест-драйв"",
	               |	CRM_ЗаписиНаТестДрайв.Автомобиль.Модель,
	               |	Renault_РабочиеЛисты.Сотрудник
	               |ИЗ
	               |	РегистрСведений.CRM_ЗаписиНаТестДрайв КАК CRM_ЗаписиНаТестДрайв
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	               |		ПО CRM_ЗаписиНаТестДрайв.IDK = Renault_РабочиеЛисты.IDK
	               |ГДЕ
	               |	Renault_РабочиеЛисты.Клиент В(&МассивКлиентов)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Renault_Договор.Дата,
	               |	Renault_Договор.Ссылка,
	               |	""Договор на продажу а/м"",
	               |	Renault_Договор.СтатусДоговора,
	               |	Renault_РабочиеЛисты.Сотрудник
	               |ИЗ
	               |	Документ.Renault_Договор КАК Renault_Договор
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	               |		ПО Renault_Договор.РабочийЛист = Renault_РабочиеЛисты.IDK
	               |ГДЕ
	               |	Renault_РабочиеЛисты.Клиент В(&МассивКлиентов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";				   
	Запрос.УстановитьПараметр("МассивКлиентов", МассивКлиентов);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		СтруктураВозврата.Дата = Выборка.Дата;
		СтруктураВозврата.Причина = Строка(Выборка.Событие);
	КонецЕсли;
	
	Возврат СтруктураВозврата; 
	
КонецФункции

&НаСервереБезКонтекста
Функция ВернутьСписокКлиентовКонтрагента(Контрагент)
	
	СписокКлиентов = Новый СписокЗначений;
	СписокКлиентов.Добавить(Контрагент);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Renault_ПрофилиКлиентовКлиенты1.Клиент КАК Контрагент
		|ИЗ
		|	Справочник.Renault_ПрофилиКлиентов.Клиенты КАК Renault_ПрофилиКлиентовКлиенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПрофилиКлиентов.Клиенты КАК Renault_ПрофилиКлиентовКлиенты1
		|		ПО Renault_ПрофилиКлиентовКлиенты.Ссылка = Renault_ПрофилиКлиентовКлиенты1.Ссылка
		|ГДЕ
		|	Renault_ПрофилиКлиентовКлиенты.Клиент = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокКлиентов.Добавить(Выборка.Контрагент);
	КонецЦикла;
	
Возврат СписокКлиентов;	
	
КонецФункции

