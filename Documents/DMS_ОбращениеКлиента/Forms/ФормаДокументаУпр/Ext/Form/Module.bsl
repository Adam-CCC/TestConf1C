
&НаКлиенте
Процедура ОткрытьКартинкиИФайлы(Команда)
	Парам = Новый Структура("Отбор",новый Структура("Объект", Объект.Ссылка));
	ОткрытьФорму("РегистрСведений.КартинкиИФайлы.ФормаСписка",Парам,ЭтаФорма,ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ДействияПоОбращениюПередУдалением(Элемент, Отказ)
	Если Не ДоступноПравоНаКлиенте("ПолныеПрава")
		и ПроверитьНаВозможностьИзмененияСтроки(Элемент.ТекущиеДанные.НомерСтроки,Объект.Ссылка) тогда
		Сообщить("Удалять действия может только пользователь с полными правами");
		Отказ = Истина;
	иначе
		Если Элемент.ТекущиеДанные.НомерСтроки > 1 Тогда
			ПредЭлемент = Объект.ДействияПоОбращению.Получить(Элемент.ТекущиеДанные.НомерСтроки-2);
			ПредЭлемент.ДатаВыполнения = Дата(1,1,1);
			ПредЭлемент.ОтметкаВыполнения = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

