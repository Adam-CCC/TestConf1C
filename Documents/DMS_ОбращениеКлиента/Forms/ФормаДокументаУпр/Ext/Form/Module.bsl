&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "НазначеноВремяПриема" тогда
		Если Объект.Ссылка = Параметр.Основание тогда
			ТекСтрока = Объект.ДействияПоОбращению.Получить(Объект.ДействияПоОбращению.Количество()-1);
			ТекСтрока.ДатаВыполнения = ТекущаяДата();
			ТекСтрока.ОтметкаВыполнения = Истина;
			ТекСтрока.ДокументОбращение = Параметр.ДокументОбращение;
			Исполнитель = ТекСтрока.Исполнитель;
			НовСтрока = Объект.ДействияПоОбращению.Добавить();
			НовСтрока.Действие = ПолучитьДействиеПоОбращениюНаСеревере("ВизитКлиента"); 
			НовСтрока.ДатаПланируемая = Параметр.ДатаПриемки;
			НовСтрока.Исполнитель = Исполнитель;
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ВыбранАвтомобиль" тогда
		Объект.Автомобиль = Параметр.Автомобиль;
		ЗаполнитьЗначенияСвойств(Объект,ПолучитьДанныеПоАвтомобилюНаСервере(Объект.Автомобиль, Объект.Дата));
	ИначеЕсли ИмяСобытия = "АвтомобильИзменен" тогда
		Если Объект.Автомобиль = Параметр тогда
			Объект.Автомобиль = Параметр;
			ЗаполнитьЗначенияСвойств(Объект,ПолучитьДанныеПоАвтомобилюНаСервере(Объект.Автомобиль, Объект.Дата));
		КонецЕсли;
		ЗаполнитьКоличествоАвтомобилейКонтрагента();	
	ИначеЕсли ИмяСобытия = "ОбновитьКИ_КЛ" тогда
		 ПриИзмененииКонтрагента();
	ИначеЕсли ИмяСобытия = "ВыбранИсполнительДействия" тогда
		 Если Параметр.ВладелецФормы = ЭтаФорма тогда
		 	ТекСтрока = Объект.ДействияПоОбращению.Получить(Объект.ДействияПоОбращению.Количество()-1);
			ТекСтрока.Исполнитель = Параметр.Значение;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНашеОбращение()
	
	Если ЗначениеЗаполнено(Объект.Контрагент) тогда
		СтруктураДанных = ПолучитьНашеПоследнееОбращение(ВернутьСписокКлиентовКонтрагента(Объект.Контрагент));
		Объект.НашеОбращениеДата = СтруктураДанных.Дата;
		Объект.НашеОбращениеПричина = СтруктураДанных.Причина;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	Если Не ЭтаФорма.ТолькоПросмотр Тогда
		Если Объект.ДействияПоОбращению.Количество()>0 тогда
			СтруктураЗначений = ДанныеДляЗакрытияОбращенияНаСервере();
			ПоследняСтрокаДействия = Объект.ДействияПоОбращению.Получить(Объект.ДействияПоОбращению.Количество()-1);
			
			Элементы.СогласоватьОбращение.Доступность = Ложь;
			
			Если ПоследняСтрокаДействия.Действие = СтруктураЗначений.ДействиеЗакрытие тогда	
				Элементы.ЗакрытиеОбращения.Доступность = ДоступноПраво("ПравоНаЗакрытие");
				ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ПравоНаЗакрытие");
				Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
			ИначеЕсли ПоследняСтрокаДействия.Действие = СтруктураЗначений.ДействиеСогласование тогда		
				МаксСтоимость = ПолучитьМаксСтоимость();
				Если МаксСтоимость > 0 и Объект.СтоимостьРешения > МаксСтоимость тогда 
					ЭтаФорма.ТолькоПросмотр = НЕ (ДоступноПраво("ПравоНаСогласование") и ДоступноПраво("СогласованиеОбращенияСВысокойСтоимостью"));
				иначе
					ЭтаФорма.ТолькоПросмотр = НЕ ДоступноПраво("ПравоНаСогласование");
				КонецЕсли;
				Элементы.ДействияПоОбращениюАРМ_Автосервис.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
				Элементы.СогласоватьОбращение.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	

	
	ЗаполнитьКоличествоАвтомобилейКонтрагента();
	ЗаполнитьНашеОбращение();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМаксСтоимость()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПраваИНастройкиПользователей.Обращения_ПределСуммыОбращения КАК МаксСтоимость
		|ИЗ
		|	РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_ПраваИНастройкиПользователей КАК Renault_ПраваИНастройкиПользователей
		|		ПО Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки = Renault_ПраваИНастройкиПользователей.Ссылка
		|			И (Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь)
		|ГДЕ
		|	Renault_ПользователиИШаблоныПравИНастроек.Пользователь = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", Справочники.Пользователи.НайтиПоКоду(ПользователиИнформационнойБазы.ТекущийПользователь().Имя));
	
	выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() тогда
		Возврат Выборка.МаксСтоимость;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьПрофильКлиента(Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПрофилиКлиентовКлиенты.Ссылка
		|ИЗ
		|	Справочник.Renault_ПрофилиКлиентов.Клиенты КАК Renault_ПрофилиКлиентовКлиенты
		|ГДЕ
		|	Renault_ПрофилиКлиентовКлиенты.Клиент = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		НовыйПрофиль = Справочники.Renault_ПрофилиКлиентов.СоздатьЭлемент();
		Клиент = НовыйПрофиль.Клиенты.Добавить();
		Клиент.Клиент = Контрагент;
		НовыйПрофиль.Записать();
		Возврат	НовыйПрофиль.Ссылка;
	КонецЕсли;
	
КонецФункции

