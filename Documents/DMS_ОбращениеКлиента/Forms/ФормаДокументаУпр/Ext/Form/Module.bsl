		ПараметрыСообщения.Вставить("Исполнитель", Стр.Исполнитель);
		ПараметрыСообщения.Вставить("ДатаНачала", Стр.ДатаПланируемая);
		ПараметрыСообщения.Вставить("ДатаОкончания", Стр.ДатаПланируемая);
		ПараметрыСообщения.Вставить("Содержание", Стр.Действие);
		ПараметрыСообщения.Вставить("Комментарий", Стр.Описание);
		ПараметрыСообщения.Вставить("Пояснение", "");
		
		//Если ТипЗнч(Стр.Исполнитель) = Тип("СправочникСсылка.Сотрудники") Тогда
		//	
		//	Запрос = Новый Запрос;
		//	Запрос.Текст = 
		//	"ВЫБРАТЬ
