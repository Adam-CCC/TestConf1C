&НаСервере
Функция СформироватьТекстСообщения()
	
	//ЗКП_<НомерДокументаОбращение>_<BIR Дилера>_<НазваниеДилера>_<ФИО_Клиента>
	//Символы.НПП разрыв
	
	BIR = Renault_ОбщийМодуль.ПолучитьBIRБазыДанных();
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	
	ЗаголовокПисьма  = НСтр("ru='Запрос коммерческой помощи'")+"_"+Объект.Номер+"_"+BIR+"_"+ДЦ+"_"+Объект.Контрагент+"";
	ТекстСообщения = ЗаголовокПисьма  + Символы.ПС	+ "Содержимое письма";
	Возврат ТекстСообщения;
	
КонецФункции

&НаСервере
Функция СоздатьНаОснованииЗКПНаСервере()
	
	СсылкаДок = Документы.Renault_ЗапросНаКоммерческуюПомощь.ПолучитьСсылку(Новый УникальныйИдентификатор());	
	ЗапросНаКоммерческуюПомощь = Документы.Renault_ЗапросНаКоммерческуюПомощь.СоздатьДокумент();
	ЗапросНаКоммерческуюПомощь.УстановитьСсылкуНового(СсылкаДок);
	ЗапросНаКоммерческуюПомощь.УстановитьНовыйНомер();
	ЗапросНаКоммерческуюПомощь.Дата =  ТекущаяДата();
	ЗапросНаКоммерческуюПомощь.ТипКлиента = Перечисления.Renault_ТипыКлиентов.РозничныйКлиент;
	ЗапросНаКоммерческуюПомощь.Приоритет = Справочники.DMS_Приоритет.Нормальный;
	ЗапросНаКоммерческуюПомощь.СтатусЗапроса = Перечисления.Renault_СостояниеЗапросаНаКоммерческуюПомощь.ПодготовкаДилером;
	ЗапросНаКоммерческуюПомощь.Ответственный = ПараметрыСеанса.Пользователь;
	
	ЗаполнитьЗначенияСвойств(ЗапросНаКоммерческуюПомощь,Объект,,"Номер");
	ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
	ЗапросНаКоммерческуюПомощь.БизнесРегион = ДЦ.DMS_БизнесРегион;
	
	ЗапросНаКоммерческуюПомощь.Записать(РежимЗаписиДокумента.Проведение);
	
	Объект.ЗКП = СсылкаДок;
	Записать();
	
	Возврат СсылкаДок;
		
КонецФункции

&НаКлиенте
Процедура СоздатьНаОснованииЗКП(Команда)
	Если ЗначениеЗаполнено(Объект.ЗКП) Тогда
		 ОткрытьЗначение(Объект.ЗКП);
	Иначе
		СсылкаДок = СоздатьНаОснованииЗКПНаСервере();
		ОткрытьЗначение(СсылкаДок);
	КонецЕсли;
КонецПроцедуры

