	СтруктураЗначений.Вставить("ДействиеЗакрытие",Справочники.DMS_ДействияПоОбращениям.ЗакрытьОбращение);
	СтруктураЗначений.Вставить("ДействиеСогласование",Справочники.DMS_ДействияПоОбращениям.СогласоватьОбращение);
	СтруктураЗначений.Вставить("ДействиеСогласовано",Справочники.DMS_ДействияПоОбращениям.Согласовано);
