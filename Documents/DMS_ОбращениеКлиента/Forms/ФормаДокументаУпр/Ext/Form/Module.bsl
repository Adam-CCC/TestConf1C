&НаКлиенте
Процедура ИсторияОбщенияПриИзменении(Элемент)
	
	Если Элемент.ТекущиеДанные<>Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.Сотрудник) тогда
			Элемент.ТекущиеДанные.Сотрудник = ВернутьТекущегоСотрудника();
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ДатаСообщения) тогда
			Элемент.ТекущиеДанные.ДатаСообщения = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СогласоватьОбращение(Команда)
	
	СтруктураЗначений = ДанныеДляЗакрытияОбращенияНаСервере();
	Если Объект.ДействияПоОбращению.Количество() > 0 тогда
		ПоследняСтрокаДействия = Объект.ДействияПоОбращению.Получить(Объект.ДействияПоОбращению.Количество()-1);
		Если ПоследняСтрокаДействия.Действие = СтруктураЗначений.ДействиеСогласование тогда	
			ПоследняСтрокаДействия.ДатаВыполнения = ТекущаяДата();
			ПоследняСтрокаДействия.ОтметкаВыполнения = Истина;
			Объект.СтатусОбращения = СтруктураЗначений.СтатусВРаботе;
			НовСтр = Объект.ДействияПоОбращению.Добавить();
			НовСтр.Действие = СтруктураЗначений.ДействиеСогласовано;
			НовСтр.Исполнитель = ВернутьТекущегоСотрудника(); 
			НовСтр.ДатаПланируемая = ТекущаяДата();
			НовСтр.ДатаВыполнения = ТекущаяДата();
			НовСтр.ОтметкаВыполнения = Истина;
			
			НовСтр = Объект.ДействияПоОбращению.Добавить();
			НовСтр.Действие = СтруктураЗначений.ДействиеСвязатьсяСКлиентом;
			НовСтр.Исполнитель = ВернутьТекущегоСотрудника(); 
			НовСтр.ДатаПланируемая = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ДействияПоОбращениюДействиеПриИзменении(Элемент)
	
	Элементы.ЗакрытиеОбращения.Доступность = Ложь;
	Элементы.СогласоватьОбращение.Доступность = Ложь;
	
	Если Объект.ДействияПоОбращению.Количество()>0 тогда
		
		ПоследняСтрокаДействия = Объект.ДействияПоОбращению.Получить(Объект.ДействияПоОбращению.Количество()-1);
		
		Если ЗначениеЗаполнено(ПоследняСтрокаДействия.Действие) тогда
			//и НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.Исполнитель) тогда
			СтруктураЗначений = ДанныеДляЗакрытияОбращенияНаСервере();
			
			СписокПрав = Новый СписокЗначений;
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Ключ",Объект.Ссылка);
			
			Если ПоследняСтрокаДействия.Действие = СтруктураЗначений.ДействиеЗакрытие тогда	
				Элементы.ЗакрытиеОбращения.Доступность = ДоступноПравоНаКлиенте("ПравоНаЗакрытие");
				СписокПрав.Добавить(ВернутьСсылкуНаПраво("ПравоНаЗакрытие"));
				ПараметрыОткрытия.Вставить("СписокПрав",СписокПрав);
				ОткрытьФорму("Документ.DMS_ОбращениеКлиента.Форма.ФормаВыбораИсполнителя",ПараметрыОткрытия,ЭтаФорма,ЭтаФорма);
			ИначеЕсли ПоследняСтрокаДействия.Действие = СтруктураЗначений.ДействиеСогласование тогда	
				СписокПрав.Добавить(ВернутьСсылкуНаПраво("ПравоНаСогласование"));
				ПараметрыОткрытия.Вставить("СписокПрав",СписокПрав);
				ОткрытьФорму("Документ.DMS_ОбращениеКлиента.Форма.ФормаВыбораИсполнителя",ПараметрыОткрытия,ЭтаФорма,ЭтаФорма);
				Элементы.СогласоватьОбращение.Доступность = ДоступноПравоНаКлиенте("ПравоНаСогласование"); 	
			Иначе
				СписокПрав.Добавить(ВернутьСсылкуНаПраво("ПравоНаРедактирование"));
				ПараметрыОткрытия.Вставить("СписокПрав",СписокПрав);
				ОткрытьФорму("Документ.DMS_ОбращениеКлиента.Форма.ФормаВыбораИсполнителя",ПараметрыОткрытия,ЭтаФорма,ЭтаФорма);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры


