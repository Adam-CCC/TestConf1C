	<Attributes>
		<Attribute name="СписокСотрудников" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список сотрудников</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
					<v8:content>A list of employees</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СправочникСотрудники.Ссылка,
	СправочникСотрудники.Наименование,
	СправочникСотрудники.Должность,
	СправочникСотрудники.Подразделение,
	СправочникСотрудники.ТабельныйНомер
ИЗ
	Справочник.Сотрудники КАК СправочникСотрудники
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПользователиИШаблоныПравИНастроек КАК Renault_ПользователиИШаблоныПравИНастроек
		ПО СправочникСотрудники.Ссылка = Renault_ПользователиИШаблоныПравИНастроек.Пользователь.Сотрудник
ГДЕ
	Renault_ПользователиИШаблоныПравИНастроек.ПраваИНастройки В
			(ВЫБРАТЬ
				Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Ссылка
			ИЗ
				Справочник.Renault_ПраваИНастройкиПользователей.ОбращенияКлиентов КАК Renault_ПраваИНастройкиПользователейОбращенияКлиентов
			ГДЕ
				(Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Право В (&amp;СписокПрав)
				ИЛИ Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Право  = Значение(Справочник.DMS_ПраваРолейПоОбращениям.ПолныеПрава))
				И Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Доступность = ИСТИНА
			СГРУППИРОВАТЬ ПО
				Renault_ПраваИНастройкиПользователейОбращенияКлиентов.Ссылка)</QueryText>
				<MainTable>Catalog.Сотрудники</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
