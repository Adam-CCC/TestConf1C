&НаКлиенте
Процедура Список2ВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	Парам = Новый Структура();
	Парам.Вставить("ВладелецФормы", ЭтаФорма.ВладелецФормы);
	Парам.Вставить("Значение",Значение);
	Оповестить("ВыбранИсполнительДействия",Парам,ЭтаФорма);
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СписокСотрудников.Параметры.УстановитьЗначениеПараметра("СписокПрав", Параметры.СписокПрав);
КонецПроцедуры

