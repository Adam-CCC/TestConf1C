			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Документdms_ОбращениеКлиента.Ссылка,
	Документdms_ОбращениеКлиента.ПометкаУдаления,
	Документdms_ОбращениеКлиента.Номер,
	Документdms_ОбращениеКлиента.Дата,
	Документdms_ОбращениеКлиента.Проведен,
	Документdms_ОбращениеКлиента.Контрагент,
	Документdms_ОбращениеКлиента.Автомобиль,
	Документdms_ОбращениеКлиента.СтатусОбращения,
	Документdms_ОбращениеКлиента.ТипОбращения,
	Документdms_ОбращениеКлиента.СтатусКлиента,
	Документdms_ОбращениеКлиента.ПричинаОбращения,
	Документdms_ОбращениеКлиента.Гарантия,
	Документdms_ОбращениеКлиента.Пробег,
	Документdms_ОбращениеКлиента.ГосНомер,
	Документdms_ОбращениеКлиента.EMail,
	Документdms_ОбращениеКлиента.НашеОбращениеДата,
	Документdms_ОбращениеКлиента.НашеОбращениеПричина,
	Документdms_ОбращениеКлиента.Приоритет,
	Документdms_ОбращениеКлиента.ПодТипОбращения,
	Документdms_ОбращениеКлиента.VIN,
	Документdms_ОбращениеКлиента.Телефон,
	Документdms_ОбращениеКлиента.СвязаннаяЗаявка,
	Документdms_ОбращениеКлиента.Тема,
	Документdms_ОбращениеКлиента.Описание,
	Документdms_ОбращениеКлиента.Подробности,
	Документdms_ОбращениеКлиента.ОщущениеКлиента,
	Документdms_ОбращениеКлиента.ПожеланиеКлиента,
	Документdms_ОбращениеКлиента.Риск,
	Документdms_ОбращениеКлиента.ПроблемнаяСистемаАвто,
	Документdms_ОбращениеКлиента.ДетализацияПроблемыКачества,
	Документdms_ОбращениеКлиента.ПроблемаПродаж,
	Документdms_ОбращениеКлиента.ХарактерПроблемы,
	Документdms_ОбращениеКлиента.ПовтороноеПриобретенияАвто,
	Документdms_ОбращениеКлиента.ДействияПоОбращению.(
		Ссылка,
		НомерСтроки,
		Действие,
		Описание,
		Исполнитель,
		ДатаПланируемая,
		ДатаВыполнения,
		ВыполнениеПросрочено
	),
	Документdms_ОбращениеКлиента.МоментВремени,
	DMS_ОбращениеКлиентаДействияПоОбращению.Действие,
	DMS_ОбращениеКлиентаДействияПоОбращению.ДатаПланируемая,
	DMS_ОбращениеКлиентаДействияПоОбращению.Исполнитель,
	ВЫБОР
		КОГДА Документdms_ОбращениеКлиента.ЗКП &lt;&gt; ЗНАЧЕНИЕ(Документ.Renault_ЗапросНаКоммерческуюПомощь.ПустаяСсылка)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЗКП,
	Документdms_ОбращениеКлиента.ЗКП.Дата,
	Документdms_ОбращениеКлиента.ЗКП.СтатусЗапроса
ИЗ
	Документ.DMS_ОбращениеКлиента КАК Документdms_ОбращениеКлиента
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			DMS_ОбращениеКлиентаДействияПоОбращению.Ссылка КАК Ссылка,
			МАКСИМУМ(DMS_ОбращениеКлиентаДействияПоОбращению.ДатаПланируемая) КАК ДатаПланируемая
		ИЗ
			Документ.DMS_ОбращениеКлиента.ДействияПоОбращению КАК DMS_ОбращениеКлиентаДействияПоОбращению
		ГДЕ
			DMS_ОбращениеКлиентаДействияПоОбращению.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1)
		
		СГРУППИРОВАТЬ ПО
			DMS_ОбращениеКлиентаДействияПоОбращению.Ссылка) КАК МаксДатаПланирования
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.DMS_ОбращениеКлиента.ДействияПоОбращению КАК DMS_ОбращениеКлиентаДействияПоОбращению
			ПО (DMS_ОбращениеКлиентаДействияПоОбращению.ДатаВыполнения = ДАТАВРЕМЯ(1, 1, 1))
				И МаксДатаПланирования.ДатаПланируемая = DMS_ОбращениеКлиентаДействияПоОбращению.ДатаПланируемая
				И МаксДатаПланирования.Ссылка = DMS_ОбращениеКлиентаДействияПоОбращению.Ссылка
		ПО Документdms_ОбращениеКлиента.Ссылка = МаксДатаПланирования.Ссылка</QueryText>
