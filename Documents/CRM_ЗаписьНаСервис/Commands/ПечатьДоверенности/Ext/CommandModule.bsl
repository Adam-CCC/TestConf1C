
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	
	Если НЕ Renault_УправлениеПечатьюКлиент.ПроверитьДокументыПроведены(ПараметрКоманды) Тогда
		Возврат
	КонецЕсли;
	
	ИмяМакета = "ПФ_DOC_Доверенность";
	МакетИДанныеОбъекта = Renault_УправлениеПечатьюВызовСервера.ПолучитьМакетыИДанныеОбъектов("Документ.CRM_ЗаписьНаТестДрайв", ИмяМакета, ПараметрКоманды);
	
	Для Каждого ДокументИМакеты Из МакетИДанныеОбъекта.Данные Цикл
		Документ = ДокументИМакеты.Ключ;
		Для Каждого ДанныеОбъекта Из ДокументИМакеты.Значение Цикл
			Если ЕстьНезаполненныеДанные(ДанныеОбъекта.Значение) Тогда
				ДанныеОбъекта.Значение.Вставить("СсылкаНаОбъект", Документ);
				Форма = ПолучитьФорму("Документ.CRM_ЗаписьНаТестДрайв.Форма.ФормаЗаполненияДанныхДляПечати", ДанныеОбъекта.Значение);
				Если НЕ Форма.ОткрытьМодально() = Истина Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТипМакета = МакетИДанныеОбъекта.Макеты.ТипыМакетов[ИмяМакета];
	Области = МакетИДанныеОбъекта.Макеты.ОписаниеОбластей;
	Для Каждого ДокументСсылка Из ПараметрКоманды Цикл
		ДвоичныеДанныеМакетов = МакетИДанныеОбъекта.Макеты.ДвоичныеДанныеМакетов;
		ДанныеОбъекта = МакетИДанныеОбъекта.Данные[ДокументСсылка][ИмяМакета];
		Попытка
			Макет = Renault_УправлениеПечатьюКлиент.ИнициализироватьМакет(ДвоичныеДанныеМакетов[ИмяМакета], ТипМакета);
			ПечатнаяФорма = Renault_УправлениеПечатьюКлиент.ИнициализироватьПечатнуюФорму(ТипМакета, Макет.НастройкиСтраницыМакета, Макет);
			Область = Renault_УправлениеПечатьюКлиент.ПолучитьОбласть(Макет, Области[ИмяМакета]["Заголовок"]);
			Renault_УправлениеПечатьюКлиент.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);
			Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(ПечатнаяФорма);
		Исключение
			Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ИнформацияОбОшибке().Описание);
			Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(ПечатнаяФорма);
			Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);
			Возврат;
		КонецПопытки;
		Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(ПечатнаяФорма, Ложь);
		Renault_УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьНезаполненныеДанные(ДанныеОбъекта) 
	
	Для Каждого Данные Из ДанныеОбъекта Цикл
		Если НЕ ЗначениеЗаполнено(Данные.Значение) Тогда
			Возврат Истина
		КонецЕсли
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции