Функция СМГ_ДополнитьСписокОснований(СписокОснований,ДокОснование)
	
	СпОснВрем = СписокОснований;
	
 	СписокКомплектацийАвтомобиля = СМГ_ПолучитьСписокКомплектацийИзРегистра(ДокОснование);			
	
	Если СписокКомплектацийАвтомобиля.Количество() > 0 Тогда
		Для каждого Элем Из СписокКомплектацийАвтомобиля Цикл
			СпОснВрем.Добавить(Элем.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СпОснВрем;

КонецФункции // СМГ_ДополнитьСписокОснований(СписокОснований,ДокОснование)

Функция СМГ_ПолучитьСписокКомплектацийИзРегистра(ДокОсн)
	
	СпЗнач = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КомплектацияАвтомобилей.Регистратор КАК Ссылка,
		|	КомплектацияАвтомобилей.Период,
		|	КомплектацияАвтомобилей.Автомобиль
		|ИЗ
		|	РегистрНакопления.КомплектацияАвтомобилей КАК КомплектацияАвтомобилей
		|ГДЕ
		|	КомплектацияАвтомобилей.Автомобиль = &Автомобиль
		|	И КомплектацияАвтомобилей.Период <= &Период";
	
	Запрос.УстановитьПараметр("Автомобиль", ДокОсн.Автомобиль); 
 	Запрос.УстановитьПараметр("Период", ДокОсн.Дата);	
 	
	СпЗнач.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СпЗнач;
 
КонецФункции // СМГ_ПолучитьСписокКомплектаций(Автомобиль)
