		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    Номенклатура.Ссылка КАК Номенклатура,
    Номенклатура.Артикул
ПОМЕСТИТЬ ВТ_Номенклатура
ИЗ
    Справочник.Номенклатура КАК Номенклатура
ГДЕ
    Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
    И НЕ Номенклатура.ЭтоГруппа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    Номенклатура.Ссылка КАК НоменклатураСтарая,
    Номенклатура1.Ссылка КАК НоменклатураНовая
ПОМЕСТИТЬ ВТ_Замены
ИЗ
    РегистрСведений.Renault_ЗаменыРеферансов КАК Renault_ЗаменыРеферансов
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
        ПО Renault_ЗаменыРеферансов.АртикулНоменклатуры = Номенклатура.Артикул
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура1
        ПО Renault_ЗаменыРеферансов.АртикулЗамены = Номенклатура1.Артикул
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ВТ_Номенклатура.Номенклатура,
    ВТ_Номенклатура.Номенклатура КАК Замена
ПОМЕСТИТЬ ВТ_НоменклатураСЗаменами
ИЗ
    ВТ_Номенклатура КАК ВТ_Номенклатура

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
    ВТ_Номенклатура.Номенклатура,
    ВТ_Замены.НоменклатураСтарая
ИЗ
    ВТ_Номенклатура КАК ВТ_Номенклатура
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Замены КАК ВТ_Замены
        ПО ВТ_Номенклатура.Номенклатура = ВТ_Замены.НоменклатураНовая
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ОстаткиТоваровКомпании.Номенклатура КАК Номенклатура,
    ОстаткиТоваровКомпании.Регистратор КАК Документ
ПОМЕСТИТЬ ВТ_РасходПодготовка
ИЗ
    РегистрНакопления.ОстаткиТоваровКомпании КАК ОстаткиТоваровКомпании
        ЛЕВОЕ СОЕДИНЕНИЕ Документ.Корректировка КАК Корректировка
        ПО ОстаткиТоваровКомпании.Регистратор = Корректировка.ДокументОснование
            И (Корректировка.Проведен)
ГДЕ
    ОстаткиТоваровКомпании.ВидДвижения = &amp;ВидДвижения
    И Корректировка.Ссылка ЕСТЬ NULL 
    И ОстаткиТоваровКомпании.Количество &gt; 0
    И ОстаткиТоваровКомпании.Период &gt;= &amp;НачалоПериода
    И ОстаткиТоваровКомпании.Период &lt;= &amp;КонецПериода
    И ОстаткиТоваровКомпании.СкладКомпании = &amp;СкладКомпании

СГРУППИРОВАТЬ ПО
    ОстаткиТоваровКомпании.Номенклатура,
    ОстаткиТоваровКомпании.Регистратор

ИНДЕКСИРОВАТЬ ПО
    Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ВТ_НоменклатураСЗаменами.Номенклатура,
    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_РасходПодготовка.Документ) КАК Показатель
ПОМЕСТИТЬ ВТ_Расход
ИЗ
    ВТ_НоменклатураСЗаменами КАК ВТ_НоменклатураСЗаменами
        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасходПодготовка КАК ВТ_РасходПодготовка
        ПО ВТ_НоменклатураСЗаменами.Замена = ВТ_РасходПодготовка.Номенклатура

СГРУППИРОВАТЬ ПО
    ВТ_НоменклатураСЗаменами.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
    ВТ_Номенклатура.Номенклатура КАК Номенклатура,
    ВТ_Номенклатура.Артикул КАК Артикул,
    ВЫБОР
        КОГДА ВТ_Расход.Показатель ЕСТЬ NULL 
                ИЛИ Renault_СтатусыНоменклатуры.Статус = ЗНАЧЕНИЕ(Справочник.Renault_СтатусыНоменклатуры.OFF)
                ИЛИ ВТ_Расход.Показатель &lt;= &amp;Класс0
            ТОГДА 0
        КОГДА ВТ_Расход.Показатель &lt;= &amp;Класс1
            ТОГДА 1
        КОГДА ВТ_Расход.Показатель &lt;= &amp;Класс2
            ТОГДА 2
        ИНАЧЕ 3
    КОНЕЦ КАК Класс,
    ЕСТЬNULL(ВТ_Расход.Показатель, 0) КАК ЗначениеПоказателя,
    ЕСТЬNULL(ПредыдущиеПоказатели.Класс, 0) КАК КлассСтарый,
    Renault_КаталогРеферансов.Модель КАК Модель,
    Renault_КаталогРеферансов.ТехСемья КАК ТехСемья,
    Renault_КаталогРеферансов.Сегмент КАК Сегмент,
    Renault_КаталогРеферансов.Проект КАК Проект
ИЗ
    ВТ_Номенклатура КАК ВТ_Номенклатура
        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Расход КАК ВТ_Расход
        ПО ВТ_Номенклатура.Номенклатура = ВТ_Расход.Номенклатура
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_КаталогРеферансов КАК Renault_КаталогРеферансов
        ПО ВТ_Номенклатура.Артикул = Renault_КаталогРеферансов.Артикул
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ЧастотныеГруппыНоменклатуры.СрезПоследних(&amp;Период, СкладКомпании = &amp;СкладКомпании) КАК ПредыдущиеПоказатели
        ПО ВТ_Номенклатура.Номенклатура = ПредыдущиеПоказатели.Номенклатура
        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_СтатусыНоменклатуры КАК Renault_СтатусыНоменклатуры
        ПО ВТ_Номенклатура.Номенклатура = Renault_СтатусыНоменклатуры.Номенклатура</query>
	</dataSet>
