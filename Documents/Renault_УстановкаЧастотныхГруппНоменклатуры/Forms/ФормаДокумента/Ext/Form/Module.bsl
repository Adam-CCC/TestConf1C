&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	ЭтоОбъект=РеквизитФормыВЗначение("Объект");
	Схема=ЭтоОбъект.ПолучитьМакет("СКД");
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(Схема,УникальныйИдентификатор)));
	
	НастройкиОтбораXML=ЭтоОбъект.НастройкиОтбора.Получить();
	Если НастройкиОтбораXML=Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Иначе
		ЧтениеXML=Новый ЧтениеXML; 
		ЧтениеXML.УстановитьСтроку(НастройкиОтбораXML); 
		КомпоновщикНастроек.ЗагрузитьНастройки(СериализаторXDTO.ПрочитатьXML(ЧтениеXML,Тип("НастройкиКомпоновкиДанных")));
	КонецЕсли;	
	
	СостояниеКнопокФормы();
КонецПроцедуры
Процедура СостояниеКнопокФормы()
	//ЭтотОбъект=РеквизитФормыВЗначение("Объект");
	Вкл=Новый Цвет(255,207,0);
	Выкл=Новый Цвет(189,195,206);
	
	Элементы.кнПровести.ЦветФона=?(Объект.Проведен,Вкл,Выкл);
	Элементы.кнПровести.ЦветРамки=?(Объект.Проведен,Вкл,Выкл);
	
	Элементы.кнЗаписать.ЦветФона=?(Объект.Ссылка.Пустая(),Выкл,Вкл);
	Элементы.кнЗаписать.ЦветРамки=?(Объект.Ссылка.Пустая(),Выкл,Вкл);
	
	Элементы.кнОтменитьПроведение.ЦветФона=?(Объект.Проведен,Выкл,Вкл);
	Элементы.кнОтменитьПроведение.ЦветРамки=?(Объект.Проведен,Выкл,Вкл);
	
	Элементы.кнПометитьНаУдаление.ЦветФона=?(Объект.ПометкаУдаления,Вкл,Выкл);
	Элементы.кнПометитьНаУдаление.ЦветРамки=?(Объект.ПометкаУдаления,Вкл,Выкл);
	
	Элементы.кнОтменитьПометкуУдаления.ЦветФона=?(Объект.ПометкаУдаления,Выкл,Вкл);
	Элементы.кнОтменитьПометкуУдаления.ЦветРамки=?(Объект.ПометкаУдаления,Выкл,Вкл);
КонецПроцедуры

&НаКлиенте
Процедура кнМенюФормы(Команда)
	Если Команда.Имя="кнЗаписать" Тогда Записать() //НажатиеКнопкиМеню("ЭтотОбъект.Записать(РежимЗаписиДокумента.Запись)")
	ИначеЕсли Команда.Имя="кнПровести" Тогда НажатиеКнопкиМеню("ЭтотОбъект.Записать(РежимЗаписиДокумента.Проведение)") 
	ИначеЕсли Команда.Имя="кнОтменитьПроведение" Тогда НажатиеКнопкиМеню("ЭтотОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения)") 
	ИначеЕсли Команда.Имя="кнПометитьНаУдаление" Тогда НажатиеКнопкиМеню("ЭтотОбъект.ПометкаУдаления=Истина; ЭтотОбъект.Записать()") //НажатиеКнопкиМеню("ЭтотОбъект.УстановитьПометкуУдаления(Истина)") 		
	//ИначеЕсли Команда.Имя="кнПометитьНаУдаление" Тогда НажатиеКнопкиМеню("Если ЭтотОбъект.Проведен Тогда ЭтотОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения) КонецЕсли; ЭтотОбъект.ПометкаУдаления=Истина; ЭтотОбъект.Записать()") //НажатиеКнопкиМеню("ЭтотОбъект.УстановитьПометкуУдаления(Истина)") 
	ИначеЕсли Команда.Имя="кнОтменитьПометкуУдаления" Тогда НажатиеКнопкиМеню("ЭтотОбъект.ПометкаУдаления=Ложь; ЭтотОбъект.Записать()") //НажатиеКнопкиМеню("ЭтотОбъект.УстановитьПометкуУдаления(Ложь)") 
	ИначеЕсли Команда.Имя="кнЗакрыть" Тогда Закрыть()
	КонецЕсли;
	СостояниеКнопокФормы();
КонецПроцедуры
Процедура НажатиеКнопкиМеню(Команда)
	ЭтотОбъект=РеквизитФормыВЗначение("Объект");
	Если ЭтотОбъект.ЭтоНовый() Тогда Возврат КонецЕсли;
	Попытка Выполнить(Команда) Исключение Сообщить(ОписаниеОшибки(),СтатусСообщения.Внимание) КонецПопытки;
	ЗначениеВРеквизитФормы(ЭтотОбъект,"Объект");
КонецПроцедуры	

&НаКлиенте
Процедура кнСписка(Команда)
	Если Команда.Имя="кнДобавить" Тогда Объект.Классификация.Добавить()
	ИначеЕсли Команда.Имя="кнУдалить" Тогда Если Объект.Классификация.Количество()>0 Тогда Объект.Классификация.Удалить(Элементы.Классификация.ТекущиеДанные.НомерСтроки-1) КонецЕсли
	ИначеЕсли Команда.Имя="кнЗаполнить" Тогда Заполнить()
	ИначеЕсли Команда.Имя="кнОтбор" Тогда Отбор()
	КонецЕсли;	
КонецПроцедуры
Процедура Заполнить()
	
	Настройки=КомпоновщикНастроек.Настройки;
	Настройки.ПараметрыДанных.Элементы.Найти("Класс0").Значение=Объект.Класс0;
	Настройки.ПараметрыДанных.Элементы.Найти("Класс1").Значение=Объект.Класс1;
	Настройки.ПараметрыДанных.Элементы.Найти("Класс2").Значение=Объект.Класс2;
	Настройки.ПараметрыДанных.Элементы.Найти("ГруппаАнализа").Значение=Объект.ГруппаАнализа;
	Настройки.ПараметрыДанных.Элементы.Найти("НачалоПериода").Значение=Объект.НачалоПериода;
	Настройки.ПараметрыДанных.Элементы.Найти("КонецПериода").Значение=КонецДня(Объект.КонецПериода);
	
	КомпоновщикМакета=Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет=КомпоновщикМакета.Выполнить(Схема,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки=Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет,,,Истина);
	ПроцессорВывода=Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Объект.Классификация.Загрузить(ПроцессорВывода.Вывести(ПроцессорКомпоновки,Истина));
	
КонецПроцедуры
&НаКлиенте
Процедура Отбор()
	Источник=Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(Схема,УникальныйИдентификатор));
	Renault_ОбщиеФункции.ОткрытьФормуОтбора(ЭтаФорма,Источник,КомпоновщикНастроек,"ОтборСписка",,Истина,)
КонецПроцедуры
Процедура ОтборСписка(КомпНастроек,Парам) Экспорт
	Если КомпНастроек=Неопределено Тогда Возврат КонецЕсли;		
	КомпоновщикНастроек.ЗагрузитьНастройки(КомпНастроек.Настройки);
	//ЭтаФорма[ИмяСписка].КомпоновщикНастроек.ЗагрузитьНастройки(КомпоновщикНастроек.Настройки);
	//ЭтаФорма[ИмяСписка].КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);
	//ЭтаФорма[ИмяСписка].КомпоновщикНастроек.ЗагрузитьФиксированныеНастройки(КомпоновщикНастроек.ФиксированныеНастройки);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ЗаписьXML=Новый ЗаписьXML; 
    ЗаписьXML.УстановитьСтроку(); 
    СериализаторXDTO.ЗаписатьXML(ЗаписьXML,КомпоновщикНастроек.Настройки,"Settings","http://v8.1c.ru/8.1/data-composition-system/settings"); 
    ТекущийОбъект.НастройкиОтбора=Новый ХранилищеЗначения(ЗаписьXML.Закрыть()); 
КонецПроцедуры
