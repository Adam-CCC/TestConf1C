
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Ищем запись в регистре производителя по вину
	Запись = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
	Запись.VIN = VIN;
	Запись.Прочитать();
	
	//Режим удаления
	Если РежимРаботы = 2 Тогда
		Запись.Удалить();
		Возврат;
	КонецЕсли;

	Если Не Запись.Выбран() Тогда
		//Режим постоянной и временной корректировки
		Запись = РегистрыСведений.CRM_СостояниеАвтомобилейПроизводителя_v2.СоздатьМенеджерЗаписи();
		Запись.VIN = VIN;
	Иначе
		//Проверим - есил запись загружена от производителя, тогда это поле обязательно заполнено 
		Если РежимРаботы = 1 И ЗначениеЗаполнено(Запись.Model_Full) Тогда
			//Режим временной корректировки, не редактируем, если уже загружено
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	//Заполним только те свойства, которые заполнены в документе
	СписокСвойств = "";
	НужнаЗапятая = Истина;
	Для Каждого Реквизит Из ЭтотОбъект.Метаданные().Реквизиты Цикл	
		Если Реквизит.Имя = "VIN" ИЛИ Реквизит.Имя = "УдалениеАвтомобиля" ИЛИ Реквизит.Имя = "РежимРаботы"
			Тогда Продолжить; КонецЕсли;
		Если ЗначениеЗаполнено(ЭтотОбъект[Реквизит.Имя]) Тогда
			Если НужнаЗапятая Тогда
				СписокСвойств = СписокСвойств + ",";
			Иначе
				НужнаЗапятая = Истина;
			КонецЕсли;			
			СписокСвойств = СписокСвойств + Реквизит.Имя;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Запись, ЭтотОбъект, СписокСвойств);
	
	Если РежимРаботы = 1 Тогда
		Запись.НаУдаление = Ложь;
		Запись.НаДобавление = Ложь;
		Запись.Скрывать = Ложь;
	КонецЕсли;
	
	Запись.Записать();
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Автомобиль) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры   

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура НайтиСоздатьИзменитьАвтомобиль() Экспорт
	
	Если ЗначениеЗаполнено(Автомобиль) И Автомобиль.VIN <> VIN Тогда
		Автомобиль = Справочники.Автомобили.ПустаяСсылка();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Автомобиль) Тогда
		Автомобиль = Справочники.Автомобили.НайтиПоРеквизиту("VIN", VIN);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Автомобиль) Тогда
		//Создадим новый
		АвтомобильОбъект = Справочники.Автомобили.СоздатьЭлемент();
		АвтомобильОбъект.VIN = VIN;
		АвтомобильОбъект.Модель = Модель;
		АвтомобильОбъект.ВариантКомплектации = Версия;
		АвтомобильОбъект.Цвет = Цвет;				
		АвтомобильОбъект.Наименование = "Автомобиль Renault " + Модель + ", " + Цвет + ", VIN: " + VIN;
		АвтомобильОбъект.ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
		АвтомобильОбъект.УстановитьНовыйКод();
		
		//Если Renault_CRM.ВерсияАльфаАвто() = "5" Тогда		
			АвтомобильОбъект.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;
		//Иначе
		//	
		//КонецЕсли;
		АвтомобильОбъект.Записать();
	Иначе
		АвтомобильОбъект = Автомобиль.ПолучитьОбъект();
	КонецЕсли;	
	
	Автомобиль = АвтомобильОбъект.Ссылка;
	
КонецПроцедуры