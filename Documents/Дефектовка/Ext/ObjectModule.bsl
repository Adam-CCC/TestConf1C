Процедура УстановитьПрефикс() Экспорт
	    НовыйПрефикс = обПолучитьПрефиксОбъекта(ЭтотОбъект,);
		ДлиннаПрефикса = СтрДлина(НовыйПрефикс);
		
		стрНомер = Номер;
		СтарыйПефикс = "";
		Флаг = истина;
		НачНомер = 1;
		Пока Флаг  цикл
			
			 СимволПрефикса= сред(стрНомер,НачНомер,1);
			 Попытка
				Числопрефикса =  Число(СимволПрефикса);
				 флаг = Ложь; 

			 Исключение
				   СтарыйПефикс = СтарыйПефикс+ СимволПрефикса ;
				 НачНомер = НачНомер+1;

			КонецПопытки; 
		КонецЦикла;
		Если СтарыйПефикс <>  НовыйПрефикс тогда
			Номер = СтрЗаменить(Номер,СтарыйПефикс,НовыйПрефикс);
	   КонецЕсли;
КонецПроцедуры	

