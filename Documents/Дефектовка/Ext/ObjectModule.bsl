Процедура ПриЗаписи(Отказ)
	Если НЕ дкПриЗаписи(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
	
	Ошибки="";
	
	//Проверка корректности дат
	Если (НЕ обЗначениеНеЗаполнено(ДатаСоздания)) И (НЕ обЗначениеНеЗаполнено(ДатаРасценки)) Тогда
		Если ДатаСоздания > ДатаРасценки Тогда
			дкДобавитьОшибку(Ошибки,"Дата создания дефектовки больше даты расценки.");
			Отказ=Истина;
		КонецЕсли; 
	КонецЕсли; 
	Если (НЕ обЗначениеНеЗаполнено(ДатаРасценки)) И (НЕ обЗначениеНеЗаполнено(ДатаПроведения)) Тогда
		Если ДатаРасценки > ДатаПроведения Тогда
			дкДобавитьОшибку(Ошибки,"Дата расценки дефектовки больше даты проведения.");
			Отказ=Истина;
		КонецЕсли; 
	КонецЕсли;
	
	//Если НЕ Отказ Тогда
	//	Если НЕ орЖурналСостояний(Ссылка) Тогда
	//		Отказ=Истина;
	//	КонецЕсли; 
	//КонецЕсли;
	
	Если Отказ Тогда
		Сообщить("При записи <"+СокрЛП(ЭтотОбъект)+"> обнаружены ошибки :",СтатусСообщения.Внимание);
		Сообщить(Ошибки,СтатусСообщения.БезСтатуса);
		Сообщить("Из-за возникших ошибок операция записи была отменена.",СтатусСообщения.Важное);
	КонецЕсли;
	
КонецПроцедуры

