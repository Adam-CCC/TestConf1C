Процедура КоманднаяПанельТоварыЗаполнение(Команда)
	Если Не Объект.ДокументОснование = Неопределено 
		И Не Объект.ДокументОснование.Пустая() 
		И Не Объект.ДокументОснование.Метаданные().ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
		Объект.Товары.Очистить();
		Об = Объект.ДокументОснование.ПолучитьОбъект();
		Для каждого Стр Из Об.Товары Цикл
			НоваяСтрока = Объект.Товары.Добавить();
