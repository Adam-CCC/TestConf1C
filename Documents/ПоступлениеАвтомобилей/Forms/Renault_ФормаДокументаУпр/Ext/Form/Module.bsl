&НаКлиенте
Процедура кнопкиТЧ(Команда)
	
	ИмяТЧ = ИмяТЧ();
	ИмяТЧОбъекта = ?(ИмяТЧ = "Оборудование","Товары",ИмяТЧ);
	
	Если ТекущийЭлемент.Имя = "кнДобавить" Тогда 
		СтрокаТЧ = Объект[ИмяТЧОбъекта].Добавить();
	ИначеЕсли ТекущийЭлемент.Имя = "кнУдалить" Тогда 
		Если Элементы[ИмяТЧ].ТекущаяСтрока = Неопределено Тогда 
			Возврат; 
		КонецЕсли;
		ТекСтрока = Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока);
		Если ТекСтрока <> Неопределено Тогда 
			Объект[ИмяТЧОбъекта].Удалить(ТекСтрока) 
		КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнОбновить" Тогда		
		Элементы[ИмяТЧ].Обновить();
	КонецЕсли;
	
	УправлениеЭлементами(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура(); 	
	ПараметрыФормы.Вставить("Ссылка",Объект.Ссылка); 	
	ПараметрыФормы.Вставить("ПодразделениеКомпании",Объект.ПодразделениеКомпании);	
	ПараметрыФормы.Вставить("Организация",Объект.Организация);	
	ПараметрыФормы.Вставить("Автор",Объект.Автор);	
	//ПараметрыФормы.Вставить("Менеджер",Объект.Менеджер);	
	//ПараметрыФормы.Вставить("Проект",Объект.Проект);	
	ПараметрыФормы.Вставить("РегламентированныйУчет",Объект.РегламентированныйУчет);
	Если ЕстьРеквизитОбъекта("ДокументОснование", Объект.Ссылка) 
		И Не Объект.ДокументОснование = Неопределено	
		И Не Объект.ДокументОснование.Пустая() Тогда
		ПараметрыФормы.Вставить("ДокументОснование",Объект.ДокументОснование);
	КонецЕсли;
	//ОткрытьФорму("Документ.ПоступлениеТоваров.Форма.ФормаВыборОбщихРеквизитов", ПараметрыФормы, ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.Renault_ВыборОбщихРеквизитов", ПараметрыФормы, ЭтаФорма, Новый УникальныйИдентификатор(),,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);	
КонецПроцедуры

Функция ЕстьРеквизитОбъекта(ИмяРеквизита, Объект) Экспорт
	
	МетаданныеОбъекта = Объект.Метаданные();
	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли; 
	
КонецФункции


&НаКлиенте
Процедура ВывестиЗаголовокСуммаДокумента(ЭтаФорма) Экспорт
	Если ЭтаФорма <> Неопределено Тогда
		// попытаемся пересчитать сумму документа
		
		Попытка 
			ВремСумма = Объект.Товары.Итог("СуммаВсего"); 
		Исключение 
		КонецПопытки;
		
		Попытка
			//Если ВремСумма <> ЭтаФорма.СуммаДокумента Тогда ЭтаФорма.СуммаДокумента = ВремСумма; КонецЕсли;
		Исключение
		КонецПопытки;	
		// обновим надпись валюты и суммы документа
		ТекстВалюта = "";
		Попытка	
			ТекстВалюта = "Валюта: " + СокрЛП(Объект.ВалютаДокумента) + " (" + Формат(Объект.КурсДокумента,"ЧДЦ = 4") + ")";
			Попытка
				Если ВремСумма <> Неопределено Тогда
					ТекстСумма = " ИТОГО: " + Формат(ВремСумма,"ЧДЦ = 2; ЧН = 0,00");
				КонецЕсли; 
			Исключение
			КонецПопытки;
			ЭтаФорма.Элементы.СуммаДокумента.Заголовок = ТекстВалюта + ТекстСумма;
		Исключение 
		КонецПопытки;
	КонецЕсли; 
КонецПроцедуры // ВывестиЗаголовокСуммаДокумента()

// Определяет заполнено ли переданное значение
//
// Параметры: 
//  Значение - Неопределено - Значение, заполнение которого надо проверить
//
// Возвращаемое значение:
//  Булево - Истина, если значение не заполнено, иначе ложь.
//
&НаСервере
Функция ЗначениеНеЗаполнено(Значение) Экспорт

	Результат = Ложь;
	
	Попытка
		Результат = Не ЗначениеЗаполнено(Значение)	
	Исключение // Мутабельные типы (Объекты)
		Результат = Ложь
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ЗначениеНеЗаполнено()

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗакрытьФормуВыбораОбщихРеквизитов" Тогда
		ЗаполнитьЗначенияСвойств(Объект,Параметр);
		ОрганизацияПодразделениеИндикация(ЭтаФорма);
	КонецЕсли;
	
	Если ИмяСобытия = "ЗакрытьФормуСчетФактуры" Тогда
		ВывестиЗаголовокСчетФактура();
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОрганизацияПодразделениеИндикация(ЭтаФорма) Экспорт
	
	Если ЭтаФорма <> Неопределено Тогда

		Попытка
			Сп = Новый СписокЗначений;
			Сп.Добавить(Объект.Организация);
			Сп.Добавить(Объект.ПодразделениеКомпании);
			Попытка
				Если Не ЗначениеНеЗаполнено(Объект.Проект) Тогда
					Сп.Добавить(Объект.Проект);
				КонецЕсли;
			Исключение
			КонецПопытки;

			Попытка
				Если Не ЗначениеНеЗаполнено(Объект.Автор) Тогда
					Сп.Добавить(Объект.Автор);
				КонецЕсли;
			Исключение
			КонецПопытки;

			Попытка
				Если Не ЗначениеНеЗаполнено(Объект.Менеджер) Тогда
					Сп.Добавить(Объект.Менеджер);
				КонецЕсли;
			Исключение
			КонецПопытки;
			ОрганизацияПодразделение = Сп;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)	 	
	ВывестиЗаголовокВзаиморасчеты(ЭтаФорма);
КонецПроцедуры


