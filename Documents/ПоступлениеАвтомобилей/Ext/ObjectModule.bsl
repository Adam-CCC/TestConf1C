//Бондаренко-- 20210122
Функция НайтиПодрДопОборудования(Подр)
	
	ПодразделениеПустое = Справочники.ПодразделенияКомпании.ПустаяСсылка();
	
	Если Не обЗначениеНеЗаполнено(Подр.ПодразделениеДОиВР) Тогда
		Возврат Подр.ПодразделениеДОиВР;
	ИначеЕсли Не обЗначениеНеЗаполнено(Подр.Родитель.ПодразделениеДОиВР) Тогда	
		Возврат Подр.Родитель.ПодразделениеДОиВР;
	ИначеЕсли Не обЗначениеНеЗаполнено(Подр.Родитель.Родитель.ПодразделениеДОиВР) Тогда	
		Возврат Подр.Родитель.Родитель.ПодразделениеДОиВР;
	Иначе
		Возврат ПодразделениеПустое;
	КонецЕсли; 
	
КонецФункции // НайтиПодразделениеДопОборудования(Подр)
