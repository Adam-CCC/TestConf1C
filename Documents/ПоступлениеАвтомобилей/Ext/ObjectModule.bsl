Процедура ПриЗаписи(Отказ)
	Если НЕ дкПриЗаписи(ЭтотОбъект, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если (Не Отказ) И ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		//Проверим VIN автомобилей
		Для Каждого СтрокаАвтомобиля Из Автомобили Цикл
			ТекVIN = СтрокаАвтомобиля.Автомобиль.VIN;
			
			Если СтрокаАвтомобиля.VIN = ТекVIN Тогда
				Если ПустаяСтрока(СтрокаАвтомобиля.VIN) Тогда
					Сообщить("У автомобиля <"+СокрЛП(СтрокаАвтомобиля.Автомобиль)+"> не задан VIN. Заполните VIN автомобиля.");
					Отказ = Истина;
				Иначе
					//ОбъектАвтомобиль = СтрокаАвтомобиля.Автомобиль.ПолучитьОбъект();
					
					//Бондаренко++ 20230317
					Хозяин = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
					Если ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилей ИЛИ ХозОперация = Справочники.ХозОперации.ПереходВСобственностьАвтомобилей Тогда
						Если Хозяин <> Организация.КонтрагентОрганизации Тогда
							Попытка 
								Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Организация.КонтрагентОрганизации, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин, Дата);		
							Исключение
							КонецПопытки; 
						КонецЕсли;
					КонецЕсли;
					//Бондаренко-- 20230317
					
					//Бондаренко++ 20251023
					ГаражныйНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГаражныйНомер,НачалоДня(Дата));
					Если СтрокаАвтомобиля.ГаражныйНомер <> ГаражныйНомер Тогда
						Если НЕ обЗначениеНеЗаполнено(СтрокаАвтомобиля.ГаражныйНомер) Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль,СтрокаАвтомобиля.ГаражныйНомер,Перечисления.ДополнительнаяИнформацияАвтомобилей.ГаражныйНомер,НачалоДня(Дата));
						КонецЕсли;
					КонецЕсли;		
					//Бондаренко-- 20251023
					
					//Бондаренко++ 20230202	
					Если Дата >= ДеньСКоторогоНуженВидАвто Тогда
						Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, СтрокаАвтомобиля.ВидАвтомобиля, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Дата);	
					Иначе 
						//Бондаренко-- 20230202	
						Если СтрокаАвтомобиля.АвтомобильБУ Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Перечисления.ВидАвтомобиля.АвтомобильСПробегом, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Дата);
						ИначеЕсли СтрокаАвтомобиля.АвтомобильНовый Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Перечисления.ВидАвтомобиля.Новый, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Дата);
							//Бондаренко++ 20230119
						ИначеЕсли СтрокаАвтомобиля.ПараллельныйИмпорт Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Перечисления.ВидАвтомобиля.ПараллельныйИмпортБУ, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Дата);
							//Бондаренко-- 20230119
						КонецЕсли;
						//Бондаренко++ 20230202	
					КонецЕсли;
					//Бондаренко-- 20230202	
					
					//Бондаренко++ 20161107
					Если СтрокаАвтомобиля.ДатаКонсигнации <> Дата(1,1,1) Тогда
						Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, СтрокаАвтомобиля.ДатаКонсигнации , Перечисления.ДополнительнаяИнформацияАвтомобилей.ДатаКонсигнации, Дата);	
					КонецЕсли;
					//Бондаренко-- 20161107 
					
					//Бондаренко++ 20241115
					Если СтрокаАвтомобиля.ДатаОкончанияОтсрочкиОплаты <> Дата(1,1,1) Тогда
						//Бондаренко-- 20241115	
						Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, СтрокаАвтомобиля.ДатаОкончанияОтсрочкиОплаты , Перечисления.ДополнительнаяИнформацияАвтомобилей.ДатаОкончанияОтсрочкиОплаты, Дата);	
						//Бондаренко++ 20241115		
					КонецЕсли;
					//Бондаренко-- 20241115	
					
					//Бондаренко++ 20220913
					Если СтрокаАвтомобиля.ПараллельныйИмпорт Тогда					
						Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Истина, Перечисления.ДополнительнаяИнформацияАвтомобилей.ПараллельныйИмпорт, Дата);
					Иначе     
						Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Ложь, Перечисления.ДополнительнаяИнформацияАвтомобилей.ПараллельныйИмпорт, Дата);	
					КонецЕсли;						
					//Бондаренко-- 20220913					
				КонецЕсли;
			ИначеЕсли НЕ ПустаяСтрока(СтрокаАвтомобиля.VIN) Тогда
				Если ПустаяСтрока(ТекVIN) Тогда
					ОбъектАвтомобиль = СтрокаАвтомобиля.Автомобиль.ПолучитьОбъект();
					ОбъектАвтомобиль.VIN = СтрокаАвтомобиля.VIN;
					//Получить последний ГосНомер
					ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ОбъектАвтомобиль.Ссылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
					ОбъектАвтомобиль.ФормированиеНаименованияАвтомобиля(ГосНомер);
					Попытка
						ТекстОшибки = "";
						ОбъектАвтомобиль.ПроверитьКорректность(ТекстОшибки);
						Если Не ПустаяСтрока(ТекстОшибки) Тогда
							Сообщить("Ошибка ввода VIN. В автомобиле <"+СокрЛП(СтрокаАвтомобиля.Автомобиль)+"> " + ТекстОшибки);
							Отказ = Истина;
							Продолжить;
						КонецЕсли;
						
						ОбъектАвтомобиль.Записать();
						Если СтрокаАвтомобиля.АвтомобильБУ Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(ОбъектАвтомобиль.Ссылка, Перечисления.ВидАвтомобиля.АвтомобильСПробегом, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Дата);
						ИначеЕсли СтрокаАвтомобиля.АвтомобильНовый Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(ОбъектАвтомобиль.Ссылка, Перечисления.ВидАвтомобиля.Новый, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Дата);
							//Бондаренко++ 20230119	
						ИначеЕсли СтрокаАвтомобиля.ПараллельныйИмпорт Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(ОбъектАвтомобиль.Ссылка, Перечисления.ВидАвтомобиля.ПараллельныйИмпортБУ, Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля, Дата);
							//Бондаренко-- 20230119
						КонецЕсли;
						
						//Бондаренко++ 20161107
						Если СтрокаАвтомобиля.ДатаКонсигнации <> Дата(1,1,1) Тогда
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(ОбъектАвтомобиль.Ссылка, СтрокаАвтомобиля.ДатаКонсигнации , Перечисления.ДополнительнаяИнформацияАвтомобилей.ДатаКонсигнации, Дата);	
						КонецЕсли;
						//Бондаренко-- 20161107 
						
						//Бондаренко++ 20241115
						Если СтрокаАвтомобиля.ДатаОкончанияОтсрочкиОплаты <> Дата(1,1,1) Тогда
							//Бондаренко-- 20241115	
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, СтрокаАвтомобиля.ДатаОкончанияОтсрочкиОплаты , Перечисления.ДополнительнаяИнформацияАвтомобилей.ДатаОкончанияОтсрочкиОплаты, Дата);	
							//Бондаренко++ 20241115 	
						КонецЕсли;	
						//Бондаренко-- 20241115 
						
						//Бондаренко++ 20220913
						Если СтрокаАвтомобиля.ПараллельныйИмпорт Тогда					
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Истина, Перечисления.ДополнительнаяИнформацияАвтомобилей.ПараллельныйИмпорт, Дата);
						Иначе     
							Справочники.Автомобили.ЗаписьЗначенияРегистраСведения(СтрокаАвтомобиля.Автомобиль, Ложь, Перечисления.ДополнительнаяИнформацияАвтомобилей.ПараллельныйИмпорт, Дата);	
						КонецЕсли;						
						//Бондаренко-- 20220913					
						
					Исключение
						Отказ = Истина;
						Возврат;
					КонецПопытки;
				Иначе
					Сообщить("Ошибка ввода VIN. В автомобиле <"+СокрЛП(СтрокаАвтомобиля.Автомобиль)+"> задан другой VIN.");
					//Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	дкУстановитьЗначениеДополнительногоСвойства(ЭтотОбъект,Отказ);
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если НЕ дкПередУдалением(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Если НЕ дкОбработкаУдаленияПроведения(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
	
	//Бондаренко++ 20231219
	Если Не обЗначениеНеЗаполнено(ДокументОснование) Тогда
		Если ТипЗНЧ(ДокументОснование)=Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
			
			ЗаказНаАвто = ДокументОснование.ПолучитьОбъект();
