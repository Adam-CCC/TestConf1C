Функция СМГ_ЕстьАвтоБезДиагностики()
	
	флЕстьАвтоБезДиагностики = Ложь; 
	
	//Бондаренко++ 20240418 
	//Проверка того, что подразделение не относится ни к Пойменной, ни к двум Таганрогам.
	Если НЕ ( ЭтотОбъект.ПодразделениеКомпании.ПринадлежитЭлементу(Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000223")) ИЛИ
		ЭтотОбъект.ПодразделениеКомпании.ПринадлежитЭлементу(Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ000199")) ИЛИ 
		ЭтотОбъект.ПодразделениеКомпании.ПринадлежитЭлементу(Справочники.ПодразделенияКомпании.НайтиПоКоду("ЦБ001517")) 
		) Тогда
		//Бондаренко-- 20240418		
		Если Дата >= Дата(2022,5,20) Тогда
			
			//Получаем список автомобилей б/у из табличной части <Автомобили>
			СписокБУавто = СМГ_ПолучитьСписокБУавто();
			
			//Получаем список закрытых заказ-нарядов, с видом ремонта <Диагностика Trade-In>, по списку б/у авто из предыдущего запроса, за последние две недели.
			ТаблицаЗН = СМГ_ПолучитьТаблицуЗН(СписокБУавто);
			
			//Каждый автомобиль из списка б/у пытаемся найти в таблице заказ-нарядов.
			
			ТекстОшибки = "";
			
			Для Каждого ТекБуАвто Из СписокБУавто Цикл
				
				Отбор = Новый Структура();
				Отбор.Вставить("Автомобиль",ТекБуАвто);
				НайдСтроки = ТаблицаЗН.НайтиСтроки(Отбор);
				
				Если НайдСтроки.Количество() = 0 Тогда
					ТекСообщениеОбОшибке = ""+СокрЛП(ТекБуАвто)+" - нет заказ-наряда ""Диагностика Trade-In"""; 
					Если НЕ ТекстОшибки = "" Тогда
						ТекстОшибки = ТекстОшибки +","+Символы.ПС+ ТекСообщениеОбОшибке;
					Иначе	
						ТекстОшибки = ТекСообщениеОбОшибке;									
					КонецЕсли;
					флЕстьАвтоБезДиагностики = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если флЕстьАвтоБезДиагностики Тогда                                
				ТекстОшибки = ТекстОшибки +".";
				СМГ_Предупреждение(ТекстОшибки,,"Запрещено проводить поступление автомобилей без диагностики Trade-In");
			КонецЕсли;
			
		КонецЕсли; 
		//Бондаренко++ 20220527	
	КонецЕсли;
	//Бондаренко-- 20220527
	
	Возврат флЕстьАвтоБезДиагностики;
	
КонецФункции // СМГ_ЕстьАвтоБезДиагностики()

