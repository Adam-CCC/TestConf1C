		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();  		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Приложение1"));  
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();    
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Приложение2")); 
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
