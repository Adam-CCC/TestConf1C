Функция СМГ_НетСделкиАвтохаб()
	Если РольДоступна("ПолныеПрава") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НетСделки = Ложь;
	мзОбъявление = РегистрыСведений.ОбъявленияНаАвтохаб.СоздатьМенеджерЗаписи();
	Для Каждого СтрокаАвто Из Автомобили Цикл
		Если СтрокаАвто.АвтомобильБУ Тогда
			мзОбъявление.Автомобиль = СтрокаАвто.Автомобиль;
			мзОбъявление.Прочитать();
			Если мзОбъявление.Выбран() Тогда
				Если Не мзОбъявление.ОсмотрПроведен Тогда
					Сообщить("ЗАПРЕЩЕНО проводить Поступление без завершения Осмотра " + Строка(СтрокаАвто.Автомобиль) +
					" на Автохаб!", СтатусСообщения.ОченьВажное);
					НетСделки = Истина;
				КонецЕсли;
				
			Иначе
				Сообщить("ЗАПРЕЩЕНО проводить Поступление без регистрации Сделки для " + Строка(СтрокаАвто.Автомобиль) +
				" на Автохаб!", СтатусСообщения.ОченьВажное);
				НетСделки = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НетСделки;
КонецФункции
