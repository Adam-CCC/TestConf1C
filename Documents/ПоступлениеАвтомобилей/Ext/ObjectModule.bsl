//Овечкин ++ 20260830
Функция ПоследнимВладельцемАвтоБылЮрик(Авто)
	
	ПоследнимВладельцемАвтоБылЮрик = Ложь;
	
  	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Автомобили.Период КАК Период,
		|	Автомобили.Автомобиль КАК Автомобиль,
		|	Автомобили.ВидЗначения КАК ВидЗначения,
		|	Автомобили.Значение КАК Значение,
		|	Автомобили.Значение.НашаФирма КАК ЗначениеНашаФирма,
		|	Автомобили.Значение.ФормаСобственности КАК ЗначениеФормаСобственности
		|ИЗ
		|	РегистрСведений.Автомобили КАК Автомобили
		|ГДЕ
		|	Автомобили.Автомобиль = &Автомобиль
		|	И Автомобили.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)
		|	И НЕ Автомобили.Значение.НашаФирма
		|	И Автомобили.Значение.ФормаСобственности = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЮридическоеЛицо)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Автомобиль",Авто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПоследнимВладельцемАвтоБылЮрик = Истина;
		Прервать;
	КонецЦикла;
	
	Возврат ПоследнимВладельцемАвтоБылЮрик;
 
КонецФункции
