		КонецЕсли;
		
		Для Каждого СтрокаАвто Из Автомобили Цикл                               
			
			НомерСтроки = СтрокаАвто.НомерСтроки;
			
			СтрокаАвто.VIN = СтрокаАвто.Автомобиль.VIN;
			СтрокаАвто.АвтомобильБезЗаказа = Ложь;                                                                                                                               
			СтрокаАвто.ВидАвтомобиля = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаАвто.Автомобиль,Перечисления.ДополнительнаяИнформацияАвтомобилей.ВидАвтомобиля,Дата_);
			СтрокаАвто.ЗаказНаАвтомобиль = ДокументОснование;
			Если СтрокаАвто.ВидАвтомобиля = Перечисления.ВидАвтомобиля.Новый Тогда
				СтрокаАвто.АвтомобильНовый = Истина;
				СтрокаАвто.АвтомобильБУ = Ложь;
				СтрокаАвто.ПараллельныйИмпорт = Ложь;
			ИначеЕсли СтрокаАвто.ВидАвтомобиля = Перечисления.ВидАвтомобиля.АвтомобильСПробегом Тогда	
				СтрокаАвто.АвтомобильНовый = Ложь;
				СтрокаАвто.АвтомобильБУ = Истина;
				СтрокаАвто.ПараллельныйИмпорт = Ложь;
			ИначеЕсли СтрокаАвто.ВидАвтомобиля = Перечисления.ВидАвтомобиля.ПараллельныйИмпорт Тогда	
				СтрокаАвто.АвтомобильНовый = Истина;
				СтрокаАвто.АвтомобильБУ = Ложь;
				СтрокаАвто.ПараллельныйИмпорт = Истина;
			ИначеЕсли СтрокаАвто.ВидАвтомобиля = Перечисления.ВидАвтомобиля.ПараллельныйИмпортБУ Тогда	
				СтрокаАвто.АвтомобильНовый = Ложь;
				СтрокаАвто.АвтомобильБУ = Истина;
				СтрокаАвто.ПараллельныйИмпорт = Истина;
			КонецЕсли;
			
			ОбработкаРеквизита("Автомобили.Автомобиль",СтрокаАвто);
			
		КонецЦикла;
		//Бондаренко-- 20241130	 
	КонецЕсли;
	// Семенихин 19.03.2021 -----
	
	//Бондаренко++ 20241130
	
	СкладКомпании = НайтиСкладДляПоступленияАвто(ПодразделениеКомпании);
	//Бондаренко-- 20241130
КонецПроцедуры

//Бондаренко++ 20241130
Функция НайтиСкладДляПоступленияАвто(ПодразделениеКомпании) Экспорт
	
	СкладДляПоступленияАвто_ = Неопределено;
	
	СписокОрганизаций = Новый СписокЗначений;
	
	//Иванченко 2025112 ++
	//Если ЗначениеЗаполнено(ПодразделениеКомпании.ПерепродажаАвто) Тогда          
	Если ЗначениеЗаполнено(ПодразделениеКомпании.ПерепродажаАвто) И Не ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилейКомиссия Тогда          
		//Иванченко 2025112 --		
		СписокОрганизаций.Добавить(ПодразделениеКомпании.ПерепродажаАвто);
	Иначе
		СписокОрганизаций.Добавить(ПодразделениеКомпании.Организация);
	КонецЕсли;
	
	Если СписокОрганизаций.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СкладыКомпании.Ссылка КАК Склад,
		|	СкладыКомпании.ПометкаУдаления КАК ПометкаУдаления,
		|	СкладыКомпании.ЭтоГруппа КАК ЭтоГруппа,
		|	СкладыКомпании.Подразделение КАК Подразделение,
		|	СкладыКомпании.ТипСклада КАК ТипСклада,
		|	СкладыКомпании.ВидСклада КАК ВидСклада,
		|	СкладыКомпании.Организация КАК Организация,
		|	СкладыКомпании.Основной КАК Основной
		|ИЗ
		|	Справочник.СкладыКомпании КАК СкладыКомпании
		|ГДЕ
		|	НЕ СкладыКомпании.ПометкаУдаления
		|	И НЕ СкладыКомпании.ЭтоГруппа
		|	И СкладыКомпании.ТипСклада = &ТипСклада
		|	И СкладыКомпании.ВидСклада = &ВидСклада
		|	И СкладыКомпании.Подразделение В ИЕРАРХИИ(&Подразделение)
		|	И СкладыКомпании.Организация В(&СписокОрганизаций)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Основной УБЫВ";
		
		Запрос.УстановитьПараметр("ТипСклада",Перечисления.ТипыСкладов.Автомобильный);
		Запрос.УстановитьПараметр("ВидСклада",Перечисления.ВидыСкладов.Обычный);
		Запрос.УстановитьПараметр("Подразделение",ПодразделениеКомпании);
		Запрос.УстановитьПараметр("СписокОрганизаций",СписокОрганизаций);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СкладДляПоступленияАвто_ = ВыборкаДетальныеЗаписи.Склад;
			Прервать;
		КонецЦикла;
		
	Иначе	
		
		СМГ_Сообщить("ОШИБКА! Не найдена организация для поступления автомобилей.",СтатусСообщения.ОченьВажное);	
		
	КонецЕсли;
	
	Если СкладДляПоступленияАвто_ = Неопределено Тогда
		СМГ_Сообщить("ОШИБКА! Не найден склад для поступления авто по подразделению """+ПодразделениеКомпании.ПерепродажаАвто+"""",СтатусСообщения.ОченьВажное);
	КонецЕсли;
	
	Возврат СкладДляПоступленияАвто_;
	
КонецФункции // НайтиСкладПоступленияАвто()
//Бондаренко-- 20241130

Процедура ПриКопировании(ОбъектКопирования)
	Если НЕ дкПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда Возврат; КонецЕсли;
КонецПроцедуры

//Бондаренко++ 20251024	
Функция ПолучитьОстатокАвтоНаТД(Авто_)
	
	ОстатокАвто_  = 0;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
	|	ОстаткиАвтомобилейОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиАвтомобилей.Остатки КАК ОстаткиАвтомобилейОстатки
	|ГДЕ
	|	ОстаткиАвтомобилейОстатки.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", Авто_);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() > 0 Тогда
		ОстатокАвто_ = ТЗ[0].КоличествоОстаток;
	КонецЕсли;
	
	Возврат ОстатокАвто_;
	
КонецФункции // ПолучитьОстатокАвтоНаТД(Авто_) 
