	//Иванченко 20260803 --	
	
	// Процедура осуществляет печать документа. Можно направить печать на 
	// экран или принтер, а также распечатать необходимое количество копий.
	// Параметры: НазваниеМакета - строка, название макета, если пусто - то по умолчанию,
	//   Документ - сюда можно передать уже созданный табличный документ для заполнения
	Функция Печать(НазваниеПечатнойФормы="", КоличествоЭкземпляров=1, НаПринтер=Ложь, Документ=Неопределено) Экспорт
		// Вызов конкретно печатной формы и печать результата прописано в общем модуле
		// здесь могут быть вставлены дополнительные механизмы
		Возврат дкПечать(ЭтотОбъект, НазваниеПечатнойФормы, КоличествоЭкземпляров, НаПринтер, Документ);
	КонецФункции
	
	// Возвращает доступные варианты печати документа
	// Возвращаемое значение: Структура, каждая строка которой
	// соответствует одному из вариантов печати
	// Первый элемент структуры - форма по умолчанию
	Функция ПолучитьСписокПечатныхФорм() Экспорт
		СтруктураМакетов=Новый Структура();
		СтруктураМакетов.Вставить("ПоступлениеАвтомобилей", "Приходная накладная");
		СтруктураМакетов.Вставить("АктПриема", "Акт приема на комиссию"); 
		//Иванченко 20251209 ++  	
		//СтруктураМакетов.Вставить("ДоговорКомиссии", "Договор комиссии");
		
		Если ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилейКомиссия Тогда  
			СтруктураМакетов.Вставить("ДоговорКомиссии", "Агентский договор");
			//СтруктураМакетов.Вставить("ДоговорКомиссииЮР", "Агентский договор (юр.лицо)") 
		//Иванченко 20260803 ++	
			СтруктураМакетов.Вставить("ДоговорКомиссииВыходногоДня", "Агентский договор (краткосрочная экспозиция)");
		//Иванченко 20260803 --	
		КонецЕсли;
		
		//Иванченко 20251209 --	
		СтруктураМакетов.Вставить("ТОРГ1",  "ТОРГ-1 (Акт о приемке товара)");
		СтруктураМакетов.Вставить("ТОРГ4",  "ТОРГ-4 (Акт о приемке товаров без счета поставщика)");
		СтруктураМакетов.Вставить("ТОРГ12", "ТОРГ-12 (Товарная накладная за поставщика)");
		СтруктураМакетов.Вставить("ТОРГ13", "ТОРГ-13 (накладная на внутреннее перемещение)");
		СтруктураМакетов.Вставить("М4", "М-4 (Приходный ордер)");
		// +++++ Соколмоторс +++++
