Функция НайтиОАБР(Авто)
	
	ОАБР_ = "";
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтгрузкаАвтомобиляБезРеализации.Ссылка КАК Ссылка,
	|	ОтгрузкаАвтомобиляБезРеализации.Дата КАК Дата,
	|	ОтгрузкаАвтомобиляБезРеализации.Автомобиль КАК Автомобиль
	|ИЗ
	|	Документ.ОтгрузкаАвтомобиляБезРеализации КАК ОтгрузкаАвтомобиляБезРеализации
	|ГДЕ
	|	ОтгрузкаАвтомобиляБезРеализации.Автомобиль = &Автомобиль
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобили[0].Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОАБР_ = ВыборкаДетальныеЗаписи.Ссылка;
		Прервать; 
	КонецЦикла;
	
	Возврат ОАБР_; 
	
КонецФункции //НайтиОАБР(Авто)
