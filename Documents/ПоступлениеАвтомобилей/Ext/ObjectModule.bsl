		//Иванченко 20260125 -- 
		
		
		Макет = ПолучитьМакет("ДоговорКомиссии");  
		ЗаполнитьЗначенияСвойств(Макет.Параметры, СтруктураПараметров);	  
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Шапка")); 
		
		Для Счетчик = 1 По 12 Цикл  
