Функция СМГ_ПолучитьТаблицуЗН(СписокБУавто)
	
	ТЗ = Новый ТаблицаЗначений;
	
	Запрос = Новый Запрос;                                                                        
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаряд.Ссылка,
	|	ЗаказНаряд.Автомобиль
	|ИЗ
	|	Документ.ЗаказНаряд КАК ЗаказНаряд
	|ГДЕ
	|	ЗаказНаряд.Дата >= &Дата
	|	И ЗаказНаряд.Проведен
	|	И ЗаказНаряд.ВидРемонта = &ВидРемонта
	|	И ЗаказНаряд.Состояние = &Состояние
	|	И ЗаказНаряд.Автомобиль В(&СписокБУавто)";
	
	Запрос.УстановитьПараметр("ВидРемонта", Справочники.ВидыРемонта.ДиагностикаТрейдИн);
	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата-86400)); // Сегодня или вчера
	Запрос.УстановитьПараметр("Состояние", Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	Запрос.УстановитьПараметр("СписокБУавто", СписокБУавто);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗ;
	
КонецФункции // СМГ_ПолучитьТаблицуЗН(СписокБУавто)
