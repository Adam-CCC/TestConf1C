				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;   
			
			ТабДокумент.Вывести(ТекущаяОбласть);	
		КонецЦикла;  
		
		//Иванченко 20251223 ++  
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();  		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Приложение1"));  
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();    
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Приложение2")); 
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("Приложение4"));  
		//Иванченко 20251223 --
		
		//Иванченко 20260127 ++		
		ТабДокумент.ПовторятьПриПечатиСтроки = ТабДокумент.Область(1,, 1); 
		//Иванченко 20260127 --		
		ЗаполнитьСвойстваТабДока(ТабДокумент, ТипДвустороннейПечати.ПереворотВлево);
		
		Возврат ТабДокумент;   		
		
	КонецФункции  
	
