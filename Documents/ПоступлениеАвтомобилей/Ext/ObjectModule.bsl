Функция НайтиСкладАвтомобильный(Подразделение)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкладыКомпании.Ссылка,
	|	СкладыКомпании.ПометкаУдаления,
	|	СкладыКомпании.ЭтоГруппа,
	|	СкладыКомпании.Подразделение,
	|	СкладыКомпании.Организация,
	|	СкладыКомпании.ВидСклада,
	|	СкладыКомпании.ТипСклада,
	|	СкладыКомпании.Основной КАК Основной
	|ИЗ
	|	Справочник.СкладыКомпании КАК СкладыКомпании
	|ГДЕ
	|	НЕ СкладыКомпании.ПометкаУдаления
	|	И НЕ СкладыКомпании.ЭтоГруппа
	|	И СкладыКомпании.Подразделение = &Подразделение
	|	И СкладыКомпании.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.Автомобильный)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Основной УБЫВ";
	
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	СМГ_Сообщить("ОШИБКА! Не найден автомобильный склад для подразделения "+Подразделение,СтатусСообщения.ОченьВажное);
	
	Возврат Справочники.СкладыКомпании.ПустаяСсылка();
	
КонецФункции // НайтиСклад(Организация,Подразделение)

Функция НайтиСоздатьДоговор(Владелец,Организация,Подразделение,ВидДоговора) Экспорт
	
	НовДоговор = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка,
	|	ДоговорыВзаиморасчетов.ВидДоговора КАК ВидДоговора,
	|	ДоговорыВзаиморасчетов.Организация КАК Организация,
	|	ДоговорыВзаиморасчетов.ДляПерепродажАвтомобилей КАК ДляПерепродажАвтомобилей,
	|	ДоговорыВзаиморасчетов.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	|ГДЕ
	|	ДоговорыВзаиморасчетов.Владелец = &Владелец
	|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
	|	И ДоговорыВзаиморасчетов.Организация = &Организация
	|	И ДоговорыВзаиморасчетов.ДляПерепродажАвтомобилей
	|	И НЕ ДоговорыВзаиморасчетов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовДоговор = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	НовДоговор.Владелец = Владелец;
	НовДоговор.УстановитьНовыйКод("");
	НовДоговор.ВидДоговора = ВидДоговора;
	НовДоговор.Автор = ПараметрыСеанса.Пользователь; 
	НовДоговор.ДатаСоздания = ТекущаяДата();
	НовДоговор.ДатаНачала = НачалоДня(ТекущаяДата());
	НовДоговор.Организация = Организация;
	НовДоговор.Подразделение = Подразделение;
	НовДоговор.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	Новдоговор.ДатаНачала = ТекущаяДата();
	НовДоговор.ТипДоговора = Перечисления.ТипыДоговоров.Договор;
	НовДоговор.ВидОплаты = Перечисления.ВидыОплаты.ПроизвольнаяОплата;
	НовДоговор.ДляАвтосалона = Истина;
	НовДоговор.ДляПерепродажАвтомобилей = Истина;
	НовДоговор.СформироватьНаименование(); 
	
	//Попытка
	НовДоговор.Записать();
	//Исключение
	//	СМГ_Сообщить("ОШИБКА! Не удалось создать новый договор поставки для "+Владелец);	
	//КонецПопытки;
	
	Возврат НовДоговор.Ссылка;
	
КонецФункции // НайтиСоздатьДоговор(Владелец,Организация,ВидДоговора)
