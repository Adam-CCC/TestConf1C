
Функция ПолучитьДанныеПечати(знач МассивДокументов, знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, ПолучитьДанныеОбъекта(ОбъектСсылка, ИмяМакета));
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ОписаниеОбластей.Вставить(ИмяМакета, ПолучитьОписаниеОбластейМакетаОфисногоДокумента());
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие;
	
	Для Каждого ИмяМакета Из МассивИменМакетов Цикл
		Если ИмяМакета = "ПФ_DOC_ТестДрайвШаблон" Тогда
			ДвоичныеДанныеМакетов.Вставить(ИмяМакета, Renault_УправлениеПечатью.ПолучитьМакет("Документ.CRM_ЗаписьНаТестДрайв.ПФ_DOC_ТестДрайвШаблон"));
			ТипыМакетов.Вставить(ИмяМакета, "DOC");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Данные, Макеты",
							ДанныеПоВсемОбъектам,
							Новый Структура("ОписаниеОбластей, ТипыМакетов, ДвоичныеДанныеМакетов",
											ОписаниеОбластей,
											ТипыМакетов,
											ДвоичныеДанныеМакетов));
	
КонецФункции

Функция ПолучитьДанныеОбъекта(СсылкаНаОбъект, ИмяМакета)
	
	Объект = СсылкаНаОбъект.ПолучитьОбъект();
	
	Advanced = Renault_Привилегированный.ИспользуетсяФункционалAdvanced();
	
	Клиент = Объект.Клиент;
	Дата = Объект.ДатаПроведения;
	Автомобиль = Объект.Автомобиль;
	Модель = Объект.Автомобиль.Модель.Наименование;
	ГодВыпуска = Объект.Автомобиль;
	VIN = Объект.Автомобиль.VIN;
	НомерКузова = Объект.Автомобиль.НомерКузова;
	ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СсылкаНаОбъект.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	Цвет = Объект.Автомобиль.Цвет.Наименование;
	Начало = Объект.Начало;
	Окончание = Объект.Начало + Объект.Продолжительность*60;
	Менеджер = Объект.Менеджер.Наименование;
	Маршрут = Объект.Маршрут.Наименование;
	Продолжительность = ?(ЗначениеЗаполнено(Объект.Продолжительность),Формат(Объект.Продолжительность,"ЧЦ=3") + " мин.","");
	КилометражНаНачало = Объект.КилометражНаНачало;
	КилометражНаКонец = Объект.КилометражНаКонец;
	Пробег = КилометражНаКонец - КилометражНаНачало; 
	
	Организация = Справочники.Организации.ПустаяСсылка();
	ДЦ = Объект.ДилерскийЦентр;
	Если ЗначениеЗаполнено(ДЦ) Тогда
		Организация = Дц.Организация;
	Иначе
		ДЦ = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
		Если ЗначениеЗаполнено(ДЦ) Тогда
			Организация = ДЦ.Организация;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеОбъекта = Новый Структура;
	
	Если Advanced Тогда
		ДанныеОбъекта.Вставить("Дата",			Строка(Формат(Дата, "ДФ=dd.MM.yyyy")));
	Иначе	
		ДанныеОбъекта.Вставить("Дата",			Строка(Формат(Дата, "ДФ='дд ММММ гггг'")));
	КонецЕсли;
	ДанныеОбъекта.Вставить("Модель",		Модель);
	ДанныеОбъекта.Вставить("Цвет",			Цвет);
	ДанныеОбъекта.Вставить("ГосНомер",		ГосНомер);
	ДанныеОбъекта.Вставить("НомерКузова",	НомерКузова);
	ДанныеОбъекта.Вставить("VIN",			VIN);
	ДанныеОбъекта.Вставить("Начало",		Формат(Начало, "ДФ=ЧЧ:мм"));
	ДанныеОбъекта.Вставить("Окончание",		Формат(Окончание, "ДФ=ЧЧ:мм"));		
	ДанныеОбъекта.Вставить("ФИОМенеджера",	Менеджер);
	ДанныеОбъекта.Вставить("Маршрут"	,	Маршрут);
	ДанныеОбъекта.Вставить("Продолжительность"	,	Продолжительность);		
	ДанныеОбъекта.Вставить("КилометражНаНачало",	КилометражНаНачало);
	ДанныеОбъекта.Вставить("КилометражНаКонец"	,	КилометражНаКонец);
	ДанныеОбъекта.Вставить("Пробег"	,	Пробег);
	
	Запрос = Новый Запрос;                
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаКлиентов.НаименованиеПолное,
	               |	ТаблицаКлиентов.Фамилия,
	               |	ТаблицаКлиентов.Имя,
	               |	ТаблицаКлиентов.Отчество,
	               |	ТаблицаКлиентов.ДатаРождения,
	               |	ТаблицаКлиентов.Пол,
	               |	CRM_КлиентскиеДанные.ПредложенияИЗамечания,
	               |	CRM_КлиентскиеДанные.ПричинаВыбораМарки,
	               |	CRM_КлиентскиеДанные.МаркаТекущегоАвтомобиля,
	               |	CRM_КлиентскиеДанные.МаркаПредыдущегоАвтомобиля,
	               |	CRM_КлиентскиеДанные.ДатаСоздания,
	               |	CRM_КлиентскиеДанные.ИсточникИнформации,
	               |	CRM_КлиентскиеДанные.Город,
	               |	КонтактнаяИнформация_ТелефонСотовый.Представление КАК ТелефонСотовый,
	               |	КонтактнаяИнформация_Email.Представление КАК ОсновнойEmail,
	               |	ПодтверждающиеДокументы_Паспорт.Серия КАК ПаспортСерия,
	               |	ПодтверждающиеДокументы_Паспорт.Номер КАК ПаспортНомер,
	               |	ПодтверждающиеДокументы_Паспорт.ДатаВыдачи КАК ПаспортДатаВыдачи,
	               |	ПодтверждающиеДокументы_Паспорт.КемВыдан КАК ПаспортКемВыдан,
	               |	ПодтверждающиеДокументы_ВУ.Серия КАК ВУСерия,
	               |	ПодтверждающиеДокументы_ВУ.Номер КАК ВУНомер,
	               |	ПодтверждающиеДокументы_ВУ.ДатаВыдачи КАК ВУДатаВыдачи,
	               |	ПодтверждающиеДокументы_ВУ.КемВыдан КАК ВУКемВыдано,
	               |	КонтактнаяИнформация_АдресФактический.Представление КАК АдресФактический,
	               |	КонтактнаяИнформация_АдресЮридический.Представление КАК АдресЮридический,
	               |	КонтактнаяИнформация_АдресЮридический.Представление КАК АдресПрописки,
	               |	ТаблицаКлиентов.ФормаСобственности,
	               |	ТаблицаКлиентов.ИНН,
	               |	ТаблицаКлиентов.КПП,
	               |	CRM_КлиентскиеДанные.ПодписантВЛице,
	               |	CRM_КлиентскиеДанные.ПодписантНаОсновании,
	               |	CRM_КлиентскиеДанные.ПодписантПодпись,
	               |	CRM_КлиентскиеДанные.ПодписантДолжность,
	               |	ТаблицаКлиентов.ОсновнойБанковскийСчет,
	               |	ТаблицаКлиентов.Наименование,
	               |	КонтактнаяИнформацияДилер_АдресФактический.Представление КАК ДилерАдресФактический,
	               |	КонтактнаяИнформацияДилер_АдресФактический.Поле4 КАК ДилерГород,
	               |	КонтактнаяИнформацияДилер_АдресЮридический.Представление КАК ДилерАдресЮридический,
	               |	КонтактнаяИнформацияДилер_Телефон.Представление КАК ДилерТелефон,
	               |	Организации.НаименованиеПолное КАК ДилерНаименованиеПолное,
	               |	Организации.ИНН КАК ДилерИНН,
	               |	Организации.КПП КАК ДилерКПП,
	               |	Организации.ОсновнойБанковскийСчет.Банк КАК ДилерБанк,
	               |	Организации.ОсновнойБанковскийСчет.Банк.Код КАК ДилерБИК,
	               |	Организации.ОсновнойБанковскийСчет КАК ДилерСчет,
	               |	Организации.ОсновнойБанковскийСчет.Банк.КоррСчет КАК ДилерКоррСчет,
	               |	Renault_ДопИнформацияПоВерсиям.МощностьКВТ,
	               |	Renault_ДопИнформацияПоВерсиям.МощностьЛС,
	               |	Renault_ДопИнформацияПоВерсиям.ОбъемДвигателя,
	               |	Renault_ДопИнформацияПоВерсиям.МинимальнаяМасса,
	               |	Renault_ДопИнформацияПоВерсиям.МаксимальнаяМасса,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.TypeTS КАК ТипТС,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.NaimProiz КАК Изготовитель,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.PTS_SERIE + "" "" + CRM_СостояниеАвтомобилейПроизводителя_v2.PTS_NUM КАК ПаспортТС,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.CategTS КАК КатегорияТС,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.YEAR КАК ГодВыпуска,
	               |	ЕСТЬNULL(CRM_СостояниеАвтомобилейПроизводителя_v2.MarkTS, Renault_ЗаявкаНаТрейдИн.ПроизводительКод) КАК Марка,
	               |	ЕСТЬNULL(CRM_СостояниеАвтомобилейПроизводителя_v2.ModelTS, Renault_ЗаявкаНаТрейдИн.МодельКод) КАК Модель,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.ENGINE_NUM КАК НомерДвигателя,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.NaimProiz КАК ОрганизацияИзготовительПТС,
	               |	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_PTS КАК ДатаПТС,
	               |	CRM_ЗаписьНаТестДрайв.Начало КАК ВремяНачала,
	               |	CRM_ЗаписьНаТестДрайв.ДатаПроведения,
	               |	ЕСТЬNULL(CRM_СостояниеАвтомобилейПроизводителя_v2.VIN, Renault_ЗаявкаНаТрейдИн.VIN) КАК VIN,
	               |	Renault_ЗаявкаНаТрейдИн.ГосНомер,
	               |	Renault_ЗаявкаНаТрейдИн.НомерКузова,
	               |	Renault_ЗаявкаНаТрейдИн.Цвет,
	               |	СведенияКомпанииСрезПоследних.Значение КАК ДилерРуководитель,
	               |	Renault_ДоговорСоставДоговора.ПТС КАК ПТС,
	               |	Renault_ДоговорСоставДоговора.Ссылка.Дата КАК ДатаДоговора,
	               |	Renault_ДоговорСоставДоговора.Ссылка.Номер КАК НомерДоговора
	               |ИЗ
	               |	Документ.CRM_ЗаписьНаТестДрайв КАК CRM_ЗаписьНаТестДрайв
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияКомпании.СрезПоследних КАК СведенияКомпанииСрезПоследних
	               |			ПО Организации.Ссылка = СведенияКомпанииСрезПоследних.Организация
	               |				И (СведенияКомпанииСрезПоследних.Объект = ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСведений.Руководитель))
	               |		ПО (Организации.Ссылка = &Организация)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_ПотенциальныеКонтрагенты КАК ТаблицаКлиентов
	               |		ПО CRM_ЗаписьНаТестДрайв.Клиент = ТаблицаКлиентов.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияДилер_АдресФактический
	               |		ПО (&Организация = КонтактнаяИнформацияДилер_АдресФактический.Объект)
	               |			И (КонтактнаяИнформацияДилер_АдресФактический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияДилер_АдресЮридический
	               |		ПО (&Организация = КонтактнаяИнформацияДилер_АдресЮридический.Объект)
	               |			И (КонтактнаяИнформацияДилер_АдресЮридический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияДилер_Телефон
	               |		ПО (&Организация = КонтактнаяИнформацияДилер_Телефон.Объект)
	               |			И (КонтактнаяИнформацияДилер_Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	               |			И (КонтактнаяИнформацияДилер_Телефон.ЗначениеПоУмолчанию = ИСТИНА)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанные
	               |		ПО (CRM_КлиентскиеДанные.Клиент = CRM_ЗаписьНаТестДрайв.Клиент)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_ТелефонСотовый
	               |		ПО CRM_ЗаписьНаТестДрайв.Клиент = КонтактнаяИнформация_ТелефонСотовый.Объект
	               |			И (КонтактнаяИнформация_ТелефонСотовый.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	               |			И (КонтактнаяИнформация_ТелефонСотовый.ЗначениеПоУмолчанию = ИСТИНА)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_Email
	               |		ПО CRM_ЗаписьНаТестДрайв.Клиент = КонтактнаяИнформация_Email.Объект
	               |			И (КонтактнаяИнформация_Email.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	               |			И (КонтактнаяИнформация_Email.ЗначениеПоУмолчанию = ИСТИНА)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы_Паспорт
	               |		ПО CRM_ЗаписьНаТестДрайв.Клиент = ПодтверждающиеДокументы_Паспорт.Владелец
	               |			И (ПодтверждающиеДокументы_Паспорт.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Паспорт))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы_ВУ
	               |		ПО CRM_ЗаписьНаТестДрайв.Клиент = ПодтверждающиеДокументы_ВУ.Владелец
	               |			И (ПодтверждающиеДокументы_ВУ.ВидПодтверждающегоДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументов.Удостоверение))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_АдресЮридический
	               |		ПО CRM_ЗаписьНаТестДрайв.Клиент = КонтактнаяИнформация_АдресЮридический.Объект
	               |			И (КонтактнаяИнформация_АдресЮридический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация_АдресФактический
	               |		ПО CRM_ЗаписьНаТестДрайв.Клиент = КонтактнаяИнформация_АдресФактический.Объект
	               |			И (КонтактнаяИнформация_АдресФактический.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ДопИнформацияПоВерсиям КАК Renault_ДопИнформацияПоВерсиям
	               |		ПО CRM_ЗаписьНаТестДрайв.Автомобиль.ВариантКомплектации = Renault_ДопИнформацияПоВерсиям.ВариантКомплектации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	               |		ПО CRM_ЗаписьНаТестДрайв.Автомобиль.VIN = CRM_СостояниеАвтомобилейПроизводителя_v2.VIN
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	               |		ПО CRM_ЗаписьНаТестДрайв.Автомобиль = Renault_ЗаявкаНаТрейдИн.Автомобиль
	               |			И (Renault_ЗаявкаНаТрейдИн.Статус = ЗНАЧЕНИЕ(Перечисление.Renault_CRM_СтатусЗаявокТрейдИн.ОформлениеЗавершено))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
