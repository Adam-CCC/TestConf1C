&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		ЗаполнитьЗначенияСвойств(Объект,Параметры);
		Если НЕ ЗначениеЗаполнено(Объект.ДатаПроведения) Тогда
			Объект.ДатаПроведения = ТекущаяДата();
		КонецЕсли;		
		Объект.Организация = ПараметрыСеанса.Организация;
		//Организацию и подразделение - если не заполнены в пользователе - берем первые попавшиеся из справочника
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Организации.Ссылка
			|ИЗ
			|	Справочник.Организации КАК Организации
			|
			|УПОРЯДОЧИТЬ ПО
			|	Организации.Наименование";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Объект.Организация = Выборка.Ссылка;
			КонецЕсли;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В карточке пользователя не указана организация";
			Сообщение.Сообщить();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ПодразделенияКомпании.Ссылка
			|ИЗ
			|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
			|
			|УПОРЯДОЧИТЬ ПО
			|	ПодразделенияКомпании.Наименование";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Объект.Организация = Выборка.Ссылка;
			КонецЕсли;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В карточке пользователя не указано подразделение";
			Сообщение.Сообщить();
		КонецЕсли;
		Объект.Маршрут = Справочники.CRM_МаршрутыТестДрайва.МаршрутПоУмолчанию;
		Объект.ТипТестДрайва = Перечисления.CRM_ТипыТестДрайвов.ЧастноеЛицо;
		Объект.ВыдатьНапоминание = Истина;
		ОпределитьПользователяНапоминания();
	КонецЕсли;  
	
	Если Объект.КодыКомментариев.Количество() > 0 Тогда
		Элементы.Анкета.Видимость = Ложь;
	КонецЕсли;
	
	спЗакладки.Добавить("Проведение");
	спЗакладки.Добавить("Результат");
	спЗакладки.Добавить("ДосрочноеЗавершение");
	спЗакладки[0].Пометка = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьПользователяНапоминания()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Сотрудник = &Менеджер
	|	И Пользователи.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ПользовательНапоминания = Выборка.Ссылка;
	Иначе
		Объект.ПользовательНапоминания = Объект.Автор;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОкруглитьВремяНачала();
		Объект.ВремяНапоминания = Объект.Начало - ВремяДоСобытия*3600;
	КонецЕсли;
	
	УправлениеЭлементами();
	
КонецПроцедуры

&НаКлиенте
Процедура ОкруглитьВремяНачала()
	
	МинутаНачала = Минута(Объект.Начало);
	ЧасНачала = Час(Объект.Начало);
	Если МинутаНачала <= 15 Тогда
		МинутаНачала = 0
	ИначеЕсли МинутаНачала <= 45 Тогда
		МинутаНачала = 30
	Иначе
		МинутаНачала = 60;
	КонецЕсли;
	Если ЧасНачала < 6 Тогда
		ЧасНачала = 6;
		МинутаНачала = 0;
	КонецЕсли;
	Объект.Начало = Дата(1,1,1) + ЧасНачала*3600 + МинутаНачала*60
	
КонецПроцедуры

&НаКлиенте
Функция ИмяТЧ() 
	Для Каждого Эл Из спЗакладки Цикл 
		Если Эл.Пометка Тогда 
			Возврат Эл.Значение 
		КонецЕсли 
	КонецЦикла 
КонецФункции	

&НаКлиенте
Процедура кнопкиТЧ(Команда)
	ИмяТЧ=ИмяТЧ();
	ИмяТЧОбъекта=?(ИмяТЧ="ЗаявкиНаКредит","РасчетКредита",ИмяТЧ);
	Если ТекущийЭлемент.Имя="кнДобавить" Тогда 
		СтрокаТЧ=Объект["Товары"].Добавить();
	ИначеЕсли ТекущийЭлемент.Имя="кнУдалить" Тогда 
		Если Элементы[ИмяТЧ].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		ТекСтрока=Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока);
		Если ТекСтрока<>Неопределено Тогда Объект[ИмяТЧОбъекта].Удалить(ТекСтрока) КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнОбновить" Тогда Элементы[ИмяТЧ].Обновить()

	ИначеЕсли ТекущийЭлемент.Имя="кнОсновной" Тогда
		Если Элементы[ИмяТЧ].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		Для Каждого Стр Из Объект[ИмяТЧОбъекта] Цикл 
			Если Стр=Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока) Тогда
				Стр.Основной=НЕ Стр.Основной
			Иначе
				Стр.Основной=Ложь
			КонецЕсли;	
		КонецЦикла;

	КонецЕсли;
	
	//УправлениеЭлементами(); 
	
КонецПроцедуры

&Насервере
Процедура ПолучитьСписокСтатусов(Статусы)
	Для Каждого Эл Из Перечисления.CRM_СтатусыТестДрайва Цикл 
		Статусы.Добавить(Эл) 
	КонецЦикла;	
КонецПроцедуры 

&НаКлиенте
Процедура кнСтатус(Команда)
	Если ТипЗнч(Команда) = Тип("КомандаФормы") Тогда
		Статусы = Новый СписокЗначений;
		ПолучитьСписокСтатусов(Статусы);	
		Статусы.НайтиПоЗначению(Объект.СтатусДокумента).Пометка = Истина;

		Парам = Новый Структура;
		Парам.Вставить("Список",Статусы);
		Парам.Вставить("Заголовок","Статусы записи на выдачу");
		Парам.Вставить("МножественныйВыбор",Ложь);
		Парам.Вставить("КоличествоЭлементовВСтроке",3);
		Парам.Вставить("ШиринаЭлемента",19);
		Парам.Вставить("ВысотаЭлемента",3);
		Статус = ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
	КонецЕсли;
	
	Если Статус <> Неопределено Тогда 
		Объект.СтатусДокумента = Статус;
		Модифицированность = Истина;
	КонецЕсли;
	УправлениеЭлементами();
КонецПроцедуры

Процедура УправлениеЭлементами()
	
	Элементы.кнСтатус.Заголовок = "Статус:" + Символы.ПС + Объект.СтатусДокумента;
	
	//переключение закладки
	АктивныйЦвет = Новый Цвет(255,207,0);
	ПассивныйЦвет = Новый Цвет(189,195,206);
	Для Каждого Эл Из спЗакладки Цикл
		Элементы["кн"+Эл.Значение].ЦветФона = ?(Эл.Пометка,АктивныйЦвет,ПассивныйЦвет);
		Элементы["кн"+Эл.Значение].ЦветРамки = ?(Эл.Пометка,АктивныйЦвет,ПассивныйЦвет);
		Элементы[Эл.Значение].Видимость = Эл.Пометка;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура кнЗакладка(Команда)
	Для Каждого Эл Из спЗакладки Цикл 
		Эл.Пометка = Найти(ТекущийЭлемент.Имя, Эл.Значение) > 0 
	КонецЦикла; //пометка текущей закладки в списке
	УправлениеЭлементами();
КонецПроцедуры


&НаКлиенте
Процедура кнВыбратьМаршрут(Команда)
	ВвестиЗначение(Объект.Маршрут);
КонецПроцедуры


