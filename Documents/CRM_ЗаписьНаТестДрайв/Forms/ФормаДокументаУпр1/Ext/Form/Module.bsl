				//	СтрРезультат = Объект.КодыКомментариев.Добавить();
				//	СтрРезультат.Показатель = Стр.Показатель;
				//	Если Стр.Плохо Тогда
				//		СтрРезультат.Результат = ПредопределенноеЗначение("Перечисление.CRM_ОценкаУдовлетворенностиКлиента.Плохо");
				//	ИначеЕсли Стр.Хорошо Тогда
				//		СтрРезультат.Результат = ПредопределенноеЗначение("Перечисление.CRM_ОценкаУдовлетворенностиКлиента.Хорошо");
				//	КонецЕсли;
				//КонецЕсли;
			КонецЦикла;
			Объект.КомментарийРезультата = Форма.Комментарий;
		КонецЕсли;
