&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ДатаВыпуска = ПолучитьДатуВыпускаАвтомобиля(Объект.Автомобиль);
	
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить(КодВозвратаДиалога.Да,"Ознакомлен");
	СписокКнопок.Добавить(КодВозвратаДиалога.Отмена,"Отмена");

	
	Если ДатаВыпуска < ДобавитьМесяц(ТекущаяДата(),-15)Тогда
		Ответ = Вопрос("Данный автомобиль произведен более 15 месяцев назад. "+Символы.ПС+"Такой автомобиль может быть продан только как уцененный, т.е. не отвечающий требованиям нового автомобиля и со сроком действия гарантии, указанной в системе ICM.  "+Символы.ПС+"При создании договора необходимо это учитывать, а так же ознакомиться с датой окончания гарантии в ICM.",СписокКнопок);			
		Если Ответ = КодВозвратаДиалога.Отмена Тогда
			Отказ = Истина;
		КонецЕсли;
	ИначеЕсли ДатаВыпуска < ДобавитьМесяц(ТекущаяДата(),-13) Тогда	
		Ответ = Вопрос("Данный автомобиль произведен более 14 месяцев назад.  "+Символы.ПС+"Такой автомобиль может быть продан только как уцененный, т.е. не отвечающий требованиям нового автомобиля и со сроком действия гарантии, указанной в системе ICM.  "+Символы.ПС+"При создании договора необходимо это учитывать, а так же ознакомиться с датой окончания гарантии в ICM.",СписокКнопок);
		Если Ответ = КодВозвратаДиалога.Отмена Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатуВыпускаАвтомобиля(Автомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN,
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.DATE_MADC
	|ИЗ
	|	РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|ГДЕ
	|	CRM_СостояниеАвтомобилейПроизводителя_v2.VIN = &VIN";
	
	Запрос.УстановитьПараметр("VIN",Автомобиль.VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.DATE_MADC;	
	КонецЦикла;
	
	Возврат ТекущаяДата();
	
КонецФункции

&НаКлиенте
Процедура КлиентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОповещениеОВыбореКлиента = Новый ОписаниеОповещения("ПослеВыбораКлиентаЗавершение",ЭтаФорма);
	ОткрытьФорму("Документ.Renault_Договор.Форма.ФормаВыбораКлиентаУПР",,ЭтаФорма,,,,ОповещениеОВыбореКлиента);
		
КонецПроцедуры

