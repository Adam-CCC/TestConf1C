КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
	ОпределитьПользователяНапоминания();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)	
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ДатаПроведения = Объект.ДатаПроведения + (Объект.Начало - Дата(1, 1, 1));	
		ДатаОкончания = ДатаПроведения + 60*Объект.Продолжительность;
		
		Парам = Новый Структура;
		Парам.Вставить("Дата",ДатаПроведения);
		Парам.Вставить("ДатаЗакрытия",ДатаОкончания);
		Парам.Вставить("Длительность",Объект.Продолжительность);
		//Закрыть(Парам);
		Оповестить("ВыборСвязанногоДокумента", Парам, ВладелецФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвтомобильНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	Если Не ЗначениеЗаполнено(Объект.Продолжительность) Тогда
		Сообщить("Укажите продолжительность тест-драйва");
		Возврат;
	КонецЕсли;
	
	ФормаСписка = ПолучитьФорму("Обработка.Renault_ARM_Администратор.Форма.ФормаВыбораИзСпискаПлиткой");

	Если Не Объект.БУАвтомобиль Тогда
		Список = Renault_CRM.ПолучитьСписокАвтоДляТестДрайва(Объект.ДилерскийЦентр);
		// проверка на занятость
		ПроверитьДоступностьАвтомобиляДляТестДрайва(Список, Объект.ДатаПроведения, Объект.Продолжительность);
		ФормаСписка.Заголовок = "Выбор автомобиля для тест-драйва";
	Иначе
		ТаблицаАвтомобилей = Renault_CRM.ПолучитьСписокБУАвтоДляТестДрайва(Объект.ДилерскийЦентр);
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(ТаблицаАвтомобилей.ВыгрузитьКолонку("Автомобиль")); 
		ФормаСписка.Заголовок = "Выбор автомобиля с пробегом для тест-драйва";
	КонецЕсли;
	
	ФормаСписка.Список = Список;
	Ответ = ФормаСписка.ОткрытьМодально();

	Если ЗначениеЗаполнено(Ответ) Тогда
		Объект.Автомобиль = Ответ;
	КонецЕсли;

	//АвтомобильНачалоВыбораНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьДоступностьАвтомобиляДляТестДрайва(СписокАвтомобилей, ДатаПроведения, Длительность)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаПроведения", НачалоДня(ДатаПроведения));
	Начало = Дата(1, 1, 1, Час(ДатаПроведения), Минута(ДатаПроведения), 0) ;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Начало + (Длительность-1)*60);
	Запрос.УстановитьПараметр("СписокАвтомобилей", СписокАвтомобилей);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаписьНаТестДрайв.Автомобиль,
	|	Представление(ЗаписьНаТестДрайв.Автомобиль) КАК АвтомобильПредставление,
	|	Представление(ЗаписьНаТестДрайв.Менеджер) КАК МенеджерПредставление
	|ИЗ
	|	Документ.CRM_ЗаписьНаТестДрайв КАК ЗаписьНаТестДрайв
	|ГДЕ
	|	ЗаписьНаТестДрайв.ДатаПроведения = &ДатаПроведения
	|	И (ЗаписьНаТестДрайв.Начало МЕЖДУ &Начало И &Конец
	|			ИЛИ ДОБАВИТЬКДАТЕ(ЗаписьНаТестДрайв.Начало, МИНУТА, ЗаписьНаТестДрайв.Продолжительность - 1) МЕЖДУ &Начало И &Конец
	|			ИЛИ &Начало МЕЖДУ ЗаписьНаТестДрайв.Начало И ДОБАВИТЬКДАТЕ(ЗаписьНаТестДрайв.Начало, МИНУТА, ЗаписьНаТестДрайв.Продолжительность - 1)
	|			ИЛИ &Конец МЕЖДУ ЗаписьНаТестДрайв.Начало И ДОБАВИТЬКДАТЕ(ЗаписьНаТестДрайв.Начало, МИНУТА, ЗаписьНаТестДрайв.Продолжительность - 1))
	|	И ЗаписьНаТестДрайв.Автомобиль В (&СписокАвтомобилей)
	|	И ЗаписьНаТестДрайв.ПометкаУдаления = ЛОЖЬ
	|	И НЕ ЗаписьНаТестДрайв.СтатусДокумента = ЗНАЧЕНИЕ(Перечисление.CRM_СтатусыТестДрайва.Отменено)";
	РезультатЗапроса = Запрос.Выполнить();
		
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекЭлемент = СписокАвтомобилей.НайтиПоЗначению(Выборка.Автомобиль);
		МенеджерФамилия = Сред(Выборка.МенеджерПредставление, 1, Найти(Выборка.МенеджерПредставление, " "));
		ТекЭлемент.Представление = Выборка.АвтомобильПредставление + " занят " + МенеджерФамилия;
	КонецЦикла;
	
КонецПроцедуры

