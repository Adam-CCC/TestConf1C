Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)	

	Если Тип = "Резерв" Тогда
		// регистр Renault_УтвержденныеРезервы
		Движения.Renault_УтвержденныеРезервы.Записывать = Истина;
		Движения.Renault_УтвержденныеРезервы.Очистить();
		Если Резерв Тогда
			Для Каждого ТекСтрокаАвтомобили Из Автомобили Цикл
				Движение = Движения.Renault_УтвержденныеРезервы.Добавить();
				Движение.Автомобиль = ТекСтрокаАвтомобили.Автомобиль;
				Движение.VIN = ТекСтрокаАвтомобили.VIN;
				Движение.ДатаРезерва = Дата;
				Движение.Период = Дата;
				Движение.Менеджер = "" + ДилерскийЦентр + ": " + Менеджер;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли Тип = "Контракт" Тогда
		// регистр Renault_ЗаконтрактованныеАвтомобили
		Движения.Renault_ЗаконтрактованныеАвтомобили.Записывать = Истина;
		Движения.Renault_ЗаконтрактованныеАвтомобили.Очистить();
		Если Резерв Тогда
			Для Каждого ТекСтрокаАвтомобили Из Автомобили Цикл
				Движение = Движения.Renault_ЗаконтрактованныеАвтомобили.Добавить();
				Движение.Автомобиль = ТекСтрокаАвтомобили.Автомобиль;
				Движение.VIN = ТекСтрокаАвтомобили.VIN;
				Движение.ДатаДоговора = Дата;
				Движение.Период = Дата;
				Движение.СтатусДоговора = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан;
				Движение.СтатусОкончательныхДокументов = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан;
				Движение.СтатусПредварительныхДокументов = Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Подписан;
				Движение.Менеджер = "" + ДилерскийЦентр + ": " + Менеджер;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли Тип = "Выдача" Тогда
		// регистр CRM_АвтомобилиВыданные
		Движения.CRM_АвтомобилиВыданные.Записывать = Истина;
		Движения.CRM_АвтомобилиВыданные.Очистить();
		Если Резерв Тогда
			Для Каждого ТекСтрокаАвтомобили Из Автомобили Цикл
				Движение = Движения.CRM_АвтомобилиВыданные.Добавить();
				Движение.VIN = ТекСтрокаАвтомобили.VIN;
				Движение.Период = Дата;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
