Процедура ОтправитьСообщениеОСтатусеРаботы(РабочийДокумент, ВидСообщения, ЭтапРабот)
	
		Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
		
		Напоминание.Отправитель = ПараметрыСеанса.Пользователь;
		
		Напоминание.Подробнее = РабочийДокумент.Ссылка;
		
		Обращение = РабочийДокумент.Обращение.Ссылка;
		
		Приемщик = Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту("Обращение", Обращение).Машиноместо.Ссылка;
		
		Напоминание.Адресаты.Добавить().Сотрудник = Приемщик;
		          //:)
		Выдавальщик = Документы.Renault_CRM_ВыдачаАвтомобиля.НайтиПоРеквизиту("Обращение", Обращение).Машиноместо.Ссылка;
		
		Если Приемщик <> Выдавальщик Тогда
			
			Напоминание.Адресаты.Добавить().Сотрудник = Выдавальщик;
			
		КонецЕсли;
		
		Напоминание.ДатаОтправки = ТекущаяДата();
					
		Напоминание.ВидСообщения = ВидСообщения;
			    
		Напоминание.ПоказыватьС = ТекущаяДата();
		Напоминание.ПоказыватьПо = ТекущаяДата();
		
		Инфо = "";
		//ИмяЭтапа = РабочийДокумент.Ссылка.Этапы.Найти(ЭтапРабот, "IDЭтапа");
		
		Если ЗначениеЗаполнено(РабочийДокумент) Тогда
			
			//Если ЗначениеЗаполнено(РабочийДокумент.ЗаказНаряд) Тогда 
			//	
			//	Инфо = "Заказ-наряд номер: " + Строка(РабочийДокумент.ЗаказНаряд.Номер);
			//	
			//Иначе
				
				Инфо = "У мойки по заявке изменился статус.";
				
			//КонецЕсли;
			
			ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(РабочийДокумент.Автомобиль.Ссылка, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	
			
			Если ЗначениеЗаполнено(РабочийДокумент.ГосНомер) Тогда
				
				Инфо = Инфо + Символы.ПС + "Номер Авто: " + ГосНомер;
				
			Иначе
				
				Инфо = Инфо + Символы.ПС + "Модель Авто: " + РабочийДокумент.Автомобиль.Модель;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Напоминание.Комментарий = Инфо;		
		Напоминание.Наименование = "Событие по авто";
		Напоминание.Сообщение = Инфо;
		
		Напоминание.Записать();
	
КонецПроцедуры



