	//		Renault_СообщенияПользователю.СоздатьСообщение(Ссылка, Неопределено, МассивСообщений, Справочники.Renault_ВидСообщения.Автосервис_МойкаОкончена, Неопределено, Неопределено);
	//	КонецЕсли;
	//	
	//КонецЕсли;
	
	Если Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ВРаботе Тогда
		
		// запишем мойку		
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		Запись.Обращение = Обращение;
		Запись.Цех = Машиноместо;
		Запись.ЭтапРабот = 1;
		Запись.РабочийДокумент = Ссылка;
		Запись.Период = ТекущаяДата();
		Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаНачата;
		Запись.Записать();
		
		Набор = РегистрыСведений.Renault_АвтосервисПланРабот.СоздатьНаборЗаписей();
		Набор.Отбор.Обращение.Установить(Обращение);
		Набор.Отбор.РабочийДокумент.Установить(Ссылка);
		Набор.Прочитать();
		ОтставаниеВоВремени = ТекущаяДата() - Набор[0].ВремяНачала;
		
		НаборПланОперативный = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		НаборПланОперативный.Отбор.РабочийДокумент.Установить(Ссылка);
		НаборПланОперативный.Прочитать();
		НаборПланОперативный.Очистить();
		
		//// запишем все автоработы
		//Запрос = Новый Запрос;
		//Запрос.Текст = 
		//"ВЫБРАТЬ
		//|	Renault_АвтосервисПланРабот.ВремяНачала,
		//|	Renault_АвтосервисПланРабот.ВремяОкончания,
		//|	Renault_АвтосервисПланРабот.ЭтапРабот,
		//|	Renault_АвтосервисПланРабот.Цех,
		//|	Renault_АвтосервисПланРабот.Длительность,
		//|	Renault_АвтосервисПланРабот.РабочийДокумент
		//|ИЗ
		//|	РегистрСведений.Renault_АвтосервисПланРабот КАК Renault_АвтосервисПланРабот
		//|ГДЕ
