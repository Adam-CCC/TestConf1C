			Запись = НаборПланОперативный.Добавить();
			Запись.ДилерскийЦентр = ДилерскийЦентр;
			Запись.Период = ТекущаяДата();
			Запись.Обращение = Обращение;
			Запись.РабочийДокумент = Ссылка;
			Запись.ЭтапРабот = 1;
			Запись.Цех = Машиноместо;
			Запись.ВремяНачала = ТекущаяДата();
			Запись.ВремяОкончания = ТекущаяДата() + ЭтотОбъект.Длительность;
			Запись.Длительность = ЭтотОбъект.Длительность;
			//Запись.Записать();
		//КонецЦикла;
		
		НаборПланОперативный.Записать();
		
		//Запишем занятость сотрудника
		Сотрудник = ЭтотОбъект.Машиноместо;
		
		Запись = РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СоздатьМенеджерЗаписи();
		Запись.Сотрудник = Машиноместо;
		Запись.Статус = Перечисления.CRM_ЗанятостьСотрудника.Занят;
		Запись.Период = ТекущаяДата();
		Запись.ПричинаЗанятости = Перечисления.CRM_ПричиныЗанятостиСотрудника.Приемка;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.ВремяОкончания) Тогда
			
			Запись.ПримерноеВремяОкончания = ЭтотОбъект.ВремяОкончания;
			
		Иначе
			
			Запись.ПримерноеВремяОкончания = ТекущаяДата() + Длительность;
			
		КонецЕсли;
		
		Запись.Записать();
		
		ВидСообщения = Справочники.Renault_ВидСообщения.Автосервис_МойкаНачата;
		
		ОтправитьСообщениеОСтатусеРаботы(ЭтотОбъект.Ссылка, ВидСообщения, "1")
		
	ИначеЕсли Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Заявка Тогда
		
		Запись = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДата();
		Запись.Обращение = ЭтотОбъект.Обращение;
		Запись.РабочийДокумент = Ссылка;
		Запись.ЭтапРабот = 1;
		Запись.ДилерскийЦентр = ДилерскийЦентр.Ссылка;
		Запись.ВремяНачала = ВремяНачала;
		Запись.ВремяОкончания = ВремяОкончания;
		Запись.Длительность = Длительность;
		Запись.Цех = Машиноместо;
		
				
		Запись.Записать();
		
	ИначеЕсли Состояние = Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.Выполнен Тогда
		
		Запись = РегистрыСведений.Renault_АвтосервисСтатусыРабот.СоздатьМенеджерЗаписи();
		Запись.ДилерскийЦентр = ДилерскийЦентр;
		//Запись.ДатаВремяИзменения = ТекущаяДата();
		Запись.Обращение = Обращение;
		Запись.Цех = Машиноместо;
		Запись.ЭтапРабот = 1;
		Запись.РабочийДокумент = Ссылка;
		Запись.Период = ТекущаяДата();
		Запись.СтатусРаботы = Справочники.Renault_СтатусыАвторабот.РаботаЗакончена;
		Запись.Записать();
		
		НаборПлан = РегистрыСведений.Renault_АвтосервисПланОперативный.СоздатьНаборЗаписей();
		НаборПлан.Отбор.РабочийДокумент.Установить(Ссылка);
		НаборПлан.Прочитать();
		НаборПлан.Очистить();
		НаборПлан.Записать();
		
	//какой статус для "свободен" пока не придумал, пусть будет так:	
	//ИначеЕсли Состояние <> Справочники.Renault_ВидыСостоянийДокументовАвтосервиса.ПриемкаНачата Тогда
		
		Запись = РегистрыСведений.CRM_СтатусыЗанятостиСотрудников.СоздатьМенеджерЗаписи();
		Запись.Сотрудник = Машиноместо;
		Запись.Статус = Перечисления.CRM_ЗанятостьСотрудника.Свободен;
		Запись.Период = ТекущаяДата();
		
		Запись.Записать();
		
		ВидСообщения = Справочники.Renault_ВидСообщения.Автосервис_МойкаОкончена;
		
		ОтправитьСообщениеОСтатусеРаботы(ЭтотОбъект.Ссылка, ВидСообщения, "1")
		
	КонецЕсли;
	
