Перем Права Экспорт;

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_ИнформацияПоЗаявкамDistri.Автомобиль,
	|	Renault_ИнформацияПоЗаявкамDistri.ИдентификаторСтрокиДоговора,
	|	Renault_ИнформацияПоЗаявкамDistri.НомерКлиентскойЗаявки,
	|	Renault_ИнформацияПоЗаявкамDistri.ПродажаВнесена,
	|	Renault_ИнформацияПоЗаявкамDistri.НомерОрдера
	|ИЗ
	|	РегистрСведений.Renault_ИнформацияПоЗаявкамDistri КАК Renault_ИнформацияПоЗаявкамDistri
	|ГДЕ
	|	Renault_ИнформацияПоЗаявкамDistri.Автомобиль.VIN = &VIN";
	Запрос.УстановитьПараметр("VIN", VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда			
		Запись = РегистрыСведений.Renault_ИнформацияПоЗаявкамDistri.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Запись.Заявка = Ссылка;
		Запись.НомерКлиентскойЗаявки = NumCl;
		Запись.НомерОрдера = НомерОрдера;
		Запись.ПродажаВнесена = ?(ЗначениеЗаполнено(NumCl),Истина,Ложь);
		Запись.Записать();
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Renault_ИнформацияПоЗаявкамDistri.Автомобиль,
	|	Renault_ИнформацияПоЗаявкамDistri.ИдентификаторСтрокиДоговора,
	|	Renault_ИнформацияПоЗаявкамDistri.НомерКлиентскойЗаявки,
	|	Renault_ИнформацияПоЗаявкамDistri.ПродажаВнесена,
	|	Renault_ИнформацияПоЗаявкамDistri.НомерОрдера
	|ИЗ
	|	РегистрСведений.Renault_ИнформацияПоЗаявкамDistri КАК Renault_ИнформацияПоЗаявкамDistri
	|ГДЕ
	|	Renault_ИнформацияПоЗаявкамDistri.Автомобиль.VIN = &VIN";
	Запрос.УстановитьПараметр("VIN", VIN);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда			
		Запись = РегистрыСведений.Renault_ИнформацияПоЗаявкамDistri.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Прочитать();
		Запись.Заявка = Документы.DMS_ЗаявкаНаАвтомобиль.ПустаяСсылка();
		Запись.Записать();
	КонецЕсли;
	

КонецПроцедуры

