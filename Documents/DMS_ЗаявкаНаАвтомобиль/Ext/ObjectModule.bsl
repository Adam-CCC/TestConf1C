Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Клиент) Тогда 
		Отказ = Истина;
		// --- DMSREN-1183
		Сообщение = новый СообщениеПользователю;
		Сообщение.Текст = "Ошибка записи. Не заполнено поле ""Клиент""";
		Сообщение.Сообщить();
		// DMSREN-1183 ---
	КонецЕсли;
	
	Если ЗначениеЗаполнено(VIN) И ЗначениеЗаполнено(ДоговорКП) и ЗначениеЗаполнено(ИдентификаторСтрокиДоговора) Тогда
		ДанныеАвто = Новый Структура;
		ДанныеАвто.Вставить("Модель",Модель);
		ДанныеАвто.Вставить("Цвет",Цвет);
		ДанныеАвто.Вставить("Версия", Версия);
		Автомобиль = Renault_ЗагрузкаДанныхОбАвтомобиляхПроизводителя.НайтиСоздатьАвтомобильПоВину_v2(VIN,ДанныеАвто);
		СтрокаДоговора = ДоговорКП.СоставДоговора.Найти(ИдентификаторСтрокиДоговора,"Идентификатор");
		Если НЕ ЗначениеЗаполнено(СтрокаДоговора.VIN) Тогда
			Договор = ДоговорКП.ПолучитьОбъект();
			СтрокаДоговора = Договор.СоставДоговора.Найти(ИдентификаторСтрокиДоговора,"Идентификатор");
			СтрокаДоговора.VIN = VIN;
			СтрокаДоговора.Автомобиль = Автомобиль;
			Договор.Записать();
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Renault_ИнформацияПоЗаявкамDistri.Автомобиль,
			               |	Renault_ИнформацияПоЗаявкамDistri.ИдентификаторСтрокиДоговора,
			               |	Renault_ИнформацияПоЗаявкамDistri.НомерКлиентскойЗаявки,
			               |	Renault_ИнформацияПоЗаявкамDistri.ПродажаВнесена,
			               |	Renault_ИнформацияПоЗаявкамDistri.НомерОрдера,
			               |	Renault_ИнформацияПоЗаявкамDistri.Заявка
			               |ИЗ
			               |	РегистрСведений.Renault_ИнформацияПоЗаявкамDistri КАК Renault_ИнформацияПоЗаявкамDistri
			               |ГДЕ
			               |	Renault_ИнформацияПоЗаявкамDistri.ИдентификаторСтрокиДоговора = &ИдентификаторСтрокиДоговора";
			Запрос.УстановитьПараметр("ИдентификаторСтрокиДоговора", ИдентификаторСтрокиДоговора);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				Запись = РегистрыСведений.Renault_ИнформацияПоЗаявкамDistri.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(Запись, Выборка);
				Запись.Автомобиль = Автомобиль;
				Запись.ИдентификаторСтрокиДоговора = ИдентификаторСтрокиДоговора;
				Запись.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
