
&НаКлиенте
Перем РезультатПолученияДопИнформации;

&НаКлиенте
Перем ФормаДлительнойОперации;

&НаКлиенте
Перем ПараметрыОбработчика;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗначенияСвойств(Объект,Параметры);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ПродавецСтрока = ПараметрыСеанса.Пользователь.Наименование;
		Объект.Продавец = ПараметрыСеанса.Пользователь;
		Объект.ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя(ПараметрыСеанса.Пользователь);
		Объект.BIR = Сред(Объект.ДилерскийЦентр.BIR, 1, 8);
		Объект.Счет = "00"+ Сред(Объект.ДилерскийЦентр.BIR, 5, 4); 
	КонецЕсли;
	Если Параметры.Свойство("Ответ") Тогда
		сОтвет = Параметры.Ответ;
		Если сОтвет.Свойство("Модель") Тогда 
			Объект.Модель = Справочники.Модели.НайтиПоРеквизиту("Артикул", сОтвет.Модель);
			Если сОтвет.Свойство("Версия") Тогда
				Объект.Версия = Справочники.ВариантыКомплектации.НайтиПоРеквизиту("Артикул",сОтвет.Версия,,Объект.Модель);   // DMSREN-785, передаем модель 4ым параметром
			КонецЕсли;
			Объект.Цвет = Справочники.Цвета.НайтиПоРеквизиту("Артикул",сОтвет.Цвет);
			ЦветСалона = Справочники.DMS_ЦветаСалона.НайтиПоРеквизиту("Артикул",сОтвет.ЦветСалона);
			Если ЦветСалона = Справочники.DMS_ЦветаСалона.ПустаяСсылка() и ЗначениеЗаполнено(сОтвет.ЦветСалона) тогда
				НовыйЦветСалона = Справочники.DMS_ЦветаСалона.СоздатьЭлемент();
				НовыйЦветСалона.Артикул = сОтвет.ЦветСалона;
				НовыйЦветСалона.Наименование = сОтвет.ЦветСалонаНаименование;
				НовыйЦветСалона.Записать();
				ЦветСалона = НовыйЦветСалона.Ссылка;
			КонецЕсли; 
			Объект.ЦветСалона = ЦветСалона;
			ВариантСалона = Справочники.DMS_ВариантыСалона.НайтиПоРеквизиту("Артикул",сОтвет.ВариантСалона);
			Если ВариантСалона = Справочники.DMS_ВариантыСалона.ПустаяСсылка() и ЗначениеЗаполнено(сОтвет.ВариантСалона) тогда
				НовыйВариант = Справочники.DMS_ВариантыСалона.СоздатьЭлемент();
				НовыйВариант.Артикул = сОтвет.ВариантСалона;
				НовыйВариант.Наименование = сОтвет.ВариантСалонаНаименование;
				НовыйВариант.Записать();
				ВариантыСалона = НовыйВариант.Ссылка;
			КонецЕсли; 
			Объект.ВариантСалона = ВариантСалона;
			Объект.ТипАвтомобиля = Перечисления.DMS_ТипыАвтомобилей.VP;
			МинимальнаяДатаПоставки = сОтвет.ДатаДоставки;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("Договор") 
		И ЗначениеЗаполнено(Параметры.Договор) Тогда 
		Объект.ДоговорКП = Параметры.Договор;
		Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда
			Объект.Клиент = Параметры.Договор.КлиентДоговора;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("ИдентификаторСтрокиДоговора") 
		И ЗначениеЗаполнено(Параметры.ИдентификаторСтрокиДоговора) Тогда 
		Объект.ИдентификаторСтрокиДоговора = Параметры.ИдентификаторСтрокиДоговора;
	КонецЕсли;

	Если Параметры.Свойство("Продавец") Тогда
		ПользовательПродавец = Renault_CRM.ПолучитьПользователяПоСотруднику(Параметры.Продавец);
		Если ЗначениеЗаполнено(ПользовательПродавец) Тогда
			Объект.Продавец = ПользовательПродавец;
			Объект.ПродавецСтрока = Объект.Продавец.Наименование;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма,КлиентПриИзмененииНаСервере(Объект.Клиент));
	КонецЕсли;
	
	УстановитьВидимость();
	УправлениеДоступностьюЭлементов();
	
	//Элементы.ГруппаНетEmail.Видимость = Не ЗначениеЗаполнено(EMail);
	Если ЗначениеЗаполнено(Объект.Модель) Тогда
		Элементы.ЗаголовокКонфигурации.Заголовок =  УстановитьЗаголовокКонфигуратора (Объект.Модель, Объект.Версия, Объект.Цвет, Объект.ВариантСалона, Объект.ЦветСалона);
	Иначе
		Элементы.ЗаголовокКонфигурации.Заголовок = "Обновить конфигурацию";	
	КонецЕсли;
	
	Элементы.ЗаголовокКонфигурации.Гиперссылка = Истина;
	Элементы.ЗаголовокКонфигурации.УстановитьДействие("Нажатие", "ОбновитьКонфигурациюАвто");
	ЗаполнитьСписокКоммерческихАкцийНаСервере();
	
	Если Объект.ДатаЖелаемойПоставки = Дата(1,1,1) 
		И (ЗначениеЗаполнено(Объект.VIN) ИЛИ (ЗначениеЗаполнено(Объект.Модель) И ЗначениеЗаполнено(Объект.Версия))) Тогда
		ВыполнитьРасчетМинимальногоСрокаПоставки(Ложь); 
		
	ИначеЕсли ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрыРасчета = РегистрыСведений.DMS_АрхивРасчетовМинДатыПоставки.ПолучитьПараметрыРасчетаМинДатыПоставки(Объект.Ссылка, Объект.VIN);	
		
		Если ПараметрыРасчета <> Неопределено Тогда
			НоваяСтрока = ПараметрыРасчетаМДП.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыРасчета);
			МинимальнаяДатаПоставки = ПараметрыРасчета.МинимальнаяДатаПоставки;
			
			УстановитьПояснениеКСрокуПоставки(); 
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЦентрКонтракт = ?(Объект.ЦентрализованныйКонтракт, "Да", "Нет");
	КонецЕсли;	
	
	//+++
	ПодставитьДокументСогласия();
	//---
	
КонецПроцедуры

&НаСервере
Процедура ПодставитьДокументСогласия()
	ДокументСогласия = Документы.DMS_СогласиеНаОбработкуПерсональныхДанных.ВернутьСогласиеПоКлиенту(Объект.Клиент);
	
	//Если Не ЗначениеЗаполнено(ДокументСогласия) Тогда 
	//	Элементы.ДокументСогласия.Заголовок = "Создать документ обработки персональных данных";
	//Иначе 
	//	Элементы.ДокументСогласия.поЗаголовок = "";
	//КонецЕсли;	
	Если Не ЗначениеЗаполнено(ДокументСогласия) Тогда 
		Элементы.ДекорацияСогласия.Заголовок = "Создать документ обработки персональных данных";
	Иначе 
		Элементы.ДекорацияСогласия.Заголовок = ДокументСогласия;
	КонецЕсли;	
	
	УстановитьСогласияПоКонтрагенту();
КонецПроцедуры

&НаСервере
Процедура УстановитьСогласияПоКонтрагенту()
	
	СогласиеНаОПД = Ложь;
	СогласиеНаКоммуникацию = Ложь;
	СогласиеНаПодключаемыеСервисы = Ложь;
	
	Если Объект.Клиент.СогласиеНаОбработкуПерсональныхДанных = Перечисления.ВариантыОтветов.Да Тогда
		СогласиеНаОПД = Истина;
	КонецЕсли;
	
	СогласиеНаКоммуникацию = Объект.Клиент.СогласиеНаПолучениеSMS;
	СогласиеНаПодключаемыеСервисы = ДокументСогласия.СогласиеНаПодключаемыеСервисы;
	
	Элементы.ПечатьОПД.Доступность = СогласиеНаОПД;
	Элементы.ПечатьКоммуникация.Доступность = СогласиеНаКоммуникацию;
	Элементы.ПечатьСервисы.Доступность = СогласиеНаПодключаемыеСервисы;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ЗаполнитьСписокКоммерческихАкцийНаКлиенте",0.1,Истина);
	
	Объект.КоммерческаяАкция1 = Справочники.DMS_КоммерческиеАкции.НайтиПоКоду("0000");

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПроверитьЗаполнениеПолей(Отказ);
	
	Если ПараметрыЗаписи.Свойство("ОбменДанными") Тогда
		ТекущийОбъект.ОбменДанными.Загрузка = ПараметрыЗаписи.ОбменДанными;
		ТекущийОбъект.ОбменДанными.Получатели.АвтоЗаполнение = не ПараметрыЗаписи.ОбменДанными;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	Если ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда
		Для Каждого СтрокаТЗ Из ПараметрыРасчетаМДП Цикл 
			ПараметрыРасчета = Новый Структура;
			ПараметрыРасчета.Вставить("VIN",                     СтрокаТЗ.VIN);
			ПараметрыРасчета.Вставить("ДатаОтсчета",             СтрокаТЗ.ДатаОтсчета);
			ПараметрыРасчета.Вставить("НазваниеДаты",            СтрокаТЗ.НазваниеДаты);
			ПараметрыРасчета.Вставить("СрокДоставки",            СтрокаТЗ.СрокДоставки);
			ПараметрыРасчета.Вставить("СрокНаСкладе",            СтрокаТЗ.СрокНаСкладе);
			ПараметрыРасчета.Вставить("СрокПодготовки",          СтрокаТЗ.СрокПодготовки);
			ПараметрыРасчета.Вставить("ОписаниеРасчета",         СтрокаТЗ.ОписаниеРасчета);
			ПараметрыРасчета.Вставить("МинимальнаяДатаПоставки", СтрокаТЗ.МинимальнаяДатаПоставки);
			ПараметрыРасчета.Вставить("ЛокальноВДМС",            СтрокаТЗ.ЛокальноВДМС);	
			ПараметрыРасчета.Вставить("ЗаявкаНаАвтомобиль",      ТекущийОбъект.Ссылка);	
			
			РегистрыСведений.DMS_АрхивРасчетовМинДатыПоставки.СоздатьЗаписьРасчетаМинДатыПоставки(ПараметрыРасчета);		
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбработатьЗакрытиеКонфигуратора" Тогда
		Если Параметр <> Неопределено Тогда
			Объект.VIN = "";
			ЗаполнитьЗначенияСвойств(Объект, Параметр);
			Объект.ВариантСалона = Параметр.Салон;
			Элементы.ЗаголовокКонфигурации.Заголовок =  УстановитьЗаголовокКонфигуратора(Объект.Модель, Объект.Версия, Объект.Цвет, Объект.ВариантСалона, Объект.ЦветСалона);	
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура VIN1Нажатие(Элемент, СтандартнаяОбработка)
	
	ОткрытьЗначение(ВернутьАвтомобильПоVIN(Объект.VIN));
	
КонецПроцедуры

&НаКлиенте
Процедура VINПриИзменении(Элемент)
	
	ПодключитьОбработчикОжидания("ЗаполнитьСписокКоммерческихАкцийНаКлиенте",0.1,Истина);
	
	Объект.ДатаЖелаемойПоставки = Дата(1,1,1);	
	ВыполнитьРасчетМинимальногоСрокаПоставки(Ложь); 
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма,КлиентПриИзмененииНаСервере(Объект.Клиент));
	КонецЕсли;
	//+++
	ПодставитьДокументСогласия();
	//---
КонецПроцедуры

&НаКлиенте
Процедура ОбычнаяСделкаПриИзменении(Элемент)
	
	Объект.Конверсия = Ложь;
	Объект.Лизинг = Ложь;
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура КонверсияПриИзменении(Элемент)
	
	Объект.ОбычнаяСделка = Ложь;
	//Объект.Лизинг = Ложь;
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛизингПриИзменении(Элемент)
	
	//Объект.Конверсия = Ложь;
	Объект.ОбычнаяСделка = Ложь;
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродавецПриИзменении(Элемент)
	
	Объект.ПродавецСтрока = Строка(Объект.Продавец);
	
КонецПроцедуры

&НаКлиенте            
Процедура ТипЗаявкиПриИзменении(Элемент)
	
	Если Объект.ТипЗаявки <> ПредопределенноеЗначение("Справочник.DMS_ТипыЗаявки.КрупныеКлиенты") Тогда
		Объект.ЦентрализованныйКонтракт = Ложь;	
		ЦентрКонтракт = "";
	КонецЕсли;	
	
	Объект.ДатаЖелаемойПоставки = Дата(1,1,1);	
	ВыполнитьРасчетМинимальногоСрокаПоставки(Ложь); 
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ПочтаКлиентаПриИзменении(Элемент)
	Элементы.ГруппаНетEmail.Видимость = Не ЗначениеЗаполнено(EMail);
	Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойEmailКлиента(EMail, Объект.Клиент);
КонецПроцедуры

&НаКлиенте
Процедура ДилерскийЦентрПриИзменении(Элемент)
	ДилерскийЦентрПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТелефонКлиентаПриИзменении(Элемент)
	Renault_УправлениеКонтактнойИнформацией.ЗаписатьОсновнойТелефонКлиента(ТелефонКлиента, Объект.Клиент);
КонецПроцедуры

&НаКлиенте
Процедура ДатаЖелаемойПоставкиПриИзменении(Элемент)
	
	Если МинимальнаяДатаПоставки <> Дата(1,1,1) И Объект.ДатаЖелаемойПоставки < МинимальнаяДатаПоставки Тогда
		ПоказатьПредупреждение(, "Желаемая дата поставки должна быть ≥ " + Формат(МинимальнаяДатаПоставки, "ДФ=dd.MM.yyyy"),, "Установка даты поставки");
		Объект.ДатаЖелаемойПоставки = Дата(1,1,1);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьВDistriNet(Команда)
	         
	Отказ = Ложь;
	ПроверитьЗаполнениеПолей(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) или Модифицированность Тогда
		Ответ = Вопрос("Заявка не записана, отправка не возможна, выполнить запись?",РежимДиалогаВопрос.ДаНет);
		Если Ответ=КодВозвратаДиалога.Да Тогда
			Если не Записать(Новый Структура("ОбменДанными", Истина)) Тогда
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПараметрыВызоваСервера = Новый Структура;
	ПараметрыВызоваСервера.Вставить("Ссылка",Объект.Ссылка);
	РезультатПолученияДопИнформации = ВыполнитьЗапрос (ПараметрыВызоваСервера);
	Если РезультатПолученияДопИнформации.ФоновоеЗадание Тогда
		Renault_ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", 1, Истина);
		ФормаДлительнойОперации = Renault_ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);
	Иначе
		ОбработатьРезультатВыполненияЗадания();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПоКлиенту(Команда)
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма,КлиентПриИзмененииНаСервере(Объект.Клиент));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьМинимальнуюДатуПоставки(Команда)
	
	ВыполнитьРасчетМинимальногоСрокаПоставки(Истина);
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция КлиентПриИзмененииНаСервере(Клиент)
	
	ДанныеКлиента = Новый Структура;
	ДанныеКлиента.Вставить("Фамилия",Клиент.Фамилия);
	ДанныеКлиента.Вставить("Имя",Клиент.Имя);
	ДанныеКлиента.Вставить("Отчество",Клиент.Отчество);
	ДанныеКлиента.Вставить("Пол",Клиент.Пол);
	ДанныеКлиента.Вставить("ДатаРождения",Клиент.ДатаРождения);
	ДанныеКлиента.Вставить("ИНН",Клиент.ИНН);
	Если Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо Тогда
		АдресКлиента = Renault_УправлениеКонтактнойИнформацией.АдресКлиента(Клиент);
		ТелефонКлиента = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Клиент);
	Иначе
		Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		Запись.Вид = Справочники.ВидыКонтактнойИнформации.АдресЮридический;
		Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		Запись.Объект = Клиент;
		Запись.Прочитать();
		АдресКлиента = Запись.Представление;
		ТелефонКлиента = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойТелефонКлиента(Клиент);
	КонецЕсли;

	Email = Renault_УправлениеКонтактнойИнформацией.ПолучитьОсновнойEmailКлиента(Клиент);
	
	ДанныеКлиента.Вставить("АдресКлиента",АдресКлиента);
	ДанныеКлиента.Вставить("ТелефонКлиента",ТелефонКлиента);
	ДанныеКлиента.Вставить("Email",Email);
		
	Возврат ДанныеКлиента;
	
КонецФункции

