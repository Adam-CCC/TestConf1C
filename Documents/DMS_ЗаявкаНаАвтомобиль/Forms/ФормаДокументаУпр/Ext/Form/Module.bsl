&НаСервере
Процедура УправлениеДоступностьюЭлементов () 
	
	Если ЗначениеЗаполнено(Объект.Ссылка) и не ЗначениеЗаполнено(Объект.ДатаПродажи) Тогда
		Элементы.Клиент.Доступность = Ложь;
		Элементы.ИНН.Доступность = Ложь;
		Элементы.ГруппаАкции.Доступность = Ложь;
		Элементы.ТипЗаявки.Доступность = Ложь;  
		Элементы.ГруппаШапка.Доступность = Ложь;
		Элементы.ПочтаКлиента.Доступность = истина;
		Элементы.ТелефонКлиента.Доступность = Истина;
		Элементы.ПолучитьМинимальнуюДатуПоставки.Доступность = Ложь;	
		Элементы.ЦентрКонтракт.Доступность = Ложь;
		Элементы.ЦентрКонтрактДекорация.Доступность = Ложь;
	иначеЕсли ЗначениеЗаполнено(Объект.Ссылка) и ЗначениеЗаполнено(Объект.ДатаПродажи) Тогда
		Элементы.ГруппаАкции.Доступность = Ложь;
		Элементы.ПолучитьМинимальнуюДатуПоставки.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	Если Не Объект.ОбычнаяСделка И Не Объект.Конверсия И Не Объект.Лизинг Тогда
		Объект.ОбычнаяСделка = Истина;	
	КонецЕсли;
	
	Элементы.ГруппаКорп.Видимость = 
		Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.КорпоративныеКлиенты 
		Или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.КрупныеКлиенты;
		
	Элементы.ФИО.Видимость = НЕ Элементы.ГруппаКорп.Видимость;
	Элементы.ДатаРождения.Видимость = НЕ Элементы.ГруппаКорп.Видимость;
	Элементы.ИНН.Видимость = НЕ Элементы.ДатаРождения.Видимость;
		
	Элементы.Кузовостроитель.Доступность = Объект.Конверсия;
	Элементы.ЛизинговаяКомпания.Доступность = Объект.Лизинг;
	
	Если Не Объект.Конверсия Тогда
		Объект.Кузовостроитель = "";
	КонецЕсли;
	
	Если Не Объект.Лизинг Тогда
		Объект.ЛизинговаяКомпания = "";
	КонецЕсли;
	
	Если ПараметрыСеанса.DMS_Бренд <> Справочники.CRM_МаркаАвтомобиля.RENAULT Тогда
		Элементы.РегистрируемВMyRenault.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ЦентрКонтракт.Видимость = Объект.ТипЗаявки = ПредопределенноеЗначение("Справочник.DMS_ТипыЗаявки.КрупныеКлиенты");
	Элементы.ЦентрКонтрактДекорация.Видимость = Элементы.ЦентрКонтракт.Видимость;

КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьЗаголовокКонфигуратора (Модель, Версия, Цвет, ВариантСалона, ЦветСалона)
	
	Если ЗначениеЗаполнено(Модель) и ЗначениеЗаполнено(Версия) Тогда
		Возврат Модель.Артикул +" " + Версия.Артикул + " " + Цвет.Артикул + " " + ВариантСалона + " " + ЦветСалона;
	Иначе
		Возврат "Конфигурация не выбрана...";
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьПояснениеКСрокуПоставки()
	
	Элементы.ДекорацияСрокПоставки.Заголовок = "Минимальная дата поставки автомобиля - " + ?(ЗначениеЗаполнено(МинимальнаяДатаПоставки), Формат(МинимальнаяДатаПоставки, "ДФ=dd.MM.yyyy"), "не получена!");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеПолей (ЕстьОшибки)
	
	Если Не ЗначениеЗаполнено(Объект.Счет) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Счет не указан";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если СтрДлина(Объект.Счет) <> 6 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В поле ""Счет"" должны быть указано 6 символов";
		Сообщение.Поле = "Счет";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Продавец) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Продавец не указан"; 
		Сообщение.Поле = "Продавец";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ТипЗаявки) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Тип клиента не указан";
		Сообщение.Поле = "ТипЗаявки";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	Если Объект.Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЧастноеЛицо 
		или не (Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.КорпоративныеКлиенты 
		или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.КрупныеКлиенты 
		или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.Демо 
		или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.Подменный) тогда
		
		Если НЕ ЗначениеЗаполнено(Фамилия) Или не ЗначениеЗаполнено(Имя) тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "ФИО не указано";
			Сообщение.Сообщить();
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	ИначеЕсли Объект.Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо 
		или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.КорпоративныеКлиенты 
		или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.КрупныеКлиенты 
		или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.Демо 
		или Объект.ТипЗаявки = Справочники.DMS_ТипыЗаявки.Подменный Тогда
		
		Если Объект.Конверсия И Не ЗначениеЗаполнено(Объект.Кузовостроитель) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Кузовостроитель не указан";
			Сообщение.Поле = "Кузовостроитель";
			Сообщение.Сообщить();
			ЕстьОшибки = Истина;
		КонецЕсли;
		Если Объект.Лизинг И Не ЗначениеЗаполнено(Объект.ЛизинговаяКомпания) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Лизинговая компания не указана"; 
			Сообщение.Поле = "ЛизинговаяКомпания";
			Сообщение.Сообщить();
			ЕстьОшибки = Истина;
		КонецЕсли;		
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Модель) ТОгда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Конфигурация не заполнена";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТелефонКлиента) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указан телефон";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ДатаЖелаемойПоставки) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указана дата желаемой поставки";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КоммерческаяАкция1) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не указана коммерческая акция";
		Сообщение.Поле = "КоммерческаяАкция1";
		Сообщение.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;
	
	// Проверим на дубли заявок. Если есть, отказ.
	Если Не Объект.Аннулирована и ЗначениеЗаполнено(Объект.VIN) тогда // DMSREN-1121
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	DMS_ЗаявкаНаАвтомобиль.Номер,
		|	DMS_ЗаявкаНаАвтомобиль.НомерDMS,
		|	DMS_ЗаявкаНаАвтомобиль.Дата
		|ИЗ
		|	Документ.DMS_ЗаявкаНаАвтомобиль КАК DMS_ЗаявкаНаАвтомобиль
		|ГДЕ
		|	DMS_ЗаявкаНаАвтомобиль.Ссылка <> &Ссылка
		|	И DMS_ЗаявкаНаАвтомобиль.VIN = &VIN
		|	И НЕ DMS_ЗаявкаНаАвтомобиль.ПометкаУдаления
		|	И НЕ DMS_ЗаявкаНаАвтомобиль.Аннулирована";
		
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("VIN", Объект.VIN);
		Выборка = Запрос.Выполнить().Выбрать();
		ЕстьДубли = Ложь;
		Пока Выборка.Следующий() цикл
			Сообщить("Существует заявка на автомобиль № "+Выборка.Номер+", DMS ("+Выборка.НомерDMS+") от "+Формат(Выборка.Дата,"ДФ=dd.MM.yyyy"));		
			ЕстьДубли 	= Истина;
			ЕстьОшибки	= Истина;
		КонецЦикла;
		Если ЕстьДубли тогда
			Сообщить("Необходимо аннулировать другие заявки.");
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ТипЗаявки = ПредопределенноеЗначение("Справочник.DMS_ТипыЗаявки.КрупныеКлиенты") Тогда
		Если ЦентрКонтракт = "" Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не указан признак ""Централизованный контракт"".";
			Сообщение.Поле = "ЦентрКонтракт";
			Сообщение.Сообщить();
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокКоммерческихАкцийНаКлиенте()
	
	ЗаполнитьСписокКоммерческихАкцийНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКоммерческихАкцийНаСервере()

	СписокДоступныхКоммерческихАкций = DMS_ОбменДаннымиСДилерскимПорталом.ВернутьСписокДоступныхКоммерческихАкций(Объект.VIN);
	ЭтаФорма.Элементы.КоммерческаяАкция1.СписокВыбора.ЗагрузитьЗначения(СписокДоступныхКоммерческихАкций.ВыгрузитьЗначения());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКонфигурациюАвто(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
			
	сПараметры = Новый Структура;
	Если ЗначениеЗаполнено(Объект.Модель) и ЗначениеЗаполнено(Объект.Версия) Тогда
		сПараметры.Вставить("Модель",Объект.Модель);
		сПараметры.Вставить("Версия", Объект.Версия);
		сПараметры.Вставить("Цвет", Объект.Цвет);
		сПараметры.Вставить("Опции", Объект.Опции);
		сПараметры.Вставить("Салон", Объект.ВариантСалона);
		сПараметры.Вставить("ЦветСалона", Объект.ЦветСалона);
		сПараметры.Вставить("ТипАвтомобиля", Объект.ТипАвтомобиля);
	КонецЕсли;

	//ОткрытьФорму("Документ.DMS_ЗаявкаНаАвтомобиль.Форма.ФормаКонфигуратора",сПараметры,,,,,ОписаниеОповещенияОЗакрытии);
	Результат = ОткрытьФормуМодально("Документ.DMS_ЗаявкаНаАвтомобиль.Форма.ФормаКонфигуратора",сПараметры);
	
	Если Результат <> Неопределено Тогда
		Объект.VIN = "";
		ЗаполнитьЗначенияСвойств(Объект, Результат);
		Объект.ВариантСалона = Результат.Салон;
		Элементы.ЗаголовокКонфигурации.Заголовок = УстановитьЗаголовокКонфигуратора(Объект.Модель, Объект.Версия, Объект.Цвет, Объект.ВариантСалона, Объект.ЦветСалона);	
		
		Объект.ДатаЖелаемойПоставки = Дата(1,1,1);	
		ВыполнитьРасчетМинимальногоСрокаПоставки(Ложь); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапрос (ПараметрыВызоваСервера)
	РезультатФоновогоЗадания = Renault_ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"DMS_ОбменДаннымиСДилерскимПорталом.ОтправитьЗаявкуВДилерскийПортал", ПараметрыВызоваСервера);
	Результат = Новый Структура;
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		Результат.Вставить("ФоновоеЗадание", Ложь);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	Иначе 
		Результат.Вставить("ФоновоеЗадание", Истина);
		Результат.Вставить("ФоновоеЗаданиеИдентификатор", РезультатФоновогоЗадания.ИдентификаторЗадания);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте()
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = Renault_ДлительныеОперации.ЗаданиеВыполнено(РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);

	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор Тогда
				Renault_ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОбработатьРезультатВыполненияЗадания();
		Иначе
		Renault_ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыполненияЗадания()
	сОтвет = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);
	Если сОтвет.Свойство("Ошибка") и сОтвет.Ошибка Тогда
		Ответ = Вопрос ("Отправка заявки не завершена, поставить заявку в очередь на отправку?", РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ЭтаФорма.Записать();
			ЭтаФорма.Закрыть();
		иначе
			ЭтаФорма.Закрыть();
		КонецЕсли;
	Иначе
		Прочитать();
		Объект.НомерDevis = сОтвет.НомерDevis;
		Записать();
		Предупреждение("В Distri.net cоздан запрос на автомобиль № "+ НРег(сОтвет.НомерDevis));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРасчетМинимальногоСрокаПоставки(ЛокальныйРасчет)
	
	ПараметрыРасчетаМДП.Очистить(); 

	КорпКлиент = Объект.ТипЗаявки = ПредопределенноеЗначение("Справочник.DMS_ТипыЗаявки.КорпоративныеКлиенты") ИЛИ Объект.ТипЗаявки = ПредопределенноеЗначение("Справочник.DMS_ТипыЗаявки.КрупныеКлиенты"); 	
	МинимальнаяДатаПоставки = Дата(1,1,1);
	VINДляРасчета = СокрЛП(Объект.VIN);
	BIRДляРасчета = ?(ЗначениеЗаполнено(Объект.ДилерскийЦентр), СокрЛП(Сред(Объект.ДилерскийЦентр.BIR, 1, 8)), СокрЛП(Объект.BIR));
	
	
	Если ЛокальныйРасчет Тогда
		ПараметрыРасчета = DMS_ОбменДаннымиСДилерскимПорталом.РассчитатьМинимальныйСрокПоставки(VINДляРасчета, BIRДляРасчета, КорпКлиент,, Истина);	
		
		Если ПараметрыРасчета.МинимальнаяДатаПоставки = Дата(1,1,1) Тогда 
			ПараметрыРасчета = DMS_ОбменДаннымиСДилерскимПорталом.РассчитатьМинимальныйСрокПоставкиНаДилерскомПортале(VINДляРасчета, BIRДляРасчета, КорпКлиент,, Истина);	
		КонецЕсли;
		
		НоваяСтрока = ПараметрыРасчетаМДП.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыРасчета);
		
		МинимальнаяДатаПоставки = ПараметрыРасчета.МинимальнаяДатаПоставки;
		
	Иначе
		ПараметрыРасчета = DMS_ОбменДаннымиСДилерскимПорталом.РассчитатьМинимальныйСрокПоставкиНаДилерскомПортале(VINДляРасчета, BIRДляРасчета, КорпКлиент,, Истина);	
		
		Если ПараметрыРасчета.МинимальнаяДатаПоставки = Дата(1,1,1) Тогда 
			ПараметрыРасчета = DMS_ОбменДаннымиСДилерскимПорталом.РассчитатьМинимальныйСрокПоставки(VINДляРасчета, BIRДляРасчета, КорпКлиент,, Истина);	
		КонецЕсли;
		
		НоваяСтрока = ПараметрыРасчетаМДП.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыРасчета);
		
		МинимальнаяДатаПоставки = ПараметрыРасчета.МинимальнаяДатаПоставки;
	КонецЕсли;
	
	Если МинимальнаяДатаПоставки <> Дата(1,1,1) И Объект.ДатаЖелаемойПоставки < МинимальнаяДатаПоставки Тогда 
		Объект.ДатаЖелаемойПоставки = МинимальнаяДатаПоставки;
	КонецЕсли;	
	
	УстановитьПояснениеКСрокуПоставки();
	
КонецПроцедуры

