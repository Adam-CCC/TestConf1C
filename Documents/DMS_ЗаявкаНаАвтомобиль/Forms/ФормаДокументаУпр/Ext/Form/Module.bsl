&НаСервере
Функция ЗаполнитьДанныеПоКонтрагенту(ВидСогласия,Согласие)
	
	СтруктураОбъекта = Новый Структура;
	СтруктураКлиента = Новый Структура;
	СтруктураДокумента = Новый Структура;
	СтруктураАвтомобиля = Новый Структура;
	СтруктураСогласия = Новый Структура;
	СтруктураОтвветсвенный = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодтверждающиеДокументы.Серия КАК Серия,
		|	ПодтверждающиеДокументы.Номер КАК Номер,
		|	ПодтверждающиеДокументы.ДатаВыдачи КАК ДатаВыдачи,
		|	ПодтверждающиеДокументы.КемВыдан КАК КемВыдан,
		|	ПодтверждающиеДокументы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
		|ГДЕ
		|	ПодтверждающиеДокументы.Владелец = &Контрагент
		|	И ПодтверждающиеДокументы.Текущий = ИСТИНА";
	
	Запрос.УстановитьПараметр("Контрагент", Объект.Клиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() = 0 Тогда 
		ВызватьИсключение("Нет данных актуального паспорта");
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		СтруктураДокумента.Вставить("passportnumber",Выборка.Номер);
		СтруктураДокумента.Вставить("passportseries",Выборка.Серия);
		СтруктураДокумента.Вставить("passportissued",Выборка.КемВыдан); 
		СтруктураДокумента.Вставить("passportday",День(Выборка.ДатаВыдачи));
		СтруктураДокумента.Вставить("passportmonth",Месяц(Выборка.ДатаВыдачи));
		СтруктураДокумента.Вставить("passportyear",Год(Выборка.ДатаВыдачи));
	КонецЦикла;

	СтруктураКлиента.Вставить("lastname",Фамилия);
	СтруктураКлиента.Вставить("firstname",Имя);
	СтруктураКлиента.Вставить("middlename",Отчество);
	СтруктураКлиента.Вставить("birthday",ДатаРождения);
	СтруктураКлиента.Вставить("gender",?(Объект.Клиент.Пол=Перечисления.ПолФизическихЛиц.НеУказан,"",""+Объект.Клиент.Пол));
	СтруктураКлиента.Вставить("address",АдресКлиента);
	СтруктураКлиента.Вставить("tel",Renault_CRM.ПолучитьТелефонКлиент(Объект.Клиент));
	СтруктураКлиента.Вставить("email",Renault_CRM.ПолучитьЕмаилКлиент(Объект.Клиент));
	СтруктураКлиента.Вставить("company",?(Объект.Клиент.ФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо,Истина,Ложь));
	СтруктураКлиента.Вставить("document",СтруктураДокумента);
	СтруктураОбъекта.Вставить("client",СтруктураКлиента);
	
	СтруктураАвтомобиля.Вставить("mark","");
	СтруктураАвтомобиля.Вставить("vin",Объект.VIN);
	СтруктураАвтомобиля.Вставить("daybuycar",Дата('00010101'));
	СтруктураОбъекта.Вставить("auto",СтруктураАвтомобиля);
	
	СтруктураСогласия.Вставить("form",ВидСогласия);
	СтруктураСогласия.Вставить("agree",Согласие);
	СтруктураОбъекта.Вставить("consent",СтруктураСогласия);
	
	СтруктураОтвветсвенный.Вставить("name",""+ПараметрыСеанса.Пользователь.Сотрудник);
	СтруктураОтвветсвенный.Вставить("from","Клиентская заявка");
	СтруктураОбъекта.Вставить("responsible",СтруктураОтвветсвенный);
	
	Возврат СтруктураОбъекта;
	
КонецФункции

&НаКлиенте
Процедура ДокументСогласияНажатие(Элемент, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ДокументСогласия) Тогда 
		ОткрытьЗначение(ДокументСогласия)
	Иначе 
		ПараметрыОткрытияФормы = Новый Структура;
		ПараметрыОткрытияФормы.Вставить("Клиент",Объект.Клиент);
		Оповещение = Новый ОписаниеОповещения("DMS_СогласиеНаОбработкуПерсональныхДанныхЗавершение",ЭтаФорма);
		ОткрытьФорму("Документ.DMS_СогласиеНаОбработкуПерсональныхДанных.Форма.ФормаДокумента",ПараметрыОткрытияФормы,ЭтаФорма,,,,Оповещение);		
	КонецЕсли;
	
КонецПроцедуры

