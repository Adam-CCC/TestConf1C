&НаСервере
Процедура ПриОткрытииНаСервере()
	
	НеОбновлятьПриАктивизацииСтроки = Истина; 
	ОбновитьСписокМоделей(); 
	ОбновитьСписокКонфигураций (Модель);
	ОбновитьСписокЦветов(Модель); 
	ОбновитьСпискиОборудованияАксессуаров();
	
	Если ЗначениеЗаполнено(Модель) и ЗначениеЗаполнено(Версия) Тогда
		УстановитьВыбранныеМодельИВерсии();
		//ЗаполнитьВариантыСалонаИЦвет();
	КонецЕсли;
	
	НеОбновлятьПриАктивизацииСтроки = Ложь;
	
КонецПроцедуры

&НаСервере 
Процедура УстановитьВыбранныеМодельИВерсии ()
	МассивСтрок = ТаблицаМодели.НайтиСтроки(Новый Структура("Модель", Модель));
    Если МассивСтрок.Количество() > 0 Тогда
        Элементы.ТаблицаМодели.ТекущаяСтрока = МассивСтрок[0].ПолучитьИдентификатор();
	КонецЕсли;
	МассивСтрок = ТаблицаКомплектаций.НайтиСтроки(Новый Структура("Версия", Версия));
    Если МассивСтрок.Количество() > 0 Тогда
        Элементы.ТаблицаКомплектаций.ТекущаяСтрока = МассивСтрок[0].ПолучитьИдентификатор();
	КонецЕсли;
	МассивСтрок = ТаблицаЦветов.НайтиСтроки(Новый Структура("Цвет", Цвет));
    Если МассивСтрок.Количество() > 0 Тогда
        Элементы.ТаблицаЦветов.ТекущаяСтрока = МассивСтрок[0].ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры


