&НаКлиенте
Процедура ТаблицаКомплектацийПриАктивизацииСтроки(Элемент)
	
	Если НеОбновлятьПриАктивизацииСтроки Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные <> Неопределено и Версия <> Элемент.ТекущиеДанные.Версия Тогда
		Версия = Элемент.ТекущиеДанные.Версия; 
		Элементы.ЦветСалона.СписокВыбора.Очистить();
		ЦветСалона = ПредопределенноеЗначение("Справочник.DMS_ЦветаСалона.ПустаяСсылка");
		Элементы.ВариантСалона.СписокВыбора.Очистить();
		ВариантСалона = ПредопределенноеЗначение("Справочник.DMS_ВариантыСалона.ПустаяСсылка");
		ОбновитьСпискиОборудованияАксессуаров();
		ЗаполнитьВариантыСалонаИЦвет();
		Если Элементы.ВариантСалона.СписокВыбора.Количество() Тогда
			ВариантСалона = Элементы.ВариантСалона.СписокВыбора[0].Значение;
		КонецЕсли;
		Если Элементы.ЦветСалона.СписокВыбора.Количество() Тогда
			ЦветСалона = Элементы.ЦветСалона.СписокВыбора[0].Значение;
		КонецЕсли;
	КонецЕсли;
	УстановитьОтборДляБазовыхОпции();	
	
	
КонецПроцедуры     

&НаКлиенте
Процедура ОбработчикСменыВариантаКомплектации () Экспорт 
	ЗаполнитьВариантыСалонаИЦвет();	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВариантыСалонаИЦвет()
	
	// +++ Кудинов И.  19.08.2016
	ПараметрыВызоваСервера = Новый Структура;
	ПараметрыВызоваСервера.Вставить("Модель", ПолучитьАртикул(Модель));
	ПараметрыВызоваСервера.Вставить("Версия", ПолучитьАртикул(Версия));
	РезультатПолученияДопИнформации = ВыполнитьЗапрос (ПараметрыВызоваСервера);
	Если РезультатПолученияДопИнформации.ФоновоеЗадание Тогда
		Renault_ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", 1, Истина);
		ФормаДлительнойОперации = Renault_ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);
	Иначе
		ОбработатьРезультатВыполненияЗадания();
	КонецЕсли;

	
	Возврат;
	// --- Кудинов И.  19.08.2016
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапрос (ПараметрыВызоваСервера)
	РезультатФоновогоЗадания = Renault_ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"DMS_ОбменДаннымиСДилерскимПорталом.GetVersionsInteriorColor", ПараметрыВызоваСервера);
	Результат = Новый Структура;
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		Результат.Вставить("ФоновоеЗадание", Ложь);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	Иначе 
		Результат.Вставить("ФоновоеЗадание", Истина);
		Результат.Вставить("ФоновоеЗаданиеИдентификатор", РезультатФоновогоЗадания.ИдентификаторЗадания);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте()
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = Renault_ДлительныеОперации.ЗаданиеВыполнено(РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);

	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор Тогда
				Renault_ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОбработатьРезультатВыполненияЗадания();
		Иначе
		Renault_ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыполненияЗадания()
	
	сОтвет = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);
	
	Если сОтвет.Свойство("Ошибка") и сОтвет.Ошибка Тогда
		Ответ = Вопрос ("Отправка заявки не завершена, поставить заявку в очередь на отправку?", РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ЭтаФорма.Записать();
			ЭтаФорма.Закрыть();
		иначе
			ЭтаФорма.Закрыть();
		КонецЕсли;
	Иначе
		
		ВариантСалона_ = ПолучитьСсылкуПоАртикулу(сОтвет.ВариантСалона, "DMS_ВариантыСалона");
		Элементы.ВариантСалона.РежимВыбораИзСписка = Истина;
		Элементы.ВариантСалона.СписокВыбора.ЗагрузитьЗначения(ВариантСалона_);  		
		
		ЦветСалона_ = ПолучитьСсылкуПоАртикулу(сОтвет.ЦветСалона, "DMS_ЦветаСалона");
		Элементы.ЦветСалона.РежимВыбораИзСписка = Истина;
		Элементы.ЦветСалона.СписокВыбора.ЗагрузитьЗначения(ЦветСалона_);
		
	КонецЕсли;
	
КонецПроцедуры

