&НаСервере
Процедура ОбновитьСписокМоделей()
	
	Бренд = ПараметрыСеанса.DMS_Бренд;
	
	Если ЗначениеЗаполнено(Бренд) Тогда
		МаркаРено = Бренд;
	Иначе
		МаркаРено = CRM_Сервер.ПолучитьМаркуRenault();
	КонецЕсли;
	
	МассивМарок = Новый Массив;
	Если Не МаркаРено.Пустая() Тогда
		МассивМарок = МаркаРено.МоделиАвтомобилейКоммерческоеПредложение.ВыгрузитьКолонку("Модель");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&ПустаяСтрока КАК Модель,
	               |	"""" КАК Наименование
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Модели.Ссылка,
	               |	Модели.Наименование
	               |ИЗ
	               |	Справочник.Модели КАК Модели
	               |ГДЕ
	               |	Модели.Ссылка В(&МассивМарок)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	Запрос.УстановитьПараметр("ПустаяСтрока", Справочники.Модели.ПустаяСсылка());
	Запрос.УстановитьПараметр("МассивМарок", МассивМарок);
	Таблица = Запрос.Выполнить().Выгрузить();
	ТаблицаМодели.Загрузить(Таблица);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//ТекущийТариф = Renault_ОбщегоНазначенияНаСервере.ПолучитьТекущийТарифНаАвтомобили();
	ТекущийТариф = Renault_CRM.ПолучитьТекущийТарифНаАвтомобили();
	
	Если Параметры.Свойство("Модель") Тогда
		Модель = Параметры.Модель; 
		ТипАвтомобиля = Перечисления.DMS_ТипыАвтомобилей.VP;
		//Если Модель.Артикул = "MAU" или Модель.Артикул = "TFU" Тогда
		//	ТипАвтомобиля = Перечисления.ТипыАвтомобилей.VU;
		//КонецЕсли;
	Иначе
		Модель = Справочники.Модели.ПустаяСсылка();
	КонецЕсли;
	Если Параметры.Свойство("Версия") Тогда
		Версия = Параметры.Версия;
	Иначе 
		Версия = Справочники.ВариантыКомплектации.ПустаяСсылка();
	КонецЕсли;
	Если Параметры.Свойство("Цвет") Тогда
		Цвет = Параметры.Цвет;
	Иначе
		Цвет = Справочники.Цвета.ПустаяСсылка();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Модель) и ЗначениеЗаполнено(Версия) Тогда
		Если Параметры.Свойство("Опции") Тогда
			Опции = Параметры.Опции;
			ЗаполнитьТаблицуОпций ();
		КонецЕсли;
		Если Параметры.Свойство("Салон") Тогда
			ЭтаФорма.ВариантСалона = Параметры.Салон;
		КонецЕсли;
		Если Параметры.Свойство("ЦветСалона") Тогда
			ЭтаФорма.ЦветСалона = Параметры.ЦветСалона;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("VIN") Тогда
		Элементы.ВыбранныеНебазовыеОпцииВыбран.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

