&НаСервереБезКонтекста
Функция ПолучитьСсылкуПоАртикулу(Артикулы, Справочник)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	т.Ссылка
		|ИЗ
		|	Справочник."+Справочник+" КАК т
		|ГДЕ
		|	т.Артикул В(&Артикул)";
	
	Запрос.УстановитьПараметр("Артикул", Артикулы);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат РезультатЗапроса;

КонецФункции // ПолучитьСсылкуПоАртикулу()


