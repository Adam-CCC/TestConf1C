&НаКлиенте
Процедура УстановитьОтборДляБазовыхОпции ()
	Renault_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(БазовыеОпции,"Модель",Модель,ВидСравненияКомпоновкиДанных.Равно,,Истина);
	Renault_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(БазовыеОпции,"ВариантКомплектации",Версия,ВидСравненияКомпоновкиДанных.Равно,,Истина);
	Renault_ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(БазовыеОпции,"Тариф",ТекущийТариф,ВидСравненияКомпоновкиДанных.Равно,,Истина);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСпискиОборудованияАксессуаров()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тариф", ТекущийТариф);
	Запрос.УстановитьПараметр("УжеВыбрано", ВыбранныеНебазовыеОпции.Выгрузить());
	Запрос.УстановитьПараметр("Модель", Модель);
	Запрос.УстановитьПараметр("ВариантКомплектации", Версия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УжеВыбрано.Выбран,
	|	УжеВыбрано.Опция
	|ПОМЕСТИТЬ ВТ_УжеВыбрано
	|ИЗ
	|	&УжеВыбрано КАК УжеВыбрано
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТарифНаОпцииАвтомобилей.Опция КАК ОпцияСпр,
	|	ТарифНаОпцииАвтомобилей.ЦенаКлиентская,
	|	ТарифНаОпцииАвтомобилей.Опция.Артикул КАК КодОпции
	|ПОМЕСТИТЬ ВТ_Опции
	|ИЗ
	|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних КАК ТарифНаОпцииАвтомобилей
	|ГДЕ
	|	ТарифНаОпцииАвтомобилей.Тариф = &Тариф
	|	И ТарифНаОпцииАвтомобилей.Базовая = ЛОЖЬ
	|	И ТарифНаОпцииАвтомобилей.Модель = &Модель
	|	И ТарифНаОпцииАвтомобилей.ВариантКомплектации = &ВариантКомплектации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Опции.ОпцияСпр КАК Опция,
	|	ВТ_Опции.ЦенаКлиентская КАК Цена,
	|	ЕСТЬNULL(ВТ_УжеВыбрано.Выбран, ЛОЖЬ) КАК Выбран,
	|	ВТ_Опции.КодОпции КАК КодОпции
	|ИЗ
	|	ВТ_Опции КАК ВТ_Опции
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УжеВыбрано КАК ВТ_УжеВыбрано
	|		ПО ВТ_Опции.ОпцияСпр = ВТ_УжеВыбрано.Опция
	|ГДЕ
	|	ВТ_Опции.ОпцияСпр.Артикул <> ""PM""";
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	ВыбранныеНебазовыеОпции.Загрузить(ТаблицаРезультат);
	СформироватьСтрокуОпций();
КонецПроцедуры

&НаСервере
Процедура СформироватьСтрокуОпций ()
	ТаблицаОций = РеквизитФормыВЗначение("ВыбранныеНебазовыеОпции");
	Отбор = Новый Структура;
	Отбор.Вставить("Выбран",Истина);
	мОпций = ТаблицаОций.НайтиСтроки(Отбор);
	Опции = "";
	Если мОпций.Количество () Тогда 
		Для Каждого СтрокаОпции из мОпций Цикл
			Опции = Опции + СтрокаОпции.КодОпции +" ";
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеНебазовыеОпцииВыбранПриИзменении(Элемент)
	СформироватьСтрокуОпций();
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если Не ЗначениеЗаполнено(ТипАвтомобиля) тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Поле = "ТипАвтомобиля";
		Сообщение.Текст = "Поле не заполнено";
		Сообщение.УстановитьДанные(ТипАвтомобиля);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Модель) и ЗначениеЗаполнено(Версия) и ЗначениеЗаполнено(Цвет) Тогда
		сОтвет = Новый Структура;
		сОтвет.Вставить("Модель",Модель);
		сОтвет.Вставить("Версия", Версия);
		сОтвет.Вставить("Цвет", Цвет);
		сОтвет.Вставить("Опции", Опции);
		сОтвет.Вставить("Салон", ВариантСалона);
		сОтвет.Вставить("ЦветСалона", ЦветСалона);
		сОтвет.Вставить("ТипАвтомобиля", ТипАвтомобиля);
	Иначе
		сОтвет = Неопределено;
	КонецЕсли;
		
	Закрыть(сОтвет);
	
КонецПроцедуры

