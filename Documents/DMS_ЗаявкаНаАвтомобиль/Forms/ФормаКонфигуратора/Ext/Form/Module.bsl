&НаКлиенте
Процедура ТаблицаМоделиПриАктивизацииСтроки(Элемент)
	
	Если НеОбновлятьПриАктивизацииСтроки или Модель = Элемент.ТекущиеДанные.Модель Тогда
		Возврат;
	КонецЕсли;
	
	Модель = Элемент.ТекущиеДанные.Модель;
	ТипАвтомобиля = ПредопределенноеЗначение("Перечисление.DMS_ТипыАвтомобилей.VP");
	//Если Модель = "MAU" или Модель = "TFU" Тогда
	//	ТипАвтомобиля = ПредопределенноеЗначение("Перечисление..ТипыАвтомобилей.VU");
	//КонецЕсли;

	Элементы.ВариантСалона.СписокВыбора.Очистить();
	ВариантСалона = ПредопределенноеЗначение("Справочник.DMS_ВариантыСалона.ПустаяСсылка");
	Элементы.ЦветСалона.СписокВыбора.Очистить();
	ЦветСалона = ПредопределенноеЗначение("Справочник.DMS_ЦветаСалона.ПустаяСсылка");
	Версия = ПредопределенноеЗначение("Справочник.ВариантыКомплектации.ПустаяСсылка");
	Цвет = ПредопределенноеЗначение("Справочник.Цвета.ПустаяСсылка");
	ОбновитьСписокКонфигураций (Модель);
	ОбновитьСписокЦветов(Модель);
	УстановитьОтборДляБазовыхОпции();
КонецПроцедуры

