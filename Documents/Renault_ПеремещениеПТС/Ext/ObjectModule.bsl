
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.Renault_ОстаткиПТС.Записывать = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_ПеремещениеПТССостав.ПТС,
		|	Renault_ПеремещениеПТССостав.Ссылка.СкладОтправитель,
		|	ЕСТЬNULL(Renault_ОстаткиПТСОстатки.КоличествоОстаток,0) КАК Остаток
		|ИЗ
		|	Документ.Renault_ПеремещениеПТС.Состав КАК Renault_ПеремещениеПТССостав
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Renault_ОстаткиПТС.Остатки(&МоментВремени, ) КАК Renault_ОстаткиПТСОстатки
		|		ПО Renault_ПеремещениеПТССостав.ПТС = Renault_ОстаткиПТСОстатки.ПТС
		|			И Renault_ПеремещениеПТССостав.Ссылка.СкладОтправитель = Renault_ОстаткиПТСОстатки.Склад
		|ГДЕ
		|	Renault_ПеремещениеПТССостав.Ссылка = &Ссылка
		|	И ЕСТЬNULL(Renault_ОстаткиПТСОстатки.КоличествоОстаток, 0) <= 0";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Сообщить("Нет на складе " + Выборка.ПТС);
		Отказ = Истина;
	КонецЦикла;
	// регистр Renault_ОстаткиПТС Приход
	
	Для Каждого ТекСтрокаСостав Из Состав Цикл
		Движение = Движения.Renault_ОстаткиПТС.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Склад = СкладПолучатель;
		Движение.ПТС = ТекСтрокаСостав.ПТС;
		Движение.Количество = 1;
	КонецЦикла;

	// регистр Renault_ОстаткиПТС Расход
	Для Каждого ТекСтрокаСостав Из Состав Цикл
		Движение = Движения.Renault_ОстаткиПТС.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Склад = СкладОтправитель;
		Движение.ПТС = ТекСтрокаСостав.ПТС;
		Движение.Количество = 1;
	КонецЦикла;

КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	Если СкладОтправитель = СкладПолучатель Тогда
		Сообщить("Вы пытаетесь перемещать ПТС внутри одного склада ПТС! Остановитесь!");
		Отказ = Истина;
	КонецЕсли;
	
	УникальныеПТС = Состав.Выгрузить(, "ПТС");
	УникальныеПТС.Свернуть("ПТС");
	Если УникальныеПТС.Количество() <> Состав.Количество() Тогда
		Сообщить("В списке документов ПТС есть повторяющиеся строки");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры
