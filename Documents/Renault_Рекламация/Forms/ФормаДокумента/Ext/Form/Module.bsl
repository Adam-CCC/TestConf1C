// НА СЕРВЕРЕ

&НаСервере
Функция неиспользуется_ОтражатьНоменклатуруПоФакту()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВЫБОР
	                      |		КОГДА &ВидРекламации = ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииВиды.Недостача)
	                      |				ИЛИ &ВидРекламации = ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииВиды.Излишки)
	                      |				ИЛИ &ВидРекламации = ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииВиды.Пересорт)
	                      |				ИЛИ &ВидРекламации = ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииВиды.НевернаяОтгрузка)
	                      |				ИЛИ &ВидРекламации = ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииВиды.ПовреждениеПриТранспортировке)
	                      |				ИЛИ &ВидРекламации = ЗНАЧЕНИЕ(Перечисление.Renault_РекламацииВиды.БракПриПроизводстве)
	                      |			ТОГДА ИСТИНА
	                      |		ИНАЧЕ ЛОЖЬ
	                      |	КОНЕЦ КАК ОтображатьГруппуНоменклатураПлан");
	Запрос.УстановитьПараметр("ВидРекламации", Объект.ВидРекламации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ОтображатьГруппуНоменклатураПлан;
КонецФункции

&НаСервере
Процедура УстановитьРеферансИЕдиницу(ОбновитьЕдиницу,План)
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.УстановитьРеферансИЕдиницу(ОбновитьЕдиницу,План,ЭтаФорма);
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
КонецПроцедуры

&НаСервере
Процедура ОбновитьКартинкиИФайлы()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	КартинкиИФайлы.ИмяФайла,
	|	КартинкиИФайлы.ДатаСохранения,
	|	КартинкиИФайлы.РазмерФайла / 1024 / 1024 КАК РазмерФайла,
	|	КартинкиИФайлы.Комментарий,
	|	КартинкиИФайлы.Идентификатор
	|ИЗ
	|	РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы
	|ГДЕ
	|	КартинкиИФайлы.Объект = &Объект");
	
	Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
	КартинкиИФайлы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Элементы.КартинкиИФайлы.Обновить();

КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокуИЗРегистра(ИдентификаторФайла)
	Renault_ОбщийМодульСервер.УдалитьФайлИзРегистра(Объект.Ссылка, ИдентификаторФайла);
	
	ОбновитьКартинкиИФайлы();
КонецПроцедуры

&НаСервере
Процедура ОбработкаРеквизитаСервер(Имя,ДопПараметры=Неопределено)
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ОбработкаРеквизита(Имя,ЭтаФорма,ДопПараметры);
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦеныСервер()
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ПересчитатьЦены();
	ЗначениеВРеквизитФормы(ДокументОбъект,"Объект");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокЗначенийСтатусов(ТекущийСтатус)
	
	СписокСтатусов = Новый Массив;
	Если ТекущийСтатус <> Перечисления.Renault_РекламацииСтатусы.Draft Тогда
		СписокСтатусов.Добавить(Перечисления.Renault_РекламацииСтатусы.Draft);	
	КонецЕсли;
	Если ТекущийСтатус <> Перечисления.Renault_РекламацииСтатусы.ReadyToSent Тогда
		СписокСтатусов.Добавить(Перечисления.Renault_РекламацииСтатусы.ReadyToSent);
	КонецЕсли;
	
	Возврат СписокСтатусов;
	
КонецФункции

