
&НаКлиенте
Перем РезультатПолученияДопИнформации;
&НаКлиенте
Перем ФормаДлительнойОперации;
&НаКлиенте
Перем ПараметрыОбработчика;


/////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ТекущийСтатус = Перечисления.Renault_РекламацииСтатусы.Draft;
		Объект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
		
		Объект.Решение = Неопределено;
		Объект.КлассификацияОтказов = Неопределено;
		Объект.СуммаВозмещения = 0;
		Объект.КоличествоНормоЧасов = 0;
		Объект.ДатаПринятияРешения = Дата("00010101");
		Объект.ОписаниеРешения = "";
	КонецЕсли;
	
	ОбновитьКартинкиИФайлы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.Ссылка.Пустая() Тогда
		Если ЗначениеЗаполнено(Объект.ДокументОснование) И ТипЗнч(Объект.ДокументОснование)=Тип("ДокументСсылка.ПоступлениеТоваров") 
			И Не ЗначениеЗаполнено(Объект.НоменклатураПлан) // если заполнено, значит мы открываем форму уже второй раз (после выбора номенклатуры для рекламации)
			Тогда
			
			ЗаполнитьПоПоступлению(Отказ);
			Если Отказ Тогда Возврат; КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьВидимость();
	УстановитьДоступность();
	
	УстановитьРеферансИЕдиницу(Ложь,"");
	УстановитьРеферансИЕдиницу(Ложь,"План");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ПроверитьЗаполнение() Тогда Отказ = Истина; Возврат; КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьКартинкиИФайлы" Тогда ОбновитьКартинкиИФайлы(); КонецЕсли;
КонецПроцедуры

/////////////////////////////////////////////////////////////////////////
// НА КЛИЕНТЕ

&НаКлиенте
Процедура ЗаполнитьПоПоступлению(Отказ)
	Отказ = Истина;
	
	ПФ = Новый Структура();
	ПФ.Вставить("Поступление",Объект.ДокументОснование);
	ОткрытьФорму("Документ.Renault_Рекламация.Форма.ВыборНоменклатурыИзПоступления",ПФ,Новый УникальныйИдентификатор);
КонецПроцедуры

