&НаКлиенте
Процедура ФоновоеЗаданиеВыгрузкаРекламации()
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = Renault_ДлительныеОперации.ЗаданиеВыполнено(РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);

	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор Тогда
				Renault_ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОбработатьРезультатВыполненияЗадания();
		Иначе
		Renault_ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеВыгрузкаРекламации", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатВыполненияЗадания()
	
	Ответ = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);
	Если Ответ.ЗавершенУспешно Тогда
		Прочитать();
		
		УстановитьВидимость();
		УстановитьДоступность();
		
		Объект.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.Renault_РекламацииСтатусы.Sent");		
		Объект.ЦентральныйНомер = Ответ.Номер;
		Записать();
		// Трояновский К.Е. 20.02.2019 11:14:30 }
		
		РезультатВыгрузки = "Документ выгружен в центр";
		ОповеститьОбИзменении(Объект.Ссылка);
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Ответ.ОписаниеОшибок;
		Сообщение.УстановитьДанные(ЭтаФорма);
		Сообщение.Сообщить();
		
		РезультатВыгрузки = "Не удалось выгрузить документ";
	КонецЕсли;
	
	// Трояновский К.Е. 20.02.2019 11:16:23 {
	ОбновитьИнтерфейс();
	// Трояновский К.Е. 20.02.2019 11:16:23 }
	
	ПоказатьПредупреждение(,РезультатВыгрузки);
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапрос (ПараметрыВызоваСервера)
	
	// Трояновский К.Е. 20.02.2019 12:05:39 {
	РезультатФоновогоЗадания = Renault_ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
		"Renault_РекламацииСервер.Выгрузить20", ПараметрыВызоваСервера);
	// Трояновский К.Е. 20.02.2019 12:05:39 }
	Результат = Новый Структура;
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		Результат.Вставить("ФоновоеЗадание", Ложь);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	Иначе 
		Результат.Вставить("ФоновоеЗадание", Истина);
		Результат.Вставить("ФоновоеЗаданиеИдентификатор", РезультатФоновогоЗадания.ИдентификаторЗадания);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ВыгрузитьНаСервере()
	
	Массив = Новый Массив;
	Массив.Добавить(Объект.Ссылка);
	
	РезультатВыполнения = Renault_РекламацииСервер.ВыгрузитьСинхронно20(Массив);
	
	Если РезультатВыполнения.ЗавершенУспешно Тогда
		Объект.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.Renault_РекламацииСтатусы.Sent");		
		Объект.ЦентральныйНомер = РезультатВыполнения.Номер;
		Записать();
		Сообщить("Документ успешно выгружен");
	Иначе
		Сообщить("Не удалось выгрузить документ");
		Сообщить(РезультатВыполнения.ОписаниеОшибок);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКомментарий(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаКомментария", ЭтотОбъект);
 
    ПоказатьВводСтроки(Оповещение,, "Введите комментарий", 0, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКомментария(Результат, Параметры) Экспорт
 
    Если Не Результат = Неопределено Тогда
        ПослеВводаКомментарияНаСервере(Результат);
    КонецЕсли;
 
КонецПроцедуры

&НаСервере
Процедура ПослеВводаКомментарияНаСервере(Комментарий)

	Результат = Renault_РекламацииСервер.ВыгрузитьКомментарий(Объект.ЦентральныйНомер, Комментарий);
	Если Результат.ЗавершенУспешно Тогда
		Сообщить("Комменатрий успешно добавлен");
	Иначе
		Сообщить("Получена ошибка: " + Результат.ОписаниеОшибок);
	КонецЕсли;

КонецПроцедуры

