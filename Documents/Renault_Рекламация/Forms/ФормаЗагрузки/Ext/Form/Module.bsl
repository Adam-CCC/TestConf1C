&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	
	ДатаЗаписи = ТекущаяДата();
	ИдентификаторВХранилище = Renault_РекламацииКлиент.ПоместитьФайлДляРекламации(ЭтаФорма);
	
	Если ЗначениеЗаполнено(ИдентификаторВХранилище) тогда //Файл записался удачно
		
		//Добавляем новую строку
		НС = КартинкиИФайлы.Добавить();
		
		НС.ИмяФайла		  = НаименованиеФайла;
		НС.Идентификатор  = ИдентификаторВХранилище;
		НС.ДатаСохранения = ТекущаяДата();
		НС.Комментарий	  = ОписаниеФайла;
		
		АдресВременногоХранилища = "";
		НаименованиеФайла = "";
		РасширениеФайла = "";
		ОписаниеФайла = "";
		
	КонецЕсли;
	
КонецПроцедуры

