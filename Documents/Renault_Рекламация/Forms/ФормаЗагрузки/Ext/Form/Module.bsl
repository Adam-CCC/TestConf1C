&НаКлиенте
Процедура ЗагрузитьФайлыВБазу(Команда)
	
	ДатаЗаписи = ТекущаяДата();
	
	Для Каждого СтрокаФайл Из ТаблицаФайловДляЗагрузки Цикл
	
		ИдентификаторВХранилище = Renault_РекламацииКлиент.ПоместитьФайлыДляРекламации(ЭтаФорма, СтрокаФайл.ОписаниеФайла, СтрокаФайл.АдресВоВременномХранилище, СтрокаФайл.НаименованиеФайла, СтрокаФайл.Расширение);
		
		Если ЗначениеЗаполнено(ИдентификаторВХранилище) тогда //Файл записался удачно
			
			//Добавляем новую строку
			НС = КартинкиИФайлы.Добавить();
			
			НС.ИмяФайла		  = СтрокаФайл.НаименованиеФайла + "." + СтрокаФайл.Расширение;
			НС.Идентификатор  = ИдентификаторВХранилище;
			НС.ДатаСохранения = ТекущаяДата();
			НС.Комментарий	  = СтрокаФайл.ОписаниеФайла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьФайлыВБазу()

