// Обработка изменения реквизитов документа
// Параметры
//  Имя			– Строка – Имя реквизита документа с полным путем (например Товары.Номенклатура).
//  ЭтаФорма	– Форма	 – Ссылка на форму документа. Если значение неопределено,
//                         производится программная обработка реквизитов.
//  ДопПараметры– Структура			– Структура, содержащая дополнительные параметры обработки реквизита.
// Возвращаемое значение:
//   Булево   – Результат выполнения обработки.
Функция ОбработкаРеквизита(Имя,ЭтаФорма=Неопределено,ДопПараметры=Неопределено) Экспорт
	Если Имя = "ДилерскийЦентр" Тогда
		НомерДилера = Документы.Renault_Рекламация.ПолучитьСИТ(ДилерскийЦентр);	
	ИначеЕсли Имя = "Номенклатура" Тогда
		Количество = ?(Количество = 0,1,Количество);
		УстановитьРеферансИЕдиницу(Истина,"",ЭтаФорма);
		
	ИначеЕсли Имя = "НоменклатураПлан" Тогда
		КоличествоПлан = ?(КоличествоПлан = 0,1,КоличествоПлан);
		УстановитьРеферансИЕдиницу(Истина,"План",ЭтаФорма);
		
	ИначеЕсли Имя = "Цена" Тогда
		РасчитатьСуммы(Ложь);	
	ИначеЕсли Имя = "ЦенаПлан" Тогда
		РасчитатьСуммы(Истина);	
	ИначеЕсли Имя = "ЕдИзмерения" Тогда
		РасчитатьСуммы(Ложь);	
	ИначеЕсли Имя = "ЕдИзмеренияПлан" Тогда
		РасчитатьСуммы(Истина);	
	ИначеЕсли Имя = "Количество" Тогда
		РасчитатьСуммы(Ложь);	
	ИначеЕсли Имя = "КоличествоПлан" Тогда
		РасчитатьСуммы(Истина);	
	ИначеЕсли Имя = "СтавкаНДС" Тогда
		РасчитатьСуммы(Ложь);	
	ИначеЕсли Имя = "СтавкаНДСПлан" Тогда
		РасчитатьСуммы(Истина);
	КонецЕсли;
	
	Возврат Истина;
КонецФункции


Процедура УстановитьРеферансИЕдиницу(ОбновитьЕдиницу,План,Этаформа) Экспорт
	
	Если ЗначениеЗаполнено(ЭтотОбъект["Номенклатура"+План]) тогда
		ЭтаФорма["Реферанс"+План] = ЭтотОбъект["Номенклатура"+План].Артикул;
		
		ЭтаФорма["ТипНоменклатуры"+План] = ЭтотОбъект["Номенклатура"+План].ТипНоменклатуры;
		
		Если ЭтаФорма["ТипНоменклатуры"+План].ИспользованиеЕдиницИзмерения = 1 тогда
			ПараметрВыбора = Новый СвязьПараметраВыбора("Отбор.Владелец", "ТипНоменклатуры"+План);
		Иначе
			ПараметрВыбора = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Номенклатура"+План);
		КонецЕсли;
		
		Массив = Новый Массив;
		Массив.Добавить(ПараметрВыбора);
		Фмассив = Новый ФиксированныйМассив(Массив);
		
	Иначе

		ЭтотОбъект["Цена"+План] = 0;	
	КонецЕсли;
	
КонецПроцедуры

Процедура РасчитатьСуммы(План) Экспорт

	План=?(План, "План", "");

	//Расчет суммы
	ЭтотОбъект["Сумма"+План] = ЭтотОбъект["Количество"+План] * ЭтотОбъект["Цена"+План];

КонецПроцедуры


