Функция ПроверитьЗаполненность() Экспорт

	Отказ = Ложь;

	ПроверитьНаличиеФотографий(Отказ);

	Если НЕ значениеЗаполнено(КоличествоМестЗафактурованно) тогда
        СообщениеОбОшибке("Необходимо заполнить поле ""Мест зафактурировано""","КоличествоМестЗафактурованно",Отказ);
	КонецЕсли;

	Если ВидРекламации = Перечисления.Renault_РекламацииВиды.Брак тогда

		Если НЕ значениеЗаполнено(НомерТрН) тогда
			СообщениеОбОшибке("Необходимо указать номер товарно-транспортной накладной","НомерТТН",Отказ);
		КонецЕсли;
		
		Если НЕ значениеЗаполнено(ФИОВодителя) тогда
			СообщениеОбОшибке("Необходимо указать ФИО водителя, доставившего груз","ФИОВодителя",Отказ);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(КоличествоМестПовреждено) тогда
			СообщениеОбОшибке("Необходимо заполнить поле ""Повреждено""","КоличествоМестПовреждено",Отказ);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПоврежденноеКоличество) тогда
			СообщениеОбОшибке("Необходимо заполнить поле ""Поврежденное количество реферанса""","ПоврежденноеКоличество",Отказ);
		КонецЕсли;
		
	КонецЕсли;

	Возврат Не Отказ;

КонецФункции

Процедура ПроверитьНаличиеФотографий(Отказ)

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	КартинкиИФайлы.Идентификатор
	|ИЗ
	|	РегистрСведений.КартинкиИФайлы КАК КартинкиИФайлы
	|ГДЕ
	|	КартинкиИФайлы.Объект = &Объект");
	
	Запрос.УстановитьПараметр("Объект", Ссылка);
	КартинкиИФайлы = Запрос.Выполнить().Выгрузить();
	
	Если КартинкиИФайлы.Количество() = 0 тогда
		СообщениеОбОшибке("В документ не добавленно ни одной фотографии или скана документов","КартинкиИФайлы",Отказ);
	КонецЕсли;

КонецПроцедуры

