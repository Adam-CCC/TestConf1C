Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//Для нового документа стартовый статус - черновик
	ТекущийСтатус = Перечисления.Renault_РекламацииСтатусы.Draft;
	Автор = ПараметрыСеанса.Пользователь.Сотрудник;
	
	Если ТипЗнч(ДанныеЗаполнения)=Тип("ДокументСсылка.ПоступлениеТоваров") Тогда
		// не будем пока заполнять, пусть пользователь сначала выберет номенклатуру из поступления
		ДокументОснование = ДанныеЗаполнения;
		Возврат;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения)=Тип("Структура") Тогда	
		Если ДанныеЗаполнения.Свойство("НомерСтрокиИзПоступления") Тогда
			ЗаполнитьПоПоступлению(ДанныеЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	Организация = ?(ЗначениеЗаполнено(Организация), Организация, ПараметрыСеанса.Организация);
	ПодразделениеКомпании = ?(ЗначениеЗаполнено(ПодразделениеКомпании), ПодразделениеКомпании, ПараметрыСеанса.ПодразделениеКомпании);
	ДилерскийЦентр = ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр;
	НомерДилера = Документы.Renault_Рекламация.ПолучитьСИТ(ДилерскийЦентр);
	СтавкаНДС = ?(ЗначениеЗаполнено(СтавкаНДС), СтавкаНДС, Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	СтавкаНДСПлан = ?(ЗначениеЗаполнено(СтавкаНДСПлан), СтавкаНДСПлан, Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
	

	ЭлектронныйАдрес = Документы.Renault_Рекламация.НайтиEmailСотрудника(Автор);
	
	Решение = Неопределено;
	КлассификацияОтказов = Неопределено;
	СуммаВозмещения = 0;
	КоличествоНормоЧасов = 0;
	ДатаПринятияРешения = Дата("00010101");
	ОписаниеРешения = "";
	
КонецПроцедуры

Процедура ЗаполнитьПоПоступлению(СтруктураПараметров)

	Поступление  = СтруктураПараметров.Поступление;
	СтрокаТовара = Поступление.Товары.Найти(СтруктураПараметров.НомерСтрокиИзПоступления,"НомерСтроки");
	
	ДокументОснование = Поступление;
	ДатаТН = Поступление.ВхДокДата;
	НомерТН = Поступление.ВхДокНомер;
	
	//ЗаполнитьЗначенияСвойств(ЭтотОбъект,Поступление,"Организация,ПодразделениеКомпании,ВалютаДокумента");   DMSREN-1117
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,СтрокаТовара,"Номенклатура,Цена");
	
	НоменклатураПлан = Номенклатура;
	ЦенаПлан = Цена;
	СуммаПлан = СтрокаТовара.СуммаВсего;
	КоличествоПлан = СтрокаТовара.Количество;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Автор) Тогда Автор = ПараметрыСеанса.Пользователь.Сотрудник; КонецЕсли;

	Если ВидРекламации = Перечисления.Renault_РекламацииВиды.Излишек
		 ИЛИ ВидРекламации = Перечисления.Renault_РекламацииВиды.Недостача
		 ИЛИ ВидРекламации = Перечисления.Renault_РекламацииВиды.НевернаяОтгрузка 
		 ИЛИ ВидРекламации = Перечисления.Renault_РекламацииВиды.ОшибкаДокументации тогда
		  
		АктОПоврежденииСТК = Ложь;

	КонецЕсли;

КонецПроцедуры

