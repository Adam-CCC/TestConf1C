&НаСервере
Функция ПолучитьПараметрыДокумента(Ссылка)
	Структура = Новый Структура;
	Попытка
		Структура.Вставить("ВидСклада", Ссылка.СкладКомпании.ВидСклада);
	Исключение	
	КонецПопытки;
	Попытка
		Структура.Вставить("Контрагент", Ссылка.ДокументОснование.Контрагент);		
		Структура.Вставить("ВхДокДата", Ссылка.ДокументОснование.ВхДокДата);
		Структура.Вставить("ВхДокНомер", Ссылка.ДокументОснование.ВхДокНомер);
	Исключение	
	КонецПопытки;

	Если ТипЗнч(Объект.ВладелецТовара) = Тип("СправочникСсылка.Контрагенты") Тогда 
		Структура.Вставить("НаименованиеПолное", Ссылка.ВладелецТовара.НаименованиеПолное);
		Структура.Вставить("ВидКонтрагента", Ссылка.ВладелецТовара.ВидКонтрагента);
	ИначеЕсли ТипЗнч(Объект.ВладелецТовара) = Тип("СправочникСсылка.СкладыКомпании") Тогда 
		Структура.Вставить("Подразделение", Ссылка.ВладелецТовара.Подразделение);
	КонецЕсли;
	Возврат Структура ;	
КонецФункции


// управляет видимостью элементов диалога
//
&НаКлиенте
Процедура УправлениеВидимостью()
	ПараметрыДокумента = ПолучитьПараметрыДокумента(Объект.Ссылка);
	Если ПараметрыДокумента.ВидСклада = ПредопределенноеЗначение("Перечисление.ВидыСкладов.Ячеистый") Тогда
		Элементы.АвтомобилиЯчейка.Видимость = Истина;
	Иначе	
		Элементы.АвтомобилиЯчейка.Видимость = Ложь;
	КонецЕсли;
	// выведем на форму тип склада
	Элементы.НадписьТипСклада.Заголовок = "Тип склада: " + Строка(ПараметрыДокумента.ВидСклада);
	// выведем на форму описание владельца
	ОписаниеВладельца = ПараметрыДокумента.НаименованиеПолное;
	ОписаниеВладельца = ОписаниеВладельца + ?(Не ЗначениеЗаполнено(ПараметрыДокумента.ВидКонтрагента), "", ", " + ПараметрыДокумента.ВидКонтрагента);
	Элементы.НадписьОписаниеВладельца.Заголовок = ОписаниеВладельца;
	// выведем на форму описание документа-основания
	ОписаниеОснования = "";
	Попытка ОписаниеОснования =  ОписаниеОснования + ПолучитьНаименование(ПараметрыДокумента.Контрагент);	Исключение	КонецПопытки;
	Если ОписаниеОснования <> "" Тогда
		Попытка ОписаниеОснования =  ОписаниеОснования + ", вход. документ № " + ПараметрыДокумента.ВхДокНомер + " от " + Формат(ПараметрыДокумента.ВхДокДата,"ДФ=dd.MM.yyyy"); Исключение	КонецПопытки;
	КонецЕсли; 
	Элементы.НадписьОписаниеОснования.Заголовок = ОписаниеОснования;
	//Элементы.ОсновныеДействияФормы.Кнопки.ПечатьВыбор.Кнопки.КартаСклада.Доступность = Объект.СкладКомпании.ВидСклада = Перечисления.ВидыСкладов.Ячеистый;
КонецПроцедуры // УправлениеВидимостью()

// Возвращает нименование элемента из справочника "Номенклатура"
// 
// Параметры:
//  Элемент - Справочник 
// 
// Возвращаемое значение:
//  Строка - представление Номенклатуры, по возможности полное
//
Функция ПолучитьНаименование(Элемент)
	Попытка
		Если НЕ обЗначениеНеЗаполнено(Элемент.НаименованиеПолное) Тогда
			Возврат СокрЛП(Элемент.НаименованиеПолное);
		КонецЕсли; 
	Исключение
	КонецПопытки;
	
	Попытка
		Возврат СокрЛП(Элемент.Наименование);
	Исключение
		Возврат "";
	КонецПопытки; 
КонецФункции // ПолучитьНаименование()

