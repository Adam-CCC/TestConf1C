&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗакрытьФормуВыбораОбщихРеквизитов" Тогда
		ЗаполнитьЗначенияСвойств(Объект,Параметр);
		ОрганизацияПодразделениеИндикация(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОрганизацияПодразделениеИндикация(ЭтаФорма) Экспорт
	
	Если ЭтаФорма <> Неопределено Тогда

		Попытка
			Сп = Новый СписокЗначений;
			Сп.Добавить(Объект.Организация);
			Сп.Добавить(Объект.ПодразделениеКомпании);
			Попытка
				Если Не ЗначениеНеЗаполнено(Объект.Проект) Тогда
					Сп.Добавить(Объект.Проект);
				КонецЕсли;
			Исключение
			КонецПопытки;

			Попытка
				Если Не ЗначениеНеЗаполнено(Объект.Автор) Тогда
					Сп.Добавить(Объект.Автор);
				КонецЕсли;
			Исключение
			КонецПопытки;

			Попытка
				Если Не ЗначениеНеЗаполнено(Объект.Менеджер) Тогда
					Сп.Добавить(Объект.Менеджер);
				КонецЕсли;
			Исключение
			КонецПопытки;
			ОрганизацияПодразделение = Сп;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуру(Знач Объект) 
    Структура = Новый Структура(); /// реквизиты     
    Для каждого Реквизит из Объект.Метаданные().Реквизиты Цикл
        Структура.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
    КонецЦикла; /// таблицы     
    Для каждого ТабличнаяЧасть из Объект.Метаданные().ТабличныеЧасти Цикл
        Структура.Вставить(ТабличнаяЧасть.Имя, Объект[ТабличнаяЧасть.Имя].Выгрузить());
    КонецЦикла;
    
    Возврат Структура;
КонецФункции


