&НаКлиенте
Процедура кнопкиТЧ(Команда)
	ИмяТЧ=ИмяТЧ();
	ИмяТЧОбъекта=?(ИмяТЧ="ЗаявкиНаКредит","РасчетКредита",ИмяТЧ);
	Если ТекущийЭлемент.Имя="кнДобавить" Тогда 
		СтрокаТЧ=Объект["Товары"].Добавить();
	ИначеЕсли ТекущийЭлемент.Имя="кнУдалить" Тогда 
		Если Элементы[ИмяТЧ].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		ТекСтрока=Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока);
		Если ТекСтрока<>Неопределено Тогда Объект[ИмяТЧОбъекта].Удалить(ТекСтрока) КонецЕсли;
	ИначеЕсли ТекущийЭлемент.Имя="кнОбновить" Тогда Элементы[ИмяТЧ].Обновить()

	ИначеЕсли ТекущийЭлемент.Имя="кнОсновной" Тогда
		Если Элементы[ИмяТЧ].ТекущаяСтрока=Неопределено Тогда Возврат КонецЕсли;
		Для Каждого Стр Из Объект[ИмяТЧОбъекта] Цикл 
			Если Стр=Объект[ИмяТЧОбъекта].НайтиПоИдентификатору(Элементы[ИмяТЧ].ТекущаяСтрока) Тогда
				Стр.Основной=НЕ Стр.Основной
			Иначе
				Стр.Основной=Ложь
			КонецЕсли;	
		КонецЦикла;

	КонецЕсли;
	
	//УправлениеЭлементами(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура(); 	
	ПараметрыФормы.Вставить("Ссылка",Объект.Ссылка); 	
	ПараметрыФормы.Вставить("ПодразделениеКомпании",Объект.ПодразделениеКомпании);	
	ПараметрыФормы.Вставить("Организация",Объект.Организация);	
	ПараметрыФормы.Вставить("Автор",Объект.Автор);	
	//ПараметрыФормы.Вставить("Менеджер",Объект.Менеджер);	
	//ПараметрыФормы.Вставить("Проект",Объект.Проект);	
	ПараметрыФормы.Вставить("РегламентированныйУчет",Объект.РегламентированныйУчет);
	Если Не Объект.ДокументОснование = Неопределено	И Не Объект.ДокументОснование.Пустая() Тогда
		ПараметрыФормы.Вставить("ДокументОснование",Объект.ДокументОснование);
	КонецЕсли;
	//ОткрытьФорму("Документ.ПоступлениеТоваров.Форма.ФормаВыборОбщихРеквизитов", ПараметрыФормы, ЭтаФорма);
	
	ОткрытьФорму("ОбщаяФорма.Renault_ВыборОбщихРеквизитов", ПараметрыФормы, ЭтаФорма, Новый УникальныйИдентификатор(),,,,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивДанныхТабличнойЧастиТовары(Права)
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.Права = Права;
	Массив = ПреобразоватьТаблицуЗначенийВМассив(ТекОбъект.Товары.Выгрузить());
	Возврат Массив;
КонецФункции

&НаСервере
Функция ПолучитьТаблицуЗначенийИзТабличнойЧасти(ТабЧасть,Строки = Неопределено,Колонки = "",Права = Неопределено)
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	ТекОбъект.Права = Права;
	ТЗ = ТекОбъект[ТабЧасть].Выгрузить(Строки,Колонки);
	Возврат ТЗ;
КонецФункции

// Функция преобразует ТаблицуЗначений в Массив из структур.
//
&НаСервере
Функция ПреобразоватьТаблицуЗначенийВМассив(ТаблицаЗначений) Экспорт
    
    Массив = Новый Массив;
        
    // Запишем в массив
    Для Каждого Строка Из ТаблицаЗначений Цикл
        
        СтрокаТаблицы = Новый Структура;
        Для Каждого ИмяКолонки Из ТаблицаЗначений.Колонки Цикл
            СтрокаТаблицы.Вставить(ИмяКолонки.Имя, Строка[ИмяКолонки.Имя]);
        КонецЦикла;
        
        Массив.Добавить(СтрокаТаблицы);
        
    КонецЦикла;
    
    Возврат Массив;
    
КонецФункции // ПреобразоватьТаблицуЗначенийВМассив()

// Функция преобразует Массив из структур в ТаблицуЗначений.
//
&НаСервере
Функция ПреобразоватьМассивВТаблицуЗначений(Массив) Экспорт
    
    ТаблицаЗначений = Новый ТаблицаЗначений;
    
    Для Каждого ЭлементМассива Из Массив Цикл
        // Рисуем колонки для таблицы
        Если ТаблицаЗначений.Колонки.Количество() = 0 Тогда
            Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
                ТаблицаЗначений.Колонки.Добавить(ЗначениеСтруктуры.Ключ);
            КонецЦикла;
        КонецЕсли;
        
        // Добавляем данные в таблицу
        НоваяСтрока = ТаблицаЗначений.Добавить();
        Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
            НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
        КонецЦикла;
    КонецЦикла;
    
    Возврат ТаблицаЗначений;
    
КонецФункции // ПреобразоватьМассивВТаблицуЗначений()

&НаКлиенте
Процедура ВывестиЗаголовокСуммаДокумента(ЭтаФорма) Экспорт
	Если ЭтаФорма <> Неопределено Тогда
		// попытаемся пересчитать сумму документа
		
		Попытка 
			ВремСумма = Объект.Товары.Итог("СуммаВсего"); 
		Исключение 
		КонецПопытки;
		
		Попытка
			//Если ВремСумма <> ЭтаФорма.СуммаДокумента Тогда ЭтаФорма.СуммаДокумента = ВремСумма; КонецЕсли;
		Исключение
		КонецПопытки;	
		// обновим надпись валюты и суммы документа
		ТекстВалюта = "";
		Попытка	
			ТекстВалюта = "Валюта: " + СокрЛП(Объект.ВалютаДокумента) + " (" + Формат(Объект.КурсДокумента,"ЧДЦ = 4") + ")";
			Попытка
				Если ВремСумма <> Неопределено Тогда
					ТекстСумма = " ИТОГО: " + Формат(ВремСумма,"ЧДЦ = 2; ЧН = 0,00");
				КонецЕсли; 
			Исключение
			КонецПопытки;
			ЭтаФорма.Элементы.СуммаДокумента.Заголовок = ТекстВалюта + ТекстСумма;
		Исключение 
		КонецПопытки;
	КонецЕсли; 
КонецПроцедуры // ВывестиЗаголовокСуммаДокумента()

// Определяет заполнено ли переданное значение
//
// Параметры: 
//  Значение - Неопределено - Значение, заполнение которого надо проверить
//
// Возвращаемое значение:
//  Булево - Истина, если значение не заполнено, иначе ложь.
//
&НаСервере
Функция ЗначениеНеЗаполнено(Значение) Экспорт

	Результат = Ложь;
	
	Попытка
		Результат = Не ЗначениеЗаполнено(Значение)	
	Исключение // Мутабельные типы (Объекты)
		Результат = Ложь
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // ЗначениеНеЗаполнено()

