//Выполняет проверку налиция табеля на дату
//
// Параметры:
// ВыдаватьПредупреждение	– Булево – Флаг разрешения выдачи предупреждений.
//
// Возвращаемое значение:
// Булево – Результат проверки.
//
Функция НаличиеТабеляЗаЭтотМесяц(ВыдаватьПредупреждение=Истина) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Табель.Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТабельПоУРВ.Ссылка КАК Ссылка,
	|		НАЧАЛОПЕРИОДА(ТабельПоУРВ.ДатаТабеля, ДЕНЬ) КАК ДатаТабеля
	|	ИЗ
	|		Документ.ТабельПоУРВ КАК ТабельПоУРВ
	|	ГДЕ
	|		ТабельПоУРВ.ПодразделениеКомпании = &Подразделение
	|		И ТабельПоУРВ.Ссылка <> &ЭтотДокумент) КАК Табель
	|ГДЕ
	|	Табель.ДатаТабеля = НАЧАЛОПЕРИОДА(&ДатаТабеля, ДЕНЬ)");
	Запрос.УстановитьПараметр("ДатаТабеля", ДатаТабеля);
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеКомпании);
	Запрос.УстановитьПараметр("ЭтотДокумент", ЭтотОбъект.Ссылка);
	ВыборкаДокументов = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДокументов.Следующий() Тогда
		Если ВыдаватьПредупреждение Тогда
			#Если Клиент Тогда
				Предупреждение("За " + ПолучитьПредставлениеДаты(ДатаТабеля) + " уже введен табель """ + Строка(ВыборкаДокументов.Ссылка) + """!", 15);
			#КонецЕсли
		Иначе
			дкСообщитьРезультат("За " + ПолучитьПредставлениеДаты(ДатаТабеля) + " уже введен табель """ + Строка(ВыборкаДокументов.Ссылка) + """!",,ЭтотОбъект);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

