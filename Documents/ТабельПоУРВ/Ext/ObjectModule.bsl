Процедура ОбработкаПроведения(Отказ, Режим)
	Если НЕ дкОбработкаПроведения(ЭтотОбъект, Отказ, Режим) Тогда Возврат; КонецЕсли;
		
	НаборТабельноеВремя = Движения.УРВ_ТабельноеВремя;
	Для Каждого стрСотрудники Из Сотрудники Цикл
		НоваяЗапись              = НаборТабельноеВремя.Добавить();
		НоваяЗапись.Регистратор  = Ссылка;
		НоваяЗапись.Период       = стрСотрудники.Дата;
		НоваяЗапись.Сотрудник    = стрСотрудники.Сотрудник;
		Цех = стрСотрудники.Сотрудник.Цех;
		Если Цех.ЦехДляАнализаЭффиктивности = Справочники.Цеха.ПустаяСсылка() Тогда
			НоваяЗапись.Цех = Цех;
		Иначе
			НоваяЗапись.Цех = Цех.ЦехДляАнализаЭффиктивности;
		КонецЕсли;
		НоваяЗапись.ПодразделениеКомпании = ПодразделениеКомпании;
		НоваяЗапись.ВидИнтервала = Справочники.ВидыИнтервалов.Работа;
		НоваяЗапись.Часы         = стрСотрудники.Продолжительность;
	КонецЦикла;
		
	дкВыводРезультатовОбработки(ЭтотОбъект,Отказ);	
КонецПроцедуры // ОбработкаПроведения

// Возвращает сформированный табличный документ:
Функция ПечатьВедомостьУчетаПереработокПосле19часов(ТабДокумент) Экспорт
	
	ТаблицаСотрудников = Сотрудники.Выгрузить();
  	
	//зададим параметры макета
	ТабДокумент.ПолеСверху = 0;
	ТабДокумент.ПолеСлева  = 0;
	ТабДокумент.ПолеСнизу  = 0;
	ТабДокумент.ПолеСправа = 0;
	ТабДокумент.ТолькоПросмотр = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	Макет = ПолучитьМакет("Макет19");
	
	//Вывод области Договор
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаМесяц = ""+Месяц(ДатаТабеля)+" / "+СтрЗаменить(Год(ДатаТабеля),Символы.НПП,"");
	ОбластьШапка.Параметры.Дата = ЗаМесяц;
	ОбластьШапка.Параметры.Подразделение = "Подразделение компании: " +  ПодразделениеКомпании.Наименование;
	ТекстЗаголовка = "Ведомость переработок после 19 часов по подразделению " + ПодразделениеКомпании.Наименование + " за " + ЗаМесяц;

	ТабДокумент.Вывести(ОбластьШапка);
	ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДокумент.Вывести(ШапкаТаблицы);	
	
	//заполним параметры шапки таблицы для следующего листа
 	ШапкаТаблицы.Параметры.ТекстЗаголовка = ТекстЗаголовка;
	
	ИтоговаяСтрокаТаблицы = Макет.ПолучитьОбласть("ИтогСотр");
	
	СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы");
	ИтогОтработалПосле19 = 0;
	//Бондаренко++ 20251107
	ИтогОтработалПосле20 = 0;
	//Бондаренко-- 20251107
	Ном	= 0;
	Эталон = "";
	Для каждого СтрокаСотрудник Из ТаблицаСотрудников Цикл
		Если СтрокаСотрудник.КонецРаботы = Дата(1,1,1) Тогда
			Продолжить;
		КонецЕсли;
	  //  Если Не обЗначениеНеЗаполнено(Сотрудник) Тогда
	  //     Если СтрокаСотрудник.Сотрудник <> Сотрудник Тогда
	  //      	Продолжить;
	  //   КонецЕсли;
	  //КонецЕсли;
		Если СтрокаСотрудник.Сотрудник <> Эталон Тогда
			Если Эталон <> "" Тогда
				ИтоговаяСтрокаТаблицы.Параметры.Сотрудник = Эталон.Наименование; 
				ИтоговаяСтрокаТаблицы.Параметры.ИтогОтработалПосле19 = Формат(ИтогОтработалПосле19,"ЧЦ=15; ЧДЦ=2");
				//Бондаренко++ 20251107
				ИтоговаяСтрокаТаблицы.Параметры.ИтогОтработалПосле20 = Формат(ИтогОтработалПосле20,"ЧЦ=15; ЧДЦ=2"); 
				//Бондаренко-- 20251107
				ТабДокумент.Вывести(ИтоговаяСтрокаТаблицы);
				ИтогОтработалПосле19 = 0;
				//Бондаренко++ 20251107
				ИтогОтработалПосле20 = 0;
				//Бондаренко-- 20251107
				Ном = 0;
   			КонецЕсли;
 		КонецЕсли;
		Ном = Ном + 1;
		СтрокаТаблицы.Параметры.Ном = Ном;
		СтрокаТаблицы.Параметры.Сотрудник = СтрокаСотрудник.Сотрудник.Наименование;
		СтрокаТаблицы.Параметры.НачалоРаботы = Формат(СтрокаСотрудник.НачалоРаботы,"ДЛФ=T");
		СтрокаТаблицы.Параметры.КонецРаботы  = Формат(СтрокаСотрудник.КонецРаботы,"ДЛФ=T");
		СтрокаТаблицы.Параметры.ДатаДня = Формат(СтрокаСотрудник.Дата,"ДЛФ=D");
		СтрокаТаблицы.Параметры.ВидДня = СтрокаСотрудник.ВидДня;
 		СтрокаТаблицы.Параметры.ОтработалПосле19 = Формат(СтрокаСотрудник.ОтработалПосле19часов,"ЧЦ=15; ЧДЦ=2");
		
		ИтогОтработалПосле19 = ИтогОтработалПосле19 + СтрокаСотрудник.ОтработалПосле19часов;
		
		//Бондаренко++ 20251107
 		СтрокаТаблицы.Параметры.ОтработалПосле20 = Формат(СтрокаСотрудник.ОтработалПосле20часов,"ЧЦ=15; ЧДЦ=2");

		ИтогОтработалПосле20 = ИтогОтработалПосле20 + СтрокаСотрудник.ОтработалПосле20часов;
 		//Бондаренко-- 20251107
		
		ТабДокумент.Вывести(СтрокаТаблицы);
		
		Эталон = СтрокаСотрудник.Сотрудник;
			
	КонецЦикла; 
	
 	ИтоговаяСтрокаТаблицы.Параметры.Сотрудник = Эталон.Наименование; 
	ИтоговаяСтрокаТаблицы.Параметры.ИтогОтработалПосле19 = Формат(ИтогОтработалПосле19,"ЧЦ=15; ЧДЦ=2"); 
	
	//Бондаренко++ 20251107
	ИтоговаяСтрокаТаблицы.Параметры.ИтогОтработалПосле20 = Формат(ИтогОтработалПосле20,"ЧЦ=15; ЧДЦ=2"); 
	//Бондаренко-- 20251107
	
	ТабДокумент.Вывести(ИтоговаяСтрокаТаблицы); 
	
	ТабДокумент.ТолькоПросмотр=Истина;
	ТабДокумент.ФиксацияСверху = 8;
	ТабДокумент.ФиксацияСлева = 1;
  	
	//ТабДокумент.Защита = Истина; // с Защитой не выгружает в Excel и т.д.
	Возврат ТабДокумент;
КонецФункции



