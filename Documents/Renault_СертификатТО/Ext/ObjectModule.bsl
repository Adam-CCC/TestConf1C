Функция ПечатьСертификатаТО(Рекомендации = Неопределено) Экспорт
	
	Макет = ПолучитьМакет("СертификатТО");
	ТабДок = Новый ТабличныйДокумент;
	
	Область = Макет.ПолучитьОбласть("Часть1");
	Область.Параметры.ДатаДокумента = ЭтотОбъект.Дата;
	Область.Параметры.ПробегАвтомобиля = ПробегПриПечати;
	Область.Параметры.Автомобиль = Строка(Автомобиль.Модель) + " " + Строка(Автомобиль.VIN);
	
	ТабДок.Вывести(Область);
	
	Если ЗначениеЗаполнено(Рекомендации) Тогда
		
		Для Каждого Строк из Рекомендации Цикл
			
			Если НЕ ЗначениеЗаполнено(Строк.Работа) Тогда
				
				Продолжить;
				
			КонецЕсли;
		
			Область = Макет.ПолучитьОбласть("СтрокаРекомендации");
			Область.Параметры.Рекомендация = Строка(Строк.Работа);
			ТабДок.Вывести(Область);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("Рекомендации");
	ТабДок.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("Страница2Часть1");
	Область.Параметры.ДатаСледующегоТО = РегистрыСведений.Renault_ВыполнениеТО.ПолучитьПоследнийТО(Автомобиль);	
	Если ЗначениеЗаполнено(Автомобиль.VIN) Тогда //лучше вставить проверку на ВИН И Renault_АвтосервисОбщий.ЭтоАвтомобильРено(Автомобиль) Тогда
	
		ДанныеПродГарантии = Справочники.DMS_КарточкиКлиентов.НайтиДанныеПоVINАвтомобиля(Автомобиль.VIN);
		Если ЗначениеЗаполнено(ДанныеПродГарантии) Тогда
			
			Область.Параметры.ИнформацияОПродленнойГарантии = "Действие контракта до: " + Строка(Формат(ДанныеПродГарантии[0].ДатаОкончанияРасшГарантии,"ДФ=dd.MM.yyyy")) +
			" или до достижения 100 000 км пробега";
			
			
			//"Номер карты: " + Строка(ДанныеПродГарантии[0].НомерКарты)
			//+ "; " + "дата окончания продленной гарантии: " + Строка(Формат(ДанныеПродГарантии[0].ДатаОкончанияРасшГарантии,"ДФ=dd.MM.yyyy"));
			
		Иначе
			
			Область.Параметры.ИнформацияОПродленнойГарантии = "Отсутствует контракт"
			
		КонецЕсли;
		
	Иначе
		
		Область.Параметры.ИнформацияОПродленнойГарантии = "Отсутствует контракт";
		
	КонецЕсли;
	
	ТабДок.Вывести(Область);
	
	Область = Макет.ПолучитьОбласть("ОбластьКонец");
	Область.Параметры.АдрессДЦ = ДилерскийЦентр.ОсновнойАдрес + "; " + Строка(ДилерскийЦентр.ОсновнойТелефон) + "; " + Строка(ДилерскийЦентр.ОсновнойEmail);
	Область.Параметры.ЮрЛицо = ДилерскийЦентр.НаименованиеДляПечати;
	
	ТабДок.Вывести(Область);
	
	Возврат ТабДок;
	
КонецФункции