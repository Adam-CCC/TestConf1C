//Проверяем это код маркировки или нет (Сканер)
Функция ЭтоКодМаркировки(Знач Код) Экспорт
	Разбор = Обработки.ШтрихКоды.Создать().РазобратьСтрокуШтрихкодаGS1(Код);
	Если Разбор.ДанныеШтрихкода.Получить("01") = Неопределено
		ИЛИ Разбор.ДанныеШтрихкода.Получить("21") = Неопределено Тогда 
		Сигнал();
		Сообщить("Это не код маркировки: " + Код + " " + Формат(ТекущаяДата(), "ДФ=ЧЧ:мм:сс"), СтатусСообщения.Важное);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

//Определяет к какой организации и скалду принадлежит номенклатура (Скнер)
Функция ПринадлежностьНоменклатуры(Строка, GTIN, СерийныйНомер) Экспорт
	Структура = Новый Структура("Организация", "Склад");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Состояния.ДокументОснование КАК Документ,
		|	Состояния.ДокументОснование.СкладКомпании КАК Склад,
		|	Состояния.Состояние КАК Состояние,
		|	Состояния.Период КАК Дата
		|ИЗ
		|	РегистрСведений.СостоянияКодовМаркировки КАК Состояния
		|ГДЕ
		|	Состояния.GTIN = &GTIN
		|	И Состояния.СерийныйНомер = &Серийник
		|
		|УПОРЯДОЧИТЬ ПО
		|	Состояния.Период УБЫВ";
	
	Запрос.УстановитьПараметр("GTIN", GTIN);
	Запрос.УстановитьПараметр("Серийник", СерийныйНомер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.Склад <> СкладКомпании Тогда
			Сигнал();	
			Сообщить("Данная номенклатура числится в другом складе, а именно: " + ВыборкаДетальныеЗаписи.Склад);
		КонецЕсли;
       	Структура.Вставить("Организация", ВыборкаДетальныеЗаписи.Документ.Организация);
		Структура.Вставить("Склад", ВыборкаДетальныеЗаписи.Склад);
		Возврат Структура;
	КонецЦикла;
КонецФункции

//Добавляет элемент в таб часть (Сканер)
Процедура ЗаполнениеТабЧасти(Строка, Результаты, GTIN, Серийник) Экспорт 
	// 1. Последний статус кода
	Выборка = Результаты[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Строка.Статус = Выборка.Состояние;
		Строка.Номенклатура = Выборка.Номенклатура;
	КонецЕсли;
	
	// 2. Есть ли внутренний код
	Выборка = Результаты[1].Выбрать();
	Если Выборка.Следующий() Тогда
		Строка.ВнутренняяМаркировка = Истина;
		Строка.ВнутреннийКодМаркировки = Выборка.ВнутреннийКод;
		Строка.Номенклатура = Выборка.Номенклатура;
	КонецЕсли;
	
	// 3. Не нашли в регистрах - ищем номенклатуру по штрихкоду
	Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		Выборка = Результаты[2].Выбрать();
		Если Выборка.Следующий() Тогда
			Строка.Номенклатура = Выборка.Номенклатура;
		КонецЕсли;
	КонецЕсли;
	Строка.ЕдиницаИзмерения = Строка.Номенклатура.ОсновнаяЕдиницаИзмерения;
	
	Если НЕ ЗначениеЗаполнено(Строка.Статус) И НЕ Строка.ВнутренняяМаркировка Тогда
		Сигнал();
		Сообщить("Код не найден в регистрах, мы его не принимали: " + Строка.КодМаркировки, СтатусСообщения.Важное);
		Возврат;	
	КонецЕсли;
	
	Принадлежность = ПринадлежностьНоменклатуры(Строка, GTIN, Серийник);
	Если ЗначениеЗаполнено(Принадлежность) Тогда
		Строка.Склад = Принадлежность.Склад;
		Строка.Организация = Принадлежность.Организация;
	Иначе
		Сообщить("Маркировка номенклатуры " + Строка.Номенклатура + " не внесена в регистр 'Состояние кодов маркировок'", СтатусСообщения.Внимание);
	КонецЕсли;	
КонецПроцедуры

//Получает данные по маркировке (Сканер)
Функция ЗаполнитьСтрокуПоКоду(Строка) Экспорт	
	Строка.КодМаркировки = СокрЛП(Строка.КодМаркировки); // убираем пробелы и CR сканера
	Строка.Статус = Перечисления.СостоянияКодовМаркировки.ПустаяСсылка();
	Строка.ВнутренняяМаркировка = Ложь;
	Строка.ВнутреннийКодМаркировки = "";
	//Структура = Новый Структура();
	
	Если НЕ ЭтоКодМаркировки(Строка.КодМаркировки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Копия нужна: парсер меняет переданную ему переменную
	Копия = Строка.КодМаркировки;
	Разбор = Обработки.ШтрихКоды.Создать().РазобратьСтрокуШтрихкодаGS1(Копия);
	
	GTIN        = Разбор.ДанныеШтрихкода["01"].Значение;
	Серийник    = Разбор.ДанныеШтрихкода["21"].Значение;
	КороткийКод = "01" + GTIN + "21" + Серийник;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Состояния.Состояние КАК Состояние,
	|	Состояния.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.СостоянияКодовМаркировки КАК Состояния
	|ГДЕ
	|	Состояния.GTIN = &GTIN
	|	И Состояния.СерийныйНомер = &Серийник
	|УПОРЯДОЧИТЬ ПО
	|	Состояния.Период УБЫВ
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Внутренние.ВнутреннийКодМаркировки КАК ВнутреннийКод,
	|	Внутренние.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ВнутренниеКодыМаркировок КАК Внутренние
	|ГДЕ
	|	(Внутренние.ВнутреннийКодМаркировки = &Внутренний
	|		ИЛИ Внутренние.ВнешнийКодМаркировки = &КороткийКод)
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Штрихкоды.Объект КАК Номенклатура
	|ИЗ
	|	РегистрСведений.ШтрихКоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.ШтрихКод = &EAN
	|	И Штрихкоды.Объект ССЫЛКА Справочник.Номенклатура";
	Запрос.УстановитьПараметр("GTIN", GTIN);
	Запрос.УстановитьПараметр("Серийник", Серийник);
	Запрос.УстановитьПараметр("Внутренний", "!SM!" + КороткийКод);
	Запрос.УстановитьПараметр("КороткийКод", КороткийКод);
	Запрос.УстановитьПараметр("EAN", Сред(GTIN, 2));
	Результаты = Запрос.ВыполнитьПакет(); 
	
	ЗаполнениеТабЧасти(Строка, Результаты, GTIN, Серийник);
	
	Возврат Результаты;
КонецФункции