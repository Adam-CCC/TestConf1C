Процедура ОбработкаЗаполнения(Основание)
	Дата  = ТекущаяДата();
	Автор = ПараметрыСеанса.Пользователь;
	СкладКомпании         = обПраво("ОсновнойСкладКомпании");
	Организация           = ПараметрыСеанса.Организация;
	ПодразделениеКомпании = ПараметрыСеанса.ПодразделениеКомпании;
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Дата = ТекущаяДата();
КонецПроцедуры

//===================================================================
//					Заполнение по номенклатуре (в переданную таблицу)
//===================================================================

Процедура ЗаполнитьПоНоменклатуре(Таблица) Экспорт
	
	Если НЕ дкЭтоМаркируемаяНоменклатура(Номенклатура) Тогда
		Сообщить("Номенклатура не маркируемая: " + Номенклатура, СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	Таблица.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(,
	|		Номенклатура = &Номенклатура И СкладКомпании = &Склад) КАК Остатки
	|;
	|ВЫБРАТЬ
	|	Состояния.GTIN КАК GTIN,
	|	Состояния.СерийныйНомер КАК СерийныйНомер,
	|	МАКСИМУМ(Состояния.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_Последние
	|ИЗ
	|	РегистрСведений.СостоянияКодовМаркировки КАК Состояния
	|ГДЕ
	|	Состояния.Номенклатура = &Номенклатура
	|СГРУППИРОВАТЬ ПО
	|	Состояния.GTIN,
	|	Состояния.СерийныйНомер
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Состояния.GTIN КАК GTIN,
	|	Состояния.СерийныйНомер КАК СерийныйНомер,
	|	Состояния.КодМаркировки КАК КодМаркировки,
	|	Состояния.Состояние КАК Состояние,
	|	Состояния.Организация КАК Организация,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Состояния.ДокументОснование.СкладКомпании КАК Справочник.СкладыКомпании),
	|		ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)) КАК Склад
	|ИЗ
	|	ВТ_Последние КАК Последние
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияКодовМаркировки КАК Состояния
	|		ПО Состояния.GTIN = Последние.GTIN
	|			И Состояния.СерийныйНомер = Последние.СерийныйНомер
	|			И Состояния.Период = Последние.Период
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВнутренниеКодыМаркировок КАК Внутренние
	|		ПО Внутренние.GTIN = Последние.GTIN
	|			И Внутренние.СерийныйНомер = Последние.СерийныйНомер
	|ГДЕ
	|	Состояния.ДокументОснование.СкладКомпании = &Склад
	|	И Внутренние.ВнутреннийКодМаркировки ЕСТЬ NULL
	|	И НЕ Состояния.Состояние В (&Выбывшие)
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Внутренние.ВнутреннийКодМаркировки КАК Код,
	|	Состояния.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ВнутренниеКодыМаркировок КАК Внутренние
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Последние КАК Последние
	|		ПО Последние.GTIN = Внутренние.GTIN
	|			И Последние.СерийныйНомер = Внутренние.СерийныйНомер
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияКодовМаркировки КАК Состояния
	|		ПО Состояния.GTIN = Последние.GTIN
	|			И Состояния.СерийныйНомер = Последние.СерийныйНомер
	|			И Состояния.Период = Последние.Период
	|ГДЕ
	|	Внутренние.Номенклатура = &Номенклатура
	|	И Состояния.ДокументОснование.СкладКомпании = &Склад
	|	И НЕ Состояния.Состояние В (&Выбывшие)";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", СкладКомпании);
	Запрос.УстановитьПараметр("Выбывшие", ВыбывшиеСтатусы());
	Результаты = Запрос.ВыполнитьПакет();
	
	ВсегоНаСкладе = Цел(Результаты[0].Выгрузить()[0].Количество);
	
	//++Дадов 20261111
	Если ВсегоНаСкладе <= 0 И Результаты[2].Пустой() И Результаты[3].Пустой() Тогда
		Сообщить("Товара «" + Номенклатура + "» нет на складе «" + СкладКомпании + "»", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	//--Дадов 20261111
	
	// 1. Внешние коды на этом складе
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		КИ = "01" + СокрЛП(Выборка.GTIN) + "21" + СокрЛП(Выборка.СерийныйНомер);
		ДобавитьЕдиницу(Таблица, Выборка.КодМаркировки, КИ, Выборка.Состояние, Ложь, Выборка.Организация, Выборка.Склад);
	КонецЦикла;
	
	// 2. Внутренние коды !SM! на этом складе
	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Выборка.Код);
		ДобавитьЕдиницу(Таблица, Код, Код, Выборка.Состояние, Истина, СкладКомпании.Организация, СкладКомпании);
	КонецЦикла;
	
	// 3. Остальные единицы - без кода
	ПустойСтатус = Перечисления.СостоянияКодовМаркировки.ПустаяСсылка();
	БезКода = ВсегоНаСкладе - Таблица.Количество();
	Для Н = 1 По БезКода Цикл
		ДобавитьЕдиницу(Таблица, "", "", ПустойСтатус, Ложь, СкладКомпании.Организация, СкладКомпании);
	КонецЦикла;
	
	Если БезКода < 0 Тогда
		Сообщить("Кодов найдено больше, чем остаток на складе (" + ВсегоНаСкладе + "). Проверьте склад и движения.",
			СтатусСообщения.Внимание);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЕдиницу(Таблица, Код, КИ, Статус, Внутренний, Организация, Склад)
	Строка = Таблица.Добавить();
	Строка.Номенклатура            = Номенклатура;
	Строка.ЕдиницаИзмерения        = Номенклатура.ОсновнаяЕдиницаИзмерения;
	Строка.КодМаркировки           = Код;
	Строка.КИ                      = КИ;
	Строка.Статус                  = Статус;
	Строка.ВнутренняяМаркировка    = Внутренний;
	Строка.ВнутреннийКодМаркировки = ?(Внутренний, Код, "");
	Строка.Организация             = Организация;
	Строка.Склад                   = Склад;
КонецПроцедуры

// Статусы, при которых товар ушёл со склада.
// «Использован для собственных нужд» не входит: это наши внутренние коды
// и внешние, которые ещё надо сделать внутренними
Функция ВыбывшиеСтатусы()
	Выбывшие = Новый Массив;
	Для Каждого Значение Из Метаданные.Перечисления.СостоянияКодовМаркировки.ЗначенияПеречисления Цикл
		Имя = Значение.Имя;
		Если (СтрНачинаетсяС(Имя, "ВыведенИзОборота") И Имя <> "ВыведенИзОборотаИспользованДляСобственныхНуждПредприятия")
			ИЛИ СтрНайти(",Экспортирован,Утилизирован,Списан,ПередачаДругомуСобственнику,", "," + Имя + ",") > 0 Тогда
			Выбывшие.Добавить(Перечисления.СостоянияКодовМаркировки[Имя]);
		КонецЕсли;
	КонецЦикла;
	Возврат Выбывшие;
КонецФункции

//===================================================================
//					Кнопки: перечитать строку после создания кода
//===================================================================

Процедура ЗаполнитьСтрокуПоКоду(Строка) Экспорт
	Копия = СокрЛП(Строка.КодМаркировки); // парсер меняет переменную
	Разбор = Обработки.ШтрихКоды.Создать().РазобратьСтрокуШтрихкодаGS1(Копия);
	Если Разбор.ДанныеШтрихкода.Получить("01") = Неопределено
		ИЛИ Разбор.ДанныеШтрихкода.Получить("21") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КороткийКод = "01" + Разбор.ДанныеШтрихкода["01"].Значение + "21" + Разбор.ДанныеШтрихкода["21"].Значение;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Внутренние.ВнутреннийКодМаркировки КАК ВнутреннийКод
	|ИЗ
	|	РегистрСведений.ВнутренниеКодыМаркировок КАК Внутренние
	|ГДЕ
	|	(Внутренние.ВнутреннийКодМаркировки = &Внутренний
	|		ИЛИ Внутренние.ВнешнийКодМаркировки = &КороткийКод)");
	Запрос.УстановитьПараметр("Внутренний", "!SM!" + КороткийКод);
	Запрос.УстановитьПараметр("КороткийКод", КороткийКод);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Строка.ВнутренняяМаркировка    = Истина;
		Строка.ВнутреннийКодМаркировки = СокрЛП(Выборка.ВнутреннийКод);
		Строка.КИ                      = Строка.ВнутреннийКодМаркировки;
	Иначе
		Строка.КИ = КороткийКод;
	КонецЕсли;
КонецПроцедуры

//===================================================================
//					Печать: полный код с криптохвостом
//===================================================================

Функция ПолныйКодМаркировки(КИ) Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Состояния.ДокументОснование КАК Документ
	|ИЗ
	|	РегистрСведений.СостоянияКодовМаркировки КАК Состояния
	|ГДЕ
	|	Состояния.GTIN = &GTIN
	|	И Состояния.СерийныйНомер = &Серийник");
	Запрос.УстановитьПараметр("GTIN", Сред(КИ, 3, 14));
	Запрос.УстановитьПараметр("Серийник", Сред(КИ, 19));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Документ) Тогда Продолжить; КонецЕсли;
		ТЧ = Выборка.Документ.Метаданные().ТабличныеЧасти.Найти("КодыМаркировки");
		Если ТЧ = Неопределено ИЛИ ТЧ.Реквизиты.Найти("КодМаркировкиBase64") = Неопределено Тогда Продолжить; КонецЕсли;
		Для Каждого СтрокаКода Из Выборка.Документ.КодыМаркировки Цикл
			Попытка
				Код = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(СтрокаКода.КодМаркировкиBase64));
			Исключение
				Продолжить;
			КонецПопытки;
			Если ДанныеРазбора(Код) = КИ Тогда
				Возврат Код;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ДанныеРазбора(Знач Код)
	Разбор = Обработки.ШтрихКоды.Создать().РазобратьСтрокуШтрихкодаGS1(Код);
	Если Разбор.ДанныеШтрихкода.Получить("01") = Неопределено
		ИЛИ Разбор.ДанныеШтрихкода.Получить("21") = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат "01" + Разбор.ДанныеШтрихкода["01"].Значение + "21" + Разбор.ДанныеШтрихкода["21"].Значение;
КонецФункции

//===================================================================
//					Запись и проведение
//===================================================================

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка(); // номенклатуру в документе не храним
	
	// Статус новых внутренних кодов: ставим при проведении, снимаем при отмене
	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;
	Статус = ?(РежимЗаписи = РежимЗаписиДокумента.Проведение,
		Перечисления.СостоянияКодовМаркировки.ВыведенИзОборотаИспользованДляСобственныхНуждПредприятия,
		Перечисления.СостоянияКодовМаркировки.ПустаяСсылка());
	Новые = НовыеВнутренниеКоды();
	Для Каждого Строка Из Маркировки Цикл
		Если Новые.Найти(СокрЛП(Строка.ВнутреннийКодМаркировки), "Код") <> Неопределено Тогда
			Строка.Статус = Статус;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Набор = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументОснование.Установить(Ссылка);
	Для Каждого Строка Из НовыеВнутренниеКоды() Цикл
		Запись = Набор.Добавить();
		Запись.Период            = Дата;
		Запись.ДокументОснование = Ссылка;
		Запись.Организация       = СкладКомпании.Организация;
		Запись.Номенклатура      = Строка.Номенклатура;
		Запись.GTIN              = Строка.GTIN;
		Запись.СерийныйНомер     = Строка.СерийныйНомер;
		Запись.КодМаркировки     = Строка.Код;
		Запись.Состояние         = Перечисления.СостоянияКодовМаркировки.ВыведенИзОборотаИспользованДляСобственныхНуждПредприятия;
	КонецЦикла;
	Набор.Записать();
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Набор = РегистрыСведений.СостоянияКодовМаркировки.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументОснование.Установить(Ссылка);
	Набор.Записать();
КонецПроцедуры

// Внутренние коды документа, у которых нет истории в регистре от ДРУГИХ документов
// (так пропускаем коды «из внешнего» и коды, записанные ранее)
Функция НовыеВнутренниеКоды() Экспорт
	Коды = Новый ТаблицаЗначений;
	Коды.Колонки.Добавить("Код",           Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Коды.Колонки.Добавить("GTIN",          Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(14)));
	Коды.Колонки.Добавить("СерийныйНомер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Коды.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	
	Для Каждого Строка Из Маркировки Цикл
		Код = СокрЛП(Строка.ВнутреннийКодМаркировки);
		Если СтрНачинаетсяС(Код, "!SM!") И Коды.Найти(Код, "Код") = Неопределено Тогда
			Новая = Коды.Добавить();
			Новая.Код           = Код;
			Новая.GTIN          = Сред(Код, 7, 14);
			Новая.СерийныйНомер = Сред(Код, 23);
			Новая.Номенклатура  = Строка.Номенклатура;
		КонецЕсли;
	КонецЦикла;
	Если Коды.Количество() = 0 Тогда
		Возврат Коды;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Коды.Код КАК Код,
	|	Коды.GTIN КАК GTIN,
	|	Коды.СерийныйНомер КАК СерийныйНомер
	|ПОМЕСТИТЬ ВТ_Коды
	|ИЗ
	|	&Коды КАК Коды
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Коды.Код КАК Код
	|ИЗ
	|	ВТ_Коды КАК ВТ_Коды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияКодовМаркировки КАК Состояния
	|		ПО Состояния.GTIN = ВТ_Коды.GTIN
	|			И Состояния.СерийныйНомер = ВТ_Коды.СерийныйНомер
	|ГДЕ
	|	Состояния.ДокументОснование <> &Ссылка";
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Коды.Удалить(Коды.Найти(Выборка.Код, "Код"));
	КонецЦикла;
	Возврат Коды;
КонецФункции