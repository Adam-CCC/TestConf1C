Функция НайтиСоздатьДоговор(Владелец,Организация,Подразделение,ВидДоговора)
  	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыВзаиморасчетов.Ссылка,
		|	ДоговорыВзаиморасчетов.ВидДоговора,
		|	ДоговорыВзаиморасчетов.Организация
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
		|ГДЕ
		|	ДоговорыВзаиморасчетов.Владелец = &Владелец
		|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
		|	И ДоговорыВзаиморасчетов.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;

	НовДоговор = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	НовДоговор.ВидДоговора = ВидДоговора;
	НовДоговор.Автор = ПараметрыСеанса.Пользователь; 
	НовДоговор.Организация = Организация;
	НовДоговор.Подразделение = Подразделение;
	НовДоговор.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	Новдоговор.ДатаНачала = ЭтотОбъект.Дата;
	НовДоговор.СформироватьНаименование(); 
	
	Попытка
	    НовДоговор.Записать();
 	Исключение
		//	
	КонецПопытки;
	
	Возврат НовДоговор.Ссылка;
 
КонецФункции // НайтиСоздатьДоговор(Владелец,Организация,Подразделение,ВидДоговора)
  
Функция СМГ_НайтиСоздатьПеремещенияПоТоварам(СкладКомпании,Авто,ТаблицаТоваров)
	ФлОтказ = Ложь; 	
	Отбор = Новый Структура();
	Отбор.Вставить("СкладКомпании",СкладКомпании);	
	Отбор.Вставить("Автомобиль",Авто);	
	МассивСтрокТоваров = ТаблицаТоваров.НайтиСтроки(Отбор);
	Если МассивСтрокТоваров.Количество() > 0 Тогда
		#Если Клиент Тогда
		Сообщить("Найдено строк товаров для перемещений в количестве: "+МассивСтрокТоваров.Количество()+" по складу: "+СкладКомпании+" по автомобилю: "+Авто);	
		#КонецЕсли
		ФлОтказ = СМГ_НайтиСоздатьперемещениеТоваров(СкладКомпании,Авто,МассивСтрокТоваров);
 	КонецЕсли;
 	Возврат ФлОтказ;
КонецФункции //СМГ_НайтиСоздатьПеремещенияПоТоварам(СкладКомпании,Авто,ТаблицаТоваров)

Функция СМГ_НайтиСоздатьЗаказНарядыПоРаботам(ТаблицаРабот)
	
	ФлОтказ = Ложь;
	
	СписокИсходныхЗН = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаРабот Цикл
	    Если СписокИсходныхЗН.НайтиПоЗначению(Стр.Регистратор) <> Неопределено Тогда
			Продолжить;		
 		КонецЕсли;
		СписокИсходныхЗН.Добавить(Стр.Регистратор);			
 	КонецЦикла;
  	
	Если СписокИсходныхЗН.Количество() > 0 Тогда
		Для каждого ТекИсхЗН Из СписокИсходныхЗН Цикл
 			ФлОтказ = СМГ_НайтиСоздатьЗаказНарядыСубподряд(ТекИсхЗН.Значение,ТаблицаРабот);	
 	  	КонецЦикла;
	КонецЕсли;
 	
	Возврат ФлОтказ;
	
КонецФункции // СМГ_НайтиСоздатьЗНпоРаботам()

Функция СМГ_НайтиСоздатьЗаказНарядыСубподряд(ТекРегистратор,ТаблицаРабот)
	
	ФлОтказ = Ложь; 	
	
	Отбор = Новый Структура();
	Отбор.Вставить("Регистратор",ТекРегистратор);	
	МассивСтрокРабот = ТаблицаРабот.НайтиСтроки(Отбор);
	
	Если МассивСтрокРабот.Количество() > 0 Тогда
		#Если Клиент Тогда
			Сообщить("Найдено строк работ в количестве: "+МассивСтрокРабот.Количество()+" по регистратору: "+ТекРегистратор);	
		#КонецЕсли
		//Бондаренко++ 20220305
		СписокПодразделенийСубподрядчиков = Новый СписокЗначений;
		Для каждого Эл Из МассивСтрокРабот Цикл
			Если СписокПодразделенийСубподрядчиков.НайтиПоЗначению(Эл.ПодразделениеКомпании)<>Неопределено Тогда
				Продолжить;		
			КонецЕсли;		                                                                
			СписокПодразделенийСубподрядчиков.Добавить(Эл.ПодразделениеКомпании);
 		КонецЦикла;
		Для каждого ТекПодрСубподрядчика Из СписокПодразделенийСубподрядчиков Цикл
			ФлОтказ = СМГ_НайтиСоздатьОдинЗаказНаряд(ТекРегистратор,МассивСтрокРабот,ТекПодрСубподрядчика.Значение);
 		КонецЦикла;		
 		//Бондаренко++ 20220305
	КонецЕсли;
	
	Возврат ФлОтказ;
	
КонецФункции //СМГ_НайтиСоздатьЗНпоРаботам(Орг,ТаблицаРабот)  

Функция СМГ_НайтиСоздатьОдинЗаказНаряд(ТекРегистратор,МассивСтрокРабот,ПодразделениеСубподрядчика)
	
	ФлОтказ = Ложь; 
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка КАК Заказ_Наряд,
		|	ЗаказНаряд.ДокументОснование,
		|	ЗаказНаряд.ВидРемонта,
		|	ЗаказНаряд.ПодразделениеКомпании
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|ГДЕ
		|	ЗаказНаряд.ДокументОснование = &ДокументОснование
		|	И ЗаказНаряд.ВидРемонта = ЗНАЧЕНИЕ(Справочник.ВидыРемонта.ДополнительноеОборудованиеСубподряд)
		|	И ЗаказНаряд.ПодразделениеКомпании = &ПодразделениеКомпании";
	
 	Запрос.УстановитьПараметр("ДокументОснование", ТекРегистратор);
	//Бондаренко++ 20220405
	Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеСубподрядчика);
	//Бондаренко-- 20220405
 	
	ДокЗН = Запрос.Выполнить().Выгрузить();
	//Работы.ВыбратьСтроку();
	
	ФлНовый = Ложь;
	Если ДокЗН.Количество() = 0 Тогда
	    ЗН = Документы.ЗаказНаряд.СоздатьДокумент();
  		ФлНовый = Истина;
	Иначе
 	    ЗН = ДокЗН[0].Заказ_Наряд.ПолучитьОбъект();
 	КонецЕсли;                              
	
	//Бондаренко++ 20220412
	Если НЕ ЗН.РегламентированныйУчет Тогда
		ЗН.РегламентированныйУчет=Истина;
	КонецЕсли;             
	//Бондаренко-- 20220412
 	
	Если ФлНовый Тогда                              
				
   		ЗН.Дата = ЭтотОбъект.Дата;
 		ЗН.ВидРемонта = Справочники.ВидыРемонта.ДополнительноеОборудованиеСубподряд;
		ЗН.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка;
		ЗН.Автор = ПараметрыСеанса.Пользователь;
		ЗН.ДокументОснование = ТекРегистратор.Ссылка; 
		ЗН.Контрагент = ТекРегистратор.Организация.КонтрагентОрганизации;
		//Бондаренко++ 20220305
		ЗН.Организация = ПодразделениеСубподрядчика.Организация;
		ЗН.ПодразделениеКомпании = ПодразделениеСубподрядчика; 
		ЗН.УстановитьНовыйНомер();
		//Бондаренко-- 20220305
 		ЗН.ДоговорВзаиморасчетов =  СМГ_НайтиСоздатьДоговорСубподряд(ЗН.Контрагент,ЗН.Организация,ЗН.ПодразделениеКомпании);  
		ЗН.Заказчик = ЗН.Контрагент;
 		ЗН.Автомобиль = ТекРегистратор.Автомобиль;
		
		//Бондаренко++ 20241102
 		Попытка
			ЗН.Владелец = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(ЗН.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
		Исключение
			ЗН.Владелец = ЗН.Контрагент;
		КонецПопытки;
		//Бондаренко-- 20241102
 		
		ЗН.Цех = Справочники.Цеха.НайтиПоРеквизиту("Подразделение",ЗН.ПодразделениеКомпании);
		
		//Бондаренко++ 20211223
		Если НЕ обЗначениеНеЗаполнено(ЗН.ДоговорВзаиморасчетов.ТипЦенПродажи) Тогда
			ЗН.ТипЦен = ЗН.ДоговорВзаиморасчетов.ТипЦенПродажи;
		Иначе			
			ЗН.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;		
		КонецЕсли;
 		Если НЕ обЗначениеНеЗаполнено(ЗН.ДоговорВзаиморасчетов.ТипЦенРабот) Тогда
			ЗН.ТипЦенРабот = ЗН.ДоговорВзаиморасчетов.ТипЦенРабот;
		Иначе			
			ЗН.ТипЦенРабот = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;		
		КонецЕсли;    
 		//Бондаренко-- 20211223
 		 
		ЗН.ХозОперация = Справочники.ХозОперации.ЗаказНаряд;
		ЗН.ВалютаДокумента = ЗН.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов;
		ЗН.КурсДокумента = 1;
		ЗН.ДатаМашинозаезда = ЗН.Дата;
		ЗН.ДатаСоздания = ЗН.Дата;
		ЗН.ДатаНачала = ЗН.Дата;
		ЗН.ДатаОкончания = ЗН.Дата;
		ЗН.ПлановаяДатаВыдачи = ЗН.Дата;
		ЗН.ДатаЗакрытия = ЗН.Дата; 
		ЗН.ИсточникИнформации = Справочники.ИсточникиИнформации.ПустаяСсылка();
		ЗН.Комментарий = "Создан автоматически "+ТекущаяДата()+" пользователем "+ПараметрыСеанса.Пользователь+", при проведении <"+ЭтотОбъект.Ссылка+">.";
   	
	КонецЕсли; 
	
	//Бондаренко++ 20220308
 	Если ЗН.Дата <> ТекРегистратор.Дата Тогда
		
		ЗН.Дата = ТекРегистратор.Дата; 
		ЗН.ДатаМашинозаезда = ТекРегистратор.Дата;
		ЗН.ДатаСоздания = ТекРегистратор.Дата;
		ЗН.ДатаНачала = ТекРегистратор.Дата;
		ЗН.ДатаОкончания = ТекРегистратор.Дата;
		ЗН.ПлановаяДатаВыдачи = ТекРегистратор.Дата;
		ЗН.ДатаЗакрытия = ТекРегистратор.Дата; 
		
		Если Год(ЗН.Дата) <> Год(ТекРегистратор.Дата) Тогда
			ЗН.УстановитьНовыйНомер();		
 		КонецЕсли;
	КонецЕсли;             
	//Бондаренко-- 20220308
 	
	ЗН.ДоговорВзаиморасчетов =  СМГ_НайтиСоздатьДоговорСубподряд(ЗН.Контрагент,ЗН.Организация,ЗН.ПодразделениеКомпании);  

	//ФормаЗН = ЗН.ПолучитьФорму("ФормаДокумента");
	//Если Не ФормаЗН.Открыта() Тогда
	//	ФормаЗН.ОткрытьМодально();		
	// КонецЕсли;
	
	Если ЗН.Работы.Количество() > 0 Тогда
		ЗН.Работы.Очистить();	
	КонецЕсли;  
	
	Если ЗН.Исполнители.Количество() > 0 Тогда
	    ЗН.Исполнители.Очистить();
 	КонецЕсли;
 	
	Для каждого СтрРабот Из МассивСтрокРабот Цикл  
		
		//Бондаренко++ 20220305
		Если СтрРабот.ПодразделениеКомпании <> ПодразделениеСубподрядчика Тогда
		    Продолжить;
		КонецЕсли;             
		//Бондаренко-- 20220305
		
		НоваяСтрокаРабот = ЗН.Работы.Добавить();
		НоваяСтрокаРабот.ИдентификаторРаботы = Новый УникальныйИдентификатор;
 		НоваяСтрокаРабот.Работа = СтрРабот.Работа;
		НоваяСтрокаРабот.Количество = 1;		
		НоваяСтрокаРабот.Коэффициент = СтрРабот.КоличествоРасход;
		НоваяСтрокаРабот.Сумма = СтрРабот.СуммаУпрРасход;
		НоваяСтрокаРабот.СуммаВсего = СтрРабот.СуммаУпрРасход;
		НоваяСтрокаРабот.СуммаНДС = Окр(СтрРабот.СуммаУпрРасход/6,2);
		Если ЗН.Организация.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая Тогда
			НоваяСтрокаРабот.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
 		Иначе
			НоваяСтрокаРабот.СтавкаНДС = Справочники.СтавкиНДС.БезНДС;		
		КонецЕсли;
 		НоваяСтрокаРабот.Нормочас = Справочники.Нормочасы.Рубль;
		НоваяСтрокаРабот.Цена = ?(СтрРабот.КоличествоРасход>0,СтрРабот.СуммаУпрРасход/СтрРабот.КоличествоРасход,1);
		
		НоваяСтрокаИсполнители = ЗН.Исполнители.Добавить();
		НоваяСтрокаИсполнители.ИдентификаторРаботы = НоваяСтрокаРабот.ИдентификаторРаботы;
 		НоваяСтрокаИсполнители.Исполнитель = ?(обЗначениеНеЗаполнено(ЗН.ПодразделениеКомпании.РуководительСервиса.Сотрудник),ПараметрыСеанса.Пользователь.Сотрудник,ЗН.ПодразделениеКомпании.РуководительСервиса.Сотрудник);
		НоваяСтрокаИсполнители.Цех = ЗН.Цех;
		НоваяСтрокаИсполнители.Процент = 100;
		НоваяСтрокаИсполнители.Блокировать = Истина;
 		
  	КонецЦикла;
	
	Если ФлНовый Или ЗН.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка Тогда
		Попытка
			ЗН.Записать(РежимЗаписиДокумента.Запись);
		Исключение  
			ФлОтказ = Истина;		
		КонецПопытки;                              
	КонецЕсли;
	
	Если ЗН.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Заявка И НЕ ФлОтказ Тогда
		ЗН.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Выполнен;	
		ЗН.ДатаМашинозаезда = ЗН.Дата;
		ЗН.ДатаСоздания = ЗН.Дата;
		ЗН.ДатаНачала = ЗН.Дата;
		ЗН.ДатаОкончания = ЗН.Дата;
		ЗН.ПлановаяДатаВыдачи = ЗН.Дата;
		ЗН.ДатаЗакрытия = ЗН.Дата;
		ЗН.Рекомендации = "---";
		ЗН.ПричинаОбращения = "---";
		Сообщить("Документ " +ЗН+" записывается с договором "+ЗН.ДоговорВзаиморасчетов);

		//Бондаренко++ 20211227 ==================================
	  //Форма = ЗН.ПолучитьФорму("ФормаДокумента");
	  //  Если Не Форма.Открыта() Тогда
	  //      Форма.ОткрытьМодально(); 
	  //	КонецЕсли;
		//Бондаренко-- 20211227 ==================================
		
     	Попытка
			ЗН.Записать(РежимЗаписиДокумента.Проведение);
			Сообщить("Документ " +ЗН+" записан с договором "+ЗН.ДоговорВзаиморасчетов);
		Исключение  
			ФлОтказ = Истина;		
		КонецПопытки;
 	Конецесли;
  	
	Если ЗН.Состояние <> Справочники.ВидыСостоянийЗаказНарядов.Заявка И НЕ ФлОтказ Тогда
		ЗН.Состояние = Справочники.ВидыСостоянийЗаказНарядов.Закрыт;		           
   		Попытка
			ЗН.Записать(РежимЗаписиДокумента.Проведение);                            
 		Исключение  
			ФлОтказ = Истина;		
		КонецПопытки;                              
	КонецЕсли;
	
	Если Не ФлОтказ Тогда 
		//Бондаренко++ 20220226
 		ФлОтказ = СМГ_НайтиСоздатьСФвыданный(ЗН);
		//Бондаренко-- 20220226
 	КонецЕсли; 

 	Если Не ФлОтказ Тогда
		ФлОтказ = СМГ_НайтиСоздатьАктОказанияУслугСубподряд(ТекРегистратор,ЗН); 
	КонецЕсли; 
   	
	Возврат ФлОтказ;
КонецФункции // СМГ_НайтиСоздатьЗаказНаряд(ТекРегистратор,МассивСтрокРабот)

Функция СМГ_НайтиСоздатьперемещениеТоваров(СкладКомпании,Авто,МассивСтрокТоваров)
	
	ФлОтказ = Ложь;
	
	#Если Клиент Тогда
	Сообщить("Формируется перемещение со склада: "+СкладКомпании);
	#КонецЕсли  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеТоваров.Ссылка КАК Перемещение_Товаров,
		|	ПеремещениеТоваров.ДокументОснование,
		|	ПеремещениеТоваров.СкладКомпании
		|ИЗ
		|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
		|ГДЕ
		|	ПеремещениеТоваров.ДокументОснование = &ДокументОснование
		|	И ПеремещениеТоваров.СкладКомпании = &СкладКомпании
		|	И ПеремещениеТоваров.НепроводнойДляДопОборудования = ИСТИНА";
	
 	Запрос.УстановитьПараметр("ДокументОснование", МассивСтрокТоваров[0].Регистратор.Ссылка);
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	
	ДокПеремещениеТ = Запрос.Выполнить().Выгрузить();
	//Работы.ВыбратьСтроку();
	
	ФлНовый = Ложь;
	Если ДокПеремещениеТ.Количество() = 0 Тогда
	    ПеремещениеТ = Документы.ПеремещениеТоваров.СоздатьДокумент();
		ФлНовый = Истина;
	Иначе
 	    ПеремещениеТ = ДокПеремещениеТ[0].Перемещение_Товаров.ПолучитьОбъект();
 	КонецЕсли;                              
	
	Если ФлНовый Тогда                              
		
 		ПеремещениеТ.Дата = ТекущаяДата();
		//Бондаренко++ 20211230
		Попытка
		    ПеремещениеТ.Дата = МассивСтрокТоваров[0].Регистратор.Дата-600;
 		Исключение
 		КонецПопытки;		
		//Бондаренко-- 20211230
  		ПеремещениеТ.Автор = ПараметрыСеанса.Пользователь;
		//Бондаренко++ 20220308
		//ПеремещениеТ.ДокументОснование = ЭтотОбъект.Ссылка; 
		ПеремещениеТ.ДокументОснование = МассивСтрокТоваров[0].Регистратор.Ссылка; 		
		//Бондаренко-- 20220308
 		ПеремещениеТ.СкладКомпании = СкладКомпании;                                                 
		//Бондаренко++ 20220318
		ПеремещениеТ.СкладПолучатель = СМ_ПерепродажиЗапчастей.НайтиСоответствующийСкладОрганизации(ЭтотОбъект.Организация,ЭтотОбъект.СкладКомпании);
		//Бондаренко-- 20220318
		ПеремещениеТ.Организация = СкладКомпании.Организация;
		ПеремещениеТ.ПодразделениеКомпании = СкладКомпании.Подразделение;
   		ПеремещениеТ.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
 		ПеремещениеТ.ХозОперация = Справочники.ХозОперации.ПеремещениеТоваров;
		ПеремещениеТ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		ПеремещениеТ.КурсДокумента = 1;
		ПеремещениеТ.ОтпустилСот = ПараметрыСеанса.Пользователь.Сотрудник;
		ПеремещениеТ.ПолучилСот = ПеремещениеТ.ОтпустилСот;
		ПеремещениеТ.Перевозчик = ПеремещениеТ.ОтпустилСот;
 		ПеремещениеТ.Комментарий = "Создан автоматически "+ТекущаяДата()+" пользователем "+ПараметрыСеанса.Пользователь+", при проведении документа "+ЭтотОбъект.Ссылка;
		ПеремещениеТ.НепроводнойДляДопОборудования=Истина;
   	
	КонецЕсли; 
	
	//Бондаренко++ 20220308
	ПеремещениеТ.ДокументОснование = МассивСтрокТоваров[0].Регистратор.Ссылка; 		
 	Попытка
	    ПеремещениеТ.Дата = МассивСтрокТоваров[0].Регистратор.Дата-600;
 	Исключение

	КонецПопытки;		
	ПеремещениеТ.УстановитьНовыйНомер();		
	//Сообщить("Дата перемещения "+ПеремещениеТ.Дата+" для документа "+ПеремещениеТ);
 	//Бондаренко-- 20220306
      
	Если ПеремещениеТ.Товары.Количество() > 0 Тогда
		ПеремещениеТ.Товары.Очистить();	
	КонецЕсли;  
	
  	Для каждого СтрТоваров Из МассивСтрокТоваров Цикл
		
		НоваяСтрокаТоваров = ПеремещениеТ.Товары.Добавить();
  		НоваяСтрокаТоваров.Номенклатура = СтрТоваров.Номенклатура;
		НоваяСтрокаТоваров.Количество = СтрТоваров.КоличествоРасход;		
		НоваяСтрокаТоваров.Коэффициент = 1;
		НоваяСтрокаТоваров.ЕдиницаИзмерения = СтрТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения;
   	КонецЦикла;
	
	Если ФлНовый Тогда
		Попытка
			ПеремещениеТ.Записать(РежимЗаписиДокумента.Запись);
		Исключение  
			ФлОтказ = Истина;		
		КонецПопытки;                              
	КонецЕсли;
  	
	Если НЕ ФлОтказ Тогда
	   	Попытка
			ПеремещениеТ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение  
			ФлОтказ = Истина;		
		КонецПопытки;                              
	КонецЕсли;
 	
    Возврат ФлОтказ;
	
КонецФункции // СМГ_НайтиСоздатьперемещениеТоваров(ПодразделениеКомпании,Авто,МассивСтрокТоваров)()

