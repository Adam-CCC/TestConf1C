	ИначеЕсли Имя="Автомобили.СуммаНДС" Тогда
				
	ИначеЕсли Имя="Автомобили.СуммаВсего" Тогда
		
		// Определим включают ли в себя НДС цены документа
		ЦенаВключаетНДС = (обЗначениеНеЗаполнено(ТипЦен) ИЛИ ТипЦен.ЦенаВключаетНДС);
