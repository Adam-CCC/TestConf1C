Функция ПроверитьОстаткиКомлектацийИРаботВКомплектациях(ТЗ)
	
	СЗ_Автомобилей = Новый СписокЗначений;
	СЗ_Автомобилей.ЗагрузитьЗначения(Автомобили.ВыгрузитьКолонку("Автомобиль"));	
	
	Рез=Ложь;
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиТоваровКомплектацияАвтомобилей.Номенклатура КАК НоменклатураИлиРабота,
	               |	СУММА(ОстаткиТоваровКомплектацияАвтомобилей.КоличествоОстаток) КАК Остаток,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.Автомобиль,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СкладКомпании.Организация КАК Организация,
	               |	СУММА(ОстаткиТоваровКомплектацияАвтомобилей.СуммаПродажиУпрОстаток) КАК Сумма,
	               |	1 КАК ЭтоДеталь,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СкладКомпании,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.ХарактеристикаНоменклатуры,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СтатусПартии,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.Партия,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.ГТД,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СуммаНДСОстаток КАК СуммаНДС,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СкладКомпании.Подразделение КАК ПодразделениеКомпании
	               |ИЗ
	               |	РегистрНакопления.КомплектацияАвтомобилей.Остатки(&НаДату, Автомобиль В (&СЗ_Автомобилей)) КАК ОстаткиТоваровКомплектацияАвтомобилей
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиТоваровКомплектацияАвтомобилей.Номенклатура,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.Автомобиль,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СкладКомпании.Организация,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СкладКомпании,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.ХарактеристикаНоменклатуры,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СтатусПартии,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.Партия,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.ГТД,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СуммаНДСОстаток,
	               |	ОстаткиТоваровКомплектацияАвтомобилей.СкладКомпании.Подразделение
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Работа,
	               |	СУММА(СМГ_КомплектацияАвтомобилейАвтоработыОстатки.КоличествоОстаток),
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Автомобиль,
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Организация,
	               |	СУММА(СМГ_КомплектацияАвтомобилейАвтоработыОстатки.СуммаУпрОстаток),
	               |	0,
	               |	"""",
	               |	"""",
	               |	"""",
	               |	"""",
	               |	"""",
	               |	0,
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.ПодразделениеКомпании
	               |ИЗ
	               |	РегистрНакопления.СМГ_КомплектацияАвтомобилейАвтоработы.Остатки(&НаДату, Автомобиль В (&СЗ_Автомобилей)) КАК СМГ_КомплектацияАвтомобилейАвтоработыОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Работа,
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Автомобиль,
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.Организация,
	               |	СМГ_КомплектацияАвтомобилейАвтоработыОстатки.ПодразделениеКомпании";
	
	Запрос.Параметры.Вставить("СЗ_Автомобилей", СЗ_Автомобилей);
	Запрос.Параметры.Вставить("НаДату", ? ( обЗначениеНеЗаполнено(Ссылка.Дата), КонецДня(ТекущаяДата()), КонецДня(Ссылка.Дата) ) );
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() > 0 Тогда
		//Бондаренко++ 20251114
		Если ( ТЗ.Итог("Остаток") <> 0 ) ИЛИ ( ТЗ.Итог("Сумма") <> 0 ) Тогда
			//Бондаренко-- 20251114	
			#Если наКлиенте Тогда
				ТекстСообщения = "Ошибка! Реализация автомобиля не проводится из-за того, что существуют товары или работы, которые не перенесены из комплектаций автомобиля в заказ-наряды:";
				Для каждого Стр Из ТЗ Цикл
					ТекстСообщения = ТекстСообщения+Символы.ПС+Стр.НоменклатураИлиРабота+", количество: "+Стр.Остаток+" , сумма: "+Стр.Сумма+", организация: "+Стр.Организация+", подразделение: "+Стр.ПодразделениеКомпании; 
				КонецЦикла; 
				Сообщить(ТекстСообщения,СтатусСообщения.ОченьВажное);		
			#КонецЕсли
			
			Рез = Истина ;
			Возврат Рез;
			//Бондаренко++ 20251114	
		КонецЕсли;
		//Бондаренко-- 20251114
	КонецЕсли;
	Возврат Рез;
КонецФункции // ПроверитьОстаткиКомлектацийИРаботВКомплектациях()

Процедура СМГ_ЗакрытьСтарыеКомплектации(ТЗ)
	
	Если ТЗ = Неопределено Тогда
	    Возврат;
 	КонецЕсли;
	
	Если ТЗ.Количество() = 0 Тогда
	    Возврат;
	КонецЕсли;                         
 	
	Если ТЗ.Количество() > 0 Тогда
		Движения.КомплектацияАвтомобилей.Очистить();
		Движения.СМГ_КомплектацияАвтомобилейАвтоработы.Очистить();
		Для каждого ТекСтрока Из ТЗ Цикл
			Если ТекСтрока.ЭтоДеталь = 1 Тогда
				Движение = Движения.КомплектацияАвтомобилей.Добавить();
				Движение.ВидДвижения                = ВидДвиженияНакопления.Расход;
				Движение.Период                     = Дата;
				Движение.Автомобиль                 = ТекСтрока.Автомобиль;
				Движение.СкладКомпании              = ТекСтрока.СкладКомпании;
				Движение.Номенклатура               = ТекСтрока.НоменклатураИлиРабота;
				Движение.ХарактеристикаНоменклатуры = ТекСтрока.ХарактеристикаНоменклатуры;
				Движение.СтатусПартии               = ТекСтрока.СтатусПартии;
				Движение.Партия                     = ТекСтрока.Партия;
				Движение.ГТД                        = ТекСтрока.ГТД;
				Движение.Количество      			= ТекСтрока.Остаток;
				Движение.Сумма          			= ТекСтрока.Сумма;
				Движение.СуммаНДС        			= ТекСтрока.СуммаНДС;
				Движение.ХозОперация     			= Справочники.ХозОперации.КомплектацияАвтомобиля;
				Если ТекСтрока.СуммаНДС > 0 Тогда
					Движение.СтавкаНДС       		= Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
 				Иначе
				   Движение.СтавкаНДС       		= Справочники.СтавкиНДС.БезНДС;
 				КонецЕсли;
 				Движение.СуммаУпр        			= ТекСтрока.Сумма;
				Движение.СуммаПродажи    			= ТекСтрока.Сумма;
				Движение.СуммаПродажиУпр 			= ТекСтрока.Сумма;
			Иначе
				Движение = Движения.СМГ_КомплектацияАвтомобилейАвтоработы.Добавить();
				Движение.ВидДвижения  = ВидДвиженияНакопления.Расход;
				Движение.Период       = Дата;
				Движение.Автомобиль   = ТекСтрока.Автомобиль;
				Движение.Работа       = ТекСтрока.НоменклатураИлиРабота;
				Движение.Организация  = ТекСтрока.Организация;  
				//Бондаренко++ 20211210
				Движение.ПодразделениеКомпании = ТекСтрока.ПодразделениеКомпании;
				//Бондаренко-- 20211210
				Движение.Количество   = ТекСтрока.Остаток;
				Движение.СуммаУпр     = ТекСтрока.Сумма;
				Движение.ХозОперация  = Справочники.ХозОперации.КомплектацияАвтомобиля;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;                  
 	
КонецПроцедуры
