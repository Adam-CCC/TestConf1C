		Исключение 
		ФлОтказ = Истина;	
 	 	#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+СчетФактура+"' не удалось провести.",СтатусСообщения.ОченьВажное);
	  	#КонецЕсли 
 		КонецПопытки;
	Исключение
		ФлОтказ = Истина;	
	 	#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+СчетФактура+"' не удалось записать.",СтатусСообщения.ОченьВажное);
