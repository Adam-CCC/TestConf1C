Функция ПроверкаНаНеЗакрытыеКомплектации() Экспорт 
	Результат = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КомплектацияАвтомобиля.Ссылка,
	               |	КомплектацияАвтомобиля.Автомобиль
	               |ИЗ
	               |	Документ.КомплектацияАвтомобиля КАК КомплектацияАвтомобиля
	               |ГДЕ
	               |	КомплектацияАвтомобиля.Автомобиль В(&Автомобиль)
	               |	И НЕ КомплектацияАвтомобиля.Состояние В (&СписокРазрешенныхСостояний)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаказНаряд.Ссылка,
	               |	ЗаказНаряд.Автомобиль
	               |ИЗ
	               |	Документ.ЗаказНаряд КАК ЗаказНаряд
	               |ГДЕ
	               |	ЗаказНаряд.Автомобиль В(&Автомобиль)
	               |	И НЕ ЗаказНаряд.Состояние В (&СписокРазрешенныхСостояний)";
				   
	Запрос.УстановитьПараметр("Автомобиль",Автомобили.ВыгрузитьКолонку("Автомобиль"));			   
	
	//Бондаренко++ 20210621
	//Заменил в запросе единственное состояние "Закрыт" на список из двух значений: "Закрыт" и "Отказ" 
 	СЗ_РазрешенныхСостояний = Новый СписокЗначений;
	СЗ_РазрешенныхСостояний.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Закрыт);
	СЗ_РазрешенныхСостояний.Добавить(Справочники.ВидыСостоянийЗаказНарядов.Отказ);
	Запрос.УстановитьПараметр("СписокРазрешенныхСостояний",СЗ_РазрешенныхСостояний);
 	//Бондаренко++ 20210621
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() тогда
		Результат = Истина;
		#Если Клиент Тогда
		Сообщить("ОШИБКА! По автомобилям есть незакрытые комплектации или заказ-наряды: "+РезультатЗапроса.Ссылка);
		#КонецЕсли
		Возврат Результат;
 	Иначе
	    Результат = Ложь;
 		Возврат Результат;
	КонецЕсли;
	Возврат Результат;
КонецФункции	
