			Иначе
				СуммаНДС       = Окр(((СуммаБезСкидки-Себестоимость)*СтавкаНДС)/(100+СтавкаНДС),2);
				РасчетнаяСумма = Макс(СуммаБезСкидки - СуммаНДС, 0);
