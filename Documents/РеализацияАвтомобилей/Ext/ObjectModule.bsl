							СМГ_Сообщить("ОШИБКА! "+ДокументОснование+" не проведен." +
							Символы.ПС + "Проведите этот документ.", СтатусСообщения.ОченьВажное);
						#КонецЕсли
						Отказ = Истина;
					Иначе	
						Если обПраво("РеализацияАвтомобиляТолькоНаОснованииОтгрузки") Тогда
							Если ТипЗнч(ДокументОснование) <> Тип("ДокументСсылка.ОтгрузкаАвтомобиляБезРеализации")  Тогда
								#Если Клиент Тогда
									СМГ_Сообщить("ОШИБКА! Реализация автомобиля сторонним контрагентам вводятся только на основании Отгрузки без реализации " +
									Символы.ПС + "Выберите или создайте соответствующую Отгрузку.", СтатусСообщения.ОченьВажное);
								#КонецЕсли
								Отказ = Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Бондаренко-- 20251210
	
	//Бондаренко++ 20260128
	Если Не Отказ Тогда
		Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
			Если НЕ Контрагент.НашаФирма Тогда
				Если Не обЗначениеНеЗаполнено(ДокументОснование) Тогда
					Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтгрузкаАвтомобиляБезРеализации") Тогда
						Если ДокументОснование.ХозОперация = Справочники.ХозОперации.ОтменаОтгрузкиАвтомобиляБезРеализации Тогда
							#Если Клиент Тогда
								СМГ_Сообщить("ОШИБКА! Реализация автомобиля сторонним контрагентам с основанием <<Отгрузка без реализации>> должна иметь одноимённую хозоперацию." +
								Символы.ПС + "Выберите или создайте соответствующую Отгрузку.", СтатусСообщения.ОченьВажное);
							#КонецЕсли
							Отказ = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не Отказ Тогда
		Если РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
			Если обПраво("РеализацияАвтомобиляТолькоНаОснованииОтгрузки") Тогда
				Если НЕ Контрагент.НашаФирма Тогда
					Если Не обЗначениеНеЗаполнено(ОтгрузкаАвтомобиляБезРеализации) Тогда
						Если ОтгрузкаАвтомобиляБезРеализации.ХозОперация = Справочники.ХозОперации.ОтменаОтгрузкиАвтомобиляБезРеализации Тогда
							#Если Клиент Тогда
								СМГ_Сообщить("ОШИБКА! Хозоперация реквизита <<Отгрузка без реализации>> имеет тип <<Отмена отгрузки без реализации>>." +
								Символы.ПС + "Выберите или создайте Отгрузку с правильной Хозоперацией.", СтатусСообщения.ОченьВажное);
							#КонецЕсли
							Отказ = Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	//Бондаренко-- 20260128
		
	//Бондаренко++ 20230324
