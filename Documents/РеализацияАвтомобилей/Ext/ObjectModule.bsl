Функция СМГ_НайтиСоздатьАктОказанияУслугСубподряд(ТекРегистратор,Источник)
	ФлОтказ = Ложь;
 	Запрос = Новый Запрос;
 	ПоступлениеТоваров = Документы.ПоступлениеТоваров.СоздатьДокумент();
	
   	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваров.Ссылка КАК Поступление_Товаров
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.ДокументОснование = &ДокументОснование
	|	И ПоступлениеТоваров.ХозОперация = &ХозОперация";
 	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
	Запрос.УстановитьПараметр("ХозОперация", Справочники.ХозОперации.УслугиПоСубподряду);	
  	РезультатЗапроса = Запрос.Выполнить();
  	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
  	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПоступлениеТоваров = ВыборкаДетальныеЗаписи.Поступление_Товаров.ПолучитьОбъект();
	КонецЦикла;
 	 
  	ПоступлениеТоваров.ОбработкаЗаполнения(Источник.Ссылка);
	
	 
	ВидДоговораПокупка = Перечисления.ВидыДоговоров.Покупка;
	//Бондаренко++ 20220226
	ПоступлениеТоваров.Контрагент = Источник.Организация.КонтрагентОрганизации;
 	ПоступлениеТоваров.ПодразделениеКомпании = ТекРегистратор.ПодразделениеКомпании;
	ПоступлениеТоваров.Организация = ТекРегистратор.ПодразделениеКомпании.Организация;
	ПоступлениеТоваров.Дата = Источник.Дата;
	//Бондаренко-- 20220226
	ПоступлениеТоваров.УстановитьНовыйНомер();	                                                                                                                          
 	ПоступлениеТоваров.ДоговорВзаиморасчетов = НайтиСоздатьДоговор(ПоступлениеТоваров.Контрагент,ПоступлениеТоваров.Организация,ПоступлениеТоваров.ПодразделениеКомпании,ВидДоговораПокупка); 
 
  	Попытка
		ПоступлениеТоваров.Записать(РежимЗаписиДокумента.Запись);
		Попытка
			ПоступлениеТоваров.Записать(РежимЗаписиДокумента.Проведение);
		Исключение 
		ФлОтказ = Истина;	
 	 	#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+ПоступлениеТоваров+"' не удалось провести.",СтатусСообщения.ОченьВажное);
	  	#КонецЕсли 
 		КонецПопытки;
	Исключение
		ФлОтказ = Истина;	
	 	#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+ПоступлениеТоваров+"' не удалось записать.",СтатусСообщения.ОченьВажное);
	  	#КонецЕсли 
	КонецПопытки; 
	Если Не ФлОтказ Тогда
		//Бондаренко++ 20220226
		СМГ_НайтиСоздатьСФполученный(ПоступлениеТоваров);
		//Бондаренко-- 20220226
 	КонецЕсли;
	Возврат ФлОтказ;
КонецФункции // СМГ_НайтиСоздатьАктОказанияУслугСубподряд(Источник)

Функция СМГ_НайтиСоздатьДоговорСубподряд(ТекКонтрагент,ТекОрганизация,ТекПодразделение) 
	
	НовДог = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыВзаиморасчетов.Ссылка,
	               |	ДоговорыВзаиморасчетов.Владелец,
	               |	ДоговорыВзаиморасчетов.Организация,
	               |	ДоговорыВзаиморасчетов.ВидДоговора
	               |ИЗ
	               |	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	               |ГДЕ
	               |	ДоговорыВзаиморасчетов.Владелец = &Владелец
	               |	И ДоговорыВзаиморасчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Продажа)
	               |	И ДоговорыВзаиморасчетов.Организация = &Организация
	               |	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
	               |	И ДоговорыВзаиморасчетов.ЭтоГруппа = ЛОЖЬ
	               |	И ДоговорыВзаиморасчетов.Наименование ПОДОБНО &Субподряд";
	 
	Запрос.УстановитьПараметр("Владелец",ТекКонтрагент);
 	Запрос.УстановитьПараметр("Организация",ТекОрганизация);
	Запрос.УстановитьПараметр("Субподряд","%%"+"СУБПОДРЯД"+"%%");
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	НовДог                      = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	
	НовДог.УстановитьНовыйКод();
	
	НовДог.ТипДоговора          = Перечисления.ТипыДоговоров.Договор;
 	НовДог.ВидДоговора          = Перечисления.ВидыДоговоров.Продажа;
	НовДог.Владелец             = ТекКонтрагент;
	НовДог.Организация          = ТекОрганизация;
	НовДог.Подразделение        = ТекПодразделение;
	НовДог.Владелец             = ТекКонтрагент;
	НовДог.ДатаНачала           = ЭтотОбъект.Дата;
	НовДог.НомерДоговора        = "";
 	НовДог.Автор                = ПараметрыСеанса.Пользователь;
	НовДог.ДатаСоздания         = ТекущаяДата();
	НовДог.ВидОплаты            = Перечисления.ВидыОплаты.ПроизвольнаяОплата;
	НовДог.Комментарий          = "Договор создан обработкой. Пользователь: "+ПараметрыСеанса.Пользователь+" "+Формат(ТекущаяДата(),"ДЛФ=DDT");
	НовДог.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
 	НовДог.ТипЦенПродажи        = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
	НовДог.ТипЦенРабот          = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
	НовДог.ТипЦенПокупки        = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;

	НовДог.СформироватьНаименование();
	НовДог.Наименование = СокрЛП(НовДог.Наименование)+" СУБПОДРЯД";

	//Форма = НовДог.ПолучитьФорму("ФормаЭлемента");
	//Если Не Форма.Открыта() Тогда
	//	Форма.ОткрытьМодально();
	//КонецЕсли;
	
	Попытка
		НовДог.Записать();
		#Если Клиент Тогда 
			Сообщить("Записан новый договор "+НовДог);
		#КонецЕсли
	Исключение
		#Если Клиент Тогда 
			Сообщить("ОШИБКА! Не удалось записать новый договор взаиморасчетов ",СтатусСообщения.ОченьВажное);	
		#КонецЕсли
   	КонецПопытки; 
	
	Возврат НовДог.Ссылка;

КонецФункции // СМГ_НайтиСоздатьДоговорСубподряд(ТекКонтрагент,ТекОрганизация,ТекПодразделение)

