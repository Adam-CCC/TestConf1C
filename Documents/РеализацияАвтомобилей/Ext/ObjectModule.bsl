Функция ПечатьУниверсальная(ТабДокумент) Экспорт
	
	СтруктураПокупкиАвто = АвтоБУ();
	Если СтруктураПокупкиАвто<>Неопределено Тогда
		Если СтруктураПокупкиАвто.БУ Тогда
			Для Счетчик = 1 По 2 Цикл   
				Если Счетчик = 1 Тогда
					ТабДокумент = ПечатьТорг12(ТабДокумент);
				Иначе
					ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц(); 
 					СчетФактураВыданный = СМ_ФормированиеНовыхОбъектов.НайтиСоздатьСинхронизироватьДокументСчетФактураВыданныйБезСообщений(Ссылка,ПометкаУдаления,Ложь); 
					СчетФактураВыданный_ = СчетФактураВыданный.ПолучитьОбъект();
    				ТабДокумент = СчетФактураВыданный_.ПечатьСчетФактуры2021(ТабДокумент);
		 			Возврат ТабДокумент;	
				КонецЕсли;
 			КонецЦикла;
 		Иначе
			ТабДокумент = дкПечатьУПД(ЭтотОбъект,ТабДокумент); 
			Возврат ТабДокумент;	
		КонецЕсли;
	Иначе
		ТабДокумент = дкПечатьУПД(ЭтотОбъект,ТабДокумент); 
		Возврат ТабДокумент;	
	КонецЕсли;	
	
КонецФункции //ПечатьРеализацияАвтомобиля(ТабДокумент)

Функция АвтоБУ()
	
 		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОстаткиАвтомобилейОстатки.Автомобиль КАК Автомобиль,
		               |	ОстаткиАвтомобилейОстатки.СкладКомпании КАК СкладКомпании,
		               |	ОстаткиАвтомобилейОстатки.СтатусПартии КАК СтатусПартии,
		               |	ОстаткиАвтомобилейОстатки.Партия КАК Партия,
		               |	ОстаткиАвтомобилейОстатки.ГТД КАК ГТД,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.КоличествоОстаток, 0) КАК Количество,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаОстаток, 0) КАК Сумма,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаУпрОстаток, 0) КАК СуммаУпр,
		               |	ЕСТЬNULL(ОстаткиАвтомобилейОстатки.СуммаНДСОстаток, 0) КАК СуммаНДС
		               |ПОМЕСТИТЬ ПартияАвто
		               |ИЗ
		               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки(&Момент, Автомобиль = &Автомобиль) КАК ОстаткиАвтомобилейОстатки
		               |
		               |ДЛЯ ИЗМЕНЕНИЯ
		               |	РегистрНакопления.ОстаткиАвтомобилей.Остатки
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЕСТЬNULL(ПоступлениеАвтомобилейАвтомобили.АвтомобильБУ, ЛОЖЬ) КАК БУ,
		               |	ПоступлениеАвтомобилейАвтомобили.СуммаВсего,
		               |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Организация
		               |ИЗ
		               |	ПартияАвто КАК ПартияАвто
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
		               |		ПО ПартияАвто.Партия.Ссылка = ПоступлениеАвтомобилейАвтомобили.Ссылка
		               |ГДЕ
		               |	ПартияАвто.Партия.Контрагент.ФормаСобственности = &ФормаСобственности";
		
		Запрос.УстановитьПараметр("Момент",Дата);
		Запрос.УстановитьПараметр("Автомобиль",Автомобили[0].Автомобиль);
  		Запрос.УстановитьПараметр("ФормаСобственности",Перечисления.ФормыСобственности.ЧастноеЛицо);
 		
		Результат = Запрос.Выполнить().Выбрать();
		БУ = Неопределено;
		Структура = Новый Структура;
		Если Результат.Следующий() тогда
			Структура.Вставить("БУ",Результат.БУ);
			Структура.Вставить("Организация",Результат.Организация);
 			//БУ = Результат.БУ;
			Возврат Структура;
		Иначе
			Возврат БУ;
		КонецЕсли;
  	
КонецФункции

