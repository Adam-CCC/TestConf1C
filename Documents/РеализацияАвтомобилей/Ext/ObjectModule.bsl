	ОбластьВсего.Параметры.ИтогНДС        = ИтогоНДС;
	ОбластьВсего.Параметры.ИтогСуммыСНДС  = ИтогоСуммаСНДС;
	ТабДокумент.Вывести(ОбластьВсего);
	
	//// выведем итоги по ставкам НДС
