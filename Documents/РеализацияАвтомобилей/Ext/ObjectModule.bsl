	Если Не ЭтоНовый() И Не Отказ И РежимЗаписи = РежимЗаписиДокумента.Проведение И
		ЗначениеЗаполнено(ДокументОснование) И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") И 
		ЗначениеЗаполнено(ДокументОснование.ДокументОснование) И ТипЗнч(ДокументОснование.ДокументОснование) = Тип("ДокументСсылка.РабочийЛист") Тогда
		РегистрыСведений.SM_ФиксацияРабочихЛистов.ДобавитьЗапись(ДокументОснование.ДокументОснование);
