	ОбластьИтоги.Параметры.ИтогСуммыПоСтранице      = ИтогоСуммаНаСтранице;
	ОбластьИтоги.Параметры.ИтогНДСПоСтранице        = ИтогоНДСНаСтранице;
	ОбластьИтоги.Параметры.ИтогСуммыСНДСПоСтранице  = ИтогоСуммаСНДСНаСтранице;
