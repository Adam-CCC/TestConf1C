	//Бондаренко++ 20260114
	Если Не РегламентированныйУчет Тогда
		РегламентированныйУчет = Истина;
 	КонецЕсли;
	//Бондаренко-- 20260114
	
	Если НЕ дкПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда Возврат; КонецЕсли;  
 	
