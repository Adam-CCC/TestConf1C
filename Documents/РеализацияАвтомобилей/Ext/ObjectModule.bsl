			ИначеЕсли Основание.РабочийЛист.ВидОплаты = Перечисления.ВидыОплаты.НаличныйРасчет Тогда	
				СпособОплатыАвтомобиля = Перечисления.СпособОплатыАвто.Наличные;	  			
			ИначеЕсли Основание.РабочийЛист.ВидОплаты = Перечисления.ВидыОплаты.Лизинг Тогда	
				СпособОплатыАвтомобиля = Перечисления.СпособОплатыАвто.Лизинг;			
			Иначе	
				СпособОплатыАвтомобиля = Перечисления.СпособОплатыАвто.ПустаяСсылка();		
			КонецЕсли;
			
			//Бондаренко++ 20250705
 			Авто_ = Основание.Автомобиль;
			Если НЕ обЗначениеНеЗаполнено(Авто_) Тогда
			   	ОтгрузкаАвтомобиляБезРеализации = НайтиОАБР(Авто_);
				//Бондаренко++ 20250722
				Если Не обЗначениеНеЗаполнено(ОтгрузкаАвтомобиляБезРеализации) Тогда 
					Если СкладКомпании <> ОтгрузкаАвтомобиляБезРеализации.СкладКомпании Тогда
						СкладКомпании = ОтгрузкаАвтомобиляБезРеализации.СкладКомпании;	
 					КонецЕсли;
  				КонецЕсли;
				//Бондаренко-- 20250722
	 		КонецЕсли;
 			//Бондаренко-- 20250705
		
		КонецЕсли;  
		
	//КонецЕсли; 
	//Иванченко 20240810--		
		
КонецПроцедуры 

//Бондаренко++ 20250705
Функция НайтиОАБР(Авто)
	
	ОАБР_ = "";
	
    Запрос = Новый Запрос;
		
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтгрузкаАвтомобиляБезРеализации.Ссылка КАК Ссылка,
		|	ОтгрузкаАвтомобиляБезРеализации.Дата КАК Дата,
		|	ОтгрузкаАвтомобиляБезРеализации.Автомобиль КАК Автомобиль,
		|	ОтгрузкаАвтомобиляБезРеализации.ХозОперация КАК ХозОперация
		|ИЗ
		|	Документ.ОтгрузкаАвтомобиляБезРеализации КАК ОтгрузкаАвтомобиляБезРеализации
		|ГДЕ
		|	ОтгрузкаАвтомобиляБезРеализации.Автомобиль = &Автомобиль
		|	И ОтгрузкаАвтомобиляБезРеализации.ХозОперация <> ЗНАЧЕНИЕ(Справочник.ХозОперации.ОтменаОтгрузкиАвтомобиляБезРеализации)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Автомобиль", Авто);
 	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОАБР_ = ВыборкаДетальныеЗаписи.Ссылка;
 		Прервать; 
	КонецЦикла;
	
	Возврат ОАБР_; 

КонецФункции //НайтиОАБР(Авто)
