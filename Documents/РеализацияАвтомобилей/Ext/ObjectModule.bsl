	СтруктураМакетов.Вставить("РеализацияАвтомобилей", "Реализация автомобилей");
	////Гэндальф+++
	//Если Константы.ДилерскийЦентр.Получить() <> Справочники.ДилерскиеЦентры.Дельта тогда
	////Гэндальф---	
		СтруктураМакетов.Вставить("ТОРГ12", "ТОРГ-12 (Товарная накладная)");
	////Гэндальф+++
	//КонецЕсли;
	////Гэндальф---
	СтруктураМакетов.Вставить("Т1", "1-Т (Товарно-транспортная накладная)");
	СтруктураМакетов.Вставить("Приложение4", "Приложение №4 (Транспортная накладная)");
	СтруктураМакетов.Вставить("АктПриемаПередачиТС", "Акт приема-передачи ТС");
 	Возврат СтруктураМакетов;
КонецФункции

