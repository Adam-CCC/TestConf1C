 		ПТ.Комментарий = "Создан автоматически "+ТекущаяДата()+" пользователем "+ПараметрыСеанса.Пользователь+", при проведении документа "+ЭтотОбъект.Ссылка;
		ПТ.НепроводнойДляДопОборудования=Истина;
