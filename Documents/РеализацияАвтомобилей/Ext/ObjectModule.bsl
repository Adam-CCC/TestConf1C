			Если НЕ Себестоимость = 0 Тогда
				СуммаВсегоБезСкидки = Макс(СуммаВсегоБезСкидки - Себестоимость, 0);
			КонецЕсли;
			ТекСтрока.СуммаНДС = Окр((СуммаВсегоБезСкидки*СтавкаНДС)/(100+СтавкаНДС),2);
