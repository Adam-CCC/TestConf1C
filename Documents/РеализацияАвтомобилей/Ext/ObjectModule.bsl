Функция НайтиОбособленноеПодразделениеОрганизации(Орг)
	
	Подр = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПодразделенияКомпании.Ссылка КАК Ссылка,
	|	ПодразделенияКомпании.Организация КАК Организация,
	|	ПодразделенияКомпании.ОПЗарегистрировано КАК ОПЗарегистрировано
	|ИЗ
	|	Справочник.ПодразделенияКомпании КАК ПодразделенияКомпании
	|ГДЕ
	|	ПодразделенияКомпании.Организация = &Орг
	|	И ПодразделенияКомпании.ОПЗарегистрировано"; 
	
	Запрос.УстановитьПараметр("Орг",Орг);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Подр = ВыборкаДетальныеЗаписи.Ссылка;
		Прервать;
	КонецЦикла;
	
	Возврат Подр;
 
КонецФункции // НайтиОбособленноеПодразделениеОрганизации(Орг)

Функция НайтиСоздатьДоговорПерепродажАМ(Владелец,Организация,Подразделение,ВидДоговора) Экспорт
  	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыВзаиморасчетов.Ссылка КАК Ссылка,
		|	ДоговорыВзаиморасчетов.ВидДоговора КАК ВидДоговора,
		|	ДоговорыВзаиморасчетов.Организация КАК Организация,
		|	ДоговорыВзаиморасчетов.ПометкаУдаления КАК ПометкаУдаления,
		|	ДоговорыВзаиморасчетов.ДляПерепродажАвтомобилей КАК ДляПерепродажАвтомобилей
		|ИЗ
		|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
		|ГДЕ
		|	ДоговорыВзаиморасчетов.Владелец = &Владелец
		|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора
		|	И ДоговорыВзаиморасчетов.Организация = &Организация
		|	И НЕ ДоговорыВзаиморасчетов.ПометкаУдаления
		|	И ДоговорыВзаиморасчетов.ДляПерепродажАвтомобилей";
	
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;

	НовДоговор = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
	НовДоговор.ВидДоговора = ВидДоговора;
	НовДоговор.Автор = ПараметрыСеанса.Пользователь; 
	НовДоговор.Организация = Организация;
	НовДоговор.Подразделение = Подразделение;
	НовДоговор.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	Новдоговор.ДатаНачала = ТекущаяДата();
	НовДоговор.ТипДоговора=Перечисления.ТипыДоговоров.Договор;
	НовДоговор.ВидОплаты=Перечисления.ВидыОплаты.БезналичныйРасчет;
	НовДоговор.Владелец=Владелец;
	НовДоговор.ДляПерепродажАвтомобилей = Истина;
 	НовДоговор.ДляАвтосалона = Истина;
	НовДоговор.СформироватьНаименование();                         
	НовДоговор.УстановитьНовыйКод("");
	
	Попытка
		НовДоговор.Записать();
	Исключение
		УстановитьПривилегированныйРежим(Истина);
		ОбновитьНумерациюОбъектов(Метаданные.Справочники.ДоговорыВзаиморасчетов);
		УстановитьПривилегированныйРежим(Ложь);
		НовДоговор.УстановитьНовыйКод("");
 		Попытка
  			НовДоговор.Записать();
		Исключение 
			СМГ_Сообщить("Ошибка! Не создан договор взаиморасчетов для перепродаж автомобилай.",СтатусСообщения.ОченьВажное);
		КонецПопытки;
	КонецПопытки;
	
	Возврат НовДоговор.Ссылка;
 
КонецФункции // НайтиСоздатьДоговорПерепродажАМ(Владелец,Организация,Подразделение,ВидДоговора) Экспорт
