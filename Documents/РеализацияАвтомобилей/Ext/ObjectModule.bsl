Процедура ЗавершитьВыдачуАвтомобиля()
	Если Дата < '20211201' Тогда
		Возврат;
	КонецЕсли;
	
	Если Контрагент.НашаФирма Тогда
		Возврат;
	КонецЕсли;
	
	Если Автомобили.Количество() > 0 Тогда
		АвтомобильВыдачи = Автомобили[0].Автомобиль;
		Модель = АвтомобильВыдачи.Модель;
		Если Не ПродажаБУАвто Тогда
			Если Модель.Марка = Справочники.Марка.FORD 
				И Модель.ПринадлежитЭлементу(Справочники.Модели.АВТОМОБИЛИ_В_ПРОДАЖЕ) Тогда			
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если АвтомобильВыдачи.ЗеленыйАвтомобиль Тогда
		Сообщить("Для зелёного автомобиля событие Выдача не создаётся/завершается.", СтатусСообщения.Информация);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
			РабочийЛист = ДокументОснование.ДокументОснование;
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ОтгрузкаАвтомобиляБезРеализации") Тогда
			РабочийЛист = ДокументОснование.ДокументОснование;
			РабочийЛист = РабочийЛист.ДокументОснование;
		Иначе
			Возврат;
		КонецЕсли;
		
		Если обЗначениеНеЗаполнено(РабочийЛист) Тогда
			Возврат;
		ИначеЕсли ТипЗнч(РабочийЛист) <> Тип("ДокументСсылка.РабочийЛист") Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ВыдачаСсылка = СМ_ФормированиеНовыхОбъектов.СоздатьЗавершитьВыдачуАвтомобиля(Дата, АвтомобильВыдачи, РабочийЛист);
	Если обЗначениеНеЗаполнено(ВыдачаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	мзПродажаЧужогоАвто = РегистрыСведений.ПродажаАвтоДругогоДилера.СоздатьМенеджерЗаписи();
	мзПродажаЧужогоАвто.РеализацияАвтомобиля = Ссылка;
	мзПродажаЧужогоАвто.Прочитать();
	Если мзПродажаЧужогоАвто.Выбран() Тогда
		мзПродажаЧужогоАвто.ВыдачаАвтомобиля = ВыдачаСсылка;
		мзПродажаЧужогоАвто.Записать();
	КонецЕсли;
КонецПроцедуры
