		|			РегистрНакопления.ОстаткиАвтомобилей.Остатки(&ДатаОстатков, ) КАК ОстаткиАвтомобилейОстатки
		|		ГДЕ
		|			ОстаткиАвтомобилейОстатки.КоличествоОстаток > 0) КАК ОстаткиАвто
		|		ПО ЗаказНаряд.Автомобиль = ОстаткиАвто.Автомобиль
		|ГДЕ
		|	ЗаказНаряд.Состояние = ЗНАЧЕНИЕ(Справочник.ВидыСостоянийЗаказНарядов.Закрыт)
		|	И ЗаказНаряд.Автомобиль В(&СЗ_Автомобилей)
		|	И ЗаказНаряд.ВидРемонта В(&СЗ_ВидовРемонта)
		|	И ЗаказНаряд.Дата > ОстаткиАвто.ПартияДата";
	
	Запрос.УстановитьПараметр("СЗ_Автомобилей", СЗ_Автомобилей);
	Запрос.УстановитьПараметр("СЗ_ВидовРемонта",СЗ_ВидовРемонта);
	Запрос.УстановитьПараметр("ДатаОстатков",ДокИсточник.Дата);	
	
	СписокФинальныхЗН = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаказНаряд");
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Регистратор,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Автомобиль,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Работа,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Организация,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.ПодразделениеКомпании,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.КоличествоРасход,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.СуммаУпрРасход,
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Регистратор.Организация
		|ИЗ
		|	РегистрНакопления.СМГ_КомплектацияАвтомобилейАвтоработы.Обороты(, , Авто, ) КАК СМГ_КомплектацияАвтомобилейАвтоработыОбороты
		|ГДЕ
		|	СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Регистратор В(&СписокФинальныхЗН)
		|	И НЕ СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Регистратор.Организация = СМГ_КомплектацияАвтомобилейАвтоработыОбороты.Организация";
	
	Запрос.УстановитьПараметр("СписокФинальныхЗН", СписокФинальныхЗН);
 	
	ТЗ_работы = Запрос.Выполнить().Выгрузить();
	
    //ТЗ_работы.ВыбратьСтроку(ТЗ_работы.Количество()); 
	
 	#Если Клиент Тогда
	Сообщить("Формируются заказ-наряды по субподрядчикам.");
	#КонецЕсли   
	
	ФлагОтказ = СМГ_НайтиСоздатьЗаказНарядыПоРаботам(ТЗ_работы);
	
	Если Не ФлагОтказ Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КомплектацияАвтомобилейТоварыОбороты.Регистратор,
		|	КомплектацияАвтомобилейТоварыОбороты.Автомобиль,
		|	КомплектацияАвтомобилейТоварыОбороты.СкладКомпании,
		|	КомплектацияАвтомобилейТоварыОбороты.Номенклатура,
		|	КомплектацияАвтомобилейТоварыОбороты.КоличествоРасход,
		|	КомплектацияАвтомобилейТоварыОбороты.СуммаУпрРасход,
		|	КомплектацияАвтомобилейТоварыОбороты.СуммаНДСРасход
		|ИЗ
		|	РегистрНакопления.КомплектацияАвтомобилей.Обороты(, , Авто, ) КАК КомплектацияАвтомобилейТоварыОбороты
		|ГДЕ
		|	КомплектацияАвтомобилейТоварыОбороты.Регистратор В(&СписокФинальныхЗН)";
		
		Запрос.УстановитьПараметр("СписокФинальныхЗН", СписокФинальныхЗН);
		
		ТЗ_товары = Запрос.Выполнить().Выгрузить(); 
		
		//ТЗ_товары.ВыбратьСтроку();
		
		ФлагОтказ = СМГ_НайтиСоздатьТоварныеДокументыПоТоварам(ТЗ_товары,СЗ_Автомобилей);		
		
	КонецЕсли;
   
 	Возврат ФлагОтказ;
КонецФункции // СМГ_ПереоформитьСубподрядныеЗаказНарядыПоДопОборудованию(ДокИсточник) 

Функция СМГ_НайтиСоздатьТоварныеДокументыПоТоварам(ТаблицаТоваров,СЗ_Автомобилей)
	ФлОтказ = Ложь;
 	СписокСкладовКомпанииДляПродаж      = Новый СписокЗначений;
	СписокСкладовКомпанииДляПеремещений = Новый СписокЗначений;
	Для каждого Стр Из ТаблицаТоваров Цикл
	    Если обЗначениеНеЗаполнено(Стр.СкладКомпании) Тогда
			Продолжить;		
		КонецЕсли;                             
		//Бондаренко++ 20220308
		//Если Стр.СкладКомпании.Подразделение = ЭтотОбъект.ПодразделениеКомпании Тогда
		Если Стр.СкладКомпании.Подразделение = Стр.Регистратор.ПодразделениеКомпании Тогда	
		//Бондаренко-- 20220308	
			Продолжить;				
		Иначе
			//Бондаренко++ 20220308
			//Если Стр.СкладКомпании.Организация = ЭтотОбъект.Организация Тогда
			Если Стр.СкладКомпании.Организация = Стр.Регистратор.Организация Тогда					
			//Бондаренко-- 20220308	
				Если СписокСкладовКомпанииДляПеремещений.НайтиПоЗначению(Стр.СкладКомпании) = Неопределено  Тогда
					СписокСкладовКомпанииДляПеремещений.Добавить(Стр.СкладКомпании); 
 				КонецЕсли;
 			Иначе 
				Если СписокСкладовКомпанииДляПродаж.НайтиПоЗначению(Стр.СкладКомпании) = Неопределено  Тогда
					СписокСкладовКомпанииДляПродаж.Добавить(Стр.СкладКомпании); 
 				КонецЕсли;
   			КонецЕсли; 			
		КонецЕсли;
	КонецЦикла;
	
	Если СписокСкладовКомпанииДляПеремещений.Количество() > 0 Тогда
		Для каждого ТекСклад Из СписокСкладовКомпанииДляПеремещений Цикл
			Для каждого Авто Из СЗ_Автомобилей Цикл
				ФлОтказ = СМГ_НайтиСоздатьПеремещенияПоТоварам(ТекСклад.Значение,Авто,ТаблицаТоваров);	
				Если ФлОтказ Тогда
 					Прервать;				
 				КонецЕсли;
	 		КонецЦикла;
	  	КонецЦикла;
	КонецЕсли;
	
	Если Не ФлОтказ Тогда
	Если СписокСкладовКомпанииДляПродаж.Количество() > 0 Тогда
		Для каждого ТекСклад Из СписокСкладовКомпанииДляПродаж Цикл
			Для каждого Авто Из СЗ_Автомобилей Цикл
				ФлОтказ = СМГ_НайтиСоздатьПродажиПоТоварам(ТекСклад.Значение,Авто,ТаблицаТоваров);	
				Если ФлОтказ Тогда
 					Прервать;				
 				КонецЕсли;
	 		КонецЦикла;
	  	КонецЦикла;
	КонецЕсли;
	КонецЕсли;
 
	Возврат ФлОтказ;
КонецФункции // СМГ_НайтиСоздатьТоварныеДокументыПоТоварам(ТаблицаТоваров,СЗ_Автомобилей)  

Функция СМГ_НайтиСоздатьПродажиПоТоварам(СкладКомпании,Авто,ТаблицаТоваров)
	ФлОтказ = Ложь; 	
	Отбор = Новый Структура();
	Отбор.Вставить("СкладКомпании",СкладКомпании);	
	Отбор.Вставить("Автомобиль",Авто);	
	МассивСтрокТоваровПредварительный = ТаблицаТоваров.НайтиСтроки(Отбор);
	//Бондаренко++ 20211230                     
	СЗ_регистраторов = Новый СписокЗначений;
	Если МассивСтрокТоваровПредварительный.Количество() > 0 Тогда
		Для каждого ЭлМассива Из МассивСтрокТоваровПредварительный Цикл
			Если СЗ_Регистраторов.НайтиПоЗначению(ЭлМассива.Регистратор)=Неопределено Тогда
				СЗ_Регистраторов.Добавить(ЭлМассива.Регистратор)				
			КонецЕсли;		
		КонецЦикла;
	Иначе
		Возврат ФлОтказ;		
	КонецЕсли;	
	Для каждого ТекРегистратор Из СЗ_Регистраторов Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("Регистратор",ТекРегистратор.Значение);
		Отбор.Вставить("СкладКомпании",СкладКомпании);	
		Отбор.Вставить("Автомобиль",Авто);	
		МассивСтрокТоваров = ТаблицаТоваров.НайтиСтроки(Отбор);
	//Бондаренко-- 20211230
		Если МассивСтрокТоваров.Количество() > 0 Тогда
			#Если Клиент Тогда
				Сообщить("Найдено строк товаров для реализаций в количестве: "+МассивСтрокТоваров.Количество()+" по складу: "+СкладКомпании+" по автомобилю: "+Авто+" по регистратору: "+ТекРегистратор);		
			#КонецЕсли
			ФлОтказ = СМГ_НайтиСоздатьРеализациюТоваров(СкладКомпании,Авто,МассивСтрокТоваров);
		КонецЕсли;
	//Бондаренко++ 20211230	
	КонецЦикла;
	//Бондаренко-- 20211230
	Возврат ФлОтказ;
КонецФункции //СМГ_НайтиСоздатьПродажиПоТоварам(СкладКомпании,Авто,ТаблицаТоваров)

Функция СМГ_НайтиСоздатьРеализациюТоваров(СкладКомпании,Авто,МассивСтрокТоваров)
	
	ФлОтказ = Ложь; 
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваров.Ссылка КАК Реализация_Товаров,
		|	РеализацияТоваров.ДокументОснование,
		|	РеализацияТоваров.СкладКомпании
		|ИЗ
		|	Документ.РеализацияТоваров КАК РеализацияТоваров
		|ГДЕ
		|	РеализацияТоваров.ДокументОснование = &ДокументОснование
		|	И РеализацияТоваров.СкладКомпании = &СкладКомпании
		|	И РеализацияТоваров.НепроводнойДляДопОборудования = ИСТИНА";
	
 	Запрос.УстановитьПараметр("ДокументОснование", МассивСтрокТоваров[0].Регистратор.Ссылка);
	Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	
	ДокРТ = Запрос.Выполнить().Выгрузить();
	//Работы.ВыбратьСтроку();
	
	ФлНовый = Ложь;
	Если ДокРТ.Количество() = 0 Тогда
	    РТ = Документы.РеализацияТоваров.СоздатьДокумент();
		ФлНовый = Истина;
	Иначе
 	    РТ = ДокРТ[0].Реализация_Товаров.ПолучитьОбъект();
	КонецЕсли;
	
	//Бондаренко++ 20220523
	РТ.ОбработкаЗаполнения(Неопределено);
	//Бондаренко-- 20220523
 	
	Если ФлНовый Тогда                              
		
 		РТ.Дата = ТекущаяДата();
		//Бондаренко++ 20211230
		Попытка
		    РТ.Дата = МассивСтрокТоваров[0].Регистратор.Дата-600;
 		Исключение
 		КонецПопытки;		
		//Бондаренко-- 20211230
  		РТ.Автор = ПараметрыСеанса.Пользователь;
		
		//Бондаренко++ 20220308                                          
		//РТ.ДокументОснование = ЭтотОбъект.Ссылка; 		
 		//РТ.Контрагент = ЭтотОбъект.Организация.КонтрагентОрганизации;
		РТ.ДокументОснование = МассивСтрокТоваров[0].Регистратор.Ссылка; 
		РТ.Контрагент = МассивСтрокТоваров[0].Регистратор.Организация.КонтрагентОрганизации;
		//Бондаренко-- 20220308
		 
		РТ.СкладКомпании = СкладКомпании;
		РТ.Организация = СкладКомпании.Организация;
		РТ.ПодразделениеКомпании = СкладКомпании.Подразделение;
 		РТ.ДоговорВзаиморасчетов =  СМГ_НайтиСоздатьДоговорПерепродаж(РТ.Контрагент,РТ.Организация,РТ.ПодразделениеКомпании);  
  		РТ.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
 		РТ.ХозОперация = Справочники.ХозОперации.РеализацияТоваров;
		РТ.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		РТ.КурсДокумента = 1;
 		РТ.Комментарий = "Создан автоматически "+ТекущаяДата()+" пользователем "+ПараметрыСеанса.Пользователь+", при проведении документа "+ЭтотОбъект.Ссылка;
		РТ.НепроводнойДляДопОборудования=Истина;
   	
	КонецЕсли;
	
	//Бондаренко++ 20220308 
  	РТ.ДокументОснование = МассивСтрокТоваров[0].Регистратор.Ссылка;
	РТ.Контрагент = МассивСтрокТоваров[0].Регистратор.Организация.КонтрагентОрганизации;
	РТ.УстановитьНовыйНомер();  
	РТ.Комментарий = "Отредактирован автоматически "+ТекущаяДата()+" пользователем "+ПараметрыСеанса.Пользователь+", при проведении документа "+ЭтотОбъект.Ссылка;
  	РТ.Дата = МассивСтрокТоваров[0].Регистратор.Дата-600;
	
	Если Год(РТ.Дата) <> Год(МассивСтрокТоваров[0].Регистратор.Дата-600) Тогда
		РТ.УстановитьНовыйНомер();		
 	КонецЕсли;
 	//Бондаренко-- 20220308
	
  	РТ.ДоговорВзаиморасчетов =  СМГ_НайтиСоздатьДоговорПерепродаж(РТ.Контрагент,РТ.Организация,РТ.ПодразделениеКомпании);  
  	
	Если РТ.Товары.Количество() > 0 Тогда
		РТ.Товары.Очистить();	
	КонецЕсли;  
	
  	Для каждого СтрТоваров Из МассивСтрокТоваров Цикл
		
		НоваяСтрокаТоваров = РТ.Товары.Добавить();
  		НоваяСтрокаТоваров.Номенклатура = СтрТоваров.Номенклатура;
		НоваяСтрокаТоваров.Количество = СтрТоваров.КоличествоРасход;		
		НоваяСтрокаТоваров.КоличествоБазовое = СтрТоваров.КоличествоРасход;				
		НоваяСтрокаТоваров.Коэффициент = 1;
		НоваяСтрокаТоваров.ЕдиницаИзмерения = СтрТоваров.Номенклатура.ОсновнаяЕдиницаИзмерения;
		НоваяСтрокаТоваров.Сумма = СтрТоваров.СуммаУпрРасход;
		НоваяСтрокаТоваров.СуммаВсего = НоваяСтрокаТоваров.Сумма;
		НоваяСтрокаТоваров.СуммаНДС = Окр(НоваяСтрокаТоваров.Сумма/6,2);
		НоваяСтрокаТоваров.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
 		НоваяСтрокаТоваров.Цена = ?(НоваяСтрокаТоваров.Количество>0,НоваяСтрокаТоваров.СуммаВсего/НоваяСтрокаТоваров.Количество,1);
   		
	КонецЦикла;  
	
	//Форма = РТ.ПолучитьФорму("ФормаДокумента");
	//Если НЕ Форма.Открыта() Тогда
	//    Форма.ОткрытьМодально();
	//КонецЕсли;
 	
 	Попытка
		РТ.Записать(РежимЗаписиДокумента.Запись);        
 		Попытка
			РТ.Записать(РежимЗаписиДокумента.Проведение);
 		Исключение 
			ФлОтказ = Истина;	
 	 		#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+РТ+"' не удалось провести.",СтатусСообщения.ОченьВажное);
	  		#КонецЕсли 
 		КонецПопытки;
	Исключение
 		ФлОтказ = Истина;	
	 	#Если Клиент Тогда
 			Сообщить("ОШИБКА! Документ '"+РТ+"' не удалось записать.",СтатусСообщения.ОченьВажное);
	  	#КонецЕсли 
	КонецПопытки; 
	
	Если Не ФлОтказ Тогда
 		ФлОтказ = СМГ_НайтиСоздатьСФвыданный(РТ); 
 	КонецЕсли;
	
	Если Не ФлОтказ Тогда
		ФлОтказ = СМГ_НайтиСоздатьПоступлениеТоваров(РТ,МассивСтрокТоваров);	
 	КонецЕсли;
	
	Возврат ФлОтказ;
КонецФункции // СМГ_НайтиСоздатьРеализациюТоваров(СкладКомпании,Авто,МассивСтрокТоваров)

Функция СМГ_НайтиСоздатьПоступлениеТоваров(Источник,МассивСтрокТоваров)
	
	ФлОтказ = Ложь; 
 	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваров.Ссылка КАК Поступление_Товаров,
		|	ПоступлениеТоваров.ДокументОснование
 		|ИЗ
		|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
		|ГДЕ
		|	ПоступлениеТоваров.ДокументОснование = &ДокументОснование
 		|	И ПоступлениеТоваров.НепроводнойДляДопОборудования = ИСТИНА";
	
 	Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
 	
	ДокПТ = Запрос.Выполнить().Выгрузить();
	//Работы.ВыбратьСтроку();
	
	ФлНовый = Ложь;
	Если ДокПТ.Количество() = 0 Тогда
