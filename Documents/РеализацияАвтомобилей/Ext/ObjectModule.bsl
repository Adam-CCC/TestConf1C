//Бондаренко-- 20221112
Функция ПолучитьСуммуЗакупкиБУ(Автомобиль)
	
	СуммаЗакупкиБУ = 0;
	
	Если ЗначениеЗаполнено(Автомобиль) Тогда
		ЗапросАвтомобиль = Новый Запрос();
		ЗапросАвтомобиль.УстановитьПараметр("Автомобиль", Автомобиль); 
		СписокФормСобственности = Новый СписокЗначений;
		СписокФормСобственности.Добавить(Перечисления.ФормыСобственности.ЧастноеЛицо);
		СписокФормСобственности.Добавить(Перечисления.ФормыСобственности.Прочее);
		//Бондаренко++ 20260221
 		//Если Дата >= Дата(2024,4,1) И Дата < Дата(2024,8,1) Тогда			
		Если ( Дата >= Дата(2024,4,1) И Дата < Дата(2024,8,1) ) ИЛИ ПоследнимВладельцемАвтоБылФизик(Автомобиль) Тогда			
		//Бондаренко-- 20260221
			СписокФормСобственности.Добавить(Перечисления.ФормыСобственности.ЮридическоеЛицо);
			СписокФормСобственности.Добавить(Перечисления.ФормыСобственности.ЧастныйПредприниматель);
 		КонецЕсли;
	 	ЗапросАвтомобиль.УстановитьПараметр("ЧастноеЛицо", СписокФормСобственности);
		//Галактионов ++
		//Было++
		//ЗапросАвтомобиль.Текст = "ВЫБРАТЬ
		//                         |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Дата КАК ДатаПоступления,
		//                         |	ПоступлениеАвтомобилейАвтомобили.СуммаВсего КАК СуммаВсего
		//                         |ИЗ
		//                         |	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
		//                         |ГДЕ
		//                         |	ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен
		//                         |	И ПоступлениеАвтомобилейАвтомобили.АвтомобильБУ
		//                         |	И ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
		//                         |	И (ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.ФормаСобственности В (&ЧастноеЛицо)
		//                         |			ИЛИ ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма)
		//                         |
		//                         |УПОРЯДОЧИТЬ ПО
		//                         |	ДатаПоступления УБЫВ";
		//Стало++       
		ЗапросАвтомобиль.УстановитьПараметр("КонецПериода", ?(ЗначениеЗаполнено(Дата),Дата,ТекущаяДата()));
		// Холышевская ++ 24.08.2026 добавлен отбор по времени поступлений
		//ЗапросАвтомобиль.Текст = Модуль_ГВС.ПолучитьТекстЗапроса();
		ЗапросАвтомобиль.Текст = г_Функции.ПолучитьТекстЗапросаДляВычисленияСебестоимостиАвтомобиля();
		// Холышевская -- 24.08.2026
		//Галактионов --
		
		//Бондаренко++ 20240802
		//Добавлено в текст запроса
		//      "ИЛИ ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.НашаФирма"
		//Бондаренко-- 20240802
		
		Результат = ЗапросАвтомобиль.Выполнить().Выгрузить();
		Если Результат.Количество() > 0 Тогда                                     
			//Бондаренко++ 20240802
			//Если Результат[0].СтавкаНДС <> Справочники.СтавкиНДС.ОсновнаяСтавкаНДС Тогда
			//Бондаренко-- 20240518
				СуммаЗакупкиБУ =  Результат[0].Себестоимость;
			//Бондаренко++ 20240802	
 			//КонецЕсли;                 	
			//Бондаренко-- 20240518
			//Бондаренко++ 20240508	
		ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказНаАвтомобиль") Тогда
			Если ЗначениеЗаполнено(ДокументОснование.СебестоимостьАвтомобиля) Тогда
				СуммаЗакупкиБУ = ДокументОснование.СебестоимостьАвтомобиля;
			КонецЕсли;	
		КонецЕсли;
		//Бондаренко-- 20240508	
	КонецЕсли;
	
	Возврат СуммаЗакупкиБУ;
	
КонецФункции // ПолучитьСуммуЗакупкиБУ()
