////////// ФУНКЦИИ ДЛЯ ЗАПОЛНЕНИЯ ТАБЛИЦЫ Параметры расчета

Функция ПолучитьСписокНоменклатурыДляРасчета(ПодразделениеКомпании, СтруктураПараметров,Отладка,Протокол)
	
	 
	
	Состояние("Получение списка номенклатуры для расчета");
	ЗапросНоменклатуры 		 = Новый Запрос();
	ЗапросНоменклатуры.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	//При необходимости изменить запрос то найти и удалить кусок "И %ОтборНоменклатуры%", но не забыть потом вставить обратно!"
	ТекстЗапроса			 = "ВЫБРАТЬ
	            			   |	MAD_ПараметрыПоставщиков.Производитель,
	            			   |	MAD_ПараметрыПоставщиков.ПериодичностьЗаказов,
	            			   |	MAD_ПараметрыПоставщиков.СтандартныйСрокПоставки,
	            			   |	MAD_ПараметрыПоставщиков.ЗапасНаПревышениеСрокаПоставки,
	            			   |	MAD_ПараметрыПоставщиков.КоэффициентУдовлетворенияСпроса
	            			   |ПОМЕСТИТЬ ПараметрыПоставщиков
	            			   |ИЗ
	            			   |	РегистрСведений.MAD_ПараметрыПоставщиков КАК MAD_ПараметрыПоставщиков
	            			   |ГДЕ
	            			   |	MAD_ПараметрыПоставщиков.ПодразделениеКомпании = &ПодразделениеКомпании
	            			   |;
	            			   |
	            			   |////////////////////////////////////////////////////////////////////////////////
	            			   |ВЫБРАТЬ
	            			   |	ОстаткиТоваровКомпанииОбороты.Номенклатура,
	            			   |	ЕСТЬNULL(MAD_РасчетПараметровУправленияЗапасамиСрезПоследних.СтандартноеКоличество, 0) КАК СтандартноеКоличествоПрошлое,
	            			   |	ВЫБОР
	            			   |		КОГДА (ВЫРАЗИТЬ(РАЗНОСТЬДАТ(ОстаткиТоваровКомпанииОбороты.Номенклатура.Дата, &ДатаРасчета, ДЕНЬ) / 30 КАК ЧИСЛО(10, 0))) > 6
	            			   |			ТОГДА 6
	            			   |		ИНАЧЕ ВЫРАЗИТЬ(РАЗНОСТЬДАТ(ОстаткиТоваровКомпанииОбороты.Номенклатура.Дата, &ДатаРасчета, ДЕНЬ) / 30 КАК ЧИСЛО(10, 0))
	            			   |	КОНЕЦ КАК КоличествоПериодовРасчетаПоПозиции,
	            			   |	ЕСТЬNULL(ПараметрыПоставщиков.ПериодичностьЗаказов, &ПериодичностьЗаказов) КАК ПериодичностьЗаказов,
	            			   |	ЕСТЬNULL(ПараметрыПоставщиков.СтандартныйСрокПоставки, &СтандартныйСрокПоставки) КАК СтандартныйСрокПоставки,
	            			   |	ЕСТЬNULL(ПараметрыПоставщиков.ЗапасНаПревышениеСрокаПоставки, &ЗапасНаПревышениеСрокаПоставки) КАК ЗапасНаПревышениеСрокаПоставки,
	            			   |	ЕСТЬNULL(ПараметрыПоставщиков.КоэффициентУдовлетворенияСпроса, &КоэффициентУдовлетворенияСпроса) КАК КоэффициентУдовлетворенияСпроса,
	            			   |	ЕСТЬNULL(ВложенныйЗапросДатаПоследнегоСпроса.ДатаПоследнегоСпроса, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоследнегоСпроса,
	            			   |	MAD_РасчетПараметровУправленияЗапасамиСрезПоследних.КлассКонтроля КАК КлассКонтроляПредыдущий
	            			   |ПОМЕСТИТЬ НоменклатураДляРасчета
	            			   |ИЗ
	            			   |	РегистрНакопления.ОстаткиТоваровКомпании.Обороты(
	            			   |			,
	            			   |			,
	            			   |			,
	            			   |			СкладКомпании.Подразделение В ИЕРАРХИИ (&ПодразделениеКомпании)
	            			   |				И &ОтборНоменклатуры) КАК ОстаткиТоваровКомпанииОбороты
	            			   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.MAD_РасчетПараметровУправленияЗапасами.СрезПоследних(&ДатаICCПрош, ПодразделениеКомпании = &ПодразделениеКомпании) КАК MAD_РасчетПараметровУправленияЗапасамиСрезПоследних
	            			   |		ПО ОстаткиТоваровКомпанииОбороты.Номенклатура = MAD_РасчетПараметровУправленияЗапасамиСрезПоследних.Номенклатура
	            			   |		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыПоставщиков КАК ПараметрыПоставщиков
	            			   |		ПО ОстаткиТоваровКомпанииОбороты.Номенклатура.Производитель = ПараметрыПоставщиков.Производитель
	            			   |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	            			   |			Продажи.Номенклатура КАК Номенклатура,
	            			   |			МАКСИМУМ(Продажи.Период) КАК ДатаПоследнегоСпроса
	            			   |		ИЗ
	            			   |			РегистрНакопления.Продажи КАК Продажи
	            			   |		ГДЕ
	            			   |			Продажи.ПодразделениеКомпании В ИЕРАРХИИ(&ПодразделениеКомпании)
	            			   |		
	            			   |		СГРУППИРОВАТЬ ПО
	            			   |			Продажи.Номенклатура) КАК ВложенныйЗапросДатаПоследнегоСпроса
	            			   |		ПО ОстаткиТоваровКомпанииОбороты.Номенклатура = ВложенныйЗапросДатаПоследнегоСпроса.Номенклатура
	            			   |ГДЕ
	            			   |	ОстаткиТоваровКомпанииОбороты.КоличествоПриход <> 0
	            			   |;
	            			   |
	            			   |////////////////////////////////////////////////////////////////////////////////
	            			   |ВЫБРАТЬ
	            			   |	НоменклатураДляРасчета.Номенклатура,
	            			   |	НоменклатураДляРасчета.СтандартноеКоличествоПрошлое,
	            			   |	НоменклатураДляРасчета.КоличествоПериодовРасчетаПоПозиции,
	            			   |	ЕСТЬNULL(ЕСТЬNULL(SCCНоменклатура.СпециальныКлассКонтроля, SCCСкладскойПризнак.СпециальныКлассКонтроля), ЗНАЧЕНИЕ(Справочник.MAD_СпециальныеКлассыКонтроля.ПустаяСсылка)) КАК СпециальныйКлассКонтроля,
	            			   |	НоменклатураДляРасчета.ПериодичностьЗаказов,
	            			   |	НоменклатураДляРасчета.СтандартныйСрокПоставки,
	            			   |	НоменклатураДляРасчета.ЗапасНаПревышениеСрокаПоставки,
	            			   |	НоменклатураДляРасчета.КоэффициентУдовлетворенияСпроса,
	            			   |	НоменклатураДляРасчета.ДатаПоследнегоСпроса,
	            			   |	НоменклатураДляРасчета.КлассКонтроляПредыдущий
	            			   |ПОМЕСТИТЬ НоменклатураДляРАсчетаСоСпециальнымиКлассамиКонтроля
	            			   |ИЗ
	            			   |	НоменклатураДляРасчета КАК НоменклатураДляРасчета
	            			   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.MAD_НазначениеСпециальныхКлассовКонтроля.СрезПоследних(
	            			   |				&ДатаРасчета,
	            			   |				ПодразделениеКомпании = &ПодразделениеКомпании
	            			   |					И (ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	            			   |						ИЛИ ДатаОкончания >= &ДатаРасчета)) КАК SCCНоменклатура
	            			   |		ПО НоменклатураДляРасчета.Номенклатура = SCCНоменклатура.Показатель
	            			   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.MAD_НазначениеСпециальныхКлассовКонтроля.СрезПоследних(
	            			   |				&ДатаРасчета,
	            			   |				ПодразделениеКомпании = &ПОдразделениеКомпании
	            			   |					И (ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	            			   |						ИЛИ ДатаОкончания >= &ДатаРасчета)) КАК SCCСкладскойПризнак
	            			   |		ПО НоменклатураДляРасчета.Номенклатура.СкладскойПризнак = SCCСкладскойПризнак.Показатель
	            			   |;
	            			   |
	            			   |////////////////////////////////////////////////////////////////////////////////
	            			   |ВЫБРАТЬ
	            			   |	НоменклатураДляРасчета.Номенклатура,
	            			   |	НоменклатураДляРасчета.СтандартноеКоличествоПрошлое,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА ПродажиОбороты.Период МЕЖДУ &ДатаНачала1 И &ДатаОкончания1
	            			   |				ТОГДА ПродажиОбороты.КоличествоОборот
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК Спрос1,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА ПродажиОбороты.Период МЕЖДУ &ДатаНачала2 И &ДатаОкончания2
	            			   |				ТОГДА ПродажиОбороты.КоличествоОборот
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК Спрос2,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА ПродажиОбороты.Период МЕЖДУ &ДатаНачала3 И &ДатаОкончания3
	            			   |				ТОГДА ПродажиОбороты.КоличествоОборот
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК Спрос3,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА ПродажиОбороты.Период МЕЖДУ &ДатаНачала4 И &ДатаОкончания4
	            			   |				ТОГДА ПродажиОбороты.КоличествоОборот
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК Спрос4,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА ПродажиОбороты.Период МЕЖДУ &ДатаНачала5 И &ДатаОкончания5
	            			   |				ТОГДА ПродажиОбороты.КоличествоОборот
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК Спрос5,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА ПродажиОбороты.Период МЕЖДУ &ДатаНачала6 И &ДатаОкончания6
	            			   |				ТОГДА ПродажиОбороты.КоличествоОборот
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК Спрос6
	            			   |ПОМЕСТИТЬ СпросЗаПериод
	            			   |ИЗ
	            			   |	НоменклатураДляРасчета КАК НоменклатураДляРасчета
	            			   |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты(
	            			   |				&ДатаНачала1,
	            			   |				&ДатаОкончания6,
	            			   |				День,
	            			   |				ПодразделениеКомпании В ИЕРАРХИИ (&ПодразделениеКомпании)
	            			   |					И ((НЕ Покупатель В ИЕРАРХИИ (&НашиКомпании)
	            			   |						ИЛИ ХозОперация = ЗНАЧЕНИЕ(Справочник.ХозОперации.КомплектацияАвтомобиля))
	            			   |						И НЕ Покупатель.Родитель = &ОптовыеКомпании)
	            			   |					И НЕ Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)) КАК ПродажиОбороты
	            			   |		ПО НоменклатураДляРасчета.Номенклатура = ПродажиОбороты.Номенклатура
	            			   |
	            			   |СГРУППИРОВАТЬ ПО
	            			   |	НоменклатураДляРасчета.Номенклатура,
	            			   |	НоменклатураДляРасчета.СтандартноеКоличествоПрошлое
	            			   |;
	            			   |
	            			   |////////////////////////////////////////////////////////////////////////////////
	            			   |ВЫБРАТЬ
	            			   |	НоменклатураДляРасчета.Номенклатура,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА &УчитыватьЗЧВПроизводстве
	            			   |				ТОГДА ВЫБОР
	            			   |						КОГДА ТоварыВПроизводствеОстатки.ЗаказНаряд.Дата МЕЖДУ &ДатаНачала1 И &ДатаОкончания1
	            			   |							ТОГДА ТоварыВПроизводствеОстатки.КоличествоОстаток
	            			   |						ИНАЧЕ 0
	            			   |					КОНЕЦ
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК ДопСпрос1,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА &УчитыватьЗЧВПроизводстве
	            			   |				ТОГДА ВЫБОР
	            			   |						КОГДА ТоварыВПроизводствеОстатки.ЗаказНаряд.Дата МЕЖДУ &ДатаНачала2 И &ДатаОкончания2
	            			   |							ТОГДА ТоварыВПроизводствеОстатки.КоличествоОстаток
	            			   |						ИНАЧЕ 0
	            			   |					КОНЕЦ
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК ДопСпрос2,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА &УчитыватьЗЧВПроизводстве
	            			   |				ТОГДА ВЫБОР
	            			   |						КОГДА ТоварыВПроизводствеОстатки.ЗаказНаряд.Дата МЕЖДУ &ДатаНачала3 И &ДатаОкончания3
	            			   |							ТОГДА ТоварыВПроизводствеОстатки.КоличествоОстаток
	            			   |						ИНАЧЕ 0
	            			   |					КОНЕЦ
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК ДопСпрос3,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА &УчитыватьЗЧВПроизводстве
	            			   |				ТОГДА ВЫБОР
	            			   |						КОГДА ТоварыВПроизводствеОстатки.ЗаказНаряд.Дата МЕЖДУ &ДатаНачала4 И &ДатаОкончания4
	            			   |							ТОГДА ТоварыВПроизводствеОстатки.КоличествоОстаток
	            			   |						ИНАЧЕ 0
	            			   |					КОНЕЦ
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК ДопСпрос4,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА &УчитыватьЗЧВПроизводстве
	            			   |				ТОГДА ВЫБОР
	            			   |						КОГДА ТоварыВПроизводствеОстатки.ЗаказНаряд.Дата МЕЖДУ &ДатаНачала5 И &ДатаОкончания5
	            			   |							ТОГДА ТоварыВПроизводствеОстатки.КоличествоОстаток
	            			   |						ИНАЧЕ 0
	            			   |					КОНЕЦ
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК ДопСпрос5,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА &УчитыватьЗЧВПроизводстве
	            			   |				ТОГДА ВЫБОР
	            			   |						КОГДА ТоварыВПроизводствеОстатки.ЗаказНаряд.Дата МЕЖДУ &ДатаНачала6 И &ДатаОкончания6
	            			   |							ТОГДА ТоварыВПроизводствеОстатки.КоличествоОстаток
	            			   |						ИНАЧЕ 0
	            			   |					КОНЕЦ
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК ДопСпрос6
	            			   |ПОМЕСТИТЬ ЗЧВПроизводстве
	            			   |ИЗ
	            			   |	НоменклатураДляРасчета КАК НоменклатураДляРасчета
	            			   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВПроизводстве.Остатки(
	            			   |				&ДатаОкончания6,
	            			   |				Цех.Подразделение В ИЕРАРХИИ (&ПодразделениеКомпании)
	            			   |					И (ЗаказНаряд.Дата МЕЖДУ &ДатаНачала1 И &ДатаОкончания6)) КАК ТоварыВПроизводствеОстатки
	            			   |		ПО НоменклатураДляРасчета.Номенклатура = ТоварыВПроизводствеОстатки.Номенклатура
	            			   |
	            			   |СГРУППИРОВАТЬ ПО
	            			   |	НоменклатураДляРасчета.Номенклатура
	            			   |;
	            			   |
	            			   |////////////////////////////////////////////////////////////////////////////////
	            			   |ВЫБРАТЬ
	            			   |	НоменклатураДляРасчета.Номенклатура,
	            			   |	НоменклатураДляРасчета.СтандартноеКоличествоПрошлое,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА УпущенныйСпрос.Период МЕЖДУ &ДатаНачала1 И &ДатаОкончания1
	            			   |				ТОГДА УпущенныйСпрос.Количество
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК УпущенныйСпрос1,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА УпущенныйСпрос.Период МЕЖДУ &ДатаНачала2 И &ДатаОкончания2
	            			   |				ТОГДА УпущенныйСпрос.Количество
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК УпущенныйСпрос2,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА УпущенныйСпрос.Период МЕЖДУ &ДатаНачала3 И &ДатаОкончания3
	            			   |				ТОГДА УпущенныйСпрос.Количество
	            			   |			ИНАЧЕ 0
	            			   |		КОНЕЦ) КАК УпущенныйСпрос3,
	            			   |	СУММА(ВЫБОР
	            			   |			КОГДА УпущенныйСпрос.Период МЕЖДУ &ДатаНачала4 И &ДатаОкончания4
