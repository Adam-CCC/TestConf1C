Процедура СМГ_УдалитьДублиСтрок() Экспорт
	
	ТЗ = ПараметрыРасчета.Выгрузить();
	ТЗ.Колонки.Добавить("Кол");
	Для каждого Стр Из ТЗ Цикл
	    Стр.Кол = 1;
	КонецЦикла;
	
	ТЗ.Свернуть("Номенклатура","Кол");
	СЗ = Новый СписокЗначений;
	
	Для каждого Стр Из ТЗ Цикл
		Если Стр.Кол < 2 Тогда
			Продолжить;	
		КонецЕсли;
		СЗ.Добавить(Стр.Номенклатура);
	КонецЦикла;
	
	Отбор = Новый Структура(); 
	
	Для каждого ЭлСписка Из СЗ Цикл
		
		Отбор.Очистить();
		Отбор.Вставить("Номенклатура", ЭлСписка.Значение);
		
		Строки = ПараметрыРасчета.НайтиСтроки(Отбор);
 		Если Строки.Количество() > 1 Тогда
			Для каждого НайденнаяСтрока Из Строки Цикл
				ПараметрыРасчета.Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЕсли;
		
		Строки = УстановкаСпециальныхКлассовКонтроляНаПозицию.НайтиСтроки(Отбор);
		Если Строки.Количество() > 1 Тогда
			Для каждого НайденнаяСтрока Из Строки Цикл
				УстановкаСпециальныхКлассовКонтроляНаПозицию.Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЕсли;
		
		Строки = СезонныеФакторы.НайтиСтроки(Отбор);
		Если Строки.Количество() > 1 Тогда
			Для каждого НайденнаяСтрока Из Строки Цикл
				СезонныеФакторы.Удалить(НайденнаяСтрока);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры  //УдалитьДублиСтрок()
