		//Бондаренко 20160523 --
		
		СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос = Окр((СуммаСпрос + СуммаУпущенныйСпрос*КоэффициентУчетаУпущенногоСпроса)/КоличествоПериодов,2);
 		СтрокаТаблицыНоменклатуры.ЗапасНаПревышениеСпроса = Окр(?(СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос <>0 ,((ПроцентУдовлетворенияСпроса/100)*МаксимальныйСпрос - СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос)/СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос, 0),2);
		СтрокаТаблицыНоменклатуры.ЗапасНаПревышениеСпроса = ?(СтрокаТаблицыНоменклатуры.ЗапасНаПревышениеСпроса<0,0,СтрокаТаблицыНоменклатуры.ЗапасНаПревышениеСпроса);
		Если Протокол Тогда
		    Сообщить("Среднемесячный спрос = "+СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос+"; КоэффициентУчетаУпущенногоСпроса = "+КоэффициентУчетаУпущенногоСпроса);
			Сообщить("Формула => СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос = Окр((СуммаСпрос + СуммаУпущенныйСпрос*КоэффициентУчетаУпущенногоСпроса)/КоличествоПериодов,2)");
			Сообщить("Запас на превышение спроса = "+СтрокаТаблицыНоменклатуры.ЗапасНаПревышениеСпроса+"; ПроцентУдовлетворенияСпроса = "+ПроцентУдовлетворенияСпроса);
			Сообщить("Формула => СтрокаТаблицыНоменклатуры.ЗапасНаПревышениеСпроса = Окр(?(СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос <>0 ,((ПроцентУдовлетворенияСпроса/100)*МаксимальныйСпрос - СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос)/СтрокаТаблицыНоменклатуры.СреднемесячныйСпрос, 0),2)");
			Сообщить("......................................................................................");
		КонецЕсли; 
		 
	КонецЦикла;
 	
	//Бондаренко 20151230 ++
	Если Отладка Тогда
		ТаблицаНоменклатурыИСпроса.ВыбратьСтроку("Таблица номенклатуры и спроса ПОСЛЕ пересчета. Строк = "+ТаблицаНоменклатурыИСпроса.Количество());
	КонецЕсли; 
 	//Бондаренко 20151230 --
  	
	Возврат ТаблицаНоменклатурыИСпроса;
КонецФункции

Функция РассчитатьГраничныеЗначения(ТаблицаНоменклатуры,Отладка,Протокол)
	Состояние("Назначение классов контроля");
	ТаблицаНоменклатуры.Сортировать("СреднемесячныйСпрос ВОЗР");
	
	ОбщееКоличествоОбращений = ТаблицаНоменклатуры.Итог("СреднемесячныйСпрос");
	
	//Бондаренко 20160225 ++
	Если Отладка Тогда
		ТаблицаНоменклатуры.ВыбратьСтроку("Для расчета Класса Контроля. Итог по MAD (среднемесячному спросу) = "+ОбщееКоличествоОбращений);			
	КонецЕсли;	
 	//Бондаренко 20160225 --	
	
	Если ОбщееКоличествоОбращений = 0 Тогда
		Для Каждого СтрокаТаблицыРасчетаКК Из ТаблицаНоменклатуры Цикл
			СтрокаТаблицыРасчетаКК.КлассКонтроля = Справочники.MAD_КлассыКонтроля.D1;
		КонецЦикла;
	Иначе
		КумулятивнаяДоля = 0;
		
		Если Протокол Тогда
			Сообщить("Формула => КумулятивнаяДоля = КумулятивнаяДоля + ОКР(СтрокаТаблицыРасчетаКК.СреднемесячныйСпрос*100/ОбщееКоличествоОбращений,4)");
		КонецЕсли; 	

		ёё = 0;
		
		ВсегоСтрок = ТаблицаНоменклатуры.Количество();
		
		Для Каждого СтрокаТаблицыРасчетаКК Из ТаблицаНоменклатуры Цикл
			
			ОбработкаПрерыванияПользователя();
			
			ёё = ёё + 1;
			Состояние("Расчет строки "+СокрЛП(ёё)+" из "+ВсегоСтрок);
 		
			КумулятивнаяДоля = КумулятивнаяДоля + ОКР(СтрокаТаблицыРасчетаКК.СреднемесячныйСпрос*100/ОбщееКоличествоОбращений,4);
 			КумулятивнаяДоля = ?(КумулятивнаяДоля > 100, 100, КумулятивнаяДоля);
			
			Если Протокол Тогда
 			  Сообщить("Среднемесячный cпрос = "+СтрокаТаблицыРасчетаКК.СреднемесячныйСпрос+"; ОбщееКоличествоОбращений = "+ОбщееКоличествоОбращений+"; КумулятивнаяДоля = "+КумулятивнаяДоля);
			КонецЕсли; 

			Если СтрокаТаблицыРасчетаКК.ДнейБезДвижения >= ПериодDeadStock Тогда
				СтрокаТаблицыРасчетаКК.КлассКонтроля = Справочники.MAD_КлассыКонтроля.D1;
			Иначе
				СтрокаТаблицыРасчетаКК.КлассКонтроля = ПолучитьКлассКонтроля(КумулятивнаяДоля,Протокол);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ТаблицаНоменклатуры.Сортировать("КлассКонтроля ВОЗР");
	
	Возврат ТаблицаНоменклатуры;
КонецФункции
	
Функция ПолучитьКлассКонтроля(Доля,Протокол);
	КлассКонтроля = Неопределено;			
	Для Каждого СтрокаГраницыКлассов Из ГраницыКлассовКонтроля Цикл
		Если Доля >= СтрокаГраницыКлассов.ПроцентОт И Доля <= СтрокаГраницыКлассов.ПроцентДо Тогда
			КлассКонтроля = СтрокаГраницыКлассов.КлассКонтроля;
			Если Протокол Тогда
			    Сообщить("Т.к. Доля = "+Доля+" находится между "+СтрокаГраницыКлассов.ПроцентОт+" и "+СтрокаГраницыКлассов.ПроцентДо+" то Класс контроля = "+КлассКонтроля);
 			КонецЕсли; 
		КонецЕслИ;
	КонецЦикла;
	
	Возврат ?(КлассКонтроля = Неопределено, Справочники.MAD_КлассыКонтроля.D1, КлассКонтроля);
КонецФункции
					
Функция РАссчитатьОптимальноеКоличество(ТаблицаНоменклатуры,Отладка,Протокол)
	Состояние("Идёт расчет оптимального запаса склада...");
	ёё = 0;
	ВсегоСтрок = ТаблицаНоменклатуры.Количество(); 
	Для Каждого СтрокаНоменклатуры Из ТаблицаНоменклатуры Цикл
		ОбработкаПрерыванияПользователя();
		ёё = ёё + 1;
		Состояние("Расчет строки "+СокрЛП(ёё)+" из "+ВсегоСтрок);
		СтрокаНоменклатуры.СтандартноеКоличествоРасчетное = ?(СтрокаНоменклатуры.СреднемесячныйСпрос<=ГраницаНеСкладскихПозиций, 0, ОКР(СтрокаНоменклатуры.СреднемесячныйСпрос*(СтрокаНоменклатуры.ПериодичностьЗаказов + СтрокаНоменклатуры.СтандартныйСрокПоставки + СтрокаНоменклатуры.ЗапасНаПревышениеСрокаПоставки + СтрокаНоменклатуры.ЗапасНаПревышениеСпроса),0));
		Если Протокол Тогда
		    Сообщить("Формула => СтрокаНоменклатуры.СтандартноеКоличествоРасчетное = ?(СтрокаНоменклатуры.СреднемесячныйСпрос<=ГраницаНеСкладскихПозиций, 0, ОКР(СтрокаНоменклатуры.СреднемесячныйСпрос*(СтрокаНоменклатуры.ПериодичностьЗаказов + СтрокаНоменклатуры.СтандартныйСрокПоставки + СтрокаНоменклатуры.ЗапасНаПревышениеСрокаПоставки + СтрокаНоменклатуры.ЗапасНаПревышениеСпроса),0))");
			Сообщить("Среднемесячный cпрос = "+СтрокаНоменклатуры.СреднемесячныйСпрос+" ГраницаНеСкладскихПозиций = "+ГраницаНеСкладскихПозиций+" Периодичность заказов = " + СтрокаНоменклатуры.ПериодичностьЗаказов + " Стандартный cрок поставки = "+СтрокаНоменклатуры.СтандартныйСрокПоставки + "; Запас на превышение срока поставки = "+СтрокаНоменклатуры.ЗапасНаПревышениеСрокаПоставки+"; Запас на превышение спроса = "+СтрокаНоменклатуры.ЗапасНаПревышениеСпроса);
 		КонецЕсли; 
		//Если нужно, применим свойства специального класса контроля
		Если СтрокаНоменклатуры.СпециальныйКлассКонтроля.НеСкладскаяПозиция Тогда
			СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = 0;
			Если Протокол Тогда
				Сообщить("Т.к. СтрокаНоменклатуры.СпециальныйКлассКонтроля.НеСкладскаяПозиция = "+СтрокаНоменклатуры.СпециальныйКлассКонтроля.НеСкладскаяПозиция+" то Стандартное количество итоговое = "+СтрокаНоменклатуры.СтандартноеКоличествоИтоговое);
			КонецЕсли;	
		ИначеЕсли СтрокаНоменклатуры.СпециальныйКлассКонтроля.РучноеСтандартноеКоличество Тогда
			СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = СтрокаНоменклатуры.СтандартноеКоличествоПрошлое;
			Если Протокол Тогда
				Сообщить("Т.к. Ручное cтандартное количество = "+СтрокаНоменклатуры.СпециальныйКлассКонтроля.РучноеСтандартноеКоличество+" то Стандартное количество итоговое = Стандартное количество прошлое: "+СтрокаНоменклатуры.СтандартноеКоличествоПрошлое);
			КонецЕсли;	
		ИначеЕсли СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменитьСтандартноеКоличество Тогда
			Если Протокол Тогда
				Сообщить("Т.к. СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменитьСтандартноеКоличество = "+СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменитьСтандартноеКоличество);
			КонецЕсли;		
			Если СтрокаНоменклатуры.СпециальныйКлассКонтроля.ТипИзмененияСтандартногоКоличества = "Абсолютный" Тогда
				СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменениеСтандартногоКоличества;
				Если Протокол Тогда 
					Сообщить("Т.к. СтрокаНоменклатуры.СпециальныйКлассКонтроля.ТипИзмененияСтандартногоКоличества = 'Абсолютный')"); 
					Сообщить("то по формуле: СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменениеСтандартногоКоличества");
					Сообщить(" Стандартное количество итоговое "+СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменениеСтандартногоКоличества);
				КонецЕсли;		
 			Иначе
				Выполнить("СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = СтрокаНоменклатуры.СтандартноеКоличествоРасчетное"+ СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменениеСтандартногоКоличества);
				Если Протокол Тогда
				    Сообщить("то по формуле:  Выполнить(СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = СтрокаНоменклатуры.СтандартноеКоличествоРасчетное + СтрокаНоменклатуры.СпециальныйКлассКонтроля.ИзменениеСтандартногоКоличества)");
					Сообщить("Вычисляем Стандартное количество итоговое = "+СтрокаНоменклатуры.СтандартноеКоличествоИтоговое);
 				КонецЕсли; 
			КонецЕсли;
		Иначе
 			СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = СтрокаНоменклатуры.СтандартноеКоличествоРасчетное;
			Если Протокол Тогда
				Сообщить("Т.к. СтрокаНоменклатуры.СпециальныйКлассКонтроля.НеСкладскаяПозиция = "+СтрокаНоменклатуры.СпециальныйКлассКонтроля.НеСкладскаяПозиция);
			    Сообщить("то по формуле:  СтрокаНоменклатуры.СтандартноеКоличествоИтоговое = СтрокаНоменклатуры.СтандартноеКоличествоРасчетное");
				Сообщить("Вычисляем Стандартное количество итоговое = "+СтрокаНоменклатуры.СтандартноеКоличествоИтоговое);
 			КонецЕсли; 
 		КонецЕсли;
	КонецЦикла;
	Возврат ТаблицаНоменклатуры;
КонецФункции

Процедура ЗаполнитьТаблицуИРасчитать(СтруктураПараметров,Отладка,Протокол) Экспорт
	ТаблицаНоменклатуры = ПолучитьСписокНоменклатурыДляРасчета(ПодразделениеКомпании, СтруктураПараметров,Отладка,Протокол);
	ТаблицаНоменклатуры = РассчитатьГраничныеЗначения(ТаблицаНоменклатуры,Отладка,Протокол);
	ТаблицаНоменклатуры = РАссчитатьОптимальноеКоличество(ТаблицаНоменклатуры,Отладка,Протокол);
 	ПараметрыРасчета.Загрузить(ТаблицаНоменклатуры);
	
	//А теперь посчитаем сезонные факторы
	//Бондаренко++ 20190327
	//РассчитатьСезонныйФактор();
	Если ФлагУчетаСезонности Тогда
		РассчитатьСезонныйФактор();
	Иначе
		СезонныеФакторы.Очистить();
 	КонецЕсли; 
 	//Бондаренко-- 20190327
КонецПроцедуры

