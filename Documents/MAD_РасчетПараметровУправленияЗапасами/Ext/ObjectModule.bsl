	                               |
	                               |СГРУППИРОВАТЬ ПО
	                               |	ПодходящаяНоменклатура.Ссылка";
	ЗапросСезонногоФактора.Выполнить();
	
	ЗапросСезонногоФактора.Текст = "ВЫБРАТЬ
	                               |	ПодходящаяНоменклатура.Ссылка КАК Номенклатура,
	                               |	СУММА(ВсеПродажиГодНазад.Количество) КАК ПродажиЗаМесяцГодНазад,
	                               |	СУММА(ВсеПродажи2ГодаНазад.Количество) КАК ПродажиЗаМесяц2ГодаНазад
	                               |ПОМЕСТИТЬ СуммаЗаПериод
	                               |ИЗ
	                               |	ПодходящаяНоменклатура КАК ПодходящаяНоменклатура
	                               |		ЛЕВОЕ СОЕДИНЕНИЕ ВсеПродажи КАК ВсеПродажиГодНазад
	                               |		ПО ПодходящаяНоменклатура.Ссылка = ВсеПродажиГодНазад.Номенклатура
	                               |			И (ВсеПродажиГодНазад.Период = ДОБАВИТЬКДАТЕ(&ПериодРасчета, МЕСЯЦ, -12))
	                               |		ЛЕВОЕ СОЕДИНЕНИЕ ВсеПродажи КАК ВсеПродажи2ГодаНазад
	                               |		ПО ПодходящаяНоменклатура.Ссылка = ВсеПродажи2ГодаНазад.Номенклатура
	                               |			И (ВсеПродажи2ГодаНазад.Период = ДОБАВИТЬКДАТЕ(&ПериодРасчета, МЕСЯЦ, -24))
	                               |
	                               |СГРУППИРОВАТЬ ПО
	                               |	ПодходящаяНоменклатура.Ссылка
	                               |;
	                               |
	                               |////////////////////////////////////////////////////////////////////////////////
	                               |ВЫБРАТЬ
	                               |	СуммаЗаПериод.Номенклатура КАК Номенклатура,
	                               |	&ПериодРасчета КАК МесяцРасчета,
	                               |	ВЫБОР
	                               |		КОГДА ЕСТЬNULL(ИтоговыеПродажиПоГодам.ПродажиГодНазад, 0) <> 0
	                               |			ТОГДА ЕСТЬNULL(СуммаЗаПериод.ПродажиЗаМесяцГодНазад, 0) / (ИтоговыеПродажиПоГодам.ПродажиГодНазад / 12)
	                               |		ИНАЧЕ 0
	                               |	КОНЕЦ КАК SFГодНазад,
	                               |	ВЫБОР
	                               |		КОГДА ЕСТЬNULL(ИтоговыеПродажиПоГодам.Продажи2ГодаНазад, 0) <> 0
	                               |			ТОГДА ЕСТЬNULL(СуммаЗаПериод.ПродажиЗаМесяц2ГодаНазад, 0) / (ИтоговыеПродажиПоГодам.Продажи2ГодаНазад / 12)
	                               |		ИНАЧЕ 0
	                               |	КОНЕЦ КАК SF2ГодаНазад,
	                               |	(ВЫБОР
	                               |		КОГДА ЕСТЬNULL(ИтоговыеПродажиПоГодам.ПродажиГодНазад, 0) <> 0
	                               |			ТОГДА ЕСТЬNULL(СуммаЗаПериод.ПродажиЗаМесяцГодНазад, 0) / (ИтоговыеПродажиПоГодам.ПродажиГодНазад / 12)
	                               |		ИНАЧЕ 0
	                               |	КОНЕЦ + ВЫБОР
	                               |		КОГДА ЕСТЬNULL(ИтоговыеПродажиПоГодам.Продажи2ГодаНазад, 0) <> 0
	                               |			ТОГДА ЕСТЬNULL(СуммаЗаПериод.ПродажиЗаМесяц2ГодаНазад, 0) / (ИтоговыеПродажиПоГодам.Продажи2ГодаНазад / 12)
	                               |		ИНАЧЕ 0
	                               |	КОНЕЦ) / 2 КАК Значение,
								   |	ложь КАК Искусственный
	                               |ИЗ
	                               |	СуммаЗаПериод КАК СуммаЗаПериод
	                               |		ЛЕВОЕ СОЕДИНЕНИЕ ИтоговыеПродажиПоГодам КАК ИтоговыеПродажиПоГодам
	                               |		ПО СуммаЗаПериод.Номенклатура = ИтоговыеПродажиПоГодам.Номенклатура
	                               |;
	                               |
	                               |////////////////////////////////////////////////////////////////////////////////
	                               |УНИЧТОЖИТЬ СуммаЗаПериод";
								   
	Для СЧ = 0 ПО 5 Цикл
		ЗапросСезонногоФактора.УстановитьПараметр("ПериодРасчета", ДобавитьМесяц(НачалоМесяца(ДатаРасчета), СЧ));
		
		ТаблицаСезонныхФакторов = ЗапросСезонногоФактора.Выполнить().Выгрузить();
		Для Каждого СтрокаСезонногоФактора Из ТаблицаСезонныхФакторов Цикл
			СтрокаТаблицыСФ = СезонныеФакторы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыСФ, СтрокаСезонногоФактора);
		КонецЦикла;
	КонецЦикла;
	
	//А теперь необходимо заполнить искусственный спрос, для значений, по которым не накопилось еще 2 года спроса
	ЗапросНоменклатурыМоложе2Лет = Новый Запрос();
	ЗапросНоменклатурыМоложе2Лет.Текст = "ВЫБРАТЬ
	                                     |	Номенклатура.Ссылка КАК Номенклатура
	                                     |ИЗ
	                                     |	Справочник.Номенклатура КАК Номенклатура
	                                     |ГДЕ
	                                     |	Номенклатура.Ссылка В(&ПереченьНоменклатурыДляПроверки)
	                                     |	И РАЗНОСТЬДАТ(Номенклатура.Дата, &ДатаРасчета, МЕСЯЦ) <= 24";
	ЗапросНоменклатурыМоложе2Лет.УстановитьПараметр("ПереченьНоменклатурыДляПроверки", НомеклатураДляРасчета);
	ЗапросНоменклатурыМоложе2Лет.УстановитьПараметр("ДатаРасчета", НачалоМесяца(ДатаРасчета));
	
	ВыборкаНоменклатурыМоложе2Лет = ЗапросНоменклатурыМоложе2Лет.Выполнить().Выбрать();
	Пока ВыборкаНоменклатурыМоложе2Лет.Следующий() Цикл
		Для СЧ = 0 ПО 5 Цикл
			СтрокаТаблицыСФ = СезонныеФакторы.Добавить();
			СтрокаТаблицыСФ.Номенклатура = ВыборкаНоменклатурыМоложе2Лет.Номенклатура;
			СтрокаТаблицыСФ.МесяцРасчета = ДобавитьМесяц(НачалоМесяца(ДатаРасчета), СЧ);
			СтрокаТаблицыСФ.Значение = 1;
			СтрокаТаблицыСФ.Искусственный = истина;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

