Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	РегистрДвижения = Движения.MAD_РасчетПараметровУправленияЗапасами;
	РегистрДвижения.Очистить();
	Для Каждого СтрокаНоменклатуры Из ПараметрыРасчета Цикл
		СтрокаРегистра = РегистрДвижения.Добавить();
		СтрокаРегистра.Регистратор = Ссылка;
		СтрокаРегистра.Период = ДатаРасчета;
		СтрокаРегистра.ПодразделениеКомпании = ПодразделениеКомпанииДляРасчета;
		СтрокаРегистра.Номенклатура = СтрокаНоменклатуры.Номенклатура;
		СтрокаРегистра.СреднемесячныйСпрос = СтрокаНоменклатуры.СреднемесячныйСпрос;
		СтрокаРегистра.КлассКонтроля = СтрокаНоменклатуры.КлассКонтроля;
		СтрокаРегистра.СпециальныйКлассКонтроля = СтрокаНоменклатуры.СпециальныйКлассКонтроля;
		СтрокаРегистра.СтандартноеКоличество = СтрокаНоменклатуры.СтандартноеКоличествоИтоговое;
		//Бондаренко++ 20170712 на всякий случай закатаю в попытку
		Попытка СтрокаРегистра.СтандартноеКоличествоРасчетное = СтрокаНоменклатуры.СтандартноеКоличествоРасчетное;	Исключение	КонецПопытки;	
		Попытка СтрокаРегистра.РучнаяКорректировка            = СтрокаНоменклатуры.РучнаяКорректировка;	            Исключение	КонецПопытки;	
		//Бондаренко-- 20170712
	КонецЦикла;
	
	//Бондаренко++ 20200110
	РегистрДвижения = Движения.ДополнительныеРеквизитыНоменклатуры;
	РегистрДвижения.Очистить();
	Для Каждого СтрокаНоменклатуры Из ПараметрыРасчета Цикл
	  //  Если обЗначениеНеЗаполнено(СтрокаНоменклатуры.СтандартноеКоличествоРасчетное) Тогда
	  //      Продолжить;
	  //КонецЕсли; 
		СтрокаРегистра = РегистрДвижения.Добавить();
		СтрокаРегистра.Регистратор = Ссылка;
		СтрокаРегистра.Период = ДатаРасчета;
		СтрокаРегистра.ПодразделениеКомпании = ПодразделениеКомпанииДляРасчета;
		СтрокаРегистра.Номенклатура = СтрокаНоменклатуры.Номенклатура;
		СтрокаРегистра.ДополнительныйРеквизит = Перечисления.ДополнительныеРеквизитыНоменклатуры.МинимальныйОстаток;
		Если Не обЗначениеНеЗаполнено(СтрокаНоменклатуры.СтандартноеКоличествоРасчетное) Тогда
			СтрокаРегистра.ЗначениеРеквизита = Окр(СтрокаНоменклатуры.СтандартноеКоличествоРасчетное*0.6,0,РежимОкругления.Окр15как20);
		Иначе
			СтрокаРегистра.ЗначениеРеквизита = 0;
		КонецЕсли;	
 	КонецЦикла;
	//Бондаренко-- 20200110
	
	ЗаписьРегистраСпецКлассаКонтроля = РегистрыСведений.MAD_НазначениеСпециальныхКлассовКонтроля.СоздатьМенеджерЗаписи();
	
	Для Каждого СтрокаНоменклатуры Из УстановкаСпециальныхКлассовКонтроляНаПозицию Цикл
		ЗаписьРегистраСпецКлассаКонтроля.Период = ДатаРасчета;
		ЗаписьРегистраСпецКлассаКонтроля.ПодразделениеКомпании = ПодразделениеКомпанииДляРасчета;
		ЗаписьРегистраСпецКлассаКонтроля.Показатель = СтрокаНоменклатуры.Номенклатура;
		ЗаписьРегистраСпецКлассаКонтроля.Прочитать();
		Если ЗаписьРегистраСпецКлассаКонтроля.Выбран() Тогда
			ЗаписьРегистраСпецКлассаКонтроля.ДокументУстановкиКлассаКонтроля = Ссылка;
			ЗаписьРегистраСпецКлассаКонтроля.СпециальныКлассКонтроля = СтрокаНоменклатуры.СпециальныйКлассКонтроля;
			ЗаписьРегистраСпецКлассаКонтроля.Комментарий = "Установлено документом ""Расчет параметров управления запасами""";
			ЗаписьРегистраСпецКлассаКонтроля.Автор = Автор;
			
			//Бондаренко 20151231 ++
			//ЗаписьРегистраСпецКлассаКонтроля.ДатаОкончания = '00010101';
			ЗаписьРегистраСпецКлассаКонтроля.ДатаОкончания = СтрокаНоменклатуры.ДатаОкончания;
			//Бондаренко 20151231 --
			
			ЗаписьРегистраСпецКлассаКонтроля.Записать();
		Иначе
			ЗаписьРегистраСпецКлассаКонтроля.Период = ДатаРасчета;
			ЗаписьРегистраСпецКлассаКонтроля.ПодразделениеКомпании = ПодразделениеКомпанииДляРасчета;
			ЗаписьРегистраСпецКлассаКонтроля.Показатель = СтрокаНоменклатуры.Номенклатура;
			ЗаписьРегистраСпецКлассаКонтроля.ДокументУстановкиКлассаКонтроля = Ссылка;
			ЗаписьРегистраСпецКлассаКонтроля.СпециальныКлассКонтроля = СтрокаНоменклатуры.СпециальныйКлассКонтроля;
			ЗаписьРегистраСпецКлассаКонтроля.Комментарий = "Установлено документом ""Расчет параметров управления запасами""";
			ЗаписьРегистраСпецКлассаКонтроля.Автор = Автор;
			
			//Бондаренко 20151231 ++
 			ЗаписьРегистраСпецКлассаКонтроля.ДатаОкончания = СтрокаНоменклатуры.ДатаОкончания;
			//Бондаренко 20151231 --

 			ЗаписьРегистраСпецКлассаКонтроля.Записать();
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьРегистраСезонныеФакторы = Движения.СезонныйФактор;
	Для Каждого СтрокаСезонногоФактора Из СезонныеФакторы Цикл
		СтрокаРегистраСезонныеФакторы = ЗаписьРегистраСезонныеФакторы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРегистраСезонныеФакторы, СтрокаСезонногоФактора);
		СтрокаРегистраСезонныеФакторы.Регистратор = Ссылка;
		СтрокаРегистраСезонныеФакторы.Период = ДатаРасчета;
		СтрокаРегистраСезонныеФакторы.Подразделение = ПодразделениеКомпанииДляРасчета;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ЗапросЗаписейПоДокументу = Новый ЗАпрос();
	ЗапросЗаписейПоДокументу.Текст = "ВЫБРАТЬ
	                                 |	MAD_НазначениеСпециальныхКлассовКонтроля.Период,
	                                 |	MAD_НазначениеСпециальныхКлассовКонтроля.ПодразделениеКомпании,
	                                 |	MAD_НазначениеСпециальныхКлассовКонтроля.Показатель,
	                                 |	MAD_НазначениеСпециальныхКлассовКонтроля.СпециальныКлассКонтроля
	                                 |ИЗ
	                                 |	РегистрСведений.MAD_НазначениеСпециальныхКлассовКонтроля КАК MAD_НазначениеСпециальныхКлассовКонтроля
	                                 |ГДЕ
	                                 |	MAD_НазначениеСпециальныхКлассовКонтроля.ДокументУстановкиКлассаКонтроля = &ДокументУстановкиКлассаКонтроля";
	ЗапросЗаписейПоДокументу.УстановитьПараметр("ДокументУстановкиКлассаКонтроля", Ссылка);
	РезультатЗапросаЗаписейПоДокументу = ЗапросЗаписейПоДокументу.Выполнить().Выбрать();
	Пока РезультатЗапросаЗаписейПоДокументу.Следующий() Цикл
		МенеджерЗаписиСпециальногоКлассаКонтроля = РегистрыСведений.MAD_НазначениеСпециальныхКлассовКонтроля.СоздатьМенеджерЗаписи();
		МенеджерЗаписиСпециальногоКлассаКонтроля.Период = РезультатЗапросаЗаписейПоДокументу.Период; 
		МенеджерЗаписиСпециальногоКлассаКонтроля.ПодразделениеКомпании = РезультатЗапросаЗаписейПоДокументу.ПодразделениеКомпании;
		МенеджерЗаписиСпециальногоКлассаКонтроля.Показатель = РезультатЗапросаЗаписейПоДокументу.Показатель;
		МенеджерЗаписиСпециальногоКлассаКонтроля.СпециальныКлассКонтроля = РезультатЗапросаЗаписейПоДокументу.СпециальныКлассКонтроля;
		МенеджерЗаписиСпециальногоКлассаКонтроля.Прочитать();
		
		Если МенеджерЗаписиСпециальногоКлассаКонтроля.Выбран() Тогда
			МенеджерЗаписиСпециальногоКлассаКонтроля.Удалить();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

