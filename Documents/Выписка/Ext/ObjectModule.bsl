Процедура СМГ_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Отказ = Отказ Или НеУказанДоговорВзаиморасчетов(РежимЗаписи);
	
	//Бондаренко++ 20231108
	Если Дата >= Дата(2023,11,1) Тогда
		НомераОшибочныхСтрок = "";      
		БылиОшибки = Ложь;
		Для каждого Стр Из Состав Цикл
			Если Стр.СуммаРасход = 0 Тогда
				Продолжить;
			КонецЕсли;	
			Если НЕ обЗначениеНеЗаполнено(Стр.Сделка) Тогда
				Продолжить;
			КонецЕсли;
			Если Стр.БезСчетаОтПоставщика Тогда
				Продолжить;
 			КонецЕсли;
			БылиОшибки = Истина;   
			Если СокрЛП(НомераОшибочныхСтрок) <> "" Тогда
				НомераОшибочныхСтрок = СокрЛП(НомераОшибочныхСтрок)+";"+СокрЛП(Стр.НомерСтроки);
			Иначе
				НомераОшибочныхСтрок = СокрЛП(Стр.НомерСтроки);				
			КонецЕсли;
		КонецЦикла;
		Если БылиОшибки Тогда
			СМГ_Сообщить("ОШИБКА! Есть строки с расходом, в которых не выбран счет от поставщика.",СтатусСообщения.ОченьВажное);
			СМГ_Сообщить("Номера строк:"+НомераОшибочныхСтрок,СтатусСообщения.ОченьВажное);
		КонецЕсли;             
	КонецЕсли;
	//Бондаренко 20231108
	
	//Бондаренко++ 20250416
	Если РежимЗаписи=РежимЗаписиДокумента.Проведение Тогда
		Если ХозОперация = Справочники.ХозОперации.СтрокаБанковскойВыписки Тогда
			Если Дата >= Дата(2025,04,15) Тогда
 				Если Состав.Количество() > 0 Тогда
					Для каждого Стр Из Состав Цикл
						//Бондаренко++ 20260303
						Если Стр.СтатьяДДС = Справочники.СтатьиДДС.ОплатаПоАгентскомуДоговоруРасход Тогда
							Продолжить;
 						КонецЕсли;
						//Бондаренко-- 20260303
					    Если обЗначениеНеЗаполнено(Стр.Сделка) Тогда
							Отказ = Истина;
							СМГ_Сообщить("ОШИБКА! Не заполнен реквизит в колонке ""Сделка"" в таблице ""Состав"" в строке № "+СокрЛП(Стр.НомерСтроки),СтатусСообщения.ОченьВажное);
	 					КонецЕсли;
	 				КонецЦикла;
				КонецЕсли;
			КонецЕсли;
	 	КонецЕсли;
	КонецЕсли;
 	//Бондаренко-- 20250416
	
	//Бондаренко++ 20260124
	Если РежимЗаписи<>РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если Дата >= Дата(2026,1,1) Тогда
			Если Состав.Количество() > 0 Тогда
				Для каждого Стр Из Состав Цикл
					Если обЗначениеНеЗаполнено(Стр.ИдентификаторСтрокиВыписки) Тогда
						Стр.ИдентификаторСтрокиВыписки = Новый УникальныйИдентификатор();
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Бондаренко-- 20260124
	
КонецПроцедуры

СообщениеОбОшибке = Неопределено;

