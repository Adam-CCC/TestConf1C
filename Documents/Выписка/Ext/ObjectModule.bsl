Процедура СМГ_СоздатьИлиОбновитьСФВыданный(ИдСтрокиВыписки)
	
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
   	СФ_НаАвансВыданный = Документы.СчетФактураВыданный.СоздатьДокумент(); 
	СФ_НаАвансВыданный.Комментарий = "Счет-фактура на аванс из банковской выписки был автоматически создан "+СокрЛП(ТекущаяДата())+" пользователем "+СокрЛП(ПараметрыСеанса.Пользователь);
	СФ_НаАвансВыданный.НаАванс = Истина;
	СФ_НаАвансВыданный.ИдентификаторСтрокиВыписки = ИдСтрокиВыписки;
	СФ_НаАвансВыданныйТребуется = Истина;
 	
	//Если Не СФ_НаАвансВыданныйТребуется Тогда
	//	Возврат;
	//КонецЕсли;	
 	 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК СФ,
	|	СчетФактураВыданный.ДокументОснование КАК ДокументОснование,
	|	СчетФактураВыданный.Проведен КАК Проведен,
	|	СчетФактураВыданный.ИдентификаторСтрокиВыписки КАК ИдентификаторСтрокиВыписки
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	|	И СчетФактураВыданный.ИдентификаторСтрокиВыписки = &ИдентификаторСтрокиВыписки";
	
	Запрос.УстановитьПараметр("ДокументОснование", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторСтрокиВыписки", ИдСтрокиВыписки);
     	
	Результат = Запрос.Выполнить();		
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СФ_НаАвансВыданный = ВыборкаДетальныеЗаписи.СФ.ПолучитьОбъект(); 
		Прервать;
	КонецЦикла; 
	
	//Если СФ_НаАвансВыданный = Неопределено Тогда
	// 	Возврат;
	// КонецЕсли;
	 
	СФ_НаАвансВыданный.Заполнить(ЭтотОбъект.Ссылка);
	
	Если Не СФ_НаАвансВыданный.НаАванс Тогда
		СФ_НаАвансВыданный.НаАванс = Истина;
 	КонецЕсли;
	
 	СФ_НаАвансВыданный.Дата = ЭтотОбъект.Дата; 
	СФ_НаАвансВыданный.Комментарий = "Документ был автоматически обновлен "+СокрЛП(ТекущаяДата());
  	
	ФлЭтотОбъектПроведен = ЭтотОбъект.Проведен;
	ФлЭтотОбъектПометкаУдаления = ЭтотОбъект.ПометкаУдаления;
	
	СФ_НаАвансВыданный.Проведен = ФлЭтотОбъектПроведен;			
	СФ_НаАвансВыданный.ПометкаУдаления = ФлЭтотОбъектПометкаУдаления;
	
	Если ФлЭтотОбъектПометкаУдаления Тогда               
		Попытка 
			СФ_НаАвансВыданный.Записать(РежимЗаписиДокумента.Запись); 
			#Если Клиент Тогда
				Если ЭтотОбъект.Комментировать Тогда
					СМГ_Сообщить("Записан помеченный на удаление "+СФ_НаАвансВыданный); 
				КонецЕсли;	
			#КонецЕсли
		Исключение 
		КонецПопытки; 
	Иначе                                                           
		Если ФлЭтотОбъектПроведен Тогда
			Попытка 
				СФ_НаАвансВыданный.Записать(РежимЗаписиДокумента.Проведение); 
				#Если Клиент Тогда
					Если ЭтотОбъект.Комментировать Тогда
						СМГ_Сообщить("Записан проведённый "+СФ_НаАвансВыданный); 
					КонецЕсли;		
				#КонецЕсли
			Исключение 
			КонецПопытки; 					
		Иначе
			Попытка 
				СФ_НаАвансВыданный.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
				#Если Клиент Тогда
					Если ЭтотОбъект.Комментировать Тогда
						СМГ_Сообщить("Записан непроведённый "+СФ_НаАвансВыданный); 
					КонецЕсли;		
				#КонецЕсли
			Исключение 
			КонецПопытки; 					
		КонецЕсли; 
	КонецЕсли;
  	
КонецПроцедуры //СМГ_СоздатьИлиОбновитьСФВыданный()
