Процедура ЗагрузитьALCПакетИзФайлаЭксель(ЭтаФорма, ТекСтрока) Экспорт
	 
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Укажите каталог, содержащий файлы Exсel";
	СписокФайлов = Неопределено;
 
	Пока Истина Цикл
		Если НЕ Диалог.Выбрать() Тогда // Выбирается каталог с файлами
			Возврат;
		КонецЕсли;
		
		СписокФайлов = НайтиФайлы(Диалог.Каталог, "*.xls"); // Получаем список всех файлов в выбранном каталоге

		// Если не обнаружено ни одной обработки...
		Если СписокФайлов.Количество() = 0 Тогда
			Ответ = Вопрос("В указанном каталоге не обнаружены файлы Excel." + Символы.ПС + "Выбрать другой каталог?", РежимДиалогаВопрос.ДаНет);
			Если Ответ = КодВозвратаДиалога.Нет Тогда
				Прервать;
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ТекФайл Из СписокФайлов Цикл
		#Если КЛИЕНТ Тогда 
			Сообщить("Имя файла: "+ТекФайл.ПолноеИмя);
		#КонецЕсли	
		ФайлЭксель = Новый Файл(ТекФайл.ПолноеИмя);
 		Если ФайлЭксель.Существует() Тогда
			#Если КЛИЕНТ Тогда 
				ИмяФайлаЭксель = СокрЛП(ФайлЭксель.ПолноеИмя);
				Сообщить("Файл = "+ИмяФайлаЭксель+" существует");
  				Результат = ПрочитатьEXCEL(ЭтаФорма,ИмяФайлаЭксель,ТекСтрока);
				Сообщить("Результат = "+Результат);
			#КонецЕсли	
		КонецЕсли;   
	КонецЦикла; 

КонецПроцедуры // ЗагрузитьALCПакетИзФайлаЭксель()

// функция чтения из EXCEL файла аналогов
Функция ПрочитатьEXCEL(ЭтаФорма,ИмяФайла,ТекСтрока)
	
	НеНужныйФайл = Истина;
 	
	ВсеОК = Истина;
	
	ИмяОбрФайла = СокрЛП(ИмяФайла);
	
	Колонка_НомерЗН = 2;
	Колонка_Вин     = 3;
	Колонка_Сумма   = 5;
	
	СтрокаНачало = 1;
 	СтрокаКонец = 1000;
  	
	Приложение = Новый COMОбъект("Excel.Application");
	Приложение.Application.Workbooks.Open(ИмяОбрФайла);

	Если Приложение=Неопределено Тогда
		Предупреждение("MS Excel не загружен");
		Возврат Ложь;
	КонецЕсли;

	ОбрабатываемаяСтрока=?(обЗначениеНеЗаполнено(СтрокаНачало),1,СтрокаНачало);
	ВесьФайл = обЗначениеНеЗаполнено(СтрокаКонец);
	ТекстЛист = Приложение.ActiveSheet;
	КоличествоСтрок = Приложение.ActiveCell.SpecialCells(11).Row;
	
	Итератор = 1;
	
	Пока ОбрабатываемаяСтрока<=КоличествоСтрок И (ВесьФайл ИЛИ ОбрабатываемаяСтрока<=СтрокаКонец) Цикл
		Состояние("Обрабатывается строка " + ОбрабатываемаяСтрока);
		ОбработкаПрерыванияПользователя();
		
		НомерЗН = ТекстЛист.Cells(ОбрабатываемаяСтрока, Колонка_НомерЗН).Value;
  		ВИН=ТекстЛист.Cells(ОбрабатываемаяСтрока,Колонка_Вин).Value;
		Сумма=ТекстЛист.Cells(ОбрабатываемаяСтрока,Колонка_Сумма).Value;
  		ОбрабатываемаяСтрока = ОбрабатываемаяСтрока+1;
		
 		НомерЗН = СокрЛП(НомерЗН);
		НомерЗН=СтрЗаменить(НомерЗН,"?","");
		ВИН = СокрЛП(ВИН);
		Сумма = СтрЗаменить(Сумма,Символы.НПП,"");
		Сумма = СтрЗаменить(Сумма,",",".");
 		
		Если обЗначениеНеЗаполнено(НомерЗН) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Найти(ТекСтрока.НазначениеПлатежа,НомерЗН)>0 Тогда
			Сообщить("Найден акт = "+НомерЗН+" в Назначении платежа "+ТекСтрока.НазначениеПлатежа);	
			НеНужныйФайл = Ложь;
		КонецЕсли; 
		
		Если НеНужныйФайл Тогда
			// Не нашли номер вкта в Назначении платежа текущей строки;
			Продолжить;
 		КонецЕсли; 
 		
		Если обЗначениеНеЗаполнено(ВИН) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если СтрДлина(ВИН) < 17 Тогда
			Продолжить;
		КонецЕсли; 
 		
		Если обЗначениеНеЗаполнено(Сумма) Тогда
 			Продолжить;
		КонецЕсли; 
 		
		Сообщить("НомерЗН = "+НомерЗН+"; ВИН = "+ВИН+"; Сумма = "+Сумма+"; Обрабатываемая cтрока = "+ОбрабатываемаяСтрока);
		
		ДатаНачала = ДобавитьМесяц(ТекущаяДата(),-24);
		ДатаОкончания = КонецДня(ТекущаяДата());
		
		СсылкаНаЗН = Документы.ЗаказНаряд.ПустаяСсылка();
		
		СсылкаНаЗН = НайтиЗН(НомерЗН,ВИН,ДатаНачала,ДатаОкончания);
		 
		//Если обЗначениеНеЗаполнено(СсылкаНаЗН)  Тогда
		//Продолжить;
		//Иначе
		//	Сообщить("Найден ЗН "+СсылкаНаЗН);
		//КонецЕсли; 
		
 
	  //Если Итератор = 1 тогда
	  //  	ТекСтрока.Сделка =  СсылкаНаЗН;
	  //  	ТекСтрока.СуммаПриход = Сумма;
	  //  	//ТекСтрока.Автоматически = Истина;
	  //  	ТекСтрока.НазначениеПлатежа	 = "НомерЗН = "+НомерЗН+"; ВИН = "+ВИН+"; Сумма = "+Сумма+"; Заказ-наряд = <<"+СсылкаНаЗН+">>; Cтрока = "+ОбрабатываемаяСтрока;
	  //	Итератор = Итератор + 1;
	  //  	Продолжить;
	  //  КонецЕсли;
		СтрокаТЧ = ЭтаФорма.Состав.Добавить();
		СтрокаТЧ.СтатьяДДС             = ТекСтрока.СтатьяДДС;
		СтрокаТЧ.Контрагент			   = СсылкаНаЗН.Контрагент; 
		СтрокаТЧ.ДоговорВзаиморасчетов = СсылкаНаЗН.ДоговорВзаиморасчетов; 
		СтрокаТЧ.Сделка 			   = СсылкаНаЗН;
		СтрокаТЧ.СуммаПриход		   = Сумма; 
 		СтрокаТЧ.НазначениеПлатежа	 = "НомерЗН = "+НомерЗН+"; ВИН = "+ВИН+"; Сумма = "+Сумма+"; Заказ-наряд = <<"+СсылкаНаЗН+">>; Cтрока = "+ОбрабатываемаяСтрока;
		СтрокаТЧ.КурсВалютыВзаиморасчетов = 1; 
		СтрокаТЧ.ACL	  			   = ТекСтрока.ACL; 
		СтрокаТЧ.ПлатежноеПоручениеОснование  = ТекСтрока.ПлатежноеПоручениеОснование; 
 		СтрокаТЧ.СтавкаНДС			   = Справочники.СтавкиНДС.БезНДС; 
		СтрокаТЧ.Автоматически = Истина;
		СтрокаТЧ.НомерАкта=ТекСтрока.НомерАкта;
 		Итератор = Итератор + 1;
	КонецЦикла;
   	
	Для Каждого Book Из Приложение.WorkBooks Цикл
		Book.Close(Ложь,"",Истина);
	КонецЦикла;
	Приложение.Quit();
	Приложение=Неопределено;				

	Возврат ВсеОК;
КонецФункции // ПрочитатьАналогиEXCEL()

Функция НайтиЗН(НомерЗН,ВИН,ДатаНачала,ДатаОкончания);
	
	СписокВидовРемонта = Новый СписокЗначений;
 	СписокВидовРемонта.Добавить(Справочники.ВидыРемонта.ГарантияПроизводителя);
	СписокВидовРемонта.Добавить(Справочники.ВидыРемонта.ГарантияДистирибьютера);
	СписокВидовРемонта.Добавить(Справочники.ВидыРемонта.ГарантияПроизводителяЛКП);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|ГДЕ
		|	ЗаказНаряд.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЗаказНаряд.ВидРемонта В (&СписокВидовРемонта)
		|	И ЗаказНаряд.Проведен = ИСТИНА
		|	И ЗаказНаряд.Автомобиль.VIN = &ВИН
		|	И ЗаказНаряд.Номер Подобно &НомерЗН";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("СписокВидовРемонта", СписокВидовРемонта);
	Запрос.УстановитьПараметр("ВИН", ВИН);
	Запрос.УстановитьПараметр("НомерЗН", "%%"+НомерЗН+"%%");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Документы.ЗаказНаряд.ПустаяСсылка();
 
КонецФункции // НайтиЗН()
