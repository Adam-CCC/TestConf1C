Процедура ОтменитьПроведениеСФнаАванс()
	
	СпЗн = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК СФ,
	|	СчетФактураВыданный.ДокументОснование КАК ДокументОснование,
	|	СчетФактураВыданный.Проведен КАК Проведен
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	|	И СчетФактураВыданный.Проведен";
	
	СпЗн.ЗагрузитьЗначения(ЭтотОбъект.Состав.ВыгрузитьКолонку("ИдентификаторСтрокиВыписки"));
	
	Запрос.УстановитьПараметр("ДокументОснование", ЭтотОбъект.Ссылка);
      	
	Результат = Запрос.Выполнить();		
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СФ_НаАвансВыданный = ВыборкаДетальныеЗаписи.СФ.ПолучитьОбъект(); 
		
		Попытка
			СФ_НаАвансВыданный.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
			#Если Клиент Тогда
				Если ЭтотОбъект.Комментировать Тогда
					СМГ_Сообщить("Снят с проведения авансовый "+СФ_НаАвансВыданный); 
				КонецЕсли;	
			#КонецЕсли
		Исключение
			#Если Клиент Тогда
				Если ЭтотОбъект.Комментировать Тогда
					СМГ_Сообщить("ОШИБКА! Не удалось снять с проведения авансовый "+СФ_НаАвансВыданный,СтатусСообщения.ОченьВажное); 
				КонецЕсли;	
			#КонецЕсли
		КонецПопытки;
		
	КонецЦикла;	

КонецПроцедуры //ОтменитьПроведениеСФнаАванс()
