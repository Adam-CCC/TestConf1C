Функция НеУказанДоговорВзаиморасчетов(РежимЗаписи)
	НеУказан =  Ложь;
	Если РежимЗаписи=РежимЗаписиДокумента.Проведение тогда
		Если ХозОперация=Справочники.ХозОперации.СтрокаБанковскойВыписки Тогда
			Если ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка() тогда
				НеУказан =  Истина;
				Сообщить("Не указан договор взаиморасчетов");
			КонецЕсли;	 
		Иначе
			Для Каждого стр из Состав цикл
				Если обЗначениеНеЗаполнено(стр.ДоговорВзаиморасчетов) тогда
					НеУказан =  Истина;
					Сообщить("В строке № " + стр.НомерСтроки + " не указан договор взаиморасчетов!");
				КонецЕсли;
 			КонецЦикла;	 
		КонецЕсли; 	 
	КонецЕсли;
	Возврат НеУказан;
КонецФункции
