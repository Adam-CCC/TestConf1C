КонецПроцедуры // ПриУстановкеНовогоНомера()

// Обработчик события заполнения
//
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если НЕ дкОбработкаЗаполнения(ЭтотОбъект, Основание) Тогда Возврат; КонецЕсли;
	
	//Бондаренко++ 20260610
	Если Не обЗначениеНеЗаполнено(Основание) Тогда
		Если ТипЗнч(Основание)=Тип("ДокументСсылка.РабочийЛист") Тогда
			ХозОперация	= Справочники.ХозОперации.РабочийЛистОтделаСтрахования;		
		ИначеЕсли ТипЗнч(Основание)=Тип("ДокументСсылка.РабочийЛистОтделаСтрахования") Тогда	
			ХозОперация	= Справочники.ХозОперации.РабочийЛистОтделаСтрахованияРасторжениеСП;	
		КонецЕсли;
	Иначе
	    ХозОперация	= Справочники.ХозОперации.РабочийЛистОтделаСтрахования;		
	КонецЕсли;
	//Бондаренко-- 20260610
 	
 	// Ввод на основании рабочего листа или рабочего листа отдела страхования
	Если ТипЗнч(Основание)=Тип("ДокументСсылка.РабочийЛист") Тогда
		МенеджерОтделаСтрахования	= Основание.Менеджер;
		ПричинаОтказа				= Основание.ПричинаОтказа;
		ВидОплаты					= Основание.ВидОплаты;
		
		ВидТелефона 				= Основание.ВидТелефона;
		КодРегиона					= Основание.КодРегиона;
		КодГорода					= Основание.КодГорода;	
		НомерТелефона				= Основание.НомерТелефона;
		ВнутреннийНомер				= Основание.ВнутреннийНомер;
		ПредставлениеТелефона		= Основание.ПредставлениеТелефона;	
		
		Страхователь				= Основание.Контрагент;
		
		Если ТипЗнч(Основание)=Тип("ДокументСсылка.РабочийЛист") Тогда
			Если НЕ обЗначениеНеЗаполнено(Основание.Автомобиль) Тогда
				НоваяСтрока				= ВариантыСтрахования.Добавить();
				//Бондаренко++ 20251030
				Если НЕ обЗначениеНеЗаполнено(Основание.Автомобиль) Тогда
					НоваяСтрока.ОбъектСтрахования	= Основание.Автомобиль;
				Иначе
					НоваяСтрока.ОбъектСтрахования	= Основание.Модель;
				КонецЕсли;
				//Бондаренко++ 20251030
			КонецЕсли;
		КонецЕсли;
	//Бондаренко++ 20260610	
	ИначеЕсли ТипЗнч(Основание)=Тип("ДокументСсылка.РабочийЛистОтделаСтрахования") Тогда 
		
		МенеджерОтделаСтрахования	=  ПараметрыСеанса.Пользователь.Сотрудник;
		ПричинаОтказа				= Основание.ПричинаОтказа;
		ВидОплаты					= Основание.ВидОплаты;
		
		ВидТелефона 				= Основание.ВидТелефона;
		КодРегиона					= Основание.КодРегиона;
		КодГорода					= Основание.КодГорода;	
		НомерТелефона				= Основание.НомерТелефона;
		ВнутреннийНомер				= Основание.ВнутреннийНомер;
		ПредставлениеТелефона		= Основание.ПредставлениеТелефона;	
		
		Страхователь				= Основание.Страхователь;
	//Бондаренко-- 20260610
	
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события при копировании
//
Процедура ПриКопировании(ОбъектКопирования)
	Если НЕ дкПриКопировании(ЭтотОбъект, ОбъектКопирования) Тогда Возврат; КонецЕсли;
КонецПроцедуры // ПриКопировании()

// Обработчик события перед записью
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если НЕ дкПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда Возврат; КонецЕсли;
	
	//Бондаренко++ 20251008
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Возврат;		
	КонецЕсли;
	
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		Если РежимЗаписи = РежимЗаписиДокумента.Запись ИЛИ РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Если Не Статус = Справочники.СтатусыРабочегоЛиста.Отказ Тогда
				//Бондаренко++ 20251111
				Если Не обЗначениеНеЗаполнено(ДокументОснование) Тогда
				//Бондаренко-- 20251111
					ЕстьДублиРЛКО = ПроверитьНаДублиРЛОC(ДокументОснование);
					Если ЕстьДублиРЛКО Тогда
						СМГ_Сообщить("Ошибка! Есть дубли РЛОС. Текущий документ не может быть записан.",СтатусСообщения.ОченьВажное);
						Отказ = Истина;
						Возврат;
					КонецЕсли;
				//Бондаренко++ 20251111
				КонецЕсли;
				//Бондаренко-- 20251111
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//Бондаренко-- 20251008
	
	//Бондаренко++ 20260611
	Если СуммаДокумента <> ВариантыСтрахования.Итог("СуммаКомиссии") Тогда
		СуммаДокумента = ВариантыСтрахования.Итог("СуммаКомиссии"); 
 	КонецЕсли;
 	//Бондаренко-- 20260611
 	
КонецПроцедуры // ПередЗаписью()

//Бондаренко++ 20251008
Функция ПроверитьНаДублиРЛОC(ДокОсн)

	Фл_ = Ложь;

	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РабочийЛистОтделаСтрахования.Ссылка КАК РЛОС,
	               |	РабочийЛистОтделаСтрахования.ДокументОснование КАК ДокументОснование,
	               |	РабочийЛистОтделаСтрахования.ПометкаУдаления КАК ПометкаУдаления,
	               |	РабочийЛистОтделаСтрахования.Статус КАК Статус
	               |ИЗ
	               |	Документ.РабочийЛистОтделаСтрахования КАК РабочийЛистОтделаСтрахования
	               |ГДЕ
	               |	РабочийЛистОтделаСтрахования.ДокументОснование = &ДокументОснование
	               |	И НЕ РабочийЛистОтделаСтрахования.Ссылка = &Ссылка
	               |	И НЕ РабочийЛистОтделаСтрахования.ПометкаУдаления
	               |	И НЕ РабочийЛистОтделаСтрахования.Статус = &СтатусОтказ";
	
	Запрос.УстановитьПараметр("ДокументОснование",ДокОсн);
	Запрос.УстановитьПараметр("Ссылка",Ссылка); 
	Запрос.УстановитьПараметр("СтатусОтказ",Справочники.СтатусыРабочегоЛиста.Отказ);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТЗ Цикл
		СМГ_Сообщить("ОШИБКА! Есть подчиненный к "+ДокОсн+" и не помеченный на удаление документ "+Стр.РЛОС,СтатусСообщения.ОченьВажное);
		Фл_ = Истина;
 	КонецЦикла;
	
	Возврат Фл_;
 		 
КонецФункции // ПроверитьНаДублиРЛОC(ДокОсн)
//Бондаренко-- 20251008	

