//Бондаренко++ 20251029
Процедура СМГ_ПриЗаписи()
	
	РабочийЛистОткорректирован = Ложь;
	
	Если Не обЗначениеНеЗаполнено(ДокументОснование) Тогда
		Если ТипЗНЧ(ДокументОснование) = Тип("ДокументСсылка.РабочийЛист") Тогда
			ДокОснОбъект = ДокументОснование.ПолучитьОбъект();
			Если ДокОснОбъект.ДатаРеализацииАвтомобиля <> Дата(1,1,1) ИЛИ Не обЗначениеНеЗаполнено(ДокОснОбъект.РеализацияАвтомобиля) Тогда
				Если СообщатьОбИзмененииРЛ Тогда	
	 				СМГ_Сообщить("Внимание! Автомобиль по <<"+ДокОснОбъект+">> уже продан. РЛ корректировать запрещено.",СтатусСообщения.Информация);
					Возврат;
	 			КонецЕсли;
			КонецЕсли;
			Если ТипЗНЧ(Страхователь) = Тип("СправочникСсылка.Контрагенты") Тогда
				Если ТипЗНЧ(ДокументОснование.Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
					ДокОснОбъект.Контрагент = Страхователь;
					ДокОснОбъект.Лид = Страхователь;
					РабочийЛистОткорректирован = Истина;
				КонецЕсли;			
			КонецЕсли;			
			Если СокрЛП(ДокументОснование.КонтактныйТелефон) <> СокрЛП(ПредставлениеТелефона) Тогда
				ДокОснОбъект.КонтактныйТелефон = СокрЛП(ПредставлениеТелефона);
				ДокОснОбъект.ПредставлениеТелефонаЛида = СокрЛП(ПредставлениеТелефона);
				РабочийЛистОткорректирован = Истина;
			КонецЕсли; 
			
			Если Не ДокОснОбъект.ЕстьДополнительныеСтраховыеПолисы Тогда
				ДокОснОбъект.ЕстьДополнительныеСтраховыеПолисы = Истина;
				РабочийЛистОткорректирован = Истина;
			КонецЕсли; 
 			
			Если НЕ обЗначениеНеЗаполнено(ДокОснОбъект.ПрограммаКАСКО) Тогда
				ДокОснОбъект.КАСКО = Ложь;
 				ДокОснОбъект.ПрограммаКАСКО="";
				ДокОснОбъект.СуммаКаско=0;
				ДокОснОбъект.НаличныеПрограммаКАСКО=Ложь;
				ДокОснОбъект.КВКаско=0;
				ДокОснОбъект.СвязанСКредитКАСКО=Ложь;
 				ДокОснОбъект.СтраховаяКомпанияКАСКО = "";
				ДокОснОбъект.АгентПодразделениеКАСКО = "";
				//Бондаренко++ 20251031
				ДокОснОбъект.ДоговорКвКАСКО = "";
				//Бондаренко-- 20251031
 				РабочийЛистОткорректирован=Истина;
			КонецЕсли;
			Если НЕ обЗначениеНеЗаполнено(ДокОснОбъект.ПрограммаОСАГО) Тогда
			    ДокОснОбъект.ОСАГО = Ложь;
				ДокОснОбъект.ПрограммаОСАГО="";
				ДокОснОбъект.СуммаОСАГО=0;
				ДокОснОбъект.НаличныеПрограммаОСАГО=Ложь;
				ДокОснОбъект.КВосаго=0;
				ДокОснОбъект.СвязанСКредитОСАГО=Ложь;
 				ДокОснОбъект.СтраховаяКомпанияОСАГО = "";
				ДокОснОбъект.АгентПодразделениеОСАГО = "";
				//Бондаренко++ 20251031
				ДокОснОбъект.ДоговорКвОСАГО = "";
				//Бондаренко-- 20251031
 				РабочийЛистОткорректирован=Истина;
			КонецЕсли;
			Если НЕ обЗначениеНеЗаполнено(ДокОснОбъект.ПрограммаСтрахованиеЖизни) Тогда
 				ДокОснОбъект.ПрограммаСтрахованиеЖизни = "";
				ДокОснОбъект.СуммаСтрахованиеЖизни=0;
				ДокОснОбъект.НаличныеПрограммаСЖ=Ложь;
				ДокОснОбъект.КВСЖ=0;
				ДокОснОбъект.СвязанСКредитСЖ=Ложь;
 				ДокОснОбъект.СтраховаяКомпанияСЖ = "";
				ДокОснОбъект.АгентПодразделениеСЖ = ""; 
				//Бондаренко++ 20251031
				ДокОснОбъект.ДоговорКвСЖ = "";
				//Бондаренко-- 20251031
 				РабочийЛистОткорректирован=Истина;
			КонецЕсли;
			Если ДокОснОбъект.ИныеСтраховыеПродукты.Количество() > 0 Тогда
				ДокОснОбъект.ИныеСтраховыеПродукты.Очистить();
			КонецЕсли;
			//Бондаренко-- 20250513
			Для каждого Стр Из ВариантыСтрахования Цикл
				Если обЗначениеНеЗаполнено(Стр.ПрограммаСтрахования) Тогда
					Продолжить;
				КонецЕсли;
				Если Стр.ПрограммаСтрахования.ВидСтрахования = Перечисления.ВидыСтрахования.КАСКО Тогда
					Если НЕ ДокОснОбъект.КАСКО Тогда
						ДокОснОбъект.КАСКО = Истина;
						РабочийЛистОткорректирован = Истина;						
					КонецЕсли;
					Если ДокОснОбъект.ПрограммаКАСКО <> Стр.ПрограммаСтрахования Тогда
						ДокОснОбъект.ПрограммаКАСКО = Стр.ПрограммаСтрахования;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;	
					Если ДокОснОбъект.СуммаКаско <> Стр.СтраховаяСумма Тогда
						ДокОснОбъект.СуммаКаско = Стр.СтраховаяСумма;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.НаличныеПрограммаКАСКО <> Стр.Наличные Тогда
						ДокОснОбъект.НаличныеПрограммаКАСКО = Стр.Наличные;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.КВКаско <> Стр.СуммаКомиссии Тогда
						ДокОснОбъект.КВКаско = Стр.СуммаКомиссии;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.СвязанСКредитКАСКО Тогда
						ДокОснОбъект.СвязанСКредитКАСКО = Ложь;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					//Бондаренко++ 20250724
					Если ДокОснОбъект.СтраховаяКомпанияКАСКО <> Стр.СтраховаяКомпания Тогда
						ДокОснОбъект.СтраховаяКомпанияКАСКО = Стр.СтраховаяКомпания;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.АгентПодразделениеКАСКО <> Стр.АгентПодразделение Тогда 
						ДокОснОбъект.АгентПодразделениеКАСКО = Стр.АгентПодразделение;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					//Бондаренко++ 20251031
					Если ДокОснОбъект.ДоговорКвКАСКО <> Стр.ДоговорКв Тогда 
						ДокОснОбъект.ДоговорКвКАСКО = Стр.ДоговорКв;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
 					//Попытка
					//	ДокОснОбъект.ДоговорКвКАСКО = ДокОснОбъект.НайтиСоздатьДоговорПрочий(ДокОснОбъект.АгентПодразделениеКАСКО,ДокОснОбъект.СтраховаяКомпанияКАСКО.БанкКонтрагент);
					//	РабочийЛистОткорректирован = Истина;
					//Исключение
					//КонецПопытки;
					//Бондаренко++ 20251031
					//Бондаренко-- 20250724	
				ИначеЕсли Стр.ПрограммаСтрахования.ВидСтрахования = Перечисления.ВидыСтрахования.ОСАГО Тогда
					Если НЕ ДокОснОбъект.ОСАГО Тогда
						ДокОснОбъект.ОСАГО = Истина;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.ПрограммаОСАГО <> Стр.ПрограммаСтрахования Тогда
						ДокОснОбъект.ПрограммаОСАГО = Стр.ПрограммаСтрахования;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.СуммаОсаго <> Стр.СтраховаяСумма Тогда
						ДокОснОбъект.СуммаОсаго = Стр.СтраховаяСумма;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.НаличныеПрограммаОСАГО <> Стр.Наличные Тогда
						ДокОснОбъект.НаличныеПрограммаОСАГО = Стр.Наличные;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.КВОсаго <> Стр.СуммаКомиссии Тогда
						ДокОснОбъект.КВОсаго = Стр.СуммаКомиссии;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.СвязанСКредитОСАГО Тогда
						ДокОснОбъект.СвязанСКредитОСАГО = Ложь;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					//Бондаренко++ 20250724
					Если ДокОснОбъект.СтраховаяКомпанияОСАГО <> Стр.СтраховаяКомпания Тогда
						ДокОснОбъект.СтраховаяКомпанияОСАГО = Стр.СтраховаяКомпания;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.АгентПодразделениеОСАГО <> Стр.АгентПодразделение Тогда 
						ДокОснОбъект.АгентПодразделениеОСАГО = Стр.АгентПодразделение;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					//Бондаренко++ 20251031
					Если ДокОснОбъект.ДоговорКвОСАГО <> Стр.ДоговорКв Тогда 
						ДокОснОбъект.ДоговорКвКАСКО = Стр.ДоговорКв;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
 					//Попытка
					//	ДокОснОбъект.ДоговорКвОСАГО = ДокОснОбъект.НайтиСоздатьДоговорПрочий(ДокОснОбъект.АгентПодразделениеОСАГО,ДокОснОбъект.СтраховаяКомпанияОСАГО.БанкКонтрагент);
					//	РабочийЛистОткорректирован = Истина;
					//Исключение
					//КонецПопытки;
 					//Бондаренко-- 20251031	
				ИначеЕсли Стр.ПрограммаСтрахования.ВидСтрахования = Перечисления.ВидыСтрахования.СтрахованиеЖизни Тогда  
					Если ДокОснОбъект.ПрограммаСтрахованиеЖизни <> Стр.ПрограммаСтрахования Тогда
						ДокОснОбъект.ПрограммаСтрахованиеЖизни = Стр.ПрограммаСтрахования;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.СуммаСтрахованиеЖизни <> Стр.СтраховаяСумма Тогда
						ДокОснОбъект.СуммаСтрахованиеЖизни = Стр.СтраховаяСумма;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.НаличныеПрограммаСЖ <> Стр.Наличные Тогда
						ДокОснОбъект.НаличныеПрограммаСЖ = Стр.Наличные;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.КВСЖ <> Стр.СуммаКомиссии Тогда
						ДокОснОбъект.КВСЖ = Стр.СуммаКомиссии;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.СвязанСКредитСЖ Тогда
						ДокОснОбъект.СвязанСКредитСЖ = Ложь;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					//Бондаренко++ 20250724
					Если ДокОснОбъект.СтраховаяКомпанияСЖ <> Стр.СтраховаяКомпания Тогда
						ДокОснОбъект.СтраховаяКомпанияСЖ = Стр.СтраховаяКомпания;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					Если ДокОснОбъект.АгентПодразделениеСЖ <> Стр.АгентПодразделение Тогда 
						ДокОснОбъект.АгентПодразделениеСЖ = Стр.АгентПодразделение;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					//Бондаренко++ 20251031
					Если ДокОснОбъект.ДоговорКвСЖ <> Стр.ДоговорКв Тогда 
						ДокОснОбъект.ДоговорКвСЖ = Стр.ДоговорКв;
						РабочийЛистОткорректирован = Истина;
					КонецЕсли;
					//Попытка
					//	ДокОснОбъект.ДоговорКвСЖ = ДокОснОбъект.НайтиСоздатьДоговорПрочий(ДокОснОбъект.АгентПодразделениеСЖ,ДокОснОбъект.СтраховаяКомпанияСЖ.БанкКонтрагент);
					//	РабочийЛистОткорректирован = Истина;
					//Исключение
					//КонецПопытки;
					//Бондаренко-- 20251031	
				Иначе
					ИнойСтрахПродукт = ДокОснОбъект.ИныеСтраховыеПродукты.Добавить();
					ИнойСтрахПродукт.ПрограммаСтрахования = Стр.ПрограммаСтрахования;
					ИнойСтрахПродукт.СуммаСтрахования = Стр.СтраховаяСумма;
					ИнойСтрахПродукт.Наличные = Стр.Наличные;
					ИнойСтрахПродукт.КВ = Стр.СуммаКомиссии;
					ИнойСтрахПродукт.СвязанСКредитом = Ложь;
					//Бондаренко++ 20250724	
					ИнойСтрахПродукт.СтраховаяКомпания = Стр.СтраховаяКомпания;
					ИнойСтрахПродукт.АгентПодразделение = Стр.АгентПодразделение;
					//Бондаренко++ 20251031
					ИнойСтрахПродукт.ДоговорКв = Стр.ДоговорКв;
					//Попытка
					//	ИнойСтрахПродукт.ДоговорКв = ДокОснОбъект.НайтиСоздатьДоговорПрочий(Стр.АгентПодразделение,Стр.СтраховаяКомпания.БанкКонтрагент);
					//Исключение
					//КонецПопытки;
					//Бондаренко-- 20251031
					РабочийЛистОткорректирован = Истина;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РабочийЛистОткорректирован Тогда
		Попытка
			ДокОснОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			//Бондаренко++ 20250724	
			Если СообщатьОбИзмененииРЛ Тогда	
				//Бондаренко-- 20250806		
				СМГ_Сообщить("Внимание! Откорректирован <<"+ДокОснОбъект+">>",СтатусСообщения.Информация);
				//Бондаренко++ 20250806	
			КонецЕсли;
			//Бондаренко-- 20250724
			
		Исключение
			СМГ_Сообщить("ОШИБКА! Не удалось откорректировать <<"+ДокОснОбъект+">>",СтатусСообщения.ОченьВажное);
		КонецПопытки;
		
	КонецЕсли;
 	
КонецПроцедуры
//Бондаренко-- 20251029

// Обработчик события перед удалением
//
Процедура ПередУдалением(Отказ)
	Если НЕ дкПередУдалением(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
КонецПроцедуры // ПередУдалением()

// Обработчик события удаления проведения
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	Если НЕ дкОбработкаУдаленияПроведения(ЭтотОбъект, Отказ) Тогда Возврат; КонецЕсли;
КонецПроцедуры // ОбработкаУдаленияПроведения()

// Обработчик события проведения
//
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Если НЕ дкОбработкаПроведения(ЭтотОбъект, Отказ, Режим) Тогда Возврат; КонецЕсли;
	
	// Проведение по регистру сведений Журнал событий
	Если НЕ Отказ Тогда
		Если НЕ орЖурналСостояний(Ссылка, Статус) Тогда
			Отказ=Истина;
			Возврат;
		КонецЕсли; 
	КонецЕсли;	
	
	// выведем сообщения об ошибках и предупреждениях
	дкВыводРезультатовОбработки(ЭтотОбъект,Отказ);
	
КонецПроцедуры // ОбработкаПроведения()

