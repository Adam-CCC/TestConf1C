
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Поля.Добавить("РабочийЛист");
	Поля.Добавить("Дата");
	Поля.Добавить("Клиент");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Представление = "" + Данные.РабочийЛист + ", " + Данные.Дата + ", " + Данные.Клиент; 
	
КонецПроцедуры

Функция ПолучитьДанныеОбъекта(СсылкаНаОбъект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Renault_ПоврежденияКузова.Период,
	               |	Renault_ПоврежденияКузова.Автомобиль,
	               |	Renault_ПоврежденияКузова.ЗонаПовреждения,
	               |	Renault_ПоврежденияКузова.Повреждение,
	               |	Renault_ПоврежденияКузова.Авторабота,
	               |	Renault_ПоврежденияКузова.Обращение,
	               |	Renault_ПоврежденияКузова1.Комментарий,
	               |	Renault_ПоврежденияКузова.СтепеньПовреждения,
	               |	Renault_ПоврежденияКузова.Значение
	               |ПОМЕСТИТЬ Повреждения
	               |ИЗ
	               |	РегистрСведений.Renault_ПоврежденияКузова КАК Renault_ПоврежденияКузова
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПоврежденияКузова КАК Renault_ПоврежденияКузова1
	               |		ПО Renault_ПоврежденияКузова.Период = Renault_ПоврежденияКузова1.Период
	               |			И Renault_ПоврежденияКузова.Автомобиль = Renault_ПоврежденияКузова1.Автомобиль
	               |			И Renault_ПоврежденияКузова.ЗонаПовреждения = Renault_ПоврежденияКузова1.ЗонаПовреждения
	               |			И Renault_ПоврежденияКузова.Авторабота = Renault_ПоврежденияКузова1.Авторабота
	               |			И Renault_ПоврежденияКузова.Обращение = Renault_ПоврежденияКузова1.Обращение
	               |			И (Renault_ПоврежденияКузова1.Комментарий <> """")
	               |ГДЕ
	               |	Renault_ПоврежденияКузова.Повреждение <> ЗНАЧЕНИЕ(Справочник.Renault_Автосервис_Повреждения.Комментарий)
	               |	И Renault_ПоврежденияКузова.Повреждение <> ЗНАЧЕНИЕ(Справочник.Renault_Автосервис_Повреждения.КомментарийАктОсмотра)
	               |	И Renault_ПоврежденияКузова.Автомобиль = &Автомобиль
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	КонтактнаяИнформация.Представление КАК ТелефонКлиента,
	               |	Renault_ЗаявкаНаТрейдИн.Клиент
	               |ПОМЕСТИТЬ Телефоны
	               |ИЗ
	               |	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |		ПО Renault_ЗаявкаНаТрейдИн.Клиент = КонтактнаяИнформация.Объект
	               |			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	               |ГДЕ
	               |	Renault_ЗаявкаНаТрейдИн.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Renault_ЗаявкаНаТрейдИн.Ссылка,
	               |	Renault_ЗаявкаНаТрейдИн.ВерсияДанных,
	               |	Renault_ЗаявкаНаТрейдИн.ПометкаУдаления,
	               |	Renault_ЗаявкаНаТрейдИн.Номер,
	               |	Renault_ЗаявкаНаТрейдИн.Дата,
	               |	Renault_ЗаявкаНаТрейдИн.Проведен,
	               |	Renault_ЗаявкаНаТрейдИн.VIN,
	               |	Renault_ЗаявкаНаТрейдИн.ГодВыпуска,
	               |	Renault_ЗаявкаНаТрейдИн.ГосНомер,
	               |	Renault_ЗаявкаНаТрейдИн.ДатаОсмотраДиагностики,
	               |	Renault_ЗаявкаНаТрейдИн.ДатаОценки,
	               |	Renault_ЗаявкаНаТрейдИн.ДвигательКод,
	               |	Renault_ЗаявкаНаТрейдИн.ДилерскийЦентр,
	               |	Renault_ЗаявкаНаТрейдИн.ДилерскийЦентр.Used_КодРегионаОценки КАК РегионКод,
	               |	Renault_ЗаявкаНаТрейдИн.ЗаказНарядДата,
	               |	Renault_ЗаявкаНаТрейдИн.ЗаказНарядНомер,
	               |	Renault_ЗаявкаНаТрейдИн.ЗатратыНаВосстановлениеПослеДиагностики,
	               |	Renault_ЗаявкаНаТрейдИн.Клиент,
	               |	Renault_ЗаявкаНаТрейдИн.КоличествоВладельцевПоПТС,
	               |	Renault_ЗаявкаНаТрейдИн.Комментарий КАК КомментарийОценщика,
	               |	Renault_ЗаявкаНаТрейдИн.КомментарийПоСостояниюКузоваСалона,
	               |	Renault_ЗаявкаНаТрейдИн.КППКод,
	               |	Renault_ЗаявкаНаТрейдИн.МенеджерЗаявитель,
	               |	Renault_ЗаявкаНаТрейдИн.МенеджерТрейдИн,
	               |	Renault_ЗаявкаНаТрейдИн.МесяцВыпуска,
	               |	Renault_ЗаявкаНаТрейдИн.МеханикДиагност,
	               |	Renault_ЗаявкаНаТрейдИн.МодельКод,
	               |	Renault_ЗаявкаНаТрейдИн.МодификацияКод,
	               |	Renault_ЗаявкаНаТрейдИн.НаличиеАварий,
	               |	Renault_ЗаявкаНаТрейдИн.ОриентировочнаяЦена,
	               |	Renault_ЗаявкаНаТрейдИн.Пробег,
	               |	Renault_ЗаявкаНаТрейдИн.ПроизводительКод,
	               |	Renault_ЗаявкаНаТрейдИн.РабочийЛист,
	               |	Renault_ЗаявкаНаТрейдИн.РегионКод КАК РегионКод1,
	               |	Renault_ЗаявкаНаТрейдИн.РегионНаименование,
	               |	Renault_ЗаявкаНаТрейдИн.СостояниеШин,
	               |	Renault_ЗаявкаНаТрейдИн.СрокДействия,
	               |	Renault_ЗаявкаНаТрейдИн.Статус,
	               |	Renault_ЗаявкаНаТрейдИн.ТипАвтомобиляКод,
	               |	Renault_ЗаявкаНаТрейдИн.ТипКузоваКод,
	               |	Renault_ЗаявкаНаТрейдИн.ТипСделки,
	               |	Renault_ЗаявкаНаТрейдИн.Автомобиль,
	               |	Renault_ЗаявкаНаТрейдИн.ХозОперация,
	               |	Renault_ЗаявкаНаТрейдИн.Цвет,
	               |	Renault_ЗаявкаНаТрейдИн.ЦенаВыкупа,
	               |	Renault_ЗаявкаНаТрейдИн.ВычетДилера,
	               |	Renault_ЗаявкаНаТрейдИн.Представление,
	               |	Renault_ЗаявкаНаТрейдИн.МоментВремени,
	               |	Renault_РабочиеЛисты.Клиент КАК ФИОКлиента,
	               |	"""" КАК СостояниеШинСтрокой,
	               |	Renault_ЗаявкаНаТрейдИн.ДилерскийЦентр.ОсновнойТелефон,
	               |	Renault_ЗаявкаНаТрейдИн.ДилерскийЦентр.НаименованиеДляПечати,
	               |	Телефоны.ТелефонКлиента,
	               |	Renault_ЗаявкаНаТрейдИн.ДвигательКод.Объем
	               |ИЗ
	               |	Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	               |		ПО Renault_ЗаявкаНаТрейдИн.РабочийЛист = Renault_РабочиеЛисты.IDK
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Телефоны КАК Телефоны
	               |		ПО Renault_ЗаявкаНаТрейдИн.Клиент = Телефоны.Клиент
	               |ГДЕ
	               |	Renault_ЗаявкаНаТрейдИн.Ссылка = &Ссылка";
				   
	Запрос.УстановитьПараметр("Автомобиль", СсылкаНаОбъект.Автомобиль);			   
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	ВалютаРубли = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	
	ДанныеОбъекта = Новый Структура;
	
	Для Каждого СтрокаТаблицы Из Выборка Цикл
		Для Каждого Столбец Из Выборка.Колонки Цикл
			ДанныеОбъекта.Вставить(Столбец.Имя, СтрокаТаблицы[Столбец.Имя]);
		КонецЦикла;
	КонецЦикла;
	
	Если ДанныеОбъекта.СостояниеШин = Истина Тогда
		ДанныеОбъекта.СостояниеШинСтрокой = "Хорошее";
	Иначе
		ДанныеОбъекта.СостояниеШинСтрокой = "Плохое";
	КонецЕсли;
	
	
	
	Возврат ДанныеОбъекта;
		
КонецФункции

Функция ПолучитьДанныеПечати(знач МассивДокументов, знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, ПолучитьДанныеОбъекта(ОбъектСсылка));
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ОписаниеОбластей.Вставить(ИмяМакета, ПолучитьОписаниеОбластейМакетаОфисногоДокумента());
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие;
	
	//Для Каждого ИмяМакета Из МассивИменМакетов Цикл
	//	Если ИмяМакета = "ПФ_DOC_Договор" Тогда
	//		ДвоичныеДанныеМакетов.Вставить(ИмяМакета, Renault_УправлениеПечатью.ПолучитьМакет("Документ.CRM_Договор.ПФ_DOC_ДоговорНаАванс_ФизЛицо"));
	//		ТипыМакетов.Вставить(ИмяМакета, "DOC");
	//	Иначе
	//		//?
	//	КонецЕсли;
	//КонецЦикла;
	
	Возврат Новый Структура("Данные, Макеты",
							ДанныеПоВсемОбъектам,
							Новый Структура("ОписаниеОбластей, ТипыМакетов, ДвоичныеДанныеМакетов",
											ОписаниеОбластей,
											ТипыМакетов,
											ДвоичныеДанныеМакетов));
	
КонецФункции

Функция ПолучитьОписаниеОбластейМакетаОфисногоДокумента()
	
	ОписаниеОбластей = Новый Структура;
	
	Renault_УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Заголовок", "Общая");
	
	Возврат ОписаниеОбластей;
	
КонецФункции

Процедура Печать(ТабДок,Ссылка) Экспорт
	
	Макет = Документы.Renault_ЗаявкаНаТрейдИн.ПолучитьМакет("ЛистОценки");
	ДанныеДокумента = ПолучитьДанныеОбъекта(Ссылка);
	
	ОбластьСтраница = Макет.ПолучитьОбласть("Страница");
	ТабДок.Очистить();
	ОбластьСтраница.Параметры.Заполнить(ДанныеДокумента);
	Если ЗначениеЗаполнено(ДанныеДокумента.ЗаказНарядНомер) и ЗначениеЗаполнено(ДанныеДокумента.ЗаказНарядДата) Тогда
		ОбластьСтраница.Параметры.СтрЗаказНаряд = Строка(ДанныеДокумента.ЗаказНарядНомер) + " от "+ Формат(ДанныеДокумента.ЗаказНарядДата,"ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	////Заполним комплектацию автомобил
	//упорядочим опции по длине названия, первая колонка будет содержать короткие названия опций, а последняя - длинные.
	ТЗОпции  = Ссылка.Опции.Выгрузить();
	ТЗОпции.Колонки.Добавить("Длина");
	Для каждого СтрОпции из ТЗОпции Цикл
		СтрОпции.Длина = СтрДлина(СтрОпции.Опция.Наименование);
	КонецЦикла;
	ТЗОпции.Сортировать("Длина возр");
	
	Сч=0;
	Для каждого СтрОпции из ТЗОпции Цикл
		Сч=Сч+1;
		Если Сч>54  тогда 
			Прервать;
		КонецЕсли;
		
		ОбластьСтраница.Параметры["Опция"+Сч] = СтрОпции.Опция.Наименование;
		Если СтрОпции.Выбрана Тогда
			ОбластьСтраница.Рисунки["О"+Сч].Картинка =  БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
		КонецЕсли;
		
	КонецЦикла;
	
    //Заполним повреждения автомобиля
	
	Повреждения = ПолучитьПоврежденияАвтомобиля(Ссылка.Автомобиль);
	
	Для каждого стрПовреждение из Повреждения цикл
		Картинка = БиблиотекаКартинок.Пусто;
		Если стрПовреждение.Повреждение = Справочники.Renault_Автосервис_Повреждения.Удар тогда
			Картинка = БиблиотекаКартинок.Renault_Cross;
		ИначеЕсли стрПовреждение.Повреждение = Справочники.Renault_Автосервис_Повреждения.Царапина тогда
			Картинка = БиблиотекаКартинок.Renault_Circle;
		ИначеЕсли стрПовреждение.Повреждение = Справочники.Renault_Автосервис_Повреждения.УдарЦарапина тогда
			Картинка = БиблиотекаКартинок.Renault_CircleCross;
		КонецЕсли;
		
		ОбластьСтраница.Рисунки[стрПовреждение.ЗонаПовреждения].Картинка = Картинка;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.СрокДействия) тогда
		ОбластьСтраница.Рисунки.ГарантияДа.Картинка = БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
		ОбластьСтраница.Параметры.СрокДействия = Формат(ДанныеДокумента.СрокДействия,"ДФ=dd.MM.yyyy");
	Иначе	
		ОбластьСтраница.Параметры.СрокДействия = "";
		ОбластьСтраница.Рисунки.ГарантияНет.Картинка = БиблиотекаКартинок.CRM_ИзображениеСобытиеВыполнено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.ДатаОсмотраДиагностики) тогда
		ОбластьСтраница.Параметры.ДатаОсмотраДиагностики = Формат(ДанныеДокумента.ДатаОсмотраДиагностики,"ДФ=dd.MM.yyyy");
	Иначе
		ОбластьСтраница.Параметры.ДатаОсмотраДиагностики = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеДокумента.ТелефонКлиента) тогда
		Если Лев(ДанныеДокумента.ТелефонКлиента,1) = "9" тогда
			ОбластьСтраница.Параметры.ТелефонКлиента = "8"+ ДанныеДокумента.ТелефонКлиента;
		КонецЕсли;
	КонецЕсли;

	ТабДок.Вывести(ОбластьСтраница);
	
   
КонецПроцедуры

Функция ПолучитьПоврежденияАвтомобиля(Автомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Renault_ПоврежденияКузова.Период,
	               |	Renault_ПоврежденияКузова.Автомобиль,
	               |	Renault_ПоврежденияКузова.ЗонаПовреждения,
	               |	Renault_ПоврежденияКузова.Повреждение,
	               |	Renault_ПоврежденияКузова.Авторабота,
	               |	Renault_ПоврежденияКузова.Обращение,
	               //|	Renault_ПоврежденияКузова1.Комментарий,
	               |	Renault_ПоврежденияКузова.СтепеньПовреждения,
	               |	Renault_ПоврежденияКузова.Значение
	               |ИЗ
	               |	РегистрСведений.Renault_ПоврежденияКузова КАК Renault_ПоврежденияКузова
				   //|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПоврежденияКузова КАК Renault_ПоврежденияКузова1
				   //|		ПО Renault_ПоврежденияКузова.Период = Renault_ПоврежденияКузова1.Период
				   //|			И Renault_ПоврежденияКузова.Автомобиль = Renault_ПоврежденияКузова1.Автомобиль
				   //|			И Renault_ПоврежденияКузова.ЗонаПовреждения = Renault_ПоврежденияКузова1.ЗонаПовреждения
				   //|			И Renault_ПоврежденияКузова.Авторабота = Renault_ПоврежденияКузова1.Авторабота
				   //|			И Renault_ПоврежденияКузова.Обращение = Renault_ПоврежденияКузова1.Обращение
				   //|			И (Renault_ПоврежденияКузова1.Комментарий <> """")
	               |ГДЕ
	               |	Renault_ПоврежденияКузова.Повреждение <> ЗНАЧЕНИЕ(Справочник.Renault_Автосервис_Повреждения.Комментарий)
	               |	И Renault_ПоврежденияКузова.Повреждение <> ЗНАЧЕНИЕ(Справочник.Renault_Автосервис_Повреждения.КомментарийАктОсмотра)
	               |	И Renault_ПоврежденияКузова.Автомобиль = &Автомобиль";
				   
				   Запрос.УстановитьПараметр("Автомобиль",Автомобиль);
	Возврат Запрос.Выполнить().Выгрузить();
				   
				   
КонецФункции