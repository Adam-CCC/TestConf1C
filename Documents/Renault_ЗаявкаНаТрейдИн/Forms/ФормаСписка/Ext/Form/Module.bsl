
&НаКлиенте
Процедура ОтборНовые(Команда)
	
	ОтборНовыеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВсе(Команда)
	
	ОтборВсеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВыполненные(Команда)
	
	ОтборВыполненныеСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВРаботе(Команда)
	
	ОтборВРаботеСервер();
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьВсеОтборыСервер()
	
	Список.Отбор.Элементы.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ОтборНовыеСервер()
	
	ОтключитьВсеОтборыСервер();

	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементОтбора.Использование = Истина;
    ЭлементОтбора.ПравоеЗначение = Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.Черновик;
      
КонецПроцедуры

&НаСервере
Процедура ОтборВсеСервер()
	
	ОтключитьВсеОтборыСервер();
      
КонецПроцедуры

&НаСервере
Процедура ОтборВРаботеСервер()
	
	ОтключитьВсеОтборыСервер();

	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.ВыполненаОценка);
	МассивСтатусов.Добавить(Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.ДиагностикаПроведена);
	МассивСтатусов.Добавить(Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.НаправленаНаДиагностику);
	МассивСтатусов.Добавить(Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.НаРассмотрении);
	
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
    ЭлементОтбора.Использование = Истина;
    ЭлементОтбора.ПравоеЗначение = МассивСтатусов;
      
КонецПроцедуры

&НаСервере
Процедура ОтборВыполненныеСервер()
	
	ОтключитьВсеОтборыСервер();

	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
    ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    ЭлементОтбора.Использование = Истина;
    ЭлементОтбора.ПравоеЗначение = Перечисления.Renault_CRM_СтатусЗаявокТрейдИн.ОформлениеЗавершено;
      
КонецПроцедуры
