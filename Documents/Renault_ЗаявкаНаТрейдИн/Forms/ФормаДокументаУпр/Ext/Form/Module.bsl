Функция ВернутьТаблицуПоврежденияКузова(Автомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_ПоврежденияКузова.Период,
	|	Renault_ПоврежденияКузова.Автомобиль,
	|	Renault_ПоврежденияКузова.ЗонаПовреждения,
	|	Renault_ПоврежденияКузова.ЗонаПовреждения.ИмяЭлемента Как ИмяЭлемента,
	|	Renault_ПоврежденияКузова.Повреждение КАК Повреждения,
	|	Renault_ПоврежденияКузова.ИдентификаторКартинки КАК ИдентификаторКартинки,
	|	Renault_ПоврежденияКузова.Авторабота,
	|	Renault_ПоврежденияКузова.Обращение,
	|	Renault_ПоврежденияКузова1.Комментарий,
	|	Renault_ПоврежденияКузова.СтепеньПовреждения,
	|	Renault_ПоврежденияКузова.Значение,
	|	Renault_ЗаявкаНаТрейдИнПоврежденияКузова.СтоимостьВосстановления КАК СтоимостьРемонта
	|ИЗ
	|	РегистрСведений.Renault_ПоврежденияКузова КАК Renault_ПоврежденияКузова
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ПоврежденияКузова КАК Renault_ПоврежденияКузова1
	|		ПО Renault_ПоврежденияКузова.Период = Renault_ПоврежденияКузова1.Период
	|			И Renault_ПоврежденияКузова.Автомобиль = Renault_ПоврежденияКузова1.Автомобиль
	|			И Renault_ПоврежденияКузова.ЗонаПовреждения = Renault_ПоврежденияКузова1.ЗонаПовреждения
	|			И Renault_ПоврежденияКузова.Авторабота = Renault_ПоврежденияКузова1.Авторабота
	|			И Renault_ПоврежденияКузова.Обращение = Renault_ПоврежденияКузова1.Обращение
	|			И (Renault_ПоврежденияКузова1.Комментарий <> """")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн.ПоврежденияКузова КАК Renault_ЗаявкаНаТрейдИнПоврежденияКузова
	|		ПО Renault_ПоврежденияКузова.Автомобиль.VIN = Renault_ЗаявкаНаТрейдИнПоврежденияКузова.Ссылка.VIN
	|			И Renault_ПоврежденияКузова.ЗонаПовреждения = Renault_ЗаявкаНаТрейдИнПоврежденияКузова.Зона
	|			И Renault_ПоврежденияКузова.Повреждение = Renault_ЗаявкаНаТрейдИнПоврежденияКузова.Повреждение
	|			
	|ГДЕ
	|	Renault_ПоврежденияКузова.Автомобиль = &Автомобиль
	|	И Renault_ПоврежденияКузова.Повреждение <> ЗНАЧЕНИЕ(Справочник.Renault_Автосервис_Повреждения.Комментарий)
	|	И Renault_ПоврежденияКузова.Повреждение <> ЗНАЧЕНИЕ(Справочник.Renault_Автосервис_Повреждения.КомментарийАктОсмотра)";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Результат = Запрос.Выполнить();
	ПоврежденияКузова = Результат.Выгрузить().СкопироватьКолонки();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ПоврежденияКузова.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПоврежденияКузова;
		
КонецФункции

&НаСервере
Функция ОформитьПокупкуАвтомобиляНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.VIN) Тогда
		Сообщить("Поле vin не заполнено. 
		|Ввод документа поступление автомобиля не возможно");
		Возврат Документы.ПоступлениеАвтомобилей.ПустаяСсылка();
	КонецЕсли;
	
	СоздатьОбновитьАвтомобиль();
	Записать(Новый Структура());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль";
	
	Запрос.УстановитьПараметр("Автомобиль", Объект.Автомобиль);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();	
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыСеанса.Организация) Тогда
		ТекОрганизация = ПараметрыСеанса.Организация;
	ИначеЕсли ЗначениеЗаполнено(ПараметрыСеанса.ПодразделениеКомпании) И ЗначениеЗаполнено(ПараметрыСеанса.ПодразделениеКомпании.Организация) Тогда
		ТекОрганизация = ПараметрыСеанса.ПодразделениеКомпании.Организация;
	ИначеЕсли ЗначениеЗаполнено(Справочники.ПодразделенияКомпании.ОсновноеПодразделение.Организация) Тогда
		ТекОрганизация = Справочники.ПодразделенияКомпании.ОсновноеПодразделение.Организация;
	Иначе
		ТекОрганизация = Справочники.Организации.ОсновнаяОрганизация;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ДоговорыВзаиморасчетов.Ссылка
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	|ГДЕ
	|	ДоговорыВзаиморасчетов.Владелец = &Владелец
	|	И ДоговорыВзаиморасчетов.Организация = &Организация
	|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВидДоговора");
	
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоров.Покупка);			   
	Запрос.УстановитьПараметр("Владелец", Объект.Клиент);
	Запрос.УстановитьПараметр("Организация", ТекОрганизация);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		//Создаем договор с контрагентом
		ДогОбъект = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		
		ДогОбъект.Владелец = Объект.Клиент;
		ДогОбъект.Организация = ТекОрганизация;
		ДогОбъект.ВидДоговора = Перечисления.ВидыДоговоров.Покупка;
		ДогОбъект.УстановитьНовыйКод();
		ДогОбъект.Подразделение = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
		ДогОбъект.ВидОплаты = Перечисления.ВидыОплаты.НаличныйРасчет;
		ДогОбъект.ДатаНачала = НачалоГода(ТекущаяДата());
		ДогОбъект.ВалютаВзаиморасчетов = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
		ДогОбъект.НомерДоговора = ДогОбъект.Код;
		ДогОбъект.Наименование = "Договор №" + ДогОбъект.Код + " с " + Объект.Клиент.Наименование;
		ДогОбъект.ЕдиницаИзмеренияАвтоработВПечатныхФормах = обПраво("ЕдиницаИзмеренияАвтоработВПечатныхФормах"); // DMSREN-1228
		ДогОбъект.Записать();
		ДоговорСсылка = ДогОбъект.Ссылка;
		
	иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ДоговорСсылка = Выборка.Ссылка;
	КонецЕсли;
	
	ДокументПоступления = Документы.ПоступлениеАвтомобилей.СоздатьДокумент();
	ДокументПоступления.ПодразделениеКомпании = Справочники.ПодразделенияКомпании.ОсновноеПодразделение;
	ДокументПоступления.ВалютаДокумента = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	ДокументПоступления.КурсВалютыВзаиморасчетов = 1;
	ДокументПоступления.КурсДокумента = 1;
	ДокументПоступления.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
	ДокументПоступления.Дата = ТекущаяДата();
	ДокументПоступления.Автор = ПараметрыСеанса.Пользователь;
	ДокументПоступления.ХозОперация = Справочники.ХозОперации.ПоступлениеАвтомобилей;
	ДокументПоступления.СкладКомпании = ПараметрыСеанса.Renault_ПраваПользователя.ДилерскийЦентр.Автосклад_СкладПодержанныхАвто;
	ДокументПоступления.Контрагент = Объект.Клиент;
	ДокументПоступления.Организация = ТекОрганизация;
	ДокументПоступления.ДоговорВзаиморасчетов = ДоговорСсылка;
	ДокументПоступления.Комментарий = "На основании " + Объект.Ссылка;
	НовСтрока = ДокументПоступления.Автомобили.Добавить();
	НовСтрока.VIN = Объект.VIN;
	НовСтрока.Автомобиль = Объект.Автомобиль;
	НовСтрока.ИдентификаторАвтомобиля = Строка(Объект.Автомобиль.УникальныйИдентификатор());
	НовСтрока.АвтомобильБезЗаказа = Истина;
	НовСтрока.АвтомобильБУ = Истина; 	
	НовСтрока.Количество = 1;
	НовСтрока.Цена = Объект.ЦенаВыкупа;
	НовСтрока.Сумма = Объект.ЦенаВыкупа;
	НовСтрока.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	НовСтрока.СуммаВсего = НовСтрока.Сумма;
	// Трояновский К.Е. 15.02.2019 11:40:56 {
	// Закомментировано по DMSCOR-1087
	//Если ДокументПоступления.Дата >= '20190101' Тогда
	//	СуммаБезНДС = НовСтрока.СуммаВсего / 1.20;
	//Иначе
	//	СуммаБезНДС = НовСтрока.СуммаВсего / 1.18;
	//КонецЕсли;
	СуммаБезНДС = НовСтрока.СуммаВсего / (1 + Справочники.СтавкиНДС.ОсновнаяСтавкаНДС.Ставка / 100);
	// Трояновский К.Е. 15.02.2019 11:40:56 }
	НовСтрока.СуммаНДС = НовСтрока.СуммаВсего - СуммаБезНДС;
	
	ДокументПоступления.Записать();
	
	Возврат ДокументПоступления.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ОформитьПокупкуАвтомобиля(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда
		Сообщить("Для принятия автомобиля по Trade-in должен быть указан клиент.");
	КонецЕсли;
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		
		Ответ = Вопрос("Для принятия автомобиля по Trade-in клиент должен быть контрагентом. "+Символы.ПС+"Вы хотите перевести потенциального клиента в контрагенты?",РежимДиалогаВопрос.ДаНет,,,"Вопрос");
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Объект.Клиент = CRM_Редубликация.СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(Объект.Клиент);
		ЭтаФорма.Записать();
		Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
		Запись.Клиент = Объект.Клиент;
		Запись.Записать();
		ОформитьПокупкуАвтомобиля(Неопределено);
		Возврат;
	КонецЕсли;
	
	ПоступлениеСсылка = ОформитьПокупкуАвтомобиляНаСервере();
	Если Не ЗначениеЗаполнено(ПоступлениеСсылка) Тогда
		Возврат;
	КонецЕсли;
	ПоступлениеСсылка.ПолучитьОбъект().ПолучитьФорму().ОткрытьМодально();
	ПослеОткрытияПоступления(ПоступлениеСсылка);
	
КонецПроцедуры

&НаСервере
