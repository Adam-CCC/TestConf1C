&НаСервере
Процедура СоздатьОбновитьАвтомобиль()
	
	Если Не ЗначениеЗаполнено(Объект.VIN) Тогда
		Возврат;
	КонецЕсли;
	
	// Создать группу автомобилей "Трейд-ин", если ее еще нет
	ГруппаАвтомобилей = Справочники.Автомобили.НайтиПоНаименованию("Автомобили трейд-ин");
	Если Не ЗначениеЗаполнено(ГруппаАвтомобилей) Тогда
		ГруппаАвтомобилейОбъект = Справочники.Автомобили.СоздатьГруппу();
		ГруппаАвтомобилейОбъект.Наименование = "Автомобили трейд-ин";
		ГруппаАвтомобилейОбъект.Записать();
		ГруппаАвтомобилей = ГруппаАвтомобилейОбъект.Ссылка;
	КонецЕсли;
	
	АвтомобильСсылка = Справочники.Автомобили.НайтиПоРеквизиту("VIN", Объект.VIN);
	Если Не ЗначениеЗаполнено(АвтомобильСсылка) Тогда
		АвтомобильОбъект = Справочники.Автомобили.СоздатьЭлемент();
	Иначе
		АвтомобильОбъект = АвтомобильСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	АвтомобильОбъект.VIN = Объект.VIN;
	АвтомобильОбъект.Родитель = ГруппаАвтомобилей;
	если Объект.МодельКод.Наименование <> АвтомобильОбъект.Модель.Наименование тогда // DMSREN-1237 
		МодельСсылка = ПолучитьСоздатьМодель();
	КонецЕсли;
	АвтомобильОбъект.Модель = МодельСсылка;
	ВерсияСсылка = ПолучитьСоздатьВерсию(МодельСсылка);
	АвтомобильОбъект.ВариантКомплектации = ВерсияСсылка;
	//@++ Васильев ВА
	Цвет = ПолучитьСоздатьЦвет();
	АвтомобильОбъект.Цвет = Цвет;
	//АвтомобильОбъект.Наименование = Объект.ПроизводительКод.Наименование + " " + Объект.МодельКод.Наименование + " " + Объект.VIN; // DMSREN-1237
	АвтомобильОбъект.ФормированиеНаименованияАвтомобиля(Объект.ГосНомер);  // DMSREN-1237
	АвтомобильОбъект.ВключатьВПрайсЛист = Перечисления.ВидВключенияВПрайсЛист.ПоУмолчанию;
	АвтомобильОбъект.ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	Попытка
		АвтомобильОбъект.ГодВыпуска = Дата(Число(Объект.ГодВыпуска),1,1);
	Исключение
		Сообщить("Некорректный год выпуска");
	КонецПопытки;
	АвтомобильОбъект.Записать();
	
	СохранитьИзображениеМоделиИВариантаКомплектации (МодельСсылка);
	
	Объект.Автомобиль = АвтомобильОбъект.Ссылка;
	ОбновитьСписокОпций ();
	ПоврежденияКузова.Параметры.УстановитьЗначениеПараметра("Автомобиль", Объект.Автомобиль);
	
КонецПроцедуры

