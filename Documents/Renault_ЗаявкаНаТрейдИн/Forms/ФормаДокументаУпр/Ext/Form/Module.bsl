	МассивОпции = Renault_СПробегомСервер.ПолучитьСписокОпций(Сессия, Объект.МодификацияКод);
	
	Для Каждого Элемент Из МассивОпции Цикл
		НоваяСтрока = Объект.Опции.Добавить();
		НоваяСтрока.Опция = Элемент;
		Если Элемент.ОпцияПоУмолчанию Тогда
			НоваяСтрока.Выбрана = Истина;
		КонецЕсли;
		НоваяСтрока.ЗагруженаАвтоматически = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьHTMLКартинки(Модификация)
	
	ДанныеКартинки = Base64Значение(Модификация.Изображение);
	КартинкаОбъект = Новый Картинка(ДанныеКартинки);
	Картинка = ПоместитьВоВременноеХранилище(КартинкаОбъект, ЭтаФорма.УникальныйИдентификатор);
	//Картинка = СтрЗаменить(Картинка, "%данные", Модификация.Изображение);
	//Картинка = СтрЗаменить(Картинка, "%тип", Модификация.ТипИзображения);
	
КонецПроцедуры

&НаКлиенте
Процедура Оценить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.МодификацияКод) Тогда
		Предупреждение("Для оценки необходимо выбрать модификацию автомобиля", , "Оценка автомобиля");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Пробег) Тогда
		Предупреждение("Для оценки необходимо указать пробег", , "Оценка автомобиля");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КоличествоВладельцевПоПТС) Тогда
		Предупреждение("Для оценки необходимо указать количество владельцев", , "Оценка автомобиля");
		Возврат;
	КонецЕсли;
	
	ОценитьНаСервере();
	ПересчитатьСтоимостьВосстановления();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЦенообразование;
	Записать();
	
КонецПроцедуры

&НаСервере
Процедура ОценитьНаСервере()
	
	ОбъектФормы = РеквизитФормыВЗначение("Объект");	
	Renault_СПробегомСервер.ВыполнитьОценку(Сессия, ОбъектФормы);
	ЗначениеВРеквизитФормы(ОбъектФормы, "Объект");
		
	Если Не (ЗначениеЗаполнено(Объект.ОриентировочнаяЦена) и ЗначениеЗаполнено(Объект.РабочийЛист)) Тогда
		Возврат;
	КонецЕсли;
		
	МенеджерРабочегоЛиста = ВернутьМенеджераРабочегоЛиста(Объект.РабочийЛист);
	
	ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
	
	Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	Событие.IDK = Объект.РабочийЛист;
	Событие.Дата = ТекущаяДата();
	Событие.Автор = ТекСотрудник;
	Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
	Событие.Комментарий = "Оценка автомобиля по трейд-ин";
	Событие.ДатаНапоминания = ТекущаяДата();
	Событие.ДатаЗакрытия = ТекущаяДата();
	Событие.КомментарийЗакрытия = "Выполнено";
	Событие.АвторЗакрытия = ТекСотрудник;
	Событие.Сотрудник = МенеджерРабочегоЛиста;
	Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
	Событие.Записать();
	
	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	Напоминание.Отправитель = ТекСотрудник;
	Напоминание.Адресаты.Добавить().Сотрудник = МенеджерРабочегоЛиста;
	Напоминание.ДатаОтправки = ТекущаяДата();
	Напоминание.Комментарий = Событие.Комментарий;
	Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.ОценкаПоТрейдИн;
	Напоминание.ПоказыватьС = ТекущаяДата();
	Напоминание.Наименование ="Оценка по трейд-ин";
	Напоминание.Сообщение = "Выполнена оценка автомобиля по трейд-ин. Ориентировочная цена " + Объект.ОриентировочнаяЦена;;
	Напоминание.ИдентификаторОбъекта = Строка(Формат(Объект.РабочийЛист,"ЧГ="));
	Напоминание.Записать();
	
	ПараметрыЗаписи = Новый Структура();
	Записать(ПараметрыЗаписи);
	
	РегистрыСведений.Renault_Used_ИсторияОценок.ДобавитьОценку(Объект.Ссылка);
	
КонецПроцедуры


&НаСервере 
Функция ВернутьМенеджераРабочегоЛиста(РабочийЛист)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Renault_РабочиеЛисты.Сотрудник
	|ИЗ
	|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
	|ГДЕ
	|	Renault_РабочиеЛисты.IDK = &IDK";
	
	Запрос.УстановитьПараметр("IDK", РабочийЛист);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сотрудник; 
	КонецЕсли;
	
	Возврат Справочники.Сотрудники.ПустаяСсылка();
	
КонецФункции

&НаКлиенте
Процедура КоммПредложение(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ЦенаВыкупа) Тогда
		Предупреждение("Перед формирование коммерческого предложения необходимо сделать оценку автомобиля"
		,, "Коммерческое предложение");
	КонецЕсли;
	
	Записать(Новый Структура());
	ДвоичныеДанныеФайла = ЗаполнитьКоммерческоеПредложение(Объект.Ссылка);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("docx");
	ДвоичныеДанныеФайла.Записать(ИмяВременногоФайла);
	ЗапуститьПриложение(ИмяВременногоФайла);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьКоммерческоеПредложение(Ссылка)
	
	Макет = Документы.Renault_ЗаявкаНаТрейдИн.ПолучитьМакет("КоммерческоеПредложение");
	ДанныеОбъекта = Документы.Renault_ЗаявкаНаТрейдИн.ПолучитьДанныеОбъекта(Ссылка);		
	ДанныеЗаполненногоФайла = Renault_АвтозаполнениеШаблоновФайловКлиентСервер.ЗаполнитьФайлMSWordПоДвоичнымДанным(
	"DOCX", ДанныеОбъекта, Макет);
	ДанныеЗаполненногоФайла = Renault_АвтозаполнениеШаблоновФайловКлиентСервер.ВставитьКартинкуВместоТэгаВФайлDocx(
	"<<IMG>>",
	Base64Значение(Ссылка.МодификацияКод.Изображение),
	ДанныеЗаполненногоФайла,
	"DOCX",
	50);
	
	
	Возврат ДанныеЗаполненногоФайла;		
	
КонецФункции

