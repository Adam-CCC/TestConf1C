&НаКлиенте
Процедура ПроверкаЮридическойЧистоты(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Для проверки юридической чистоты заявку необходимо сохранить.");
		Возврат;	
	КонецЕсли;
	
	СообщениеОбОшибке ="";
	Если (Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ПроверкаНеВыполнялась 
		ИЛИ Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ПроверкаНеНайдена)
		И Вопрос("Вы хотите создать заявку на проверку юридической чистоты автомобиля?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		СообщениеОбОшибке ="";
		Объект.КодПроверкиЮридическойЧистоты = ОтправитьЗаявкуНаПроверкуЮридическойЧистоты(СообщениеОбОшибке);
		Если Объект.КодПроверкиЮридическойЧистоты = -1 тогда
			Сообщить("Ошибка оформления заявки на проверку: "+ СообщениеОбОшибке);
		Иначе
			СообщениеОбОшибке = "";
			ОбновитьСтатусЮридическойПроверкиНаСервере(СообщениеОбОшибке, Объект.КодПроверкиЮридическойЧистоты);	
			Если СообщениеОбОшибке <> "" Тогда
				Сообщить(СообщениеОбОшибке);
				СообщениеОбОшибке="";
			КонецЕсли;
	 	КонецЕсли;
		
	ИначеЕсли (Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ОдобреноВыполениеПроверки 
		ИЛИ Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.НеобходимоПодтверждениеПроверки) тогда
		
		Если Вопрос("Вы подтверждаете выполнение проверки юридической чистоты автомобиля?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда	
			ВыполнитьПодтверждениеПроверки(СообщениеОбОшибке, Объект.КодПроверкиЮридическойЧистоты);
		ИначеЕсли Вопрос("Вы хотите отменить заявку на выполнение проверки юридической чистоты автомобиля?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ВыполнитьОтказОтПроверки(СообщениеОбОшибке);	
		КонецЕсли;
		
		Если СообщениеОбОшибке <> "" Тогда
			Сообщить(СообщениеОбОшибке);
			СообщениеОбОшибке="";
		КонецЕсли;
		ОбновитьСтатусЮридическойПроверкиНаСервере(СообщениеОбОшибке, Объект.КодПроверкиЮридическойЧистоты);
		Если СообщениеОбОшибке <> "" Тогда
			Сообщить(СообщениеОбОшибке);
			СообщениеОбОшибке="";
		КонецЕсли;
		
	ИначеЕсли Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ПроверкаЗавершена Тогда
		Если Вопрос("Проверка уже завершена. Показать результат проверки?", РежимДиалогаВопрос.ДаНет,,,"Вопрос") = КодВозвратаДиалога.Да Тогда
			ПоказатьРезультатЮридическойПроверки(Неопределено);	
		КонецЕсли;
	Иначе
		Если (Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ИдетОбработкаЗаявки 
			ИЛИ Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ИдетПроверка
			ИЛИ Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ИдетДополнительнаяОбработка)
			И Вопрос("Заявка на проверку уже обрабатывается! Вы хотите отменить заявку на выполнение проверки?",РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ВыполнитьОтказОтПроверки(СообщениеОбОшибке);	
			Если СообщениеОбОшибке <> "" Тогда
				Сообщить(СообщениеОбОшибке);
				СообщениеОбОшибке="";
			КонецЕсли;
			ОбновитьСтатусЮридическойПроверкиНаСервере(СообщениеОбОшибке, Объект.КодПроверкиЮридическойЧистоты);
			Если СообщениеОбОшибке <> "" Тогда
				Сообщить(СообщениеОбОшибке);
				СообщениеОбОшибке="";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.СтатусПроверки.ОбновитьТекстРедактирования(); 
	
КонецПроцедуры


&НаСервере
Функция ВернутьРезультатЮридическойПроверкиНаСервере()
	
	Сертификат = Объект.Ссылка.СертификатЮридическойЧистоты;
	Данные = Сертификат.Получить();
	Возврат Данные;
	
КонецФункции


&НаКлиенте
Процедура ПоказатьРезультатЮридическойПроверки(Команда)
	
	Результат = ВернутьРезультатЮридическойПроверкиНаСервере();
	Если Результат = Неопределено Тогда
		Предупреждение("Сертификат с результатом проверки не получен");
	Иначе
		ИмяФайла = ПолучитьИмяВременногоФайла("pdf");
		Результат.Записать(ИмяФайла);
		ЗапуститьПриложение(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьСтатусЮридическойПроверки(Команда)
	СообщениеОбОшибке = "";
	ОбновитьСтатусЮридическойПроверкиНаСервере(СообщениеОбОшибке, Объект.КодПроверкиЮридическойЧистоты);
	Элементы.СтатусПроверки.ОбновитьТекстРедактирования();	
КонецПроцедуры


&НаКлиенте
Процедура ПоврежденияКузоваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры


&НаКлиенте
Процедура Декорация14Нажатие(Элемент)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заявка", Объект.Ссылка);
	
	ОткрытьФорму("РегистрСведений.Renault_Used_ИсторияОценок.ФормаСписка", ПараметрыФормы);
	
КонецПроцедуры


&НаКлиенте
Процедура ОткрытьКалькуляциюНаРемонт(Команда)
	
	СписокКалькуляции = ПолучитьКалькуляциюНаРемонтНаСервере(Объект.Ссылка);
	Если СписокКалькуляции.Количество() = 0 Тогда
		Предупреждение("По данному автомобилю калькуляция еще не составлялась",, "Калькуляция на ремонт");
	ИначеЕсли СписокКалькуляции.Количество() = 1 Тогда
		ОткрытьЗначение(СписокКалькуляции[0].Ссылка);
	Иначе
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Заявка", Объект.Ссылка);
		ОткрытьФормуМодально("Документ.Renault_Калькуляция.Форма.ФормаСпискаПоТрейдИн", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьКалькуляциюНаРемонтНаСервере(Ссылка)
	
	Возврат Документы.Renault_Калькуляция.НайтиКалькуляциюПоЗаявкеНаТрейдИн(Ссылка);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьЗаявкуНаДиагностику(Команда)
	
	Обработка = Обработки.Renault_АвтосервисВыборВерсии.Создать();
	Обращение = НайтиОбращениеВСервис();
	
	Если Обращение = Неопределено Тогда
		Предупреждение("Автомобиль еще не направлялся на диагностику.");
		Возврат;
	КонецЕсли;
	
	//Козлов Е.А. Начало 13.05.2016
	ЭтоОткрытиеОбращения = Истина;
	ФормаАвтосервис2 = ПолучитьФорму("Обработка.CRM_АРМ_АвтоСервис_2.Форма.Форма");
	Обработка.ВнешнийЗапрос(Обращение, Объект.Клиент, Объект.Автомобиль, ФормаАвтосервис2);
	//Обработка.ВнешнийЗапрос(Обращение, Объект.Клиент, Объект.Автомобиль);
	//Козлов Е.А. Конец
	
КонецПроцедуры

&НаСервере
Функция НайтиОбращениеВСервис()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК Документ,
	|	Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения КАК ВидОбращения,
	|	Renault_CRM_ОбращениеВАвтоСервис.Менеджер КАК Менеджер
	|ИЗ
	|	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|		ПО Renault_CRM_ОбращениеВАвтоСервис.Клиент = Renault_ЗаявкаНаТрейдИн.Клиент
	|			И Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = Renault_ЗаявкаНаТрейдИн.Автомобиль
	|ГДЕ
	|	Renault_ЗаявкаНаТрейдИн.Ссылка = &Ссылка
	|	И Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения = &ВидОбращения
	|	И Renault_CRM_ОбращениеВАвтоСервис.ПометкаУдаления = ЛОЖЬ
	|	И Renault_ЗаявкаНаТрейдИн.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ВидОбращения", Справочники.Renault_ВидыОбращенийВАвтосервис.ДиагностикаТрейдИн);
	Запрос.УстановитьПараметр("ссылка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Документ;
	КонецЕсли;
	
КонецФункции

//Козлов Е.А. Начало 13.05.2016
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ПередачаДанныхНаАвтосервис2СФормыОбращения" И НЕ ЭтоОткрытиеОбращения Тогда
		ПолученныеДанные = Параметр;
		ФормаОбращения = Источник;
		
		НовоеОбращение = ФормаОбращения.ДокументОбъект;
		
		Если НЕ ЗначениеЗаполнено(ПолученныеДанные) Тогда
			ТипВызова = "Закрытие";
		Иначе
			ТипВызова = ПолученныеДанные.ТипВызова;
		КонецЕсли; 		
		
		Если ТипВызова = "Закрытие" ИЛИ ТипВызова = "Упущен" ИЛИ ТипВызова = "СохранитьИЗакрытьЗаявку" ИЛИ 
			ТипВызова = "СохранятьОбращение" ИЛИ ТипВызова = "НеСохранятьОбращение" Тогда
			
			МенеджерРабочегоЛиста = ВернутьМенеджераРабочегоЛиста(Объект.РабочийЛист);
			ТекСотрудник = DMS_ОбращенияКлиентов.ВернутьТекущегоСотрудника();
			//
			
			Событие = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
			Событие.IDK = Объект.РабочийЛист;
			Событие.Дата = ТекущаяДата();
			Событие.Автор = ТекСотрудник;
			Событие.ВидСобытия = Справочники.CRM_ВидыСобытий.Прочее;
			Событие.Комментарий = "Создание заявки на диагностику по трейд-ин";
			Событие.ДатаНапоминания = ТекущаяДата();
			Событие.ДатаЗакрытия = ТекущаяДата();
			Событие.АвторЗакрытия = ТекСотрудник;
			Событие.Сотрудник = МенеджерРабочегоЛиста;
			Событие.ДилерскийЦентр = Объект.ДилерскийЦентр;
			Событие.ЗавершеноУспешно = Истина;
			Событие.Обработано = Истина;
			Событие.КомментарийЗакрытия = "Выполнено";
			Событие.Записать();
			
			ПриемкаВСервис = Документы.Renault_CRM_ПриемкаАвтомобиля.НайтиПоРеквизиту("Обращение", НовоеОбращение.Ссылка); 
			
			Если ЗначениеЗаполнено(ПриемкаВСервис) Тогда
				
				МастерПриемщик = ПриемкаВСервис.Машиноместо;
				
				Если НЕ ЗначениеЗаполнено(МастерПриемщик) Тогда
					
					ТаблицаМастеров = Renault_АвтосервисОбщий.ПолучитьМастеровПриемщиковДЦ(Объект.ДилерскийЦентр);
					СписокМастеров = Новый СписокЗначений;
					СписокМастеров.ЗагрузитьЗначения(ТаблицаМастеров.ВыгрузитьКолонку("Сотрудник"));
					ФормаВыбораПлиткой = ПолучитьОбщуюФорму("Renault_ФормаВыбораПлиткой");
					ФормаВыбораПлиткой.Заголовок = "Для создания обращения в сервис укажите мастера-приемщика";
					ФормаВыбораПлиткой.СписокВыбора = СписокМастеров;
					МастерПриемщик = ФормаВыбораПлиткой.ОткрытьМодально();
					Если НЕ ЗначениеЗаполнено(МастерПриемщик) Тогда
						Предупреждение("Не выбран мастер-приемщик");
						Возврат;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
			Напоминание.Отправитель = ТекСотрудник;
			Напоминание.Адресаты.Добавить().Сотрудник = МастерПриемщик; 
			Напоминание.ДатаОтправки = ТекущаяДата();
			Напоминание.Комментарий = Событие.Комментарий;
			Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.ДиагностикаТрейдИн;
			Напоминание.ПоказыватьС = ТекущаяДата();
			Напоминание.Наименование ="Диагностика трейд-ин";
			Напоминание.Сообщение = "Создана заявка на диагностику трейд-ин";
			Напоминание.ИдентификаторОбъекта = Строка(НовоеОбращение.Ссылка.УникальныйИдентификатор());
			Напоминание.Записать();
			Сообщить("Создано " + НовоеОбращение.Ссылка);

		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
//Козлов Е.А. Конец
