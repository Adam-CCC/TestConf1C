&НаСервере 
Процедура ОбновитьСписокОпций ()
	
	Для Каждого СтрокаОпции из Объект.Опции Цикл
		Если СтрокаОпции.Выбрана Тогда
			
			ОпцияСсылка = НайтиСоздатьОпцию (СтрокаОпции.Опция);
			Менеджер = РегистрыСведений.Renault_ОпцииАвтомобилей.СоздатьМенеджерЗаписи();
			Менеджер.VIN = Объект.VIN;
			Менеджер.Опция = ОпцияСсылка;
			Менеджер.Код = ОпцияСсылка.Артикул;
			Менеджер.Наименование = ОпцияСсылка.Наименование;
			Менеджер.Записать();
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиСоздатьОпцию (ОпцияТрейдИн)
	
	ГруппаОпцииТрейдИн = Справочники.Опции.НайтиПоНаименованию("Опции трейд-ин");
	Если Не ЗначениеЗаполнено(ГруппаОпцииТрейдИн) Тогда
		ГруппаОпциийТрейдИнОбъект = Справочники.Опции.СоздатьГруппу();
		ГруппаОпциийТрейдИнОбъект.Наименование = "Опции трейд-ин";
		ГруппаОпциийТрейдИнОбъект.Записать();
		ГруппаОпцииТрейдИн = ГруппаОпциийТрейдИнОбъект.Ссылка;
	КонецЕсли;
	
	ОпцияСсылка = Справочники.Опции.НайтиПоРеквизиту("Артикул", ОпцияТрейдИн.КодДляОценки,ГруппаОпцииТрейдИн);
	Если Не ЗначениеЗаполнено(ОпцияСсылка) Тогда
		ОпцияОбъект = Справочники.Опции.СоздатьЭлемент();
		ОпцияОбъект.Артикул = ОпцияТрейдИн.КодДляОценки;
		ОпцияОбъект.Наименование = ОпцияТрейдИн.Наименование;
		ОпцияОбъект.НаименованиеПолное = ОпцияТрейдИн.Наименование;
		ОпцияОбъект.Родитель = ГруппаОпцииТрейдИн;
		ОпцияОбъект.ВалютаУчета = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
		ОпцияОбъект.СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
		Если Не ЗначениеЗаполнено(ОпцияОбъект.Код) Тогда
			ОпцияОбъект.УстановитьНовыйКод();
		КонецЕсли;
		ОпцияОбъект.Записать();
		ОпцияСсылка = ОпцияОбъект.Ссылка;
	КонецЕсли;
	Возврат ОпцияСсылка; 
КонецФункции

&НаСервере
Функция ПолучитьСоздатьЦвет ()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Цвета.Ссылка
	|ИЗ
	|	Справочник.Цвета КАК Цвета
	|ГДЕ
	|	Цвета.Артикул = &Артикул");
	Запрос.УстановитьПараметр("Артикул",Строка(Объект.Цвет));
	Итог = Запрос.Выполнить();
	Если Итог.Пустой() Тогда
		ЦветОбъект =  Справочники.Цвета.СоздатьЭлемент();
		ЦветОбъект.Артикул = Строка(Объект.Цвет);
		ЦветОбъект.Наименование = Строка(Объект.Цвет);
		ЦветОбъект.ЦветПоГИБДД = Строка(Объект.Цвет);
		ЦветОбъект.Записать();
		Ответ = ЦветОбъект.Ссылка;
	Иначе
		Выборка = Итог.Выбрать();
		Выборка.Следующий();
		Ответ = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

&НаСервере 
Процедура СохранитьИзображениеМоделиИВариантаКомплектации (Модель)
	
	Если ЗначениеЗаполнено(Объект.МодификацияКод) Тогда 
		ДанныеКартинки = Base64Значение(Объект.МодификацияКод.Изображение);
		КартинкаОбъект = Новый Картинка(ДанныеКартинки);
		МенеджерИдентификатор = РегистрыСведений.CRM_ИдентификаторыКартинок.СоздатьМенеджерЗаписи();
		МенеджерИдентификатор.Модель = Модель;
		МенеджерИдентификатор.Прочитать();
		Если НЕ МенеджерИдентификатор.Выбран() Тогда
			Идентификатор = Новый УникальныйИдентификатор; 
			МенеджерИдентификатор.Модель = Модель; 
			МенеджерИдентификатор.Идентификатор = Идентификатор;
			МенеджерИдентификатор.Записать();
		Иначе
			Идентификатор = МенеджерИдентификатор.Идентификатор;
		КонецЕсли;
		Запись = РегистрыСведений.КартинкиИФайлы.СоздатьМенеджерЗаписи();
		Запись.Объект = Модель;
		//Запись.Прочитать();
		//Если Запись
		Запись.Данные = Новый ХранилищеЗначения(КартинкаОбъект);
		Запись.Идентификатор = Идентификатор;
		Запись.ДатаСохранения = ТекущаяДата();
		Запись.Картинка = Истина;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСоздатьВерсию (МодельСсылка)
	
	ВерсияСсылка = Справочники.ВариантыКомплектации.НайтиПоНаименованию(Объект.МодификацияКод.Наименование,,,МодельСсылка);
	Если Не ЗначениеЗаполнено(ВерсияСсылка) Тогда
		ВерсияОбъект = Справочники.ВариантыКомплектации.СоздатьЭлемент();
		ВерсияОбъект.Владелец = МодельСсылка;
		ВерсияОбъект.Наименование = Объект.МодификацияКод.Наименование;
		ВерсияОбъект.Артикул = Объект.МодификацияКод.КодМодификации;
		ВерсияОбъект.НаименованиеПолное = Объект.МодификацияКод.Наименование;
		ВерсияОбъект.ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		ВерсияОбъект.Записать();
		ВерсияСсылка = ВерсияОбъект.Ссылка;
	КонецЕсли;
	
	ОбновитьДопИнформациюПоВерсии (ВерсияСсылка);
	
	Возврат ВерсияСсылка;
	
КонецФункции

&НаСервере
Процедура ОбновитьДопИнформациюПоВерсии (Версия)
	
	Менеджер = РегистрыСведений.Renault_ДопИнформацияПоВерсиям.СоздатьМенеджерЗаписи();
	Менеджер.ВариантКомплектации = Версия;
	Менеджер.ОбъемДвигателя = Объект.ДвигательКод.Объем;
	Менеджер.МощностьКВТ = Объект.ДвигательКод.Киловатты;
	Менеджер.МощностьЛС = Объект.ДвигательКод.ЛошадиныеСилы;
	Менеджер.ТипТоплива = Объект.ДвигательКод.ТипТоплива;
	Менеджер.Записать();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСоздатьМодель ()
	
	ГруппаМоделейТрейдИн = Справочники.Модели.НайтиПоНаименованию("Модели трейд-ин");
	Если Не ЗначениеЗаполнено(ГруппаМоделейТрейдИн) Тогда
		ГруппаМоделейТрейдИнОбъект = Справочники.Модели.СоздатьГруппу();
		ГруппаМоделейТрейдИнОбъект.Наименование = "Модели трейд-ин";
		ГруппаМоделейТрейдИнОбъект.Записать();
		ГруппаМоделейТрейдИн = ГруппаМоделейТрейдИнОбъект.Ссылка;
	КонецЕсли;
	
	ГруппаМоделейПроизводитель = Справочники.Модели.НайтиПоНаименованию(Объект.ПроизводительКод.Наименование,, ГруппаМоделейТрейдИн);
	Если Не ЗначениеЗаполнено(ГруппаМоделейПроизводитель) Тогда
		ГруппаМоделейПроизводительОбъект = Справочники.Модели.СоздатьГруппу();
		ГруппаМоделейПроизводительОбъект.Наименование = Объект.ПроизводительКод.Наименование;
		ГруппаМоделейПроизводительОбъект.Родитель = ГруппаМоделейТрейдИн;
		ГруппаМоделейПроизводительОбъект.Записать();
		ГруппаМоделейПроизводитель = ГруппаМоделейПроизводительОбъект.Ссылка;
	КонецЕсли;
	
	МодельСсылка = Справочники.Модели.НайтиПоНаименованию(Объект.МодельКод.Наименование,, ГруппаМоделейПроизводитель);
	Если Не ЗначениеЗаполнено(МодельСсылка) Тогда
		МодельОбъект = Справочники.Модели.СоздатьЭлемент();
		МодельОбъект.Наименование = Объект.МодельКод.Наименование;
		МодельОбъект.НаименованиеПолное = Объект.МодельКод.Наименование;
		//МодельОбъект.Артикул
		МодельОбъект.ВалютаУчета = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		МодельОбъект.Родитель = ГруппаМоделейПроизводитель;
		МодельОбъект.Записать();
		МодельСсылка = МодельОбъект.Ссылка;
	КонецЕсли;
	
	Возврат МодельСсылка;
КонецФункции

&НаКлиенте
Процедура СоздатьОбращениеВСервис(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Предупреждение("Необходимо записать заявку на трейд-ин");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДилерскийЦентр) Тогда
		Предупреждение("Необходимо указать дилерский центр");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Клиент) Тогда
		Предупреждение("Необходимо указать клиента");
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект.Клиент) = Тип("СправочникСсылка.CRM_ПотенциальныеКонтрагенты") Тогда
		
		Ответ = Вопрос("Для записи автомобиля на диагоностику клиент должен быть контрагентом. "+Символы.ПС+"Вы хотите перевести потенциального клиента в контрагенты?",РежимДиалогаВопрос.ДаНет,,,"Вопрос");
		
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Объект.Клиент = CRM_Редубликация.СоздатьКонтрагентаНаОснованииПотенциальногоКлиента(Объект.Клиент);
		ЭтаФорма.Записать();
		Запись = РегистрыСведений.Renault_КлиентыНаЗамену.СоздатьМенеджерЗаписи();
		Запись.Клиент = Объект.Клиент;
		Запись.Записать();
		СоздатьОбращениеВСервис(Неопределено);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Автомобиль) Тогда
		Предупреждение("Необходимо указать автомобиль");
		Возврат;
	КонецЕсли;
	
	Результат = Неопределено;
	
	СоздатьОбновитьАвтомобиль();
	//Обработка = Обработки.Renault_АвтосервисВыборВерсии.Создать();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_CRM_ОбращениеВАвтоСервис.Ссылка КАК Документ,
	|	Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения КАК ВидОбращения,
	|	Renault_CRM_ОбращениеВАвтоСервис.Менеджер КАК Менеджер
	|ИЗ
	|	Документ.Renault_CRM_ОбращениеВАвтоСервис КАК Renault_CRM_ОбращениеВАвтоСервис
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн КАК Renault_ЗаявкаНаТрейдИн
	|		ПО Renault_CRM_ОбращениеВАвтоСервис.Клиент = Renault_ЗаявкаНаТрейдИн.Клиент
	|			И Renault_CRM_ОбращениеВАвтоСервис.Автомобиль = Renault_ЗаявкаНаТрейдИн.Автомобиль
	|ГДЕ
	|	Renault_ЗаявкаНаТрейдИн.Ссылка = &Ссылка
	|	И Renault_CRM_ОбращениеВАвтоСервис.ВидОбращения = &ВидОбращения
	|	И Renault_CRM_ОбращениеВАвтоСервис.ПометкаУдаления = ЛОЖЬ
	|	И Renault_ЗаявкаНаТрейдИн.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ВидОбращения", Справочники.Renault_ВидыОбращенийВАвтосервис.ДиагностикаТрейдИн);
	Запрос.УстановитьПараметр("ссылка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить();
	Если не Выборка.Пустой() Тогда
		Форма = Документы.Renault_ЗаявкаНаТрейдИн.ПолучитьФорму("ФормаВыбораОбращений");
		ЗначениеВДанныеФормы(Выборка.Выгрузить(), Форма.ТаблицаОбращений);
		Результат = Форма.ОткрытьМодально();
		Если ЗначениеЗаполнено(Результат) и ТипЗнч(Результат) = Тип("ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис")  тогда  
			//Ответ = Обработка.ВнешнийЗапрос(Результат.Ссылка, Объект.Клиент, Объект.Автомобиль);
			
			Форма = ПолучитьОбщуюФорму("Renault_АвтосервисФормаДеталейОбращения");
			Форма.Обращение = Результат;
				
			Форма.Открыть();

			//Вставить открытие существующего обращения
			
		ИначеЕсли ЗначениеЗаполнено(Результат) и Результат = "Создать новый" тогда
			СоздатьНовоеОбращение();
		КонецЕсли;
	Иначе
		СоздатьНовоеОбращение();
	КонецЕсли;
	
КонецПроцедуры

