&НаСервере
Функция ВыполнитьАутентификациюНаСервисеЮридическойПроверки(ВебСервис,СообщениеОбОшибке)
	
	Данные = Новый Структура;
	Данные.Вставить("BIR",Объект.ДилерскийЦентр.BIR);
	Данные.Вставить("Пользователь",Строка(ПараметрыСеанса.Пользователь));
	Токен = ВебСервис.LegalPurity_Auth(СериализаторXDTO.ЗаписатьXDTO(Данные),СообщениеОбОшибке);
	Возврат Токен;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеКлиента(Клиент)
	
	
	ДанныеКлиента = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Клиент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Поле2,
	|	КонтактнаяИнформация.Поле4,
	|	КонтактнаяИнформация.Поле6,
	|	КонтактнаяИнформация.Поле7,
	|	КонтактнаяИнформация.Поле8,
	|	КонтактнаяИнформация.Поле9,
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Ссылка
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресФактический);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеКлиента.Вставить("Адрес",Выборка.Представление);
		//ДанныеКлиента.Вставить("Регион",Выборка.Поле2);
		ДанныеКлиента.Вставить("Город",Выборка.Поле4);
		ДанныеКлиента.Вставить("Улица",Выборка.Поле6);
		ДанныеКлиента.Вставить("Дом",Выборка.Поле7);
		ДанныеКлиента.Вставить("Корпус",Выборка.Поле8);
		ДанныеКлиента.Вставить("квартира",Выборка.Поле9);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПодтверждающиеДокументы.Серия,
	|	ПодтверждающиеДокументы.Номер,
	|	ПодтверждающиеДокументы.ДатаВыдачи,
	|	ПодтверждающиеДокументы.КемВыдан
	|ИЗ
	|	Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|ГДЕ
	|	ПодтверждающиеДокументы.Владелец = &Ссылка
	|	И ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = &Вид";
	
	Запрос.УстановитьПараметр("Вид", Перечисления.ВидыДокументов.Паспорт);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДанныеКлиента.Вставить("ПаспортСерия",СтрЗаменить(Выборка.Серия," ",""));
		ДанныеКлиента.Вставить("ПаспортНомер",СтрЗаменить(Выборка.Номер," ",""));
		ДанныеКлиента.Вставить("ПаспортДатаВыдачи",Выборка.ДатаВыдачи);
		ДанныеКлиента.Вставить("ПаспортКемВыдан",Выборка.КемВыдан);
	КонецЕсли;
	
	Возврат ДанныеКлиента;
	
КонецФункции	

Функция ПроверкаЗаполненияДанных(Объект, ДанныеКлиента, СообщениеОбОшибке, ЮрЛицо)
	
	
	Если СтрДлина(Объект.VIN)<>17 
		ИЛИ Найти(Объект.VIN,"I")>0
		ИЛИ Найти(Объект.VIN,"O")>0
		ИЛИ Найти(Объект.VIN,"Q")>0 тогда
		
		СообщениеОбОшибке ="Не корректный VIN!";
		Возврат Ложь;
		
	КонецЕсли;
	
	Попытка 
		Регион = Число(ДанныеКлиента.Регион);
	Исключение
		СообщениеОбОшибке = "Не корректный регион";
		Возврат Ложь;
	КонецПопытки;
	
	Если ЮрЛицо тогда
		Если НЕ ЗначениеЗаполнено(Объект.Клиент.Наименование) тогда
			СообщениеОбОшибке = "Не заполнено название клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.Адрес) тогда
			СообщениеОбОшибке = "Не заполнено название клиента";
			Возврат Ложь;	
		КонецЕсли;
	Иначе  //физлицо
		
		Если ДанныеКлиента.Свойство("Город") = Ложь Тогда
			СообщениеОбОшибке = "Не заполнен адрес клиента";
			Возврат Ложь;	
		КонецЕсли;	
		
		Если ДанныеКлиента.Свойство("ПаспортСерия") = Ложь  Тогда
			СообщениеОбОшибке = "Не заполнен паспорт клиента";
			Возврат Ложь;	
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(Объект.Клиент.Фамилия) или СтрДлина(Объект.Клиент.Фамилия)>150 тогда
			СообщениеОбОшибке = "Не корректная фамилия клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Клиент.Имя) или СтрДлина(Объект.Клиент.Имя)>100 тогда
			СообщениеОбОшибке = "Не корректное имя клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Клиент.Отчество) или СтрДлина(Объект.Клиент.Отчество)>100 тогда
			СообщениеОбОшибке = "Не корректное отчество клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.Город) или СтрДлина(ДанныеКлиента.Город)>30  тогда
			СообщениеОбОшибке = "Не корректный город клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.Улица) или СтрДлина(ДанныеКлиента.Улица)>50  тогда
			СообщениеОбОшибке = "Не корректная улица клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.Дом) или СтрДлина(ДанныеКлиента.Дом)>6  тогда
			СообщениеОбОшибке = "Не корректный дом клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.Квартира) или СтрДлина(ДанныеКлиента.Квартира)>6  тогда
			СообщениеОбОшибке = "Не корректная квартира клиента";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.ПаспортСерия) или СтрДлина(ДанныеКлиента.ПаспортСерия)>4  тогда
			СообщениеОбОшибке = "Не корректная серия паспорта";
			
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.ПаспортНомер) или СтрДлина(ДанныеКлиента.ПаспортСерия)>6  тогда
			СообщениеОбОшибке = "Не корректный номер паспорта";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.ПаспортДатаВыдачи) тогда
			СообщениеОбОшибке = "Не заполнена дата выдачи паспорта";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.ПаспортКемВыдан) или СтрДлина(ДанныеКлиента.ПаспортКемВыдан)>100 тогда
			СообщениеОбОшибке = "Не корректно заполнено место выдачи паспорта";
			Возврат Ложь;	
		ИначеЕсли НЕ ЗначениеЗаполнено(ДанныеКлиента.ДатаРождения) тогда
			СообщениеОбОшибке = "Не заполнена дата рождения клиента";
			Возврат Ложь;	
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

