&НаКлиенте
Перем РезультатПолученияДопИнформации;
&НаКлиенте
Перем ФормаДлительнойОперации;
&НаКлиенте
Перем ПараметрыОбработчика;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Возврат;
	
	ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();
	Если Не ЗначениеЗаполнено(Объект.ВычетДилера) Тогда
		Объект.ВычетДилера = ДилерскийЦентр.UsedCars_МаржаСумма;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СтатусЮридическойПроверки) Тогда
		Объект.СтатусЮридическойПроверки = Перечисления.DMS_СтатусыЮридическойПроверки.ПроверкаНеВыполнялась;
	КонецЕсли;
	
	ЗаполнитьТаблицуRenaultSelection();
	
	Если Параметры.Свойство("РабочийЛист") Тогда
		ЗаполнитьЗначенияСвойств(Объект,Параметры);
	КонецЕсли;
	
	ЗаполнитьТелефонПочтуКлиента();
	ЗаполнитьПоУмолчанию();
	
	Если ЗначениеЗаполнено(Объект.Ссылка) и ЗначениеЗаполнено(Объект.ТипАвтомобиляКод) Тогда		
		ПолучитьHTMLКартинки(Объект.МодификацияКод);
	КонецЕсли;
	
	ПоврежденияКузова.Параметры.УстановитьЗначениеПараметра("Автомобиль", Объект.Автомобиль);
	Элементы.ГруппаДиагностикаRenaultSelection.Доступность = ЗначениеЗаполнено(Объект.VIN);
	ПересчитатьСтоимостьВосстановления();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСправочники()
	
	//Состояние("Выполняется загрузка данных. Пожалуйста, подождите...");
	Доступность = Ложь;
	Если ПроверитьНаличиеСправочников() Тогда
		РезультатПолученияДопИнформации = ВыполнитьЗапрос ();
		Если РезультатПолученияДопИнформации.ФоновоеЗадание Тогда
			Renault_ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
			ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", 1, Истина);
			ФормаДлительнойОперации = Renault_ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор, "Выполняется загрузка данных."+Символы.ПС+"Пожалуйста, подождите...");
		Иначе
			ОбработатьРезультатВыполненияЗадания();
		КонецЕсли;
	Иначе
		ЗаполнитьСправочникиНаСервере();
		Доступность = Истина;
	КонецЕсли;
	
	//ЗаполнитьСправочникиНаСервере();
	//Доступность = Истина;
	//Состояние();
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапрос ()
	РезультатФоновогоЗадания = Renault_ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"Renault_СПробегомСервер.ПолучитьСписокПроизводителейВФоне", Новый Структура);
	Результат = Новый Структура;
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		Результат.Вставить("ФоновоеЗадание", Ложь);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	Иначе 
		Результат.Вставить("ФоновоеЗадание", Истина);
		Результат.Вставить("ФоновоеЗаданиеИдентификатор", РезультатФоновогоЗадания.ИдентификаторЗадания);
		Результат.Вставить("АдресХранилища", РезультатФоновогоЗадания.АдресХранилища);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатВыполненияЗадания()
	сОтвет = ПолучитьИзВременногоХранилища(РезультатПолученияДопИнформации.АдресХранилища);
	ЗаполнитьСправочникиНаСервере();
	Доступность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте()
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = Renault_ДлительныеОперации.ЗаданиеВыполнено(РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор);

	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = РезультатПолученияДопИнформации.ФоновоеЗаданиеИдентификатор Тогда
				Renault_ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		ОбработатьРезультатВыполненияЗадания();
		Иначе
		Renault_ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузкаФайлаНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста 
Функция  ПроверитьНаличиеСправочников ()
	Выборка = Справочники.Renault_Used_ТипыАвтомобилей.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ЗаполнитьСправочникиНаСервере()
	
	ВебСервис = Renault_СПробегомСервер.ПолучитьВебСервисПодержанныхАвто();
	
	Сессия = Renault_СПробегомСервер.ПолучитьИДСессии(ВебСервис);
	Сессия = Лев(Сессия, 32);
	
	МассивСсылок = Renault_СПробегомСервер.ПолучитьСписокПроизводителей(
		Сессия, Объект.ТипАвтомобиляКод, ВебСервис);
	
	Элементы.ПроизводительКод.СписокВыбора.Очистить();
	Для Каждого Элемент Из МассивСсылок Цикл
		Элементы.ПроизводительКод.СписокВыбора.Добавить(Элемент);	
	КонецЦикла;
	
	Попытка
		МассивГодов = Renault_СПробегомСервер.ПолучитьСписокГодовВыпуска(
		Сессия, Объект.ТипАвтомобиляКод, Объект.ПроизводительКод, ВебСервис);
		
		Элементы.ГодВыпуска.СписокВыбора.Очистить();
		Для Каждого Год Из МассивГодов Цикл
			Элементы.ГодВыпуска.СписокВыбора.Добавить(Год);	
		КонецЦикла;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	Попытка
		МассивМоделей = Renault_СПробегомСервер.ПолучитьСписокМоделей(
		Сессия, Объект.ТипАвтомобиляКод, Объект.ПроизводительКод, Объект.МесяцВыпуска, Объект.ГодВыпуска, ВебСервис);
		
		Элементы.МодельКод.СписокВыбора.Очистить();
		Для Каждого Модель Из МассивМоделей Цикл
			Элементы.МодельКод.СписокВыбора.Добавить(Модель);	
		КонецЦикла;	
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	Попытка
		МассивКузовов = Renault_СПробегомСервер.ПолучитьСписокТиповКузовов(
		Сессия, Объект.ТипАвтомобиляКод, Объект.ПроизводительКод, Объект.МесяцВыпуска, Объект.ГодВыпуска, Объект.МодельКод,ВебСервис);
		
		Элементы.ТипКузоваКод.СписокВыбора.Очистить();
		Для Каждого Кузов Из МассивКузовов Цикл
			Элементы.ТипКузоваКод.СписокВыбора.Добавить(Кузов);	
		КонецЦикла;
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		МассивДвигателей = Renault_СПробегомСервер.ПолучитьСписокДвигателей(
		Сессия, Объект.ТипАвтомобиляКод, Объект.ПроизводительКод, Объект.МесяцВыпуска, Объект.ГодВыпуска, Объект.МодельКод, Объект.ТипКузоваКод, ВебСервис);
		
		Элементы.ДвигательКод.СписокВыбора.Очистить();
		Для Каждого Двигатель Из МассивДвигателей Цикл
			Элементы.ДвигательКод.СписокВыбора.Добавить(Двигатель);	
		КонецЦикла;
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	Попытка
		МассивКПП = Renault_СПробегомСервер.ПолучитьСписокТрансмиссий(
		Сессия, Объект.ТипАвтомобиляКод, Объект.ПроизводительКод, Объект.МесяцВыпуска, Объект.ГодВыпуска, Объект.МодельКод, Объект.ТипКузоваКод, Объект.ДвигательКод, ВебСервис);
		
		Элементы.КППКод.СписокВыбора.Очистить();
		Для Каждого КПП Из МассивКПП Цикл
			Элементы.КППКод.СписокВыбора.Добавить(КПП);	
		КонецЦикла;
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	Попытка
		МассивМодификаций = Renault_СПробегомСервер.ПолучитьСписокМодификаций(
		Сессия, Объект.ТипАвтомобиляКод, Объект.ПроизводительКод, Объект.МесяцВыпуска, Объект.ГодВыпуска, Объект.МодельКод, Объект.ТипКузоваКод, Объект.ДвигательКод, Объект.КППКод, ВебСервис);
		
		Элементы.МодификацияКод.СписокВыбора.Очистить();
		Для Каждого Модификация Из МассивМодификаций Цикл
			Элементы.МодификацияКод.СписокВыбора.Добавить(Модификация);	
		КонецЦикла;
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуRenaultSelection()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ПроверкиRenaultSelection.Ссылка КАК СтатьяОсмотра,
	//Андрианова О.В Начало 19.09.2016
	//|	ЕСТЬNULL(РезультатыДиагностикиRenaultSelection.Норма, ЛОЖЬ) КАК Норма,
	//|	ЕСТЬNULL(РезультатыДиагностикиRenaultSelection.НеНорма, ЛОЖЬ) КАК НеНорма,
	|	РезультатыДиагностикиRenaultSelection.Статус КАК Статус,
	//Андрианова О.В Конец 19.09.2016
	|	РезультатыДиагностикиRenaultSelection.КомментарийНеНорма КАК КомментарийНеНорма,
	|	ЕСТЬNULL(РезультатыДиагностикиRenaultSelection.СтоимостьЗапчасти, 0) КАК СтоимостьЗапчасти,
	|	ЕСТЬNULL(РезультатыДиагностикиRenaultSelection.СтоимостьРаботы, 0) КАК СтоимостьРаботы
	|ИЗ
	|	Справочник.Renault_ПроверкиRenaultSelection КАК Renault_ПроверкиRenaultSelection
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_ЗаявкаНаТрейдИн.РезультатыДиагностикиRenaultSelection КАК РезультатыДиагностикиRenaultSelection
	|		ПО Renault_ПроверкиRenaultSelection.Ссылка = РезультатыДиагностикиRenaultSelection.СтатьяОсмотра
	|			И (РезультатыДиагностикиRenaultSelection.Ссылка = &Ссылка)
	|ГДЕ
	|	Renault_ПроверкиRenaultSelection.ЭтоГруппа = ЛОЖЬ
	//Андрианова О.В Начало 19.09.2016
	|   И НЕ Renault_ПроверкиRenaultSelection.ПометкаУдаления
	|	И Renault_ПроверкиRenaultSelection.Родитель = Значение(Справочник.Renault_ПроверкиRenaultSelection.ВнешнийВнутреннийОсмотр)
	//Андрианова О.В Конец 19.09.2016
	|
	|УПОРЯДОЧИТЬ ПО
	|	Renault_ПроверкиRenaultSelection.Код";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ТаблицаMyRenault = Запрос.Выполнить().Выгрузить();
	РезультатыДиагностикиRenaultSelection.Очистить();
	Для Каждого СтрокаОсмотра Из ТаблицаMyRenault Цикл
		НоваяСтрока = РезультатыДиагностикиRenaultSelection.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОсмотра);
		//Андрианова О.В Начало 19.09.2016
		//НоваяСтрока.Норма = Не НоваяСтрока.НеНорма;
		//Андрианова О.В Конец 19.09.2016
	КонецЦикла;
	
	Элементы.РезультатыДиагностикиRenaultSelection.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТелефонПочтуКлиента()
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(Объект.Клиент);
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
				Телефон = Запись.Представление;
			КонецЕсли;
			Если Запись.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
				Email = Запись.Представление;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	ЗаполнитьТелефонПочтуКлиента();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоУмолчанию()
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Дата = ТекущаяДата();
		Объект.ТипСделки = "ТрейдИн";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтоимостьВосстановления()
	
	Объект.ЗатратыНаВосстановлениеПослеДиагностики = 0;
	Для Каждого Строка Из РезультатыДиагностикиRenaultSelection Цикл
		Объект.ЗатратыНаВосстановлениеПослеДиагностики = 
			Объект.ЗатратыНаВосстановлениеПослеДиагностики
			+ Строка.СтоимостьЗапчасти
			+ Строка.СтоимостьРаботы;
	КонецЦикла;
	
	//Козлов Е.А. Начало 14.06.2016
	//Если ЗначениеЗаполнено(Объект.ОриентировочнаяЦена) Тогда
	//	Объект.ЦенаВыкупа = 
	//		Объект.ОриентировочнаяЦена 
	//		- Объект.ЗатратыНаВосстановлениеПослеДиагностики 
	//		- Объект.ВычетДилера;
	//		
	//КонецЕсли;
	//
	//СписокКалькуляции = ПолучитьКалькуляциюНаРемонтНаСервере(Объект.Ссылка);
	//Если СписокКалькуляции.Количество() = 1 Тогда
	//	СтоимостьВосстановленияПоКалькуляции = Документы.Renault_Калькуляция.ПолучитьИтого(СписокКалькуляции[0].Ссылка);
	//КонецЕсли;
	//
	//Если ЗначениеЗаполнено(СтоимостьВосстановленияПоКалькуляции) Тогда
	//	Объект.ЦенаВыкупа = 
	//		Объект.ОриентировочнаяЦена 
	//		- Объект.ЗатратыНаВосстановлениеПослеДиагностики
	//		- СтоимостьВосстановленияПоКалькуляции
	//		- Объект.ВычетДилера;
	//		
	//КонецЕсли;
		
	СтоимостьВосстановленияПоКалькуляции = 0;
	СписокКалькуляции = ПолучитьКалькуляциюНаРемонтНаСервере(Объект.Ссылка);
	Если СписокКалькуляции.Количество() = 1 Тогда
		СтоимостьВосстановленияПоКалькуляции = Документы.Renault_Калькуляция.ПолучитьИтого(СписокКалькуляции[0].Ссылка);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.ОриентировочнаяЦена) Тогда
		МаржаСумма = Объект.ДилерскийЦентр.UsedCars_МаржаСумма;
		МаржаПроцент = Объект.ДилерскийЦентр.UsedCars_МаржаПроцент;
		МаржаСуммаПоПроценту = МаржаПроцент * (Объект.ОриентировочнаяЦена - 
		Объект.ЗатратыНаВосстановлениеПослеДиагностики - СтоимостьВосстановленияПоКалькуляции) / 100;
		
		Объект.ВычетДилера = ?(ЗначениеЗаполнено(МаржаСумма), МаржаСумма, МаржаСуммаПоПроценту);
		
		Объект.ЦенаВыкупа = 
			Объект.ОриентировочнаяЦена 
			- Объект.ЗатратыНаВосстановлениеПослеДиагностики
			- СтоимостьВосстановленияПоКалькуляции
			- Объект.ВычетДилера;				
	КонецЕсли;
	//Козлов Е.А. Конец
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.РезультатыДиагностикиRenaultSelection.Очистить();
	Для Каждого Строка Из РезультатыДиагностикиRenaultSelection Цикл
		НоваяСтрока = Объект.РезультатыДиагностикиRenaultSelection.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
