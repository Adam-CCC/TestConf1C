&НаСервере
Функция ПолучитьСтруктураОтбораРабочегоЛиста(Ид)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Renault_РабочиеЛисты.ID,
		|	Renault_РабочиеЛисты.IDK,
		|	Renault_РабочиеЛисты.Отдел,
		|	Renault_РабочиеЛисты.Подразделение,
		|	Renault_РабочиеЛисты.ДилерскийЦентр
		|ИЗ
		|	РегистрСведений.Renault_РабочиеЛисты КАК Renault_РабочиеЛисты
		|ГДЕ
		|	Renault_РабочиеЛисты.IDK = &IDK";
	Запрос.УстановитьПараметр("IDK", Ид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ID", Выборка.ID);
	СтруктураОтбора.Вставить("IDK", Выборка.IDK);
	СтруктураОтбора.Вставить("Отдел", Выборка.Отдел);
	СтруктураОтбора.Вставить("Подразделение", Выборка.Подразделение);
	СтруктураОтбора.Вставить("ДилерскийЦентр", Выборка.ДилерскийЦентр);

	
	Возврат СтруктураОтбора;
	
КонецФункции


&НаКлиенте
Процедура УстановитьДоступностьЭлементовКонфигурации()
	
	Элементы.ПроизводительКод.Доступность = Ложь;
	Элементы.МесяцВыпуска.Доступность = Ложь;
	Элементы.ГодВыпуска.Доступность = Ложь;
	Элементы.МодельКод.Доступность = Ложь;
	Элементы.ТипКузоваКод.Доступность = Ложь;
	Элементы.ДвигательКод.Доступность = Ложь;
	Элементы.КППКод.Доступность = Ложь;
	Элементы.МодификацияКод.Доступность = Ложь;
	Элементы.Опции.Доступность = Ложь;
	
	Элементы.Опции.Доступность = ЗначениеЗаполнено(Объект.МодификацияКод);
	Элементы.МодификацияКод.Доступность = ЗначениеЗаполнено(Объект.КППКод);
	Элементы.КППКод.Доступность = ЗначениеЗаполнено(Объект.ДвигательКод);	
	Элементы.ДвигательКод.Доступность = ЗначениеЗаполнено(Объект.ТипКузоваКод);
	Элементы.ТипКузоваКод.Доступность = ЗначениеЗаполнено(Объект.МодельКод);
	Элементы.МодельКод.Доступность = ЗначениеЗаполнено(Объект.МесяцВыпуска) И ЗначениеЗаполнено(Объект.ГодВыпуска);
	Элементы.МесяцВыпуска.Доступность = ЗначениеЗаполнено(Объект.ПроизводительКод);
	Элементы.ГодВыпуска.Доступность = ЗначениеЗаполнено(Объект.ПроизводительКод);
	Элементы.ПроизводительКод.Доступность = ЗначениеЗаполнено(Объект.ТипАвтомобиляКод);
	
КонецПроцедуры

