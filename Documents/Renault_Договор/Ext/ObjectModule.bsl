Функция ДействуетБлокировкаПродажиАвтомобиля(ТЗ,Отказ)	
	
	//DMSREN-984
	Если СтатусДоговора=Перечисления.CRM_СтатусыДоговоровНаПродажуАвтомобиля.Расторгнут Тогда 
		Возврат Отказ;
	КонецЕсли;
	//---
	
	Для каждого Стр Из ТЗ Цикл
		Если ЗначениеЗаполнено(Стр.VIN) И Renault_ОбщийМодуль.Блокировка(Стр.VIN) Тогда
			//Сергеев В.Н. DMSREN-1124 
			//Сообщить("Не удалось записать договор."+Символы.ПС+"Автомобиль с VIN "+Стр.VIN+" заблокирован к продаже.");
			//Отказ=Истина;
		ИначеЕсли ЗначениеЗаполнено(Стр.Версия) И Renault_ОбщийМодуль.Блокировка(Стр.Версия) Тогда
			Сообщить("Не удалось записать договор."+Символы.ПС+"Вариант комплектации "+Стр.Версия + " заблокирован к продаже.");
			Отказ=Истина;
		ИначеЕсли ЗначениеЗаполнено(Стр.Модель) И Renault_ОбщийМодуль.Блокировка(Стр.Модель) Тогда
			Сообщить("Не удалось записать договор."+Символы.ПС+"Модель "+Стр.Модель+" заблокирована к продаже.");
			Отказ=Истина;
		КонецЕсли;	
	КонецЦикла;
	Возврат Отказ;	
КонецФункции

