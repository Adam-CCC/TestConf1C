//Создана такая же в общем модуле Renault_ЗагрузкаКоммерческихАкций, если не нужна можно удалить
Процедура УстановитьТипАвтомобиля(СтрокаДанных) Экспорт
	
	Если ЗначениеЗаполнено(СтрокаДанных.VIN) Тогда
		
		мТипАвтомобиля = Неопределено;
		
		ДилерскийЦентрПользователя = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
		
		BIR_Distri = СокрЛП(ДилерскийЦентрПользователя.BIR_Distri);
		
		МассивСкладовДилера = ДилерскийЦентрПользователя.СкладыДилера.ВыгрузитьКолонку("Склад");
		//Корзюков начало
		Если Не ЗначениеЗаполнено(ДилерскийЦентрПользователя) Тогда
			#Если Клиент Тогда
				Предупреждение("Для пользователя не задан дилерский центр!");
			#конецЕсли
			Возврат;
		КонецЕсли;
		
		Если ДилерскийЦентрПользователя.Автосклад_ИспользоватьНовуюФормуСклада = Истина Тогда
			
			ФормаАвтосклад = Обработки.Renault_АРМ_Автосклад_Упр.ПолучитьФорму("ФормаДинамическийСписок");
			
		Иначе
			ФормаАвтосклад = Обработки.Renault_АРМ_Автосклад.ПолучитьФорму("Форма");
			

		КонецЕсли;
		
		//ФормаАвтосклад = Обработки.Renault_АРМ_Автосклад.ПолучитьФорму("Форма");
		//Корзюков конец
		ФормаАвтосклад.ПоказыватьЗарезервированные = Истина;
		ФормаАвтосклад.МассивСкладовДилера = МассивСкладовДилера;		
		// Ищем в новых
		
		Результат = CRM_Сервер.Автосклад_ПолучитьТаблицуПоСостояниюАвтомобилей(СтрокаДанных.VIN, МассивСкладовДилера, BIR_Distri, Истина, Истина, Истина, Истина,,,,, Неопределено, Неопределено,, Неопределено);
		Если Результат.Количество() > 0 Тогда
			мТипАвтомобиля = "Новый";
		КонецЕсли;
		
		// Ищем в подержанных
		
		Если мТипАвтомобиля = Неопределено Тогда
		
			Результат = CRM_Сервер.Автосклад_ПолучитьТаблицуПодержанныхАвтомобилей(СтрокаДанных.VIN);
			Если Результат.Количество() > 0 Тогда
				мТипАвтомобиля = "Подержанный";
			КонецЕсли;
		
		КонецЕсли;
		
		// Ищем в демо/подменных
		
		Если мТипАвтомобиля = Неопределено Тогда
			
			Результат = ФормаАвтосклад.Автосклад_ПолучитьТаблицуДемоПодменок(СтрокаДанных.VIN);
			Если Результат.Количество() > 0 Тогда
				мТипАвтомобиля = "Демо";
			КонецЕсли;
			
		КонецЕсли;
		
		
		// Если так и не удалось определить тип, считаем что новый
		Если мТипАвтомобиля = Неопределено Тогда
			мТипАвтомобиля = "Новый";
		КонецЕсли;
		
	Иначе
		
		мТипАвтомобиля = Неопределено;
		
	КонецЕсли;

КонецПроцедуры

