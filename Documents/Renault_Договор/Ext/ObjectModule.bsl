Процедура ПроверитьСоответствиеДоговораУсловиюСкидки(ОтказПредоставления, стрУсловие, СтрокаДанных, ПроверкаТипАвто = Ложь) Экспорт
	
	// Доработать проверку остальных условий
	Если СтрокаДанных.ПокупкаВТрейдИн Тогда
		Если стрУсловие.ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.Утилизация Тогда
			ОтказПредоставления = Истина;
		КонецЕсли;
	ИначеЕсли НЕ СтрокаДанных.ПокупкаВТрейдИн И
			стрУсловие.ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.ТрейдИн Тогда
		ОтказПредоставления = Истина;
	ИначеЕсли СтрокаДанных.ПокупкаПоУтилизации Тогда
		Если стрУсловие.ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.ТрейдИн Тогда
			ОтказПредоставления = Истина;
		КонецЕсли;
	ИначеЕсли НЕ СтрокаДанных.ПокупкаПоУтилизации И
		стрУсловие.ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.Утилизация Тогда
		ОтказПредоставления = Истина;
	КонецЕсли;
	
	Если ПроверкаТипАвто Тогда
		
		Если стрУсловие.ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.НовыйАвтомобиль Тогда
			ОтказПредоставления = мТипАвтомобиля <> "Новый";
		ИначеЕсли стрУсловие.ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.ПодержанныйАвтомобиль Тогда
			ОтказПредоставления = мТипАвтомобиля <> "Подержанный";
		ИначеЕсли стрУсловие.ВидУсловия = Перечисления.Renault_ВидыУсловийПредоставленияСкидок.ДемоАвтомобиль Тогда
			ОтказПредоставления = мТипАвтомобиля <> "Демо";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

