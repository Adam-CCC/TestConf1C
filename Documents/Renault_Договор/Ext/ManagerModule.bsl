Процедура ЗаполнитьОпции(БазовыеОпции, Обл, ТабДокумент)
	
	Если НЕ БазовыеОпции = Неопределено Тогда
		ВсегоБазовыхОпций = БазовыеОпции.Количество();
	Иначе
		ВсегоБазовыхОпций = 0;
	КонецЕсли;
	
	Номер = 0;
	
	Влезает = 50;
	Индекс = 0;
	СледующуюСтрокуПропускаем = Ложь;
	
	Пока Индекс <> БазовыеОпции.Количество() Цикл
		
		СтрокаЭлемента = БазовыеОпции[Индекс];
		ДлинаСтроки = СтрДлина(СтрокаЭлемента);
		
		Если ДлинаСтроки > Влезает Тогда
			
			//Нужно делить строку
			
			//Ищем пробел с конца строки
			НайденныйСимвол = "";
			Инд1 = ДлинаСтроки - Влезает; //индекс пробела по которому делим строки
			Пока НайденныйСимвол <> " " Цикл
				НайденныйСимвол = Сред(СтрокаЭлемента, СтрДлина(СтрокаЭлемента)- Инд1, 1);
				Инд1 = Инд1 + 1;
			КонецЦикла;
			
			//Получим левую часть и запишем ее в массив
			
			ЛеваяЧасть = "- " + СокрЛП(Лев(СтрокаЭлемента, ДлинаСтроки - Инд1));
			БазовыеОпции[Индекс] = ЛеваяЧасть;
			
			//Получим правую часть и запишем ее в массив
			
			ПраваяЧасть = " " + СокрЛП(Сред(СтрокаЭлемента, СтрДлина(СтрокаЭлемента) - Инд1 + 1));
			БазовыеОпции.Вставить(Индекс+1, "  " + ПраваяЧасть);
			СледующуюСтрокуПропускаем = Истина;
			
		Иначе
			
			Если СледующуюСтрокуПропускаем Тогда
				СледующуюСтрокуПропускаем = Ложь; //Эта строка - права часть предыдущей строки
			Иначе
				БазовыеОпции[Индекс] = "- " + БазовыеОпции[Индекс];
			КонецЕсли;
			
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	//разделим опции на 2 массива
	ПервыйМассив = Новый Массив;
	ВторойМассив = Новый Массив;
	Для Индекс = 0 По БазовыеОпции.Количество() - 1 Цикл
		Если Индекс < Окр((БазовыеОпции.Количество()) / 2) Тогда
			ПервыйМассив.Добавить(БазовыеОпции[Индекс]);
		Иначе
			ВторойМассив.Добавить(БазовыеОпции[Индекс]);
		КонецЕсли;
	КонецЦикла;
	
	Если ПервыйМассив.Количество() >= ВторойМассив.Количество() Тогда
		БольшийИндекс = ПервыйМассив.Количество();
	Иначе
		БольшийИндекс = ВторойМассив.Количество();
	КонецЕсли;
	
	Для Индекс = 0 По БольшийИндекс-1 Цикл
		
		Если Индекс+1 <= ПервыйМассив.Количество() Тогда
			Обл.Параметры.Опция1 = ПервыйМассив[Индекс];
		Иначе
			Обл.Параметры.Опция1 = "";
		КонецЕсли;
		
		Если Индекс+1 <= ВторойМассив.Количество() Тогда
			Обл.Параметры.Опция2 = ВторойМассив[Индекс];
		Иначе
			Обл.Параметры.Опция2 = "";
		КонецЕсли;
		
		ТабДокумент.Вывести(Обл);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДопОпции(Идентификатор, Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
