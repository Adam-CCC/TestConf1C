КонецПроцедуры

Процедура ПечатьАктПриемаПередачиАвтомобиляДемо(ДанныеПечати)
	
	МакетАктПриемаПередачиАвтомобиля = ПолучитьМакет("МакетАктПриемаПередачиАвтомобиляДемо");
	ОбластьШапки = МакетАктПриемаПередачиАвтомобиля.ПолучитьОбласть("Шапка");
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;	
	ДатаНадпись = Формат(ТекущаяДата(),"ДФ='дд ММММ гггг'");

	ТЗСостав = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 

		ОбластьШапки.Параметры.НаименованиеОрганизацииПолное = ДанныеПечати.ДилерНаименованиеОрганизации;
		ОбластьШапки.Параметры.ДатаЗаполнения         =  """" + ЛЕВ(ДатаНадпись,2)+ """ "+ Сред(ДатаНадпись,4, СтрДлина(ДатаНадпись))+" г.";
		ОбластьШапки.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентДоговораНаименование;
		ОбластьШапки.Параметры.Город                  = ""+ОпределитьГородДляПродвинутогоПакета();
		ОбластьШапки.Параметры.ЮрАдрес  = "Юр. адр.:"+ДанныеПечати.ДилерАдресЮридический;
		ОбластьШапки.Параметры.ИНН      = "ИНН "+ДанныеПечати.ДилерИНН;
		ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое;						
        ОбластьШапки.Параметры.ДатаДоговора  = Формат(ДанныеПечати.ДатаДоговора, "ДФ=dd.MM.yyyy")+"г.";
        ОбластьШапки.Параметры.НомерДоговора = ДанныеПечати.НомерДоговора;

		ОбластьШапки.Параметры.ФИООтветственного = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
	    ОбластьШапки.Параметры.УставОрганизации  = ДанныеПечати.ДилерПодписантНаОсновании;
		ОбластьШапки.Параметры.МаркаМодельПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ЗаявкаНаТрейдИн), ""+СтрокаТЗ.ЗаявкаНаТрейдИн.ПроизводительКод +" "+СтрокаТЗ.Автомобиль.Модель.Наименование,СтрокаТЗ.Автомобиль.Модель.Наименование);

		ОбластьШапки.Параметры.Паспорт    = ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер;
		ОбластьШапки.Параметры.Выдан      = ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy");
		
		ТабДокумент.Вывести(ОбластьШапки);
		
		ОбластьСтрокаАвтомобиль = МакетАктПриемаПередачиАвтомобиля.ПолучитьОбласть("СтрокаАвтомобиль");
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаАвтомобиль.Параметры, СтрокаТЗ);
		ОбластьСтрокаАвтомобиль.Параметры.МаркаМодельПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ЗаявкаНаТрейдИн), ""+СтрокаТЗ.ЗаявкаНаТрейдИн.ПроизводительКод +" "+СтрокаТЗ.Автомобиль.Модель.Наименование,СтрокаТЗ.Автомобиль.Модель.Наименование);

		ОбластьСтрокаАвтомобиль.Параметры.Двигатель = СтрокаТЗ.РабочийОбъемДвигателяПТС+" куб.см.,"+СтрокаТЗ.МощностьДвигателяПТС+" л.с.";
		Если СтрокаТЗ.НомерШассиПТС = "" Тогда                           
			ОбластьСтрокаАвтомобиль.Параметры.НомерШассиПТС = "ОТСУТСТВУЕТ";
		КонецЕсли;
		ОбластьСтрокаАвтомобиль.Параметры.ДатаПТС = Формат(СтрокаТЗ.ДатаПТС, "ДЛФ=DD");
		ОбластьСтрокаАвтомобиль.Параметры.Пробег  = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаТЗ.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);	
		Если Не ЗначениеЗаполнено(СтрокаТЗ.ЦветКузоваПТС) Тогда
			ОбластьСтрокаАвтомобиль.Параметры.ЦветКузоваПТС = СтрокаТЗ.Автомобиль.Цвет;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерДвигателяПТС) Тогда
			ОбластьСтрокаАвтомобиль.Параметры.НомерДвигателяПТС = СтрокаТЗ.Автомобиль.НомерДвигателя;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерКузоваПТС) Тогда
			ОбластьСтрокаАвтомобиль.Параметры.НомерКузоваПТС = СтрокаТЗ.Автомобиль.НомерКузова;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерШассиПТС) Тогда
			ОбластьСтрокаАвтомобиль.Параметры.НомерШассиПТС = СтрокаТЗ.Автомобиль.НомерШасси;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.ГодИзготовленияПТС) Тогда
			ОбластьСтрокаАвтомобиль.Параметры.ГодИзготовленияПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ГодВыпуска),Формат(СтрокаТЗ.ГодВыпуска,"ДФ=yyyy"), Формат(СтрокаТЗ.Автомобиль.ГодВыпуска,"ДФ=yyyy"));
		КонецЕсли;
		ТабДокумент.Вывести(ОбластьСтрокаАвтомобиль);
		
		ОбластьПодвал = МакетАктПриемаПередачиАвтомобиля.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.ПТС        = СтрокаТЗ.ПТС;
		ОбластьПодвал.Параметры.Продавец   = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое + Символы.ПС+
		                                     ДанныеПечати.ДилерАдресЮридический+Символы.ПС+
											 "Тел: "+ДанныеПечати.ДилерТелефон+Символы.ПС+
                                             "ИНН: "+ДанныеПечати.ДилерИНН+" КПП: "+ДанныеПечати.ДилерКПП+Символы.ПС+          
	                                         "ОГРН: "+ДанныеПечати.ДилерОГРН+Символы.ПС+
											 "р/с "+ДанныеПечати.ДилерСчет+" в"+Символы.ПС+
											 ДанныеПечати.ДилерБанк+Символы.ПС+
											 "к/с "+ДанныеПечати.ДилерКоррСчет+", БИК"+Символы.ПС+ 
											 ДанныеПечати.ДилерБИК+Символы.ПС+ 
											 "ОКВЭД: "+ДанныеПечати.ДилерОКВЭД+" ОКПО: "+ДанныеПечати.ДилерОКПО;
											
		ОбластьПодвал.Параметры.Покупатель = ДанныеПечати.КлиентДоговораНаименование+Символы.ПС+
		                                    "Паспорт: "+ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер+Символы.ПС+
                                            "Выдан: "+ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy")+Символы.ПС+
                                            "Адрес регистрации: "+ДанныеПечати.КлиентАдрес;
											
        ОбластьПодвал.Параметры.ФИООтветственного      = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
        ОбластьПодвал.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентДоговораНаименование;
		
        ТабДокумент.Вывести(ОбластьПодвал);	
		
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;
			
КонецПроцедуры

