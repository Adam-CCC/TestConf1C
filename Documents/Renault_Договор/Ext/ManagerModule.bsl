Функция ПолучитьСписокДопОпции(Знач ВыборкаОпции, Знач Идентификатор)

	МассивОпций = Новый Массив;
	
	Пока ВыборкаОпции.Следующий() Цикл
		Если ВыборкаОпции.Идентификатор = Идентификатор Тогда
			//МассивОпций.Добавить(Строка(ВыборкаОпции.Опция.НаименованиеПолное));
			МассивОпций.Добавить(Строка(ВыборкаОпции.Наименование));
		КонецЕсли;
	КонецЦикла;
	
	Если МассивОпций.Количество() = 0 Тогда
		Возврат "";
	Иначе
		Возврат Новый Структура("МассивЗначений, ЗаголовокСписка", МассивОпций, "Список дополнительных опций");
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТекстБазовыеОпции(ВыборкаОпции)
	
	СписокОпцийТекст = "";
	НужнаЗапятая = Ложь;
	Пока ВыборкаОпции.Следующий() Цикл
		Если НужнаЗапятая Тогда
			СписокОпцийТекст = СписокОпцийТекст + Символы.ПС;
		Иначе
			НужнаЗапятая = Истина;
		КонецЕсли;
		СписокОпцийТекст = СписокОпцийТекст + ВыборкаОпции.Опция;
	КонецЦикла;
	
	Возврат СписокОпцийТекст;
	
КонецФункции

Функция ПолучитьСписокБазовыеОпции(Знач ВыборкаОпции)
	
	МассивОпций = Новый Массив;
	
	Пока ВыборкаОпции.Следующий() Цикл
		МассивОпций.Добавить(Строка(ВыборкаОпции.Опция));
	КонецЦикла;
	
	Если МассивОпций.Количество() = 0 Тогда
		Возврат "";
	Иначе
		Возврат Новый Структура("МассивЗначений,ЗаголовокСписка", МассивОпций, "Список базовых опций");
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТекстОпцииДилера(ВыборкаОпции, Идентификатор)
	
	СписокОпцийТекст = "";
	НужнаЗапятая = Ложь;
	Пока ВыборкаОпции.Следующий() Цикл
		Если ВыборкаОпции.Идентификатор = Идентификатор Тогда 
			Если НужнаЗапятая Тогда
				СписокОпцийТекст = СписокОпцийТекст + Символы.ПС;
			Иначе
				НужнаЗапятая = Истина;
			КонецЕсли;
		КонецЕсли;
		СписокОпцийТекст = СписокОпцийТекст + ВыборкаОпции.Номенклатура;
	КонецЦикла;
	
	Возврат СписокОпцийТекст;
	
КонецФункции

Функция ПолучитьОписаниеОбластейМакетаОфисногоДокумента()
	
	ОписаниеОбластей = Новый Структура;
	
	Renault_УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Заголовок", "Общая");
	
	Возврат ОписаниеОбластей;
	
КонецФункции

Функция ПолучитьНДС(Знач тСумма, СтавкаНДС)
	
	Если ЗначениеЗаполнено(СтавкаНДС) Тогда 
		ПроцентНДС = СтавкаНДС.Ставка / 100;
	Иначе
		ПроцентНДС = 0;
	КонецЕсли;
	
	тСуммаНДС = тСумма - тСумма / (1 + ПроцентНДС);
	
	Если тСуммаНДС <> 0 Тогда
		тСуммаНДС = Окр(тСуммаНДС, 2);
	КонецЕсли;
	
	Возврат тСуммаНДС;
	
КонецФункции

Функция ЧтениеЗначенияРегистраСведения(Автомобиль, ВидЗначения, НаДату = Неопределено) Экспорт
	
	Если НаДату = Неопределено Тогда
		ДатаЗаписи = Неопределено;
	Иначе
		ДатаЗаписи = НаДату;
	КонецЕсли;
	СтруктураОтбора   = Новый Структура("Автомобиль, ВидЗначения", Автомобиль, ВидЗначения);
	СтруктураСведений = РегистрыСведений.Автомобили.ПолучитьПоследнее(ДатаЗаписи, СтруктураОтбора);
	Возврат СтруктураСведений.Значение;
	
КонецФункции

Функция ПолучитьРаботыПоЗаказНарядам(Автомобиль, Состояние = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СУММА(Работы.СуммаВсего) КАК СуммаВсего
	               |ИЗ
	               |	Документ.ЗаказНаряд.Работы КАК Работы
	               |ГДЕ
	               |	Работы.Ссылка.Автомобиль = &Автомобиль
	               |	И Работы.Ссылка.ВидРемонта = &ВидРемонта
	               |	И НЕ Работы.Ссылка.ПометкаУдаления "
				   +?(Состояние = Неопределено, "",
				   "  И Работы.Ссылка.Состояние = &Состояние ");
					
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ВидРемонта", Справочники.ВидыРемонта.КомплектацияАвтомобиля);
	Если Состояние<>Неопределено Тогда
		Запрос.УстановитьПараметр("Состояние", Состояние);
	КонецЕсли;
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество()>0 Тогда
		Возврат ?(ЗначениеЗаполнено(Результат[0].СуммаВсего), Результат[0].СуммаВсего, 0);
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

#Если ТолстыйКлиентОбычноеПриложение Тогда
Процедура ПечатьПредварительногоДоговора(ДанныеПечати)

	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	МакетПредварительногоДоговора = ПолучитьМакет("МакетПредварительногоДоговора");
	ОбластьШапки = МакетПредварительногоДоговора.ПолучитьОбласть("Шапка");
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;
	
	ТЗСостав = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 

		ОбластьШапки.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентДоговораНаименование;
		ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизации;						
        ОбластьШапки.Параметры.ДатаДоговора  = Формат(ДанныеПечати.ДатаДоговора,"ДФ=dd.MM.yyyy");
        ОбластьШапки.Параметры.НомерДоговора = ДанныеПечати.НомерДоговора;
		ФИООтветственного = "";
		ПОЛ = обОпределитьПол(?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице));
		Если DMS_ФизическиеЛицаСервер.Просклонять(?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице),2,ФИООтветственного,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
		КонецЕсли;
		ОбластьШапки.Параметры.ФИООтветственного = ФИООтветственного;	

		ОбластьШапки.Параметры.Город = ""+ОпределитьГородДляПродвинутогоПакета();
        ОбластьШапки.Параметры.ПодписантНаОсновании = ДанныеПечати.ДилерПодписантНаОсновании;	

		ТабДокумент.Вывести(ОбластьШапки);
		
		СтрокаРасчетов2_1 = МакетПредварительногоДоговора.ПолучитьОбласть("Шапка_2");	
		СтрокаРасчетов2_1.Параметры.СуммаИтог         = ДанныеПечати.СуммаДоговора;
		СтрокаРасчетов2_1.Параметры.СуммаИтогПрописью = обЧислоПрописью(ДанныеПечати.СуммаДоговора,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
		НДСИтого = ПолучитьНДС(ДанныеПечати.СуммаДоговора, СтавкаНДС);
		СтрокаРасчетов2_1.Параметры.НДСИтого  = ЛЕВ(Формат(НДСИтого, "ЧРД=,"), СтрДлина(Формат(НДСИтого, "ЧРД=,"))-3);
		СтрокаРасчетов2_1.Параметры.НДСИтогоПрописью = обЧислоПрописью(Цел(НДСИтого),,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
		НДСКопеек = обЧислоПрописью(НДСИтого-Цел(НДСИтого),,"Л=ru_RU;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");		
		СтрокаРасчетов2_1.Параметры.НДСКопеек = СтрЗаменить(НДСКопеек, "Ноль рублей ", "");
		ТабДокумент.Вывести(СтрокаРасчетов2_1);           
		
		Подвал = МакетПредварительногоДоговора.ПолучитьОбласть("Подвал");	
		Подвал.Параметры.СуммаИтог1         = СтрокаТЗ.СуммаПредоплаты;
		Подвал.Параметры.СуммаИтог1Прописью = обЧислоПрописью(СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
		Подвал.Параметры.СуммаИтог2         = ДанныеПечати.СуммаДоговора-СтрокаТЗ.СуммаПредоплаты;
		Подвал.Параметры.СуммаИтог2Прописью = обЧислоПрописью(ДанныеПечати.СуммаДоговора-СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
		ТабДокумент.Вывести(Подвал);
		
		СтрокаПодвал = МакетПредварительногоДоговора.ПолучитьОбласть("СтрокаПодвал");	
		СтрокаПодвал.Параметры.Продавец = ""+ДанныеПечати.ДилерНаименованиеОрганизацииКраткое + Символы.ПС+
		                                   "Юридический адрес:"+ДанныеПечати.ДилерАдресЮридический+Символы.ПС+
											 "Тел: "+ДанныеПечати.ДилерТелефон+Символы.ПС+
                                             "ИНН: "+ДанныеПечати.ДилерИНН+" КПП: "+ДанныеПечати.ДилерКПП+Символы.ПС+          
	                                         "ОГРН: "+ДанныеПечати.ДилерОГРН+Символы.ПС+
											 "р/с "+ДанныеПечати.ДилерСчет+" в"+Символы.ПС+
											 ДанныеПечати.ДилерБанк+Символы.ПС+
											 "к/с "+ДанныеПечати.ДилерКоррСчет+", БИК"+Символы.ПС+ 
											 ДанныеПечати.ДилерБИК+Символы.ПС+ 
											 "ОКВЭД: "+ДанныеПечати.ДилерОКВЭД+" ОКПО: "+ДанныеПечати.ДилерОКПО;
        СтрокаПодвал.Параметры.Покупатель = ДанныеПечати.КлиентДоговораНаименование+Символы.ПС+
		                                    "Паспорт: "+ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер+Символы.ПС+
                                            "Выдан: "+ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy")+Символы.ПС+
                                            "Адрес регистрации: "+ДанныеПечати.КлиентАдрес+Символы.ПС+
											"Тел. "+ДАнныеПечати.КлиентОсновнойТелефон+Символы.ПС+
											"E-mail: "+ДанныеПечати.КлиентОсновнойEmail;
		ТабДокумент.Вывести(СтрокаПодвал);
		
		Подписи = МакетПредварительногоДоговора.ПолучитьОбласть("Подписи");	
		Подписи.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентДоговораНаименование;
		Подписи.Параметры.ФИООтветственного = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
		ТабДокумент.Вывести(Подписи);
		
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ПечатьОсновногоДоговора(ДанныеПечати)
	
	МакетОсновногоДоговора = ПолучитьМакет("МакетОсновногоДоговора");
	ОбластьШапки = МакетОсновногоДоговора.ПолучитьОбласть("Шапка");
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	
	ТЗСостав = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 
							
		ОбластьШапки.Параметры.НаименованиеПокупателя  = ДанныеПечати.КлиентДоговораНаименование;
	    ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизации;						
        ОбластьШапки.Параметры.ДатаДоговора            = Формат(ДанныеПечати.ДатаДоговора,"ДФ=dd.MM.yyyy");
        ОбластьШапки.Параметры.НомерДоговора           = ДанныеПечати.НомерДоговора;
		ФИООтветственного = "";
		ПОЛ = обОпределитьПол(?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице));
		Если DMS_ФизическиеЛицаСервер.Просклонять(?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице),2,ФИООтветственного,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
		КонецЕсли;

		ОбластьШапки.Параметры.ФИООтветственного = ФИООтветственного;
		ОбластьШапки.Параметры.УставОрганизации        = ДанныеПечати.ДилерПодписантНаОсновании;	
		ОбластьШапки.Параметры.Город                   = ""+ОпределитьГородДляПродвинутогоПакета();

		ТабДокумент.Вывести(ОбластьШапки);
		
		СтрокаАвтомобиль = МакетОсновногоДоговора.ПолучитьОбласть("СтрокаАвтомобиль");
		ЗаполнитьЗначенияСвойств(СтрокаАвтомобиль.Параметры, СтрокаТЗ);	
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерШассиПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерШассиПТС = "ОТСУТСТВУЕТ";
		КонецЕсли;
		СтрокаАвтомобиль.Параметры.ДатаПТС = Формат(СтрокаТЗ.ДатаПТС, "ДЛФ=DD");

		ТабДокумент.Вывести(СтрокаАвтомобиль);
		
		Если СтрокаТЗ.ВключитьТрейдИнВДоговор Тогда		
			
			СтрокаРасчетов2_1 = МакетОсновногоДоговора.ПолучитьОбласть("ПрограммаТрейдИн");	
			
			//ЗаполнитьЗначенияСвойств(СтрокаРасчетов2_1.Параметры, СтрокаТЗ);
			
			ЗаявкаНаТрейдИн = СтрокаТЗ.ЗаявкаНаТрейдИн;
			
			Если ЗначениеЗаполнено(ЗаявкаНаТрейдИн) Тогда
				
				АвтоТрейдИн = ЗаявкаНаТрейдИн.Автомобиль;
								
				СтрокаРасчетов2_1.Параметры.ДатаВладения       = "";
				СтрокаРасчетов2_1.Параметры.ГодИзготовленияПТС = Формат(АвтоТрейдИн.ГодВыпуска, "ДФ=yyyy");
				СтрокаРасчетов2_1.Параметры.МаркаМодельПТС     = АвтоТрейдИн.Модель;
				СтрокаРасчетов2_1.Параметры.VIN                = АвтоТрейдИн.VIN;
				СтрокаРасчетов2_1.Параметры.ГРН                = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтоТрейдИн, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);;
				СтрокаРасчетов2_1.Параметры.НомерКузоваПТС     = АвтоТрейдИн.НомерКузова;
				СтрокаРасчетов2_1.Параметры.НомерДвигателяПТС  = АвтоТрейдИн.НомерДвигателя;
				СтрокаРасчетов2_1.Параметры.НомерШассиПТС      = АвтоТрейдИн.НомерШасси;
				ПТС = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтоТрейдИн, Перечисления.ДополнительнаяИнформацияАвтомобилей.ТехПаспорт);
				Если ЗначениеЗаполнено(ПТС) Тогда
					СтрокаРасчетов2_1.Параметры.ПТС     = ПТС.Серия+ " " + ПТС.Номер;
					СтрокаРасчетов2_1.Параметры.ДатаПТС = Формат(ПТС.ДатаВыдачи,"ДФ=dd.MM.yyyy");
				КонецЕсли;	
				СтрокаРасчетов2_1.Параметры.Пробег  = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(АвтоТрейдИн, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);
