Процедура ПечатьСогласиеНаОбработкуПерсональныхДанных(ДанныеПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;
	МакетСогласиеНаОбработкуПерсональныхДанных = ПолучитьМакет("МакетСогласиеНаОбработкуПерсональныхДанных");
	ОбластьШапки = МакетСогласиеНаОбработкуПерсональныхДанных.ПолучитьОбласть("Шапка");
		
	ОбластьШапки.Параметры.ДатаДоговора   = Формат(ДанныеПечати.ДатаДоговора,"ДЛФ=D");
	ОбластьШапки.Параметры.НомерДоговора  = ДанныеПечати.НомерДоговора;
	ОбластьШапки.Параметры.Оператор       = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое + Символы.ПС+
	                                        "ОГРН: "+ДанныеПечати.ДилерОГРН+ Символы.ПС+
											"ИНН/КПП: "+ДанныеПечати.ДилерИНН+"/"+ДанныеПечати.ДилерКПП+ Символы.ПС+
											"Юридический адрес: "+ДанныеПечати.ДилерАдресЮридический;
	
	ОбластьШапки.Параметры.Субъект        = ДанныеПечати.КлиентДоговораНаименование+" – потребитель, обратившийся в "+
	                                        ДанныеПечати.ДилерНаименованиеОрганизацииКраткое+" за приобретением автомобиля (паспорт: серия "+
										    ДанныеПечати.КлиентПаспортСерия+", номер "+ДанныеПечати.КлиентПаспортНомер+")";
											
	ОбластьШапки.Параметры.НаименованиеПокупателя  = ДанныеПечати.КлиентДоговораНаименование;						
	ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое;						
	
	ОбластьШапки.Параметры.Покупатель     = ДанныеПечати.КлиентФамилия+" "+ЛЕВ(ДанныеПечати.КлиентИмя,1)+ "."+ЛЕВ(ДанныеПечати.КлиентОтчество,1)+".";
	
	ОбластьШапки.Параметры.Паспорт    = ДанныеПечати.КлиентПаспортСерия + " "+ДанныеПечати.КлиентПаспортНомер;
	ОбластьШапки.Параметры.Выдан      = ДанныеПечати.КлиентПаспортВыданКем+" от "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy")+"г.";
	
	ТабДокумент.Вывести(ОбластьШапки);
	
	Макет = Новый Структура();
	Макет.Вставить("Тип",ВРег("mxl"));
	Макет.Вставить("ПечатнаяФорма",ТабДокумент);
	Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
				
КонецПроцедуры

