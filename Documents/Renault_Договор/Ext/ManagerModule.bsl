				СтрокаРасчетов2_2.Параметры.СуммаИтог2         = СтрокаТЗ.СуммаКредита;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью2 = обЧислоПрописью(СтрокаТЗ.СуммаКредита,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			Иначе
				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Шапка2_5"); 				СтрокаРасчетов2_2.Параметры.СуммаИтог1         = СтрокаТЗ.СуммаПредоплаты;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью1 = обЧислоПрописью(СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
				СтрокаРасчетов2_2.Параметры.СуммаИтог2         =  СтрокаТЗ.ОбщаяСуммаПоАвтомобилю-СтрокаТЗ.СуммаПредоплаты-СтрокаТЗ.СуммаКредита;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью2 = обЧислоПрописью( СтрокаТЗ.ОбщаяСуммаПоАвтомобилю-СтрокаТЗ.СуммаПредоплаты-СтрокаТЗ.СуммаКредита,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
				СтрокаРасчетов2_2.Параметры.СуммаИтог3         = СтрокаТЗ.СуммаКредита;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью3 = обЧислоПрописью(СтрокаТЗ.СуммаКредита,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			КонецЕсли;	
			Если ЗначениеЗаполнено(ДанныеПечати.Ссылка.ЗаявкаНаКредит) Тогда
				СтрокаРасчетов2_2.Параметры.Банк = ДанныеПечати.Ссылка.ЗаявкаНаКредит.Банк;
