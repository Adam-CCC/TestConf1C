	Запрос.УстановитьПараметр("Ссылка", ДоговорСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВалютаРубли = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	Тариф = Renault_CRM.ПолучитьТекущийТарифНаАвтомобили(ДоговорСсылка.ДатаДоговора);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;
	Если Выборка.Следующий() Тогда
		
		Если ТипМакета = "МакетСпецификация" Тогда
			ПечатьСпецификации(Выборка);
		ИначеЕсли ТипМакета = "МакетНаправлениеВКассу" Тогда
			ПечатьНаправлениеВКассу(Выборка);
		ИначеЕсли ТипМакета = "МакетОсновногоДоговора" Тогда
			
			ТЗСостав = Выборка.СоставДоговора.Выгрузить(); 
			Если ТЗСостав.Количество()>0 Тогда
				ВидАвтомобиля = ОпределитьВидАвтомобиля(ТЗСостав[0].Автомобиль);
				Если ВидАвтомобиля = Перечисления.ВидАвтомобиля.DMS_Выкуп Или ВидАвтомобиля = Перечисления.ВидАвтомобиля.DMS_Зачет Тогда
					ПечатьОсновногоДоговораВыкупАвто(Выборка);
				ИначеЕсли ВидАвтомобиля = Перечисления.ВидАвтомобиля.DMS_Комиссия Тогда
					ПечатьОсновногоДоговораКомисАвто(Выборка);
				ИначеЕсли ВидАвтомобиля = Перечисления.ВидАвтомобиля.DMS_Агентский Тогда
					ПечатьОсновногоДоговораАгентАвто(Выборка);
				ИначеЕсли ВидАвтомобиля = "Демо" Тогда
					ПечатьОсновногоДоговораДемоАвто(Выборка);
				Иначе
					ПечатьОсновногоДоговора(Выборка); //новый авто
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТипМакета = "МакетПредварительногоДоговора" Тогда
			ПечатьПредварительногоДоговора(Выборка);
		ИначеЕсли ТипМакета = "МакетДоверенностьГИБДД" Тогда
			ПечатьДоверенностьГИБДД(Выборка);
		ИначеЕсли ТипМакета = "МакетСогласиеНаОбработкуПерсональныхДанных" Тогда
			ПечатьСогласиеНаОбработкуПерсональныхДанных(Выборка);
		ИначеЕсли ТипМакета = "МакетАктПриемаПередачиАвтомобиля" Тогда
			
			ТЗСостав = Выборка.СоставДоговора.Выгрузить(); 
			Если ТЗСостав.Количество()>0 Тогда
				ТипАвтомобиля = ОпределитьВидАвтомобиля(ТЗСостав[0].Автомобиль);
				// начало добавление Зеленчук
				Если Выборка.КлиентФормаСобственности = Перечисления.ФормыСобственности.ЮридическоеЛицо Тогда
					ПечатьАктПриемаПередачиАвтомобиляКорп(Выборка);
				Иначе
					// окончание добавления Зеленчук
					Если ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.БУ Или
						ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.Зачет Или 
						ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.Комиссия Тогда
						ПечатьАктПриемаПередачиАвтомобиляВыкуп(Выборка);
					ИначеЕсли ТипАвтомобиля = Справочники.Renault_ТипыАвтомобилей.Агентский Тогда
						ПечатьАктПриемаПередачиАвтомобиляАгент(Выборка);
					ИначеЕсли ТипАвтомобиля = "Демо" Тогда
						ПечатьАктПриемаПередачиАвтомобиляДемо(Выборка);
					Иначе
						ПечатьАктПриемаПередачиАвтомобиля(Выборка); //новый
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТипМакета = "МакетАктПриемаПередачиНаУтилизацию" Тогда
			ПечатьАктПриемаПередачиНаУтилизацию(Выборка);
		ИначеЕсли ТипМакета = "МакетГарантийноеПисьмо" Тогда
			ПечатьГарантийноеПисьмо(Выборка);
		ИначеЕсли ТипМакета = "МакетОтчетКомиссионера" Тогда
			ПечатьОтчетКомиссионера(Выборка);
		ИначеЕсли ТипМакета = "МакетОтчетАгента" Тогда
			ПечатьОтчетАгента(Выборка);
		ИначеЕсли ТипМакета = "МакетДоговорКорп" Тогда
			ПечатьДоговораКорп(Выборка)
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

