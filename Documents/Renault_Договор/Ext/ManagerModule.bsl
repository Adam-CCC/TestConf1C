		Если DMS_ФизическиеЛицаСервер.Просклонять(?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице),2,ФИООтветственного,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
		КонецЕсли;

		ОбластьШапки.Параметры.ФИООтветственного = ФИООтветственного;

		ОбластьШапки.Параметры.УставОрганизации        = ДанныеПечати.ДилерПодписантНаОсновании;	
		ОбластьШапки.Параметры.Город                   = ""+ОпределитьГородДляПродвинутогоПакета();

		ОбластьШапки.Параметры.МаркаМодельПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ЗаявкаНаТрейдИн), ""+СтрокаТЗ.ЗаявкаНаТрейдИн.ПроизводительКод +" "+СтрокаТЗ.Автомобиль.Модель.Наименование,СтрокаТЗ.Автомобиль.Модель.Наименование);
		
		ТабДокумент.Вывести(ОбластьШапки);
		
		СтрокаАвтомобиль = МакетОсновногоДоговора.ПолучитьОбласть("СтрокаАвтомобиль");
		ЗаполнитьЗначенияСвойств(СтрокаАвтомобиль.Параметры, СтрокаТЗ);	
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерШассиПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерШассиПТС = "ОТСУТСТВУЕТ";
		КонецЕсли;
		СтрокаАвтомобиль.Параметры.МаркаМодельПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ЗаявкаНаТрейдИн), ""+СтрокаТЗ.ЗаявкаНаТрейдИн.ПроизводительКод +" "+СтрокаТЗ.Автомобиль.Модель.Наименование,СтрокаТЗ.Автомобиль.Модель.Наименование);
		
		Если Не ЗначениеЗаполнено(СтрокаТЗ.ЦветКузоваПТС) Тогда
			СтрокаАвтомобиль.Параметры.ЦветКузоваПТС = СтрокаТЗ.Автомобиль.Цвет;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерДвигателяПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерДвигателяПТС = СтрокаТЗ.Автомобиль.НомерДвигателя;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерКузоваПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерКузоваПТС = СтрокаТЗ.Автомобиль.НомерКузова;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерШассиПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерШассиПТС = СтрокаТЗ.Автомобиль.НомерШасси;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.ГодИзготовленияПТС) Тогда
			СтрокаАвтомобиль.Параметры.ГодИзготовленияПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ГодВыпуска),Формат(СтрокаТЗ.ГодВыпуска,"ДФ=yyyy"), Формат(СтрокаТЗ.Автомобиль.ГодВыпуска,"ДФ=yyyy"));
		КонецЕсли;	
		
		ПТС = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаТЗ.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ТехПаспорт);
		
		Если ЗначениеЗаполнено(ПТС) Тогда
