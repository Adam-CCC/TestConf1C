		СтрокаАвтомобиль.Параметры.Пробег   = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаТЗ.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);	
		
		ТабДокумент.Вывести(СтрокаАвтомобиль);
		
		СтрокаРасчетов2_1 = МакетОсновногоДоговора.ПолучитьОбласть("Шапка2_1");	
		
		СтрокаРасчетов2_1.Параметры.СуммаИтог         = ДанныеПечати.СуммаДоговора;
		СтрокаРасчетов2_1.Параметры.СуммаИтогПрописью = обЧислоПрописью(ДанныеПечати.СуммаДоговора,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
		
		ТабДокумент.Вывести(СтрокаРасчетов2_1);
		
		Если СтрокаТЗ.СуммаКредита <> 0 Тогда  //Кредит	
			
			Если СтрокаТЗ.ОбщаяСуммаПоАвтомобилю = СтрокаТЗ.СуммаПредоплаты+СтрокаТЗ.СуммаКредита Тогда
				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Шапка2_4"); 
				СтрокаРасчетов2_2.Параметры.СуммаИтог1         = СтрокаТЗ.СуммаПредоплаты;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью1 = обЧислоПрописью(СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
				СтрокаРасчетов2_2.Параметры.СуммаИтог2         = СтрокаТЗ.СуммаКредита;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью2 = обЧислоПрописью(СтрокаТЗ.СуммаКредита,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			Иначе
				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Шапка2_5"); 				СтрокаРасчетов2_2.Параметры.СуммаИтог1         = СтрокаТЗ.СуммаПредоплаты;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью1 = обЧислоПрописью(СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
				СтрокаРасчетов2_2.Параметры.СуммаИтог2         =  СтрокаТЗ.ОбщаяСуммаПоАвтомобилю-СтрокаТЗ.СуммаПредоплаты-СтрокаТЗ.СуммаКредита;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью2 = обЧислоПрописью( СтрокаТЗ.ОбщаяСуммаПоАвтомобилю-СтрокаТЗ.СуммаПредоплаты-СтрокаТЗ.СуммаКредита,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
				СтрокаРасчетов2_2.Параметры.СуммаИтог3         = СтрокаТЗ.СуммаКредита;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью3 = обЧислоПрописью(СтрокаТЗ.СуммаКредита,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			КонецЕсли;	
			Если ЗначениеЗаполнено(ДанныеПечати.Ссылка.ЗаявкаНаКредит) Тогда
				СтрокаРасчетов2_2.Параметры.Банк = ДанныеПечати.Ссылка.ЗаявкаНаКредит.Банк;
			КонецЕсли;
		Иначе //Наличные	
			Если ДанныеПечати.СуммаДоговора = СтрокаТЗ.СуммаПредоплаты Тогда  
				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Пункт2_2");
				СтрокаРасчетов2_2.Параметры.СуммаИтог         = ДанныеПечати.СуммаДоговора;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью = обЧислоПрописью(ДанныеПечати.СуммаДоговора,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			Иначе			                                                  
				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Пункт2_3");
				СтрокаРасчетов2_2.Параметры.СуммаИтог1         = СтрокаТЗ.СуммаПредоплаты;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью1 = обЧислоПрописью(СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
				СтрокаРасчетов2_2.Параметры.СуммаИтог2         = ДанныеПечати.СуммаДоговора-СтрокаТЗ.СуммаПредоплаты;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью2 = обЧислоПрописью(ДанныеПечати.СуммаДоговора-СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			КонецЕсли;			
		КонецЕсли;
			
		ТабДокумент.Вывести(СтрокаРасчетов2_2);			

		Подвал = МакетОсновногоДоговора.ПолучитьОбласть("Подвал");
		ТабДокумент.Вывести(Подвал);
		
        СтрокаПодвал = МакетОсновногоДоговора.ПолучитьОбласть("СтрокаПодвал");
		СтрокаПодвал.Параметры.Продавец   = ""+ДанныеПечати.ДилерНаименованиеОрганизацииКраткое + Символы.ПС+
		                                    "Юридический адрес: "+ДанныеПечати.ДилерАдресЮридический+Символы.ПС+
										    "Тел: "+ДанныеПечати.ДилерТелефон+Символы.ПС+
                                            "ИНН: "+ДанныеПечати.ДилерИНН+" КПП: "+ДанныеПечати.ДилерКПП+Символы.ПС+          
	                                        "ОГРН: "+ДанныеПечати.ДилерОГРН+Символы.ПС+
											"р/с "+ДанныеПечати.ДилерСчет+" в"+Символы.ПС+
											ДанныеПечати.ДилерБанк+Символы.ПС+
											"к/с "+ДанныеПечати.ДилерКоррСчет+", БИК"+Символы.ПС+ 
											ДанныеПечати.ДилерБИК+Символы.ПС+ 
											"ОКВЭД: "+ДанныеПечати.ДилерОКВЭД+" ОКПО: "+ДанныеПечати.ДилерОКПО;
        СтрокаПодвал.Параметры.Покупатель = ДанныеПечати.КлиентДоговораНаименование+Символы.ПС+
		                                    "Паспорт: "+ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер+Символы.ПС+
                                            "Выдан: "+ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy")+"г."+Символы.ПС+
                                            "Адрес регистрации: "+ДанныеПечати.КлиентАдрес+Символы.ПС+
											"Тел. "+ ДанныеПечати.КлиентОсновнойТелефон+Символы.ПС+
											"E-mail: "+ДанныеПечати.КлиентОсновнойEmail+Символы.ПС+
											"Дата рождения: "+ Формат(ДанныеПечати.КлиентДатаРождения,"ДФ=dd.MM.yyyy")+"г.";
											
		ТабДокумент.Вывести(СтрокаПодвал);
		
        Подписи                                  = МакетОсновногоДоговора.ПолучитьОбласть("Подписи");
		Подписи.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентДоговораНаименование;
        Подписи.Параметры.ФИООтветственного      = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
		ТабДокумент.Вывести(Подписи);
				
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ПечатьОсновногоДоговораАгентАвто(ДанныеПечати)
	
	МакетОсновногоДоговора = ПолучитьМакет("МакетОсновногоДоговораАгентАвто");
	ОбластьШапки = МакетОсновногоДоговора.ПолучитьОбласть("Шапка");
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	
	ТЗСостав = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 
		
		ДанныеАгента = ПолучитьДанныеАгента(СтрокаТЗ.Автомобиль);
							
		ОбластьШапки.Параметры.НаименованиеПокупателя  = ДанныеПечати.КлиентДоговораНаименование;
	    ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое;	
		Если ЗначениеЗаполнено(ДанныеАгента) Тогда
			ОбластьШапки.Параметры.Агент               = ДанныеАгента.Агент;
			ОбластьШапки.Параметры.УставОрганизации        = "Доверенности (Приложение №2 к Агентскому договору № "+ДанныеАгента.НомерДоговора+" от "+Формат(ДанныеАгента.ДатаДоговора, "ДЛФ=DD");	
		КонецЕсли;
        ОбластьШапки.Параметры.ДатаДоговора            = Формат(ДанныеПечати.ДатаДоговора, "ДФ=dd.MM.yyyy");
        ОбластьШапки.Параметры.НомерДоговора           = ДанныеПечати.НомерДоговора;
		ФИООтветственного = "";
		ПОЛ = обОпределитьПол(?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице));
		Если DMS_ФизическиеЛицаСервер.Просклонять(?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице),2,ФИООтветственного,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
		КонецЕсли;

		ОбластьШапки.Параметры.ФИООтветственного = ФИООтветственного;
		ОбластьШапки.Параметры.Город                   = ""+ОпределитьГородДляПродвинутогоПакета();

		ТабДокумент.Вывести(ОбластьШапки);
		
		СтрокаАвтомобиль = МакетОсновногоДоговора.ПолучитьОбласть("СтрокаАвтомобиль");
		ЗаполнитьЗначенияСвойств(СтрокаАвтомобиль.Параметры, СтрокаТЗ);	
		
		Если ЗначениеЗаполнено(ДанныеАгента) Тогда
			СтрокаАвтомобиль.Параметры.НомерДоговораАгента = ДанныеАгента.НомерДоговора;
			СтрокаАвтомобиль.Параметры.ДатаДоговораАгента  = Формат(ДанныеАгента.ДатаДоговора, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерШассиПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерШассиПТС = "ОТСУТСТВУЕТ";
		КонецЕсли;
		СтрокаАвтомобиль.Параметры.МаркаМодельПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ЗаявкаНаТрейдИн), ""+СтрокаТЗ.ЗаявкаНаТрейдИн.ПроизводительКод +" "+СтрокаТЗ.Автомобиль.Модель.Наименование,СтрокаТЗ.Автомобиль.Модель.Наименование);

		Если Не ЗначениеЗаполнено(СтрокаТЗ.ЦветКузоваПТС) Тогда
			СтрокаАвтомобиль.Параметры.ЦветКузоваПТС = СтрокаТЗ.Автомобиль.Цвет;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерДвигателяПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерДвигателяПТС = СтрокаТЗ.Автомобиль.НомерДвигателя;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерКузоваПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерКузоваПТС = СтрокаТЗ.Автомобиль.НомерКузова;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.НомерШассиПТС) Тогда
			СтрокаАвтомобиль.Параметры.НомерШассиПТС = СтрокаТЗ.Автомобиль.НомерШасси;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТЗ.ГодИзготовленияПТС) Тогда
			СтрокаАвтомобиль.Параметры.ГодИзготовленияПТС = ?(ЗначениеЗаполнено(СтрокаТЗ.ГодВыпуска),Формат(СтрокаТЗ.ГодВыпуска,"ДФ=yyyy"), Формат(СтрокаТЗ.Автомобиль.ГодВыпуска,"ДФ=yyyy"));
		КонецЕсли;	
		
		ПТС = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаТЗ.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ТехПаспорт);
		
		Если ЗначениеЗаполнено(ПТС) Тогда
			СтрокаАвтомобиль.Параметры.ПТС     = ПТС.Серия+" "+ПТС.Номер;  
			СтрокаАвтомобиль.Параметры.ОрганизацияИзготовительПТС = ПТС.КемВыдан;
			СтрокаАвтомобиль.Параметры.АдресИзготовителяПТС = ПТС.АдресВыдачи;
			СтрокаАвтомобиль.Параметры.ДатаПТС = Формат(ПТС.ДатаВыдачи,"ДЛФ=DD");
		КонецЕсли;		

		СтрокаАвтомобиль.Параметры.ГосНомер = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаТЗ.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
		СтрокаАвтомобиль.Параметры.Пробег   = Справочники.Автомобили.ЧтениеЗначенияРегистраСведения(СтрокаТЗ.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.Пробег);	
		
		ТабДокумент.Вывести(СтрокаАвтомобиль);
		
		СтрокаРасчетов2_1 = МакетОсновногоДоговора.ПолучитьОбласть("Шапка2_1");	
		
		СтрокаРасчетов2_1.Параметры.СуммаИтог         = ДанныеПечати.СуммаДоговора;
		СтрокаРасчетов2_1.Параметры.СуммаИтогПрописью = обЧислоПрописью(ДанныеПечати.СуммаДоговора,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
		
		ТабДокумент.Вывести(СтрокаРасчетов2_1);
		
		СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Пункт2_2");

		Если ЗначениеЗаполнено(ДанныеАгента) Тогда
			СтрокаРасчетов2_2.Параметры.НомерДоговораАгента = ДанныеАгента.НомерДоговора;
			СтрокаРасчетов2_2.Параметры.ДатаДоговораАгента  = Формат(ДанныеАгента.ДатаДоговора, "ДФ=dd.MM.yyyy");
		КонецЕсли;
			
		ТабДокумент.Вывести(СтрокаРасчетов2_2);			

		Подвал = МакетОсновногоДоговора.ПолучитьОбласть("Подвал");
		ТабДокумент.Вывести(Подвал);
		
        СтрокаПодвал = МакетОсновногоДоговора.ПолучитьОбласть("СтрокаПодвал");
		
		Если ЗначениеЗаполнено(ДанныеАгента) Тогда

			СтрокаПодвал.Параметры.Продавец = ДанныеАгента.Агент+Символы.ПС+
			                                    "Паспорт: "+ДанныеАгента.Серия+" "+ДанныеАгента.Номер+Символы.ПС+
	                                            "Выдан: "+ДанныеАгента.КемВыдан+", "+Формат(ДанныеАгента.ДатаВыдачи,"ДФ=dd.MM.yyyy")+"г."+Символы.ПС+
	                                            "Адрес регистрации: "+ДанныеАгента.Адрес+Символы.ПС+
												"Тел. "+ ДанныеАгента.ОсновнойТелефон+Символы.ПС+
												"E-mail: "+ДанныеАгента.Email+Символы.ПС+
												"Дата рождения: "+ Формат(ДанныеАгента.ДатаРождения,"ДФ=dd.MM.yyyy")+"г.";
												
		КонецЕсли;

        СтрокаПодвал.Параметры.Покупатель = ДанныеПечати.КлиентДоговораНаименование+Символы.ПС+
		                                    "Паспорт: "+ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер+Символы.ПС+
                                            "Выдан: "+ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy")+"г."+Символы.ПС+
                                            "Адрес регистрации: "+ДанныеПечати.КлиентАдрес+Символы.ПС+
											"Тел. "+ ДанныеПечати.КлиентОсновнойТелефон+Символы.ПС+
											"E-mail: "+ДанныеПечати.КлиентОсновнойEmail+Символы.ПС+
											"Дата рождения: "+ Формат(ДанныеПечати.КлиентДатаРождения,"ДФ=dd.MM.yyyy")+"г.";
											
		ТабДокумент.Вывести(СтрокаПодвал);
		
        Подписи                                  = МакетОсновногоДоговора.ПолучитьОбласть("Подписи");
		
		ФИООтветственного                       = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
		Фамилия  = ЛЕВ(ФИООтветственного, Найти(ФИООтветственного," ")-1);
		ФИООтветственного = ПРАВ(ФИООтветственного, СтрДлина(ФИООтветственного)-СтрДлина(Фамилия)-1);
		Имя      = ЛЕВ(ФИООтветственного, Найти(ФИООтветственного," ")-1);
        ФИООтветственного = ПРАВ(ФИООтветственного, СтрДлина(ФИООтветственного)-СтрДлина(Имя)-1);
		Отчество = ФИООтветственного;
		Подписи.Параметры.ФИООтветственного      = Фамилия+" "+ЛЕВ(Имя,1)+"."+ЛЕВ(Отчество,1)+".";
		Подписи.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентФамилия+" "+ЛЕВ(ДанныеПечати.КлиентИмя,1)+ "."+ЛЕВ(ДанныеПечати.КлиентОтчество,1)+".";

		ТабДокумент.Вывести(Подписи);
				
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;
			
КонецПроцедуры

Функция ПолучитьДанныеАгента(Автомобиль)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.Наименование КАК Агент,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.ДоговорВзаиморасчетов.ДатаНачала КАК ДатаДоговора,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.ДоговорВзаиморасчетов.НомерДоговора КАК НомерДоговора,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.ОсновнойТелефон КАК ОсновнойТелефон,
	|	ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент.ДатаРождения КАК ДатаРождения,
	|	ПодтверждающиеДокументы.КемВыдан,
	|	ПодтверждающиеДокументы.Серия,
	|	ПодтверждающиеДокументы.Номер,
	|	ПодтверждающиеДокументы.ДатаВыдачи,
	|	КонтактнаяИнформацияЭмейл.Представление КАК Email,
	|	КонтактнаяИнформация.Представление КАК Адрес
	|ИЗ
	|	Документ.ПоступлениеАвтомобилей.Автомобили КАК ПоступлениеАвтомобилейАвтомобили
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодтверждающиеДокументы КАК ПодтверждающиеДокументы
	|		ПО ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент = ПодтверждающиеДокументы.Владелец
	|			И (ПодтверждающиеДокументы.ВидПодтверждающегоДокумента = &Паспорт)
	|			И (ПодтверждающиеДокументы.Текущий)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент = КонтактнаяИнформация.Объект
	|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияЭмейл
	|		ПО ПоступлениеАвтомобилейАвтомобили.Ссылка.Контрагент = КонтактнаяИнформацияЭмейл.Объект
	|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|			И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий))
	|ГДЕ
	|	ПоступлениеАвтомобилейАвтомобили.Автомобиль = &Автомобиль
	|	И ПоступлениеАвтомобилейАвтомобили.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("Паспорт", Перечисления.ВидыДокументов.Паспорт);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Возврат Результат.Выгрузить()[0];
	КонецЕсли;
	
КонецФункции

Процедура ПечатьГарантийноеПисьмо(ДанныеПечати)
	
	МакетГарантийноеПисьмо = ПолучитьМакет("МакетГарантийноеПисьмо");
	ОбластьШапки           = МакетГарантийноеПисьмо.ПолучитьОбласть("Шапка");
	ТабДокумент            = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева  = 5;
	ТабДокумент.ПолеСправа = 5;
	ТЗСостав               = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 

		ОбластьШапки.Параметры.МестоПередачи = "От: " +ДанныеПечати.ДилерНаименованиеОрганизацииКраткое + Символы.ПС+
		                                               ДанныеПечати.ДилерАдресЮридический+Символы.ПС+
											 "Тел: "  +ДанныеПечати.ДилерТелефон+Символы.ПС+
                                             "ИНН: "  +ДанныеПечати.ДилерИНН+" КПП: "+ДанныеПечати.ДилерКПП+Символы.ПС+          
	                                         "ОГРН: " +ДанныеПечати.ДилерОГРН+Символы.ПС+
											 "р/с "   +ДанныеПечати.ДилерСчет+" в"+Символы.ПС+
											           ДанныеПечати.ДилерБанк+Символы.ПС+
											 "к/с "   +ДанныеПечати.ДилерКоррСчет+", БИК"+Символы.ПС+ 
											           ДанныеПечати.ДилерБИК+Символы.ПС+ 
											 "ОКВЭД: "+ДанныеПечати.ДилерОКВЭД+" ОКПО: "+ДанныеПечати.ДилерОКПО;
											 
		ОбластьШапки.Параметры.Кому          = "Кому: "   +ДанныеПечати.Ссылка.ЗаявкаНаКредит.Банк;

		ЗаполнитьЗначенияСвойств(ОбластьШапки.Параметры,СтрокаТЗ);
							
		ОбластьШапки.Параметры.Паспорт    = "паспорт: "+ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер;
		ОбластьШапки.Параметры.Выдан      = "выдан: "+ДанныеПечати.КлиентПаспортВыданКем;
		ОбластьШапки.Параметры.ДатаВыдачи = "дата выдачи: "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy");

		ОбластьШапки.Параметры.НаименованиеПокупателя  = ДанныеПечати.КлиентДоговораНаименование;
	    ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое;						
        ОбластьШапки.Параметры.ДатаДоговора            = Формат(ДанныеПечати.ДатаДоговора,"ДФ=dd.MM.yyyy");
        ОбластьШапки.Параметры.НомерДоговора           = ДанныеПечати.НомерДоговора;
		
		//Чтение значения для руководителя
		СтруктураОтбора   = Новый Структура("Организация,Объект",ДанныеПечати.Организация,Перечисления.ВидыОбъектовСведений.Руководитель);
		СтруктураСведений = РегистрыСведений.СведенияКомпании.ПолучитьПоследнее(ДанныеПечати.ДатаДоговора,СтруктураОтбора);
		
		Руководитель = СтруктураСведений.Значение;

		Если ЗначениеЗаполнено(Руководитель) Тогда
			
			РуководительДолжность = Руководитель.Должность;
			
			Если ЗначениеЗаполнено(РуководительДолжность)Тогда
				ОбластьШапки.Параметры.ОтветственныйДолжность = РуководительДолжность.Наименование+" "+ДанныеПечати.ДилерНаименованиеОрганизацииКраткое;
				РуководительДолжностьНаименование = РуководительДолжность.Наименование+Руководитель.Наименование;
				ФИООтветственного = "";
				ПОЛ = обОпределитьПол(РуководительДолжностьНаименование);
				Если DMS_ФизическиеЛицаСервер.Просклонять(РуководительДолжностьНаименование,2,ФИООтветственного,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
				КонецЕсли;

				ОбластьШапки.Параметры.ФИООтветственного = ФИООтветственного;

			КонецЕсли;
			
			Фамилия           = ЛЕВ(Руководитель.Наименование, Найти(Руководитель.Наименование," ")-1);
			ФИООтветственного = ПРАВ(Руководитель.Наименование, СтрДлина(Руководитель.Наименование)-СтрДлина(Фамилия)-1);
			Имя               = ЛЕВ(ФИООтветственного, Найти(ФИООтветственного," ")-1);
	        ФИООтветственного = ПРАВ(ФИООтветственного, СтрДлина(ФИООтветственного)-СтрДлина(Имя)-1);
			Отчество          = ФИООтветственного;
			
			ОбластьШапки.Параметры.ФИООтветственногоСокр = Фамилия+" "+ЛЕВ(Имя,1)+"."+ЛЕВ(Отчество,1)+".";
			
		КонецЕсли;
		
		ОбластьШапки.Параметры.СуммаИтогПрописью = обЧислоПрописью(ДанныеПечати.СуммаДоговора,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
		ОбластьШапки.Параметры.СуммаИтог         = ДанныеПечати.СуммаДоговора;
		
		ТабДокумент.Вывести(ОбластьШапки);
		
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ПечатьАктПриемаПередачиНаУтилизацию(ДанныеПечати)
	
	МакетАктПриемаПередачиНаУтилизацию = ПолучитьМакет("МакетАктПриемаПередачиНаУтилизацию");
	ОбластьШапки = МакетАктПриемаПередачиНаУтилизацию.ПолучитьОбласть("Шапка");
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;	
	ТЗСостав = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 
		
		ОбластьШапки.Параметры.АдресУтилизации              = ДанныеПечати.УтилизаторАдрес;
		ОбластьШапки.Параметры.НаименованиеПунктаУтилизации = ДанныеПечати.Утилизатор;
		
		ОбластьШапки.Параметры.НомерАкта = ДанныеПечати.УтилНомерИДатаАктаСдачи;

		ОбластьШапки.Параметры.УтилМаркаМодель = ДанныеПечати.УтилМаркаМодель;
					
		ТабДокумент.Вывести(ОбластьШапки);
		
		ОбластьСтрокаАвтомобиль = МакетАктПриемаПередачиНаУтилизацию.ПолучитьОбласть("СтрокаАвтомобиль");
		
		ОбластьСтрокаАвтомобиль.Параметры.Паспорт    = ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер+" от "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy")+"г.";
		ОбластьСтрокаАвтомобиль.Параметры.Выдан      = ДанныеПечати.КлиентПаспортВыданКем;

		ФИООтветственного = "";
		ПОЛ = обОпределитьПол(ДанныеПечати.КлиентДоговораНаименование);
		Если DMS_ФизическиеЛицаСервер.Просклонять(ДанныеПечати.КлиентДоговораНаименование,2,ФИООтветственного,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
		КонецЕсли;

		ОбластьСтрокаАвтомобиль.Параметры.НаименованиеПокупателя = ФИООтветственного;
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаАвтомобиль.Параметры, ДанныеПечати);
		
		ОбластьСтрокаАвтомобиль.Параметры.УтилГодВыпуска               = Формат(ДанныеПечати.УтилГодВыпуска,"ДФ=yyyy");
		ОбластьСтрокаАвтомобиль.Параметры.АдресУтилизации              = ДанныеПечати.УтилизаторАдрес;
		ОбластьСтрокаАвтомобиль.Параметры.НаименованиеПунктаУтилизации = ДанныеПечати.Утилизатор;
		ОбластьСтрокаАвтомобиль.Параметры.ИНН = ДанныеПечати.УтилизаторИНН;
		ОбластьСтрокаАвтомобиль.Параметры.КПП = ДанныеПечати.УтилизаторКПП;
		ОбластьСтрокаАвтомобиль.Параметры.Телефон = ДанныеПечати.УтилизаторТелефон;
		Если ЗначениеЗаполнено(ДанныеПечати.УтилизаторКонтЛицо) И ЗначениеЗаполнено(ДанныеПечати.УтилизаторДолжностьКонтЛица) Тогда
			Ответственный = "";
			ФИООтветственного = "";
			ПОЛ = обОпределитьПол(ДанныеПечати.УтилизаторКонтЛицо);
			Если DMS_ФизическиеЛицаСервер.Просклонять(ДанныеПечати.УтилизаторКонтЛицо,2,Ответственный,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
			КонецЕсли;

			ОбластьСтрокаАвтомобиль.Параметры.Ответственный =Ответственный;
		    Должность = "";
			ПОЛ = обОпределитьПол(ДанныеПечати.УтилизаторДолжностьКонтЛица);
			Если DMS_ФизическиеЛицаСервер.Просклонять(ДанныеПечати.УтилизаторДолжностьКонтЛица,2,Должность,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
			КонецЕсли;
			ОбластьСтрокаАвтомобиль.Параметры.Должность = Должность;
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьСтрокаАвтомобиль);
				
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ПечатьАктПриемаПередачиАвтомобиля(ДанныеПечати)
	Если ПараметрыСеанса.DMS_Бренд = СПравочники.CRM_МаркаАвтомобиля.LADA Тогда 
		МакетАктПриемаПередачиАвтомобиля = ПолучитьМакет("МакетАктПриемаПередачиАвтомобиляLADA");
	Иначе
		МакетАктПриемаПередачиАвтомобиля = ПолучитьМакет("МакетАктПриемаПередачиАвтомобиля");
	КонецЕсли;
	ОбластьШапки = МакетАктПриемаПередачиАвтомобиля.ПолучитьОбласть("Шапка");
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;	
	Если ЗначениеЗаполнено(ДанныеПечати.ДатаАктаПередачи) Тогда
		ДатаНадпись = Формат(ДанныеПечати.ДатаАктаПередачи,"ДФ='дд ММММ гггг'");
	Иначе	
		ДатаНадпись = Формат(ТекущаяДата(),"ДФ='дд ММММ гггг'");
 	КонецЕсли;
	
	ТЗСостав = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 

		ОбластьШапки.Параметры.НаименованиеОрганизацииПолное = ДанныеПечати.ДилерНаименованиеОрганизации;
		ОбластьШапки.Параметры.ДатаЗаполнения         =  """" + ЛЕВ(ДатаНадпись,2)+ """ "+ Сред(ДатаНадпись,4, СтрДлина(ДатаНадпись))+" г.";
		ОбластьШапки.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентДоговораНаименование;
		ОбластьШапки.Параметры.Город                  = ""+ОпределитьГородДляПродвинутогоПакета();
		ОбластьШапки.Параметры.ЮрАдрес  = "Юр. адр.:"+ДанныеПечати.ДилерАдресЮридический;
		ОбластьШапки.Параметры.ИНН      = "ИНН "+ДанныеПечати.ДилерИНН;
		ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое;						
        ОбластьШапки.Параметры.ДатаДоговора  = Формат(ДанныеПечати.ДатаДоговора, "ДФ=dd.MM.yyyy")+"г.";
        ОбластьШапки.Параметры.НомерДоговора = ДанныеПечати.НомерДоговора;

		ОбластьШапки.Параметры.ФИООтветственного = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
	    ОбластьШапки.Параметры.УставОрганизации  = ДанныеПечати.ДилерПодписантНаОсновании;
		ОбластьШапки.Параметры.МаркаМодельПТС = СтрокаТЗ.МаркаМодельПТС;
		
		ОбластьШапки.Параметры.Паспорт    = ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер;
		ОбластьШапки.Параметры.Выдан      = ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy");
		
		ТабДокумент.Вывести(ОбластьШапки);
		
		ОбластьСтрокаАвтомобиль = МакетАктПриемаПередачиАвтомобиля.ПолучитьОбласть("СтрокаАвтомобиль");
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаАвтомобиль.Параметры, СтрокаТЗ);	
		ОбластьСтрокаАвтомобиль.Параметры.Двигатель = СтрокаТЗ.РабочийОбъемДвигателяПТС+" куб.см.,"+СтрокаТЗ.МощностьДвигателяПТС+" л.с.";
		Если СтрокаТЗ.НомерШассиПТС = "" Тогда                           
			ОбластьСтрокаАвтомобиль.Параметры.НомерШассиПТС = "ОТСУТСТВУЕТ";
		КонецЕсли;
		ОбластьСтрокаАвтомобиль.Параметры.ДатаПТС = Формат(СтрокаТЗ.ДатаПТС, "ДЛФ=DD");
		ТабДокумент.Вывести(ОбластьСтрокаАвтомобиль);
		
		ОбластьПодвал = МакетАктПриемаПередачиАвтомобиля.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.ПТС        = СтрокаТЗ.ПТС;
		ОбластьПодвал.Параметры.Продавец   = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое + Символы.ПС+
		                                     ДанныеПечати.ДилерАдресЮридический+Символы.ПС+
											 "Тел: "+ДанныеПечати.ДилерТелефон+Символы.ПС+
