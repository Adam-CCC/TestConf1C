		ОбластьШапки.Параметры.Покупатель     = ДанныеПечати.КлиентФамилия+" "+ЛЕВ(ДанныеПечати.КлиентИмя,1)+ "."+ЛЕВ(ДанныеПечати.КлиентОтчество,1)+".";
		ОбластьШапки.Параметры.Город          = ""+ОпределитьГородДляПродвинутогоПакета();
		ОбластьШапки.Параметры.ДатаЗаполнения = Формат(ТекущаяДата(),"ДЛФ=DD");
		
		ОбластьШапки.Параметры.Паспорт        = ДанныеПечати.КлиентПаспортСерия + " "+ДанныеПечати.КлиентПаспортНомер;
		ОбластьШапки.Параметры.Выдан          = ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy");

		ОбластьШапки.Параметры.АдресРегистрации        = ДанныеПечати.КлиентАдрес;
		
		Если ДоверенныйГИБДД<>Неопределено Тогда
			ДоверенныйГИБДДНаименование = "";
			ПОЛ = обОпределитьПол(ДоверенныйГИБДД.Наименование);
			Если DMS_ФизическиеЛицаСервер.Просклонять(ДоверенныйГИБДД.Наименование,3,ДоверенныйГИБДДНаименование,?(ПОЛ=Перечисления.ПолФизическихЛиц.Женский,2,1)) Тогда
			КонецЕсли;

			ОбластьШапки.Параметры.Доверяю  = ДоверенныйГИБДДНаименование;
			ОбластьШапки.Параметры.ДатаРожденияДоверенного = Формат(ДоверенныйГИБДД.ДатаРождения,"ДФ=dd.MM.yyyy")+"г.";
			Паспорт                                        = Справочники.ПодтверждающиеДокументы.НайтиПоРеквизиту("ВидПодтверждающегоДокумента", Перечисления.ВидыДокументов.Паспорт,,ДоверенныйГИБДД);
			Если ЗначениеЗаполнено(Паспорт) Тогда
				ОбластьШапки.Параметры.ПаспортДоверенного  = Паспорт.Серия+" "+Паспорт.Номер+" выдан: "+Паспорт.КемВыдан+", "+Формат(Паспорт.ДатаВыдачи,"ДФ=dd.MM.yyyy")+"г.";
			КонецЕсли;	
			ОбластьШапки.Параметры.АдресРегистрацииДоверенного = Renault_УправлениеКонтактнойИнформацией.АдресКлиента(ДоверенныйГИБДД);
		КонецЕсли;
		
        ОбластьШапки.Параметры.Телефон                 = ДанныеПечати.КлиентОсновнойТелефон;
		ЗаполнитьЗначенияСвойств(ОбластьШапки.Параметры, СтрокаТЗ);	
		ОбластьШапки.Параметры.Двигатель               = СтрокаТЗ.РабочийОбъемДвигателяПТС+" куб.см.,"+СтрокаТЗ.МощностьДвигателяПТС+" л.с.";
		Если СтрокаТЗ.НомерШассиПТС = "" Тогда                           
			ОбластьШапки.Параметры.НомерШассиПТС = "ОТСУТСТВУЕТ";
		КонецЕсли;
		ОбластьШапки.Параметры.ДатаПТС = Формат(СтрокаТЗ.ДатаПТС, "ДЛФ=DD");
		
		ТабДокумент.Вывести(ОбластьШапки);
		
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ПечатьНаправлениеВКассу(ДанныеПечати)
	
	СуммаАванса = 0;
	
	Если ВвестиЧисло(СуммаАванса, "Введите сумму") Тогда
	Иначе
		СуммаАванса = ?(ДанныеПечати.СуммаАванса=0, ДанныеПечати.СоставДоговора.Выгрузить().Итог("СуммаАвансаПоАвтомобилю"),ДанныеПечати.СуммаАванса);
	КонецЕсли;
	
    ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;
	МакетНаправлениеВКассу = ПолучитьМакет("МакетНаправлениеВКассу");
	ОбластьШапки = МакетНаправлениеВКассу.ПолучитьОбласть("Шапка");
					
	ОбластьШапки.Параметры.НомерДоговора = ДанныеПечати.НомерДоговора;
	ОбластьШапки.Параметры.ДатаДоговора  = ДанныеПечати.ДатаДоговора;
	ОбластьШапки.Параметры.ДатаЗаполнения  = Формат(ТекущаяДата(),"ДФ='dd MMMM yyyy'");
	ОбластьШапки.Параметры.НаименованиеОрганизации = ДанныеПечати.ДилерНаименованиеОрганизацииКраткое; 
	ОбластьШапки.Параметры.Клиент                  = ДанныеПечати.КлиентДоговораНаименование;
	ОбластьШапки.Параметры.СуммаАванса             = СуммаАванса;
	ОбластьШапки.Параметры.Продавец                = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
		
	ТабДокумент.Вывести(ОбластьШапки);
	
	Макет = Новый Структура();
	Макет.Вставить("Тип",ВРег("mxl"));
	Макет.Вставить("ПечатнаяФорма",ТабДокумент);
	Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
			
КонецПроцедуры

Процедура ПечатьСпецификации(ДанныеПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСправа = 5;
	ДатаНадпись = Формат(ДанныеПечати.ДатаДоговора,"ДФ='дд ММММ гггг'");
	
    Тариф = Renault_CRM.ПолучитьТекущийТарифНаАвтомобили(ДанныеПечати.ДатаДоговора);
	
	МакетСпецификация = ПолучитьМакет("МакетСпецификация");
	ОбластьШапки      = МакетСпецификация.ПолучитьОбласть("Шапка");
	
	ТЗСостав = ДанныеПечати.СоставДоговора.Выгрузить(); 
	
	НомерПоПорядку = 1;
	
	Для Каждого СтрокаТЗ ИЗ ТЗСостав Цикл	 
		
		ОбластьШапки.Параметры.НомерДоговора  = ДанныеПечати.НомерДоговора;
		ОбластьШапки.Параметры.ДатаДоговора   = """" + ЛЕВ(ДатаНадпись,2)+ """ "+ Сред(ДатаНадпись,4, СтрДлина(ДатаНадпись))+" года";
		ОбластьШапки.Параметры.НомерПоПорядку = НомерПоПорядку;
		ОбластьШапки.Параметры.Модель  = ?(ЗначениеЗаполнено(СтрокаТЗ.Модель), СтрокаТЗ.Модель.Наименование, "<Не указана>"); 
		ОбластьШапки.Параметры.Версия  = ?(ЗначениеЗаполнено(СтрокаТЗ.Версия), СтрокаТЗ.Версия.Наименование, "<Не указана>");
		ОбластьШапки.Параметры.Версия2 = ?(ЗначениеЗаполнено(СтрокаТЗ.Версия), СтрокаТЗ.Версия.Артикул,      "<Не указана>");
		ОбластьШапки.Параметры.Цвет    = ?(ЗначениеЗаполнено(СтрокаТЗ.Цвет), СтрокаТЗ.Цвет.Наименование + "("+СтрокаТЗ.Цвет.Артикул+")", "<Не указан>");
		
		ОбластьШапки.Параметры.Объем     = СтрокаТЗ.МодельДвигателяПТС;
		ОбластьШапки.Параметры.Двигатель = СтрокаТЗ.МощностьДвигателяПТС; 
		
		ТабДокумент.Вывести(ОбластьШапки);
		
		ШапкаБазовые   = МакетСпецификация.ПолучитьОбласть("ШапкаБазовые");		
		СтрокиБазовые  = МакетСпецификация.ПолучитьОбласть("БазовыеОпции");
		ШапкаДопОпции  = МакетСпецификация.ПолучитьОбласть("ШапкаДопОпции");		
		СтрокиДопОпции = МакетСпецификация.ПолучитьОбласть("ДопОпции");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Renault_ТарифНаОпцииАвтомобилей.НаименованиеОпции КАК НаименованиеОпции
		|ИЗ
		|	РегистрСведений.Renault_ТарифНаОпцииАвтомобилей.СрезПоследних(
		|			,
		|			Тариф = &Тариф
		|				И Модель = &Модель
		|				И ВариантКомплектации = &ВариантКомплектации
		|				И Базовая = ИСТИНА) КАК Renault_ТарифНаОпцииАвтомобилей";
		
		Запрос.УстановитьПараметр("Модель", СтрокаТЗ.Модель);
		Запрос.УстановитьПараметр("ВариантКомплектации", СтрокаТЗ.Версия);
		Запрос.УстановитьПараметр("Тариф", Тариф);
		БазовыеОпции = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НаименованиеОпции");
		
		Если БазовыеОпции.Количество() > 0 Тогда
			ТабДокумент.Вывести(ШапкаБазовые);
			Для Каждого Стр Из БазовыеОпции Цикл
				СтрокиБазовые.Параметры.Опция1 = Стр;
				ТабДокумент.Вывести(СтрокиБазовые);
			КонецЦикла;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Renault_ОпцииАвтомобилей.Опция КАК Опция1,
		               |	Renault_ОпцииАвтомобилей.Опция.Артикул КАК ОпцияАртикул
		               |ИЗ
		               |	РегистрСведений.Renault_ОпцииАвтомобилей КАК Renault_ОпцииАвтомобилей
		               |ГДЕ
		               |	Renault_ОпцииАвтомобилей.VIN = &VIN";
		Запрос.УстановитьПараметр("VIN",СтрокаТЗ.VIN);

		ДопОпции = Запрос.Выполнить().Выгрузить();

		Если ДопОпции.Количество() > 0 Тогда
			ТабДокумент.Вывести(ШапкаДопОпции);
			Для Каждого Стр Из ДопОпции Цикл
				ЗаполнитьЗначенияСвойств(СтрокиДопОпции.Параметры, Стр);
				ТабДокумент.Вывести(СтрокиДопОпции);
			КонецЦикла;
			
		КонецЕсли;
		
		Подвал                                  = МакетСпецификация.ПолучитьОбласть("Подвал");
		ФИООтветственного                       = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
		Фамилия  = ЛЕВ(ФИООтветственного, Найти(ФИООтветственного," ")-1);
		ФИООтветственного = ПРАВ(ФИООтветственного, СтрДлина(ФИООтветственного)-СтрДлина(Фамилия)-1);
		Имя      = ЛЕВ(ФИООтветственного, Найти(ФИООтветственного," ")-1);
        ФИООтветственного = ПРАВ(ФИООтветственного, СтрДлина(ФИООтветственного)-СтрДлина(Имя)-1);
		Отчество = ФИООтветственного;
		Подвал.Параметры.ФИООтветственного      = Фамилия+" "+ЛЕВ(Имя,1)+"."+ЛЕВ(Отчество,1)+".";
		Подвал.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентФамилия+" "+ЛЕВ(ДанныеПечати.КлиентИмя,1)+ "."+ЛЕВ(ДанныеПечати.КлиентОтчество,1)+".";
		
		ТабДокумент.Вывести(Подвал);
		
		НомерПоПорядку = НомерПоПорядку+1;
		
		Макет = Новый Структура();
		Макет.Вставить("Тип",ВРег("mxl"));
		Макет.Вставить("ПечатнаяФорма",ТабДокумент);
		Renault_УправлениеПечатьюКлиент.ПоказатьДокумент(Макет);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ПечатьПродвинутогоПакета(ТипМакета, ДоговорСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_Договор.Ссылка КАК Ссылка,
	|	Renault_Договор.Номер КАК НомерДоговора,
	|	Renault_Договор.Дата КАК Дата,
	|	Renault_Договор.ДатаДоговора КАК ДатаДоговора,
	|	Renault_Договор.Комментарий КАК Комментарий,
	|	Renault_Договор.СтатусДоговора КАК СтатусДоговора,
	|	Renault_Договор.РеализацияАвтомобиля КАК РеализацияАвтомобиля,
	|	Renault_Договор.ЗаказНаАвтомобиль КАК ЗаказНаАвтомобиль,
	|	ЕСТЬNULL(Контрагенты.Ссылка, CRM_ПотенциальныеКонтрагенты.Ссылка) КАК Клиент,
	|	ЕСТЬNULL(Контрагенты.ФормаСобственности, CRM_ПотенциальныеКонтрагенты.ФормаСобственности) КАК КлиентФормаСобственности,
	|	ЕСТЬNULL(Контрагенты.Фамилия, CRM_ПотенциальныеКонтрагенты.Фамилия) КАК КлиентФамилия,
	|	ЕСТЬNULL(Контрагенты.Имя, CRM_ПотенциальныеКонтрагенты.Имя) КАК КлиентИмя,
	|	ЕСТЬNULL(Контрагенты.Отчество, CRM_ПотенциальныеКонтрагенты.Отчество) КАК КлиентОтчество,
	|	ЕСТЬNULL(Контрагенты.Пол, CRM_ПотенциальныеКонтрагенты.Пол) КАК КлиентПол,
	|	ЕСТЬNULL(Контрагенты.ДатаРождения, CRM_ПотенциальныеКонтрагенты.ДатаРождения) КАК КлиентДатаРождения,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.Серия, """") КАК КлиентПаспортСерия,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.Номер, """") КАК КлиентПаспортНомер,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.КемВыдан, """") КАК КлиентПаспортВыданКем,
	|	ЕСТЬNULL(ПодтверждающиеДокументы.ДатаВыдачи, """") КАК КлиентПаспортВыданДата,
	|	ЕСТЬNULL(КонтактнаяИнформацияТелефоны.Представление, """") КАК КлиентОсновнойТелефон,
	|	ЕСТЬNULL(КонтактнаяИнформацияEMail.Представление, """") КАК КлиентОсновнойEmail,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Контрагенты.ФормаСобственности, CRM_ПотенциальныеКонтрагенты.ФормаСобственности) = ЗНАЧЕНИЕ(Перечисление.ФормыСобственности.ЧастноеЛицо)
	|			ТОГДА ЕСТЬNULL(КонтактнаяИнформацияАдресФакт.Представление, """")
	|		ИНАЧЕ ЕСТЬNULL(КонтактнаяИнформацияАдресЮр.Представление, """")
	|	КОНЕЦ КАК КлиентАдрес,
	|	Renault_Договор.КлиентДоговора.Наименование КАК КлиентДоговораНаименование,
	|	ЕСТЬNULL(Контрагенты.ИНН, CRM_ПотенциальныеКонтрагенты.ИНН) КАК КлиентИНН,
	|	ЕСТЬNULL(Контрагенты.КПП, CRM_ПотенциальныеКонтрагенты.КПП) КАК КлиентКПП,
	|	ЕСТЬNULL(Контрагенты.КодПоОКПО, CRM_ПотенциальныеКонтрагенты.КодПоОКПО) КАК КлиентКодПоОКПО,
	|	ЕСТЬNULL(Контрагенты.КодИМНС, CRM_ПотенциальныеКонтрагенты.КодИМНС) КАК КлиентКодИМНС,
	|	Renault_Договор.КлиентБанковскийСчет.НомерСчета КАК КлиентСчет,
	|	Renault_Договор.КлиентБанковскийСчет.Банк.КоррСчет КАК КлиентКоррСчет,
	|	Renault_Договор.КлиентБанковскийСчет.Банк.Код КАК КлиентБИК,
	|	Renault_Договор.КлиентБанковскийСчет.Банк КАК КлиентБанкСчета,
	|	Renault_Договор.НесколькоАвтомобилейВДоговоре КАК НесколькоАвтомобилейВДоговоре,
	|	Renault_Договор.ДилерскийЦентр КАК ДилерскийЦентр,
	|	Renault_Договор.СуммаДоговора КАК СуммаДоговора,
	|	Renault_Договор.СуммаАванса КАК СуммаАванса,
	|	Renault_Договор.Организация КАК Организация,
	|	Renault_Договор.Менеджер КАК Менеджер,
	|	Renault_Договор.КлиентПодписант КАК КлиентПодписант,
	|	CRM_КлиентскиеДанныеПодписанта.ПодписантВЛице КАК КлиентПодписантВЛице,
	|	CRM_КлиентскиеДанныеПодписанта.ПодписантНаОсновании КАК КлиентПодписантНаОсновании,
	|	CRM_КлиентскиеДанныеПодписанта.ПодписантПодпись КАК КлиентПодписантПодпись,
	|	CRM_КлиентскиеДанныеПодписанта.ПодписантДолжность КАК КлиентПодписантДолжность,
	|	Renault_Договор.КлиентПодписант.НаименованиеПолное КАК КлиентПодписантФИО,
	|	Renault_Договор.КлиентПодписант.НаименованиеПолное КАК ФИООтветственногоПокупателя,
	|	Renault_Договор.ДилерНаименованиеОрганизации КАК ДилерНаименованиеОрганизации,
	|	Renault_Договор.ДилерИНН КАК ДилерИНН,
	|	Renault_Договор.ДилерКПП КАК ДилерКПП,
	|	Renault_Договор.ДилерСчет КАК ДилерСчет,
	|	Renault_Договор.ДилерКоррСчет КАК ДилерКоррСчет,
	|	Renault_Договор.ДилерБИК КАК ДилерБИК,
	|	Renault_Договор.ДилерБанк КАК ДилерБанк,
	|	Renault_Договор.ДилерАдресЮридический КАК ДилерАдресЮридический,
	|	Renault_Договор.ДилерАдресФактический КАК ДилерАдресФактический,
	|	Renault_Договор.ДилерТелефон КАК ДилерТелефон,
	|	Renault_Договор.ДилерПодписантВЛице КАК ДилерПодписантВЛице,
	|	Renault_Договор.ДилерПодписантНаОсновании КАК ДилерПодписантНаОсновании,
	|	Renault_Договор.ДилерПодписантПодпись КАК ДилерПодписантПодпись,
	|	Renault_Договор.ДилерПодписантДолжность КАК ДилерПодписантДолжность,
