	//|			И (КонтактнаяИнформацияТелефоны.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонСотовый))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияАдресЮр
	|		ПО Renault_Договор.КлиентДоговора = КонтактнаяИнформацияАдресЮр.Объект
	|			И (КонтактнаяИнформацияАдресЮр.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (КонтактнаяИнформацияАдресЮр.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЮридический))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияАдресФакт
	|		ПО Renault_Договор.КлиентДоговора = КонтактнаяИнформацияАдресФакт.Объект
	|			И (КонтактнаяИнформацияАдресФакт.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (КонтактнаяИнформацияАдресФакт.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресФактический))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияEMail
	|		ПО Renault_Договор.КлиентДоговора = КонтактнаяИнформацияEMail.Объект
	|			И (КонтактнаяИнформацияEMail.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
	|			И (КонтактнаяИнформацияEMail.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыРабочий)
	|				ИЛИ КонтактнаяИнформацияEMail.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыДомашний))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостояниеАвтомобилейПроизводителя_v2 КАК CRM_СостояниеАвтомобилейПроизводителя_v2
	|		ПО Renault_Договор.VIN = CRM_СостояниеАвтомобилейПроизводителя_v2.VIN
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ДополнительнаяИнформацияПоДоговорам КАК CRM_ДополнительнаяИнформацияПоДоговорам
	|		ПО Renault_Договор.Ссылка = CRM_ДополнительнаяИнформацияПоДоговорам.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанные
	|		ПО Renault_Договор.Клиент = CRM_КлиентскиеДанные.Клиент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_КлиентскиеДанные КАК CRM_КлиентскиеДанныеПодписанта
	|		ПО Renault_Договор.КлиентПодписант = CRM_КлиентскиеДанныеПодписанта.Клиент
	|ГДЕ
	|	Renault_Договор.Ссылка = &Ссылка";
	//-- изменено dev7 20180305. По заданию в связи с изменением метода хранения информации для подписания договора

	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВалютаРубли = Константы.ВалютаУправленческогоУчетаКомпании.Получить();
	СтавкаНДС = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	
	Если Выборка.Следующий() Тогда
		
		ДанныеОбъекта = Новый Структура;
		
		ДанныеОбъекта.Вставить("Ссылка", Выборка.Ссылка);
		ДанныеОбъекта.Вставить("Дата", Формат(Выборка.Дата, "ДФ='дд ММММ гггг'"));
		
		ДанныеОбъекта.Вставить("НомерДоговора", Выборка.НомерДоговора);
		ДанныеОбъекта.Вставить("ДатаДоговора", Формат(Выборка.ДатаДоговора,"ДФ='дд.ММ.гггг'"));
		ДанныеОбъекта.Вставить("ДатаАктаПередачи", Формат(Выборка.ДатаАктаПередачи,"ДФ='дд.ММ.гггг'"));
		ДанныеОбъекта.Вставить("ДатаДоговораПропись", Формат(Выборка.ДатаДоговора,"ДФ='дд ММММ гггг'")); //DMSREN 1325
		ДанныеОбъекта.Вставить("СуммаАванса", Выборка.СуммаАванса); //DMSREN 1159
		ДанныеОбъекта.Вставить("СтавкаНДС", Справочники.СтавкиНДС.ОсновнаяСтавкаНДС);
		ДанныеОбъекта.Вставить("Организация", Выборка.Организация);
		ДанныеОбъекта.Вставить("ОГРН", Выборка.Организация.ОГРН);
		ДанныеОбъекта.Вставить("БИН", Выборка.БИН);
		ДанныеОбъекта.Вставить("ДилерНаименованиеПолное", Выборка.ДилерНаименованиеОрганизации);
		ДанныеОбъекта.Вставить("ДилерИНН", Выборка.ДилерИНН);
		ДанныеОбъекта.Вставить("ДилерКПП", Выборка.ДилерКПП);
		ДанныеОбъекта.Вставить("ДилерСчет", Выборка.ДилерСчет);
		ДанныеОбъекта.Вставить("ДилерКоррСчет", Выборка.ДилерКоррСчет);
		ДанныеОбъекта.Вставить("ДилерБанк", Выборка.ДилерБанк);
		ДанныеОбъекта.Вставить("ДилерБИК", Выборка.ДилерБИК);
		ДанныеОбъекта.Вставить("ДилерТелефон", Выборка.ДилерТелефон);
		ДанныеОбъекта.Вставить("ДилерАдресЮридический", Выборка.ДилерАдресЮридический);
		ДанныеОбъекта.Вставить("ДилерАдресФактический", Выборка.ДилерАдресФактический);
		ДанныеОбъекта.Вставить("ДилерПодписантВЛице", Выборка.ДилерПодписантВЛице);
		ДанныеОбъекта.Вставить("ДилерПодписантНаОсновании", Выборка.ДилерПодписантНаОсновании);
		ДанныеОбъекта.Вставить("ДилерПодписантПодпись", Выборка.ДилерПодписантПодпись);
		ДанныеОбъекта.Вставить("ДилерПодписантДолжность", Выборка.ДилерПодписантДолжность);
		ДанныеОбъекта.Вставить("Менеджер", Выборка.МенеджерФИО);
		
		//Собираем инициалы которых нет в справочнике сотрудники
		ВходящаяСтрока = СтрЗаменить(Выборка.МенеджерФИО, " ", Символы.ПС);
		МенеджерИнициалы = "";
		Для ИндексСтроки = 1 По СтрЧислоСтрок(ВходящаяСтрока) Цикл
			Подстрока = СтрПолучитьСтроку(ВходящаяСтрока, ИндексСтроки);
			МенеджерИнициалы = МенеджерИнициалы + " "+ ?(ИндексСтроки=1,Подстрока,Лев(Подстрока,1)+".");
		КонецЦикла;
		
		ДанныеОбъекта.Вставить("МенеджерИнициалы",МенеджерИнициалы);
		//
		
		ДанныеОбъекта.Вставить("СтатусГотовностиАвтомобиля", Выборка.СтатусГотовностиАвтомобиля);
		ДанныеОбъекта.Вставить("ПлановаяДатаПолнойОплатыКлиентом", Выборка.ПлановаяДатаПолнойОплатыКлиентом);
		ДанныеОбъекта.Вставить("ПланируемаяДатаВыдачиАвтомобиля", Выборка.ПланируемаяДатаВыдачиАвтомобиля);
		ДанныеОбъекта.Вставить("КодМодели", Выборка.КодМодели);
		ДанныеОбъекта.Вставить("ОплатаНаличными", Выборка.ОплатаНаличными);
		ДанныеОбъекта.Вставить("ИсточникИнформации", Выборка.ИсточникИнформации);  
		ДанныеОбъекта.Вставить("КодыДополнительныхОпций", Выборка.СоставОпций);
		ДанныеОбъекта.Вставить("КодРадио", Выборка.КодРадио);
		ДанныеОбъекта.Вставить("ПТССерия", Выборка.ПТССерия);
		ДанныеОбъекта.Вставить("ПТСНомер", Выборка.ПТСНомер);
		
		ДанныеОбъекта.Вставить("СпособОплаты", Выборка.СпособОплаты); // DMSREN-1159
		
		
		ЗапросВоронкаПродаж = Новый Запрос;
		ЗапросВоронкаПродаж.Текст = 
		
		"ВЫБРАТЬ
		|	CRM_ВоронкаПродаж.ЭтапПродаж
		|ИЗ
		|	РегистрСведений.CRM_ВоронкаПродаж КАК CRM_ВоронкаПродаж
		|ГДЕ
		|	CRM_ВоронкаПродаж.IDK = &IDK";
				
		ЗапросВоронкаПродаж.УстановитьПараметр("IDK", Выборка.РабочийЛист);	
		РезультатВоронкаПродаж = ЗапросВоронкаПродаж.Выполнить().Выгрузить();
		
		ФормаОплатыКредит = "Нет";
		ТрэйдИН = "Нет";
		ДопОпции = "Нет";
		
		Для каждого стр из РезультатВоронкаПродаж Цикл
			Если стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаКредит 
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаКредитВыполнена
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаКредитОдобрена Тогда
				ФормаОплатыКредит = "Да";
			ИначеЕсли стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИн 
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнВизуальныйОсмотр 
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнВыполнена 
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнДиагностикаВСервисе
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнДоговорСКлиентом
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнЗаполнениеДанныхАвтомобиля
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнКалькуляция
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнКоммерческоеПредложение
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнОдобрена
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнПредварительнаяОценка
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнПредложениеВыкупа
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаТрейдИнПроверкаЮридическойЧистоты Тогда
				ТрэйдИН = "Да";
			ИначеЕсли стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаОборудование 
				ИЛИ стр.ЭтапПродаж = Справочники.CRM_ЭтапыПродаж.ЗаявкаНаОборудованиеВыполнена Тогда
				ДопОпции = "Да";
			КонецЕсли;
		КонецЦикла;
		
		ДанныеОбъекта.Вставить("ФормаОплатыКредит", ФормаОплатыКредит);
		ДанныеОбъекта.Вставить("ТрэйдИН", ТрэйдИН);
		ДанныеОбъекта.Вставить("ДопОпции", ДопОпции);
		
		ОСАГО = "Нет";
		КАСКО = "Нет";
		
		ЗапросДанныеКАСКО_ОСАГО = Новый Запрос;
		ЗапросДанныеКАСКО_ОСАГО.Текст = 
			"ВЫБРАТЬ
			|	Renault_РабочийЛистОФУФинансовыеУслуги.ФинансоваяУслуга КАК ВидСтрахования
			|ИЗ
			|	Документ.Renault_РабочийЛистОФУ.ФинансовыеУслуги КАК Renault_РабочийЛистОФУФинансовыеУслуги
			|ГДЕ
			|	Renault_РабочийЛистОФУФинансовыеУслуги.Ссылка.Клиент = &Клиент
			|	И Renault_РабочийЛистОФУФинансовыеУслуги.Ссылка.РабочийЛист = &РабочийЛист";
		
		ЗапросДанныеКАСКО_ОСАГО.УстановитьПараметр("Клиент", Выборка.Клиент);
		ЗапросДанныеКАСКО_ОСАГО.УстановитьПараметр("РабочийЛист", Выборка.РабочийЛист);
		
		ВыборкаДанныеКАСКО_ОСАГО = ЗапросДанныеКАСКО_ОСАГО.Выполнить().Выбрать();
		
		Пока ВыборкаДанныеКАСКО_ОСАГО.Следующий() Цикл
			Если ВыборкаДанныеКАСКО_ОСАГО.ВидСтрахования.Вид = Перечисления.ВидыСтрахования.КАСКО Тогда
				КАСКО = "Да";
			ИначеЕсли ВыборкаДанныеКАСКО_ОСАГО.ВидСтрахования.Вид = Перечисления.ВидыСтрахования.ОСАГО Тогда
				ОСАГО = "Да";
			КонецЕсли; 
		КонецЦикла;
		
		ДанныеОбъекта.Вставить("КАСКО", КАСКО);
		ДанныеОбъекта.Вставить("ОСАГО", ОСАГО);
		
		ЗапросЖелаемаяДатаУстановки = Новый Запрос;
		ЗапросЖелаемаяДатаУстановки.Текст = 
			"ВЫБРАТЬ
			|	МАКСИМУМ(Renault_CRM_ЗаявкаНаСервис.ЖелаемаяДата) КАК ЖелаемаяДата
			|ИЗ
			|	Документ.Renault_CRM_ЗаявкаНаСервис КАК Renault_CRM_ЗаявкаНаСервис
			|ГДЕ
			|	Renault_CRM_ЗаявкаНаСервис.Обращение.IDK = &IDK";
		
		ЗапросЖелаемаяДатаУстановки.УстановитьПараметр("IDK", Выборка.РабочийЛист);
		
		РезультатЗапросЖелаемаяДатаУстановки = ЗапросЖелаемаяДатаУстановки.Выполнить().Выгрузить();
		
		Для каждого стр из РезультатЗапросЖелаемаяДатаУстановки Цикл
			ЖелаемаяДата = стр.ЖелаемаяДата;
		КонецЦикла;
		
		ДанныеОбъекта.Вставить("ЖелаемаяДата", ЖелаемаяДата);
		
		ДанныеОбъекта.Вставить("Сумма", Выборка.СуммаДоговора);
		ДанныеОбъекта.Вставить("СуммаПрописью", обЧислоПрописью(Выборка.СуммаДоговора, ВалютаРубли));
		ДанныеОбъекта.Вставить("СуммаНДС", ПолучитьНДС(Выборка.СуммаДоговора, СтавкаНДС));
		ДанныеОбъекта.Вставить("СуммаНДСПрописью", обЧислоПрописью(ПолучитьНДС(Выборка.СуммаДоговора, СтавкаНДС), ВалютаРубли));
		
		ДанныеОбъекта.Вставить("СуммаАванса", Выборка.СуммаАванса);
		ДанныеОбъекта.Вставить("СуммаАвансаПрописью", обЧислоПрописью(Выборка.СуммаАванса, ВалютаРубли));
		ДанныеОбъекта.Вставить("СуммаАвансаНДС", ПолучитьНДС(Выборка.СуммаАванса, СтавкаНДС));
		ДанныеОбъекта.Вставить("СуммаАвансаНДСПрописью", обЧислоПрописью(ПолучитьНДС(Выборка.СуммаАванса, СтавкаНДС), ВалютаРубли));
		
		ДанныеОбъекта.Вставить("СуммаЗаВычетомАванса", Выборка.СуммаЗаВычетомАванса);
		ДанныеОбъекта.Вставить("СуммаЗаВычетомАвансаПрописью", обЧислоПрописью(Выборка.СуммаЗаВычетомАванса, ВалютаРубли));
		ДанныеОбъекта.Вставить("СуммаЗаВычетомАвансаНДС", ПолучитьНДС(Выборка.СуммаЗаВычетомАванса, СтавкаНДС));
		ДанныеОбъекта.Вставить("СуммаЗаВычетомАвансаНДСПрописью", обЧислоПрописью(ПолучитьНДС(Выборка.СуммаЗаВычетомАванса, СтавкаНДС), ВалютаРубли));
		ВыборкаСоставДоговора = Выборка.СоставДоговора.Выбрать();
		
		Если ВыборкаСоставДоговора.Следующий() Тогда
			
			ГосНомер = ЧтениеЗначенияРегистраСведения(ВыборкаСоставДоговора.Автомобиль, Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
			
			ДанныеОбъекта.Вставить("ГосНомер", ГосНомер);
			Менеджер = РегистрыСведений.Renault_ДопИнформацияПоВерсиям.СоздатьМенеджерЗаписи();
			Менеджер.ВариантКомплектации = ВыборкаСоставДоговора.Автомобиль.ВариантКомплектации;
			Менеджер.Прочитать();
			ДанныеОбъекта.Вставить("ОбъемДвигателя",	Менеджер.ОбъемДвигателя);
			ДанныеОбъекта.Вставить("МинимальнаяМасса",	Менеджер.МинимальнаяМасса);
			ДанныеОбъекта.Вставить("МаксимальнаяМасса",	Менеджер.МаксимальнаяМасса);
			ДанныеОбъекта.Вставить("МощностьКВТ",		Менеджер.МощностьКВТ);
