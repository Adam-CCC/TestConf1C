			НДСИтого          = ЛЕВ(Формат(НДСИтого, "ЧРД=,"), СтрДлина(Формат(НДСИтого, "ЧРД=,"))-3);
			НДСИтогоПрописью  = обЧислоПрописью(Цел(НДСИтого),,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			НДСКопеек         = обЧислоПрописью(НДСИтого-Цел(НДСИтого),,"Л=ru_RU;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");		
			НДСКопеек         = СтрЗаменить(НДСКопеек, "Ноль рублей ", "");	
			
			// Трояновский К.Е. 15.02.2019 11:34:55 {
