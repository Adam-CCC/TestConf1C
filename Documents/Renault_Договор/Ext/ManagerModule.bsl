			//СтрокаРасчетов2_1.Параметры.НДС          = "в том числе НДС (" + ?(ДанныеПечати.ДатаДоговора < '20190101', "18", "20") + "%) - "+НДСИтого+"("+НДСИтогоПрописью+") руб. "+НДСКопеек;
			СтрокаРасчетов2_1.Параметры.НДС          = "в том числе НДС (" + Строка(СтавкаНДС.Ставка) + "%) - "+НДСИтого+"("+НДСИтогоПрописью+") руб. "+НДСКопеек;
			// Трояновский К.Е. 15.02.2019 11:34:55 }	
		КонецЕсли;

		ТабДокумент.Вывести(СтрокаРасчетов2_1);
	
		Если СтрокаТЗ.СуммаКредита <> 0 Тогда  //Кредит	
			
			Если СтрокаТЗ.ОбщаяСуммаПоАвтомобилю = СтрокаТЗ.СуммаПредоплаты+СтрокаТЗ.СуммаКредита Тогда
				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Шапка2_4"); 
