				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Пункт2_2");
				СтрокаРасчетов2_2.Параметры.СуммаИтог         = ДанныеПечати.СуммаДоговора;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью = обЧислоПрописью(ДанныеПечати.СуммаДоговора,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			Иначе			                                                  
				СтрокаРасчетов2_2 = МакетОсновногоДоговора.ПолучитьОбласть("Пункт2_3");
				СтрокаРасчетов2_2.Параметры.СуммаИтог1         = СтрокаТЗ.СуммаПредоплаты;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью1 = обЧислоПрописью(СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
				СтрокаРасчетов2_2.Параметры.СуммаИтог2         = ДанныеПечати.СуммаДоговора-СтрокаТЗ.СуммаПредоплаты;
				СтрокаРасчетов2_2.Параметры.СуммаИтогПрописью2 = обЧислоПрописью(ДанныеПечати.СуммаДоговора-СтрокаТЗ.СуммаПредоплаты,,"Л=ru_RU;НП=Ложь;ДП=Ложь","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 0");
			КонецЕсли;			
		КонецЕсли;
					
		ТабДокумент.Вывести(СтрокаРасчетов2_2);			

		Подвал = МакетОсновногоДоговора.ПолучитьОбласть("Подвал");
		ТабДокумент.Вывести(Подвал);
		
        СтрокаПодвал = МакетОсновногоДоговора.ПолучитьОбласть("СтрокаПодвал");
		СтрокаПодвал.Параметры.Продавец   = ""+ДанныеПечати.ДилерНаименованиеОрганизацииКраткое + Символы.ПС+
		                                    "Юридический адрес: "+ДанныеПечати.ДилерАдресЮридический+Символы.ПС+
										    "Тел: "+ДанныеПечати.ДилерТелефон+Символы.ПС+
                                            "ИНН: "+ДанныеПечати.ДилерИНН+" КПП: "+ДанныеПечати.ДилерКПП+Символы.ПС+          
	                                        "ОГРН: "+ДанныеПечати.ДилерОГРН+Символы.ПС+
											"р/с "+ДанныеПечати.ДилерСчет+" в"+Символы.ПС+
											ДанныеПечати.ДилерБанк+Символы.ПС+
											"к/с "+ДанныеПечати.ДилерКоррСчет+", БИК"+Символы.ПС+ 
											ДанныеПечати.ДилерБИК+Символы.ПС+ 
											"ОКВЭД: "+ДанныеПечати.ДилерОКВЭД+" ОКПО: "+ДанныеПечати.ДилерОКПО;
        СтрокаПодвал.Параметры.Покупатель = ДанныеПечати.КлиентДоговораНаименование+Символы.ПС+
		                                    "Паспорт: "+ДанныеПечати.КлиентПаспортСерия+" "+ДанныеПечати.КлиентПаспортНомер+Символы.ПС+
                                            "Выдан: "+ДанныеПечати.КлиентПаспортВыданКем+", "+Формат(ДанныеПечати.КлиентПаспортВыданДата,"ДФ=dd.MM.yyyy")+"г."+Символы.ПС+
                                            "Адрес регистрации: "+ДанныеПечати.КлиентАдрес+Символы.ПС+
											"Тел. "+ ДанныеПечати.КлиентОсновнойТелефон+Символы.ПС+
											"E-mail: "+ДанныеПечати.КлиентОсновнойEmail+Символы.ПС+
											"Дата рождения: "+ Формат(ДанныеПечати.КлиентДатаРождения,"ДФ=dd.MM.yyyy")+"г.";
											
		ТабДокумент.Вывести(СтрокаПодвал);
		
        Подписи                                  = МакетОсновногоДоговора.ПолучитьОбласть("Подписи");
		Подписи.Параметры.НаименованиеПокупателя = ДанныеПечати.КлиентДоговораНаименование;
        Подписи.Параметры.ФИООтветственного      = ?(ДанныеПечати.ДилерПодписантВЛице = "", ДанныеПечати.МенеджерФИО, ДанныеПечати.ДилерПодписантВЛице);
		ТабДокумент.Вывести(Подписи);
				
		Макет = Новый Структура();
