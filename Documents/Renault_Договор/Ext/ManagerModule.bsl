Функция СуммаСкидки(ДилерскийЦентр,Автомобиль,ТипСкидки = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДилерскийЦентр", ДилерскийЦентр);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТипСкидки", ?(ТипСкидки = Неопределено, Справочники.ТипыСкидок.ПустаяСсылка(), ТипСкидки));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_СкидкиНаАвтомобилиСрезПоследних.СуммаСкидки
	|ИЗ
	|	РегистрСведений.Renault_СкидкиНаАвтомобили.СрезПоследних КАК Renault_СкидкиНаАвтомобилиСрезПоследних
	|ГДЕ
	|	Renault_СкидкиНаАвтомобилиСрезПоследних.ДилерскийЦентр = &ДилерскийЦентр
	|	И Renault_СкидкиНаАвтомобилиСрезПоследних.Автомобиль = &Автомобиль
	|	И Renault_СкидкиНаАвтомобилиСрезПоследних.ВариантКомплектации = ЗНАЧЕНИЕ(Справочник.ВариантыКомплектации.ПустаяСсылка)
	|	И Renault_СкидкиНаАвтомобилиСрезПоследних.ДатаНачала <= &ТекущаяДата
	|	И Renault_СкидкиНаАвтомобилиСрезПоследних.ДатаКонца >= &ТекущаяДата
	|	И (Renault_СкидкиНаАвтомобилиСрезПоследних.ТипСкидки = &ТипСкидки
	|			ИЛИ &ТипСкидки = ЗНАЧЕНИЕ(Справочник.ТипыСкидок.ПустаяСсылка))";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.СуммаСкидки, 0)
	
КонецФункции

