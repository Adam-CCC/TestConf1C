		СуммаВыкупа                                   = ПолучитьСуммуВыкупа(СтрокаТЗ.Автомобиль);
		
		НДСИтого                                     = ПолучитьНДС(СуммаВыкупа-ДанныеПечати.СуммаДоговора, СтавкаНДС);
		Если НДСИтого<0 Тогда
			СтрокаРасчетов2_1.Параметры.НДС          = "Без НДС";
