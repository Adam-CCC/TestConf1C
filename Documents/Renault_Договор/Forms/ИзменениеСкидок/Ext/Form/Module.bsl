&НаКлиенте
Процедура ТЧПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ПроверитьПраваНаСкидки(Отказ);
	
	ФормаДок = ПолучитьФорму("Документ.Renault_ИзменениеСкидокНаАвтомобили.Форма.ФормаДокумента",,ЭтаФорма);
	ФормаДок.Автомобиль = Автомобиль;
	ФОрмаДок.ВариантКомплектации = ВариантКомплектации;
	ФормаДок.ДатаНачала = ДатаДоговора;
	
	ФормаДок.ОткрытьМодально();
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТЧПередНачаломИзменения(Элемент, Отказ)
	ПроверитьПраваНаСкидки(Отказ);
КонецПроцедуры

Процедура ПроверитьПраваНаСкидки(Отказ)

	Если Не ЕстьПравоСкидки И НЕ ЕстьПравоНаСкидкуВКП Тогда
		Отказ = Истина;
		Сообщить("Нет прав на установку и редактирование скидок");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТЧТипСкидкиПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТЧ.ТекущиеДанные;

	Если ЗначениеЗаполнено(ТекДанные.Документ) Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СоздатьИзменениеСкидки" Тогда
		// НАЧАЛО DMSCOR-1028
		//ЗаполнитьПрочиеСкидкиНаСервере();
		Если ЗначениеЗаполнено(Параметр) Тогда
			ДобавитьДокументВТЧ(Параметр);
		КонецЕсли;
		// КОНЕЦ
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТЧВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Элементы.ТЧ.ТекущиеДанные.Документ) Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Документ.Renault_ИзменениеСкидокНаАвтомобили.Форма.ФормаДокумента", Новый Структура("Ключ", Элементы.ТЧ.ТекущиеДанные.Документ));
	КонецЕсли;
	
КонецПроцедуры

// НАЧАЛО DMSCOR-1028
&НаСервере
Процедура ДобавитьДокументВТЧ(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Renault_СкидкиНаАвтомобили.СуммаСкидки КАК СуммаСкидки,
	               |	Renault_СкидкиНаАвтомобили.ТипСкидки КАК ТипСкидки,
	               |	Renault_СкидкиНаАвтомобили.Регистратор КАК Документ,
	               |	Renault_СкидкиНаАвтомобили.ПроцентСкидки,
	               |	Renault_СкидкиНаАвтомобили.ДатаНачала,
	               |	Renault_СкидкиНаАвтомобили.ДатаКонца
	               |ИЗ
	               |	РегистрСведений.Renault_СкидкиНаАвтомобили КАК Renault_СкидкиНаАвтомобили
	               |ГДЕ
	               |	Renault_СкидкиНаАвтомобили.Автомобиль = &Автомобиль
	               |	И Renault_СкидкиНаАвтомобили.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
		
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовСтр = ТЧ.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
		Если Выборка.ПроцентСкидки > 0 Тогда
			НовСтр.СуммаСкидки = СуммаКонфигурации * Выборка.ПроцентСкидки/100;	
		КонецЕсли;
	КонецЦикла;
	
	ИтогоСкидка = Тч.Итог("СуммаСкидки")
	
КонецПроцедуры

&НаКлиенте
Процедура ТЧПриИзменении(Элемент)
	ИтогоСкидка = Тч.Итог("СуммаСкидки")
КонецПроцедуры
