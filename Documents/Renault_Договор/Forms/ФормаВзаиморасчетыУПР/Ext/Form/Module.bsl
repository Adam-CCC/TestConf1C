
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Клиет") и Параметры.Свойство("Договор") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВзаиморасчетыКомпанииОстатки.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов,
			|	ВЫБОР
			|		КОГДА ВзаиморасчетыКомпанииОстатки.СуммаОстаток < 0
			|			ТОГДА 0
			|		ИНАЧЕ ВзаиморасчетыКомпанииОстатки.СуммаОстаток
			|	КОНЕЦ КАК ДолгКлиента,
			|	ВЫБОР
			|		КОГДА ВзаиморасчетыКомпанииОстатки.СуммаОстаток > 0
			|			ТОГДА 0
			|		ИНАЧЕ - ВзаиморасчетыКомпанииОстатки.СуммаОстаток
			|	КОНЕЦ КАК ДолгКомпании,
			|	ВЫБОР
			|		КОГДА ВзаиморасчетыКомпанииОстатки.ДоговорВзаиморасчетов = &ТекущийДоговорВзаиморасчетов
			|			ТОГДА 0
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК Приоритет
			|ИЗ
			|	РегистрНакопления.ВзаиморасчетыКомпании.Остатки(, Контрагент = &Клиент) КАК ВзаиморасчетыКомпанииОстатки
			|
			|УПОРЯДОЧИТЬ ПО
			|	Приоритет
			|ИТОГИ
			|	СУММА(ДолгКомпании),
			|	СУММА(ДолгКлиента)
			|ПО
			|	ОБЩИЕ";	
		Запрос.УстановитьПараметр("Клиент", Параметры.Клиент);
		Запрос.УстановитьПараметр("ТекущийДоговорВзаиморасчетов", Параметры.Договор);
		Результат = Запрос.Выполнить();
		ОбновитьДанныеВзаиморасчетов(Результат);
		
		ЭтаФорма.Заголовок = "Взаиморасчеты с клиентом - " + Параметры.Клиент.Наименование + ".";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеВзаиморасчетов(Результат)
	
	ИтогоДолгКлиента = 0;
	ИтогоДолгКомпании = 0;
	ИтогоОбщее = 0;
	
	СписокВзаиморасчетов.Очистить();
	
	Если НЕ Результат.Пустой() Тогда
		ВыборкаИтог = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВыборкаИтог.Следующий();
		
		ИтогоДолгКлиента = ВыборкаИтог.ДолгКлиента;
		ИтогоДолгКомпании = ВыборкаИтог.ДолгКомпании;
		ИтогоОбщее = ИтогоДолгКлиента - ИтогоДолгКомпании; 
		
		Выборка = ВыборкаИтог.Выбрать();
		
		Счетчик = 1;
		Пока Выборка.Следующий() Цикл
			Строка = СписокВзаиморасчетов.Добавить();
			Строка.НомерСтроки = Счетчик;
			ЗаполнитьЗначенияСвойств(Строка, Выборка);
			
			Счетчик = Счетчик + 1;
		КонецЦикла;	
	КонецЕсли;
	
	ЦветНетральный = Новый Цвет(49, 52, 49);
	ЦветДолгКлиента = Новый Цвет(51, 153, 102);
	ЦветДолгКомпании = Новый Цвет(128, 0, 0);
	
	СтрокаДолгКлиента = ?(ИтогоДолгКлиента = 0, "0,00", Формат(ИтогоДолгКлиента, "ЧЦ=15; ЧДЦ=2"));
	ЦветТекстДолгКлиента = ?(ИтогоДолгКлиента = 0, ЦветНетральный, ЦветДолгКлиента);
	СтрокаДолгКомпании = ?(ИтогоДолгКомпании = 0, "0,00", Формат(ИтогоДолгКомпании, "ЧЦ=15; ЧДЦ=2"));
	ЦветТекстДолгКомпании = ?(ИтогоДолгКомпании = 0, ЦветНетральный, ЦветДолгКомпании); 

//	Элементы.СписокВзаиморасчетов..ДолгКлиента.ТекстПодвала = СтрокаДолгКлиента;
//	Элементы.СписокВзаиморасчетов.Колонки.ДолгКомпании.ТекстПодвала = СтрокаДолгКомпании;
	
	Элементы.НадписьДолгКлиента.Заголовок = "Итого долг клиента - " + СтрокаДолгКлиента + " руб.";
	Элементы.НадписьДолгКлиента.ЦветТекста = ЦветТекстДолгКлиента;
	
	Элементы.НадписьДолгКомпании.Заголовок = "Итого долг компании - " + СтрокаДолгКомпании + " руб.";
	Элементы.НадписьДолгКомпании.ЦветТекста = ЦветТекстДолгКомпании;

	СтрокаИтогоОбщее = "Нет долгов.";
	ЦветТекстаОбщее = ЦветНетральный;
	Если ИтогоОбщее > 0 Тогда
		СтрокаИтогоОбщее = "Долг клиента - " + Формат(ИтогоОбщее, "ЧЦ=15; ЧДЦ=2") + " руб.";
		ЦветТекстаОбщее = ЦветДолгКлиента;
	ИначеЕсли ИтогоОбщее < 0 Тогда
		СтрокаИтогоОбщее = "Долг компании - " + Формат( - ИтогоОбщее, "ЧЦ=15; ЧДЦ=2") + " руб.";
		ЦветТекстаОбщее = ЦветДолгКомпании; 
	КонецЕсли;
	
	Элементы.НадписьВсего.Заголовок = "Итого в общем: " + СтрокаИтогоОбщее; 
	Элементы.НадписьВсего.ЦветТекста = ЦветТекстаОбщее;
КонецПроцедуры