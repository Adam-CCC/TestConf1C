&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// { DMSREN-644 Болдарев Д.Е. от 19.03.2020  
	//Если Параметры.РежимВыбора Тогда Элементы.Список.РежимВыбора=Истина КонецЕсли; 	
	Элементы.Список.РежимВыбора = Параметры.РежимВыбора;
	Элементы.Выбрать.Видимость = Параметры.РежимВыбора;
	// } DMSREN-644 Болдарев Д.Е. от 19.03.2020. 
	
	ДилерскийЦентр = Renault_РаботаСПравамиПользователя.ДилерскийЦентрПоУмолчанию(ПараметрыСеанса.Пользователь);
	
	Если ДилерскийЦентр.ЗапретДоговоровРЛДругогоДЦ Тогда
		Список.Параметры.УстановитьЗначениеПараметра("ДилерскийЦентр", ДилерскийЦентр);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("ДилерскийЦентр", Неопределено);
	КонецЕсли;
	
КонецПроцедуры
