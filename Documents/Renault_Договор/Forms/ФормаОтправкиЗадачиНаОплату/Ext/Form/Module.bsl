
&НаКлиенте
Процедура кнОтмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура кнОК(Команда)
	
	//отправка задачи менеджеру	
	Сотрудник = ПараметрыСеанса.Пользователь.Сотрудник;
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда	
		ОбработатьВыборМенеджераДляЗадачи(Сотрудник);
	Иначе
		ТекстВопроса = "Для вашего пользователя не выбран сотрудник, необходимо выбрать на кого назначить уведомление. Хотите выбрать?";
		
		Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Список = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(Отдел);
			//сПараметры = Новый Структура;
			//Обработчик = Новый ОписаниеОповещения("ОбработатьВыборМенеджераДляЗадачи", ЭтаФорма);
			//ОткрытьФорму("Обработка.Renault_ARM_Администратор.Форма.ФормаВыбораИзСпискаПлиткой", сПараметры, ЭтаФорма,,,,Обработчик);
			
			ФормаСписка = ПолучитьФорму("Обработка.Renault_ARM_Администратор.Форма.ФормаВыбораИзСпискаПлиткой");
			ФормаСписка.Список = Список;
			Если Список.Количество() <= 18 Тогда
				ФормаСписка.КнопокВСтроке = 2;				
			ИначеЕсли Список.Количество() > 18 И Список.Количество() <= 27 Тогда
				ФормаСписка.КнопокВСтроке = 3;
			ИначеЕсли Список.Количество() > 27 И Список.Количество() <= 36 Тогда
				ФормаСписка.КнопокВСтроке = 4;
			ИначеЕсли Список.Количество() > 36 И Список.Количество() <= 45 Тогда
				ФормаСписка.КнопокВСтроке = 5;
			ИначеЕсли Список.Количество() > 45 И Список.Количество() <= 54 Тогда
				ФормаСписка.КнопокВСтроке = 6;
			Иначе
				ФормаСписка.КнопокВСтроке = 7;
			КонецЕсли;
			ФормаСписка.Ширина = ФормаСписка.КнопокВСтроке*200+20;
			ФормаСписка.ВысотаКнопки = 40;
			ФормаСписка.Заголовок = "Выбор менеджера";
			Если ТипЗнч(Список) = Тип("СписокЗначений") Тогда
				ФормаСписка.Список = Список;
			Иначе
				СписокЗн = Новый СписокЗначений;
				СписокЗн.ЗагрузитьЗначения(Список);
				ФормаСписка.Список = СписокЗн;
			КонецЕсли;
			
			Ответ = ФормаСписка.ОткрытьМодально();
			
			Если ЗначениеЗаполнено(Ответ) Тогда
				ОбработатьВыборМенеджераДляЗадачи(Ответ);
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;		
	КонецЕсли;
   
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборМенеджераДляЗадачи (Менеджер) 
	
	Если ЗначениеЗаполнено(Менеджер) Тогда
		
		СобытиеПоРЛ = СоздатьНапоминаниеИСобытиеПоРабочемуЛисту(Менеджер);
		ФормироватьЗадачуОЗаписиНаДиагностикуПриЗаписиНаОплату = ПолучитьЗначениеСлужебныхНастроек();
		
		Если ФормироватьЗадачуОЗаписиНаДиагностикуПриЗаписиНаОплату И ЗначениеЗаполнено(Ссылка) Тогда
			
			Если ЗаявкаТрейдИн <> Неопределено Тогда
				Обработчки = Новый ОписаниеОповещения("ОбработатьОтветНаВопрос", ЭтаФорма, ЗаявкаТрейдИн);
				ПоказатьВопрос(Обработчки, "Создать задачу о записи клиента на диагностику?", РежимДиалогаВопрос.ДаНет);
			КонецЕсли;
			
		КонецЕсли;

	Иначе
		Сообщить("Не выбран менеджер, задача менеджеру не создана");
	КонецЕсли;
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветНаВопрос (Ответ, Параметр) Экспорт 
	
	Список = Renault_CRM.ПолучитьСписокСотрудниковПоОтделу(ОтделТрейдИн);
	Список.Добавить(ОтделТрейдИн);
	
	ФормаСписка = ПолучитьФорму("Обработка.Renault_ARM_Администратор.Форма.ФормаВыбораИзСпискаПлиткой");
	ФормаСписка.Список = Список;
	ФормаСписка.КнопокВСтроке = 2;
	ФормаСписка.ВысотаКнопки = 40;
	ФормаСписка.Заголовок = "Выбор менеджера или отдела";
	Если ТипЗнч(Список) = Тип("СписокЗначений") Тогда
		ФормаСписка.Список = Список;
	Иначе
		СписокЗн = Новый СписокЗначений;
		СписокЗн.ЗагрузитьЗначения(Список);
		ФормаСписка.Список = СписокЗн;
	КонецЕсли;

	Ответ = ФормаСписка.ОткрытьМодально();
	
	Если ЗначениеЗаполнено(Ответ) Тогда
		ОбработатьВыборМенеджераДляЗадачиТрейдИн(Ответ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборМенеджераДляЗадачиТрейдИн (Менеджер)
	Если ЗначениеЗаполнено(Менеджер) Тогда
		СоздатьЗадачуОЗаписиКлиентаНаДиагностику(СобытиеПоРЛ, Менеджер, Ссылка);
	Иначе
		Сообщить("Не выбран менеджер/отдел, задача о записи клиента на диагностику не создана");
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗаявкиТрейдИн (Договор)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ДоговорСоставДоговора.ЗаявкаНаТрейдИн КАК ССЫЛКА
	|ИЗ
	|	Документ.Renault_Договор.СоставДоговора КАК Renault_ДоговорСоставДоговора
	|ГДЕ
	|	Renault_ДоговорСоставДоговора.Ссылка = &Ссылка
	|	И Renault_ДоговорСоставДоговора.ЗаявкаНаТрейдИн <> ЗНАЧЕНИЕ(Документ.Renault_ЗаявкаНаТрейдИн.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", Договор);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выгрузить();
	
	Возврат Выборка[0].ССЫЛКА;
КонецФункции

&НаСервере
Функция СоздатьНапоминаниеИСобытиеПоРабочемуЛисту(Менеджер)
	
	СобытиеОбъект = Документы.CRM_СобытияПоРабочимЛистам.СоздатьДокумент();
	СобытиеОбъект.IDK = Ссылка.РабочийЛист;
	СобытиеОбъект.ВидСобытия = Справочники.CRM_ВидыСобытий.Оплата;
	СобытиеОбъект.Сотрудник = Менеджер;
	СобытиеОбъект.ДилерскийЦентр = Ссылка.ДилерскийЦентр;
	СобытиеОбъект.ДоговорНаПродажуАвтомобиля = Ссылка;
	СобытиеОбъект.Отдел = Отдел;
	СобытиеОбъект.Подразделение = Подразделение;
	СобытиеОбъект.Автор = ПараметрыСеанса.Пользователь.Сотрудник;
	СобытиеОбъект.Дата = ТекущаяДата();
	СобытиеОбъект.ДатаНапоминания = НачалоДня(ДатаОплаты)+Час(ДатаОплатыВремя)*3600+Минута(ДатаОплатыВремя)*60;
	СобытиеОбъект.Комментарий = "РЛ "+Ссылка.РабочийЛист + ": "+ФормыОплаты+"| "+Комментарий;
	СобытиеОбъект.КомментарийЗакрытия = Комментарий;
	СобытиеОбъект.Обработано = Ложь;
	СобытиеОбъект.ЗавершеноУспешно = Ложь;
	СобытиеОбъект.Записать(РежимЗаписиДокумента.Проведение);

	Напоминание = Справочники.Renault_СообщенияПользователю.СоздатьЭлемент();
	Напоминание.Отправитель = ПараметрыСеанса.Пользователь.Сотрудник;
	Напоминание.Подробнее = Ссылка;
	Напоминание.Адресаты.Добавить().Сотрудник = Менеджер;
	Напоминание.ДатаОтправки = ТекущаяДата();
	Напоминание.Комментарий = Комментарий;
	Напоминание.ВидСообщения = Справочники.Renault_ВидСообщения.Автосклад_ДоговорНаПродажуАвтомобиляПереданНаОформление;
	Напоминание.ПоказыватьС = ТекущаяДата();
	Напоминание.ПоказыватьПо = НачалоДня(ДатаОплаты) + Час(ДатаОплатыВремя)*3600+Минута(ДатаОплатыВремя)*60;
	Напоминание.Наименование = Ссылка.Клиент;
	Напоминание.ИдентификаторОбъекта = СобытиеОбъект.Номер;
	Напоминание.Сообщение = "Задача на оформление документов по РЛ " + Ссылка.РабочийЛист+": " +ФормыОплаты;
	
	Напоминание.Записать();

	Возврат СобытиеОбъект.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция	ПолучитьСтатусыСотрудников(Список, ДилерскийЦентр)
	
	ТаблицаСтатусы = Renault_CRM.ПолучитьСтатусыСотрудников(Список);
	
	ТаблицаСоСтатусом = Renault_CRM.ПолучитьПредставлениеСотрудниковСоСтатусами(Список, ТаблицаСтатусы, ДилерскийЦентр);

	Возврат ТаблицаСоСтатусом;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗначениеСлужебныхНастроек () 
	
	Возврат Справочники.Renault_СлужебныеНастройкиБазыДанных[ПараметрыСеанса.DMS_Бренд.Наименование].ФормироватьЗадачуОЗаписиНаДиагностикуПриЗаписиНаОплату;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьЗадачуОЗаписиКлиентаНаДиагностику(Событие, Менеджер, Договор)
	ЗаписьРЛ = Renault_CRM.ПолучитьЗаписьРЛПоIDK(Договор.РабочийЛист);
	IDK = ?(ЗначениеЗаполнено(ЗаписьРЛ.СвязаныйIDK), ЗаписьРЛ.СвязаныйIDK, Строка(Формат(Договор.РабочийЛист,"ЧГ=")));
	Документы.CRM_СобытияПоРабочимЛистам.СоздатьЗадачуОЗаписиКлиентаНаДиагностику(Событие, Менеджер, IDK);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Ссылка = Параметры.Ссылка;
	Отдел = Параметры.Отдел;
	Подразделение = Параметры.Подразделение;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	CRM_Отделы.Ссылка
	|ИЗ
	|	Справочник.CRM_Отделы КАК CRM_Отделы
	|ГДЕ
	|	CRM_Отделы.КлассификацияRenault = ЗНАЧЕНИЕ(Перечисление.CRM_КлассификацияОтделов.ОтделТрейдИн)
	|	И CRM_Отделы.ДилерскийЦентр = &ДилерскийЦентр
	|	И НЕ CRM_Отделы.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДилерскийЦентр", Ссылка.ДилерскийЦентр);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	ОтделТрейдИн = Результат.Ссылка;
	ЗаявкаТрейдИн = ПолучитьЗаявкиТрейдИн(Ссылка);
	
	ДатаОплаты = ТекущаяДата();
	ДатаОплатыВремя = ДатаОплаты;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Массив=Новый Массив;
	Массив.Добавить(Элементы.кнОК);	
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветФона","ОсновнойЦвет");
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив,"ЦветРамки","ОсновнойЦвет");

КонецПроцедуры

&НаКлиенте
Процедура ДатаОплатыПриИзменении(Элемент)
	Если (НачалоДня(ДатаОплаты)+Час(ДатаОплатыВремя)*3600+Минута(ДатаОплатыВремя)*60)<ТекущаяДата() Тогда
		Сообщить("Дата оплаты не может быть меньше текущей даты");
		ДатаОплаты = ТекущаяДата();
		ДатаОплатыВремя = ДатаОплаты;
	КонецЕсли;
КонецПроцедуры


