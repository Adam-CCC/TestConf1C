
&НаКлиенте
Процедура КомандаОк(Команда)
	ОбработатьИзмененияНасервере();
	Закрыть("Ок");
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзмененияНасервере ()
	Если ПереключательФиксироватьНаДату = 0 Тогда
		
		// Фиксируем
		Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
		Запись.Автомобиль = Автомобиль;
		Запись.Прочитать();
		Если Не Запись.Выбран() Тогда
			Запись.Период = ТекущаяДата();
			Запись.Автомобиль = Автомобиль;
		КонецЕсли;
		
		Запись.ДатаФиксации = ДатаФиксации;
		Запись.ЦенаФиксирована = Истина;
		Запись.ЦенаПродажиРОП = 0;
		Запись.Записать();
		
	ИначеЕсли ПереключательФиксироватьНаДату = 1 Тогда
		
		// РОП
		Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
		Запись.Автомобиль = Автомобиль;
		Запись.Прочитать();
		Если Не Запись.Выбран() Тогда
			Запись.Период = ТекущаяДата();
			Запись.Автомобиль = Автомобиль;
		КонецЕсли;
		
		Запись.ЦенаФиксирована = Ложь;
		Запись.ЦенаПродажиРОП = ЦенаПродажиРОП;
		Запись.Записать();
		
	ИначеЕсли ПереключательФиксироватьНаДату = 2 Тогда
		
		// По тарифу
		
		// Сбрасываем цену роп и фиксацию
		Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
		Запись.Автомобиль = Автомобиль;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.ЦенаФиксирована = Ложь;
			Запись.ЦенаПродажиРОП = 0;
			Запись.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("СтатусЦены") и Параметры.Свойство("VIN") и Параметры.Свойство("Автомобиль") Тогда
		Автомобиль = Параметры.Автомобиль;
		VIN = Параметры.VIN;
		Если Параметры.СтатусЦены = "Фиксирована" Тогда
			ПереключательФиксироватьНаДату = 0;
		ИначеЕсли Параметры.СтатусЦены = "Установлена" Тогда
			ПереключательФиксироватьНаДату = 1;
		ИначеЕсли Параметры.СтатусЦены = "По тарифу" Тогда
			ПереключательФиксироватьНаДату = 2;
		КонецЕсли;
		
		// Определяем дату фиксации  и цену роп
		Запись = РегистрыСведений.CRM_ДополнительнаяИнформацияПоАвтомобилям.СоздатьМенеджерЗаписи();
		Запись.Автомобиль = Автомобиль;
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			ДатаФиксации = Запись.ДатаФиксации;
			ЦенаПродажиРОП = Запись.ЦенаПродажиРОП;
		КонецЕсли;
		
		Запись.ДатаФиксации = ДатаФиксации;
		
		Элементы.ЦенаПродажиРОП.Доступность = ПереключательФиксироватьНаДату = 1;
		Элементы.ДатаФиксации.Доступность = ПереключательФиксироватьНаДату = 0;
		
		// Цена по последнему тарифу
		СтоимостьБазовойКомплектации = Renault_ОбщегоНазначения.ПолучитьЦенуБазовойКомплектацииПоТарифу(VIN, Ложь);
		СтоимостьДопОпций = Renault_ОбщегоНазначения.ПолучитьСтоимостьЗаводскихОпцийПоТарифу(VIN, Ложь);
		ЦенаПродажиАвтомобиляПоПоследнемуТарифу = СтоимостьБазовойКомплектации + СтоимостьДопОпций;;
		
		Если ПереключательФиксироватьНаДату = 0 Тогда
			СтоимостьБазовойКомплектации = 0;
			СтоимостьДопОпций = 0;
			Если ЗначениеЗаполнено(ДатаФиксации) Тогда
				СтоимостьБазовойКомплектации = Renault_ОбщегоНазначения.ПолучитьЦенуБазовойКомплектацииПоТарифу(VIN,, ДатаФиксации);
				СтоимостьДопОпций = Renault_ОбщегоНазначения.ПолучитьСтоимостьЗаводскихОпцийПоТарифу(VIN,, ДатаФиксации);
			КонецЕсли;
			
			ЦенаПродажиАвтомобиля = СтоимостьБазовойКомплектации + СтоимостьДопОпций;
		ИначеЕсли ПереключательФиксироватьНаДату = 1 Тогда
			ЦенаПродажиАвтомобиля = ЦенаПродажиРОП;
		Иначе
			ЦенаПродажиАвтомобиля = ЦенаПродажиАвтомобиляПоПоследнемуТарифу;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПереключательФиксироватьНаДатуПриИзменении(Элемент)
	ОбработатьСменуПереключателяНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбработатьСменуПереключателяНаСервере ()   
	Элементы.ЦенаПродажиРОП.Доступность = ПереключательФиксироватьНаДату = 1;
	Элементы.ДатаФиксации.Доступность = ПереключательФиксироватьНаДату = 0;
	Если ПереключательФиксироватьНаДату = 1 Тогда
		// РОП
		ЦенаПродажиАвтомобиля = ЦенаПродажиРОП;
	ИначеЕсли ПереключательФиксироватьНаДату = 2 Тогда
	
		// по тарифу
		ЦенаПродажиАвтомобиля = ЦенаПродажиАвтомобиляПоПоследнемуТарифу;
		
	ИначеЕсли ПереключательФиксироватьНаДату = 0 Тогда
		
		// Дата фиксации
		Если ЗначениеЗаполнено(ДатаФиксации) Тогда
			СтоимостьБазовойКомплектации = Renault_ОбщегоНазначения.ПолучитьЦенуБазовойКомплектацииПоТарифу(VIN, Ложь, ДатаФиксации);
			СтоимостьДопОпций = Renault_ОбщегоНазначения.ПолучитьСтоимостьЗаводскихОпцийПоТарифу(VIN, Ложь, ДатаФиксации);
			
			ЦенаПродажиАвтомобиля = СтоимостьБазовойКомплектации + СтоимостьДопОпций;
		Иначе	
		    ЦенаПродажиАвтомобиля = 0;
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДатаФиксацииПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ДатаФиксации) Тогда
		СтоимостьБазовойКомплектации = Renault_ОбщегоНазначения.ПолучитьЦенуБазовойКомплектацииПоТарифу(VIN, Ложь, ДатаФиксации);
		СтоимостьДопОпций = Renault_ОбщегоНазначения.ПолучитьСтоимостьЗаводскихОпцийПоТарифу(VIN, Ложь, ДатаФиксации);
		ЦенаПродажиАвтомобиля = СтоимостьБазовойКомплектации + СтоимостьДопОпций;
	Иначе	
		ЦенаПродажиАвтомобиля = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаФиксацииПриИзменении(Элемент)
	
	ДатаФиксацииПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенаПродажиРОППриИзменении(Элемент)
	ЦенаПродажиАвтомобиля = ЦенаПродажиРОП;
КонецПроцедуры
