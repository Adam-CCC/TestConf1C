			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументRenault_Договор.Номер КАК Номер,
	ДокументRenault_Договор.Клиент КАК Клиент,
	ДокументRenault_Договор.Клиент КАК Покупатель,
