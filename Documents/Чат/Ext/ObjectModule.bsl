 // Получить остатки номенклатуры
 // Номенклатура - СправочникСсылка на номенклатуру
 // Возвращаемое значение Число - остаток номенклатуры
 Функция ПолучитьОстаткиНоменклатурыНаСкладах(Знач СкладКомпании,Номенклатура) Экспорт
	 
	 //Будем считать что остаток нулевой
	 ОстатокНоменклатуры=0;
	 СтруктураОтбора = Новый Структура("Номенклатура",Номенклатура);
	 Если Не ЗначениеЗаполнено(СкладКомпании) Тогда
		 СкладКомпании=Справочники.СкладыКомпании.ПустаяСсылка();
	 КонецЕсли;
	 СтруктураОтбора.Вставить("СкладКомпании", СкладКомпании);
	 
	 СписокСкладовДилерскогоЦентра = Новый СписокЗначений;
	 СписокСкладовДилерскогоЦентра.Добавить(СкладКомпании);
	 
	 ДЦ = СкладКомпании.Подразделение.ДилерскийЦентр;
	 Если Не обЗначениеНеЗаполнено(ДЦ) Тогда
		 СписокСкладовДилерскогоЦентра = СписокСкладовДЦ(ДЦ);
	 КонецЕсли; 
	 
	 Попытка 
		 ДатаОстатков = ЭтотОбъект.Дата;
	 Исключение
		 ДатаОстатков = ТекущаяДата();
	 КонецПопытки; 
	 
	 Запрос = Новый Запрос;
	 
	 //Запрос.Текст = "ВЫБРАТЬ
	 //|	ОстаткиТоваровКомпанииОстатки.СкладКомпании КАК СкладКомпании,
	 //|	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток-ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК Остаток
	 //|ИЗ
	 //|	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(&ДатаОстатков,"+?(ЗначениеЗаполнено(СкладКомпании),"СкладКомпании=&СкладКомпании И ","")+" Номенклатура = &Номенклатура  ) КАК ОстаткиТоваровКомпанииОстатки
	 //|";
	 
	 Запрос.Текст = "ВЫБРАТЬ
	 |	ОстаткиТоваровКомпанииОстатки.СкладКомпании КАК СкладКомпании,
	 |	ОстаткиТоваровКомпанииОстатки.КоличествоОстаток-ОстаткиТоваровКомпанииОстатки.РезервОстаток КАК Остаток
	 |ИЗ
	 |	РегистрНакопления.ОстаткиТоваровКомпании.Остатки(,"+?(ЗначениеЗаполнено(СкладКомпании),"СкладКомпании В (&СписокСкладовДилерскогоЦентра) И ","")+" Номенклатура = &Номенклатура) КАК ОстаткиТоваровКомпанииОстатки
	 |";
	 
	 
	 //Запрос.УстановитьПараметр("СкладКомпании", СкладКомпании);
	 Запрос.УстановитьПараметр("СписокСкладовДилерскогоЦентра", СписокСкладовДилерскогоЦентра);
	 
	 Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	 Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ДатаОстатков));
	 
	 ВыборкаОстатковНоменклатурыНаСкладах=Запрос.Выполнить().Выбрать();
	 
	 Пока ВыборкаОстатковНоменклатурыНаСкладах.Следующий() Цикл
		 ОстатокНоменклатуры=ОстатокНоменклатуры + ВыборкаОстатковНоменклатурыНаСкладах.Остаток;
	 КонецЦикла; 
	 
	 Возврат ОстатокНоменклатуры;
	 
 КонецФункции
 
 Функция СписокСкладовДЦ(ВыбДЦ)
	 
	 //Сообщить("Работает список складов ДЦ");
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	СкладыКомпании.Ссылка,
	 |	СкладыКомпании.Подразделение.ДилерскийЦентр
	 |ИЗ
	 |	Справочник.СкладыКомпании КАК СкладыКомпании
	 |ГДЕ
	 |	СкладыКомпании.Подразделение.ДилерскийЦентр = &ВыбДЦ";
	 
	 Запрос.УстановитьПараметр("ВыбДЦ", ВыбДЦ);
	 
	 СписокСкладов = Новый СписокЗначений;
	 
	 //ТЗ = Запрос.Выполнить().Выгрузить();
	 // ТЗ.ВыбратьСтроку();
	 
	 СписокСкладов.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	 
	 //Сообщить("Список складов ДЦ: "+СписокСкладов);
	 
	 Возврат СписокСкладов;
	 
 КонецФункции // СписокСкладовДЦ()
 
 // Получить остатки номенклатуры
 // Номенклатура - СправочникСсылка на номенклатуру
 //  
 // Возвращаемое значение Число - остаток номенклатуры
 Процедура ПолучитьОстаткиЗаказаНоменклатурыНаСкладах(Знач РодительПодразделения,Знач ПодразделениеКомпании,Номенклатура,ДатаОстатков,ВсегоЗаказано,Просрочено) Экспорт
	 
	 //Будем считать что остаток нулевой
	 ОстатокЗаказаНоменклатуры=0;
	 ОстатокЗаказаНоменклатурыПросрочено=0;
	 ДатаМинусМесяц = ДобавитьМесяц(ДатаОстатков,-1);
	 
	 СтруктураОтбора = Новый Структура("Номенклатура",Номенклатура);
	 
	 Запрос = Новый Запрос;
	 
	 Запрос.Текст = "ВЫБРАТЬ
	 |	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК Остаток,
	 |	ЗаказыПоставщикамОстатки.ЗаказПоставщику.ПодразделениеКомпании КАК ПодразделениеКомпании,
	 |	ЗаказыПоставщикамОстатки.ЗаказПоставщику,
	 |	ЗаказыПоставщикамОстатки.ЗаказПоставщику.Дата КАК ДатаЗаказа
	 |ИЗ
	 |	РегистрНакопления.ЗаказыПоставщикам.Остатки(
	 |			&ДатаОстатков,
	 |			Номенклатура = &Номенклатура
	 |				 ) КАК ЗаказыПоставщикамОстатки";
	 
	 //Бондаренко 20160421 ++			   
	 Если РодительПодразделения = ПодразделениеКомпании Тогда
		 Запрос.Текст = Запрос.Текст + "
		 | ГДЕ ЗаказыПоставщикамОстатки.ЗаказПоставщику.ПодразделениеКомпании = &ПодразделениеКомпании";
		 Запрос.УстановитьПараметр("ПодразделениеКомпании", ПодразделениеКомпании);
	 Иначе	
		 Запрос.Текст = Запрос.Текст + "
		 | ГДЕ ЗаказыПоставщикамОстатки.ЗаказПоставщику.ПодразделениеКомпании В ИЕРАРХИИ (&РодительПодразделения)";
		 Запрос.УстановитьПараметр("РодительПодразделения", РодительПодразделения); 
	 КонецЕсли; 			   
	 //Бондаренко 20160421 --
	 
	 Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	 Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ДатаОстатков));
	 
	 ВыборкаОстатковЗаказа=Запрос.Выполнить().Выбрать();
	 
	 Пока ВыборкаОстатковЗаказа.Следующий() Цикл
		 Если ВыборкаОстатковЗаказа.ДатаЗаказа < ДатаМинусМесяц Тогда
			 ОстатокЗаказаНоменклатурыПросрочено=ОстатокЗаказаНоменклатурыПросрочено + ВыборкаОстатковЗаказа.Остаток;
		 КонецЕсли;	
		 ОстатокЗаказаНоменклатуры=ОстатокЗаказаНоменклатуры + ВыборкаОстатковЗаказа.Остаток;		
	 КонецЦикла;
	 
	 ВсегоЗаказано = ОстатокЗаказаНоменклатуры;
	 Просрочено 	  = ОстатокЗаказаНоменклатурыПросрочено;	
	 
 КонецПроцедуры //ПолучитьОстаткиЗаказаНоменклатурыНаСкладах()
 
 Функция НайтиОсновнойСклад(Подразделение)
	 
	 НайденныйСклад = Справочники.СкладыКомпании.ПустаяСсылка();
	 
	 Запрос = Новый Запрос;
	 Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	СкладыКомпании.Ссылка,
	 |	СкладыКомпании.Подразделение,
	 |	СкладыКомпании.Основной
	 |ИЗ
	 |	Справочник.СкладыКомпании КАК СкладыКомпании
	 |ГДЕ
	 |	СкладыКомпании.ЭтоГруппа = ЛОЖЬ
	 |	И СкладыКомпании.Основной = ИСТИНА
	 |	И СкладыКомпании.Подразделение = &ВыбПодразделение";
	 
	 Запрос.УстановитьПараметр("ВыбПодразделение", Подразделение);
	 
	 Результат = Запрос.Выполнить();
	 
	 ВыборкаДетальныеЗаписи = Результат.Выбрать();
	 
	 Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 НайденныйСклад = ВыборкаДетальныеЗаписи.Ссылка;
		 Возврат НайденныйСклад; 
	 КонецЦикла;
	 
	 Возврат НайденныйСклад; 
	 
 КонецФункции // НайтиОсновнойСклад()
