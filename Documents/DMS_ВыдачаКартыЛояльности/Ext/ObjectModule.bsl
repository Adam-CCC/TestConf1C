Перем Права Экспорт;

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 
	
	Если Статус = Перечисления.DMS_СтатусЗаменыКарт.НаОзнакомлении Тогда
	
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение
			И Проведен Тогда
		
			РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения;
			
		ИначеЕсли  РежимЗаписи = РежимЗаписиДокумента.Проведение
			И Не Проведен Тогда
		
			РежимЗаписи = РежимЗаписиДокумента.Запись;
			
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Статус 		  = Перечисления.DMS_СтатусЗаменыКарт.НаОзнакомлении;
	Ответственный = ПараметрыСеанса.Пользователь;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Статус 		  = Перечисления.DMS_СтатусЗаменыКарт.НаОзнакомлении;
	Ответственный = ПараметрыСеанса.Пользователь;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КартыКлиента.Ссылка.Дата КАК Период,
		|	КартыКлиента.Ссылка КАК Регистратор,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	КартыКлиента.Ссылка.Контрагент КАК Контрагент,
		|	КартыКлиента.Ссылка.ПрограммаЛояльности КАК ПрограммаЛояльности,
		|	КартыКлиента.КартаЛояльности КАК КартаЛояльности,
		|	КартыКлиента.Номинал КАК Начислено,
		|	0 КАК КСписанию,
		|	КартыКлиента.Ссылка.ВидОперации КАК ВидОперации
		|ИЗ
		|	Документ.DMS_ВыдачаКартыЛояльности.КартыПокупателей КАК КартыКлиента
		|ГДЕ
		|	КартыКлиента.Ссылка = &Ссылка
		|	И КартыКлиента.Ссылка.ВидОперации = ЗНАЧЕНИЕ(перечисление.DMS_ВидыОперацийКартЛояльности.ВыдачаБонуснойКарты)
		|	И КартыКлиента.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.DMS_СтатусЗаменыКарт.Согласован)
		|	И КартыКлиента.Номинал > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КартыКлиента.ПогаситьДо,
		|	КартыКлиента.Ссылка,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
		|	КартыКлиента.Ссылка.Контрагент,
		|	КартыКлиента.Ссылка.ПрограммаЛояльности,
		|	КартыКлиента.КартаЛояльности,
		|	0,
		|	КартыКлиента.Номинал,
		|	КартыКлиента.Ссылка.ВидОперации
		|ИЗ
		|	Документ.DMS_ВыдачаКартыЛояльности.КартыПокупателей КАК КартыКлиента
		|ГДЕ
		|	КартыКлиента.Ссылка = &Ссылка
		|	И КартыКлиента.Ссылка.ВидОперации = ЗНАЧЕНИЕ(перечисление.DMS_ВидыОперацийКартЛояльности.ВыдачаБонуснойКарты)
		|	И КартыКлиента.ПогаситьДо <> ДАТАВРЕМЯ(1, 1, 1)
		|	И КартыКлиента.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.DMS_СтатусЗаменыКарт.Согласован)
		|	И КартыКлиента.Номинал > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КартыКлиента.Ссылка.Дата КАК Период,
		|	КартыКлиента.Ссылка КАК Регистратор,
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
		|	КартыКлиента.КартаЛояльности КАК КартаЛояльности,
		|	КартыКлиента.ПогаситьДо КАК ПогаситьДо,
		|	КартыКлиента.Номинал КАК КоличествоБаллов,
		|	КартыКлиента.Ссылка.ВидОперации КАК ВидОперации
		|ИЗ
		|	Документ.DMS_ВыдачаКартыЛояльности.КартыПокупателей КАК КартыКлиента
		|ГДЕ
		|	КартыКлиента.Ссылка = &Ссылка
		|	И КартыКлиента.Ссылка.ВидОперации = ЗНАЧЕНИЕ(перечисление.DMS_ВидыОперацийКартЛояльности.ВыдачаБонуснойКарты)
		|	И КартыКлиента.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.DMS_СтатусЗаменыКарт.Согласован)
		|	И КартыКлиента.Номинал > 0";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Движения.DMS_БонусныеБаллы.Записывать 	  = Истина;
	Движения.Renault_ОстаткиБаллов.Записывать = Истина;
	
	Движения.DMS_БонусныеБаллы.Загрузить(РезультатЗапроса[0].Выгрузить());	
	Движения.Renault_ОстаткиБаллов.Загрузить(РезультатЗапроса[1].Выгрузить());	
	
КонецПроцедуры

// Процедура удаляет из массива МассивРеквизитов элементы, соответствующие именам 
// реквизитов объекта из массива МассивНепроверяемыхРеквизитов.
// Для использования в обработчиках события ОбработкаПроверкиЗаполнения.
//
// Параметры:
//	МассивРеквизитов              - Массив - массив строк с именами реквизитов объекта.
//	МассивНепроверяемыхРеквизитов - Массив строк с именами реквизитов объекта, не требующих проверки.
//
Процедура УдалитьНепроверяемыеРеквизитыИзМассива(МассивРеквизитов, МассивНепроверяемыхРеквизитов) Экспорт
	
	Для Каждого ЭлементМассива Из МассивНепроверяемыхРеквизитов Цикл
	
		ПорядковыйНомер = МассивРеквизитов.Найти(ЭлементМассива);
		Если ПорядковыйНомер <> Неопределено Тогда
			МассивРеквизитов.Удалить(ПорядковыйНомер);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецЕсли
