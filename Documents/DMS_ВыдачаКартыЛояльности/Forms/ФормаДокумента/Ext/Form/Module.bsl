
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДанныеПоВыдачеНовойКарты") Тогда
	
		ЗаполнитьЗначенияСвойств(Объект,Параметры.ДанныеПоВыдачеНовойКарты);
		
		НоваяСтрока = Объект.КартыПокупателей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Параметры.ДанныеПоВыдачеНовойКарты);
				
	КонецЕсли; 
	
	Если Объект.Статус = Перечисления.DMS_СтатусЗаменыКарт.Согласован Тогда
		ТолькоПросмотр = Истина;
		Элементы.КартыПокупателейСоздатьКартуЛояльности.Доступность = Ложь;
		Элементы.ФормаРедактироватьРеквизиты.Видимость = Истина;
		Элементы.Статус.ТолькоПросмотр = Ложь;
	Иначе 
		Элементы.КартыПокупателейСоздатьКартуЛояльности.Доступность = Истина;
		Элементы.ФормаРедактироватьРеквизиты.Видимость = Ложь;
		Элементы.Статус.ТолькоПросмотр = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	Оповестить("Запись_ВыдачиКарты",ВладелецФормы);
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКартуЛояльности(Команда)
	
	Если Вопрос("Создать новую?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьКартуЛояльностиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СогласиеНаОбработкуДанных(Команда)
	
	// сохранение ссылки на коллекцию прав, настроек и окружения
	Права = Неопределено;
	#Если Клиент Тогда
		Права = глПрава;
	#КонецЕсли
	
	СогласиеНаОбработкуПерсональныхДанныхДата = Объект.Дата;
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = Документы.DMS_ВыдачаКартыЛояльности.ПолучитьМакетСогласия();
	
	СтруктураПредставления=Новый Структура(
		"ИНН,КПП,АдресЮридический,ТелефонРабочий",
		"ИНН ","КПП ","Адрес: ","тел.: "
	);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакета.Параметры.КонтрагентНаименование	= Объект.Контрагент.НаименованиеПолное;
	ОбластьМакета.Параметры.КонтрагентАдрес			= киПолучитьПредставлениеКИ(Объект.Контрагент,Справочники.ВидыКонтактнойИнформации.АдресФактический);
	ОбластьМакета.Параметры.КонтрагентДокумент		= спПолучитьПодтверждающийДокументОбъектаПоВиду(Объект.Контрагент,Перечисления.ВидыДокументов.Паспорт);
	ОбластьМакета.Параметры.ОрганизацияНаименование	= спПолучитьПредставление(ПараметрыСеанса.Организация,Новый Структура("Наименование",""));
	ОбластьМакета.Параметры.ОрганизацияАдрес		= спПолучитьПредставление(ПараметрыСеанса.Организация,СтруктураПредставления);
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Согласие");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
	ОбластьМакета.Параметры.КонтрагентНаименование	= Объект.Контрагент.Наименование;
	ОбластьМакета.Параметры.СогласиеДата			= Формат(СогласиеНаОбработкуПерсональныхДанныхДата,"ДФ=dd.MM.yyyy");
	ТабДокумент.Вывести(ОбластьМакета);
	
	// Отобразить печатный документ на экране
	КлючУникальности	= Новый УникальныйИдентификатор();
	ФормаПечати			= ПолучитьОбщуюФорму("ПечатнаяФормаДокументов",,КлючУникальности);
	ТабличныйДокумент	= ФормаПечати.ЭлементыФормы.ТабличныйДокумент;
	ТабличныйДокумент.Защита			= обПраво("ЗащитаПечатныхФорм",Права);
	ТабличныйДокумент.ТолькоПросмотр	= обПраво("ОткрытиеПечатныхФормДокументовВРежимеПросмотра",Права);
	// Выведем печатную форму	
	ФормаПечати.ЭлементыФормы.ТабличныйДокумент.Вывести(ТабДокумент);
	// Заполним необходимые переменные и откроем форму
	ФормаПечати.Объект						= Объект.Контрагент.Ссылка;
	ФормаПечати.ОбъектПредставление			= Строка(Объект.Контрагент.Ссылка);
	ФормаПечати.ДополнительноКПредставлению	= "Согласие на обработку персональных данных";
	ФормаПечати.Открыть();
	
	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.DMS_СтатусЗаменыКарт.Согласован") Тогда
		
		Объект.Статус = ПредопределенноеЗначение("Перечисление.DMS_СтатусЗаменыКарт.Согласован");
		Модифицированность = Истина;
		
	КонецЕсли; 
	
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.DMS_СтатусЗаменыКарт.НаОзнакомлении") Тогда
		Элементы.Статус.ТолькоПросмотр = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьРеквизиты(Команда)
	
	ТолькоПросмотр = Элементы.ФормаРедактироватьРеквизиты.Пометка;	
	Элементы.ФормаРедактироватьРеквизиты.Пометка = Не Элементы.ФормаРедактироватьРеквизиты.Пометка;
	
	Элементы.КартыПокупателейСоздатьКартуЛояльности.Доступность = Элементы.ФормаРедактироватьРеквизиты.Пометка;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКартуЛояльностиНаСервере()
	
	Для каждого ТекущаяСтрока Из Объект.КартыПокупателей Цикл
	
		Если Не ЗначениеЗаполнено(ТекущаяСтрока.КартаЛояльности) 
			И ЗначениеЗаполнено(ТекущаяСтрока.ВидКарты) Тогда

			НоваяКартаОбъект = Справочники.Renault_КартыЛояльности.СоздатьЭлемент();	
			НоваяКартаОбъект.УстановитьНовыйКод();
			НоваяКартаОбъект.DMS_ВидКартыЛояльности = ТекущаяСтрока.ВидКарты;
			НоваяКартаОбъект.Контрагент 			= Объект.Контрагент;
			НоваяКартаОбъект.ДатаВыдачи 			= ТекущаяДата();
			НоваяКартаОбъект.КемВыдана   			= ПараметрыСеанса.Пользователь.Сотрудник;
			НоваяКартаОбъект.ПрограммаЛояльности	= Объект.ПрограммаЛояльности;
			НоваяКартаОбъект.Наименование			= "Карта: " + Строка(Объект.Контрагент);
			НоваяКартаОбъект.ДилерскийЦентр 		= Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			
			Попытка
				НоваяКартаОбъект.Записать();
			Исключение
			   	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			
			ТекущаяСтрока.КартаЛояльности = НоваяКартаОбъект.Ссылка;
			
			ТекущаяСтрока.ПогаситьДо = ЗаполнитьДатуПогашения(ТекущаяСтрока.ВидКарты,ТекущаяСтрока.КартаЛояльности.ПрограммаЛояльности,Объект.Дата);
			
		ИначеЕсли ЗначениеЗаполнено(ТекущаяСтрока.КартаЛояльности) 
			И ЗначениеЗаполнено(ТекущаяСтрока.ВидКарты) Тогда

			НоваяКартаОбъект = ТекущаяСтрока.КартаЛояльности.ПолучитьОбъект();	
			НоваяКартаОбъект.DMS_ВидКартыЛояльности = ТекущаяСтрока.ВидКарты;
			НоваяКартаОбъект.ПрограммаЛояльности	= Объект.ПрограммаЛояльности;
			НоваяКартаОбъект.ПометкаУдаления 		= Ложь;
			НоваяКартаОбъект.Наименование			= "Карта: " + Строка(Объект.Контрагент);
			НоваяКартаОбъект.ДилерскийЦентр 		= Renault_CRM.ПолучитьДилерскийЦентрПользователя();
			
			Попытка
				НоваяКартаОбъект.Записать();
			Исключение
			   	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			
			ТекущаяСтрока.КартаЛояльности = НоваяКартаОбъект.Ссылка;
						
			ТекущаяСтрока.ПогаситьДо = ЗаполнитьДатуПогашения(ТекущаяСтрока.ВидКарты,ТекущаяСтрока.КартаЛояльности.ПрограммаЛояльности,Объект.Дата);
			
		КонецЕсли; 
	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура КартыПокупателейКартаЛояльностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура КартыПокупателейКартаЛояльностиПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.КартыПокупателей.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ТекущаяСтрока.ПогаситьДо = ЗаполнитьДатуПогашения(ТекущаяСтрока.ВидКарты,ПолучитьЗначениеРеквизита(ТекущаяСтрока.КартаЛояльности,"ПрограммаЛояльности"),Объект.Дата);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеРеквизита(мОбъект,ИмяРеквизита)

	Возврат мОбъект[ИмяРеквизита];

КонецФункции // ПолучитьЗначениеРеквизита()

&НаСервере
Функция ЗаполнитьДатуПогашения(ВидКартыЛояльности,ПрограммаЛояльности,Дата)
	
	ПогаситьДо = Дата("00010101");
	
	Если ЗначениеЗаполнено(ВидКартыЛояльности)
		И ВидКартыЛояльности.ИспользоватьСрокДействияБаллов Тогда
		
		ПогаситьДо = ДобавитьКДате(Дата,Формат(ВидКартыЛояльности.СрокДействияБаллов,"ЧЦ=10; ЧН=0; ЧГ="),СокрЛП(ВидКартыЛояльности.ПериодичностьДействияБаллов)); 
		
	ИначеЕсли ЗначениеЗаполнено(ПрограммаЛояльности) 
		И ПрограммаЛояльности.СрокДействияБаллов <> 0 Тогда  
		
		ПогаситьДо = ДобавитьКДате(НачалоДня(Дата),Формат(ПрограммаЛояльности.СрокДействияБаллов,"ЧЦ=10; ЧН=0; ЧГ=")); 
	
	КонецЕсли; 	

	Возврат ПогаситьДо;
	
КонецФункции

&НаСервере
Функция ДобавитьКДате(мДата,Количество,Тип = "День")
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("мДата", мДата);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДОБАВИТЬКДАТЕ(&мДата, "+Тип+", "+Количество+") КАК НоваяДата";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	НоваяДата = мДата;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяДата = ВыборкаДетальныеЗаписи.НоваяДата;
	КонецЦикла;
	
	Возврат НоваяДата;
	
КонецФункции // ДобавитьКДате()

