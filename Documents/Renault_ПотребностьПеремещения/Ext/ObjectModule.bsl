Процедура ОбработкаУдаленияПроведения(Отказ)
	
	НаборЗаписей = РегистрыСведений.Renault_ПланПеремещения.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПотребностьПеремещения.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
	
КонецПроцедуры
