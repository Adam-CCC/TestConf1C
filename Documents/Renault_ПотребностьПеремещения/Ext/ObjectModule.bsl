Перем СтараяДата;
Перем Ответственный;
Перем РабочиеОтметки;

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)	
	Префикс = DMS_ОбщегоНазначенияСервер.ПолучитьПрефикс();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
	СтараяДата = Ссылка.ЖелаемаяДатаПеремещения + (Ссылка.ВремяПоступления - Дата('00010101'));
	Ответственный = Ссылка.Продавец;

КонецПроцедуры

Процедура ПриЗаписи(Отказ) 
	
	Если ОбменДанными.Загрузка Тогда 		
		Возврат;  		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиЗаявку(ТекСтрока, НовоеВремяЗаписи) Экспорт
	
	СтараяДатаЗаписи = ЖелаемаяДатаПеремещения;
	СтароеВремяЗаписи = ВремяПоступления;
	
	НачатьТранзакцию();
	ТекстСообщения = "";
	Попытка
		ЖелаемаяДатаПеремещения = Дата(Год(НовоеВремяЗаписи.ДатаВремяПеремещения),Месяц(НовоеВремяЗаписи.ДатаВремяПеремещения),День(НовоеВремяЗаписи.ДатаВремяПеремещения));
		ВремяПоступления = Дата(1,1,1,Час(НовоеВремяЗаписи.ДатаВремяПеремещения),Минута(НовоеВремяЗаписи.ДатаВремяПеремещения),Секунда(НовоеВремяЗаписи.ДатаВремяПеремещения));
		Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = "Не удалось создать новую запись в журнале по причине:
		|" + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
		ТекстСообщения = "Заявка № " + Номер + " перенесена с " + Формат(СтароеВремяЗаписи, "ДФ=ЧЧ:мм") + Формат(СтараяДатаЗаписи, "ДФ='dd MMMM yyyy ""г.""'") + 
						" на " + Формат(ВремяПоступления, "ДФ=ЧЧ:мм") + " " + Формат(ЖелаемаяДатаПеремещения, "ДФ='dd MMMM yyyy ""г.""'");
	КонецЕсли;
	
	Renault_ОбщегоНазначения.СообщитьИнформациюПользователю(ТекстСообщения);
	
КонецПроцедуры

Процедура ИзменитьЗаявкуИзПланаПеремещений(ДопОборудование) Экспорт
	
	НачатьТранзакцию();
	ТекстСообщения = "";
	Попытка
		ДО = ДопОборудование;
		Записать();
	Исключение
		ОтменитьТранзакцию();
		ТекстСообщения = "Не удалось создать новую запись в журнале по причине:
		|" + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	Renault_ОбщегоНазначения.СообщитьИнформациюПользователю(ТекстСообщения);
	
КонецПроцедуры

Процедура ЗаписатьИсториюПереносовЗаявки(СтараяДатаЗаписи, НовоеВремяЗаписи, Ответственный) Экспорт
	
	ЗаписьИсторияПереносов = РегистрыСведений.Renault_ИсторияПереносовЗаявокНаПеремещение.СоздатьМенеджерЗаписи();
	ЗаписьИсторияПереносов.ЗаявкаНаПеремещение = Ссылка;
	ЗаписьИсторияПереносов.СтараяДатаПередачи = СтараяДатаЗаписи;
	ЗаписьИсторияПереносов.НоваяДатаПередачи = НовоеВремяЗаписи;
	ЗаписьИсторияПереносов.ОтветственныйЗаПеренос = ПараметрыСеанса.Пользователь;
	ЗаписьИсторияПереносов.Продавец = Ответственный;
	ЗаписьИсторияПереносов.Период = ТекущаяДата();
	ЗаписьИсторияПереносов.Записать();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//Для Каждого СтрокаТЗ из Автомобили Цикл
