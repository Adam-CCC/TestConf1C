//   Справочники.ДоговорыВзаиморасчетов  или пустая ссылка этого же типа  
//
Функция НайтиДоговор(ПараметрыДоговора)
	
	ДоговорВзаиморасчетов = Справочники.ДоговорыВзаиморасчетов.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	//Бондаренко++ 20180321
	//Если СокрЛП(ПараметрыДоговора.Организация.ИНН)<>"6167075244" Тогда
	//	Запрос.Текст = 
	//	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	//	|	ДоговорыВзаиморасчетов.Ссылка,
	//	|	ДоговорыВзаиморасчетов.ВидДоговора,
	//	|	ДоговорыВзаиморасчетов.Владелец,
	//	|	ДоговорыВзаиморасчетов.Организация,
	//	|	ДоговорыВзаиморасчетов.ДатаСоздания КАК ДатаСоздания,
	//	|	ДоговорыВзаиморасчетов.ПометкаУдаления,
	//	|	ДоговорыВзаиморасчетов.Владелец.ОсновнойДоговорВзаиморасчетов КАК ОснДоговор,
	//	|	ДоговорыВзаиморасчетов.ДляПерепродаж,
	//	|	ДоговорыВзаиморасчетов.ДляЗапчастей,
	//	|	ДоговорыВзаиморасчетов.Подразделение
	//	|ИЗ
	//	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	//	|ГДЕ
	//	|	ДоговорыВзаиморасчетов.Владелец = &ВыбВладелец
	//	|	И ДоговорыВзаиморасчетов.Организация = &ВыбОрганизация
	//	|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВыбВидДоговора
	//	|	И ДоговорыВзаиморасчетов.Подразделение = &ВыбПодразделение
	//	|	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
	//	|	И ДоговорыВзаиморасчетов.ДляЗапчастей = ИСТИНА
	//	|	И ДоговорыВзаиморасчетов.ДляПерепродаж = ИСТИНА
	//	|	И ДоговорыВзаиморасчетов.Подразделение = &ВыбПодразделение
	//	|
	//	|УПОРЯДОЧИТЬ ПО
	//	|	ДатаСоздания";
	// 	Запрос.УстановитьПараметр("ВыбПодразделение", ПараметрыДоговора.Подразделение);
	//Иначе
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДоговорыВзаиморасчетов.Ссылка,
	|	ДоговорыВзаиморасчетов.ВидДоговора,
	|	ДоговорыВзаиморасчетов.Владелец,
	|	ДоговорыВзаиморасчетов.Организация,
	|	ДоговорыВзаиморасчетов.ДатаСоздания КАК ДатаСоздания,
	|	ДоговорыВзаиморасчетов.ПометкаУдаления,
	|	ДоговорыВзаиморасчетов.Владелец.ОсновнойДоговорВзаиморасчетов КАК ОснДоговор,
	|	ДоговорыВзаиморасчетов.ДляПерепродаж,
	|	ДоговорыВзаиморасчетов.ДляЗапчастей
	|ИЗ
	|	Справочник.ДоговорыВзаиморасчетов КАК ДоговорыВзаиморасчетов
	|ГДЕ
	|	ДоговорыВзаиморасчетов.Владелец = &ВыбВладелец
	|	И ДоговорыВзаиморасчетов.Организация = &ВыбОрганизация
	|	И ДоговорыВзаиморасчетов.ВидДоговора = &ВыбВидДоговора
	|	И ДоговорыВзаиморасчетов.ПометкаУдаления = ЛОЖЬ
	|	И ДоговорыВзаиморасчетов.ДляЗапчастей = ИСТИНА
	|	И ДоговорыВзаиморасчетов.ДляПерепродаж = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания";
	//КонецЕсли;
	//Бондаренко-- 20180321
	
	Запрос.УстановитьПараметр("ВыбВидДоговора", ПараметрыДоговора.ВидДоговора);
	Запрос.УстановитьПараметр("ВыбВладелец", ПараметрыДоговора.Контрагент);
	Запрос.УстановитьПараметр("ВыбОрганизация", ПараметрыДоговора.Организация);
	//Запрос.УстановитьПараметр("ВыбПодразделение", ПараметрыДоговора.Подразделение);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДоговорВзаиморасчетов = ВыборкаДетальныеЗаписи.Ссылка; 
		Если ВыборкаДетальныеЗаписи.ДляПерепродаж Тогда
			Прервать;
		КонецЕсли; 
	КонецЦикла;
	
	Если обЗначениеНезаполнено(ДоговорВзаиморасчетов) Тогда
		Дог = Справочники.ДоговорыВзаиморасчетов.СоздатьЭлемент();
		Дог.Автор=ПараметрыСеанса.Пользователь;
		Дог.ДатаСоздания=ТекущаяДата();
		Дог.ДатаНачала=ТекущаяДата();
		Дог.ВидДоговора=ПараметрыДоговора.ВидДоговора;
		Дог.Владелец = ПараметрыДоговора.Контрагент;
		Дог.Организация = ПараметрыДоговора.Организация;
		Дог.Подразделение = ПараметрыДоговора.Подразделение;
		Дог.ВалютаВзаиморасчетов=Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
		Дог.ВидОплаты=Перечисления.ВидыОплаты.ПроизвольнаяОплата;
		Дог.ДляЗапчастей=Истина;
		Дог.ДляПерепродаж=Истина;
		Дог.Наименование = СокрЛП(Строка(Дог.ВидДоговора))
		+ ?(ПустаяСтрока(Дог.НомерДоговора),""," № " + СокрЛП(Дог.НомерДоговора))
		+ " в " + Дог.ВалютаВзаиморасчетов.Наименование
		+ " от "+Формат(Дог.ДатаНачала,"ДФ=дд.ММ.гг");
		
		Попытка
			Дог.Записать();
			ДоговорВзаиморасчетов = Дог.Ссылка;
		Исключение
			Сообщить("ОШИБКА! Не удалось записать договор");		
		КонецПопытки;
		
	КонецЕсли; 
	
	Возврат ДоговорВзаиморасчетов;
	
	
КонецФункции // НайтиДоговор(ПараметрыДоговора)

Функция НайтиРозничнуюЦену(Номенклатура,ТипЦен,ЕдИзмерения,Подразделение)
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныСрезПоследних.Номенклатура,
	|	ЦеныСрезПоследних.ТипЦен,
	|	ЦеныСрезПоследних.ЕдиницаИзмерения,
	|	ЦеныСрезПоследних.ПодразделениеКомпании,
	|	ЦеныСрезПоследних.Цена,
	|	ЦеныСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.Цены.СрезПоследних КАК ЦеныСрезПоследних
	|ГДЕ
	|	ЦеныСрезПоследних.Номенклатура = &ВыбНомен
	|	И ЦеныСрезПоследних.ТипЦен = &ВыбТипЦен
	|	И ЦеныСрезПоследних.ЕдиницаИзмерения = &ВыбЕдИзмерен
	|	И ЦеныСрезПоследних.ПодразделениеКомпании = &ВыбПодразделение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Запрос.Параметры.Вставить("ВыбНомен",Номенклатура);
	Запрос.Параметры.Вставить("ВыбТипЦен",ТипЦен);
	Запрос.Параметры.Вставить("ВыбЕдИзмерен",ЕдИзмерения);
	Запрос.Параметры.Вставить("ВыбПодразделение",Подразделение);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Цена;
	КонецЦикла;
	
	Возврат 0;
	
	
КонецФункции // НайтиРозничнуюЦену()


Функция СоздатьДокументыПерепродажиПоЮрЛицам (ТоварыКПродаже,ТекСкладОтправитель) Экспорт 
	
	//Бондаренко++ 20190204
	СтавкаНДС20 = Справочники.СтавкиНДС.ОсновнаяСтавкаНДС;
	//Бондаренко-- 20190204
	
	ЕстьОшибки=Ложь;
	
	РеализацияОбъект = Документы.РеализацияТоваров.СоздатьДокумент();
	РеализацияОбъект.РегламентированныйУчет = Истина;
	РеализацияОбъект.Дата = ТекущаяДата();
	РеализацияОбъект.УстановитьНовыйНомер();
	РеализацияОбъект.ХозОперация = Справочники.ХозОперации.РеализацияТоваров;
	
	РеализацияОбъект.ДокументОснование=Ссылка;
	
	РеализацияОбъект.Организация = ТекСкладОтправитель.Организация;
	РеализацияОбъект.ОбработкаРеквизита("Организация");
	
	РеализацияОбъект.ПодразделениеКомпании = ТекСкладОтправитель.Подразделение;
	//РеализацияОбъект.ОбработкаРеквизита("ПодразделениеКомпании");
	
	РеализацияОбъект.СкладКомпании = ТекСкладОтправитель;
	
	ДопПараметры = Новый Структура("НеРассчитыватьСкидки,ВозможностьИзмененияЦен",Истина,Ложь);
	РеализацияОбъект.ОбработкаРеквизита("СкладКомпании",,,ДопПараметры);
	
	
	Если РеализацияОбъект.ПодразделениеКомпании.ДилерскийЦентр=Справочники.ДилерскиеЦентры.Еврокар_Гамма Тогда
		Попытка
			РеализацияОбъект.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
			РеализацияОбъект.ОбработкаРеквизита("ТипЦен");
		Исключение
			#Если НаКлиенте Тогда
				Сообщить("ОШИБКА! Не найден тип цен 'Основной тип цен закупки'. Обработка прервана.", СтатусСообщения.ОченьВажное);
			#КонецЕсли 
			ЕстьОшибки=Истина;
			Возврат ЕстьОшибки;
		КонецПопытки;	
	Иначе	
		Попытка
			РеализацияОбъект.ТипЦен = Справочники.ТипыЦен.ОсновнойТипЦенЗакупки;
			РеализацияОбъект.ОбработкаРеквизита("ТипЦен");
		Исключение
			#Если НаКлиенте Тогда
				Сообщить("ОШИБКА! Не найден тип цен 'Основной тип цен закупки'. Обработка прервана.", СтатусСообщения.ОченьВажное);
			#КонецЕсли 
			ЕстьОшибки=Истина;
			Возврат ЕстьОшибки;
		КонецПопытки;	
	КонецЕсли; 
	
	РеализацияОбъект.КурсВалютыВзаиморасчетов=1;
	РеализацияОбъект.КурсВалютыУпр=1;
	РеализацияОбъект.КурсДокумента=1;
	
	РеализацияОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчетаОрганизаций.Получить();
	РеализацияОбъект.ОбработкаРеквизита("ВалютаДокумента");
	
