Функция ПолучитьТаблицуТоваров()
	
	ТекстЗапроса="ВЫБРАТЬ
	             |	ПеремещениеТоваровОпт.Номенклатура КАК Номенклатура,
	             |	ПеремещениеТоваровОпт.КоличествоБазовое,
	             |	ПеремещениеТоваровОпт.СкладыКомпании КАК СкладКомпании,
	             |	ПеремещениеТоваровОпт.СкладыПолучатели КАК СкладПолучатель
	             |ИЗ
	             |	Документ.ПеремещениеТоваровОпт.Товары КАК ПеремещениеТоваровОпт
	             |ГДЕ
	             |	ПеремещениеТоваровОпт.Ссылка = &Ссылка";

	Запрос=Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.Текст=ТекстЗапроса;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуОстатковПартий(СЗ_Товаров,СЗ_Складов)
	
	ТекстЗапроса="ВЫБРАТЬ
	             |	ПартииТоваров.Номенклатура КАК Номенклатура,
	             |	ПартииТоваров.Партия КАК Партия,
	             |	ПартииТоваров.КоличествоОстаток КАК КоличествоОстаток,
	             |	ПартииТоваров.СуммаОстаток КАК СуммаОстаток,
	             |	ПартииТоваров.Партия.Дата КАК ПартияДата,
	             |	ПартииТоваров.СкладКомпании КАК СкладКомпании
	             |ИЗ
	             |	РегистрНакопления.ПартииТоваровКомпании.Остатки(
	             |			&МоментВремени,
	             |			Номенклатура В (&ВыбСписокНоменклатура)
	             |				И СкладКомпании В (&ВыбСписокСкладов)) КАК ПартииТоваров
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	ПартияДата";

	Запрос=Новый Запрос();
	Запрос.УстановитьПараметр("МоментВремени",?(обЗначениеНеЗаполнено(Ссылка.Дата),ТекущаяДата(),Ссылка.Дата));
	Запрос.УстановитьПараметр("ВыбСписокНоменклатура",СЗ_Товаров);
	Запрос.УстановитьПараметр("ВыбСписокСкладов",СЗ_Складов);
	Запрос.Текст=ТекстЗапроса;

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
