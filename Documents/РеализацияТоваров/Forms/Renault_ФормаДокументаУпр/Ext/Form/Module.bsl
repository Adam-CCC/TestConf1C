// нажатие на гиперссылку, показывающую текущее состояние взаиморасчетов 
//
// Параметры:
// ЭтаФорма 			- форма, форма переданного документа
// Элемент 			- ЭУ надпись, служит для вывода состояния взаиморасчетов
// РеквизитКонтрагента - СправочникСсылка.Контрагенты, контрагент документа,
// по которому выводится состояние взаиморасчетов
// РеквизитКонтрагента - СправочникСсылка.договорыВзаиморасчетов, договор
// контрагента, по которому выводится состояние взаиморасчетов
//
&НаКлиенте
Процедура ВзаиморасчетыНажатие(ЭтаФорма,Элемент,РеквизитКонтрагента = Неопределено,РеквизитДоговорВзаиморасчетов = Неопределено) Экспорт
	// проверки
	Контрагент = Неопределено; ДоговорВзаиморасчетов = Неопределено;
	Попытка
		Если РеквизитКонтрагента = Неопределено Тогда
			Если НЕ ЗначениеНеЗаполнено(Объект.Контрагент) Тогда 
				Контрагент = Объект.Контрагент; 
			Иначе 
				Возврат; 
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеНеЗаполнено(Объект[РеквизитКонтрагента]) Тогда 
				Контрагент = Объект[РеквизитКонтрагента]; 
			Иначе 
				Возврат; 
			КонецЕсли;
		КонецЕсли; 
	Исключение
		Возврат; // раз нет контрагента, то дальше и делить нечего
	КонецПопытки;
	Попытка
		Если РеквизитДоговорВзаиморасчетов = Неопределено Тогда
			Если НЕ ЗначениеНеЗаполнено(Объект.ДоговорВзаиморасчетов) Тогда 
				ДоговорВзаиморасчетов = Объект.ДоговорВзаиморасчетов; 
			КонецЕсли;
		Иначе
			Если НЕ ЗначениеНеЗаполнено(Объект[РеквизитДоговорВзаиморасчетов]) Тогда 
				ДоговорВзаиморасчетов = Объект[РеквизитДоговорВзаиморасчетов]; 
			КонецЕсли;
		КонецЕсли; 
	Исключение
	КонецПопытки;
	
	ФормаОтчета = ПолучитьФорму("ОбщаяФорма.Отчет_Тонкий_Клиент",,ЭтаФорма);
	ФормаОтчета.ОтчетОбъект = СоздатьОтчетОбъектНаСервере();
	ФормаОтчета.Заголовок = "Взаиморасчеты компании";
	ФормаОтчета.Открыть();
	
	ВывестиЗаголовокВзаиморасчеты(ЭтаФорма);
КонецПроцедуры // дкВзаиморасчетыНажатие()

&НаСервере
Функция СоздатьОтчетОбъектНаСервере()
	// заполним параметры отчета
	Отчет = Отчеты.Взаиморасчеты.Создать();
	Отчет.ВидОтчета = Перечисления.ВидыОтчетов.Остатки;
	Отчет.ДатаКонца = ТекущаяДата();
	Отчет.РежимВыводаОтчета = Перечисления.РежимыВыводаОтчета.ТабличныйДокумент;
	Отчет.РежимНастройки = Перечисления.РежимыНастройкиОтчетов.Эксперт;
	Отчет.ИмяФормыНастроек = "НастройкиОстатки";
	Отчет.ЗаполнитьНачальныеНастройки("ТекстЗапросаОстатки");
	
	//// уберем измерения "Организация", "ПодразделениеКомпании" ...
	//ТекОрганизация = Отчет.ИзмеренияСтроки.Найти("Организации", "ПутьКДанным");
	//Если ТекОрганизация<>Неопределено Тогда ТекОрганизация.Использование = Ложь; КонецЕсли;
	//ТекПодразделениеКомпании = Отчет.ИзмеренияСтроки.Найти("Подразделение", "ПутьКДанным");
	//Если ТекПодразделениеКомпании<>Неопределено Тогда ТекПодразделениеКомпании.Использование = Ложь; КонецЕсли;
	Для каждого Измерение Из Отчет.ИзмеренияСтроки Цикл
		Если Измерение.ПутьКДанным="Контрагент" ИЛИ 
			 Измерение.ПутьКДанным="ДоговорВзаиморасчетов" ИЛИ
			 Измерение.ПутьКДанным="Сделка" Тогда
			Измерение.Использование=Истина;
		Иначе
			Измерение.Использование=Ложь;
		КонецЕсли; 
	КонецЦикла; 
	
	// показатели все только итоговых сумм
	Для Каждого СтрокаПоказателей Из Отчет.Показатели Цикл
		Если СтрокаПоказателей.Имя="ИтогоСумма" ИЛИ
			 СтрокаПоказателей.Имя="ИтогоСуммаБаз" Тогда
			СтрокаПоказателей.Использование=Истина;
		Иначе
			СтрокаПоказателей.Использование=Ложь;
		КонецЕсли; 
	КонецЦикла;
	
	// фильтры
	Попытка
		Отчет.ПостроительОтчета.Отбор.Контрагент.Значение = Объект.Контрагент;
		Отчет.ПостроительОтчета.Отбор.Контрагент.Использование = Истина;
		//ТекКонтрагент = Отчет.ИзмеренияСтроки.Найти("Контрагент", "ПутьКДанным");
		//Если ТекКонтрагент <> Неопределено Тогда ТекКонтрагент.Использование = Ложь; КонецЕсли;
	Исключение
	КонецПопытки; 
	Попытка 
		Отчет.ПостроительОтчета.Отбор.ДоговорВзаиморасчетов.Значение = Объект.ДоговорВзаиморасчетов;
		Отчет.ПостроительОтчета.Отбор.ДоговорВзаиморасчетов.Использование = НЕ ЗначениеНеЗаполнено(Объект.ДоговорВзаиморасчетов);
		//ТекДоговорВзаиморасчетов = Отчет.ИзмеренияСтроки.Найти("ДоговорВзаиморасчетов", "ПутьКДанным");
		//Если ТекДоговорВзаиморасчетов <> Неопределено Тогда ТекДоговорВзаиморасчетов.Использование = Ложь; КонецЕсли;
	Исключение 
	КонецПопытки;
	Возврат Отчет;
КонецФункции	

// формирует заголовок гиперссылки, показывающей текущее состояние взаиморасчетов 
//
// Параметры:
// ЭтаФорма - форма, форма переданного документа
//
&НаКлиенте
Процедура ВывестиЗаголовокВзаиморасчеты(ЭтаФорма) Экспорт
	Если ЭтаФорма <> Неопределено Тогда
		// проверка на договор
		Если ЭтаФорма.Элементы.Найти("ДоговорВзаиморасчетов") = Неопределено Тогда
			Возврат 
		КонецЕсли;
		
		//получим элемент на форме
		Попытка
			НадписьНаФорме = ЭтаФорма.Элементы.ДолгКлиента;
			ДляАРМ = Ложь;
		Исключение
			НадписьНаФорме = ЭтаФорма.Элементы.тВзаиморасчетыДляАРМ;
			ДляАРМ = Истина;
		КонецПопытки;	
		
		//НадписьНаФорме.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
		Если ЗначениеНеЗаполнено(Объект.ДоговорВзаиморасчетов) Тогда
			// пустой договор
			НадписьНаФорме.Заголовок = " < Договор не выбран > ";
		Иначе
			// получим долг
			Долг = ДолгКонтрагента();
			// выведем на экран этот долг
			Если ДляАРМ Тогда
				НадписьНаФорме.Заголовок = "Долг контрагент" + ?(Долг < 0,"у","а") + ": " + Формат(?(Долг < 0,-Долг,Долг),"ЧДЦ = 2; ЧН = 0,00") + " " + СокрЛП(ПолучитьНаименованиеВалютыВзаиморасчетов());
			Иначе
				НадписьНаФорме.Заголовок = "По договору долг контрагент" + ?(Долг < 0,"у","а") + " составляет: " + Формат(?(Долг < 0,-Долг,Долг),"ЧДЦ = 2; ЧН = 0,00") + " " + СокрЛП(ПолучитьНаименованиеВалютыВзаиморасчетов());
			КонецЕсли;
			Если Долг < 0 Тогда
				НадписьНаФорме.ЦветТекста = WebЦвета.ТемноКрасный;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
КонецПроцедуры // дкВывестиЗаголовокВзаиморасчеты()

&НаСервере 
Функция ПолучитьНаименованиеВалютыВзаиморасчетов()
	Возврат Объект.ДоговорВзаиморасчетов.ВалютаВзаиморасчетов.Наименование;
КонецФункции

&НаСервере
Функция ДолгКонтрагента()
	СтруктураОтбора = Новый Структура("Контрагент,ДоговорВзаиморасчетов",Объект.Контрагент,Объект.ДоговорВзаиморасчетов);
	тзДолги = РегистрыНакопления.ВзаиморасчетыКомпании.Остатки(,СтруктураОтбора,,"Сумма,СуммаУпр");
	Долг = тзДолги.Итог("Сумма");
	Возврат Долг;
КонецФункции	

// Возвращает массив подчиненных документов.
//
// Параметры: Основание	 - ДокументСсылка. Тот документ подчиненных для которого ищем
//	МассивВидов			 - Массив. Массив строк с видами подчиненных документов. Если МассивВидов не определен,
//						 то возвращаются все подчиненные документы
//
// Возвращаемое значение: 
// Массив ссылок документов
//
&НаСервере
Функция ПолучитьМассивПодчиненных(Основание,МассивВидов = Неопределено, ТолькоНеПомеченные = Ложь) Экспорт
	// проверим на пустое основание
	Если ЗначениеНеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// получим массив подчиненных документов
	МассивПодчиненных = КритерииОтбора.ПодчиненныеДокументы.Найти(Основание);
	// если задан фильтр на виды документов, то пропустим полученный массив через этот фильтр
	Если (МассивВидов <> Неопределено) И (МассивПодчиненных.Количество() > 0) Тогда
		ТекИндекс = 0;
		Пока ТекИндекс <= МассивПодчиненных.ВГраница() Цикл
			НайденВФильтре = Ложь;
			Для Сч = 0 По МассивВидов.ВГраница() Цикл
				Если МассивПодчиненных[ТекИндекс].Ссылка.Метаданные().Имя = МассивВидов[Сч] Тогда
					НайденВФильтре = Истина; Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НайденВФильтре И (НЕ ТолькоНеПомеченные ИЛИ НЕ МассивПодчиненных[ТекИндекс].Ссылка.ПометкаУдаления) Тогда 
				ТекИндекс = ТекИндекс + 1; 
			Иначе 
				МассивПодчиненных.Удалить(ТекИндекс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивПодчиненных;
КонецФункции // дкЗаполнитьТабличнуюЧастьПоОснованию()

&НаКлиенте
Процедура кнПечать(Команда)
	
	Если Объект.Ссылка.Пустая() или Модифицированность Тогда
		Предупреждение("Печать доступна только после записи");
		Возврат
	КонецЕсли;
	
	Сп = Новый СписокЗначений;
	СписокПечатныхФорм = ПолучитьСписокПечатныхФорм();
	Для каждого Эл Из СписокПечатныхФорм Цикл 
		Сп.Добавить(Эл.Значение) 
	КонецЦикла;
	
	Парам = Новый Структура;
	Парам.Вставить("Список",Сп);
	Парам.Вставить("Заголовок","Доступные печатные формы");
	Парам.Вставить("МножественныйВыбор",Ложь);
	Парам.Вставить("КоличествоЭлементовВСтроке",3);
	Парам.Вставить("ШиринаЭлемента",19); 
	Парам.Вставить("ВысотаЭлемента",3);
	ТабДок = Неопределено;
	
	Если Сп.Количество() > 1 Тогда
		НазваниеПечатнойФормы = ОткрытьФормуМодально("ОбщаяФорма.Renault_ДиалогВыбораСпискаЗначений",Парам,ЭтаФорма);
	ИначеЕсли Сп.Количество() = 1 Тогда
		НазваниеПечатнойФормы = Сп.Получить(0);
	Иначе 
		Возврат;
	КонецЕсли;		
	
	НайденнаяПечатнаяФорма = Неопределено;
	Для каждого Эл Из СписокПечатныхФорм Цикл 
		Если Эл.Значение = Строка(НазваниеПечатнойФормы) Тогда
			НайденнаяПечатнаяФорма = Эл.Ключ
		КонецЕсли;
	КонецЦикла;
	Если НайденнаяПечатнаяФорма <> Неопределено Тогда		
		ПараметрКоманды = Новый Структура;
		ПараметрКоманды.Вставить("Ссылка",Объект.Ссылка);
		ПараметрКоманды.Вставить("Права",Права);
		ПараметрКоманды.Вставить("ФункцияПечати","Печать" + НайденнаяПечатнаяФорма);
		
		ПечатьНаСервере(ТабДок, ПараметрКоманды);
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТабДок <> Неопределено Тогда
		П = Новый Структура("ТабличныйДокумент", ТабДок);
		ОткрытьФорму("ОбщаяФорма.Renault_Печать",П,ЭтаФорма,ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает доступные варианты печати документа
// Возвращаемое значение: 
//  Структура, каждая строка которой
//  соответствует одному из вариантов печати
//  Первый элемент структуры - форма по умолчанию
Функция ПолучитьСписокПечатныхФорм()
	СтруктураМакетов=Новый Структура();
	СтруктураМакетов.Вставить("РеализацияТоваров", "Расходная накладная");
	СтруктураМакетов.Вставить("ПодборочныйЛист", "Подборочный лист");
	СтруктураМакетов.Вставить("ТОРГ12", "ТОРГ-12 (Товарная накладная)");
	СтруктураМакетов.Вставить("Т1", "1-Т (Товарно-транспортная накладная)");
	СтруктураМакетов.Вставить("Приложение4", "Приложение №4 (Транспортная накладная)");
	СтруктураМакетов.Вставить("ЭтикетокИЦенников", "Печать этикеток и ценников");
	Возврат СтруктураМакетов;
КонецФункции // ПолучитьСписокПечатныхФорм()

