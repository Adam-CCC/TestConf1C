
&НаКлиенте
Перем ЗаявкиСписок;

//////////////////////////////////////////
//События формы
//------------------BEGIN-----------------
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.Номер.ТолькоПросмотр = НЕ РольДоступна("ПолныеПрава");
	
	Если Объект.Ссылка.Пустая() Тогда
		ЭтоМосква = Константы.Renault_ЭтоМосковскаяБаза.Получить();
		Renault_ОбщегоНазначенияКлиентСервер.ЗаполнитьНовыйДокумент(Объект, ПараметрыСеанса.Пользователь);
		Объект.НашАвтомобиль = ЭтоМосква <> Истина;
		Объект.НашВодитель = ЭтоМосква <> Истина;
		Объект.Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.ВПути;
	Иначе
		Если Объект.Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
			Элементы.Статус.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Маршрут") Тогда
		Параметры.Свойство("Маршрут", Объект.Маршрут);
	КонецЕсли;
	
	Если Параметры.Свойство("АвтомобильИЗаявка") Тогда
		НоваяСтрока = Объект.Автомобили.Добавить();
		НоваяСтрока.Автомобиль = Параметры.АвтомобильИЗаявка.Автомобиль1;
		НоваяСтрока.ЗаявкаНаПеремещение = Параметры.АвтомобильИЗаявка.Заявка1;
		НоваяСтрока.Место = Число(Параметры.АвтомобильИЗаявка.Место1);
	КонецЕсли;
	
	Если Параметры.Свойство("АвтомобильИЗаявка1") Тогда
		НоваяСтрока = Объект.Автомобили.Добавить();
		НоваяСтрока.Автомобиль = Параметры.АвтомобильИЗаявка1.Автомобиль2;
		НоваяСтрока.ЗаявкаНаПеремещение = Параметры.АвтомобильИЗаявка1.Заявка2;
		НоваяСтрока.Место = Число(Параметры.АвтомобильИЗаявка1.Место2);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.Проведен Тогда
		УстановитьДоступновстьВсехРеквизитов();
	КонецЕсли;
	
	ЗафиксироватьОперацию = ЗначениеЗаполнено(Объект.ДатаОперации);
	ОбновитьВидимостьЭлементов();
	УстановитьДоступностьРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.Ссылка.Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
		Сообщить("Перемещение закрыто. Перепроведение со статусом ""Закрыто"" невозможно!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.Маршрут.СкладОтправитель.Renault_Территория <> Объект.Маршрут.СкладПолучатель.Renault_Территория Тогда
		
		Если Объект.НашАвтомобиль И Объект.НашВодитель Тогда
			Если Объект.Водитель.Пустая() Тогда
				Сообщить("Не выбран водитель!", СтатусСообщения.Важное);
				Отказ = Истина;
			КонецЕсли;
			Если Объект.Автомобиль.Пустая() Тогда
				Сообщить("Не выбран эвакуатор!", СтатусСообщения.Важное);
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Для каждого Строка из Объект.Автомобили Цикл
			Если Не ЗначениеЗаполнено(Строка.ЗаявкаНаПеремещение) Тогда
				Заявки = ПолучитьЗаявкуНаПеремещение(Строка.Автомобиль);
				Если Заявки.Свойство("Заявка") ИЛИ Заявки.Свойство("Заявки") Тогда
				Сообщить("В строке " + Строка.НомерСтроки + " не указан документ ""Заявка на перемещение""");
				Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Объект.Водитель = 0;
		Объект.Автомобиль = 0;
		
	КонецЕсли;
	
	Объект.ДатаОперации = ?(ЗафиксироватьОперацию, Объект.ДатаОперации, Неопределено);
	
КонецПроцедуры

//------------------END-------------------
//События формы
//////////////////////////////////////////

//////////////////////////////////////////
//События элементов
//------------------BEGIN-----------------

&НаКлиенте
Процедура ЗафиксироватьОперациюПриИзменении(Элемент)
	
	ОбновитьВидимостьЭлементов();
	Объект.ДатаОперации = ?(ЗафиксироватьОперацию, ТекущаяДата(), Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьАвто(Команда)
	
	ЗаполнитьСтрокуНовымАвто(ДиалогВыбораАвто());
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьАвто(Команда)
	
	текДанные = Элементы.Автомобили.ТекущиеДанные;
	Если текДанные <> Неопределено Тогда
		ЗаполнитьСтрокуНовымАвто(ДиалогВыбораАвто(), текДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьАвто(Команда)
	
	текДанные = Элементы.Автомобили.ТекущиеДанные;
	Если текДанные <> Неопределено Тогда
		Объект.Автомобили.Удалить(текДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АвтомобилиАвтомобильНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	текДанные = Элементы.Автомобили.ТекущиеДанные;
	ЗаявкиСписок = Неопределено;
	Если текДанные <> Неопределено Тогда
		ЗаполнитьСтрокуНовымАвто(ДиалогВыбораАвто(), текДанные);
	КонецЕсли;
	
КонецПроцедуры
//------------------END-------------------
//События элементов
//////////////////////////////////////////

//////////////////////////////////////////
//самописные процедуры и функции
//------------------BEGIN-----------------

&НаКлиенте
Процедура ЗаполнитьСтрокуНовымАвто(ВыбАвто, текСтрока = Неопределено)
	
	Если ВыбАвто <> Неопределено Тогда
		
		текМесто = ПолучитьПарковочноеМесто(ВыбАвто);
		Заявка = Неопределено;
		
		ЗаявкаНаПеремещение = ПолучитьЗаявкуНаПеремещение(ВыбАвто); //возвращает структуру сообщение, заявка или список заявок
		Если ЗаявкаНаПеремещение.Свойство("Сообщение") Тогда
			Сообщить(ЗаявкаНаПеремещение["Сообщение"]);
			Если ЗаявкаНаПеремещение.Свойство("Заявки") Тогда
				ЗаявкиСписок = ЗаявкаНаПеремещение["Заявки"]; 
			КонецЕсли;
		Иначе
			Заявка = ЗаявкаНаПеремещение["Заявка"];
			ЗаявкиСписок = Новый СписокЗначений;
			ЗаявкиСписок.Добавить(ЗаявкаНаПеремещение["Заявка"]); 
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(?(текСтрока = Неопределено, Объект.Автомобили.Добавить(), текСтрока),
									Новый Структура("Автомобиль, Место, ЗаявкаНаПеремещение", ВыбАвто, текМесто, Заявка));
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗаявкуНаПеремещение(ВыбАвто)
	
	ЗаявкаНаПеремещениеСтруктура = Новый Структура;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Renault_ЗаявкаНаПеремещение.Ссылка
	|ПОМЕСТИТЬ ВТ_Заявки
	|ИЗ
	|	Документ.Renault_ЗаявкаНаПеремещение КАК Renault_ЗаявкаНаПеремещение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПланПеремещений КАК ПланПеремещений
	|		ПО ПланПеремещений.ЗаявкаНаПеремещение = Renault_ЗаявкаНаПеремещение.Ссылка
	|ГДЕ
	|	Renault_ЗаявкаНаПеремещение.Маршрут = &Маршрут
	|	И Renault_ЗаявкаНаПеремещение.Автомобиль = &Автомобиль
	|	И НЕ ПланПеремещений.ЗаявкаНаПеремещение.Ссылка ЕСТЬ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заявки.Ссылка КАК Заявка,
	|	Renault_ПеремещениеАвтомобилейАвтомобили.Ссылка КАК Ссылка1
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Renault_ПеремещениеАвтомобилей.Автомобили КАК Renault_ПеремещениеАвтомобилейАвтомобили
	|		ПО ВТ_Заявки.Ссылка = Renault_ПеремещениеАвтомобилейАвтомобили.ЗаявкаНаПеремещение
	|ГДЕ
	|	Renault_ПеремещениеАвтомобилейАвтомобили.Ссылка ЕСТЬ NULL ";
	Запрос.УстановитьПараметр("Маршрут", Объект.Маршрут);
	Запрос.УстановитьПараметр("Автомобиль", ВыбАвто); 
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ЗаявкаНаПеремещениеСтруктура.Вставить("Сообщение", "Для выбранного автомобиля нет заявок на перемещение");		 
	Иначе
		Выборка = Результат.Выбрать();
		Если Выборка.Количество() > 1 Тогда
			МассивЗаявок = Новый Массив;
			Пока Выборка.Следующий() Цикл
				МассивЗаявок.Добавить(Выборка.Заявка);
			КонецЦикла;
			ЗаявкаНаПеремещениеСтруктура.Вставить("Сообщение", "Для выбранного автомобиля создано несколько заявок на перемещение! Необходимо указать заявку");
			ЗаявкаНаПеремещениеСтруктура.Вставить("Заявки", МассивЗаявок);
		ИначеЕсли Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			ЗаявкаНаПеремещениеСтруктура.Вставить("Заявка", Выборка.Заявка); 
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗаявкаНаПеремещениеСтруктура;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()
	
	Элементы.ДатаОперации.Видимость = ЗафиксироватьОперацию;
	УстановитьВидимостьМест();
	Элементы.ПечатьАктаПриемаПередачи.Видимость = Объект.Маршрут.СкладПолучатель.Renault_СкладХраненияАМ;
	
КонецПроцедуры

&НаКлиенте
Функция ДиалогВыбораАвто()
	
	Если НЕ Объект.Маршрут.Пустая() Тогда
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ОбработкаВыбора", 		Истина);
		ПараметрыОткрытия.Вставить("ВыборГруппИЭлементов",	ИспользованиеГруппИЭлементов.Элементы);
		ПараметрыОткрытия.Вставить("МножественныйВыбор",	НЕ ЗакрыватьПриВыборе);
		ПараметрыОткрытия.Вставить("РазрешитьВыборКорня",	Ложь);
		ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе",	ЗакрыватьПриВыборе);
		
		ПараметрыОтбора = Новый Структура;
		
		МассивАвто = Новый Массив;
		Для каждого текАвто ИЗ Объект.Автомобили Цикл
			Если МассивАвто.Найти(текАвто.Автомобиль) = Неопределено Тогда
				МассивАвто.Добавить(текАвто.Автомобиль);
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыОтбора.Вставить("Склад", Объект.Маршрут.СкладОтправитель);
		//ПараметрыОтбора.Вставить("Период", Объект.Дата);
		ПараметрыОтбора.Вставить("Период", Объект.ДатаОперации);
		ПараметрыОтбора.Вставить("МассивАвто", МассивАвто);
		Возврат ОткрытьФормуМодально("Справочник.Автомобили.Форма.ФормаВыбораАвтосалон", ПараметрыОтбора, Элементы.Автомобили);
		
	Иначе
		
		Предупреждение("Необходимо указать маршрут!", 8);
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура КомандаЗаполнитьПоПлану(Команда)
	
	Если Объект.Автомобили.Количество() Тогда
		
		вТекстВопроса      = "При заполнении текущий список автомобилей будет очищен." + Символы.ПС + "Продолжить?";
		вКнопки            = РежимДиалогаВопрос.ДаНет;
		вТаймаут           = 15;
		вКнопкаПоУмолчанию = КодВозвратаДиалога.Нет;
		вЗаголовок         = "Заполнение...";
		вКнопкаТаймаута    = КодВозвратаДиалога.Нет;
		
		Если Вопрос(вТекстВопроса, вКнопки, вТаймаут, вКнопкаПоУмолчанию, вЗаголовок, вКнопкаТаймаута) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		Иначе
			Объект.Автомобили.Очистить();
		КонецЕсли;
		
	КонецЕсли;
	
	СписокПеремещений = ПолучитьСписокПеремещений();
	
	Результат = ВыбратьИзМеню(СписокПеремещений, Элементы.АвтомобилиКоманднаяПанель);
	
	Если Результат <> Неопределено Тогда
		ЗаполнитьПоПлану(Результат.Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция  ПолучитьСписокПеремещений()
	
	Результат = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(1) КАК Количество,
	|	НАЧАЛОПЕРИОДА(ПланПеремещений.ДатаПлан, ДЕНЬ) КАК ДеньПлан,
	|	Маршруты.Ссылка КАК Маршрут
	|ИЗ
	|	РегистрСведений.ПланПеремещений КАК ПланПеремещений
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Renault_МаршрутыПеремещений КАК Маршруты
	|		ПО ПланПеремещений.СкладОтправитель = Маршруты.СкладОтправитель
	|			И ПланПеремещений.СкладПолучатель = Маршруты.СкладПолучатель
	|ГДЕ
	|	ПланПеремещений.ДатаПлан <= &ДатаКон
	|	И НЕ ПланПеремещений.Перемещено
	|	И ВЫБОР
	|			КОГДА &СкладОтправитель = ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ПланПеремещений.СкладОтправитель = &СкладОтправитель
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &СкладПолучатель = ЗНАЧЕНИЕ(Справочник.СкладыКомпании.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ПланПеремещений.СкладПолучатель = &СкладПолучатель
	|		КОНЕЦ
	|	И НЕ ПланПеремещений.СозданДокументПеремещения
	|	И НЕ ПланПеремещений.ЗаписьЗаблокирована
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ПланПеремещений.ДатаПлан, ДЕНЬ),
	|	Маршруты.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДеньПлан,
	|	Количество УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ТекущаяДата() + 604800));
	
	Если ЗначениеЗаполнено(Объект.Маршрут) Тогда
		Запрос.УстановитьПараметр("СкладОтправитель", Объект.Маршрут.СкладОтправитель);
		Запрос.УстановитьПараметр("СкладПолучатель", Объект.Маршрут.СкладПолучатель);
	Иначе 
		Запрос.УстановитьПараметр("СкладОтправитель", Справочники.Склады.ПустаяСсылка());
		Запрос.УстановитьПараметр("СкладПолучатель", Справочники.Склады.ПустаяСсылка());
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("Дата, Маршрут", Выборка.ДеньПлан, Выборка.Маршрут), Формат(Выборка.ДеньПлан, "ДФ='дд.ММ.гггг ""г.""'") + " " + Выборка.Маршрут + " (" + Выборка.Количество + ")");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьПоПлану(ПараметрыЗапроса)
	
	Если Объект.Маршрут.Пустая() Тогда
		Объект.Маршрут = ПараметрыЗапроса.Маршрут;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланПеремещений.Автомобиль,
	|	ПланПеремещений.ДатаПлан КАК ДатаПлан,
	|	ЕСТЬNULL(Renault_МестаАвтомобилей.ПарковочноеМесто, 0) КАК ПарковочноеМесто,
	|	ПланПеремещений.ЗаявкаНаПеремещение
	|ИЗ
	|	РегистрСведений.ПланПеремещений КАК ПланПеремещений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_МестаАвтомобилей КАК Renault_МестаАвтомобилей
	|		ПО ПланПеремещений.Автомобиль = Renault_МестаАвтомобилей.Автомобиль
	|ГДЕ
	|	ПланПеремещений.ДатаПлан МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПланПеремещений.СкладОтправитель = &СкладОтправитель
	|	И ПланПеремещений.СкладПолучатель = &СкладПолучатель
	|	И НЕ ПланПеремещений.СозданДокументПеремещения
	|	И НЕ ПланПеремещений.ЗаписьЗаблокирована
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПлан";
	
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ПараметрыЗапроса.Дата));
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ПараметрыЗапроса.Дата));
	Запрос.УстановитьПараметр("СкладОтправитель", ПараметрыЗапроса.Маршрут.СкладОтправитель);
	Запрос.УстановитьПараметр("СкладПолучатель", ПараметрыЗапроса.Маршрут.СкладПолучатель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Сч = 0;
	
	Пока Выборка.Следующий() И Сч < 2 Цикл
		НоваяСтрока = Объект.Автомобили.Добавить();
		НоваяСтрока.Автомобиль = Выборка.Автомобиль;
		НоваяСтрока.Место = Выборка.ПарковочноеМесто;
		НоваяСтрока.ЗаявкаНаПеремещение = Выборка.ЗаявкаНаПеремещение;
		Сч = Сч + 1;
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура АвтомобилиМестоНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Маршрут) Тогда
		Возврат;
	КонецЕсли;
	
	СвободныеМеста = ПолучитьСвободныеМеста();
	Элемент.СписокВыбора.ЗагрузитьЗначения(СвободныеМеста.ВыгрузитьКолонку("ПарковочноеМесто"));
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСвободныеМеста()
	
	ТаблицаМестВДокументе = Новый ТаблицаЗначений;
	ТаблицаМестВДокументе.Колонки.Добавить("Место", Новый ОписаниеТипов("Число"));
	
	Для Каждого Строка Из Объект.Автомобили Цикл
		Если Строка.Место Тогда
			НоваяСтрока = ТаблицаМестВДокументе.Добавить();
			НоваяСтрока.Место = Строка.Место;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МестаВДокументе.Место
	|ПОМЕСТИТЬ ВТМестаВДокументе
	|ИЗ
	|	&МестаВДокументе КАК МестаВДокументе
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Renault_МестаАвтомобилей.ПарковочноеМесто
	|ИЗ
	|	РегистрСведений.Renault_МестаАвтомобилей КАК Renault_МестаАвтомобилей
	|ГДЕ
	|	Renault_МестаАвтомобилей.Автомобиль = ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
	|	И Renault_МестаАвтомобилей.Территория = &Территория
	|	И НЕ Renault_МестаАвтомобилей.ПарковочноеМесто В
	|				(ВЫБРАТЬ
	|					ВТМестаВДокументе.Место
	|				ИЗ
	|					ВТМестаВДокументе КАК ВТМестаВДокументе)";
	
	Запрос.УстановитьПараметр("Территория", Объект.Маршрут.СкладПолучатель.Renault_Территория);
	Запрос.УстановитьПараметр("МестаВДокументе", ТаблицаМестВДокументе);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	
	Если Объект.Ссылка.Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
		Объект.Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто;
		Возврат;
	КонецЕсли;
	
	УстановитьВидимостьМест();
	
	Для Каждого Строка Из Объект.Автомобили Цикл
		Строка.Место = 0;
	КонецЦикла;
	
КонецПроцедуры

