КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьТТН(Команда)
	
	Если Не Объект.Проведен Тогда
		Сообщить("Для печати ТТН необходимо провести документ!");
		Возврат;
	КонецЕсли;
	
	ТабДок = ПечататьТТН();
	//УниверсальныеМеханизмы.НапечататьДокумент(ТабДок, 2, Ложь, "Товарно-транспортная накладная № " + Объект.Номер + " от " + Объект.Дата, Ложь);
	ТабДок.Показать("Товарно-транспортная накладная № " + Объект.Номер + " от " + Объект.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьПикингЛиста(Команда)
	
	Если Не Объект.Проведен Тогда
		Сообщить("Для печати пикинг-листа необходимо провести документ!");
		Возврат;
	КонецЕсли;
	
	ТабДок = ПечататьПикингЛист();
	//УниверсальныеМеханизмы.НапечататьДокумент(ТабДок, 2, Ложь, "Пикинг-лист № " + Объект.Номер + " от " + Объект.Дата, Ложь);	
	ТабДок.Показать("Пикинг-лист № " + Объект.Номер + " от " + Объект.Дата,,Истина);
	
КонецПроцедуры

&НаСервере
Функция ПечататьПикингЛист()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ТекОбъект.ПолучитьМакет("ПикингЛист");
	ТабДок = Новый ТабличныйДокумент;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Защита = Ложь;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	
	ОбластьШапка.Параметры.ДатаПечати = Объект.Дата;
	ОбластьШапка.Параметры.НомерДокумента = Объект.Номер;
	ОбластьШапка.Параметры.Затребовал = Объект.Маршрут.СкладПолучатель;
	
	ТабДок.Вывести(ОбластьШапка);
	ТабДок.Вывести(ОбластьШапкаТаблицы);
	
	Для Каждого Строка Из Объект.Автомобили Цикл
		
		ТекАвто = Строка.Автомобиль;
		ОбластьСтрока.Параметры.Автомобиль = "" + ТекАвто.Модель.Родитель + " - " + ТекАвто.Модель + " - VIN " + ТекАвто.Код;
		ОбластьСтрока.Параметры.Маршрут = "" + Объект.Маршрут.СкладОтправитель.Renault_Территория + " - " + Объект.Маршрут.СкладПолучатель.Renault_Территория;
		ОбластьСтрока.Параметры.ВнутреннийНомер = Строка.Место;
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ТабДок.Вывести(ОбластьПодвал);
	
	Возврат ТабДок;
	
КонецФункции

&НаСервере
Функция ПечататьТТН()
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ТекОбъект.ПолучитьМакет("ТТН");
	НомерПП = 1;
	ТабДок = Новый ТабличныйДокумент;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	Запчасти  = Макет.ПолучитьОбласть("Запчасти");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Защита = Ложь;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	
	Организация = ТекОбъект.Организация;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонРабочий)
	|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
	|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))";
	
	Запрос.УстановитьПараметр("Объект", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	АдресОрганизации = "";
	ТелефонОрганизации = "";
	Пока Выборка.Следующий() цикл
		Если Выборка.Тип = перечисления.ТипыКонтактнойИнформации.Телефон тогда
			ТелефонОрганизации = Выборка.Представление;
		Иначе
			АдресОрганизации = Выборка.Представление;
		КонецЕсли;
	КонецЦикла;
	
	ОбластьШапка.Параметры.НомерПеремещения = Объект.Номер;
	//Краткое наименование организации, Основной адрес, Телефон, ИНН, КПП, ОГРН,  Расчетный счет, Наименование банка, Кор.счет банка , БИК банка, ОКВЭД организации, ОКПО.	
	ГосНомер = "";
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АвтомобилиСрезПоследних.Значение
	|ИЗ
	|	РегистрСведений.Автомобили.СрезПоследних(
	|			,
	|			Автомобиль = &Автомобиль
	|				И ВидЗначения = &ВидЗначения) КАК АвтомобилиСрезПоследних";
	Запрос.УстановитьПараметр("Автомобиль", ТекОбъект.Автомобиль);
	Запрос.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.ГосНомер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ГосНомер = Выборка.Значение;
	КонецЕсли;
	ОбластьШапка.Параметры.Эвакуатор = ?(ЗначениеЗаполнено(ТекОбъект.Автомобиль), "" + ТекОбъект.Автомобиль.Модель + "" + ГосНомер, ""); 
	
	Банк                             = ?(ЗначениеЗаполнено(Организация.ОсновнойБанковскийСчет), Организация.ОсновнойБанковскийСчет.Банк, Справочники.Банки.ПустаяСсылка());
	БанкПолучателя                   = ?(Банк <>Справочники.Банки.ПустаяСсылка(), Банк.Наименование, "");
	РасчСчет                         = ?(ЗначениеЗаполнено(Организация.ОсновнойБанковскийСчет), "р/с" + Организация.ОсновнойБанковскийСчет.НомерСчета, Справочники.БанковскиеСчета.ПустаяСсылка());
	КоррСчет                         = ?(Банк <>Справочники.Банки.ПустаяСсылка(), Банк.КоррСчет, "");
	БИК                              = ?(Организация.ОсновнойБанковскийСчет <> Справочники.БанковскиеСчета.ПустаяСсылка(), Организация.ОсновнойБанковскийСчет.Банк.Код, "");
	
	Если Объект.Маршрут.СкладПолучатель.Renault_СкладХраненияАМ Тогда
		
		ОрганизацияПолучателя = Объект.Маршрут.СкладПолучатель.Организация;
		
		Запрос	= Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект,
		|	КонтактнаяИнформация.Тип,
		|	КонтактнаяИнформация.Вид,
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Телефон)
		|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.ТелефонКонтактный)
		|			ИЛИ КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(перечисление.ТипыКонтактнойИнформации.Адрес)
		|				И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(справочник.ВидыКонтактнойИнформации.АдресЮридический))";
		
		Запрос.УстановитьПараметр("Объект", ОрганизацияПолучателя);
		Выборка = Запрос.Выполнить().Выбрать();
		АдресОрганизацииПолучателя = "";
		ТелефонОрганизацииПолучателя = "";
		Пока Выборка.Следующий() цикл
			Если Выборка.Тип = перечисления.ТипыКонтактнойИнформации.Телефон тогда
				ТелефонОрганизацииПолучателя = Выборка.Представление;
			Иначе
				АдресОрганизацииПолучателя = Выборка.Представление;
			КонецЕсли;
		КонецЦикла;
		
		БанкОрганизацииПолучателя            = ?(ЗначениеЗаполнено(ОрганизацияПолучателя.ОсновнойБанковскийСчет), ОрганизацияПолучателя.ОсновнойБанковскийСчет.Банк, Справочники.Банки.ПустаяСсылка());
		БанкПолучателяОрганизацииПолучателя  = ?(Банк <> Справочники.Банки.ПустаяСсылка(), Банк.Наименование, "");
		РасчСчетОрганизацииПолучателя        = ?(ЗначениеЗаполнено(ОрганизацияПолучателя.ОсновнойБанковскийСчет), ОрганизацияПолучателя.ОсновнойБанковскийСчет.НомерСчета, Справочники.БанковскиеСчета.ПустаяСсылка());
		КоррСчетОрганизацииПолучателя        = ?(Банк <> Справочники.Банки.ПустаяСсылка(), Банк.КоррСчет, "");
		БИКОрганизацииПолучателя             = ?(ОрганизацияПолучателя.ОсновнойБанковскийСчет <> Справочники.БанковскиеСчета.ПустаяСсылка(), ОрганизацияПолучателя.ОсновнойБанковскийСчет.Банк.Код, "");
		
		
		Если ЗначениеЗаполнено(ОрганизацияПолучателя) Тогда 
			ОбластьШапка.Параметры.ИнфаПолучатель   = ?(ЗначениеЗаполнено(ОрганизацияПолучателя.НаименованиеПолное), ОрганизацияПолучателя.НаименованиеПолное + " ", " ")
													+ АдресОрганизацииПолучателя + ", "
													+ ТелефонОрганизацииПолучателя + ", "
													+ ?(ЗначениеЗаполнено(ОрганизацияПолучателя.ИНН), "ИНН " + ОрганизацияПолучателя.ИНН + " ", "")
													+ ?(ЗначениеЗаполнено(ОрганизацияПолучателя.КПП), ",КПП " + ОрганизацияПолучателя.КПП + " ", "")
													+ ?(ЗначениеЗаполнено(ОрганизацияПолучателя.ОГРН), ",ОГРН " + ОрганизацияПолучателя.ОГРН + " ", "")
													+ ""+?(РасчСчетОрганизацииПолучателя <> ""," р\с " + РасчСчетОрганизацииПолучателя,"")
													+ ""+?(БанкПолучателяОрганизацииПолучателя <> ""," "+БанкПолучателяОрганизацииПолучателя,"")
													+ ""+?(КоррСчетОрганизацииПолучателя <> ""," к\с "+КоррСчетОрганизацииПолучателя,"")
													+ ""+?(БИКОрганизацииПолучателя <> ""," БИК "+БИКОрганизацииПолучателя,"")
													+ ""+?(ЗначениеЗаполнено(ОрганизацияПолучателя.КодПООКПО), " Код ОКПО " + ОрганизацияПолучателя.КодПООКПО + " ", "");
		Иначе
			Сообщить("В складе-получателе не указана Организация");
		КонецЕсли;
		
	Иначе
		ОбластьШапка.Параметры.ИнфаПолучатель        = ?(ЗначениеЗаполнено(Организация.Наименование), Организация.Наименование + " ", " ")
													 + АдресОрганизации
													 + ТелефонОрганизации
													 +  ?(ЗначениеЗаполнено(Организация.ИНН), "ИНН " + Организация.ИНН + " ", "")
													 + ?(ЗначениеЗаполнено(Организация.КПП), ",КПП " + Организация.КПП + " ", "")
													 + ?(ЗначениеЗаполнено(Организация.ОГРН), ",ОГРН " + Организация.ОГРН + " ", "")
													 + ""+?(РасчСчет <> ""," р\с "+РасчСчет,"")
													 + ""+?(БанкПолучателя <> ""," "+БанкПолучателя,"")
													 + ""+?(Коррсчет <> ""," к\с "+КоррСчет,"")
													 + ""+?(БИК <> ""," БИК "+БИК,"")
													 + ""+?(ЗначениеЗаполнено(Организация.КодПООКПО), " Код ОКПО " + Организация.КодПООКПО + " ", "");
	КонецЕсли;
	
	ОбластьШапка.Параметры.ИнфаОтправитель = ?(ЗначениеЗаполнено(Организация.ИНН), "ИНН " + Организация.ИНН + " ", "")
											+ ?(ЗначениеЗаполнено(Организация.КПП), ",КПП " + Организация.КПП + " ", "")
											+ ?(ЗначениеЗаполнено(Организация.НаименованиеПолное), Организация.НаименованиеПолное + " ", Организация.Наименование + " ")
											+ ?(ЗначениеЗаполнено(АдресОрганизации),АдресОрганизации + " ", "");	
	
	ОбластьШапка.Параметры.Перевозчик = Объект.Перевозчик.НаименованиеПолное;
	
	Если Объект.Маршрут.СкладПолучатель.Renault_СкладХраненияАМ Тогда
		ОбластьШапка.Параметры.Договор = "Договор:";
		ПредставлениеДоговора = Объект.Маршрут.СкладПолучатель.ПредставлениеДляТТН;
		Если ЗначениеЗаполнено(ПредставлениеДоговора) Тогда 
			ОбластьШапка.Параметры.НаименованиеДоговора = ПредставлениеДоговора;
		Иначе
			Сообщить("В складе-получателе не указано представление для ТТН");
		КонецЕсли;
	КонецЕсли;
	
	Водитель = Объект.Водитель;
	Если ЗначениеЗаполнено(Водитель) Тогда
		ОбластьШапка.Параметры.Водитель = ?(ЗначениеЗаполнено(Водитель),Водитель,"");
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия,
		|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер
		|ИЗ
		|	РегистрСведений.ПаспортныеДанныеФизЛиц.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ПаспортныеДанныеФизЛицСрезПоследних";
		Запрос.УстановитьПараметр("ФизЛицо", Водитель);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОбластьШапка.Параметры.НомерПаспорта = "" + Выборка.ДокументСерия + " №" + Выборка.ДокументНомер;
		КонецЕсли;
	КонецЕсли;
	
	ОбластьШапка.Параметры.Дата = Объект.Дата;
	ОбластьШапка.Параметры.ПунктПогрузки = Объект.Маршрут.СкладОтправитель.Renault_Территория.Адрес;
	ОбластьШапка.Параметры.ПунктРазгрузки = Объект.Маршрут.СкладПолучатель.Renault_Территория.Адрес;
	
	ТабДок.Вывести(ОбластьШапка);
	
	Для Каждого Строка Из Объект.Автомобили Цикл
		
		ТекАвто = Строка.Автомобиль;
		ОбластьСтрока.Параметры.НомерПП = НомерПП;
		ОбластьСтрока.Параметры.Наименование = "" + ТекАвто.Модель.Производитель + " " + ТекАвто.Модель;
		ОбластьСтрока.Параметры.ВнутреннийНомер = Строка.Место;
		ОбластьСтрока.Параметры.ВИН = ТекАвто.Код;
		
		НомерПП = НомерПП + 1;
		ТабДок.Вывести(ОбластьСтрока);
	
	КонецЦикла;
	
	ТабДок.Вывести(Запчасти);
	ТабДок.Вывести(ОбластьПодвал);
	
	Возврат ТабДок;
	
КонецФункции

&НаСервере
Функция ПечатьАктаПриемаПередачи(ДополнительныеПараметры, ДоверенноеЛицо = Неопределено, Шаблон = Неопределено)
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ТекОбъект.ПолучитьМакет("АктПриемаПередачи");
	ТабДок = Новый ТабличныйДокумент;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.Защита = Ложь;
	ТабДок.ТолькоПросмотр = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	
	Покупатель   = Объект.Маршрут.СкладПолучатель.Организация;
	сОрганизация = ПолучитьСтруктуру(Объект.Организация);
	сПокупатель  = ПолучитьДанныеЮрЛица(Покупатель);
	
	Местоположение = Константы.Месторасположение.Получить();
	
	Муж = Перечисления.ПолФизическихЛиц.Мужской;
	
	Если ДоверенноеЛицо[0].Значение.Пол = Неопределено Тогда
		Сообщить("Данные пола лица для заключения договора не указаны! Не все данные будут заполнены!", СтатусСообщения.Важное);
	Иначе
		Если ДоверенноеЛицо[0].Значение.Пол = Муж Тогда 
			Действие = ", действующего на основании ";
		Иначе
			Действие = ", действующей на основании ";
		КонецЕсли;
	КонецЕсли;
	
	Если ДоверенноеЛицо[1].Значение = Перечисления.Бит_ОтветственныеДляШаблонов.ГенеральныйДиректор Тогда
		Ответственный = "в лице Генерального директора " + ДоверенноеЛицо[0].Значение.ФИОвРодительномПадеже + Действие + "Устава";
	ИначеЕсли ДоверенноеЛицо[1].Значение = Перечисления.Бит_ОтветственныеДляШаблонов.МенеджерКорпоративногоОтдела Тогда
		ДанныеДоверенности = Renault_ОбщегоНазначения.ПолучитьДанныеДоверенности(ДоверенноеЛицо[0].Значение, Объект.ДатаОперации, Объект.Организация);
		Ответственный = "в лице менеджера корпоративного отдела " + ДоверенноеЛицо[0].Значение.ФИОвРодительномПадеже + Действие + "доверенности № " + ДанныеДоверенности.ДоверенностьНомер + " от " + Формат(ДанныеДоверенности.ДоверенностьДата,"ДФ=dd.MM.yyyy") + " г.";
	ИначеЕсли ДоверенноеЛицо[1].Значение = Перечисления.Бит_ОтветственныеДляШаблонов.РуководительКорпоративногоОтдела Тогда
		ДанныеДоверенности = Renault_ОбщегоНазначения.ПолучитьДанныеДоверенности(ДоверенноеЛицо[0].Значение, Объект.ДатаОперации, Объект.Организация);
		Ответственный = "в лице руководителя корпоративного отдела " + ДоверенноеЛицо[0].Значение.ФИОвРодительномПадеже + Действие + "доверенности № " + ДанныеДоверенности.ДоверенностьНомер + " от " + Формат(ДанныеДоверенности.ДоверенностьДата,"ДФ=dd.MM.yyyy") + " г.";
	КонецЕсли;
	
	Если Не Шаблон = Неопределено Тогда
		
		Если Не Шаблон.Должность = Справочники.Бит_ДолжностиДоверенныхЛиц.ГлаваПредставительства Тогда
			ПредставлениеПокупателя = сПокупатель.НаименованиеПолное + ", " + Шаблон.Должность.Представление;
		Иначе
			ПредставлениеПокупателя = "Представительство компании " + сПокупатель.НаименованиеПолное + ", в лице " + Шаблон.Должность.ДолжностьДляПечати;
		КонецЕсли;
		Если Шаблон.НаОсновании.Ссылка = Справочники.Бит_ОснованиеДоверенныхЛиц.Доверенность Тогда
			Если ДополнительныеПараметры.ПолДоверенногоЛица = Муж Тогда
				ПредставлениеДоверенногоЛицаПокупателя 		= "" + ДополнительныеПараметры.ФИОВРодПадеже + ", действующего " + Шаблон.НаОсновании.Представление + " № " + ДополнительныеПараметры.Доверенность.НомерДоверенности + " от " + Формат(ДополнительныеПараметры.Доверенность.ДатаВыдачи, "ДФ=dd.MM.yyyy"); 
			Иначе ПредставлениеДоверенногоЛицаПокупателя 	= "" + ДополнительныеПараметры.ФИОВРодПадеже + ", действующей " + Шаблон.НаОсновании.Представление + " № " + ДополнительныеПараметры.Доверенность.НомерДоверенности + " от " + Формат(ДополнительныеПараметры.Доверенность.ДатаВыдачи, "ДФ=dd.MM.yyyy"); 
			КонецЕсли;
		Иначе
			Если ДополнительныеПараметры.ПолДоверенногоЛица = Муж Тогда
				ПредставлениеДоверенногоЛицаПокупателя 		= ДополнительныеПараметры.ФИОВРодПадеже + ", действующего " + Шаблон.НаОсновании.Представление; 
			Иначе ПредставлениеДоверенногоЛицаПокупателя 	= ДополнительныеПараметры.ФИОВРодПадеже + ", действующей " + Шаблон.НаОсновании.Представление; 
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ПредставлениеПокупателя = сПокупатель.НаименованиеПолное + ", в лице ";
		Если ДополнительныеПараметры.ПолДоверенногоЛица = Муж Тогда
			ПредставлениеДоверенногоЛицаПокупателя 		= "" + ДополнительныеПараметры.ФИОВРодПадеже + ", действующего на основании Доверенности № " + ДополнительныеПараметры.Доверенность.НомерДоверенности + " от " + Формат(ДополнительныеПараметры.Доверенность.ДатаВыдачи, "ДФ=dd.MM.yyyy"); 
		Иначе ПредставлениеДоверенногоЛицаПокупателя 	= "" + ДополнительныеПараметры.ФИОВРодПадеже + ", действующей на основании Доверенности № " + ДополнительныеПараметры.Доверенность.НомерДоверенности + " от " + Формат(ДополнительныеПараметры.Доверенность.ДатаВыдачи, "ДФ=dd.MM.yyyy"); 
		КонецЕсли;
		
	КонецЕсли;
	
	ОтПокупателя  = Renault_ОбщегоНазначения.ФамилияИнициалыФизЛица(ДополнительныеПараметры.ДоверенноеЛицо.Наименование);
	ОтОрганизации = Renault_ОбщегоНазначения.ФамилияИнициалыФизЛица(ДоверенноеЛицо[0].Значение);
	
	ОбластьШапка.Параметры.ОрганизацияНаименованиеПолное  = сОрганизация.НаименованиеПолное;
	ОбластьШапка.Параметры.ОрганизацияЮридическийАдрес    = сОрганизация.АдресОсновной;
	ОбластьШапка.Параметры.ОрганизацияИНН                 = сОрганизация.ИНН;
	ОбластьШапка.Параметры.Местоположение                 = Местоположение;
	ОбластьШапка.Параметры.Дата                           = Формат(Объект.ДатаОперации, "ДФ='«дд» ММММ гггг ""г.""'");
	ОбластьШапка.Параметры.ОрганизацияНаименованиеКраткое = сОрганизация.НаименованиеКраткое;
	ОбластьШапка.Параметры.ОрганизацияДоверенноеЛицо	  = Ответственный;
	ОбластьШапка.Параметры.ПокупательПредставление		  = ПредставлениеПокупателя;
	ОбластьШапка.Параметры.ПокупательДоверенноеЛицо       = ПредставлениеДоверенногоЛицаПокупателя;
	ОбластьШапка.Параметры.ПредставлениеДоговора          = ?(ЗначениеЗаполнено(Объект.Маршрут.СкладПолучатель.ПредставлениеДляАкта), Объект.Маршрут.СкладПолучатель.ПредставлениеДляАкта, "");
	
	ТабДок.Вывести(ОбластьШапка);
	
	//получим закупочную стоимость автомобиля
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТабЧастьАвтомобили.Автомобиль
	|ПОМЕСТИТЬ ВТ_ТабЧасть
	|ИЗ
	|	Документ.ПеремещениеАвтомобилей.Автомобили КАК ТабЧастьАвтомобили
	|ГДЕ
	|	ТабЧастьАвтомобили.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьАвтомобиляОстатки.СуммаОстаток КАК Стоимость,
	|	СтоимостьАвтомобиляОстатки.Автомобиль
	|ПОМЕСТИТЬ ВТ_Стоимость
	|ИЗ
	|	РегистрНакопления.СтоимостьАвтомобиля.Остатки(
	|			&Период,
	|			Автомобиль В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Табл.Автомобиль
	|					ИЗ
	|						ВТ_ТабЧасть КАК Табл)
	|				И ВидЦены = ЗНАЧЕНИЕ(Перечисление.ВидыЦен.Закупочная)) КАК СтоимостьАвтомобиляОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТабЧасть.Автомобиль,
	|	ЕСТЬNULL(ВТ_Стоимость.Стоимость, 0) КАК Стоимость
	|ИЗ
	|	ВТ_ТабЧасть КАК ВТ_ТабЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Стоимость КАК ВТ_Стоимость
	|		ПО ВТ_ТабЧасть.Автомобиль = ВТ_Стоимость.Автомобиль";
	
	Запрос.УстановитьПараметр("Период", Объект.ДатаОперации);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Объект.Автомобили Цикл
		
		ТекАвто = Строка.Автомобиль;
		ОбластьСтрока.Параметры.Модель = ТекАвто.Модель.Наименование;
		ОбластьСтрока.Параметры.Версия = ТекАвто.Версия.Наименование + ", " + ТекАвто.Версия.Код;
		ОбластьСтрока.Параметры.Цвет   = ТекАвто.ЦветКузова.Наименование;
		ОбластьСтрока.Параметры.VIN    = ТекАвто.Код; 
		СтоимостьАвто = ТаблицаЦен.НайтиСтроки(Новый Структура("Автомобиль",ТекАвто))[0].Стоимость; 
		ОбластьСтрока.Параметры.Цена   = "" + ?(СтоимостьАвто <> 0, СтоимостьАвто, "0")  + " руб."; 
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ПокупательРеквизиты = 
						"" + сПокупатель.АдресОсновной + "
						|Тел: " + сПокупатель.ТелефонОсновной + "
						|ИНН: " + сПокупатель.ИНН + " КПП: " + сПокупатель.КПП + "
						|ОГРН: " + сПокупатель.ОГРН + "
						|р/с " + сПокупатель.НомерСчета + " в
						|" + сПокупатель.БанкНаименование + "
						|к/с " + сПокупатель.БанкКоррСчет + ", БИК " + сПокупатель.БанкБИК + "
						|ОКВЭД: " + сПокупатель.ОКВЭД + " ОКПО: " + сПокупатель.ОКПО;
	
	ОрганизацияРеквизиты = 
						"" + сОрганизация.АдресОсновной + "
						|Тел: " + сОрганизация.ТелефонОсновной + "
						|ИНН: " + сОрганизация.ИНН + " КПП: " + сОрганизация.КПП + "
						|ОГРН: " + сОрганизация.ОГРН + "
						|р/с " + сОрганизация.НомерСчета + " в
						|" + сОрганизация.БанкНаименование + "
						|к/с " + сОрганизация.БанкКоррСчет + ", БИК " + сОрганизация.БанкБИК + "
						|ОКВЭД: " + сОрганизация.ОКВЭД + " ОКПО: " + сОрганизация.ОКПО;
	
	ОбластьПодвал.Параметры.Организация			 	  = сОрганизация.НаименованиеКраткое;
	ОбластьПодвал.Параметры.Покупатель           	  = сПокупатель.НаименованиеПолное;
	ОбластьПодвал.Параметры.ПокупательРеквизиты  	  = ПокупательРеквизиты;
	ОбластьПодвал.Параметры.ОрганизацияРеквизиты 	  = ОрганизацияРеквизиты;
	ОбластьПодвал.Параметры.ОрганизацияДоверенноеЛицо = ОтОрганизации;
	ОбластьПодвал.Параметры.ПокупательДоверенноеЛицо  = ОтПокупателя;
	
	ТабДок.Вывести(ОбластьПодвал);
	
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьСтруктуру(Контрагент)
	
	Возврат ?(Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо, Renault_ОбщегоНазначения.ПолучитьДанныеФизЛица(Контрагент), Renault_ОбщегоНазначения.ПолучитьДанныеЮрЛица(Контрагент));
	
КонецФункции

&НаКлиенте
Процедура АвтомобильНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	Результат = ПолучитьЭвакуаторы();
	Элемент.СписокВыбора.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Автомобиль"));
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЭвакуаторы()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Renault_СобственныеАвтомобили.Автомобиль
	|ИЗ
	|	РегистрСведений.Renault_СобственныеАвтомобили КАК Renault_СобственныеАвтомобили";
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВодительНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	Результат = ПолучитьВодителей();
	Элемент.СписокВыбора.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Водитель"));
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВодителей()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
