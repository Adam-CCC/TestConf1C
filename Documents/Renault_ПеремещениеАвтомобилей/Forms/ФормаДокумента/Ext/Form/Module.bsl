&НаКлиенте
Процедура КомандаПечатьАктаПриемаПередачи(Команда)
	
	Если Не Объект.Проведен Тогда
		Сообщить("Для печати Акта приема-передачи необходимо провести документ!");
		Возврат;
	КонецЕсли;
	
	ДокЛицо = ПолучитьДоверенноеЛицоОрганизации(Объект.Организация); 
	
	Если ДокЛицо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Док = Неопределено;
	
	ПередатьВладельца = Новый Структура;
	ЗакрыватьПриВыборе = Истина;
	
	ПараметрыОтбора = Новый Структура;
	
	ПередатьВладельца.Вставить("Контрагент", Объект.Маршрут.СкладПолучатель.Организация);
		
	ПередатьВладельца.Вставить("ЗакрыватьПриВыборе", Истина);
	ПередатьВладельца.Вставить("Отбор", ПараметрыОтбора);
	
	Док = ОткрытьФормуМодально("РегистрСведений.пацДоверенныеЛицаКонтрагентов.Форма.ФормаСпискаДляВыбора", ПередатьВладельца, ЭтаФорма);
	Если Док = Неопределено Тогда Возврат; КонецЕсли;
	
	ПредПокупатель = ВыяснитьНужныйШаблон(Док);
	
	Если Не ПредПокупатель = Истина Тогда	
		ПредПокупателя = ПредПокупатель.ШаблоныДляПечати.Ссылка;
	Иначе
		ПредПокупателя = Неопределено
	КонецЕсли;
	
	ТабДок = ПечатьАктаПриемаПередачи(Док, ДокЛицо, ПредПокупателя);
	ТабДок.Показать();
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДоверенноеЛицоОрганизации(Орг)
	
	Место = Константы.Месторасположение.Получить();
	
	Запрос = Новый Запрос;
	
	Если Место = Перечисления.МестаРасположения.Москва Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Бит_ОтветственныеДляШаблонов.ФизическоеЛицо,
		|	Бит_ОтветственныеДляШаблонов.ОтветственноеЛицо КАК Должность
		|ИЗ
		|	РегистрСведений.Бит_ОтветственныеДляШаблонов КАК Бит_ОтветственныеДляШаблонов
		|ГДЕ
		|	НЕ Бит_ОтветственныеДляШаблонов.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.Бит_ОтветственныеДляШаблонов.РуководительКорпоративногоОтдела)
		|	И Бит_ОтветственныеДляШаблонов.СтруктурнаяЕдиница = &Организация";
		
	Иначе 
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Бит_ОтветственныеДляШаблонов.ФизическоеЛицо,
		|	Бит_ОтветственныеДляШаблонов.ОтветственноеЛицо КАК Должность
		|ИЗ
		|	РегистрСведений.Бит_ОтветственныеДляШаблонов КАК Бит_ОтветственныеДляШаблонов
		|ГДЕ
		|	Бит_ОтветственныеДляШаблонов.СтруктурнаяЕдиница = &Организация";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Орг);
	Список = Запрос.Выполнить().Выгрузить();
	
	ВыбранноеДоверенноеЛицо = Список.ВыбратьСтроку("Выберите доверенное лицо от вашей организации:");
	
	Если ВыбранноеДоверенноеЛицо = Неопределено Тогда
		
		Сообщить("Не выбрали доверенное лицо от организации");
		
	Иначе Лицо = Новый СписокЗначений;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Объект,
		|	КонтактнаяИнформация.Вид КАК Вид,
		|	КонтактнаяИнформация.Поле2,
		|	КонтактнаяИнформация.Поле3
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Вид = &Вид
		|	И КонтактнаяИнформация.Объект = &Объект";
		Запрос.УстановитьПараметр("Объект",ВыбранноеДоверенноеЛицо.ФизическоеЛицо);
		Запрос.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.Доверенность);
		Доверка = Запрос.Выполнить().Выгрузить();
		
		Лицо.Добавить(ВыбранноеДоверенноеЛицо.ФизическоеЛицо);
		Лицо.Добавить(ВыбранноеДоверенноеЛицо.Должность);
		
		Если Не Доверка.Количество() = 0 Тогда
			Лицо.Добавить(Доверка[0].Поле2, "Номер");
			Лицо.Добавить(Доверка[0].Поле3, "Дата");
		Иначе Лицо.Добавить(0000000000000000000000000000000, "Номер");
			Лицо.Добавить(ТекущаяДата(), "Дата");
		КонецЕсли;
		
		Возврат Лицо;
		
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ВыяснитьНужныйШаблон(Шаблоны)

	ЗначенияДляЗаполненияИзШаблонов = Новый ТаблицаЗначений;
	ЗначенияДляЗаполненияИзШаблонов.Колонки.Добавить("ШаблоныДляПечати");
	
	Для Каждого Строки из Шаблоны.ДоступныеШаблоны.ДоступныеШаблоны Цикл
		СтрокаТаблицы = ЗначенияДляЗаполненияИзШаблонов.Добавить(); 
		СтрокаТаблицы.ШаблоныДляПечати = Строки.ДоступныйШаблон.Ссылка;
	КонецЦикла;
	
	Если Не ЗначенияДляЗаполненияИзШаблонов.Количество() = 0 Тогда
		ПредПокупателя = ЗначенияДляЗаполненияИзШаблонов.ВыбратьСтроку("В какой должности находится доверенное лицо покупателя:");
		Возврат ПредПокупателя;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеЮрЛица(Контрагент)
	
	Результат = Новый Структура;
	
	Результат.Вставить("НаименованиеПолное"     , "");
	Результат.Вставить("НаименованиеКраткое"    , "");
	Результат.Вставить("ИНН"                    , "");
	Результат.Вставить("КПП"                    , "");
	Результат.Вставить("ОКВЭД"                  , "");
	Результат.Вставить("ОКПО"                   , "");
	Результат.Вставить("ОГРН"                   , "");
	Результат.Вставить("АдресОсновной"          , "");
	Результат.Вставить("ТелефонОсновной"        , "");
	Результат.Вставить("НомерСчета"             , "");
	Результат.Вставить("БанкНаименование"       , "");
	Результат.Вставить("БанкБИК"                , "");
	Результат.Вставить("БанкКоррСчет"           , "");
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Результат;
	КонецЕсли;
	
	//Исправить
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП,
	|	Контрагенты.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк КАК БанкНаименование,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.Код КАК БанкБИК,
	|	Контрагенты.ОсновнойБанковскийСчет.Банк.КоррСчет КАК БанкКоррСчет,
	|	Контрагенты.КодПоОКПО КАК ОКПО,
	|	Контрагенты.Наименование КАК НаименованиеКраткое,
	|	Контрагенты.Ссылка,
	|	Контрагенты.ОГРН,
	|	Контрагенты.ОКВЭД
	|ПОМЕСТИТЬ ВТОсновныеДанные
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Представление КАК Адрес
	|ПОМЕСТИТЬ ВТАдрес
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контрагент
	|	И КонтактнаяИнформация.Вид = &ВидАдрес
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Представление КАК Телефон
	|ПОМЕСТИТЬ ВТТелефон
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контрагент
	|	И КонтактнаяИнформация.Вид = &ВидТелефон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОсновныеДанные.НаименованиеПолное,
	|	ВТОсновныеДанные.ИНН,
	|	ВТОсновныеДанные.КПП,
	|	ВТОсновныеДанные.НомерСчета,
	|	ВТОсновныеДанные.БанкНаименование,
	|	ВТОсновныеДанные.БанкБИК,
	|	ВТОсновныеДанные.БанкКоррСчет,
	|	ВТОсновныеДанные.ОКПО,
	|	ВТОсновныеДанные.ОГРН,
	|	ВТОсновныеДанные.ОКВЭД,
	|	ВТОсновныеДанные.НаименованиеКраткое,
	|	ЕСТЬNULL(ВТТелефон.Телефон, """") КАК ТелефонОсновной,
	|	ЕСТЬNULL(ВТАдрес.Адрес, 0) КАК АдресОсновной
	|ИЗ
	|	ВТОсновныеДанные КАК ВТОсновныеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТАдрес КАК ВТАдрес
	|		ПО ВТОсновныеДанные.Ссылка = ВТАдрес.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТТелефон КАК ВТТелефон
	|		ПО ВТОсновныеДанные.Ссылка = ВТТелефон.Объект";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ВидАдрес", Справочники.ВидыКонтактнойИнформации.АдресЮридический);
	Запрос.УстановитьПараметр("ВидТелефон", Справочники.ВидыКонтактнойИнформации.ТелефонКонтактный);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

