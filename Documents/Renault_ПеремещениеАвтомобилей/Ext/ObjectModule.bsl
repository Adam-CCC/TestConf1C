
Перем ОбщийЗапрос;

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если Статус = Ссылка.Статус Тогда
			Отказ = Renault_ОбщегоНазначенияКлиентСервер.ПроверитьДатуОперации(ЭтотОбъект);
		КонецЕсли;
		
		Если Маршрут.СкладОтправитель.Renault_Территория = Маршрут.СкладПолучатель.Renault_Территория Тогда
			Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
		Принял = ПараметрыСеанса.Пользователь;
	ИначеЕсли Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.ВПути Тогда
		Если Маршрут.СкладОтправитель.Renault_Территория = Маршрут.СкладПолучатель.Renault_Территория Тогда
			Принял = ПараметрыСеанса.Пользователь;
		КонецЕсли;
	КонецЕсли;
	
	// Расскомментить +++ Никитин
	//Если Renault_ОбщегоНазначения.ПолучитьДоступныеВидыОперцийДокумента(ЭтотОбъект, ПараметрыСеанса.ТекущийПользователь).Найти(ВидОперации,"ВидОперации") = Неопределено Тогда
	//	Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет прав на работу с документом «" + ЭтотОбъект.Метаданные().Синоним + "».");
	//	Отказ = Истина;
	//	Возврат;
	//КонецЕсли;
	
	//Если НЕ ДанныеДокументКорректны() Тогда
	//	Отказ = Истина;
	//КонецЕсли;
	// Расскомментить --- Никитин
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.ВПути 
		ИЛИ (Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто И Маршрут.СкладОтправитель.Renault_Территория = Маршрут.СкладПолучатель.Renault_Территория)Тогда
		Если НЕ ДанныеСистемыКорректны() Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СкладЭвакуатор = Константы.Renault_СкладЭвакуатор.Получить();
	
	Если НЕ Отказ Тогда
		
		Если Маршрут.СкладОтправитель.Renault_Территория = Маршрут.СкладПолучатель.Renault_Территория Тогда
			
			ПолучитьТаблицуОстаткиАвтомобилей("ОстаткиАвтомобилей");
			
			Движения.ОстаткиАвтомобилей.Прочитать();
			Движения.ОстаткиАвтомобилей.Загрузить(ДополнительныеСвойства.ОстаткиАвтомобилей);
			Движения.ОстаткиАвтомобилей.Записать();
			
			Если Маршрут.СкладПолучатель.ШоуРум Или Маршрут.СкладПолучатель.СкладРеализацииАвтомобилей Тогда
				Если НЕ РегистрыСведений.Renault_МестаАвтомобилей.ОсвободитьПарковочноеМесто(Автомобили.ВыгрузитьКолонку("Автомобиль")) Тогда
					Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось очистить парковочные места автомобилей. Документ:" + Ссылка, Неопределено, "", Отказ);
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			Если Маршрут.СкладОтправитель.ШоуРум Или Маршрут.СкладОтправитель.СкладРеализацииАвтомобилей Тогда
				ЗанятьМестаАвтомобилей();
			КонецЕсли;
			Если Маршрут.СкладПолучатель.СкладРеализацииАвтомобилей ИЛИ Маршрут.СкладОтправитель.СкладРеализацииАвтомобилей Тогда
				//ЗаписатьОтметкиВЖурналВыдачи();
			КонецЕсли;
		Иначе
			
			Если СкладЭвакуатор.Пустая() Тогда
				Сообщить("Склад-эвакуатор не выбран!", СтатусСообщения.Важное);
				Отказ = Истина;
			КонецЕсли;
			
			Если Не Отказ Тогда
				
				Если Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.ВПути Тогда
					
					Движения.ОстаткиАвтомобилей.Очистить();
					Движения.ОстаткиАвтомобилей.Записать();
					
					ПолучитьТаблицуОстаткиАвтомобилейСписание("ОстаткиАвтомобилей", СкладЭвакуатор);
					
					Движения.ОстаткиАвтомобилей.Прочитать();
					Движения.ОстаткиАвтомобилей.Загрузить(ДополнительныеСвойства.ОстаткиАвтомобилей);
					Движения.ОстаткиАвтомобилей.Записать();
					
					Если НЕ РегистрыСведений.Renault_МестаАвтомобилей.ОсвободитьПарковочноеМесто(Автомобили.ВыгрузитьКолонку("Автомобиль")) Тогда
						Renault_ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось очистить парковочные места автомобилей. Документ:" + Ссылка, Неопределено, "", Отказ);
						Возврат;
					КонецЕсли;
					
				ИначеЕсли Статус = Перечисления.Renault_СтатусыЗаявкиНаПеремещение.Закрыто Тогда
					
					ПолучитьТаблицуОстаткиАвтомобилейПоступление("ОстаткиАвтомобилей", СкладЭвакуатор);
					
					Движения.ОстаткиАвтомобилей.Прочитать();
					
					Для Каждого Строка Из ДополнительныеСвойства.ОстаткиАвтомобилей Цикл
						НоваяСтрока = Движения.ОстаткиАвтомобилей.Добавить();
						НоваяСтрока.Автомобиль = Строка.Автомобиль;
						НоваяСтрока.ВидДвижения = Строка.ВидДвижения;
						//НоваяСтрока.ДатаПоступления = Строка.ДатаПоступления;
						НоваяСтрока.Партия = Строка.Партия;
						НоваяСтрока.Количество = Строка.Количество;
						//НоваяСтрока.Организация = Строка.Организация;
						НоваяСтрока.Период = ТекущаяДата();
						НоваяСтрока.СкладКомпании = Строка.СкладКомпании;
						НоваяСтрока.СтатусПартии = Строка.СтатусПартии;
						//НоваяСтрока.ТипАвтомобиля = Строка.ТипАвтомобиля;
					КонецЦикла;	
					
					Движения.ОстаткиАвтомобилей.Записать();
					
					ЗанятьМестаАвтомобилей();
					ЗаписатьНачисленияВодителям();
					//ЗаписатьОтметкиВПланПеремещений();
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

