
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Список") Тогда СпЗн=Параметры.Список КонецЕсли;
	Если Параметры.Свойство("МножественныйВыбор") Тогда МножественныйВыбор=Параметры.МножественныйВыбор КонецЕсли;
	Если Параметры.Свойство("Заголовок") Тогда Элементы.Заголовок.Заголовок=Параметры.Заголовок КонецЕсли;
	Если Параметры.Свойство("КоличествоЭлементовВСтроке") Тогда КоличествоЭлементовВСтроке=Параметры.КоличествоЭлементовВСтроке
	Иначе
		КоличествоЭлементовВСтроке=Мин(7,Sqrt(СпЗн.Количество()/2*3));
	КонецЕсли;
	
	ШиринаЭлемента=?(Параметры.Свойство("ШиринаЭлемента"),Параметры.ШиринаЭлемента,9);
	ВысотаЭлемента=?(Параметры.Свойство("ВысотаЭлемента"),Параметры.ВысотаЭлемента,2);
	
	Если КоличествоЭлементовВСтроке=0 Тогда КоличествоЭлементовВСтроке=4 КонецЕсли;
	
	Цвет=Новый Цвет(231,231,231);
	//ЦветАктивный=Новый Цвет(255,207,0);
	//ЦветТекста=Новый Цвет(49,52,49);
	ПарамОфр=Renault_ОбщиеФункцииСервер.МультибрендПараметрыОформления();
	ЦветАктивный=Вычислить(ПарамОфр.ОсновнойЦвет);
	ЦветТекста=Вычислить(ПарамОфр.ЦветТекста);
	
	ЦветРамки=Новый Цвет(192,192,192);
	
	Элементы.кнОК.ЦветФона=ЦветАктивный;
	Элементы.кнОК.ЦветРамки=ЦветАктивный;
	Элементы.кнОК.ЦветТекста=ЦветТекста;
	Элементы.Закрыть.ЦветТекста=ЦветТекста;

	Элементы.кнОК.Ширина=ШиринаЭлемента;
	Элементы.Закрыть.Ширина=ШиринаЭлемента;
	Элементы.кнОК.Высота=ВысотаЭлемента;
	Элементы.Закрыть.Высота=ВысотаЭлемента;
	
	Если НЕ МножественныйВыбор Тогда Элементы.грКнопки.Видимость=Ложь КонецЕсли;
	
	НСтр=0;
	НКол=0;
	НЭлемента=0;
	Для Каждого Эл Из СпЗн Цикл
		Если НКол=0 или НКол>КоличествоЭлементовВСтроке-1 Тогда
			НКол=0;
			Контейнер=Элементы.Добавить("Конт"+Формат(НСтр,"ЧН=0;ЧГ=0"),Тип("ГруппаФормы"),Элементы.грЭлементы);
			Контейнер.Вид=ВидГруппыФормы.ОбычнаяГруппа;
			Контейнер.Отображение=ОтображениеОбычнойГруппы.Нет;
			Контейнер.ОтображатьЗаголовок=Ложь;
			Контейнер.Группировка=ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
			//Контейнер.ШиринаПодчиненныхЭлементов=ШиринаПодчиненныхЭлементовФормы.Одинаковая;
		КонецЕсли;
		
		ИмяКнопки="Зн"+Формат(НЭлемента,"ЧН=0;ЧГ=0");
	 	КомандаФормы=Команды.Добавить(ИмяКнопки);
	    КомандаФормы.Действие="НажатиеКнопки";
		
		Кнопка=Элементы.Добавить(ИмяКнопки,Тип("КнопкаФормы"),Контейнер);
		Кнопка.Заголовок=?(Эл.Представление="",Эл.Значение,Эл.Представление);
		Кнопка.ИмяКоманды=ИмяКнопки;
		Кнопка.ЦветТекста=ЦветТекста;
		Кнопка.Картинка=Эл.Картинка;
		Кнопка.Высота=ВысотаЭлемента;
		Кнопка.Ширина=ШиринаЭлемента;
		Кнопка.Отображение=ОтображениеКнопки.КартинкаИТекст;
		
		Если Эл.Пометка Тогда
			Кнопка.ЦветФона=ЦветАктивный;
			Кнопка.ЦветРамки=ЦветАктивный;
			Кнопка.Шрифт=Новый Шрифт(,,Истина);
		Иначе
			Кнопка.ЦветФона=Цвет;
			Кнопка.ЦветРамки=ЦветРамки;//Цвет;
		КонецЕсли;	
		
		НСтр=НСтр+1;
		НКол=НКол+1;
		НЭлемента=НЭлемента+1;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура НажатиеКнопки(Команда)
	
	//переключение активности
	ЭлементСп=СпЗн[ЭлементСпискаПоИмениКнопки(Команда.Имя)];
	Если НЕ МножественныйВыбор Тогда Закрыть(ЭлементСп.Значение) КонецЕсли; //выбор
	
	ЭлементСп.Пометка=НЕ ЭлементСп.Пометка;
	Если ЭлементСп.Пометка Тогда
		Элементы[Команда.Имя].ЦветФона=ЦветАктивный;
		Элементы[Команда.Имя].ЦветРамки=ЦветАктивный;
		Элементы[Команда.Имя].Шрифт=Новый Шрифт(,,Истина);
	Иначе
		Элементы[Команда.Имя].ЦветФона=Цвет;
		Элементы[Команда.Имя].ЦветРамки=ЦветРамки;//Цвет;
		Элементы[Команда.Имя].Шрифт=Новый Шрифт;
	КонецЕсли;	
	
	//отключение остальных кнопок
	Если Не МножественныйВыбор Тогда
		Для Каждого Контейнер Из Элементы.грЭлементы.ПодчиненныеЭлементы Цикл
			Для Каждого Кнопка Из Контейнер.ПодчиненныеЭлементы Цикл
				Если Кнопка.Имя=Команда.Имя Тогда Продолжить КонецЕсли;
				Кнопка.ЦветФона=Цвет;
				Кнопка.ЦветРамки=ЦветРамки;//Цвет;
				Кнопка.Шрифт=Новый Шрифт;
				СпЗн[ЭлементСпискаПоИмениКнопки(Кнопка.Имя)].Пометка=Ложь
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

Функция ЭлементСпискаПоИмениКнопки(Имя) Возврат Число(Сред(Имя,3)) КонецФункции	

&НаКлиенте
Процедура кнОК(Команда)
	Массив=Новый Массив;
	Для Каждого Эл Из СпЗн Цикл
		Если Эл.Пометка Тогда Массив.Добавить(Эл.Значение) КонецЕсли
	КонецЦикла;
	Закрыть(Массив)
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Массив = Новый Массив;
	Массив.Добавить(Элементы.кнОК);
	Renault_ОбщиеФункции.МультибрендЗадатьОформление(Массив, "ЦветФона", "ОсновнойЦвет");
	
КонецПроцедуры
