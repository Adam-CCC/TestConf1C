&НаКлиенте
// Процедура - обработчик команды формы "ПовторитьПодключение"
//
Процедура ПовторитьПодключение(Команда)
	Если сфпСофтФонПроСервер.сфпИспользоватьСофтФон() Тогда
		Если сфпСофтФонПроСервер.сфпПолучитьЗначениеПоУмолчаниюПользователя("ИспользоватьСофтФон") Тогда
		#Если Вебклиент Тогда
		Состояние(Нстр("ru = 'Работа СофтФона невозможна в web-клиенте!'"));
		#Иначе
		РезультатПодключения = Ложь;
		Попытка	
			сфпФормаТелефонВнешняяПанель = ПолучитьФорму("Обработка.сфпСофтФонВнешняяПанель.Форма.Форма");
			РезультатПодключения = сфпФормаТелефонВнешняяПанель.Подключиться();
		Исключение	
		КонецПопытки;
		Если РезультатПодключения Тогда
			Состояние = Нстр("ru = 'Успешно подключились к внешней панели СофтФон'");
			Закрыть();
			ОписаниеОшибки = "";
		Иначе		
			ОписаниеОшибки = Нстр("ru = 'Не удалось подключиться к внешней панели СофтФон'");
		КонецЕсли;
		#КонецЕсли
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры // ПовторитьПодключение()

&НаКлиенте
// Процедура - обработчик команды формы "УстановитьВнешнююПанель"
//
Процедура УстановитьВнешнююПанель(Команда)
	#Если Вебклиент Тогда
	Предупреждение(Нстр("ru = 'Работа СофтФона возможна только в тонком клиенте 1С'"), 60);
	#Иначе
	Попытка 
		Состояние(Нстр("ru = 'Установка внешней панели СофтФон'"));
		АдресХранилища = ВернутьХранилищеВнешнейПанели();
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
		ВременныйФайл = ПолучитьИмяВременногоФайла("exe"); 
		ДвоичныеДанные.Записать(ВременныйФайл);
		КодВозврата = Неопределено;
		ЗапуститьПриложение(ВременныйФайл, , Истина, КодВозврата);
		Если НЕ (КодВозврата = Неопределено) Тогда
			ОписаниеОшибки = "";
			ПовторитьПодключение(Неопределено);
		КонецЕсли;	
	Исключение
		ОписаниеОшибки = Нстр("ru = 'Не удалось запустить установку панели СофтФон'");
	КонецПопытки;
	#КонецЕсли
КонецПроцедуры // УстановитьВнешнююПанель()

