
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Клиент = Параметры.Клиент;
	
	Попытка
		
		Клиенты = Параметры.Клиенты;		
		
	Исключение
		
		
	КонецПопытки;
	
	ОтбиратьПоДокументу = Параметры.ОтбиратьПоДокументу;
	ДокументОтбора = Параметры.ДокументОтбора;
	//Таблица = Параметры.ВсеЗвонки;
	
	Если ОтбиратьПоДокументу Тогда
		
		Элементы.ВсеСМСИсточник.Видимость = Ложь;
		Элементы.ФормаПоказатьВсеПоКлиенту.Видимость = Истина;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Клиент) И НЕ ЗначениеЗаполнено(Клиенты) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ОтбиратьПоДокументу И Не ЗначениеЗаполнено(ДокументОтбора) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Клиенты) Тогда
		Элементы.ВсеСМСИсточник.Видимость = Истина;
		
		ТабСМС = DMS_ВзаимодействияСКлиентом.ПолучитьСМСПоКлиенту(Клиенты);
		
		Для Каждого Строка из ТабСМС Цикл
		
			НоваяСтрока = ВсеСМС.Добавить();
			НоваяСтрока.Дата = Строка.ДатаСобытия;
			НоваяСтрока.Текст = Строка.Результат;
			НоваяСтрока.Автор = Строка.Менеджер;
			НоваяСтрока.Источник = Строка.ИсточникСобытия; 
		
		КонецЦикла;
		
	Иначе
	
		СМСТаб = DMS_ВзаимодействияСКлиентом.ПолучитьСМСПоИсточнику(ДокументОтбора);
	
	КонецЕсли;
	
	Для Каждого Строка из СМСТаб Цикл
		
		НоваяСтрока = ВсеСМС.Добавить();
		НоваяСтрока.Дата = Строка.ДатаСобытия;
		НоваяСтрока.Текст = Строка.Результат;
		НоваяСтрока.Автор = Строка.Менеджер;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсеПоКлиенту(Команда)
	
	ВсеСМС.Очистить();
	
	ТабСМС = DMS_ВзаимодействияСКлиентом.ПолучитьСМСПоКлиенту(Клиент);
	
	Элементы.ВсеСМСИсточник.Видимость = Истина;
	
	Для Каждого Строка из ТабСМС Цикл
		
		НоваяСтрока = ВсеСМС.Добавить();
		НоваяСтрока.Дата = Строка.ДатаСобытия;
		НоваяСтрока.Текст = Строка.Результат;
		НоваяСтрока.Автор = Строка.Менеджер;
		НоваяСтрока.Источник = Строка.ИсточникСобытия; 
		
	КонецЦикла;
	
КонецПроцедуры
