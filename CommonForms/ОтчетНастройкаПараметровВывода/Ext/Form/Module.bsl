
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Вставить содержимое обработчика.
	Если Параметры.Свойство("СхемаКомпоновки") Тогда
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Параметры.СхемаКомпоновки));
	КонецЕсли;
	
	Если Параметры.Свойство("НастройкиОтчета") Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(Параметры.НастройкиОтчета);
	КонецЕсли;
	
	ОграниченияИспользования = Элементы.КомпоновщикНастроекНастройкиПараметрыВывода.ОграниченияИспользования.Добавить();
	ОграниченияИспользования.Доступность = Ложь;
	ОграниченияИспользования.Параметр = Новый ПараметрКомпоновкиДанных("МакетОформления");
	
	Если Параметры.Свойство("РежимВыводаОтчета") Тогда
		ПараметрТипДиаграммы = Новый ПараметрКомпоновкиДанных("ТипДиаграммы");
		Если Параметры.РежимВыводаОтчета = 3 Тогда
			Для Каждого ТекПараметр Из Параметры.НастройкиОтчета.ПараметрыВывода.Элементы Цикл
				Если ТекПараметр.Параметр = ПараметрТипДиаграммы Тогда
					Прервать;
				КонецЕсли;
				ОграниченияИспользования = Элементы.КомпоновщикНастроекНастройкиПараметрыВывода.ОграниченияИспользования.Добавить();
				ОграниченияИспользования.Доступность = Ложь;
				ОграниченияИспользования.Параметр = ТекПараметр.Параметр;
			КонецЦикла;
		Иначе
			ОграниченияИспользования = Элементы.КомпоновщикНастроекНастройкиПараметрыВывода.ОграниченияИспользования.Добавить();
			ОграниченияИспользования.Доступность = Ложь;
			ОграниченияИспользования.Параметр = ПараметрТипДиаграммы;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
