Процедура ПриОткрытии(Отказ)
	
		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьАвто(МассивКлиентов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АвтомобилиСрезПоследних.Автомобиль.Ссылка КАК Автомобиль,
	               |	Renault_ВыполнениеТОСрезПоследних.ДатаПлан КАК ДатаСледующегоТО
	               |ИЗ
	               |	РегистрСведений.Автомобили.СрезПоследних(, ) КАК АвтомобилиСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Renault_ВыполнениеТО.СрезПоследних КАК Renault_ВыполнениеТОСрезПоследних
	               |		ПО АвтомобилиСрезПоследних.Автомобиль = Renault_ВыполнениеТОСрезПоследних.Автомобиль
	               |ГДЕ
	               |	АвтомобилиСрезПоследних.ВидЗначения = &ВидЗначения
	               |	И АвтомобилиСрезПоследних.Значение В (&МассивКлиентов)
	               |	И (Renault_ВыполнениеТОСрезПоследних.ДатаФакт = &ПустаяДата ИЛИ Renault_ВыполнениеТОСрезПоследних.ДатаФакт ЕСТЬ NULL)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	АвтомобилиСрезПоследних.Период УБЫВ";
				   
				   
	Запрос.УстановитьПараметр("МассивКлиентов", МассивКлиентов);
	Запрос.УстановитьПараметр("ВидЗначения", Перечисления.ДополнительнаяИнформацияАвтомобилей.Хозяин);
	Запрос.УстановитьПараметр("ПустаяДата", Дата('00010101'));
	
	ЗначениеВДанныеФормы(Запрос.Выполнить().Выгрузить(), ВсеАвтомобили);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивКлиентов = Параметры.Клиенты.ВыгрузитьЗначения();	
	
	Клиент = Параметры.Клиент;
	
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПрочитатьАвто(МассивКлиентов);
	
КонецПроцедуры
