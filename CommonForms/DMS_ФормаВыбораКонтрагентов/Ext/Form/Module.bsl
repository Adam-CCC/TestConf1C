&НаСервереБезКонтекста
Функция НормализоватьНомерТелефона(Телефон)
	
	Фрагмент = СокрЛП(Телефон);
	
	СтрокаЦифр = "0123456789";
	
	НомерТелефона = "";
	
 	Для А = 1 По СтрДлина(Фрагмент) Цикл
		Символ = Сред(Фрагмент, А, 1);
		Если Найти(СтрокаЦифр,Символ) <> 0 Тогда
			НомерТелефона = НомерТелефона + Символ; 
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(НомерТелефона) Тогда
		Возврат НомерТелефона;
	КонецЕсли; 
	
	Возврат НомерТелефона;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокКонтрагентовПоОтборам(ИсходныйСписок,ТекущийСписок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка В(&ИсхоныйСписок)
		|	И Контрагенты.Ссылка В(&ТекущийСписок)
		|	И НЕ Контрагенты.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("ИсхоныйСписок", ИсходныйСписок);
	Запрос.УстановитьПараметр("ТекущийСписок", ТекущийСписок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	мСписокКонтрагентов = Новый СписокЗначений;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мСписокКонтрагентов.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Возврат мСписокКонтрагентов;

КонецФункции // ПолучитьСписокКонтрагентовПоОтборам()

&НаСервере
Процедура УстановитьОтборСписка()
	
	Список.Отбор.Элементы.Очистить();
	
	Если Не ПустаяСтрока(VINОтбор) Тогда
		
		СписокОбъектов = НайтиКонтрагентовПоVIN(VINОтбор);//ПоискКонтрагента("ПоVINАвтомобиля", Неопределено, "", ЭлементыФормы.ОтборVIN.Значение);
		
		Использование = Истина;//(СписокОбъектов.Количество() > 0);
		УстановитьОтборПоСсылке(СписокОбъектов,Использование);
		
	КонецЕсли; 	

	Если Не ПустаяСтрока(ТелефонОтбор) Тогда
		
		СписокОбъектов = НайтиКонтрагентовПоТелефону(ТелефонОтбор);
		
		Использование = Истина;//(СписокОбъектов.Количество() > 0);
		УстановитьОтборПоСсылке(СписокОбъектов,Использование);
		
	КонецЕсли; 	

	Если Не ПустаяСтрока(АдресЭлектроннойПочтыОтбор) Тогда
		
		СписокОбъектов = НайтиКонтрагентовПоEMail(АдресЭлектроннойПочтыОтбор);
		
		Использование = Истина;//(СписокОбъектов.Количество() > 0);
		УстановитьОтборПоСсылке(СписокОбъектов,Использование);
		
	КонецЕсли; 	

	Если Не ПустаяСтрока(ГосНомерОтбор) Тогда
		
		СписокОбъектов = НайтиКонтрагентовПоГосНомеру(ГосНомерОтбор);
		
		Использование = Истина;//(СписокОбъектов.Количество() > 0);
		УстановитьОтборПоСсылке(СписокОбъектов,Использование);
		
	КонецЕсли; 	
	
	ТекстПоиска = СокрЛП(ФИООтбор);
	ДобавитьЭлементКомпоновки(Список,"НаименованиеПолное",ВидСравненияКомпоновкиДанных.Содержит,ТекстПоиска,,Не ПустаяСтрока(ТекстПоиска));
	
	ТекстПоиска = СокрЛП(ИННОтбор);
	ДобавитьЭлементКомпоновки(Список,"ИНН",ВидСравненияКомпоновкиДанных.Содержит,ТекстПоиска,,Не ПустаяСтрока(ТекстПоиска));
	
	ТекстПоиска = СокрЛП(КППОтбор);
	ДобавитьЭлементКомпоновки(Список,"КПП",ВидСравненияКомпоновкиДанных.Содержит,ТекстПоиска,,Не ПустаяСтрока(ТекстПоиска));
	
КонецПроцедуры // УстановитьОтборСписка()

&НаСервере
Процедура УстановитьОтборПоСсылке(СписокОтбора,Использование)

	ДобавитьЭлементКомпоновки(Список,"Ссылка",ВидСравненияКомпоновкиДанных.ВСписке,СписокОтбора,,Использование);	

КонецПроцедуры // УстановитьОтборПоСсылке()

&НаСервере
Функция ДобавитьЭлементКомпоновки(ОбластьДобавления,
									Знач ИмяПоля,
									Знач ВидСравнения,
									Знач ПравоеЗначение = Неопределено,
									Знач Представление  = Неопределено,
									Знач Использование  = Неопределено,
									знач РежимОтображения = Неопределено,
									знач ИдентификаторПользовательскойНастройки = Неопределено) Экспорт
									
	ЗначениеПоиска = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	СпособПоиска = 1;
	МассивЭлементов = Новый Массив;
	
	НайтиРекурсивно(ОбластьДобавления.Отбор.Элементы, МассивЭлементов, СпособПоиска, ЗначениеПоиска);
	
	СписокДляОтбора = ПравоеЗначение;
	
	Если МассивЭлементов.Количество() > 0 Тогда
	                                    
		мЭлементОтбора = МассивЭлементов[0];
		
		мЗначениеОтбора = мЭлементОтбора.ПравоеЗначение;
		
		Если ТипЗнч(мЗначениеОтбора) = Тип("СписокЗначений") Тогда
			СписокДляОтбора = ПолучитьСписокКонтрагентовПоОтборам(мЗначениеОтбора,ПравоеЗначение);	
		КонецЕсли; 
		
	КонецЕсли; 
	
	Элемент = ОбластьДобавления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Элемент.ВидСравнения = ВидСравнения;
		
	Если ПравоеЗначение <> Неопределено Тогда
		Элемент.ПравоеЗначение = СписокДляОтбора;
	КонецЕсли;
	
	Если Представление <> Неопределено Тогда
		Элемент.Представление = Представление;
	КонецЕсли;
	
	Если Использование <> Неопределено Тогда
		Элемент.Использование = Использование;
	КонецЕсли;
	
	Если ИдентификаторПользовательскойНастройки <> Неопределено Тогда
		Элемент.ИдентификаторПользовательскойНастройки = ИдентификаторПользовательскойНастройки;
	ИначеЕсли Элемент.РежимОтображения <> РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный Тогда
		Элемент.ИдентификаторПользовательскойНастройки = ИмяПоля;
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

&НаСервере   
Процедура НайтиРекурсивно(КоллекцияЭлементов, МассивЭлементов, СпособПоиска, ЗначениеПоиска)
	
	Для каждого ЭлементОтбора Из КоллекцияЭлементов Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			Если СпособПоиска = 1 Тогда
				Если ЭлементОтбора.ЛевоеЗначение = ЗначениеПоиска Тогда
					МассивЭлементов.Добавить(ЭлементОтбора);
				КонецЕсли;
			ИначеЕсли СпособПоиска = 2 Тогда
				Если ЭлементОтбора.Представление = ЗначениеПоиска Тогда
					МассивЭлементов.Добавить(ЭлементОтбора);
				КонецЕсли;
			КонецЕсли;
		Иначе
			
			НайтиРекурсивно(ЭлементОтбора.Элементы, МассивЭлементов, СпособПоиска, ЗначениеПоиска);
			
			Если СпособПоиска = 2 И ЭлементОтбора.Представление = ЗначениеПоиска Тогда
				МассивЭлементов.Добавить(ЭлементОтбора);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоКлиентуВОбращении(КлиентОтбора)

	СписокОбращений.Параметры.УстановитьЗначениеПараметра("Клиент",			 КлиентОтбора);
	СписокОбращений.Параметры.УстановитьЗначениеПараметра("УстановитьОтбор", ЗначениеЗаполнено(КлиентОтбора));

