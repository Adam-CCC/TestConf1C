&НаСервере
Функция ПроверитьБлокировкуДокументов()
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.Renault_CRM_ОбращениеВАвтоСервис") Тогда
			
		Обращение = ДокументОснование;	
			
		УдалосьЗаблокироватьВСе = ИСТИНА;	
			
		Обр = Обращение.Ссылка.ПолучитьОбъект();
		
		Попытка 
			
			Обр.Заблокировать();
			
		Исключение
			
			УдалосьЗаблокироватьВСе = ЛОЖЬ;			
			
		КонецПопытки;
						
		Выдача = Документы.Renault_CRM_ВыдачаАвтомобиля.НайтиПоРеквизиту("Обращение", Обр.Ссылка).Ссылка.ПолучитьОбъект();
		
		Попытка 
			
			Выдача.Заблокировать();
			
		Исключение
			
			УдалосьЗаблокироватьВСе = ЛОЖЬ;			
			
		КонецПопытки;

		ЗапросМойки = Новый Запрос();
		ЗапросМойки.Текст = "ВЫБРАТЬ
			|	ЗаявкаНаМойку.Ссылка
			|ИЗ
			|	Документ.Renault_CRM_ЗаявкаНаМойку КАК ЗаявкаНаМойку
			|ГДЕ
			|	ЗаявкаНаМойку.Обращение = &Обращение";
		ЗапросМойки.УстановитьПараметр("Обращение", Обр.Ссылка);
		Мойки = ЗапросМойки.Выполнить().Выбрать();	
			
			Пока Мойки.Следующий() Цикл
				
				Мойка = Мойки.Ссылка.ПолучитьОбъект();
				
				
				Попытка
					
					Мойка.Заблокировать();
								
				Исключение
					
					УдалосьЗаблокироватьВСе = ЛОЖЬ;					
					
				КонецПопытки;;
				
			КонецЦикла;
			
			ЗапросЗаявки = Новый Запрос();
			ЗапросМойки.Текст = "ВЫБРАТЬ
			                    |	ЗаявкаНаСервис.Ссылка
			                    |ИЗ
			                    |	Документ.Renault_CRM_ЗаявкаНаСервис КАК ЗаявкаНаСервис
			                    |ГДЕ
			                    |	ЗаявкаНаСервис.Обращение = &Обращение";
			ЗапросЗаявки.УстановитьПараметр("Обращение", Обр.Ссылка);
			Заявки = ЗапросМойки.Выполнить().Выбрать();	
			
			Пока Заявки.Следующий() Цикл
				
				Заявка = Заявки.Ссылка.ПолучитьОбъект();
				
				Попытка
				
					Заявка.Заблокировать();
				
				Исключение
					
					УдалосьЗаблокироватьВСе = ЛОЖЬ;					
									
				КонецПопытки;
				
			КонецЦикла;
			
			Подменка = Документы.Renault_CRM_ЗаявкаНаПодменныйАвто.НайтиПоРеквизиту("Обращение", Обр.Ссылка);
			
			Если ЗначениеЗаполнено(Подменка) Тогда
				
				Подменка = Подменка.Ссылка.ПолучитьОбъект();
			
				Попытка
				
					Подменка.Заблокировать();
				
				Исключение
					
					УдалосьЗаблокироватьВСе = Ложь;
					
				КонецПопытки;
				
			КонецЕсли;
			
		Возврат УдалосьЗаблокироватьВСе;	
					
		КонецЕсли;
		
		
	КонецЕсли;
	
КонецФункции

