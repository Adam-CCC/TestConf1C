
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ДилерскийЦентр") Тогда
		ДилерскийЦентр = Параметры.ДилерскийЦентр;	
	КонецЕсли; 	
	
	Если Не ЗначениеЗаполнено(ДилерскийЦентр) Тогда
		ДилерскийЦентр = Renault_CRM.ПолучитьДилерскийЦентрПользователя();	
	КонецЕсли;
	
	Если Параметры.Свойство("Клиент") И ЗначениеЗаполнено(Параметры.Клиент) Тогда 
		
		Элементы.ФИООтбор.СписокВыбора.Добавить(Параметры.Клиент.Наименование);
		ФИООтбор = Параметры.Клиент.Наименование;
		
		ДобавитьЭлементКомпоновки(Список,"Ссылка",ВидСравненияКомпоновкиДанных.Равно,Параметры.Клиент,,Истина);	
		
		УстановитьОтборПоКлиентуВОбращении(Параметры.Клиент);
		УстановитьОтборПоКлиентуВАвтомобилях(Параметры.Клиент);
		
	Иначе 
		УстановитьОтборПоКлиентуВОбращении(Неопределено);
		УстановитьОтборПоКлиентуВАвтомобилях(Неопределено);
	КонецЕсли;                   
	
	Если Параметры.Свойство("ДокументОснование") Тогда
		ДокументОснование = Параметры.ДокументОснование;	
	КонецЕсли; 
	
	Если Параметры.Свойство("РежимПроверкиБлокировок") Тогда
		РежимПроверкиБлокировок = Параметры.РежимПроверкиБлокировок;	
	КонецЕсли; 
	
	Если Параметры.Свойство("Телефон") Тогда
		
		Элементы.ТелефонОтбор.СписокВыбора.Добавить(Параметры.Телефон);
		ТелефонОтбор = Параметры.Телефон;
		
		Если Не ПустаяСтрока(ТелефонОтбор) Тогда
			
			СписокОбъектов = НайтиКонтрагентовПоТелефону(ТелефонОтбор);
			
			Использование = (СписокОбъектов.Количество() > 0);
			УстановитьОтборПоСсылке(СписокОбъектов,Использование);
			
		КонецЕсли; 	

	КонецЕсли;
		
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ФИООтборАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	//да потому, что на 8.2 другие параметры в процедуре	
	Попытка
		
		Ожидание = 3;
		ПараметрыПолученияДанных.ПолнотекстовыйПоиск = ПолнотекстовыйПоискПриВводеПоСтроке.Использовать;
		ПараметрыПолученияДанных.СтрокаПоиска = Неопределено;
	
	Исключение
		
		ПараметрыПолученияДанных = 3;
		
	КонецПопытки;
		
	Если Не ПустаяСтрока(Текст) 
		И (СтрДлина(Текст) > МаксимальнаяДлинаТекста + ?(МаксимальнаяДлинаТекста = 0,3,5) Или СтрДлина(Текст)>3 И СтрДлина(Текст)<МаксимальнаяДлинаТекста) Тогда
		
		СписокВыбораФИО = Новый СписокЗначений;
		
		Элементы.ФИООтбор.ОбновлениеТекстаРедактирования = ОбновлениеТекстаРедактирования.НеИспользовать;
		
		ТекстПоиска = СокрЛП(Текст);
		
 		Если Не ПолнотекстовыйПоискКонтрагентов(Текст,СписокВыбораФИО) Тогда 
			
			СписокВыбораФИО = Новый СписокЗначений;
			
			мФИО = Renault_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ТекстПоиска);
			
			Если мФИО.Количество() = 3 Тогда
				МассивФИО = ПолучитьФИОДляОтбора(мФИО[0],мФИО[1],мФИО[2]);
				СписокВыбораФИО.ЗагрузитьЗначения(МассивФИО); 
			ИначеЕсли мФИО.Количество() = 2 Тогда
				МассивФИО = ПолучитьФИОДляОтбора(мФИО[0],мФИО[1]);
				СписокВыбораФИО.ЗагрузитьЗначения(МассивФИО); 
			ИначеЕсли мФИО.Количество() = 1 Тогда
				МассивФИО = ПолучитьФИОДляОтбора(мФИО[0]);
				СписокВыбораФИО.ЗагрузитьЗначения(МассивФИО);
			Иначе 
				СписокВыбораФИО.Очистить(); 
			КонецЕсли; 
									
			Если СписокВыбораФИО.НайтиПоЗначению(ТекстПоиска) = Неопределено Тогда
				СписокВыбораФИО.Добавить(ТекстПоиска);
			КонецЕсли;

			Элемент.СписокВыбора.ЗагрузитьЗначения(СписокВыбораФИО.ВыгрузитьЗначения());
			ФИООтбор = ТекстПоиска;
			
		Иначе 
			Если СписокВыбораФИО.НайтиПоЗначению(ТекстПоиска) = Неопределено Тогда
				СписокВыбораФИО.Добавить(ТекстПоиска);
			КонецЕсли;
			
			Элемент.СписокВыбора.ЗагрузитьЗначения(СписокВыбораФИО.ВыгрузитьЗначения());			
			ФИООтбор = ТекстПоиска;
				
		КонецЕсли;
		
		Если МаксимальнаяДлинаТекста > СтрДлина(Текст) Тогда
			МаксимальнаяДлинаТекста = ?(СтрДлина(Текст)<=3,0,МаксимальнаяДлинаТекста - ?(СтрДлина(Текст)/5>1,5,МаксимальнаяДлинаТекста));
		Иначе 
			МаксимальнаяДлинаТекста = СтрДлина(СокрЛП(Текст));			
		КонецЕсли; 
		
	КонецЕсли; 

	Если Элемент.СписокВыбора.НайтиПоЗначению(ТекстПоиска) = Неопределено Тогда
		Элемент.СписокВыбора.Добавить(ТекстПоиска);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФИООтборПриИзменении(Элемент)
	
	ФИООтбор = Элемент.ТекстРедактирования;
	Элементы.ФИООтбор.ОбновлениеТекстаРедактирования = ОбновлениеТекстаРедактирования.Авто;
	УстановитьОтборСписка();
	Если Не ПустаяСтрока(ФИООтбор) 
		И (Renault_СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ФИООтбор).Количество() = 3)Тогда
	
		ПроверитьПодобныхКонтрагентов(СокрЛП(ФИООтбор));
	
	КонецЕсли; 
	
	МаксимальнаяДлинаТекста = СтрДлина(СокрЛП(ФИООтбор));
	
КонецПроцедуры

