&НаСервереБезКонтекста
Функция ПолучитьСписокВыбораПоГосНомерам(ГосНомер)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГосНомер", "%"+ГосНомер+"%");
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(АвтомобилиСрезПоследних.Значение КАК СТРОКА(20)) КАК ГосНомер
		|ИЗ
		|	РегистрСведений.Автомобили.СрезПоследних(, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК АвтомобилиСрезПоследних
		|ГДЕ
		|	(ВЫРАЗИТЬ(АвтомобилиСрезПоследних.Значение КАК СТРОКА(20))) Подобно &ГосНомер";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивГосНомеров = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивГосНомеров.Добавить(ВыборкаДетальныеЗаписи.ГосНомер);
	КонецЦикла;
	
 	Возврат МассивГосНомеров;
	
КонецФункции // ПолучитьСписокВыбораПоГосНомерам()

