КонецПроцедуры // УстановитьОтборПоКлиентуВОбращении()

&НаКлиенте
Процедура Привилегии(Команда)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	мТабличныйДокумент = Renault_АвтосервисСкидки.ПечатьПривилегийКартыКлиента(ТекущаяСтрока.Ссылка);
	
	мТабличныйДокумент.Показать("Привилегии клиента");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодобныхКонтрагентов(ФИО)
	
	МассивПодобных = ПолучитьМассивПодобныхКонтрагентов(ФИО);
	
	Если МассивПодобных.Количество() <> 0 Тогда
		
		ПараметрыФормы = Новый Структура("Контрагенты",МассивПодобных);
						
		ЗначениеВыбора = ОткрытьФормуМодально("ОбщаяФорма.DMS_ФормаПодобныхКонтрагентов",ПараметрыФормы);
		
		Если ЗначениеЗаполнено(ЗначениеВыбора) Тогда
		
			мФИООтбор = ЗначениеВыбора.НаименованиеПолное;	
			
			Если Элементы.ФИООтбор.СписокВыбора.НайтиПоЗначению(мФИООтбор) = Неопределено Тогда
				Элементы.ФИООтбор.СписокВыбора.Добавить(мФИООтбор);
			КонецЕсли; 
			
			ФИООтбор = мФИООтбор;
			
			УстановитьОтборСписка();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивПодобныхКонтрагентов(ФИО)
	
	МассивПодобныхКонтрагентов = Новый Массив;
	
	Запрос = Новый Запрос;
	
	СтруктураФИО = DMS_ФизическиеЛицаСервер.ФамилияИмяОтчество(ФИО);
	
	Для каждого ТекущийПараметр Из СтруктураФИО Цикл
		Запрос.УстановитьПараметр(ТекущийПараметр.Ключ,ТекущийПараметр.Значение);
	КонецЦикла; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеФизическихЛиц.Фамилия,
		|	ДанныеФизическихЛиц.Имя,
		|	ДанныеФизическихЛиц.Отчество
		|ПОМЕСТИТЬ ПредпологаемыеФИО
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Фамилия = &Фамилия
		|	И ДанныеФизическихЛиц.Имя = &Имя
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеФизическихЛиц.Фамилия,
		|	ДанныеФизическихЛиц.Имя,
		|	ДанныеФизическихЛиц.Отчество
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Фамилия = &Фамилия
		|	И ДанныеФизическихЛиц.Отчество = &Отчество
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеФизическихЛиц.Фамилия,
		|	ДанныеФизическихЛиц.Имя,
		|	ДанныеФизическихЛиц.Отчество
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Имя = &Имя
		|	И ДанныеФизическихЛиц.Отчество = &Отчество
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДанныеФизическихЛиц.Фамилия,
		|	ДанныеФизическихЛиц.Имя,
		|	ДанныеФизическихЛиц.Отчество
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Имя = &Имя
		|	И ДанныеФизическихЛиц.Отчество = &Отчество
		|	И ДанныеФизическихЛиц.Фамилия = &Фамилия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ВЫРАЗИТЬ(ВЫБОР
		|				КОГДА ПредпологаемыеФИО.Фамилия = &Фамилия
		|						И ПредпологаемыеФИО.Имя = &Имя
		|						И ПредпологаемыеФИО.Отчество = &Отчество
		|					ТОГДА 4
		|				КОГДА ПредпологаемыеФИО.Фамилия = &Фамилия
		|						И ПредпологаемыеФИО.Имя = &Имя
		|					ТОГДА 1
		|				КОГДА ПредпологаемыеФИО.Фамилия = &Фамилия
		|						И ПредпологаемыеФИО.Отчество = &Отчество
		|					ТОГДА 2
		|				КОГДА ПредпологаемыеФИО.Имя = &Имя
		|						И ПредпологаемыеФИО.Отчество = &Отчество
		|					ТОГДА 3
		|				ИНАЧЕ 0
		|			КОНЕЦ КАК ЧИСЛО(1, 0))) КАК ВариантСовпадения
		|ПОМЕСТИТЬ ВариантыСовпадения
		|ИЗ
		|	ПредпологаемыеФИО КАК ПредпологаемыеФИО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПредпологаемыеФИО.Отчество КАК СтрокиПоиска,
		|	&Отчество КАК ОбъектПоиска,
		|	ВариантыСовпадения.ВариантСовпадения КАК ВариантСовпадения
		|ПОМЕСТИТЬ ДанныеАнализа
		|ИЗ
		|	ВариантыСовпадения КАК ВариантыСовпадения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПредпологаемыеФИО КАК ПредпологаемыеФИО
		|		ПО (ВариантыСовпадения.ВариантСовпадения = 1)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПредпологаемыеФИО.Имя,
		|	&Имя,
		|	ВариантыСовпадения.ВариантСовпадения
		|ИЗ
		|	ВариантыСовпадения КАК ВариантыСовпадения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПредпологаемыеФИО КАК ПредпологаемыеФИО
		|		ПО (ВариантыСовпадения.ВариантСовпадения = 2)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПредпологаемыеФИО.Фамилия,
		|	&Фамилия,
		|	ВариантыСовпадения.ВариантСовпадения
		|ИЗ
		|	ВариантыСовпадения КАК ВариантыСовпадения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПредпологаемыеФИО КАК ПредпологаемыеФИО
		|		ПО (ВариантыСовпадения.ВариантСовпадения = 3)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеАнализа.ОбъектПоиска КАК ОбъектПоиска,
		|	ДанныеАнализа.ВариантСовпадения
		|ИЗ
		|	ДанныеАнализа КАК ДанныеАнализа
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбъектПоиска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеАнализа.СтрокиПоиска КАК СтрокиПоиска
		|ИЗ
		|	ДанныеАнализа КАК ДанныеАнализа
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтрокиПоиска";
		
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаОбъектПоиска = РезультатЗапроса[3].Выбрать();
	
	Если ВыборкаОбъектПоиска.Следующий() Тогда

		ВариантПоиска = ВыборкаОбъектПоиска.ВариантСовпадения;
		
		Запрос = Новый Запрос;
		
		ОбъектПоиска = НРег(СокрЛП(ВыборкаОбъектПоиска.ОбъектПоиска));	
		
		ПараметрПоиска = "ПараметрПоиска";
		
		ТекстРезультат 		= "";
		ТекстКоличествоБукв = "";
		
		МассивБукв = Новый Массив;
		
		Для А = 1 По СтрДлина(ОбъектПоиска) Цикл
			                                                   
			Символ = Сред(ОбъектПоиска, А, 1);
			
			ИмяПараметра 	  = "ПараметрПоиска"+Формат(А,"ЧЦ=3; ЧН=0; ЧГ=");
			ЗначениеПараметра = """%"+Символ+"%""";
			
			Запрос.УстановитьПараметр(ИмяПараметра,ЗначениеПараметра);     
			
			ТекстРезультат 		= ТекстРезультат + Символы.ПС +"Выбор когда ДанныеАнализа.СтрокиПоиска Подобно "+ЗначениеПараметра+" Тогда "+А+" Иначе 0 Конец + ";
			
			Если МассивБукв.Найти(Символ) <> Неопределено Тогда
				ТекстКоличествоБукв = ТекстКоличествоБукв + Символы.ПС +"Выбор когда ДанныеАнализа.СтрокиПоиска Подобно "+ЗначениеПараметра+" Тогда 0 Иначе 0 Конец + ";
			Иначе 	
				МассивБукв.Добавить(Символ);                    
				ТекстКоличествоБукв = ТекстКоличествоБукв + Символы.ПС +"Выбор когда ДанныеАнализа.СтрокиПоиска Подобно "+ЗначениеПараметра+" Тогда 1 Иначе 0 Конец + ";
			КонецЕсли; 
			
		КонецЦикла;
		
		МассивБукв = Неопределено;
		
		ТекстРезультат		= Лев(СокрЛП(ТекстРезультат),СтрДлина(СокрЛП(ТекстРезультат))-1);
		ТекстКоличествоБукв = Лев(СокрЛП(ТекстКоличествоБукв),СтрДлина(СокрЛП(ТекстКоличествоБукв))-1);
		
		Запрос.УстановитьПараметр("мДанныеАнализа",РезультатЗапроса[4].Выгрузить());
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	мДанныеАнализа.СтрокиПоиска
			|ПОМЕСТИТЬ ДанныеАнализа
			|ИЗ
			|	&мДанныеАнализа КАК мДанныеАнализа
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////   
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДанныеАнализа.СтрокиПоиска КАК СтрокиПоиска,
			|	СУММА("+ТекстРезультат+") КАК РезультатПоиска,
			|	СУММА("+ТекстКоличествоБукв+") КАК КоличествоБукв
			|ПОМЕСТИТЬ РезультатАнализа
			|ИЗ
			|	ДанныеАнализа КАК ДанныеАнализа
			|
			|СГРУППИРОВАТЬ ПО
			|	ДанныеАнализа.СтрокиПоиска
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ ПЕРВЫЕ 3
			|	РезультатАнализа.СтрокиПоиска КАК СтрокиПоиска,
			|	РезультатАнализа.РезультатПоиска,
			|	РезультатАнализа.КоличествоБукв
			|ИЗ
			|	РезультатАнализа КАК РезультатАнализа
			|ГДЕ
			|	РезультатАнализа.КоличествоБукв > 2
			|
			|УПОРЯДОЧИТЬ ПО
			|	РезультатПоиска УБЫВ";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаПоиска = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаПоиска.Следующий() Цикл 
			
			мФИО = "";
			
			Если ВариантПоиска = 1 Тогда
				мФИО = СтруктураФИО.Фамилия +" "+СтруктураФИО.Имя+" "+ВыборкаПоиска.СтрокиПоиска;
			ИначеЕсли ВариантПоиска = 2 Тогда
				мФИО = СтруктураФИО.Фамилия +" "+ВыборкаПоиска.СтрокиПоиска+" "+СтруктураФИО.Отчество;
			ИначеЕсли ВариантПоиска = 3 Тогда
				мФИО = ВыборкаПоиска.СтрокиПоиска +" "+СтруктураФИО.Имя+" "+СтруктураФИО.Отчество;
			КонецЕсли; 		
						
			Если Не ПустаяСтрока(мФИО) Тогда
				
				ФизическоеЛицо = DMS_ФизическиеЛицаСервер.ПолучитьКонтрагентаПоФИО(мФИО);
				
				Если ЗначениеЗаполнено(ФизическоеЛицо) Тогда
					МассивПодобныхКонтрагентов.Добавить(ФизическоеЛицо);
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;       
	
	Возврат МассивПодобныхКонтрагентов;
	
КонецФункции // ПолучитьМассивПодобныхКонтрагентов()

