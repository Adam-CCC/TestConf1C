&НаСервереБезКонтекста
Функция НайтиКонтрагентовПоГосНомеру(ГосНомер,НаДату = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГосНомер", "%"+СокрЛП(ГосНомер)+"%");
	Запрос.УстановитьПараметр("НаДату",   ?(НаДату = Неопределено,Дата('00010101'),НаДату));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(ВладельцыАвто.Значение КАК Справочник.Контрагенты) КАК Контрагент
		|ИЗ
		|	РегистрСведений.Автомобили.СрезПоследних(&НаДату, ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.ГосНомер)) КАК АвтомобилиПоГосНомер
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Автомобили.СрезПоследних КАК ВладельцыАвто
		|		ПО АвтомобилиПоГосНомер.Автомобиль = ВладельцыАвто.Автомобиль
		|			И (ВладельцыАвто.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин))
		|			И ((ВЫРАЗИТЬ(ВладельцыАвто.Значение КАК Справочник.Контрагенты)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
		|ГДЕ
		|	ВЫРАЗИТЬ(АвтомобилиПоГосНомер.Значение КАК СТРОКА) ПОДОБНО &ГосНомер";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	мСписокКонтрагентов = Новый СписокЗначений;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мСписокКонтрагентов.Добавить(ВыборкаДетальныеЗаписи.Контрагент);
	КонецЦикла;
	
	Возврат мСписокКонтрагентов;
	
КонецФункции // НайтиКонтрагентовПоГосНомеру()

&НаСервереБезКонтекста
Функция НайтиКонтрагентовПоVIN(VIN,НаДату = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("VIN", "%"+СокрЛП(VIN)+"%");
	Запрос.УстановитьПараметр("НаДату", ?(НаДату = Неопределено,Дата('00010101'),НаДату));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(АвтомобилиПоВИН.Значение КАК Справочник.Контрагенты) КАК Контрагент
		|ИЗ
		|	РегистрСведений.Автомобили.СрезПоследних(
		|			&НаДату,
		|			ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ДополнительнаяИнформацияАвтомобилей.Хозяин)
		|				И Автомобиль.VIN ПОДОБНО &VIN) КАК АвтомобилиПоВИН";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	мСписокКонтрагентов = Новый СписокЗначений;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		мСписокКонтрагентов.Добавить(ВыборкаДетальныеЗаписи.Контрагент);
	КонецЦикла;
	
	Возврат мСписокКонтрагентов;
	
КонецФункции // НайтиКонтрагентовПоГосНомеру()

&НаСервереБезКонтекста
Функция НайтиКонтрагентовПоТелефону(ОтборТелефон)
	
	НомерТелефона = НормализоватьНомерТелефона(ОтборТелефон);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Телефон", ?(НомерТелефона = "","","%" + НомерТелефона + "%"));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(НормализованныеКонтактыДляПоиска.Объект КАК Справочник.Контрагенты) КАК Контрагент,
		|	НормализованныеКонтактыДляПоиска.Телефон
		|ИЗ
		|	РегистрСведений.Renault_НормализованныеКонтактыДляПоиска КАК НормализованныеКонтактыДляПоиска
		|ГДЕ
		|	НормализованныеКонтактыДляПоиска.Телефон<>"""" И НормализованныеКонтактыДляПоиска.Телефон ПОДОБНО &Телефон И &Телефон <> """"
		|	И НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.Контрагенты";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	СписокОбъектов = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		СписокОбъектов.Добавить(Выборка.Контрагент);	
	КонецЦикла; 
	
	Возврат СписокОбъектов;

