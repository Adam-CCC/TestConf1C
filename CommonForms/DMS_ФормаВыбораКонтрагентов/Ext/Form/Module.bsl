&НаСервереБезКонтекста
Функция ПолучитьСписокВыбораПоТелефону(НомерТелефона)
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Телефон", ?(НомерТелефона = "","","%" + НомерТелефона + "%"));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НормализованныеКонтактыДляПоиска.Телефон
		|ИЗ
		|	РегистрСведений.Renault_НормализованныеКонтактыДляПоиска КАК НормализованныеКонтактыДляПоиска
		|ГДЕ
		|	НормализованныеКонтактыДляПоиска.Телефон<> """" И НормализованныеКонтактыДляПоиска.Телефон ПОДОБНО &Телефон И &Телефон <> """"
		|	И НормализованныеКонтактыДляПоиска.Объект ССЫЛКА Справочник.Контрагенты";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	МассивОбъектов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		МассивОбъектов.Добавить(Выборка.Телефон);	
	КонецЦикла; 
	
	Возврат МассивОбъектов;

