&НаКлиенте
Процедура СписокАвтомобилейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.СписокАвтомобилей.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Поле = Элементы.СписокАвтомобилейНайти Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) Тогда
			
			Обработка = Обработки.Renault_ИсторияАвтомобиля.Создать();
			Обработка.ВнешнийЗапрос = ИСТИНА;
			Обработка.ЗаполнитьТаблицу(ТекущаяСтрока.Ссылка, "");
			Форма = Обработка.ПолучитьФорму("Форма");
			Ответ = Форма.ОткрытьМодально();
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры
 
&НаСервереБезКонтекста
Функция ПолучитьФИОДляОтбора(Фамилия = "",Имя = "",Отчество = "")
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Фамилия",  ?(Фамилия = "","","%" + СокрЛП(Фамилия)+"%"));
	Запрос.УстановитьПараметр("Имя", 	  ?(Имя = "","","%" + СокрЛП(Имя)+"%"));
	Запрос.УстановитьПараметр("Отчество", ?(Отчество = "","","%" + СокрЛП(Отчество)+"%"));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеФизическихЛиц.Фамилия + "" "" + ДанныеФизическихЛиц.Имя + "" "" + ДанныеФизическихЛиц.Отчество КАК ФИО
		|ПОМЕСТИТЬ мФИО
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Фамилия ПОДОБНО &Фамилия
		|	И ДанныеФизическихЛиц.Имя ПОДОБНО &Имя
		|	И ДанныеФизическихЛиц.Отчество ПОДОБНО &Отчество
		|	И &Фамилия <> """"
		|			И &Имя <> """"
		|			И &Отчество <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеФизическихЛиц.Фамилия + "" "" + ДанныеФизическихЛиц.Имя + "" "" + ДанныеФизическихЛиц.Отчество
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Фамилия ПОДОБНО &Фамилия
		|	И ДанныеФизическихЛиц.Имя ПОДОБНО &Имя
		|	И &Фамилия <> """"
		|			И &Имя <> """"
		|			И &Отчество = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеФизическихЛиц.Фамилия + "" "" + ДанныеФизическихЛиц.Имя + "" "" + ДанныеФизическихЛиц.Отчество
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Фамилия ПОДОБНО &Фамилия
		|	И ДанныеФизическихЛиц.Отчество ПОДОБНО &Отчество
		|	И &Фамилия <> """"
		|			И &Имя = """"
		|			И &Отчество <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеФизическихЛиц.Фамилия + "" "" + ДанныеФизическихЛиц.Имя + "" "" + ДанныеФизическихЛиц.Отчество
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Фамилия ПОДОБНО &Фамилия
		|	И &Фамилия <> """"
		|			И &Имя = """"
		|			И &Отчество = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДанныеФизическихЛиц.Фамилия + "" "" + ДанныеФизическихЛиц.Имя + "" "" + ДанныеФизическихЛиц.Отчество
		|ИЗ
		|	РегистрСведений.DMS_ДанныеФизическихЛиц КАК ДанныеФизическихЛиц
		|ГДЕ
		|	ДанныеФизическихЛиц.Имя ПОДОБНО &Имя
		|	И &Фамилия = """"
		|			И &Имя <> """"
		|			И &Отчество = """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	мФИО.ФИО
		|ИЗ
		|	мФИО КАК мФИО";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивФИО = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивФИО.Добавить(ВыборкаДетальныеЗаписи.ФИО);
	КонецЦикла;
	
	Возврат МассивФИО;
	
КонецФункции // ПолучитьФИОДляОтбора()

