&НаКлиенте
Процедура СоздатьКонтрагента(Команда)
	
	МассивПодобных = НайтиДублиНаСервере(ФИООтбор);
	
	Если МассивПодобных.Количество() > 0 Тогда
		
		ПараметрыФормы = Новый Структура("Контрагенты,Заголовок,Подсказка",МассивПодобных,"Поиск дублей","Найдены дублирующие элементы:");
		
		ЗначениеВыбора = ОткрытьФормуМодально("ОбщаяФорма.DMS_ФормаПодобныхКонтрагентов",ПараметрыФормы);
		
		Если ЗначениеЗаполнено(ЗначениеВыбора) Тогда		
			ОповеститьОВыборе(ЗначениеВыбора);
			Возврат;
		КонецЕсли; 
		
	КонецЕсли; 
	
	НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
	НовыйКонтрагент.Родитель = ДилерскийЦентр.КаталогСозданияКонтрагентовАвтосервис;
	НовыйКонтрагент.НаименованиеПолное = ФИООтбор;
	
	Обработка = Обработки.CRM_АРМ_АвтоСервис.Создать();
	Обработка.ДилерскийЦентр = ДилерскийЦентр; //DMSCOR-973
	Форма = Обработка.ПолучитьФорму("ФормаСозданиеКонтрагента");
	Форма.ЭлементыФормы.ФИО.Значение 	 = ФИООтбор;
	Форма.ЭлементыФормы.Телефон.Значение = ТелефонОтбор;
	
	НовыйКонтрагент = Форма.ОткрытьМодально();
	
	Если НовыйКонтрагент <> Неопределено Тогда
	
		Если ЗначениеЗаполнено(НовыйКонтрагент.Ссылка) Тогда
			Закрыть(НовыйКонтрагент.Ссылка);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточку(Команда)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		
		Сообщить("Выберите контрагента");
		Возврат;
	
	КонецЕсли; 
	
	Профиль = ПолучитьПрофильКлиента(ТекущаяСтрока.Ссылка);
	
	Если Профиль <> Неопределено И ЗначениеЗаполнено(Профиль) Тогда
		
		Профиль.Ссылка.ПолучитьФорму().Открыть();
		
	Иначе
		
		ТекущаяСтрока.Ссылка.ПолучитьФорму().Открыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	СтандартнаяОбработка = Ложь;
	
	Текст = Renault_АвтосервисОбщий.Renault_СообщитьОЗаметках(ТекущаяСтрока.Ссылка);
	
	Если ЗначениеЗаполнено(Текст) Тогда
		Предупреждение(Текст);
	КонецЕсли;
		
	Если РежимПроверкиБлокировок <> Истина Тогда
	
		ОповеститьОВыборе(ТекущаяСтрока.Ссылка);
	
	Иначе
		
		Если ПроверитьБлокировкуДокументов() <> Истина Тогда
			
			Предупреждение("Один из документов заблокирован другим пользователем, невозможно изменить контрагента");
			
		Иначе
			
			ОповеститьОВыборе(ТекущаяСтрока.Ссылка);			
			
		КонецЕсли;		
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	УстановитьОтборПоКлиентуВОбращении(ТекущаяСтрока.Ссылка);
	УстановитьОтборПоКлиентуВАвтомобилях(ТекущаяСтрока.Ссылка);
	
	ДанныеПоСкидкамИБаллам = Renault_АвтосервисСкидки.ПолучитьИнформациюПоСкидкамИБонусамПоКонтрагенту(ТекущаяСтрока.Ссылка);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма,ДанныеПоСкидкамИБаллам,"ОстатокБаллов,ПрограммаЛояльности,СкидкаЗапчасти,СкидкаРаботы");
	
	Элементы.ПрограммаЛояльности.Видимость = ЗначениеЗаполнено(ПрограммаЛояльности);
	Элементы.ГруппаПривилегии.Видимость    = ТекущаяСтрока.ЕстьПривилегии;
	
	Элементы.тВзаиморасчеты.Заголовок = Renault_АвтосервисОбщий.Renault_ПолучитьДолгКлиента(ТекущаяСтрока.Ссылка);
	
	Элементы.Хобби.Заголовок = "Хобби(" + Строка(Renault_АвтосервисСервер.ПолучитьКоличествоХобби(ТекущаяСтрока.Ссылка)) + ")";
	
КонецПроцедуры

