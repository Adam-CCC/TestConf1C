&НаСервере
Функция ПолнотекстовыйПоискКонтрагентов(ТекстПоиска,СписокВыбораФИО)
			
	ГдеИщем = Новый Массив;
	ГдеИщем.Добавить(Метаданные.Справочники.Контрагенты.ПолноеИмя());
	ГдеИщем.Добавить(Метаданные.Справочники.CRM_ПотенциальныеКонтрагенты.ПолноеИмя());
	ГдеИщем.Добавить(Метаданные.РегистрыСведений.DMS_ДанныеФизическихЛиц.ПолноеИмя());
	
	мТекстПоиска = СокрЛП(ТекстПоиска);
	
	Попытка
		Результат = Renаult_ПолнотекстовыйПоиск.ВыполнитьПоиск(мТекстПоиска,ГдеИщем,Истина,25,10,Истина);
	Исключение
		Возврат Ложь;
	КонецПопытки;
		Результат.Сортировать("Представление Возр");
	
	Если ЗначениеЗаполнено(Результат) Тогда
				
		ИассивРезультат = Результат.ВыгрузитьКолонку("Представление");
		
		Для каждого ТекущаяСтрока Из ИассивРезультат Цикл
			
			Если СписокВыбораФИО.НайтиПоЗначению(ТекущаяСтрока) = Неопределено Тогда
				СписокВыбораФИО.Добавить(ТекущаяСтрока,ТекущаяСтрока);
			КонецЕсли; 
			             
		КонецЦикла; 
		
		Если СписокВыбораФИО.НайтиПоЗначению(ТекстПоиска) = Неопределено Тогда
			СписокВыбораФИО.Добавить(ТекстПоиска);
		КонецЕсли; 
		
		ФИООтбор = ТекстПоиска;		
				
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции // ПолнотекстовыйПоискКонтрагентов()
 
&НаСервереБезКонтекста
Функция НайтиДублиНаСервере(НаименованиеКонтрагента)
	
	КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	КонтрагентОбъект.Наименование 		= НаименованиеКонтрагента;
	КонтрагентОбъект.НаименованиеПолное = НаименованиеКонтрагента;
	
	ПоискДублей = Обработки.ПоискИЗаменаДублирующихсяЭлементов.Создать();
	
	СтруктураПоиска = Новый Структура("Код,Наименование,НаименованиеПолное, ИНН,ОсновнойТелефон",Неопределено,"=",Неопределено,Неопределено,Неопределено);
	НайденныеОбъекты  = ПоискДублей.НайтиДубли(КонтрагентОбъект,СтруктураПоиска);
	
	СтруктураПоиска = Новый Структура("Код,Наименование,НаименованиеПолное, ИНН,ОсновнойТелефон",Неопределено,Неопределено,"=",Неопределено,Неопределено);
	
	Для Каждого Объект из ПоискДублей.НайтиДубли(КонтрагентОбъект,СтруктураПоиска) цикл
		
		НайденныйОбъект = НайденныеОбъекты.Найти(Объект.Ссылка, "Ссылка");
		
		Если (НайденныйОбъект <> Неопределено) тогда
			
			Для Каждого Колонка Из НайденныеОбъекты.Колонки Цикл
				
				Если ТипЗнч(НайденныйОбъект[Колонка.Имя]) = Тип("Булево") И НЕ НайденныйОбъект[Колонка.Имя] И Объект[Колонка.Имя] Тогда	
					НайденныйОбъект[Колонка.Имя] = Истина;
				КонецЕсли;
				
			КонецЦикла; 
			
			Продолжить;
			
		КонецЕсли;
		
		НоваяСтрока = НайденныеОбъекты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Объект);
		
	КонецЦикла;
	
	Возврат НайденныеОбъекты.ВыгрузитьКолонку("Ссылка");
	
КонецФункции // НайтиДубли()


