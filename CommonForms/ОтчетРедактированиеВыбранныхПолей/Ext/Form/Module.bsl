&НаКлиенте
Процедура КомпоновщикНастроекНастройкиПорядокПолеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("СхемаКомпоновки", СхемаКомпоновки);
	Попытка
		СтруктураПараметров.Вставить("ПоляГруппировки", Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ЭлементПоляГруппировки);
	Исключение
		СтруктураПараметров.Вставить("ПоляГруппировки", Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ПоляГруппировки);
	КонецПопытки;
	СтруктураПараметров.Вставить("ВидПолей",        "Порядок");
	
	ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетВыборПоля", СтруктураПараметров, Элемент);
	
	Рез = ФормаВыбора.ОткрытьМодально();
	Если НЕ Рез = КодВозвратаДиалога.Отмена И НЕ Рез = Неопределено Тогда
		Попытка
			СтрокаВыбора = Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ЭлементПорядок.ПолучитьОбъектПоИдентификатору(Элементы.КомпоновщикНастроекНастройкиПорядок.ТекущаяСтрока);
		Исключение
			СтрокаВыбора = Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.Порядок.ПолучитьОбъектПоИдентификатору(Элементы.КомпоновщикНастроекНастройкиПорядок.ТекущаяСтрока);
		КонецПопытки;
		СтрокаВыбора.Поле = Рез;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СхемаКомпоновки") Тогда
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Параметры.СхемаКомпоновки));
		СхемаКомпоновки = Параметры.СхемаКомпоновки;
	КонецЕсли;
	
	Если Параметры.Свойство("НастройкиОтчета") Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(Параметры.НастройкиОтчета);
	КонецЕсли;
	
	Если Параметры.Свойство("ТекущаяСтрока") Тогда
		Элементы.КомпоновщикНастроекНастройки.ТекущаяСтрока = Параметры.ТекущаяСтрока;
	КонецЕсли;
	
	Если Параметры.Свойство("ВидПолей") Тогда
		Если Параметры.ВидПолей = "Структура" Тогда
			ЭтаФорма.Заголовок = "Редактирование структуры отчета";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаПоляВыбора.ПодчиненныеЭлементы.ГруппаСтруктура;
		ИначеЕсли Параметры.ВидПолей = "ДопПоля" Тогда
			ЭтаФорма.Заголовок = "Редактирование полей";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаПоляВыбора.ПодчиненныеЭлементы.ГруппаДопПоля;
		ИначеЕсли Параметры.ВидПолей = "Порядок" Тогда
			ЭтаФорма.Заголовок = "Редактирование порядка";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаПоляВыбора.ПодчиненныеЭлементы.ГруппаПорядок;
		ИначеЕсли Параметры.ВидПолей = "Отбор" Тогда
			ЭтаФорма.Заголовок = "Редактирование отбора";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаПоляВыбора.ПодчиненныеЭлементы.ГруппаОтбор;
		ИначеЕсли Параметры.ВидПолей = "УсловноеОформление" Тогда
			ЭтаФорма.Заголовок = "Редактирование условного оформления";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаПоляВыбора.ПодчиненныеЭлементы.ГруппаУсловноеОформление;
		ИначеЕсли Параметры.ВидПолей = "ПараметрыВывода" Тогда
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаПоляВыбора.ПодчиненныеЭлементы.ГруппаПараметрыВывода;
		ИначеЕсли Параметры.ВидПолей = "НастройкаСтруктуры" Тогда
			ЭтаФорма.Заголовок = "Редактирование структуры отчета";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаНастройкаСтруктуры;
			Для Каждого ТекИзмерение Из Параметры.Измерения Цикл
				НоваяСтрока = Группировки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекИзмерение);
				//НоваяСтрока.Использование  = ТекИзмерение.Использование;
				//НоваяСтрока.Заголовок      = ТекИзмерение.Заголовок;
				//НоваяСтрока.Поле           = ТекИзмерение.Поле;
				НоваяСтрока.Картинка       = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
				//НоваяСтрока.ТипГруппировки = ТекИзмерение.ТипГруппировки;
			КонецЦикла;
			СтрокаСтруктуры = ОтчетыСервер.КомпоновщикПолучитьПервуюСтрокуСтруктурыПоПолю(КомпоновщикНастроек.Настройки.Структура);
			Если НЕ СтрокаСтруктуры = Неопределено Тогда
				Элементы.КомпоновщикНастроекНастройки.ТекущаяСтрока = КомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(СтрокаСтруктуры);
			КонецЕсли;
		ИначеЕсли Параметры.ВидПолей = "ДопГруппировки" Тогда
			
			ЭтаФорма.Заголовок = "Редактирование группиовок";
			Элементы.ГруппировкиТипГруппировки.Видимость = Ложь;
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаНастройкаСтруктуры;
			
			Для Каждого ТекИзмерение Из Параметры.Измерения Цикл
				НоваяСтрока = Группировки.Добавить();
				НоваяСтрока.Заголовок     = ТекИзмерение.Заголовок;
				НоваяСтрока.Поле          = ТекИзмерение.Поле;
				НоваяСтрока.Использование = ТекИзмерение.Использование;
				НоваяСтрока.Картинка  = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
			КонецЦикла;
			
			СтрокаСтруктуры = ОтчетыСервер.КомпоновщикПолучитьПервуюСтрокуСтруктурыПоПолю(КомпоновщикНастроек.Настройки.Структура);
			Если НЕ СтрокаСтруктуры = Неопределено Тогда
				Элементы.КомпоновщикНастроекНастройки.ТекущаяСтрока = КомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(СтрокаСтруктуры);
			КонецЕсли;
			
		ИначеЕсли Параметры.ВидПолей = "ИзменениеПорядка" Тогда
			ЭтаФорма.Заголовок = "Редактирование порядка";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаВыбораПорядка;
			Для Каждого ТекИзмерение Из Параметры.Поля Цикл
				НоваяСтрока = ВыбранныеПоля.Добавить();
				НоваяСтрока.Заголовок     = ТекИзмерение.Заголовок;
				НоваяСтрока.Поле          = ТекИзмерение.Поле;
				НоваяСтрока.ПоВозрастанию = (ТекИзмерение.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр);
				НоваяСтрока.Картинка      = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
			КонецЦикла;
		ИначеЕсли Параметры.ВидПолей = "ИзменениеВыбора" Тогда
			ЭтаФорма.Заголовок = "Редактирование полей";
			Элементы.ГруппаПоляВыбора.ТекущаяСтраница = Элементы.ГруппаВыбораДопПолей;
			Для Каждого ТекИзмерение Из Параметры.Поля Цикл
				НоваяСтрока = ВыбранныеПоля.Добавить();
				НоваяСтрока.Заголовок     = ТекИзмерение.Заголовок;
				НоваяСтрока.Поле          = ТекИзмерение.Поле;
				НоваяСтрока.Картинка      = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
			КонецЦикла;
			
			СтрокаСтруктуры = ОтчетыСервер.КомпоновщикПолучитьПервуюСтрокуСтруктурыПоПолю(КомпоновщикНастроек.Настройки.Структура);
			Если НЕ СтрокаСтруктуры = Неопределено Тогда
				Элементы.КомпоновщикНастроекНастройки.ТекущаяСтрока = КомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(СтрокаСтруктуры);
			КонецЕсли;
			
		КонецЕсли;
		ВидПолей = Параметры.ВидПолей;
	КонецЕсли;
	
	Если Параметры.Свойство("ПолеГруппировки") Тогда
		ПолеГруппировки          = Параметры.ПолеГруппировки;
		Если ПустаяСтрока(ПолеГруппировки) Тогда
			ЭтоДетальныеЗаписи = Истина;
			ПредставлениеГруппировки = "Детальные записи";
		Иначе
			ПредставлениеГруппировки = КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.НайтиПоле(ПолеГруппировки).Заголовок;
		КонецЕсли;
