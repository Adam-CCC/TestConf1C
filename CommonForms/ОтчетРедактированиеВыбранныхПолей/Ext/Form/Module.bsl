	КонецЕсли;
	
	Если Параметры.Свойство("ТолькоРесурсы") Тогда
		ТолькоРесурсы = Параметры.ТолькоРесурсы;
	КонецЕсли;
	
	ЗагрузитьНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ВидПолей = "ИзменениеВыбора" Тогда
		
		ДоступныеПоляВыбора = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора;
		ОграниченияИспользованияПолей = Элементы.ДоступныеПоля.ОграниченияИспользования;
		
		Если ЭтоДетальныеЗаписи Тогда
			
		ИначеЕсли НЕ ПолеГруппировки = Неопределено Тогда
			ПоляВетки = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.НайтиПоле(ПолеГруппировки);
			Если ПоляВетки.Элементы.Количество()>0 Тогда
				ИдентификаторПоля = ДоступныеПоляВыбора.ПолучитьИдентификаторПоОбъекту(ПоляВетки.Элементы[0]);
				Элементы.ДоступныеПоля.ТекущаяСтрока = ИдентификаторПоля;
			КонецЕсли;
			
			РодительГруппировки = КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.НайтиПоле(ПолеГруппировки);
			Пока НЕ РодительГруппировки = Неопределено Цикл
				Если РодительГруппировки.Родитель = Неопределено Тогда
					Для Каждого ТекПоле Из КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
						НовоеОграничение = ОграниченияИспользованияПолей.Добавить();
						НовоеОграничение.Поле        = ТекПоле.Поле;
						НовоеОграничение.Доступность = Ложь;
					КонецЦикла;
				Иначе
					Для Каждого ТекПоле Из РодительГруппировки.Родитель.Элементы Цикл
						НовоеОграничение = ОграниченияИспользованияПолей.Добавить();
						НовоеОграничение.Поле        = ТекПоле.Поле;
						НовоеОграничение.Доступность = Ложь;
					КонецЦикла;
				КонецЕсли;
				РодительГруппировки = РодительГруппировки.Родитель;
			КонецЦикла;
		Иначе
			СистемноеПоле = Новый ПолеКомпоновкиДанных("СистемныеПоля");
			Для Каждого ТекПоле Из ДоступныеПоляВыбора.Элементы Цикл
				
				Если ТекПоле.Ресурс Тогда
					Продолжить;
				КонецЕсли;
				
				Если (НЕ ТолькоРесурсы) И ТекПоле.Поле = СистемноеПоле Тогда
					Продолжить;
				КонецЕсли;
				
				НовоеОграничение = ОграниченияИспользованияПолей.Добавить();
				НовоеОграничение.Поле        = ТекПоле.Поле;
				НовоеОграничение.Доступность = Ложь;
				//Если ТипЗнч(ПоляГруппировки) = Тип("ПоляГруппировкиКомпоновкиДанных") Тогда
				//	Для Каждого ТекГруппировка Из ПоляГруппировки.Элементы Цикл
				//		Если ТекГруппировка.Поле = ТекПоле.Поле Тогда
				//			НовоеОграничение.Доступность = Истина;
				//			Прервать;
				//		КонецЕсли;
				//	КонецЦикла;
				//КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли ВидПолей = "ИзменениеПорядка" Тогда
		
		ДоступныеПоляВыбора           = КомпоновщикНастроек.Настройки.ДоступныеПоляПорядка;
		ОграниченияИспользованияПолей = Элементы.ДоступныеПоляПорядка.ОграниченияИспользования;
		
		Если ЭтоДетальныеЗаписи Тогда
			
		ИначеЕсли НЕ ПолеГруппировки = Неопределено Тогда
			
			ПоляВетки = КомпоновщикНастроек.Настройки.ДоступныеПоляПорядка.НайтиПоле(ПолеГруппировки);
			Если ПоляВетки.Элементы.Количество()>0 Тогда
				ИдентификаторПоля = ДоступныеПоляВыбора.ПолучитьИдентификаторПоОбъекту(ПоляВетки.Элементы[0]);
				Элементы.ДоступныеПоляПорядка.ТекущаяСтрока = ИдентификаторПоля;
			КонецЕсли;
			
			РодительГруппировки = КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.НайтиПоле(ПолеГруппировки);
			Пока НЕ РодительГруппировки = Неопределено Цикл
				Если РодительГруппировки.Родитель = Неопределено Тогда
					Для Каждого ТекПоле Из КомпоновщикНастроек.Настройки.ДоступныеПоляПорядка.Элементы Цикл
						НовоеОграничение = ОграниченияИспользованияПолей.Добавить();
						НовоеОграничение.Поле        = ТекПоле.Поле;
						НовоеОграничение.Доступность = Ложь;
					КонецЦикла;
				Иначе
					Для Каждого ТекПоле Из РодительГруппировки.Родитель.Элементы Цикл
						НовоеОграничение = ОграниченияИспользованияПолей.Добавить();
						НовоеОграничение.Поле        = ТекПоле.Поле;
						НовоеОграничение.Доступность = Ложь;
					КонецЦикла;
				КонецЕсли;
				РодительГруппировки = РодительГруппировки.Родитель;
			КонецЦикла;
			
		Иначе
			
			СистемноеПоле = Новый ПолеКомпоновкиДанных("СистемныеПоля");
			Для Каждого ТекПоле Из ДоступныеПоляВыбора.Элементы Цикл
				Если ТекПоле.Ресурс Тогда
					Продолжить;
				КонецЕсли;
				
				Если (НЕ ТолькоРесурсы) И ТекПоле.Поле = СистемноеПоле Тогда
					Продолжить;
				КонецЕсли;
				
				НовоеОграничение = ОграниченияИспользованияПолей.Добавить();
				НовоеОграничение.Поле        = ТекПоле.Поле;
				НовоеОграничение.Доступность = Ложь;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьОтображениеФормы();
	
КонецПроцедуры

