&НаКлиенте
Процедура ГруппировкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("СхемаКомпоновки", СхемаКомпоновки);
	Попытка
		СтруктураПараметров.Вставить("ПоляГруппировки", Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ЭлементПоляГруппировки);
	Исключение
		СтруктураПараметров.Вставить("ПоляГруппировки", Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ПоляГруппировки);
	КонецПопытки;
	СтруктураПараметров.Вставить("ВидПолей",        "ПоляГруппировок");
	СтруктураПараметров.Вставить("НастройкиОтчета", КомпоновщикНастроек.ПолучитьНастройки());
	
	ТекГруппировки = Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ЭлементПоляГруппировки.Элементы;
	Если ТекГруппировки.Количество()>0 И (НЕ ПустаяСтрока(ТекГруппировки[0].Поле)) Тогда
		СтруктураПараметров.Вставить("Поле",        ТекГруппировки[0].Поле);
	КонецЕсли;
	
	ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетВыборПоля", СтруктураПараметров, Элемент);
	Рез = ФормаВыбора.ОткрытьМодально();
	Если НЕ Рез = КодВозвратаДиалога.Отмена И НЕ Рез = Неопределено Тогда
		ТекущаяСтрока = Группировки.Добавить();
		ТекущаяСтрока.Использование = Истина;
		ТекущаяСтрока.Картинка      = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
		ТекущаяСтрока.Поле          = Рез.Поле;
		ТекущаяСтрока.Заголовок     = Рез.Заголовок;
	КонецЕсли;
	
КонецПроцедуры

