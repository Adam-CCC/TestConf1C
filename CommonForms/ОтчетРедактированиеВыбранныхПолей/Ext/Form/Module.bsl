
&НаКлиенте
Функция ПолучитьЗаголовок(ЗаголовокПоля)
	
	Возврат СтрЗаменить(ЗаголовокПоля, ПредставлениеГруппировки+".", "");
	
КонецФункции

&НаКлиенте
Функция ПроверитьДубль(ТаблицаПоиска, ИмяПоля, Поле, Заголовок)
	
	Результат = Ложь;
	
	Отбор = Новый Структура(ИмяПоля, Поле);
	Если ТаблицаПоиска.НайтиСтроки(Отбор).Количество()>0 Тогда
		ТекстСообщения = НСтр("ru = 'Поле: """+Заголовок+""" уже добавлено!'");
		ПроцедурыОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьГруппировку(ВыбраннаяСтрока)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ЭлементПоляГруппировки.ДоступныеПоляПолейГруппировок.ПолучитьОбъектПоИдентификатору(ВыбраннаяСтрока);
	
	НоваяСтрока = Группировки.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
	НоваяСтрока.Использование = Истина;
	НоваяСтрока.Картинка      = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоле(ВыбраннаяСтрока)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = КомпоновщикНастроек.Настройки.Выбор.ДоступныеПоляВыбора.ПолучитьОбъектПоИдентификатору(ВыбраннаяСтрока);
	
	Если ДанныеСтроки.Поле = ПолеГруппировки Тогда
		Возврат;
	КонецЕсли;
	
	Заголовок = ПолучитьЗаголовок(ДанныеСтроки.Заголовок);
	Если ПроверитьДубль(ВыбранныеПоля, "Поле", ДанныеСтроки.Поле, Заголовок) Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ВыбранныеПоля.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
	НоваяСтрока.Заголовок = Заголовок;
	НоваяСтрока.Картинка  = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеФормы()
	
	//Элементы.ДоступныеПоляГруппировок.Видимость = Элементы.ГруппировкиКнопкаПодбор.Пометка;
	Элементы.ДоступныеПоляПорядка.Видимость      = Элементы.ПорядокКнопкаПодбор.Пометка;
	Элементы.ДоступныеПоля.Видимость             = Элементы.ВыборКнопкаПодбор.Пометка;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьНастройку(Элемент, СтруктураНастроек, ИмяПоля, ЗначениеПоУмолчанию = Неопределено)
	
	Если СтруктураНастроек.Свойство(ИмяПоля) Тогда
		Элемент = СтруктураНастроек[ИмяПоля];
	ИначеЕсли НЕ ЗначениеПоУмолчанию = Неопределено Тогда
		Элемент = ЗначениеПоУмолчанию;
	КонецЕсли;
	
КонецПроцедуры

// Процедура загружает настройки формы.
//
&НаСервере
Процедура ЗагрузитьНастройкиФормы()
	
	СтруктураНастроек = ХранилищеНастроекДанныхФорм.Загрузить("ОтчетРедактированиеВыбранныхПолей", "СтруктураНастроек");
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		//ЗаполнитьНастройку(Элементы.ГруппировкиКнопкаПодбор.Пометка, СтруктураНастроек, "ОтображатьГруппировкиКнопкаПодбор", Ложь);
		ЗаполнитьНастройку(Элементы.ПорядокКнопкаПодбор.Пометка, СтруктураНастроек, "ОтображатьПорядокКнопкаПодбор", Ложь);
		ЗаполнитьНастройку(Элементы.ВыборКнопкаПодбор.Пометка, СтруктураНастроек, "ОтображатьВыборКнопкаПодбор", Ложь);
	Иначе
		//Элементы.ГруппировкиКнопкаПодбор.Пометка = Ложь;
		Элементы.ПорядокКнопкаПодбор.Пометка     = Ложь;
		Элементы.ВыборКнопкаПодбор.Пометка       = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
