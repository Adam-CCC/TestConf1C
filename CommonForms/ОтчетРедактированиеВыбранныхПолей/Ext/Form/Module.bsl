&НаКлиенте
Процедура ПорядокПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		Счетчик = 0;
		Для Каждого ТекСтрока Из ПараметрыПеретаскивания.Значение Цикл
			
			Заголовок = ПолучитьЗаголовок(ТекСтрока.Заголовок);
			Если ПроверитьДубль(ВыбранныеПоля, "Поле", ТекСтрока.Поле, Заголовок) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекСтрока.Поле = ПолеГруппировки Тогда
				Возврат;
			КонецЕсли;
			
			Если Строка = Неопределено Тогда
				НоваяСтрока = ВыбранныеПоля.Добавить();
			Иначе
				ДанныеСтроки = ВыбранныеПоля.НайтиПоИдентификатору(Строка);
				ИндексСтроки = ВыбранныеПоля.Индекс(ДанныеСтроки);
				НоваяСтрока = ВыбранныеПоля.Вставить(ИндексСтроки+Счетчик);
				Счетчик = Счетчик + 1;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.Заголовок = Заголовок;
			НоваяСтрока.Картинка  = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Число") Тогда
		Если Строка = Неопределено Тогда
			ИндексСтроки = ВыбранныеПоля.Количество()-1;
		Иначе
			ДанныеСтроки = Элементы.ВыбранныеПоля.ДанныеСтроки(Строка);
			ИндексСтроки = ВыбранныеПоля.Индекс(ДанныеСтроки);
		КонецЕсли;
		НачальныйИндекс = ВыбранныеПоля.Индекс(Элемент.ТекущиеДанные);
		ВыбранныеПоля.Сдвинуть(НачальныйИндекс, ИндексСтроки-НачальныйИндекс);
	КонецЕсли;
	
КонецПроцедуры


