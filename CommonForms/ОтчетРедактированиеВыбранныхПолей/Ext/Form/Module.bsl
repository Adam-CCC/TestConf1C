&НаКлиенте
Процедура ГруппировкиПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		Счетчик = 0;
		Для Каждого ТекСтрока Из ПараметрыПеретаскивания.Значение Цикл
			Если Строка = Неопределено Тогда
				НоваяСтрока = Группировки.Добавить();
			Иначе
				ДанныеСтроки = Группировки.НайтиПоИдентификатору(Строка);
				ИндексСтроки = Группировки.Индекс(ДанныеСтроки);
				НоваяСтрока = Группировки.Вставить(ИндексСтроки+Счетчик);
				Счетчик = Счетчик + 1;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.Использование = Истина;
			НоваяСтрока.Картинка      = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Число") Тогда
		Если Строка = Неопределено Тогда
			ИндексСтроки = Группировки.Количество()-1;
		Иначе
			ДанныеСтроки = Элементы.Группировки.ДанныеСтроки(Строка);
			ИндексСтроки = Группировки.Индекс(ДанныеСтроки);
		КонецЕсли;
		НачальныйИндекс = Группировки.Индекс(Элемент.ТекущиеДанные);
		Группировки.Сдвинуть(НачальныйИндекс, ИндексСтроки-НачальныйИндекс);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппировкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ГруппировкиЗаголовок" Тогда
		СтандартнаяОбработка = Ложь;
		
		ТекущаяСтрока = Элементы.Группировки.ТекущиеДанные;
		Если ТекущаяСтрока = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("СхемаКомпоновки", СхемаКомпоновки);
		Попытка
			СтруктураПараметров.Вставить("ПоляГруппировки", Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ЭлементПоляГруппировки);
		Исключение
			СтруктураПараметров.Вставить("ПоляГруппировки", Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ПоляГруппировки);
		КонецПопытки;
		СтруктураПараметров.Вставить("ВидПолей",        "ПоляГруппировок");
		СтруктураПараметров.Вставить("НастройкиОтчета", КомпоновщикНастроек.ПолучитьНастройки());
		
		ТекГруппировки = Элементы.КомпоновщикНастроекНастройки.ТекущиеДанные.ЭлементПоляГруппировки.Элементы;
		Если ТекГруппировки.Количество()>0 И (НЕ ПустаяСтрока(ТекГруппировки[0].Поле)) Тогда
			СтруктураПараметров.Вставить("Поле",        ТекГруппировки[0].Поле);
		КонецЕсли;
		
		ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетВыборПоля", СтруктураПараметров, Элемент);
		Рез = ФормаВыбора.ОткрытьМодально();
		Если НЕ Рез = КодВозвратаДиалога.Отмена И НЕ Рез = Неопределено Тогда
			ТекущаяСтрока.Поле      = Рез.Поле;
			ТекущаяСтрока.Заголовок = ПолучитьЗаголовок(Рез.Заголовок);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

