			ИндексСтроки = ИзмеренияКолонки.Индекс(ДанныеСтроки);
			НоваяСтрока = ИзмеренияКолонки.Вставить(ИндексСтроки);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПеретаскивания.Значение);
		УдалитьСтрокуИсточника(ПараметрыПеретаскивания.Значение);
	ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		Счетчик = 0;
		Для Каждого ТекСтрока Из ПараметрыПеретаскивания.Значение Цикл
			Если Строка = Неопределено Тогда
				НоваяСтрока = ИзмеренияКолонки.Добавить();
			Иначе
				ДанныеСтроки = ИзмеренияКолонки.НайтиПоИдентификатору(Строка);
				ИндексСтроки = ИзмеренияКолонки.Индекс(ДанныеСтроки);
				НоваяСтрока = ИзмеренияКолонки.Вставить(ИндексСтроки+Счетчик);
				Счетчик = Счетчик + 1;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			УдалитьСтрокуИсточника(ТекСтрока);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Число") Тогда
		Если Строка = Неопределено Тогда
			ИндексСтроки = ИзмеренияКолонки.Количество()-1;
		Иначе
			ДанныеСтроки = Элементы.ИзмеренияКолонки.ДанныеСтроки(Строка);
			ИндексСтроки = ИзмеренияКолонки.Индекс(ДанныеСтроки);
		КонецЕсли;
		НачальныйИндекс = ИзмеренияКолонки.Индекс(Элемент.ТекущиеДанные);
		ИзмеренияКолонки.Сдвинуть(НачальныйИндекс, ИндексСтроки-НачальныйИндекс);
	КонецЕсли;
	
КонецПроцедуры

