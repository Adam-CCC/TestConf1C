&НаКлиенте
Процедура ИзмеренияСтрокиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ИзмеренияСтрокиЗаголовок" Тогда
		
		СтандартнаяОбработка = Ложь;
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("СхемаКомпоновки", СхемаКомпоновки);
		СтруктураПараметров.Вставить("ВидПолей",        "ПоляГруппировок");
		
		СтрокаСтруктуры = ОтчетыСервер.КомпоновщикПолучитьПервуюСтрокуСтруктурыПоПолю(Отчет.КомпоновщикНастроек.Настройки.Структура);
		Если СтрокаСтруктуры = Неопределено Тогда
			СтрокаСтруктуры = Отчет.КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		КонецЕсли;
		СтруктураПараметров.Вставить("НастройкиОтчета", Отчет.КомпоновщикНастроек.ПолучитьНастройки());
		СтруктураПараметров.Вставить("ТекущаяСтрока",   Отчет.КомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(СтрокаСтруктуры));
		
		ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетВыборПоля", СтруктураПараметров, Элемент);
		
		Рез = ФормаВыбора.ОткрытьМодально();
		Если НЕ Рез = КодВозвратаДиалога.Отмена И НЕ Рез = Неопределено Тогда
			Если ТипЗнч(Рез) = Тип("Структура") ИЛИ ТипЗнч(Рез) = Тип("ДоступноеПолеКомпоновкиДанных") Тогда
				ЗаголовокГруппировки = Рез.Заголовок;
				ПолеГруппировки      = Рез.Поле;
			Иначе
				ЗаголовокГруппировки = Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.НайтиПоле(Рез).Заголовок;
				ПолеГруппировки      = Рез;
			КонецЕсли;
			
			ОтборПоДублям = Новый Структура("Поле", ПолеГруппировки);
			Дубли = ИзмеренияСтроки.НайтиСтроки(ОтборПоДублям);
			Если Дубли.Количество()>0 Тогда
				Предупреждение("Повторяющаяся группировка " + ЗаголовокГруппировки +"."+ Символы.ПС+
				"Нельзя использовать одинаковые поля группировки в строках и в колонках!", 30);
				Возврат;
			Иначе
				Дубли = ИзмеренияКолонки.НайтиСтроки(ОтборПоДублям);
				Если Дубли.Количество()>0 Тогда
					Предупреждение("Повторяющаяся группировка " + ЗаголовокГруппировки +"."+ Символы.ПС+
					"Нельзя использовать одинаковые поля группировки в строках и в колонках!", 30);
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			ТекущиеДанные = Элемент.ТекущиеДанные;
			
			ТекущиеДанные.Поле      = ПолеГруппировки;
			ТекущиеДанные.Заголовок = ЗаголовокГруппировки;
			
			СтруктураГруппировки = Новый Структура;
			СтруктураГруппировки.Вставить("Поле",                 ТекущиеДанные.Поле);
			СтруктураГруппировки.Вставить("ПредставлениеПорядка", "");
			СтруктураГруппировки.Вставить("Порядок",              ТекущиеДанные.Порядок);
			СтруктураГруппировки.Вставить("Заголовок",            ТекущиеДанные.Заголовок);
			
			УстановитьПорядокПоУмолчанию(СтруктураГруппировки);
			
			ТекущиеДанные.ПредставлениеПорядка = СтруктураГруппировки.ПредставлениеПорядка;
			ТекущиеДанные.Порядок.Очистить();
			Для Каждого СтрокаПорядка Из СтруктураГруппировки.Порядок Цикл
				ЗаполнитьЗначенияСвойств(ТекущиеДанные.Порядок.Добавить(), СтрокаПорядка);
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ИзмеренияСтрокиПорядок" Тогда
		
		СтандартнаяОбработка = Ложь;
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ВидПолей",        "ИзменениеПорядка");
		СтруктураПараметров.Вставить("СхемаКомпоновки", СхемаКомпоновки);
		СтруктураПараметров.Вставить("Поля",            Элемент.ТекущиеДанные.Порядок);
		СтруктураПараметров.Вставить("ПолеГруппировки", Элемент.ТекущиеДанные.Поле);
		
		ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетРедактированиеВыбранныхПолей", СтруктураПараметров, Элемент);
		
		Рез = ФормаВыбора.ОткрытьМодально();
		
		Если Рез = КодВозвратаДиалога.ОК Тогда
			ВыбранныеПоля = ФормаВыбора.ВыбранныеПоля;
			Порядок = Элемент.ТекущиеДанные.Порядок;
			Порядок.Очистить();
			ПредставлениеПорядка = "";
			Для Каждого ТекПоле Из ВыбранныеПоля Цикл
				
				Если СокрЛП(ТекПоле.Поле) = "" Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = Порядок.Добавить();
				НоваяСтрока.Поле              = ТекПоле.Поле;
				НоваяСтрока.Заголовок         = ТекПоле.Заголовок;
				Если ТекПоле.ПоВозрастанию Тогда
					НоваяСтрока.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
				Иначе
					НоваяСтрока.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
				КонецЕсли;
				ПредставлениеПорядка = ПредставлениеПорядка + ?(ПредставлениеПорядка = "", "", ", ") + ТекПоле.Заголовок;
			КонецЦикла;
			Элемент.ТекущиеДанные.ПредставлениеПорядка = ПредставлениеПорядка;
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ИзмеренияСтрокиДопПоля" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если НЕ ПустаяСтрока(Элемент.ТекущиеДанные.Поле) Тогда
			ДоступныеПоляГруппировки = Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.НайтиПоле(Элемент.ТекущиеДанные.Поле);
			Если ДоступныеПоляГруппировки = Неопределено ИЛИ ДоступныеПоляГруппировки.Элементы.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ВидПолей",        "ИзменениеВыбора");
		СтруктураПараметров.Вставить("СхемаКомпоновки", СхемаКомпоновки);
		СтруктураПараметров.Вставить("Поля",            Элемент.ТекущиеДанные.ДопПоля);
		СтруктураПараметров.Вставить("ПолеГруппировки", Элемент.ТекущиеДанные.Поле);
		
		ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетРедактированиеВыбранныхПолей", СтруктураПараметров, Элемент);
		
		Рез = ФормаВыбора.ОткрытьМодально();
		Если Рез = КодВозвратаДиалога.ОК Тогда
			ВыбранныеПоля = ФормаВыбора.ВыбранныеПоля;
			ДопПоля = Элемент.ТекущиеДанные.ДопПоля;
			ДопПоля.Очистить();
			ПредставлениеПолей = "";
			Для Каждого ТекПоле Из ВыбранныеПоля Цикл
				
				Если СокрЛП(ТекПоле.Поле) = "" Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ДопПоля.Добавить();
				НоваяСтрока.Поле      = ТекПоле.Поле;
				НоваяСтрока.Заголовок = ТекПоле.Заголовок;
				ПредставлениеПолей = ПредставлениеПолей + ?(ПредставлениеПолей = "", "", ", ") + ТекПоле.Заголовок;
			КонецЦикла;
			Элемент.ТекущиеДанные.ПредставлениеПолей = ПредставлениеПолей;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзмеренияСтрокиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	СтандартнаяОбработка = Ложь;
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("СхемаКомпоновки", СхемаКомпоновки);
	СтруктураПараметров.Вставить("ВидПолей",        "ПоляГруппировок");
	
	СтрокаСтруктуры = ОтчетыСервер.КомпоновщикПолучитьПервуюСтрокуСтруктурыПоПолю(Отчет.КомпоновщикНастроек.Настройки.Структура);
	Если СтрокаСтруктуры = Неопределено Тогда
		СтрокаСтруктуры = Отчет.КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	КонецЕсли;
	
	СтруктураПараметров.Вставить("НастройкиОтчета", Отчет.КомпоновщикНастроек.ПолучитьНастройки());
	СтруктураПараметров.Вставить("ТекущаяСтрока",   Отчет.КомпоновщикНастроек.Настройки.ПолучитьИдентификаторПоОбъекту(СтрокаСтруктуры));
	
	ФормаВыбора = ПолучитьФорму("ОбщаяФорма.ОтчетВыборПоля", СтруктураПараметров, Элемент);
	
	Рез = ФормаВыбора.ОткрытьМодально();
	Если НЕ Рез = КодВозвратаДиалога.Отмена И НЕ Рез = Неопределено Тогда
		Если ТипЗнч(Рез) = Тип("Структура") ИЛИ ТипЗнч(Рез) = Тип("ДоступноеПолеКомпоновкиДанных") Тогда
			ЗаголовокГруппировки = Рез.Заголовок;
			ПолеГруппировки      = Рез.Поле;
		Иначе
			ЗаголовокГруппировки = Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляГруппировок.НайтиПоле(Рез).Заголовок;
			ПолеГруппировки      = Рез;
		КонецЕсли;
		
		ОтборПоДублям = Новый Структура("Поле", ПолеГруппировки);
		Дубли = ИзмеренияСтроки.НайтиСтроки(ОтборПоДублям);
		Если Дубли.Количество()>0 Тогда
			Предупреждение("Повторяющаяся группировка " + ЗаголовокГруппировки +"."+ Символы.ПС+
			"Нельзя использовать одинаковые поля группировки в строках и в колонках!", 30);
			Возврат;
		Иначе
			Дубли = ИзмеренияКолонки.НайтиСтроки(ОтборПоДублям);
			Если Дубли.Количество()>0 Тогда
				Предупреждение("Повторяющаяся группировка " + ЗаголовокГруппировки +"."+ Символы.ПС+
				"Нельзя использовать одинаковые поля группировки в строках и в колонках!", 30);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		НоваяСтрока = ИзмеренияСтроки.Добавить();
		НоваяСтрока.Использование = Истина;
		НоваяСтрока.Поле          = ПолеГруппировки;
		НоваяСтрока.Заголовок     = ЗаголовокГруппировки;
		НоваяСтрока.Картинка      = БиблиотекаКартинок.ГруппировкаКомпоновкиДанных;
		
		СтруктураГруппировки = Новый Структура;
		СтруктураГруппировки.Вставить("Поле",                 НоваяСтрока.Поле);
		СтруктураГруппировки.Вставить("ПредставлениеПорядка", "");
		СтруктураГруппировки.Вставить("Порядок",              НоваяСтрока.Порядок);
		СтруктураГруппировки.Вставить("Заголовок",            НоваяСтрока.Заголовок);
		
		УстановитьПорядокПоУмолчанию(СтруктураГруппировки);
		
		НоваяСтрока.ПредставлениеПорядка = СтруктураГруппировки.ПредставлениеПорядка;
